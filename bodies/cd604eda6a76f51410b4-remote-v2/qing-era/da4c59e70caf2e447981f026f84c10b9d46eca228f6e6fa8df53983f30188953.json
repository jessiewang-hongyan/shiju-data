[{"title":"沁园春 赠外","author":"钱念生","text":"约略前身，君与阿侬，有未了因。\n但自惭蒲柳，敢言伉俪，替司巾栉，怎许娉婷。\n刺绣闲时，吟笺寄与，月底花前聊遣情。\n君休笑，是班门弄斧，愧不如卿。\n珠倾露洗秋汀。\n道秋水、侬神一样清。\n本桃红杏艳，重来羞比，莺娇燕婉，只是慵听。\n君守清贫，妾甘淡薄，举案光鸿记也曾。\n低声嘱、愿百年偕老，莫负钗荆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24040,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"长相思 雨夜寄怀","author":"钱念生","text":"山迢迢。\n水迢迢。\n梦过江南第几桥。\n寻君路更遥。\n醒无聊。\n睡无聊。\n一点愁心无计消。\n哪堪雨滴蕉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24041,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"阑干万里心 春雨忆别","author":"钱念生","text":"卐字小阑环曲折。\n恰似我、寸肠千结。\n乱愁丝和雨丝丝，尽付与、莺梭织。\n绿杨风里伤离别。\n憔悴也、问谁怜惜。\n此情只有彩毫知，细画出、相思切。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24042,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 寄外","author":"钱念生","text":"岭南云高，梦儿欲把羊城绕。\n怪它双棹。\n不送魂飞到。\n多病多愁，多恨多烦恼。\n谁知道。\n情田虽小，长遍相思草。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24043,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卖花声 题叶小鸾眉子砚拓本","author":"翁瑞恩","text":"半弯眉子被云遮。\n柳乍舒芽。\n绿窗绣罢并头花。\n还向灯前题锦句，寒逗轻纱。\n一片碎琼霞。\n几寸尘沙。\n菩提明镜本无瑕。\n闲倚阑干重拂拭，月也横斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24044,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤栖梧 自题“梧馆吟秋图”","author":"翁瑞恩","text":"泠泠何处秋声起。\n欲问秋声，只在桐阴里。\n风定芙蓉香十里。\n烹茶唤起娇嫞婢。\n把卷论文人有几。\n还是芭蕉，解得侬心意。\n不合读书明眼底。\n添将多少愁滋味。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24045,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 春日苦雨","author":"翁瑞恩","text":"春光好，杨柳画楼西。\n帘外鹦哥初解语，檐前燕子乍衔泥。\n风雨又凄凄。\n春光好，桃李半开时。\n倦倚绣床添弱线，闲抛书卷写新词。\n可惜雨如丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24046,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"双调望江南 夏饼","author":"翁瑞恩","text":"春光暮，夏至一阴旋。\n麦陇风来香细细，炊烟何处识红莲。\n仔细与君看。\n玲珑式，月影恰团圆。\n纤手搓来形似玉，银刀擘处气如兰。\n珍重劝加餐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24047,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"惜分飞 寄衣","author":"翁瑞恩","text":"瞥见枝头梅蕊暖。\n愁到眉峰寸寸。\n何处砧声恨。\n更无言语中心闷。\n金剪裁成添弱线。\n又把吴绵细选。\n寄与郎如见。\n休论缣华同贫贱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24048,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"翁瑞恩","text":"年来领略愁滋味。\n闲愁万斛凭谁慰。\n分付与东风。\n黄梁一梦中。\n芭蕉心不展。\n脉脉情何限。\n耐得五更寒，香残烛也残。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24049,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"翁瑞恩","text":"青梅累累枝头结。\n狂风忽而频吹折。\n憔悴惜韶光。\n看它蜂蝶忙。\n鱼书谁可递。\n怊怅真无计。\n望断楚云遥，还惜形影凋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24050,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"调笑令","author":"翁瑞恩","text":"人静。\n人静。\n剩有窗前梅影。\n罗帏生怕春寒。\n忘却三更月残。\n残月。\n残月。\n可似昨宵清断。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24051,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"谒金门 题汪小珊《绣蝶盦词钞凤城集》","author":"翁瑞恩","text":"长安道。\n好景最饶春晓。\n一树丁香花窈窕。\n更听佳客到。\n落叶辞枝偏早。\n别有伤秋怀抱。\n凭与钟期赓曲调。\n知音从古少。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24052,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"归田乐 又题渡江词","author":"翁瑞恩","text":"旗亭唱罢赓酬句。\n吟到邗江烟树。\n山色与波光，都写行装彩毫助。\n金焦两点看飞渡。\n远浦忽惊鸥鹭。\n风饱一帆悬，莼羹鲈脍人归去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24053,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"锦堂春 又题《兰笙集》","author":"翁瑞恩","text":"鸟报檐前晴好，人看陌上春还。\n娑罗花发题新句，佳景在壶天。\n蕉叶偶书锦字，兰馐恰敞华筵。\n红牙谱出千秋岁，月又正团圆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24054,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"婆罗门令 汪氏壶园看婆罗花，即席赠潘夫人","author":"翁瑞恩","text":"荣阳第、佛香亲种。\n平阳第。\n又山房亲种。\n分得灵根，花瓷斗、宜清供。\n敷微荫，满院鬘云拥。\n孤松畔，灵石缝。\n簇繁英、邀得祥禽弄。\n嘉名比似忧昙钵，棠棣馆、更交让称颂。\n旃檀馥郁，贝叶萋菶。\n开了荼蘼，异本端藉禅天送。\n未藉东皇宠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24055,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 四首 其一","author":"翁瑞恩","text":"秦淮月，久漾画图中。\n处处楼台歌落日，家家庭院泣秋风。\n寂寞古行宫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24056,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 四首 其三","author":"翁瑞恩","text":"秦淮月，憔悴惜芳辰。\n玉树歌残南部曲，金钲吹散秣陵春。\n屈指岁更频。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24057,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 四首 其四","author":"翁瑞恩","text":"秦淮月，望断楚云低。\n生怕风高多鬼语，还惊潮落有莺啼。\n愁煞画楼西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24058,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤凰台上忆吹箫 题管夫人书璇玑图墨刻","author":"翁瑞恩","text":"藕孔心多，莲房意苦，丝丝织出千篇。\n怅别怀难诉，倩彼鱼传。\n赢得香车远讶，销魂是、会面它年。\n还疑梦，不因弃掷，那得团圆。\n姗姗。\n幽栖居士，细绎遍回波，忒煞缠绵。\n更水晶宫畔，佳偶如仙。\n添出簪花妙笔，银钩体、濡染云笺。\n从头数，古来几多，淑媛新编。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24059,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"疏影","author":"翁瑞恩","text":"穷非我独。\n叹流离异地，难问殊俗。\n海曲荒陇，弹指楼台，行窝谁与兴筑。\n卜邻不隔东西路，也只好、称贞缩屋。\n等闲过、风雨重阳，但惜有篱无菊。\n比似长沙卑湿，韩康今日至，茯苓新剧。\n市远盘飧，灭灶更炊，剩有寒泉堪掬。\n芭蕉雨滴凄凉语，却添得、回肠屈曲。\n知明年、又在何方，漫葺黄冈竹楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24060,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卖花声 题藏墨山房","author":"翁瑞恩","text":"竹屋纸明窗。\n聊可支床。\n小亭一角绕长廊。\n曲曲层台如雁齿，合种花王。\n草绿满庭芳。\n亚字红墙。\n碧桃谢却桂枝香。\n可惜梧桐新雨后，少个池塘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24061,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 藏墨山房丁香花盛开，为填此阕","author":"翁瑞恩","text":"老干槎枒枝叶茂。\n待得花开，花比人还瘦。\n欲折一枝香在手。\n最怜碎朵盈罗袖。\n细雨春风吹不透。\n帘内书声，帘底灯如豆。\n笑对花神酬斗酒。\n明年可似今年否。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24062,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 江阴年仙九尚书没于崇川，侧室吴氏吞金以殉","author":"翁瑞恩","text":"蓦地波澜，掷碎了、菱花圆月。\n伤心处、白杨衰草，轜车临穴。\n歌舞樽前欢梦短，繁华镜里浮沤阅。\n尽缠绵、愿结再生盟，孤怀洁。\n巾帼女，多奇节。\n拼绝命，黄金屑。\n叹珠沉花谢，九回肠折。\n慷慨难忘斑竹恨，乱离岂恋红尘瞥。\n听夜深、愁雨洒空阶，香魂冽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24063,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醉花阴 紫薇花","author":"翁瑞恩","text":"虚白堂前传异种。\n紫绶曾邀宠。\n斜月上帘钩，浅碧笼烟，几处凉初送。\n柔姿羞藉东皇重。\n溽暑宜清供。\n莫道不如春，色比秾桃，瘦与黄花共。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24064,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"金缕曲 闺中秋作","author":"翁瑞恩","text":"信美非吾土。\n笑浮家、等闲再值，良宵三五。\n深院木犀香已谢，渐惜秋光欲暮。\n只碎菊、篱边方吐。\n漫道井梧添叶好，怕羁愁、添得心尤苦。\n荣憔感，向谁诉。\n纪时今日逢冷露。\n检巾箱、吴绵已罄，故衣重补。\n青女素娥还耐冷，下界尘凡莫数。\n恰圆魄、重开顾兔。\n拜月盈盈同说饼，算乡风、犹是江南路。\n何处问，旧皋庑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24065,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"生查子 留别藏墨山房","author":"翁瑞恩","text":"天为辟名园，留我三年住。\n来岁牡丹时，我又辞巢去。\n花也太多情，似共离人语。\n燕子若归来，莫更和春驻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24066,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"琐窗寒 雪夜怀诸兄弟","author":"翁瑞恩","text":"昨夜轻寒，开帘瞥见，玉龙回舞。\n飞花糁径，朵朵散时还聚。\n短篱边、冷梅吐芬，曲廊缓步殊增趣。\n似故乡风景，修篁斜倚，遥天将暮。\n谁语。\n离情绪。\n记咏雪闲庭，围炉觅句。\n韶华易改，雁影纷飞几处。\n到春来、棠棣半开，天涯坐惜修程阻。\n难频年、戍鼓常惊，极目燕台树。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24067,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"疏影","author":"翁瑞恩","text":"灵光留独。\n记才经劫火，一洗浇俗。\n往日亭台，讲舍新移，老圃劳它重筑。\n飘零我是无家客，幸庇厦、何妨茅屋。\n待殿春、花事阑时，分取半弓莳菊。\n连岁吴陵小住，长镵躬托命，园蓛自剧。\n欲乞淮王，残药分尝，安得刀圭盈掬。\n江南烽火连天地，已历遍、羊肠九曲。\n知何时、真息劳踪，笑问平安修竹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24068,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令 雪霁小园探梅","author":"翁瑞恩","text":"晓日半窗晴照。\n积雪满庭寒峭。\n呵手试新妆，慵把眉痕重扫。\n休笑。\n休笑。\n为探小园梅早。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24069,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"花非花 雾凇","author":"翁瑞恩","text":"初疑霜，复疑雾。\n玉屑霏，金葩吐。\n东风吹得十分匀，开遍梨花千万树。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24070,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"金缕曲 题李宛湘夫人花阴绕步遗照","author":"翁瑞恩","text":"何处秋声早。\n碧沉沉、梧桐树底，暖凉初报。\n觅句不妨芳径滑，踏遍闲庭细草。\n渐月影、枝头斜照。\n丛桂小山留不住，恨无端、偏鼓西风棹。\n琴韵歇，炉烟袅。\n仙人见说瑶台好。\n瞥红尘、彩鸾飞去，佩环声杳。\n札札鸣机灯火夜，犹寄相思远道。\n今只剩、零烟残稿。\n逝水年华惊易改，认丰姿、画里容仍渺。\n追往事，泪多少。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24071,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"御街行 题吴春海太史鸿恩“岁寒登岱图”","author":"翁瑞恩","text":"朔风峭劲严冬节。\n泰岱顶、行踪绝。\n有人杖策独寻幽，不管天门深鐍。\n兹游突过，昌黎登华，书与家人别。\n一编岱览难周列。\n择胜处、新图揭。\n云亭封禅久无书，谁识相如才杰。\n庭闱眷念，觚棱回首，自记轮蹄辙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24072,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 送梁汾弟北上，适中庭杏花盛开","author":"顾贞立","text":"梦草池塘，拟重续、谢庭佳咏。\n又早是、离愁满载，片帆风顺。\n千缕柳丝难挽住，一枝红杏聊为赆。\n看明年、此际日边开，宫袍衬。\n频酌酒，须拌饮。\n重话别，言难尽。\n怕归来庭院，故人多病。\n风日长途珍护好，春城寒食应相称。\n倩双鱼、先寄与平安，泥金信。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24073,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 十首 其一","author":"顾贞立","text":"东亭好，太史旧名家。\n望去有庭皆叠石，看来无树不梅花。\n既此是烟霞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24074,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 十首 其二","author":"顾贞立","text":"东亭好，佛阁石为龛。\n曾羡莲台双并蒂，愿依弥勒一花憨。\n还把本来参。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24075,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 十首 其三","author":"顾贞立","text":"东亭好，疏雨逗庭梧。\n小酉阁前山水画，晚妆楼外辋川图。\n燕子引新雏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24076,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 十首 其四","author":"顾贞立","text":"东亭好，青粉薜萝墙。\n梅子乍圆莺语滑，杏花微雨燕泥香。\n小立傍斜阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24077,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 十首 其五","author":"顾贞立","text":"东亭好，青盖绿阴圆。\n元览楼前题白雪，三馀阁上驻婵娟。\n一望似神仙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24078,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 十首 其六","author":"顾贞立","text":"东亭好，阑砌玉玲珑。\n一点烟鬟留夕照，三层楼阁接垂虹。\n人在画图中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24079,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 十首 其七","author":"顾贞立","text":"东亭好，最忆是花朝。\n破寂自倾鹦鹉盏，拈题先得美人蕉。\n阁倚凤凰箫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24080,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 十首 其八","author":"顾贞立","text":"东亭好，无事掩深闺。\n痛饮长歌红烛夜，沉香小像曲屏西。\n何处不堪题。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24081,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 十首 其九","author":"顾贞立","text":"东亭好，梅子乍圆时。\n璧玉邻家催斗草，青溪小妹解弹棋。\n吟就护兰诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24082,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 十首 其十","author":"顾贞立","text":"东亭好，石榻对茶烟。\n丹桂香飘金粟岭，碧梧阴覆卧雪轩。\n斗韵与飞笺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24083,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 中秋寄梁汾弟","author":"顾贞立","text":"此夜秦淮，桃叶渡、兰舟桂桨。\n回首处、金焦两点，水天一样。\n望去金波惊万里，愁来白发三千丈。\n笑闺中、赢得愧称兄，予差长。\n河桥畔，危楼上。\n疏林隔，征帆漾。\n尽斜阳送眼，秋潮初涨。\n十载别离劳梦寐，半生词赋同凄怅。\n愿重来、还补谢家咏，人无恙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24084,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"念奴娇","author":"顾贞立","text":"香消梦觉。\n黯然惊又早，浮生半百。\n青鬓花封当日语，添取几丝华发。\n绮思纷来，回文自解，总是前生业。\n空中楼阁，醉时书破四壁。\n回首。\n辛苦三迁，鸡窗十载，千里经风雪。\n倚闾高堂愁日暮，望断凤城双阕。\n杏雨黏衣，曲江春暖，此愿知何日。\n少年莫负，花明柳暗时节。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24085,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎美人 送梁汾弟","author":"顾贞立","text":"镜里遥山，忆中云树。\n天涯约契烟深处。\n骊歌唱罢又重招，赢得倾城名士、拥兰桡。\n候到松风，飘残研雨。\n一春长向花前语。\n纵教双鲤日通潮，争似玉骢还驻、小红桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24086,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆秦娥 二首，忆鄋氏 其一","author":"顾贞立","text":"西窗月。\n邀人瘦影成三绝。\n成三绝。\n清愁虚冷，都无话说。\n金钗划损阑干漆。\n炉烟袅篆屏山寂。\n屏山寂。\n侍儿促睡，单衾寒怯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24087,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆秦娥 二首，忆鄋氏 其二","author":"顾贞立","text":"西窗月。\n照人夜夜如相识。\n如相识。\n穿帘入幕，故来寻觅。\n空闺此际真愁绝。\n遥知尚有秦娥泣。\n秦娥泣。\n与君尝尽，生离死别。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24088,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"天仙子","author":"顾贞立","text":"翡翠离披妆未卸。\n独倚薰笼坐深夜。\n晚寒料峭入重围，腰可把，愁难写。\n相对相怜银烛下。\n烛尽香残催睡也。\n短梦未成魂欲化。\n欲拟翻然上图画，蓬莱界，通灵快。\n莫系留仙双锦带。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24089,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一剪梅","author":"顾贞立","text":"九十春光半已残。\n诗兴阑珊。\n酒兴阑珊。\n镜中憔悴不堪看。\n羞画眉弯。\n懒画眉弯。\n涩雨悭风特地酸。\n不许春闲。\n不许人闲。\n年年愁病苦相关。\n花也长叹。\n人也长叹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24090,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆王孙","author":"顾贞立","text":"何事愁多与病缘。\n一宵风雨又无眠。\n起来羞对镜台前。\n有谁怜。\n探梅时节拥炉天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24091,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"顾贞立","text":"好梦留人悔欲醒。\n谁教莺语弄新晴。\n乍寒还暖近清明。\n门掩落花春寂寂，香消睡鸭昼沉沉。\n日长闲自理瑶琴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24092,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"顾贞立","text":"尽日帘垂懒上钩。\n无端春思在眉头。\n絮飞花落梦悠悠。\n剪剪轻寒朱户寂，丝丝细雨小窗幽。\n东风肠断不堪留。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24093,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行","author":"顾贞立","text":"晕掩青灯，寒侵翠袖。\n音书望断重阳后。\n昔年闺阁斗新妆，而今追忆难回首。\n夜月连床，晓窗同绣。\n踏镫挑菜频携手。\n梦中依约聚还分，觉来赢得愁肠逗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24094,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花","author":"顾贞立","text":"和逗晚香愁一线。\n触景无端，泪湿罗衫遍。\n闷来欹枕不成眠。\n梦中还虑愁难遣。\n人静萧斋门独掩。\n无限愁思，半刻肠千断。\n欲出帘栊邀女伴。\n羞看镜里啼痕面。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24095,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆秦娥 本意","author":"顾贞立","text":"鳞鸿绝。\n暮蝉空向林梢咽。\n林梢咽。\n秦娥安否，多应伤别。\n云山万叠空相忆。\n昨宵魂梦曾相觅。\n曾相觅。\n小桥流水，分明记得。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24096,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉蝴蝶 苕溪署中","author":"顾贞立","text":"一抹晴空无际，烟光淡荡，微月当楼。\n点缀平芜树色，暮霭初收。\n断霞边、慈乌千点，看反哺、争择枝头。\n漫凝眸。\n亲帏何处，旅梦难留。\n飕飕。\n风吹鬓影，寒生肌粟，唤起千愁。\n不堪回望旧家，庭院早惊秋。\n忆当初、栖迟三楚，今日个、落拓湖州。\n愿难酬。\n聊凭斑管，写我心忧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24097,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 重九日","author":"顾贞立","text":"细雨斜风，却又早、重阳时节。\n登高去、小楼凝望，楚天空阔。\n秋水伊人家万里，白云亲舍山重叠。\n是谁啼、红泪溅霜林，枫如血。\n填不满，穷愁穴。\n补不尽，离愁缺。\n溯庭阶胜事，依然陈迹。\n黄菊有花羞插鬓，素心欲转怜匪石。\n有孤鸿、和月伴卿卿，成三绝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24098,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐 元宵前二日，重过东皋，见残雪未消，梅花欲绽，遂赋此阕。","author":"顾贞立","text":"闲愁未扫。\n拟向梅花告。\n傲骨自来贫亦好。\n丘壑尽供潦倒。\n离魂不用人招。\n此生拼老渔樵。\n多谢天公有意，留将一地琼瑶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24099,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙","author":"顾贞立","text":"梧叶飘香时别去，重来又早阳春。\n韶华惊见一番新。\n梅心檀正吐，柳眼绿才匀。\n锦帐香车安足羡，幽姿恰合长贫。\n灌畦聊且寄城闉。\n一池新涨水，好洗耳边狺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24100,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]