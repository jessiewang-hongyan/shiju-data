[{"title":"日本杂事诗 其八十五","author":"黄遵宪","text":"三千神社尽巫风，帐底题名列桂宫。\n蚕绿橘黄争跪拜，不知常世是何虫？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13706,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其八十六","author":"黄遵宪","text":"沐猴跳舞排猿女，吠犬唁声闹隼人。\n执盖膝行铃手引，一人独拜九天神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13707,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其八十七","author":"黄遵宪","text":"青衫绿袄导双骑，鳆汁鱼羹列十台。\n锦袋悬胸文在手，共瞻天使祭陵来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13708,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其八十八","author":"黄遵宪","text":"万众头攒日荫鬘，千行肃肃拜神官。\n何时重睹威仪盛？\n剑已飞天玺久刓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13709,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其八十九","author":"黄遵宪","text":"玉叶金枝共一家，剪桐分赐日兄花。\n定知禁脔无人近，不见天孙下嫁车。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13710,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其九十","author":"黄遵宪","text":"得宝无须聘妇钱，新弦唱彻《想夫怜》。\n同牵白发三千丈，共结红丝一百年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13711,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其九十一","author":"黄遵宪","text":"绛蜡高烧照别离，乌衣换毕出门时。\n小时怜母今怜婿，宛转双头绾色丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13712,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其九十二","author":"黄遵宪","text":"红珊簪子青罗伞，黑油镜台黄竹箱。\n姐妹两行携手送，一双新屐是新娘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13713,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其九十三","author":"黄遵宪","text":"三千大神监誓词，万亿菩萨作盟司。\n君看壶头双蛱蝶，夫夫妇妇不相离。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13714,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其九十四","author":"黄遵宪","text":"义儿有传半呼甥，归妹占爻许配兄。\n似此冒宗齐赘婿，最难议礼鲁诸生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13715,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其九十五","author":"黄遵宪","text":"覆鹈产殿映灯红，汤饼筵开笑语中。\n五月吾妻桥上望，画旗争飏鲤鱼风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13716,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其九十六","author":"黄遵宪","text":"春在梅梢月柳梢，红阑屈曲影相交。\n别开待阙鸳鸯社，不愿鸠居占鹊巢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13717,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其九十七","author":"黄遵宪","text":"游部君兼石作公，歌桓护葬习丧容。\n紫衣丹首黄金目，甲作传家善食凶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13718,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其九十八","author":"黄遵宪","text":"炮声殷地国旗斜，素霎相随广柳车。\n大小红皆披吉服，神官浇酒客持花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13719,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其九十九","author":"黄遵宪","text":"散路抛钱买路行，莲花妙法写铭旌。\n桐棺三寸如人立，易履相迎入化城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13720,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一○○","author":"黄遵宪","text":"乌啼月落写哀思，剪发翻同练行尼。\n红泪洒来题赤字，不堪石阙独含悲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13721,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一○一","author":"黄遵宪","text":"插花浇水拂杨枝，台笠相从拜墓碑。\n迎佛诵经邀客酒，忌辰算到百周时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13722,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一○二","author":"黄遵宪","text":"芒鞋竹杖佛接引，柳车草船神送迎。\n画旗猎猎夜风卷，时有经声杂鬼声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13723,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一○三","author":"黄遵宪","text":"不环不钏不钗光，雅头袜子足如霜。\n蓬山未至人多少，都道温柔是婿乡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13724,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一○四","author":"黄遵宪","text":"骀荡春风士女图，妾眉如画比郎须。\n并头鹦鹉双双语，此唤檀那彼奥姑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13725,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一○五","author":"黄遵宪","text":"眉心点翠额安黄，云鬓堆鸦学艳妆。\n绣葆呱呱怀抱里，小姑居处尚无郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13726,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一○六","author":"黄遵宪","text":"繁华南部记烟花，七十鸳鸯数狭邪。\n欲聘狸奴先问价，红笺分送野猫家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13727,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一○七","author":"黄遵宪","text":"弹尽三弦诉可怜，沉沉良夜有情天。\n楼头月照人团聚，到老当如鸡卵圆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13728,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一○八","author":"黄遵宪","text":"狭巷阴宫狱气凄，马缨一树夜乌栖。\n花阴月黑羊车过，供鬼揶揄作鬼妻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13729,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一○九","author":"黄遵宪","text":"当炉少女似罗敷，精舍安排莞簟铺。\n茶鼎酒铛亲料理，语郎团坐且须臾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13730,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一一○","author":"黄遵宪","text":"锦棚悬鹄插雕弧，孔雀屏开列画图。\n左右射来齐中目，拍肩都道子南夫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13731,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一一一","author":"黄遵宪","text":"回廊曲曲护屏风，香案镂银拍板红。\n衔得杨花入窠里，便夸姹女数钱工。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13732,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一一二","author":"黄遵宪","text":"压帽花枝挂杖钱，冶春词唱《小游仙》。\n杏黄衫子黄桑屐，自赏翩翩美少年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13733,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一一三","author":"黄遵宪","text":"追风快马缠锦绦，袜胸帕首弓在搜。\n一声雁落血如雨，金原秋冷霜天高。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13734,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一一四","author":"黄遵宪","text":"山深太古日如年，小屋阴凉树插天。\n拜疏公庭争乞假，要从热海浴温泉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13735,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一一五","author":"黄遵宪","text":"斜阳红映酒旗低，食?归时袖各携。\n都为细君留割肉，自挤空酌醉如泥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13736,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一一六","author":"黄遵宪","text":"湘帘半卷绮窗开，帕腹帩头烂漫堆。\n道是莲池清净土，未妨天女散花来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13737,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一一七","author":"黄遵宪","text":"短衣窄袖曼胡缨，意态纵横一座倾。\n耳后生风鼻头火，拓弦时作饿鸱声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13738,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一一八","author":"黄遵宪","text":"解鞘君前礼数工，出门双锷插青虹。\n无端一语差池怒，横溅君衣颈血红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13739,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一一九","author":"黄遵宪","text":"当王徽号贵黄华，时唤臣僚共斗花。\n淡极秋容翻富贵，疏篱茅舍到官家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13740,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一二○","author":"黄遵宪","text":"狗吠声腾马足驰，狩衣草屦古威仪。\n锦旗日曜红轮影，来看公侯习犬追。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13741,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一二一","author":"黄遵宪","text":"朝曦看到夕阳斜，流水游龙斗宝车。\n宴罢红云歌绛雪，东皇第一爱樱花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13742,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一二二","author":"黄遵宪","text":"抟花作饭胜胡麻，嚼蕊流酥更点茶。\n费尽挼莎才结果，果然团子贵于花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13743,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一二三","author":"黄遵宪","text":"殿春花事到将离，云似人愁水似思。\n一尺落花和泪雨，手添香土吊梅儿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13744,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一二四","author":"黄遵宪","text":"镜槛新开响屟忙，溶溶四壁照花光。\n为渠一笑三年住，却记衣襟未染香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13745,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一二五","author":"黄遵宪","text":"银字儿兼铁骑儿，语工歇后妙弹词。\n英雄作贼鸳鸯殉，信口澜翻便传奇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13746,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一二六","author":"黄遵宪","text":"枣花泼过翠萍生，沫碎茶沉雪碗轻。\n矮室打头人对语，铜瓶雨过悄无声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13747,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一二七","author":"黄遵宪","text":"百练真成绕指柔，幻人妙术过婆猴。\n随身一卷东黄祝，行脚能周五大洲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13748,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一二八","author":"黄遵宪","text":"柳燧荷囊事事俱，小盆亲饷淡巴菰。\n一声湘管含芬递，喜食人间烟火无？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13749,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一二九","author":"黄遵宪","text":"月支毾㲪花千色，王母琉璃酒百钟。\n破产争求番舶物，只赢不买阿芙蓉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13750,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一三○","author":"黄遵宪","text":"鲤鱼风紧舶来初，唐馆豪商比屋居。\n棉雪糖霜争购外，人人喜问上清书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13751,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一三一","author":"黄遵宪","text":"敲碎银花剥镜菱，莹莹光映玉壶澄。\n暑中胜服清凉散，争买舶来函馆冰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13752,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一三二","author":"黄遵宪","text":"让叶劳薪插户前，人人都道是新年。\n故乡正作消寒会，兽炭红炉一九天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13753,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一三三","author":"黄遵宪","text":"零落街头羽板稀，已捐团扇过时衣。\n儿时嬉戏都如梦，不见翩翩蛱蝶飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13754,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一三四","author":"黄遵宪","text":"蛭子神丛奏鼓笳，花糕分饷到千家。\n凤音纪月元猪日，谁记东京录梦华？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13755,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一三五","author":"黄遵宪","text":"进贤冠顶玉交枝，高髻峨峨花四披。\n廿六阶分《舆服志》，礼容如见汉官仪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13756,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一三六","author":"黄遵宪","text":"天吴紫凤颇文华，凭取花纹认世家。\n三百年来夸衣被，葵能卫足竟如花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13757,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一三七","author":"黄遵宪","text":"一双角子影娉婷，问取年华近算丁。\n种得瓠花添鬓福，愿花常好鬓常青。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13758,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一三八","author":"黄遵宪","text":"白题胡舞翻新样，黄胖春游学少年。\n脱却垂檐莞笠子，十分团月到鹂颠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13759,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一三九","author":"黄遵宪","text":"对镜惭看薄薄胡，时妆孤负好头颅。\n青青不久星星出，间引毛锥学种须。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13760,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一四○","author":"黄遵宪","text":"六尺湘裙贴地拖，折腰相对舞回波。\n偶然风漾中单露，酒晕无端上颊涡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13761,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一四一","author":"黄遵宪","text":"锦衾双袖剪文罗，未许春寒到被窝。\n始识寝衣长过半，牺尊莫误凤莎莎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13762,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一四二","author":"黄遵宪","text":"声声响屟画廊边，罗袜凌波望若仙。\n绣作莲花名藕覆，鸳鸯恰似并头眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13763,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一四三","author":"黄遵宪","text":"千门万户未分明，面面屏风白月生。\n数尺花茵尘不动，偶闻橐橐有靴声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13764,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一四四","author":"黄遵宪","text":"花茵重叠有辉光，长跪敷衽客满堂。\n除却凤衔丹诏至，未容高坐踞胡床。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13765,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一四五","author":"黄遵宪","text":"雪泥深尺护檐牙，瓦背浓阴四角遮。\n不用茅龙衣屡换，一年一度屋开花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13766,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一四六","author":"黄遵宪","text":"染指流涎各欲尝，既调勺药又和姜。\n食单蔬谱兼䱉议，合补东人江户香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13767,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一四七","author":"黄遵宪","text":"菭菹芦菔作家常，饭稻羹鱼沁肺凉。\n踏破菜园新作梦，大餐饱食大官羊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13768,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一四八","author":"黄遵宪","text":"琼芝作菜绿荷包，槐叶清泉尽冷淘。\n蔬笋总无烟火气，居然寒食度朝朝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13769,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一四九","author":"黄遵宪","text":"何物坚鱼字所无，侯鲭御馔各登厨。\n儒生习礼疑蚳酱，口到今人嗜亦殊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13770,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一五○","author":"黄遵宪","text":"甚嚣尘上逐人行，日本桥头晚市声。\n别有菜场鱼店外，丹枫落叶卖山鲸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13771,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一五一","author":"黄遵宪","text":"镜饼琼枨乍上盘，盘中花果各阑干。\n手携团月歌团雪，共饱妻孥欢喜丸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13772,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一五二","author":"黄遵宪","text":"笙清簧暖小排当，雅乐伶官各擅场。\n合四乙工仍燕乐，漫夸古调谱清商。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13773,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一五三","author":"黄遵宪","text":"吹螺竞作天魔舞，傅粉翻同脂夜妖。\n红襦绣领碧绸裤，骑上屋山打细腰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13774,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一五四","author":"黄遵宪","text":"金鱼紫袋上场时，鼍鼓声停玉笛吹。\n乐奏太平唐典礼，衣披一品汉官仪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13775,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一五五","author":"黄遵宪","text":"铿锵鼓舞只依稀，守乐伶官记半非。\n弹到金獐涩河鸟，古音唯剩妃呼豨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13776,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一五六","author":"黄遵宪","text":"仙词选定《浅茅原》，朝贵传宣朱雀门。\n青摺肩衣红帕首，两行舞踏上歌垣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13777,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一五七","author":"黄遵宪","text":"檀腹琵琶出锦囊，曾偕羯鼓谱《霓裳》。\n大唐法曲今谁读？\n空记当年刘二郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13778,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一五八","author":"黄遵宪","text":"上悬绣幕下红毹，左列句当右大夫。\n牙拨齐弹三味线，姑卢朱路复乌乌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13779,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一五九","author":"黄遵宪","text":"玉箫声里锦屏舒，铁板敲停上舞初。\n阿母含辛儿忍泪，归来重对话芝居。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13780,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一六○","author":"黄遵宪","text":"剖破焦桐别制琴，三弦揩击有余音。\n一声弹指推衣起，明月中天鹤在林。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13781,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其一六一","author":"黄遵宪","text":"弦弦掩抑奈人何，假字哀吟伊吕波。\n三十一声都怆绝，莫披《万叶》读和歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13782,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]