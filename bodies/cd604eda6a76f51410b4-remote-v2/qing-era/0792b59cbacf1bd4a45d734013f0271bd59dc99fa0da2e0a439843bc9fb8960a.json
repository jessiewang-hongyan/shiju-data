b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题织图二十三首 其七 第七图","author":"玄烨","text":"桑田雨足叶蕃滋，恰是春蚕大起时。\n负筥携筐纷笑语，戴鵀飞上最高枝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36572,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题织图二十三首 其八 第八图","author":"玄烨","text":"频执纤筐不厌疲，久忘膏沐与调饥。\n今朝士女欢颜色，看我冰蚕作茧时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36573,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]