[{"title":"到京即病稍闲偶成","author":"郑珍","text":"病里潜消满面沙，欲书一纸寄天涯。\n踌躇已近春三月，却恐身先信到家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36500,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"病中绝句二首 其一","author":"郑珍","text":"莫五璃厂回，又回璃厂路。\n似看衔书鼠，寂寂来复去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36501,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"病中绝句二首 其二","author":"郑珍","text":"安排六个月，偿足二万里。\n已过春中閒，看看到粽子。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36502,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"得雪楼舅新平书","author":"郑珍","text":"相望南北半周天，此纸何由到眼前。\n出处秖今并难道，滇花蓟树满愁烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36503,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春","author":"玄烨","text":"旭日含新淑，春光覆满屋。\n东皇转岁华，融气杂山谷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36504,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日郊行","author":"玄烨","text":"春殿晴云绕，銮舆出禁闱。\n桃花临紫陌，柳叶暗青旂。\n宿雨能清跸，和风早拂衣。\n马嘶驰道远，满地尽芳菲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36505,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉泉春晓","author":"玄烨","text":"郊墅初晴后，芳春曙色旋。\n孤鸾堆画障，细穴吐新泉。\n浪静鲜鳞跃，风恬紫菂妍。\n怡情看万象，浩浩思无边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36506,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日观花","author":"玄烨","text":"枝上流莺早，千红万紫香。\n气融催景丽，风过递年芳。\n秾李花犹浅，垂杨叶未长。\n涧中春溜发，疑是奏笙簧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36507,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"景山春望","author":"玄烨","text":"云霄千尺倚丹邱，辇下山河一望收。\n凤翥中天连紫阙，龙蟠北极壮皇州。\n烟生沆瀣春初丽，露湿芙蓉翠欲流。\n却向闾阎看蔀屋，崇高还廑庙堂忧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36508,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"后苑漫兴","author":"玄烨","text":"佳气青葱绕苑墙，红泉紫岫胜云庄。\n雕阑细草经春满，绮阁繁花入午香。\n雨露生成随品类，鸢鱼飞跃自低昂。\n閒亭久坐浑无事，静对琴书觉意长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36509,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春夜","author":"玄烨","text":"玉炉烟霭尽，夜静百花香。\n曙气浮丹陛，春光拂象床。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36510,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日","author":"玄烨","text":"佳气山川浃地行，物随节候变初晴。\n雪消树底花争发，冰泮池头草欲生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36511,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春晴舟中作","author":"玄烨","text":"野水漫漫野岸长，几行嫩柳带斜阳。\n不知春色来多少，但觉飞花处处香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36512,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"元夜与诸王宴饮乾清宫","author":"玄烨","text":"今夕丹帏宴，联翩集懿亲。\n传柑宜令节，行苇乐芳春。\n香泛红螺重，光摇绛蜡新。\n不须歌湛露，明月足留人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36513,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春盘","author":"玄烨","text":"小摘园中露，新香糁作羹。\n岁和欣有兆，甘菜已春生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36514,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"立春调寄太平时","author":"玄烨","text":"淑景维新爆竹声。\n手调羹。\n词臣载笔赋琼英。\n学西凉。\n凤阁龙楼昼渐长。\n物资生。\n劝官勉力尽升平。\n竹马迎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36515,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日内苑赐宴诗并序","author":"玄烨","text":"春深内苑里，珍席宴群臣。\n蝶向双檐舞，花飞复阁新。\n和羹期上佐，调鼎协洪钧。\n萧鼓欢无极，芳年醉此辰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36516,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"途次逢寒食","author":"玄烨","text":"何处来春风，澹荡开晴旭。\n不见杏花红，才逢柳梢绿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36517,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清明","author":"玄烨","text":"已日才从江岸行，舟中还复度清明。\n上林闻道花迟发，留与归时听早莺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36518,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清明登玉泉山","author":"玄烨","text":"寒食登高芳草青，泉声映柳出春亭。\n心中怀得天然处，坐对沙鸥乐野汀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36519,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"桥望","author":"玄烨","text":"郊原浮麦气，池沼漾青蘋。\n夏日临桥望，薰风处处新。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36520,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏日迎薰亭","author":"玄烨","text":"苑启时初夏，亭阴午未阑。\n雨过池藻碧，日绽海榴丹。\n水木含清景，禽鱼得静观。\n薰风能解愠，试取玉琴弹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36521,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏日郊行","author":"玄烨","text":"节变春方去，清和助麦秋。\n蔚林乘早夏，茂草接新流。\n柳絮堤边起，荷钱水上浮。\n风光殊旧日，此意未曾休。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36522,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"初夏玉泉山二首 其一","author":"玄烨","text":"别馆依丹麓，疏帘映碧莎。\n泉声当槛出，花气入垣多。\n路转溪桥接，舟沿石窦过。\n薰风能阜物，藻景已清和。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36523,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"初夏玉泉山二首 其二","author":"玄烨","text":"山翠引鸣镳，湖光漾画桡。\n野云低隔寺，沙柳暗藏桥。\n百啭黄鹂近，双飞白鹭遥。\n今年农事早，时雨足新苗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36524,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏日閒坐","author":"玄烨","text":"云敛风微紫燕飞，春光已去夏初归。\n清襟赢得天然处，暗觉花香到玉扉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36525,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"午日","author":"玄烨","text":"令序当重午，南台日正中。\n玉阶鸣瀑水，瑶轸奏薰风。\n菖叶浮杯绿，榴花照槛红。\n临流看竞渡，转忆济川功。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36526,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"途次端午","author":"玄烨","text":"蕤宾逢夏律，午日俯澄流。\n黄鸟林中变，新蒲岸外稠。\n宫筵传綵粽，仙酒泛丹榴。\n遥忆蓬莱上，垂杨荫御沟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36527,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"禁园秋霁","author":"玄烨","text":"树冷催蝉咽，荷疏表影长。\n深秋残暑气，微爽待高阳。\n户外远尘迹，园中多蕙香。\n溶溶新雨霁，吟乏愧成章。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36528,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"早秋新霁","author":"玄烨","text":"卷幕过新雨，披襟纳好风。\n馀霞明远岫，倒景射晴虹。\n稼穑丰年足，乾坤爽气同。\n高天云断处，历历见初鸿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36529,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"立秋前一日晚同左右閒坐进鲜果","author":"玄烨","text":"初到金风天气晚，微凉雨后画帘垂。\n九重迥出白云远，三殿高临北斗移。\n珍果满盘新献节，碧梧一叶报秋时。\n漏深不寐题诗句，月色煇煌照凤墀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36530,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"九日幸景山登高","author":"玄烨","text":"秋色净楼台，登高紫禁隈。\n千门鸣雁度，万井霁烟开。\n翠拂銮舆上，云随豹尾来。\n佳辰欣宴赏，满泛菊花杯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36531,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"塞外初冬","author":"玄烨","text":"阴山南去雁行多，渺渺沙原六御过。\n报是初冬新律改，依然霜晓气暄和。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36532,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"途中长至","author":"玄烨","text":"关塞经时跸未回，律逢葭琯暗飞灰。\n遥知日晷添宫线，暖阁前头放早梅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36533,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赋得爆竹声中一岁除是日微雪","author":"玄烨","text":"爆竹连宵不夜城，占年积素即丰盈。\n维新四始全仁政，脩省三朝冀太平。\n拂曙和风临上日，通晨淑气拥华清。\n愿将柏叶芳樽酒，赐与臣邻共太羹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36534,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"见途中夏麦将熟志喜","author":"玄烨","text":"江浒淮壖道已周，归看东省麦盈畴。\n雨滋膏润苗多秀，早庆今年大有秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36535,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清明麦秀","author":"玄烨","text":"清明前后麦花香，遍野氤氲映骕骦。\n须认秋成春雨密，隔溪村落饮斜阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36536,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋日出郊观稼","author":"玄烨","text":"秋气日寥迥，万象皆苍苍。\n朝暾被渥露，草木含晶光。\n西成方届候，农事将筑场。\n于焉省敛穫，令典重百王。\n轻轩屏前置，夙驾无严装。\n郊原一以眺，烟树纷成行。\n微风散深樾，清流抱回塘。\n土脉秀且沃，篝车郁相望。\n新䥥粲如月，刈此溪云黄。\n捃拾复何幸，遗秉满道旁。\n鸟雀互翔集，妇子咸悦康。\n行将吹苇籥，报尔千斯箱。\n眷言三时勤，艰难讵可忘。\n茫茫视九壤，岂尽歌丰穰。\n二釜苟不充，予饥惄如伤。\n幸兹乐有年，时若雨与旸。\n勖哉慎所丽，田功庶无荒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36537,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"观苗无意到潭柘咏时景","author":"玄烨","text":"昼永薰风至，清泉决决长。\n芳年添景色，迟日换流光。\n旧竹随堤发，新花满涧香。\n观苗不觉晚，微雨点衣裳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36538,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"入关见雨膏润泽禾苗茂遂喜而有作","author":"玄烨","text":"甘雨时霖为洗兵，恰逢战胜武功成。\n军容万队初旋凯，妇子千村正馌耕。\n天意要荒同职贡，人欢闾井共升平。\n征途每忆民生事，喜见桑麻惬此情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36539,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题耕图二十三首 其一 第一图","author":"玄烨","text":"暄和节候肇农功，自此勤劳处处同。\n早辨东田穜稑种，褰裳涉水浸筠笼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36540,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题耕图二十三首 其二 第二图","author":"玄烨","text":"土膏初动正春晴，野老支筇早课耕。\n辛苦田家惟穑事，陇边时听叱牛声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36541,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题耕图二十三首 其三 第三图","author":"玄烨","text":"每当旰食念民依，南亩三时愿不违。\n已见深耕还易耨，绿蓑青笠雨霏霏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36542,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题耕图二十三首 其四 第四图","author":"玄烨","text":"东阡西陌水潺湲，扶耖泥涂未得閒。\n为念饔飧由力作，敢辞竭蹶向田间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36543,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题耕图二十三首 其五 第五图","author":"玄烨","text":"老农力穑虑偏周，早夜扶犁未肯休。\n更驾乌犍施碌碡，好教春水满平畴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36544,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题耕图二十三首 其六 第六图","author":"玄烨","text":"农家布种避春寒，甲坼初萌最可观。\n自昔虞书传播谷，民间莫作等閒看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36545,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题耕图二十三首 其七 第七图","author":"玄烨","text":"一年农事在春深，无限田家望岁心。\n最爱清和天气好，绿畴千顷露秧针。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36546,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题耕图二十三首 其八 第八图","author":"玄烨","text":"从来土沃藉农勤，丰歉皆由用力分。\n薙草洒灰滋地利，心期千亩稼如云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36547,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题耕图二十三首 其九 第九图","author":"玄烨","text":"青葱刺水满平川，移植西畴更勃然。\n节序惊心芒种迫，分秧须及夏初天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36548,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题耕图二十三首 其十 第十图","author":"玄烨","text":"千畦水泽正瀰瀰，竞插新秧恐后时。\n亚旅同心欣力作，月明归去莫嫌迟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36549,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题耕图二十三首 其十一 第十一图","author":"玄烨","text":"丰苗翼翼出清波，荑稗丛生可若何。\n非种自应芟薙尽，莫教稂莠败嘉禾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36550,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题耕图二十三首 其十二 第十二图","author":"玄烨","text":"曾为耘苗结队行，更忧宿草去还生。\n陇间馈馌频来往，劳勚田家妇子情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36551,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题耕图二十三首 其十三 第十三图","author":"玄烨","text":"䆉稏盈畦日正长，复勤穮蓘下方塘。\n堪怜曝背炎蒸下，惟冀青畴发紫芒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36552,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题耕图二十三首 其十四 第十四图","author":"玄烨","text":"塍田六月水泉微，引溜通渠迅若飞。\n转尽桔槔筋力瘁，斜阳西下未言归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36553,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题耕图二十三首 其十五 第十五图","author":"玄烨","text":"满目黄云晓露晞，腰镰穫稻喜晴晖。\n儿童处处收遗穗，村舍家家荷担归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36554,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题耕图二十三首 其十六 第十六图","author":"玄烨","text":"年谷丰穰万宝成，筑场纳稼积如京。\n回思望杏瞻蒲日，多少辛勤感倍生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36555,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题耕图二十三首 其十七 第十七图","author":"玄烨","text":"南亩秋来庆阜成，瞿瞿未释老农情。\n霜天晓起呼邻里，遍听村村打稻声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36556,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题耕图二十三首 其十八 第十八图","author":"玄烨","text":"秋林茅屋晚风吹，杵臼相依近短篱。\n比舍舂声如和荅，家家篝火夜深时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36557,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题耕图二十三首 其十九 第十九图","author":"玄烨","text":"谩言嘉谷可登盘，糠秕还忧欲去难。\n粒粒皆从辛苦得，农家真作雨珠看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36558,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题耕图二十三首 其二十 第二十图","author":"玄烨","text":"作苦三时用力深，簸扬偏爱近风林。\n须知白粲流匙滑，费尽农夫百种心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3655