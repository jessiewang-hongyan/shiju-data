[{"title":"画栏","author":"胤禛","text":"薰风披拂画栏东，照眼榴花烂熳红。\n暑气不侵松阁内，清阴长在竹窗中。\n由来丘壑情堪寄，即此蓬瀛路可通。\n次第药阶香晚露，纤纤新月上梧桐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15701,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"美人把镜图四首 其一","author":"胤禛","text":"手摘寒梅槛畔枝，新香细蕊上簪迟。\n翠鬟梳就频临镜，只觉红颜减旧时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15702,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"美人把镜图四首 其二","author":"胤禛","text":"晓妆髻插碧瑶簪，多少情怀倩竹吟。\n风调每怜谁解会，分明对面有知心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15703,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"美人把镜图四首 其三","author":"胤禛","text":"竹风飒飒振琅籼，玉骨棱棱耐峭寒。\n把镜几回频拂拭，爱他长共月团栾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15704,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"美人把镜图四首 其四","author":"胤禛","text":"晓寒庭院闭苍苔，妆镜无聊倚玉台。\n怪底春山螺浅淡，画眉人尚未归来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15705,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"美人展书图二首 其一","author":"胤禛","text":"丹唇皓齿瘦腰肢，斜倚筠笼睡起时。\n毕竟痴情消不去，缃编欲展又凝思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15706,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"美人展书图二首 其二","author":"胤禛","text":"小院莺花正感人，东风吹软细腰身。\n抛书欲起娇无力，半是怜春半恼春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15707,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕图二十三首 其一 浸种","author":"胤禛","text":"百谷遗嘉种，先农著懋功。\n春暄二月后，香浸一溪中。\n重穋随宜辨，筠笼用力同。\n每多贤父老，占节识年丰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15708,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕图二十三首 其二 耕","author":"胤禛","text":"原隰韶光媚，茅茨暖气舒。\n青鸠呼雨急，黄犊驾犁初。\n畎亩人无逸，耕耘事敢疏！\n勤劬课东作，扶策历村墟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15709,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕图二十三首 其三 耙耨","author":"胤禛","text":"农务时方急，春潮堰欲平。\n烟笼高柳暗，风逐去鸥轻。\n压笠低云影，鸣蓑乱雨声。\n耙头船共稳，斜立叱牛行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15710,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕图二十三首 其四 耖","author":"胤禛","text":"南亩耕初罢，西畴耖复亲。\n四蹄听活活，十顷望畇畇。\n蝶舞黄萱晚，莺归绿树新。\n春光长不负，只有力田人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15711,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕图二十三首 其五 碌碡","author":"胤禛","text":"如轮转机石，历碌向东皋。\n驱犊亦何急，平田敢告劳。\n春塍萦似滞，沃壤腻于膏。\n水族堪供饷，倾樽醉蟹螯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15712,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕图二十三首 其六 布秧","author":"胤禛","text":"种包忻拆甲，岸畔竞携筐。\n活活冲泥布，纷纷落垄香。\n追随欢幼稚，祝祷愿丰穰。\n气候今年早，行看剌水秧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15713,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕图二十三首 其七 初秧","author":"胤禛","text":"珍惜占城种，携儿上垄来。\n一溪添雨足，盈亩喜秧开。\n宿露浓相浥，韶阳暖复催。\n忻忻频笑指，转眼可移栽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15714,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕图二十三首 其八 淤荫","author":"胤禛","text":"鸟鸣村陌静，春涨野桥低。\n已爱新秧好，旋看覆垄齐。\n淤时争早作，课罢岂安栖。\n沾体兼涂足，忙忙日又西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15715,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕图二十三首 其九 拔秧","author":"胤禛","text":"吉辰逢社后，比户趁忙时。\n盈把分青壤，和根灌绿漪。\n儿童担饷榼，妇子制秧旗。\n惯得为农乐，辛劳自不知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15716,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕图二十三首 其十 插秧","author":"胤禛","text":"令序当芒种，农家插莳天。\n倏分行整整，停看影芊芊。\n力合闻歌发，栽齐听鼓前。\n一朝千顷遍，长日正如年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15717,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕图二十三首 其十一 一耘","author":"胤禛","text":"饱雨纤纤长，含风叶叶柔。\n载芟除宿莠，挹注引新流。\n阴借临溪树，声传隔陇讴。\n炊烟村畔起，归路缓驱牛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15718,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕图二十三首 其十二 二耘","author":"胤禛","text":"郁郁平畴绿，劳劳一载耘。\n理苗疏是法，非种去宜勤。\n笠重初收雾，锄轻半带云。\n日高忙饷妇，稚子故牵裙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15719,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕图二十三首 其十三 三耘","author":"胤禛","text":"锄莠日当午，骄阳若火燔。\n耘耔须尽力，辛苦只今番。\n蝉噪风前急，蛙声水底喧。\n酿花宜郁暑，翠浪舞翩翻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15720,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕图二十三首 其十四 溉灌","author":"胤禛","text":"艺夺天工巧，人勤地力加。\n桔槔声振鼓，戽斗疾翻车。\n灌注畦旋满，呕哑日欲斜。\n况兼风露美，篟篟吐新华。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15721,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕图二十三首 其十五 收刈","author":"胤禛","text":"西成已在望，早作更呼欢。\n刈穗香生把，盈筐露未干。\n啄遗鸦欲下，拾滞稚争欢。\n主伯欣相庆，丰年俯仰宽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15722,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕图二十三首 其十六 登场","author":"胤禛","text":"红籼收十月，白水浸陂塍。\n酿熟田家庆，场新岁事登。\n云堆香冉冉，露积势层层。\n劳瘁三时过，饔飧幸可凭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15723,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕图二十三首 其十七 持穗","author":"胤禛","text":"力田欣有岁，晒稻喜晴冬。\n响落连耞急，尘浮夕照浓。\n鼠衔犹畏懦，鸡啄自从容。\n幸值丰亨世，尧民比屋封。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15724,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕图二十三首 其十八 舂碓","author":"胤禛","text":"野陌霜风早，柴门晚日多。\n舂声接邻响，杵韵洽豳歌。\n颗颗珠倾篚，莹莹雪满箩。\n为怜艰苦得，把握屡摩挲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15725,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕图二十三首 其十九 筛","author":"胤禛","text":"治粒频求洁，田家亦苦心。\n筛风当户北，避日就檐阴。\n一饱功非易，终年力不禁。\n君看圆似玉，我爱胜如金。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15726,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕图二十三首 其二十 簸扬","author":"胤禛","text":"朝来风色好，箕宿应维南。\n敢惜翻飞力，宁教糠秕参。\n干圆输县吏，狼藉戒童男。\n得免催租负，方无俯仰惭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15727,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕图二十三首 其二十一 砻","author":"胤禛","text":"地结霜痕白，檐虚夜气青。\n声殷砻早谷，风动闭寒扃。\n玉色鲜堪比，珠光泻不停。\n蒸炊谋室妇，农祖荐朝馨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15728,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕图二十三首 其二十二 入仓","author":"胤禛","text":"勤劳临岁暮，入囷及良朝。\n墉栉宁奢望，储藏幸已饶。\n赋完农有暇，门静吏无嚣。\n苫廪牢封固，无虞雨雪飘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15729,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕图二十三首 其二十三 祭神","author":"胤禛","text":"雨旸征帝德，丰稔慰氓愚。\n赛鼓村迎社，神灯夜祷巫。\n酒浆泻罂盎，肴核献盘盂。\n敢乞长年惠，穰穰遂所需。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15730,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"织图二十三首 其一 浴蚕","author":"胤禛","text":"门多杨柳风，溪涨桃花水。\n村酒酝羊羔，春闺浴蚕子。\n纤纤弄翠盆，戢戢蠕香纸。\n雪茧与冰丝，妇功从此始。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15731,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"织图二十三首 其二 二眠","author":"胤禛","text":"百舌鸟初鸣，再眠蚕在箔。\n陌桑青已柔，堤草绿犹弱。\n正宜旭日和，惟恐春寒作。\n妇忙儿不知，枣栗频啼索。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15732,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"织图二十三首 其三 三眠","author":"胤禛","text":"春见拂帘栊，春露繁桑柘。\n绕箔理三眠，烧灯绕五夜。\n大姑席未安，小姑梳弗暇。\n喔喔唱邻鸡，提筐邀比舍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15733,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"织图二十三首 其四 大起","author":"胤禛","text":"今春寒暖匀，南陌条桑好。\n箔上叶忧稀，枝头采戒早。\n不知春几多，但觉蚕欲老。\n阿谁红粉妆，寻芳踏堤草。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15734,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"织图二十三首 其五 捉绩","author":"胤禛","text":"生熟乃有时，老嫩莫纷糅。\n恐烦姑与嫜，服劳夜继昼。\n松火发瓦盆，星芒射阶溜。\n次第了架头，匆忙顾童幼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15735,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"织图二十三首 其六 分箔","author":"胤禛","text":"新燕掠风轻，新蚕偕日长。\n分箔天气暄，食叶雨声响。\n少妇采林间，倦归歇陌上。\n门前桑骚骚，黄云接青壤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15736,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"织图二十三首 其七 采桑","author":"胤禛","text":"清和天气佳，比户采桑急。\n瀼瀼零露繁，冉冉绿阴湿。\n高柯学猱升，落葚教儿拾。\n昨摘满笼归，姑犹嗔不给！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15737,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"织图二十三首 其八 上簇","author":"胤禛","text":"东邻催早耕，西舍呼浸谷。\n花残蜀鸟啼，春老吴蚕熟。\n蚑蚑鞠雪腰，盈盈皤丝腹。\n剪草架初齐，女郎看上簇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15738,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"织图二十三首 其九 炙箔","author":"胤禛","text":"温扇花信风，寒酝麦秋雨。\n葭帘张蟹舍，松盆暖蚕户。\n香生雪茧明，光吐银丝缕。\n门忌少人踪，语燕喧衡宇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15739,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"织图二十三首 其十 下簇","author":"胤禛","text":"前月浴新蚕，今月摘新茧。\n浴蚕柳叶纤，摘茧柳绵卷。\n膏沐曾未施，风光觉潜转。\n邻曲慰劳来，欢情一共展。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15740,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"织图二十三首 其十一 择茧","author":"胤禛","text":"倾筐香雪明，择茧檐日上。\n大半作丝纶，三分充绵纩。\n嘱妪理从容，择惯知瘠壮。\n所虑梅雨过，插秧趁溪涨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15741,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"织图二十三首 其十二 窖茧","author":"胤禛","text":"挽袖解长裙，香汗湿红颊。\n农事委良人，蚕功独在妾。\n层层下簇完，劳劳窖茧接。\n作苦感天公，冰雪满箱箧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15742,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"织图二十三首 其十三 练丝","author":"胤禛","text":"烟流矮屋青，水汲前溪洁。\n掉车若卷风，映釜如翻雪。\n丝头入手长，左右旋转忙。\n轧轧听交响，行人闻茧香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15743,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"织图二十三首 其十四 蚕蛾","author":"胤禛","text":"邻始通往来，暂时解忙促。\n出茧影翩翩，翅光腻粉沃。\n秧苗已抽青，桑叶再见绿。\n送蛾须水边，流传笑农俗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15744,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"织图二十三首 其十五 祀神","author":"胤禛","text":"丰祀报先蚕，洒庭伫来格。\n酾酒注樽罍，献丝当圭璧。\n堂下趋妻孥，堂上拜主伯。\n神惠乞来年，盈箱赐倍获。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15745,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"织图二十三首 其十六 纬","author":"胤禛","text":"盈盈纬车妇，荆布事素朴。\n丝丝理到头，的的出新濯。\n心忙不遑食，腕倦何曾觉。\n忽听归鸦啼，斜阳挂屋角。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15746,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"织图二十三首 其十七 织","author":"胤禛","text":"一梭复一梭，频掷青灯侧。\n艳艳机上花，朵朵手中织。\n娇女眠齁齁，秋虫语唧唧。\n檐头月渐高，纸窗明晓色。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15747,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"织图二十三首 其十八 络丝","author":"胤禛","text":"女红亦颇劳，凄然当户叹。\n灯昏络素丝，篗重困柔腕。\n纤纤鬓影寒，沉沉夜气半。\n妾心不敢忙，心忙丝绪乱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15748,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"织图二十三首 其十九 经","author":"胤禛","text":"昨为篗上丝，今作轴中轻。\n均匀细分理，珍重相叮咛。\n君看千万缕，始成丈尺绢。\n城市纨绔儿，辛苦何尝见！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15749,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"织图二十三首 其二十 染色","author":"胤禛","text":"深浅练縓纁，苍黄运巧智。\n把丝晒柴荆，临风含绮思。\n焕然五色纷，烂若云霞炽。\n好语付机工，金梭织锦字。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15750,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"织图二十三首 其二十一 攀花","author":"胤禛","text":"织绢当织长，挽花要挽双。\n绪繁劳玉腕，梭冷烬银缸。\n新样胜吴绫，斜文赛蜀锦。\n成匹落谁家，讵忍栽衾枕！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15751,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"织图二十三首 其二十二 剪帛","author":"胤禛","text":"千丝复万丝，成帛良非偶。\n握尺重含情，欲剪频低首。\n红分的的桃，青擘柔柔柳。\n但免舅姑寒，妾单亦何丑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15752,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"织图二十三首 其二十三 裁衣","author":"胤禛","text":"九月届授衣，缝纫难容缓。\n戋戋逐剪裁，楚楚称长短。\n刀尺迎风寒，元黄委云满。\n帝力并天时，农蚕慰饱暖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15753,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"群仙册一十八首 其一 谭元","author":"胤禛","text":"胜境邀仙侣，飞軿访上真。\n瑶华拂星佩，沆瀣湿云巾。\n饵玉颜含彩，怀丹气自春。\n长生探秘诀，守寂炼形神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15754,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"群仙册一十八首 其二 桃熟","author":"胤禛","text":"移种瑶池畔，今看实压枝。\n香含红熟透，露湿碧荣滋。\n七颗盛盘日，千年乂摘期。\n朝来谒金阙，甘美献天墀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15755,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"群仙册一十八首 其三 赏荷","author":"胤禛","text":"翠盖千重合，冰华万古清。\n人寰夸玉井，仙露胜金茎。\n质秀香尤异，波凉暑不生。\n逍遥蓬岛内，未拟赴瑶京。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15756,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"群仙册一十八首 其四 鼓瑟","author":"胤禛","text":"树树花如雪，层层玉作天。\n芝栽成五色，鹤养已千年。\n云帔来真侣，霞浆饮上仙。\n和歌新制曲，宝瑟奏冰弦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15757,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"群仙册一十八首 其五 鹿辇","author":"胤禛","text":"白鹿充仙驭，青禽识羽童。\n期朝太素帝，约会上清宫。\n草拾瑶池畔，笙吹郁岛中。\n更倾琼液酒，一醉寿春红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15758,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"群仙册一十八首 其六 迎福","author":"胤禛","text":"翠凝松万岁，香发桂双柎。\n地接三清境，天开五福图。\n童颜如冠玉，仙佩总垂珠。\n行满虚皇召，骖鸾立可须。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15759,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"群仙册一十八首 其七 跨角兽","author":"胤禛","text":"凌霄丹嶂迥，行处彩霞飞。\n独角仙家骑，双童鸟羽衣。\n遨游三岛遍，俯瞰九河微。\n南极寻前约，云边启玉扉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15760,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"群仙册一十八首 其八 戏狮","author":"胤禛","text":"青猊原瑞物，长养属仙家。\n迟日呼童子，春风试爪牙。\n食惟衔露草，卧为护丹砂。\n好献通明殿，天衢驭帝车。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15761,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"群仙册一十八首 其九 泛海","author":"胤禛","text":"碧海长无浪，红云不作秋。\n月槎飘一叶，莲瓣荡扁舟。\n竞向银河渡，还从星渚留。\n年年赓帝寿，元鹤记添筹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15762,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"群仙册一十八首 其十 采苓","author":"胤禛","text":"圣人长驭世，仙子启灵踪。\n秘结千龄饵，香腴万载松。\n雪霜凝珀质，龙虎护云封。\n酿酒充尧斝，春光驻鹤容。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15763,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"群仙册一十八首 其十一 烧丹","author":"胤禛","text":"铅砂和药物，松柏绕云坛。\n炉运阴阳火，功兼内外丹。\n光芒冲斗耀，灵异卫龙蟠。\n自觉仙胎熟，天符降紫鸾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15764,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"群仙册一十八首 其十二 巨桃","author":"胤禛","text":"根盘红日近，枝耸碧云高。\n阆苑邻青李，瑶池映翠涛。\n偷须防曼倩，熟拟宴仙曹。\n莫讶如瓜大，甘香胜玉膏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15765,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"群仙册一十八首 其十三 步雪","author":"胤禛","text":"绛雪呈奇瑞，琼枝花遍开。\n昆仑银烂漫，碧落玉崔嵬。\n粉蝶凌风舞，霜禽接翅来。\n海天长不夜，真境识蓬莱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15766,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"群仙册一十八首 其十四 桧下会真","author":"胤禛","text":"太乙须眉古，虚皇冠佩尊。\n元初参得一，天地论归根。\n琼液卮卮满，琪花处处繁。\n欣看前种桧，老干已龙鶱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15767,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"群仙册一十八首 其十五 抚鹿","author":"胤禛","text":"遥指蓬山麓，轩临弱水濆。\n鹿驯眠细草，沙暖覆香云。\n石亦含灵气，泉皆发异芬。\n呦呦鸣未已，林外每呼群。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15768,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"群仙册一十八首 其十六 双鸾","author":"胤禛","text":"一派箫璈涌，歌声云外飘。\n青童擎羽盖，翠扇执垂髫。\n晓籁鸣环玉，天风拂粉绡。\n双鸾王母使，传简下层霄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15769,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]