[{"title":"幽州马客吟","author":"曾灿垣","text":"北人重骅骝，南人习驽马。\n幽州马客雄北方，年年买马出西夏。\n朝闻羽骑驰江南，驱马千群自南下。\n千金不惜表霜蹄，百金不惜连障泥。\n南方土热违马性，南方技浅薄马医。\n朝夕掉尾扑蛟蠛，霜毛落尽露筋脊。\n今年壮士食马肉，明岁燕台悬骏骨。\n东市买马鞭，西市买马鞍。\n锦障秋风裂，荒槽晓月寒。\n南人款段日驰逐，归饱豆栈果下宿。\n马客朝来出无车，行向人家借黄犊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4637,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卜居","author":"曾灿垣","text":"野老蜗牛舍，渔翁梭子船。\n各自不相易，同寄一山川。\n倏鱼喜浮阳，往往为饵牵。\n当其胠泥沙，岂不愿深渊。\n人生各有营，阅途纷万千。\n苟欲宅其身，岂不在圣贤。\n世人尚眉睫，小喜快当前。\n朝菌与蟪蛄，分争大小年。\n多谢繁华子，厚意似微怜。\n凫鹤不相续，贱性靡所迁。\n不疑又何卜，中情良谓然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4638,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"喜二谢至","author":"曾灿垣","text":"幽梦不相期，开门适所思。\n楼当山缺处，客到酒香时。\n乱草十余步，闲花三两枝。\n忍看今夜月，已隔柳阴迟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4639,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丙申除夕 其一","author":"曾灿垣","text":"最是劳人处，残年待夕阳。\n忧危身易老，离乱日尤长。\n腊酒酬穷鬼，文章落战场。\n独怜天地大，醉眼混玄黄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4640,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丙申除夕 其二","author":"曾灿垣","text":"向夕平安火，千门望寂然。\n役夫徵隔岁，征吏急穷年。\n敝屦行荒市，余生付石田。\n谁知此日月，数里异风烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4641,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"偕吴友圣登吴山","author":"曾灿垣","text":"西山突兀俯城隈，客里同过坐石苔。\n绝顶风烟愁立马，百年邂逅几登台。\n海门浪屋潮头见，郡市鱼鳞水面开。\n吴越兴亡俱在眼，那能词赋不生哀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4642,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山中访邱醉石见小径菊花有作","author":"向文焕","text":"秋菊经霜老，霜高汝亦寒。\n偶将摇落意，惜此晚芳残。\n为与故人约，相期今日欢。\n黄花小径外，鸡犬款门阑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4643,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"访舫公不遇老僧同回","author":"向文焕","text":"物外访禅隐，萋萋霜草深。\n香云沉佛阁，落叶点松阴。\n木纳老僧性，幽栖寒鸟心。\n重门扃阗寂，何处作孤寻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4644,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"上林山庄雨中刈稻","author":"向文焕","text":"山田不耐雨，霢霢只经旬。\n秋事勤朝夕，生涯多苦辛。\n公家有常赋，邻叟不嗟贫。\n寄谢远游子，吾生甘隐沦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4645,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岁晏 其一","author":"申涵光","text":"岁晏百物息，草木随风沙。\n松柏惨不舒，况彼园中花。\n层阴昼萧条，微霰时复加。\n林中常鸣狐，屋上常鸣鸦。\n岂不思远游，负手还咨嗟。\n阳气动飞灰，枯荄渐萌芽。\n严威蕴华滋，深藏古所嘉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4646,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岁晏 其二","author":"申涵光","text":"荆吴隔大江，风涛不可涉。\n短衣凌荒岑，挂桨拨寒月。\n玄云闭河梁，故人书久绝。\n目招谁家儿，轻扬弄绮陌。\n投我蛱蝶罗，系以双玉玦。\n我畏不敢过，中途自改辙。\n弱草披涧阴，梧桐峙高阙。\n本非同根生，荣瘁应各别。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4647,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岁晏 其三","author":"申涵光","text":"亭亭西山云，万仞青芙蓉。\n下临不测渊，土有太古松。\n松顶巢黄鹤，渊中藏蛟龙。\n蹑屐披云根，乱石翳蓊茸。\n隔溪三五人，濯足吟疏风。\n白发好容颜，无乃商山翁。\n汉庭亦已出，书币凋淳蒙。\n真隐自草木，岂贪世上功。\n落日凌紫烟，挥手吾焉从。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4648,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"匡庐吟问李饶州志清","author":"申涵光","text":"汝从江右返，正当秋雁分。\n几时离却鄱阳水，衣裘尚带匡山云。\n我闻匡山天下绝，飞泉百丈吹琼雪。\n香炉五老没层云，影入波涛峰势折。\n闻有陆羽井，又有远公台。\n李白读书心所好，至今魂魄应常来。\n我曾东入吴，扬帆下西浙。\n杨子太湖水，满眼吴山北固皆丘垤。\n十载匡庐幽梦结，西江血满鄱湖热。\n兵戈遥隔子猷船，汝若曾登可细说。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4649,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"邯郸行","author":"申涵光","text":"西风吹落叶，飒飒邯郸道。\n邯郸兵火后，人家生白草。\n我闻邯郸全盛时，朱楼银烛光琉璃。\n赵女临窗调宝瑟，楼前走马黄金羁。\n即今富贵皆安在，惟有西山青不改。\n不见游侠子，白日报仇饮都市。\n亦不见垆边倡，华袿凤髻明月珰。\n旧城寥落荆榛里，楼台粉黛皆茫茫。\n城边过客飞黄土，城上凭临日正午。\n照眉池畔落寒鸦，不信此地曾歌舞。\n探鷇沙丘去不回，霸图消歇更堪哀。\n邯郸之人思旧德，至今犹上武灵台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4650,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春雪歌","author":"申涵光","text":"北风昨夜吹林莽，雪片朝飞大如掌。\n南园老梅冻不开，饥乌啄落青苔上。\n破屋寒多午未餐，拥衾对雪空长叹。\n去岁雨频禾烂死，冰消委巷生波澜。\n吴楚井乾江底坼，北方翻作蛟龙宅。\n豪客椎牛昼杀人，弯弓笑入长安陌。\n长安画阁压氍毹，猎罢高悬金仆姑。\n歌声入夜华镫暖，不信人间有饿夫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4651,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"张覆舆自西山来","author":"申涵光","text":"何事须城郭，人间复见君。\n全家依涧草，短褐带山云。\n薄俗居难定，忘形鹿可群。\n四方多战伐，羡尔未全闻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4652,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"遣兴 其一","author":"申涵光","text":"岂敢名高尚，山园已定居。\n数椽风雨外，万事死生余。\n避地寻丹诀，传家有《素书》。\n天寒松酒熟，日日溷樵渔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4653,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"遣兴 其二","author":"申涵光","text":"小筑容高卧，荒林失曙更。\n人从多难老，心向远天清。\n野屋悬鱼笋，霜滩落雁声。\n一年看又暮，新月几回明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4654,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒张尚书湛虚先生","author":"申涵光","text":"结茅飞鸟上，秋色满悬壶。\n白发增幽事，黄冠屈壮图。\n琴樽山月好，风雨老臣孤。\n莫讶披云至，浮名此地无。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4655,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"不忘 其一","author":"申涵光","text":"江上前朝酒，同人意不忘。\n衣冠临水榭，烟雨下金阊。\n入箸龙须软，登盘佛手香。\n归来南北异，生死各茫茫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4656,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"不忘 其二","author":"申涵光","text":"旅食多归梦，庭帏正北悬。\n重来轻齿发，千里入烽烟。\n书画江城市，弓刀塞草天。\n至今明月夜，无地拜啼鹃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4657,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨后林虑道中早行","author":"申涵光","text":"晓渡青泥坂，秋花乱马蹄。\n不知山寺近，渐觉远村低。\n万事惊鼙鼓，孤云入杖藜。\n苏门高卧处，为访碧峰西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4658,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宝鸡巷访吴见末比部即订九日之游","author":"申涵光","text":"卜宅依寒水，朝回只闭关。\n见君当落叶，此地有空山。\n雨歇秋仍暖，官贫老更闲。\n登高何处好，屦杖许追攀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4659,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登岱","author":"申涵光","text":"殿阁盘空界，镫香出绛霄。\n到门诸念绝，终夜百灵朝。\n石闼驯双虎，天风落皂雕。\n玉浆如可待，未觉沃州遥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4660,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西郊","author":"申涵光","text":"风吹荻叶满渔梁，野菊乘秋亦暂香。\n边郡早寒沙漠漠，水村多雨月苍苍。\n常持白羽寻云壑，敢羡华裾负草堂。\n何事暗蛩催鬓发，一年今已过重阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4661,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄宋吏部玉叔","author":"申涵光","text":"风雨常怀宋玉悲，岳云海树远离离。\n春生太液鱼龙啸，月满空陂雁鹜饥。\n先辈风流成李贺，同时歌咏附王维。\n定知脱略能倾倒，竹仗从为汗漫期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4662,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"无才","author":"申涵光","text":"窗下平田细路分，樵歌几处远犹闻。\n涛声夜落漳南树，山色晴分冀北云。\n曲岸人家依紫蓼，衡门客到煮青芹。\n无才合就穷途老，车马休惊白鹭群。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4663,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己丑生日","author":"申涵光","text":"行歌何处问幽栖，滏口孤亭郡堞西。\n渐觉悲欢从俗懒，漫将怀抱向人低。\n惊猿莫讶频移树，羸马犹能惜障泥。\n烽火近连冬未雪，每逢喧乐倍凄凄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4664,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"灵岩寺 其一","author":"申涵光","text":"天畔灵岩已昔闻，石桥花雨正纷纭。\n枫林乱掩浮图出，黛色遥从泰岳分。\n古殿横阑迷赤箭，秋泉带叶下青云。\n伊蒲会罢僧厨饭，倚杖看碑到日曛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4665,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"灵岩寺 其二","author":"申涵光","text":"云外笙簧拥碧霞，游人争看铁袈裟。\n虚岩白映山南日，老菊黄垂洞口花。\n溪水过桥喧鹤鹳，松根出石走龙蛇。\n飞梯万仞栖真地，可许寻源问鹿车。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4666,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答人","author":"申涵光","text":"日日秋阴命笋舆，故人天上落双鱼。\n荷花未老村醪熟，为道无闲作报书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4667,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"黄花谷","author":"申涵光","text":"竹杖寻源入上方，满山槲叶晚苍苍。\n乱碑零落游人少，一道飞泉下夕阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4668,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"溪上","author":"申涵光","text":"微霜昨夜下庭槐，水畔闲登万里台。\n两岸芦花飞白雪，午桥烟里一舟来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4669,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"燕京即事 其一","author":"申涵光","text":"塞云宫月远苍苍，萧后妆楼亦渺茫。\n四百余年池水换，依然风动芰荷香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4670,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"燕京即事 其二","author":"申涵光","text":"汉畤秦原罢晓钟，黄绡牙轴市尘封。\n画图往往多隆准，传是先朝旧御容。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4671,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"泛舟明湖","author":"申涵光","text":"女墙倒影下寒空，树杪飞桥渡远虹。\n历下人家十万户，秋来俱在雁声中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4672,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄李十三郎君","author":"张盖","text":"主人十三龄，天驹见龙脊。\n绝尘潇洒姿，能解留人客。\n予时至平干，复著游山屐。\n足茧涩登途，盗贼况充斥。\n踟蹰数里间，落日藏光赤。\n投宿上君堂，张灯照昏夕。\n蹇驴足刍茭，老病须燔炙。\n奴仆亦殷勤，自来扫床席。\n酌酒须玉瓶，倾光泛琥珀。\n感情欲痛饮，所恨胸肠窄。\n恭闻尔先人，遗汝登朝舄。\n汝兄善草圣，海内称名硕。\n汝才驾徐陵，准拟文章伯。\n予有两男儿，鸡鹜空毛翮。\n大儿倍汝年，弧矢未能射。\n小儿少汝年，祇备樵苏役。\n何以汝聪明，日夜亲图籍。\n老夫若汝年，走马垂杨陌。\n有时丛台下，醉舞挥金戟。\n中岁好弹琴，素琴横白石。\n旁植一枝松，今已高千尺。\n忽忽鬓发苍，自顾无良策。\n何处可容身，避地来山泽。\n结交无老少，遭时有顺逆。\n长啸望停云，题诗谢畴昔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4673,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"广羊山方殷伯岩不遇","author":"张盖","text":"尔从南方来，衣裘带江色。\n舍舟入故山，倦游聊憩息。\n我住君山南，君住吾山北。\n相隔十里云，欲见何由得，今晨动幽兴，独访漆泉侧。\n危桥上古寺，径转长松直。\n山僧五六人，亭午会法食。\n清斋到鄙夫，益我筋生力。\n老翁气忽壮，果腹取岩崱。\n初瞻意嵂崒，绝顶无难陟。\n扪萝才跻攀，寸步成匍匐。\n天畔石房古，仰望不可极。\n山叟何时还，再欲窥堂阈。\n三步一回头，皓鹤烟中翼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4674,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"昭明台呈襄阳诸公","author":"张盖","text":"楚郡蟠江腹，危楼逼太清。\n窗通高鸟过，槛俯白云生。\n帝子留文字，群公列治平。\n我来戎马际，登眺独含情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4675,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"留郝元直","author":"张盖","text":"自得黄沟信，常怀见汝期。\n只愁相会少，可道故乡迟。\n陪酒邻家夜，弹棋日落时。\n明朝各有事，分手即天涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4676,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋兴","author":"张盖","text":"兔岭邯云外，羊祠楚甸中。\n乡心堪夜雨，旅病苦秋风。\n湖橘垂丹实，江蕉卷绿丛。\n幽姿不可见，倚树独书空。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4677,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"殷伯岩招同白涵三郝元直苑西柳霍亮雅申凫盟刘资深集饮","author":"张盖","text":"屡宿陶潜宅，今来得数公。\n竹斜镫影外，人醉雨声中。\n老惜欢娱异，交缘出处同。\n病躯先就榻，应恕鹿皮翁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4678,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渡沁水宿穆陵关","author":"张盖","text":"斜阳明晚渡，倦马踏寒云。\n岸动移舟影，沙喧落雁群。\n山城秋似画，水市暮多闻。\n老客归心急，无眠到夜分。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4679,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"客归","author":"张盖","text":"水阔荆门路，君从此地归。\n云山开暮雨，舟楫带斜晖。\n计日程将近，从人道已非。\n且寻嵇阮去，竹里闭柴扉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4680,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山居张湛虚司马枉驾山人以予壶餐不备为展待因要遂臣先辈 其一","author":"张盖","text":"康乐游山信，先期报敝庐。\n宿春供野饭，晨扫净荒厨。\n径仄猿相引，云深虎伴居。\n果来寻牧子，真气拂林墟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4681,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山居张湛虚司马枉驾山人以予壶餐不备为展待因要遂臣先辈 其二","author":"张盖","text":"山翁亦有意，招引过邻家。\n系马惊林鸟，催厨馔野麚。\n一镫先好月，杂果间疏花。\n瓮有蒲萄酒，村醪不用赊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4682,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山居张湛虚司马枉驾山人以予壶餐不备为展待因要遂臣先辈 其三","author":"张盖","text":"月出楼阴静，天晴露气微。\n蛩声断复响，萤火起还飞。\n隐吏遗朱绂，山光上白衣。\n清谈忘夜永，相对两无违。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4683,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆旧","author":"张盖","text":"城晚砧声急，庭深树影寒。\n孤檠怜自照，明月忆同看。\n旅日凭诗过，乡愁仗酒宽。\n秋天饶梦寐，夜夜渡江干。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4684,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山居秋夜同友人坐月","author":"张盖","text":"客宿楞伽宫，秋深白露中。\n云归千涧满，月出万山空。\n兵甲何时息，琴尊此夜同。\n张华有宝剑，醉拔舞雌雄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4685,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"溪村即事","author":"张盖","text":"幂䍥树中行，潺湲石濑清。\n野花开间色，秋鸟落寒声。\n家住愚公谷，书传老伏生。\n邻人自来往，日见不知名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4686,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"偶成似湛虚先生","author":"张盖","text":"久客成亲故，居人识渐多。\n自知林下路，数向水边过。\n夕露凋蒲柳，秋风老芰荷。\n病中曾见问，诗思近如何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4687,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"喜郭楚玉至","author":"张盖","text":"五载一相见，乾坤几变更。\n乱离惊汝在，衰病惜人情。\n齿发前朝貌，丹青后世名。\n谈诗悲喜外，好雨向檐倾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4688,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登海光楼","author":"张盖","text":"城远随山势，楼高见海光。\n池霜冬夏白，岸树古今苍。\n让国怀虞帝，征苗忆禹王。\n浮云看变态，倚槛独傍徨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4689,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闻张扶隆将归","author":"张盖","text":"词客南游未遣知，遥传消息倍多思。\n江涛赴壑吹沙急，海日含山出雾迟。\n桂楫尚留桃叶渡，松醪已负菊花期。\n陶潜近有归来兴，待汝从容一问之。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4690,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄题申处士凫盟箕亭","author":"张盖","text":"负郭田畴水气中，隐君亭榭白云通。\n青连粳稻千村雨，香泛芙蓉万里风。\n夏簟凉侵高士卧，新诗清绝老夫同。\n欲持百尺琅玕竹，向尔渔矶作钓翁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4691,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答申凫盟约游隆虑","author":"张盖","text":"西南林壑动高兴，爱有山村间水村。\n山入太行盘鸟道，水分瀑布下云根。\n得同郑子耕岩谷，何异庞公隐鹿门。\n仗汝远寻先卜筑，愿将白发共朝昏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4692,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"七里峡","author":"张盖","text":"朝下县壶顶，暮行寒峡中。\n壶形犹迤逦，峡势已巃嵷。\n岂假随刊力，当知造化功。\n水声流太古，石色耸遥空。\n重碧涵砂砾，深红缀藓丛。\n暗崖回北雪，高岫阻南风。\n山鬼宜幽僻，神鱼老混濛。\n依稀闻唳鹤，仿佛见奔狨。\n闻道瞿塘好，常思滟滪雄。\n干戈妨历览，舟楫废疲癃。\n此谷聊堪隐，前山幸可通。\n杖藜五指外，借骑广阳东。\n附葛缘明月，披烟坐晚枫。\n回瞻长啸处，何异在崆峒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4693,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"漫作","author":"张盖","text":"玉盘渍墨可二斗，高丽茧纸冰蚕纹。\n醉来挥洒兴不尽，欲上青天写白云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4694,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"孟亭","author":"张盖","text":"不见当年孟浩然，鱼梁渡口问渔船。\n岩扉松径空搔首，沙岸如霜月满天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4695,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"省心吟 其一","author":"赵湛","text":"玉函藏宝镜，光莹若冰晶。\n三时不拂拭，便见云烟生。\n抚躬问方寸，百岁空营营。\n五色乱我目，六欲牵我情。\n苟不自琢磨，安得常清明。\n芳矩接前哲，黾勉崇令名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4696,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"省心吟 其二","author":"赵湛","text":"博陆倾汉册，伟绩方伊周。\n不学慕厚势，帷闼生愆尤。\n岂有厮养儿，束发皆封侯。\n台光一夕沈，楼观成榛丘。\n今古理不远，慎以道自谋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4697,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"省心吟 其三","author":"赵湛","text":"上蔡有鄙夫，困穷羡仓鼠。\n挟策干祖龙，感激去乡里。\n抵掌取卿相，乃欲易天子。\n所谋一不臧，凋零自兹始。\n东门悔初念，机发不可止。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":4698,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]