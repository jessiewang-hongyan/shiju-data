[{"title":"酒泉子","author":"纳兰性德","text":"谢却荼蘼，一片月明如水。\n篆香消，尤未睡，早鸦啼。\n嫩寒无赖罗衣薄，休傍阑干角。\n最愁人，灯欲落，雁还飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1001,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花","author":"纳兰性德","text":"烛花摇影，冷透疏衾刚欲醒。\n待不思量，不许孤眠不断肠。\n茫茫碧落，天上人间情一诺。\n银汉难通，稳耐风波愿始从。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1002,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花","author":"纳兰性德","text":"相逢不语，一朵芙蓉著秋雨。\n小晕红潮，斜溜鬟心只凤翘。\n待将低唤，直为凝情恐人见。\n欲诉幽怀，转过回栏叩玉钗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1003,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花  新月","author":"纳兰性德","text":"晚妆欲罢，更把纤眉临镜画。\n准待分明，和雨和烟两不胜。\n莫教星替，守取团圆终必遂。\n此夜红楼，天上人间一样愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1004,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南  咏弦月","author":"纳兰性德","text":"初八月，半镜上青霄。\n斜倚画阑娇不语，暗移梅影过红桥，裙带北风飘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1005,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梦江南","author":"纳兰性德","text":"昏鸦尽，小立恨因谁？\n急雪乍翻香阁絮，轻风吹到胆瓶梅，心字已成灰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1006,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梦江南","author":"纳兰性德","text":"新来好，唱得虎头词。\n一片冷香惟有梦，十分清瘦更无诗。\n标格早梅知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1007,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐","author":"纳兰性德","text":"将愁不去，秋色行难住。\n六曲屏山深院宇，日日风风雨雨。\n雨晴篱菊初香，人言此日重阳。\n回首凉云暮叶，黄昏无限思量。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1008,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐","author":"纳兰性德","text":"凄凄切切，惨淡黄花节。\n梦里砧声浑未歇，那更乱蛩悲咽。\n尘生燕子空楼，抛残弦索床头。\n一样晓风残月，而今触绪添愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1009,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐","author":"纳兰性德","text":"风鬟雨鬓。\n偏是来无准。\n倦倚玉阑看月晕。\n容易语低香近。\n软风吹透窗纱。\n心期便隔天涯。\n从此伤春伤别，黄昏只对梨花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1010,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐","author":"纳兰性德","text":"烟轻雨小，望里青难了。\n一缕断虹垂树杪，又是乱山残照。\n凭高目断征途，暮云千里平芜。\n日夜河流东下，锦书应托双鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1011,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐  忆梁汾","author":"纳兰性德","text":"才听夜雨，便觉秋如许。\n绕砌蛩螀人不语，有梦转愁无据。\n乱山千叠横江，忆君游倦何方。\n知否小窗红烛。\n照人此夜凄凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1012,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐  发汉儿村题壁","author":"纳兰性德","text":"参横月落，客绪从谁托。\n望里家山云漠漠，似有红楼一角。\n不如意事年年，消磨绝塞风烟。\n输与五陵公子，此时梦绕花前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1013,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐","author":"纳兰性德","text":"泠泠彻夜，谁是知音者，如梦前朝何处也，一曲边愁难写。\n极天关塞云中，人随雁落西风。\n唤取红巾翠袖，莫教泪洒英雄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1014,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渔父","author":"纳兰性德","text":"收却纶竿落照红，秋风宁为剪芙蓉。\n人淡淡，水濛濛，吹入芦花短笛中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1015,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"眼儿媚  咏梅","author":"纳兰性德","text":"莫把琼花比澹妆，谁似白霓裳。\n别样清幽，自然标格，莫近东墙。\n冰肌玉骨天分付，兼付与凄凉。\n可怜遥夜，冷烟和月，疏影横窗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1016,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮","author":"纳兰性德","text":"为春憔悴留春住，那禁半霎催归雨。\n深巷卖樱桃，雨余红更娇。\n黄昏清泪阁，忍便花飘泊。\n消得一声莺，东风三月情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1017,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮","author":"纳兰性德","text":"问君何事轻离别，一年能几团圆月。\n杨柳乍如丝，故园春尽时。\n春归归不得，两桨松花隔。\n旧事逐寒潮，啼鹃恨未消。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1018,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮","author":"纳兰性德","text":"黄云紫塞三千里，女墙西畔啼乌起。\n落日万山寒，萧萧猎马还。\n笳声听不得，入夜空城黑。\n秋梦不归家，残灯落碎花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1019,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮","author":"纳兰性德","text":"隔花才歇帘纤雨，一声弹指浑无语。\n梁燕自只归，长条脉脉垂。\n小屏山色远，妆薄铅华浅。\n独自立瑶阶，透寒金缕鞋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1020,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮","author":"纳兰性德","text":"春云吹散湘帘雨，絮黏蝴蝶飞还住。\n人在玉楼中，楼高四面风。\n柳烟丝一把，暝色笼鸳瓦。\n休近小阑干，夕阳无限山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1021,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮","author":"纳兰性德","text":"朔朔风吹散三更雪，倩魂犹恋桃花月。\n梦好莫催醒，由他好处行。\n无端听画角，枕畔红冰薄。\n塞马一声嘶，残星拂大旗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1022,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮","author":"纳兰性德","text":"催花未歇花奴鼓，酒醒已见残红舞。\n不忍覆余觞，临风泪数行。\n粉香看欲别，空胜当时月。\n月也异当时，凄清照鬓丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1023,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮","author":"纳兰性德","text":"晶帘一片伤心白，云鬟香雾成遥隔。\n无语问添衣，桐阴月已西。\n西风鸣络纬，不许愁人睡。\n只是去年秋，如何泪欲流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1024,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其一","author":"严绳孙","text":"镜里花枝折未成。\n水中莲子动分明。\n慵红闷翠转盈盈。\n多恨崔徽浑似画，倦游司马苦关情。\n几时怀抱属卿卿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1025,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮","author":"纳兰性德","text":"雾窗寒对遥天暮，暮天遥对寒窗雾。\n花落正啼鸦，鸦啼正落花。\n袖罗垂影瘦，瘦影垂罗袖。\n风剪一丝红，红丝一剪风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1026,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮","author":"纳兰性德","text":"晓寒瘦著西南月，丁丁漏箭余香咽。\n春已十分宜，东风无是非。\n蜀魂羞顾影，玉照斜红冷。\n谁唱《后庭花》，新年忆旧家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1027,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮","author":"纳兰性德","text":"榛荆满眼山城路，征鸿不为愁人住。\n何处是长安，湿云吹雨寒。\n丝丝心欲碎，应是悲秋泪。\n泪向客中多，归时又奈何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1028,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮","author":"纳兰性德","text":"萧萧几叶风兼雨，离人偏识长更苦。\n欹枕数秋天，蟾蜍下早弦。\n夜寒惊被薄，泪与灯花落。\n无处不伤心，轻尘在玉琴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1029,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒金门","author":"纳兰性德","text":"风丝袅，水浸碧天清晓。\n一镜湿云清未了，雨晴春草草。\n梦里轻螺谁扫。\n帘外落花红小。\n独睡起来情悄悄，寄愁何处好？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1030,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"朝中措","author":"纳兰性德","text":"蜀弦秦柱不关情，尽日掩云屏。\n已惜轻翎退粉，更嫌弱絮为萍。\n东风多事，余寒吹散，烘暖微酲。\n看尽一帘红雨，为谁亲系花铃？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1031,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"琵琶仙  中秋","author":"纳兰性德","text":"碧海年年，试问取、冰轮为谁圆缺？\n吹到一片秋香，清辉了如雪。\n愁中看好天良夜，知道尽成悲咽。\n只影而今，那堪重对，旧时明月。\n花径里、戏捉迷藏，曾惹下萧萧井梧叶。\n记否轻纨小扇，又几番凉热。\n只落得、填膺百感，总茫茫、不关离别。\n一任紫玉无情，夜寒吹裂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1032,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"落花时","author":"纳兰性德","text":"夕阳谁唤下楼梯，一握香荑。\n回头忍笑阶前立，总无语，也依依。\n笺书直恁无凭据，休说相思。\n劝伊好向红窗醉，须莫及，落花时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1033,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"摊破浣溪沙","author":"纳兰性德","text":"风絮飘残已化萍，泥莲刚倩藕丝萦；珍重别拈香一瓣，记前生。\n人到情多情转薄，而今真个悔多情；又到断肠回首处，泪偷零。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1034,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"满庭芳","author":"纳兰性德","text":"堠雪翻鸦，河冰跃马，惊风吹度龙堆。\n阴燐夜泣，此景总堪悲。\n待向中宵起舞，无人处、那有村鸡。\n只应是，金笳暗拍，一样泪沾衣。\n须知今古事，棋枰胜负，翻覆如斯。\n叹纷纷蛮触，回首成非。\n剩得几行青史，斜阳下、断碣残碑。\n年华共，混同江水，流去几时回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1035,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虞美人","author":"纳兰性德","text":"银床淅沥青梧老，屧粉秋蛩扫。\n采香行处蹙连钱，拾得翠翘何恨不能言。\n回廊一寸相思地，落月成孤倚。\n背灯和月就花阴，已是十年踪迹十年心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1036,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虞美人","author":"纳兰性德","text":"春情只到梨花薄，片片催零落。\n夕阳何事近黄昏，不道人间犹有未招魂。\n银笺别梦当时句，密绾同心苣。\n为伊判作梦中人，长向画图清夜唤真真。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1037,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虞美人","author":"纳兰性德","text":"曲阑深处重相见，匀泪偎人颤。\n凄凉别后两应同，最是不胜清怨月明中。\n半生已分孤眠过，山枕檀痕涴。\n忆来何事最销魂，第一折技花样画罗裙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1038,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虞美人","author":"纳兰性德","text":"残灯风灭炉烟冷，相伴唯孤影。\n判叫狼藉醉清樽，为问世间醒眼是何人。\n难逢易散花间酒，饮罢空搔首。\n闲愁总付醉来眠，只恐醒时依旧到樽前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1039,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虞美人  秋夕信步","author":"纳兰性德","text":"愁痕满地无人省，露湿琅玕影。\n闲阶小立倍荒凉。\n还剩旧时月色在潇湘。\n薄情转是多情累，曲曲柔肠碎。\n红笺向壁字模糊，忆共灯前呵手为伊书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1040,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花","author":"纳兰性德","text":"又到绿杨曾折处，不语垂鞭，踏遍清秋路。\n衰草连天无意绪，雁声远向萧关去。\n不恨天涯行役苦，只恨西风，吹梦成今古。\n明日客程还几许，沾衣况是新寒雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1041,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花","author":"纳兰性德","text":"眼底风光留不住，和暖和香，又上雕鞍去。\n欲倩烟丝遮别路，垂杨那是相思树。\n惆怅玉颜成间阻，何事东风，不作繁华主。\n断带依然留乞句，斑骓一系无寻处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1042,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花","author":"纳兰性德","text":"辛苦最怜天上月，一夕如环，夕夕都成玦。\n若似月轮终皎洁，不辞冰雪为卿热。\n无那尘缘容易绝，燕子依然，软踏帘钩说。\n唱罢秋坟愁未歇，春丛认取双栖蝶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1043,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花","author":"纳兰性德","text":"今古河山无定距。\n画角声中，牧马频来去。\n满目荒凉谁可语？\n西风吹老丹枫树。\n从前幽怨应无数。\n铁马金戈，青冢黄昏路。\n一往情深深几许？\n深山夕照深秋雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1044,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"踏莎行","author":"纳兰性德","text":"倚柳题笺，当花侧帽，赏心应比驱驰好。\n错教双鬓受东风，看吹绿影成丝早。\n金殿寒鸦，玉阶春草，就中冷暖和谁道？\n小楼明月镇长闲，人生何事缁尘老。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1045,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天","author":"纳兰性德","text":"别绪如丝睡不成，那堪孤枕梦边城。\n因听紫塞三更雨，却忆红楼半夜灯。\n书郑重，恨分明，天将愁味酿多情。\n起来呵手对题处，偏到鸳鸯两字冰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1046,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天","author":"纳兰性德","text":"背立盈盈故作羞，手挪梅蕊打肩头。\n欲将离恨寻郎说，待得郎归恨却休。\n云澹澹，水悠悠，一声横笛锁空楼。\n何时共泛春溪月，断岸垂杨一叶舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1047,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鬓云松令","author":"纳兰性德","text":"枕函香，花径漏。\n依约相逢，絮语黄昏后。\n时节薄寒人病酒，铲地梨花，彻夜东风瘦。\n掩银屏，垂翠袖。\n何处吹箫，脉脉情微逗。\n肠断月明红豆蔻，月似当时，人似当时否？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1048,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟古","author":"纳兰性德","text":"美人临残月，无言若有思。\n含颦但斜睇，吁嗟怜者谁。\n予本多情人，寸心聊自持。\n浩歌幽兰曲，援琴终不怡。\n私恨托远梦，初日照帘帏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1049,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟古 其八","author":"纳兰性德","text":"朔风吹古柳，时序忽代续。\n庭草萎已尽，顾视白日速。\n吾本落拓人，无为自拘束。\n倜傥寄天地，樊笼非所欲。\n嗟哉华亭鹤，荣名反以辱。\n有客叹二毛，操觚序金谷。\n酒空人尽去，聚散伤局促。\n揽衣起长歌，明月皎如玉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1050,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟古","author":"纳兰性德","text":"高云媚春日，坐觉鱼鸟亲。\n可怜暮春候，病中别故人。\n莺啼花乱落，风吹成锦茵。\n君去一何速，到家垂柳新。\n芙蓉湖上月，照君垂长纶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1051,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"班婕妤怨歌","author":"纳兰性德","text":"团团望舒月，皓皓冰蚕绢。\n欲却炎天暑，比月裁成扇。\n望舒圆易缺，金风换炎节。\n风凉秋气寒，匣扇复谁看。\n扇弃何足道，感妾伤怀抱。\n对月泪如丝，君恩异旧时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1052,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"高楼望月","author":"纳兰性德","text":"戚戚复戚戚，高楼月如雪。\n二八正婵娟，月明翡翠钿。\n由来工织锦，生小倚朱弦。\n朱弦岂解愁，素手似云浮。\n一声落天上，闻者皆泪流。\n别郎已经年，望郎出楼前。\n青天如海水，碧月如珠圆。\n月圆以复缺，不见长安客。\n古道白于霜，沙灭行人迹。\n月出光在天，月高光在地。\n何当同心人，两两不相弃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1053,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"金缕曲","author":"纳兰性德","text":"德也狂生耳，偶然间、淄尘京国，乌衣门第。\n有酒惟浇赵州土，谁会成生此意。\n不信道、遂成知己。\n青眼高歌俱未老，向尊前、拭尽英雄泪。\n君不见，月如水。\n共君此夜须沉醉。\n且由他、娥眉谣诼，古今同忌。\n身世悠悠何足问，冷笑置之而已。\n寻思起、从头翻悔。\n一日心期千劫在，后身缘、恐结他生里。\n然诺重，君须记。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1054,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄生草","author":"邱圆","text":"漫揾英雄泪，相离处士家。\n谢慈悲，剃度在莲台下。\n没缘法，转眼分离乍。\n赤条条，来去无牵挂。\n那里讨，烟蓑雨笠卷单行？\n一任俺芒鞋破钵随缘化！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1055,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"黄龙寺","author":"闵麟嗣","text":"万木乱参天，孤峰对铁船。\n客因看画至，寺以伏龙传。\n宝笈悲前代，薄团坐小年。\n松花吹不定，半落讲堂边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1056,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寒食题宋先生草堂","author":"陆宇燝","text":"天妒梅花更妒人，风风雨雨不知春。\n杜鹃啼处孤灯梦，寒食樽前一病身。\n易理愁中才得力，交情乱后始能真。\n天涯相对忘形迹，拥被微吟乐贱贫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1057,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"代琵琶妇解嘲","author":"陆宇燝","text":"不见春风花，花落随地飞？\n不见南山鸟，年年择新枝？\n抱此区区意，红颜须及时。\n“非不慕古人，礼法难疗饥。\n”但博旦夕欢，宁顾谁为谁？\n还取故夫意，宛转事新知。\n新故转盼间，生死酒一卮。\n可怜东邻妇，白首柏舟诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1058,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过史相国坟","author":"陆廷抡","text":"广陵城北一孤坟，云是先朝旧督臣。\n冢中断碑题汉字，路旁荒草拜行人。\n沧波呜咽三江戍，碧血凄凉万古春。\n一自前军星坠后，至今无复见纶巾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1059,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏史","author":"陆次云","text":"儒冠儒服委丘墟，文采风流化土苴。\n尚有陆生坑不尽，留他马上说《诗》《书》。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1060,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋夜","author":"陈文述","text":"梧桐叶底见银河，露气当窗冷碧罗。\n四壁虫声两行雁，不知何处得秋多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1061,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夏日杂诗","author":"陈文述","text":"水窗低傍画栏开，枕簟萧疏玉漏催。\n一夜雨声凉到梦，万荷叶上送秋来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1062,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日信笔","author":"陈长生","text":"软红无数欲成泥，庭草催春绿渐齐。\n窗外忽传鹦鹉语，风筝吹落画檐西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1063,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"扬州城楼","author":"陈沆","text":"涛声寒泊一城孤，万瓦霜中听雁呼。\n曾是绿杨千树好，只今明月一分无。\n穹商日夜荒歌舞，乐岁东南困转输。\n道谊既经功利重，临风还忆董江都。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1064,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谢易实甫赠庐山泉","author":"陈宝箴","text":"廿年不践匡庐径，读画因君系梦思。\n饷我新泉分瀑布，瀹将春茗助敲诗。\n清流合让支筇客，辟地须寻面壁师。\n安得草堂容设榻，一瓯睡足日高时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1065,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夏日书帐","author":"陈淑兰","text":"帘幕风微日正长，庭前一片芰荷香。\n人传郎在梧桐树，妾愿将身化凤凰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1066,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]