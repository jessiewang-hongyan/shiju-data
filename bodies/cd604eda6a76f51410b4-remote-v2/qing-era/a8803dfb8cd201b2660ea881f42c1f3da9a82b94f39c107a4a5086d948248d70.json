8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆涪水端阳四首 其三","author":"张鹏翮","text":"天空海阔思何穷，人在黄粱一梦中。\n回首青山人不老，莼鲈依旧满江东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16077,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆涪水端阳四首 其四","author":"张鹏翮","text":"千年文献德阳城，瑞应旗山喜气生。\n一片书台顶上月，照人心地独分明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16078,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"今年海棠未开","author":"张鹏翮","text":"去岁看花三月里，一春开遍满枝红。\n今来不见东风暖，寂寞空庭夕照中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16079,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"天署新槐","author":"张鹏翮","text":"墀下新槐手自栽，绿阴丛里见花开。\n暗香浮动无人识，留取清光点露苔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16080,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"早梅","author":"张鹏翮","text":"大地春回发早梅，一枝先向百花开。\n清香自足留天壤，岂为和羹结子来？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16081,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"署中藤花二首 其一","author":"张鹏翮","text":"铁骨芳心老岁华，东皇雨露润无涯。\n恍疑天上紫云色，散作阶前双树花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16082,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"署中藤花二首 其二","author":"张鹏翮","text":"阅历年华久更香，天生劲质倾群芳。\n羞将浓艳随时好，爱伴清高在玉堂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16083,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"七夕二首 其一","author":"张鹏翮","text":"鹊桥仙佩夜珊珊，月挂高楼烛影残。\n牛女渡时风浪静，无情银汉水空寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16084,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"七夕二首 其二","author":"张鹏翮","text":"乞巧楼前奏管弦，离思别怨动秋天。\n世间多少伤心事，莫笑牛郎会隔年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16085,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春柳","author":"张鹏翮","text":"丽日和风宿雾消，清池玉露滴花朝。\n新传淑气催黄鸟，杨柳青青荫御桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16086,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"桃花寺二首 其一","author":"张鹏翮","text":"木落山空境更幽，寺门斜日照林丘。\n洪钧一气青阳转，又傍桃花作胜游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16087,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"桃花寺二首 其二","author":"张鹏翮","text":"雪鬓庞眉迈古稀，御寒犹是去年衣。\n敝车羸马行人识，笑问高年胡不归？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16088,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"楝树","author":"张鹏翮","text":"见说蛟龙畏楝花，移栽何不向江涯？\n更闻彩凤来求实，人羡朝阳第一家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16089,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"万寿菊","author":"张鹏翮","text":"风雨崇朝滑路斜，老人愁坐在天涯。\n夜来却有还家梦，喜见庭前万寿花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16090,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"古北口遇雨","author":"张鹏翮","text":"斜风细雨日相催，黍穗荍花眼暂开。\n万里秋声天外意，断桥流水石边苔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16091,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尧亭古柏","author":"张鹏翮","text":"孤干亭亭塞上稀，高枝密叶影相依。\n霜风众木凋零尽，依旧长青荫夕晖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16092,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"石匣","author":"张鹏翮","text":"石匣城边月正明，一年两度数归程。\n昔人藏剑知何处？\n碧落秋空露气清。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16093,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"仙鹤","author":"张鹏翮","text":"认人眼睫有灵毛，独立瑶池意自高。\n万里摩天珠树宿，一声清唳彻云霄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16094,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"柳","author":"张鹏翮","text":"含烟带雨映前峰，袅袅游丝落照中。\n刘尹当年厅事树，每因清德想高风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16095,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"庚子七月二十五日出塞偶作","author":"张鹏翮","text":"白花绿叶未经寒，风动微香零露团。\n点缀清秋新气象，天然一幅画图看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16096,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"万里骏四首 其一","author":"张鹏翮","text":"昔年出使俄罗斯，万里驰驱一骏奇。\n步影追风堪足比，功成应不数青狮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16097,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"万里骏四首 其二","author":"张鹏翮","text":"逸足超群骥子齐，草枯井竭向风嘶。\n归时行尽流沙路，猛气骁腾在碧蹄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16098,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"万里骏四首 其三","author":"张鹏翮","text":"奏凯新从紫塞来，关门惊喜得龙媒。\n谁知韩干丹青妙？\n画入麒麟生面开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16099,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"万里骏四首 其四","author":"张鹏翮","text":"大地风轻入四蹄，超腾曾向玉关嘶。\n可怜淮上催花雨，一夜飞英踏作泥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16100,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"庚子九日二首 其一","author":"张鹏翮","text":"彻夜西风声势狂，晓来人说是重阳。\n如何气候迟时令？\n菊满篱边不放香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16101,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"庚子九日二首 其二","author":"张鹏翮","text":"秋风杨柳叶梳黄，冷露无心菊正芳。\n造化一般荣悴异，谁将消息问穹苍？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16102,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"戴村坝","author":"张鹏翮","text":"汶流不许归东海，引入南湖运口粮。\n千里帆樯明月夜，薰风吹送枣花香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16103,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]