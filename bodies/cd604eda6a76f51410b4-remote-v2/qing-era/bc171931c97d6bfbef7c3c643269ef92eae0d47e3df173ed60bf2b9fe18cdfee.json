[{"title":"天台万年藤杖歌","author":"与宏","text":"昔年曾作天台游，一瓢一笠挂杖头。\n玉霄峰耸万螺髻，石梁瀑卷双龙湫。\n翠微几折入古寺，禅堂钟磬清且幽。\n苍藤夭矫挂石壁，疏花红缀空岩秋。\n老僧知我惯行脚，呼童截取千岁虬。\n携归早夜每拂拭，肌理细腻骨节遒。\n瘿圆瘤古色苍润，桃枝筇竹非其俦。\n平生梦寐在丘壑，要蹑五岳凌九州。\n随身自有瓶钵在，住山任尔猿鹤愁。\n杖兮杖兮肯相助，出门从此吾无忧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29275,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"书怀","author":"与宏","text":"皎皎月正白，悠悠云自行。\n以彼一点滓，掩此千里明。\n人心如镜台，洁比秋水清。\n一念不肯息，万虑遂交萦。\n老以静而治，庄因达乃成。\n非儒亦非释，无为了平生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29276,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登焦山绝顶和借庵韵","author":"与宏","text":"扪葛攀萝上碧霄，百盘千级路迢迢。\n披襟我又登蓬岛，放眼人多看海潮。\n东汉此山才有姓，西江无水不来朝。\n褰衣直扣双峰阁，认得华阳旧鹤巢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29277,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"同程荫堂登海云楼分韵即送之邗上","author":"清恒","text":"日落小楼红，高吟雅兴同。\n凉生潮影外，秋在叶声中。\n箔卷双峰雨，窗开四面风。\n明朝分手去，惆怅海门东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29278,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过宝莲庵","author":"清恒","text":"小阿兰若瓮城边，门径依稀似辋川。\n书画一房云外室，江山半壁水中天。\n生来竹叶皆成字，修到梅花即是仙。\n曾与维摩谈不二，夜深明月挂松巅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29279,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和赵瓯北观察见赠 其一","author":"清恒","text":"树里禅关昼不扃，隔江无数晚烟青。\n西风有意留仙侣，著屐同寻《瘗鹤铭》。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29280,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和赵瓯北观察见赠 其二","author":"清恒","text":"楼台无地接江涛，客喜诗锋疾孟劳。\n吟到夜深秋月冷，一天星斗雁行高。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29281,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和赵瓯北观察见赠 其三","author":"清恒","text":"诗名海内达遵三，拟筑莲花聚一龛。\n若肯停车容问字，那能不借与茅庵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29282,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"访宋虞允文三宿处","author":"清恒","text":"天下势若常山蛇，赵家已失中原脊。\n北人大举向南侵，一旦雄兵临采石。\n岂知江上有儒生，提师一战功便成。\n南人已胜北人北，三军只听波涛声。\n西风猎猎吹玄纛，归傍卢龙山下宿。\n至今石上见题名，雨洗莓苔痕自绿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29283,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"妙诠将南归即寄海昌诸旧好","author":"清恒","text":"沈沈起视夜何其，风动琅珰月乍移。\n兜率有天应待我，庐陵无米更思谁。\n从来衲子轻漂泊，自古诗人重别离。\n汝到故乡凭致语，诸公且莫问归期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29284,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"瓜洲遇洪稚存即次见赠韵","author":"清恒","text":"东风吹我过萸湾，邂逅先生水石间。\n不系身同江上艇，无家梦绕越中山。\n经翻贝叶人将去，衣拂梅花客乍还。\n准拟故乡栅笋后，归来共逐野鸥閒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29285,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"朱研庵司马过访山中","author":"清恒","text":"十里松阴径转微，探奇客至款荆扉。\n泉声入户晴犹急，峦翠如烟湿不飞。\n妙语欲争山影秀，钝根恐落箭锋机。\n相期再过披云室，宝镜光寒薜荔衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29286,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送月堂之云门扫古岩塔","author":"清恒","text":"风斜雨细一帆轻，又向山阴道上行。\n若到香炉峰背后，伤心莫听杜鹃声。\n群山秀簇古云门，佛阁镫微影渐昏。\n知否故人头尽白，不谈往事已销魂。\n玉笥山空宝镜寒，无人击竹笥栏干。\n惟遗挂锡松千尺，化作蛟龙月上蟠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29287,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过丁若亭可以栖书斋兼赠卯君秀才","author":"清恒","text":"箬水可栖迟，秋高月满帷。\n谈经服子慎，好客郑当时。\n我亦曾相过，心常系所思。\n若论羲与献，那得外人知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29288,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题丁仑峰洗鹤图","author":"清恒","text":"一双皎皎瑶台鹤，欲飞不飞如有约。\n老去长存万里心，碧天冲破秋寥廓。\n每一招之鹤自来，鹤虽不语心颜开。\n呼儿洗之复更洗，本来洁白无纤埃。\n一鹤先飞松顶立，若与主人高下揖。\n世上纷纷那得知，主人亦是瑶台客。\n还留一鹤临清泉，若有所思衣飘然。\n记向瑶台曾洗过，已经一别三千年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29289,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重登摄山寻练塘墓","author":"清恒","text":"江左诗僧有墓田，最高峰后许庄前。\n名称殁世知何用，祭到无入亦可怜。\n六代云山遗旧迹，一生风月付寒泉。\n多情还是南徐客，岁岁春风泣杜鹃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29290,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重过萸湾即用刘松岚观察吊练塘韵","author":"清恒","text":"茱萸湾锁薜萝烟，渡口无人晚泊船。\n风撼塔铃空自语，门开江月为谁圆。\n经翻贝叶窗恒闭，诗刻旃檀阁已传。\n我比孝威情更重，几回来觅旧花砖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29291,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答韬庵击竹山房见怀","author":"清恒","text":"雨洗花阶露洗苔，正当新月照经台。\n山高岂定留三宿，地好何妨住百回。\n胜友世间非苟得，奇峰天际忽飞来。\n知君竹里门常闭，不是寻诗总不开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29292,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清江晓发","author":"清恒","text":"古井烟飞玉带环，西风送我过淮关。\n江南此去无他事，先看青青万垒山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29293,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次韬庵见赠韵","author":"清恒","text":"年来事总学模糊，却喜登临兴未孤。\n脚底但愁千嶂少，胸中翻怪一尘无。\n难消结习冰藏壑，顿扫疑团雪见炉。\n心迹惟君知我久，三年前写《退居图》。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29294,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"明妃冢","author":"湛汎","text":"空恃朱颜惜饼金，独留遗恨到于今。\n琵琶一曲和番泪，芳草千年望汉心。\n自是美人多命薄，非关天子不恩深。\n孤坟三尺丰碑在，环佩春风未易寻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29295,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菊花","author":"湛汎","text":"萧疏几本是天留，洁白纯黄托地幽。\n种者自知甘苦味，赏心不作绮罗秋。\n一枝敢在霜前折，九日应从篱下收。\n我有孀慈今鹤发，年年益寿向伊谋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29296,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题方可村先生梦游出塞图","author":"湛汎","text":"短榻蕉窗绿影肥，凉云一枕梦依稀。\n班生未老庄生老，匹马沙场胡蝶飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29297,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舟中同秦西岩","author":"湛汎","text":"千里荆湘共此行，布帆风饱向南征。\n怜君亦是初为客，未惯江湖一片情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29298,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山居","author":"际醒","text":"为爱林泉趣颇饶，市廛隔绝路迢遥。\n千重竹树居幽僻，一个蒲团坐寂寥。\n昼静窗中山色澹，日高帘外鸟声娇。\n定回满目皆生意，乘兴扶筇过小桥。\n疏拙难堪应世情，馀生赢得寄柴荆。\n且无活计卷唇，尽有家私折脚铛。\n亭畔开池宜浣月，篱边种菊喜餐英。\n敢云野况齐安养，差胜人间閒利名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29299,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日过王冈龄山斋次韵赋答 其一","author":"明印","text":"良辰赴幽期，名园散清步。\n黄菊未辞秋，霜鸿正横曙。\n逍遥玩泉石，参差数药树。\n主人出卷轴，精力所凝注。\n六法韵俱流，五字神或助。\n把玩愧不如，爱极翻成妒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29300,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日过王冈龄山斋次韵赋答 其二","author":"明印","text":"陟级已梯空，登兹江畔楼。\n取适那在高，聊足恣冥搜。\n虚檐仰晴穹，疏槛临平畴。\n西山送遥青，风前上帘钩。\n趣以淡为赏，情以忘转投。\n寒城送暝钟，一笑还淹留。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29301,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登香岩一览楼","author":"明印","text":"底处堪舒野士眸，松陵南寺倚层楼。\n檐虚遥挹金庭翠，树老平分笠泽秋。\n千里烟瓢从踯躅，十年萍迹漫淹留。\n若无友道谈空语，顽石何能更点头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29302,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夏日山居","author":"慈海","text":"淡泊何干世，无求孰侮予。\n窗明蜂作鼓，花静蝶成闾。\n地僻能逃客，天长好读书。\n性灵随处养，绝妙是山居。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29303,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"张毅夫弟西川硕学近闻落发五台口占以坚其志","author":"慈海","text":"业火心薪昼夜煎，无常自古不知怜。\n汉家得鹿今安在，陆氏如龙亦枉然。\n碧眼胡僧九载坐，白衣大士一经传。\n洛阳春满花成锦，终对斜晖泣杜鹃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29304,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"韵珂大弟近不言诗","author":"慈海","text":"曾从禅内悟清吟，此道难言古至今。\n季札已悬枯树剑，昭文不蓄有弦琴。\n皎然未必非前习，白也原来证后心。\n极地弥天方寸里，云何门外觅知音。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29305,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"邹颖峰先生秋夜过谈","author":"慈海","text":"萧瑟秋声不耐闻，故人望外喜同群。\n明星落地一湾水，怪石投天几块云。\n拊掌新诗工笑客，填杯凉月可邀君。\n相期更刮来朝目，应有清奇欣赏文。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29306,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"翠微山龙王堂","author":"慈海","text":"小亭池畔碧琅玕，坐纳春阴昼不寒。\n得失风闻皆入幻，是非云卷怎相干。\n波平浅水鱼游乐，声静高枝鸟梦安。\n领受个中真快活，进山容易出山难。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29307,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游龙门寺同友人作","author":"世惺","text":"迢递龙门寺，萦回路几盘。\n虬松夹幽径，修竹隐飞湍。\n偈与閒官说，诗呈古佛看。\n地炉煨芋火，虚室不知寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29308,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春寒","author":"本白","text":"病里年华草木知，孤云来去更无期。\n等閒清兴难消却，忍冻开窗看竹枝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29309,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日怀岘山","author":"悟成","text":"柴扉终日掩，高卧翠微閒。\n春树雨中寺，夕阳江上山。\n身閒肩早息，吟苦鬓全斑。\n欲买扁舟去，携筇一叩关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29310,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"石城望雪","author":"定志","text":"回看处处白云生，下有孤篷打桨行。\n前路何人长啸去，鸭头江水冻无声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29311,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怀罗浮山人","author":"默可","text":"我昔五岭南，曾见岩居客。\n松风四壁寒，萝烟满衣碧。\n厨中所有者，清泉与白石。\n自云四十年，山外无履迹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29312,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游如意古寺","author":"与明","text":"曾访眉公室，春云满故山。\n野田千百顷，流水两三湾。\n坐爱潜鱼戏，行看独鹤还。\n祇今戒坛树，高出翠微间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29313,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"钵池庵留赠玉公","author":"清月","text":"支公习静处，幽寂绝尘氛。\n野鸟啼深树，山花澹白云。\n相违将半月，重见便论文。\n好待秋生竹，携琴再访君。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29314,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晚步","author":"清月","text":"晚步入空翠，微茫望不分。\n水声流合涧，山色断归云。\n尘外昏钟彻，林间清籁闻。\n移时星月上，万木荫纷纷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29315,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送赵南英","author":"达航","text":"大蓝山上雪初晴，小幕溪头月正明。\n恰是溪山两佳处，梅花一路送君行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29316,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"喜汤秀谷自鄱阳归","author":"性恬","text":"知交共喜故人回，都为寒暄慰问来。\n小阁梧桐依旧绿，野塘菡萏未全开。\n平章花鸟增诗稿，消受云山费酒杯。\n明月悄然生树杪，一天风露净无埃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29317,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋杪怀郭明经子涵","author":"啸颠","text":"怀人望溪云，云飞渡溪去。\n云去无还期，之子渺何处。\n寒花谢遥汀，暝烟敛高树。\n念往悲时序，感物伤情素。\n岂无新交者，新交不逮故。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29318,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怀夏补山琴师徐州","author":"宏度","text":"风急雁声遥，怀君酒一瓢。\n吟情临皓月，离思压秋潮。\n大泽书来远，丹台叶乱飘。\n云帆三百里，夜夜梦难消。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29319,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"省斋上人雨阻中峰","author":"逸云","text":"锡驻近云霄，中峰一径遥。\n林花经雨润，岩雪到春消。\n风竹频萧瑟，烟峦自暮朝。\n不知溪畔路，新涨夜平桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29320,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"不得公执稚威信","author":"悟帚","text":"计竭惟行耳，艰难我早忧。\n百金支万里，尽室在孤舟。\n老幼应无恙，风波亦可愁。\n荆蛮炎瘴地，相忆数回头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29321,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"焦公祠题壁","author":"昌立","text":"人间原有少微星，高卧蜗庐户不扃。\n清梦觉来江月白，红尘隔断海天青。\n鼎留鹤院山尤重，碑夺龙宫字亦腥。\n试问烧丹井何处，春深我欲斸松苓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29322,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渡白鹅潭步黄蓉石韵","author":"相润","text":"牂牁一万里，海国势偏长。\n日落天无色，晚来山更苍。\n百蛮馀壮气，九月下严霜。\n击楫乘风去，长歌自笑狂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29323,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送张蕉衫返鸠江","author":"实雄","text":"破寺君归更寂寥，新诗记取雪中蕉。\n但将肝胆酬孤鹤，不惮风霜敝一貂。\n帆影逼天横落日，钟声催日下寒潮。\n独留泪洒梅花句，传遍扬州廿四桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29324,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送王贺堂之海州","author":"行吉","text":"别离时候熟黄梅，岑寂山楼永昼开。\n莫谓海滨孤讲席，须知草莽有奇才。\n春残风雨田横岛，日落波涛韩信台。\n想见悲歌兼吊古，扁舟维处独徘徊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29325,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过海粟庵访学文和尚","author":"行荦","text":"扁舟乍过小桥东，得得精庐问远公。\n春院鹤归松桧老，晓堂龙出水云空。\n沾衣细湿花朝雨，渡海虚传飓母风。\n准拟狂澜深处去，行装检点日初红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29326,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登金山作","author":"行荦","text":"海门曙色射东溟，晴日和烟染翠屏。\n山势平分双练白，天光倒浴一螺青。\n塔含舍利云俱活，窟近蛟龙水亦腥。\n笑指老僧乘舸惯，怒涛深处汲中泠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29327,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"中丞阮公书七代诗僧额为赠拈此奉谢","author":"禅一","text":"七代传衣翰墨缘，新标斋榜有高贤。\n文如北斗珍韩子，集少红楼愧广宣。\n新涨拍堤初过雨，妙香浮槛乍开莲。\n万峰深处光华甚，不让题梁玉局仙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29328,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"筑墙围雷峰塔诗以纪之","author":"禅一","text":"五季纷纷首朱梁，乘时割据钱镠王。\n此塔肇建自忠懿，依稀记得妃子黄。\n去今八百有馀载，中遭劫火烧颓唐。\n剧中靓妆妖蛇出，众目争看窈窕娘。\n法胜有如鬼子母，战退揭谛走金刚。\n金山高擎一盏罩，不能跋扈恣飞扬。\n此妖亦是有情种，轻身失志为高阳。\n黄乃对白是寄托，以伪作真骇众盲。\n乡愚不喻窃砖去，将去磨刀切柔桑。\n妄言此砖镇妖孽，蛇蝎永不来蚕房。\n从此剔出有万万，古塔势欲倒高冈。\n十景之中少一景，于是山僧为主张。\n若云鼎新工浩大，且围八尺黄泥墙。\n斯举傍人皆赞叹，保护塔身计最良。\n我闻兴修也生喜，作诗记美助宣扬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29329,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜雨不寐","author":"禅一","text":"秋晚空山冷闭门，湿云时复起岩根。\n大都诗思因禅悟，一半钟声带雨昏。\n短榻横眠聊自适，孤镫枯坐向谁论。\n毕生消受清閒福，惭愧难酬出世恩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29330,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋雨写怀","author":"禅一","text":"云山望里半模糊，夜气迷濛尚有湖。\n事去徒劳千日亿，老来为惜一身孤。\n竟无旧雨能分供，剩有荒田畏索租。\n看取淡妆浓抹态，米家难自泼成图。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29331,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"芳草词","author":"啸溪","text":"漠漠平芜一望齐，画楼东去粉墙西。\n落红三月飞如雨，软衬香尘送马蹄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29332,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋草","author":"啸溪","text":"王孙归后客心惊，牧马长嘶望去程。\n丘陇泪枯朋友恨，池塘梦老弟兄情。\n荒烟冷露痕犹在，野店斜阳路已平。\n剩有堤边衰柳在，暮蝉相对乱蛩鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29333,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画","author":"际祥","text":"路绕西湖西复西，夕阳红树板桥低。\n秋风记得春归日，花落柴门雨满溪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29334,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夏日放生河亭与王太守梦楼纳凉","author":"达澄","text":"竹密烟深一径虚，桐阴如幄复阶除。\n庭前时有窥帘鸟，池内应无避钓鱼。\n南浦潮随明月上，西林钟带夕阳疏。\n人閒莫漫愁烦热，好共临流此卜居。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29335,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"翠屏洲为王柳村先生作","author":"悟霈","text":"汀洲一带横沧江，势如翡翠屏开张。\n三山怀抱涵青苍，吞吐岷流万丈长。\n海潮呼吸通扶桑，百川争汇河汪洋。\n谁能障此波澜狂，天教镇锁江中央。\n白沙晻霭青筼筜，烟雨晦暝疑潇湘。\n江南佳丽多水乡，此中直疑辋川庄。\n风光宛转蘅杜香，篱门水次深夕阳。\n此中有客咏沧浪，何必当年华子冈。\n右丞才思超三唐，褰裳千古相颉颃。\n苏公米公灵皇皇，好与揖让凌茫苍。\n手持玉笛骖鸾凰，我来钓月歌鸣榔，蒹葭露白秋风凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29336,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"新雁","author":"悟霈","text":"征鸿天外到，云路独悠悠。\n露白江南夜，霜清蓟北秋。\n平沙琴弄月，古塞笛横楼。\n谋食何须切，菰蒲正满洲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29337,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]