[{"title":"南柯子十三首 其三","author":"王时翔","text":"镂管拈沉绿，春裙剪淡黄。\n描花隐约寄柔肠。\n要绣红莲双朵、盖鸳鸯。\n倦起凭雕槛，闲行转曲廊。\n樱桃欲谢惜年芳。\n独立无人深院、看斜阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43376,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南柯子十三首 其四","author":"王时翔","text":"蕙帐人无赖，银屏恨不禁。\n晓来新梦恁关心。\n仿佛玉壶亲自、与君斟。\n插髻花枝妥，钩帘草色深。\n别时直望到如今。\n归路粉云香雨、做春阴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43377,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南柯子十三首 其五","author":"王时翔","text":"碎绮裁春色，明霞晕玉容。\n小楼人醉倚东风。\n记得软杨丝里，一枝红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43378,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南柯子十三首 其六","author":"王时翔","text":"锦轴闲常卷，朱弦静不张。\n西风帘下自然凉。\n况是怯秋人起、独眠床。\n语别双归燕，啼愁几暮螀。\n小庭梧竹间青黄。\n一带淡烟新月、接残阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43379,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南柯子十三首 其七","author":"王时翔","text":"碧柳春檐雨，青梧夜阁风。\n个人香梦恰朦胧。\n又是和衣熟睡、小屏中。\n薄鬓倾浓绿，清灯晕小红。\n玉炉熏被半床空。\n一缕水沉烟袅、绣芙蓉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43380,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南柯子十三首 其八","author":"王时翔","text":"丽影收青镜，香云绾碧螺。\n盈盈一笑整裙拖。\n今日薄绵初脱、换单罗。\n扑蝶怀轻扇，听莺步浅莎。\n柳阴垂处懒重过。\n怕见画桥流水、落红多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43381,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南柯子十三首 其九","author":"王时翔","text":"东汉开禅教，西方购梵书。\n神驹贝叶现明珠。\n照遍千江祗是、一丸孤。\n法字传来久，尘心到此无。\n清凉台上景萧疏。\n半世烧沙才得、饱香厨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43382,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南柯子十三首 其十","author":"王时翔","text":"圆毂如肠转，香膏与泪深。\n已凉天气客初禁。\n凭枕怯眠人静、暗沉吟。\n澹月微窥幌，疏风半入林。\n渡江乡梦一帆阴。\n才到江南惊断、楚天砧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43383,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南柯子十三首 其十一","author":"王时翔","text":"策策商飙动，凄凄古意深。\n金梁桥上月难禁。\n不唱宪王乐府、试狂吟。\n薄笑依银杏，清歌忆锦林。\n红牙拍断桂堂阴。\n只有荒鸡遥接、暮村砧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43384,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南柯子十三首 其十二","author":"王时翔","text":"握藕香沾雪，垂珠泪滴红。\n分襟地是桂堂东。\n一径斜斜铸就、寸心中。\n梦易莺儿唤，书难燕子通。\n晴丝轻袅断魂风。\n小醉清愁无日、不朦眬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43385,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南柯子十三首 其十三","author":"王时翔","text":"客里新凉浅，闲中旧恨深。\n杜兰香远思难禁。\n小扇蚕书偷展、自微吟。\n锦瑟尘悬壁，琼箫响散林。\n石榴裙曝柳边阴。\n怎忍寒衣独上、少君砧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43386,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虞美人五首 其一","author":"王时翔","text":"赌书笑覆龙团椀。\n更握青湘管。\n斜阳半射水晶帘。\n分得玉台新体、试同拈。\n晚庭风弄萧萧竹。\n闲步携纤玉。\n双肩戌削亸鬟鸦。\n阶下没鞋红叶、拗秋花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43387,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虞美人五首 其二","author":"王时翔","text":"雨多五月轻绵在。\n独客愁如海。\n清吟未稳凭危阑。\n一点归心飞入、暮云寒。\n绿阴不隔藏娇院。\n隐隐疏帘卷。\n绕肠已是怕思家。\n更见玉人头上、袅榴花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43388,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虞美人五首 其三","author":"王时翔","text":"白蘋风急冲烟去。\n只怕惊鸥鹭。\n丝丝细雨湿轻帆。\n卧看乱山泼翠、水挼蓝。\n爱他缥缈峰尤好。\n一带浓云绕。\n欲寻野客结清游。\n身作橙黄橘绿、画中秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43389,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虞美人五首 其四","author":"王时翔","text":"渔帆漾漾西风小。\n渐泊沙边岛。\n将鱼换酒不论钱。\n生怕芦花深处、水云寒。\n怜余未逐鸱夷艇。\n心折闲中景。\n秋山红树夕阳村。\n好种湖田十亩、老柴门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43390,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虞美人五首 其五","author":"王时翔","text":"柳阴阴下丝丝雨。\n白傅堤边路。\n翠峰云锁映春流。\n应似玉人眉黛、镜中愁。\n遥思分手南园地。\n满径杨花坠。\n数声横笛画船中。\n唤起一襟离恨、散东风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43391,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"踏莎行三首 其一","author":"王时翔","text":"嫩嫩烟丝，轻轻风絮。\n绛旗斜飐秋千处。\n花枝照得画楼空，薄情燕子和人去。\n冷落阑干，凄清院宇。\n夕阳西厂明残雨。\n一双红豆寄相思，远帆点点春江路。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43392,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"踏莎行三首 其二","author":"王时翔","text":"杨叶楼中，枣花帘下。\n盈盈有个人如画。\n玲珑心地解怜人，嫣然一笑千愁卸。\n兰桨催舟，金鞭拂马。\n迢迢换了天涯也。\n杜郎禅榻鬓丝风，今生甘守凄凉夜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43393,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"踏莎行三首 其三","author":"王时翔","text":"玉镜台前，绛罗窗下。\n修蛾彩笔曾亲画。\n下阶双笑握纤纤，步摇替整琼钗卸。\n地认蓝桥，琴疑司马。\n狂言触拨生嗔也。\n惊心端坐诵三缄，焚香乞忏无人夜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43394,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"更漏子二首 其一","author":"王时翔","text":"碎萍青，圆荇碧。\n舒翅蜻蜓斜立。\n梧叶雨，藕花风。\n水窗三面通。\n是何人，当槛倚。\n随意淡妆偏丽。\n衫白伫，鬓乌丝。\n红榴短短枝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43395,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"更漏子二首 其二","author":"王时翔","text":"紫鸾双，青凤两。\n缥缈碧城云上。\n兰气近，王光分。\n同披绿柳匀。\n蓬莱路。\n三千阻。\n留下清风一树。\n天似水，月如霜。\n人间奈夜长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43396,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"一络索二首 其一","author":"王时翔","text":"青粉墙头榆荚。\n更交梧叶。\n湖山石后小房栊，见背影、珠裙褶。\n知是怎生纤颊。\n但闻轻屧。\n茸茸芳草暮烟深，乱扑着、双黄蝶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43397,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"一络索二首 其二","author":"王时翔","text":"双扇题诗愁别意。\n碧筠新制。\n几年风雨泣湘江，染尽了、斑斑泪。\n误纳佳人袖里。\n怕添憔悴。\n索还未许但须藏，慎莫展、相思字。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43398,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花六首 其一","author":"王时翔","text":"潇洒园亭湖石好。\n客未来时，只有茶烟袅。\n山桂落残风自扫。\n黄衣蝶抱秋棠老。\n检校生涯闲不了。\n暝色无端，飞上疏林表。\n一曲清溪人独钓。\n打头红叶栖鸦闹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43399,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花六首 其二","author":"王时翔","text":"拈酒熏香都不耐。\n钩起湘帘，晚色初堪爱。\n微月小阑黄一派。\n白棠花下沉吟拜。\n拆去秋千幽径改。\n斑竹围屏，隔著深深态。\n手揽画裙双凤带。\n衣寒蓦把东风怪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43400,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花六首 其三","author":"王时翔","text":"凉透西风秋欲暮。\n记起当年，清照消魂句。\n人病不窥帘外路。\n黄花自瘦无人处。\n苦茗一瓯香一炷。\n叠遍银笺，懒把秋词做。\n昵语已遭归燕絮。\n嫩晴天更阑珊雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43401,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花六首 其四","author":"王时翔","text":"晓揭风帘犹带倦。\n独下瑶阶，绣履轻裙展。\n朵朵香兰钗上颤。\n苔衣露滑纤腰软。\n花事阑珊飞絮满。\n庭角残枝，幽鸟啼红怨。\n多病药炉烟未断。\n槛边莫信春寒浅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43402,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花六首 其五","author":"王时翔","text":"碧树萧疏斜日漏。\n雪藕调冰，已过炎蒸候。\n几许西风吹薄袖。\n画阑人似秋光瘦。\n彩线慵拈谁耐绣。\n玉骨支离，莫使新凉透。\n露下虫声添僝僽。\n月明珍重分携后。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43403,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花六首 其六","author":"王时翔","text":"古驿秋槐疏叶陨。\n倦客无憀，脉脉斜晖尽。\n几曲阑干凭不稳。\n乱鸦啼处西风紧。\n卖酒桥边青旆引。\n一朵芙蓉，秀靥红生晕。\n说与家乡山隐隐。\n何烦笑向垆头问。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43404,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"天仙子","author":"王时翔","text":"江上萧骚枫几树。\n一群冷雁飞芦渚。\n澹黄云影落篷窗，疏疏雨。\n斜斜去。\n又被晚风轻约住。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43405,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"一斛珠","author":"王时翔","text":"夜来闻雨。\n罗帏越觉孤眠苦。\n玉人微病深深处。\n一点红灯，燕子寒相语。\n可惜春光留不住。\n知他薄倖今何许。\n卜花晓起添愁绪。\n才卷珠帘，却又飞香絮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43406,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"临江仙七首 其一","author":"王时翔","text":"柳径低迷画阁，萍池倒映红阑。\n石榴一朵照香鬟。\n眼波生细缬，眉月锁轻弯。\n展卷乍临乌儿，拂尘旋试麋丸。\n戏搴蕉叶代鱼笺。\n玉纤书格美，雪腕钏光寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43407,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"临江仙七首 其二","author":"王时翔","text":"不断柔情春水似，迢迢那计西东。\n午眠初起玉钗松。\n画屏离思远，罗袖泪痕浓。\n云水黏天楼外路，卷帘试认狂踪。\n一双燕子夕阳中。\n莫衔残鬓影，吹向落花风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43408,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"临江仙七首 其三","author":"王时翔","text":"一段旅情无处着，闲眠中酒平分。\n燕归窗黑又黄昏。\n灯微屏背影，泪暗枕留痕。\n梦入怨花伤柳地，分明有个人人。\n压帘香气倚轻裙。\n小园风雨后，扶病问残春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43409,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"临江仙七首 其四","author":"王时翔","text":"灯火阑珊清漏急，夜深著体轻寒。\n个人背立画屏间。\n旧红衫袖薄，新绣缕鞋鲜。\n一寸横波千丈恨，魂消似削双肩。\n便蒙怜惜也徒然。\n桂堂东畔路，弹泪巳三年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43410,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"临江仙七首 其五","author":"王时翔","text":"紫楝飘香新竹粉，小楼树色愔愔。\n一帘丝雨好闲吟。\n龙唇砚近，素袖墨痕侵。\n鲜美银鲥江上到，簇盘卢橘如金。\n藏钩得胜称侬心。\n玉壶清酒，自起为君斟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43411,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"临江仙七首 其六","author":"王时翔","text":"桂楫银帆移画艇，春塘小泊清槐。\n锦堤花印缕金鞋。\n香含豆蔻，未上九雏钗。\n年少儿郎空玉雪，争窥未惬幽怀。\n就中倦客久风埃。\n酒情诗思，犹惹眼波回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43412,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"临江仙七首 其七","author":"王时翔","text":"红板桥头浓绿布，人家一带高槐。\n鹧斑帘底逗弓鞋。\n彩符欹侧，斜映水晶钗。\n佳丽靓妆疑见画，枉牵孤客情怀。\n笋舆迎去剩香埃。\n碧云芳草，谁念首千回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43413,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渔家傲","author":"王时翔","text":"销夏湾头荷十丈。\n娃儿十五清歌响。\n素足红裙风荡漾。\n能弄桨。\n身轻舟小迎流上。\n花里逢人羞欲障。\n怜郎隔叶还偷望。\n笑指鸳鸯飞两两。\n君自想。\n东边莲子西边浪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43414,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"钗头凤","author":"王时翔","text":"琼窗口。\n雕阑右。\n轻烟半羃梨花瘦。\n燕儿尾。\n莺儿嘴。\n都来勾引，酒情春思。\n醉。\n醉。\n醉。\n银灯后。\n蛾眉皱。\n知他一样孤眠否。\n分离意。\n相思味。\n裙量绣带，袖弹红泪。\n寄。\n寄。\n寄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43415,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"风入松","author":"王时翔","text":"一峰晴翠暖烟熏。\n游冶趁残春。\n玉人笑语朱阑畔，依稀似、放诞文君。\n短簿祠前相见，武当山后愁分。\n锦鸳双履蹑轻云。\n出没艳绡裙。\n分明众里重回首，像多处、依恋斜曛。\n应恨兰舟催发，整钗一照波纹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43416,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"苏幕遮","author":"王时翔","text":"不须留，侬去罢。\n才转身时，又作愁人话。\n肠断春风杨柳下。\n落日看看，早月儿来也。\n两眉低，双袖把。\n直恁情多，怎忍轻抛舍。\n一笑重回离恨卸。\n并坐红窗，且再过今夜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43417,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"芭蕉雨","author":"王时翔","text":"墙脚水仙初发。\n玉人抛绣线、潜来折。\n纤指半擎清绝。\n最爱红袖垂垂，香肩无骨。\n疏棂眼尾乍接。\n怎赤了双颊。\n不是敢轻狂、相唐突。\n须记取小年时，那夜阑角微风，帘衣新月。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43418,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感皇恩二首 其一","author":"王时翔","text":"寒色乱昏鸦，小窗人醉。\n袖捧金钗拥衣睡。\n几条凉月，闲共碧笼烟细。\n醒时眠不得、还重起。\n旧梦已遥，后欢难继。\n一点真诚感郎意。\n倚屏无语，残灯落灺红碎。\n只将鸳锦带、揩双泪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43419,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感皇恩二首 其二","author":"王时翔","text":"小阁俛澄湾，水窗低挂。\n团扇纱裙坐良夜。\n荷风消暑，叶叶清香无价。\n月明星影淡、银河泻。\n玉体易凉，冰肌生粟。\n的皪真珠露流乍。\n兰房深靓，背壁烛花将谢。\n被轻珍簟滑、金钩下。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43420,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"青玉案","author":"王时翔","text":"暗飘玉笛高楼暮。\n更谁管，人羁旅。\n早睡何曾央梦去。\n残灯挂壁，破窗鸣纸，一枕相思雨。\n起来欲写相思句。\n恼断愁肠心不聚。\n须待与伊当面诉。\n安排茶椀，画屏深处，镇日低低语。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43421,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"行香子二首 其一","author":"王时翔","text":"锦额烟丝。\n银蒜香丝。\n画檐深、花影来迟。\n湘痕带泪，映个人儿。\n便蝶儿黏，蜂儿打，燕儿窥。\n翠鬓光微。\n红履尖微。\n总因他、露出相思。\n怯春小倚，柳絮慵吹。\n任月中开，风中押，雨中垂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43422,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"行香子二首 其二","author":"王时翔","text":"玉刻香锼。\n山翠云稠。\n论兰闺、定占千秋。\n花阶蹑影，绣箔回头。\n但聆娇音，窥笑靥，接清眸。\n莫莫休休。\n有愿难酬。\n未须谐、鲽枕鹣裯。\n疏帘小槛，月澹风柔。\n待近随肩，轻把袂，细言愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43423,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"水调歌头","author":"王时翔","text":"春院百花竞，桦烛夜筵烧。\n海棠一树凝艳，的的向人娇。\n揭起深沉帘幕，拥出吴姬十六，吹裂紫琼箫。\n酒醒在何处，别恨压轻舠。\n四天青，孤月白，晓星高。\n宿鸦惊舞烟际，露滴绿杨条。\n独自此情谁展，回首玉楼天远，清泪洒江潮。\n翻羡红绫束，常抱美人腰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43424,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"齐天乐二首 其一","author":"王时翔","text":"阴阴木叶遮深院，珠帘半钩梅雨。\n润入琴丝，滴开蕉卷，金兽水沉低炷。\n两枝琼树。\n趁小阁幽闲，凭肩私语。\n细瀹清泉，紫瓯浮雪漾花乳。\n为欢谁道昼永，湿云看渐散，斜照微吐。\n淡月黄昏，低阑薄袖，倚皱一痕金缕。\n画谯闻鼓。\n更窗下分灯，竞标新句。\n绣被浓熏，雾笼双彩羽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43425,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"齐天乐二首 其二","author":"王时翔","text":"桃花扇底歌声在，凄清竟甘如许。\n嫩菊分秧，新篁倚粉，料理闲中心绪。\n萍踪偶遇。\n只杯酒留连，春前一度。\n便托深情，紫骝不系闭门处。\n须知非忍薄幸，两人同一恨，相对难吐。\n章句酸才，琵琶小技，没杀奇男侠女。\n此离最苦。\n更莫望佳期，与谐鸳侣。\n咽泪归来，渡头风送雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43426,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"真珠帘","author":"王时翔","text":"清阴疏柳听鹂院。\n醉懵腾、细品龙团盈椀。\n绵样玉葱，递与雪花轻溅。\n低问余酲醒也未，且稳坐、漫吟诗卷。\n犹倦。\n有玉簟横铺，翠屏斜展。\n林杪已挂残阳，风帘半揭，棋经对按。\n一抹暮烟生，早月圆如面。\n携手相将清话久，把绿粉、阑干凭暖。\n重看。\n爱茉莉香鬟，晚妆新换。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43427,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"倦寻芳","author":"王时翔","text":"画梁乳燕，飞下银屏，偷说春去。\n晓起余寒，犹卷一帘残絮。\n倚桐阴，簪杏子，簇盘樱笋初尝处。\n早思量，整轻纨月扇，单绡烟缕。\n被东皇、裁花剪柳，惹得人儿，消瘦如许。\n暗祝薰风，吹展两蛾愁聚。\n嫩绿新遮芳草陌，落红净洗香林雨。\n又生憎，书厌厌、绣针慵度。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43428,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"暗香","author":"王时翔","text":"晚窗孤守。\n正满城风雨，重阳时候。\n多谢双螯八跪，能消客中酒。\n玉脍金齑漫数，曾得似、无肠公否。\n算风味潇洒，冠他水族也非谬。\n回首。\n暗眉皱。\n记小阁钩帘，劝人醉后。\n微揎罗袖。\n转过曲廊下阶走。\n月里自寻菊盎，只道是、拗花同嗅。\n悄地个、摘嫩叶，与侬搓手。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43429,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆王孙","author":"王时翔","text":"灞陵攀柳恨绵绵。\n会意骅骝不肯前。\n叠叠青山杏杳天。\n向谁边。\n旧梦空余满抱烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43430,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海棠春二首 其一","author":"王时翔","text":"东风骀荡杨花舞。\n怎忽地、把春催去。\n人意已阑珊，又是萧萧雨。\n玉卮不耐斟香醑。\n自起拨、水沉烟缕。\n和影诉年华，梁燕闻私语。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43431,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海棠春二首 其二","author":"王时翔","text":"软风吹落残红片。\n却误怪、穿花双燕。\n背立把青枝，淡影斜阳院。\n窗蕉叶叶当心卷。\n欲寄恨、题诗又懒。\n暮色渐昏黄，隔箔闻微叹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43432,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"眼儿媚","author":"王时翔","text":"碧藕飞丝寸肠柔。\n谁与割闲愁。\n开帘待燕，倚阑迎月，忆在红楼。\n玉骢嘶出欢丛去，萧瑟冷如秋。\n云光黯黯，雨花片片，风叶飕飕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43433,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天","author":"王时翔","text":"锦字书成梦不成。\n半怜消瘦半牵情。\n依依病柳凉逾弱，怯怯秋棠晚更清。\n烟淡薄，月分明。\n珠帘微度彩云轻。\n焚香绣被孤眠夜，肠断花关下锁声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43434,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"荷叶杯八首 其一","author":"王时翔","text":"花浦。\n翠烟香雨。\n吴女。\n听吹箫。\n细蛾攒绿倚轻桨。\n闲想。\n背红桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43435,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"荷叶杯八首 其二","author":"王时翔","text":"拍水。\n彩鸳惊起。\n花里。\n见欢时。\n两舟相并弄溪碧。\n风逆。\n得归迟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43436,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]