[{"title":"春日离咏寄夫子 其五","author":"冯畹","text":"茹水西为风物新，韶华著意饯离人。\n离人今在千山外，寄语河边柽柳春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28510,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晚泊峡中","author":"张仲肃","text":"泊舟临绝壁，倚柁一开颜。\n山势趋三楚，江声走百蛮。\n冻云生峡口，倦鸟没林间。\n孤艇寒风逼，巉岩未可攀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28511,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄怀云珠五姊","author":"汪清","text":"薰风别后又飞霜，一度思量一断肠。\n只道相逢秋月白，那堪空对菊花黄。\n纵多儿女添新爱，何似茱萸插故乡。\n况复高堂思念甚，倚门终日盼归航。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28512,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄怀许玉清","author":"汪清","text":"尺素裁成倩雁驰，聊将心事报君知。\n家无长物愁难遣，病为痴情悔已迟。\n偶借新诗消俗虑，自怜瘦骨异当时。\n半闺珍重休惆怅，好寄平安慰所思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28513,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄和汪湘卿","author":"许月芝","text":"犹记临行曾语我，教将近况报君知。\n药垆为伴还如昔，书卷相亲未觉迟。\n已分微躯终似此，那堪病骨更难支。\n深情独有闺房秀，驿使梅花屡寄诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28514,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日偶成","author":"俞庆曾","text":"紫燕衔泥报早晴，黄莺出谷啭新声。\n春风乍拂长堤柳，吹到花前分外轻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28515,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"待月","author":"俞庆曾","text":"碧汉迢迢夜气清，疏星几点映窗明。\n冰轮欲上还留恋，閒倚雕阑听雁声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28516,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过旧居有感","author":"俞庆曾","text":"儿时记得此曾楼，故迹重游路已迷。\n拾翠阶前烟漠漠，寻芳亭畔草萋萋。\n空庭燕去巢犹在，小院人归鸟自啼。\n追忆十年浑似梦，不堪再问旧芸闺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28517,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山居","author":"俞庆曾","text":"把卷松阴镇日眠，浑忘三月落花天。\n子规夜半啼明月，细雨清晨润绿田。\n涤砚偶寻山曲涧，烹茶每乞寺僧泉。\n心如止水原耽静，不问人间扰扰缘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28518,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清明日湖上书 其一","author":"俞庆曾","text":"稚柳秾桃我亦怜，新茶采得煮新泉。\n扁舟更爱春莼美，寒食侬家不禁烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28519,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清明日湖上书 其二","author":"俞庆曾","text":"踏青偶过小桥西，绕树雏莺恰恰啼。\n独坐斜阳看归鸟，不随画舫到前溪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28520,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山行","author":"俞庆曾","text":"閒步横桥载酒行，垂杨叶底暗闻莺。\n溪边小艇人争渡，树杪斜阳鹊噪晴。\n迎客野猿频献果，催耕山鸟不知名。\n晚钟何处随风落，我亦思归踏落英。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28521,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"即事","author":"俞庆曾","text":"乍寒乍暖熟梅天，自检新茶煮惠泉。\n棋为息机甘袖手，琴因识趣不张弦。\n閒阶雨过蜗涎积，深院风来芜影联。\n静坐芸窗无所事，唐诗细诵绿阴前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28522,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"閒坐和阶青弟","author":"俞庆曾","text":"烛剪红纱幕，茶烹碧玉瓯。\n柳疏寒月漏，雨霁湿云留。\n遥忆三春日，曾同一叶舟。\n年华惊逝水，忽忽已新秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28523,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岁暮书怀和弟韵","author":"俞庆曾","text":"渐次东风长绿苔，已看葭管动飞灰。\n慢惊邓禹封侯岁，不羡相如作赋才。\n安卧一丘馀老屋，待开三径种寒梅。\n芸窗岂有穷能送，柏叶聊倾酒一杯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28524,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题阶弟小竹里馆诗后","author":"俞庆曾","text":"慢向西窗感鬓丝，墨花开到谢家池。\n羡君生有空灵笔，湖海风涛腕底诗。\n轮蹄三度走燕南，遮莫骊珠颔下探。\n壁有龙泉犹待价，夜深风雨啸江潭。\n因风柳絮愧虚名，青草池塘梦里生。\n鹤静琴寒诗一卷，称他修竹月三更。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28525,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜坐忆家偕子戴作并索阶弟和","author":"俞庆曾","text":"帘外西风透绮寮，背镫拥髻坐寒宵。\n儿时滋味从头记，别后情怀借酒浇。\n茗碗熏炉同寂寞，瑶琴宝瑟懒句挑。\n朝朝一纸平安信，分付胥江早晚潮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28526,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄弟于衡阳","author":"俞庆曾","text":"红树青山放棹行，潇湘雁影伴长征。\n慈亲频为搴帷望，怕有西风阻客程。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28527,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"敬步祖父大人原韵","author":"俞庆曾","text":"浪说天涯若比邻，花前负却艳阳辰。\n心因望远情何极，身未能归梦转频。\n桃萼红时莺出谷，杜鹃开处雁辞宾。\n兰闺旧日芸窗下，手种朱樱可放春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28528,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄子戴京邑","author":"俞庆曾","text":"当时曾踏软红尘，茅店荒鸡送客轮。\n锦瑟年华东逝水，银釭风雨苦吟身。\n天涯杨柳初匀碧，江畔蘼芜已换春。\n不说相思深几许，平安聊慰远游人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28529,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"閒步","author":"俞庆曾","text":"亭亭落日晚烟收，指点遥山翠霭浮。\n千里瓯江波浪阔，乱云何处认苏州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28530,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏老榕树","author":"俞庆曾","text":"落叶辞柯下碧池，春风嘘植占当时。\n他生纵有灵根在，莫作人间连理枝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28531,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闻雁","author":"俞庆曾","text":"风清月瘦露华白，但闻寒虫啼切切。\n徙倚红楼看暮云，鸿声嘹唳来天末。\n影落潇湘杜若洲，天涯何处稻粱谋。\n玉门秋色羁臣感，归梦刀环少妇愁。\n银屏烛暗凭阑立，炉鸭香销莲漏咽。\n一声叫破万家秋，河汉无波人寂寂。\n伊人消息远长安，迢递关山路渺漫。\n无语举头天际望，暗将离思寄霜翰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28532,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄弟","author":"俞庆曾","text":"风前帆影梦归艭，天末还怜雁字双。\n自剪秋镫无一语，愁云如梦锁寒窗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28533,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"书示抱珠妹","author":"俞庆曾","text":"当时情味了无痕，此后思量总断魂。\n画尽寒灰书恨字，种来湘竹是愁根。\n那知身世安排错，如此华年岂忍论。\n扑面西风禁不得，残阳影里闭閒门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28534,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"消寒分咏 其一","author":"俞玫","text":"片石访严陵，江云路几层。\n冰花寒可拾，残柳贯难胜。\n雪浪催今古，沧波阅废兴。\n荒台遗迹在，风雨共谁登。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28535,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"消寒分咏 其二","author":"俞玫","text":"风递数声长，征人凄断肠。\n无功羁绝域，有梦隔殊乡。\n白发人千里，黄沙雁几行。\n客愁消不得，锦字盼流黄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28536,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"消寒分咏 其三","author":"俞玫","text":"冻断梨云路，閒庭乍雪天。\n风棂光闪烛，箫局暖偎烟。\n湘女凌波伫，嫦娥抱月眠。\n罗浮如可到，梅折数枝妍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28537,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"乙巳腊月二十九日为先慈四旬仙诞敬焚一诗","author":"俞玫","text":"风雪逼岁除，称觞又今日。\n泉壤去不返，十载梦魂隔。\n随侍安可期，顾复悲畴昔。\n常闻儿初生，每拟堪巾栉。\n设帨非悬弧，颇觉期望失。\n郁怀谁为宽，劳瘁易致疾。\n晨夕已减餐，提携仍恳切。\n最小偏垂怜，寝食依亲侧。\n长往遗孤儿，雏发犹覆额。\n岂识罔极恩。\n但苦音容没。\n千行赤子泪，何补春晖德。\n一樽长跪奠，芳草墓门碧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28538,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柳枝词 其一","author":"俞玫","text":"处士高风恋五株，清溪吾亦爱吾庐。\n苔矶软覆渔人钓，贯得江鱼上市初。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28539,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柳枝词 其二","author":"俞玫","text":"宫样眉痕占早春，伤心南内更无人。\n灵和最是新栽种，只解风流不解颦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28540,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柳枝词 其三","author":"俞玫","text":"湖山风雨系归心，新绿帘栊画阁阴。\n此日苏堤重倚棹，酒痕未抵别愁深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28541,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柳枝词 其四","author":"俞玫","text":"春色平分百卉先，黏天又见絮飞烟。\n凭谁画出娉婷影，数笔晴江夕照边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28542,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"落叶 其一","author":"俞玫","text":"楚江波冷下纷纷，消息玄机静里闻。\n此日霜华随逝水，当时风概想凌云。\n行吟楚客怜孤躅，话旧胡僧吊夕曛。\n极目郊原渺如许，天涯能不怅离群。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28543,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"落叶 其二","author":"俞玫","text":"千林一夕换空枝，天意分明未有私。\n淡日无聊还照影，石阑何处更题诗。\n步兵歧路悲身世，永叔秋镫感鬓丝。\n剩有后凋数竿竹，青青长伴岁寒时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28544,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"落叶 其三","author":"俞玫","text":"杂遝浑疑万骑催，夜寒齐卷朔风来。\n黄榆影落长城暗，紫塞声和画角哀。\n怀国易添苏武感，无家莫上李陵台。\n生原大地阑珊质，甘作乾坤废弃才。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28545,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"落叶 其四","author":"俞玫","text":"一转商音万象乖，寓形身世费安排。\n萧条枯管兰成赋，潦倒生涯杜老怀。\n烟雨几回三月暮，文章终古一丘埋。\n枫林薄晚停车处，莽苍重阴接断崖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28546,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"戏题落叶诗后","author":"俞玫","text":"策策西风警暮鸦，自倾残墨写轻纱。\n不辞憔悴如郊、岛，吟瘦寒镫一穗花。\n笔床启处砚田芜，馀韵寒犹逼绮罗。\n莫负因君三复咏，为侬好补屋牵萝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28547,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"留别舜华二姊","author":"成坤","text":"生小离家国，天涯十六春。\n明朝挂帆去，又是异乡人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28548,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋夜","author":"成坤","text":"西风催木落，何处不秋声。\n我是无愁者，閒阶爱月明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28549,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"古意","author":"成坤","text":"新月明如镜，镜复如明月。\n愿作明镜圆，莫作月常阙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28550,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夏夜露坐","author":"任丽金","text":"偶傍疏篱坐，罗襟怯露滋。\n时将团扇隔，不许月明知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28551,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"月夜闻雁","author":"任丽金","text":"独坐南窗下，初晴月倍明。\n云中新雁唳，却作故乡声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28552,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题家书后","author":"任丽金","text":"一别双亲半载馀，平安只接数行书。\n离怀欲向花笺写，写到相思字却无。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28553,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"记梦","author":"任丽金","text":"梦绕双亲膝，牵衣话正长。\n鸡声惊觉后，依旧在他乡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28554,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感怀 其一","author":"庄湘泽","text":"憔悴已如此，何堪丛百忧。\n对愁犹有影，多病不宜秋。\n骨肉他乡梦，年华逝水流。\n诗书且自遣，世法等浮沤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28555,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感怀 其二","author":"庄湘泽","text":"淡月濛濛夜，黄昏独坐时。\n镫残闻玉漏，烟断冷金猊。\n生死岂能隔，梦魂无见期。\n秋来摇落意，不复理琴丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28556,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋夜 其一","author":"庄湘泽","text":"独立空阶净，秋光和月微。\n莲房惊鹭梦，竹径乱萤辉。\n俯仰百端集，思量万事非。\n夜深浑不寐，冷露欲沾衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28557,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋夜 其二","author":"庄湘泽","text":"独向东篱下，潇然酒一尊。\n日沈暗蕉影，风静妥花魂。\n久客渐成故，旧书还复温。\n徘徊未归去，新月又黄昏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28558,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨夜读杜诗感作","author":"庄湘泽","text":"凄凄风雨夜，閒读少陵诗。\n展卷思今古，闻笳感乱离。\n平居多寄慨，世事有同悲。\n何日烟尘息，天心若未知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28559,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日寄妹","author":"庄湘泽","text":"极目明湖景物非，天涯有客泪沾衣。\n闺中望断南来雁，到得秋来犹未归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28560,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"与漱芳孝谅两妹夜话","author":"庄湘泽","text":"冻云笼月月笼霜，冷逼镫魂暗吐光。\n玉漏滴残寒夜永，围炉且莫话沧桑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28561,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寒食","author":"王芬","text":"无边红紫斗芳妍，却是清明雨后天。\n满地柳阴啼杜宇，隔墙花影落秋千。\n青帘几处飘村舍，荒冢连阡化纸钱。\n野外难禁三日火，飞灰乱袅夕阳烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28562,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春闺怨","author":"王芬","text":"宿雨开晴晓，轻寒懒酿花。\n无如旧时燕，犹恋故人家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28563,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日","author":"王芬","text":"肃杀秋声里，幽怀感百端。\n螀啼露华重，萤度月波寒。\n竹外疏花瘦，廊腰败叶乾。\n独怜三径菊，冷节末阑珊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28564,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"旅夜","author":"王芬","text":"旅馆羁身苦寂寥，西风庭树响萧萧。\n秋钲廿五寒声碎，何处高楼起洞箫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28565,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏菊","author":"王芬","text":"傲骨清标满路开，何年陶令赋《归来》。\n暗香盈袖风帘卷，自向东篱酹一杯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28566,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感时","author":"王芬","text":"世乱年荒何处家，陶轮浩劫涌尘沙。\n玄黄血染龙蛇起，谁倚危楼听暮笳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28567,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赏雪","author":"王芬","text":"乾坤不夜月无光，万壑群山尽玉妆。\n驴背诗翁去千载，雪中冷落野梅香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28568,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"有感","author":"赵录缜","text":"皎皎旧时月，照我前庭除。\n天地同一色，悲欢境各殊。\n忆昔兄妹四，谈笑共宴居。\n此景不易得，思之竟何如。\n两兄宦京国，秋风思莼鲈。\n仲兄成永诀，忽忽七载馀。\n死别求梦寐，生离凭雁鱼。\n百感填膺满，拈毫苦难书。\n伤哉闺中子，日与愁病俱。\n耿耿不能寝，风露沾衣裾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28569,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"骤雨忽霁星月娟朗徙倚庭除即景赋怀","author":"赵录缜","text":"蒸人烦暑郁中庭，参差树影清蝉鸣。\n晚云忽压雷声起，雨势倒挟沧溟倾。\n微风袅袅吹银河，明月盈盈扬素波。\n碧天澄鲜靓如洗，谁倚高楼发浩歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28570,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夏夜即事","author":"赵录缜","text":"空濛香雾合，人立小斜廊。\n顿觉罗衣薄，微微生夜凉。\n流萤度水阁，冷露下莲房。\n何处箫声咽，哀音一断肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28571,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日卧病焚香礼佛甚萧寥也成四韵","author":"赵录缜","text":"渐觉流光暮，萧条倍惨然。\n秋心最摇落，病骨况缠绵。\n奉佛三生石，焚香一缕烟。\n药炉伴禅榻，消尽菊花天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28572,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨夜读楚辞","author":"赵录缜","text":"破闷无憀读《楚辞》，愁心宛转病支离。\n自怜已抱秋情绪，况复深宵夜雨时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28573,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题绿窗诗草","author":"赵录缜","text":"兰心蕙质雪为姿，意气横飞足振奇。\n忧国如焚托讽谕，蛾眉真个愧须眉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28574,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怀古","author":"方毓昭","text":"《长门赋》与《白头吟》，怨悱凄凉变雅音。\n毕竟古人恩义重，挽回犹可借文心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28575,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"閒咏","author":"方毓昭","text":"无聊时复耸吟肩，笔砚常堆短榻前。\n偶忆《毛诗》心恍惚，呼儿代记在何篇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28576,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒三君祠","author":"刘文嘉","text":"三君祠外啼鹧鸪，三君祠前路盘纡。\n妇孺瞻仰官长拜，千秋俎豆虞韩苏。\n昔日天涯叹沦落，天遣先生为木铎。\n不教廊庙展经纶，却向蛮荒兴礼乐。\n党祸无人鉴覆车，石工姓字不忍书。\n汉庭指佞无屈轶，岭海尊贤有鳄鱼。\n致君尧舜古难必，蛾眉谣诼偏多嫉。\n百年荣瘁总成尘，一片浮云能蔽日。\n当时行迹没苔钱，此日崇祠锁暮烟。\n应羡山堂阮太傅，圣朝际遇胜前贤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28577,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"板桥垂钓","author":"刘文嘉","text":"红桥几曲照湖明，十顷琉璃镜样平。\n香饵不施竿在手，悠然物我两忘情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28578,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"大雪送式三弟沙市归省用东坡郑州别子由韵","author":"刘文嘉","text":"别酒欲倾愁兀兀，客子听鸡待月发。\n陟屺无辞行路难，肯使倚闾悲寂寞。\n咫尺天涯言笑隔，行迹旋看雪花没。\n严冬于役愁衣薄，舟楫马蹄销岁月。\n行人嗟叹农人乐，雨雪载涂寒恻恻。\n从来志士耻温饱，转眼百年易悠忽。\n起登高阁望归人，人去江空景萧瑟。\n莫因惜别惨离颜，早去娱亲供子职。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28579,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]