[{"title":"游华氏延绿阁赠海初前辈四首 其一","author":"王世忠","text":"旷世箕裘绿再延，一丘一壑倍缠绵。\n读书已满五千卷，游宦无过二十年。\n劫后沧桑凉似梦，望中池馆逸于仙。\n弓河地上重栽树，桃李阴阴起暮烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32461,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"游华氏延绿阁赠海初前辈四首 其二","author":"王世忠","text":"乞还初服返巾车，为欲名山补读书。\n垂柳当门陶令宅，浣花临水杜陵居。\n千竿竹翠抽新笋，半亩苔阴摘晚蔬。\n寄语南阳诸父老，使君无事自携锄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32462,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"游华氏延绿阁赠海初前辈四首 其三","author":"王世忠","text":"重城苍翠列如屏，云外钟声花外听。\n话旧衫痕春酒绿，课儿书味夜灯青。\n山中招隐双蓬鬓，海内倦游一草亭。\n最是凭栏吟眺处，清池岩石影珑玲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32463,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"游华氏延绿阁赠海初前辈四首 其四","author":"王世忠","text":"萧萧云壑带茅茨，韵事还兼笔一枝。\n画不求工才入妙，官因遗爱去留思。\n箧留先业买山券，袖有贫交乞米书。\n期许初心原不负，耕桑也是报明时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32464,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"陶然亭题壁二首 其一","author":"王日杏","text":"西山晚翠上孤筇，斜照神州殿阁重。\n芦苇萧萧浑似雨，数行啼雁隔城钟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32465,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"陶然亭题壁二首 其二","author":"王日杏","text":"僧舍茶烟满竹扉，绳床暂憩亦忘机。\n萸香菊淡人无语，听到哀蝉落叶希。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32466,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"岁暮","author":"吴达","text":"寒檐萧瑟意徘徊，客至敲门午未开。\n身为心悬时倚杖，酒因肺病久停杯。\n田归鱼鳖将何恃，书断鳞鸿竟不来。\n残腊又随寒梦去，莫教风角逐人催。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32467,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆母","author":"吴文镕","text":"纺绩终无已，操家只此心。\n衣装多布素，钗饰少黄金。\n身老持闺训，工余诵女箴。\n恩施尤逮下，婢仆感逾深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32468,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"山居","author":"吴文镕","text":"密树云深处，悠然小径通。\n藤萝宁障日，溪谷自呼风。\n得笋留僧共，探泉与客同。\n枝头听好鸟，相唤绿阴中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32469,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"泊京口","author":"吴遵锳","text":"铁瓮城边万井开，寒潮日夜此萦回。\n眼看北固还襟带，事忆南朝尽草莱。\n千里破帆京口驿，一江清磬妙高台。\n榜人催起残更梦，飒飒长风动地来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32470,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"襄阳怀古","author":"吴遵锳","text":"山川终古自留贻，杖策登临路或迷。\n千载几人还堕泪，当年多事漫沉碑。\n虚传池馆经游屐，无复儿童倒接䍦。\n凭吊只余霜柏在，旧时风干未离披。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32471,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雨窗步韵","author":"吴位镛","text":"检点游踪兴尚赊，窗前烟雾似蒙纱。\n雨膏著意滋芳草，风信无端妒落花。\n篱下土掀尖露笋，山边雷动嫩抽茶。\n多情最是衔泥燕，春社归来认旧家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32472,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"小春泛舟湖滨","author":"吴位镛","text":"旭日晴明叶染红，湖滨放棹喜柔风。\n千峰罗列皆城郭，三郡萦回接远空。\n练甲报仇虚霸业，凿山底定叹成功。\n何时结客探林屋，出没烟波伴钓翁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32473,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"奉和候纪之先生八十咏怀之作","author":"吴汝渤","text":"万象回春鸟告欢，环阶青士与苍官。\n别联吟社堪追洛，但得溪流合号磻。\n清福如君修不易，枯禅于我坐真难。\n绘图疑续香山会，解组归来一笑看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32474,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"答马公眉","author":"薛信辰","text":"鸡窗风雨十年迟，剪烛谈心月堕时。\n载咏淮南丛桂树，联吟洞口绛桃诗。\n乾坤春社三升酒，事业秋灯一局棋。\n高卧尽堪容醉叟，五湖烟景白鸥知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32475,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"自题东园诗草","author":"徐汉倬","text":"微风北窗来，羲皇对床席。\n陶公有凉音，饥寒实驱迫。\n作者代有人，东皋起王绩。\n醉乡日高枕，逸气出秋壁。\n岂惟屏淫哇，亦复黜嘄噭。\n征事多滞响，写景饶秀色。\n蒸蔚为云霞，郁勃走霹雳。\n声诗与乐通，由瑟圣所饬。\n盛唐李杜兴，万象尽开辟。\n可怜千载下，何处弄笔墨。\n吾生竟何事，弱毫叹孤植。\n如游空山阿，寒溜冻幽石。\n腊尽春渐苏，冰雪滴余沥。\n遂成一脉水，中涵小天碧。\n遥见鲸鱼归，复何能为役。\n远海生波澜，蛟龙有窟宅。\n风涛中澒洞，乃万怪惶惑。\n落日收钓纶，回舟傍芦荻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32476,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渡江云 云川阁坐雨同杜紫纶、华予思作","author":"徐汉倬","text":"秋心无虚著，登楼送目，衣薄晚天凉。\n小山丛桂近，瑟瑟西风，隔院度新香。\n分笺刻烛，重描写、细腻风光。\n恰仿佛，置身图画，帘影动潇湘。\n家乡。\n东华梦远，杜曲花新，正莼鲈无恙。\n莫便道，相如游倦，懒赋长杨。\n江南秋色凭君取，更平分、座上清狂。\n人醉也，雨丝都化愁肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32477,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晚晴","author":"徐廷栋","text":"不雨忧农事，雨多还望晴。\n亚窗斜日漏，高树晚霞生。\n一水白连野，数峰青过城。\n明朝思出郭，看稻听残莺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32478,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过鹰潭","author":"徐廷栋","text":"山半忽成市，人烟岛屿通。\n涨痕秋气白，草色夕阳红。\n几树悬渔网，谁家放鸭笼。\n征桡还暂住，随意问民风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32479,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"怀管社山人","author":"徐流方","text":"平湖万顷烟，孤峰一湾月。\n常伴高人吟，邈与尘世绝。\n曾随捕鱼者，一棹缘源入。\n不识芙蓉花，别来几攀折。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32480,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"大年尊彝兄弟见访溪庄","author":"徐流方","text":"白鸥渺何处，一笑接诸昆。\n不尽秋来意，相将倒一樽。\n花香傍舍树，月上隔湖村。\n钓得鲈鱼美，清愁细细论。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32481,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"舟夜行","author":"叶孝基","text":"冥色山水合，凄然一棹过。\n岸移云意懒，波定月痕多。\n乍喜孤村火，遥怜别浦歌。\n倦游人不寐，前路问渔蓑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32482,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"重九日重游华藏和谈处士","author":"叶孝基","text":"鼓枻竟何往，言寻湖上岚。\n旧林枫树赤，新雨石苔蓝。\n粳稻入蓬户，天香发小龛。\n重来华藏老，白发照空潭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32483,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"重游震泽泊舟鼋头渚","author":"叶孝基","text":"欲将土胃浣纯灰，不遣胭脂到水隈。\n荫壁虬松吞宿雾，蹲波怪石锁苍苔。\n舟因舴艋鱼偏狎，人似凫鸥鸟不猜。\n何事风流狂少伯，功成犹拥越姬来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32484,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋郊晚望二首 其一","author":"杨庆徵","text":"高树暗秋色，千山明夕阳。\n极目碧田绕，娟娟禾黍香。\n寒螀鸣且歇，飞鸟故回翔。\n少焉夜气沉，明月来清光。\n徘徊东皋上，长啸发清商。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32485,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋郊晚望二首 其二","author":"杨庆徵","text":"闲行日色西，四面秋声起。\n野际尽苍烟，陇畔皆流水。\n牧童吹短笛，渔灯映远沚。\n清风开胸襟，薄露沾衣履。\n登眺兴不穷，惟吾自徙倚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32486,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"惠山云起楼落成同诸公赋","author":"杨庆徵","text":"几年不作九龙游，扶病行来解宿愁。\n经过古藤依旧在，忽看新雨半空浮。\n雕栏曲槛临霄汉，华栋珠帘俯涧流。\n坐憩意在泉共彻，登临身与境俱幽。\n大湖月满南窗入，叠嶂云深北牖留。\n冉冉平畴来雾霭，阴阴廿里布松楸。\n上方禅寂疏钟度，下界人喧细管稠。\n水带玉虹晴亦雨，山飞翠浪夏疑秋。\n宾朋不数三贤笔，意气应依百尺楼。\n曾见灵台成不日，共闻花县治难侔。\n未因喜雨追坡老，自布淳风比太邱。\n欲识凭高无近远，延陵处处有歌讴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32487,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"倦寻芳","author":"杨庆徵","text":"绣帘半卷，银箭初长，清悄庭宇。\n云鬓鬅松，斜堕钿头钗股。\n浓树荫遮行色远，乱山翠叠春光暮。\n怕登楼、见横桥断岸，绿凄迷处。\n遍江畔，纤枝娇蕊，知道个人，何地留住。\n香冷鸳衾，暗滴泪珠无数。\n蝶翅寻芳魂一点，柳丝织影愁千缕。\n更凄凉，送梨花夜来风雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32488,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"泛湖","author":"杨维宁","text":"扁舟信宿五湖中，鼓枻长歌西复东。\n见底清流鱼惚恍，露根奇石草蒙茸。\n秋声木叶山山月，夜色芦花岸岸风。\n任我浪游浑不禁，谁言天地有樊笼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32489,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寄怀殷梦五师武陵书院","author":"杨守约","text":"一石松醪好独斟，身轻喜得罢鸣琴。\n闲书彭泽归来赋，静识濂溪太极心。\n旧雨来稀酣午梦，新诗吟罢妾幽寻。\n云亭问子栖迟久，夜月寒窗思不禁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32490,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"黄华石寄示儿潮","author":"杨孝元","text":"闻道岩州署，黄华石已多。\n主宾还物色，童仆竞遮罗。\n势必兼车载，难将一骑驼。\n将母同苡薏，谤起待如何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32491,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"柳港","author":"杨孝元","text":"柳港桥边列屋庐，比来风景想当初。\n儿童长大居何等，亲友凋零有几馀。\n礼让昔年兴未易，诗书此日味谁茹。\n匹夫为善犹能化，嗟我而今迥不如。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32492,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"访黄崇嘏墓四首录二 其一","author":"杨潮观","text":"恐是瞿昙幻化因，女郎花现宰官身。\n无端泄露春光早，云破方知一月真。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32493,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"访黄崇嘏墓四首录二 其二","author":"杨潮观","text":"东风不上蜀王台，环佩衣冠尽草莱。\n只有香名埋不得，梅花毕竟百花魁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32494,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"三谒庞士元墓 其一","author":"杨潮观","text":"白马关前落凤坡，千年孤冢郁嵯峨。\n可怜末定三分鼎，草草功名也不磨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32495,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"三谒庞士元墓 其二","author":"杨潮观","text":"襄阳旧隐白云开，龙凤双飞入蜀来。\n今日墓门秋草里，一般残照使人哀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32496,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"三谒庞士元墓 其三","author":"杨潮观","text":"三尺孤坟幸未平，筑台应可对怀情。\n书生只解风流梦，赢得啼猿有四声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32497,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"道逢陈一表弟","author":"杨泰","text":"不记几年别，相看鬓又新。\n匆匆言不尽，先问白头亲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32498,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"郡中雨窗题画","author":"杨泰","text":"庐阳客舍雨疏疏，尽日无人问索居。\n睡起小窗闲吮墨，满庭柿叶落花初。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32499,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"东胶山晤黄守中先生曾孙某出其先人守制砚并顾景范安孟公两先生画卷","author":"杨泰","text":"梁鸿山与嵩胶连，鹅湖宛溪中回旋。\n水深土厚俗淳朴，鹿门往往栖高贤。\n守中先生最狷洁，授经门外多车辙。\n摩挲一石常数年，手斫溪云制独绝。\n我来山下寻公孙，百年家世仍清门。\n开缄什袭示手泽，穆然太古风犹存。\n家徒四壁复何有，草堂为溯先生寿。\n孟公手绘独亦圆，顾子作辞文不朽。\n秋风钓渚荐花月，执手苍凉对华发。\n袖手残棋局外闲，蓬莱清浅伤飘忽。\n忆昔分宜柄国时，累朝元气中凌夷。\n光熹以后盛阉监，清流白马同伤悲。\n乔木依然故家在，洞口花深閟时代。\n斯文载读重嗟吁，卷图抚砚还踟蹰。\n溪山无恙如画图，寒峰落日村烟孤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32500,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"游华藏寺","author":"杨德冲","text":"寺废吴天白，松云不尽浮。\n气蒸初入夏，麦秀已先秋。\n麋鹿留宾住，湖山挈伴游。\n夫差今未醒，沙上自眠鸥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32501,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"广陵怀古","author":"杨德文","text":"香消南国美人妆，烟雨迷楼总断肠。\n今日绮罗丝管里，春风吹不到雷塘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32502,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"塔映庄访桂上人","author":"杨德文","text":"天气日夕清，万象纷在目。\n远山螺髻旋，浅水鱼鳞蹙。\n隔林人语微，鸡犬答空谷。\n此中有高僧，暝坐栖茅屋。\n萝扉风为开，花径罗云族。\n几榻青苔生，茶烟媚幽独。\n我蜡阮孚屐，间来访金粟。\n塔影空独圆，衣裳净寒绿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32503,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杜鹃花","author":"杨守礼","text":"百年过半学忘情，绮语芟除手亦生。\n因甚对花情未了，杜鹃颜色正倾城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32504,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"冬夜和朱画庄韵","author":"杨守礼","text":"醉醒何处可，延月键松扉。\n境寂心还定，天高梦不归。\n一弹琴味永，三叹瑟声稀。\n翻羡孤飞雁，寒芦任尔依。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32505,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题倪高士竹木图真迹轴","author":"杨廷果","text":"清閟高风动四夷，早知名盛有危机。\n弃财脱兔投林去，犹有余殃触是非。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32506,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"漪澜堂二首 其一","author":"杨廷果","text":"漪澜妙迹忆坡翁，不见龙蛇落池中。\n遗我鹂珠鱼蟹眼，至今千载响松风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32507,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"漪澜堂二首 其二","author":"杨廷果","text":"天上小团携月去，人间第二索吟来。\n空中识得源头处，味向新诗笔底回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32508,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春申涧","author":"杨廷果","text":"醉觅飞泉乳雪，独行残月高峰。\n长笛一声云杪，不知何处琼宫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32509,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"专诸塔二首 其一","author":"杨万藻","text":"范蠡宅边天共水，阖闾城外雨连潮。\n凄凉惟有专诸塔，半壁红泥草木焦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32510,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"专诸塔二首 其二","author":"杨万藻","text":"铍纵交胸胆不寒，恩酬公子死何难。\n可怜锋甚鱼肠剑，不斩佞臣太宰官。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32511,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送顾大竹勋之江右","author":"杨万藻","text":"灯火沿塘映寺楼，小金山下又扁舟。\n别离亦是寻常事，无奈年华共白头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32512,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题海天石屋香谷邵公刻像","author":"杨延俊","text":"文庄遗址榛莽中。\n先生追复成钜功。\n祠墓修筑成崇隆。\n保此胜迹垂无穷。\n至今遗老犹称公。\n窈窕石屋倚高峰。\n表章潜德图仪容。\n人间天上寻芳踪。\n屈指今年百岁翁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32513,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"兰","author":"俞鲁瞻","text":"岩阿同寄迹，气味得交深。\n逸韵流虚室，清芬溢素襟。\n采芳君子佩，援操古人心。\n湘水留余憾，千秋泽畔吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32514,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"吊倪高士墓","author":"俞鲁瞻","text":"夙昔仰芳躅，今日寻荒莱。\n碑横鸟篆灭，径仄霜花开。\n松姿冷危石，鹤梦栖寒梅。\n凭吊发深慨，踏月东皋回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32515,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"碧山吟社","author":"严元桂","text":"已向茶楼忆孟端，更移步屧上吟坛。\n泉通桑苧余荒砌，涧走春申尚激湍。\n无复把茆堪啸咏，空传老辈此盘桓。\n松阴剩有残碑在，为扫苔痕仔细看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32516,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"阖闾城","author":"严元桂","text":"当年防越有深谋，西筑雄都控上游。\n万顷波涛沉鼓角，千山云树壮旌旒。\n南风不散鸱夷恨，夜月空悬雉堞秋。\n终古兴亡何定局，一名犹为阖闾留。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32517,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寻碧山吟社遗址怀兴复诸先生","author":"严元桂","text":"人事有废兴，大雅古所稀。\n深山闻杖履，望古长歔欷。\n成宏传十老，列坐吟翠微。\n丹青在人间，相见山林姿。\n衣冠并简朴，虬髯鬓如丝。\n我闻父老言，高名动王畿。\n试问蝉冕客，何如大布衣。\n奕世绳祖武，风流更相师。\n富贵慕幽胜，猿鹤咸猜疑。\n立言固不朽，瓣香终在斯。\n卓在撚须亭，邈矣古木陂。\n扪萝多向往，游人寻旧碑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32518,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋日偕秦丈对岩小饮寄畅园","author":"尤直","text":"主人能好客，园树亦先红。\n鱼意空秋水，琴声散晚风。\n心知上下古，人老去来中。\n山色常如旧，神光自内充。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32519,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"读书惠山九阳宫","author":"尤钧","text":"我携绿绮琴，高上白云岑。\n树杪泉声落，窗横山霭深。\n嚣尘从可谢，虚阁任闲吟。\n何必生遥羡，丹邱待更寻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32520,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雨中登惠山","author":"尤钧","text":"拨云上高岭，云浮岭飞动。\n磴滑趾不容，手藉藤萝控。\n雨声杂松风，澎拜怒涛涌。\n行行崖岫间，翠湿衣袂重。\n回顾下山路，落叶飞鸟送。\n寻寺谋憩踪，隔竹钟鱼讽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32521,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日偕秦大南熙糜二逊肤泛舟蓉湖","author":"尤钧","text":"东风何日至，生意满平芜。\n桃叶同浮艇，杏花开倚垆。\n客来茶正沸，春去鸟争呼。\n暮景苍然起，天光到水无。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32522,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"小孤山","author":"尤钧","text":"秀绝悄凌波，青青滴黛螺。\n云旗斜日下，沽客待风多。\n眇眇疑含睇，垂垂欲画娥。\n彭郎诚漫语，应著送迎歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32523,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"独往忍草庵","author":"尤钧","text":"晚烟漠漠上人衣，独立空林对落晖。\n红叶满山人迹少，乱峰深处一僧归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":32524,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]