[{"title":"蝶恋花 示儿辈","author":"孙瑩培","text":"子孝臣忠须自晓。\n奋志攻书，不读如何了。\n白发高堂年已老。\n诸凡岂可仍草草。\n自古英雄原让少。\n难再光阴，知道不知道。\n万里关山家路杳。\n青春渐长还非小。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21834,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 思亲","author":"孙瑩培","text":"孺慕思悠悠。\n珠泪长流。\n无言日日倚西楼。\n杜宇数声春已去，一霎成秋。\n午后雨初收。\n黄菊开稠。\n思量欲待解些忧。\n忽见半钩眉月上，句起新愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21835,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉楼春 郑夫人将旋粤东，索余画小影，并题词以赠","author":"孙瑩培","text":"闲庭秋色娱游目。\n桐荫桂香都不俗。\n湘帘高捲对黄花，消受人间清供福。\n抟沙相聚浮踪托，听到骊歌怜索寞。\n它乡欲寄折枝难，应遣它阶前双鹤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21836,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 郑丽芳女史南旋，作此送别","author":"孙瑩培","text":"一从抛却西湖去。\n故山迢递难为主。\n亲友四凋零。\n宦游同此情。\n蛮乡悲寂寞。\n幸得浮综托。\n忽地道归期。\n教人恨莫支。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21837,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 前题","author":"孙瑩培","text":"纷纷心绪萦怀索。\n两闿辜负新秋菊，深喜遇苏程。\n连朝话未鸁。\n忽听征驾速。\n又触离愁恶。\n鬲岁约重临。\n春波画舫轻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21838,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"长相思 岁暮送三儿维廉偕表侄徐大椿上桂林","author":"孙瑩培","text":"茶一尊。\n酒一尊。\n明日轻装又远行。\n凄凉此夜灯。\n风一程。\n雨一程。\n长路迢迢两个人。\n心随马后尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21839,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"调笑令 即景","author":"孙瑩培","text":"长夜。\n长夜。\n坐得愁人愁绝。\n满楼花雾香清。\n隐著一帘月明。\n明月。\n明月。\n不管人间离别。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21840,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令 汪淑娟女史过寄园，见访口占","author":"孙瑩培","text":"曾记去年春晓。\n斜倚阑干同笑。\n有句正联吟，忽报海棠开了。\n开了。\n开了。\n今日此情又肖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21841,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一剪梅 记别","author":"孙瑩培","text":"相隔天涯已半秋。\n鱼书频投，雁书频投。\n一朝相见喜盈眸。\n细诉僝僽。\n再诉离愁。\n肴酒盈卮且唱酬。\n花上鱼钩，月上帘钩。\n无端重别恨悠悠。\n风亦难留。\n雨亦难留。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21842,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 七夕","author":"孙瑩培","text":"银汉横秋，早又是、曝衣时节。\n■■■、■■■■，■■■■。\n岁岁纵教欣聚会，年年何用伤离别。\n预安排、瓜果设闲阶，巧遥乞。\n一庭秋，花枝叠。\n暮云飞，长空碧。\n正斜月如钩，晚凉清绝。\n玉露霏霏魂欲断，银河耿耿愁无极。\n想神仙、此夕尚分离，心凄切。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21843,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"山花子 陆川榕根村墓次秋夜有感","author":"孙瑩培","text":"濛濛凉月夜清寥。\n伤逝悲今魂欲飘。\n庐墓凄其愁莫及，恨难消。\n松凋柏老思无尽，日暮山颓忆转遥。\n宿墓独吟眠不得，雨潇潇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21844,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆江南 早春","author":"张友书","text":"晴日影，初照绿窗纱。\n镜里画眉人未起，帘前鹦鹉唤煎茶。\n香透玉梅花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21845,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醉花间 送春","author":"张友书","text":"愁春去。\n送春去。\n春去何方住。\n满院绿阴浓，便是春归处。\n落花飞野渡。\n渡口鸣柔橹。\n何处送春船，一霎河滨遇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21846,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 北固山晚眺","author":"张友书","text":"怪石松根，写木落、江寒时节。\n吟未了、金山老树，象山残雪。\n独自临江亭上望，风涛两岸无休歇。\n问凭今吊古几回来，皆空裂。\n千古事，翻风叶。\n千古恨，横将铁。\n望秣陵何处，晚霞明灭。\n林际蟾光犹未吐，空中雁影遥相接。\n听怒潮东下海门来，声呜咽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21847,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆江南 题画扇","author":"张友书","text":"垂柳绿，茅屋阿谁家。\n山色苍茫飞独鸟，小桥流水绕平沙。\n何处有桃花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21848,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 午节感怀","author":"张友书","text":"蒲酒家家，年光又是逢重午。\n彩丝角黍。\n俗尚沿荆楚。\n佳节年年，总在他乡度。\n添愁绪。\n汀兰岸杜。\n绿遍天涯路。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21849,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆少年 寄罗耦廉外甥","author":"张友书","text":"飞鸿时序，夕阳门径，西风庭院。\n秋光宛如昨，惜吟诗人远。\n一曲阳春词独擅。\n诉平生哀怨。\n年来可相忆，算多时不见。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21850,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 听蟋蟀有感","author":"张友书","text":"深坐意悠悠，新月如钩。\n淡烟花影小窗浮，底事添人羁旅恨，吟尽清秋。\n唧唧总无休，问尔何由，为伊憔悴五更头。\n转念浮生真大梦，著甚闲愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21851,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西江月 九日忆兄妹","author":"张友书","text":"绝少催租风雨，秋光宛似春光。\n山容明净不须妆。\n满眼秋高气爽。\n回首故园兄妹，怕看鸿雁成行。\n可怜辜负好重阳，开遍黄花谁赏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21852,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"真珠帘 客中感怀，示儿辈","author":"张友书","text":"风鸣檐铁惊人寤。\n更啾啾唧唧、阶前蛩语。\n忧患馀生，尝遍世间辛苦。\n老至尚居人庑下，叹客里、光阴虚度。\n谁顾。\n似孤鸿天际，北来南去。\n尔辈，文章非误。\n便荠盐憔悴，奇怀休负。\n鸾凤暂羁囚，岂山鸡为侣。\n我已年花将六十，依旧是，累缘儿女。\n凝伫。\n待祖鞭先著，慰余迟暮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21853,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江南好 本意","author":"张友书","text":"江南好，早韭荐初春。\n竹外轻雷抽嫩笋，江头春水上河豚。\n风味总宜人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21854,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江南好","author":"张友书","text":"江南好，十里芰荷香。\n翠竹凉生蝉噪晚，茶瓜留客昼偏长。\n疏柳挂斜阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21855,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江南好","author":"张友书","text":"江南好，丹桂正芳菲。\n天淡云闲秋禾老，橙黄橘绿蟹初肥，鲈脍客思归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21856,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江南好","author":"张友书","text":"江南好，瑞雪洒琼瑶。\n火拨红炉添兽碳，杯倾绿蚁泛香醪。\n诗思在梅梢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21857,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 寄罗甥耦廉","author":"张友书","text":"孤烛他乡，正平狂态相违久。\n持杯在手，咄咄因卮酒。\n人是当年，意气应如旧。\n谋升斗。\n折臂能否，可似先生柳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21858,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 盼次男克常不归","author":"张友书","text":"归鸦几点垂杨外，愁人此际浑无赖。\n新月半昏黄，微风生夜凉。\n不瞑长太息，独自悲孤寂。\n寄语远游人，朝来白发新。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21859,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十六字令 春日偶成","author":"张友书","text":"清。\n雨过遥天无片云。\n垂杨外，时啭一声莺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21860,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆江南 题画","author":"张友书","text":"春光好，茅屋野人家。\n风皱绿波摇翠柳，日暄红雨洒桃花。\n山外夕阳斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21861,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 春阴","author":"张友书","text":"门径愔愔，苔痕浓淡篱根绕。\n过春社了，燕子归来早。\n乡梦初回，一觉晨钟晓。\n帘栊悄。\n篆烟犹袅，此际愁多少。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21862,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"转应曲 暮春","author":"张友书","text":"飞雪。\n飞雪。\n柳絮漫天时节。\n青青芳草池塘。\n斜日闲阶昼长。\n长昼。\n长昼。\n深院下帘人瘦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21863,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红","author":"张友书","text":"磊落如君，问抑塞、奇才谁拔。\n空抱负、满怀壮志，一身侠骨。\n家学青箱堪世守，何门朱履容轻衱。\n问买臣，穷困有谁怜，心空热。\n年正富，才无敌。\n酒户大，诗怀阔。\n每悲歌慷慨，其音清越。\n天骥呈才终展足，干将出冶难藏匣。\n莫效它、儿女诉穷愁，牛衣泣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21864,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"唐多令 与兰仙夫人别逾年矣，近闻其病，废村居老，怀枨触难已于言，率成此调","author":"张友书","text":"过眼总云烟。\n斯人各一天。\n记当时、访戴河边。\n杨柳小桥缘岸曲。\n帆影过，夕阳悬。\n诗酒话缠绵。\n波心月正圆。\n听渔歌、又近门前。\n回忆昔时如梦寐，嗟不见，又经年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21865,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"琴调相思引 寄怀宜寰宓三女弟","author":"张友书","text":"焚尾开残又送春。\n将雏燕子绕重门。\n愁怀谁遣，相伴只琴尊。\n离思漫漫无晓夜。\n落花飞絮总销魂。\n不胜怊怅，新月送黄昏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21866,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"苍梧谣 夜雨书怀二首 其一","author":"张友书","text":"眠。\n何处秋声到枕边。\n芭蕉雨，点滴画栏前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21867,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"苍梧谣 夜雨书怀二首 其二","author":"张友书","text":"愁。\n底事依人不去休。\n难抛却，心上与眉头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21868,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 秋夜","author":"张友书","text":"床前明月。\n惹起乡心今夜切。\n何处秋风。\n萧瑟偏来小院中。\n芭蕉桐叶。\n搅乱愁怀向谁说。\n嘹唳云间。\n又听征鸿自北还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21869,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令","author":"张友书","text":"展轴全非故我。\n相对浑疑两个。\n甚矣叹吾衰，不是寻常摧挫。\n无那。\n无那。\n此事怎生躲过。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21870,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 克劬北上旬日，计程未达帝都，寒夜不寐，悄然念之。","author":"张友书","text":"迢迢客路三千里。\n心牵游子情难已。\n离思黯然生。\n挑灯忆远人。\n孱孱羸瘦质。\n怎惯长为客。\n午夜板桥霜。\n怜伊风露凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21871,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南","author":"贺双卿","text":"人不见，相见是还非。\n拜月有香空惹袖，惜花无泪可沾衣。\n山远夕阳低。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21872,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春从天上来 梅花","author":"贺双卿","text":"自笑恹恹。\n费半晌春忙，去省花尖。\n玉容憔悴，知为谁添。\n病来分与花嫌。\n正腊衣催洗，春波冷、素腕愁沾。\n硬东风、枉寒香一度，新月纤纤。\n多情。\n满天坠粉，偏只累双卿，梦里空拈。\n与蝶招魂，替莺拭泪，夜深偷诵楞严。\n有伤春佳句，酸和苦，生死俱甜。\n祝花年。\n向观音稽首，掣遍灵签。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21873,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春从天上来 饷耕","author":"贺双卿","text":"紫陌春情。\n慢额裹春纱，自饷春耕。\n小梅春瘦，细草春明，春田步步春生。\n记那年春好，向春燕、说破春情。\n到于今、想春笺春泪，都化春冰。\n怜春痛春春几，被一片春烟，锁住春莺。\n赠与春侬，递将春你，是侬是你春灵。\n算春头春尾，也难算、春梦春醒。\n甚春魔，做一春春病，春误双卿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21874,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一剪梅","author":"贺双卿","text":"寒热如潮势未平。\n病起无言，自扫前庭。\n琼花魂断碧天愁，推下凄凉，一个双卿。\n夜冷荒鸡懒不鸣。\n拟雪猜霜，怕雨贪晴。\n最闲时候妾偏忙，才喜双卿，又怒双卿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21875,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪纱 赠贺双卿","author":"段玉函","text":"古树寒鸦集复惊。\n北风凉透薄罗层。\n小塘残水渐成冰。\n日色淡来花意散，雁声孤处客愁凝。\n那时离别此时情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21876,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"摊破浣溪纱 赠贺双卿","author":"段玉函","text":"衰柳风前叶已稀。\n晚烟横界远山齐。\n日落寒云天影白、雁单飞。\n秋月香花存旧句，板桥流水换新题。\n总是不堪重见处、认柴扉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21877,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"李道清","text":"小阁红箫韵未休。\n碧烟狼藉百花洲。\n春阴暗暗梦悠悠。\n蝴蝶路迷芳草远，黄鹂声住水东流。\n古来谁得倩春留。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21878,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙 丁酉之秋，云史赴金陵，填临江仙一阕寄示，率和之","author":"李道清","text":"一寸离愁千里梦，近来梦也无踪。\n清秋凉意入房栊。\n片云来月地，疏雨落晴空。\n云鬓清凉花气淡，夜深独听梧桐。\n下帘声在雨声中。\n一腔离别意，料得与君同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21879,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆王孙 丁酉七夕，云史将有秣陵之行，原调和之","author":"李道清","text":"坐听烟露下丛兰。\n秋月今宵共指看。\n明知小别总难欢。\n已秋寒，别后君休独倚栏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21880,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"李道清","text":"春水悠悠淡远空。\n无言闲立画桥东。\n夕阳影里落花中。\n有恨门开千岭绿，无情帘捲一庭红。\n黄昏怊怅雨和风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21881,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花","author":"李道清","text":"孤城云外。\n当日楼台今何在。\n细雨红楼。\n一夜江声枕上愁。\n山川如许。\n彩笔题诗深夜语。\n入耳砧声。\n扬子江头月自明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21882,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"更漏子 秋思","author":"李道清","text":"菡萏香，龙须冷。\n帘子风摇难定。\n还对镜，更添衣，玉墀清漏稀。\n画楼近，天涯远，梦里醉中恩怨。\n无可奈，不堪寻，小庭秋雨深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21883,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"少年游","author":"李道清","text":"遥波无际，片帆不动，烟雨绕江楼。\n洞房春晓，珠帘半捲，人在柳梢头。\n桃花浪涨春愁远，此意倩谁留。\n诉与春庭落花知，道又恐、落花愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21884,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 秋夕夜起纳凉和云史","author":"李道清","text":"露脚无声云髻拖。\n银床低吹玉笙和。\n藕风一线晃帘波。\n近水阑干人坐处，满身明月望秋河。\n此间清影纳凉多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21885,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"李道清","text":"水榭烧香云满天。\n月明花底荡秋船。\n玉人无寐睡妆残。\n白露濛濛花梦冷，银河淡淡水声寒。\n清歌一曲水云闲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21886,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 又一体","author":"李道清","text":"辘轳金井谁家院。\n银河明灭参差见。\n一桁珠帘难放捲。\n朱阑六曲凭千遍，慵爇金猊沉水片。\n一砌秋虫清夜怨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21887,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"李道清","text":"博山香定烟丝直。\n薄妆闲坐西窗侧。\n棋罢正思眠。\n画屏春夜寒。\n玉阶苔藓薄。\n花雨廉纤落。\n春恨自阑珊，梨花半不开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21888,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"李道清","text":"莲塘夜静箫声起。\n银屏梦觉凉如水。\n玉臂捲湘帘。\n星河秋满天。\n悠悠今夜怨。\n只有鸳鸯见。\n清影不分明。\n巧云移月行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21889,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题荣禄第 其一","author":"柯先荣","text":"华堂耸立俯江流，十里长溪入望收。\n岩翠送青铺玉砌，日光破晓上银钩。\n绣屏恍列千章树，锦缆斜牵一叶舟。\n领取河山佳气好，红栏杆外景悠悠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21890,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题荣禄第 其二","author":"柯先荣","text":"偶辞清俸恋烟霞，闲赋归来担旧家。\n三面云山连翠竹，一庭松菊自栽花。\n龙鳞晓捲疏棂月，雀舌时烹小院茶。\n漫羡前贤完美意，欢联棣萼话桑麻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21891,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"惜余春慢 题小檀栾室汇刻闺秀词","author":"王以敏","text":"芬佩搴兰，铢衣散锦，到眼墨云交绚。\n飘灯珠箔，伫月晶帘，销得燕愁莺惋。\n不信人天感多，捣麝犹香，拗莲难断。\n恁风流也称，玉台新序，衍波传遍。\n京国事，井华朝汲，秋水宵吟，法曲红箫亲按。\n去年元夜，佳节重阳，南宋倩魂还见。\n艳绝珊株网闿，百衲补琴，九华裁扇。\n听瑶空、笙鹤风高，花外绮霞吹满。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21892,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行 哭桂儿","author":"高佩华","text":"冷冷清清，参横月落。\n梦魂颠倒人如醉。\n可怜小婢正酣眠，模糊犹认儿安睡。\n重剔残灯，几番憔悴。\n漏声滴向心头碎。\n霜冷露白不知寒，和它蜡炬垂双泪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21893,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 和曹顾庵年伯","author":"吴绡","text":"秋近江南，荷香处、绿波烟涨。\n消永昼、一觞一咏，葛巾无恙。\n文宴不须陈玳瑁，淋漓醉墨瑶笺上。\n鲙松陵、新钓四腮鲈，渔家饷。\n小鼎中，轻云漾。\n险韵句，频频唱。\n也胜它黄公垆畔，共酌村酿。\n细雨曾催杜老诗，花开不待三郎杖。\n看群贤满座似神仙，兰亭状。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21894,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 读曹太史原词，再和端之作","author":"吴绡","text":"八斗才华，似大海、紫澜初涨。\n爱楚俗、年年端节，彩丝驱恙。\n榴喷早红开午宴，挥毫击钵蒲筵上。\n缔金兰、珠玉尽名流，欢相饷。\n墨花浓，香飘漾。\n郢市曲，争先唱。\n笑韵成金谷，漫倾醇酿。\n何如风雪苦情思，不劳蜡屐携筇杖。\n比芙蓉出水更天然，难形状。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21895,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 乞叙","author":"吴绡","text":"弄笔涂鸦，愁来似、云兴波涨。\n许屈指、年华易去，可禁频恙。\n噩梦几番掷过了，半生心事毫端上。\n检残篇、绿酒若为消，谁相饷。\n风景好，春摇漾。\n题咏处，曾酬唱。\n奈寻香摘艳，蝶衔蜂酿。\n玄晏当今文学老，校书天禄燃藜杖。\n比无言桃李却多言，雨花状。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21896,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]