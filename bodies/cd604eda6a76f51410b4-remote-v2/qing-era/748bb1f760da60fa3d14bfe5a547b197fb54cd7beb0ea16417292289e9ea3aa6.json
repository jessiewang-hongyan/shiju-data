[{"title":"番社杂咏二十四首","author":"黄叔璥","text":"男冠毛羽女䰐鬖，衣极鲜华酒极酣。\n一度齐咻金一扣，不知歌曲但喃喃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3106,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"番社杂咏二十四首","author":"黄叔璥","text":"红毛旧习篆成蜗，汉塾今闻近社皆。\n谩说飞鸮难可化，泮林已见好音怀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3107,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾吟 其二","author":"黄学明","text":"漆身裸体类山麌，有古遗风不是愚。\n蔓草束头分角髻，青筐归市买陬隅。\n编莎似橐箍腰骨，截竹为圈塞耳珠。\n蛮曲听来无一字，行歌岩下采春芜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3108,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾吟 其三","author":"黄学明","text":"山花满插鬓头光，蛮妇蛮童一样妆。\n久嚼槟榔牙齿黑，新成曲糵口脂香。\n草间察节知风色，日下承暄度岁霜。\n独有生男无喜处，女郎求室迓儿郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3109,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾吟 其四","author":"黄学明","text":"山深深处又深山，一种名为傀儡番。\n负险杀人誇任侠，终年煨芋饱儿孙。\n烟霞铸骨身能寿，薜荔为衣冬亦温。\n鸟道倚天高不极，惯常奔走捷如猿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3110,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"恭纪惠献贝子王平定浙闽功迹颂言 其一","author":"杨二酉","text":"简任隆专面，皇家有召方。\n虎符来凤阙，玉斧出荆阳。\n越北烽初动，闽南丑欲狂。\n恻然勤睿虑，移节奠金汤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3111,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"恭纪惠献贝子王平定浙闽功迹颂言 其二","author":"杨二酉","text":"八闽开层障，三山列秀雯。\n王师忻大捷，宗子有奇勋。\n竹帛昭天日，轮囷灿海云。\n邻霄遗泽畔，人识旧将军。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3112,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"恭纪惠献贝子王平定浙闽功迹颂言 其三","author":"杨二酉","text":"积善长馀庆，天家亿万年。\n维城开旧府，閟殿仰遗悬。\n龙幕浮香雾，螭环引翠烟。\n蒸蒸兴孝思，俎豆永鳌巅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3113,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"恭纪惠献贝子王平定浙闽功迹颂言 其四","author":"杨二酉","text":"况有旌贤诏，祠崇闽越中。\n勋高天柱北，名溢大瀛东。\n嗣烈敷丹荩，承谟慰紫枫。\n讴歌兴海上，先后仰崇功。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3114,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秀峰塔诗","author":"杨二酉","text":"绿沉初脱颖，光照海东西。\n阵扫千军废，锋排五岳齐。\n鹏抟云有路，蟾步月为梯。\n伫看生花管，长杨赋可题。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3115,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南巡纪事 其一","author":"杨二酉","text":"路转埤头近，平山一线连。\n野桥低涧水，深竹暗村烟。\n犬吠花间径，人锄屋后田。\n不知身异域，疑对武陵仙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3116,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南巡纪事 其二","author":"杨二酉","text":"扁舟溪水上，遥见此山痕。\n一脉仍通海，千峦何处根。\n云封傀儡社，竹护夕阳村。\n川岳东南尽，群灵拱至尊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3117,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南巡纪事 其三","author":"杨二酉","text":"问俗来番社，青葱曲径长。\n家家茅盖屋，处处竹编墙。\n牵手葭笙细，嚼花春酒香。\n知能但耕凿，真可拟羲皇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3118,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南巡纪事 其四","author":"杨二酉","text":"罗汉云中塞，天关第一重。\n林幽深踞虎，潭静隐蟠龙。\n马辟芦间道，塘虚竹外烽。\n鸟鸣讶行色，同出翠微峰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3119,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕耤 其一","author":"杨二酉","text":"连畴宿雨润如膏，太守亲推湿锦袍。\n犁破碧云开万顷，自今岁有属贤劳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3120,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕耤 其二","author":"杨二酉","text":"布谷声齐遍海东，夜来时雨兆年丰。\n遥知捧日云多处，天子躬耕千亩中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3121,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"东郊迎春 其二","author":"齐体物","text":"春自蓂阶发，趋跄鹓鹭行。\n明堂居左个，青玉祀勾芒。\n耒耜先民力，羲和驭日长。\n微臣天万里，何以颂陶唐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3122,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"喜雨","author":"齐体物","text":"隐隐西郊外，屯云渐彻天。\n欲为民望岁，正喜雨归田。\n乐且从人后，忧宜自我先。\n试看阡陌上，禾黍已芃然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3123,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"祷雨","author":"齐体物","text":"虽惭抚字拙，忧国愿年丰。\n苦魃方思雨，瞻云忽见虹。\n几家堪食玉，此日更无风。\n斋沐桑林下，惟祈格上穹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3124,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"恭纪惠献贝子王平定浙闽功迹颂言","author":"刘良璧","text":"大业疏天派，肤功列上班。\n龙旂开敌垒，虎竹贲仙关。\n浪静平瓯越，烽晴靖海蛮。\n朱甍辉玉钥，碧甃灿金环。\n谟烈青编著，贤良紫诰颁。\n勋名萦两浙，世泽衍三山。\n颂溢鳌峰上，讴兴鹿岛间。\n东南槎万里，长此奉王颜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3125,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"沙辘行","author":"刘良璧","text":"晓出彰山北，北风何凄凉。\n晚入沙辘社，社番何踉跄。\n十年大甲西，作歹自惊惶。\n牛骂及大肚，挺而走高冈。\n蠢尔无知番，奋臂似螳螂。\n王师一云集，取之如探囊。\n忆此沙辘社，先年未受创。\n王丞为司马，抚绥得其方。\n孙公为副臬，恤赏不计量。\n为言北路番，无如沙辘强。\n马牛遍原野，黍稷盈仓箱。\n麻踏如飞健，牵手逞艳妆。\n倘为千夫长，驭之楫疆场。\n张弓还挟矢，亦可壮金汤。\n奈何逢数奇，职守失其纲。\n劳役无休息，铢求不可当。\n穷番计无出，刳肉以医疮。\n支应力不给，势促乃跳梁。\n一朝分箭起，焚杀自猖狂。\n蛮声振半线，羽镞若飞蝗。\n调兵更遣将，荡平落大荒。\n危哉沙辘社，几希就灭亡。\n皇恩许迁善，生者还其乡。\n番妇半寡居，番童少雁行。\n嗟乎沙辘番，盛衰物之常。\n祗今防厅廨，荒烟蔓道旁。\n造物宁恶满，人事实不臧。\n履霜坚冰至，易戒恶可忘。\n夜深风飒飒，独坐思茫茫。\n司牧人难得，惘然太息长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3126,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赪桐花限龙字","author":"六十七","text":"枝柔叶厚碧痕浓，色艳还看花发重。\n朱萼临风迷紫蝶，丹须和露抱黄蜂。\n剪残红锦枝头见，敲碎珊瑚月下逢。\n好是年年誇竞渡，鲜妍如火映鱼龙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3127,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尸位学署岑寂无聊泛泛随流迹近渔父每有闻见辄宣讴咏因名瀛涯渔唱 其十六","author":"朱仕玠","text":"蒌叶包灰细嚼初，何殊棘刺强含茹。\n新秋恰进槟榔枣，两颊浮红亦自如。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3128,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"七月一日宴七里香花下作 其一","author":"范咸","text":"唐昌玉蕊无踪迹，后土琼花再见难。\n官阁独馀春桂影，婆娑长得月中看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3129,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"七月一日宴七里香花下作 其二","author":"范咸","text":"小叶荼蘼一丈馀，花开五出袭琼琚。\n生怜青琐无消息，难觅吹箫紫凤车。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3130,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"七月一日宴七里香花下作 其三","author":"范咸","text":"琼台原不在人间，素艳何来绿玉鬟。\n长见蕊珠宫里雪，只缘地近补陀山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3131,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"七月一日宴七里香花下作 其四","author":"范咸","text":"聚仙也合依稀似，玉质秾香总不同。\n欲向通明上封事，弹文先斥妒花风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3132,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"七月一日宴七里香花下作 其五","author":"范咸","text":"幸留七里香名在，认取山矾为写真。\n寄语世人休聚讼，冰姿原不藉前尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3133,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"七月一日宴七里香花下作 其六","author":"范咸","text":"瀛壖合是洞仙家，宴赏贪看玉树花。\n赋罢新诗消受得，春风何处七香车。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3134,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"扶桑花 其一","author":"范咸","text":"祇是江乡木槿花，千重照殿炫红霞。\n生来不遇繁霜雪，秾艳经年向客誇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3135,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"扶桑花 其二","author":"范咸","text":"桃腮杏脸衬朝霞，那信红颜薄命嗟。\n两树新妆争睹胜，老夫无月不看花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3136,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"荔枝 其一","author":"范咸","text":"绛罗衫子雪肌肤，一种香甜绝胜酥。\n消渴液寒青玉髓，脱囊盘走水晶珠。\n阿环风味差堪拟，卢橘芳名亦少殊。\n饱啖拚教烟爨绝，不辞人唤作狂奴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3137,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"荔枝 其二","author":"范咸","text":"江家色绿宋家红，曾识端明谱牒中。\n到此得尝过玉食，无劳想象判丹枫。\n诗才漫说穷骚雅，兴味犹应傲上公。\n万事灰心殊不恶，只愁海飓阻筠笼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3138,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"莲蕉 其一","author":"范咸","text":"奇花多变态，颜色红于火。\n风物类海南，不似莺花妥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3139,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"莲蕉 其二","author":"范咸","text":"已长叶中花，更生花上叶。\n我欲剥蕉心，酒痕映双颊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3140,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"美人蕉","author":"张湄","text":"亭亭清影绿天居，扇暑招凉好读书。\n怪底弹文出修竹，美人颜色胜芙蕖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3141,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"昙花","author":"张湄","text":"采自猊床象座前，紫霞一片映青莲。\n优昙不是人间种，色相应归忉利天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3142,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"贝多罗花","author":"张湄","text":"奇英六出干三叉，檐卜香中嗅露华。\n曾识僧龛写经叶，而今始见贝多花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3143,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"枣子槟榔","author":"张湄","text":"丹颊无端生酒晕，朱唇那复吐脂香。\n饥餐饱嚼日百颗，倾尽蛮州金错囊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3144,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"檨","author":"张湄","text":"参天高树午风清，嘉实累累当暑成。\n好事久传番尔雅，南方草木未知名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3145,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"波罗蜜","author":"张湄","text":"清果菩提绕室馨，金包柑橘丽繁星。\n更怜斗大波罗蜜，磥砢真同佛髻青。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3146,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"绿珊瑚","author":"张湄","text":"一种可人篱落下，家家齐插绿珊瑚。\n想从海底搜罗日，长就苔痕润不枯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3147,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"九日即景","author":"王云鹏","text":"千古无如此地秋，重阳佳气满空浮。\n山围大海波涛壮，天迥平原岛屿幽。\n八景风云开石壁，七闽烟雨锁沧洲。\n茱萸系臂成何事，记取枫林集旧游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3148,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台阳八景","author":"余文仪","text":"西屿丹霞可乐饥，海波摩荡日崦嵫。\n轩轩顾影谁能举，冉冉登台或有期。\n十色五光萦彷佛，宋车鲁马更离奇。\n分明一幅鹅溪绢，界画云烟李伯时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3149,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台阳八景","author":"余延良","text":"散绮依稀天半晴，却从西屿望分明。\n轩轩欲举翻斜照，目送高标下赤城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3150,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"初到澎湖歌","author":"吴性诚","text":"新秋来澎岛，风挂紫澜旌。\n又击中流楫，孤帆一叶轻。\n天际微云抹，列屿睹峥嵘。\n莲花开瓣瓣，形势极纵横。\n三十有六岛，荷盖田田擎。\n又如排衙状，拱卫自天成。\n民贫缘土瘠，凋攰每呼庚。\n昔时人古朴，无怀葛天并。\n祗今渐偷薄，诪张幻蚩狞。\n砂碛鲜稻麦，粱粟种高坪。\n秋肥蒜脑薯，饔飧啜其羹。\n花无好桃李，草无香杜蘅。\n珍罕荔杏果，谁识橘与橙。\n不闻云叫雁，不见柳藏莺。\n衔泥渺紫燕，布谷绝鸧鹒。\n所产惟白鸠，雪羽照霜翃。\n四面枕浩瀚，波涛淜湃声。\n人家田是海，缯网夕阳桁。\n蟳蠘鲎海月，琐管螺蛤蛏。\n瑶柱西施舌，鲑菜几案呈。\n龙肠龙虱类，水族万千萦。\n男女竞采捕，鲜薧供饪烹。\n乾坤浮烟雾，日月失阴晴。\n台飓巽二烈，昼夜雷轰轰。\n天鼓挟鼍吼，魂梦骇怦怦。\n怒潮掀白马，地轴翻鳌鲸。\n舟帆来往断，缓急阻水程。\n忽然霏卤霰，海雨洒低薨。\n沾衣黴黕黮，嘉种萎叶茎。\n风土殊恶劣，士女半伧儜。\n四宅既已隩，抚字慎权衡。\n强宗思拔薤，芟刬搜棘荆。\n鞭蒲戒微眚，教勉先父兄。\n颠连岂隔膜，痛痒切孩婴。\n东南雄锁钥，半壁天外撑。\n萑苻防恣肆，重镇卫以兵。\n楼船频下濑，不坐细柳营。\n朝廷设文武，部署规模宏。\n所贵冰渊懔，夙夜惟励精。\n敢恋黄紬被，放衙动讥评。\n代庖笑越俎，缇油荷宠荣。\n别乘传车至，儿童竹马迎。\n何以报知己，何以慰苍生。\n不网珊瑚树，休贪金满籯。\n喜逢秋正熟，蔀屋乐丰荣。\n公堂跻朋酒，蔼蔼纷兕觥。\n狂澜回砥柱，波不扬匉訇。\n苍茫云水阔，无复哀鸿鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3151,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"看月 其一","author":"吴性诚","text":"沧溟万里动清光，天水涵虚挹渺茫。\n看到圆时圆便好，入从圆处见情长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3152,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"看月 其二","author":"吴性诚","text":"夜静空庭倩月陪，冰壶朗澈照蓬莱。\n平生笑杀吴刚斧，仙桂高枝砍不来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3153,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"留别 其一","author":"吴性诚","text":"留别嫌无长物存，萧然行李去荒村。\n多情惟有沧州月，千里清光照海门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3154,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"留别 其二","author":"吴性诚","text":"我本迂疏旧楚狂，雪泥鸿爪印他乡。\n自惭不系苍生望，祇有冰心照此方。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3155,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"留别澎湖诸生","author":"吴性诚","text":"风尘俗吏老书生，击楫沧溟历几更。\n到此颇惭为政拙，去时深愧好官名。\n三秋仙岛看云幻，五日廉泉饮水清。\n惟有弦歌忘未得，旗亭诗酒送人行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3156,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"澎湖九日登高 其二","author":"吴性诚","text":"天际微云一抹青，石衔精卫满烟汀。\n波喧鼍鼓潮声息，风过鱼梁水气腥。\n戏马呼鹰空有恨，求仙采药恐无灵。\n忘情名利身还健，不饮茱萸酒独醒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3157,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"澎湖九日登高 其四","author":"吴性诚","text":"管领秋光倍豁然，气吞云梦水连天。\n乾坤浩落中流楫，日夜苍茫外海船。\n眼阔壮游五岳后，心娱奇胜十年前。\n江乡兄弟登高处，好景当凭雁字传。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3158,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"澎湖九日登高 其五","author":"吴性诚","text":"书剑萧然吏隐兼，因风落帽正无嫌。\n丹枫乌桕三山渺，碧海青天万里黏。\n瑚长可知非网密，珠还未必是官廉。\n钓鳌莫下任公饵，向若徒惊白发添。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3159,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"澎湖九日登高 其六","author":"吴性诚","text":"荒烟瘴雨簇哀鸿，杼轴愁吟大小东。\n破屋柴扉寒日闭，薄田秋薯熟年丰。\n何曾鸡酒联高会，却把鸢鱼放远空。\n便是龙山情景好，也应蒿目对西风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3160,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"谕戒书役口号 其一","author":"吴性诚","text":"海岛仙居正渺茫，蓬山初到祇寻常。\n嚣凌词讼人心坏，荦确园丘地面荒。\n拔薤不嫌探虎穴，鞭蒲惟欲靖龙堂。\n此间土薄难栽树，憩茇曾无召伯棠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3161,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"谕戒书役口号 其二","author":"吴性诚","text":"蚩氓鼠雀太纷纷，官吏须将黑白分。\n祇任冰心为主宰，但逢木偶亦神君。\n判防歧误休濡笔，情得哀矜莫舞文。\n案牍是非明镜朗，讼庭花落映祥云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3162,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"谕戒书役口号 其三","author":"吴性诚","text":"修行端底属公门，阴德须留到子孙。\n头上青天休便问，眼前黑狱不堪言。\n蠹名风播豺当道，苛政人惊虎入村。\n好语吏胥均记取，等閒莫结再生冤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3163,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"谕戒书役口号 其四","author":"吴性诚","text":"煌煌府帖速传呼，白叟黄童一例拘。\n火失城门鱼已烂，榛收谷口蕙先枯。\n公庭未到心情乱，讼牍才消儋石无。\n兹惠我惭民父母，尔曹何事嚇乡愚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3164,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赠建侯吕翁即以志别 其一","author":"吴性诚","text":"新安南渡到东瀛，雌伏荒隅一老生。\n钁铄精神閒杖履，逍遥岁月寄琴筝。\n布衣酒遣山人兴，海国诗传处士名。\n投赠锦囊俱好句，监门从此重侯籯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3165,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赠建侯吕翁即以志别 其二","author":"吴性诚","text":"到来何处访神仙，却有诗人彩笔传。\n我为耽吟须断矣，翁因索句鬓苍然。\n但忻张野投三影，差胜刘郎选一钱。\n此别匆匆留不住，天涯鸿爪笑缘悭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3166,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"天台远眺","author":"吕成家","text":"突兀天台耸碧空，恰宜远眺辨西东。\n放开眼界群峰小，展扩襟怀万派通。\n半幅云笺封远岫，一行雁字窎秋风。\n登临逸兴游仙景，缥缈虚无一望中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3167,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"太武樵歌","author":"吕成家","text":"回环太武迥嵯峨，樵采行行唱浩歌。\n韵绕高峰流旷野，声喧绝壑度平坡。\n檐头日暮孤云伴，林外烟晴一鸟过。\n最好澎山饶逸兴，重开仙曲奏如何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3168,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"次吴厅尊留别原韵 其一","author":"吕成家","text":"琴鹤翛然雅化存，口碑舆诵满荒村。\n去时留得鱼悬屋，一棹清风到鹿门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3169,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"次吴厅尊留别原韵 其二","author":"吕成家","text":"力挽回澜不敢狂，人耕绿野水云乡。\n为霖已慰苍生望，白露苍葭天一方。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3170,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]