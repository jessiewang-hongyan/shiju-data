[{"title":"雨中花•题襄阳署壁","author":"董以宁","text":"案上新诗数种。\n窗外轻烟一捧。\n午后浓阴，白云骀荡，遮得山无缝。\n小摘草花聊作供。\n不比江南春仲。\n看红紫全稀，燕处荒巢，犹做雕梁梦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42732,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"河传•秋夜寓鹫峰书院","author":"董以宁","text":"月小。\n云绕。\n烟丝如袅。\n银湾如晓。\n点兰缸。\n理书床。\n人悄。\n月光惊宿鸟。\n怜此夜传梅信杳。\n闺中少。\n空寄文无草。\n掷离觞。\n煮梅香。\n他乡。\n衾寒觉夜长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42733,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨中花•幼小","author":"董以宁","text":"幼小未将情字省。\n偶向着、养娘閒问。\n道有游郎，曾报香帕，不识他因怎。\n见得养娘微一哂。\n却半晌、低头自忖。\n再记游郎，重看香帕，满面都红沁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42734,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"河传•题美人早起图","author":"董以宁","text":"小扣。\n轻袖。\n衣香堪嗅。\n推郎先起，再添红兽。\n为问荼蘼开否。\n拈花先浴手。\n学梳时髻疑偏堕。\n菱花座。\n侧处疑添个。\n步蕉房。\n对碧窗。\n檀郎。\n看侬新样妆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42735,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天•冬夜","author":"董以宁","text":"欲与欢言碍小姑。\n捏欢臂上问寒无。\n由他灯火馀昏穗，推着衣裳过暖炉。\n交膝语，拍肩呼。\n欢言低处便含糊。\n小姑佯做痴呆态，故把欢言细问奴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42736,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹊桥仙•寄贺华子瞻花烛","author":"董以宁","text":"催妆客到，卖花人到，都说何郎如粉。\n兰缸焰里乍偷看，几欲赐、闺中汤饼。\n呼郎新字，怪郎新字。\n抄袭眉山因怎。\n鸳鸯社里面分题，才信道、才名相称。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42737,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜行船•本意","author":"董以宁","text":"青雀舟来新水泻。\n正怀人、嫦娥欲下。\n慧山浜里，黄埠墩前，游子最宜今夜。\n邻舫蝉纱窗亚亚。\n风过处、微闻兰麝。\n又还听说，月华将近，多半倚栏看也。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42738,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分钗•闺情","author":"董以宁","text":"人如玉。\n腰如束。\n樱桃红溅裙儿幅。\n写些评。\n诵些听。\n步韵难工，险韵难成。\n生。\n生。\n鬟低绿。\n眉低促。\n吹箫又下屏风曲。\n别时盟。\n见时情。\n呼侬有字，唤汝无名。\n卿。\n卿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42739,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"苏幕遮•索香","author":"董以宁","text":"燕笼涎，萦鸭篆。\n小袖微笼，心字春衫暖。\n还恐骤烟吹隔苑。\n微湿蓉丸，许久烧才半。\n为儿郎，述别院。\n索得宫香，纤手拈来颤。\n一点心肠终是软。\n拜月还求，薄倖心儿转。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42740,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"扑蝴蝶•咏蝶","author":"董以宁","text":"舞态蹁跹，自小生香国。\n浑身腻粉，爱向花前宿。\n每因径曲来迟，更为墙低去速。\n学尽颠狂轻薄。\n难拘束。\n庄生晓梦方足。\n应许狂奴续。\n影儿犹好，到处教相逐。\n钗梁贴处交飞，裙衩拖时对簇。\n胜拓滕王一幅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42741,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"恩爱深•瞥遇红绫幛","author":"董以宁","text":"萧寺初留，盼年纪花稍上。\n留仙体态，相违一晌。\n到得而今，罗敷已嫁应难傍。\n瞥遇红绫幛。\n似曾相识，费侬端相。\n休到青陵台上望。\n侬自有明珠，不便殷勤投向。\n无可致区区，小槎空在明河漾。\n但把三生忏，何用问朱楼，起居无恙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42742,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜红衣•楚中午日同赋","author":"董以宁","text":"笑折葵枝，閒供蒲韭。\n更是榴花，掩映芳菲，红却樽中酒。\n门悬桃印，正窗外、黄鹂鸣昼。\n三斗。\n斟罢高歌，不觉肠回九。\n綵舟竞渡，丝楝投河，胜事年年有。\n况是鄢陵江口。\n还怜否。\n须信当年此日，罗水骚人心疚。\n到而今翻做，浮白赏花时候。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42743,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"满江红•酒酣歌","author":"董以宁","text":"一簿金兰，再休教、香烟零落。\n有尔我、诗坛豪放，觞歌激烈。\n不合时宜肺腑共，尽抛礼法才情各。\n到酣馀、浮白更酹予，予曰诺。\n君未去，情堪托。\n君欲去，情离索。\n念知交如此，良云不恶。\n苏大风流都自许，杜陵年少须行乐。\n到更深、扶醉且辞予，予曰莫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42744,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丁香结•作天上官词十六首。序之以词","author":"董以宁","text":"新寓人间，故乡天上，我梦恰才归去。\n看琪花玉树，閒指点、说是旧游之处。\n仙风吹下后，依旧向、海尘中住。\n猛看墙角，月光如水，嫦娥不语。\n多虑。\n虑天上修文，除我更无佳句。\n欲制红词，频催青火，湿萤难聚。\n借得邻家小照，随意抽诗绪。\n似空中传旨，上帝赐卿金箸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42745,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"月华清•赋得「寒气逼人眠不得，钟声催月下回廊」，本宫人题壁句也","author":"董以宁","text":"十二调筝，十三结绣，闻道广寒宫远。\n才得到内家金屋，御前亲选。\n小名儿、挂在前头，凝盼着、中涓呼唤。\n依恋。\n望巷边竹叶，羊车冉冉。\n底说玉环红汗。\n奈支持瘦骨，花寒欲颤。\n方信广寒，只在鱼镮深院。\n猛听却、五凤楼钟。\n刚催到、嫦娥相伴。\n清怨。\n问守宫砂在，几时能换。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42746,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双头莲•荷花池上为友人记忆往事","author":"董以宁","text":"曲水娇荷，是向日芳姿，采香曾寓。\n隔墙漫觑。\n怜宋玉无奈，心头长贮。\n故拨弦索三条，倩冰丝传语。\n花暗处。\n绢裹秦珠，投伊更无情绪。\n闻道薄倖狂生，向鸳鸯社里，铜舆重娶。\n抛将雁柱。\n将往事、竟做一池风絮。\n别向念四桥头，觅吹箫佳侣。\n真堪怅、锦瑟床边，玉人已去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42747,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"喜迁莺•江口有感和章无恤","author":"董以宁","text":"回肠九折。\n正我问青天，君歌白雪。\n吞吐江潮，低徊画艇，分写吟笺几叶。\n护说放怀依旧，不禁伤心畴昔。\n望处见，钟陵初造，将军孙策。\n悲咽。\n君不见，吊古留题，拓遍金山壁。\n点缀烟涛，横吹芦荻，唤到弓腰初月。\n还问千年寒照，曾见几朝兴灭。\n停舟处，有残山剩水，不堪评阅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42748,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题三游洞","author":"林旭","text":"闭门不看宜州山，临去还来访窟颜。\n聊欲向僧寻枕簟，溪轩暂卧听潺潺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42749,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨花","author":"黄任","text":"行人莫折柳青青，看取杨花可暂停。\n到底不知离别苦，后身还去化浮萍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42750,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宿张侯府幼莲师在殡","author":"林旭","text":"巡视空堂阅月移，依稀曾是别师时。\n半年行役思心切，一恸空来侍疾迟。\n绝学千金成岂见，人生三釜洎犹悲。\n但凭雨夜彭城感，试为探寻满箧诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42751,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南闹市口小寓","author":"林旭","text":"二月长安键户眠，几多情绪放还牵。\n宁知车马喧喧度，只听风光晼晼迁。\n白发四娘闲自得，朱笼百舌巧谁怜。\n夭桃秾李皆同院，寂寞无言伴枉然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42752,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"新济轮船逢绩九丈和予宿侯府诗感其辞犹哀更答之","author":"林旭","text":"先生白发不鬖鬖，心绪千头老弗戡。\n失第尚羞行卷谒，无官终被小儿惭。\n天涯旅食惟身赖，海上相逢各泪含。\n我是哭师君悼友，此情可许别人谙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42753,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闵月湖荷花同游为林昭通绍年","author":"林旭","text":"月湖六月南风吹，红裳翠盖浮涟漪。\n昔闻其语今见之，眼前反复人得知。\n壮夫腰镰方纵意，渔夫拿舟自垂泪。\n哀哉斩艾不自保，纷纷载去如束稿。\n风水之说讵有凭，邦人波靡诚可憎。\n花神伉爽诉炎帝，妖气天阍反见挤。\n苍苍岂必矜君子，我怼祸端由自取。\n中通外直得之性，蒲稗虽多何足竞。\n一朝谗口巧中伤，坐令丧气及群芳。\n藏山居士倘见此，为尔痛苦摧肝肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42754,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宜昌城南有汉景帝庙","author":"林旭","text":"城南汉景祠，郁郁依大栗。\n婆娑舞巴童，迎神激清瑟。\n普土皆王臣，瘴陕犹荐苾。\n惟王禘其祖，礼先所自出。\n郡国奉禋祀，我疑章武日。\n孔明礼乐材，斟酌得疏密。\n儒生许孟辈，会议想奋笔。\n惜哉无史官，宪章坐散逸。\n罘罳此仅存，取證谅难必。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42755,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"暑夜泛姜溪诗 其一","author":"林旭","text":"清溪十里几多盘，收束将穷却放宽。\n山要拦人拦不住，侧身让过乞人看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42756,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"暑夜泛姜溪诗 其二","author":"林旭","text":"击汰声齐力未孱，扁舟催进几湾湾。\n我们冠者偕童子，只有崧师束手闲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42757,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"暑夜泛姜溪诗 其三","author":"林旭","text":"大家莫把桃源说，那有仙源到两回。\n昨日好山撑不近，明宵须换小船来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42758,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"暑夜泛姜溪诗 其四","author":"林旭","text":"桥柱孤栽细石平，相将上去卧纵横。\n不防山贼防洋鬼，犬吠儿啼锣乱鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42759,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"暑夜泛姜溪诗 其五","author":"林旭","text":"本来沙路有人行，溪水长干江水平。\n过去中元游十日，中秋毛水月空明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42760,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"节庵来江南久不见作长句代简并讯叔峤三丈","author":"林旭","text":"街头大雪一尺馀，相思不见不怨渠。\n先生东门种茹藘，悠然不异山中居。\n忧时百年弗一摅，却缘病起心眼舒。\n行将徙宅通明车，载来家具一半书。\n可许借读资抄胥，南村舍人复何如，西山载酒宁忘诸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42761,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"北行杂诗 其一","author":"林旭","text":"杨村一夜雨，张湾三尺泥。\n向来戎马迹，能畏鹧鸪啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42762,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"北行杂诗 其二","author":"林旭","text":"东风复北风，广野号众窍。\n岂无白日光，吹土翳清昼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42763,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"北行杂诗 其三","author":"林旭","text":"屯幕临官道，柳阴卧橐驼。\n莫将笳鼓竞，空唱天山歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42764,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"北行杂诗 其四","author":"林旭","text":"客店骡马滚，公徒何振振。\n皆言防帝畿，那复愁行人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42765,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"北行杂诗 其五","author":"林旭","text":"绝似乌龙潭，陂池相映带。\n可惜好西山，蹉跎斜阳外。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42766,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"北行杂诗 其六","author":"林旭","text":"道旁千万柳，能作几多春。\n明岁还如此，行人非去年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42767,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"叔峤印伯居伏魔寺数往访之","author":"林旭","text":"窗外丁香玉雪色，窗下两生坐太息。\n可怜太息空为尔，舍人县令官秩卑。\n朝出空遮御史车，莫归还草相公书。\n宗庙神灵三百春，即今将相未无人。\n言战言守言迁都，三十六策他则无。\n深宫追念前朝痛，根本关中敢轻动。\n掷鼠忌器空迟疑，喂虎割肉有尽时。\n书生不自有科第，能为家国作么计。\n东家翰林尽室避，犹闻慷慨排合议。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42768,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"约游西山会文学士宅闻和议成学士愤甚余辈亦罢去","author":"林旭","text":"都言踏破西山石，我望西山势不行。\n争怪忧时文学士，但看烟翠亦何情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42769,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"旭庄四丈公事往汉口有诗留别 其一","author":"林旭","text":"莫遣吟诗鼻易酸，客怀好逐看江宽。\n居人犹觉心情恶，六月西风雨作寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42770,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"旭庄四丈公事往汉口有诗留别 其二","author":"林旭","text":"晴川虚阁记峥嵘，未忘将军醉客情。\n略述前游发长叹，应知芳草绕阶生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42771,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"旭庄四丈公事往汉口有诗留别 其三","author":"林旭","text":"月湖荷花千顷生，摧残人岂是无情。\n凭君为勘今年状，他日还书寄一声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42772,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感秋","author":"林旭","text":"清晨负手行，蟋蟀鸣我门。\n因知秋气厉，感此流年悲。\n病夫日掩户，一月不窥园。\n颇闻梧桐树，飘叶聚其根。\n岁寒皆黄落，而汝胡为先。\n我将种长松，不与时推迁。\n小庭数盆花，青青亦堪怜。\n但觉凄清意，莫向西风前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42773,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病起漫书 其一","author":"林旭","text":"耳目与口鼻，不思何录录。\n苟能得其养，心亦即快足。\n四者彼何知，惟心实有欲。\n所以养心者，必先此四族。\n愚奢厚自奉，反以滋垢黩。\n一鸟能遗音，岂必奏丝竹。\n一花可慰眼，岂必陈绮縠。\n诵诗味芬芳，闻香气清淑。\n领略信靡穷，我亦能我慉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42774,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病起漫书 其二","author":"林旭","text":"病后关门趣自深，天明即起似游禽。\n食单寂寞添乡思，诗句颓唐趁倦襟。\n检点旧书看复放，商量佳客遣相寻。\n更欣秋月光辉足，不惜窥窗夜夜临。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42775,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"效太夷丈","author":"林旭","text":"松生依涧谷，上为干霄枝。\n摇落尚不与，繁华岂尝知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42776,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感事","author":"林旭","text":"昔人治国戒察察，黈纩塞耳冕前旒。\n聪明蔽远不蔽近，肘腋往往藏奸谋。\n水清无鱼信所鉴，网漏吞舟亦可忧。\n贤人君子常不悟，一朝负败为身尤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42777,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"八月十五夜呈陈冯庵","author":"林旭","text":"今宵月慰一年意，滂沱溃作秋光曼。\n中庭桂树亦何有，珩格交横杂藤蔓。\n无言清影自徘徊，便觉玉阶寒未逊。\n幽居兀兀忘时日，佳即读书饥呼饭。\n偶然吟咏但自适，冯庵老人论契券。\n轻狂值得病魔讶，稍稍去之不馀慁。\n感渠夜夜来窥寻，为洗从前幽独恨。\n应须一字论一缣，始抵婵娟价千万。\n老人老去诗律细，渐有少年笑才钝。\n我今此事当推谁，立待挥毫宁用巽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42778,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"索桂花家人不与 其一","author":"林旭","text":"诚斋诗句要商量，尽道春花艳未强。\n谁识维摩病居士，不应闻取木樨香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42779,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"索桂花家人不与 其二","author":"林旭","text":"瓶里花空意自存，节庵惩毖手书烦。\n谁人怜我双眸倦，推出天边白玉盆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42780,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"与方慕寒","author":"林旭","text":"我始就傅出，君实连墙居。\n同年一月小，共学兄弟如。\n先生君长兄，爱我常并誉。\n太翁白发健，携我坐床敷。\n分甘预一割，锦绅再拜趋。\n不见八九载，谁谓同州闾。\n乐群日可数，在远迹愈疏。\n言念小秦君，欲从治汉书。\n今我不强学，殖落殆成樗。\n见日抚手忭，口呿穷须臾。\n闻君秋当婚，孟姜玱琼琚。\n登高夥新诗，缘情故自殊。\n风流老司马，厚子意有馀。\n放衙接佳语，探怀出明珠。\n悢悢身万里，藉问何止疋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42781,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄题宜昌姜孝岩涛园外舅所作亭子","author":"林旭","text":"梦见孝岩萝树青，偃松闻已化龙形。\n宜州今日添新语，一郡游人上沈亭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42782,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重九出游既夕泛舟秦淮见月 其一","author":"林旭","text":"佳节心随物色摇，出门四望未萧条。\n新霜红尽冶城树，商略独游畏路遥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42783,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重九出游既夕泛舟秦淮见月 其二","author":"林旭","text":"人闲别自有婵娟，平视谁曾见月圆。\n与我共安喧里寂，更无人赏亦翛然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42784,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重九出游既夕泛舟秦淮见月 其三","author":"林旭","text":"病发丝丝随叶落，客怀漠漠借船眠。\n镜中原著通明我，多事看成彻两边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42785,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"逃席","author":"林旭","text":"逃席原无仇饷情，向来意兴实纵横。\n登楼自借清宵赏，不饮甘当恶客名。\n虫穴书明骄月亮，鸟摇林动误风生。\n归途此物犹堪念，塘水荒寒野蛤鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42786,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"堂子巷郑七丈宅小楼","author":"林旭","text":"东山暮霭堆沈墨，西崦残霞画赭黄。\n并入小池两边色，分明图画画难详。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42787,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九月十六日雪和冯庵","author":"林旭","text":"玉琢参差衔瓦明，风吹块重坠还轻。\n不逢闰岁交东节，若话家山感客情。\n墙下空尊眠自冷，阶前残菊压都倾。\n道人缩手看难足，却笑冰寒镂不成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42788,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"是日寒甚 其一","author":"林旭","text":"中庭滴沥雨交并，虚室来风色更瑩。\n却忆谁家楼上好，稍晴要看玉峥嵘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42789,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"是日寒甚 其二","author":"林旭","text":"鼻涕知寒拭更流，团蒲曲几道相谋。\n虽从羔酒求风味，空废持螯数日游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42790,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"节庵送钟山书院祭肉赋谢","author":"林旭","text":"无由陪祭从门生，逮贱分尝感盛情。\n一一斯文斯道寄，有神尚冀锡聪明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42791,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"太夷丈属和其移居诗逾岁乃呈一绝","author":"林旭","text":"窗前种树经年活，舍后栽花近水便。\n占著清溪如谷口，百般忙里作神仙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42792,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"张园梅花","author":"林旭","text":"张家园里数株梅，岁岁相逢总盛开。\n花上盈盈歌一阕，风前艳艳酒千杯。\n方波照影知谁见，斜日攀条却独来。\n眼底风光浑不是，一回思念一回灰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42793,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"无题","author":"林旭","text":"海上今年二月寒，出门何地有花看。\n思先清晓车轮转，意共黄昏烛本阑。\n世界愁风复愁雨，肝脾为苦亦为酸。\n东邻巧笑频相讶，倚柱哀吟故未宽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42794,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]