[{"title":"浣溪沙","author":"许德蘋","text":"漠漠烟霏晚更浓。\n楼台金碧日融融。\n秋千架冷一丝风。\n梅子黄时金错落，芭蕉绿处影蓬松。\n杜鹃催放映山红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24635,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"许德蘋","text":"千尺寒潭深复深。\n桃花影与夕阳沉。\n何心起弄断纹琴。\n紫燕穿残花寂寂，黄鹂叫碎月阴阴。\n无聊怎得把愁禁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24636,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"许德蘋","text":"东风暗送春晴早。\n催开绣谷群花好。\n犹作拗春寒。\n怕春容易残。\n不知天意是。\n恼得人心醉。\n迷迭几回烧。\n魂消恨不消。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24637,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"许德蘋","text":"门前杨柳消残碧。\n狂风吹得枝头直。\n耐冷到天明。\n推窗飘雪轻。\n愁心随滴漏。\n街静闻刁斗。\n欲见个人难。\n连宵梦也寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24638,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"许德蘋","text":"黄金滴溜钗头雀。\n秋来双鬓云飞薄。\n倚榻绣芙蓉。\n一灯花影重。\n鸡鸣窗色曙。\n懒织回风苣。\n瘦骨不胜衣。\n横琴待鹤归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24639,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"丑奴儿","author":"许德蘋","text":"月明穿户窥人悄，瘦损容光。\n暖贴银簧。\n为有山花斗艳妆。\n小窗寂寞兰薰静，日透衣香。\n寄语仙郎。\n珍重新秋一味凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24640,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"诉衷情","author":"许德蘋","text":"春光黯淡放春迟。\n留得好花枝。\n一壶清酒，与花共醉，须待人归。\n花默默，柳依依。\n眼低垂。\n更看佳景，更咏新诗，更待它时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24641,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"好事近","author":"许德蘋","text":"数到落梅风，枝上尚留残雪。\n应记玉人攀处，正阳春佳节。\n太湖石畔任欹斜，浓香渐吹灭。\n拈笔欲题新句，奈晓鸣鶗鴂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24642,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐 梅","author":"许德蘋","text":"梅花香里。\n熏染东风醉。\n天放梅花天有意。\n枝上露珠凝泪。\n横斜绿水之涯。\n偏惊暗度韶华。\n又见玉人攀折，帽檐亲插疏花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24643,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南唐浣溪沙","author":"许德蘋","text":"未有新诗答岁华。\n愧无人把碧笼纱。\n唤婢还将梅水煮，试新茶。\n竹韵松声都淡雅，山光水色亦清佳。\n墙外一枝娇欲语，碧桃花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24644,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"添字采桑子 芭蕉","author":"许德蘋","text":"芭蕉本是寻常种，绿满空庭。\n绿满空庭。\n雨雨风风、不觉动人情。\n窗纱映处题诗遍，一片声清。\n一片声清。\n最怕残更、和漏几回听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24645,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"武陵春 春晚","author":"许德蘋","text":"花事阑珊春已了，人倚翠楼头。\n往日思量今日休。\n溪水自东流。\n溪上桃花无处觅，空拟逐渔舟。\n便有瓜皮一叶舟。\n怎载得、惜花愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24646,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醉花阴 九日","author":"许德蘋","text":"绿绮调弦消静昼。\n甲煎添香兽。\n枫叶几重重，一夜相思，染得猩红透。\n茱萸插遍登高后。\n引好风吹袖。\n只为暗悲秋，人比山容，也带三分瘦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24647,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南歌子","author":"许德蘋","text":"竹径凉风袭，莲房晓露垂。\n新过小雨带烟滋。\n卧听朝来、风讯倍凄其。\n砌畔葵心冷，堤边柳发稀。\n渐添酒债渐添衣。\n一样帘栊、不似艳阳时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24648,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"怨王孙 春暮","author":"许德蘋","text":"小院静悄。\n残花暗恼。\n一片春阴，雨昏雾晓。\n天际远见飞红。\n恨狂风。\n黄鹂啼近山深处。\n来又去。\n此意终孤负。\n一株寂寞，相对黯淡梨云。\n斗文君。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24649,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"怨王孙 春暮","author":"许德蘋","text":"绣骑归晚。\n深沉梨院。\n袅袅游丝，罥花不断。\n春去芳信初传。\n柳生绵。\n情人易被情牵惹。\n何曾舍。\n未醒愁春也。\n江城一片，红雨恨煞风斜。\n尽飞花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24650,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"怨王孙 赏荷","author":"许德蘋","text":"波影澄澄天渺渺。\n花似笑、剧怜年少。\n文鸳戏浴水西东，恁识得、花中好。\n江上晚红香梦老。\n相映处、斜阳芳草。\n漫天凉露逼衣单，已报道、秋来皂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24651,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卖花声","author":"许德蘋","text":"楼角酒旗风。\n吹起春踪。\n把杯愁散古今同。\n树上辛夷舒木笔，笔笔书空。\n江上数云峰。\n著处情浓。\n一番心事有无中。\n写恨缄愁凭仗此，望断归鸿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24652,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹧鸪天","author":"许德蘋","text":"瘦蝶撩人扑纸窗。\n一林枫叶染轻霜。\n烟涵松翠侵鬟翠，风送橙香浥袖香。\n临水曲，感情长。\n梧桐瑟瑟晚来凉。\n篱边又报深秋信，丛菊枝头已绽黄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24653,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉楼春 红梅","author":"许德蘋","text":"东君击得珊瑚碎。\n点缀南枝开也未。\n却嫌玉骨冰清清，洒遍胭脂方称意。\n几回收拾霜毫底。\n疏影横斜竹外倚。\n多情野鹤不知寒，守住红妆眠未起。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24654,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"小重山","author":"许德蘋","text":"杨柳枝头舒眼青。\n桃花初点注、脸霞匀。\n一溪风外卷香尘。\n思飘渺、落日淡微云。\n听唱望仙门。\n阿谁声细细、背灯昏。\n胡沙路远嫁昭君。\n年年恨、辜负一家春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24655,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一剪梅 秋别","author":"许德蘋","text":"一阵凉生一片秋。\n渺渺烟波，轻送扁舟。\n横空雁影叫西风，望断天涯，更上层楼。\n但见行云逐水流。\n霜叶千林，尽是离愁。\n计程犹住古馀杭，为避潮头，未过江头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24656,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙 其一","author":"许德蘋","text":"庭院深深深几许，云窗雾阁都扃。\n韶华最好近清明。\n鸟啼声隔牖，花放色倾城。\n蝶舞蜂喧天亦醉，江南作赋难成。\n夭桃一树易飘零。\n冶游三月兴，寻梦十分情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24657,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花","author":"许德蘋","text":"重记征衫清泪满。\n为意人人，寻梦天涯遍。\n不觉自家肠已断。\n从新又到吟花馆。\n帘影迷离钗影乱。\n花落花开，斟酌愁深浅。\n多少愁怀分付雁。\n天涯虽近归期远。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24658,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花","author":"许德蘋","text":"如梦韶光晴较少。\n一种幽情，却向谁人道。\n阶下海棠颜色好。\n卷帘自把菱花照。\n欲写无聊闲起草。\n梅子黄时，最觉伤怀抱。\n四面有山皆欲笑。\n笑侬也似春将老。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24659,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渔家傲 记梦","author":"许德蘋","text":"香绕窗纱迷晓雾。\n钧天乐罢霓裳舞。\n一霎遨游皆胜所。\n冰人语。\n回头刘阮逢仙处。\n正是长安三月暮。\n满池青草催诗句。\n帘外飘零香袂举。\n留不住。\n梦魂今夜谁边去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24660,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渔家傲 咏梅","author":"许德蘋","text":"为睹小园春色至。\n南枝已著铅华腻。\n暗引东风香旎旎。\n亭楼际。\n忍寒正有人梳洗。\n莫是天公珍重意。\n移来琼艳清清地。\n酒盏浅斟浮玉蚁。\n须沉醉。\n娇桃文杏休相比。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24661,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"殢人娇 后亭梅花开有感","author":"许德蘋","text":"额粉新妆，腮霞乍散。\n犹深喜、占春来晚。\n琼楼玉馆，情深意远。\n池上影，梨云被风吹卷。\n长笛一声，阳关雪满。\n香浓处、几回肠断。\n天涯欲赠，为谁轻剪。\n怎枉费，连番凤笺湘管。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24662,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"行香子 七夕","author":"许德蘋","text":"阶下秋蛩。\n井畔疏桐。\n正今宵牛女情浓。\n经年别绪，愁诉重重。\n料星桥南，星桥北，喜相逢。\n人间乞巧，好陈瓜果，也怜他离恨无穷。\n银湾斜转，砧杵声中。\n剩一炉烟，一钩月，一帘风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24663,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"孤雁儿","author":"许德蘋","text":"仙人破腊冲寒起。\n正索笑、多清思。\n一枝冷淡报春回，瘦影横斜临水。\n初调琴轸，弹成三弄，谁识千金意。\n小心数点藏天地。\n恁都感、相思泪。\n西湖占断好春光，惟有林逋独倚。\n疏帘淡月，与花同梦，终古柔情寄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24664,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤凰台上忆吹箫 闺情","author":"许德蘋","text":"暖水池塘，轻云台榭，一年韶景开头。\n见草生庭砌，初茁如钩。\n多少蜂狂蝶闹，空触起、往事无休。\n从今记、伤春意味，胜似悲秋。\n相将。\n二分春色，还却向花阴，密处句留。\n任差池双燕，暗绕西楼。\n知否楼头人倦，红紫艳、怕展双眸。\n双眸远，漫天飞絮，怎比侬愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24665,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满庭芳 咏梅","author":"许德蘋","text":"梦绕西湖，香迷东阁，诗成谁赋清幽。\n饱尝冰雪，月影挂斜钩。\n记得罗浮翠羽，引仙子、飞下琼楼。\n为伊剪，一枝寒玉，刀快借并州。\n长宵深坐瘦，魂飞黯淡，影抱温柔。\n对疏花冷蕊，都是闲愁。\n拼得十千贯酒，向竹外、款取春留。\n湘帘卷，黄昏寂寂，香气上阶流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24666,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"庆清朝慢","author":"许德蘋","text":"燕影穿帘，莺声选树，兰闺倦对芳春。\n长吟短咏握管，空拟清真。\n好把低颦浅笑，几回著意巧翻新。\n看湖上，淡妆浓抹，羞煞文君。\n梅魂清，鹤梦杳，正寸心千转，暗逐征轮。\n重重幕外，飞来野马成尘。\n折得一枝幽艳，和香黏露粉朱匀。\n筠屏倚，怎样描出，似醉昏昏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24667,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"永遇乐 元宵","author":"许德蘋","text":"月浸春城，花明灯市，游冶佳处。\n桥畔云迷，楼头彩结，仙阙应也许。\n翠影丛中，艳歌声里，最怕霎时微雨。\n还端整、靓妆簇簇，好牵凤俦鸳侣。\n千门如昼，六街闲步，不觉签声催五。\n宝马尘飞，钿车香惹，群屧争楚楚。\n鱼龙游戏，因风忽撼，势若凌空飞去。\n听邻女、月地花天，从头细语。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24668,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"多丽 白菊","author":"许德蘋","text":"乍重阳，漫天清露珠垂。\n听鸣秋、千林黄叶，飙飙寒色侵肌。\n也记起、玉妃贴鬓，也记起、青女低眉。\n三径萧疏，千株冷淡，不随春艳斗妍奇。\n正好趁、持螯把酒，风趣算偏宜。\n满头插，粉花玉蕊，错认酴醾。\n向园林、秋光渐老，傲霜挺秀相依。\n有宫人、乍吟愁赋，有倦客、重咏新诗。\n旅邸情怀，柴桑伴侣，颓然野鹤旧容姿。\n忍守著、孤标晚节，知遇雁来时。\n西风紧，归来彭泽，检点疏篱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24669,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"拜新月","author":"许德蘋","text":"当头见新月，细步出帘拜。\n待得如镜圆，妾心方称快。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24670,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉楼春 夏情","author":"许德蘋","text":"亭亭曲沼荷风卷。\n惊起鸳鸯飞去远。\n垂杨低挂万千丝，遮莫青骢都不绾。\n起来又把瑶琴怨。\n流水高山弹已遍。\n蒹葭深处有伊人，真个曲中人不见。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24671,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉楼春 秋情","author":"许德蘋","text":"秋光最是添愁绪。\n一霎风吹一霎雨。\n啼螀唧唧到天明，万叠相思无觅处。\n相思凭著谁人诉。\n征雁刚来天际语。\n那人未有一行书，梦里今宵亲自去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24672,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉楼春 冬情","author":"许德蘋","text":"重帏未下尖风透。\n独拥熏炉烧炭兽。\n养娘何事太无情，反欲催人勤刺绣。\n几回拈起残针扣。\n绣出平原犹未就。\n檐冰倒挂玉玲珑，梅蕊争开红结豆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24673,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 暮春感赋","author":"许德蘋","text":"花落花开，恨春作弄千般巧。\n此情谁晓。\n都是催人老。\n杜宇声声，偏向楼头叫。\n春归了。\n飞花料峭。\n有个蜂儿抱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24674,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 秋夜书怀","author":"许德蘋","text":"凉飙黄叶催寒色。\n纸窗月照无情碧。\n一阵雨潇潇。\n墙东悔种蕉。\n嘹嘹新雁过。\n刀尺声相和。\n莫说是寻常。\n人情怨夜长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24675,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"钗头凤 秋夜不寐，漫成此调","author":"许德蘋","text":"秋怀闷。\n秋心凉。\n一番秋意无人问。\n眼花落。\n灯花落。\n数尽莲筹，满街剥啄。\n柝。\n柝。\n柝。\n风声紧。\n虫声近。\n搅人魂梦何曾稳。\n罗衾薄。\n罗衫薄。\n坐到更残，鸡声已作。\n喔。\n喔。\n喔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24676,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"芭蕉雨 与张月娟姊雨夜夜话","author":"许德蘋","text":"并坐虚窗意切。\n有谁来解得、同心结。\n一粟灯花明灭。\n可奈对著愁人，将愁怎说。\n人生浑似梦蝶。\n看乌兔飘瞥。\n只一例收场、还分别。\n正谁到、断肠时，惊听雨滴丛蕉，风摇片铁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24677,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一七令 对梅花作","author":"许德蘋","text":"梅。\n梅。\n潇洒，芳菲。\n玉为骨，冰为肌。\n姑射清绝，寿阳娇奇。\n花分南北艳，寒忍雪霜欺。\n千树初传春信，一枝独占花魁。\n谁识孤标能鉴水，除非白石更无词。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24678,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人 梅花","author":"许德蘋","text":"朝来和梦寻春迹。\n枝上堆残雪。\n罗浮仙子却嫣然。\n花瘦侬怜侬瘦、被花怜。\n一钩残月朦胧照。\n应索何人笑。\n丁香已结个中词。\n凭遍阑干攀折、几回看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24679,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寿阳曲 道旁孤梅著花，睹此生感","author":"许德蘋","text":"一树疏花发，众芳都不如。\n向天涯、赠将何处。\n甚殷勤、暗香留几许。\n轻试问、是谁为主。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24680,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南乡子 前题","author":"赵芬","text":"蟾魄喜初圆。\n名士倾城是夙缘。\n月姊闻声应亦妒，翩翩。\n未许乘风便上天。\n绰约体如仙。\n徒倚桐阴石磴边。\n最是泥人风致也，娟娟，手握琼箫更可怜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24681,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青玉案 茉莉花","author":"赵芬","text":"纱厨玉枕清无暑。\n点缀晚妆眉妩。\n一片幽怀谁与诉。\n盈盈素质，泠泠碧露，欲摘人何处。\n暗香渐觉金凤度。\n起傍花阴自延伫。\n欲问冰蟾愁几许。\n越罗凉透，楚天云暮，脉脉浑无语。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24682,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"深院月","author":"赵芬","text":"情脉脉，思悠悠。\n霜满闲庭月满楼。\n何处歌声风送到，隔邻亲案小凉州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24683,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"天仙子","author":"赵芬","text":"满腹闲愁皆自取。\n美人消息知何处。\n芳心许。\n芳魂与。\n偏到相逢无一语。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24684,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西溪子","author":"赵芬","text":"溪畔水仙开矣。\n一缕幽香如此。\n暗相思，何时已。\n无时已。\n不比春风桃李。\n问姮娥。\n奈冷何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24685,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"归自谣","author":"赵芬","text":"今夜月。\n千里离怀愁欲绝。\n归鸿阵阵哀鸣切。\n销魂恰忆中秋别。\n堪呜咽。\n裁笺欲寄南枝雪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24686,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"连理枝","author":"赵芬","text":"怕读西堂句。\n怕听西窗雨。\n此恨何如，几时重见，归期又误。\n忆谢庭今夜，北堂相聚，围炉共语。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24687,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江南好 自题“意中云树图”","author":"赵芬","text":"江南忆，相忆未曾经。\n人道江南侬故国，几时才见故山青。\n归梦杳难凭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24688,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江东 前题","author":"赵芬","text":"烟水苍茫黄歇浦。\n五百里、吴淞路。\n如何咫尺叹修阻。\n难觅个、帆飞渡。\n欲归屡把归期误。\n凝望远、空云树。\n漫劳湘管传情愫。\n奈此情、还难赋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24689,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"意难忘 前题","author":"赵芬","text":"十载蘋洲。\n正襟怀黯黯，岁月悠悠。\n望云心欲绝，怀橘愿难酬。\n鸿北向、水东流。\n拼一醉新篘。\n把此中、无边寥落，尽付眠鸥。\n燕台更有前游。\n记闲园角酒，水榭迎秋。\n题糕徵韵语，说饼拥香篝。\n怜别后、见无由。\n更莫上高楼。\n暮山横、斜阳芳草，处处生愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24690,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"锦缠道 题丁梦樵“四安赛会竹枝词”","author":"赵芬","text":"才罢春游，刚接赛神弦管。\n想盈堤、舞裙歌扇。\n方山社会人争羡。\n句起诗豪，重把新声按。\n好句播风谣，情关正变。\n知老铁、清词夸独。\n擅它时、定有双鬟听，红牙轻拍，传唱旗亭遍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24691,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"解佩令 题姜玉溪“箫声明月图”","author":"赵芬","text":"冰弦停拨，闲愁暗绕。\n记良宵、隔水声度。\n翠袖红楼，把碧玉、殷勤重谱。\n袅馀音、低徊如诉。\n一天凉月，一江冷露。\n渺微波、盈盈修阻。\n倩得荆关，为写出、那时情绪。\n却还愁、小红生妒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24692,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一枝花 题严比玉“宜园倚声图”","author":"赵芬","text":"过眼凉秋晚。\n抱膝酸吟惯。\n蘋洲渔笛都、拥琴案。\n看减字偷声，写得词华烂。\n休道豪情擅。\n待檀板红牙，倩个小鬟轻按。\n笑侬亦、红裁白判。\n惹得吟逋绊。\n到如今、爨弄何曾算。\n羡滴粉搓酥，字字珠玑绽。\n肯便浮名换。\n一曲风流，早已是、旗亭传遍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24693,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"百字令 题董壶山甥男“百花词”","author":"赵芬","text":"生香活色，似丹青宛转，描来情丽。\n滴粉搓酥成百咏，字字绿酣红腻。\n十样云笺，三升墨露，会得惺忪意。\n问花无语，可能知此情未。\n堪叹驹隙流光，鸿归燕去，不管人憔悴。\n雨雨风风新梦觉，别是销魂滋味。\n一段缠绵，千般哀怨，尽向毫端寄。\n感春怀抱，遣愁侬亦无计。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24694,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"金缕曲 春日有感子启兄之逝，兼悼董崧园","author":"赵芬","text":"梦断江乡路。\n忆年时、小窗情话，共倾离绪。\n一别俄惊成永诀，竟使才人黄土。\n算总为、浮名耽误。\n只影凄凉馀弱弟，痛联床、听雨人何处。\n休再咏，断肠句。\n同归翻有知心侣。\n料重泉、相逢话旧，应悲草露。\n未遇孙阳终见弃，绝艺空得毫素。\n更鹦鹉、当年曾赋。\n又是禁烟时节近，叹殡宫、寂寞斜阳暮。\n还剪纸，向清沪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24695,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]