[{"title":"陪宪副王公、总戎张公偕诸僚友往观禾稼，归途宴集海会寺，抵暮而返 其三","author":"孙元衡","text":"回辔入禅林，停舆就夕阴。\n饿鸱鸣斗酒，飞骑致庖禽。\n布席山门敞，行厨竹径深。\n双榕乱黄鸟，钟磬会清音。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35236,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"遣去里门人还，言被水灾，怅然有作","author":"孙元衡","text":"蕙风拂袖兰时往，清露沾袍雁候来。\n长路夏秋皆阻雨，大江南北已成灾。\n家徒四壁罍应耻，庭有三荆鸟半哀。\n何日单车容命驾，袁维归去岂徘徊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35237,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"红夷剑歌","author":"孙元衡","text":"海潮迅澓千丈波，宝剑出匣悲风多。\n剑身三尺菖蒲叶，文成蝌蚪星辰罗。\n耿耿光明拖疋练，潢潢气势翻长河。\n绕膝柔如弓抱月，铮然脱手锵鸣珂。\n壮士斫石迸阴火，应声解物无延俄。\n寒灯照夜老蛟泣，冷雨入屋神龙歌。\n长须遗民向我说，儿时丧乱沦于倭。\n长历荷兰诸绝国，酷嗜长剑情靡他。\n蕃禁例同盗神器，得此逋窜遭蹉跎。\n渡海中流鬼物夺，雷公电母频撝诃。\n归向中原乃拂拭，照见头发霜为皤。\n良工导我开生面，千金装饰十年磨。\n佩之邪心除已尽，世人不敢轻摩挲。\n我有墨兵久不用，睹此神物心平和。\n愿见圣人舞干羽，喜逢宇内销兵戈。\n遗民掀髯发长啸，太平对此将如何。\n万事不平今已矣，掉头蹈海双滂沱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35238,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"八月二十三日即事 其一","author":"孙元衡","text":"日中不敢放鸡豚，人事仓皇遍海村。\n或欲奋飞随大鸟，避灾直去鲁东门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35239,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"八月二十三日即事 其二","author":"孙元衡","text":"一之为甚其堪再，风鹤传闻处处疑。\n飞鼠断猿龟食蟒，那凭冠履定崇卑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35240,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送方平斋","author":"孙元衡","text":"秋在梦中尽，人疑天上行。\n与君处处别，不似此时情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35241,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病中四首 其一","author":"孙元衡","text":"一片秋云坠海邦，昨来对镜雪痕双。\n寒生药铫吹残火，风至毡裘拥破窗。\n伏枕似逃文士会，闭门不受酒人降。\n此间归思知多少，梦逐惊鸿渡皖江。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35242,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病中四首 其二","author":"孙元衡","text":"物态浮观物理沈，瘴山浅历瘴云深。\n四时气有三时夏，一日风生半日阴。\n海外自知坚道念，病馀不觉长禅心。\n大通中散无由觅，九籥应难鍊紫金。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35243,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病中四首 其三","author":"孙元衡","text":"半间七尺呻吟地，拥被披裘对夕曛。\n侵隐墨蚊何善伺，缘空朱蚁似多闻。\n芳樽独负忘归子，良药全凭抱节君。\n莫道前轩花有径，未能著屐已离群。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35244,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病中四首 其四","author":"孙元衡","text":"几日淹留似醉乡，今来小愈坐胡床。\n羹调玉糁桄榔软，茶煮龙团椷榄香。\n糕字题成教女婢，纸鸢画就走儿郎。\n此翁得丧无何有，炙背扶人傍短墙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35245,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"筱岫在署时，于书室墙侧植竹一枝，至秋倏生十笋，蓊然成林，为之一快","author":"孙元衡","text":"墙下种青玉，亭亭惟一竿。\n对此孤竹君，珍重同琅玕。\n渡海不忍别，挥杯与盘桓。\n慇勤属长须，毋使僮仆残。\n方秋四气备，芽笋纷以攒。\n稚子脱新锦，老龙恋深蟠。\n枝垂苍藓上，梢罥青云端。\n来风动葳蕤，防露见檀栾。\n清吟致遥想，匪直报平安。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35246,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"閒游羡子园林","author":"孙元衡","text":"杪秋似初夏，和风正轻靡。\n从游四五人，出郭二三里。\n细路入幽篁，平沙渡寒沚。\n羡木行行直，崇冈面面起。\n故叶凌冬青，新枝垂暮紫。\n茆居阒无人，远患洵足美。\n门前百尺阴，荫此一溪水。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35247,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"周济庵招同张尔介重集梦蝶草亭","author":"孙元衡","text":"桄榔围古寺，故境野情迷。\n绕槛寒流细，排云碧笋齐。\n尘清花弄色，市远鸟閒啼。\n曾作诗中画，山僧问旧题。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35248,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"巨蛇吞鹿歌","author":"孙元衡","text":"一岛三千麋鹿场，甡甡出谷如牛羊。\n台山不生白额虎，族类无忧牙爪伤。\n野有修蛇大于斗，飕飕草木腥风走。\n气腾火燄喷黄云，八尺斑龙入巨口。\n九岐璚角横其喉，昂霄下咽膏涎流。\n狞蕃骇兽不相贼，奔窜林莽争逃钩。\n我闻巴蛇吞象不烦咬，三岁化骨何阴狡。\n尔鹿尔鹿甚微细，此蛇得之应未饱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35249,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"风潮靡定，远眺大洋无片帆往来，累十馀日矣，书怀一首","author":"孙元衡","text":"大海劳孤望，长天日日阴。\n水云相断续，中外一浮沈。\n远鸟搴为练，虚沙响作砧。\n亲朋归已尽，南北有遐心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35250,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"方七平斋别去匝月矣，无登岸来音，未卜阻于何地，奉怀一首","author":"孙元衡","text":"秋冬时改令，上下月更弦。\n往路惟凭夜，遥情但问天。\n九瀛人自少，一叶信谁传。\n之子非常士，乘风定济川。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35251,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海龙","author":"孙元衡","text":"澎岛渔人乞我歌，海龙双跃出盘涡。\n爪牙未具空麟鬣，直似枯鱼泣过河。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35252,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"冬日草堂漫兴 其一","author":"孙元衡","text":"吹断横洋十日风，惠泉不到荔枝浓。\n玲珑艳雪无文柚，且耐酸寒剥海红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35253,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"冬日草堂漫兴 其二","author":"孙元衡","text":"杯泛寒姿菊有英，燕飞蝶舞似春城。\n山椒子结金铃小，调出香螺软玉羹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35254,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"冬日草堂漫兴 其三","author":"孙元衡","text":"烹茶方法教儿僮，蟹眼潜听火候工。\n汲取竹林僧舍水，雨芽来自大王峰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35255,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"独坐有感","author":"孙元衡","text":"仆婢都因药饵忙，自量生理坐胡床。\n抛书岂有安身法，止酒应无却病方。\n老圃寻花风邑邑，空庭待月露瀼瀼。\n南天草木逃秋令，烂熳惊看镜里霜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35256,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"奉别济庵周寅长","author":"孙元衡","text":"万里虚名随尾纸，两年传舍共浮槎。\n瘴山切避风前毒，海国宜观浪里花。\n边徼沙尘原莽荡，江淮舟楫总欹斜。\n君情已在樽罍外，坐恋榕阴似别家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35257,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"买舟","author":"孙元衡","text":"三宿能无恋故桑，自来归鸟厌回翔。\n已辞大井潮头馆，便买长梢飓尾航。\n别友定难逃酒累，治装偏觉为诗忙。\n竹蕉深处频回首，缥缈浮瓠一草堂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35258,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"澎湖","author":"孙元衡","text":"七十二屿称澎湖，沧溟万里开荒涂。\n屿屿盘纡互钩带，洪波割据成方隅。\n东西二吉门户壮，将军之澳为中区。\n雄师镇压马宫汛，天然犄角中邦无。\n其馀赋形非一状，纷陈簠簋兼盘盂。\n蛟蛇拳曲龙隐见，狮象蹲踞僧跏趺。\n诸流回澓舟难入，逆帆欲泊兴嗟吁。\n百折终成触嶕势，狂澜反走如亡逋。\n有时无风水澄镜，咫尺胶固谁能逾。\n巨舸理不任篙楫，束手待敌甘为俘。\n汪洋指南争此土，既到往往遭艰虞。\n昔日王师事征讨，神兵彷佛前驰驱。\n风摧火灭甘泉沸，降幡夜出台山陬。\n制府谋成输百万，冠军一战真良图。\n事关正统岂微细，封赏有间传闻殊。\n榜人维舟汲清水，蹑踪到顶招吾徒。\n黑铁崩崖潮欲缩，黄沙石碛盐为污。\n蚝岛峰峦咸破碎，凫亹草木原焦枯。\n大海东流无底极，振衣一啸心踟蹰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35259,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"厦门登岸","author":"孙元衡","text":"退之欣见蠍，坡老喜闻骡。\n将毋耳目僻，反使嗜好阿。\n孤身阻遐域，相逢尽么魔。\n奉诏遂生还，慰情良已多。\n恶声与毒物，不忍便撝诃。\n虽为夙所贱，愈于风与波。\n蠢蠢且偕意，亲故夫如何。\n三年穷困海，瘴疠忧相磨。\n两脚蹋中土，惊禽脱虞罗。\n环山带灵石，往往见云窝。\n流泉出山来，淙淙桥下过。\n日明枫叶岸，籁起长松坡。\n弱鳞浮浅渚，喜鹊叫寒柯。\n翠竹鲜钩棘，著手久摩挲。\n骡钤与蠍影，默念成微呵。\n曳杖陟崇冈，城楼郁嵯峨。\n笋舆尽归客，细路盘青莎。\n乡程六千里，计日无差讹。\n挥手谢大洋，日月如腾梭。\n心灰死欲然，肠冰就阳和。\n孤斟一壶酒，未醉颜为酡。\n二公者勋业，浩浩江与河。\n余生也既晚，下秩同蹉跎。\n奇怀亦云尔，望古成悲歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35260,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"冬至日即席赋别黄萍谷同寅","author":"孙元衡","text":"至日初长暖律迎，登楼今见众峰晴。\n来时烟鸟随潮泛，往路风花与雪轻。\n红叶堆边人欲醉，青山尽处月偏明。\n大堤芳草关门柳，又领中原别友情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35261,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"东湖竹枝词 其二","author":"杨毓秀","text":"荷衣裁作玉檠形，万点荷镫万点青。\n昔日秦兵今不戒，移将镫影照双星。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35262,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"霓裳中叙第一 春事欲阑，故人江外，旅窗竟夕，索梦不得，书寄何梅屋","author":"蒋春霖","text":"苍苔换旧迹。\n过却清明春是客。\n花外玉尊又侧。\n任庭树敛阴，风帘催夕。\n天涯倦翼。\n趁坠红、飞去无力。\n凄凉久、一灯梦觉，隐约夜窗白。\n檐隙。\n峭寒犹积。\n叹瘦骨、轻衾怎敌。\n相思偏在故国。\n竹槛欹琴，水榭题壁。\n断鸿归太急。\n便忘却、江南旧识。\n乡程远、何时孤棹，卧听倚楼笛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35263,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西江月 其二","author":"曹雪芹","text":"富贵不知乐业，贫穷难耐凄凉。\n可怜辜负好韶光，于国于家无望。\n天下无能第一，古今不肖无双。\n寄言纨绔与膏粱：莫效此儿形状！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35264,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闲中好 其一 别意","author":"董元恺","text":"闲中好。\n别意生庭草。\n含泪向窗纱。\n残痕照落花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35265,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闲中好 其二 别意","author":"董元恺","text":"闲中好。\n春信吹芳草。\n裙带绿于烟。\n东风又几年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35266,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"明月斜 夜坐","author":"董元恺","text":"篆烟红，泪花绿。\n银汉迢迢堕入怀，黄河万里响心曲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35267,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南歌子 其一 闺怨","author":"董元恺","text":"侬取冰为枕，侬持檗作衾。\n一夜苦寒侵。\n五更天欲曙，涕淫淫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35268,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南歌子 其二 闺怨","author":"董元恺","text":"郎似江边水，侬如江上花。\n花落水无涯。\n东风吹欲起，逐风斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35269,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三台令 其一 洞庭杂兴","author":"董元恺","text":"万顷平湖似镜，千峰列嶂如环。\n处处倪迂范缓，家家雾髻云鬟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35270,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三台令 其二 洞庭杂兴","author":"董元恺","text":"策杖丹梯翠巘，肩舆绿意红情。\n籍草争来献茗，提壶忽地听莺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35271,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三台令 其三 洞庭杂兴","author":"董元恺","text":"幽是包山林屋，高为飘渺仙峰。\n揽胜石公石姆，探奇大龙小龙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35272,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三台令 其四 洞庭杂兴","author":"董元恺","text":"锦泛千层桃浪，光摇万树梨花。\n树树红飞白雪，层层碧映朱霞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35273,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三台令 其五 洞庭杂兴","author":"董元恺","text":"销夏山林城市，中春剖橘搓橙。\n一叶舟浮个个，前帆阁带盈盈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35274,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三台令 其六 洞庭杂兴","author":"董元恺","text":"宅有鸱彝少伯，巷传角里先生。\n山果赧颜可摘，湖鱼缩项旋烹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35275,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三台令 其七 洞庭杂兴","author":"董元恺","text":"日落山空响梵，风来树杪生涛。\n一卷洞中周易，三杯醉后离骚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35276,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"摘得新 其一 闺思","author":"董元恺","text":"烛灭时。\n思郎泪暗垂。\n相思谁与共，月明知。\n月明照出相思字，是郎诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35277,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"摘得新 其二 咏玉簪花","author":"董元恺","text":"白玉簪，瑶池月影临。\n搔头斜照水，鬓云侵。\n阿谁不放愁心展，正多心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35278,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"花非花 其一 古意","author":"董元恺","text":"黄檗篱，合欢树。\n树成蹊，篱当户。\n侬身不共合欢时，侬心偏见生离苦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35279,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"花非花 其二 古意","author":"董元恺","text":"柳缄愁，蕉结恨。\n恨千条，愁一寸。\n郎行终日无舒时，郎来一夜都开尽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35280,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"花非花 其三 咏韭","author":"董元恺","text":"舍东畦，霜后圃。\n比青篘，舒翠缕。\n知君昨夜故人来，为我殷勤剪春雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35281,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南歌子 其一 闺绣","author":"董元恺","text":"螺笔描新样，金针倚绣床。\n深情却悔绣鸳鸯。\n绣出无情蛱蝶，又成双。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35282,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南歌子 其二 别况","author":"董元恺","text":"泪落吹成絮，愁多乱似丝。\n偎人刚道莫相思。\n却是相思此夜，起头时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35283,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南歌子 其三 闺夜","author":"董元恺","text":"绛蜡啼千箸，冰蚕搅万丝。\n空房香烬欲消时。\n冷暖争如宝鸭，腹中知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35284,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"荷叶杯 闺夜","author":"董元恺","text":"捲起一帘清景。\n孤影。\n小胆怯空庭。\n乱竹萧萧响画屏。\n听么听。\n听么听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35285,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 啜茶十咏 其一","author":"董元恺","text":"茶坞胜，阳羡郁层峦。\n月峡涧流生雀舌，石岩雾晓出龙团。\n仙掌片峰寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35286,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 啜茶十咏 其二","author":"董元恺","text":"茶笋别，罗岕胜乌程。\n庙后结花垂绿脚，渚前分露种红英。\n秀色带烟轻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35287,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 啜茶十咏 其三","author":"董元恺","text":"茶籯满，叶叶占先春。\n翠霭撷齐双鬓冷，青丝笼就两枪新。\n衣惹暗香尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35288,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 啜茶十咏 其四","author":"董元恺","text":"茶舍小，石径卧云斜。\n斑驳苔生青嶂影，婆娑树老绿阴遮。\n竹里看煎茶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35289,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 啜茶十咏 其五","author":"董元恺","text":"茶灶冷，溪鸟逐烟光。\n瑟瑟波沉霞脚碎，轻轻色泛乳花香。\n翠釜合先尝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35290,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 啜茶十咏 其六","author":"董元恺","text":"茶焙暖，沆瀣碧波融。\n编竹候随文武火，开缄叶里建城笼。\n一纸隔春风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35291,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 啜茶十咏 其七","author":"董元恺","text":"茶泉沸，第二擅中泠。\n旋沫翻成鱼眼动，腾波声作老龙听。\n涧底觅樵青。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35292,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 啜茶十咏 其八","author":"董元恺","text":"茶瓯洁，碧碗醉春醪。\n翠影香浮卢氏碗，素瓷圆胜谢家窑。\n丝柳拂长条。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35293,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 啜茶十咏 其九","author":"董元恺","text":"茶品绝，缀玉复含珠。\n三十绫文酬博士，两篇《茶录》问君谟。\n疏月下庭梧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35294,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 啜茶十咏 其十","author":"董元恺","text":"茶候静，帘卷日初长。\n片甲味分蝉翼薄，丹丘阴益簟纹凉。\n应唤醒羲皇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35295,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其十一 红桥春游词","author":"董元恺","text":"红桥好，联骑出城闉。\n映日游丝萦曲径，扑天飞絮惹香尘。\n胜地占芳辰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35296,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其十二 红桥春游词","author":"董元恺","text":"虹桥好，挈伴踏青游。\n紫陌骄嘶金勒马，碧波斜蘸绿杨楼。\n高会尽风流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35297,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其十三 红桥春游词","author":"董元恺","text":"虹桥好，潋滟画栏明。\n曲折湘文摇簟縠，玲珑梵字漾帘旌。\n高下渌波平。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35298,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其十四 红桥春游词","author":"董元恺","text":"虹桥好，万树带垂杨。\n新笋穿泥云覆屋，疏篱列障竹为墙。\n魂断旧雷塘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35299,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其十五 红桥春游词","author":"董元恺","text":"虹桥好，摇曳酒旗红。\n小立垂丝人语细，低回促坐笑声浓。\n莫放绿樽空。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35300,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其十六 红桥春游词","author":"董元恺","text":"红桥好，野店擅行厨。\n细切银丝盐下豉，新调玉鲙笋如酥。\n餔醊足欢呼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35301,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其十七 红桥春游词","author":"董元恺","text":"虹桥好，画舫树中移。\n万缕轻黄珠户映，半篙柔绿绣帘垂。\n春昼日迟迟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35302,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]