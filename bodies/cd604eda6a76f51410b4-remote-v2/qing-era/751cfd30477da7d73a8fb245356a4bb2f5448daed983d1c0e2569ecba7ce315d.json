[{"title":"虞美人影","author":"顾之琼","text":"葳蕤深锁年华老。\n欹枕梦回啼鸟。\n春漏迢迢待晓。\n镇日忧心悄。\n卷帘满目游丝袅。\n零落杏花飞绕。\n缚帚呼童频扫。\n砌长忘忧草。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22732,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"应天长","author":"顾之琼","text":"绿阴风软黄鹂舌。\n往事重提千缕血。\n悄无言，眉几叠。\n博得瑶阶诉明月。\n醒难传，梦怎说。\n赚人真是离别。\n索性金鸡啼彻。\n任他长契阔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22733,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"意难忘 寄外","author":"顾之琼","text":"柳絮飘扬。\n怪吹衣拂面，故作颠狂。\n春情无计住，午梦不禁长。\n纨扇洁、石屏凉。\n便沉醉何妨。\n一霎儿、峭风吹断，绣被翻香。\n觉来瘦怯罗裳。\n把同心带结，待寄檀郎。\n祝生生比翼，尽日日成双。\n春去速、蝶空忙。\n芳草映斜阳。\n又恐伊、封侯未稳，误了凝妆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22734,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 惜春   见《众香词》、《词综》、《词雅》、《昭代词选》","author":"顾之琼","text":"风静绮窗闲。\n一任妆残。\n昼长何事倚栏干。\n好梦不来春便去，几度芳年。\n极目楚江寒。\n烟棹平澜。\n月欺津渡雨欺山。\n帘外柳花飞絮也，因甚阑珊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22735,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆秦娥 杜鹃","author":"陆凤池","text":"东风咽。\n杜鹃帘外啼红血。\n啼红血，一枝竹影，半庭残月。\n当年幽恨凭谁说。\n乡关望断真凄绝。\n真凄绝。\n不如归去，旧时宫阙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22736,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雨中花 秋思","author":"陆凤池","text":"满径芙蓉红如晕。\n更交映、桂芳菊润。\n听幽砌蛩吟，疏林蝉噪，惹起清秋恨。\n每叹流光容易尽。\n记七夕、鹊桥渡稳。\n早过了中秋，疏风斜雨，又是重阳近。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22737,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇","author":"陆真","text":"春已无多，杜鹃又欲催归去。\n落红如许。\n一夜风和雨。\n独倚楼头，望里斜阳暮。\n情难诉。\n绿芜深处。\n可是春归路。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22738,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 对灯","author":"蔡婉罗","text":"帘外无风，芭蕉尚滴朝来雨。\n寒生金缕。\n灯欲和人语。\n剔去灯花，红泪休教觑。\n还留住。\n影儿相顾。\n同在屏山路。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22739,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 越城晚眺","author":"沈榛","text":"茫茫薄霭横如雨。\n高低夕照穿芳树。\n红蓼映清波。\n渔人挂网多。\n雪鸥堤畔起。\n几点孤舟里。\n明月忽飞来。\n悠扬画角催。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22740,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙","author":"蔡婉罗","text":"飞尽流萤无兴扑，扇儿闲却秋风。\n远山夜半又闻钟。\n解衣斜对影，欲寝恨床空。\n凄断银缸浑欲灭，数声窗外孤鸿。\n夜凉如水出帘栊。\n微云淡河汉，疏雨滴梧桐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22741,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 咏扇","author":"蔡婉罗","text":"似雪齐纨，初裁就、一轮明月。\n堪爱处，合欢新样，笑遮双靥。\n遣兴试描秦女凤，添愁扑散庄生蝶。\n羡团圆，素影伴佳人，终朝夕。\n湘枕畔，纱橱侧。\n纤手玩，香难歇。\n想班姬幽怨，倩伊曾说。\n漫恃君恩怀袖里，每嗟秋至春风发。\n最伤情、时节易炎凉，轻抛撇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22742,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇  见《词综》、《词雅》","author":"虞兆淑","text":"梅绽芳菲，垂杨烟外低金缕。\n韶华小住，生怕廉纤雨。\n绣户凄凉，蝴蝶双飞去。\n愁如许。\n梦魂无据，还在秋千路。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22743,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渔歌子 秋夜","author":"徐淑秀","text":"露滴花寒入夜深。\n多情明月向愁人。\n灯隐隐，漏沉沉。\n断续钟声断续砧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22744,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆王孙","author":"徐淑秀","text":"重重幽恨锁眉峰。\n斜倚阑干思未穷。\n徒使心牵问不通。\n忆相逢。\n在梦中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22745,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"丑奴儿令 有怀","author":"徐淑秀","text":"自从别后长相忆，慵整新妆。\n瘦怯春裳。\n怕见庭前芍药芳。\n停针不语愁无限，蜂闹纱窗。\n燕语雕梁。\n独倚阑干欲断肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22746,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹧鸪天 夜坐","author":"徐淑秀","text":"宝篆香消觉夜深。\n挑灯无语倍伤情。\n瑶琴欲抚闲消闷，拨尽朱弦总断魂。\n风索莫，月凄清。\n无端愁思苦萦心。\n徘徊不尽梧桐月，守着窗儿坐到明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22747,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"顾若璞","text":"嫩柳牵丝覆绮窗。\n起来无绪理明珰。\n恼人最是日初长。\n三尺乌云随意挽，两条却月待萧郎。\n胡琴闲放竹方床。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22748,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"顾若璞","text":"绿水红莲一带妍。\n荷衣欲剪惜金钱。\n可怜鸂鶒不同眠。\n纨扇看来心已碎，迎凉盼不到秋天。\n算来又怕说秋天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22749,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"长相思 春词","author":"顾若璞","text":"梅子青。\n豆子青。\n飞絮飘飘扑短襟。\n风褰罗袖轻。\n送芳辰。\n惜芳辰。\n春事支离些个情。\n眉峰恨几层。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22750,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"长相思","author":"顾若璞","text":"春先到。\n愁先到。\n嫩莺故对新丛叫。\n懒把云和抱。\n愁先到。\n春先到。\n花轻蝶乱东风袅。\n捻却花相照。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22751,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 月夜闻沈媚清夫人吹箫","author":"顾若璞","text":"雨收风细。\n一片清光疑是洗。\n秦女楼头。\n吹出柔肠几许愁。\n花枝掩映。\n素腕金环频弄影。\n香软寒轻。\n寂寂帘帏夜不扃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22752,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉楼春 晚春，三桥看月","author":"顾若璞","text":"花飞锦带春波起。\n残月流辉明水底。\n万珠灼烁照新妆，故掬嫦娥纤手里。\n柳线牵烟轻重绿。\n渔灯高下鸳鸯宿。\n无情花柳送归春，不管离人肠断续。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22753,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆王孙 织女怨","author":"顾若璞","text":"年年云锦织天孙。\n银汉无情劳梦魂。\n乌鹊声声隔岸闻。\n怨黄昏。\n烟锁琼楼月到门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22754,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆秦娥","author":"顾若璞","text":"晓莺呕。\n懒梳云鬓上秦楼。\n上秦楼。\n一帘春色，惹起新愁。\n杨花飘荡弄轻柔。\n残红零落倩谁收。\n倩谁收。\n乌盐歌罢，倦倚箜篌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22755,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"真珠帘 孤雁","author":"叶慧光","text":"冥冥万里呼群急。\n叹浮生、也复漂流南北。\n一点落平沙，认往时踪迹。\n辗转惊魂犹未定，正雪满、寒滩芦荻。\n恻恻。\n待写怨留情，不成行墨。\n清影独占天涯，傍潇湘苦竹，泪痕凝碧。\n天半动哀声，似断弦瑶瑟。\n十二楼中明月夜，怅旧侣、那堪思忆。\n凄绝。\n只孤鹤横江，似曾相识。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22756,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"眼儿媚 上冢","author":"叶慧光","text":"半篙春水碧罗纹。\n流出杏花村。\n行人陌上，纸钱飞蝶，细雨如尘。\n归来似醉浑无力，界面尚啼痕。\n金炉香冷，纱窗月上，灯火黄昏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22757,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凄凉犯 木芙蓉","author":"叶慧光","text":"秋江水浅红蕖落，寒英又遍江岸。\n画船歌歇，西风渐紧，绮罗重换。\n鸳鸯拆散。\n但留得、寥天一雁。\n带衰杨、萧疏几线，杳杳斜阳晚。\n那更新霜溅，渡萧辰、恁般清怨。\n溪花落尽，剩娉婷、尚疑人面。\n待插银瓶，怕憔悴、愁颜莫展。\n更伊谁、无情酒盏向汝劝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22758,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"宣清 秋怀","author":"叶慧光","text":"雨霁新凉，小院垂帘，秋风萧萧恁早。\n听哀蝉、尚恋碧阴，又寒蛩、暗泣荒草。\n病发凋零，愁容损减，伤人易老。\n叹于今、了无多，吟风嘲月怀抱。\n便再谱花牒，别翻水调，知音人去杳。\n且学坐蒲团，破除烦恼。\n洞天白云最好。\n一片冰心对莲花，去栽瑶岛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22759,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐","author":"金庄","text":"凄凉晚色。\n丝雨和愁织。\n梦到楚江行不得，一片湿云空隔。\n年时曾忆城东。\n杏花点点飞红。\n门外凭他寒食，玉阑自有春风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22760,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉楼春 春晓","author":"金庄","text":"早乌啼起银蟾落。\n锦帐春寒春意薄。\n天涯路远几曾经，莫怪梦中常是错。\n起来小婢催梳掠，拈着青丝心绪恶。\n无情镜子不怜人，暗把红颜都换却。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22761,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"归字谣 莺","author":"金庄","text":"莺。\n叶底枝头睍睆鸣。\n凭谁听。\n诉尽惜春情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22762,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南","author":"叶宏缃","text":"人别后，独自倚窗纱。\n画谱懒图连理树，绣床羞刺并头花。\n愁思近来加。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22763,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南","author":"叶宏缃","text":"人别后，锦字倩谁传。\n心逐雨花台上客，情牵桃叶渡头船。\n终日闷恹恹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22764,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙  初夏","author":"叶宏缃","text":"开遍蔷薇小院香。\n乍晴梅雨蝶飞忙。\n一溪新碧浸鸳鸯。\n古帖午临欹枕倦，瑶琴晚奏短襟凉。\n倚栏远望又斜阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22765,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 题女史杨倩玉《远山遗集》","author":"叶宏缃","text":"吹落双星雁独归。\n断魂残梦绕花枝。\n西风冷落旧罗帏。\n黛笔难描索笑影，泪珠抛作乱红飞。\n挑灯读遍远山词。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22766,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南歌子 寄七姊查夫人眉令","author":"叶宏缃","text":"桂殿清香杳，桐阶夜色浮。\n孤灯门掩有人愁。\n几点无情蕉雨、滴心头。\n雁影寒烟树，蛩声冷翠楼。\n西风迢递疾如流。\n吹老芦花又入、鬓边秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22767,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行  秋闺","author":"叶宏缃","text":"寒雁侵吟，篱花伴绣。\n萧疏一派秋时候。\n曲栏倚遍望天涯，斜阳断处青山瘦。\n屏掩银床，篆喷金兽。\n芭蕉影压疏帘皱。\n那堪月上又黄昏，声声露滴梧桐漏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22768,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花","author":"谢瑛","text":"园丁报道生芝草。\n绫袜新裁，缓步苍苔早。\n弱女凝妆栏外绕。\n依依小子翻书考。\n白鹤巢松声韵好。\n桂子纷纷，竹影将阶扫。\n贪睡鸳鸯惊又觉。\n佳辰莫惜金尊倒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22769,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渔家傲","author":"谢瑛","text":"竹蓧悬藤岩挂瀑。\n药苗云润空山护。\n浅水芦花舟自俯。\n提壶过。\n哈然一笑乾坤大。\n野菜和根煮烂熟。\n山妻对酌休催鼓。\n长啸一声天未补。\n何须苦。\n不知尘世披云睹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22770,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 幼儿玉谷学诗颇有可观，因填此解","author":"华宜","text":"吟咏是家风。\n笑煞而翁。\n爨烟不起句矜工。\n痴绝又看痴种继，蠹产书中。\n格律那沉雄。\n应恕儿童。\n乌丝须界写笺红。\n寄与长安潦倒客，一展眉峰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22771,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行 题夫子《旷怡轩词钞》后","author":"华宜","text":"才可穷人，文能寿世。\n证之夫婿真都是。\n工诗馀事又工词，红牙喜按衣迟紫。\n宝气腾行，珠光吐字。\n候封万户荣输此。\n但愁声倚绿窗难，只应记曲呼娘子。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22772,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满庭芳 清明日归宁舟中作","author":"华宜","text":"桃雨流红，柳烟晕碧，一年佳节清明。\n蓬窗舒眼，更喜值归宁。\n梦绕亲庭几度，迢迢水、似隔层城。\n今宵里，牵衣膝下，好话别离情。\n心惊。\n犹记得，争夸玉润，不愧冰清。\n怎频年毷氉，弹铗神京。\n劳我椿萱望眼，门楣上、何日春生。\n家乡近，劝开眉锁，遥岸啭莺声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22773,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 寄外","author":"邓湛","text":"镇日多愁屡废餐。\n闭门清坐遣应难。\n楼头明月几回残。\n万点落花谁着眼，一声长笛独凭栏。\n梦归冰簟五更寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22774,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 春晓","author":"邓湛","text":"杨柳楼头风剪剪。\n月落星稀，曙动东方缓。\n一枕绸缪方眷恋。\n无端恰被莺声唤。\n醒来依旧屏山畔。\n强起临妆，懒画眉峰浅。\n呼婢漫将帘幕捲。\n宿酲未醒腰肢软。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22775,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"百尺楼 明月楼，元时赵氏建，子昂题诗：春风阆苑三千客，明月扬州第一楼","author":"黄之柔","text":"住迹已难成，胜事犹能说。\n只为王孙两句诗，今古留明月。\n金斝亦寻常。\n彩笔真奇绝。\n如此楼台岂一家，寂寂都灰灭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22776,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 贺元士侄新婚","author":"黄之柔","text":"香风一夜催云辂。\n吹下嫦娥饮仙露。\n宫烛两行新。\n风流赋洛神。\n同心私自绾。\n罗帕含香暖。\n裙鸟绣双双。\n箫声引凤凰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22777,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南乡子 村望","author":"黄之柔","text":"恰值暮春天。\n暖气侵人懒着绵。\n独倚画楼无任事，花前。\n捲幔青青草色连。\n隔岸酒旗偏。\n半枕垂杨半枕烟。\n遥望夕阳红处也，桥边。\n无数行人争渡喧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22778,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹊桥仙","author":"邓太妙","text":"无聊无赖，多情多态。\n倚遍栏杆无奈。\n不胜力怯薄罗裳，还疑是、风飘绣带。\n蝶欺花落，柳偿莺债。\n多少伤心事在。\n卜桃锦覆合欢床，私倩婢、轻轻遮盖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22779,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"瑞鹤仙","author":"邓太妙","text":"猩红小印品。\n细认来、模糊字儿不整。\n风劲绣床冷。\n只错刀闲剪，暗消腻粉。\n软雨斜阳，鸾鹤飞、辘轳金井。\n闭重帘、关住离愁，桐影教人立尽。\n深省。\n红叶欺霜，黄花迎露，九秋佳景。\n常数归期。\n暗卜金钱无准。\n细沉吟、只顾时时刻刻，窗外枕前低问。\n怪连朝、夜长梦短，人远天涯近。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22780,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令 早春","author":"周季","text":"报到东风已到。\n雾散烟沉晴晓。\n红日照梅梢，新柳枝头丝袅。\n春早。\n春早。\n窗外一声啼鸟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22781,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"唐多令 秋夜追和叶琼章韵","author":"周季","text":"蛩絮短长更。\n凉侵衫袖轻。\n透窗棂、淅沥风鸣。\n渐觉短檠多意味，好伴取、读书声。\n四壁冷清清。\n孤帏影易惊。\n把桐君、几上聊横。\n流水欲弹还又歇，残月落、一天青。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22782,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卖花声 风雨惜梅","author":"周季","text":"子鹤妻伊，高士襟期相许。\n任春来、娇歌艳舞。\n繁华载路，独占深山坞。\n王孙有意终非伍。\n琼琪满树，恨杀无情少女。\n恣摧残、更加连雨。\n师雄清梦，历乱寻何处。\n难触目粘泥籍土。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22783,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 清明日，携儿妇踏青过浦静来表姊，斋头阅其所填新词，欣然继作","author":"华慧空","text":"寒食初过报好晨。\n踏青携伴访佳人。\n吟窗艳思坐生春。\n曲里燕莺歌婉转，毫端花草斗鲜新。\n底须绮陌趁香尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22784,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"沁园春 病中诀别口占","author":"华慧空","text":"六十年来，弱草栖尘，春归梦醒。\n似吐丝作茧，缠绵欲尽，采花酿蜜，辛苦垂成。\n多病衮师，无家织素，弃置何烦属累卿。\n今而后，把幻缘剪断，万劫冥冥。\n知卿影事萦情，料难禁、悲从腹里生。\n怅芦帘纸阁，芸编历乱，冰床雪被，兰炷青荧。\n眼莫长开，肠休频转，留取禅心伴老僧。\n来朝去，便鸳摩一卷，送我西行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22785,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秦楼月 月下闻邻女吹箫","author":"张瑛","text":"箫声闹。\n多情人奏伤情调。\n伤情调。\n风前月下，有愁谁告。\n吹落梅花春欲老。\n人间应是知音少。\n知音少，此情惟有，嫦娥知道。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22786,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"行香子 花朝","author":"张瑛","text":"雪霁瑶台。\n日暖瑶台。\n好时光、畅我心怀。\n一般造化，几样安排。\n见桃花敛，梅花落，杏花开。\n才过东阶。\n又转西阶。\n湘帘外、再四徘徊。\n满园春闹，谁做诗媒。\n有蝶儿舞，莺儿唤，燕儿来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22787,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一剪梅 人日即事","author":"张瑛","text":"晓来春色满天涯。\n风绕窗纱。\n日绕窗纱。\n争向新光斗丽华。\n人也欢哗。\n鸟也欢哗。\n把酒微吟清梦赊。\n起对梅花。\n卧对梅花。\n忽闻萧鼓太周遮。\n知道谁家。\n问道谁家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22788,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醉春风 题扇头美人","author":"张瑛","text":"孰把轻纨扇。\n绘出青蛾面。\n娉婷袅娜向花前，倩。\n倩。\n倩。\n一分水墨，十分摩揣，三分妖艳。\n有人容可羡。\n昔日曾窥见。\n记得情娇态更妍，念。\n念。\n念。\n是谁家女，是谁家画，是谁家院。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22789,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"金人捧露盘 午日同父作","author":"张瑛","text":"不觉是，天中节，日融融。\n小窗似锦石榴红。\n兰汤沐罢，灵符高挂室西东。\n绿阴院落，闲游戏、两袖生风。\n笑儿曹，争艾虎，看女伴，斗花丛。\n开绮席、术酒馨醲。\n一觞一咏，胜如歌舞玉楼中。\n随时节、即便成佳境，何必仙宫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22790,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一剪梅 寄家季妹","author":"贺绿","text":"秋来寂寂掩重门。\n虫语空庭。\n叶打疏棂。\n看朱成碧倍销魂。\n愁绪纷纷。\n情思昏昏。\n梦中可许暂相亲。\n一晌分明。\n一霎无凭。\n凄凉枕簟夜如冰。\n听断鸡声。\n数遍钟声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22791,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令 秋宵","author":"贺洁","text":"宝凤斜飞慵整。\n一种闲愁谁省。\n红压小栏杆，扶住一枝花影。\n花影。\n花影。\n泪眼且看秋景。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22792,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一剪梅","author":"贺洁","text":"髻子蓬松掩镜奁。\n花也慵拈。\n香也慵添。\n倚栏终日病恹恹。\n风自开帘。\n月自穿檐。\n一庭芳草绿铺毡。\n红杏初甜。\n斑笋初尖。\n玉阶微步望银蟾。\n鸟影兼兼。\n柳影纤纤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22793,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]