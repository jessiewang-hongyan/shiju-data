[{"title":"春日登顺庆城楼眺望","author":"常纪","text":"无边烟树碧云隈，江上孤帆天际来。\n照眼春光看不厌，绕城十里菜花开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8520,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南充县试示文武诸童","author":"常纪","text":"幽兰生涧底，靡靡如众草。\n所异在本心，美质能自保。\n一但发天香，采折争倾倒。\n不见古国士，几辈窗间老。\n时哉不可失，努力须及早。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8521,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"五月回西充考试诸童口号","author":"常纪","text":"平生文字有奇缘，桃李争开共斗妍。\n游戏玉田与珠海，何须更羡十洲仙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8522,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"登同庆阁","author":"常纪","text":"杰阁俯龟城，云开望眼明。\n苍茫看陆海，破碎认天彭。\n浦树含烟润，江风拂袖清。\n神情高自爽，真觉厌营营。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8523,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"大庾渡登舟夜发赴遂宁","author":"常纪","text":"解缆涪江水，推蓬古渡头。\n片帆催下濑，一叶放中流。\n岸阔星垂野，潮平月满洲。\n遂阳侵晓至，谁识木兰舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8524,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"初至遂宁行县","author":"常纪","text":"十里青山县，平芜绿树村。\n芳田梅雨润，香稻夏云屯。\n富庶风犹古，周章俗尚存。\n敢矜能听断，期不愧平反。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8525,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"往大足道经安岳蟠龙山山路崎岖比栈道尤险为长歌记之","author":"常纪","text":"连峰插天互相属，仄径苍苍但烟雾。\n折坂盘云伛偻上，后人顶接前人足。\n刚得稍平喘初定，当面?砑更生惧。\n崖转峰回石磴通，涧横溪断疑无路。\n怪石崚嶒势欲压，狞龙张髯老蛟怒。\n岚翠时凝过客衣，云气直绕行人屦。\n我来九月际深秋，绝顶群峰看错互。\n扶桑晞发红日近，举手欲邀羲轮驻。\n天风吹我生羽翰，恨无谢眺惊人句。\n上如登天下亦难，著意攀援慎举步。\n此景此生得未曾，挥毫记取烟霞趣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8526,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"大佛崖","author":"常纪","text":"千仞临江石，刻成丈六身。\n庄严空自好，色相忆前尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8527,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"奉檄赴昭化比至蓬溪已日落矣以月色甚佳复行二十里始宿","author":"常纪","text":"行役敢辞劳，奔走自吾职。\n一鞭落照中，山城到昏黑。\n谓当息鞍马，明月有佳色。\n流光万里同，淡致孤怀得。\n去去踏素影，此意复何极。\n吾自爱清晖，讵为严程过。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8528,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"山行望见顺庆口占","author":"常纪","text":"城下嘉陵水，城头姑射山。\n果州风景别，相见一开颜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8529,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"阆中至昭化终日山行偶成俚歌","author":"常纪","text":"上山如上天，下山如下滩。\n上难下亦难，不知天地宽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8530,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"牛头山送宋简州夜归记","author":"常纪","text":"跨驴踏石下危岑，欲觅山村夜已昏。\n忽记岸亭诗句美，星星远火透疏林。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8531,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和宋简州牛头山留别韵 其一","author":"常纪","text":"家世江东第一流，更饶文藻赋悲秋。\n雄关又得惊人句，胜地宜名谢眺楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8532,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和宋简州牛头山留别韵 其二","author":"常纪","text":"径曲真成字似之，牛头衮衮上来迟。\n放怀今古无穷思，问著山僧总不知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8533,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和宋简州牛头山留别韵 其三","author":"常纪","text":"循声久已比龚黄，此日登临与饯觞。\n肝胆照人真气在，晴波千顷叹茫茫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8534,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题费敬侯墓","author":"常纪","text":"办贼当年志虑纯，彭亡恶兆忍重论。\n至今呜咽嘉陵水，夜夜涛声泣墓门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8535,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"昭化留别吴调元二首 其一","author":"常纪","text":"牵舟岸上惠风浓，水色山光丽日融。\n行见治平称第一，益昌今又说吴公。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8536,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"昭化留别吴调元二首 其二","author":"常纪","text":"醇醪饮我比何如，雅意相关半月馀。\n心醉自今劳远梦，云山时惠一行书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8537,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"舟中早发","author":"常纪","text":"寒山无数郁崚嶒，红日高春上未曾。\n霜气萧森岸苇白，一枝柔橹下嘉陵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8538,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江行口号","author":"常纪","text":"才转前山又见山，舟行曲曲几湾环。\n停桡试问滩深浅，柁棙开头不敢闲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8539,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夜行","author":"常纪","text":"扁舟一叶御微风，星影摇光碧浪空。\n暮霭沈沈迷远岸，橹声咿哑月明中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8540,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"听舟人渝歌","author":"常纪","text":"款乃歌声隔远烟，云山缥缈好音传。\n长年三老遥相示，多是前滩下濑船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8541,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"舟中眺望","author":"常纪","text":"枫叶下寒江，绿净江中水。\n水落浪花平，澄波清见底。\n我行际仲冬，孤舟山色里。\n推蓬初日上，雾重岚光紫。\n尘劳欣暂遣，云山殊可喜。\n平生丘壑怀，对此曷能巳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8542,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"舟泊保宁","author":"常纪","text":"江色城南好，人烟古阆州。\n锦屏岚翠里，今日又维舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8543,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南部道中","author":"常纪","text":"山苍苍，云茫茫，归路马蹄忙。\n凉风吹细雨，寒草绿荒冈。\n画眉声里松杉道，何处青山是晋阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8544,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西充道中","author":"常纪","text":"斗石坡陀山径，淡云乔木苍烟。\n数家不成村落，遥倚清流涧边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8545,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"予至西充三岁矣初见大雪喜为长歌","author":"常纪","text":"蜀地气暖无寒冰，连山积雪更未曾。\n每忆吾乡三冬节，峰岚满眼玉崚嶒。\n一官到此已三载，草木青青寒不改。\n纵然微雪亦旋消，那见花飞六出彩。\n今年栗烈北风吼，夜雨潇潇檐溜走。\n梦回乍疑纸窗明，开门雪片大如手。\n无乃天公戏，知是玉龙斗。\n柳絮拟最工，撒盐句真陋。\n琼贝积已多，琅玕压欲仆。\n访戴愧无船，起袁惭未候。\n东岭西岭青松失，千峰万峰玉笋出。\n三白腊前兆丰年，拍手农人笑语溢。\n我亦对之喜洋洋，连云宿麦拟仓箱。\n时和岁稔讼自息，庭前草长罗可张。\n地炉榾柮火通红，酒酣耳热气更雄。\n安得快马高缠鬃，手挽六石霹雳弓。\n杀伐狐兔无留踪，归来满马誇吾翁。\n嗟予家世本辽东，对此茫茫意何穷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8546,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杂兴十五首 其一","author":"常纪","text":"南山当户晓巃嵷，百丈浮图插碧空。\n云走遥天何处雨，鸟鸣高树恰来风。\n午花摇影千枝亚，峭石分流一带通。\n最是门前丛柳处，横桥曲折岸如弓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8547,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杂兴十五首 其二","author":"常纪","text":"春盎园林似酒浓，为贪午睡岂常慵。\n卧看花坞斜阳度，坐爱书窗树影封。\n篱下雀驯还踆踆，盆中鱼戏自喁喁。\n挥毫方欲成新赋，风送涛声上小松。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8548,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杂兴十五首 其三","author":"常纪","text":"濯足清流踞石矼，沿溪聊复觅香茳。\n融融天气云生片，漠漠林烟鸟去双。\n草径逢人行且语，寺钟隔树止还撞。\n閒情于世知无益，叵耐诗魔未肯降。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8549,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杂兴十五首 其四","author":"常纪","text":"几处衡门飏酒旗，绿杨马系拂墙枝。\n遥怜游子飞征盖，深喜农夫唱野词。\n松有清音摇麈尾，石饶奇气立河湄。\n水田飞鹭思何妙，领略维摩七字诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8550,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杂兴十五首 其五","author":"常纪","text":"倚杖閒观对落晖，四山烟霭暮霏霏。\n鸦来何处鸣巢树，鸥解无人立钓矶。\n横笛声才随犊下，晚炊香恰荷锄归。\n欣欣万物私能遂，我自吟诗任是非。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8551,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杂兴十五首 其六","author":"常纪","text":"不游城市爱山居，问答何妨樵与渔。\n眼底烟霞常自在，閒时日月莫教虚。\n行登虎迹危岑上，伏览龙兴战垒馀。\n幸际承平天地阔，行藏何用自踌躇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8552,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杂兴十五首 其七","author":"常纪","text":"前溪新涨接村隅，选胜森林坐绿芜。\n枝无漏日蝉先到，波有閒云人与俱。\n白鹭远飞堪目送，青山独对足心娱。\n长烟丛苇苍茫处，知有渔人系钓舻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8553,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杂兴十五首 其八","author":"常纪","text":"午钟初罢午鸡啼，一榻清幽任我栖。\n篱豆花香新艾纳，墨池水染古玻瓈。\n小狸扑蝶还窥影，巧燕成巢不堕泥。\n阶草自生窗外绿，人非茂叔也萋萋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8554,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杂兴十五首 其九","author":"常纪","text":"一自归来别等侪，村居真不负青鞋。\n烟波浩荡堪怡性，云物鲜新任放怀。\n多为乡邻斟浊酒，不思门第植高槐。\n北窗倦息开书卷，自取诗篇削不谐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8555,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杂兴十五首 其十","author":"常纪","text":"眠起疏窗拂晓开，一帘花雨滴苍苔。\n色凝夜露盈盈艳，香入晨风细细来。\n鸟有欢声占气候，门无杂客任蒿莱。\n昨诗更理呼烹茗，缥缈松烟出壁隈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8556,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杂兴十五首 其十一","author":"常纪","text":"山簇青螺树拥津，一回帘捲一回新。\n湿云初敛经宵雨，小艇频来趁市人。\n未访赤松随采药，敢希清渭独垂纶。\n文章假我知何尽，日用聊同耕凿民。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8557,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杂兴十五首 其十二","author":"常纪","text":"山之薇蕨涧之芹，春满溪山作绿云。\n认自葩经知可食，采随樵子信多芬。\n尝新岂少田园美，适野聊为手足勤。\n筐筥自携归且咏，閒花满地任纷纷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8558,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杂兴十五首 其十三","author":"常纪","text":"晨起荷池长旧痕，始知夜雨过山村。\n檐花全绽连枝蕊，篱豆初生著土根。\n洗砚忽看磨处薄，曝书尤胜读时温。\n掩关无复人来往，蝶自纷飞鸟自喧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8559,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杂兴十五首 其十四","author":"常纪","text":"四月深村尚峭寒，北风未许著衣单。\n药栏有信香何閟，桐叶逢馀岁尚宽。\n园畔旧畦留雪迹，山头野烧入云端。\n香温茶熟浑无睡，新句推敲到夜阑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8560,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杂兴十五首 其十五","author":"常纪","text":"一身飘然住人寰，閒事閒心竟不闲。\n勤捲疏帘通燕燕，自疏活水听潺潺。\n丁宁不住一林鸟，应接无穷万点山。\n良夜月来清可喜，未容早教小扉关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8561,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杂兴 其一","author":"常纪","text":"平畴远陌蔚蓝天，长日风恬霁景妍。\n花满田塍石季锦，水鸣沙濑伯牙弦。\n松溪柳径多盘折，竹杖芒鞋任往还。\n小憩听莺宁有倦，支颐高枕石头边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8562,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杂兴 其二","author":"常纪","text":"展眺衡门十里遥，沙堤行水到村桥。\n平芜绿尽青山尾，远寺红藏碧树腰。\n三径旧栽处士菊，一株新得美人蕉。\n习劳不择閒花草，抱瓮沿篱取次浇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8563,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杂兴 其三","author":"常纪","text":"曲池掬水沃清泠，岸静波恬眼顿醒。\n风绉细纹浮日彩，柳垂深影拂天青。\n花光镜里还屏里，云气山形复兽形。\n渔子机心颇未忘，不妨鸥鹭自梳翎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8564,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"初春晚眺","author":"常纪","text":"峭寒犹腊日，晚眺觅春光。\n雨点千峰雪，烟笼万木霜。\n落霞归极浦，残照度危梁。\n咫尺故人隔，林乌空自翔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8565,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"溪上偶成","author":"常纪","text":"野度平沙岸，清波曲折流。\n板桥三叠合，冰鉴一泓收。\n蘋白桃花浪，泥香燕子洲。\n兴来怀古调，无语对群鸥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8566,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赋得老树著花无丑枝","author":"常纪","text":"老树妍于丑，新花不断生。\n疏枝宜冷艳，劲气发春荣。\n柔冶愁风雨，山川见性灵。\n广平能作赋，铁干有菁英。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8567,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赋得轻燕受风斜","author":"常纪","text":"澹荡和风细，差池海燕轻。\n纤姿翻紫翮，逸态度青苹。\n自觉泠然善，非同翩若惊。\n由来天地阔，任尔自飞鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8568,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆癸酉春夏与奉峨兄读书于城南之保安寺甚自得也时有秦先生者山东快士喜堪舆精占卜聚谈者屡遂订交焉今日各有所就而风流云散如此追感不胜惘惘因赋绝句九首呈奉峨兄 其一","author":"常纪","text":"偃蹇名场弟似兄，未堪拔帜附群英。\n为贪五夜连床语，失却当年贡士名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8569,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆癸酉春夏与奉峨兄读书于城南之保安寺甚自得也时有秦先生者山东快士喜堪舆精占卜聚谈者屡遂订交焉今日各有所就而风流云散如此追感不胜惘惘因赋绝句九首呈奉峨兄 其二","author":"常纪","text":"壮志经摧未肯降，且从禅室借芸窗。\n满檐花雨廉纤夜，荷檠膏焚白锡釭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8570,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆癸酉春夏与奉峨兄读书于城南之保安寺甚自得也时有秦先生者山东快士喜堪舆精占卜聚谈者屡遂订交焉今日各有所就而风流云散如此追感不胜惘惘因赋绝句九首呈奉峨兄 其三","author":"常纪","text":"饭后曾行百步工，逍遥塔院听松风。\n古碑遗像摩娑遍，共倚閒墙数落红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8571,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆癸酉春夏与奉峨兄读书于城南之保安寺甚自得也时有秦先生者山东快士喜堪舆精占卜聚谈者屡遂订交焉今日各有所就而风流云散如此追感不胜惘惘因赋绝句九首呈奉峨兄 其四","author":"常纪","text":"无边光景赴晴窗，底事多求健笔扛。\n瓦雀忘机得静趣，閒行书案一双双。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8572,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆癸酉春夏与奉峨兄读书于城南之保安寺甚自得也时有秦先生者山东快士喜堪舆精占卜聚谈者屡遂订交焉今日各有所就而风流云散如此追感不胜惘惘因赋绝句九首呈奉峨兄 其五","author":"常纪","text":"碧桃红杏紫丁香，解作芬芳润帙缃。\n最喜催诗一夜雨，兴来齐上悟禅房。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8573,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆癸酉春夏与奉峨兄读书于城南之保安寺甚自得也时有秦先生者山东快士喜堪舆精占卜聚谈者屡遂订交焉今日各有所就而风流云散如此追感不胜惘惘因赋绝句九首呈奉峨兄 其六","author":"常纪","text":"一带清溪涌碧沙，春閒无事柳飞花。\n题诗分韵松涛侧，好句难忘色斗鸦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8574,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆癸酉春夏与奉峨兄读书于城南之保安寺甚自得也时有秦先生者山东快士喜堪舆精占卜聚谈者屡遂订交焉今日各有所就而风流云散如此追感不胜惘惘因赋绝句九首呈奉峨兄 其七","author":"常纪","text":"淋漓放笔类春流，更望缫丝细细抽。\n直到江郎才尽日，才知更上一层楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8575,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆癸酉春夏与奉峨兄读书于城南之保安寺甚自得也时有秦先生者山东快士喜堪舆精占卜聚谈者屡遂订交焉今日各有所就而风流云散如此追感不胜惘惘因赋绝句九首呈奉峨兄 其八","author":"常纪","text":"先生异数自通微，妙卜先天竟不违。\n云碧秋空生五色，果然万里看鹏飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8576,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆癸酉春夏与奉峨兄读书于城南之保安寺甚自得也时有秦先生者山东快士喜堪舆精占卜聚谈者屡遂订交焉今日各有所就而风流云散如此追感不胜惘惘因赋绝句九首呈奉峨兄 其九","author":"常纪","text":"迩来咫尺叹离居，便欲相从未有期。\n何日一樽桑落酒，灯明杯满话新词。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8577,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清溪","author":"常纪","text":"清溪一曲抱山村，野岸平收泻碧痕。\n浴罢閒鸥无别事，每将盟侣宿云根。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8578,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居偶成","author":"常纪","text":"辜负田园春复春，廿年竟作浪游人。\n归来野草荒三径，别后新枝盖四邻。\n柳结浓阴薰暖日，花含静态笑红尘。\n西畴有事偷馀暇，玩易閒窗乐性真。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8579,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"村居杂咏四首 其一","author":"常纪","text":"黜落今如此，归来洽素衷。\n一邱原自足，三径复谁同。\n濯足沧浪水，开怀君子风。\n野花随处好，时插帽檐红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8580,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"村居杂咏四首 其二","author":"常纪","text":"昔是名场士，今为识字农。\n菜畦时自灌，米臼看人舂。\n饮马登危岸，饟耕荫古松。\n由来辨菽麦，不欲老书佣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8581,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"村居杂咏四首 其三","author":"常纪","text":"晨起踏晴沙，行行入晓霞。\n无人结伴侣，有径到桑麻。\n燕掠挥锄草，蜂随覆陇花。\n如何无限景，一向付山家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8582,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"村居杂咏四首 其四","author":"常纪","text":"雨过山塘静，晴郊望欲迷。\n乱流逐水马，断岸聒田鸡。\n天迥遥峰淡，云深塞树低。\n老僧同杖履，偶语夕阳堤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8583,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和咏新居","author":"常纪","text":"每过柴桑处士居，山重水复致偏馀。\n烟深野渡孤舟静，云压横冈纲雨疏。\n大壑东来还北转，叠峰西起复南纡。\n此间佳胜无人识，恰好先生置草庐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8584,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]