[{"title":"题张仙根历代宫闱杂事诗卷 其二","author":"丘逢甲","text":"吟遍宫花字亦香，消磨九十好韶光。\n填胸百代兴亡感，写入新词独擅场。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33189,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题张仙根历代宫闱杂事诗卷 其三","author":"丘逢甲","text":"燕瘦环肥笔底来，重翻古案隶新裁。\n玉钩斜畔香魂笑，又费人间点鬼才。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33190,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题张仙根历代宫闱杂事诗卷 其四","author":"丘逢甲","text":"体兼正变古风诗，胡帝胡天更见之。\n从此再开诗世界，五洲万国著宫词。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33191,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梅州喜晤梁辑五光禄话旧 其一","author":"丘逢甲","text":"剪烛寒窗夜论文，愁来豪气尚干云。\n平生最爱颜光禄，刊落山王咏五君。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33192,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梅州喜晤梁辑五光禄话旧 其二","author":"丘逢甲","text":"小隐城西旧草庐，忧时未合老闲居。\n一家渊雅能才语，黄叶空山自著书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33193,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梅州喜晤梁辑五光禄话旧 其三","author":"丘逢甲","text":"一篇干宝托搜神，叫阖排云语最真。\n鹑首剪来天已醉，书生何策抗强秦？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33194,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次韵陈汝臣见赠 其一","author":"丘逢甲","text":"落魄犹留文字缘，琴音海上断成连。\n眼前世事饶堪醉，待续陶潜饮酒篇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33195,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次韵陈汝臣见赠 其二","author":"丘逢甲","text":"梅花数点见天心，寒入山村雪意深。\n想见闭门人觅句，暗香疏影伴沈吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33196,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次韵陈汝臣见赠 其三","author":"丘逢甲","text":"新诗赠我灿瑶章，一读能教气一扬。\n自笑朗吟人已识，仙踪韬晦愧纯阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33197,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次韵陈汝臣见赠 其四","author":"丘逢甲","text":"漠漠寒云雁叫群，哀吟楚些怨湘君。\n乾坤牢落诗人老，何日苍头起异军？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33198,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次韵仙官诗","author":"丘逢甲","text":"一谪人间久未归，茫茫世界铁山围。\n神州剖裂齐烟小，古井荒凉汉火微。\n万岁鳌番饥可钓，五更熊梦老犹飞。\n何当整顿乾坤了，金阙重朝愿未违？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33199,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次韵仙官七言古诗","author":"丘逢甲","text":"古皇手造今山川，云斤月斧劳诸仙。\n群魔忽撼天枢颠，鸾惊尘骇纷翩跹。\n乌藏兔匿难高悬，海水上没昆仑巅。\n黑风滚滚吹腥膻，神州逼迫艰回旋。\n微臣矢愿康逆邅，绿章排云奏九天。\n上鼓雷鼓鞭电鞭，广乐未散钧天筵。\n濛濛俯瞰齐州烟，末劫重转龙汉年。\n赐臣玉策策万全，辅似仙力呼乔佺。\n神勇凌厉方无前，赤县奠定黑海鲜。\n万万蚁命苏颠连，群魔藉作驱除先。\n虎熊狼豺供猎田，道高魔退完仙缘。\n烧天劫火火不然，手持世界还圣贤，天枢八大仍高坚。\n吁嗟乎！\n万灵感颂吾皇功德真无边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33200,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题刘生廉让居图 其一","author":"丘逢甲","text":"一角青山世外天，家邻让水与廉泉。\n不妨向帝夸臣宅，身是南朝范柏年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33201,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题刘生廉让居图 其二","author":"丘逢甲","text":"自将廉让署吾庐，五百年来此卜居。\n满眼风波津渡懒，万荷花里读仙书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33202,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"联仙蘅观察和怀古诗韵次答 其一","author":"丘逢甲","text":"义旗风捲海东头，浪迹来为汗漫游。\n亡宋地难存岛国，瞻韩人喜到潮州。\n论交文字三生业，凭吊江山万古愁。\n满眼狂澜嗟已倒，待公重障百川流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33203,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"联仙蘅观察和怀古诗韵次答 其二","author":"丘逢甲","text":"剩水残山夕照中，星幡无力御东风。\n麻姑去后桑栽海，箕子归来黍满宫。\n缩地有人工幻术，笺天何处效愚忠？\n与公欲话千秋恨，待剪衙斋烛泪红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33204,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"叠前韵答联仙蘅观察 其一","author":"丘逢甲","text":"风霜欲白少年头，消耗豪情作浪游。\n劝驾幸逢中执法，悲歌宜向古幽州。\n伯鸾心事原难热，洗马平生始识愁。\n莫怪安巢无处所，眼前沧海正横流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33205,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"叠前韵答联仙蘅观察 其二","author":"丘逢甲","text":"只手重扶日再中，垓埏畅溯被皇风。\n四洲受吏朝三殿，万岛输珍进两宫。\n独惜在山虚远志，未能报国愧精忠。\n仗公与慰平生愿，极目江霞散晚红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33206,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题之海画扇","author":"丘逢甲","text":"南飞乌鹊苦无枝，极目沧波绕梦思。\n横槊赋诗豪气在，可堪重对月明时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33207,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次陈颐山见赠韵答之","author":"丘逢甲","text":"读罢新诗泪满巾，乾坤苍莽正风尘。\n五洲消息纷传线，万里梯舵竞驾轮。\n朝议朱崖伤弃地，边烽辽海厄归人。\n相逢莫话流离感，未死终留报国身。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33208,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"叠前韵呈颐山先生并上许仙屏中丞","author":"丘逢甲","text":"风流又见玉台巾，挥麈还同话劫尘。\n东阁上宾新设醴，南州大雅久扶轮。\n荐衡文举行修表，用赵廉颇待得人。\n四海苍茫浑未定，乾坤何地著间身。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33209,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闻言者屡有改科举之议，叠颐山见赠韵，简温慕柳同年金山书院","author":"丘逢甲","text":"金缯局定厌儒巾，胡服群思逐后尘。\n朝议颇闻图改制，台纲原不重埋轮。\n四筵抵掌东坡鬼，一网惊心朔党人。\n幸有遗经吾道在，山林终老著书身。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33210,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"奉题仙屏中丞舟行杂咏诗卷，并以留别 其一","author":"丘逢甲","text":"岭峤行班万里春，西庄花草倍精神。\n天涯诗卷供怀旧，江上旌旗到奉新。\n骨肉团圆乡里乐，知交绳绻性情真。\n海南翘首瞻卿月，老友于今是部民。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33211,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"奉题仙屏中丞舟行杂咏诗卷，并以留别 其二","author":"丘逢甲","text":"章江流汇贡江清，官舫银灯吊古情。\n如此英雄犹讲学，本来儒者总知兵。\n枢臣不掣先生肘，父老咸知新建名。\n此去正衔巡抚命，匡时端合比文成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33212,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"奉题仙屏中丞舟行杂咏诗卷，并以留别 其三","author":"丘逢甲","text":"风义文章世共知，宾萌初喜谒幨帷。\n恩纶南峤新移节，健笔西江嫡派诗。\n榕叶雨过铃阁静，梅花月度戟门迟。\n英辞读罢人将别，狮海茫茫缆再维。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33213,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"颐山农部为作朝台吊古图于箑并题一律，次韵答之","author":"丘逢甲","text":"岭南雄直气，老笔未曾颓。\n台榭冷秋色，江山沈霸才。\n树从秦代古，花是汉时栽。\n落日此舒写，萧萧风雨来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33214,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"仙屏中丞见和前诗，感事述怀，叠韵奉答 其一","author":"丘逢甲","text":"黄尘遮断海天春，劫外馀生倍怆神。\n国岂尚文方积弱，士争横议欲维新。\n陆沈应咎王夷甫，道隐思为贺季真。\n鹿走鸿哀嗟满目，更谁抗疏恤遗民。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33215,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"仙屏中丞见和前诗，感事述怀，叠韵奉答 其二","author":"丘逢甲","text":"凉波渺渺粤江清，去国怀乡此日情。\n帘下君平宜卖卜，酒边同父尚论兵。\n上书曾陨孤臣泪，怀刺新投钓客名。\n一事告公同叹息，不如蠡种是行成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33216,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"仙屏中丞见和前诗，感事述怀，叠韵奉答 其三","author":"丘逢甲","text":"天南寥落得新知，讲学仍思更下帷。\n四海有人休痛哭，九州无事且谈诗。\n贲隅桂树秋风早，大庾梅花腊雪迟。\n但有当归宜寄赠，不须远志说羌维。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33217,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"再叠前韵，奉答仙屏中丞 其一","author":"丘逢甲","text":"无计消愁且买春，戴山鳌竟失三神。\n中原正统终存汉，绝代雄文岂美新？\n黄石别来书未熟，朱崖弃后梦难真。\n连天烽火秋风急，怕忆穿胸贯耳民。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33218,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"再叠前韵，奉答仙屏中丞 其二","author":"丘逢甲","text":"径欲笺愁上紫清，可能太上竟忘情。\n伤心灾异刘中垒，冷眼英雄阮步兵。\n三古以来此奇变，九州之外莫逃名。\n千秋碧血依然热，苌叔违天志傥成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33219,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"再叠前韵，奉答仙屏中丞 其三","author":"丘逢甲","text":"沈郁雄心公已知，胥涛声急撼秋帷。\n哀思故国兰成赋，丧乱中年杜老诗。\n径儗神方寻许迈，漫将文笔赏丘迟。\n西风独洒伤时泪，沦落天涯愧絷维。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33220,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"乞李晴帆画珠江泛月图","author":"丘逢甲","text":"风尘潦倒五羊秋，曾作珠江泛月游。\n乞写天南无限感，英雄儿女一齐愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33221,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"烈妇墩行","author":"丘逢甲","text":"琼箫声断珠桐枯，碧城月冷雌鸾孤。\n惊风斗挟换巢去，妖鸟朋扇凄宵呼。\n满地愁澜汨古井，阴云墨掩明星影。\n宝鉴尘霾珍剃散，彩舆碧溅蝤蛴领。\n琼花夜坠金剪光，贞魂步月珠尘香。\n皇笳天远起比翼，北山鬼泣罗难张。\n风雨灵旂回紫府，镵刻青珉表黄土。\n春鹃吊月坟林昏，贞蕤满墩郁终古。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33222,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海军衙门歌，同温慕柳同年作","author":"丘逢甲","text":"大东沟中炮声死，旅顺口外逃舟驶。\n刘公岛上降幡起，中人痛哭东人喜。\n旁有西人竞嗷訾，中国海军竟如此。\n衙门主者伊何人，万死何辞对天子！\n坐縻廿三行省万万之金钱，经营惨淡三十年。\n衙门循例保将领，翠翎鹤顶何翩翩！\n南军北军合操日，炮云蓊起遮苍天。\n群轮辗海迷青烟，谓此足当长城坚。\n一东人耳且不敌，何况西人高掌远蹠纷来前？\n我不能工召洋匠，我不能军募洋将。\n衙门沈沈不可望，若有人兮坐武帐。\n早知隶也实不力，何事挥金置兵仗？\n战守无能地能让，百万冤魂海中葬。\n购船购炮仍纷纷，再拚一掷振海军。\n故将逃降出新将，得相从者皆风云。\n风云黯淡海无色，大有他人鼾吾侧。\n楼船又属今将军，会须重铸六州铁。\n宝刀拜赐趋衙门，军中岂知天子尊？\n敛缩海界张军屯，海风画啸龙旗翻。\n天吴海若群飞奔，阴符秘授鬼莫测。\n何取书生纸上之空言？\n噫吁乎，书生结舌慎勿言，衙门主者方市权。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33223,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"烈妇篇为广东候补从九品冯景釐继室方孺人作","author":"丘逢甲","text":"孤鸾血苦胶不坚，哀丝夜断凄冰弦。\n飞花满眼葬红泪，东风嫁杏愁笺天。\n珠纬周天岁未满，银浦双星宝华散。\n誓骖赤虬朝玉清，手取千秋付彤琯。\n湘筠茁节移越山，灵妃血泪流春斑。\n婿乡近种连理树，萎花病叶枝官闲。\n食厉女媊呼不应，返生仙药愁难请。\n灵幡闪闪开道场，夜半瑶空幻鸾影。\n女家家富千缥缃，琼缨瑶帨蒸古香。\n蕤编铸出此奇女，勃郁书气生贞光。\n我弄南珠向瀛岛，遗芬亲听群真道。\n待扶娲石镌贞名，撑拄阴天天不老。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33224,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题俞伯惠呆人听瀑图","author":"丘逢甲","text":"空山自具太古瀑，处世尽为天下呆。\n尘根久净耳非耳，道旨中存材不材。\n庐阜恶诗昔早洗，苏州监本今重开。\n丹青莫道少真意，展卷万壑喧风雷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33225,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"伯惠以其先人禹勤刺史柳阴洗马图索题，为赋四绝 其一","author":"丘逢甲","text":"东南立马阵云寒，杨柳春风解玉鞍。\n半壁山河行奠定，不妨闲向晚凉看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33226,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"伯惠以其先人禹勤刺史柳阴洗马图索题，为赋四绝 其二","author":"丘逢甲","text":"刷马江洲意气豪，中原战罢脱征袍。\n柳花黄扑桃花紫，看蹴春流起怒涛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33227,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"伯惠以其先人禹勤刺史柳阴洗马图索题，为赋四绝 其三","author":"丘逢甲","text":"闲写丹青定自怜，一州斗大当凌烟。\n千金市骏空相惜，如此英雄负少年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33228,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"伯惠以其先人禹勤刺史柳阴洗马图索题，为赋四绝 其四","author":"丘逢甲","text":"攀条还共感遗芬，难挽天河洗战云。\n汗马无功桑海变，题诗人是故将军。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33229,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次韵陈衡仲招饮可园","author":"丘逢甲","text":"理废锄荒花自栽，阴晴梅气长阶苔。\n官闲座客谈诗集，吏散园丁取事回。\n把酒喜逢江月满，传笺忙逐岭云开。\n凭君莫话沧桑劫，横槊雄心百感来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33230,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"衡仲以西瓜见饷，兼约可园赏月 其一","author":"丘逢甲","text":"蕴雪含冰泌齿凉，两团绿玉许分尝。\n浮瓜待作南皮会，去赴新亭看月光。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33231,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"衡仲以西瓜见饷，兼约可园赏月 其二","author":"丘逢甲","text":"荐玉春盘海有氛，故侯门巷冷秋云。\n金刀欲下踌躇甚，多恐神州似此分。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33232,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题冰霜俪洁图","author":"丘逢甲","text":"梅仙独步凤城月，雪冷冰寒鍊花骨。\n瑶琯吹回天地春，黯黯峤云古香发。\n使星南耀珠璧光，镌贞玉榜俪冰霜。\n图花表意出鸾手，琼华铁干生幽芳。\n祝梅千春寿无极，群真遍洒金壶墨。\n仙雏声彻闻绛宵，伫见璇题贲香国。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33233,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送黄翼臣秋试 其一","author":"丘逢甲","text":"瀛海无波桂殿秋，送君去作广寒游。\n嫦娥正织登科记，看取题名最上头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33234,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送黄翼臣秋试 其二","author":"丘逢甲","text":"盛事流传记昔贤，橡花红遍岭东天。\n神州苍莽英雄出，不为科名合著鞭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33235,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题陈衡仲可园图","author":"丘逢甲","text":"天下事今无一可，多君犹以可名园。\n壶觞清雅诗人集，树石苍凉古意存。\n半载经营全局活，百花供养一官尊。\n闲情且向丹青写，落日秋城海气昏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33236,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄家菽园孝廉","author":"丘逢甲","text":"翠暖珠香侍舞筵，七洲洋外辟诗天。\n华灯夜敞红云宴，吟钵朝飞白雪篇。\n胸次难消兵十万，眼中同醉客三千。\n高歌自抱神州感，漫作寻常侠少年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33237,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"长至日张景唐少尉以所著地理辨正再疏见示，为题册首","author":"丘逢甲","text":"五色云光久黯然，玉函空叹失家传。\n喜逢剥复循环日，快读阴阳相宅篇。\n上古龟龙亡秘谶，中原蛟蜃遍腥涎。\n抗怀欲说全球势，两运同交待十年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33238,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闻胶州事书感","author":"丘逢甲","text":"汉家长策重和亲，重译传经许大秦。\n祆庙屡闻生愤火，蓬山又见起边尘。\n青州酒断愁难遣，黄海舟迟信未真。\n慷慨出门思吊古，田横岛上更何人？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33239,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答王贡南同年 其一","author":"丘逢甲","text":"浩浩天风入素琴，刺船人去有遗音。\n不须更恨神山远，留取相思海样深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33240,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答王贡南同年 其二","author":"丘逢甲","text":"弱水三神仙有劫，灵山一会佛无缘。\n何当再结人天果，铜狄摩挲五百年？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33241,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答王贡南同年 其三","author":"丘逢甲","text":"杨柳鹃声荡古愁，陆沈无力挽神州。\n不如同学希夷蛰，梦醒梁唐晋汉周。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33242,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答王贡南同年 其四","author":"丘逢甲","text":"十载空随侠客装，扶馀何处有真王？\n火龙天遁真吾法，万里西风曳剑光。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33243,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"纪梦诗","author":"丘逢甲","text":"知是前身与后身，诸天变现起微尘。\n人间无此丹青本，幻出崟崎历落人。\n梦中因果画中身，弹指心惊隔两尘。\n天上碧桃花再放，下方还是未归人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33244,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"贤母诗为家幼春、亦春茂才令慈黄太孺人作","author":"丘逢甲","text":"昔为孝妇今慈母，三十年来节义垂。\n贼刃不伤缘至性，父书能读训诸儿。\n缫丝自谨闺门礼，彻瑱欣闻泮水诗。\n欲表女宗亲拜手，奉笺遥侑寿筵卮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33245,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答台中友人","author":"丘逢甲","text":"闻君犹采首山薇，欲话中原泪满衣。\n四海共推天子圣，百年难复大朝威。\n玩刑民托祅神教，避税商悬异国旗。\n一样已无乾净土，可怜扶义说西归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33246,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠池滋膺同年 其一","author":"丘逢甲","text":"飞凫初下五云端，兼领雷封表海宽。\n两邑万家歌管乐，三山千里板舆安。\n瀛洲旧授神仙职，岭峤真推父母官。\n闻说讼稀亲课士，满城桃李共腾欢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33247,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠池滋膺同年 其二","author":"丘逢甲","text":"天生卓茂佐中兴，循吏由来未易称。\n百里清平枹鼓息，九重褒异玺书徵。\n注衔玉署头冰在，话故金城鬓雪增。\n愧说瑞安门下士，上方空请一无能。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33248,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"刘彤轩以画梅及诗卷见赠，用卷中过梅岭韵答之 其一","author":"丘逢甲","text":"载酒名园取次过，江城无奈落花何！\n天涯幸有生春手，写出南枝雪意多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33249,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"刘彤轩以画梅及诗卷见赠，用卷中过梅岭韵答之 其二","author":"丘逢甲","text":"万里归槎客写梅，海云浓处墨花开。\n年来羹鼎因和误，孤负春风说占魁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33250,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"刘彤轩以画梅及诗卷见赠，用卷中过梅岭韵答之 其三","author":"丘逢甲","text":"洒洒春痕满笔端，罗浮梦断客衣寒。\n卷中诗句都清绝，合与梅花一例看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33251,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]