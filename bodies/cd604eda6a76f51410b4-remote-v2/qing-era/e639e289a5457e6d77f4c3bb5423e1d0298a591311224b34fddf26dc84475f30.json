[{"title":"送友人归苏门 其一","author":"宋荦","text":"送子故山去，苏门寻啸台。\n遗音想鸾鹤，古屋扫莓苔。\n砌下百泉沸，窗中千嶂开。\n飘然欲一往，惆怅离筵杯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6755,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送友人归苏门 其二","author":"宋荦","text":"平生怀有道，引领夏峰村。\n尔去枌榆社，还经薜荔门。\n清风留梦寐，白首课儿孙。\n挥手潞亭畔，绿槐晴鸟喧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6756,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"黄山松石歌寄金仁叔将军兼索子湘和","author":"宋荦","text":"黄山松石天下无，好事往往绘作图。\n千岩万树不到眼，刻意摹写徒区区。\n茸城将军胸次别，远道移取来崎岖。\n石一拳耳俨千仞，松不满尺盘两株。\n盛以巨盎置铃阁，珍比七尺红珊瑚。\n今年移镇向闽海，临行辍赠及老夫。\n鸭觜船载入廨舍，宾客咋舌儿童呼。\n吟窝得此良不俗，大笑今我官岂粗。\n南荣相对坐竟日，看山读画同欢娱。\n石也以松为毛发，松亦以石为肌肤。\n芙蓉一片忽堕地，陵峦宛转秀色殊。\n扰龙双干双麈尾，千霄之势当前俱。\n晋卿倘见定豪夺，柴桑或抚还惊吁。\n丛桂疏梅助清致，何烦命驾穷天都。\n将军雅意应有报，几回欲赋还踟蹰。\n今晨鼓兴了此债，属和火急催髯苏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6757,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和子湘春雪后夜坐效韦左司","author":"宋荦","text":"梅花半将开，媚此雪后月。\n空亭耐春寒，坐到昏钟歇。\n池光明檐楹，鹤唳激林樾。\n幽人默相对，诗思清到骨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6758,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"白云泉","author":"宋荦","text":"迢迢白云泉，一线吐岩腹。\n涓净涵莓苔，凄清韵琴筑。\n时有白头僧，持瓢到幽谷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6759,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送汪陛交入都兼寄阮亭尚书","author":"宋荦","text":"白发渔洋老，风流众所师。\n好同天下士，去和济南诗。\n霄汉县清梦，云山失旧期。\n沧浪倘相问，道我泛涟漪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6760,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过银锭桥旧居","author":"宋荦","text":"鼓楼西接后湖湾，银锭桥横夕照闲。\n不尽沧波连太液，依然晴翠送遥山。\n旧时院落松槐在，仙境笙簧岁月闲。\n白首鍊师茶话久，春风料峭暮鸦还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6761,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"初至西陂寄长安诸子用东陂松风亭韵","author":"宋荦","text":"有脚不踏渌波村，清境往往萦梦魂。\n今年得请返旧隐，烟水顿洗双眸昏。\n堂开鱼麦宛世外，略彴近接乐春园。\n穿花时见孤鹤舞，倚石偶把残书温。\n空亭林月散清影，祇疑海上升朝暾。\n孤篁行药遵野岸，扁舟吹笛归衡门。\n故人天末几怅望，得句难共伧父言。\n沧浪琴僧期过我，西陂春熟开芳尊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6762,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过北兰寺 其一","author":"宋荦","text":"豆棚连曲牖，竹径转虚堂。\n图史心无著，茶瓜味总长。\n观泉嗟面皱，踏阁爱山苍。\n白袷凭栏处，松风作意凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6763,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过北兰寺 其二","author":"宋荦","text":"别圃从容过，回冈更有亭。\n沙痕浮日白，山色印江青。\n列岫承余韵，支颐感客星。\n无须催小队，渔唱暮堪听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6764,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杂诗","author":"卞永誉","text":"孤鸟声啾啾，小虫复唧唧。\n感此心茫然，抚膺长太息。\n视我衾与枕，徘徊不能寝。\n焚膏耀辉光，顾影重自审。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6765,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"远别离","author":"卞永誉","text":"妾理箧中衣，郎买江上舟。\n郎舟尚未发，载满妾心愁。\n郎舟自西去，江水自东流。\n江水流不返，江风吹不住。\n郎作江头风，妾作江头树。\n晓风吹树哀，晚风凄又来。\n树叶若飘泊，妾心空徘徊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6766,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"初秋发夜郎","author":"卞永吉","text":"雾满失前蹊，长林鸟乱啼。\n石危鸣濑急，峰峭断云低。\n客久迷乡梦，星驰促晓鸡。\n秋风何太急，先到夜郎西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6767,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"邗上送人之黄州","author":"卞永吉","text":"故人辞我去，匹马向黄州。\n别绪频攀柳，相思独倚楼。\n江流通汉水，春信接邗沟。\n烽为年来急，迟迟莫浪游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6768,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"八月送友人还山","author":"范承斌","text":"砧声将落叶，淅淅动寒帏。\n秋色来何处，故人今日归。\n远山孤树小，隔水数鸿飞。\n却羡君兄弟，舟中话翠微。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6769,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"除架","author":"范承斌","text":"园霜一夜满，三径豁空扉。\n瓜蔓凉云委，藤阴绿叶稀。\n寒虫徒唧唧，冻雀强飞飞。\n秋意原如此，人生念息机。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6770,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晚泊千墩有感","author":"卢震","text":"野色平烟草，孤村泛海天。\n铎声山顶寺，镫影树中船。\n宿鸟冲残照，征帆落晚烟。\n长途多寂寞，万感忆从前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6771,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"中秋夜遣怀","author":"卢震","text":"芳晨谁共一壶倾，片月孤臣相对清。\n风里萧疏多白发，树间淅沥有秋声。\n梅花羌笛催诗思，远杵寒砧动客情。\n极目凄然怀故里，高堂何日奉瑶觥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6772,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"听雁","author":"卢震","text":"闲窗寂寂映春晖，嘹呖参差听渐微。\n故向羁人头上过，偏从独客舍边归。\n楚南麦长流民返，燕北沙温猎骑稀。\n珍重远投鸡鹿塞，雌雄相保任高飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6773,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"隆教寺","author":"卢震","text":"层峦回合梵王宫，色相楼台烟雨中。\n千树门头盘石磴，一铃殿角语天风。\n林栖孤鹤樵僧返，山拥重云野寺空。\n薄暮疏钟催去客，那禁神骏忆支公。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6774,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送陈其政副使之任广东","author":"卢震","text":"荷风柳露飏双旌，杯酒酬君出凤城。\n江上锦帆鹦鹉唤，岭头龙节荔枝迎。\n烟消瘴地花多种，山耸蛮天驿几更。\n回首洛阳春易老，可能频念故人情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6775,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闲居杂咏","author":"卢震","text":"木杪西风禁乱鸣，索居此日叹浮名。\n酒能痛饮黄金尽，事较粗知白发生。\n岁月堪悲同宋玉，行藏何必问君平。\n远来嘹唳衡阳雁，笑尔劳劳历百城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6776,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏古玉镜","author":"王遵坦","text":"世间铜臭久尘埋，圆璧千年出洛街。\n晓步相随双凤佩，晚妆应照九鸾钗。\n微茫斑驳云生面，错落光明月入怀。\n最好琼楼伴仙子，素娥斜捧上瑶阶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6777,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九日同高念东在衡及从子敷政游丰台","author":"王樛","text":"未恨途穷阮步兵，路讹偏喜惬幽情。\n寒流静抱孤村碧，平楚遥连晚照明。\n秋色近知为圃乐，病身差幸出游轻。\n何年淄水盘山道，共话南塘九日行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6778,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夏日","author":"王樛","text":"暑气侵人难久卧，夕阳故故度窗纱。\n不如散发浓阴下，细看游鱼饵落花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6779,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"八月十一饮敬兹寓归与信涉仲美坐小园葡萄疏影如画复小酌数盏漫赋一律柬念东","author":"王樛","text":"柳丝摇落叹金城，深夜怀人华发生。\n过雨疏烟浓树影，乍寒脱叶起秋声。\n酒徒未欲论升斗，傲吏惟应隐姓名。\n长羡鹿门多旧侣，沿溪踏月看秋耕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6780,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"行赵堡口寄念东","author":"王樛","text":"黄沙漠漠近幽燕，泽国心惊物候偏。\n远浦送帆初灭影，夕阳到水欲生烟。\n时名愧我甘牛后，归计多君在雁前。\n倘遇相思须载酒，南溪柳外听潺湲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6781,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题垂钓图","author":"龚佳育","text":"无心随处便为家，渺渺伊人水一涯。\n翻笑秦民太多事，沿溪何必种桃花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6782,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"楚中秋思","author":"张宸","text":"日落长沙枫树红，断猿啼处暮云空。\n可知昨夜乡关梦，身在寒烟万点中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6783,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"越中秋思 其二","author":"张宸","text":"八月江湖起暮寒，青枫浦口角声残。\n更吹龙笛家家雨，一夜巴陵去住难。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6784,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将登铜雀台过漳河","author":"张宸","text":"跃马向三台，扬鞭漳水隈。\n寒沙势空阔，独鸟意徘徊。\n旧碛沈铜瓦，秋风起霸才。\n潺湲流不尽，枫荻自悲哀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6785,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"同孝升丈即席次邓孝威见送韵","author":"赵而忭","text":"自信无良策，穷年抱犊衣。\n春携三月去，天放一人归。\n白简谁言事，青山愿息机。\n深思前路好，孤艇送余晖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6786,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南天门","author":"陶之典","text":"巀嶪忽自平，心目一为旷。\n帝座殊未遥，踟蹰碧落上。\n班荆待同游，且与云揖让。\n云起乍平门，林峦失背向。\n飞断万松涛，自成千顷浪。\n仿佛见海蜃，楼阁幻奇状。\n数日迟岳云，对此一元畅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6787,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"洞庭守雪","author":"陶之典","text":"十年湖梦隔，忽向湖中舣。\n洞庭雪耶非，峨眉幻为水。\n水落云势张，沙翻空气委。\n一夜湖雪平，寒光无起止。\n茫茫十二螺，疑被同云徙。\n吹我高寒心，浩入湖波瀰。\n夜色一气中，舟呼素烟里。\n独寤洞庭澜，孤怀向元始。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6788,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浯溪道中","author":"陶之典","text":"横空秋气发，历乱舞山晖。\n楼势摇溪竹，钟声返寺扉。\n谷闻群兕斗，云带断峰飞。\n独有乘风翮，迢迢万里归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6789,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"抵密印寺逢晴","author":"陶之典","text":"望近毗卢旭影重，溪桥一似故人逢。\n百年听老钟声客，千嶂颜开佛日冬。\n全染名山成锦绣，只留新雪辨芙蓉。\n雪畴正有商量事，耆旧先来自别峰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6790,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过宾秋园亭","author":"林尧光","text":"策我红藤杖，开君白版扉。\n山亭棕树暗，石磴枳花飞。\n小隐偏危帽，幽寻尚氎衣。\n此时足虾菜，江口子鱼肥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6791,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"文选楼","author":"李经垓","text":"梁祚几何时，斯楼独存久。\n痴哉大法王，舍身如敝帚。\n可怜太子统，痛心独搔首。\n国事日已非，才华空八斗。\n使之践帝位，不至台城丑。\n著意在诗书，满腹苍龙吼。\n小事谬而死，贤不永其寿。\n文快贤士心，楼播词人口。\n今古重斯文，遗像垂孝友。\n瞻礼尽同人，相看自不朽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6792,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望支硎山","author":"李经垓","text":"大士圆通路，岩廊一望间。\n浅深环法水，高下尽灵山。\n孤塔白能立，群松翠可攀。\n支公何处是，日暮采烟还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6793,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜花 其一","author":"李经垓","text":"喜雨催花开，怨雨催花谢。\n问雨雨不知，花开花陵藉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6794,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜花 其二","author":"李经垓","text":"落花飞满衣，似有留人意。\n何处无情风，依然吹落地。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6795,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜花 其三","author":"李经垓","text":"昨朝花正好，今日花已老。\n借问爱花人，落花扫不扫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6796,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"旅夜闻笛","author":"李经垓","text":"乡梦难成付酒杯，谁家长笛耳边催。\n愁人不听伤心曲，说与邻家莫送来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6797,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过襄城石首山","author":"佟凤彩","text":"汝水驱车马，扬鞭指翠屏。\n泉声冲石落，鹤唳隔烟听。\n远树连云淡，微风拂草青。\n轩辕曾问道，留咏寄山灵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6798,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"天门山","author":"佟凤彩","text":"百战生还解佩刀，扁舟东去走江皋。\n鬼神护此千秋石，阊阖开当万里涛。\n白日行空天马过，黑风吹浪海鱼高。\n扪萝直到云烟里，惆怅山灵笑二毛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6799,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晚登保安城西望小顶山","author":"佟凤彩","text":"碧嶂青青翠色横，夕阳直射古荒城。\n乱峰烟锁层层秀，瀑水晴悬的的明。\n鸟弄余辉缘树语，樵迷幽径带云行。\n停骖西望饶佳致，远隔关山忆帝京。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6800,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卧病酬林澹亭","author":"丁炜","text":"轻寒腰带减，窗竹渐离披。\n未得高眠早，常愁退食迟。\n青山秋后梦，黄叶雨中诗。\n酒熟东篱下，君闲可预期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6801,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"甲辰上巳沈康臣过集","author":"丁炜","text":"佳辰须强饮，谁慰寂寥居。\n花柳看憔悴，江山待祓除。\n休文能过我，逸少有遗书。\n且共追觞咏，情深感慨余。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6802,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送唐习之游金陵","author":"丁炜","text":"都亭春霁后，送子复南游。\n箧里仲宣赋，樽前玄礼舟。\n啼莺移苑树，乳燕入江楼。\n故国今如许，清吟且莫愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6803,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"奉陪王贻上登八境台次元韵 其一","author":"丁炜","text":"积年难晤面，今日共登台。\n诗看前人咏，樽因我辈开。\n霜鸿依泽集，星使泛槎来。\n极目江天外，风烟蔽草莱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6804,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"奉陪王贻上登八境台次元韵 其二","author":"丁炜","text":"远水双流合，严城四望孤。\n春潮通野渡，夕鸟下平芜。\n宿雨藏墟市，轻风过舳舻。\n明朝愁欲别，握手缓斯须。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6805,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"新淦舟行","author":"丁炜","text":"城下空江向北流，虔州西上正悠悠。\n柳边过雨鹭窥网，花外夕阳人倚楼。\n渔笛数声愁欲剧，篷窗孤枕梦偏幽。\n一川烟景频来往，每对青山忆旧游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6806,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"元日即事次上官三立大廷尉韵","author":"丁炜","text":"鹓鹭班归彻火城，阳回初啭上林莺。\n嘶风宝骑联镳出，映日宫貂簇锦行。\n柏叶共分春昼酌，梅花独结岁寒盟。\n喜瞻云物新开霁，应念调和属老成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6807,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"献陵怀古","author":"丁炜","text":"同姓占封此地嘉，贤王礼乐有光华。\n当年《大雅》归毛氏，落日遗宫忆汉家。\n鸦啄残红翻柿叶，雁迷浅碧过蘋花。\n翛然立马苍茫外，城角秋深起暮笳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6808,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病起示舍弟韬汝","author":"丁炜","text":"三秋卧病叹支离，冷雨幽窗祇自悲。\n换得衰颜惊鹊镜，移来废砚触蛛丝。\n暂抛世累钟残后，顿起乡心叶落时。\n莫道身慵生事减，池塘犹示惠连诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6809,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"贾谊宅","author":"丁炜","text":"洛阳才子屈长沙，旧宅开残橘柚花。\n天下治安犹痛哭，南方卑湿漫伤嗟。\n霜寒废阁啼妖鵩，日落荒庭集暮鸦。\n千载怀湘同有恨，赋成骚客鬓应华。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6810,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望是故乡行次毛子霞归郢","author":"胡介祉","text":"毛生岂是鸱夷子，何事吴山复楚水。\n子长二十称壮游，梁鸿《五噫》何年始。\n晴川阁上补新图，赤壁矶前吊故垒。\n犹忆金台蹑屐过，白眼那顾公卿屣。\n此时意气徒干霄，击筑声残悲不止。\n卖文卖字知者谁，掉头一旦辞燕市。\n负却金箱五岳行，高踪到处畴能比。\n余也薄宦鄂王城，竹里花间期共倚。\n昨来折柬索新诗，迟君不来真缺事。\n忽闻冲暑归并州，极目烟波渺何许。\n欲采瑶华未得将，盈盈相望人如咫。\n我亦移官向岱东，片帆拟挂秋风里。\n别后相思知若何，江云江树愁无已。\n万叠峰阴听雪楼，晞发高吟想在此。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6811,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过武胜关","author":"胡介祉","text":"万山连不断，断处一关通。\n马踏残烟里，樵归落照中。\n晚云平古道，霜叶舞寒风。\n不尽天涯思，征鸿点碧空。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6812,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西郊","author":"王鑨","text":"霜落松杉劲，场空黍稷收。\n回云余暮雨，古大畏寒秋。\n寂寂村烟断，荒荒野水流。\n兵戈身已老，忍泪向旄丘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6813,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夕阳","author":"王鑨","text":"夕阳衰草伴寒丘，老树阴风吹敝裘。\n月落孤城残角暮，钟鸣旅馆夜心秋。\n独怜处世才无用，翻恨经年战未休。\n剩有东都闲故旧，同携鲁酒上高楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6814,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"马道","author":"魏裔鲁","text":"削嶂通烟雾，攀萝曲径扪。\n银沙走石壁，雪浪漱云根。\n老树垂松子，寒溪长竹孙。\n停骖邮舍晚，愁绝听啼猿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6815,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"白草桥","author":"魏裔鲁","text":"青山两岸合，白草一溪斜。\n驿路桥边树，烟村嶂外家。\n石梯堆积雪，铁锁控流沙。\n役赋多愁苦，遥闻每叹嗟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6816,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夔门","author":"魏裔鲁","text":"峡连数百里，日月隐重峦。\n彩鹢狎惊浪，轻帆下急滩。\n山回神女庙，水绕武侯坛。\n形胜今犹在，伤心望永安。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6817,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山居","author":"魏裔鲁","text":"十丈丹梯百尺溪，绿杨村在众峰西。\n松门日暖眠花鸭，藓径云深护竹鸡。\n卷幔远山青未了，携觞嫩草碧初齐。\n幽居最喜无尘事，时有春禽隔树啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6818,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨淋铃","author":"魏裔鲁","text":"銮舆出狩幔宫围，栈阁铃声夜雨霏。\n寂寞昭阳谁奏曲，梨园觱篥有张徽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6819,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]