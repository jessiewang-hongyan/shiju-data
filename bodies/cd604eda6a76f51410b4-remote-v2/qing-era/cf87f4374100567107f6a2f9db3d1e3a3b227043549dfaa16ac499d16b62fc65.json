[{"title":"感怀","author":"顾若璞","text":"不堪愁病强搔头，二十三年感百忧。\n却也不知方寸内，如何容得许多愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25962,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感吟","author":"阚玉","text":"西湖春色两堤花，阵阵莺声串柳芽。\n我本无心植杨柳，阴成都能夜栖鸦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25963,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"奉和家大人草堂课耕韵 其一","author":"李美仪","text":"高畴新雨足，布谷唤春耕。\n千亩回村绿，三家结舍平。\n犊肥田竖喜，鸟起草人醒。\n惟有田翁乐，悠然候岁成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25964,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"奉和家大人草堂课耕韵 其二","author":"李美仪","text":"东舍幽栖处，柴门接野田。\n一春滋草径，三月酿花天。\n林雀喧晨霁，邻鸡报午烟。\n频年收获好，膝下得欢然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25965,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"新霁","author":"吴山","text":"新霁健草木，林塘肆芬芳。\n拂石竹阴晚，地幽人亦凉。\n远天自空静，蝉风吹夕阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25966,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"法海寺","author":"吴山","text":"闻说隋家帝，于此建宫阙。\n种色玉钩斜，年年芳草发。\n代往存形胜，古刹依林樾。\n轻风吹锦帆，今昔一明月。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25967,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望钟山","author":"吴山","text":"天气清无霞，远山益幽霭。\n凭楼纵观眺，目与群物会。\n清风自南来，竹树生微籁。\n歌禽唱金缕，翠筱飘罗带。\n时佳景复丽，赏心亦高迈。\n延伫望钟陵，眷然怅松桧。\n似觉古今短，徒谓乾坤大。\n念昔爽鸠氏，川原鲜常在。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25968,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"集不系园","author":"吴山","text":"两峰不出云，十里春阴谱。\n水上快凫鸥，帘前怨鹦鹉。\n花寒不放香，月瘦未见补。\n莫谓近山晴，远烟还是雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25969,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"越城歌","author":"吴山","text":"越王城边春鸟吟，忽思美人歌舞心。\n一朝歌舞向吴国，水犀军散剑池深。\n姑苏台下草连天，鸱夷一艇何茫然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25970,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"泊舟香口","author":"吴山","text":"薄暮到香口，风回即泊舟。\n一溪分竹进，两岸断江流。\n落日明残牖，荒烟袭废楼。\n篱边鸡犬静，寥落使人愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25971,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秦淮舟集同刘李诸夫人分韵","author":"吴山","text":"一棹轻随岸柳斜，晚霞落日集名家。\n六朝风物秦淮水，三月春情谷雨茶。\n隔树岚光青照眼，护桥烟色白侵沙。\n万重楼阁阑干绕，处处篱边著好花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25972,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"中秋","author":"吴山","text":"最爱寒光好处圆，今宵何事转凄然。\n两宫昔日繁华地，百代清秋水月天。\n凫雁不关离黍恨，湖山宁受后人怜。\n聊乘一叶中流放，风露依稀咽管弦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25973,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"幽居","author":"吴山","text":"独寻幽处结孤茅，泉石膏肓疾未消。\n放鹤启扉欹醉竹，通泉凿石跨飞桥。\n露香秋老收莲种，花雨春深课药苗。\n食罢行吟循泽畔，棹歌声引夕阳潮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25974,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"徙倚","author":"吴山","text":"自伤蓬迹远，常羡旅鸿归。\n昨得家人信，青山满蕨薇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25975,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画","author":"吴山","text":"雪意满前山，苍云落寒树。\n扁舟人不归，想在溪中住。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25976,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清明","author":"吴山","text":"而今何处觅桃源，风雨清明且闭门。\n春草萋萋归不得，江南多少未招魂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25977,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"姑苏棹歌 其一","author":"吴山","text":"水色连山青欲流，渔人终日掉轻舟。\n一条古路分吴越，直到钱塘江岸头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25978,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"姑苏棹歌 其二","author":"吴山","text":"水转枫桥径转幽，人家绿树映高楼。\n水犀秋满山塘上，一路清香到虎丘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25979,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寒食忆逝 其一","author":"吴山","text":"去年此日买兰桡，薄暮轻阴转石桥。\n未到平山明月上，水香深处共闻箫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25980,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寒食忆逝 其二","author":"吴山","text":"三月清明风雨斜，江城花柳带人家。\n春花落尽悲春去，尚有来春发旧花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25981,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"广陵杂咏 其一","author":"吴山","text":"检点游装问有无，欲呼双鹿驾柴车。\n一椽傍水留新句，几担移家只旧书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25982,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"广陵杂咏 其二","author":"吴山","text":"一榻残书兼旅思，半窗镫火与疏钟。\n静看六代江南志，坐尽维扬夜雨浓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25983,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"广陵杂咏 其三","author":"吴山","text":"新雨足时芳草绿，野棠开处鹁鸠鸣。\n只今曾阅人多少，感尽江山万古情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25984,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"广陵杂咏 其四","author":"吴山","text":"怅望遥天羡鸟归，落云深处暑光微。\n荒阶渐有虫声出，秋欲来时细雨飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25985,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"湖楼","author":"卞梦珏","text":"一湖幽况送诗篇，画阁初晴暮卷帘。\n两岸烟岚飞鹤点，数声钟磬醒鸥眠。\n山从虚镜遗真影，塔向空天立自然。\n多少白云分片段，悠悠竟与远峰连。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25986,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"去半塘","author":"卞梦珏","text":"半塘容膝半年多，一别浑如一梦过。\n记得山光青似黛，肯忘水色碧于螺。\n邯郸卢子留萍迹，蝴蝶庄生笑网罗。\n不是橹声鸡唱候，此身犹自滞南柯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25987,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"落梅","author":"卞梦珏","text":"静夜新雷雨欲滋，无端愁为落梅支。\n因追灞上初春日，转念孤山二月时。\n香雪易飘风细细，飞琼难挽柳丝丝。\n问梅那得情如我，祇恐桃花笑也痴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25988,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏六月小庭落叶","author":"卞梦珏","text":"深篁蔚卉未知秋，几叶棱棱似探幽。\n月槛风窗聊寄傲，石屏萝磴谩稽留。\n迟归恐值吴江冷，先遁奚惭御水流。\n依约晓阶迎曙色，古槐高柳鸟声稠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25989,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蒋湖寓园对月","author":"陆观莲","text":"青天挂明镜，辉光照我床。\n展转不能寐，起坐空徬徨。\n徬徨亦何为，日思我故乡。\n瓶斋旧隐处，乃在茜水阳。\n廿年几播迁，渺渺天一方。\n回思手栽树，橘柚徒含芳。\n安得生羽翼，摩天一翱翔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25990,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宝剑篇赠外","author":"陆观莲","text":"吁咄哉，荆卿剑术既不成，虽有宝剑徒空名。\n千年黯黯闭秋水，双匣渺渺埋龙精。\n狐狸夜鸣风雨恶，蛟螭昼舞波涛惊。\n我持此剑若明月，众星朗朗随其行。\n又持此剑若白日，群妖退走欃枪平。\n欃枪平，众星没，送君赠君君莫惑。\n古来遇合自有时，神物出处当知之。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25991,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"辰山步虚词","author":"陆观莲","text":"郁萧宴罢列仙归，彩凤青鸾各自飞。\n敕赐珍珠三百斛，满身璎珞绕天衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25992,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"念沈氏老姊","author":"陆观莲","text":"昔闻桓山鸟，四海各分飞。\n念我同生子，四女相因依。\n辛苦效反哺，力尽心亦微。\n仲姊久长逝，泪落不可挥。\n所遗我三人，恋母愿空违。\n伯也失所天，忍死鞠孤儿。\n儿年近四十，与妇同分离。\n茕茕一孩女，遣嫁时来归。\n上堂问祖母，终朝无苦饥。\n嗟予季与叔，相见时亦稀。\n抚琴弹此曲，此曲声殊悲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25993,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和母宝剑篇赠兄","author":"殳默","text":"床头夜半双龙吼，光摄群妖暗星斗。\n风雨霹雳一瞬间，木拔沙飞石乱走。\n古来神物本平常，遭时遇主生晶光。\n拂拭霜花将解赠，时无烈士空徬徨。\n空徬徨，莫太息，木兰唧唧当户织。\n阿兄年少射白额，归来摩挲看太白。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25994,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆震泽西村","author":"殳默","text":"忽忽难忘处，西村明月中。\n荷花低拂露，菱叶静含风。\n烟火经旬断，音书隔岁通。\n茅堂知在否，应有白云封。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25995,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和母寄父","author":"殳默","text":"白发亲闱百里遥，那堪风雨更萧萧。\n山中对酒愁应减，客里看花冻未消。\n觅句小时追谢韫，著书他日拟班昭。\n夜窗弹出思归引，阿母相依慰寂寥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25996,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病中述还","author":"侯蓁宜","text":"秋风策策雁来迟，病况缠绵强自支。\n有药难医贫到骨，无钱可买命如丝。\n燕台梦隔三千里，槐枕肠回十二时。\n儿女关情谁判遣，聊凭一纸寄君知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25997,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"记原大兄邀看桂","author":"侯蓁宜","text":"红衣半褪忆莲塘，又报秋香一树黄。\n不待折来心已醉，年年花下为开觞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25998,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋闺","author":"侯怀风","text":"桂华香雾锁回廊，水阁沈沈秋夜长。\n月转梧桐翻瘦影，风摇菱行蔽清光。\n子卿自得归乡国，定远何当老朔方。\n望断衡阳飞骑杳，侧身怀古一沾裳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25999,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋怀","author":"侯怀风","text":"秋气憀憀不自持，幽兰小槛暗香披。\n千原烟雨迷禾黍，一水蒹葭隐鹭莺。\n开帙不知金烬冷，挥弦更杂远鸿悲。\n班姬纨扇清商发，苏蕙璇玑白昼迟。\n风剪梧桐黄鹄舞，月窥杨柳绿绦垂。\n魂惊筚篥萧关道，泪尽琵琶凝碧池。\n征妇裁衣凭玉尺，美人汲露下冰墀。\n辘轳不断千家井，何似闺中梦里思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26000,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"少年行","author":"侯怀风","text":"章台蹀躞紫骅骝，绣毂雕鞍翡翠裘。\n歌舞不知银箭急，日高酣卧在青楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26001,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"漫兴","author":"侯承恩","text":"立身重意气，黄金何须有。\n富贵非本愿，山林宿所耦。\n清肃峻门墙，箴规日谨守。\n閒或理琴书，健还操井臼。\n衣须裁称意，食惟期适口。\n栽菊取晚香，种松因耐久。\n煎茶委小婢，浇花必自手。\n乐在可忘忧，事简无取咎。\n翻覆任世情，是非休深究。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26002,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"记梦","author":"侯承恩","text":"理罢丝桐月色莹，小窗无语黄昏静。\n银镫挑尽梦初成，飘然似入蓬莱境。\n苍松古柏若龙盘，瑶草琪花满三径。\n玉洞玲珑路渐深，青鸾白鹤声相应。\n娉婷仙子笑来迎，谓予到此游何胜。\n俄而引至玉楼中，笙歌齐奏方开饮。\n麟脯琼浆取次供，冰桃雪藕还贻赠。\n须臾筵散步层峦，举头四望如明镜。\n峰回路转近林泉，丹桂香清风露冷。\n尘寰回首隔千重，山水苍茫不可竟。\n方拟蹑云天上游，邻鸡喔喔旋惊醒。\n窗前月色尚微微，四壁寒光浸孤影。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26003,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋夜","author":"侯承恩","text":"露白银河淡，庭虚皓月融。\n寒蛩吟破壁，哀雁叫长空。\n凤阁箫还咽，湘灵曲未终。\n缘知肠断处，不待五更风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26004,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春闺","author":"侯承恩","text":"迩来多病起常迟，懒对青菱理鬓丝。\n檐铁乍惊幽梦觉，心情惟恐落花知。\n江天雁断书千里，庭树春深绿满枝。\n风景恼人禁不得，倚栏聊复试题诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26005,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梅花 其一","author":"侯承恩","text":"冷艳原无异，孤高自不同。\n罗浮明月夜，香彻梦魂中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26006,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梅花 其二","author":"侯承恩","text":"林下谁为伴，冰霜只自知。\n生成贞洁性，红紫不同时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26007,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晓起","author":"侯承恩","text":"淡淡炉烟薄薄霜，晓寒梦断竹匡床。\n生憎杜宇花间语，唤起新愁上海棠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26008,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山居杂咏 其一","author":"倪仁吉","text":"照影双飞燕，新来补旧居。\n芹塘泥最淤，慎莫堕琴书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26009,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山居杂咏 其二","author":"倪仁吉","text":"红叶恰翻阶，露气晓如沐。\n山雨忽欲来，新香时断续。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26010,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"归宁得家姑诗步韵","author":"倪宜子","text":"征鸿过处得瑶笺，不见鸾軿意倍煎。\n涧畔寻花思旧日，林边听鸟俟他年。\n烟云变幻山仍在，人事凄凉世已迁。\n拟诉暌违千万恨，几回捉笔泪潸然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26011,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"立秋有感","author":"倪宜子","text":"一叶梧桐大火流，如何令我早知秋。\n裴姬怀远思裁练，苏子羞归欲敝裘。\n短篴穟吹来皆别恨，瑶琴弄罢尽离愁。\n凭兰空盼新鸿至，那有音书付与收。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26012,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怀吴蕊仙","author":"夏沚","text":"癖耽翰墨费吟哦，欲寄愁心到薜萝。\n江外故人青眼在，山中女伴素书多。\n天涯镫火谁同调，岁暮冰霜独抱疴。\n弹指流光容易掷，家园归梦近如何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26013,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"远眺","author":"吴朏","text":"秋光潇洒散平湖，水白沙清浴野凫。\n近渚风多残叶落，远山雨过野云孤。\n閒将静阁供凭眺，淡取疏烟入画图。\n夕阳渐低村树隐，银蟾一点漏疏梧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26014,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"艳曲 其一","author":"吴朏","text":"金屋暖长春，兰阶人似月。\n但愿如月圆，不愿如月缺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26015,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"艳曲 其二","author":"吴朏","text":"赠妾紫金环，遗郎白玉玦。\n郎恩环不解，妾心玉比洁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26016,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"采莲曲","author":"吴朏","text":"弱柳系游骢，丛花映娇面。\n郎佩紫纹囊，侬从扇底见。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26017,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"莲花","author":"曹鉴冰","text":"红藕花开夏日长，薰风吹动满湖香。\n清标自合称君子，却把姿容比六郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26018,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送春","author":"曹鉴冰","text":"莺歌凄惋燕飞忙，似送东风过柳塘。\n翠叶有情眉黯淡，粉花无力意悠扬。\n茫茫塞北关山远，漠漠江南道路长。\n犹幸暌离非隔岁，相逢拟待腊梅黄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26019,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日漫兴 其一","author":"曹鉴冰","text":"柳经秋老不藏鸦，景物因时莫浪嗟。\n一卷《楚骚》忘午倦，数声齐女咽残霞。\n荣华心已沾泥絮，冷淡情犹湿雨花。\n倚遍曲阑难自遣，瓦瓶汲水独煎茶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26020,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日漫兴 其二","author":"曹鉴冰","text":"摇落何辞两鬓蓬，自开竹牖引凉风。\n仓皇蚁阵秋苔里，扰攘蜂衙晓雾中。\n世事久知同梦鹿，人生须信易沙虫。\n分明静处真仙境，休忆蓬山问路通。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26021,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柳烟","author":"曹鉴冰","text":"浓抹千条绿，春残未肯收。\n杨花轻扑处，漠漠使人愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26022,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"花露","author":"曹鉴冰","text":"春露落花房，花如向晓妆。\n红珠千万粒，无粒不生光。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26023,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"竹雨","author":"曹鉴冰","text":"欲折亭亭节，斜侵苦莫饶。\n不曾留一点，惟觉韵潇潇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26024,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"松风","author":"曹鉴冰","text":"飘入岩松里，纷纷分外清。\n纵非陶宰相，听去亦怡情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26025,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送愁次秋山韵","author":"曹鉴冰","text":"乘人閒处即相缠，紧压双眉太可怜。\n不是无情送君别，再留惟恐损春妍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26026,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柳","author":"曹鉴冰","text":"撩烟拂雨画桥边，日送行人剧可怜。\n更恨西风斜照里，摧残犹带一声蝉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26027,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怀王辰若夫人","author":"彭琬","text":"湖上烟生碧树枝，柴扉昼掩落花时。\n何当得睹双星貌，空羡擎来道韫诗。\n曲径茶香留夜月，朱栏鸟下看围棋。\n三春风雨愁深浅，病骨支离无限思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26028,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怀王辰若夫人","author":"彭琰","text":"碧草萋迷接柳枝，匆匆良晤夕阳时。\n纤眉画就春山色，素纸裁成白雪诗。\n风送花香沾去袂，鸟啼竹径冷残棋。\n归来静掩閒庭月，欲向清光寄所思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26029,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病春","author":"彭琰","text":"半帘垂柳夕阳斜，香冷閒窗日便赊。\n莫道朝来不憔悴，撩人偏恨牡丹花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26030,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九日 其一","author":"彭琰","text":"鸣蝉无语恋寒枝，正是登高病起时。\n忙里不知秋色老，青山红树夕阳垂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26031,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]