[{"title":"书感","author":"戴亨","text":"故国田园尽，无谋奉老亲。\n迂疏希用世，俯仰学随人。\n十载空劳瘁，残生尚汨陈。\n终愁经事浅，有玷白华身。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10286,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"倚槛","author":"戴亨","text":"春风轻拂袖，倚槛一开颜。\n宿雨朝初霁，孤云淡未还。\n菱歌生极浦，鸟语话青山。\n何必沧洲去，悠然意自閒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10287,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"归自长城驿经刘园小憩","author":"戴亨","text":"芳径转幽僻，孤亭净俗氛。\n檐花风静落，人语竹深闻。\n滩响疑来雨，松阴欲下云。\n渊明曾试仕，野性卒离群。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10288,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雨后忆西山寄海涵百边识珍赵珍兄弟","author":"戴亨","text":"独坐新晴后，官清忆昔閒。\n西峰偕旧侣，采药驻衰颜。\n红叶林中寺，斜阳雨后山。\n别来幽赏地，胜事孰追攀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10289,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和毛秋岑济上之作","author":"戴亨","text":"济上春风暖，临流畅我情。\n长桥分甸服，一水界齐清。\n泰岱云来近，虚空雨易成。\n田家八万户，沾洒遍深耕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10290,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"编篱","author":"戴亨","text":"编芦成小圃，篱落近农村。\n野蔓萦新叶，绿云垂满园。\n渐能罗蝶翅，疏不碍花魂。\n领取幽栖意，閒吟坐竹轩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10291,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"长清县道中","author":"戴亨","text":"轮鞅虽云瘁，溪山兴颇浓。\n炎蒸消澍雨，云壑作秋容。\n禾黍知民力，棉机校女佣。\n百年生计足，萧洒是桑农。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10292,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夜至长清县","author":"戴亨","text":"雨收云尚在，泥淖阻官程。\n随役呼相应，肩舆歇复行。\n野香生夜露，荒径逐虫声。\n比至严城下，谯楼报二更。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10293,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"崮山望岱","author":"戴亨","text":"岱宗何处是，崮顶正当冲。\n登眺豁双目，苍茫隔数峰。\n云来疑作雨，心寂若闻钟。\n何日磨崖上，高寻历代踪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10294,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"立秋前二日夜坐怀屈悔翁边识珍海涵百","author":"戴亨","text":"露下消烦热，清言欲二更。\n桐阴延夜月，虫语作秋声。\n触景情何远，怀人句忽成。\n兴心飞鸟上，离思觉旋生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10295,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"初秋过五峰山 其一","author":"戴亨","text":"不是因公至，何知此境仙。\n奇峰争插汉，秋水远浮天。\n老衲藏深峪，疏钟出曙烟。\n到来心境寂，觅胜且流连。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10296,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"初秋过五峰山 其二","author":"戴亨","text":"云构盘空邃，仙源入境清。\n过桥通鸟道，穿竹忽泉声。\n峰壑阶前秀，山禽时一鸣。\n林梢风叶落，点点动秋情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10297,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"初秋过五峰山 其三","author":"戴亨","text":"素性耽丘壑，兹游畅我情。\n野花随意发，山鸟不知名。\n圭组心俱淡，烟霞念颇生。\n携筇閒眺望，缓步觉身轻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10298,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"初秋过五峰山 其四","author":"戴亨","text":"坐久花时落，风轻水自纹。\n松阴寒欲雨，石罅暖生云。\n山寂樵歌起，风霄静里闻。\n忘机亲牧竖，鸥鹤亦同群。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10299,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"初秋过五峰山 其五","author":"戴亨","text":"斜阳催返驾，无计复淹留。\n好鸟啼将别，清泉咽不流。\n霜催红叶曙，山养白云秋。\n再至幽栖地，应?信宿游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10300,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过灵岩寺","author":"戴亨","text":"铁缕袈裟旧，虬松枝干长。\n神僧归寂寞，林壑望苍茫。\n野鸟啼空谷，虚堂闻妙香。\n筌蹄何处觅，心向静中忘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10301,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过里峪泉","author":"戴亨","text":"巉岩循僻路，窅窕入林邱。\n见水知村近，看山识岁秋。\n鸟啼幽涧竹，人倚夕阳楼。\n安得关橦手，相随记胜游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10302,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"灵岩寺夜步","author":"戴亨","text":"日入兴难尽，看山夜若何。\n寒潭生月小，空谷受云多。\n樵唱出萝薜，禅灯下芰荷。\n疏钟声远近，隐隐隔岩阿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10303,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"再过灵岩寺","author":"戴亨","text":"松窗侵翠霭，经案接旃檀。\n疏雨度高阁，轻风生暮寒。\n再来禅院净，真远俗尘干。\n莲社开何日，青山不厌看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10304,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"访余隐居久候不遇","author":"戴亨","text":"觅胜来幽境，兼之访所思。\n到门寒绿绕，隔岸落花迟。\n浅草归村路，斜阳罢钓时。\n徘徊原野上，芳躅暮何之。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10305,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏佛手柑","author":"戴亨","text":"霜柑悬色相，佛手是耶非。\n伸屈皆禅谛，骈枝亦悟机。\n掌应摩顶现，香逐散花飞。\n静味拳拳妙，西来大意微。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10306,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏方镜","author":"戴亨","text":"虚中生皎洁，静里察微茫。\n照老须眉热，菱花心事凉。\n万端无定象，随应不拘方。\n纤翳防亏鉴，摩挲为发光。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10307,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题千佛山精舍二首 其一","author":"戴亨","text":"磴道历残雪，攀援陟翠峦。\n诸天龛石穴，清梵落云端。\n妙谛閒中悟，尘寰世外看。\n万家烟雾里，攘攘正冲寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10308,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题千佛山精舍二首 其二","author":"戴亨","text":"晴日扩奇胸，崖端卓瘦筇。\n高城浮片水，平野耸三峰。\n云窦藏冰雪，风霄响桧松。\n卑喧寻解脱，此地觉从容。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10309,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"笼鸟 其一","author":"戴亨","text":"云路飞难进，樊笼亦偶然。\n羽毛原不类，罗弋自应先。\n物小能关化，机危但信天。\n虽惭鸡断尾，终弗乞人怜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10310,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"笼鸟 其二","author":"戴亨","text":"知机焉蹈此，岂敢怨离群。\n飞止将安遇，哀鸣亦不闻。\n低头修翠羽，侧目望青云。\n遐想冥鸿翼，高骞绝俗氛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10311,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"萤火","author":"戴亨","text":"但看生尔处，腐草亦何神。\n托命长依夜，窥天未及晨。\n湿光寒自照，阴火故相亲。\n旦夕随风雨，飘零若有因。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10312,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"式微","author":"戴亨","text":"天心开大悟，海量悔深非。\n近难何能脱，名山不早归。\n野花寒结子，清露夜沾衣。\n羁绪兼秋杀，凄然赋式微。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10313,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"古书","author":"戴亨","text":"数行读不到，岂是眼前书。\n痛惜生民后，穷搜天地初。\n精华陶睿智，糟粕饷迂疏。\n莫以韦编敝，芸窗饱蠹鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10314,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"古剑","author":"戴亨","text":"神物虽韬敛，光芒碧汉横。\n祗因惊北斗，遂使在丰城。\n利钝何曾见，恩雠总不鸣。\n转愁脱赠后，烈士意难平。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10315,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"古琴","author":"戴亨","text":"自绝王门后，孤鸣尚有琴。\n谅因知者少，留得到而今。\n一曲猗兰操，千秋泗水心。\n悠然尘虑寂，沧海意何深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10316,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"古鼎","author":"戴亨","text":"宝兹非赝质，铉耳复能全。\n糊口聊初试，铭功殊不然。\n鹧鸪班自灿，饕餮象空悬。\n折足何堪重，深为覆餗怜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10317,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"古镜","author":"戴亨","text":"宝镜今何古，秦台照胆馀。\n积尘浑不觉，秋水失真如。\n昏浊成蠲弃，虚明忆始初。\n犹看团似月，觌面一欷歔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10318,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"古碑","author":"戴亨","text":"不作石头梦，空留泉下哀。\n一朝辞翠巘，终古卧苍苔。\n功业归何处，文章安在哉。\n从来称岘首，姓字亦尘埃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10319,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"古寺","author":"戴亨","text":"倾颓岩谷里，何代梵王宫。\n不见天花落，真成色相空。\n禅关邻虎穴，山鬼啸林风。\n莲社凋零尽，凭谁问六通。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10320,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"古树","author":"戴亨","text":"秦皇封未及，甘入不材林。\n老干擎天直，盘根拔地深。\n风霜坚劲节，日月饱清阴。\n且未浮槎去，焉知迟暮心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10321,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"出笼鸟 其一","author":"戴亨","text":"蒙君垂盼意，小鸟亦何知。\n已破樊笼出，方思性命危。\n惊魂栖未稳，觅食意还疑。\n毛羽经磨损，飞鸣慎所之。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10322,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"出笼鸟 其二","author":"戴亨","text":"山林飞不去，罿?已难辞。\n彩翮兼殊众，先鸣讵所宜。\n自应随位置，敢复恨羁縻。\n从此垂堂远，知几亦未迟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10323,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"小砚跌破命儿廷璋胶固诗以识之","author":"戴亨","text":"一片端溪石，相随历岁时。\n吟哦长我共，辛苦独君知。\n此破虽关数，斯文实在兹。\n岂甘来护弃，将效范馨遗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10324,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赋得轩皇鼎","author":"戴亨","text":"铸此留何意，轩皇仙不还。\n盐梅非所用，草野亦徒閒。\n无疾遭颠趾，馀丹可驻颜。\n蛟龙防驳落，珍重莫轻攀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10325,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"古书","author":"戴亨","text":"一卷知何代，咸云是古书。\n但教余见扩，何必宋人馀。\n濡墨补残字，熏芸辟蠹鱼。\n豁然糟粕外，先哲若同居。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10326,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"宝剑","author":"戴亨","text":"匣内作龙鸣，鸣应有不平。\n千金轻价值，百折重声名。\n射斗原非妄，投珠总弗惊。\n奇功何处立，神物感精诚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10327,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"磨剑","author":"戴亨","text":"宝剑谁能识，霜锋汨没中。\n雌雄凭论断，利钝在磨砻。\n流水鸣秋涧，寒窗走夜虹。\n防身兼许国，何处有丰功。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10328,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雨后见月","author":"戴亨","text":"久雨天初豁，移礅坐晚风。\n月无亏皦洁，云不碍虚空。\n身老名犹在，官休道岂穷。\n静中观大化，吾自得吾终。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10329,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"留别卢公亮","author":"戴亨","text":"官罢绝来客，相亲独有君。\n间关归故国，杯酒惜离群。\n朔雪祝阿道，春城玄兔云。\n何时重把袂，剪烛细论文。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10330,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"孔员外为余刻齐清集赋谢","author":"戴亨","text":"老雪衡门积，虚窗皓月孤。\n知音甘阒寂，閒咏对荒芜。\n得句惭圭璧，多君重珷玞。\n风流王宋后，此意世人无。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10331,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"古庙二首 其一","author":"戴亨","text":"倾颓何代庙，四壁但埃尘。\n老树干云日，虚堂聚鬼神。\n灯龛藏野鼠，风叶恐行人。\n宿草秋坟路，荒原自结邻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10332,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"古庙二首 其二","author":"戴亨","text":"深山藏结构，高树带斜晖。\n罗网牵珠箔，莓苔绣宝衣。\n江云来复去，梁燕乳还飞。\n望望村人远，依稀隔翠微。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10333,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晓寒","author":"戴亨","text":"霜花侵客袂，岚气障山容。\n初日出东壁，流辉含远峰。\n征车寻古道，村舍指乔松。\n下马思微饮，香醪何处醲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10334,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"云","author":"戴亨","text":"来往浑无著，虚空自古今。\n卷舒如有意，隐现亦何心。\n不霈高天雨，旋留邃谷阴。\n风来时莫测，敛迹尔应深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10335,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"饥","author":"戴亨","text":"搜厨无所得，相对耐恒饥。\n凉雨浇蓬径，金风砭葛衣。\n世情趋尽异，吾道识应稀。\n飘泊秋深燕，无家何处归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10336,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题明复庵别业","author":"戴亨","text":"官清成吏隐，卜室傍林间。\n迹与市朝远，心随水石閒。\n寻泉逢野衲，启户见青山。\n时有故人问，灌园犹未还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10337,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日书怀","author":"戴亨","text":"崇替何须论，身尊道不违。\n琴书堪送老，花鸟共忘机。\n莫以肥甘是，而轻蓬蔂非。\n但知安素履，随意惜春晖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10338,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"或有劝余复官者诗以答之","author":"戴亨","text":"于世真无补，馀生合弃捐。\n功名抛敝帚，岁月在残编。\n呆戆安时议，颠危赋性偏。\n谁能徇世务，俯仰白头年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10339,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青毡","author":"戴亨","text":"性命研精蕴，诗书发快谈。\n闭门无接纳，落笔有烟岚。\n交态贫逾见，人情老渐谙。\n青毡吾故物，垂白复焉贪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10340,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏日书怀","author":"戴亨","text":"百年无定著，踪迹老风尘。\n樱熟时将夏，花残岁不春。\n平生成底事，往古类何人。\n自叩惭惊汗，临风一怆神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10341,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"仲夏与诸同人游王园先至明复庵别业即与同往乘兴复至丰台分韵得诗五首 其一","author":"戴亨","text":"数椽栖息地，万木翠阴环。\n时策手中杖，閒看门外山。\n同人来造次，野石坐斑斓。\n知尔耽幽胜，相携叩竹关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10342,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"仲夏与诸同人游王园先至明复庵别业即与同往乘兴复至丰台分韵得诗五首 其二","author":"戴亨","text":"前度何悤遽，山桃不满园。\n再游行径熟，几日树阴繁。\n溪爱新荷色，庭怜旧雨痕。\n拂林逢故识，隔水问寒温。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10343,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"仲夏与诸同人游王园先至明复庵别业即与同往乘兴复至丰台分韵得诗五首 其三","author":"戴亨","text":"游兴连朝剧，兹辰遂热衷。\n山光迎屐齿，松径引樵风。\n亭榭幽深入，渠荷曲折通。\n丰台遥在望，觅胜意何穷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10344,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"仲夏与诸同人游王园先至明复庵别业即与同往乘兴复至丰台分韵得诗五首 其四","author":"戴亨","text":"游情方恋旧，前路复怀新。\n清浅溪随屐，呢喃燕趁人。\n吹来山翠雨，沾我谷皮巾。\n更喜初晴后，芳郊绝点尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10345,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"仲夏与诸同人游王园先至明复庵别业即与同往乘兴复至丰台分韵得诗五首 其五","author":"戴亨","text":"谈深花渐落，饮罢日初低。\n醒酒风生竹，烹茶水掬溪。\n松间云欲去，枝上鸟还啼。\n临别频回首，烟光满大堤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10346,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"自笑","author":"戴亨","text":"自笑平生志，常思赋遂初。\n升沈今已定，踪迹竟何如。\n岩穴怀高侣，风尘寄索居。\n几时归皂帽，闭室注虫鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10347,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题庆员外松乔小室","author":"戴亨","text":"结室何须大，能无俗务侵。\n静虚摊卷处，高洁入云心。\n蕉叶抽窗翠，盆鱼乐藻阴。\n公馀思太古，雅韵寄瑶琴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10348,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"再题松乔小室","author":"戴亨","text":"逼近高堂侧，精营一小轩。\n退思扃竹径，防客破苔痕。\n今古罗绳瓮，行藏究本原。\n从来经济手，得力在忘言。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10349,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"养性","author":"戴亨","text":"养性宜蓬径，幽偏绝俗埃。\n尘情删故蘖，灵蕴茁新荄。\n风起防蕉叶，人过惜藓苔。\n静中时有会，小酌对花开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10350,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寄赠乔山人兆三兼订游山之约三首 其一","author":"戴亨","text":"遁迹西峰麓，生涯获遂初。\n俗尘终岁隔，灵境百年居。\n割蜜攀岩石，分泉养蛤鱼。\n随时招近局，尊酒狎樵渔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10351,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寄赠乔山人兆三兼订游山之约三首 其二","author":"戴亨","text":"沃土耕耘暇，无营不散襟。\n寻僧过寺惯，拾菌入云深。\n遐契岩栖境，閒生泉壑心。\n柿丹秋有信，将拟踏霜林。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10352,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寄赠乔山人兆三兼订游山之约三首 其三","author":"戴亨","text":"邈矣超尘境，跫然有足音。\n清心对流水，聪耳听鸣禽。\n适俗原非愿，高栖素所钦。\n兴言随杖履，幽梦结遥岑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10353,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"种竹后复简松乔","author":"戴亨","text":"莫讶余情僻，偏于竹有私。\n繁华非不媚，真性独能持。\n风动凉生牖，阴过翠拂卮。\n更看霜雪意，无语若相知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10354,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋日寄兴","author":"戴亨","text":"入世难孤立，投閒可自仙。\n山斋黄叶雨，渔笱碧潭烟。\n放迹形骸外，行吟草泽前。\n尘寰如我问，鸥鸟狎江天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10355,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]