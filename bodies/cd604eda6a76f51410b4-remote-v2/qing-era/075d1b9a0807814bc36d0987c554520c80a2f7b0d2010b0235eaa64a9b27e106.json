[{"title":"望江南 其五 答碧梧姊五忆诗","author":"谈印梅","text":"追随处，听曲掷红绡。\n筝韵急飞蕉叶雨，酒痕红晕海棠潮。\n有个雪儿娇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25386,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 其一 闰中秋即事","author":"袁绶","text":"百年难得中秋闰，月又团圞。\n人又团圞。\n一碧长空转玉盘。\n重逢二八婵娟面，倦倚雕栏。\n醉倚雕栏。\n金粟香中笑语欢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25387,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 其二 闰中秋即事","author":"袁绶","text":"秋光皎洁逾前度，花影屏山。\n竹影屏山。\n香雾黏衣不觉寒。\n琼楼玉宇知何处，坐到更阑。\n话到更阑。\n如此良宵再过难。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25388,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"竹枝 其二 粤东词","author":"陈维崧","text":"花田三月黎人多。\n珠江无风春自波。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25389,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"竹枝 其三 粤东词","author":"陈维崧","text":"罗浮人家红蕉布。\n谁裁郎衣侬所作。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25390,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"竹枝 其四 粤东词","author":"陈维崧","text":"槟榔酒酿郁林春。\n郁林儿女多绛唇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25391,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"二十字令 咏便面上栀子花为陆汉标赋","author":"陈维崧","text":"纨扇上，谁添栀子花。\n搓酥滴粉做成他。\n凝蝉纱。\n夭斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25392,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 岁暮杂忆十首 其一","author":"陈维崧","text":"江南忆，忆得上元时。\n人斗南唐金叶子，街飞北宋闹蛾儿。\n此夜不胜思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25393,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 岁暮杂忆十首 其二","author":"陈维崧","text":"江南忆，最忆善和坊。\n猿臂醉擎刘白堕，莺喉娇唱小秦王。\n花月去堂堂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25394,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 岁暮杂忆十首 其六","author":"陈维崧","text":"江南忆，更忆是芜城。\n兰叶寒塘盘马路，梨花微雨筑毬声。\n风景逼清明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25395,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 岁暮杂忆十首 其七","author":"陈维崧","text":"江南忆，忆杀到如今。\n白玉堂深人一笑，真珠帘暖夜千金。\n十载尚关心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25396,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 岁暮杂忆十首 其八","author":"陈维崧","text":"江南忆，最好是清歈。\n一曲琵琶弹贺老，三更弦索响柔奴。\n此事艳东吴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25397,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 岁暮杂忆十首 其十","author":"陈维崧","text":"江南忆，不羡五侯鲭。\n狎客后堂春说饼，厨娘小阁夜尝羹。\n餔歠足平生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25398,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令  赠友","author":"陈维崧","text":"记得西陵小弄，风里金鞭双控。\n今日又逢君，恰值春波微动。\n如梦，如梦，白发何戡情重。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25399,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"长相思 赠别杨枝","author":"陈维崧","text":"漱金卮，阁金卮。\n不是樽前抵死辞。\n今宵是别离。\n撚杨枝，问杨枝。\n花萼楼前踠地垂。\n休忘初种时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25400,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"相见欢 初夏行舟","author":"陈维崧","text":"睡馀独自推篷，海陵东。\n一带人家都住，柳丝中。\n黄茆屋，清江曲，绿蓑翁。\n正是雨馀斜阁，水车红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25401,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"调笑令 咏古七首 其一 张女郎","author":"陈维崧","text":"张家二女天人姿，西风秦陇吹空祠。\n吴兴瘦沈美风调，邂逅一笑难为持。\n客亭惝恍婵娟子，翠幰珠軿去如驶。\n酒坐琴声箜篌声，姊妹双双落红水。\n红水。\n啼难止。\n弄罢箜篌相顾起。\n女郎祠掩西风里。\n绣幌明帘徙倚。\n兰香姨与智琼姊。\n怀恨多年同此。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25402,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"调笑令 咏古七首 其二 汜人","author":"陈维崧","text":"湘中蛟娣号汜人，楚天冉冉红罗巾。\n一钩晓月洛桥下，风光冶丽偏相亲。\n别来愁绪纷难理，鄂渚微波嬉上巳。\n烟裙雾鬓惊淼茫，画舻回首人千里。\n千里。\n湘中水。\n江面微风翻绣被。\n轻别玉娥归去矣。\n泪滴龙堂青绮。\n十年重遘蛟宫娣。\n愁绝楚天上巳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25403,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"调笑令 咏古七首 其三 茝奴","author":"陈维崧","text":"崔家女弟世所无，弹筝自命为茝奴。\n重泉犹作人间曲，摧藏掩抑声嗟吁。\n当时旧事心犹省，长秋一曲红窗影。\n梦里曾陪元舍人，银筝凄苦人清冷。\n清冷。\n虚无境。\n手拨银筝心自省。\n长秋一曲红窗影。\n弦里分明悲哽。\n泉台不少人间景。\n后苑君王巡幸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25404,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"调笑令 咏古七首 其四 安妃","author":"陈维崧","text":"九华安妃游玉乡，交裙携带招帝郎。\n情缠双好发朗唱，紫清琐掖排银房。\n杨羲自是神仙子，不比人间许长史。\n左宫亦有王夫人，红颜调笑斟琼醴。\n琼醴。\n调芳旨。\n天上风流聊复尔。\n杨家自是神仙子。\n双笑欢兼昔旨。\n一幅青书鸾凤纸。\n为授真妃灵纪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25405,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"调笑令 咏古七首 其五 刘丽华","author":"陈维崧","text":"通波亭畔风日清，会稽王子愁经行。\n中流佚女遘烟舫，波光脸态交盈盈。\n风吹裙带红丝缠，箜篌歇拍声声颤。\n西轩夜静月又低，春条为尔歌宛转。\n宛转。\n羞相见。\n月白风清人婉娈。\n洛灵罗袜来波面。\n良夜随郎游衍。\n小婢箜篌歌又颤。\n徙倚春流都遍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25406,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"调笑令 咏古七首 其六 蔡家娘子","author":"陈维崧","text":"西堂花茵侬好持，此间风月堪咏诗。\n溢奴小儿若冰雪，紫缓绿酒饶神姿。\n竟陵判司大懊恼，夜寒空馆眠难好。\n翠簪腻滑促传觞，口吃微闻唤鸾老。\n鸾老。\n头脑好。\n善谑群真堪绝倒。\n夜寒空馆人声悄。\n地下为欢须早。\n南邻娘子翘翘小。\n共泛玻璃清醥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25407,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"调笑令 咏古七首 其七 瑶芳公主","author":"陈维崧","text":"槐安贵主名瑶芳，秾春游戏摇鸣珰。\n相牵贪看石延舞，寺前暗调淳于郎。\n兰摧玉折一何苦，青春又葬同昌主。\n淮南裨将惯酒悲，恸哭繁华黯无语。\n无语。\n奈何许。\n忆在寺门魂暗与。\n布衣真尚瑶芳主。\n一霎日斜归去。\n大槐安国飞红雨。\n肠断旧游何处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25408,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇  咏枕","author":"陈维崧","text":"忆得年时，红绵妆叠红蕤滟。\n笙囊绿掩，浓笑钗痕闪。\n说尽山盟，不料巫云敛。\n残荷燄，斜铺楚簟，多了啼红点。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25409,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"女冠子  本事二首 其一","author":"陈维崧","text":"黄絁剪就，慵上鸳机刺绣。\n镇葳蕤。\n水绿青溪庙，花红白石祠。\n愔愔春似梦，漠漠雨如丝。\n仙洞胡麻熟，有谁知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25410,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"女冠子  本事二首 其二","author":"陈维崧","text":"始青天上，小织龙绡几两。\n路茫茫。\n度海云鬟乱，还宫绣带长。\n琼枝春袅袅，金磬夜琅琅。\n拨尽天风曲，说兴亡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25411,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 赠王郎","author":"陈维崧","text":"十五吴儿渲额黄，鹅笙炙罢口脂香。\n依稀记是小王昌。\n未解褰帘通暗语，已能映柱恼回肠。\n个侬年纪未须防。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25412,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮  题青溪遗事画册同邹程村彭金粟王阮亭董文友赋八首 其一","author":"陈维崧","text":"流苏小揭人初起，博山烟袅屏风里。\n红日映帘衣，梁间玉剪飞。\n回眸惊瞥见，笑倚门中扇。\n准拟嫁文鸯，灯花昨夜双。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25413,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮  题青溪遗事画册同邹程村彭金粟王阮亭董文友赋八首 其二","author":"陈维崧","text":"象牙局上金星吐，香闺戏博红鹦鹉。\n深院对挑棋，厌厌春昼迟。\n娘输笼玉手，佯靠纱窗口。\n细撚柳绵儿，花冠报午时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25414,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮  题青溪遗事画册同邹程村彭金粟王阮亭董文友赋八首 其三","author":"陈维崧","text":"银河斜坠光如雪，碧虚浅浸天边月。\n月色太婵娟，行来刚并肩。\n阑干浑倚倦，小漾裙花茜。\n风细语难闻，亭亭双璧人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25415,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮  题青溪遗事画册同邹程村彭金粟王阮亭董文友赋八首 其四","author":"陈维崧","text":"后堂恰与中门近，当时日傍飞蝉鬓。\n犹记捉迷藏，水晶庭院凉。\n侍儿前后逻，何计将他躲。\n匿笑颤花枝，鞋尖露一丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25416,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮  题青溪遗事画册同邹程村彭金粟王阮亭董文友赋八首 其五","author":"陈维崧","text":"回廊碧甃芭蕉叶，鸭垆瑞脑薰犹热。\n春笋抱琴弹，一行金雁寒。\n声声松宝串，弹到昭君怨。\n促柱鼓潇湘，风吹罗带长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25417,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮  题青溪遗事画册同邹程村彭金粟王阮亭董文友赋八首 其六","author":"陈维崧","text":"秦淮水阁多斑竹，平康院院烧灯读。\n竹响似行人，檀郎回顾频。\n恰逢红粉面，送茗来琼扇。\n刚是早回头，夜深侬睡休。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25418,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮  题青溪遗事画册同邹程村彭金粟王阮亭董文友赋八首 其七","author":"陈维崧","text":"梨花簌簌飞红雪，狸奴夜扑氍毹月。\n物也解雄雌，教奴恣意窥。\n潜踪殊未惯，猛被萧郎看。\n羞走晕春潮，门边落翠翘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25419,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮  题青溪遗事画册同邹程村彭金粟王阮亭董文友赋八首 其八","author":"陈维崧","text":"桃笙小拥楼东玉，红蕤浓亸春鬟绿。\n宝篆镇垂垂，珊瑚钩响时。\n花阴瑶屈戍，小妹潜偷觑。\n故意绣屏中，剔他银烛红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25420,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 江行二首 其一","author":"陈维崧","text":"东风吹绿江南道，行人却说江南好。\n红豆两三枝，低垂圣女祠。\n渌波明似眼，来往人何限。\n斜日运租船，西风跂脚眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25421,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 渡江宿弟斐玉家","author":"陈维崧","text":"江南江北，握手相看那易得。\n今夜重逢，翠筱黄花伴烛红。\n浮杯大嚼，顾我何如家弟乐。\n车马湖边，明日西风绝可怜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25422,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 广陵旅邸送三弟纬云南归","author":"陈维崧","text":"佛狸城下，兄弟禅房通夜话。\n红土山头，兄往吴陵弟亳州。\n一鞭春暮，重过竹西三日住。\n江上斜晖，弟作归人兄未归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25423,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 送四弟子万","author":"陈维崧","text":"前年飞絮，我到故园君已去。\n今岁青山，君又南行我未还。\n吴云郢树，泪洒临歧无一语。\n再唱离歌，六幅蒲帆奈汝何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25424,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 送五弟阿龙","author":"陈维崧","text":"阿龙最小，失母随兄偏了了。\n四岁离乡，今日重逢断我肠。\n阮家姑母，犹子情深思汝久。\n此去相依，莫以怀吾泪湿衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25425,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 岁暮灯下作家书竟再繫数词楮尾七首 其一","author":"陈维崧","text":"天涯飘泊，湖雨湘烟无定著。\n暗数从前，汝嫁黔娄二十年。\n当时两小，乐卫人誇门第好。\n零落而今，累汝荆钗伴藁砧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25426,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 岁暮灯下作家书竟再繫数词楮尾七首 其二","author":"陈维崧","text":"余年二十，粗晓读书兼射猎。\n三十蹉跎，鼓瑟吹篪奈若何。\n堪怜阿堵，垂老讵曾亲识汝。\n沟水东西，何用男儿意气为。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25427,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 岁暮灯下作家书竟再繫数词楮尾七首 其三","author":"陈维崧","text":"今年离别，石畔梅花开似雪。\n骏马驰坡，又见流光换碧罗。\n归鞍暂息，看汝机边还作织。\n秋月当头，重附租船江岸游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25428,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 岁暮灯下作家书竟再繫数词楮尾七首 其四","author":"陈维崧","text":"地名破冢，郭璞墓前波浪汹。\n细剔银缸，话尽秋宵角枕凉。\n橘红橙绿，九月敬亭山畔宿。\n水鸟斜飞，又逐孤篷一夜归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25429,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 岁暮灯下作家书竟再繫数词楮尾七首 其五","author":"陈维崧","text":"曲阿湖上，重看縠纹平似掌。\n及到邗沟，丝雨斜风水驿愁。\n败荷衰柳，且罢程邮红玉酒。\n群盗如毛，月黑邻船响箭刀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25430,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 岁暮灯下作家书竟再繫数词楮尾七首 其六","author":"陈维崧","text":"吴霜点鬓，客况文情都落尽。\n检点行装，泪滴珍珠叠满箱。\n并州曾到，也拟开怀还一笑。\n尘务相牵，执手云郎送上船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25431,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 岁暮灯下作家书竟再繫数词楮尾七首 其七","author":"陈维崧","text":"客船风雨，冷雁湿猿齐夜语。\n欲作家书，腹转车轮一字无。\n经年如此，愁里光阴能有几。\n预报归期，又在梅开似雪时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25432,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"柳含烟 本事","author":"陈维崧","text":"灵和柳，弄晴春，轻飐江南绿水。\n东风陌上又河边，得人怜。\n乱搭琼楼丝一把，故与玉郎牵惹。\n而今香絮滚斜晖，几时归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25433,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"好事近  坐姜家墩怀吕黍字","author":"陈维崧","text":"闲坐竹林边，绿暗暮禽啁唽。\n跂脚科头笑傲，更主人投辖。\n万竿丛筱昼阴阴，风动声敲戛。\n忆昔悲歌痛饮，有疏狂吕八。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25434,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"荆州亭  题扇上琵琶行图","author":"陈维崧","text":"苦竹黄芦想像，湓浦浔阳怊怅。\n半幅小丹青，画出东船西舫。\n白傅青衫已往，商妇琵琶犹响。\n无限断肠声，只在行间纸上。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25435,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"眉峰碧 春夜见新月","author":"陈维崧","text":"宝马萦帘押，金斗薰珠袷。\n一团醉玉怯春寒，斜向红裯压。\n无语抛银甲，且自偎香鸭。\n半钩纤月柳梢头，问谁偷把青天搯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25436,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"武陵春 舟次虎邱","author":"陈维崧","text":"四面吴山争窈窕，浓绿罨归舟。\n寺外人家桥上楼，春水尽情流。\n主簿祠前斜日漾，惹起旧时愁。\n石上苔痕青未休，曾做少年游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25437,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"阮郎归 为灵雏题画","author":"陈维崧","text":"吴绫一幅滑如脂，江南好画师。\n长松几树碧离离，斜添斑竹枝。\n烟似水，雨如丝，梅花帘外垂。\n更题半阕断肠词，樊川杜牧之。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25438,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"桃源忆故人 人日感旧","author":"陈维崧","text":"画帘垂处春光乱，百感最难消遣。\n记得风斜彩燕，小立珍珠院。\n岁华又到黏鸡宴，砌下春兰尚浅。\n人日春人不见，日近人儿远。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25439,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"桃源忆故人  春日过澹生校书所居旧址","author":"陈维崧","text":"酒阑曾过平康宿，风飐绣帘簌簌。\n红板桥连西曲，微雨樱桃熟。\n而今风景伤春目，不见沿溪花竹。\n荠麦平畴摇绿，蛱蝶和烟逐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25440,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"摊破浣溪沙 雨泊秦邮","author":"陈维崧","text":"十顷盂湖碧似烟，四围蒲稗水连天。\n渚鸟群飞声格格，戏长川。\n独对烟波思往事，那堪风物又残年。\n且贳秦邮城下酒，拨湘弦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25441,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"摊破浣溪沙  冬闺","author":"陈维崧","text":"绮疏六扇掩玻瓈，花影罘罳漾衵衣。\n学绾翻荷新样髻，日将西。\n有恨篝前银鸭睡，无情筝上钿蝉啼。\n独对水仙花絮语，太悽迷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25442,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"朝中措  平山堂怀古用欧公原韵","author":"陈维崧","text":"我来吊古傍隋宫，板渚雨濛濛。\n依旧平山堂外，淡烟疏柳长空。\n年年此地，漫天榆荚，著地东风。\n太息韶华几换，游人犹想仙翁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25443,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海棠春  闺词和阮亭原韵四首 其一","author":"陈维崧","text":"春闺金麦微微响，青凤胫、轻移银网。\n睡眼恰初瞤，一片红酥漾。\n邻姬眉黛遥山样，怪昨日、邀侬相赏。\n遮莫绣帘前，有个人张敞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25444,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海棠春  闺词和阮亭原韵四首 其二","author":"陈维崧","text":"惺忪春梦何时足，拚昼掩、银屏六曲。\n绣倦歇鸳针，藏在沈香褥。\n藕花衾压桃花肉，微睡醒、低呼小玉。\n何处弄琮琤，似戛潇湘竹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25445,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海棠春  闺词和阮亭原韵四首 其三","author":"陈维崧","text":"韩冯啄破秋千影，琼扇里、春酲初醒。\n半晌卸金虫，小试兰汤冷。\n后堂憎杀青铜镜，怕照见、云鬟未整。\n莫道少人窥，天上堆金饼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25446,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海棠春  闺词和阮亭原韵四首 其四","author":"陈维崧","text":"红蕤枕上啼红雨，且坐听、玫瑰双杵。\n纤手剔兰煤，楼外宾鸿语。\n马蹄连夜堂堂去，偏无赖、三更谯鼓。\n难捉是萧郎，不比床头麈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25447,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海棠春 题美女图为闺人称寿","author":"陈维崧","text":"智琼年小逢珍偶，多少事、灯前酒后。\n夜合自开花，摇动珠帘口。\n檀奴戏觅南朝手，图倩女、为娘称寿。\n一笑溜横波，媚靥红于酒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25448,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"眼儿媚  过城南小曲感旧","author":"陈维崧","text":"青楼斜拂小春池，池上绿杨枝。\n态奴歌管，念奴弦索，唱尽新词。\n重来行过章台弄，往事少人知。\n半湖碧浪，满园斑竹，万种凄其。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25449,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]