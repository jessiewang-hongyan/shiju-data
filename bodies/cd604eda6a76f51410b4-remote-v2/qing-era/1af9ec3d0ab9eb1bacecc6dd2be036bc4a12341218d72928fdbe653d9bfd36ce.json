[{"title":"游天宁寺","author":"俞绣孙","text":"东风吹絮暮春时，客到禅扉有鹤知。\n松树两行青嶂立，藤花一架紫云垂。\n无缘福地生欢喜，但祝人间少别离。\n归去也应更回首，暮钟声里意迟迟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28376,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"并蒂莲","author":"许禧身","text":"平明信步绕芳塘，傍柳随堤过曲廊。\n湖比鸳鸯还共泛，亭开荷芰自相庄。\n出尘不染双心洁，并影同看佳兴长。\n我本爱花花对语，频将佳兆祝祯祥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28377,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"小园","author":"许之雯","text":"雨过苔痕涩，云来花影迷。\n水平双燕掠，风暖一莺啼。\n亭小随池曲，山低共树齐。\n春光何处最，红杏女墙西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28378,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟古出塞 其一","author":"许之雯","text":"饮马青海头，弯弓长城北。\n不取燕支山，恐君重颜色。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28379,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟古出塞 其二","author":"许之雯","text":"秦地旧山河，汉家新戍卒。\n照彻玉关寒，一片闺中月。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28380,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟古出塞 其三","author":"许之雯","text":"射虎李将军，斩蛟周孝侯。\n数奇辜利器，未获月支头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28381,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟古出塞 其四","author":"许之雯","text":"将军犹转战，宰相莫和亲。\n投笔男儿志，羞将托妇人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28382,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏蓼主人秋风失意书以代柬","author":"许之雯","text":"休将得失感生平，花样更番学未成。\n黄卷青镫仍故物，白衣苍狗是科名。\n驹光有限宜同惜，蜗角无多莫苦争。\n他日得营三径业，肯从浊世问前程。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28383,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋夜曲","author":"孙镇","text":"秋镫耿耿凉宵永，玉露无声下金井。\n空山野鹤忽飞来，踏碎庭前松月影。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28384,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"高阁","author":"孙镇","text":"高阁霭春晖，幽居山四围。\n风梳杨柳瘦，雨润豆苗肥。\n树色侵书幌，江光漾钓矶。\n地偏心自静，相赏欲忘机。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28385,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨后看花","author":"葛远","text":"一夜雨淋漓，花开几枝亚。\n嫣然色更娇，未逐东风谢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28386,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寒食","author":"葛远","text":"山村初听杜鹃声，日暖风和一晌晴。\n寒食有诗春意足，不闻天子召韩翃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28387,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"家大人命咏见志勉呈","author":"葛远","text":"几人代父走征鞍，远戍远城胜克汗。\n一骑明驼辞火伴，木兰犹是女儿还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28388,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"垂钓","author":"葛远","text":"林塘一曲偶凭栏，试问清阴把钓竿。\n瞥见浮个下深碧，鱼游萍底不知寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28389,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春晴","author":"葛远","text":"小阁帘高卷，时还鹊噪晴。\n春花争灿烂，池水最澄清。\n燕啄香泥暖，蜂驮翠絮轻。\n倚窗收绣谱，扫几设棋枰。\n听野农歌接，看山画本成。\n分题诗未就，催卷有新莺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28390,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"制椒枕寄外 其一","author":"葛远","text":"孤镫静坐巧安排，锦字回文花样佳。\n一握椒聊寄珍重，此中芬馥是侬怀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28391,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"制椒枕寄外 其二","author":"葛远","text":"旅馆凄凉动客愁，邯郸未到梦难休。\n凭将一瞬黄粱熟，无事痴情叹白头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28392,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送六陔弟之黔","author":"葛远","text":"年少初为客，焉知行路难。\n黔山二千里，湘水万重澜。\n且听骊歌悄，翻怜雁影单。\n家书宜早付，长铗莫轻弹。\n志大须鹏展，枝栖愿莺安。\n前途殷御李，名士喜瞻韩。\n笔札从容出，诗书蕴藉看。\n寓公防落魄，游子恐孤寒。\n堂上缝衣密，闺中织锦宽。\n得如青眼愿，毋遣白头叹。\n恋栈犹凡马，抟空要健翰。\n田园未荒芜，知倦及时还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28393,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梦归","author":"李端临","text":"尺鲤东流雁北飞，椿萱风景话依依。\n八千馀里须臾到，梦里还家也当归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28394,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"偶题","author":"李端临","text":"诗思水犹浅，花容人更癯。\n蝶衣和粉晒，鹦母隔帘?。\n石篆半红藓，春阴满绿芜。\n借閒补诗句，何事唤提壶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28395,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"初夏","author":"李端临","text":"花饶午韵鸟声碎，柳曳晴丝蝶路迷。\n独倚阑干春影里，一帘红透夕阳西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28396,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清秋","author":"李端临","text":"清秋明长江，残蟾窥芸窗。\n梦毂不可极，栖鸦鸣一双。\n起坐有诗思，宿墨饱著字。\n苦吟羞消蛩，声乾叶满地。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28397,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"即事","author":"李端临","text":"矮纸墨花凝，秃锋毫不棱。\n劲风飏积雪，斜日堕檐冰。\n蓟北迟归鸟，窗南击冻蝇。\n夜分群动息，诗思一镫青。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28398,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"且月二十九日览玉泉山昆明湖","author":"李端临","text":"远山抱城转，傍晚翠云横。\n禁树蝉争噪，垂杨莺一鸣。\n旧桥经雨断，斜日就烟明。\n呼艇前溪去，荷花香乱生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28399,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"读岱山姊遗诗","author":"李端临","text":"于兹廿载死生离，亚字阑干独立时。\n赤鲤不传泉下信，红镫忍读旧存诗。\n频逢梦里浑如昔，每到花时不减思。\n愁听子规声断续，暝烟疏雨一帘垂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28400,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感怀 其一","author":"李端临","text":"翻澜不在多，涓滴成江河。\n滋蔓不在天，茁芽缘高柯。\n如何断不断，机见独蹉跎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28401,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感怀 其二","author":"李端临","text":"菖蒲邂蚤虱，蚰蜒引可怵。\n奇香衣恣薰，损肺毋乃疾。\n如何顿忘损，而云岂无益。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28402,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感怀 其三","author":"李端临","text":"苔城蛾子出，驮粒课时术。\n鹪鹩微乎微，营巢借枝一。\n如何耽食眠，虚此难再日。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28403,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感怀 其四","author":"李端临","text":"草木有本性，扶干自然直。\n鸢鱼有天机，何处著智力。\n如何矫揉者，门内亦粉饰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28404,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"小园","author":"李端临","text":"棂静云流绿，墙高日下迟。\n竹篱香雨后，萍沼薄凉时。\n花丛蜂寻蕊，叶摇禽上枝。\n眼前无此景，梦里故园窥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28405,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送外遵朝谕游历日本美利加等国 其一","author":"李端临","text":"片帆飞去海山秋，好向扶桑作壮游。\n七万鹏抟真快事，天风吹送转星球。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28406,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送外遵朝谕游历日本美利加等国 其二","author":"李端临","text":"记睹十洲未足夸，水蒸舟更火飞车。\n丈夫四海平生志，莫向临歧感鬓华。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28407,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"有感","author":"李端临","text":"繁枝删向碧芙蓉，霜干作虬青古松。\n黄叶半山斜日静，浮云偏蔽最高峰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28408,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄外 其一","author":"李端临","text":"寄书万里祝加餐，又展君书月下看。\n一片离情清影里，何时同照泪痕乾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28409,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄外 其二","author":"李端临","text":"身同蠖屈住长安，别后人情倍觉难。\n静掩重门浑似隐，北风吹雪上雕栏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28410,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"红馀","author":"李端临","text":"红馀仍握管，日影上帘钩。\n宿雾随风散，春冰逐水流。\n轨涂半庐墓，柔舻满沧洲。\n此处人家少，溪边一钓舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28411,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"思亲","author":"李端临","text":"津门月里步篱边，仿佛当年问寝天。\n昨夜梦回离别处，子规啼断一溪烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28412,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"微雨","author":"李端临","text":"策雨两三点，蛙鼓不能声。\n半篙海河水，九里苇根城。\n暑重风仍湿，月圆潮倍生。\n柳阴到窗隙，花气满帘旌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28413,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"村居","author":"李端临","text":"拂墙杨柳碧丝丝，已折杨枝活旧篱。\n双涧水閒鸥梦稳，一天风静燕归迟。\n新花好借朝云护，矮竹权乘微雨移。\n不信村居少诗味，卷中羞羼热官诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28414,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闰月七日观水","author":"李端临","text":"不系舟如是，举家今一行。\n桥腰野人语，树顶乱泉鸣。\n落日嵌汀岸，归艭沿柳城。\n剧怜千亩地，都作怒涛声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28415,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"为夫子董理图籍有感","author":"李端临","text":"镫味难忘昔，戎曹廿二年。\n图书千万卷，买自卖文钱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28416,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"小园","author":"傅范淑","text":"江南草长六朝地，蓟北春寒二月天。\n花睡红犹云影护，柳迟青未雨丝牵。\n沁脾新汲烹茶水，买醉不抛沽酒钱。\n裁报东风生浅渚，小园争擘衍波笺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28417,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日行","author":"傅范淑","text":"海棠渍露杨搓烟，何似霜叶红秋边。\n仓庚紫乙花中天，啁啾声来圆复圆。\n如歌互答如管弦，妙手偶得诗自然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28418,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆览昆明湖","author":"傅范淑","text":"回首玉泉下，白莲十里花。\n扁舟载落日，欹柳锁流霞。\n断续蝉声噪，参差鹭影斜。\n堤边诸钓叟，艳说驻龙车。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28419,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夏凉","author":"傅范淑","text":"千柳万柳风丝柔，五月六月荷塘秋。\n雷声僻地醒睡鹿，月影一天凉眠鸥。\n池蛙夜静鼓吹起，十二栏干花雨收。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28420,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋","author":"傅范淑","text":"客里秋光又一年，拈题分韵坐镫前。\n风敲霜叶漏初永，月上窗纱夜未眠。\n骂鬼诗成删草稿，惊人句欲写花笺。\n谁家砧杵惊寒起，况是南楼雁过天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28421,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晓起","author":"傅范淑","text":"丝丝绿柳绾朝烟，燕子衔泥去复还。\n花外白云呼不起，日高犹抱石根眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28422,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"敬呈厚斋伯父 其一","author":"金芳荃","text":"凤池旧迹剧堪怜，零落朱门锁晚烟。\n静夜挑镫论家世，秋风泪洒断肠篇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28423,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"敬呈厚斋伯父 其二","author":"金芳荃","text":"玉树摧残感易生，倦游湖海掩柴荆。\n遗珠不遇犹堪慰，定许龙头属老成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28424,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"镫下老母述旧事","author":"金芳荃","text":"云黯苍梧日，凄凉忍细论。\n慈乌怜弱羽，小草托孤根。\n频寄鹪鹩迹，难招杜宇魂。\n茹荼廿馀载，肠断未酬恩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28425,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"书福山王婉佺夫人列女传注后","author":"刘韵","text":"更生西汉儒，举行冠群彦。\n立朝遇闇主，宫寝恣荒宴。\n戒昧司晨鸡，谣起涎尾燕。\n忧深托讽谕，表进《列女传》。\n精胜匡衡疏，谲异谷永谏。\n七篇举其纲，百人萃厥选。\n王政首母仪，阴教系治典。\n其次及贤明，家国佐安奠。\n仁智德乃尊，贞顺性斯善。\n处变重节义，遴才取通辩。\n有劝必有惩，孽嬖居其殿。\n徽音慕肃雍，容饰薄盼倩，上自翚翟贵，下逮荆布贱。\n众美既毕陈，四德亦备见。\n鞶鉴昭千秋，搜讨信云遍。\n谁欤续补辑，两京厕名媛。\n纵增彤管辉，未免时代舛。\n昔闻大家注，训故藉排纂。\n又闻《长康图》，丹青妙独擅。\n恨生千载下，古本失流转。\n东海有女宗，观书目如电。\n徵诗订三家，集解编八卷。\n残文补阙漏，奥义畅推衍。\n同时得梁氏，振绮罗文献。\n笺释足并行，汉学留一线。\n披函日循诵，淑范生敬羡。\n颇思绘屏风，遗像识真面。\n联代铸金事，朝夕薰香荐。\n远愧孙夫人，列传系序赞。\n三复中垒书，述古发长叹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28426,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"侍姑冯夫人游石鼓山","author":"刘韵","text":"佐馂得馀閒，游山觅幽赏。\n晨兴奉板舆，意在怡色养。\n出郊二十里，境渐异墨尘坱。\n奇峰迎面来，松筱密如幌。\n穹窿大石鼓，擘自巨灵掌。\n鸟道盘一线，螺屏列万丈。\n舆夫作蛇行，蜿蜒陟林莽。\n古刹峙山椒，结构极闳敞。\n衣钵五代遗，榱桷普陀仿。\n登攀屴崱峰，白云任俯仰。\n岩洞探灵源，仙踪殊惝恍。\n翼然水云亭，愚斋署诗榜。\n寺门涌泉出，有池数弓广。\n久旱从不枯，佛法现龙象。\n寺左喝水岩，壁錾大士像。\n活活龙头泉，激轮钟自响。\n右瞰达摩洞，幽僻莫可状。\n面壁悟禅机，眼底颈明朗。\n纵无换骨丹，颇萌出尘想。\n慈姑困步履，扶掖代藜杖。\n不愁暝色催，愿睹白毫放。\n停车为少留，归路月已上。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28427,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"陪王霨斋夫人登钓龙台","author":"刘韵","text":"鱼軿揽胜得追从，遥指高台是钓龙。\n出海烟岚迷树色，摩厓碑碣剔苔封。\n久销霸业沈枯井，平挹秋光接远峰。\n眼力尽时转空阔，待看健笔写云松。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28428,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"暮秋病起 其一","author":"刘韵","text":"年来多病少欢愉，离得绳床若梦苏。\n理鬓漫将尘镜拂，添香犹倩小鬟扶。\n懒收红叶题银管，爱折黄花插玉壶。\n惆怅寒窗风雨夜，书帏照影一镫孤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28429,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"暮秋病起 其二","author":"刘韵","text":"秋光黯淡透虚棂，石鼎香飘药火青。\n听雨梦回惊蟋蟀，临风身怯颤蜻蜓。\n久疏井臼惭梁案，苦忆乡园隔谢庭。\n且对高堂说强健，亲携菊酒慰衰龄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28430,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄外子海上","author":"刘韵","text":"萱闱日日盻归槎，腊鼓声中未到家。\n曾约秋窗评菊谱，翻劳烟驿剪梅花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28431,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将随外子南游留别红雨楼","author":"刘韵","text":"缃桃压槛绿阴稠，妆镜安排是此楼。\n琴簟将移花似泣，珠栊欲卸鸟知愁。\n凿楹万卷留纱护，黏壁千篇启箧收。\n默祝慈姑春不老，年年海屋数添筹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28432,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"上海城隍庙有园一区花木蓊翳流水萦带颇饶幽趣俗名小西湖秋日与外子过此作歌纪之","author":"刘韵","text":"小西湖，湖水清，沦涟一勺分仙瀛。\n有亭翼然如建瓴，文阑百摺环螺屏。\n疏荭断蓼映秋色，此中可寻鸥鹭盟。\n小云台，山石叠，奇礓竦削苔翠积。\n腾空恍挟怒猊舞，卧云似作蟠龙蛰。\n剔透玲珑无傍依，此中疑有神仙窟。\n我来海国游，秋光满林圃。\n树头嘒蝉静，池面喁鱼聚。\n霜枫落叶任低昂，篱菊延芳作宾主。\n宛延山下径，回环湖上堤。\n登临既乘兴，吟眺几忘疲。\n小桥长廊缓缓步，行尽湖堤觅山路。\n山颠风景无限好，一览吴淞雪树渺，归来好趁夕阳时，山渌湖光黯相照。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28433,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送外子于役秦中","author":"刘韵","text":"壮矣此行役，横腰佩太阿。\n探奇历西岳，陟险渡黄河。\n风雪关前重，豺貙塞外多。\n归期宜早决，堂上鬓双皤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28434,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"携忠儿归甬上别外子","author":"刘韵","text":"自暌慈姑侧，五历暑与寒。\n宦辙随闽峤，攀陟恒苦艰。\n眷念姑恩重，昕夕愁眉攒。\n纵有淑贤娣，耿耿心未安。\n君也为贫仕，还里良亦难。\n显扬志犹沮，待时振羽翰。\n吾病亟思归，且得共馂餐。\n有子甫八龄，可博含饴欢。\n中馈付姬媵，传舍影不单。\n功业君自勉，井臼吾当殚。\n偕隐俟异日，临别增辛酸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28435,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"白云寺","author":"刘韵","text":"寂寞白云寺，当门好鸟鸣。\n日高山雾薄，风定树烟横。\n岩底闻人语，墙头落涧声。\n飞仙渺难即，何处学长生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28436,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"楼居即事","author":"刘韵","text":"开轩俯瞰尽桃花，映带衣裾灿晓霞。\n雨后收花待春雪，为儿靧面作妍华。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28437,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"漫兴","author":"程淑","text":"吟情游兴向谁论，到处登临酒一樽。\n漠漠青山云外塔，萧萧黄叶雨中村。\n凉秋似水寻无迹，好梦成烟散有痕。\n底事清愁忽枨触，数声啼鸟又黄昏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28438,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送侄女之鸳湖","author":"程淑","text":"呕哑柔橹划波轻，水驿江村路几程。\n木落寒山秋色远，云开断塔夕阳明。\n寄书恐阻天边雁，折柳愁听笛里声。\n此去胜游应记得，一楼烟雨暗重城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28439,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"待绣玉姊不至","author":"程淑","text":"闻说云軿降，先期扫敝庐。\n足音偏寂尔，目望竟劳余。\n天末鸿飞渺，檐前鹊噪虚。\n閒庭明月夜，伫立尚踌躇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28440,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晚眺","author":"徐熙珍","text":"倦鸟飞还日已斜，残霞绮丽映窗纱。\n停针无事搴帘坐，閒看游鱼唼水花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28441,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"远眺","author":"徐熙珍","text":"浮图高处望依稀，海阔天空兴欲飞。\n万顷稻田桑柘外，遥山遥水接烟霏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28442,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]