[{"title":"思越人 杜圻寻范少伯宅","author":"董元恺","text":"笠湖滨，包山麓，人传一舸西施。\n消夏湾头曾醉倚，同游羞杀鸱夷。\n黄金铸就谁堪羡。\n霸越平吴功显。\n纵是计然三策善。\n独嗟爱子难免。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35438,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"思远人 得闲信，和晏小山韵","author":"董元恺","text":"劈开双鲤妆台信，报与平安客。\n相思一点，伤心两字，远寄何由得。\n东风泪裹珍珠滴。\n和入乌丝墨。\n染处忽惊红，似浓如淡，映桃花笺色。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35439,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南柯子 春闺","author":"董元恺","text":"柳影笼蛛网。\n蕉阴映绮窗。\n朝晖错认是残阳。\n又是一番残梦，费思量。\n清镜慵开匣，青衫慢爇香。\n惊魂风里絮悠扬。\n恰趁花间蝴蝶，过东墙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35440,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉红妆 灯夜纪艳","author":"董元恺","text":"相携女伴怯风凉。\n欲添衣，又进房。\n朝来新样绣鞋帮。\n更换着，是谁长。\n就中眉鬓独窥郎。\n狂眼看，一时忙。\n拾得玉彄犀合子，难暗认，试猜详。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35441,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"青门引 咏玉茎兰","author":"董元恺","text":"九畹芳菲节。\n绿玉丛中堆雪。\n湘潭月冷楚烟微，嫣然独对，不遣遗芳歇。\n看来啼眼幽姿洁。\n香色都清绝。\n粉痕欲印翠袖，轻携一笑佳人折。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35442,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉花阴 九日饮豫章城楼，和李清照重阳韵","author":"董元恺","text":"城隅渌水明于画。\n烟霭笼晴兽。\n无恙是黄花，不奈西风，吹入征衫透。\n一樽那管身前后。\n好挹浮丘袖。\n莫更去登高，满眼江山，赚得人清瘦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35443,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玉团儿 咏猫","author":"董元恺","text":"深闺驯绕闲时节，卧花茵，香团白雪，爪住湘裙，回身欲捕，绣成双蝶。\n春来更惹人怜惜，怪无端、鱼羹虚设。\n暗响金铃，乱翻鸳瓦，把人抛撒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35444,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寻芳草 咏草","author":"董元恺","text":"深院望王孙，看几处、平芜春草。\n正萋萋、南浦西堂悄。\n苔痕印、湘裙扫。\n绿遍短长亭，断送尽、行人多少。\n共愁生、一夜如丝绕。\n芳茵外、东风晓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35445,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怨王孙 春闺雪夜，和李清照韵二首 其一","author":"董元恺","text":"钟静香悄。\n酒欺花恼。\n疏竹轻巧，琐窗洞晓。\n倦倚兽炭围红。\n隔帘风。\n撒盐萦絮弥漫处。\n吹春去。\n似把青春负。\n最爱玲珑，纤软仿佛轻云。\n共文君。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35446,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怨王孙 春闺雪夜，和李清照韵二首 其二","author":"董元恺","text":"玉楼初晚。\n银篝小院。\n著处魂消，偎时梦断。\n相对郢曲难传。\n话缠绵。\n湔裙时节偏萦惹。\n将侬舍。\n恰又愁来也。\n无恨伤春，情性整整斜斜。\n乱杨花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35447,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江月晃重山 月下江行","author":"董元恺","text":"楚尾平铺银浪，吴头稳挂轻帆。\n江波不动镜光涵。\n推蓬望，清露湿征衫。\n树色遥提影翠，山容漱水挼蓝。\n六朝如梦鸟呢喃。\n模糊处，回首忆江南。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35448,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杏花天 咏千叶杏花","author":"董元恺","text":"千丝雨湿东风剪。\n短墙外、红轻翠软。\n绛绡重叠胭脂浅。\n艳夺桃花人面。\n倚云栽、日边开遍。\n和笑折、明霞舒卷。\n一枝妒杀红儿见。\n沽酒这家庭院。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35449,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浪淘沙 七夕 新月一弓弯，乌鹊桥圜，云帡缥缈度银湾。天上恐无莲漏滴，忘却更残","author":"董元恺","text":"莫为见时难，锦泪潸潸。\n有人犹自独凭阑。\n若果一年真一度，还胜人间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35450,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"摘红英 美人饲金鱼","author":"董元恺","text":"晴光漏。\n清阴昼。\n风吹细縠双纹皱。\n春波影，秋波映。\n一片香云，游鱼惯认。\n横钗溜。\n连钱覆。\n殷勤粉饵烦纤手。\n波痕定。\n波心并。\n嗔郎惊散，邀郎闲凭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35451,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"风马儿 秋闺","author":"董元恺","text":"悲哉秋气夜寥寥。\n奈风又潇潇。\n雨又潇潇。\n欹枕孤帏，虚度可怜宵。\n迢迢。\n惊闻雁阵影嘹嘹。\n更灯影摇摇。\n竹影摇摇。\n千里关山，著处梦魂飘。\n朝朝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35452,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南 西湖曲十首 其一","author":"董元恺","text":"湖上水，风起浪纹平。\n几叶丝垂鹅子淡，半篙烟染鸭头清。\n镜里放船行。\n珠帘捲，初映晓妆成。\n翠聚两峰眉黛簇，碧含一水眼波明。\n荇藻更交横。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35453,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南 西湖曲十首 其二","author":"董元恺","text":"湖上月，风露满身幽。\n银汉直垂千顷碧，琉璃冷浸一天秋。\n长啸倚楼头。\n三潭好，辍棹且夷犹。\n弄影欲骑鹏翼去，清光偏共酒樽留。\n易值此宵不。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35454,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南 西湖曲十首 其三","author":"董元恺","text":"湖上柳，低傍六桥移。\n罗幔暗窥慵望眼，画帘高捲细舒眉。\n玉笛不胜吹。\n谁攀折，才起欲眠时。\n乱掷莺梭惊两两，轻翻燕剪几丝丝。\n肠断柳枝词。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35455,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南 西湖曲十首 其四","author":"董元恺","text":"湖上花，掩映绿窗纱。\n曲院风摇仙子步，苏堤春醉美人家。\n烂漫自交加。\n堪竞赏，开遍海棠花。\n晓起一枝和露折，午阴几树带溪斜。\n十里灿晴霞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35456,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南 西湖曲十首 其五","author":"董元恺","text":"湖上女，三五唤同群。\n浮渲梳头花样髻，轻拖窣地月华裙。\n低拜岳王坟。\n回步屧，敛袂向湖滨。\n力怯却嫌夫婿隔，路欹微向侍儿嗔。\n宜笑总宜颦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35457,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南 西湖曲十首 其六","author":"董元恺","text":"湖上草，漠漠复迢迢。\n绣陌浓铺罗绮席，香尘暗惹绿裙腰。\n凭遍木兰桡。\n寒食近，第一映波桥。\n斜影铁嘶金勒动，泪痕珠送纸钱烧。\n著处梦魂消。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35458,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南 西湖曲十首 其七","author":"董元恺","text":"湖上雨，景色淡空濛。\n几处楼台迷倒影，满溪烟树失高峰。\n曲港小船通。\n西泠路，千涧响淙淙。\n破竹泉高天界水，翻经声和上方钟。\n游屐片云封。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35459,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南 西湖曲十首 其八","author":"董元恺","text":"湖上舫，红粉漾晴空。\n绣幕微褰清影里，纱窗半启碧波中。\n小泊断桥东。\n凭栏望，心事暗惺忪。\n六曲银屏妆镜晓，一帘春水黛痕浓。\n摇入藕花丛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35460,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南 西湖曲十首 其九","author":"董元恺","text":"湖上酒，日带杖头钱。\n竹叶杯浮桃叶伎，梨花春酿杏花天。\n一醉酒家眠。\n停觞处，珍重客中餐。\n底事沉吟又如笑，几回温却又重寒。\n愁绪忽漫漫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35461,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南 西湖曲十首 其十","author":"董元恺","text":"湖上雪，六出正弥漫。\n白尽青山绿鬓改，银装琼砌玉楼寒。\n翠袖倚栏杆。\n乘兴去，凄断六桥湾。\n苏小梦迷油壁杳，林逋魂绕暗香闲。\n斜湿酒旗还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35462,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"芳草渡 松陵舟中送别","author":"董元恺","text":"吴江碧，吴山青。\n兰风起，满洞庭。\n骊歌愁绝不堪听。\n从兹去，郎乘马，妾扬舲。\n还则愿。\n尘吹转。\n辙迹随郎近远。\n怀明月，指双星。\n相向冥。\n郎抱影。\n妾倚形。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35463,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"金凤钩 咏绣鞋","author":"董元恺","text":"昨宵绣，幕曾近。\n怪花底、湘帘初褪。\n纤如钩月，柔如削玉，掌上看来越韵。\n莲踪一捻莲痕印。\n向洛浦、香尘微衬。\n双双綵雀，盈盈罗袜，稳称凌波身分。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35464,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天 其一 灯前花影","author":"董元恺","text":"醒写精神醉写容。\n柔枝无力倚帘栊。\n衬将皓月分肥瘦，笼得轻烟别淡浓。\n青镜畔，碧纱中。\n兰膏烧彻转玲珑。\n欲教移入罗帏里，好把红缸照院东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35465,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天 其二 月下灯花","author":"董元恺","text":"金波滟滟玉缸融。\n碧蕊离离白路浓。\n笑剔芳心凝兔影，暗添喜色映蟾宫。\n银汉北，画堂东。\n花开偏照百花丛。\n嫦娥此夜休垂泪，落尽垂珠一穗中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35466,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天 其一 闻鹧鸪","author":"董元恺","text":"楚水吴山何限情。\n透花窥鸟最分明。\n惟奈瘴烟笼饮啄，亦悔梅岭阻归程。\n一片雨，五音清。\n无那春风欲送行。\n秦人只解歌为曲，歌按秦楼梦不成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35467,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天 其二 春闺","author":"董元恺","text":"弱柳千条杏一枝。\n已凉天气未寒时。\n故将别泪和乡泪，莫遣佳期更后期。\n两不见，暗相思。\n浅深更漏妾偏知。\n低头闷把衣襟撚，为报春风且莫吹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35468,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天 其三 春情","author":"董元恺","text":"远客辞家月再圆。\n绿杨如发雨如烟。\n梁间燕子闻长叹，楼上花枝照独眠。\n兴又寝，倚阑干。\n各自当情各自欢。\n回身泣向寥天月，恰漏清光落枕边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35469,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天 其四 秋闺","author":"董元恺","text":"山槛晴归漠漠烟。\n绿窗红泪冷涓涓。\n长疑好事皆虚事，可得潸然是偶然。\n兰烛烬，江波连。\n当时惆怅不曾眠。\n起来自擘纱窗破，病眼开时月正圆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35470,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天 其五 即席","author":"董元恺","text":"莫怪频频上此台。\n翠萝深处遍苍苔。\n能令瀑水清人境，更取峰霞入酒杯。\n堤柳动，野荭开。\n林下轻风待落梅。\n从来此地黄昏散，往事空成半醉来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35471,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玉楼春 其一 春怀","author":"董元恺","text":"丈夫飘荡今如此。\n更上江楼望江水。\n论交却忆十年时，怀袖未消三岁字。\n江柳影寒新雨地。\n无限幽芳徒欲寄。\n二月春风最断肠，一梦不须追往事。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35472,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玉楼春 其二 忆故园诸友","author":"董元恺","text":"闻道毗陵诗酒兴。\n何事经年断书信。\n相期共斗管弦来，今日知音一留听。\n玉漏声长灯耿耿。\n星汉渐移庭竹影。\n寒林晓际别生春，暗数残更不成寝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35473,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玉楼春 其三 春情","author":"董元恺","text":"帘捲青山巫峡晓。\n红艳影多风袅袅。\n今日残花昨日开，月色更添春色好。\n蝴蝶晴连池岸草。\n客枕幽单看春老。\n夜深微雨醉初醒，惆怅旧游无复到。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35474,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玉楼春 其四 春怨","author":"董元恺","text":"年年纵有春风便。\n楚竹离声为君变。\n点破繁华四五枝，零落胭脂两三片。\n未解多情梦梁殿。\n几度相思不相见。\n为他人作嫁衣裳，粉泪凝珠滴红线。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35475,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玉楼春 其五 秋村","author":"董元恺","text":"日暮东风芳草绿。\n衰柳寒芜绕茅屋。\n百树鸡桑半顷麻，数尺丝纶一竿竹。\n此处挂冠凉自足。\n黄菊倚风村酒熟。\n有时新月傍帘钩，唱到白蘋洲畔曲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35476,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玉楼春 其六 山行有怀","author":"董元恺","text":"京邑旧游劳梦想。\n中岳深林人独往。\n数村残照半岩阴，十亩春蔬一藜杖。\n一度相思一惆怅。\n心在君家辘轳上。\n随风好去落谁家，杨柳败梢飞叶响。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35477,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"瑞鹧鸪 闺情，集唐诗","author":"董元恺","text":"日照深红几树丝。\n只应闲看一枝枝。\n孤溪月满维舟夜，分隔休灯灭烛时。\n多为过防成后悔，谁怜梦好转相思。\n纤腰舞尽春杨柳，惟有春风仔细知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35478,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"瑞鹧鸪 其一 赋得春雪梅花，和东坡韵","author":"董元恺","text":"元辰稷雪雨廉纤。\n春色寒威分外严。\n冷蕊半成云母树，冰盘疑贮水晶盐。\n集衣似觉凝香艳，索笑还宜卧画檐。\n不道笛中歌一曲，东风吹彻万山尖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35479,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"瑞鹧鸪 其二 赋得春雪梅花，和东坡韵","author":"董元恺","text":"寒光初积暗金鸦。\n九陌争传咏雪车。\n上苑有香堪共影，群山无数独开花。\n黄昏月动王恭氅，缟带烟迷苏小家。\n应是争春梅雪共，广平新赋手频叉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35480,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"瑞鹧鸪 其三 赋得春雪梅花，和东坡韵","author":"董元恺","text":"仙人剪水合秾纤。\n洒竹侵松势更严。\n入户只应飞玉女，卷帘讵是刻无盐。\n孤根欲暖霜滋晓，五出无尘月挂檐。\n何事满空飘瑞叶，一枝斜压还峰尖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35481,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"瑞鹧鸪 其四 赋得春雪梅花，和东坡韵","author":"董元恺","text":"涂窗谁识暮栖鸦。\n和雨和烟畏日车。\n春到江南花是雪，月残辽海雪成花。\n天因不夜银千顷，水更无声玉万家。\n便使剡溪乘兴去，横枝遥见酒旗叉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35482,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 秋闺月夜","author":"董元恺","text":"极目海天空。\n碾就冰轮照碧峰。\n渐有清光穿入户，玲珑。\n玉臂云鬟素影中。\n独自倚梧桐。\n怅望银河待好风。\n夜半若随千里梦，相逢。\n皎洁随君处处同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35483,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 其一 下第别诸同年出都","author":"董元恺","text":"春别洛阳城，又见新书甲乙名。\n国器旧知收片玉，登瀛。\n历历银钩指下生。\n斜月入前楹。\n心仰莲峰望太清。\n春色年来谁是主，无成。\n半在云霄觉更荣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35484,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 其二 西归道中","author":"董元恺","text":"残月下寒沙。\n北斗阑干南斗斜。\n千里不辞行路远，天涯。\n独自狂夫不忆家。\n何处得停车。\n又见秦城换物华。\n白雪却嫌春色晚，飞花。\n深掩虚窗卧碧纱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35485,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 其三 送金明府归里","author":"董元恺","text":"文苑振金声。\n竹绕琴堂水绕城。\n愿以深心留善政，高名。\n朝野咸推重太平。\n县鼓应鸡鸣。\n桥上春风绿野明。\n若使巢由同此意，簪缨。\n笑引江帆带月行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35486,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 其四 旅馆对月","author":"董元恺","text":"月色白如霜。\n一片山花落笔床。\n检得旧书三四纸，成行。\n惟到樽前似故乡。\n不是少清光。\n依旧明朝在路旁。\n莫道蓟门秋信少，衡阳。\n转觉愁随夜夜长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35487,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 其五 闺情","author":"董元恺","text":"归棹隐孤舟。\n水带离声入梦流。\n锦字织成添别恨，悠悠。\n笑摘青梅叫阿侯。\n红烛乍迎秋。\n风物凄凄宿雨收。\n山色正来衔小苑，高楼。\n莫向银台半夜游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35488,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 其六 闺思","author":"董元恺","text":"谷鸟一声幽。\n莫遣杨花笑白头。\n先向红妆添晓梦，新愁。\n云物凄清拂曙流。\n共作草堂游。\n次第看花直到秋。\n况是故园摇落夜，登楼。\n罗绮晴骄绿水洲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35489,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 其七 少年行","author":"董元恺","text":"惊起欲栖乌。\n骏马翩翩新虎符。\n五凤街头闲勒辔，金吾。\n犹暇怜诗爱酒无。\n渺渺戍烟孤。\n笑倚春风杖辘轳。\n相忆杏花坛上去，樗蒲。\n只有挼莎更一呼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35490,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 其八 旅怀","author":"董元恺","text":"江静晚烟浓。\n二十年来万事同。\n夜半酒醒人不觉，秋风。\n晓月当帘挂玉弓。\n不复旧时容。\n砚匣留尘尽日封。\n汉水楚云千万里，无穷。\n半在邯郸驿树中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35491,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 其九 春兴","author":"董元恺","text":"岚翠湿人衣。\n或棹轻舟或杖藜。\n一院落花无客醉，莺啼。\n逸处能高怨处低。\n夜妒燕双栖。\n回看池塘影渐稀。\n唯有教坊南畔草，萋萋。\n空使王孙见即迷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35492,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 其十 春情","author":"董元恺","text":"更遣几年回。\n石径春风长绿苔。\n此夜断肠人不见，徘徊。\n昨夜缘何入梦来。\n江上落残梅。\n莫惜芳时醉酒杯。\n心似百花开未得，春催。\n坐对寒松手自栽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35493,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 其十一 春雪早行","author":"董元恺","text":"莫道梦魂遥。\n六出飞花处处飘。\n独倚破帘闲怅望，春朝。\n雪满长安酒价高。\n跃马上河桥。\n菰叶风翻绿剪刀。\n为近都门多送别，长条。\n力不禁风旋旋销。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35494,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 其十二 秋日遣兴","author":"董元恺","text":"乘兴且长歌。\n身外功名一任他。\n自欲放怀犹未得，如何。\n寂历秋花野意多。\n芳草渐成窠。\n镜水无风也自波。\n纵有邻人解吹笛，谁过。\n空苑凫鹥占浅莎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35495,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 其十三 秋感","author":"董元恺","text":"香桂折新柯。\n紫陌金堤映绮罗。\n莫是长安行乐地，蹉跎。\n旧路依然此重过。\n顾影逗轻波。\n到处闲门长薜萝。\n休唱开元供奉曲，无多。\n落叶纷纷暮雨和。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35496,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 其十四 西江岁暮，送友入都","author":"董元恺","text":"相亿一欣然。\n何处韶光最可怜。\n别后依依寒食里，东田。\n沙岸蒲帆隔野烟。\n湓水暮连天。\n愁见孤城落日边。\n共说京华旧游地，潸然。\n明日春风又一年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35497,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 其十五 春闺即事","author":"董元恺","text":"长望涕沾巾，深院无人独倚门。\n惆怅春归留不得，黄昏。\n静夜名香手自焚。\n邀我对芳樽。\n蝉翅低从两鬓分。\n唯有风光与踪迹，销魂。\n图遗萧郎问泪痕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35498,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]