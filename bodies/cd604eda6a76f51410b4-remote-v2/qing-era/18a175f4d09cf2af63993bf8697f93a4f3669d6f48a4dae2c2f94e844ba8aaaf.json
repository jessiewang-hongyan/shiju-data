[{"title":"摘得新 其一","author":"毛奇龄","text":"河没时。\n霜繁月已低。\n错惊银槅曙，起来迟。\n扶上鬓梢随意绾，乱丝丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36971,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"摘得新 其二","author":"毛奇龄","text":"日满檐。\n虫飞逐槛边。\n红衫腰后结，洗妆铅。\n指拂额黄时转侧，镜台前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36972,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"摘得新 其三","author":"毛奇龄","text":"欲上床。\n卸头留半妆。\n残膏衔兽颈，且缝裳。\n晶环绕指先知冷，偎谁傍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36973,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"摘得新 其四","author":"毛奇龄","text":"漏壶移。\n还将绣谱披。\n碧窗连锁下，响朝鸡。\n坐得画裙千百褶，夜何其。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36974,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"潇湘神 其一","author":"毛奇龄","text":"湘渚头。\n水北流。\n麦天风雨绿崖秋。\n蕉叶缉纱仍染绿，荆门红树好生愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36975,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"潇湘神 其二","author":"毛奇龄","text":"邛竹枝。\n生古祠。\n丛丛峭壁鹧鸪啼。\n朝雨过来还暮雨，不知神女几时归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36976,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蕃女怨 其一","author":"毛奇龄","text":"吴蛾窈窕初拂舞。\n堂下春雨。\n柳垂鋋，花转毂。\n暖翻红烛。\n只怜却舞汗衣干。\n又春寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36977,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蕃女怨 其二","author":"毛奇龄","text":"胡腾起作石国语。\n愁杀番女。\n罽靴尖，铜带软。\n蹴踏宛转。\n回头忽忆旧安西。\n两眉低。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36978,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南 其一","author":"毛奇龄","text":"江上路，横曼小长干。\n日炙水花红滟潋，烟浮堤草绿绵蛮。\n高阁尚春寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36979,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南 其二","author":"毛奇龄","text":"江路远，草际暗尘消。\n红药园深朝坠露，白苹渚浅夜添潮。\n人醉画栏桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36980,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南 其三","author":"毛奇龄","text":"堪忆处，曲巷试单衫。\n菱井啄泥悬社燕，桃根熨火种春蚕。\n风景是江南。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36981,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南 其四","author":"毛奇龄","text":"风景好，菰叶满横塘。\n碧带帩头骑马客，红钉屐子拢船娘。\n两两见鸳鸯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36982,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南 其五","author":"毛奇龄","text":"临大道，金碧绕天涯。\n出郭危楼云作埒，抱江小槛幔垂沙。\n记得那人家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36983,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南 其六","author":"毛奇龄","text":"前浦去，何处最能留。\n黄鸟换枝啼不歇，落花细逐往来舟。\n微月上汀洲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36984,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南 其七","author":"毛奇龄","text":"妆裹淡，时世在江淮。\n裙褶缓韬双笼袜，髻根松贴两梁钗。\n驱鸭去还来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36985,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南 其八","author":"毛奇龄","text":"频怅望，耶水与梧宫。\n谁浣素纱窥越女，因歌白苎号吴侬。\n总在石莲东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36986,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南 其九","author":"毛奇龄","text":"归去好，长听子规啼。\n红藕城桥风脉脉，黄梅江阁雨凄凄。\n愁思望中迷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36987,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南 其十","author":"毛奇龄","text":"江上市，帆落度桥来。\n两岸娼楼悬水栅，平船击板瞑烟开。\n渔火夜相猜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36988,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南 其十一","author":"毛奇龄","text":"芳草软，朝暮籍车轮。\n鸲鹆早寒调婢子，琵琶夜雨赛姑神。\n愁杀浪游人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36989,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"思帝乡 其一","author":"毛奇龄","text":"拨捩迟。\n歌挑舞又催。\n半折红衫遮柱，柱初移。\n慢揳银彄弦急，恐难支。\n不念中宵起，上弦时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36990,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"思帝乡 其二","author":"毛奇龄","text":"红帉。\n紫帉蓝绿帉。\n翠帽玉铃珠串，压金裙。\n垂手正巾徐步，毯毛深未分。\n倏见暖风吹绕，一堂云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36991,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"思帝乡 其三","author":"毛奇龄","text":"霓裳。\n羽衣谱未详。\n玉貌何人无力，绕珠珰。\n曳得钿缨累累，履跷裙自扬。\n犹自曲终徐立，听声长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36992,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浪淘沙 其一","author":"毛奇龄","text":"仙橘山前看橘花。\n单衫裁就橘山麻。\n春江空作揉蓝色，浪里淘来那得纱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36993,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浪淘沙 其二","author":"毛奇龄","text":"杉木为箄竹作檐。\n江潮能苦雨能甜。\n连朝只饮檐头雨，翻道江潮错着盐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36994,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 其一","author":"毛奇龄","text":"蕉叶领，橘花翘。\n红藤篾子束裙腰。\n私念鵔鸡颜色好。\n从谁道。\n栽作大郎头上帽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36995,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 其二","author":"毛奇龄","text":"藤菜暖，荔枝乾。\n青蛉河畔碧鱼餐。\n愿绞桄榔皮里肉，炊乌木。\n暂与小郎充晚腹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36996,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 其三","author":"毛奇龄","text":"赛起祠丛。\n木棉花发野椒红。\n记得丁郎山下路。\n敲铜鼓。\n九孔红螺扇遮舞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36997,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 其四","author":"毛奇龄","text":"卢橘催酸。\n风生蒌叶瘴烟寒。\n自卖明珠归极浦。\n心苦。\n白氎单衫着秋雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36998,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"甘州子 其一","author":"毛奇龄","text":"银床金井晓啼鸦。\n帘额上，衬红霞。\n同心栀子夜开花。\n和露折来斜。\n无好意，送与谢娘家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36999,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"甘州子 其二","author":"毛奇龄","text":"织金衫重懒提笔。\n双扼臂，卸来轻。\n平头吹蜡炙铜笙。\n叶底弄莺声。\n无好意，唤与顺郎听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37000,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江城子 其一","author":"毛奇龄","text":"赭门东上海潮青。\n古西陵。\n雨冥冥。\n越王宫女，着履在樟亭。\n亭下教兵遗竹矢，秋日晚，堕鸦翎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37001,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江城子 其二","author":"毛奇龄","text":"日出城头鸡子黄。\n照红妆。\n动江光。\n采莲江畔，锦缆藕丝长。\n欲问小姑愁隔浦，长独处，久无郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37002,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江城子 其三","author":"毛奇龄","text":"江深不畜伺潮鸡。\n春和出户迟。\n浣纱稀。\n双桥钗子，填粟缀红泥，裁得荷花新样好，羞比着，嫁时衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37003,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝 其一","author":"毛奇龄","text":"花萼楼前杨柳枝。\n美人剪綵自寻思。\n千丝万丝谁作样，剪来总似一条眉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37004,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝 其二","author":"毛奇龄","text":"白蝶爱翻轻粉絮，黄鹂偏上缕金条。\n双眉桑叶凭君看，无奈低边是细腰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37005,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"踏歌词 其一","author":"毛奇龄","text":"园里花成子，梁间絮作泥。\n风鸢移柱线，云母贴窗衣。\n漫摘鬓边篦，上有闹蛾儿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37006,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"踏歌词 其二","author":"毛奇龄","text":"网户黏虫翅，帘旌压柳条。\n整钗时对镜，结襻屡回绦。\n漫折井边桃，上有合欢梢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37007,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"天仙子 其一","author":"毛奇龄","text":"蜡炬乍开红芍药。\n枝头又噪星桥鹊。\n还疑荡子早归来，蛛网错。\n勾眼角。\n昨晚下阶裙带落。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37008,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"天仙子 其二","author":"毛奇龄","text":"玉茧牵丝缠宝帔。\n当胸绣出承恩字。\n朝朝独自捲衣裳，蜥蜴尾。\n长绕臂。\n谁识床头有龙子。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37009,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"天仙子 其三","author":"毛奇龄","text":"珠雀五层宫髻直。\n红绦盘委花砖级。\n太平天子用恩多，草露潗。\n裙裹湿。\n犹许蜻蜓上裙立。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37010,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"天仙子 其四","author":"毛奇龄","text":"墙里花枝墙外影。\n嘶騧缓踏飞花冷。\n隔墙见得不分明，金甃井。\n银络绠。\n井面看身见斜领。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37011,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"天仙子 其五","author":"毛奇龄","text":"新殿前头骑马去。\n射生籍里名初注。\n红裆垂镫手垂丝，回盼处。\n风绕絮。\n羞抱夹金鞍子住。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37012,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"天仙子 其六","author":"毛奇龄","text":"鱼网劈来螺粉滑。\n臂痕细压金条脱。\n背人写就两行欹，花胜缬。\n银缕结。\n纤指斜封惹脂沫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37013,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"天仙子 其七 蠡城为王郎记事","author":"毛奇龄","text":"城上春云城下雨。\n倩人留婿倾春醑。\n偷将婿袷障春寒，烹雪黍。\n炊玉杵。\n调婿乡音隔窗语。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37014,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"天仙子 其八","author":"毛奇龄","text":"针管红抽丹凤锓。\n螭头金错裁双枕。\n谁家白苎夜歌来，人未寝。\n霜又凛。\n误剪葡萄紫丝锦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37015,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"天仙子 其九","author":"毛奇龄","text":"斑簟纹生双腕缬。\n梦中欲笑开娇靥。\n醒来记得许多情，檀兽爇。\n钗燕热。\n侍婢相看那能说。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37016,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"长相思 其一","author":"毛奇龄","text":"长相思，在春晚。\n朝日瞳瞳熨花暖。\n黄鸟飞，绿波满。\n雀粟衔素珰，蛛丝断金剪。\n欲着别时衣，开箱自展转。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37017,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"长相思 其二","author":"毛奇龄","text":"长相思，在秋节。\n复斗垂垂怨蜻蛚。\n锦纹砧，素丝镊。\n梦苦见参星，关深落榆叶。\n欲识夫婿寒，花阶映微雪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37018,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"遇陈王 其一","author":"毛奇龄","text":"枇杷花里谁家院，近丛坛。\n青漆左厢开绣户，坐双鬟。\n着地画帘飞燕燕，当阶碧草映兰兰。\n车轮未必成三角，叉住门边那得还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37019,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"遇陈王 其二","author":"毛奇龄","text":"阿侯十六南邻女，对门居。\n相视欲申无限意，口中朱。\n朝起青烟萦兽爪，晚来红烛透虾须。\n牙箱实裹冰蚕茧，骨里相思岂是虚。\n·金斗熨开鱼子襭，衬红裳。\n铜瓶注暖狮头炭，理黄妆。\n频呼小玉因声巧，欲写泥金恐恨长。\n那见瑶台成粉幛，果然银汉是红墙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37020,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"酒泉子 其一","author":"毛奇龄","text":"风搅红帘。\n愁损隔帘人影。\n倩秦娥，缠越苘。\n唱吴盐。\n黄铺白锁春相望。\n高阁魂惊难上。\n那更堪，花满桁。\n柳垂檐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37021,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"酒泉子 其二","author":"毛奇龄","text":"可惜春归。\n换得好花成叶。\n启金箱，叠絮褶。\n熨单衣。\n银钩翠笼南邻女。\n日暮采桑西去。\n怕秋胡，回道路。\n返迟迟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37022,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"酒泉子 其三","author":"毛奇龄","text":"宁扫空床。\n怕见满栏月色。\n写金针，萦象尺。\n坐灯凉。\n屏欹漏月灯犹悄。\n坐远影儿较小。\n为孤单，长伴晓。\n似双双。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37023,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"懒卸头","author":"毛奇龄","text":"纠纠珠臂绳，宛转辘轳上。\n那知双穗条，夜夜空垂帐。\n楚雀缘钗桥，胡蜂咂衣桁。\n制得懒卸头，殷勤与谁唱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37024,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"定西番 其一","author":"毛奇龄","text":"校尉新开疏勒，旋右地，返轮台。\n未归来。\n夺得燕支万里，草青春已回。\n谁道于阗还有，野花开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37025,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"定西番 其二","author":"毛奇龄","text":"月落武阳碑下。\n控鹊血，挽牛螉。\n看烽红。\n夜半军中女子，鼓声寒不雄。\n恰是深闺人去，梦魂中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37026,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉公子 其一","author":"毛奇龄","text":"是谁过上苑。\n试马归来晚。\n双镫武威铜。\n樱桃马颊红。\n百枝灯并起。\n解马归花里。\n花底碎金篦。\n珊瑚错燕泥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37027,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉公子 其二","author":"毛奇龄","text":"杏园初试酒。\n挟弹遮杨柳。\n醉里困金吾。\n教姬倒玉壶。\n绶丝如鹝子。\n翠帢团团刺。\n花片缀衣巾。\n衣花看转新。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37028,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"生查子","author":"毛奇龄","text":"绿柰匝茱幮，皂角穿萝屋。\n犀槅钉明螺，眼底分朝旭。\n沅浦长，淇水曲。\n处处难追逐。\n欲见有何由，簳蜡成红烛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37029,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其一","author":"毛奇龄","text":"碧玉蒲芽短短针。\n雀罗波底刺当心。\n拔蒲归去水淫淫。\n楫染绿苔疑掩袖，幔漂红露似湔襟。\n晚风吹转北塘深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37030,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其二","author":"毛奇龄","text":"溪女妆成出若耶。\n芹丝萍蔓逼流斜。\n青苔石上浣新纱。\n爱把单鬟捎竹叶，羞将双脸近荷花。\n缇油前覆夜来车。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37031,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其三","author":"毛奇龄","text":"软红江波鸭子清。\n日迟游女遍江城。\n红桥度烛缓相迎。\n细马隔裙穿镫子，平船素手拨帘旌。\n大堤春日往来情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37032,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其四","author":"毛奇龄","text":"娇女新妆村艳浓。\n四枝鬟插石榴红。\n出门还怕隔溪风。\n石镜暗飞山后鹊，荻屏销画水边荭。\n西施台馆碧波中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37033,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其五","author":"毛奇龄","text":"绿满南园孔雀栖。\n重花叠叶不通飞。\n小姑独出采蔷薇。\n珥底珠儿徒刺脸，带穿贝子恐磨衣。\n行行立立自寻思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37034,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其六","author":"毛奇龄","text":"丛鬓轻笼象格纱。\n曲尘巾皱翳朝霞。\n愁听江阁按红牙。\n簪管枉铰银盖叶，绣床空钉白团花。\n游丝飞絮近天涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37035,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其七","author":"毛奇龄","text":"水绕空江叶绕枝。\n竹郎桥畔豆娘祠。\n佳人邂逅最堪思。\n烛近只将遮幔子，风前长自敛衫儿。\n梨花初落酒阑时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37036,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"巫山一段云 其一","author":"毛奇龄","text":"筱壁含烟澹，椒花滴露稀。\n风吹细雨晓云低。\n十二碧峰迷。\n神女祠前泪，清猿峡里啼。\n瞿塘新水曲尘微。\n行客自依依。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37037,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"巫山一段云 其二","author":"毛奇龄","text":"寒雨萝衣湿，晴云蕉帔开。\n空舲峡下近阳台。\n谁向梦中来。\n丛笛江妃庙，孤舟新妇隈。\n山花石竹不须栽。\n看作小姑钗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37038,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"女冠子 其一","author":"毛奇龄","text":"上元少女。\n谁授玉函金筥。\n倚香坛。\n画帔藤花浅，雕钟橘乳寒。\n南宫除牒子，北斗动幡干。\n犹见春归燕，似青鸾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37039,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"女冠子 其二","author":"毛奇龄","text":"玄都清晓。\n坐间碧堂红草。\n女仙家。\n玉铪量星豆，金◇煮雪花。\n驻颜丹作粉，系肘箓垂纱。\n浼浼沟头水，尽胡麻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37040,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"女冠子 其三","author":"毛奇龄","text":"上清仙梦。\n桄到十三春洞。\n玉颜红。\n月下随王母，花前别宁封。\n黄衶潜解佩，赤舄缓弛弓。\n称名多误听，为呼侬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37041,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"女冠子 其四","author":"毛奇龄","text":"仙房寂寂。\n戏采瑶林珠实。\n是何乡。\n红尾梢花犬，青衣覆石羊。\n鲛丝裁绶短，鹅管呷笙长。\n倘得逢燕使，问昭王。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37042,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"女冠子 其五","author":"毛奇龄","text":"平明受事。\n堪惜玉笄初侍。\n小茅君。\n薄雾笼青鬓，轻烟曳䌨裙。\n凤衔琪树荩，虬使玉堂云。\n恐逐童男去，思纷纷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37043,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]