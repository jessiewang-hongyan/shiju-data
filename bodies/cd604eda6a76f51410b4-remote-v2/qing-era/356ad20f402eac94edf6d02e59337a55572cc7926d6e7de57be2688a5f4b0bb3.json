[{"title":"四围峰峦秀峛崺翠屏长中有读书人结庐山之阳笺注搜毛郑典谟溯虞唐敢道知希贵惟恐学业荒相彼幽谷兰无言祇自芳 其二","author":"多隆阿","text":"鹏抟万里风，乃贻鸴鸠笑。\n士拓万古胸，乃致庸俗诮。\n曲高和者稀，谁解宫商妙。\n守志须益坚，切莫投时好。\n人言何足凭，登高发远啸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12874,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"四围峰峦秀峛崺翠屏长中有读书人结庐山之阳笺注搜毛郑典谟溯虞唐敢道知希贵惟恐学业荒相彼幽谷兰无言祇自芳 其三","author":"多隆阿","text":"南山有松柏，郁郁百千寻。\n云中耸干直，岭上结根深。\n饱沾雨露润，坚成铁石心。\n充作栋梁材，巨室独胜任。\n寄语众桃李，莫急出山林。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12875,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"四围峰峦秀峛崺翠屏长中有读书人结庐山之阳笺注搜毛郑典谟溯虞唐敢道知希贵惟恐学业荒相彼幽谷兰无言祇自芳 其四","author":"多隆阿","text":"藤萝附乔木，青青引蔓长。\n叶繁拟古柏，华密傲甘棠。\n自谓得所托，岂复慎周防。\n一旦木或颓，与之俱同僵。\n所以有志士，独立守故常。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12876,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋怀 其一","author":"多隆阿","text":"茫茫四望且高歌，如此秋光可奈何。\n亦解情长添挂碍，那因才短便蹉跎。\n吟蛩避冷多偎砌，病叶将飞尚恋柯。\n寂寞山林天又晚，残霞如缕上烟萝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12877,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋怀 其二","author":"多隆阿","text":"无须画笔写秋山，鳞次云山四面环。\n入座偏宜岚气绿，映门更爱夕阳殷。\n欲监白水何嫌淡，极重黄花不讳悭。\n昼有尘缘宵有梦，问渠那日得清閒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12878,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋怀 其三","author":"多隆阿","text":"襟怀恬淡欲无尘，挹取晴光别样新。\n好客清于千岁鹤，秋山雅似六朝人。\n环斋古木当屏幛，堆案残书作比邻。\n记得前峰松径下，春间曾此坐花茵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12879,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋怀 其四","author":"多隆阿","text":"一林黄叶系诗魂，缓步苔阶踏绿痕。\n水降深秋犹泛藻，烟凝薄暮渐偎村。\n敢誇玉尺能量物，欲觅金环待报恩。\n萧瑟西风撩乱起，纷纷落叶打柴门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12880,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"征人怨 其一","author":"多隆阿","text":"满面胡沙满目尘，相逢都是转蓬身。\n十年边塞家无信，二月关山草不春。\n逐队惟调鏖战马，盼归应念倚闾人。\n夜深未敢登台望，多恐青枫化鬼燐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12881,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"征人怨 其二","author":"多隆阿","text":"咄咄书空手自叉，误将归信卜灯花。\n霜催岭外翩翻雁，雪逼营前瑟缩鸦。\n岂有奇勋分虎竹，可怜寒夜渡龙沙。\n金闺应有刀环梦，祇道征夫不忆家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12882,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"征人怨 其三","author":"多隆阿","text":"伊州唱罢又凉州，衽甲横矛阅几秋。\n塞上胡儿时浴马，闺中少妇定登楼。\n心惊绝域雁空渡，目极长河水自流。\n苦战沙场筋力尽，论功卫霍独封侯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12883,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"征人怨 其四","author":"多隆阿","text":"噭噭猿猱啼夜阑，男儿有泪莫轻弹。\n烽烟匝地薰心热，铁甲如冰透骨寒。\n每侍将军接短战，曾因夜月望长安。\n几人博得封侯印，赢取霜华两鬓看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12884,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"阳关旅况","author":"多隆阿","text":"廿日行殊倦，今宵漏倍长。\n山幽非故里，月好是他乡。\n烛影侵窗暗，泉声漱耳凉。\n阶阴寒刺骨，不觉已霏霜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12885,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"东符象芝 其一","author":"多隆阿","text":"净扫堂阶不受尘，嘤鸣好鸟送声频。\n三韩云树思吾友，两晋风标想此人。\n但蓄奇书资博雅，莫愁宿债损精神。\n园亭定有花如锦，作赋吟诗正及辰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12886,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"东符象芝 其二","author":"多隆阿","text":"不藏泉货祇藏书，满架牙签啸一庐。\n择友从宽规我傲，评诗近刻笑人疏。\n西窗怀旧春归后，东阁愁新月上初。\n同辈莫将乡愿比，四时气备有谁如。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12887,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"东符象芝 其三","author":"多隆阿","text":"沧桑迁变此情长，一纸传书又沈阳。\n祇赖宾鸿通信息，生憎客燕语温凉。\n小桃花发明书幌，老树阴浓护讲堂。\n莫谓交情宜水淡，醇醪饮后想周郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12888,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"古意","author":"多隆阿","text":"碎瓦颓垣碧水西，可怜红粉委黄泥。\n多情转属閒莺燕，犹吊花魂尽意啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12889,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"遣闷 其一","author":"多隆阿","text":"行云流水两溶溶，戚起秋怀郁几重。\n管子差堪知老马，叶公原未好真龙。\n兰经旧雨香全减，菊傲严霜色不浓。\n自笑向来痴特甚，涉江尚欲采芙蓉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12890,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"遣闷 其二","author":"多隆阿","text":"一著残棋自悔疏，从前毋乃近糊涂。\n言词吊诡盲男子，喜怒怀私浅丈夫。\n趋热畏寒嗤燕婢，貌慈心狠恶狸奴。\n屈平愤著离骚赋，问卜归来又问巫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12891,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"遣闷 其三","author":"多隆阿","text":"晓角清笳昨夜听，霜催草木尽凋零。\n消愁有物惟醇酒，知己难逢似景星。\n槛外山眉今减翠，堤边柳眼旧垂青。\n宵深剩有团圞月，独为游鲲照北溟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12892,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"遣闷 其四","author":"多隆阿","text":"人情閒向暗中探，搜索文书再细参。\n歇后谁曾讥郑五，知儿我转取朱三。\n道深宜用虚怀领，器重还凭大力担。\n悟得苦言为圣药，才知谏果有回甘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12893,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"遣闷 其五","author":"多隆阿","text":"瑕瑜相掩尚堪磨，梦境沈沈可奈何。\n睫在目前知者少，人从创后悟来多。\n寸心有觉都成悔，尺水无风漫作波。\n忘象忘言兼忘我，低音未已又高歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12894,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"冬闺词 其一","author":"多隆阿","text":"琼林玉树净无瑕，轻送寒烟冷到家。\n欲卜年丰今有验，枝头密结雾凇花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12895,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"冬闺词 其二","author":"多隆阿","text":"人自偷閒我自忙，停针不语暗思量。\n披图数去将三九，绣线应添几许长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12896,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"冬闺词 其三","author":"多隆阿","text":"晓日曈昽暖不寒，家家先备晒衣竿。\n谁知卓午狂风起，转想前宵有月阑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12897,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雪霁野望 其一","author":"多隆阿","text":"惟爱寒天净，晴游东野东。\n鞋温宜履雪，酒热好当风。\n草积村园白，柴燃店灶红。\n飞鸦知向暖，噪日又盘空。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12898,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雪霁野望 其二","author":"多隆阿","text":"血涌心田热，冲寒得得行。\n风前孤柏劲，雪后远山明。\n鹤淡飞无影，冰坚裂有声。\n浮云何处是，大地一同清。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12899,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雪霁野望 其三","author":"多隆阿","text":"力学三年久，平心愧未能。\n山川如荡涤，耳目尽清澄。\n草没雉眠雪，桥閒人涉冰。\n仰观兼俯察，得意问山僧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12900,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"庚寅元日 其一","author":"多隆阿","text":"屠苏小酌瓮头春，净几明窗不染尘。\n诗欲求工常近拙，书缘温故始知新。\n每寻野老求遗事，恒辑残编寿古人。\n架上牙签分甲乙，启心何异德为邻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12901,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"庚寅元日 其二","author":"多隆阿","text":"香薰小屋暖于春，静掩双扉远俗尘。\n家政宏规思率旧，文章花样喜从新。\n大苏谑世惟谈鬼，小谢怜才更奖人。\n一卷经书读未尽，车声门外又粼粼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12902,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"古城 其一","author":"多隆阿","text":"古迹凭谁问，残碑仅记年。\n荒城今若此，古堞久颓然。\n戟拾沙中铁，人耕郭外田。\n倦倚危石坐，老树郁春烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12903,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"古城 其二","author":"多隆阿","text":"莫笑岘山泪，羊公传至今。\n此城应有主，何事竟难寻。\n迹向苔中没，春从雨后深。\n潮来冲岛响，似听鼓鼙音。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12904,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"拟十索曲 其一","author":"多隆阿","text":"金粟散天香，琼枝缀玉蕊。\n采向小山头，携入深闺里。\n服此驻红颜，从郎索桂子。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12905,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"拟十索曲 其二","author":"多隆阿","text":"花开小院香，花落儿童扫。\n伤春春不知，蜂蝶同懊恼。\n何物许忘忧，从郎索萱草。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12906,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"拟十索曲 其三","author":"多隆阿","text":"清爱荷叶香，凉喜藕丝片。\n因泛莲渚舟，欲障蓉花面。\n明月一手擎，从郎索团扇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12907,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"关山月","author":"多隆阿","text":"月缺初拟雕弓弯，月满又比金刀环。\n时缺时满惟此月，戍卒夜夜望关山。\n关山以外银光烂，关山以内人肠断。\n金波腾地倍加寒，屈指已觉流光换。\n流光已换仍不归，暗处隐耀青燐飞。\n中原那计边塞冷，秋深犹未寄征衣。\n望衣不至空咄咄，扑面朔风砭肌骨。\n忽听关前画角声，彷佛金闺砧敲月。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12908,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"独不见","author":"多隆阿","text":"凉雨虽寒不成霰，乱丝虽织不成绢。\n征妇岁岁望征夫，已去光阴如流电。\n春露泽成桃李颜，秋风瘦损芙蓉面。\n道远总觉寄书难，敲砧又怯腕力倦。\n婵娥弄影射长空，照人欢娱在隔院。\n酌酒定自劝金卮，舞袖旋听响玉钏。\n妾独寂寞坐空闺，叹息不觉泪如线。\n趾离作引如相通，思君冀向梦中见。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12909,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"远别离","author":"多隆阿","text":"春风骀荡杨飞花，怒马驰骋人离家。\n一日行程百馀里，数日应到天之涯。\n天涯远望云瀰漫，天涯久住星霜换。\n争怪连宵梦转多，那堪积岁书长断。\n一纸忽来千里书，书来已是隔年馀。\n此日差喜君无恙，转怅还乡信仍虚。\n草木托根各有处，游子行踪偏无据。\n邻家前宵有客归，言君又渡桑乾去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12910,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日咏怀 其一","author":"多隆阿","text":"鸣春好鸟语双双，又听晨钟向晓撞。\n渡岭闲云穿石罅，匝庭密树荫纱窗。\n交人意淡恒违俗，爱古心高不受降。\n积闷年来遣未得，浇书怡喜酒盈缸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12911,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日咏怀 其二","author":"多隆阿","text":"事不从心大半乖，随机何用巧安排。\n花能蠲忿须寻种，梦傥游仙也慰怀。\n暖谷生春消积雪，和风无力破沈霾。\n算来差有家居好，独掩柴扉坐小斋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12912,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日咏怀 其三","author":"多隆阿","text":"受戒何须读楞严，情多或许脱尘凡。\n惟求长厚如张季，莫蹈清狂似阮咸。\n学积十年安我拙，心澄一片任人谗。\n何当驾得扁舟去，好趁长风饱挂帆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12913,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"闺中词 其一","author":"多隆阿","text":"雾歛芳塘雨乍晴，烟波初长水云平。\n鸳鸯可有修来福，并蒂莲中过一生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12914,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"闺中词 其二","author":"多隆阿","text":"薰笼薰热暖香柔，绣帐重重尽下钩。\n底畏晓寒眠不起，鹦哥屡次唤梳头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12915,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春闺曲 其一","author":"多隆阿","text":"一架荼蘼引蔓长，轻盈摇曳晚风香。\n折来暂供花瓶养，好待明朝助晓妆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12916,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春闺曲 其二","author":"多隆阿","text":"花风有信盼花辰，羯鼓催花不厌频。\n待到花开转惆怅，来朝花谢又愁人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12917,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菜花 其一","author":"多隆阿","text":"野蓛山肴尚许探，园蔬滋味更宜谙。\n栽培芦菔倚村畔，点缀篱笆到亩南。\n苞坼今朝初吐艳，羹调异日更分甘。\n姚黄富贵称名久，无补蒸黎也自惭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12918,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菜花 其二","author":"多隆阿","text":"閒寻老圃到平畴，细碎黄花一派幽。\n开向畦中原朴素，老归林下也风流。\n香清味淡偏多子，春暮园荒已有秋。\n笑彼凡英誇妩媚，一生惟上美人头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12919,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏青春词 其一","author":"多隆阿","text":"池塘新涨水平堤，两两鸳鸯立岸西。\n怪底闺中成对绣，原来此物是双栖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12920,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏青春词 其二","author":"多隆阿","text":"小雨初晴草色新，深黄丽紫艳芳辰。\n射干瞿麦都簪遍，如此山花也爱人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12921,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏青春词 其三","author":"多隆阿","text":"一派清音杂玉笙，夕阳楼阁水云亭。\n侍儿不解求凰曲，赚得同人侧耳听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12922,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏青春词 其四","author":"多隆阿","text":"野水横桥聚浅沙，柳阴历乱夕阳斜。\n黄鹂却似多情甚，沿路飞鸣送到家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12923,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"消夏 其一","author":"多隆阿","text":"午梦初醒静蝶魂，好书读毕又重温。\n不留俗客长悬榻，欲挹清风未掩门。\n燕处堂帘须惜福，花沾雨露要知恩。\n近来才得安心法，小事糊涂莫细论。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12924,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"消夏 其二","author":"多隆阿","text":"惭愧年年自惹尘，林园僻处好抽身。\n蒙茸俗草难惊眼，雅淡名花不媚人。\n寡欲或为留寿客，能閒应属葛天民。\n多情已受情缘累，且恐种多又种因。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12925,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"人参 其一","author":"多隆阿","text":"草擅嘉名草亦灵，辽东瑞草象人形。\n独含元气钟幽谷，欲考良材注本经。\n野老知珍详地道，摇光散彩应天星。\n痌瘝切己能拯救，不向松根采茯苓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12926,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"人参 其二","author":"多隆阿","text":"园丁斸得向阴栽，花不争芳也自开。\n每到世间誇异种，须从谷内养灵胎。\n大丹多是误人物，小草居然济世才。\n可笑秦皇与汉武，偏将仙药访蓬莱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12927,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"人参 其三","author":"多隆阿","text":"也随群卉共敷荣，朵子芽参沿俗名。\n在野有时依紫椴，出山将欲济苍生。\n调和疢疾功原大，燮理阴阳性又平。\n不是寻常凡草类，求沽价亦重连城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12928,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"人参 其四","author":"多隆阿","text":"益及人人性最仁，不同人苋仅名人。\n柔茎定续蒸黎命，大补能回天地春。\n此草味甘原异俗，其根年久更通神。\n三桠五叶须详考，劳汝岐黄作外臣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12929,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"旅馆消夏 其一","author":"多隆阿","text":"深藏一室淡无言，厌听门前俗客喧。\n雅爱閒花求物本，静参流水活心源。\n事从错后方知悔，扇到炎中不解烦。\n一片寒瓜心顿定，何须强制验风幡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12930,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"旅馆消夏 其二","author":"多隆阿","text":"松棚高荫读书堂，抱膝吟诗逸兴长。\n冷眼观人原近刻，温风入室尚含凉。\n蕉才著雨声先到，菊未开花叶已香。\n隔户看云云自在，不为霖雨不空忙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12931,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒情 其一","author":"多隆阿","text":"閒情触起上眉端，往事从头反复看。\n洁己惟宜求雪鉴，容人尚觉问心难。\n酣居酒国思回暖，悟到梅花渐忘寒。\n记得前宵檐外立，照人依旧月团圞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12932,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒情 其二","author":"多隆阿","text":"窗前九九点梅图，四壁清寒祇自娱。\n俗眼谁能识玉璞，素心久已托冰壶。\n云中白鹤惟求洁，岭上青松岂愿孤。\n小草灵根名远志，问渠还想济人无。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12933,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"松山怀古","author":"多隆阿","text":"小憩松山下，来寻山上松。\n青松杳不见，惟馀三两峰。\n忽忆旧战垒，因之询遗踪。\n父老默无言，微哂但务农。\n升高望四极，云起郁重重。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12934,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杏山怀古","author":"多隆阿","text":"已度松山岭，因陟杏山岑。\n山上土色红，犹疑战血深。\n有人荷鸦觜，言将折戟寻。\n得此铸农器，胜于等閒金。\n同坐谈往事，山鸟助清音。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12935,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"宁远道中","author":"多隆阿","text":"车马共悠悠，长驱不暂留。\n疏林黄叶雨，远浦碧云秋。\n山水资佳兴，关河纪胜游。\n乡心正无限，归雁下汀洲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12936,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"独吟","author":"多隆阿","text":"劳劳尘事恐无成，独自沈吟绕屋行。\n月在身前应鉴我，花于别后尚牵情。\n耳听地籁心长静，水过天风浪不平。\n闭户学书兼学剑，此生未敢貌荣名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12937,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乙未元日 其一","author":"多隆阿","text":"心惊岁月箭离弦，驹隙匆匆又著鞭。\n检客遗书怀故友，听儿笑语想童年。\n多能招忌原非福，俗事看空转近禅。\n懒作应酬聊静坐，重帘缓下放茶烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12938,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乙未元日 其二","author":"多隆阿","text":"看破人情有别图，听言且自托糊涂。\n删馀旧稿惬心寡，数遍新交知己无。\n世俗浇漓竞箕帚，酒肠浅狭负屠苏。\n天晴一色云全歛，旭日轮红耀火珠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12939,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]