[{"title":"登南禅寺孔雀楼","author":"李荣树","text":"岚气回环映水光，麦花吐秀菜花黄。\n痴儿今日忘尘事，孔雀楼头看夕阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31565,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日游南山寺即景","author":"基生兰","text":"平生雅爱入山游，闻到南禅兴未休。\n十里杏花红雨路，几层杨柳绿荫楼。\n望中湟水三分涨，城里炊烟万户稠。\n读罢残碑频感慨，雪泥鸿爪几人留。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31566,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虎台怀古","author":"李焕章","text":"西平郡西矗层台，台势嵯峨出尘埃。\n筑台伟人今何在，只今只有台崔嵬。\n忆者南凉图霸时，仗钺登台曾誓师。\n飞扬大纛接云汉，龟鼓声中画角吹。\n鲜卑畏威来献马，青海部落拜台下。\n兵卫森列顾盼雄，观者如山语呕哑。\n英雄事业石火电光，阿房铜崔同慨荒凉。\n走马西来访遗迹，感时抚事增惋惜。\n君不见虎台突兀风雨中，满目萧条蓬蒿碧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31567,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虎台怀古","author":"基生兰","text":"在昔南凉王，穷兵复黩武。\n纵横河湟间，动辄提桴鼓。\n好战国必亡，率为西秦虏。\n世隔几沧桑，久已骨朽腐。\n独此一荒台，岿然历千古。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31568,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"金蛾晓日","author":"张思宪","text":"金蛾池水涌金蛾，五色斑斓迷目多。\n破晓云开登绝顶，惊人佳句问如何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31569,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"游元朔山汇诗品","author":"钱维伦","text":"大道日往，妙机其微。\n饮之太和，独鹤与飞。\n巫峡千寻，走云连风。\n天地与立，神化攸同。\n是有真迹，如不可知。\n要路愈远，幽行为迟。\n碧山人来，横绝太空。\n超以象外，得其寰中。\n娟娟群松，下有泉流。\n载行载止，空碧攸攸。\n脱巾独步，时闻乌声。\n所思不远，大河前横。\n月出东斗，好风相从。\n太华夜碧，人闻清钟。\n金撙酒满，共客弹琴。\n海之波澜，山之嶙峋。\n大风捲水，材木为摧。\n萧萧落叶，漏雨苍苔。\n少有道契，终与俗违。\n如将白云，清风与归。\n生者百岁，相去几何。\n何如尊酒，日往烟萝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31570,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"次新城望元朔山","author":"杨应琚","text":"端岩双水曲，斜影数峰睛。\n过客停骢马，秋风满石城。\n沙头起雁语，天际落钟声。\n白道如丝细，层层草木清。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31571,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"元朔山谒太元宫","author":"谢陛","text":"振衣高叩碧琳宫，石磴盘虚曲曲通。\n仙仗绕庭临帝座，雄图控虏借神功。\n天垂北斗悬梯上，云压西山挂殿中。\n万里壮心思出塞，长驱青海欲从戎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31572,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"元朔山谒太元宫","author":"秦株","text":"绛殿穹窿冠岭开，清秋高倚集灵台。\n覆崖树色山中满，入硖河声塞外来。\n飞骑随人穿石往，抠衣谒帝拂云回。\n挥毫遍埽苍苔壁，深愧登高作赋才。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31573,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"冬日过新城望元朔山感事 其一","author":"廖徯苏","text":"朔风捲地雪生寒，一道庄康未是难。\n古树藏鸦偏笑客，征途驻马且加餐。\n云开硖口朝金阙，日挂天腰见玉峦。\n隔岸迎人如作主，印心明在镜中看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31574,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"冬日过新城望元朔山感事 其二","author":"廖徯苏","text":"奇峰万仞立嵯峨，峭壁连天信手摩。\n遣兴莫嫌边外远，看山原让客中多。\n但须巨眼悬空际，何事亲□附曲阿。\n我自胸中有元朔，值来相證更无讹。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31575,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"道中见元朔山","author":"刘永椿","text":"策马关山道，峰岚入眼多。\n西来连白云，北折抱黄河。\n云气速孤鸟，烟痕淡远螺。\n看山情不厌，恐负客中过。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31576,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"庐山杂咏偕蒋子潇","author":"魏源","text":"与君同是再来僧，共拨寒灰听水声。\n谈罢不知庐阜月，只疑青海寺中行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31577,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤台留云","author":"张思宪","text":"凤台何日凤来游，凤自高飞云自留。\n羌笛一声吹不落，纤纤新月挂山头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31578,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"九月七日行抵丹噶尔前诣札木巴拉多尔济贝勒弩克图大藏寺祭毕敬成","author":"斌良","text":"圣王怀远略，使者涉湟津。\n鹿塞毡裘萃，龙庭俎豆陈。\n风高青海静，云锁雪山春。\n归觐宸衷悦，恩敷万里臣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31579,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋日自丹噶尔赴西宁","author":"来维礼","text":"阴雨无情阻客程，驱车破晓出山城。\n莫愁前路无相识，无数青山带笑迎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31580,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"石峡清风","author":"张思宪","text":"石峡新开武定关，东西流水南北山。\n行人莫道征尘污，两袖清风自往还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31581,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日月山铭","author":"陈文述","text":"青海万里，连山突兀。\n一峰切云，出入日月。\n麓抱琳宫，阹周帐部。\n根蒂搏桑，枝柯骞树。\n顾兔东跃，踆鸟西沦。\n佛说阿耨，仙言昆崙。\n循环继照，叠璧飏采。\n何以俪之，曰星宿海。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31582,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渡大通河","author":"斌良","text":"天连雪岭峰峰白，路出冰沟步步平。\n持节东归五千里，停鞭爱听唤船声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31583,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"大通河","author":"德龄","text":"山断得平路，摇鞭渡大通。\n千峰晴入画，一水澹涵空。\n狐兔营深窟，鹰鹯识顺风。\n惭无绥远略，观猎赋徒工。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31584,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西域八咏额尔齐斯","author":"褚廷璋","text":"西州直北势凭陵，瀚海迢遥过白登。\n钤泽风高奔怒马，金山雪暗下饥鹰。\n曾传旧壤开都伯，仅见降王保策凌。\n四部虫沙成底事，好将忠谨化骁腾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31585,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"游东山寺","author":"秦彬","text":"寻胜春郊踏绿畦，几重山色望中迷。\n亸鞭谷口频惊马，看镜岩前欲舞鸡。\n树密漫闻钟远近，云横谁辨路高低。\n逢僧引到青峰处，日出东方月落西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31586,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"镇远楼四首 其一","author":"袁州佐","text":"高阁巃嵷俯大荒，雄开四极控诸羌。\n千峰雪映金城晓，万树春融紫塞霜。\n海外共球方辐辏，云边旌旆正悠扬。\n相从胜日陈尊俎，惟有绸缪预彻桑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31587,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"镇远楼四首 其二","author":"袁州佐","text":"峥嵘画栋半云霄，四绕河山纵日遥。\n境拓龙荒怀定远，符分虎竹识嫖姚。\n单于城下耕春野，台吉庐边狎暮樵。\n酾酒临风清兴足，愿图王会答熙朝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31588,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"镇远楼四首 其三","author":"袁州佐","text":"万叠祁连列槛平，遥飞寒爽照人清。\n西邀王母云车近，东望长安雨树明。\n天马自来春蓿长，泽鸿方集午烟横。\n共疑身在尘寰表，应有高衢接玉京。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31589,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"镇远楼四首 其四","author":"袁州佐","text":"连峰不断海云开，坐拥岩城亦壮哉。\n地接昆崙标一柱，野分营室接三台。\n洗兵拟挽天河水，供饷惭非酂国才。\n幸际玉闽通道远，春风先许到楼台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31590,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"镇远楼","author":"傅霖","text":"揆日千年才御史，吟风八咏赵平章。\n层层梵阁联官阁，坦坦仙乡达帝乡。\n伊里而今通北极，蓼泉自昔跨西凉。\n升平那数筹边策，舞羽虞阶击坏唐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31591,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"宏仁寺","author":"卜舟","text":"寥落宏仁寺，尘侵佛自闲。\n雄碑摩圣迹，古木壮禅关。\n玉轴函三藏，金躯卧九间。\n那堪牲牧地，驼马践苔斑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31592,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"驻甘州一日","author":"裴景福","text":"臣罪真无状，君王许薄游。\n断桥支弱水，美酒醉甘州。\n卧佛悭青眼，劳人易白头。\n壮怀轻万里，到处足淹留。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31593,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"游大佛寺见如来佛像有感","author":"马文炜","text":"为天入地漫相猜，万古圣凡总一骸。\n孽海茫茫谁得渡，莲台闲煞佛如来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31594,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"木塔寺","author":"任侗","text":"浮图传说建开皇，木塔巍于柱石坊。\n一粒可真凝佛骨，九层还似巩仙房。\n尉迟昔已迁麟阁，迦叶今犹认鸽王。\n试问回澜劫几许，巍然独峙鲁灵光。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31595,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"万寿寺木塔","author":"卜舟","text":"巍然笔势蘸寒空，九级玲珑造化工。\n结顶朝元映日月，盘根错节傲霜风。\n声飘烟景微茫外，影射波光淡漠中。\n灵瑞毓钟张掖秀，能仁枵范永流东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31596,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"木塔疏钟","author":"马羲瑞","text":"天花何处鸟衔飞，一塔依然立翠微。\n画栋崚嶒齐雪岭，残钟断续入柴扉。\n阳回乍喜初调律，漏尽谁伤未拂衣。\n莫厌疏慵趺坐久，半生劳碌已知非。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31597,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"游马蹄寺","author":"高元振","text":"马蹄明代寺，遗址话当年。\n古刹分南北，沙门辨汉番。\n莲台生妙谛，粥钵衍真传。\n白塔层凌汉，红崖半插天。\n烟尘迷野舍，香火结林禅。\n柳密莺流转，松高鹿傍眠。\n泥金熔象法，石碧挂龙泉。\n绝顶登临望，云山曲曲攀。\n前明遗旧寺，石印马蹄坚。\n古洞盘旋凿，奇崖磊落悬。\n飞沙迷曲径，滴水觅神泉。\n塔险连云汉，峰危接雨烟。\n番林千百树，佛界卅三天。\n姊妹名山在，袈裟妙道传。\n门深无俗客，禅静不知年。\n清代崇有礼，犹留胖栗缘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31598,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题仙姑楼","author":"陈宏德","text":"香阁连云际，登临帝座通。\n彩霞飞槛外，新月渗帘中。\n瑞绕千层雪，烟斜八面风。\n寄言学道者，此处是仙宫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31599,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题仙姑庙四首 其一","author":"杨楷","text":"黑水波翻憾未填，梁成恰值道成年。\n娲皇也是人间女，鍊石还闻手补天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31600,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题仙姑庙四首 其二","author":"杨楷","text":"此身岂等掷鸿毛，入水才回万顷涛。\n漫道昭君青冢异，祗今遗骨镇空壕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31601,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题仙姑庙四首 其三","author":"杨楷","text":"河边竟渡霍嫖姚，幻起云中挂鹊桥。\n纵祷金人成底事，昆邪无计诩天骄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31602,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题仙姑庙四首 其四","author":"杨楷","text":"艳说西方彼美多，合黎山畔伏妖魔。\n汉封夏册非崇诞，海有灵妃江有娥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31603,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"仙姑板桥","author":"乔彦","text":"月色波光照眼穿，桥名依旧说升仙。\n何年乌鹊重填岸，引得人登大愿船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31604,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赤金峡道中作 其一","author":"毕沅","text":"王事程严敢惮劳，旅怀秋气两萧骚。\n官邮出塞逢迎少，戍堠缘冈结构牢。\n风挟塞沙尤觉烈，日来空碛不能高。\n声灵震叠天山外，绝徼弓檠尽自韬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31605,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赤金峡道中作 其二","author":"毕沅","text":"群孤天迥雁声哀，木脱亭皋驿路开。\n秋草绿销盘马地，夕阳红上晾鹰台。\n漫言壮士遐荒戍，剩有儒生绝塞来。\n何代战场堪惨目，冷风吹散髑髅灰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31606,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赤金峡道中作 其三","author":"毕沅","text":"添尽征衣总怯凉，草根亭午尚凝霜。\n毡庐星散千堆白，羽骑尘飞一道黄。\n偏是空林无鸟雀，每经平阪见牛羊。\n明晨已出阳关路，却梦承欢在故乡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31607,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赤金峡道中作 其四","author":"毕沅","text":"行路艰辛叹未曾，岭崇碛回步淩兢。\n烘衣雪驿宵吹火，饮马沙泉晓凿冰。\n残角鸣驼遥应和，断蓬饥隼互飞腾。\n不知驰抵西陲路，尚隔云山几万层。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31608,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赤金峡","author":"成书","text":"赤金无大山，峡口多怪石。\n前朝蒙古卫，疆域递沿革。\n叛服亦不常，圣朝示威格。\n虎臣秉庙谋，驱逐得长策。\n番帐尽外徙，流民乃占籍。\n迩年稍生聚，亦未富田宅。\n行人谋午餐，六月见新麦。\n饱食戒车徒，前行沙碛白。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31609,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"由赤金湖至赤金峡抵玉门县宿","author":"成书","text":"披沙丽水讵堪寻，湖峡犹然号赤金。\n尽日轮蹄走戈壁，几家烟火傍嵚崟。\n荒原夏月无青草，独树残阳有怪禽。\n忽听谯楼吹觱栗，旅怀枨触倍难禁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31610,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和水樵大尹留别原韵志送","author":"李维墉","text":"羡君喜色上眉峰，摇曳行旌思万重。\n白水江头留爱远，赤金峡口荷恩浓。\n固穷学励编蒲土，除暴心非卖菜佣。\n从政合宜因地制，王关逼近酒泉封。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31611,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送王耔山赴疏勒二首 其一","author":"施补华","text":"虚堂悬莫邪，六月血风冷。\n森然墙壁间，魑魅不留影。\n路人何栗栗，宁与魑魅等。\n平生有肝胆，爱尔寒芒炯。\n吾且藏吾刀，百怪已知警。\n春宵忽龙啸，离别在俄顷。\n临行期烂醉，无奈孤怀醒。\n庄生夸剑术，斯义推未尽。\n太刚诚易折，惜哉此锋颖。\n将为绕指柔，宛转意难忍。\n置君刚柔间，光敛神愈静。\n一试百踌躇，砉然中其肯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31612,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送王耔山赴疏勒二首 其二","author":"施补华","text":"万里既无归，何妨更万里。\n西行绝太荒，犹是乾坤裹。\n古人驰异域，战伐功可纪。\n蝎来战伐余，乱丝待君理。\n弱肉供强食，仍岁饱封豕。\n昨日是前生，今日生之始。\n伤禽怯鸣弓，闻筝亦惊起。\n幽囚别太阳，对烛聊小喜。\n养民如养狙，宁复矜鞭棰。\n人狙两忘猜，宛转随所使。\n火云生马头，冰月出马尾。\n手挽昆仑波，先为洗泥滓。\n葱岭在天半，东望万山底。\n一发酒泉城，故人应在此。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31613,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和阗","author":"褚延璋","text":"毗沙府号古于阗，葱岭千盘积翠连。\n大乘西来留法显，重源东下问张骞。\n渔人秋采河边玉，战马春耕陇上田。\n今日六城歌舞地，唐家风雨汉家烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31614,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"伊吾绝句","author":"成书","text":"玉关遗址已模糊，谁识瓜沙旧版图。\n欲旁天山寻地志，不闻疏勒近伊吾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31615,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"宿乌鲁木齐","author":"阿克敦","text":"吐蕃界北有空城，西距阳关第六程。\n雪满荒芜连野阔，春回林木带流清。\n戍兵自古需屯策，柔远于今识虏情。\n欲向轮台寻旧址，万山高耸一峰明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31616,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"戈壁","author":"萧雄","text":"大漠连天一片沙，苍茫何处觅人家。\n地无寸草泉源竭，隔断邻封路太赊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31617,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"天山夜行","author":"宋伯鲁","text":"亭亭一片长安月，万里来照天山雪。\n天山雪后风如刀，行人望月肠断色。\n瀚海凝冰九月秋，毡车如纸失骦裘。\n却将十亩闲闲乐，换取穷边夜夜愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31618,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西陬牧唱词二十六首 其一","author":"王芑孙","text":"百十名城俨画区，就中疏勒有遗都。\n东趋乌什如瓴建，松塔崎岖亦坦涂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31619,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西陬牧唱词二十六首 其二","author":"王芑孙","text":"何须耕种论肥跷，千足牛羊尽富饶。\n却怪贫人好生计，乳茶入腹不愁枵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31620,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西陬牧唱词二十六首 其三","author":"王芑孙","text":"诵经结发妇随夫，细马驮来不用扶。\n珍重证盟羊胛骨，定情昨夜在毡庐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31621,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西陬牧唱词二十六首 其四","author":"王芑孙","text":"五行葬法岂天真，无奈番僧法力神。\n薄俗于今涵孝治，草青时有祭先人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31622,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西陬牧唱词二十六首 其五","author":"王芑孙","text":"纸帽行游事可羞，教奴短布累奴愁。\n儿郎爱马偷骑去，妾貌如花当九牛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31623,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西陬牧唱词二十六首 其六","author":"王芑孙","text":"有天无佛是回疆，俗祀祆神旧史详。\n七日阿浑同拜月，三年墨克去烧香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31624,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西陬牧唱词二十六首 其七","author":"王芑孙","text":"建元莫问几星躔，自度人间大小年。\n正是把斋时候到，葫芦灯向树头燃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31625,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西陬牧唱词二十六首 其八","author":"王芑孙","text":"度索寻橦绝伎兼，部分双引到重檐。\n锦襕红袜蹲蹲舞，巧赴钢丝昔昔盐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31626,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西陬牧唱词二十六首 其九","author":"王芑孙","text":"戗金吉语绕夔螭，典故稽从眉哩时。\n跟肘辨来迷噶爱，始知彼国有冰斯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31627,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西陬牧唱词二十六首 其十","author":"王芑孙","text":"谳刑灌水似鞭蒲，悬架惩奸法外科。\n怪底儿童齐拍手，官人入市倒骑驴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31628,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西陬牧唱词二十六首 其十一","author":"王芑孙","text":"也道居丧不着徘，墨衰聊用布为衣。\n不愁今岁寒无帽，新向坟头送葬归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31629,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]