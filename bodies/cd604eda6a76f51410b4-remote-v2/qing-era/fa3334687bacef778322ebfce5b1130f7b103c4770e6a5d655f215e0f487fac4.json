[{"title":"赠吴渐逵","author":"张玉纶","text":"秋风行李一肩轻，冷雨无端又阻行。\n最是可怜楼上妇，空教屈指计归程。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12809,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秃老婆店","author":"张玉纶","text":"七载频经此地过，村名取义果云何。\n云鬟埋没知多少，底事偏传秃老婆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12810,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"读史","author":"张玉纶","text":"大度由来说汉王，疑团千载费猜详。\n轹羹原是寻常事，何至终身恨不忘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12811,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"戍妇四时词 其一","author":"张玉纶","text":"已自怀人不耐愁，黄莺何事更枝头。\n情知春色归杨柳，怕惹离愁懒上楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12812,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"戍妇四时词 其二","author":"张玉纶","text":"记曾五日指为期，预酿菖蒲绿满卮。\n待得封侯人到日，一杯亲与话相思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12813,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"戍妇四时词 其三","author":"张玉纶","text":"霜信连朝故故催，清砧试处几徘徊。\n寒衣寄到边关去，可有平安信寄回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12814,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"戍妇四时词 其四","author":"张玉纶","text":"盼望空教岁已阑，捷书犹未递长安。\n也知报国难私顾，只是遥怜玉帐寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12815,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"广福门赴旅顺之行期本拟在四月二十四日后迁延至二十八日予以饯行诗书之于扇因以赠之复题一截","author":"张玉纶","text":"和泪吟成字字新，临歧无计托情亲。\n祝君短箑徐摇际，好为清风念故人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12816,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"上巳感怀","author":"张玉纶","text":"愁见棠花满路红，聊因修褉出城东。\n都将旧事付流水，尽敞虚怀当惠风。\n洛邑销沉王气歇，金人湮没霸才空。\n此生不过蜉蝣寄，诗拟羲之感慨同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12817,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋草 其一","author":"张玉纶","text":"剪纸谁招楚客魂，缘堤无复绿侵门。\n铺匀平野愁千叠，界断江天画一痕。\n秋老羝羊思故国，夜凉蟋蟀泣空村。\n崦山兰泽凭幽寂，莫把丛台共比论。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12818,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋草 其二","author":"张玉纶","text":"玉门昨夜有微霜，蛙响全销十亩塘。\n金埒半残休问马，青袍已旧懒开箱。\n烟沉南浦怀江令，日冷西湖吊岳王。\n见说黉山颜色好，莫教憔悴郑公坊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12819,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋草 其三","author":"张玉纶","text":"白雁声中冷葛衣，开筵上日景全非。\n窗前影瘦生机薄，池上波凉好梦稀。\n北地琵琶悲黯黯，南园蝴蝶忆飞飞。\n输他莎草寒犹绿，肠断春明夙愿违。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12820,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋草 其四","author":"张玉纶","text":"围红斗绿记相怜，一霎平芜怅夕烟。\n绘出骚人愁渺渺，吟残远道思绵绵。\n伊谁怀旧寻幽径，看我争新在转年。\n翠辇不来天已暮，空教零落玉阶边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12821,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赠张淳修","author":"张玉纶","text":"慷慨悲歌意气疏，十年落拓走江湖。\n自来蜀地多才子，敢向高阳诩酒徒。\n诗比曲江唐世有，字如长史近时无。\n幸叨谱末成兄事，未厌金台客况孤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12822,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"道途过白塔寺访王子丹即景得牛字","author":"张玉纶","text":"接交何幸尽名流，又上元龙百尺楼。\n事业已成蕉覆鹿，遭逢真类火驱牛。\n乌啼月黑孤城晚，雁冷霜寒古寺秋。\n相对一灯消永夜，摇摇双影亦朋俦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12823,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"漫兴","author":"张玉纶","text":"南亩归来饭罢时，一灯儿女坐谈诗。\n天机不滞思皆活，世味全忘句自奇。\n瓦鼎茶声琴断续，瓷瓶花影画迷离。\n湛然清福惭独享，任是神仙未许知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12824,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"柬多宠斋昆季","author":"张玉纶","text":"江云渭树怅离居，不见郊祁一载馀。\n思到通神常入梦，辞难达意懒裁书。\n尘垂蛛网留宾榻，霜满鸡窗卧雪庐。\n遥识谢庭诗句好，赏春可否忆慵疏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12825,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"示德谦侄","author":"张玉纶","text":"十年讲道辨精微，玉麈逢人任意挥。\n落笔耻居唐宋下，立言常笑老庄非。\n芸窗业已拚吾守，葱肆何能教汝归。\n分寸光阴须顾惜，莫令画虎竟贻讥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12826,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"岁暮柬符象芝","author":"张玉纶","text":"别后光阴水逝波，讯君佳况近如何。\n悬知灶上炊烟少，定拟门前债主多。\n诗价自然连日长，轩车可复有人过。\n魏公安否无劳问，依旧馀生墨共磨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12827,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赠白瑞徵见访","author":"张玉纶","text":"脱却儒冠意气舒，多情相访到蓬闾。\n丈夫得志生为将，我辈安能死守书。\n虎略定知高一世，鸡窗可否忆当初。\n宦场迩日轻文士，凭仗吾贤为扫除。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12828,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"廿一史沈阳夏凤栖先生旧物也予以三十金得之尽典衣裘方足其数有相笑者作此解嘲","author":"张玉纶","text":"夏葛冬裘典质频，案头青史快横陈。\n此生肯使有长物，到眼从兹多古人。\n学祇通经终是陋，衣犹遮体未为贫。\n含章定比章身好，讥笑何劳竞破唇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12829,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"呈彭宝臣学使 其一","author":"张玉纶","text":"天教文治盛岐丰，故遣奎垣照海东。\n笔底波澜流化雨，堂前嘘植散和风。\n臣心共信清如水，士气都令吐作虹。\n桃李阴阴春盎盎，栽培何幸到焦桐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12830,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"呈彭宝臣学使 其二","author":"张玉纶","text":"年来弱植叹飘零，旧润空叨沆瀣灵。\n已愧趋跄随后进，敢期诗句动文星。\n仙才盖世心偏小，佛慧披云眼更青。\n许向龙华参末座，钧天雅奏要亲听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12831,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"呈彭宝臣学使 其三","author":"张玉纶","text":"一朝知己百年心，往日青衫泪满襟。\n凡质果容陪点瑟，痴心还望度牙琴。\n未沾化雨难为石，得入垆锤便是金。\n千尺龙门山万仞，先登今已近华簪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12832,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己卯冬雪夜怀人诗十二首 其一 符象芝","author":"张玉纶","text":"辽海飘零日几曛，窘于一饭富三坟。\n又添酒债因留我，数尽诗家祗让君。\n风味六朝争上下，笔花五彩落缤纷。\n一宵话胜十年读，此意凭谁寄暮云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12833,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己卯冬雪夜怀人诗十二首 其二 王补楼","author":"张玉纶","text":"天马从来惯脱缰，奇才自昔说王郎。\n一钱但有姑谋乐，四壁都无不改狂。\n已许两心严匪石，由他众口鼓如簧。\n不忘萧寺联吟夜，觅句閒行绕画廊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12834,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己卯冬雪夜怀人诗十二首 其三 刘馀台","author":"张玉纶","text":"几回连辔据征鞍，敢拟同心比蕙兰。\n见面常愁今日短，怜才得似此人难。\n妻孥共喜佳宾至，乡里争邀上客餐。\n我困红尘君绛帐，相思空寄泪阑干。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12835,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己卯冬雪夜怀人诗十二首 其四 徐菊坡","author":"张玉纶","text":"南州早见擅文名，杯酒联欢两意倾。\n几见国风删好色，本来才子最多情。\n关心故雨从头论，眼上新诗垂手成。\n往誓至今犹感愧，宅分同住地同耕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12836,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己卯冬雪夜怀人诗十二首 其五 恩凤丹","author":"张玉纶","text":"常将风骨拟飞仙，下笔文章万选钱。\n多病定应添药债，奇贫或至断炊烟。\n曾期著述同千古，怆别音容又一年。\n苦忆夜深谈历象，空庭双立共瞻天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12837,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己卯冬雪夜怀人诗十二首 其六 得承斋","author":"张玉纶","text":"滚滚红云一马来，弓弦响处断猿哀。\n读书何止称名士，投笔犹堪作将才。\n绰有逸风常脱帽，略无暇日爱衔杯。\n程材自昔严刀尺，为汝凭教阔幅裁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12838,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己卯冬雪夜怀人诗十二首 其七 多雯溪","author":"张玉纶","text":"记从见面两心倾，此谊真堪托死生。\n不作寻常酬酢语，全敷心腹肾肠情。\n百年事业风盘鹘，一代才华浪跋鲸。\n怀抱不殊忘誓约，笑他车笠强要盟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12839,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己卯冬雪夜怀人诗十二首 其八 德翼文","author":"张玉纶","text":"几年鹿洞共班荆，到处推袁愧此情。\n力弱那能扶大雅，才疏常怕盗虚声。\n忘怀共托云霞契，放眼谁堪月旦评。\n驿使不逢空怅望，梅花何自寄重城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12840,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己卯冬雪夜怀人诗十二首 其九 刘敬亭","author":"张玉纶","text":"订交重认石三生，风雨连床岁几更。\n羌我孤吟怀梦得，有谁共饮胜公荣。\n挑灯奇鬼谈何壮，奋臂狂奴胆尚惊。\n惆怅别来经百日，何时重续旧鸥盟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12841,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己卯冬雪夜怀人诗十二首 其十 广福门","author":"张玉纶","text":"翩翩公子足丰神，奕奕才名迈等伦。\n见我每修床下拜，对君偏觉座生春。\n五车绩学文思古，千载论交气味真。\n南海人归何日是，几回望断马头尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12842,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己卯冬雪夜怀人诗十二首 其十一 广特夫","author":"张玉纶","text":"读罢诗书读汉书，藏修未肯负居诸。\n得师快比分炎鼎，交我欢逾御李车。\n定拟文思当日上，即论风度有谁如。\n差堪报慰无他事，强学还同识面初。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12843,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己卯冬雪夜怀人诗十二首 其十二 特百溪","author":"张玉纶","text":"良宵十月初三夜，梦里同看论蜀文。\n可否是君来入梦，抑还是梦去寻君。\n一天风雪迷清夜，百里关河隔暮云。\n羌我毕生期许在，龙头骥尾望超群。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12844,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"对酒篇","author":"张玉纶","text":"凡事有定数，人生贵自然。\n新酿酒已熟，独酌当窗前。\n是时雨初晴，天气何澄鲜。\n喜晴鸟声碎，含润花光妍。\n万象助清兴，超尔谢尘缘。\n回思念年来，何胜烦忧煎。\n负笈走洙泗，挟策超幽燕。\n伎伎奔逐鹿，跕跕悲飞鸢。\n欲成一世奇，屡催志益坚。\n才短难为用，不自知其愆。\n岂有渐渐石，能补苍苍天。\n古来名世者，多为世所捐。\n况乃无寸长，何以当招延。\n今者饮美酒，飘忽拟登仙。\n世网夙所萦，陡觉释其缠。\n如人荷重任，倏尔得息肩。\n无怪诸达人，日日中圣贤。\n寄语诸同好，酒白宜周旋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12845,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"桃花扇传奇题词 其一","author":"多隆阿","text":"水逝花残旧迹无，閒金剩粉半模糊。\n芸亭老子多情甚，演出南朝士女图。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12846,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"桃花扇传奇题词 其二","author":"多隆阿","text":"绮楼深贮海棠娇，轻拍玉牙按玉箫。\n一阕新声君一笑，六朝灰烬又南朝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12847,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"桃花扇传奇题词 其三","author":"多隆阿","text":"赤眉求印扰天街，甲马森森剑戟排。\n十里烟花遭劫火，惟馀明月照秦淮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12848,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"桃花扇传奇题词 其四","author":"多隆阿","text":"滚滚长江铁锁开，吴姬越女下歌台。\n春灯可是中兴乐，召得干戈遍地来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12849,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"桃花扇传奇题词 其五","author":"多隆阿","text":"衰草寒烟古渡头，渔人悲唱秣陵秋。\n无情最是秦淮水，犹与前朝一样流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12850,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"桃花扇传奇题词 其六","author":"多隆阿","text":"媚香楼畔草萋萋，树自成阴鸟自啼。\n一曲江南十斛泪，桥人重到画桥西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12851,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"即事 其一","author":"多隆阿","text":"鸟雀暮归树，牛羊暮归村。\n游子方驻马，阿母正倚门。\n斗然见儿面，喜极泪沾巾。\n谓得汝病信，忧集忘饔飧。\n旅处纵云顺，怀乡犹苦辛。\n况乃值坎壈，郁郁倍伤身。\n鸿信既濡滞，鲤书复沈沦。\n望汝如望岁，从朝望至昏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12852,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"即事 其二","author":"多隆阿","text":"半日犹蹙眉，此际眉忽展。\n欢喜容愉愉，诘问情款款。\n药饵需人煎，谁与尔相伴。\n安否有人看，谁与尔相善。\n尔衣或单寒，尔运亦屯蹇。\n一一诉根原，烛昏花再剪。\n出门望星天，斗柄已东转。\n昨宵觉夜长，今宵觉夜短。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12853,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"即事 其三","author":"多隆阿","text":"来朝命庖厨，割鸡与炊稻。\n菜汋腌菘芹，果陈乾梨枣。\n烹饪虽未精，适口即为宝。\n外乡饫肥甘，岂如乡味好。\n健胃复和脾，毋使颜色槁。\n忆昔汝未归，触目总烦恼。\n烦恼日益加，鬓发日益老。\n汝久客异乡，身体须善保。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12854,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"即事 其四","author":"多隆阿","text":"生聚谁不喜，生离谁不忧。\n宜知离与聚，亦各有其由。\n守株终无益，而令岁月偷。\n何如越乡国，负笈事远游。\n亲师并取友，三益须兼收。\n子果能循此，我亦弗多求。\n远游必有方，古人善为谋。\n家书频相寄，鱼雁莫勾留。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12855,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"旅次","author":"多隆阿","text":"宿鸟归巢际，行踪暂驻时。\n人忙问夜屡，鸡懒报更迟。\n起视马刍尽，仰观斗柄移。\n征车急就路，好鸟唤高枝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12856,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"客久","author":"多隆阿","text":"客久思乡切，行装整束频。\n言归三月暮，又负一年春。\n野草馋征马，山花媚路人。\n计途分远近，历历望城闉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12857,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"遇雨","author":"多隆阿","text":"忽唱骊驹曲，归心已往还。\n行旌辞野店，风信过前湾。\n急雨鸣深树，浓云补断山。\n泥黏车马滞，世路总多艰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12858,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"书院夜话","author":"多隆阿","text":"烧残银烛冷，兀坐小楼东。\n人话三更雨，秋吟一夜风。\n谈深欲忘象，客久羡归鸿。\n借问萧斋里，乡心若个同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12859,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋游 其一","author":"多隆阿","text":"顿觉林泉好，閒游异俗尘。\n顽童寻熟果，野犬吠生人。\n露重秋光老，农忙里俗淳。\n迂疏见成性，那敢说经纶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12860,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋游 其二","author":"多隆阿","text":"浅溪斜拗路，老树半藏村。\n积稻都成幄，编柴可当门。\n悬流春石罅，落叶匿云根。\n三两农人坐，閒将米价论。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12861,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋游 其三","author":"多隆阿","text":"秋游心倍爽，况复值霜晴。\n山好能医俗，才微敢钓名。\n闻人论菽麦，访友叩柴荆。\n老树多乾叶，因风作雨声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12862,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋游 其四","author":"多隆阿","text":"倦倚松亭下，秋烟锁四围。\n牛閒当路卧，雕健逆风飞。\n渔傍白芦泊，樵肩黄叶归。\n丁东时入耳，何处捣寒衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12863,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"村居 其一","author":"多隆阿","text":"好鸟唤前溪，春晴雨一犁。\n岸裁新水曲，云割乱峰齐。\n叶碧禾盈亩，花黄菜满畦。\n去年送人处，依旧草萋萋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12864,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"村居 其二","author":"多隆阿","text":"差觉强人意，门前过客稀。\n风和舒菜甲，雨小养苔衣。\n山静云偏出，园荒草转肥。\n邻家呼午饭，野老荷锄归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12865,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"村居 其三","author":"多隆阿","text":"古木阴如幄，新茶叶坼旗。\n燕忙穿树急，蜂醉出花迟。\n村景皆成画，农歌半类诗。\n不知三两叟，携杖欲何之。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12866,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"村居 其四","author":"多隆阿","text":"行行桃李树，著意厚培栽。\n地冷逢春晚，花迟入夏开。\n蝶随狂絮去，莺送好音来。\n我自閒观水，沙鸥莫浪猜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12867,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"出省感事 其一","author":"多隆阿","text":"征鞭遥指客匆匆，三叠阳关曲未终。\n在道惟依识途马，此生原似印泥鸿。\n姑留冷面辞春酒，敢把冰心告夏虫。\n借问高翔千仞凤，待时可许信天翁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12868,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"出省感事 其二","author":"多隆阿","text":"策马频催薄笨车，夕阳隐隐半天霞。\n依人我亦堂前燕，见小谁非井底蛙。\n牵惹馀情惟岸柳，勾留客子剩山花。\n知心独有中宵梦，夜夜催予速到家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12869,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日杂兴","author":"多隆阿","text":"物性宜探索，閒从静里求。\n风和知燕喜，雨暴替花愁。\n冈凸沙旋走，田凹水聚流。\n友人云树隔，怅望意悠悠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12870,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夜宿枣林","author":"多隆阿","text":"旅馆无人识，幽怀祇自知。\n孤灯听雨夜，小坐忆家时。\n点碎敲阶急，衾凉入梦迟。\n驿亭街上柳，一一发新枝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12871,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"抵家偶成","author":"多隆阿","text":"才系紫骝马，随敲白板扉。\n一堂人尽喜，千里客初归。\n泉水烹茶馥，河鱼入馔肥。\n门前秋尚浅，杨柳似依依。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12872,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"四围峰峦秀峛崺翠屏长中有读书人结庐山之阳笺注搜毛郑典谟溯虞唐敢道知希贵惟恐学业荒相彼幽谷兰无言祇自芳 其一","author":"多隆阿","text":"古人重实学，今人盗虚声。\n窃取糟粕馀，富贵博恩荣。\n衣锦誇闾里，策肥动公卿。\n譬如三春花，转瞬萎荒城。\n岂知松与柏，终古性常贞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":12873,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]