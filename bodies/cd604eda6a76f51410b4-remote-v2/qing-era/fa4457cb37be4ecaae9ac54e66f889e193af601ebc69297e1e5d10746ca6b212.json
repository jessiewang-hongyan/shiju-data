[{"title":"宿云栖庵","author":"柯崇朴","text":"远公遗迹在，古寺暮云封。\n磴转苍苔合，岩回碧树重。\n香台时下鸟，阴壑暗藏龙。\n坐久心忘寂，沈沈听夜钟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7440,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登莫釐峰","author":"柯崇朴","text":"莫釐之峰何嵯峨，下有冲激之洪波。\n波光浩渺天一色，渔舟几处扬清歌。\n云散烟空风乍息，湖上诸峰开历历。\n小者如拳大若箕，遥遥空翠俱堪摘。\n支硎穹窿作列屏，层峦复嶂何青青。\n道场卞山遥拱峙，波中点点同流萍。\n孤峰独向湖中辟，倒影入湖湖尽碧。\n可怜万顷堆琉璃，落日沈波摇琥珀。\n俯视千家粉堞雄，连甍接翼自相通。\n橘实垂时金错落，绮窗开处玉玲珑。\n此时旷望乐何极，杳然如在丹青中。\n来朝归去入城郭，空羡矶头一钓翁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7441,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"汝南道中","author":"柯崇朴","text":"驱马汝南道，行人愁路难。\n群山连削壁，急涧乱飞湍。\n虎啸青林密，猿啼白日寒。\n前瞻郧子国，尚有几回盘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7442,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过武胜关","author":"柯崇朴","text":"作客由燕赵，今朝入楚来。\n岩城临翠壁，荒磴没苍苔。\n山鸟一声寂，飞泉百道开。\n潇湘云正远，征骑几时回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7443,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"汉上赠查韬荒","author":"柯崇朴","text":"我从蓟北千山至，君自滇南万里来。\n乡思尚悲吴苑隔，客愁且向汉江开。\n薰风到处迷芳草，玉笛吹残怨落梅。\n漫道相逢始倾盖，十年早识子云才。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7444,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"解组书怀","author":"程尹起","text":"自笑操刀拙，经年客梦长。\n乡心传雁字，宦辙险羊肠。\n老去花朝露，归来菊晚霜。\n莫荒畦畔秫，寄语旧高阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7445,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"明发疁城招王子翌思小饮","author":"程尹起","text":"谢却折腰米，开尝瓮面春。\n隔篱呼共醉，明日是行人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7446,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过鄚州","author":"安致远","text":"古戍苍茫朔气横，黄尘扑面野云生。\n人传燕赵悲歌地，水咽荆高变徵声。\n百战河山余废堞，清时烽燧尚孤城。\n萧萧落日催征骑，愁听荒笳到耳鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7447,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"当涂将归留别葛谦斋","author":"安致远","text":"残春南寺客，日日计归程。\n旅梦松阴满，乡思艾叶生。\n莺花催客恨，风雨壮溪声。\n莫作江南客，从来多旅情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7448,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登青州北城楼","author":"安致远","text":"广固雄图揽胜过，万峰飞瀑泻长河。\n时清鼓角秋全静，地近烟岚雨易多。\n石柱鳌吞翻地轴，铁幢龙怒起盘涡。\n千家市逐浮槎尽，祇有西风吹逝波。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7449,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怀家兄黄铸及舍弟文振","author":"刘鼎","text":"最是春风大被宽，东山别后始知寒。\n池塘绿草长遥梦，桃李芳园不共看。\n路远裁书逢使少，家贫负米事亲难。\n天涯雾露须珍重，记得丁宁滏水干。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7450,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怨别离","author":"徐元梦","text":"思君恨夜长，寂寞空床宿。\n思君恨日短，白头一何速。\n长短空自知，思君无尽期。\n登楼时一望，杨柳夹堤垂。\n黄鸟鸣其上，喈喈有余悲。\n听之动中怀，罗袖春风吹。\n春风忽已换，阔别恩情断。\n织锦寄远人，远人隔河汉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7451,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送友人出使塞外","author":"徐元梦","text":"许国才年少，胡为绝塞行？\n一身凭汉节，匹马出长城。\n月色侵裘冷，霜花拂剑明。\n燕然何处所，石上自题名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7452,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日郊行有感","author":"徐元梦","text":"偶因寻客去，骑马出青门。\n落日衔千树，寒流抱一村。\n田家收黍稷，场圃散鸡豚。\n父老惊心目，将军猎骑繁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7453,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送随羲文出塞二首 其二","author":"徐元梦","text":"两出居庸塞，怜君常苦辛。\n风沙随去马，雨雪滞行人。\n地阔军民少，天寒部落贫。\n须知柔远意，率土尽王臣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7454,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登三屯镇城楼寓目","author":"徐元梦","text":"雉堞连山起，登临亦壮哉！\n一声南雁去，万里北风来。\n苔没前朝碣，云寒上将台。\n兴亡无限意，尚想济时才。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7455,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄施愚山","author":"徐元梦","text":"才名久已动中原，归卧东山道更尊。\n座上何人争刻烛，花间无日不开尊。\n春阴叠嶂云生户，水满双溪舫到门。\n谢氏芝兰今正发，鸾书应自下江村。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7456,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寓直书怀","author":"韩菼","text":"丁丁莲漏出花迟，紫禁清宵寄一枝。\n仙掌相如应减渴，玉桃方朔讶长饥。\n揽衣渐觉缁尘积，握椠多惭藜火窥。\n梦断疏钟长乐外，一声声与白云期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7457,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和东坡馈岁别岁诗 其一","author":"韩菼","text":"《木瓜》知苞苴，厚意聊以佐。\n滥觞自古人，后来乃以货。\n如闻暮夜间，取印如斗大。\n岂知幽栖者，岁晚只高卧。\n狼藉惟琴书，芳尘凝满座。\n借问腐儒餐，无乃出马磨。\n敢波及父老，简略诚吾过。\n清风傥可赠，于喁请君和。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7458,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和东坡馈岁别岁诗 其二","author":"韩菼","text":"冉冉年复尽，跳丸不肯迟。\n出宿饮盏者，俯仰安可追。\n行行重行行，去者天一涯。\n君自此远矣，劳苦问归时。\n岁去寻当来，决无食言肥。\n行看春女思，复见秋士悲。\n花开即花落，衔杯不须辞。\n醉乡无日月，或忘吾久衰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7459,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和东坡馈岁别岁诗 其三","author":"韩菼","text":"日月不我与，守者添画蛇。\n人生虮虱耳，譬若裈中遮。\n鲁儒爱尺璧，椟毁可奈何。\n或者起挥戈，跳去寂无哗。\n聊为烈士吟，复击渔阳挝。\n黄鸡才晓唱，白驹又飞斜。\n君看彭与殇，修短俱蹉跎。\n不如秉烛游，达者及足夸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7460,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"顾子元臣同侍御行并赠","author":"韩菼","text":"君家才子称痴绝，今日输君才更神。\n百页蛮笺磨墨汁，三升浊酒岸?巾。\n江头螺女常酬客，洞口榴花不避人。\n肯信薄游无稛载，锦囊赢得贮清新。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7461,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"汶河桥","author":"韩菼","text":"石梁互长虹，水流声活活。\n野色旷蒙山，荦确露山骨。\n及此爱清涟，复乃得奇石。\n瞰流势欲奔，连脉断若划。\n层层落芙蓉，片片碎云叶。\n倒卧九叠屏，喷激百道雪。\n嵌空劣容杯，平铺多得月。\n缅昔汶阳田，二三劳争割。\n我今坐盘桓，谁予复谁夺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7462,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"上巳宴集碧山堂","author":"韩菼","text":"暮春犹是永和初，花正开时柳乍舒。\n白社已荒三仕外，碧山重禊十年余。\n故人落落新来雨，澹月纤纤小摘蔬。\n我乃酒狂狂不得，漏声催箭整冠裾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7463,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送姜友棠孝廉南还酬次来韵","author":"韩菼","text":"三山风送谪来仙，入洛才名籍籍传。\n几束牛腰驱笔下，六朝麈尾话尊前。\n暂同石鼎分联句，休向江蓠苦问天。\n两剑双环真不易，春令孤影一潸然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7464,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西园","author":"王鸿绪","text":"每爱西园好，清樽到竹亭。\n石潭流霁月，崖木杂秋星。\n兄弟同晨夕，乾坤任醉醒。\n寥寥无识者，空著《太玄经》。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7465,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"归来二首 其一","author":"王鸿绪","text":"长铗归来日，貂裘欲敝时。\n吾亲怜久客，扶杖喜相持。\n款款谈征路，依依问旧知。\n自朝还至暮，尽室慰离思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7466,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"归来二首 其二","author":"王鸿绪","text":"吾母倚闾久，风尘望早归。\n惊看游子面，为浣去时衣。\n岩笋经冬出，慈乌向晚飞。\n《白华》堪志养，不必羡甘肥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7467,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"归来 其三","author":"王鸿绪","text":"半载京华客，归来意若何。\n早凋三径菊，空废《五噫》歌。\n开帙蟫鱼落，褰帷蛛网多。\n草堂须检校，从此卧山阿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7468,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晓发羊流店","author":"王鸿绪","text":"暮宿荒村听断鸿，晓驱行李入空濛。\n徂徕北绕千林合，太岳中盘万岭雄。\n天作冻云方酿雪，马思霜草半嘶风。\n人生出处缘何事，得失应须付塞翁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7469,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过平原饮董默庵前辈宅","author":"王鸿绪","text":"疲苶万山间，路险天地窄。\n昨朝出崖谷，豁达平原陌。\n有使前致辞，邀我话畴昔。\n策马入城闉，爰访晏相宅。\n公闻足音喜，早已途中逆。\n升堂拜未毕，樽俎罗几席。\n虽感故情深，毋乃不速客。\n却念十载余，云山两暌隔。\n今晨快把臂，敢辞露肝鬲。\n忆昔钩党兴，何处无弹射。\n我公天人姿，迅举凌风翮。\n鲰生愧燕雀，翻飞不盈尺。\n几遭一网尽，那复逃掎摭。\n时公秉斧钺，察余户扫迹。\n朗朗明月辉，回照寻山屐。\n嗟哉彼谮人，阴凝毒雾积。\n仰荷皇天鉴，涣汗别黑白。\n抚躬增内省，感激弥局蹐。\n欲酬屏幪德，踵顶难塞责。\n《九章》发楚哀，三宥蒙尧泽。\n吾侪幸无恙，此岂由人画。\n翳惟至圣仁，始得收魂魄。\n于公本同患，所以相剖析。\n当筵聊一歌，往事等驹隙。\n共倒杯中物，转为别离惜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7470,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"戒坛","author":"王鸿绪","text":"狮子岩头十八转，两崖相峙路如线。\n青峦碧涧绕珠林，丹壁雕阑耸禅院。\n禅院峨峨苍松寒，连柯接叶捎云端。\n蹁跹有似翠蛾舞，夭矫时作蛟龙盘。\n立者倚者各有态，或疏或密何珊珊。\n黛色参天凌汉柏，浓枝避雨胜秦官。\n我来婆娑至日暮，耳边萧飒流青湍。\n不知植根几千载，霜皮百尺雄斋坛。\n忆昔少游慈仁寺，殿角双松交古翠。\n童童如盖映芳樽，未饮先教心已醉。\n可惜花宫作贾廛，枯株零落充炊烟。\n岂若兹松居尘外，丰神舄奕层崖巅。\n乃知市朝摧折易，衰朽山林岑寂多长年。\n呜呼山林岑寂多辰年，北窗我欲耽高眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7471,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雾中由戒坛度罗睺岭稍霁至潭柘","author":"王鸿绪","text":"既瞻戒坛松，言观潭柘树。\n山僧劝我且莫行，白额秋来乱林坞。\n我闻斯言大吁怪，欲行不行日亭午。\n此生到处被物厄。\n不信山游复有虎。\n携朋大笑出寺门，樵子前驱荷干橹。\n联镳兀兀云雾中，羊肠鸟道愁花骢。\n十步九折凌绝壁，仰面直欲摩苍穹。\n但觉千山万岭同一气，举世高下归鸿濛。\n我仆马蹇滞岩底，招呼不辨西与东。\n兹山猛兽固客在，耳边作吼惟松风。\n须臾度岭四天豁，西崦已堕铜轮红。\n忽见九峰开锦帐，朱霞一抹青芙蓉。\n红楼金殿耸天际，秋林杳霭闻清钟。\n我策我马入幽谷，苾刍相引岩之麓。\n绀宇辉煌绕玉阑，禅房窈窕摇修竹。\n古柘千章无复存，妙严双趾今谁续。\n日斜不及访龙泉，仰睹峰头乱红绿。\n对景行厨泻酒醅，临风万里酣高台。\n我且歌，君莫哀，元规朝市多尘埃，城外名山谁看来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7472,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送顾侠君南归","author":"王鸿绪","text":"黄金台下骅骝去，尘世谁知相马经。\n击筑痛浮燕市白，钓竿归指莫釐青。\n凤毛共许传灵运，龙尾何妨属管宁。\n应有珠玑干气象，选楼高傍少微星。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7473,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日送黄仙裳南归","author":"徐秉义","text":"长安松下读书人，皂帽萧然迥出尘。\n暂傍香台寻胜侣，却乘秋水问归津。\n诗传摩诘真如画，豪拟元龙未觉贫。\n犹记高楼吟啸处，十年迢递海陵春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7474,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"泇河道中","author":"徐倬","text":"峄山湖畔峭帆飞，菰蒋菖蒲满钓矶。\n犍犊群来知近市，野凫浴久觉船稀。\n摊书客倦乌皮几，听雨凉生白夹衣。\n此去江淮行不远，黄鱼正美雪鲥肥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7475,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"坐段桥","author":"徐倬","text":"寒虫暖出游，我亦负暄至。\n缓足沿河堤，十步九回憩。\n黄叶树如妆，秋山云愈媚。\n游鱼聚空潭，归骑骋逸辔。\n群类各有依，孤客心何寄。\n怅焉成独坐，石梁对空翠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7476,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舟中戏题","author":"徐倬","text":"雪后微风卷浪迟，缓摇柔橹怕鸥知。\n舟中倦客闲凭几，不见舟移见岸移。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7477,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日遣怀","author":"李基和","text":"春日迟迟春未阑，愁怀欲放又难宽。\n弃余久已如鸡肋，知味何须食马肝。\n庭树两年根较固，笼禽数语韵多酸。\n涧阿有约谁归去，寤寐无忘为考槃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7478,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寿安寺读王北山给谏诗怆然有感因步原韵","author":"李基和","text":"人去山无恙，秋深气更清。\n新诗余败壁，古屋倚衰楹。\n日暮云归岫，峰环树作城。\n苍凉今昔梦，挥涕欲沾缨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7479,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"中秋旅夜","author":"李基和","text":"故乡何日到，今夕是中秋。\n落落空庭月，高高客夜楼。\n野烟当树暝，旅雁入云愁。\n遥忆诸兄弟，相欢在润州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7480,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"八达岭","author":"宫梦仁","text":"八达传天险，征涂迥未经。\n童山当昼白，绝涧入秋青。\n马首穿云盖，人声转石屏。\n侧身高处望，潇洒意常醒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7481,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清江送张友鸿之滇中司理并寄讯藩臬诸公","author":"宫梦仁","text":"箫鼓中流杂棹歌，仙郎拥传下牂牁。\n百年词赋题金马，万里风烟阻石螺。\n蛮俗古来多健讼，主恩天外待鸣珂。\n昆明战伐今何似，寄语加餐老伏波。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7482,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西山怀古","author":"周士皇","text":"月照残崖鸟乱鸣，乡州井里尚榛荆。\n寒流犹绕吴王垒，暮雨空催白帝城。\n古木有阴堪避暑，荒山无地可谋耕。\n逢人若道英雄事，惟有江流不断声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7483,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宿蟠龙山法海寺","author":"颜光猷","text":"山势蟠龙敞一门，天花历历蹑云根。\n秋高露湿双松白，夜静镫寒一殿昏。\n石景山前还系马，秘魔崖上更啼猿。\n何当同鼓西山屐，粮尽今朝且莫论。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7484,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"去安顺 其一","author":"颜光猷","text":"苗女蛮童且自亲，家乡万里可怜身。\n黄堂自笑衷肠软，五载何曾毙一人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7485,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"去安顺 其二","author":"颜光猷","text":"山高地僻景荒残，白发黄堂去习安。\n漫说三年金十万，何人留得一钱看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7486,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"酬刘铁庵次张笨山韵","author":"汪鹤孙","text":"骏马长鸣日，蛾眉只索居。\n玉禾惊岁晚，团扇及秋疏。\n荷锸宜耽酒，然藜莫校书。\n幽栖能结伴，选胜到精庐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7487,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"广游仙寺 其一","author":"汪鹤孙","text":"瑶岛灵踪未易寻，古来名籍却森森。\n悬知易贵非仙骨，要识难穷是道心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7488,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"广游仙寺 其二","author":"汪鹤孙","text":"尽日风波思不惊，绿蓑青笠最清真。\n吾师合是元真子，紫绶朱轓岂足荣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7489,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"广游仙寺 其三","author":"汪鹤孙","text":"割肉携归洵足豪，细君畅好共持醪。\n汉廷枚马皆厮品，不及东方待诏高。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7490,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"广游仙寺 其四","author":"汪鹤孙","text":"高阁通天讵降真，沈檀扰扰祇埃尘。\n蓬山吾辈须争座，不作持幢捣药人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7491,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"广游仙寺 其五","author":"汪鹤孙","text":"幽忧最是人间累，放旷元为学道先。\n可爱当年王子晋，吹笙未了便登仙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7492,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"戊申北上同人饯别南湖即席赋诗","author":"谢简捷","text":"红蓼滩头青雀开，金尊玉管坐徘徊。\n锦塘荷气因风散，高树蝉声带雨来。\n十里云山愁送客，百年朋旧几登台。\n河梁分手情何限，一曲骊歌首重回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7493,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送别赵秋水兼寄申凫盟观仲兄弟","author":"黄伸","text":"七月西风吹井梧，池荷渐老庭葵疏。\n鸣虫唧唧夜色徂，羁客徘徊临前除。\n送君尚记与君别，黄金台下无颜色。\n还家忽忽音书绝，君去并州我适越。\n洎我归来卧旧丘，闻君又买广陵舟。\n同在天涯不相值，江山怅望生离愁。\n两年不见增白发，相逢遗我诗盈箧。\n三伏炎蒸金石流，展卷洒洒飘冰雪。\n河朔快饮五陵豪，留君不住心烦劳。\n匣琴罢酌坐深宵，玉露无声银汉高。\n悠悠此意无终极，说向世人应不识。\n归见荆园两弟兄，为道别后长相忆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7494,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过丹阳晤九逵","author":"黄伸","text":"大江何浩渺，数载间情亲。\n别梦西泠月，愁心北固春。\n山川争待我，衣食尚随人。\n不尽班荆意，相看各怆神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7495,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜发吴江","author":"柯维桢","text":"枫叶晚秋红，平江驿路通。\n夕阳余野渡，衰草战凉风。\n鸟落寒山外，镫明古寺中。\n扁舟一樽酒，邀月与谁同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7496,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春暮送周青士","author":"柯维桢","text":"入春春半百花开，良友乘春放棹来。\n花为春归偏早落，人当春去却同回。\n三千远道他时梦，九十韶光此日哀。\n把酒送春兼送别，劝君且尽故人杯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7497,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望仙亭和韵","author":"柯维桢","text":"峻岭落天风，遥凝碧汉通。\n钟鸣高树杪，人语乱山中。\n雨过奔泉白，云开射日红。\n从怜巢鹤去，丹灶久应空。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7498,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"途中杂咏","author":"柯维桢","text":"山开隆虑容驰马，路入韩陵好射雕。\n满饮酡酥人不醉，邺城东望正萧条。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7499,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"暮春忆图南伯氏","author":"李来章","text":"独遇山川眼倍明，迩来诗酒是同盟。\n欲将《骚》赋追平子，肯放春杯让步兵。\n树密层阴藏野鸟，花稠香雾上棋枰。\n双柑斗酒长松下，芳草流莺唤晓晴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7500,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]