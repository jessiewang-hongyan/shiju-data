[{"title":"商都杂兴 其二","author":"斌良","text":"明昌捺钵似坻平，水草丰时骆橐生。\n一抹微云山翠外，舂锄依旧劝春耕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18217,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"商都杂兴 其三","author":"斌良","text":"戈壁苍茫万里途，盘车北上塞云孤。\n海龙江獭鱼油锦，留易新通恰克图。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18218,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"商都杂兴 其四","author":"斌良","text":"滑笏波流克蚌河，滥吹钢冻舞婆娑。\n插竿累甓当兰若，雅岱山巅鄂博多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18219,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"商都杂兴 其五","author":"斌良","text":"鸳鸯城畔草萌芽，毳幕毡房著处家。\n风卷驼茸铺白氎，错疑边塞落杨花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18220,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"商都杂兴 其六","author":"斌良","text":"丹栱凌霄梵唱圆，驼酥镫照九枝莲。\n西方兜率多欢喜，姽婳花鬘色界天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18221,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"碾伯县","author":"斌良","text":"蒲海沿边郡，峥嵘磴道盘。\n河冰连地结，岭雪极天寒。\n属国秋持节，将军老据鞍。\n西戌今底定，何事剪楼兰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18222,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舟次胥江寄怀立之棣敷季彤诸弟","author":"潘正亭","text":"江雨忽如雾，山云悭放晴。\n长途风雪旧，壮岁别离轻。\n忽忆同怀子，怜余事远征。\n东归附浈水，流梦到江城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18223,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"泊沙湾拟游小金山阻雨不果","author":"潘正亭","text":"放棹穷幽赏，连阴不肯晴。\n寒烟欺柳色，急雨乱滩声。\n古寺云中梵，雄才海外名。\n无由参慧业，一为证生平。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18224,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"涿州","author":"觉罗桂葆","text":"日南要郡重经过，城垣高耸形巍峨。\n沙迹渐侵胡良岸，柳色暗绿先锋坡。\n车扉两版客梦稳，蹇赢一双铃语和。\n西山留人太无赖，迢迢百里堆青螺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18225,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"湖上大雪作歌","author":"觉罗桂葆","text":"重重叠叠云气围，苍苍凉凉湖浪稀。\n元冥司令理应尔，雪花如片漫天飞。\n逆风行船马脱鞿，碎冰琤瑽喧石埼。\n远峰埋没近峰峭，低桥明洁高桥巍。\n葛岭松篁绿愈静，栖霞枫丹红赐绯。\n南屏钟声凝翠微，气候凛冽僧扃扉。\n逋翁骑鹤天外归，坡老撰杖林间晞。\n相逢一笑戛乌榜，轻蓑催换渔人衣。\n湖楼疥壁去腊尾，秃毫忍冻淋漓挥。\n几痕鸿爪忽到眼，枨触吟兴呼妃豨。\n我本左司旧宾客，两年湖侧疏嘲讥。\n乾坤更幻游世界，天意不薄人难违。\n暝禽啼空导归路，船唇篷背生光辉。\n逝将呼朋诣绝顶，吴山残雪供攀依。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18226,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送戴兰江观察赴任南河","author":"熊莪","text":"绣衣持节赋将离，几载秋曹得所师。\n治狱争夸于定国，浚渠还借郑当时。\n栽培南国棠千树，惆怅西风酒一卮。\n瓠子安澜频奏续，好凭双鲤寄相思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18227,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"元日立春五亩园看雪","author":"周光纬","text":"隐几待明发，醒然警晨钟。\n策杖入园扉，晓寒何惺忪。\n微茫露奇石，淅沥栖长松。\n当轩风尚竦，隔屋云犹浓。\n爱此作小立，寒犯裘蒙茸。\n庆兹首祚日，是日斗柄东。\n侧闻野叟言，百岁不易逢。\n今当清晏时，寿寓方延洪。\n九垓虽云远，同在春风中。\n奚为望西笑，耕凿皆尧农。\n有园广五亩，有田可十弓。\n学稼与学圃，我将何适从。\n古梅解人意，花开若为容。\n折之贡北堂，以为椒酒供。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18228,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"六和塔","author":"阿林保","text":"拾级凌高顶，危栏未敢扶。\n山从朝日出，云到大江无。\n地势随吴转，涛声向海趋。\n沧桑经几变，千古此浮图。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18229,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"看桃花","author":"阿林保","text":"客舍适无事，出门春满山。\n东风孤寺外，夕照小桥湾。\n倚杖入云去，拨舟随水环。\n武陵意一往，未必非人寰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18230,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"买花券","author":"阿林保","text":"何必山涯与水滨，案头屋角四时新。\n片言订得林中约，一纸招来天下春。\n破例不妨同市侩，买花毕竟是骚人。\n当年玉鼻谁书券，笑步东坡马后尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18231,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"中秋重游白鹿洞同人雅集分韵","author":"特依顺","text":"胜迹重游喜共登，遥山浮水影飞腾。\n三千界外秋光动，百尺楼中夜气澄。\n香满乾坤八月桂，星连上下万家镫。\n酒阑还向高僧话，几度禅林感废兴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18232,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"永州返棹经三浯步元次山窳尊原韵","author":"杨芳","text":"大江水西来，回环绕幽亭。\n窳尊凹石穴，石以次山名。\n乱峰嵌江渚，一掬傲东瀛。\n秋雨溜不竭，中睹蛙黾生。\n有唐昔中叶，灾黎栗洪溟。\n漫叟吏舂陵，不忍独为醒。\n时时发醉语，嘲戏余深情。\n当年持符地，疮痍满荒城。\n至今颂遗爱，竹树炊烟青。\n亭小难容席，白云环檐楹。\n遵人留残滴，窳浅尚古形。\n我来挹高风，时思携瓯瓶。\n陶然共一酌，何必期渊明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18233,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"从军行 其一","author":"严如熤","text":"昔对金门策，太息怡安篇。\n公卿虚前席，共推贾生贤。\n南山盛盗贼，民命迫倒悬。\n澄清亦有志，叱驭乃竟前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18234,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"从军行 其二","author":"严如熤","text":"军符来汉南，星言速征骖。\n凤岭云连翅，柴关树如蓝。\n讹言栗我仆，镝鸣更丸探。\n慷慨尚前去，险危余所谙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18235,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"从军行 其三","author":"严如熤","text":"人髓黄狐吮，人腹苍鹰啄。\n磊磊战骨白，当道研车毂。\n陇蜀道路通，万灶列林谷。\n壮哉草桥战，杀贼最神速。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18236,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"从军行 其四","author":"严如熤","text":"阶文又金川，道路五千里。\n赤眉不相值，千群空武士。\n膏雨今郇伯，豆区惠闾里。\n王师本无战，壮士尔徒死。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18237,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"从军行 其五","author":"严如熤","text":"小者结搴栅，大者筑堡城。\n十百联为一，比里室家宁。\n耰锄铦钩戟，陇亩安耕耘。\n此语吾非妄，古之民皆兵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18238,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"从军行 其六","author":"严如熤","text":"南山古陆海，耕作半流人。\n扰之而为贼，祸患相频仍。\n千里天安地，安危仗大臣。\n但能择守令，黄巾皆良民。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18239,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"从军行 其七","author":"严如熤","text":"妖星去年落，鼠穴一时清。\n小丑何足数，岁登百室盈。\n愿戒兵犹火，相期政皆平。\n帕首靴刀者，本来一书生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18240,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答杨春晖都中见忆兼柬春田竹浯笛楼云桥白桥麓西诸子","author":"严如熤","text":"陇首茫茫望朔云，一天梅雨镇怀君。\n都亭叱驭今三载，井络连营尚六军。\n大将鹰扬歌破阵，故人鸿爪怅离群。\n岳云河树层层隔，剪烛何缘话夜分。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18241,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送鹤文总戎入觐","author":"严如熤","text":"址年从事亚夫营，大树将军旧有名。\n自古奇功多世将，几人折节似儒生。\n马盘天半飞蛇路，箭听秋空落雁声。\n报国祇今年正盛，戟门深对五云明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18242,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"沅城杂咏","author":"严如熤","text":"贞臣壁立障狂澜，仆寺何心薄冷官。\n自信主恩怜谠直，谁知党祸病衣冠。\n千秋蘋藻荒原里，一径松楸暮霭端。\n怅望雄山吟啸处，古琴能得几人弹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18243,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"抵岭南呈绎堂先生","author":"严如熤","text":"戈船横海旧登坛，幕府相依尚素冠。\n丞相舍人容魏勃，将军门客愧任安。\n曾怜誓墓情怀切，敢惮从戎道路难。\n铜柱即看铭越秀，蒲帆会许挂湘澜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18244,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怀李二内翰","author":"严如熤","text":"烽火连年迫上庸，靴刀几队健儿从。\n田单只计宗能保，李广何妨相不封。\n虎穴挥戈余慷慨，凤池簪笔镇雍容。\n笑余介胄惭文吏，华烛清樽接子丰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18245,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"古北口晓行","author":"李如枚","text":"千尺雄关拱蓟门，曈昽晓日映长垣。\n双扉不锁滩头水，绕郭年年碧涨痕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18246,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山中夜行","author":"陈祁","text":"月暗霜寒夜，空山彳亍行。\n林深人迹少，石乱马蹄惊。\n欲觅溪桥路，先寻涧水声。\n到村来犬吠，问寺听钟鸣。\n岩影四围黑，天光一线横。\n遥镫时隐现，老树忽支撑。\n剑气畴能识，棋心自不平。\n仆夫嗟况瘁，谁喻此时情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18247,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九日四日坐雨","author":"富斌","text":"坐久萧然万虑清，幽禽两两傍檐鸣。\n雨声欲酿寒花老，风力能欺落叶轻。\n北望尧封云郁郁，南寻禹穴水盈盈。\n流光又近重阳节，何处题糕会友生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18248,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"叠营字韵寄盛子履","author":"富斌","text":"莫叹儒冠误半生，名场屈指几人成。\n耽诗未必非清福，嗜酒何尝减至情。\n姓氏千秋原有命，穷通一笑自无营。\n怜君近有羁愁句，故和新篇作越声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18249,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝉","author":"敬文","text":"繁音催过夏，远韵又迎秋。\n木叶未全落，鬓丝先已愁。\n身轻高柳外，声断晓风头。\n欹枕不成梦，凄清百尺楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18250,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋葵","author":"敬文","text":"秋花斗繁艳，栽植满园林。\n惟尔甘篱落，偏存向日心。\n干高出百卉，色重比南金。\n莫笑宜农圃，山村雨露深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18251,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感秋","author":"法良","text":"商飙吹我帏，皎皎九月明。\n中夜不成寐，起坐挥鸣琴。\n三星入户低，北斗高未沈。\n白露下丛薄，栖禽巢远林。\n美人在云端，相隔若尺寻。\n一弹理七弦，但伤无知音。\n岂欲有知音，聊以协素心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18252,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"有感","author":"法良","text":"闻道淮南事可悲，其鱼万姓叹流离。\n天心未必无生意，地势居然似漏卮。\n孰访画区寻禹迹，须知洪水在尧时。\n广陵八月观涛处，惆怅难歌《七发》辞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18253,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"入瓜口","author":"法良","text":"放眼金焦外，云中舣万艘。\n人烟瓜步树，残雨广陵涛。\n身世随孤棹，乾坤感二毛。\n狂思斩蛟隼，频视吕虔刀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18254,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南阳湖夜行","author":"法良","text":"卧听沙禽语，推篷对白蘋。\n天空云在水，风静月窥人。\n身世惭雌伏，江湖比雁臣。\n坐观群动息，吾自乐天真。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18255,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"甲戌荷月二十七日雨窗作","author":"恩龄","text":"小阁轻寒梦乍醒，满园秋色上窗棂。\n无端镇日潇潇雨，不种芭蕉也怕听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18256,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舟过青溪县遇涨泊大王滩上","author":"谢元淮","text":"峰影压船重，鼓棹发青溪。\n水浊知江涨，波涌散凫鹥。\n山中夜雨足，高浪与山齐。\n浮舟入天汉，斗觉前峰低。\n横流竞东注，倒泻何时西。\n平生惯江海，见此重惨凄。\n空有舟楫在，滔滔归路迷。\n仰愧飞鸟翔，俯愁断猿啼。\n悬崖阻僰岸，万仞何由跻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18257,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"留别吴醒樵","author":"谢元淮","text":"频年踪迹囿尘埃，块磊难消浊酒杯。\n白首渐怜词客老，青山同哭故人来。\n云烟屡幻身犹梗，霜雪重经念已灰。\n遥指楚江天外远，风波如此片帆开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18258,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登大伊山望海慨然有作","author":"谢元淮","text":"童男帅女觅蓬壶，却笑秦皇作计粗。\n采药楼船何日返，登山筇屐此时俱。\n江河入海涵清浊，齐鲁连云望有无。\n谁信凫夷来地底，一挥长剑扫天吴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18259,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三泉寺访王茂才","author":"观荣","text":"扶杖偶然去，沿溪不知远。\n日入白云深，天迥丹枫晚。\n清磬出深壑，残雪点绝巘。\n披萝到梵刹，碍径松枝偃。\n琉璃光闪烁，龙象气偃蹇。\n弥勒同一龛，山蔬香积饭。\n君方抱佛脚，我亦迷途返。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18260,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三月二十七日御青阳总戎邀游杨历岩观瀑诗以酬之兼简州佐言宝侯","author":"观荣","text":"元鼎五年下南越，何暇来结山水缘。\n楼船一去不复返，后二千载名仍传。\n我闻岩中瀑布实奇绝，不数匡庐雁荡天台巅。\n方今总戎整以暇，胜情胜具来相延。\n二三好友联辔去，莺啼草绿山花妍。\n入山逾深路逾狭，泼眼青翠高摩天。\n雷声轰轰不见影，蒙茸竹树楼阁悬。\n纡径以入蚁穴曲，循磴而上螺纹旋。\n悬崖断处下无地，千尺倒挂龙蜿蜒。\n毛发洒然换尘骨，栩栩欲化凌云仙。\n灵湫喷出珠错落，神物何日潜九渊。\n时凌八垓作霖雨，归去抱珠深窟眠。\n初看出峡原一线，定知润物成千川。\n平原旷荡三万顷，灌溉尽作膏腴田。\n水源未省何处落，欲叩真宰无言诠。\n回头雉堞在足底，来往蚁织纷喧阗。\n太息红尘消白日，凡心欲悟虚空禅。\n从来灵境多幽閟，不遇好事谁为宣。\n况乎古人亦陈迹，风流难溯魏晋前。\n徐凝诗恶太白死，髯苏往返无闻焉。\n将军此来若发覆，我幸与君相周旋。\n题诗纪事勒之石，后起何必输前贤。\n雄州别驾闻此语，相视而笑为欣然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18261,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晓起出峡","author":"杨光祖","text":"远眺近昭平，滩声傍耳鸣。\n岚浮青嶂隐，日上绿峦横。\n试险人常惯，奔湍意转平。\n梧江三百里，往返一帆轻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18262,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重阳日过仙霞岭","author":"金棨","text":"五年三度岭，此度恰重阳。\n正好登高会，谁怜在异乡。\n遥天宾雁入，细雨客衣凉。\n忆昨中秋节，团栾侍北堂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18263,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"旅宦","author":"邹贻诗","text":"旅宦艰难遍，三春百战余。\n野荒新鬼哭，天远故人疏。\n琴剑凄行色，莺花伴索居。\n少年弃繻者，飞动意何如。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18264,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"军中秋兴 其一","author":"邹贻诗","text":"涛声秋捲海门开，舻橹争看节使来。\n十里郊原犹剑戟，一年城郭半蒿莱。\n出山殷浩心原壮，入楚廉颇老渐催。\n见说施蓝威望在，夕阳凭吊首重回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18265,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"军中秋兴 其二","author":"邹贻诗","text":"闻道孤城未解围，眼穿消息又斜晖。\n频看貔虎纵横去，又见虫沙散漫飞。\n捷奏经时疑信半，主恩入骨死生微。\n正当宵旰忧勤日，鼓角声中泪洒衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18266,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"绵山","author":"朱锦琮","text":"城外高山接太行，春深墓草散牛羊。\n禁烟节自多风雨，旌善田谁种稻粱。\n十载君臣同牧圉，一身泉石中膏肓。\n晋祠流水清如玉，洗出幽岩数点苍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18267,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"徐州旅店有怀六弟","author":"朱锦琮","text":"驰驱孤负薜萝身，越境先从此间津。\n地界长河筑高岸，天留残月送行人。\n中途改驾无鞍马，旅馆加餐得锦鳞。\n曾约连床摅别绪，陟冈知否雁来宾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18268,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"野望","author":"朱锦琮","text":"旷野萧条暮景悬，眼光尽处地连天。\n路无马迹多荒草，村有鸡鸣隔翠烟。\n近树高于远山顶，朝霞明到夕阳边。\n肩摩古驿劳迎送，指点归途缓著鞭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18269,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自柏枧山至引量桥 其一","author":"朱锦琮","text":"两崖回合处，仄磴下肩舆。\n芳草青黏屐，晴云淡曳裾。\n山空惟有树，涧曲更无鱼。\n峡口忽中断，长虹驾碧虚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18270,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自柏枧山至引量桥 其二","author":"朱锦琮","text":"楼从桥上盖，地僻往来稀。\n泉洗石根瘦，烟环松影肥。\n李侯游未到，梅氏宅相依。\n小憩成孤赏，钟声落翠微。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18271,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"粟珊弟得天台赤藤杖归献伯父为作歌","author":"朱锦琮","text":"天台一万八千丈，谢屐梯云未能上。\n阴崖雪积万年藤，飞作仙人九节杖。\n仙人王烈朝玉京，葛翁又向璿台行。\n紫芝灵药不轻泄，君昨宦游过赤城。\n赤城霞起连远岫，众圣排云露肩袖。\n见君中道立徘徊，笑拔虬髭介君寿。\n君时四十年方强，手摘星宿如探囊。\n历遍云蓝七十二，携归东海呈高堂。\n忆我高堂谢单宰，孙枝侍舞斑衣彩。\n归田复出终郎官，天坛灵寿今犹在。\n我摄淮平斗大州，青藜簇簇蕃新秋。\n披枝剪叶饰根干，相期致仕扶为鸠。\n白发扶鸠仰世父，手中紫玉坚如柱。\n户牖间投欲化龙，鳌溟䀜爽腾风雨。\n半载曾连听雨床，与君遥祝寿而康。\n秦溪宛水一千里，眉介何时进玉觞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18272,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"四弟自苏州送酒来","author":"朱锦琮","text":"藓门风雨引杯长，别去燕台夜有霜。\n刺史权来逾五日，菊花开处过重阳。\n莫瞋周顗驰名早，多谢陈暄为我藏。\n恰好东离索诗句，白衣人到便倾觞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18273,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登庾楼","author":"朱浩","text":"浔阳城北一江秋，高栋凌虚旧有楼。\n千里舳舻连白下，二分烟树是黄州。\n风流未必输前辈，月上还须共此游。\n回首匡庐开半壁，炉烟正在紫峰浮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18274,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"孔家涵桃花","author":"朱浩","text":"田头老农颜似铁，操犁日朝到日昃。\n归来破灶烧湿苇，翠烟如缕消残雪。\n蒸称煮藿儿女欢，不嫌泥垢同盘餐。\n黄土筑墙茅盖屋，此中即是桃花源。\n门外忽见胭脂山，一株雨株春风颠。\n浣纱女子清溪边，卖珠侍儿修篁间。\n金粉扬州空斗巧，富贵春明无此好。\n水流花发少人知，黄牛独龁门前草。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18275,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寻梅","author":"常清","text":"闻说山头寺，春风到野梅。\n入林樵径转，照眼暗香催。\n翠萼倚残壁，疏花坼古苔。\n平生泉石趣，对此重徘徊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18276,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寒食署中即事","author":"常清","text":"山城细雨日连绵，做出棠梨寒食天。\n门外萧疏多是柳，厨中淡泊不生烟。\n催成暝色怜饧管，啼老春光怨杜鹃。\n留得庭花诸样种，呼童撒向小窗前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":18277,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]