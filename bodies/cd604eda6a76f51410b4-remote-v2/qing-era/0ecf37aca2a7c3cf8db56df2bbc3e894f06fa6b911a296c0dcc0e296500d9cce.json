[{"title":"王青县懿颂同年去秋惠余沧酒一瓮中途车覆书至而瓮空今来青县复以一瓮见饷口占一绝谢之","author":"顾嗣立","text":"开缄擘酒馀空瓮，如对春江想泼醅。\n乌有先生何处去，青州从事喜重来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30914,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"流河驿泊舟夜月言意二首 其一","author":"陈万策","text":"林钟律晚近清秋，薄暮风凉动碧流。\n烟火一湾当水驿，桂光半满入兰舟。\n江村泊艇宜宵赏，海国归桡是昼游。\n即事已添潇洒兴，清衾有梦到林丘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30915,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"流河驿泊舟夜月言意二首 其二","author":"陈万策","text":"御河牵缆溯洄漩，去国何须意惘然。\n社燕将雏回故垒，洲鸿刷羽上高天。\n行囊剩有经书满，舞袖翻归锦绮鲜。\n素影沙光澄似练，浩歌一曲扣吴舷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30916,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"花园属青县","author":"陈万策","text":"轻舟夜泊在花园，茅枳江头自一村。\n几树长条飘绿带，满江细浪浴金盆。\n篙工棹罢宵光静，笠客锄归岸际喧。\n前路沧州佳酒近，也应沽取醉清尊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30917,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县舟中夜雪","author":"揆叙","text":"芦台城畔舣楼船，乾雨争飞二月天。\n碎玉有声寒漏外，散花无数夜灯前。\n殊非梁苑开樽日，只当山阴返棹年。\n怪底搜肠无杰思，蹇驴不是灞桥边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30918,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县访同年亓暄岩明府话旧即日赋别二首 其一","author":"田同之","text":"燕树齐云客梦牵，一朝邂逅茂林边。\n相将华发悲今日，珍重青衫忆往年。\n官阁芳尊新雨后，中峰明月故人前。\n因君转忆同门友，廿载浮沉十二年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30919,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县访同年亓暄岩明府话旧即日赋别二首 其二","author":"田同之","text":"草草相逢傍绿莎，匆匆又复唱骊歌。\n眼明北海情如此，心逐南宫老奈何。\n射雉台旁秋水阔，峭帆亭上柳枝多。\n殷勤折赠怜同调，勉拟乘槎一溯波。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30920,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县夜泊","author":"朱文心","text":"尊前初对沧州酒，有客重为此地游。\n风起惊涛在空树，夜深凉月入虚舟。\n长河浩荡通瀛海，大野苍茫接蓟丘。\n明发津门重回首，南飞一雁楚天秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30921,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"中秋九月行青县过九华庵访恒中和尚","author":"高斌","text":"运河东岸上人家，暮鼓晨钟静不哗。\n旧识高僧元白首，重来古寺对黄花。\n十年幻梦经三宿，一径清幽入九华。\n坐久浑忘秋夜永，半窗明月欲西斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30922,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县舟中早发","author":"高凤翰","text":"鼓舵凌清晓，推篷坐拥衾。\n波流双桨影，树落半塘阴。\n沙鸟云汀小，人烟水市深。\n几声欸乃曲，萧瑟送秋音。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30923,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县客寓度岁","author":"毛振翧","text":"永安城外一逢春，自笑年年作旅人。\n沧海麻姑空有约，瀛洲仙客杳难亲。\n即看冻水冰花解，又见河桥柳黛新。\n老马途谙休叹息，曾闻天语重劳臣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30924,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己未春赴青沧减河届壕晚归","author":"毛振翧","text":"元日匆匆赴古壕，荒营水没长蓬蒿。\n雪埋幽径人踪少，风起平沙雁影高。\n野老醉归村色晚，健儿猎罢马声号。\n独怜河畔惊春客，犹拂霜华染鬓毛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30925,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过青邑怀金蒿亭明府","author":"毛振翧","text":"故人长去我重游，驻马河桥感不休。\n枕上客寻前日梦，枝间鸟唤别时愁。\n西湖旧是吟诗地，南浦还馀载鹤舟。\n惆怅高风谁复共，富春烟水自千秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30926,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县","author":"查为仁","text":"咚咚戍鼓促扬舲，篷底吟成独自听。\n一色好风刚百里，日斜吹到峭帆亭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30927,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"兴济","author":"桑调元","text":"车如流水下平皋，骏马蹄轻未觉劳。\n犹管送迎堤畔柳，临风疏影弄萧骚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30928,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"兴济晓发","author":"张湄","text":"灯明村舍远，露白曙钟初。\n无事且高枕，有请惟故书。\n蹉跎秋过半，憔悴柳同疏。\n抱叶吟蝉静，知时我不如。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30929,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夜泊青县","author":"常青岳","text":"天光云影漾中流，岸柳重重隐戍楼。\n双棹舞风翻细浪，蒲帆夜半落清州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30930,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"马厂访萧千戎夜话","author":"常青岳","text":"良朋官廨傍河隈，踏岸相寻特地来。\n日暮不烦烧绛烛，酒樽好对月明开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30931,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"兴济","author":"常青岳","text":"古县荒凉枕卫河，客舟泛泛此经过。\n会川风景犹堪记，一带长堤绿柳多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30932,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"早行青县道中","author":"明善","text":"茅店鸡声远，垂垂月尚弯。\n云开天色定，风静树声闲。\n薄霭浑疑雾，高林俨似山。\n长途何自急，明日即乡关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30933,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"不寐九月十一日时至青县","author":"金甡","text":"耿耿怜鱼目，如临沸釜惊。\n暌乖判火泽，离照饬戈兵。\n妖乱经年伏，威棱计日平。\n安流忘涉险，暂遣警归程。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30934,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过青县","author":"阮学浩","text":"青县拱神畿，东偏连海隅。\n弥漫三沽道，众水所沮洳。\n长堤束两岸，岁岁劳补苴。\n岂不惜金钱，用奠釜底居。\n隐隐桑麻村，杳杳烟火墟。\n耘锄炙炎日，妇子同劳劬。\n良畴幸云茂，指顾盈篝车。\n谁撄老蛟怒，浊浪横卷舒。\n牵挽一线路，终夜成川涂。\n签程苦留滞，过此增感歔。\n徒闻走吏卒，喧集流亡夫。\n屯云列畚锸，比户征薪刍。\n鞭笞塞决口，虫蚁泥涂趋。\n哀哉田庐没，沉痛迫肌肤。\n堤完复何益，胡不缓须臾。\n长官曰否否，河患无时无。\n那因尔民患，罪我官守疏。\n疏防幸罪脱，遑问民力痡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30935,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县晚泊","author":"汪师韩","text":"连舫静海过，收纤青县宿。\n驶浪折沙湾，绪风含水木。\n人烟棹处移，海月樯间落。\n丘亭俯闲塘，暮色翳遥陆。\n声响出攀罾，疏星带渔屋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30936,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夜雨泊青县二首 其一","author":"金玉冈","text":"野泊昏林外，风涛睡未能。\n深秋荒岸雨，残夜小船灯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30937,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夜雨泊青县二首 其二","author":"金玉冈","text":"宿水唯同雁，还山半似僧。\n萧然吟卧处，衲被胜青绫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30938,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夜雨泊青县二首","author":"金玉冈","text":"一夜孤篷雨，新潮涨旧痕。\n野航轻似叶，小县冷如村。\n贴水编茅屋，沿堤抱柳根。\n又随萍梗伴，暂过酒家门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30939,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"四月三日兴济早行","author":"万光泰","text":"旱风屯夜云，夜热如病酒。\n展转鸡三号，倏忽秋历九。\n茸裘覆掩骭，蔽絮传露肘。\n独行易伤怀，卫生敢不厚。\n朝暾炀林木，热属又奔走。\n农氓土作龙，神觋水洒柳。\n吁祷日以虔，甘霖竟何有。\n燕齐恃二麦，晓夕望南亩。\n极目牛尾稀，伤心飞蓬首。\n茅檐烟渐出，啼泣遍黄口。\n一市聊米盐，连村各携负。\n阴阳燮上相，干溢轸元后。\n年年振官仓，渺不计生斗。\n救荒无善策，备急要经久。\n太息桑林情，因风咏星罶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30940,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过蔡家庄","author":"赵青藜","text":"百里天津上，轻舠溯远流。\n行看青掠岸，静觉水争舟。\n树里人家少，池边饭磬幽。\n客心真汗漫，昧昧失更畴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30941,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"次御李韵","author":"赵青藜","text":"清幽蔡氏业，潇洒野人庄。\n树郁斜晖色，风浮细草香。\n高原宜黍稷，古渡下牛羊。\n日暮闲凝睇，微波接渺茫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30942,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"盘古沟","author":"张开东","text":"青县盘古沟，上有盘古庙。\n乾坤始开辟，川原几劫造。\n羲文犹称晚，禹工安足绍。\n世代已沧桑，传册空名号。\n士生千载下，何由穷玄妙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30943,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晚泊流河驿","author":"查学礼","text":"一叶栖何处，黄昏泊浅滩。\n渔灯穿树细，秋月漾波寒。\n梦绕关河回，心随驿路宽。\n棹歌中夜起，离思渺无端。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30944,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"盘古冢诗","author":"袁枚","text":"名字虚无姓渺漫，当年谁与葬衣冠。\n能将莽莽乾坤辟，亦复萧萧邱陇寒。\n数典更无前辈在，留坟似与后人看。\n不将死例当头定，世上纷纷事更难。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30945,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县晚渡","author":"杜鼒","text":"何处堪投宿，黄昏古渡头。\n疏钟闻远寺，微火识孤舟。\n烟隔荒城起，波通大海流。\n却寻杨柳岸，沽酒市边楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30946,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县道中","author":"章恺","text":"浅渚连秋草，平堤带夕阳。\n几家茅屋小，一路黍苗香。\n眠鸭多闲意，垂杨不断行。\n沙河如更洁，便足敌江乡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30947,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"九日游盘古庙","author":"魏大名","text":"平畴缺登眺，佳时兴不空。\n危庙滹水阳，秋赛传琳宫。\n九客狎乡俗，驾言畅寂衷。\n稼收田野扩，缕堤亘长虹。\n过桥隘车马，高坞老树雄。\n士女竞盘旋，拾级登道通。\n顾瞻牖栏外，贾贩庞以充。\n秋色西南来，飒然故山风。\n菊花阔不见，落帽醉谁同。\n白帝阅吾久，似讶常飘蓬。\n断流清可见，人面羞丹枫。\n夕霞满归幰，凭轼歌鸿濛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30948,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县夜泊","author":"宋铣","text":"六日周行才两程，孤帆落处傍荒城。\n颠风吹浪晚更急，密雨打篷灯半明。\n大芋高荷忆萧瑟，乱蛩衰草伴凄清。\n秋深尚欠持螯约，惆怅寒蒲郭索声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30949,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县竹枝词 其一","author":"阎循观","text":"中山山下竹青青，潞河河外烟冥冥。\n三日好风吹细水，李花开遍峭帆亭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30950,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县竹枝词 其二","author":"阎循观","text":"雨歇渔人集碧潭，蘋风不起静波澜。\n网丝牵动芙蓉叶，鲜螯出水大如盘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30951,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县","author":"阎循观","text":"落魄旗亭谱竹枝，尘颜憔悴泪成丝。\n七年被酒重看镜，惟有霜毛异旧时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30952,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县","author":"王昶","text":"将随玉辇向津河，持节重看下楚波。\n欲上肩舆回首望，水西庄外暮云多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30953,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县道中即事","author":"王昶","text":"不见翻风麦浪齐，但看烟柳接长堤。\n牛眠野岸初肥草，燕掠寒潮乍退泥。\n单棹卖浆依戍堠，连筒汲井灌蔬畦。\n悬知节气将芒种，再望甘霖助一犁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30954,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"盘古庙","author":"何在田","text":"冥濛初辟无人伦，闻有盘古明君臣。\n又云人生必有祖，约略尊之号盘古。\n年荒事渺资游谈，盘古有墓青城南。\n吾闻古无封树制，此地高坟蹲赑屃。\n况当文字未生时，谁图形貌留荒祠。\n遗俗常拜墓常扫，岁荐肴烝杂香芼。\n先民亦复能火食，里巫独识神嗜好。\n君不见儒生读书颂陶唐，读史称三皇。\n岂如里巫学更博，能为盘古创祠乐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30955,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"神堤","author":"何在田","text":"呜呼，河伯不仁。\n令受民于天子，戕吾民，令宁当以身。\n民为鱼兮，令不忍独生。\n长鲸利齿饥蛟舞，欲诉冯夷逢帝怒。\n可怜恨比沧溟深，碧血空斑堤畔土。\n令有一片心，不化精卫魂，化为砥柱坚。\n精卫只解衔木石，砥柱万古回狂澜。\n呜呼，古之名贤率以死守职，公独不幸而罹不测。\n君不见汉王尊、宋苏轼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30956,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"兴济闸观打鱼","author":"边向禧","text":"兴济闸头闻水鸣，鸣如殷殷轰雷声。\n大河之势赖此泄，飘沙卷沫东南行。\n大鱼小鱼随巨浪，赤鲤腾出何倔强。\n逆流泼剌石齿间，力抵龙门欲西上。\n渔人两岸竞呼呶，人势人声争相高。\n施罛濊濊更手捕，吁嗟尔鱼何由逃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30957,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"舟发兴济","author":"王曰乾","text":"万籁无声夜寂寥，扁舟独上气飘萧。\n稀星数点孤云静，横笛几声明月高。\n蜃气有形空结彩，鲸波无浪不惊涛。\n悠游鹢首乘风去，肯让谁人驾巨鳌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30958,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县晚泊","author":"陈奉兹","text":"澄波滋落晖，潞水引早秋。\n近舍光欲敛，远墟照未收。\n瞻林会归翼，吾亦泊其舟。\n软莎如壁毯，居人分坐俦。\n老翁弄其孙，嬉笑时抱头。\n水边委剉草，同伺驴与牛。\n月出凉风来，长禾动悠悠。\n城郭去京远，不识见吏愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30959,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"兴济","author":"王实坚","text":"系缆登荒墟，微风吹柳树。\n人家两岸村，依依临古渡。\n磨灭有遗碑，彷徨不能去。\n落日牛羊迹，一带空城路。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30960,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雨宿青县","author":"董潮","text":"归棹争湍急，篙人薄暮喧。\n收帆依野渡，贳酒问荒村。\n细雨芦中艇，疏灯柳下门。\n孤城寒色起，吹角易黄昏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30961,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县二首 其一","author":"管干珍","text":"闻说东堂堰，乾宁制未湮。\n沙平半篙浅，潮落两堤真。\n粳稻田多石，蛟鼍窟近人。\n岂无何刺史，耕凿重忧民。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30962,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县二首 其二","author":"管干珍","text":"卫水东南入，奇云列阵炎。\n河形赤龙曲，堤样老鸹尖。\n滩荻消残垒，村醪认旧帘。\n可能苏涸辙，裕课擅鱼盐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30963,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"流河即目","author":"祝德麟","text":"孤舟入流河，难可穷端倪。\n将南复指北，飘转樯竿旗。\n风色忽首尾，日光无东西。\n团团蚁旋磨，历历人扶犁。\n布帆一何劳，上落千百回。\n弯腰众水手，邪许声能齐。\n舷欹舵每侧，退懵进亦迷。\n未觉岸流转，时见行树移。\n客子不识路，但恐舟行迟。\n来船亦如此，彼犹顺水推。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30964,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"兴济守风寄沧州分司钱梅簃","author":"孟淦","text":"已入长芦境，摇摇驻远舟。\n空林风力壮，拍岸水声遒。\n中酒三更月，怀人一枕秋。\n天涯同有梦，曾倚笛床不？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30965,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县复雪三叠前韵","author":"王汝璧","text":"粉本重描孰画师，梦中白凤好相随。\n夙沙揽海天为合，析木扬葩月又离。\n岂曰无衣思爱日，已占有庆乐耕时。\n闲情更忆梅梢碟，玉冷香温感鬓丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30966,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"抵流河驿等驿前高阁","author":"顾宗泰","text":"崚阁俯清州，凭栏极远眸。\n云迷三淀水，日落九河流。\n独倚晴空外，真宜最上头。\n振衣风浩荡，长啸兴偏遒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30967,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县道中","author":"顾宗泰","text":"峭帆亭外水，故道是交河。\n细土围高堰，平沙荡素波。\n寻源通渤澥，别派合滹沱。\n却忆中山近，何从望翠螺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30968,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县","author":"顾宗泰","text":"西山闻说翠为屏，每向云头望远青。\n修竹茂林堪避暑，落帆何处峭帆亭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30969,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"永安舟次遇南陵王春台同年出示湖上读书图属题因赋赠","author":"顾宗泰","text":"峭帆亭外西山青，峭帆亭下交河明。\n与君相逢快握手，依然烟水寻鸥盟。\n维舟并坐绿杨岸，向晚天风起清汉。\n却怜同是江南人，乡关极目□云断。\n多君示我湖上图，花潭松堰交萦纡。\n彷佛此身置丘壑，幽栖那羡壶公壶。\n我本闲情爱空谷，欲到春城访春谷。\n朗陵叠翠仙螺环，崎湖荡碧香流曲。\n岂知近岁羁天涯，水乡不得长浮家。\n燕南赵北苦驰逐，云山兴发徒咨嗟。\n即今掉头始归去，良知忽聚潞河路。\n一披画卷开心颜，便拟渔村永晨暮。\n明发风催远道舟，清游□到水西头。\n陶园三径知如昨，添得晴湖菡萏秋。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30970,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"自兴济抵沧州","author":"顾宗泰","text":"十里过花圃，沧州又目前。\n燕齐疆欲断，恒卫水犹连。\n平壤芦间屋，回堤柳外船。\n盟亭何处所，怀古托云烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30971,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县盐河晓渡","author":"郝懿行","text":"帆驶下盐艘，晓风喧客舟。\n一篙点水过，错认是轻鸥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30972,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县口占四绝句 其一","author":"李銮宣","text":"老鸦堤外路三叉，芳草裙腰绿意斜。\n几日风光过上巳，村村开遍小桃花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30973,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县口占四绝句 其二","author":"李銮宣","text":"晓添春水一痕青，布谷催耕隔岸听。\n谁买笭箵舣沙嘴，风来吹过峭帆亭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30974,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县口占四绝句 其三","author":"李銮宣","text":"榆荚纷纷绿上墙，茅檐一角絮云凉。\n老农赤脚儿爬背，盘古祠前坐夕阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30975,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县口占四绝句 其四","author":"李銮宣","text":"一双一双堠当门，录曲横桥堠外村。\n昨夜东风吹雨过，曲尘飞到柳黄屯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30976,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"登流河驿奎光阁","author":"李銮宣","text":"三层画阁郁崔嵬，薄暮登临醉眼开。\n燕蓟云山趋海尽，沧溟风雨挟潮来。\n了无宦兴红尘倦，剩有余生白发催。\n独立苍茫赠感慨，背人鸥鹭莫相猜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":30977,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]