[{"title":"重阳后三日再集采友堂","author":"吴绮","text":"元卿夜启关，蜡屐集花间。\n月静群鸦息，天高一雁还。\n世情逢酒淡，客计向秋闲。\n更有西山约，枫林叶正斑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6119,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠雨青上人","author":"吴绮","text":"支公能好鹤，闭户托香林。\n庭树一何静，湖光相与深。\n帆开知雨霁，磬响落檐阴。\n我自劳劳者，逢君生远心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6120,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"归云庵夜泛同愚山阮怀诸子","author":"吴绮","text":"山晚离城远，寒新怯暮游。\n乱峰争落日，一径入深秋。\n清兴因官懒，诗名借客留。\n何时能解绂，终夕对沧州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6121,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"泊八里滩","author":"吴绮","text":"渐远青塘路，篷窗懒更开。\n山烟孤塔回，湖色乱帆来。\n吾道存书卷，余生托酒杯。\n寄言鸥鸟伴，从此莫相猜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6122,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"同云止过石公房","author":"吴绮","text":"寒蕉拂拂与窗齐，老碧新香坐欲迷。\n一钵软烟梧子饭，半锄凉雨菊花泥。\n闲支短杖调饥鹤，学定空床过午鸡。\n却愧好山从结梦，明朝秋句不堪携。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6123,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送石潭归里","author":"吴绮","text":"雪尽垂杨已渐深，临歧折赠欲沾襟。\n三同身世兼忧喜，四杰才华半古今。\n严谴原非真主意，贫归长系故人心。\n东门一送飞旌远，庄舄凄凉有越吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6124,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夏日清啸楼晚望","author":"吴绮","text":"偶寄闲身不当归，凭栏尝对水烟微。\n鸟追斜日穿虹去，龙斗惊雷挟甫飞。\n近海潮声秋隐隐，过江山色晚依依。\n芦中鼓枻无人在，憔悴乾坤一钓矶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6125,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"红鹅馆纪事","author":"吴绮","text":"疏懒偏宜近墨庄，披衣侵晓过林塘。\n桐阴照槛客窗绿，荷叶满池人语香。\n江雨欲来鱼竞喜，山风忽动鹤先凉。\n不辞永日摊书坐，索有邻家煮柘浆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6126,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"再至金陵和田纶霞","author":"吴绮","text":"频年飘泊竟无成，百不如人笑老伧。\n学道几经居药市，著书从欲赋《芜城》。\n原难富贵宁须悔，便作神仙未免情。\n五岳纵游何不可，那堪重入旧瑶京。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6127,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"东岳 其一","author":"梅清","text":"作镇纪崇望，应星协神区。\n乃憔群岳宗，盘礴临东隅。\n峻哉何巍巍，悬磴垂云衢。\n半壁俯全鲁，远影缭勾吴。\n我来春夏交，瑶草方芬敷。\n始临一嶂断，忽出众壑殊。\n次第开天阊，海色万里舒。\n树挂飞蜃长，石蹋扶桑孤。\n羡门如可招，挟翼将同驱。\n乃知灵境别，旷览良不虚。\n冥怀入神明，喟焉思真符。\n风雨若有俟，瑞应岂遂辜。\n方期传遥踪，封禅奏成书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6128,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"东岳 其二","author":"梅清","text":"神宫郁岧峣，曾岩露晶荧。\n遥望飞甍高，惊指朝霞升。\n陟磴耀流目，跻庭肃群心。\n我欲问太乙，陈词叩幽沈。\n射牛典既遐，瘗玉迹亦湮。\n俯仰眷春祺，惟此褕翟尊。\n范金焕宝服，色映河汉明。\n幡幢何飘飖，侍从罗群星。\n灵贶一以昭，对越拟紫宸。\n厥祀匪徒然，锡胤蕃斯人。\n载协勾萌期，言应郊禖辰。\n灵雨润遥泽，惠风澹群氛。\n浩矣《青阳歌》，长此徽箫笙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6129,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"石公从黄山来宛见贻佳画答以长歌","author":"梅清","text":"我陟岱宗三万丈，倒瞷扶桑起泱漭。\n手摘片云归江乐，梦中缥缈碧霞上。\n碧霞峰正青，忽然接黄海。\n石公贻我图，恍惚不可解。\n绝巘阴森四壁寒，云峦窅冥惊漫漫。\n玉屏五老争拱立，海门九龙纷乘骖。\n骤疑仙峤合，转讶真宰通。\n卧游当岳表，乃在天都峰。\n天都之奇奇莫纪，我公收拾奚囊里。\n掷将幻笔落人间，遂使轩辕曾不死。\n我写泰山云，云向石涛飞。\n公写黄山云，云染瞿硎衣。\n白云满眼无时尽，云根冉冉归灵境。\n何时公向岱颠游，看余已发黄山兴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6130,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画杂诗 其一","author":"梅清","text":"寒云寒树护山家，岩壑无人一径斜。\n策杖行吟独惆怅，几枝春色到梅花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6131,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画杂诗 其二","author":"梅清","text":"秋空漠漠晓岚清，落木萧萧野水平。\n愁向疏林停短棹，天边鸿雁最关情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6132,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画杂诗 其三","author":"梅清","text":"上去江陵下石城，乱帆都向夕阳明。\n诗人好为江干写，莫使青莲独擅名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6133,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画杂诗 其四","author":"梅清","text":"朝来松响拂溪流，六月寒声似晚秋。\n不是临湖亭上客，谁容此下一科头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6134,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画杂诗 其五","author":"梅清","text":"为怜叔夜并怜松，写入生绡对影重。\n但使抚弦能作调，何须遥问赤城峰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6135,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"琴溪","author":"梅清","text":"高士遗台东涧东，俯临百尺之飞虹。\n云卷云舒绝壁下，花开花落空潭中。\n丹砂炼去山俱寂，赤鲤骑归路不通。\n叹息往来车马客，几人招手问琴公。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6136,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画答堵廉生","author":"梅清","text":"君乡谷水清无敌，酌水时时更忆君。\n寄问松风双塔静，可能忘却敬亭云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6137,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"午夜歌","author":"梅清","text":"瞿硎山上鹤长飞，瞿硎山中人未归。\n苍松依石坐吹笛，白云好我沾裳衣。\n白云自流日将暮，花枝冥冥隔溪路。\n腾身直上东山头，骑鹤乘风欲飞去。\n仙人久别今当还，清宵忽渡海中山。\n到来拍肩更相笑，万岁一朝如等闲。\n刁斗击精悍，歌舞杨芬芳。\n空岩无事此良夜，人间欢怨争茫茫。\n人间欢怨争茫茫，午夜夜时谁短长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6138,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"越中漫兴","author":"梅清","text":"秋风一骑越山清，客路东来移我清。\n梅市逢人仙是吏，乌程作县酒为名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6139,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"马草行","author":"查诗继","text":"铁甲三千动地来，马蹄杂沓如轰雷。\n军有供顿马有谷，县官奔走如奴仆。\n刍茭比屋困诛求，府胥索钱不即收。\n君不见江山城头新鬼哭，招魂无人乌啄肉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6140,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"炮夫行","author":"查诗继","text":"十月王师捕山贼，县官追呼炮夫急。\n一六当头领雇夫，百夫押以衙兵十。\n此行只向乌伤去，不比骊山送徒戍。\n况复王官如父兄，蓑笠糇粮为尔具。\n恶少奸胥暗结连，一夫索钱八十千。\n讹言街巷声喧阗，幕府飞箭龙旗鲜。\n阴雨泥泞满天黑，村邻有夫招不得。\n素封华屋尚张皇，小户单丁躯命逼。\n县官见此中心哀，走谒太守申藩台。\n输金雇役从民愿，税户欢呼打桨回。\n记得前年十月半，仓前粮艘帆影乱。\n只今米烂未输租，又值役夫连海岸。\n父母咨嗟望太平，少年喜见烟尘生。\n衣租食税寻常事，拜将封侯无尔名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6141,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"后炮夫行","author":"查诗继","text":"岁莫喧喧夜捉人，当门县尉点行频。\n押送江干下江舶，王牌忽下哀劳民。\n蒙恩欢噪声动地，得钱脱役夸亲邻。\n谁知羽书传旦暮，王师仓猝西兴渡。\n桃符竹爆空酸辛，菜饵饤盘将不去。\n雨雪江山烟火稀，白骨支撑满前路。\n行到金华呈太守，幕府无文停待久。\n白昼呼群掠远村，醉围解尉攒拳殴。\n解尉獐徨无羽翰，科钱营脱离险艰。\n黠徒乘机从此逝，追至兰溪半不还。\n县差承帖追逋目，鞭笞狼籍空劳鹿，归时老幼尽欢欣，重去难将消息闻。\n男儿轻死贵死敌，何不弓剑学从军。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6142,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"后马草行","author":"查诗继","text":"四百八十炮夫行，马草十万连催征。\n县官怜民省民解，牌差敛费纷纵横。\n前年解钱塘，今年解信安。\n信安山多稻草少，户口流亡断飞鸟。\n营盘草多要折钱，解吏索钱还索草。\n去年湿草烂江干，草户于今杖血丹。\n安得马嘶息海岸，樵歌出村闻夜半。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6143,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梅下望家信","author":"曾畹","text":"又觉春风到，梅花信不来。\n陇头赫连国，庾岭郁孤台。\n地以青天接，书难白首开。\n暂收边徼泪，长啸大江回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6144,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和黄冈杜于皇澄江赠诗","author":"曾畹","text":"此生犹见汝，幸汝不佯狂。\n身世看秋箨，乾坤正夕阳。\n台城穷彻骨，夏浦饱经霜。\n谩说工诗赋，青钗鬓发苍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6145,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丙申自秦中归送弟烂就耕乌石陇","author":"曾畹","text":"每羡西周古，千家尚力耕。\n高原无奥草，春日少人行。\n袯襫空山满，衣冠乱世轻。\n鹿门归去好，闭户有松声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6146,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晴川阁","author":"曾畹","text":"大别排云住，楚山一望开。\n乱流争岁月，孤屿下楼台。\n高浪沱潜出，夕阳嶓冢来。\n湖南征战苦，几处角声哀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6147,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠顾松交吏部","author":"曾畹","text":"直觉东归似故乡，每逢佳节就君觞。\n客中文宴如羊曼，吴下名园数辟疆。\n芳草画凝歌扇绿，落花春散舞衣香。\n东山未许频游玩，早晚徵书发建章。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6148,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸣沙洲","author":"曾畹","text":"不见黄河春气动，却从沙碛辨阴晴。\n流澌著水天皆冻，大漠无风山自鸣。\n饮马浪寻荒烧窟，射雕贪出苦泉营。\n传闻烽火年来息，张轨隗嚣已尽平。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6149,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题万年少年伯显西草堂","author":"曾畹","text":"歌风台下夜乌啼，郁郁山庄古木齐。\n半亩桑田人去住，一湖春水屋东西。\n星临丰沛瞻龙龙，地接青徐杂鼓鼙。\n独把渔竿恁月钓，门前草色正萋萋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6150,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"易州新使院咏松","author":"王泽宏","text":"去年手植新松树，碧叶青枝取次阴。\n干长凌云应有日，后人谁识岁寒心？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6151,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"买花","author":"王泽宏","text":"卖花担上露才乾，野老移来满药阑。\n抛却故山花事盛，翻来燕市买花看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6152,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过合州","author":"罗为赓","text":"放舟天未晓，梦醒日初晴，云绘远山色，江流急雨声。\n岸沙留虎沙，炊霭见荒城，在昔繁华地，荒凉感客情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6153,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"去榆次县作","author":"林尧华","text":"敝庐风雨足苔矶，句漏寻砂觉昨非。\n菱米有租充石鼎，荃丝为布剪山衣。\n诗情独往蚕抽茧，酒兴频年鹢退飞。\n闻道闽南开市舶，过江通印子鱼肥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6154,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闻笛","author":"李瑨","text":"晚霁江城夜气清，寂寥孤月对愁明。\n谁携羌塞三更笛，吹作吴山十月声。\n岂有梅花开更落，自惊杨柳折还生。\n天边旧业归何日，为尔今宵梦不成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6155,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"榕城杂咏","author":"李瑨","text":"民力东南久驿骚，尚闻飞舰欲凌涛。\n将军自许标铜柱，长吏谁曾过石壕。\n萏草夜呼朝市闭，海田春隔缭垣高。\n何当借箸筹方略，原罢乘风破浪艘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6156,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"别孙无燂","author":"李瑨","text":"甓社棠阴晚未残，相逢谁复问南冠。\n令君座上香三接，公子门前铗几弹。\n久客未闻生马角，累人何止愧猪肝。\n拟将千尺珠湖水，深比桃花一样看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6157,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"集徐文在山园","author":"陶?","text":"草堂倚绝巇，山色映朝晖。\n晴日凝花气，香风到客衣。\n霜崖丹树回，竹径碧云飞。\n况是登高节，长吟坐翠微。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6158,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"同诸子游石梁时张九夏不至","author":"陶?","text":"丹崖万仞倚天高，临水登山托彩毫。\n金岭秋风驰列骑，石梁落日挂寒涛。\n刘根自是乘霞客，子晋宁嫌控鹤劳。\n窃怪季应招不至，憨然亭下续《离骚》。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6159,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日送戴山民游豫章","author":"孙中彖","text":"北山高枕卧烟梦，送尔长征感慨多。\n猿狖夜啼孤岭月，鱼龙秋静五湖波。\n尊前怨别携吴剑，客里惊心听楚歌。\n若上滕王高阁望，西山南浦近如何？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6160,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"苕城雪中归棹","author":"陈忱","text":"孤城门未启，风雪一舟停。\n村店茅柴酒，官塘牧马亭。\n逼寒头转白，仄岸草犹青。\n岁晏归心迫，乡音易动听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6161,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渡江","author":"蒋玉立","text":"江流九派尽朝宗，六代繁华怅旧踪。\n千里云浮瓜步树，片帆风送蒜山钟。\n莺花半落愁边过，烽火频年客里逢。\n五岳尚赊他日原，何时汗漫一相从。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6162,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄魏交让","author":"蒋玉立","text":"青郊结伴共相招，白社风流尚未遥。\n日暖莺声闻柳陌，春深花落转兰桡。\n骚人自纪庚寅岁，旅客重过丁卯桥。\n我念离群空对月，怀君江上影萧萧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6163,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"依韵酬念祖弟归应省试","author":"陈凯永","text":"河桥折柳怅难留，且试驱车历九州。\n芳草平沙逢驿骑，斜阳深树见山楼。\n洛中已识《三都赋》，江上休披六月裘。\n桂子秋风应早发，好携彩笔渡金沟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6164,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海淀","author":"田种玉","text":"清秋人意豁，引兴到郊西。\n金谷昔辉映，濠梁今品题。\n插天石剑矗，指地柳丝齐。\n静悟疑身隐，荷香满袖携。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6165,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送吴次公游蓬莱兼呈沈留侯","author":"徐旭龄","text":"为厌风尘作客难，且依仙吏策轻鞍。\n燕台碧树云初转，秦望神芝露未乾。\n岂有侯门怜骏骨，好从海客问金丹。\n酒徒去住忽无定，离思中宵月里看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6166,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晚钟","author":"图尔宸","text":"梵放忽然寂，前山闻暝钟。\n声催斜景入，路隔翠微重。\n老树警眠鹤，空波迎古龙。\n予心澹无虑，真欲契禅宗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6167,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晚步","author":"图尔宸","text":"野色初开宿雾清，晚晴天气嫩凉生。\n半陂新水鹭莺立，一架落红鶗鴂鸣。\n霁后烟痕连树碧，雨余虹影接霞明。\n蒋生三径无人到，怊怅行吟句未成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6168,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送张越青给谏终养归里","author":"史大成","text":"是处归春雁，乌飞犹上林。\n多君爱日疏，先我望云心。\n臣齿幸还少，主恩良自深。\n望尘追可及，策马莫骎骎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6169,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"范潞公去官归里","author":"史大成","text":"山色故园好，妒君归及春。\n诗从携杖得，名以去官真。\n林笋甘于蜜，湖莼绿似蘋。\n试看纸尾署，谁不叹风尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6170,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"观风台","author":"杨雍建","text":"城上高台接混茫，天都风物郁苍苍。\n云封雉堞千村绕，地并乌聊六水长。\n见说春溪仍乐土，安知歙浦一残疆。\n黄峰极目徒相望，赢得愁思满客囊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6171,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日登宏济寺","author":"李赞元","text":"纵览旷无际，长江一望深。\n危亭穿石罅，密树散春阴。\n帆影当窗暝，钟声入浦沉。\n盘桓千仞上，徙倚自长吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6172,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"锡山晚泊","author":"李赞元","text":"片艇寻幽胜，溪行几曲湾。\n夕阳微照水，雪影尽归山。\n汀鹭河边去，渔舟浦外还。\n旗亭何处问，树下绿阴闲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6173,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"吴耕方招饮观菊","author":"孙光祀","text":"秋光澄几牖，入夜有余清。\n丛菊绚屋壁，环向各为情。\n华镫更交辉，群蕊滋晶莹。\n徵歌引羽商，箫管问瑶笙。\n曲缓落轻尘，缥缈度新声。\n气静欲息机，那复世味撄。\n嗟彼利禄客，役役多所营。\n何如付澹忘，杯酒慰平生。\n微醺醒归路，天半斗参横。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6174,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"与郝雪海徐孟枢同事武闱赋赠","author":"孙光祀","text":"纵谈晨夕慰如何，柱史忧时感慨多。\n谁靖烽烟蟠地轴，拟攀星汉洗天河。\n空闻甲胄盈边垒，可有熊罴入网罗。\n但愿四方销战伐，无劳圣主《大风歌》。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6175,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"曲阜晚眺和朱竹垞韵","author":"刘芳躅","text":"孔庭释菜后，携客步莓苔。\n牺象汤孙彻，金丝鲁殿开。\n牲碑工拓就，蓍草马䭾回。\n愧少《春秋》癖，言旋罢讲台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6176,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送单牧之赴任灌阳","author":"綦汝楫","text":"建陵迢递半年程，灌水争如密水清。\n月静千家闻虎啸，峰回万树听猿声。\n依人翡翠巢官阁，夹道桄榔接驿城。\n报最何劳三载久，于今南国已休兵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6177,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"移居邻王茂衍方伯","author":"綦汝楫","text":"薄宦居难定，移来思不穷。\n高楼晴有月，老树夜多风。\n阅世游将倦，怀乡梦欲通。\n南邻词赋客，恬澹此心同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6178,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"东郡七夕立秋","author":"张惟赤","text":"光岳楼前暑气收，断云疏雨送扁舟。\n关河暝色催砧近，海岱烟岚入树浮。\n天上双星方渡汉，人间两鬓又惊秋。\n明朝玉笛声凄切，风起黄榆白雁愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6179,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"书砦居屋壁","author":"梁熙","text":"阴气昏白日，冻雀噪暮枝。\n徘徊如有待，纡徐掩户迟。\n念昨愁不寐，悬席透夜飔。\n隙月点霜被，病骨冷难支。\n断墙集野砾，遂若惬幽私。\n烧灯拾僵蠹，竹素欣相披。\n侧身还怅望，儒术欲何为。\n土壁摇寒影，萧条十年思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6180,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]