[{"title":"塞外","author":"述明","text":"五月犹飞雪，三春未见花。\n炎风初解冻，夏草渐萌芽。\n画角寒声迥，旄头白气斜。\n楼兰如未斩，不敢顾身家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10687,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丁酉春日感题","author":"拉歆","text":"隔岁遗愁在，经春改旧容。\n世情催白发，老态倚苍筇。\n门静无新客，心空有暮钟。\n百年成底事，漫作蜜巢蜂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10688,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"席竟送客过图逸叟蔬圃观静涵逸叟弈复共问亭阅案头说铃日暮始归","author":"讷尔朴","text":"屐痕杖影乱斜阳，相送无心出短墙。\n散步井床苔径滑，观棋邻圃柳阴凉。\n客伤旧事裁新句，我拟愁城筑酒乡。\n回首柴门分路处，满城雨气正微茫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10689,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"连雨次答方问亭","author":"讷尔朴","text":"无端霪雨经旬阻，倍觉凄清到客居。\n径碧痕犹残藓在，裀红香渐落花如。\n蓄鲜罢剪园中韭，防湿间移枕畔书。\n沦茗濡毫都不耐，课童屋角种新蔬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10690,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山寺闲步","author":"珠亮","text":"地僻景逾静，霜寒菊更幽。\n间阶徐步处，览尽一庭秋。\n远岫随云杳，清泉带月流。\n微吟情不倦，风物足淹留。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10691,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九日登山","author":"明泰","text":"归雁背寒飙，阳卉摧霜雪。\n辍策登高冈，张组酬嘉节。\n谁言酒一尊，可解肠千结。\n放眼足愁人，感时易伤别。\n风尘天地暗，故旧音书绝。\n乡关万里遥，斜日烟中灭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10692,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日东郊晚步","author":"明泰","text":"禾登野色宽，叶落孤村冷。\n山径牛羊下，柴门鸡犬静。\n时有暮归人，历历月中影。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10693,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怀来遇雨","author":"明泰","text":"飒飒来凉吹，浓阴去径迷。\n烟横高树断，雨压远村低。\n斜日明山外，归云过水西。\n遥知城市近，风定乍闻鸡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10694,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋村","author":"明泰","text":"旅雁湖天足稻粱，薄寒终日据匡床。\n薜萝月小门深掩，蟋蟀声多夜乍长。\n到处田塍收稼穑，谁家砧杵捣衣裳。\n先生那有经秋计，只对黄花略举觞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10695,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"仲春漫成绝句","author":"明泰","text":"芳草依依没旧痕，望中新柳识山村。\n余寒任在东风里，燕子来时不闭门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10696,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"别徐郎子昆季同学 其一","author":"贾朴","text":"二徐潇洒顾空群，屈宋清华班马薰。\n此后蛮烟缭绕处，也应重忆旧论文。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10697,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"别徐郎子昆季同学 其二","author":"贾朴","text":"文字数行千载期，丽江晨夕少人知。\n而今话别添惆怅，翻恨与君相遇迟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10698,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九日游峄山入洞过石梁登自山最高顶","author":"王元枢","text":"峄峰累嵯峨，秋磴纡回互。\n履节展高兴，呼侣逐幽步。\n鱼贯下曲窦，猱攀凌窄路。\n沈入沓书冥，渐出豁天曙。\n巨石忽硉矹，夹溪相牴牾。\n飞梁悬千仞，微命争一度。\n过险悔轻蹈，定性却重怖。\n默默立巉岩，遥遥肆指顾。\n感秦失乐石，怆纪余荒墓。\n兴废由化迁，年寿谁云固。\n安得偕云车，长与列风御。\n何必采茱萸，褰裳湿寒露。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10699,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"太白楼","author":"王元枢","text":"秋色围城郭，高楼尽一攀。\n廛连原上树，村带雨中山。\n我忆孤臣迹，时看落日间。\n可怜大河水，不舍下长湾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10700,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怡园","author":"王元枢","text":"寂寞金谷旧，空庭容我过。\n如何乔木里，偏是冷云多。\n花气沈秋水，山光动女萝。\n珠帘犹未卷，夜夜想笙歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10701,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠吕雨村鹾使犹龙","author":"金南锳","text":"河东后裔五作相，文安代兴美寅亮。\n华岳钟灵毓大贤，董鹾复尔临湖上。\n经文纬武莫与伦，双鹿夹毂豹为茵。\n画戟半笼红玳瑁，花槽都束翠麒麟。\n缁衣之宜雅好士，案牍余间订经史。\n赏心岂肯涉点尘，促膝时闻疏奥旨。\n廨西新辟亭三楹，翛翛竹色攒空青。\n寿母板舆御春日，至乐何减登蓬瀛。\n公为天子东南镇，十七郡人赖忧轸。\n行将丹诏入黄扉，指挥庶绩皆平允。\n湖涯贱子旧生徒，十年枯坐据槁梧。\n蠡瓢耐可探玉海，蓬心犹许对冰壶。\n此中真意世莫识，惟有香风吹赤舄。\n大厦帡幪构万间，怀恩不独平原客。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10702,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晓发口占","author":"张学林","text":"又复冲寒去，鸡声引铎声。\n喑尘人迹起，残雪马头明。\n裘敝犹堪恋，装轻不碍行。\n岁华宁足叹，辛苦是平生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10703,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夹山竹林寺","author":"鲍珍","text":"谽谺通积翠，一径抱幽岑。\n白日下松杪，清风满竹林。\n山空奇奴迹，泉响戴颙琴。\n茶话忘归去，沧江暮霭深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10704,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"张文献公祠","author":"鲍珍","text":"唐相经营地，灵祠灌木围。\n笏囊人共羡，羽扇恨偏违。\n望祭神雅集，焚香海燕飞。\n千秋金鉴录，风度想依稀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10705,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惶恐滩","author":"鲍珍","text":"江雾失山晓，乾坤一混茫。\n高滩荻苗冷，微雨豆花凉。\n牛马渺难辨，鱼龙深自藏。\n不须说惶恐，前度已神伤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10706,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宿楼贤寺","author":"鲍珍","text":"三日游庐南，遍历诸中寺。\n虽未造其巅，亦颇称快意。\n栖贤剧幽遐，李渤读书地。\n五老翼然临，石人宛相企。\n秋深叶缀红，林密烟含翠。\n坐卧云绕衣，溪声裂檐际。\n冰霜冷衾裯，钟磬清梦寐。\n凌晨礼世尊，一探珠阁秘。\n老僧启塔函，示我佛舍利。\n玉瓶托金盘，光芒骇魑魅。\n日精与月华，不可以思议。\n膜拜袒右肩，白椎参妙义。\n我抱禽向情，未脱周何累。\n每耽方外游，依依不能置。\n何时遂初心，料理出世事。\n作佛似可图，勇迈何骠骑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10707,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日有事学宫同冯校官登尊经阁次日雨中奉寄","author":"鲍珍","text":"春阴日日涵朝晖，山城睥睨如重围。\n匆匆已过二月半，暖风扑鼻香馡馡。\n讼牒台符厌遮眼，赏心乐事殊疏稀。\n偶尔间过矍相圃，广文馆静忘尘机。\n梓红主人最心契，舟旋无厌相依依。\n踏阁攀林兴不浅，凭陵百尺穷纤微。\n五峰绵延互钩带，长松野竹连渔矶。\n溪水靴纹蘸新柳，梨花傅粉桃施绯。\n指顾胸眸坐开豁，如蚕出茧马脱鞿。\n俄晷留连日卓午，归来逸兴犹遄飞。\n懊恼春工裂风景，昨朝物态今全非。\n无事垂帘听疏雨，陌头狼藉愁芳菲。\n数盎幽兰作清供，思君闭户摩编韦。\n《五经》纷纶较同异，门生蓝舆应多违。\n拟从渔父借龙具，五湖长往毋庸归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10708,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"范忠贞公祠","author":"鲍珍","text":"当年闽海见传烽，犀兕空多弃甲重。\n大节并推颜鲁国，孤忠直继段司农。\n碑题岘首留残碣，世握兵符踵旧封。\n应与睢阳同庙食，堂堂授命尽从容。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10709,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晓坐还元阁望渔洋山","author":"鲍珍","text":"僧楼借床眠，宵残听粥鼓。\n清盥据梧坐，山翠飞入户。\n夙慕渔洋名，常如梦天姥。\n夜来看不足，朝窗笏更拄。\n宛将螺子黛，镜中画眉妩。\n《法华》虽附丽，卑之奚足数。\n忆昔王尚书，好事鲁掠取。\n至今竟属公，湖山号宗主。\n譬诸冶城墩，风流擅千古。\n自来称王谢，后先堪接武。\n平山一瓣香，敬为先生许。\n典型犹在望，苍茫云缕缕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10710,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"集曲云别业","author":"余国?","text":"远市人声绝，几家双树西。\n看花同蝶过，怯暑逐风栖。\n景落庭空静，心孤鸦自啼。\n晚樵林际出，相唤浴晴溪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10711,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠别沈方舟","author":"赛音布","text":"溪云随天风，聚散不可常。\n越鸟东南飞，谁能忘故乡。\n命酒结欢娱，晤言心徬徨。\n会合人自好，离别人自老。\n仰瞻双飞翼，颉颃向晴昊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10712,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"野店","author":"赛音布","text":"暝色带行旅，一镫方照门。\n黑沈关塞路，孤著别离魂。\n溪月射梁白，山风吹树喧。\n客心与寒鸟，忽忽欲飞翻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10713,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日过万枫庄","author":"赛音布","text":"愁能花处失，病每酒边强。\n杖策远宁惜，扶儿醉不妨。\n闲云归有处，野鸟下无方。\n尚忆陶彭泽，生涯尽一觞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10714,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重阳后一日独酌","author":"赛音布","text":"朋赏一时尽，寒花不改芳。\n老夫能复醉，今日亦重阳。\n沧海风波阔，青云鬓发苍。\n萧然安退路，三径意何长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10715,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋郊","author":"赛音布","text":"犬吠茅茨见掩扉，数家村落澹斜晖。\n寒生绝塞征鸿急，秋入平原猎马肥。\n野火远摇荒堡动，水云低傍禁城飞。\n蓟门自古风霜早，八月萧萧木叶稀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10716,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"早秋有客过访村居","author":"赛音布","text":"湖天高卧动经年，酌客高吟桂树篇。\n有地漫开徵士径，无家聊种故侯田。\n蒹葭玉笛秋云远，埤堄金笳暮景悬。\n碧草锦湍明石路，杖䔧相送出墟烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10717,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"小楼","author":"胡星阿","text":"银河欲坠花影湿，小楼夜半东风入。\n绣帘卷断金凤凰，玉人独抱凉蟾泣。\n琐窗往来云气旋，双成驾龙出紫烟。\n粉蛾空老屏风边，有石莫补离恨天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10718,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"瞻云街 其一","author":"胡星阿","text":"瞻云街左旧人家，望断春风去路赊。\n一自倚帘吹柳絮，至今和雨梦梨花。\n层轩绮月抛红豆，苦竹江烟怨绿华。\n瑶草玉沙仙洞晚，小桃空落半溪霞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10719,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"瞻云街 其二","author":"胡星阿","text":"瑶窗屈曲倚崇阿，金染斜阳碧染莎。\n帘幕晓寒鸠雨细，池塘春静燕泥多。\n桂旌冉冉迷湘竹，莲步盈盈隔汉波。\n为问画楼西畔路，花香月色近如何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10720,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"楼上","author":"胡星阿","text":"楼上银河冻不流，后房圆帐鹔鹴裘。\n红栏碧树寒相倚，露索烟铃语未休。\n枫峡晓云神女去，芝田残月魏王游。\n金蟾睡稳桑枝暗，花雾空成一夜愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10721,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闲居","author":"关舒","text":"无才甘放弃，身世已蹉跎。\n筑室山花满，应门水鸟多。\n塞翁殊不尔，蕉鹿竟如何。\n咄咄千年事，行吟一曲歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10722,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"飞帛涧","author":"峻德","text":"我昔登此山，山中觇泉脉。\n有涧如疋练，高挂倚天壁。\n劈开万仞青，直走一痕碧。\n炎天雪霰飞，晴日冰雹射。\n今来值时旱，深山愆雨泽。\n又开龙用壮，攫碎苍岩石。\n此涧为壅塞，滴沥只微液。\n无复旧时观，苔存水流迹。\n时有松鼠来，就饮足局蹐。\n风吹堕松花，鼠惊窜崖隙。\n安得三日霖，复见泉百尺。\n清夜对弹琴，山月照虚白。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10723,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"立秋前一日有怀大钵子","author":"峻德","text":"明日届商序，惄焉凄在怀。\n微风动高叶，残雨堕空阶。\n往事不堪问，孤情孰与偕。\n吾宗念之子，高咏坐秋斋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10724,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怀佟咸亨使杭","author":"峻德","text":"一自轻帆挂早潮，武林烟月梦迢迢。\n不知红藕花开日，船泊西湖第几桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10725,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"立秋日陶然亭即事","author":"额尔登萼","text":"郭门迢递寺嵯峨，落叶声中载酒过。\n地迥方知秋色早，亭幽倍觉好风多。\n林梢斜日开青嶂，槛外游人踏绿莎。\n绝胜西园耽雅集，几回鸟语杂笙歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10726,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"洞房曲","author":"唐芳第","text":"软金屈戌开鸳鸯，花符细字呼徐娘。\n绿云半堕莲花妆，雅鬟十五携履箱。\n琵琶百啭春漏长，娇歌欲递迟龙香。\n临筵催赐青雀觞，海棠滴露低红芳。\n流苏压钩金锵锵，铜球宛转添都梁。\n殢人缓缓收鸣珰，花枝故恼东风狂。\n银屏叠叠遮琐窗，长夜辽辽天未央。\n横娇妒宠谁能望，春光不到翾风房。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10727,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三弟久客历下诗以招之","author":"唐芳第","text":"裂帛书离字，齐东寄旅人。\n可怜池上草，愁杀梦中春。\n稚子饥寒色，慈闱老病身。\n平原虽爱客，莫更久风尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10728,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"华严庵","author":"赵念曾","text":"饭罢下高阁，寻幽临水扉。\n石间乱流出，树里一僧归。\n山鸟怡人耳，池花沾客衣。\n那罗岩窟畔，徙倚恋清晖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10729,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"月夜独步","author":"赵念曾","text":"凉夜泠泠露气清，疏帘竹簟月三更。\n满庭树影无人语，惟有虫声草际鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10730,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠友人","author":"王郊","text":"庭梧暂寄一枝轻，剧饮休歌戴笠行。\n人事到头同水月，世情满眼只簪缨。\n花开谁料能为蜜，絮落何堪又作萍。\n缑岭吹笙音未远，好偕安叟话蓬瀛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10731,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"野望","author":"朱永龄","text":"乡关祇在暮云西，草色连天望不迷。\n去住何劳问蓍蔡，绿杨风里杜鹃啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10732,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"太行山","author":"颜肇维","text":"老松风折半千画，黄叶霜含秋史诗。\n山过孟门成二妙，不禁勒马看多时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10733,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海门雨中望海","author":"颜肇维","text":"海势如涌碧，天地旋不流。\n冒雨登海门，但见白气浮。\n远望天如坼，苍苍别一州。\n疑堕烟雾中，卑云脚下稠。\n昨日郡城出，鸣榔半夜至。\n谁识百川长，三江汇于是。\n设险备倭人，百里门庭地。\n在昔嘉靖时，番舶事初乖。\n波臣蓄逆谋，沧溟变尘埃。\n元戎出山左，时推张韩才。\n一战浙水殷，风吹画角哀。\n地是蜃蛤居，宰今颜氏子。\n栅浦与桃渚，生男多在水。\n走利最轻捷，性命啼涔里。\n麦秀苗蕲蕲，养生惟鱼盐。\n南通闽与粤，粳米转云帆。\n大牙旧相制，分隶事诚难。\n有兵可以守，有田可以屯。\n其顽亦易化，诗书渐相循。\n其居亦易定，官吏如至亲。\n腹里不容枭，环海尽王臣。\n后来官兹土，尚三复兹言。\n君不见临海之山高崒嵂，扶桑之国鲛人室。\n长风万里来，炎天上赤日。\n噫嘘兮，海上阴晴不可必。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10734,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"留别转庵和上","author":"林茜","text":"菜根滋味久能甘，竹径参差倚杖看。\n白雀飞来虽是梦，青山占尽不为贪。\n一窗花影焚香坐，半榻松风抱月谈。\n云散春江孤棹远，愁思还结侣云庵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10735,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠顾工抡代父从军 其一","author":"林茜","text":"匹马弯弓出塞门，黄沙海雾自朝昏。\n风霜鍊就奇男子，为报君恩报父恩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10736,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠顾工抡代父从军 其二","author":"林茜","text":"年少从军古所稀，凯旋仍旧著莱衣。\n自曾博得忠兼孝，常梦愁云塞外飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10737,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"旅夜","author":"刘绍分攴","text":"玉露凉风急，萧然动客情。\n回廊留夜月，落叶飒寒更。\n梦短乡心远，庭空活火明。\n那堪歌《九辩》，万里一孤檠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10738,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"灌县","author":"刘绍分攴","text":"大江真作带，半壁倚青山。\n山势联千嶂，江声彻百蛮。\n鸟鸣红树里，人在碧云间。\n履险今方始，前行玉叠关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10739,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"昭化早发","author":"刘绍分攴","text":"牛头山下傍山城，月照西窗促晓征。\n云水全迷归客路，绿杨阴里一舟横。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10740,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"施州卫寄所亲","author":"夏熙臣","text":"环卫皆君长，东南尽笮邛。\n流官乘小驷，蛮妇织花賨。\n刀剑生睚眦，衣冠列附庸。\n不烦司马檄，尺土亦王封。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10741,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"高处厚先生信宿山中赋此却寄","author":"夏熙臣","text":"收拾看山眼，寻幽到敝庐。\n以君一日长，赠我十年书。\n天外孤云合，雨中夜气疏。\n村醪刚半熟，不醉复何如。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10742,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"读宋史","author":"赵思植","text":"驴背投间学隐沦，蕲王宁不忆君恩。\n忠臣业已成冤狱，大将从今合杜门。\n举目烽烟空怅望，一腔悲愤向谁论。\n归来浪迹西湖上，聊对溪山纵酒樽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10743,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"幽居咏怀","author":"赵思植","text":"几年身住水云湾，赢得浮生日日闲。\n隔断俗尘青嶂外，飞来清景碧霄间。\n虚窗时启邀明月，高阁频登看远山。\n除却诗朋及酒侣，他人莫漫叩双环。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10744,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南斋纪恩诗 其一","author":"王世芳","text":"建子星回斗转寅，居然一百十年春。\n灌花拭竹间中课，问水寻山物外身。\n《击壤》但知歌帝力，炷香惟有感苍旻。\n桑榆筋骨还彊健，历数前因话劫尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10745,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南斋纪恩诗 其二","author":"王世芳","text":"扶杖康衢识圣颜，锦衣有赐诏频颁。\n喜同野老迎鸾辂，优许微臣列鹭班。\n身历四朝沾浩荡，眼看六代舞斑斓。\n赤城便拟蓬莱苑，布袜棕鞋任往还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10746,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨后","author":"徐基","text":"雨洗东坡月色清，溪边委辔听溪声。\n仙心欲捉左元放，大草间临张伯英。\n山下白云横匹素，树头初日挂铜钲。\n人间歧路知多少，欲放扁舟取次行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10747,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄戴宾廷","author":"刘翼明","text":"携手上营丘，春水映春草。\n别来复如何，不信蒹葭老。\n明月生新潮，白石啮古道。\n古道自漫漫，秋水复浩浩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10748,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]