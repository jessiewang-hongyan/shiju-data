[{"title":"如梦令","author":"董如兰（畹仙","text":"云外周轮璧月。\n偏照人问离别。\n音信动经年，几度风霜雨雪。\n愁切。\n愁切。\n想见征衫千结。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23105,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"长相思","author":"董如兰（畹仙","text":"心迢迢。\n路迢迢。\n万木经霜色渐凋。\n秋容如画描。\n卯时潮。\n酉时潮。\n不见归帆傍小桥。\n愁魂销未销。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23106,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 庭梅","author":"董如兰（畹仙","text":"墙角枝头雨雪晴。\n寒葩展靥若含颦。\n蟾蜍今夜十分明。\n细细暗香和梦嗅，椿椿怀抱费思评。\n心头有个未归人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23107,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹧鸪天 雪宵","author":"董如兰（畹仙","text":"旅雁摩霄楼外闻。\n穷途有泪怕留痕。\n风高雪片搏成阵，月暗梅花合断魂。\n书满架，伴空樽。\n床头灯火半黄昏。\n推窗粉饰江山改，爱惜瑶华只闭门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23108,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满庭芳 春日苦雨","author":"龚静照","text":"春昼淹淹，春愁脉脉，娇黄媚紫都非。\n韶华几许，九十半成违。\n风暖水纹如皱，凭栏处、漫浸芳菲。\n残梦醒，云迷雾锁，何处见馀晖。\n追思，曾玩赏，旧时情事，珠泪频挥。\n渐看看成病，减却香围。\n又是清明过也，空赢得、绿惨红稀。\n如萍燕，东西漂泊，不解认人归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23109,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醉花阴","author":"龚静照","text":"粉窖眠香红串泪。\n两眼凝秋水。\n被冷叠鸳鸯，有梦何曾，慰贴心头去。\n碧云冉冉黄花地。\n半晌披帷起。\n担受峭寒生，不奈虫吟，况续廉纤雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23110,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令","author":"蔡捷","text":"方把银缸吹隐。\n绣幕风欹不定。\n好梦总难成，月上花枝交映。\n深省。\n深省。\n枕上独吟清冷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23111,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花","author":"蔡捷","text":"落后凡花皆罢却。\n仙根生意留如昨。\n俗眼但知欺寂寞，等闲错过东风恶。\n随地为家犹自托。\n笑杀园葩，苦向枝头着。\n结子泥中甘抱璞，成溪桃李真轻薄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23112,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"苏幕遮 夫子新安归云：郡女王叶奉亲甘旨，夫客死粤西，讣至，屏食而绝","author":"蔡捷","text":"万般思，无计奈。\n因甚当初、劝往天涯外。\n欲遂亲欢还自害。\n百死关人、未足偿君债。\n拜翁姑，辞糒粝。\n揩拭肝肠、好向湘江会。\n那管旌扬身后待。\n许重芳名、青史如何载。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23113,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 吊仁和沈孝女刲股殒命","author":"蔡捷","text":"废寝忘餐，但指望、萱堂起色。\n猛听得、医人耳语，夜来当绝。\n酬地誓将遗体代，呼天暗把炉香爇。\n按金刀，良药腕中寻，亲调燮。\n耐不起，疮中裂。\n流不住，楼头血。\n向搀扶老父，那堪声说。\n白发春回双竖梦，蛾眉魂逐三更月。\n谢夫君，莫怨暂归宁，成长别。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23114,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"瑞鹤仙 宜兴周贞女未字守节","author":"蔡捷","text":"麻衣因嫁设。\n伴鬼幄孤灯，夜分明灭。\n朦胧若来接，向未知郎面，转生羞怯。\n冰心皎洁。\n誓毕生、空床对月。\n想当年、抱雁家来，已把双翎分折。\n休说。\n冥途辽绝，温凊翁姑，死生何别。\n古今义烈，差片念，误清节。\n拚伶仃形影，抛将同衾，熬到泉台共穴。\n莫道巾帼柔肠，须眉谁埒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23115,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 书嘉禾李孝贞女事","author":"庞蕙纕","text":"地老天荒，重翻过、鸳湖春色。\n记当日、白衣来梦，前身西极。\n千古男儿忙不了，一时闺阁轻收得。\n羡缇萦，缓急请从行，真堪激。\n曹娥恨，江犹黑。\n陶婴志，环空碧。\n想呼苍哀吁，药铛朱实。\n泪涴枫根终有痛，魂栖庙树知何日。\n听城南，夜夜杜鹃啼，催明月。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23116,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令 春闺","author":"庞蕙纕","text":"春到韶光堪恋。\n妒杀画梁双燕。\n妆罢捲珠帘，迟日和风吹面。\n人倦。\n人倦。\n无数落花庭院。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23117,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 夏日","author":"庞蕙纕","text":"绿映亭台薄暮天。\n熏风寂静小庭前。\n暗香浮动一池莲。\n柳絮纷纷飘画槛，桐花点点堕湘帘。\n纱窗雨过却慵眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23118,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"少年游 重午娶妇偶成","author":"庞蕙纕","text":"凤冠初卸，龙舟正渡，佳节恰新婚。\n羹遣姑尝，拜随堂上，红烛昨宵停。\n葵榴艾虎，晓妆才竟，深浅画眉痕。\n愿来年此日，儿生镇恶，客满孟尝门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23119,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹧鸪天 病中闻家慈同元姨为余诵经志感","author":"庞蕙纕","text":"终岁恹恹怯往还。\n盈盈两袖泪痕潸。\n一心解织愁千缕，双鬓慵梳月半湾。\n鸳被冷，琐窗寒，翻经画阁忏红颜。\n枕函稽首殷勤意，不尽笺题寄小鬟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23120,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"塞垣春 代明妃怨","author":"庞蕙纕","text":"塞马嘶平野。\n正四处、悲风卸。\n天南极望，乱云满目，珠泪偷泻。\n正黯然乡思满怀也。\n更羌管、鸣秋夜。\n想娥眉、汉宫欲妒，沙场巧相嫁。\n无计问君王，可犹把、婵娟萦挂。\n纵汉使频回，奈长恨难写。\n叹何时、故国重见，待安排、归梦清宵下。\n怨寄琵琶里，单于应泪洒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23121,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"沁园春 仲春为二姒三十初度","author":"庞蕙纕","text":"晓镜初开，喜傍妆台，日上花梢。\n看梅痕虽淡，尚飘积雪，柳绵未吐，遍拂长条。\n风送红香，烟凝翠黛，春到帘栊淑景饶。\n风光好，正筵前燕喜，窗外莺娇。\n兰芳玉映堪描。\n许谢女班姬第一标。\n任荆台歌舞，低头织锦，秦楼夜月，并坐吹箫。\n甲子平分，花朝前后，宝瑟瑶琴逸韵调。\n闺中近，羡霞觞引满，人在云霄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23122,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花","author":"张丽人","text":"盈盈泪眼。\n往日青楼天样远。\n秋月春花。\n输与寻常姊妹家。\n水村山驿。\n日暮行云无气力。\n锦字偷裁。\n立尽西风雁不来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23123,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"诉衷情第三体 苦雨","author":"严曾杼","text":"风欺雨妒恨无情。\n摧折满园春。\n花几度，最销魂。\n愁人梦里听。\n好月似高吟。\n恁难寻。\n欲借花痕寄远心。\n不胜簪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23124,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"诉衷情第二体 和夏","author":"严曾杼","text":"碧纱窗外绿荫浓。\n倦思忽朦胧。\n听黄鹂，骂东风。\n似与我愁同。\n伴药裹，三春去，恨如丛。\n几回顾望，举首殷勤，上祷天公。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23125,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 清明","author":"严曾杼","text":"轻风弄柳清明节。\n凭栏蓦地愁如织。\n无端留得经年疾。\n自是君心解怜惜，愁怀万种还休歇。\n孩提解语殷勤说。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23126,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙第二体 朝雨","author":"严曾杼","text":"霂霢窗西雨似丝。\n潇疏风透帏时。\n妆台临镜起梳迟。\n回身自叹，瘦影觉难支。\n未必工诗偏耐病，终朝闲数花丝。\n生憎落纸即愁思。\n花笺高阁，万事不如痴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23127,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"小重山 暮春","author":"严曾杼","text":"开尽蔷薇春已休。\n几颗青杏子，缀枝头。\n闲庭柳影漾苔柔。\n莺语老，紫燕掠帘钩。\n独立向高楼。\n迷离烟雨外，簇云浮。\n炉灰强拨坐忘忧。\n还对画，山水自悠悠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23128,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆秦娥","author":"严曾杼","text":"春风急。\n春花寥落春禽涩。\n春禽涩。\n低呼轻唤，如诉如泣。\n春云郁郁飞春雪。\n春闺寂寂春愁切。\n春愁切。\n几多心事，欲陈难说。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23129,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆秦娥","author":"严曾杼","text":"春薄劣。\n春光嫌得春心折。\n春心折。\n滑莺惊梦，梨花睡怯。\n春魂黯黯潜消别，春波渺渺吹鱼贴。\n吹鱼贴。\n一行书寄，千行泪血。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23130,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 咏梅","author":"卞梦钰","text":"繁香浸月冰魄醒。\n鹤惊风动窗横影。\n清梦逼寒帏。\n疏英点翠衣。\n苔明函润玉，冷艳生芳骨。\n露面一枝新。\n开来到处春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23131,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 秋景，回文","author":"卞梦钰","text":"翠寒香净秋荷芰。\n芰荷秋净香寒翠。\n飞雁带云微。\n微云带雁飞。\n处闲人默语。\n语默人闲处。\n心远寄山深。\n深山寄远心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23132,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 秋夜，回文","author":"卞梦钰","text":"忽思幽坐诗联月，月联诗坐幽思忽。\n风露咽吟虫，虫吟咽露风。\n石阶苍藓碧，碧藓苍阶石。\n秋夜旅人愁，愁人旅夜秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23133,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉烛新 咏茉莉，用周美成韵","author":"卞梦钰","text":"亭轩微雨过。\n看绿荫雕栏，蕊珠新就。\n轻柔婉约，冰姿倩、百颗玲珑芳漏。\n含情几许，最月淡风清时候。\n人静矣、凉透屏纱，素香腻沾衫袖。\n清端足并梅花，雅不受红尘，冷暄匀否。\n粉猜玉斗。\n纤可拟、洛浦浣溪人瘦。\n烟凝露秀。\n每自殷勤回首。\n遥寄语、桂殿兰宫，霓裳慢奏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23134,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"齐天乐 湖上午日","author":"卞梦钰","text":"彩云拥退千峰雨，日月并当双五。\n蒲泛琼卮，丝缠玉臂，竞渡遥同荆楚。\n门悬艾虎。\n愿兵辟灵符，尘清烽缕。\n天台路近，采药人归时正午。\n风度歌声何许，试问湖山，今可还如古。\n看小燕新蟾，穿红掠碧，都向景中添句。\n柳荫低映，好放艇邀凉，水香凝处。\n选韵题觞，删去繁箫鼓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23135,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"惜馀春慢 湖上饯春，用周美成韵","author":"卞梦钰","text":"荷钱铸新，榆钱蓄旧，难买春留芳草。\n回思柳月，转忆桃霞，常为雨风迷晓。\n恰来何事凄其，负往云深，饯今云少。\n叹春光兰臭，莫逆溪山，关情缥缈。\n试问取、叶底雏莺，梁间乳燕，解否而今烦恼。\n绣阁兰闺，词裁代谢，思拥笔端难扫。\n还问春归何处，可是天涯，再来又老。\n恍疑似雁去，南天日送，远峰环绕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23136,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"捣练子","author":"侯承恩","text":"春梦杳，晚秋凉。\n零落芙蕖尚有香。\n人远天涯红日近，断魂无语立斜阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23137,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"捣练子","author":"侯承恩","text":"情脉脉，思悠悠。\n花自纷飞水自流，青鸟不来春又尽，含愁无那倚妆楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23138,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆王孙","author":"侯承恩","text":"远客长途孤寺秋。\n天寒少个寄书邮。\n况兼风雨又绸缪。\n恨悠悠。\n一点鸣窗一点愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23139,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"诉衷情 寄女史赵淑仙","author":"侯承恩","text":"难从弱水泛兰舟。\n悠悠无限愁。\n天涯契阔空凝望，此恨几时休。\n星月小，露华浮。\n泪盈眸。\n相思两地，芳魂不隔，梦绕高楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23140,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西江月","author":"侯承恩","text":"天上繁星难数，人间万籁无声。\n忽闻清柝近三更，月照纱厨冷静。\n若个情深似海，却怜命薄如冰。\n吹嘘何日上青云，愁杀灯昏梦醒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23141,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"侯承恩","text":"姹紫嫣红风日佳。\n心情扰扰似蜂衙。\n安闲试问是谁家。\n花正妍时愁雨妒，月当圆处被云遮。\n人间薄命不须嗟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23142,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人","author":"侯承恩","text":"春过九十馀芳草。\n门掩经过少。\n荼麻架上暗香消。\n尚有深深蛱蝶、趁风娇。\n诗篇废却怜春去。\n难买流年住。\n小楼独上觉凄凉。\n只见一池荷净、浴鸳鸯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23143,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"画堂春","author":"侯承恩","text":"夕阳时候薄寒生。\n依依独自闲行。\n一群鸿雁带秋声。\n飞过高城。\n揽镜暗伤憔悴，背人偷落红冰。\n画桥西去是蓬瀛。\n只隔云程。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23144,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一剪梅","author":"侯承恩","text":"无绪严妆独倚楼。\n愁在心头。\n愁在眉头。\n蓼花风起冷飕飕。\n欲下帘钩。\n懒下帘钩。\n百和香烟静自浮。\n琴也慵修。\n书也慵修。\n夕阳西堕水东流。\n怕更听筹。\n又近更筹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23145,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"桃源忆故人 闻外归","author":"项佩","text":"东风似惜离颜瘦。\n不计纱窗轻皱。\n吹得梅芽香透。\n才是郎归候。\n屏山十二春依旧。\n买幅生绡重绣。\n花影双双当昼。\n莫遣离情又。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23146,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"瑶华 咏并头莲","author":"黄荃","text":"日分蒂影，风合花香，记双栖无力。\n临波微步，最羡是、婀娜一般倾国。\n玉容相对，任两两、苦心同识。\n试丁宁、水佩风裳，休教共争颜色。\n还是旧日深宫，笑并浴温泉，露薇堪惜。\n冷香飞处，料不是、铜爵二乔游历。\n西风来也，怕吹动、碎云狼藉。\n谁耐见、花底鸳鸯，也学并头溪侧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23147,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"烛影摇红 梅花","author":"吴碧","text":"雪压霜催，岁寒心事谁人晓。\n三分冷艳十分香，瘦影天然好。\n笛里飘零最早。\n抵多少、别离烦恼。\n相思恨结，未到开时，头先白了。\n玉洁冰清，寻常攀折休倾倒。\n怪他桃李太轻狂，羞共东风笑。\n莫待寿阳人老，最堪怜、罗浮梦杳。\n月当头处，人倚栏时，幽心悄悄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23148,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙 春水，和谷芳嫂韵","author":"张瑶","text":"添得几番酥雨后，波光南浦春融。\n平桥涨起曲尘风。\n蘸将垂柳绿，泛出落花红。\n真个船如天上坐，投纶羡煞渔翁。\n湔裙人指碧流中。\n鱼鳞吹潋滟，燕尾掠空濛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23149,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南歌子 夜坐","author":"尹琼华","text":"清漏莲花静，寒灯荷叶明。\n小楼罢绣坐含情。\n可笑小鬟偷睡、倚银屏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23150,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"花非花 雨花","author":"尹琼华","text":"雾濛濛，丝缕缕。\n密还疏，来复去。\n行人莫怪断轻魂，小庭也酿愁无数。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23151,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"花非花 灯花","author":"尹琼华","text":"映纱窗，辉绣幕。\n乍含苞，旋吐萼。\n好占喜信准明朝，晓风莫便轻摇落。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23152,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 忆杭","author":"闵怀英","text":"春寒惊梦。\n被拥巫云谁与共。\n望眼迷离。\n粉蝶杨花一片飞。\n倚阑无力。\n深掩重门人寂寂。\n儿女牵怀。\n目断西泠雁不来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23153,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"柳腰轻 秋闺","author":"马闲卿","text":"从来那惯愁滋味。\n腰正瘦，心将碎。\n乌云才绾，菱花慵对，掩著琐窗寻睡。\n敲朱户、檐马声凄，战金风、井梧叶坠。\n不分芙蓉沉醉。\n笑海棠、露浓红退。\n满怀情绪，倚阑无语，兀自偷垂香泪。\n总知是、秋梦无端，没来由、把人憔悴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23154,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卖花声 送春","author":"庄焘","text":"新绿满汀洲。\n月在西楼。\n池塘脉脉水东流。\n两岸蛙声鸣夕照，春去悠悠。\n往事怕回头。\n惹起闲愁。\n物华如梦杳难留。\n雨后飞花风里絮，身世浮沤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23155,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卜算子","author":"庄焘","text":"积雨喜新晴，小院风初定。\n月满芳阶露气浮，花动雕栏影。\n宝鼎篆烟微，幽梦残灯省。\n忽逐钟声度小桥，不管春衣冷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23156,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花","author":"庄焘","text":"薄寒透帐。\n晓雨声声来枕上。\n纤草含春。\n荒甃颓垣到处生。\n落花无语。\n飞入池塘和泪去。\n杨柳丝柔。\n懒尽东风不送愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23157,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"暗香 和张笔芳梅花词","author":"庄焘","text":"四山寒色，正小园雪后，悠然闻笛。\n细蕾乍匀，休认珠胎误轻摘。\n略见横枝映水，渐催动、吟香诗笔。\n待画取、尘外幽芳，春思散瑶席。\n仙国，正寥寂。\n想庾岭夜长，月华重积。\n梦回自泣，一堕红尘渺难忆。\n闲向妆台对影，应伴我、湘兰凝碧。\n问素女琼佩响，几人听得。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23158,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令","author":"吴永汝","text":"帘外一枝花影。\n月到花梢影冷。\n夜坐穗灯销，寂寞小窗寒浸。\n梦醒。\n梦醒。\n重把离愁细整。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23159,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹧鸪天 春日偶成","author":"邓繁桢","text":"深院莺啼春昼悄。\n半生心事伤怀抱。\n年年芳树又舒荣，何事韶华空自老。\n重帘外，游蜂绕。\n落花满地无人扫。\n残红片片逐东风，愁里哪知春色好。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23160,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆秦娥 秋夜","author":"邓繁桢","text":"秋宵永。\n纱窗明月微留影。\n微留影。\n倚栏独坐，夜深人静。\n阶前纬络声难听。\n海棠倚石梧风冷。\n梧风冷。\n几多秋色，凄凉幽景。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23161,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"惜分飞 秋日送谷贻二弟出游","author":"邓繁桢","text":"怅望秋云还似旧。\n黄菊依然清瘦。\n闷折亭前柳。\n伤心泪湿罗衫袖。\n记得高堂同载酒。\n极目湖山明秀。\n往事难回首。\n新愁旧恨空消瘦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23162,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 月夜闻笛","author":"邓繁桢","text":"残月斜穿槅子明。\n谁家乃作断肠声。\n无端心绪最关情。\n风动罗帏惊好梦，披衣重起正三更。\n蕙兰露湿暗香生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23163,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"长相思 忆先大人","author":"邓繁桢","text":"恸难支。\n苦难支。\n抱恨终天永日思。\n蓼莪废咏时。\n心如痴。\n意如痴。\n伶仃馀息已如丝。\n伤心只自知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23164,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令 秋夜","author":"邓繁桢","text":"风动黄花影乱。\n月上纱窗一半。\n夜坐觉寒生，烛尽香残梦断。\n人倦。\n人倦。\n怕听哀鸿啼怨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23165,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令 初春","author":"邓繁桢","text":"陌上绿杨如旧。\n人共梅花俱瘦。\n病起已无聊，又是困人时候。\n长昼。\n长昼。\n风送隔帘香透。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23166,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]