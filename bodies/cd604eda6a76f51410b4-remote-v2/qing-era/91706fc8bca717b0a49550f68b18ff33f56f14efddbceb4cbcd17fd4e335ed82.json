[{"title":"颂刘谦山邑侯德政五首 其二","author":"杨希三","text":"经济文章共一途，宰官犹是大名儒。\n抡才自有真衡鉴，拔萃超凡总不诬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19756,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"颂刘谦山邑侯德政五首 其三","author":"杨希三","text":"旱潦灾荒实可忧，频将水利细推求。\n浚源岂特通舟楫，高下农田得有秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19757,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"颂刘谦山邑侯德政五首 其四","author":"杨希三","text":"纺织江乡处处同，年来生计巳皆穷。\n为兴蚕茧舒民困，补救群推第一功。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19758,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"颂刘谦山邑侯德政五首 其五","author":"杨希三","text":"钟鼓笙镛瑟与琴，而今节奏久销沈。\n清风江上来师旷，釐订常悬一片心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19759,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"刘谦山邑尊奉调赴省，诗以送之 其一","author":"卞乃钰","text":"令尹题名取次看，几人严覈几人宽。\n一周甲子从头数，六十年无此好官。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19760,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"刘谦山邑尊奉调赴省，诗以送之 其二","author":"卞乃钰","text":"西郊建院仰前贤，秀读诗书朴种田。\n课士劝农频税驾，棠阴深处憩花鞯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19761,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"刘谦山邑尊奉调赴省，诗以送之 其三","author":"卞乃钰","text":"水道疏通五十条，东横河势自迢迢。\n沙洲套港分南北，灌溉咸资大海潮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19762,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"刘谦山邑尊奉调赴省，诗以送之 其四","author":"卞乃钰","text":"高原少雨便灾荒，谆劝黎民广种桑。\n比岁渐知蚕茧利，家家争祀马头娘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19763,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"刘谦山邑尊奉调赴省，诗以送之 其五","author":"卞乃钰","text":"煌煌天语纪神功，贤宰精诚帝谓通。\n蝗不为灾征政异，芃芃禾黍庆年丰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19764,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"刘谦山邑尊奉调赴省，诗以送之 其六","author":"卞乃钰","text":"德化流行俗自移，齐民那必在鞭笞。\n愿将旧政贻新尹，慈惠长留去后思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19765,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寿谢寄甥广文七十 其一","author":"杨敦诗","text":"当年洛下会耆英，佳话千秋著盛名。\n胜事不妨循古昔，高风应复属先生。\n一尊清酒频酬酢，三物乡修类举行。\n喜得追随觞咏侣，愿歌短调祝长庚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19766,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寿谢寄甥广文七十 其二","author":"杨敦诗","text":"解组归田孝友敦，东山高卧古风存。\n不贪禄秩怀根本，惟爱诗书教子孙。\n寿相果然同佛相，德尊何止颂年尊。\n他时凤诏征梁灏，还与边韶腹笥扪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19767,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"狼山题壁","author":"陈名寿","text":"一花一叶尽菩提，底事空山鸟乱啼。\n两袖白云归未得，宾王先我醉如泥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19768,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"古冢","author":"陈名寿","text":"漫山荒草冢高低，过客停车落照西。\n枫叶向人红似血，当年多少杜鹃啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19769,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乱中秋望时避难江北","author":"陈名寿","text":"马策与刀环，长征苦未閒。\n乱山秋草黑，破塔夕阳殷。\n江静无人渡，天空任鸟还。\n故园何处是，凝睇白云间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19770,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题赵焕文茂才彝鼎殉节纪","author":"陈名典","text":"一死不足惜，千秋大义存。\n楚氛当日恶，大地霎时昏。\n衰世无忠节，荒庵有荩魂。\n嗟予犹健在，愧我赵公门。\n些语听离骚，魂兮那许招。\n西欧飞血雨，东海动心潮。\n世事今如此，生民恨未消。\n九京如可作，应更痛前朝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19771,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"篝灯课子图，为谢节母题","author":"陈名典","text":"西风萧瑟天气凉，奄奄夫婿病在床。\n祷神求医兼问卜，佥云病已入膏肓。\n回忆结缡才十稔，一朝撒手情何伤。\n当时不难以身殉，下有孤儿上姑嫜。\n仰事俯蓄赖十指，此身未便遽云亡。\n况复夫君有遗命，是儿须令继书香。\n春秋递嬗儿渐长，就傅归来立母傍。\n母云志士惜日短，莫道愁人恨夜长。\n日短夜长阴可惜，挑灯课读亦何妨。\n机声书声相接续，夜如何其夜未央。\n儿承母训苦自励，青年名已列胶庠。\n又将母节达上听，冰霜励洁邀龙章。\n母年今已逾七秩，暇复课孙体康强。\n谢生持图索题咏，频年奔走笔墨荒。\n况复在前有珠玉，骚坛健将推张黄。\n聊将俚句表慈孝，传之家乘志不忘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19772,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己卯冬日登约园燕云阁，步幼亭世兄原韵二首 其一","author":"陈名典","text":"一束花枝傍矮簃，芳心惟恐报春迟。\n湖山隐约炊烟起，楼阁苍茫暮霭时。\n傲骨怕随流俗改，壮怀未许等閒知。\n相逢岂必曾相识，把酒重阳订后期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19773,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己卯冬日登约园燕云阁，步幼亭世兄原韵二首 其二","author":"陈名典","text":"槛外微阴入小簃，登临莫笑我来迟。\n乡心已落梅花后，山色争看夕照时。\n选胜西湖偿旧约，开筵东阁订新知。\n他年得遂兰陔愿，笑指燕云相与期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19774,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己卯冬日登约园燕云阁得看字","author":"陈名典","text":"峨峨高阁矗云端，此日登临眼界宽。\n归雁远从云外落，好山留向雪中看。\n径荒苔藓埋陈迹，地僻梅花耐早寒。\n湖上风光无限好，一声长笛倚阑干。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19775,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"新柳四首 其一","author":"陈名慎","text":"渡江乍见柳条条，几处渔家隐画桥。\n漏泄春光舒倦眼，低昂风力舞纤腰。\n隋堤十里朝笼雾，南浦孤帆暮趁潮。\n知否深闺思妇怨，不应闷雨更连宵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19776,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"新柳四首 其二","author":"陈名慎","text":"少妇凝妆斗晚霞，所思人尚隔天涯。\n玉关惆怅东风杳，香陌逍遥客路赊。\n细雨疏帘看乳燕，夕阳古渡带栖鸦。\n岂宜听澈骊歌唱，空触芳心怨岁华。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19777,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"新柳四首 其三","author":"陈名慎","text":"絮语缠绵两意同，忍教萍迹忽西东。\n只今牢繫长堤马，从此无烦远塞鸿。\n绿意满前风似箭，黄昏有约月如弓。\n千条万绪横塘路，牵惹桃花别样红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19778,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"新柳四首 其四","author":"陈名慎","text":"掩映柴门曲径通，晚宜凉月晓宜风。\n愁生绿绮三弹后，春在青帘一望中。\n几缕柔情丝可绾，廿番花信尽难工。\n羁怀是处容消遣，且听莺声倚短筇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19779,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题周墅留耕庄","author":"张君达","text":"万顷平畴眼界宽，长河围绕若龙蟠。\n留遗祖泽能绵远，耕读家声兆发端。\n庞德草堂欣在望，王珣别墅两相安。\n门前多少风帆过，怎比君家笑与欢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19780,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"予以直州判加捐州同指分皖省，乡诸君皆惜予不善择官，又不善择地，赋以自解","author":"张之纯","text":"白色斑斑上鬓丝，卅年未折桂林枝。\n伯牛有疾终归命，司马为郎尚入资。\n氛恶况当盟楚日，泉清那比在山时。\n随风飘落花无定，茵溷原难自主持。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19781,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"皖伯台","author":"张之纯","text":"茅土周室颁，地本近荆蛮。\n明月几今古，閒云任往还。\n转怜今日客，不识旧时山。\n欲访左慈迹，霜枫落叶殷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19782,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"余公墓","author":"张之纯","text":"千载显英灵，孤忠耿日星。\n六年撑半壁，一死答元廷。\n清水波涵碧，名山草护青。\n履声来橐橐，洗耳不甘听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19783,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"用皖伯台韵，答心斋吊黄侍中观","author":"张之纯","text":"明诏削藩颁，参军语作蛮。\n山僧多事出，世将弃师还。\n波咽秦淮水，风寒皖国山。\n当时方正学，血染石同殷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19784,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"妾命薄","author":"张之纯","text":"妾命薄，妾命薄，耶娘教妾学歌曲。\n歌曲学成学琵琶，大弦小弦弹落续。\n妾命薄，妾命薄，耶娘教妾学演剧。\n演剧学成冠梨园，引动翩翩年少客。\n客见倾心，如马求林。\n耶娘居奇货，身价逾万金。\n不管萧郎成陌路，但觉侯门一入似海深。\n王嫱嫁单于，雅与素愿殊。\n但得一枝借，聊胜辱泥涂。\n老天老天胡不佑，又使风云陡变，团栾明月影模糊。\n吁嗟乎，杨家女儿何数奇，玉环罗袜遗马嵬。\n君王掩面尚救不得死，何论尚书阁老天潢支。\n玉环死，陈玄礼，妾今去，赵御史。\n御史为国当直言，但言十万寿金良足矣。\n事有甚，画眉何必及翠喜。\n胡不闻，君家飞燕入汉宫，啄尽皇孙与皇子，为问奴奴可有此。\n妾来公子乐，妾去公子哭，万事美中有不足。\n妾劝公子莫过伤，有人含笑对镜著花黄。\n妾不怨人怨月老，天上飞升胡太早。\n三生有约缓缓行，未必坠入轮回道。\n美人计，空用了，天下事大妾事小。\n富贵浮云幻，一场春梦醒。\n崎岖世路今番信，人生何事枉劳形。\n自怜还自笑，笑妾女优伶。\n花开姊妹千万朵，问谁似妾姓氏达帝听。\n重理旧时弦，低唱懊侬曲。\n得配韩蕲王，千古梁红玉。\n妾亦同是青楼人，胡竟随风复漂泊。\n漂泊不禁风，伤哉真命薄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19785,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"癸丑九月，六十自慨四首 其一","author":"张之纯","text":"不埋黄土不黄冠，敢说纲常大节完。\n父有遗言惭未践，家无恒产幸能安。\n同沾雨露商容易，重整乾坤夏靡难。\n此后未知何景象，任他日月走双丸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19786,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"癸丑九月，六十自慨四首 其二","author":"张之纯","text":"五龙六甲等閒过，都付南槐梦里柯。\n一曲铜琶谁与唱，十年铁砚竟空磨。\n含情莺燕秋风老，翊运夔龙旧雨多。\n苜蓿半盘清可供，充饥聊当采薇歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19787,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"癸丑九月，六十自慨四首 其三","author":"张之纯","text":"旧事重提细忖量，未能亲墓表泷冈。\n停车问字徒饶舌，倾盖论交枉热肠。\n曾效捉刀杨德祖，空怀草檄骆宾王。\n昔年辛苦论文友，偻指知音半北邙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19788,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"癸丑九月，六十自慨四首 其四","author":"张之纯","text":"偶逐风尘作宦游，皖山皖水几春秋。\n感时凭吊忠宣墓，乘醉狂吟太白楼。\n才纵不高曾倚马，性原喜静等浮鸥。\n素旗飘飐归来后，怕看增添海屋筹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19789,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和尹孚赠姚志豪作","author":"张之纯","text":"说与人间不忍听，西河泪雨一般零。\n昆生别后无同调，寥落娄东野史亭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19790,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"偶成二首 其一","author":"张之纯","text":"几家篱落不成村，寂寞故园深锁春。\n骤雨滴醒蝴蝶梦，迅雷震破杜鹃魂。\n渡江泥马无神品，埋棘铜驼有泪痕。\n毕竟愚公胜智叟，移山有子子传孙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19791,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"偶成二首 其二","author":"张之纯","text":"苍水崖山一例亡，浩然正气大而刚。\n岁寒始显冰霜节，星陨犹争日月光。\n事纵不成名自遂，生原能舍死何妨。\n遗芳自古多遗憾，几见真人白水乡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19792,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西施","author":"张之纯","text":"侬家迢递阻山河，犹记村名是苧萝。\n为问捧心因底事，受王恩重负王多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19793,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"谢生幼陶瓶菊为鼠所啮，成五律一章，邮寄见示，余偶有所感，有原韵答之","author":"张之纯","text":"莫言鼠胆小，每惯窃盘餐。\n占据寝庙穴，凭依社稷坛。\n直同梅细嚼，遑惜菊英寒。\n赖有一物制，狸奴侧目看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19794,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"吊黄介子","author":"张之纯","text":"矫矫黄介子，成仁愿杀身。\n至今称义士，当日号奸人。\n结客思兴汉，潜踪岂避秦。\n凄凉法宝寺，遗恨大江滨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19795,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"予腰腹本大，今年七十顿瘦减，慨然有感","author":"张之纯","text":"老去腰围似沈郎，何堪解带细评量。\n边韶称笥经荒废，王勃成文稿脱亡。\n怕作生松丁固梦，转怜舞柳小蛮妆。\n扬州纵想骑仙鹤，十万缠时费主张。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19796,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杂感 其一","author":"张之纯","text":"閒居三月不参衙，且典鹴裘入酒家。\n自顾真如五技鼠，难防最是两头蛇。\n刘伶荷锸埋黄土，王播笼诗有碧纱。\n坐拥书城南面贵，研朱点易旧生涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19797,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杂感 其二","author":"张之纯","text":"六年重到白门游，文阵纵横战未休。\n筑室谋夫谁执咎，言兵败将转增羞。\n艰难风雨怜畴昔，容易光阴阅几秋。\n赖有吴刚携月斧，装成七宝广寒楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19798,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"芜关元旦，用渔洋蟂矶灵泽夫人祠韵，口占二绝寄怀恂斋 其一","author":"张之纯","text":"我留皖国子归吴，客里情怀分外孤。\n不识椒花新颂献，举杯忆及旅人无。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19799,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"芜关元旦，用渔洋蟂矶灵泽夫人祠韵，口占二绝寄怀恂斋 其二","author":"张之纯","text":"万千爆烛破清寥，积雪皑皑冻木萧。\n閒立临江亭上望，听人评论拜年潮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19800,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赵焕文挽诗三首 其一","author":"张之纯","text":"西风陡起白旗飘，抱木今重见鲍焦。\n留得吾邦忠义字，两间正气未全销。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19801,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赵焕文挽诗三首 其二","author":"张之纯","text":"记得门停问字车，当年同社有谁如。\n数行磊落传家训，抵得文山衣带书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19802,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赵焕文挽诗三首 其三","author":"张之纯","text":"讲学风开郑太常，胶庠继起共流芳。\n三贤泉下应含笑，此事荒庵也有光。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19803,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"墨痴唱和集题词 其一","author":"杨翰元","text":"坐老蓬门久，飞来一卷诗。\n骚坛工泼墨，吏隐不嫌痴。\n别恨江淹赋，牢愁杜甫词。\n回环欣雒诵，珍重比瑰奇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19804,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"墨痴唱和集题词 其二","author":"杨翰元","text":"磊落蓄奇气，狂吟剑佩摩。\n豪情抉云汉，壮志挽江河。\n不抚燕南筑，而为塞上歌。\n阳春原寡和，君子意如何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19805,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"墨痴唱和集题词 其三","author":"杨翰元","text":"予亦悲歌者，开编见道心。\n珠玑真在握，笙磬羡同音。\n浩浩清兼浊，茫茫古与今。\n从知名下士，别自有胸襟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19806,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"五十自述","author":"王季珠","text":"风涛未靖继干戈，半百年从患难过。\n朋辈乱飞霜后箨，老怀难越井中波。\n还丹无术求仙误，剪纸为花获赏多。\n草草劳人如过客，旷庐我只当行窝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19807,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"冬日遣怀","author":"王季珠","text":"此身无病即神仙，自视馀生漫欣然。\n触詟老来仍恃粥，少陵寒甚欲装绵。\n十分疏放违时好，一样聪明让少年。\n世事反常那胜说，江南鱼米日论钱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19808,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寿张少泉先生七十即用其自寿原韵 其一","author":"王季珠","text":"簪裾满座醉和春，莺燕聊翩贺主人。\n坐我董帷书味永，管他周鼎泗滨沦。\n五千年史翻陈案，三十馀山卧逸民。\n对客欣髯时一笑，卷舒的是自由身。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19809,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寿张少泉先生七十即用其自寿原韵 其二","author":"王季珠","text":"渡辽名士属龙头，却聘无烦借箸筹。\n结客孔融居北海，逃名徐孺重南州。\n能将富贵浮云视，知是神仙慧业修。\n听唱阳春高格调，绕梁馀韵尚悠悠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19810,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寿张少泉先生七十即用其自寿原韵 其三","author":"王季珠","text":"廿载邯郸道上过，梁园作赋意云何。\n秋风波起思莼菜，茅屋云深长薜萝。\n耐老竞推长寿佛，雅游喜作小行窠。\n美人芳讯今无恙，江上芙蓉采撷多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19811,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寿张少泉先生七十即用其自寿原韵 其四","author":"王季珠","text":"谁为博物善文辞，嗜古徒招世俗嗤。\n烟雨模糊天下事，山川灵淑袖中诗。\n儒林支派清河衍，团扇神丰洛下遗。\n辉映并时生二老，天将风教付维持。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19812,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题赵焕文茂才殉节记二首 其一","author":"王季珠","text":"举世无奇节，纷然莽大夫。\n负恩谈革命，高蹈属吾徒。\n五代非纯史，三纲托古愚。\n乾坤留正气，垂唁大江隅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19813,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题赵焕文茂才殉节记二首 其二","author":"王季珠","text":"吾邑称忠义，于今三百年。\n忍看亡国惨，休笑匹夫颠。\n君父魂常保，妻拿梦早捐。\n高风追李缪，虽死亦怡然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19814,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"游大小石洞二首 其一","author":"王季珠","text":"入山曾有志，苦乏买山钱。\n李愿归盘谷，王维辟辋川。\n天方花散雨，人与鹤争年。\n暂借蒲团坐，同参上乘禅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19815,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"游大小石洞二首 其二","author":"王季珠","text":"盘古曾遗洞，千年化石多。\n名流宜笠屐，福地不兵戈。\n潭静清无滓，碑残字未磨。\n当轩松独立，风至发高歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19816,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"感怀二律 其一","author":"王季珠","text":"绝无聊赖喜临池，犹是消磨胜废时。\n造士频惊花样变，立言那笑布衣私。\n新闻便当新诗料，老境还亏老友知。\n德不加修修亦晚，何如嬉戏学为儿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19817,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"感怀二律 其二","author":"王季珠","text":"旧服新装最诩工，趋时未脱古人风。\n人皆量服娄师德，我愿诗规陆放翁。\n藏匣剑光犹烁烁，过帘云影太匆匆。\n静评行运初无似，莫误春花一例红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19818,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]