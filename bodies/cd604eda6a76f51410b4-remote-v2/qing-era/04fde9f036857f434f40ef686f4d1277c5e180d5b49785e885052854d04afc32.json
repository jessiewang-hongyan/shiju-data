[{"title":"蝶恋花 忆女","author":"杨澈","text":"欹枕呻吟清不寐。\n病入人心，药石炉空沸。\n惨淡寒灯天欲曙，依稀残梦轻难记。\n一片鸡声和夜雨，搅乱愁肠，总是伤心味。\n千遍思量千遍泪，何时得汝欣欣至。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22857,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"桃源忆故人 冬夜","author":"杨澄","text":"乍惊岭雪寒梅绽。\n暖阁红炉妆遍。\n锦帐佳人睡暖。\n冰壶一夜满。\n烟寒山色偏宜远。\n楼上帘垂不捲。\n风急雁行吹断。\n云乱江天晓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22858,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满宫花 春晓","author":"杨澄","text":"春正迟，晨尚冷。\n水咽辘轳金井。\n深闺少妇不如愁，日对碧纱烟影。\n燕掠画檐油幕静。\n红药翻阶瞑。\n东风杂引佩环声，一抹双眉慵整。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22859,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉楼春 迟起","author":"杨澄","text":"香闺几度眠过晓。\n罗绮风柔惊料峭。\n碧桃万树倚云栽，几日东风都放了。\n花枝手自凌晨拗。\n图史馀闲香篆袅。\n雕栏十二锁春寒，楼阁重重人不到。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22860,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙 春思","author":"杨澄","text":"幽闺欲曙闻莺啭，绮窗初日微明。\n新妆眉画远山横。\n此时花事了，燕子最关情。\n满地落花红作雨，倍添春思难禁。\n旧欢惟有梦魂惊。\n东风何太劣。\n吹断玉箫声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22861,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"苏幕遮 牡丹春睡","author":"杨澄","text":"玉楼春，金屋晓。\n晓日低檐，紫雾红烟绕。\n处处喧晴闻好鸟。\n帘幕重遮，更卧人儿悄。\n梦巫山，游阆岛。\n翡翠衾温，嬿婉偏难觉。\n强起不胜情思小。\n细数朝来，花落知多少。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22862,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"风中柳 秋日寄外","author":"杨澄","text":"每到秋来，黯黯倍增愁境。\n怯西风、时惊骨冷。\n梦回人远，正深闺曲径，忆追欢、不禁酒醒。\n暮鼓晨钟，几许韶华犹剩。\n问何堪、香抛粉尽。\n雕栏朱户，休教孤另，怕消瘦、相如多病。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22863,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令","author":"刘云琼","text":"山树重重鸦裹。\n石窦微微云躲。\n细雨湿蓬窗，红洗秋棠半朵。\n萤火。\n萤火。\n飞去飞来伴我。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22864,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令","author":"刘云琼","text":"花滴雨香莺啄。\n波皱云纤鱼掠。\n谁动护花铃，宝弹暗敲金箔。\n轻薄。\n轻薄。\n人被柳丝兜着。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22865,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行 秋夜","author":"刘云琼","text":"独伴孤灯，紧攒翠黛。\n雕阑倚遍无聊赖。\n闲添宫饼篆烟微，一轮霁月悬窗外。\n彩笔拈来，花笺重载。\n玉人此夜知何在。\n空教清泪洗残妆，那堪今夜愁如海。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22866,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南乡子 七夕","author":"秦某（张日駜室","text":"细雨晚来收。\n绿柳梢头挂玉钩。\n几度欲拈团扇子，悠悠。\n数点流萤度小楼。\n回首乍惊秋。\n深院凉生看女牛。\n乞巧穿针无意绪，添愁。\n倚遍栏杆不自由。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22867,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎美人 又七月看锡山燃灯，和表姊","author":"秦某（张日駜室","text":"微润侵衣，嫩凉生树。\n星桥一簇山深处。\n青帘翠袖几相招。\n赢得片帆欲挂、又停桡。\n小阁松风，幽窗蕉雨。\n与卿梦里还同语。\n漫投双鲤付轻潮。\n问取明朝乌鹊、再填桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22868,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹧鸪天 花朝祝花","author":"胡佩荪","text":"九十春光半已抛。\n千红万紫放今朝。\n怜芳叶底莺声嫩，选艳枝头燕舞娇。\n花下祝，酹香醪。\n系铃护了更幡摇。\n好邀月姊多情照，忍逐风姨无赖飘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22869,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 题大士像","author":"胡纫荪","text":"七宝庄严坐普陀。\n慈悲一切感通多。\n金容画里果真么。\n莲萼足登开觉路，杨枝手执洒恩波。\n贪嗔痴奈世人何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22870,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"念奴娇 中秋坐月，和姑大人韵","author":"胡纫荪","text":"秋风送爽，看团圞冰镜，遥空驾起。\n收拾绣床瓜果设，拜月桂花影里。\n小院香烧，高堂酒酌，笑语生欢喜。\n寒辉流照，一年良夜能几。\n还念赏玩琼楼，豪华易歇，难把铜山倚。\n天上人间清是福，我与常仪同意。\n坐转银壶，歌赓玉树，欲向晶宫寄。\n约他来晚，碧天依旧如洗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22871,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"王璐卿","text":"风落残红兰槛多。\n墙阴袅娜紫遛过。\n牡丹和露湿轻罗。\n闲把鸳针穿蝶翅，戏抛绳拂引狸奴。\n昼长挨得绣功夫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22872,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"柳含烟 本意","author":"王璐卿","text":"容婀娜，意轻盈，一抹淡烟深锁。\n灞桥攀尽又还生。\n惹离情。\n东风吹得春无主，搅乱半天飞絮。\n王孙马上不思家。\n奈何他。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22873,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉蝴蝶 咏梦","author":"王璐卿","text":"怪尔庄生何事，勾人别思，惹我离魂。\n十二画栏深处，依旧黄昏。\n月溶溶、桃花满地，烟淡淡、柳絮盈身。\n正氤氲。\n香浮翠幕，雾锁重门。\n殷勤。\n忽听天际，数声横笛，一曲阳春。\n凝望琼楼素娥，如雪乱红云。\n似依稀、莺牵绣带，还缥缈、蝶绕罗裙。\n羡巫神。\n凌波来去，不动芳尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22874,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南乡子","author":"汤淑英","text":"天气最无凭。\n乍雨还晴又做阴。\n时候困人三月也，清明。\n暗买韶光柳醵金。\n杯酒恣闲吟。\n寂寞春庭斗草心。\n院落昏黄帘幕静，沉沉。\n独坐谯楼又起更。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22875,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"捣练子 夏夜闻箫","author":"俞浚","text":"荷露冷，竹风凉。\n小扇轻罗坐石床。\n何处凤箫吹不断，夜深明月转回廊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22876,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江城子 江梅九月小院盛开，词以纪之","author":"俞浚","text":"小园秋老绽芳梅。\n暖风催。\n数枝开。\n徙倚红楼，明月暗香来。\n玉笛漫吹帘半捲，疏影里，独徘徊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22877,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐 邻女出游，堕钗而返，戏赠","author":"俞浚","text":"年华浪掷，早又梨花白。\n闲坐绮窗情脉脉。\n约伴同过绣陌。\n枝头黄鸟喈喈。\n相扶踏遍花街。\n小玉嬉游不惯，忙中掉下金钗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22878,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雨中花 灯下观牡丹","author":"俞浚","text":"国色无双妖冶。\n欢赏正逢新夏。\n绛蜡高烧，锦帏低捲，一片红光射。\n凭槛月来妆未卸。\n浑似玉环初嫁。\n看影弄瑶台，歌翻翠袖，醉倚沉香夜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22879,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"瑞鹧鸪 咏红树","author":"俞浚","text":"露冷江皋万木秋。\n一林霜叶映南楼。\n遥疑螮蝀天边落，近似珊瑚海上浮。\n贴水波平风日淡，隔山烟净火云流。\n年年此际深宫里，可有题诗托御沟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22880,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 寄怀，慕韩江右","author":"俞浚","text":"一带苍烟笼远树。\n望里斜阳，隔断天涯路。\n帘捲画楼双燕舞。\n寒潮乍落春帆渡。\n柳谢花残江景暮。\n数点归鸦，叫过山头去。\n人又不来音又阻。\n柔情万缕和谁诉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22881,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"风流子 依韵答慕韩","author":"俞浚","text":"汝年才弱冠，怎挨得、如此冷生涯。\n想潘岳善愁，霜侵旅鬓，谢安高卧，月照庭罳。\n问今日、几人怜白雪，谁个重乌衣。\n合浦明珠，终能遇主，荆山美璞，定必逢时。\n从来英豪也，多穷困此际，再自沉思。\n待看名题雁塔，志遂鹏飞。\n笑纷纭世态，真同幻影，寂寥词客，喜独扬眉。\n且守青毡旧业，莫负天知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22882,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙","author":"沈关关","text":"春睡恹恹如中酒，小庭闲步徘徊。\n雨馀新绿遍苍苔。\n落花惊鸟去，飞絮捲愁来。\n才觉春来春又暮，枝头累累青梅。\n年光一瞬总堪哀。\n浮云随水逝，残照上楼台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22883,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渔歌子","author":"沈士芳","text":"凉气萧萧坐久生。\n风吹败叶落闲庭。\n窗纸响，砌蛩吟。\n残月依依影半明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22884,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐","author":"沈士芳","text":"柳风梅雪。\n绣幕云驱月。\n花气扑帘香影折。\n睡暖一双蝴蝶。\n敛眉独倚金扉。\n轻寒吹上铢衣。\n满地星红小绿，凤尖怕蹴香泥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22885,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"相思引","author":"沈士芳","text":"绣阁无心理翠鎞。\n臂环轻卸耳珰欹。\n鹧鸪香冷，频揭玉狻猊。\n雁婿衔霜传锦字，猧儿带月护铜扉。\n无多春色，又逐杏花飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22886,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"相思引","author":"沈士芳","text":"蟾影筛花印翠蚨。\n为寻粉蝶上兰陂。\n板桥怯渡，笑带柳枝扶。\n归路卸头灯背立，回波旖旎态摩挲。\n春图半幅，香阁背人摹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22887,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"许玉晨","text":"翠竹阴深暑未消。\n玉荷池畔暗香飘。\n半规月影上梧梢。\n团扇倩人涂蛱蝶，画叉唤婢捲蟏蛸。\n小屏风底换轻绡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22888,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"许玉晨","text":"枣花帘外西风紧。\n玉凫沉麝馀香烬。\n灯影暗银缸。\n梧桐叶打窗。\n此情谁共省。\n泪湿红巾冷。\n寒雨又凄凄。\n秋虫作伴啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22889,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"好事近","author":"许玉晨","text":"春水碧漪漪，鸂鶒下来双浴。\n恰被落红惊去。\n剩浮萍新绿。\n小栏花韵倍嫣然，香睡午晴足。\n困倚画屏深处。\n又风敲修竹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22890,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"金缕曲","author":"许玉晨","text":"昼永何当遣。\n向晴窗、开炉试茗，提壶洗砚。\n偏是珍禽檐间语，又唤绣床针线。\n谁省识、相思人倦。\n幸有墙东樱桃树，破东风、已觉红深浅。\n对妆阁，作清伴。\n凤城多少香轮碾。\n只闲门、一番新雨，绣苔凝遍。\n欲倩生花传幽绪，奈被江郎占断，但梦忆、故山清远。\n遥盼吴淞春波阔，恨锦鳞、不寄回纹转。\n馀芳泪，枕函泫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22891,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"风入松 秋夜","author":"范姝","text":"金风析析绕窗前。\n梧叶舞翩跹。\n空阶蛩语无休歇，不由人、无限凄然。\n天上月明如洗，桂枝影堕疏檐。\n砧残漏永如年，宝鼎喷馀烟。\n琵琶冷落无心拨，为闲愁、常锁眉尖。\n这苦向人难诉，还来题上花笺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22892,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏初临 药名闺怨，和周羽步","author":"范姝","text":"竹叶低斟，相思无限，车前细问归期。\n织女牵牛，天河水界东西。\n比似寄生天上，胜孤身、独活空闺。\n人言郎去，合欢不远，半夏当归。\n徘徊郁金堂北，玳瑁床西。\n香烧龙麝，窗饰文犀。\n稿本拈来，缃囊故纸留题。\n五味慵调，恹恹病、没药能医。\n从容待，乌头变白，枯柳生稊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22893,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"眼儿媚","author":"李素（冰心","text":"无端风雨到高楼。\n春思总悠悠。\n芙蓉帐外，水晶帘捲，恰好梳头。\n落花可惜谁人惜，空自付东流。\n伤心何限，红衫揾泪，绿酒浇愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22894,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 题画","author":"李素（冰心","text":"巧样妆成，风流微醉珊珊步。\n回头一顾。\n只恐金钗堕。\n瘦尽腰肢，背地将愁诉。\n何缘故。\n花前不坐。\n立得鞋儿破。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22895,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 西施梦武塘梅花和尚墓下有此种","author":"沈栗","text":"一别苏台不计春。\n浣沙石上草如茵。\n幻生花种也怜人。\n梦绕吴宫心独捧，香消南国态谁颦。\n小名低唤莫生嗔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22896,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"巫山一段云 梨花","author":"沈栗","text":"腻粉匀梅白，凝脂分杏红。\n盈盈神女下巫峰。\n院落自溶溶。\n淡淡黄昏月，轻轻杨柳风。\n一枝带雨逗娇容。\n多被晓烟笼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22897,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行 玫瑰","author":"沈栗","text":"日暖蜂喧，群芳开足。\n药栏烂漫非金谷。\n柔条弱刺惹罗衣，摘来蛱蝶犹相逐。\n蕊绽骊珠，花凝紫玉。\n秦楼初度霓裳曲。\n香分太乙殿中烟，相公服色新妆束。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22898,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"小桃红 李花","author":"沈栗","text":"缓步寻芳径。\n试把花枝问。\n一样春光不匀，红白此情难信。\n想花神、亦自冷心肠，故洗铅华尽。\n素质羞涂粉，色倩冰肌并。\n怪尔夭桃染脂，沉醉何时方醒。\n最怜他、结实对王戎，谪仙夸上品。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22899,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人 春绣","author":"李瑗","text":"妆成窗下寻花样。\n欲绣还思想。\n花枝朵朵不禁秋，只恐红颜易老、去难留。\n描来飞鸟知多少。\n只羡鸳鸯好。\n非关文彩故怜伊，惟爱双双交颈、不分离。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22900,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令 春冷","author":"毛媞","text":"耐过一番春冷。\n闪杀数枝花影。\n日日懒朝妆，闲却银床金井。\n烟凝。\n烟凝。\n柳外睡莺初醒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22901,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"丑奴儿令 春闺","author":"毛媞","text":"不知春色今如许，乱杀啼莺。\n酥雨浓晴。\n芳草茸茸隔夜生。\n琐窗深处无人见，别是幽清。\n此际心情。\n翻怪桃花照眼明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22902,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙","author":"毛媞","text":"一病凄然愁到骨，满园秋色萧条。\n枝枝败叶带烟飘。\n虫声吟转苦，为甚不辞劳。\n随意起来随意睡，西风削处如刀。\n梦魂飞过段家桥。\n茫茫云共水，西子或相招。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22903,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 晓起","author":"毛媞","text":"晓起梳头，尘满了、玉台明镜。\n试推窗，东风却比，西风还劲。\n乱树爱听黄鸟语，小园懒步红芳径。\n最堪怜、半好半残花，春如病。\n寒共暖，相为政。\n蜂与蝶，应争胜。\n只青青帝子，坐来端正。\n芳草也能迎淑气，丛兰别自成幽性。\n但小廊、一带曲阑干，闲堪凭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22904,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西地锦","author":"韩智玥","text":"宛转金铺春暮，翩跹绣褥寒迟。\n雨香云片披零下，东风着意禁持。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22905,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满庭芳 秋思","author":"韩智玥","text":"苇草传霜，残荷冒雨，白云随处安排。\n文心藻思，入梦总成灰。\n玉剪翻灯燕子，还消得、几遍徘徊。\n空惆望，五陵狂客，残病到秋来。\n风篁如醉，小山丛桂，罗绮绚霞裁。\n更北窗深处，蕉影苔阶。\n金粟愁关异代，谁招隐、花落花开。\n孤吟罢，双双翡翠，常绕碧栏回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22906,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 秋思","author":"陈翡翠","text":"阵阵金风吹未歇。\n雨扑风斜，渐近题糕节。\n欲采黄花盈袖折。\n隔墙啼鸟偏饶舌。\n檐马叮咚随打叶。\n强慰加餐，无奈愁肠结。\n罗袂飘摇愁病怯。\n篱边莫说囊萸日。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22907,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"喜迁莺 有怀","author":"陈翡翠","text":"谁能忘得。\n是前夜灯光，去年春色。\n月小时来，月高时去，梦里还呼堪惜。\n半吐半吞心事，难住难留踪迹。\n飘摇似、纥干冻雀，未成羽翼。\n相忆。\n分离处，换来骏马，纵好如何值。\n叶上荷珠，风前残蜡，能度几番朝夕。\n绝怪阿苏短倖，耳畔东东忘忆。\n含凄妒、燕脂赵粉，成双成匹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22908,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"三字令 寄锦树","author":"叶辰","text":"郎别后，误佳期。\n减腰肢。\n巫山梦，雨云迷。\n恨窗前，红日影，晓莺啼。\n慵梳洗，怕相思。\n上翠眉。\n珠泪滴，湿罗衣。\n又关情，花并蒂，燕双飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22909,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青玉案 咏手","author":"叶辰","text":"纤纤玉笋看如削，菱花细把乌云掠。\n彤管鸦黄初画学。\n炉香烧烬，自捲帘幕，红豆抛双雀。\n闲游漫数花间萼，双双戏挽秋千索。\n重整云翘归绣阁。\n停针暗想，情怀难却，闷把兰腮托。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22910,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春风袅娜 咏门神","author":"叶辰","text":"羡耻图鳷鹊，懒绘麒麟。\n随北富，任南贫。\n总相亲、解惜香封粉裹，窥园忘禁，窃药随人。\n月黑齐肩，日高对面，赏遍檐花不欠伸。\n衫薄怕沾梅后雨，命轻难看隔年春。\n颇怪天公懞懂，雌雄未配，两相看、俱是孤身。\n支薄俸，有椒尊。\n犬同值夜，鸡伴司晨。\n尽一样身材，难兄难弟，两般性格，宜喜宜嗔。\n借问当年，记题门旧字，至今寂寞，可剩馀痕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22911,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凭栏人","author":"叶文","text":"渺渺春风忆瘦腰。\n空见垂杨踠地飘。\n凭栏魂欲消，长条复短条。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22912,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 远眺","author":"叶文","text":"长安陌路。\n来往征车宁计数。\n底事关心，远隔天涯没信音。\n刚才捲幔。\n偏惹杨花争扑面。\n那得人归，只见黄莺作对飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22913,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"谒金门","author":"权贵妃","text":"真堪惜。\n锦帐夜长虚掷。\n挑尽银灯情脉脉，描龙无气力。\n宫女声停刀尺。\n百和御香扑鼻。\n帘捲西宫窥夜色，天青星欲滴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22914,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行","author":"权贵妃","text":"时序频移，韶光难驻。\n柳花飞尽宫前树。\n朝来为甚不钩帘，柳花正满帘前路。\n春赏未阑，春归何遽。\n问春归向何方去。\n有情海燕不同归，呢喃独伴春愁住。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22915,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙","author":"权贵妃","text":"花影重帘初睡起，绣鞋着罢慵移。\n窥妆强把绿窗推。\n隔花双蝶散，犹似梦初回。\n玉旨传宣呼女监，亲临太液池荷。\n争将金弹打黄鹂。\n台楼凌万仞，下有白云飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22916,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"花娇女 送皆令之西泠","author":"黄德贞","text":"芳草织前溪。\n去路迷。\n丝丝柳，难系片帆西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22917,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏歌辞 送皆令北游","author":"黄德贞","text":"飞絮萦香阁，横波绕画帘。\n都将烦恼意，付与别离船。\n白雪长安声价重，盼遥天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22918,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]