[{"title":"访刘伴霞鍊师不值","author":"高景光","text":"拟亲古镜照心心，来访仙人紫府深。\n红栈青岑凹凸画，云衣月幌短长吟。\n叩门稳卧松间鹿，放艇空张花下琴。\n两到山中不相见，临风搔首忆刘沈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13656,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"沧浪亭","author":"赵晓荣","text":"佳憩高秋得，孤亭曲径通。\n唤人空鸟语，照眼自霜丛。\n古寺寒烟里，遥山夕照中。\n缅怀苏长史，明月与清风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13657,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄凌叔子","author":"顾鸿志","text":"岁宴山中桂树枯，思君渺渺海云孤。\n春生驿路花开未，雪涴征衫雁到无。\n才子京华愁旅食，散人笠屐隐江湖。\n谁怜水国三千里，烟水苍茫一钓徒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13658,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆棹烟","author":"鲍冈","text":"双屐久不来，花径莓苔长。\n薄雾暝前村，春泉落清响。\n好怀谁共言，枯坐静尘想。\n不知修竹间，朗然明月上。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13659,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"东岩别后有忆","author":"王元文","text":"相晤了忘情，相别还增虑。\n入暮独登楼，幽怀澹无豫。\n遥忆烟雨中，孤舟泊何处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13660,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"棉田薙草行","author":"桂心堂","text":"东乡土高宜植棉，久雨草长青铺毡。\n田家妇女停织作，趁晴尽出芸中田。\n田在草间草没踝，赤日行天烈于火。\n手不停锄汗满襟，面目都化城中黔。\n暮归惊闻啼彻户，呱呱待哺儿饥苦。\n哺儿更虑奉姑迟，急入厨中煮粥麋。\n弥月劳劳心力计，棉高渐见花铃缀。\n悬耜惟思弄机杼，谁知及早完秋税。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13661,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"采莲曲","author":"桂心堂","text":"风吹藕花满路香，中流荡桨谁家娘。\n隔岸爱寻双菡萏，回波惊起两鸳鸯。\n采得莲心无所寄，藕丝不断系人肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13662,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和张渔山忆秦淮春柳","author":"王鼎","text":"多半春藏画槛边，酒醒人困絮飞天。\n生怜南国桃花涨，惯系东风鸭嘴船。\n绣箔吹香邀燕舞，钿筝弹怨恼莺眠。\n板桥斜日依稀是，小别婵娟又一年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13663,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"泛舟太湖","author":"王鼎","text":"双帆剪破碧玻璃，秋色空濛望欲迷。\n七十二峰何处好，夕阳一角洞庭西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13664,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杂兴","author":"张琦","text":"本无轩冕志，来结松下庐。\n东皋微雨过，愿言事新畬。\n开我床头瓮，撷我园中蔬。\n鹪鹩巢深林，一枝不求余。\n但检草木疏，而无货殖书。\n心不为形役，此乐谁能如。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13665,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登摄山最高峰","author":"张琦","text":"初疑天际峰，鸟飞不可度。\n石磴几盘旋，忽到绝顶处。\n渐觉远村低，微茫隐烟树。\n长江拍云来，欲挟众山去。\n上方犹夕阳，干林黯将暮。\n立久薄寒生，客衣湿云雾。\n我生幸何如，得投灵境住。\n心静闻天香，超然发深悟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13666,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晓过黄叶岭","author":"陈毅","text":"岭头孤店小，一径与山分。\n晓日明高树，篮舆破白云。\n野花村妇髻，乱石古人坟。\n黄叶初飞处，秋声不可闻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13667,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"湖港阻风","author":"陈毅","text":"刺骨寒风叹石尤，烟波东望迥生愁。\n早霜红树藏湖岸，残日青山满柁楼。\n已觉空囊归故里，何因歧路感深秋。\n思量蹇滞平生事，来去还应笑野鸥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13668,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怀蒋愚谷归吴门","author":"陈毅","text":"我闻蒋诩三年余，访之未遇城南居。\n昨叩松扉问童子，言向岣嵝求神书。\n苍烟满空暮色澹，红日下江天影虚。\n太湖七十二峰色，登高不见生踌躇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13669,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"暮春游贝氏园","author":"周琳","text":"一径穿林谷，垂条罥角巾。\n小亭浮树杪，古木卧溪滨。\n花气能留客，泉声解送人。\n匆匆理归棹，落日满城闉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13670,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋夜凌江阁与年瘦生谈往事","author":"张自坤","text":"征西往事不堪论，泪点深宵剑有痕。\n九夏冰霜真国士，卅年尘土旧公孙。\n绿车天上恩难再，裋褐扬州道自尊。\n一语请君重勘却，种瓜何必不青门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13671,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠陈雨亭","author":"佟应","text":"路上逢君一慨然，短衣破帽向人前。\n昔时曾记南楼话，劝汝归耕北郭田。\n四海论交谁纳履，十年谋道可忘筌。\n空思闭户终难得，仆仆风尘好自怜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13672,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游大慧寺","author":"常裕","text":"何处风铃急，松阴见败墙。\n尘封禅舍冷，草长戒台荒。\n有鸟鸣清昼，无僧话夕阳。\n断碑余字在，扪读一凄凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13673,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题自画山水","author":"德敏","text":"好山久不见，如与故人违。\n追写清宵梦，深扃破板扉。\n意随流水远，神逐白云飞。\n此地宜居我，沙头添钓矶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13674,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"同傅慕庵游万寿寺","author":"金良","text":"流水西郊路，谁寻净域游。\n我思偕贾岛，君意及汤休。\n山小行来曲，松高坐处幽。\n斜阳说半偈，红叶寺门秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13675,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闻雁","author":"金良","text":"客里挑镫正苦吟，无端天外寄愁心。\n霜横北地秋先老，月满南楼夜已深。\n远戍几时吹画角，孤村镇日响清砧。\n未知爪迹留何处，雪后沙边细细寻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13676,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"早春携鹤儿出郊","author":"查善和","text":"疲马单裘出郭门，绕堤得得又前村。\n官卑春草欺袍色，年长秋霜上鬓痕。\n老仆携茶行踯躅，稚儿索果语温存。\n繁华易惹青年恨，风雪荒寒黯客魂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13677,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨声","author":"查善和","text":"轻阴细雨作新凉，点滴间阶引兴长。\n准拟明年北窗下，绿蕉斜种两三行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13678,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"同申仙居游安陵禅院赠月五上人","author":"曹昕","text":"卫河回岸午钟沈，福地清幽试共寻。\n一径莓苔迎客净，四时花木掩关深。\n轻帆自幻风前影，逝水难留定后心。\n欲向已公参半偈，萧萧松际已潮音。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13679,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日杂感 其一","author":"曹昕","text":"渴鸟啄冰冰尽开，飞飞争唤好春来。\n谁人为忆孤山鹤，独唳东风怨落梅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13680,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日杂感 其二","author":"曹昕","text":"早暮惟闻鸟雀喧，小桃红蒂已衔残。\n庭前欲探春消息，二十四番风尽寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13681,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"饯郝坦中北归","author":"赵思","text":"挥手送君去，孤舟一水轻。\n野花分早暮，山气辨阴晴。\n别路应呼酒，残春自听莺。\n布帆无恙在，安稳到高城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13682,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"溪居","author":"牛克敬","text":"潺潺溪水绕柴扉，略与尘寰机事违。\n孤鹜自沈红日远，片帆遥指白云归。\n夏畦雨足间农少，野寺无僧晚磬稀。\n只有钓翁明月下，十千沽酒锦鳞肥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13683,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重过倪高士徵九池馆淹留竟日时主人在西山未归","author":"宫去矜","text":"记来长坂被秋兰，风磴依然苔藓瘢。\n傍母眠凫沿略彴，将雏语燕上阑干。\n碧梧又验三年闰，青竹微增六月寒。\n更爱殷勤留客意，一时檐溜作惊湍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13684,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江楼独眺","author":"余鹍","text":"万里长江百尺楼，远天缥缈望中收。\n烟边晓市依山集，雨后春潮入郭流。\n楚塞风涛千里壮，秦淮金粉六朝留。\n登临无限沧桑感，满目荒凉古石头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13685,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"衢州经先文襄公故垒","author":"李本楑","text":"故垒经行按旧图，功高耿邓想宏谟。\n长驱敢死三千士，大捷先书廿八都。\n刀剑于今变牛犊，穴巢终古绝狼貙。\n后人枉说书能读，愧煞龙钟作腐儒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13686,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"严州","author":"李本楑","text":"芊绵春草合，竹外发寒梅。\n山势依城转，江流抱郭开。\n澹烟群鸟去，微雨一帆来。\n回望严陵濑，清风满钓台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13687,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄醇民先生","author":"钱廷文","text":"茂树有高枝，清弦无细响。\n素交见生平，曾不为标榜。\n自我与夫子，幽巷通来往。\n散发坐茅亭，信宿得心赏。\n清梵激松风，禅寺邻书幌。\n主客共藜羹，闵子过周党。\n尺素隔层城，烟月劳梦想。\n嗟我倦游人，十年在草莽。\n书剑局高天，壮躯空慨慷。\n何处豁尘心，溪流晒渔网。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13688,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"移家就熙显宅","author":"钱廷文","text":"头白逢兹岁，家贫少定居。\n我行非得已，天意竟何如。\n晓日空囊外，秋风卧病余。\n不堪回眺处，烟水满寒墟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13689,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宿铁门","author":"吕公溥","text":"乌鸟巢深枝，游子走长路。\n一鸣桃花开，再鸣春山暮。\n茅舍多行客，谁不乐欢聚。\n夜短梦偏长，梦里还家去。\n才游何便归，欲语声吞吐。\n窗外鸡声来，天边雁声度。\n鸡喜报晨昏，雁飞知何处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13690,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"深秋","author":"杨维栋","text":"深秋白露垂，凉风砭余肌。\n布袍缝旋绽，游子待授衣。\n侧闻茅檐下，夜窗理残机。\n痴梦归乡郡，单身投柴扉。\n饥寒呼父母，涕洟如婴儿。\n悲声惊梦觉，依稀有乌啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13691,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"偕友人登虎山观音堆眺望","author":"刘沄","text":"虎山春暖共攀跻，飞步凌空下望迷。\n城郭万家无近远，烟云几处互高低。\n藐姑疑接神人迹，僧寺来寻旧日题。\n安得脱然游物外，不教尘世日栖栖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13692,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平台望雪和家东沧兄韵","author":"贾泽洛","text":"平台景物倏皑皑，一片军声袭蔡回。\n舞絮飞花千万树，浅斟低唱两三杯。\n关河歧径人难觅，村舍寒烟户半开。\n最是诗人幽兴极，疲驴破帽出城来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13693,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋山","author":"贾泽洛","text":"绝巘飞云叶，回峰挂薜萝。\n日光寒照浅，猿啸夜闻多。\n樵径沿溪入，蓬门向晚过。\n鸡豚秋正美，朝市兴如何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13694,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋原","author":"贾泽洛","text":"驱车登陇首，秋望兴悠然。\n禾黍分残雨，村墟淡野烟。\n钟声出古寺，雁影下长天。\n更欲寻摩诘，犹堪画辋川。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13695,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟陆放翁间中富贵","author":"贾泽洛","text":"贪眠常是卧高舂，炊米无烦论釜钟。\n苏陆诗篇新活计，江湖散客旧崇封。\n在庭花草随幽兴，出郭云山仗短筇。\n六十已过七十近，老翁岂合慕夔龙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13696,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"静坐","author":"朱瑶","text":"静里摊书坐，幽然蓬岛间。\n松深眠鹤稳，壁峭卧云间。\n倚枕听流水，开窗看远山。\n烟霞容我老，尘念顿无关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13697,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"芦花","author":"秦知域","text":"浪得花名久，萧萧白鹭洲。\n丛深缘近水，干弱易成秋。\n明月寒渔户，江风拂客舟。\n无须叹摇落，犹足代薪槱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13698,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"姑射山访神居洞","author":"秦知域","text":"秀气结壶口，姑射辟仙境。\n著屐访神居，络绎延清景。\n雨后岚欲滴，积翠撩人冷。\n松荫接藤缠，飞泉散碧岭。\n仙禽时一声，寂寂四山静。\n半日幽间趣，顿觉浮生永。\n鹿女还金阙，莲花开玉井。\n澄潭水一泓，上下光耿耿。\n杖策寻南洞，肃将衣裳整。\n拟拜绰约子，不见冰雪影。\n斫芝更斸苓，云深隔几顷。\n憩诵《南华》篇，肩吾笑夙秉。\n萧萧满林秋，日暮风涛警。\n恐是御龙归，悠然长引领。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13699,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杜曲","author":"祁琳","text":"杜曲回看十里霞，杏花村里酒帘斜。\n漫夸尺五风流地，已属城南处士家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13700,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日","author":"毛启凤","text":"梅梢月上影重重，春暖贪眠意更慵。\n倚枕不知天渐晓，忽闻山寺数声钟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13701,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"五夜","author":"陈一策","text":"五夜入孤村，冒寒人语少。\n鸡鸣两三声，残月挂林表。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13702,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"访友","author":"陈一策","text":"草堂新筑傍苔矶，城郭风尘到此稀。\n背闪夕阳双鸟没，屐黏晴雪一僧归。\n石桥水色虚摇槛，板屋梅花乱扑扉。\n今日似游人境外，与君相对欲忘机。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13703,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"与僧约游南山","author":"徐光义","text":"老僧为说南山胜，笑指诸峰迥不群。\n会待秋高残暑退，芒鞋同踏万重云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13704,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题摩诘诗后","author":"徐光美","text":"脱尽言筌应属注，一编酷爱辋川诗。\n幽篁琴韵太清绝，想见深林月照时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13705,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋雨","author":"陆曾蕃","text":"积雨苔痕绿，西风客舍寒。\n疏花垂短砌，湿鸟坐雕阑。\n贫贱依人老，关山行路难。\n感时空洗句，愁绝镜中看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13706,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日湖上","author":"刘文炜","text":"莼丝牵碧满湖浮，漠漠寒烟望里收。\n十里枯荷双鹭雨，两堤衰柳一蝉秋。\n白云钟断僧归寺，黄叶诗成客倚楼。\n犹有留人余兴在，数声短笛起渔舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13707,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山楼除夕","author":"刘文炜","text":"一身秋蝶抱寒花，卅载时光赴壑蛇。\n樽酒镫前都是客，溪山梦里暂还家。\n滴残午漏阑年雨，迎得春风半夜花。\n寂寂拥衾无稳睡，静听窗外噪林鸦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13708,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山行","author":"柴才","text":"二月二十二，乘兴入幽栖。\n霭霭浮元气，依依识故蹊。\n方春平仲绿，终日子规啼。\n路湿云初上，岩高日易低。\n泉声喧暗竹，陂影堕时霓。\n无异登元圃，何烦过虎溪。\n正堪流野日，长爱觅分题。\n斗酒弗为薄，山茶又更携。\n游丝横惹树，去燕旋遗泥。\n断石荒林外，千镫花塔西。\n共知仙女丽，莫学阮郎迷。\n一路经行处，清风独杖藜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13709,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题老桧","author":"郑炎","text":"树头亦有堪题处，半在疏疏落落中。\n今日画成晴叶响，不关鸟踏不关风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13710,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惶恐滩","author":"郑炎","text":"一匊文山泪，溶成惶恐滩。\n十年诗在口，今夜月同看。\n旧水流新恨，惊风激怒湍。\n浪高三百丈，不见石峰攒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13711,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"常山旅次闻笛","author":"郑炎","text":"谁家幽怨入新篁，客枕酸声梦苦长。\n四月梅花何处落，半堤杨柳此宵凉。\n愁深直恐青山裂，韵冷遥怜玉指香。\n一自李谟偷谱后，便随铃雨怨三郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13712,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春思","author":"叶菁","text":"百卉争妍日，阳和播鸟声。\n绿铺阶草软，翠贴沼荷平。\n明月梨花梦，春风杨柳情。\n何人吹玉笛，春思满江城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13713,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"天圣寺壁管夫人画竹","author":"蔡环黼","text":"琉璃宝地清于玉，掩映檀栾数科竹。\n乍道寻香檐卜林，忽疑驻屐筼筜谷。\n闻昔名闺管道升，唱随琴瑟住吴兴。\n奁中翰藻文人似，腕下丹青哲匠能。\n玉湖晴彩流香陌，钟磬无声梵王宅。\n鹿苑间停金犊车，龙宫新垩银泥壁。\n天女持花散道场，徘徊揄狄兴逾长。\n随身自有珊瑚架，侍婢还携翡翠床。\n净土无尘更莹拭，铜台砚发淋漓墨。\n攘腕经时阁笔看，错刀叶叶生鲜碧。\n东竿写罢又西筠，雨箨风梢骨力均。\n妙真兼胜苏居士，变化能无梅道人。\n贝树祇林共终古，一片苍烟满庭庑。\n琅玕影外石玲珑，残沈曾传松雪补。\n今古帷房第一俦，晶宫毕世足风流。\n仲姬应惜龙孙节，写向空门特地愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13714,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"洞霄宫 其一","author":"蔡环黼","text":"秋气清可娱，幽岩涤襟腑。\n夕阳催客行，归栖得洞府。\n人意近上皇，山境入太古。\n摘菜兰蕙丛，剪笋琅玕坞。\n世味不到山，芳菰香彻釜。\n凉月侵卧内，捣药闻禽语。\n曾食仙鼎丹，常年于此处。\n夜则鸣丁当，昼乃晦毛羽。\n仿佛青云人，文采不自诩。\n忽焉谷风号，如潮涌江浦。\n窗棂影动摇，知有林中虎。\n云昔晋郭文，乘骑不相忤。\n不同城市中，见者罗患苦。\n俄听金竹坪，曙色声钟鼓。\n起寻无骨箬，微霜白平圃。\n吾愿此终焉，不必鸾鹤伍。\n何为山中人，翻思游远所。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13715,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"洞霄宫 其二","author":"蔡环黼","text":"维宋设宫观，有使有提举。\n其制虽戾经，养贤丰禄糈。\n所以殿阁臣，引疾自华膴。\n南渡建炎中，内祠比京府。\n洞霄典物隆，主者皆宰辅。\n牧心作志书，惜未偻指数。\n后遂弗深考，漫列《朱子》主。\n校官祀《春秋》，徒然荐笾俎。\n遗献竟久湮，靡文此进俯。\n往者竹垞翁，翻史详为谱。\n姓名及爵里，因年分次序。\n百一十四人，历历可披簿。\n其中多名流，遗徽映岩户。\n应据曝书亭，作为邓志补。\n否且锓诸木，悬诸两庭庑。\n庶几垂不刊，来者目共睹。\n毋虚道院游，于是可道古。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13716,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山房听琴","author":"钱源来","text":"不识琴中音，但爱琴中趣。\n古曲荡烦声，玄音淡尘虑。\n山房春寂寥，曲涧寒泉注。\n泠泠水石间，幽人自相语。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13717,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"访梅道人塔步陈烛门师韵","author":"钱源来","text":"卖卜胥塘便作家，至今高致拂云霞。\n诗传画里千竿竹，易在枝头数点花。\n烟老秋庭笼古橡，雨添春水荐新茶。\n徘徊不觉寒林晚，独对西风数暮鸦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13718,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]