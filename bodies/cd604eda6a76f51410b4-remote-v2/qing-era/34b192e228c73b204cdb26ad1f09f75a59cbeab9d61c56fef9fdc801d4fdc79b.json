[{"title":"塞上即目俚言十首 其三","author":"缪烜","text":"杏花枝接榆，花簇如郁李。\n佳名榆叶梅，簪满村中姊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20911,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"塞上即目俚言十首 其四","author":"缪烜","text":"地寒无牡丹，芍药称奇绝。\n有花亦无香，开俟天中节。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20912,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"塞上即目俚言十首 其五","author":"缪烜","text":"玫瑰少色香，岩畔眼亦青。\n珠累子殷红，云是油瓶瓶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20913,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"塞上即目俚言十首 其六","author":"缪烜","text":"青青抽麦苗，短短疑田草。\n问之肩舆人，夏至割还早。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20914,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"塞上即目俚言十首 其七","author":"缪烜","text":"鸡犬楼窑顶，老小居窑腹。\n煤气?窑中，长年炕火燠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20915,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"塞上即目俚言十首 其八","author":"缪烜","text":"油麦与盐荠，富室供匕箸。\n六月菜园开，相邀踏青去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20916,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"塞上即目俚言十首 其九","author":"缪烜","text":"砂碛满羔羊，牧之货作息。\n盛夏亦披裘，妇女不纺织。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20917,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"塞上即目俚言十首 其十","author":"缪烜","text":"士而逐什一，试也竞词呈。\n贸易非游学，争归归化城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20918,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"水中丞偶插草花数枝，起身时犹未残落，惜而瘗之戏系以诗","author":"缪烜","text":"我本三生杜牧之，寻芳无处慰遐思。\n折将野卉酬春眼，分得新愁伴酒卮。\n未免有情同此席，若为继见待何时。\n墙阴土净堪藏艳，寄语花神好护持。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20919,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忽作","author":"缪烜","text":"忽作非非想，无聊解一时。\n世情竟若是，天道岂如斯。\n或者三杯酒，因之几句诗。\n闭门还闭口，客里自扶持。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20920,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"观吟香仙馆图，即寄杨补帆二首 其一","author":"缪烜","text":"百树梅花一草堂，人间雅俗本难量。\n侬家五亩田中宅，墙下团团种女桑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20921,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"观吟香仙馆图，即寄杨补帆二首 其二","author":"缪烜","text":"卅年前共西冷榻，中一相逢在溧阳。\n此日展图见三绝，知君犹未善刀藏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20922,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"病中率吟二首 其一","author":"缪烜","text":"从无得意遑知失，绝少欢悰那识忧。\n荏苒光阴同过客，朝冠袒裼总吾俦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20923,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"病中率吟二首 其二","author":"缪烜","text":"身腹饱温凭手口，多时辛苦少时閒。\n死生梦觉夫如是，不入空门入道关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20924,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒吟二首 其一","author":"缪烜","text":"安贫岂虑鬼傍笑，处贱难禁尉醉呵。\n长佩张公书百忍，家庭如是况其佗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20925,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒吟二首 其二","author":"缪烜","text":"无才不对天人策，无德不营安乐窝。\n阅尽古今夷佚传，瓣香私淑展禽和。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20926,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"淮阴钓台","author":"缪烜","text":"把竿本属英雄事，不见兴周八百年。\n屡过淮阴重回首，封齐毕竟逊前贤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20927,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"金筠庄家居困甚，闻有四明之招，尚不即赴，作此以励其行三首 其一","author":"缪烜","text":"食叶青虫化蛱蝶，落花依草恣蹂蹀。\n昨宵犹抱枯枝眠，朝忽翩翩斗蜂捷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20928,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"金筠庄家居困甚，闻有四明之招，尚不即赴，作此以励其行三首 其二","author":"缪烜","text":"树头黄雀跃且鸣，入水为蛤更其名。\n伯劳子规视相笑，泥涂何若泬寥清。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20929,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"金筠庄家居困甚，闻有四明之招，尚不即赴，作此以励其行三首 其三","author":"缪烜","text":"可知物亦恶茸阘，雄飞蛱蝶雌伏蛤。\n丈夫处世何归依，不为雌伏为雄飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20930,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清宵","author":"缪烜","text":"谁家急砧杵，吹堕空阶前。\n征雁又南飞，秋人凉未眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20931,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寒意","author":"缪烜","text":"庭菊初齐瓣，山枫正媚枝。\n晓衾寒欲动，独客最先知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20932,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"漫兴","author":"缪烜","text":"不羡荣通不丑穷，抱书握笔倏成翁。\n石渠天禄无缘到，杜库曹仓有路攻。\n辛苦也知嘲画虎，寂寥未敢鄙雕虫。\n两年此地寻佳句，时节萧条景物空。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20933,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"散步","author":"缪烜","text":"清明来客邸，云物犹凄凄。\n散步向南郊，雨晴途半泥。\n累累高下冢，不扫纷牧羝。\n岂无一主者，太息风俗迷。\n官堤曲北转，官杨皆生稊。\n河水流洋洋，漕艘雁字齐。\n浮家反知节，沽酒且杀鸡。\n过渡少村落，接湖多荒畦。\n桃花何处寻，得句无门题。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20934,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒谕二首 其一","author":"缪烜","text":"伍员暨乐毅，二子皆孤忠。\n一破楚一齐，事业将毋同。\n所贵主臣契，一心成大功。\n先王死已矣，后王为人蒙。\n相国乃浮鸱，将军遂冥鸿。\n后车鉴前车，哲士保厥躬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20935,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒谕二首 其二","author":"缪烜","text":"载妻作富贾，范蠡逃勾践。\n醇酒近妇人，信陵事淫湎。\n英雄际末路，无奈而豪遣。\n辟谷张子房，岂真弃轩冕。\n白衣仙骨人，衡山隐幸免。\n尉迟遒东施，云母铒愐㥏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20936,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"灯下读武安君传","author":"缪烜","text":"白起小竖子，为秦开封疆。\n可怜三晋卒，如虎驱群羊。\n八十九万命，累累魂归乡。\n彝陵至武陵，楚尸莫殚详。\n一剑赐杜邮，人胡为之伤。\n若使再将军，天下罹其殃。\n不必应侯忌，神鬼咻昭王。\n展卷恍血腥，阴风蔽烛光。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20937,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"读儒林传二首 其一","author":"缪烜","text":"正学原非阿世材，可堪辕叟老难回。\n司空城旦书何用，莫怪公孙侧目来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20938,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"读儒林传二首 其二","author":"缪烜","text":"汉家天子好文词，杨厉铺张乃得之。\n迎得申公偏尚简，虚他臧绾上言师。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20939,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"吕不韦","author":"缪烜","text":"钓奇贾嬴氏，吕贾贾绝奇。\n尚父尊无上，妖姬乐不疲。\n祸缘私假宦，死乃迫真儿。\n依样楚黄歇，嗟哉尽室夷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20940,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"留别学生孔义韩即送北上八首 其一","author":"缪烜","text":"柳花化为萍，到处相依结。\n簇簇水之涯，有时亦荐实。\n风来倏尔吹，东西各踪迹。\n所以旅游人，缅兹三叹息。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20941,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"留别学生孔义韩即送北上八首 其二","author":"缪烜","text":"浮云真我定，明晦态常閒。\n日月隔虽远，河山俯视间。\n未为雨润物，不作霞弄颜。\n荡荡复悠悠，飞同倦鸟还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20942,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"留别学生孔义韩即送北上八首 其三","author":"缪烜","text":"昆山有良玉，他山有矿石。\n以攻年复年，过者视默默。\n奚至贾不售，所虞瑕未洁。\n琢之又磨之，连城价无匹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20943,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"留别学生孔义韩即送北上八首 其四","author":"缪烜","text":"揽衣陟高山，不上还即下。\n中道无客足，眷言古学者。\n雪窗萤案閒，一晌酿藏写。\n漫诩春华浓，春华不我假。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20944,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"留别学生孔义韩即送北上八首 其五","author":"缪烜","text":"京华流品杂，结交须老苍。\n既得良友师，函席此徜徉。\n多闻且多见，勿正亦勿忘。\n门外车辙深，无殊居僻乡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20945,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"留别学生孔义韩即送北上八首 其六","author":"缪烜","text":"十年相聚处，游历况与俱。\n善子久而敬，怜予德不孤。\n归途快佳日，免世笑非夫。\n家食傥卜吉，一编友古儒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20946,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"留别学生孔义韩即送北上八首 其七","author":"缪烜","text":"聚首未有时，悬悬思两地。\n江南岁月深，冀北风霜厉。\n天雁与河鱼，音书各为寄。\n有讯及陈人，为言同老骥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20947,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"留别学生孔义韩即送北上八首 其八","author":"缪烜","text":"古语得才难，违经而往教。\n所期女器华，不病舍田耗。\n努力策高足，行远自迩到。\n秋来丹桂芳，盼折一枝报。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20948,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"贺陈毓瑞六十辰二首 其一","author":"章诚叔","text":"自识元方近卅年，相知推及季方贤。\n分途幽兖谋生活，故国河山感变迁。\n我愧辁材甘退处，君优制锦色常鲜。\n孝思不匮承遗意，瞻族怜贫仔一肩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20949,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"贺陈毓瑞六十辰二首 其二","author":"章诚叔","text":"解组归来足自娱，春江水暖漾双凫。\n桃源洞口寻芝草，桃浪溪头酌玉壶。\n生不逢辰冠早挂，岁临周甲杖堪扶。\n诘朝上巳同修契，万紫千红并入图。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20950,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏严子陵钓鱼台","author":"王希玉","text":"雷雨昆阳卓战功，芜亭麦饭几途穷。\n烽烟断处炊烟起，风雪芦花一钓翁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20951,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"七十述怀","author":"王希玉","text":"教养匪容易，况余只翼人。\n五更千里梦，百岁卅年身。\n耕战能开国，移家劣避秦。\n叮咛家祭日，有以慰双亲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20952,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"遣怀","author":"王希玉","text":"欲从乡语得乡音，南社东安几访寻。\n还读我书谁把卷，曾相识燕或巢林。\n怀中置印无人识，江上钞诗待客吟。\n到此始知邮电贵，家书足抵万黄金。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20953,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"无题六首 其一","author":"王希玉","text":"快绝幽灵忽四通，形骸脱尽自能聪。\n临流顾影荒溪上，面壁安禅古寺中。\n月洛参横思远道，微风疏雨感秋风。\n飘然还汝心清净，记取孤高北向鸿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20954,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"无题六首 其二","author":"王希玉","text":"颇闻邱陇上牛羊，绝代佳人此閟藏。\n几族野花惊冷艳，一枝病叶怯新霜。\n梦魂厮守徒虚语，生死相忘况异乡。\n料得泉台较安稳，东风无限拥牙章。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20955,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"无题六首 其三","author":"王希玉","text":"可怜人去更楼空，倘许黔娄怨谢公。\n大块文章烟景里，众人歌哭水声中。\n曾相识燕呢喃语，剩手栽花寂寞红。\n早悟无生无住理，买舟悔不小湖东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20956,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"无题六首 其四","author":"王希玉","text":"门前车马喧非我，憎未忘情爱更痴。\n无那众生迷义谛，好从太始證心期。\n蜂房蚁舍相凌突，马褐牛衣有等差。\n化翮笼樊霞举易，可怜根性更难移。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20957,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"无题六首 其五","author":"王希玉","text":"人生意味假还真，凤泊鸾飘是主因。\n昵爱逾暌斯愈恋，诚求相等故相亲。\n甘萦枕魇双方未，苦带梭肠一缕辛。\n悔惜河梁一携手，创痕渗作土花新。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20958,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"无题六首 其六","author":"王希玉","text":"平生伉俪兼师友，学术英伦世界先。\n始识造端夫妇论，鸢飞鱼跃自由诠。\n切磋道义兹无望，宝爱悲伤讵有年。\n若就国情衡损益，不徒遗恨抱终天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20959,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和月锄舅父","author":"王希玉","text":"诗人岂愿以诗鸣，聊将胸中块垒平。\n续座右铭崔子玉，哀江南赋庾兰成。\n辟肌自是能分理，目治何妨便手营。\n穷乃益工如不谬，伫看大集出觥觥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20960,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"读徐素庵先生慎馀斋稿一首","author":"张树培","text":"名缰利锁一般除，斋处慎馀学有馀。\n浑厚人争钦璞玉，清高我亦重璠玙。\n写怀杼柚慎成锦，放眼湖山月满庐。\n自恨芝容曾未识，瓣香何幸得遗书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20961,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题文玉徐君春游图照","author":"季念诒","text":"君游廛市我邺园，寂处同心莫轾轩。\n残月晓风思柳岸，黄鹂白酒话桃源。\n昔年刁斗多调护，此日桑麻纵笑言。\n矍铄地仙任游戏，醇醪呼取赌芳樽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20962,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏刀鲚二首 其一","author":"王源生","text":"自昔鱼肠将剑号，几时剑又幻鱼身。\n乘潮恍拥银刀队，溉釜能充玉馔珍。\n湖上腥风春二月，市中高价值千缗。\n杀机此日盈江海，跋浪长鲸惯逞人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20963,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏刀鲚二首 其二","author":"王源生","text":"江海搜材铁网宽，不祥金忽跃风端。\n本来李相胸中物，误佐王僚席上餐。\n用作和羹空此辈，操防伤手怪无端。\n比来名士多于鲫，试比铅刀一割难。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20964,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"河豚二首 其一","author":"王源生","text":"腹皤目睅状粗顽，浪得时名满世间。\n口腹中人常腊毒，肺肝如见善藏奸。\n征文误入吴都赋，窜迹难穷丙穴湾。\n正恐逋逃渊薮在，海风吹去又吹还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20965,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"河豚二首 其二","author":"王源生","text":"彭亨豕腹认前身，天与心肝好杀人。\n丑类横行惊水族，腥风扇动犯江神。\n明知性过豨蛇毒，犹道常逾鲙鳜新。\n当作羹材收鼎鼐，髯苏题品太无因。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20966,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"中秋看月","author":"王德爵","text":"捲帘看明月，月入树林中。\n为爱月色好，行过曲廊东。\n皓然见明月，清辉照太空。\n露珠沾薄袖，唧唧閒秋虫。\n明月不常圆，我生不常看。\n少壮能几时，勋业何物换。\n美人各一方，迢迢隔银汉。\n世事徒繁华，彩云终易散。\n独立明月下，搔首无穷叹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20967,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日偶成","author":"王德爵","text":"风尘今老矣，且乐我箪瓢。\n医学传三世，恩波沐五朝。\n襟怀常落落，心境自嚣嚣。\n春日浑无事，吟成信手钞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20968,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"怀内堂弟詹雪樵司马","author":"王德爵","text":"客燕呢喃寄一枝，碧窗水馆细评诗。\n西风黄叶秋声里，疏雨红镫夜话时。\n粟影此身同物外，杨花如梦又情痴。\n屋梁月色思君甚，忆否江南杜牧之。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20969,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"中秋无月","author":"王德爵","text":"月到江南不肯明，良宵风雨又纷纷。\n何人梁苑歌千里，今夜扬州欠二分。\n误我寻欢沽斗酒，负他学拜换罗裙。\n天公或惜思乡苦，故遣嫦娥隐白云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20970,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"平原道中","author":"王德爵","text":"远朝岱岳过城东，驴背吟哦句未工。\n荞麦花铺残雪白，疏林枣映夕阳红。\n人烟渐见荒村里，蛩语偏惊客路中。\n此去平原有公子，人情可与古时同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20971,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"岁残风雨满腹牢骚，拈笔长吟藉舒沈闷二首 其一","author":"王德爵","text":"西风残柝满城哀，挑尽青镫百感来。\n绿柳何堪经雨雪，紫云深悔出蓬莱。\n此生事业惟酬梦，来世天公莫派才。\n自愿无知如草木，和烟和雨老黄埃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20972,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"岁残风雨满腹牢骚，拈笔长吟藉舒沈闷二首 其二","author":"王德爵","text":"桃花林外酒旗飘，曾醉东风听绿幺。\n昔日疏狂齐阮籍，几人勋业似班超。\n草非指佞心终直，桐即知音尾已焦。\n万事不能能饮酒，月明戏举玉杯邀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20973,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春暮杂感","author":"王德爵","text":"一樽佳酿小园新，才罢迎春又送春。\n流水无心滋绿野，落花有梦怨红尘。\n年华似客留难住，世事如云认不真。\n逢个蜀僧清话久，宛然明月指前身。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20974,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"吕笛城明府以海运差附轮遭难闻讣往省垣公馆襄理丧务，感成二绝 其一","author":"王德爵","text":"孝子忠臣萃一门，不堪亲为赋招魂。\n会看俎豆千秋荐，克绍箕裘幸有孙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20975,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"吕笛城明府以海运差附轮遭难闻讣往省垣公馆襄理丧务，感成二绝 其二","author":"王德爵","text":"如君知己竟难寻，空抱才华少赏音。\n至此才知元旦谶，居然宦海共浮沈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20976,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"汪清纯夫子题唐六如课儿图七绝三首命步原韵 其一","author":"王德爵","text":"泌水衡门境自幽，即非高隐亦风流。\n须眉应合推前辈，何尚咿唔未肯休。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20977,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"汪清纯夫子题唐六如课儿图七绝三首命步原韵 其二","author":"王德爵","text":"安贫期继旧家声，不羡人间衣锦荣。\n手执一经閒课子，襟怀端让老先生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20978,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]