[{"title":"舍妹以病中四绝见示，原韵和之","author":"朱氏","text":"心清如水月堪知，病里光阴总强持。\n且祝维摩香一炷，待他否极泰来时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20083,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"白海棠和妹作用原韵","author":"朱氏","text":"清光如许照仙姿，那逊蟾宫第一枝。\n幽意自怜良夜永，庭阶瘦影月扶持。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20084,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和大姊时客保定拟共南旋","author":"朱佩兰","text":"针馀无事对花吟，静听凉蝉噪远林。\n海燕将归辞旧垒，塞鸿何处报新音。\n几番叶响催诗绪，一片砧声捣客心。\n帘押低垂风正定，笑携棋局到庭阴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20085,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春申墓","author":"朱佩兰","text":"故国今何在，重城古木昏。\n青山公子骨，香草美人魂。\n才可扶荆楚，灾先召棘门。\n霸图何处是，落日啸猿吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20086,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和大姊诗七夕","author":"朱佩兰","text":"序入新凉四壁秋，银河缥缈夜悠悠。\n香融粉席陈瓜果，彩舞瑶阶拜女牛。\n若道人间能乞巧，不教天上有离愁。\n笑他年少璇闺里，对月穿针静倚楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20087,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"白海棠","author":"朱佩兰","text":"秋来凉露浥琼姿，绰约摇风三两枝。\n今夜看花宜缟袂，晶帘素影月扶持。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20088,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蟾光","author":"朱佩兰","text":"蟾光清透碧窗纱，银汉无声斗柄斜。\n秋净长天浑似洗，夜深凉醒玉簪花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20089,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"病中简大姊","author":"朱佩兰","text":"别恨离愁写素笺，自春徂夏又秋天。\n伤心最是无家客，衣食年年出砚田。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20090,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日","author":"朱佩兰","text":"韶光淡荡媚春时，紫燕寻巢觅故知。\n对酒追思金谷例，看山旋忆谢公诗。\n新红嫩绿莺声滑，浅碧遥青蝶梦迟。\n一种闲吟消永昼，画阑低拂柳丝丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20091,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"课馀散步","author":"朱佩兰","text":"夕阳挂屋角，散步立方塘。\n绿树阴浓处，清风送晚凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20092,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"贺胡小城抱孙，次杨滨石韵","author":"郑经（守庭","text":"啼声小试菊花天，英物桓公称后先。\n竹叶香分人淡雅，兰芽秀茁日暄妍。\n含饴竞羡孙枝茂，绳武还将祖砚传。\n待得筵开周晬日，相看剑印时边悬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20093,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"偕胡修六都闲望滕王阁故址","author":"郑经（守庭","text":"客舍萧然揽夕晖，闲中野马动微微。\n烟横南浦平空卷，云落西山著地飞。\n簪芴百龄尘事起，晨昏万里素心违。\n幽州老将凭栏望，笑指秋原苜蓿肥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20094,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乙卯夏四月，将之都，留别巧卿词史二首 其一","author":"曹毓英","text":"不胜情处若无情，姿态虽妍骨不轻。\n每向灯前吟好句，屡从弦外听新声。\n浮沈薄宦卿怜我，摆脱红尘我望卿。\n北地苦无风月好，闷来惟取浊醪倾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20095,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乙卯夏四月，将之都，留别巧卿词史二首 其二","author":"曹毓英","text":"兹行总莫定归期，欲去回头意已痴。\n可有衷言持作佩，那堪别绪乱于丝。\n良缘未订三生约，青盼难酬一夕知。\n他日燕都逢郡友，幸贻尺素慰遥思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20096,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寄怀江宁张子莼太守四首 其一","author":"周赓良","text":"秋气薄林木，回飙鸣清商。\n长宵剧悽冷，揽衣起徬徨。\n推窗望霜空，夜色殊微茫。\n薄云歛缺月，吞吐娟娟光。\n数点南来雁，呼侣声悽怆。\n言念素心人，隔此天一方。\n大江不可越，惄焉摧中肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20097,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寄怀江宁张子莼太守四首 其二","author":"周赓良","text":"逆旅多烦忧，相思溯畴曩。\n忆自避兵初，出门何惘惘。\n一唱相逢行，此乐非意想。\n投分略年义，雄谈日抵掌。\n同续兰亭诗，更打秦淮桨。\n好山必共看，佳句亦同赏。\n人方羡攀嵇，我颇惭说项。\n何期天末风，吹散浮萍两。\n惟馀今昔怀，感旧增怅怏。\n良觌不可常，流光付歘恍。\n所以南皮游，悲来叹乐往。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20098,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寄怀江宁张子莼太守四首 其三","author":"周赓良","text":"戚戚岐路感，伥伥他乡愁。\n故园盛寇盗，安居渺难求。\n先人敝庐在，卜筑违林邱。\n风捲屋上茅，摇落当深秋。\n有如失林鸟，哀鸣声啁啾。\n输君决归计，早返澄江舟。\n松菊尚无恙，琴尊堪忘忧。\n桂花散如霰，高卧山之幽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20099,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寄怀江宁张子莼太守四首 其四","author":"周赓良","text":"世路多险巇，当关盛豺虎。\n投足偶不慎，适遭鼠辈侮。\n才大用本难，但可闭深户。\n愿葆松柏姿，弗与哙等伍。\n峨峨狮子山，空翠日翔舞。\n皎皎秦淮月，流晖满澄宇。\n期践就菊言，理楫待容与。\n极目吴山云，好振皋禽羽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20100,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"废宅赋别","author":"周赓良","text":"只为青蚨不济身，故庐兹已属东邻。\n可怜今夜权为主，才到明朝便作宾。\n燕雀有情犹恋旧，犬猫随我不知贫。\n殷勤嘱咐门前柳，他日经过陌路人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20101,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"阎典","author":"周赓良","text":"少府头衔署老兵，竟持卵与石相争。\n群山草合军容黯，大海潮回战血腥。\n三月孤城怜许远，万家同尽感田横。\n芙蓉花谢秋风冷，江上寒涛怒不平。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20102,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"费宫","author":"周赓良","text":"花为容貌铁为肠，幻作东宫帝女妆。\n拟把芳心柔乳虎，好凭皓腕刃天狼。\n几重罗绮酒痕湿，一片胭脂血点凉。\n毕竟难将成败论，荆卿终不负燕王。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20103,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"朱子磋明经归自饶阳，赋此赠之","author":"陆汝猷","text":"儒冠都傲骨，态肯乞谁怜。\n一任贫悬罄，终羞贱执鞭。\n绳长思繫日，瓯缺转忧天。\n雁户何时奠，萧条万井烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20104,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"村居","author":"陆汝猷","text":"为逃秦世乱，卜筑向江村。\n水曲绿环宅，山虚青到门。\n閒情消永昼，懒意话归云。\n时与携锄叟，寻幽夜色昏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20105,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夜坐","author":"陆汝猷","text":"绕枝鸟莫定，羁客睡能不？\n灯烬时腾燄，炉香不散愁。\n吟哦孤枕悄，花月小窗幽。\n惆怅春宵短，谭衷为久留。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20106,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"七夕追和玉溪生韵","author":"陆汝猷","text":"尘世频年苦乱离，几多良会误佳期。\n玉绳河畔牵情夕，锦字机中织怨时。\n不信风波天上稳，徒传环佩夜来迟。\n人间乞巧终输巧，枉度金针五色丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20107,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"燕","author":"陆汝猷","text":"红襟相舞语呢喃，门巷频来径自谙。\n故国乌衣休再问，年来劫火遍江南。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20108,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"残红次薛春泉丈韵","author":"陆汝猷","text":"连朝春雨妒嫣红，催落飞英小苑中。\n流水有香怜著色，夕阳成阵恨飞蓬。\n鞦韆影散裙斜曳，罗绮妆慵袖半笼。\n空使杜鹃啼血尽，祇馀艳质舞回风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20109,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"壬戌八月十一日作","author":"陆汝猷","text":"记说霓裳咏大罗，秋风我独困维摩。\n纯青一样围炉火，不战文雄战病魔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20110,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"中秋对月感赋","author":"陆汝猷","text":"何处桥堪綵杖通，广寒楼阙蕊珠宫。\n嫦娥此夜团圞思，天上人间两地同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20111,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题孙念贻丛桂留人图","author":"陆汝猷","text":"仙根月窟记前因，怅望天涯香满轮。\n暗祝吴刚斧休尽，分香留待后游人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20112,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梁溪署斋杂咏四首 其一","author":"陆汝猷","text":"署冷能消热闹肠，半瓯茶味一炉香。\n清斋近日添清课，始觉春来昼较长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20113,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梁溪署斋杂咏四首 其二","author":"陆汝猷","text":"沈思兀坐午窗晴，静里披吟思倍精。\n惟有两三枝上鸟，时来啼伴读书声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20114,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梁溪署斋杂咏四首 其三","author":"陆汝猷","text":"草舒嫩绿柳抽芽，对此春光倍忆家。\n料得轩窗兰数本，幽香定发几枝花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20115,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梁溪署斋杂咏四首 其四","author":"陆汝猷","text":"几夕吹嘘暖润泥，瀛洲草绿长应齐。\n杏花等是怀人思，争羡春风骋马蹄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20116,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"都行赠别内作二首 其一","author":"陆汝猷","text":"春风二月杏花天，草欲成茵柳著棉。\n不是男儿好离别，争名恐后祖生鞭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20117,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"都行赠别内作二首 其二","author":"陆汝猷","text":"芸窗廿载苦埋头，才喜今朝得壮游。\n好待报章秋有约，双星良会拜牵牛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20118,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"旅中不寐有作","author":"陆汝猷","text":"夜不成眠恼漏迟，披衣兀坐倚篷时。\n行踪到处同萍梗，别梦连宵怅柳枝。\n易长愁苗花夜合，难抛情种豆相思。\n明朝又作寻巢燕，未识朱门更傍谁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20119,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题南昌万硕卿诗稿","author":"陆汝猷","text":"羡煞生花笔一枝，坡仙才调谪仙辞。\n吴中行脚添游记，江右风流赖主持。\n湖海论交高孰数，诗书结习傲难医。\n笑余等是红尘客，浪迹天涯鬓欲丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20120,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题团扇画美人为吴杏香作","author":"陆汝猷","text":"鸾丝未拨已关情，始信无声胜有声。\n离合悲欢原了了，弹来只恐太分明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20121,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十五夜对月有作和刁同年梅霖韵","author":"陆汝猷","text":"客中四度月团圞，半倚篷窗半据鞍。\n料得深闺今夜思，计程应说到长安。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20122,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"将抵都门安平早发作","author":"陆汝猷","text":"长堤雨过绝尘埃，晓旭曈昽霁色开。\n万里都门原不远，五云深处是蓬莱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20123,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"舟次维扬偶成三首 其一","author":"陆汝猷","text":"满城风雨泊孤舟，一枕篷窗动旅愁。\n记得前年春社后，曾随飞燕傍朱楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20124,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"舟次维扬偶成三首 其二","author":"陆汝猷","text":"维扬风景昔繁华，此日箫声听恐差。\n只有隋堤旧杨柳，秋风数点剩栖鸦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20125,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"舟次维扬偶成三首 其三","author":"陆汝猷","text":"雨昏云暗暮钟沈，绛蜡频烧夜渐深。\n敧枕几回思稳睡，数声新雁引乡心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20126,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"宿迁道中晓行和祝惕臣同年韵","author":"陆汝猷","text":"五夜寒威逼曙霜，挑灯起自叠行装。\n年来销尽轮蹄铁，都为功名两字忙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20127,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"沂州李家庄题壁和吴中许令芬女史韵二首 其一","author":"陆汝猷","text":"白杨衰草警新寒，袖掩征衫尚一堪。\n到处留题泥爪印，我刚北去雁刚南。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20128,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"沂州李家庄题壁和吴中许令芬女史韵二首 其二","author":"陆汝猷","text":"一樽红友扫离愁，泰岱期登最上头。\n归去吟囊重检点，记曾醉眼小齐州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20129,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"腊杪喜晤向缪两孝廉来都数日即移寓内城，作此以赠","author":"陆汝猷","text":"芙蓉江上孝廉船，京邸相逢悟夙缘。\n正喜连床同话旧，如何橐砚又逃禅。\n名经定许题千佛，法曲应偕咏众仙。\n我怅萧斋转岑寂，强携樽酒送残年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20130,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"众兴题壁","author":"陆汝猷","text":"车牵间关半月程，陆行迢递复山行。\n明朝喜泛清江棹，稳挂归帆听水声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20131,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"癸丑浙闱奉调帘差因格于例，明经科未与考者凡五人出闱后，蒋颖生大令以闱中和中丞监临原韵七绝四首见示爰次韵感赋四首 其一","author":"陆汝猷","text":"愧说香分贡树来，銮坡应诏待量才。\n如何一例栽花手，谱订群芳别占魁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20132,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"癸丑浙闱奉调帘差因格于例，明经科未与考者凡五人出闱后，蒋颖生大令以闱中和中丞监临原韵七绝四首见示爰次韵感赋四首 其二","author":"陆汝猷","text":"换骨曾闻说道家，能教银海老无花。\n烧丹我乏神仙分，九转终惭火候差。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20133,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"癸丑浙闱奉调帘差因格于例，明经科未与考者凡五人出闱后，蒋颖生大令以闱中和中丞监临原韵七绝四首见示爰次韵感赋四首 其三","author":"陆汝猷","text":"鸿爪重寻十四年，云泥判隔竟无缘。\n天梯咫尺终嫌远，未许霓裳会众仙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20134,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"癸丑浙闱奉调帘差因格于例，明经科未与考者凡五人出闱后，蒋颖生大令以闱中和中丞监临原韵七绝四首见示爰次韵感赋四首 其四","author":"陆汝猷","text":"境想高寒月倍明，楼台七宝竞妆成。\n剧怜天上清虚府，空署仙曹籍后名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20135,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"病中书怀","author":"陆汝猷","text":"战罢文坛力尚遒，那经小病迫深秋。\n未谙医术慵投剂，恐累亲忧强说瘳。\n拥袖惊馀风料峭，挑镫听尽雨飕飗。\n连朝作势催寒至，旧典青袍熨贴不？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20136,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晚春卧病","author":"谢调元","text":"相怜祗贫病，此语信非诬。\n风捲林花入，春归庭草芜。\n小蜂才护蜜，新燕又将雏。\n二竖何时退，呼儿看药炉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20137,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"小园","author":"谢调元","text":"微雨过荒园，葱翠如膏沐。\n春池长鱼苗，生意一何速。\n乱石上青苔，层阴下乔木。\n朝暾乾鹊鸣，夕烟倦羽宿。\n开门足静观，聊以娱心目。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20138,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"偶成","author":"曹鉴彝","text":"卒岁此优游，閒情付狎鸥。\n山川化陈迹，风雨此登楼。\n举世无青眼，而今竟白头。\n故乡归未得，乘化复何忧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20139,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"甲申游蜀乙酉夏闻亲病遄归感而赋此二首 其一","author":"胡本绅","text":"归计迫匆匆，征程百感丛。\n光阴惊过鸟，事业慨冥鸿。\n囊累刘公解，途嗟阮子穷。\n一年流水逝，惭愧说桑蓬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20140,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"甲申游蜀乙酉夏闻亲病遄归感而赋此二首 其二","author":"胡本绅","text":"何事复盘桓，因人热总寒。\n扶舆空羡岳，贳药急需韩。\n世味谙鸡肋，浮生藐鼠肝。\n愿今归去也，菽水久承欢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20141,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"到家口占以慰内子","author":"胡本绅","text":"崎岖历尽又归来，半载愁颜一笑开。\n室免漂风安梓舍，天留爱日永兰陔。\n立锥岂遂真无地，避债何妨再筑台。\n自有千秋卿识否？\n白云深处胜蓬莱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20142,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"九折","author":"胡本绅","text":"王阳叱驭上危陂，为国忘身礼亦宜。\n我是江南寒素士，因何乘险历嵚巇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20143,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临邛酒肆","author":"胡本绅","text":"驷马高车大丈夫，如何拙计事当炉。\n不知捧节临邛日，腆面羞颜酒肆无？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20144,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寿吴翊之先生九十","author":"胡本绅","text":"古人重忧勤，忧勤皆寿考。\n今人贪欢娱，欢娱多折夭。\n延陵有封翁，齿德为国宝。\n年逾洛水英，貌比商山皓。\n诗书课子孙，田园足蔬稻。\n福寿有如斯，梓桑都压倒。\n谁知驹犊年，驰驱无暮蚤。\n迨乎烟尘生，栩棘集羽鸨。\n施舍及存亡，诚求还赤保。\n抱此饥溺心，乡闾忘旱涝。\n天道每好还，报施争迟早。\n燕山窦禹钧，阴德回苍昊。\n磨鍊出精神，胜食安期枣。\n从古晚晴佳，夕阳无限好。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20145,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"小楼二首 其一","author":"陈裔仲","text":"明社忽已屋，犹存天盖楼。\n愤时当易代，而我复蒙忧。\n登眺会多暇，壮怀行自休。\n楹书未忍弃，留为后人谋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20146,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"小楼二首 其二","author":"陈裔仲","text":"存没已多感，悠悠将母心。\n抚躬惭自立，祝发复登临。\n高挹山光媚，俯看江水深。\n不才世相弃，无暇涕沾襟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20147,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"狐火","author":"陈裔仲","text":"阴邪忌疾文光耀，突然嘻出鬼夜叫。\n明铅宋椠作庭燎，陈涉篝灯祖龙笑。\n居人方病药难疗，冥冥疑有气相召。\n北风妃豨助呼啸，烬馀化作零星爝。\n方今白腹据津要，教学黜经此同调，书乎书乎天不吊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20148,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题亡室涧蘋遗稿 其一","author":"陈裔仲","text":"新样衣妆淡淡容，思君空自泪沾胸。\n一年倏忽秋风早，惆怅红颜不耐冬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20149,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]