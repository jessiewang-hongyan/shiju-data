[{"title":"悼亡百绝句 其九十三","author":"许传霈","text":"人亡犹得说琴存，人断琴弦莫与论。\n地白林空残月夜，凄风旧调孰新翻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15427,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其九十四","author":"许传霈","text":"珍重添衣禦雪风，天公白遍浙西东。\n不图寒恋同衾者，偏在郊原衰草中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15428,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其九十五","author":"许传霈","text":"每逢佳节拜团圆，今夕年除形影单。\n依样筵前双画烛，无端催烬一条残。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15429,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其九十六","author":"许传霈","text":"岸南归殡北归魂，漫道幽明隔者番。\n遥指山头迎夏盖，缟衣盍认自家门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15430,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其九十七","author":"许传霈","text":"烂醉归来说贺年，灯灺人散和衣眠。\n而今冷醒藤床后，未见肩头覆薄棉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15431,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其九十八","author":"许传霈","text":"家祭原从生者禄，休将官诰此时疑。\n辉煌补服描鸡鸠，权把匡宗后嗣期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15432,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其九十九","author":"许传霈","text":"镇日端居苦索思，遗容相对寂无辞。\n算来汝亦多情甚，我在尘红那得知？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15433,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其一○○","author":"许传霈","text":"时贤题赞尽留名，逊我清言道实情。\n吟罢巳盈诗百首，要知字字泪珠成？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15434,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"山池晚步","author":"胤禛","text":"夕阳斜映绿波清，闲傍长桥步屧行。\n山静鹿过衔瑞草，溪平鱼泳趁飞英。\n濛濛岚气侵衣润，款款香风扑面轻。\n徒倚景光天欲暮，凌虚楼阁带霞明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15435,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏自鸣钟","author":"胤禛","text":"巧制符天律，阴阳一弹包。\n弦轮旋密运，针表恰相交。\n晷刻毫无爽，晨昏定不淆。\n应时清响报，疑是有人敲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15436,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日泛舟","author":"胤禛","text":"兰舟宛转浪纹平，一棹容与荡晚晴。\n上苑春深芳草绿，西山落照远峰明。\n长空鸦返千林暝，绝塞鸿归万里情。\n缥缈中流凭览胜，始知仙境有蓬瀛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15437,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夜坐","author":"胤禛","text":"独坐幽园里，窗开竹影斜。\n稀闻更转漏，但听野鸣蛙。\n活活泉流玉，溶溶月照沙。\n悠然怡静境，把卷待烹茶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15438,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春暮登楼","author":"胤禛","text":"坐惜芳华晚，登楼独举觞。\n眼看春色暮，行踏落花香。\n藻密鱼堪隐，林深鸟易藏。\n凭栏无限思，新月逗清光。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15439,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"月夜对落花有感","author":"胤禛","text":"落花满径月朦胧，夜静闲吟料峭风。\n烟外钟声来院落，天边桂影入帘栊。\n萋萋芳草春将去，冉冉韶光酒莫空。\n新绿成阴红紫减，清和天气正冲融。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15440,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"月下独酌","author":"胤禛","text":"春月娟娟映水清，一斟一酌听泉声。\n微风暗拂花枝动，几点残红扑酒罂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15441,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春院小饮","author":"胤禛","text":"春深红紫映楼台，槛外风香花尽开。\n东海玉盘看乍涌，恰逢童子抱尊来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15442,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雨霁","author":"胤禛","text":"节届清和春未赊，看山不厌半云遮。\n微风扇暖蒸新雨，为我催开后院花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15443,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"立夏","author":"胤禛","text":"熏风吹水绿于苔，羲驭徐催朱夏来。\n堤畔龙鳞皴古柏，庭前兔目绽新槐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15444,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"畅春园芍药花开作","author":"胤禛","text":"首夏清和殿阁开，园中景物足徘徊。\n翩翾紫燕衔泥去，睍睕黄莺过水来。\n槐影初圆当永昼，桐阴渐引上层台。\n更怜芍药临风好，香袭书帏锦作堆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15445,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"花间小饮","author":"胤禛","text":"长夏初临芍药开，熏风拂席送香来。\n仙姿绰约翻红袖，月影婆娑照绿杯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15446,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晓晴","author":"胤禛","text":"晓起浮窗日色明，苔痕滋碧露光莹。\n绕阶几树看花发，对岸一声听鸟鸣。\n波剌游鱼翻浪急，低徊舞蝶傍帘轻。\n春云漠漠寒偏峭，默乞天公十日晴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15447,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"宫中直宿作","author":"胤禛","text":"宝殿烛辉煌，承恩宿未央。\n御炉香不烬，宫漏滴初长。\n阶砌移花影，罘罳透月光。\n太平无一事，常愿奉君王。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15448,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏日读书","author":"胤禛","text":"夏日书斋静，荷风拂槛来。\n芬芳盈几席，翠帙带香开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15449,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"早行","author":"胤禛","text":"早行晴野树如烟，日出东山映绣鞯。\n寂寂荒村临水际，翩翩飞鸟向云边。\n空濛朝露侵衣润，艳冶闲花入目妍。\n扈从銮舆承色笑，欣随豹尾快扬鞭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15450,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江边书屋","author":"胤禛","text":"湍响听泷泷，帘开对大江。\n园幽人迹少，把卷倚南窗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15451,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晚登海河楼","author":"胤禛","text":"晚景登楼望，波涵夕照明。\n观澜清俗虑，倚槛动诗情。\n孤鹜冲霞去，扁舟向海行。\n悠然尘境远，惟听棹歌声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15452,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题友人园","author":"胤禛","text":"峁堂气象幽，墙角绕清流。\n雨霁西山近，风来北牖秋。\n疏檐看皓月，轻舫逐浮鸥。\n即景陈杯斝，心期好自由。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15453,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赐观金莲花","author":"胤禛","text":"异种遥从塞外传，香台曾为捧金仙。\n檀心吐艳熏风里，钿朵含芳积翠边。\n月殿桂飘难比瑞，秋篱菊绽不同妍。\n移来御砌增佳玩，千叶休夸太液莲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15454,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"友人书屋","author":"胤禛","text":"羡君潇洒致如仙，心远何妨地更偏。\n雨洗岚光青入牖，风摇竹影绿当筵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15455,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雨窗","author":"胤禛","text":"茅檐飞细雨，爽气乍侵人。\n移榻临窗坐，诗怀自觉新。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15456,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"热河园中避暑","author":"胤禛","text":"别业遥连上苑边，承恩避暑兴怡然。\n兰舟晓泛清波里，荷盖擎珠颗颗圆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15457,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏日泛舟","author":"胤禛","text":"殿阁风生波面凉，溯洄徐泛芰荷香。\n柳阴深处停桡看，无数纤鯈戏碧塘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15458,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"园中即景","author":"胤禛","text":"林亭幽静晚风凉，水气侵衣荇藻香。\n好景片时期莫负，开窗披卷意徜徉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15459,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晚泛","author":"胤禛","text":"画桡闲泛暮霞明，风细波微暑气轻。\n更转碧山寻胜迹，恰逢双鹤似相迎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15460,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"月下闲步","author":"胤禛","text":"闲行曲岸边，西岭暮苍然。\n草蔓迷幽径，桥危咽细泉。\n溪风吹缓带，夜色逼吟肩。\n徙倚看林杪，云间月影迁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15461,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"观雨","author":"胤禛","text":"密雨如膏洒碧丝，稻花漠漠绕长陂。\n虚斋睡起推窗看，私喜甘霖正及时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15462,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"前廊","author":"胤禛","text":"曲廊斜转接修篁，坐倚层岩意兴长。\n细草敷荣侵塌绿，野花争艳袭衣香。\n碧梧枝上听蝉躁，翠柳堤边看鹤翔。\n此际闲身无一事，怡然啸咏自徜徉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15463,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"书斋秋暝","author":"胤禛","text":"幽斋新雨后，爽气泛池荷。\n碧落疏星淡，晴窗皓月多。\n隔花闻漏滴，倚枕和渔歌。\n更爱流萤好，悠扬拂槛过。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15464,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"恭侍奉乾清宫","author":"胤禛","text":"殿阁参差际碧天，玉阶秋草静芊绵。\n云开北阙祥光满，雨过西山霁色鲜。\n宝座金炉香蔼蔼，彤墀仙掌露涓涓。\n承欢频荷温颜接，凛惕趋跄绣扆前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15465,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"中元侍从","author":"胤禛","text":"中元令节庆皇州，云散晴空暑气收。\n薄海兆民歌大有，钧天广乐奉宸游。\n瑶星合彩兰盆映，银蕊分光莲浦浮。\n灯光交辉看似昼，圣情怡豫太平秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15466,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"运河舟中二首 其一","author":"胤禛","text":"扈跸乘文舸，沿流阅运河。\n晓窗飘白絮，夜岸沐金波。\n酒幔篱边扬，渔舟苇畔歌。\n长途看美景，偏觉此中多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15467,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"运河舟中二首 其二","author":"胤禛","text":"解缆放中流，晨光漾桂舟。\n远村烟淡淡，野老意悠悠。\n抛粒游鱼聚，依萍乳鸭浮。\n水天同一色，疑是泛瀛洲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15468,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"登望海楼","author":"胤禛","text":"观海登楼日未斜，晴空万里浮云霞。\n才经一阵风过槛，倏起千堆雪卷花。\n贝阙鳌峰如可接，鹏津鲛室岂终遐。\n诡词未许张融赋，到此方知语不夸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15469,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"自鸣钟","author":"胤禛","text":"八万里疏域，恩威悉感通。\n珍奇争贡献，钟表极精工。\n应律符天建，闻声得日中。\n莲花空制漏，奚必老僧功。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15470,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏玉泉山竹","author":"胤禛","text":"御园修竹传名久，嫩筱抽梢早出墙。\n雨涤微尘新浥翠，风穿密叶澹闻香。\n低侵幽涧波添绿，静幂虚窗影送凉。\n更羡坚贞能耐雪，长竿节节挺琳琅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15471,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋夜","author":"胤禛","text":"新秋秋月照虚檐，寂历山扉夜不关。\n默坐焚香遗万虑，潇潇梧竹水潺湲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15472,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晚晴","author":"胤禛","text":"雨余林隙漏斜曛，石砌幽花似茜裙。\n爽气渐来残暑退，移床岩畔看秋云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15473,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"听禅","author":"胤禛","text":"幽斋人迹少，禅翼响疏林。\n大火方流序，微凉早托音。\n乍听分远近，欲觅隐高深。\n旦夕轩亭外，清机伴我吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15474,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题刘松年画","author":"胤禛","text":"潇洒松年画，丰神迥不群。\n松杉相间秀，风水自成文。\n柔橹轻随浪，苍山半入云。\n超然三岛境，何处得尘氛？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15475,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临流","author":"胤禛","text":"脉脉清渠绕舍流，移床就柳坐溪头。\n镜涵霁影浮斜日，波映寒光报早秋。\n村畔砧声听渐暝，林端蝉翼噪逾幽。\n此中偃息容疏懒，底用乘槎海上游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15476,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"扈跸途中观获","author":"胤禛","text":"秋爽猎边城，天高气象清。\n登场占物候，观获畅皇情。\n岩谷萦车骑，云霞拂旆旌。\n豫游叨扈从，薄劣愧恩荣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15477,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"塞外中秋","author":"胤禛","text":"驻跸边庭夜，中秋一镜圆。\n遥从沧海畔，飞落碧峰颠。\n溢彩浮尧斝，流辉拂舜弦。\n坐深光愈迥，景物倍清妍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15478,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"大猎","author":"胤禛","text":"五校雕工劲，三秋野兽肥。\n乘时讲武事，大狝振兵威。\n狡兔宁藏迹，封熊悉入围。\n猎归数军实，落日照龙旂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15479,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"塞外秋兴二首 其一","author":"胤禛","text":"路出关山外，秋空日渐高。\n清霜凝晓旆，寒色透征袍。\n风劲飞鹰捷，川长猎骑豪。\n皇威扬四远，边徼戢弓刀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15480,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"塞外秋兴二首 其二","author":"胤禛","text":"驻跸依林麓，风多野水鸣。\n旌旗飘暮霭，铙吹咽边声。\n鸡塞霜逾白，龙沙风更清。\n却看行殿外，诸部尽欢迎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15481,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题范蠡载归图","author":"胤禛","text":"独有艰危时，方见子臣职。\n吴越争雌雄，彼此各努力。\n夫差好拒谏，只为红颜惑。\n所以范大夫，留之恐倾国。\n功成载归湖，斯意无人识。\n朗然照青史，去往皆可式。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15482,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"答友","author":"胤禛","text":"笔健如锥世共称，开缄但觉雾云兴。\n深藏未许悬斋壁，直恐龙蛇带雨腾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15483,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"瀛台泛舟二首 其一","author":"胤禛","text":"春深游上苑，鼓枻荡中流。\n波涌方壶岛，林开翡翠楼。\n落花飘两岸，垂柳拂扁舟。\n此日欢无极，君恩被特优。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15484,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"瀛台泛舟二首 其二","author":"胤禛","text":"暮转西池棹，风微锦波平。\n蜻蜓闲自得，鸂鶒递和鸣。\n举网双鳞获，停杯四韵成。\n仙山何处访？\n此即是蓬瀛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15485,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"即事","author":"胤禛","text":"当昼垂帷静，晴和景物佳。\n铺笺摹古帖，披卷畅幽怀。\n槛外花香度，帘前燕语谐。\n日长真似岁，绿竹伴虚斋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15486,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"初夏至玉泉山","author":"胤禛","text":"绿野熏风至，夜来春已过。\n扑衣飘落絮，贴水出新荷。\n浪暖鱼吹沫，泥香燕作窠。\n林泉聊命酒，披拂爱烟萝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15487,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"书斋坐雨","author":"胤禛","text":"长夏书斋静，云低拂讲帷。\n竹风扫翠石，荷雨滴清池。\n逸兴开新酿，闲情检旧诗。\n晚凉生几席，团扇不须披。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15488,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"午日","author":"胤禛","text":"天中节届日逾赊，解愠熏风透薄纱。\n处处相酬三角黍，家家笑馈五时花。\n薄觞引满巡筵转，桂楫如飞竞渡哗。\n四海纤邪消影迹，佩符何用绘丹砂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15489,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"便殿恭侍","author":"胤禛","text":"承欢便殿接天香，披拂熏风爱日长。\n时雨连朝滋稻垄，晴霞一片映湖光。\n凛遵圣训闻诗礼，勉竭愚忱效颂扬。\n浩荡恩波沦亿兆，衢歌喜听祝无疆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15490,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"狼居胥山大阅","author":"胤禛","text":"帝为生民计，狼胥阅大兵。\n穷荒金鼓震，朔漠旆旌明。\n令出山川动，威扬神鬼惊。\n技娴百战勇，恩重一身轻。\n预卜妖氛散，悬知海宇清。\n彼狂擒子献，蠢尔倒戈迎。\n遁去浑无路，争归尽布诚。\n鹰抟驱鸟伏，螳臂骇车行。\n不惮疏方远，惟期边塞平。\n濡毫歌懋烈，吉日愧难赓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15491,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"功成回銮恭颂二首 其一","author":"胤禛","text":"指顾靖边烽，怀生尽服从。\n遐荒归禹甸，大漠纪尧封。\n庙算无遗策，神功迈昔踪。\n凯旋旌耀日，光景霁天容。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15492,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"功成回銮恭颂二首 其二","author":"胤禛","text":"翠华旋万里，即日解征袍。\n共仰神机邃，深维圣体劳。\n凯歌喧后队，巷舞迓前旄。\n拓土无中外，皇猷协覆帱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15493,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"扈跸山行","author":"胤禛","text":"紫塞秋山丽，霜枫锦作堆。\n草深麋鹿伏，风急雁鸿来。\n瀑水穿林响，寒花向日开。\n忻随清跸后，揽辔重徘徊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15494,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"塞外观稼","author":"胤禛","text":"边陲环沃壤，树艺遍皋阳。\n东作频沾雨，西成未陨霜。\n两岐占瑞应，遗秉见丰穰。\n比户盈宁日，衢歌感圣皇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15495,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"观鱼","author":"胤禛","text":"羽卫随行幄，逶迤绿水隈。\n棹分寒藻入，波涌锦鳞来。\n网罟无空举，鳣鲂自暴腮。\n烹鲜供御馔，竟日豫清徊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15496,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"冬日圣驾自塞外回銮谒陵恭纪","author":"胤禛","text":"威德绥荒服，乘舆按部回。\n欢声盈朔漠，瑞蔼被龙堆。\n鞭拂霜花净，旗飘野吹开。\n更遵丰沛路，陵殿荐尊罍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15497,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"陪京","author":"胤禛","text":"新丰传旧里，今睹濯龙池。\n天地开神奥，山河启帝基。\n金戈劳百战，玉叶衍千枝。\n追远皇情切，趋从仰孝思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15498,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]