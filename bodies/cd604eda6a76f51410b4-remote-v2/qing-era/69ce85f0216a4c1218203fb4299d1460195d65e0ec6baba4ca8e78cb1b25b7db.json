[{"title":"鸳鸯湖棹歌 其二十七","author":"朱彝尊","text":"鹤湖东去水茫茫，一面风泾接魏塘。\n看取松江布帆至，鲈鱼切玉劝郎尝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":544,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其二十八","author":"朱彝尊","text":"莲花细步散香尘，金粟山门礼佛频。\n一种少年齐目断，不知谁是比肩人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":545,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其二十九","author":"朱彝尊","text":"织成锦衾碧间红，缭以吴绵四五通。\n锦上鸳鸯三十六，双栖夜夜水纹中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":546,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其三十","author":"朱彝尊","text":"天宁佛阁早春开，鸟语风铃次第催。\n怪道回船湿罗袜，严将军墓踏青来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":547,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其三十一","author":"朱彝尊","text":"长水风荷叶叶香，斜塘惯宿野鸳鸯。\n郎舟爱向斜塘去，妾意终怜长水长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":548,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其三十二","author":"朱彝尊","text":"踠地垂杨絮未飘，兰舟上巳祓除遥。\n射襄城北南风起，直到吴江第四桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":549,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其三十三","author":"朱彝尊","text":"宣公桥南画鼓挝，酒船风幔拄鸦叉。\n碧山银碗劝郎醉，棹入南湖秋月斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":550,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其三十四","author":"朱彝尊","text":"木犀花落捣成泥，霜后新橙配作齑。\n犹恐夜深妨酒渴，教添玉乳御儿梨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":551,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其三十五","author":"朱彝尊","text":"画眉墨是沈圭丸，水滴蟾蜍砚未干。\n休恨图经山色少，与郎终日远峰看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":552,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其三十六","author":"朱彝尊","text":"三姑庙南豆叶黄，马王塘北稻花香。\n秋衣薄处宜思妾，春酒熟时须饷郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":553,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其三十七","author":"朱彝尊","text":"小妇春风楼下眠，与论家计最堪怜。\n劝移百福坊南往，多买千金圩上田。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":554,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其三十八","author":"朱彝尊","text":"小舫中流播燕梢，一螺青水练塘坳。\n随郎尽日盐官去，莫漫将侬半逻抛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":555,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其三十九","author":"朱彝尊","text":"戗金砚匣衍波笺，日坐春风小阁前。\n镂管簪花书小字，把郎诗学鲁？\n编。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":556,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其四十","author":"朱彝尊","text":"雨近黄梅动浃旬，舟回顾渚斗茶新。\n问郎紫笋谁家焙，莫是前溪读曲人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":557,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其四十一","author":"朱彝尊","text":"秋灯无焰剪刀停，冷露浓浓桂树青。\n伯解罗衣种罂粟，月明如水浸中庭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":558,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其四十二","author":"朱彝尊","text":"绣线图存陆晃遥，唐家花鸟棘针描。\n只愁玉面无入画，须是传神盛子昭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":559,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其四十三","author":"朱彝尊","text":"去郭西南桂树林，五亩之园一半阴。\n笑插枝头最深蕊，两鬟如粟辟寒金。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":560,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其四十四","author":"朱彝尊","text":"榆钱阵阵麦纤纤，野菜花黄蝶易粘。\n记送郎船溪水曲，平芜一点甑山尖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":561,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其四十五","author":"朱彝尊","text":"比翼鸳鸯举棹回，双飞蝴蝶遇风开。\n生憎湖上鸬鹚鸟，百遍鱼梁晒翅来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":562,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其四十六","author":"朱彝尊","text":"龙香小柄琵琶弯，切玉玲珑约指环。\n试按花深深一曲，海棠开后望郎还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":563,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其四十七","author":"朱彝尊","text":"酒市茶寮总看场，金风亭子入春凉。\n俊游改作乌篷小，蔡十郎桥低不妨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":564,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其四十八","author":"朱彝尊","text":"落花三月葬西施，寂寞城隅范蠡祠。\n水底尽传螺五色，湖边空挂网千丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":565,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其四十九","author":"朱彝尊","text":"苏小墓前秋草平，苏小墓上秋瓜生。\n同心绾结不知处，日暮野塘空水声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":566,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其五十","author":"朱彝尊","text":"风樯水槛尽飞花，一曲春波潋滟斜。\n北斗阑干郎记取，七星桥下是儿家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":567,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其五十一","author":"朱彝尊","text":"天星湖口好花枝，便过三春采未迟。\n蝴蝶双飞如可遂，教郎乞梦冷仙祠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":568,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其五十二","author":"朱彝尊","text":"江楼人日酒初浓，一一红妆水面逢。\n不待上元灯火夜，徐王庙下鼓冬冬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":569,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其五十三","author":"朱彝尊","text":"河头时有浣衣人，处处春流漾白蘋。\n桥下轻舟来往疾，南经娱老北蹲宾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":570,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其五十四","author":"朱彝尊","text":"芳草城隅绿映衫，凤池坊北好抽帆。\n徐恬旧宅芹泥暖，雨过斜阳燕子衔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":571,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其五十五","author":"朱彝尊","text":"秋泾极望水平堤，历历杉青古闸西。\n夜半呕哑柔橹拨，亭前灯火落帆齐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":572,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其五十六","author":"朱彝尊","text":"屋上鸠鸣谷雨开，横塘游女荡舟回。\n桃花落后蚕齐浴，竹笋抽时燕便来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":573,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其五十七","author":"朱彝尊","text":"漏泽寺西估客多，楼前官道后官河。\n正值喧阗日中市，杨花小伎抱筝过。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":574,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其五十八","author":"朱彝尊","text":"五月新丝满市廛，缲车响彻斗门边。\n沿流直下羔羊堰，双橹迎来贩客船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":575,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其五十九","author":"朱彝尊","text":"鱼梁沙浅鹭争淘，处处村田响桔槔。\n一夜城西苕水下，酒船直并小楼高。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":576,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其六十","author":"朱彝尊","text":"九里桥西落照衔，樱桃初熟鸟争鹐。\n须知美酒乌程到，遥见新塍一片帆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":577,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其六十一","author":"朱彝尊","text":"马场渔溆几沙汀，宿雨初消树更青。\n最好南园丛桂发，画桡长泊煮茶亭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":578,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其六十二","author":"朱彝尊","text":"青粉墙低望里遥，红泥亭子柳千条。\n郎船但逐东流水，西丽桥来北丽桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":579,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其六十三","author":"朱彝尊","text":"伍胥山头花满林，石佛寺下水深深。\n妾似胥山长在眼，郎如石佛本无心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":580,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其六十四","author":"朱彝尊","text":"花船新造水中央，晓发当湖溯汉塘。\n听尽钟声十八里，平林小市入新坊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":581,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其六十五","author":"朱彝尊","text":"蒲山草与荠山齐，澉浦潮来乍浦西。\n白沃庙南看白马，巫言风雨夜长嘶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":582,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其六十六","author":"朱彝尊","text":"绿烟初洗兔华秋，片片鱼云静不流。\n山月池边看未足，移船买酒弄珠楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":583,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其六十七","author":"朱彝尊","text":"鹦鹉湖流碧几湾，白龙湫水落陈山。\n游人秦小娘祠过，社鼓声边醉酒还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":584,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其六十八","author":"朱彝尊","text":"阿侬家住秦溪头，日长爱棹横湖舟。\n沾云寺东花已放，义妇堰南春可游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":585,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其六十九","author":"朱彝尊","text":"巫子峰晴返景开，传闻秦女葬山隈。\n闲听野老沙中语，曾有毛民海上来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":586,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其七十","author":"朱彝尊","text":"横浦东连白塔云，下方钟鼓落潮闻。\n结成海气楼相似，煮就吴盐雪不分。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":587,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其七十一","author":"朱彝尊","text":"劝郎莫饮黄支犀，劝郎莫听花冠鸡。\n闻琴桥东海月上，乌夜村边开始乌末啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":588,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其七十二","author":"朱彝尊","text":"鹰案绝顶海风晴，乌免秋残夜并生。\n铁锁石塘三百里，惊涛啮尽寄奴城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":589,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其七十三","author":"朱彝尊","text":"招宝塘倾水浅深，会骸山古家销沉。\n都缘世上钱神贵，地下刘伶改姓金。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":590,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其七十四","author":"朱彝尊","text":"曲律昆山最后时，海盐高调教坊知。\n至今十棒元宵鼓，绝倒梨园弟子师。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":591,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其七十五","author":"朱彝尊","text":"春绢秋罗软胜绵，折枝花小样争传。\n舟移濮九娘桥宿，夜半鸣梭搅客眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":592,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其七十六","author":"朱彝尊","text":"郎牵百丈上官塘，客倚篷窗晚饭香。\n黄口近前休卖眼，船头已入语儿乡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":593,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其七十七","author":"朱彝尊","text":"轻船三板过南亭，蚕女提笼两岸经。\n曲罢残阳人不见，阴阴桑柘石门青。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":594,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其七十八","author":"朱彝尊","text":"走马岗长夕照中，塘连沙渚路西东。\n不知吴会谁分地，生遍茱萸一色红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":595,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其七十九","author":"朱彝尊","text":"移船只合甓川居，酿就新浆雪不如。\n留客最怜乡味好，屠汶秋鸟马嗥鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":596,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其八十","author":"朱彝尊","text":"郎家湖北妾湖南，两浆缘流路旧谙。\n却似钓鳌矶边鹭，往来凉月影毵毵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":597,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其八十一","author":"朱彝尊","text":"野王台废只空墩，翁子坟荒有墓门。\n舍宅尚传裴相国，移家曾住赵工孙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":598,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其八十二","author":"朱彝尊","text":"秋晚东林落木疏，白莲僧寺水中居。\n昏钟不隔渔庄火，古殿犹存日本书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":599,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其八十三","author":"朱彝尊","text":"蕲王战舰已无踪，娄相高坟启旧封。\n曾见朋游南渡日，北山堂外九株松。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":600,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其八十四","author":"朱彝尊","text":"仲圭旧里足淹徊，曲径横桥一水隈。\n小？\n春风认酹酒。\n佛香长和墓门梅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":601,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其八十五","author":"朱彝尊","text":"怀苏亭子草成蹊，六鹤空堂旧迹迷。\n唯有清香楼上月，夜深长照子城西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":602,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其八十六","author":"朱彝尊","text":"稗花枫叶宋坡湖，路转潮鸣山翠无。\n百里盐田相望白，至今人说小长芦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":603,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其八十七","author":"朱彝尊","text":"桑边禾黍水重围，时有秋虫上客衣。\n三过堂东开夕阳，满村黄叶一僧归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":604,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其八十八","author":"朱彝尊","text":"百花庄口水沄沄，中是吾家太傅坟。\n当暑黄鹂鸣灌木，经科红叶映斜曛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":605,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其八十九","author":"朱彝尊","text":"鸭嘴小船浅水通，获花门巷萧萧风。\n荆南豫北斗新酿，不比吾乡清若空。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":606,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其九十","author":"朱彝尊","text":"秋水寻常没钓矶，秋林随意敞柴扉。\n八月田中黄雀啄，九月盘中黄雀肥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":607,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其九十一","author":"朱彝尊","text":"江市鱼同海市鲜，南湖菱胜北湖偏。\n四更枕上歌声起，泊遍冬瓜堰外船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":608,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其九十二","author":"朱彝尊","text":"妾家城南望虎墩，郎家城北白牛村。\n白牛不见郎骑至，望虎何由过郭门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":609,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其九十三","author":"朱彝尊","text":"百步桥南解缆初，香醪五木隔年储。\n不须合路寻鱼鲊，但向分湖问蟹胥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":610,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其九十四","author":"朱彝尊","text":"石尤风急驻苏湾，逢着邻船贩橘还。\n只道夜过平望驿，不知朝发洞庭山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":611,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其九十五","author":"朱彝尊","text":"父老禾兴旧馆前，香粳熟后话丰年。\n楼头沽酒楼外泊，半是江淮贩米船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":612,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其九十六","author":"朱彝尊","text":"茅屋东溪兴可乘，竹篱随意挂鱼罾。\n三冬雪压千年树，四月花繁百尺藤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":613,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其九十七","author":"朱彝尊","text":"舍南舍北绕春流，花外初莺啭未休。\n毕竟林塘输角里，爱携宾客醉山楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":614,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其九十八","author":"朱彝尊","text":"溪上梅花舍后开，市南新酒酦新醅。\n寻山近有殳基宅，看雪遥登顾况台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":615,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其九十九","author":"朱彝尊","text":"归人万里望邱为，白酒黄壶瓠作卮。\n来往棹歌无不可，西溪东泖任吾之。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":616,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖棹歌 其一○○","author":"朱彝尊","text":"槛边花外尽重湖，到处怀觞兴不孤。\n安得家家寻画手，溪堂遍写读书图。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":617,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"云中至日","author":"朱彝尊","text":"去岁山川缙云岭，今年雨雪白登台。\n可怜日至长为客，何意天涯数举杯。\n城晚角声通雁塞，关寒马色上龙堆。\n故园望断江村里，愁说梅花细细开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":618,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"度大庾岭","author":"朱彝尊","text":"雄关直上岭云孤，驿路梅花岁月徂。\n丞相祠堂虚寂寞，越王城阙总荒芜。\n自来北至无鸿雁，从此南飞有鹧鸪。\n乡国不堪重伫望，乱山落日满长途。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":619,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"哭王处士翃 其六","author":"朱彝尊","text":"相送悲长别，还家惨独行。\n流连简书札，次第念交情。\n自有箧中作，何难身后名。\n泉台应快意，未必似平生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":620,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]