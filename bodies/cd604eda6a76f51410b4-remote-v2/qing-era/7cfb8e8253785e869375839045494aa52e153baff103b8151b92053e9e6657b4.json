[{"title":"小心坡","author":"余鸿","text":"鱼背崎岖无奈何，小心缓步度高坡。\n语儿山路休闲险，世路须知险更多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":740,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"黄海杂兴","author":"余鸿","text":"浮云变幻岂无心，闲看云飞酒自斟。\n双壁如门霞是障，群峰拔地笋成林。\n雪依片石留鸿爪，台峙层峦理素琴。\n钟子难逢谁识我，高山流水慕知音。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":741,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三月十九日圣忌日偶成","author":"冷士嵋","text":"一年一度逢花发，每见花开辄黯然。\n往事有谁来记忆，春风空老白头年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":742,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过文与也墓下","author":"冷士嵋","text":"不道寻君薤露边，一抔官陇卧荒烟。\n山深路僻人来少，野草茫茫没墓田。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":743,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"哭文与也","author":"冷士嵋","text":"人没琴亡竹坞东，到来不与旧时同。\n白云秋石荒凉尽，空对寒山落木中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":744,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梦里青山图为桐上人题","author":"冷士嵋","text":"片云孤鹤寄人间，心自禅空梦自闲。\n莫把画图看作画，画中山是梦中山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":745,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梦里青山图为桐上人题","author":"冷士嵋","text":"竹屋蒲团万壑东，萧然一幻坐来空。\n十年尘虑都亡尽，留得青山入梦来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":746,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"哭子晋兄","author":"冷士嵋","text":"吾兄虽弱冠，忠义古人难。\n愤血千秋碧，操心一寸丹。\n旌旗落泗水，魂梦绕金坛。\n痛作包胥泪，霜飞六月寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":747,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏史 其一 南齐","author":"吴氏","text":"六贵同朝激虎彪，横江勒马下秦州。\n银枪酒市春双靥，玉屟莲台月半钩。\n赵鬼《西京》谙汉赋，阿兄东阁压通侯。\n谁知讲武旄头入，芳乐笳声碧麝秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":748,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卜算子","author":"吴兰修","text":"绿剪一窗烟，夜漏如何许。\n碧月蒙蒙不到门，竹露听如雨。\n独自出篱根，树影拖鞋去。\n一点萤灯隔水青，蛩作秋僧语。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":749,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"出关","author":"吴兆骞","text":"边楼回首削嶙峋，筚篥喧喧驿骑尘。\n敢望馀生还故国，独怜多难累衰亲。\n云阴不散黄龙雪，柳色初开紫塞春。\n姜女石前频驻马，傍关犹是汉家人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":750,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"乙巳游日本绝句","author":"吴保初","text":"万顷云涛立海滩，天风浩荡白鸥闲。\n舟人那识伤心地，为指前程是马关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":751,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏古","author":"吴绡","text":"公子翩翩信绝伦，拟将豪举却狂秦。\n不知宾客成何事，枉向楼头斩美人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":752,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"七夕","author":"吴绡","text":"星光历历汉悠悠，怅望双星独倚楼。\n莫谓人间多别恨，便疑天上有离愁。\n梁清谪去谁相伴，子晋归来合共游。\n惟有月娥应最妒，一轮风露不胜秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":753,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"啸台","author":"吴绡","text":"魏晋已如梦，荒台今独存。\n龙蛇正交斗，鸾凤自高鶱。\n避俗惟长啸，逢人常不言。\n始知真隐意，何必入桃源。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":754,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝词二首 其一","author":"吴绡","text":"宫柳初开一抹眉，武昌城下乍逢时。\n春来树树烟条绿，欲认何枝是旧枝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":755,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春晴晚眺","author":"吴琪","text":"积雨经旬鹤未过，小楼闲眺费吟哦。\n帘开燕子归来晚，门掩梨花落处多。\n新水小桥通蕙畹，乱山古寺入烟萝。\n云开树杪看浮棹，画出春帆送绿波。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":756,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送别","author":"吴琪","text":"雪意满芳洲，苍山引去舟。\n霜风醒客梦，笳月起边愁。\n万里从军急，孤身倚剑游。\n家园落日里，莫上最高楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":757,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"明妃","author":"吴雯","text":"不把黄金买画工，进身羞与自媒同。\n始知绝代佳人意，即有千秋国士风。\n环佩几曾归夜月，琵琶惟许托宾鸿。\n天心特为留青冢，春草年年似汉宫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":758,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晚入药谷","author":"吴雯清","text":"清鸾峰下步迟迟，为访幽居足已疲。\n穿壑板桥惊欲坠，隔林茅屋望犹疑。\n桃源旧径依津间，药孤楼傍石窥。\n仅有残僧相对晚，寒潭清啸少人知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":759,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"少年游","author":"吴锡麒","text":"江南三月听莺天，买酒莫论钱。\n晚笋余花，绿阴青子，春老夕阳前。\n欲寻旧梦前溪去，过了柳三眠。\n桑径人稀，吴蚕才动，寒倚一梯烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":760,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"长相思 以书寄西泠诸友，即题其后","author":"吴锡麒","text":"说相思，问相思，枫落吴江雁去迟。\n天寒二九时。\n怨谁知？\n梦谁知？\n可有梅花寄一枝？\n雪来翠羽飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":761,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"临江仙 夜泊瓜洲","author":"吴锡麒","text":"月黑星移灯屡闪，依稀打过初更。\n清游如此太多情。\n豆花凉帖地，知雨咽虫声。\n渐逼疏蓬风淅淅，几家茅屋都扃。\n茨茹荷叶认零星。\n不知潮欲落，渔梦悄然生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":762,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮","author":"吴锡麒","text":"春波软荡红楼水，多时不放莺儿起。\n一样夕阳天，留寒待禁烟。\n已是人消瘦，只此情依旧。\n可奈别离何，明朝杨柳多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":763,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次韵答黄鸣六见怀","author":"吴嘉纪","text":"乾坤何处可题诗，画里江山雨洗时。\n水起峰低人不见，云生树冷鹤先知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":764,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"冶春绝句和王阮亭先生","author":"吴嘉纪","text":"冈北冈南上朝日，落花游骑乱纷纷。\n如何松下几抔土，不见儿孙来上坟？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":765,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"冶春绝句和王阮亭先生","author":"吴嘉纪","text":"寒烟生处有归鸦，短棹残阳各去家。\n依旧笙歌满城郭，黄昏留与玉勾斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":766,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"冶春绝句和王阮亭先生","author":"吴嘉纪","text":"杂管繁弦奏野航，听来声调是伊凉。\n边关子弟江南老，今日曲中逢故乡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":767,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"绝句","author":"吴嘉纪","text":"白头灶户低草房，六月煎盐烈火旁。\n走出门前炎日里，偷闲一刻是乘凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":768,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九日寄徐式家","author":"吴嘉纪","text":"清波晃荡荻花齐，徙倚衡门独杖藜。\n家在水中霜降早，船行林半鹭飞低。\n凶年酒贵乡人醒，返照村空寡妇啼。\n浦溆黄昏君不见，凉风衰柳思凄凄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":769,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卖书祀母","author":"吴嘉纪","text":"母没悲今日，儿贫过昔时。\n人间无乐岁，地下共长饥。\n白水当花荐，黄粱对雨炊。\n莫言书寡效，今已慰哀思！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":770,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"泊船观音门十首","author":"吴嘉纪","text":"即以山为郭，坚完世所稀。\n云鸿应得度，塞马竟如归！\n陇雨耕时大，人烟战后微。\n年年禾与黍，养得骆驼肥！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":771,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"泊船观音门十首","author":"吴嘉纪","text":"鼓鼙声飒飒，道路色凄凄。\n盘髻妇驰马，横刀兵捉鸡。\n山城常罢市，帝里已成畦。\n黄屋光辉瓦，纷纷碎入泥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":772,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"挽王秀才斌","author":"吴嘉纪","text":"怀抱人难测，衣冠自不迂。\n传经多弟子，结友半屠沽。\n死去文章在，年凶产业芜。\n故林沧海畔，鸣噪尽饥乌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":773,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"挽王秀才斌","author":"吴嘉纪","text":"赋诗悲乱世，易箦及芳春。\n夙昔宁知佛？\n精魂实避秦。\n老妻单冷墅，残帙委流尘。\n杖履难重遇，桃花处处津。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":774,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答栎下先生","author":"吴嘉纪","text":"穷冬伏枕何人问，栎下先生寄我诗。\n远问只愁身便死，怜才几见泪沾颐。\n吟成梁甫徒增慨，老遇钟期不厌迟。\n冰雪溪头扶病起，为君珍重夕阳时！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":775,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"打鲥鱼","author":"吴嘉纪","text":"打鲥鱼，暮不休。\n前鱼已去后鱼稀，搔白官人旧黑头。\n贩夫何曾得偷买，胥徒两岸争相待。\n人马销残日无算，百计但求鲜味在。\n民力谁知夜益穷！\n驿亭灯火接重重。\n山头食藿杖藜叟，愁看燕吴一烛龙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":776,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"打鲥鱼","author":"吴嘉纪","text":"打鲥鱼，供上用。\n船头密网犹未下，官长已鞴驿马送。\n樱桃入市笋味好，今岁鲥鱼偏不早。\n观者倏忽颜色欢，玉鳞跃出江中澜。\n天边举匕久相迟，冰填箬护付飞骑。\n君不见金台铁瓮路三千，却限时辰二十二。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":777,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"李家娘","author":"吴嘉纪","text":"城中山白死人骨，城外水赤死人血。\n杀人一百四十万，新城旧城内有几人活？\n妻方对镜，夫已堕首；腥刀入鞘，红颜随走。\n西家女，东家妇，如花李家娘，亦落强梁手。\n手牵拽语，兜离笳吹。\n团团日低。\n归拥曼睩蛾眉。\n独有李家娘，不入穹庐栖。\n岂无利刃，断人肌肤，转嗔为悦，心念彼姝，彼姝孔多，容貌不如他。\n岂是贪生，夫子昨分散，未知存与亡。\n女伴何好，发泽衣香，甘言来劝李家娘。\n李家娘，肠崩摧，箠挞磨灭，珠玉成灰。\n愁思结衣带，千结百结解不开。\n李家娘，坐军中，夜深起望，不见故夫子，唯闻战马嘶悲风；又见邗沟月，清辉漾漾明心胸。\n令下止杀残人生，寨外人来，殊似舅声。\n云我故夫子，身没乱刀兵。\n恸仆厚地，哀号苍旻！\n夫既殁，妻复何求？\n脑髓与壁，心肺与雠。\n不嫌剖腹截头，俾观者觳觫似羊牛。\n若羊若牛何人？\n东家妇，西家女。\n来日撤营北去，驰驱辛苦。\n鸿鹄飞上天，毚兔不离土。\n乡园回忆李家娘，明驼背上泪如雨！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":778,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"凄风行，伤饥灶也","author":"吴嘉纪","text":"凄风细雨何连绵？\n昼暗如夜飞湿烟。\n几千万家东海边，六七十日无青天。\n生计断绝，老人幸先就下泉。\n孩提无襦，长随母眠；阿母眠醒，腹馁不得眠。\n壮者起望西邻，乞食尘市，不复来还。\n回望东邻，八口闭柴扉，扉外青草春芊芊。\n水响溅溅，鬼泣涟涟。\n官长惄然，分俸籴谷，更日夕劳苦，劝富户各出籴谷金钱。\n富户踟蹰聚议，此户彼户，一斛两斛商量捐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":779,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"临场歌","author":"吴嘉纪","text":"掾豺隶狼，新例临场；十日东淘，五日南梁。\n趋役少迟，场吏大怒；骑马入草，鞭出灶户。\n东家贳醪，西家割彘；殚力供给，负却公税。\n后乐前钲，鬼咤人惊；少年大贾，币帛将迎。\n帛高者止，与笑月下；来日相过，归比折价。\n笞挞未歇，优人喧阗；危笠次第，宾客登筵。\n堂上高会，门前卖子；盐丁多言，箠折牙齿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":780,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"月夜游孤山","author":"吴震","text":"松顶一声鹤，露华满径流。\n静闻空翠滴，间与片云留。\n四面只通水，全山如在舟。\n明明楼阁夜，有客独寻秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":781,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"展园次兄遗札","author":"吴麟","text":"草绿池塘梦已残，西堂无复共盘桓。\n空馀怀袖三年字，零落银钩忍泪看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":782,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"说诗","author":"宋湘","text":"池塘春草妙难寻，泥落空梁苦用心。\n若比大江流日夜，哀丝豪竹在知音。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":783,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"说诗","author":"宋湘","text":"涂脂傅粉画长眉，按拍循腔疾复迟。\n学过邯郸多少步，可怜挨户卖歌儿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":784,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"说诗","author":"宋湘","text":"读书万卷真须破，念佛千声好是空。\n多少英雄齐下泪，一生缠死笔头中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":785,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"说诗","author":"宋湘","text":"心源探到古人初，征实翻空总自如。\n好把臭皮囊洗净，神仙楼阁在高虚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":786,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"说诗","author":"宋湘","text":"文章妙绝有邱迟，一纸书中百首诗。\n正在将军旗鼓处，忽然花杂草长时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":787,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"说诗","author":"宋湘","text":"三百诗人岂有诗，都成绝唱沁心脾。\n今人不讲源头水，只问支流派是谁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":788,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"说诗","author":"宋湘","text":"学韩学杜学髯苏，自是排场与众殊。\n若使自家无曲子，等闲铙鼓与笙竽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":789,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"说诗","author":"宋湘","text":"豫章出地势轮囷，细草孤花亦可人。\n独有五通仙杜老，各还命脉各精神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":790,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆少年","author":"宋湘","text":"老屋柴门树打头，青山屋后水自流。\n受书十日九逃学，恨不先生命牧牛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":791,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"同欧阳令饮凤凰山下","author":"宋琬","text":"茅茨深处隔烟霞，鸡犬寥寥有数家。\n寄语武陵仙吏道：莫将征税及桃花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":792,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舟中见猎犬有感","author":"宋琬","text":"秋水芦花一片明，难同鹰隼共功名。\n樯边饱饭垂头睡，也似英雄髀肉生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":793,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"狱中对月","author":"宋琬","text":"疏星耿耿逼人寒，清漏丁丁画角残。\n客泪久从悉外尽，月明犹许醉中看。\n栖乌绕树冰霜苦，哀雁横天关塞难。\n料得故园今夜梦，随风应已到长安。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":794,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花  旅月怀人","author":"宋琬","text":"月去疏帘才几尺。\n乌鹊惊飞，一片伤心白。\n万里故人关塞隔，南楼谁弄梅花笛。\n蟋蟀灯前欺病客。\n清影徘徊，欲睡何由得。\n墙角芭蕉风瑟瑟，生憎遮掩窗儿黑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":795,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谢易实甫再惠庐山三峡泉","author":"张之洞","text":"江城炎燥无风，忽有甘泉药病翁。\n篇酌一家俱满腹，劳人堪傲赞皇公。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":796,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"阳湖道中","author":"张问陶","text":"风回五两月逢三，双桨平拖水蔚蓝。\n百分桃花千分柳，冶红妖翠画江南。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":797,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"瞿塘峡","author":"张问陶","text":"峡雨濛濛竟日闲，扁舟真落画图间。\n便将万管玲珑笔，难写瞿塘两岸山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":798,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舟中遥望巫山","author":"张问陶","text":"直抵瞿塘秀，巫山十二峰。\n灵祠春梦晓，古峡雨痕浓。\n石气围孤艇，江声走毒龙。\n阳台云自好，林壑暮重重。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":799,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"观我四首 生","author":"张问陶","text":"芒芒生面忽重开，堕地先号事可哀。\n瞥眼韶华因梦远，累心缘影为谁来。\n名沉青史终无色，祸起红尘定有胎。\n白业丹元修补急，万牛身重首空回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":800,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"观我四首 死","author":"张问陶","text":"胶革全崩傀儡场，岐雷医命竟无方。\n千秋许我留真气，百事催人到夕阳。\n谁把黄金求骏骨，且余一垄羡生王。\n涅槃羽化凭仙佛，为想归途尽渺茫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":801,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"观我四首 老","author":"张问陶","text":"中年岁月渺前生，变尽孩提古性情。\n犹剩颓光恋儿女，也循常格到公卿。\n飞花堕溷春难挽，瞎马临池夜可惊。\n几个飘然云水外，一枝竹杖万缘轻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":802,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"观我四首 病","author":"张问陶","text":"毒草灵苗大小符，门庭风景半医巫。\n形神久隔生原幸，人鬼交争势转孤。\n枕上心魂疑岸狱，眼中眠食羡妻孥。\n瓣香好礼维摩诘，认取天花著体无。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":803,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梅花","author":"张问陶","text":"香雪濛濛月影团，抱琴深夜向谁弹。\n闲中立品无人觉，淡处逢时自古难。\n到死还能留气韵，有情何忍笑酸寒。\n天生不合寻常格，莫与春花一例看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":804,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梅花","author":"张问陶","text":"花中资格本迟迟，铁石心肠淡可知。\n此世何人能领略，为君终夜费相思。\n看来风雪无多日，香到园林第几枝。\n自是不开开便好，清高从未合时宜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":805,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梅花","author":"张问陶","text":"回首山林感旧踪，雪花吹影一重重。\n记从驿使春前折，又向瑶台月下逢。\n对客岂无能舞鹤，赏心还是后凋松。\n天人装束天然好，便买胭脂画不浓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":806,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梅花","author":"张问陶","text":"铜瓶纸帐老因缘，乱我乡愁又几年。\n莫笑神情如静女，须知风骨是飞仙。\n生来逸气应无敌，悟到真空信可怜。\n世外清名原第一，不修花史亦流传。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":807,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]