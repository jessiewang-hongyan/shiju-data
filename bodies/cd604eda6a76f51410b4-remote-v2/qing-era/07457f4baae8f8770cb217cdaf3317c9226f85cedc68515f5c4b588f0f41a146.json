[{"title":"秋感 其一","author":"周星诒","text":"惯觉衰翁梦，戈船鼓四更。\n连阴星月晦，长夜鼠狐横。\n醉呓奴群睡，忧嗟老独醒。\n一声天下旦，破暝祝鸡鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22125,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋感 其二","author":"周星诒","text":"秋残天漠漠，阪旷日萧萧。\n翅仄鹰盘稳，膘新马猎骁。\n野风吹短发，村酒醉长桥。\n共饮无相识，骚魂唪《大招》。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22126,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄周澹岩幽居","author":"陈元禄","text":"径仄少人过，萧萧生薜萝。\n青山当户远，黄叶闭门多。\n阮籍惟宜酒，陶潜许放歌。\n科头倚秋树，幽梦正婆娑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22127,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"小楼晚望","author":"管绳莱","text":"江城坐老绿苔矶，郭外青山望处微。\n落日昏鸦争树急，西风黄叶向人飞。\n半天秋远欹吟帽，九月霜寒赋授衣。\n独有高楼延草色，几家临水掩柴扉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22128,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晚步","author":"管绳莱","text":"出门看斜阳，忽已上高树。\n携手同心欢，城隅散轻步。\n秋风一夕来，衣袂改轻素。\n木叶脱何迟，芳草色非故。\n悠悠远水明，霭霭苍烟暮。\n牧晚笛归村，渔寒镫隐渡。\n登高畅幽怀，感逝戚内顾。\n新欢不在眼，陈人复谁慕。\n存悲思浩歌，念别感征路。\n辽天廓无边，惟有寒鸦去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22129,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春寒","author":"于养源","text":"想到寻春意转慵，梅花落尽杏花红。\n呼僮钩起重帘望，不是东风是北风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22130,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送郭相廷先生还车桥","author":"于养源","text":"天涯踪迹等浮鸥，聚散无端我欲愁。\n此去江南秋色好，一村黄叶认归舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22131,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏史","author":"谢兰生","text":"我生三十年，曾读汉魏史。\n我读汉魏史，仰止习凿齿。\n谓魏为正统，蜀乃以寇视。\n茫茫数百载，谁复能议此。\n赖公发聋聩，大声震里耳。\n独帝汉昭烈，分别冠与履。\n天道以不丧，人心以不死。\n煌煌良史才，下启紫阳子。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22132,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题三闾大夫离骚后","author":"谢兰生","text":"瓦釜既用事，黄钟故应弃。\n众醉乃独醒，尤为同列忌。\n主听复不聪，孤臣数益穷。\n疏后旋见谪，谁能鉴其衷。\n《卜居》以明心，《离骚》以寄慨。\n终与汨罗沈，朴忠何由遂。\n至今沅湘间，悲风绕荒寺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22133,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江干即事 其一","author":"方士鼐","text":"匹练澄清送早潮，白云深处断虹桥。\n荻洲风起秋声冷，吹散遥天碧玉箫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22134,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江干即事 其二","author":"方士鼐","text":"曈蠓宝镜照长江，十丈红光射绿艭。\n昨夜芦花飞片片，故将玉雪打篷窗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22135,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄伯兄羽扇旋报七古一章依韵奉答","author":"方士鼐","text":"高哉碧梧栖凤毛，??振融陵丹霄。\n郁乎苍松盘鹤顶，翩翩展翅依云巢。\n君子于止知所止，坚吾寄托畴能摇。\n丰肌美羽胡为者，钟鼎何如安藜蒿。\n君昔仁风遍泽国，举手翩阳阳不骄。\n今年六月又苦热，金飙送入始清萧。\n我惭一扇寄千里，聊为两地除炎歊。\n君非热中我冷宦，古人何必矜题桥。\n胸襟磊落笔锋利，趋炎附热非英豪。\n湖山别去今七载，熙州焉能比霅苕。\n数椽官舍地低湿，往往久雨生寒潮。\n千峰万岭罗户右，绕墙芬馥多兰椒。\n黎祁一味颇不厌，开轩扫榻能相邀。\n司空佛图助吟咏，山川刻露飞彩毫。\n春花秋月期不至，徒令诗笔走清超。\n相思团扇对明月，遥知月下宽征袍。\n风生一握凉侵臂，秋果再热奚辞劳。\n君身松柏是后彫，况有雏凤夸翔翱。\n天伦乐叙欣所遭，一枝笑我同鹪鹩。\n君诗摺叠等琼瑶，盥薇读罢香暗飘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22136,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"示儿子浚师","author":"方士鼐","text":"吾父性我时，四十头未白。\n今我又四旬，父已归窀穸。\n方幸两慈亲，侍奉永朝夕。\n胡为十年中，双亲痛疾革。\n哀哉父母恩，欲报形骸隔。\n年载困名途，岁月皆虚掷。\n虽然作冷官，难免素餐责。\n有书岂不读，吾父留手迹。\n有杯岂不举，吾母留口泽。\n显扬纵未能，光阴须爱惜。\n汝年已十三，留心在经籍。\n立志贵精勤，求师重诱掖。\n少壮能几何，珍重驹过隙。\n莫学我无闻，老大悲何益。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22137,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浦口","author":"方士鼐","text":"屈指金陵路，驰驱二十秋。\n山光看不足，暑气未全收。\n旅梦惊黄叶，虚名误白头。\n乘风挂帆去，卧听大江流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22138,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菊江杂咏 其一","author":"方士鼐","text":"不识谁家柳，居然植五株。\n绿阴扶古岸，白日澄平湖。\n垣破余荒菜，墙颓插短芦。\n可怜凭眺处，山色半模糊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22139,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菊江杂咏 其二","author":"方士鼐","text":"地僻居民少，地荒树木繁。\n浴波翻水鸟，归市剩河豚。\n亦有人呼渡，曾无吏候门。\n清风吹满座，独自倒芳尊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22140,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登太白楼有感","author":"方士鼐","text":"一别高楼又七年，登临恰值暮秋天。\n分无佳句夸名士，谁肯怜才到谪仙。\n山杂乱云归塔顶，江留残照落帆前。\n金陵十度真堪笑，赢得千丝雪满颠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22141,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"淮上舟夜","author":"邵咏","text":"淮南雨晴夜，初夏似新秋。\n月色兼凉起，河声入梦流。\n艰难依蹇仆，飘泊信孤舟。\n应识回家日，惊心念旧游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22142,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"萧闲堂读书用樊榭城西读书杂兴韵寄示立斋二弟 其一","author":"沈世良","text":"解嘲谁计腹便便，自爱巾瓶结净缘。\n入世无心同叔宝，故人耽读有盈川。\n烛奴寂寂东西屋，月子湾湾上下弦。\n憔悴天涯乌帽客，晚芦寒荻北来船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22143,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"萧闲堂读书用樊榭城西读书杂兴韵寄示立斋二弟 其二","author":"沈世良","text":"极天鸿雁怆离群，第五名曾汐社闻。\n狂客长瑜原善谑，酒人孙楚早能军。\n对床旧约愁听雨，异地思亲独望云。\n难得读书行万里，故山猿鹤莫移文。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22144,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"萧闲堂坐雨口号","author":"沈世良","text":"隐隐雷车走阿香，遥天一半尚斜阳。\n茶声满树抛书坐，矮竹扶云过短墙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22145,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"再叠前韵和青皋并呈兰甫丈","author":"沈世良","text":"秘册传钞到上清，下帘萧散爱君平。\n松阴格破苔低补，井槛泥洼菌寄生。\n香界谈经山芋火，雨镫摇梦水荭声。\n壮年一样供虚掷，却羡摊书万里行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22146,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"戏赠青皋","author":"沈世良","text":"嗟君尘甑今十年，斋时卓午无爨烟。\n撑肠空饱苍颉字，饷客绝少王宏钱。\n瘦羊博士更可怜，持筹握算心悄然。\n万金颠倒掷虚牝，三载缚束耕石田。\n飘茵堕溷偶相值，如风怜目夔怜蚿。\n文园卖赋苦不数，侩牛墙东亦不恶。\n关中自鬻王猛畚，市上去卖韩康药。\n古人游戏何事无，今我胡为独不乐。\n君本神仙许玉斧，我亦清狂沈昭略。\n蟠桃未熟三千秋，汗漫且作人间游。\n债台便足供作达，娱老岂复营糟邱。\n寒山拾得两穷士，来牛去马千王侯。\n今日断肠草，昨日芙蓉花。\n东陵去种青门瓜，画楼曲柄弹筝琶。\n空堂过眼栖饥鸦，掉头万事俱抟沙。\n区区穷达勿芥蒂，变灭任化风中霞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22147,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠见山寺廉真上人","author":"聂节亨","text":"青山长对习跏趺，昼掩禅关一事无。\n衲毳卷云悬破榻，药苗添火炼寒炉。\n苔深石罅穿浮蚁，水阔亭阴睡野凫。\n时倚栏杆吹竹笛，数声杨柳落南湖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22148,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟陶渊明咏贫士","author":"聂节亨","text":"宝剑沈狱底，龙光岂自呈。\n良玉蕴深山，不知光辉生。\n萧萧被褐士，悒郁多古情。\n貌枯中自腴，衒饰耻希荣。\n知己惜不遇，澹泊守其贞。\n欲取鸣琴弹，明月上前楹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22149,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"简周宇安","author":"聂节亨","text":"袁江腊月夜飞雪，万顷玻璃散冰缬。\n杈丫冻木绕江森，孤洲惨惨寒云裂。\n柴扉江岸旧为家，画里芭蕉映浅沙。\n钓竿久共羊裘老，月明浦溆舟时拿。\n形骸放浪无羁束，忘机迹已轻鸥熟。\n不须句漏乞丹砂，管领溪山一生足。\n太华山顶莲花开，人间富贵轻尘埃。\n一樽许我醉醽醁，高兴直欲凌蓬莱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22150,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"仿孙观察诗和茝生见寄","author":"林鹗","text":"记得去年无射月，河桥分手上扁舟。\n我吟锦瑟故多病，君抱瑶琴且莫愁。\n渐近自然沙落雁，于无相与海浮鸥。\n可能暂作罗昭谏，也向溪山访旧游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22151,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"福州城楼晚眺感作","author":"林用霖","text":"独立揽晴空，南疆此最雄。\n波涛烟树外，城郭夕阳中。\n碧海渺何极，白云望不穷。\n八州收鼓角，间数寺楼钟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22152,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"由京口溯流达金陵舟中作","author":"林用霖","text":"一帆高挂镇江头，路上金陵趁早秋。\n元气荡潮通碣石，长风分浪入瓜洲。\n茫茫北顾云山远，浩浩东流日夜浮。\n积潦未消频欲雨，楚天哀雁不胜愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22153,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题潘顺之落花图 其一","author":"汪锡圭","text":"蝶怨莺愁最恼人，曲中金缕可怜春。\n恨予已被桃源误，莫共渔郎更问津。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22154,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题潘顺之落花图 其二","author":"汪锡圭","text":"欲剪巫山一段云，幻空玉女散纷纷。\n随风吹到波心去，红晖鱼鳞绿绉纹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22155,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题潘顺之落花图 其三","author":"汪锡圭","text":"不断晴波漾绿萍，陌头柳眼为谁青。\n从今妄作封侯想，学得长生种树经。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22156,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"冷泉亭","author":"钱辰","text":"不染尘外喧，悟彻寰中静。\n湛若供目娱，悠然极心领。\n含风澄翠微，泻日澹波影。\n活泼有灵源，幽迥绝凡境。\n小坐虚亭间，欲涿凭修绠。\n安得枕此流，梦与泉俱冷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22157,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日感咏","author":"钱辰","text":"凉风几度吹，庭草犹含绿。\n秋色满阶除，间观无拘束。\n披襟坐堂坳，携琴弹一曲。\n自写性中情，恬澹何所欲。\n人世如寄生，寸心重金玉。\n境遇虽变迁，由来在知足。\n采菊持两螯，沈醉忘荣辱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22158,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"待旦歌","author":"钱辰","text":"愁云密布阴风吹，一镫如豆花乱云。\n讵闻虫声鸣暗壁，但听鬼哭哀且悲。\n寒衾倚构弗成寐，披衣起坐弹双泪。\n星月煌煌助日光，欃枪入斗何时坠。\n更有荧惑芒常明，焚燹烛天心屡惊。\n可惜繁华尽焦土，死别生离魂梦轻。\n城开不夜仙境缈，挥戈回日鲁阳杳。\n喔喔狺狺时寂静，未央未艾夜难晓。\n初更二更倏忽过，三更已倦来睡魔。\n酒力欲醒眼尚醉，搔首踟踌唤奈何。\n书生束手困无策，唾壶击缺剑空掷。\n雄鸡拍拍断续啼，竟夕引领东方白。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22159,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清水桥","author":"万同伦","text":"涧柳带残雨，鸟声说晚晴。\n絮轻随马度，村近有鸡鸣。\n两岸夕阳淡，一溪春涨平。\n山程慰遥役，苍翠数峰横。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22160,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"潼关城楼","author":"万同伦","text":"崔嵬天设险，城阙莽风尘。\n关势连函谷，河声走孟津。\n有能望气者，留意弃繻人。\n日暮危楼上，悠悠作客身。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22161,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"旅夜","author":"万同伦","text":"旅夜百忧煎病骨，坐看尘掩匣中力。\n残镫耿耿客无赖，落月茫茫鸡乱号。\n隔岁河流决瓠子，几时战伐息临洮。\n淮阳一卧惊春至，种种羞将短发搔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22162,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"吕梁舟中","author":"张仁矩","text":"山色入新秋，斜阳送客舟。\n人声争渡口，帆影落城头。\n古寺红墙隐，清波白鸟浮。\n深宵篷背看，依旧月如钩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22163,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"扶沟道中","author":"张谦","text":"破晓出扶沟，遥天雾未收。\n水痕侵客鬓，寒色上征裘。\n事业浑鸡肋，功名愧虎头。\n早知行役苦，悔不卧林丘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22164,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登五华山望昆明池","author":"方玉润","text":"偶觇井宿到昆华，金碧光中望眼赊。\n西去涛声奔迅马，北来山势走长蛇。\n连云台殿悲梁土，落日旌旗想汉家。\n客里登临多感慨，武侯祠树乱栖鸦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22165,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"全州节","author":"方玉润","text":"全州节，谁最烈。\n都司头，刺史血。\n刺史守城苦无兵，都司带兵愁远别。\n同是天家戮力臣，相逢何必判优劣。\n人肉食尽鼠雀空，弓靴煮烂思杀妾。\n拊膺一恸外援断，无人不憾湘漓月。\n丈夫死耳庸何伤，能为厉鬼真人杰。\n君不见睢阳城内杀声哀，邻境笙歌尚清越。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22166,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"冠县令","author":"方玉润","text":"冠县令，一家血染粤贼刃。\n咸丰甲寅三月朔，贼旗蜂拥来何迅。\n一炮已毁二黄纛，忽复小旗挥四阵。\n四阵四门乱云集，常山蛇难首尾应。\n回身巷战贼盈衢，只手犹能戮枭獍。\n力尽成禽那肯屈，张巡原抱男儿性。\n旁有一仆亲瞩目，先砍公头后公腹。\n后堂烈妇并烈女，五人同时遭残酷。\n犹幸婴儿属乳母，天留一脉继良族。\n吁嗟乎！\n智者婢，义者仆，烈者妇，忠者牧。\n滇南节义冠青犊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22167,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题伯牙台","author":"方玉润","text":"江风吹断楚山青，一曲泠泠思欲沈。\n自古解人偏薄命，从来绝调少知音。\n秋高雁落平沙远，夜静龙吟大泽深。\n谁信灵弦多变徵，荒台戎马最关心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22168,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"阮敬斋慎斋云庄招饮桑榆别业 其一","author":"徐鸿谟","text":"沙堤曲曲柳阴凉，中有裴公绿野堂。\n恰好声名传第五，新诗驴背满奚囊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22169,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"阮敬斋慎斋云庄招饮桑榆别业 其二","author":"徐鸿谟","text":"波影山光共一楼，西泠台榭亦清幽。\n披图我有飘零感，孤负青山事客游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22170,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西风","author":"顾逊之","text":"洞庭江上始生波，袅袅西风怨薜萝。\n商信渐催华发变，凉飙偏觉异乡多。\n梧桐叶写怀人句，觱栗声传出塞歌。\n莫怪才人悲宋玉，愁中时序易消磨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22171,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"穷士","author":"韩崇","text":"穷士易为恩，寸苗易为泽。\n岂谓盆盎微，种松贬高节。\n皎皎云际月，磊磊岩下石。\n怀璞弗自衒，流辉乃同澈。\n不易展氏介，已甚泄柳迫。\n识曲诚有人，雅歌奏清瑟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22172,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过弇山尚书废园 其一","author":"韩崇","text":"月沼有波曾照影，风亭无主倩谁扶。\n墙东瘦石如人立，阅尽兴衰一语无。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22173,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过弇山尚书废园 其二","author":"韩崇","text":"经训堂成书万卷，灵岩馆辟树千章。\n功名炙手才华盛，付与游人话夕阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22174,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"无题","author":"钱寿昌","text":"炉烟袅袅透窗纱，斗草人归日未斜。\n梁燕双飞莺对舞，东风间煞碧桃花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22175,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重九登第一山","author":"钱寿昌","text":"数步到山寺，满园寒菜肥。\n溪泉经雨活，檐鸟傍人飞。\n红树叶初下，白云僧独归。\n幽花隔年别，相见尚依依。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22176,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"城东春望","author":"郑襄","text":"散步无远近，幽怀相与清。\n轻阴澹高柳，野水拓孤城。\n雨过菜花烂，风回溪鸟鸣。\n林居吾最羡，安得老桑耕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22177,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"野望","author":"崔宜枚","text":"淡月明空林，寒云隐危堞。\n墟落寂无人，萧萧下黄叶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22178,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"苏桥","author":"崔宜枚","text":"红楼一簇柳千条，隔岸谁家紫玉箫。\n好是晓风残月里，送人帆影过苏桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22179,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"张家湾题壁","author":"华长卿","text":"木落西风起，行人发浩歌。\n河从蒲口浅，树到蔡村多。\n寺古留残碣，池荒剩败荷。\n张湾城北路，雨后示曾过。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22180,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九月初五日同沈虚谷昆仲游浣笔泉用壁上木兰山人元韵","author":"华长卿","text":"清泉㶁㶁出方池，与客登临拜古祠。\n一径松阴秋雨后，半城柳色夕阳时。\n从来我辈多耽酒，到此何人不咏诗。\n独抱幽怀谁见赏，问天惟有谪仙知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22181,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"隋山光寺","author":"华长卿","text":"隋代山光寺，开皇第几年。\n沿堤千亩竹，隔岸万家烟。\n萤苑悲荒草，雷塘剩墓田。\n老僧今在否，汲井问甘泉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22182,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"听蝉","author":"蕴秀","text":"小亭斜坐近花栏，碧树清阴宿雨乾。\n听罢蝉声风曳去，绿波深处夕阳残。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22183,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜行","author":"蕴秀","text":"万壑寂然山月堕，半天星斗夜苍苍。\n岭云不放钟声度，惟有松花一路香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":22184,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]