[{"title":"蟹菊","author":"林抟秋","text":"玉爪金螯品自仙，无肠新样占篱边。\n此花堪拟经纶饱，披甲拳丁战雪天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4374,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"中秋夜望月","author":"林翼池","text":"风捲浮云尽，冰轮出海东。\n井梧金破碎，庭桂玉玲珑。\n素彩流银汉，清辉泻碧空。\n夜阑犹不寐，酣醉月明中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4375,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题分类台湾诗醇","author":"林耀亭","text":"珠遗沧海赖君收，荟萃菁华遍五州。\n汐社风骚联一气，斐亭韵事继千秋。\n焦桐定有知音赏，韫玉终当待价售。\n编纂尽成新卷帙，琳琅满纸豁吟眸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4376,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"壬子1912四十三初度杂感","author":"林馨兰","text":"放眼时登百尺楼，不须作客也悲秋。\n纷纭蛇豕强邻迫，破碎山河故国愁。\n龙尾行藏殊落落，蛾眉谣诼付悠悠。\n年来悟得蒙庄谛，呼我何妨任马牛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4377,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清明感兴","author":"林馨兰","text":"身似浮萍逐水飘，故园回首辄魂销。\n忽逢佳节增惆怅，赖有童蒙伴寂寥。\n忍见桥头沽酒幔，怕闻市上卖饧箫。\n重来崔护偏多感，门巷依然人面遥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4378,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"重九即事","author":"林馨兰","text":"登临不觉夕阳斜，落帽风高忆孟嘉。\n半世蹉跎成白首，频年憔悴瘦黄花。\n无人送酒情偏淡，有意题糕手屡叉。\n盼望盈盈秋水隔，瀼瀼冷露湿蒹葭。\n负郭从无峰可登，聊凭高处望觚棱。\n园林摇落惊萧瑟，笳鼓传喧感废兴。\n对菊自怜情雅淡，把萸不觉兴飞腾。\n雁鸿逐队衔芦去，羡尔知几远避矰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4379,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"将赴春闱道上口占","author":"施仁思","text":"平堤芳草逐轻鞍，作客休歌行路难。\n宿雨困人迟逆旅，好风吹我上长安。\n山容黯淡含朝霭，天气阴晴带晓寒。\n竹里人家云里树，一齐都入望中看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4380,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"有赠","author":"施仁思","text":"妾身心事未分明，一曲笙声送远行。\n大海瀛环三万里，神京路纪八千程。\n珍藏玄露成丹液，伫待春风报姓名。\n玉种蓝田君记取，裴郎端不负云英。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4381,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"冈山道中","author":"施世骠","text":"阴阴竹里隐啼乌，迢递冈山百里途。\n四顾昏林烟历乱，独怜疲马步踟蹰。\n溪桥崩后旋深浅，野店烧残乍有无。\n遥望南村何处是，徘徊歧路问樵夫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4382,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晚渡安平","author":"施世骠","text":"别浦津头渡，轻舟漾晚风。\n波寒鸥出没，舵转岸西东。\n衡宇苍烟外，牛羊落照中。\n禽言花欲暮，云去岛俱空。\n平濑沙倾斗，危樯月系弓。\n剧怜沧海望，惆怅意何穷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4383,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"次洪玉明词兄秋郊韵","author":"施明德","text":"郊原木叶疏，落日送飞鸟。\n山园橘柚垂，青多黄尚少。\n小池荷盖残，红花开水蓼。\n角巾步怀人，翘首望天杪。\n归途出野桥，微茫村径绕。\n行行值上灯，思诗尚未了。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4384,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"辛未1931岁旦书感","author":"施明德","text":"历尽山河吃尽酸，韶华空度月初团。\n依人彻夜当牛喘，伏枥多年效蛰蟠。\n岁晚祭诗追贾岛，春寒问卜忆袁安。\n神仙赐偈期三纪，素志方酬壮大观。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4385,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送别邹仪可司马归东粤","author":"施家珍","text":"良吏诚难得，闾阎免渴饥。\n无襦歌五裤，有麦喜双歧。\n交谊能终始，浇风赖转移。\n攀辕留不住，合立去思碑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4386,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望海","author":"施家珍","text":"凭阑目送几飞鸿，无数归舟趁晚风。\n一抹夕阳天外挂，潮声似在港门东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4387,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"恭咏御题寒月照梅花","author":"洪以南","text":"横斜疏影隐朦胧，大地阳回淑气融。\n处士缟衣酣鹤梦，美人翠袖恋蟾宫。\n双标清格苍苍里，独挺香氛淡淡中。\n羞煞群芳都落后，一枝御苑沐春风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4388,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过大甲溪日暮口号","author":"洪繻","text":"两山夹溪出，众水中流分。\n水落群石起，两山相对奔。\n一水渡未毕，西海已衔半边日。\n不辨山容辨水声，水声急驶如雷疾。\n水挟沙石流滔滔，鲸鱼有脊鲲有尻。\n风雨春秋发洪潦，一溪万窍生怒号。\n招招舟子指行路，路在溪中乱石处。\n陵谷今来几变迁，乱石如山流不去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4389,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"艳歌行","author":"洪繻","text":"捲帘忽茁老蛟须，燃烛忽唾骊龙珠。\n红玛瑙碗青珊瑚，登筵为君祝欢娱。\n窈窕神妃在堂隅，长眉修鬘立斯须。\n瑶旗翠羽苍虎符，即之若有还若无。\n将以饫之无灵巫，我所思兮在远途。\n灵风闪烁霜雪肤，酌君寿君歌吴歈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4390,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"新秋即事","author":"洪繻","text":"西风瑟瑟暮云飞，远望关山路未违。\n两岸白蘋初贴水，一林红叶欲沾衣。\n淞江客爱莼鲈美，衡岳人看荻雁肥。\n独有八闽天尽处，愁来不见片帆归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4391,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"文石","author":"胡健","text":"地灵何处不仙洲，且看文章点石头。\n宝气陆离威凤舞，金光灼烁锦龙浮。\n好将阅世存双眼，未许违时老一丘。\n海外自来多瑰异，愿随方物备共球。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4392,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"文石","author":"胡健","text":"辉山润木最精神，雅重儒林席上珍。\n几度沉埋封草莽，一朝磨琢出风尘。\n不愁抱泣同和氏，转恐抛奇有魏人。\n藻采更饶坚确性，问从何处觅缁磷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4393,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"文石","author":"胡健","text":"光华日月著文石，肯共雕虫小巧争。\n镇物本来资厚重，补天由此费经营。\n树从玄圃花常满，种向蓝田玉自生。\n丝竹一时诉合奏，大成犹藉振金声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4394,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"文石","author":"胡健","text":"大作圭璋小念珠，方圆随意总规模。\n镂光错彩如三棘，夺目怡神亦五都。\n成子汉庭推硕学，充宗文苑颂鸿儒。\n琅玕肺腑璠玙品，价重连城出海隅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4395,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"牛柴","author":"胡健","text":"漫云牛后逊鸡声，粪出呼柴亦令名。\n跨灶人惊烟缕缕，登山谁听斧丁丁。\n输他榾柮原无累，剩得扊扅更有情。\n虽不用燔郊上帝，力能调鼎著和羹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4396,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"留别文石书院诸生","author":"胡健","text":"学舍难忘结构深，杖藜时听读书音。\n虽无韩子兴潮化，具有文翁教蜀心。\n杼柚终当成锦绣，鸳鸯尤冀度金针。\n诸生勉矣终如始，文石辉煌尽国琛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4397,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"薯米","author":"胡健","text":"番薯当米度年华，鼓腹安閒海外家。\n义士不须劳指囷，将军何事慨量沙。\n笑殊香粳供天府，喜并山芋唤地瓜。\n一自岛隅分种后，风流随处咏桃花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4398,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"太极亭记事诗","author":"胡应魁","text":"金鳌突怒涌灵潮，首戴蓬壶矗紫霄。\n渤澥安流缘重镇，岩峦环拱俨班朝。\n红亭忆自初春筑，碧宇新将太极标。\n八卦列成分脉络，一元资始见根苗。\n胚胎万象机还伏，笼罩千门势独超。\n幽旷忽焉开异境，升平允矣庆崇朝。\n乾坤蕴奥全呈露，溪岭妖氛总息消。\n倏报渠魁争面缚，为闻长吏作书招。\n百寻铁索长鲸贯，五色牙旗归马娇。\n佩犊俗移清井牧，听莺兴到集宾僚。\n枝头鸟语因歌乱，槛外花香逐袖飘。\n高阁夜深催进酒，小楼烟冷识吹箫。\n园林此际推名胜，墟市当年怅寂寥。\n客喜如今符颂祷，我怀在昔起忧焦。\n林陈搆乱共诛戮，黄廖连谋复结腰。\n最易潜踪山杂沓，况多游手众浮嚣。\n地灵有述能旋转，邦本宜培怕动摇。\n苛政不曾除猛虎，好音何以感飞鸮。\n天心可向人心卜，杀气恒凭和气销。\n但使官民联指臂，那愁盗贼煽风谣。\n玄关孰探阴阳秘，彝训原同日月昭。\n思患豫防惩怠缓，立成为本戒虚骁。\n濂溪图说须详释，海国琴声未易调。\n留赠后来登眺者，我言窃愿比刍荛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4399,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"九头柑","author":"范咸","text":"传来海上得分甘，玉乳琼浆旧未谙。\n千树何当誇异种，九头今始识真柑。\n曾经黄帕分携重，不厌筠笼取次贪。\n正值上元嘉节后，洞庭休再忆江南。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4400,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"茄藤社观番戏二绝句 其一","author":"范咸","text":"连臂相看笑踏歌，陈词道是感恩多。\n剧怜不似弓鞋影，一曲春风奈若何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4401,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"茄藤社观番戏二绝句 其二","author":"范咸","text":"妙相天魔学舞成，垂肩璎珞太憨生。\n分明即是西番曲，齐唱多罗作梵声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4402,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"昙花","author":"范咸","text":"一茎数蕊尽丛生，粉晕檀心画不成。\n静态雪花堪比洁，幽香莲叶与同清。\n已蠲浓艳消尘劫，应散诸天入梵声。\n传是西方来小种，净因我亦未忘情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4403,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"沪上有赠 其一","author":"唐景崧","text":"秋风万里送南征，一疏声名满帝城。\n酒市歌楼寻侠客，人间何处有荆卿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4404,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"沪上有赠 其二","author":"唐景崧","text":"襟怀浊气鬓边香，伧父妖姬醉一场。\n到此已无乾净土，楼头惟有彗星光。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4405,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"沪上有赠 其三","author":"唐景崧","text":"女儿风调数琅琊，姊妹争妍比赵家。\n七出镜奁双唾袖，果然抹煞沪城花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4406,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"沪上有赠 其四","author":"唐景崧","text":"闻有扶馀在海滨，横磨匣剑秘龙身。\n便宜一个张红拂，附作虬髯传里人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4407,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"沈吉田中丞挽诗 其一","author":"唐赞衮","text":"蛮风催送出山云，莽莽烽烟蔽夕曛。\n偷渡中流狂击楫，投艰历险懋勋勤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4408,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"净翠园截句十二首姑录其三馀从删汰","author":"唐赞衮","text":"晓风残月酒醒迟，半榻茶烟一卷诗。\n秋色满园关不住，东篱又近菊花时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4409,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏西螺柑 其一","author":"唐赞衮","text":"离离青磊砢，佳种出螺西。\n斗酒倾三雅，官衙莫听鹂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4410,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其十七","author":"夏之芳","text":"诸峰攒集黛螺青，玉岭如银色独瑩。\n展拓晴云千万里，插天一幅水晶屏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4411,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其三十","author":"夏之芳","text":"打鼓山头石罅开，悬崖倒拍海潮回。\n雷声鼎沸浮空翠，万里风樯认影来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4412,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秩满留别台阳 其一","author":"夏瑚","text":"兢兢捧檄渡瀛堧，风物台阳别有天。\n面海背山成泽国，高陂低岸遍腴田。\n风淳俗是觚初破，吏拙官同磨在旋。\n三载簿书劳梦寐，搴帘卧理愧前贤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4413,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秩满留别台阳 其二","author":"夏瑚","text":"欲步芳型作宰难，因时敷治称心安。\n宏施大造陶钧力，曲体民生妇子欢。\n断狱若神惭铁岭，澄怀似水愧清端。\n他年倘谱循良传，敢信微名取次刊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4414,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台阳杂咏 其三","author":"孙尔准","text":"风草欣无节，霜筠怯走鞭。\n玉香花媚晚，金缀菊迎年。\n湖采螺纹石，番通马剑钱。\n忽看方物集，新返荷兰船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4415,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台阳杂咏 其四","author":"孙尔准","text":"拱鼠曾名曲，蹲鸥藉作粮。\n潮鱼惊海熟，火鹿悯番荒。\n檨捣蓬莱酱，椰倾沆瀣浆。\n病来烦米卦，三保有遗姜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4416,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寄怀家工部仞千 其一","author":"徐仲山","text":"相逢今日倍相思，名士风流想见之。\n两试冠军推辣手，一魁独佔许扬眉。\n云程发轫同誇早，杏苑探花莫放迟。\n麟种家声今未坠，埙篪好赋玉台诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4417,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寄怀家工部仞千 其二","author":"徐仲山","text":"铁石梅花励志坚，囊萤造凤重英年。\n鹏程九万须张翮，鲲浪三千要著鞭。\n风月楼高谁作主，珊瑚笔妙尔应传。\n霓裳定订琼宫谱，他日仍当会众仙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4418,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寄怀家工部仞千 其三","author":"徐仲山","text":"丝竹逢君写素心，高山流水有知音。\n枝因许借仍栖枳，花到亲探便入林。\n文字有灵能赤绿，诗书无劫可浮沉。\n春风若释虞翻恨，始信名山酝酿深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4419,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寄怀家工部仞千 其四","author":"徐仲山","text":"弱冠曾歆李杜名，怜渠秀骨本天成。\n阳春白雪凭谁和，凤管鸾笙赖尔赓。\n司马才高凌汉代，雕龙手妙接西京。\n休将彩笔题桥柱，留作升平雅颂声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4420,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"钟声摇暮天","author":"徐宗干","text":"不辨钟何处，声声欲暮天。\n舂容萧寺里，摇曳夕阳边。\n残响盘空际，馀音绕树巅。\n樵风穿古径，渔火动江船。\n催上城头月，撞开橹背烟。\n黄昏无限意，千里客心悬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4421,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鸡冠花 其一","author":"徐宗干","text":"斜斜整整遍幽蹊，一色名花肖木鸡。\n移向竹篱钻土早，种来茅店傍墙低。\n风摇四面秋还舞，露饱三更晓不啼。\n红紫缤纷争斗艳，日之夕矣小楼西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4422,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鸡冠花 其二","author":"徐宗干","text":"斗草曾看疑雀弁，莳花有谱种鸡冠。\n叶零夜雨潇潇湿，顶向秋阳片片丹。\n碎锦丛中如聚鹬，群芳队里讶栖鸾。\n谈元窗外虽无语，绛帻依然报晓寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4423,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雁来红 其一","author":"徐宗干","text":"一幅红罗孰剪裁，高斋初见雁飞来。\n不分老少当阶种，直把珊瑚绕屋栽。\n有信恰随秋影到，无花也向夕阳开。\n惊寒莫谓江南早，依旧春风锦绣堆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4424,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋声八咏用杜公部秋兴八首韵","author":"徐宗干","text":"昨夜凉飙动远林，捣衣窗外气森森。\n临风净拭添泉水，对月低舂隔树阴。\n千里征人能入耳，三秋少妇早关心。\n虫鸣四壁浑如语，刀尺装绵付藁砧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4425,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋声八咏用杜公部秋兴八首韵","author":"徐宗干","text":"万里萧条日影斜，天涯怅望感霜华。\n边城上月惊秋雁，戍客思乡忆海槎。\n未断玉门新柳笛，迸传紫塞短芦笳。\n西风起处声声急，一夜征人泪眼花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4426,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋声八咏用杜公部秋兴八首韵","author":"徐宗干","text":"峰峦一抹衬秋晖，古木萧疏露翠微。\n猿抱悬崖千丈啸，鸦栖落叶半天飞。\n梵音泉石心思彻，诗境匡庐面目违。\n绝顶百围吟远籁，尚留红树带霜肥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4427,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋声八咏用杜公部秋兴八首韵","author":"徐宗干","text":"旅人江上罢弹棋，高枕潮声动客悲。\n怒若蒸雷鸣鼓起，快如奔马下坡时。\n长堤日暗飞沙猛，孤艇人忙系缆迟。\n看到广陵留胜迹，年年八月触秋思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4428,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋声八咏用杜公部秋兴八首韵","author":"徐宗干","text":"悠然送别楚江头，沙鸟咿哇水国秋。\n伴侣相依芦荻稳，呼鸣不为稻梁愁。\n畅游此际应添鹤，閒悟生涯寄一鸥。\n为有高人同狎处，围栏凭眺忆扬州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4429,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋声八咏用杜公部秋兴八首韵","author":"徐宗干","text":"蝉鸣黄叶半空山，写尽秋声入树间。\n月落疏桐深院静，烟迷垂柳小园关。\n幽怀触起移琴操，客梦惊残感鬓颜。\n羡尔居高声及远，煎茶清忆凤池班。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4430,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋声八咏用杜公部秋兴八首韵","author":"徐宗干","text":"荷沼无烦灌溉功，莲残叶尚满池中。\n清思徐引如听雨，小柄轻摇不待风。\n翠盖几经秋露白，水亭一角夕阳红。\n陂塘潋滟鸥凫静，柔舻声声隐钓翁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4431,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋声八咏用杜公部秋兴八首韵","author":"徐宗干","text":"一望淮南路逦迤，梧桐秋色老山陂。\n疏阴滴雨悬珠颗，碎影敲风埽翠枝。\n客梦不如琴梦稳，雁声遥带漏声移。\n石栏閒坐诗成未，仙露今宵笔底垂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4432,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"衙斋秋兴","author":"书山","text":"秋半犹炎热，中庭草木香。\n片云天浅碧，疏叶橘轻黄。\n不厌虫鸣急，还贪竹影凉。\n人閒公事少，无睡夜初长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4433,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"吴凤庙重修落成","author":"翁煌南","text":"跃马横刀意气雄，满腔热血破蛮风。\n精诚格厉神威在，从此重新庙貌崇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4434,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"舟中有感","author":"翁煌南","text":"东都此去路漫漫，回首离情泪不乾。\n寞寂孤舟难写恨，家乡窃喜望中看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4435,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"东宁十咏","author":"高拱乾","text":"天险悠悠海上山，东南半壁倚台湾。\n敬宣帝泽安群岛，愧乏边才控百蛮。\n瘴雾扫开新气宇，风沙吹改旧容颜。\n敢辞远迹烟波外，博望曾经万里还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4436,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"庚申1920小春月偕友到粗坑○览形势密察机关心有所○招○○七律一则以志感○呈以博一粲","author":"高选锋","text":"渡溪越岭到粗坑，路上频闻机器声。\n洞达乌来从地辟，源通屈尺俨天成。\n光腾台北云霄外，电发郡南日月明。\n五彩银灯新世界，州民鼓腹颂升平。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":4437,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]