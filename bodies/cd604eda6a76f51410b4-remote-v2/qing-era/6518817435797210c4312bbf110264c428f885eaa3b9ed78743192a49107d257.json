[{"title":"又之茂才客游鹿港，富益斋司马邀同赴兰厅，道径堑垣赠诗，即和元韵二首 其二","author":"郑用锡","text":"解组归田学杜门，龙钟一老敢称尊。\n衰年黄卷仍为伴，故物青毡幸尚存。\n差喜足音到空谷，相携佳句倒芳樽。\n最愁风雨中秋夜，莫共乘槎贯月论。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34521,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟游淡江访迂谷，阻雨不果","author":"郑用锡","text":"明月屋梁颜色亲，情当久别恋尤真。\n敢持牛耳寻盟主，犹恐猪肝累主人。\n五载离怀成旧雨，连番命驾阻征尘。\n与君同是归田客，何日名山共买邻？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34522,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游栖野巢访迂谷，留饮赋赠二首 其一","author":"郑用锡","text":"谷饮岩栖物外閒，今朝何幸得追攀！\n牙签架上书千卷，锦缆门前水一湾。\n底事移居嫌近市，何心挂笏共看山？\n知君胸次饶丘壑，一任白云自往还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34523,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游栖野巢访迂谷，留饮赋赠二首 其二","author":"郑用锡","text":"山中世界本清真，兼味盘餐笑语亲。\n北海开樽逢此日，西窗剪烛话前因。\n衣冠相对人希古，风月为邻我是宾。\n甚欲勾留穷一览，江潮催梦又归津。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34524,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸡笼纪游","author":"郑用锡","text":"已偿婚嫁更何求，胜阜差当五岳游。\n贴水雌雄寻鲎屿，隔江大小辨狮毬。\n茫茫波浪天边涌，一一帆樯眼底收。\n别有孤峰峙空际，遥从砥柱溯中流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34525,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和许荫庭明经、刘星槎茂才题赠北郭园原韵二首 其一","author":"郑用锡","text":"乡关踪迹溷樵渔，买得田园且卜居。\n桑亩可能开蒋径，萧斋今欲仿陶庐。\n欣将隙地资归隐，聊借馀年读旧书。\n为语儿孙须树立，向平婚嫁莫愁余！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34526,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和许荫庭明经、刘星槎茂才题赠北郭园原韵二首 其二","author":"郑用锡","text":"春明解组为娱亲，弹指俄成白发人。\n且喜昂头来峤外，敢将洗耳向江滨。\n为贪幽僻山兼水，幸引宾朋夕又晨。\n花外楼亭池畔月，区区度此百年身。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34527,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"再和荫庭二首 其一","author":"郑用锡","text":"老夫归计问耕渔，新筑吟窝徙旧居。\n僻地无尘留静境，凌霄有竹爱吾庐。\n敢誇门地称通德，尚望儿曹读父书。\n我本疏慵忘宦况，为牛为马任呼余。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34528,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"再和荫庭二首 其二","author":"郑用锡","text":"一卷陔华乐养亲，依然海上作閒人。\n挂冠早见辞天阙，漱石长思问水滨。\n得藉丘园娱晚节，且培林木对芳晨。\n角巾已遂柴桑愿，省却浮名绊此身。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34529,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"北郭园即事","author":"郑用锡","text":"愧无广厦庇欢颜，舞鹤匡床日往还。\n四壁丝匏有文字，数村松竹是家山。\n天教境界邻城郭，地幸喧嚣隔市寰。\n我本武陵新避世，苍苔十里掩柴关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34530,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"述怀","author":"郑用锡","text":"无端画饼愿空酬，忽忽馀生已白头。\n婚嫁幸完儿女债，田园谁足稻粱谋？\n成阴林木同名节，垂暮光阴等幻沤。\n富贵浮云随分好，微躯此外复何求？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34531,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"友人自豫章来，喜食蟹，云不尝此味十三年矣，作此赠之","author":"郑用锡","text":"郭索由来价易偿，幸将乡味此间尝。\n一帆蒪菜思吴郡，十载家山别豫章。\n岂有将军甘负腹，应知公子本无肠。\n而今正好秋风饱，且自持螯一举觞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34532,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"侄孙纪南入泮","author":"郑用锡","text":"回忆归田解组时，髫龄乍见早称奇。\n成篇一一诗书诵，属对泠泠响应随。\n洗耳幸传千里报，关心又到九秋期。\n頖宫骥足初教展，努力加鞭莫放迟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34533,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"对菊","author":"郑用锡","text":"物候催移岁月忙，繁英代谢感风霜。\n人誇老圃秋容淡，我爱疏篱傲骨香。\n晚节几同韩相国，孤标此即鲁灵光。\n平生何处寻知己，五柳门前隐士乡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34534,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自遣","author":"郑用锡","text":"富贵祇归春梦婆，柴门无事日张罗。\n已成书癖消閒好，欲索枯肠奈老何！\n坛沾晨星同辈少，天涯今雨少年多。\n敢誇驽马途能识，聊对桑榆托浩歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34535,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"余主明志讲席，入都后，代者为藻亭弟，今春假还，仍主之，志感","author":"郑用锡","text":"载酒仍看问字奇，再来渐觉鬓成丝。\n追陪杖履趋榆社，惭愧丹铅托绛帷。\n少不如人何况老，才难信己敢称师。\n青毡本是吾家物，十载门墙共护持。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34536,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"哭棨亭弟","author":"郑用锡","text":"相随日日雁行亲，卜筑家山托比邻。\n谁料汝为长夜客，始惊我亦暮年人。\n还教妻老持门户，却恸儿雏累米薪。\n屈指弟兄亡过半，此身虽在已伤神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34537,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"即景","author":"郑用锡","text":"连旬阴雨望时晴，扶杖聊为郭外行。\n啼鸟有声閒布谷，叱牛到处看催耕。\n一泓池沼春三月，两部蛙蟆夜六更。\n最是名园风景丽，新栽花柳已抽萌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34538,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"新春","author":"郑用锡","text":"梅花万本笑巡檐，久叠朝衫岁又添。\n春漏日迟钟报晷，萧斋书积架分签。\n池塘有梦寻青草，风雨催人到黑甜。\n差喜此身仍健在，不劳家计问齑盐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34539,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"苦雨","author":"郑用锡","text":"年华初度已清明，阴雨连旬尚未晴。\n麦饭纸钱人上冢，提壶布谷鸟催耕。\n可怜柳絮飞仍坠，又值秧针插未成。\n为祝东皇香自爇，莫教物候误苍生！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34540,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"偶咏","author":"郑用锡","text":"檐檐无事掩柴扉，草长阶前藓自肥。\n扫叶时开元亮径，灌园早息汉阴机。\n满腔春意心常在，一穗书灯愿不违。\n退院我同僧寂寞，只应兀坐到斜晖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34541,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"壬子生日二首 其一","author":"郑用锡","text":"六旬又长五年期，两鬓星霜已似丝。\n闻见四朝还是福，艰难一第不为迟。\n隙驹转瞬惭添齿，盥兕连朝醉祝眉。\n差幸筋骸仍健在，家园杖履免扶持。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34542,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"壬子生日二首 其二","author":"郑用锡","text":"蒲酒觞开览揆辰，此生修短本前因。\n故乡旧雨稀同辈，天末晨星剩几人！\n敢拟灵光存鲁殿，同游衢壤作尧民。\n自惭樗栎终无用，居上由来望积薪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34543,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自叹","author":"郑用锡","text":"劳劳世事欲何为，自古名流志不羁。\n快意每耽丝竹肉，遣情或寄画书诗。\n迂拘似我全无用，懒拙教人共笑痴。\n只有一经聊独守，平生端未负须眉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34544,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"荐阶茂才小饮北郭园赠诗，和原韵四首 其一","author":"郑用锡","text":"幸逢孔李属通家，难得英龄富五车。\n愧我鬓丝添作雪，羡君手笔梦生花。\n多时蠖屈才逾壮，此去鹏抟路岂赊！\n自古晚成原大器，一杯相属莫咨嗟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34545,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"荐阶茂才小饮北郭园赠诗，和原韵四首 其二","author":"郑用锡","text":"功深面壁已多年，一梦邱迟碎锦妍。\n文选维摩承祖德，法书萧寺继前贤。\n莲花入幕称佳士，鹤氅同舟望若仙。\n曾伴词曹星使出，天涯衣钵待人传！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34546,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"荐阶茂才小饮北郭园赠诗，和原韵四首 其三","author":"郑用锡","text":"丘园养拙拜经神，敢比躬耕郑子贞！\n懒扫门庭留鼓吹，曾携杖履近星辰。\n林泉有梦依天上，文学何缘托海滨。\n幸遇足音空谷贲，多君不薄退休人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34547,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"荐阶茂才小饮北郭园赠诗，和原韵四首 其四","author":"郑用锡","text":"七年书剑感飘零，今日相逢水上萍。\n折柬相招来旧雨，衔杯无语怅晨星。\n才如曲逆贫非病，人是次公醉亦醒。\n此别为君操左券，应从千佛列名经。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34548,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"荐阶赠诗，再和元韵二首 其一","author":"郑用锡","text":"谁能只手挽狂澜，莽莽乾坤醉里看。\n绛帐十年吾已老，青毡一领汝犹寒。\n得供菽饱知非易，说到薪传大是难。\n千古几人能述作，文章我愧尚推韩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34549,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"荐阶赠诗，再和元韵二首 其二","author":"郑用锡","text":"如此头颅唤奈何，蚕丝到老已无多。\n聊同蚓吹重泉出，敢许蛙鸣两部歌。\n自笑桑田容我适，无端铁砚课孙磨。\n诗书且领清閒福，日月凭他似掷梭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34550,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"颂述安司马德政二首 其一","author":"郑用锡","text":"盘根错节独恢恢，两载需公保障才。\n每为鞭长防远道，却愁火灭更燃灰。\n栉风沐雨知谁苦，卧辙攀辕盼再来。\n如此劬劳真父母，替人召杜许追陪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34551,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"颂述安司马德政二首 其二","author":"郑用锡","text":"谁借阶前尺地扬，春风桃李遍公堂。\n万间广厦罗冯铗，一勺廉泉润赵囊。\n月旦衡文亲几席，璆琳得士列门墙。\n却惭笔砚荒芜者，许我青毡炙末光。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34552,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丙辰元日","author":"郑用锡","text":"蜗角蛮疆息战争，海隅又复岁时更。\n持家生计忧难补，比户官祖苦尚征。\n对镜二毛惭易老，观书双眼幸犹明。\n为充天庾催输粟，转漕功谁第一成！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34553,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"有感","author":"郑用锡","text":"缃帙何曾富五车，稍能吟咏足豪华。\n无多远识辽东豕，自笑拘墟井里蛙。\n嘈杂声音惟和蚓，编排字句欲涂鸦。\n詅痴符己人人画，覆瓿文章莫漫誇！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34554,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"正月三日即景","author":"郑用锡","text":"年华今日叶三阳，微雨初睛曙色光。\n胜地谁游邛竹杖，名园仍守古柴桑。\n衣冠揖让分甘赠，杯勺纵横索酒尝。\n赢得老夫仍独坐，欲寻梅柳问东皇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34555,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送神迎神作","author":"郑用锡","text":"阊阖鹓班玉笋联，如何诸佛亦朝天？\n云车风马家家送，卯酒辛盘度度虔。\n乞奏绿章香一缕，拈投杯珓酒当筵。\n邮程计汝无多日，只在新年接旧年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34556,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"罗兼三自豫章归","author":"郑用锡","text":"音书久已断文鳞，今日刀环幸再亲。\n一十三年沉苦海，二千馀里作劳薪。\n西江流水难销恨，南国归帆许问津。\n从此家乡长聚首，赢他遗骨瘗边尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34557,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"叹老","author":"郑用锡","text":"为底踆乌岁月催，挥戈莫挽夕阳回。\n关心此后情难了，触目当前志已灰。\n老得馀閒庸是福，身能早退拙为媒。\n悠悠世事凭谁料，剥复盈亏任去来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34558,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"遣闷","author":"郑用锡","text":"蓬门寂寂久张罗，兀坐如僧奈老何！\n已分閒云容我懒，可怜短墨当人磨。\n春来欲访梅花讯，梦醒初听鸟雀歌。\n如此韶华聊自遣，敢云托体并山阿？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34559,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"述德","author":"郑用锡","text":"当知贻厥起寒儒，凿砚为田得食租。\n毕世俭勤尝薤韭，千秋俎豆盼枌榆。\n刊碑父老谈名姓，遗矱儿孙谨步趋。\n犹记弥留清白语，传家即此是良图。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34560,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"铁钱","author":"郑用锡","text":"竟化铜山作铁钱，一文偿十百偿千。\n度支已告脂膏竭，阿堵无殊品质悬。\n如此六州真铸错，可怜九府欲通权。\n从今万选何人重，却对泉刀一黯然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34561,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"改葬先茔","author":"郑用锡","text":"牛眠欲卜几盘桓，劫火连天泪暗弹。\n生有宝田传世在，死无石椁护身难。\n一坏骨肉仍同穴，百代衣冠择所安。\n此后儿孙应稍慰，天长地久共漫漫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34562,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏斋中梅柳","author":"郑用锡","text":"小斋梅柳斗韶光，各自争春各擅长。\n柳竟让梅花掩映，梅犹输柳叶青苍。\n有花无叶徒誇艳，有叶无花自逞狂。\n好是人工能补缀，移将花叶两相当。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34563,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"元宵感事","author":"郑用锡","text":"春光艳说到元宵，为底观灯更寂寥？\n无复鱼龙喧百戏，谁看蹴鞠转三桥？\n祈男柑向龛前乞，听卜香藏袖里烧。\n此是海邦今夕景，不妨记取作风谣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34564,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"司马薛耘庐、李信斋、曹怀朴、曹馥堂四公遗爱在民，余捐金奉栗主与娄秋槎司马同祀于书院敬业堂，诗以志之","author":"郑用锡","text":"四十年来惠爱遗，馨香始报未嫌迟。\n竞传循吏堪留传，为记前尘倍去思。\n一代名尊司户竹，千秋泪坠岘山碑。\n可知直道人心在，召杜应为后起师。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34565,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"閒健二首 其一","author":"郑用锡","text":"古稀只隔一年期，矍铄全凭口福贻。\n傲骨本难腰委折，衰躯未藉杖扶持。\n名归画饼终何用，梦破炊粱敢自痴。\n造物予閒兼予健，老翁尚忆放翁诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34566,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"閒健二首 其二","author":"郑用锡","text":"晚景真无一事娱，得邀閒健度桑榆。\n河山非昔交游少，朋辈无多笑语孤。\n每欲倾杯愁量窄，偶思对局怕棋输。\n不如还把残书看，到老依然是故吾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34567,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"盂兰盆词十首 其一","author":"郑用锡","text":"幡花龙伞玉京山，载鬼驱车簇市阛。\n堪笑冕旒争一饱，大难桎梏赎千锾。\n丹青磨灭麟空绘，华表荒凉鹤未还。\n鼎食钟鸣都往事，可怜袍笏尚人间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34568,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"盂兰盆词十首 其二","author":"郑用锡","text":"十万青蚨撒手哀，曾无富贵到泉台。\n舍身瓦器终求蜜，敌国铜山总化灰。\n甲乙何人操鬼簿，卵胎有劫付轮回。\n纸钱今夕新盈贯，莫便揶揄作态来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34569,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"盂兰盆词十首 其三","author":"郑用锡","text":"馁魂窣窣逐良辰，犹是烟蓑雨笠身。\n甘露可能沾白骨，火坑暂许咽青唇。\n田园笋蕨谋孙子，邱陇牛羊属别人。\n寄语此间多菜色，饥驱难饱藿羹尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34570,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"盂兰盆词十首 其四","author":"郑用锡","text":"钿影钗光土一邱，声声梵筴唤回头。\n有情眷属完婚嫁，绝代红颜是髑髅。\n百日成妖南岳障，千金酿祸绿珠楼。\n重泉莲步艰难苦，结得香花入袖不？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34571,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"盂兰盆词十首 其五","author":"郑用锡","text":"又是哀丝豪竹天，梨园子弟散如烟。\n一场笑噱留唇舌，十载生涯付管弦。\n托钵赧颜新鬼唱，赠袍熨体故人怜。\n而今听彻皈依佛，应悔徵歌到昔年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34572,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"盂兰盆词十首 其六","author":"郑用锡","text":"校籍头衔属地官，众僧解夏具盘餐。\n一瓢此日分羹足，千蹠生前下箸难。\n萧衍面牲终早计，冯驩鱼铗莫轻弹。\n老饕欲破蔬茹例，多事瑜珈护法坛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34573,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"盂兰盆词十首 其七","author":"郑用锡","text":"寸魂尺魄亦登场，玉碎兰摧事可伤。\n五载孱躯非寿者，一家泥首礼空王。\n今宵佩䚢应来受，再世衔环总渺茫。\n愿祝莲花生净土，莫教容易化衣裳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34574,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"盂兰盆词十首 其八","author":"郑用锡","text":"一坏何处哭文星，误坠秦坑梦不醒。\n三尺红罗留字去，十年燐火逼灯青。\n酸儒枵腹哀呼癸，饱鬼顽皮岂识丁。\n笑煞宫花成底事，是非忏尽法华经。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34575,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"盂兰盆词十首 其九","author":"郑用锡","text":"苦海沉沦不记年，沙虫猿鹤化三千。\n英雄末路钓难脱，水火何人发倒悬。\n嚼齿九原呶厉鬼，断头大将立刑天。\n恩仇到此冰销未？\n洒遍杨枝碧血膻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34576,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"盂兰盆词十首 其十","author":"郑用锡","text":"元都狮吼斗狰狞，?犬重围破铁城。\n尘世收场皆傀儡，魔宫褫魄到公卿。\n四山宿草月将曙，满地纸灰铃有声。\n太息中原兵燹苦，烽烟十里水灯明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34577,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"落叶二首 其一","author":"郑用锡","text":"凄迷莫辨路西东，古木萧萧度塞鸿。\n入世何人不易节，出山几辈免飘蓬！\n满阶月冷苔无迹，一夜霜高泪欲红。\n终是托根未牢固，敢将摇落怨秋风？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34578,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"落叶二首 其二","author":"郑用锡","text":"叠叠重重万里沙，高音四起乱筝琶。\n空山落月惊寒蟀，孤驿斜阳数暮鸦。\n自古落花不返树，几时飞絮得成家？\n遥怜湖海飘摇子，离合关心天一涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34579,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"白梅花","author":"郑用锡","text":"孤山隔断软红尘，冷淡生涯铁石人。\n尽洗铅华空色相，独留雪月见精神。\n接䍦倒著谁过访，茅屋相依不厌贫。\n信是百花头上占，白衣能酿万家春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34580,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"五雅吟 其一 吏","author":"郑用锡","text":"五柳头衔岘首碑，六衙昼永且弹棋。\n几清案牍书堆满，堂有琴声月上迟。\n薄俸无多堪豢鹤，小胥镇日只钞诗。\n春风桃李河阳暮，又向湖西看水嬉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34581,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"五雅吟 其二 将","author":"郑用锡","text":"不觅封侯觅爱卿，春深柳锁亚夫营。\n扇巾潇洒真无敌，裘带宽閒旧有名。\n驴背老存垂钓叟，虎头前是叶繻生。\n沙场听惯投壶唱，十万貔貅亦解声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34582,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]