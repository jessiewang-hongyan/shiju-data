[{"title":"秋日都门感怀五首 其二","author":"戴亨","text":"漠漠孤云细，遥连渤海东。\n日光吞野马，山色悴秋风。\n骨以怀亲瘦，囊因绝俗空。\n归心千里外，飘转逐旋蓬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10216,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋日都门感怀五首 其三","author":"戴亨","text":"世情浓极处，偏喜绝无闻。\n彻骨贫应尔，谋身事岂群。\n苍松寒啸雪，孤鹤健淩云。\n败叶经风雨，萧萧落正纷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10217,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋日都门感怀五首 其四","author":"戴亨","text":"万物逢秋杀，荣枯此日看。\n回风山骨慄，落叶雨声乾。\n炼炭炊长馁，悬鹑衣自安。\n敢云贫亦乐，颇惜后凋难。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10218,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋日都门感怀五首 其五","author":"戴亨","text":"迂儒投俗尚，那得好怀开。\n野性从人议，刚肠每自回。\n归鸿冲塞入，苍隼刷天来。\n吾道唯安拙，呼朋纵酒杯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10219,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"旱","author":"戴亨","text":"风鼓边声劲，尘埋日色悬。\n但看阴匝地，不见雨垂天。\n割下银河水，应沾万顷田。\n自惭无羽翰，惆怅意茫然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10220,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"微雨忽晴","author":"戴亨","text":"正喜甘霖沛，旋看螮蝀东。\n断云携雨黑，落日散江红。\n鸟湿愁深树，鱼归会晚风。\n独饶忧国意，沾溉望年丰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10221,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"与诸同人泛舟天桥湾得骸字磨字二首 其一","author":"戴亨","text":"呼艇缘城角，移尊向柳涯。\n棹回天忽破，帆正浪空排。\n野景开晴旭，高云补断厓。\n中流同啸咏，真觉忘形骸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10222,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"与诸同人泛舟天桥湾得骸字磨字二首 其二","author":"戴亨","text":"雨暗昨霄月，烟开此日波。\n阴晴时不测，天地意如何。\n云色风头静，天光水面磨。\n悠然若有会，山鸟忽来歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10223,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"再至红桥","author":"戴亨","text":"再至曾游处，山家熟更宜。\n迎人村犬狎，入室野云随。\n地僻孤峰秀，天空独鸟迟。\n坐深心境静，忘却夜归时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10224,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"都门喜晤方问亭旋送出关凭达家书三首 其一","author":"戴亨","text":"昔别龙沙道，同悲异域身。\n长安重破涕，故国未归人。\n事业频虚岁，衰强互问亲。\n平生关切意，患难觉尤真。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10225,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"都门喜晤方问亭旋送出关凭达家书三首 其二","author":"戴亨","text":"七年才一晤，一晤复分襟。\n辛苦成何处，乾坤共此心。\n梦中乡国杳，天外海云深。\n岁月惊虚掷，吞声塞上吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10226,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"都门喜晤方问亭旋送出关凭达家书三首 其三","author":"戴亨","text":"话旧君能主，君行愧我贫。\n交虽形迹外，倍觉怆离神。\n陟岵天涯子，倚闾塞上亲。\n一函凭远达，心逐渡辽尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10227,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"三至红桥","author":"戴亨","text":"频来幽赏地，林壑意相迎。\n倚杖缘溪立，晴云隔水生。\n吟情随处远，野性觉名轻。\n得意忘言说，松风拂面清。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10228,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"宿镇安堡","author":"戴亨","text":"惨雪搏风急，阴云覆野宽。\n马羸思辙卧，身病怯衣单。\n猎虎饥来惯，羁人梦未安。\n祇愁途路塞，不敢夜冲寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10229,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春望","author":"戴亨","text":"云捲千峰翠，烟消万壑晴。\n欲看春景丽，翻使客心惊。\n鸿雁抟风健，鹪鹩托羽轻。\n雄边望不尽，归意若悬旌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10230,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"将至房山先寄寄斋先生","author":"戴亨","text":"客舍频迁次，飘零愧腐儒。\n愁来唯仗酒，囊尽不能沽。\n翠嶂晴云细，清溪浩月孤。\n思君吟赏处，早晚就菰蒲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10231,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"邃壑","author":"戴亨","text":"已远孤村北，还过邃壑南。\n云峰腾峻岭，天影浸空潭。\n入世情何淡，看山性颇贪。\n几时沾薄俸，归去觅烟岚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10232,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"袒腹","author":"戴亨","text":"解衣挂萝薜，袒腹净尘氛。\n幽意惭高鸟，烦心羡白云。\n何时祛世务，终岁出人群。\n结屋同泉石，襟期一證君。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10233,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"再过佛氏山庄","author":"戴亨","text":"尘寰意不惬，策杖问莓苔。\n桥断依山曲，溪流碍石回。\n苍烟樵子径，老雪故人梅。\n坐我春风里，谈深发旧醅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10234,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"查验任邱被水山庄","author":"戴亨","text":"永夜不能寐，晨兴信仆夫。\n人烟衰草白，秋色暮云孤。\n野艇冲冰入，残黎隔岸呼。\n皇恩来救汝，不是吏催租。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10235,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"宿里长","author":"戴亨","text":"里长昏投宿，浮邱见水灯。\n柴垣一破寺，鸠面两枯僧。\n禦腊缝山□，充饥晒水藤。\n自誇逃窜尽，生计有馀能。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10236,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"书怀 其一","author":"戴亨","text":"韬精超俗虑，幽想洽岩栖。\n结屋峰千仞，侵篱月一溪。\n耸身霄汉近，放眼白云低。\n此际堪逃俗，相观物性齐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10237,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"书怀 其二","author":"戴亨","text":"戴笠理荒秽，晨兴出露垣。\n诛茅培屋宇，移石让松根。\n收柿工书翰，分泉灌竹园。\n百年长此役，今世即羲轩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10238,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"须白","author":"戴亨","text":"吾须方四十，白间黑中丝。\n精力衰何遽，平生境可思。\n学惭余未进，老逼尔先知。\n辛苦年年事，殷勤怯岁迟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10239,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"发白","author":"戴亨","text":"对镜惊霜雪，丝丝入鬓新。\n忽思千古事，转虑百年身。\n不老亦无术，长存自有神。\n颜彭今日看，修短定谁真。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10240,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送秦妹丈之中江县令","author":"戴亨","text":"十年膺一命，此去自难留。\n叱驭蚕丛道，怀亲燕市楼。\n江声流万古，风叶下残秋。\n知尔中途泪，潺湲不可收。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10241,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梅","author":"戴亨","text":"草木凋枯日，冰霜酷烈时。\n香深天地苦，花发古今奇。\n岁月嗟何暮，风光占未迟。\n孤芳谁独赏，应与野人期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10242,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寄中江秦妹丈","author":"戴亨","text":"蜀道虽云险，中江政不繁。\n民因招募聚，官赖抚循恩。\n云栈悬丹嶂，松涛撼夜猿。\n专心思报最，乡泪莫潺湲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10243,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"须白","author":"戴亨","text":"须白已多日，无如近转添。\n蹉跎成底事，寂寞感华年。\n修慝频看镜，扶衰不学仙。\n数茎留警惰，吾道岂从天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10244,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"石琴步屈悔翁原韵 其一","author":"戴亨","text":"一与青峰别，居然绿绮横。\n古风吹壁冷，幽谷响泉清。\n谁解临厓听，空令逸韵生。\n知音如可遇，天地有新声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10245,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"石琴步屈悔翁原韵 其二","author":"戴亨","text":"他山蒙在御，雕琢已无辞。\n轻薄怜胶漆，风尘岂磷缁。\n霜峰寒雁落，哀峡断猿迟。\n别调成孤赏，空山雨雪时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10246,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"再叠前韵 其一","author":"戴亨","text":"山川藏不住，斸作紫琼横。\n身带波涛润，音传岩壑清。\n庙堂虽不御，苍翠觉长生。\n堪惜米颠拜，何知听此声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10247,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"再叠前韵 其二","author":"戴亨","text":"不知补天用，聊传清庙辞。\n柱徽殊习玩，坚白涅难缁。\n霖雨鸣崖细，松风度陇迟。\n高山今在望，识曲慕当时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10248,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"三叠前韵 其一","author":"戴亨","text":"兹琴非近乐，不许膝前横。\n本以重难御，兼之音太清。\n风霄玄鹤下，丹穴彩鸾生。\n应与鸣球贡，熏风一奏声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10249,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"三叠前韵 其二","author":"戴亨","text":"解鼓神人格，知稀弃不辞。\n绝无凡指弄，翻少俗尘缁。\n挂壁侵苔古，游鱼出水迟。\n昔贤成此意，应不悦当时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10250,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"仲夏过红桥阻雨次日寻幽至暮 其一","author":"戴亨","text":"耽幽忘溽暑，特地到君家。\n草色分行鹿，莺声老落花。\n于陵逃俗远，陶令去官赊。\n野性偕孤鹤，相随看早霞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10251,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"仲夏过红桥阻雨次日寻幽至暮 其二","author":"戴亨","text":"阴云留过客，携雨到柴门。\n杯酒谋邻叟，园蔬乞近村。\n深灯连曙柝，幽梦绕山樊。\n自古唯萧索，方知重友伦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10252,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"仲夏过红桥阻雨次日寻幽至暮 其三","author":"戴亨","text":"葛衫朝觉爽，宿雨夜初还。\n溪涨来新鸟，云开见远山。\n偶凭丞相圃，暂豁旅人颜。\n回首燕城内，风尘咫尺间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10253,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"仲夏过红桥阻雨次日寻幽至暮 其四","author":"戴亨","text":"饭后复来坐，清风开我襟。\n山云低度涧，溪鸟不归林。\n日色回峰影，诗情惜柳阴。\n春风沂水后，怀古一何深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10254,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"仲夏过红桥阻雨次日寻幽至暮 其五","author":"戴亨","text":"欲窥群物理，非独爱村晴。\n临水知鱼乐，看山识鸟情。\n天机真自畅，幽绪亦旋生。\n游衍閒居地，荣名顿觉轻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10255,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"仲夏过红桥阻雨次日寻幽至暮 其六","author":"戴亨","text":"避日频移席，残尊落照间。\n农人归陇犊，樵爨隐云山。\n佳景随时得，劳生贵自閒。\n还将无尽意，乘兴叩松关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10256,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"香山看红叶得黄字秋字二首 其一","author":"戴亨","text":"山寒经宿雨，树树杂丹黄。\n名士耽幽胜，新诗寄草堂。\n偶依流水坐，翻叹俗尘忙。\n嘉会还期再，秋风引兴长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10257,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"香山看红叶得黄字秋字二首 其二","author":"戴亨","text":"几载尘劳梦，名山得暂留。\n杖藜探绝壑，云树状高秋。\n野性看飞鸟，寒声听夜流。\n凭将幽僻兴，携手问同游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10258,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"宿来青轩","author":"戴亨","text":"已览香山胜，还寻胜地眠。\n阴崖连户竹，疏磬出山烟。\n月色缘阶上，泉声到枕边。\n夜来魂梦冷，身在白云巅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10259,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晚至永安寺迟海涵百","author":"戴亨","text":"竟日历巉岩，耽幽不觉艰。\n远烟归鸟路，清磬夕阳山。\n石磴云霞引，松门铁锁攀。\n主人相失后，徙倚暮崖间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10260,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"再游香山","author":"戴亨","text":"一从游赏后，念此意何殷。\n伏枕梦流水，开窗想白云。\n林峦经再过，烟月会平分。\n几日浓霜下，丹枫落叶纷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10261,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卧佛寺","author":"戴亨","text":"虚空天地外，清冷对金仙。\n已證真三昧，应参不二禅。\n尘劳何所得，登眺忽茫然。\n心契幽香妙，筌蹄欲弃捐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10262,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"再游卧佛寺七首 其一","author":"戴亨","text":"西风吹杖履，来往亦无端。\n山色飞晴翠，钟声过远滩。\n鹤巢双树老，鹿径一僧寒。\n佛卧何时醒，阶前落叶丹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10263,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"再游卧佛寺七首 其二","author":"戴亨","text":"云起从遮簟，风来任落花。\n溪光摇户牖，山色浸袈裟。\n一入希夷境，金消世俗哗。\n忽思遂初服，身卧白云赊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10264,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"再游卧佛寺七首 其三","author":"戴亨","text":"我来寻眺听，慈眼自朦胧。\n顿觉见闻寂，真教色相空。\n虚窗通远翠，高树下秋风。\n心境浑无著，悠然念始终。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10265,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"再游卧佛寺七首 其四","author":"戴亨","text":"云霞随过客，泉石绕香台。\n大块梦谁觉，空王睡不回。\n野花开欲歇，溪鸟去还来。\n静验浮生理，孤亭坐藓苔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10266,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"再游卧佛寺七首 其五","author":"戴亨","text":"大千同一梦，佛卧亦何因。\n恍接无言教，旋多有累身。\n霜蛩鸣晚砌，风箨坠寒筠。\n岂是维摩病，西来大义真。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10267,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"再游卧佛寺七首 其六","author":"戴亨","text":"松窗雕槛外，日日下朝暾。\n一榻空今古，深山冷梦魂。\n云阴侵座湿，鸟语入林昏。\n众衲何多事，经声响暮村。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10268,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"再游卧佛寺七首 其七","author":"戴亨","text":"望佛佛犹卧，还寻旧路回。\n野禽随上下，流水亦潆洄。\n来处云何在，归途日已颓。\n回看深翠里，瞬息隔尘埃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10269,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"自洪光寺至说法亭","author":"戴亨","text":"说法人何在，探奇性颇贪。\n九盘松磴石，双乳石泉甘。\n鸟道随云入，霜林坠叶酣。\n几时深树里，添得一茅庵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10270,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"宦竖张鲸墓","author":"戴亨","text":"岧峣阉竖墓，松柏上云霄。\n凿翠开山穴，淩空跨石桥。\n攀萝寻旧碣，拂藓认前朝。\n惆怅夕阳下，萧萧红叶凋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10271,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过朝阳洞遂登朝阳绝顶 其一","author":"戴亨","text":"洞口朝阳寺，山坳日色曛。\n佛天开鬼斧，石窟护神云。\n偶结林泉侣，高瞻鹳鹤群。\n探奇聊憩息，峰顶望氤氲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10272,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过朝阳洞遂登朝阳绝顶 其二","author":"戴亨","text":"振策猿猱径，身跻翠巘崇。\n涛声惊地轴，人语落天风。\n宇宙收双目，苍茫立太空。\n桑乾东去疾，舟楫海门通。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10273,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"听泉","author":"戴亨","text":"幽涧听泉声，山中约二更。\n野风生竹□，孤月入怀明。\n俗虑一时净，閒心永夜清。\n转愁明发去，尘市若为情。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10274,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"别香山二首 其一","author":"戴亨","text":"已命归途驾，犹看旭日前。\n山容增烂缦，我意倍流连。\n泉石别今日，莺花想隔年。\n再游愁不遂，把酒嘱林泉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10275,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"别香山二首 其二","author":"戴亨","text":"殷勤倾浊酒，与尔结幽情。\n已快连朝赏，还申后日盟。\n白云常在眼，流水莫收声。\n题遍岩间石，君应更著名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10276,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过马氏园林","author":"戴亨","text":"虽未出城市，来兹意己欣。\n小庭初过雨，密竹暗通云。\n鱼鸟咸知乐，嚣喧静不闻。\n暂偷忙里暇，亦觉远尘氛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10277,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"自福建接富氏姊来齐河官署","author":"戴亨","text":"昔别辽河畔，今来济水滨。\n寻常一分袂，二十七年人。\n兄弟尚谁在，存亡各怆神。\n高年思骨肉，庶一慰慈亲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10278,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题画壁和同年子毛秋岑原韵 其一","author":"戴亨","text":"沧海谁仙隐，飘然去不还。\n天容空映水，云气暖蒸山。\n老屋升沈外，扁舟出没间。\n浮家计未遂，心向画图閒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10279,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题画壁和同年子毛秋岑原韵 其二","author":"戴亨","text":"远水浮天地，孤舟日往还。\n到门唯白鸟，举目即青山。\n遥忆风尘际，谁知住此间。\n相期婚宦毕，身入个中閒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10280,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"历下亭怀古","author":"戴亨","text":"历下亭犹古，昔人曾此游。\n我来寻胜迹，霜冷荻芦秋。\n万卷藏书屋，干霄白雪楼。\n徘徊风雅地，山色远含愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10281,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"自雒镇放舟回县","author":"戴亨","text":"归舟耽自在，晚兴觉偏浓。\n渔火惊栖鹭，柴扉闻夜舂。\n烟笼寒渚月，风度远村钟。\n柔橹菰蒲外，前山隔几峰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10282,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"生日书怀","author":"戴亨","text":"寂寞成何事，蹉跎忽至今。\n聪明过壮岁，道德负初心。\n斜日延疏竹，寒花逗晚林。\n昌黎箴自在，读罢一沈吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10283,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"瓶中腊梅","author":"戴亨","text":"不随梅竞白，迎腊吐芳菲。\n于道色唯正，先春气不违。\n暗香闻静夜，幽室发清机。\n意趣忘言说，寒窗对月晖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10284,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雨后省耕过刘氏山庄","author":"戴亨","text":"觇农出东郭，林壑夜初晴。\n春雨既云足，田家各有营。\n窗虚通燕语，花暖聚蜂声。\n民物欣如此，相看慰我情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":10285,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]