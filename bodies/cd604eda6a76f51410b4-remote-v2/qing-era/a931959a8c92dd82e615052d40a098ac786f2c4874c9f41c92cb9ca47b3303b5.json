[{"title":"浣溪沙 艳情二首 其九","author":"王士禄","text":"柳叶眉长惯似愁。\n当欢微敛越风流。\n双文小玉总仙俦。\n梦浅羞郎还闭目，慵多唤婢代梳头。\n此乡真个是温柔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36808,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清商怨 和欧公韵","author":"王士禄","text":"银床梧叶落渐满。\n怅流光欲晚。\n平楚高楼，连朝劳望眼。\n画屏潇湘漫展。\n恨梦破、雁和人远。\n心上秋来，问秋秋不管。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36809,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其一 露筋祠","author":"王士禄","text":"船头暮笛吹寒浪。\n蘋黄芦折怜遥望。\n野岸出空祠。\n灵期飏晚飔。\n无郎歌莫误。\n不是青溪路。\n夜夜对重湖。\n魂归片月孤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36810,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其二 梦破","author":"王士禄","text":"邯郸梦破抽身急。\n掉头怕近长安日。\n便跨白驴归。\n重寻旧钓矶。\n是非书几卷。\n失学从儿懒。\n带索好行歌。\n无劳春梦婆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36811,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 闺晓二首 其三","author":"王士禄","text":"春魂带梦扶难起。\n玉欹翠弱妆慵理。\n不用郁金油。\n鬟云腻欲流。\n一双罗袜瘦。\n小凤娇红咮。\n著罢立盈盈。\n兰阶无限情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36812,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 闺晓二首 其四","author":"王士禄","text":"玉阶浥露缃钩小。\n拗来豆蔻含清晓。\n何处惜芳菲。\n春光绣蝶衣。\n却归妆镜畔。\n伫立成微叹。\n还理乱衾窝。\n怜他伴梦多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36813,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其五 有寄","author":"王士禄","text":"抛侬几尺烟波路。\n断桥难断魂来去。\n何处望全迷。\n西陵更向西。\n欲知情郑重。\n验取宵来梦。\n可耐不成眠。\n乌啼又曙天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36814,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"诉衷情 曾记","author":"王士禄","text":"白云不恋恋温柔。\n曾记卧红楼。\n玉奴笑回莲脸，亲为试箜篌。\n云影散，雨香收。\n漫凝眸。\n几棂淡月，半臂浓香，一寸眉头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36815,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卜算子 其一 不寐","author":"王士禄","text":"暗烛影疑冰，饥鼠声如雀。\n窗隙寒风和漏来，梦又成耽阁。\n归计尚蹉跎，春事全萧索。\n此际殷勤觅睡方，欲下真无药。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36816,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卜算子 其二 送春","author":"王士禄","text":"春欲赋归欤。\n饯汝青门路。\n咄汝能偕愁共来，好拉愁同去。\n春谓君良误。\n愁与君何杵。\n此日幽拘除却愁，谁与君同住。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36817,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"采桑子 其一 有赠","author":"王士禄","text":"宜人最是横波慢，睡态融融。\n红烛微濛。\n杜牧清狂也到侬。\n愁君姓字偏难忘，耳畔东东。\n他日车中。\n怅绝轮边断续风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36818,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"采桑子 其二 春闺","author":"王士禄","text":"流苏不闭三春梦，宛转梨云。\n一霎氤氲。\n洛水湘波在宋邻。\n醒来无事消长昼，卧损秾春。\n莫问芳辰。\n春絮春花惯恼人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36819,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其一 羁所七忆","author":"王士禄","text":"竹西清署。\n昨岁称觞曾暂去。\n慈母缝衣。\n又逐寒枫草草归。\n湘累新愁。\n二老遥闻魂应断。\n念此如何。\n梦溯清淮夜夜波。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36820,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其二 羁所七忆","author":"王士禄","text":"早年似陆。\n夜夜书灯还接屋。\n中岁如苏。\n雨驿梧声怨索居。\n只期暮齿。\n下泽同驱吾共尔。\n谁意而今。\n洒泪题诗寄卯君。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36821,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其三 羁所七忆","author":"王士禄","text":"谢家小女。\n少日红闺深处贮。\n嫁与黔娄。\n画匠金钗廿载愁。\n甘同终窭。\n未忘牛衣中夜语。\n只为梭巡。\n偕隐心惭举案人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36822,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其四 羁所七忆","author":"王士禄","text":"桃花靧雪。\n掌里双珠光似月。\n几载身傍。\n次第鸠车看绕床。\n堪怜弱岁。\n饘橐崎岖为汝累。\n莫事诗书。\n殷鉴于今近在余。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36823,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其五 羁所七忆","author":"王士禄","text":"谁云弄瓦。\n绣褓相怜无异者。\n弱女非男。\n也与陶公慰醉颜。\n还思卖犬。\n笥屐他年亲嫁遣。\n此意悠悠。\n面壁娇啼我欲愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36824,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其六 羁所七忆","author":"王士禄","text":"紫囊曾赌。\n早日阶兰欣在睹。\n昨岁于菟。\n乍见牵衣更捋须。\n经时离别。\n频梦芜城耏水月。\n羯末封胡。\n此日幽忧倍忆渠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36825,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其七 羁所七忆","author":"王士禄","text":"单车宵引。\n铁网珊瑚思采尽。\n深院梧桐。\n红烛三条见至公。\n玉壶秋月。\n人道欧公清鉴别。\n我罪伊何。\n默默凭谁讯汨罗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36826,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其八 寄内","author":"王士禄","text":"还知别后。\n人工炉烟宛转瘦。\n灯底风前。\n憔悴苕华只自怜。\n凭谁寄语。\n莫为藁砧徒自苦。\n有日归兮。\n携手同君赋五噫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36827,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"后庭花 咏燕","author":"王士禄","text":"浥尘小雨清明近。\n几番花信。\n重来玉剪双双趁。\n玳梁堪认。\n故巢新补芹泥润。\n落红相衬。\n流黄机畔人回瞬。\n陡添娇晕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36828,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"好事近 忆柳庵旧隐，次放翁韵","author":"王士禄","text":"回首碧山栖，四面远天为壁。\n窗启俯临层巘，看偃松苍积。\n花关长昼不曾开，猿鸟共休息。\n卓午聒回幽梦，是衙蜂喧日。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36829,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒金门 和冯延巳韵","author":"王士禄","text":"晨睡起。\n倦眼微瞤秋水。\n且散娇慵春径里。\n露桃开几蕊。\n亸态风前如倚。\n扑乱杨花斜坠。\n正忆桐庐人未至。\n蛛丝轻送喜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36830,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒金门 和尤悔庵寒夜韵","author":"王士禄","text":"深宵寂。\n暗烛晕成愁色。\n小婢开帘寒侧侧。\n梅花明夜黑。\n雪片风边瑟瑟。\n带个雁声凄历。\n孤枕愁听莲漏滴。\n枕痕朝看湿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36831,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"金蕉叶 咏雁，用蒋竹山秋夜不寐韵。","author":"王士禄","text":"晴空淡幕。\n远飞来、互鸣似索。\n鱼鳞云影断续，斜河正络角。\n几个疏星作作。\n井梧飘、酒怀乍恶。\n楚天秋水浩渺，寒沙几处落。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36832,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆秦娥 次少游韵","author":"王士禄","text":"秋眉碧。\n月明几夜流黄织。\n流黄织。\n谁家阑角，乍飘风笛。\n锦机羞镊鹣鹣翼。\n远书漫说长相忆。\n长相忆。\n玉笼愁绝，相思声只。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36833,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"眼儿媚 和徐野君赠人韵","author":"王士禄","text":"个侬名字似东东。\n记曲又红红。\n眉月幽幽，鬟烟约约，肤雪濛濛。\n缥缈风情看不定，几处认巫峰。\n帘底樽前，花边竹外，掌上图中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36834,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 其一 湖上有赠","author":"王士禄","text":"泪眼非如潮有信。\n话到离愁便晕。\n此际看尤俊。\n横波那为多啼损。\n家住西泠还较近。\n苏小同心试问。\n莫忘相思分。\n却教油壁全无准。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36835,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 有寄二首 其二","author":"王士禄","text":"共子真同魂与魄。\n不道轻轻便坼。\n无奈离魂急。\n独留残魄谁相匹。\n检点屏帷寻旧迹。\n印臂钗痕未失。\n立尽窗儿黑。\n愁来那辨阡和陌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36836,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 有寄二首 其三","author":"王士禄","text":"忆得相逢春欲暮。\n油壁西陵乍度。\n缥缈花和雾。\n风流欲压陈王赋。\n卖眼灯前回一顾。\n脉脉幽情早付。\n好月当窗处。\n背人却把心期诉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36837,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南歌子 其一 鸦鬟","author":"王士禄","text":"箫局晨香袅，流苏晓梦还。\n十三小女绿鸦鬟。\n情似十三明月，未全圆。\n花影红屏午，春光碧户传。\n抱来雁柱十三弦。\n已觉一弦一柱，思华年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36838,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南歌子 其二 次湘真春月韵","author":"王士禄","text":"琼树濛濛映，红窗漫漫流。\n雪儿好为唱无愁。\n休负一规亲切，照藏钩。\n珠露从教湿，金樽莫遣收。\n余光潋滟小眉头。\n不似清秋楚楚，咽箫楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36839,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浪淘沙 其一 次李后主韵","author":"王士禄","text":"愁似水潺潺。\n百意阑珊。\n几棂风做晚来寒。\n倩酒浇愁愁不顾，醉也无欢。\n岸帻倚疏栏。\n愧负青山。\n试歌行路古来难。\n何似随僧闲洗钵，溪畔松间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36840,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浪淘沙 其二 次宋尚木忆昔韵","author":"王士禄","text":"绣幕晚来重。\n怪底香浓。\n丁香如梦月胧胧。\n红烛殢人耽笑语，过了疏钟。\n倦眼玩酥胸。\n脂肉芙蓉。\n娇羞银蒜罥青虫。\n往事临风休更忆，吹乱心蓬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36841,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 其一 初夏忆草堂，次曹顾庵初夏韵","author":"王士禄","text":"游屐息春忙。\n著雨幽墀似曲塘。\n砌外三桐层碧引，过墙。\n接叶愔愔覆草堂。\n摇日夕窗凉。\n破梦棋声静曲房。\n入夜流萤依竹见，还藏。\n簟展方流玉水长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36842,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 其二 午日","author":"王士禄","text":"愁剧意模糊。\n粽子还能益智无。\n且碾朱砂浮药玉，胡卢。\n图得闲愁半日逋。\n醉里惜幽拘。\n吟罢怀沙日又徂。\n记得弇州诗句好，非诬。\n信有人间屈左徒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36843,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"木兰花令 其一 茫茫","author":"王士禄","text":"茫茫交集情谁织。\n谓驱愁去愁仍蛰。\n放来屈赋就怀沙，腐后迁书传货殖。\n诗书赢得妻孥泣。\n孺仲妻贤真莫及。\n蓬头历齿任痴儿，有目何烦知六七。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36844,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"木兰花令 其二 遣愁","author":"王士禄","text":"三春日日和愁住。\n愁汝来前与汝语。\n连朝愧汝太殷勤，我醉欲眠君且去。\n麾之不去愁良误。\n心已厌君君好喻。\n不然便觅一丸泥，封却汝愁来往路。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36845,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹊桥仙 醉罢","author":"王士禄","text":"只须冷笑，无烦细说，世事尽多鹘突。\n楚囚莫更泣南冠，教达者、嗤人录录。\n且酣醇酒，试弹长剑，醉罢一歌独漉。\n庄生齐物有遗篇，说千古、觞延彭促。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36846,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"踏莎行 用少游韵","author":"王士禄","text":"瑞脑烘猊，素筝排雁。\n绿窗深处新妆淡。\n娇春偏觉眼波慵，宜人更是心情慢。\n佩响微风，琴鸣幽涧。\n还疑天女将花散。\n春光秾日惜分携，碧城缥缈愁无限。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36847,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"临江仙 忆东堂花树","author":"王士禄","text":"最惜东堂花树好，几枝掩雪骄霞。\n春宵胜引酒情赊。\n共倾银凿落，细玩玉夭斜。\n群季惠连真不让，新诗同竞妍华。\n十年踪迹似风花。\n赤栏楼角月，应解忆天涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36848,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花 其一 次韵少游二乔观书图","author":"王士禄","text":"倾鬓颓云肩亸玉。\n髹几光凝，双映修蛾绿。\n仿佛风光屏外足。\n摊书停却寻春躅。\n炉里双烟青断续。\n玉砌红帘，不似牵萝屋。\n公瑾伯符皆不俗。\n知无一事萦心曲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36849,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花 其二 和汉川卢令女题泥溪驿韵","author":"王士禄","text":"翠幰红帘晴少翳。\n花驿风香，渐觉秾春至。\n漫道鹃声堪坠泪。\n木棉红照人颜腻。\n江路盘回山路细。\n谢女吟成，旅思清如水。\n彤管自怜多画意。\n幽修分得浮岚翠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36850,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花 其三 咏萤","author":"王士禄","text":"雨后桐阴清似沐。\n苔色盈阶，淡月明于玉。\n此际流萤飞簌簌。\n穿廊黏砌纷空曲。\n才堕花梢还入竹。\n欲下仍高，偏旁池边屋。\n巧入风帘轻扑扑。\n幽光凉映须眉绿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36851,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渔家傲 其一 赵北口作","author":"王士禄","text":"渔屋低低茅作瓦。\n几湾碧柳真潇洒。\n此地风尘原不惹。\n渔父者。\n于中结个持竿社。\n乐事常年殊未寡。\n扁舟不系随波写。\n濯足舷边刚没髁。\n言不假。\n垂鞭笑煞先生马。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36852,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渔家傲 其二 用王介甫韵","author":"王士禄","text":"湖岸渔村周似抱。\n家家门径开芳草。\n向背渔罾殊窈窕。\n凌晓到。\n晴矶已有垂杨扫。\n坐看点头行水鸟。\n近家何用收纶早。\n两桨一舟堪送老。\n波面好。\n宽闲不与欧争道。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36853,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"金蕉叶 昔游","author":"王士禄","text":"昔游记向西陵去。\n回油壁、个人曾遇。\n一笑灯前，春心暗掷幽情注。\n顿使情愁如滤。\n柳枝带结同心屡。\n尚惆怅、乌啼窗曙。\n可堪别后，云中无复来香雨。\n忍看玉炉双炷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36854,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"解佩令 酒怀","author":"王士禄","text":"淡妆轻裹。\n柳慵花堕。\n畅幽情、鸱夷仙舸。\n茉莉风凉，泊向段家桥左。\n悄窥人、月痕星颗。\n别来无那。\n魂销梦夥。\n寄离愁、雁儿难逻。\n烛烬宵深，独有单衾同我。\n问何时、酒怀能妥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36855,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"风中柳 山志","author":"王士禄","text":"何日山中，真结三间茅屋。\n更周遭、千章山槲。\n客稀睡足。\n人幽影独。\n映虚窗、晚峰添绿。\n抱膝无营，并绝周妻何肉。\n有春畦、芹香堪斀。\n松声谡谡。\n溪声续续。\n问从游、白鸥苍鹿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36856,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"品令 寓亭竹","author":"王士禄","text":"砌外一林竹。\n爱萧散、供幽独。\n闲窗拂戛，昼长卧听，音和笙筑。\n雨重风轻，姿韵看来难足。\n露晞烟晓，受初日、开寒绿。\n夜深还又，月浮乱碧，宛然空谷。\n那得湖州，图取变态千幅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36857,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"淡黄柳 新柳","author":"王士禄","text":"阳春三月。\n袅袅东风急。\n陌上桥头吹不息。\n渲得短丝成碧。\n看嬉春黄鹂恰恰。\n怜娇色。\n晓日红楼辟。\n似有个、盈盈立。\n敛修蛾、且罢流黄织。\n灞岸条垂，玉关梦杳，袖向晴光暗湿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36858,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"行香子 别恨","author":"王士禄","text":"别恨曾谙，往事重拈。\n记临歧、暮色红帘。\n牵衣回抱，细语喃喃。\n见眉痕重，泪痕滴，酒痕咸。\n峡云归后，雨来空识，只宵阑、梦断魂黏。\n孤眠无赖，回忆何堪。\n是炉香歇，发香腻，被香甘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36859,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"锦缠道 用宋子京韵","author":"王士禄","text":"落拓心情，寂寂难销长昼。\n看罗巾、合欢双绣。\n殷红知是啼痕透。\n梦里蘅芜，往事空回首。\n记楼头细语，暗萦纤手。\n态盈盈、脸红宜酒。\n怅萍踪雨落青天信，芳心一寸，恩怨应双有。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36860,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"青玉案 用贺方回韵","author":"王士禄","text":"清宵盼盼银河路。\n只惆怅、华年去。\n密约芳期经几度。\n红弦翠管，风帘月簟，并与人何处。\n别时夏杪春还暮。\n燕燕莺莺漫成句。\n旧事萦心还几许。\n微酣曾访，短篷相遇，荷叶西陵雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36861,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"附贺铸青玉案","author":"王士禄","text":"凌波不过横塘路，但目送，芳尘去。\n锦瑟华年谁与度？\n月桥花院，琐窗朱户，只有春知处。\n飞云冉冉蘅皋暮，彩笔新题断肠句。\n试问闲愁都几许？\n一川烟草，满城风絮，梅子黄时雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36862,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"两同心 和韵宗梅岑咏鸳鸯","author":"王士禄","text":"沙畔文禽，双双锦羽。\n依绿萍、妥梦芳洲，唼红杜、寻欢遥浦。\n那还羡、紫燕交飞，青鸾偕舞。\n冷觑绣床娇女。\n抛残针镂。\n散娇慵、水槛闲凭，照宛约、玉台空妩。\n晚归去、凝视红衾，黯然无语。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36863,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"天仙子 其一 和湘真春夜韵","author":"王士禄","text":"淡淡双眉萦远岫。\n草草凉襟还小袖。\n曲廊深处为侬来，随夜漏。\n乌栖后。\n枕臂啼痕红欲透。\n抚抱纤腰春更瘦。\n凝怨横波娇不溜。\n如思如懊转宜人，看巾绣。\n嗔相扣。\n痛惜肯教衾浪皱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36864,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"天仙子 其二 用张子野韵","author":"王士禄","text":"河满不堪临别听。\n别酒醉来容易醒。\n持侬只问几时来，频揽镜。\n怜光景。\n此意料君能暗省。\n离绪最愁窗色暝。\n明月又还窥只影。\n空房应是怯孤眠，风欲定。\n钟初静。\n踏遍合欢廊下径。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36865,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江城子 用少游韵","author":"王士禄","text":"游春梦好殢元郎。\n恼侬狂。\n昵侬狂。\n燕子莺儿，底事送春忙。\n花露未晞云影散，痕在臂，泪沾裳。\n锦屏仿佛剩春光。\n枕馀香。\n簟馀香。\n髹几文奁，无复映晨妆。\n小叠红笺书恨字，凭谁寄，向伊行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36866,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"千秋岁 其一 和少游韵","author":"王士禄","text":"花间叶外。\n又见蜂黄退。\n阶影慢，帘阴碎。\n合欢金缕枕，双绶红鸳带。\n人去也，银灯晕里羞相对。\n尚记横塘会。\n荷叶青如盖。\n纵已杳，魂犹在。\n凤奁香欲殄，蝉鬓云将改。\n无奈是，愁心一寸深于海。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36867,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"千秋岁 其二 题霜哺图为袁重其寿母","author":"王士禄","text":"袁生把臂。\n珍重频相谓。\n从少日，依堂背。\n丸熊良已苦，坩鱃谁曾馈。\n图反哺，清霜几下慈乌泪。\n太息钦君意。\n菽水君何愧。\n门子洁，风人贵。\n母持灵寿杖，儿作斑衣戏。\n歌一阕，为君侑祝千秋岁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36868,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"千秋岁 其三 为吴尔世寿母","author":"王士禄","text":"君家称寿。\n海内文章走。\n夸盛事，纷人口。\n颇闻黄发媪，早作青灯妇。\n冰雪里，藐孤涕泪曾相守。\n剃剪陶家久。\n台筑怀清旧。\n兼两事，须推母。\n春晖君解报，善颂吾何有。\n唯愿取，新安江水成春酒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36869,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]