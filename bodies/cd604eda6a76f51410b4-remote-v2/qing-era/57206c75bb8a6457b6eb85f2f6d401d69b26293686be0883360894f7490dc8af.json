hor":"朱仕玠","text":"诸番镇日射伊尼，竹箭藤弓每自随。\n仆谷颠坑宁敢悔，祇缘辛苦觅胎皮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1325,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尸位学署岑寂无聊泛泛随流迹近渔父每有闻见辄宣讴咏因名瀛涯渔唱 其七十八","author":"朱仕玠","text":"解箨声清迥不凡，欲参玉版践巉岩。\n千头觳觫穿林出，味苦难禁太守馋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1326,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尸位学署岑寂无聊泛泛随流迹近渔父每有闻见辄宣讴咏因名瀛涯渔唱 其七十九","author":"朱仕玠","text":"迎风灼灼照窗楹，潘县翻同渭亩名。\n谁料此君遽如许，何殊靖节赋闲情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1327,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尸位学署岑寂无聊泛泛随流迹近渔父每有闻见辄宣讴咏因名瀛涯渔唱 其八十","author":"朱仕玠","text":"新鹂几日啭高枝，碧蔓纠缠绕架垂。\n细雨斜风寒食过，四英含蕊正离离。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1328,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尸位学署岑寂无聊泛泛随流迹近渔父每有闻见辄宣讴咏因名瀛涯渔唱 其八十一","author":"朱仕玠","text":"翠盖团团小叶青，万花攒蔟弄芳馨。\n炎州不识冰霜厉，看取盆开泼雪形。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1329,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尸位学署岑寂无聊泛泛随流迹近渔父每有闻见辄宣讴咏因名瀛涯渔唱 其八十二","author":"朱仕玠","text":"漫称膏壤事耕深，再熟田畴力不任。\n惟有东西二港地，小春时节出秧针。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1330,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尸位学署岑寂无聊泛泛随流迹近渔父每有闻见辄宣讴咏因名瀛涯渔唱 其八十三","author":"朱仕玠","text":"熟番形貌肖猿猱，渐制衣裾慕胜流。\n但羡唐山无限好，安知文物萃神州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1331,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尸位学署岑寂无聊泛泛随流迹近渔父每有闻见辄宣讴咏因名瀛涯渔唱 其八十四","author":"朱仕玠","text":"青州从事出遐方，照座浑如琥珀光。\n珍重数杯啊啂酒，颓然成醉遇周郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1332,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尸位学署岑寂无聊泛泛随流迹近渔父每有闻见辄宣讴咏因名瀛涯渔唱 其八十五","author":"朱仕玠","text":"未堪皇树斗声华，磊落前庭亦复嘉。\n坐进一盘柑子蜜，何输七碗玉川茶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1333,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尸位学署岑寂无聊泛泛随流迹近渔父每有闻见辄宣讴咏因名瀛涯渔唱 其八十六","author":"朱仕玠","text":"栩栩浑如蛱蝶轻，仙人手植号金茎。\n任教拗取盈头插，未必蓬壶便列名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1334,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尸位学署岑寂无聊泛泛随流迹近渔父每有闻见辄宣讴咏因名瀛涯渔唱 其八十七","author":"朱仕玠","text":"仄行郭索出沧漘，丑劣形殊镇骇人。\n料得中书应罢食，将糖免使议门人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1335,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尸位学署岑寂无聊泛泛随流迹近渔父每有闻见辄宣讴咏因名瀛涯渔唱 其八十八","author":"朱仕玠","text":"彷佛沧溟见玉人，合茹珍重口生春。\n谁云分体吴宫里，不及江妃罗袜尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1336,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尸位学署岑寂无聊泛泛随流迹近渔父每有闻见辄宣讴咏因名瀛涯渔唱 其八十九","author":"朱仕玠","text":"弱羽缡褷似不禁，时人却号九皋禽。\n祇缘举目无空阔，共此云霄一片心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1337,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尸位学署岑寂无聊泛泛随流迹近渔父每有闻见辄宣讴咏因名瀛涯渔唱 其九十","author":"朱仕玠","text":"轻缯作裤白罗襦，那识家仍担石无。\n明烛华灯喧夜半，分曹到处快呼卢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1338,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尸位学署岑寂无聊泛泛随流迹近渔父每有闻见辄宣讴咏因名瀛涯渔唱 其九十一","author":"朱仕玠","text":"寒暑乖违物候偏，蛮花随意烂瀛壖。\n独馀一事艰推测，不见蜂狂蝶放颠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1339,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尸位学署岑寂无聊泛泛随流迹近渔父每有闻见辄宣讴咏因名瀛涯渔唱 其九十二","author":"朱仕玠","text":"九瓣香从内地分，恰宜对酒吐氤氲。\n微官飘泊东溟远，那得传柑馈细君。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1340,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尸位学署岑寂无聊泛泛随流迹近渔父每有闻见辄宣讴咏因名瀛涯渔唱 其九十三","author":"朱仕玠","text":"谁把琼瑶万朵装，未堪蹴鞠筑球场。\n挥毫难写垂藤态，只合丹青付赵昌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1341,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尸位学署岑寂无聊泛泛随流迹近渔父每有闻见辄宣讴咏因名瀛涯渔唱 其九十四","author":"朱仕玠","text":"淡白轻红逐队分，安知蚕织事辛勤。\n倦抛绣线无馀事，快嚼槟榔胜酒醺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1342,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尸位学署岑寂无聊泛泛随流迹近渔父每有闻见辄宣讴咏因名瀛涯渔唱 其九十五","author":"朱仕玠","text":"常时微步踏莓苔，北舍南邻镇往回。\n水麝薰传罗袖阔，非关寒食踏青来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1343,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尸位学署岑寂无聊泛泛随流迹近渔父每有闻见辄宣讴咏因名瀛涯渔唱 其九十六","author":"朱仕玠","text":"甘蕉舒绿蔼如云，花放惟应配茜裙。\n何事偏蒙君子号，固宜修竹出弹文。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1344,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尸位学署岑寂无聊泛泛随流迹近渔父每有闻见辄宣讴咏因名瀛涯渔唱 其九十七","author":"朱仕玠","text":"好是风和景物妍，野花盘髻胜金钿。\n乍闻笑语来天半，番女轻盈戏渺绵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1345,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尸位学署岑寂无聊泛泛随流迹近渔父每有闻见辄宣讴咏因名瀛涯渔唱 其九十八","author":"朱仕玠","text":"南至阳生气尽苏，恨无飞雪点红炉。\n团圞坐饮称添岁，一幅升平外海图。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1346,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尸位学署岑寂无聊泛泛随流迹近渔父每有闻见辄宣讴咏因名瀛涯渔唱 其九十九","author":"朱仕玠","text":"黉舍周遭任卓锥，庾郎鲑菜镇相宜。\n东西压架颁书遍，顷刻家成十万赀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1347,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尸位学署岑寂无聊泛泛随流迹近渔父每有闻见辄宣讴咏因名瀛涯渔唱 其一○○","author":"朱仕玠","text":"生涯任运自蘧蘧，踪迹应如海上渔。\n安得广张六百钓，从教举国饱鲸鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1348,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"孙武水索题渡海图鹿鹿久未报适将有台湾之行即书以赠行","author":"朱圭","text":"天枢欹贯水转空，神州一撮裨海东。\n踏土食火吸海马，不惯高浪连天舂。\n君家苕霅美清泚，伯仲自比衡与龙。\n奇书已搜洞庭穴，椽笔欲赋冯夷宫。\n崇明小屿昔放棹，叱吒蛟蜃鞭鸿蒙。\n一朝渡岭到瓯粤，九夏吟苦来商风。\n蓬莱金阙在何所，嗟君岂复长固穷。\n天阊凌竞不可羾，掉头径去登鸡笼。\n厦门鹿耳屹双堑，六十四岛澎湖中。\n帆开照空神火碧，夜半烧海扶桑红。\n此行壮哉足记览，莫放险语惊龙公。\n迟君归装更千帙，满缀明月光瞳胧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1349,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"评何斌献地图予郑成功","author":"江日升","text":"谁料为将尽，翻然一著奇。\n深藏出意外，昼夜使人疑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1350,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"吊监国夫人诗四绝 其一","author":"江日升","text":"欲问天高天不知，千声血泪暗中垂。\n人间无意心灰甚，明月当空照冷闺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1351,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"吊监国夫人诗四绝 其二","author":"江日升","text":"一盏明灯一帖明，傍缠灯影复相连。\n三朝茶饭尽人事，七尺梁间订后缘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1352,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"吊监国夫人诗四绝 其三","author":"江日升","text":"虽然日月有时缺，难算今朝意外愆。\n自计此身无顿处，甘从地下结良缘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1353,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"吊监国夫人诗四绝 其四","author":"江日升","text":"纵有百年亦是死，何如七尺完吾生。\n此生了却人间愿，南郭楼台北郭茔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1354,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"舟次澎湖偶成一律","author":"江日升","text":"烟霞荡漾渔人处，已作霸图保障关。\n退守聚成雄海国，进窥衅隙动华山。\n百千万士咸空壮，三十六峰险亦闲。\n南顾将军诚有赖，德流教化迨荒蛮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1355,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"评台湾收入版图永为海外文物富饶之邦","author":"江日升","text":"新辟天南海外方，人民安堵不须忙。\n雨顺风调升平福，一统山河帝祚长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1356,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏沈瑞夫人不从父母归宁命","author":"江日升","text":"南北姻缘岂偶成，死生今日别离情。\n不从父母归宁赋，愿赋终天一路行。\n守一曾闻保母言，不因生死离侯门。\n黄泉旅次暂相彼，公案共完礼至尊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1357,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋日谒延平郡王祠 其一","author":"何如谨","text":"海外孤忠泣鬼神，丹心为国竟忘身。\n大星遽陨年难假，天意偏摧社稷臣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1358,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋日谒延平郡王祠 其二","author":"何如谨","text":"铮铮骨气压群雄，传炮羊山斗老龙。\n宿志未偿嗟毁墓，至今人说海澄公。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1359,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋日谒延平郡王祠 其三","author":"何如谨","text":"三百年来养士优，陆沈蓟北感神州。\n传家忠孝原无恨，生子还须胜仲谋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1360,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋日谒延平郡王祠 其四","author":"何如谨","text":"投戈旧部久寒盟，痛哭神州一旦倾。\n两岛甲兵逾十万，固应雄略胜田横。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1361,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋日谒延平郡王祠 其五","author":"何如谨","text":"开辟鸿濛望中兴，海波士气共奔腾。\n挥戈未遂回天力，空向金陵拜孝陵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1362,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"试士","author":"何如谨","text":"相期同上凤池班，文字丹黄手自删。\n却笑蓬庐非广厦，也教寒士尽欢颜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1363,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"试士","author":"何如谨","text":"万事等云过，人生对酒歌。\n枕戈增慷慨，投笔悔蹉跎。\n有感情难已，无端唤奈何。\n此身留报国，未许老烟蓑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1364,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杂感","author":"何承道","text":"何人开府海南偏，鹿耳秋潮画角悬。\n雄镇自堪威绝徼，大臣自古制中权。\n青冥片月鸡笼塞，白发孤藩马革年。\n旧是武皇开辟地，此行急为策安边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1365,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题前阿仙堂","author":"何借宜","text":"海岛由来是驾鳌，幽阿隐隐结蟠桃。\n风过竹树鸾笙远，云挂茅檐鹤驭高。\n星聚一堂扶世运，文司百代萃仙曹。\n丹成九转千年事，此日閒游兴自豪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1366,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"恭和御赐杨制府诗原韵有序 其一","author":"余文仪","text":"翠华重幸日，瑞气霭龙牙。\n元老频承宠，宸章特赐嘉。\n调和归静穆，暑雨绝咨嗟。\n共仰明良会，唐虞岂有加。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1367,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"恭和御赐杨制府诗原韵有序 其二","author":"余文仪","text":"一字同华衮，天香遍齿牙。\n光辉悬日月，矍铄入褒嘉。\n边海安持重，经纶但咄嗟。\n愿言崇令德，君赐看重加。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1368,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"恭和御赐杨制府诗原韵有序 其三","author":"余文仪","text":"东南形胜地，城阙似排牙。\n德遍久无斁，恩承新孔嘉。\n秀登甲乙选，野静癸庚嗟。\n遥识吾王豫，畴咨无可加。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1369,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"恭和御赐杨制府诗原韵有序 其四","author":"余文仪","text":"赓歌千古盛，巴里愧聱牙。\n共喜鲸波伏，难忘棠荫嘉。\n空持观水术，不觉望洋嗟。\n击壤聊同调，殊恩分外加。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1370,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台阳八景","author":"余文仪","text":"风撼长竿捲大旗，安平渡口夕阳时。\n参差帆影轻鸥泛，砰湃涛声铁马驰。\n收网渔郎还隐隐，招人舟子故迟迟。\n醉翁矫首筹同济，灯火连村尽系思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1371,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台阳八景","author":"余文仪","text":"涌浪声声似鼓鼙，将军从此殄鲲鲵。\n清笳落日归渔笛，战垒寒烟冷钓堤。\n但觉星光齐上下，不分燐火遍东西。\n太平岁久销沉尽，折戟何须问水犀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1372,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台阳八景","author":"余文仪","text":"鹿耳门雄万里城，暗沙沉铁鲸鲵惊。\n春风春雨波能立，潮落潮生气未平。\n骇浪周遭天设险，飞帆屈曲地中行。\n从来利涉凭忠信，笑指群鸥久定盟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1373,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台阳八景","author":"余文仪","text":"十年作郡白盈头，雪爱炎方为淹留。\n遥对玉山成二老，消归银海作清流。\n众峰远列看雌伏，鸣瀑齐声报晓筹。\n应是碧鸡曾羽化，樊龙犹得傍瀛洲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1374,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]