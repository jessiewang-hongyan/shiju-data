[{"title":"秋日","author":"曹素侯","text":"梧桐一叶早惊秋，鹤梦留人尘梦收。\n情逐绮云飘玉宇，心随碧落荡银钩。\n浪游清院难消日，偷上层楼未敢愁。\n空忆旧时衣带缓，不胜遥夜泪重流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29469,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自题画兰","author":"岳莲","text":"十分珍重护芳丛，意在忘言淡荡中。\n尘外天然见标格，肯随桃李嫁春风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29470,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宫词 其一","author":"静照","text":"到面东风只自知，燕花牌子手中持。\n椒房领得金龙纸，敕写先皇御制诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29471,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宫词 其二","author":"静照","text":"一树寒花冒雪开，幽香寂寂映妆台。\n女官争簇传呼近，知是鸾宫选侍来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29472,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宫词 其三","author":"静照","text":"宝妆云髻亸金衣，娇小丰姿傍玉扉。\n新入未谙宫禁事，低头先拜段纯妃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29473,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宫词 其四","author":"静照","text":"只敕宣传幸玉熙，乐工先候九龙池。\n装成傀儡新番戏，尽日开帘看水嬉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29474,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宫词 其五","author":"静照","text":"阅遍司农水旱书，君王减膳复斋居。\n御厨阿监新承旨，来日羹汤不进鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29475,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宫词 其六","author":"静照","text":"俭德慈恩上古稀，他方织锦尽停机。\n赭黄御服重经浣，内直才人著布衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29476,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"禅坐书怀","author":"道元","text":"碧云静锁梵王宫，犹似明霞拱禁中。\n玉树旧枝归净业，内家新调擅宗风。\n三千里外肠堪折，十二年前泪暗红。\n欲悟无生何处是，禅镫移照镜台空。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29477,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"早春即事","author":"再生","text":"烟锁虚窗展素缃，微风吹到落梅香。\n孤怀待月惟枯坐，馀恨添眉却晚妆。\n旧事不堪重省忆，新词漫自费平章。\n黄粱一梦从今觉，愿息尘机礼法王。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29478,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"不寐","author":"再生","text":"残镫一点爇孤檠，门外萧萧落木声。\n风动庭梅疏影乱，露凝修竹暮寒轻。\n支离瘦骨惟供病，牢落愁怀岂为情。\n此夜酒醒魂断处，半帘明月梦无成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29479,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"仲春十五夜大人山中言旋即别写怀","author":"再生","text":"白云天末和愁低，无限离怀怨曙鸡。\n烟柳河桥残月少，疏钟古寺晓风凄。\n百年幻影花枝老，二十浮生草路迷。\n一苇江头如可折，竺乾西去待相携。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29480,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寒夜书怀","author":"再生","text":"寂寞青镫夜未阑，半生心事独盘桓。\n烟波缥缈魂非远，人事悲凉岁欲残。\n素志应同明月皎，离情还共白云漫。\n良宵剪烛歌行露，松竹萧森起暮寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29481,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"同洵芳航海作","author":"来季奴","text":"浊浪翻天地，微躯付海风。\n恨他精卫鸟，衔石竟无功。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29482,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"书怀","author":"无垢","text":"青翠入帘栊，永日驻幽阁。\n愁萦芳草生，静觉桐花落。\n奁镜网蟏蛸，庭柯巢鸟鹊。\n梦去不关愁，晓来心自恶。\n独坐只书空，微雨益萧索。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29483,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雪后登山","author":"无垢","text":"滕君似妒青山翠，万里峰峦铺玉碎。\n苍凉四望野云低，江天静与茅亭对。\n此时谁是景中人，王恭鹤氅难为绘。\n我爱江天积雪幽，朗吟《雪赋》寄中流。\n长江寂寞鱼龙没，坐向孤寒月影浮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29484,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"扬州早雁","author":"无垢","text":"才离塞北忽江东，岭岸萧疏树未红。\n数点云间谁系帛，一行天外自书空。\n安栖邗水犹乡土，远过迷楼感故宫。\n别有孤鸣沈别浦，高风欲借起泥中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29485,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋柳","author":"无垢","text":"弱不禁风素自怜，黄昏细雨断疏烟。\n楼头指冷谁吹笛，塞上身单欲寄绵。\n一任啼乌翻子夜，直须飞雪送穷年。\n攀枝信堕英雄泪，残照萧条灞水边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29486,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"悼小婢素梅 其一","author":"无垢","text":"年只十龄馀，幽花色亦如。\n怜伊明慧甚，独遣理琴书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29487,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"悼小婢素梅 其二","author":"无垢","text":"以疾性逾洁，时时拂卧床。\n犹然觅芳卉，斜插髻云旁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29488,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"悼小婢素梅 其三","author":"无垢","text":"每识予悲叹，温言慰寂寥。\n深期共朝暮，何事彩云飘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29489,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玩月","author":"无垢","text":"秋气晚馀寒，清光万里宽。\n天风如可惜，吾意欲乘鸾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29490,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春闺","author":"无垢","text":"院冷梅花玉剪流，晚风偏助落花愁。\n侍儿知我无情绪，不把珠帘上玉钩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29491,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丁未仲冬携钵渡江喜过深翠山房巢民先生出小影索题赋赠","author":"法鉴","text":"人龙文虎玉精神，写出当年抱膝身。\n李郭久知天下士，卫荀重见六朝人。\n花藏僻巷车常满，竹引仙斋鹤自亲。\n最爱白云无世态，我来亦为一通津。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29492,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"泣怀四言诗","author":"德容","text":"魏里我朱，世称名德。\n父举孝廉，仪型南国。\n先慈割股，善为内则。\n八兄二弟，甲科连捷。\n犹子繁衍，勤书晨夕。\n父半百年，始生又贞。\n弱女非男，训护慰情。\n稍读经史，志古闺英。\n十五而笄，清河于归。\n十五遵教，姑嫜是随。\n操持佐馈，夙夜无违。\n熊罴三梦，今始一垂。\n绿林不靖，湖渚锋镝。\n囊为盗赍，牛衣相泣。\n良人砥志，下帷屏迹。\n瑶章珠赋，声动都邑。\n戊子之秋，幸宴《鹿鸣》。\n长歌远寄，郑重前盟。\n壬辰登第，筮仕廷评。\n继美释之，张先后称。\n丁酉维夏，泛舟来都。\n相敬未暖，旅魂乍苏。\n忽令分闱，校检群儒。\n维我夫子，能文有耻。\n秉矢公明，冰寒立志。\n上严功令，下畏多士。\n勤慎勿懈，月馀竣事。\n岂知同寀，贪心败类。\n庸违象恭，实怀狂悖。\n群凶飞语，如霾如彗。\n缇骑在门，去不及诀。\n五毒倍至，百喙莫雪。\n事若风影，罪不例律。\n严行示惩，西市引决。\n祸起党同，古今一辙。\n余念致命，割血流裾。\n九阍间隔，囚安上书。\n七人同尽，遑辩真虚。\n家产寥寥，鸡犬尽没。\n桑榆老亲，亦旦暮活。\n相逐边塞，念此神夺。\n求荣反辱，遂付剃发。\n绣衣永诀，袈裟相接。\n拔幽报存，叩金经力。\n嗟乎薄命，家乡万里。\n身独羁囚，饥寒泣涕。\n南望白云，泪零待徙。\n不如鸟雀，去来迤逦。\n我思刑书，国之钺斧。\n虚实按情，轻重有故。\n雷霆振声，顷刻雨露。\n同罪诸臣，悉蒙恩宥。\n嗟我所天，先受刑苦。\n圣人刑法，万世则祖。\n雷不崇朝，岂忍终怒。\n用法有律，手足仍措。\n皇皇百执，矫矫直臣。\n一夫不获，亦疾于心。\n有此沈冤，充耳不闻。\n折槛回天，祐我后昆。\n夫纵有罪，死即平允。\n老亲梵独，周文所悯。\n茫茫寒北，坎坎艰屯。\n行同飘蓬，到亦颠殒。\n枯穷至此，死之安忍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29493,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜笼中鸟自喻","author":"德容","text":"千里朝凰唱和遥，谁怜孤鹜禁樊牢。\n贞心甘守笼中日，再世齐鸣共九霄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29494,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梅花","author":"德容","text":"蝶梦三春泪落花，风飘馀粉谢铅华。\n天生玉色菩提片，疏影幽窗独自夸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29495,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"茉莉花","author":"德容","text":"冰姿玉骨净尘烟，南国携来种自妍。\n花史高名空第一，只今谁识藐姑仙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29496,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"对良人小像泣感","author":"德容","text":"对影依稀恍若君，欲言不语况殷勤。\n称觞举案惟形笔，赖是相逢画里人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29497,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"七夕 其一","author":"德容","text":"玉露金风报素秋，穿针楼上独含愁。\n双星何事今宵会，遗我庭前月一钩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29498,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"七夕 其二","author":"德容","text":"织女牵牛送夕阳，临看不觉鹊桥长。\n最伤今夜离愁曲，遥对天涯愈断肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29499,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋色有感","author":"德容","text":"征帆湿泪带秋风，客路愁思旅况同。\n无限忆君传织锦，有情长寄白云空。\n昨别离魂不觉愁，钟催残月忆悲秋。\n思君空馆应无语，南望多情似水流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29500,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆母","author":"德容","text":"拜别慈帏一月馀，堪怜弱质远驱驰。\n北堂萱草今安否，但愿棠荆好护持。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29501,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆兄","author":"德容","text":"蛾眉愧不列须眉，未得吹篪洽古徽。\n况复孤舟人万里，脊令原上白云飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29502,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆姊","author":"德容","text":"姊妹花开种绣房，徐娘空复字秦郎。\n愧从四女祠前过，膝下而今少一行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29503,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆儿","author":"德容","text":"坐忆雏儿泪满裳，天涯一望水茫茫。\n临行珍嘱休悬念，多识之无字几行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29504,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"遗诗","author":"超一","text":"静中无个事，反复弄虚空。\n地老天荒后，魂飞魄丧中。\n有诗开道统，无法度愚蒙。\n忽底虚空碎，夕阳依旧红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29505,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"看花","author":"超一","text":"土来浇灌水来栽，颠倒工夫任我来。\n满院春风花自语，不将颜色向人开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29506,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏蚕","author":"安生","text":"瓮茧空传异，人衣岂诳天。\n只应方老病，未合喻参禅。\n死去悲丝尽，苏来羡翼全。\n本无鳞角势，雪覆亦徒然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29507,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"朱夫人惠碧螺春","author":"安生","text":"绿润涵灵气，清芬带露华。\n翠微新雨歇，云窦古根斜。\n沸鼎看鱼眼，擎杯吸乳花。\n多君缄赠我，应自胜流霞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29508,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"挽旃那","author":"安生","text":"玉容从此谢空华，小阁游丝护碧纱。\n宛转曾遮松下扇，清幽谁供佛前花。\n蒲团初撤怜春月，贝叶空遗映晚霞。\n几处香温悲手泽，青鞋倚壁冷袈裟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29509,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"失题","author":"介石","text":"朝来剩得好春阴，芍药屏花岁岁心。\n解作流连是啼鸟，一行茅屋绿阴深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29510,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清明","author":"介石","text":"桃花雨过菜花香，隔岸垂杨绿粉墙。\n斜日小楼新燕子，清明风景好思量。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29511,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和韵留别","author":"性道人","text":"易水兴歌泪欲弹，孤舟残烛梦阑珊。\n篷窗寥落凭谁慰，歧路萧条强自宽。\n碧草寒烟江上画，野蔬村酒客中餐。\n更怜此夜溪前月，愁杀离人不忍看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29512,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋怀","author":"性道人","text":"朔风哀角起孤城，强就东篱对菊英。\n侠气驱愁存傲骨，诗怀借酒出奇兵。\n碧云黄叶清秋色，蒲枕青镫旅馆情。\n敝葛何堪当此际，新凉渐向永宵生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29513,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋夜感怀","author":"性道人","text":"风凄霜重叶初稀，孤客无家雁亦归。\n往事易悲休记省，壮心难遂且忘机。\n深秋小院人愁坐，澹月疏林鸟乱飞。\n远戍城高残角冷，砧声处处理寒衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29514,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠冒巢民","author":"性道人","text":"天涯浪迹几年春，此日何期青眼频。\n赠药为怜司马病，解衣应念少陵贫。\n惭非骏骨逢知己，羞把蛾眉奉路人。\n听雨不堪孤馆夜，感今追昔倍沾巾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29515,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"留别吴蕊仙","author":"性道人","text":"一身飘泊御风游，岭上閒云水上鸥。\n锦字怕随江雁断，诗魂还逐晓莺流。\n野塘孤棹黄花晚，香谷寒窗杂树秋。\n只恐重来仙路迥，烟迷露阻武陵舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29516,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春居","author":"性道人","text":"小榻参差竹影斜，衡门芳草锁烟霞。\n棱铮傲骨诗为友，淡泊禅心画作家。\n暖日不须来燕子，春风争肯逐桃花。\n凭阑细雨潇潇夜，慷慨悲歌抚镆铘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29517,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清明感怀","author":"性道人","text":"积润侵阶碧草生，杏花寒食半阴晴。\n一帘细雨迷归燕，几日东风度老莺。\n泪眼看花如有恨，旅怀中酒似多情。\n何时十亩偕贤侣，箕踞空山啸月明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29518,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将归江南次答邓孝威 其一","author":"性道人","text":"扬袂狂歌《归去来》，五湖烟月冷苏台。\n遥怜竹屋分题处，花落重门草似苔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29519,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将归江南次答邓孝威 其二","author":"性道人","text":"懒向人间道可怜，古来倾国尽婵娟。\n花飞不煮胡麻饭，静里閒参柏子禅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29520,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将归江南次答邓孝威 其三","author":"性道人","text":"野草菰蒲一径通，短篷江上趁春风。\n乱鸦惊起投巢去，人在遥林落照中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29521,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将归江南次答邓孝威 其四","author":"性道人","text":"几许关心总不平，飘然湖海托馀生。\n閒云好伴孤帆去，祖道何人唱《渭城》。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29522,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠范洛仙","author":"性道人","text":"黯淡销魂独倚楼，登山临水又逢秋。\n檐前垂柳丝千尺，只系柔肠不系舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29523,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠苏贞仙","author":"性道人","text":"一架蔷薇满袖香，同行谁不羡红妆。\n平生最爱清幽事，肯惜凌波绕曲廊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29524,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄怀洛仙","author":"性道人","text":"萧骚越客独淹留，汗漫西风柳岸秋。\n安得东风解我意，好吹此恨到扬州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29525,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山中早梅雪后喜闺友任归见访","author":"上鉴","text":"与君别江树，十年滞行迹。\n忍使田园苑，可怜秋水碧。\n道远梦何繇，雁促音难绎。\n一朝顾柴关，白云惊艳客。\n涧松青若故，野人贫似昔。\n午饭供新葵，晚香论《周易》。\n早梅覆屋红，积雪映峰白。\n一溪鸟语溶，四壁琴书泽。\n任运有虚舟，放閒无火宅。\n相对绿樽开，起舞南山石。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29526,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画","author":"上鉴","text":"江树迷离鸥自浴，江云飘尽春山绿。\n渡头小艇卖鱼归，月映斜扉满篱竹。\n读书楼静倚栏杆，一望烟霞碧落寒。\n奇幛插天藏古寺，危泉悬壁露岩滩。\n玉笙声断莺啼处，狼藉落花飞不去。\n将身欲置画图间，相与神仙觅往还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29527,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"幽居志兴","author":"上鉴","text":"戢影衡门下，悠然物外身。\n择林知鸟异，藏尾识龙神。\n山静云光活，溪閒草色新。\n废琴兼病鹤，相与得天真。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29528,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"村居","author":"上鉴","text":"贫家风物厌铅华，波影浮来尽落霞。\n梦里青山閒岁月，镜中人面想桃花。\n秋镫病后惟馀砚，春水愁多未浣纱。\n枕上片魂谁唤起，夕阳烟树几归鸦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29529,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西山访隐","author":"上鉴","text":"人远山深云景新，青溪石落画烟晴。\n飘残絮影遥知柳，啼遍桃花不见莺。\n沓嶂开天春一线，危岩飞瀑雪千层。\n野猿见客如相识，为叩松关鹤自迎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29530,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感怀","author":"上鉴","text":"鹤煮琴焚事已赊，不堪回首数年华。\n愁来有句留残叶，梦去无人问落花。\n鸟惜晚香窥槛镜，婢怜新病锁窗纱。\n柳枝剩有苏台曲，未审春风忆若耶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29531,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闺友见访感旧","author":"上鉴","text":"蓬门来访碧山秋，别久相逢放更幽。\n红叶隐镫疏雨乱，白云堆榻晚风留。\n自埋书剑新篁寺，谁倚琴樽旧画楼。\n料得百花洲畔月，年年长照水空流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29532,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄龚静照","author":"上鉴","text":"诗狂生性与君同，遗世搜奇兴不穷。\n见说绿窗娴剑术，白云深处礼猿公。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29533,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋蝉","author":"上鉴","text":"咽柳鸣槐较恨多，一声声送夕阳过。\n朱楼尽是笙歌地，不解悲秋奈若何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29534,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"辞世偈","author":"吴氏","text":"风卷云雾散，明月碧团圆。\n了然无挂碍，池内现金莲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29535,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"孟夏关中咏","author":"行刚","text":"百结鹑衣倒挂肩，饥来吃饭倦时眠。\n蒲团稳坐浑忘世，一任尘中岁月迁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29536,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]