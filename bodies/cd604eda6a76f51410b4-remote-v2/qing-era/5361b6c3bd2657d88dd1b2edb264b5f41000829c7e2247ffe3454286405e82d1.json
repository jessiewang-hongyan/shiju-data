[{"title":"龙王嫁女","author":"郑用锡","text":"一派笙歌出禹门，波臣水伯送鱼轩。\n他时九子传奇种，赑屃真堪作外孙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34724,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸿门宴","author":"郑用锡","text":"鸿门风急剑光寒，炎汉天心欲改难。\n生斫卯金亦痴事，空教碎斗发冲冠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34725,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"酒衣二首 其一","author":"郑用锡","text":"衾天席地醉江乾，别有干坤酒国宽。\n千载知心剩红友，绨袍合赠故人寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34726,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"酒衣二首 其二","author":"郑用锡","text":"典尽金貂怯影单，垆头一醉不知寒。\n菟裘营向糟印老，衣被春风两袖宽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34727,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"广平赋梅","author":"郑用锡","text":"几生修福到清閒，铁石心肠伴玉颜。\n宰相头衔花一品，调羹赋手重人间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34728,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"征边","author":"郑用锡","text":"貔貅十万抵胡天，拔帜登坛众志坚。\n虏得降王期报国，论功不羡勒燕然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34729,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"明妃出塞二首 其一","author":"郑用锡","text":"万里胡沙月暗天，琵琶声断玉关前。\n解环羞寄征边将，为结君王再世缘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34730,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"明妃出塞二首 其二","author":"郑用锡","text":"一曲声寒马上弦，酸风苦雨泣胡天。\n出宫得见君王面，犹胜阿房卅六年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34731,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"元旦新门神到任","author":"郑用锡","text":"头衔初换喜新迁，印绶长披玉阙前。\n从此门前无狗盗，劳他锁钥管年年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34732,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"旧剑","author":"郑用锡","text":"补缀原关中阃事，莫邪不用太无聊。\n牵衣我欲持三尺，斩此安昌答圣朝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34733,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"一纸炉 其一","author":"郑用锡","text":"纸爇银铛巧制高，纯青火里煮松涛。\n趋炎到底成灰易，多事抽薪止沸劳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34734,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"一纸炉 其二","author":"郑用锡","text":"此去无须埽叶劳，列铛松下夕阳高。\n可怜世上人情薄，冰炭丛中闹一遭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34735,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"征边将","author":"郑用锡","text":"万里风寒夜枕戈，为君收拾旧山河。\n封侯岂是儒去福，愧向胡沙奏凯歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34736,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"琵琶","author":"郑用锡","text":"大小盘珠落指头，忽雷声绕四弦秋。\n明妃去后浔阳老，塞草江花一例愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34737,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"斗酒","author":"郑用锡","text":"森严酒令出奇筹，拇战纷哗未肯休。\n忽报降旗坛上竖，乘酣奏凯过糟邱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34738,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"照身镜","author":"郑用锡","text":"空中色相證瞿昙，看取狂奴故态憨。\n我自前身认明月，举杯一笑影成三。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34739,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山中访友","author":"王松","text":"来路沿流水，开门见好山。\n花间携手语，酒后出诗删；为约三椽筑，同消一味閒。\n敢嫌供给少，满袖白云还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34740,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"请缨","author":"王松","text":"请缨无路痛何如，且读人间有用书。\n莫笑朝端多肉食，求才从不到茅庐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34741,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感兴","author":"王松","text":"和议知非策，瀛东弃可伤！\n坠天忧不细，筹海患难防！\n兵燹殃千里，亲朋散四方。\n故乡归未得，泪眼阅沧桑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34742,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"避乱喜晤吴水田广文、李子学少尉","author":"王松","text":"蒿目时艰欲问天，朝廷忧国更无贤！\n不图吾辈谈灯下，遍唤儿曹拜榻前。\n陵谷变迁伤此日，门庭衰落感中年！\n须知去住关名节，莫让他人早著鞭！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34743,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海上望台湾","author":"王松","text":"如此江山坐付人，陋他肉食善谋身；乘桴何用频回首，懒学长沙论「过秦。\n」","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34744,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"喜抵锦江故里 其一","author":"王松","text":"东南半壁战尘昏，虎口馀生一息存。\n何用携家方外去，避人此地即桃源。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34745,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"喜抵锦江故里 其二","author":"王松","text":"烽烟已远梦还惊，渡海归心对月明。\n遍历江山诗渐老，新知面目见犹生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34746,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感兴","author":"王松","text":"兵火无宁日，沧桑事百端；一身牛马走，大地虎狼蟠；路梗音书断，途穷去住难！\n数茎华发在，周粟不妨餐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34747,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登城东楼","author":"王松","text":"登陴望阙叹拳空，时事浮云大海东。\n绕郭溪声秋雨后，满楼山色夕阳中。\n移家人困搬姜鼠，守土民愚负蝂虫。\n一片热肠双冷眼，愁来只合问苍穹！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34748,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"村居偶得","author":"王松","text":"此境清心目，重来路恐迷。\n水明平野阔，云压众山低；鹅鸭浮蒲渚，牛羊卧柳堤。\n村居风俗古，疑是武陵溪！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34749,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"避乱","author":"王松","text":"不求闻达祗山林，荒尽田园又废吟；避俗恨无千日酒，著书枉用一生心；百年文物悲涂地，几姓江山兆采金！\n畏域愁城朝夕困，那禁霜雪鬓边侵！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34750,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"穷愁","author":"王松","text":"萍踪自昔寄瀛东，一旦流离世业空。\n痛饮怕知今日事，狂吟渐觉近来工。\n折磨志比三烧玉，阅历身如百鍊铜。\n欲赋沧桑难下笔，穷愁敢拟杜陵翁！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34751,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"写怀","author":"王松","text":"独立苍茫诵「楚辞，」无才经世愧须眉！\n干戈不死贫犹幸，锋镝馀生窜可悲。\n邻里痛思全盛日，国家忍见就衰时！\n而今勉守松楸地，豺虎丛中和杜诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34752,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"遣兴","author":"王松","text":"东南半壁绝通津，那有桃源可避秦！\n厌世几如都散汉，忧时曾作太平民！\n干戈劫外清修验，石火光中往迹陈。\n极目山形犹拱北，且收忠骨满江滨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34753,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"偶成","author":"王松","text":"如此江山伴索居，济时心力尽删除。\n避人计拙惊弓鸟，恋旧情深失水鱼！\n偷活吟身窜荆棘，谋生溷迹托樵渔。\n但惭无肉酬黄耳，几度烦传却聘书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34754,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄郑伯玙、李舜臣两孝廉","author":"王松","text":"欲说当时事，诸公岂愿闻！\n西园梅弄月，北郭酒论文；峰势鸡冠耸，溪形燕尾分。\n故乡今剩我，何以慰离群！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34755,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄怀陈子潜广文","author":"王松","text":"更从何处寄诗筒，浪蕊浮花到眼空。\n入梦几回寻旧雨，相思一夜起秋风。\n看云携屐灵泉寺，醉月飞觞带草堂。\n回首不堪长太息，愿君高唱「大江东！\n」","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34756,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"书感","author":"王松","text":"谁能既倒挽狂澜，杀运沉沉泪暗弹！\n不合时宜知己少，生逢世乱作人难！\n亲朋离散音书断，妻子骄痴去住艰。\n几向青天搔首问，何年种竹报平安？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34757,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自题「内渡日记」","author":"王松","text":"闷极聊涂抹，行间半泪痕。\n避兵归故国，遇贼滞孤村！\n转得名山胜，难忘好友恩！\n朅来思痛定，把卷倍销魂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34758,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄怀郑香谷主政","author":"王松","text":"闻说康成在，干戈苦未休。\n离情分一水，别恨满孤舟。\n入梦怜衰老，阂心定去留。\n思君今夕泪，随梦向东流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34759,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和郑毓臣广文元韵","author":"王松","text":"近来米似长安贵，此去事如蜀道难！\n四顾茫茫千感集，一身碌碌百忧攒。\n春风回首肠空断，夜月伤心泪不乾。\n毕竟新诗咏何事，邮传只许细君看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34760,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉吟","author":"王松","text":"狂夫有心病，非酒莫能医。\n恰喜酒肯赊，时时一中之；醉中言喃喃，往事杂新词。\n亲旧笑避席，妻子苦相规。\n谓此是狂药，乐此欲何为？\n且非摄生道，兼讪富贵迟！\n我方入醉乡，适此大兵追；奋舌与之战，贤于用偏师。\n富贵不识字，岂如贫有诗；长寿无气节，不若夭为宜！\n醉吟有深意，此外听天施。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34761,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"乙未1895生日感作","author":"王松","text":"我今三十乃如此，便到百年已可知！\n孤愤惜无青史分，不才閒过黑头时。\n太平得寿方为福，离乱全生祗赏诗。\n此日岂惟毛义感，涓埃未报负男儿！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34762,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"偶感","author":"王松","text":"学书学剑廿馀年，不意疮痍满眼前！\n报国岂宜论在位，当途更少力回天。\n隐忧恰为梁瓯缺，守节应如赵璧全！\n从此痴聋无一事，免教洗耳累清泉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34763,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"遣闷","author":"王松","text":"深宵长太息，似作不平鸣。\n晓泪花争落，春愁草怒生；时君劳北顾，上相辱东行！\n剩有村儒在，相逢话太平。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34764,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"回首","author":"王松","text":"历历先朝事屡迁，燕京回首泪潸然！\n国家幸有中兴主，社稷忧无不世贤！\n半夜闻鸡愁起舞，长途老马怯加鞭。\n书生愧乏匡时策，林下偷閒总任天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34765,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"乱后游潜园","author":"王松","text":"醉过西州更怆神，潜园无复昔时春。\n忍看石笋镌为柱，况说梅花斫作薪；临水高楼馀瓦砾，藏山绝业化灰尘！\n伤心来去堂前燕，悲语如寻旧主人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34766,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"淡江泛舟","author":"王松","text":"一叶扁舟万念删，无风波处享清闲。\n钓竿虚插篷窗外，醉读「黄庭」倦看山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34767,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"吊郑延平","author":"王松","text":"功名一事岂由天，忠孝如何不两全！\n毛发数茎完节义，英雄千里辟山川；此邦得比田横岛，割地犹劳王浚船！\n今日泉台应失笑，渭阳异域竟开边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34768,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"村居即事","author":"王松","text":"林下埋头倦送迎，偶闻时事也堪惊；朝多安石更新法，世少汾阳复旧京！\n恋岫云无争出意，在山泉有不平鸣。\n何须更羡功名贵，「诗话」新编两卷成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34769,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"述怀","author":"王松","text":"我本田间一老农，怕提旧事话康雍！\n何乡可葬烟霞骨，有酒难浇块垒胸。\n忧患转疑因识字，笑啼不敢若为容！\n倘非桑梓真堪恋，一叶扁舟去绝踪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34770,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"书愤","author":"王松","text":"生逢割地亦徒忧，烽火连天尚不休。\n家有两姑难作妇，国无一士觅封侯！\n安危于我何轻重，得失劳人问去留。\n大局不禁长太息，华夷从此是春秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34771,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"家居答友","author":"王松","text":"栖迟难舍旧家乡，耻学时流为口忙。\n笔墨犬儿痴肖我，裁缝虎女喜随娘。\n闭门种菜云同懒，隙地栽花梦亦香。\n不是相怜为同病，岂轻许到辋川庄！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34772,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宿山寺偶题","author":"王松","text":"寒恋重衾睡起迟，梦中啼笑似儿时。\n天心颠倒愁无益，人事萧条酒莫辞！\n自别王城惟种菜，偶来佛寺为寻诗。\n如今休听长安事，除却云山总不思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34773,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"归途杂诗五首 其一","author":"王松","text":"穷栖鸟恋旧巢林，匹马经过动悴吟；千里故山青满目，万堆新骨白伤心！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34774,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"归途杂诗五首 其二","author":"王松","text":"江山惯作犒师牛，遂致舆图尽海头。\n惟有指峰无恙在，青青不改使人愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34775,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"归途杂诗五首 其三","author":"王松","text":"到处听人笑圣清，惟知养士懒论兵！\n自从明月西沉海，夜夜痴心梦倒行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34776,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"归途杂诗五首 其四","author":"王松","text":"靖海将军更好生，只须传檄不穷兵。\n至今鹿耳洋洋水，犹似当时咏政声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34777,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"归途杂诗五首 其五","author":"王松","text":"天意应怜大海东，陈涛事异恰情同。\n愧无杜老哀时句，泪洒吟笺似血红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34778,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"书感","author":"王松","text":"几许匡时志已灰，中朝偏少出群才！\n亲朋远别犀望月，儿女无知鸭听雷。\n一去王嫱难复返，三呼宗泽有遗哀！\n可怜春燕巢林木，桃李如今半废材！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34779,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丙申1896除夕","author":"王松","text":"痴呆不卖穷难送，如愿于今更懒求；赊券奈无台避债，祭诗聊借酒浇愁。\n那堪时事频焦额，已卜馀生莫出头。\n归去自佳留不恶，岂宜怨李与恩牛！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34780,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"偶成","author":"王松","text":"对此茫茫有所思，胡尘满目放翁悲。\n他时故友编遗稿，为补「示儿」一首诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34781,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"纵笔","author":"王松","text":"万叠青山一鸟吟，三竿红日百花深；左图右史邀中酒，明月清风伴抚琴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34782,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"喜吃烟","author":"王松","text":"吃烟恰值禁烟期，身外浮云醉不知。\n倘得心肠无是物，岂愁面目异当时。\n藉他戒酒狂言寡，伴我看书引睡迟。\n若使昔年有莺粟，吴王未必爱西施！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34783,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄怀郑养斋茂才 其一","author":"王松","text":"醉馀忽到郑公乡，不见当年旧酒狂；我爱君诗清似水，吟来但觉口生香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34784,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄怀郑养斋茂才 其二","author":"王松","text":"生逢离乱不胜悲，辛苦移家志可知；从此重洋严界限，梦中犹恐见无期！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34785,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"乱后游北郭园奉赠主人","author":"王松","text":"避乱归来万念轻，不堪寂寞且閒行！\n园林重到如前世，宾主相逢喜再生。\n到眼已无当日物，伤心难遣此时情！\n六经浩劫悲投溷，空为尼山抱不平！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34786,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送叶寿亭广文回原籍","author":"王松","text":"送别寻常已可悲，况逢世乱倍凄其！\n但惭今日回无力，休说他年会有期！\n鸟亦笑人行不得，花如恋主放偏迟。\n羌胡杂处关无阻，此事当年已逆知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34787,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠家瑶京弟","author":"王松","text":"人文两足慰相思，一刻迟过数度催。\n万事输君缘有母，半生爱我只因诗。\n才华恰是荒年谷，倾倒真如向日葵。\n深愿来生作兄弟，老天可许再追随？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34788,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"酬家箴盘见赠元韵 其一","author":"王松","text":"交情久隔暮天云，不意寒宗更有君！\n觅句独能参上乘，著书犹幸未全焚。\n匡时恨不逢黄石，避世何嫌卧白云！\n从此与君坚雅约，闲中对酒论诗文。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34789,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"酬家箴盘见赠元韵 其二","author":"王松","text":"如此江山易怆神，干戈劫外寄闲身。\n尘中难得三生契，壁上看来一局新；深愧无才难报国，偷吟有句半伤春。\n飞觞笑为林泉贺，著个书生作主人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34790,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"村居书兴","author":"王松","text":"乍采篱东菊，俄看岭上梅；哀时身渐弱，愁夜眼长开。\n泉石閒无事，功名愧不才！\n雨云易翻覆，只合学敲推。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34791,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感怀","author":"王松","text":"满朝泄泄昧先机，误事都归一合肥！\n天更弃人如敝屣，谁知谋国久宵衣！\n可怜剜肉医疮拙，其奈甘心听指挥！\n细读圣明哀痛诏，始知和议未全非。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34792,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山居适兴","author":"王松","text":"颠狂原不合时宜，自别王城乐莫支。\n妻拙堪为山水伴，书多差喜见闻奇。\n曲江对镜怜形影，彭泽编诗纪岁时。\n热血一腔何处洒？\n且将耕读教豚儿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34793,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日郊行即事","author":"王松","text":"夜雨红墙杏，春风绿涧萍。\n看花惊节序，听鸟卜阴晴。\n犬喜随人出，妇勤背子耕。\n愧余无一事，日日看山行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34794,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]