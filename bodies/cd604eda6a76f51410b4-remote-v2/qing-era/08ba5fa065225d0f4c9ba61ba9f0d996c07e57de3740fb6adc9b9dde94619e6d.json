[{"title":"台湾纪巡诗 其四十九","author":"夏之芳","text":"金梭轻掷夜深闻，独木虚中杼柚分。\n织就天衣无杀缝，扊毛五色达戈纹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2702,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其五十","author":"夏之芳","text":"秋冬官催认饷忙，一丝一粟便输将。\n最怜番俗须重译，溪壑终疑饱社商。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2703,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其五十一","author":"夏之芳","text":"餐风宿露为当官，宿食经旬一饭丸。\n多少豪民安饱甚，动云番性耐饥寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2704,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其五十二","author":"夏之芳","text":"北番风俗半传闻，竹堑遥通八里坌。\n干豆门边湖水阔，沃饶千里隔烟云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2705,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其五十三","author":"夏之芳","text":"内社诸番气未驯，如魔如鬼独种神。\n楂桠鸡距工飞走，跳跃猿猱是比邻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2706,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其五十四","author":"夏之芳","text":"荒垄攒来耦十千，纷纷窜籍占田间。\n可知地利不须尽，生聚应思及百年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2707,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其五十五","author":"夏之芳","text":"金汤永固藉雄兵，极北分屯淡水营。\n磺气渐消田渐辟，料应添筑海边城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2708,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其五十六","author":"夏之芳","text":"闽人轻惰粤人勤，垦置田园内外分。\n占籍莫嫌多客仔，曾歼朱祖作前军。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2709,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其五十七","author":"夏之芳","text":"手刃番黎血尚腥，忙镌肌骨作人形。\n遍身竞赌人多少，方信当场孰惯经。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2710,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其五十八","author":"夏之芳","text":"为怜淳閟尚艰鲜，食货交通列市廛。\n最是居奇无赖子，动将宽政作奸缘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2711,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秩满留别台阳 其三","author":"夏瑚","text":"何期小草忽增妍，厚沐滋培达九天。\n百里政惭书上考，六条计忝附官联。\n烟销海国鲲鲸岛，日丽皇途騄駬鞭。\n敢拟香山留别句，皇恩只许驻三年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2712,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秩满留别台阳 其四","author":"夏瑚","text":"一行作吏素硁硁，宠辱于中两不惊。\n抚字催科从吏议，茧丝保障待公评。\n别无恋栈心难白，祇有衔恩志欲鸣。\n计日扬帆趋北阙，回瞻鹿耳不胜情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2713,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"野宿","author":"高拱乾","text":"秋云向暮总阴森，竹屋卑栖枳棘林。\n风外叶鸣山鸟怪，雨中灯静寺钟沉。\n瘴烟作祟香先到，积水生寒夜渐深。\n耳目悲凉成底事，草虫还为发孤吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2714,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"番俗 其三","author":"张湄","text":"争迎使节共欢呼，骢马前头众妇趋。\n首顶糍盘陈野食，大官曾未识都都。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2715,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"螺青书屋","author":"陈书（桃源人","text":"湖海元龙气未除，乾坤宽大是吾庐。\n身閒不必买山隐，心静何妨近世居。\n案少奇珍惟笔砚，囊无长物只琴书。\n螺青社里频开帐，潇洒襟怀定属余。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2716,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"答友人柬问螺阳风土","author":"陈书（桃源人","text":"问俗竟如何，家家茅结庐。\n有村皆种竹，无地不通车。\n秉穗赓多稼，鸡豚乐比闾。\n但令安作息，海宇即豳居。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2717,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"追怀刘壮肃公","author":"陈瑚","text":"忆昔甲申岁，法夷寇南瀛。\n公自平发逆，久叹髀肉生。\n英雄乘时势，系越更请缨。\n四郊刁斗急，虎帐夜不惊。\n胜败乃常事，深谋功竟成。\n遂令彼金人，畏惧岳家兵。\n莫云修武备，海岛便升平。\n百年开草昧，政教未风行。\n凶番赖以抚，田赋赖以清。\n汽车行陆舟，电火不夜城。\n顽民忽梗化，揭竿辍芸耕。\n即为尧舜民，宁免租税征。\n处士亦横议，时作不平鸣。\n用夷以变夏，毋乃妄讥评。\n斯人已不见，治绩犹分明。\n创始畀后人，文献有馀荣。\n斜日登大墩，古城址已倾。\n岿然北门楼，寄我古今情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2718,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"铁砧山吊古","author":"陈瑚","text":"凭吊空山感百端，延平创业最艰难。\n孤军地拓田横岛，上将身登韩信坛。\n井水一泓冰雪冷，剑光万丈斗牛寒。\n铁砧胜迹堪千古，想见英雄立马看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2719,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"怀沈斯庵先生 其一","author":"陈瑚","text":"西台晞发痛遗民，避地南瀛第一人。\n浩劫馀生存硕果，空门垂老弃儒巾。\n文风早被端由汝，天子虽尊不得臣。\n孤岛田横无限恨，白头犹见海扬尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2720,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"怀沈斯庵先生 其二","author":"陈瑚","text":"书生无力挽银河，回首中原洒泪多。\n甘作萍蓬标气节，独开草昧起弦歌。\n蛮花犵鸟供吟咏，势宦权门脱网罗。\n至竟馀生修净果，百年家国两蹉跎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2721,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"哭社兄痴仙","author":"陈瑚","text":"天末怀人拟寄笺，忽惊恶梦一凄然。\n拚将醇酒消豪气，忍谢红尘作鬼仙。\n玩世刘伶如待死，盟鸥公瑾是同年。\n詹园恍惚西州路，华屋空馀锁暮烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2722,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"哭社兄痴仙","author":"陈瑚","text":"小筑江村数载经，乌衣门巷感凋零。\n生逢丧乱同天宝，语杂诙谐类岁星。\n泥我狂歌聊当哭，知君长醉不教醒。\n南瀛硕果今无几，冷落人间野史亭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2723,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"步梁任公赠栎社原韵","author":"陈瑚","text":"久消战血不闻腥，野火烧馀草又青。\n如此河山行乐好，可堪携酒上新亭。\n新法重修安石传，从军爱读放翁诗。\n侯封万户无斯乐，正是荆州识面时。\n万牛有日驮梁栋，未便名山老大材。\n一木可能支大厦，为君安慰为君哀。\n李陵台下逢苏武，不是悠悠行路人。\n可惜东西等劳燕，尊颜能得几回亲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2724,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏日田家杂兴","author":"陈瑚","text":"刈尽黄云夏日长，村庄晒粟妇人忙。\n剧怜汗透罗衣湿，未敢偷閒纳晚凉。\n閒来缓步到池塘，风送荷花扑鼻香。\n村女不知花更好，为贪莲子摘莲房。\n公馀贪对好溪山，一局棋枰客未还。\n门外绿阴凉似水，松根牛卧牧童閒。\n户税徵馀又水租，拔钉钱出几时无。\n迩来识得农家苦，欲绘豳风稼穑图。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2725,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏日田家杂兴","author":"陈瑚","text":"引蔓匏瓜已上棚，向阳葵槿正繁英。\n南窗一觉羲皇梦，卧听西畴打稻声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2726,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"淡北八景 其一 剑潭夜光","author":"陈维英","text":"宝剑何年掷水中，夜光高射斗牛红。\n料想化龙潜已久，几回烧尾欲腾空。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2727,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"淡北八景 其二 关渡分潮","author":"陈维英","text":"第一关门锁浪中，天然水色判西东。\n莫嫌黑白分明甚，清浊源流本不同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2728,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"淡北八景 其三 屯山积雪","author":"陈维英","text":"丰年瑞雪积峰头，为兆磺溪岁有收。\n远望芙蓉无限白，教人错认玉山浮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2729,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"太古巢即事 其六","author":"陈维英","text":"月临碧水倍生姿，山静水澄人醉时。\n明月也耽山水趣，既斜欲落故迟迟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2730,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"太古巢即事 其八","author":"陈维英","text":"对面山高草色鲜，牧童就草上危巅。\n人如蝼蚁牛如豆，买得奇观不用钱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2731,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"太古巢即事 其十二","author":"陈维英","text":"两仪石得阴阳气，八卦潭通坎兑根。\n别有洞天开小口，个中凉不异桃源。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2732,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"太古巢即事 其十三","author":"陈维英","text":"小屋如舟结构新，其间信宿脱风尘。\n明朝归去誇朋辈，我是羲皇以上人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2733,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题剑潭古寺次区觉生韵","author":"陈维英","text":"无数生灵济，蛟龙未许腾。\n潭心空印佛，山顶秃如僧。\n寺僻云长锁，碑荒石不棱。\n俗肠何日洗，洗法问图澄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2734,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一品夫人 其一","author":"陈维英","text":"父母虽生嫁即休，沈恩须向沈家酬。\n能知尽节便为孝，何事临行若死留。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2735,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一品夫人 其二","author":"陈维英","text":"三朝奉饭毕残生，苟活何如死更荣。\n陈氏曾殉监国难，同时奇节冠东瀛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2736,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一品夫人 其三","author":"陈维英","text":"奸谋?訾今何在，一品头衔万古名。\n毕竟殉身缘底事，沈家冤案不须明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2737,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一品夫人 其四","author":"陈维英","text":"鸾章一旦下东都，油壁香车离海隅。\n未审长安明月夜，贞魂犹恋故乡无。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2738,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"监国夫人 其一","author":"陈维英","text":"三朝茶饭了生因，烈女传中第一人。\n尺组捐躯原死义，殉夫无恨恨奸臣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2739,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"监国夫人 其二","author":"陈维英","text":"螟蛉冤案暗伤神，地下相从愤莫伸。\n以吕易嬴还乐卜，岩疆转瞬属他人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2740,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹭江即事","author":"陈辉","text":"一派鹭江水，遥遥碧岸西。\n风帆依石影，烟火薄云梯。\n海色群山合，潮声入屿低。\n行人栖泊处，极目旅情迷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2741,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌水溪","author":"黄清泰","text":"闻道此溪水，源头高且清。\n末流趋污下，本体失澄明。\n淘汰人功尽，冲融天质呈。\n沧浪歌记取，勿易濯吾缨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2742,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"宿猫雾戍田家","author":"黄清泰","text":"行役猫雾戍，驻马看秋光。\n天外碧山碧，地上黄云黄。\n云黄稻已熟，家家刈穫忙。\n笠子团团月，镰钩皎皎霜。\n打禾苦且乐，歌声何悠扬。\n馌担罗田畔，妇媚依土旁。\n儿童四五人，裸走拾穗狂。\n贪看不觉久，瞑色催夕阳。\n一叟前致词，止我宿田庄。\n竹桥通柴门，灯火明草堂。\n慇勤具鸡黍，从者饫酒浆。\n主人为我言，今年去年强。\n谷额幸不蚀，米价闻颇昂。\n看看收成后，旧债一半偿。\n意适笑言洽，称醉还倾觞。\n卧我新竹榻，茵铺稻藁香。\n清绝无尘梦，一枕游羲皇。\n天明辞上马，简书心不遑。\n中途回首望，竹树烟苍苍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2743,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏西螺柑","author":"黄清泰","text":"人烟寒处点秋光，火齐星星艳夕阳。\n材足抗衡唯佛手，妙能分润到诗肠。\n饶金便觉无酸态，怀玉端宜作冷香。\n莫羡洞庭千万树，西螺洲畔摘轻霜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2744,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"观岸里社番踏歌","author":"黄清泰","text":"耳不垂肩不威仪，直竹横木与撑支。\n齿不缺角不丰姿，轻锤细凿为琢治。\n番人奇嗜诸类此，黔者为妍皙者媸。\n獉獉而游狉狉处，半耕半猎贪娱嬉。\n冬月兽肥新酿熟，合社饮酒社鬼祠。\n酒半角技呈百戏，琴用口弹箫鼻吹。\n雄者作健试身手，雌者流媚誇腰肢。\n距跃曲踊皆三百，鸡冠断落鸦鬓欹。\n舞罢连臂更踏歌，歌声诡异杂欢悲。\n乍闻春林哢莺燕，忽然秋冢鸣狐狸。\n酒缸不空歌不歇，落月已挂西南枝。\n我抚此景转叹息，此辈蠢愚忠义知。\n昔曾随我砍贼阵，惯打死仗心不移。\n朝廷设屯有至计，莫听奸民鱼肉之。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2745,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"冒雨邀友游竹溪","author":"黄瑞超","text":"细雨廉纤步湿堤，招携胜侣入梵西。\n碍林碧障千竿竹，绕刹清流一曲溪。\n滴沥山泉珠液细，空濛树色野云低。\n钟声傍晚铿馀韵，兴尽归来望转迷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2746,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乐耕楼记事","author":"杨桂森","text":"望杏瞻榆重省耕，乐民之乐洽春城。\n锄云在眼方占卯，课雨关心又望庚。\n五百年来有名士，八千里外抚苍生。\n铜关铁瓮浑閒事，怎及万间新厦成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2747,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乐耕楼记事","author":"杨桂森","text":"畿南绣亩圣亲耕，阡陌原来道德城。\n共愿浇兰勤妇子，何须播谷促商庚。\n两胶造世频观学，三字题楼急厚生。\n不为登临供雅眺，乐看经始即垂成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2748,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乐耕楼记事","author":"杨桂森","text":"俗醇共羡礼为耕，声有弦歌媲武城。\n儒梦笔花探二酉，农知艺麦十三庚。\n千寻楼回红霞入，万顷秧齐碧浪生。\n为有龚黄乐观稼，屡丰载颂庆西成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2749,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乐耕楼记事","author":"杨桂森","text":"簪笔今惭事舌耕，民怀犹记夜郎城。\n敢矜求治心无已，且喜陈经日在庚。\n作赋昔年共仙侣，登楼此日伴诸生。\n立身应在最高处，愿与人同求大成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2750,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"诸罗道中即事","author":"褚禄","text":"圣朝德泽沛南东，纵目郊原茂对中。\n圳水春生灌溉足，露华秋重土膏融。\n扶桑色映曈昽日，络纬声随断续风。\n自愧一官无报称，好书大有慰宸衷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2751,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾八景","author":"齐体物","text":"蛮岛亦飞雪，玲玲彻玉壶。\n经年寒不已，见月影俱无。\n积素疑瑶圃，高空似画图。\n惟于炎海外，方觉此山孤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2752,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾杂咏 其三","author":"齐体物","text":"纪叟中山浪得名，何如蛮酒拨醅清。\n宁知一醉牢愁解，几费香腮酿得成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2753,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾杂咏 其八","author":"齐体物","text":"露浓滋得麦苗肥，草长还忧豆叶稀。\n心忆儿夫桑柘下，日斜相望荷锄归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2754,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾杂咏 其十","author":"齐体物","text":"巢楼穴处傍岩阿，薜荔为衣带女萝。\n要向众中誇侠长，只论谁最杀人多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2755,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"一甲徵租近一车，赋浮那得复言加。\n多田翁比无田苦，怕见当门虎老爹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2756,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"有田翻得免催科，纳赋人无半亩禾。\n凫雁秋粮自狼籍，南山乌堕北山罗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2757,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"负郭曾无一顷田，儿孙犹纳赋租钱。\n飞来何计还飞去，李代桃僵不记年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2758,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"通泉谁把堰渠开，旱魃如焚总可哀。\n百面麻旗千面鼓，五街簇簇戴青来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2759,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"居然不绩市婆娑，华丽犹将竞绮罗。\n大甲溪头机轧轧，至今妇苦有人歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2760,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"真教澎女作台牛，百里饥驱不自由。\n三十六村归未得，望乡齐上赤嵌楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2761,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"蜀糖利市胜闽糖，出峡长年价倍偿。\n挽粟更教资鬼国，三杯谁觅海东粮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2762,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"浩浩飞台竞捲沙，秋棚何处觅新瓜。\n乌鱼岁晚无消息，累得盐官仰屋嗟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2763,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"亭户盐筹滞未行，牢盆在手绌经营。\n涓涓莫塞卮中漏，徒析秋毫利不盈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2764,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"鹿耳门前礁石多，张帆尚未出沧波。\n赊来水利重添载，一夜漂流付孟婆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2765,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"戈船如雾集沧湄，破浪乘风是几时。\n无数估帆愁海暴，千金枉聘碧眸夷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2766,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"暮年曾未赋添丁，乞得男青复女青。\n底事森森阶下玉，也随蜾蠃负螟蛉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2767,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"黑齿偏云助艳姿，瓠犀应废国风诗。\n俗情颠倒君休笑，梨茇登盘厌荔支。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2768,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"何必明珠十斛偿，一家八口托檀郎。\n唐山纵有西归日，不肯双飞过墨洋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2769,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"可怜十曲已歔欷，再到堂前笔寓讥。\n辛苦吴航柯博士，载将怨女满船归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2770,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]