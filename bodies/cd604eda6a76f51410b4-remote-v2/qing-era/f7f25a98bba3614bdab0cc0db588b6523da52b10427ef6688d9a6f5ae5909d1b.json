[{"title":"画堂春","author":"李长宜","text":"小轩无事日初长。\n闲吟带草生香。\n榴花簇簇映斜阳。\n半吐红妆。\n月色暗侵帘幕，风来宛似潇湘。\n流萤轻透点罗裳。\n无限凄凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23229,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"惜分钗","author":"李长宜","text":"愁难遣。\n风流减。\n欲绣鸳鸯心又懒。\n恨悠悠。\n雨啾啾。\n衷肠欲诉，齿上还留。\n休。\n休。\n休。\n香烬落。\n情萧索。\n仿佛灯前人似玉。\n意儿亲。\n脸儿迎。\n温柔谁■，忒煞撩人。\n卿。\n卿。\n卿。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23230,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令 蔷薇","author":"申蕙","text":"日映红蒸香雾。\n满架芳姿娇护。\n荏苒却柔枝，蝶舞空沾新露。\n新露。\n新露，绰约更怜春暮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23231,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"长相思 赠月辉孙夫人","author":"申蕙","text":"鸳水流。\n泾水流。\n咏絮才高并斗牛。\n芳名邑乘留。\n桂影浮。\n月影浮。\n蕉梦诗篇重十洲。\n冰心比柏舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23232,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"锦帐春 元夕和孙夫人","author":"申蕙","text":"银烛澄辉，星毬熠熠。\n挥象管、淋漓香墨。\n舞霓裳，歌锦瑟，此乐难重得。\n闲情堪惜。\n蟾兔纾青，鱼龙吹碧。\n莫辜负、太平春陌。\n剔灯花，听玉漏，探紫姑消息。\n嬉游永夕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23233,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"早梅芳 夜怨","author":"申蕙","text":"窗半开，帘低捲。\n竹影风摇乱。\n银蟾微照，不点红灯掩深院。\n依稀前度约，游赏新来倦。\n听铜壶漏水，偏向恨时转。\n睡成痴，醒又懒。\n被冷谁忺恋。\n枕儿欹著，万绪千端怎消遣。\n丝丝愁络纬，字字惊哀雁。\n乍离魂，被他花雾绾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23234,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减兰 新月","author":"程茯娥","text":"浮云散尽。\n一丝露出银塘冷。\n照上妆台。\n羞染春山弄玉钗。\n波光透入。\n金仙肯受虾蟆蚀。\n雁影楼西。\n认作弓弯不敢飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23235,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"桃源忆故人","author":"程茯娥","text":"西窗斗炳惊秋早。\n昨夜玉簪开了。\n蝴蝶不知身老。\n犹恋花丛绕。\n芳草吹落王孙草。\n桐叶飘来风扫。\n无限秋心谁晓。\n添得愁多少。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23236,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙 为烈女顾季繁赋","author":"沈友琴","text":"彤管徒传缑岭怨，采兰又酿新愁。\n此身已许便相酬。\n一朝巾帼志，千古丈夫俦。\n慷慨捐生犹易事，从容就义难求。\n楼空人去冷香篝。\n云寒朝欲暮，月淡夜何修。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23237,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 月下桃花","author":"沈友琴","text":"清露酿花烟。\n皓魄无边。\n数枝低亚笑嫣然。\n一自天台迷路后，辜负年年。\n蟾影罩霞鲜，似共流连。\n茅斋相对恍疑仙，赚得东风今日好，莫为愁牵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23238,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人 送春和韵","author":"沈御月","text":"送春春去添烦恼。\n闲闷何时得了。\n试看落红多少。\n点破阶前草。\n流莺树上啼声悄。\n惊破罗帏梦杳。\n断送镜中人老。\n都为春归早。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23239,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"荷叶杯","author":"赵家璧","text":"帘外一轮明月。\n凄切。\n空自照秦楼。\n玉箫吹断碧云秋。\n愁么愁。\n愁么愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23240,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"小秦王 赠邻姬","author":"赵家璧","text":"水剪双眸衣剪云。\n莺声小语可人闻。\n见郎故尔生娇态，笑骂东风起绣裙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23241,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"落灯风 夏闺","author":"赵家璧","text":"夜静天炎冰簟卧。\n残妆理罢迎风坐。\n消受有荷香，更两两、流萤飞过，一点红灯火。\n贪凉反惹心无那。\n空看着月来云破。\n叹事事倥偬，惟拥着、书儿千部，花屿吟残我。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23242,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤凰台上忆吹箫","author":"赵家璧","text":"秋叶离离，秋风析析，秋来最是销魂。\n见秋梧摇落，秋菊堆金。\n夜看秋天似水，秋窗外、秋月如银。\n秋庭下、秋霜满地，秋雁悲鸣。\n秋清。\n秋蛩切切，听秋声一派，秋思难禁。\n奈秋怀耿耿，秋赋慵吟。\n秋兴怀人极目，秋风冷、秋色萦心。\n秋漏静、秋闺寂寞，秋恨时生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23243,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人","author":"张昊","text":"枫林昨夜多风雨。\n篱菊欹新露。\n疏枝无力倚西风，这是断肠花瘦、与人同。\n凭栏无语心何已。\n又见吟虫起。\n今年何事忽多愁，怪底凄凄风雨、暗层楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23244,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 午日","author":"张昊","text":"佳节薰风何太好。\n晓色晴明，竞渡游人早。\n公子韶华开大道。\n马蹄踏碎闲花草。\n柳上黄莺声未老。\n荡漾湖波，忽自伤怀抱。\n岂为春光归别岛。\n斑衣零落添余恼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23245,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卜算子 秋夜寄外","author":"王睿（智长","text":"风急雁书空，露冷蛩吟户。\n莫道秋来便可怜，有恨凭谁诉。\n记起意中情，惹却心头苦。\n咒得银河不肯明，坐到三更鼓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23246,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐 柳丝","author":"王睿（智长","text":"柳丝何意。\n叶叶闲垂地。\n收拾春光都是你。\n可是新愁不系。\n板桥云外啼莺。\n斜阳掩映蓑城。\n不愿生同飞絮，如何死化浮萍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23247,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 春恨","author":"王璋（季璞","text":"箫声笛韵。\n多少离情谁借问。\n雨密云流。\n残梦关心懒下楼。\n深沉小院。\n猛拍栏杆人不见。\n欲寄音书。\n无奈西风雁影疏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23248,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人","author":"王璋（季璞","text":"无端添了闲烦恼。\n魂梦时萦绕。\n阶前片片落花红。\n惹住阿侬衫子、一般同。\n一从那日分离去。\n只自廉纤雨。\n未知何日得逢晴。\n月下花前重教、宛转行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23249,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渔家傲","author":"王璋（季璞","text":"依旧年时花发路。\n高楼无复伊人住。\n几曲箫声吹不去。\n回首处。\n那堪又是黄昏雨。\n柳亸莺娇千万树。\n游丝粉蝶纷无数。\n燕子喃喃还又语。\n春已暮。\n刘郎底事寻前度。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23250,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"相见欢","author":"王虞凤","text":"新兴蛾髻如盂。\n插金鹅。\n点点蔷薇香露、沁牙梳。\n匀面罢，呼女伴，坐氍歈。\n又向绿窗深处、赌樗蒲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23251,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"相见欢","author":"王虞凤","text":"雕栏笼鸟无声。\n耽窗明。\n两两黄蜂抱蕊、刺纱棂。\n凭湘几，匀银管，画绡屏。\n印出些些花样、粟纹轻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23252,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"贺圣朝","author":"王虞凤","text":"彩线抛残金剪慵。\n绿鬟松。\n些些香唾湿残绒。\n小窗中。\n阿母拾花翻绣架，脸霞红。\n低垂凤颈剔春葱。\n意惺忪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23253,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"生查子 怀姊","author":"王虞凤","text":"忆昔别离时，欲想心先痛。\n独自拥寒衾，一夜难成梦。\n只见碧纱窗，竹影频移动。\n残月冷花梢，幽恨和伊共。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23254,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南歌子","author":"蒋晱","text":"别路山川远，离堂琴瑟赊。\n歌声灯影是谁家。\n笑我一春憔悴、数飞花。\n粉泪长沾袖，残香伴臂砂。\n怀人旅梦断天涯。\n无奈黄昏啼杀、后栖鸦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23255,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卖花声 柬外","author":"蒋晱","text":"无语独凭栏。\n离思谁传。\n东风破冻柳含烟。\n不信归鞭常入梦，珠泪偷弹。\n买卜费金钱。\n愁绝离鸾。\n晴窗检点白云篇。\n怕有空闺孤烛句，惹蹙眉山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23256,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹧鸪天","author":"蒋晱","text":"独上高楼怅晓风。\n无端愁思碧云封。\n春归那忍芳菲尽，怕见成阴绿色浓。\n情索寞，意倥偬，梦回香阁雨声中。\n知情燕子怜人寂，时向帘前诉落红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23257,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令 冬闺寄月郎","author":"李端生","text":"霜月窥窗如昼。\n孤枕那堪寒透。\n辗转倚薰笼，听尽迟迟更漏。\n眉皱。\n眉皱。\n人共梅花清瘦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23258,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 春恨","author":"李端生","text":"被拥馀香银烛短。\n睡起无聊，眉黛从教浅。\n早是伤春情绪懒。\n云鸠更惹离魂远。\n独对东风肠万转。\n烟雨霏微，苔衬飞花满。\n点点妆成花泪眼。\n花寒不似啼痕暖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23259,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春光好 咏梅","author":"许传妫","text":"歌翠羽，暮烟浓。\n冷香丛。\n雪满山中树欲空。\n月光溶。\n姑射仙人体素，罗浮仙子肌松。\n受尽一番寒彻骨，嫁东风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23260,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 元宵雪月有怀","author":"许传妫","text":"连宵冻透鸳鸯瓦。\n花放九枝不易谢。\n云髻巧妆梳。\n缠头细马驮。\n六街如鼎沸。\n明月团圞里。\n不肯下楼台。\n笙歌处处催。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23261,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙","author":"颜氏","text":"箫史韵凄凉。\n月冷筠廊。\n本来劲节傲冰霜。\n地下人间心一点。\n幻影茫茫。\n白发两高堂。\n暮景悲伤。\n亲调药饵检丹方。\n泪洒西风红叶里。\n一带斜阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23262,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 题孔蕴光女史籍兰诗后","author":"颜氏","text":"黄鹄吟馀，声声字字俱呜咽。\n素心凄绝，鸾镜悲残缺。\n点笔窗间，树树鹃啼血。\n冰心洁。\n冷如寒雪，皎似天边月。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23263,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令 和三叔父闻笛原韵","author":"冒德娟","text":"谁弄山阳古调。\n历历暗飞声到。\n折柳最关情，惹起离愁多少。\n烦恼。\n烦恼。\n留得月儿相照。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23264,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 春雨","author":"冒德娟","text":"帘外东风带晓烟。\n湿云酿雨做春天。\n馀寒未退小窗前。\n初润花梢知节候，助人娇困耐人怜。\n鸳鸯波上羽纤纤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23265,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"冒德娟","text":"细雨苍苔锁碧烟。\n丝丝初洗惜花天。\n愁心滴碎晚风前。\n堤柳嫩芽难系恨，江梅春信早相怜。\n凭栏闲对影廉纤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23266,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 观雨","author":"冒德娟","text":"闲倚小楼西。\n风雨频催。\n望中新涨画桥低。\n洗得柳枝肥又碧，一片烟迷。\n鸦湿傍檐栖。\n窗暗云披。\n不堪憔悴病春归，高控玉钩帘怕卷，寒透罗衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23267,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"念奴娇 五日","author":"冒德娟","text":"莺憨蝶舞，绿荫浓、佳节却逢端午。\n似火榴花，庭院寂，阵阵蒲风酿雨。\n对景思亲，衔杯忆弟，剩有愁千缕。\n天涯欲到，几回魂梦何处。\n荆楚风物依然，五丝重续，此日情谁诉。\n薄命孤忠如一辙，漫说悲同狐兔。\n不醒年时，澜翻世路，任韶光催暮。\n人生失意，从来无问今古。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23268,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 咏并蒂虞美人","author":"冒德娟","text":"窗外幽花，开遍处、这枝奇绝。\n染猩红、带雨拖烟，倚栏娇怯。\n似为当年亡国恨，至今犹吐同心结。\n爱迎风，款款并香肩，迷蝴蝶。\n心未冷，情还热。\n叹玉碎，怜簪折。\n羡一邱荒土，茁生英烈。\n一叶半花堪再拜，同生同死无分别。\n笑青青，吕雉戚姬坟，难言说。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23269,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南乡子 湖中泛月","author":"范毓秀","text":"薄暮泛轻桡。\n万顷清波映碧霄。\n一片浪花随月泻，滔滔。\n暗傍荷香过小桥。\n清夜景萧骚。\n把酒临轩明月邀。\n望里云山浑似画，堪描。\n收拾风光付彩毫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23270,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐 立春","author":"范毓秀","text":"风风雨雨。\n又早催年暮。\n屈指光阴能几许，转眼春回冬去。\n妆成对镜徘徊。\n重帘几度羞开。\n生怕梅花笑我，依然裙布荆钗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23271,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令 秋闺","author":"范毓秀","text":"妆罢栏杆独倚。\n飒飒西风乍起。\n帘外更濛濛，一片芭蕉如洗。\n如洗。\n如洗。\n不管海棠憔悴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23272,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 暮春","author":"范毓秀","text":"花光渐上荼蘼架。\n春睡恹恹，淡淡梳妆罢。\n绿窗人静悄无声，惟闻燕语帘栊下。\n香消慵去添兰麝。\n寂寞空园，满地残红卸。\n枝头小鸟也怜春，声声只把东风骂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23273,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹧鸪天 听雨","author":"汪韫石","text":"松籁萧条烛影幽。\n雨声和滴到西楼。\n金炉香断三更梦，玉簟凉生五月秋。\n人寂寂，夜悠悠。\n天涯信阻暗凝愁。\n疏帘到晓檐花落，滴碎离心苦未休。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23274,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"苏幕遮","author":"王兰佩","text":"靥边红，眉上翠。\n鸾镜无情，早报人憔悴。\n病起但知因病累。\n未病前时，先已心如醉。\n倚风兰，零露蕙。\n秀弱香清，只恐根茎脆。\n好向空王求忏悔。\n花莫芬芳，人也休聪慧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23275,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一落索 秋闺","author":"陈滟","text":"眉共远山争秀。\n可怜长皱。\n莫将清泪湿花枝，怕花也、和人瘦。\n萧瑟秋风望久。\n郎书无有。\n欲知日日倚栏愁，但问取、楼前柳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23276,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤凰台上忆吹箫 月","author":"顾静和","text":"寒生银粟，屋翻雪浪，璧光零乱云头。\n见明珠千斛，■菟如邮。\n桂湿扶疏影，裁纨扇、碧衬蟾钩。\n北堂牖，西园飞盖，东鄙思抽。\n悠悠。\n一声笛也，吹落了梅花，浑是悲秋。\n念素蛾睡起，玉锁琼楼。\n剩有乘风鹏翼，好借我、骑去遨游。\n傲游处，冰轮碾玉，万古常浮。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23277,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉女摇仙佩 佳人","author":"顾静和","text":"青琴绛树，下蔡洛川，共羡人间难遇。\n有个名姝，乘鸾飞去，莫是飞琼再世。\n若把容光比。\n有数束波横，口吹兰气。\n眉封翠、丰肌腻理，不过千娇百媚而已。\n争似女相如，能手赋、东邻佳丽。\n须信毛嫱西子，谢韫班姬，难得色才相俪。\n才子佳人、赢得一身双美。\n为甚谪泥犁，浊世界、羞斗靓妆高髻。\n愿天公、留心玉貌，着意怜才，召为玉殿修文吏。\n莫负了、倾城倾国胡天帝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23278,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"金缕曲 悼景姜姊","author":"韵芳","text":"姊妹花催折。\n怪朝来、杜鹃枝上，声声啼血。\n回首斑衣同戏彩，频岁依依朝夕。\n忽唱到、阳关三叠。\n呜咽临歧无别语，但牵裾、预把归期说。\n从前事，定还忆。\n可怜两载嗟离别。\n最伤心，当年分袂，竟成永诀。\n碧落黄泉穷欲遍，万一梦魂相值。\n怕梦里、幽明又隔。\n尔我神情相肖甚，对菱花、痴把君容觅。\n连宵雨，伴侬泣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23279,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹧鸪天 题平原店壁","author":"姑苏女子","text":"弱质深闺十六年。\n娇羞未敢出堂前。\n眉颦远道悲新柳，袖捲轻尘拥翠鬟。\n肠欲断，意悬悬。\n举头何处是乡关。\n临妆莫遣红颜照，收拾菱花把剑弹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23280,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮  见《众香词》","author":"沈宛","text":"雁书蝶梦皆成杳。\n月户云窗人悄悄。\n记得画楼东，归骢系月中。\n醒来灯未灭。\n心事和谁说。\n只有旧罗裳，偷沾泪两行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23281,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙","author":"沈宛","text":"难驻青皇归去驾，飘零粉白脂红。\n今朝不比锦香丛。\n画梁双燕子，应也恨匆匆。\n迟日纱窗人自静，檐前铁马叮咚。\n无情芳草唤愁浓。\n闲吟佳句，怪杀雨兼风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23282,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"朝玉阶","author":"沈宛","text":"惆怅凄凄秋暮天。\n萧条离别后，已经年。\n乌丝旧咏细生怜。\n梦魂飞故国、不能前。\n无穷幽怨类啼鹃。\n总教多血泪，亦徒然。\n枝分连理绝姻缘。\n独窥天上月、几回圆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23283,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"捣练子  见《众香词》","author":"纪松实","text":"花渐放，睡初浓。\n啼鸟枝头啄小红。\n拈笔欲消春昼永，冰花还在石虚中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23284,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"画堂春","author":"纪松实","text":"秋来正好醉秋光。\n如何忽理征裳。\n黄花十里马蹄香，飞过雷塘。\n囊借白云妆点，梦随红叶飘扬。\n高堂从此日相望，早整归装。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23285,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋波媚","author":"纪松实","text":"万顷清流接碧空。\n帆影有无中。\n平沙宿鹜，微云飞雁，点缀天工。\n垂纶人在烟波里，潇洒对秋风。\n只应无累，何须出险，不哭途穷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23286,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹧鸪天","author":"纪松实","text":"杨白花飞小苑幽。\n春残绕屋卖风流。\n来时只有风知信，滚地癫狂未肯休。\n沾翠幌，点朱楼。\n纷纷晴雪使人愁。\n深闺鬒发偏相昵，少妇惊心吟白头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23287,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹊桥仙","author":"纪松实","text":"夷则还逢，鹊桥再驾，潋滟银河待渡。\n人问遥望七襄云，竟两度、锦机罢御。\n练拖秋水，帷钩新月，却认得、重来路。\n柔情不断似前宵，相逢更觉相思苦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23288,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人  见《金陵词钞》","author":"纪松实","text":"井梧簌簌飘黄叶。\n露湿寒螀泣。\n炎天日日盼秋风。\n怎到秋来萧瑟、更愁侬。\n凭高几度空怀远。\n摇落情何限。\n断蓬心事有谁知。\n除向天孙相诉、有怜时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23289,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙  见《词综补》","author":"林少君","text":"麟篆知从九夜扪。\n诗王金诰佩随身。\n映梅争羡气氤氲。\n绣纸十番传虎仆，蒸云千首动龙宾。\n于今坛坫自推君。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23290,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆秦娥  见《众香词》","author":"钱洁","text":"凉风急。\n芭蕉细雨声声滴。\n声声滴。\n半床针绣，一灯明灭。\n良人远在黔天隔。\n溪山叠叠愁云湿。\n愁云湿。\n鱼书沉杳，雁鸿遥绝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23291,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]