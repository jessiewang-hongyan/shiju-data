[{"title":"点绛唇 春草。忆仙品","author":"孙云凤","text":"翠倚疏帘，昨宵梦冷池塘雨。\n天涯离绪。\n岁岁和春住。\n又是年时，烟锁垂杨渡。\n斜阳暮。\n片帆何处。\n绿遍归来路。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22312,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"孙云凤","text":"愁里韶华别后心。\n冷吟闲坐又春深。\n青梅如豆柳成阴。\n晓镜刍尼啼绿树，夜窗蟢子上罗襟。\n天涯何事信沉沉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22313,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐 雨夜怀仙品妹","author":"孙云凤","text":"风寒雨细。\n酿作愁滋味。\n鸳枕半欹人不寐。\n点滴绿蕉声碎。\n当时剪烛窗西。\n而今月黑云迷。\n记共海棠深夜，玉阶飞上罗衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22314,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 回文寄仙品妹","author":"孙云凤","text":"小帘疏雨花飞晓。\n晓飞花雨疏帘小。\n寒峭觉衾单。\n单衾觉峭寒。\n燕归伤客远。\n远客伤归燕。\n愁莫倚高楼。\n楼高倚莫愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22315,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 风萤","author":"孙云凤","text":"青影乱帘旌。\n点点春星。\n碧天如水月华明。\n深院夜凉人乍定，吹坠银屏。\n阑外竹声清。\n半臂纱经。\n玉阶犹忆那时情。\n团扇软罗兜不住，茉莉钗横。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22316,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹧鸪天 赠度曲女郎","author":"孙云凤","text":"细雨和风湿绣帘。\n春寒初试越罗衫。\n绿杨影里莺声滑，红杏香中蝶梦酣。\n思往事，忆江南。\n翠屏银烛黛蛾纤。\n而今冷梦闲窗夜，明月无情堕画檐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22317,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐 怀仙品妹","author":"孙云凤","text":"麝炉烟乱。\n烛影瓶花短。\n鱼雁不来消息断。\n寂寞锦屏人远。\n任他女伴嬉游。\n一春常掩高楼。\n除却雕梁燕子，无人解得春愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22318,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"孙云凤","text":"小院浓阴绿更幽。\n鹧鸪声里夕阳收。\n枣花微雨酿成秋。\n凉月玉箫怀旧梦，东风池草惹新愁。\n一春心事倚高楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22319,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 七夕","author":"孙云凤","text":"年时女伴年时院。\n迎风斗巧夸针线。\n拜罢烛花明。\n罗衣香暗生。\n事随流水去。\n此恨凭谁语。\n凉动画屏秋。\n黄昏月一钩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22320,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"祝英台近 端午寄仙品妹","author":"孙云凤","text":"绣帘垂，朱户静，庭午柳阴直。\n阶下榴花，独自忍攀摘。\n那堪艾虎悬丝，鬓绒贴胜。\n空凝望、海天空阔。\n总休说。\n犹记葵扇题诗，钗映越罗雪。\n拈枝流光，眉翠总成结。\n负他两度熏风，几番梅雨，想怀抱、也应非昔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22321,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"眼儿媚 题仕女图","author":"孙云凤","text":"云鬟玉貌小庭深。\n闲却紫琼琴。\n春纤乍露，银毫未落，几度沉吟。\n井梧搅得西风碎，清露滴罗襟。\n三分月色，半痕烟影，一点秋心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22322,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"少年游 梦","author":"孙云凤","text":"梨云缥缈，东风料峭，寒恋绣衾重。\n庭院游丝，池塘芳草，句惹一春中。\n锦屏昼永无聊甚，鸳枕乍朦胧。\n莫打黄莺，随他蝴蝶，飞入杏花丛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22323,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"念奴娇 玉兰，寄仙品妹","author":"孙云凤","text":"玉梅未落，早东风作弄，浴茧时节。\n衣卸湖棉犹道暖，直似残春无别。\n柳眼全舒，蕉心欲展，芳草连天末。\n阑干凝望，玉兰开遍如雪。\n犹记昔日东墙，海棠娇倚，半被轻寒勒。\n最是黄昏疏雨过，掩映晶帘明月。\n摘粉香清，煎酥色腻，庭下曾攀折。\n绿窗人远，此情还共谁说。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22324,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆秦娥","author":"孙云凤","text":"秋萧瑟。\n黄昏独坐窗儿黑。\n窗儿黑。\n风风雨雨，怎生眠得。\n鱼沉雁杳关山隔。\n故园又近茱萸节。\n茱萸节。\n远书不至，灯花空结。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22325,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 题烛溪叔祖“蓬窗听雨图”","author":"孙云凤","text":"一舸西风，吹暮雨、沙清渚白。\n尽吟啸、水云深处，鹭闲鸥逸。\n帆挂乡心生远浦，橹摇凉梦依秋荻。\n响萧萧、夜半听无眠，情怀别。\n渔火乱，蓬窗寂。\n峰隐翠，波涵碧。\n只暗潮吞吐，断崖千尺。\n点点轻迷天际树，声声清入烟中笛。\n展新图、忽忆下潇湘，浑如昔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22326,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"孙云凤","text":"帘卷东风燕子飞。\n杏花天气卖饧时。\n年年孤却踏青期。\n绣榻春闲人悄悄。\n画屏寒浅漏迟迟。\n小窗和月写横枝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22327,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"喝火令 题余慈柏“秋江独钓图”","author":"孙云凤","text":"天净明霞敛，山遥翠黛浮。\n潇湘烟景画中收。\n输与长竿袅袅，独钓钓清流。\n逸思冥冥雁，闲情点点鸥。\n断无人处一扁舟。\n只有斜阳，只有晚风柔。\n只有荻花枫叶，月冷半江秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22328,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"疏帘淡月 题李晨兰女史“茶烟煮梦图”","author":"孙云凤","text":"蕉阴竹影。\n并搅碎斜阳，雨晴庭院。\n静倚妆台，衣怯软罗寒浅。\n凤团初熟瓶笙沸。\n悄无人、绣帷低捲。\n星眸乍合，云鬟半堕，绿窗吟倦。\n又何处、西风吹断。\n正池生谢草，花开江管。\n绿水冰泉，肯许烦襟同浣。\n凭谁唤醒灵心问。\n望吴江、波阔天远。\n碧烟空绕，清香漫惹，画屏秋晚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22329,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十六字令","author":"孙云凤","text":"轻。\n日暖纱窗风细生。\n瓶花落，蝴蝶上帘旌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22330,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十六字令","author":"孙云凤","text":"听。\n六曲屏山倚晓晴。\n流莺啭，风递隔花声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22331,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 寄仙品妹","author":"孙云凤","text":"绣衾不寐愁如织。\n玉炉烟袅纱窗碧。\n残月照帘钩。\n雁声寒带秋。\n夜阑人寂寂。\n何处高楼笛。\n灯背小屏孤。\n梦无书也无。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22332,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令 游丝","author":"孙云凤","text":"袅袅乱粘花絮。\n撩撩绿窗情绪。\n无赖是东风，依约欲飞还住。\n无拘。\n无拘。\n为我带将愁去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22333,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐 次花海叔湖上韵","author":"孙云凤","text":"晴丝风乱。\n花里红墙短。\n一抹柳烟疏欲断。\n春色六桥重见。\n衣香鬓影轻舟。\n金尊檀板层楼。\n独向小窗闲坐，满庭细草生愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22334,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 自题画梅","author":"孙云凤","text":"冷蕊飞香上笔端。\n早春消息陇云寒。\n东风欲寄一枝难。\n似色似空和月折，非烟非雾卷帘看。\n黄昏清影到阑干。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22335,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 题娴卿妹“停琴伫月图”","author":"孙云凤","text":"金鸭篆烟沉。\n风满罗襟。\n暮霞红断碧云深。\n输与阿连清兴好，石上横琴。\n独坐漫沉吟。\n空际馀音。\n待他蟾影挂疏林。\n一院嫩凉闲不寐，无限秋心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22336,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 题辅之叔“醉墨图”","author":"孙云凤","text":"座上春风，卷帘炉篆飘窗牖。\n娱清昼。\n墨花香透。\n滋味浓于酒。\n满纸淋漓，一试挥毫手。\n披图久。\n砚池波皱。\n腕底烟云走。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22337,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十二时 题郭频迦“浮眉楼图”","author":"孙云凤","text":"霏霏烟影，濛濛柳色，盈盈秋水。\n高楼正相对，有伊人凝睇。\n十幅蒲帆归去矣。\n锦屏前、水晶帘底。\n双蛾代描却，比遥山还翠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22338,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人 自题海棠画帧","author":"孙云凤","text":"鹿庐破梦莺啼晓。\n庭外春多少。\n禁烟时节柳丝风。\n吹得海棠枝上、几分红。\n黄昏月澹纱窗薄。\n掩映阑干角。\n脂鲜黛绿总难描。\n犹比桃花丰韵、杏花娇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22339,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 自题画梅","author":"孙云凤","text":"疏窗寒色。\n独抱冰心谁似得。\n瘦格玲珑。\n人倚珠帘第几重。\n风多雾重。\n昨夜寒香吹入梦。\n检点繁枝。\n犹胜春前雪压时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22340,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"疏影 题梁蕉屏表叔“抚梅图”","author":"孙云凤","text":"古梅瘦石。\n似隐栖九里，断无尘迹。\n枝北枝南，雪后霜前，几度问他消息。\n沉吟树底摩挲遍，定写入、春风仙笔。\n爱满庭、淡影疏香，能有几人消得。\n犹记孤山山下，冻云吹散也，一湖寒碧。\n渺矣林逋，寂寞空亭，何似此中清绝。\n幽怀尽日忘言坐，共抱却、冬心高洁。\n想月明、烟冷黄昏，还有翠禽曾识。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22341,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卖花声 题邵庵叔“桃花流水图”","author":"孙云凤","text":"深树罥晴烟。\n栖处悠然。\n游踪常共白云还。\n细认仙凡都不是，好个溪山。\n黄鸟听间关。\n翠草纤绵。\n纸窗竹屋小吟笺。\n飞尽桃花浑不语，赢得春闲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22342,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"应天长","author":"孙云凤","text":"锦衾香冷消兰麝。\n明镜黛眉慵不画。\n重帘下，怜深夜。\n细雨短檠寒穗谢。\n柳梢新月挂。\n记得晚凉初夏。\n花底酒阑歌罢。\n个浓蝉鬓卸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22343,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"转应词","author":"孙云凤","text":"庭院。\n庭院。\n薄暮东风吹遍。\n画梁双燕初归。\n惆怅天涯絮飞。\n飞絮。\n飞絮。\n人在绣帘深处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22344,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人 题秀芬妹“额粉庵联吟图”","author":"孙云凤","text":"翠屏凉夜疏帘晓。\n雪月花时好。\n鸾笺真擘句先成。\n应忆榭庭风絮、那时情。\n池塘梦草笼烟碧。\n江水盈盈隔。\n灵心试问绿窗人。\n分得画眉仙笔、几分春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22345,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人 题“莳花小筑春饯图”，送许宜芳女史于归吴门","author":"孙云凤","text":"屏开孔雀杯浮绿。\n有个人如玉。\n东风明日片帆轻。\n两点修蛾新斗、远山青。\n瑶笙翠管相催去。\n紫燕双飞处。\n一庭春影醉斜阳。\n无限浓花薰得、绮罗香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22346,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"齐天乐 咏白秋海棠，兼忆仙品妹","author":"孙云凤","text":"莲衣未褪星期过，闲庭嫩凉天气。\n寂寂墙阴，深深苔罅，花吐几分秋意。\n冰清玉瘦，正掩映红窗，伴侬憔悴。\n月澹烟疏，露萤点点短丛缀。\n年时夜阑不寐，绛纱笼烛照，微雨初霁。\n素靥凝愁，幽香酿韵，别有一般风味。\n天涯此际。\n定萧瑟空阶，怅思前事。\n淅淅西风，怕吹成粉泪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22347,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西江月 自题词稿，兼寄仙品妹","author":"孙云凤","text":"别绪逗将吟绪，愁心翻作闲心。\n美人香草意偏深。\n说与旁人不省。\n一自雁行云散，几番月色花阴。\n何时一鼓海风琴。\n共对西窗烛影。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22348,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"太平时 春风","author":"屈秉筠","text":"取次花香过槛前。\n半钩帘。\n绣裙吹动褶痕鲜。\n暗相怜。\n蝴蝶双双栖不定，草如烟。\n轻寒掠梦破朝眠。\n嫩晴天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22349,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 题扇","author":"屈秉筠","text":"长天绿泻蟾波湿。\n捣衣声里秋无迹。\n双影玉骈肩。\n苔阶划袜莲。\n幽怀延好梦。\n隔著巫云重。\n生未识湘皋。\n心知是二姚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22350,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南乡子 翠云草","author":"屈秉筠","text":"贴遍玉阶前。\n秀比双鬟色更鲜。\n认是烟丝吹不断，缠绵。\n肯学馀霞散碧天。\n弱步不胜怜。\n误向秋阴拾碎钿。\n为嘱采篮人仔细，裙边。\n些小根苗正自牵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22351,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醉太平","author":"屈秉筠","text":"山川劫尘。\n繁华梦醒。\n金闺何限伤情。\n■东皋数楹。\n兰姿蕙心。\n毫仙墨灵。\n休嗟旧业飘零。\n化烟云自新。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22352,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"献衷心 子梁“心佛图”","author":"屈秉筠","text":"料佛飞轻易，心许凡人。\n多则为、种前因。\n向妙莲花座，顶礼功深。\n还不若，方寸地，自家寻。\n无佛处，佛才真。\n此中空洞即檀林。\n把至情坚铸，不坏金身。\n毋退志，休亵念，莫分心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22353,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"庆清朝 山寺观梅","author":"屈秉筠","text":"云拂衣轻，风梳鬓薄，香来古佛龛中。\n清寒一片，■檀和气交融。\n此地谁横铁笛，寻春唤醒玉虬龙。\n闲凝伫，四围冷翠，裹住芳丛。\n是画是诗是梦，恰凭栏闲想，雪意朦胧。\n罗浮世界，前身蝴蝶曾逢。\n归鸟不知倦去，夕阳斜贮一山空。\n飞楼峭，众峰争赴，袖底玲珑。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22354,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 寒夕与徐姬莲卿闲坐","author":"屈秉筠","text":"纸阁梅花寒不冻。\n身坐花前，香在心头动。\n碎却炉熏无可用。\n几枝艳雪春人拥。\n语笑移时杯茗共。\n烛外霜钟，又把昏黄送。\n今夜馀情应入梦。\n天高月瘦诗魂纵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22355,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令 雨夜怀珧书妹","author":"季兰韵","text":"深户绣帘风动。\n细雨黄昏愁重。\n忆得送行时，一把泪珠相送。\n如梦。\n如梦。\n只有自家心懂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22356,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"长相思 寄珧书","author":"季兰韵","text":"赠鲛绡。\n答鲛绡。\n两地相思怎样消。\n将心托寸毫。\n路迢迢。\n梦迢迢。\n一片魂随早晚潮。\n知君招不招。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22357,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一剪梅 暮春","author":"季兰韵","text":"九十春光欲尽天。\n愁绪今年。\n更胜前年。\n依人新燕惹人怜。\n学语缠绵。\n学舞翩跹。\n遣闷还临镜槛边。\n几幅诗笺。\n一炷炉烟。\n无聊终觉口难传。\n风已萧然。\n雨又凄然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22358,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 鸡冠花","author":"季兰韵","text":"一种奇花，素秋浓染胭脂色。\n岸然高帻。\n细丽纹如织。\n五德兼全，笑尔名空得。\n东方白。\n不闻声息。\n悄向霜风立。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22359,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐 春分日感怀","author":"季兰韵","text":"伤心难说。\n往事都鸿雪。\n痛忆前年生死别。\n正是落花时节。\n当时笑语花晨。\n而今寂历黄昏。\n泣到眼枯血尽，寻它一缕精魂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22360,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"捣练子 闻钟","author":"季兰韵","text":"良夜静，碧天空。\n悄地花阴下绣栊。\n一念不生尘意绝，数声敲彻月明中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22361,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 瓶菊","author":"季兰韵","text":"折得霜葩，胆瓶插处寒香袭。\n捲帘风入。\n秋在枝头惜。\n几净窗明，点燃真幽绝。\n重阳节。\n记曾相觅。\n犹自无消息。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22362,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐 偶成","author":"季兰韵","text":"朝来鹊噪。\n噪得侬烦恼。\n且把离情吟草草，一幅花笺残稿。\n无聊独倚阑干。\n思思想想心酸。\n尝尽世间愁味，几时泪眼才乾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22363,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 梦妹","author":"季兰韵","text":"朦胧见妹归欢聚，并坐房栊。\n细话离悰。\n握手依依旧日同。\n鸡声惊醒天将晓，才喜相逢。\n怎便抛侬。\n赢得鲛绡泪点浓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22364,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"东风第一枝 宿雨初晴，春光欲尽，用渼溪调联句","author":"季兰韵","text":"碧酿新寒，香牵旧恨，春痕黯淡如许。\n怨情密化游丝，杜鹃替人寄语。\n残红飞尽，但悄忆、东风前度。\n把泪珠、抛沁香泥，梦里翠阴如雨。\n烟影瘦、半天弄絮，空自向、画檐暗诉。\n嫩晴阁住斜阳，倚栏自吟怨句。\n淡云摇瞑，又细绘、销魂庭宇。\n甚乱愁、随了春来，不解也随春去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22365,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"季兰韵","text":"妒花风雨来何速。\n空庭一夜埋香玉。\n惜玉与怜香。\n愁人欲断肠。\n断肠非独我。\n镇日含愁坐。\n知尔在高楼。\n如侬一样愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22366,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"金缕曲 秋夜梦外，醒后感成","author":"季兰韵","text":"秋雨敲窗急。\n梦惊回、晓钟乍动，残灯将灭。\n片刻相逢留不住，宛转深情如昔。\n浑未改、旧时形迹。\n醒后音容何处去，但赢来、满枕啼痕湿。\n身世恨，一时集。\n追思往事心伤绝。\n痛而今、生诚有怨，死尤无益。\n祗悔当年侬负约，不合任君轻别。\n何苦把、孱躯偷活。\n输与鸳鸯能并命，枉千回百转相忆。\n心只愿，早同穴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22367,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"摸鱼子 题外姑母遗照后，附其幼子遗容共装","author":"季兰韵","text":"问生绡、连番画出，如何画得愁绪。\n碧云天外秋如水，中有飞仙归路。\n仙不语。\n仙已在瑶台，十二珊珊步。\n披图认取。\n甚玉镜缘悭，金环梦冷，并作断肠谱。\n前生恨。\n只结三年鸳侣。\n招魂还唱骚赋。\n未容仙果人间种，也被春风吹去。\n留且住。\n空剩了、昙花小影熏香护。\n零烟断絮。\n潘鬓已星星，两般■■，付与玉箫诉。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22368,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南楼令 雨夜怀墨香","author":"季兰韵","text":"入夜雨淋浪。\n风声助势狂。\n对孤灯、胆怯空房。\n忆得前宵同听际，浑不是，恁凄凉。\n酒怕入愁肠。\n无言黯自伤。\n且拈毫、消遣更长。\n怪煞离情吟不尽，吟罢了，又思量。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22369,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 清明","author":"曹景芝","text":"静掩妆楼不踏青。\n断肠时节是清明。\n又听墙外卖饧声。\n杨柳有情常怨别，桃花命薄易飘零。\n依人燕子尚多情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22370,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 素姊去后怆然有感","author":"曹景芝","text":"相逢又是匆匆别，留君无计心如结。\n未去泪痕多。\n去时将奈何。\n倚栏人已去，独自和愁语。\n料得小眉峰。\n也添愁一重。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22371,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 听雨怀素芝","author":"曹景芝","text":"夜雨打疏寮。\n不住潇潇。\n一灯红瘦不禁挑。\n脉脉怀人愁独坐，坐又无聊。\n听尽漏迢迢。\n心字香消。\n相思人远梦都遥。\n何日西窗同剪烛，絮语深宵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22372,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]