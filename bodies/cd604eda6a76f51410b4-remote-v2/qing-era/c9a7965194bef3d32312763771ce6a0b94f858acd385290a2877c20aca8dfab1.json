[{"title":"忆江南 其二 本意","author":"董俞","text":"江南好，其次忆苏州。\n笠泽潮生春网急，枫桥雨细晓种愁。\n远峤翠烟浮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36303,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南 其三 本意","author":"董俞","text":"江南好，虎阜更如何。\n短簿祠前罗袜浅，真娘墓上绣茵多。\n夜月听笙歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36304,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南 其四 本意","author":"董俞","text":"江南好，携手慧山傍。\n三月莺花歌舫密，半岩风雨碧泉香。\n玉碗试琼浆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36305,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南 其五 本意","author":"董俞","text":"江南好，铁瓮暮潮喧。\n瓜步秋风残堞隐，金焦夜雨大江寒。\n北固路漫漫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36306,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南 其六 本意","author":"董俞","text":"江南好，白苎景偏奇。\n短榻夜山听鹤唳，夹衣秋渚采莼丝。\n幽绝令人思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36307,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南 其七 本意","author":"董俞","text":"江南好，江北忆维扬。\n旧苑琼花香雨断，画楼檀板碧蟾凉。\n往事最难忘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36308,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南 其八 本意","author":"董俞","text":"江南好，西去是嘉禾。\n千尺画楼寒树外，断烟依旧锁南河。\n双桨一渔蓑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36309,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"如梦令 其一 惜别","author":"董俞","text":"小阁廉纤微雨。\n金鸭水沉一炷。\n临别苦丁宁，携手画栏深处。\n人去。\n人去。\n长日满庭飞絮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36310,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"如梦令 其二 春夜","author":"董俞","text":"帘外鸦啼风细，落月春芜满地。\n香尽画楼闲，知道玉人沉醉。\n君记。\n君记。\n正是消魂天气。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36311,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"长相思 其一 山屏","author":"董俞","text":"山鸟啼。\n水鸟啼。\n水阔山青路欲迷。\n愁他双桨迟。\n酒醒时。\n梦醒时。\n花又无聊月又低。\n莫教羌管吹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36312,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"长相思 其二 雨后","author":"董俞","text":"梅花天。\n杏花天。\n春在前溪梅杏边。\n花开两岸烟。\n风满船。\n雨满船。\n风雨寒灯夕不眠。\n愁来更可怜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36313,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"生查子 别意","author":"董俞","text":"高楼酒一卮，肠断分离处。\n前夜秣陵花，今夜潇湘雨。\n独倚木兰桡，酒醒山无数。\n试问此时心，心似秋莲苦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36314,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝 春闺","author":"董俞","text":"愁绝萧郎音信稀。\n梦中归。\n画帘风动六铢衣。\n篆烟微。\n小园闲却秋千索。\n桐花落。\n最怜白昼燕双飞。\n怨春晖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36315,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"女冠子 月夜","author":"董俞","text":"绿蕉深处，又见一钩蟾影。\n绣帘垂。\n袅袅莲三寸，亭亭玉一枝。\n相思情似絮，相见泪如丝。\n私语屏山曲，立多时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36316,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇 柬友","author":"董俞","text":"泉冷云深，仙翁静爱青山宿。\n晓松如沐。\n夕涧幽禽浴。\n舴艋归来，独对群峰簇。\n炉烟馥。\n满庭黄菊。\n帘捲秋塘绿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36317,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其一 夏景","author":"董俞","text":"落日凉飔曲槛南。\n红蕉初展燕呢喃。\n碧树冰簟酒微酣。\n茉莉暗藏镂玉枕，葡萄轻染薄罗衫。\n笑偎莲脸不知惭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36318,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其二 风情","author":"董俞","text":"绛蜡春醒晕粉腮。\n画栏斜凭溜金钗。\n手拈梅豆要郎猜。\n鸭绿双垂鸳尾带，猩红一捏凤头鞋。\n澹蟾偷影觑阳台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36319,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其三 春游","author":"董俞","text":"脉脉闲情似水流。\n暮江人上木兰舟。\n画桥西去笛声幽。\n客醉夕阳芳草路，鸟啼寒食杏花楼。\n澹烟微雨一春愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36320,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其四 前题","author":"董俞","text":"侧侧东风涨绿池。\n燕娇莺嫩夕阳迟。\n踏青天气斗茶时。\n绮席兴酣银凿落，琐窗肠断玉参差。\n画船归去雨丝丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36321,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其五 离思","author":"董俞","text":"孤馆寒更怅独眠。\n那人疑在绣衾边。\n欢情别恨两缠绵。\n记得夜深娇未睡，背灯无语立床前。\n鬓松腰嫩最堪怜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36322,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其六 美人春睡","author":"董俞","text":"细雨屏山掩绿苔。\n侍儿私语傍妆台。\n瞢腾春醉眼慵开。\n鸳枕暖偎红粉颊，麝煤香浸绣弓鞋。\n翠帏风动梦初来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36323,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其七 春闺","author":"董俞","text":"斗草归来雨湿衣，画帘春静蝶双飞。\n黛螺高绾绣裙低。\n好梦每嫌娇鸟唤，幽情只许侍儿知。\n小窗灯烬忆人时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36324,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其八 羁游","author":"董俞","text":"羁思春情两不堪。\n嫩寒微雨透征衫。\n翠堤迢递路曾谙。\n村寺日斜山泼黛，野塘风静水挼蓝。\n断肠芳草遍江南。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36325,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其九 春感","author":"董俞","text":"竹坞烟深禽影偏。\n溪桥花落浪痕圆。\n澹云芳草夹衣天。\n旧院碧桃人似梦，小窗红烛夜如年。\n坐残银漏阿谁怜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36326,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其十 画","author":"董俞","text":"簏簌晴窗花影垂。\n新茶泼雨泻缥瓷。\n偶拈银管蘸琉璃。\n青簇晚山轻似髻，绿浮春水细于丝。\n江南小景胜徐熙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36327,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其十一 棋","author":"董俞","text":"百宝栏前暑气清。\n砑罗衫薄茜裙轻。\n枕痕一线梦初醒。\n闲看绿窗消蕙炷，自描红玉作棋枰。\n重围谁为解刘生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36328,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其十二 诗","author":"董俞","text":"细楷吴绫点漆螺。\n微吟钗溜绿云窝。\n年来诗句断肠多。\n对镜漫裁金缕曲，背人偷和竹枝歌。\n春心一寸奈愁何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36329,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其十三 琴","author":"董俞","text":"静院幽思半不禁。\n冰泉满匣泻瑶琴。\n阿谁知得此时心。\n碧沼雨馀啼鸟寂，绣帘风细落花深。\n小窗弹罢独沉吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36330,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其一 别恨","author":"董俞","text":"芳塘弱柳波纹碧。\n画楼香雨花光湿。\n梦断晓钟残。\n床堆绣被闲。\n漫将沉水爇。\n心似丁香结。\n啮指暗寻思。\n相逢定几时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36331,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其二 闺情","author":"董俞","text":"画帘簌簌梧桐雨，晚妆初罢娇无语。\n灯下强偎人，罗衫涴酒痕。\n肌香温绣被。\n蹙损眉山翠。\n未惯是双眠。\n须郎着意牵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36332,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其三 秋景","author":"董俞","text":"草堂人去烟光夕。\n藕花残雨银塘碧。\n蝶梦此时幽。\n蝉吟一院秋。\n庭梧飘玉砌。\n曲磴茶烟细。\n独坐数归禽。\n疏钟逗远林。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36333,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其四 梅花","author":"董俞","text":"断桥雪霁溪声冷。\n溪边数点寒鸦影。\n山店暝钟来。\n垂垂花正开。\n羁愁凝望处。\n玉笛吹香雨。\n瘦萼不禁春。\n折来愁杀人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36334,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其五 怀友","author":"董俞","text":"去年元夕和君别。\n今年又见梅如雪。\n寒雁一声声。\n君从何处听。\n愁来浑似醉。\n彼此同憔悴。\n烟艇暮江寒。\n谁怜行路难。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36335,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其六 良会","author":"董俞","text":"凤钗欲溜欹香枕。\n枣花飞堕鸳鸯锦。\n漫爇玉炉香。\n那愁今夜长。\n癫狂真个醉。\n不放檀郎睡。\n些事最消魂。\n啼痕和齿痕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36336,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其七 湖舫宴集赠友","author":"董俞","text":"南屏已作三年别。\n倦游相对花如雪。\n行到画桥边。\n斜阳正可怜。\n绿蓑香雨小。\n横笛孤山晓。\n同泛鄂君舟。\n湖烟淡不收。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36337,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卜算子 江亭","author":"董俞","text":"黄鹂语不休，飞入红香暖。\n醉倚江边百尺亭，一抹柔蓝远。\n沙雨舞䰐鬖，渡口霞光乱。\n拨刺纤鳞水面游，点点菱花晚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36338,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丑奴儿令 燕子矶","author":"董俞","text":"年年肠断青溪路，燕子矶头。\n暂系扁舟。\n飞尽寒云水自流。\n六朝旧恨斜阳里，无数沙鸥。\n莫上高楼。\n叶叶丹枫赚客愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36339,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 羁游","author":"董俞","text":"去年寒食。\n滕王阁上吹横笛。\n今岁清明。\n邓尉峰头听早莺。\n几回欲去。\n却被春山留我住。\n羁思茫茫。\n且对繁华醉一场。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36340,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒金门 山寺","author":"董俞","text":"山欲暝。\n山半一声孤磬。\n两两野猿攀绝磴。\n寒潭落日净。\n帘内老僧入定。\n帘外松花满径。\n古殿石灯金粟影。\n心珠常自莹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36341,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐 其一 早行","author":"董俞","text":"荒亭古驿。\n雨送疏钟湿。\n饥鼠衔花灯下立。\n驴背一声觱篥。\n缁麈白帢堪悲。\n澹云芳草萋迷。\n谁把玉箫轻按，离人正是愁时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36342,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐 其二 幽思","author":"董俞","text":"酒醒何处。\n月落溪光曙。\n窗外子规啼不住。\n真个不如归去。\n莫言身后虚名。\n难忘菰饭莼羹。\n契阔山中茅舍，恐他鹤怨猿惊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36343,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"阮郎归 风情","author":"董俞","text":"绿蕉残梦雨丝丝。\n黄莺飞去迟。\n玉郎偷影入罗帏。\n巫山路不迷。\n湘簟滑，翠钿欹。\n灯花双穗垂。\n凭肩密约两心知。\n香唇暗啮时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36344,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"画堂春 其一 咏美人足，和友人韵","author":"董俞","text":"凤头低落画裙边。\n绣帮三寸花鲜。\n凌波何幸遇婵娟。\n瓣瓣生莲。\n怪杀夜来狂甚，温香一捻堪怜。\n玉趺褪尽软行缠。\n被底灯前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36345,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"画堂春 其二 咏美人目，和友人韵","author":"董俞","text":"销魂全在眼波秋。\n盈盈怕见春愁。\n暮江人去正凝眸。\n粉泪难收。\n密意灯前频送，幽情扇底微钩。\n绣帏斜睨半含羞。\n别样风流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36346,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山花子 春情","author":"董俞","text":"脉脉柔情怯晓风。\n茜裙双带绾芙蓉。\n僻径遇人羞背立，柳阴中。\n几度暗颦眉黛绿，一回微笑粉痕红。\n愿作翠堤芳草软，衬鞋弓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36347,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"眼儿媚 重过维扬","author":"董俞","text":"乱蝉衰柳泣邗沟。\n舴艋是重游。\n青山不改，红蕖将吐，白了人头。\n数声画角残阳里，羁客易悲秋。\n多应惹起，十年旧梦，一片闲愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36348,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"桃源忆故人 别愁","author":"董俞","text":"玉骢肯住人难住。\n漠漠征尘何处。\n只有芳魂似絮。\n飞向阳关路。\n绿蕉影里双鬟语。\n梦断风流无据。\n屈指凤城人去。\n几度纱窗雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36349,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三字令 重过燕山","author":"董俞","text":"燕市客，怅重游。\n又深秋。\n凉月小，暮山愁。\n玉蟾蜍，金腰袅，醉红楼。\n人如玉，倚香篝。\n拨箜篌。\n红蜡下，锦缠头。\n眼波横，眉黛浅，最风流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36350,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柳梢青 其一 江寺","author":"董俞","text":"几点遥山，夕阳西下，黯黯残云。\n柳絮将飞，杏花初谢，江上孤村。\n天涯又值残春。\n更不禁、青衫泪痕。\n细雨扁舟，寒灯古寺，一个愁人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36351,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柳梢青 其二 赠妓","author":"董俞","text":"记得年时。\n罗敷未嫁，碧玉初笄。\n纨扇深遮，双螺高绾，刚解相思。\n花前珍重幽期。\n更恰好、灯昏篆微。\n半饷偎人，十分浓醉，一味娇痴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36352,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柳梢青 其三 七里滩","author":"董俞","text":"莫向江头，问他渔父，谁醉谁醒。\n一叶轻船，数声横玉，云树冥冥。\n狂奴故态堪惊。\n垂钓处、寒鸦乱鸣。\n花落鸥滩，蘋香蟹簖，潮白山青。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36353,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"少年游 江景","author":"董俞","text":"白蘋古渡，丹枫远寺，好景正深秋。\n暮岭重重，寒霞片片，江路去悠悠。\n羁游汗漫，寸心千里，回首不胜愁。\n渔沚歌残，柳桥人散，凉月伴孤舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36354,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南歌子 咏所见","author":"董俞","text":"嫩绿含烟舞，妖红映水明。\n珠宫宝幕胜层城。\n蓦地绛云深处，遇娉婷。\n绣带鸳鸯暖，罗裙蛱蝶轻。\n红儿为字雪儿名。\n偷看桃花扇底，最关情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36355,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南 其一 枫桥夜泊","author":"董俞","text":"枫桥路，烟水正迢迢。\n欲向东君寻旧约，渚花岩月两无聊。\n孤负是春宵。\n人何在，独倚赤栏桥。\n遥忆去年樱笋候，画船红烛听吹箫。\n往事更魂消。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36356,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南 其二 为友人悼歌姬桐月","author":"董俞","text":"江南好，烟景媚晴川。\n柳絮淡云寒食节，杏花香雨夹衣天。\n肠断画桥边。\n初相见，碧玉破瓜年。\n半饷幽欢疑梦里，几番私语避人前。\n娇小最堪怜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36357,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南 其三 为友人悼歌姬桐月","author":"董俞","text":"江南好，花信正芳菲。\n金屋莫愁偏早嫁，画船桃叶恰同归。\n风动六铢衣。\n闲伫立，不羡蝶双飞。\n银甲按筝歌调促，玉枰赌酒笑声微。\n往事囗依稀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36358,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南 其四 为友人悼歌姬桐月","author":"董俞","text":"江南好，良夜月华新。\n舞罢争看垂素手，歌残未许啮丹唇。\n妒杀是横陈。\n恹恹病，憔悴度芳春。\n何事窈娘偏薄命，多应小玉是前身。\n缥缈梦中人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36359,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南 其五 为友人悼歌姬桐月","author":"董俞","text":"江南好，人在画船中。\n桃扇半欹眉黛妩，杏衫初卸粉香融。\n洛浦降行踪。\n寻芳去，欸乃夕阳红。\n属玉双飞春恨浅，丁香百结暮愁浓。\n相忆忽相逢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36360,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南 其六 为友人悼歌姬桐月","author":"董俞","text":"江南好，六曲画屏开。\n真个有情怜宋玉，未应轻折在章台。\n幽径少人来。\n灯儿下，媚绝粉香腮。\n无语但垂双舞袖，背人偷换合欢鞋。\n长夜费安排。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36361,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南 其七 为友人悼歌姬桐月","author":"董俞","text":"江南好，渌水蘸明妆。\n卓女漫夸眉际黛，婕妤别具体中香。\n窣地舞裙长。\n风流甚，半醉泥檀郎。\n蝶坞迷藏无处觅，鸳帏秘戏不禁狂。\n些事费思量。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36362,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南 其八 为友人悼歌姬桐月","author":"董俞","text":"江南好，蓦遇曲栏边。\n弱柳作腰长自颤，夭桃靧面益生妍。\n一笑更嫣然。\n留欢住，双跪佛龛前。\n锲臂不忘同死约，痴情还想再生缘。\n私誓两心坚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36363,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南 其九 为友人悼歌姬桐月","author":"董俞","text":"江南好，乌桕夜乌啼。\n楚峡乍逢真似梦，隋楼欲到忽生迷。\n何异武陵溪。\n灯如昼，檀板翠眉低。\n金谷好花曾共赏，翠屏纤手忆同携。\n醉墨曩时题。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36364,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南 其十 为友人悼歌姬桐月","author":"董俞","text":"江南好，佳丽数红儿。\n只为独眠偏起早，翻因密约故来迟。\n心事阿侬知。\n疏桐影，和月乱罘罳。\n子夜曲残人已醉，甲煎烧罢帐还垂。\n端的是情痴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36365,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南 其十一 为友人悼歌姬桐月","author":"董俞","text":"江南好，愁坐厌芳樽。\n青鸟漫传千里信，彩鸾应化异时魂。\n孤负月黄昏。\n疏钟静，屈戍掩重门。\n绣阁不闻莲屧响，罗衫曾印口脂痕。\n无计再温存。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36366,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南 其十二 为友人悼歌姬桐月","author":"董俞","text":"江南好，孤馆又新秋。\n明月正圆偏作晕，彩云欲散迥难留。\n暮雨更添愁。\n闲思遍，曲巷少年游。\n灯下卸头簪茉莉，帐中含笑拨箜篌。\n往事最风流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36367,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南 其十三 为友人悼歌姬桐月","author":"董俞","text":"江南好，肠断为知音。\n南陌碧桃寻旧约，西陵绣带结同心。\n良夜漏沉沉。\n人何在，门闭落花深。\n腻粉尚黏双钿合，残香犹暖旧瑶琴。\n幽恨至如今。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36368,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卖花声 江村","author":"董俞","text":"斗帐异香熏。\n无限温存。\n凤箫吹罢更偎人。\n枕上双蛾衾上泪，事事消魂。\n潦倒厌芳樽。\n身在孤村。\n梧桐残露隔窗闻。\n别是一番滋味也，月澹灯昏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36369,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]