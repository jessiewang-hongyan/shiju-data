[{"title":"浣溪沙 题菊花便面，为宗友石作","author":"郑兰孙","text":"采采东篱菊正黄。\n西风帘卷近重阳。\n挥毫写得几痕霜。\n雅韵也如人意淡，秋容偏耐月波凉。\n高怀晚节岂寻常。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3608,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调南乡子 自题玉窗春晓图小影","author":"郑兰孙","text":"罗袖晓寒添。\n才罢晨妆掩镜奁。\n脸晕消红眉减翠，恹恹。\n修到梅花亦可怜。\n花艳尚如前。\n咏月吟风句懒拈。\n斜倚玉窗人倦也，仙仙。\n疏影清香扑画帘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3609,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调南乡子","author":"郑兰孙","text":"锦幕怯春寒。\n金鸭烟沈晓月残。\n一色花痕清似雪，漫漫。\n著意相怜起早看。\n拍遍玉阑干。\n似絮愁肠画出难。\n多谢传神双管笔，珊珊。\n顾影何须换骨丹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3610,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调南乡子","author":"郑兰孙","text":"庭院雨痕收。\n侵晓珠帘乍上钩。\n红雪装成香世界，悠悠。\n不是凝妆独倚楼。\n回首忆前游。\n铸错何须说九州。\n月地云阶无限感，休休。\n万点春痕洗旧愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3611,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调南乡子","author":"郑兰孙","text":"香雾透红绡。\n压鬟浓芬上翠翘。\n强起扶头心绪懒，朝朝。\n酒病诗魔两不聊。\n记得放兰桡。\n香暖孤山雪未消。\n怊怅故园云路迥，迢迢。\n江北江南客梦遥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3612,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调南乡子 题美人画幅","author":"郑兰孙","text":"深院杏花天。\n垂柳丝丝未作绵。\n宜雨宜晴人意倦，窗前。\n觅句聊题玉版笺。\n无语耸吟肩。\n懒画眉痕黯自怜。\n闻说江南风景好，华年。\n罗绮争夸富贵仙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3613,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"台城路 壬子七月二十夜纪梦","author":"郑兰孙","text":"铜壶莲漏声频滴，蓉枕夜凉初倦。\n酒力才消，愁肠暂解，梦到何方庭院。\n花如人面。\n看曲曲银屏，碧天云汉。\n玉宇琼宫，神仙莫是旧时眷。\n低徊者般依恋。\n奈怯怯柔魂，晓风吹转。\n翠幕灯昏，鸭炉香淡，零落钿蝉金燕。\n琉璃匣畔。\n怕弹指华年，等闲偷换。\n闷压鸳衾，袖罗松宝钏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3614,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"一剪梅 病骨初痊，离怀易触，因寄夫子皖江信，匆匆附书于尾","author":"郑兰孙","text":"病骨迎寒瘦不支。\n倚著床儿。\n偎著衾儿。\n不言不语强支頣。\n想起行期。\n望到归期。\n江阔天空雁倦飞。\n雨也霏霏。\n雪也霏霏。\n小窗风静篆烟微。\n烛剪窗西。\n人矣窗西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3615,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"转应词 寄禾中孙葆麓弟","author":"郑兰孙","text":"明月。\n明月。\n记照还乡时节。\n扁舟小住鸳湖。\n惆怅天涯隙驹。\n驹隙。\n驹隙。\n回首俊游愁绝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3616,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"如梦令 题秋海棠便面","author":"郑兰孙","text":"露湿玉阶时候。\n妆点秋容消瘦。\n试写画中看，脂晕粉香盈袖。\n知否。\n知否。\n清影怜它如旧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3617,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"沁园春 为梅阁姊丈题美人小幅","author":"郑兰孙","text":"乍展鹅溪，忽惊鸿影，依稀个人。\n看云鬟初拢，淡妆增艳，柳眉如画，远黛含颦。\n浅晕红腮，香笼翠袖，鸦绿单衫稳称身。\n端详处，似当年何地，曾见真真。\n嫣然别样丰神。\n怎无语、含情带薄嗔。\n任千声低唤，未回娇盼，一灯相对，难问仙津。\n飞燕轻盈，绿珠明媚，微步凌波不染尘。\n银屏悄，拟量珠十斛，买取芳春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3618,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇 题断简残篇便面","author":"郑兰孙","text":"检点零星，香薰锦袭留馀馥。\n长篇短幅。\n曾饱文人腹。\n字蚀虫残，何处牙签簇。\n愁重读。\n当年珍惜，为有千钟粟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3619,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 为宗友石画梅","author":"郑兰孙","text":"暗香清绝。\n独抱冰心幽韵别。\n疏影横斜。\n玉作精神雪作花。\n云阶月地。\n回首孤山添客思。\n写向窗前。\n疑是飞来姑射仙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3620,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 写扇头菊花，为周紫卿姻嫂妇人作","author":"郑兰孙","text":"重阳时候。\n帘卷小窗凉乍透。\n弄粉调脂。\n试吮霜毫点染迟。\n晚香幽艳。\n雅韵三秋应独占。\n一握风清。\n遥企芳仪未识荆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3621,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 宗友石嘱题其友人画红楼梦歌伶纨扇","author":"郑兰孙","text":"即空即色。\n幻境荒唐人不识。\n恨海情天。\n黄土朱颜尽可怜。\n韶华难驻。\n几个聪明能觉悟。\n曲度云屏。\n多少红楼梦未醒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3622,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"明月生南浦 题钱奎卿诗词集","author":"郑兰孙","text":"携来戛玉敲金句。\n不弃荒芜，嘱我从头注。\n价重鸡林云锦护。\n闺中窃恐涂鸦误。\n回环雒诵匪朝暮。\n一爽尘襟，似嚼寒梅素。\n想见吟成夸七步。\n珊瑚笔底花常吐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3623,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"明月生南浦","author":"郑兰孙","text":"评花醉月才人事。\n倚马千言，独树骚坛帜。\n开府参军多逸思。\n清新别具天然致。\n琳琅一卷藏遥笥。\n丽句仙心，密密珍珠字。\n此日胸存湖海志。\n它年风送摩天翅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3624,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"明月生南浦","author":"郑兰孙","text":"新声响遏穿云裂。\n郑重题笺，字字霏香屑。\n凤吹鸾鸣清韵别。\n艳花风舞回琼雪。\n西窗有客堪愁绝。\n回首蟾光，几度圆还缺。\n不尽羁怀增感咽。\n长生何处求仙诀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3625,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"明月生南浦","author":"郑兰孙","text":"百篇斗酒文何绮。\n好句拈来，写遍银光纸。\n午梦未成推枕起。\n卷帘读向西风里。\n骊珠一串差堪拟。\n楚客工愁，写出愁如许。\n阶下秋花凉玉蕊。\n薜萝烟冷怀湘水。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3626,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"明月生南浦","author":"郑兰孙","text":"自怜憔悴低飞翮。\n宦海浮沉，往事馀鸿迹。\n西子湖边烟水碧。\n平山堂下繁花易。\n而今又作东皋客。\n百感中来，天地为之窄。\n只合逃禅聊自适。\n药炉经卷虚堂夕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3627,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"明月生南浦","author":"郑兰孙","text":"雨过银屏风暗度。\n云洗天空，又见冰轮吐。\n窗下水沉香细护。\n五铢衣薄凉生素。\n拟欲报琼还又住。\n几度裁笺，自愧难追步。\n减尽吟怀无好句。\n宵深自把兰釭炷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3628,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"台城路  已酉正月十三日哭次女通儿","author":"郑兰孙","text":"八年绕膝今成梦，伤心不堪回首。\n掌上珠沉，怀中月冷，恰是烧灯时候。\n韶光依旧。\n叹一现昙花，罡风吹瘦。\n盼尔重来，今生已矣那能彀。\n聪明怎偏不寿。\n检断纸零笺，泪痕盈袖。\n飘渺泉台，凄凉人世，几个黄昏清昼。\n茶前饭后。\n每误唤儿餐，寸心酸透。\n空奠椒浆，冥途知也否。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3629,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"台城路 哭山云侄","author":"郑兰孙","text":"朝来忽接惊心报，忆别光阴非久。\n济世才华，匡时抱负，天不假其年寿。\n关山回首。\n痛病骨支离，吟笺犹袖。\n此语凄凉，予肠断矣泪如豆。\n记送归舟时候。\n感往日书来，殷勤问又。\n煮茗清谈，题笺和韵，正是小庭春昼。\n而今知否。\n叹泉路茫茫，空浇残酒。\n为赋哀词，衷怀已酸透。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3630,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"台城路 寒窗人悄，雨夜灯昏，黯黯离愁，盈盈客思，信笔赋此，以写闷怀","author":"郑兰孙","text":"雨声不尽离人恨，宵来倍添情思。\n抱影回灯，偎衾卸髻，待睡又还休睡。\n消红减翠，叹聚散匆匆，泥人清泪。\n缩地无由，柔肠不饮已如醉。\n黄昏悄然门闭。\n正瓶花玉冻，炉烟香细。\n漏永寒添，帏低风峭，谁识此时滋味。\n愁来怎避，想秋月春花，碧窗幽意。\n下九初三，予怀渺天际。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3631,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"台城路","author":"郑兰孙","text":"年来憔悴腰围减，无眠每看侵晓。\n锦幔围香，银篝倚玉，风雨送春归早。\n天涯芳草，问别后而今，怎生怀抱。\n煞是无聊，屋梁月落画屏悄。\n俊游回首堪忆。\n忆酒痕碧凝，烛花红小。\n篆袅清愁，尘封匣镜，丝鬓催人易老。\n相逢最好。\n奈地北天南，梦云难到。\n欲寄音书，双鱼江上杳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3632,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 其一 送别","author":"王士禛","text":"送客江船。\n孤帆点点没天边。\n却上高楼临极浦。\n日暮。\n一线春流如碧玉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3633,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其二","author":"严绳孙","text":"尽日风吹到大罗。\n金堂消息见横波。\n暖云香雾奈伊何。\n犹是不曾轻一笑，问谁堪与画双蛾。\n一般愁绪在心窝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3634,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其三","author":"严绳孙","text":"窣地潜窥近画阑。\n玉人心性得应难。\n全身今日付郎看。\n倚处暗听莺语怯，携来私讶玉纤寒。\n莫教人事更摧残。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3635,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其四","author":"严绳孙","text":"隙影馀香望未赊。\n为谁惆怅似天涯。\n紫兰重院谢娘家。\n生小晕眉临却月，近来书格爱簪花。\n麝煤茧纸映轻纱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3636,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 其二 送别","author":"王士禛","text":"欲去难留。\n蜻蛉一叶木兰舟。\n细语断肠人竟去。\n何处。\n新妇矶头烟水绿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3637,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其五","author":"严绳孙","text":"绿拥红遮恼暗期。\n慧心无处不先知。\n凤屏东畔独来时。\n忍待成烟怜紫玉，敢誇能事比红儿。\n等閒踪迹易猜疑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3638,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其六","author":"严绳孙","text":"瘦损腰支不奈愁。\n扇欹灯背晚庭幽。\n不如眠去梦温柔。\n昨夜凉风生玉砌，旧时明月在兰舟。\n一生真得几回眸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3639,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙","author":"严绳孙","text":"腻粉无端退蝶翎。\n赤僧偷眼是蜻蜓。\n春光先过短长亭。\n安得手持修月斧，愿将身作护花铃。\n不堪风雨涴丹青。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3640,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其一","author":"严绳孙","text":"江南好，蟹浦画难如。\n春酒连船浮竹叶，春厨三月有鲥鱼。\n只合浦边居。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3641,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虞美人","author":"严绳孙","text":"征帆只是悠悠去。\n去也知何处。\n泪痕休渍别时衣。\n弹与烟鸿犹得向南飞。\n月华几夕清如洗。\n料得卿归矣。\n暗愁如雾又黄昏。\n有个盈盈相并说游人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3642,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"临江仙","author":"严绳孙","text":"试问吴宫人去后，绮罗多少星霜。\n一声渔笛散横塘。\n虎丘今夜月，犹为照真娘。\n记得霓裳花底见，春风几度思量。\n生公石上旧年芳。\n夜寒莲漏永，清影在回廊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3643,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"小重山  桂花","author":"严绳孙","text":"一夜檀心怨广寒。\n西风吹不尽、小窗闲。\n汉宫黄额画来难。\n珠帘卷，惆怅夕阳山。\n可记晓妆残。\n有人亲插与、鬓云弯。\n露华依旧湿阑干。\n何曾是，寂寞泪珠弹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3644,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"一剪梅","author":"严绳孙","text":"款抱多情诉断肠。\n生向愁乡。\n死向柔乡。\n鸳鸯魂梦几时双。\n月满横塘。\n风满瞿塘。\n红浪翻衾絮语长。\n赢得商量。\n怕得思量。\n可堪银汉是红墙。\n心上檀郎。\n陌上萧郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3645,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花","author":"严绳孙","text":"青琐帘前人惜别。\n未许牵衣，较比牵衣切。\n一曲阳关初唱彻。\n相看本是明明月。\n宛转征衣金粟尺。\n心字香温，纤手流苏结。\n梦里彩云留不得。\n西风吹过黄花节。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3646,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感皇恩•咏镜","author":"董以宁","text":"有福共婵娟，相依白首。\n看尽双蛾似垂柳。\n此中何处，有个人儿争瘦。\n笑效颦难效、肠回九。\n春尘飞处，有时昏黝。\n拂拭红绵劳玉手。\n芙蓉映入，疑是潇湘清浏。\n怪东风起处，吹难皱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3647,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花 怀春","author":"吴琪","text":"澹月溶溶花映绿。\n琴底离愁，叶落相思曲。\n频整罗裳檀钮束。\n碧纱明灭红膏烛。\n玉漏声声催夜促。\n斗帐莲钩，半挂鸾绡幅。\n倚枕梦成风晓触。\n翠屏斜景窗前竹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3648,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 暮春","author":"储氏（成学室","text":"紫燕双双绕画梁。\n重重朱户锁斜阳。\n深闺独坐绣鸳鸯。\n芳草盈阶侵砌绿，落花满院隔帘香。\n小园寂寞日偏长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3649,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"长相思","author":"申蕙","text":"月满衣，叶满衣，玉漏初停银汉低。\n砧声到竹扉。\n事已非，人已非，满目凄凉何日归。\n雁沉梦又稀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3650,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆王孙 秋夜","author":"吴绡","text":"寒砧风急捣衣秋。\n木落声中人倚楼。\n月午凉阴满地愁。\n恨悠悠。\n一夜江南千里舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3651,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浪淘沙","author":"王朗（仲英","text":"疏雨润青帘。\n花压重檐。\n绣帏人倦思恹恹。\n昨夜春寒眠未足，莫捲珠帘。\n罗袖护掺掺。\n怕拂香奁。\n兽炉香倩侍儿添。\n为甚双蛾长翠锁，自也憎嫌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3652,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹊桥仙 戊子广陵七夕有感","author":"吴山","text":"思量昨岁，秣陵此夕。\n正水阁、风清天碧。\n六朝佳处旧繁华，细草陌、灯红月白。\n今年萍寄，隋宫咫尺。\n叹异代、烟花寥寂。\n情同旅燕起归思，何处是、谢庭王宅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3653,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 月夜怀延公夫子","author":"范姝","text":"庭竹潇潇弄晚风。\n月光如洗露华浓。\n瑶阶花影自重重。\n非爱良宵清不寐，因怜归燕思无穷。\n夜深独倚画楼东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3654,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠吴儒卿时馀将入都 其二","author":"翁同和","text":"我衰不足陈，子老亦可唁。\n颓然一聋翁，颜色为我变。\n劝我及秋行，要得数相见。\n呜呼游子心，一日几回旋。\n装我箧中书，书断不成卷。\n检我箧中衣，衣绽谁与线。\n日月固有时，哀哉亦既练。\n平生轻别离，有泪常默咽。\n惟有告墓辞，百灵共凄恋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3655,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝词二首 其二","author":"吴绡","text":"寒食东风已满城，小枝纤弱拂啼莺。\n东君不惜离人苦，又向前年折处生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3656,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"白梅诗 其一","author":"释敬安","text":"一觉繁华梦，性留淡泊身。\n意中微有雪，花外欲无春。\n冷入孤禅境，清如遗世人。\n却从烟水际，独自养其真。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3657,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"白梅诗 其二","author":"释敬安","text":"而我赏真趣，孤芳只自持。\n淡然于冷处，卓尔见高枝。\n能使诸尘净，都缘一白奇。\n含情笑松柏，但保后凋姿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3658,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"白梅诗 其三","author":"释敬安","text":"寒雪一以霁，浮尘了不生。\n偶从溪上过，忽见竹边明。\n花冷方能洁，香多不损清。\n谁堪宣净理，应感道人情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3659,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"白梅诗 其四","author":"释敬安","text":"人间春似海，寂寞爱山家。\n孤屿淡相倚，高枝寒更花。\n本来无色相，何处著横斜。\n不识东风意，寻春路转差。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3660,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠尹山人和白即题其阴符经注后 其二","author":"释敬安","text":"霞外神情谁复知，苍苍须鬓已如丝。\n春风落魄长沙市，错被人呼老画师。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3661,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"圣母皇太后万寿诗 其一","author":"福临","text":"香花淑节寿阳宫，透户玄云接上穹。\n德俪英皇符帝子，化覃江汉播王风。\n瑶斋瑞应星回电，金戺光浮月贯虹。\n坤厚无疆天下母，宫开嘉乐万方同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3662,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"圣母皇太后万寿诗 其二","author":"福临","text":"拜舞慈宁动晓钟，云璈响彻玉芙蓉。\n仲春晴色开仙杏，上苑祥光茂岱松。\n此日山尊仪瑞凤，千秋坤轴启飞龙。\n欢腾海宇同为祝，常见含饴衍庆重。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3663,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"圣母皇太后万寿诗 其三","author":"福临","text":"和风骀荡拂瑶窗，瑞日曈昽照宝幢。\n时届春阳花纪节，觞开慈寿玉为缸。\n连云半卷银毫细，傍辇遥分雉羽双。\n德协坤仪绵过历，千秋万岁莅多邦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3664,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"圣母皇太后万寿诗 其四","author":"福临","text":"彤墀新柳弄轻丝，正是慈帏诞庆时。\n鸾鹤数群天上至，笙歌几队座中移。\n六宫献寿繁珠珥，万国腾欢进玉卮。\n从此年年增茂祉，萱龄应并大椿期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3665,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"圣母皇太后万寿诗 其五","author":"福临","text":"婺阁晴云近紫微，蓬莱宫阙丽朝晖。\n上林柳嫩莺初啭，禁苑兰新蝶始飞。\n玉女浆壶承沆瀣，仙人膳鼎对芳菲。\n钧天乐奏长春宴，黼衮恒为戏彩衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3666,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"圣母皇太后万寿诗 其六","author":"福临","text":"阊阖宏开近碧虚，琼宫仙乐捧鸾舆。\n盘中火枣迎黄幄，杯底流霞映彩裾。\n恩育普天归圣善，泽深奕叶挽华胥。\n上酬惟有无疆祝，重向筵前诵九如。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3667,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"圣母皇太后万寿诗 其七","author":"福临","text":"仲春春色满京都，熙日和风遍海隅。\n扣砌芝兰承展鞠，琼筵环佩杂笙竽。\n月衔花绶金为镜，露缀丝囊寿作符。\n献颂慈宫人尽乐，年年中外竞山呼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3668,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"圣母皇太后万寿诗 其八","author":"福临","text":"慈宁介祉与天齐，瑶水飞觞自海西。\n万岁甘凝朱实枣，千年香拂紫条梨。\n祥云欲傍歌筵驻，候鸟还迎舞队低。\n最喜春光浓似酒，普将仁寿锡烝黎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":3669,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]