[{"title":"九隘","author":"玄烨","text":"合沓群峰接，潆洄九隘通。\n片云晴作雨，高树午多风。\n碛近扶珠幰，沙平骤玉骢。\n凌歊何用筑，三伏杪秋同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36858,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"塞外对雨","author":"玄烨","text":"奋雷殷殷鸣大泽，飞雨千山万山白。\n草色花香濯更新，荒冈处处流泉脉。\n回望神京接塞云，雨声应得四郊闻。\n黍苗翼翼平畴远，多少农人话夜分。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36859,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"红川","author":"玄烨","text":"紫塞红川接上京，昼閒雉尾暑风轻。\n茅茨不改阶三尺，台殿何须筑九成。\n谷鸟群飞林欲暮，边花齐发雨新晴。\n试看属国欢娱日，大漠虚烟处处生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36860,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"驻跸兴安八首 其一","author":"玄烨","text":"祖德隆三后，天心廓九围。\n讴歌通毳幕，风雨想戎衣。\n一自车书合，长看职贡归。\n黄图无内外，时迈有光辉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36861,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"驻跸兴安八首 其二","author":"玄烨","text":"特奉仙舆出，晴峦驻羽旄。\n风多停彩扇，驿远进冰桃。\n丽草金莲涌，浓阴碧树高。\n墉台新月上，广乐奏云璈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36862,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"驻跸兴安八首 其三","author":"玄烨","text":"重岭叠云烟，旌旗拂塞天。\n草香薰翠幄，花暖接红川。\n雁碛长城外，龙荒胜地传。\n回瞻亭障远，千里抱幽燕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36863,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"驻跸兴安八首 其四","author":"玄烨","text":"六月浮埃净，高居暑气消。\n千山低接帐，万木迥凌霄。\n地拥边沙阔，天临塞曲遥。\n封章达行在，银烛秉凉宵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36864,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"驻跸兴安八首 其五","author":"玄烨","text":"虎戟閒清候，逍遥览物华。\n烟笼千树柳，暑发四时花。\n风土暄凉异，山川道里赊。\n濯枝新雨歇，皎皎散飞霞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36865,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"驻跸兴安八首 其六","author":"玄烨","text":"地脉连荒服，山形赴上陉。\n炎歊移月令，分野别星经。\n桦屋参覃白，松林断续青。\n云沙一万里，属国尽来庭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36866,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"驻跸兴安八首 其七","author":"玄烨","text":"边云澄霁色，山翠点行衣。\n马引雕弓过，禽连羽箭飞。\n旌旗开一面，草树入长围。\n我武当蒐狩，非因耀德威。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36867,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"驻跸兴安八首 其八","author":"玄烨","text":"紫塞行巡日，雕舆问俗年。\n大庖陈折俎，仙醴秩初筵。\n屏翰金汤壮，光华赐予宣。\n示慈良有意，裒对在敷天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36868,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"巡历塞北杂咏四首 其一","author":"玄烨","text":"叠嶂层崖一线开，草深径路绝尘埃。\n龙沙雨后滦河水，日夜朝宗入塞来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36869,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"巡历塞北杂咏四首 其二","author":"玄烨","text":"云开灌木万山清，缥缈前旌拂晓星。\n漫道穷荒人迹少，几家烟火簇边庭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36870,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"巡历塞北杂咏四首 其三","author":"玄烨","text":"职方风土有遗书，问俗今还一驻车。\n禾黍近来耕稼满，烟锄云锸遍新畬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36871,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"巡历塞北杂咏四首 其四","author":"玄烨","text":"塞北风多露气凉，幔城坐听漏声长。\n只今六月浑无暑，已见飘来木叶黄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36872,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杨川","author":"玄烨","text":"塞柳多于荠，清川逐望平。\n西风吹几日，碎叶欲成城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36873,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"细河","author":"玄烨","text":"一水沙冈外，回流甲帐前。\n日长时饮鹿，风至忽闻蝉。\n棕叶铺凉殿，松花落细旃。\n从来销夏地，未胜此中偏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36874,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"塞北早秋","author":"玄烨","text":"万马边声合，千旓障口开。\n霜威随出塞，秋色壮登台。\n雁度连营去，鹰呼绝巘回。\n苍茫云海月，永夜照龙堆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36875,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"兴安夜","author":"玄烨","text":"连峰横亘塞东西，缇幕高临百尺梯。\n坐觉银河天际近，仰看珠斗夜深低。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36876,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"次杨岭北","author":"玄烨","text":"半岭黄云合，新凉画角闻。\n羱羊沙草外，落日自为群。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36877,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过团河","author":"玄烨","text":"远水团沙白，温风绝塞收。\n三星流火夕，已拥翠云裘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36878,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"次石山","author":"玄烨","text":"凉生旌羽露华漙，画角声高夜未阑。\n行幄不知三伏过，仗前翻觉六军寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36879,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"尖峰山谷口作","author":"玄烨","text":"塞山秀出亦娟娟，细路穿林碧磴悬。\n却为晚来飞雨过，数峰横翠入寒烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36880,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"三道河晚望","author":"玄烨","text":"碛树隐雾深，河流带沙浅。\n不须朔吹高，先有飞蓬卷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36881,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"黄草川","author":"玄烨","text":"烟沙一片塞天围，旧说秋高苜蓿肥。\n今日边屯皆乐土，茅檐松火接金微。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36882,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"回銮抵古北口","author":"玄烨","text":"黄谷清河古戍间，銮车此日省方还。\n长林曲抱千溪水，小径斜通万仞山。\n地扼襟喉趋朔漠，天留锁钥枕雄关。\n时平不用誇形胜，云物秋澄斥候閒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36883,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"中秋日闻海上捷音","author":"玄烨","text":"万里扶桑早挂弓，水犀军指岛门空。\n来庭岂为修文德，柔远初非黩武功。\n牙帐受降秋色外，羽林奏捷月明中。\n海隅久念苍生困，耕凿从今九壤同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36884,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"是夜对月再成绝句","author":"玄烨","text":"明月中秋节，驰书海外来。\n自今天汉上，万里烟云开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36885,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋日再过阜平","author":"玄烨","text":"春经阜平县，夹道多榛杞。\n雉堞久倾颓，郛郭仅遗址。\n耆老遮马前，其言质且俚。\n土硗愿力田，三时事耘耔。\n所苦井税输，道远越山水。\n闻之切痛瘝，宁尔在干止。\n有司近拊循，疮痍庶能起。\n十室忠信存，何况境百里。\n郊圻戒申画，风土亦洵美。\n问俗此重来，居民咸色喜。\n易彼蒿与莱，荒涂渐成市。\n经野得良图，可以喻治理。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36886,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"再驻龙泉关","author":"玄烨","text":"高临晴雨外，绝磴似凌空。\n节物经冬异，关山对月同。\n龙泉冰未白，雁塞叶初红。\n历历曾游地，香台在眼中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36887,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"冬日重登清凉山","author":"玄烨","text":"紫府名山忆旧踪，招提驻䍐认云松。\n阴崖尚有春时雪，落日仍听下界钟。\n塞远浑河寒更白，林疏恒岳翠逾重。\n祝釐交叶人天庆，银榜新题遍五峰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36888,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏马","author":"玄烨","text":"岐阳方较猎，騕袅尽龙媒。\n仗下黄金勒，横秋号逸材。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36889,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"初冬自五台回次日雪","author":"玄烨","text":"鸣銮多霁日，停旆雪纷纷。\n色向寒初积，声宜静里闻。\n捲帘山忽近，扫石径犹分。\n却忆清凉界，峰连万壑云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36890,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"盆中橘实甚繁咏此","author":"玄烨","text":"厥包禹贡自扬州，作颂骚人楚泽留。\n争似青条朱实好，移来满树洞庭秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36891,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾平告祀孝陵有述","author":"玄烨","text":"缵武平瀛海，诹辰谒寝陵。\n翠微千嶂拱，紫气五云凝。\n圣德光垂裕，神谟大显承。\n乾坤资翕辟，日月象升恒。\n奕世讴歌集，多方历数膺。\n远犹思燕翼，盛业想龙兴。\n卉服皆来享，鲸波自此澄。\n明禋稽旧典，万?肃尝蒸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36892,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉河春水","author":"玄烨","text":"春回冻解玉河清，潋滟晴光绕凤城。\n翠岭雪消新涨阔，绿杨风动晓波平。\n派分星海千重远，色映银潢万里明。\n欲挽朝宗无限水，遍流膏泽慰苍生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36893,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"仿二王墨迹","author":"玄烨","text":"春暮芳菲满禁林，鸾笺暇展学来禽。\n银钩运处须师古，象管挥时在正心。\n案上露凝铜雀润，帘前花照墨池深。\n却思?篆原羲画，精理图畴细讨寻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36894,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"紫光阁","author":"玄烨","text":"政閒多豫日，别馆偶留连。\n草绿含春气，花红带晓烟。\n鸣禽听绕树，新水看浮船。\n物理何曾息，从容忆抚弦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36895,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夜","author":"玄烨","text":"良夜观图史，浑忘刻漏深。\n月流金殿影，花转玉阶阴。\n追琢崇民则，居稽长道心。\n缅怀皇古治，四海遍讴吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36896,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"流杯亭晚眺有怀","author":"玄烨","text":"霁宇开初夏，临池晚景鲜。\n流觞观宇宙，列籍念桑田。\n飞絮缘窗起，閒花傍槛妍。\n读书新月下，讲道勉尧篇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36897,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晓起再赋","author":"玄烨","text":"胜地堪修褉，斯亭乃得名。\n颇饶松竹趣，无待管弦声。\n一水涵天象，三阳畅物情。\n政馀耽静赏，吟罢听流莺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36898,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏日水云榭闻梵声","author":"玄烨","text":"水榭周遮积翠苔，薰风拂处午云开。\n忽听梵诵惊残梦，疑是金绳觉路来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36899,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"偶成","author":"玄烨","text":"石岸众芳静，斜阳柳色边。\n挥毫意独远，鱼跃在深渊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36900,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"瀛台","author":"玄烨","text":"岁序开炎节，离宫绕翠微。\n莲香闻讲席，柳色映垂衣。\n物阜风光好，时清奏牍稀。\n罢朝鹓鹭散，花下佩声归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36901,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"塞外省览风俗","author":"玄烨","text":"莫道岩关险，要荒总一家。\n戍楼无鼓角，战垒是桑麻。\n野静知民乐，时清见物华。\n林中归径晚，旌旆满烟霞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36902,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"再至红川避暑","author":"玄烨","text":"塞外留銮跸，长林帐殿幽。\n乍看南火历，已动北山秋。\n露冷轻葵箑，花寒御绮裘。\n重来欣胜赏，斯地即丹邱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36903,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"红川秋兴","author":"玄烨","text":"俛视八方尽，高天峻岭分。\n秋风起孤韵，日色下溪云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36904,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"回銮至鳍鬣口秋雨初霁对月","author":"玄烨","text":"纤月高林动，辉辉古塞长。\n冰轮初濯露，桂影欲飘香。\n乌鹊声频起，关河色共凉。\n旌门吟眺远，万国自清光。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36905,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏史四首 其一","author":"玄烨","text":"鸿钧运元气，万汇无私恩。\n上德贵醇闷，容覆如乾坤。\n熙熙康衢老，作息循晨昏。\n耕凿食其力，安知帝德尊。\n在宥物自理，巧历难为言。\n下览商周际，颂声亦已繁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36906,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏史四首 其二","author":"玄烨","text":"三田岁毕举，用以荐明禋。\n圣王戒暴殄，郊薮游麒麟。\n虞罗张复解，原野气已春。\n六合岂不广，一面何逡巡。\n亳都百里间，旷如天地仁。\n宽政逮毛羽，况乃蚩蚩民。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36907,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏史四首 其三","author":"玄烨","text":"轩皇访后牧，相道光璿枢。\n精诚契冥漠，在古岂有诬。\n巍巍兴王佐，竟与梦寐符。\n天意靖殷邦，岂为荣一夫。\n缅彼耕莘叟，后有版筑徒。\n试观说命篇，典则追三谟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36908,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏史四首 其四","author":"玄烨","text":"尚父抱奇略，壮龄运不偶。\n一竿清渭滨，经纶在其手。\n志欲网九州，吞舟非所取。\n卜兆示先几，龙螭载车后。\n白旄师既陈，青社符还剖。\n伟哉八百基，肇自一钓叟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36909,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"仇英青绿画","author":"玄烨","text":"流莺百啭起烟槐，细雨油云点翠苔。\n松竹青青山色静，游人倚杖尚徘徊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36910,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"东巡出都作","author":"玄烨","text":"阊阖来天风，玉仗排双凤。\n乔岳耸高标，巡方翠华动。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36911,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晾鹰台集蒙古诸部落慰劳遣之","author":"玄烨","text":"秋尽高原霁景清，远人马首颂巡行。\n九经自重怀柔意，欲使遐陬识治平。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36912,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"河间即古瀛州地","author":"玄烨","text":"新霜来朔气，纳稼满西畴。\n省敛因农暇，观风廓远猷。\n箕躔分冀野，舆地古瀛州。\n驻辔郊坰外，斜阳下堞楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36913,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"景州观开福寺塔","author":"玄烨","text":"涌塔高凌汉，穹隆拱法筵。\n虚铃含远籁，密宇绕寒烟。\n不问三车法，空劳七宝悬。\n偶过成小憩，漫比布金田。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36914,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"次德州即事","author":"玄烨","text":"近郭人烟集，遥天月上初。\n新寒添夜漏，不寐坐看书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36915,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"九河故道","author":"玄烨","text":"野树迷深岸，荒荆露浅沙。\n还思乘四载，岂效泛浮槎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36916,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"平原","author":"玄烨","text":"冬晴柳叶未落，潦尽寒潭初清。\n龙镳千骑万骑，雁队一声两声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36917,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渡济水","author":"玄烨","text":"晓渡更临济水，野风时捲霓旌。\n几曲寒流荡漾，十月舆梁始成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36918,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"巡幸东省黎庶拥马瞻拜命诃警者弗禁得以察其疾苦","author":"玄烨","text":"东来端为重民生，不事汾阴泰畤名。\n井里俨存齐国俗，田畴还忆历山耕。\n暂宽羽骑钩陈卫，一任村童野老迎。\n敢道迩言勤访察，止期治理得舆情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36919,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"趵突泉","author":"玄烨","text":"十亩风潭曲，亭间驻羽旂。\n鸣涛飘素练，迸水溅珠玑。\n汲杓旋烹鼎，侵阶暗湿衣。\n似从银汉落，喷作瀑泉飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36920,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"登济南城望华不注","author":"玄烨","text":"百雉城临济水隈，云山环拱接青莱。\n更看瘦削孤峰色，独立亭亭秀作堆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36921,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"登岱","author":"玄烨","text":"岩岩岱岳高无极，攀陟遥登最上头。\n路转天门青霭合，峰回日观白云浮。\n振衣巀嵲凌千仞，骋目苍茫辨九州。\n欲与臣邻崇实政，金泥玉检不须留。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36922,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"百丈崖观瀑","author":"玄烨","text":"悬崖千尺响奔湍，涧道嶒嵘动石澜。\n仿佛清天有风雨，松阴漠漠逼人寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36923,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"岱顶对月","author":"玄烨","text":"夜宿乔岳颠，缥缈近云阙。\n孤高绝尘翳，天外见明月。\n不闻城市喧，惟听空籁发。\n开轩肆遐览，万象争突兀。\n对此心悠然，清梦自超越。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36924,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"汶水吟","author":"玄烨","text":"汶水潺潺清似玉，石涧萦纡行踯躅。\n连山百里入莱芜，松柏绵蒙冬尚绿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36925,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蒙阴晓雪","author":"玄烨","text":"一片寒云向晓封，雪花应候慰三农。\n马蹄碎踏琼瑶路，隔断蒙山顶上峰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36926,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"沂水","author":"玄烨","text":"板桥缇骑度，沙岸野舟移。\n想像二三子，浴沂春暮时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36927,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渡黄河","author":"玄烨","text":"河流九曲迅飞鸿，千里能施润泽功。\n疏凿远怀神禹迹，乘虚快睹满帆风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36928,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"途次网得鲜鱼驰进两宫兼志思慕之诚","author":"玄烨","text":"千里难承玉陛欢，鲜鳞网得劝加餐。\n遥知长信开函日，定荷慈颜一笑看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36929,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晚经淮阴","author":"玄烨","text":"淮水笼烟夜色横，栖鸦不定树头鸣。\n红灯十里帆樯满，风送前舟奏乐声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36930,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]