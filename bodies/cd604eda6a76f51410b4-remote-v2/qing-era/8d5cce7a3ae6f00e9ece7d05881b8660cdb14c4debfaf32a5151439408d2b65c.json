[{"title":"木兰祠","author":"弘历","text":"克敌垂成不受勋，凛然巾帼是将军。\n一般过客留吟句，绝胜钱塘苏小坟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1444,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"圣水盆","author":"弘历","text":"垂崖迸水落丝丝，冬不凝冰事匪奇。\n应为仙家修养法，将临玉女洗头时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1445,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平湖秋月","author":"弘历","text":"春水初生绿似油，新蛾泻影镜光柔。\n待予重命行秋棹，饱弄金波万里流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1446,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"辽阳怀古","author":"弘历","text":"唐宗战垒久成功，管邴曾闻度海东。\n只有千年华表鹤，时看来往白云中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1447,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"如意湖","author":"弘历","text":"塞水恒流此处渟，柳湖莲岛偶募形。\n烟容波态皆如画，属意悠然在杳冥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1448,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"戏题听鹂馆","author":"弘历","text":"清和渐觉绿阴稠，初听林间黄栗留。\n笑我本非高逸者，双柑何必袭风流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1449,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"曲院风荷","author":"弘历","text":"几个田田漾细风，乍看绿叶想花红。\n昆明湖上浮轻舫，六月春光讶许同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1450,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"红叶","author":"弘历","text":"迭嶂青云放晓晴，乍看红叶一枝横。\n徘徊体物难成句，几点玫瑰衬绿琼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1451,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过宝带桥有咏","author":"弘历","text":"金阊清晓放舟行，宝带春风波漾轻。\n孔五十三易疏泄，涨痕犹见与桥平。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1452,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过蒙古诸部落","author":"弘历","text":"小儿五岁会骑驼，乳饼为粮乐则那。\n忽落轻莎翻得意，揶揄学父舞天魔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1453,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过蒙古诸部落","author":"弘历","text":"识路牛羊不用牵，下来群饮碧溪泉。\n儿童骑马寻亡牯，只在东沟西谷边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1454,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过蒙古诸部落","author":"弘历","text":"猎罢归来父子围，露沾秋草鹿初肥。\n折杨共炙倾浑脱，醉趁孤鸿马上飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1455,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"苏堤春晓","author":"弘历","text":"通守钱塘记大苏，取之无尽适逢吾。\n长堤万古传名姓，肯让夷光擅此湖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1456,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨花台","author":"弘历","text":"据阜高台俯井闾，讲经因以得名诸？\n维摩已是为糟粕，梁武真成拾唾余。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1457,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"剑池","author":"弘历","text":"山川宇宙来便有，岂信剑飞画作岩。\n四字宣尼曾不语，惜哉佳境溷愚凡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1458,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柳浪闻莺","author":"弘历","text":"南渡宋家忘北金，相于丝管乐春深。\n新莺百啭非无意，河北由来有故林。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1459,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夏圭秋江风雨图","author":"弘历","text":"雨丝风片远连天，一棹渔舟万顷烟。\n无事买鱼沽酒客，却绕书画米家船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1460,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"射熊","author":"弘历","text":"寥萧玉宇拂秋风，掌样霜锋好射熊。\n却笑汉皇犹赤帝，空输女子是英雄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1461,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"烟溪钓艇","author":"弘历","text":"飘然蓑笠坐船唇，不挈渔僮独理纶。\n傲志羞登隐逸传，钓鱼多有钓名人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1462,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清闲口号","author":"弘历","text":"人言难得是清闲，我略清闲辄赧颜。\n设使乐斯更何虑，满招忧亦在其间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1463,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清河道中杂咏","author":"弘历","text":"迎銮黎庶聚犹多，雨里那曾笠与蓑。\n爱敬真如子于父，可无惠保计如何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1464,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清凉山","author":"弘历","text":"耸翠层峦接碧空，清凉襟袖拂天风。\n石头城一西临望，千古兴亡慨叹中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1465,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"率题","author":"弘历","text":"人夸不似老年象，一笑付之半信疑。\n设使廿年前面目，又何须藉尔夸为。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1466,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"率题","author":"弘历","text":"弗虑己饥弗虑寒，寸心恒为万民殚。\n以兹乐少忙频切，白发羞从镜里看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1467,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菜花","author":"弘历","text":"黄萼裳裳绿叶稠，千村欣卜榨新油。\n爱他生计资民用，不是闲花野草流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1468,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"萨尔浒","author":"弘历","text":"铁背山头歼杜松，手麾黄钺振军锋。\n于今四海无征战，留得艰难缔造踪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1469,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"黄瓜","author":"弘历","text":"菜盘佳品最燕京，二月尝新岂定评。\n压架缀篱偏有致，田家风景绘真情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1470,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"喜鹊","author":"弘历","text":"喜鹊声唶唶，俗云报喜鸣。\n我属望雨候，厌听为呼晴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1471,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"堤上偶成","author":"弘历","text":"运河转漕达都京，策马春风堤上行。\n九里岗临御黄坝，曾无长策只心惊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1472,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"御崇政殿","author":"弘历","text":"碧海曈昽晓日升，金猊风静瑞烟腾。\n元孙黼扆兹重御，列祖威灵实式凭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1473,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鄚州道中作","author":"弘历","text":"土郭犹存古鄚州，人家负郭颇称稠。\n年年四月集药市，风俗应从民便由。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1474,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"翠云屏","author":"弘历","text":"崔巍孤峰削玉华，山枢旁出古槎枒。\n何人解事为镌泐，语凿空犹道女蜗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1475,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题宁远祖氏石坊","author":"弘历","text":"燧谨寒更烽候朝，鸠工何暇尚逍遥。\n若非华表留名姓，谁识元戎事两朝？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1476,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题扬雄甘泉赋事","author":"弘历","text":"甘泉献赋风枫宸，更著剧秦与美新。\n设果出肠明日死，投身天禄又何人？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1477,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题宋宣和池塘秋晚图","author":"弘历","text":"鸂鶒双飞鹭拳独，秋塘位置雅相宜。\n精思设使通为政，五国应无播越时！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1478,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题宋院本金陵图","author":"弘历","text":"几经富庶几离乱，富庶欢娱离乱愁。\n只有秦淮一片月，溶溶无意照千秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1479,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题宋院本金陵图","author":"弘历","text":"琼窗绮榭簇勾栏，蜜意酣情各缔欢。\n官妓遗风自唐宋，政咸何体污衣冠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1480,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题郎世宁画马","author":"弘历","text":"伯乐今难遇，谁空冀北群？\n横风嘶逸韵，意气欲凌云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1481,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题金廷标琵琶行图","author":"弘历","text":"船隐芦洲不见人，四弦风送到江滨。\n主宾僮仆齐倾耳，写出寻声暗问神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1482,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题董其昌天降时雨小卷","author":"弘历","text":"小卷常随行笥中，希逢时雨得相同。\n今朝润景当前证，始觉传神有独工。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1483,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题管道升修竹幽兰图","author":"弘历","text":"袅袅猗猗绿水滨，幽香孤节自相亲。\n世间尽有丹青手，写照端须似此人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1484,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"二月十四日喜而有作","author":"弘历","text":"止戈为武信其然，我泽如春经略宣。\n共喜捷音来玉阙，何殊俘虏自金川。\n番酋路左心倾服，军士行间气倍鲜。\n单骑汾阳休比拟，都因忠赤格穹天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1485,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三月初八日幸圆明园","author":"弘历","text":"秉时御气暮春初，灵沼灵台艳裔舒。\n似毯绿茵承步辇，含胎红杏倚玫除。\n下空回雁无忧弋，画水文鳞底用渔。\n满眼韶光如有待，东风着意为吹嘘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1486,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山店","author":"弘历","text":"山店诛茅亦易成，居民火种复刀耕。\n孳豚处处牢堆石，防虎家家栅树荆。\n粗粝聊安衣食计，逍遥且免市廛征。\n前驱俞骑休呵谯，正欲穷檐悉隐情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1487,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"中元观河灯","author":"弘历","text":"太液澄波镜面平，无边佳景此宵生。\n满湖星斗涵秋冷，万朵金莲彻夜明。\n逐浪惊鸥光影眩，随风贴苇往来轻。\n泛舟何用烧银烛，上下花房映月荣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1488,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"中河","author":"弘历","text":"驻辇近中河，朱栏俯绿波。\n群歌漕运利，永赖圣漠多。\n继述夫何有，遵循敢更过。\n省方得知要，遑复论其他。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1489,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"五福五代堂题句","author":"弘历","text":"敷锡名垂洪范篇，祖功宗德已身肩。\n三朝厚幸双文益，八帙初开五代全。\n苞茂即今看秩秩，旰宵唯是励乾乾。\n奉时布惠宜春日，欣遇多收鲜缓蠲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1490,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"太庙","author":"弘历","text":"左庙遵古制，未遑右社筹。\n入京神主奉，于沈故宫留。\n别现三官祀，閟堂一律修。\n五朝藏册宝，名实正相投。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1491,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"少林寺作","author":"弘历","text":"少林干载寺，少室一房山。\n禅悦偶重叩，秋岩此乍攀。\n树姿纷绮绣，涧响静潺湲。\n却见来时路，轘辕云外关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1492,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"文征明山水","author":"弘历","text":"凭栏俯层阁，空阔恰怡神。\n祛暑松荫老，点秋枫叶新。\n高山森荦峃，流水净涟沦。\n佳客携琴至，应为同调人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1493,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"文渊阁赐茶","author":"弘历","text":"层阁文华殿后峨，昨春庆宴觉无何。\n具瞻楠架四库贮，且喜芸编三面罗。\n十载春秋成不日，极天渊海尚余波。\n待钞蒇事遗百一，月课督程仍校讹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1494,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"冬至斋居偶阅旧稿志怀","author":"弘历","text":"静听迢迢宫漏长，斋居暂屏万机忙。\n那无诗句娱清景，恰有梅梢送冷香。\n案积陈编闲检点，志期旧学重商量。\n灰飞子夜调元律，又喜天心复一阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1495,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卢沟晓月","author":"弘历","text":"茅店寒鸡咿喔鸣，曙光斜汉欲参横。\n半钩留照三秋淡，一蝀分波夹镜明。\n入定衲憎心共印，怀程客子影犹惊。\n迩来每踏沟西道，触景那忘黯尔情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1496,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"古希","author":"弘历","text":"古希希圣未从心，负扆遑云久莅临。\n惟是惕乾励朝夕，戒其玩愒度光阴。\n龙乘不息法一健，象译由来通六音。\n爱乐纷哉向何托，积成三万首余吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1497,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玉澜堂","author":"弘历","text":"又俯西窗蜃，湖天上下空。\n只观铺镜影，辽待迭纨风。\n暖起浮霄蠓，宽栖度岁鸿。\n漫言冰尚冱，澜意满其中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1498,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"由玉河泛舟至万寿山清漪园","author":"弘历","text":"玉泉舟下玉河通，日丽风和波不雄。\n芷白蒲青景有望，鸢飞鱼跃兴无穷。\n清漪水色从新秀，万寿山光即渐融。\n行不须臾吟数首，裴家构思或相同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1499,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"白云寺小憩","author":"弘历","text":"白云深处称禅栖，便访云关一觅题。\n密雪埋溪僧未扫，韶春入树鸟光啼。\n三间静室依然也，五载流阴亦迅兮。\n此去鹫峰应不远，玉丛林里望丹梯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1500,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"立秋日作","author":"弘历","text":"已识山中早晚凉，今朝况复立秋当。\n如何午热为孤注，疑是金官让末光。\n桐叶庭边想影落，草虫砌下觉声杨。\n农占晴雨纷如讼，历验原来亦鲜偿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1501,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"再游龙井作","author":"弘历","text":"清跸重听龙井泉，明将归辔启华旃。\n问山得路宜晴后，汲水烹茶正雨前。\n入目光景真迅尔，向人花木似依然。\n斯诚佳矣予无梦，天姥那希李谪仙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1502,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"再题石鼓","author":"弘历","text":"石鼓韩歌掘臼科，弗知其意所云何？\n兹因考古十之质，爰命图真一有窠。\n慨叹曾充舂杵用，伤形已阅岁年多。\n言行国学历珍弆，重道崇文功不磨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1503,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"回思一律","author":"弘历","text":"践阼回思廿五岁，朝班较我岁都多。\n匆匆卌八春秋阅，忽忽康雍文武磨。\n几个老臣用由我，其余在列长于他。\n蓦然自问率兴事，蒿目焦心愧若何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1504,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"安远庙","author":"弘历","text":"东岭琳宫接，题门各有名。\n匪尊不二法，缘系众藩情。\n佛日迎薰朗，慧云收雨征。\n金川兹武定，安远永销兵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1505,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"扫雪","author":"弘历","text":"扫雪必行赏，仆台早候之。\n未成分寸际，那可饰装为。\n今日素真积，培林泽倍滋。\n天思诚赐我，分惠亦其宜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1506,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"纪实","author":"弘历","text":"失脚落溪癸卯年，衣衫末湿即登船。\n因艰步履盖老耳，弗慎起居为恧然。\n问类冯河答子路，事殊赏节骇忠贤。\n原如君子过而已，纪实防他讹以传。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1507,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西师底定伊犁捷音至诗以述事","author":"弘历","text":"乘时命将定条枝，天佑人归捷报驰。\n无战有征安绝域，壶浆箪食迎王师。\n两朝缔构敢石继，百世宁绥有所思。\n好雨优沾王宇拓，敬心那为慰心移。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1508,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"观钱谦益初学集因题句","author":"弘历","text":"平生谈节义，两姓事君王。\n进退都无据，文章那有光。\n真堪覆酒瓮，屡见咏香囊。\n末路逃禅去，原为孟八郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1509,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"即景","author":"弘历","text":"即景为题信口拈，山庄乐事实无厌。\n苍麋岩际行行见，红叶林间渐渐添。\n碧宇云稀天廓落，寒潭潦尽水沉潜。\n讵惟揽结供吟兴，静会端知理趣兼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1510,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"孝贤皇后陵酹酒","author":"弘历","text":"那能恝尔去，仍趁便而来。\n言念曾齐案，奚堪更酹杯！\n草犹逮春绿，松不是新栽。\n旧日玉成侣，依然身傍陪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1511,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"泛月","author":"弘历","text":"泛月宜何处，山庄景最新。\n夏宵含飒爽，塞水漾明沦。\n鹤唳孤松顶，鹿寻曲涧滨。\n锤峰玉台迥，温峤早痴人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1512,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏白玉如意","author":"弘历","text":"和阗供岁供，制器玉工闲。\n虽曰来之易，能忘获以艰。\n新年符吉兆，代语得心闲。\n永愿洗兵马，休言致白环。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1513,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏煎盐者","author":"弘历","text":"一历篷芦厂，载观盐灶民。\n樵山已遥远，釜海亦艰辛。\n火候知应熟，卤浆配欲匀。\n可怜终岁苦，享利是他人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1514,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岳钟琪入觐诗以赐之","author":"弘历","text":"剑佩归朝矍铄翁，番巢单骑志何雄！\n功志淮蔡无惭李，翼奋渑池不独冯。\n早建奇勋能鼓勇，重颁上爵特褒忠。\n西南保障资猷略，前席敷陈每日中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1515,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"林下戏题","author":"弘历","text":"偶来林下坐，嘉荫实清便。\n乐彼艰偻指，如予未息肩。\n炎曦遮叶渡，爽籁透枝穿。\n拟号个中者，还当二十年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1516,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"河南巡抚雅尔图奏进谷穗盈尺","author":"弘历","text":"民天伊古重，宵旰为祈年。\n豫省灾伤后，西成企望虔。\n喜看盈尺穗，俨历有秋田。\n稍解吾民愠，披薰一畅然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1517,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]