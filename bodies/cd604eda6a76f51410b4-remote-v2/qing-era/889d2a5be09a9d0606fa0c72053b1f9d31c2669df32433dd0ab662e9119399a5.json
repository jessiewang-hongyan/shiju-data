[{"title":"晤魏石生年丈","author":"杨思圣","text":"相见何禁感慨频，应怜拙宦久风尘。\n身名肯使惭知己，尊酒重来对故人。\n里巷烟霞还似旧，长安花柳几回新。\n迢迢又逐征轺发，敢拟高眠伴隐沦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5608,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过七里滩","author":"朱之锡","text":"谢公诗境好，到此意超然。\n水外疑无地，山中小有天。\n棹舟时罄折，出峡又规圆。\n七里容消遣，石尤风与便。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5609,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闻吴粲叟学使辑匡庐志寄诗索之","author":"朱之弼","text":"闻道匡庐飞盖时，闲寻图籍费周咨。\n亭皋细酌濂溪水，石室亲摹大禹碑。\n鲍谢清晖看振策，白苏逸韵羡摛辞。\n怜余素有烟霞癖，展卷终期慰所思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5610,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过石仲生斋看竹","author":"傅维鳞","text":"懒我曾多事，栽松始出阑。\n怜君青眼共，喜借绿筠看。\n雨色凝新翠，山光割暮寒。\n隔篱才数武，日得醉来观。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5611,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渡龙冈河","author":"傅维鳞","text":"驱马渡龙冈，初晴波益长。\n雨多新草绿，秋重远林黄。\n城郭依沙岸，人家带夕阳。\n不须生别叹，犹自在吾乡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5612,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"睡起","author":"梁清宽","text":"睡起浑无赖，穷愁百事阑。\n云窥虚牖静，风入小窗寒。\n拙宦余三径，浮名悔一官。\n早知农圃好，长啸向烟峦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5613,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"同苍岩公白游城南","author":"梁清远","text":"清流贯云木，水际有人家。\n颓径侵芳草，疏篱罥落花。\n天晴霞散影，野静雁依沙。\n景物看如此，行吟日已斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5614,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋怀","author":"梁清远","text":"浑浑斜日照金台，何处啼乌带影来。\n太液乱流衣带绕，西山晚翠画屏开。\n中原豺虎增郊垒，四野归鸿恋草莱。\n极目关河无限思，漫歌《五噫》有余哀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5615,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"庆都道中即事","author":"艾元徵","text":"尧母城荒秋气高，关山马首敢言劳。\n金门止惜东方朔，洛社谁为左伯桃。\n诗满奚囊凭漫灭，蓬堆潘鬓任萧骚。\n村人近水浑如画，应识轩车逊尔曹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5616,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和坦园相国小台晴望","author":"艾元徵","text":"登临聊尔策方筇，山色初开烟际容。\n为爱晴岚依弱柳，况闻幽梵发清钟。\n春风正拂高低树，冻雪遥连远近峰。\n寒尽共瞻阳律转，陈诗好与绘劳农。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5617,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"八月二十六日西山暂归","author":"石申","text":"去去欲无还，幽忧可驻颜。\n此生贪白业，不死看青山。\n善友能相共，浮云且自闲。\n风尘燕市在，留与鬓毛斑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5618,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日同芝麓诸公集黑窑厂分赋","author":"石申","text":"车马纷城阙，寻秋此地偏。\n路深钟响出，台古烧痕圆。\n老树侵沙苑，饥鹰猎岁田。\n与君期尽醉，休问战争年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5619,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重游龙泉寺","author":"刘鸿儒","text":"溽暑郁我怀，携朋寻高爽。\n出城见南山，幽况夙所赏。\n龙泉久神异，风雨灵泽广。\n别来二十年，老健喜重往。\n密树结层阴，峭壁当沆漭。\n㟏岈䆗窱入，薜萝分披上。\n蹑翠陟其巅，大千指诸掌。\n法王宝地尊，霞光罗万象。\n景趣犹如昔，理会顿殊曩。\n探无悟无极，阅有谢有攘。\n临兹诸缘空，耳目余清响。\n留连恣遐瞩，浩浩神气朗。\n桃源勿劳思，舍此将焉访。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5620,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"云溪观","author":"董笃行","text":"闲坐瀍水旁，正对龙门口。\n三井透天光，森若列星斗。\n钟磬响铮铿，晓日半在柳。\n深洞锁寂寥，丹砂炼已久。\n岭上多闲云，时与白鹤偶。\n举世重黄金，难易仙人守。\n仙人去不还，空余麋鹿友。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5621,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆洛","author":"王无咎","text":"苍苍云树满关河，百战中原涕泪多。\n伊阙时通春草梦，平湖乍听采菱歌。\n天心厌乱亡荧惑，人意还家眷薜萝。\n八月潮来江海动，孤舟高卧有渔蓑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5622,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送宋荔裳按察蜀中","author":"王天眷","text":"法星遥指锦江隈，路入蚕丛鸟道回。\n万里桥边春驻马，百花潭上夜衔杯。\n干戈未久才生聚，井里虽存尚草莱。\n自是随车多化雨，三巴父老望嘘培。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5623,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"草堂落成","author":"蓝润","text":"新辟茅堂桑柘村，二劳山色落柴门。\n莓苔满径封尘迹，萝薜缘墙补漏痕。\n花底营巢来燕子，林根解箨长龙孙。\n三间屋外饶余地，自织青蓑学种园。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5624,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄破尘道士","author":"法若真","text":"桃源风雪断，不得送鹅来。\n玉趾留丹灶，金绳换酒杯。\n山空雏鹤宿，潭隐老龙开。\n新种松千亩，商量去镜台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5625,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"诸城黄来公过访谈地理","author":"法若真","text":"得君说破紫囊筌，玉斧长挥劈野禅。\n自是清谈归叔度，非关读画到龙眠。\n丛峰石色擎珠蕊，大海潮声乱铁泉。\n不识山川调药谱，一天风雨护超然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5626,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送李霖九时由凤翔少参谪汉中","author":"王紫绶","text":"纱笼诗句壁曾留，满目苍凉感旧游。\n函谷主人关令尹，扶风属吏汉诸侯。\n莲花云黑三秦雨，栈道霜红万木秋。\n梦里不知君去远，更随明月到梁州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5627,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"酬张元公中丞自秦抚移豫见怀","author":"王紫绶","text":"八郡诸侯百二同，秦中才罢又天中。\n河流犹带东西陕，云气忽来大小嵩。\n梁苑楼台新挂月，隋堤杨柳细摇风。\n信陵食客多如许，座左犹云待老翁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5628,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登嵩岳绝顶","author":"王紫绶","text":"独倚中天览大荒，西来秋色更苍苍。\n日翻木叶红千顷，雨过芙蓉翠几行。\n玉女寒棂惟皎月，汉皇辇路满清霜。\n回看磴道深无际，转欲凌风渡铁梁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5629,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"喜孙徵君复归夏峰 其一","author":"王紫绶","text":"月出夏峰空，风高乔木冷。\n夜来雪色多，门外添人影。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5630,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"喜孙徵君复归夏峰 其二","author":"王紫绶","text":"白云不在山，松顶一巢间。\n昨夜海风至，翩翩带鹤还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5631,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"旧宫人 其一","author":"王紫绶","text":"旧日常随玉辇游，朝钟暮管夜箜篌。\n闲来细语繁华事，不尽神宗四十秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5632,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"旧宫人 其二","author":"王紫绶","text":"景阳宫井出云鬟，秦帝衣裳卷不还。\n碧玉搔头镌赐字，朝来易米到人间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5633,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过僧舍","author":"吕缵祖","text":"林端梵影插秋天，正在长流夹岸边。\n散步莫疑因病酒，偶来非是为逃禅。\n尘门不禁贫人履，僧榻偏酣高士眠。\n檐际松风波底月，久忘身世隔尘烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5634,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"魏雍伯招游鹿泉诸胜","author":"郜焕元","text":"跨马出西郊，倦眼豁疏放。\n远景带日斜，清游恣元畅。\n秋气下苍嵓，空翠殆难状。\n同行得佳侣，泉石激微尚。\n行看岩岫舒，坐爱流滮漾。\n瞻眺韩侯祠，英风飒甲仗。\n剥藓读残碑，寄兴忽悲壮。\n回望羽人居，丹栱绝壁上。\n虚洞有云封，老树为之障。\n急雨溜层巅，攀烟遵复嶂。\n初寻惊奥奇，径转得平旷。\n中有龙象藏，丹碧郁相望。\n微步惬幽寻，阴洞何年创。\n嵌空入杳窅，白日划光亮。\n造化钟灵异，神工非意匠。\n累累号连珠，透辟绝依傍。\n冰雪泠然入，披襟为神王。\n空亭延翠花，日暮欣跌宕。\n生平丘壑心，对此树高贶。\n愿得休粮居，乘风采瀣沆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5635,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"走笔别程伯建","author":"郜焕元","text":"前年别，城之隈，今年别，江之浒。\n黄鹄高骞野惊翔，苍龙昼立瘦蛟舞。\n沙洲烟草绿茫茫，棕笠泥鞋九日雨。\n欧长卿，李云田，偕子同来送别船。\n别船日暮芙蓉老，满酹清酤问秋昊。\n相逢意气感须眉，二子不言子更悲。\n昨日上书不见收，低头幕府终何为。\n闻君杖策向长安，水落桑乾木叶寒。\n黄金谁荐中涓马，易水空怜壮士冠。\n君不见郎官湖上李白游，至今魂魄尚堪留。\n又不见蓬荆深没楚王台，阴雨啾啾鬼夜哀。\n登祝融，望吴越。\n我欲扶筇鼓柁，上八万之天台，探千年之禹穴。\n安能俯仰随世网，牺牛文身入庙遭羁绁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5636,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夏人叔从禹峰先生为湖南之游 其一","author":"郜焕元","text":"之子湖南去，扁舟意若何。\n白云衡岳满，青草洞庭多。\n幕府裁铙曲，迁人依棹歌。\n只愁扬子宅，蚤暮少经过。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5637,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夏人叔从禹峰先生为湖南之游 其二","author":"郜焕元","text":"草檄真能事，从军亦壮游。\n况逢汉陆贾，同注《晋阳秋》。\n雨幔临湘浦，风帆近岳楼。\n赖君传古迹，赋压楚江头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5638,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送姜铁夫南归","author":"郜焕元","text":"白首家无定，青山尔又归。\n京华词客贱，秋雨故人稀。\n钟动催霜叶，潮平载夕晖。\n鉴湖南月好，为我选渔矶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5639,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"申凫盟见访","author":"郜焕元","text":"自枉高人驾，悠然淡旅情。\n狂真疏礼法，老益厌诗名。\n万树霜前色，连砧苑外声。\n乡心剧岁晚，迟我碧山耕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5640,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"访赵锦帆于报国寺解官南归怅然有怀","author":"郜焕元","text":"白首官仍谪，黄河客竟还。\n春明无故旧，秋色冷乡关。\n叶落松房定，风吹海月闲。\n苏门归倘遂，同钓碧溪湾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5641,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晤张海旭","author":"郜焕元","text":"尚记南奔日，艰危借一舟。\n孤帆淮浦月，百战岛门秋。\n身世还青眼，山河竟白头。\n草堂尊酒在，万里慰离忧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5642,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄遁山子","author":"郜焕元","text":"别后俱多难，归来独可怜。\n兴吟吴苑草，泪尽郢门烟。\n万事还乡井，孤身历岁年。\n白头新赋草，零落竟谁传。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5643,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江上逢黄坤五太史","author":"郜焕元","text":"白发承明旧侍臣，天涯沦落晚堪亲。\n箧中岁月存诗史，世外江湖有钓缗。\n往事伤心辞洛日，他乡垂老避秦人。\n开元朝士君仍在，听到宫词泪满巾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5644,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赴东壑遥望五龙雪色","author":"郜焕元","text":"径行初日千峰上，俯瞰苍烟一郡西。\n朔塞天连三晋险，晴空雪压五龙低。\n山腰拾级樵争入，树杪盘云岛乱啼。\n万壑乡园吾独往，岭猿溪月待幽栖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5645,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠彭禹峰先生","author":"郜焕元","text":"扬舲五月下蛮方，醉踏江楼草色长。\n公子椒兰新七泽，将军裘带旧三湘。\n君从绛幄论前辈，我向青云认父行。\n万里长缨须蚤系，汉家将相本南阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5646,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠李将军戍楚","author":"郜焕元","text":"铁衣十载临戎日，尚忆围城转战功。\n射虎未闻封李广，雕虫犹复困扬雄。\n千群代马悲笳里，独戍江湖险塞中。\n氛祲扶桑忧不细，捷书蚤寄楚天鸿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5647,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"王幼舆以近诗见贻即有禹州之游作此奉送兼致怀兵使沈绎堂","author":"郜焕元","text":"闲门尽日补烟萝，竹里逢君有啸歌。\n一卷诗才传白雪，三春客又渡黄河。\n风归禹甸山川丽，路入梁园词赋多。\n好问故人东郡长，楼中《八咏》定如何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5648,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过顺德有怀沧溟先生 其一","author":"郜焕元","text":"中原二子盛当时，历下文章晚更奇。\n识得峨嵋天半意，黄榆高处自题诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5649,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过顺德有怀沧溟先生 其二","author":"郜焕元","text":"领袖宗徐气尚骄，秋生郡阁雁萧萧。\n文章未老山河在，词客英灵正可招。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5650,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游香山寺","author":"王伯勉","text":"落日满香山，禅门倍觉闲。\n莲花疑海上，法雨渺云间。\n修竹森丹观，流泉汇碧湾。\n上方钟欲静，尘虑一时删。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5651,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寓斋晚坐","author":"蔡含灵","text":"自笑懒成癖，一官今又闲。\n客疏安用避，门静不须关。\n睡稳高吟后，凉生落照间。\n旷遐诚有分，莫强论时艰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5652,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杂兴","author":"窦遴奇","text":"韝鹰具利爪，攫物厉秋风。\n使不逢狐兔，亦与凡鸟同。\n丈夫当无事，何以异凡庸。\n边徼忽多故，擐甲效从戎。\n灵鹊化金印，旗纛建交龙。\n铭勋膺上赏，晋爵列侯封。\n平时论豪杰，管乐亦无功。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5653,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"仙人","author":"窦遴奇","text":"瑶台十二玉阑干，夜半天阶下紫鸾。\n说是仙人君不信，空留秋色满山寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5654,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"后杂兴 其一","author":"赵宾","text":"日月经天上，光景常新鲜。\n人生一世内，形状倏变迁。\n几日红颜子，鸡皮雪盈巅。\n所以苦志士，决计在深山。\n采药袪诸病，服食学神仙。\n神仙岂易得，无恙尽天年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5655,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"后杂兴 其二","author":"赵宾","text":"散行阅畦蔓，一叶藏一瓜。\n蕊而不实者，满目炫黄花。\n方悟古至人，不苟露英华。\n隆中抱膝客，棘津卖浆家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5656,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄怀苏生紫","author":"赵宾","text":"十载天涯鬓各苍，铜鞮碣石两茫茫。\n关山不隔怀人梦，夜逐东风度太行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5657,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和四弟寄龙膺韵","author":"高玮","text":"兴尽其如返棹何，牵衣暂乞罢耕蓑。\n一瓢春酒孤怀壮，万里青山放眼多。\n岸帻且吟豪士赋，隔墙初奏雪儿歌。\n风光如此不成醉，辜负新条挂薜萝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5658,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过村居和五弟韵","author":"高玮","text":"平桥斜绕小亭西，久不来游路欲迷。\n泛水落花随石转，冲人燕子到帘低。\n酒嫌市酿开邻瓮，壁拂尘封觅旧题。\n暝色催归留不得，莫嗔枝外子规啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5659,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题瞻明壁","author":"高玮","text":"曲曲溪流处处花，绿杨影里有人家。\n谁能载酒听春雨，共踏平桥一道斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5660,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"定州道上","author":"苏宏祖","text":"潦倒书生兴已阑，何缘好梦到渔竿。\n冲霄岂是羽毛满，曳尾曾经道路难。\n侯骨自知非李广，缺唇今竟补方干。\n入官先效蛮娘舞，旧样时人不喜看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5661,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过安庆怀黎天锡","author":"谢宾王","text":"埤堄秋深落木空，十年重听皖江鸿。\n潮声暝接千峰雨，塔顶高盘万里风。\n吴楚上游新组练，中原落日旧艨艟。\n欲商尊酒同心远，惆怅龙门意未穷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5662,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南昌遇赵宪副韫退","author":"谢宾王","text":"青山小队拥纶巾，华发论兵侍从臣。\n十载疏传明主纳，天涯宦似故人贫。\n秋镫乡语听鸿久，行幄人过问字频。\n莫望长安多踯躅，邹枚几见画麒麟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5663,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夏夜","author":"李源","text":"夜月清如洗，冰心托玉壶。\n竹君千个在，石丈一峰孤。\n独酌开青眼，微吟撚白须。\n故人书昨至，远道忆吾徒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5664,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夏日杂言 其一","author":"李浃","text":"长夏敞幽轩，开窗依萝樾。\n燕寝乐虚明，房廊步曲折。\n松响风初来，云归雨乍歇。\n仰视天宇清，林暝山吐月。\n月色孤泠泠，素心托高洁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5665,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夏日杂言 其二","author":"李浃","text":"久雨逢戊晴，戊日雨不止。\n晻晻阴晦凝，四野连蓄水。\n秀颖等浮萍，登场禾生耳。\n爰轸昏垫情，医疮从兹起。\n天行岂不若，难参玄化理。\n怨咨念小人，思艰望君子。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5666,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"天津","author":"李浃","text":"津门连渤海，曲折抱长安。\n食货喧商市，鱼盐乱钓滩。\n鼍鸣潮信早，龙过雨声寒。\n泼剌银刀重，庖人进脍盘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5667,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"彭南溟迁泺上","author":"叶承宗","text":"彭生阀阅子，兼之湖海士。\n意气薄云霄，神情在山水。\n貌物如有神，不独得其似。\n四壁虽萧然，耻以丹青市。\n自子初临泉上游，香毫冉冉画寒流。\n叶郎大笑向人说，泺水新来顾虎头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5668,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赵埠口","author":"叶承宗","text":"长堤密柳板桥连，红蓼花中系钓船。\n渔父狂歌归酒市，高竿挂网夕阳边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5669,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过先贤闵子骞故里","author":"李鸿勋","text":"数十间茅屋，人传闵子家。\n秋风吹不断，满地有芦花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5670,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舒章至","author":"王崇简","text":"经岁犹然识泪痕，幽怀相向各声吞。\n惟余悲感心多愧，无复欢娱事可言。\n勋业漫期新竹帛，风尘可有旧桃源。\n天涯兄弟伤摇落，把臂如君今几存。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5671,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄怀梁公狄内弟流寓宝应","author":"王崇简","text":"念子年来多病侵，鱼潜鸿杳信沉沉。\n奔腾昔日天涯泪，彫落余生岁晚心。\n万里风尘双须短，他乡客梦一镫深。\n何时携手沧溟去，瓢笠潇潇上翠岑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5672,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]