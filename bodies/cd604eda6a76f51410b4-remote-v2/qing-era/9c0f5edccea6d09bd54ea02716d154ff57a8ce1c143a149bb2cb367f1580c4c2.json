[{"title":"行香子 初霁看牡丹","author":"朱中楣","text":"好鸟初耕。\n坐老啼莺。\n桑鸠唤妇晚窗明。\n牡丹初放，尚带微醒。\n看青猊白，蓬莱紫，玉楼春。\n雨中过半，些子新晴。\n闲拈小调咏芳卿。\n怕春归早，似笑还颦。\n有荼蘼伴，凌霄侣，惜花人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22250,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"行香子 题陈伯玑浣花居图","author":"朱中楣","text":"半刺羲琴。\n一段巫云。\n轻衫淡染竹根青。\n苍龙斜倚，宝鸭新熏。\n似妆初罢，风初袅，韵初生。\n仙尘遥隔，幸睹芳真。\n何时揽袂羡宁馨。\n秋高月小，花满庭芬。\n期怜香伴，清闺里，共论文。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22251,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"千秋岁 春雪","author":"朱中楣","text":"琼花飘砌。\n点额新妆媚。\n微雨间，轻风起。\n同云迷雁杳，绣阁添香沸。\n囊罄也，惟馀薄酿还堪醉。\n幸识贫滋味。\n衙舍清如水。\n冰欲泮，寒应已。\n心随残梦远，意搅繁英碎。\n春又也，人归不似春归易。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22252,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 读陈相国徐夫人湘蘋","author":"朱中楣","text":"泪眼愁怀，聊只把、芳词翻阅。\n句清新、堪齐络纬，并称双绝。\n字字香传今古愤，行行画破英雄策。\n倩玉箫，吹彻汉宫秋，声声咽。\n离别闷，仍犹结。\n旧游处，燕台月。\n■一番风雨，乱红愁叠。\n玉树森森连紫苑，英才尽是人中杰。\n盼相逢，约略在何年，从头说。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22253,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"愁倚栏令 哭柔嘉姊","author":"钱凤纶","text":"凭栏久，觅芳踪。\n思无穷。\n记得玉钩微步处，印残红。\n小园花醉春浓。\n香馥馥、带惹春风。\n悔煞从前欢宴处，总匆匆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22254,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 早春湖头扫墓","author":"钱凤纶","text":"六桥积雪晴光射。\n萧疏疑是云林画。\n几点远山横。\n一湖春水平。\n墓门斜日静。\n翠竹迎人冷。\n极目总销魂。\n罗巾揾泪痕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22255,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"眼儿媚 与双成弟妇雨窗话别","author":"钱凤纶","text":"一望迷离雨声凄。\n云压暮山低。\n萧萧落叶，嗷嗷哀雁，话到西楼。\n料得今宵人静后，惆怅掩罗帏。\n秋蛩吟罢，残灯灭后，有梦初归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22256,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐 与柔嘉娣宿河渚看梅","author":"钱凤纶","text":"乳莺初啭。\n晓梦梨云断。\n朝日蓬窗创一线。\n个里春光偷换。\n惜春莫为春愁。\n罗浮更约重游。\n记取连床絮语，梅花深处山楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22257,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"摊破浣溪沙 怀亚清","author":"钱凤纶","text":"月落空庭花影迟。\n绣屏欹枕梦回时。\n咫尺城关鸿雁断，即天涯。\n半壁青灯临卫贴，一窗寒雨读陶诗。\n别后深闺无限事，总堪悲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22258,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人 本意","author":"钱凤纶","text":"楚歌画角声声发。\n脆弱边城月。\n八千子弟久从龙，一夜雕鞍金甲、散长空。\n宁教玉碎君王侧。\n血染征袍赤。\n贞魂不肯入关中，岁岁吴江波涨、泣春红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22259,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行 秋暮雨霁，偕柔嘉娣游河渚","author":"钱凤纶","text":"云暗山光，风和竹韵。\n晚来庭院寒成阵。\n玉纤无力整残妆，倩人花下扶蝉鬓。\n为爱登临，顿消愁闷。\n烟霞似与蓬莱近。\n昨宵雨过嫩苔生，归来踏得双鸳润。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22260,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行 秋日偕冯又令过米山堂，时子新痛亡，侄又令复伤仲子，感赋","author":"钱凤纶","text":"罗幕长垂，愁城难破。\n岑岑病怯慵梳裹。\n贫居曲径悄无人，篱门一带秋烟锁。\n邻女传来，香车初过。\n眉峰轻拂云鬟亸。\n相邀花圃共谈心，临流斜倚寒山坐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22261,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹊踏枝 寄长嫂查楣思","author":"钱凤纶","text":"乍暖馀寒春日永。\n未许莺啼，清昼深闺静。\n嫩绿柔黄堆小径。\n晓风催放枝头杏。\n怅望瑶姬仙阙迥。\n数阕新词，镇日和愁咏。\n几曲阑干还独凭。\n夜深月过苍苔冷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22262,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 庚午五日哭母","author":"钱凤纶","text":"犹记春时，新梦破、乳莺初啭。\n曾几日、韶光都尽，骤惊心眼。\n蒲叶欹风寒翠色，榴花著雨垂红瓣。\n最伤情、时物总如前，亲难见。\n悬艾虎，飘金线。\n敲画鼓，轰雷电。\n看儿童绕膝，更教肠断。\n楚些空传骚客恨，江涛似诉曹娥怨。\n愿相逢、角黍入重渊，逢亲面。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22263,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"烛影摇红 送幼鲲弟北上","author":"钱凤纶","text":"潦倒明湖，频年事事伤心臆。\n无端忽又唱骊歌，雁阵分南北。\n岁暮长途作客，整行装、半肩书笈。\n千山雪拥，万壑云连，大江孤楫。\n胜景标题，一枝锦绣江淹笔。\n遥空时有雁南来，凭寄双飞翼。\n何日倦游燕国，赋归来、陶舆谢屐。\n黄莺声里，绿柳阴中，雨蓑烟笠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22264,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"换巢鸾凤 送顾启姬之燕京","author":"钱凤纶","text":"日暖春秾。\n羡双飞彩凤，上国遨游。\n金尊斟别酒，玉版写新愁。\n骊歌未唱泪先流。\n忽轻说乘扁舟去休，也曾念、共绣阁、论文人否。\n携手。\n何日又。\n剪烛窗前，絮语黄昏候。\n吴岫云停，蓟门月落，两地应知眉皱。\n韵事千秋遍传闻，题桥添个文君友。\n钿车宝马，上林看遍花柳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22265,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"水龙吟 怀柴季娴表嫂兼谢画梅","author":"钱凤纶","text":"朱阑曲槛闲凭，松篁掩映深深院。\n丹枫染遍，黄花初放，色深香浅。\n玉案联吟，锦笺分韵，珠玑新璨。\n最无端牧笛，声声起处，催日落，横塘晚。\n别后蒹葭水远。\n正空闺、梨云梦断。\n丹青一幅，天风吹坠，罗浮春满。\n疏影横斜，暗香浮动，毫端如见。\n怕朝来、翠羽双双飞去，莫晶帘卷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22266,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"绮罗香 初夏偕同社寿季娴，凝香室宴集，别后赋谢。","author":"钱凤纶","text":"宿雨飞来，轻云不散，掩映遥山黛色。\n鹤驭凌风，雾髻云鬟微湿。\n倾玉液、翠羽流觞，璨晴霞、珠光盈壁。\n最堪夸、青鸟翩翩，衔将丹诏降层碧。\n避尘小筑书斋，看在梅放竹，携琴枕石。\n何处吹来，天上玉箫铁笛。\n声缓缓、遏响行云，影迟迟、花翻瑶席。\n更相期、月逗前溪，踏歌还绮陌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22267,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十六字令","author":"钟筠","text":"堤。\n畔柳翩跹长短亭。\n行人去，几长见青青。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22268,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 秋闺","author":"钟筠","text":"万籁无声，小园恰是深山静。\n惜花人病。\n懒向雕栏凭。\n月上高枝，枕弄芭蕉影。\n帘栊迥。\n西风绕定。\n挑落灯花冷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22269,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 和杨倩玉“那不教人说可怜”起句","author":"钟筠","text":"那不教人说可怜。\n彩云吹断惜花天。\n娇春杨柳泣朝烟。\n莲子蜂房犹未结，桐丝凤啄已难粘。\n夕阳楼阁水如天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22270,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 初夏","author":"钟筠","text":"开到荼蘼花已残。\n垂帘犹自怯春寒。\n困人时候雨连纤。\n燕子将雏声细细，荷钱虽小叶团团。\n一庭芳草绿如烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22271,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 读余夫人《兰馨集》，偶摘佳句，填词寄怀","author":"钟筠","text":"深深庭院。\n乍卷珠帘朝雨散。\n云外清江。\n花里琵琶应绕梁。\n梦魂飞去。\n却怪韶光留不住。\n远树风微。\n但见青山列画眉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22272,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 前题","author":"钟筠","text":"风来水面。\n片片落花随涧转。\n莺语垂杨。\n佳句题成吐异香。\n曈曈旭日。\n惆怅春风空独立。\n嫩绿残红。\n人在芙蓉水阁中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22273,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 前题","author":"钟筠","text":"菱花娇映。\n巧画娥眉难与并。\n上苑花开。\n无数飞红逐浪回。\n融融淑气。\n袅袅芙蕖初出水。\n燕语流香。\n寂寞重门春恨长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22274,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"阮郎归 送别长姊父夫人","author":"钟筠","text":"临风洒泪唱骊歌。\n啼痕沁薄罗。\n小楼又见雁南过。\n秋风秋雨多。\n思缱绻，怨蹉跎。\n愁肠似掷梭。\n开轩对月问姮娥。\n此情可奈何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22275,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西江月 题海昌陈相国夫人徐湘萍《拙政园词》后。","author":"钟筠","text":"灯火平津阁上，莺花拙政园中。\n五云深处凤栖东。\n一枕辽西幽梦。\n苏蕙回文锦字，班家团扇秋风。\n龙吟鹤和几人同。\n声压南唐北宋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22276,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南歌子 寄四姊吴夫人山容","author":"钟筠","text":"刺绣工夫巧，评棋逸兴赊。\n西园携手看蜂衙。\n无数闲情，都付夕阳斜。\n世事流如水，人情幻似花。\n一庭香雪冷窗纱。\n两地愁怀，应共此些些。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22277,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南乡子 送七姊还海昌","author":"钟筠","text":"细雨动离愁。\n牙尺并刀记小楼。\n不道今宵真个别，难留。\n怪煞风前一叶舟。\n锦字莫沉浮。\n双鲤频看溪水流。\n三尺瑶琴还在壁，凝眸。\n指上宫商叹白头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22278,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"意难忘 春日感怀，寄七妹查夫人","author":"钟筠","text":"晓日烘窗，看柳眠花笑，做尽春光。\n远山横黛绿，碧水卸馀香。\n千叠意、九回肠。\n但抚景凄怆。\n任满庭、红情紫态，蝶乱蜂忙。\n堪伤去路茫茫。\n见寻春士女，逸兴如狂。\n偎花识面去，对月又相将。\n帆影断、暮云傍。\n有归雁成行。\n更那堪、花阴寂寂，月转西廊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22279,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卷上菩萨蛮","author":"孙云凤","text":"玉阶露冷虫声咽。\n珠帘影透玲珑月。\n长夜梦难成。\n秋窗不肯明。\n柳眉花似脸。\n整日深闺掩。\n人立小阑干。\n莺花春正残。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22280,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"诉衷情","author":"孙云凤","text":"红楼梦断晓啼莺。\n绣幕峭寒生。\n二月江南春晚，深巷卖花声。\n苔藓薄，柳烟轻。\n最凄清。\n昨宵风雨，今朝寒食，来日清明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22281,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"孙云凤","text":"小庭日午东风暖。\n絮飞花落春过半。\n乡思隔关山。\n开笼放白鹇。\n夜深灯有晕。\n烟断香初烬。\n玉漏莫教催。\n梦和潮水回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22282,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"孙云凤","text":"旧梦依依睡起迟。\n春慵无力试单衣。\n薄寒天气卖花时。\n细雨轻烟莺百啭，暖风斜日燕双飞。\n画楼东畔小堂西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22283,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"贺新凉 题随园先生归娶图","author":"孙云凤","text":"骢马东风立。\n有丹青、公然留住，小年颜色。\n闲把生绡重展处，脉脉自怜陈迹。\n回首忆、玉堂瑶席。\n故我今吾谁解认，喜妆台、犹有人能识。\n春梦语，感而述。\n金莲宝炬人难得。\n况而今、杖朝已近，尚调琴瑟。\n如此恩荣如此寿，千古人才第一。\n真不羡、蓬莱仙客。\n佳话流传如隔世，念门人、生晚从何说。\n长短句，聊赛责。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22284,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 秋夜同碧梧姊联句","author":"孙云鹤","text":"玉阶人静啼虫寂。\n银屏梦断砧声急。\n疏树带微霜。\n小楼秋思长。\n一窗灯欲烬。\n叶叶西风紧。\n深夜莫凭栏，月高清影寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22285,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"孙云凤","text":"华堂宴罢笙歌歇。\n夜深香袅炉烟碧。\n酒醒小屏风。\n烛花相对红。\n玉钗金翠钿。\n柳叶双蛾浅。\n日午未成妆。\n绣裙双凤凰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22286,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令","author":"孙云凤","text":"帘卷绿窗风定。\n云鬓起来慵整。\n罗袜下阶行，还是去年风景。\n人静。\n人静。\n日午鸟啼花影。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22287,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令","author":"孙云凤","text":"啼鸠一声何处。\n芳草绿迷归路。\n风暖日初长，午倦倚栏无绪。\n春去。\n春去。\n门掩落花红雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22288,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"孙云凤","text":"十二珠帘掩碧窗。\n懒吟慵绣不成妆。\n困人时节日初长。\n湖水雨馀浮鸭绿，柳丝风暖漾鹅黄。\n画船犹记落花香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22289,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十六字令","author":"孙云凤","text":"明。\n雨过南轩月影横。\n疏帘卷，灭烛坐调笙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22290,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南乡子 与仙品妹话别","author":"孙云凤","text":"无计可商量。\n离思千重泪万行。\n庭院晚来天欲雨，风狂。\n明日扁舟莫渡江。\n十二碧纱窗。\n袅尽金炉小篆香。\n说著旧游心转闷，难忘。\n雪月花时最断肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22291,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐 与仙品妹联句","author":"孙云凤","text":"月明风细。\n云淡鱼鳞碎。\n身倚阑干心似醉。\n种种别离滋味。\n今宵烛剪窗纱。\n明年书寄天涯。\n帘幕愁深燕子，烟波梦绕芦花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22292,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8c