":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22298,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇","author":"孙云凤","text":"折柳尊前，离亭歌罢西风冷。\n路遥酒醒。\n立尽斜阳影。\n流水行云，从此知难定。\n阑休凭。\n月残烟暝。\n总是凄凉境。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22299,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐","author":"孙云凤","text":"看花赌酒。\n乐事何年又。\n门巷销魂重插柳。\n细雨禁烟时候。\n庭中明月团圞。\n天涯芳草纤绵。\n夜夜小楼春梦，随风飞度关山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22300,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"孙云凤","text":"晴丝摇曳东风午。\n纱窗梦绕屏山路。\n日暖杏花香。\n小庭春昼长。\n燕归帘莫卷。\n幽思天涯远。\n新月半黄昏。\n行人江上村。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22301,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"孙云凤","text":"日长深柳黄鹂啭。\n绣床风紧红丝乱。\n微雨又残春。\n落花深掩门。\n高楼眉暗蹙。\n芳草依然绿。\n酒醒一灯昏。\n思多梦似真。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22302,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"孙云凤","text":"炉烟袅袅人初定。\n纱窗月上梨花影。\n春色自年年。\n故人山上山。\n露寒风更急。\n此景还如昔。\n记得倚栏干。\n夜深人未眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22303,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇","author":"孙云凤","text":"一枕秋声，残灯梦断分襟处。\n一番愁绪。\n阶下梧桐雨。\n记得匆匆，深院留春住。