[{"title":"赠马大将军援漳凯旋","author":"冯如京","text":"将军大纛奠南州，麟阁功名万户侯。\n露布惊摇漳海月，云旗高拂闽山秋。\n黄金绣甲三千士，碧玉清歌十二楼。\n共醉升平无战伐，西风射猎臂青鞲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5547,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和纪伯紫","author":"冯如京","text":"空明火树九霞天，咳唾珠玑落座前。\n画省高檠开甲帐，雕窗小饮及丁年。\n龙身佩影光惊白，鹤籀翻奇道又玄。\n此夜谁多金谷酒，漉巾老子欲先眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5548,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卢龙兵备使者张君总戎刘君郡守彭君司理任君邑宰李君备游孤行城置酒清风台有作 其一","author":"范文程","text":"让国清风百世师，阴阴松桧隐空祠。\n黄农事业应无异，山水萧森自不移。\n石动鼋鼍分大壑，城荒乌鹊下高枝。\n接同醉花间酒，绝胜襄阳访习池。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5549,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卢龙兵备使者张君总戎刘君郡守彭君司理任君邑宰李君备游孤行城置酒清风台有作 其二","author":"范文程","text":"孤竹城空隐夕阳，山中笳鼓漫悠扬。\n穿林闲听松杉韵，隔岭遥闻薇蕨香。\n漆水波澜交宛转，滦河岛屿自苍茫。\n登临宾佐多清兴，长啸高台明月光。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5550,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九日滇府南楼","author":"鄂貌图","text":"来登百尺楼，举目见梁州。\n山峻环滇海，云低压瘴流。\n一生常作客，万里共悲秋。\n不有尊中酒，难忘六诏愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5551,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠客忆乡","author":"鄂貌图","text":"万国风尘际，迢迢别雁行。\n故园春草满，客署晚云凉。\n梦破三更月，花开两地觞。\n归期无定日，空感鬓边霜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5552,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"人日","author":"鄂貌图","text":"禁城人日物华同，百感何来逐晓风。\n不解破愁还是酒，谁怜作客已成翁。\n尊前彩胜烟尘外，梦里乡园羽檄中。\n独坐阳和舒啸咏，梅花纸帐夜镫红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5553,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"楚泽凯旋和王郡守韵","author":"鄂貌图","text":"辰阳十月菊丛芳，策马归来自夜郎。\n战绩共歌周召虎，经生犹识汉京房。\n五溪浪静梅将白，二酉烟消酒半黄。\n截罢长鲸烟水阔，好招鸿雁到潇湘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5554,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"早发隆德过六盘","author":"卞三元","text":"客怀苦难昧，归心促邮程。\n饰马立檐下，晨鸡犹未鸣。\n跨鞍出郊埤，征鞭不少停。\n野犬隔村吠，宿鸦绕树惊。\n隐隐双林侧，涓涓溪水声。\n登山不见月，举首已侵星。\n苍茫云雾起，良久曙光生。\n千峰拱翠壁，万壑入川平。\n忽觉高天际，已忘人世情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5555,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"隐者","author":"卞三元","text":"独有烟霞意，难羁世外身。\n闲看林际月，漫理手中纶。\n丛桂成招隐，名山肯让人。\n逍遥吾自在，泉石养天真。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5556,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平凉有感","author":"卞三元","text":"泾水秦山接混茫，遥看四野静边防。\n层云旅雁横秋月，断岭孤猿叫夜霜。\n百里荆榛边戍尽，十年戎马塞城荒。\n残郊败垒无人迹，磷火荧荧散北邙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5557,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋暑","author":"刘仪恕","text":"暑积秋仍酷，高天大火流。\n争传米价涌，况值羽书稠。\n露绝蝉声细，云空鸟影愁。\n犹闻高会客，终夜醉缠头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5558,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日游沂山观百丈崖瀑布","author":"马长春","text":"平明问客路，涧道有余清。\n结侣仗轻策，相将沿壑行。\n行行近水村，处处叱牛声。\n山田高于屋，牛在屋上耕。\n冈峦相枕带，峡口片云横。\n渡峡风泠泠，恍然如再生。\n何物横空下，两岸不能争。\n惊波荡峭壁，澎湃势难平。\n坐久何袅袅，石濑水回萦。\n水在山之岚，霏微移我情。\n有僧烟际出，渡水来相迎。\n莫漫言归去，少焉山月明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5559,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"早朝咏炉烟次同院韵","author":"傅以渐","text":"玉殿晨开静羽旗，遥看烟气上彤墀。\n微升宝鼎分行细，直接晴云散缕迟。\n旭日乍融光似篆，晓风欲定霭成丝。\n清芬想像浮龙衮，仗外千官望自知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5560,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送王思龄归合肥","author":"魏裔介","text":"长安有客思山桂，挂席秋风潞河汭。\n边城一雁正高飞，爽气澄霞雨新霁。\n忆昨承恩衣绣衣，太仓充溢鼠雀稀。\n六军白粲满区釜，君王玉馔有光辉。\n左省高资重廷阙，特简清秩班卿月。\n入告我后尽嘉谋，退食委蛇无请谒。\n江上云山梦里来，知君肝胆几徘徊。\n金樽满酌不辞醉，茫然清兴使人哀。\n君不见八公仙去空山色，濡须之水流不息。\n功成方可拂衣去，莫到淮南忘蓟北。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5561,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过傅掌雷太史晓园","author":"魏裔介","text":"自有沧洲意，潇然三径清。\n藉花能醉客，坐树不妨莺。\n著述淹风雨，交游念死生。\n浊醪君不惜，一晤一回酲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5562,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送友人白青玉归","author":"魏裔介","text":"故园一片月，相照共生平。\n俭岁无忧色，山田惟力耕。\n床头留旧酿，世事尽浮名。\n余亦明年去，闲看春草生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5563,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋怀","author":"魏裔介","text":"秋云冉冉暮，庭草惜青光。\n雨气留空翠，鸦声落夕阳。\n摊书鱼蠹老，岸帻酒杯香。\n亦有竹林意，何人是古狂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5564,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自安定门旋由水关南望德胜门述目所见","author":"魏裔介","text":"晓巘映朝暾，人家野水村。\n楼残遗堞立，寺废古钟存。\n解冻春云漾，呼鹰猎马驯。\n干戈息数载，犹有哭声吞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5565,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和纪伯紫","author":"魏裔介","text":"钟山醉老太平春，自与云霞道气亲。\n三代尚存惟我辈，百年独步见斯人。\n久居深巷绝华毂，耻向侯门吐锦茵。\n高隐从来思济世，殷勤属我作良臣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5566,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"枫岭","author":"李霨","text":"枫岭与梨岭，南北相拱揖。\n石脉固潜通，蟠峙各独立。\n林木互纠纷，乱峰森??。\n其巅判闽浙，风土隔邦邑。\n跻崖俯绝谷，转道仅微级。\n凌空危桥滑，束涧鸣溜急。\n负担尽游估，攀缘如蚁集。\n伤哉营微利，走险讵夙习。\n下见稻畦人，惊客举蓑笠。\n驰骛违所性，邅回增忧色。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5567,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舟发浦城","author":"李霨","text":"地形下东南，滩溜如箭疾。\n客行冲雾雨，扁舟仅容膝。\n粼粼沙痕高，齿齿石锋密。\n礌砢碍中流，巨细状非一。\n狭逼惊涛飞，深沸漩涡溢。\n舟楫巧纡避，簸荡神先怵。\n篙师一失手，势与洪流汩。\n眩眼杂卉稠，送客奔崖崒。\n骇奇豫初览，过险怕缕述。\n乘流怪浮生，坎止私愿毕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5568,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"长夏闲居杂兴","author":"李霨","text":"淡荡羲皇卧，英雄河朔杯。\n斯人难复起，古道日尘埃。\n斗捷山多径，全生木不才。\n两端终易剖，决策是归来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5569,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"巡行过北平登孤竹堂望夷齐庙有感","author":"魏象枢","text":"孤竹何崔巍，两裔高千古。\n仰止梦魂间，有怀常欲吐。\n安得陟山巅，瓣香头一俯。\n告我希圣心，难济苍生苦。\n凛凛对简书，汗下浑如雨。\n此行负朝廷，愆尤何日补。\n遥望乞神灵，相助驱豺虎。\n滦水自无波，澄清在畿辅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5570,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"剥榆歌","author":"魏象枢","text":"黄沙日暮榆关路，烟火尽绝泥寒户。\n路旁老翁携稚儿，手持短铁剥榆树。\n我问剥榆何所为，老翁倚马哽咽悲。\n去岁死蝗前死寇，数十村落无孑遗。\n苍苍不恤侬衰老，独留余生伴荒草。\n三日两日乏再饘，不剥榆皮那能饱。\n榆皮疗我饥，那惜榆无衣。\n我腹纵不果，宁教我儿肥。\n嗟呼此榆赡我父若子，日食其皮皮有几。\n今朝有榆且剥榆，榆尽同来树下死。\n老翁说罢我心摧，回视君门真万里。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5571,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠乔文衣","author":"魏象枢","text":"数年惊宦海，无日不高吟。\n冰雪幽人气，琴书侠士心。\n世情添白发，交谊冷黄金。\n留客坐山月，床头话古今。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5572,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"哭魏昭华先生","author":"魏象枢","text":"昔年乍去身犹健，昨夜空伤万里魂。\n海上鳄鱼骄白日，庭前鵩鸟下黄昏。\n遗书暗洒孤臣血，垂死仍衔故国恩。\n最是圣朝容直谏，许君骸骨葬平原。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5573,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"李恒岳妻兄自蔚来访喜而赠之","author":"魏象枢","text":"握手东庄一载余，劳君远过旅人居。\n晚年难得同心侣，夜话如看太古书。\n顾我廉名承义重，于今言路报恩疏。\n祇应早晚归休去，莫累高贤更拮据。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5574,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丁巳元日侍班候贺雪中口占","author":"魏象枢","text":"骨瘦筋衰六十翁，班行犹自缀群公。\n无才祇觉君恩重，揣分安能国计充。\n民力艰难愁鬓里，天心仁爱雪花中。\n朝家自有真刘晏，早济三军奏捷功。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5575,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送汤荆岘学士巡抚下江","author":"魏象枢","text":"秀才任天下，仁者体万物。\n物逸而我劳，分内不遑惜。\n昔日侍讲筵，天子重经术。\n今日守封疆，帝心特简出。\n江南风甚嚣，江南民甚绌。\n维风道先倡，爱民蠹先黜。\n吾性秉真刚，无欲谁能屈，但得百姓欢，安问权要怫。\n余也愧衰残，十弊口难述。\n临歧赠一言，怀抱慎忧郁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5576,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"十月二日出都承诸公郊饯","author":"魏象枢","text":"去国心难恝，徘徊马首迟。\n真逢宵旰主，况际太平时。\n老病天应鉴，行藏世不疑。\n二疏千载盛，薄劣又重追。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5577,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寒夜","author":"杨思圣","text":"冬夜凄以长，寂寞绝人境。\n凉月薄帷幕，荒庭交树影。\n寥寥寒柝鸣，熊熊孤剑冷。\n拥被不成眠，森沈万虑永。\n早岁乏深智，凌厉思一骋。\n遂为世网牵，甘心逐蛙黾。\n人生不百年，哀乐在所领。\n贫贱各有适，岂必勒钟鼎。\n愁来忆古人，见机苦不猛。\n含恨当语谁，泪下如修绠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5578,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卒岁感述 其一","author":"杨思圣","text":"我有长恨端，迫此岁暮情。\n朔风吹庭树，寒日照此荆。\n起坐仰天叹，归鸟飞且鸣。\n吾生胡不达，独为世网撄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5579,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卒岁感述 其二","author":"杨思圣","text":"冉冉冬日暮，积雪耀林端。\n负疴卧虚室，慨然念微官。\n家贫禄复薄，妻孥常苦寒。\n况乏济时略，终当归林峦。\n奈何日徵逐，索米老长安。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5580,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卒岁感述 其三","author":"杨思圣","text":"出门何所适，落日见西山。\n回回寸心违，逢人多厚颜。\n三五谁家儿，传呼大道间。\n貂裘控骢马，嚼齧黄金环。\n出入尚书第，可望不可攀。\n引领长太息，归来独闭关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5581,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卒岁感述 其四","author":"杨思圣","text":"天运有代谢，富贵易汨没。\n鄙哉何者翁，专欲事虚喝。\n我闻至人训，真乐在寂寞。\n腐鼠良可掷，荣名焉足托。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5582,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"酬纪伯紫即送其之晋阳","author":"杨思圣","text":"大江势浩浩，南北错舆舱。\n往往异人出，结交在一言。\n我家漳水涯，子居白下门。\n素心各有托，意气自孤骞。\n相逢长安陌，双眼望朝暾。\n长安多王侯，第宅若云屯。\n绮筵罗珍食，朱缨驰华轩。\n宾从纷遝沓，附势如灼薰。\n静交有吾徒，冥然绝世喧。\n不就唐生决，肯借金张援。\n时时顾蓬径，樽酒共讨论。\n落日登高台，慷慨天为昏。\n击筑声泪下，重招烈士魂。\n忽整晋阳驾，贻诗重玙璠。\n以俪魏给事，无乃非其伦。\n感君安所赠，此意贵永敦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5583,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送彭燕文旋里兼讯顾伟南","author":"杨思圣","text":"光熹之际龙在野，人文往往归复社。\n当时陈徐最知名，短衣破帽子尚在。\n流落谁悲失志人，去岁上策复不遇，怜才难买千金赋。\n狂歌日沽燕市醪，痛哭屡吊昭王墓。\n爱我时时肯一过，酒阑击剑客颜酡。\n人生感激为知己，抒心写意岂有他。\n送子七月凉风早，莼菜鲈鱼秋正好。\n到家为问顾伟南，他日相逢漫草草。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5584,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠温献之","author":"杨思圣","text":"相逢涕泪且停挥，城阙萧条梦里微。\n唯有青山常不改，月明时见鹧鸪飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5585,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"示离指和尚","author":"杨思圣","text":"钟动黄昏山寺秋，白云红树隐沙洲。\n老僧闲坐心无事，独对门前江水流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5586,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"便道过里","author":"杨思圣","text":"归客惭司马，曾无四壁留。\n残书遗鼠啮，野稼任人收。\n狂益亲知怪，贫添儿女忧。\n那堪行又别，明日是长游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5587,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄申凫盟","author":"杨思圣","text":"愁思风雨夕，忽漫十年过。\n曾否狂如旧，将无鬓已皤。\n君才岂濩落，吾意亦烟萝。\n出处谁能识，悲哉两地歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5588,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"喜申凫盟至都门 其一","author":"杨思圣","text":"意外劳相访，秋风人正闲。\n喜深无一语，惊定始开颜。\n款款悲霜鬓，迟迟话故山。\n长安非昔日，莫畏鹤书还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5589,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"喜申凫盟至都门 其二","author":"杨思圣","text":"不堪今夕会，重忆乱离初。\n人老干戈里，交存生死余。\n山川几命驾，涕泪共裁书。\n十载还耕约，相看愧鬓疏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5590,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"喜申凫盟至都门 其三","author":"杨思圣","text":"望极燕山暮，相逢感泣多。\n人间遗玉碗，故物指铜驼。\n恨血千年碧，龙池永夜波。\n雄图今已矣，尚有酒徒过。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5591,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋迟有怀","author":"杨思圣","text":"秋城余返照，霜色淡遥峰。\n落叶空斋掩，萧条闻暮钟。\n客情随宦减，生事逐年慵。\n兀坐迟今夕，怀人何处逢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5592,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送申凫盟并呈殷伯岩","author":"杨思圣","text":"几月依燕寺，萧条客念归。\n送君怀往路，昨日雪花飞。\n蓟北连沙戍，漳南老蕨薇。\n寄言殷伯子，招隐故心违。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5593,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送郭裕九以言事谪归","author":"杨思圣","text":"勿嗟今不用，此去已承恩。\n朝论归吾党，危言托至尊。\n风和乡路逼，沙乱帝城昏。\n宣室行应诏，宁教老灌园。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5594,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山信","author":"杨思圣","text":"岁序冬逾驶，栖迟未得闲。\n边风吹碣石，大雪满燕关。\n浊酒堪扶老，黄金岂驻颜。\n年年山有信，招隐几时还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5595,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"申凫盟自燕中归枉顾晋阳同周茂山喜赋","author":"杨思圣","text":"每共茂山子，论交忆汝贤。\n忽传燕客信，正及早春天。\n沙塞听莺渺，官厨漉酒鲜。\n相看俱老大，珍重莫言还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5596,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送周茂山归四明","author":"杨思圣","text":"不敢留君住，知君有老亲。\n门前黄叶树，江上白头人。\n负米休惭禄，烹葵莫厌贫。\n甲兵天地满，何处好为邻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5597,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"诮梦","author":"杨思圣","text":"莫问升沈事，空劳旅梦讹。\n天心存倚伏，吾道本蹉跎。\n知己青山在，秋风故郡多。\n归来真不易，消息定如何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5598,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游百泉次韵 其一","author":"杨思圣","text":"不谓风尘客，相从到百泉。\n山空疑作雨，林密欲为烟。\n乱石当樵路，平流散渚田。\n薄游堪取醉，好向水亭眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5599,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游百泉次韵 其二","author":"杨思圣","text":"夕山秋色暝，潭底幻明霞。\n白动千岩月，红垂两岸花。\n断桥通寺径，古木隐人家。\n独羡持竿叟，清寒立钓槎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5600,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄马菽史","author":"杨思圣","text":"忆别嵩山寺，关河隔岁看。\n归应惭好友，贫岂恋微官。\n锦树巴江老，梅花铁里寒。\n《遂初》犹可赋，不敢贱渔竿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5601,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"申凫盟书来为我卜居广平","author":"杨思圣","text":"岂是耽微禄，余心独尔知。\n全生谋隐拙，多病寄书迟。\n蜀道频相念，邻居近有期。\n风尘逋客久，遮莫北山移。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5602,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄怀傅掌雷","author":"杨思圣","text":"忆在长安驾玉龙，晓园花竹日相从。\n醉沽兰液居中酒，闲看慈仁寺里松。\n别久将无伤老大，官狂依旧笑疏慵。\n只今绝域谁知己，好赋归来卧碧峰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5603,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晚春即事","author":"杨思圣","text":"花落闲庭春事阑，主人长日但加餐。\n竹间路好披云入，窗里山宜带雨看。\n半箧残书留过目，百年衰鬓罢弹冠。\n萧条莫厌交游冷，逆旅悠悠蜀道难。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5604,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"泛舟","author":"杨思圣","text":"湘帘雀舫木兰桡，荡漾烟波看渐遥。\n春水一江吹细浪，青山两岸接平桥。\n参差玉笛惊流响，潋滟金尊欲上潮。\n横槊船头多意气，轻风催棹雨潇潇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5605,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题宫紫玄春雨草堂","author":"杨思圣","text":"东掖传经计已疏，归来为筑浣花居。\n苍山移石供支杖，春树分阴照读书。\n竹外寻僧招野艇，雨中留客摘园蔬。\n荷衣未制吾将老，乘兴何年共结庐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5606,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晚步松花泉亭","author":"杨思圣","text":"倚山新构夕阳亭，石角寒流细欲泠。\n习静几能闻素濑，探幽谁为补《茶经》。\n荒嵓啼鸟窥人立，小径芦花隔水扃。\n迤逦闲来凭眺远，苍烟深处是南屏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":5607,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]