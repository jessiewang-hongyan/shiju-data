[{"title":"清平乐 其二","author":"赵我佩","text":"红冰试揾。\n浅砑鲛绡晕。\n纨扇只愁凉有信。\n冷落空箱谁问。\n雨声酸逗纱屏。\n晚来倦拥桃笙。\n最是梧桐无赖，未秋先作秋声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25322,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 其一 题絅士《小蓬莱阁词》","author":"赵我佩","text":"麝墨扫云烟。\n艳谱金荃。\n春风香洒笔花鲜。\n却好旗亭人赌唱，绝妙词笺。\n一字一珠连。\n绮语缠绵。\n蓬莱阁近大罗天。\n翠耸遥山山万叠，合住吟仙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25323,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 其二 题絅士《小蓬莱阁词》","author":"赵我佩","text":"把酒夜眠迟。\n檀板金卮。\n晓风残月饯春时。\n花落花开名士泪，写遍新词。\n红豆种相思。\n叶叶枝枝，闲愁除有白鸥知。\n知否当时狂杜牧，鬓早成丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25324,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 其一 五色蝴蝶","author":"赵友兰","text":"楼畔犹馀金谷恨。\n十斛量珠，买得香魂醒。\n吹水差差添碧晕。\n苔痕浸入菱花镜。\n帘外东风凭扫径。\n拾翠相邀，休误寻芳信。\n一掬盈盈谁与赠。\n缀钗飞上轻蝉鬓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25325,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 其二 五色蝴蝶","author":"赵友兰","text":"点额涂黄妆最靓。\n捎向花间，巧与莺儿并。\n明月照人浑未省。\n郁金堂畔芳心警。\n春满蜜脾蜂乍静。\n逐队晨衙，俊味谁能忍，斗草女郎娇欲近。\n妒它杏子春衫影。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25326,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其一 闺中四时词","author":"陈嘉","text":"绿杨踠地春愁重。\n流莺啼破红闺梦。\n睡起悄凭栏。\n罗襦怯晓寒。\n卖花声渐近。\n催把云鬟整。\n对镜画双娥。\n远山眉样多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25327,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其二 闺中四时词","author":"陈嘉","text":"梧桐渐长芭蕉裹。\n愔愔庭院清阴锁。\n曲槛绕芳塘。\n风来荷叶香。\n昼长人意懒。\n盼煞斜阳晚。\n粉汗湿鲛绡。\n休将纨扇抛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25328,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其三 闺中四时词","author":"陈嘉","text":"藕花开瘦红衣落。\n金风袭体罗衫薄。\n屈指数星期。\n神仙还别离。\n玉阶鸣促织。\n砧杵千家急。\n枕簟爱新凉。\n梦和莲漏长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25329,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其四 闺中四时词","author":"陈嘉","text":"日高犹恋重衾卧。\n葱纤怯冷慵梳裹。\n帘外暗香来。\n早梅开未开。\n彤云天欲雪。\n鸦阵盘空黑。\n数九约围炉。\n先将窗纸糊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25330,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 其一","author":"钱斐仲","text":"月影穿窗散玉钱。\n被人错唤作团圞。\n十三圆月几曾圆。\n梦渴频催煎凤饼，思慵浑懒拨鹍弦。\n木犀香得病情添。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25331,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 其二","author":"钱斐仲","text":"凉气吹帘烛泪消。\n金尊倾却冷香醪。\n黄昏时节最无聊。\n多谢幽兰相伴住，重挑残焰读离骚。\n秋檐风雨正潇潇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25332,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 其一 重游金陀园感怀","author":"钱斐仲","text":"花雨湿溟濛。\n楼阁重重。\n桂丛西畔竹丛东。\n为爱香泥乾尚软，偷印弓弓。\n宛转画楼通。\n春水溶溶。\n桥边垂柳柳边风。\n扑住风中双蛱蝶，浪认雌雄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25333,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 其二 重游金陀园感怀","author":"钱斐仲","text":"秋水濯芙蓉。\n月满珠丰。\n长裙初曳恼娇慵。\n腰细自怜环佩响，故立当风。\n花是昔年红。\n人面难同。\n伤心莫忆旧游踪。\n百尺晴丝垂到地，依旧融融。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25334,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 其一 题自画紫藤双蝶便面","author":"钱斐仲","text":"开到藤花春已暮。\n可奈东风，不肯将愁去。\n一任绣床黏柳絮。\n怜花只绕闲阶步。\n蹴损苔痕无意绪。\n移个鹦哥，挂在花深处。\n教与夜来新谱句。\n不知花外涟纤雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25335,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 其二 题自画紫藤双蝶便面","author":"钱斐仲","text":"雨压烟迷开更密。\n手绾柔条，结个同心结。\n一霎软风搓紫雪。\n花阴吹下成双蝶。\n欲笑还颦留一瞥。\n淡粉轻脂，便是春消息。\n作弄微虫描活脱。\n闲情付与匀眉笔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25336,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人 其一 庚申七夕后二日，辟寇南玉港村居，卧病感怀","author":"钱斐仲","text":"凄凉时节凄凉雨。\n人在凄凉里。\n荒村无处访秋花。\n只有豆棚瓜架、是生涯。\n安排砚墨应无地。\n麋鹿为群已。\n牙签玉轴委泥沙。\n试问客居何处、客无家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25337,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人 其二 庚申七夕后二日，辟寇南玉港村居，卧病感怀","author":"钱斐仲","text":"兵戈日日催人老。\n豺虎仍当道。\n断蓬流水各西东。\n难问亲朋何处、寄浮踪。\n离离秀茁谁家稻。\n共说秋来早。\n一行新雁点晴空。\n赢得离人清泪、洒西风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25338,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其二","author":"张绉英","text":"荒村一带垂杨陌。\n断桥曲岸无行客。\n斜日片帆轻。\n春风樵子声。\n暮山青草遍。\n烟里双飞燕。\n江上卷帘愁。\n蘋开见水流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25339,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其一 有感","author":"张绉英","text":"一庭残月凄凉白。\n纱窗掩映灯明灭。\n敧枕不成眠。\n起来欲曙天。\n流光弹指误。\n何计教愁去。\n强自学忘情。\n奈何情转生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25340,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其二 有感","author":"张绉英","text":"买春春已无踪迹。\n榆钱满地空狼藉。\n不敢怨东风。\n伤心泣断红。\n浮生浑若寄。\n一霎荣枯异。\n泪眼渐朦胧。\n醒来犹梦中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25341,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卖花声 其一","author":"张绉英","text":"病怯晚寒严。\n休卷重帘。\n穿窗无奈朔风尖。\n人与梅花同瘦损，一晌恹恹。\n新月上茅檐。\n眉影纤纤。\n闲愁暗逐漏声添。\n回首岳云千里外，清泪空黏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25342,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其一 落梅，伤纬青亡妹","author":"张绉英","text":"江南多少离人恨。\n依稀记得年时影。\n新月正如眉。\n盈盈笑靥开。\n巡檐曾索笑。\n只道春长好。\n闲落任东风。\n罗浮一梦中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25343,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其二 落梅，伤纬青亡妹","author":"张绉英","text":"西风吹满空山雪。\n冰姿自是神仙格。\n小劫堕尘寰。\n相逢一晌闲。\n花幡谁解护。\n悔煞当时误。\n倩影杳难寻。\n幽香空外沉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25344,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其一 月夜不寐。忆亡妹纬青","author":"张绉英","text":"琼楼十二无消息。\n返魂难觅鸿都术。\n一卷箧中诗。\n心情只自知。\n十年馀涕泪。\n忽忽成憔悴。\n依旧月光寒。\n谁教特地圆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25345,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其二 月夜不寐。忆亡妹纬青","author":"张绉英","text":"夜深风劲侵肌骨。\n清辉一院飞晴雪。\n此度卷帘看。\n谁怜双袖寒。\n霜华飘鬓影。\n往事空追省。\n不敢怨宵长。\n知君更断肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25346,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其一 春夜","author":"张珊英","text":"柳丝轻漾纱窗影。\n篆痕低绕云屏锦。\n风细晚烟晴。\n奁开宝镜明。\n玉阶堆湿翠。\n露腻花如醉。\n帘卷曲阑低。\n月移林影迷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25347,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其二 春夜","author":"张珊英","text":"春山月皎银屏翠。\n鹧鸪香暖罗襦醉。\n一径落花低。\n露溥梅子肥。\n苍筤摇懒影。\n斜倚蔷薇冷。\n随意拨金猊。\n流莺窗外啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25348,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 其一","author":"张珊英","text":"细雨洒无声。\n终日潮生。\n黄鹂不耐昼冥冥。\n却向枝头啼宛转，唤醒春阴。\n晚照满中庭。\n垂下湘云。\n蛛儿也解惜新晴。\n百尺游丝黏落絮，不碍红英。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25349,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 其二","author":"张珊英","text":"花影正亭亭。\n卷上帘旌。\n素娥有意欲相亲。\n恁耐浮云时掩映，做弄阴晴。\n碧落浪翻银。\n涌上江鳞。\n一庭春色不分明。\n安得好风吹散也，依旧冰轮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25350,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 其一 癸丑春日将归洞庭，闺中诸姊妹投赠诗词以为祖饯之意，予亦悲感交集，谱此以别。","author":"许德蘋","text":"小劫红羊期已满。\n扰扰尘喧，乌兔飞如箭。\n往日若多来日短。\n眉峰深锁何曾展。\n从今省识东君面。\n卷起重帘，为有双飞燕。\n桃李秾华才到眼。\n此情不比寻常见。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25351,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 其二 癸丑春日将归洞庭，闺中诸姊妹投赠诗词以为祖饯之意，予亦悲感交集，谱此以别。","author":"许德蘋","text":"世味炎凉参已透。\n一树垂垂，绿遍河堤柳。\n放眼静看人太瘦。\n吟魂怕绕屏山岫。\n枝上杜鹃啼已久。\n催得人归，只恐人归后。\n山影自怜非似旧。\n黄昏泪落抛红豆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25352,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 其三 癸丑春日将归洞庭，闺中诸姊妹投赠诗词以为祖饯之意，予亦悲感交集，谱此以别。","author":"许德蘋","text":"小院重门深锁紧。\n秋月春花，消得闲愁闷。\n道是闷愁消得尽。\n那知对景添长恨。\n昨夜东风来衮衮。\n墙角梅花，特报春来信。\n只恐韶华真一瞬。\n此情脉脉萦方寸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25353,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 其四 癸丑春日将归洞庭，闺中诸姊妹投赠诗词以为祖饯之意，予亦悲感交集，谱此以别。","author":"许德蘋","text":"不敢轻将西子比。\n觅得陶朱，欲泛五湖里。\n画舸乘风吾去矣。\n从今洗眼来云水。\n忽听骊歌声细细。\n尽是阳春，多道伤离意。\n后日思量凭雁鲤。\n尺书时把加餐慰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25354,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 其一 寄怀崔小莺姊","author":"许德蘋","text":"驻拍停歌冷夕阳。\n浓烟深锁倒垂杨。\n无聊独自咏河梁。\n双鬓浑忘施黛绿，满头犹自插花黄。\n闲庭寂寞晚风凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25355,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 其二 寄怀崔小莺姊","author":"许德蘋","text":"片片飞云逐雁行。\n飘来一阵木樨香。\n更阑犹厌漏声长。\n心事漫和灯细语，愁怀只与梦商量。\n无眠又见月窥窗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25356,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十六字令 其一 闺情","author":"吴尚憙","text":"凉。\n扑面西风到小堂。\n罗衣薄，对镜懒成妆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25357,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十六字令 其二 闺情","author":"吴尚憙","text":"情。\n闷倚罗帏数漏声。\n窗棂外，小雨梦难成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25358,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 其一 四时幽居即景","author":"吕采芝","text":"江村好，柳眼乍舒青。\n水涨红桥浮嫩鸭，阴浓绿树听啼莺。\n游赏及时新。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25359,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 其二 四时幽居即景","author":"吕采芝","text":"江村好，小阁数间宽。\n曲沼荷香清十里，夜窗竹影上千竿。\n新葛称轻纨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25360,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 其三 四时幽居即景","author":"吕采芝","text":"江村好，秋气入幽居。\n篱畔菊花香对酒，楼头皓月坐观书。\n风急雁来初。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25361,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 其四 四时幽居即景","author":"吕采芝","text":"江村好，集霰景偏佳。\n松径风寒堆白玉，纸窗梦冷绽梅花。\n扫雪煮新茶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25362,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其一 有感","author":"吕采芝","text":"韶华又是匆匆甚。\n催人不管人愁闷。\n花自看芬芳。\n侬看都断肠。\n尘生明镜暗。\n一任朱颜改。\n莫把绣帘开。\n怕它双燕来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25363,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其二 有感","author":"吕采芝","text":"凄凉意绪逢佳节。\n一番情事和谁说。\n小院逗东风。\n伤心泪自红。\n梅花如昔瘦。\n往事难回首。\n不忍倚阑干。\n夜深翠袖寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25364,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其三 有感","author":"吕采芝","text":"东皇既漏春消息。\n雨丝风片摧何急。\n镇日画帘斜。\n无心阅岁华。\n满庭芳草绿。\n知否眉峰蹙。\n和泪證前因。\n始终却负君。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25365,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其一 挽五弟妇董孺人","author":"吕采芝","text":"无端几夜西风急。\n琼花一树轻轻折。\n雨暗玉阑干。\n依稀翠袖单。\n帘垂环佩冷。\n衰草迷荒径。\n妆镜为谁开。\n彩云何日回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25366,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其二 挽五弟妇董孺人","author":"吕采芝","text":"调琴乍喜知音遇。\n缘悭不道反成误。\n红粉惯飘零。\n伤心不独君。\n罗巾残泪渍。\n细喘随风绝。\n香炉阿谁烧。\n空悬碧玉箫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25367,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"百字令 其一 留别祐甫四姊、撷芬二妹、逸青三妹","author":"吕采芝","text":"秋溪红树，正长空雨洗，行装初整。\n一夜西风催晓梦，别恨又堆双鬓。\n素手重携，啼痕漫拭，把酒无心饮。\n销魂玉笛，不堪回首重听。\n曾记永昼敲棋，长宵清话，往事空相證。\n此去乡关如落絮，身世飘零莫定。\n千叠云山，一江清水，辜负归帆顺。\n酸辛情绪，却教清泪盈枕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25368,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"百字令 其二 留别祐甫四姊、撷芬二妹、逸青三妹","author":"吕采芝","text":"重帘怕卷，乍楼头寒压，沉吟别意。\n真个今番分手也，雨雨风风难避。\n衰柳无情，落花惹恨，况又关同气。\n叮咛保重，不须双袖凝泪。\n任它伫月楼虚，评花院冷，莫把离愁系。\n薄命自知非独我，今古伤心一例。\n断梗飘蓬，浮萍败叶，悟彻今生味。\n分飞千里，只期鱼雁勤寄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25369,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 其一 清明","author":"吕采芝","text":"幽院初晴帘不卷。\n彩管慵拈，辜负炉烟满。\n见说清明肠已断。\n柳丝莫系斜阳岸。\n宽褪钏金眉不转。\n病倚熏笼，情绪天难管。\n著雨桃花枝上颤，任它零落胭脂染。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25370,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其一","author":"吕采芝","text":"金猊香冷迢迢夜。\n一轮皓魄当庭泻。\n邻院悄无人。\n梅花瘦影横。\n依稀长中酒。\n百结柔肠锁。\n虬漏一声声。\n愁人不忍听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25371,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其二","author":"吕采芝","text":"绮窗曾记调鹦鹉。\n海棠依旧娇如许。\n小谪几多年。\n几回欲问天。\n有情天易老。\n遗恨知多少。\n青鬓已成霜。\n销魂在异乡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25372,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其四","author":"吕采芝","text":"芳尘不碍行人路。\n花骢欲系知何处。\n暝色入疏帘。\n春风软似棉。\n故园空怅望。\n烽火连云嶂。\n杨柳绿如丝。\n断肠谁得知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25373,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其五","author":"吕采芝","text":"梦中犹忆乡关好。\n醒来转觉乡关杳。\n泪眼问青天。\n海枯恨莫填。\n杜鹃啼不住。\n断送华年去。\n夜雨又潇潇。\n愁心卷绿蕉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25374,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙 其一","author":"吕采芝","text":"帘外一庭芳草，墙头几树桃花。\n碧波低映小桥斜。\n韶光明媚甚，春色十分赊。\n知否玉关消息，依旧烽火黄沙。\n故乡欲去恨无家。\n红楼残梦醒，情思滞天涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25375,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙 其二","author":"吕采芝","text":"一夜春风料峭，醒来花落阶墀。\n燕雏莺怯费寻思。\n昨宵因中酒，今日起偏迟。\n青鬓已非畴昔，多愁不减当时。\n陌头垂柳万千丝。\n危阑慵去凭，心事有谁知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25376,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其一 簪茉莉美人","author":"陆珊","text":"画眉才了临妆镜。\n一枝斜飐生娇韵。\n倦压鬓云偏。\n呼鬟整翠钿。\n夜香烧月下。\n细步吹兰麝。\n卸向枕函旁。\n凉宵梦也香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25377,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其二 簪茉莉美人","author":"陆珊","text":"露阶蛩语声呜咽。\n玉炉香尽天街寂。\n明月半窥帘。\n思乡人未眠。\n望云空伫立。\n岁岁伤离别。\n生小本多愁。\n听风怕到秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25378,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 其一 落梅","author":"钱湘","text":"已恨妒花风雨急。\n谁倚楼头，又擪江城笛。\n不信琼姿留不得。\n般般催送香魂别。\n门掩黄昏空寂寂。\n月也无情，雪也无颜色。\n好梦罗浮都已歇。\n夜寒纸帐重相忆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25379,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 其二 落梅","author":"钱湘","text":"漫道繁花春似海。\n来占春先，去不应春待。\n只恐春光还易改。\n看花虚费留春泪。\n群玉山头仙侣在。\n雾帐云屏，远隔琼瑶界。\n小住人间愁不耐。\n夜深归去珊珊佩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25380,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 其一 芦花","author":"陆蓉佩","text":"一缕秋魂纤欲化。\n似有疑无，却在斜阳外。\n漂泊天涯何处著。\n思量悔把枝头舍。\n野岸孤村天半夜。\n开处凄凉，零落人谁话。\n欲舞徘徊还自罢。\n依依一种情难画。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25381,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 其一 答碧梧姊五忆诗","author":"谈印梅","text":"追随处，点缀出心裁。\n画障秋围喷水菊，苔盆寒护折枝梅。\n长得玩芳菲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25382,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 其二 答碧梧姊五忆诗","author":"谈印梅","text":"追随处，幽事夏来多。\n芳径凌晨收草露，画檐将雨看风荷。\n凉思逼衣罗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25383,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 其三 答碧梧姊五忆诗","author":"谈印梅","text":"追随处，拈笔写无聊。\n残帖春风摹蛱蝶，小窗秋雨谱芭蕉。\n剪烛话长霄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25384,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 其四 答碧梧姊五忆诗","author":"谈印梅","text":"追随处，袖手暮寒时。\n翠柏和香烧睡鸭，黄齑有味煮蹲鸱。\n欲雪雀争枝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25385,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]