[{"title":"奉和简斋大兄见贻元韵","author":"袁杰","text":"地隔乡关梦解通，忽来诗讯自南中。\n宦游结宅邻江令，归隐名墩属谢公。\n旧约未忘联舍月，新吟频忆对床风。\n只应岁晚相依乐，剩许追陪玉局翁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26988,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋胡行","author":"王李氏","text":"灼灼闺中妇，猗猗陌上桑。\n采桑攀柔条，殷勤纤手将。\n良人久不归，忧思潜断肠。\n倾筐置路侧，四顾方徬徨。\n朅来谁氏子，展睇希容光。\n挥金却不顾，凛凛惊豪强。\n洗耳向泉水，澄神归家堂。\n孰意佻达子，即是轻薄郎。\n郎行薄如水，妾心皎如霜。\n五年久契阔，婉娈含春芳。\n窃谓托高义，白首偕我臧。\n如何乖中道，不念倚闾望。\n慷慨赴清波，决烈箴愚狂。\n慷慨固可嘉，决烈亦有妨。\n陷夫负隐慝，终身为不良。\n慈姑意斯时，创痛如撄芒。\n万一遭颠覆，岂非贻之殃。\n《终风》悼昏暴，先君思不忘。\n何不少隐忍，予以补救方。\n美人蹈勇士，意气何激昂。\n寄言闺中人，于此宜精详。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26989,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"口占示妹","author":"任浣花","text":"痛别椿庭近六年，茕茕母女问谁怜。\n回思雪案牵衣处，教诵《毛诗》第一篇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26990,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"借书","author":"徐畹芝","text":"玉剪堂前万卷储，一编许读乐何如。\n浮生愿向书丛老，不惜将身化蠹鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26991,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"月夜怀玉卮侄女","author":"徐畹芝","text":"镫花欲灺篆烟微，坐久浑忘月上帏。\n忽忆昨宵微醉后，满身花影送君归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26992,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄浣花四姑","author":"徐畹芝","text":"菜花桥畔是幽居，静掩双扉剥啄疏。\n为问新秋残暑后，调铅日著几行书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26993,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送陈姨归新安 其一","author":"任玉卮","text":"伤子远别离，辞亲日初晓。\n后会知何时，泪滴荆溪草。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26994,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送陈姨归新安 其二","author":"任玉卮","text":"朝来理行棹，一别萦千思。\n难为雁行留，执手空嗟咨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26995,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送陈姨归新安 其三","author":"任玉卮","text":"絮语不能尽，归来未几时。\n双亲惜儿去，白发又丝丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26996,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送陈姨归新安 其四","author":"任玉卮","text":"堤边古杨柳，暗拂行人衣。\n绾尽情多少，莫教音信稀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26997,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"敬题先严双栖图","author":"任玉卮","text":"图就严亲清健容，薇花夜月两溶溶。\n应怜母氏留长恨，故遣丹青觅旧踪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26998,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"偶作 其一","author":"杨琼华","text":"千金买骏马，百金买宝刀。\n瘴云浓似墨，昨梦到哀牢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26999,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"偶作 其二","author":"杨琼华","text":"杀气缠旄头，寒光剑铁浮。\n请缨如有路，愿雪戴天雠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27000,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋云","author":"杨琼华","text":"乱山飞不断，皎月失光明。\n不解为霖雨，无端掩太清。\n边关游子泪，亲舍旅人情。\n愿藉西风力，依然万里晴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27001,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"八月八日闻舍弟长龄蒙恩释狱","author":"杨琼华","text":"闻道金鸡下赦竿，廿年今始脱南冠。\n泪凝狴犴伤公冶，血洒弓衣愧木兰。\n绝域丹诚生马角，九重雷雨洗忠肝。\n遥知多病垂衰母，应为娇儿进一餐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27002,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夫子奉使入都诗以志别","author":"杨琼华","text":"白发高堂望，轻帆去莫迟。\n计来相别日，想到省亲时。\n同有乡园感，非关儿女私。\n庭闱知恋恋，不敢数归期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27003,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"老松","author":"恽珠","text":"万古郁葱茏，何人种此松。\n苍涛声一片，圆盖影千重。\n鹤骨擎丹壁，虬枝秀碧峰。\n只愁春今节，雷雨化为龙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27004,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨过","author":"恽珠","text":"雨过中庭万象清，绿阴深处晚凉生。\n自移竹榻来幽院，坐听枝头好鸟鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27005,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"锦鸡","author":"恽珠","text":"閒对清波照彩衣，遍身金锦世应稀。\n一朝脱却樊笼去，好向朝阳学凤飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27006,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春游","author":"恽珠","text":"芳草芊芊没马蹄，春光最好帝城西。\n桃花浪暖鱼苗长，杨柳阴深燕子低。\n一片明湖如镜朗，几重远岫与云齐。\n雅游终日浑忘倦，缓促香轮月满溪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27007,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"接家书","author":"恽珠","text":"书寄平安慰远人，那知对此倍思亲。\n高堂真否身康健，雁字分飞已四春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27008,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"暮春","author":"恽珠","text":"不觉春将去，天涯人未还。\n可怜巾上泪，点点尽成斑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27009,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"种菊次外韵","author":"恽珠","text":"主人幽兴学陶潜，植向东篱露未乾。\n花事一年从此尽，等閒莫作众芳看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27010,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨夜舟中","author":"恽珠","text":"连宵春雨洒征篷，独拥罗衾漏欲终。\n千里怀人无远近，梦魂长在浙西东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27011,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"钱塘渡江","author":"恽珠","text":"潮头不怕险，飞棹逐潮行。\n风力一帆饱，山光两岸明。\n南来出涧壑，东望达蓬瀛。\n直破怒涛去，壮怀无限情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27012,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"喜大儿麟庆连捷南宫诗以勖之","author":"恽珠","text":"乍见泥金喜复惊，祖宗慈荫汝身荣。\n功名虽并春风发，心性须如秋水平。\n处世毋忘修德业，立身慎莫坠家声。\n言中告戒休轻忽，持此他年事圣明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27013,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"崮山驿晓发","author":"恽珠","text":"旅馆柝声残，呼童整绣鞍。\n林遮山径黑，月浸戍楼寒。\n少小长随宦，驰驱竟自安。\n平生多游兴，到处望烟峦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27014,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨后游极乐寺","author":"佛芸保","text":"连朝春雨喜初晴，为访珠林出禁城。\n古树遮门如有意，野花遍地不知名。\n竹依佛殿香弥远，鸟入禅堂语亦清。\n笑我拈毫才觅句，几声晚鼓又催行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27015,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄怀智珠师","author":"佛芸保","text":"一纸书传万里心，何年仍复听琴音。\n平沙旧曲今谁授，多少离怀托苦吟。\n兰闺梦不到天涯，南北云山道路赊。\n又是中天秋月朗，夜深应更忆京华。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27016,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闺中閒咏","author":"张学雅","text":"竹院萧萧人语空，夜来风雨太匆匆。\n侵晨独倚阑干角，閒数池莲几朵红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27017,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋闺","author":"张学鲁","text":"窗前松露滴空阶，玉漏沈沈月影斜。\n忽听数声新雁唳，云山回首渺天涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27018,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晓起漫兴","author":"张学仪","text":"帘开梁燕觅泥忙，冉冉薰风欲倦妆。\n苑柳垂绦笼绣户，风桃飞片点书床。\n修眉不整因伤别，碧槛慵歌怯晓凉。\n不耐城东吹画角，听来浑欲断人肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27019,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"莲浦谣","author":"张学典","text":"溪水溶溶鱼唼唼，初上鸣桡木兰楫。\n雪羽䙰褷映倒光，晴光泛艳苍波阔。\n剪断春绡碧似烟，花垂两岸浓相连。\n澄明镜里红妆浅，菡萏新容出水鲜。\n风飘罗袖红丝蹙，山碧添愁眉半曲。\n悠悠玉浪浸春云，无穷柳色前堤绿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27020,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江南曲","author":"张学典","text":"落日乘潮去，荆歌戏采莲。\n相逢娇不语，佯笑堕花钿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27021,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宫词","author":"张学典","text":"内苑繁华柳放丝，御沟流水涨胭脂。\n欲将心事题红叶，未识随流付阿谁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27022,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏霞","author":"张学典","text":"冉冉长天散丽辉，韶姿染就媚春晖。\n光凝画阁铺文绮，彩映晴空曳舞衣。\n傍水更明添潋滟，因风欲碎转霏微。\n晚来至竟归何处，一片俄惊上锦机。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27023,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感亡姊旧居","author":"张学典","text":"绣网蛛丝镜满尘，闲花狼藉不知春。\n深愁怕见梁间燕，犹是呢喃觅主人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27024,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岁暮感怀","author":"张学象","text":"缉柳编蒲志苦辛，半生多难已忘身。\n橘林乏实供饘粥，突舍无烟荐藻蘋。\n空羡田真兄弟乐，堪怜任昉子孙贫。\n一函遗草谁为达，检得徒令泪满巾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27025,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杂咏 其一","author":"张学象","text":"明镜如满月，朝朝弄妆靓。\n一自弃尘埃，不照孤莺影。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27026,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杂咏 其二","author":"张学象","text":"夙昔爱琴鸣，流泉指下生。\n子期今已没，谁听断肠声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27027,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晓景","author":"张学圣","text":"搔首见残月，幽然晓色嘉。\n迎风抽草带，挹露落琼葩。\n是物含春意，何方驻岁华。\n只宜倾绿醑，尤胜试香茶。\n海气腾寒旭，江烟作早霞。\n数声听渐远，争起噪群鸦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27028,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春暮","author":"张学圣","text":"萋迷春晚心，日暮鸟归林。\n一点花才落，空庭草已深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27029,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"閒望","author":"张学贤","text":"开窗看落日，还似晓迟迟。\n波动风来后，花残雨过时。\n几回闻乳燕，懒去折芳枝。\n惟对初生月，清辉共映池。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27030,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春暮","author":"张学贤","text":"阶前草渐碧，独坐惜残花。\n蛱蝶双飞去，疑春在别家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27031,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"冬初即目","author":"陈慧珠","text":"吴绵初熨帖，弹指已秋残。\n人月平分瘦，江天一色寒。\n窗虚风力峭，树老叶声乾。\n枨触西堂里，濡毫兴未阑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27032,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送柳门弟之沔阳","author":"陈慧珠","text":"念子乍为客，扁舟下武昌。\n几朝风日好，一棹荇花香。\n去路江涛阔，山城落日黄。\n莫缘暂离别，俯首对斜阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27033,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"湖上晚归","author":"胡缘","text":"买棹寻春背夕晖，一双蝴蝶上人衣。\n明湖十里春无迹，带得花香满袖归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27034,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"留春","author":"胡缘","text":"留春无计送春回，泥饮何须婪尾杯。\n长日暗移新节序，绿阴深护旧楼台。\n几番风信吹桐乳，一夜雷声迸竹胎。\n睡起关心无别事，卷帘好待燕归来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27035,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋夜吟","author":"胡缘","text":"秋风淅沥秋月明，秋云澹澹秋露清。\n高楼夜坐百端集，银河耿耿西南横。\n秋声一片{立寿}衣杵，彻夜凄凉不得住。\n铜炉香烬更漏残，一夜閒愁添几许。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27036,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题明小泉居士戈止赏鞠吟后","author":"胡缘","text":"秋气入林樾，寒花开晚艳。\n达人羡高节，藉此俗骨砭。\n至今荣寿堂，往事如电闪。\n犹想开樽时，各各张坛坫。\n诗追杜陵豪，酒倾桑落酽。\n七贤韵互酬，一老翰独染。\n留传砑粉笺，墨澹光芒敛。\n弆藏赖云?，携赠戒仆傔。\n扁舟溯空明，归途犹永念。\n微闻担稻歌，凉月出野店。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27037,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋夜","author":"胡缘","text":"脱叶何曾上故茎，乱虫苦作不平鸣。\n已教楚客愁难遣，况听高楼擪笛声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27038,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西溪","author":"胡缘","text":"残云逐归禽，落日前村暮。\n荒林木叶多，风吹如急雨。\n镫火出柴荆，隐隐闻人语。\n一声古寺钟，月挂西溪树。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27039,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"野花","author":"胡缘","text":"谁遣名葩在野塘，嫣红姹紫斗春光。\n一般雨露无私被，到处郊原有异香。\n逸客孤芳惟自赏，村姑薄媚不成妆。\n夕阳影里归来晚，为惜韶华醉一觞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27040,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送春词","author":"胡缘","text":"绿阴如幕草如烟，九十韶光弹指还。\n几处莺啼听不得，高楼烂醉夕阳天。\n水晶帘卷独吟诗，尚有残红恋故枝。\n风送榆钱时满地，阿谁教作买春资。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27041,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"琴韵楼春尽遣怀 其一","author":"胡缘","text":"搓烟垂柳一丝丝，帘押无风放故迟。\n正是养花天气好，又缘小病负芳时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27042,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"琴韵楼春尽遣怀 其二","author":"胡缘","text":"草痕得雨绿参差，初日烘窗燕语迟。\n满地落红閒不扫，自拈象管画乌丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27043,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"午梦","author":"胡缘","text":"午梦初残后，纱窗独坐时。\n卷帘归燕疾，堕地落花迟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27044,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"归宁后寄外","author":"胡缘","text":"社雨连朝洒麦田，辞家又值月初弦。\n菜花黄后桑芽白，好向东湖放酒船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27045,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舟次魏塘","author":"胡缘","text":"北下丘为里，乘流到魏塘。\n薄阴催稻秀，断岸叱牛忙。\n抟士多窑户，叉鱼习水乡。\n閒愁若为遣，恐少养生方。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27046,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登东塔","author":"胡缘","text":"绝顶风扶上，何从著点愁。\n菰蒲初出水，鸿雁渐惊秋。\n黄叶林中寺，夕阳溪上楼。\n登临还极目，得句又句留。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27047,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送大兄之广陵","author":"胡缘","text":"明月扬州廿四桥，送君此去路迢迢。\n纵饶词句飞《金屑》，更有何人按玉箫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27048,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"落花","author":"胡缘","text":"花事浑如梦，韶光日暗驰。\n残霞烘远树，香雾匝新枝。\n小院莺啼后，高楼帘卷时。\n将飞犹恋恋，欲落故迟迟。\n新涨碧于染，浓阴绿渐滋。\n风吹依细草，雨急点芳池。\n春色三分尽，秾华一夕衰。\n江南有孤客，绕树独吟诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27049,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舟中望马厩庙山","author":"胡缘","text":"雅山之北案山南，翠阜隆起瞰澄潭。\n虽无洞壑深窈窕，平田遥望堆晴岚。\n图经地志均失载，马厩名因野庙在。\n当年遵海岂至此，或因女吴通行李。\n簟茀南来骑似云，高冈亦散紫骝群。\n后来秦皇鞭石时，指挥列嶂如市儿。\n尔独倔强遁荒野，不随九峰环卫海东陲。\n作诗吊古增惆怅，芥子须弥无定相。\n苦忆牛山陨涕人，齐女思归长北望。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27050,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晚过弄珠楼","author":"胡缘","text":"高楼面湖水，水光澹容裔。\n扁舟一叶归，碧云起天际。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27051,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"琴韵楼夜坐","author":"胡缘","text":"凉风吹井梧，淅沥飘残叶。\n开轩乘晚凉，庭院澹将夕。\n月出两头纤，清影入帘额。\n喓喓阶下螀，啼破一痕白。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27052,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"月夜","author":"胡缘","text":"小院夜沈沈，幽人弄素琴。\n诗因多病减，愁到暮天深。\n离恨谁家笛，捣衣何处砧。\n怕他双鬓影，一夜被霜侵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27053,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游海幢寺","author":"梁德绳","text":"春波潋滟漾轻桡，共访禅门到竹寮。\n人语不闻香界静，花光时引鸟声嚣。\n参差古殿依山树，早晚疏钟应海潮。\n归去日斜馀兴永，吟情相与挽长条。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27054,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"镫下写玉篇","author":"梁德绳","text":"百和馀香袅篆烟，镫笼蜡纸照残篇。\n一章急就窗前课，往事沈思十载前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":27055,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]