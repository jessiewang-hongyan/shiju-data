[{"title":"舟中远眺","author":"林镐","text":"两岸寒郊一望赊，西风吹过片帆斜。\n橹声入港听非雁，枫影隔林疑是花。\n积潦乍消空宿麦，荒村欲破散饥鸦。\n可怜租税从何出，残岁流亡定几家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":16978,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"从韬光至云栖途中即景","author":"黄恺镛","text":"出入丛篁林，山溪间村坞。\n濛濛夕照中，人烟古原树。\n白云扬微钟，樵径纷堪数。\n日暮投僧房，猿啼夜深雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":16979,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杂诗","author":"黄恺镛","text":"高堂有旨酒，列坐有嘉客。\n相逢燕赵徒，携我酌春夕。\n香雾蒙玉壶，飞花落瑶席。\n狼籍驼蹄羹，照座浓琥珀。\n美人红罗襦，微微送廊芗泽。\n酒酣闻浩歌，歌声惨不怪。\n劝客尽此觞，光阴如电激。\n今日清镜颜，明日青山魄。\n百年不可知，须为目前惜。\n四座感此言，举觞更浮白。\n乐哉此夕饮，髡亦能一石。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":16980,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"敬题先大父遗杖","author":"黄凯钧","text":"未能家庙置衣裳，惟此遗筇七尺长。\n犹记晴和随出入，齐看九十尚康强。\n玄孙解捧夸同里，社酒扶归先一乡。\n寂寞人间将卅载，小同青鬓亦添霜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":16981,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夏日幽居","author":"黄凯钧","text":"白芨花残半夏生，经时不向市中行。\n一双啄木忽飞至，和我山房捣药声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":16982,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将至淮上访黄心庵以诗先之","author":"徐世钢","text":"秋风曾订约，莫谓我愆期。\n飘泊真无状，穷愁但有诗。\n投林飞鸟倦，歧路蹇驴迟。\n相见弗相讶，新添两鬓丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":16983,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自题临赵承旨画","author":"徐世钢","text":"山转溪迥去路遥，桃花几树柳千条。\n声声布谷一犁雨，买犊人归树里桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":16984,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠漱冰上人","author":"沈大成","text":"幽澜一勺汲清泠，早谢湘江载月舲。\n定里春风间挂锡，吟边夜雨罢谈经。\n一编未放生涯冷，片席容分佛火青。\n我比香山年木老，肩舆鸠杖更谁停。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":16985,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"精严寺","author":"李三才","text":"挈友间行及早凉，精蓝西畔足徜徉。\n不知半日逢僧话，万树风声下夕阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":16986,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蟋蟀","author":"李四维","text":"山郭江村雨后凉，西风吹冷豆花香。\n疏篱草径行人少，蟋蟀吟时正夕阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":16987,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"城陵矶","author":"沈梅","text":"群山青不断，峭壁两崖开。\n风助孤帆上，江穿乱石来。\n东陵纷草树，西楚接楼台。\n直恐间关老，扁舟七往回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":16988,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病起","author":"沈梅","text":"支离衾枕岁时迁，强起寻春倍惘然。\n芳草当门随路直，落花浮水到根圆。\n谈空示病同摩诘，采药求仙笑偓佺。\n稍喜园林风渐暖，新晴恰在夕阳边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":16989,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"湖上","author":"路斯京","text":"短帽青衫绿绮琴，临邛大道访知音。\n柳惊拂翠东风面，花惜飞红夜雨心。\n潭水云沈千尺黑，玉楼箫怨十重深。\n斜阳买得湖光住，捐尽层波万点金。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":16990,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续感秋 其一","author":"童凤诏","text":"平野苍茫绕紫岑，楼高不觉峭寒侵。\n风尘雕鹗摩空健，橘柚人家向晚深。\n泊渚当年谁放棹，挑镫永夜但闻砧。\n成连方是真同调，萧瑟蓬莱一曲琴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":16991,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续感秋 其二","author":"童凤诏","text":"负郭曾无数顷田，下帏独注蠹鱼篇。\n逢人漫作嵇生傲，知我终期鲍叔贤。\n粳稻花香晴放犊，菰蒲叶暗夜行船。\n输他无限江村景，欲赋间居已惘然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":16992,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续感秋 其三","author":"童凤诏","text":"翛然门巷昼常关，抱影空庐独往还。\n鹤唳三秋声转警，豹藏七日色逾斑。\n江山平远尘氛外，云雨荒唐朝暮间。\n闻道微霜初度处，蓼花芦叶落溪湾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":16993,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浴温泉宿紫云庵","author":"叶以照","text":"竹影萧萧纸帐悬，僧寮清绝不成眠。\n白龙潭下飞流急，一夜泉声到枕边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":16994,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日山居","author":"叶以照","text":"秋树瘦无比，秋山淡可怜。\n空亭长寂寂，衰草带寒烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":16995,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山亭新霁","author":"叶以照","text":"林下雨初霁，山亭空翠飞。\n绿萝长几许，著地扫苔衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":16996,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杂感","author":"孙甡","text":"出门风雨多，入户愁思结。\n风雨乱我怀，愁思白我发。\n秋色无边来，阴虫助凄切。\n伊人荣悴同，触景感离别。\n岂无芝与兰，著体久芳洁。\n怅望远莫贻，江波澹明灭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":16997,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠陆少府东隅","author":"刘振智","text":"秋风谡谡楚江寒，路界通衢作尉难。\n四十年来双短鬓，三千里外一微官。\n饮中佳客邀篱菊，画里新诗托畹兰。\n回首高堂云水沓，好将清慎报平安。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":16998,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"襄游道中","author":"刘振智","text":"望望荆门路，征车晚更艰。\n风高羊角墓，秋老虎牙关。\n清磬不知寺，夕阳无阴山。\n宜城多美酿，凭仗一开颜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":16999,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送华亭之吴下","author":"傅均","text":"西风送客雨连宵，江上孤舟正寂寥。\n曙色微分瓜步树，寒声秋拥海门潮。\n刀头乐府悲歌里，白首斑衣涕泪遥。\n越水吴山千万里，忆君东望几魂销。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17000,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蛩声","author":"傅均","text":"蛩声何切切，不断花深处。\n夜半寂无人，残月在高树。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17001,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送野园之镇远","author":"傅培","text":"黔东是我曾游处，今日轻帆尔又过。\n垂老弟兄当远别，临歧涕泪各悲歌。\n水连湘北风涛壮，地接滇南瘴疠多。\n回首天涯儿女小，官斋岁月易蹉跎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17002,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登太白楼","author":"傅垣","text":"骚人谪去千年古，江上长传太白楼。\n造物生才多不偶，登高有客又悲秋。\n云边雁影当窗出，天际涛声抱郡流。\n惟爱郎官深夜月，清晖依旧似前游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17003,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闻笛","author":"傅垣","text":"美人凭画阁，玉笛弄高秋。\n一片中天月，清光若为留。\n我情亦何遣，归梦渺难求。\n消息经年断，征途阻且修。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17004,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春眺","author":"岳东瞻","text":"信步寻春去，环郊绿一围。\n花香涵雨润，柳絮逐风飞。\n舞蝶留疏影，歌莺弄落晖。\n徘徊溪路转，携手送云归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17005,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"北固楼","author":"李蟠","text":"踏阁攀林兴未休，茫茫吴越此登楼。\n微云卷雨来京口，落日回光见泰州。\n城郭对分南北限，江山合抱古今流。\n仲谋往事无人问，铁瓮笳声起暮愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17006,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"访圆桐道士不遇","author":"张廷兰","text":"西风卷黄叶，秋气满空山。\n乃与二三子，来游云水间。\n古松盘谷口，飞瀑绕禅关。\n问讯烧丹客，疏泉夜不还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17007,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄万鹤峰","author":"张廷兰","text":"晨兴蓬户掩，凉意在庭柯。\n落叶前阶满，秋声昨夜多。\n故人隔溪水，诗思寄烟萝。\n曾有黄花约，西风策蹇过。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17008,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋怀","author":"陈黉","text":"西风随雁影，吹落洞庭波。\n黄叶一林满，清霜昨夜多。\n美人梦凉月，之子隔烟萝。\n秋思长无极，徘徊倚瑟歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17009,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晚泊","author":"黄湘南","text":"烟明水净小洲围，间倚孤舟对落晖。\n细浪翻风鱼欲出，残云拥树鸟知归。\n川原历历荞花秀，关塞萧萧客旅稀。\n生事不堪逢岁暮，且从江上学忘机。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17010,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"永兴夜泊","author":"黄湘南","text":"重重山树暗，历历水花幽。\n落日荒城市，残云古驿楼。\n飘零仍七泽，寂寞即孤舟。\n入夜看明月，乡关动客愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17011,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渡湘江","author":"黄湘南","text":"满林黄叶鸟声稀，渡口微风拂客衣。\n十幅轻帆天外落，澄江如练一船归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17012,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"发沅江","author":"黄湘南","text":"午发沅江县，微风一棹安。\n山趋南嘴尽，水入洞庭宽。\n极浦澹空翠，芳洲生暮寒。\n萧萧惊岁晚，天外雁声残。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17013,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过大目寺","author":"黄湘南","text":"笋舆度危岭，兰若响疏磬。\n满院修竹深，参天古松劲。\n林光静猿心，花气和鸟性。\n石龛爇沈檀，香散微风定。\n我来礼瞿昙，尘心一时净。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17014,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"仁儿读书鄂湖僧舍","author":"曾衍先","text":"招提萧瑟意何如，遥念挑镫夜读书。\n面壁长年应倍悟，达摩功胜渡江初。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17015,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春晚","author":"罗修兹","text":"斋居白昼静，桃李绿阴生。\n鸟性悦暄节，山光开骤晴。\n碧苔缘不尽，红雨落无声。\n未惜春将暮，悠悠玩物情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17016,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"道士洑","author":"张祈倬","text":"淼淼长江水，磷磷道士矶。\n江豚吹浪出，石燕掠空飞。\n树倚悬岩立，帆随远岸微。\n放翁诗最好，吟罢想依稀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17017,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画","author":"张祈倬","text":"山径如闻伐木声，岩前坐见白云生。\n深林绝壑多歧路，莫向斜阳尽处行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17018,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"偶步承熙寺","author":"李馥","text":"熙宁古刹有遗踪，零落亭台第几重。\n镫影照残僧鬓短，苔痕添上佛头浓。\n豫章白昼号风雨，废院黄昏寂鼓钟。\n四十八庵何处问，荒烟如许一扶筇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17019,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梦芗阁次五叔父韵","author":"陈廷绅","text":"久客消间俗累轻，凭阑凝望远山平。\n眼前树影横秋色，耳底溪流咽雁声。\n惜忆香醅消旅邸，于今诗思落江城。\n探幽恰喜无余事，自向空阶彳亍行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17020,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜宿田家","author":"赵文楷","text":"月出一丈高，众星垂纂纂。\n驱车问田舍，径窄苍耳满。\n犬吠松溪寒，花繁竹篱短。\n田父知客来，倾壶春酿暖。\n自言久不雨，苗长欲生秆。\n县吏正催科，追呼不得缓。\n我今苦行迈，何时遂疏散。\n亦知尘土容，不入烟霞伴。\n夜半邻鸡鸣，神清梦魂断。\n天明登前途，露下衣如浣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17021,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宣城五日","author":"赵文楷","text":"独倚危楼望眼醒，轻寒微雨昼沈冥。\n一春花事愁中尽，五月鹃声梦里听。\n南浦离离芳草绿，西山漠漠晓峰青。\n他乡五度蒲觞节，自笑年来逐浪萍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17022,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"汉阳","author":"赵文楷","text":"江流东注大军山，汉上孤城扼楚关。\n三国旧愁春浪碧，千年遗垒夕阳殷。\n樵歌牧唱刘琦墓，沙鸟风帆鲁肃湾。\n我欲招魂凭楚些，夜深疑有鬼雄还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17023,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"五月十一日见姑米山","author":"赵文楷","text":"三日天风便，遥看姑米山。\n五峰排水面，一线出云间。\n远目真空阔，狂涛若等闲。\n舟人齐举首，惊喜破愁颜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17024,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过那霸人家","author":"赵文楷","text":"编蒲席地竹帘栊，六扇屏开面面风。\n一种清香消不得，佛桑围在蛎墙中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17025,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游辨岳","author":"赵文楷","text":"平生恨不陟昆仑，岂料扶桑看晓暾。\n山鬼一祠秋祭祀，海天五阜汉屏藩。\n蓬瀛楼阁言皆幻，泰华儿孙势亦尊。\n三百年来余战垒，鼎分遗迹竟何存。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17026,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九日登盛林山","author":"姚学塽","text":"孤阜试登攀，阴晴指顾间。\n归云仍带雨，斜日忽衔山。\n风物重阳好，浮生几日间。\n明年望乡处，落叶满燕关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17027,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"沅州对月怀都门故人","author":"姚学塽","text":"秋色满芳草，虫声生暮寒。\n沅江一片月，燕市几人看。\n忆昔同清赏，衔杯每夜阑。\n西风知我意，吹梦到长安。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17028,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晓发施秉 其一","author":"姚学塽","text":"邻鸡呼客起，屋角月尚好。\n惊鹊翻风林，寒蛩泣露草。\n于役有程期，戒途不辞早。\n出郭转清旷，云山澹秋晓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17029,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晓发施秉 其二","author":"姚学塽","text":"宿雾迷深林，飒飒疑风雨。\n朝曦射重冈，历历见村坞。\n小邑石为田，念此农民苦。\n所欣俗淳朴，萧然似太古。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17030,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重题飞云岩","author":"姚学塽","text":"云飞自何处，高压此林端。\n石气青天湿，泉声白日寒。\n直穿危磴上，却立小亭看。\n远役兹游最，行行重倚栏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17031,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"小重阳日作","author":"姚学塽","text":"忽忽充重九，萧然仍掩扉。\n林风惊宿雨，云日漏朝晖。\n愁积慵开卷，寒深感授衣。\n趁时筑场圃，乡国岁频饥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17032,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋夜对月","author":"姚学塽","text":"旅思畏秋深，幽怀便夜静。\n挂空得佳月，照此无尘境。\n露草浮寒光，风林簸疏影。\n一声烟外钟，坐觉衣裳冷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17033,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送费芷卿上舍南归","author":"姚学塽","text":"秋雨夜来晴，秋风落叶声。\n故人从此去，何日到菰城。\n小市青山绕，高堂白发生。\n间居有真乐，底事羡浮名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17034,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"立秋前一日作","author":"姚学塽","text":"卧闻急雨声，起视翻知误。\n西颢有先驱，回飙入庭树。\n岂不爱微凉，所惧岁将暮。\n看山秋更佳，谁踏江亭路。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17035,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"歌场 其一","author":"邵葆祺","text":"歌场冷落旧朱门，适景园西暮霭昏。\n忽听琵琶重下泪，刘琨家伎属桓温。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17036,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"歌场 其二","author":"邵葆祺","text":"羽林早引孤儿队，戟府新传异姓王。\n见说梨园旧子弟，无裙歌袂又飞扬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17037,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己未正月十八日书事 其一","author":"邵葆祺","text":"一扫云霾迹，青阳气万重。\n炎威初寂灭，天罚尚宽容。\n犹胜然脐败，争看系颈从。\n宏羊烹此日，会待寝边烽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17038,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己未正月十八日书事 其二","author":"邵葆祺","text":"诏狱纶扉去，惊传赤棒呼。\n闻收大丞相，如缚一庸奴。\n北寺通侯泣，西曹法吏趋。\n却留吟句在，解叹月轮孤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17039,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己未正月十八日书事 其三","author":"邵葆祺","text":"仿佛黄头饿，随身无一簪。\n苦依幽室冷，愁恋画堂深。\n七尺珊瑚树，千丛珠玉林。\n粉侯仍赐宅，故第不堪寻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17040,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己未正月十八日书事 其四","author":"邵葆祺","text":"复壁金难掩，重帷玉亦残。\n生茔石翁仲，死敛白衣冠。\n抄岂同瓜蔓，丧惟剩柳棺。\n凄凉萧寺里，鬼火不禁寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17041,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己未正月十八日书事 其五","author":"邵葆祺","text":"二十年如梦，临期酒一尊。\n钱神空号癖，债帅几蒙恩。\n因果惊狂衲，阎罗恫佞魂。\n九原逢介弟，相向更何言。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17042,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己未正月十八日书事 其六","author":"邵葆祺","text":"未亡应亦族，侥幸武安侯。\n专阃靴刀误，分茅带砺优。\n恩原推肺腑，功讵出兜鍪。\n末羯材尤下，随人作楚囚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17043,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己未正月十八日书事 其七","author":"邵葆祺","text":"投匦纷如许，螭坳俨豸衣。\n宫中三箧满，槛外一镫微。\n此日简章密，当年封事稀。\n曹唐已仙去，身后有光辉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17044,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己未正月十八日书事 其八","author":"邵葆祺","text":"已奋雷霆击，仍宽雨露施。\n泣闻哀痛诏，喜望太平时。\n印绶诸王领，旌旄大将为。\n好承初化意，四野问疮痍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17045,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏史","author":"邵葆祺","text":"高阁深源事竟然，漫夸夷甫不言钱。\n名归青史怜他日，望重苍生忆往年。\n入水牯牛空恋佛，舐丹鸡犬易登仙。\n儒林声气禅林味，祇为人才惜此贤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":17046,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]