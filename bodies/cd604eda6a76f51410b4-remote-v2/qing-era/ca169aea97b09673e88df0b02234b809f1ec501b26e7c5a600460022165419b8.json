[{"title":"吴山寓楼迟吴渔门不至","author":"冒春荣","text":"只有吴公子，频来慰客愁。\n空山悲落日，积雨卧清秋。\n贫贱余青眼，艰难到白头。\n孤怀无可寄，为尔一凭楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15217,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送客之淮阴兼讯长沙朱兰田客况","author":"冒春荣","text":"秋老淮阴去，悲哉行路心。\n寒沙枫叶早，孤艇荻花深。\n有客羁萧寺，烦君问好音。\n不归复何事，徒使梦中寻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15218,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"石床","author":"郭元灏","text":"雨细飘新簟，云深护石床。\n半亭吹落叶，一枕纳微凉。\n林鸟依依倦，岩花寂寂香。\n支公遗麈在，明月下方塘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15219,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"半山亭同陈益如顾嵎山作","author":"石渠","text":"孤峰天际插，一径路回环。\n目已穷千里，身才到半山。\n松风时谡谡，鹤梦自闲闲。\n欲尽登临兴，藤萝手自攀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15220,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三月十五夜同蛾窗芝珊家冲飞赋","author":"石渠","text":"红稀绿暗漫魂销，且把深杯作意浇。\n半壁斜阳犹昨日，一春圆月剩今宵。\n谁家陌上青骢马，是处楼头碧玉箫。\n如此风光须尽兴，高歌莫负夜迢迢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15221,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岁暮书怀","author":"石渠","text":"短景荒荒逼暮寒，北风吹入衣布单。\n无多儿女深情系，有几亲朋热眼看。\n身贱徒然伤老大，家贫倍觉怯年残。\n饥来一食寻常事，惭愧陶潜欲乞难。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15222,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过访随园主人不值","author":"汤扩祖","text":"花含宿雨柳含烟，隐士园林别有天。\n高卧白云人不见，一家鸡犬翠微巅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15223,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"顾亭林访陈顾侍郎野王遗迹 其一","author":"王廷享","text":"海隅风物纪来真，策策探幽不厌频。\n浮世难逢千岁鹤，断碑如对六朝人。\n沧桑几度名犹在，金紫何缘梦再亲。\n寂寞亭林湖畔冢，只余荒寺伴青磷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15224,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"顾亭林访陈顾侍郎野王遗迹 其二","author":"王廷享","text":"禅关寂寞几更迁，尘幌萧然古佛边。\n一旅勤王悬日月，千秋护法黯风烟。\n清光渺渺平湖远，灵迹悠悠片石传。\n为问九原逢故主，舍身曾否到诸天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15225,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"画华山坠驴图题跋","author":"方竹","text":"华山道上驴一蹶，天津桥畔鹃饶舌。\n炎宋官家三百年，城复隍兮只中叶。\n纷纭五季弄兵刀，黑龙检点加黄袍。\n燕夏二阴蚤根极，从兹滑乱持何牢。\n华山面识太平主，南北何曾一土宇。\n虞天诞降香孩儿，差强斧扆鼠变虎。\n值得先生笑口开，一笑还嘲一跌来。\n明日归山戏作此，且学大睡希夷子。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15226,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舟望","author":"黄家凤","text":"半山雨气半山晴，江上人家树作城。\n插遍早秧收尽麦，枝头犹自唤催耕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15227,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"途中杂咏","author":"张炯","text":"隔生仙骨本难如，幻迹流传属子虚。\n一自琴高乘赤鲤，何人解钓药渣鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15228,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄怀心余侄 其一","author":"蒋谦","text":"《大雅》沈沦后，名流泛滥时。\n长才人莫及，细意我能知。\n囊括元精秘，雕镌物象奇。\n百年文教洽，鼓吹继风诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15229,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄怀心余侄 其二","author":"蒋谦","text":"生逢明盛日，立志肯蹉跎。\n似汝匡时好，如余奈老何。\n云霄终竟隔，岁月等闲过。\n看取茅连茹，宁当遂薜萝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15230,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"小径","author":"蒋谦","text":"小径傍墙阴，欲行还踯躅。\n因怜落瓣红，转惜新苔绿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15231,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"肇庆舟中","author":"李梦松","text":"朱曦得残暑，金风吹觉善。\n牵事心不宁，身倏为之转。\n荡舟过曲坞，潮自为深浅。\n息虑敛烦襟，孤鸿入绣巘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15232,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"偶意","author":"李梦松","text":"北斗不可挹，南箕不可扬。\n古人已有言，何能为感伤。\n人皆饭王孙，漂母反不贵。\n立身在贫贱，敢不为之地。\n咄咄东郭人，此态堪一喟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15233,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游鼎湖","author":"李梦松","text":"寺钟敲木末，幽草布香软。\n泉声出小谷，樵路行初稳。\n白云杂还起，虚袅作龙蜿。\n穆然钦古帝，吾心得旷远。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15234,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"罗汉过海图次韵","author":"刘堮","text":"海于天地为巨物，横目见此惊无边。\n或云众水所蓄积，坐令陆地为深渊。\n我闻尊者此示象，一航稳似香台莲。\n飓风不作鲛鳄静，知有神物为之先。\n舟行不徐亦不疾，到彼海外当何年。\n大鹏不徙爰居避，海若自小河伯旋。\n惟有日月争出没，腾晖照耀波光鲜。\n送者几辈自厓返，回顾但见帆微翩。\n此时秘怪千万万，争欲顶礼焚香烟。\n仁者愿大无分别，孰为灵蠢孰凡仙。\n当时各各契微妙，回视海水川渠然。\n了知此说是真实，挥毫更以丹青传。\n纷纷大小都滞相，拘墟邹衍方谈天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15235,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"沧州铁狮子歌用韵","author":"刘堮","text":"寻常刻石非不伟，门外屹立如郁垒。\n年深不免有缺坏，一笑摩挲凭蓟子。\n似此顽铁多岁年，似以无用终其天。\n彫刻云根纵云巧，牙爪摧残绝可怜。\n理本如斯漫惆怅，一事一物有衰旺。\n君不见《伶官赞》里说庄宗，晚节何衰始何壮。\n忆昔歇马乘午凉，知有铁铸百兽王。\n古堞颓垣半禾黍，平沙细草眠牛羊。\n有物不动如被掳，又似天生在兹土。\n较量其寿定千年，亲见此城盈万户。\n休嫌黯淡无辉光，若为干镆真不祥。\n至刚必折本至理，丰城岂得终埋藏。\n受成不变岂非数，坐阅沧桑等朝暮。\n时有过客揽形状，讵逞雄威吓狐兔。\n昔常询诸博物家，此兽产处逾流沙。\n吼声一发震山谷，遍体火生如紫霞。\n画成见者皆惊叹，虽未即真思过半。\n以铁为之世更希，铸处光应上霄汉。\n遂令顽质发光彩，亦以难毁享遐算。\n问渠岁久何所为，春长藓花寒雪片。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15236,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卧钟","author":"刘堮","text":"已是无僧顾，还应比石坚。\n苍苔古纽上，春草寺楼边。\n虚壑留遗响，空山想昔悬。\n宏声本无尽，强起待他年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15237,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"废檠","author":"刘堮","text":"委地怜长弃，焚膏念旧勤。\n光无今昔异，人自短长分。\n藜火非凡照，珠光更绝熏。\n分辉知不得，聊此继斜曛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15238,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"历下亭和韵","author":"刘堮","text":"亭中浑胜坐孤篷，落日云山一望中。\n邂逅朋俦尽名士，连延秋色足花丛。\n近人鸥鸟原无滓，带雨山云久渐空。\n双屐几番湖畔路，那能鸿爪问西东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15239,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过田家","author":"牟峨","text":"十里重重山对开，一逢佳景一徘徊。\n村于丛柳疏边出，人自高粱绿里来。\n当路横垂林有果，傍篱稳卧犬无猜。\n倩谁为绘田家景，添个征鞍曲水隈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15240,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海上分韵得天字","author":"牟峨","text":"晨昏谁职汐潮权，气象当年有万千。\n始信东南真缺地，骤惊风雨不因天。\n蜃楼市结蓬瀛外，番岛人来日月边。\n我欲乘槎登彼岸，测量横占几星躔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15241,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登滕王阁和子乔","author":"王克绍","text":"扶病上高阁，子安安在哉。\n文成亦有命，老去莫论才。\n山色周遭在，江流日夜来。\n感君盛意气，凭吊不胜哀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15242,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜余春","author":"于学谧","text":"当时只是望春回，不道春来愁共来。\n于今最惜残春去，无奈春去愁偏住。\n我愁不是为春愁，愁在阊阖十二楼。\n帝阍渺渺凭谁叩，弱水茫茫绝行舟。\n却从麻姑向东海，卧看沧桑几千载。\n桑田变尽海中波，一段心情镇常在。\n我有琢玉连环纽，愿系君恩得长久。\n我有百炼双吴钩，与君试斩蛟与虬。\n天高日远难为遇，以暗投人不知处。\n玉京回首空白云，瑶台别路隔红尘。\n花前可惜对余春，清歌未了涕沾巾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15243,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和王南溟见寄原韵","author":"张铸","text":"不是终南路，何妨一闭关。\n坐看云出没，卧听水潺湲。\n花落鱼吞去，烟飞鸟带还。\n潇潇风雨夜，随处长苔斑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15244,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谷行","author":"张铸","text":"行行危谷里，夹岸草萋萋。\n树束青天窄，山围白日低。\n游人冲暑去，疲马向尘嘶。\n前路知何处，孤村暮色西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15245,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游悬空寺","author":"邓克劭","text":"石屏千仞立，古寺半空悬。\n净土绝尘境，岑楼缀远天。\n一弯岩畔月，半壁画中禅。\n俯视行人小，飘然意欲仙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15246,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"张贞女","author":"赵鹤","text":"早寡已足悲，况当将嫁时。\n艰难思鲁女，风雨黯湘累。\n一痛成今古，终身断涕洟。\n妾心如古井，地下不须知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15247,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏古呈秦清定先生","author":"赵鹤","text":"奉母徐元直，全身管幼安。\n老瞒欺不得，落落两儒冠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15248,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怀中诗","author":"马体孝","text":"赋性由来似野牛，偶携竹杖过江头。\n饭囊带露装残月，歌板临风唱晚秋。\n两足踏开尘世路，一生历尽古今愁。\n从兹不复依门户，荒犬何劳吠不休。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15249,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"东镇夜发","author":"刘壬","text":"萧条东镇夜，行客意凄凄。\n月影随疲马，风声杂晓鸡。\n白云家远近，黄叶路高低。\n不见宏农守，青囊我倦携。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15250,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋夜","author":"刘时英","text":"不复闻刁斗，长吟酒一卮。\n寒蝉鸣古树，惊鸟落高枝。\n有恨人衰矣，无才歌已而。\n行藏那可问，辜负菊花期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15251,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"月夜作","author":"李尚德","text":"静夜待明月，月高人始眠。\n觉来明月色，犹在草堂前。\n起坐弄清影，孤怀方悄然。\n松风吹万籁，余响入山泉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15252,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"任节妇诗","author":"李尚德","text":"好水沟前月夜寒，柳林深处雪漫漫。\n闺中自有真婴臼，莫作寻常寡鹄看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15253,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登山","author":"潘性敏","text":"乘兴登山去，芳林渐欲曛。\n鸟归千嶂树，人下半溪云。\n曲径幽难觅，遥村近始分。\n行将居此地，麋鹿共为群。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15254,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山居寄张星乙","author":"吴锭","text":"一亩园中半亩花，萧然物外足生涯。\n吟成白雪难为曲，游遍青山懒到家。\n傍舍寒松曾驻鹤，当门疏柳亦藏鸦。\n故人若肯重相访，缸面新篘酒易赊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15255,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九月五日初雪","author":"吴锭","text":"渐觉重阳近，东篱菊绽初。\n秋风吹落叶，大雪到寒庐。\n宋玉悲遥夜，袁安怅索居。\n乾坤银一片，图画恐难如。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15256,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宿康子中山亭","author":"吴锭","text":"君住西山更在西，子孙相继老锄犁。\n云间贳酒方寻阮，柳下安炉独忆嵇。\n一枕落花春梦蝶，半窗残月晓听鸡。\n何当偕隐幽岩上，遍蹑真人万丈梯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15257,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春雾","author":"金孝懋","text":"未成浥滴望依微，正值春光嫩绿齐。\n小院暗疑梅雨密，平芜谁辨柳烟低。\n不愁步屟苍苔滑，只恐看花老眼迷。\n天上晓寒楼阁迥，衍波笺好试新题。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15258,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"未起","author":"金孝纯","text":"未起心犹寂，初回梦已空。\n曙光镫影外，春意鸟声中。\n菊枕频欹雨，芦帘不受风。\n自惭小室赋，无复蔡凝工。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15259,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"新凉露坐","author":"金孝纯","text":"小小盆池皱绿漪，嫩凉庭院晚风宜。\n人来茉莉香生处，秋在阑干雨过时。\n便作东坡瓜子会，更催杜老藕丝词。\n何当自入名山去，竹几蒲团静与期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15260,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晓发龙江寨和王惺园学使","author":"孙鲁","text":"已逐风尘迹，敢嗟行路难。\n五更山月小，六月海风寒。\n戍鼓沈松径，村鸡啼竹阑。\n兵戈消断久，无复惜荒残。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15261,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"立春日浦城道中","author":"孙鲁","text":"瓯越溪山尽足夸，劳人重复度仙霞。\n偶因身到聊题句，却为春来便忆家。\n野水何心常绕郭，疏梅无主自开花。\n经过南浦桥边路，碧草芊芊茁嫩芽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15262,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋山行旅","author":"何文焕","text":"西风下木叶，萧萧湘水波。\n空山黯秋色，肃肃鸿雁过。\n渺邈思帝子，羁人发长歌。\n徊徨骇岩壑，烟光晕薜萝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15263,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"大石屋","author":"何文焕","text":"结构高岩上，凌虚别有天。\n漫将山作屋，还就石为山。\n树色森遐坂，风声咽细泉。\n下方人不见，占断白云边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15264,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"再集永宇溪庄","author":"何文焕","text":"重游惬幽赏，首夏绿阴新。\n日月不可驻，风光殊悦人。\n丝桐发逸响，兴洽对金樽。\n窗静众香吐，树深百鸟喧。\n流云多故态，闲旷夙所珍。\n逍遥望千古，一笑付清言。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15265,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日有怀王修竹志熙","author":"何文焕","text":"名士今谁数，风流王子猷。\n一时文水别，八月武林游。\n虚馆绿阴晚，高原红树秋。\n何能忽相见，云远思悠悠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15266,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖杂咏 其一","author":"何文焕","text":"村深午后不闻鸡，时有幽禽隔树啼。\n问著春光何处好，胭脂桥在望吴西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15267,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯湖杂咏 其二","author":"何文焕","text":"船似飞凫掠断矶，屋如蜗壳掩寒扉。\n九斤潭下秋波阔，七里桥边春水肥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15268,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过半江叔惜阴书屋 其一","author":"陈莱孝","text":"仙客题诗处，秋来几度经。\n海茶红烂漫，山鸟翠娉婷。\n市远烟萝净，人闲笔墨灵。\n客嘲吾不解，安稳卧元亭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15269,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过半江叔惜阴书屋 其二","author":"陈莱孝","text":"吾爱吾宗老，风流孰与同。\n政多循吏绩，交有古人风。\n门对湖山好，家传唱和工。\n问奇来往熟，浑忘寂寥中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15270,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"初春睡起得句","author":"曹炜南","text":"日到蓬门睡起迟，偶然得句便成诗。\n客来欲问春深浅，试看梅开第几枝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15271,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"读袁机仲通鉴纪事本末 其一","author":"蒋元","text":"武皇英略重开边，通道西南邛冉滇。\n一自夜郎臣服后，僰童笮马自年年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15272,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"读袁机仲通鉴纪事本末 其二","author":"蒋元","text":"务勤远略广威恩，旄节兵戈出玉门。\n但使蒲桃天马至，不妨公主嫁乌孙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15273,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"书愤","author":"张诰","text":"屏迹空余世外身，十年怀抱怅难申。\n固知张咏常违俗，谁信曾参不杀人。\n虫臂鼠肝无作有，白衣苍狗幻疑真。\n伤心只为同心死，说与旁人恐见嗔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15274,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"立秋日山庄即事","author":"张诰","text":"昨宵一叶下庭梧，为报山庄烈暑徂。\n投老纵惊时易换，迎凉如遇病初苏。\n远林残照疏蝉响，小院新晴独鸟呼。\n问我沈吟亦何事，临溪却笑柳州愚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15275,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"汪员外鱼亭招同杭太史堇浦陈丈江皋陆二筱饮集振绮堂即送江皋之余杭","author":"何琪","text":"旧雨分携思不禁，尊前录别共题襟。\n舟穿北郭拿音缓，山入南湖黛色深。\n小醉定寻仙姥酒，归装应载伯牙琴。\n洞霄览胜虚前约，剧欲相从快一临。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15276,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"从七佛寺上云栖山","author":"吴琦","text":"言寻七佛寺，晚向云中攀。\n秋雨飒然至，人行寒翠间。\n疏钟来树杪，远火逗松关。\n直造莲池座，潮音彻万山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15277,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"且种树斋对客","author":"盛复初","text":"客云种树人乘凉，吾言有地且种树。\n但得绿阴成幄能庇人，此身安论去与住。\n君不见昔时王子猷，借居种树盈庭幽。\n主人何人屋何处，子猷佳话今还留。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15278,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"即事","author":"费辰","text":"晓山烟湿翠冥濛，寂寂春回细雨中。\n新柳未匀浓淡绿，小桃初绽浅深红。\n燕归帘幕池塘冷，人静秋千院落空。\n白袷衣轻寒料峭，今朝花信几番风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15279,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山行","author":"杨奏瑟","text":"登山蹴云飞，便欲乘云去。\n白云不相待，先出岩巅树。\n云行但向风，我行犹窘步。\n独立倚半山，缓缓江村暮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15280,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登玉山县城楼","author":"杨奏瑟","text":"地扼东南隘，无关亦号关。\n楼当三面水，城割半边山。\n天马澄江外，虹桥落照间。\n骡车纷络绎，早晚不曾闲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":15281,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]