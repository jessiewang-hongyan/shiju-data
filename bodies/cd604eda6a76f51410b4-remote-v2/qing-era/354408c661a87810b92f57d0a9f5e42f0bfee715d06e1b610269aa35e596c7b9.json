[{"title":"哭母 其五","author":"章甫","text":"十丈莲花礼佛开，音容恍惚下莲台。\n儿孙妇女环坛哭，只管魂游不管哀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2559,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"哭母 其六","author":"章甫","text":"奈怙何兮奈恃何，终天饮恨几时过。\n无端展起葩经读，恼杀风人赋蓼莪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2560,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"午日观龙舟竞渡","author":"章甫","text":"红旗掣电鼓轰雷，画鹢飞凫竞渡来。\n夺锦吟诗人去后，是龙谁复出群才。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2561,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"七夕连雨","author":"章甫","text":"天孙无奈别离何，秋以为期始渡河。\n昨日洗车今坠泪，人间风雨莫嫌多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2562,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题黄壁山水","author":"章甫","text":"云烟尺幅势千寻，水色山光万象森。\n画意化工谁解得，浓偏浅浅淡深深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2563,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西施泛湖图 其一","author":"章甫","text":"一笑倾城已沼吴，泛舟不复醉姑苏。\n好风微皱新荷动，记得香生水殿无。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2564,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西施泛湖图 其二","author":"章甫","text":"绿柳丝丝曳碧山，环山流水自潺湲。\n五湖烟景知多少，引尔香魂到几湾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2565,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"东郊春兴","author":"章甫","text":"大块文章点缀工，十分春色海东东。\n晴光烘著閒花草，遮莫争娇绿与红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2566,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"自题琴棋书小照有引","author":"章甫","text":"浴月飞泉上竹梢，挑灯起草又棋敲。\n夜阑鼓罢移情曲，万里秋光一草茅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2567,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"自题水墨山水照 其一","author":"章甫","text":"流水空山自爱吾，清时有味与谁俱。\n解人道子心同素，画我红尘半点无。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2568,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"自题水墨山水照 其二","author":"章甫","text":"自落寰中一散人，袖云洞里认前身。\n写生妙手希藏拙，却笑无心已入神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2569,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"武陵桃","author":"章甫","text":"桃花渡水出山中，笑面奇开异样红。\n寰宇久非秦世界，仙葩何处不春风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2570,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"登鹿耳门远眺","author":"章甫","text":"孤悬一岛水中央，极目烟波万顷长。\n沙外数条将断线，云间几幅未归航。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2571,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西成即事","author":"章甫","text":"年丰万宝庆西成，四野都闻穫稻声。\n造物也怜农事苦，微风扇净日烘晴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2572,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"妆楼春夜宴集句","author":"章甫","text":"花有清香月有阴，长河渐落晓星沉。\n劝君更尽一杯酒，又典春奁半臂金。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2573,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"香闺秋夜思集句","author":"章甫","text":"不知秋思在谁家，风自西南故故斜。\n独坐黄昏谁是伴，应怜夫婿更天涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2574,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"暮春吟","author":"章甫","text":"褪粉残英馀几分，阑珊花事尚香闻。\n东风不为春情老，依旧花间好处薰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2575,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题香奁集后","author":"章甫","text":"谁咏香奁绝妙词，争传姓氏至今疑。\n和凝韩偓无须辨，自有温柔乡主知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2576,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"柳溪泛舟图","author":"章甫","text":"二月清溪一叶舟，柳丝夹岸弄轻柔。\n好风送过桥南去，乌笠红衫几处游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2577,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"仙姬送桂图为王芳圃弄璋志喜","author":"章甫","text":"妾住云楼佩玉琼，金风敲落桂花声。\n连枝结子君须记，认取灵根出太清。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2578,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"抚琴听者知音","author":"章甫","text":"千古牙琴遇子期，高山流水慰心知。\n而今也解琴中趣，漫说知希只自怡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2579,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海滨即景","author":"章甫","text":"晚风定后夕阳斜，泽畔行吟景亦嘉。\n水利生涯何处是，江枫一带卖鱼虾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2580,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梨花","author":"章甫","text":"玉骨冰肌祇自怜，溶溶院落月明天。\n閒梅若解邀君伴，让雪三分恐未然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2581,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"半截美人图","author":"章甫","text":"可是含羞可是痴，画中想像半猜疑。\n春容未肯全身现，留却春情在即离。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2582,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"挽亡友李瑾卿 其一","author":"章甫","text":"君平矜躁我疏狂，好友忘形两不妨。\n记得竹窗凉夜里，风风雨雨话联床。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2583,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"挽亡友李瑾卿 其二","author":"章甫","text":"追寻旧事订心知，少小交游老大期。\n来岁君年才及壮，不应便是了凡时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2584,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"挽亡友李瑾卿 其三","author":"章甫","text":"鹿岛分舟送远行，舟南舟北不胜情。\n可怜望断帆樯影，即是离群判死生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2585,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"挽亡友李瑾卿 其四","author":"章甫","text":"屈指还乡数夕晨，那知哀逝已三旬。\n香魂久著金风去，犹是思归话旧人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2586,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"挽亡友李瑾卿 其五","author":"章甫","text":"我滞归船泊鹭洲，君危频问我归不。\n不堪遗语传身后，肠断心伤恼石尤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2587,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"挽亡友李瑾卿 其六","author":"章甫","text":"君斋几案绝尘埃，芗泽摩挲日几回。\n冷落主人何处去，笔床茶臼不胜哀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2588,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"挽亡友李瑾卿 其七","author":"章甫","text":"天书一夜到瀛东，催促君回守故宫。\n闻道魂消芳不散，前身应是侍书童。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2589,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"挽亡友李瑾卿 其八","author":"章甫","text":"回首评花醉月时，频将银烛剪催诗。\n今宵吟尽思君句，可得魂归可得知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2590,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望云顶岩","author":"章甫","text":"绝顶名岩结佛区，诸峰罗列势全趋。\n云中楼阁烟中树，一幅天生万变图。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2591,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"从鹿洞过虎溪","author":"章甫","text":"鹿洞行云过虎溪，双峰竞秀望中迷。\n游山要有论山识，到此名山试品题。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2592,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雨中待渡图","author":"章甫","text":"濛濛烟雨碧沙流，古道苔深石骨愁。\n觅渡无人何处唤，隔溪隐约是渔舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2593,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"睡春吟","author":"章甫","text":"牡丹花下柳梢头，睡足芳情烂不收。\n借问黑甜何境界，春风无处不扬州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2594,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"饯春吟","author":"章甫","text":"九十春光剩已希，春情欲别尚依依。\n香风且莫催春去，容我吟诗送汝归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2595,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"瓶桃即句","author":"章甫","text":"半属佳人半属仙，玉瓶斜倚为谁怜。\n迎人自笑春风面，不管情人忆去年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2596,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"探梅","author":"章甫","text":"清高品格谢嚣尘，流水空山太古春。\n寒士云桥来过访，怜君耐冷共精神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2597,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"水墨牡丹 其一","author":"章甫","text":"占断清标第一香，墨池点缀亦花王。\n当时绚烂今平淡，声价依然重洛阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2598,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"水墨牡丹 其二","author":"章甫","text":"百两金花百宝栏，却嫌閒紫与流丹。\n春风归去春心老，合与诗人冷眼看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2599,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"水墨牡丹 其三","author":"章甫","text":"分种霜台第几葩，谁云富贵必豪奢。\n沉香亭畔仙春馆，争似孤芳不点瑕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2600,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"水墨牡丹 其四","author":"章甫","text":"魏紫姚黄莫浪誇，无双国色本无华。\n胭脂若买供时眼，羞落争娇锦绣花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2601,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梦蝶园怀古 其一","author":"章甫","text":"蝶梦芳心处士知，春风归去几多时。\n游人记得当年事，半月楼前一酒旗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2602,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梦蝶园怀古 其二","author":"章甫","text":"物化虚空万象悬，蘧蘧栩栩散云烟。\n满园都是华胥界，何处香魂觅醉眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2603,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"读黄莲士凤山拜黄吾野墓诗感咏","author":"章甫","text":"处士声名书画诗，凤山宿草几多时。\n黄公独拜先生墓，三绝风流七字碑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2604,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"纪梦","author":"章甫","text":"古刹名岩石洞天，梦魂飞过几云巅。\n鸡声唱断游山路，正欲沿溪唤渡船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2605,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和友春觞赠歌集句","author":"章甫","text":"春风一曲杜韦娘，逗出嘉宾锦绣肠。\n今日相逢听高唱，乌纱白纻自生凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2606,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和友春睡梦觉集句","author":"章甫","text":"睡足脂痕晕海棠，故烧高烛照红妆。\n惊回一觉游仙梦，溪水流来误阮郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2607,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"钓叟","author":"章甫","text":"江湖满地老秋风，莫把垂纶笑此翁。\n尚有一竿持在手，生涯到底未全空。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2608,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"即事偶成二律 其一","author":"六十七","text":"微茫岛屿片云孤，物产民风事事殊。\n绝好饔飧红脚早，天然篱落绿珊瑚。\n花无寒燠随时发，酒长琼浆不用沽。\n最是良畴耕凿易，欣然醉饱乐唐虞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2609,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"即事偶成二律 其二","author":"六十七","text":"饱啖槟榔未是贫，无分妍丑尽朱唇。\n颇嫌水族名新妇，却爱山蕉号美人。\n剧演南腔声调涩，星移北斗女牛真。\n生憎负贩犹罗绮，何术民风使大淳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2610,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"九日","author":"六十七","text":"朝来门巷集儒巾，屠狗吹箫共赛神。\n蝴蝶花残清入梦，鲤鱼风老健于春。\n酒浇幽菊舒黄蕊，琴鼓飞鸢飏碧旻。\n并著单衫挥羽扇，炎方空说授衣辰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2611,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"朱文公祠梅花 其一","author":"王联登","text":"海外巡檐笑几回，南枝开尽北枝开。\n参差造物非无意，知是风流太守来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2612,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"朱文公祠梅花 其二","author":"王联登","text":"冷落风尘漫自轻，春来占断自分明。\n广平赋就成佳话，铁石心肠更有情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2613,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"朱文公祠梅花 其三","author":"王联登","text":"海滨聊作美人家，醉后更阑月影斜。\n恼得诗人缘底事，请君试看典型花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2614,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"朱文公祠梅花 其四","author":"王联登","text":"乘兴寻芳共举樽，罗浮花下醉黄昏。\n夕阳掩映佳人影，莫认亭亭倩女魂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2615,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寄台湾巡使六给事 其一","author":"伊福讷","text":"东华尘土应怜我，南海烟霞尽属君。\n惆怅暮春好时节，白沙红树草连云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2616,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寄台湾巡使六给事 其二","author":"伊福讷","text":"浴日扶桑迥绝伦，花繁官阁静无尘。\n海天对月閒吟际，好报平安慰故人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2617,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"自题渡海图 其二","author":"余文仪","text":"真成宦海任西东，回首萍踪一瞬中。\n十载含香闻三省，五年樵鹤肃双熊。\n可能文字驱潜鳄，赖有精诚贯白虹。\n身入画图期共济，肯将华发负初衷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2618,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"留别松山观察以皇恩只许住三年为韵 其一","author":"余文仪","text":"忆昔长安道，同时侍玉皇。\n公方翔凤阁，予谬含鸡香。\n公才简帝心，捧檄来闽疆。\n予亦衔命出，连镳共一方。\n长溪接三山，灯火每相望。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2619,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"留别松山观察以皇恩只许住三年为韵 其二","author":"余文仪","text":"三山领十郡，公政惟春暄。\n愧予持布鼓，安敢拟雷门。\n虑囚参末议，稍稍窥篱樊。\n左提复右挈，卵翼感殊恩。\n正期侍颜色，朝命移朱幡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2620,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"留别松山观察以皇恩只许住三年为韵 其三","author":"余文仪","text":"朱幡出东宁，未至民先喜。\n东宁本荒服，伏莽多虎兕。\n吏黠营奸私，荆蓁欺兰芷。\n下车公毅然，为水不如火。\n期月风肃清，千里歌乐只。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2621,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"留别松山观察以皇恩只许住三年为韵 其四","author":"余文仪","text":"三载政大成，青草生囹圄。\n受代及瓜期，承乏适命予。\n竭蹶步后尘，鲁直公独许。\n不惜屈天潢，谓予长马齿。\n告予旧政教，相勖敦古处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2622,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"留别松山观察以皇恩只许住三年为韵 其五","author":"余文仪","text":"送公往朝天，公去予独住。\n坐公政事堂，尺寸守公度。\n宽猛本相济，非敢妄攀附。\n抚公旧松桂，复思新雨露。\n邮传秉节回，双旌喜重渡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2623,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"留别松山观察以皇恩只许住三年为韵 其六","author":"余文仪","text":"村社久巡历，风土公素谙。\n立马迎前驺，呼声乐且湛。\n公治推至诚，风雨皆和甘。\n予惟谨受教，举一思反三。\n独搔旧头颅，顾影殊自惭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2624,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"留别松山观察以皇恩只许住三年为韵 其七","author":"余文仪","text":"白日去鼎鼎，青鬓换华颠。\n政绩无可纪，素餐年复年。\n君恩许放归，山足尚轻便。\n布衣款戟门，重申旧缠绵。\n愿公崇令德，报国仗大贤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2625,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送干静专司马谢病归江右","author":"余文仪","text":"执手意无极，欲言心转忘。\n至人退即进，我法柔为刚。\n存道固存拙，不卑亦不亢。\n波澜生古井，兰蕙失芬芳。\n飞渡一泓海，置身千仞冈。\n愿言崇令德，特达看圭璋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2626,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题黄玉圃巡使台阳花果图绝句 其一","author":"吴王坦","text":"少许猊床侍释迦，一家眷属见昙花。\n遥知使节风清候，携得金茎洒异葩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2627,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题黄玉圃巡使台阳花果图绝句 其二","author":"吴王坦","text":"珍果图来命画师，拈花又写佛前枝。\n窗明几净清茶供，绝胜黄金铸象时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2628,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"社寮杂诗 其九","author":"吴廷华","text":"倒单生咬各纷拿，鲜炙馀烹腊作豝。\n功令只今禁承饷，省教计腿付头家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2629,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"社寮杂诗 其十一","author":"吴廷华","text":"早起樵苏邃谷东，佳材一概付薪翁。\n知音怕惹中郎赏，不剩荒厨焦尾桐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2630,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"社寮杂诗 其十四","author":"吴廷华","text":"绣褓文衣制未便，生儿随母浴清泉。\n十年新学唐人俗，五色丝穿长命钱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2631,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"社寮杂诗 其十九","author":"吴廷华","text":"墘窦门边淡水隈，溪流如箭浪如雷。\n魁藤一线风摇曳，飞渡何须蟒甲来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2632,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"九日登高","author":"吴性诚","text":"簿书鞅掌强登高，放眼云山气正豪。\n何处平台堪戏马，几人险韵敢题糕。\n青霄雁字书难觅，红叶霜林景未遭。\n沧海横流谁砥柱，狂澜无际任滔滔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2633,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"九日登高","author":"吴性诚","text":"不减清狂祇自宽，糗餐花饮且盘桓。\n气吞天地成空阔，人到蓬瀛极大观。\n曲径扶筇聊啸傲，方壶张盖笑寒酸。\n秋光指点斜阳外，清露嘉禾四野欢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2634,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]