[{"title":"九日","author":"葛宜","text":"黄菊萧疏放，重阳风雨哀。\n登高何处是，白雁故飞来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26095,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送日观之金陵","author":"葛宜","text":"送客金陵极望中，江流无恙片帆风。\n应知歌舞秦淮月，不与高楼梦里同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26096,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"芳树","author":"葛宜","text":"庭前芳树影参差，春暖莺啼争上枝。\n开落不堪人事改，青松独与岁寒期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26097,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"哀江南妇","author":"葛宜","text":"五月新蒲叶正齐，清江极目远萋萋。\n何堪多难伤心切，一曲箜篌扬子西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26098,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春感 其一","author":"葛宜","text":"二月梅花落似雪，三春杨柳乱如丝。\n那堪花柳添愁思，寄与东风总不知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26099,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春感 其二","author":"葛宜","text":"寂寞村居水一涯，半间茅屋傍溪斜。\n亦知昨日复今日，閒数开花与落花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26100,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"午日自题","author":"葛宜","text":"吾年三十复添五，终日卧病当端午。\n只今且种忘忧草，富贵浮云何足数。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26101,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"冬夜","author":"蔡琬","text":"耿耿兰缸暗，沈沈夜气清。\n梦回残漏永，月在半窗明。\n乡思兼愁思，砧声复雁声。\n故园归路杳，何日慰离情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26102,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"关锁岭","author":"蔡琬","text":"山从绝域势遥分，天限西南自昔闻。\n烽静戍楼狐上屋，风喧古木鹤惊群。\n横盘石磴危通马，深锁雄关冷护云。\n叱驭升平犹觉险，挥戈谁忆旧将军？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26103,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九峰寺有感家大人","author":"蔡琬","text":"萝壁松门一径深，题名犹记旧铺金。\n苔生尘鼎无香火，经蚀僧厨有蠹蟫。\n赤手屠鲸千载事，白头归佛一生心。\n征南部曲今谁是，剩有枯禅守故林。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26104,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江西坡","author":"蔡琬","text":"西岭千重簇剑铓，曾挥万骑蓦羊肠。\n鬼灯明灭团青血，野冢荒凉啸白杨。\n梦断层霄空漠漠，事随流水去茫茫。\n只今剩有残兵卒，指点空山说战场。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26105,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"辰龙关","author":"蔡琬","text":"一径登危独惘然，重关寂寂锁寒烟。\n遗民老剩头间雪，战地秋闲郭外田。\n闻道无人随匹马，曾经六月堕飞鸢。\n残碑洒尽诸军泪，苔蚀尘封四十年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26106,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重过燕子矶","author":"蔡琬","text":"又系兰桡驻水滨，小亭重上独逡巡。\n恰看白下还斜照，剩对青山似故人。\n几杵疏钟江寺晚，半篱寒艳菊花新。\n凭栏更诵登临句，望里山川尚有神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26107,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江雨晚晴","author":"蔡琬","text":"晚烟漠漠破馀晖，红叶纷纷下翠微。\n几点断云将雨去，一行寒雁贴江飞。\n霜明半落新愁鬓，风劲先侵远客衣。\n翻羡田家无个事，小舟閒泊钓鱼矶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26108,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋原踏月","author":"蔡琬","text":"露冷烟消碧落空，远山如黛月如弓。\n蛩吟缓缓堤边路，蝉韵微微树杪风。\n几点雪花天际白，一痕萤火草间红。\n中郎不起吾谁与，莫问良材爨下桐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26109,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题烟江叠嶂图","author":"柴贞仪","text":"谁将素练染霜毫，幻作空濛万里涛。\n一片孤帆何处落，千峰雨色暗红皋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26110,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"与冢妇朱柔则","author":"柴静仪","text":"深闺白日静，熏香垂罗帱。\n病起罢膏沐，澹若明河秋。\n自汝入家门，操作苦不休。\n蘋藻既鲜洁，户牖还绸缪。\n丈夫志四方，钱刀非所求。\n惜哉时未遇，林下聊优游。\n相对理琴瑟，逸响随风流。\n潜龙慎勿用，牝鸡乃贻羞。\n寄言闺中子，柔顺其无忧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26111,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"冯又令命子中皞见过","author":"柴静仪","text":"贤子传君意，过门慰藉深。\n长贫无乐岁，多难有禅心。\n琴酒怜知己，诗歌愧赏音。\n他年能忆我，相访就云林。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26112,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送顾启姬北上","author":"柴静仪","text":"一片桃花水，盈盈送客舟。\n春来万杨柳，叶叶是离愁。\n顾我穷途者，逢君意气投。\n烟虹时染翰，风月几登楼。\n只合熏香坐，谁堪鼓枻游。\n燕台一回首，云白古杭州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26113,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怀子江右","author":"柴静仪","text":"彭蠡风涛怒不休，日斜何处泊行舟。\n朝来定有思亲泪，流到钱塘古渡头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26114,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"举第五子","author":"朱柔则","text":"四男二女如相引，复举斯儿真可哂。\n辗转常怀离里亲，欲与邻人仍不忍。\n读书还拟大吾门，未许痴顽类犬豚。\n自怜乳哺多辛苦，转忆吾亲罔极恩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26115,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄远曲三首 其一","author":"朱柔则","text":"恨少垂杨柳，殷勤系玉鞍。\n夕阳鸦背暖，春雪马蹄寒。\n入世逢迎拙，依人去住难。\n痴儿啼向我，昨夜梦长安。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26116,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄远曲三首 其二","author":"朱柔则","text":"猎猎风初劲，沉沉雨未阑。\n因怜儿被薄，转忆客衣单。\n栖燕将雏苦，征鸿失侣寒。\n居家与行路，同是一艰难。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26117,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄远曲 其三","author":"朱柔则","text":"辛苦长安客，栖栖叹此行。\n故乡空自阻，逆旅亦何营。\n取友防轻薄，持躬问老成。\n寄言百君子，努力事身名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26118,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄远曲三首 其三","author":"朱柔则","text":"闻说燕台路，生涯亦可怜。\n耻弹门下铗，谁乞广文钱。\n久客非长策，归耕有薄田。\n一棺痛慈母，急为卜牛眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26119,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"别曲","author":"朱柔则","text":"三载饥驱走路歧，一春风雨倍凄其。\n黄金最是无情物，长使深闺怨别离。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26120,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"河渚观梅约顾女春山","author":"朱柔则","text":"相期河渚玩春华，一棹迎风路未赊。\n楼外有梅三百树，美人不到不开花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26121,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"天竺寺","author":"马士琪","text":"三竺深始佳，妙香静空谷。\n无量人天供，至此心神肃。\n在昔闻兵火，兹山未沈陆。\n若非龙象力，何以感群族。\n出门望层峦，回向古道场。\n云日递隐见，岩壑易阴阳。\n别院通危桥，涧曲声琅琅。\n万木拥寒阁，千镫照回廊。\n澄怀此晏坐，摄受言可忘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26122,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将进酒","author":"马士琪","text":"文犀光射琥珀微，客为主寿云懒归。\n此时举觥胜千日，噀酒使我花枝肥。\n天桃未落春已老，驱车疾走扬州道。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26123,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"苦雨","author":"马士琪","text":"阶前时复见游鱼，不断愁霖密复疏。\n触处墙倾兼屋漏，有人夜起护残书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26124,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"孤雁","author":"叶枌","text":"一声凄切度河梁，不诉离群也断肠。\n寂历寒沙眠铩羽，空明霜月照分行。\n无心避患衔芦荻，肯恋馀生逐稻粱。\n闻道边庭尚征戍，孤鸣幸勿到辽阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26125,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送伯姊之姑苏","author":"陆莘行","text":"自怜娇小不知诗，执手临行强致词。\n盼杀天涯传锦字，吴江枫落雁归时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26126,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"子夜歌 其一","author":"陈何","text":"一去已十载，九夏隔千山。\n双珥依然在，如何不得环。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26127,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"子夜歌 其二","author":"陈何","text":"白露收荷叶，清明种藕枝。\n君行方岁暮，那有见莲时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26128,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病中吟 其一","author":"张曼殊","text":"罗帐挂金钩，薰炉香雾收。\n起来红袖冷，独坐怕梳头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26129,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病中吟 其二","author":"张曼殊","text":"日色满窗红，鸳鸯睡枕同。\n披衣将欲起，又怕隔帘风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26130,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"无子自叹","author":"张曼殊","text":"春到园林草尽芽，天桃何事不开花。\n晓来对镜临妆坐，羞见朝阳上碧纱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26131,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"初夏偕玉映妹游山","author":"王静淑","text":"欲觅清幽处，山高恐不深。\n閒云飞别岫，野鸟定花阴。\n笋嫩留饥采，茶香待渴吟。\n深闺无限意，触景破愁心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26132,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日庵居","author":"王静淑","text":"空斋渡深夜，高卧一床秋。\n苔老浑无色，溪清浅欲流。\n尘随红叶扫，心付懒云收。\n萧瑟闻征雁，空归万籁休。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26133,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠邻姬","author":"王静淑","text":"梅影疏窗瘦，衾裯薄又寒。\n侍儿不解意，指月上阑干。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26134,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九日迟玉映妹不至","author":"王静淑","text":"细雨凄风阻雁行，竹篱茅舍薄罗裳。\n登楼懒看黄花瘦，山老林红一夜霜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26135,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柳","author":"王静淑","text":"乳燕黄莺三月时，春风拂地柳垂垂。\n长条不系行人住，犹向江南送别离。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26136,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蓬门","author":"王端淑","text":"骨傲岂随俗，宁攀山鬼邻。\n舒云聊作帐，集叶戏为茵。\n凤岭知难效，鹿门且耐贫。\n残篇任意读，不羡骑辚辚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26137,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"明妃梦回汉宫次浮翠轩吴夫人韵","author":"王端淑","text":"一自明妆出未央，空留遗恨在昭阳。\n琵琶曲尽关山泪，环佩声归塞上霜。\n宿雁残更移晓幕，依人落月下空床。\n旧时纵有三秋怨，不及穹窿此夜长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26138,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"为龚汝黄题黄皆令画","author":"王端淑","text":"孤亭秋树色，即是云深处。\n写此数峰青，倒逐扁舟去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26139,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宫怨","author":"王端淑","text":"长门春锁月溶溶，绣柱金铺翠自封。\n忽听马啼惊欲曙，多年不候景阳钟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26140,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"代外赠别毛大可","author":"王端淑","text":"西泠月落板桥霜，衰柳长堤祇自伤。\n几日穷愁兼别怨，一帆秋色带斜阳。\n浮云影逐离亭路，归雁声凄碧草塘。\n学采芙蓉江上去，黯然回首恨茫茫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26141,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病中喜新月","author":"王端淑","text":"促织频催懒，寒衣犹未成。\n起床忘骨瘦，著履觉身轻。\n青帝飘飘散，姮娥冉冉情。\n秋怀无所处，共月结新盟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26142,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"贫病有感","author":"王端淑","text":"才已行贫运，偏增新病魔。\n镫花虚拟结，鹊语几番讹。\n针指能生睡，诗篇强自哦。\n寒风吹瘦骨，酌茗亦阳和。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26143,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"代睿子怀玉尺弟","author":"王端淑","text":"凋残花萼失芳丛，嗟尔天涯我孰同。\n鸿雁序离悲夜月，鹡鸰诗就泣东风。\n萦牵梦隔西江杳，沦落音难越水通。\n景物触怀思切切，何时携手叹飘蓬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26144,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"邻妇","author":"王端淑","text":"鸟声初啭堕花春，静女幽妆采落蘋。\n脸映芙蕖娇且艳，眉修清月淡无尘。\n一泓秋水留西子，半幅轻绡写洛神。\n秀色共餐饥可乐，不才忝已在东邻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26145,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨中桃花","author":"王端淑","text":"寒风微透入凄清，过雨夭桃色易倾。\n莺湿羽衣怜艳冶，苔伤花影谱心旌。\n飞烟乍掩炉峰失，新草萎残曲径茕。\n拾得落云天已暮，远林遥听堕春声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26146,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"吴岩子徵和起句原韵 其一","author":"王端淑","text":"榻占西湖第一楼，垂帘落影咽云流。\n含香燕入歌声里，避月花飞点案头。\n鹫岭青来描锦字，蒹葭碧处系春舟。\n阮公清啸江生笔，赢得轻烟纸上幽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26147,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"吴岩子徵和起句原韵 其二","author":"王端淑","text":"长堤梅格渐生香，叠入奚童旧锦囊。\n离绪征帆寒雁远，移文秀笔淡山光。\n花含碧玉裁清佩，云映芝眉剪绿裳。\n解得苑莺调柳色，束红凝目望华章。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26148,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杂诗","author":"徐安吉","text":"浮生宁有涯，性灵不可夭。\n适自理晨妆，遥见东方晓。\n初风半吹竹，寂寂闻啼鸟。\n地僻我亦閒，日对南山小。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26149,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山中咏","author":"徐安吉","text":"老枫俯大溪，数枝浮水面。\n清风与之俱，吹落秋红片。\n落日危孤峰，柴门雀喧转。\n短草动夕阳，寒塘石清浅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26150,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"古意","author":"徐安吉","text":"柳色欲轻黄，朱楼人自伤。\n愁来无洛浦，梦去有高唐。\n宝镜空悬架，榴裙验取箱。\n谁书桐叶字，坟草变鸳鸯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26151,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春词","author":"徐安吉","text":"西楼残月子规情，几树梨花照水横。\n自抱琵琶廊下坐，含愁拨得两三声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26152,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"生烜儿志喜","author":"马氏","text":"良辰屈指及秋元，喜见明珠耀小轩。\n今日人皆称似祖，他年汝莫愧为孙。\n秋风丹桂非无种，福地仙桃信有源。\n伫看彩衣娱白发，祯祥重与细评论。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26153,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"桃叶渡歌","author":"徐昭华","text":"可怜桃叶渡，落日行人暮。\n双桨打清波，春风缓送桃叶过。\n祇今桃叶渡头稀，艇子江头归不归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26154,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"因探亲吴门同虞夫人游虎丘","author":"徐昭华","text":"阊门日出晴鸦噪，两桨閒寻虎丘道。\n宿雾犹含堤上花，流云已渡波间藻。\n红栏上下傍水行，画船歌吹来倾城。\n回帆不尽掺挝意，转幔时闻过曲声。\n斜峙山桥甫能住，香车早趁山塘去。\n满街栀子未开花，几树垂杨自飞絮。\n到门知是梵王宫，台榭连云曲径通。\n棕棚覆叶沽茶碧，漆柱遮油卖杏红。\n我寻生公旧法席，蹇裳一上生公石。\n龙剸绝壁尚留池，虎去中林杳无迹。\n登山四望更无山，但见山藏古寺间。\n绕地松楸看去密，空庭塔影落来圆。\n修廊诘曲几回度，又听归鸦噪前路。\n夕阳一片寺门边，不识真娘在何处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26155,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"塞上曲","author":"徐昭华","text":"朔风吹雪满刀镮，万里从戎何日还。\n谁念沙场征战苦，将军今又度阴山。\n长云衰草雁行平，砂碛征人向月明。\n思妇不知秋夜冷，寒衣还未寄边城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26156,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"毛安芳挽歌","author":"顾姒","text":"忆昔当春时，寿君惭不文。\n未几闻君丧，奄忽如流云。\n流云过眼空悲怨，大火西流时倏变。\n玉楼金屋网蟏蛸，西风叶落空深院。\n凄凉宝瑟掩馀音，惨淡菱花冷钗钿。\n尚忆当年对镜人，镜中鸾死悲娇面。\n织锦诗成那得闻，墨池寒浸琉璃片。\n不知何处吊君魂，草白磷青望中见。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26157,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题林亚清画","author":"顾姒","text":"梅花竹叶互交加，濡墨淋漓整复斜。\n忆得昨宵明月下，横拖疏影上窗纱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26158,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆父禹都","author":"林以宁","text":"晓登百尺楼，遥望中条山。\n天际有白云，日夕自往还。\n去来何寥邈，引领难追攀。\n谁云生女好，少长违亲颜。\n岂不眷庭闱，安能事间关。\n问寝久疏阔，视膳良以艰。\n回步循南陔，踯躅涕汍澜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26159,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"画竹","author":"林以宁","text":"新竹出短篱，亭亭如织翠。\n明月升东轩，竹影宛在地。\n铜砚磨松煤，濡毫写其意。\n清幽固可嘉，爱此坚贞志。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26160,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柴季娴索诗赋答","author":"林以宁","text":"春风吹暖杏花香，试拂鸾笺写断肠。\n每见远山思黛色，时从落月想容光。\n别来几度梅如雪，愁绪萦怀鬓欲霜。\n为报故人休索句，砚田惭我已全荒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26161,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梦游桃花源","author":"林以宁","text":"理棹石濑口，洞壑极深窅。\n白日翳层壁，倏然露林杪。\n初行不见人，仄径碍飞鸟。\n忽逢林木尽，水竹四环绕。\n茅屋三两间，鸡声出林表。\n主人闻客来，揽衣起相劳。\n笋蕨为我设，粳粱供我饱。\n白鹤翔天风，游鱼戏清沼。\n宛若素所历，朅来胡不早。\n怅惘尘世事，朗彻惬怀抱。\n高丘谁沈沦，阿阁孰倾倒。\n魏晋不复知，以下更何道。\n叹息武陵人，悠悠竟终老。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26162,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]