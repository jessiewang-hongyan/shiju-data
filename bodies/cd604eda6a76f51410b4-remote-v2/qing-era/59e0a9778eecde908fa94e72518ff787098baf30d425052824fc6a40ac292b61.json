[{"title":"玉连环 偶遇，用阮亭个侬韵","author":"宋荦","text":"纤腰恰傍垂杨树。\n瞥然惊遇。\n寻常梳里可怜人，一缕腻香风处。\n白板门边归去。\n盈盈微步。\n斜阳飞絮奈何天，直欲作、高堂赋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36741,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"锦堂春 画上美人","author":"宋荦","text":"宝髻八盘倭堕，樱唇一点鲜圆。\n低回无语风前立，顾影自生怜。\n珠泪玉烟谁写，腻香真色俱传。\n明妃不减夭矫态，应费画工钱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36742,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南歌子 题吴门清河女子花鸟","author":"宋荦","text":"写鸟能生动，描花吐艳姿。\n深闺纤指露清奇。\n不数黄荃崔白画家师。\n倦倚红红笔，愁凝小小眉。\n莫教风雨妒胭脂。\n留待双双富贵白头时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36743,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江城子 感旧","author":"宋荦","text":"筠廊秋艳菊花丛。\n命秦宫。\n理焦桐。\n坐向花前，纤手动清风。\n白纻轻衫腰一把，流盼好，送归鸿。\n思量往事恨难穷。\n恁匆匆。\n水流东。\n寂寞高斋，桃萼又将红。\n独抱云和今夜里，谁忍弄，月明中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36744,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"品令 咏阮亭寓斋竹，用西樵先生韵","author":"宋荦","text":"何可居无竹。\n共晨夕、惟君独。\n森森似束。\n雨枝烟叶，声飘哀玉。\n谩说千竿，如此一丛已足。\n依然淇澳。\n遍轩槛、皆新绿。\n恰宜阮籍高吟，月下轻阴满目。\n隙地无多，更种几本寒菊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36745,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"凤楼春 长安寄怀刘山蔚，用见赠原韵","author":"宋荦","text":"记得早莺啼。\n红杏初飞。\n宋城西。\n旗亭别路草萋萋。\n回首处，暮烟迷。\n独有河梁投赠句，任远道相随。\n酌酴醾。\n醉后何为。\n行歌燕市，故人天末，几番恼杀分离。\n吹面曲尘，素衣今已化缁衣。\n中宵无寐，千种思惟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36746,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江城梅花引 月夜过友人寓斋，听邻姬度曲","author":"宋荦","text":"谁从比舍奏清商。\n小秋娘。\n小兜娘。\n一缕因风，袅袅度空墙。\n燕语乍停莺又啭，黄昏后，听来时，总断肠。\n断肠。\n断肠。\n起彷徨。\n月有光。\n漏正长。\n欲去欲去，不忍去、余韵悠扬。\n仿佛天边，遏住片云翔。\n好借君家苔径里，坐十日，听千巡，愿始偿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36747,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"绛都春 秋夜感怀，寄方虎用其年元夜韵","author":"宋荦","text":"炎蒸才谢。\n正暮云敛尽，银河斜挂。\n莺燕风流，荷芰繁华，梦还惹。\n此时旅况何如也。\n举目见、新霜沾瓦。\n青荧灯火，纸窗竹屋，狂吟闲写。\n中夜。\n追思往日，向金门执戟、竞夸裘马。\n一阵西风，又送羁人，燕台下。\n急须觅破衣残帕。\n同学者、相逢如乍。\n且寻江表徐陵，月明词话。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36748,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"千秋岁 赠王子丹麓五十初度，奉次原韵","author":"宋荦","text":"韦编三换。\n一石才过半。\n丘壑性，终难变。\n传文洛纸贵，顾曲吴绫贱。\n便便也，撑肠柱腹皆奇卷。\n日起花砖晏，短发梳还乱。\n追往事，休增叹。\n杯螯左右手，便是长生愿。\n君不见，丹楼百尺仙居幻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36749,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"贺新郎 呈李容齐学士","author":"宋荦","text":"岁又将秋矣。\n向天涯、良朋高会，于今无几。\n馆阁雍容称好客，谁似青莲才子。\n词赋手、招来芜市。\n小院双榆新霁后，写伤心、绮语清宵里。\n争击钵，任浮醴。\n余惟翘首兴怀耳。\n正穷愁、柴门偃仰，未陪名士。\n妒杀晓风残月句，谱自娉婷女史。\n作佳话、流传不已。\n何日更成文字饮，共狂歌、一曲凉飙起。\n先寄讯，吾知己。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36750,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"摸鱼子 题迦陵先生填词图，次竹垞韵","author":"宋荦","text":"怪髯翁、骚坛驰骤，笔锋欲断犀兕。\n生平擅绝红牙句，清致碧波千里。\n移砚几。\n对按拍、蘋云一片芭蕉翠。\n含毫选意。\n羡白袷才披，乌丝初展，此际了无事。\n移情处。\n最是个人纤丽。\n老鸦飞上双髻。\n玉箫吹彻迦陵调，声入霓裳第几。\n珠槵底。\n甚悟到、诸天幻出婵娟子。\n空花蜃市。\n拟呼下当筵，琵琶试拨，划破罨溪水。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36751,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"荷叶杯 其一 梦回","author":"王士禄","text":"红晕倦眸如缬。\n春歇。\n梦回时。\n被香无赖晓魂腻。\n还睡。\n掩帘帏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36752,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"荷叶杯 其二 和温飞卿韵","author":"王士禄","text":"小艇掠烟春浦。\n香雨。\n杜衡红。\n弱鬟斜掩画窗里。\n微起。\n绿杨风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36753,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"荷叶杯 忆鲁泉山居二首 其三","author":"王士禄","text":"忆待石桥金鲫。\n山夕。\n渌波凉。\n小亭红杏几枝侧。\n斜日。\n扑衣香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36754,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"荷叶杯 忆鲁泉山居二首 其四","author":"王士禄","text":"记得山楼日课。\n春惰。\n枕书眠。\n竹篱微映露桃面。\n红情。\n午晴天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36755,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南歌子 窗午","author":"王士禄","text":"窗午花情倦，楼春镜影妍。\n新燕啄泥天。\n枕屏围小梦，阿谁边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36756,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三台令 邺下三台二首 其一","author":"王士禄","text":"吊古重回远目，凭轩遥指荒丘。\n不睹西陵歌舞，唯见漳河乱流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36757,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三台令 邺下三台二首 其二","author":"王士禄","text":"落日乌啼影寂，春风鼠窜苔斑。\n只有千年旧瓦，曾覆当时玉颜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36758,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"荷叶杯 记得","author":"王士禄","text":"又向春风相见。\n梁燕。\n记得去年时。\n有个红栏共晚卮。\n思摩思。\n思摩思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36759,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 望苏门二首 其一","author":"王士禄","text":"天外影，人道是苏门。\n蹬覆松毛青到骨，崖封苔绣碧为魂。\n倘许一追扪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36760,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 望苏门二首 其二","author":"王士禄","text":"苏门好，何日得巾车。\n安乐有窝销白日，啸台无恙卧青霞。\n微咏帽檐斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36761,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渔歌子 锦湖四时渔歌四首 其一","author":"王士禄","text":"雪霁冰澌水漫流。\n鲁陂春涨绕矶头。\n携短棹，纵扁舟。\n逐鹭徵凫下远洲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36762,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渔歌子 锦湖四时渔歌四首 其二","author":"王士禄","text":"系缆青邱万柳东。\n荷花面面午时风。\n悬箬笠，枕笼?。\n卧待宵凉理钓瞳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36763,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渔歌子 锦湖四时渔歌四首 其三","author":"王士禄","text":"细雨浽溦湿绿蓑。\n白蘋香里断鸿过。\n持蟹饮，扣舷歌。\n向夕渔灯炙紫螺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36764,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渔歌子 锦湖四时渔歌四首 其四","author":"王士禄","text":"认簖敲冰下短叉。\n北风猎猎背蓬遮。\n炊荻叶，蔽芦花。\n拥妇呼雏醉晚舣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36765,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蕃女怨 次温飞卿韵","author":"王士禄","text":"晓风吹梦春色遍。\n栖稳梁燕。\n合欢衾，双凤扇。\n厌他常见。\n枕屏帆影向人来。\n又重回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36766,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"调笑令 春闺二首 其一","author":"王士禄","text":"花树。\n花树。\n幂历一窗红雾。\n月明寥落金樽。\n锦瑟年华断魂。\n魂断。\n魂断。\n厌煞春宵银汉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36767,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"调笑令 春闺二首 其二","author":"王士禄","text":"金雁。\n金雁。\n历历斜行筝面。\n红弦素手萦愁。\n迟日凝妆上楼。\n楼上。\n楼上。\n南浦渌波晴漾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36768,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西溪子 玉台","author":"王士禄","text":"何处红楼郎醉。\n侬抱春风孤睡。\n玉台前，谁共语。\n和影语。\n才到双眸晕处。\n最先知。\n剧怜伊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36769,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"如梦令 其一 白沙江上送贻上之金陵","author":"王士禄","text":"沙尾孤舟潮拥。\n手底离觞酒重。\n忽忽恼云帆，不似青骢堪控。\n如梦。\n如梦。\n昨夜短篷相共。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36770,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"如梦令 其二 欲别","author":"王士禄","text":"欲别玉人归去。\n细雨廉纤薄暮。\n红烛静愔愔，好共绿窗幽语。\n且住。\n且住。\n衾润紫沉浓炷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36771,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"如梦令 初夏二首 其三","author":"王士禄","text":"正是夏头春尾。\n芍药酡颜红靡。\n向晚琐窗风，怅绝玉人孤倚。\n还喜。\n还喜。\n梦里灯花几蕊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36772,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"如梦令 初夏二首 其四","author":"王士禄","text":"风捻杨丝碧老。\n雨簸荷钱青小。\n何日草堂边，卧听一林黄鸟。\n堪懊。\n堪懊。\n误被软红相嬲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36773,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"如梦令 其五 忆柳庵山寺","author":"王士禄","text":"忆住柳庵山寺。\n幽兴随心无次。\n支枕敞晴窗，卧选万山紫翠。\n清吹。\n清吹。\n我爱涧松妩媚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36774,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"天仙子 本意","author":"王士禄","text":"拨棹春溪深几曲。\n桃花红蘸清波绿。\n渔郎怪事忆人间，归去迟。\n闭仙谷。\n俯仰青山身碌碌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36775,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江城子 闲庭","author":"王士禄","text":"秋千摇影月微明。\n到闲庭。\n绝人声。\n一点红灯，依约绿窗楞。\n敲遍阑干佯不应，拨兰烬，倦盈盈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36776,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"长相思 本意","author":"王士禄","text":"风半廊。\n月半廊。\n凤胫灯青玉簟黄。\n别时秋乍凉。\n蘋已霜。\n蓼已霜。\n碣石潇湘尚渺茫。\n关河较梦长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36777,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"相见欢 赠季弟","author":"王士禄","text":"若为歌管销愁。\n荡离忧。\n忆逐残秋，征雁问扬州。\n意中漫，怜东阁，少淹留。\n谁识到来，翻送秣陵舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36778,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"河满子 效何凝体二首 其一","author":"王士禄","text":"最是春风情绪，无聊无赖无端。\n枕瑟孤眠思好梦，被池虚绣双鸾。\n争似蕊黄花子，朝朝贴向眉弯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36779,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"河满子 效何凝体二首 其二","author":"王士禄","text":"仿佛玉人情态，桃花浅醉春风。\n咫尺女床仙树远，漫云宋玉墙东。\n争似猩红宝袜，朝朝约向酥胸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36780,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"调笑令 其一 成公智琼","author":"王士禄","text":"相见。\n鱼山畔。\n五载精诚重会面。\n云軿霞靷神仙伴。\n心感多情弦掾。\n同车还许同心绾。\n洛水春波婉娈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36781,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"调笑令 其二 天台二女","author":"王士禄","text":"仙侣。\n溪边女。\n笑倚桃花相向语。\n绛帏双结同心苣。\n婉态幽欢难举。\n鸟啼乡思茫无主。\n轻别玉娥归去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36782,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"调笑令 其三 洛神","author":"王士禄","text":"难赋。\n凌波步。\n心寄君王魂定赴。\n遗情想像悲灵遇。\n斜日蘅皋空暮。\n独携遗枕循归路。\n愁逐洛川东注。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36783,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"调笑令 其四 杜兰香","author":"王士禄","text":"相迟。\n真灵配。\n侍女重来遥寄意。\n玉盂曾作登真记。\n更付黄麟仙帔。\n墉城归去心期遂。\n云路双翔翡翠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36784,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"调笑令 其五 织女","author":"王士禄","text":"霄汉。\n情难断。\n抚抱临歧空恋恋。\n紫房遥寄青缣怨。\n别后灵期汗漫。\n枕香衣泪留相伴。\n寂寂玉颜难见。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36785,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"调笑令 其六 玉卮娘子","author":"王士禄","text":"回首。\n辞箕帚。\n殊绝苕颜惊阿母。\n玉卮难复为君妇。\n逻谷旧缘空有。\n遗君玉合君怜取。\n肠断仙都别后。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36786,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"调笑令 其七 云英","author":"王士禄","text":"何夕。\n蓝桥驿。\n百日为期难自惜。\n心坚玉臼终须得。\n共践玉峰仙宅。\n裴郎阿姊还相识。\n湘汉新诗重绎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36787,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉太平 邮夜","author":"王士禄","text":"星前角声。\n风前笛声。\n恼人日夕逢迎。\n问王程几程。\n别边酒醒。\n归边梦醒。\n忧来如月明明。\n问秋更几更。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36788,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"生查子 其一 艳情","author":"王士禄","text":"窗晓露微明，未醒双文睡。\n辗转玩琼颜，爱煞斜鬟腻。\n睡浅为郎羞，拥损重楼被。\n后夜却防郎，只枕郎君臂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36789,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"生查子 其二 别怨","author":"王士禄","text":"紫栈已停熏，银蜡仍销焰。\n共影守残更，相惜还相厌。\n蕉萃此时心，郎定无由见。\n独有夜啼乌，仿佛闻微叹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36790,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"生查子 其三 次女郎紫竹韵","author":"王士禄","text":"阶怜好月痴，窗厌孤灯惨。\n无味夜来风，空逗帘犀飐。\n莫检枕函书，旧泪痕痕黮。\n都得几丝愁，萦损春山点。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36791,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"酒泉子 小院","author":"王士禄","text":"细雨愔愔。\n寂历红薇小院。\n殷轻雷，却纨扇。\n绿屏深。\n涎涎紫燕亸双尾。\n无语梁畔睡。\n簟痕孤，香气靡。\n暮寒侵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36792,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉公子 其一 街鼓","author":"王士禄","text":"街鼓传三四。\n不见萧郎至。\n何物对裴回。\n玉香独见鞋。\n锦衾空艳艳。\n沉水薰来厌。\n休自听更筹。\n鸦啼金井头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36793,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉公子 其二 次顾夐韵","author":"王士禄","text":"梳里朝来淡。\n羞对移春槛。\n斜倚绿牙屏。\n梨花小院扃。\n独坐流光慢。\n迟日窥门限。\n蓬鬓乱双蝉。\n心慵又一年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36794,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"昭君怨 楼外","author":"王士禄","text":"楼外夕阳牢落。\n倚损危栏一角。\n何处见天涯。\n碧山遮。\n那似合欢双枕。\n解使潇湘路近。\n回梦惜馀欢。\n觑屏山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36795,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春光好 秋千","author":"王士禄","text":"红索软，锦旗平。\n蝶裙轻。\n一倍春光照眼明。\n殢初莺。\n人是如云如月，天看非雨非晴。\n仿佛似闻花影里，坠钗声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36796,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇 其一 闺情","author":"王士禄","text":"雨嬲空庭，梦回失却桐庐路。\n春愁相赴。\n又是红窗暮。\n卜损金钗，怕见芳园树。\n微寒度。\n水沉销炷。\n且伴春风住。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36797,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇 其二 梦馀","author":"王士禄","text":"蹴踏闲愁，先生被却拘墟也。\n梦馀醒暇。\n叉手槐凉下。\n树畔驴儿，有似邯郸野。\n归去者。\n炊成潇洒。\n莫道黄梁哑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36798,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"诉衷情 次魏承班韵","author":"王士禄","text":"蹙惯双蛾翠损长。\n犀帘静暮堂。\n新梦断，乱蝉凉。\n慵续午馀香。\n宛转簟纹光。\n似回肠。\n清宵好更梦横塘。\n学鸳鸯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36799,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 夏闺二首 其一","author":"王士禄","text":"琼砌阴浓暑渐收。\n梦回楼角夕阳幽。\n晚花香里上帘钩。\n绿堕鸦鬟金雀隐，红斜宝袜玉肤柔。\n风边小立只低头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36800,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 夏闺二首 其二","author":"王士禄","text":"茉莉风凉沁洞房。\n琐窗斜月坠清光。\n玉人枕畔卸衣裳。\n细语低迷防婢觉，幽情宛约恼郎狂。\n暗中无奈绣鞋香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36801,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其三 次少游韵","author":"王士禄","text":"半下流苏罥绿霞。\n缓歌捉搦按红牙。\n春风先到泰娘家。\n选梦正宜衾鸭暖，昵人偏是鬓蝉斜。\n莫将销恨属名花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36802,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其四 别来","author":"王士禄","text":"锦水文鸳宿处同。\n别来魂梦镇惺忪。\n分携记在绿屏东。\n执手凄凄还脉脉，回头昵昵苦匆匆。\n横波低揾一双红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36803,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 春闺三首 其五","author":"王士禄","text":"妩媚风光二月过。\n轻衫不爱绣银鹅。\n蜻蜓浅碧缬文罗。\n小倦非缘思梦睡，柔情却似为春酡。\n红襟燕子又来么。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36804,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 春闺三首 其六","author":"王士禄","text":"风乱湘桃午倦时。\n双鬟好为掩罘罳。\n怕来春梦似游丝。\n种得碧兰怜露蕊，写成朱竹惜歌枝。\n为他情态也差差。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36805,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 春闺三首 其七","author":"王士禄","text":"情思恹恹厌袜罗。\n起来红日玉台多。\n关心残梦怎腾那。\n瘦损腰围如弱柳，梳成髻子是翻荷。\n当窗自惜态娥娥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36806,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 艳情二首 其八","author":"王士禄","text":"笑倚秦筝理钿蝉。\n午窗兰气绝清妍。\n昵人脉脉亸香肩。\n秾李风情谁得似，破瓜年纪最堪怜。\n黑犀合子赠缠绵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36807,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]