[{"title":"早秋感怀","author":"吴希鄂","text":"烟树含愁莽大荒，西风一夜鬓成霜。\n知交迹共秋蓬散，羁旅人如社燕忙。\n坐对河山抚髀肉，转看花月絓离肠。\n祖生慷慨中流意，落日凉云水一方。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20781,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"自题梅花","author":"吴希鄂","text":"大野翳黄埃，孤山皎寒树。\n风雪不知年，烟霞自终古。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20782,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题画松","author":"吴希鄂","text":"云雨无寸权，蛟螭复狂吼。\n一夕风霆来，拿云破空走。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20783,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送友北上","author":"吴希鄂","text":"故国造分手，离堂久怆神。\n水风难写恨，花柳易伤春。\n帆饱吴天雨，车吞冀野尘。\n心随寒月影，夜夜照行人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20784,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题独立美人","author":"吴希鄂","text":"春庭睕晚萝藓香，春风飘飘罗带长。\n悄然独立有延伫，清愁压损九折肠。\n落花淡宕春不语，一片夕阳红杜宇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20785,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"画梅赠陈大守臣保宗二首 其一","author":"吴希鄂","text":"明月空枝忆素琴，悄飞孤梦上遥岑。\n广平去后江春老，冰雪何人见古心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20786,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"画梅赠陈大守臣保宗二首 其二","author":"吴希鄂","text":"烟潭泻月水鳞鳞，江驿迢遥弄早春。\n正恐倚楼一声笛，天涯愁绝咏花人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20787,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"感时即呈章大黻云","author":"吴希鄂","text":"皇舆败绩事纷纭，遥念春明换劫氛。\n张翰扁舟聊复尔，管宁一榻尚依君。\n醉呼海月论今古，閒与沙鸥梦水云。\n山桂园莼喜同趣，相从长啸入烟濆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20788,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"对月","author":"吴希鄂","text":"槛山牵恨入吟卮，木落江亭雁叫时。\n凝碧池头今夜月，西风弦管不胜悲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20789,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题秋海棠","author":"吴希鄂","text":"银筝切切语霜天，深院无人夜似年。\n风露中宵冷罗袜，秋魂如素月如烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20790,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题画菊","author":"吴希鄂","text":"一墀宿雨长寒芜，人瘦西风冷篆炉。\n落叶荒苔秋似梦，骚情逸韵两模糊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20791,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"漫成","author":"吴希鄂","text":"蓟门霜气破空来，承露犹为汉室台。\n树隐长天天隐塞，西风愁听暮笳哀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20792,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题梅二首 其一","author":"吴希鄂","text":"霜海寒多酒力微，孤山月堕野烟霏。\n梦痕诗思浑无著，翠羽溪云相傍飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20793,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题梅二首 其二","author":"吴希鄂","text":"神人何事下人寰，远韵高情不可攀。\n一片清寒相迫处，冻云扶梦过沙湾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20794,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题吴絅斋曾徯黯然吟草后","author":"吴希鄂","text":"锦屏春去冷羊车，缘订三生愿竟赊。\n酒后乡愁击江浒，镜中人面遽天涯。\n吴山自昔生红豆，湘水无情怨落花。\n好语离亭烟树影，莫将幽恨漫萦遮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20795,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"天风小","author":"吴希鄂","text":"海波不起天风小，大鹏塌翅老荒岛。\n饥来乞食向小鸟，瓦缝粮空不能饱。\n莺鸠飞抢纷榆枋，大鸟承讥黯自伤。\n天寒岁暮霜风急，云翼垂垂渐非昔。\n君不见，天马踔蹄九垓褊，泥龙宛转石濑浅。\n龙侪蠙獭马槽枥，过者谁能一回睫。\n徒闻邱平垄灭时，披榛破莽珍鳞骨。\n噫吁嚱，天苍苍兮野茫茫，天荒地老悲恨长。\n白日速兮岸谷忙，一笑人间墓草荒。\n下为流丐上帝王，美人才士纷道旁。\n身命化作黄埃黄，古今不独此鸟有如此，胡为为之俛仰摧肝肠。\n且图日倒三百觞，醉挟巨管追电芒。\n砊磕淫裔莫敢当，矫首嘘气紫玉光。\n上续修霓之修千丈强，吸尽云霾烟冱，与尔青天白日同翱翔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20796,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"冬日书怀二首即示翥云同砚 其一","author":"吴希鄂","text":"晨登东南山，长啸览遐廓。\n平野黄埃起，俯视重踯躅。\n洸洸丈夫志，被褐怀美玉。\n家室絷心膂，常恐负尘俗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20797,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"冬日书怀二首即示翥云同砚 其二","author":"吴希鄂","text":"去者叠相送，往古多荣名。\n勋阀誇顾郭，才望慕机衡。\n予材既拥肿，予质复孤生。\n重念蓼莪诗，俛仰还吞声。\n我生适憔悴，朽槁忽已成。\n汝曹正焯焯，意气无短平。\n好为不朽死，勿求依人生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20798,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"又题黯然吟","author":"吴希鄂","text":"绮楼人去物华非，晓院花寒苜蓿肥。\n最是春风双燕子，呢喃还傍旧巢飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20799,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"爨材吟","author":"吴希鄂","text":"灶养抽薪带湿烧，爆声还冀七弦调。\n中郎才思都消歇，莫恨琴材爨下焦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20800,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"白梅","author":"吴希鄂","text":"斑斑残雪啮苔根，寒透罗帏第几层。\n最是不胜清怨处，玉人和月立黄昏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20801,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"自题小影","author":"吴希鄂","text":"愁海犹馀劫外身，疏梅残竹共精神。\n壮心夜绕鸡声月，病骨年销甑口尘。\n鸿爪暂应随雪住，混花多恐被春嗔。\n秋风转瞬更容鬓，画里樽前各一人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20802,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题黄仲则两当轩集","author":"吴希鄂","text":"坐看遗墨黯伤神，我亦衡湘泽畔人。\n一代才魂秦塞月，当年俊藻帝京尘。\n穷愁旷世无侪偶，歌哭千秋有比邻。\n欢息文章憎命语，君苗笔砚感陈陈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20803,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"漫成","author":"吴希鄂","text":"镜外雄心死二毛，一腔热血怒江涛。\n汝南未叫千门旦，太白光中看宝刀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20804,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"即席","author":"吴希鄂","text":"麝云酒雾喷华筵，赋里惊鸿照目前。\n四座春风酬艳福，一尊新月小游仙。\n漏壶未肯憎长夜，瑶轸何腌惜绮年。\n只恐芳时容易过，香痕如梦梦如烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20805,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"白芍药","author":"吴希鄂","text":"露华如水渍轻罗，袅袅离魂玉一梭。\n珍重东风无限意，碧阑干外夜寒多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20806,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和谢大冶盦京口渡江作","author":"吴希鄂","text":"秋雨秋风送客舟，水云深处剩閒鸥。\n奇才自古怜荆璞，病骨何堪任杞忧。\n羽翮青霄看健举，头觑沧海感沈浮。\n人閒昨夜亡梅尉，谁引吾曹到十洲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20807,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"墨龙","author":"吴希鄂","text":"腔中碧尽千年血，囊中剩有游龙笔。\n等閒挥洒泥墙头，云起青天飞霹雳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20808,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋风词","author":"吴希鄂","text":"秋风年年吹薄罗，所欢不归奈年何。\n菖蒲花老谢青娥，床头明光昏泪波。\n归来赠我珠十斛，别泪与之谁少多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20809,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"元旦题红梅","author":"吴希鄂","text":"大地穷寒乱雪飞，千山草木梦中腓。\n一花首出行春令，天与云霞作宝衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20810,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"琴川纪游","author":"吴希鄂","text":"鬓痕棹影纪勾留，黛色岚光浑碧流。\n故苑芳馨萦别梦，画船箫鼓感重游。\n春边细雨花憎命，柳外轻寒鸟动愁。\n但得流连消锐气，月明何必定扬州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20811,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春词","author":"吴希鄂","text":"碧云斜幂垂杨堤，野红乱落山鸟啼。\n东风暖香熨罗带，纲户春愁压玉笄。\n桃花深锁绮空里，玉箫呜呜海烟起。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20812,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥病后作","author":"吴希鄂","text":"数载争如鸟絷笼，自怜病起倏成翁。\n药炉烟里北辰动，谵语声中大海东。\n匣剑夜鸣三峡雨，枕戈寒啸五更风。\n莫嗟春老江天暮，放眼斜阳万顷红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20813,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送陈守臣","author":"吴希鄂","text":"春帆渺渺泛江行，万顷波涛一叶轻。\n镜里华年催短发，日边光景隔重城。\n人如鸥鹭浮江海，气负云霞郁太清。\n自有孙阳脱盐骥，未应浪作不平鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20814,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"除夕揽镜感赋","author":"吴希鄂","text":"华鬓悤悤廿四年，酒杯在手思茫然。\n剑镮夜啸边城月，霜气寒沈镜里天。\n帝予聪明炯回雪，命憎文字渺秋烟。\n受恩深处都无语，自抚头颅看夕川。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20815,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"大愁","author":"吴希鄂","text":"天荒荒，地眑眑，寥落万年豪圣少。\n一旦有之坐以槁，令此革党更扰扰，君臣日旰益草草。\n我今忽有怨，怨天不速老。\n不然手揭浮云，喝破青天十万丈，置我牢愁天之上。\n我愁置天上，炯炯瞳瞳，亿千万年，任汝下人瞻以望。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20816,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"为章启之题画","author":"吴希鄂","text":"芦花风起暮苍凉，露草娟娟未著霜。\n一缕秋魂飞不起，野烟和月堕寒塘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20817,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送缪啸仙出都四首 其一","author":"吴曾徯","text":"不忍离君忍送君，归心我亦逐飞云。\n燕歌慷慨千觞劝，鸿影东西一霎分。\n等是穷途伤阮籍，更谁直谏重刘蕡。\n生涯潦倒知何极，只合从今笔砚焚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20818,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送缪啸仙出都四首 其二","author":"吴曾徯","text":"蹉跎往事岁华侵，同病堪怜负素心。\n两月缘从人海聚，十年交向客途深。\n愁多合醉醪千日，义重还珍诺百金。\n此去君休嗟计左，陔兰好续广微吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20819,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送缪啸仙出都四首 其三","author":"吴曾徯","text":"辟门盛典叹虚縻，五百年来积习疲。\n变法千言陈北阙，持平一疏赖南皮。\n杞人枉自忧天堕，杨子空教泣路歧。\n合让趋风多少客，云霄衮衮共扬眉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20820,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送缪啸仙出都四首 其四","author":"吴曾徯","text":"黄金斗粟价偏嬴，乡信遥传客梦惊。\n鼠窃屡闻横小丑，鸿嗷漫说账常平。\n膏朘嫠纬虚宵织，劫兆儒冠窘笔耕。\n淹滞诚非归亦拙，人间何地著迂生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20821,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"首夏留滞都门感赋二首 其一","author":"吴曾徯","text":"落魄游踪愿两违，九旬韶景霎时归。\n团栾妒煞银华镜，宛转歌残金缕衣。\n计日漫占龙虎近，望云频怨雁鸿稀。\n茧丝吐尽春蚕缚，回首当初念念非。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20822,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"首夏留滞都门感赋二首 其二","author":"吴曾徯","text":"幻梦邯郸又一场，飘零零剑竟何方。\n芳春似客匆匆杳，清昼和愁细细长。\n衔石恨徒传帝女，补天力漫仗娲皇。\n定知暗滴空阶泪，化作秋花也断肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20823,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"大风上陶然亭和壁间韵四章 其一","author":"吴曾徯","text":"尘界何人悟太空，飞鸿回首影匆匆。\n三千归路愁吟里，九十春光客梦中。\n黯淡黄沙昏落照，萧骚绿苇战遥风。\n閒亭借此聊清睡，一任回来鬓发蓬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20824,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"大风上陶然亭和壁间韵四章 其二","author":"吴曾徯","text":"谁将献馘戢鸮音，赤县纷纭竟陆沉。\n焰助抱薪宁有济，危嬉巢幕亦何心。\n颇奢倘在终存赵，韩岳无功待款金。\n愧煞迂生虚寸补，杞人忧泪却难禁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20825,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"大风上陶然亭和壁间韵四章 其三","author":"吴曾徯","text":"忍听离亭唱渭城，一鞭掉首任行行。\n石痴曾上青山化，鸟怨终填碧海平。\n醉酒记来金谷苑，题诗愁绝玉溪生。\n短宵欹枕思谁觉，又看萧窗曙色明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20826,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"大风上陶然亭和壁间韵四章 其四","author":"吴曾徯","text":"苦吟漫说学阴伺，人海沉沦万辈过。\n牛马指呼从世便，虫鸡得失定谁多。\n西山望断苍茫影，燕市听残慷慨歌。\n二十馀年真一梦，浪游那复计蹉跎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20827,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"长安","author":"吴曾徯","text":"凄绝长安万户砧，朔风凉信上衣襟。\n穷愁维翰空磨铁，卧病相如早罢琴。\n梦逐春遥牵半载，日随年永滞分阴。\n更憎秋雨无聊甚，点滴分明碎客心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20828,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏古六截摅感","author":"吴曾徯","text":"荐枕殷勤梦岂真，此生争奈负前因。\n多才子建浑无赖，漫托川神赋感甄。\n相留小住幸奇逢，忽动尘心意转慵。\n恨煞天台轻一别，再来何处觅仙踪。\n重访柴门杳莫开，桃花人面首频回。\n题诗崔护空惆怅，为底今朝始一来。\n青青垂柳旧条长，问讯章台几断肠。\n怎奈任人攀折去，负心终竟是韩郎。\n水嬉张处识婵娟，记取寻春订夙缘。\n子满阴成来已晚，恼他负约杜樊川。\n驿邸留书枉咄嗟，容华咫尺渺天涯。\n恰怜肝胆深披处，忙到人间古押衙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20829,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"怀北京曹湘蘅君二首 其一","author":"吴曾徯","text":"射水通龙蟒，岷山起凤麟。\n治才须贾谊，首辅待曹真。\n云汉雕盘势，幽并骥绝尘。\n京华花满眼，莫恋锦江春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20830,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"怀北京曹湘蘅君二首 其二","author":"吴曾徯","text":"枢府新参事，江湖旧逐臣。\n不知穷达异，惟见性情真。\n搅辔忧诸夏，垂纶爱富春。\n间关书剑老，江汉未归人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20831,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"汉皋怀卢君子鹤二首 其一","author":"吴曾徯","text":"楷模当时重，参军有秘书。\n筹边唐节度，喻蜀汉相如。\n剑阁重关启，春营细柳疏。\n嘉陵风鹤静，山翠扑蓬庐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20832,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"汉皋怀卢君子鹤二首 其二","author":"吴曾徯","text":"妻子时相过，家山赋遂初。\n传经仍马郑，司法旧张于。\n燕市曾羁骥，鳣堂可梦鱼。\n问关江汉日，自学故人疏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20833,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寄东京陈君肇阶二首 其一","author":"吴曾徯","text":"管鲍今何处，陈雷事岂无。\n不知枯菀异，惟见性情孚。\n让避延陵地，危存赵氏孤。\n故乡深仰止，威凤在高梧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20834,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寄东京陈君肇阶二首 其二","author":"吴曾徯","text":"负笈留三岛，垂纶爱五湖。\n巫山别神女，东海得麻姑。\n春草难忘汝，樱花合笑吾。\n锦江归不得，只是畏城狐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20835,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"汉皋寄萧君公弼二首 其一","author":"吴曾徯","text":"不见萧君久，披书得寄诗。\n龙泉仍敛匣，鱼水未逢时。\n贾谊吴公赏，梁鸿孟女知。\n耦耕人去后，无复案齐眉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20836,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"汉皋寄萧君公弼二首 其二","author":"吴曾徯","text":"江汉风尘客，平生负所期。\n北燕空叱驭，东海失探骊。\n慷慨终军气，深长陆逊思。\n伫看神物变，云雨会天池。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20837,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"汉皋寄绵竹萧生直风二首 其一","author":"吴曾徯","text":"射水潜神物，风云会有期。\n此邦多将相，何日卜熊罴。\n莫副林宗望，深惭徐孺知。\n苍茫泣歧路，江汉未归时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20838,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"汉皋寄绵竹萧生直风二首 其二","author":"吴曾徯","text":"有子尊陶母，留宾忆范逵。\n龙津雷焕剑，虎旅晋公麾。\n海击鹏抟远，云垂鸟势卑。\n弦高今已矣，无复梦皋夔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20839,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"思亡友李生玉书二首 其一","author":"吴曾徯","text":"风劲雕逾健，途危骥不羁。\n归魂随使节，血雨捲灵旗。\n悍将多亡命，行人未失辞。\n郦生今不死，地下有相知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20840,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"思亡友李生玉书二首 其二","author":"吴曾徯","text":"痛挂延陵剑，徒归旧馆骖。\n轶群空冀北，遗恨在滇南。\n母老生无养，家贫死不甘。\n惟余吴季子，涕泪落江潭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20841,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"汉皋寄东京雷生眉生二首 其一","author":"吴曾徯","text":"太华终南秀，神龙野鹤姿。\n四川曾叱驭，东海竟探骊。\n雅量周瑜器，雄才鲁肃知。\n轻肥竞年少，相贵笑群儿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20842,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"汉皋寄东京雷生眉生二首 其二","author":"吴曾徯","text":"黾勉攻农学，归来奠国基。\n边荒屯恳策，耕战霸王师。\n治术穷三岛，雄心拓四夷。\n哀歌人拊髀，自觉负襟期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20843,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赠冯君翼之","author":"吴曾徯","text":"国士当朝器，将军大树家。\n济川才不世，蕴玉璞无华。\n头哭栾公义，孤存赵氏嘉。\n归燕曾阻我，蓟北有龙蛇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20844,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"闻冯君翼之葬故友魏君云泉于北京彰义门外寄诗哭之","author":"吴曾徯","text":"顷闻冯义士，葬友禁城西。\n碧血秋燐活，青山杜宇啼。\n十年孤寄子，九死故人妻。\n月夜南飞鹊，无枝何处栖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20845,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"闻杨君叔尧系渝狱作诗唁之","author":"吴曾徯","text":"孤鼠凭城社，豺狼伏路歧。\n四方嗟靡骋，万里欲何之。\n蓟北山青处，江南草绿时。\n白驹维不住，春色促归期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":20846,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]