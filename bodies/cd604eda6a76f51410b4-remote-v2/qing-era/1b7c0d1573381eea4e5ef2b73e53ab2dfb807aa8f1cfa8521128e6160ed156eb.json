[{"title":"声声慢 白桃花","author":"许嘉仪","text":"春心炼雪，腻靥凝酥，韶华淡到无痕。\n本色天然，清艳肯映朱门。\n吟边又来瘦鹤，认疏香、应误黄昏。\n瑶台畔、问冰霜多少，酝酿仙根。\n一任闲评轻薄，有澄潭明月，自证前身。\n梦断梨花，春去懒对芳樽。\n瑶阶露华如画，正缟衣、孤立销魂。\n台洞远，付相思，流水冷云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23518,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"徵招 为袁薇生题随园饯别图，图作展重阳会，为先贞悯公手笔","author":"许嘉仪","text":"少微化去烟霞在。\n琴尊几番欢聚。\n只此好家山，认天涯羁旅。\n豪情酬俊侣。\n且休论、断肠南浦。\n寂寂秋容，疏花短柳，满城风雨。\n指顾劫灰飞，销魂地，沧桑顿成今古。\n大树感将军，渺英灵何处。\n千秋终自许，任诗骨乱侵尘土。\n问多少、胜境消沉，有画图留取。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23519,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一剪梅 怀闺友","author":"许嘉仪","text":"倚竹牵萝证素襟。\n言有同心。\n弦有知音。\n月斜云散又而今。\n信断青禽。\n梦断青林。\n香烬幽窗自苦吟。\n雨气愔愔。\n晚翠森森。\n旧游庭院怕重寻。\n帘影阴阴。\n人影沉沉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23520,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渔父词","author":"朱宗淑","text":"黄叶秋风稻蟹肥。\n鹭鸶晒翅立渔矶。\n山翠湿，野花低。\n沽酒归来月满衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23521,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十六字令","author":"朱文娟","text":"箫。\n凤去秦楼不易招。\n湘江竹，残泪未曾消。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23522,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"长相思 次方芳佩韵","author":"孙丽融","text":"花气清。\n露气清。\n露冷花香何限情。\n风敲檐铁声。\n灯半明。\n月半明。\n灯月朦胧入苦吟。\n阑干莫久凭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23523,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 思乡","author":"孙丽融","text":"夕阳云树。\n阅尽古今离别绪。\n荒草寒芜。\n半是离人泪染枯。\n数声风笛。\n唤起乡心归未得。\n雁过遥空。\n不带南来书一封。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23524,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人","author":"柯纫秋","text":"梦回频听春鸡唱。\n催得银屏亮。\n搴帷生怕晓寒轻。\n祗觉朝来难撇、是鸳衾。\n庭前玉树枝相向。\n日影雕阑漾。\n隔墙风送卖花声。\n不道柳丝搓就、又清明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23525,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 岁俭偶感","author":"瘦鸾","text":"袖薄那禁寒。\n羞与郎言。\n早拚卖却砚池田。\n辛苦天寒萝屋底，又遇荒年。\n绣帖未曾完。\n针线抛残。\n娇儿啼饭忒心酸。\n一盏瓦灯篱落外，废尽秋眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23526,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秦楼月 关盼盼","author":"武铁峰","text":"春寂寂。\n落红飞满阑干碧。\n阑干碧。\n危楼空结。\n素心谁白。\n去年归燕今年识。\n独留清怨千秋惜。\n千秋惜，画成纤影，试临风说。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23527,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇","author":"杨琬","text":"小雨初收，野波清浅明如镜。\n荻花千顷。\n细响穿幽径。\n半杵晨钟，欲被风吹冷。\n听来近。\n寺藏松顶，玉塔玲珑影。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23528,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"高阳台 题顾羽素表姑《绿梅影楼填词图》","author":"杨琬","text":"画阁连云，疏帘隔梦，人间无此高寒。\n石瘦苔荒，一轮冻月团圞。\n悄然万籁声俱寂，凭烟痕、绿上毫端。\n对横枝，依约微吟，画损阑干。\n深宵不用银缸照，爱横斜疏影，写向冰纨。\n仿佛瑶妃，半鬟香雾初乾。\n披图忍读琴清句，侍慈帏、画卷曾看。\n听烟梢，翠羽飞来，同话心酸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23529,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"阑干万里心 山居","author":"许希琼","text":"几点青山翠抹烟。\n移家相傍水云边。\n日长无事枕书眠。\n听流泉。\n半是闲人半是仙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23530,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江南好 对月","author":"许希琼","text":"看明月，拜罢起徘徊。\n花影纷筛人影悄，虫声断续漏声催。\n珠露滴苍苔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23531,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人","author":"曹佩英","text":"秦淮稚柳娇无数。\n第一柔条数。\n成荫肯向大堤边。\n只有玉骢缓缓、许摇鞭。\n秋江双桨蘋波软。\n桃叶迎如愿。\n司花消受福三生。\n无奈风幡偏听、落花声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23532,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人","author":"曹佩英","text":"玉钩望断穿针夕。\n忍说黄杨厄。\n人间天上一般秋。\n只是生离死别、两般愁。\n十行清泪鸾笺洗。\n影事从头记。\n千秋水绘要同传。\n只恐影梅还逊、影兰缘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23533,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 题百蝶图","author":"孔印兰","text":"逐队飞来如解语。\n栩栩蘧蘧，相与成俦侣。\n写遍鹅溪多逸趣。\n香生一砚梨花雨。\n梦醒南华天欲曙。\n底事罡风，乱捲春深处。\n剩得粉痕黏落絮。\n芳魂已返罗浮去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23534,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雨中花 题秋海棠遗画","author":"孔宪英","text":"腕底酸红冷翠，写出秋容如醉。\n恨煞西风情太恶，吹作冰天泪。\n忍把画图当晤对。\n看小样、红妆憔悴。\n耳根内似闻蛩语，哽咽更教人心碎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23535,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"桃源忆故人 题瓶中桃花遗画","author":"孔韫辉","text":"图中春色浓如许。\n春只银毫能驻。\n写出嫩红娇吐。\n画史乘鸾去。\n断丝预谶诗人悟。\n引得泪痕无数。\n新燕窗前如诉。\n似说天台路。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23536,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"洞仙歌 倚吴蘋香女士调并用原韵","author":"秦霞","text":"冰檐一角，正蜡残时候。\n帖帖春魂向人逗。\n尽沉吟，小月寒抱双肩，浑筛遍，水墨画绫衫袖。\n冬缸青入梦，起拂苔笺，揽取蟾光不盈手。\n悄影似窥人，女字横枝，讶今岁、与伊同瘦。\n待小轴犀帘唤寒簧，对雪北疏花，冷香先受。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23537,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐 送外北上","author":"梁蓉函","text":"迢迢征路。\n是我曾行处。\n又送轮蹄从此去。\n惆怅参天云树。\n骊歌声度端阳。\n菖蒲花映离觞。\n日暮酒醒人远，晚烟愁锁纱窗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23538,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐 寄外","author":"梁蓉函","text":"恹恹离思。\n写入瑶琴里。\n忆唱阳关无限意。\n柳色遥遮千里。\n不知天外归鞍。\n几时准卜刀环。\n别梦常随明月，夜来飞度关山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23539,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"百字令 吊李月楼二尹殉难仙游","author":"梁蓉函","text":"奇士犹龙，洵一时、变化风云莫测。\n放下花前吟咏笔，上马居然杀贼。\n不厌卑官，籍酬壮志，襟抱谁能识。\n馀氛未扫，溪声流恨何极。\n可似唐代睢阳，城孤援绝，莫展平戎策。\n事业休将成败论，孤注有人频掷。\n梅岭风酸，枫亭月暗，过客增凄恻。\n如生原轸，定怀遗恨难释。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23540,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"沁园春 题亡媳赵玉钗遗像","author":"梁蓉函","text":"七载栽培，灼灼桃花，颠风乱吹。\n记华堂执贽，花幡春暖，文窗问字，兰焰宵辉。\n寒燠经心，趋承可意，绕膝依依似女儿。\n天难问，倏彩云影散，璧月轮亏。\n韶颜娇映铢衣，桄梦里、相逢却道非。\n剩晨昏冥想，病姿婉娈，丹青留得，旧态依稀。\n老鬓添霜，愁心对雨，诉与泉台知不知。\n凄凉况，向图中唤母，稚女娇痴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23541,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 春暮","author":"陈静英","text":"午漏迟迟。\n绿窗人倦春将过。\n留春无那。\n看满庭花堕。\n新绿帘栊，长日薰香坐。\n微风簸。\n燕子营巢，阑角香泥涴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23542,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西江月 丙寅春日偶成","author":"陈静英","text":"终日凉凉踽踽，频年冷冷清清。\n一身多病叹伶仃。\n如此桑榆暮景。\n膝下双珠何处，关山迢递难亲。\n一羁南楚一燕京。\n目断天边雁影。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23543,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 感怀","author":"陈静英","text":"长日无聊，坐深闺、终朝嘿嘿。\n又早是、银床露冷，玉兰风急。\n隙里华年流水逝，怀中壮志何时息。\n问苍天，生我竟何为，空抛掷。\n堪消恨，惟长箔。\n堪排闷，惟群籍。\n兴来时、唾壶击缺，玉钗敲折。\n何日言神吾所负，而今权处人之未。\n笑眼前、碌碌尽庸流，谁相识。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23544,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 题瓶中桃花遗画","author":"朱肄南","text":"瓣染鹃红，铜饼里、生香不断。\n想玉人，画眉初了，戏拈斑管。\n折叠屏前花雾深，博山炉里沉香满。\n对兰窗，写出一枝春，天初暖。\n曲栏外，飞絮乱。\n檐宇下，游丝缓。\n帘幕昼沉沉，暗垂银蒜。\n几点燕支抚艳容，数行麝墨添芳款。\n叹仙才，未合住人间，瑶池馆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23545,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 丙寅仲秋，余以侍亲留白下，遣方海、方澜两儿赴蜀侍夫子","author":"王少华","text":"皓魄满窗前。\n不照人圆。\n离魂真欲上青天。\n只为分巢双燕小，破尽宵眠。\n何计慰高年。\n日薄虞渊。\n时来甥馆问鱼笺。\n甚日浣花溪畔水，准送归船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23546,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南乡子 九日   见汪之珩《东皋诗馀》","author":"丛祁志","text":"佳节拟登高。\n一望寒山木未凋。\n菊酒才斟枫已醉，谁浇。\n摘叶题诗字有糕。\n风急搅林梢。\n何处游人帽欲飘。\n且插茱萸篱下饮，逍遥。\n夜静霜钟带月敲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23547,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 寄外二首 其一","author":"陆姮","text":"小楼昨夜春寒渐。\n绿筠帘子何曾捲。\n帘外又斜阳。\n一溪新水香。\n已教人远别。\n更把青山隔。\n人自不思归。\n布帆空解飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23548,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 寄外二首 其二","author":"陆姮","text":"酿花天气春愁重。\n淡云微雨都如梦。\n金斗熨沈香。\n夜来针线忙。\n踏青浑懒去。\n女伴空招取。\n多事是黄昏。\n替人催泪痕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23549,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十六字令 其一","author":"陈静英","text":"春。\n浅绿零红别样新。\n风光好，愁杀客中人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23550,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十六字令 其二","author":"陈静英","text":"艰。\n转徙流离又一年。\n家山杳，肠断早春天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23551,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆萝月 记正月二十八日","author":"陆恒","text":"去年今日。\n云压天凄切。\n杨柳条条桥畔折。\n死别生离片刻。\n从今短簿无缘。\n空闺月冷霜寒。\n谁遣辰钟敲醒，一场春梦难圆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23552,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"苏幕遮","author":"陆恒","text":"雨敲窗，风戛玉。\n幽咽凄清，似谱零铃曲。\n梦断寒更声转促。\n一寸灰馀，已做烧残烛。\n泣孤鸿，悲寡鹄。\n短了今生，未必他生续。\n待向仙山觅楼阁。\n不化青禽，也化辽东鹤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23553,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"金缕曲","author":"陆恒","text":"砥柱中流折，猛回头、惊涛卷岸，风悲月黑。\n海上骑鲸人已去，吹散蜃楼千尺，便从此、冰消瓦裂。\n石烂南山难补恨，怎偏教、铸错中州铁。\n输一着，谁筹策。\n长城百雉金瓯缺。\n又何曾、丝延续命，戈挥落日。\n莽莽寒江东逝水，只剩湘灵呜咽，纵拚化、哀鹃啼血。\n叫破黄昏天惨淡，唤春光、重转终无力。\n空染尽，伤心碧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23554,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"疏影 旅雁","author":"陆恒","text":"寒塘暮雨，有相呼倦侣，宵渡凄冷。\n似此天涯，长向西风，消磨如许瘦损。\n平沙浅草苍茫里，正一样、飘零无定。\n认遥空、点就疏痕，绝似离人倩影。\n容易年华换了，霜泥数爪迹，吹散萍梗。\n辛苦浮生，怎及闲鸥，日日水边睡稳。\n衡阳便是伤心地，已信断、乱峰难问。\n剩牢愁、独抱无眠，听遍辘轳金井。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23555,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卜算子","author":"陆恒","text":"几度怯临风，有恨无人识。\n一寸相思一寸灰，只剩红冰结。\n悄地背人弹，着雨菱花湿。\n待把真珠慰寂寥，点点凝愁血。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23556,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"迈陂塘 杜宇","author":"陆恒","text":"念家山、茫茫何处，酸辛归计休说。\n哀音催堕三更影，较比寒蝉凄切。\n东风急。\n怎似绮华年，弹指成陈迹。\n回头故国。\n尽望帝魂消，闻铃肠断，夜夜空啼血。\n浑不让，易水悲歌听彻。\n叮咛促尽行客。\n石沉北海难填恨，只剩冤禽吊月。\n花飞雪。\n纵百遍、相呼春去辉无日，声声呜咽。\n待叫破愁云，抛残红雨，染遍千山赤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23557,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"东风齐著力 落花","author":"陆恒","text":"苦被莺摧，频招燕妒，乃许消停。\n伶俜瘦损，耐得到春深。\n挨遍风风雨雨，飘零处、有泪无声。\n凭谁问、东皇去后，冷落重门。\n清露乞慈云，已负了、今生任委轻尘。\n断肠草色，凄入一痕青。\n狼藉残红零乱，鹃声里、偏又黄昏。\n伤心地，埋愁难觅，填恨难平。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23558,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤栖梧","author":"陆恒","text":"闪晕红花青欲绝。\n孤影伶俜，隐约虚堂黑。\n虬箭声催残漏急。\n半窗破纸迎风裂。\n死剩寒灰馀一息。\n还是当年，心字烧时积。\n熔尽啼痕凉似雪，柔肠已化并州铁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23559,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"百字令","author":"陆恒","text":"空阶一夕，滴芭蕉、秋心难展。\n檐铁丁丁，摇曳处、蓦地愁添宛转。\n秋木凄凄，秋花寂寂，秋意都零乱。\n捲帘人瘦，年华容易暗换。\n已入急管繁弦，不堪重证，裂破冰丝软。\n万斛真珠抛作泪，待把潇湘填满。\n压屋云沉，偎篱菊淡，冷落闲庭院。\n为谁听遍，空馀霜鬓搔短。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23560,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 题刘提督斌梅林咏月遗照","author":"陆恒","text":"新愁打叠传千里。\n谁从驿路迢迢寄。\n何处问刀环。\n封侯人未还。\n魂和残漏断。\n月近天涯远。\n踏遍垄头云。\n香消纸帐春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23561,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"迈陂塘","author":"陆恒","text":"对萧萧、满庭风雨，问秋秋怎无绪。\n分明似带恹恹病，洗褪秋容如许。\n抛不去。\n有万叠浓愁，都在秋心聚。\n频啼玉箸。\n尽莲漏敲残，铜壶滴尽，犹是声声絮。\n我待做，窗外芭蕉几树。\n好教夜夜听汝。\n悲秋可也秋知道，底事浑难为主。\n秋何处，只蔓草荒烟，一片寒蛩语。\n凄凉砧杵。\n把欲断秋魂，生生熔碎，零乱成丝缕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23562,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"酹江月","author":"陆恒","text":"今夕何夕，怅娟娟照处，风清月白。\n玉宇琼楼归去后，知在蟾宫几阙。\n也算曾圆，不堪重证，小历沧桑劫。\n前身记否，明明镜影磨灭。\n料应只合奔云，为谁系恋，莽莽尘寰窄。\n未必多情长锁恨，刚好从头悟彻。\n可是无缘，谁能遣此，击碎冰壶缺。\n霜花窣地，任他一例埋没。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23563,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如此江山 残月","author":"陆恒","text":"分明消尽恹恹样，堪怜一痕无主。\n愁不禁秋，瘦难成影，耐得几多酸楚。\n前踪漫数。\n已负了团圞，休言眉妩。\n挨到而今，料应灵药亦无补。\n前身曾做底事，累青天碧海，长伴风露。\n曲绕肠回，黯拚魂断，险胜银湾遥阻。\n催残禁鼓。\n似斜倚薰笼，夜凉凝雾。\n扶起零丁，有怀谁共诉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23564,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"喝火令 小春廿三为先夫子小兆祖茔，是日值余母难，抚然倚此","author":"陆恒","text":"堕地生逢日，埋忧死别时。\n半奁破镜半奁诗。\n还是酹君酹我、费寻思。\n玉殿修文早，金蝉脱壳迟。\n不曾双泛紫霞卮。\n负了秋山，负了鬓成丝。\n负了信沉青鸟，归路尚参差。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23565,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江南好 其一 八钟楼","author":"许英","text":"楼轩敞，远寺送疏钟。\n四面悠扬鸣晓暮，数声断续听西东。\n槛外夕阳红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23566,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江南好 其二 一窗山","author":"许英","text":"山气爽，扑入一窗来。\n翠黛半浮朝雨湿，碧纱全对暮云开。\n林壑日徘徊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23567,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江南好 其三 懒云窝","author":"许英","text":"云容懒，寂寂意如何。\n慵向春风寻雨梦，惯偕夜月伴诗魔。\n添我懒还多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23568,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江南好 其四 画雨楼","author":"许英","text":"山雨起，画景尽当楼。\n窗外远峦青似黛，帘前芳草碧于油。\n云脚望中收。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23569,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江南好 其五 来鸥阁","author":"许英","text":"池边阁，卅六野鸥闲。\n曲渚忘机随意戏，画栏久狎傍人眠。\n与结水云缘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23570,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江南好 其六 石笏庵","author":"许英","text":"筠庵小，瘦石挺云根。\n寸碧玲珑迷竹影，一卷磊落蹴苔痕。\n拄笏立如人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23571,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江南好 其七 春水船","author":"许英","text":"春水阔，岸上好牵舟。\n但有晴波环四壁，不须画桨打中流。\n长系碧溪头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23572,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江南好 其八 香屿","author":"许英","text":"春意早，寒绽几枝花。\n湖上逋仙甘隐迹，扬州水部乞移家。\n清韵绕香葩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23573,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江南好 其九 九松亭","author":"许英","text":"风雨古，森列九株青。\n千尺亭亭流月影，半空飒飒起涛声。\n应有紫鳞生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23574,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江南好 其十 潇湘馆","author":"许英","text":"斑斑竹，绕舍弄云梢。\n风度似调瑶瑟韵，雨来疑送楚江潮。\n静对读离骚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23575,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江南好 其十一 兰泉","author":"许英","text":"兰芬处，泉石亦膏盲。\n九畹尽堪纫蕙带，中泠谁与试茶香。\n花水两含芳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23576,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江南好 其十二 啸虹亭","author":"许英","text":"吟啸晚，天半彩桥横。\n影带断霞归水浦，气含残雨过江城。\n雌霓唤分明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23577,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江南好 其十三 竹堂","author":"许英","text":"庭幽邃，修竹荫阶除。\n昼静淡烟笼箨笋，秋高凉露湿林于。\n一径绿云铺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23578,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]