[{"title":"西山秋雨","author":"贾诠","text":"薄雾晚濛濛，轻阴漫远空。\n白云千嶂雨，黄叶一溪风。\n古寺疏林外，清流暮霭中。\n岩花纷结子，冷翠湿秋丛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10986,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"同大兄馨闻蒋子劲草秋窗坐雨","author":"吴琦","text":"偶然成小集，暮雨坐来清。\n道气深畴昔，天真老弟兄。\n拈阄分险韵，得句乱秋声。\n有酒今朝事，何须问世情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10987,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画","author":"郭年长","text":"独立意何如，爱煞秋光好。\n新霜催黄叶，斜月衔山小。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10988,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游飞来寺","author":"李汉","text":"寻幽入古寺，曲磴蹑层云。\n犬睡花阴破，泉鸣鸟语分。\n凭栏延水色，坐石绝尘氛。\n绀宇来何处，神灵自昔闻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10989,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登方山西岩卜居","author":"杨枢","text":"嵯峨盘谷路，策杖此经过。\n峰峻绝樵牧，崖悬障薜萝。\n人踪分径草，鸟语出林阿。\n莫赋居难定，松风任啸歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10990,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"灵圣寺","author":"林荃","text":"寺枕青山石径斜，钟声催月上梅花。\n老僧晓起浑无事，手掬新泉试早茶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10991,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"长沙晓发由赵口分道入沅江","author":"王九徵","text":"夜来风信紧，晓色望犹迷。\n别港遥分北，连峰尽向西。\n云随沙雁断，天入楚江低。\n为近三闾庙，群鸦特地啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10992,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题曹山俱为禅人画松泉图","author":"王九徵","text":"别涧通泉下竹厨，青苔白石任跏趺。\n问年记取亲栽树，笑指门前第几株。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10993,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"入塞曲","author":"顾珵美","text":"鼓角归榆塞，三军猎骑收。\n关前疏勒酒，马上月支头。\n露布飞金阙，云麾转白沟。\n君恩怜百战，中道敕封侯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10994,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浦口","author":"顾珵美","text":"白下多啼鸟，乡心不忍闻。\n千山悬别梦，片雨过离亭。\n急浪横沙白，飞帆带雾青。\n夕阳江浦上，孤客漫扬舲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10995,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"金陵怀古","author":"顾珵美","text":"秦淮原接大江流，绮阁还临白鹭洲。\n五马旌旗曾北渡，八公草木护南州。\n夜寒玉漏严城雨，月满铜驼故国秋。\n江左繁华零落尽，几时王谢更重游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10996,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闻吴子登泰山绝顶遥有此赠","author":"陈哲伦","text":"东望岩岩古岱宗，携筇独上最高峰。\n石坛晓映千崖月，日观晴飞万壑钟。\n天子何须寻汉策，大夫空自号秦松。\n凭栏四顾无穷兴，有客中原恨未从。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10997,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九日顾迂客雷阮徒招集吴山登高用昌黎人日城南登高韵","author":"魏儒鱼","text":"令序恣间寻，吴人雅好弄。\n微风况暄和，次帽不觉冻。\n群贤欣华至，夙饶济胜用。\n飞步蹑崚嶒，惭余未能从。\n彦先载酒来，次宗辄与共。\n相携升仙槎，空阔随目送。\n石湖晚更平，绿净绝攒葑。\n白发演《霓裳》，遏云声四纵。\n方罄卜夜欢，兹游讵倥偬。\n词客一流连，山灵亦增重。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10998,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"东荒田舍","author":"魏儒鱼","text":"云吟月啸尽徘徊，未与人间断往来。\n绕屋惟闻深柳合，过桥便见杂花开。\n隐书摊处长为主，钝榜悬时暂占魁。\n续聚桂如容入会，尚当寻尔向溪隈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10999,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山游限韵","author":"刘正谊","text":"越峰万叠清，高与苍穹薄。\n烟云互隐现，盘郁列岩壑。\n兹山卧南隅，芙蓉擎千萼。\n两崖界清溪，石发细可擢。\n沿流陟崔巍，飞翠眉边落。\n危磴空际悬，修绠差相若。\n翻疑太古初，神工巧空凿。\n纡回得平衍，心目悠然拓。\n古杀围松杉，疏钟度寥廓。\n山僧宿所谐，不厌逢迎数。\n妙谛竖拂诠，尘襟汲泉濯。\n卓午日影圆，幽奇导我索。\n老藤蛟虬盘，怪石虎豹攫。\n湍激金铁撞，禽喧丝竹作。\n岚封洞杳冥，藓蚀碑斑驳。\n奋力蹑崇冈，忘疲循略彴。\n海气忽吹来，天风唳孤鹤。\n视听乃一新，斯游良可乐。\n归途眷林峦，斜阳红半角。\n揽胜有前期，更订山灵约。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11000,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"七夕","author":"陆曾禹","text":"蒸暑尚未减，佳夕忽我临。\n顾兔细云衢，宛虹垂华林。\n绮窗弄玉笛，朱楼理瑶琴。\n缥缈入银汉，凄凉杂清砧。\n露辉金剪刀，风引素丝针。\n始妒合欢扇，次爱鸳鸯衾。\n仿佛琉璃帐，依稀环佩音。\n感物兴叹息，莫言辰与参。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11001,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送许星彩之{氵鷇}溪","author":"陆曾禹","text":"我与许子常徘徊，湖上同登照胆台。\n渔歌四起春草绿，横笛短箫送酒杯。\n人生聚散不可长，江风五月芰荷香。\n别我欲往兰溪去，执手依依情自将。\n许子之父方秉铎，苜蓿斋中未萧索。\n朝暮趋庭诲《诗》礼，青山万叠对高阁。\n去时漠漠双台高，江岸烟深猿夜嗥。\n倚天绝壁喷石乳，动地清流涌翠涛。\n兰阴山中兰蕙多，香风拂拂衣上过。\n一林翠竹笼烟霭，百尺苍松挂藤萝。\n知君雅意事游衍，紫霞白云常在眼。\n山光夜映酒杯中，几番脱帽坐苔藓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11002,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"洞霄宫","author":"陆曾禹","text":"洞霄真福地，上帝自高居。\n鹤语依轩竹，龙鸣出水渠。\n松台春草发，石壁晚花疏。\n自有乾坤大，何须步碧虚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11003,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"石门涧","author":"钱谅臣","text":"石门如崇墉，削石立万仞。\n上翻云涛雄，下激雷霆迅。\n堂隍欲相合，天匠开一衅。\n万壑閟英奇，日月曾莫觐。\n六月拥重裘，森阴不可进。\n远公《石门诗》，大雅发清润。\n朗咏过前峰，深篁韵疏磬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11004,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宿天竺","author":"钱谅臣","text":"山径轻寒敛暮云，月窗松影夜将分。\n不知何处峰头雨，并作泉声枕上闻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11005,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠沈南疑","author":"钱谅臣","text":"欲唱仙歌访羡门，琵琶旧手贱昆仑。\n花朝重理《云和曲》，待拨鹍弦与细论。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11006,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题友人草堂","author":"曹奕云","text":"草堂工结构，曲折趁溪湾。\n即此可容膝，何须更买山。\n鸟啼万籁静，花落一庭间。\n自得幽居趣，宁妨日闭关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11007,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双剑歌为周蓉湖银台赋","author":"曹奕霞","text":"何来匣底双芙蓉，光怪烛屋明秋虹。\n天地之宝恒万钟，非公博物谁昭蒙。\n七闽云历三十峰，遇人谈剑名猿公。\n剑虽不得其述穷，求之铸者靡良工。\n干镆自古竞楚风，方彼百鍊炉冶红。\n鬼神守护日月镕，良由造化非人功。\n低徊往事余形容，到处已成踏雪鸿。\n今兹建宁侯姓庞，命谁巧作山骨铜。\n两虬跃出雌与雄，公久望气如司空。\n得来仍在闽海东，神物固与奇士同。\n晦显岂必殊霜锋，纵使埋没粪土中。\n精采齧蚀光愈融，星文况铄银台崇。\n斗牛电掣凌苍穹，宝装漆鞘声鏦鏦。\n挂壁日惟图史共，舞时更与书法通。\n佩之岂止庇一躬，欲卫吾道驱阴雺。\n剑得其人其遇隆，不随下客弹鱼?。\n酒酣斫地曾无庸，轩开有绿气郁葱，摩挲三尺愁吴侬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11008,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题友人华岳诗后","author":"曹奕霞","text":"太华烟峦在一筇，自言亲手摘芙蓉。\n更无人泣苍龙岭，只有君登落雁峰。\n历历秦关归指掌，迢迢星海泻心胸。\n卧游挂我诗瓢处，尺五天边万树松。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11009,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游皋亭山 其一","author":"朱枫","text":"忆别皋亭去，游踪久寂寥。\n十年孤艇子，又泊半山桥。\n坞竹寒逾翠，崖霜晓未消。\n闲心皆可乐，木叶下萧萧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11010,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游皋亭山 其二","author":"朱枫","text":"登览浑难尽，孤亭接海天。\n潮声连澉浦，云气荡沙田。\n水远浮鸥外，林疏落日边。\n归船疑列岫，北郭晚凝烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11011,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游杜曲李氏桃溪村庄","author":"朱枫","text":"高下悬崖寺，萦纡乱水滩。\n疏钟云共远，积雪暮增寒。\n二寸鱼偏美，三蕉酒自宽。\n川原饶野色，带月倚门看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11012,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过灵隐寺至石人岭有怀钝丁借秋阁礼九莲观音之约","author":"朱枫","text":"花飞欲尽奈何春，赖此扶筇自在身。\n涧水有香松粉落，寺门无路蕨拳新。\n深林数笋频留步，远壑寻源屡问人。\n回首借秋高阁上，隔年尚滞九莲因。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11013,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"狎鸥图","author":"曹鉴乾","text":"清吟潇洒狎沙鸥，回首蓬莱是旧游。\n恐著羊裘劳物色，草衣云卧罢垂钩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11014,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"顾黄门祠","author":"孙炌","text":"水边祠宇碧云连，曾此栖迟撰《玉篇》。\n草树蒙茸浓更淡，无人可绘六朝烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11015,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浮渡石","author":"金启汾","text":"鬼斧何年劈，穿岩水一湾。\n前朝仙尹笔，遗刻断崖间。\n石带寒泉润，苔皴古字斑。\n清幽探不尽，日暮未知还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11016,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舟行","author":"龚书宸","text":"如驶舟行疾，声喧万马归。\n奔云随岸转，远树负天飞。\n风足帆能饱，江宽浪亦威。\n好山难注目，樯燕漫相依。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11017,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过滹沱河访严明府不遇","author":"彭湘怀","text":"咫尺滹沱岸，挥鞭逐晚风。\n严城秋色里，匹马水声中。\n远道惭崔玮，高名羡左雄。\n廿年买丝愿，惆怅夕阳红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11018,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"辊庄先生见过感赋","author":"彭湘怀","text":"听到琵琶声便吞，十年牢落那堪论。\n龙门无处寻玄礼，马厩还来问孝孙。\n日望长安春树远，兰搴芳渚暮云昏。\n先生睡足余何往，只合相从共酒尊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11019,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"铜雀台","author":"罗兆甡","text":"漳河曲曲泻平沙，魏武移浇铜雀花。\n儿女销尽英雄骨，遗言逆望望陵哭。\n生作疑冢七十余，知尔西陵何处居。\n毕生辛苦为谁忙，欢娱极处尽悲凉。\n龙泉欲吼飞光绝，不到今时已断肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11020,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"读阴二所寄诗","author":"罗兆甡","text":"孤影无情难一语，残镫余焰暖三更。\n新诗读罢出门望，今夕梦从何处行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11021,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"麻柳湾","author":"罗兆甡","text":"宛是当年载酒时，一湾春水映疏篱。\n山花莫讶人非昔，且属东风爱惜吹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11022,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春雨","author":"徐訚","text":"遥遥疏柳带长汀，山色朝来一抹青。\n春在雨中人不见，杜鹃啼与落花听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11023,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游茶园山","author":"徐奭","text":"危峰高矗立，俯瞰白云流。\n雾重晴疑雨，山寒夏亦秋。\n狖猿缘屋叫，魍魉逐人游。\n转忆逃秦日，萧萧木叶愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11024,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"读汉武本纪","author":"徐奭","text":"羽檄频年出凤台，边云漠漠战魂哀。\n可怜抛尽沙场骨，不换单于寸土来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11025,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋阴","author":"陈珏","text":"无端秋改色，黯淡四山同。\n古木昏鸦外，低天落雁中。\n迷离三径菊，寒峭一帘风。\n愿借江边笛，吹云散远空。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11026,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江夜","author":"陈珏","text":"篷窗凭望渺无涯，日暮孤舟泊浅沙。\n几处清猿哀落木，满天寒露湿蒹葭。\n乡心恻恻天难晓，往事茫茫月欲斜。\n一自飘零江海上，不胜双鬓惜年华。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11027,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宿馥公僧房","author":"黄华","text":"方笠枯藤衲子装，间随巢燕寄僧房。\n花埋红雨当三月，城带青山入夕阳。\n古寺庭虚封薜荔，荒陵碑废上牛羊。\n桐阴话罢茶烟冷，又听钟声出上方。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11028,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"结客少年场行","author":"方还","text":"生平负奇气，结交遍邯郸。\n邯郸多年少，相邀重一言。\n探丸入公府，拔剑洒重冤。\n一怒震都市，片语折郦樊。\n昨日羽书至，烽火照边垣。\n慷慨愿从军，挟矢到辕门。\n奋身作前驱，所至皆摧残。\n敌人望旗帜，各各心胆寒。\n大小三百战，肌肉无寸瘢。\n旧疆皆已复，露布入长安。\n天子赐颜色，列土为屏藩。\n再拜不肯受，大笑归丘园。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11029,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"金山","author":"方还","text":"岷山东来尽，中流一屿孤。\n潮声连旦暮，山势带荆吴。\n未雨云充栋，将风树落乌。\n夜深江月上，疑是坐冰壶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11030,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送友人归黄山","author":"方还","text":"秋色满城楼，秋风古渡头。\n此时一挥手，孤月在扁舟。\n草折黄花老，天空白露稠。\n十年还故国，欢喜入新州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11031,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次孙端人韵送别王次山钟仲恒","author":"尹继善","text":"金汁江头雨未收，行人欲别意还留。\n离觞共劝他乡酒，落叶初飞满路秋。\n一顾空群传冀北，万山何处忆蛮州。\n知心自是难分手，况值天涯久宦游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11032,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过燕子矶游永济寺偶用壁间韵留赠默默上人","author":"尹继善","text":"每过云蓝便系船，非关前路受风偏。\n秋残野岸丹枫冷，水落空江翠壁悬。\n月色微茫僧入定，钟声断续客初眠。\n回思十七年来事，似与名山有宿缘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11033,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"读刘皋闻便是离家莫忆家句有感再用前韵","author":"尹继善","text":"老去逢春与转加，轩亭喜傍水之涯。\n须知小住谁非客，即便同归那是家。\n拟上虚舟还载酒，更邀别院看移花。\n枯枝落水皆堪赏，何必樽前有丽华。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11034,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和袁子才新春见赠","author":"尹继善","text":"桃源咫尺谪仙人，春浪初生递锦鳞。\n爆竹声中消短鬓，梅花香里著间身。\n云归野岫光何淡，雪霁平林景更新。\n每有诗成先寄我，老来笔墨转相亲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11035,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"壬午七月石庵学使重过西园话旧仍用不系舟小集韵 其一","author":"尹继善","text":"积雨初收晚吹凉，西园留客对晴光。\n重来渐觉知交少，老去空添鬓发苍。\n远树烟笼钟岭翠，平池波泛藕花香。\n衔杯话到当年事，残暑疏星句未忘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11036,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"壬午七月石庵学使重过西园话旧仍用不系舟小集韵 其二","author":"尹继善","text":"栖霞胜处易句留，记否前番韵屡酬。\n松柏惯逢如旧雨，溪山正好是新秋。\n君应回首吟晴黛，我亦相思梦碧流。\n何日联镳苔径里，招携同上最高头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11037,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"壬午秋日刘圃三学士重过西园喜赋二章仍用见赠韵 其一","author":"尹继善","text":"槛外晴空豁紫襟，西园重喜共登临。\n幽窗风过莲香远，曲岸烟凝柳色深。\n话旧频倾留客酒，问年易动感秋心。\n老来握手情弥笃，宁祇论诗是赏音。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11038,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"壬午秋日刘圃三学士重过西园喜赋二章仍用见赠韵 其二","author":"尹继善","text":"迢迢旌节度江关，暂坐浓阴积翠间。\n恰喜青云来旧侣，相看翠竹似清班。\n池开练影明斜日，秋送蝉声咽小山。\n知有椿堂时在念，片帆转眼又西还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11039,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重阳后再游摄山接鹤峰前三日夜游摄山诗依韵和答 其一","author":"尹继善","text":"直似蓬莱境，休夸金谷园。\n虚亭悬木杪，远水接山根。\n露下苍苔润，风来落叶繁。\n静中闻鸟唤，可认是啼猿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11040,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重阳后再游摄山接鹤峰前三日夜游摄山诗依韵和答 其二","author":"尹继善","text":"极目鸿飞处，凌空塔影高。\n山明如冠玉，崖叠似奔涛。\n茗碗垆香伴，诗囊酒榼挑。\n胜游知几度，莫厌马蹄劳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11041,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重阳后再游摄山接鹤峰前三日夜游摄山诗依韵和答 其三","author":"尹继善","text":"忆昔登临始，犹然草树荒。\n穿林开曲径，凿石起层梁。\n池映天光满，桥通练影长。\n四时花柳色，不异锦屏张。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11042,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西园小集后花下独坐有怀子才仍叠前韵 其一","author":"尹继善","text":"幽栖岂是薄功名，厌说林深鸟不惊。\n白发时陪新弟子，青山也爱旧书生。\n承欢谁似饶其乐，舍肉还多见至情。\n料得冰楼无底事，横琴坐对月轮明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11043,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西园小集后花下独坐有怀子才仍叠前韵 其二","author":"尹继善","text":"近赠芝兰种满除，巡檐采采孰相于。\n窗前鸟静间欹枕，竹里镫明夜读书。\n见面难如千里外，论交喜在廿年余。\n小仓也仿栖霞意，闻又新添水一渠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11044,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送高南畴赴贵州臬司任 其一","author":"尹继善","text":"共挂一帆轻，何堪唱《渭城》。\n离杯空有约，别句不成声。\n日霁霜仍暖，沙明水自清。\n故人前路少，雁影恰逢迎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11045,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送高南畴赴贵州臬司任 其二","author":"尹继善","text":"万里苗疆路，黔山我旧过。\n峰高云傍马，磴险手攀萝。\n努力青霄远，伤离白发多。\n漫云非泽国，处处慎风波。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11046,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和袁子才冬日寄怀韵 其一","author":"尹继善","text":"枫林红叶带霜飞，记得江干送马蹄。\n歌到离亭声断续，人分淮浦影东西。\n年来夜雨添新梦，画里青山忆旧题。\n千里相思君识否，斜阳满树暮云低。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11047,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和袁子才冬日寄怀韵 其二","author":"尹继善","text":"林园拜赐仰皇情，愧我年衰列上卿。\n廿载风花看几度，三春桃李喜重生。\n山连蓬岛峰还翠，池接昆湖水更清。\n纵有诗篇忙里得，那如把酒韵同赓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11048,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]