[{"title":"读史记","author":"周馨桂","text":"千载何人及史公，喑呜叱咤气如虹。\n恰怜奇笔无多妙，只写穷通变幻工。\n言情每爱少陵工，神往当年陷贼中。\n敢谓雄词堪窃比，穷途落魄奈从同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19624,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"口号","author":"周馨桂","text":"前贤深敬惟桑梓，此日其如不可居。\n欲把一竿沧海去，茫茫何处钓鲸鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19625,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清溪行为小女绣蘅作","author":"周馨桂","text":"沈沈青溪水，粼粼见素石。\n素石终不移，清溪水常白。\n上帝闵清溪，寂寂螺鬘墅。\n特命婉娈人，来作清溪主。\n清溪映明月，子规欲啼血。\n灵风吹蘋藻，终古扬芳烈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19626,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"常阴沙夜坐","author":"周馨桂","text":"团团明月照孤村，瑟瑟悲风到荜门。\n累得低徊夜深坐，恐劳归梦欲消魂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19627,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"弟庭桂来常阴沙拟共远游","author":"周馨桂","text":"古吟茅屋滞江边，作茧春蚕只自缠。\n拟趁长风行万里，乘槎直抵斗牛天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19628,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"归江南","author":"周馨桂","text":"羁栖江北柳毵毵，落魄穷途总不堪。\n自有彼苍间作主，吟鞭一意指江南。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19629,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"经庞氏旧塾","author":"周馨桂","text":"人经乱后未旋归，寂寂闲庭昼掩扉。\n为报当年旧巢燕，呢喃三绕画梁飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19630,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"避兵自正月十三至六月二十三日抵家粪除感赋","author":"周馨桂","text":"病马思旧槽，穷鸟恋枯枝。\n岂敢怨寒苦，实命不逢时。\n伊余生不辰，遭世乱日滋。\n崎岖浊世中，乌道乃转夷。\n人情如秋风，枯叶落转吹。\n艰难历数月，囊空无晨炊。\n入门一粪除，欣戚两有之。\n吾复何容心，苍苍命不移。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19631,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"口号二首 其一","author":"周馨桂","text":"流离已幸得归辰，闭上衡门厌世尘。\n为语儿曹休自薄，古来蒙难正多人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19632,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"口号二首 其二","author":"周馨桂","text":"日照寒窗竹影虚，空山寂寂子云居。\n灵犀一点真灵物，一遇奇穷一洒如。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19633,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"避兵沈滨赠芝田吴翁","author":"周馨桂","text":"穷途邂逅慰吟魂，日夕相依似弟昆。\n怪道胸怀直洒落，虞山山色对君门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19634,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"读史","author":"周馨桂","text":"羿奡不终通，禹稷不终穷。\n贤奸在史策，千载无不同。\n奸当赫奕时，势可回苍穹。\n洎乎势既穷，惟有贤可风。\n读书不盈尺，兴亡万变中。\n治少乱日多，谁与论吉凶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19635,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏怀","author":"周馨桂","text":"苍天既生我，形骸非久留。\n鼎鼎百年中，于世何所求。\n嗤彼灵运辈，恃才遭愆尤。\n猗欤古君子，谦谦良优游。\n多言用自烁，简默重前修。\n陆海多波澜，一苇纵虚舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19636,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"正月十三日为小女绣蘅授命日志感","author":"周馨桂","text":"生作贫家女，应嗟命不辰。\n清流堪见志，孱骨竟成仁。\n咏絮才虽浅，耽书性颇真。\n伤心三载恨，当此眼前春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19637,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"佳日","author":"周馨桂","text":"佳日空怀古，翛然且闭关。\n生涯穿铁砚，残梦付空山。\n学道心难惬，多文手自删。\n出门何所往，小立便知还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19638,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"遁园","author":"周馨桂","text":"秋风飒飒吹古道，寒鸟啾啾啄香稻。\n遁园老畦无所用，姑卧空山作小草。\n能薄新将笔砚梦，耻与时文斗机巧。\n菜根之味甘如饴，治畦之劳亦觉好。\n何必要津去垂纶，日夕风波愁杀人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19639,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"古歌","author":"周馨桂","text":"君不见淮阴没齿作饿者，何由血溅钟室下。\n君不见上蔡仓鼠感得时，转眼空怀黄犬思。\n贫贱多求富且贵，富贵常如朝露危。\n勋业纵然堪盖世，何如空山采紫芝。\n自寻世外赤松子，安顾人间白眼儿。\n渭滨晚达桐江隐，鹰扬遗烈亦泯泯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19640,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"自题便面画梅竹","author":"周馨桂","text":"节既崚嶒心又虚，暗香疏影伴幽居。\n平生每叹离群苦，似此良朋恐不如。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19641,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"访沈滨吴芝田翁二首 其一","author":"周馨桂","text":"杯酒重逢笑口开，高山流水兴悠哉。\n呢喃颇有梁间燕，为诉迟回两载来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19642,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"访沈滨吴芝田翁二首 其二","author":"周馨桂","text":"故山日日闭柴门，只为高情系梦魂。\n今日好风吹一叶，得销离恨是清樽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19643,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"口号","author":"周馨桂","text":"闭上衡门月色清，浮云外物一毫轻。\n先生乌有公无是，羞向人间道姓名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19644,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"马齿","author":"周馨桂","text":"马齿行加长，龙门望竟遥。\n智惭陈曲逆，功让霍嫖姚。\n有过将年补，开胸藉酒浇。\n平生忧患甚，湖海气多消。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19645,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虹霓","author":"周馨桂","text":"虹霓鼻息不堪攀，从此高门海上山。\n破屋休欺穷杜老，胸中广厦万千间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19646,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"述怀","author":"周馨桂","text":"昔曾好吟咏，意欲追前贤。\n譬诸春林鸟，逢时响自喧。\n一自好经训，吟事几弃捐。\n登高虽有情，久涸如枯泉。\n况经离乱后，行止久知天。\n皂帽想幼安，瓜庐慕焦先。\n济世苟无权，素履当自全。\n身隐焉用文，废书且高眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19647,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"感事","author":"周馨桂","text":"豺狼迹已远，狐狸当道嗥。\n坚城藉为窟，摩牙日流膏。\n意气无一世，谓可日贪饕。\n一朝挂密网，众口快嚣嚣。\n始知驺虞仁，性不逐腥臊。\n天亦怜其情，陷井不遣遭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19648,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"读云间尹鋆德冰淑徵刻名山文选序例","author":"周馨桂","text":"有客奉一书，开缄眼忽明。\n举世重干禄，所争惟利名。\n谁能志名山，勋业事管城。\n尹君磊落人，文章拟权衡。\n意专闵遗佚，蔼然有馀情。\n三复序例言，令我心益倾。\n何时棹孤舟，握手话平生。\n大江鲈鱼鲙，秋风莼菜羹。\n剧谈资杯酒，斗落气纵横。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19649,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"院试寓郡城独坐对月无聊中叠韵成此五首 其一","author":"周馨桂","text":"绝好窗前月，清光向客来。\n友添惟对影，心死已成灰。\n善价看时辈，虚藏愧不才。\n此身何所用，且即隐蒿莱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19650,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"院试寓郡城独坐对月无聊中叠韵成此五首 其二","author":"周馨桂","text":"寒意几欲雪，推窗月复来。\n自怜无用木，共笑不燃灰。\n济世知非分，成名羡有才。\n且归颜氏巷，三径没蒿莱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19651,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"院试寓郡城独坐对月无聊中叠韵成此五首 其三","author":"周馨桂","text":"月向山头吐，光看几上来。\n愁听尘近市，坐待烛成灰。\n陋学原非道，宗工自爱才。\n姓名银榜烂，缥渺似蒿莱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19652,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"院试寓郡城独坐对月无聊中叠韵成此五首 其四","author":"周馨桂","text":"顺时力不足，好古兴犹来。\n且发终宵愤，重燃旧日灰。\n吾侪当报国，举世正需才。\n经训菑畬在，殷勤辟草莱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19653,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"院试寓郡城独坐对月无聊中叠韵成此五首 其五","author":"周馨桂","text":"刺骨寒风发，开怀好月来。\n科名心本淡，忠义志难灰。\n望道宜勤学，违时且炼才。\n殷殷镕气质，尚友仰东莱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19654,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"拙于酬世拟不赴省试","author":"周馨桂","text":"大比兴贤日，群英筮拔茅。\n凤鸣方翙羽，鸠拙且安巢。\n天意问蒙叟，山居玩遁爻。\n名场频战北，不敢复贻嘲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19655,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"口号","author":"周馨桂","text":"不树名场帜，悠悠已卅年。\n少惭班氏笔，老愧祖生鞭。\n远浦垂纶坐，空山枕石眠。\n闲来无一事，且以让时贤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19656,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"新岁课儿四首 其一","author":"周馨桂","text":"献岁甫开新宪书，闭门深效子云居。\n庭空自发窗前草，地僻曾无户外车。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19657,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"新岁课儿四首 其二","author":"周馨桂","text":"薄俗樗蒱狂一国，痴心词赋学三馀。\n迂疏莫谓乖时调，清福人间恐不如。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19658,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"新岁课儿四首 其三","author":"周馨桂","text":"新春尚未被春风，早引儿曹兴不穷。\n俗子空知嗤隐豹，壮夫聊自效雕虫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19659,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"新岁课儿四首 其四","author":"周馨桂","text":"摊书爱对闲云白，泼墨欣逢旭日红。\n四海吾侪当有志，莫因尘世作冥鸿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19660,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"纸鸢","author":"周馨桂","text":"造化新归掌握中，鸢飞且策蔡伦功。\n青霄直捧尧天日，碧落高翔舜世风。\n线索休嫌牵系累，羽毛真赖剪裁工。\n春来里巷浑无事，乐意群看五尺童。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19661,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"立夏日，赋得未到晓钟犹是春，有感三首 其一","author":"周馨桂","text":"宵钟未晓尚春风，一遇鸡鸣漏便终。\n饯别韶光惊短梦，成阴夏木谢芳丛。\n平生毁誉冰凝泮，身世兴衰日昃中。\n万事输人何足校，只嫌岁月太匆匆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19662,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"立夏日，赋得未到晓钟犹是春，有感三首 其二","author":"周馨桂","text":"昔日豪情慕古风，迩来涂抹作痴聋。\n晴窗墨沈乌丝上，夜火吟怀兔颖中。\n三径草生踪欲绝，一身萍寄梦真空。\n年年最易韶光老，搔首青天恨不穷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19663,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"立夏日，赋得未到晓钟犹是春，有感三首 其三","author":"周馨桂","text":"春风已去又薰风，时序频仍感寸衷。\n早岁情怀如远鹤，中年困顿作冥鸿。\n乐饥泌水诚何憾，仰止高山亦足雄。\n最是文场堪太息，累人头白日匆匆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19664,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"韩信钓台","author":"周馨桂","text":"汉劫已成灰，淮阴尚有台。\n冤真终古恨，兵是谪仙才。\n主忌封齐去，臣思灭楚来。\n两回雄说罢，一代霸图开。\n相国空劳荐，苍天枉赋材。\n辟阳侯好在，终得位三台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19665,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"将应岁试感怀三首 其一","author":"周馨桂","text":"廿八年来未遇时，每逢文战强驱驰。\n何妨老至居人下，但恨才疏悟道迟。\n身似野僧归退院，学如山茧作新丝。\n应将德业追先正，莫复词章斗巧辞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19666,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"将应岁试感怀三首 其二","author":"周馨桂","text":"曾逢日者许遐龄，只谓名非厕佛经。\n未死深惭人已朽，无才每恨笔难灵。\n敢思科第能登甲，且譬平生不识丁。\n自此痴聋没馀齿，鸿飞世外托冥冥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19667,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"将应岁试感怀三首 其三","author":"周馨桂","text":"平生寂处本无朋，一出衡门便取憎。\n莫怪交情多冷淡，当思峭骨亦崚嶒。\n相轻只是文人习，自胜应将故我惩。\n此去同行须耐辱，头颅老大尚何能。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19668,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"有感","author":"周馨桂","text":"人间赫奕是何方，莫若当今翰墨场。\n偶遇腾骧增意气，真看举动有辉光。\n英才合御龙门李，陋巷宜眠蝶梦庄。\n廿载诗书空励志，只成画饼实堪伤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19669,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"读虞山张竹泉丈补拙庐制义试帖","author":"周馨桂","text":"露盥蔷薇读不休，雄才似此渺无俦。\n骅骝出塞霜啼血，雕鹗盘空雪翮秋。\n官职折名名亦好，文章憎命命真仇。\n年高健在称潜德，五福原来贵未收。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19670,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赴梁溪塾先君子旧处也志感兼别儿守复守履二首 其一","author":"周馨桂","text":"小子今何事，重来读父书。\n凄凉存手泽，想象御篮舆。\n榻上风仍古，窗前月复虚。\n先灵时陟降，夙夜或开除。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19671,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赴梁溪塾先君子旧处也志感兼别儿守复守履二首 其二","author":"周馨桂","text":"共此香山下，翛然水一方。\n诗书消岁月，贫贱老风霜。\n柳色随行路，梅花渺故乡。\n别时无限意，濡笔竟难详。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19672,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寄虞山吴芝田翁","author":"周馨桂","text":"空谷望停云，慨想人如玉。\n春草似离情，朝朝上阶绿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19673,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"馆中有古墓缪姓官御史吊之以诗二首 其一","author":"周馨桂","text":"三尺高坟吊客稀，乌台此日已全非。\n光华尚说行骢马，灵爽犹闻识绣衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19674,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"馆中有古墓缪姓官御史吊之以诗二首 其二","author":"周馨桂","text":"修竹夜明新月色，古槐秋带旧霜威。\n清时后死公知否，一室琴书得暂依。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19675,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏日","author":"周馨桂","text":"春光最易去人间，夏日莺啼昼自闲。\n风起落花新衬屐，云飞拥树半遮山。\n违时且醉杯中物，望古聊欢镜里颜。\n莫叹平生常踽踽，多缘峭骨任疏顽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19676,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"言女史逸仙","author":"周馨桂","text":"人间女士真难得，廿载芳名籍玉台。\n生长湖山文学裔，声称闺阁大家才。\n瑶编灿烂歌礼化，粉本临摹爱绮梅。\n林下高风深足重，蓬莱一去几时回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19677,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"宵坐","author":"周馨桂","text":"宵坐寂寥灯影红，多惭览镜已成翁。\n悠悠怅忆儿童日，落落空怀上古风。\n入世何须如唳鹤，为人只合似冥鸿。\n娲皇自昔团尘土，愚贱分明是渺躬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19678,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"感怀二首 其一","author":"周馨桂","text":"幽栖宛似白云乡，户外纷纷绕绿杨。\n身贱复生忘姓氏，世衰流俗擅文章。\n且凭天作穷通主，一任人分上下床。\n漫比虫吟聊自适，雄心莫复在词场。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19679,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"感怀二首 其二","author":"周馨桂","text":"误堕人间且待时，刬除豪气莫求知。\n只宜晦养他年志，勿复流传旧日诗。\n啼鸟有情非胜侣，落花无语是良师。\n悠然枕上羲皇梦，自信陶公不我欺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19680,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋风","author":"周馨桂","text":"闭户虚生白，挑灯蕊落红。\n离情怜夜雨，孤客识秋风。\n响滴空阶上，途归薄梦中。\n男儿四方志，且自任西东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19681,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"半生","author":"周馨桂","text":"半生踪迹任西东，往事都归感慨中。\n游倦相如空有赋，数学李广竟无功。\n眼逢青处神常告，头未白时心尚雄。\n只觉忧勤难自逸，穷年矻矻似童蒙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19682,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题缄口观书图","author":"周馨桂","text":"默默心难忍，嘐嘐尤多随。\n寡尤甚独难，三缄真良规。\n废书智不益，观书有余师。\n上下数千载，了了寸心知。\n心知口不言，古人庶可追。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19683,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"暂寄","author":"周馨桂","text":"暂寄空山傍水居，清风朗月伴窗虚。\n声名不务聊求志，嗜好无他只在书。\n巷有回车陶处士，家徒立壁马相如。\n平生事事输人下，徙倚西畴羡荷锄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19684,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏怀","author":"周馨桂","text":"世外逍遥梦亦清，翛然嗜好若忘情。\n烟波有待垂纶去，风月无劳扫径迎。\n四海男儿关壮志，千秋造物忌荣名。\n龙潜凤哕皆前定，悟到盈虚意尽平。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19685,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题壁 其一","author":"周馨桂","text":"乌有先生室，只留四壁看。\n况今逢盗贼，无复见衣冠。\n腹有群书晒，颜馀古道欢。\n柴门数十步，抵得百城宽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19686,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"戏题","author":"周馨桂","text":"孰云贫到骨，犹见富多文。\n地恨穷村僻，聪难四达闻。\n川流不尽水，岫出有馀云。\n长啸柴门内，淩晨到夜分。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19687,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杂兴","author":"周馨桂","text":"堂构垂翰墨，颇已坠箕裘。\n日落西风来，书兴良悠悠。\n龙蛇腕中入，波涛笔底流。\n钟王忽在眼，慷慨慕前修。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19688,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"示儿叹","author":"周馨桂","text":"羊舌叹无子，彭泽责五儿。\n古来贤达人，所遭亦若斯。\n而我本疏顽，安有行足师。\n惟兹读书意，妄谓汝辈宜。\n当拟转一世，岂专骨肉知。\n汝辈不余慰，空为后世嗤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19689,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"观葬者","author":"周馨桂","text":"行行送葬者，恻恻悲路歧。\n平生居盛世，亦曾多交知。\n一旦归田邱，亲戚弃如遗。\n谁人送且哭，只有姊与妻。\n请君勿复哭，人世常若斯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19690,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]