[{"title":"海幢寺送客登眺感怀","author":"成克大","text":"万里浮槎至，凭高望越台。\n潮平梅雨歇，天阔岛云来。\n霸气余残垒，王宫尽劫灰。\n无边惆怅意，送客酒盈杯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6626,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"都门霜降日作","author":"郑茂","text":"风雨连朝动客愁，笳声呜咽满边楼。\n卷帘何事看新月，一夜霜寒木叶秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6627,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柳洲亭","author":"支隆求","text":"陡觉红埃隔市阛，青罗如带柳丝环。\n园亭自占晴云外，钟磐遥闻斜照间。\n顿醒尘心返初地，难抛积习爱名山。\n同群鸥鹭由来惯，消受春风一日闲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6628,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渡荆江","author":"孔贞瑄","text":"欲渡烧鸡浦，轻舟凌晓开。\n波从白帝下，人自夜郎回。\n两岸浮烟动，中流急雨来。\n江陵形胜古，残垒近城隈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6629,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虚上人从淄邑来胶欢然道故上人住青云寺乃余昔年读书处也","author":"王士祯","text":"连雨胶河涨，新晴路始开。\n书凭双鲤至，秋带一僧来。\n煮茗烟迷竹，谈经月上台。\n不堪追往事，山径锁荒苔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6630,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和王南州听杨太常弹琴诗 其一","author":"董俞","text":"莫谓钟期少，相逢故太常。\n穷途俱落魄，夙昔奉君王。\n调入巴云远，音同淮水长。\n雍门千古恨，倾耳泪沾裳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6631,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和王南州听杨太常弹琴诗","author":"董俞","text":"雅乐沦江海，先皇旧赐琴。\n曲终尝变徵，愁绝不关音。\n风雨孤臣泪，乾坤逐客心。\n可怜家万里，西望白云深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6632,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浒墅舟中别相送诸子","author":"崔华","text":"溶溶月色漾河湄，晓起频将玉笛吹。\n同上邮亭忘别绪，独行驿岸解相思。\n白蘋江冷人初去，黄叶声多酒不辞。\n此路三千今日始，蓟门回首雪霜时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6633,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江上","author":"崔华","text":"萧瑟满江上，一雁蘋际飞。\n水气杂渔烟，微茫入清辉。\n淡怀如高秋，生业在钓矶。\n大鱼饵不受，贪饵鱼不肥。\n断丝弃中流，石上散发晞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6634,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过江州有感","author":"崔华","text":"但得绝流去，此行非我身。\n有军挥白羽，无令不朱轮。\n坐失邯郸策，空嗟洮水人。\n故园花已落，惆怅老风尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6635,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题严陵钓台 其一","author":"崔华","text":"功名莫后人，云台已㛹娟。\n生不能封侯，何当故人怜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6636,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题严陵钓台 其二","author":"崔华","text":"昔年吴市门，辛苦南昌尉。\n应为妇翁留，七里光炯翠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6637,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题严陵钓台 其三","author":"崔华","text":"水习荆南公，步习大司马。\n此时烟濛濛，羊裘卧月下。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6638,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题严陵钓台 其四","author":"崔华","text":"影落台千尺，光连水一隅。\n我来亦爱此，不独是狂奴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6639,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"思亲","author":"马腾龙","text":"饮泪思慈母，晨昏托老妻。\n孤身万里客，异地五更鸡。\n瘴疠侵人骨，江山老马蹄。\n山城城外柳，一望一凄迷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6640,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒项王庙","author":"张玉书","text":"项王祠枕长河水，拔山气沸惊涛起。\n阴森白昼啼鼪鼯，萧瑟西风黯菰米。\n座傍乌骓伏不鸣，馀怒犹欲乘云腾。\n想象悲歌出垓下，可怜遗恨迷阴陵。\n英雄坎壈识天意，失路东归亦何济？\n万户轻身赠故人，一死何颜见义帝？\n往事东流逝不回，雌雄壁垒空尘埃。\n君不见下相城头望丰沛，樵歌暮上歌风台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6641,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"息浪庵夜坐别叔敦让木诸子","author":"张玉书","text":"短棹携樽触浪过，将离莫问夜如何。\n最怜帆远浮天阔，始信江空得月多。\n隐隐钟声千佛唱，星星岸火一渔蓑。\n荒鸡促曙行人去，回首双峰护薜萝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6642,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"大阅恭纪","author":"张玉书","text":"銮舆晓出传宫漏，万乘春蒐控玉鞭。\n十二羽林雕辇后，三千犀甲幔城前。\n招摇色映长堤直，华盖香凝禁树妍。\n脱臂饥鹰霜距疾，嘶风彀骑雪花拳。\n龙鳞乍晃云霄上，虎旅同趋日月边。\n褒鄂宗臣张左纛，薛岐帝胄领中权。\n衔枚受律连营肃，射柳分弓七札穿。\n觱篥声中看队列，铙歌曲里促觞传。\n丁宁诸将投戈日，长忆先皇讲武年。\n驷介踏云还紫禁，六飞扶日下青天。\n威驰塞北名王垒，风靖滇南涨海烟。\n指顾销兵资庙略，两阶舞罢谱虞弦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6643,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送邱曙戒前辈之武昌","author":"张玉书","text":"猿声夹岸听斜阳，江树苍茫接故乡。\n却较长沙归路近，行吟何事怨潇湘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6644,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"挽马章民年丈二首 其二","author":"张玉书","text":"辛苦中闺罢锦机，白头曾未识宫衣。\n可怜风雨寒灯梦，犹是书堂夜读归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6645,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"季秋王公武约游上方山","author":"李仙根","text":"二十年前望落霞，如今重到似还家。\n半山红日迎人出，一径清烟傍马斜。\n鸦势远盘孤塔影，渔歌长应转帆挝。\n偶然兴会因同调，欲觅幽闲更觉奢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6646,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"云台画","author":"申涵昐","text":"云台画，黜椒房，椒房庸何伤？\n君不见，麒麟阁上将军光！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6647,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"铜雀台","author":"申涵昐","text":"铜雀台，分香履，一代雄风长已矣。\n台上月明，台下流水。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6648,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"佛骨表","author":"申涵昐","text":"欲佞佛，及于骨。\n然顶焚指，意在获福。\n谓可不死邪，佛如不死那得骨？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6649,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杂兴 其一","author":"申涵昐","text":"青青岭上柏，移植廊庙间。\n但能守清操，所至皆深山。\n疏水卿足乐，逢迎耻厚颜。\n闭门而却扫，坐卧有余闲。\n何为长戚戚，徒使鬓毛斑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6650,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杂兴 其二","author":"申涵昐","text":"公卿税文藻，名士贡航梯。\n辽东夸白豕，楚人来山鸡。\n欲贵洛阳纸，先灾大谷梨。\n猎者道交错，謦唾比虹霓。\n谁作指南车，破此歧路迷。\n士人先德行，淘金黜沙泥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6651,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜宿刘将军园亭 其一","author":"申涵昐","text":"建纛江东久，将军喜论文。\n门庭无棨戟，池榭有烟云。\n曲折堪修禊，风流已冠军。\n我来方夏日，凉月夜缤纷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6652,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜宿刘将军园亭 其二","author":"申涵昐","text":"仗剑从戎去，堂留绿野虚。\n园丁晨扫径，奴子夜烹鱼。\n灞上谁开垒，西湖正跨驴。\n清时无战伐，卫霍有闲居。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6653,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"黄竹子歌","author":"黄金台","text":"江边黄竹子，风雨夜悲鸣。\n不堪截作笛，亦有断肠声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6654,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登千佛山绝顶","author":"孙蕙","text":"淅淅天风响雁群，移尊飞阁未全曛。\n僧参破寺疑驯鸟，人到空山似懒云。\n晴壑日悬初地静，平林风定午钟分。\n思从慧业诸缘减，碧乳香寒石窟闻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6655,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舟泊广陵","author":"孙蕙","text":"横塘草碧竹烟凉，树带风乌绕蜀冈。\n二十四桥何处问，广陵城下月如霜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6656,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登燕子矶","author":"孙蕙","text":"铁锁沉江王气收，萧骚风色暗江楼。\n丹枫远岸戎戎市，绿浦寒烟点点鸥。\n秋好金陵桃叶渡，风回玉笛木兰舟。\n名山输却空王子，梵刹依然枕碧流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6657,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舟出瓜洲","author":"孙蕙","text":"一棹晚江静，欲就人烟泊。\n鸟边日微茫，眉际金焦落。\n初地动疏钟，客心方寂寞。\n沙碛长潮痕，竹树攒江阁。\n放眼扬子桥，已转瓜洲郭。\n安得故人来，孤篷共斟酌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6658,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"金山","author":"孙蕙","text":"水国琳宫蜃气昏，云开金碧射朝暾。\n一围树色高连塔，四面江声涌入门。\n郭璞墓前增战垒，中泠泉上没潮痕。\n凭临不敢舒长啸，恐有蛟龙卧石根。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6659,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送友人北归","author":"孙蕙","text":"长淮二月风气和，濛濛花雾清明过。\n南浦春涨送君去，共醉当筵金叵罗。\n黄河奔激天吴蹙，白浪如山骇心目。\n峒峿山头落照红，轻裘解向河干宿。\n野水添杯酒不醇，欲留欲去意逡巡。\n桑柘阴阴啼布谷，柴门稚子待归人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6660,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虎丘宴集分得微字","author":"孙蕙","text":"偶携蜡屐来吴会，海涌峰头看落晖。\n人去故山秋渐老，客逢新月雁初飞。\n当筵洞壑留今古，过眼云烟任是非。\n良夜坐深金粟影，天香都上酒人衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6661,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"于忠肃公祠","author":"孙蕙","text":"出狩天王竟北征，烽烟已逼凤凰城。\n有君定国真长策，奇货难居始罢兵。\n南内邀功争复辟，西曹枉杀患无名。\n最怜一事公遗恨，不使前星羽翼成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6662,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"坐灵隐冷泉亭得响字","author":"孙蕙","text":"侵晓纵清眺，爽气生林莽。\n脱叶映初阳，宿露滴余响。\n幽讨策短筇，岩壑恣下上。\n灵隐瞰湖光，泠然惬心赏。\n蘋香散汀沙，鸥泛随兰桨。\n萧萧枫树林，色夺明霞朗。\n支公快同游，玄言共俯仰。\n人生激电流，能著屐几雨。\n岩栖养性灵，衔杯动遐想。\n何时赋《遂初》，结屋东西瀼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6663,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"兰溪道中","author":"孙蕙","text":"轻舟摇桂楫，细雨过兰溪。\n远寺山支阁，层田水叠梯。\n林稀松鼠见，烟暗竹鸡啼。\n难倩河阳画，吟诗落日低。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6664,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登八咏楼","author":"孙蕙","text":"翠屏回合万峰收，婺野星分古缙州。\n官廨闲云遗碣在，人琴往迹大江流。\n西堂春草年年合，南浦飞鸿字字秋。\n苦忆东阳清太守，苔阴满地客登楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6665,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闻鼓山绝顶可望海外诸国欲登不果","author":"孙蕙","text":"共说鼓山高出群，半天峦翠昼氤氲。\n岛藏诸国晴时见，风卷洪涛静夜闻。\n未得肩舆随度鸟，何时蜡屐踏层云？\n晦翁亭子空相忆，绝顶松篁望不分。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6666,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"灵宝女郎祠","author":"孙蕙","text":"缥缈仙楼似玉京，苍茫独眺旅人情。\n河声入洛三门合，岳色来秦万里明。\n望气台空芳草暮，度关人去夕阳横。\n孤心别寄登临外，徙倚愁闻二月莺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6667,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"太华绝句","author":"孙蕙","text":"绝顶青冥露掌开，仙人风迹隐楼台。\n云间忽敞中原色，俯看黄河一线来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6668,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秦川怀古","author":"孙蕙","text":"内史新丰不可求，长陵王气已全收。\n千盘鸟道归隆准，百战鸿沟割沐猴。\n风雨满天来渭北，麒麟遗冢自南丘。\n几经汗马劳诸将，紫塞黄榆起暮愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6669,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"为姜勉中兄弟题谏草楼","author":"孙蕙","text":"杖血曾闻溅汉廷，孤忠旅望海云青。\n难回国步逃吴市，易了家缘问敬亭。\n失序雁鸿天漠漠，经时薇蕨雨冥冥。\n空馀十二封章在，梦绕铜驼几涕零。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6670,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"为姜勉中兄弟题谏草楼 其二","author":"孙蕙","text":"沧海横流付急湍，当年一柱砥狂澜。\n吁天抗疏枫宸远，斫地高歌宛水寒。\n长忆主恩留北寺，当诛臣罪恋南冠。\n不辞党锢人千古，辽鹤归来尚故官。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6671,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"大坯山","author":"马世俊","text":"远影平如盖，孤峰澹若云。\n松楸迟日照，芦苇带风闻。\n翠潋一湖抱，青光三郡分。\n忘机余已久，鸥鸟自成群。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6672,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九日即事","author":"马世俊","text":"晓檐爽气报初晴，云意徐收到树轻。\n落叶裁诗秋蝶化，短篱曳杖午鸡鸣。\n一峰入户青光好，万里登台白发生。\n眼底纷纭休再问，满天鸿雁不同程。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6673,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"坐骆氏水天一色楼","author":"马世俊","text":"翠色空濛隔岸来，高楼如画面湖开。\n此生未得余杭郡，今日相期河朔杯。\n天远亭虚谁放鹤，山寒节近好寻梅。\n义乌才子多流落，词赋乡关起暮哀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6674,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闰三月二十八日午门应制赐宴及烛","author":"马世俊","text":"右掖趋朝瑞霭浓，千门望跸立从容。\n烟光次第笼台柳，漏点依稀带晓钟。\n曝背岂知丹陛峻，温纶不待紫泥封。\n大官送饭初承诏，银烛还闻下九重。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6675,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杂咏","author":"罗人琮","text":"平生作计许吾曹，肯向千秋觅剩膏。\n觉悟偏生标一指，神明固胜画三豪。\n全天自合同樗栎，与世何当学桔槔。\n闲却此身休运甓，姑从痛饮快持螯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6676,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送沈融谷之任来宾","author":"邵延龄","text":"茶星大雅士，试县得来宾。\n来宾剧远道，象郡开自秦。\n炎方殊气候，服食慎风尘。\n故旧纷相慰，猺獞皆吾民。\n方今朔南暨，顽梗良以驯。\n君也勤抚字，礼让风俗醇。\n所负平生志，盘根才独伸。\n挥手勿复道，登车忘苦辛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6677,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"存诗稿用宛陵韵","author":"邵延龄","text":"诗不可轻作，此论疑亦偏。\n不求文字名，何必责备全。\n禽虫有鸣窍，而人胡不然。\n喜怒一写之，何物更存焉。\n君子贵寓意，任情长短篇。\n不必笑梨枣，士无轻弃捐。\n嗟哉文章伯，刻苦穷岁年。\n纵有山水趣，仍为居食牵。\n自命颇不小，李杜相后先。\n诋毁中晚季，曾不及宋贤。\n我所阁笔者，名山与大川。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6678,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次张耳黄元日韵","author":"邵延龄","text":"拂拂春风到鬓边，星星偏不让人先。\n连朝客思浓于酒，十尺闲斋小似船。\n是处名流吟节序，谁家老妪解诗篇。\n劝君且袖祢衡刺，薄醉疏狂得少年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6679,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"王家营别诸同人","author":"李时震","text":"脂车春晓别园林，握手依依思不禁。\n千里关山今夜月，一时樽酒故人心。\n缘堤柳浪催行色，绕树莺簧弄好音。\n尺素自然频见寄，临歧那复更沉吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6680,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"筑墙谣 其一","author":"连佳樗","text":"高筑墙，墙高不可越，登登杵声莫教绝。\n官司念汝汝自竭，不见东村，鞭挞流血。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6681,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"筑墙谣 其二","author":"连佳樗","text":"县吏下马，挥鞭戟手。\n虎咆雷殷，儿啼妇走。\n老翁指墙，噤若无口。\n土在身，木在首。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6682,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"筑墙谣 其三","author":"连佳樗","text":"墙下有壕，壕深及水。\n水潺潺，壕无址，风雨忽来，墙入壕底。\n风耶雨耶，戕我生者汝耶？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6683,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"饮丁若思榆枋馆 其一","author":"连佳樗","text":"负郭人家少，结庐丛树中。\n岩深能障月，洞小自留风。\n曲径竹阴密，长廊花气通。\n选茵聊共坐，是处有残红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6684,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"饮丁若思榆枋馆 其二","author":"连佳樗","text":"君自多幽兴，能留看竹人。\n檐花催进酒，池水待垂纶。\n稍话间中事，真疑世外身。\n柴扉须静掩，此外即风尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6685,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"饮丁若思榆枋馆 其三","author":"连佳樗","text":"此径不常扫，今来门始开。\n多君储绿醑，许我破苍苔。\n寄兴花边句，留欢池上杯。\n还期待良夜，看月一登台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6686,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"饮丁若思榆枋馆 其四","author":"连佳樗","text":"石床环坐稳，微雨况初过。\n盘摘新蔬早，衣沾落絮多。\n看棋移日影，把酒度莺歌。\n欲结求羊侣，还来就薜萝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6687,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"龙潭村","author":"张衡","text":"不识烟尘地，犹藏太古村。\n苍松迷谷口，怪石绣云根。\n岩复人居匿，坡回犊牧暄。\n柴门堪小憩，转盼失桃源。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6688,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"塞下曲 其一","author":"张衡","text":"羽书忽动塞垣开，十万军储括地来。\n闻说屠耆归命早，凯声已过赫连台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6689,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"塞下曲 其二","author":"张衡","text":"悠悠羌管动边愁，二月冰寒水不流。\n回首家园春色断，有人掩泪独登楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6690,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闻笛","author":"张衡","text":"寒鸿初动塞云收，阿滥堆中唤客愁。\n记得吴江归棹晚，芦花风外一声秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6691,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平溪道中漫兴","author":"牛枢","text":"不是函关界，胡为紫气翔。\n岚氛迷晓色，林影障晴光。\n雨洒征衣薄，风回驿路长。\n分明烟火处，隔水正徬徨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6692,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]