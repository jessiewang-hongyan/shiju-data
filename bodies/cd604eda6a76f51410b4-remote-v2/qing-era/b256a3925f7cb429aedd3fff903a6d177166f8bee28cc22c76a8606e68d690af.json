[{"title":"新开岭白云","author":"张鹏翮","text":"深山雨后气犹寒，拄杖登临未觉难。\n今日凭高无限意，白云看罢倚栏干。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16184,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"重经山店有感","author":"张鹏翮","text":"曾忆黄花过水滨，儿童惯见往来频。\n青山绕舍依然在，迎客门前少一人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16185,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"读孙冕七十诗有感","author":"张鹏翮","text":"七十风光叹转蓬，应谋泉石作愚公。\n莫将天下清闲福，一棹烟波让钓翁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16186,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"碧桃","author":"张鹏翮","text":"呼嵩祝寿万人家，群坐经棚到日斜。\n回忆十年人事改，空余庭下碧桃花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16187,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"喜雨","author":"张鹏翮","text":"灵雨濛濛润物深，三农早见遂欢心。\n悬知南亩分秧处，陌上垂杨笼翠阴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16188,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"阿喜塞口","author":"张鹏翮","text":"巴塘云影日悠悠，黑水金沙绕塞流。\n一夜悲风摇草树，千山明月照江楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16189,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"对藤花怀富太宰","author":"张鹏翮","text":"白发朝回入署中，藤花相映绿槐浓。\n清香满座同谁赏？\n人在云山第几峰？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16190,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"通州道中大风","author":"张鹏翮","text":"鸡鸣戴月踏冰河，风起边隅冷更多。\n谁似山中高士卧？\n每从枕上听樵歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16191,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凯歌","author":"张鹏翮","text":"先取巴塘向北行，军威直到藏王城。\n雪山回首低如屋，喜见荒原春草生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16192,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"合州冷泉","author":"张鹏翮","text":"碧山绿树隐云端，两派泉分旱不干。\n寂寞金鱼游泳处，无人知道此寒泉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16193,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"怀刘了庵先生","author":"张鹏翮","text":"空见巴山渝水长，舟人指点是公乡。\n更看万仞烟霞外，绿树红花照夕阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16194,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"又题温泉","author":"张鹏翮","text":"独寻春色上高台，鸟语花香淑气回。\n洗尽人间无垢体，满天风雨一时来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16195,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"官溅溪三首 其一","author":"张鹏翮","text":"碧山重叠暗青云，风送禽声入耳闻。\n溪上杨花飞似雪，扁舟一叶趁斜曛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16196,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"官溅溪三首 其二","author":"张鹏翮","text":"修竹深林绕径迷，马迟路滑怯春泥。\n行人憔悴无宁处，却恐寒山日向西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16197,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"官溅溪三首 其三","author":"张鹏翮","text":"绿树红花伴紫萝，白云无奈别离何。\n可怜衣带盈盈水，从此含愁日更多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16198,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"庆元山","author":"张鹏翮","text":"他日归来第四台，独寻春色几徘徊。\n五文锦上分明见，好向观音瓶内开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16199,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"暮春归赤崖旧居","author":"张鹏翮","text":"白首还乡故旧稀，桃花落尽李花飞。\n玉屏山下森森柏，不改清阴待我归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16200,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渔矶","author":"张鹏翮","text":"茅屋鸡鸣莫厌听，篱边风静落花轻。\n一竿烟雨苍苔湿，好向渔矶稳处行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16201,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"交河莲窝偶题","author":"张鹏翮","text":"高阁清凉堪避暑，风吹香气袭人衣。\n荫庥坐爱深林好，倦鸟依人不欲飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16202,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"牛栏山","author":"张鹏翮","text":"岚光倒影落清浔，流出双峰直至今。\n漫说金牛遗古迹，空教人向洞中寻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16203,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"人日","author":"张鹏翮","text":"人日晴和泰运逢，白头官舍又春风。\n梅花雪里香常在，一气浑然造化中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16204,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日重游灵泉寺","author":"张鹏翮","text":"杏花时雨浥轻尘，马踏春泥不厌贫。\n如意归来如意去，暂于林下作闲人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16205,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼故光禄卿李子静三首 其一","author":"张鹏翮","text":"凤凰池上著朝衫，文彩风流侧帽檐。\n化鹤空归华表夜，无人识得旧官衔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16206,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼故光禄卿李子静三首 其二","author":"张鹏翮","text":"榜眼科名一旦空，独留翰墨想余风。\n何时更上方山去？\n独向荒原悼李公。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16207,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼故光禄卿李子静三首 其三","author":"张鹏翮","text":"不闻楚客咏江漓，廿载长安隔梦思。\n桂酒椒浆浇宿草，平生风仪忆当时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16208,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"成都青羊宫青羊","author":"张鹏翮","text":"京师市上得铜羊，移往成都古道场。\n出关尹喜似相识，寻到华阳乐未央。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16209,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题昭君青冢","author":"张鹏翮","text":"丰郡城南一故丘，千年青冢尚含羞。\n琵琶马上和戎策，应在麒麟最上头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16210,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"喀尔喀曲","author":"张鹏翮","text":"水竭草枯叹俗穷，腰悬竹箭臂悬弓。\n轻躯上马飞如鸟，只畏中原火器攻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16211,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"塞下曲五首 其一","author":"张鹏翮","text":"匹马萧萧塞草黄，淡云孤月影微茫。\n繁华曾说苏杭好，不信人间有大荒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16212,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"塞下曲五首 其二","author":"张鹏翮","text":"蜂聚穹庐一室春，开窗满目尽风尘。\n谁家饱啖酪酥饼，即是龙堆富贵人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16213,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"塞下曲五首 其三","author":"张鹏翮","text":"惨淡黄云日色低，红毛碧眼向人啼。\n并驱马上扬鞭去，莫向桃花洞口迷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16214,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"塞下曲五首 其四","author":"张鹏翮","text":"夜半孤灯涸井傍，童山竭泽世茫茫。\n马声嘶彻炎风起，不是征人亦断肠！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16215,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"塞下曲五首 其五","author":"张鹏翮","text":"牧马荒原夜不休，朝来移帐到沙头。\n流泉每遣山灵护，恐惹征人照月愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16216,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人 胡蝶","author":"张惠言","text":"斜阳谁遣来花径，春色三分定。\n游丝无力系花腰，忙煞枝头相途乱红飘。\n寻春莫向花间去，花外游蜂聚。\n南园芳草不会空，收拾春魂归去绕香丛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16217,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"双双燕","author":"张惠言","text":"满城社雨，又唤起无家，一年新恨。\n花轻柳重，隔断红楼芳径。\n旧垒谁家会识，更生怕、主人相问。\n商量多少雕檐，还是差池不定。\n谁省、去年春静。\n直数到今年，丝魂絮影。\n前身应是，一片落红残粉。\n不住呢喃交讯，又惹得、莺儿闲听。\n输与池上夗央，日日阑前双瞑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16218,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"傅言玉女","author":"张惠言","text":"多谢东风，吹送故园春色。\n低晴浅雨，做清明时节。\n昨夜花影，认得江南新月；一枝枝漾，春魂如雪。\n却问东风，怎都来伴阒寂。\n绣屏绮陌，有春人浓觅。\n闲庭闭门，翻锁一丝愁绝；梦儿无奈，又随春出。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16219,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"粉蝶儿 春雨","author":"张惠言","text":"甚心情还自来小楼凝望？\n一丝丝、看他愁样。\n软东风、暂禁着、柳花飞扬。\n却无端、催着桃花飘荡。\n者心情付春雨绕遍天壤。\n一丝丝、看侬愁样。\n是啼痕、染就了、万重熘障。\n问江南、芳草可还惆怅？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16220,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青门引 上巳","author":"张惠言","text":"花意催春醒，和雨做成云性。\n流杯不敢趁轻阴，游丝一缕，个是江南影。\n无端燕子呼残病，说道春将尽。\n出门却看芳草，青青放出垂杨径。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16221,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南歌子 长河修禊","author":"张惠言","text":"云重才寻翠，风轻已试香。\n桃花好在柳初黄，和着三分飞絮，便轻狂。\n旧迹莺能说，新愁水自长。\n只须坐石莫流觞，若到三分薄醉，耐斜阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16222,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"水龙吟 瓶中桃花","author":"张惠言","text":"疏帘不卷东风，一枝留取春心在。\n刘郎别后，年时双鬓，青青未改。\n冷落天涯，凄凉情绪，与花憔悴。\n趁红云一片，扶侬残梦，飞不到，垂杨外。\n看取窗前细蕊，酿幽芳、几多清泪。\n六曲屏风，一痕愁影，搅来都碎。\n明月深深，为花来也，为人无寐。\n怕明朝又是，清明点点；看他飞坠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16223,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"水龙吟 寒食次计伯英韵","author":"张惠言","text":"向前还有多春，廿番花信从头计。\n西风做冷，东风做暖，桃花都记。\n守得春三，禁熘时候，雨酡云醉。\n怕玉楼深处，游人未见，又一片，抛春外。\n笑说踏青去好，恐看花、为花凝泪。\n旧燕不来，新莺多语，春情谁系？\n到晚凭阑，西山见我，相看妩媚。\n正疏疏帘底，轻阴不醒，蝶儿清寐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16224,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"水龙吟 清明次计伯英韵","author":"张惠言","text":"陌头试问垂杨，清明多少春人至。\n芳尘十丈，娇云千片，飞来容易。\n胡蝶须边，黄蜂翅底，搓成花味。\n看咋宵寒重，今朝暖透、春一样，游情异。\n剩有无家燕子，过花期、未收愁睇。\n绣户无踪。\n海山何处，也随花戏。\n欲向残红，殷勤说与，留春无计。\n只东风不到，重帘隔断，游丝天际。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16225,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"木兰花慢 杨花","author":"张惠言","text":"尽飘零尽了，何人解，当花看。\n正风避重帘，雨回深幕；云护轻幡。\n寻他一春伴侣，只断红、相识夕阳间。\n未忍无声委地，将低重又飞还。\n疏狂情性算凄凉，耐得到春阑。\n便月地和梅，花天伴雪，合称清寒。\n收将十分春恨，做一天、愁影绕云山。\n看取青青池畔，泪痕点点凝斑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16226,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"水调歌头五首  其二 春日赋示杨生子掞","author":"张惠言","text":"百年复几许，慷慨一何多！\n子当为我击筑，我为子高歌。\n招手海边鸥鸟，看我胸中云梦，蒂芥近如何？\n楚越等闲耳，肝胆有风波。\n生平事，天付与，且婆娑。\n几人尘外相视，一笑醉颜酡。\n看到浮云过了，又恐堂堂岁月，一掷去如梭。\n劝子且秉烛，为驻好春过。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16227,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"水调歌头五首  其五 春日赋示杨生子掞","author":"张惠言","text":"长馋白木柄，斸破一庭塞。\n三枝两枝生绿，位置小窗前。\n要使花颜四面，和着草心千朵，向我十分妍。\n何必兰与菊，生意总欣然。\n晓来风，夜来雨，晚来姻。\n是他酿就春色，又断送流年。\n便欲诛茅江上，只恐空林衰草，憔悴不堪怜。\n歌罢且更酌，与子绕花间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16228,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江城子 填张春溪西湖竹枝词","author":"张惠言","text":"碧云无渡碧天沉，是湖心，是侬心。\n心底湖头，路断到如今。\n郎到断侨须有路，侬住处，柳如金。\n南高峰上望郎登，郎愁深，妾愁深。\n郎若愁时，好向北峰寻。\n相对峰头俱化石，双影在，照清浔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16229,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"张惠言","text":"鹧鸪飞上罗襦绣，银屏春向夗央透。\n香袅鬓花风，玉钗胡蝶红。\n柳丝千种碧，窈窕吴山色。\n山色正如眉，销残春不知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16230,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"花非花","author":"张惠言","text":"花非花，月非月。\n难得开，容易缺。\n眉痕锁梦压花情，心影当春看月出。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16231,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"水龙吟 荷花为子掞赋","author":"张惠言","text":"西洲一夜温香，随风和梦枝头住。\n红衣翠袖，何人知道，横塘日暮。\n一水盈盈，千情脉眠，回头频误。\n向天涯远道，相思万里，便采得，遗谁去？\n直是寻莲等藕，好三春、过却佳期无数。\n多少缠绵，而今看取，苦心如许。\n烟学愁容，雨偷泪色，芳尘何处？\n只月明、一片依然省识，凌波微步。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16232,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"摸鱼儿 过天香楼，忆同崔格卿旧游，感而赋此","author":"张惠言","text":"镇三年、看花一度，人生几回朝暮。\n欢情容易愁中过，偏是愁人记取。\n花深处，是往日、分红瞥翠曾游路。\n旧时鸥鹭。\n若问我凄凉，酒徒一散，寂寞委黄土。\n百年事，休说重来非故，当时感慨何许！\n尊前万柄新妆拥，明日乱红无数。\n天也误，怎不许、清秋一例萎风雨。\n问花无语。\n但倚尽危阑，斜阳漠漠，独自下楼去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16233,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"相见欢四首 其二","author":"张惠言","text":"重帘护了窗纱，玉钩斜。\n燕子威巢长自趁飞花。\n秋千倦，银筝乱，莫看他。\n帘外游丝落絮是天涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16234,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"相见欢四首 其三","author":"张惠言","text":"枝头觅遍残红，更无踪。\n春在斜阳荒草野花中。\n溪边树，堤间路，几时逢？\n昨夜梦魂飞过小桥东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16235,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"相见欢四首 其四","author":"张惠言","text":"新莺啼过清明，有谁听？\n何况朝风夜月杜鹃声。\n留春住，催春去、若为情，拟化一双胡蝶抱花醒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16236,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"丑奴儿慢二首 其一 见榴花作","author":"张惠言","text":"柳绵吹尽，楼外旧愁如梦。\n又镇日门随雨闭，帘借烟笼、却怕凭阑，相思无字问残红。\n新阴绿处，几时轻逗，芳意千重。\n玉勒俊游，从他幽独，不到山中。\n况满地、浮英浪药，还做春容。\n只有斜阳，年年识得换熏风。\n春余心事，凭将杜宇，深诉花工。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16237,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"丑奴儿慢二首 其二 见榴花作","author":"张惠言","text":"绿云初破，浓点几枝红晕。\n是万迭相思簇就，深卷愁痕。\n试问东风，吹来还有旧春魂？\n杜鹃啼罢，征鸿去尽，芳意谁论？\n长记那时，美人初见，一样细裙。\n便消受、朱幡深护，已耐南熏。\n不恨凄凉，为君幽独又伤神。\n黄梅时候，半天风雨，自倚孤村。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16238,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满庭芳 五月五日泛丰溪","author":"张惠言","text":"云暗还开，雨疏才歇，急水新涨潺潺。\n竹篙轻快，随意度平滩。\n树里几家村舍，壶觞暖、笑语阑姗。\n溪声外，斜阳一片，无数是青山。\n乡关回首处，青桡翠羽，玉管红檀。\n怅天涯十载，旧梦都删。\n却道年华似水，将归思、又逐惊湍。\n浑无耐，丰溪千折，不到白云湾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16239,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"木兰花慢 游丝。同舍弟翰风作","author":"张惠言","text":"是春魂一缕，销不尽；又轻飞。\n看曲曲回肠，愁侬未了，又待怜伊。\n东风几回暗剪，尽缠绵、未忍断相思。\n除有沉烟细袅，闲来情绪还知。\n家山何处为春工？\n容易到天涯。\n但牵得春来，何会系住，依旧春归。\n残红更无消息，便从今、休要上花枝。\n待祝梁间燕子，衔他深度帘丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16240,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉楼春","author":"张惠言","text":"一春长放秋千静，风雨和愁都未醒。\n裙边余翠掩重帘，钗上落红伤晚镜。\n朝云卷尽雕阑暝，明月还来照孤凭。\n东风飞过悄无踪，却被杨花送微影。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16241,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"贺新郎","author":"张惠言","text":"柳絮飞无力。\n问东风、天涯吹送，几时才歇？\n一片矫红辞花去，看有千番欹侧。\n知多少、胭脂暗泣。\n只有愁云凝不散，做丝丝、泪点还长绝。\n春到此，亦轻别。\n去年团扇长相亿，料新来、尊前难问，旧时明月。\n沟火东西流到海，便有相逢时节。\n又只恐、蓬莱路隔。\n欲向东君深深诉。\n怕春归、从此煞消息，属燕燕，莫频说。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16242,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"六丑 蔷薇谢后作","author":"张惠言","text":"便风风雨雨，看眼底、韶光都歇。\n道春竟归，春来多少恨，无限凝积。\n长记寻春早，一校红粉，压心头千迭。\n东君不管春狼籍。\n落尽桃腮，雕残杏缬，回头已无踪迹。\n只新丛细药，还剩芳泽。\n花工抛掷、为群芳暗泣。\n试问春何在，难重忆，东风也解珍惜。\n向苍苔扶起，几番欹侧。\n低回久、更休相忆。\n便留得、一朵矫红独自，奈他深碧。\n飘零处、芳意难灭。\n有暗香、绕过春前去，梅花识得。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16243,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"八六子","author":"张惠言","text":"曲栏东，藕花一朵，嫣然开向愁中。\n正泪湿五更寒雨，佣欹一地温风，可怜似侬。\n曾凭幽梦相通。\n夜月梅边旧恨，朝云兰外轻踪。\n但绕遍、天涯有谁寄与，西洲春远，洞庭秋晚；耐他芳意千丝宛转，柔情一点玲珑。\n况匆匆，苹波又摧断红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16244,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南乡子","author":"张惠言","text":"身与自云轻，飞过千山路未平。\n窗里灯光窗外月，微明。\n远梦模糊易得醒。\n已有乱蛩鸣，听到西风又晤惊。\n绕屋青荷三万柄，三更。\n都作芭蕉送雨声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16245,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣纱溪","author":"张惠言","text":"朝看云横暮雨斜，东风一例送年华，旧愁新恨满天涯。\n胡蝶一春随落絮，燕儿终日说飞花，此情何处不堪嗟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16246,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满庭芳 题方湛厓春堤试马图","author":"张惠言","text":"丰乐溪边，潜虬山畔，几年春色留人。\n玉骢初到，长记拨红云。\n便与桃花会约，花开处、来定千巡。\n都相识，一花一态，一日一番春。\n良辰如梦里，又教瞥见，玉辔琼茵。\n想轻随雾，娇逐芳尘。\n只我天涯倦容，故乡杳、往事难论。\n空惆怅，西风不管，一夜老江蒪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16247,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]