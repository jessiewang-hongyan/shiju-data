[{"title":"菩萨蛮","author":"庄棫","text":"宫眉新样黄初吐。\n梦惊粉重西园雨。\n弱薄不胜衣。\n满园莺乱飞。\n楼头花事寂。\n金雁无消息。\n怎得晚春时。\n薄情郎早归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34282,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮","author":"庄棫","text":"画桥绿水沽春酒。\n鸟啼门外霏春柳。\n春色倍关心。\n闲庭芳草深。\n花丛人似月。\n忙煞飞来蝶。\n帘外几番风。\n香闺梦正浓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34283,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"思帝乡","author":"庄棫","text":"朝朝花花相映红。\n钿雀金蝉香阁，绣帷中。\n炉篆纱窗云雾，星眼倦朦胧。\n望到楼头不见，有归鸿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34284,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梦江南","author":"庄棫","text":"芳草岸，岸上玉骢嘶。\n红袖满楼招不见，桥边杨柳细如丝。\n春雨杏花时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34285,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"更漏子","author":"庄棫","text":"玉楼寒，芳草碧。\n门外马嘶人迹。\n搴绣幕，拂银屏。\n风来夜不扃。\n应念我，偏相左。\n鱼钥重门深锁。\n书不寄，梦无凭。\n窗纱一点灯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34286,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春光好","author":"庄棫","text":"烧蜡烛，照银屏。\n袖罗轻。\n暗忆扁舟下绿汀。\n布帆声。\n新月半明半暗，浮云旋散旋生。\n只有些微看不见，两三星。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34287,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"少年游","author":"庄棫","text":"熏炉香烬，画堂烟暝。\n无语掩重门。\n梦未曾醒。\n灯先上了，帘外已黄昏。\n窗儿独自看都黑，那个与温存。\n只有经行。\n玉阑干畔，留得旧啼痕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34288,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"青门引","author":"庄棫","text":"梦里流莺啭。\n唤起春人都倦。\n砑笺莫漫去题红，雨丝风片，帘幕晚阴捲。\n碧云冉冉遥山展。\n去也无人管。\n便寻画箧螺黛，可堪路隔天涯远。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34289,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮","author":"庄棫","text":"晓妆未褪衣衫薄。\n昼长独上三层阁。\n帘卷对青山。\n眉痕新月弯。\n含羞罗袖掩。\n自拂桃枝簟。\n鸾镜绣帏中。\n花花相映红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34290,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"踏莎行","author":"庄棫","text":"斜日楼台，平芜道路。\n玉骢嘶去无寻处。\n断霞一抹远山横，东风忽送行云住。\n美景匆匆，华年负负。\n当筵空把金尊舞。\n尊前馀沥且休挥，明朝帘外迷红雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34291,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"凭栏人  咏水仙花","author":"文廷式","text":"秣驷芝田经几时。\n袖里明珰光未已。\n华灯写，澹姿绰，娇饶知似谁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34292,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天","author":"文廷式","text":"明月多情上绮疏。\n伴侬无寐四更馀。\n朦胧世态休看镜，撩拨清愁且著书。\n萤火暗，雁声孤。\n露光浮白夜凉初。\n桂宫曾寄千千信，为问仙娥忆得无。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34293,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐","author":"文廷式","text":"春人婀娜。\n春恨吟难妥。\n一缕醲香薰意可。\n独倚云屏閒坐。\n林间百种莺啼。\n玉阶撩乱花飞。\n生怕袜罗尘涴，黄昏深下犀帷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34294,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"疏影  为思惠斋主人题蓬莱春影图","author":"文廷式","text":"烟螺想髻。\n更柳疏枫密，芳思无际。\n缥缈空山，可是曾来，瞥见瑶阶仙侍。\n人言海水三清后，有琼瑟、玉杯重遗。\n恰无聊、化作朝云，一霎沧波迢递。\n几度花开花落，对霞影犹忆。\n靓妆明惠。\n石径苔封，化鹤人归，黯淡蕊珠文字。\n浮萍偶值原无定，好认取、天花游戏。\n奈梦回、雨泻高檐，窗外叶声如悴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34295,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪纱 其一","author":"文廷式","text":"缥缈眉痕忆远山。\n一春愁思不曾閒。\n断云只在有无间。\n原是花身应惜惜，犹疑竹泪记斑斑。\n小楼今夜恰轻寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34296,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪纱 其二","author":"文廷式","text":"曲曲阑干淡淡云。\n兰仪蕙质杳难分。\n卸钗声溜隔帘闻。\n酿雪庭阴愁意绪，听香床角倦嚬呻。\n不成幽梦枕微温。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34297,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其一","author":"文廷式","text":"游侠好，结客过邯郸。\n孔雀罗裙擎玉盌，鹅儿锦帕覆雕鞍。\n骑出万人看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34298,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其二","author":"文廷式","text":"游侠好，远出不须粮。\n偶忆蒲萄过大宛，閒寻芝草渡扶桑。\n何处是他乡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34299,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其三","author":"文廷式","text":"游侠好，不愿执金吾。\n宝瑟歌成三妇艳，银鎗舞急万人呼。\n赌酒更摴蒱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34300,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其四","author":"文廷式","text":"游侠好，雄剑动星文。\n易水行时虹贯日，扶馀王后气成云。\n此局未输君。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34301,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其五","author":"文廷式","text":"游侠好，纵猎玉骢骄。\n金弹戏抛林外雀，珠弓曾射水中蛟。\n千里极萧条。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34302,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南歌子  其一 闺情","author":"文廷式","text":"日上红蕖丽，霜前赤枣收。\n莲汝在心头。\n郎情休更冷、未经秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34303,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南歌子  其二 闺情","author":"文廷式","text":"铁鹿沈长锁，金蟾齧碎香。\n荀令好儿郎。\n缄情亲寄与、耳边珰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34304,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南歌子  其三 闺情","author":"文廷式","text":"豆荚长萦荻，桐花未燥枝。\n龙笛月中吹。\n就中阿那意、许侬知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34305,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南歌子  其四 闺情","author":"文廷式","text":"䰀鬌花安髻，玲珑镜织衣。\n春暖蝶双飞。\n才醒还复睡、下罗帷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34306,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玉楼春 其一","author":"文廷式","text":"南来北去经行惯。\n历历关河长在眼。\n仙山无树鹤书稀，沧海生波龙穴浅。\n袖中剩有阴符卷。\n醉里不辞游侠传。\n借如李令拥旌旗，何似顾荣摇羽扇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34307,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玉楼春 其二","author":"文廷式","text":"洞天福地何森爽，芝草琅玕日应长。\n浩歌华月碧山閒，九点齐烟如在掌。\n清狂试演霓衣唱，自扣铜钲神益王。\n一杯举手劝长星，江水滔滔前后浪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34308,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天  其一 即事","author":"文廷式","text":"劫火何曾燎一尘。\n侧身人海又翻新。\n閒凭寸砚磨砻世，醉折繁花点勘春。\n闻柝夜，警鸡晨。\n重重宿雾锁重阍。\n堆盘买得迎年菜，但喜红椒一味辛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34309,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天  其二 即事","author":"文廷式","text":"腊鼓声中醉一杯。\n世情不复强安排。\n错从蚁穴闻牛斗，自纵鹏天任燕猜。\n看傀儡，卖痴呆。\n草头木脚满槐街。\n祥云辉映三千界，曾见崆峒访道来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34310,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇  其一 望月","author":"文廷式","text":"无著秋光，依空谁住山河影。\n灵怀修迥，祇有仙娥靓。\n太乙朝回，玉露晨霄警。\n斋宫请，疏麻折尽，万岁千秋肯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34311,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇  其二 望月","author":"文廷式","text":"紫府清游，饥来偶啖金盘枣。\n灵妃窈窕，回顾罗帏笑。\n一段琴心，万古知音少。\n归来好，玩兹芳草，自写黄花照。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34312,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其一","author":"文廷式","text":"浓睡方醒日已斜。\n翻嫌晴色晃窗纱。\n郎前纰缦故些些。\n少可英雄偏说剑，特矜颜色爱评花。\n世间儿女怎如他。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34313,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其二","author":"文廷式","text":"才启朱樱转自缄。\n柔肠似结解应难。\n感郎情重畏郎憨。\n也解避嫌防后悔，时将薄怒掩深惭。\n此时轻别阿谁甘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34314,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其三","author":"文廷式","text":"小醉归来夜已分。\n新茶泼乳捧殷勤。\n梦回初觉发香熏。\n昵枕低帏千种态，向时矜重霎时亲。\n细看浓翠拂轻颦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34315,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其四","author":"文廷式","text":"雨浥缃桃特地鲜。\n春娇浓发镜台前。\n含羞含恨不能言。\n如此风流天赋与，暂时惜别总潸然。\n郎情认取枕函边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34316,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其五","author":"文廷式","text":"窈窕疏花忆淡妆。\n远山如写画眉长。\n那堪微雨湿衣裳。\n梦好浑忘银汉迥，书来犹带绣檀香。\n相思无底不能量。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34317,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其一","author":"文廷式","text":"兰膏欲烬壶冰裂。\n褰帷瞥见玲珑雪。\n无奈夜深时。\n含娇故起辞。\n徐将环佩整，相并瓶花影。\n敛黛镜光寒。\n钗头玉凤单。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34318,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其二","author":"文廷式","text":"啼莺唤起罗衾梦。\n柳丝无力春愁重。\n晓枕困相思。\n凭春说与伊。\n语深良夜促，灯穗飘红粟。\n回面泪偷弹。\n此情郎忍看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34319,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其三","author":"文廷式","text":"千花百草寻常见。\n绮楼别写芳华怨。\n云影护瑶台。\n碧桃千朵开。\n画屏金凤舞，对对芝光吐。\n凝照倍增妍。\n佯矜未肯前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34320,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其四","author":"文廷式","text":"情深不惜明珰解。\n泪珠还沁鲛绡在。\n云袅翠翘低。\n沈沈蕙思迷。\n画桥秋色浅，落叶重门掩。\n别久倍思量。\n锦衾初夜长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34321,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花","author":"文廷式","text":"若使他生真个有。\n拚却今生，情与秋俱瘦。\n月影笼纱霜拂袖。\n红闺此夜凉初透。\n最是闻歌兼中酒。\n镜里芙蓉，一霎容消受。\n昙誓深深天听否。\n绸缪洛浦神归后。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34322,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花","author":"文廷式","text":"袅袅茶烟心绪乱。\n漠漠轻轻，魂在梨花苑。\n料得海棠春睡倦。\n梦回愁听莺声颤。\n几日浮生偏聚散。\n祇有情深，不似天河浅。\n瑶井辘轳声宛转。\n斑骓那系垂杨岸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34323,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花 其三","author":"文廷式","text":"九十韶光如梦里。\n寸寸关河，寸寸销魂地。\n落日野田黄蝶起。\n古槐丛荻摇深翠。\n惆怅玉箫催别意。\n蕙些兰骚，未是伤心事。\n重叠泪痕缄锦字。\n人生祇有情难死。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34324,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花","author":"文廷式","text":"手捲真珠云影瘦。\n不怕春寒，祇怕春归骤。\n水远山青凝望久。\n几重芳树遮亭堠。\n似锦年光浑异旧。\n为问东君，好与谁相守。\n燕懒莺娇知恨否。\n绿阴阴处初长昼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34325,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花","author":"文廷式","text":"每到河桥临泊处。\n百草凄迷，总碍行人路。\n回棹却寻前日渡。\n汪汪新涨归程阻。\n人世几回伤岁暮。\n春也莺飞，秋也螀啼苦。\n欲赋闲愁愁万绪。\n寒衾卧听萧萧雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34326,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字浣溪沙九首 其七","author":"况周颐","text":"何处楼台罨画中。\n瑶林琼树绚春空。\n但论香国亦仙蓬。\n未必移根成怅惘，至今顾影越妍浓。\n怕无芳意与人同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34327,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字浣溪沙九首 其八","author":"况周颐","text":"且驻寻春油壁车。\n东风薄劣不关花。\n当花莫惜醉流霞。\n总为情深翻怨极，残阳偏近茜云斜。\n啼鹃说与各天涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34328,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字浣溪沙九首 其九","author":"况周颐","text":"剪绿裁红十四词。\n迷花我合署樱痴。\n花能惹泪怕花知。\n安得蹑云飞绮梦，尽教浥露折繁枝。\n三山立马艳阳时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34329,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字浣溪沙 其一","author":"况周颐","text":"风雨高楼悄四围。\n残灯黏壁淡无辉，篆烟犹袅旧屏帏。\n己忍寒欺罗袖薄，断无春逐柳绵归。\n坐深愁极一沾衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34330,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字浣溪沙 其二","author":"况周颐","text":"花与残春作泪垂。\n何论茵溷已辞枝。\n怜花切莫误情痴。\n听雨听风成暂遣，如尘如梦最相思。\n肠断都不似年时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34331,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字浣溪沙 其三","author":"况周颐","text":"荏苒霜华改鬓丝。\n自从青镜见颦眉。\n杜鹃啼彻落花时。\n屏上有山非小别，钗头无凤不常离。\n一泓清泪影娥池。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34332,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字浣溪沙 其四","author":"况周颐","text":"一晌温存爱落晖，伤春心眼与愁宜，画阑凭损缕金衣。\n渐冷香如人意改，重寻梦亦昔游非。\n那能时节更芳菲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34333,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字浣溪沙 其五","author":"况周颐","text":"红到山榴恨事多。\n断无消息奈愁何。\n尊前唱彻懊侬歌。\n猧子局翻悲短劫，鲛人泪织委空波。\n钿盟禁得几蹉跎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34334,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字浣溪沙 其六","author":"况周颐","text":"风雨天涯怨亦恩。\n飘摇犹有未消魂。\n能禁寒彻是情根。\n月作眉颦终有望，香馀心字索重温。\n不辞痴绝伫黄昏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34335,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字浣溪沙 其七","author":"况周颐","text":"惨碧鬟天问不应。\n护花能得几金铃。\n摧残风雨若为情。\n捣麝尘香终淡薄，飞龙骨出亦伶俜。\n总然无梦不如酲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34336,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字浣溪沙 其八","author":"况周颐","text":"锦瑟知人恨已深。\n如何弦柱不侵寻。\n暗思前事拥轻衾。\n灯灺自怜偏炯炯，更长难得是沈沈。\n一簪华发十年心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34337,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"金人捧露盘 芙蓉","author":"况周颐","text":"恁娉婷。\n真不染，世间尘。\n似静女，晓镜妆新。\n当楼映幕，未烦初日助风神。\n据霜高格，与东篱、傲骨同论。\n梦江头，搴木末，谁手把，寄夫君。\n旧情在、麝度微薰。\n集裳欲问，水花莫误注骚人。\n后开随分，向西风、展尽红颦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34338,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字浣溪沙 其一 听歌有感","author":"况周颐","text":"解道伤心片玉词。\n此歌能有几人知。\n歌尘如雾一颦眉。\n碧海青天奔月后，良辰美景葬花时。\n误人毕竟是芳姿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34339,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字浣溪沙 其二 听歌有感","author":"况周颐","text":"惜起残红泪满衣。\n它生莫作有情痴。\n人天无地著相思。\n花若再开非故树，云能暂驻亦哀丝。\n不成消遣只成悲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34340,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字浣溪沙 其三 听歌有感","author":"况周颐","text":"蜂蝶无情刬地飞。\n杨花薄幸不成悲。\n落红心事底矜持。\n便似青山薶玉骨，愿为香雾护琼枝。\n枨枨歌管夜何其。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34341,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字浣溪沙 其四 听歌有感","author":"况周颐","text":"侬亦三生杜牧之。\n多情何事误芳期。\n最伤春处送秋时。\n少日骢嘶芳草路，东风莺啭上林枝。\n而今真个隔天涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34342,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字浣溪沙 其五 听歌有感","author":"况周颐","text":"带月沾霜信马归。\n晓来添得鬓边丝。\n绮窗重按玉梅词。\n紫陌铜驼劳怅望，黄河羌笛费悽其。\n闻愁万一阿侬知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34343,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"莺啼序 题王定甫师媭砧课诵图","author":"况周颐","text":"音尘画中未远，莽沧桑换几。\n剩依黯、昔日春明，秭归啼处离思。\n记分占、桐阴片石，书灯惨澹砧霜碎。\n便兰骚能貌，婵媛未抵情至。\n垂老侯芭，载酒记省，怅华年逝水。\n为读画、枨触乡愁，梗萍行念身世。\n数承平、鸾笺象笔，擅荃艳、谁争臣里。\n向天涯、昨梦重寻，旧家诗事。\n惊秋断杵，映雪寒窗，坐我更悽悱。\n差胜是、廿年亲舍，戏綵膝绕，蒜发荷衣，那禁清泪。\n故山雁断，新亭麦秀，唯应月姊知人怨，破书堆、万一薶幽地。\n披图涕雪，松楸望极南云，涨天可奈尘起。\n趋庭丱角，雅学初程，授诵亦谢姊。\n重怆念、吟边雪絮，梦里昙花，此恨生离，未应得似。\n羁孤易感，情亲难再，人生能几年少日，况山河、风景而今异。\n填胸事往休论，四十年前，绛纱弟子。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34344,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"水调歌头 壬戌六月十一日集海日楼为寐叟金婚贺","author":"况周颐","text":"嘉耦岁寒侣，琴瑟亦冰弦。\n黄金白首相况，金欲逊其坚。\n偕老百年常事，公是刘樊仙眷，何止百而千。\n百者数之始，中半最华年。\n双烛照，楼百尺，敞琼筵。\n腾天跃海，看取晨旭总成圆。\n指顾光华复旦，仙仗御香深处，比翼更朝天。\n醉写催妆句，眉笔老逾妍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34345,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南","author":"况周颐","text":"閒庭院，花落更斜阳。\n肯与游丝为缱绻，莫将飞絮共平章。\n漂泊不能狂。\n东风恶，无计挽红芳。\n输与邻家蜂蜜好，不知何处燕巢香。\n回尽旧时肠。\n花如画，未必画非真。\n见说画中花不落，移家作个画中人。\n占取最长春。\n春未肯，著我软红尘。\n花若有情花亦瘦，十年香梦太酸辛。\n我与我温存。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":34346,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]