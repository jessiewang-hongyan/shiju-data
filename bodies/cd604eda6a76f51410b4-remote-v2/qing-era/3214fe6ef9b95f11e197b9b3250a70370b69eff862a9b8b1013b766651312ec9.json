[{"title":"有访","author":"储雄文","text":"未遇幽人又独还，贪看落日立溪湾。\n隔溪几处炊烟动，遮断寒林数叠山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10623,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"访朝阳道院","author":"储雄文","text":"竹径阴阴磬韵流，行来便觉此生浮。\n道人所得惟贪懒，满地松花散不收。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10624,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晓意示怀园读书诸子兼呈家在陆先生 其一","author":"储雄文","text":"晨兴心骨清，涉趣不暇理。\n橹声划晴窗，孤阁悬秋水。\n湿翠招欲来，落影在书几。\n故人忆园居，幽赏或同此。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10625,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晓意示怀园读书诸子兼呈家在陆先生 其二","author":"储雄文","text":"散帙初日上，钩帘受荷风。\n心香相吐纳，舌本青莲通。\n能宣圆妙谛，沧海回鱼龙。\n鼓荡薄清景，秋阴结遥峰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10626,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"冬日宿青门草堂","author":"储雄文","text":"岁暮怀人意慷慨，为携吟卷驾轻航。\n缭垣积草余残雪，古木空巢自夕阳。\n藉地牛群争烧影，翻空鸦阵点湖光。\n从知眼底茫茫甚，独自扶藜立草堂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10627,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夏日侍家在陆编所自著诗古文目录讫赋呈","author":"储雄文","text":"一亩城隅寄陆沈，雨余山色落庭心。\n虫争晓日鸣幽壁，鸟爱风潭坐绿阴。\n绕树编篱看引蔓，临阶设榻封披襟。\n百年著述留盈寸，谁识先生用意深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10628,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏雪亭绝句和皆人","author":"储雄文","text":"木落见茅茨，爨烟寒未起。\n人语一溪冰，荷担立沙嘴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10629,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江上同礼执晤方子灵皋因感百川作","author":"储雄文","text":"才难古所叹，摧折权谁司。\n龙眠五君子，盛事钟灵奇。\n才名三十年，讵论成与隳。\n淡涩爱百川，季也情殆移。\n忽闻百川逝，临风增怅而。\n今日始晤君，举体何清羸。\n发言若春茗，甘苦心自知。\n哲兄竟已矣，诸子空盱睢。\n赠君加餐饭，岁暮以为期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10630,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春田即事","author":"邓廷哲","text":"春郊芳草绿，土膏初动时。\n田家依稼穑，中夜理镃基。\n驱犊迎晨出，花村东未晞。\n春鸠鸣晓树，落月摇桑枝。\n锄声惊虫蛰，笠纠飘东菑。\n新塍映白水，漠漠光参差。\n良苗怀秀色，和风陌上披。\n妇姑馈饟黍，依依来致词。\n风露欺枵腹，四体毋乃疲。\n富贵劳益甚，农夫食力微。\n天壤无逸物，日月如梭驰。\n暮归鸡栖埘，烟火出茅茨。\n林下较晴雨，抱膝课孙儿。\n先畴当世守，勤劬焉敢辞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10631,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"村居","author":"邓廷哲","text":"懒散成何事，萧萧江上村。\n学惟从我好，贫不向人言。\n山静风归竹，帘疏月到门。\n有怀难假寐，竟夕向青樽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10632,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"庐山道中","author":"邓廷哲","text":"雨霁林逾翠，岚开万壑分。\n马嘶山涧月，人踏虎溪云。\n竹屋黏崖结，僧田带石耘。\n独怜栖隐地，行役却纷纷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10633,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"甲午秋月病中作","author":"邓廷哲","text":"猿鹤遥相诮，田园胡不归。\n春风原浩荡，小草自相违。\n壮志那能老，青山讵可非。\n沈吟听玉漏，孤枕一镫微。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10634,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"广州谒大忠祠","author":"邓廷哲","text":"忠臣遗庙肃江皋，欲剪溪花荐浊醪。\n夜半鹃啼柴市血，秋深风撼海门涛。\n卧楼气作山河壮，战舸魂擎日月高。\n天不怜孤那可问，佗城怅望倍萧骚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10635,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"越台怀古","author":"邓廷哲","text":"台荒霸业几经年，曾拄炎州半壁天。\n黄屋不归秦日月，白云犹荡汉山川。\n星涵海面浮珠影，雨驾潮头卷穗烟。\n莫问旧时歌舞处，美人惆怅隔花田。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10636,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梅岭谒张文献祠","author":"邓廷哲","text":"古祠高倚白云巅，太息遗忠霄汉悬。\n独辟雄关梯海国，孤擎相业起南天。\n谠言谁识几先哲，风度徒教身后传。\n向使渔阳兵未召，何劳李郭靖烽烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10637,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自君之出矣 其一","author":"姜顺龙","text":"自君之出矣，不复理朱颜。\n朱颜为谁好，对镜空自怜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10638,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自君之出矣 其二","author":"姜顺龙","text":"自君之出矣，不看高楼月。\n月缺有圆时，人生长离别。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10639,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自君之出矣 其三","author":"姜顺龙","text":"自君之出矣，寂寞酴醾架。\n妾自看花开，妾复看花谢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10640,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日蓟门道上口占","author":"高斌","text":"秋山行近蓟门东，烟树苍茫叶渐红。\n爱煞云岩如画里，却忘我在画图中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10641,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"子夜","author":"高斌","text":"深山镫影伴，坐久夜初分。\n窗挂藤萝月，檐栖桧岭云。\n钟声林外度，天籁静中闻。\n此际层楼上，炉香细细焚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10642,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南郡多热冬月桃花盛开咏此以志物候之不齐云","author":"杨廷璋","text":"十月桃花斗岭梅，夭红点点为谁开。\n瘴天漏泄春光早，荒服炎蒸造化回。\n酒晕玉腮香淡荡，月明珠箔影徘徊。\n刘郎几度迷仙径，却向三冬自剪裁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10643,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和新柳元韵","author":"杨廷璋","text":"条风轻荡漾，弱柳不胜春。\n会见成阴日，能忘种柳人。\n晓莺眠未稳，浅黛雨初匀。\n且喜垂新绿，盈盈不染尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10644,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画","author":"李世倬","text":"乱山深处黄茅屋，活水湾头白板桥。\n但得人来常问字，剧胜蓑笠溷渔樵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10645,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"东阿道中","author":"陈履平","text":"荦确东阿道，疲驴策不前。\n乱峰围落日，野水浸遥天。\n林闪孤村火，云深古寺烟。\n遥闻钟梵动，欲借上方眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10646,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"东皋","author":"谢重辉","text":"投种须及时，大率谷雨前。\n良农知时节，夙驾来中田。\n仓庚鸣向我，翔集立南阡。\n似谓耕耨苦，劝我暂息肩。\n浮云从北来，细雨润前川。\n富足虽未期，饱食庶终年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10647,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"桑","author":"谢重辉","text":"我昔闻诸葛，园林遍种桑。\n吾宅才五亩，墙下亦成行。\n不爱椹子垂，爱此远枝扬。\n浓阴日夕佳，常在吾庐旁。\n五岳老难游，对此可徜徉。\n鸣鸠忽高飞，三嗅入斜阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10648,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"萱草","author":"谢重辉","text":"老去恒内省，不惧兼不忧。\n闲种萱草花，时得览芳柔。\n晓看迎露放，暮看逐风收。\n才兹旦暮间，已如四运周。\n孰云忘忧草，遇目转添愁。\n不如忘形骸，任彼岁月流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10649,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"郭中丞枉驾北园","author":"谢重辉","text":"中丞小驷造岩荆，问柳穿塍到草亭。\n荒径经时园鸟看，胡床谈旧野人听。\n苍生原未忘安石，白帽无烦羡管宁。\n地僻郊遐人迹少，何期忽睹少微星。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10650,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岁暮绝句 其一","author":"谢重辉","text":"小槽新压胜流霞，斟酌鸡钟酒浪斜。\n漫笑醉余无个事，胆瓶亲插水仙花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10651,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岁暮绝句 其二","author":"谢重辉","text":"映阶残雪尚辉光，一笑柴门掩夕阳。\n屋角梅花争破腊，夜阑消受下风香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10652,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岁暮绝句 其三","author":"谢重辉","text":"摊书卓午纸窗明，遣兴新诗又早成。\n卖却巾车赢岁事，深居不用叹徒行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10653,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岁暮绝句 其四","author":"谢重辉","text":"四壁残镫一乐窝，萧然独坐鬓成皤。\n较量故旧无多在，休怪门前有雀罗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10654,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"适野","author":"谢重辉","text":"适野听鸣禽，轻装冒朝旭。\n怡然接春晖，遂纵千里目。\n迢迢东皋田，葱葱北林木。\n黄鸟忽中出，交交相追逐。\n侧耳慰好音，轻风吹初服。\n回顾田舍人，农书老犹读。\n无怪沮溺辈，经年事耕牧。\n我欲叩其端，白云掩茅屋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10655,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"中庭","author":"谢重辉","text":"绿阴不须期，日出临户牖。\n空翠侵衣襟，坐来遍左右。\n夏屋匪我存，而况贵与富。\n但收十斛麦，易酒招亲旧。\n礼失求诸野，无宁理笾豆。\n相逢争席罢，便谭桑麻茂。\n依依情既真，留连惟卜昼。\n可怜世上人，斯乐谁能究。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10656,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春来","author":"谢重辉","text":"春来何所事，依然耽琴书。\n亲昵稀来往，人事欣无馀。\n我身既暇懒，我性日益疏。\n时从池上酌，往往临清渠。\n春山到眼前，好风遍庭除。\n碧柳渐覆井，苍松郁不舒。\n时鸟解人怜，相向各自如。\n因之坐松下，日暮倾一壶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10657,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"王子干过访","author":"谢重辉","text":"汝貌惊如此，吾衰复若何。\n梳头怜白发，裹足避青莎。\n故友贻书少，新知下石多。\n幽栖正愁绝，喜见子犹过。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10658,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过大木宅有感","author":"谢重辉","text":"风掩蓬门旧宅荒，就中何处最凄凉？\n停车不见吟红药，驻马惟看种白杨。\n栋宇凋残嗟向秀，图书零落感文昌。\n可怜满箧雕龙赋，未得生前动汉皇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10659,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夏日偶至山姜村因过渔唱轩寻造蒙斋侍郎墓次感旧述事 其一","author":"谢重辉","text":"柳老莺残打麦时，望中院落起人思。\n萧闲山馆沈蛛网，曲折回廊上兔丝。\n抚景不堪长恋恋，感知聊为去迟迟。\n回头胜迹今成梦，吻喝何因共一卮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10660,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夏日偶至山姜村因过渔唱轩寻造蒙斋侍郎墓次感旧述事 其二","author":"谢重辉","text":"丈四高坟宿草深，初栽松柏已成阴。\n丰碑颇悉生前事，誓墓微徵死后心。\n雄辨思来犹约略，风仪无计可追寻。\n三年留得生刍在，腹痛谁知忍到今。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10661,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"初冬","author":"于熙学","text":"老屋三间向水开，野禾收尽又冬来。\n溪云酿雪浓兼雨，园树当风殷似雷。\n落雁声中沽酒去，寒山影里抱琴回。\n何人寂寞能相识，大半心情付早梅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10662,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"客中九日登高","author":"梁锡珩","text":"未倦登临兴，其如客感生。\n候逢黄菊节，人在白登城。\n野旷寒山色，楼高急树声。\n谁知云里雁，先我竟南行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10663,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送顾秀野南归和留别韵","author":"梁锡珩","text":"淮南丛桂长新枝，趁可归与意在斯。\n去雁影低秋水外，暮蝉声曳夕阳迟。\n风流一散难为别，物色征行总入诗。\n京洛词人零落尽，骚坛管领更依谁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10664,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"昌江夜泛过玉笋峰","author":"唐英","text":"浮梁西去昌江隈，两拳岌立江天开。\n造物直自鸿濛辟，神工鬼斧惊奇材。\n削出芙蓉双蓓蕾，棱收皱隐凝崔嵬。\n女娲失手落江浒，嶙嶒激取蛟龙怒。\n几番欲攫夜光珠，矶磹霹雳随风雨。\n青山碧树同春秋，朗月明星照今古。\n今古春秋亿万年，峣峣玉柱撑空天。\n三百六十滩水恶，狂澜到此流涓涓。\n玉山不颓清流在，米家长揖徒成颠。\n莫将嵩岱藐拳石，海田纵变无移迁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10665,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"起蛟行","author":"唐英","text":"起蛟起蛟天茫然，好生好杀敢问天。\n一蛟方生万户死，江左江右常若此。\n蛟也幸矣民堪怜，江村溪堡填深渊。\n蛟生于天何功德，民死于蛟何冤愆。\n将欲殄恶彰天讨，洪涛谁见分愚贤。\n更谓民孽应浩劫，狂蛟司命天无权。\n天不见苍头黔首蚩蚩子，骨肉漂流一时死。\n攀流触浪命悬丝，呼救号天天不理。\n纵使万死漏一生，庐舍田园空逝水。\n今宵新鬼昨宵人，昨日富室今孤贫。\n一草一木天生意，忍驱赤子饱鬐鳞。\n安得周处斩蛟剑，遍搜溪谷穷涯津。\n尽斩蛟头扫种孽，狂澜永尽无沈沦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10666,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"立夏后二日雨中答侯敷文见柬","author":"陈宗石","text":"毵毵柳絮春刚去，细雨如丝绿欲流。\n喜得故人新酿熟，挑镫相对竹窗幽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10667,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"古相思辞","author":"张霔","text":"郎是天上云，随风东西南北游。\n妾是杯中水，泻地东西南北流。\n云游去作何方雨，水流但湿庭下土。\n土生相思草，恨郎归不早。\n雨湿合欢花，忘妾独在家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10668,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晤赠姜西溟","author":"张霔","text":"直道存先辈，真堪作史才。\n北门艰一晤，东海喜重来。\n心事春云散，声华晚菊开。\n高歌人莫测，呼我上繁台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10669,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"泛溪","author":"张霔","text":"日落村边路，风凉溪上舟。\n居人多草食，钓叟几羊裘。\n一叶平生志，空江五月秋。\n客星今寂寞，烟永共谁游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10670,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日杂诗","author":"张霔","text":"岁岁东海上，残春始见春。\n间吟梦草句，老作看花人。\n风雨三沽水，轮蹄十丈尘。\n槎飞仙岛近，不问五陵津。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10671,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"抱瓮园偕龙东溟李霖臣孙君选王野鹤作残春诗值马大龛自都至","author":"张霔","text":"几坐津头春水船，滔滔流水暮春天。\n偶逢京国飘蓬客，话到山人种杏田。\n积雨半庭双海鹤，浮云千里一风鸢。\n神仙富贵都休问，且醉桃花酒瓮边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10672,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"关山偶感","author":"柏格","text":"西风吹夕阴，万里郁沈沈。\n古戍荒城废，空山乱石深。\n地寒多见雪，树老不成林。\n何为幽并子，长怀出塞心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10673,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登岱","author":"诺岷","text":"高以天为限，名标日观雄。\n尊崇首五岳，典秩目三公。\n刹影云端见，钟声海上通。\n何当凌绝顶，怀抱一为空。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10674,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晓起","author":"朱纲","text":"晓风发曙光，清冷遍郊野。\n起来有宿酲，昨饮尽三雅。\n旧被推床头，群雀乱檐下。\n扫地苔满砌，轴帘松覆瓦。\n回视插架书，取次手中把。\n竹阑滴沥声，尚有露珠泻。\n扰扰市嚣起，渐闻走车马。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10675,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"城西行","author":"萨哈岱","text":"朝出城西门，暮返城西路。\n风送路旁尘，春老门前树。\n行客日纷纷，来往无间步。\n何如抱瓮人，安居守寒素。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10676,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"摇动石","author":"萨哈岱","text":"蚍蜉思撼树，螳螂奋当辙。\n物情固不量，物理亦难决。\n峨峨古田盘，怪石森罗列。\n小者状磊然，大者势巉绝。\n中峙苍玉根，攫空岚翠裂。\n鬼凿旁无痕，神工下有禊。\n纵使力拔山，一手谁能抉。\n我来试抚摇，动荡乃不辍。\n未著祖龙鞭，似听生公说。\n对之耸奇观，令人欲挢舌。\n幻象费揣摩，灵踪觑亲切。\n返步下山椒，夕阳半明灭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10677,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"有女","author":"萨哈岱","text":"东邻有女似花枝，十五盈盈学画眉。\n一朝嫁作贵人妇，未许寻常侧目窥。\n西家女比花枝好，二十无媒成潦倒。\n时时对镜起长叹，只恐朱颜容易老。\n吁嗟乎！\n春发桃枝秋桂枝，迟早由来各有时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10678,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"述怀","author":"萨哈岱","text":"同侪俱不贱，株守独如何。\n夜月闻鸡舞，秋风拔剑歌。\n才原怜我拙，事已让人多。\n惭愧王章妇，相依十载过。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10679,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过友人村居","author":"萨哈岱","text":"故人久不见，相访过前村。\n流水溪边路，藏云树下门。\n桑麻新雨润，鸡黍古风存。\n拟卜诛茅地，从君共避喧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10680,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄怀汉三三兄","author":"萨哈岱","text":"大被三年隔，长征万里赊。\n葡萄愁处酒，芍药别时花。\n上国遥云树，高城急鼓笳。\n阿兄休内顾，好继李轻车。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10681,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岁暮感怀","author":"萨哈岱","text":"天意寒将雪，争林雀乱啼。\n孤怀伤岁暮，小立倚楼西。\n竹叶违良友，梅花忆故妻。\n所思都不见，愁与冻云齐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10682,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西山道上","author":"萨哈岱","text":"载得诗囊与酒筹，为乘高兴一探秋。\n苇残断岸寒惊雁，禾熟荒田晓放牛。\n野菊黄铺桥畔路，山枫红抱寺边楼。\n龙潭旧是登临处，不负西风续胜游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10683,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"沧墅晚眺","author":"施世骠","text":"薄暮登楼眺，山前落日斜。\n晴云低海角，孤屿迥天涯。\n隐隐灵鼍鼓，迢迢逐浪槎。\n牧人歌犊背，凄切入秋笳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10684,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"同友人吴南岐登道州城楼有怀","author":"述明","text":"高阁崚嶒倚素秋，兴来携客一遨游。\n仙桥未断人遥指，冰石无寒迹尚留。\n岭树平凌青汉迥，岩峰远并白云浮。\n元公风韵遗濂水，沁入潇江派自流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10685,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日武冈南楼怀古","author":"述明","text":"南楼高敞碧霄悬，极目平沙没远天。\n济水潺湲空日日，野禾离秀自年年。\n仙家丹灶荒山里，胜国遗踪夕照前。\n千古低徊伤往事，杜鹃啼破早秋烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":10686,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]