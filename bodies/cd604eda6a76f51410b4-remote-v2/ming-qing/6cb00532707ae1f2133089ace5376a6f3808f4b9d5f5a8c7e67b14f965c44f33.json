[{"title":"七夕词 其二","author":"屈大均","text":"渐及斜阳渡恐迟，河边似见凤軿移。\n未教乌鹊迎仙佩，先遣蜘蛛送巧丝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14456,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"七夕词 其三","author":"屈大均","text":"细犊朝朝耕紫烟，宫中未有馆甥年。\n应知帝亦怜儿女，不遣天孙去馌田。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14457,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"七夕词 其四","author":"屈大均","text":"何妨天妹耦耕来，隔水如闻机杼哀。\n饮尽银河应有日，牵牛不用月明回。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14458,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"七夕词 其五","author":"屈大均","text":"莫道人间有恨人，双星天上更酸辛。\n若教精卫填河汉，清浅而今已作尘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14459,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"七夕词 其六","author":"屈大均","text":"相思相望老年华，一宿欢娱未有家。\n织女何殊双顾兔，牵牛亦是一匏瓜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14460,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"七夕词 其七","author":"屈大均","text":"人间不复见神娥，岁岁佳期一度多。\n最是黄姑生命好，不须身自渡银河。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14461,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"七夕词 其八","author":"屈大均","text":"相逢早巳慰参商，此夕何劳玉漏长。\n绝胜月中垂两足，蟾蜍相与作鸳鸯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14462,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题高生画","author":"屈大均","text":"故人胸次满霞烟，画出云林与石田。\n爱杀桥西扶杖者，无人相与踏秋天。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14463,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"戏示墨西 其一","author":"屈大均","text":"方程古墨欲收齐，磨尽松烟苦墨西。\n有子殷勤将代汝，研池先与洗澄泥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14464,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"戏示墨西 其二","author":"屈大均","text":"下笔休教风雨催，方圆尽把顶烟开。\n子安饮墨馀三斗，留与卿儿作赋来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14465,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"戏示墨西 其三","author":"屈大均","text":"卿如子墨客卿来，胶漆相依更不开。\n汤沐欲封君即墨，五年功在读书台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14466,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"为陆氏姬人寄姊 其一","author":"屈大均","text":"大姨家住木棉头，小姨相望荔支洲。\n荔枝有子酸且小，木棉花大如重楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14467,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"为陆氏姬人寄姊 其二","author":"屈大均","text":"荔支红让木棉红，荔支可食愁盘空。\n木棉有絮作緤布，天寒长禦搅霜风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14468,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"为陆氏姬人寄姊 其三","author":"屈大均","text":"夫婿多才赋荔支，木棉不赋使侬悲。\n侬今欲代木棉乞，乞作双红绝妙辞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14469,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"为陆氏姬人寄姊 其四","author":"屈大均","text":"木棉有花须作实，荔枝有实更成花。\n实红不似花红好，努力春深斗丽华。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14470,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"口占送姬人之母 其一","author":"屈大均","text":"而女归吾喜有孙，佳人秀实慰慈萱。\n阿婆不肯留相抱，黄口娇啼讵忍言。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14471,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"口占送姬人之母 其二","author":"屈大均","text":"公姥能来就女无，无儿休叹白头孤。\n殷勤得使甥孙大，与妇双双作孝乌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14472,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"新月 其一","author":"屈大均","text":"娟娟绝爱似蛾眉，不道光开玉镜迟。\n蛾眉宛转有数夕，玉镜团圆是阙时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14473,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"新月 其二","author":"屈大均","text":"皓魄初生色已妍，纤纤且勿两头圆。\n齐纨任尔如霜雪，团扇裁成即弃捐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14474,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"生日客韶阳作 其一","author":"屈大均","text":"行年六十又三时，揽镜英州见秀眉。\n加我天教韶石似，一峰一岁即期颐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14475,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"生日客韶阳作 其二","author":"屈大均","text":"一年一朵玉芙蓉，七十依然六十同。\n更待九年持赠我，一峰分作两三峰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14476,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"生日客韶阳作 其三","author":"屈大均","text":"高堂百岁仗孙嵩，我要奇龄与母同。\n早学长生因奉养，白头膝下待还童。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14477,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"生日客韶阳作 其四","author":"屈大均","text":"老凤生雏雏白头，文章五色作兰羞。\n今朝出觅琅玕食，也抱啼乌反哺愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14478,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"生日客韶阳作 其五","author":"屈大均","text":"生近重阳令节时，菊花香送玉杯迟。\n先予一日怜桃叶，共命雌雄总画眉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14479,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"生日客韶阳作 其六","author":"屈大均","text":"五日何妨九日同，天将令节属陶公。\n重阳且喜馀三日，莫采黄花尽一丛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14480,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"生日客韶阳作 其七","author":"屈大均","text":"据鞍愁向武溪过，六十成翁笑伏波。\n矍铄吾今加一岁，未逢衣绛恨如何。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14481,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"韶阳吊古 其一","author":"屈大均","text":"战血依稀带雨新，黄昏白上尽青燐。\n将军间道无奇策，一败韶阳误汉人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14482,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"韶阳吊古 其二","author":"屈大均","text":"泷西兵已过泷东，苦是阴城不易攻。\n兵法自来牵制好，偏师不解断南雄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14483,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"韶阳吊古 其三","author":"屈大均","text":"啾啾鬼哭汉将军，安国头悬塞上云。\n更有终童能死节，魂留南越甚芳芬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14484,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题小长芦图","author":"屈大均","text":"长水牵人宝带长，还馀锦带系鸳鸯。\n月波酒好兼黄雀，父子为渔乐镜香。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14485,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送朱竹姹 其一","author":"屈大均","text":"情同杨柳但依依，乍见那堪即送归。\n白首相知谁得似，梦魂从此更交飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14486,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送朱竹姹 其二","author":"屈大均","text":"重来此地莫相违，各已浮生近古希。\n二十五年还待汝，白头未肯嫁斜晖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14487,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"口占为增城万寿寺老僧寿","author":"屈大均","text":"春冈冈下古花宫，兰草房房种几丛。\n老衲亦餐云母否，何妨七十貌如童。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14488,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"酒熟 其一","author":"屈大均","text":"酒娘新出味如饴，儿女餔糟父啜醨。\n恨绝秋收红糯少，白衣无复到东篱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14489,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"酒熟 其二","author":"屈大均","text":"空如玉乳甘难饫，不似香醪冽易醺。\n却爱烧春能爽口，一杯已觉暖氤氲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14490,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"椰浆","author":"屈大均","text":"黄椰浆浊白椰清，味似漂醪饮亦酲。\n解渴炎天惟此物，殷勤劝客玉杯倾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14491,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"潇湘曲有寄","author":"屈大均","text":"潇蓝湘碧总含清，两不分流最有情。\n任是潇南湘亦北，潆洄终向楚王城。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14492,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送人入京 其一","author":"屈大均","text":"桑乾亦是小黄河，桥向芦沟踏雪过。\n马上锦裘青海客，呜呜吹叶和悲歌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14493,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送人入京 其二","author":"屈大均","text":"白山冰雪黑山云，水落辽河向塞分。\n更出渝关随射猎，海青看打鴐鹅群。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14494,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"白莲池","author":"屈大均","text":"池水含风满洞凉，麻姑旧种白莲香。\n笑他未有明星手，不得花开十丈长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14495,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"苦雨作 其一","author":"屈大均","text":"百道飞泉作檐溜，绝疑三峡倒龙湫。\n哀猿为尔空肠断，泪逐潺湲日夜流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14496,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"苦雨作 其二","author":"屈大均","text":"一春阴雨春无昼，晴暖何因见艳阳。\n亦有莺花在烟雾，风吹不作白头香。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14497,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"苦雨作 其三","author":"屈大均","text":"那知是雨是啼痕，沾洒衣衾冷断魂。\n泉下有亲寒正苦，岂知绵緤定奇温。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14498,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"以事偶憩单家口占奉答 其一","author":"屈大均","text":"五宿黄公酒瓮旁，氤氲曲蘖不胜香。\n主人相劝怜衰疾，姜桂含滋未忍尝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14499,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"以事偶憩单家口占奉答 其二","author":"屈大均","text":"毁瘠哀予六十人，醇醪信美不沾唇。\n来因儿女非无故，慈孝多惭此一身。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14500,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"屡得友朋书札感赋 其一","author":"屈大均","text":"一谢交游故国回，寒喧不断素书来。\n杜陵虽有虚名好，沟壑何曾一救来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14501,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"屡得友朋书札感赋 其二","author":"屈大均","text":"好是新安与武林，扶晨心似仲昭心。\n平生知己虽无数，二子聪明最赏音。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14502,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"屡得友朋书札感赋 其三","author":"屈大均","text":"最早知音是阮亭，青莲不得擅仙灵。\n九天咳唾纷珠玉，乱作飞泉下杳冥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14503,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"屡得友朋书札感赋 其四","author":"屈大均","text":"名因锡鬯起词场，未出梅关人已香。\n遂使三闾长有后，美人香草满禺阳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14504,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"屡得友朋书札感赋 其五","author":"屈大均","text":"慈溪魏子是钟期，大雅遗音独尔知。\n一自弹琴东市后，风流儒雅失吾师。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14505,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"屡得友朋书札感赋 其六","author":"屈大均","text":"西泠十字首驰黄，道我诗篇胜梦阳。\n古调新声俱第一，肩随不敢逐飞扬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14506,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"屡得友朋书札感赋 其七","author":"屈大均","text":"筜谷同心复同调，平湖皋旭亦渊通。\n三吴竞学翁山派，领袖风流得两公。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14507,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"屡得友朋书札感赋 其八","author":"屈大均","text":"欲折弯弯射日弓，有人争欲作逢蒙。\n交游不向端人取，乘矢何繇得庾公。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14508,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"屡得友朋书札感赋 其九","author":"屈大均","text":"才名四十有馀年，老益饥寒万卷前。\n绝代文章多妒忌，自来人欲杀青莲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14509,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"屡得友朋书札感赋 其十","author":"屈大均","text":"老岂争名向少年，未焚笔研已归田。\n能知白也诗无敌，除是开元一代贤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14510,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长儿明洪十八岁生日口占示之 其一","author":"屈大均","text":"二月三朝春未中，文昌生日汝相同。\n年今二九非初学，及早成章慰乃翁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14511,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长儿明洪十八岁生日口占示之 其二","author":"屈大均","text":"志学已多三岁矣，成童又过二年来。\n文章莫与而翁似，一代聪明要自开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14512,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长儿明洪十八岁生日口占示之 其三","author":"屈大均","text":"翁山山上八泉流，第一甘泉居上头。\n汝字甘泉冠诸弟，要从文简溯尼丘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14513,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长儿明洪十八岁生日口占示之 其四","author":"屈大均","text":"母难兹辰泪满衣，九龄失恃怆慈威。\n劬劳总赖诗书报，仁孝休令奉养违。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14514,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题朱君望云图","author":"屈大均","text":"春鸟催归处处闻，乡心画出翠氤氲。\n江南山色无多少，总向邗沟作白云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14515,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题刘君芦洲濯足图","author":"屈大均","text":"岂意菰芦尚有人，微茫烟水未迷津。\n白头渔父偏知汝，一棹相将出白蘋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14516,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"新柳","author":"屈大均","text":"鹅黄浅淡雪初消，拂水拖烟已万条。\n小得春风都解舞，憎他绝似阿蛮腰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14517,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送声远往杭州 其一","author":"屈大均","text":"此去江湖路渺茫，千金岂必不垂堂。\n渊冰自守诗人戒，况复庭闱在异乡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14518,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送声远往杭州 其二","author":"屈大均","text":"清浅秋光欲满轮，休贪明月向江滨。\n月明不似琼闺镜，中有蛾眉十道新。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14519,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送声远往杭州 其三","author":"屈大均","text":"西子湖西返照明，南高峰雨北高晴。\n莼丝采共鲈鱼腊，归作高堂锦带羹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14520,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送声远往杭州 其四","author":"屈大均","text":"舟向孤山柳外堤，知从处士问幽栖。\n故人亦是林和靖，家有梅花作女妻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14521,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送声远往杭州 其五","author":"屈大均","text":"雨雪归来匹马劳，翩翩不是五陵豪。\n锦囊双压明驼重，诗句多于金错刀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14522,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西蜀费锡璜数枉书来自称私淑弟子赋以答之 其一","author":"屈大均","text":"诗歌岂敢作人师，私淑如君乃不疑。\n风雅只今谁丽则，不才多祖楚骚辞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14523,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西蜀费锡璜数枉书来自称私淑弟子赋以答之 其二","author":"屈大均","text":"古诗源向汉京寻，十九情同三百深。\n唱叹泠然清庙瑟，朱弦疏越有遗音。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14524,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西蜀费锡璜数枉书来自称私淑弟子赋以答之 其三","author":"屈大均","text":"少陵家学本昭明，文选教儿最老成。\n君向八朝中取法，休裁伪体逐时名。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14525,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西蜀费锡璜数枉书来自称私淑弟子赋以答之 其四","author":"屈大均","text":"开元大历十馀公，总在高才变化中。\n谁复光芒真万丈，谪仙犹让浣花翁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14526,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"九月望后梅已数花先黄菊而发喜赋","author":"屈大均","text":"霜降初寒即吐花，不教黄菊擅陶家。\n篱边秋色兼春色，别作幽人一岁华。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14527,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋夕作","author":"屈大均","text":"不知萧瑟是秋声，落叶哀蝉总不平。\n更恨蕉林当户牖，教人魂梦不分明。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14528,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题画","author":"屈大均","text":"老树横斜似酒龙，扶持须倩木芙蓉。\n凭君更泼兰香墨，多写含霜三醉容。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14529,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]