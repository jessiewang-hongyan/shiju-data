[{"title":"江南曲","author":"王夫之","text":"自有三台曲，齐抛八宝簪。\n可怜秋色里，独唱望江南。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":935,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"为晋宁诸子说春秋口占自笑四首 其一","author":"王夫之","text":"腹借征南库，灯邀汉寿光。\n伤心难自遣，开卷是春王。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":936,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"为晋宁诸子说春秋口占自笑四首 其二","author":"王夫之","text":"蠹死墨魂失，?饥远视仍。\n纸窗钻不透，大扺是痴蝇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":937,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"为晋宁诸子说春秋口占自笑四首 其三","author":"王夫之","text":"南岳经声苦，东林眉宇嚬。\n似他添强笑，犹恐隔邻嗔。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":938,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"为晋宁诸子说春秋口占自笑四首 其四","author":"王夫之","text":"荧泽宏演肝，伊川辛有泪。\n未知家则堂，云何宣此义。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":939,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春尽从子敞寄山居雪咏绝句歘尔隔岁聊复和之二首 其一","author":"王夫之","text":"春去天涯雨，南留客影单。\n梁园裁赋好，遥送杏花寒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":940,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春尽从子敞寄山居雪咏绝句歘尔隔岁聊复和之二首 其二","author":"王夫之","text":"残雪留双鬓，馀寒抱死灰。\n君还愁岁暮，不畏老夫猜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":941,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"痛","author":"王夫之","text":"阿旁□□□，严霜杀人鬓。\n刺□日千□，十年皆□尽。","collection":"明末清初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":942,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哕","author":"王夫之","text":"河间酒垆前，常愁欢见绝。\n絮杀采桑人，同心若为结。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":943,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"颤","author":"王夫之","text":"白刃甜如蜜，清流险似波。\n羊牢须壁立，臧谷较无多。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":944,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寒","author":"王夫之","text":"借书败蕉叶，索字黄菅梗。\n一倍粟生肌，霜衾未恁冷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":945,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"热","author":"王夫之","text":"真作寒灰好，禁他冷灶头。\n烧灯围傀儡，鲍老汗珠流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":946,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"痒","author":"王夫之","text":"汗虱亦我液，疥虫亦我肌。\n喉间冲败絮，鸟爪复奚为。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":947,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭","author":"王夫之","text":"背我堂堂去，随他昔昔来。\n无情犹有恨，独上望春台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":948,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"笑","author":"王夫之","text":"牛湩持作酥，渴分犊子饭。\n客作不得尝，垂头打闷顿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":949,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"山居杂体吃口诗","author":"王夫之","text":"晴即前岫樵，峰分方未返。\n路乱笼绿罗，云晕涌愈远。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":950,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"口字诗","author":"王夫之","text":"岩路临磊砢，高棂营观皓。\n蝉语敛嚣啁，鸥侣欢沤藻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":951,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"为宋子主人送高渐离入秦","author":"王夫之","text":"每见关中客，无心理筑哀。\n徵书昨夜到，不待曙光催。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":952,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"绝句三首 其一","author":"王夫之","text":"乍㬉回亭午，云生叶叶低。\n轻云将雨足，侵入夕阳西。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":953,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"绝句三首 其二","author":"王夫之","text":"弱柳垂新润，春风款款中。\n濲波飘一晌，绿影过池东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":954,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"绝句三首 其三","author":"王夫之","text":"转转春条缓，鳞鳞野水肥。\n疏云飘雨白，缭绕鹭丝飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":955,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏百合","author":"王夫之","text":"莲瓣浓含粉，药房素养胎。\n繇来千种束，不放寸心开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":956,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"结袜子","author":"王夫之","text":"初识张公子，投琼气已横。\n匣中报恩剑，不为汝曹鸣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":957,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"月斜","author":"王夫之","text":"月斜空碧合，河汉几时生。\n杳霭岳莲出，萧条露叶横。\n归云飞带雨，凉雁过留声。\n祇讶西峰上，清宵有奏笙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":958,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永兴廖邓二君邀宿石角山僧阁是侍先君及仲兄䃘斋游处","author":"王夫之","text":"十月寒潭改，三年客艇过。\n画櫩星影近，甃草夜霜多。\n急难迷原隰，飘零废蓼莪。\n郴江无限水，不与挽流波。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":959,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"清远城下忆湖湘旧泊","author":"王夫之","text":"乍放浈江峡，疑连青草湖。\n星河摇古岸，渔火历蒋菰。\n霜后迷南雁，日斜忆庙乌。\n佳人多楚塞，谁解赠明珠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":960,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春江古体","author":"王夫之","text":"春鸟弄芳洲，初英照碧流。\n晴云捲山入，晓露炫烟浮。\n昨日宾鸿北，来时木叶秋。\n湘江连桂岭，瑶草趁新愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":961,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南中霜降","author":"王夫之","text":"北候怀青女，南飙拂白蘋。\n墟烟深漠漠，江草故鳞鳞。\n翠袖寒犹薄，黄华泪已新。\n炎洲无限橘，谁与寄湘津。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":962,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"不寐","author":"王夫之","text":"夜火榜人惊，江沙依舸平。\n落花逢昨日，潮月应初生。\n芳草空凝望，绿云讵有情。\n含凄愁梦杳，鱼柝警严城。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":963,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"刘端星学士昭州初度时初出诏狱","author":"王夫之","text":"昭州迁谪地，清冽道乡泉。\n过岭金风缓，当秋暑日悬。\n重开初度酒，莫诵四愁篇。\n萧艾吾何有，灵椿正大年。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":964,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"落日遣愁","author":"王夫之","text":"落日群峰外，青空邀晚红。\n晴山添雪色，远树缓霜鸿。\n心放闲愁后，生凭大化中。\n天年聊物理，楚国想遗风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":965,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"癸已元日左素公邹大系期同刘子参过白云庵茶话二首 其一","author":"王夫之","text":"晴鸟曙山天，林光捲宿烟。\n壑阴藏雪润，麦露泫珠圆。\n江树南开早，唐松东向偏。\n殷勤悬有待，请组旧行边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":966,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"癸已元日左素公邹大系期同刘子参过白云庵茶话二首 其二","author":"王夫之","text":"昨夜梅边约，春情悄不禁。\n刀环光阵阵，佛火照心心。\n箕颍徐生拙，江湖魏子深。\n南阳凭羽翼，恩泽放山林。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":967,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春尽三首 其一","author":"王夫之","text":"高树莺飞尽，流声能几闻。\n微晴通雨色，深绿过花熏。\n病浅心心在，欢遥曲曲分。\n定知双鬓谢，无复惜殷勤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":968,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春尽三首 其二","author":"王夫之","text":"杂甸与芳洲，当时不可留。\n还持流景谢，长遣故心愁。\n云际仍行药，东皋倦理畴。\n滔滔属孟夏，骚怨寄灵修。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":969,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春尽三首 其三","author":"王夫之","text":"止竟春须去，灰心揽鬓丝。\n薄晴长景困，馀冷晚风欺。\n啼鴂犹争序，藏鸦已后期。\n寄芳终契阔，阴绿听繁枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":970,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭李一超","author":"王夫之","text":"鶗鴂春先逝，龙蛇斗未开。\n容头馀子在，匕首酒人灾。\n白发摇风木，丹心亘夜台。\n报恩无意日，留取劫前灰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":971,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"再哭季林兼追悼小勇匡社旧游","author":"王夫之","text":"古寺青溪路，东窗隔一峰。\n缘花忘柳径，驱酒试蘋风。\n墨冷袜材客，巾残垫角雄。\n馀生悲梦赋，不与勒新宫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":972,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"晦日二首 其一","author":"王夫之","text":"春色去堂堂，清和损岁芳。\n夕烟青带远，晴树绿浮光。\n秋稻江乡雨，琅玕竹径香。\n定情裁古怨，迟晚意偏长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":973,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"晦日二首 其二","author":"王夫之","text":"白日奈朱颜，流光几暂闲。\n九春馀此夕，落照已前山。\n红豆留谁折，落花去不还。\n逢迎他日恨，旧上鬓丝间。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":974,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"夏夜","author":"王夫之","text":"裛露青林合，微凉生未央。\n太清平野阔，薄雾远山长。\n南树惊乌鹊，双星忆凤凰。\n吹来何处笛，急调欲清商。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":975,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"重登双髻峰","author":"王夫之","text":"拾级千寻上，登临一倍难。\n日斜双树径，云满曼花坛。\n龙雨腥还合，佛灯青欲残。\n振衣情不惬，北望暮云寒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":976,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"二贤祠重读义兴相公诗感赋","author":"王夫之","text":"谢傅青山志，羊昙旧见招。\n千秋馀版椠，孤榭托云霄。\n弦望何时合，杜蘅今已凋。\n清浔二千里，遗恨在军谣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":977,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"花咏八首 其一 樱桃","author":"王夫之","text":"艳深消雪冷，行密迓春酣。\n弱蒂东风试，繁枝细雨堪。\n大官谁复荐，啼鸟定先含。\n献岁摇新恨，群芳且未谙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":978,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"花咏八首 其二 迎春","author":"王夫之","text":"玉峰疑菡萏，绛佩讵辛夷。\n蝶醒初春里，香寻未绽时。\n云生仙袂重，月上素痕滋。\n愿结青萝好，亭亭寄远思。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":979,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"花咏八首 其三 山?","author":"王夫之","text":"韶月飞金粟，春云降瑞霙。\n暄风别有约，芳草共含情。\n须浅容寻蝶，香过恰趁莺。\n仙軿来早暮，即此玉为京。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":980,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"花咏八首 其四 紫荆","author":"王夫之","text":"珍第偕金枕，同欢感异株。\n虞渊衣未浣，汉玺泥应濡。\n疏干捎莺羽，繁英碍蝶须。\n桃蹊别弄色，泫露泣邢姝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":981,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"花咏八首 其五 杜鹃","author":"王夫之","text":"采缬轻红药，丹痕竞紫榴。\n仙归十里幄，云指九重楼。\n晴雾笼深晕，平塘炫碧流。\n如何蜀鸟恨，夜月未消愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":982,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"花咏八首 其六 黄杜鹃","author":"王夫之","text":"啼鸟愁如歇，闲情寄浅缃。\n眉新欲试喜，额晓待添妆。\n酒色醅莺羽，春情驻柳香。\n愁心迷望帝，聊学赭袍黄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":983,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"花咏八首 其七 金钗股","author":"王夫之","text":"金虎胎含素，黄银瑞出云。\n参差随意染，深浅一香薰。\n雾鬓欹难整，烟鬟翠不分。\n无惭高士韵，赖有暗香闻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":984,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"花咏八首 其八 冈桐","author":"王夫之","text":"樾馆辞寒候，江乡记稻春。\n笑迎朝日上，繁映晚霞匀。\n紫沁侵铅粉，青趺藉绿茵。\n似怜芳草弱，飞覆玉鳞鳞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":985,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"即事 其一","author":"王夫之","text":"秋晚翠娟娟，寒条经雨边。\n断云藏半树，归鸟没孤烟。\n筱弱梢梢重，藤轻叶叶便。\n上方夕磬早，亭午落清喧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":986,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"山居杂体药名","author":"王夫之","text":"白日及闲年，寻常山色妍。\n古松香满径，修竹叶参天。\n紫菀朝霞雨，黄连夕照烟。\n柴桑寄生理，不受督邮怜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":987,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"山居杂体县名","author":"王夫之","text":"月上林间夜，烟含山际秋。\n蛙吹传静乐，尻马足仙游。\n抱瓮安园䔩，忘机定海鸥。\n馀生随大冶，沤沫委东流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":988,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"岳峰悼亡四首 其一","author":"王夫之","text":"不愁云步滑，慊慊故慵来。\n多病霜风路，馀生隔岁回。\n凤绡残染泪，蛛网誓封苔。\n旧是销魂地，重寻有劫灰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":989,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"岳峰悼亡四首 其二","author":"王夫之","text":"到来犹自喜，髣髴近檐除。\n小圃忙挑菜，閒窗笑读书。\n忽惊身尚在，莫是客凌虚。\n楚些吾能唱，魂兮其媵余。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":990,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"岳峰悼亡四首 其三","author":"王夫之","text":"关塞天涯黑，精魂一倍丹。\n停云迷鸟宿，舞雪耐梅寒。\n不遣琴心寂，相怜剑影残。\n三年烹白石，馀沈咽龙湍。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":991,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"岳峰悼亡四首 其四","author":"王夫之","text":"岳阡初甃罢，君此拜姑嫜。\n地下容能聚，人间别已长。\n蝶飞三月雨，枫落一林霜。\n他日还凄绝，余魂半渺茫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":992,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"迎秋八首 其一","author":"王夫之","text":"昨夜月初明，青枫引露清。\n稻香三日雨，虹影一溪晴。\n落照低犹赤，蘋风晚更轻。\n定情凡几日，银汉映阶平。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":993,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"迎秋八首 其二","author":"王夫之","text":"斜日飐垂树，因风欲上黄。\n侵苔依浅碧，漏月透微凉。\n去鹭惊溪改，跳鱼拂荇香。\n森森芦叶满，幸缓一头霜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":994,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"迎秋八首 其三","author":"王夫之","text":"长日倦何曾，棋枰早不胜。\n杨枝愁少府，杜若老吴兴。\n星影微侵幌，萤光几背灯。\n西风才一夕，先与客愁应。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":995,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"迎秋八首 其四","author":"王夫之","text":"旧不解惊秋，于今预理愁。\n雄风三楚国，残月四更楼。\n天外芙蓉剑，人间竹叶舟。\n凉宵聊邂逅，不似梦中游。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":996,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"迎秋八首 其五","author":"王夫之","text":"青山秋缓缓，白发鬓匆匆。\n赋笔期霜雁，琴心款夜桐。\n藕丝侵水碧，鱼眼泣波红。\n莲唱歌年少，江南一梦中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":997,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"迎秋八首 其六","author":"王夫之","text":"当暑病犹轻，离魂几日阴。\n羽笙天上曲，沟水路傍吟。\n渡鹊无聊事，归禽有限心。\n炎光劳缱绻，回首怨寒砧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":998,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"迎秋八首 其七","author":"王夫之","text":"投分留纨扇，怀恩记葛衣。\n兴亡凭一泪，去住恨双违。\n戏蝶情还在，元禽巷已非。\n贮愁蜻蛚馆，旧已遣莎肥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":999,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"迎秋八首 其八","author":"王夫之","text":"吴茧初成练，商声畏上弦。\n到来拚落叶，先事怪鸣蝉。\n暗湿三更露，公收万里烟。\n亭亭苍壁外，云岫弄馀妍。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1000,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寒月","author":"王夫之","text":"寒光清不极，一半上东峰。\n霜净初弦小，烟平素影重。\n江山群动息，河汉九霄封。\n迥绝宵钟后，吾生定几逢。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1001,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"早春三首 其一","author":"王夫之","text":"光气浮莎径，红滋点药畦。\n晴丝弱柳外，夕蝶小窗西。\n风细千波绿，云生一片低。\n天情随物理，色色与春齐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1002,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"早春三首 其二","author":"王夫之","text":"不觉故心移，年华冉冉知。\n晴窗熏午睡，喧步爱芳吹。\n幸缓西园梦，还留朔雪悲。\n含情方几日，谁道鬓添丝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1003,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"早春三首 其三","author":"王夫之","text":"向夜月迎人，空烟合望新。\n落梅轻去影，乳鸟乍啼晨。\n碧水涵苔暗，流光散露匀。\n良宵仍蕴藉，悽恻奈何春。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1004,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]