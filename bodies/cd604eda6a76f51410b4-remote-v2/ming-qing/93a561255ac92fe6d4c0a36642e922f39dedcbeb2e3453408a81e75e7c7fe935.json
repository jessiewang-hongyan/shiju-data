[{"title":"与五弟登子陵钓台作 其一","author":"屈大均","text":"兄弟东西二钓台，挥杯遥劝客星来。\n故人多已为朱鸟，日暮招魂歌莫哀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13935,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"与五弟登子陵钓台作 其二","author":"屈大均","text":"滩中浩渺三江水，台下萦回十九泉。\n君作方干我皋羽，富春春枕落花眠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13936,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖上","author":"屈大均","text":"落花半落镜湖春，无数鸳鸯戏白蘋。\n吹笛一声邀海月，月来先照浣纱人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13937,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题望京楼","author":"屈大均","text":"心逐春光万里流，回风吹堕望京楼。\n江南尽是相思树，和雨和烟系紫骝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13938,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送陈献孟上横州","author":"屈大均","text":"清川一道从交阯，东下横槎作大滩。\n帝子袈裟遗玉洞，凭君为拂藓花寒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13939,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题顾子丰乘槎图","author":"屈大均","text":"上为云汉下黄河，一苇中凌万里波。\n牛斗繇来在足下，休从织女问如何。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13940,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"军行曲 其一","author":"屈大均","text":"一路鸣箛合短箫，大梅花向雪中飘。\n天寒士马愁风雪，羽猎无心去射雕。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13941,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"军行曲 其二","author":"屈大均","text":"暗传军号自嫖姚，壮士衔刀惨不骄。\n大炮一声灯火灭，偷营欲渡府江潮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13942,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"军行曲 其三","author":"屈大均","text":"月出高天更泬寥，三军无语叶萧萧。\n一声掌号催人马，夜半潜师已作桥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13943,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"军行曲 其四","author":"屈大均","text":"五兵相救短兼长，左右藤遮两翼张。\n日日诸军催练习，粤人军器最精良。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13944,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"军行曲 其五","author":"屈大均","text":"沙炮都须丈二长，藤牌一一辅花枪。\n纵横只用鸳鸯阵，马战何如步战良。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13945,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"军行曲 其六","author":"屈大均","text":"花山何似铁山强，飘子东西总莫当。\n多半归降居帐下，花红头目更飞扬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13946,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"军行曲 其七","author":"屈大均","text":"多分伏路向林丘，敌骑潜来甚可忧。\n忽见黄旗摩不止，奇兵先出斩骅骝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13947,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"军行曲 其八","author":"屈大均","text":"肃肃旌门气易秋，一声风雨起边愁。\n将军善制铙歌曲，一唱征夫泪不流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13948,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"军行曲 其九","author":"屈大均","text":"向夕旗幡四面收，天鹅吹罢上更楼。\n三军一夜阴传箭，萤火无光月不流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13949,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"军行曲 其十","author":"屈大均","text":"挑战时时踰白沟，刀牌好手夹蛇矛。\n镖鎗先掷身随入，出没如风敌尽愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13950,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"军夜","author":"屈大均","text":"夜夜身随魂梦飞，大江流水共东归。\n妻孥笑问沙场事，战血花斑在铁衣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13951,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自万安上十八滩号子 其一","author":"屈大均","text":"湍流一道下台关，日日牵舟竟上山。\n怪石预愁三百里，滩穷更有水湾环。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13952,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自万安上十八滩号子 其二","author":"屈大均","text":"水落沙乾舴艋迟，渔人乘雨放鸬鹚。\n天风不为吹帆席，留向滩边作竹枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13953,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自万安上十八滩号子 其三","author":"屈大均","text":"一夜滩鱼拨剌声，雨中偏得月华明。\n平铺瀑布冲舟去，白鹭无心亦自惊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13954,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自万安上十八滩号子 其四","author":"屈大均","text":"百里飞流尽玉帘，穿舟奇石水中潜。\n滩师曲折随滩意，笑指峰峰似白盐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13955,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自万安上十八滩号子 其五","author":"屈大均","text":"乱石穿流齿角长，时时滟滪隐中央。\n平生未至瞿唐峡，只此销魂悔下堂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13956,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自万安上十八滩号子 其六","author":"屈大均","text":"故故欹帆冲礧砢，不妨象马拒舟来。\n波涛鼓舞多奇势，飞入窗中失酒杯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13957,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自万安上十八滩号子 其七","author":"屈大均","text":"往来舟向沸汤飞，四面峰峦翠作围。\n风搅雪花潭底出，行人八月已寒衣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13958,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自万安上十八滩号子 其八","author":"屈大均","text":"水石争飞穷水变，时时岩口欲吞人。\n熊罴忽掠舟帆过，势转秋毫若有神。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13959,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自万安上十八滩号子 其九","author":"屈大均","text":"羊肠尽在白波中，折入巉岩一发通。\n三老不须矜巧绝，沉牛人自答神功。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13960,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自万安上十八滩号子 其十","author":"屈大均","text":"渐近虔州乡思催，迎人已见鹧鸪来。\n行时不唤生憎汝，明岁休教见岭梅。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13961,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自万安上十八滩号子 其十一","author":"屈大均","text":"林深知道有人家，妇女喧喧上钓槎。\n山主晓收刀税至，滩头煎取饼儿茶。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13962,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自万安上十八滩号子 其十二","author":"屈大均","text":"滩师拿柁势能轻，尽识中流怪石名。\n千折不教毫发失，将人身入阵图行。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13963,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自万安上十八滩号子 其十三","author":"屈大均","text":"秋乾始见石巑岏，一曲峰回即一滩。\n熊耳纷纷无路入，更愁涡底起波澜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13964,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自万安上十八滩号子 其十四","author":"屈大均","text":"一滩清浅一滩深，夹岸黄茅气毒淫。\n蛇虎无声宜白昼，沿洄且复弄花林。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13965,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自赣上南安川路甚曲未至南康县已有三十六湾舟人称为湘江湾云 其一","author":"屈大均","text":"三十六湾至蕉溪，九十九曲至横浦。\n舟人道此似湘江，削竹青青牵挽苦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13966,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自赣上南安川路甚曲未至南康县已有三十六湾舟人称为湘江湾云 其二","author":"屈大均","text":"山转不知滩路尽，篙声响处四山闻。\n石随飞水层层落，中有人烟出白云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13967,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自赣上南安川路甚曲未至南康县已有三十六湾舟人称为湘江湾云 其三","author":"屈大均","text":"曲似湘江色不如，湘江空翠映芙蕖。\n衡山九面皆临镜，清绝尤宜烟雨馀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13968,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自赣上南安川路甚曲未至南康县已有三十六湾舟人称为湘江湾云 其四","author":"屈大均","text":"千山秋草似云黄，石壁横开谷口光。\n白昼虫声多叹息，应怜游子客蛮方。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13969,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"曲中赠朱十","author":"屈大均","text":"一片晴云天上流，忽闻歌响驻红楼。\n阳台昔日随神女，雒水今朝倚莫愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13970,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"某明府纳姬金陵索赠 其一","author":"屈大均","text":"美人为政大河间，秋望罗浮放白鹇。\n秋浦繇来学陶令，二桐五柳共閒閒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13971,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"某明府纳姬金陵索赠 其二","author":"屈大均","text":"已有芙蓉并蒂妍，红妆双倚似非烟。\n更迎桃叶秦淮上，共载梅花大庾边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13972,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"某明府纳姬金陵索赠 其三","author":"屈大均","text":"从今左顾足鸳鸯，两两调丝乐未央。\n乐府旧歌三妇艳，岂知今在使君堂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13973,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"某明府纳姬金陵索赠 其四","author":"屈大均","text":"太白风流奈尔何，金陵小妓楚声多。\n天生三寸如花笔，只为佳人画翠娥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13974,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"始兴江口","author":"屈大均","text":"梅峤春生霹雳泉，流为浈水欲浮天。\n新篘正月桃花酒，溪女鲥鱼只百钱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13975,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"银瓶滩口号","author":"屈大均","text":"银瓶不解泻流霞，春水空然滚白沙。\n如此风波宜一醉，醉眠江底眼生花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13976,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"英德舟中与孔君奕","author":"屈大均","text":"舟系浈阳夜欲分，楸枰子落半山闻。\n宣州太守吾无用，欲得君边一片云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13977,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宿乳源道中","author":"屈大均","text":"马度桥南石路平，黄昏未到乳源城。\n山楼一夜惊寒梦，不辨松声与水声。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13978,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"二禺","author":"屈大均","text":"南禺峰与北禺齐，绝壁交飞万仞梯。\n帝子箫声殊未绝，松风吹水暮凄凄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13979,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自清远上三峡口号 其一","author":"屈大均","text":"生竹青青作挽强，牵过七十二峰长。\n峡口滩高忧挽断，三朝不得上浈阳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13980,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自清远上三峡口号 其二","author":"屈大均","text":"滩高峡小是浈阳，三峡无如此峡长。\n一路天梯攀不尽，鹧鸪还与断肝肠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13981,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西樵湖棹歌追和湛文简公 其一","author":"屈大均","text":"二十三泉一半飞，飞为大小水帘肥。\n湖中尽是飞泉水，曲曲随舟上翠微。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13982,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西樵湖棹歌追和湛文简公 其二","author":"屈大均","text":"东北湖头接白云，东南湖尾大江分。\n诸峰不在烟波外，七十芙蓉总与君。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13983,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西樵湖棹歌追和湛文简公 其三","author":"屈大均","text":"芙蓉一朵一飞泉，流作湖波荡碧天。\n十八花湾行不尽，江风吹上瀑花边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13984,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"潮泉","author":"屈大均","text":"一泉天半有神灵，吸得江潮上翠屏。\n千里潮来清远峡，不教一宿返南溟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13985,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"金陵曲送客返金陵 其一","author":"屈大均","text":"文德桥东武定西，灯船高与画楼齐。\n笙歌声满秦淮水，惊起啼乌不得栖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13986,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"金陵曲送客返金陵 其二","author":"屈大均","text":"雨雪官街夜市寒，六朝灯火未曾残。\n城南步马还城北，廿四航边次第看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13987,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"金陵曲送客返金陵 其三","author":"屈大均","text":"乌衣朱雀御桥通，六代精灵在月中。\n亡国只馀春草色，青青长向景阳宫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13988,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"金陵曲送客返金陵 其四","author":"屈大均","text":"花间擎出玉盘迟，正是江南九熟时。\n灵谷樱桃春不荐，杜鹃啼断御园枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13989,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"金陵曲送客返金陵 其五","author":"屈大均","text":"丽华兰麝在荒丘，光气长如匹练流。\n南国美人元有数，江东天子自无愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13990,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"金陵曲送客返金陵 其六","author":"屈大均","text":"金吾旧有四花园，东在青溪故址存。\n不到太平歌舞地，从何沾洒列朝恩。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13991,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"金陵曲送客返金陵 其七","author":"屈大均","text":"玉溆金塘濯锦馀，武宗曾此得金鱼。\n紫云一片钟山至，长向楼端护御书。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13992,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"金陵曲送客返金陵 其八","author":"屈大均","text":"长板桥通太液流，月明游女满桥头。\n中山画舫随人坐，东泛青溪西莫愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13993,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"金陵曲送客返金陵 其九","author":"屈大均","text":"飞桥三折逐溪长，红杏千株落水香。\n十里溪云连古木，阴森不见帝城墙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13994,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"金陵曲送客返金陵 其十","author":"屈大均","text":"白鹭芳洲廿里长，家家花发暖飞香。\n轻舟未忍随潮去，公主坟西吊夕阳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13995,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阅汪文冶始信峰草堂纪略率题六绝 其一","author":"屈大均","text":"占得黄山始信峰，弟兄身亦一奇松。\n一松复似寒江子，峰顶盘旋作扰龙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13996,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阅汪文冶始信峰草堂纪略率题六绝 其二","author":"屈大均","text":"前海何如后海奇，兹峰观海更相宜。\n白云初起诸峰暝，万里惊涛在霁时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13997,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阅汪文冶始信峰草堂纪略率题六绝 其三","author":"屈大均","text":"万壑朝宗是白云，微茫不复海天分。\n诸峰来去如帆席，风外涛声寂不闻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13998,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阅汪文冶始信峰草堂纪略率题六绝 其四","author":"屈大均","text":"终岁花开不辨名，朝霞多是寒花成。\n千岩万壑花分色，云海浮沉尽落英。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13999,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阅汪文冶始信峰草堂纪略率题六绝 其五","author":"屈大均","text":"穿地峰峰似箨龙，松身缭绕玉芙蓉。\n飞梯不向崖端造，咫尺应愁紫翠封。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14000,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阅汪文冶始信峰草堂纪略率题六绝 其六","author":"屈大均","text":"黄帝衣裳作海云，浮丘几席落花纷。\n遗书续取先司马，便与山灵建大勋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14001,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"为姜子题岁寒图","author":"屈大均","text":"先朝一树是寒梅，竹筱松枝共翠苔。\n与子共存高节在，天南方少岁寒材。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14002,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏秦夫人良玉","author":"屈大均","text":"巾帼勤王旧有名，罗敷同姓亦同情。\n红妆自可张军气，锦伞繇来建义声。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14003,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"新安江生寿词 其一","author":"屈大均","text":"三十才名冠六朝，朱霞天半见丰标。\n黄山亦是江郎笔，无数芙蓉削紫霄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14004,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"新安江生寿词 其二","author":"屈大均","text":"白鹿骖乘弄紫箫，玉瓶甘露手亲调。\n浮丘在左容成右，更授丹书佐帝尧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14005,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟中苦热","author":"屈大均","text":"九月南天犹袒裼，炎云低压舸船来。\n清凉苦忆当年好，跣踏层冰上五台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14006,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"团扇词","author":"屈大均","text":"蘋藻浮沉苦不同，君怜岂必玉颜红。\n未秋团扇先捐弃，明月团团在箧中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14007,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]