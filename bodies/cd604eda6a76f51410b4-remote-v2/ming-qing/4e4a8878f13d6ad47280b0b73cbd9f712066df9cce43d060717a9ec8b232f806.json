[{"title":"蕉","author":"何巩道","text":"层层高影立疏篱，密叶临窗晚自吹。\n雨滴泪痕支枕夜，墨题诗句捲帘时。\n倚当檐下风生急，遮尽庭前月到迟。\n莫向绿阴伤往事，梦中迷鹿有谁知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6174,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"种梅","author":"何巩道","text":"数树江梅花未香，雪晴移得上归航。\n与僧尽日临溪水，骑马何人踏夕阳。\n吹断冻云沉野渡，吟残初月闭閒房。\n孤根一别江南路，又抱寒冰怨夜长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6175,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖上白莲十首 其一","author":"何巩道","text":"家住江南杜若洲，枯荣都付水中流。\n独将碧眼看炎帝，肯把冰心赠素秋。\n歌舞一场湖上恨，丹青千古画中愁。\n西施莫漫娇红粉，清白唯应属海鸥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6176,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖上白莲十首 其二","author":"何巩道","text":"亭亭玉立倚阑干，脂粉全消水殿寒。\n五月忽成银世界，十年长抱雪心肝。\n何须相府繁华曲，请认麻姑寂寞坛。\n我已洁身尘外去，任人空说色堪餐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6177,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖上白莲十首 其三","author":"何巩道","text":"天空明月水澄澄，独立沧洲思不胜。\n择地但寻湖是国，避人偏与鹤为朋。\n消除炎气清如许，历尽波涛志倍增。\n借问若耶溪畔女，红尘今堕几多层。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6178,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖上白莲十首 其四","author":"何巩道","text":"尽日湘江捲画帘，清歌应拟雪梅兼。\n生成水国能禁火，高卧冰盘不受炎。\n天地有情容我老，水云无恙许惟添。\n素心近得渔翁识，明月清江梦若恬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6179,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖上白莲十首 其五","author":"何巩道","text":"阅尽繁华不可招，却从炎夏出寒潮。\n世间烟火何曾到，眼底尘埃已尽消。\n公子莫歌金缕曲，美人休放木兰桡。\n生平直骨沧海里，肯向朱门学折腰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6180,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖上白莲十首 其六","author":"何巩道","text":"太液承恩妒宠时，君王总是爱胭脂。\n宁知玉井千株雪，笑尽金黄一局棋。\n人世几何沧海老，繁华无定落花时。\n可归太华峰头去，波浪于今在海涯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6181,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖上白莲十首 其七","author":"何巩道","text":"玉写冰姿雪写神，悠悠云水一閒身。\n湘娥瑶瑟调皆冷，鲛客明珠数未匀。\n自泛烟波常独往，谁怜鸥鹭欲相亲。\n年来旧社多零落，才入东林问主人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6182,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖上白莲十首 其八","author":"何巩道","text":"谁与众芳说是非，百年踪迹钓鱼矶。\n玉簪错认嫦娥赠，环佩分明洛女归。\n无梦不曾离水殿，有情偏爱绕书帷。\n孤根带得瑶池种，不向人间乞紫衣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6183,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖上白莲十首 其九","author":"何巩道","text":"自泛西湖户不扃，閒从烟水赏俜停。\n赋残明月头堪白，呼遍澄江梦已醒。\n艳色未投金紫客，苦心终老水云亭。\n秋风转眼炎凉态，莫近花田傍素馨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6184,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖上白莲十首 其十","author":"何巩道","text":"蒹葭何复赋苍苍，种玉花开玉一堂。\n金采亦能传太素，淡云依旧拥孤芳。\n雌黄口里从今说，红紫场中只自忙。\n何似沧洲思洗耳，清风吹遍五湖香。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6185,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏草","author":"何巩道","text":"十里蒙茸绕海城，绿杨莎岸半阴晴。\n若为独立空遥望，每到相逢便远行。\n晓色暗迷临水梦，暮云低送倚楼情。\n青青未必经霜改，长向明妃冢上生。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6186,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"白鸥","author":"何巩道","text":"点点沙鸥入望微，客心寥落共依依。\n每怜弱羽因风起，最惜同群杂雪飞。\n渔父自应同订约，世人谁可学忘机。\n落花踪迹随流水，似得烟波去复归。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6187,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"白燕","author":"何巩道","text":"一点轻绡暮影微，银塘水镜藕争肥。\n应无雪片晴时落，岂有梨花夏日飞。\n山下独怜和氏璧，寰中谁着邺侯衣。\n十年王谢头如鹤，又共寻常百姓归。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6188,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赤鹦鹉 其一","author":"何巩道","text":"绛罗衫袖汉宫妃，十二红栏扑蝶飞。\n宿雨未埋孤客恨，落英先点少年衣。\n倾城褒似烽连闼，入殿灵芸火照扉。\n迷尽荔枝林外路，夏云千片不知归。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6189,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赤鹦鹉 其二","author":"何巩道","text":"久服丹砂欲化仙，日轮飞起镜中天。\n金笼巧语初惊梦，琪树鸿文半是烟。\n南内忆来空洒泪，西秦归去已经年。\n雅歌更若翻朱雁，悲乱红楼十五弦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6190,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宿鸟","author":"何巩道","text":"倦翼将何托，高枝在日西。\n架头鹰气短，帘下燕巢低。\n梦里犹能立，醒时或肯啼。\n感君先择木，终夜叹栖栖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6191,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"见猿","author":"何巩道","text":"谷口停舟晚，群猿出夕阳。\n扳枝听客语，分果引儿尝。\n饮静山泉暗，吟哀峡路长。\n萧条秋九月，逢汝在他乡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6192,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"罗浮蝶","author":"何巩道","text":"风吹双蝶引柴扉，绕尽疏帘恋落晖。\n香梦尚酣千日酒，綵云新剪五铢衣。\n养成金粉随花落，写入罗裙满镜飞。\n回首朱明天上路，飘零同是未曾归。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6193,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"七星岩","author":"何巩道","text":"历历疏钟出远村，秦灰烧尽石犹存。\n低岩到水才通路，深洞生云忽闭门。\n香案行多饥鼠迹，诗题留得古冰痕。\n红菱渡口归舟晚，齐放渔歌送客喧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6194,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"红亭","author":"何巩道","text":"锦袍沉醉奏清平，今日孤吟卧海城。\n折柳每怜春二月，闻鹃方觉夜三更。\n琴知风急弦先动，蝶采花多□渐成。\n不用更听何满子，暗啼红泪亦闻声。","collection":"明末清初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6195,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"霜溪","author":"何巩道","text":"有家何必住云霄，半里清溪独木桥。\n月出共僧吟彻夜，花开陪鹤立终朝。\n入墙远黛堆吴鬓，近水垂杨占楚腰。\n学得渔郎歌一曲，隔林醉与烂柯樵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6196,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"滩上","author":"何巩道","text":"云在高天月在波，两层清影照长河。\n重来烟树情何限，独宿孤篷恨自多。\n万丈落星惊角枕，数声流水冷轻罗。\n临风欲咏心先折，空绕渔舟夜听歌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6197,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"白石道中","author":"何巩道","text":"乱后辞家及暮春，萧萧行李出江滨。\n桃花雨暗烟村路，杨柳风寒野渡人。\n流水有情时自绕，碧山无主转相亲。\n廿年尘世三蒙难，一度穷途一怆神。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6198,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"江门道中","author":"何巩道","text":"晓行不觉客途赊，路入烟村背郭斜。\n朝日未升天似水，残霜犹湿叶如花。\n城低秋草遥吹角，树拂疏星乱起鸦。\n辛苦马蹄三十里，浮生何处更思家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6199,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"楚中怀古","author":"何巩道","text":"楚乡一望起离忧，烟树茫茫日夜游。\n千里客心随雁阵，百年幽恨入江流。\n巫山望断终为雨，湘水云归每及秋。\n无限西风吹落叶，不知王粲正登楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6200,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过林步酒家","author":"何巩道","text":"卧松欹柳倩谁扶，飞尽溪花绿满芜。\n樵子不惊群饮鹿，野人能畜自归凫。\n日斜黄叶千声乱，雨过青山一点孤。\n却爱女郎篱下出，肯携司马为当垆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6201,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"登古冈城东山","author":"何巩道","text":"兀立东城感慨存，萧萧遗垒望荒原。\n河山不改空留恨，部曲无归莫返魂。\n日暗树烟迷石涧，水摇云气照江门。\n人生最苦轻离别，明月孤帆归远村。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6202,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"五羊江上","author":"何巩道","text":"微阳明灭海浮天，买得归帆意渺然。\n树有浅深迷过客，潮无朝暮送流年。\n沙寒鸂鵣初争岸，江静蜻蜓暂上船。\n欲把一竿吟不去，閒情吹到绿蓑边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6203,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过西竺新庵","author":"何巩道","text":"阴阴林莽蔽西堂，树底停车巳自凉。\n游倦客皆青眼老，吟多僧亦白髭长。\n井窥天色沉秋日，城落帆痕曳夕阳。\n行到野塘花欲谢，曲栏空倚木樨香。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6204,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"重过牛山寺","author":"何巩道","text":"离乱溪山愿已违，旧游烟树认还非。\n暮潮渔鼓喧江市，落日僧钟出翠微。\n路断故园犹入目，途穷吾道一沾衣。\n明朝又有梅花约，骑马频来却似归。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6205,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"五月午日泛甘滩","author":"何巩道","text":"天色山光入艇凉，积潮横下白汤汤。\n几行箫鼓临风急，一岸芙蓉趁雨香。\n离乱难凭丝续命，飘零空借赋投湘。\n春蒲碧艾年年绿，惭愧乡心鬓有霜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6206,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"再泛甘滩","author":"何巩道","text":"海山含雨尽冥冥，轻舸重来过远汀。\n两日浮生频载酒，百年归计尚飘萍。\n层崖日落潮光白，阴洞苔寒佛火青。\n何限鹤群沙际起，人间无路托仙翎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6207,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"晚过海怀庵","author":"何巩道","text":"谷中閒步石崚嶒，红白花开出古藤。\n日暮客心逢落叶，乱流人语见僧□。\n秋云阴锁厨间竹，渔火红烧塔里灯。\n谁在高楼看双瀑，西风一夜半成冰。","collection":"明末清初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6208,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蜡月游石湖","author":"何巩道","text":"冬尽看山昼亦阴，傍桥红树一閒吟。\n晴溪清浅流难断，竹路微茫去易深。\n谷响答时闻落木，钓丝垂处立饥禽。\n再来欲向桃花问，便恐迷津不可寻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6209,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"游青琅园","author":"何巩道","text":"春光多半绿杨堤，出郭寻春野寺西。\n涧水近通池水碧，粉墙斜接女墙低。\n讲经声细鱼初出，施食行迟鸟自啼。\n游客欲留僧不语，暮云斜日总凄凄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6210,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"晓发罗溪","author":"何巩道","text":"晓烟临水树层层，波影分明两片灯。\n百战江山如昨日，独行踪迹似孤僧。\n鸦惊落月翻衰叶，马怯寒风立断冰。\n欲谢红尘就林壑，投閒曾有几人能。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6211,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"暮投石子村","author":"何巩道","text":"晚烟含树隐孤村，一水通船石有门。\n不见溪花开白昼，但怜渔火照青尊。\n悲风尽脱临厓叶，落□争啼挂树猿。\n便欲回舟向沧海，秋波犹恐易锁魂。","collection":"明末清初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6212,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟发珠江","author":"何巩道","text":"树散朝烟认始真，轻舟初出粤江滨。\n水边易动孤吟兴，乱后长为独往人。\n山气有光云似翼，海风无力浪如鳞。\n倦游欲向沧洲老，渔父沙鸥日日亲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6213,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"登阅江楼","author":"何巩道","text":"一上江楼忆往年，他洲风物晚凄然。\n春归尽见千家草，路古长通两粤船。\n西日落山光射海，东流穿峡势从天。\n伤心更有空宫树，花落黄昏叫杜鹃。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6214,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"重游小岭 其一","author":"何巩道","text":"閒身故得访云林，泉石依稀尚可寻。\n落木如今寒路色，苍山终古野人心。\n松风曳磬飞霜瀑，草露留花上苇襟。\n每到便生岩谷志，冷梅香彻石床阴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6215,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"重游小岭 其二","author":"何巩道","text":"半日浮生恋翠微，祇于触目可忘机。\n凌空鹤去僧无友，渡海云归石有衣。\n刍狗烧残泉气热，木稚香阔悟心微。\n重来此地频增感，流水声声解讽讥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6216,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"云梯山下西溪诗","author":"何巩道","text":"何处风来落叶纷，绕溪深树昼生云。\n秋山莫笑红尘客，野水将寻白鹭群。\n日影射鱼看可数，竹声飞瀑听难分。\n此时对景沉吟久，却有林花细细闻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6217,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春日郊行","author":"何巩道","text":"雪浅云高昨夜晴，千枝杨柳亚春城。\n正愁芳草无穷路，却爱黄莺不住声。\n海气拂来渔鼓急，村烟销尽酒旗轻。\n同游几个能诗客，都绕桃花树底行。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6218,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"惠阳书事","author":"何巩道","text":"军兴三载急追呼，长吏曾知疾病无。\n不向田园触旧赋，又从瓜果索新租。\n儿童入市愁心切，妇女提筐泪眼枯。\n一举义旗民日促，后人从此薄征诛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6219,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"饮蒙园池","author":"何巩道","text":"城头红叶有残霜，城下梅花照女墙。\n一度相思能命驾，百年行乐爱飞觞。\n将斜日色轻寒浅，欲断溪流过雨长。\n倒着接篱君莫叹，习家池畔似高堂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6220,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自蒙园醉归","author":"何巩道","text":"暮城挝鼓忽阗阗，飞上归鞍故失鞭。\n穿尽柳过官路口，吟成诗隔女墙边。\n花开只合连宵赏，月好何曾两夜圆。\n不信到家醒未得，酒痕犹在袖中笺。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6221,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"霜溪酌酒","author":"何巩道","text":"寂寞秋心病后知，谁寻踪迹到东篱。\n溪声入竹交相答，鹤影窥人两自疑。\n客思惹多衰芳岸，吟魂销尽夕阳枝。\n一缶桑落宁辞醉，或者风流亦在兹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6222,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春日过酌田家","author":"何巩道","text":"离乱逃秦别一家，半檐茅屋背桃花。\n乍来此地能成醉，始叹吾生未有涯。\n江暖渐闻新燕语，日斜空笑晚蜂衙。\n青尊若问重游约，只恐浓阴路已差。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6223,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟次故里山下","author":"何巩道","text":"望见家山未到家，客愁依旧满天涯。\n青尊倾尽诗难写，绿水流多鬓易华。\n鹤避渔蓑过别浦，雨催秧鼓急平沙。\n村烟不似秦人隐，谁种桃溪十里花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6224,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南庄偶成","author":"何巩道","text":"捲帘终日坐轻阴，世事如棋不自任。\n积水化云天欲白，断虹收雨海俱深。\n千家好月先秋满，一树新蝉向客吟。\n欲对高空望关塞，雁行秋思正相侵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6225,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日宿僧舍","author":"何巩道","text":"雾散空林雨自收，寻僧尽日上西楼。\n栖心对佛难成寐，傲骨临风易感秋。\n贝叶经霜翻讲席，砧声随月过城头。\n几回欲把吴钩舞，侧耳荒鸡四五筹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6226,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"客邸独坐成吟","author":"何巩道","text":"疏雨临阶昔昔声，雨晴忽觉月微明。\n羁人对酒此时叹，之子踏歌何处行。\n砌叶未霜辞树晚，阁风因竹入衣轻。\n分明寂寞沉吟地，却遣灯花一夜生。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6227,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟经甘滩旧隐","author":"何巩道","text":"十年避迹此求安，今日秋山海上看。\n舟路不停寒树色，客心犹恋旧渔竿。\n人当渐老愁先易，地是曾游别更难。\n莫笑雁声南北入，此身常带远游冠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6228,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋亭晨起","author":"何巩道","text":"宿雨初晴日未红，冷吟声在落花中。\n云皆近海终为水，叶已辞枝只任风。\n晚径祇教僧独到，秋心先与客心同。\n临池一鹤亭亭立，似有微情到碧空。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6229,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"元夕坐西山草堂旧感","author":"何巩道","text":"雨晴荒院有春灯，照入西山路几层。\n屋暖渐低鸡树月，石寒犹响马蹄冰。\n新愁绿酒酣千日，往事红灰化五陵。\n不用更歌金管曲，十年王谢半为僧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6230,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"中秋前五日偶成","author":"何巩道","text":"水处成诗阁处吟，水云飞起阁阴阴。\n满城落叶如闻雨，几夜啼乌不在林。\n石井枕沙潮自入，野藤扳竹路全侵。\n沉沉秋月无人到，却有邻僧为鼓琴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6231,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"午日别妓","author":"何巩道","text":"夕阳西下暗长虹，红藕花开艳晚波。\n乐处每嫌歌舞短，愁来方恨别离多。\n江堆白浪千群马，树锁青山一点螺。\n欲吊湘累无路到，沉吟空自绕烟波。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6232,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋湘堂偶成","author":"何巩道","text":"天空斜月入檐低，屋里窗开尽对溪。\n一地晚花留蝶宿，数枝秋柳罢莺啼。\n乞诗稚子痴相问，送酒渔郎老自携。\n试上孤篷共吟赏，芙蓉红满相公堤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6233,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"范湖口号三首 其一","author":"何巩道","text":"日光无路射花阴，一片蝉声几处吟。\n水照槛边垂柳乱，风行衣上落花深。\n欲谈往事难辞酒，肯写幽情只有琴。\n借问爱閒何处买，比来分得白鸥心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6234,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]