[{"title":"点绛唇 其四 春霁","author":"梁清标","text":"昨夜冥冥，开窗霁色帘栊晓。\n海棠绽了。\n过雨红偏好。\n横笛高楼，几许人嚬笑。\n莺声老。\n落英多少。\n何处寻芳草。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2641,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇 其五 忆旧","author":"梁清标","text":"帘押风柔，伤心往事斜阳里。\n当年花底。\n芍药栏同倚。\n依旧芳菲，岁月看流水。\n春残矣。\n乱红如绮。\n草绿人千里。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2642,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇 其六 闺情","author":"梁清标","text":"春困恹恹，斜风细雨寒吹阁。\n银屏珠箔。\n苦把花枝缚。\n虚倚薰笼，旧事思量著。\n情差错。\n海棠零落。\n对下秋千索。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2643,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇 其七 悼亡","author":"梁清标","text":"玉冷秦台，凤箫响绝闲萧史。\n芙蓉落矣。\n璧月怜秋水。\n谁与温存，小阁香肩倚。\n孤眠里。\n画笳声起。\n偏到愁人耳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2644,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 其一 春闺","author":"梁清标","text":"深院秋千绣带轻。\n衣沾香汗玉钗横。\n最怜节气近清明。\n怕见落英春欲暮，倦开翠幌梦频惊。\n碧桃花下戏调莺。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2645,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 其二 春怀","author":"梁清标","text":"郊外提壶籍草茵。\n桃花春涨水粼粼。\n暖风吹散隔溪云。\n柳色暗催羁客泪，莺声愁煞画楼人。\n两般心事总沾巾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2646,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 其一 花间双蝶","author":"梁清标","text":"人闲清昼抛书立。\n绿阴深处蝉声急。\n一树紫薇开。\n翩翩引蝶来。\n篱边相逐舞。\n摹作滕王谱。\n槐老入新秋。\n西风蝶也愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2647,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 其二 悼亡","author":"梁清标","text":"玳梁当日栖双燕。\n碧桃花下看人面。\n往事耐思量。\n银灯照晚妆。\n宝钿空瑟瑟。\n愁煞西堂客。\n肠断只三声。\n长更与短更。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2648,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 其三 春闺","author":"梁清标","text":"乱鸦啼处春风晓。\n流苏香暖金钩小。\n晴影入窗纱。\n街头卖杏花。\n鸳鸯初睡足。\n偏堕云鬟绿。\n拂镜试新妆。\n低回问粉郎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2649,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 其四 题画扇","author":"梁清标","text":"板桥流水湖山靓。\n桃花人面红相映。\n唤婢采芳兰。\n妆成小步看。\n苔侵罗袜湿。\n爱向春风立。\n莫问落花香。\n当年误阮郎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2650,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 其五 春雨","author":"梁清标","text":"家山漠漠思千缕。\n杏花零落廉纤雨。\n燕语恨春归。\n河桥柳絮飞。\n游骢何处驻。\n野水棠梨路。\n泥滑阻郊行。\n芳堤误早莺。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2651,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 其六 暮春雨中十五弟归里","author":"梁清标","text":"可怜九十春光尽。\n南窗疏竹生新笋。\n榆荚雨潇潇。\n花寒夜寂寥。\n河桥垂柳折。\n柳絮飞如雪。\n茅店闭黄昏。\n孤灯何处村。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2652,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 其七 宿伏城驿","author":"梁清标","text":"伏城明月浑如昔。\n往来照尽长征客。\n今日我重过。\n其如孤影何。\n遥看云外树。\n总是来时路。\n莫喜到家乡。\n乡愁到更长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2653,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 其八 旅怀","author":"梁清标","text":"驿亭秋尽寒风起。\n离人今夜思千里。\n刻烛几踟蹰。\n南来少雁书。\n酒樽聊独对。\n半是闺中泪。\n且莫盼书来。\n音书乱客怀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2654,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 其九 大店驿","author":"梁清标","text":"泥墙草屋鸡声咽。\n二千里外看明月。\n地已入江淮。\n风沙何倍来。\n乡愁人似醉。\n强伴昏灯睡。\n雁到怪无书。\n连朝并雁无。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2655,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 其十 赠伎","author":"梁清标","text":"斜风细雨清宵永。\n徘徊忽见灯前影。\n命薄每伤神。\n偏怜薄命人。\n轻罗回小扇。\n省识如花面。\n百媚坐来生。\n无情若有情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2656,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 其十一 立秋","author":"梁清标","text":"高城月上阴云敛。\n芙蕖远送清香满。\n一叶井梧秋。\n西风吹鬓愁。\n笙箫华馆沸。\n搅得蝉声碎。\n乍觉晚凉多。\n闻歌唤奈何。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2657,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 其十二 赠女伶","author":"梁清标","text":"樽前若个歌金缕。\n盈盈十五芳如许。\n笑靥半含羞。\n骄憨不解愁。\n眉痕青尚浅。\n秋水双眸剪。\n何处耐人思。\n歌停掩袖时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2658,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 其十三 寒食","author":"梁清标","text":"皇州一夕传宫烛。\n五侯宅里烟凝绿。\n何处最关愁。\n佳人倚画楼。\n水边萦醉客。\n金犊驱油壁。\n乡思黯黄昏。\n梨花深闭门。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2659,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 其十四 春暮","author":"梁清标","text":"散衙晴暖茅斋小。\n落花寂寂鸣山鸟。\n白昼放春闲。\n那堪春又阑。\n往时春酒社。\n系马垂杨下。\n今日任东风。\n羞看寂寞红。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2660,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 其十五 题画","author":"梁清标","text":"空岩漠漠溪云起。\n人家茅屋泉声里。\n谁为写沧洲。\n当年顾虎头。\n冥濛潭上黑。\n波涌鱼龙泣。\n好作卧游看。\n江南雨后山。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2661,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 其十六 夏夜","author":"梁清标","text":"火云飞下三千尺。\n我思赤脚层冰立。\n待得月昏黄。\n轻风拂体凉。\n短篱微带露。\n两两流萤度。\n乍喜却齐纨。\n一帘花影寒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2662,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 其十七 春暮有感","author":"梁清标","text":"奈何有梦频惊醒。\n落花如雨闲阶冷。\n憔悴为疼花。\n凭阑日又斜。\n空帘栖薄雾。\n仿佛凝妆处。\n谁料可怜春。\n新莺唤煞人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2663,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 其十八 秋日观邗郎演剧","author":"梁清标","text":"晶帘雨过空天碧。\n芙蓉笑靥斜阳立。\n花影正重重。\n人从花底逢。\n月高丝管沸。\n溜出歌声脆。\n对此意茫茫。\n偏怜秋夜长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2664,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 其十九 送春","author":"梁清标","text":"远峰历历青如髻。\n驿亭几缕墟烟细。\n西望凤城遥。\n山空夜寂寥。\n杏花三月雨。\n眼见春如许。\n无计挽东皇。\n怜他蝶翅忙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2665,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"醉桃源 季夏雨后，饮舅氏园中","author":"梁清标","text":"古槐疏柳度轻飙。\n荷香隔院飘。\n棚阴清露缀葡桃。\n开樽兴倍豪。\n金跳脱，紫檀槽。\n有人态色饶。\n解襟灭烛影萧萧。\n严更促丽谯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2666,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"诉衷情 其一 忆家","author":"梁清标","text":"绿杨影里子规啼。\n催得鬓丝丝。\n撩人暮春天气，画阁晚妆时。\n新柳困，远山低。\n思依依。\n五更细雨，半夜归鸿，一片花飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2667,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"诉衷情 其二 咏莲","author":"梁清标","text":"猩红弓样试风流。\n贴地软香浮。\n凌波巧笼纤笋，锦幄倍清幽。\n莲折瓣，月微钩。\n玉温柔。\n苔痕池上，泥印花间，尘迹楼头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2668,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"诉衷情 其三 旅怀","author":"梁清标","text":"夕阳古道敛残霞。\n南雁数行斜。\n何缘人却如雁，迢递驿程赊。\n回首处，凤城遐。\n乱云遮。\n灯寒香阁，风起邮亭，人去天涯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2669,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"诉衷情 其四 无题","author":"梁清标","text":"雪儿十载罢歌喉。\n一纸远相投。\n为伊暗想当日，牵动几般愁。\n银烛夜，彩云留。\n笑回眸。\n三更幽梦，千里风烟，何处红楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2670,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"卜算子 其一 闺晓","author":"梁清标","text":"宝鸭被重薰，茉莉香先透。\n两两鸳鸯宿碧纱，私语人知否。\n夜雨袅残灯，朝露沾罗袖。\n怪煞开奁促晓妆，好梦浓如酒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2671,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"卜算子 其二 喜雨","author":"梁清标","text":"晨起火云生，棋罢珠帘午。\n暗送墙头夜合香，粉蝶双飞去。\n汗滴透罗衣，手倦挥纨素。\n乍喜风来似故人，几点榴花雨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2672,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"巫山一段云 春宵","author":"梁清标","text":"箫局微温候，灯篝乍剪时。\n端相带笑又佯推。\n欲睡故迟迟。\n银蒜垂帘悄，金钗落枕欹。\n淡红耙袜映唇脂。\n低问小名儿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2673,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"减字木兰花 其一 斋中微雨","author":"梁清标","text":"绿窗才启。\n雨过苔青阶似洗。\n咫尺烟霞。\n风动朱栏芍药花。\n梦回如醉。\n人语惊残鹦鹉睡。\n三径谁开。\n篱外多应二仲来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2674,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"减字木兰花 其二 冯庄看海棠","author":"梁清标","text":"垂杨别馆。\n矗矗高楼当翠巘。\n草绿闲阶。\n蛱蝶寻芳自往来。\n主人何处。\n客醉金卮愁日暮。\n燕入谁家。\n落尽东风第一花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2675,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"减字木兰花 其三 立秋","author":"梁清标","text":"西风暗换。\n秋到碧梧金井畔。\n人立斜曛。\n望见家山一片云。\n香闺病后。\n小槛疏兰花影瘦。\n蟋蟀声催。\n似为多情宋玉来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2676,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"减字木兰花 其四 偶忆","author":"梁清标","text":"疏烟暮霭。\n人在斜阳秋草外。\n梦绕天涯。\n知是当垆第几家。\n舞裙歌扇。\n犹忆遏云花底宴。\n楚客愁多。\n欲采芙蓉奈远何。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2677,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"减字木兰花 其五 雨后","author":"梁清标","text":"秋葵带露。\n红满窗纱蝉满树。\n不管闲愁。\n倚仗浮云度画楼。\n雨丝风片。\n消受新凉深小院。\n蝶过谁家。\n闲煞墙头野合花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2678,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"减字木兰花 其六 夕阳","author":"梁清标","text":"风吹禾黍。\n几阵潇潇山市雨。\n秋色三分。\n让与渔家水竹村。\n藓阶独立。\n万户声催双杵急。\n柳外寒塘。\n牛背归来正夕阳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2679,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"减字木兰花 其七 秋夜露坐","author":"梁清标","text":"秋宵凉乍。\n淡月疏星清露下。\n剪剪风来。\n茉莉当檐几枝开。\n竹篱绿满。\n往事追寻人已远。\n帘影霏微。\n叶底流萤自在飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2680,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"减字木兰花 其八 邯郸遣兴","author":"梁清标","text":"短檠孤馆。\n锦幄温存天际远。\n澹扫铅华。\n半在邯郸侠少家。\n多情耽误。\n一笑姻缘艰陌路。\n马上墙头。\n不见当时旧画楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2681,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"减字木兰花 其九 题画扇","author":"梁清标","text":"遥汀疏柳。\n画舫兰桡沙岸口。\n小坐篝灯。\n堤外青骢嘶未曾。\n黄昏有约。\n明月芦花无定着。\n茗碗香炉。\n十样蛮笺薛校书。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2682,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"好事近 归途","author":"梁清标","text":"草短马蹄轻，乱踏落红归去。\n遥指杏花村里，问酒家何处？\n一溪春水浸春寒，犹是来时路。\n闰月东风未老，天亦怜迟暮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2683,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"绣带子 闲意","author":"梁清标","text":"春色耐繁华。\n车幰碾晴沙。\n吹皱小桥池面，杨柳逐风斜。\n尘世几回嗟。\n齐分付、夜雨梨花。\n东家蝴蝶，却因何事，飞过西家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2684,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"谒金门·新浴 其一","author":"梁清标","text":"人新沐。\n波溅一枝寒玉。\n半著轻罗香馥馥。\n妆残重结束。\n桃簟凉生绣缛。\n小立漏声偏速。\n换緉鞋儿刚一掬。\n奈何郎又促。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2685,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"谒金门 其二 感怀","author":"梁清标","text":"春寂寂。\n鸿雁几行归北。\n谁道家山浑咫尺。\n层层云树碧。\n十载伤心泪滴。\n往事不堪重忆。\n欲扫旧愁新又积。\n风柔难借力。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2686,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"忆秦娥 其一 上谷怀古","author":"梁清标","text":"涛声咽。\n萧萧亭照金台月。\n金台月。\n千年易水，为谁寒热。\n狗屠燕市风流绝。\n荒田督亢飞残雪。\n飞残雪。\n悲风落日，今古销歇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2687,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"忆秦娥 其二 茉莉","author":"梁清标","text":"香风飏。\n黄昏院落花初放。\n花初放。\n银灯试照，别来无恙。\n美人奁镜偏宜傍。\n珠簪金络增新样。\n增新样。\n珊瑚枕畔，绿云鬟上。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2688,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"清平乐 西村","author":"梁清标","text":"场空禾黍。\n终岁田家苦。\n脱却朝衣耕瘠土。\n闲逐樵歌渔鼓。\n溪翁提挈儿孙。\n骑驴买醉前村。\n野外人家如画，柴扉灯火黄昏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2689,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洛阳春 元宵后雪","author":"梁清标","text":"才过传柑佳夕。\n晓窗飞雪。\n重重帘幕落梨花，总不碍、灯和月。\n潇洒柴门尘绝。\n又添春色。\n踏歌声罢灞桥诗，天未许、风光歇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2690,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"眉峰碧 春暮","author":"梁清标","text":"深院秋千罢。\n细雨梨花夜。\n晓起闲庭一片飞，忍又见、山桃谢。\n蛱蝶枝头挂。\n苦忆前春话。\n门外东风镜里颜，背人无语夕阳下。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2691,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"锦堂春 闺情","author":"梁清标","text":"绕砌试探芳信，捲帘放出香烟。\n小楼几阵廉纤雨，寒食杏花天。\n鸾镜羞窥瘦影，鸳衾愁里春眠。\n呢喃唤醒深闺梦，双燕到堂前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2692,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"海棠春 夜雨","author":"梁清标","text":"寂寥春院思千缕。\n陌上柳、新黄才吐。\n暝色入西楼，雁影沉南浦。\n黄昏灯火无情绪。\n遗梦到、家山犹阻。\n惆怅打梨花，点点飞窗雨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2693,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"山花子 春愁","author":"梁清标","text":"谩道春风不世情。\n愁中吹上鬓边星。\n归雁带来云外恨，断肠声。\n日暖平芜晴牧马，月明绮阁夜调笙。\n无限韶光多少泪，共谁评。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2694,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"百尺楼 题汪蛟门百尺梧桐阁图","author":"梁清标","text":"屋角碧阴浓，岩畔朱楼窅。\n摵摵西风一叶飞，闲倩奚童扫。\n捲幔茗烟沉，开径羊求到。\n手把残书岸帻吟，目送秋鸿小。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2695,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"罗敷媚 偶见","author":"梁清标","text":"春江艇子看人面，脸晕生霞。\n鬓影堆鸦。\n艳似孤村二月花。\n深藏生怕蜂窥见，懒扫铅华。\n悄映窗纱。\n借问当垆第几家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2696,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阮郎归 登楼酹月","author":"梁清标","text":"碧天无际近中秋。\n台高树影稠。\n雪儿一曲韵悠悠。\n箫声出画楼。\n银箭促，暮云流。\n娟娟月似钩。\n寒消酒力兴偏幽。\n佳人翠袖愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2697,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阳台梦 悼亡","author":"梁清标","text":"深秋院落房栊暮。\n倚栏细数经行处。\n浓香画幔挂珊瑚，锁疏烟薄雾。\n空阶风飒飒，吹散芳魂几缕。\n一帘灯火又昏钟，疼煞黄花雨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2698,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"更漏子 梦寤","author":"梁清标","text":"夜儿长，风儿细。\n吹入孤眠春思。\n青镜畔，玉楼中。\n枕函有路通。\n横空雁，黄昏雨。\n梦里不知客苦。\n情脉脉，意迟迟。\n迷离乍醒时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2699,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"眼儿媚 春昼","author":"梁清标","text":"日射晴窗静无哗。\n风袅柳枝斜。\n有人深院，凝妆独坐，门掩桃花。\n追思往日重回首，心事付啼鸦。\n隔墙笑语，却疑春色，只在邻家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2700,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋波媚 夏夜","author":"梁清标","text":"院落沉沉晚风清。\n蚱蜢送秋声。\n星明河汉，汗消残暑，夜露泠泠。\n昨宵几阵芭蕉雨，苔影上衣青。\n花香入座，高囗见月，疏牖飞萤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2701,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"醉乡春 十六夜","author":"梁清标","text":"院院烧灯何早。\n重把金樽倾倒。\n桂阙影，一分亏，碧海青天人老。\n红袖桥边微笑。\n点缀春风多少。\n银花合，玉珂鸣，歌楼万点星毬小。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2702,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"柳梢青 春日","author":"梁清标","text":"小雨才收。\n平沙细草，绿满西畴。\n柳眼青归，桃腮红晕，人倚高楼。\n家家绣幕帘钩。\n春不管、斜阳旅愁。\n罗绮风前，秋千影里，马上墙头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2703,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]