[{"title":"四关烈妇诗 其五","author":"屈大均","text":"天生意气在鸳鸯，锦翼那忧朔骑伤。\n一笑春风过白刃，不将颜色媚名王。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14307,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"四关烈妇诗 其六","author":"屈大均","text":"白杨利刃挟娥亲，奋欲诛雠不顾身。\n生母不能空死母，哭声应解动黄巾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14308,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梁烈妇 其一","author":"屈大均","text":"流黄织罢泪双流，笳鼓南来咽暮秋。\n梁氏自来多意气，为君还堕绿珠楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14309,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梁烈妇 其二","author":"屈大均","text":"乌鹊分飞一曲终，青陵台上信陵通。\n妾心自有扶桑日，杲杲光生大雨中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14310,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"黄烈女 其一","author":"屈大均","text":"芙蓉本是拒霜花，烨烨红妆带日华。\n强暴一朝来感帨，遂令贞玉委尘沙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14311,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"黄烈女 其二","author":"屈大均","text":"曾从越女学干将，电击星驰巧异常。\n力尽佳人惟一死，血花开作杜鹃香。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14312,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"某君年七十馀纳双妾赋以赠之 其一","author":"屈大均","text":"长生有术在香闺，方朔年年取小妻。\n白可鸳鸯成七十，莫教莲叶有东西。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14313,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"某君年七十馀纳双妾赋以赠之 其二","author":"屈大均","text":"张苍饮乳不曾迎，白首偏多素女师。\n一曲同摊双唱处，桃花红映古松姿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14314,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"某君年七十馀纳双妾赋以赠之 其三","author":"屈大均","text":"白头偏解爱芙蓉，两两鹓雏夹老龙。\n最似罗浮双玉女，钥朝青傍老人峰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14315,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送林木文还嘉兴 其一","author":"屈大均","text":"鸳鸯湖水连长水，宝带还如锦带长。\n玉乳秋梨应已熟，君归多摘带清霜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14316,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送林木文还嘉兴 其二","author":"屈大均","text":"野田黄雀及秋肥，稻蟹衔霜亦不稀。\n一棹镜香亭子外，白鸥惊见故人飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14317,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过定思族翁斫鲙作 其一","author":"屈大均","text":"水出鲜鳞作鲙宜，蛮姜蜜酒沃红肌。\n相遇一味鱼生足，不必重为鸡黍期。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14318,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过定思族翁斫鲙作 其二","author":"屈大均","text":"鲙成双蝶食如流，冬至鱼生绝胜秋。\n明岁方塘思佃取，养鱼经向范公求。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14319,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长思 其一","author":"屈大均","text":"压酒长思镇朔楼，钿筝低按小云州。\n樽前乱落鹅毛雪，半为天寒驻紫骝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14320,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长思 其二","author":"屈大均","text":"小猎长思雁代西，双穿紫兔在花泥。\n月斜不返胭脂马，共枕琵琶毳帐低。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14321,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长思 其三","author":"屈大均","text":"歇马长思金粟城，索郎甜美月中倾。\n荒鸡不解留人客，行到黄河天未明。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14322,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"果市 其一","author":"屈大均","text":"冬仲山城果市齐，香圞朱橘压林低。\n无钱亦得柑头饱，赌核赢来贱似泥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14323,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"果市 其二","author":"屈大均","text":"橘柚团团拂手长，玉盘堆满一冬香。\n苞珍最是炎方盛，不独枝圆作果箱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14324,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南粤闺辞","author":"屈大均","text":"香貂双覆锦衾齐，雨洒船窗梦戍西。\n潮水未曾生夜半，长鸣恨杀九真鸡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14325,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"弄雏轩作 其一","author":"屈大均","text":"左有香东右墨西，鸳鸯对对锦毛齐。\n白头乌母将乌子，百岁欢娱在玉闺。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14326,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"弄雏轩作 其二","author":"屈大均","text":"蛾眉遇眼不嫌长，多食梅花语笑香。\n云影太高宫髻样，月华全映墨花裳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14327,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"弄雏轩作 其三","author":"屈大均","text":"鸟渐多声到画檐，更馀蝴蝶细穿帘。\n晴催稚子开黄卷，暖课闺人写素缣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14328,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春水","author":"屈大均","text":"春水诸鱼啸子时，西江步步有渔师。\n雨多榕叶溪流塞，细拨文涟下钓丝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14329,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"有赠","author":"屈大均","text":"频将摺扇索诗篇，王逸多惭白练笺。\n知己谁如萧颖士，有人高出士夫前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14330,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"槿一花红白二色","author":"屈大均","text":"荣落须臾亦弄姿，白中一朵半胭脂。\n佳名爱老风流甚，清露花翁浣莫迟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14331,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"丈菊","author":"屈大均","text":"挺出东篱丈许长，越人争道女华王。\n霜英未易枝头掇，一一高含岁晏香。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14332,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏金陵曲中遗事 其一","author":"屈大均","text":"国初南院首皇州，官妓居连十四楼。\n手帕结成多姊妹，春盘笑为赏灯留。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14333,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏金陵曲中遗事 其二","author":"屈大均","text":"诏出金钱每赐酺，簪缨一一赴当垆。\n轻烟淡粉楼偏闹，占尽莺花绝代无。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14334,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏金陵曲中遗事 其三","author":"屈大均","text":"秦淮灯接凤凰台，胜会相将盒子开。\n未暮私将帘半捲，外人知道所欢来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14335,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏金陵曲中遗事 其四","author":"屈大均","text":"曲中女士爱藏书，寇四牙签尽不如。\n今瘦古肥争学帖，手抄还向晚妆馀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14336,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春草","author":"屈大均","text":"龙消香粉郁金油，掠鬓光同素面流。\n春草自来偏善舞，弓腰贴地解人愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14337,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"染衣","author":"屈大均","text":"水沈煎水染衣裙，生长香林饱众芬。\n东莞女儿香角好，笑他黄熟不堪焚。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14338,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠梦娃","author":"屈大均","text":"人从西子始称娃，再见娃嬴美可怀。\n梦里苕华光照室，英雄事业堕裙钗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14339,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"薄妆词 其一","author":"屈大均","text":"两颊初成酒晕时，桃花妆浅稍调脂。\n卿卿欲识春山好，五岳三峰尽在眉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14340,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"薄妆词 其二","author":"屈大均","text":"却月横烟十样眉，唐时尚阔有谁知。\n从郎索取生花笔，小按图经胜画师。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14341,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"示女明洙 其一","author":"屈大均","text":"小本家传女四书，可能笺注若华如。\n平生列女吾多传，要汝聪明记有馀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14342,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"示女明洙 其二","author":"屈大均","text":"班姬女诫马伦分，舂汲还乡学少君。\n汝亦汉儒南郡女，布裳椎髻扇清芬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14343,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寒塘曲","author":"屈大均","text":"共照寒塘秋潋滟，波心恨杀芙蓉占。\n生憎郎爱水中人，笑与芙蓉看不厌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14344,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"金凫曲","author":"屈大均","text":"雨声滴遍曲栏杆，灯灺香消梦未安。\n帐底金凫谁得似，无情偏暖有情寒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14345,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春山","author":"屈大均","text":"春山只在翠眉间，休向云门镜水攀。\n鬓影吹人香不已，羡他蝴蝶逐风还。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14346,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秀州曲 其一","author":"屈大均","text":"宝带长连锦带长，两条长水总牵肠。\n燕梢船上轻摇橹，不采侬莲到镜香。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14347,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秀州曲 其二","author":"屈大均","text":"燕来春笋似纤纤，细拨银筝向酒帘。\n一唱杨花人尽醉，阿侬情比月波甜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14348,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秀州曲 其三","author":"屈大均","text":"玉乳新梨软瓠犀，甜输朱橘洞庭西。\n秋来下酒宜黄雀，挟弹梅花何处溪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14349,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"知道 其一","author":"屈大均","text":"知道杨花爱作萍，故将飞絮搅空冥。\n依依却是无情甚，折尽枝条勿使青。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14350,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"知道 其二","author":"屈大均","text":"风花欲去向谁边，化作香泥色尚鲜。\n最是东君无力甚，难留一片画栏前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14351,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"木棉 其一","author":"屈大均","text":"春暖春寒二月天，祝融祠畔冶游偏。\n木棉花老频飘絮，如雪纷纷坠锦鞯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14352,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"木棉 其二","author":"屈大均","text":"朵朵开残口有绵，雪花飞满女郎前。\n织成白緤温柔甚，持与兰房作褥眠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14353,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"木棉 其三","author":"屈大均","text":"朵大堪持作酒杯，纷纷小凤药中胎。\n猩红染尽春毛羽，又向山丹树里来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14354,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"山丹","author":"屈大均","text":"处处珊瑚竞作丛，珊瑚不产海波中。\n无人识是珊瑚树，道是山丹与赩桐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14355,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"焚香曲七首 其一","author":"屈大均","text":"郎如朱火妾青烟，一气氛氲出玉煎。\n沉脑成灰应不惜，祗图香在梦魂边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14356,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"焚香曲七首 其二","author":"屈大均","text":"节为沉水花鸡舌，两种香含心字深。\n多谢博山垆器好，双烟不断至于今。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14357,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"焚香曲七首 其三","author":"屈大均","text":"烟积兰房郁作云，积雪成雨湿罗衾。\n无烦百宝兼千和，香在佳人一片心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14358,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"焚香曲七首 其四","author":"屈大均","text":"香夺琼南第一林，成栈不必待成沉。\n侬如熟结郎生结，一片芬馨直透心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14359,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"焚香曲七首 其五","author":"屈大均","text":"血格生煎胜降真，却嫌沉速味多辛。\n女儿香角尤恬静，非雾非烟一缕春。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14360,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"焚香曲七首 其六","author":"屈大均","text":"鸳鸯喷出篆烟来，细逐游丝转镜台。\n袅袅香魂微有影，不教兰麝即成灰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14361,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"焚香曲七首 其七","author":"屈大均","text":"辟邪凫藻两炉轻，被底香毬更有情。\n展转不离君玉体，房风遗制铸初成。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14362,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"越台新柳 其一","author":"屈大均","text":"新年柳叶已争开，绝似江南二月来。\n自是炎方天易暖，春光先到越王台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14363,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"越台新柳 其二","author":"屈大均","text":"濯濯风枝半作阴，新条不遣旧条侵。\n自来珠海多春色，垂柳垂杨亦系心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14364,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"越台新柳 其三","author":"屈大均","text":"百尺丝阴拂荔矶，吹绵未共木棉飞。\n玉山香浦攀枝外，新绿轻轻染翠微。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14365,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"越台新柳 其四","author":"屈大均","text":"未作鹅黄绿尚轻，垂丝一半拂春城。\n风流绝似灵和殿，不待条长已有情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14366,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"越台新柳 其五","author":"屈大均","text":"流乱轻丝不自持，依依最是嫩条时。\n春来几日犹无力，叶叶吹开未作眉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14367,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"越台新柳 其六","author":"屈大均","text":"掩映花田乍散风，几株抽翠已连空。\n行人莫向朝台折，留问班枝二月红。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14368,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"越台新柳 其七","author":"屈大均","text":"垂柳炎州自昔稀，几家新种未成围。\n江南江北无人处，黄鸟枝间正乱飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14369,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"越台新柳 其八","author":"屈大均","text":"舞杀东风绝可怜，思同人柳只多眠。\n汉宫一树风花乱，吹落昌华旧苑边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14370,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"越台新柳 其九","author":"屈大均","text":"同心同折一枝回，丝缕因风结复开。\n已苦春愁如雪乱，莫教花絮更飞来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14371,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"越台新柳 其十","author":"屈大均","text":"家住金陵复得无，白门杨柳可藏乌。\n汉宫眉黛三千绿，叶叶枝枝是画图。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14372,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"杨枝","author":"屈大均","text":"不唱杨枝唱竹枝，谁怜花泪碧离离。\n南梳北裹无心好，辜负春光绝丽时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14373,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"对瓶花作 其一","author":"屈大均","text":"日插名花三两枝，瓶中开落梦先知。\n酒中时有荼蘼片，香赖闺人拾不迟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14374,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"对瓶花作 其二","author":"屈大均","text":"十种花归一胆瓶，炉香不热有馀馨。\n鬟边未许人私戴，茉莉时分数朵青。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14375,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"方塘","author":"屈大均","text":"一丈方塘亦养鱼，水深不得种芙蕖。\n月光多作金波满，花影长含玉镜虚。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14376,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"黄塘棹歌","author":"屈大均","text":"一丈莲茎二丈花，枝枝高过钓鱼槎。\n莲花二丈穿莲叶，莲叶虽长不及花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14377,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"思乡水","author":"屈大均","text":"水亦思乡向故山，人流不似水流还。\n人流若似思乡水，那有离愁在世间。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14378,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"分水","author":"屈大均","text":"罗浮主客一泉分，泉影天边似白云。\n汤沐东西双瀑布，仙人谁似子期君。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14379,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"木棉 其一","author":"屈大均","text":"西江最是木棉多，夹岸珊瑚十万柯。\n又似烛龙衔十日，照人天半玉颜酡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14380,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"木棉 其二","author":"屈大均","text":"万朵随波似泛杯，浮沉又似水灯来。\n三江染尽桃花水，一道红泉划不开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14381,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]