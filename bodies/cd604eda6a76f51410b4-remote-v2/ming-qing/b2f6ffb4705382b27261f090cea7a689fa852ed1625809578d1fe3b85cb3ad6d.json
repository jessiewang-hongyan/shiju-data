[{"title":"木棉 其三","author":"屈大均","text":"木棉看与刺桐同，十丈花开接地红。\n朵朵中心含火凤，一春飞满祝融宫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14382,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题沈君小影","author":"屈大均","text":"形影陶公此亦真，羲皇以上更无人。\n科头不见三千丈，欲为君如漉酒巾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14383,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏李广 其一","author":"屈大均","text":"铁骑横穿万马分，大黄亲解左贤军。\n汉家飞将多猿臂，射虎天山箭没云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14384,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏李广 其二","author":"屈大均","text":"解鞍山下卧黄云，两翼从容百骑分。\n射杀匈奴白马将，生擒不少射雕群。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14385,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏李广 其三","author":"屈大均","text":"抱儿鞭马向南飞，射杀追车绝塞归。\n小队蓝田围猎罢，霸陵呵止不曾非。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14386,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏苏武 其一","author":"屈大均","text":"齧雪多年在寒沙，骆驼封上子卿家。\n牛羊多受阏氏赐，复有胡姬貌似花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14387,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏苏武 其二","author":"屈大均","text":"咽尽旃毛及雪花，羝羊未乳敢思家。\n紫貂蔘实真天赐，不使丁年鬓已华。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14388,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏苏武 其三","author":"屈大均","text":"牛羊多谢少卿妻，于靬穹庐赐亦齐。\n白首不愁归汉晚，丹青写出未央西。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14389,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏李陵 其一","author":"屈大均","text":"鞮汗山前落日催，三千剑客委黄埃。\n汉家都尉单于婿，左右阏氏起舞来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14390,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏李陵 其二","author":"屈大均","text":"战鼓无声夜半时，三军矢尽尺刀持。\n生降暂作裨王去，欲效曹柯汉不知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14391,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏李陵 其三","author":"屈大均","text":"一别河梁绝域分，报恩无复汉将军。\n悲歌未断丁零至，泪洒龙沙万里云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14392,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州北郊作 其一","author":"屈大均","text":"朝台秋草白茫茫，化作龙堆四十霜。\n鬼火不随风雨灭，光芒知是谷蠡王。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14393,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州北郊作 其二","author":"屈大均","text":"髑髅台畔几英雄，血作青燐四野中。\n鬼伯不惊魂魄毅，沙场往日共秦弓。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14394,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州北郊作 其三","author":"屈大均","text":"新开蒿里战场边，白草萋萋恨骨缠。\n烈士要离那有冢，伯鸾思葬素馨田。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14395,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州北郊作 其四","author":"屈大均","text":"五岭人头岭并高，名王猎火尽山毛。\n清明上巳争抛盏，十万蕃魂在白蒿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14396,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州北郊作 其五","author":"屈大均","text":"纷纷羌妇上坟来，人哭声连鬼哭哀。\n木叶山中魂望久，青燐肯向四楼回。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14397,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州北郊作 其六","author":"屈大均","text":"截将山势白云回，双作丁灵得胜台。\n南塞可怜成北塞，牧羝谁在黑龙堆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14398,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州北郊作 其七","author":"屈大均","text":"咫尺阴山接越台，夕阳吹角打围来。\n挥鞭乱渡韸韸水，驼背佳人满紫埃。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14399,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州北郊作 其八","author":"屈大均","text":"古道呼銮粤秀旁，牛羊气作野云黄。\n酪浆肉饭南边有，不记龙沙是故乡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14400,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"郎官湖","author":"屈大均","text":"有幸郎官得谪仙，湖名长在汉江边。\n诗成鹦鹉过黄鹤，绝代才华祗自怜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14401,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"苏武墓 其一","author":"屈大均","text":"古柏阴森绕夜台，枝枝只解向南开。\n麒麟阁上应图此，黛色参天雪窖来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14402,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"苏武墓 其二","author":"屈大均","text":"苍苍不改岁寒姿，绝似天山齧雪时。\n墓左株株皆祭酒，行人再拜不曾迟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14403,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蟹眼泉 其一","author":"屈大均","text":"佳泉蟹眼最知名，沙底冰寒映月明。\n活火烹宜林岕好，千瓶汲取遍佗城。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14404,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蟹眼泉 其二","author":"屈大均","text":"蟹眼双瓶只十钱，挑来大北白云边。\n一城争饮因甘冽，不道仙羊有别天。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14405,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舞草 其一","author":"屈大均","text":"大王楚歌歌莫哀，为妾楚舞一徘徊。\n舞影千年为舞草，报君意气向春开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14406,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舞草 其二","author":"屈大均","text":"血作杜鹃花已红，魂为舞草更摇风。\n美人骓马平生物，一笑天亡起帐中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14407,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"黄花 其一","author":"屈大均","text":"黄花十月似丹枫，岭外无霜亦变红。\n安得醇醪朝夕有，玉颜酡好与君同。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14408,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"黄花 其二","author":"屈大均","text":"贫家但有菊花妍，儿女金钱与玉钱。\n插满髻鬟兼作食，香含朵朵露华鲜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14409,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"辽东曲 其一","author":"屈大均","text":"不待秋深雪满衣，霜前一日雁南飞。\n边人争探青貂穴，妇女天寒亦打围。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14410,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"辽东曲 其二","author":"屈大均","text":"悽惶岭外即辽西，双角山连紫翠低。\n一代金汤山海在，无人关口更封泥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14411,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"辽东曲 其三","author":"屈大均","text":"武宁功烈在渝关，东锁秦城万里山。\n姜女祠前秋色暝，石人犹望藁砧还。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14412,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"樽前 其一","author":"屈大均","text":"樽前那得不清狂，白首无归只醉乡。\n岁月尽从荒宴过，岂知人世有羲皇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14413,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"樽前 其二","author":"屈大均","text":"掌中朝夕白椰杯，杯有黄花及早梅。\n酒尽不令高卧得，开门每望白衣来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14414,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"樽前 其三","author":"屈大均","text":"一钱羞涩浣花翁，处处金杯接未工。\n竹叶已倾瓢弃久，更无司业似苏公。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14415,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乞顾生写真 其一","author":"屈大均","text":"两世名家作画师，黄荃父子及徐熙。\n太仓顾氏今神妙，待诏金门有虎儿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14416,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乞顾生写真 其二","author":"屈大均","text":"三十重过好写真，不愁朱渐夺精神。\n尽君七尺吴淞绢，画取离骚一后身。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14417,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乞顾生写真 其三","author":"屈大均","text":"岩泉置我未为非，更写婵娟伴少微。\n吴氏当风高士带，曹家出水美人衣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14418,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乞顾生写真 其四","author":"屈大均","text":"春蚕乞吐笔端丝，焦墨痕中布色迟。\n又作吴装缣素上，维摩天女两花枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14419,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乞顾生写真 其五","author":"屈大均","text":"飞白轻云益有神，颊毫添取逼天真。\n长教居士传金粟，益使裴公作玉人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14420,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乞顾生写真 其六","author":"屈大均","text":"移入神气一毫端，汉有狂奴在素纨。\n异日桐江来物色，羊裘好与故人看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14421,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠友人制砚","author":"屈大均","text":"凤池研瓦墨成螺，书画皆圆晋法多。\n爱尔米家新制好，水岩真紫胜洮河。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14422,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题英上墨竹","author":"屈大均","text":"疏放枝枝意有馀，纵横下笔似颠书。\n风吹舞影生绡落，无数筼筜势不如。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14423,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题林氏画册 其一","author":"屈大均","text":"边鸾雀子赵昌花，一点丹青尽物华。\n更有滕王蝴蝶好，采春纷向写生家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14424,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题林氏画册 其二","author":"屈大均","text":"花总如生白不知，黄筌神妙让徐熙。\n绝怜点染惟丹粉，没骨图成多折枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14425,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题林氏画册 其三","author":"屈大均","text":"轻轻研吮即成春，物态氤氲总逼真。\n落墨图成徐渲染，胜他晕淡少风神。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14426,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题林氏画册 其四","author":"屈大均","text":"折枝一抹态横斜，随意纤秾乱点花。\n更取陈常飞白笔，参差树石写昌华。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14427,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题林氏画册 其五","author":"屈大均","text":"徐家花竹与禽鱼，士女江南尽不如。\n野逸绝胜黄富贵，曲眉丰脸六朝馀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14428,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"绯桃碧桃秋开承黄丈折赠二枝诗以答之","author":"屈大均","text":"朵朵秋光照角巾，桃开多为白头人。\n红绯白碧持相媚，不使黄花不见春。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14429,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"子规","author":"屈大均","text":"山茶花落子规啼，呜咽春当谢女闺。\n豹汝无情教客去，竹枝驱向锦城西。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14430,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"顾生以画朱竹见贻口占答之 其一","author":"屈大均","text":"朱竹胜于墨竹多，人言竹醉亦颜酡。\n筼筜忽与枫林似，叶叶红如霜染何。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14431,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"顾生以画朱竹见贻口占答之 其二","author":"屈大均","text":"太赤枝枝似彼姝，琅玕欲报玉盘无。\n新词可当襜褕否，更乞徐熙没骨图。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14432,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"听陈生松言琴 其一","author":"屈大均","text":"琴声绝似松言语，君把松声尽入琴。\n天籁最多惟五鬣，微风亦复响萧森。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14433,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"听陈生松言琴 其二","author":"屈大均","text":"家贫亦有数瑶琴，儿女能知山水音。\n况有松声来万壑，何人不道似空林。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14434,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"黄村","author":"屈大均","text":"黄村十里接朱村，尽种梅花作果园。\n花发纷纷来翠羽，啾嘈日与美人言。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14435,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"频果乾 其一","author":"屈大均","text":"京师频果与花红，作脯南来笑土风。\n不问花红问频果，鲜时香味可相同。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14436,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"频果乾 其二","author":"屈大均","text":"频果甜于沙果多，相思原不是频婆。\n乾来说是林檎脯，越客传看咥笑多。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14437,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"频果乾 其三","author":"屈大均","text":"上林频果最称珍，夏熟樱桃共荐新。\n作脯不教南客识，玉盘争取更贻人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14438,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将上惠阳舟中望罗浮即事呈王太守 其一","author":"屈大均","text":"疍家无数石湾前，欲买三篷恨少钱。\n扁水航船鱼蟹客，殷勤分得一舱眠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14439,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将上惠阳舟中望罗浮即事呈王太守 其二","author":"屈大均","text":"江水冬来细作渠，绝愁乾到宝潭墟。\n四更上缆乘寒月，行到天明十里馀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14440,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将上惠阳舟中望罗浮即事呈王太守 其三","author":"屈大均","text":"江边罗浮上惠阳，绝胜九面见衡湘。\n半天空翠如阴雨，一路秋光出夕阳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14441,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将上惠阳舟中望罗浮即事呈王太守 其四","author":"屈大均","text":"东江曲曲向西流，浅水平沙处处洲。\n枉挂蒲帆风未便，罗浮三日似黄牛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14442,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将上惠阳舟中望罗浮即事呈王太守 其五","author":"屈大均","text":"广州下不见罗浮，不见罗浮上惠州。\n广惠中间峰四百，与君分取入书楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14443,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将上惠阳舟中望罗浮即事呈王太守 其六","author":"屈大均","text":"牵上榕城水渐高，葫芦山截苦波涛。\n冬乾不满二三尺，撑折弯弯无数篙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14444,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将上惠阳舟中望罗浮即事呈王太守 其七","author":"屈大均","text":"招手终年倚郡楼，丰湖一到解离愁。\n山如浮碇连双岳，江似鹅城合一流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14445,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将上惠阳舟中望罗浮即事呈王太守 其八","author":"屈大均","text":"罗浮敌体似夫妻，离合时时影不齐。\n瀑水中分烟雨外，浮东忽似在罗西。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14446,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将上惠阳舟中望罗浮即事呈王太守 其九","author":"屈大均","text":"生憎四百玉芙蓉，朵朵欺人冰雪容。\n玉女峰娟吾不爱，白头只爱老人峰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14447,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将上惠阳舟中望罗浮即事呈王太守 其十","author":"屈大均","text":"一日罗浮属使君，洞天开辟即功勋。\n定知白玉仙师阁，朝夕名香要我焚。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14448,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将上惠阳舟中望罗浮即事呈王太守 其十一","author":"屈大均","text":"白头家有鲍姑存，更喜苏耽子又孙。\n欲共市门梅氏女，梅花多种复成村。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14449,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将上惠阳舟中望罗浮即事呈王太守 其十二","author":"屈大均","text":"使君诗作万松涛，喷薄罗浮雨势高。\n九十九条成瀑布，随风欲剪一并刀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14450,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将上惠阳舟中望罗浮即事呈王太守 其十三","author":"屈大均","text":"飞云顶路使君开，子日亭临见日台。\n东岱日观那有此，曜灵先为曜真来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14451,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"胥江过玉镜台感赋 其一","author":"屈大均","text":"忆共兰舟故里还，蛾眉画出是秦山。\n菱花已殉黄泉去，玉镜荒台忍重攀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14452,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"胥江过玉镜台感赋 其二","author":"屈大均","text":"宝镜销沉二十年，画图空想旧婵娟。\n犹香叆叇瑶姬雨，已化霏微小玉烟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14453,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"青溪","author":"屈大均","text":"小姑名字擅青溪，桃叶风流渡口迷。\n六代祗馀儿女事，不胜金粉景阳西。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14454,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"七夕词 其一","author":"屈大均","text":"天帝金钱货不还，二灵长隔绛河间。\n终年织锦成何用，泪洒支机石尽斑。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14455,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]