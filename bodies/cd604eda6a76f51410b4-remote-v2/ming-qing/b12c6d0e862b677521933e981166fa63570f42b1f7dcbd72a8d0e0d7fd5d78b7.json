[{"title":"浪淘沙","author":"钱继章","text":"云意压山尖，故故相黏，绕篱败叶夜重添。\n不见黄花开一点，孤负陶潜。\n闷坐了无欢，旧恨新拈，西风一霎卷茅檐。\n欲买秋光无计可，笑拾榆钱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":342,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"谒金门","author":"钱继章","text":"斜阳促，弥望暮烟修竹。\n弱柳堤边芳草屋，一汀云影簇。\n趁取晚凉新浴，碧槛薄垂冰谷。\n小院落花香断续，月明风簌簌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":343,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南歌子 秋思","author":"方大猷","text":"蓬鬓惊堆雪，衰容艳拒霜。\n莫持琼管弄清商，吹得万千林叶、一时黄。\n谁道春如剪，裁成百样芳。\n那知秋色是干将，天外群峰处处、割愁肠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":344,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"满庭芳 送友人还会稽","author":"黄周星","text":"新绿方浓，残红尽落，多情正自凝眸。\n不堪南浦，又复送归舟。\n便倩江郎作赋，也难写、别恨离愁。\n消魂久，斜阳芳草，天际水悠悠。\n问君何处去，若耶溪畔，宛委山头。\n有千岩竞秀，万壑争流。\n愧我江湖迹遍，到如今、仍坐书囚。\n迟君至，开襟散发，咏月醉南楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":345,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"应天长 春日田家乐","author":"周世臣","text":"溪南溪北桥横木，赖得行人影孤独。\n柳数围，传新绿，刚覆三间茆屋。\n床头栖野鹜，闲个篱边眠犊。\n黄土矮墙坚筑，安顿初添竹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":346,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蝶恋花 舟中有怀","author":"周世臣","text":"今夜相思有几许，又怕他宵，无计安排去。\n野岸萧萧芦自语，各天默默人无据。\n好事岂教长久聚，强把鸳俦，一霎分何处。\n睡眼朦胧多恶绪，披衣坐觑东方曙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":347,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"生查子 北平驿秋夜","author":"金俊明","text":"逼暝转深林，瑟瑟松涛沸。\n日落旅魂惊，嘶马停还未。\n灯萦独夜情，剑吼清秋气。\n凉月照无眠，应见征人泪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":348,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"忆秦娥","author":"方以智","text":"花如雪，东风夜扫苏堤月。\n苏堤月，香销南国，几回圆缺。\n钱塘江上潮声歇，江边杨柳谁攀折。\n谁攀折，西陵渡口，古今离别。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":349,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"忆少年 怨别","author":"朱一是","text":"沉沉永夜，阑干芍药，娇容沾雨。\n分明五更梦，也泪流如许。\n云水漫漫江北路，盼不到、客帆停处。\n鸳鸯渡边树，记郎从此去。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":350,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"二郎神 登燕子矶秋眺","author":"朱一是","text":"岷峨万里，见渺渺、水流东去。\n指远近关山，参差宫阙，起灭长空烟雾。\n南望沧溟天边影，辨不出、微茫尽处。\n叹三楚英雄，六朝王霸，消沉无数。\n从古。\n长江天堑，飞艎难渡。\n自玉树歌残，金莲舞罢，倏忽飞乌走免。\n燕子堂前，凤凰台畔，冷落丹枫白露。\n但坐看、狎鸥随浪，渔父扁舟朝暮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":351,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"踏莎行 园居","author":"钱棻","text":"万乘徒空，一丘壑足，小园但种千竿竹。\n苍阴深处掩高斋，黄鹂啼过山头屋。\n壁挂嵇琴，村疑阮曲，白云邀我同歌宿。\n幽花绕砌不知名，柴门秋水添新绿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":352,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浪淘沙","author":"王泰际","text":"高阁掩春残，香冷衾单，满城桃李尽朱颜。\n自分与花同福命，长是心关。\n道远寄书难，盼煞平安，多因身在翠微间。\n归看双鸾妆镜里，一样春山。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":353,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"踏莎行 施公村居九日","author":"沈龙","text":"水满江天，沿堤钓艇，空村客远风烟冷。\n丹枫消翠草堂开，天晴衬出重阳景。\n竹扫茶烟，鹤窥香鼎，芙蓉照面潮红醒。\n一痕淡月上峨眉，松台人散乌纱影。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":354,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"朝中措 平山堂和欧公韵","author":"归庄","text":"山连霄汉草连空，楼阁碧虚中。\n第五泉边试酌，飒然两腋生风。\n千秋胜概，残阳绿树，暮霭疏钟。\n非复当年栏槛，风流犹想仙翁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":355,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"清平乐","author":"沈谦","text":"罗带香罗曾寄。\n小凤盘云腻。\n要识春来腰更细。\n剩得许多垂地。\n玉钩移孔难寻。\n有时撚着沉吟。\n踪迹可知无定，两头都结同心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":356,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 忆旧","author":"沈谦","text":"绣领垂髫不解愁。\n小眉如画眼波秋。\n翠裙风定袅香毬。\n窗下悔棋曾握臂，帐前临镜强梳头。\n粉云今日障红楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":357,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"苏幕遮 立春","author":"沈谦","text":"树莺藏，兰雪拥。\n浪说春回，又被东君哄。\n面药口脂呵复冻。\n一样愁颦，便觉朝来重。\n负深盟，思好梦。\n懒簇酥山，花影帘钩控。\n此夜歌楼谁与共。\n火照堆鸦，胜里金人动。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":358,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"苏幕遮 闺病","author":"沈谦","text":"燕声娇，花影碎。\n日过窗西，犹自厌厌睡。\n一线情丝常似醉。\n九十春光，半拥鸳鸯被。\n靥销红，眉敛翠。\n便到沉身，总是多情泪。\n说与东风都不会。\n镜子裙儿，晓得人憔悴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":359,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹊桥仙 早梅","author":"沈谦","text":"粉痕微坼，檀痕尚浅，迤逦因香寻着。\n一枝偷采雪中春，敢燕莺、全然未觉。\n银瓶水暖，翠鬟手腻，又把软帘垂却。\n溪桥烟冷月初斜，怎消受、五更寒角。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":360,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"月笼沙　九日题南楼壁间","author":"沈谦","text":"帘外潺潺暮雨，江边隐隐寒潮。\n乱鸿缥缈寄书遥。\n满地黄花人病酒，蜂蝶空劳。\n自惜明珠离掌，谁怜小带垂腰。\n画楼西畔是虹桥。\n只恐粉云遮不断，怕杀登高。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":361,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"月笼沙 恨别","author":"沈谦","text":"悄嘱栏西执手，轻呼帐底沾胸。\n杨花漠漠水溶溶。\n隔水隔花看不见，恨杀银骢。\n旅店催将鞍卸，孤衾尚觉香浓。\n晓莺啼过玉楼空。\n料得那人眠未稳，斜靠薰笼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":362,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"东风无力 南楼春望","author":"沈谦","text":"翠密红疏，节候乍过寒食。\n燕冲帘，莺睨树，东风无力。\n正斜阳楼上独凭阑，万里春愁直。\n情思恹恹，纵写遍新诗，难寄归鸿双翼。\n玉簪恩，金钿约，竟无消息。\n但蒙天卷地是杨花，不辨江南北。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":363,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"满江红　　咏柳","author":"沈谦","text":"几个莺梭，早织就、千丝万缕。\n最苦是、苏堤欲晓，灞桥将暮。\n媚眼未醒开又合，纤腰半倒扶难住。\n重沉沉、搭在玉栏杆，和烟雨。\n还记得、长亭路。\n曾折送，行人去。\n恁牵缠似我，别时情绪。\n帘暗梦回应有泪，楼高目断浑无语。\n隔青山、不见紫骝归，蒙天絮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":364,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜迁莺•寄俞生士彪","author":"沈谦","text":"水鸠鸣屋。\n见春阴不散，渐飞霢霂。\n小燕初来，閒花又落，故把馀香频蹴。\n烟迷半林深翠，风剪一池轻縠。\n忆旧岁，正此时相见，掌杯盈绿。\n幽独。\n衰更甚，云拥乱山，咫尺欢难续。\n王粲情多，江淹才尽，晚节真成碌碌。\n途穷笑吾增恸，雅奏须君终曲。\n春难待，怕南城握手，樱桃将熟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":365,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"一萼红•春日东园","author":"沈谦","text":"漫窥帘。\n爱桃花万树，新雨拆红缄。\n近水无言，随风有恨，欹斜直恁娇憨。\n栖不稳、画梁双燕，为营巢、终日语呢喃。\n似喜仍忧，乍暄还冷，情绪恹恹。\n尽道西郊堪赏，便倡条冶叶，谁再沾粘。\n泪岂因花，病非中酒，羞称宋玉江淹。\n受尽孤眠况味，眠又起，真欲似春蚕。\n忽见隔楼山影，想杀眉尖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":366,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"踏莎行","author":"李标","text":"砚点飞花，檐沾弱絮，炉烟小误湘帘暮。\n春风不解动人情，人情怕送春归去。\n细草粘天、斜阳挂树，天涯离别人何处。\n休休莫更倚危栏，远山正是愁人路。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":367,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"金明池 金陵怀古","author":"魏允楠","text":"燕子矶边，凤凰山上，又是狂风骤雨。\n金砌玉阶何处问，尽燕麦兔葵满路。\n问秦淮、桂楫兰桡，却只是、衰草垂垂将暮。\n叹绛阙蛛萦，纱窗尘渍，一片晚鸦来去。\n想王谢风流何处？\n便紫燕黄莺，一时无主。\n看当日、词臣狎客，空剩得、白杨黄土。\n最伤心、景物三春，教苑里蛙声、公私相诉。\n但渡口寒烟，亭中皓月，兀自依依芳树。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":368,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"满江红","author":"胡介","text":"走马归来，西陵下、斜阳满树。\n回首处、酒垆犹在，河山非故。\n久客不知家远近，重来却怪人惊顾。\n听啼鹃、也道不如归，归何处。\n草玄阁，兰台署；扬州梦，秦淮渡。\n走人间未遍，苍凉日暮。\n惆怅辽东丁令鹤，当年华表谁为主。\n但相逢、莫负故人心，三生路。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":369,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浪淘沙","author":"俞汝言","text":"芳草遍天涯，几引流霞，小楼宛转暮云遮。\n记得当时歌舞地，眷柳怜花。\n归路一鞭斜，断送年华，红阑几曲碧窗纱。\n酒醒更残灯又灺，梦落谁家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":370,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙","author":"李炜","text":"修竹天寒倚翠娥，鸳鸯霜重雁声过。\n更长无寐倚云和。\n桃叶渡头频问信，石尤江上怨风波。\n人生憔悴是情多。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":371,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南乡子 感怀","author":"李炜","text":"谈笑解吴钩，客满西园花满洲。\n记得河桥分手路，悠悠，哀笛山阳几度秋。\n洒落向神州，极浦遥天不尽愁。\n花月春江浑是梦，休休，老作人间马少游。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":372,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"水龙吟 落花","author":"王翃","text":"春阳恰照空园，晓莺啼倦残红冷。\n芳魂无据，冰帘斜扑，乱抛芳径。\n力弱丝游，心疏蝶过，召还烟景。\n问余春未远，悠扬何事，依然就，风中影。\n门外晚寒犹逞。\n正无聊、断肠人醒。\n新巢燕子，衔来尚湿，小楼初暝。\n露重晨留，泥香夜葬，沾衣微省。\n更一溪、暗水吹成罨画，绣萍千顷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":373,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 红桥即事","author":"杜浚","text":"曲曲红桥涨碧流，荷花荷叶几经秋。\n谁翻水调唱凉州。\n更欲放船何处去，平山堂下古今愁。\n不如歌笑十三楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":374,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"风中柳 春晓","author":"纪映钟","text":"春尽荒城，白水溶溶一片。\n小桥横、绿杨如线。\n幽禽罢浴，相唤平沙软。\n昼偏长、凭阑人倦。\n朱轮宝骑，尽与年光流转。\n问王孙、归期何晚。\n连山芳草，遮断天涯面。\n悄冥冥、珠帘频卷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":375,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"虞美人","author":"韩纯玉","text":"一帘花影春风夜，月到蔷薇架。\n绮疏一半晚犹开，只为画梁双燕、未归来。\n挑灯约莫黄昏过，犹自薰香坐。\n星河耿耿傍阑干。\n留取小窗相对、晚妆残。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":376,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙","author":"韩纯玉","text":"手卷虾须上玉钩，疏疏急雨下梧楸。\n韶光生怕付东流。\n红叶窗中无俗事，白云乡里有温柔。\n好留双鬓莫教秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":377,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 夏日访潘子见归舟作","author":"韩纯玉","text":"夹山一带山平远，湘溪问字归家晚。\n荷气晚来多，斜阳雨半蓑。\n吾生何所寄，泛宅浮家去。\n苕水碧于天，孤舟独往还。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":378,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"清平乐","author":"韩纯玉","text":"春来消息，早过三之一。\n乍暖余寒无气力，二十四番风急。\n日长花事相宜，只愁开到荼蘼。\n偶向晴窗弄墨，拈诗又是无题。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":379,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"小重山 和稼轩韵","author":"韩纯玉","text":"万顷玻璃水接空，雨蓑烟笠下、一渔翁。\n荷香断续柳西东，秋光好、两岸插芙蓉。\n十里水晶宫，有时随浪去、笑儿童。\n三秋几阵鲤鱼风，斜阳外、沉醉荻花中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":380,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"江城子","author":"韩纯玉","text":"眉峰烟锁未分明，过秦青，恨零星。\n一树樱桃、微雨梦难醒。\n月在当头杯在手，愁似海，总填平。\n春宵三五好心情，绕红亭，笑声盈。\n促席传觞、倚醉听搊筝。\n嫌煞铜壶银漏短，香灺烬，烛花横。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":381,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"意难忘 雨夜","author":"霍达","text":"雨颤风摇，正百花时候，夜截春梢。\n挑灯惊鼠梦，拭泪掩绞绡。\n钗钿冷、佩环遥，玉鉴远山消。\n更可怜、心香烬夜，幼子啼宵。\n当年携手游遨，似丁香思结，心展芭蕉。\n寻花才减绣，话雨暗添膏。\n思往事、付春潮，赚杀旧魂飘。\n誓今生、梦长睡短，暮暮朝朝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":382,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"满庭芳　满城惜别","author":"屈大均","text":"金粟堆边，冰蒲水畔，紫骝迢递迎来。\n月中惊见，光艳似云开。\n桑落沾唇半醉，将长笛，弄向秦台。\n天明去，挥鞭岸曲，愁杀渡人催。\n徘徊。\n空叹惜，桃花易嫁，凤子难媒。\n和香雨氤氲，飞作尘埃。\n坠井银瓶永绝，谁复取、仙液盈杯。\n应知尔，三春绣阁，幽寂委苍苔。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":383,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浪淘沙  春草","author":"屈大均","text":"嫩绿似罗裙。\n寸寸销魂。\n春心抽尽为王孙。\n不分东风吹渐老，色映黄昏。\n蝴蝶不留痕。\n飞过烟村。\n红藏几点落花魂。\n雨过苔边人不见，湿欲生云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":384,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"一落索","author":"屈大均","text":"杜宇催春从汝。\n莫催人去。\n人留即是好春留，更一任、风和雨。\n怕见游丝飞絮。\n为伊无主。\n落花争似泪花红，只滴在、分襟处。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":385,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"离亭燕","author":"屈大均","text":"渐到鹧鸪多处。\n愁作一天烟雨。\n芳草可怜千万里，长共夕阳无主。\n且莫返乡关，已有断魂飞去。\n云际片帆难驻。\n江上一竿谁许。\n空妒白鸥来复往，恁得分他毛羽。\n掩泪似春山，终日濛濛洲渚。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":386,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"调笑令　四首 其二","author":"屈大均","text":"芳草。\n芳草。\n生向江南太蚤。\n连天一片春愁。\n不管王孙泪流。\n流泪。\n流泪。\n点点桃花又坠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":387,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"江城梅花引","author":"屈大均","text":"黄花和我满头霜。\n怕重阳。\n又重阳。\n不分早梅，还与斗寒香。\n老去看花如雾里，被花恼，一枝枝，总断肠。\n断肠。\n断肠。\n苦参商。\n夜已长。\n天已凉。\n一叶一叶，落不尽、悲似潇湘。\n那得罗浮、清梦到兰房。\n明月笑人眠太早，飞去也，影徘徊，尚半床。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":388,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浪淘沙 新秋","author":"刘碧","text":"昨夜雨绵绵。\n寒涩灯烟。\n薄衾萧索不成眠。\n晓起床头看历日，换了秋天。\n绿叶尚新鲜。\n犹想争妍。\n教他知道也凄然。\n眼底韶光容易改，树且堪怜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":389,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长相思 寄于夫人","author":"瞿寄安","text":"朝含颦。\n暮含颦。\n风动疏帘疑是君。\n相思欲断魂。\n试罗裙。\n褪罗裙。\n鸳瓦霜飞病又新。\n天涯两地人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":390,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"捣练子 夜坐","author":"商景兰","text":"长相思，久离别。\n为谁憔悴凭谁说。\n卷帘贪看月明多，斜风恰打银釭灭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":391,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"渔歌子","author":"李玉照","text":"秋思萦怀懒赋诗。\n黄昏深院月来迟。\n人静处，漏残时。\n一片幽情祗自知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":392,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"满江红","author":"吴朏","text":"雨抹荷池，添艳了、闹红稠绿。\n更带着、牵鱼藻鉴，浮波凫玉。\n榴朵辞枝焚碧藓，蝉声送远翻新曲。\n向幽轩、一枕梦惊回，风敲竹。\n丝雨霁，轻凉足；残照短，纤红续。\n渐云遮津口，烟黏山麓。\n凉月照人心似水，此身拟向清虚蹴。\n记广寒、庭畔素衣中，曾相熟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":393,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"小重山 秋闺","author":"纪映淮","text":"萧瑟幽闺更漏长，庭前丛桂发、暗飘香。\n月明露白渐生凉，轻风起、时拂郁金裳。\n远雁一行行，相看还伫立、怯空房。\n幽怀几许总难量，兰缸灺、花影欲窥窗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":394,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"如梦令","author":"王毓贞","text":"月影被花摇碎。\n掩映隔帘红袂。\n倚醉殢春娇，狼藉满头珠翠。\n难记。\n难记。\n人在画屏秋水。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":395,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"桂殿秋","author":"曙光","text":"秦淮渡，碧波流，冷月斜明花外楼。\n仙人掌满金茎露，桂子香寒玉殿秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":396,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"醉花阴","author":"沙宛在","text":"翡翠楼头风几阵。\n断送残红尽。\n薄暮掩罗帏，睡鸭香寒，冷却沉檀印。\n梦回宝枕垂云鬓。\n愁压蛾弯损。\n窗外雨声疏，响入芭蕉，又是黄梅信。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":397,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"霜天晓角 卖花用竹山摘花韵","author":"彭孙贻","text":"睡起煎茶，听低声卖花。\n留住卖花人问，红杏下、是谁家。\n儿家，花肯赊，却怜花瘦些。\n花瘦关卿何事，且插朵、玉搔斜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":398,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寻芳草 和稼轩韵","author":"彭孙贻","text":"这里一双泪，却愁湿那厢儿被。\n被窝中忘却今夜里，上床时不曾睡。\n睡也没心情，搅恼杀雪狸窜戏。\n怎月儿不会人儿意，单照见阑干字。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":399,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]