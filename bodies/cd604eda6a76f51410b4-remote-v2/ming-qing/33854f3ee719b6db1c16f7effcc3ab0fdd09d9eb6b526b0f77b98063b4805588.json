[{"title":"晴步","author":"王夫之","text":"清韶陶始曙，凉润即新林。\n风定叶当影，云开岫出阴。\n遥禽如往日，近蝶有营心。\n四顾谁天损，行歌复自今。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1252,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"上湘旅兴 其一","author":"王夫之","text":"寒山犹半绿，浅日动浮光。\n习习江南暖，淫淫小雪长。\n杖藜随鸟度，涉涧有花香。\n不信间愁在，千峰一徜徉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1253,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"上湘旅兴 其二","author":"王夫之","text":"墟烟何处起，渡口己樵歌。\n空外篙音发，睛滩柏叶过。\n生平还草屦，世事尽藤蓑。\n惭愧元真子，清时畏绿波。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1254,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"上湘旅兴 其三","author":"王夫之","text":"一巘复千峰，参差万壑松。\n夕烟飞不定，落叶转相逢。\n古砦传银穴，仙坛记石封。\n金丹及铁马，吾意定奚从。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1255,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"上湘旅兴 其四","author":"王夫之","text":"柳阴谁竹外，几叶带疏黄。\n浴鹜动金绮，夕阳生暗塘。\n归人欢妇子，明发有风霜。\n居者忘情甚，萧条客感长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1256,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"上湘旅兴 其五","author":"王夫之","text":"山城犹百里，战伐不相知。\n禾黍经时毕，冠裳入望疑。\n微霜开驿路，落日返樵吹。\n回念巴邱北，银涛捲绣旗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1257,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟中上巳同须竹","author":"王夫之","text":"客思荡如何，心知令序过。\n韶吹先闰□，花信绪风和。\n瑶草从谁拾，落英念已多。\n盈盈双白鸟，著意浴清波。","collection":"明末清初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1258,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"伊山 其一","author":"王夫之","text":"心识回峦外，沿溪曲径深。\n云烟开绿亩，金碧动青林。\n香篆迎风入，钟声过鸟寻。\n萧清初觉好，风雨更幽岑。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1259,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"伊山 其二","author":"王夫之","text":"读书云外迹，梵刹劫前宫。\n蕴藉清歌日，萧条夕磬中。\n古今藏客泪，勋业寄真空。\n牛首虚天阙，何因卧懒融。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1260,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"衡山晓发 其一","author":"王夫之","text":"击汰迟枫浦，归心就翠微。\n江空双古岸，天小一双围。\n岳气云侵县，墟烟月掩扉。\n松杉回望里，一谷曙光飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1261,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"衡山晓发 其二","author":"王夫之","text":"绿润不知冬，岳云第几峰。\n身轻随白鸟，裾冷夹青松。\n江近前时棹，碑留故国封。\n渔樵知近远，目赏己从容。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1262,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"陈耳臣老矣新诗犹丽远寄题雪诸咏随意和之得四首 其一 初雪","author":"王夫之","text":"居然穿雨际，的的炫轻盈。\n高阁今相望，遥心一倍生。\n元云光渐曙，浅水影微萦。\n经岁含情待，天涯已赠琼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1263,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"陈耳臣老矣新诗犹丽远寄题雪诸咏随意和之得四首 其二 映雪","author":"王夫之","text":"息心寒夜永，无奈小窗何。\n恻恻情还定，胧胧影未讹。\n空涵西照合，月转北林多。\n坠玉惊幽响，知谁度薜萝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1264,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"陈耳臣老矣新诗犹丽远寄题雪诸咏随意和之得四首 其三 欲雪","author":"王夫之","text":"稍稍墟烟度，归禽尚一双。\n喧风柔落木，珠雨缓流淙。\n夕气先孤幌，云阴上半窗。\n县心清赏极，酒力未须降。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1265,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"陈耳臣老矣新诗犹丽远寄题雪诸咏随意和之得四首 其四 访雪","author":"王夫之","text":"弥望盈清回，还疑溪外踪。\n鸿飞昨日影，龙蛰几株松。\n曲曲忘前径，山山遂一容。\n扶筇谁早过，麇迹恰迎逢。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1266,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"东台山","author":"王夫之","text":"百里初见山，西晖客望闲。\n半峰明紫树，群岫倒苍湾。\n仙馆箫声歇，渔舟隔浦还。\n祝融知近远，清梦骛云间。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1267,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"草堂成","author":"王夫之","text":"归舟湘水北，伐木逮秋清。\n鹤馆松云剪，萍踪雪径成。\n南窗仍夕㬉，东岭迓春晴。\n萧瑟乾坤里，蓬茅亦太荣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1268,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"早起草堂寓目篱间牵牛花追忆懿庵","author":"王夫之","text":"秋色生空外，微晴始素晖。\n篱花深碧紫，风蔓小霏微。\n酒坐怀迎目，林轩怅启扉。\n故心犹宛尔，何事岁华违。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1269,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"新秋望章载谋二首 其一","author":"王夫之","text":"湘山犹曲曲，畴昔故天涯。\n偶合添离恨，轻分有后期。\n镫残知弈误，月上尽诗迟。\n芳草王孙在，闲愁付杖藜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1270,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"新秋望章载谋二首 其二","author":"王夫之","text":"干戈方万里，摇落又三秋。\n霜鬓久无据，云踪幸缓愁。\n周秦焚后字，荆楚赋中楼。\n郑重清波意，君无忘野谋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1271,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄徐蔚子","author":"王夫之","text":"黄鹄一癯仙，重逢腹巳便。\n檄从邛部草，诗授郑公笺。\n柯雨先徵梦，樵风恰满船。\n褚公池上月，珍重到秋圆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1272,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送载谋归吴淞二首 其一","author":"王夫之","text":"相逢及送别，都在落花时。\n霜雪添双鬓，兵戈共一枝。\n江湖空在望，天地尽堪疑。\n顾陆烦凭吊，吾生未有期。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1273,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送载谋归吴淞二首 其二","author":"王夫之","text":"马当湖水北，南望杳潇湘。\n陆海英雄踬，船山烟草荒。\n客台留蠹简，谒者恋幽芳。\n片石延陵字，他年待报章。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1274,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"闻圣功讣遽赋","author":"王夫之","text":"闲愁生死外，回首故人无。\n南望墟烟迥，西飞片鸟孤。\n藤花开独坐，萝月照霜须。\n泉下□□泪，艰难付钓徒。","collection":"明末清初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1275,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏菊答须竹","author":"王夫之","text":"选芳宜隐秀，经岁得秋情。\n苗浅春滋弱，心微露贮轻。\n啼莺无醒梦，飞絮谢思萦。\n雨浃浮光上，吹暄逸态呈。\n蠹憎痕屡剔，丝繫玉防倾。\n爱惜消长日，从容养静萌。\n荷风熏晚绿，蕉雾洒孤荣。\n叶叶容迟上，亭亭有独擎。\n艰难出畏景，珍重享西清。\n紫葆光初透，珠胎润巳滢。\n竹枝留上番，梅影剪疏横。\n专气邀金液，丰仁长玉婴。\n星榆方历历，云朵遂盈盈。\n土德先推王，冰心亦保贞。\n有时浴紫水，终不炫丹猩。\n香外幽难似，薰馀静不撄。\n肃然登鼻观，嗒尔偃心旌。\n龙腊痴谁妒，薝葡逸未平。\n霄空霜一色，天迥月三更。\n倦赏愁寒夕，邀欢暂晚晴。\n袂辞歧路把，目厌满堂成。\n桂酿聊孤酌，莼丝小佐羹。\n催开辞羯鼓，过访待缑笙。\n巳事开三径，端居爱九名。\n同床犹各梦，顾影易魂惊。\n身后从冰雪，魂归返日精。\n摧芳宁问落，涤月不辞烹。\n君意如相念，殷勤访夕英。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1276,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"青草湖风泊同须竹与黄生看远汀落雁","author":"王夫之","text":"荻芽沉绿影，汀际合晶光。\n摇识归鸿集，从知梦泽长。\n云移千点曙，风转一行将。\n凝立迷烟树，轻迁动夕阳。\n参差香尾乱，珍重羽衣凉。\n陈列龙沙白，书成太古苍。\n修眉涵镜曲，仙桂缀蟾光。\n沙起帘钩荡，洲平瑟柱张。\n涛惊聊静婉，野旷恣疏狂。\n酣寝云田腻，栖心蕙圃香。\n气矜三楚国，神带九秋霜。\n整翮聊烟水，回翔岂稻粱。\n浣纱人伫久，垂钓客情忘。\n悽怨依筠泪，闲愁托杜芳。\n经寒知柳色，访旧忆莲房。\n北望关云紫，西清落照黄。\n息机非倦止，清警正遥望。\n平展纹波縠，轻浮玉照肪。\n遥天开画苑，活谱写潇湘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1277,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"同唐须竹游馺阁岩","author":"王夫之","text":"昨日初收梅雨天，青空四幕碧光圆。\n微风引袂分溪草，断嶂当眉露岳莲。\n片石偶然留太古，同心无待问他年。\n斜晖已长青松影，尚惜苔茸映绿烟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1278,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"昭阳庵同须竹夜话云乘木叶秋波探五老之胜因便送之","author":"王夫之","text":"尽觉当年不易谈，披云蹑石意犹贪。\n袖图有迹传河画，血字无心锢井函。\n白日只今原不损，青山向后定谁堪。\n知君欲访匡庐瀑，摘去莲花池上参。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1279,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"不揆五十齿满懿庵见过留同芋岩小酌","author":"王夫之","text":"枫阴荻岸晚烟开，鹤膝逡巡践碧苔。\n隔岁相看颜似旧，衰年无据漏仍催。\n清宵疏雨喧梧叶，草阁归云腻竹胎。\n薄遣新欢消夙昔，临觞聊罢筑声哀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1280,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"偶望","author":"王夫之","text":"平田无那素光何，稻叶娟娟浸碧波。\n白鸟试飞疑远浦，元云微断影高柯。\n墟烟小困双湾树，砌叶全低一径莎。\n不碍小窗消午睡，炉烟孤袅绪风和。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1281,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"极丸老人书所示刘安礼诗垂寄情见乎词愚一往呐吃无以奉答聊次其韵述怀","author":"王夫之","text":"洪炉滴水试烹煎，穷措生涯有火传。\n哀雁频分弦上怨，冻蜂长惜纸中天。\n知恩不浅难忘此，别调相看更冁然。\n旧识五湖霜月好，寒梅春在野塘边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1282,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宿雪竹山同茹蘖大师夜话","author":"王夫之","text":"不知情在与无情，丈室挑灯魄自惊。\n海溅云飞千嶂断，烟笼雪压一枝轻。\n破船载月浮寒水，别路寻芳驻晚晴。\n自擭杨坟茎草绿，春归闲唱踏莎行。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1283,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"刘庶仙五十初度即席同唐须竹 其一","author":"王夫之","text":"未解平生因底事，华筵诗思不相通。\n逢君县弧聊莞笑，垂老临觞偶自容。\n竹塾午窗双总丱，梅花小阁一春风。\n童心几皱恒河水，何必襄城问小童。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1284,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"刘庶仙五十初度即席同唐须竹 其二","author":"王夫之","text":"半语逢人吞不得，于君烧烛耐春寒。\n年华毂运有如此，谱样翻新孰与看。\n但祝羲和留万转，长披黄袄到三竿。\n华山呼取坠驴客，共说当年行路难。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1285,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"闻极丸翁凶问不禁狂哭痛定辄吟二章 其一","author":"王夫之","text":"长夜悠悠二十年，流萤死焰烛高天。\n春浮梦里迷归鹤，败叶云中哭杜鹃。\n一线不留夕照影，孤虹应绕点苍烟。\n何人抱器归张楚，馀有南华内七篇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1286,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"闻极丸翁凶问不禁狂哭痛定辄吟二章 其二","author":"王夫之","text":"三年怀袖尺书深，文水东流隔楚浔。\n半岭斜阳双雪鬓，五湖烟水一霜林。\n远游留作他生赋，土室聊安后死心。\n恰恐相逢难下口，灵旗不杳寄空音。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1287,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"冬夕 其一","author":"王夫之","text":"夕风楮叶有清喧，片紫西收碧未圆。\n河汉依微倾北户，流霜容与润高天。\n寥寥空界魂孤往，鼎鼎长宵梦小年。\n欲与禁寒邀白鹤，齐州不耐暝横烟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1288,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"冬夕 其二","author":"王夫之","text":"天物何归剩碧虚，霜飙难挽日南车。\n哀弦短剑留魂梦，雪鬓雾花空赘馀。\n蚕妾报收双瓮酒，故人诺借满床书。\n不知哀乐将谁得，恻恻寒心逼岁除。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1289,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏雪 其一","author":"王夫之","text":"素绡幂岫浅黄通，倒影青冥一片浓。\n雁背皴含天阙景，鱼鳞云烈晚檐风。\n乾坤回合摇山泽，形魄孤清接混濛。\n回首少年心绪回，冲寒狂折野梅红。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1290,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏雪 其二","author":"王夫之","text":"霰外闲飞几片轻，回瞻平甸巳盈盈。\n梅趺出色翻红栗，草甲栖心映绿晶。\n云幕空轮千影转，风回池縠万双迎。\n南塘曲岸谁相待，不惜明珠百斛倾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1291,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏雪 其三","author":"王夫之","text":"皑光晨射凝脂肥，海日轮孤腻不飞。\n红药隐尖疑月冷，梨花摇梦想春晖。\n池云压顶团鱼阵，松粉铺翎散鹤衣。\n遥想玉峰辰似此，清寒应悔学仙飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1292,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏雪 其四","author":"王夫之","text":"清空无际奈寒何，万岫参差捲白波。\n人在冰轮迷海岸，天回平野倒云窝。\n松风吹咽笙三叠，槠叶微留碧半柯。\n不信人间有春日，桃花红雨点青莎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1293,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送蒙圣功暂还故山","author":"王夫之","text":"秋风淫淫吹我衣，送君言归君欲归。\n不知天地消偪侧，已觉江山忘是非。\n疏星照水方昨夜，凉日当襟返翠微。\n青山料理勿取次，留之待我慰调饥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1294,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"残雪 其一","author":"王夫之","text":"寒心肃肃拥孤清，断岸无心弄晚晴。\n旧恨半消随去雁，新欢难待到流莺。\n莎丛绿浅愁轻护，藓砌痕欹感易倾。\n夙昔南枝曾有约，不贪春早逐初英。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1295,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"残雪 其二","author":"王夫之","text":"珍重凋零劫后身，人间还遇可怜春。\n和霜和月犹前日，争柳争花非此辰。\n睥睨青天悲寂历，淹留丹巘赏嶙峋。\n双飞燕子来何暮，不见琼田万顷新。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1296,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"残雪 其三","author":"王夫之","text":"苍烟黄日久迷离，犹有墙东片月窥。\n身外江山还似旧，梦中蜂蝶尽相疑。\n东流彻夜银涛急，平甸矜春碧草欺。\n不识瑞香花落后，几人还赋玉楼诗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1297,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"残雪 其四","author":"王夫之","text":"回塘曲径偶相依，不拟春归尚未归。\n向后生缘随旦暮，当时心绪在霏微。\n珠胎含泪禁疏雨，玉骨凝寒傲夕晖。\n子夜轻冰聊邂逅，素心元不藉霜肥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1298,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长沙旅兴","author":"王夫之","text":"江上红芽始试春，乳莺调语正迎人。\n人閒韶日还相识，花下喧风已试新。\n鹤杖恰逢苔径软，渔舟初绕碧波匀。\n乘乘生事馀年在，随处桃花可问津。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1299,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"郡归书怀寄懿庵","author":"王夫之","text":"雨滞花残不解飞，此身无主更无依。\n乾坤何梦到清昼，生死难忘只翠微。\n捲幕棋终归燕缓，敲尊歌阕荐鱼肥。\n如君贫病真天上，莫惜清秋共钓矶。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1300,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"出郭赴李缓山之约桓伊山下遇雨","author":"王夫之","text":"葛衣疏透雨珠閒，习习轻风宿暑阑。\n白练半飞分木末，丹虹双绾擭云关。\n笛声恰在桓伊步，饭颗初逢杜甫山。\n珍重碧烟开玉镜，明宵何夕照双颜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1301,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"萍乡中秋同圣功对月","author":"王夫之","text":"白头还作他乡客，不负青天只月明。\n自笑渔樵非泛宅，聊听鸿雁有新声。\n晶瓶浸魄一双影，玉镜当心无限情。\n莫为银蟾增怅恨，孤清直上即瑶京。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1302,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春夕同章载谋看月","author":"王夫之","text":"草堂新筑延新月，夕望春烟散夕清。\n天地空轮原自昔，莺花流目不须惊。\n东风摇柳拖柔影，绿晕莎肥炫露明。\n莫拟华亭归鹤怨，湘山布谷未催耕。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1303,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"先秋一日作","author":"王夫之","text":"西峰半影逼天青，闪闪斜阳紫焰明。\n木末一丝云影渡，稻畦千绿水痕平。\n麟洲梦觉馀香雪，鹤发身轻忆凤笙。\n菡萏梧桐双在眼，他时摇落不须惊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1304,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"重登回雁峰","author":"王夫之","text":"碧树江烟小散愁，青鞋雪鬓又重游。\n朱甍如梦迷双岸，绿草当春覆一邱。\n纵酒华年凌石级，题诗夕雨认高楼。\n渔舟战鼓皆今日，惭愧乾坤一影浮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1305,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"遣怀","author":"王夫之","text":"求仙无诀问蓬壸，缥渺神山一片孤。\n溪水冰融随岸阔，天风霜起任桑枯。\n田畴死记庐龙塞，司马生惭瑞兽符。\n为问今宵寒夜月，照来还似旧时无。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1306,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乾坤极目不消愁生事峥嵘祗敝裘渔艇可容人钓雪故乡还似客登楼探梅的皪丹砂蒂问月殷勤白玉钩尽有风光相假借无妨孤棹试中流 其一","author":"王夫之","text":"青箬笠还在短墙，渔汀樵径尽披霜。\n明年春在柳仍絮，前夜雪深梅自香。\n天地龙蛇消一泪，河山乌鹊且孤翔。\n情知华顶酣眠客，蜕骨难留笑汴梁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1307,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乾坤极目不消愁生事峥嵘祗敝裘渔艇可容人钓雪故乡还似客登楼探梅的皪丹砂蒂问月殷勤白玉钩尽有风光相假借无妨孤棹试中流 其二","author":"王夫之","text":"人间口耳总无权，对影忘言且问天。\n刘宋科名原荏苒，苏张车马自喧阗。\n水沈香篆青烟细，海雾空轮赤日悬。\n匣有宝刀随老病，无劳堇土淬龙渊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1308,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"桐城余兼尊昔为青原侍者归素以来崎岖岭外相值见访为录前寄极丸老人诗仍次原韵赠之","author":"王夫之","text":"沙上鸿踪昔岁心，堞楼鹤语旧时林。\n已知罢钓能忘饵，何必登床更碎琴。\n月影偶留传雁字，秋声不断有蝉吟。\n閒愁杜口从君语，为受青原记莂深。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1309,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]