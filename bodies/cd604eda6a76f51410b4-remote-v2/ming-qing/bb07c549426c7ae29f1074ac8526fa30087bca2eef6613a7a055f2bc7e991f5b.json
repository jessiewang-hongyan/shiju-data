[{"title":"苍梧访太真绿珠遗迹","author":"邝露","text":"清溪曲曲抱仙源，锦石虚疑翠黛存。\n云里玉环妃子井，绿萝金谷懊侬村。\n霓裳倏散华清舞，玉篴难招博白魂。\n最是剑门秋雨后，落花如见坠楼恩。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5613,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"莫邪关楚望","author":"邝露","text":"九疑如黛楚天分，水绿三湘雁倒闻。\n春晓玉台开岳雪，月明银殿郁卿云。\n翠华想像湘君竹，龙御迢遥帝子坟。\n何处匏笙将凤曲，至今犹似咏南薰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5614,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"莫愁湖赠刘瞻甫","author":"邝露","text":"憔悴行吟落照时，莫愁湖上与君期。\n五噫一赋梅花国，三黜重逢柳士师。\n吴苑旧游淹越鸟，楚裳今雨浥江蓠。\n姑苏烟月长相待，萎绝芙蓉白露滋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5615,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吴楚倦游","author":"邝露","text":"隋宫访古惟衰柳，楚泽伤秋况落英。\n痛哭嗣宗千日醉，乱离王粲十年情。\n目穷沙界参龙象，手挽银河洗甲兵。\n五见梅花归未得，故园频有蟪蛄声。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5616,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"前归兴诗","author":"邝露","text":"去年书剑返咸阳，庐岳登高一望乡。\n不见秦城售赵璧，但闻丰狱弃干将。\n洪都蔓草牵衣带，大庾梅花笑客装。\n今日輶轩对奇字，一区尘满读书床。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5617,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后归兴诗","author":"邝露","text":"南北神州竟陆沉，六龙潜幸楚江阴。\n三河十上频炊玉，四壁无归尚典琴。\n蹈海肯容高士节，望乡终轸越人吟。\n台关倘拟封泥事，回首梅花塞草深。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5618,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"大参李如谷先生冢君侍御子木访予虎丘寺","author":"邝露","text":"驻节何劳问鹿群，虎丘残雪剑池云。\n落梅秋府传高唱，授简霜台接令闻。\n燕峤月明湖雁度，楚天人至澧兰芬。\n儒林家学尊刘向，千骑东方待使君。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5619,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"滁阳寇退李太仆晓湘有干城之功却寄","author":"邝露","text":"卧阁何劳借重臣，中都熊卫逐黄巾。\n环滁拟筑封鲸观，捍圉终怜数马人。\n洗甲雁嘶寒食雨，回铙莺咏落花尘。\n思君独步台城月，笑折金陵垂柳春。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5620,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送兴化赵使君奏绩神都","author":"邝露","text":"杨花初扑越溪船，莺啭南州雁北迁。\n繁露书成去淮海，凌云赋就入幽燕。\n行春草绿中牟雉，流水风清单父弦。\n莫学杨庄诵绵竹，雕虫空负子云玄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5621,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雁翅城","author":"邝露","text":"雁翅城边兰叶阴，绿琴传得凤凰心。\n风吹玉树悲纨扇，霜落刀环待藁砧。\n竹上泪凝湘水怨，盘中诗造蜀山深。\n何当更乞西王药，身在陈峒八桂林。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5622,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吴楚感秋 其一","author":"邝露","text":"莺啼一度一开花，梦远伤秋入鬓华。\n明月楚天遥过雁，白门吴树暝栖鸦。\n城高隔水霜砧捣，木落空楼戍鼓挝。\n轾浪放舟渔浦晚，盈盈碧汉接星槎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5623,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吴楚感秋 其二","author":"邝露","text":"西陵秣马走南天，梦草春县别路前。\n堤柳拂云青袅袅，岸花摇月白娟娟。\n鸡鸣远寺萧山雪，雁度寒城郢树烟。\n低岫一帘湘水绿，栖栖倦客思华年。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5624,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"都峤得苏楚臣书却寄","author":"邝露","text":"怀袖犹存白凤毫，木奴花发燕双高。\n铜龙水似牵肠线，玉马风如切梦刀。\n醉墨尚濡羊子练，枕痕仍在范生袍。\n何须三十悲蓬鬓，一夜思君有二毛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5625,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"盂兰盘玉山记游","author":"邝露","text":"翠竹黄花辇路菭，呼鸾人上粤王台。\n来禽果向檀郎掷，芍药词矜郑女裁。\n鹊驾定将斜汉合，蝶眉横对远山开。\n相思不结芝田袜，空负陈思八斗才。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5626,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"花田饯朱未央时余归自都中","author":"邝露","text":"一樽须尽素馨田，别路惟馀水共天。\n自爱梅花归庾峤，若随鸿雁向幽燕。\n长裾请拟邹枚后，五岳宁论婚嫁先。\n莫倚唾壶歌伏枥，酒酣为汝拂龙泉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5627,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吴于逵载酒偕粤中词人三十辈同集小斋","author":"邝露","text":"药圃坛西有敝庐，荜门深柳枉琼琚。\n顽民清世仍依邑，旧史名山不废书。\n衰鬓每悲黄叶改，落英宁放绿樽虚。\n狂来金涧探泉脉，欲控仙人锦鲤鱼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5628,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"山堂卧病孙宏先裹药来看","author":"邝露","text":"心知越绝无双士，目见孙郎有二毛。\n昭质未亏岚海瘴，辩才先发广陵涛。\n萧条有客探云水，寂寞何人问桔槔。\n君去荜门风自掩，碧菭黄叶梦魂劳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5629,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭素友一瓢","author":"邝露","text":"曾跨青驴就祝融，白云黄鹤许相从。\n徒闻饥虎凋单豹，不饵飞鱼死宁封。\n蕊柬菭荒金口诀，珠丘尘秘玉芙蓉。\n赤明枉陊长桑泪，云水繇来灭去踪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5630,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赤婴母 其一","author":"邝露","text":"冶服微言宫里稀，金栊香篆隐朱扉。\n摛文绝代还憎命，弱羽三年不假飞。\n陇首秋云淹远梦，芳洲春草吊斜晖。\n谁裁半幅江郎锦，会向华清换雪衣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5631,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赤婴母 其二","author":"邝露","text":"曾从文皇羽猎雄，凌歊袁谢擅江东。\n花边解语驰清禁，檐外钩香纫绮丛。\n乐府厌闻歌赤凤，衮衣何必尚华虫。\n彩豪自映輶轩笔，尽载方言入汉宫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5632,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赤婴母 其三","author":"邝露","text":"紫阳丹水玉真妃，凤节鸾骖碧落飞。\n花梦仙裾飘绿羽，杏檐宫语教乌衣。\n西川悟法藏珠塔，南内传经拥绛绯。\n闻说赤符今始见，上林朱雁尔同归。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5633,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赤婴母 其四","author":"邝露","text":"衔将贝叶课宫娃，广袖亲檠系臂纱。\n乡梦已飞琼岛树，羽衣犹阻赤城霞。\n蚕丛雪暗金桃实，鸟道烟横紫桂花。\n几向五云思矫翼，夕阳深处问归鸦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5634,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赤婴母 其五","author":"邝露","text":"落羽能言滞镐京，每逢宾雁不胜情。\n海棠弄粉辞香国，薜荔搴霞恋锦城。\n舞爱玉环低绛袖，歌怜樊素啭朱樱。\n珊瑚反挂空宫月，愁寂连昌自唤名。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5635,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赤婴母 其六","author":"邝露","text":"鹤禁铜蠡昼不扃，沉香烟底掣金铃。\n霞冠忽散葳蕤锁，莲舌轻弹般若经。\n五色卿云衣上覆，九重仙露酒初醒。\n年来花梦殊萧索，不见张华入内庭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5636,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赤婴母 其七","author":"邝露","text":"紫禁霓衣按六幺，温泉霜叶景同飘。\n映鸾冰镜朱华落，送雁宫云赤羽遥。\n袨服司花皆火浣，含香青草漫金貂。\n何因得冠虹蜺去，浪说文凰在绛霄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5637,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赤婴母 其八","author":"邝露","text":"花萼楼前酒半醺，江南璚树陇西云。\n九苞一借丹山羽，三使重颁紫诰文。\n桃叶唤愁莺睍睆，药房同梦蝶氤氲。\n上林供御多红豆，费尽相思不见君。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5638,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赤婴母 其九","author":"邝露","text":"不整衣冠类羽仙，饮霞如在赤明天。\n飞琼阆苑乘朱雾，小玉璇宫化紫烟。\n锦浪艳传迁客赋，翠华休问上皇年。\n文虹惊落吴江水，绣岭愁听蜀国弦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5639,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赤婴母 其十","author":"邝露","text":"学语俄惊上苑珍，紫烟衣绕画梁尘。\n千秋羁旅哀词客，一代文章巧弄人。\n襞就芙蓉终是怨，啄馀香稻未全贫。\n金绳咫尺通灵鹫，归向迦陵问色身。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5640,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赤婴母 其十一","author":"邝露","text":"妙舞曾居绛树前，刺桐花外赤栏边。\n还丹木客颜同驻，度曲金衣韵较偏。\n振翼乍回天后梦，引泉时灭祝融烟。\n文心慧业今何用，为报闺人舌尚存。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5641,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赤婴母 其十二","author":"邝露","text":"瑶姬天镜若为情，心怯隋堤御史旌。\n金锁不教留艳骨，琵琶何事更呼名。\n桃花扇底私红拂，绛缕封边失玉京。\n芗国不如归去好，断肠春在锦官城。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5642,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"水仙花","author":"邝露","text":"谁殿湘沅九畹芳，蕙兰凋尽撷嫣香。\n汉滨雪净明珰解，雒浦波微玉佩将。\n桂女霓衣纷月户，灵娥锦瑟寄穷桑。\n涂黄莫认梅花额，恐有瑶姬妒寿阳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5643,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"游飞来憩和光洞寻五色榴花率尔忘归","author":"邝露","text":"七十二峰相对奇，绿潭疏影湛涟漪。\n桂薰萧帝龙舒碣，竹采轩辕阮隃枝。\n梅信先春传庾峤，潮痕经宿落天池。\n酒酣偶失和光路，五色榴花不可知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5644,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送梁若木太史奉节还朝","author":"邝露","text":"太乙经秋驻赤霞，石渠开晓待皇华。\n龙墀捧日翔仙掌，鳌禁含香识汉槎。\n万里鹏溟遵六月，百蛮鸡诏散千家。\n明春傥借书云笔，臣里杨庄莫漫誇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5645,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"元日侍香山何夫子燕宝纶阁","author":"邝露","text":"平津东阁侍文雄，春转尧蓂一叶中。\n献岁醁醽开白兽，后车云水叶非熊。\n黄金未变千门柳，綵胜先驰五夜风。\n谁掌丝纶歌九德，凤池清露湿兰丛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5646,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"游圭峰偕故园诸弟","author":"邝露","text":"孤峰玄伫泗潸然，日落长熊万壑烟。\n绿护天荒南渡迹，玉台钟蠡建和年。\n泉香蕙若彯书带，坛靓松花覆讲筵。\n濒海昔闻邹鲁地，春风池草碧芊芊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5647,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寿郑元戎","author":"邝露","text":"半壁凌烟想画容，十年横海有奇封。\n蚩尤雾合逢玄女，白帝蛇分待赤松。\n虎旅九重归铁券，龟台三使下金墉。\n太平未献河汾策，谁勒徽猷紫殿钟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5648,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"立夏谢玄丘招游石涧寺与陈孟长醒宸二山人琴酌","author":"邝露","text":"翠屏千嶂湿寒萝，曲涧盘云待客过。\n紫竹僧扉清夏腊，绿天人语近秋河。\n厨邀曳鹭浮香积，钵引吟龙入笑歌。\n无限琴心寄流水，好凭诸谢覛羊何。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5649,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"客西林闻警柬何人止","author":"邝露","text":"客里流光阅九春，西山鸾鹤自为邻。\n卧同干木非藩魏，笑却新垣欲帝秦。\n内地弄兵皆赤子，隔河专阃半清人。\n龙蛇歌罢愁无赖，谁念飘零折角巾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5650,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"江门谒陈文恭白沙先生祠","author":"邝露","text":"楚云台接小匡庐，紫水归人赋卜居。\n鹤发尚披孺子服，羊裘终枉美人车。\n山连北户多藏豹，门对南溟有化鱼。\n碧玉楼前千仞雪，肯容狂简礼簪裾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5651,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠刘中秘怀默","author":"邝露","text":"浮海诸夷未定居，乘桴时过夕郎庐。\n兰台墨妙窥中秘，薇省文心逼子虚。\n凤诺昔传三殿诏，金泥长护九皇书。\n沉香浦外遥相忆，为驾琴高锦鲤鱼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5652,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吊厓","author":"邝露","text":"组练曾驱锦浪堆，中流弥识济川才。\n挥戈不返羲和御，入海空闻薤露哀。\n璧月玺浮天上下，鲲溟龙战水潆洄。\n扪萝已灭磨厓字，风雨年年长绿苔。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5653,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"演露堂成为何司寇文玉赋","author":"邝露","text":"露华西邸主恩浓，移得巫阳第几峰。\n司寇俸钱供鹤米，尚书赐履识僲踪。\n东山选胜开棋墅，玉版参禅促箭锋。\n闻道圣人新建极，北窗云起半从龙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5654,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"冈州重访陶昭辑昭美昆弟","author":"邝露","text":"赋才曾许擅机云，五色肝肠绝世氛。\n芳草绿时频寄梦，菊花黄后又寻君。\n开樽独剪尧年韭，怀古同探禹穴文。\n归去层城隔明月，岸松烟艇对秋分。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5655,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过冯槐门话旧","author":"邝露","text":"先朝遗事老冯唐，白发移家寄上方。\n看竹每过留客井，种松偏近读书床。\n鼎湖云去金瓯缺，瑶砌秋归玉树伤。\n今雨昔盐俱是梦，几宵禅月照空廊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5656,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"孤愤篇","author":"邝露","text":"谁握兵符驻六军，桥山龙去诀浮云。\n鲁连一笑无秦帝，燕鼎重归有乐君。\n南蔡真人初建极，玉门飞将独空群。\n闻鸡试问烹雌妇，十载牛衣望紫氛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5657,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"并蒂莲为何夫子赋","author":"邝露","text":"沧波太液昔曾闻，双萼朱衣紫逻分。\n合璧共承仙掌露，晚霞晴绽蕊宫云。\n香闺解刺熊罴筦，花梦遥通翡翠裙。\n谁擘巨灵开二华，青天削出不如君。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5658,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乙酉入都留别古冈诸同社","author":"邝露","text":"三月垂杨绿去津，黄鹂飞上柳塘春。\n中州岂借探丸客，上巳应逢捧剑人。\n王命论存知有汉，说难书在不干秦。\n悲歌且莫催离筑，暂醉兰亭曲水滨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5659,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"留别何夫子","author":"邝露","text":"猛士悲歌起大风，酒徒连夜入新丰。\n闻诗东阁虚陪鲤，奏伎长杨较射熊。\n前席少年方哭汉，后车元老待和戎。\n谁怜虎帐横经客，差戴儒冠误乃公。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5660,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"何夫子拜命元揆诗以趣装 其一","author":"邝露","text":"烨烨玄岩咏紫芝，蒲轮前队引非氂。\n七闽虎变雄三户，百粤鹰扬载六师。\n砌荚尚依唐日月，宫槐重睹汉威仪。\n十年辛苦调元老，窥见河清饮月氏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5661,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"何夫子拜命元揆诗以趣装 其二","author":"邝露","text":"樽俎先朝待折冲，师臣重咏旧车攻。\n两京玉辂传桴鼓，五铎金陵应栈钟。\n北阙渐看红日近，东山聊付白云封。\n艰虞早识兴王地，望断南阳五色龙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5662,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"何夫子拜命元揆诗以趣装 其三","author":"邝露","text":"帝赉傍求复旧京，中台星正紫微营。\n九天素女云中侍，万国黄舆日下平。\n棘水投纶苍兕啸，桐圭分土羽凰鸣。\n历阳沸井寻常见，唯问荥河几度清。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5663,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题肤功雅奏图 其一","author":"邝露","text":"一曲清歌送谢安，青云天上忆弹冠。\n千秋苜蓿归秦垒，九伐威仪肃汉官。\n涿鹿月连弓影合，卢龙霜落剑花寒。\n明时自笑终童老，欲请长缨愧羽翰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5664,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题肤功雅奏图 其二","author":"邝露","text":"几年投笔上皇都，谁识高阳旧酒徒。\n裂帛始通鸿雁塞，登楼今拜凤凰图。\n吹笳暗落胡人泪，牧马群空汉月孤。\n行矣莫忘黄石语，麒麟回首即江湖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5665,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题肤功雅奏图 其三","author":"邝露","text":"汉苑声华识弭貂，莺花吹送木兰桡。\n新携马骨雄燕市，旧赐龙泉挂斗杓。\n供帐夜悬南海月，谈锋春落大江潮。\n长杨况值誇胡日，绝漠何人更射雕。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5666,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题肤功雅奏图 其四","author":"邝露","text":"缙云缭绕入残春，客散津亭柳色新。\n衣布尚怜天下士，高歌谁是眼中人。\n商山豹雾依黄鹄，渭水渔竿起绿蘋。\n为报桃花莫相笑，金章元傍赤松身。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5667,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"失题","author":"邝露","text":"独寻春色上高台，草棘萧萧野岸隈。\n今日多情惟我到，无人解惜为谁开。\n平章风月诗千首，收拾云烟酒一杯。\n雪艳冰肌差澹泊，海天何处雁飞来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5668,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送朱光夜入越","author":"邝露","text":"访雪初从剡曲还，送君花发向庾关。\n回鸾旧逼秦斯篆，翔鹤仍归谢傅山。\n九辩逢秋悲放屈，五君怀古壮离颜。\n会稽孤月悬相待，庑下风流说此间。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5669,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠张穆之","author":"邝露","text":"西风落日悬高牙，张郎诗草名剑华。\n古来神物不易得，令我三复长咨嗟。\n嗟君隽手尚沉挚，文心粉绘俱游戏。\n畴昔穰苴蕴豹韬，不过孙阳写龙骥。\n君不见淮阴乞食寄漂母，伍员吹箫向吴市。\n古来英雄失路多如此，所以任公罢钓归沧州，灵药吾将从不死。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5670,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"古意","author":"邝露","text":"九月九日游东山，老僧不与深闭关。\n古松无事相与闻，只有鸣琴流水间。\n青山自高云满屋，春风似病景不足。\n道人游山亦何意，青松到门问所至。\n白云了了天地间，此中山景曾飞来。\n我闻薇垣独空秀，故山明月此时后。\n万转不动苍山高，云峰烟欲到清昼。\n故人西望黄鹤楼，使我□之独眉绉。\n君不见古人已没空青苔，我乎我乎今再来。","collection":"明末清初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5671,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"风幡堂答天和尚□□□禅人","author":"邝露","text":"水尽月还□，空摇幡不飞。\n自怜心转□，欲辨已忘机。","collection":"明末清初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5672,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]