[{"title":"菜 其五","author":"屈大均","text":"池塘风静水微波，野客朝朝负汲过。\n菡萏东西花叶满，茨菰十二子孙多。\n团团芋叶包青鲤，曲曲藤枝赶白鹅。\n更向浮田亲摘菜，不辞寒雨湿渔蓑。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11921,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菜 其六","author":"屈大均","text":"老向丘园道未非，一生精力在芝薇。\n两收香稻烧畲熟，三剪青葱壅土肥。\n引水花边声细细，留云树底影微微。\n新蔬亦可充甘旨，绣佛堂前未敢违。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11922,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菜 其七","author":"屈大均","text":"黄桑白柘绕蓬庐，每恨场师我不如。\n微菜春烹惟瓠叶，小鲜秋荐但鲈鱼。\n牛羊影乱天将暝，蟋蟀声寒岁欲除。\n閒学宪王图本草，赠人还有种葱书。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11923,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南海庙作 其一","author":"屈大均","text":"金银宫阙映朝暾，火帝南兼水帝尊。\n万里朝宗来百谷，中华形势尽三门。\n云开帆席洋船过，月出楼台海市屯。\n元气茫茫全化水，不知天外有渔村。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11924,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南海庙作 其二","author":"屈大均","text":"南越人祠尽祀融，章丘平处有行宫。\n三江水到扶胥大，万里天归涨海空。\n潮汐旧从狮口入，帆樯新与虎门通。\n天留一岛苍茫外，可惜田横事不终。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11925,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南海庙作 其三","author":"屈大均","text":"扶桑影逐海云过，蜃物春来变怪多。\n日暖羊城来士女，月明龙户有笙歌。\n家家水帝祠南海，岁岁天朝使暹罗。\n汉将神灵铜鼓在，风吹音响满沧波。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11926,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄怀王处士不庵","author":"屈大均","text":"苦忆君公白发长，墙东依旧水云乡。\n汉家男子惟垂钓，楚国骚人正采芳。\n匏叶浮沉难涉水，菊华甘苦总含霜。\n何人再拜还床下，知己凋零在白杨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11927,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"怀桂林","author":"屈大均","text":"太华儿孙在桂林，参天笋石总森森。\n东西柱向穿山出，左右江连峤水深。\n光禄堂前曾酌酒，伏波岩上复鸣琴。\n军书一卷留苔藓，他日思从洞口寻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11928,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭顾徵君宁人 其一","author":"屈大均","text":"幽燕久客似辽东，絮帽天寒苦朔风。\n飞兔有人还不帝，伏龙于尔独称公。\n白头无子遗书散，黄石多年故冢空。\n留得孝陵图记在，教人涕泪哭遗忠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11929,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭顾徵君宁人 其二","author":"屈大均","text":"昌平山水是天留，海岳朝宗此帝丘。\n一代无人知日月，诸陵有尔即春秋。\n书生得尽惟哀痛，故老难存苦白头。\n遗骨故应园下葬，年年天寿守松楸。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11930,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭顾徵君宁人 其三","author":"屈大均","text":"招魂不返恨天涯，旅榇空归葬海沙。\n楚国两龚长不食，淮阳一老久无家。\n苍松岁晚孤生苦，白鹭天寒两鬓华。\n闻道五经多注释，不知谁为作侯芭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11931,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭顾徵君宁人 其四","author":"屈大均","text":"登高忆共雁门间，北望京华洒泪还。\n白马小儿犹汉殿，青牛老子已秦关。\n河声不解消长恨，山色惟知老玉颜。\n耆旧只今零落尽，北邙松柏为君攀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11932,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"为惠阳魏少府寿","author":"屈大均","text":"司马停骖穗石边，丰湖未有主人贤。\n花中卧治兼三郡，海上行春又一天。\n浦爱沉香清有月，山怀象岭翠无烟。\n初冬已见南枝满，父老持将颂大年。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11933,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送典试刘工部","author":"屈大均","text":"旌节翩翩向北还，茱萸家在第三湾。\n才同白雁来炎海，又逐红梅出庾关。\n得士多于珠子树，怀人更在石公山。\n天寒尊酒能相送，亦有罗阳一白鹇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11934,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"木末亭 其一","author":"屈大均","text":"木末亭临万井中，遥遥正对孝陵宫。\n九原未肯成黄土，十族犹然吐白虹。\n自古以来无此死，教人不忍作愚忠。\n雨花台畔啼鹃满，血染蘼芜一片红。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11935,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"木末亭 其二","author":"屈大均","text":"想像忠魂在旧京，君臣自此益深情。\n佯狂岂是三仁志，哀痛犹传一代声。\n往日衣冠留木末，只今俎豆失江城。\n无多书种难留汝，恨绝兴王不爱名。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11936,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"感事 其一","author":"屈大均","text":"茫茫一岛是天留，父子经营作首丘。\n亮在自能存社稷，横来那得更王侯。\n君臣不肯归鱼腹，舟楫从教到石头。\n恨绝生降虚百战，桓文事业委东流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11937,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"感事 其二","author":"屈大均","text":"堂搆徒劳四十春，虚无宫阙有金银。\n乾坤不没凭孤屿，日月长存赖一人。\n事败自应同正命，时危那得作遗臣。\n三千尚可收馀烬，力为亡诸更破秦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11938,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"感事 其三","author":"屈大均","text":"神华缥缈蜃楼中，吐纳风涛有汉宫。\n一代波臣持日月，十年海外尽英雄。\n书王虚拟春秋事，窃帝难成割据功。\n五百岂关无死士，将军不欲令名终。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11939,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"感事 其四","author":"屈大均","text":"市井多年作隐沦，不须东海更逃秦。\n英雄自古元无主，华夏而今岂有人。\n憔悴空教渔父笑，佯狂合与酒徒亲。\n沧浪清绝无缨濯，散发风前重怆神。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11940,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"两粤督府祝嘏词 其一","author":"屈大均","text":"亚相宣威五岭来，东南天柱是崧台。\n和平自得康公寿，文武谁如吉甫才。\n去岁羚羊寒有雪，今年员屋暖多梅。\n嘉鱼又复期张仲，至日风光满玉杯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11941,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"两粤督府祝嘏词 其二","author":"屈大均","text":"崧台此日即崧高，乔岳精灵在节旄。\n炎海一边消瘴疠，越裳三载息波涛。\n雍容师保惟周礼，羽翼春秋有楚骚。\n棠下人多春酒献，巡行召伯不辞劳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11942,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"两粤督府祝嘏词 其三","author":"屈大均","text":"斧钺东临屡有年，蛮方人赖衮衣贤。\n不将南库归京阙，自作长城控海天。\n七朵芙蓉珠斗曲，一轮明镜玉台圆。\n无多香尉留州郡，尽沐清风岭峤边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11943,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"两粤督府祝嘏词 其四","author":"屈大均","text":"马上黄门鼓吹多，行边两上极牂牁。\n交人竞拜双铜柱，客宿长依一玉珂。\n幕府琴弹槃木曲，门生笛奏武溪歌。\n军中尽识投壶礼，宴乐公堂满太和。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11944,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠高第街邻人李叟","author":"屈大均","text":"高第南临珠水滨，堂开与尔作芳邻。\n东家御史称寒铁，西舍仙儒是抱真。\n诗笔每争烽火树，棋枰多就落花茵。\n书楼月色微明夜，相照须君太乙身。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11945,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"野菊 其一","author":"屈大均","text":"野菊丛丛委道傍，花虽细朵亦芬芳。\n朝分蔓草惟零露，暮得空林是夕阳。\n佳色恨无彭泽见，落英疑有大夫香。\n生来苦薏谁能识，欲寄幽人隔水乡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11946,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"野菊 其二","author":"屈大均","text":"重阳节后汝先寒，甘苦念霜满玉盘。\n岂必东篱方可采，未须南楚已堪餐。\n浮沉片片宜兰酒，黄白枝枝称箨冠。\n野外无人香更甚，移根休使近雕栏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11947,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"重至都虚观作 其一","author":"屈大均","text":"石势盘回下翠微，峰峰有瀑似烟霏。\n参差古木穿松出，掩映寒花间叶飞。\n白发休教毛女笑，黄冠好逐羽人归。\n仙坛岁久无香火，欲扫莓苔恐湿衣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11948,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"重至都虚观作 其二","author":"屈大均","text":"仙山镇日白云封，磴道依稀四百重。\n分去祗成双瀑布，合来元是一芙蓉。\n台边月作麻姑镜，洞口风为羽客钟。\n古观无人黄叶满，鹿麑行处有遗踪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11949,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"怀伟公","author":"屈大均","text":"岁暮怜君匹马轻，干人未免仗才名。\n三丧何处求蒿里，十口无归在穗城。\n处处山川含剑气，年年市井有箫声。\n艰难我亦频为客，白首栖迟尚未成。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11950,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过西村访蒲衣子作","author":"屈大均","text":"咫尺沙亭是故园，西村何必让南村。\n门生吹笛迎溪口，稚子舁篮出市门。\n翠羽最怜么凤小，苍鳞长识老龙尊。\n新诗一一忘忧物，不必兰房更树萱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11951,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"再赋老树篇为少参公寿","author":"屈大均","text":"两世甘棠大叶榕，城边望似一峰峰。\n康公父子多阴雨，太华儿孙亦地宗。\n春酒人争持大斗，岁星天使在南禺。\n依依衮绣东山下，歌舞公归怅莫从。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11952,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"闻观察公以暮春日与诸公为菖蒲涧之游赋此纪事并以为观察公寿","author":"屈大均","text":"天南三月即清和，宪使相将散玉珂。\n秦代仙人瑶舄在，尧时春韭紫茸多。\n光辉饮御惟鱼脍，披拂风流有女萝。\n闻道长生须九节，不妨采采濯清波。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11953,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟经晋康奉访州使君有作","author":"屈大均","text":"大小湘流绕讼庭，使君日对数峰青。\n西将锦石为天柱，北倚香山作玉屏。\n白鹿春行蒲媪地，嘉鱼冬脍大中亭。\n舟过欲识神明守，未忍扬帆入杳冥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11954,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"忠养堂书怀 其一","author":"屈大均","text":"无才不敢恨长贫，老大惟知与道亲。\n几杖高堂多古物，衣冠中土有遗人。\n碧梧早落过芳岁，黄菊迟开及好春。\n绕屋云山无路入，一家鸡犬自先秦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11955,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"忠养堂书怀 其二","author":"屈大均","text":"雨过山堂秋气新，书声日日接西邻。\n陶公纸笔争儿女，茅氏瓜蔬笑客人。\n缸底醇醪多日尽，镜中哀貌几时春。\n寻常古几当花隐，白首韩康有老亲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11956,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉和澹翁六叔父开春病起之作 其一","author":"屈大均","text":"花为春寒未海棠，犹馀梅过立春香。\n怜翁身入新年健，与我情同爱日长。\n吟处自能空海岳，酒中那得有彭殇。\n消除白发诗篇在，况有知音在草堂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11957,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉和澹翁六叔父开春病起之作 其二","author":"屈大均","text":"边屋云山尽玉屏，人间何处有沙亭。\n禾皆两熟香粳白，榕是千年细叶青。\n先祖旧栽长命树，曾孙频见老人星。\n丈人于我为诸父，抱瓮相将入杳冥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11958,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉和澹翁六叔父开春病起之作 其三","author":"屈大均","text":"多谢莺声送酒杯，一诗成似一花开。\n古稀已在羲皇上，难老还如稚子来。\n心共青兰春箭发，吟随白鸟暮声回。\n溪边正可垂生钓，作鲙相期向小台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11959,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉和澹翁六叔父开春病起之作 其四","author":"屈大均","text":"烟管峰峰枕海平，衡茅相接午鸡声。\n三闾子姓元南楚，二老衣冠是旧京。\n骚学自应推小父，人师未敢让诸兄。\n开春灯火丛家庙，列坐欢娱且慰情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11960,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉和澹翁六叔父开春病起之作 其五","author":"屈大均","text":"五岳归来一草庐，依依桑梓未离居。\n弟兄遗恨无三谢，父子追欢有二疏。\n石路乾时人引杖，花窗静处鸟窥书。\n从来养寿惟芝草，绮皓何人便不如。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11961,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉和澹翁六叔父开春病起之作 其六","author":"屈大均","text":"四百罗浮在枕边，一年春向一峰眠。\n梦为蝴蝶元非我，生作蜉蝣亦是仙。\n服食尽多真日月，经营终少幻山川。\n逍遥见说须无待，姑射神人本自然。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11962,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鸳鸯莲 其一","author":"屈大均","text":"雄白雌朱一朵中，鸳鸯共命恰相同。\n东家傅粉嫌全素，北地调脂爱半红。\n池满绝愁罗袜湿，月明频使玉壶空。\n田田叶里开无数，独尔双飞入蕊宫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11963,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鸳鸯莲 其二","author":"屈大均","text":"岂知花亦有鸳鸯，一朵中分两色香。\n半染朱霞为面貌，全裁白雪作衣裳。\n心含甘苦无双薏，蕊结氤氲总一房。\n世上芙蕖那有此，多疑雒女弄新妆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11964,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"紫兰","author":"屈大均","text":"小小春萌即作花，心中抽出紫茎斜。\n真同兰蕙为香祖，绝似潇湘带露华。\n深浅总分红翠色，芬芳长在美人家。\n凌朝摘去愁纤手，取向窗前傍绿纱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11965,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"花朝后一日同黎子及诸从兄弟小集澹翁家叔园林分赋","author":"屈大均","text":"九十春光一半中，吹寒昨日始东风。\n莺如娇女雏偏好，花似仙人老更红。\n大阮竹林留父子，先臣香草与童蒙。\n樽前不暇舒长啸，名饮风流且自雄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11966,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"独酌","author":"屈大均","text":"岁月无多叹逝川，七旬更待十三年。\n忘忧却在难忘处，学道还如未学前。\n黄鸟竹间催独酌，白鸥花下伴閒眠。\n藏书不少名山叶，儿女他时各一编。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11967,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赋赠番禺孔明府","author":"屈大均","text":"特简名贤向越台，素王苗裔鲁邦来。\n真知孝友能为政，自有神明不用才。\n泗水流添珠海满，尼山色映玉峰开。\n番禺自昔循良少，岂弟如公接上台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11968,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"丙寅春日承王大将军招同诸公雅集分得萧字","author":"屈大均","text":"花发桨单折简招，天香惊似雒阳飘。\n酒痕一一沾红药，棋势时时得紫貂。\n羽猎思随珠浦马，弓鸣忆贯玉门雕。\n自来高咏怜袁虎，谢尚风流岂玉箫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11969,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赋赠广州刘静庵太守","author":"屈大均","text":"十郡枢机是广州，公来贤冠九诸侯。\n江间再作沉香浦，洞口重开穗石楼。\n楚国辞华多雅颂，炎天文献少春秋。\n深凭玉尺加裁定，勿负殷勤一太丘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11970,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"红石榴 其一","author":"屈大均","text":"百叠裙裾染赩霞，仙人剪作此灵葩。\n光凝蝙蝠千年血，丹吐芙蓉万点砂。\n奇树旧分西海种，孤根元逐汉臣槎。\n珊瑚不敢言烽火，枝干何如朵朵花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11971,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"红石榴 其二","author":"屈大均","text":"光争龙烛是流晖，不夜名葩世所希。\n绛萼烧时云尽暖，丹须湿处露多肥。\n枝枝影为朱天出，朵朵香同赤帝归。\n更喜千房同一蒂，清泠不使玉浆微。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11972,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"红石榴 其三","author":"屈大均","text":"真疑夜火百枝然，晞采扶桑色正鲜。\n吐纳朱光成十日，芬披丹气作双烟。\n膏凝可酿扶南酒，裙绉堪留太液仙。\n千叶垂腴嫌太密，有时难见晓妆妍。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11973,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"红石榴 其四","author":"屈大均","text":"晔晔珊瑚映水宜，炎云沐浴更生姿。\n承风影拂河阳树，向日心倾若木枝。\n珠熟紫房开莫早，丹成朱火养休迟。\n不教纤手频来折，留烛兰堂欲暮时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11974,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"红石榴 其五","author":"屈大均","text":"丹若枝枝越女家，红争一朵髻边霞。\n煎成药饼须千叶，捣作香脂费几花。\n倾向玉盘新滴沥，移来金谷旧纷葩。\n水晶千子怜如一，浸液霜滋似露华。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11975,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"红石榴 其六","author":"屈大均","text":"并蒂分贻弄镜人，荧荧一瓣上丹唇。\n红华自得江郎颂，朱实谁誇石氏珍。\n奇丽总无山海别，馨香更为雪霜新。\n簪来玄髻如朝日，解化南威艳绝伦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11976,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"红石榴 其七","author":"屈大均","text":"才看绛采满繁茎，已望天浆一雪酲。\n烽燧每教人巧笑，冰霜难夺尔孤荣。\n朱房荐处蒲萄让，素粒开时小凤争。\n华实有谁能并丽，为君裁赋答奇生。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11977,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"红石榴 其八","author":"屈大均","text":"灼灼红牙大火含，玉颜酡为露华甘。\n施朱已似东家赤，染粉何须北地蓝。\n叶作香汤争午日，花为仙酝盛琼南。\n辟兵符子兼双朵，儿女纷纷角髻簪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11978,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"红石榴 其九","author":"屈大均","text":"结就金牙重压檐，摘来教且贮香奁。\n双房自得黄牛直，一实人争白马甜。\n夏吐已怜缃的满，秋开还爱绛须添。\n朝朝相对丹晖坐，扇暑风多不捲帘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11979,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"红石榴 其十","author":"屈大均","text":"重结重开一岁中，端阳节后未枝空。\n甘成玉液能疗渴，白就丹砂可养蒙。\n石虎苑中传子大，香炉峰上更花红。\n垂光九夏多炎德，吐尽精华为祝融。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11980,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]