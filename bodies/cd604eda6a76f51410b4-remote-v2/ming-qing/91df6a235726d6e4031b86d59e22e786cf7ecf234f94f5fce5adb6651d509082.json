[{"title":"五福丽中天  贺梁玉立司农生子次汪蛟门韵","author":"龚鼎孳","text":"三公府邸莺花绕，不数画眉京兆。\n东阁郎君，槐庭儿子，入手英啼初抱，都人欢笑。\n恰锁院词头，紫纶新草。\n宰相金仓，先判福德临门早。\n官事生来能了，陆倕王仲宝，年皆小。\n上苑春风，华堂文宴。\n朱履鬓朋齐到。\n黑头鼎鼐。\n鲁后周前，拜稽偏好。\n贞敏勋猷，贻谋天下少。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3389,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"风入松  遥知方虎电发燕市小饮","author":"龚鼎孳","text":"客心摇曳任西东。\n柳絮空中。\n争传紫陌青帘下，倩双鬟谱出欢侬。\n一阵催花梅雨，满帘消夏松风。\n五陵裘马，斗谁工，湖海相逢。\n唾壶击碎狂歌发，胜凄清，露滴新桐。\n寄语酒楼高李，论文吾欲过从。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3390,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"罗敷媚  朱酉君司马招集西郊冯氏园看海棠","author":"龚鼎孳","text":"今年又向花间醉，薄病深春。\n火齐才匀。\n恰是盈盈十五身。\n青苔过雨风帘定，天判芳辰。\n莺燕休嗔。\n白首看花更几人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3391,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蝶恋花  其一 和苍岩西樵阮亭蛟门饮荔裳园演剧","author":"龚鼎孳","text":"韦曲秾花铺绣缬。\n一派流莺。\n催到含桃节。\n人柳三眠春渐歇，池台处处飞香雪。\n红豆记歌频换阕。\n万事东风，不醉怜痴绝。\n欲去还留宵已彻。\n栖乌踏碎玲珑月。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3392,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蝶恋花  其二","author":"龚鼎孳","text":"铁拨鹍弦眉总缬。\n青史人豪，慷慨鸣奇节。\n啼鳺一声芳草歇。\n仰天孤愤何由雪。\n清泪樽前弹此阕。\n不待悲愁，春夜销魂绝。\n世事到头须了彻。\n琼楼正挂高寒月。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3393,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蝶恋花  其三 为韶九","author":"龚鼎孳","text":"春绊情丝千缕缬。\n梦里人来，乍暖轻寒节。\n何处玉骢曾小歇。\n海棠飘落胭脂雪。\n重倩红霞温旧阕。\n张绪风前，好是腰身绝。\n楼阁水明光四彻。\n罗衣影漾波心月。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3394,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蝶恋花  其四 为幼文","author":"龚鼎孳","text":"好句推敲江锦缬。\n珠泻泉流，不犯驺呵节。\n游冶五陵花事歇。\n竹枝行踏巴渝雪。\n人压场圃欢奏阕。\n衣带微宽，瘦到休文绝。\n惆怅黄鸡三唱彻。\n离云已暗关山月。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3395,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蝶恋花  其五 送韶九还广陵","author":"龚鼎孳","text":"红泪一巾心百缬。\n春尽才逢，刚过菖蒲节。\n懊恨子规啼不歇。\n生生催就双蓬雪。\n莫听阳关朝雨阕。\n禁得年年，肠为分携绝。\n芳草黏天难望彻。\n杏花人面杨州月。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3396,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蝶恋花  其六 代韶九闺情","author":"龚鼎孳","text":"彩线鸳鸯愁暗缬。\n花雨新添，水暖银塘节。\n燕子穿帘飞又歇。\n冰纨衬贴芙蓉雪。\n闷倚玉箫吹半阕。\n报道人归，喜极还嗔绝。\n别后心情明镜彻。\n日长挂到如眉月。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3397,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蝶恋花 其二","author":"龚鼎孳","text":"隋苑烟花罗绮缬。\n小别重圆，交代欢愁节。\n肠转车轮今始歇。\n梦回关塞沙如雪。\n为问逢场歌几阕。\n比并双蛾，画就谁娇绝。\n天欲为人须为彻。\n一生乞作团圞月。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3398,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹤冲天 题莼鲛小像，和葆馚原韵","author":"龚鼎孳","text":"西江晚渚。\n月白天青处。\n咏史记曾听，袁闳句。\n羡才华绣虎，却待诏金门住。\n退朝鹓鹭侣。\n黄绢新词，题遍楚兰吴苎。\n潘年未暮。\n肯放投竿去。\n禄米比侏儒、犹堪煮。\n染汉南柳色，有一片龙池雨。\n烟波余久许。\n尺幅霜绡，惹起鉴湖千绪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3399,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"贺新郎 和赠其年","author":"龚鼎孳","text":"津柳霜飙发。\n乍分手、骊驹一曲，凤凰双阙。\n黄菊丹枫犹在眼，休怅红亭吹雪。\n换几度、天涯圆月。\n酒醒梦回多少事，感萧萧、易水冲冠发。\n试脱颖，见其末。\n宝刀欲赠心先折。\n算今古、丰城龙剑，终为神物。\n一任椎埋与屠狗，浪诩烂羊魁杰。\n那更记、灰飞烟灭。\n此去夷门还郑重，有满怀、未老侯生血。\n更却扫，待三益。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3400,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"采桑　自度曲　不寐","author":"沈谦","text":"淡月明。\n孤灯背。\n梦难成。\n暗啮鸳鸯被。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3401,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"荷叶杯　春闷偶成","author":"沈谦","text":"都道春来愁闷。\n不信。\n日晚上危楼。\n落花飘尽水东流。\n愁摩愁。\n愁摩愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3402,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"望江南　元夜即事","author":"沈谦","text":"桥上月，终夕自凭栏。\n只怕粉云香阁闭，从教珠露碧衫寒。\n人道看灯山。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3403,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"望江南 晚思","author":"沈谦","text":"天已晚，还自怕登楼。\n山底淡云轻似梦，灯前寒雨细如愁。\n人问嫌抬头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3404,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"如梦令　送春","author":"沈谦","text":"病起忍将春送。\n弱草依花风动。\n犹自泥残莺，不唤春回何用。\n如梦。\n如梦。\n但觉翠颦增重。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3405,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"如梦令 佳人对镜","author":"沈谦","text":"曾共粉郎私语。\n独立从来自许。\n谁学远山青，两靥胭脂微注。\n回顾。\n回顾。\n错把镜中人妒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3406,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长相思","author":"沈谦","text":"人初静。\n风偏横。\n落叶秋窗眠不定。\n一床浑是病。\n愁魂冷。\n悲啼凝。\n瘦得新来羞对镜。\n对时心要硬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3407,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇　夏日闺情","author":"沈谦","text":"小院无人，罗窗玉枕清如水。\n鬓横钗坠。\n汗透酥胸腻。\n疏雨凄风，翠竹琅玕碎。\n俄惊起。\n定晴斜睨。\n寂寂帘垂地。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3408,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇 美人耳","author":"沈谦","text":"巧鬓轻笼，月痕半吐真珠莹。\n惺憽不定。\n莺语俄惊醒。\n蓦地心烦，唤着何曾应。\n提名姓。\n不教安静。\n难道真真冷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3409,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇 美人鼻","author":"沈谦","text":"篆袅金猊，妆成独坐怜清昼。\n下阶闲走。\n自摘青梅嗅。\n信断音沉，嚏是何人咒。\n分离久。\n总因谗口。\n教掩春衫袖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3410,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇 美人肩","author":"沈谦","text":"忆昔垂髫，削成软衬香云拥。\n玉楼春冻。\n倚处秾纤中。\n私语阑干，回首真如梦。\n相思横。\n强挨不动，担有千斤重。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3411,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇 美人颈","author":"沈谦","text":"捏粉搓香，烟鬟斜亸蝤蛴嫩。\n绣床垂顿。\n半为东风困。\n不许轻搂，意拗心原顺。\n低声问。\n齿痕偷印。\n又道多情狠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3412,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇 秋病","author":"沈谦","text":"起了还眠，须知不是侬贪懒。\n银筝象板，听着惟长叹。\n闻道新来，你也梳头慢。\n乌云散。\n不茶不饭。\n人瘦黄花绽。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3413,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇 寒夜不寐","author":"沈谦","text":"玉漏迢迢，听来却是三更绝。\n枕儿难贴。\n今夜何曾热。\n乱打西窗，冷雨都成雪。\n和谁说。\n孤灯明灭。\n暗把鸳衾齧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3414,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇 孜孜","author":"沈谦","text":"香暖衾窝，背他好梦孜孜地。\n刺桐花底。\n小语东风细。\n步步提防，难把离魂系。\n重门闭。\n雨偷云替。\n元在罗帏里。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3415,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙　春闺","author":"沈谦","text":"絮扑游丝不放飞。\n燕巢花满落香泥。\n无人春冷教添衣。\n妆罢乱莺啼阁外，梦回斜日照窗西。\n此情除是那人知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3416,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 晓思","author":"沈谦","text":"恻恻春寒近五更。\n半窗斜月叫新莺。\n梦儿难好却无凭。\n倚柱有期空盼影，隔花相唤不闻声。\n最无情处最牵情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3417,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮　幽怨","author":"沈谦","text":"柳丝拂地愁如织。\n娇莺啼露东风湿。\n烟草碧重重。\n迷离似梦中。\n无人知此意。\n腰比前春细。\n莫去倚危楼。\n斜阳花更愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3418,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 戏和王阮亭使君题青溪遗事画册","author":"沈谦","text":"回塘水绿春如画。\n怪人游戏鹦歌骂。\n楼背捉迷藏。\n寻踪只认香。\n花间还再探。\n花重帘栊暗。\n轻嗽要郎知。\n潜身窥户时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3419,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 美人额","author":"沈谦","text":"玉栊春冷梅花飐。\n共惊螓首新妆艳。\n不大画眉粗。\n城中改样涂。\n蜂黄闻已退。\n颦蹙时含泪。\n两小羡当时。\n临风有所思。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3420,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 美人臂","author":"沈谦","text":"涂银袖里摇双钏。\n深藏却为攀花见。\n红印记绸缪。\n长新风月愁。\n檀郎贪昼寝。\n不用珊瑚枕。\n梦去莫游仙。\n温柔更可怜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3421,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 美人背","author":"沈谦","text":"碧窗人静凉初透。\n凝脂拊处难留手。\n香汗浃桃笙。\n灯昏月半明。\n回身因薄怒。\n拥抱还推去。\n终夕嗅烟鬟。\n同床见面难。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3422,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 再见","author":"沈谦","text":"相携斗草藏春洞。\n垂髫覆额眉痕重。\n惯会发娇嗔。\n自轮翻打人。\n玉栏今再见。\n熟面如生面。\n低唤小时名。\n回身不肯应。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3423,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"美人鬘 歌妓","author":"沈谦","text":"银灯低照眉山绿。\n催唱相思曲。\n暗里踢红靴。\n春寒夜转多。\n嘈嘈筝板声何急。\n漫然花枝说。\n郎自要销魂。\n魂销莫怪人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3424,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"一串红牙　自度曲　板","author":"沈谦","text":"一串红牙，有许多格范。\n笛孔吹龙，筝头捺雁。\n偏把歌人难。\n愁杀双鬟，为恃恩心慢。\n道字常疏，移宫不惯。\n须要参差按。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3425,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"误佳期　写恨","author":"沈谦","text":"深院斜阳欲坠。\n满地平芜剪翠。\n此时相遇悄无人，故闪银屏背。\n露手不成招，热面翻含愧。\n多情全不是书中，此意真难会。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3426,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"误佳期 闺怨","author":"沈谦","text":"闷把阑干猛拍。\n一向翠奁尘积。\n孤鸾那得影儿双，怕见菱花碧。\n梅浅月朦胧，鬓亸云狼藉。\n愁容自己也难看，敢望他怜惜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3427,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"清平乐　梦后偶成","author":"沈谦","text":"为他羁绊。\n萦性相思惯。\n洛水巫云生锦幔。\n梦到春来偏幻。\n孜孜亦自商量。\n睡乡长住何妨。\n蝶化曾笼翠袖。\n莺啼又隔银墙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3428,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"清平乐 教鹦鹉语","author":"沈谦","text":"晓帘妆罢。\n逗得鹦哥挂。\n过眼韶光都是假。\n教把春风来骂。\n断云残雨无凭。\n不劳莺燕傅情。\n明日买丝绣佛，与他同念心经。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3429,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"清平乐 春闷","author":"沈谦","text":"雪消水溢。\n岸柳金芽出。\n漠漠暗尘萦宝瑟。\n坐转一窗红日。\n博山香袅烟丝。\n闲愁闲闷谁知。\n欲解罗衣去睡，黄莺又上花枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3430,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"清平乐 私语","author":"沈谦","text":"小栏西畔。\n私语春情乱。\n彷佛有人花外唤。\n故卷梅红罗幔。\n嬉游忘却根松。\n问时无那羞容。\n最是牵云惹雾，明朝不戴金虫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3431,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"清平乐 春游赠妓","author":"沈谦","text":"两峰眉蹙。\n更着春烟绿。\n淡日烘云新雨足。\n红得桃花如肉。\n醉看蝉鬓欹斜。\n听歌再立堤沙。\n懒上银鞍叱拨，愿为金屑琵琶。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3432,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"清平乐 闺情","author":"沈谦","text":"鬓云低袅。\n淡画双蛾小。\n磨得菱花秋白皎。\n病里何曾草草。\n闷看金鸭香浮。\n妆成独坐空楼。\n百遍不如郎意，旁人都道风流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3433,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"万峰攒翠 沈氏词选成寄常州邹程村","author":"沈谦","text":"春暖玉屏风细细。\n兰畹幽香如醉。\n唱遍新词空洒泪。\n旁人不会。\n烟波何处毗陵，楼外斜阳又坠。\n人不南来愁却至。\n万峰攒翠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3434,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"桃源忆故人　歌妓金姬出家戏赠","author":"沈谦","text":"粉红和露挑灯洗。\n孔雀舞衫都施。\n春散绿云垂地。\n剪处刀犹腻。\n醍醐难比相思味。\n后夜钟鸣月坠。\n觑着孜孜梦里。\n柳影歌楼翠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3435,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"海棠春　春日悼亡","author":"沈谦","text":"夜来深雨闻花叹。\n风不定、低垂帘蒜。\n烟湿草光迷，树远莺声换。\n生离死别谁经惯。\n待举笔、心情又嫩。\n诗瘦有谁怜，酒病无人管。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3436,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"忆分飞 雪夜旅思","author":"沈谦","text":"芙蓉帐。\n灯衔凤口东西向。\n曲罢鹍弦放。\n罗衣怕解垂咽项。\n谁知别后多魔障。\n平芜翠剪迷深巷。\n今夜天难亮。\n雪晴茅店寒鸡唱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3437,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"柳梢青　咏柳寄妓","author":"沈谦","text":"野驿逢春，荒城傍晚，对语寒乌。\n才见摇金，又惊飞雪，几日萧疏。\n为伊目断长途。\n正雨后、斜阳翠芜。\n眉小常颦，眼重未醒，腰细谁扶。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3438,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西江月　雨中坐泛雪庵作","author":"沈谦","text":"壮士红旗较猎，佳人翠馆徵歌。\n目成花底认横波。\n忽又鼻端出火。\n自笑尘埃落魄，谁知岁月蹉跎。\n一龛春雨伴弥陀。\n回转头来是我。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3439,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西江月 春夜","author":"沈谦","text":"别后何曾有梦，见时又说多情。\n玉楼银烛坐吹笙。\n赢得半床春病。\n欲去愁魂袅袅，难干泪眼盈盈。\n落花风紧月三更。\n帘外鹦哥叫冷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3440,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西江月 西阁有怀","author":"沈谦","text":"水选孤村寂静，山连小阁清虚。\n坐来空翠湿衣裾。\n一霎溟濛似雨。\n傍柳时移宿鸟，衔花欲上游鱼。\n窥帘新月暮寒馀。\n也照飞琼伴侣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3441,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西江月 小楼","author":"沈谦","text":"疏雨尚沾池草，轻风暗扫庭梅。\n小楼灯火画帘垂。\n帘外月华如水。\n被冷真愁香髻，枕欹却忆颦眉。\n忽闻金斗簸残灰。\n夜静原来未睡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3442,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"满镜愁","author":"沈谦","text":"烟草凄迷，风袅画帘不定。\n楼上斜阳人独凭。\n残醉醒。\n春老黄鹂静。\n雨覆云翻，岂是红颜心硬。\n病起谁怜腰带剩。\n嫌瘦影。\n愁满菱花镜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3443,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"醉花阴　用李易安体　春雨","author":"沈谦","text":"听尽潺潺帘外雨。\n一夜愁如许。\n绣帐隐残灯，炯炯双眸，没个安排处。\n莺啼侥倖天将曙。\n见落红无数。\n泪点更多些，弹与东风，总把春交付。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3444,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"醉花阴 客夜咏枕用沈会宗体","author":"沈谦","text":"鸳鸯绣出偏成对。\n衬荷钱叠翠。\n街鼓报三更，怪冷嫌高，欹着何曾睡。\n无端要拍珊瑚碎。\n又暗垂清泪。\n臂玉恐销香，低首寻思，蓦地灯花坠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3445,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"醉花阴 闺情","author":"沈谦","text":"西窗斜日花阴下。\n正梳头才罢。\n对镜几徘徊，未到黄昏，又把云鬟卸。\n屏风自掩深寒夜。\n剪银台灯灺。\n收取入香奁，狼藉春山，留待檀郎画。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3446,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"醉花阴 重阳即事用李易安体","author":"沈谦","text":"永昼空阶虫语咽。\n趱得头如雪。\n无奈又重阳，不见黄花，瞒过愁时节。\n佳人浪作经年别。\n便梦来江截。\n何处最关情，凉透纱厨，酒暖鹅笙热。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3447,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"遍地雨中花　雨夜感怀","author":"沈谦","text":"昔日鸳帏春睡足。\n有此夜、睡难熟。\n蕉叶窗西，藕花池上，雨冷浑如哭。\n怕他人、笑我痴迷，恨和愁、都藏在腹。\n倚枕无言，停杯不饮，坐看秋灯绿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3448,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浪淘沙　 清明","author":"沈谦","text":"雨过小窗前。\n几处莺声。\n纷纷花柳障春城。\n我自愁多如中酒，人道清明。\n箫鼓画船轻。\n游当何曾。\n倚帘终日泪盈盈。\n风里落花浑不响，蓦地心惊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3449,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浪淘沙 次沈丰垣韵","author":"沈谦","text":"见面不如初。\n绣带银涂。\n双鸾截断总成孤。\n离合从来俱是命，我害卿乎。\n烛泪晓窗枯。\n梦里惊呼。\n湘山云雨竟荒芜。\n当日风流天也妒，莫恨情疏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3450,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]