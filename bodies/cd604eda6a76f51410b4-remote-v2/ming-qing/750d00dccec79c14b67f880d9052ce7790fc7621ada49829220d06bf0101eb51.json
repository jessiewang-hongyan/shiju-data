[{"title":"楚宫","author":"陈子升","text":"幽兰采罢佩缤纷，忆得微辞善讽君。\n清怨瑟堪弹夜月，细腰宫亦梦朝云。\n天低沔口来鱼媵，帆转湘南出雁群。\n曾见长沙尊傅礼，汨罗沈尽贾生文。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5046,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咸阳","author":"陈子升","text":"羸马垂鞭气亦豪，关门胜迹莽相遭。\n锡来鹑首霸秦缪，会去鸿门兴汉高。\n三辅依然环帝里，二崤不动表神皋。\n少年却在远林下，閒臂角鹰新放绦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5047,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"沛中","author":"陈子升","text":"秦关西作汉家基，草色无穷铁马驰。\n云气居通高拱处，竹皮冠卸远游时。\n遥林鸟尽秋方净，大泽龙归雨更滋。\n何物至今传得在，山河不及大风辞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5048,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雒阳","author":"陈子升","text":"周王定鼎初营邑，及至东迁近孟津。\n往事并流清雒水，旧京终化素衣尘。\n铜驼荆棘愁看汝，笙鹤云烟笑谢人。\n自是书生徒解咏，五诗无复授西宾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5049,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蜀中","author":"陈子升","text":"山木森森闻杜鹃，路难真拟上青天。\n当关一士可胜万，分鼎中原翻在边。\n剑阁旧踪云栈暗，锦城新雨海棠鲜。\n文心对此几能写，绿绮凄清蜀国弦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5050,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"邺中","author":"陈子升","text":"漳河流尽故宫尘，霸气如从马首新。\n东汉缀旒因有国，西园飞盖若无人。\n风悲古冢啼山鸟，日射寒塘散渚蘋。\n孤客吟边不知暝，建安年后有良辰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5051,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"金陵","author":"陈子升","text":"秦淮新月浸微波，曾咽当年玉树歌。\n双阙荒凉山鸟至，六朝烟霭寺僧多。\n桃迎渡口春无限，蘋采江南晚奈何。\n莫把须眉倚红粉，酒楼高绝客颜酡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5052,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"隋宫","author":"陈子升","text":"浪结同心嗣太平，一朝閒梦决东征。\n红颜泣尽宫谁守，白骨流多殿自行。\n仙李根深摇柳色，后庭花谢到芜城。\n横波若久留人住，还望江南无限情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5053,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"江楼归兴","author":"陈子升","text":"将归更上尉佗楼，楼外烟江惹客愁。\n白发影同汀鹭晚，黄花香在井梧秋。\n平芜迥绝千林鸟，独树閒邀一叶舟。\n惟望故山今夜月，清辉前路慰同游。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5054,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"重移村居既北复南未返吾庐慨然兴叹","author":"陈子升","text":"桑梓依依历草茅，故园应为长蟏蛸。\n望穷北渚湘兰种，拣尽南枝越鸟巢。\n淮海岂同公路浦，辋川新有孟城坳。\n柴门几处秋萧瑟，后夜行吟月下敲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5055,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄板桥黎方回务光","author":"陈子升","text":"板桥霜色带芳篱，四海才名怅昔时。\n流水竟孤琴一曲，临风长见玉双枝。\n藏书曝日恩犹在，裹革终天泪总垂。\n国士只今惭马队，凌江不用奋长离。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5056,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送谈蘧怀游潮阳便还京江","author":"陈子升","text":"满天寒雨问将归，沧海东流碣石微。\n乡思已驰京口去，宾鸿犹欲岭南飞。\n春生石砝尝鲜馔，云起金焦见羽衣。\n还望台关转寥落，折梅书信莫教稀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5057,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"示族中诸兄弟","author":"陈子升","text":"秀气环洲云浸矶，枌榆时见旧恩辉。\n丁年盛事族人说，丙舍残春江燕飞。\n竹长龙孙留劲节，松彫马鬣几成围。\n先庐独远北堂老，一赋南陔愁广微。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5058,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"循州车世之来江村度岁而还比以诗见寄答此兼讯叶姚诸子","author":"陈子升","text":"愁寂孤村阅九春，二樵烟霭若为邻。\n素馨田外苦吟客，红翠声中肥遁人。\n一昨梅香薰水部，祇今蓬户笑山宾。\n采薇便拟行歌远，东就鸿濛问矅真。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5059,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄叶犹龙金吾","author":"陈子升","text":"鹤峰高卧羽林郎，闻道将雏舞凤皇。\n顿逊杯新擎到酒，博山炉旧赐来香。\n门前月冷彫弓影，宅内湖涵宝镜光。\n早晚灵洲见佳气，可能无意共翱翔。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5060,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"走笔因柬止言澹归二上人","author":"陈子升","text":"郁郁谁能滞此乡，飞鹑走狗共津梁。\n钩辀笑客行不得，灵寿扶吾当自强。\n句漏洞中期葛令，扶摇枝上过云将。\n寄声白足同心侣，古月明灯何处堂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5061,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄寿汤惕庵先生","author":"陈子升","text":"二十年前出宪时，美髯玄发映清姿。\n观风只许凛相对，执法敢求深见知。\n丹陛也曾留汲孺，碧云何异咏休师。\n莫疑棠荫馀霜雪，今日南岩生紫芝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5062,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过白石村访唐明藜聓其从兄明犀久游未归因并怀之","author":"陈子升","text":"采菱风急暮天浮，一枕听潮溯上流。\n每向亲朋称旅客，独迷烟雨见江鸥。\n颓垣护果丹垂树，小艇穿苗绿满畴。\n知尔一乡栖息好，白云何处伴人游。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5063,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赤花洲七夕同李樵怀家皖公","author":"陈子升","text":"龙目离离垂暗津，渔家灯影共星陈。\n名香竟日熏荀令，绣被深宵覆越人。\n斜汉欲将云树合，闰年贪向月华新。\n桑田沧海君休问，结袜閒生雒浦尘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5064,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和薛秀才旧识邯郸歌姬后入靖江藩府藩国遭乱姬便流落偶于逆旅逢故宦者述姬寄语之作","author":"陈子升","text":"名士倾城两不惭，丛台歌舞系征骖。\n绿珠终合藏金谷，碧玉曾闻嫁汝南。\n绠断银床飞桂瘴，弦更瑶瑟怨湘潭。\n西风短鬓劳相问，惆怅当年玳瑁簪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5065,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄觉度上人","author":"陈子升","text":"青龙昙壁辋川游，最忆栘花拂寺楼。\n千梵放生深院午，一枝扶老故山秋。\n阶苔转日摇平仲，窗竹鸣风过鞠侯。\n十载支离有尊足，不妨寻我白蘋洲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5066,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"岁除答梁羲倩敦五两甥 其一","author":"陈子升","text":"荆扉閒掩碧江边，十载愁如水上烟。\n溪树半含莺语涩，朔云中断雁行偏。\n知音几处逢歌雪，问字何人识草玄。\n敝宅屡迁无足相，飘零还见汝家贤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5067,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"岁除答梁羲倩敦五两甥 其二","author":"陈子升","text":"当年竹马外家游，共看初生似阿侯。\n山豆种来杨氏盛，楚兰滋遍女媭愁。\n春深豹雾薰书幌，水接鹏溟动钓舟。\n千古运期更姓字，虚名知尔世情留。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5068,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"壬寅元日","author":"陈子升","text":"漫拂峨冠向曙烟，颓檐犹得拜高天。\n鲲溟见击三千里，雁塞闻归十九年。\n米汁从今斋绣佛，露盘依旧捧铜仙。\n閒吟欲制将雏曲，且奏村灯社鼓前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5069,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"挽何司寇","author":"陈子升","text":"汉署星沈紫水滨，冈州难问老成人。\n万钱忆会鸣钟里，五羖俄悲相杵邻。\n枣下歌传真厌世，橘中棋散竟藏身。\n承家更有玄成嗣，乔木他年念世臣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5070,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春日言怀","author":"陈子升","text":"寂寞于陵独灌园，秦人鸡犬共桃源。\n乌皮几在客谁对，龙眼花繁蜂自喧。\n潋滟春波平草阁，槎枒老树夹柴门。\n河清可俟还愁暮，试上高台礼日暾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5071,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"八九吟","author":"陈子升","text":"剑气方寒南斗墟，河清难俟乱离馀。\n滔天却讶帻如屋，齧雪犹看旃绕庐。\n但有金牛通栈道，可无騧马出莎车。\n干戈满目风云晚，深入薜萝还读书。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5072,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日西郊宴集","author":"陈子升","text":"寥落王风蔓草生，荒郊何意会群英。\n十年丧乱同王粲，万里归来独子卿。\n林际远烟鸦噪晚，雨馀新月雁窥晴。\n故园秋色携琴在，吟断西楼画角声。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5073,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"癸卯早春口占呈友人","author":"陈子升","text":"今年岂谓去年非，漠漠慈颜认旧闱。\n眷属不离居士室，劳生元息丈人机。\n村僮警夜当风语，汀雁嫌泥带雪飞。\n三陟自知吟更苦，早春怜尔远游归。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5074,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"得钱牧斋宗伯书","author":"陈子升","text":"吴江飞雪上梅枝，海曲人归积雨时。\n双泪正缘乌哺尽，尺书还为雁行悲。\n生身金粟能深信，博物张华谬见知。\n远目不堪迷匹练，梦周今已觉吾衰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5075,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"首夏东游江上作","author":"陈子升","text":"高帆挂月转江濆，回首孤村在水云。\n赊酒愿逢颜特进，运租期有谢将军。\n女墙独树摇乌影，官渡千艘载马群。\n前路草长劳未歇，况从先哲挹清芬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5076,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送雁和元孝","author":"陈子升","text":"雪后长途在远天，榆关风细客心悬。\n迹留南浦因成别，啼过西楼忽渺然。\n新影欲低青海月，故群仍破黑山烟。\n稻粱不免重来食，多恐惊沙没水田。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5077,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"四会访朱子敬表兄学署","author":"陈子升","text":"潮平江影见秋山，桑梓程途莽苍间。\n乱后插萸中表共，庭前收橘广文间。\n曲池皓月恒相鉴，高第浮云未可攀。\n笑我出门多内顾，片帆西上昨东还。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5078,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"程周量梁芝五二子同过","author":"陈子升","text":"严城旅食笑孤身，结驷同来第一人。\n近市久知齐晏子，登坛何有汉韩信。\n官街鼓响迎秋急，卜肆帘垂过雨新。\n歌罢无车终不出，愧君风雅为扶轮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5079,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"酒酣赠汪汉翀工部","author":"陈子升","text":"杖藜无赖到东城，话到悬河酒遂倾。\n桂树小山成吏隐，桃花深水见交情。\n欲持元赋还西鄂，却选青钱忆水衡。\n四座相欢重问我，十年忧患感生平。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5080,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赎琴","author":"陈子升","text":"萧条深负峄阳材，裘敝经时笑古台。\n白雪调高人和寡，青蚨飞去尔归来。\n秦庭璧在相如睨，汉日笳清蔡琰回。\n重拂细尘摩玉轸，一弹还欲进千杯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5081,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"听在犙禅师讲法华经兼较金刚经异同师曰陈乔生意者其憍陈如乎因纪一律","author":"陈子升","text":"火宅莲华露特寒，比来禅味憺忘餐。\n净名复有称摩诘，凿齿非徒对道安。\n物论已齐庄马喻，经文重把鲁鱼看。\n他年傥授菩提记，妙法悬知得者难。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5082,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送某还义乌营母太夫人葬","author":"陈子升","text":"何事登堂慰伯俞，空闱一拜旧罗襦。\n白杨风急吹萱草，鸿雁天寒泣孝乌。\n玉帐珥貂身暂远，瑶台遗蜕手亲扶。\n祥芝定发金华岭，雪遍梅花隐绛趺。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5083,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寒江","author":"陈子升","text":"寒江兵气两无穷，海国渔家沸鼎中。\n罗网法张回献鹄，鼓鼙声急散哀鸿。\n且邻空舍为孤客，难挟残书命一僮。\n奔走至今何计是，杳然虚谷待愚公。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5084,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"生日","author":"陈子升","text":"植根长似九秋蓬，戢翼徒看万里鸿。\n晚节可称诗圣得，生年真与觉皇同。\n累朝紫诰归逢掖，两鬓清霜点次工。\n从此亦知陶写去，缺瓶沽酒按枯桐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5085,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"冬夜赠曹自悦司马","author":"陈子升","text":"围炉曲宴烂灯花，客话平生益自嗟。\n六国印销愁委佩，五湖舟泛不归家。\n随身秘笈诸郎负，寄迹残山万树遮。\n头白逢人工定拙，好从方朔学龙蛇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5086,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"拱北楼望仙湖里故居","author":"陈子升","text":"楼下双门车马尘，楼头五夜唱鸡人。\n十年清梦里闾改，一片彩云窗槛新。\n雀噪北林窥殿影，籁传南郭窅天真。\n回翔却问乌衣燕，此处雕梁谁旧邻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5087,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"甲辰小除夕作","author":"陈子升","text":"零落黄门欻白头，几年萍梗泛沧洲。\n结交悔作四公子，学佛思随五比丘。\n穹室烟深归祀灶，金银云起去登楼。\n明春未得避喧计，空负晓林黄栗留。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5088,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将归九江村旧居先寄亲旧","author":"陈子升","text":"浮家今拟动归桡，家在中洲宛转桥。\n菊落秋英频扫径，池平春水渐通潮。\n妻儿已解安容膝，亲友难忘是久要。\n斑鬓经冬拌白尽，青山如画待归樵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5089,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送梁甥敦五德庆广文","author":"陈子升","text":"越江西上近湘漓，薄禄还同酒一卮。\n舅宅昔闻成此相，圣门今见作人师。\n猺童语杂城边市，龙母神归树里祠。\n莫谓山陬限文教，看君前去拥皋比。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5090,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"七夕前梁阜己宅逢王震生初归自豫章","author":"陈子升","text":"庭邀皎月树含风，归客吟孤旧友同。\n老丑自看诗益好，贤豪相待命犹穷。\n白藤穿枕眠徐孺，龙眼推筐掷左冲。\n劝种宜男家计得，小星言在此城东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5091,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄潮州宋上木太守","author":"陈子升","text":"二十年来名甲科，云间华望郢中歌。\n骚坛到郡声逾籍，诗思为官政自和。\n挥翰珠光凌夜出，褰帷山翠面南多。\n因风黄鹄东飞去，为说朝台有薜萝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5092,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭朱远公","author":"陈子升","text":"绝技翻如不爱身，奄然朝露坠萧晨。\n臞形自合骑高鹤，生态空归画美人。\n世上名从莲社记，扇头书作蕺山珍。\n平生拌得称文弱，遗嗣如何遣负薪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5093,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"城中答王东村家元孝送归中洲草堂之作兼示二三同志","author":"陈子升","text":"归心一发尉佗楼，一点晴烟见渡头。\n三径尚堪携客入，中洲曾是为谁留。\n青含浦树喧黄鸟，绿遍江苗过白鸥。\n七十二峰无恙在，更于城郭念同游。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5094,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"初返故园","author":"陈子升","text":"昨上归舟寻水云，故园閒旷使情欣。\n无穷月色坐皆见，不断花香行即闻。\n五亩宅边敦素业，三层阁上蓄奇文。\n梁间燕子似相识，飞下小塘衔嫩芹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5095,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"王阮亭客部枉评予诗作此寄赠兼怀令兄西樵吏部 其一","author":"陈子升","text":"十年不拟北书通，閒听归人话北风。\n黄叶小窗寻句在，玉人清署寄声同。\n霜凋桂树香犹烈，海浸珊瑚气亦红。\n长是微名自珍惜，汝南评却重山东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5096,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"王阮亭客部枉评予诗作此寄赠兼怀令兄西樵吏部 其二","author":"陈子升","text":"南云长望北云飘，诗思相亲不觉遥。\n欲挽颓波谁独峙，解承仙露是双标。\n肯邀旧友藏深署，应为宫人赋洞箫。\n朝夕看山已相识，琅邪遵海有西樵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5097,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"答沈甸华见赠","author":"陈子升","text":"风流历历溯西泠，皦日偏高处士星。\n远访遂过梅峤路，出寻閒傍李官厅。\n龙蛇岁去身犹屈，鸲鹆溪回眼尽青。\n来就嵇含询草木，欣然携手折芳馨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5098,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"丙午腊月羊城对雪","author":"陈子升","text":"怪得年来事事殊，岭南飞雪旧时无。\n云凝不见三山黛，天漏争盛合浦珠。\n野寺一僧烧榾柮，官街群马从氍毹。\n冲寒便欲还山问，糁到溪梅第几株。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5099,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"暮春三宿邝无傲斋中迟高望公不至同许式微许二陔赋","author":"陈子升","text":"丘壑身存鬓任颓，柴扉深掩草堂开。\n三春燕语几人问，昨日渔舟特地来。\n僮煮碎香凝白室，鸟翻层叶堕青梅。\n离心转剧留连地，延伫高高只古台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5100,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将溯端水而上贻二三知己","author":"陈子升","text":"村居无计隐烟萝，强走江关无奈何。\n举案妇愁储粟尽，牵衣儿竞念书多。\n行同老马犹知路，食有嘉鱼且放歌。\n寄语离居数君子，道心随处恐消磨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5101,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"初至泷洲访从侄山庄遇故里杜子","author":"陈子升","text":"诸峰丛翠复丛烟，县境闻开未百年。\n山鸟独啼宫保庙，土人多种客家田。\n林交虎迹谙樵入，石閟星文厌俗镌。\n谁谓龙钟行不得，来巢飞燕共翩翩。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5102,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"荆棘","author":"陈子升","text":"草色如烟偶出寻，参天荆棘晚森森。\n未曾说剑逢瞋目，乍可虚舟触褊心。\n石窦蝙飞遗土气，柳塘蛙怒象雷音。\n知君捷径南山度，乞放骚人泽畔吟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5103,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西游归贻王大雁侄元孝兼怀梁阜己","author":"陈子升","text":"重城郭外野溪滨，讲德谁能似此亲。\n暂别却无高卧处，薄游还有未归人。\n心如蠹柳常经折，字泣鲛珠不救贫。\n万里声名千古业，只应相爱寂寥身。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5104,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"答赠叶虎竹","author":"陈子升","text":"少年何事被愁侵，玉树萧萧忆故林。\n万卷幼依慈母读，七言閒对野鸥吟。\n若教视草知能手，便拥如花不称心。\n暂觅交亲道情素，山中萝月约秋阴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5105,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]