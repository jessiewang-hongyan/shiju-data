[{"title":"浪淘沙 中秋夜雨","author":"沈谦","text":"暝色暗高楼。\n懒上帘钩。\n残荷吹尽水悠悠。\n两袖泪珠多似雨，偏洒中秋。\n笙管记同游。\n庭桂香浮。\n胭脂零落小坟头。\n便有玉栏今夜月，总是闲愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3451,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浪淘沙 寄毛稚黄","author":"沈谦","text":"别路柳含烟。\n恨杀啼鹃。\n片帆高挂水连天。\n无数青山遮不住，似箭离弦。\n对酒擘银笺。\n碧树红泉。\n胜游还道不如前。\n把烛重看肠断句，夜雨绵绵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3452,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浪淘沙 春恨","author":"沈谦","text":"弹泪湿流光。\n闷倚回廊。\n屏间金鸭袅馀香。\n有限青春无限事，不要思量。\n只是软心肠。\n蓦地悲伤。\n别时言语总荒唐。\n寒食清明都过了。\n难道端阳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3453,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浪淘沙 春怨","author":"沈谦","text":"河流尽含颦。\n也学愁人。\n隔窗莺语泥斜曛。\n满眼落花多似泪，终日纷纷。\n宽带小腰身。\n怕杀黄昏。\n月来还共影寒温。\n最是今年情兴好，睡过三春。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3454,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浪淘沙 夜怨","author":"沈谦","text":"人静雨潇潇。\n帘影风摇。\n残杯独酌转无聊。\n翠袖啼痕红烛泪，同洒春宵。\n烟水隔斜桥。\n魂断谁招。\n带围宽尽沈郎腰。\n到得见时卿试比，不让苗条。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3455,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浪淘沙 戏赠幼妓","author":"沈谦","text":"眉小发初齐。\n游戏偏宜。\n唱歌频误拍频移。\n掌上有风休试舞，怕逐花飞。\n殢酒更娇痴。\n款抱轻携。\n晓寒深护绣帘垂。\n烟里一丝金线柳，认做黄鹂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3456,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雨中花　春梦","author":"沈谦","text":"月冷红梨浑欲谢。\n没甚事、和衣睡罢。\n宝帐灯明，翠屏香袅，已在花阴下。\n独行小径心儿怕。\n遥望见、玉帘低挂。\n寂静无人，分明有路，隔着秋千架。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3457,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹧鸪天　赠妓宛儿","author":"沈谦","text":"香阁题诗写白罗。\n玉栏携手奈情何。\n春寒飞雨浑疑梦，夜静游云欲听歌。\n含笑靥，锁愁蛾。\n泥人佯醉几摩挲。\n水村明日催花发，抱取红裙细马驮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3458,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹧鸪天 夜怨","author":"沈谦","text":"肠断西园月满林。\n无聊空自拥寒衾。\n垂将珠箔从春去，挑尽银灯觉夜深。\n期屡负，梦难寻。\n不知流泪湿梦巾。\n口衔莲子兼红豆，尝遍相思苦在心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3459,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹧鸪天 怀妓","author":"沈谦","text":"翠馆花深路欲迷。\n暗中绣手记曾携。\n独怜锦带人如燕，恰喜琼筵客似泥。\n闲处想，梦中啼。\n小楼深坐两眉低。\n纷纷蜂蝶春如画，不肯梳头下玉梯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3460,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"虞美人　偶成","author":"沈谦","text":"珠帘夜卷瑶台雪。\n初上团团月。\n潜身偷看董双成。\n却恨翠烟红雾太纵横。\n归来孤枕和衣倒。\n冷被灯儿笑。\n赚人肠断是蛾眉。\n隔着花阴又把玉箫吹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3461,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹊桥仙　闰七夕","author":"沈谦","text":"琼云乍卷，金风渐冷，谁把鹊桥重驾。\n玉人携手隔帘看，堆雾鬓、晚妆初卸。\n更深灭烛，凉生却扇，咫尺明河欲下。\n阑干私语告檀郎，总输你、朝朝夜夜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3462,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹊桥仙 题昭时二儿画羽阶三兄小像","author":"沈谦","text":"古松百尺，悬流千丈，挥扇解衣盘礴。\n玉楼金埒逞豪情，总不想、而今丘壑。\n昭儿图景，时儿图面，孺子丹青能作。\n老来应识少游心，当念此、及时行乐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3463,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹊桥仙 杜鹃","author":"沈谦","text":"江南花落，楼西月冷，啼到不堪闻处。\n年年含血骂东风，恰似我、呕心奇句。\n云低铁峡，烟荒玉叠，漫说离情最苦。\n天涯多少断肠人，只是你、不曾归去。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3464,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹊桥仙 五日对酒作","author":"沈谦","text":"钗符袅玉，臂丝约彩，惊叹流光如矢。\n雪头堆上海榴红，吾老矣、颠狂如此。\n茂弘喻布，孔群比肉，毕晚谁非谁是。\n一樽无处酹零均，也只合、当年醉死。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3465,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹊桥仙 喻风","author":"沈谦","text":"柳腰全困，花头半坼，迤逦春光如绣。\n东风快似剪刀儿，把淡绿深红簇就。\n流莺搅睡，晴丝系恨，正是销魂时候。\n漫将金斗比东风，熨不醒、两眉长皱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3466,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹊桥仙 歌妓","author":"沈谦","text":"朱唇欲启，翠眉先蹙，掩袖俄延半歇。\n玉箫低度趁香喉，我倒喜、宫商不协。\n逞娇似媚，言愁如诉，裙底红鸳暗跌。\n误多频顾耐端相，方便杀、灯前皓月。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3467,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹊桥仙 春夜","author":"沈谦","text":"绮窗月转，银台灯灿，绣袜斜窥金胜。\n暗闻莺语隔东风，越显得、夜阑人静。\n粉容薄醉，兰心小倦，唤着有时低应。\n泥人怀里绿云香，料不为、鸳鸯枕硬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3468,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹊桥仙 友人纳姬戏赠","author":"沈谦","text":"玉帘不卷，翠屏深锁，花气着人如醉。\n纷纷蜂蝶太贪春，才一夜、粉黄都退。\n鬓云全倒，眉山轻蹙，楼上日高犹睡。\n新欢未审有何愁，看枕上、盈盈珠泪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3469,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹊桥仙 咏轿","author":"沈谦","text":"教莺先促，逢花又住，帘幕有时偷控。\n芙蓉小褥衬香绵，想行处、柳腰微动。\n层层碧嶂，迢迢翠陌，回忆旧欢如梦。\n常将飞燕比身轻，敢归路、愁多增重。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3470,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹊桥仙 春恨","author":"沈谦","text":"黄莺不语，绿阴渐满，犹见蝶翻金翅。\n半林斜日卷帘栊，生怕惹、轻寒着体。\n慵拈翠管，惟亲珊枕，病里思君如水。\n春蚕春柳本无情，也学我、三眠三起。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3471,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"玉楼春　旅情","author":"沈谦","text":"碧桃花谢东风湿。\n病里看春无气力。\n愁来不断水如烟，梦去仍回云似墨。\n玉窗人背孤灯泣。\n泪洒榴裙应变色。\n子规啼罢鹧鸪啼，终日踌躇楼上立。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3472,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"玉楼春 游明因寺折桃花一枝贮之胆瓶是夜风雨大作","author":"沈谦","text":"胭脂淡抹香肤腻。\n万树绯桃偏映水。\n可怜含蕊便遭风，一向冤他贪结子。\n重帘护烛花如醉。\n却忆小桥通野寺。\n摧残不到五更头，化作枕边红粉泪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3473,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"玉楼春 秋夜独宿有怀","author":"沈谦","text":"湘帘一片秋声碎。\n残月窥人人不寐。\n心儿似你最无情，此时也合频垂泪。\n寒风摇曳孤灯背。\n落落星光如欲坠。\n思量还是影多情，夜夜伴侬愁里睡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3474,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"踏莎行　后段多一字。旅梦","author":"沈谦","text":"孤影长羁，双眉时结。\n魂灵不怕关河截。\n野桥南去不逢人，朦胧一片杨花雪。\n问有谁应，愁难自说。\n杜鹃窗外空啼血。\n道不如归去怎生归，银骢又秣三更月。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3475,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"踏莎行 春情","author":"沈谦","text":"雨过疏帘，苔荒小院。\n年年病骨逢春软。\n莺啼白日弄轻阴，无聊卧看杨花转。\n衣冷谁添，书成未遣。\n琐窗魂梦都寻遍。\n为伊消瘦也甘心，镜中莫放檀痕浅。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3476,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"踏莎行 夜坐有感","author":"沈谦","text":"对酒心慵，看花泪湿。\n多情自是天生得。\n灯来照出影儿单，夜深一任纱窗黑。\n往事难留，重思无益。\n真心不为新欢惑。\n要人肠断有何难，雨中又是高楼笛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3477,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"踏莎行 述怀兼呈金振公","author":"沈谦","text":"不受饥驱，何忧看杀。\n逢君几度更裘葛。\n愁时蝶梦苦难轻，老来姜性偏增辣。\n病莫多情，穷须作达。\n醉歌要把行云遏。\n蜀山雪亮坠猢狲，钱唐风晦惊罗刹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3478,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"小重山　饮张祖望从野堂","author":"沈谦","text":"细草如烟野渚平。\n草中云突兀、是秦亭。\n小堂开处日初晴。\n花满地，新竹叫残莺。\n邀客坐吹笙。\n美髯都化雪、不须惊。\n黄河天上赋新成。\n堪下酒，试诵与侬听。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3479,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"小重山 八月初九日风雨寒甚昼眠有作","author":"沈谦","text":"江上秋涛捲黑云。\n朦胧天未晓、雨翻盆。\n棘闱灯火正纷纷。\n青衫湿，都是旧啼痕。\n衰鬓已如银。\n久将年少事、让他人。\n午鸡啼过不开门。\n风太紧，拥被惜馀温。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3480,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蝶恋花　春游即事","author":"沈谦","text":"一寸斜阳非可恃。\n柳外啼鹃，真是无才思。\n欲笑还颦因底事。\n销魂记得南朝寺。\n酒罢春衫红泪渍。\n花不看人，人愿看花死。\n归去小楼仍独自。\n半湖烟草如何是。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3481,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蝶恋花 闻声","author":"沈谦","text":"料峭东风花树暝。\n月过窗纱，犹见残灯影。\n香梦初回知害冷。\n彩云低唤何曾应。\n玉漏迢迢嫌夜永。\n一点春莺，趱上相思症。\n半晌隔楼还寂静。\n娇娥睡去檀郎醒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3482,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蝶恋花 睡起","author":"沈谦","text":"窗满斜阳初睡觉。\n庭院无人，不信鹦哥叫。\n强起扶头还脱帽。\n杏花零落春愁闹。\n无限愁颦因一笑。\n情死情生，拚为情颠倒。\n两袖啼痕曾不燥。\n漫柔乡里邯郸道。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3483,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蝶恋花 感旧次沈丰垣韵","author":"沈谦","text":"花雨纷纷山影媚。\n春岂愁人，人把春牵累。\n马上垂头元不醉。\n为谁流满青衫泪。\n水馆月明仍独睡。\n一寸榴笺，细语胸前佩。\n好梦惊残空自悔。\n杜鹃啼破三更嘴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3484,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蝶恋花 秋日题西轩素屏","author":"沈谦","text":"雨过荒亭闻促织。\n不管人愁，抵死声啾唧。\n诗写素罗浑未黑。\n欹斜惨淡疑乌贼。\n往事不堪重记忆。\n梦醒斜阳，已照银屏侧。\n古镜沉沉钿翠蚀。\n唾茸不褪深红色。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3485,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蝶恋花 咏簟","author":"沈谦","text":"树咽疏蝉嫌昼永。\n自展琅玕，寂寞何人共。\n睡起懒将眉黛纵。\n汗轻微印香肌莹○玉枕频欹衾怕拥。\n不肯梳妆，垂泪思残梦。\n帘幕无风波细涌。\n荧荧湮得湘痕重。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3486,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"金门贺呈朝 夏夕雨","author":"沈谦","text":"炎威逼。\n火云万朵俄成墨。\n电掣金蛇江树黑。\n天河直下夜深寒，把烦嚣都涤。\n半掩罗帏暂息。\n帘外碧桐如拭。\n隐隐残雷无气力。\n暗思玉簟亸烟鬟，料今宵眠得。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3487,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后庭宴　再咏蜂","author":"沈谦","text":"日晚闹窗，风暄游阁。\n檀痕腻嘴红沾脚。\n贪春何故更防春，藏针暗里无人觉。\n园林取次花残，袅袅细腰难托。\n欲讳幽情，无奈黄俱落。\n还记旧衣香，绕过韆鞦索。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3488,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"月笼沙 除夕","author":"沈谦","text":"酒满香浮盏面，雪晴光动檐牙。\n凤灯双照鼓频挝。\n赚得儿童成老大，爆竹梅花。\n莫恨无情岁月，何妨痼疾烟霞。\n醉乡高枕即为家。\n四十八年堪一笑，蚁阵蜂衙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3489,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"苏幕遮　为潘云赤悼亡","author":"沈谦","text":"篆烟微，花烛烂。\n月缺花残，咫尺幽明判。\n綷縩罗裙鬟髻乱。\n似有如无，风静垂帘蒜。\n梦无凭，愁不惯。\n眉妩青颦，谁举梁鸿案。\n遗挂尘生丝脆断。\n菡萏鸳鸯，不合愁人看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3490,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"苏幕遮 鞦韆","author":"沈谦","text":"草烟低，池水浸。\n一带帘栊，几处莺声唤。\n绣线休挑歌莫按。\n催上鞦韆，挽脱泥金襻。\n翠眉颦，云髻乱。\n愿做游丝，不放桃花瓣。\n归骑踌躇杨柳岸。\n柳外斜晖，蓦地香风散。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3491,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"苏幕遮 题竹青女郎祠","author":"沈谦","text":"殿云鲜，庭树绿。\n幡袅溪风，溪水明如玉。\n游女穿花高髻矗。\n踏破红裙，争唱迎神曲。\n梦来犀，春去速。\n月照苍梧，夜夜啼湘竹。\n何似小姑居处独。\n紫燕双飞，时把晴丝触。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3492,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"渔家傲　记得","author":"沈谦","text":"记得琼筵春意泄。\n背灯偷把丹唇洁。\n天样红墙成间别。\n须为彻。\n名花不护非豪杰。\n欲诉东风难自说。\n子规为我长啼血。\n静夜倚楼谁玩月。\n肠寸截。\n碧云来去雕栏热。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3493,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"渔家傲 新秋","author":"沈谦","text":"雨过回塘波细涌。\n水精帘外残霓控。\n半亸犀簪眉懒纵。\n谁惊梦。\n猧儿撼起金铃动。\n病着轻绡还道重。\n藕丝倦雪银盘冻。\n七夕又来谁与共。\n心怕恐。\n柳梢新月窥西弄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3494,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"渔家傲 立春晓起偶作","author":"沈谦","text":"新岁昏昏愁只睡。\n日光照入帘栊内。\n六幅素屏闲似水。\n因底事。\n晓来题遍银钩字。\n砌草庭梅徒自媚。\n白头惯洒多情泪。\n醉里不知春已至。\n重审视。\n彩蛾金燕分明是。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3495,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浪打江城　闺怨","author":"沈谦","text":"愁病亸犀簪。\n犹带宜男。\n恁样分离，滋味不曾谙。\n枕上朦胧才片刻，知何处，是江南。\n料得恋娇憨。\n燕搅莺探。\n人在绿杨烟里唤停骖。\n舞蹴地衣歌却扇。\n沉醉也，污银衫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3496,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"凤衔杯　怨别","author":"沈谦","text":"浴罢慵将花冠整。\n还共酌、碧梧金井。\n总唱惯阳关，银筝未按香喉应。\n翠黛小，低鸳颈。\n忆欢娱，重悲哽。\n全不管、有人难听。\n正烁石流金，火云突兀炎威盛。\n却怪你，心偏冷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3497,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"月中柳　湖上春行，同毛稚黄作","author":"沈谦","text":"少年曾共踏青游。\n酒满十三楼。\n香尘不断吼骅骝。\n芳草蓝深，夭桃红浅，白了人头。\n山如屏障周遭在，难抵住、一段闲愁。\n停杯无语思悠悠。\n飞絮蒙天，游丝著地，不要遮留。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3498,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"岁寒三友　夜雨留别张祖望毛稚黄","author":"沈谦","text":"南楼月夜宝灯红。\n一饮千钟。\n诗成镂版，曲就上弦，春似情浓。\n醉卧锦屏，满身花影重。\n流年谁信太匆匆。\n南北西东。\n雨黑今宵话别，衰鬓如霜左耳聋。\n记取后期，桃花黄鹤峰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3499,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"卖花声　晓起买花有感","author":"沈谦","text":"风雨连朝，春色不知馀几。\n见筠篮、粉红香腻。\n高呼低唤，奈绣帘深闭。\n料多娇、惺忪犹未。\n惜花人早，买得酴醾半蕊。\n手擎来、燕随莺睨。\n兰闺昔日，有翠螺新髻。\n今教我、寄将谁是。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3500,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"风中柳　代闺人咏珠","author":"沈谦","text":"掌上时看，只道一生如意。\n露沾花、岂能常缀。\n月满星孤，漫多方比拟。\n泪盈盈、线儿穿起。\n一斛恩深，不是轻躯佳丽。\n倒长拼、玉楼春碎。\n从头细数，有许多心事。\n曾几日、怎都忘记。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3501,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"行香子　赋恨次彭金粟韵","author":"沈谦","text":"眠底谁亲。\n销尽离魂。\n书难寄、白雁红鳞。\n镜儿扑碎，钿合空存。\n倒系人思，牵人恨，惹人嗔。\n深盟厚约，搏酥拌蜜。\n奈而今、远隔河津。\n愁须有分，梦也无因。\n记水边花，窗边月，枕边云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3502,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"厌金杯　吴山雪望","author":"沈谦","text":"山接荒城，沙昏断浦。\n倚危栏、江天欲暮。\n六花纷绕，扑面更沾衣，难挥去。\n似我离情最苦。\n兽烟不断，貂锦添寒，恰又是、潮生风怒。\n素车白马，人道子胥魂，公莫舞。\n一醉愁销万古。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3503,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"解佩令　寄丁象严","author":"沈谦","text":"白龙湖畔，黑龙山上，记当初、柳吟花醉。\n善写伤心，强做出、湘潭憔悴。\n到中年、以愁为讳。\n江鱼不上，江鸿不度，便相思、芳馨难寄。\n唱彻新歌，杯在手、都成愁泪。\n趁西风、洒君衣袂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3504,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"殢人娇　别情","author":"沈谦","text":"斜月笼花，恨杀邻鸡无赖。\n人倦起、强持裙带。\n褰帏絮语，道残灯犹在。\n留不住、便缓些见何害。\n云亸垂鬟，山低接黛。\n弹粉泪、传觞心懈。\n紫骝嘶紧，在绿杨烟外。\n全不管、此际殢人娇态。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3505,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"垂丝钓　寒夜","author":"沈谦","text":"灯明翠幄。\n离愁今夜偏恶。\n坐看结双花、镇寂寞。\n成担阁。\n教侍儿剪却，何曾着。\n把薰笼自摸。\n睡时又怕，被儿也不单薄。\n模糊旧约，揉碎花笺嚼。\n听尽三更柝。\n鸡声咿喔，又萧萧雪落。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3506,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"青玉案　幽期","author":"沈谦","text":"望中渺渺相思路。\n便咫尺、难来去。\n幽梦虽轻吹不度。\n画堂南畔，玉栊西面，谁是无人处。\n隔墙花暝春风暮。\n青鸟仙书无一句。\n总是伊家真个许。\n晚云笼罩，重门深闭，又下黄昏雨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3507,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"青玉案 美人眉","author":"沈谦","text":"卷帘深坐苔痕浅。\n知心里、将谁怨。\n袅袅蛾儿新出茧。\n何段京兆，自胜虢国，十样随人换。\n镜中巧抹春山远。\n病起无端又重看。\n有限青颦愁不断。\n暂时佳会，此生薄福，消得梁鸿案。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3508,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]