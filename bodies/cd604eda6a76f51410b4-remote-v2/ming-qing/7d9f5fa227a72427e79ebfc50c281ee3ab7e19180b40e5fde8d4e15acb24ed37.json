[{"title":"琅琊王歌辞八首 其二","author":"陈恭尹","text":"人言琅琊贤，我独未曾说。\n长揖交戟中，左右惊吐舌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6529,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"琅琊王歌辞八首 其三","author":"陈恭尹","text":"飞花亦有蒂，浮梗故有根。\n四体如轻埃，因风集谁门。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6530,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"琅琊王歌辞八首 其四","author":"陈恭尹","text":"长安八水背，清渭流最急。\n一夜西北风，怒涛寒自立。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6531,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"琅琊王歌辞八首 其五","author":"陈恭尹","text":"琅琊大道王，更唱琅琊曲。\n侧有如花人，许以英雄目。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6532,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"琅琊王歌辞八首 其六","author":"陈恭尹","text":"剑室双金龙，夜夜鸣中箧。\n不能青天飞，枉用张鳞鬣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6533,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"琅琊王歌辞八首 其七","author":"陈恭尹","text":"天不借日月，日月终经天。\n虎不借深山，藜藿生路边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6534,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"琅琊王歌辞八首 其八","author":"陈恭尹","text":"宝马鸣春风，马上人如龙。\n下马道姓名，言是广平公。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6535,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雀劳利歌","author":"陈恭尹","text":"苍鹰飞飞雀劳利，高者逢之下得计。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6536,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"折杨柳歌五首 其一","author":"陈恭尹","text":"白羽照秋月，丽服明春风。\n朝来试马蹄，踯躅垂杨东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6537,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"折杨柳歌五首 其二","author":"陈恭尹","text":"家居杨柳下，直路西北驰。\n望郎不可见，折尽门前枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6538,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"折杨柳歌五首 其三","author":"陈恭尹","text":"放马在南涧，马嘶时向北。\n龙出渥洼中，万人皆辟易。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6539,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"折杨柳歌五首 其四","author":"陈恭尹","text":"河北望河南，杨柳郁森森。\n蕃汉虽二域，春风无两心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6540,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"折杨柳歌五首 其五","author":"陈恭尹","text":"左手櫜健弓，右手结柔辔。\n抽出腰下刀，深勒燕山字。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6541,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"企喻歌四首 其一","author":"陈恭尹","text":"男儿欲作健，不用持弓槊。\n狮子一顾笑，百兽毛自落。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6542,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"企喻歌四首 其二","author":"陈恭尹","text":"放马在大野，草浅马腾跃。\n铁作身上衣，明朝为君着。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6543,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"企喻歌四首 其三","author":"陈恭尹","text":"前营看后营，万马肃无声。\n前军看后军，大旆蔽平原。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6544,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"企喻歌四首 其四","author":"陈恭尹","text":"男儿堕地日，会有冲天时。\n泰山与鸿毛，各是人所为。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6545,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"捉搦歌四首 其一","author":"陈恭尹","text":"好月在天常患缺，硬弓在櫜常患折。\n男儿穷居苦无骨，老女不嫁忌嫁毕。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6546,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"捉搦歌四首 其二","author":"陈恭尹","text":"两株银杏江边老，花者是公实者母。\n天生神物必有偶，独坐空房今白首。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6547,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"捉搦歌四首 其三","author":"陈恭尹","text":"路傍古井人所食，清浅分明辨沙砾。\n可邻照影多行客，不见须眉见巾帼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6548,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"捉搦歌四首 其四","author":"陈恭尹","text":"江东蔗竿长丈二，中间可啖两头弃。\n少年往矣老不济，四十五十无多岁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6549,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"陇头流水歌辞三首","author":"陈恭尹","text":"陇头流水，流离四注。\n念我劳人，终身霜露。\n弱水可途，坚冰在须。\n时无英雄，咄哉丈夫。\n上阪下阪，秦川在眼。\n左手把鞭，足不能前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6550,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"月节折杨柳歌十三首 其一 正月歌","author":"陈恭尹","text":"野雪犹未开，水边与林上，次第送青来。\n折杨柳，不知思已深，只讶春何久。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6551,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"月节折杨柳歌十三首 其二 二月歌","author":"陈恭尹","text":"红碧两参差，芳香满林薄，望欢殊未来。\n折杨柳，我有千里心，愿寄双飞鸟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6552,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"月节折杨柳歌十三首 其三 三月歌","author":"陈恭尹","text":"采薇薇已柔，东西复南北，念子何时休。\n折杨柳，持为七宝鞭，追逐骅骝后。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6553,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"月节折杨柳歌十三首 其四 四月歌","author":"陈恭尹","text":"寒消时未暑，梅子欲成黄，摽落当谁取。\n折杨柳，青春不可追，长条已堪扫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6554,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"月节折杨柳歌十三首 其五 五月歌","author":"陈恭尹","text":"家带辟兵符，螳螂诚有斧，不足禦隆车。\n折杨柳，刻作孟尝君，才堪役鸡狗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6555,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"月节折杨柳歌十三首 其六 六月歌","author":"陈恭尹","text":"大鸟怒而飞，海水方飘扬，浩涆将焉归。\n折杨柳，天作飓母风，四面来吹子。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6556,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"月节折杨柳歌十三首 其七 七月歌","author":"陈恭尹","text":"杨州牛女纪，孟月渡河秋，人间复何似。\n折杨柳，蟢子识窗前，誇道天孙巧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6557,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"月节折杨柳歌十三首 其八 八月歌","author":"陈恭尹","text":"云气方四除，明月有正色，依依照吾庐。\n折杨柳，斫尽碍门枝，不患秋光少。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6558,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"月节折杨柳歌十三首 其九 九月歌","author":"陈恭尹","text":"零露已为霜，秾华不堪玩，晚菊馀芬芳。\n折杨柳，疏密葺藩篱，不负重阳酒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6559,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"月节折杨柳歌十三首 其十 十月歌","author":"陈恭尹","text":"天净北风高，鹰隼盘空中，意气真雄豪。\n折杨柳，镞取董泽蒲，一试穿杨手。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6560,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"月节折杨柳歌十三首 其十一 十一月歌","author":"陈恭尹","text":"大野极群阴，万物方嗷嗷，一复见天心。\n折杨柳，立表测土中，短长占日晷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6561,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"月节折杨柳歌十三首 其十二 十二月歌","author":"陈恭尹","text":"水泽腹已坚，坎险化为夷，走马渡长川。\n折杨柳，杨柳不成阴，濯濯青松老。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6562,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"月节折杨柳歌十三首 其十三 闰月歌","author":"陈恭尹","text":"历象有前期，天王在门中，百辟盛威仪。\n折杨柳，四序相周流，盈虚信天道。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6563,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"日重光","author":"陈恭尹","text":"日重光，奈何鸡方鸣。\n日重光，昨日之日，固当舍我而行。\n日重光，懔乎若渊上之春冰。\n日重光，过中则昃西倾。\n日重光，年在壮盛难恒。\n日重光，譬如大将，背水阵兵。\n日重光，照是下土下氓。\n日重光，追膻逐臭如蝇。\n日重光，唯有达者成名。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6564,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"月重轮","author":"陈恭尹","text":"月重轮，照天下。\n使天若无明月，万古当为长夜。\n何夜无月，月有虚盈。\n谁为匪民，达者成名。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6565,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋行四首 其一","author":"陈恭尹","text":"乱竹微开一角，莫云远带孤村。\n人到绿杨下马，屋迎秋水开门。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6566,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋行四首 其二","author":"陈恭尹","text":"万峰谷里村路，独木桥西酒家。\n对客山翁白发，当垆老妇黄花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6567,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋行四首 其三","author":"陈恭尹","text":"旧宫荒草何处，莫日芦花系船。\n渔子数灯归尽，江潭一雨萧然。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6568,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋行四首 其四","author":"陈恭尹","text":"酒醒已离孤店，灯残莫写乡书。\n晓月啼猿未已，秋山匹马归欤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6569,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"何友大问余病于寒塘","author":"陈恭尹","text":"十里雕胡渚，劳君艇子来。\n棹移花下雨，人上水边台。\n少别经三月，深情尽一杯。\n病馀存舌在，今夜话能陪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6570,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"醉夜","author":"陈恭尹","text":"黄云峰外雨，雨后别山公。\n客醉溪桥滑，人归夜火红。\n旅魂思北首，病骨入西风。\n长叹厓门上，明朝路又东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6571,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"七月八日早行","author":"陈恭尹","text":"行子及清晨，鸣鸡在四邻。\n星沈牛女夜，烛照别离人。\n树势迷前侣，江涛怯病身。\n遥遥荡舟子，招手荻花津。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6572,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"病柳","author":"陈恭尹","text":"黄落亦复好，青青将若何。\n受人怜不久，当路折偏多。\n艳节成虚往，严霜幸未过。\n金城旧栽处，流涕怨蹉跎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6573,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"拟古三首 其一","author":"陈恭尹","text":"橘子始可食，往往辞其枝。\n孝子方欲养，父母长别离。\n墓上椎牛羊，不如生蒸梨。\n高爵耀闾里，无亲持慰谁。\n魂梦中夜来，九原知不知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6574,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"拟古三首 其二","author":"陈恭尹","text":"寄生在高树，树枯枝不繁。\n托身共生死，所惜非同根。\n昔我三小弟，俊迈难具论。\n国难一时尽，反令愚者存。\n岂无友朋好，终念骨肉恩。\n不见蒲苇中，鸿雁相飞翻。\n双雁飞上天，孤雁无与言。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6575,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"拟古三首 其三","author":"陈恭尹","text":"射虎射石头，始知箭锋利。\n居世逢乱离，始辨英雄士。\n我生良不辰，京洛风尘起。\n生死白刃间，壮心未云已。\n猛士不带剑，威武岂得申。\n丈夫不报国，终为愚贱人。\n中夜召仆夫，将适赵与秦。\n方建金石名，安念血肉身。\n抗手谢俦侣，明日西问津。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6576,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"夜发甘竹滩","author":"陈恭尹","text":"滩头潮落树昏昏，夜半移舟出水村。\n一渚暗云迷大雁，片帆春雨下江门。\n愁来每失芳菲节，老去多惭父母恩。\n明日冈州花下醉，此心持与故人言。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6577,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"代闺人新月","author":"陈恭尹","text":"夫婿远邀勋，金鞍西入秦。\n空闺见新月，终夜惜青春。\n似镜难全掩，如眉不解颦。\n为衔将落影，持照未归人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6578,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宿董无休五羊寓舍留别","author":"陈恭尹","text":"雨歇空堂秋气生，酒杯无惜坐深更。\n扁舟此去复为客，一宿缘君暂到城。\n夜月几时还共照，楚山应恨不同行。\n西风万里传书处，待汝题诗赠屈平。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6579,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"别杨无见因柬冈州同人","author":"陈恭尹","text":"结束远行迈，未行先送君。\n秋江下白露，今夜向黄云。\n此别渺难定，临岐何易分。\n还将努力意，传语故人闻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6580,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"发舟寄湛用喈钟裴仙湛天石","author":"陈恭尹","text":"扶胥古渡水凄凄，雨后移舟望转迷。\n数口寄居秋草外，一身为客楚云西。\n家无兄弟依良友，地夹河山畏鼓鼙。\n知己片言应不负，乱离妻子藉提携。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6581,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"留别诸同人","author":"陈恭尹","text":"霏微残月晓风寒，生死交情话别难。\n入楚客无燕匕首，送行人有白衣冠。\n舟辞香浦鸿初到，马踏梅关雪渐看。\n后会不须期故国，中原天地本来宽。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6582,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"度大庾岭","author":"陈恭尹","text":"向风长叹草萧萧，山压重门石气骄。\n千古霸图俱寂寞，再来行迹尚渔樵。\n寄书黄木湾何处，走马红梅驿渐遥。\n欲扫苍厓记名姓，少年时已薄题桥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6583,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"江上别卢非玉","author":"陈恭尹","text":"重逢又是异乡行，一月孤帆共北征。\n江上路分彭蠡泽，雪中人向岳阳城。\n停舟此地丹枫色，买醉当垆玉笛声。\n别后想君歌舞夜，姑苏南望倍含情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6584,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送涤公","author":"陈恭尹","text":"涤公到城久，忽忆丘中琴。\n积雪移孤棹，寒湘共此心。\n独归红树外，相待白云深。\n语我茅庵路，衡山在隔林。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6585,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自励诗","author":"陈恭尹","text":"闻道岂必早，立德苦不固。\n嗟余困蒙弱，老大犹未树。\n五十不称夭，蹉跎已中路。\n逝者诚已矣，来兹可无惧。\n先民诏遗矩，乃在行其素。\n外物焉足希，澄心任所遇。\n每戒出位思，恒存周身虑。\n毋曰独居暗，几微渐成著。\n毋曰戏谑小，君子有常度。\n穴防终以决，往水不返溯。\n庶几日三复，反躬永无恶。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6586,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湘潭除夕","author":"陈恭尹","text":"束屩志万里，岁尽犹在兹。\n茅堂闭积雪，高卧湘川湄。\n邻家节序意，寒笛参差吹。\n佳人急刀剪，中夜闻声辞。\n留滞感未弭，景物情难持。\n褰衾盖蓬首，托寐通所思。\n故乡有馀梦，所思渺无期。\n寤叹击床蓐，反侧伤肝脾。\n人言有彼此，道远不可知。\n吁嗟壮士怀，岁尽增遥悲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6587,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠郭幼隗 其一","author":"陈恭尹","text":"陶公羲皇人，济世心复苦。\n违时弃经纶，养节薄簪组。\n微言寄简策，容色尚可睹。\n昔人云已邈，之子蹈前矩。\n林园发新咏，往往见肺腑。\n以置彭泽中，识者昧去取。\n匪直英华美，秉心亦犹古。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6588,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠郭幼隗 其二","author":"陈恭尹","text":"驽马出大宛，絷之在汉闼。\n长鸣眷西极，万里走空阔。\n物老德不称，筋衰力先夺。\n繁阴盛淫雨，修途泞不达。\n侧首见骅骝，尘中问饥渴。\n言恋父母国，已恐贰师拔。\n踟蹰立长坂，泪杂沟中沫。\n苜蓿未可希，生刍欲归秣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6589,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湘上寄梁器圃","author":"陈恭尹","text":"湘皋气候暖，风物犹近粤。\n雪在野际青，春迟柳间蘖。\n出郊践芳草，怨与王孙别。\n河桥一分手，六满汀洲月。\n靡月不相思，矧伊艳阳节。\n想见山阿人，行歌散玄发。\n衡阳有归雁，逖矣嵇生札。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6590,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送雪公归耕苍梧歌","author":"陈恭尹","text":"苍鹰六翮不上天，化为春鸠啄人田。\n壮士有力不搏虎，两角肥牛耕瘠土。\n毛摧羽落君莫叹，龙屈蛇伸自终古。\n送君耕，耕何所。\n上有苍梧之深山，下有牂牁之长浦。\n浦下山田田上墅，荷锸来归日当午。\n曲枕右肱树左股，万事不理望膏雨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6591,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湘上读书柬郭幼隗","author":"陈恭尹","text":"高天何寥廓，茅屋十馀尺。\n上有飞晨风，下有不归客。\n重衣垢以敝，散帙黯无色。\n仰首惭壮夫，垂心事雕刻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6592,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"答别郭幼隗","author":"陈恭尹","text":"天涯何意返征骖，惨澹离怀酒不酣。\n匝地柳条青汉上，断肠春草绿湘南。\n难归故国生多恨，有约乘桴去亦堪。\n沧海茫茫一回首，美人迟暮在江潭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6593,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"发舟中湘将登南岳","author":"陈恭尹","text":"芳草绿未已，孤舟发南湘。\n还当上巳日，远适衡山阳。\n石积水光碎，竹多风响长。\n客途春有酒，波荡感浮觞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6594,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宿罗克生","author":"陈恭尹","text":"衡山三十里，樵子识君家。\n一路杉松雨，开门桃李花。\n乍逢如宿昔，未老亦烟霞。\n叹息青灯夜，春衣冷欲加。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6595,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]