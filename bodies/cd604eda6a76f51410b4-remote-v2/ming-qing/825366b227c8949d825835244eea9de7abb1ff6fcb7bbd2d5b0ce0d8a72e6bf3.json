[{"title":"途中遇雨作","author":"屈大均","text":"行子冒风雨，连朝饥且寒。\n一身徒自苦，十口不曾安。\n路断愁多水，林香喜有兰。\n野花休见笑，吾道本艰难。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9654,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"化州道中","author":"屈大均","text":"百里尽珍禽，林中交好音。\n落花封虎迹，流水澹人心。\n误踏峰峰叶，贪眠处处阴。\n仆夫忧日暮，驱马去骎骎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9655,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送客上葵州","author":"屈大均","text":"水从三峡落，峰向二禺回。\n雪喷潮难上，雷轰石不开。\n鸟怜南翥好，花恨北枝催。\n碧落仙人洞，藏书待尔来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9656,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"遂溪道中","author":"屈大均","text":"车辗空林响，深愁虎豹闻。\n路从山鬼问，身与仆夫分。\n日气含残雨，天葩散白云。\n声声行不得，负尔鹧鸪群。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9657,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"次沙浐","author":"屈大均","text":"四野无蛮落，荒鸡何处声。\n风惊双鹘出，月照一人行。\n点鬓愁霜早，沾衣喜露轻。\n丈夫矜七尺，饥渴见生平。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9658,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"次闸口","author":"屈大均","text":"忽自投豺虎，生还亦偶然。\n路迷千里瘴，行尽九真天。\n梦里知亲病，贫中赖妇贤。\n那能如孔雀，身上有金钱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9659,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"廉州杂诗 其一","author":"屈大均","text":"象郡元秦塞，龙门是汉关。\n天开珠母海，地接桂林山。\n交趾兵频入，戈船使未还。\n何时铜柱折，吾见灭南蛮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9660,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"廉州杂诗 其二","author":"屈大均","text":"海上馀珠市，城中尽竹房。\n居临鲛室近，望入象林长。\n野旷秋无色，江清水有霜。\n炎州惟此地，风景最荒凉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9661,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"廉州杂诗 其三","author":"屈大均","text":"城西江水贯，妇女卖鱼桥。\n珠母生明月，鲛人出紫绡。\n海光千里接，霞气五黄标。\n何处大廉洞，人传药草饶。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9662,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"廉州杂诗 其四","author":"屈大均","text":"六池光潋滟，寒动郡城楼。\n分野非东粤，炎荒亦早秋。\n伏波瞻汉庙，弃地恨交州。\n一夕廉山宿，凄凉欲白头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9663,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"廉州杂诗 其五","author":"屈大均","text":"玳瑁乘生水，蚺蛇吐毒云。\n花从江口合，茅向岭头分。\n铜鼓交蛮器，金标汉将勋。\n青牛城上望，怀古思氤氲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9664,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"廉州杂诗 其六","author":"屈大均","text":"珠随明月满，半作泪光流。\n独立当蟾兔，相思若女牛。\n投荒频自苦，入海欲谁求。\n忍使闺中子，离颜一片秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9665,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"廉州杂诗 其七","author":"屈大均","text":"下马还珠驿，山光见百良。\n徉狂贤太守，零落古封疆。\n碑没莓苔字，堂虚俎豆香。\n汉家今已矣，凭吊泪沾裳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9666,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"廉州杂诗 其八","author":"屈大均","text":"岂意珠官郡，珠娘艳色多。\n褰裙临水汲，跣足踏花过。\n钱辩开元字，筝调合浦歌。\n酒浆频献客，甘有蔗霜和。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9667,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"廉州杂诗 其九","author":"屈大均","text":"汉代经营地，今馀蔓草长。\n军无新息将，女作麋冷王。\n烟重鸢频堕，霜高桂自芳。\n越州城下水，流尽泪汤汤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9668,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"廉州杂诗 其十","author":"屈大均","text":"白龙池最大，百里尽珠胎。\n赤子兵频弄，红夷舶恐来。\n边墙殊未筑，海界已先开。\n此地成云朔，劳君鼓角哀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9669,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"廉州杂诗 其十一","author":"屈大均","text":"甘蔗新调粉，斑枝未脱绵。\n捉人餐玉鲙，留客取金鞭。\n鹦鹉虽多慧，桃花已悟禅。\n为卿书讽赋，不惜练巾妍。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9670,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"廉州杂诗 其十二","author":"屈大均","text":"殷勤求孔雀，迢递自防城。\n五岁金花满，三年小尾成。\n文章聊自喜，饮啄不须惊。\n莫使珠毛损，樊笼足寄情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9671,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"廉州杂诗 其十三","author":"屈大均","text":"去苦炎天远，归愁白发多。\n珠光秋吐纳，铜表日摩挲。\n披发怜交趾，扬威忆伏波。\n陆沉殊末已，何处有关河。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9672,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"廉州杂诗 其十四","author":"屈大均","text":"百里无烟火，林峰气郁苍。\n月中穿虎口，花里转羊肠。\n命有三人托，身馀一剑防。\n间关差不负，诗句即金装。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9673,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"高廉雷三郡旅中寄怀道香楼内子 其一","author":"屈大均","text":"美人居莞水，游子在崧台。\n一片闺中月，清光夜夜来。\n泪痕知满镜，行处定生苔。\n白露秋方冷，芙蓉勉自开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9674,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"高廉雷三郡旅中寄怀道香楼内子 其二","author":"屈大均","text":"月井蜘蛛度，花轩翡翠过。\n风长怜柳弱，水绿恨萍多。\n瘦出飞龙骨，凉添孔雀罗。\n裁书频见寄，细腻写曹娥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9675,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"高廉雷三郡旅中寄怀道香楼内子 其三","author":"屈大均","text":"知尔绣桂香，别来双带长。\n三秋多怨曲，七夕定新妆。\n珠掠盘明月，花梳间海棠。\n针楼如有梦，西去即高梁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9676,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"高廉雷三郡旅中寄怀道香楼内子 其四","author":"屈大均","text":"棋局閒楸玉，熏炉冷郁金。\n半年为伉俪，三度作商参。\n菡萏新含的，芭蕉好展心。\n学诗诸弟子，刘碧最知音。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9677,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"高廉雷三郡旅中寄怀道香楼内子 其五","author":"屈大均","text":"甘蔗茎多汁，槟榔子满房。\n道中虽解渴，闺里更生香。\n马上苔痕滑，车盘石磴长。\n飞飞合浦叶，何日始还乡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9678,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"高廉雷三郡旅中寄怀道香楼内子 其六","author":"屈大均","text":"日日廉阳道，愁攀碧柳枝。\n可怜千万缕，总是一相思。\n海女开珠玉，蛮童斗画眉。\n夜光应购得，归作耳珰垂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9679,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"高廉雷三郡旅中寄怀道香楼内子 其七","author":"屈大均","text":"此日称闺秀，三娘复令娴。\n贫愁书卷少，病惜笔床閒。\n组绣凭双媵，钗钿买一山。\n心光怜水月，禅坐碧池间。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9680,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"高廉雷三郡旅中寄怀道香楼内子 其八","author":"屈大均","text":"遂我幽栖志，平生得孟光。\n况兼鸾凤彩，益助薜萝香。\n月夕联珠句，花晨对羽觞。\n不须怀媚蝶，欢爱在文章。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9681,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"高廉雷三郡旅中寄怀道香楼内子 其九","author":"屈大均","text":"赤蟹秋来美，蛮娘素手分。\n心憎巾影拂，梦恨鬓花薰。\n椰子含甘液，伽南吐紫氛。\n幽闺人正苦，不忍恋徐闻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9682,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"高廉雷三郡旅中寄怀道香楼内子 其十","author":"屈大均","text":"课妾香奁体，娱姑绿绮声。\n燠寒勤诊问，甘毳苦经营。\n庑下书能著，墙东隐已成。\n因人又于役，贫使别离轻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9683,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"高廉雷三郡旅中寄怀道香楼内子 其十一","author":"屈大均","text":"驰驱嗟命苦，四十好端居。\n深井宁无里，中田尚有庐。\n堂前呼犬子，膝下玩蚕书。\n莫问霸王事，吾才日以疏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9684,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"高廉雷三郡旅中寄怀道香楼内子 其十二","author":"屈大均","text":"夫人张绣幰，刺史奋罗裙。\n犀杖先朝泪，鸾旗女子军。\n英雄归粉黛，事业比桓文。\n肃肃瞻遗像，题诗一报君。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9685,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"高廉雷三郡旅中寄怀道香楼内子 其十三","author":"屈大均","text":"白发孀姑在，鸡鸣汝问安。\n长先诸妾起，不顾一身寒。\n抹丽装花引，沉香制笔盘。\n新诗多丽则，娣姒定传看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9686,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"高廉雷三郡旅中寄怀道香楼内子 其十四","author":"屈大均","text":"路暗随萤火，行行陷泽中。\n阴森山鬼影，凛冽野鹰风。\n汗洒炎云湿，愁将碧水空。\n幽闺知己在，未拟哭途穷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9687,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"高廉雷三郡旅中寄怀道香楼内子 其十五","author":"屈大均","text":"树树山鹕唤，村村竻竹围。\n炎云秋更起，清露午芳晞。\n高士难求食，佳人易乐饥。\n归与浮峤曲，与子共芝薇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9688,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"未夕","author":"屈大均","text":"未夕见新月，微微如白云。\n牛羊数峰落，烟火一林曛。\n樵女歌声合，渔人艇影分。\n不知花近远，溪口即香闻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9689,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"钦州","author":"屈大均","text":"野外稀禾黍，城中但橐驼。\n愁闻新战斗，忍见旧山河。\n荒服馀交趾，将军忆伏波。\n南征遗玉笛，犹奏武陵歌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9690,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"汪学博携饮罗湖 其一","author":"屈大均","text":"亦有罗湖好，芙蕖散旅愁。\n花花栖海燕，叶叶下江鸥。\n往日多迁客，兹焉弄碧流。\n我来访遗迹，先上二苏楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9691,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"汪学博携饮罗湖 其二","author":"屈大均","text":"随君尊酒去，一一上湖桥。\n童子木兰枻，将军青玉箫。\n暮风生铁飓，春水上咸潮。\n并马严城入，月明还见招。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9692,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"汪学博携饮罗湖 其三","author":"屈大均","text":"中原从此尽，回首奈愁何。\n地控三洋海，人祠二伏波。\n凉应天北少，风是日南多。\n况有澄湖水，亭高出芰荷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9693,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雷阳作","author":"屈大均","text":"鹧鸪啼不已，春草更萋萋。\n地向擎雷尽，天连涨海低。\n中华劳梦寐，白首苦东西。\n杯酒沉冥好，归与有酿溪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9694,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阳江道上逢卢子归自琼州赋赠 其一","author":"屈大均","text":"嗟君南渡海，波浪白吞空。\n三日迷琼岛，中流遇飓风。\n生还自鱼腹，险绝有神功。\n讵料乘槎客，依然道未穷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9695,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阳江道上逢卢子归自琼州赋赠 其二","author":"屈大均","text":"大风吹海啸，舟似转蓬飞。\n竞与波涛斗，私将涕泪挥。\n旌旗过水怪，灯火降天妃。\n欲作玄虚赋，心魂今尚微。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9696,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阳江道上逢卢子归自琼州赋赠 其三","author":"屈大均","text":"波中涌山岳，知是海鳅回。\n势欲吞舟去，光先喷火来。\n不须频拔剑，自可静挥杯。\n忠信豚鱼格，多君学易才。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9697,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阳江道上逢卢子归自琼州赋赠 其四","author":"屈大均","text":"黑风寒挟雨，城没大洋边。\n鱼鳖人谁免，波涛尔独悬。\n行穿龙洞穴，战退鬼楼船。\n莫向高堂道，平生险自怜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9698,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阳江道上逢卢子归自琼州赋赠 其五","author":"屈大均","text":"高帝称奇甸，南溟岂大荒。\n诸华同礼让，一赋重文庄。\n尔去观风土，身先入众香。\n遍书珍异物，词藻照蛮方。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9699,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阳江道上逢卢子归自琼州赋赠 其六","author":"屈大均","text":"天晴空翠满，五指拂云来。\n树树奇南结，家家末丽开。\n野人朝猎去，黎女暮歌回。\n调酒黄獐血，君曾尽几杯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9700,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阳江道上逢卢子归自琼州赋赠 其七","author":"屈大均","text":"首夏过琼甸，槟榔得食花。\n螺杯川上拾，捻酒洞边赊。\n逸兴凌山月，新诗夺海霞。\n买愁村若到，定爱髻鬟斜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9701,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阳江道上逢卢子归自琼州赋赠 其八","author":"屈大均","text":"人人携酿具，处处熟离支。\n一夕香成酒，三危露满卮。\n和风尝衣袷，暑气不侵肌。\n花是槟门好，清芬百里吹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9702,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阳江道上逢卢子归自琼州赋赠 其九","author":"屈大均","text":"方物生黎献，黄麖黑狗熊。\n大旗书向化，小队拜当中。\n宪府宣威德，炎洲息战攻。\n丹青凭尔笔，绘出岛夷风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9703,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阳江道上逢卢子归自琼州赋赠 其十","author":"屈大均","text":"鹦鹉娇能语，猕猴小似拳。\n携归横秀阁，得自会同川。\n子女分葵笠，君王望玉鞭。\n公车应早上，莫即恋林泉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9704,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠黄勉思","author":"屈大均","text":"庐墓今何去，西樵瀑水西。\n故人思寄子，居士已无妻。\n未敢忘沟壑，何当罢鼓鼙。\n离亭相送后，风雨各凄凄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9705,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"东安 其一","author":"屈大均","text":"雨馀苍翠滴，山影满城中。\n谷小人烟合，林疏瘴气通。\n峰峰多石笋，处处有花宫。\n向夕星岩上，摇天一片钟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9706,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"东安 其二","author":"屈大均","text":"匡庐九叠屏，分得一峰青。\n地削芙蓉瓣，天悬瀑布瓴。\n千山连彩翠，半壁障空冥。\n一片城西影，风吹落县庭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9707,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题张氏石鳞山房 其一","author":"屈大均","text":"泷东好岩壑，片石亦嵯峨。\n树树穿云窦，峰峰拂水波。\n落花閒处满，啼鸟静中多。\n君有茆茨在，栖閒奈乐何。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9708,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题张氏石鳞山房 其二","author":"屈大均","text":"四壁苍苔满，晴馀瀑布痕。\n玲珑多洞穴，缭绕尽林园。\n谷口云霞塞，人家彩翠屯。\n九星岩咫尺，城外有啼猿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9709,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题张氏石鳞山房 其三","author":"屈大均","text":"壁峻全如削，峰斜半欲飞。\n云根争络石，玉乳乱沾衣。\n处处梅花覆，村村古木围。\n鹿门妻子在，来此借渔矶。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9710,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寿萧山周斗垣丈","author":"屈大均","text":"高隐湘湖曲，年过九十秋。\n天遗一老在，人以八朝留。\n白发中华物，黄云故国愁。\n仙成将令子，注籍向罗浮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9711,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蝉","author":"屈大均","text":"日夕高槐上，为君吟不飞。\n那惊秋气早，所恐露华晞。\n多患因孤洁，无声亦翠微。\n流泉将落叶，知此不妨希。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9712,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"沙亭作 其一","author":"屈大均","text":"读书慈母侧，千卷绕庭帏。\n山浅难逃世，林幽且掩扉。\n燕衔花蕊重，蝉饮露华微。\n萧散长无事，天留此布衣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9713,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"沙亭作 其二","author":"屈大均","text":"六月收粳稻，人喧陇亩间。\n日光穿白雨，云气涨青山。\n薄酒嫌无力，馀花恨少颜。\n乱离如未已，皓首此柴关。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9714,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"沙亭作 其三","author":"屈大均","text":"复作蓬蒿客，萧然学坐忘。\n白花堆酒美，青果点茶香。\n故国频兴废，新书漫短长。\n弓刀从散失，无意向沙场。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9715,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"沙亭作 其四","author":"屈大均","text":"岂意才难用，英雄作蠹鱼。\n一家憎宝剑，十口食仙书。\n乱后知交尽，愁中啸咏疏。\n故人方转战，消息阻扶胥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9716,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"沙亭作 其五","author":"屈大均","text":"幸不膏原野，归来一杖轻。\n著书宜晚力，为道及馀生。\n土布蕉丝滑，村醪荔液清。\n啸歌应自足，莫负紫芝荣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9717,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"初正沙亭作 其一","author":"屈大均","text":"雨霰微微落，农夫喜湿年。\n寒生除夕后，暖在大冬前。\n避世犹无策，书王亦有权。\n蒸湘方接战，天肯任投鞭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9718,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]