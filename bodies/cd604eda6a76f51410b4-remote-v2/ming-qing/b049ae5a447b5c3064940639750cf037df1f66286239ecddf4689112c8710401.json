[{"title":"上都 其一","author":"屈大均","text":"白酪黄羊捧御娥，貂房半在独峰驼。\n阏氏本是天公主，耳坠金环一倍多。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13568,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"上都 其二","author":"屈大均","text":"墩夹边墙内外长，纷纷庐落绕牛羊。\n白貂绿马边头贵，争换红盐向市场。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13569,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"上都 其三","author":"屈大均","text":"连墩勾堡雁门西，白麦青稞出未齐。\n边女尽能蒙古语，汉儿多作女真啼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13570,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"上都 其四","author":"屈大均","text":"鸳鸯泺上洗妆多，毛锦团铺向芰荷。\n宫女双凫教仰中，放鹞还去打天鹅。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13571,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"上都 其五","author":"屈大均","text":"白马氂牛小种多，新降教负羽林戈。\n天寒围猎乘风雪，两两横吹一海螺。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13572,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"榆林春望 其一","author":"屈大均","text":"清明争插白杨毛，柏叶双簪出鬓高。\n齐上野坟还较射，妇人偏解中秋毫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13573,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"榆林春望 其二","author":"屈大均","text":"腐肉城南久作尘，忠魂十万委黄巾。\n每逢佳节榆中哭，寒食哀声更感人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13574,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"种竹","author":"屈大均","text":"春时即是竹秋时，雨过鞭行更不迟。\n种向西南成笋易，求鱼待取最柔枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13575,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"扶竹","author":"屈大均","text":"扶竹枝枝亦合欢，美人持赠拟琅玕。\n扶桑两两花相比，更采芬馨满玉盘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13576,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西园 其一","author":"屈大均","text":"西田春夏土膏多，一岁栽蔬一岁禾。\n安得农桑来此地，更租塘水种菱荷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13577,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西园 其二","author":"屈大均","text":"茨菰冬种夏芙蕖，茭白菱红卖有馀。\n玉溆金塘连十里，鱼花多放当园蔬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13578,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西园 其三","author":"屈大均","text":"瓜菜西园最有名，芳华苑外野田平。\n菱香藕脆家家有，粳稻花吹暑气清。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13579,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西园 其四","author":"屈大均","text":"斜阳十里尽钟声，兰若相连直接城。\n农圃有僧能食力，露葵香处笑逢迎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13580,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西园 其五","author":"屈大均","text":"西禅古寺枕龟峰，东接浮丘暮霭重。\n少小撒金仙巷住，先人精舍傍芙蓉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13581,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭周处士筜谷 其一","author":"屈大均","text":"白头卖食市门边，手执诗书不数钱。\n舂赁更教人不识，要离地下解相怜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13582,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭周处士筜谷 其二","author":"屈大均","text":"词赋场中最老师，都门友教遍诸旗。\n满洲弟子公卿辈，一一参貂献不迟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13583,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭周处士筜谷 其三","author":"屈大均","text":"客死淮南无故人，一棺江上屡迷津。\n囊中文草知多少，化作芦花满水滨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13584,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭周处士筜谷 其四","author":"屈大均","text":"梅里相知汝最深，鸯湖朱十亦同心。\n平生唱和如胶漆，忍隔黄泉泪满襟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13585,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"生憎","author":"屈大均","text":"生憎芍药是将离，数寄乾归归故迟。\n多捣蛇床作香沐，郎丹更与菟丝宜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13586,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"翠羽 其一","author":"屈大均","text":"罗浮翠羽日啾啾，饱食梅花亦复愁。\n不见美人来树下，月明寒作泪光流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13587,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"翠羽 其二","author":"屈大均","text":"纷纷幺凤向瑶华，收尽香烟不似花。\n绿萼一株餐不尽，衔将数片过东家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13588,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"青溪 其一","author":"屈大均","text":"青溪一片长蘼芜，天上张星作小姑。\n小像沉香薰未已，夷光得似丽华无。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13589,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"青溪 其二","author":"屈大均","text":"胭脂井里殉君王，花作陈宫二女香。\n谁道小姑人不识，美人张孔两鸳鸯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13590,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"青溪 其三","author":"屈大均","text":"青溪一道秦淮接，桃叶桃根总在兹。\n六代风流归此地，何人不拜女郎祠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13591,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其一","author":"屈大均","text":"频年失志卧林丘，正赖佳人慰四愁。\n欲写三闾哀怨曲，今无丽玉引箜篌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13592,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其二","author":"屈大均","text":"玉琴空怨雉朝飞，岁晚吴门生计微。\n庑下无人来馈食，堂前有母为缝衣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13593,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其三","author":"屈大均","text":"零落香魂去不回，黄泉应上望夫台。\n他生不愿为夫妇，但作罗浮蛱蝶来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13594,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其四","author":"屈大均","text":"将军贶室怜清苦，玉帛还劳子大夫。\n多谢寓公言好结，千秋嘉耦一朝无。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13595,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其五","author":"屈大均","text":"频辞板屋从君子，自是秦风爱德音。\n我有西戎征战志，小戎日夕为君吟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13596,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其六","author":"屈大均","text":"明星玉女羡乘龙，白帝为媒得彼秾。\n一自丈夫毛女合，华山今有丈人峰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13597,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其七","author":"屈大均","text":"将军战败斩旌旗，身作长城控月氏。\n夜半鼓声寒不起，可怜冰上弃孤儿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13598,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其八","author":"屈大均","text":"三秋苦战在黄沙，血作胭脂山上花。\n孝有曹娥曾弗子，忠如去病不为家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13599,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其九","author":"屈大均","text":"来时哭度雁门关，酹酒明妃白草间。\n胡越可怜俱远嫁，梦魂空逐雁飞还。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13600,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其十","author":"屈大均","text":"八月风高放角鹰，行行游猎十三陵。\n随夫北岳攀阴雪，抱子桑乾履薄冰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13601,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其十一","author":"屈大均","text":"一鞭朝出纥真束，花颔娇嘶万里风。\n忆向阏氏营上过，蛮姬争进乳茶红。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13602,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其十二","author":"屈大均","text":"九月云中道路难，雪花如掌打征鞍。\n可怜生女方弥月，使出兰闺犯岁寒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13603,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其十三","author":"屈大均","text":"娘子城边忆打围，鸾靴上马疾如飞。\n儿夫不忍弯弓射，心爱双双白兔肥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13604,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其十四","author":"屈大均","text":"汝爱秦淮不忍唾，清波留取照妆妍。\n兰叶舟过桃叶渡，忆君乘月看灯船。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13605,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其十五","author":"屈大均","text":"小姑山过大姑来，白浪如山山欲摧。\n汝畏风波不敢涉，却思飞鞚白龙堆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13606,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其十六","author":"屈大均","text":"绣床针帖委花间，自到炎方病不閒。\n荔子何曾亲玉齿，槟门未解发红颜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13607,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其十七","author":"屈大均","text":"正欲移家向莫愁，高堂共上木兰舟。\n龙盘虎踞惟江左，儿女乘时亦拜侯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13608,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其十八","author":"屈大均","text":"尽将钗珥遗娇女，空有图书殉少君。\n小像唾绒卿自绣，朝朝哭把水沉薰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13609,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其十九","author":"屈大均","text":"不复窗前畜画眉，不须山上采燕支。\n燕支已作断肠草，画眉今亦变相思。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13610,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其二十","author":"屈大均","text":"不对芙蓉赋不成，愁来兼罢玉琴声。\n可怜四壁空寥廓，慢世无人共长卿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13611,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其二十一","author":"屈大均","text":"商瞿白发欲成丝，沐犊琴歌更自悲。\n珠母不愁生子晚，鸾胶只恨续弦迟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13612,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其二十二","author":"屈大均","text":"养母依然独采薇，无人为制老莱衣。\n卿卿自是将军女，不合身随野鹤飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13613,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其二十三","author":"屈大均","text":"此日梁鸾高节少，自惭无以报糟糠。\n当年择对成何事，误把今狂作古狂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13614,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其二十四","author":"屈大均","text":"哀蝉落叶满高秋，银烛随风泪尽流。\n梦里哭声惊阿母，频令白发抱深愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13615,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其二十五","author":"屈大均","text":"甘瓜苦蒂久相离，子母方将钩带时。\n正喜堂前三妇艳，丈人安坐听调丝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13616,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其二十六","author":"屈大均","text":"大妇今朝罢绮罗，高堂寂寞泪痕多。\n方知北地风霜惨，亦胜南天瘴疠和。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13617,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其二十七","author":"屈大均","text":"燠寒谁问老亲衣，作鲙今朝亦已希。\n忆得姜家新妇在，泉中跃出鲤鱼肥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13618,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其二十八","author":"屈大均","text":"顾家针线巧相同，酒馔全凭十指功。\n此日高堂因待客，犹令截发作双鬉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13619,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其二十九","author":"屈大均","text":"丈人思尔固原还，白发侯嬴正抱关。\n小妹雍容兄更念，褰裙逐马朔云间。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13620,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其三十","author":"屈大均","text":"情知粉黛久无心，国破家亡泪不禁。\n但使先臣千载见，何妨贱妾一朝沈。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13621,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其三十一","author":"屈大均","text":"泪洒罗浮万壑中，春花尽作杜鹃红。\n东家蝴蝶西家燕，双宿双飞命不同。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13622,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其三十二","author":"屈大均","text":"相寻日向墓林来，同穴无期更可哀。\n卿若见怜人寂寂，殷勤一为把棺开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13623,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其三十三","author":"屈大均","text":"祔葬先公珠海湄，三春烟雨暗棠梨。\n白蘋岁有宗人荐，黄绢争题孝妇碑。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13624,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其三十四","author":"屈大均","text":"才人命薄古来然，消得香闺几日怜。\n一代文章今已矣，更无知己似卿贤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13625,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其三十五","author":"屈大均","text":"明月舒光乍上枝，梦残空使楚王悲。\n无情最是巫山女，暮雨朝云只片时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13626,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其三十六","author":"屈大均","text":"怀中保子二龄馀，弄尔西窗旧读书。\n我指卿卿新画像，可怜未解泪沾裾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13627,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其三十七","author":"屈大均","text":"贳酒为欢正未央，黄泉一旦作参商。\n他时谁作相如诛，更把遗书上建章。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13628,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其三十八","author":"屈大均","text":"红颜自古命如尘，早返蓬山作上真。\n不见棺中双彩履，那知钩弋是仙人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13629,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其三十九","author":"屈大均","text":"泪满罗纨赋未成，佳人永暮不胜情。\n可怜今日江郎笔，不画蛾眉花不生。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13630,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其四十","author":"屈大均","text":"春色无情去镜台，百花今日为谁开。\n可怜五色收香鸟，曾得钗头立几回。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13631,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其四十一","author":"屈大均","text":"醉卧当垆红粉边，风流谁信阮公贤。\n闺中此日无良友，被发狂歌更可怜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13632,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其四十二","author":"屈大均","text":"行行泪滴楚天西，谁与狂歌玉手携。\n佳丽世间应不少，冰清那得接舆妻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13633,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其四十三","author":"屈大均","text":"平生五岳兴翩翩，因恋朱颜不复前。\n潘岳只今无内顾，迢迢一任越山川。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13634,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其四十四","author":"屈大均","text":"素女忽归天汉去，孤猿空有玉环留。\n从今不娶神仙妇，未有恩情到白头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13635,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其四十五","author":"屈大均","text":"去岁中秋三五夕，鸳鸯归到粤江边。\n高堂满酌葡萄酒，笑道人同明月圆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13636,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其四十六","author":"屈大均","text":"夜永翻愁玉漏催，梦魂无计入泉台。\n丈夫泪向闺中尽，惭愧当年学道来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13637,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其四十七","author":"屈大均","text":"往日京师事远征，如何束带待鸡鸣。\n芳香四种兼明镜，未尽秦嘉赠妇情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13638,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其四十八","author":"屈大均","text":"雁门当日见容华，早识桃名短命花。\n单枕一宵如荡子，同衾两载绝倡家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13639,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其四十九","author":"屈大均","text":"一夕秋风蕙草摧，何当燕婉向泉台。\n天将艳色倾荀粲，不许中庭取冷来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13640,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其五十","author":"屈大均","text":"夫人遂与甘陵似，不遇华陀绝可怜。\n更比炎妻新乳死，仓皇何处得神仙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13641,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]