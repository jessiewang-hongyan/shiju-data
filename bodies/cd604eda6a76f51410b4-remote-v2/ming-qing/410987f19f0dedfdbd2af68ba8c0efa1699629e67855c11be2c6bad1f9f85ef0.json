[{"title":"秋日自广至韶江行有作 其二十三","author":"屈大均","text":"香炉峡口女英雄，巫峡风流事不同。\n古庙千章唐代木，舟人再拜祝长风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13714,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其二十四","author":"屈大均","text":"峰峰横作锦屏长，瀑水纷纷断石梁。\n烟雨峡门开复阖，绝愁无路入英阳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13715,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其二十五","author":"屈大均","text":"篙子弯弯尽似弓，朝来撑破几莲蓬。\n玲珑石壁多虫蛀，一缕云穿藕孔中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13716,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其二十六","author":"屈大均","text":"篙篙如箭复如弓，苦水何当又苦风。\n绝似射潮罗刹浦，素车白马与争雄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13717,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其二十七","author":"屈大均","text":"三朝愁杀打头风，吹起帆樯似转蓬。\n苦与崩厓作勍敌，灵胡赑屃作篙工。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13718,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其二十八","author":"屈大均","text":"舟缘铁壁几回环，蜗角相争卷石间。\n已苦笼头横浅濑，还愁鳖背隐深湾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13719,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其二十九","author":"屈大均","text":"一滩一尺上惊雷，力尽波涛杀不回。\n下水人歌上水哭，风声哀杂水声哀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13720,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其三十","author":"屈大均","text":"夹岸交加百丈多，九夫如哭一如歌。\n杀声凄惨因风水，惊起沙禽拂面过。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13721,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其三十一","author":"屈大均","text":"崖光石滑总篙痕，撑起熊罴百丈蹲。\n斗大龙蛇题不得，墨濡头发向天门。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13722,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其三十二","author":"屈大均","text":"弹子谁穿石壁来，篙篙空洞触轻雷。\n频从花底惊猿狖，接臂相将绝巘回。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13723,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其三十三","author":"屈大均","text":"北风吹船船上天，九夫蒲伏一夫牵。\n梢公出没白头浪，处处叫滩声可怜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13724,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其三十四","author":"屈大均","text":"峡尽清江曲曲开，白沙深映碧潆洄。\n秋光流出如明月，一片空青天外来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13725,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其三十五","author":"屈大均","text":"湾环又苦大横矶，石势争随水倒飞。\n峡短滩长撑不上，眠篙不道女郎非。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13726,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其三十六","author":"屈大均","text":"英州有石尽玲珑，细作峰峦尺寸中。\n石市买来多石丈，米颠怀里总华嵩。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13727,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其三十七","author":"屈大均","text":"石似青天天不如，青青应是补天馀。\n灵娲不采英州石，五色空劳炼太虚。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13728,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其三十八","author":"屈大均","text":"牵舟不上几逡巡，岩势争飞欲压人。\n齿角峰高相抵触，苦将韶石斗嶙峋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13729,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其三十九","author":"屈大均","text":"何人咆哮擘龙门，荡踏千厓似有痕。\n韶石可怜非斧凿，天然生得一峰尊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13730,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其四十","author":"屈大均","text":"春草山山绿满头，朝烟暮雨作兰油。\n土膏肥沃全无石，不作畲田负水流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13731,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其四十一","author":"屈大均","text":"株株榄树分公姥，双植山头号木威。\n公解生花姥结子，君看榄树好思归。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13732,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其四十二","author":"屈大均","text":"石分公母年年在，潮有雌雄日日来。\n自是无情少离别，行人泪洒望夫台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13733,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其四十三","author":"屈大均","text":"峰顶人家尽土围，牛多一半夕阳归。\n多烧英石教田暖，山骨朝朝斲翠微。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13734,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其四十四","author":"屈大均","text":"露湿茶人两鬓寒，捻花红插更山丹。\n山呈髻子无穷样，随意芙蓉一尺盘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13735,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其四十五","author":"屈大均","text":"插竹滩心不聚鱼，天寒鱼少水光虚。\n虾䱉亦要盐相换，人是无盐二十馀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13736,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其四十六","author":"屈大均","text":"秋深碧草尚如丝，薄有霜华木叶知。\n开尽雁来红几日，炎天未是雁来时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13737,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其四十七","author":"屈大均","text":"丹厓翠谷锦围空，草树无花也觉红。\n春色尽归秋色里，不曾霜醉一青枫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13738,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其四十八","author":"屈大均","text":"山鹧相招暮不回，南峰空应北峰来。\n争衔木叶因霜露，苦待朝阳锦翼开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13739,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其四十九","author":"屈大均","text":"虎眼如灯绿射人，初疑腐叶作青燐。\n腥风吹过拳毛发，系艇深深向白蘋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13740,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其五十","author":"屈大均","text":"虚无萤火似人过，一夜鱼惊出绿莎。\n白板无声江寂寂，催寒但苦草虫多。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13741,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其五十一","author":"屈大均","text":"一夕征夫两鬓秋，未过重九已轻裘。\n炎方且喜无霜雪，不使青山得白头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13742,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其五十二","author":"屈大均","text":"鹧鸪啼杀未还家，烟雨泷东失钓槎。\n韶石苍苍三十六，知君何处吊重华。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13743,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其五十三","author":"屈大均","text":"两到韶阳不踰关，梅花怕向岭头攀。\n艰难得作南枝鸟，白首炎洲比翼还。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13744,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"巫山词 其一","author":"屈大均","text":"巫峰十二一峰无，削出芙蓉十一孤。\n知向高唐行雨去，自来神女本无夫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13745,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"巫山词 其二","author":"屈大均","text":"相对青螺十二鬟，荒祠烟翠有无间。\n一峰定化瑶姬去，千载行云竟不还。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13746,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"巫山词 其三","author":"屈大均","text":"十二依稀似九疑，一峰娟妙一蛾眉。\n峰峰相去二三里，神女无情易别离。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13747,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"巫山词 其四","author":"屈大均","text":"帝女何年化石来，阳台亦是望夫台。\n一峰飞入襄王梦，香雨氤氲更不开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13748,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"巫山词 其五","author":"屈大均","text":"行人数数总无双，一朵芙蓉影入江。\n光采无人知玉女，水中来去见仙幢。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13749,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"巫山词 其六","author":"屈大均","text":"巫山秀耸不曾高，朝暮阳台亦未劳。\n可惜湘累哀怨后，美人无命入离骚。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13750,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"巫山词 其七","author":"屈大均","text":"三楚荒淫祗梦思，灵均弟子善微辞。\n巫山神女湘君似，好色都于讽谏宜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13751,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"江行 其一","author":"屈大均","text":"烟雨江光冷欲无，白鸥飞处有人孤。\n愁心又与萋萋草，半在春山半在湖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13752,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"江行 其二","author":"屈大均","text":"苦爱滩声夜不眠，水禽催起欲归田。\n村村车水乘春涨，妇子殷勤袯襫前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13753,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"江行 其三","author":"屈大均","text":"乱竹蒙茸两岸迷，水痕高与木棉齐。\n鱼花一夕乘雷雨，流出羚羊古峡西。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13754,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"暮春山行 其一","author":"屈大均","text":"棠梨白似白头人，如雪开时已暮春。\n寒食野花惟见汝，乱随蝴蝶扑车轮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13755,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"暮春山行 其二","author":"屈大均","text":"鹃花为我血殷红，朵朵清明涕泪中。\n望帝春心终不死，幽林处处是蚕丛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13756,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"墓门 其一","author":"屈大均","text":"墓门萧瑟总枫林，不待秋来霜露深。\n山鬼无心更含笑，野猿终古一悲吟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13757,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"墓门 其二","author":"屈大均","text":"毛女何年罢鼓琴，魂归莫向华山阴。\n姗姗来影如烟雾，怅望瑶台空一林。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13758,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"樵妇词 其一","author":"屈大均","text":"采樵三两乱云边，亦有红颜出自然。\n山鸟谁知画眉好，山花谁识大丹鲜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13759,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"樵妇词 其二","author":"屈大均","text":"青青竹笋苦心同，采满花篮损玉葱。\n莫学潇湘古时女，泪痕长在箨兮中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13760,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"樵妇词 其三","author":"屈大均","text":"褓中儿女鹧鸪衣，藤笠团团月一围。\n解唱徭歌偏不唱，恐惊花里郁鸡飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13761,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"樵妇词 其四","author":"屈大均","text":"花好无名笑太红，乱收春色束薪中。\n香生炊黍终无怨，多少朱颜木槿同。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13762,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"光孝寺松 其一","author":"屈大均","text":"爱松不必古松树，小小青松已可怜。\n城里种松难长大，一株虬曲即髯仙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13763,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"光孝寺松 其二","author":"屈大均","text":"王园诃子几林空，吹倒菩提苦飓风。\n一树苍松长偃盖，乱飞苍雪似山中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13764,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从阳曲呈邑大令 其一","author":"屈大均","text":"作邑忠宣第一功，新祠俎豆使君同。\n从阳草昧重开辟，三凤声华更水东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13765,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从阳曲呈邑大令 其二","author":"屈大均","text":"七县咽喉控马场，华容疆里复新乡。\n溪山处处开清淑，膏泽都如二水长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13766,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从阳曲呈邑大令 其三","author":"屈大均","text":"田祖争祠击鼓齐，蓝田古庙盛豚蹄。\n令公晴暖行春去，相夹朱轓有鹿麑。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13767,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从阳曲呈邑大令 其四","author":"屈大均","text":"自作图经补昔人，更将风俗与维新。\n牛刀一中桑林舞，是处弦歌返太淳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13768,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从阳曲呈邑大令 其五","author":"屈大均","text":"百丈泉惊双带飞，瀑花全湿白云衣。\n使君多暇浮杯好，为政能忘海客机。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13769,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从阳曲呈邑大令 其六","author":"屈大均","text":"种蓝烧炭苦汀漳，自昔渠魁起铁场。\n罢冶只今溪谷静，村村烟火接城长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13770,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从阳曲呈邑大令 其七","author":"屈大均","text":"水翻车子灌田多，高下都收两熟禾。\n四糯七黏争谷估，片帆长向湴湖过。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13771,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从阳曲呈邑大令 其八","author":"屈大均","text":"溪洞羁縻性久驯，上山何似下山人。\n畲蛮衣食流溪纸，不独薯粱火粒新。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13772,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从阳曲呈邑大令 其九","author":"屈大均","text":"烧石青青好粪田，膏腴多在九珠前。\n三春水暖生禾稼，大瓮潭通小瓮烟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13773,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从阳曲呈邑大令 其十","author":"屈大均","text":"栽馀都络手掺掺，沤竹青青上纸帘。\n十八峒连山十八，刀耕多是鹧鸪黏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13774,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从阳曲呈邑大令 其十一","author":"屈大均","text":"一溪水作百溪流，花带湾环野石榴。\n溪始流溪终水口，东西二水夹城楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13775,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从阳曲呈邑大令 其十二","author":"屈大均","text":"清溪双绾青罗带，文塔孤擎白玉篸。\n大小鹧鸪双凤出，飞来苍翠自东南。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13776,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从阳曲呈邑大令 其十三","author":"屈大均","text":"狮子岩开石学堂，石琴多在石胡床。\n读书一一石童子，泉逐歌声出涧长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13777,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从阳曲呈邑大令 其十四","author":"屈大均","text":"玉女何年驾紫鹓，水盂传是洗头盆。\n丹馀黑米纷无数，留得仙粮与白猿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13778,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从阳曲呈邑大令 其十五","author":"屈大均","text":"春雷一夕蕨芽长，蔬性还多苦笋凉。\n羊矢菌香冬采好，鼠牙黏白夏收良。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13779,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从阳曲呈邑大令 其十六","author":"屈大均","text":"棠梨白似白蝴蝶，不戴棠梨戴杜鹃。\n花好岂如多子母，清明争采翠豅边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13780,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从阳曲呈邑大令 其十七","author":"屈大均","text":"瑶石何如石鼓楼，风门胜迹似罗浮。\n秘书生长仙灵窟，却爱朱明洞里游。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13781,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从阳曲呈邑大令 其十八","author":"屈大均","text":"纯孝诸贤满水东，水西亦有汨罗忠。\n弹丸自昔多人物，风教重兴仗令公。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13782,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从阳曲呈邑大令 其十九","author":"屈大均","text":"大夫遗爱似春暄，襦裤方歌五载恩。\n内召忽归台省去，壶浆无路更攀辕。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13783,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从阳曲呈邑大令 其二十","author":"屈大均","text":"知己相将五日留，临歧却为父兄愁。\n从阳敢望长天幸，再得神明似细侯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13784,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"行役","author":"屈大均","text":"暮年行役转凄凄，家累牵人咫尺迷。\n少学陶公愁稚子，长贫孺仲愧贤妻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13785,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"燕","author":"屈大均","text":"红紫争衔一片霞，香泥只向白云家。\n双双翠剪穿帘入，要掠姬人鬓上花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13786,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]