[{"title":"浮湘 其十四","author":"屈大均","text":"石浅水流难，舟人苦叫滩。\n水萤当昼乱，山鸟及秋寒。\n故国烽烟隔，他乡岁月残。\n闺中寄霜叶，点点泪痕丹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9388,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浮湘 其十五","author":"屈大均","text":"三闾憔悴日，自作大招辞。\n万古哀时命，遗声在本支。\n美人殊未作，宗国已频移。\n谁忍为渔父，烟波任所之。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9389,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南岳顶观日","author":"屈大均","text":"中宵登岳望，阊阖赤霞边。\n光采频迎日，空濛不见天。\n苍梧龙驭失，紫盖凤楼迁。\n万古湘累泪，东皇太乙前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9390,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"拜三闾大夫墓","author":"屈大均","text":"三闾蝉蜕后，玉佩葬湘川。\n披发重华侧，扬灵太乙前。\n墓田滋杜若，宗国委寒烟。\n词赋开苗裔，千秋哀怨传。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9391,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长沙","author":"屈大均","text":"熊绎开南楚，长沙应小星。\n城临湘水碧，苑接岳山青。\n帝子留笙鹤，娥皇隔洞庭。\n徘徊秋月夜，玉殿见流萤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9392,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"汉阳除夕和伍子","author":"屈大均","text":"汉阳江上客，寂寞度残年。\n晞发无朝日，沉身有太川。\n独醒渔父笑，同病大夫怜。\n此夕逢除夕，清樽涕泪边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9393,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖中有怀 其一","author":"屈大均","text":"江从湖口阔，浩淼浸长沙。\n天外青惟水，空中白是花。\n乱鸿惊岳市，疏柳落渔家。\n寂寂推篷坐，相思为月华。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9394,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖中有怀 其二","author":"屈大均","text":"月出水天分，微茫不见云。\n芦花千万里，如雪落纷纷。\n似我愁心乱，风吹不到君。\n更怜洞庭雁，栖宿暮无群。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9395,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"出湖作 其一","author":"屈大均","text":"澧注湘川左，湖开汇口西。\n天从南楚尽，岳至洞庭低。\n波捲青山去，云含白雁嘶。\n二妃时出入，风雨冷凄凄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9396,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"出湖作 其二","author":"屈大均","text":"向夕从湖汉，东浮发棹歌。\n雪将春水满，花与白云多。\n五渚连青嶂，三湘间绿莎。\n君山何处是，欲往阻风波。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9397,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"次沅江作","author":"屈大均","text":"西从桥口入，一水最潆回。\n自过沅江县，微茫湖欲来。\n不知青草外，可有碧天开。\n月落帆须宿，津人且莫催。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9398,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自排山经熊罴岭至祁阳作","author":"屈大均","text":"百里藤萝路，阴森万木中。\n山寒多宿雨，叶尽少悲风。\n岭峤千盘入，湖湘一线通。\n楚南香草地，处处见兰丛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9399,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自零陵至兴安道中","author":"屈大均","text":"苍松三百里，不尽复枫林。\n一路白云暗，千峰红叶深。\n山空自多响，水落亦成吟。\n薄暮停车坐，萧萧馀片心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9400,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"零陵道中晓行 其一","author":"屈大均","text":"啼鸟晓纷纷，人烟乱白云。\n江声双浦合，山色九峰分。\n斑竹枝枝泪，重瞳处处坟。\n苍梧秋雨暗，咫尺阻湘君。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9401,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"零陵道中晓行 其二","author":"屈大均","text":"试上蒲洲望，峰峰列翠屏。\n潇从湘口合，陵是九疑零。\n柳映长桥绿，松浮远岸青。\n暮投何处宿，灯火起官亭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9402,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"全州道中","author":"屈大均","text":"五日松林引，三朝谷口迷。\n孤村阴雨外，古道白云西。\n风定分泉响，山深少鸟啼。\n故乡不可望，千里草萋萋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9403,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"灵渠","author":"屈大均","text":"开陡船争上，灵渠水满时。\n穿来自秦汉，流出注湘漓。\n片雨添三尺，千峰绕一丝。\n相思如此水，南北不相知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9404,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"灵川道中眺望建陵诸峰","author":"屈大均","text":"横斜千万笋，不似一峰峰。\n苍润含秋雨，巉岩出古松。\n孤根争自立，落势不相从。\n百里烟云外，漓江绕几重。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9405,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"虞山望虞帝祠","author":"屈大均","text":"云气尝如象，盘旋玉殿间。\n匏笙祠二帝，铜鼓镇诸蛮。\n地接苍梧近，林多古竹斑。\n千秋骚些客，怅望是天颜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9406,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"建陵秋望","author":"屈大均","text":"日暖翠微浓，山包桂水重。\n楼台悬一笋，井邑散诸峰。\n肃杀流东极，玄黄战大冬。\n疮痍新满路，不忍视军容。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9407,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"野宿荔浦作","author":"屈大均","text":"夜宿帐房小，天寒多野风。\n卧看珠斗落，吟使绿尊空。\n欲战愁兵少，将归望路通。\n故乡怜有母，辛苦忆军中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9408,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宿平南县村中作","author":"屈大均","text":"野宿寒依火，高栏在翠微。\n山霞晴已吐，水雾湿犹飞。\n地广夷樵少，村荒士马饥。\n无金市牛酒，怅望射生归。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9409,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"夜上横州作","author":"屈大均","text":"夜分催荡桨，乘月上横州。\n烟雾含渔火，星河挂戍楼。\n身忘银甲重，手得角弓柔。\n不寐思军事，疏钟起渡头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9410,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自五屯所至永安州舟中作 其一","author":"屈大均","text":"冬木寒逾秀，苍苍雪霁时。\n风开多柳叶，冰压少松枝。\n水积春前气，山添雨后姿。\n新晴人就暖，解带步迟迟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9411,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自五屯所至永安州舟中作 其二","author":"屈大均","text":"落木寒泉路，朝烟暮雨人。\n乡山归不得，母子梦相亲。\n石乱初无口，滩平渐有身。\n篙师愁欲绝，此水最艰辛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9412,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自五屯所至永安州舟中作 其三","author":"屈大均","text":"水打村村碓，风烧岸岸田。\n鸟声时出谷，云气忽沉天。\n路尽无烟处，人寒欲雪前。\n岁残无一可，兵马苦颠连。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9413,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自五屯所至永安州舟中作 其四","author":"屈大均","text":"天寒生白雾，日出见平原。\n卧入千峰雪，吟随万壑猿。\n一身家国重，七尺死生尊。\n安得功成去，丘中复闭门。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9414,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自五屯所至永安州舟中作 其五","author":"屈大均","text":"叶落知枫树，千林冬不黄。\n松晴初出雪，梅早已浮香。\n事共年华去，愁随春水长。\n兼旬未窥镜，白发恐如霜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9415,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宿高田","author":"屈大均","text":"夜久林风息，溪声静欲无。\n流萤知客冷，宿鸟似人孤。\n拂石难为卧，鸣琴亦自娱。\n高楼怜有女，此夕听啼乌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9416,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自滑山至骆家道中","author":"屈大均","text":"平田千石笋，一笋一人家。\n荫壁全生竹，流溪半是花。\n山山通乳窦，树树有渔槎。\n匹马行将晚，前村隔暮霞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9417,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阳朔","author":"屈大均","text":"城里奇峰满，人烟在石林。\n家家为虎落，户户有猿吟。\n水脱诸滩浅，江通一井深。\n客舟纷向驿，月出奏箫音。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9418,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"生日同诸将郊行作","author":"屈大均","text":"细蹀花骢出，麾幢拂晓云。\n葛巾汉名士，毛扇蜀将军。\n节制凭儒术，忠诚致大勋。\n自矜年四十，于道亦曾闻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9419,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"昭江夜行作","author":"屈大均","text":"江天寒色惨，初月不成黄。\n未夕已生雾，将春始有霜。\n无能酬父老，不敢忆家乡。\n终岁劳军事，徒令白发长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9420,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阳朔道中","author":"屈大均","text":"半天青是石，石出辄成峰。\n一路平田上，参差间古松。\n人声喧野水，鸟影下寒钟。\n径口迎车马，欢然有老农。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9421,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"暇日出癸水门眺望 其一","author":"屈大均","text":"雌雄双石笋，竞秀出城中。\n一洞峰峰入，千泉树树通。\n水花纷似雾，山响不因风。\n胜日幽探去，无人识玉骢。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9422,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"暇日出癸水门眺望 其二","author":"屈大均","text":"苍苍一片石，削出万峰青。\n插水皆浮玉，围天是翠屏。\n人随飞瀑下，心与白云冥。\n稍待麇麚入，岩扉雨不扃。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9423,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"风洞寺晚眺 其一","author":"屈大均","text":"水冷多秋雨，山寒少暮霞。\n馀霜犹在叶，初雪未成花。\n寺与飞崖落，城随叠嶂斜。\n寂寥无物虑，相伴有林鸦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9424,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"风洞寺晚眺 其二","author":"屈大均","text":"一洞穿山背，逶迤不可寻。\n交垂千尺乳，乱落百泉音。\n黄叶静方脱，碧潭寒更深。\n暮风吹浙沥，猿鸟亦惊心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9425,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"岁暮客建陵作 其一","author":"屈大均","text":"岁寒何所有，一片白头霜。\n共是无衣客，偏知此夜长。\n数奇惭部曲，金尽失肝肠。\n岂必成功业，归来策亦良。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9426,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"岁暮客建陵作 其二","author":"屈大均","text":"一壁横天尽，千峰压水斜。\n飞楼在乔木，倒影满平沙。\n叶落偏惊客，莺啼正忆家。\n纷纷帘幕外，风雪自成花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9427,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"岁暮客建陵作 其三","author":"屈大均","text":"朔雪初兼雨，南风已合冰。\n穷阴千里积，杀气一冬凝。\n水冻难张罟，天寒可放鹰。\n梅花何处有，采采兴堪乘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9428,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"岁暮客建陵作 其四","author":"屈大均","text":"冰雪融将尽，春人已袷衣。\n鱼吹新水出，鸟拂落花飞。\n驿路枫林引，人家石壁围。\n羔裘持易酒，日暮醉忘归。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9429,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别查韬荒 其一","author":"屈大均","text":"海岳多精液，生君俊异才。\n文从六经出，学自二人来。\n白首天犹困，狂歌日已哀。\n艰难相羽翼，岁晏且樽罍。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9430,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别查韬荒 其二","author":"屈大均","text":"汝昨云南去，昆明涉倒流。\n滇王惊大笔，汉将赠轻裘。\n兵法儿曾学，权书父所留。\n莫徒工草檄，厮养已封侯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9431,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别查韬荒 其三","author":"屈大均","text":"膏物吴江足，文禽越峤多。\n羽毛君不妒，音响自相和。\n海气朝成市，潮田暮涌波。\n亦知奇道否，郁水接牂柯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9432,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别查韬荒 其四","author":"屈大均","text":"莞香多血结，端砚有花痕。\n相赠无馀物，相知祗二言。\n才高偏下俗，气侠不惭恩。\n沉湎谁能似，生涯在绿樽。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9433,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别查韬荒 其五","author":"屈大均","text":"去踏梅花岭，斑骓似陆郎。\n无才除左纛，不敢问金装。\n赣石诸滩险，浔江九派长。\n舟中如有作，一一记炎方。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9434,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别查韬荒 其六","author":"屈大均","text":"山枝工蜜渍，水熟解兰薰。\n归赠楼中妇，香应日夕闻。\n书从闺阁著，情以友朋分。\n时作熊经好，遵生贵在勤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9435,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别查韬荒 其七","author":"屈大均","text":"弹筝纤手子，送尔曲难终。\n斫鲙鲥鱼白，调齑豆蔻红。\n道成方好色，才在不知穷。\n金石期相保，千秋业在躬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9436,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别查韬荒 其八","author":"屈大均","text":"越草多灵药，蛮花半大丹。\n神仙宁有种，服食不曾难。\n葛令遗书古，浮丘静夜寒。\n留君偏未得，涕泪落江干。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9437,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别查韬荒 其九","author":"屈大均","text":"岂敢多求友，交君已不孤。\n谗言从贝锦，清鉴自冰壶。\n菡萏双峰出，云霞一气敷。\n繇来不离别，有道在虚无。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9438,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠吕化州 其一","author":"屈大均","text":"复阐先公道，为邦孝友馀。\n世为臣子鹄，人读使君书。\n德感金芝草，恩随白鹿车。\n我怀阴雨好，欲向化州居。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9439,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠吕化州 其二","author":"屈大均","text":"太傅忠诚在，平生一孝经。\n先朝安社稷，后裔重朝廷。\n为政劳州牧，书名冠御屏。\n拂衣归莫早，公辅待仪型。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9440,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠吕化州 其三","author":"屈大均","text":"尚书谁特笔，忠冠烈皇朝。\n我有春秋志，公为列传标。\n削心遗令子，披发逐神尧。\n讨贼文章在，书生未寂寥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9441,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠吕化州 其四","author":"屈大均","text":"经年苦行役，事向石龙回。\n为有微言在，频趋太守来。\n三川家学大，两世道宗开。\n往日芝泉院，还期辟草莱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9442,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"有忆","author":"屈大均","text":"裙为留仙绉，香缘却死熏。\n无情飞入月，有梦去为云。\n义甲姬人得，遗书弟子分。\n当时娇玉步，彷佛屧声闻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9443,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"命子","author":"屈大均","text":"渊明初命子，安石始教儿。\n白发惭闺阁，青云望羽仪。\n新篁开雨叶，乳燕拂晴丝。\n感念先公德，皇天或我私。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9444,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赵尉台下作","author":"屈大均","text":"赵尉台前草，空馀狐兔骄。\n三年屯朔骑，一月作南朝。\n牛黍秋初熟，蝉枝晚未凋。\n自怜英霸诺，寂寞在东樵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9445,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"读陈岩野先生政要","author":"屈大均","text":"往日陈都谏，谋猷信有馀。\n初闻哀痛诏，即上治安书。\n丞相劳相嫉，君王叹不如。\n可怜捐七尺，地下奉銮舆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9446,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋郊燕集作","author":"屈大均","text":"披发空行乞，凄凉去国身。\n龙蛇无四海，日月在孤臣。\n泪洒秋江满，愁随白草新。\n相逢聊取醉，莫作别离人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9447,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春日喜从弟无极至东莞赋赠 其一","author":"屈大均","text":"我学老莱子，婆娑膝下时。\n弄雏殊未已，采药更何之。\n汝自圭峰曲，来寻莞水湄。\n林中无所有，祗赠白华枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9448,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春日喜从弟无极至东莞赋赠 其二","author":"屈大均","text":"与子传家学，离骚廿五篇。\n楚人元善怨，渔父岂为仙。\n以道娱萱草，于春返药田。\n紫荆花一树，知为弟兄妍。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9449,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠郭皋旭 其一","author":"屈大均","text":"之子当湖彦，风流亦可宗。\n豪雄似翁伯，博雅比弘农。\n来作花田乐，归期锦石封。\n大才应晚达，冠剑且雍容。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9450,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠郭皋旭 其二","author":"屈大均","text":"双瞳犹点漆，五十学书年。\n老觉黄金贵，愁令彩笔妍。\n浮家因范蠡，破产为韩嫣。\n携手高凉路，相将咏甫田。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9451,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠郭皋旭 其三","author":"屈大均","text":"少小持胎素，行将服海霞。\n心珠同皎月，意蕊即丹砂。\n合浦探鲛室，罗浮御凤车。\n多情如陆贾，爱杀素馨花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9452,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠郭皋旭 其四","author":"屈大均","text":"鹧鸪元越客，茉莉是蛮花。\n南翥聊同妾，西飞莫忆家。\n蚌生珠子树，龙织海人纱。\n自可成豪富，无令金谷誇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9453,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]