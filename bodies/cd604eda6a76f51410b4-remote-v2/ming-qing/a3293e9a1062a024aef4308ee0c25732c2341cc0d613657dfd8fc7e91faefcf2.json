[{"title":"秋浦鍊药","author":"邝露","text":"十州研八石，徙药就空林。\n时稼日将酷，古槐春正阴。\n披衣咏黄老，酌酒怀青琴。\n不有灵仙术，何方可慰心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5547,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"巴陵琴酌送羽人游青城","author":"邝露","text":"弹琴劝君酒，君去少知音。\n此曲岂不古，拨弦人尽今。\n夜移衡汉浅，月落洞庭深。\n少别成千岁，依然此夕心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5548,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"震泽送剑客入广阳","author":"邝露","text":"湖草绿阴阴，桃花水更深。\n高楼怆然叹，浊酒一何任。\n念此青春别，其如白日沉。\n背人赠匕首，珍重结交心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5549,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蒋陵送孙枝游华岳时余将南还","author":"邝露","text":"相逢彭蠡月，相失蒋陵钟。\n自别东林社，君言西蹑廱。\n金天开太华，玉井见芙蓉。\n余亦泛沧海，南山归祝融。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5550,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雪中谱琴汪公子拉顾眉生同听","author":"邝露","text":"白门桃李月，绿绮凤凰弦。\n古调持秋竹，同云愁莫天。\n岂期公子过，得并雒川妍。\n良夜为君故，移情私自怜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5551,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"姑苏送云将入雒","author":"邝露","text":"崇林秀春木，归马激鲜飙。\n浊酒不肯饮，旅怀何处销。\n莫天吴苑树，明月雒城桥。\n芜绝寻君梦，缑山碧玉箫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5552,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"隋堤送漆雕龙","author":"邝露","text":"草长送人远，离居伤别情。\n细雨桃花岸，春风黄鸟声。\n君去有谁识，我劳何所成。\n行云与流水，日夜但孤征。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5553,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"山中送友人归途已长触物有叹","author":"邝露","text":"劳劳为客倦，日日送人归。\n芳草雨中碧，杨花愁处飞。\n农夫戒春及，老少咸相依。\n谁能去乡井，终负越山薇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5554,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"留都赠梁非馨","author":"邝露","text":"逐客同征雁，翩翩出塞垣。\n誇胡曾断臂，哭汉不归魂。\n别久见如梦，相看无一言。\n龙精千尺雪，持照昔人心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5555,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"皖口值区启图出宰当阳","author":"邝露","text":"微官君自去，楚水日遥遥。\n紫盖新花县，当阳旧阪桥。\n荆吴中酒别，南北断蓬飘。\n郢曲高难和，非君莫见招。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5556,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"五松天门访冷云巢居","author":"邝露","text":"松磞抱天石，磊砢留高真。\n白发对流水，青山怀古人。\n送云归碧落，酌酒浮青春。\n寂寞巢居下，岩花落去津。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5557,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"皖城谒石巢先生","author":"邝露","text":"披衣皖城口，言就皖城坳。\n辟世归愚谷，移山到石巢。\n鹤林松露滴，渔浦荻花交。\n庑下闻清啸，长谣赋乐郊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5558,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"文选楼答石巢先生人日见寄","author":"邝露","text":"汊雁归南国，传书下皖城。\n老敦彭泽节，少计仲宣名。\n柏叶怜芳气，梅花问落英。\n空居选楼上，独夜寤昭明。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5559,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"杏花堰访紫菭隐君","author":"邝露","text":"枫林二月雪，雪霁问君家。\n玉笈芝房气，铜陵杏堰花。\n更清鼍出瀑，笙迥鹤梯霞。\n不注丹台箓，吾生信有涯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5560,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠安南艾山上士","author":"邝露","text":"怜君隐居处，石室挟风霆。\n剑化蠛蠓气，山留龙虎形。\n八琅王母降，三籁子綦听。\n别后深相忆，秋坛永夜星。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5561,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"逢郢客问浈阳土风","author":"邝露","text":"关门逢郢客，立马问浈阳。\n水碓舂鱼骨，山瘿养蜜房。\n柑黄秋买蚁，莎白夜归羊。\n是事皆殊胜，为君说瘴乡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5562,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"建业送袁羽人归罗浮","author":"邝露","text":"白下蝉声急，朱明客独归。\n都人歌有爵，游子赋无衣。\n长袖为君舞，高年见面稀。\n自伤行渐北，为爱雁南飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5563,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"入京","author":"邝露","text":"遥遥向京国，抗手别交亲。\n张俭生逃汉，范雎死入秦。\n妻子漫相假，肝肠难重陈。\n行行莫回首，去作路中人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5564,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"人日登粤王台","author":"邝露","text":"登台试人日，此日谓宜人。\n日照高台色，台非故苑春。\n青山白云路，绿水流花津。\n醉欲呼鸾去，遥遥芳杜邻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5565,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"清明","author":"邝露","text":"在家常服食，无怒已经年。\n五岳寻师遍，孤琴共影眠。\n南魂迷黑齿，北首极幽燕。\n未化辽东鹤，何当省墓田。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5566,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"踏青词","author":"邝露","text":"文虹经绮陌，夕日贯阳林。\n灼灼怀春女，翩翩咏子襟。\n人归芳草暮，莺语落花深。\n往日成都客，蛛丝萦绿琴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5567,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"摩天岭望安南","author":"邝露","text":"峻岭极金邻，迢遥望九真。\n凤衔金汁遍，鱼戏艾花春。\n火粒收畲客，冰绡出海人。\n八蚕无恶岁，何谢葛天民。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5568,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"苏堤","author":"邝露","text":"春堤春服成，初叶啭初莺。\n不断垂杨色，嫣然闻啸声。\n芳菲迷处所，远近未分明。\n羁思怜芳草，迢迢限绮城。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5569,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"桂林宗侯燕集","author":"邝露","text":"桂魄陶芳夜，琴心感丽人。\n玉龙无剩伎，金雁有馀春。\n草圣飞裙练，花卿过袜尘。\n如何此时节，送客独留髡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5570,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"曲中见雪","author":"邝露","text":"祈年看瑞雪，况在莫愁家。\n彼美临芳树，先春见落花。\n凝情符皦日，盈手思瑶华。\n欲偶幽兰曲，同心怅有遐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5571,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"池阳六门三土严逐妓余出祖之","author":"邝露","text":"碧云空溅泪，可以赠生离。\n自古非今日，朱颜不遇时。\n秦淮限桃叶，汉月拥文姬。\n一领阳关奏，殊惭轻薄儿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5572,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"别楚艳秦嫣","author":"邝露","text":"露斜山峭峭，钟断水悠悠。\n草绿斑鵻怨，花飞红粉愁。\n如何云梦月，不共汉江流。\n又送王孙去，淮南桂树秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5573,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠云愁愁 其一","author":"邝露","text":"佳人美且仁，独立若为邻。\n水净见斜领，愁多宜暮春。\n恼公从小惯，西子自来颦。\n莫学卢家妇，新妆阅世人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5574,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠云愁愁 其二","author":"邝露","text":"楚云朝暮见，一半在阳台。\n雨绝无留梦，春愁黯不开。\n乌孙辞凤辇，青冢望龙堆。\n形影深相吊，肝肠日几回。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5575,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋思","author":"邝露","text":"秋思不可触，触处定伤离。\n是日看杨柳，青青异昔时。\n羊肠先雁路，马首后鸦期。\n行路难如此，踦人方自知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5576,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"伫立","author":"邝露","text":"皓齿复明眉，妆成为阿谁。\n所思不可见，伫立已多时。\n蝶粉涂芗砌，虫罗罥柳丝。\n提筐向南陌，灵雨怅佳期。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5577,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄内","author":"邝露","text":"岁时频梦尔，非关儿女情。\n霜露莙蒿色，江天凫雁声。\n浮云吴会客，落日楚江萍。\n为报秦嘉字，胡尘满汉京。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5578,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄鸿儿","author":"邝露","text":"大儿才八岁，见鲤学缄词。\n讵识冥鸿性，弥深舐犊悲。\n但能长傍母，不必更寻师。\n莫似而翁傲，飘飘云水期。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5579,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄閒儿","author":"邝露","text":"二雏别时小，婀娜双髻鬟。\n余欲荷锄去，未能深入山。\n桃花谙母祝，琪树倩人攀。\n愿化成龙杖，来看雉子斑。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5580,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄侍儿青琴","author":"邝露","text":"侍儿娇的的，玉箸蕴兰衿。\n去日恋携手，自言能鼓琴。\n七盘汉宫舞，长侧楚妃吟。\n奚难召鸾鹤，贵在得卿心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5581,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"青琴答","author":"邝露","text":"君子有所适，出门嘶玉骢。\n园花悲隋槿，寒雪问飘蓬。\n拭泪看灵鹊，含情认守宫。\n金钱买鸡卜，知尔客辽东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5582,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"人日寄云绿萝","author":"邝露","text":"官柳弄新黄，宫梅竞晓妆。\n未忘窥宋玉，讵肯嫁王昌。\n云靸通鳷鹊，金衣织凤凰。\n自惭承弁鬓，不觉有微霜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5583,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"九咏寄从兄湛之塞垣 其一 边风","author":"邝露","text":"地角寒初敛，天歌云乍飞。\n大旗危欲折，孤将定何依。\n送雁侵胡月，惊霜点铁衣。\n可能吹妾梦，一为达金微。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5584,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"九咏寄从兄湛之塞垣 其二 边月","author":"邝露","text":"秦时一片月，万古照边州。\n白动狼烟塞，寒生驿火楼。\n关山和泪到，圜缺及乡愁。\n盈手梅花色，难将寄陇头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5585,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"九咏寄从兄湛之塞垣 其三 边尘","author":"邝露","text":"紫塞三关隔，黄尘八面通。\n胡笳吹复起，汉月照还空。\n遢遝仍随马，萧条暗逐风。\n将军休拂拭，留点战袍红。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5586,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"九咏寄从兄湛之塞垣 其四 边角","author":"邝露","text":"片角吹残夜，雄关铁锁开。\n古城连堞响，奔马踏霜回。\n玉塞降羌泪，天山旅雁哀。\n何人闻此曲，不上望乡台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5587,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"九咏寄从兄湛之塞垣 其五 边笛","author":"邝露","text":"吹笛上高城，城秋月正明。\n胡儿双泪下，汉塞一龙鸣。\n沙柳愁中折，梅花梦里惊。\n徘徊三五弄，肠断忆南征。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5588,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"九咏寄从兄湛之塞垣 其六 边雁","author":"邝露","text":"候雁发金河，纷纷带雪过。\n阵连关月小，声断塞风多。\n高举愁粱稻，低飞怯网罗。\n羽毛非敢惜，书札奈君何。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5589,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"九咏寄从兄湛之塞垣 其七 边马","author":"邝露","text":"天马应星辰，金羁虎豹茵。\n骄盘春草短，叱拨桃花新。\n窟冻长城雪，蹄穿大漠尘。\n百战交河道，功成还与人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5590,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"九咏寄从兄湛之塞垣 其八 边柳","author":"邝露","text":"叹息阳关柳，青青能几时。\n春光不可度，绿鬓已成丝。\n岁岁愁攀折，依依绾别离。\n故园有奇树，日夜忆连枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5591,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"九咏寄从兄湛之塞垣 其九 边草","author":"邝露","text":"王孙去不返，马足共车轮。\n万里连天色，终年出塞人。\n几经金海雪，不见玉关春。\n独夜寒塘梦，相思愁白蘋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5592,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"移天目松","author":"邝露","text":"天目郁嵯峨，移来雪满柯。\n冰霜隐鳞甲，风雨思如何。\n冉冉岁云暮，亭亭芳意多。\n遥怜著书月，投分入烟萝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5593,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梅花","author":"邝露","text":"美人迟暮意，纤手抚寒条。\n素魄一为濯，香魂可自招。\n倩谁邀玉篴，何以托琼瑶。\n莫叹江南橘，庾关路更遥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5594,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"青菭","author":"邝露","text":"积空已成色，旷古意弥深。\n无复庙廊趣，澹然山水心。\n雨花冥药灶，涯漏滴风琴。\n自足敦微尚，夷犹芳涧阴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5595,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"萍","author":"邝露","text":"飘飘楚江客，来咏楚江蘋。\n发藻沧浪水，迟晖江汉滨。\n五湖随宕子，七泽寄浮身。\n嘉实如堪荐，长谣问鲁人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5596,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"负刍","author":"邝露","text":"负刍长已矣，刍尽爨还空。\n八口闾阎下，孤臣市井中。\n离情观道丧，无泪哭途穷。\n顾影时时笑，劳君西复东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5597,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"卖书","author":"邝露","text":"天书出尚方，宋锦内家装。\n赐日多珍惜，售时不厌忙。\n石床虚尔伴，药价待君偿。\n渔海干戈息，还期入帝乡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5598,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乞食","author":"邝露","text":"儒门今澹薄，乞食展宗风。\n余愿何曾及，他心亦已通。\n入林如旧约，握手醉新丰。\n芳草茫茫外，王孙路不穷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5599,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"次儿为马兵捆去客有鉴其胥靡解骖赎之诗以训焉","author":"邝露","text":"龀龀柔童子，贪看人捉人。\n讵谙黄鸟语，哪识白华身。\n觉后方知痛，忧来不见亲。\n隆寒需闭户，恬坐阅芳春。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5600,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠内子邓硕人糠斋","author":"邝露","text":"行门何太苦，绝粒对糠斋。\n未老知身累，忘机与化谐。\n閒云送孤影，朗月奏长怀。\n彤管铭高逸，梁鸾未足偕。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5601,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"甲辰二月初六甘露降","author":"邝露","text":"月浸仙人掌，云奇帝女台。\n清泠花院闭，的皪天宇开。\n降鹤通宵警，游鸿达曙哀。\n集灵三使至，应问长卿杯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5602,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浮湘礼三闾墓田寻贾生故宅","author":"邝露","text":"浮湘孤月下灵渠，牢落残魂伴索居。\n庚子日斜闻野鸟，端阳沙淈见江鱼。\n天高未敢重相问，年少何劳更上书。\n此去樊城望京国，定从王粲赋归欤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5603,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长安梦","author":"邝露","text":"武帝横汾继大风，凤衔丹诏出关中。\n神羊高固能升铎，金马杨庄解荐雄。\n苜蓿未移沙苑雪，葡萄终引馺娑宫。\n十年留滞周南客，梦入长杨看射熊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5604,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浮海","author":"邝露","text":"玉树歌残去淼然，齐州九点入荒烟。\n孤楂与客曾通汉，长剑怀人更倚天。\n晓日夜生圆峤石，古魂春冷蜀山鹃。\n茫茫东海皆鱼鳖，何处堪容鲁仲连。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5605,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"黄鹤楼","author":"邝露","text":"汉阳芳树古今情，逐客南浮雁北征。\n天尽水连巴子国，月明人在武昌城。\n白云依旧过全楚，黄鹄何年控太清。\n日暮数峰青似染，九疑无恙隔湘英。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5606,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"君山七夕","author":"邝露","text":"银浦无声碧落遥，洞庭秋色倩谁消。\n湘娥鼓瑟听龙驾，灵匹停梭媵鹊桥。\n秦树影斜天接水，楚云飞尽暮还朝。\n何时拟约骑黄鹄，倚醉高楼赤玉箫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5607,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"燕台送王李二舍人出贬衡巫","author":"邝露","text":"燕台送客柳纷纷，御苑莺声过漏闻。\n花重锦官啼望帝，月明瑶瑟吊湘君。\n巴童歌落荆门雪，楚客帆低剑阁云。\n圣主受釐思远谪，又随阿扈凤皇群。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5608,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"九日登凤凰台","author":"邝露","text":"瓦官上下登临地，铜浑周遭气序哀。\n古寺斜阳人独到，高台何日凤飞来。\n九淮疏凿通王气，六代兴亡问劫灰。\n故老只今西眷泪，明堂谁折汉京才。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5609,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吴越吟","author":"邝露","text":"金庭飞雪惜残梅，吴越看山憺忘回。\n茂苑寒鸦欢古堞，姑苏游鹿上高台。\n神归日母胥涛降，客探龙门禹穴开。\n一笑雄图付流水，抱琴东渐即蓬莱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5610,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"严关逢靖江左史立马有赠","author":"邝露","text":"莺啼关树几重春，马首看山赠故人。\n周室桐封姬姓早，汉家藩传董生醇。\n岭梅度臈迎官骑，苑雪分题待使臣。\n君向丛台思赋客，茫茫江海有迷津。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5611,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"独秀山侍宴应教","author":"邝露","text":"瑶水星妃集凤墀，兔园曾为促芳词。\n芙蓉露冷淹吴质，云梦天寒从景差。\n兰版夜飞明月盖，桂丛秋赋小山枝。\n霓裳若倚当年袖，谁按清平调独迟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5612,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]