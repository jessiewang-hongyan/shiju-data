[{"title":"庚午季秋六十有一岁生日作 其二","author":"屈大均","text":"六十婴孩九十亲，殷勤阿母与长春。\n生儿幸匪神仙子，养老欢馀洁白身。\n朔雁偏知霜信早，凉蝉更得露华新。\n还迟四日方重九，且掇秋英满饮醇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12220,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"庚午季秋六十有一岁生日作 其三","author":"屈大均","text":"年来益作古沉冥，亦学鲸鱼吸巨溟。\n地有醉乡留老大，天生酒德与仙灵。\n江城远映鱼云白，海阁高含蜃气青。\n童稚满前争上盏，二豪在侧似螟蛉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12221,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"庚午季秋六十有一岁生日作 其四","author":"屈大均","text":"梦寐羲皇独旦人，弱年时已作遗民。\n先生何许知元亮，男子其谁是富春。\n初度只今忘甲子，嘉名在昔爱庚寅。\n楚丘方少多神智，未欲人称踰六旬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12222,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉和惠州王太守除夕杂感次韵 其一","author":"屈大均","text":"露冕朱轓出惠阳，行春处处动如伤。\n白华篇里怀尊老，碧玉琴中见古王。\n已有两岐开秀麦，更馀一浦作沉香。\n休惊四十专城晚，守岁湖山且一觞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12223,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉和惠州王太守除夕杂感次韵 其二","author":"屈大均","text":"旌节南来万里遥，罗浮仙客梦相招。\n袁宏山疏多灵秘，鲍靓丹房未泬寥。\n地有朱明开洞府，天馀白首在箪瓢。\n思同玉女随双燕，莫笑麻姑发至腰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12224,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送人归吴兴拜母","author":"屈大均","text":"罨画帆归幸未迟，高堂相见妙颜怡。\n庭开蛱蝶仙灵扇，户拂蟏蛸子母丝。\n服贾休为南海客，求仙已得葛洪师。\n采兰朝夕兼鲂鲤，莫但清斋白首时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12225,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"前制府吴公以生日往罗浮山赋此寄寿 其一","author":"屈大均","text":"浮丘已作谢公墩，复把罗浮当漆园。\n蝴蝶未过仙客洞，梅花先向美人村。\n八年节钺宣猷苦，一日壶觞养拙尊。\n好著稚川篇内外，曜真天里得真源。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12226,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"前制府吴公以生日往罗浮山赋此寄寿 其二","author":"屈大均","text":"生朝竞望老人峰，天寿还应格九重。\n且复浮沉珠海日，何妨上下玉渊龙。\n心开瀑布三千镜，梦落芙蓉四百钟。\n赌墅只今须太傅，肯教岩壑得从容。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12227,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"陈守戎招饮同王陈二君分赋","author":"屈大均","text":"芙蓉结子水蕉开，照客何须火凤来。\n白日留人双玉貌，长星奉汝一金杯。\n孙单定有瓶侯赏，都尉休虚剑客才。\n宾主孤儿怜好在，相逢不用哭龙堆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12228,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"庚午腊月丙寅举第五子阿需值慈大人八十有七生日喜赋 其一","author":"屈大均","text":"又举商瞿第五儿，方开大母寿筵时。\n婆孙共物龄应与，父子同庚命可知。\n朔雪不须迎腊早，南风好为送年迟。\n梅花笑向高堂道，雏凤生多凤未衰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12229,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"庚午腊月丙寅举第五子阿需值慈大人八十有七生日喜赋 其二","author":"屈大均","text":"豚儿天易与贫家，老蚌多珠未足誇。\n五子已能如栗里，六龙应得似公沙。\n三年结实桃方少，七十生稊柳更华。\n分授刘殷经各一，尽教儿女作侯芭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12230,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"庚午腊月丙寅举第五子阿需值慈大人八十有七生日喜赋 其三","author":"屈大均","text":"镜里微霜两鬓侵，庭闱婉娈老逾深。\n六旬单豹鹦儿色，五十重华孺子心。\n花燕教雏长绕户，箨龙齐母每穿林。\n今朝又应熊罴兆，夹室喤喤有泣音。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12231,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"庚午腊月丙寅举第五子阿需值慈大人八十有七生日喜赋 其四","author":"屈大均","text":"三举曾孙又一孙，一年嘉庆集慈尊。\n麻姑炼黍成珠易，阿母栽桃结子繁。\n九岁应求王氏嗜，百龄未毕尚平婚。\n呱呱最是忘忧物，况复兰房满树萱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12232,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送王础尘之赣州 其一","author":"屈大均","text":"白头吾友渐无人，君去台关失所亲。\n归雁声催南海节，落梅香待建安巾。\n云中冒顿频乘月，雪里花门未动尘。\n到日郁孤当小岁，羊裘先得汉家春。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12233,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送王础尘之赣州 其二","author":"屈大均","text":"新春章贡莫淹留，亦向中原作远游。\n黄帝岂从狂屈问，真人应向野王求。\n绛衣日照长无夜，白发风吹更不秋。\n书信早传南越客，相思一慰鹧鸪愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12234,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"内子季刘以岁除生日承王君础尘赋诗见贶率次元韵奉答 其一","author":"屈大均","text":"令娴生向岁除时，正值瑶林雪满枝。\n早得双珠归凤掌，长描五岳在蛾眉。\n千金未作编蒲笑，一日从无采葛思。\n与妾糟糠俱不厌，典钗方取酒盈卮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12235,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"内子季刘以岁除生日承王君础尘赋诗见贶率次元韵奉答 其二","author":"屈大均","text":"能生梁女惟西粤，解配徐卿必季刘。\n螺黛香分鸲鹆砚，牛衣暖作骕骦裘。\n桑林莫祝蚕双茧，梅上休饥子七鸠。\n岁岁寿杯连守岁，先春一日胜先秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12236,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"辛未元日作 其一","author":"屈大均","text":"衣冠元会绕君姑，欢笑庭闱好尽娱。\n男女尸鸠新七子，弟兄荆树老三株。\n宜春帖戴连金胜，长命杯浮点玉酥。\n膝下盘旋虽甚健，未容西去挽天弧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12237,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"辛未元日作 其二","author":"屈大均","text":"六旬有二据鞍年，穷苦真能老益坚。\n白帝自辞都布后，赤家谁奋大冠前。\n梦腰银艾长垂地，思作金标更拄天。\n未许称翁当此日，英龄高密正齐肩。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12238,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"辛未元日作 其三","author":"屈大均","text":"儿女雍和满内庭，綵衣嬉戏即仙灵。\n秦家弄玉馀双月，窦氏联珠且五星。\n瑶草先春含雪艳，银花不夜吐烟馨。\n桃汤献罢催桃叶，天姥扶将下幔亭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12239,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"辛未元日作 其四","author":"屈大均","text":"去腊阴寒失物华，南中尽道似边沙。\n未知素雪非冰冻，却把红梅当杏花。\n献岁啼莺才一树，开春落叶尚千家。\n高堂早起留窗数，六萼参差吐蜀茶。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12240,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"辛未元日作 其五","author":"屈大均","text":"上日裁诗兴有馀，一年花发彩毫初。\n身当软节同眠柳，貌值灵春似立蕖。\n胡广亲傍无几杖，陶潜人外祗琴书。\n甘贫最易康宁得，乐在箪瓢敢不如。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12241,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"辛未元日作 其六","author":"屈大均","text":"昔类红莲甘白华，未惭明镜尚含葩。\n还童岂必惊淮苑，祭酒应能壮汉家。\n违雪雁犹依海屿，负冰鱼已上湖沙。\n风光先向骚人发，多作瑶笺染绮霞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12242,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"花朝宴集汤氏园亭作","author":"屈大均","text":"绯桃掩映画桥东，春到花朝影尽红。\n作暖池塘初有雨，吹寒杨柳只多风。\n流莺一一笙歌里，戏蝶纷纷士女中。\n但使主人能爱客，名园易与辟疆同。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12243,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"仲夏燕集黄氏柳桥精舍同用弧字","author":"屈大均","text":"鸣蝉一一在高梧，含吐凉飕响不孤。\n烟水人同凫藻得，风流地似柳桥无。\n酒因伏日调冰液，花为炎天隐玉壶。\n瓜李且为河朔会，秋深行欲挽天弧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12244,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"立秋后一日崔氏楼雨望","author":"屈大均","text":"秋来一日即霜天，细雨生寒尽作烟。\n海气不分平野外，山光如在夕阳前。\n穿帘乍入萧萧叶，绕树长嘶咽咽蝉。\n楼好欲当明月立，催人何处暮钟传。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12245,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寿南雄太守母夫人","author":"屈大均","text":"太守旧称崔实母，大夫今亦五原同。\n神明本自传师氏，清静何烦友盖公。\n夕膳亲调朱萼雪，春行人沐赤棠风。\n天南德教台关始，十郡慈光望不穷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12246,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"七夕咏牛女 其一","author":"屈大均","text":"蛾眉光出绛河分，掩映明霞织女裙。\n不作蟾蝫飞入月，长劳乌鹊结成云。\n花针处处抽红缕，香粉家家散紫芬。\n未夕黄姑牛罢饮，桥边却扇笑氤氲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12247,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"七夕咏牛女 其二","author":"屈大均","text":"银潢高泛海人槎，喜见天孙渡羽车。\n诒凤无缘求务女，牵牛有幸胜匏瓜。\n月中易得西王药，云外难寻帝子家。\n二七佳期秋及早，仙灵故事最芬葩。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12248,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"七夕咏牛女 其三","author":"屈大均","text":"服罢瑶箱向夕閒，合欢应不减人间。\n生离但得如河鼓，死育宁辞作破环。\n百合香薰经岁梦，九光灯照隔秋颜。\n心悲兰夜难为永，未曙扶曦已可攀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12249,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"七夕咏牛女 其四","author":"屈大均","text":"浣纱终岁苦参商，又涉明河万里长。\n未许客星窥织作，频从南斗得津梁。\n冰开七子团团镜，露浥双鸾片片裳。\n手爪昭回助云汉，定知天肯报文章。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12250,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"七夕咏牛女 其五","author":"屈大均","text":"东西河水只分流，割断云潢作御沟。\n职与婺星皆寡宿，生为天媛更离愁。\n鸳鸯有愧双青鸟，瞻兔无情一白头。\n婉娈未终初日上，明年含睇又凉秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12251,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"闰七夕再咏牛女 其一","author":"屈大均","text":"素秋今岁重流火，天为双星作闰来。\n日月数真符四七，女牛欢似上云台。\n还张北道长生席，更把西京百子杯。\n喜母丝从河汉下，佳人笑向彩云开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12252,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"闰七夕再咏牛女 其二","author":"屈大均","text":"翩翩凤驾又佳期，清浅秋河雨过时。\n乌鹊更衔天女石，蟏蛸仍吐汉宫丝。\n双星岂合相怜爱，一月何曾是别离。\n欢宴最难重此夕，桂沉瑶彩不妨迟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12253,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"闰七夕再咏牛女 其三","author":"屈大均","text":"天帝金钱定已还，辍机重得七襄閒。\n三星倍觉光河汉，一水频催湿佩环。\n心逐奔龙云冉冉，泪沾顾兔月斑斑。\n今宵始是无双夕，欲助填桥放白鹇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12254,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"闰七夕再咏牛女 其四","author":"屈大均","text":"小儿佳节又开楼，罗绮风清织女秋。\n露井华看神水上，天河光接白波流。\n凉深夜半抛纨扇，坐到晨晖为玉钩。\n灵匹每怜分袂后，伯劳飞燕更含愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12255,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"闰七夕再咏牛女 其五","author":"屈大均","text":"微茫云际蹀龙镳，玉杼声沉秋泬寥。\n月未成光先一日，星当得语已双宵。\n填河天上无精卫，催泪人间有洞箫。\n须女殷勤相媵好，那能再闰是今朝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12256,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"八月初八夕咏月 其一","author":"屈大均","text":"蛾眉今夕夜光成，未到中秋镜半明。\n花逐露华香共落，酒和云汉影同倾。\n玉娥弓向天狼彀，珠母胎从顾兔生。\n稍待团圆还与赏，抽毫更写仲宣情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12257,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"八月初八夕咏月 其二","author":"屈大均","text":"片霞斜映绛河妍，一半秋光死魄边。\n心似玉钩犹自曲，影同纨扇更谁圆。\n瑶台未合雌雄镜，锦瑟休张五十弦。\n寒露欲来衣待寄，离情悽断绿尊前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12258,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"六十二岁生日作 其一","author":"屈大均","text":"未到重阳暑气消，黄花已似客萧条。\n催人蟋蟀悲迟暮，失路骅骝叹泬寥。\n不觉杖乡加二岁，岂堪高卧遽三朝。\n奇龄尚待慈亲与，得见河清即子乔。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12259,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"六十二岁生日作 其二","author":"屈大均","text":"荏苒流光柰晚何，六旬有二恨蹉跎。\n艰难反国非重耳，矍铄临军岂伏波。\n野鹿鸣麑多美草，田凫傍母只寒河。\n闺庭思甚无馀事，日取兰陔入咏歌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12260,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"六十二岁生日作 其三","author":"屈大均","text":"六十人流未有闻，又添时节两秋分。\n絮巾尚拥辽东雪，毛扇终挥蓟北云。\n白恨芦花同缟发，红憎枫叶似罗裙。\n仙成讵忍忘人世，鸾鹤翩翩不作群。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12261,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"九日承王骠骑邀集东皋有赋 其一","author":"屈大均","text":"东皋亦似兰亭会，上巳何如九日觞。\n菊为将军开紫笑，梅因逸少吐红香。\n三江水到鱼珠阔，二峤云连雁翅长。\n南武自来天府地，英雄衰白一沾裳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12262,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"九日承王骠骑邀集东皋有赋 其二","author":"屈大均","text":"谢公棋墅此松林，化碧痕馀秋草深。\n散带且挥桓氏弹，和歌休怆雍门琴。\n弓开更奋双猿势，箭落时惊一雁心。\n暮拥黄云归路暝，野风吹帽影萧森。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12263,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"九日承王骠骑邀集东皋有赋 其三","author":"屈大均","text":"越王台枕玉山平，并骑登高结束轻。\n戏马风流还九日，射雕人地且三城。\n将归丽句雄笳鼓，未醉香醇困步兵。\n笑插黄花忧未遍，教添紫菊向长缨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12264,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梅","author":"屈大均","text":"纷纷桃李腊前开，岂意春初尚有梅。\n人戴一枝为宝胜，莺衔数片作香胎。\n随风未肯沾泥去，化雪犹思入酒来。\n靧面能令颜色好，参差儿女满妆台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12265,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乍得","author":"屈大均","text":"乍得春风不自持，无人亦复舞腰肢。\n白头最恐花如雪，青鬓偏怜叶似丝。\n有恨黄莺声咽咽，无情紫蝶影离离。\n风流好向灵和殿，更与婵娟斗翠眉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12266,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"一春","author":"屈大均","text":"一春烟雨失年华，生事萧条愧谢家。\n五子诗书忧靖节，六龙婚嫁累公沙。\n桃无红白都成实，梅有雌雄总作花。\n但使文章能富丽，联珠窦氏岂浮誇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12267,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雨声","author":"屈大均","text":"雨声日夜如流水，欲写潺湲无素琴。\n长夜已令哀怨久，故人还使梦魂深。\n孤高野鹤难双宿，断绝秋猿祗一吟。\n摇落自来悲宋玉，江枫无柰更萧森。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12268,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄答华亭朱君","author":"屈大均","text":"云间风雅未萧条，汝复悲歌起泖桥。\n垂老尚为蛮府客，思乡应作越人谣。\n羚羊探罢嘉鱼穴，华表书残锦石标。\n莫更崧台秋色里，愁从古木问前朝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12269,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉寄关东友人","author":"屈大均","text":"乌喇沙南接白山，知君征戍几时还。\n空馀黑水穿辽塞，岂有春风度汉关。\n鸿雁有心将尺素，牛羊无计与刀环。\n稗儿酒好须沉醉，醉射黄雕一解颜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12270,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄答王仲昭","author":"屈大均","text":"平生知己桂山君，君若为龙我作云。\n湖海相将同白首，芝兰早得共清芬。\n风云动色惟高义，曰月争光岂至文。\n嗟子最能知此志，贻来书札思氤氲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12271,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠九十张翁","author":"屈大均","text":"翁年九十即期颐，绀发朱颜映秀眉。\n连岁生男皆有影，开春得妾更多姿。\n芝华不少疗饥者，木槿偏多爱老时。\n凤子衣围孩笑满，弄雏堂上玉参差。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12272,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湘江曲","author":"屈大均","text":"九疑点点是离愁，泪作潇湘万古流。\n梧野至今迷玉辇，重华何处得珠丘。\n遗宫彷佛当南岳，旧事苍茫问白头。\n骚客自来伤帝子，况逢萧瑟洞庭秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12273,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送客往卢沟作","author":"屈大均","text":"桑乾亦是小黄河，桥下卢沟战血多。\n水草近京稀白雁，风沙随地有明驼。\n西山雪作春流大，北阙烟含野色和。\n知有鲤鱼遗我否，无穷饮马柰君何。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12274,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠广州某别驾","author":"屈大均","text":"先臣勋在太常中，特简慈孙为报忠。\n恭谨已知齐万石，循良自可得三公。\n名城北枕台关险，大府南开涨海雄。\n父老最能歌别驾，王祥看与使君同。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12275,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"为酒家黄丈寿","author":"屈大均","text":"汝作黄公一酒垆，红梅香酿自芜湖。\n白衣好向玉京送，纪叟休令金粟沽。\n月喜轮高三五近，花愁斗大十千无。\n长生赠尔惟荒宴，嵇阮相从始不孤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12276,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"紫菊","author":"屈大均","text":"年年紫菊先黄菊，正色繇来得令迟。\n稍染清霜朱已夺，深含白露湿难持。\n冠边香杂茱萸气，钗畔妍争翡翠姿。\n重九最怜开应节，陶公篱落未曾知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12277,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"为潮州孔别驾母陈太夫人寿","author":"屈大均","text":"阙里生贤尽玉珂，尼峰五老秀嵯峨。\n素王诗礼文孙满，鲁国尊亲寿母多。\n梅吐潮阳红雪艳，萱开泗上绿烟和。\n凭将旨酒为膏泽，难老真如燕喜何。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12278,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]