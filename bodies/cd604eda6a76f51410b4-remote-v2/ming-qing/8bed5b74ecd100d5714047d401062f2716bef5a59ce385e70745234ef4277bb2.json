[{"title":"早春喜宛平陈健夫枉顾沙亭村居 其三","author":"屈大均","text":"怜予栖遁处，谷口四无邻。\n白鹭须孤往，青山少一人。\n弄书儿女小，为道岁时新。\n未有蠲愁物，凭君赋绝伦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10582,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"早春喜宛平陈健夫枉顾沙亭村居 其四","author":"屈大均","text":"殷勤山喜鹊，不遣片帆回。\n月为弹琴上，花因酌酒开。\n水声乾白石，山影湿苍苔。\n连日须阴雨，留人在啸台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10583,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"早春喜宛平陈健夫枉顾沙亭村居 其五","author":"屈大均","text":"明日零陵去，还寻屈氏乡。\n子孙三户少，汤沐九疑长。\n鸾鸟须多语，兰荪不独香。\n那能似潇水，随尔入清湘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10584,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送僧当人返庐陵文文山旧隐","author":"屈大均","text":"兰若富田东，文山正气中。\n犹馀河岳在，不恨水云空。\n暮磬催林鸟，秋灯急草虫。\n墓门螺子近，迟我哭西风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10585,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"花朝社集西禅寺","author":"屈大均","text":"水国多烟雨，春光一半迟。\n花从今日得，莺与故人期。\n浦有沉香气，林多翡翠枝。\n玉壶携不远，兰若在江湄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10586,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟入罗旁之水将访西宁张明府有作 其一","author":"屈大均","text":"水断频无岸，山开渐有林。\n花愁渔父识，药喜野人寻。\n鸡犬仙家物，牛羊太古心。\n炊烟时一起，散作白云深。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10587,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟入罗旁之水将访西宁张明府有作 其二","author":"屈大均","text":"山口一溪分，舟随白鹭群。\n花寒因向水，石湿为生云。\n草色千峰染，林香万壑薰。\n湾环殊未已，滩路苦纷纷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10588,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟入罗旁之水将访西宁张明府有作 其三","author":"屈大均","text":"溪尽山城出，高高在乱峰。\n厓飞千树瀑，石响一林钟。\n叶落传人语，沙乾失虎踪。\n夕阳茅店外，樵影下寒松。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10589,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟入罗旁之水将访西宁张明府有作 其四","author":"屈大均","text":"泷西山水县，喜有令君贤。\n瀑布为膏泽，桃花引客船。\n夷门公子礼，新语大夫篇。\n定识相留处，行春白鹿边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10590,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"龙井 其一","author":"屈大均","text":"泷西一龙井，涓滴是真泉。\n有本云根里，无声瀑布边。\n寒宜带冰食，暖待扫花眠。\n清绝使君爱，为亭向紫烟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10591,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"龙井 其二","author":"屈大均","text":"方寸一泓碧，秋光映欲空。\n月生明镜底，天在素华中。\n石作银床好，浆怜玉井同。\n使君频汲取，啸咏隐之风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10592,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"立夏前二日留春 其一","author":"屈大均","text":"未见春光尽，依依在暮烟。\n忍教花雨送，愁使柳风牵。\n一日犹青帝，三朝即绛天。\n流莺无限语，相约在明年。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10593,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"立夏前二日留春 其二","author":"屈大均","text":"清和明日是，未忍别残春。\n相送如南浦，相依似故人。\n花光重泪湿，柳色更愁新。\n催得含桃熟，莺声亦苦辛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10594,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送钱明府","author":"屈大均","text":"棠舟君莫发，且待荔枝丹。\n五月炎洲好，千林火实寒。\n凉生儿女葛，香满大夫兰。\n以此留吾子，家家白玉盘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10595,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题徐太史枫江渔父图 其一","author":"屈大均","text":"羡尔吴江客，鲈香满水云。\n如何白鸥好，忽别太湖群。\n明月此何夕，秋光曾在君。\n萧萧枫正落，一叶梦中闻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10596,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题徐太史枫江渔父图 其二","author":"屈大均","text":"梦里一峰青，依稀西洞庭。\n平生爱林屋，未得隐秋屏。\n白鹭自高下，梅花相杳冥。\n君家在何处，招手且虹亭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10597,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"以香根一枚为黄位北寿系以诗","author":"屈大均","text":"莞中黄熟好，香乃在孤根。\n生爱朱砂土，名传金桔园。\n美人宜服媚，长日共寒暄。\n尺寸持相赠，如兰更一言。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10598,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寿李中丞","author":"屈大均","text":"召公至南海，疆理尽炎荒。\n一柱分新息，三城控夜郎。\n恩深蕉浦雨，威凛柏台霜。\n父老争为寿，菖蒲九节长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10599,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"客至 其一","author":"屈大均","text":"右客到茆茨，窗垂喜母丝。\n冻醪开瓮早，生菜上盘迟。\n代食嗟无日，躬耕幸有师。\n萧疏一丛菊，寒赖故人知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10600,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"客至 其二","author":"屈大均","text":"轩车劳长者，不敢闭门深。\n父子庞公业，妻孥靖节心。\n雪寒花更细，云暖叶多阴。\n稍待松间月，娱君有寒琴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10601,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"割带","author":"屈大均","text":"自割连枝带，相思直至今。\n花中时有影，镜里绝无心。\n小像薰香暗，遗衣裹玉深。\n海棠应尽化，泪渍藓门阴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10602,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"徐孺子","author":"屈大均","text":"岩岩徐孺子，玉润早流光。\n明镜有馀鉴，生刍空白芳。\n南州怜宅在，东汉恨人亡。\n今代无高上，风流尔独长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10603,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洪儿 其一","author":"屈大均","text":"生身从少母，尺口苦饥寒。\n小字青箱好，新衣白越单。\n描书斑管细，靧面碧桃残。\n未饮聪明水，童蒙且自安。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10604,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洪儿 其二","author":"屈大均","text":"异日胜耕作，山民是小庞。\n练裙寒好著，花笔大须扛。\n天地馀南亩，羲皇在北窗。\n无心频命子，酌酒且鸡缸。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10605,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"初月","author":"屈大均","text":"乍成秋水魄，光未碧空流。\n白露微沾影，黄云细摺愁。\n蛾眉能几夕，玉镜好禁秋。\n岂有齐纨扇，团圆至白头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10606,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过黎丈园","author":"屈大均","text":"野老多黄菊，枝枝映酒开。\n露华香满手，花朵大如杯。\n以我餐英客，相期步屧来。\n篱边分数本，秋色一肩回。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10607,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"可惜 其一","author":"屈大均","text":"可惜功名会，先人反后人。\n才疏应早退，貌恶自长贫。\n草出偏含雨，梅开不及春。\n徒然三载别，忧念累慈亲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10608,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"可惜 其二","author":"屈大均","text":"出处因雠敌，平生烈士雄。\n道孤难自立，才拙易为穷。\n众鸟啁啾里，文鸾困抑中。\n江潭思见放，复守蕙兰丛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10609,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"可惜 其三","author":"屈大均","text":"中厨烧笋熟，下箸忽凄然。\n不视高堂膳，难归下海田。\n泪和三妇滴，身恐一人捐。\n未拔贲禺郡，明春可劳旋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10610,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"水东夜雨作 其一","author":"屈大均","text":"欲梦惊寒雨，潇潇乱竹间。\n发因慈母白，身以散官閒。\n战阵平生事，衣冠一代颜。\n将归偏未得，咫尺是乡山。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10611,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"水东夜雨作 其二","author":"屈大均","text":"三年客始安，两度苦春寒。\n士马同筋力，华戎见肺肝。\n居西随太白，逐北至皋兰。\n明岁桃花发，应从故国看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10612,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"水东夜雨作 其三","author":"屈大均","text":"甚须春雨洗，战血满乾坤。\n已见三秦克，仍闻百粤吞。\n地平无北口，天固失荆门。\n腊酒须斟酌，欢娱寄弟昆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10613,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寿两广制府 其一","author":"屈大均","text":"占甫兼文武，诗多肆好风。\n崧高还自诵，燕喜复谁同。\n孝友期张仲，经营似召公。\n对扬称万寿，受命正无穷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10614,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寿两广制府 其二","author":"屈大均","text":"元老多风雅，西京一代才。\n繇来大司马，诗冠柏梁台。\n五岭为铜柱，三江作玉杯。\n持将介眉寿，复有庾关梅。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10615,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寿两广制府 其三","author":"屈大均","text":"名世生东浙，文成复有人。\n天南开节钺，岭外起经纶。\n雷电成章早，山河入誓新。\n炎方永师保，天与大年春。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10616,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠吴吴兴","author":"屈大均","text":"一麾江海日，宾客几人存。\n白首携雏凤，炎方听暮猿。\n词人推祭酒，故事问开元。\n葹草持相赠，湘累有一孙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10617,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠刘生","author":"屈大均","text":"十八冠军年，沙场奋玉鞭。\n刘生元侠少，汉将好飞骞。\n剑口寒星出，弓弰满月悬。\n先平南越占，却到朔云边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10618,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别吴门朱雪鸿 其一","author":"屈大均","text":"亦是青青草，如何独有芳。\n相知一渔父，欲去是清湘。\n二女元仙姥，三闾亦楚狂。\n含情赠琼佩，珍重系罗裳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10619,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别吴门朱雪鸿 其二","author":"屈大均","text":"勇绝专诸子，当年学炙鱼。\n人留刺客传，巷有伯鸾居。\n庑下虽逃世，舂边亦著书。\n吴人能用剑，风俗近何如。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10620,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别吴门朱雪鸿 其三","author":"屈大均","text":"平生人事拙，名外得夫君。\n有子随黄岳，无家在白云。\n桃椎时织屦，西子每湔裙。\n高洁谁能似，兰葩亦未芬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10621,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别吴门朱雪鸿 其四","author":"屈大均","text":"美尔多贤友，书中姓氏留。\n明春来茂苑，之子识西舟。\n王霸从无种，文章自有秋。\n田园何必问，吾道本云浮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10622,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别吴门朱雪鸿 其五","author":"屈大均","text":"麈尾平生物，兼之白鹭翎。\n相贻惟皎洁，相赏更沉冥。\n石气薰黄浦，湖光浴翠屏。\n殷勤期汝友，舣棹采香泾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10623,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别吴门朱雪鸿 其六","author":"屈大均","text":"金昌亭下墓，传是汉梁鸿。\n身似要离细，心因匕首雄。\n凭君披宿草，与客溯高风。\n复向皋桥畔，长歌吊伯通。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10624,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别吴门朱雪鸿 其七","author":"屈大均","text":"昆山陶岘好，浪迹在云烟。\n天性元麋鹿，人言是水仙。\n风流君最慕，高尚世争传。\n安得三舟去，重浮碧海边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10625,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别吴门朱雪鸿 其八","author":"屈大均","text":"勿复求当世，江东作步兵。\n生前应自适，身后不须名。\n千里莼长美，三江水复清。\n弹琴小渔舸，随意太湖行。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10626,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别吴门朱雪鸿 其九","author":"屈大均","text":"吴船多六柱，一一受风凉。\n藕是伤荷好，松惟阔叶香。\n湖中鱼斗大，溪上酒城长。\n归及小儿节，瓜蔬满画堂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10627,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别吴门朱雪鸿 其十","author":"屈大均","text":"传闻言偃宅，古井接潮波。\n一片洗衣石，千秋生薜萝。\n精华南国盛，文学大吴多。\n君爱琴川上，遗风总善歌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10628,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别吴门朱雪鸿 其十一","author":"屈大均","text":"西山林屋畔，禄里旧成村。\n地肺无秦汉，芝华有子孙。\n仙人须佐命，白首未忘言。\n终隐谁能似，淮阳一老尊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10629,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别吴门朱雪鸿 其十二","author":"屈大均","text":"毵娑凤州柳，枝叶最垂垂。\n絮向白头扑，花兼红粉吹。\n年年分越女，处处寄湘累。\n清婉吴音好，相思定不衰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10630,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠钱唐赵上舍","author":"屈大均","text":"天南惟翡翠，最解媚兰苕。\n相见如初日，相随似暮潮。\n才华武林客，光采紫宸朝。\n饥渴须琼树，承君玉佩要。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10631,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送赵芳佩 其一","author":"屈大均","text":"罗浮梅树好，争得似西溪。\n归去紫骝马，朝朝花下嘶。\n昔予在河渚，与客踏春泥。\n君试求芳迹，柔桑十里堤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10632,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送赵芳佩 其二","author":"屈大均","text":"相见只斯须，难留是白驹。\n白君来合浦，不敢说明珠。\n才美无三楚，情深在二禺。\n故人大毛子，书肯问菰芦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10633,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吹叶词为舒亦蕃作 其一","author":"屈大均","text":"仙人吹木叶，一半作鸾声。\n夜夜碧空外，风泉相与清。\n苏门无此啸，太上有馀情。\n谁识元音好，多从茉莉生。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10634,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吹叶词为舒亦蕃作 其二","author":"屈大均","text":"忽似蝉嘶乱，凄清叶底来。\n月因三弄上，花以一声开。\n人籁那能好，天心日已哀。\n可能当黍谷，吹得暖风回。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10635,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"听憨上人弹琴","author":"屈大均","text":"挥弦作神仙，一曲海风凉。\n多少枫林叶，无声到夕阳。\n轩窗苔藓冷，衫袖苾刍香。\n琴外无山水，相留此石床。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10636,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"伏日吴方来招饮","author":"屈大均","text":"避暑惟须饮，相邀向水涯。\n东方难割肉，河朔且浮瓜。\n葵扇摇明月，桃笙布浅沙。\n主人欢褦襶，更遣数来家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10637,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别徐子卿 其一","author":"屈大均","text":"君亦襄阳隐，山民是小庞。\n田园无素业，烟水是炎邦。\n汉月悬铜柱，蛮花扑玉缸。\n荔枝归献好，贤父望三泷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10638,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别徐子卿 其二","author":"屈大均","text":"沐犊犹无匹，牵牛已有期。\n朝飞怜雉子，夕寝忆熊罴。\n粳稻全收日，芙荷半落时。\n凉风休得早，吹白鬓边丝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10639,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别徐子卿 其三","author":"屈大均","text":"共是单家子，栖迟日以贫。\n黄香无大裤，徐庶有疏巾。\n蝉饮惟清露，鱼行只白蘋。\n而翁早高逸，吾道在遗人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10640,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从鲍尔先乞英石","author":"屈大均","text":"如何岩洞好，总在一卷中。\n苍翠含秋雨，巉岩上碧空。\n从君乞山岳，与我必华嵩。\n不尽卧游意，依稀白帝宫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10641,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题蒋玉渊驭鹿图","author":"屈大均","text":"仙人有骐骥，白鹿与胎禽。\n君与鸣麑者，依依松树阴。\n无人共甘草，有道即长林。\n何物为王霸，雌雄且自深。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10642,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜鲍子韶来粤 其一","author":"屈大均","text":"复作江城客，萧条亦自悲。\n行吟渔父侧，长跪老人时。\n雨减惟腰带，霜惊是鬓丝。\n沙边一寒鹭，孤立有君知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10643,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜鲍子韶来粤 其二","author":"屈大均","text":"穷交当此日，愁苦益相亲。\n白璧空投世，黄金不识人。\n难求闾里侠，易逐水云贫。\n萧瑟秋将起，言归欲怆神。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10644,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜鲍子韶来粤 其三","author":"屈大均","text":"友道自今绝，肝肠独有君。\n英雄愁失路，知己惜离群。\n鸿鹄谁无志，兰荪自有芬。\n袖中一纨扇，努力待南薰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10645,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜鲍子韶来粤 其四","author":"屈大均","text":"自来惟鲍氏，诗冠六朝时。\n有子须君寄，无才愧尔知。\n交因贫贱好，情以死生移。\n羽翼相须甚，摧残昧所之。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10646,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠杜十五","author":"屈大均","text":"英雄多美色，糠覈最肥人。\n有恨长贫贱，无时且隐沦。\n城边车辙满，江上席门新。\n黄老何须学，君才已绝伦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10647,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]