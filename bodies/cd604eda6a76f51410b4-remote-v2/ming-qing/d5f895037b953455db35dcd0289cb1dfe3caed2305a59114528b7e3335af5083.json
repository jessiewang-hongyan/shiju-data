[{"title":"哭亡儿明道 其一","author":"屈大均","text":"又忍西河泪，吾兹敢丧明。\n乌生馀一子，猿哭只三声。\n鞠育劳王母，孩提失所生。\n蟪蛄空九岁，无命养难成。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10381,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭亡儿明道 其二","author":"屈大均","text":"四岁嗟无恃，全凭祖母慈。\n甘瓜根蒂绝，老凤羽毛垂。\n失乳身尝病，虽贫学未迟。\n从予历吴楚，黄口已流离。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10382,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭亡儿明道 其三","author":"屈大均","text":"万里频随父，难虞自幼龄。\n新归作吴语，初读喜葩经。\n笔札能多取，弦歌解细听。\n童魂方二尺，可复伴囊萤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10383,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭亡儿明道 其四","author":"屈大均","text":"庾信伤心极，胜衣恨二男。\n从来词客泪，不独为江南。\n写爱松烟好，餐馀荔子甘。\n东门难不哭，朝夕泪长含。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10384,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭亡儿明道 其五","author":"屈大均","text":"汝母知书甚，埋香已六年。\n黄泉今教汝，紫玉未还天。\n归妹真无实，童乌不与玄。\n道香诗卷在，谁与守遗篇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10385,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭亡儿明道 其六","author":"屈大均","text":"返葬陪而母，凄凉向海云。\n前为西雁冢，上是华姜坟。\n地下精魂聚，人间骨肉分。\n秦淮将汉口，相望在斜曛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10386,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭亡儿明道 其七","author":"屈大均","text":"一夕南禺桂，团团泣露华。\n芬芳终不实，摇落且无花。\n兆梦曾何益，当门未可誇。\n嘉名徒锡汝，吾母恨无涯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10387,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭亡儿明道 其八","author":"屈大均","text":"为尔应稽颡，虽殇是长儿。\n三号肠已绝，一痛晕虽支。\n老母忧劳早，皇天警戒迟。\n平生情太过，更在始衰时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10388,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭亡儿明道 其九","author":"屈大均","text":"忆从南海帝，祷得石麒麟。\n德薄难留汝，门寒每畏人。\n徒然劳岳渎，不得照星辰。\n夭折皆予罪，从何赎此身。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10389,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭亡儿明道 其十","author":"屈大均","text":"书声犹在耳，课读未从容。\n病后茹荤少，春馀衣袷重。\n参苓催命易，狼虎咥人凶。\n不是聪明甚，从教学作农。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10390,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭亡儿明道 其十一","author":"屈大均","text":"自损真何益，凭将慰老亲。\n既然非我子，不若未成人。\n造物元相戏，空花岂是春。\n千秋亭下水，呜咽莫沾巾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10391,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭亡儿明道 其十二","author":"屈大均","text":"两年离祖母，苦忆故归来。\n患难吾虽脱，饥寒汝可哀。\n如知应入梦，不忘更投眙。\n乞以愚终老，皇天不爱才。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10392,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭亡儿明道 其十三","author":"屈大均","text":"五十方知慕，平生悔远游。\n徒令迟得子，岂有早封侯。\n鸿妇悲三丧，豚儿喜一留。\n自今王霸意，不敢愧黄头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10393,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"六月十八日作 其一","author":"屈大均","text":"儿亡今一月，魂梦未曾离。\n泪落人争问，神伤自不知。\n才因妻子减，情以死生移。\n萧飒秋将至，兰摧剩一枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10394,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"六月十八日作 其二","author":"屈大均","text":"平生无一善，天意自如斯。\n老亦因哀乐，贫多损孝慈。\n鸱鸮频取子，风雨未安枝。\n辛苦惟生计，无成值此时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10395,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送贺子返维扬兼寄宋子 其一","author":"屈大均","text":"为有贪泉好，番禺盛客游。\n海将珠母徙，天以石人留。\n寂寞劳相慰，欢娱得一秋。\n不堪挥手别，怅望是扬州。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10396,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送贺子返维扬兼寄宋子 其二","author":"屈大均","text":"故人惟宋子，意气尽渐离。\n尔亦悲歌客，能怜畏约时。\n筑声今绝代，剑术昔无师。\n归去同樽酒，烦君道所思。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10397,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蝉","author":"屈大均","text":"一声风叶乱，教我草堂凉。\n不是居高树，从何见夕阳。\n人疑流水至，天与露华香。\n清绝真惭汝，依依为稻粱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10398,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"夜坐有怀二姑","author":"屈大均","text":"新桐枝叶好，未夕白鹇栖。\n讵识离居者，含情花下啼。\n欲秋清露冷，将曙绛河低。\n不寐因明月，徘徊莲叶西。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10399,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"示洪儿 其一","author":"屈大均","text":"汝龄方四岁，留命到明年。\n我自为慈母，儿应得所天。\n一丝悬祖德，万里返中田。\n安得而成立，衣冠在客前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10400,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"示洪儿 其二","author":"屈大均","text":"脆甚兰方茁，成花未可知。\n绝无而父德，徒有阿婆慈。\n一妹生同月，双兄死已期。\n祖先灵爽在，汝或得耆颐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10401,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寂寞","author":"屈大均","text":"寂寞过青岁，悲凉为暴秦。\n筑中新有物，镜里久无人。\n日出犹长夜，花开已暮春。\n皇天方降乱，一剑且逡巡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10402,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"为浙东周秋驾寿并送其行 其一","author":"屈大均","text":"自有浮生事，炎天历岁华。\n青山空笑客，白发未还家。\n养寿宜天姥，为邻定若耶。\n而翁年至百，传尔有流霞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10403,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"为浙东周秋驾寿并送其行 其二","author":"屈大均","text":"湘湖馀我友，云卧不知秦。\n树树皆君子，峰峰是老人。\n君归同白日，自可得长春。\n坐见蓬莱浅，黄生海底尘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10404,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄谢北流","author":"屈大均","text":"北流为政好，岂必学神仙。\n日夕临勾漏，令人忆稚川。\n丹砂亦尘垢，白玉自贞坚。\n不见停云什，相贻已数年。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10405,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄南社谢九丈","author":"屈大均","text":"长忆南社老，白首作香农。\n香树遗诸子，香田在几峰。\n故人岩壑少，远道水云重。\n芜绝罗浮梦，无因溯石龙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10406,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"白首","author":"屈大均","text":"白首方求食，高堂咫尺违。\n长忧吾道失，不恨世情非。\n耕凿惟诗笔，经营是钓矶。\n自来颜色好，因啖越山薇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10407,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过韦五丈村居","author":"屈大均","text":"莞中金桔岭，多是种香家。\n地好能成药，人閒亦养花。\n无生非道妙，不病即春华。\n有客尝新酿，相留到日斜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10408,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"悼萧山来成夫 其一","author":"屈大均","text":"苦忆来高士，林居日寂寥。\n茅茨犹故国，絺绤亦前朝。\n拥絮寒王霸，持蔬槁鲍焦。\n故人先殉节，泪尽渡东桥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10409,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"悼萧山来成夫 其二","author":"屈大均","text":"柳桥桥下水，长为故人清。\n东海惟知义，西山岂好名。\n诸生从草野，一死激公卿。\n与尔皆奇节，深予想慕情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10410,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"诃林 其一","author":"屈大均","text":"一片虞翻苑，泠泠钟磬音。\n蒲葵犹有树，诃子接成林。\n暮影催归鸟，秋声在捣砧。\n苍苍珠海月，谁识是禅心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10411,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"诃林 其二","author":"屈大均","text":"佗城兵火后，古寺隐蒿莱。\n马系菩提树，笳吹般若台。\n东西增雁翅，咫尺亦龙堆。\n炊骨当年恨，黄昏鬼哭哀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10412,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"道援堂作","author":"屈大均","text":"朱颜堂上母，白发膝前儿。\n莱子承欢日，袁闳展拜时。\n犹多贤圣辱，未可帝王师。\n著述工何益，斯文岂在兹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10413,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"珠江秋夜","author":"屈大均","text":"明月生珠海，苍茫万里愁。\n笙歌喧极浦，风露满孤舟。\n落雁惊难宿，寒潮静不流。\n年来秋望苦，不上越王楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10414,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"伏波祠","author":"屈大均","text":"天南临海郡，汉代伏波祠。\n铜柱勋长在，明珠谤不辞。\n马流遗子姓，交阯奉旌旗。\n此日云台业，扶风更有谁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10415,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"扶胥江口晚望","author":"屈大均","text":"晚来凫雁静，疏雨过长空。\n山色浮天翠，渔灯散海红。\n须臾秋月上，摇荡虎门东。\n彷佛精灵出，霓旌导祝融。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10416,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠张金吾璩子","author":"屈大均","text":"伊昔龙门战，君当矢石先。\n三千句践士，十四舞阳年。\n日落苍梧树，云沉涨海天。\n有兄频殉国，流恨鹡鸰篇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10417,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"增城过张文烈战没处","author":"屈大均","text":"山城百战后，萧索似雎阳。\n鬼哭无天命，乌啼是国殇。\n几人留岛屿，何处吊沅湘。\n脉脉回舟去，闻笳更断肠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10418,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"明月寺作","author":"屈大均","text":"罗浮明月寺，寺外即罗浮。\n万壑梅花乱，千峰瀑布流。\n天鸡鸣日观，玉女下云楼。\n邀我蓬莱去，翼飘紫绮裘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10419,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自冲虚观人锦屏峰","author":"屈大均","text":"路入黄龙洞，阴森山气秋。\n万松寒欲折，双瀑日争流。\n月吐金芝草，云开玉女楼。\n泠泠风佩响，浑与百灵游。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10420,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"繇云母峰上大小石楼","author":"屈大均","text":"独上朱明顶，高寻仙子踪。\n玉楼夹日月，秋瀑飞芙蓉。\n白发几时变，青鸾安可从。\n何人弄长笛，忽过麻姑峰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10421,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"暮自瑶石台与具公荷薪归","author":"屈大均","text":"盘云一径微，与子荷薪归。\n落日摇溪阁，长风乱草衣。\n夷齐空抗节，园绮未忘机。\n明又西峰去，毋言苦行非。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10422,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西樵秋夜赠剑公 其一","author":"屈大均","text":"寒松千尺馀，月过草堂虚。\n野鹤和清啸，山风吹素书。\n昔予梦天姥，与子控鸾车。\n缥缈青霄外，群仙把玉裾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10423,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西樵秋夜赠剑公 其二","author":"屈大均","text":"美人善长啸，声与凤凰同。\n百尺瑶台上，千峰秋月中。\n麻姑停玉笛，白鹤下寒空。\n奋袂将仙去，云间谒紫宫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10424,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"望月作","author":"屈大均","text":"仙人白玉盘，飞出彩云端。\n中有霓裳女，回风舞袖寒。\n黄姑隔河汉，北斗怨阑干。\n吾欲骖鸾去，无媒比翼难。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10425,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"出狮子洋作","author":"屈大均","text":"忽尔乾坤尽，浮沉黑浪中。\n火螭衔夜日，金蜃喷天风。\n洗甲心徒切，乘桴道欲穷。\n朝宗馀一岛，尚见百川东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10426,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春日洪州西山作","author":"屈大均","text":"迢递苍山路，洪崖不可寻。\n风雷悬绝壁，花药暗长林。\n晚水东西渡，春禽下上音。\n回看歌舞地，高阁自城阴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10427,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"怀寄湖南尹叟","author":"屈大均","text":"汨罗人已没，谁复采江蓠。\n春水又云满，孤舟安所之。\n风沉渔父笛，花落女英祠。\n憔悴无相识，惟应读楚辞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10428,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过彭蠡","author":"屈大均","text":"水合九江平，微茫接太清。\n千峰过有影，万壑到无声。\n吴楚浮前浦，云霞荡晚晴。\n平陈功烈在，遗恨与神京。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10429,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"登庐山作 其一","author":"屈大均","text":"峨峨天子鄣，秀出斗牛旁。\n地作云屏尽，天垂水带长。\n千峰各晴雨，一气自鸿荒。\n谁与寻高顶，迢遥三石梁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10430,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"登庐山作 其二","author":"屈大均","text":"清晓登楼望，湖山开几重。\n霞生紫泥海，日出金轮峰。\n服食颜初驻，徉狂道莫容。\n祗应同慧远，长听虎溪钟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10431,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"观黄岩瀑布","author":"屈大均","text":"万仞晴川泻，崩云落紫虚。\n斜飞金螮蝀，乱雨玉芙蕖。\n响振寒松外，光生旭日初。\n天风无远近，吹去湿琴书。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10432,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"游简寂观","author":"屈大均","text":"苍松馀几树，种自陆尊师。\n暮雨引龙啸，春风吹兔丝。\n丹书云窦秘，仙驭鹤笙随。\n一片东林月，长歌空尔思。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10433,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"狮子峰","author":"屈大均","text":"狮子峰千仞，南当五老尊。\n芙蓉标玉柱，瀑布蔽天门。\n月影松间石，风吟峡上猿。\n茅堂无结构，恐动白云根。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10434,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"天池","author":"屈大均","text":"天池深不测，万仞岳云中。\n高涌汉阳月，下含彭蠡风。\n雪消时饮鹿，春尽不归鸿。\n忽作神灵雨，虚无入楚空。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10435,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"康王谷观谷帘泉","author":"屈大均","text":"我爱康王谷，泉飞万壑深。\n光生石镜里，声落玉楼阴。\n满地松篁湿，终年雨雪侵。\n何当援绿绮，弹作水仙吟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10436,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"彭泽舟中","author":"屈大均","text":"雪随微雨下，江上最寒时。\n路共边鸿远，愁先碧草滋。\n浔阳多落木，湖口有鸬鹚。\n不见楚渔父，芦中日又移。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10437,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭曲","author":"屈大均","text":"洞庭秋叶落，不忍吊湘君。\n锦瑟沉寒月，鸾旌隐暮云。\n风萝山鬼带，石竹女巫裙。\n欲就重华问，涔阳又夕曛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10438,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吊陈宫","author":"屈大均","text":"三阁风流地，春来碧草浓。\n可怜灵谷寺，犹有景阳钟。\n铁锁沉江尽，雕戈绕殿重。\n君王曾有计，深井抱芙蓉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10439,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长干寺作","author":"屈大均","text":"烟雨南朝寺，青春过病中。\n孤生太山竹，半死峄阳桐。\n作赋惟哀郢，寻仙未至嵩。\n愁心将海月，只在草堂东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10440,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"扬州","author":"屈大均","text":"往日江南北，鸿沟此地分。\n通侯虚作镇，上相但悬军。\n萤苑青春柳，雷塘薄暮云。\n玉钩斜畔望，芳草是罗裙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10441,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"莫愁曲","author":"屈大均","text":"风吹杨柳花，花下莫愁家。\n谁驻青骢马，来邀孔翠车。\n新辞歌白苧，素扇映朝霞。\n一片秦淮月，长教照丽华。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10442,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠杨太常正经","author":"屈大均","text":"昔尔朝金阙，先皇赐玉琴。\n房中陈古乐，太庙奏元音。\n漂泊干戈后，凄凉淮海阴。\n西方新有操，谁识美人心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10443,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"别龚韩二子","author":"屈大均","text":"翡翠生南海，联翩入帝乡。\n衔花难作垒，织锦不成章。\n独往愁矰缴，群栖耻稻粱。\n故人在丹穴，欲别惜朝阳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10444,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题龚柴丈山房","author":"屈大均","text":"竹径秋初至，茅堂寒已深。\n虎风过乱草，蝉露滴空林。\n招隐闻高咏，安贫见素心。\n殷勤南海月，夜夜向瑶琴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10445,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"润州作","author":"屈大均","text":"铁瓮城何处，萧条起战尘。\n江声沉故国，草色老行人。\n花压妖姬酒，莺悲茂苑春。\n楼船殊未至，望断海门津。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10446,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"登支硎山怀桐岑子","author":"屈大均","text":"支公乘白马，缥缈上丹霄。\n云起莲花寺，天飞瀑布桥。\n闻君挥玉麈，与客论逍遥。\n异日南溟徙，凌风一见招。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10447,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]