[{"title":"为家兄作传略巳示从子敞","author":"王夫之","text":"无穷消一泪，墨外渍痕汪。\n故国人今尽，先君道巳亡。\n蒙头降吏走，抱哭老兵狂。\n正可忘言说，将心告烈皇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1424,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"元夕独坐","author":"王夫之","text":"深碧绕峰峰，寒云酿自冬。\n草心栖宿雪，山溜隐宵钟。\n双泪初春尽，孤镫丈室封。\n梅花凭笑问，莫不许从容。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1425,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"晦夕","author":"王夫之","text":"初暄留宿雨，向夕尽归云。\n远树山镫晕，流萤湿雾熏。\n天情馀叆叇，春赏忆殷勤。\n莲叶无情甚，波光一半分。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1426,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"四月一日","author":"王夫之","text":"莫更惜春光，条条爱景长。\n楝花三日雨，燕子一襟凉。\n鱼影深摇绿，梅腮巳上黄。\n韶华读史过，天地尽清狂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1427,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日杂咏六首 其一","author":"王夫之","text":"夕风吹不彻，斜月数峰阴。\n云晕孤轮影，珠圆曲港音。\n凉云馀一照，碧汉巳双沈。\n历历秋光在，当时忆此心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1428,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日杂咏六首 其二","author":"王夫之","text":"疏雨定池光，荷风一袂凉。\n云峰双岫合，虹影半轮藏。\n日落风无定，天空望愈长。\n欲归双燕子，不肯睨横塘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1429,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日杂咏六首 其三","author":"王夫之","text":"清赏閒心即，馀年一日赊。\n稻收寻曲草，水落理鱼叉。\n选径违晨露，除棚看晚霞。\n木樨香近远，初试半林花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1430,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日杂咏六首 其四","author":"王夫之","text":"物候天涯改，秋心闭户知。\n露垂窗影乱，云薄曙光欺。\n密字微吟缓，疏藤上纸迟。\n蘋风相假借，小住得支頣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1431,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日杂咏六首 其五","author":"王夫之","text":"曲沼依樾径，乌藤试往回。\n黄花钗股荇，文石锦钱苔。\n藕叶擎孤翠，榴珠启半腮。\n天情物未损，莫遣早霜催。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1432,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日杂咏六首 其六","author":"王夫之","text":"平湖知落雁，曲砌巳吟蛩。\n短棹清波梦，幽窗坠叶风。\n生存今日事，秋老一林中。\n天问凭谁答，溪云掩断虹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1433,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"遣闷 其一","author":"王夫之","text":"宇旷清空回，残辉杖影斜。\n林疏云度曲，水释水澄沙。\n风绽丹砂子，霜滋锦缬芽。\n水仙香孕绿，珍重试初花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1434,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"遣闷 其二","author":"王夫之","text":"朔吹喧平野，微暄酿一坳。\n晴光分竹晕，霜液坠藤梢。\n地锦颠当网，云帷巧妇巢。\n无人从载酒，不受草元嘲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1435,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"小步 其二","author":"王夫之","text":"林塘春雨夙，小步爱微温。\n风定开池影，云收齐烧痕。\n青珠垂日给，绿绶绾天虋。\n慰藉韶光甚，新愁未许存。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1436,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"燕","author":"王夫之","text":"燕燕过春久，遥遥几日归。\n斜临波影转，閒啅柳花飞。\n小住游丝弱，横陈蛱蝶依。\n春光随缱绻，清赏入霏微。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1437,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"夏夕 其二","author":"王夫之","text":"试暑方前日，重阴疑凛秋。\n云封双岭合，萤乱一星流。\n阅化知无尽，为生果似浮。\n不须多病后，始拟访丹邱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1438,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"落日","author":"王夫之","text":"落日隐归樵，回峰骋望遥。\n平波云影静，素练晚烟飘。\n春气惊先入，年华果易消。\n溪梅无意绪，绿润上新条。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1439,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"见诸生咏瓶中勺药聊为俪句示之","author":"王夫之","text":"二十四桥春，何年度楚滨。\n感君垂采折，芳意在横陈。\n露琲留珠个，云屑起绛鳞。\n弱茎擎亦定，细缬展初匀。\n縠罩茶烟浅，暄迎酒晕新。\n旁侵炉气合，斜倚画图真。\n飞阁高承幕，垂璎近拂巾。\n绮霞叠一色，香月上重轮。\n帘蝶魂如梦，笼鹦咒似瞋。\n留熏十日永，惊艳满堂均。\n碧叶凝云绿，珊枝带海津。\n县愁倾白醉，莫遣聚朱茵。\n爱惜终香阁，飘零远陌尘。\n冰纹簇紫雪，芝彩涌黄银。\n锦字啼鸦就，清尊倒蚁倾。\n韶光易消谢，持慰撷芳人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1440,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"先开移丹桂一株于窗下作供为赋十六韵","author":"王夫之","text":"静馆香成界，空林影结邻。\n道心难举似，清供不馀尘。\n仙种遥移月，浓芳偶借春。\n雨轻虹一色，霞近日重轮。\n偷药朱颜驻，凌云紫气臻。\n灵砂初破体，金粟化生身。\n南国霜殷橘，江皋日射蘋。\n忘忧添妙蔼，晚醉厌工颦。\n落照疏林映，彤云细缬匀。\n深沾湘瑟甲，乍启散花唇。\n宿火沈膏灺，兰镫锦罩新。\n珊枝撑玉魄，丹蕊炼金神。\n莲坠留房露，榴函尽妒津。\n商芝分煜煜，琴鲤想鳞鳞。\n彩雾通炉篆，幽芬上氎巾。\n赤旃檀荫合，谁道苾刍贫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1441,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏风戏作艳体","author":"王夫之","text":"约约轻云敛，匀匀晚气凉。\n不教留鸟梦，何处有花香。\n绣幕鸳回翼，莲镫叶坠黄。\n窗摇三叠水，帘荡一波湘。\n宝鸭纤丝乱，笺鸾密宇藏。\n低回穿药槛，幽悄度兰房。\n结束舒袿带，萦纡绕紩囊。\n佩交情未许，芳袭妒何妨。\n却扇从花笑，飘裾趁草长。\n微温聊竹坞，无影到银塘。\n系臂蛛丝缠，当钗粉絮镶。\n蝶双愁易失，燕冷怯归忙。\n匀汗乾珠琲，回襟漾水光。\n停凝怜瀫浪，端重笑垂杨。\n暖阁扃金钥，鞦韆赛锦裳。\n暗尘禁冉冉，檐马错琅琅。\n藤合摇阴碧，菱开漏镜霜。\n迟归贪柳影，密语间松簧。\n绒缕穿针乱，花须斗草忘。\n闲情迷蕴藉，春思尽清狂。\n卯酒消微醉，云鬟乱夕妆。\n知谁千里怨，帆影望归航。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1442,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"玩月","author":"王夫之","text":"云际徘徊月，高天不损寒。\n三秋今夕未，万里几人看。\n霄碧双摇浅，金晶倒晕乾。\n平开千顷合，孤涌一轮安。\n台玉擎菱镜，胎银炼雪丹。\n珠津方妩媚，金蕊尽阑干。\n阴木飞镫暗，轻柯弄影难。\n浮浮蒸宝阁，粟粟润珠团。\n碧瓦匀匹练，筠帘透素纨。\n微阴知潋滟，深绿隐檀栾。\n天水双轮浃，空明万染刊。\n停凝聊旖旎，清绝且磐桓。\n荡白生虚室，回光转曲栏。\n酒魂双颊褪，潮血半丝湍。\n稍觉流霜腻，无妨晓吹酸。\n悬愁枫岸侧，明夜半规残。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1443,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"唐如心见过 其一","author":"王夫之","text":"春草初生雪霰零，山山曾踏几茎青。\n居然天地成今古，何必云岚不典型。\n执戟汉亡谁载酒，尚书秦暴有传经。\n怜君问礼当深夜，急难原头念鹡鸰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1444,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"唐如心见过 其二","author":"王夫之","text":"酌酒无多剪烛长，凌侵冰玉蹙寒塘。\n赠云有意寻宏景，赋雪无心付谢庄。\n玳瑁云痕开远碧，流莺柳色竞新黄。\n晴光倩送青鞋去，分取狂夫一半狂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1445,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"元夕","author":"王夫之","text":"望月竛竮出浅霞，背人约莫数年华。\n垂杨向夕惊新绿，蜡炬停风结小花。\n寂历影堂香篆静，萧清春径藓纹遮。\n南瞻欲问平安竹，好护刘瓛处士家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1446,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春兴 其一","author":"王夫之","text":"嬉春迟暮老廉夫，长卧归休旧酒徒。\n不分传家三传在，从来亡国一身孤。\n玉钱月影窥双鬓，碧海云波认五湖。\n一尽龙钟供世笑，苍天还识老狂无。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1447,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春兴 其二","author":"王夫之","text":"楼空山远湿烟蒸，返景长天暝色仍。\n千里湘皋归雁雨，九江春水钩鱼镫。\n马殷冢在生新草，陆逊营荒挂古藤。\n梦里白蘋洲上月，遥遥北渚接黄陵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1448,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春兴 其三","author":"王夫之","text":"春风仍上柳丝边，烂漫生涯醉暖烟。\n垂老田光无酒客，相知宁朔有龙渊。\n平皋漠漠飞新燕，涧道阴阴响细泉。\n荏苒栖心讯芳草，剧将嫩绿逞华年。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1449,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南天窝授竹影题用徐天池香烟韵七首 其一","author":"王夫之","text":"空明片纸涵晶瑩，微惹惊蛇一线灰。\n白社原同匡岭寺，青山不染米家堆。\n偶移浅碧腾腾合，小试光风灼灼来。\n疑是清江霜月好，孤山斜惹水边梅。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1450,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南天窝授竹影题用徐天池香烟韵七首 其二","author":"王夫之","text":"月华欲上不得上，晴光一倍偿今朝。\n轻云疑尔还相掩，宿雾初蠲忽巳飘。\n低亚殢人相绰约，回波响远试逍遥。\n翻然欲把浮邱袂，冉冉云轻隔海潮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1451,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南天窝授竹影题用徐天池香烟韵七首 其三","author":"王夫之","text":"心通无地更询他，隔院风生乍染魔。\n垂手舞因轻带鸟，扶头醉且厌堆螺。\n微凉羽扇频摇曳，半睡仙裾自沓拖。\n安得千寻看月落，凭将澹远问东坡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1452,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南天窝授竹影题用徐天池香烟韵七首 其四","author":"王夫之","text":"几枝略点红垆雪，片晌聊依篆尾香。\n稍惜晴风吹不定，还愁落日去偏忙。\n露珠暗坠惊魂起，㬉晕斜轮数叶凉。\n清瘦自憎临绣幕，湘纹巧映竹方床。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1453,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南天窝授竹影题用徐天池香烟韵七首 其五","author":"王夫之","text":"凭阑觌面不相知，邂逅晴窗瞥见时。\n浅黛斜分临晓镜，落花轻惹上蛛丝。\n萍开绿水鱼情得，叶坠幽光鸟梦奇。\n活色暗香难举似，浮沤目醉共清嬉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1454,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南天窝授竹影题用徐天池香烟韵七首 其六","author":"王夫之","text":"色借明缘还似幻，白生虚室不曾遮。\n老夫偶梦看成蝶，诸子忘弓莫问蛇。\n月满桂难亏玉魄，雷惊春已长花芽。\n何须玉版参离合，丈室天空散碧霞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1455,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南天窝授竹影题用徐天池香烟韵七首 其七","author":"王夫之","text":"根窠休访午阴圆，斜上幽窗倍可怜。\n映字不妨遮粉本，谈经适尔点青毡。\n高秋巳瘦馀清泚，积雨欲消待往旋。\n晚照乍移莫怅望，还将凤尾舞婵娟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1456,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"徐合素自南来抵郡城远讯船山代书答之尊世父闇公从海上卒于岭表廿馀年矣因寓我尚为人之叹","author":"王夫之","text":"梅霪风困药垆烟，乳燕衔书坠枕前。\n梦里短衣看射虎，重来高柳怨鸣蝉。\n归舟知汛桃花水，荒径将寻箭筈天。\n莫问霜髭今几许，君家松柏五云边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1457,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"五日前一夕唐如心以近诗见问病废夜读久矣即夕口占寄意","author":"王夫之","text":"榴花困雨不得红，溪荪浃露青烟丛。\n明朝谁续五丝缕，新月初弯一线弓。\n楚国神弦惜往誓，山中桂树思悲翁。\n纸窗晴日能相借，锦字凭开雾眼空。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1458,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄周令公","author":"王夫之","text":"湘波一尺阻东西，湘草湘烟入望迷。\n碧海相看消镜雪，丹经何术炼银泥。\n归舟吴越迎歌扇，潭水沧浪废杖藜。\n问讯绥山桃几熟，飞花好寄五陵溪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1459,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"病起连雨四首 其一","author":"王夫之","text":"炉烟平敛晚天清，病起閒愁也自轻。\n风定小容秋叶缓，月生微放雨窗明。\n江山他日仍如此，河汉经时巳早倾。\n荏苒嵯峨留瘦骨，黄橙丹柏看冬荣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1460,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"病起连雨四首 其二","author":"王夫之","text":"荻花风乱扑人飞，夕鸟双峰一线归。\n暑病乍清怜雨气，寒衣姑缓待霜威。\n龙腥秋涩云藏岫，鹭影光寒水上矶。\n幸不登临悲往昔，遥天白霭翠微微。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1461,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"病起连雨四首 其三","author":"王夫之","text":"白发重梳落万茎，镫花镜影两湛惊。\n水金丹诀闻方士，土木蔘膏累友生。\n故国馀魂长缥渺，残镫绝笔尚峥嵘。\n悬知药力消冰雪，未拟垂杨听早莺。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1462,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"病起连雨四首 其四","author":"王夫之","text":"潜圣峰云碧万层，萧萧杉竹托山僧。\n辜恩垂死馀双泪，扶病今生梦一登。\n多日六经藏孔壁，何人十字志延陵。\n湖天秋水鱼书绝，寂寞孤阡挂古藤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1463,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"代书答舌剑韬","author":"王夫之","text":"洣水东流岳阜西，鱼书摇问浣花溪。\n千峰旧访孤轮月，双脚难拚一寸泥。\n大誓馀生闻虎啸，衰年独坐弄驴蹄。\n东山只履归何日，草软烟柔一杖藜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1464,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宿明溪寺山僧导游珍珠岩","author":"王夫之","text":"苍崖乳溜渍苔乾，阴壑埋光生夏寒。\n殷孽可怜添石㾦，飞鼯亡赖扑镫阑。\n何如藻井铺霞绮，自敞珠宫迓日丹。\n读易幽篁双径锁，当时悔不访仙坛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1465,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋兴","author":"王夫之","text":"秋藕缫丝缀冷香，蓼花靺鞨染轻霜。\n月津巳转从云妒，星渚初离更夜长。\n临水登山悲郢客，守庚炼己老丹房。\n白蘋一罅清泉镜，风飐霜髭照影凉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1466,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"昔梦","author":"王夫之","text":"昔梦閒情一枕蠲，閒愁过眼万心镌。\n湿云叶叶垂虹外，归鸟泠泠晚照边。\n涧草自分寻药径，湖天谁汛钓鱼船。\n西清斜月能消得，片玉轻松半影县。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1467,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雨馀小步","author":"王夫之","text":"莲花莲叶柳塘西，疏雨疏风斜照低。\n竹箨冠轻容雪鬓，桃枝杖滑困春泥。\n垂虹疑饮双溪水，砌草新添一寸荑。\n不拟孤山閒放鹤，鹁鸠恰恰向人啼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1468,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"初月","author":"王夫之","text":"六月四日收夕雨，一弯初上划西清。\n冰纨小蹙添纹皱，青镜斜临上粉轻。\n垂柳千眉争宛宛，流萤半影怯盈盈。\n新秋通闰知何日，巳映银河一道明。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1469,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"冬日书怀","author":"王夫之","text":"木落山空朔气吹，云消星白曙光疑。\n曈昽烟海天无际，天袅霜华月半规。\n今古闲愁孤枕尽，渔樵残梦晓钟知。\n春心他日将谁赠，辜负寒梅折几枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1470,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"翠涛过草堂问病 其一","author":"王夫之","text":"稻露垂珠远望平，疏风疏雨葛衣轻。\n枫林摄摄消残暑，禅室登登待早晴。\n话到閒愁无一字，棋终残局笑双征。\n因君莞尔加餐饭，不问参苓托死生。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1471,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"翠涛过草堂问病 其二","author":"王夫之","text":"江楼十载故心违，池影相看上雪肥。\n银汉未倾怜酒尽，金风欲避倩云围。\n尊生为嘱悲欢损，惜别县知伴侣稀。\n观穫送君归下噀，西清一雁贴天飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1472,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"夏日喜何诣得见过","author":"王夫之","text":"苗叶梳风暑乍消，归禽掠日影逍遥。\n闲披绿草依孤树，喜看青衫渡小桥。\n密语偶窥康节梦，清狂未觉步兵骄。\n剪灯坐叹流光回，他日何方觅老樵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1473,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"侄敏五十 其一","author":"王夫之","text":"邗沟棨戟插湘滨，骁骑云仍到尔身。\n戍削月垂千丈影，团圞松偃一庭春。\n青毡未损传家物，黄菊相期漉酒巾。\n好理残书贻子弟，乌衣燕识画梁新。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1474,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"侄敏五十 其二","author":"王夫之","text":"吾方授室尔悬弧，一幅当年燕喜图。\n脉脉回头成梦鹿，悠悠屈指数金乌。\n黄云初捲收香粒，赪枣重蒸酿软酥。\n幸有老夫霜鬓在，东皋遥劝倒村酤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1475,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"重过三座山与故人罗君遇赠之","author":"王夫之","text":"三十九年弹指閒，居然无恙只青山。\n一双镜影髭凝雪，九月枫林叶坠斑。\n旧恨冰轮消兔阙，故交雪涕吊渔湾。\n爱君步履轻如鹤，独向苍天乞老閒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1476,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宿别峰庵庶仙策杖来慰时方从哭送先兄归垄返","author":"王夫之","text":"幂幂苍烟护小桥，回峰斜引上方遥。\n归禽邀日沈平楚，宿露泠风润绿蕉。\n白发共怜镫影瘦，青山未遣泪痕消。\n凭君昨日山阳笛，吹彻寒冰慰柳条。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1477,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"社前一日雪","author":"王夫之","text":"社日花朝总令辰，柳丝萍叶总宜人。\n巳催莺燕迎初日，未许风光试一春。\n紫电暗窥珠佩笑，轻雷不惜玉衡嗔。\n还思残腊新暄早，勾引江梅万树匀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1478,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"二十四日又雪","author":"王夫之","text":"云鏬斜晖剧可怜，惊飙一夕万峰喧。\n瓦松邂逅含晶密，水碧依微困影圆。\n销铄风光仍夜永，淹留寒色更春前。\n药畦红茁抽三寸，他日欲寻更惘然。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1479,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"罗桐侯受业先兄存没依轸倍于馀子春初过慰衰老怆然酬赠","author":"王夫之","text":"纸窗竹屋俯寒泉，总角相看巳冁然。\n莎径情深寻带草，芦中恩重覆渔船。\n重来棠杜初悲雨，老去桃花不记年。\n一卷申公诗说在，凭君珍重护秦烟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1480,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄题先兄祠屋 其一","author":"王夫之","text":"寒泉古木问何年，鹤羽归来一哂然。\n沧海能消衔土怨，沃州不待买山钱。\n谁投粔籹酬江水，为饵饧香禁冷烟。\n留语乌衣诸子弟，应知头上有青天。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1481,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]