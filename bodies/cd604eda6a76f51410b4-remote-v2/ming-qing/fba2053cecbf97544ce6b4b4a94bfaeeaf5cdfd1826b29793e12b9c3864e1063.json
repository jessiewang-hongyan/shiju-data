[{"title":"秦淮曲中词 其三","author":"屈大均","text":"傅寿清歌绝可怜，活泉真岕善烹煎。\n茶经写出人争购，字比曹娥态更妍。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13861,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秦淮曲中词 其四","author":"屈大均","text":"顾节风流复尹春，时时作伎若天人。\n腰肢直与台城柳，舞杀东风不动尘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13862,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秦淮曲中词 其五","author":"屈大均","text":"范润聪明范珏同，两家书画并精工。\n犹言博览输王凤，粉腻全沾万卷中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13863,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秦淮曲中词 其六","author":"屈大均","text":"寇媚潘髯大社开，纷纷诗画客争来。\n班如堂里多评藻，温丽人称似玉台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13864,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秦淮曲中词 其七","author":"屈大均","text":"豪侠人称脱四娘，挥金不向少年场。\n一生珠翠交贫士，赢得西邻笑淡妆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13865,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秦淮曲中词 其八","author":"屈大均","text":"杨婉工诗及草书，茅君相挟上匡庐。\n侍儿插柳时时忆，温润潘郎玉不如。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13866,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秦淮曲中词 其九","author":"屈大均","text":"风流文藻有湘君，兰竹枝枝墨气芬。\n能说五经谁得似，指挥谈麈绕罗裙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13867,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秦淮曲中词 其十","author":"屈大均","text":"曲中当日最繁华，春到青溪处处花。\n游冶竞遮苏小路，辞章多在薛涛家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13868,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"口占送陈献孟之兴宁","author":"屈大均","text":"翩翩书记去从军，彩笔凭将扫阵云。\n东指蓝关风旆捲，功名好慰望诸君。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13869,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送汪扶晨奉吴山大师灵龛返葬黄山 其一","author":"屈大均","text":"君家主政事真乘，日夕焚香礼孝陵。\n一代遗臣金粟佛，三朝高士雪庵僧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13870,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送汪扶晨奉吴山大师灵龛返葬黄山 其二","author":"屈大均","text":"沙门自古非高士，渔父繇来是大夫。\n汝爱吴山尊宿好，遗衣犹为作浮图。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13871,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送汪扶晨奉吴山大师灵龛返葬黄山 其三","author":"屈大均","text":"谁能五日学三闾，蝉蜕人间返太虚。\n喜尔曾为骚弟子，不令遗骨委江鱼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13872,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送汪扶晨奉吴山大师灵龛返葬黄山 其四","author":"屈大均","text":"千秋知己是湘累，一读离骚泪便垂。\n禅寂未销亡国恨，愁心尝被朔风吹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13873,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送汪扶晨奉吴山大师灵龛返葬黄山 其五","author":"屈大均","text":"精爽应随轩后去，云霄一路拾龙髯。\n未应列在高僧传，公是郎官后孝廉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13874,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送汪扶晨奉吴山大师灵龛返葬黄山 其六","author":"屈大均","text":"轩辕宫阙在黄山，万丈丹梯尔重攀。\n石匣故应收舍利，遗书还与散人间。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13875,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"金陵送蓝子 其一","author":"屈大均","text":"故园荔子正鲜红，汝返闽中我粤中。\n此地杨梅那得似，荷花虽好酒樽空。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13876,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"金陵送蓝子 其二","author":"屈大均","text":"秣陵为客总途穷，才技如君恨太工。\n自昔黄金天最爱，艰难不肯与英雄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13877,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题吴季六所画黄山松 其一","author":"屈大均","text":"奇绝黄山吴季六，画松不画直松看。\n四松最是黄山怪，长使人来毛骨寒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13878,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题吴季六所画黄山松 其二","author":"屈大均","text":"三十六峰松尽眠，一峰峰有一松缠。\n松枝不比松身短，十丈横飞渡水烟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13879,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题吴季六所画黄山松 其三","author":"屈大均","text":"株株穿石土膏无，瘦尽蛟龙石作肤。\n画出已令山鬼泣，不须黄海作全图。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13880,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题吴季六所画黄山松 其四","author":"屈大均","text":"撄石孥云尽偃松，一松飞去接前峰。\n游人不觉石梁断，扶过溪南惊卧龙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13881,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题吴季六所画黄山松 其五","author":"屈大均","text":"熊罴多力不如君，曾向沙场作虎贲。\n战败不愁无矢刃，奇松拔取扫千军。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13882,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题吴季六所画黄山松 其六","author":"屈大均","text":"山木阴森古穴边，汝驱虓虎出飞泉。\n画来三叠庐山似，更有虬松怒上天。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13883,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题吴季六所画黄山松 其七","author":"屈大均","text":"松松费尽熊罴力，画取黄山万树来。\n双腕可怜如此用，丹青深隐冠军才。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13884,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题吴季六所画黄山松 其八","author":"屈大均","text":"龙颠虎倒在峰峰，尽是将军汉代松。\n鳞甲不妨三寸厚，耐他冰雪过玄冬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13885,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题吴季六所画黄山松 其九","author":"屈大均","text":"看君身亦一长松，生长黄山石壁重。\n放笔可能为直干，千寻撑起玉芙蓉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13886,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题吴季六所画黄山松 其十","author":"屈大均","text":"瘦尽徒劳石髓滋，时时看似一峰欹。\n女萝乱挂无空处，画出应教山鬼疑。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13887,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"严子陵 其一","author":"屈大均","text":"梅市仙人是妇翁，垂竿不愧逸民风。\n富春江上台千尺，长为君王峙碧空。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13888,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"严子陵 其二","author":"屈大均","text":"妻子冰清实姓梅，夫妻垂钓有双台。\n桐江一道真汤沐，东汉风流赖尔开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13889,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"青冢 其一","author":"屈大均","text":"一片阴山日易阴，汉宫春色梦中深。\n不随边地风霜变，芳草青青是妾心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13890,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"青冢 其二","author":"屈大均","text":"峨峨何似李陵台，一曲琵琶夜夜哀。\n红粉青蛾安足惜，才人亦在白龙堆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13891,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄新安汪扶晨 其一","author":"屈大均","text":"不爱黄山爱紫霞，紫霞中有故人家。\n多情每遣潜溪水，流出相思与落花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13892,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄新安汪扶晨 其二","author":"屈大均","text":"我爱新安水至清，频劳三十六峰迎。\n无端风雨回中道，负尔樽前望远情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13893,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄新安汪扶晨 其三","author":"屈大均","text":"黄山庐岳飞泉出，三叠何如九叠长。\n君在天都曾见否，为图新瀑寄炎方。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13894,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄新安汪扶晨 其四","author":"屈大均","text":"承君茶味紫霞新，远寄兼贻吴野人。\n归取越王台畔水，一杯九奉白头亲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13895,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"泊舟石钟山下作 其一","author":"屈大均","text":"湖水青青江水黄，人言此水号鸳鸯。\n钟声忽起波间石，清越偏宜秋夜长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13896,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"泊舟石钟山下作 其二","author":"屈大均","text":"大战彭湖斩敌旂，红船难逐白船飞。\n石钟山上留天步，终古风涛听指挥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13897,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"泊舟石钟山下作 其三","author":"屈大均","text":"虎斗龙争一代雄，天威犹在怒涛中。\n江南千里连湖北，万古芦花起大风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13898,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"小孤 其一","author":"屈大均","text":"九江东下水汤汤，石笋中天出水长。\n山水繇来皆有偶，小姑相对是彭郎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13899,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"小孤 其二","author":"屈大均","text":"岳影飞来乍有无，南风不得渡鄱湖。\n裁诗屡欲投神女，人道山名是小孤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13900,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"小孤 其三","author":"屈大均","text":"山似瑶篸千仞出，巉岩上有小姑祠。\n南风十日留词客，细细云中见玉姿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13901,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"小孤 其四","author":"屈大均","text":"宫亭不肯一分风，故遣江妃笑道穷。\n山水有情怜赋客，明年还至蠡湖东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13902,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"绿珠","author":"屈大均","text":"越女能诗始绿珠，懊侬一曲艳吴歈。\n身轻好似飞花堕，化作明霞入太无。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13903,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄答新安黄黄生 其一","author":"屈大均","text":"淮清桥畔雨花间，人至江南自不閒。\n负尔黄山兼白岳，秋来又掩水云关。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13904,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄答新安黄黄生 其二","author":"屈大均","text":"黄生洪仲吾知己，分手维扬已十年。\n黄在黄山洪白岳，洪今已没有谁怜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13905,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄答新安黄黄生 其三","author":"屈大均","text":"因君更自忆方舟，白首风霜苦竹秋。\n泪与飞花吹不尽，门前添作一溪流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13906,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄答新安黄黄生 其四","author":"屈大均","text":"洪仲当年著述多，凭君收拾与诗歌。\n黄山此日多山鬼，泣抱遗书向女萝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13907,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"第五泉 其一","author":"屈大均","text":"红桥东望绛仙台，雨过江南翠色开。\n地脉最怜邗上好，大明泉自蜀中来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13908,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"第五泉 其二","author":"屈大均","text":"一片平山号蜀冈，行随燐火路茫茫。\n名泉独作先朝物，流出松间姓字香。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13909,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠冯律天 其一","author":"屈大均","text":"久客辽阳识地形，巫闾长白有图经。\n南帆倘至松花水，定向床前拜管宁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13910,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠冯律天 其二","author":"屈大均","text":"从军十六向辽东，白首田畴未有功。\n兵法不须多记诵，时来妇女亦英雄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13911,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠冯律天 其三","author":"屈大均","text":"饥鹰那得久依人，老向沙场亦有神。\n自在将军元有命，相逢且醉秣陵春。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13912,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠冯律天 其四","author":"屈大均","text":"朝天宫在冶城间，未就丹砂已驻颜。\n年少黄冠皆弟子，仙经教授不曾閒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13913,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浮江作","author":"屈大均","text":"浮玉天门上下标，长江至此一回潮。\n青山尽向金陵出，虎踞龙蟠为本朝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13914,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"读东都赋有作","author":"屈大均","text":"兰台三赋大文章，此日东都恨未央。\n更造人伦思建武，重新天命望南阳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13915,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"天门 其一","author":"屈大均","text":"梁山博望两峰尊，万里长江此大门。\n不使南朝长有此，茫茫天堑复何言。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13916,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"天门 其二","author":"屈大均","text":"青山双挟大江飞，飞到松寥失翠微。\n北望天门南九子，长风不解送将归。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13917,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄程蚀庵","author":"屈大均","text":"一浴汤泉六十秋，衣裳皎皎月华流。\n人间未有真山水，白鹤青鸾好自留。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13918,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"泰州作 其一","author":"屈大均","text":"城里春流曲曲迷，舟穿万柳出长堤。\n谁家叠石为丘壑，自道人家似若溪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13919,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"泰州作 其二","author":"屈大均","text":"累土为山武穆功，湖波四面绕祠宫。\n伤心一代冬青树，叶叶枝枝是大忠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13920,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"茱萸湾作和人 其一","author":"屈大均","text":"日暮天寒估舸回，八鲜纷自下河来。\n茱萸湾口销愁地，更有茱萸酒满杯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13921,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"茱萸湾作和人 其二","author":"屈大均","text":"十月霜高野鸭肥，家家秫酒不曾稀。\n吴陵岁暮堪为客，慷慨从君一典衣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13922,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浮家往金陵作 其一","author":"屈大均","text":"半船妻子半船书，烟水苍茫恣所如。\n此去金陵四千里，不知何处有田庐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13923,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浮家往金陵作 其二","author":"屈大均","text":"浮家已至蠡湖滨，思向匡庐住一春。\n瀑水远从双剑落，垂垂天外欲牵人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13924,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鲁妃祠 其一","author":"屈大均","text":"阴陵南畔鲁妃祠，俎豆人怜殉主时。\n一片插花山上月，英雄留得照蛾眉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13925,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鲁妃祠 其二","author":"屈大均","text":"佳人慷慨识时穷，不劝君王更渡东。\n西楚实将天下让，千秋人拜霸王风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13926,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西湖曲","author":"屈大均","text":"君似南高妾北高，两峰相望梦魂劳。\n兰桡欲渡风吹转，身在莲中立不牢。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13927,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖上作 其一","author":"屈大均","text":"湖光山色足倾城，况复芙蓉尽有情。\n好在月中垂两足，风流自古得长生。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13928,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖上作 其二","author":"屈大均","text":"湖如西子目曾波，却恨中流满芰荷。\n一片清光风潋滟，照人不在月明多。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13929,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南屏寺逢孙宇台","author":"屈大均","text":"一声钟动暮禽还，秋色苍苍雨过山。\n高士繇来栖白社，相逢啸咏虎溪閒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13930,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠盛南樵卖药 其一","author":"屈大均","text":"自古仙人多卖药，风流我最慕安期。\n今君莫使秦皇得，烟雾苍苍信所之。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13931,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠盛南樵卖药 其二","author":"屈大均","text":"年来高士半韩康，卖药萧然大道旁。\n我昔先人遗素问，殷勤赠尔及丹方。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13932,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠盛南樵卖药 其三","author":"屈大均","text":"吾家药市近罗浮，此去还为采药游。\n欲补神农旧本草，期君共对白云秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13933,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟中鸣琴与客作","author":"屈大均","text":"汝为流水我高山，天籁何曾落世间。\n一曲怀仙人不见，片帆空与白云还。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13934,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]