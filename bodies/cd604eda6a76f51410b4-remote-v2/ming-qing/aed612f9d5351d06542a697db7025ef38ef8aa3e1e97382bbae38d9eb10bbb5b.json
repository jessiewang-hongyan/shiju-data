[{"title":"以莞香结赠吕黍字系以诗","author":"屈大均","text":"百年香有胆，生结一精华。\n得自珠官手，来从莞女家。\n但令存一气，不必作双霞。\n日夕君怀袖，人疑处处花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9918,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠祁七奕仪水岩砚","author":"屈大均","text":"辛苦羚羊峡，东西割紫云。\n青花因水见，白叶与天分。\n沐浴乘佳日，精华得大文。\n裁成风字好，珍重一贻君。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9919,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"五十五岁生日有作 其一","author":"屈大均","text":"五十五秋前，无闻愧昔贤。\n将过称艾日，未及象蓍年。\n学易徒为尔，知非尚未然。\n杖家吾不敢，亲在即神仙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9920,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"五十五岁生日有作 其二","author":"屈大均","text":"皇天眷老亲，八十一年人。\n孺慕今方始，儿啼日以新。\n松枝宜晚岁，萱草更长春。\n为寿吾何敢，劬劳念此辰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9921,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过郭丈寓庐有赠","author":"屈大均","text":"小君年十岁，兄事每称公。\n相就忘宾主，相依爱土风。\n忧劳犹陇亩，栖宿已云鸿。\n心事妻孥识，遗安计未穷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9922,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏管宁 其一","author":"屈大均","text":"生长惟潜逸，栖迟岂守高。\n闺庭閒出入，几杖未烦劳。\n语客惟经典，依人自羽毛。\n一匡思祖业，慷慨在蓬蒿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9923,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏管宁 其二","author":"屈大均","text":"木榻穿当膝，相随未老前。\n潜龙成德日，辽海说经年。\n裙薄冬添布，巾疏夏脱绵。\n孤臣馀草莽，匪石一心坚。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9924,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"罗浮杂咏 其一","author":"屈大均","text":"松风无大小，吹得石楼飞。\n一片水帘影，纷纷落翠微。\n月为玉女镜，花是麻姑衣。\n寄语大蝴蝶，相迎羽客归。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9925,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"罗浮杂咏 其二","author":"屈大均","text":"空外日氤氲，茫茫四百君。\n雨将双岳合，晴以一泉分。\n石柱支青壁，香炉吐白云。\n穿林深浅去，惊起碧鸡群。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9926,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"罗浮杂咏 其三","author":"屈大均","text":"玉女老人边，窥人出紫烟。\n镜台一瑶石，裙带两飞泉。\n明月白成水，梅花香在天。\n枫林萧瑟甚，夜半尚闻蝉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9927,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"罗浮杂咏 其四","author":"屈大均","text":"峰路时时断，翻嫌瀑布多。\n水浮苍树去，山逐白云过。\n饷客惟朱草，牵人是绿萝。\n踟蹰石梁畔，心奈欲归何。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9928,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菊 其一","author":"屈大均","text":"两月含苞久，三冬吐药长。\n花乾同白露，叶湿似清霜。\n有日那能暖，非时不用香。\n篱边自荣落，谁见此孤芳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9929,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菊 其二","author":"屈大均","text":"未敢违霜露，宜寒故晚开。\n重阳嫌太早，白雁莫相催。\n冉冉辞秋草，依依有早梅。\n炎方无月令，嗟汝后时才。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9930,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菊 其三","author":"屈大均","text":"不是花难发，炎洲故晚寒。\n苦心嫌自见，佳色畏人看。\n地暖非吾性，山深正所安。\n微红有霜叶，采采作晨餐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9931,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋收后作 其一","author":"屈大均","text":"渐见穷阴积，霜因白露晞。\n寒教梅色浅，暖使菊香微。\n十亩男功毕，孤村岁事非。\n几家涤场候，鸡黍有馀肥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9932,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋收后作 其二","author":"屈大均","text":"喜母庭前织，丝丝似有心。\n人因黄菊至，路向碧溪寻。\n酿酒蝉鸣稻，娱宾凤嗉琴。\n月明田水满，一啸白鸥沉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9933,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赋怀塞外友人 其一","author":"屈大均","text":"塞外知寒绝，凄凉黑水涯。\n貂毛那受雪，马肉不沾沙。\n风断三秋草，冰开二月花。\n催人双泪落，最苦是清笳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9934,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赋怀塞外友人 其二","author":"屈大均","text":"得风貂更暖，不必著重裘。\n食肉身虽老，弯弓汗便流。\n黄羊烧大雪，紫兔射高秋。\n属国归须晚，于今未白头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9935,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"江皋 其一","author":"屈大均","text":"闭户过中岁，清贫亦已忘。\n耕锄无旦暮，勤动是文章。\n病使秋魂冷，愁令白发长。\n妻孥亦沮溺，相耦水云乡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9936,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"江皋 其二","author":"屈大均","text":"夜寒犹作雪，春暖已成烟。\n黄鸟啼山口，桃花笑水边。\n琴来三益友，酒酌一高年。\n亲戚多情话，殷勤在白田。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9937,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"江皋 其三","author":"屈大均","text":"江皋春未半，红满木棉花。\n士女祠南海，帆樯出白沙。\n蜃开朝暮市，鱼逐水天霞。\n最爱垂杨处，莺声第二家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9938,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蕉利村春望 其一","author":"屈大均","text":"乔木村村出，榕阴接翠微。\n夕阳双渚映，古道一人归。\n烟火暮犹少，牛羊春未肥。\n愁心似鸿雁，处处逐烟霏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9939,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蕉利村春望 其二","author":"屈大均","text":"望望烟波上，芭蕉满海天。\n人家龙眼国，生计荔枝田。\n日出莺花里，云生鸡犬边。\n捕鱼乘水节，一一放罛船。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9940,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"木棉 其一","author":"屈大均","text":"花朝犹未至，海国已春多。\n十丈攀枝影，如霞逐水波。\n香薰么凤甚，红奈美人何。\n岁岁祝融节，祠前照绮罗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9941,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"木棉 其二","author":"屈大均","text":"天南烽火树，最是木棉红。\n花发炎洲上，光连若水东。\n珊瑚枝干似，翡翠往来通。\n朝夕羽毛染，为巢朵朵中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9942,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寿尹丈","author":"屈大均","text":"南国长生树，无如细叶榕。\n横斜炎海上，绝似老人峰。\n太古一黄发，婆娑烟翠浓。\n林边有春酒，鸾鹤尽相从。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9943,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别颍川刘子","author":"屈大均","text":"君昔苏门隐，移家自汝阴。\n相逢长啸客，相引夏峰深。\n白日依毫素，流泉托玉琴。\n清虚抱天识，轩冕几沉吟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9944,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"昼长","author":"屈大均","text":"昼长人事外，琴静一溪风。\n亲客劳蛛子，宜男得鹿葱。\n柳疏烟易度，花密月难通。\n不奈流莺好，声声绿酒中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9945,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣花","author":"屈大均","text":"浣花成老大，人道是花翁。\n白鹭浮沉者，年年浦溆同。\n犹令玉琴在，不使石床空。\n酌酒无朝夕，春颜任意红。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9946,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉答于畏之枉顾沙亭之作 其一","author":"屈大均","text":"吾家傍海涛，烟管一峰高。\n秋凿山香结，春收水翠毛。\n承君来浦口，系马向兰皋。\n风俗知南屈，家家学楚骚。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9947,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉答于畏之枉顾沙亭之作 其二","author":"屈大均","text":"一姓分南楚，三闾此大宗。\n君寻苗裔至，礼向逐臣恭。\n汤沐多香草，田庐绕碧峰。\n遗音哀怨在，愁杀竹枝侬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9948,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉答于畏之枉顾沙亭之作 其三","author":"屈大均","text":"草没山边宅，泥深海上城。\n一家衣隐德，十口食才名。\n歌哭难消日，文章易养生。\n读君新乐府，感激有馀情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9949,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉答于畏之枉顾沙亭之作 其四","author":"屈大均","text":"白首因周易，君子弃世时。\n羞将黄老术，去作帝王师。\n高尚无吾友，艰贞与尔期。\n毋忘鸡黍日，二子在东菑。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9950,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜王阮亭宫詹至粤即送其行 其一","author":"屈大均","text":"旌节从天下，光生大庾春。\n汉宫鸿鹄客，齐国大风人。\n翠羽飞成路，梅花踏作尘。\n相迎千步草，香更满江滨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9951,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜王阮亭宫詹至粤即送其行 其二","author":"屈大均","text":"南来祠水帝，光景动扶胥。\n海市空中起，神山水下居。\n天浮元气外，地接大荒馀。\n欲见仙人迹，章丘是石闾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9952,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜王阮亭宫詹至粤即送其行 其三","author":"屈大均","text":"汉臣儒雅甚，詹事复韦贤。\n望秩分南海，承华别朔天。\n越王烽火树，蛮女素馨田。\n景物春无数，娱君郁水边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9953,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜王阮亭宫詹至粤即送其行 其四","author":"屈大均","text":"文采光南武，声华动越裳。\n花重封锦石，水更掷沉香。\n去恨燕关远，来愁汉塞长。\n王程不可缓，空见荔枝黄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9954,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜王阮亭宫詹至粤即送其行 其五","author":"屈大均","text":"海味初南食，连朝玉箸香。\n荼蘼番女露，甘蔗越人霜。\n月满珠多肉，天寒蛎有黄。\n知君因异物，一一纪炎方。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9955,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜王阮亭宫詹至粤即送其行 其六","author":"屈大均","text":"清绝惟风雅，人钦子大夫。\n自然金橐少，亦复簳珠无。\n草木多为状，山川细作图。\n持归赠知己，不减女珊瑚。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9956,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜王阮亭宫詹至粤即送其行 其七","author":"屈大均","text":"岂意京华别，重期雁翅城。\n山公劳小辇，姝子愧干旌。\n出处埙篪合，文章羽翼成。\n他时思辟谷，莫忘紫芝荣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9957,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜王阮亭宫詹至粤即送其行 其八","author":"屈大均","text":"洞庭七十二，君独爱渔洋。\n自有梅花咏，弥令笠泽香。\n鼓钟才子国，膏润美人乡。\n辞客知谁似，风流一代长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9958,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜王阮亭宫詹至粤即送其行 其九","author":"屈大均","text":"相逢黄木口，相送白蘋洲。\n愁绝三江水，东西似御沟。\n沓潮争上下，灵岳乍沉浮。\n船去教风引，还来看蜃楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9959,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜王阮亭宫詹至粤即送其行 其十","author":"屈大均","text":"散带白云林，狂歌一代心。\n无人问山水，之子自清音。\n青岁早知我，泠泠能鼓琴。\n离鸾将别鹄，三叹使情深。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9960,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送高廷评 其一","author":"屈大均","text":"相送白云心，依依似暮禽。\n欲随帆影去，直至泖湖阴。\n廷尉风流美，炎洲景物深。\n他时山与水，莫忘故人琴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9961,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送高廷评 其二","author":"屈大均","text":"自作季鹰鲙，鲈鱼香至今。\n归舟经白荡，莫即爱秋林。\n夫子且兼喜，平生子所钦。\n兰言在怀袖，三岁益情深。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9962,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过钟氏园","author":"屈大均","text":"竹里行厨小，相留一举觞。\n越人负鲙美，蛮女蟹羹香。\n解带乘春暖，开帘及暮凉。\n主人棋兴好，移局过飞梁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9963,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送汤氏兄弟归建昌省其尊人惕庵先生时先生八十馀矣 其一","author":"屈大均","text":"辽东尝作客，皂帽识而翁。\n馈食先人外，谈经弟子中。\n君持名父命，人挹逸民风。\n相见犹呜咽，林泉正道穷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9964,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送汤氏兄弟归建昌省其尊人惕庵先生时先生八十馀矣 其二","author":"屈大均","text":"海内谁华发，天遗一老多。\n君归亲几杖，莫复出烟萝。\n朱萼当春好，黄花奈晚何。\n庞公贤父子，招手鹿门过。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9965,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送曾止山 其一","author":"屈大均","text":"英雄谁得老，天意在吾人。\n但使羊裘在，何妨鹤发新。\n花留贫贱日，酒送乱离春。\n待与清秋雁，重来问白蘋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9966,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送曾止山 其二","author":"屈大均","text":"野寺莺花外，相逢泪满巾。\n犹多天宝客，已少永和春。\n龙去悲明日，天回望此人。\n吾衰何足叹，勉作采芝臣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9967,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送曾止山 其三","author":"屈大均","text":"劳劳南北路，蓬转恨车轮。\n白首空为客，黄金不识人。\n菱花能向暖，菊药亦开春。\n小别还惆怅，梱知日以新。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9968,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"楝亭诗为曹君作","author":"屈大均","text":"苦楝先人树，婆娑只此中。\n枝枝桑梓似，叶叶蓼莪同。\n攀处栖乌满，啼时落月空。\n非因霜露冷，悽怆小亭东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9969,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送沙子雨浮海之日本 其一","author":"屈大均","text":"东浮穷日出，海舶望如山。\n五月开洋去，三冬趁国还。\n省亲旸谷外，题赋岛夷间。\n若木花莲叶，朝朝为我攀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9970,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送沙子雨浮海之日本 其二","author":"屈大均","text":"绕指真柔甚，吾思日本刀。\n雌雄期作佩，长短要吹毛。\n甚欲求徐市，从君上白艚。\n平生浮海志，梦里是波涛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9971,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"为家姑寿","author":"屈大均","text":"吾家一鲍姑，游戏凤城隅。\n衣化车轮蝶，丹成黍米珠。\n神仙多玉女，弟子总鹓雏。\n戴胜春光里，垂腰发尚乌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9972,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠成农部 其一","author":"屈大均","text":"阀阅雄畿辅，声华莫不闻。\n六龙元卞氏，双骥复刘君。\n旌节来炎海，台门起大云。\n韦家经术在，富国讵纷纷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9973,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠成农部 其二","author":"屈大均","text":"讽谏诗无敌，西京一少翁。\n连枝黄阁上，隔坐御屏中。\n出作乘槎使，行高府海功。\n缁衣能好我，雅有古人风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9974,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"九疑","author":"屈大均","text":"帝舜登仙后，衣冠葬在斯。\n九山相似处，二女莫从时。\n斑竹空多泪，苍梧不忍思。\n千秋哀怨曲，祗有楚臣知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9975,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"古庙","author":"屈大均","text":"古庙潇湘尾，微茫接洞庭。\n美人云荡漾，帝子水精灵。\n髻作君山小，衣留兰叶馨。\n微闻抚瑶瑟，声在数峰青。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9976,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"望烂柯山","author":"屈大均","text":"仙人多善奕，王质此中求。\n峡东滇黔水，江吞西北流。\n花边棋局在，石上斧柯留。\n不见樵云者，茫茫我欲愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9977,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"顶湖山","author":"屈大均","text":"瀑泉争汇处，湖出最高峰。\n飞练几千尺，横天一白龙。\n石船黄叶满，天镜白云封。\n洗衲山僧至，苔分麋鹿踪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9978,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吴制府招同诸公游七星岩有作 其一","author":"屈大均","text":"峰峰开石室，一一作云根。\n树有飞梁势，厓多瀑布痕。\n花来频送酒，月上更开尊。\n谢傅风流甚，娱宾有笑言。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9979,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吴制府招同诸公游七星岩有作 其二","author":"屈大均","text":"乳多晴更滴，处处湿人衣。\n石气含云冷，花光出水肥。\n渔樵元得性，簪组亦忘机。\n向夕闻笳吹，山公醉未归。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9980,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟次康州作 其一","author":"屈大均","text":"一入晋康口，鹧鸪声渐多。\n水从红树出，山逐白云过。\n上下渔夫艇，东西蛋女歌。\n鱼花争取处，片片是烟波。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9981,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟次康州作 其二","author":"屈大均","text":"舟从岩口入，惊起郁鸡飞。\n石出多成笋，山开动作围。\n香生芳草地，影乱白云衣。\n清绝锦江水，峰峰浴翠微。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9982,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"王借冈阻浅","author":"屈大均","text":"水浅惟沙口，停舟待暮潮。\n枫黄霜色淡，竹翠雨容消。\n米遣鲥鱼换，船将蛋女招。\n苍苍山月上，酒至放兰桡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9983,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]