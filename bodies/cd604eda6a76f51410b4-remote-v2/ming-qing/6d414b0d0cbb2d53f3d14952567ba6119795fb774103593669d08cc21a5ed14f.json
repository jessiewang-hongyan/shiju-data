[{"title":"湖口舟中口号赠内 其二","author":"屈大均","text":"湖水合将江水流，与卿日日乘轻舟。\n相怜一片鸳鸯水，白浪如山亦不愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13198,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口舟中口号赠内 其三","author":"屈大均","text":"江之水浊湖水清，我如江水湖如卿。\n可怜江水将湖水，清浊同流无限情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13199,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口舟中口号赠内 其四","author":"屈大均","text":"小姑山接大姑秋，不逐长江江水流。\n彭郎矶上一明月，飞去飞来共白头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13200,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"与华姜宿红梅驿 其一","author":"屈大均","text":"生长秦川不见梅，红梅今夕为君开。\n家中绿萼香应满，折取先浮上寿杯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13201,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"与华姜宿红梅驿 其二","author":"屈大均","text":"南枝花白北枝红，红是秦中白越中。\n辛苦鸳鸯飞万里，今宵始宿庾关东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13202,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"与华姜宿红梅驿 其三","author":"屈大均","text":"渐近乡园尔莫悲，南飞应有北飞时。\n南中何物持相慰，尚有梅花及荔枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13203,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"望钟山 其一","author":"屈大均","text":"依然虎踞复龙盘，一片钟山日夕看。\n天作双峰为凤阙，真人长在五云端。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13204,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"望钟山 其二","author":"屈大均","text":"日日江皋望紫烟，天风吹泪孝陵边。\n六朝松柏知多少，苍翠人思乙酉前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13205,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"望钟山 其三","author":"屈大均","text":"云际屏风岭最尊，松杉一路夹天门。\n当时更有梅花树，十里天香接御园。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13206,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"石子冈","author":"屈大均","text":"石子冈前落日催，千秋人尚礼魂来。\n从来地下多生气，白骨何妨委绿苔。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13207,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"同李子自扬州至泰州作 其一","author":"屈大均","text":"邗沟一水接长天，清浅偏宜暖板船。\n榆柳萧萧三十里，北风吹雪冻成烟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13208,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"同李子自扬州至泰州作 其二","author":"屈大均","text":"江南江北柳林中，三日舟行苦朔风。\n双桨如飞吹不转，秣陵东至海陵东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13209,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"同李子自扬州至泰州作 其三","author":"屈大均","text":"水落沙乾川路遥，行行未尽十三桥。\n黄昏且驻仪陵市，露酒车螯慰寂寥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13210,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"同李子自扬州至泰州作 其四","author":"屈大均","text":"日落平田海气凝，风飘万点艋船灯。\n两河水涨渔人喜，枫叶芦花处处罾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13211,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"同李子自扬州至泰州作 其五","author":"屈大均","text":"霜清水涸见渔矶，纲蟹何如簖蟹肥。\n三十盐场多海味，一帆相逐故人归。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13212,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"景阳宫","author":"屈大均","text":"一江春水只流东，六代繁华似梦中。\n多谢垂杨与垂柳，依依犹向景阳宫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13213,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"台城春望","author":"屈大均","text":"飞骑如云塞北回，六朝春色雪中开。\n行人莫折台城柳，曾沐先皇雨露来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13214,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖中怀沈武功 其一","author":"屈大均","text":"三江春水五湖通，一片青天在镜中。\n日暮回舟向林屋，梅花无数与谁同。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13215,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖中怀沈武功 其二","author":"屈大均","text":"天涯一片愁中月，夜夜随风落故乡。\n何日寻君来欈李，二湖相并似鸳鸯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13216,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭录别 其一","author":"屈大均","text":"紫塞归来白发长，美人争拂镜中霜。\n鸳鸯湖畔开樽酒，一曲明妃尽断肠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13217,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭录别 其二","author":"屈大均","text":"万里罗浮今又归，天生越鸟自南飞。\n平生欈李多知己，争送扁舟向夕晖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13218,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭录别 其三","author":"屈大均","text":"枫泾水接泖湖长，白荡鲈鱼入馔香。\n为忆故人林屋洞，移舟西去及春阳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13219,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭录别 其四","author":"屈大均","text":"诸君亦渡太湖来，烟雨离亭更折梅。\n七十二峰空翠里，一峰花落一峰开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13220,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭录别 其五","author":"屈大均","text":"花多不见数峰青，如雪纷纷扑洞庭。\n一片离忧似烟雨，东风吹暗采香泾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13221,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭录别 其六","author":"屈大均","text":"他日寻仙去莫迟，金庭玉柱更相期。\n花边四皓诸孙子，共向烟波理钓丝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13222,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭录别 其七","author":"屈大均","text":"毛公坛畔一泉开，流入寒松万壑哀。\n拂石为君题姓字，风流长记七人来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13223,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠施生 其一","author":"屈大均","text":"梅花如雪扑青冥，香遍东西两洞庭。\n一棹吴淞君正返，相逢烟雨莫釐亭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13224,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠施生 其二","author":"屈大均","text":"洞庭七十二峰长，橘柚秋来香万家。\n我欲来栖范蠡宅，烦君石上扫萝花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13225,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"虎丘中秋夕 其一","author":"屈大均","text":"花舫如云上虎丘，吴阊士女好嬉游。\n今宵醉杀横塘月，酒似金波天际流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13226,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"虎丘中秋夕 其二","author":"屈大均","text":"处处楼台按十番，天边灯火若星繁。\n美人歌遍江南弄，谁听清商不断魂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13227,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"虎丘中秋夕 其三","author":"屈大均","text":"今宵三五足欢娱，一片姑苏似玉壶。\n天作千人歌舞石，月华流满锦氍毹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13228,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"虎丘中秋夕 其四","author":"屈大均","text":"一带船窗捲碧纱，人人歌管斗繁华。\n吴王往日风流在，狂杀苏台十里花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13229,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"虎丘中秋夕 其五","author":"屈大均","text":"真娘墓上玉箫声，十五当垆巧笑迎。\n一自君王能好色，至今吴女尽倾城。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13230,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"虎丘中秋夕 其六","author":"屈大均","text":"珠斗阑干兴倍豪，游人丝竹各分曹。\n金壶好注天河水，莫使东方日色高。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13231,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"锦帆泾","author":"屈大均","text":"锦帆泾水碧涟漪，往日夷光作水嬉。\n留得娟娟亡国月，美人千载学蛾眉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13232,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠某中涓 其一","author":"屈大均","text":"先朝蟒玉赐穿宫，亲见煤山血诏红。\n尝恨不同王内使，海棠枝上殉重瞳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13233,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠某中涓 其二","author":"屈大均","text":"不向西山陪玉匣，思来北塞引雕弓。\n何年始遂从军愿，无定河边作鬼雄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13234,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠某中涓 其三","author":"屈大均","text":"刀环何处贻都尉，马首当年逐冠军。\n无限关山行欲尽，晚来流落在三云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13235,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠某中涓 其四","author":"屈大均","text":"娘子营边杀气寒，朝朝围猎且为欢。\n酒酣射得南山鹿，妓女娇歌捧玉盘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13236,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"冼夫人 其一","author":"屈大均","text":"苦忆英雄娘子军，女中勋业似桓文。\n南朝事去馀犀杖，泪洒炎天万里云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13237,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"冼夫人 其二","author":"屈大均","text":"三朝绣幰自天来，百战金戈向日开。\n保障谁如女刺史，功名能冠越王台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13238,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雷阳曲 其一","author":"屈大均","text":"郎心好似调黎水，不起风波春复秋。\n日日两潮还两汐，令侬消却别离愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13239,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雷阳曲 其二","author":"屈大均","text":"天脚遥遥起半虹，涛声倏吼锦囊东。\n天教铁飓吹郎转，愿得朝朝见破篷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13240,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雷阳曲 其三","author":"屈大均","text":"花下欢闻白马嘶，郎来日日在南溪。\n莫如琼海潮相似，半月东流半月西。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13241,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雷阳曲 其四","author":"屈大均","text":"南亭溪畔二桥前，椰叶阴阴带暮烟。\n蛮女喜簪青茉莉，月明齐汲伏波泉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13242,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雷阳曲 其五","author":"屈大均","text":"数钱争出手纤纤，叶结鸳鸯满玉奁。\n莫道槟榔甘液好，买侬椰子更心甜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13243,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雷阳曲 其六","author":"屈大均","text":"蛮娘细葛胜罗襦，采葛朝朝向海隅。\n为有珠池名对乐，家家生女尽如珠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13244,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雷阳曲 其七","author":"屈大均","text":"夕阳潮挟飓风来，欲渡琼南舟却回。\n望断所欢愁不见，青青一髻是擎雷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13245,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雷阳曲 其八","author":"屈大均","text":"朔日城南小队过，鬟边祗要插花多。\n金钗竞叩三铜鼓，沉水齐薰二伏波。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13246,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雷阳曲 其九","author":"屈大均","text":"薄暮人人射猎归，城端秀塔挂斜晖。\n雷公庙里多箫鼓，十里风吹出翠微。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13247,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"夜宿观山作 其一","author":"屈大均","text":"一夕无衣寐不成，观山山上月凄清。\n松声捲起寒江水，散作风声与雨声。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13248,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"夜宿观山作 其二","author":"屈大均","text":"明月娟娟似翠娥，登高临水奈君何。\n松声欲捲愁心尽，花片犹沾血泪多。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13249,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"山鸟词","author":"屈大均","text":"山鸟朝朝唤客归，溪花日日染侬衣。\n鹧鸪亦解畏霜露，蝴蝶犹知暮不飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13250,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"剧綦","author":"屈大均","text":"楸玉相将日剧棋，兔毫赢得笔枝枝。\n还家赠与青娥妇，细作真书写楚辞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13251,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乌孙公主","author":"屈大均","text":"騊駼为食酪为浆，公主悲愁思故乡。\n黄鹄归飞不可得，岁时一会乌孙王。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13252,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"猎词","author":"屈大均","text":"日落沙场铁骑飞，人人意气射生归。\n美人渴饮黄獐血，更请君王杀一围。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13253,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题张子册 其一","author":"屈大均","text":"五男未得如陶令，二女犹能似左思。\n羡尔惠芳兼织素，珠娘自可当珠儿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13254,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题张子册 其二","author":"屈大均","text":"五年孔雀成金翠，三载夭桃已作花。\n少小谁能题柳絮，可怜娇女在君家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13255,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题张子册 其三","author":"屈大均","text":"九岁解持甄后笔，十三能读谢公书。\n怀中玉映尤娇小，异日张玄妹不如。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13256,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题张子册 其四","author":"屈大均","text":"不必啾啾将九雏，只须皎皎吐双珠。\n明年老蚌君能似，孩笑还多膝下娱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13257,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"初秋有忆","author":"屈大均","text":"一声风雨锦衾凉，不待秋深鬓有霜。\n泉下美人相忆否，三年秋夜为君长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13258,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜陈献孟屡过草堂口占赠之","author":"屈大均","text":"之子相寻逐海潮，东樵朝别暮西樵。\n多情最是松间月，飞去飞来照寂寥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13259,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟出燕子矶","author":"屈大均","text":"夹口横开燕子矶，崩崖千仞掠船飞。\n天风忽向芦花起，白浪如山打翠微。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13260,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"有忆","author":"屈大均","text":"萧郎谢女久分飞，一在黄泉一翠微。\n青鸟不传天外信，可堪清泪日沾衣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13261,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"马将军歌","author":"屈大均","text":"琴鼓长歌复短歌，美人相逐出朝那。\n将军杀贼如围猎，毳帐前头醉叵罗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13262,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蜀冈怀古 其一","author":"屈大均","text":"玉槛珠帘总一丘，春魂多半在迷楼。\n蘼芜亦爱雷塘路，十月青青自不秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13263,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蜀冈怀古 其二","author":"屈大均","text":"一路飞桥压水低，芙蓉多与酒船齐。\n依依最是三春柳，系得君王不复西。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13264,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蜀冈怀古 其三","author":"屈大均","text":"春云黯黯美人斜，秋草萋萋帝子家。\n一代红颜在何处，可怜都作广陵花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13265,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蜀冈怀古 其四","author":"屈大均","text":"一片平芜接海天，江南山色堕楼前。\n双双浮玉天风外，空翠飞来化作烟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13266,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"大明泉","author":"屈大均","text":"峨眉洞穴此潜通，千里陂陀与蜀同。\n泉水谁言君第五，先朝日月出其中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13267,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄程蚀庵","author":"屈大均","text":"万壑松声吹泬寥，一松飞作一天桥。\n嗟君老作黄山客，独采松花不我招。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13268,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梅旅度曲以秋宵闻歌为韵 其一","author":"屈大均","text":"一声风雨客初愁，不唱啼乌泪已流。\n今夕樽前须尽醉，黄花犹为故人秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13269,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梅旅度曲以秋宵闻歌为韵 其二","author":"屈大均","text":"明月高高廿四桥，南弦北管坐相邀。\n谁能即策花骢去，不向扬州度此宵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13270,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梅旅度曲以秋宵闻歌为韵 其三","author":"屈大均","text":"万里天河淡欲分，玉杯飞处湿行云。\n多情最是齐梁曲，恨尔江南夜夜闻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13271,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]