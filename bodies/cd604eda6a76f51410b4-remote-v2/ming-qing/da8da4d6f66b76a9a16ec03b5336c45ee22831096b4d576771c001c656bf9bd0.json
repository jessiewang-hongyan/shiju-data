[{"title":"前雁字诗十九首 其二","author":"王夫之","text":"碧浪合逡巡，萧条接迹亲。\n三苍言外旨，七日句中春。\n避暑疑秦火，怀沙吊楚臣。\n云林添画笔，中土不无人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1986,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"前雁字诗十九首 其三","author":"王夫之","text":"活谱赋秋声，音容共一清。\n空顽难转语，天老未忘情。\n羽调悲寒水，行吟倦汨征。\n芦干悽怨急，绝笔意谁平。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1987,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"前雁字诗十九首 其四","author":"王夫之","text":"鹊渡已如梦，深秋始报章。\n偷临无乳燕，低诵有寒螀。\n落叶勤雠误，墟烟与秘藏。\n重来无粉本，随意写苍苍。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1988,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"前雁字诗十九首 其五","author":"王夫之","text":"纪艳非吾义，惊春去色匆。\n分飞南北史，历乱桧曹风。\n天问凭条答，空言未道穷。\n何须藏鲁壁，丝竹奏清融。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1989,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"前雁字诗十九首 其六","author":"王夫之","text":"无待月中听，哀吟意已形。\n同文从鸟纪，驰檄指龙庭。\n旁午悲边雪，零丁寄汗青。\n清泉涵片影，井底血函经。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1990,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"前雁字诗十九首 其七","author":"王夫之","text":"冉冉漾轻柔，关河只此愁。\n鹰鹯疑谤诅，鸠鸴漫咨诹。\n水月三人影，霜霄一抹秋。\n江山日日改，挟策亦奚游。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1991,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"前雁字诗十九首 其八","author":"王夫之","text":"今古一相如，飘飖赋子虚。\n元文披带草，碧个仿林于。\n兰叶肥还瘦，银钩蹙已舒。\n稻粱非汝志，投笔莫欷歔。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1992,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"前雁字诗十九首 其九","author":"王夫之","text":"乘风莫草草，雨雪且舒邪。\n燕国迷苍素，鹃言染茹藘。\n六歌怀天水，尺一谢休屠。\n一线台城诏，难忘纸鹞书。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1993,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"前雁字诗十九首 其十","author":"王夫之","text":"此字无人识，空劳历九州。\n分明扶日月，因革自春秋。\n鸩篆删妖步，莺歌耻佞喉。\n冥飞谁弋篡，不坠草元楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1994,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"前雁字诗十九首 其十一","author":"王夫之","text":"野水漾初春，苔涵绿字新。\n烟云都不染，风雨故如神。\n软影翰非弱，馀寒手不龟。\n凤兮衰已久，还现素臣身。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1995,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"前雁字诗十九首 其十二","author":"王夫之","text":"终知无寄处，不欲昧前期。\n人世谁长目，天心自列眉。\n寒宵闻见外，皑雪炫荧时。\n岂为知音绝，停毫罢远思。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1996,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"前雁字诗十九首 其十三","author":"王夫之","text":"脉脉有心期，行行且浪嬉。\n大人狂客传，小雅遗民诗。\n解就名鸿烈，书成授意而。\n关门邀紫气，聊与著雄雌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1997,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"前雁字诗十九首 其十四","author":"王夫之","text":"晴空不易得，欲示下方难。\n黑月韦编绝，酸风蠹迹残。\n黄麻悲鹭序，白简笑鹰弹。\n独吹青燐火，传书乙夜寒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1998,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"前雁字诗十九首 其十五","author":"王夫之","text":"倚杖孰亭皋，寻行送望劳。\n霞章添旖旎，星采点萧骚。\n唯觉孤心合，难将远目韬。\n昏鸦空泼墨，何当一鸿毛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1999,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"前雁字诗十九首 其十六","author":"王夫之","text":"居然缘慧业，亦自种情苗。\n始旦回鸾帖，清秋题鹊桥。\n弥天知泛宅，露地注逍遥。\n既證无师智，灵云瞥眼消。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2000,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"前雁字诗十九首 其十七","author":"王夫之","text":"痴蝇钻故纸，窗隙溷云容。\n天外劳一笑，书中谁万钟。\n童乌何足与，燕颔止为佣。\n小过占哀俭，飞离不恤凶。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2001,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"前雁字诗十九首 其十八","author":"王夫之","text":"一从悲凤靡，长是问苍旻。\n南北招重叠，风霜挟苦辛。\n昔时人不见，归去柰何春。\n童子三生塔，还留慧命因。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2002,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"前雁字诗十九首 其十九","author":"王夫之","text":"青女授灵符，全身入画图。\n血潮勒款识，毛鸷化酸迂。\n天变人终定，云生道不孤。\n无心持换米，生计有雕胡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2003,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后雁字十九首 其一","author":"王夫之","text":"之绕打虚空，经营惨淡中。\n虫鱼多诘屈，龙马半昭聋。\n副墨传溪影，雌黄听落虹。\n天情骀宕里，消息一丝通。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2004,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后雁字十九首 其二","author":"王夫之","text":"寓言河汉迥，草线与灰蛇。\n应迹说随扫，文身开复遮。\n梵书疑以八，易象半交叉。\n飞舞茅龙趣，江门忆白沙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2005,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后雁字十九首 其三","author":"王夫之","text":"抗坠引清微，灵心挟肉飞。\n蜗银真白俗，鲗墨莽钟肥。\n主乙疑无定，偏傍竟不违。\n方春湘水上，拓得禹碑归。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2006,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后雁字十九首 其四","author":"王夫之","text":"尘气不馀纤，凭虚一缕黏。\n分歧垂远势，透露簇微尖。\n曳脚神还整，藏锋力自铦。\n臣书真逸品，凤藻得无嫌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2007,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后雁字十九首 其五","author":"王夫之","text":"闪霍仿公孙，垂垂引漏痕。\n装潢悬玉宇，授受付金昆。\n带雨流鹑火，衔芦赋大言。\n灵文人未测，只倩记寒温。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2008,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后雁字十九首 其六","author":"王夫之","text":"密迹簇春蚕，青编削蔚蓝。\n阙文唯夏五，足用及冬三。\n元鸟谁徵宋，金天旧问郯。\n笔花欲有授，鸟梦柰沈酣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2009,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后雁字十九首 其七","author":"王夫之","text":"湘岸临潭帖，天山拓汉铭。\n为谁修楚史，自解注禽经。\n语雀羞刑牍，言鹦笑说铃。\n挥毫千里泻，腕脱不曾停。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2010,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后雁字十九首 其八","author":"王夫之","text":"耻化顽仙羽，新宫待尔题。\n河山双划断，物论片言齐。\n脉望徒吞字，蟾蜍未映迷。\n寒陵劳坐卧，极目去踪低。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2011,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后雁字十九首 其九","author":"王夫之","text":"霁雪曙南天，孤萦倍可怜。\n蛾眉流晓镜，香尾篆垆烟。\n幽意蝇头密，连丝茧绪牵。\n灵纹惊易没，移入断云边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2012,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后雁字十九首 其十","author":"王夫之","text":"秋思本无多，千行自不讹。\n清姿从倒薤，壮志欲眠戈。\n散队连行草，遥天任擘窠。\n催花看尽发，谁与换群鹅。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2013,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后雁字十九首 其十一","author":"王夫之","text":"涤砚袅元云，潇湘写练裙。\n龙蛇双腕竞，鱼燕尾梢分。\n出像传毛颖，题帧仿墨君。\n夫人学已熟，谁复笑羊欣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2014,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后雁字十九首 其十二","author":"王夫之","text":"素宇无留墨，平沙印别痕。\n暗书还自省，未到意先吞。\n映雪功弥苦，依天道已尊。\n八纮开义海，潇洒动乾坤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2015,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后雁字十九首 其十三","author":"王夫之","text":"浑敦帝鸿开，谁云子不才。\n国门悬月令，南极转三能。\n下士称微者，雄风咏快哉。\n匆匆春早驾，荐福畏惊雷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2016,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后雁字十九首 其十四","author":"王夫之","text":"沙雪笺银暗，芦锋笔阵降。\n惊飙催就急，虚白人钩双。\n发细萦空镜，晴波上晓窗。\n研朱和露滴，枫冷落吴江。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2017,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后雁字十九首 其十五","author":"王夫之","text":"有句兼无句，羚羊偶挂尖。\n吹毛传密谛，带影悟廉纤。\n化迹空三藏，迷人顶一砭。\n献花岩畔鸟，半偈不曾拈。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2018,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后雁字十九首 其十六","author":"王夫之","text":"刮目经年别，惊非吴下蒙。\n四声终写入，六义不删风。\n耻逐蝌文乱，谁凭雉译通。\n斯文知未丧，几复畏虚弓。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2019,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后雁字十九首 其十七","author":"王夫之","text":"淡墨布层层，痴肥自不胜。\n回文低落月，影本暗渔镫。\n险句从空搆，秋思与上兴。\n悬题天阙迥，为尔费冰兢。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2020,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后雁字十九首 其十八","author":"王夫之","text":"始知空阔里，无数妙诠偕。\n娓娓谈天衍，痕痕炼石娲。\n纸光从月砑，笔冢有云埋。\n仙笈传青鸟，空劳曼倩谐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2021,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后雁字十九首 其十九","author":"王夫之","text":"未肯负居诸，飘流不废书。\n长涂收史料，小正作经疏。\n赝迹徒相似，鸿儒亦借誉。\n鲲鹏聊志怪，终是不才樗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2022,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题芦雁绝句十八首 其一","author":"王夫之","text":"惊风吹霰雪中还，万里黄云一线关。\n回首江南此风景，唯将呜咽写潺湲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2023,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题芦雁绝句十八首 其二","author":"王夫之","text":"汀渚谁家尽自疑，悬愁渔火隔江知。\n飘零亦是前生果，不羡鹪鹩老一枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2024,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题芦雁绝句十八首 其三","author":"王夫之","text":"月明是水是芦花，逗漏清空片影斜。\n沙上有踪谁见得，侬家曾泛逆流槎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2025,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题芦雁绝句十八首 其四","author":"王夫之","text":"健翮先飞下浅汀，鱼虾虽饱却馀腥。\n何如且带斜阳影，点缀残山一段青。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2026,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题芦雁绝句十八首 其五","author":"王夫之","text":"秋江淼淼月微明，飞雪纵横点翅轻。\n自学春莺穿柳絮，不知白羽赚苏卿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2027,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题芦雁绝句十八首 其六","author":"王夫之","text":"簇簇霜花覆浅滩，荻根蒋叶一江寒。\n秋声彻夜惊鸥鹭，筝柱参差不忍弹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2028,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题芦雁绝句十八首 其七","author":"王夫之","text":"蜀雪消迟水拍空，前时汀渚杳蘋风。\n今宵随分聊收翼，只在秋声一派中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2029,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题芦雁绝句十八首 其八","author":"王夫之","text":"老碧蒙茸嫩叶齐，一钩斜月照幽栖。\n清宵寒梦虽无据，不到飞狐谷口西。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2030,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题芦雁绝句十八首 其九","author":"王夫之","text":"南来不为稻粱谋，彻骨森寒月下洲。\n藻苦荇甜随口过，饥鸢莫漫为含愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2031,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题芦雁绝句十八首 其十","author":"王夫之","text":"书人欲倦曳波长，一幅皑皑侧理光。\n尽捲丹坟归竹素，不留之绕待雌黄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2032,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题芦雁绝句十八首 其十一","author":"王夫之","text":"浅白平铺万绿稠，苍翎碧水素沙洲。\n色如非色云何摄，一味分明墨气收。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2033,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题芦雁绝句十八首 其十二","author":"王夫之","text":"渔艇无踪樵径荒，平沙露冷月微茫。\n问师此景从谁得，莫是前身现雁王。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2034,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题芦雁绝句十八首 其十三","author":"王夫之","text":"惊心矰?晓饥馀，何有壸浆一艇渔。\n莫道相酬无宝剑，明年先寄报恩书。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2035,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题芦雁绝句十八首 其十四","author":"王夫之","text":"密叶修茎翠万竿，未须还怨晓霜寒。\n天涯拚作无归客，且得清秋一夕安。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2036,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题芦雁绝句十八首 其十五","author":"王夫之","text":"回望还惊伴侣迟，分飞愁绝故心移。\n江皋莫爱霜枫紫，自是栖乌夜宿枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2037,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题芦雁绝句十八首 其十六","author":"王夫之","text":"秋心万古此潇湘，汉苑胡关带恨长。\n谁道灵均哀思绝，唯将鶗鴂怨年芳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2038,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题芦雁绝句十八首 其十七","author":"王夫之","text":"斜晖欲下飐金飙，绿苞初开碎练飘。\n莫认天山飞雪早，江南饶有可怜宵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2039,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题芦雁绝句十八首 其十八","author":"王夫之","text":"墨光之外喷秋光，夜永江寒楚塞长。\n记得苍梧多泪竹，缄愁无柰断衡阳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2040,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"仿昭代诸家体三十八首 一 刘护军基 秋兴","author":"王夫之","text":"括苍云绕缙云都，万簇芙蓉翠色铺。\n红雨湿飞乌桕薄，碧波晴点鹭痕孤。\n登楼有赋依州牧，长揖无门傲酒徒。\n不识故园他日泪，蘋花还送暗香无。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2041,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"仿昭代诸家体三十八首 二 杨提举维桢 嬉春","author":"王夫之","text":"选胜明朝陌上花，狂夫已宿黄公家。\n连钱夜洗香泥点，团扇新描软縠纱。\n燕尾掠人沾绿酒，莺歌随处咒兰芽。\n片云南浦不成雨，油幕高搴看晚霞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2042,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"仿昭代诸家体三十八首 三 倪处士瓒 园居","author":"王夫之","text":"长夏新桐洗绿茎，乳莺历乱啄朱樱。\n不知微雨遮青嶂，即次流珠溅紫萍。\n閒整丹经香篆歇，小临鹤径碧苔生。\n棋枰已敛湘帘捲，稍觉银钩挂岭横。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2043,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"仿昭代诸家体三十八首 四 贝助教琼 感乱","author":"王夫之","text":"正作越来溪上梦，潮声夜打浙东城。\n春花春柳皆他日，羽檄羽书悲此生。\n戍火摇烟低片月，归鸿掠浦警三更。\n堂堂岁月相欺得，明镜新添雪几茎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2044,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"仿昭代诸家体三十八首 五 袁御史凯 白燕","author":"王夫之","text":"乌衣莫与怨斜阳，雪色新裁素练裳。\n隋苑柳疏长带月，河阳花满不惊霜。\n琼窗瞥眼窥银字，玉镜偷临斗靓妆。\n似妒蘋花秋色好，不留清影照寒塘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2045,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"仿昭代诸家体三十八首 六 高太史启 梅花","author":"王夫之","text":"稍觉逢春客思催，江春无奈促花开。\n一枝横水寒潭月，几点回风雪砌苔。\n啼鸟易惊归客梦，陇云空寄故园哀。\n东风已遣芳心尽，谁与垂杨衒楚台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2046,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"仿昭代诸家体三十八首 七 刘典签炳 早朝","author":"王夫之","text":"暄风绿草凤台新，金爵浮光射宝轮。\n云敛三山澄海气，日华双阙起江春。\n衣裳初识龙文阔，导唱遥欣黼座亲。\n还使故园归兴尽，鸣珂长日惜芳尘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2047,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"仿昭代诸家体三十八首 八 孙典籍蕡 客思","author":"王夫之","text":"扁舟下峤识春寒，五两随风度几滩。\n古渡铙吹侵月奏，孤城楼堞带云看。\n故园荔酒经春熟，过岭梅花度雪残。\n一曲沧浪牵客泪，羊城珠斗冷仙坛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2048,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"仿昭代诸家体三十八首 九 高礼曹柄 酬答","author":"王夫之","text":"弹铗新从上国行，遥瞻山斗识才名。\n汉廷属望贤良策，鲁殿初传丝竹声。\n柳色上衣春日酒，梅花吹笛岁寒情。\n殷勤莫负乘槎约，拂剑欣看碧汉清。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2049,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"仿昭代诸家体三十八首 十 李少师东阳 感春","author":"王夫之","text":"小园花发镇帘垂，春草临阶未觉滋。\n香尾困风穿湿幕，墨胶凝水带冰澌。\n病中药裹烦南客，梦里兰芳记楚辞。\n犹有湘干田二顷，君恩不许趁耕时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2050,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"仿昭代诸家体三十八首 十一 陈简讨献章 晚酌","author":"王夫之","text":"日㬉风微柳匝溪，分明莎径未须迷。\n莺声过涧还如近，蝶翅因花亦屡低。\n心迹同原聊共赏，乾坤双歇恰单提。\n芒鞋是处寻春好，不拣苍苔与沁泥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2051,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]