[{"title":"和梅花百咏诗 其七十七 柳营梅","author":"王夫之","text":"系马蟠根铁色粗，寒光飞练射昆吾。\n花前莫话封侯事，一树功成万木枯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1921,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其七十八 蔬圃梅","author":"王夫之","text":"挑荠正美芥回青，脆甲中含碎玉零。\n缓火夜烹风味别，孤芳生齿酒初醒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1922,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其七十九 茅舍梅","author":"王夫之","text":"小角阴垂槲径遮，浅檐风转搅横斜。\n佳人何必牵萝补，百琲明珠缀若邪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1923,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其八十 药畦梅","author":"王夫之","text":"竹籞密排落叶蠲，寻芽访蕊试新年。\n黄精苗绝蘼芜?，略报东风一点暄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1924,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其八十一 前村梅","author":"王夫之","text":"小径冰封碍往还，春心遥寄有无间。\n开窗欲觅香来处，犹隔当门一段山。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1925,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其八十二 炤水梅","author":"王夫之","text":"朱点当心印不如，一花五叶我逢渠。\n万波摇动兼遮显，斜领犹看不见馀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1926,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其八十三 山中梅","author":"王夫之","text":"捷径无心假息机，豹林谁买玉田肥。\n人閒好句传高启，驱遣袁安卧翠微。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1927,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其八十四 城头梅","author":"王夫之","text":"画影斜连大旆阴，丽谯日暮饱归禽。\n岧峣一听睢阳笛，月苦云深天地心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1928,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其八十五 冰竹梅","author":"王夫之","text":"寒池清浅影笼冰，雾上云鬟冷不胜。\n斜倚琅玕舒凤尾，翠帏深拥㬉香凝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1929,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其八十六 水月梅","author":"王夫之","text":"玉魄昏黄罩素魂，縠波潋滟吸香痕。\n分身自在双涵得，总被空青一镜吞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1930,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其八十七 担上梅","author":"王夫之","text":"累垂得得到江城，妆点琴囊衬酒鎗。\n棐几素屏充供养，闺中莫听卖花声。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1931,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其八十八 杖头梅","author":"王夫之","text":"玉色分鸠瑩不任，庞眉霜鬓映森森。\n道逢禅客机缘捷，摆落天花雪满襟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1932,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其八十九 隔帘梅","author":"王夫之","text":"银蒜遮寒小閤深，胆瓶曲槛两沈吟。\n疏筠咫尺天涯路，一曲潇湘万里心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1933,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其九十 照镜梅","author":"王夫之","text":"鼻观分明到眼惊，他心通尽意身生。\n凭谁拈笑分宾主，水月空轮挂宝璎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1934,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其九十一 十月梅","author":"王夫之","text":"为惜霜红昨日凋，续香补艳倩新条。\n一枝迎雪元多丽，何事王维更画蕉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1935,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其九十二 二月梅","author":"王夫之","text":"□馡怕被素玚欺，青豆傍看玉蕊垂。\n听彻莺喉邀蝶舞，风流何必少年时。","collection":"明末清初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1936,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其九十三 未开梅","author":"王夫之","text":"万顷春膏凝玉酥，晓霜残月足踟蹰。\n须须叶叶无中有，一幅先天五老图。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1937,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其九十四 乍开梅","author":"王夫之","text":"蚌胎微吐露灵砂，略与东皇报岁华。\n底事花魂多荏苒，逼人诗思在些些。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1938,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其九十五 半开梅","author":"王夫之","text":"心心长待笋班齐，南北中分人望迷。\n残腊易消春易老，怕教抛尽惹莺啼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1939,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其九十六 全开梅","author":"王夫之","text":"晨探莫惮冻云天，一日风光尽一年。\n暂喜真珠抛十斛，悬愁银甲搯苔钱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1940,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其九十七 水墨梅","author":"王夫之","text":"冷晕圆拖碯碗浆，古香浓喷豹皮囊。\n分圈硬用中峰笔，百首诗情此较长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1941,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其九十八 画红梅","author":"王夫之","text":"被酒濡毫敌晓寒，淋漓狂扫万枝珊。\n禅心为笑花光老，借得妆楼绣谱看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1942,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其九十九 玉笛梅","author":"王夫之","text":"曲里寻春已惘然，瑶村况觅洞庭仙。\n空花和合声香色，带影独头起识田。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1943,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其一○○ 纸帐梅","author":"王夫之","text":"幽艳浓熏㬉雪窝，流香横漾皱纹波。\n轻姿梦醒镫前现，隔断白云奈采何。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1944,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"追和王百谷梅花绝句十首 其一","author":"王夫之","text":"梅叶上红争欲落，南枝何处索春光。\n姮娥前夕开明镜，莫有佳人试早妆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1945,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"追和王百谷梅花绝句十首 其二","author":"王夫之","text":"元魂不死空明外，秋水秋云总似花。\n直待江春问消息，痴拈袜线觅袈裟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1946,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"追和王百谷梅花绝句十首 其三","author":"王夫之","text":"停觞待月似蒸砂，一瓠先生病吃茶。\n认得六桥鳏处士，湖光封雪觅梅花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1947,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"追和王百谷梅花绝句十首 其四","author":"王夫之","text":"当时幸免赐官湖，败叶聊遮冷鹧鸪。\n有土种梅三百树，焚香无地避催租。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1948,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"追和王百谷梅花绝句十首 其五","author":"王夫之","text":"万花争尽垒东西，雪骨霜魂分不齐。\n金粟迎寒开月浦，絪缊香雾一双迷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1949,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"追和王百谷梅花绝句十首 其六","author":"王夫之","text":"黄梅瓤熟无多日，玉露催秋月屡弦。\n但使看花留老眼，不愁春色恼人偏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1950,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"追和王百谷梅花绝句十首 其七","author":"王夫之","text":"白头綵笔写氤氲，香霭描来雪几分。\n犹恐相逢不相识，拟添残月与轻云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1951,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"追和王百谷梅花绝句十首 其八","author":"王夫之","text":"断岭知谁旧种来，藤萝无限妒花开。\n蓬蒿初剪清魂洗，旧尉三生也姓梅。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1952,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"追和王百谷梅花绝句十首 其九","author":"王夫之","text":"渐老看花似隔烟，诗情欲懒上滩船。\n绯桃红药输年少，把雪吟霜却少年。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1953,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"追和王百谷梅花绝句十首 其十","author":"王夫之","text":"彭城才子太怜梅，一舸轻移郢树开。\n红粉喷香薰小阁，冻蜂迢递许重来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1954,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其一","author":"王夫之","text":"潇湘北下巴江东，上蟠下际抟青空。\n天地忘忧消偪侧，凄清作意撩鸿濛。\n夔子孤城悬太白，三苗馀垒挂残虹。\n古今无那此俄顷，欹危歘尔生蘋风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1955,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其二","author":"王夫之","text":"月似芦花烟似水，似如不似劳形容。\n喷雪凝寒犹清适，涵晖冷燄飞轻松。\n星汉相看交不昧，心魂欲之亦奚从。\n但觉晃煟透圆碧，不辨愁来忽已逢。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1956,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其三","author":"王夫之","text":"大仪悬张覆釜幢，谁其至者弗心降。\n长天纤忽随泯泯，商飙骚屑入淙淙。\n浩瀚无馀一丝挂，清微欲将九鼎扛。\n安得沐日仍浴月，东赪西皎晶荧双。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1957,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其四","author":"王夫之","text":"洞䆗虚无净一规，惊涛相即不相疑。\n精金大冶鍊幽蚃，俊鹘老鼍愁倾危。\n炎心已改何洗涤，高旻受荡还清嬉。\n妙香浮动非蘋芷，水雾上摄开轻吹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1958,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其五","author":"王夫之","text":"乾坤倦游行将归，损山容益水光肥。\n片云帆侧不能影，木叶天际知己飞。\n游子去妻百交感，战伐渔樵双息机。\n驱除姝暖返肃爽，禁愁为惜素心违。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1959,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其六","author":"王夫之","text":"羁心劈破芥浮居，色色消沈远近如。\n险目不平夹韵度，凉魂小住姑安舒。\n孙刘战争问沤沫，怀葛徂伏留萧疏。\n情知涕泗无栖泊，放浪磊砢任太虚。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1960,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其七","author":"王夫之","text":"翛然容与清泠都，何求不得须黄垆。\n函盖双枢合骀宕，明暗半丝分有无。\n潜蛟旅雁忘兴废，疏云片月矜昭苏。\n缩为椰子沁心肾，幻计无忝移山愚。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1961,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其八","author":"王夫之","text":"空有无垠铲径蹊，分明至极翻凄迷。\n远视不正非野马，客心已窘聊木鸡。\n帆蝶卖眼惊天末，樯乌亡赖啼日西。\n阴光夕灼动绿气，?然鬼臂相牵携。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1962,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其九","author":"王夫之","text":"碧落无疑鹏背揩，入寥天一绝安排。\n邂逅不停增蹇产，虚空未破犹沈埋。\n略遣水光存芥蒂，想知天骨正厓柴。\n鲸鲤可骑终未称，吾生箬笠双青鞋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1963,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其十","author":"王夫之","text":"回头摇落悲群动，广大昌明亦自猜。\n无触之声消梦晷，不寒而慄贮骚才。\n藏舟后夜同归壑，张楚初心冀缓哀。\n驰骛清狂何所吝，寒潭降潦畏相催。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1964,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其十一","author":"王夫之","text":"瀰瀰盈盈不借春，千萧万瑟屯嶙峋。\n水力未至溢浩淼，雄心仅可吞清贫。\n张乐鼓瑟凭慰藉，巫娥湘后惘逡巡。\n自然难释虚无恨，斜月流霜非有因。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1965,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其十二","author":"王夫之","text":"目穷差别耳非闻，逼塞诸根但有云。\n触法大都无软美，宽饶何处着殷勤。\n如浮今古谁为纽，尽费烟霄不受熏。\n一笑中流誇定力，那知悽恻破三分。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1966,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其十三","author":"王夫之","text":"西清启寒亦有门，扃魂不扃金水魂。\n方诸津润遂昌大，青女娥㜲失恭温。\n孤云峰势向凌替，海天精彩捐烦冤。\n空洞虽非万法侣，临之未易相贪吞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1967,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其十四","author":"王夫之","text":"随处波心着戏竿，刚森簇簇护轻安。\n充形暄气存黍米，大冶昭质任烹爨。\n根株吾岂依坟埴，须发何庸非羽翰。\n霏苍飏碧自生意，行与浑仪谋团栾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1968,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其十五","author":"王夫之","text":"远行之感剧登山，壑断湍哀梦亦悭。\n戍火祠烟荡精切，长天白雨怙痴顽。\n天涯交臂早无绍，去景凝眸暂不閒。\n难与此怀觅止竟，征鸿一缕空飞还。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1969,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其十六","author":"王夫之","text":"塞臆英多杜口宣，清歌难唤奈何天。\n古人不见閒邀月，置我无从小学仙。\n铁脊未妨聊旖旎，金轮犹恐不刚坚。\n馀霞落日关何事，带影微茫起识田。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1970,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其十七","author":"王夫之","text":"法界孤微此泬寥，鲲游亦竦等鹪鹩。\n环区不鲠鱼头乙，泓水方凝雀目椒。\n浓露可怜添浥润，片云何恃得逍遥。\n穷涂收拾千年恨，虾国游谁出斗跳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1971,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其十八","author":"王夫之","text":"欱然敛精归元包，匀凝活汞停煎炮。\n穹窿舍此复何有，沆瀣相干故不交。\n稍觉丝缗牵静谧，非分玉笛喧淫咬。\n神光四映飞芒角，讵倚星月相杂殽。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1972,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其十九","author":"王夫之","text":"弱骨凌乘一线操，未凭长目送雄豪。\n通身冰血争融结，伸臂烟霄试抑搔。\n岂必人生方幻寄，足知厚载不功高。\n金风但鼓囊中籥，大费尖酸徒尔劳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1973,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其二十","author":"王夫之","text":"晶辉蠕影萦一窝，澄之荡之夫如何。\n容裔积已成坚冽，鏦铮喧外绝烦苛。\n绿非荇藻发谁浦，光带露霜自昨波。\n惊鸿亦知无闻见，抱意长鸣凌嵯峨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1974,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其二十一","author":"王夫之","text":"大圆不息翻河车，闪烁万顷吹银芽。\n化汁一色混潇皛，青气双合通荒遐。\n无质可抟犹沐浴，有见不盈奚开遮。\n何得丧耦此孤坐，谁邀明月觅芦花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1975,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其二十二","author":"王夫之","text":"三秋三楚填淫荒，谁能不断忧思肠。\n遥遥极浦浮云树，渺渺生洲迷荻蒋。\n马殷南国飞星白，陆逊西垒落日凉。\n咫尺千波杳向往，孰为大壑恣埋藏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1976,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其二十三","author":"王夫之","text":"浮槎无系巴邱城，缥渺之楼空若惊。\n微霜覆蓑失残梦，远火照帆悲他情。\n乘乘宇内既清澈，脉脉空际或经营。\n小范于此言忧乐，胸中无故横甲兵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1977,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其二十四","author":"王夫之","text":"微风软縠退以听，濯濯平远拔昭灵。\n吝俭物情不获巳，险阻大造故须经。\n馀霞半壁从明灭，征雁万双亦伶俜。\n居然幻泡警凉魄，无数浮心一日扃。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1978,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其二十五","author":"王夫之","text":"崚嶒何来凛气增，舍此空轮无与胜。\n吴天海色遥迎送，楚霜蜀冻交消凝。\n荡涤赤日曳素练，消息银汉络珠绳。\n从知白帝威权甚，万象泻影涵倾崩。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1979,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其二十六","author":"王夫之","text":"鹧鸪声断西日浮，君山未愁黄陵愁。\n白浪几何倾楚塞，金风既展讫神州。\n萧飒万个撼斑管，迢递千古疑胶舟。\n贾至张说尔何物，落拓欲牵万里忧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1980,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其二十七","author":"王夫之","text":"但哀无端眇淫淫，长啸不展狂歌瘖。\n欲与招魂迷南北，横令此愁亘古今。\n蛰雷残雨无所藉，金枢玉露亦难谌。\n日暮息棹殊未已，寒波倒射冉枫林。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1981,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其二十八","author":"王夫之","text":"玻瓈帝网两镜参，元中之元清灵酣。\n露泡影相合不二，水月空观谁为三。\n中流两岸四无定，鸟道一碧微自谙。\n军持满汲寒沁骨，容受无多祇大惭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1982,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其二十九","author":"王夫之","text":"青幕白地清涎黏，浓淡分界唯微纤。\n未审天容亏半壁，定疑水气消馀炎。\n披襟不让云将御，理楫略挂羚羊尖。\n鏖空白战九十日，吸月餐风亦损廉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1983,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭秋三十首 其三十","author":"王夫之","text":"玉液统此微霄函，俯仰不知灵与凡。\n旭雾平收兜罗捲，阴彩夕涌牟尼嵌。\n肉翅欲愁千里倦，韵目难厌一晌馋。\n苍螺半点点霜色，谪仙何情强欲芟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1984,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"前雁字诗十九首 其一","author":"王夫之","text":"缕缕渐深深，当天一片心。\n书云占朔色，縆瑟谱商音。\n尺帛无劳系，南楼未易寻。\n暝烟生极浦，长夜付浮沈。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1985,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]