[{"title":"金鸡晓霞","author":"卢若腾","text":"立石金鸡唱晓声，曙光红泛早潮平。\n暖蒸春髓浮元气，小结仙壶幻赤城。\n捧日天真瞻咫尺，应时海亦象文明。\n晴霞五色涛千丈，稳载长更十二程。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3654,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"十六字令  闺情","author":"曹溶","text":"轻。\n认得伊家画屧声。\n花边绕，蛱蝶不曾惊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3655,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"望江南  其一 本意","author":"曹溶","text":"江南远，乳燕不曾来。\n千里信回春水阔，一年人去野棠开。\n香阁在尘埃。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3656,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"望江南  其二 本意","author":"曹溶","text":"江南小，近日不藏春。\n朱户半开眠宿酒，粉娥成队散轻尘。\n弦管正愁人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3657,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"望江南  其三 本意","author":"曹溶","text":"江南别，旧泪一双流。\n笛弄夜凉关路黑，虫悬叶老玉衣秋。\n且莫盼兰舟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3658,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"望江南  其四 本意","author":"曹溶","text":"江南恨，亭榭少人看。\n醉里不堪啼鴂早，梦余初觉卖花寒。\n风雨又漫漫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3659,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"如梦令  有感","author":"曹溶","text":"唤起残红莺困，衔取馀香蝶嫩。\n独坐此何年，阁外飘来幽恨。\n休问，休问，都绕眉峰一寸。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3660,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"如梦令  有怀","author":"曹溶","text":"梦断金炉不暖，春到樱桃小苑。\n惊起双燕飞，斜倚栏干昼短。\n人远，人远，心被东风吹软。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3661,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"相见欢  与蒋前民饮酒","author":"曹溶","text":"霜天敝了羊裘，荻花秋。\n恰遇纤帘高士倚江楼。\n垂柳罅，琵琶砑，是扬州。\n触著一生心事到眉头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3662,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"酒泉子  春情","author":"曹溶","text":"翠陌人遥。\n和泪银泥欲滴。\n帐中香，墙外笛。\n冷春宵。\n画裙空绾鸳鸯带，梦去重帘相碍。\n月嫌明，花倦戴。\n待归桡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3663,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"生查子  代赠","author":"曹溶","text":"帘外响铜签，雁唳秋宵远。\n罗帐烛光微，不信檀郎浅。\n惜别展幽欢，梦逐银屏转。\n飞去学鸳鸯，一枕花魂软。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3664,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇  寄兴","author":"曹溶","text":"斜掩红窗，影迷前日桃花路。\n送春三度，只有人如故。\n瘦减腰围，每被征衫诉。\n归心误，雨声深处，江上扁舟暮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3665,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇  平远台秋眺","author":"曹溶","text":"愧杀陈琳，磨残铁砚收军后。\n喜逢凉昼，千里都穿透。\n高处生寒，渐逼蛮花瘦。\n人如旧，海光一溜。\n熨尽青山皱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3666,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪纱  閒情","author":"曹溶","text":"陌上髯苏唱柳绵，载花须趁越江船，惜春春去又今年。\n静馆碧樽闲客夜，软风红药恨人天，新来何处得轻怜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3667,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪纱  倦圃山矾盛开","author":"曹溶","text":"飘尽红英陌上尘，雕阑重倚玉腰身，仙花唤得小名真。\n腻粉愁衔蜂翅软，温香旧忆麝脐匀，春归偏要惹游人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3668,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪纱  其一 四十年来所见歌姬某氏最丽赠之","author":"曹溶","text":"仕女行来乐部同，双垂罗带鬓蝉松，心儿旖旎锦堂中。\n浪滚舞茵怜静婉，尘轻香迹认翔风，几曾容易得相逢。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3669,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪纱  其二 四十年来所见歌姬某氏最丽赠之","author":"曹溶","text":"玉笛先将密意通，新声一缕绛云笼，把人薰得口脂浓。\n屏里扑成惊蛱蝶，烛前捏就软芙蓉，只愁春到不禁风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3670,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪纱  独坐","author":"曹溶","text":"檀板休催日暮天，鸟程信断冷银船，杖头飞尽阮家钱。\n芍药开时心易怯，鹧鸪啼后梦难圆，僧楼闲看雨声眠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3671,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪纱 湖上","author":"曹溶","text":"屐齿骄奢谢客儿，爱寻苏小看腰肢，不知谁作有情痴。\n倚醉自贪山一族，舞残刚剩柳千丝，今年总是忆人时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3672,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪纱  春怨","author":"曹溶","text":"莺粟花开又别家，蘑芜绿上小窗纱，粉墙西去即天涯。\n白雨偷将春令换，黄昏惯使客心邪，愁来那得好山遮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3673,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"一络索  行中僧将卖药赋此坚之","author":"曹溶","text":"焦团坐破添云甑，佛多长命。\n白堤游女十分娇，偏唤出、韩康姓。\n一派冷香诗径，淹留无定。\n直饶手挽上池来，怕未识、英雄病。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3674,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"霜天晓角  春怨","author":"曹溶","text":"亭阴弄碧，懒把金樽侧。\n莫怪泪痕常满，与东风、旧相识。\n芳信连朝隔，玉箫吹不得。\n最是恹恹心性，比垂杨、更无力。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3675,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"霜天晓角  同香山敬可夜坐倦圃","author":"曹溶","text":"月华千顷，画烛摇花冷。\n恰到五湖深处，平生事、付渔艇。\n鹤警铜壶静，做成今夜永。\n正是愁肠无限，几片叶、送秋影。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3676,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"巫山一段云  偶咏","author":"曹溶","text":"蝶戏湘裙带，花衔宝髻绒。\n深深妆阁乍相逢，眉黛为谁浓。\n婉步疑生月，娇歌不耐风。\n寄情摇曳玉光中，休更托春葱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3677,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮  茉莉","author":"曹溶","text":"家本桄榔江上住，江南恰是留侬处。\n金屋尚愁寒，春到莫借看。\n绿窗垂嫩雪，小院人难别。\n催送夜情来，珊瑚枕畔开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3678,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮  与侍儿","author":"曹溶","text":"眼前万事随流水，闺中也洒英雄泪。\n泪罢拊雕阑，玉情生暮寒。\n主人空放诞，屡见金釭烂。\n休恃酒如泉，解忧须少年。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3679,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"卜算子  伊璜再携歌姬过","author":"曹溶","text":"宫样晚妆鲜，一队湘兰弱。\n道是才人撮合成，妩媚终难学。\n箫管闹花场，舞袖摇金雀。\n漫信雏年不怨春，意思灯前觉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3680,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"卜算子  偶见","author":"曹溶","text":"孤簟隔花凉，双燕催人起。\n香径秋波瞥地生，绿皱眉峰底。\n咫尺对芙蓉，未许鸳鸯倚。\n若问从今闷若何，心在重门里。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3681,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"卜算子  题琴士隐庵画像","author":"曹溶","text":"客里适逢君，十指如冰玉。\n陶令无弦太寂寥，辜负樽中绿。\n画里又逢君，紫绮临修竹。\n何处青山解惜人，好奏归鸿曲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3682,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"采桑子  云塞秋夜","author":"曹溶","text":"隔墙弦索无心听，挑灭银灯。\n暗忆平生。\n白发萧萧酒易醒。\n月华风定芭蕉冷，楼上三更。\n不住鸡声。\n一枕江南梦未成。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3683,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"采桑子  怀香侯","author":"曹溶","text":"春曳歇马行山道，重见凉飙。\n雁字相挑。\n回首钱唐北上潮。\n颓阳漠漠黄沙苦，鬓影初凋。\n忆弄诗瓢。\n落尽灯花又一宵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3684,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"采桑子  查伊璜两度出家姬作剧","author":"曹溶","text":"解曳贪著吴宫锦，花族双靴。\n山画长蛾。\n待诉衷情隔绛河。\n新词填就勤分付，众里惊波。\n道字偏讹。\n惹得周郎顾转多。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3685,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"采桑子  姑苏顾氏席上小鬟","author":"曹溶","text":"踏歌未晓歌中意，豆蔻初含。\n豆蔻初含。\n飞到杨花便不堪。\n罗巾欲乞题红句，眉语相探。\n眉语相探。\n懊恼檀郎梦已酣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3686,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"采桑子  寄赤豹","author":"曹溶","text":"芭蕉几阵檐前雨，瘦尽多情。\n小小溪亭。\n一种离愁画不成。\n梅花断碣江天远，枯泪犹零。\n莫听瑶筝。\n恐有何戡旧日声。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3687,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"采桑子  巩都尉席上","author":"曹溶","text":"古藤花下银釭满，紫凤斜飞。\n贾涕沾衣。\n吹彻秦箫事已非。\n图书只似蓬蒿冷，碧甃双扉。\n宫漏霏微。\n说剑青灯客未稀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3688,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"减字木兰花  沈家歌姬","author":"曹溶","text":"编云作队，避人惯在深帘内。\n已许相看，却又移灯远翠盘。\n腰肢渐瘦，惜春不耐清明后。\n莫和秦筝，要听香喉第一声。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3689,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"减字木兰花  红叶","author":"曹溶","text":"霜酣千树，踏遍洞庭西去路。\n不会伤秋，只当花林烂漫游。\n山桥野岸，尚有垂杨青一半。\n落尽金风，看入谁家锦字中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3690,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"清平乐  冬夜","author":"曹溶","text":"月波秋泻，松冷穿窗罅。\n散步湖干渔笛下，的是含情者。\n夜来蟋蟀如年，浮花倦理觥船。\n吟遍满阶黄叶，奈他心在秋边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3691,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"清平乐  其一 题壁","author":"曹溶","text":"云屏十二，仙客曾同醉。\n草没建炎碑上字，岁月凭谁语。\n腊痕水出平堤，鵁鶄只检花栖。\n抖擞喉间秀句，雪斜犹倚楼西。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3692,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"清平乐  其二 题壁","author":"曹溶","text":"铜驼巷陌，较逊吴天碧。\n乳燕未来香寂寂，王粲成闲客。\n鬓丝新点春霜，佛楼冷尽行装。\n少许麴生风味，费他一夜回肠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3693,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"清平乐  其三 题壁","author":"曹溶","text":"偶来津馆，望里冰花满。\n月白梦回鸡不管，只觉铜壶缓。\n云芽细煮孤铛，蓬山隔了层城。\n任说铁肠难挽，泪痕还到银筝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3694,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"忆秦娥  坐黄鹤楼上","author":"曹溶","text":"江千尺，晚来风景秋萧瑟。\n斜阳槛外，数行金戟。\n杯干重把栏干拍，楚宫垂柳怜孤客。\n怜孤客，飞仙安在，唤他吹笛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3695,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"眼儿媚  旅情","author":"曹溶","text":"衣锦军中恨如麻，美酒近难赊。\n春衫湿透，唐家司马，不为琵琶。\n抱琴却到谁行宿，山影绿窗纱。\n夜长天倦，数声檐铁，瘦尽梅花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3696,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"摊破浣溪纱  忆广南胡家歌姬","author":"曹溶","text":"缓步藏春进酒来，好风微觉画裙开。\n料是君家常作使，莫嫌猜。\n送恨将心吹玉管，含羞当面整金钗。\n轻薄未应嫌杜牧，且徘徊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3697,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"青衫湿  田戚畹家姬东哥甲申后为教师遇之有感","author":"曹溶","text":"定场娘子霜栖鬓，先唱渭城花。\n重翻宫调，开元旧曲，知付谁家。\n此身似燕，春巢画栋，秋宿平沙。\n相如抽管，长门写怨，输与红牙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3698,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"青衫湿  广林饮李太虚寓中出家姬作剧","author":"曹溶","text":"红桥旧日深情地，一片玉箫吹。\n画蛾青敛，著人多处，不在歌时。\n教师催出，齐登绣毯，摆落游丝。\n曲终帘掩，堂前黄月，占断相思。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3699,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"青衫湿  记湖上弹琴之会","author":"曹溶","text":"流苏尽日垂珠箔，门外紫苔斑。\n唤茶鹦鹉，金笼前后，徐露青鬟。\n自怜纤指，大家风调，写尽幽閒。\n绣台深挂，拨残香兽，一片寒山。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3700,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西地锦  题虞山蒋文从雪泛卷","author":"曹溶","text":"一抹玉沙平野，且莫停杯斝。\n有时卧雪，有时歌雪，恣高人陶写。\n吹火打蓬堪画，在让玉山下。\n谁家曲水，谁家辋水，又相随来也。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3701,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"少年游  其一 寄项嵋雪","author":"曹溶","text":"客囊清减似穷秋，典尽酒家裘。\n桃花竞笑，鹿车还后，楚馆日悠悠。\n定研兰露裁新句，分付雪儿讴。\n最是今年，两番上巳，偏少晋人游。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3702,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"少年游  其二 寄项嵋雪","author":"曹溶","text":"禾兴溪上草连天，不见翠楼烟。\n黑头潘令，满襟离怨，赢得唾珠圆。\n送归野艇无多日，皓魄已初弦。\n春信将阑，可能相就，开榼海棠前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3703,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"少年游  游横山园悼李舒章","author":"曹溶","text":"云峰百尺引苍虬，著意写芳秋。\n斜晖窈窕，蟪蛄啼出，才子不能留。\n虾须如有神山隔，画栋只藏愁。\n旧日池塘，情波无尽，难荡木兰舟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3704,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"少年游  寿客","author":"曹溶","text":"楸枰敲罢拂花茵，相对玉嶙峋。\n龙劫修来，秦灰不染，拾得太平身。\n当歌难舍鸬鹚杓，日日要沾唇。\n重阳节后，淋漓烟月，未减芳春。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3705,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西江月  再过某宅闻歌","author":"曹溶","text":"莲影频催象拍，粉香难透虾须。\n人间恨事可消除，惟有聪明最苦。\n数对雏莺自语，一行弱柳谁扶。\n醉魂飘荡忆当初，又被横波约住。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3706,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南柯子  旅恨","author":"曹溶","text":"马度离人地，山衔去国程。\n孤身都似雪花轻。\n侥倖不知春色、过清明。\n小榭低金锁，重帘冷玉笙。\n那家沽酒甚多情。\n又被晚风催送、宿沙城。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3707,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南柯子  王家歌姬","author":"曹溶","text":"映尘兰心巧，穿窗柳线斜。\n斛珠买遍五陵花。\n记取十分春暖、在君家。\n画鼓刚挝了，瑶笙较嫩些。\n此宵易惹病根芽。\n怨杀天边银汉、一痕沙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3708,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"青门引  焚香","author":"曹溶","text":"乍入消魂径，旖旎相期不定。\n名园花气恼人多，困来无力，不敌金猊静。\n轻翻宿火寒犹凝，甲煎嫌他硬。\n今宵似有怜惜，隔帘送出春情性。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3709,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"醉花阴  席上","author":"曹溶","text":"绣幄笼寒穿小径，帘外微风定。\n劝酒碧笙娇，玉漏将残，如梦如春令。\n青衫江上凭谁赠，艳曲连宵听。\n久已割柔肠，翠影侵人，添却当年病。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3710,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"醉花阴  春怨","author":"曹溶","text":"嫩柳亭前黄几许，雪密莺无语。\n指冷入瑶弦，画烛微昏，只觉情如缕。\n人生最时离时苦，问故园归路。\n不惜马蹄忙，香草连天，拟逐东风去。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3711,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"醉花阴  云暑五月初见芍药","author":"曹溶","text":"簟捲清湘寒影皱，香逼蜂须透。\n花信忆金盘，密约虽迟，倾国还依旧。\n玉栏风露端阳后，尘土淹衫袖。\n几日费清醪，强欲留春，又怕因春瘦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3712,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"醉花阴  同辰六红桥泛舟","author":"曹溶","text":"庚信才多无著处，堤上微云度。\n莫看紫桃花，相趁游蜂，画屧声中去。\n三台催盏牙樯暮，到玉钩残路。\n须念有情难，苦论兴亡，直是书生误。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3713,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浪淘沙  閒情","author":"曹溶","text":"青鸟信沉沉，泪滴罗襟。\n落红无力上瑶簪。\n最是横塘风乍紧，吹散柔心。\n玉盏惜空斟，冷落从今。\n梦回人倚画床阴。\n借问谁家香阁里，占得春深。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3714,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浪淘沙  询孔子威坠马","author":"曹溶","text":"野岸石桥滨，雪色初匀。\n扬鞭一试紫骝新。\n记取黄沙沉戟地，不是花茵。\n持酒酹芳辰，年少腰身。\n罗衣低拂五陵尘。\n回首微闻相痛惜，楼上佳人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3715,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浪淘沙  题吴园次收绘小像","author":"曹溶","text":"痴绝此渔翁，不钓三公。\n吴南越北柳阴浓。\n万事且须看脚下，海阔山空。\n百怪舞蛟龙，雨雨风风。\n热肠敛手是英雄。\n欲展丝纶还有待，人在图中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3716,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浪淘沙  夜思同芝麓作","author":"曹溶","text":"清月唤愁心，酒罢空吟。\n隔墙斜堕海棠阴。\n故国千门难锁梦，归路沉沉。\n莺啭旧时音，芳树成林。\n自从离后损瑶琴。\n欲寄青山添黛色，莫待春深。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3717,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]