[{"title":"答陆冰修 其二","author":"屈大均","text":"尔爱沉香浦，苍茫多夕晖。\n蚌含明月出，鹏负碧天飞。\n欲访难移棹，临分重揽衣。\n白沙栖隐处，吾自玩芳菲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9321,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"答钟广汉","author":"屈大均","text":"梁鸾颂高士，最爱采芝翁。\n一出安鸿鹄，还栖林屋东。\n子孙洞庭口，耕作上皇风。\n我亦能遗世，年年桂树丛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9322,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送王汾仲还新安因访石埭姚明府 其一","author":"屈大均","text":"白云归白岳，道过陵阳峰。\n为我期仙令，何时驾白龙。\n愁随一片月，挂在九华松。\n早晚思携手，冶城春酒浓。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9323,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送王汾仲还新安因访石埭姚明府 其二","author":"屈大均","text":"相思似春水，一路送渔舟。\n自此临流别，湖名非莫愁。\n庭闱君自恋，京雒我空游。\n珍重南陔去，崇兰正可求。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9324,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题龚柴丈园 其一","author":"屈大均","text":"频年远游去，鸾鹤恨无群。\n采药难供母，逢山便忆君。\n平生无素业，万里一浮云。\n爱尔丘园好，徘徊至夕曛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9325,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题龚柴丈园 其二","author":"屈大均","text":"清凉山翠滴，花药绕閒居。\n半亩松杉外，一春雨雪馀。\n人传高士颂，地接远公卢。\n迟我为沮溺，相将此荷锄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9326,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"白纻曲","author":"屈大均","text":"翠幌开春夜，琼楼敞碧天。\n美人似明月，飞过彩霞边。\n举袖当花客，扬歌应凤弦。\n芳心君不见，徒为拾珠钿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9327,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"望天都峰","author":"屈大均","text":"缥缈丹台上，轩辕拥二仙。\n玉壶甘露泻，珠盖彩霞悬。\n日月生黄海，笙歌满碧天。\n龙髯攀莫及，怅望泪潸然。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9328,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"五人墓作","author":"屈大均","text":"吴风多好剑，轻死自当时。\n以有要离子，长为烈士师。\n恩仇无不报，市井亦何知。\n慷慨五人者，英名复在兹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9329,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"胥口逢梅里诸子","author":"屈大均","text":"一出太湖口，芙蓉万叠斜。\n飞来天外翠，散作镜中霞。\n之子梅溪至，相逢渔父家。\n包山有禅客，招手人寒花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9330,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题翁子东洞庭山馆","author":"屈大均","text":"东西两洞庭，吾爱莫釐青。\n往日鸱夷子，回舟此翠屏。\n君今胥母住，门对太湖扃。\n旦夕怀仙意，长歌入杳冥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9331,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从洞庭还柬瞿止","author":"屈大均","text":"芙蓉青翠里，昨谒洞庭君。\n玉柱开天阙，龙威导白云。\n灵书人外读，仙乐夜深闻。\n明共扁舟去，还寻鸾鹤群。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9332,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"姑苏秋夕与余丈广霞坐京兆杜子寓楼","author":"屈大均","text":"嗟尔姑苏客，萧然含暮愁。\n相思二华月，独立五湖秋。\n吴俗轻高节，秦风急好仇。\n今宵共樽酒，感激典貂裘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9333,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春湖曲","author":"屈大均","text":"士女春游早，梅花折满船。\n飞来玄墓雪，香散太湖天。\n渔父歌明月，夷光出紫烟。\n鸳鸯谁似汝，长在浣纱边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9334,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"消夏湾","author":"屈大均","text":"吴王消夏处，玉沼太湖通。\n万古芙蓉发，西施在镜中。\n白云迷故国，春草失离宫。\n一对鸳鸯鸟，时来戏碧空。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9335,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"木渎","author":"屈大均","text":"漭漭五湖口，荷花远接天。\n巴陵通地道，林屋隐人烟。\n楼阁波涛里，帆樯空翠边。\n名峰七十二，争向镜中妍。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9336,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"范蠡宅作","author":"屈大均","text":"羡尔浮西子，扁舟湖海间。\n芙蓉三万树，种满洞庭山。\n石上留香屧，烟中有翠鬟。\n狂吟水仙曲，惊起一双鹇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9337,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"正气祠作","author":"屈大均","text":"元老忠贞竭，中朝历数屯。\n十年荒社稷，一夜尽君臣。\n野月寒难曙，江花惨不春。\n精魂应杀贼，莫但作星辰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9338,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"钱塘观潮 其一","author":"屈大均","text":"子胥乘白马，天上涌潮来。\n雷破江门出，风吹地轴回。\n孤舟凌喷薄，长笛引凄哀。\n欲作枚乘赋，先挥张翰杯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9339,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"钱塘观潮 其二","author":"屈大均","text":"千里江潮势，奔腾禹穴前。\n蛟龙争水国，雷雨战空天。\n长剑中流拔，孤帆落日悬。\n谁言天堑险，飞渡有苻坚。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9340,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"韬光寺楼晓望","author":"屈大均","text":"朝来凭阁望，峰顶大江浮。\n日出天鸡口，潮飞澥蜃楼。\n苍苍会稽树，渺渺富春洲。\n不见同怀子，相思万壑秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9341,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"子陵祠下夜坐","author":"屈大均","text":"万里秋云尽，天空只客星。\n光含明月冷，影人绛河冥。\n双瀑为长带，千峰是翠屏。\n临风一舒啸，冉冉下仙灵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9342,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题许剑亭","author":"屈大均","text":"一剑君谁许，燕中就义人。\n剖心悬日月，披发上星辰。\n故国浮云暝，荒亭古木春。\n嗟予犹隐忍，何以报三仁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9343,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄桐岑子","author":"屈大均","text":"雨雪悲年暮，山川爱浙东。\n平生一明月，飞入镜湖中。\n白拂悬天柱，青琴响碧空。\n期君扬帆至，相接有樵风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9344,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"禹庙","author":"屈大均","text":"龙蛇盘禹穴，窈窕万峰连。\n玉简藏何处，梅梁失几年。\n双圭开日月，九鼎奠山川。\n终古思明德，讴歌俎豆前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9345,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄王丈予安","author":"屈大均","text":"闻君在天目，服食黄精花。\n玉乳吸阳窦，花龛开暮霞。\n我怜若耶水，新作钓鱼槎。\n日日芙蓉里，看人出浣纱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9346,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"登香炉峰","author":"屈大均","text":"香炉峰万仞，吾度鹊桥来。\n明月随霜簟，天河接玉杯。\n花间禹穴出，霞外赤城开。\n长啸凌沧海，仙人安在哉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9347,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"经铸浦","author":"屈大均","text":"当年欧冶子，此地铸龙泉。\n一雪君王耻，雌雄飞入渊。\n云消天镜出，风起石帆悬。\n谁见登临客，高歌忆古贤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9348,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"耶溪夜游","author":"屈大均","text":"杨柳覆长堤，芙蓉开欲齐。\n美人化明月，飞出浣纱溪。\n吹笛鸳鸯起，回舟珠斗低。\n白云遥送客，直至镜湖西。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9349,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"别王于一往雁宕","author":"屈大均","text":"拂衣西雁荡，濯足大龙湫。\n岂敢为高尚，孤云无所求。\n芙蓉开太白，瀑布挂飞楼。\n君有怀仙曲，因风寄十洲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9350,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"忆天台有寄","author":"屈大均","text":"石梁横碧天，上有百重泉。\n昨梦随明月，同君蹑紫烟。\n闻箫桐柏下，拂剑斗牛边。\n孤鹤飞何处，回看阻霅川。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9351,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"戏赠朱十","author":"屈大均","text":"君爱耶溪好，扁舟去不归。\n荷花天上落，明月镜中飞。\n浣女歌新曲，鸳鸯起钓矶。\n鸳鸯不可得，弄水湿罗衣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9352,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉题方尔止戊申年正月初四日恭谒孝陵感怀诗后","author":"屈大均","text":"亦有春秋在，书王未敢传。\n可怜正月泪，重洒戊申年。\n白发陪宫使，青山拂御筵。\n威灵空想像，拜手玉衣前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9353,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题朱朗诣遗集 其一","author":"屈大均","text":"匹夫能慕义，咫尺亦贤豪。\n天地存沟壑，风尘惜羽毛。\n家临梅福市，门对伍胥涛。\n哀怨平生曲，行将续楚骚。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9354,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题朱朗诣遗集 其二","author":"屈大均","text":"千金破家产，四世受朝恩。\n草野羞亡命，沙场誓丧元。\n悲歌留乐府，歧路失王孙。\n阴雨空山夕，期君入梦魂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9355,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"顾云美六十 其一","author":"屈大均","text":"寂寞松风寝，先皇御翰留。\n心飞天寿月，泪尽海棠秋。\n故国谁高卧，斯人更远游。\n乱离过六十，知己在沧洲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9356,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"顾云美六十 其二","author":"屈大均","text":"汝婿忠臣子，初生端水时。\n两宫犀带赐，三岁羽林儿。\n丧乱孤谁托，艰贞尔独知。\n遗民今日少，珍重鬓如丝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9357,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"中宿峡","author":"屈大均","text":"天上猿千树，声含秋雨哀。\n二禺峰窈窕，三峡水潆洄。\n帝子吹箫去，仙人采竹来。\n夕阳烟翠满，愁见望夫台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9358,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从大小鸬鹚诸滩上郴州题莲子精舍","author":"屈大均","text":"山水频开阖，仙源不可寻。\n水帘飞四壁，花雨散双林。\n猿鸟声相乱，蛟龙气自深。\n扁舟今已矣，渔父最知音。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9359,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赣州 其一","author":"屈大均","text":"日落虎头城，风飘龙角声。\n天威馀细柳，地利失阴平。\n盗贼纷何在，英雄凛若生。\n襄皇能养士，沟壑荷恩深。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9360,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赣州 其二","author":"屈大均","text":"义士魂何去，沙场一放招。\n黄衣归朔漠，碧血满南朝。\n山枕孤城峻，江通百粤遥。\n天生形胜地，空助虎狼骄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9361,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"风门山","author":"屈大均","text":"壁立青天上，千峰接祝融。\n风门人不度，石栈马才通。\n射虎随蛮俗，椎牛会小戎。\n平生军旅事，辛苦桂阳东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9362,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"八尺洪","author":"屈大均","text":"春来滩水急，喷壑万松间。\n风雨时驱石，雷霆忽破山。\n柳深黄鸟乱，花落白猿閒。\n渐至苏耽岭，寻仙拟不还。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9363,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"耒阳观诸葛武侯碑","author":"屈大均","text":"武侯擒孟获，刻石耒阳川。\n威震华夷日，心劳将相年。\n三分留正统，二表格皇天。\n终古英雄客，看碑泪泫然。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9364,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"郴江口","author":"屈大均","text":"惊涛出江口，一片雪山飞。\n舟与雷霆斗，人为鱼鳖归。\n偷生惭有剑，卒岁叹无衣。\n历尽人间险，吾今解息机。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9365,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南岳 其一","author":"屈大均","text":"峰绕祝融尊，湖湘映岳门。\n香炉云梦气，瀑布洞庭源。\n雨霁分秋色，林开见晓暾。\n青苍一千里，望似阵云屯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9366,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南岳 其二","author":"屈大均","text":"伊昔洪荒世，衡山佐禹功。\n巨灵分一掌，明德继重瞳。\n岣嵝悬神碣，莲花落古宫。\n千秋金简气，龙虎郁无穷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9367,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南岳 其三","author":"屈大均","text":"烈气流珠海，真形隐玉壶。\n云霞相变化，日月自虚无。\n紫盖削千仞，朱天开一隅。\n飘飘鸾鹤上，高揖列仙儒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9368,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南岳 其四","author":"屈大均","text":"山随湘水长，转转向清湘。\n九面芙蓉翠，中天紫盖张。\n峰峰朝赤帝，树树带衡阳。\n万古香炉气，氤氲桂邸旁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9369,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"岳庙 其一","author":"屈大均","text":"肃肃朱陵庙，怀柔忆我皇。\n乾坤归火德，日月起南方。\n秩礼遵虞典，斋心启夏王。\n千秋巡狩迹，想像辟鸿荒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9370,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"岳庙 其二","author":"屈大均","text":"先皇钟鼓在，肃穆百神朝。\n凤管流清殿，霓旌捲碧霄。\n坤舆虽北陷，天柱尚南标。\n维岳司休命，无疆钖帝尧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9371,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"贾太傅故宅","author":"屈大均","text":"长沙南纪外，迁客九疑边。\n皇帝虚前席，书生实少年。\n岳云高冠日，湘水远连天。\n故宅馀春车，行人重怆然。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9372,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题招屈亭","author":"屈大均","text":"楚人端午日，招屈向湘沅。\n河伯空交手，巫阳不予魂。\n蛟龙侵水屋，风雨蔽天门。\n掩泣纷歌舞，思君不可谖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9373,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"夜憩江楼","author":"屈大均","text":"八月潇湘客，三更乌鹊楼。\n天随珠斗转，雪抱玉盘流。\n远望惟京阙，相思若女牛。\n同心栀子苦，欲寄隔炎洲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9374,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浮湘 其一","author":"屈大均","text":"五年游五岳，三度下三湘。\n今夕衡阳宿，依然风露凉。\n钟愁回雁落，歌爱采菱长。\n木叶萧萧下，如何客异乡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9375,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浮湘 其二","author":"屈大均","text":"湘水清且浅，粼粼白石分。\n青浮南岳影，红摺暮天纹。\n九面芙蓉绕，中流兰杜薰。\n溪边渔父好，竟夕棹歌闻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9376,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浮湘 其三","author":"屈大均","text":"不断湘江岸，青青兰竹丛。\n泪痕光晓露，哀响乱秋风。\n岳与千帆转，天归一镜空。\n明朝洞庭上，萧瑟对丹枫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9377,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浮湘 其四","author":"屈大均","text":"水凉朝有气，日出渐成烟。\n林寂鸟多语，山深人亦田。\n岳痕青出岸，波影绿摇天。\n清绝湖南地，浮湘自可怜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9378,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浮湘 其五","author":"屈大均","text":"帆投渔火宿，浦口暮烟迷。\n催客虫声乱，依人鸟影齐。\n林穿黄月细，花压碧天低。\n疏磬知何处，茅茨隔一溪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9379,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浮湘 其六","author":"屈大均","text":"岳云青不断，湘水与之长。\n湘至湘阴尽，沿洄殊未央。\n鹧鸪催客起，斑竹拂船凉。\n山髻时明灭，林烟一带苍。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9380,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浮湘 其七","author":"屈大均","text":"两日随兰桨，青青紫盖峰。\n五峰江倒映，水底尽芙蓉。\n苍翠楚天好，微茫湖口重。\n洲边采香草，湘女暮相从。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9381,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浮湘 其八","author":"屈大均","text":"水口皆湘浦，花阴有岳门。\n帆低红树罥，舟小白波吞。\n戍鼓传双峡，渔灯绕一村。\n溪清多漏石，月照更潺湲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9382,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浮湘 其九","author":"屈大均","text":"青恐峰峦尽，红愁木叶多。\n鱼梁争截水，浣女乱穿荷。\n雨气含黄日，霞光激素波。\n虚无瑶瑟响，怅望是湘娥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9383,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浮湘 其十","author":"屈大均","text":"江至长沙阔，湖将岳麓浮。\n茫茫迷五渚，隐隐见双洲。\n才子伤卑湿，骚人怨早秋。\n熊湘高阁在，欲上写离忧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9384,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浮湘 其十一","author":"屈大均","text":"戍亭纤月上，吹角断行舟。\n葭菼风多夕，潇湘水易秋。\n天开洞庭口，波捲岳阳楼。\n帝子此离别，微茫一片愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9385,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浮湘 其十二","author":"屈大均","text":"高高天岳出，雨后白云多。\n望与衡山似，愁如秋色何。\n人家连碧树，禹迹在寒萝。\n忆访莓苔字，年时鼓棹过。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9386,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浮湘 其十三","author":"屈大均","text":"水清鱼不少，一路有罾塘。\n山映涟漪绿，日含烟雨黄。\n人为今屈子，地是古中湘。\n兰芷亦青草，如何独有芳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9387,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]