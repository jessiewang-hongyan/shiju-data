[{"title":"自胥江上峡至韶阳作 其九","author":"屈大均","text":"屏风知几叠，云锦夹天开。\n树树倒垂壁，峰峰阴积苔。\n野花多有子，山雉绝无媒。\n系艓幽潭口，言探石髓回。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11305,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其十","author":"屈大均","text":"篙篙答幽响，霞壁尽中空。\n自发多钟磬，相吞是水风。\n石泉如乳白，云叶比花红。\n处处层城似，丹楼望不穷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11306,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其十一","author":"屈大均","text":"滟滪堆无数，春行值水深。\n帆惊飞石过，窗苦湿云侵。\n萤外依渔火，鸯边梦锦衾。\n戍夫催泊早，乌鹊未归林。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11307,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其十二","author":"屈大均","text":"石角篙无力，湾环似二禺。\n划天多铁壁，拔地即香炉。\n花堕千寻药，藤交百道须。\n时时岩洞里，飞出片帆孤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11308,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其十三","author":"屈大均","text":"仙灵多事甚，古寺使飞来。\n草没萧梁碣，花迷庶子台。\n峡长峰易合，岚重日难开。\n阮隃吹频裂，声含秋雨哀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11309,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其十四","author":"屈大均","text":"轩辕上天日，帝子亦成仙。\n吹笛知何去，遗音空暮烟。\n君臣双绝峡，兄弟两飞泉。\n终古馀汤沐，禺阳苍翠边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11310,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其十五","author":"屈大均","text":"峰晴多变态，一半作空青。\n何处朝云影，而非神女灵。\n髻和烟雾堕，衣杂蕙兰馨。\n一路疑行雨，泉飞遍杳冥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11311,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其十六","author":"屈大均","text":"野花名渐识，春摘未曾迟。\n日夕但盈手，芬馨能几时。\n芝薇秦有客，橘柚楚多师。\n岂必筼筜好，青青帝子枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11312,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其十七","author":"屈大均","text":"女萝缠玉手，攀磴与云平。\n拾果知猿戏，穿松恐鹤惊。\n水分双练下，风作一琴鸣。\n坐久忘舟楫，依依到月明。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11313,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其十八","author":"屈大均","text":"亦知行路苦，争奈水云心。\n白鹄未三里，寒猿已一吟。\n江南枫树满，峡北荻花深。\n青草无穷瘴，王孙何处寻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11314,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其十九","author":"屈大均","text":"山花名独舞，山鸟号相思。\n更有香含笑，兼之绿画眉。\n边鸾殊未见，嵇氏讵曾知。\n好把图经补，丹青写莫迟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11315,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其二十","author":"屈大均","text":"南天已初夏，水宿易生寒。\n夜夜云三峡，朝朝雪一滩。\n羊皮渔父服，蝶翅羽流冠。\n莫向桃枝笑，今非钓国竿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11316,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其二十一","author":"屈大均","text":"惠妃能苦战，巾帼有功勋。\n庙貌香炉峡，风流锦伞军。\n神鸦喧饮食，仙蝶乱衣裙。\n签语期相助，扬灵向阵云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11317,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其二十二","author":"屈大均","text":"壁垒馀麻寨，浛洸战迹多。\n灵旗长肃肃，古庙每峨峨。\n破贼当高峡，追雠到浊河。\n丰碑从宋代，终古镇风波。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11318,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其二十三","author":"屈大均","text":"碧落英州洞，茎通直到天。\n御林南汉在，丹灶羽人传。\n水滴成钟乳，霞凝作宝莲。\n玲珑巨灵手，斧凿出天然。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11319,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其二十四","author":"屈大均","text":"岭表全韶地，天南古帝家。\n文明开百越，浚哲自重华。\n玉殿馀春草，皇冈隐暮霞。\n郁葱衡岳接，御气尚含葩。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11320,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其二十五","author":"屈大均","text":"帝城云里出，天阙石边开。\n已就重华得，如游瑶圃来。\n联绵九疑接，相像六飞回。\n一片苍梧恨，长含武水台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11321,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其二十六","author":"屈大均","text":"六六玉芙蓉，鸣琴知几峰。\n如何百蛮狩，不遣二妃从。\n绝徼馀城阙，荒祠尚鼓钟。\n月明瑶瑟至，应渡水云重。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11322,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其二十七","author":"屈大均","text":"九成台缥缈，知是有虞宫。\n二女明霞外，重瞳丽日中。\n珠丘梧野北，玉辇曲江东。\n彷佛箫韶在，音含阊阖风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11323,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其二十八","author":"屈大均","text":"野艇鱼秧至，人家蜡树来。\n郡当三峡尽，城夹二江开。\n柱矗天多石，衣垂帝有台。\n陈辞无不可，咫尺即蓬莱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11324,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其二十九","author":"屈大均","text":"峤外元仙窟，泷东即帝乡。\n为怜韶石好，不觉武溪长。\n就日怀龙驭，歌风想凤跄。\n如何骚些客，怅望祗潇湘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11325,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其三十","author":"屈大均","text":"绕城三面水，浈武合南流。\n虎战空多垒，狐鸣总一丘。\n攻坚元下策，间道本阴谋。\n多谢青燐影，长含汉月秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11326,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其三十一","author":"屈大均","text":"开元高相业，崛起曲江间。\n报国多金鉴，倾城一玉环。\n文章元帅在，风度盛唐閒。\n正始音谁继，书台洒扫还。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11327,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其三十二","author":"屈大均","text":"心逐流泉去，潺湲一夜无。\n不因寒月好，争觉玉琴孤。\n稍起沙边雁，时惊枝上乌。\n故林相忆否，人在一菰芦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11328,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"郑方二君以生鹧鸪数双见贻赋诗答之 其一","author":"屈大均","text":"梅关殊未度，奈尔唤归何。\n锦翼因媒得，雌雄占岭多。\n故人劳见赠，南客辱相过。\n未肯开笼放，钩辀要听歌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11329,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"郑方二君以生鹧鸪数双见贻赋诗答之 其二","author":"屈大均","text":"岂不畏霜露，笯中且勿惊。\n向南徒有意，留客枉多情。\n买恨金钱少，餐愁匕箸轻。\n不教怜复损，为尽对啼声。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11330,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"郑方二君以生鹧鸪数双见贻赋诗答之 其三","author":"屈大均","text":"夜飞将木叶，相蔽露华间。\n格磔知何处，卑栖各一山。\n性真同我野，声苦学人蛮。\n归笑小儿女，衣裳似尔斑。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11331,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"郑方二君以生鹧鸪数双见贻赋诗答之 其四","author":"屈大均","text":"不少黄茆岭，争山斗一春。\n为怜苦行路，终日唤征人。\n挈汝闺帏返，应知饮啄驯。\n白鹇相伴处，林岫在城闉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11332,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"郑方二君以生鹧鸪数双见贻赋诗答之 其五","author":"屈大均","text":"南枝稀越鸟，馀尔鹧鸪群。\n暖就罗浮日，阳随涨海云。\n影从荒草合，声向乱峰分。\n珍重雕笼里，山鸡却羡君。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11333,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"郑方二君以生鹧鸪数双见贻赋诗答之 其六","author":"屈大均","text":"归为堂上馔，未忍佐膏芗。\n有幸烹雌妇，无忧啄粟场。\n华轩供爱玩，故岭绝回翔。\n翅戒儿童剪，从他锦绣张。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11334,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"郑方二君以生鹧鸪数双见贻赋诗答之 其七","author":"屈大均","text":"鹧鸪亦有草，蝴蝶讵无花。\n羽翼持相比，芬芳总一家。\n绝怜南翥好，差胜北枝斜。\n为尔将归早，飘零免塞沙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11335,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"郑方二君以生鹧鸪数双见贻赋诗答之 其八","author":"屈大均","text":"归使青娥见，知频唱鹧鸪。\n斑衣徭女似，香瘴越台无。\n食岂争鸡口，栖宁嫁雁夫。\n北禽欺汝者，逐我莫愁孤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11336,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠某驾部生日","author":"屈大均","text":"星使来扬越，翩翩汉节旄。\n寿樽蒲屑细，词笔藕花高。\n粟有东方朔，金无北郭骚。\n氤氲香荔子，持慰大夫劳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11337,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过尹尔复园亭赠之","author":"屈大均","text":"古木高曾树，阴凉满一园。\n鹤巢多白鹭，蝉咽似清猿。\n好学人难老，栖閒道易尊。\n芬馨春气内，细草亦兰荪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11338,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"复上韶阳述怀呈使君 其一","author":"屈大均","text":"无端又千里，秋更上韶阳。\n为有丹霞好，那知白露凉。\n使君惟孝友，孺子岂文章。\n分得莱芜釜，微尘已绝香。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11339,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"复上韶阳述怀呈使君 其二","author":"屈大均","text":"尚乎游未得，儿女事茫茫。\n白首劳婚嫁，丹丘阙稻粱。\n殷勤干太守，不敢卧羲皇。\n好是言辞拙，相知迹久忘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11340,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"复上韶阳述怀呈使君 其三","author":"屈大均","text":"一路迎鸿雁，行将及庾关。\n那能似潮汐，祗到二禺间。\n母待韩康出，儿催孺仲还。\n艰难因水菽，未忍老栖閒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11341,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"复上韶阳述怀呈使君 其四","author":"屈大均","text":"不出非慈孝，晨昏且暂违。\n负多千里米，餐少一人薇。\n知己惟廉吏，无颜是褐衣。\n晏婴鞭可执，忻慕似君稀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11342,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"复上韶阳述怀呈使君 其五","author":"屈大均","text":"楼中容易捉，不是酒仙人。\n迹向台门托，情将露冕亲。\n能令高士贱，祗为使君贫。\n一勺浈江水，鱼枯未湿鳞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11343,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"复上韶阳述怀呈使君 其六","author":"屈大均","text":"海内无长句，山东有谪仙。\n吾师惟乐府，汝爱似青莲。\n狂客四明在，神君一代贤。\n金龟重使醉，水底酒星眠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11344,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"惠阳娱江亭作","author":"屈大均","text":"惠阳为客久，酒尽最愁时。\n已有凉蝉咽，还馀落叶悲。\n江吞湖水浅，舟出浦沙迟。\n风好无帆席，飞飞羡鹭鹚。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11345,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠罗颢甫五十又一生日 其一","author":"屈大均","text":"我友交相敬，殷勤五十前。\n方过知命日，未尽慕亲年。\n大小经都授，春秋义更笺。\n石渠诸博士，家学首韦贤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11346,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠罗颢甫五十又一生日 其二","author":"屈大均","text":"五十初游学，荀卿汝勿忧。\n老师三祭酒，弟子一浮丘。\n小序持风雅，微言接倡酬。\n汉儒师友好，将子溯源流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11347,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠罗颢甫五十又一生日 其三","author":"屈大均","text":"寡过惭蘧瑗，行年五十馀。\n精微惟学易，老大欲抛书。\n健未家庭杖，贫应市井居。\n无成吾著述，祗恨费居诸。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11348,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠罗颢甫五十又一生日 其四","author":"屈大均","text":"白头同有母，奉养愧罗威。\n谋食身难隐，居贫志易违。\n和柔春草似，皎洁白华非。\n爱日心无极，朝阳露莫晞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11349,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"慰蒲衣 其一","author":"屈大均","text":"德耀先朝露，深君悼俪情。\n虽无裘褐在，讵忍水云轻。\n老病因儿女，艰难托舅甥。\n不须悲物化，曾共学无生。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11350,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"慰蒲衣 其二","author":"屈大均","text":"子荆头易白，况值悼亡时。\n早已伤哀乐，那堪更别离。\n月沉飞鹊镜，花落合欢枝。\n已矣谁偕隐，茫茫负戴期。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11351,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"慰蒲衣 其三","author":"屈大均","text":"幸当婚嫁毕，陶写好忘情。\n丝竹须安石，云山且向平。\n孟光多逸事，徐淑更才名。\n彤管人皆艳，芬芳似女贞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11352,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"慰蒲衣 其四","author":"屈大均","text":"落叶夫人泪，哀蝉武帝悲。\n仙灵遗蜕早，骚些放招迟。\n昔我离鸾恨，殊多别鹄辞。\n君今伤燕婉，伺以慰哀思。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11353,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送王生还绍兴 其一","author":"屈大均","text":"苍苍天上月，化作镜湖来。\n一片红蕖水，平生碧玉杯。\n昔移兰枻去，每拂若溪回。\n梅市幽栖处，凭君扫紫苔。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11354,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送王生还绍兴 其二","author":"屈大均","text":"勾越多知己，风流属寓山。\n黄泉都饮恨，白发几栖閒。\n有节羝终乳，无家鹤不还。\n为将存殁意，传与泪潺湲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11355,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"为翁君寿母夫人","author":"屈大均","text":"共有百龄母，孙嵩世所稀。\n今朝眉寿酒，先献汝慈帏。\n戴胜西王喜，餐花方朔肥。\n堂前回舞袖，两处媚春晖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11356,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自公房作","author":"屈大均","text":"玉屏峰未还，花下一扃关。\n即此已空寂，无人知是山。\n磐流松户外，棋落石床间。\n却厌涓涓水，无生说未閒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11357,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠刘显之生日","author":"屈大均","text":"同庚俱白首，文学汝翩翩。\n师是兰陵老，人惟祭酒贤。\n菊含长至艳，梅吐小春妍。\n共是岁寒物，冰霜得大年。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11358,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"慰林仲子丧明 其一","author":"屈大均","text":"明在何曾丧，行教日再中。\n复唐须独眼，兴楚岂重瞳。\n甘菊曾延寿，黄精且养蒙。\n閒来成国语，暂与左丘同。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11359,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"慰林仲子丧明 其二","author":"屈大均","text":"不觉成衰谢，蹉跎变乱时。\n先臣悬目早，国士漆身迟。\n竹少孤生节，桐多半死枝。\n易中高用晦，为子说明夷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11360,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"慰献孟 其一","author":"屈大均","text":"四十已敦杖，未应衰谢时。\n病因枚叟却，忧为步兵持。\n薏苡餐须早，莃莶饮莫迟。\n先公廉洁甚，贫与负薪期。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11361,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"慰献孟 其二","author":"屈大均","text":"鸡骨朝来健，王戎免在床。\n颠虽长孺秃，足未子春伤。\n汉腊难忘旧，韩仇欲报长。\n参苓加减好，咫尺有韩康。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11362,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"怀吴客","author":"屈大均","text":"勇绝吴阊客，纵横击剑时。\n多仇惟伍子，无力是要离。\n患难终能免，飘零更不辞。\n从谁乞浆饮，渔父莫令知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11363,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"朱太史竹姹至五羊苦不得见诗以寄之","author":"屈大均","text":"辇毂分襟后，相思廿四霜。\n如何来咫尺，亦复作参商。\n著作知无数，声华总未央。\n可能从幕府，暂到海珠旁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11364,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠从化郭邑侯 其一","author":"屈大均","text":"圭璧鄘君子，干旄卫大夫。\n武公知汝是，姝子得人无。\n邑枕花溪上，城开石鼓隅。\n笺经为政暇，镇日对双梧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11365,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠从化郭邑侯 其二","author":"屈大均","text":"鲁史君家学，孳孳笔削心。\n专门三传早，吏治一经深。\n政简宜山县，书成亦竹林。\n汉儒推董氏，黾勉嗣高音。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11366,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"癸酉人日作","author":"屈大均","text":"无心作人日，只为个人无。\n光采存魂梦，丹青失画图。\n酒沾黄土尽，花供素瓶孤。\n廿四年来恨，空悲子母乌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11367,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠蔬隐丈兼为其七十又一寿","author":"屈大均","text":"桔槔无不可，久息丈人机。\n窥菜应多暇，持蔬亦自肥。\n酒香难白发，花老尚红衣。\n百岁寻常事，看君两古稀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11368,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"除夕咏感揽和王使君八首 其一","author":"屈大均","text":"苞品诸珍淑，南威未易求。\n红盐惊一夕，青子落三秋。\n臭味兰心合，芬馨玉齿流。\n使君频果好，共遣岁华愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11369,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]