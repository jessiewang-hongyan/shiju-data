[{"title":"琴河感旧 其一","author":"吴伟业","text":"白门杨柳好藏鸦，谁道扁舟荡桨斜。\n金屋云深吾谷树，玉杯春暖尚湖花。\n见来学避低团扇，近处疑嗔响钿车。\n却悔石城吹笛夜，青骢容易别卢家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"琴河感旧 其二","author":"吴伟业","text":"油壁迎来是旧游，尊前不出背花愁。\n缘知薄幸逢应恨，恰便多情唤却羞。\n故向闲人偷玉箸，浪传好语到银钩。\n五陵年少催归去，隔断红墙十二楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"琴河感旧 其三","author":"吴伟业","text":"休将消息恨层城，犹有罗敷未嫁情。\n车过卷帘徒怅望，梦来褍袖费逢迎。\n青山憔悴卿怜我，红粉飘零我忆卿。\n记得横塘秋夜好，玉钗恩重是前生。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"琴河感旧 其四","author":"吴伟业","text":"长向东风问画兰，玉人微叹倚栏杆。\n乍抛锦瑟描难就，小叠琼笺墨未干。\n弱叶懒舒添午倦，嫩芽娇染怯春寒。\n书成粉箑凭谁寄，多恐萧郎不忍看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"《西湖杂感》二十首 其二","author":"钱谦益","text":"潋艳西湖水一方，吴根越角两茫茫。\n孤山鹤去花如雪，葛岭鹃啼月似霜。\n油壁轻车来北里，梨园小部奏西厢。\n而今纵会空王法，知是前尘也断肠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"十六字令 别意","author":"徐石麒","text":"将进酒，长歌驻短亭。\n闲停拍，双泪落新声。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梦游仙 湖干新咏十首 其一","author":"徐石麒","text":"湖居好，地僻可逃名。\n岸上桃花迷钓叟，门前柳树隐先生。\n相识亦何曾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":7,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梦游仙 湖干新咏十首 其二","author":"徐石麒","text":"湖居好，闭户少人知。\n杜甫工诗吟恋苦，杨雄作赋字贪奇。\n乐此不知疲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梦游仙 湖干新咏十首 其三","author":"徐石麒","text":"湖居好，学圃不为迂。\n一笠自承窗外雨，几锄亲垦屋边芜。\n清供有园蔬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梦游仙 湖干新咏十首 其四","author":"徐石麒","text":"湖居好，鸟语亦清奇。\n喜报客来鸲鹆唤，苦留人住鹧鸪啼。\n憨态颇相宜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梦游仙 湖干新咏十首 其五","author":"徐石麒","text":"湖居好，种秫有陂田。\n五斗不烦腰更折，一车何用口频涎。\n常此醉中天。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梦游仙 湖干新咏十首 其六","author":"徐石麒","text":"湖居好，满目是春妍。\n蝴蝶拍翻花一梦，鹁鸪啼彻柳三眠。\n此景正悠然。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梦游仙 湖干新咏十首 其七","author":"徐石麒","text":"湖居好，客至一茶葫。\n梅雨为添床下瓮，松风知沸墉边炉。\n何必入郇厨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梦游仙 湖干新咏十首 其八","author":"徐石麒","text":"湖居好，得意尽风流。\n喜逐渔郎歌欸乃，闲调鸟子学軥辀。\n殊胜石城讴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梦游仙 湖干新咏十首 其九","author":"徐石麒","text":"湖居好，别是瓠中天。\n麦秀桐华花甲子，鸿宾燕乳鸟寒暄。\n无术也知年。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梦游仙 湖干新咏十首 其十","author":"徐石麒","text":"湖居好，安土便为家。\n一棹扬舟轻似蜢，数椽茅屋小于蜗。\n端不羡豪华。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":16,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"豆叶黄 闺思","author":"徐石麒","text":"珍珠帘外草萋萋。\n手撚青梅忆旧期。\n听彻黄鹂枝上啼。\n黛眉低。\n魂落江南泪落衣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":17,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"生查子 题雨先词","author":"徐石麒","text":"梦来何处云，染就盈盈质。\n瘦影夺梅魂，寒韵惊筠骨。\n清讴浥露香，冷句凝秋湿。\n我愿作珊瑚，架上擎君笔。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":18,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 其一 湖中述怀呈园次","author":"徐石麒","text":"杖履逍遥懒出山。\n怕他风雨做骄寒。\n半生经画为投闲。\n按候自浇花九九，迎春先扫径三三。\n此时应不在人间。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":19,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 其二 与友人约为方外游","author":"徐石麒","text":"高枕云根梦不飞。\n烟霞缭绕鹤身肥。\n薄情名誉免追随。\n小草肖人悭远志，文无赠我解当归。\n故园松菊正芳菲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":20,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 其三 咏兰","author":"徐石麒","text":"闹绿酣红强赴时。\n春工着意在芳姿，东风开送一枝枝。\n幽不乞怜君子傲，淡能存好美人痴，影宜图画韵宜诗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":21,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 其四 春闺","author":"徐石麒","text":"春到花间燕子知。\n旧巢新葺傍人时。\n傍人人自不禁持。\n欲把青棠蠲旧忿，又拈红豆说相思。\n喃喃只是怨归迟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":22,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"卜算子 春怨","author":"徐石麒","text":"也赋恋花才，剩有担花誉。\n百拜枝头杜宇儿，留得春儿住。\n啮尽断肠诗，嚼破伤心句。\n早识春愁惯著人，撚取春归去。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":23,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"摊破浣溪沙 其一 夏夜即事","author":"徐石麒","text":"月到檐梅女字枝。\n幽人贪夜未眠时。\n自捲湘帘惊燕子，坐庭墀。\n露滑琴弦寻调乱，风欺炉火得香迟。\n花影满身寒不起，少人知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":24,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"摊破浣溪沙 其二 题秋棂词","author":"徐石麒","text":"自是诗肠别有肠。\n冰壶濯魄冷而香。\n二十四风徵好句，满奚囊。\n锦字簇成花伎俩，新声押就鸟宫商。\n谁按锦筝歌此曲，杜韦娘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":25,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南歌子 其一 湖中自适","author":"徐石麒","text":"茶灶烟初篆，诗瓢梦已华。\n门前鹦鹉向人哗。\n定是青溪老衲、访山家。\n点易新研露，谈经巧笑花。\n脱巾高唱白云斜。\n不信壶天、更有泛仙查。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":26,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南歌子 其二 戏作女儿词","author":"徐石麒","text":"十样耽眉癖，三年学步痴。\n新来样子脱西施。\n便教名花自对、也相思。\n鬟髻堪钗玉，衣裳足绣丝。\n未窥帘幕少人知。\n可奈年年不嫁、损春时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":27,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南歌子 其三 病中作","author":"徐石麒","text":"璧月时侵榻，檐风自掩门。\n无聊枕上耐呻吟。\n羞说烟花三月、旧时春。\n病里研诗细，愁中得句真。\n青山管取卧游人。\n领得离骚滋味、两三分。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":28,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浪淘沙 难后留别","author":"徐石麒","text":"相与说乘槎。\n无计留他。\n春花夜月尽鸣笳。\n只有青青双眼在，曾见繁华。\n飘泊向天涯。\n何处吾家。\n浮萍知否是杨花。\n自恨不如枝上鸟，犹自喳喳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":29,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹧鸪天 喜郭亦五刘元凯过访","author":"徐石麒","text":"一到湖干屐齿稀。\n吟鞭若个指荆扉。\n百钱正此留燕市，三笑于今过虎溪。\n伤久别，怕轻离。\n奚童闲策蹇驴归。\n溪桥十里同携手，何处寒鸦噪晚晖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":30,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南乡子 其一 与然倩雨先饮村酤","author":"徐石麒","text":"春去几何程。\n剩有湖山一带青。\n寻向绿杨桥上去，多情。\n莺老犹能作慢声。\n有酒且提瓶。\n莫向青天话不平。\n万事不求求一醉，无情。\n薄酒临风忒易醒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":31,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南乡子 其二 金陵道中","author":"徐石麒","text":"霜叶冷江湄。\n何处秋山嵌落晖。\n行遍雨花台下路，追随。\n我马玄黄唤不肥。\n借问酒家谁。\n十五当垆解画眉。\n买得松醪休浪醉，葳蕤。\n听唱金钗两臂垂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":32,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"玉楼春 答友人","author":"徐石麒","text":"问余寥落情何寄。\n曾向蜗庐寻活计。\n品题清浊酒升书，点次丹黄花及第。\n江潭憔悴长沙涕。\n不到江陵歌舞地。\n楮生砚史秃头公，拣遍人生真得意。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":33,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"唐多令 重阳感旧","author":"徐石麒","text":"曾忆是重阳。\n垆头新酒香。\n戴黄花、携手同行。\n去日而今能几许，追往事，费徬徨。\n若个在吾旁。\n重经旧酒场。\n怕伤怀、按住柔肠。\n歌伎但歌行乐事，莫为我，变新腔。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":34,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"临江仙 寄怀特社诸子","author":"徐石麒","text":"谩道入山深处好，山深人迹荒凉。\n回头万种泪沧茫。\n故人天外眼，熟事酒边肠。\n把笔欲倾千幅纸，清词多为君商。\n扁舟拟附打渔郎。\n江湖才咫尺，风雨不寻常。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":35,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"渔家傲 寄衣","author":"徐石麒","text":"河畔青青无限草。\n雁声一度经秋老。\n兀坐高楼云树渺。\n寒料峭。\n那堪北地严霜早。\n新苎初成裁作袄。\n停针费尽心多少。\n又恐秋风吹瘦了。\n腰胯小。\n只须改换当时稿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":36,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"行香子 其一 歌自制曲","author":"徐石麒","text":"韵谱新修。\n乐府精搜。\n舞阳春、高调谁俦。\n详推字眼，稳拍歌头。\n早冷吴歈，分楚艳，擅齐讴。\n不唱甘州。\n不知伊州。\n最宜传、二八歌喉。\n酒酣翠幄，花近红楼。\n正响琵琶，清羯鼓，润箜篌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":37,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"行香子 其二 自题读书处","author":"徐石麒","text":"老树丫叉。\n瘦竹篱笆。\n径支离处士人家。\n犬无惊吠，莺有清哗。\n但席为帘，茅为瓦，纸当纱。\n炉内烹茶。\n瓶内簪花。\n客来时、园有壶瓜。\n红尘不到，白发休嗟。\n且读离骚，点周易，讲南华。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":38,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"祝英台近 难后怀蕙庵","author":"徐石麒","text":"雨中山，山下渡，犹是旧时路。\n指尽征帆，都向日边去。\n萧萧红蓼西风，白蘋秋水，望岭表、苏郎何处。\n莫回头。\n只有烟雨鸣鸠，惊飞夕阳坞。\n断刹荒丘。\n再诵鲍照赋。\n归来又恐伤心，人非物换，空一座、锦城如故。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":39,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"六幺令 秋兴","author":"徐石麒","text":"毳花茸草，满地无情绿。\n西风急吹雁影，不愿归南国。\n江上芦花夜冷，谁伴鸳鸯宿。\n玉楼金谷。\n歌声乍起，几处征夫梦初熟。\n繁华好是迷目，尝着须云足。\n君不见塞上翁，得马应非福。\n争放枭鹰黠犬，知是谁家鹿。\n阴晴难卜。\n不如杯酒，醉后高歌几声曲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":40,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"八声甘州 乞痴","author":"徐石麒","text":"笑英雄、无计拨闲愁，安得谓雄哉。\n尽猢狲戏弄，山魈伎俩，触目伤怀。\n只为聪明些子，瞒不过灵台。\n故把眉峰上，叠起愁堆。\n不恨人情崄巇，恨天公生我，不作痴呆。\n谨陈蔬献酒，稽首向天街。\n愿从今、不闻不见，与海鸥、相狎莫相猜。\n人生事，清风一枕，浊酒千杯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":41,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"风流子 其一 秦淮歌馆","author":"徐石麒","text":"青楼谁窈窕，抛红豆、新唱梦扬州。\n听宫字欲流，娇能掩误，徵音初变，弱不禁愁。\n一声绕，锦投三万轴，酒下十千筹。\n落日正低，西风初度，当杯入手，肯教淹留。\n今朝相逢好，私心计、拼取醉卧垆头。\n但使碧纱稳护，莫放吟眸。\n恐二陵风雨，寒惊客梦，三山草木，影落歌楼。\n老子壮心未已，还赋悲秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":42,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"风流子 其二 感怀","author":"徐石麒","text":"踏歌归去也，纶竿上、高挂黑羊裘。\n喜有意近人，犹存幽竹，忘机似我，惟有浮鸥。\n不须问，两丸新日月，几箭旧春秋。\n若说买名，徒低酒价，但言罟利，恐涴渔舟。\n兴亡谁家事，高粱上、怕听燕子啾啾。\n且向松关喂鹤，柳道骑牛。\n有奇书下酒，灯前破瓮，好风吹韵，花下拈阄。\n如此一生足矣，何必封侯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":43,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"沁园春 其一 村居","author":"徐石麒","text":"此地吾庐，坐对青山，朝云暮霞。\n更纡回流水，随缘种竹，高低?石，任意栽花。\n绀菊宜篱，碧梧须井，自是山人布置佳。\n还堪喜，有东邻酒旆，西舍渔槎。\n春来纯是豪华。\n但醉舞狂歌忘日斜。\n笑花巢杜宇，何须怀土，草堂飞燕，不用思家。\n世事琴声，人情酒味，眼孔而今看破些。\n南窗卧，甚秋风觱栗，暮雨琵琶。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":44,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"沁园春 其二 自况","author":"徐石麒","text":"薜荔青青，芳杜招人，吾归北山。\n喜玄谈惊座，碧鸡堪语。\n缥缃插架，白鹤能衔。\n一橐春风，满怀秋月，收拾都来十亩闲。\n蓬门外，种几株高柳，不系征鞍。\n先生杖履闲闲。\n问何事春来更解颜。\n有司茶童子，探梅消息，校书女伴，报竹平安。\n骚不足歌，酒何庸惜，一梦华胥任往还。\n人间事，付花莺睍睆，社燕呢喃。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":45,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"且谣 滴滴金 梅花","author":"徐石麒","text":"色侵帘幌香侵屋。\n又交著，几竿竹。\n借得潇湘月影来，伴南枝春宿。\n玉箫声老朱弦促。\n中有佳人叹幽独。\n只恐风吹海棠天，有孤芳谁续。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":46,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南唐浣溪沙 述怀","author":"徐石麒","text":"莫把身名叩懒残。\n半生意在有无间。\n拾得新诗浑未省，几人看。\n云径竹摇山翠薄，玉壶齑嚼水晶寒。\n船上月明蓑上雨，老湖干。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":47,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"锦缠道 幽栖","author":"徐石麒","text":"万顷波涵，一段好山如画。\n种烟霞、称人潇洒。\n是谁独占东风下。\n剪竹编篱，不放闲车马。\n向疏林影外，一尊常把。\n步逍遥、共渔樵闲话。\n行人似解幽情道，画中人是，五柳先生也。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":48,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"醉春风 赠隐士","author":"徐石麒","text":"冠也无心戴。\n带也无心佩。\n问翁何物最关情，爱，爱，爱。\n绿水重回，白云千点，青山一块。\n扫叶挑崧菜。\n煮酒烹螃蟹。\n醉来若更觅翁时，在，在，在。\n红树香中，黄花影里，碧梧声外。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":49,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"眼儿媚 赠野云道人","author":"徐石麒","text":"翛然四海任云浮。\n五月尚披裘。\n中山学醉，华山学睡，几日蓬头。\n两眉闲似缑山鹤，又解替人愁。\n咸阳古道，一腔渔鼓，只唱归休。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":50,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"柳梢青 真州道中用秦少游韵","author":"徐石麒","text":"风起晴沙。\n马蹄不谙，歧路交斜。\n荒市无人，断垣高树，犹着春花。\n征衫揾泪无涯。\n听不尽、西风晚鸦。\n隔岸青磷，望如烟火，疑是人家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":51,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"恋绣衾 隐居","author":"徐石麒","text":"芳杜洲前薜荔村。\n偏人闲、寻一段春。\n又傍疏篱种柳，要门前、添一块云。\n鹤飞不去猿啼住，怕山灵、移一道文。\n白眼科头箕踞，向林间、留一个人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":52,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"踏莎行 其一 龙潭道中","author":"徐石麒","text":"雁影惊时，山痕断处。\n白云一段迷红树。\n马蹄谙尽坂头霜，沿溪觅向孤村驻。\n浊酒新篘，寒烟未煮。\n一杯持共西风语。\n满山落叶做秋声，一天凉月无砧杵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":53,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"踏莎行 其二 望湖","author":"徐石麒","text":"远树堆山，流云捧水。\n渔舟疑去天无几。\n波涵初月净无光，晚霞散作千端绮。\n芦荻洲前，茭蒲顷里。\n棹歌声逐西风起。\n野禽飞去不知名，烟波岂独元真子。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":54,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"临江仙 次陈简斋韵","author":"徐石麒","text":"正是看花花好处，重来落尽残英。\n一尊聊与听波声。\n半江秋雨歇，十里晚霞明。\n事在心徒记省，浑如好梦初惊。\n鹁鸪犹说旧阴晴。\n酒清人去后，山寂夜无更。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":55,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"钗头凤 途中觅酒","author":"徐石麒","text":"春无价。\n寒无籍。\n一肩风雨难销假。\n摇鞭手。\n吟诗口。\n江山指顾，旧时杨柳。\n否，否，否。\n青山下。\n泉声泻。\n梨花共我筹今夜。\n沉思久。\n愁难帚。\n鸡声茅店，问他村酒。\n有，有，有。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":56,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"定风波 泛湖即事","author":"徐石麒","text":"秋水清于不夜天。\n乘风荡桨绿溅溅。\n白鹭沙头渔吹起。\n来矣。\n未曾相识也相怜。\n话里欲将诗换蟹。\n不解。\n却携小扈叩余弦。\n为问瓦盆何所有。\n沽酒。\n持螯共醉不须钱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":57,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"千秋岁 渔舟","author":"徐石麒","text":"湖光如镜。\n绿褪浮云影。\n天上下，琉璃整。\n苍鸥流荇远，白鹭行沙静。\n船起处，夕阳犹在蓑衣领。\n说着烟波景。\n几个扁舟兴。\n归去也，秋风冷。\n放歌欹竹枕，买酒寻花径。\n人不道，渔翁醉也渔翁醒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":58,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"山亭柳 咏隋堤柳和邹程村韵","author":"徐石麒","text":"遥想风流。\n仅见此温柔。\n曾试与，拂迷楼。\n眉黛何人重扫，舞腰还为谁留。\n风里不知人意只自轻浮。\n烟花三月当年梦，青青依旧绕邗沟。\n何许事，使人愁。\n正是藏鸦稳处，夜深犹见灯篝。\n多少行人醉也，常系归舟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":59,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]