[{"title":"怀同岑","author":"屈大均","text":"空翠洞庭阴，松风吹满林。\n白云不可见，日与数峰深。\n闻在毛女洞，时时拂素琴。\n秋来摘朱橘，霜露湿衣襟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9122,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送陈五黄门访药禅师 其一","author":"屈大均","text":"白头陈给事，五岳去何迟。\n君父真无所，神仙亦后时。\n折梅过大庾，炊黍忆东菑。\n此日宜高卧，浮山与尔期。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9123,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送陈五黄门访药禅师 其二","author":"屈大均","text":"丈夫殊未遇，努力食嗟来。\n况有青琴在，那忧白发催。\n吴山朝步马，越水暮流杯。\n不有三禅客，谁怜一代才。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9124,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"张文献公祠","author":"屈大均","text":"南人初作相，始自曲江公。\n风度朝廷肃，文章岭海雄。\n开元多事业，大庾有祠宫。\n一自陈金鉴，君王念不穷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9125,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"东莞伯","author":"屈大均","text":"往时雄保障，功在祝融墟。\n带砺盟犹在，山河胙已除。\n不称南武号，频上窦融书。\n此日知王命，英雄总不如。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9126,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送王鍊师","author":"屈大均","text":"片言为宝剑，赠尔壮游人。\n儿女非无泪，英雄自有神。\n黄冠辞百粤，白马入三秦。\n谈笑取卿相，归来复养真。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9127,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭从弟孚士 其一","author":"屈大均","text":"往日趋行在，忠贞有我兄。\n六龙随扈从，双凤独功名。\n泪洒兰仓水，心悬缅甸城。\n家中凭第五，水菽苦经营。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9128,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭从弟孚士 其二","author":"屈大均","text":"吾宗荆子姓，人重楚王孙。\n与弟成嘉遁，惟兄在白园。\n情将同被笃，道以采薇尊。\n今日人琴丧，悲酸不可言。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9129,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭从弟孚士 其三","author":"屈大均","text":"嗟汝年虽少，英姿已绝伦。\n士龙真俊弟，仲武始成人。\n膂力难为用，才华易致贫。\n紫荆凋一干，痛绝是天亲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9130,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭从弟孚士 其四","author":"屈大均","text":"奔墓君无及，招魂尔不归。\n池塘谁入梦，花萼旧相辉。\n一女生弥月，三兄泪满衣。\n不知朝与暮，何以慰慈帏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9131,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭从弟孚士 其五","author":"屈大均","text":"未有遗孤在，弥令寡妇悲。\n慈乌啼欲绝，孝竹槁多时。\n康乐诗频献，离骚学不迟。\n灵床尽一恸，泉下可能知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9132,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"壬子春日弄雏轩作 其一","author":"屈大均","text":"弱柳垂烟重，夭桃破雪新。\n一身佣作苦，十口隐居贫。\n性拙鸠无屋，机閒鹿近人。\n罗浮多笋蕨，采采及青春。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9133,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"壬子春日弄雏轩作 其二","author":"屈大均","text":"日迟无一事，清啸和泉音。\n水国春难暖，茆斋昼已阴。\n娱亲惟彩笔，学道有青琴。\n慈孝怜多竹，枝枝带露深。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9134,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"壬子春日弄雏轩作 其三","author":"屈大均","text":"少妾能调管，贤妻喜读书。\n花沾红袖湿，月映碧窗虚。\n食尽思干谒，身危屡卜居。\n缠绵殊未已，小别亦愁予。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9135,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"壬子春日弄雏轩作 其四","author":"屈大均","text":"未厌妆奁戏，帷房日弄姿。\n中郎书幼妇，莱子作婴儿。\n供养多春酒，欢娱更画眉。\n茶煎萱草带，相对月明时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9136,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"壬子春日弄雏轩作 其五","author":"屈大均","text":"楚俗多哀怨，三闾曲最高。\n未曾生汉武，谁解爱离骚。\n托意惟男女，凌虚少羽毛。\n相思泉下友，泪湿旧檀槽。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9137,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"壬子春日弄雏轩作 其六","author":"屈大均","text":"自愧单家子，疏巾折节年。\n人肝分盗蹠，马革失文渊。\n花落又将尽，河清殊未然。\n终知不得志，白首作神仙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9138,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"壬子春日弄雏轩作 其七","author":"屈大均","text":"清狂亦自厌，老大欲谁亲。\n未敢求知己，犹然愧古人。\n雨中微见月，花里好留春。\n晚计惟儿女，家庭道不贫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9139,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"壬子春日弄雏轩作 其八","author":"屈大均","text":"自怜书著就，亦是一春秋。\n受业文宣母，横经大石楼。\n少年娱黄老，中岁赖穷愁。\n绝学江门在，吾曾夙夜求。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9140,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赋答莞中梁子 其一","author":"屈大均","text":"万里孤征日，三朝痛哭人。\n还家如紫塞，见尔即青春。\n犬马难酬主，鸡豚幸及亲。\n白头得知己，感激更沾巾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9141,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赋答莞中梁子 其二","author":"屈大均","text":"丈夫时命薄，不幸作神仙。\n梅福监门日，安期卖药年。\n道须高士得，书必后人传。\n岁晏多风雪，松枝好自坚。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9142,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赋答莞中梁子 其三","author":"屈大均","text":"与子复何事，千秋一采薇。\n自惊鸾鹤贵，不必稻粱肥。\n海气楼台结，溪声水石飞。\n庞公我兄事，床下拜无违。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9143,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赋答莞中梁子 其四","author":"屈大均","text":"沧浪歌自逸，渔父即三闾。\n哀怨复何益，芬芳难久居。\n月华含霜湿，泉响入风虚。\n吾道远游好，从君恣所如。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9144,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赋答莞中梁子 其五","author":"屈大均","text":"时无衰凤在，谁与楚狂言。\n将子知音好，从兹古道敦。\n鸳鸯元共命，兰蕙亦同根。\n寡过相须甚，时时一讨论。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9145,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舂山草堂感怀 其一","author":"屈大均","text":"地因滨海湿，人以著书贫。\n况复多风雨，弥令叹苦辛。\n半生游侠误，一代逸民真。\n菽水劳妻子，窗间刺绣频。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9146,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舂山草堂感怀 其二","author":"屈大均","text":"辛苦朝那女，随予万里鞭。\n还家犹是客，事母未经年。\n兰麝馀妆阁，松楸满墓田。\n可怜清夜泪，滴滴到黄泉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9147,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舂山草堂感怀 其三","author":"屈大均","text":"客心伤已尽，黄鸟苦流声。\n一水穿云直，孤花吐日明。\n东西家未定，四十道无成。\n何以蠲忧疾，文章送此生。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9148,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舂山草堂感怀 其四","author":"屈大均","text":"卧病江皋久，空悬渔父期。\n秋风不可触，一夕鬓成丝。\n海暗鸿声疾，山寒日影迟。\n祗应与黄菊，荣落在东篱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9149,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舂山草堂感怀 其五","author":"屈大均","text":"故国松楸里，君臣几杜鹃。\n卧龙成白首，跃马已黄泉。\n风雨悲寒食，干戈失墓田。\n先人薇蕨在，采采暮云边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9150,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舂山草堂感怀 其六","author":"屈大均","text":"失志今如此，吾生安所成。\n但能饮美酒，自可得高名。\n孔雀春多翠，黄花晚有英。\n九歌谁忍续，绮靡但伤情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9151,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舂山草堂感怀 其七","author":"屈大均","text":"慷慨空长啸，无心爱好春。\n愁多生白发，命薄失佳人。\n海燕成巢屡，安榴结子频。\n纤纤银系爪，犹忆搊弹新。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9152,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舂山草堂感怀 其八","author":"屈大均","text":"松子和枝落，萧疏见鹤巢。\n秋声多在竹，露气半含梢。\n寂寞通先哲，饥寒答素交。\n年来无可用，惭愧似空匏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9153,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舂山草堂感怀 其九","author":"屈大均","text":"隐忍身将老，英豪世不知。\n梁鸿元烈士，鲁肃本狂儿。\n阴市名刀久，横行匹马迟。\n朝来频揽镜，叹息鬓边丝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9154,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舂山草堂感怀 其十","author":"屈大均","text":"未能诛淖齿，何以见慈亲。\n市井堪呼战，君王已属人。\n倚闾从白发，报国及青春。\n去去提双剑，男儿自有神。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9155,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舂山草堂感怀 其十一","author":"屈大均","text":"几夕松间石，披衣坐忍寒。\n啸声空外答，心影月中看。\n果落惊山鸟，风来堕箨冠。\n凄凉殊不寐，更上步虚坛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9156,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舂山草堂感怀 其十二","author":"屈大均","text":"慷慨干戈里，文章任杀身。\n尊周存信史，讨贼托词人。\n素发垂三楚，愁心历九春。\n桃花风雨后，和泪共沾巾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9157,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舂山草堂感怀 其十三","author":"屈大均","text":"白发同秋草，愁心似落花。\n君王频殉国，将帅祗为家。\n蓟北瞻丹极，滇南想翠华。\n无才扶日月，流落任天涯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9158,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舂山草堂感怀 其十四","author":"屈大均","text":"衣服烧丹尽，图书换米馀。\n养亲生计薄，求道世情疏。\n儿女催华发，亲朋笑索居。\n黄花寒不落，岁晏欲何如。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9159,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舂山草堂感怀 其十五","author":"屈大均","text":"隐几长忘世，扶痾始觉身。\n死生元不厌，药饵且相亲。\n明月已云满，桃花那再春。\n浩歌聊自送，去作北邙尘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9160,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舂山草堂感怀 其十六","author":"屈大均","text":"几欲从军旅，其如白发人。\n有家难委弟，无策可娱亲。\n作士诗书贱，为农陇亩贫。\n终然将七尺，去作玉关尘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9161,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舂山草堂感怀 其十七","author":"屈大均","text":"平生梁雪窦，是我最知音。\n一自斯人没，三年不鼓琴。\n文章藏禹井，涕泪满山阴。\n向夕闻悲篥，魂应起壮心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9162,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"游蒲涧","author":"屈大均","text":"我慕安期子，菖蒲涧上来。\n言寻赤玉舄，更上鹤舒台。\n古寺临秋水，当窗见早梅。\n苍苍一洞口，不得水帘开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9163,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"答人惠药","author":"屈大均","text":"蝴蝶作庄周，佯狂世上游。\n有身惟殉道，无地可埋忧。\n月出先微雨，梅开后素秋。\n承君念寒疾，药石重相投。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9164,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"罗生以角弓赠行","author":"屈大均","text":"丈夫求一饭，不到孟尝前。\n贫贱多知己，飘零及壮年。\n亲劳角弓赠，申以紫骝篇。\n此去非游猎，烟尘满朔天。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9165,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"重寄姚石埭 其一","author":"屈大均","text":"闻君挹丹溜，日夕讼堂閒。\n人道罗浮月，飞来天柱间。\n子安有黄鹄，肯送故人还。\n还及梅花发，朱明更掩关。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9166,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"重寄姚石埭 其二","author":"屈大均","text":"信陵去已久，高义在夫君。\n我亦屠沽者，诸侯莫不闻。\n昔劳赠长剑，今岂若浮云。\n歧路怀知己，踟蹰向夕曛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9167,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"逢陆冰修","author":"屈大均","text":"平生爱吴越，山水足登临。\n有友皆高尚，如君最素心。\n钱唐昔相见，蓟北此招寻。\n惠我新诗好，洋洋被玉琴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9168,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"频阳纪梦作 其一","author":"屈大均","text":"湘累魂越散，端赖美人招。\n故国无三秀，佳期有二姚。\n神光离复合，幽梦暮还朝。\n不道襄王惑，频将玉佩要。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9169,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"频阳纪梦作 其二","author":"屈大均","text":"南楚来萍实，西秦遇蕣英。\n舞惊王剪里，歌掩美原城。\n薄梦为媒妁，多情愧友生。\n思为连理木，枝叶向冬荣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9170,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"频阳纪梦作 其三","author":"屈大均","text":"风吹珠海月，月照弄珠人。\n窈窕匏瓜匹，徘徊子夜春。\n惊鸿翩欲举，堕马艳无伦。\n太白金陵子，风流继后尘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9171,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"答定上人","author":"屈大均","text":"乞食元吾道，萧然似古狂。\n九歌惊市井，一笑受壶浆。\n世态从轻薄，仙源自渺茫。\n逢君人外赏，把臂竹林傍。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9172,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题戴务旃水田图","author":"屈大均","text":"与君沮溺心，农事怀江阴。\n昨梦水田鹭，飞过青竹林。\n朝来作图画，春色东皋深。\n安得耦耕去，还为桑者吟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9173,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠兖州朱十四 其一","author":"屈大均","text":"少小逐游侠，骄行白鼻騧。\n昔逢宋如意，今得鲁朱家。\n拂剑舞秋月，开樽临暮霞。\n高堂有歌管，斟酌曲中花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9174,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠兖州朱十四 其二","author":"屈大均","text":"嗟君闾里侠，金尽欲如何。\n乱后田园少，愁中鼓角多。\n将军无细柳，渔父且沧波。\n怀有遗书在，行行避紫驼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9175,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"以鹤顶杯赠潘峋蝼时翁年八十矣","author":"屈大均","text":"金应收骏骨，珠莫买蛾眉。\n况此飞仙物，堪娱绮皓姿。\n闻翁春酒熟，正值杏花时。\n将我鹤杯饮，千龄定可期。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9176,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过清远诸滩","author":"屈大均","text":"一百重滩水，篙篙与石争。\n风雷随地转，岩壑逐人行。\n舟子寒相怨，沙禽暮亦惊。\n何当归旧隐，高卧掩柴荆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9177,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"冬日英州山中","author":"屈大均","text":"山山黄叶尽，残雪响枫林。\n天入群峰小，泉归一壑深。\n高松寒立影，明月正栖心。\n冉冉岁华暮，谁来问玉琴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9178,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浈阳舟中","author":"屈大均","text":"离乡曾几日，不断梦庭闱。\n自是慈恩重，非关道力微。\n空江过宿雨，细草媚朝晖。\n未忍寻山水，秋深定卜归。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9179,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"度腊岭","author":"屈大均","text":"一径穿红树，千盘堕白云。\n衡湘林外出，交广岭头分。\n流水如人语，回峰似雁群。\n间关何所事，荡子去从军。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9180,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"任嚣城","author":"屈大均","text":"泷口高城在，将军旧启疆。\n观星知越霸，绝道待秦亡。\n虎豹三关踞，旌旗五岭扬。\n保民功不小，祠庙遍炎方。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9181,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"度骑田作","author":"屈大均","text":"鞍马不遑息，行行栈阁间。\n天寒风落木，日暮雨连山。\n摺岭通三楚，郴江下百蛮。\n遗民思义帝，伏腊泪痕斑。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9182,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乳源出水岩采雪花赠高士周孝廉诩","author":"屈大均","text":"乳山多异卉，岁晏发寒林。\n不作冰霜色，谁知草木心。\n幽香盈石室，素影傍瑶琴。\n迟暮吾何惜，凭将答所钦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9183,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梅花?水","author":"屈大均","text":"梅花?水地，幽绝可逃秦。\n耕凿无馀事，衣冠在野人。\n人人持鹿铁，处处见熊伸。\n徭女歌声好，风吹听不真。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9184,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过泷 其一","author":"屈大均","text":"水出五禽岭，飞腾作六泷。\n蹴天过万嶂，驱石落三江。\n舟楫惊相战，蛟龙怒不降。\n汉时周太守，疏凿奠吾邦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9185,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过泷 其二","author":"屈大均","text":"险绝过泷水，舟飞沸鼎中。\n死生随白浪，出没信狂风。\n沉璧祈河伯，开山叹鬼工。\n单船如一叶，片片落秋空。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9186,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过泷 其三","author":"屈大均","text":"性命悬三老，舟行若转蓬。\n心安过一石，身小束千峰。\n猿啸梅花里，人栖竹叶中。\n年年白头浪，送客欲成翁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9187,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]