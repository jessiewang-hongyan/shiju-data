[{"title":"沙河 其三","author":"屈大均","text":"展思宫殿在，创自肃皇年。\n列圣焄蒿色，诸陵松柏烟。\n黄花通御气，紫塞振长鞭。\n一路金汤固，真人自守边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8922,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"沙河 其四","author":"屈大均","text":"三宫悬大漠，九塞扼居庸。\n羽卫何曾战，丸泥本可封。\n诸珰争揖盗，万国失从龙。\n辇路沙河曲，萋萋烟草浓。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8923,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"昌平道中 其一","author":"屈大均","text":"落日昌平道，愁从关塞归。\n九门吹画角，万户捣寒衣。\n伏草黄狐啸，衔芦白雁飞。\n朝宗桥下水，呜咽出金微。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8924,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"昌平道中 其二","author":"屈大均","text":"可怜陵寝地，千里草离离。\n二水沙河在，双桥御道移。\n水泉边马识，风候野驼知。\n亦有城头月，苍苍似汉时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8925,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"天寿山 其一","author":"屈大均","text":"燕山连紫塞，千里抱长安。\n北锁天关险，东襟渤澥寒。\n龙文犹五色，凤势必千盘。\n寂寞裬恩殿，孤臣掩泪看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8926,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"天寿山 其二","author":"屈大均","text":"文皇当正脉，列圣绕中峰。\n地作诸华福，山为五岳宗。\n东西金殿起，左右宝城重。\n云气如宫阙，高高护六龙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8927,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"天寿山 其三","author":"屈大均","text":"岂意千秋后，空馀龙凤门。\n白狐登御榻，青犊入文园。\n玉砌磨刀坏，银泉浴铁浑。\n雍门无限泪，沾洒列朝恩。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8928,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"天寿山 其四","author":"屈大均","text":"万壑松楸尽，园陵锁寂寥。\n空馀龙虎抱，似有鬼神朝。\n银海阴风落，珠尘细雨飘。\n天南霜露思，极望草萧萧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8929,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"天寿山 其五","author":"屈大均","text":"辇道哀湍激，神楼晚日悬。\n九龙无彷佛，群鹤尚联翩。\n玉盌沦秋草，珠帘落暮烟。\n白头宫监在，相对泪潸然。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8930,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"天寿山 其六","author":"屈大均","text":"北极钩陈出，西山寝殿移。\n香炉销兽火，宝帐挂蛛丝。\n山枕黄花戍，泉通太液池。\n守陵馀几户，犹是羽林儿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8931,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"天寿山 其七","author":"屈大均","text":"夹道云龙柱，横空日月楼。\n金波鳷鹊动，玉气白虹浮。\n命可中华永，功为万古谋。\n丰碑无一字，瞻仰泪频流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8932,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"天寿山 其八","author":"屈大均","text":"十道穿桥水，千林拂殿枝。\n飞腾神马在，兴废石人知。\n盗火烧香峪，妖云压玉墀。\n边墙虚内外，无计护罘罳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8933,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"天寿山 其九","author":"屈大均","text":"二井东西在，诸妃墓未崩。\n国朝稀殉葬，宫女少陪陵。\n雨为斑泪滴，云似綵衣凝。\n终古闻瑶瑟，凄凄怨不胜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8934,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"天寿山 其十","author":"屈大均","text":"陵冢纷相望，先皇骨肉留。\n小王陪玉匣，贵主接珠丘。\n衔石瑶姬恨，吹笙子晋愁。\n白杨风飒飒，谁与奠清秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8935,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"银钱山 其一","author":"屈大均","text":"银钱苍翠里，先帝有攒宫。\n衰草萦金缕，高天堕宝弓。\n辽阳来猎火，秦地起悲风。\n心共桑乾水，千秋绕汉宫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8936,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"银钱山 其二","author":"屈大均","text":"不及东西井，峨峨享殿开。\n单于封树去，故老岁时来。\n万古啼乌怨，三秋落木哀。\n中涓陪玉匣，谁奠白蘋杯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8937,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"银钱山 其三","author":"屈大均","text":"渴葬春秋恨，干戈礼未成。\n一抔秋草满，万里朔云平。\n白日沉蒿里，青山断宝城。\n微臣有兰杜，何处荐皇英。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8938,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"金山","author":"屈大均","text":"路入金山口，丰碑野火焚。\n苔侵香水院，潭起黑龙云。\n岳势当燕去，河流入塞分。\n行人多再拜，天下大师坟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8939,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"居庸 其一","author":"屈大均","text":"险绝太行北，居庸第八陉。\n长城横塞白，叠嶂逼天青。\n未可凭飞将，何当弃大宁。\n宣辽中路断，此地岂藩屏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8940,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"居庸 其二","author":"屈大均","text":"崖石争盘束，羊肠不可攀。\n塔留番字古，城设汉军閒。\n小作弹琴峡，微开纳款关。\n中华无锁钥，辜负万重山。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8941,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"居庸 其三","author":"屈大均","text":"岭出居庸上，窥关若井中。\n水声千尺落，林响万山同。\n地许孤城扼，天教一骑通。\n悲风吹不尽，战血染沙红。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8942,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"居庸 其四","author":"屈大均","text":"北口连南口，双峰壁立多。\n峡山迷一线，陉水阻重河。\n间道松林在，潜军半夜过。\n繇来天险地，容易倒前戈。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8943,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"岔道","author":"屈大均","text":"八达资屏障，秋来鼓角雄。\n上都西路出，延庆北门通。\n马渴衔冰乱，狼惊入草空。\n宣宗游猎地，不与四楼同。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8944,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"龙虎台","author":"屈大均","text":"汉帝亲征日，扬威龙虎台。\n翠华回朔漠，天寿起蓬莱。\n太液桑乾接，佳城玉带开。\n万年宫树在，鸾鹤尚飞来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8945,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"八达岭","author":"屈大均","text":"俯视神京尽，居庸若建瓴。\n出关愁草白，入塞喜山青。\n千帐牛羊绕，诸陵雨雪扃。\n元人南北口，此岭作藩屏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8946,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宣府作 其一","author":"屈大均","text":"往日多游幸，云州作帝家。\n离宫临雁塞，御气绕龙沙。\n青接明妃草，香传萧后花。\n羽林军散后，凄切任吹笳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8947,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宣府作 其二","author":"屈大均","text":"辽后多遗迹，人怜避暑宫。\n塞花明宝靥，边月满雕弓。\n二水桑乾合，三云大漠通。\n花园经上下，歌管慰飘蓬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8948,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乌金","author":"屈大均","text":"乌金营里市，马乳点茶香。\n汉女烧银鼠，蕃儿跨大羊。\n红颜如粪土，白骨作垣墙。\n向晚吹芦管，乌乌断客肠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8949,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"云州秋望 其二","author":"屈大均","text":"八月大同秋，霜花满客裘。\n身随宛马壮，手以角弓柔。\n水胍驼能识，边声雁亦愁。\n纷纷风柳落，吹入望乡楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8950,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"茶窝口","author":"屈大均","text":"紫荆离十里，此处券门开。\n高垒资人去，重河拒马来。\n冰霜秋栗烈，砧杵暮凄哀。\n渐近悲歌地，风吹易水回。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8951,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寒食","author":"屈大均","text":"萧条寒食节，蒿里草茫茫。\n岁月添黄土，英雄聚白杨。\n报仇寻豫让，驱马渡清漳。\n辛苦邯郸子，从今老战场。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8952,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"邯郸道中","author":"屈大均","text":"叹息丛台下，英雄日寂寥。\n战场无白日，旷野一秋雕。\n草没廉颇宅，云迷豫让桥。\n悲歌谁与和，归思晚萧萧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8953,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"信部","author":"屈大均","text":"歇马风门望，襄州秋色开。\n太行盘钜鹿，漳水绕邢台。\n闾里聊为侠，皇天不爱才。\n当时赵几霸，谁继武安来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8954,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"边词 其一","author":"屈大均","text":"边郡今无事，风吹杀气过。\n鼓鼙沉上谷，烽火断交河。\n子女穹庐入，金珠大马驮。\n蒙恬城下骨，夜夜听笙歌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8955,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"边词 其二","author":"屈大均","text":"草长迷青冢，冰消见白台。\n汉儿吹角去，羌女打毬来。\n牙帐山山卓，雕旗处处开。\n诸王分六角，会猎向龙堆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8956,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"边词 其三","author":"屈大均","text":"暮冬寒凛洌，出口唾成冰。\n肌肉愁风割，胡髯苦雪凝。\n边声吞鼓角，战火接园陵。\n向夕庵庐宿，凄然泪满膺。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8957,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"边词 其四","author":"屈大均","text":"积冰千万里，北极是寒门。\n八月黄榆尽，三春白草繁。\n无衣凭戍火，不守惜边垣。\n处处开横帐，笳声梦里喧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8958,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"边词 其五","author":"屈大均","text":"黑峪无人迹，天寒鸟兽饥。\n冰残狐不渡，雨暗雁犹飞。\n破屋馀烟火，孤城隔翠微。\n迢遥西澥子，时见猎人归。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8959,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"边词 其六","author":"屈大均","text":"鹰隼秋轻疾，风霜激羽毛。\n逐禽千里远，卓马万山高。\n雁膳餐偏饱，驼封卧不牢。\n胪朐河畔月，夜影恋征袍。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8960,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"边词 其七","author":"屈大均","text":"弓马疾如飞，将军秋打围。\n狼头悬大纛，蟒锦制戎衣。\n犯雪过疏勒，冲风下武威。\n归来献王子，獐兔尽鲜肥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8961,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"边词 其八","author":"屈大均","text":"日幕归千骑，骄嘶靺鞨风。\n卢沟衰草外，督亢乱云中。\n鞍上齐倾酒，营前各祭弓。\n誇称小郎主，射得一黄熊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8962,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"边词 其九","author":"屈大均","text":"伊昔临洮战，几擒吐谷浑。\n将军频失道，天子不垂恩。\n豺虎无声过，城池几处存。\n空馀青海月，长照黑山魂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8963,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"边词 其十","author":"屈大均","text":"落日在龙城，羌儿向柳营。\n弯弓窥汉月，吹笛作秦声。\n天似穹庐覆，风从班马生。\n当年霍骠骑，一剑此横行。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8964,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"边词 其十一","author":"屈大均","text":"渴饮家驼乳，寒披野马裘。\n书生贪射虎，战士喜椎牛。\n风动河冰裂，烟含塞日愁。\n但令扫雠耻，不必取通侯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8965,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"边词 其十二","author":"屈大均","text":"夜夜眠庐帐，朝朝控橐驼。\n边沙尝似雪，塞水忽成河。\n战士黄羊饭，筝人白马驮。\n威名想蓝玉，铁券勒功多。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8966,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吴门逢京兆杜子赋赠 其一","author":"屈大均","text":"我爱秦风劲，无衣不自谋。\n美人居板屋，女子解戎辀。\n岳走三峰势，河吞八水流。\n君从关内至，意气正横秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8967,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吴门逢京兆杜子赋赠 其二","author":"屈大均","text":"姑苏秋月夜，歌舞乱如云。\n我亦吹箫至，吴王不可闻。\n徘徊金虎迹，想像水犀军。\n泉下三千剑，光芒尽在君。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8968,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"同杜子入秦初发滁阳作","author":"屈大均","text":"天晓滁阳望，苍茫大野开。\n风威肃人马，烟色惨墩台。\n慷慨无衣赋，艰虞不世才。\n平生一匕首，为子入秦来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8969,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"中都 其一","author":"屈大均","text":"王迹兴闾巷，天威奋布衣。\n三章开草昧，一战扫金微。\n城阙中都在，人民奕世非。\n谁令原庙树，零落向斜晖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8970,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"中都 其二","author":"屈大均","text":"高皇汤沐色，浩荡楚天开。\n南北风云会，春秋玉帛来。\n灵旗龙陟降，王气凤盘回。\n根本岐丰旧，还期辟草莱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8971,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"凤阳 其一","author":"屈大均","text":"神阜是凤阳，瓜瓞接天长。\n仁祖勤耕稼，文孙肃禘尝。\n涂山盘寝殿，淮水入宫墙。\n白首哀遗老，依依陵树旁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8972,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"凤阳 其二","author":"屈大均","text":"地插群峰翠，天垂四野青。\n皇基犹气象，帝宅自精灵。\n禾黍侵周道，貂蝉壤汉庭。\n卧碑谁与守，臣仆日凋零。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8973,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"具茨","author":"屈大均","text":"帝受神芝箓，天开大隗宫。\n白云迷七圣，黄盖导双童。\n有象成金鼎，无为合上穹。\n龙颜如皦日，瞻望具茨东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8974,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"硖石道中","author":"屈大均","text":"天险雒阳西，临关万岭低。\n冰坚人马滑，云暗驿楼迷。\n竦石频当谷，飞梁忽接溪。\n几家陶穴住，烟火暮凄凄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8975,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阌乡道中呈杜子","author":"屈大均","text":"中条高积雪，太华远横云。\n初日光相乱，芙蓉望不分。\n冰开河艇过，风起岳钟闻。\n明日苍龙岭，攀跻定与君。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8976,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"登潼关怀远楼","author":"屈大均","text":"山挟洪河走，关临隘地开。\n八州高仰屋，三辅迥当台。\n戍晚栖乌乱，城秋班马哀。\n茫茫王霸业，抚剑独徘徊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8977,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西岳祠","author":"屈大均","text":"地引黄河带，天垂太华旒。\n威灵扬白帝，肃杀散高秋。\n钟鼓存仙殿，云霞拜岳楼。\n凭将巨灵掌，万古荡皇州。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8978,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"桃林坪","author":"屈大均","text":"窈窕桃林峡，天如匹练垂。\n石门人独入，谷口马难窥。\n拂席飞泉湿，衔杯白日移。\n神仙亦尘垢，半壁玉棺遗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8979,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"车箱潭","author":"屈大均","text":"潭水车箱满，潺湲春雨馀。\n上临毛女洞，中有渭川鱼。\n龙戛铜盘响，人临水府居。\n先朝遗玉简，灵气发芙蕖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8980,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"云台峰","author":"屈大均","text":"闻道黄河底，云台一穴通。\n水帘横洞口，天井出空中。\n一接苍龙脉，双开白帝宫。\n三峰南咫尺，青翠更濛濛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8981,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"历千尺峡百尺峡诸崄至岳顶 其一","author":"屈大均","text":"临崖垂半足，飞上岳莲端。\n玉井窥天小，蒲池弄月寒。\n白云吞万象，瀑水泻千盘。\n左右石楼敞，吾将寄羽翰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8982,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"历千尺峡百尺峡诸崄至岳顶 其二","author":"屈大均","text":"飞梯何袅袅，千仞翠微边。\n路滑愁春雪，身轻堕紫烟。\n峡中稀见日，花里屡逢泉。\n早晚携妻子，同餐玉井莲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8983,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"青牛台访彭荆山","author":"屈大均","text":"谁凿芙蓉翠，飞楼架此峰。\n千山围落雁，一脉度苍龙。\n日射黄河雪，天摇白帝钟。\n王孙游不返，此地种长松。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8984,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"大雪西峰作","author":"屈大均","text":"三峰莲皎皎，万壑雪濛濛。\n玉女花频散，仙人雾欲空。\n光摇高掌月，声乱紫霄风。\n天地茫茫失，骖鸾路未通。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8985,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"渭川","author":"屈大均","text":"渭源从鸟鼠，东走向黄河。\n势到潼关大，膏流沃野多。\n双桥像牛女，七水汇风波。\n往日皇威震，呼韩缓辔过。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8986,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"三原人日作","author":"屈大均","text":"春水流澌满，双渠接瓠中。\n桥横清峪阔，城倚仲山雄。\n游女骄人日，新妆俨汉宫。\n藏梅犹冻雪，著柳已光风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8987,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"初至雁门赠陈祺公使君 其一","author":"屈大均","text":"雁门雄九塞，句注壮三云。\n开拓灵王业，驱除李牧勋。\n汉兵天上戍，羌笛月中闻。\n锁钥今公赖，威名回冠军。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8988,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]