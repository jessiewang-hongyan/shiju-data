[{"title":"奉酬高廷评谡苑 其一","author":"屈大均","text":"信美高廷尉，名尊汉殿中。\n法冠辞蓟北，使节到禺东。\n以我栖迟久，相将啸咏同。\n无能善黄老，系袜愧张公。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10714,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉酬高廷评谡苑 其二","author":"屈大均","text":"鲛人何慷慨，解作报恩珠。\n泪下成明月，光流满海隅。\n君怜珍怪甚，情与世人殊。\n耳后双悬好，持将赠彼姝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10715,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉酬高廷评谡苑 其三","author":"屈大均","text":"一笔书兼画，时时逸势飞。\n丁真还永草，吴带复曹衣。\n纨扇人争得，银钩世所希。\n丹青能教我，当作陆探微。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10716,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉酬高廷评谡苑 其四","author":"屈大均","text":"共怜人胜节，欢赏及年华。\n七种金盘菜，千枝火树花。\n相思经岁月，相结且云霞。\n朝汉台边柳，牵君白鼻騧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10717,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉酬高廷评谡苑 其五","author":"屈大均","text":"老龙玄牝客，小凤紫微人。\n道以文章重，情于隐逸亲。\n莺时须有酒，花外即无邻。\n君赠诗篇好，长为怀袖珍。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10718,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉酬高廷评谡苑 其六","author":"屈大均","text":"汝亦尊南宋，词多学玉田。\n风流朱十似，辉映浙西贤。\n乐府宜新调，离骚贵外篇。\n珠娘今解唱，莫使广南传。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10719,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉酬高廷评谡苑 其七","author":"屈大均","text":"两粤山川路，间关子大夫。\n亲裁南海记，自写桂林图。\n负矢多香尉，持笺有雪奴。\n陆生人最笑，金橐照城隅。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10720,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉酬张超然处士 其一","author":"屈大均","text":"久知闽海上，处士有君贤。\n草野心谁识，春秋论自传。\n家浮江左地，客作日南天。\n一见成胶漆，情因道义偏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10721,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉酬张超然处士 其二","author":"屈大均","text":"有愧林乌甚，艰难菽水才。\n承君同束皙，为我补南陔。\n贫使文章贱，愁将岁月催。\n江南思负米，欲去复迟回。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10722,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉酬张超然处士 其三","author":"屈大均","text":"此日宜高尚，方无愧白华。\n无营元处子，不辱即中华。\n卧尽林间雪，餐馀海上霞。\n浮云多妙志，与尔总忘家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10723,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉酬张超然处士 其四","author":"屈大均","text":"振笔天文似，离离垂素晖。\n相箴多雅颂，相被有裳衣。\n吾道惟删述，平生亦庶几。\n君才尤绝丽，玄上凤凰飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10724,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉酬张超然处士 其五","author":"屈大均","text":"自作渔罾卖，吾师北郭骚。\n家临鲛室近，楼对虎门高。\n一日鸡豚少，三年士马劳。\n无成徒白首，愧尔赠雄刀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10725,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉酬张超然处士 其六","author":"屈大均","text":"白日无馀事，鸣琴在石床。\n神明归大易，梦寐得羲皇。\n身为诸华守，书因一老藏。\n君能相羽翼，斯道有辉光。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10726,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送严止峰","author":"屈大均","text":"尔有潇湘竹，枝枝写赠人。\n分予慈孝笋，散作一林春。\n去及朱明节，归娱白发亲。\n苍苍秦驻月，长为草堂新。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10727,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"张桐尹饷我杭州宫扇赋此答之 其一","author":"屈大均","text":"细摺金霞瓣，轻裁宝月轮。\n样依南宋内，制自武林人。\n烟雾乘鸾影，虚无拾翠尘。\n殷勤君见赠，顿使手生春。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10728,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"张桐尹饷我杭州宫扇赋此答之 其二","author":"屈大均","text":"绝胜齐纨素，怀归好媚兹。\n更将明月似，分与小星持。\n荷片团圆处，榴英灼烁时。\n凉风起君袂，花发梦先知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10729,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送琴客詹大生丈","author":"屈大均","text":"长啸和君琴，风吹山水心。\n不因天籁好，安见古人深。\n自此梦中路，兼之空外音。\n圣湖明月夜，愁绝一人寻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10730,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄徐孝先","author":"屈大均","text":"衔哀四十春，缟素一孤臣。\n牧犊无家久，烹鱼有泪新。\n水围河渚宅，梅隔武林人。\n苦节谁能似，天留不死身。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10731,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄施赞伯","author":"屈大均","text":"有友相依久，舂边度岁华。\n如何皋氏后，复有一朱家。\n水国同垂钓，山园或种瓜。\n西吴耆旧少，馀尔在蒹葭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10732,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"至日同超然作","author":"屈大均","text":"至日孤舟上，家人忆拜冬。\n惊寒因酒薄，耐暖且衣重。\n草绿添江色，花黄减岸容。\n薰炉微著火，雪事话吴淞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10733,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"生女 其一","author":"屈大均","text":"垂老频生女，呱呱亦寝床。\n妻边三织素，妾处一平阳。\n但使桃花灼，何须柳絮香。\n先人留姆训，一一与珠娘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10734,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"生女 其二","author":"屈大均","text":"弱女多逾好，陶公亦慰情。\n艰难孩抱物，断续笑啼声。\n渐渐吾衰老，迟迟汝长成。\n无穷婚嫁日，贫绝累难轻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10735,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"生女 其三","author":"屈大均","text":"岁岁生儿女，今冬复惠芳。\n双双初设帨，一一始扶床。\n卖犬知他日，乘鸾定故乡。\n无令悲远嫁，骨肉日相望。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10736,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"饮武夷茶作","author":"屈大均","text":"武夷新茗好，一啜使神清。\n色以真泉出，香因活火生。\n摘来从折笋，烹处正啼莺。\n白白瓷杯里，花枝照愈明。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10737,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"先君澹足公忌日作 其一","author":"屈大均","text":"早孤无禄甚，三十七年哀。\n不仕空承志，非时敢见才。\n贫怜三世食，老恨五男催。\n岁岁当残腊，呜呜哭草莱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10738,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"先君澹足公忌日作 其二","author":"屈大均","text":"墓木成围久，婆娑自弱年。\n梦魂多雨夜，悽怆更霜天。\n画像平时设，遗衣忌日悬。\n父书难再读，最是教忠篇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10739,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乙丑腊月十三日恭遇慈大人八十二岁生日喜赋 其一","author":"屈大均","text":"诗人歌寿母，令我亦同然。\n白发俱难老，黄流更驻年。\n人分长命缕，客至小春天。\n岁岁萱花会，无穷是此筵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10740,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乙丑腊月十三日恭遇慈大人八十二岁生日喜赋 其二","author":"屈大均","text":"炎洲春色早，腊月已阳和。\n花使高堂笑，莺教稚子歌。\n老莱欢不已，长袖舞偏多。\n煖日迟迟好，无令百岁过。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10741,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乙丑腊月十三日恭遇慈大人八十二岁生日喜赋 其三","author":"屈大均","text":"八十二春秋，麻姑未白头。\n长年乞王母，介福与康侯。\n称老吾何敢，承欢恐未周。\n儿孙是萱草，岁岁赖忘忧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10742,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乙丑腊月十三日恭遇慈大人八十二岁生日喜赋 其四","author":"屈大均","text":"儿年一甲子，发白与亲同。\n养志惟高尚，遭时且固穷。\n莺花知汉腊，儿女解秦风。\n白露蒹葭冷，全家水曲中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10743,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乙丑腊月十三日恭遇慈大人八十二岁生日喜赋 其五","author":"屈大均","text":"朱萼身虽老，连枝得弟昆。\n无营三处子，有道一曾孙。\n南雪多为雨，西山半入园。\n孀慈无事极，日夕御轻轩。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10744,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乙丑腊月十三日恭遇慈大人八十二岁生日喜赋 其六","author":"屈大均","text":"白华磨错久，无欲是生平。\n有耻甘违世，非时敢殉名。\n晨羞牲鼎少，夕卧水烟清。\n以道为甘毳，苍苍识此情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10745,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乙丑腊月十三日恭遇慈大人八十二岁生日喜赋 其七","author":"屈大均","text":"七尺人难许，归耕已十秋。\n亲安因不仕，母老复何求。\n妇汲朝临涧，儿樵晚下丘。\n陔边春草色，日夕更思柔。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10746,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乙丑腊月十三日恭遇慈大人八十二岁生日喜赋 其八","author":"屈大均","text":"乔木宋时村，安亲一小园。\n白头乌子母，新粉竹儿孙。\n古老衣冠在，虚无手泽存。\n先公如不没，九十一乡尊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10747,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乙丑岁除作 其一","author":"屈大均","text":"年光微雨后，春发大寒初。\n花片沾云湿，松声入水虚。\n酒因慈母饮，诗为小儿书。\n不记谁家腊，闻莺识岁除。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10748,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乙丑岁除作 其二","author":"屈大均","text":"又见蘼芜草，春芽出土膏。\n岁华愁里失，人事梦中劳。\n雪以乾风小，泉因细雨高。\n年年此除夕，努力是醇醪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10749,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乙丑岁除作 其三","author":"屈大均","text":"年年生一口，婚嫁尚无期。\n蚌蛤三珠日，鸣鸠七子时。\n孝衰吾岂敢，忠养汝何迟。\n阿妇殷勤道，威姑百岁姿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10750,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乙丑岁除作 其四","author":"屈大均","text":"灯花因守岁，一倍照愁思。\n学易偏多过，加年只益悲。\n寒消阴雨后，春转晓风时。\n辛苦青盲客，皇天不肯知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10751,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"乙丑岁除作 其五","author":"屈大均","text":"稚子眠难早，喧喧到晓钟。\n煖嫌灯火少，寒恨水云重。\n莺语催元日，鸡声送大冬。\n明朝书甲子，又见泪光浓。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10752,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"丙寅元日作 其一","author":"屈大均","text":"五十频加七，三年即杖乡。\n朱颜贫更好，白发老还长。\n柏酒歌中满，莱衣舞处香。\n履端何所祝，旗翼与高堂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10753,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"丙寅元日作 其二","author":"屈大均","text":"亲在宁言老，康强又一春。\n但能如寿母，即此是仙人。\n竹叶佳儿劝，椒花小妇陈。\n白头应有遇，天意在遗民。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10754,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"丙寅元日作 其三","author":"屈大均","text":"一自边人至，南中得雪看。\n炎天无旧煖，涨海有新寒。\n今岁春光早，开年花气乾。\n深深元日酒，好尽老农欢。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10755,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"丙寅元日作 其四","author":"屈大均","text":"衣冠馀一客，坐老故山春。\n鸡犬那知汉，莺花亦避秦。\n欢娱从献岁，啸傲及先民。\n莫使青腰女，今年点鬓新。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10756,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"丙寅元日作 其五","author":"屈大均","text":"一冬思曝背，晴煖向檐端。\n岂敢愁年湿，其如苦岁寒。\n旧枝和子拾，新叶当花看。\n野老惟天日，关心涕泪繁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10757,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭从兄泰士 其一","author":"屈大均","text":"而兄尝与汝，弱冠事勤王。\n间道从交趾，趋朝到点苍。\n一龙哀失所，双雁愧成行。\n九死空归去，攀髯竟渺茫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10758,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭从兄泰士 其二","author":"屈大均","text":"哲兄先汝逝，墓木已成围。\n仅后三年死，虚同万里归。\n情深甘饮恨，心在忍忘机。\n我亦吞声者，哀歌未觉非。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10759,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭从兄泰士 其三","author":"屈大均","text":"高堂衰谢甚，哭汝八旬时。\n无命长为子，多才早得师。\n孤生摧折易，一节始终持。\n辛苦同松柏，风霜总不知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10760,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭从兄泰士 其四","author":"屈大均","text":"五十早衰年，冰霜受命偏。\n一兄先宿草，三弟亦黄泉。\n雁落初寒夜，乌惊欲曙天。\n无情肠已断，况复冷猿边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10761,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭从兄泰士 其五","author":"屈大均","text":"遗臣零落尽，后死复何人。\n鹤发悲无日，羊裘望有身。\n桐孤元半死，薇在未全贫。\n忽去同蝉蜕，无言寄老亲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10762,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭从兄泰士 其六","author":"屈大均","text":"儿女皆黄口，妻孥未白头。\n欲终乌鸟养，长抱稻粱愁。\n客死依知己，魂归得首丘。\n老亲匍匐往，险绝一孤舟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10763,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭从兄泰士 其七","author":"屈大均","text":"与汝生庚午，依稀近六旬。\n文章同食力，出处未违亲。\n蒲柳忧先我，参苓耻累人。\n吾宗师表者，少尔白华身。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10764,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭从兄泰士 其八","author":"屈大均","text":"时命哀无及，平生泪在兹。\n求仁商士志，争义楚臣辞。\n子舍魂长绕，天形化未知。\n清宵应入梦，语我夜台悲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10765,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送泰士兄葬","author":"屈大均","text":"峨峨千尺松，崩向此云峰。\n白日无饥凤，黄泉有老龙。\n名留高士在，墓待故人封。\n痛哭辞烟树，归时已下舂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10766,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"细雨","author":"屈大均","text":"细雨鹅毛似，春初以此寒。\n一天林未湿，半日路犹乾。\n影欲沉花屿，声先到药栏。\n出门愁滑甚，有友隔江干。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10767,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭殇女悦 其一","author":"屈大均","text":"乳莺才出腹，毛湿未曾乾。\n耳畔啼方咽，怀中肉忽寒。\n初胎怜母小，少泪使亲安。\n辛苦蜉蝣似，承来路恐难。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10768,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭殇女悦 其二","author":"屈大均","text":"天寒长在腹，手战汝啼时。\n少乳愁珠母，无眠累雪儿。\n华灯长不息，绣褓亦重施。\n四十馀朝夕，匆匆不肯迟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10769,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭殇女悦 其三","author":"屈大均","text":"姜酒香难已，方收满月筵。\n家人将锦剪，邻女把珠穿。\n囱髻寒难戴，摇篮煖尚悬。\n无端来诳我，孩笑在堂前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10770,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭殇女悦 其四","author":"屈大均","text":"诸殇教涕泪，六度复而今。\n累以清贫重，情因老大深。\n有身才及尺，方鷇未成音。\n小小曹金瓠，婴魂何处寻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10771,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭殇女悦 其五","author":"屈大均","text":"葬从兄与姊，三尺及泉黄。\n户外烧文葆，坟边奠乳浆。\n无知难识路，不哭已沾裳。\n物化徒劳尔，休为蝶与庄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10772,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"食白蟛蜞 其一","author":"屈大均","text":"正月蟛蜞出，雌雄总有膏。\n绝甘全在壳，虽小亦持螯。\n捕取从沙坦，倾将入酒糟。\n野夫贪价贱，日夕下醇醪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10773,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"食白蟛蜞 其二","author":"屈大均","text":"风俗园蔬似，朝朝下白黏。\n难腥因汲水，易熟为多盐。\n馈客双瓶少，随身一盒兼。\n儿童频下水，多卖与闾阎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10774,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"山茶","author":"屈大均","text":"朵朵宝珠春，分明媚杀人。\n瓣沾黄粉湿，须染紫脂新。\n十日开能耐，双枝折莫频。\n却嫌多叶甚，一半掩朱唇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10775,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"儿明洪生日示之 其一","author":"屈大均","text":"二月生明日，悬弧是汝期。\n豚儿惭教少，骥子恨生迟。\n衣薄吾空问，春寒尔不知。\n父书能尽读，深望长成时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10776,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"儿明洪生日示之 其二","author":"屈大均","text":"九龄犹失学，汝懒岂吾儿。\n名父难为子，贫家未得师。\n诗书虽不好，纸笔亦同嬉。\n弟妹多欢笑，须令祖母知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10777,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"儿明洪生日示之 其三","author":"屈大均","text":"角髻双垂小，桃花戴亦宜。\n犹令作娇女，未敢说佳儿。\n九岁蒙难发，三经读已迟。\n图书吾畎亩，望汝更耘耔。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10778,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]