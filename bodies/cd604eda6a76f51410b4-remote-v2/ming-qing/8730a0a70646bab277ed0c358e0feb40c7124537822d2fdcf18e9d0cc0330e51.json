[{"title":"陈晚卿过访东溪草堂 其二","author":"张穆","text":"一宿亦岂易，十年怜再过。\n乍惊松桂长，共慰鬓丝多。\n新月当琴酒，奇香出薜萝。\n吾生惟乐事，天地尚干戈。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5798,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"同慧弓密印用弥三上人游七星岩","author":"张穆","text":"峥嵘群岫自为朋，浅草新荷绕近汀。\n玉阙烟高飞鸟缓，水岩潭黑卧龙腥。\n石危养步扶筇慢，峰巧留人借榻停。\n谁扫落花归下界，清风红雨散空溟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5799,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"花朝同高望公璩子弟赋","author":"张穆","text":"江城一月犹寒色，雨暗苔痕春半过。\n小燕有情怜旧垒，轻红何意窅高萝。\n独临野水怀人远，静对青山战鼓多。\n一往闲情重花节，故园芳草奈愁何。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5800,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寒食","author":"张穆","text":"低林小雨不胜春，赖有居停漫饮醇。\n节候似无关道眼，物情谁肯学閒身。\n但闻布谷催荒陇，不奈杨花满四邻。\n烟断岂因寒食日，粤南时有未炊人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5801,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟次闻笛","author":"张穆","text":"短藻晴沙海月生，江涵清影荡孤城。\n夜深一曲柔风里，未必同关一样情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5802,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏怀 其一","author":"张穆","text":"秋风吹荷衣，明月照我扉。\n抱琴鼓黄虞，调高识者稀。\n怀哉钟期远，千古韵已非。\n不信同心人，独与昔贤归。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5803,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏怀 其二","author":"张穆","text":"罗浮有铁桥，上跨秋河影。\n登此望东南，下视三山并。\n琼楼郁崔嵬，炤耀沧波冷。\n真人相往还，遗我金丹鼎。\n谓可驻颓颜，羽翮生俄顷。\n九还当可为，须托金石永。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5804,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏怀 其三","author":"张穆","text":"畴昔何所慕，梦与古人期。\n斯道久已杳，髣髴若见之。\n贫贱拘阔怀，局蹐废驱驰。\n乃令此心负，耿耿终不移。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5805,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送高望公还山","author":"张穆","text":"相消残垒客言归，剩有青山慰布衣。\n十载感人同社燕，一朝愁我对春晖。\n江阴思向垂阳结，天远情牵野鹜飞。\n言慕鲁连东海蹈，空怀贫食故山薇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5806,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"访梅花","author":"张穆","text":"一冬清绪坐难安，竹杖寻香过古坛。\n白屋定知高士隐，红楼更有玉人看。\n孤根岂合人间艳，冰蕊应添石室寒。\n自折杖头无可寄，归来还助几朝欢。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5807,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋燕为王公子小史画并题","author":"张穆","text":"今年别似去年时，海国秋花暗绿漪。\n轻薄昔曾王谢客，翩跹还见赵家姨。\n难留珠萡霜前影，莫负红丝社后期。\n惆怅送伊何日返，不应容易傍人篱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5808,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"泛舟","author":"张穆","text":"兰渚清风作夜歌，野情人外谢衣冠。\n花明曲岸秋初霁，柳暗幽栏水欲寒。\n倒影石楼波寂寂，隔帘瑶瑟月漫漫。\n灵槎恍髴通无际，遮莫星河得异观。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5809,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"述年","author":"张穆","text":"稚发尚可忆，未及繁华徂。\n雨露得常理，贵戚咸自如。\n负暄有遗老，里巷无追呼。\n先岩七九年，五斗尚见驱。\n余产柳州柳，突兀千山孤。\n弱冠抱迂尚，跌宕不好儒。\n虽非千金子，宝马常在途。\n衡门多杂宾，意气皆丈夫。\n由来三十载，此意未尝殊。\n怀哉祖士雅，忼慨真吾徒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5810,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"楚黄官河早发","author":"张穆","text":"鸡鸣骑马渡官河，残月寒光生素波。\n金镫露华凉欲湿，回头清啸楚天多。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5811,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西陵别了明恒见破有诸上人","author":"张穆","text":"楚天愁遍白芦花，猎猎霜风送岁华。\n茅屋夜萤流壁剑，荔墙禅月冷溪沙。\n来同庐岳高僧舍，归寄罗浮葛令家。\n闻道风尘扬晋魏，相逢何处老烟霞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5812,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"黄州避暑弘化庵","author":"张穆","text":"日长花暖锦离离，地僻参馀为启帏。\n信有玄琰听怪石，惭无佳句答黄鹂。\n烟消弱柳眠初起，雨过长松暑欲移。\n自笑无心类鸿鹄，浪留孤迹到天涯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5813,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋杪李慧庵招游白云蒲涧同胡约庵吴锦文两司理沈甸华朱公是李方水伍仲枢诸友","author":"张穆","text":"城皋秋路草烟寒，千仞青峰抚轼看。\n流水香分仙涧邈，幽林云散戒坛宽。\n愧逢飞盖西园后，肯谓攒眉白社还。\n知有玄晖诗句好，重携高咏上孤峦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5814,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"禅山过宿邝无傲","author":"张穆","text":"十年重宿习家池，高论翻为百感滋。\n兄弟几人存白发，天涯惟汝共低眉。\n一帘过雨蛙争聒，镇夜留镫鹤不疑。\n久订岩阿悲世事，长歌谁与采山芝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5815,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寿内叔谢惠翁","author":"张穆","text":"野鹤回翔天地空，还山刚与葛翁逢。\n庭纷玉树东山旧，门对芙蓉碧落重。\n瑶室异文金汁写，玉田灵药紫烟封。\n敢云衰朽同花甲，固许轻萝附茂松。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5816,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送郑邑侯解组","author":"张穆","text":"忘机久逐鹿麋群，何意蓬蒿下使君。\n世艳黄金隆郭隗，自惭珠履报田文。\n十年花发江城迥，一路梅开庾岭芬。\n气候天涯摇落甚，阳春重忆对氤氲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5817,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"游飞泉僧舍","author":"张穆","text":"端水无山不接天，一丘殊爱足周旋。\n寒林抱石分幽路，断壁奔泉出绿烟。\n禅室桃花应悟后，仙源灵药岂知年。\n閒同倚杖逢僧返，借得云房对月眠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5818,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏白鹇","author":"张穆","text":"名山有羽客，幽素自含辉。\n饮啄终存介，相依渐息机。\n青丝委华发，白雪剪文衣。\n自与家鸡别，心知在翠微。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5819,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"五色鹦鹉","author":"张穆","text":"东溟千万里，诚许鸟中英。\n岂不能言累，徵从慧业生。\n撩人低婍妮，饥啄谢凭淩。\n地僻无谈客，青窗感友声。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5820,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"海珠 其一","author":"张穆","text":"鸥鸟群飞掠桂蘅，石擎宫阙出江清。\n花田秋老香频接，晚岸潮深月自横。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5821,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"海珠 其二","author":"张穆","text":"仙城楼阁紫霞丛，夜静珠光出岸东。\n梵呗寂寥僧院散，当年空念听霜钟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5822,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"同刘良倩何雅伯登三台岩","author":"张穆","text":"香山出海百馀里，炎州已尽南冥始。\n水上奇峰半入云，青玉嵯峨断游履。\n刘翁未老烟霞骨，欣共高崖探月窟。\n下视冯夷家海门，远指方壶见珠阙。\n乘槎欲泛日月边，飒飒清风吹短发。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5823,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭家文烈","author":"张穆","text":"昔当壮年万事轻，身骑快马横东城。\n与兄意气作兄弟，立身每励为人英。\n世悲叔季各出处，嘉尔献策名峥嵘。\n文采风流曲江旧，墨沈翻浪如长鲸。\n一朝群鼠折地轴，两京失陷无完城。\n身馀黄冠返故里，揭竿斩木随死生。\n只手独出建旗鼓，虎豹复集如雷轰。\n呼天饮血誓报国，转战千里无援兵。\n层城复合得市众，未睹大敌先呼惊。\n阵移不复淝水固，日暮犹闻钲鼓声。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5824,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"同区启图戴安仲何石闾游陈秋涛宗伯云淙","author":"张穆","text":"层岫纡回欲达霄，平分绿野结僧寮。\n轻云出壑春无尽，绝鸟浮天望不遥。\n夜静松涛翻石壁，秋深兰气过溪桥。\n红尘扰扰深千尺，谁向林泉得共消。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5825,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"山鹊","author":"张穆","text":"客有遗文鸟，依人静可矜。\n精神归嘴爪，毛羽夺丹青。\n节食閒留果，衔花自上屏。\n怜无高举翮，犹立看鸿冥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5826,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"泷邑韩侯娲石承诗见赠和答","author":"张穆","text":"春满河阳花竞妍，官衙幽接九峰烟。\n政閒驯鹤亲书幌，税薄归人就石田。\n敢以猪肝劳作客，行依勾漏得邻仙。\n朝来多辱琅玕赠，久忆贫居侣米船。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5827,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"同罗曙云过王崇芳垂云阁夜话","author":"张穆","text":"昔共仙山饮石泉，云房璿室卧春烟。\n醉馀梦宿梅花月，游倦归来莲叶船。\n夜映丹光蒸五色，云瑶珠树隐三天。\n相逢为忆山中事，竹杖芒鞋又隔年。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5828,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"江上见芙蓉","author":"张穆","text":"草花江渚乱，舟晚见芙蓉。\n独立自无侣，秋波何处从。\n倦垂红萼醉，低映碧漪重。\n空怅年年客，家园怅不逢。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5829,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"佛山宿陈绿图水阁","author":"张穆","text":"宿雨深村树，炎消水阁空。\n今年见秋早，终夜对荷风。\n窗寂虫初语，林光月乍通。\n何曾外廛市，喧断绿香中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5830,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"挽叶金清","author":"张穆","text":"古人性命友，岂谓世俗中。\n金清夙幽根，性每移云松。\n我昔浪少年，志慕鸡犬雄。\n终能罢游宴，把手四百峰。\n指顾葛仙坛，不与千金通。\n谁复春听瀑，弦琴晚临风。\n相期人已远，独立看孤鸿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5831,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"挽陈尧卿","author":"张穆","text":"大化本漠漠，有意非其真。\n达人造天地，坐啸窥无垠。\n先生晚苦节，乐道非乐身。\n兼旬九啜食，此际无故人。\n我苦窜空谷，木食守素贫。\n岂忘左桃义，为世留道津。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5832,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过澹归和尚柚堂","author":"张穆","text":"清秋肃肃坐岩扉，九月严霜暗上衣。\n檐外闻香知果熟，堂前留草听虫依。\n疏林钟后无馀响，残月楼中有剩辉。\n犹爱閒云寒未举，丹山岩畔破香归。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5833,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"山中避乱怀故园亲友","author":"张穆","text":"念得馀生愧饭蔬，力田重忆故人初。\n巢云尚累牵鸡犬，饮谷犹能与鹿徂。\n五月雨深松阁梦，兼旬烽断莞城书。\n三都正是愁珠玉，桑里贫交草满闾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5834,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"社集水月庵","author":"张穆","text":"水庵僧静野鸥多，只合清秋日日过。\n花压小桥通酒艇，笛闻空浦散渔蓑。\n丹枫渐落晴江叶，素月将洄远岸波。\n何必种桃堪隔世，自无閒客叩烟萝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5835,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"除夕徐将军幕度岁","author":"张穆","text":"年年幕府重留宾，国干如云古帅臣。\n知己梦惟存范式，长鸣心竞托方歅。\n天寒更助高牙肃，帝泽先归细柳春。\n岁晚锦堂开绮宴，醉乡忘记未归人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5836,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送别","author":"张穆","text":"南溟有神鱼，百里见崒峍。\n呼吸潮汐奔，动息安可悉。\n我生愧细微，勺水锢其质。\n智力既已殊，大小乌可匹。\n真宰今厌兵，春风扫寒冽。\n有客将何之，万里操仁术。\n余当老空山，偃曝思朝日。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5837,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寿曹太史能始先生","author":"张穆","text":"曾闻采灵药，言在三神山。\n中有长年人，往返紫雾间。\n平生思梦见，乃竟亲九还。\n少年颂高名，北斗不可攀。\n清声沸郑卫，太古遂见艰。\n百年铸雅乐，二酉多所删。\n虫鱼蚀奇字，脉望如转环。\n金鼎舐鸡犬，尽可超玄关。\n噫余籍朱明，武夷易胎颜。\n希蹑云汉游，所望非驻颜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5838,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"移家石鳞山留别同里诸公","author":"张穆","text":"一片轻舟出浦烟，芦花枫叶满霜天。\n逃禅尚堕耽山癖，投老同为去国怜。\n湖柳或思张绪后，草堂争似少陵迁。\n桃花倘引寻春入，不愿人间说代年。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5839,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"山中元日","author":"张穆","text":"布袍落落老年华，兴到云山遂作家。\n淑气暗传堤上柳，晴霞红染洞边花。\n志存遗世轻贫食，诗偶逢春不惜奢。\n岁岁未能捐夙习，栽桃放鹤傍溪沙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5840,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"游三洲岩","author":"张穆","text":"海外仙山世不求，西来奇洞见三洲。\n多年积乳纷成像，五月阴风预作秋。\n字蚀藓崖参亥豕，松摧雷雹化龙虬。\n几人乱后添幽事，草没烟横恣鹿游。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5841,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题画马","author":"张穆","text":"争言龙种形神异，千里犹疑一日迟。\n聊写风沙开万里，恐无天马为人骑。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5842,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"苍梧","author":"张穆","text":"渺渺寒流下桂津，一江清绝罢垂纶。\n翠华不返悲瑶瑟，苍昊无言剩草臣。\n双马自投青霭去，孤舟惟对白蘋亲。\n前山都峤称仙室，寂就丹砂谢俗尘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5843,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋夜怀陈九畹","author":"张穆","text":"空庭独立对参横，风气移情百虑萦。\n金尽祖生还任侠，时危陈涉不慵耕。\n震邻飞羽徵兵急，畏路停车揖客轻。\n已扫人间无限累，为君归计每屏营。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5844,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寿卫菉园","author":"张穆","text":"百年过半信閒身，离菊堆金不称贫。\n千古遗弓终抱恨，十年磨剑尚如新。\n澹能鲁酒供高客，豪任齐纨散舞人。\n试问雄心销几许，从来英杰返天真。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5845,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过邝无傲新斋雨宿 其一","author":"张穆","text":"五载一以过，衡门经数迁。\n百年耽水石，五亩足云烟。\n乱去知交重，秋还岁月偏。\n劳生何以托，修證有前贤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5846,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过邝无傲新斋雨宿 其二","author":"张穆","text":"閒庭风雨夜，翻忆少年游。\n始愧境无实，知君心渐休。\n绿烟沉浦树，凉气助江秋。\n一夜寒塘长，疑闻众壑流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5847,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送别曹方伯 其一","author":"张穆","text":"岭树初承露，温风尚绿莎。\n晴霞垂绛节，大道候明驼。\n勺水惜不饮，名山愁易过。\n如闻宝林路，此地法云多。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5848,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送别曹方伯 其二","author":"张穆","text":"逢时能勇退，真羡季鹰狂。\n讵有鲈鱼美，应怜松桂芳。\n独归秋水外，心倦野鸥旁。\n万里珍行笈，十重只砚囊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5849,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"书怀 其一","author":"张穆","text":"湖堤树昔手中栽，岁岁成花几见开。\n秋水暗添鱼欲舞，晚烟横断鹤忘回。\n沙棠舟小僧同泛，蓬荜门深客肯来。\n尚忆故林归未就，独吟空笑老相催。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5850,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"书怀 其二","author":"张穆","text":"林皋晴好引雏行，辟地湖南漫课耕。\n学道养年非肉味，爱閒终日在莺声。\n碧云暮合佳人渺，芳草秋生苦菊生。\n物外徜徉谁作侣，岩僧惟有白云情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5851,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"书怀 其三","author":"张穆","text":"浮云野鹤自为情，安用公侯识姓名。\n林有围棋花并落，船非丝管耳常清。\n贷钱买石贫犹乐，采药调心癖已成。\n长笑世情浑欲醉，愿施珠玉向谁倾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5852,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寿陈君伯章","author":"张穆","text":"笑忆升平结驷年，春风拂面共垂鞭。\n閒身不为风尘累，白发犹能杖屦便。\n镇日醉花亲抱瓮，清宵爱月独移船。\n忘机已是玄真诀，喜得同君弄紫烟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5853,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"夜读刘良倩诗寄赠","author":"张穆","text":"年当霜鬓惭徵逐，每念名山构林屋。\n杖藜千里行云烟，岂意幽人值空谷。\n秋风落木吹荷衣，把手前岩友麋鹿。\n名言久向石室扃，谓我知音许披读。\n珠光出海百尺芒，一夜寒窗睡难熟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5854,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"三城曲","author":"张穆","text":"柳市春风白面郎，横街挟瑟过尘香。\n水楼花气江城月，无计青钱买夜长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5855,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送月师","author":"张穆","text":"青山曾许共诛茅，斸石锄云向岭坳。\n麜鹿无心来竹院，一镫清夜出林梢。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5856,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送沈郎","author":"张穆","text":"岭云梅树霭参差，千里香留叱拨迟。\n老去离情消不尽，识君方恨别君时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5857,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"中秋夜宿浈阳峡","author":"张穆","text":"凉飔因候发，山气已萧森。\n数日峡中酒，徒辜秋半心。\n湿云愁不解，高影乍浮沉。\n千里群峦合，安知古月深。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5858,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"望观音岩","author":"张穆","text":"幽洞悬孤岫，无由止去船。\n危栏凭怒浪，立壁绕饥鸢。\n空翠寒如画，孤高峭入烟。\n洛迦闻海外，且慰化城边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5859,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]