[{"title":"卜算子 春日寓山看花","author":"商景兰","text":"烟暖碧云楼，楼迥春山秀。\n风落残红水面飘，池内清波皱。\n柳外小莺啼，花鸟声相斗。\n唤起当年万种愁，泪湿青衫袖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14832,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"临江仙 题牡丹","author":"商景兰","text":"锦树一阑无气力，随风婀娜枝头。\n艳阳却被夕阳收。\n春光有恨，待欲控双钩。\n香入美人销不尽，依然别样娇羞。\n太真西子并风流。\n小窗倚遍，明月更相留。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14833,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"烛影摇红 咏鵻堂怀旧","author":"商景兰","text":"春入华堂，玉阶草色重重暗。\n寒波一片映阑干，望处如银汉。\n风动花枝深浅。\n忽思量、时光如箭。\n歌声撩乱。\n环佩叮当，繁华未断。\n游赏池台，沧桑顷刻风云换。\n中宵笳角恼人肠，泣向庭闱远。\n何处堪留顾盼。\n更可怜、子规啼遍。\n满壁图书，一枝残蜡，几声长叹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14834,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"捣练子 留别","author":"商景兰","text":"人去也，情难舍。\n花枝吹散风潇洒。\n霜天宿鸟静无声，流苏锦帐含愁下。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14835,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 秋思   见《林下词选》、蒋重光《昭代词选》","author":"黄媛介","text":"芙蓉花发藏香露。\n白云惨淡关山路。\n愁思惹秋衣。\n满庭黄叶飞。\n绣阁帘初捲。\n梦与离人远。\n秋雨又如烟。\n魂销似去年。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14836,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长相思 春暮","author":"黄媛介","text":"风满楼。\n雨满楼。\n风雨年年无了休。\n馀香冷似秋。\n卖花声。\n卖花舟。\n万紫千红总是愁。\n春流难断头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14837,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长相思 春日饮闲靓","author":"黄媛介","text":"花满栏。\n叶满栏。\n人醉言归情未阑。\n都来相见难。\n道如兰。\n气如兰。\n随在云山日一竿。\n离心江上看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14838,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"临江仙 秋日","author":"黄媛介","text":"庭竹萧萧常对影，捲帘幽草初分。\n罗衣香褪懒重熏。\n有愁憎语燕，无事数归云。\n秋雨欲来风未起，芭蕉深掩重门。\n海棠无语伴销魂。\n碧山生远梦，新水涨平村。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14839,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"金菊对芙蓉 答宗姊月辉见怀之作","author":"黄媛介","text":"五易星霜，两迁村塾，思君几许魂消。\n看燕来雁去，梦断音遥。\n兵戈路绝空相念，惟虚却、月夕花朝。\n还家一载，城隅轻隔，似阻江潮。\n感伊投我琼瑶。\n羡珠光溜彩，玉韵含韶。\n恨未能携手，愁寄纤毫。\n君家梅竹犹堪赏，待相逢、斗酒重浇。\n春光未老，花香正美，离思空劳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14840,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南歌子 秋思","author":"纪映淮","text":"翠菊娇秋色，金蓉衬晚霞。\n倦来无力倚红纱。\n恨杀孤鸿一点、叫天涯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14841,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"桃源忆故人 暮春","author":"纪映淮","text":"楼前花逐东风舞。\n惟有杨花堪妒。\n一味入帘穿户。\n不管愁人顾。\n枝头杜宇声偏苦。\n叫得斜阳欲暮。\n门外残红无数。\n零落横塘路。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14842,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"醉桃源 早春","author":"纪映淮","text":"疏帘不捲早春寒。\n残梅倚石栏。\n碧天无际路漫漫。\n孤云独去闲。\n丝添鬓，意阑珊。\n频将双泪弹。\n中庭明月又团团。\n愁人不要看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14843,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹧鸪天 有感","author":"纪映淮","text":"落尽红香绿满枝。\n韶光如驶去难追。\n春归过去鹃啼血，小阁帘垂乳燕窥。\n情脉脉，意孜孜。\n无言常自费寻思。\n连天草色和烟碧，何事东风着意吹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14844,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"小重山 端午","author":"纪映淮","text":"闲窗独坐病馀身。\n惊闻画鼓闹，在河津。\n始知节届佩符辰。\n彩丝系，输与少年人。\n一岁一番新。\n年光催短鬓。\n暗伤神。\n感时怀古欲沾巾。\n湘江渺，何处吊灵均。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14845,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"传言玉女 咏残梅","author":"纪映淮","text":"疏梅枝上，昨夜又经春雪。\n依依窗外，恰对人寥寂。\n冷淡孤芳，一种幽情殊绝。\n休吹长笛，好留馀馝。\n瘦影横斜，正冰蟾好时节。\n乱点苍苔，无奈东风劣。\n梦断高楼，有恨无言可说。\n早听帘际，莺调新舌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14846,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"苏幕遮 客里送春","author":"刘碧","text":"乱云中，残照里。\n又送他归，懒唤莺儿起。\n山径落红谁是主，别恨离情，目断韶华矣。\n擘涛笺，飞翠尾。\n每到关心，逗得愁如绮。\n岁岁劳人长徙倚，一似杨花，暗去随江水。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14847,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"花深深 闺怨","author":"顾媚","text":"花飘零。\n帘前暮雨风声声。\n风声声。\n不知侬恨，强要侬听。\n妆台独坐伤离情。\n愁容夜夜羞银灯。\n羞银灯。\n腰肢瘦损，影亦伶仃。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14848,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"虞美人 答远山李夫人寄梦","author":"顾媚","text":"春明一别鱼书悄。\n红泪沾襟小。\n却怜好梦渡江来。\n正是离人无那、倚妆台。\n朱栏碧树江南路。\n心事都如雾。\n几时载月向秦淮。\n收拾诗囊画轴、称心怀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14849,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"千秋岁 送远山李夫人南归","author":"顾媚","text":"几般离索。\n只有今番恶。\n塞柳凄，宫槐落。\n月明芳草路，人去真珠阁。\n问何日、衣香钗影同绡幕。\n曾寻寒食约。\n每共花前酌。\n事已休，情如昨。\n半船红烛冷，一棹青山泊。\n凭任取、长安裘马争轻薄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14850,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"忆王孙","author":"李玉照","text":"幽闺深闭日如年。\n临镜无心整翠钿。\n赢得愁肠两处牵。\n思淹淹。\n裙带闲拈花柳边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14851,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"如梦令 夜坐","author":"李玉照","text":"梦入愁乡初醒。\n犹有残灯相映。\n铁马寂无声，金鸭沉烟已烬。\n清冷。\n清冷。\n谁念绣衾孤另。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14852,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"醉公子 忆梦中美人","author":"李玉照","text":"无意拈花片。\n有恨抛针线。\n细想梦中人。\n芳姿记未真。\n默坐还相忆。\n珠泪和香滴。\n月色到窗纱。\n寻思暗抵牙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14853,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南歌子  见《众香词》","author":"王毓贞","text":"浴罢明肌雪，妆残亸鬓鸦。\n娇怯欲扶花。\n花枝扶不得、倚风斜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14854,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"生查子","author":"王毓贞","text":"兰沐绮窗凉，红汗酥胸溅。\n倦倚玉栏杆，蜂咂娇花颤。\n红沁被池香，翠滑眉心现。\n挥麈扑青蝇，佯拂檀郎面。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14855,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"生查子","author":"王毓贞","text":"鸂鶒翠钿飞，翡翠榴裙嵌。\n含笑入罗帏，人影灯光蘸。\n昵枕听晨鸡，点点铜壶勘。\n亏得种芭蕉，日闪红窗暗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14856,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"团扇篇","author":"钱谦益","text":"合欢团扇美人作，轻云如纨雪如素。\n裁成顾兔舒月波，画出乘鸾上天路。\n美人容华倾六宫，舍羞却扇妖且慵。\n自分团栾赛明月，岂知摇动生秋风。\n碧天一夜秋如水，炎凉尽在君怀里。\n不怨秋风坐弃捐，却愁明月常相似。\n秋来明月正婵娟，别殿长门是处悬。\n从教妾扇经秋掩，但愿君心并月圆。\n君心如月不可掇，妾扇团团那忍割。\n可怜团扇无蔽亏，不比清光有盈缺。\n奉君清暑为君容，莫道恩情中路空。\n蛛丝虫网频垂泪，还感君恩在箧中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14857,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题宋徽宗杏花村图","author":"钱谦益","text":"宜春小苑春风香，宣和秘殿春昼长。\n帝所神霄换新诰，江南花石催头纲。\n至尊盘礴自游艺，宛是前身画师制。\n岁时婚嫁杏花村，桑麻鸡犬桃源世。\n杏花村中花冥冥，纥干山雀群飞鸣。\n巾车挈箧去何所，无乃负担趋青城。\n君不见杏花寒食钱塘路，鬼磷灯檠风雨暮。\n麦饭何人浇一盂，孤臣哭断冬青树！","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14858,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"玉堂双燕行送刘晋卿赵景之两太史谪官","author":"钱谦益","text":"玉堂昼暖熏风香，双双燕尾摇仓琅。\n背飞并映银花榜，托宿交栖玳瑁梁。\n感君恩重巢君幕，顾影呢喃前复却。\n何当鸣梧比丹凤，且愿衔花效黄雀。\n啁哳辞归未忍归，差池掠羽试双飞。\n风回铃索声犹在，日过花砖候已非。\n珠帘十二秋风促，芦雪菰烟何处宿？\n明年社日早归来，?口衔泥补君屋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14859,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送福清公归里二首 其一","author":"钱谦益","text":"甘陵南北久分歧，鹓鹭雍容彼一时。\n抗疏有人盈琐闼，顾名无阙省罘罳。\n恩牛怨李谁家事，白马清流异代悲。\n八载调羹心独苦，临行谆复外廷知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14860,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送福清公归里二首 其二","author":"钱谦益","text":"鹗立朝端领搢绅，飘萧鬓发见风神。\n契丹使亦知元老，回纥占应见大人。\n代许孤忠留一柱，帝思耆德抚三辰。\n吴门咫尺邻阊阖，珍重东山五亩身。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14861,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"戊辰七月应召赴阙车中言怀二首 其一","author":"钱谦益","text":"三年严谴望修门，随例趋朝又北辕。\n圣代故应无弃物，孤臣犹有未招魂。\n夕阳亭下人还过，端礼门前石尚蹲。\n重向西风挥老泪，馀生何以答殊恩。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14862,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"戊辰七月应召赴阙车中言怀二首 其二","author":"钱谦益","text":"寥廓高天一冥鸿，肯随乌鸟问雌雄！\n纷纷岂止容卿辈，碌碌何须笑乃公。\n赤汗马应空冀北，白头豕自愧辽东。\n郊原无限停车思，落日披襟得远风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14863,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"临城驿壁见方侍御孩未题诗","author":"钱谦益","text":"驿吏逢迎旧赭衣，生还今日是耶非？\n纶竿喜值金鸡放，华表真同白鹤归。\n抱蔓摘瓜馀我在，破巢完卵似君稀。\n循墙叹息看题句，淅淅秋风起夕扉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14864,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"十一月初六日召对文华殿旋奉严旨革职待罪感恩述事三首 其一","author":"钱谦益","text":"宫廷初散鼠孤群，殷殷成雷又聚蚊。\n卷舌光芒仍炫耀，台阶气象向氤氲。\n伤心诏狱生春草，回首觚棱隔暮云。\n明主定无钩党禁，文华休拟作同文。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14865,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"潞河别刘咸仲吏部","author":"钱谦益","text":"别绪乡心浩莫分，潞河风雨帝城云。\n能容放废惟良友，未忘京华为圣君。\n衰鬓数茎还去国，秋风一叶又离群。\n《渭城》歌罢休垂泪，逐客年来实绝闻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14866,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题淮阴侯庙","author":"钱谦益","text":"淮水城南寄食徒，真王大将在斯须。\n岂知隆准如长颈，终见鹰扬死雉姁。\n落日井陉旗尚赤，春风钟室草先朱。\n东西冢墓今安在，好为英雄奠一盂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14867,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"已巳八月待放归田感怀述事奉寄南都诸君子","author":"钱谦益","text":"留都文物汉西京，虎踞龙蟠集俊英。\n高庙神灵尝陟降，中朝佞幸敢纵横！\n琐闱月白钟山晓，乌府霜寒淮水清。\n望尽浮云天北极，长安应见泰阶明。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14868,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"戊寅九月初三日奉谒少师高阳公于里第感旧述怀三首 其一","author":"钱谦益","text":"忽漫抠衣拜此堂，心期如梦泪千行。\n更阑尚说三条烛，坐久真惭数仞墙。\n孔思周情新著作，禹粮尧韭旧耕桑。\n明灯促席亲函丈，秋柝沈沈夜未央。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14869,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"戊寅九月初三日奉谒少师高阳公于里第感旧述怀三首 其二","author":"钱谦益","text":"再镇危关锁钥长，一归寇盗总猖狂。\n心因忧国浑如醉，鬓为论兵半有霜。\n椽笔携将分子姓，靴刀留取压文章。\n入郊先问躬耕地，简较秋原几树桑。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14870,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"岁暮杂怀","author":"钱谦益","text":"卒岁闲门有雀罗，流年徂谢意如何？\n看花伴侣青春少，种菜英雄白首多。\n佩剑定须悬旧陇，明珠只合换新歌。\n剧怜渭水垂纶叟，未应非熊鬓已皤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14871,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送吴兴公游下邳兼简李条侯","author":"钱谦益","text":"落花飞雨搅邗沟，襆被奚囊感薄游。\n宝剑千金吴季子，长城半壁汉条侯。\n高榆耕垒连沧海，深柳书堂枕碧流。\n共话老夫应失笑，春深冒絮尚蒙头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14872,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"简侯研德并示记原","author":"钱谦益","text":"当飨休听《暇豫歌》，破巢完卵为铜驼。\n国殇何意存三户，家祭无忘告两河。\n击筑泪从天北至，吹箫声向日南多。\n知君耻读《五裒传》，但使生徒废《蓼莪》。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14873,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"东归漫兴","author":"钱谦益","text":"林木池鱼灰烬寒，鸳湖恨水去漫漫。\n西华葛帔仍梁代，东市朝衣尚汉官。\n白鹤遄归无石表，金鸡旋放少纶竿。\n招魂倘有巫阳在，历历残棋忍重看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14874,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"丙戍南还赠别故侯家妓人冬哥二首 其一","author":"钱谦益","text":"绣岭灰飞金谷残，内人红袖泪阑干。\n临歧莫怅青娥老，两见仙人泣露盘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14875,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"丙戍南还赠别故侯家妓人冬哥二首 其二","author":"钱谦益","text":"天乐荒凉禁苑倾，教坊凄断旧歌声。\n临岐只合懵腾去，不忍听他唱《渭城》。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14876,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"读史记戏书","author":"钱谦益","text":"汉家争道孝文明，左右临朝问亦轻。\n绛灌但知谗贾谊，可思流汗愧陈平？","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14877,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"故宫人","author":"钱谦益","text":"汉宫遗事剪灯论，共指青衫认泪痕。\n今夕惊沙满蓬鬓，始知永巷是君恩。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14878,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"留题秦淮丁家水阁二首 其一","author":"钱谦益","text":"舞榭歌台罗绮丛，都无人迹有春风。\n踏青无限伤心事，并入南朝落照中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14879,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"留题秦淮丁家水阁二首 其二","author":"钱谦益","text":"苑外杨花待暮潮，隔溪桃叶限红桥。\n夕阳凝望春如水，丁字帘前是六朝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14880,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"村庄红豆花诗","author":"钱谦益","text":"金尊檀板落花天，乐府新翻《红豆篇》。\n取次江南好风景，莫教肠断李龟年。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14881,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"驱雀词","author":"方拱乾","text":"雀莫啄我蔬，我蔬种已迟。\n衰年事事钝，辛勤还后时。\n聊取生意足，宁独疗长饥！\n甲坼才如豆，不及邻家肥。\n肥蔬啄可饱，瘦蔬啄无遗。\n饥我不饱汝，两伤亦奚为？\n欲驱不忍击，短竿护疏篱。\n我蔬肥有日，除竿任汝飞。\n听汝嗷嗷音，生事同我微。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14882,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舂声","author":"方拱乾","text":"在家愁闻砧，砧声为客衣。\n在客愁闻舂，舂声为客饥。\n舂本非恶声，客耳自凄其。\n砧声砧者苦，舂声闻者悲。\n此地尽为客，室家亦羁縻。\n遘此八月霜，稻粱同草衰。\n稗种贱独早，皮尽乃得糜。\n十斗舂一斛，家家急朝炊。\n两舂一口资，廿口将安资？\n夜长月色苦，冷淡无光辉。\n声声相断续，远近闻一时。\n悲馀转成喜，得食谅不迟。\n便作笙竽听，天风任尔吹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14883,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"补窗","author":"方拱乾","text":"纸窗如破衲，丛添针线迹。\n纤纤鱼鳞光，朝曦逗微隙。\n夜来朔风狂，洞然半分剨。\n寒威透旃裘，况乃敝衣帻。\n看囊久无钱，纸价贵逾昔。\n求全势所难，补罅情转适。\n平生鄙弥缝，于兹悟损益。\n渐暄飙亦温，安稳蓬蒿宅。\n旧研释冰痕，昼长聊点《易》。\n微云影太空，不碍虚生白。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14884,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"路遇李澹生冯炳文","author":"方拱乾","text":"皂帽冲风沙，晴天疑晦霿。\n睹君行路色，触我来时痛。\n握手万端生，醒眼三年梦。\n相赠绕朝鞭，前途慎珍重。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14885,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"募僧收枯骨","author":"方拱乾","text":"兵戈二十载，枯骨尚如麻。\n中岂无才智，生原有室家。\n啼魂昏白昼，掩胔仗黄沙。\n何处烦冤尽，观空仰《法华》。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14886,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"早起","author":"方拱乾","text":"长夜厌朝眠，暾光到枕先。\n家无烦老事，人爱早晴天。\n研洗和冰墨，炉温隔夕烟。\n惺惺平旦气，孤坐倍泠然。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14887,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"掩柴门","author":"方拱乾","text":"柴门开亦静，无事手常关。\n晓露花争坼，斜阳牛自还。\n相看忘塞俗，久已负家山。\n偶忆雍陶句，开笼放白鹇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14888,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"九日","author":"方拱乾","text":"郁郁连朝雪，萧萧九日晴。\n异乡谁送酒，令节但存名。\n目断天无极，风高沙自惊。\n莫嫌人迹远，雁迹罢南征。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14889,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"放雉","author":"方拱乾","text":"万物爱生还，凌霄刷羽翰。\n自经罗网苦，益觉地天宽。\n文采无夸耀，飞翔得便安。\n故山谐伴侣，不羡女床鸾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14890,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]