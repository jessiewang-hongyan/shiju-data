[{"title":"酒泉子 离情","author":"尤侗","text":"月白风清。\n今夜谁家住去。\n过长亭，接短渡。\n傍孤城。\n知君马上听鸡鸣。\n妾也朝朝早起。\n剔残灯，空庭里。\n拜三星。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":115,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇 其一 绿荫","author":"尤侗","text":"梦破帘开，隔墙谡谡风声乱。\n徘徊池畔。\n绿影浮波面。\n闭鸟藏花，收拾春光暗。\n遮不遍。\n新愁一段。\n缭绕天涯散。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":116,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇 其二 杨花","author":"尤侗","text":"新绿排衙。\n问伊何事轻妆卸。\n夭斜顽耍。\n惹得黄鹂骂。\n无主东风，来去随他罢。\n怜今夜。\n落红偷嫁。\n同宿雕栏下。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":117,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇 其三 秋海棠","author":"尤侗","text":"空谷佳人，淡红衫子天然艳。\n风清露浅。\n脉脉凝啼眼。\n恰似伤秋，倚徙湖山遍。\n怜谁伴。\n重帘不捲。\n有个人肠断。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":118,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇 其四 玉簪花","author":"尤侗","text":"梦草凄凉，汉宫遗下搔头玉。\n淡妆素束。\n一顾倾红绿。\n清露晨流，仿佛香盈掬。\n娱幽独。\n广寒留宿。\n疑舞霓裳曲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":119,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春光好 春闺","author":"尤侗","text":"掩绣阁，镜台封。\n鬓云松。\n聊聊私语小窗中。\n骂春风。\n整日恹恹沉睡，侍儿问怎朦胧。\n却是背人偷揾泪，枕痕红。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":120,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"女冠子 美人走马","author":"尤侗","text":"青楼年少，走马章台驰道。\n倚逍遥。\n急雨桃花滚，轻风燕子骄。\n春芽拥翠髻，香汗发红潮。\n辔儿跑不住，抱鞍桥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":121,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 其一 春闺","author":"尤侗","text":"日影笼烟小阁明，侍儿初掠晓妆成。\n画楼何处又歌声。\n故掩珠帘惊燕燕，戏抛红豆打莺莺。\n晚来独傍落花行。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":122,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 其二 美人醉","author":"尤侗","text":"小盏低斟不当差，粉腮红晕早堆霞。\n春风带雨颤桃花。\n强对檀郎妆挣挫，慢扶小玉露夭斜。\n和衣睡倒太娇些。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":123,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 其三 马上见","author":"尤侗","text":"胜裤新裁蝉翼纱，锦靿自织凤头靴。\n春风不耐碧油车。\n金步摇飞金勒动，玉跳脱袅玉鞭斜。\n满堤青草衬红霞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":124,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 有客为王校书索赠漫题二阕其字浣若为调浣溪纱其名西也以西字为韵 其四","author":"尤侗","text":"闻道王娘旧姓西，采莲重出若耶溪。\n淡妆羞学捧心啼。\n春水锦帆娇白纻，秋风香径印红泥。\n昵郎子夜醉乌栖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":125,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 有客为王校书索赠漫题二阕其字浣若为调浣溪纱其名西也以西字为韵 其五","author":"尤侗","text":"家住阊门西复西，凤凰桥上夜乌啼。\n绿杨巷曲画帘低。\n宛转腰身飞乳燕，聪明性格点灵犀。\n粉墙拂袖待留题。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":126,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 清明悼亡二首 其六","author":"尤侗","text":"陌上家家挂纸钱，东风客舍泪潸然。\n难携杯酒滴重泉。\n朱户几人同插柳，青山何事尚含烟。\n江南梦绕断肠天。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":127,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 清明悼亡二首 其七","author":"尤侗","text":"少女长安歌踏春，鸾靴翠袜已成尘。\n棠梨时候独沾巾。\n宫草几年堆燕冢，土花终夜照鱼灯。\n君王犹自望昭陵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":128,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 其八 题陈其年小影","author":"尤侗","text":"侧帽轻衫古意多，乌丝襕写懊侬歌。\n红儿解唱定风波。\n翠管吟残浇一斗，玉箫吹破敛双蛾。\n酒阑曲罢奈髯何。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":129,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"伊川令 和范夫人韵","author":"尤侗","text":"空房夜夜垂罗幕。\n雁柱抛弦索。\n又报海棠零落。\n香径欲行还却。\n红腮枕上羞托。\n知郎春梦绕天涯，不肯到、秋千院落。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":130,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 春愁二首 其一","author":"尤侗","text":"鹦哥啄碎花须落，晓风低弄秋千索。\n刚上一重楼，青山又送愁。\n几番寒食雨，柳絮依人舞。\n春梦晚归家，小池闻暮蛙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":131,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 春愁二首 其二","author":"尤侗","text":"春风婀娜飘帘幕，玉钩踏破花阴薄。\n绿柳旧长堤，王孙骄马嘶。\n误听新燕语，倚遍栏杆午。\n权把泪痕收，东君不解愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":132,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 其三 听雨","author":"尤侗","text":"雨声碎滴琅玕竹，风声轻戛珊瑚玉。\n月影又模糊，和烟上鹧鸪。\n湿萤游古屋，蟋蟀悲秋菊。\n罗帐蕙香残，幽人晓梦寒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":133,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 无题八首 其四","author":"尤侗","text":"画帘捲断珊瑚索，绣床小梦随风落。\n残月杏花堤，晓莺恰恰啼。\n美人和笑立，露叶牵衣湿。\n待得侍儿来，妆奁一半开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":134,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 无题八首 其五","author":"尤侗","text":"乌衣双燕穿帘舞，衔花故坠金钗股。\n陌上柳丝飞，锦屏人未归。\n小窗沉昼闭，山枕留香睡。\n春梦杳如烟，知他向那边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":135,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 无题八首 其六","author":"尤侗","text":"竹鸠唤起斜阳梦，杨花倒挂金泥凤。\n独自摘青梅，鞋弓印翠苔。\n罗衫薄不绾，衬得东风软。\n一捻小香脂，无端蜂蝶知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":136,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 无题八首 其七","author":"尤侗","text":"花台日暮莺辞去，暖风吹散胭脂雨。\n春困晚梳头，珠帘不上钩。\n乱红随地扫，又见宜男草。\n半醉倚残妆，花间待阮郎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":137,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 无题八首 其八","author":"尤侗","text":"梨花带雨飘香雪，乱蛙啼出西窗月。\n庭砌绿阴浓，罗衣惹暮风。\n画梁新燕乳，宿梦呢喃语。\n唤我掩湘帘，夜深清露寒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":138,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 无题八首 其九","author":"尤侗","text":"香兰笑向银屏吐，小蛮起作回风舞。\n日静绿纱空，美人春梦中。\n箫声吹月白，柳带笼烟碧。\n芳草满江南，相思一夜深。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":139,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 无题八首 其十","author":"尤侗","text":"疏风细雨和春语，扁舟欲载花魂去。\n燕子不归家，盼他午日斜。\n落红一晌颤，界破残妆面。\n收拾护花铃，鹦哥报压惊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":140,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 无题八首 其十一","author":"尤侗","text":"马蹄踏遍天涯草，杜鹃啼破东风小。\n花落碧栏桥，翠楼红袖招。\n断香随路宿，懊恼枝头绿。\n春去不须留，担他一段愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":141,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 其十二 午日","author":"尤侗","text":"彩线斜袅金跳脱，篆符戏绾同心结。\n酌酒劝檀郎，蒲花衬口香。\n兰汤初罢浴，窗外调雊?。\n刚抹守宫斑，明朝点点残。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":142,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 夏闺二首 其十三","author":"尤侗","text":"一阶芳草茸茸绿，乱飞蛱蝶无人扑。\n欲摘小蔷薇，嫌他棘刺衣。\n昼长停绣谱，私共双鬟语。\n心怯越梅酸，只将纤手抟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":143,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 夏闺二首 其十四","author":"尤侗","text":"锦葵花底弹棋坐，一帘明月留人卧。\n粉汗湿红襕，倩郎摇素纨。\n云鬟胡乱挽，罗帐金钩捲。\n笑掷竹夫人，无端一面嗔。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":144,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 其十五 月夜","author":"尤侗","text":"远山新吐蛾眉月，半钩飞入梧桐叶。\n刚得照妆台，昵人脱燕钗。\n风吹裙带急，花下凭肩立。\n细数旧时欢，低头屈指尖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":145,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 其十六 冬闺","author":"尤侗","text":"翠钿尽卸香云绿，红衫松扣纤纤玉。\n旖旎揭罗帷，移灯匿笑时。\n闭门霜月去，不减春宵味。\n炉火酿馀烟，氤氲初睡还。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":146,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 丁巳九月病中有感八首 其十七","author":"尤侗","text":"曲江芳草年年碧，郎君骑马胭脂色。\n白首苦低垂，花间扶杖归。\n逢场曾作戏，乔扮参军势。\n浓笑写官衔，排行无二三。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":147,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 丁巳九月病中有感八首 其十八","author":"尤侗","text":"六宫闹扫芙蓉镜，君王偶爱飞蓬鬓。\n殿脚惜空同，昭阳天几重。\n江南春雨晚，红豆新歌满。\n流落杜秋娘，琵琶忆上皇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":148,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 丁巳九月病中有感八首 其十九","author":"尤侗","text":"少年悔读高唐赋，片云片雨无寻处。\n欲买美人图，吴宫香粉无。\n三山青鸟断，萼绿何时见。\n夜梦是耶非，玉钗金缕衣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":149,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 丁巳九月病中有感八首 其二十","author":"尤侗","text":"平生脱手千金剑，衣鹑马狗今谁盼。\n负负复何言，饥来难叩门。\n白衣应送酒，凝望终无有。\n不见夜飞蝉，山妻剧可怜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":150,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 丁巳九月病中有感八首 其二十一","author":"尤侗","text":"关山戎马惊鼙鼓，军书百道征徭苦。\n风急雁哀叫，荒田寸草无。\n千家闻野哭，鬼火逃亡屋。\n叹息返柴庐，当门立吏胥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":151,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 丁巳九月病中有感八首 其二十二","author":"尤侗","text":"短衣匹马卢龙道，冰霜千里催人老。\n白发影婆娑，秋风鬼病多。\n苦寒还苦热，飞梦惊明灭。\n何物返魂丹，空囊无一钱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":152,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 丁巳九月病中有感八首 其二十三","author":"尤侗","text":"白云冉冉苍梧下，晓猿夜鹤依茅舍。\n此地岂蓬壶，梦游疑有无。\n一生几两屐，愿作山中客。\n只乏买山钱，桃源不在天。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":153,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 丁巳九月病中有感八首 其二十四","author":"尤侗","text":"著书自苦徒为尔，千秋万岁谁传此。\n前后两茫茫，三生人断肠。\n黄金空铸错，彩线难缝络。\n何处度余年，除非离恨天。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":154,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"三叠泉","author":"方以智","text":"三峡巴江似直流，叠溪屏障几曾收。\n冰绡剪破裁云幔，银汉倾斜作玉沟。\n画角鼓声催急雨，阳关笛曲送深秋。\n谁将折笔图成后，可挂松风最上楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":155,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"独往","author":"方以智","text":"同伴都分毛，麻鞋独入林。\n一年五变姓，十字九椎心。\n听惯干戈信，愁因风雨深。\n死生容易事，所痛为知音！","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":156,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"别思","author":"吴静婉","text":"西崦雨未收，东崦风又作。\n留住绿蓑衣，莫与篙师著。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":157,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"岳王坟","author":"张岱","text":"西泠烟雨岳王宫，鬼气阴森碧树丛。\n函谷金人长堕泪，昭陵石马自嘶风。\n半天雷电金牌冷，一族风波夜壑红。\n泥塑岳侯铁铸桧，只令千载骂奸雄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":158,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"玛瑙寺长鸣钟","author":"张岱","text":"女娲炼石如炼铜，铸出梵王千斛钟。\n仆夫泉清洗刷早，半是顽铜半玛瑙。\n锤金琢玉昆吾刀，盘旋钟纽走蒲牢。\n十万八千《法华》字，《金刚般若》居其次。\n贝叶灵文满背腹，一声撞破莲花狱。\n万鬼桁杨暂脱离，不愁漏尽啼荒鸡。\n昼夜百刻三千杵，菩萨慈悲泪如雨。\n森罗殿前免刑戮，恶鬼狰狞齐退役。\n一击渊渊大地惊，青莲字字有潮音。\n特为众生解冤结，共听毗庐广长舌。\n敢言佛说尽荒唐，劳我阇黎日夜忙。\n安得成汤开一面，吉网罗钳都不见。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":159,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"夜奔","author":"李开先","text":"登高欲穷千里目，愁云低锁衡阳路。\n鱼书不至雁无凭，几番空作悲愁赋。\n回首西山月又斜，天涯孤客真难渡。\n丈夫有泪不轻弹，只因未到伤心处。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":160,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 扬州怀古二首 其二十五","author":"尤侗","text":"阿嫲曾梦江都好，迷楼一炬空荒草。\n何处教吹箫，凄凉廿四桥。\n西风吹客舍，落叶隋堤下。\n谁唱望江南，惟闻昔昔盐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":161,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 扬州怀古二首 其二十六","author":"尤侗","text":"青楼小杜扬州梦，纱灯万点觥船弄。\n书记纵才高，怜才思太牢。\n途穷悲逆旅，一饭今谁主。\n翠袖薄寒时，却吟老杜诗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":162,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 其二十七 佳人集曲名","author":"尤侗","text":"步摇颗颗珠环小，裙拖滴滴金泥巧。\n早起傍妆台，笑兜红绣鞋。\n名香罗带染，碧玉钩帘捲。\n度曲喜双声，呼郎并合笙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":163,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"江城子 村居","author":"沈泓","text":"长堤细柳隐虹桥，弄笙箫，伴渔樵。\n醉倚枫林、仰面挂诗瓢。\n释卷正逢秋水涨，临古渡，放轻舠。\n夕阳西下暗窗绡，雁声高，笛声遥。\n碧簟凉生、细雨燕辞巢。\n隔岸篝灯孤艇泊，沽浊酒，短扉敲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":164,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"复台","author":"郑成功","text":"开辟荆榛逐荷夷，十年始克复先基。\n田横尚有三千客，茹苦间关不忍离。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":165,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"北仙吕·一半儿","author":"尤侗","text":"清和天气晓寒余，客梦江干赋索居，风动琐□绿满除。\n漫摊书，一半儿斜阳一半儿雨。","collection":"明末清初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":166,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"胡蓝狱","author":"尤侗","text":"去年杀韩信，今年醢彭越。\n徐常幸前死，诸公宁望活？\n丞相戮，将军诛，觖望恣肆固有迹，坐以谋反疑有无，罪止及身或收孥。\n杀胡党，杀蓝党，数十万人保无枉，文武军民打一网。\n一斗粟，一座城，一条龙，一连鹰，革左塌回何纷纷，得非此辈之冤魂！","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":167,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"煮粥行","author":"尤侗","text":"去年散米数千人，今年煮粥才数百。\n去年领米有完衣，今年啜粥见皮骨。\n去年人壮今年老，去年人众今年少。\n爷娘饿死葬荒郊，妻儿卖去辽阳道。\n小人原有数亩田，前年尽被豪强圈。\n身与庄头为客作，里长尚索人丁钱。\n庄头水涝家亦苦，驱逐佣工出门户。\n今朝有粥且充饥，那得年年靠官府！\n商量欲向异方投，携男抱女充车牛。\n纵然跋步经千里，恐是逃人不肯收。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":168,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"旅夜闻寇","author":"方维仪","text":"蟋蟀吟秋户，凉风起暮山。\n衰年逢世乱，故国几时还？\n盗贼侵南甸，军书下北关。\n生民涂炭尽，积血染刀镮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":169,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 秋思回文二首 其二十八","author":"尤侗","text":"冷霜凝月摇空影，影空摇月凝霜冷。\n花落晚窗纱，纱窗晚落花。\n断肠人字雁，雁字人肠断。\n啼梦晓风西，西风晓梦啼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":170,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 秋思回文二首 其二十九","author":"尤侗","text":"一声啼雁铺沙白，白沙铺雁啼声一。\n孤枕夜凉初，初凉夜枕孤。\n捣砧和梦悄，悄梦和砧捣。\n愁客望高楼，楼高望客愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":171,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"巫山一段云 其一 贺侯大年新婚","author":"尤侗","text":"凤婿名萧史，珠娘号丽华。\n春风初长合昏花。\n门驻碧钿车。\n佳话玉如意，新妆香辟邪。\n红窗蜡烛小侯家。\n臂系汉宫纱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":172,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宣府逢立秋","author":"计东","text":"秋气吾所爱，边城太早寒。\n披裘三伏惯，拥被五更残。\n风自长城落，天连大漠宽。\n摩霄羡鹰隼，健翮尔飞抟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":173,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秦淮竹枝词","author":"纪映淮","text":"栖鸦流水点秋光，爱此萧疏树几行。\n不与行人绾离别，赋成谢女雪飞香。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":174,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"下相极东庵读同年北使时诗卷","author":"吴伟业","text":"兰若停骖洒墨成，过河持节事分明。\n上林飞雁无还表，头白山僧话子卿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":175,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"伍员","author":"吴伟业","text":"投金濑畔敢安居，覆楚亡吴数上书。\n手把蜀镂思往事，九原归去愧包胥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":176,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西子","author":"吴伟业","text":"霸越亡吴计已成，论功也合赏倾城。\n西施亦有弓藏惧，不独鸱夷变姓名。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":177,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]