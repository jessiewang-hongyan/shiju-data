[{"title":"和李子将秋吟二首 其一","author":"何巩道","text":"潮入高窗雨入灯，久抛双屐与孤藤。\n独游南海秋时别，却忆西樵雪里登。\n脱叶忽添林际月，断钟还忆水边僧。\n读书床在江楼畔，绿尽残苔知几层。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6047,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和李子将秋吟二首 其二","author":"何巩道","text":"偶向西风忆子期，此心惟有五弦知。\n谷闻人啸联相答，鱼觉潮声未免疑。\n阅尽红尘宁作我，歌残白雪总思伊。\n倦游归去秋村好，吟对枫林与菊枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6048,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送杨髯龙之楚二首 其一","author":"何巩道","text":"又是春风送客时，天涯芳草独临岐。\n三年诗思蛮乡老，千里归心楚水知。\n梦断分明闻晓角，酒醒依旧对残棋。\n江生有赋无劳读，海外魂销与别离。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6049,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送杨髯龙之楚二首 其二","author":"何巩道","text":"细雨阴阴暗郡城，东风吹急暮潮生。\n别非垂老偏多泪，归已无家复送行。\n一路峡猿哀旅梦，几船渔火照离情。\n武陵烟水容人住，为买湖田待耦耕。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6050,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"燕京怀古","author":"何巩道","text":"离离宫阙古消磨，十里黄云日入河。\n见雪渐怜南国远，闻笳方觉北人多。\n千金易致燕台骏，一去难听易水歌。\n惟有年年名利客，帝城头白尚蹉跎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6051,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咸阳怀古","author":"何巩道","text":"阴阴柳色乱啼鸦，三辅人烟落日斜。\n白帝难销天子气，青门空老故侯瓜。\n地形有险称天府，秦树无情锁汉家。\n渭水向东流不住，贾生高论至今嗟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6052,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"邺中怀古","author":"何巩道","text":"漳南望断客愁新，往事悠悠起战尘。\n地下奸雄无用处，别时歌舞可怜人。\n河声入梦俱成泪，草色生秋不计春。\n欲向西园访公子，夕阳黄叶落纷纷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6053,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"沛中怀古","author":"何巩道","text":"离离烟树夕阳红，立马徘徊识沛中。\n不见帝图阶尺土，但闻云气在高空。\n路边鸡犬知新市，地下韩彭泣大风。\n今日江山零落尽，酒徒犹自论英雄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6054,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"姑苏怀古","author":"何巩道","text":"青山犹绕阖闾城，百战苍茫草自生。\n三尺属镂忠愤尽，六千君子霸图倾。\n枫低湖岸先秋冷，月出宫墙隔水明。\n麋鹿相逢君莫叹，越台无限鹧鸪声。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6055,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"坐雨得月","author":"何巩道","text":"秋风江上城，残月雨中明。\n愧我青尊尽，教人白发生。\n湿灯摇草露，凉叶动虫声。\n共作天涯客，登楼正有情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6056,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"甘竹滩口占","author":"何巩道","text":"步月出滩上，夜归人语稀。\n竹风喧一巷，萤火候双扉。\n独赏兴逾远，冷吟声渐微。\n几时卧空谷，终日抱金徽。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6057,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"与诸子游罗浮","author":"何巩道","text":"又放轻帆泊晚沙，竹篱生笋柳生花。\n风吹蘋叶知潮上，烟出松门见日斜。\n屏外乞浆无杵臼，桥头包饭有胡麻。\n停舟不用淹歌舞，四海于今未一家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6058,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"与诸子游罗浮","author":"何巩道","text":"江上团团月欲生，山河形影两分明。\n举杯谁得千年在，浮海聊为一叶行。\n照水野花迷蝶梦，倚风修竹听蝉声。\n沧浪清浊无人辨，濯足歌残又濯缨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6059,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"对菊","author":"何巩道","text":"一秋心事与谁期，紫艳閒开九月枝。\n满地晓霜欹枕处，半帘疏雨倚栏时。\n萧条径冷长相慰，摇落情深各自悲。\n未及岁寒盟已早，入林休恨识君迟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6060,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过零丁洋怀宋文丞相","author":"何巩道","text":"漠漠寒烟返照时，文山当日此题诗。\n艰难早识谁无死，凭吊惟应我独悲。\n欲写遗篇投逝水，难寻游迹荐江蓠。\n亦曾惶恐滩头宿，一种风涛两处吹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6061,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"残夜坐海门望初日","author":"何巩道","text":"星痕灯色散平林，高坐松门向晓吟。\n银汉望穷千里目，金乌飞起五更心。\n山河有气光俱动，鱼鳖无灵影尽沉。\n一出扶桑天自白，不劳风雨洗凝阴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6062,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"斜东村道中忆查韬荒","author":"何巩道","text":"白日西斜水向东，斜东村路落花红。\n立当野岸迎初月，行傍幽篁爱晚风。\n谷响一声啼老鹳，潮平十里浸长虹。\n故人不见堪惆怅，葭菼苍苍在此中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6063,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟次虎门","author":"何巩道","text":"不待推篷已怆然，舟师云是虎头门。\n人烟灭尽看如梦，番舶相衔望似村。\n风雨急来吹大块，鱼龙横去动中原。\n浮萍一点飘无定，何处容人更托根。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6064,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送友","author":"何巩道","text":"不须长笑与悲歌，静处忘言意自多。\n往事渐伤人似梦，旧游空叹岁如梭。\n床头酒醒看红日，江上吟成对白波。\n忆尔少年曾入洛，归来先已泣铜驼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6065,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄杨髯龙","author":"何巩道","text":"君归曾说事躬耕，不渡潇湘又远行。\n陇亩亦知能税驾，江山犹觉易生情。\n千秋命世才堪赏，四塞为家地必争。\n欲问当年丞相府，乱离同是亚夫营。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6066,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄李东苑","author":"何巩道","text":"世路悠悠叹复悲，古今曾见几相如。\n独怜文采佳公子，不弃飘零老画师。\n心乱此时惟□酒，夜残何处尚围棋。\n披衣起立西窗月，正是寒灯雁叫时。","collection":"明末清初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6067,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"重过博城","author":"何巩道","text":"不断江声似旧时，村原寥落使人悲。\n当杯已失千家月，顾影惟多两鬓丝。\n秋木渐枯猿过小，寒潮初满鹤飞迟。\n西风未许孤帆借，空向虬髯送面吹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6068,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"老龙道中","author":"何巩道","text":"露寒犹着旧缁衣，无限秋心对夕晖。\n绿酒几家能醉客，青山何处不思归。\n鹰迎风势空中立，叶避霜威暗里飞。\n一触物情生浩叹，故园零落故人稀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6069,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"剑潭道中","author":"何巩道","text":"月照江潭渺渺来，清秋谁识客怀哀。\n远村深树藏渔火，废垒寒烟锁劫灰。\n富贵久摒身外物，才名何似掌中杯。\n解帆又是沉沉夜，难得流萤去复回。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6070,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟次新塘","author":"何巩道","text":"树知潮起渐生风，海上斜阳分外红。\n蚬艇一群围稚子，蔗田十亩住蓑翁。\n云边觅路山当岸，波底观心月在空。\n一日离家情已切，古人何事到辽东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6071,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"惠阳归舟","author":"何巩道","text":"声在秋林半是蝉，况逢沙岸夕阳天。\n閒身初谢吟诗债，长路谁分买酒钱。\n断梦忽惊千点雨，饥心空望几家烟。\n扁舟未遂鸱夷愿，归种苏秦二顷田。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6072,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"归至芙蓉沙","author":"何巩道","text":"舟路苍茫数里烟，风吹秋思晚凄然。\n十年故国人空老，一夜乡心月可怜。\n下濑船从波底起，临崖灯向树头悬。\n孤芦自古容鸥鹭，怪得哀吟到水边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6073,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"晚发二首 其一","author":"何巩道","text":"风急扁舟渡海门，归帆高逐晚鸦喧。\n雪痕满岸溪边月，叶罅藏灯树里村。\n故土举头行渐近，禁城回首梦偏繁。\n烛花空对雄心尽，世事浮沉谁与言。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6074,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"晚发二首 其二","author":"何巩道","text":"乱后门庭无觅处，空闻猿鸟叫斜阳。\n近池橘叶迎风绿，占石苔花染雪黄。\n昔日琴书分异地，频年衣食寄他乡。\n只今惟有寒村月，偏照愁人行处光。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6075,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"暮春归访西山呈华堂主人","author":"何巩道","text":"草堂西面女墙遮，一片松窗送晚霞。\n学道渐知归有路，看山休叹老无家。\n斜阳静对吟边鹤，浅水閒开饮处花。\n心恋石楼成独宿，满房寒瀑月初华。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6076,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"昼坐","author":"何巩道","text":"昼坐高斋初放晴，当门山色背南城。\n花飞苔径日千点，蝇打低窗时一声。\n病后客怀多寂寞，梦中人事最分明。\n十千买酒醒还醉，醒学灵均醉步兵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6077,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"连雨","author":"何巩道","text":"落花飞不起，日日怨春寒。\n乱笋过墙易，饥烟出院难。\n醉频添白袷，愁半坐红栏。\n无限溪边水，谁人持钓竿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6078,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"江上别李祈年","author":"何巩道","text":"谷饮未终日，复为江海人。\n愁知芳草远，閒觉白鸥亲。\n独往听流水，馀生惜暮春。\n明朝衣上泪，同作别时新。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6079,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"□送王伯甫之山左省亲","author":"何巩道","text":"鹅湖公子旧乌衣，口吐虹文射紫微。\n十五诗篇登乐府，六千山水奉慈闱。\n岳含断雨天初合，地绕长河叶尽飞。\n未必相逢天下士，鲁连东海不曾归。","collection":"明末清初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6080,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠女史","author":"何巩道","text":"上清秋夕降真仙，月里霓裳曲尽传。\n电影入帘知一笑，柳痕遮殿惜三眠。\n书成招手呼青鸟，歌罢翻身入紫烟。\n不是人间能买笑，后园孤负落金钱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6081,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄谢将军","author":"何巩道","text":"别来常忆谢将军，武备文心两不群。\n地产一人钟岳渎，天生双翼待风云。\n剑能流血浇诗笔，墨欲飞花点战裙。\n勿向路傍甘袖手，残棋零乱野丝纷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6082,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"上金鸿胪","author":"何巩道","text":"佩笔从王三十年，功成原不亚凌烟。\n久从雅尚思林下，忽领崇班近日边。\n景略任专兼内外，穆之心巧画方圆。\n何难更绾通侯印，只羡西湖一叶船。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6083,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日寄苍梧隐居","author":"何巩道","text":"故人千里梦悠悠，落叶寒砧两处秋。\n旧里江山空寂寞，旅途风雪莫淹留。\n鸡声枕上收残月，海气窗前动远舟。\n闻道邻人解吹笛，山阳哀调不胜愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6084,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日过马少府署中访吴门胡玉心留酌分赋","author":"何巩道","text":"凉秋偏得坐春风，鼎足高谈各自雄。\n小试渐知成美锦，大烹何意及雕虫。\n窗开晚霭光添绿，杯对斜阳色借红。\n醉却座中吴市客，独将残恨唱江东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6085,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"病后得杨髯龙书却寄","author":"何巩道","text":"离乱交游散似云，武陵犹有故将军。\n书从白雁来千里，人比黄花瘦十分。\n粤海波涛寒处起，楚天风雨梦中闻。\n廿年乞食同怜病，一捻吴箫便忆君。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6086,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠苗将军二首 其一","author":"何巩道","text":"六琯飞灰日欲昏，五羊长揖大将军。\n金戈旧著宁波烈，铜柱新标碣石勋。\n海畔捧泥封雉堞，阵前吹剑吐龙文。\n谈时好煮青梅酒，天下英雄共使君。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6087,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠苗将军二首 其二","author":"何巩道","text":"龙旗天半拥朱门，斗大金符上将军。\n独领一军雄海国，高悬双眼看中原。\n青萍尽敛江山气，白马长流汗血痕。\n若许布衣谈将略，满生饥虱向君扪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6088,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"夜坐","author":"何巩道","text":"雨里金波暗复明，风前银烛灭还生。\n升沉不定徒增感，倚伏无端更怆情。\n万马拥来江上响，双龙飞入斗边横。\n独怜深夜犹枯坐，侧耳楼钟报五更。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6089,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋情","author":"何巩道","text":"细雨江干悄自惊，旅途无限早秋情。\n非关食尽饥元亮，只为多愁渴马卿。\n吟罢老松飞宿鹤，灯残孤幕坠流萤。\n微名久被阴符误，且对青尊调酒兵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6090,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"酒徒","author":"何巩道","text":"高楼一相呼，三五罗其侧。\n但爱竹叶青，不问扶桑白。\n英雄无所成，老作高阳客。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6091,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"侠客","author":"何巩道","text":"仆本屠刀人，姓名动公子。\n疾视气成虹，翻身势如雨。\n七尺命易倾，一寸心难死。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6092,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋夜寄黄龙山","author":"何巩道","text":"雨来何处最凄清，飒飒芭蕉枕上声。\n薄醉有心怜夜半，微吟无计候天明。\n吹开树色鸦争起，露出波光月忽生。\n莫怪所思惆怅久，难忘从古是交情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6093,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"夏日湖上口占二首 其一","author":"何巩道","text":"尽日阴阴湖水清，爱閒惟有看山情。\n晚来更踏无人径，静听新蝉雨后声。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6094,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"夏日湖上口占二首 其二","author":"何巩道","text":"猎猎西风吹海天，一群沙鸟逐渔船。\n浮生无限江山泪，何处逢人乞酒钱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6095,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹤顶花","author":"何巩道","text":"日午轻妆着雨新，隔帘红袖不成春。\n凭君莫作辽东鹤，一点丹沙愁杀人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6096,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"虞美人花","author":"何巩道","text":"一点嫣然出绿苔，泪痕疑听楚歌来。\n汉家宫阙生秋草，惟有美人花自开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6097,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"杜鹃花","author":"何巩道","text":"泪血盈盈欲寄谁，一山红雨向人吹。\n乡心正在花开日，莫更三更听子规。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6098,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"汉祖","author":"何巩道","text":"隆准峨峨徒步起，双手纵横秦鹿死。\n独有金戈据海滨，云是青州贵公子。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6099,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"项王","author":"何巩道","text":"同是当年角立人，一朝谁肯分臣主。\n英雄热血本难磨，重瞳不渡乌江水。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6100,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"砚池","author":"何巩道","text":"砚边点笔水涵清，宿墨留痕欲化冰。\n更有胆瓶花片落，残红飞上几多层。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6101,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"笔","author":"何巩道","text":"江郎开罢梦中花，又向高天吐紫霞。\n记得木兰僧院日，微吟题在碧窗纱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6102,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"墨","author":"何巩道","text":"玉烟松火夜来多，鍊得玄冰价几何。\n若使一身能利物，从今顶踵任消磨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6103,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题杏花纱灯二首 其一","author":"何巩道","text":"青春花放出墙枝，半幅轻绡欲写迟。\n旧梦未残犹忆得，暮城疏雨走斑骓。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6104,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题杏花纱灯二首 其二","author":"何巩道","text":"曲江春宴罢题诗，吟向斜阳半醉时。\n误染深红颜色老，只缘人世重胭脂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6105,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"感事四首 其一","author":"何巩道","text":"滟潋波生不待风，路难真与上天同。\n吞声到处英雄血，滴入江东秽史中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6106,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"感事四首 其二","author":"何巩道","text":"愁对青山调酒兵，江天无定是阴晴。\n谁人传到陈琳檄，不觉头风已渐平。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6107,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"感事四首 其三","author":"何巩道","text":"野火无光佛火红，高斋不语四山空。\n门非剥啄时闻响，黄耳原来解吐风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6108,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"感事四首 其四","author":"何巩道","text":"勋名几度镜中看，未老犹能把剑弹。\n待向西秦相见日，故人方念范生寒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6109,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"种药","author":"何巩道","text":"未老当为多病人，南园十亩寄閒身。\n药苗乞得殷勤种，莫遣愁催白发新。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6110,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"种菜","author":"何巩道","text":"行尽清溪到敝庐，绕篱黄蝶半畦蔬。\n频年学圃休相笑，千古英雄亦荷锄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":6111,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]