[{"title":"鹧鸪","author":"屈大均","text":"不戏新梅岭上烟，对啼偏向酒杯前。\n三春悔作江南客，万里愁当落日天。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14083,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"闺人寄远曲","author":"屈大均","text":"鹣鹣一赤一青衣，比翼多年在翠微。\n南海有禽皆不北，如何夫婿不归飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14084,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"放鹧鸪词","author":"屈大均","text":"白马雕鞍日日行，闺中不管绿苔生。\n殷勤放尔鹧鸪去，去到郎前啼几声。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14085,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"捕蟹辞 其一","author":"屈大均","text":"捕蟹三沙与四沙，秋来乐事在渔家。\n随潮上下茭塘海，艇子归时月欲斜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14086,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"捕蟹辞 其二","author":"屈大均","text":"紫蟹迎潮复送潮，纷纷衔穗上兰桡。\n蟹黄应月秋逾美，乱掷金钱向市桥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14087,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"捕蟹辞 其三","author":"屈大均","text":"匡螯初蜕及秋肥，母蟹膏多肉蟹稀。\n饱食沙田霜降稻，潮乾拾得满船归。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14088,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"捕蟹辞 其四","author":"屈大均","text":"虎门潮水接牂牁，春淡秋咸蟹总多。\n水肉金膏随月满，精华更奈稻花何。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14089,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"捕蟹辞 其五","author":"屈大均","text":"扶胥多蟹况霜天，不独河豚甲海鲜。\n春蜕何如秋蜕好，拾来螯跪软于绵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14090,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"捕蟹辞 其六","author":"屈大均","text":"雪螺霜蟹总甘香，璅?羹清味更长。\n家在郁江多海错，平生不愧打鱼郎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14091,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"打蚝歌 其一","author":"屈大均","text":"一岁蚝田两种蚝，蚝田片片在波涛。\n蚝生每每因阳火，相叠成山十丈高。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14092,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"打蚝歌 其二","author":"屈大均","text":"冬月珍珠蚝更多，渔姑争唱打蚝歌。\n纷纷龙穴洲边去，半湿云鬟在白波。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14093,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"陈村口号 其一","author":"屈大均","text":"龙眼离支十万株，清溪几道绕菰蒲。\n浙东酿酒人争至，此水皆言似鉴湖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14094,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"陈村口号 其二","author":"屈大均","text":"渔舟曲折只穿花，溪上人多种树家。\n风土更饶南北估，荔支龙眼致豪华。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14095,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"陈村口号 其三","author":"屈大均","text":"场师往往出陈村，多种名花与子孙。\n买取芬芳三十本，带泥归植白华园。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14096,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"陈村口号 其四","author":"屈大均","text":"十里溪边夹水松，竹深花密海云封。\n人家尽在园林里，长短飞桥处处逢。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14097,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"陈村口号 其五","author":"屈大均","text":"花气如烟咫尺迷，诗人复在浣花溪。\n崙山子建名双著，后起风流欲与齐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14098,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠单翁 其一","author":"屈大均","text":"为家只爱在陈村，溪水潆洄绿绕门。\n绝似鉴湖西一曲，酿成花露醉无言。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14099,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠单翁 其二","author":"屈大均","text":"子侄相将作酒家，高头豆酒胜流霞。\n酿师远自山阴至，此水争言似若耶。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14100,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠单翁 其三","author":"屈大均","text":"此水天生作酒泉，翁来更在浙人先。\n人间致富无如酒，酿法殷勤向我传。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14101,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠单翁 其四","author":"屈大均","text":"陈村果木多龙眼，一一花头饱露华。\n翁欲酒香还有法，春时兼与荔支花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14102,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠单翁 其五","author":"屈大均","text":"陈村只在海云西，山水何曾让会稽。\n太白只今逢纪叟，閒来一任老春迷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14103,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠单翁 其六","author":"屈大均","text":"四皓当年似尔无，朱颜白发拥罗敷。\n风流定得浮丘术，九十还能育凤雏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14104,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠单翁 其七","author":"屈大均","text":"已得长生赖酒杯，素书时为少年开。\n老人岂必鹰扬去，令子行当虎步来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14105,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南海祠作","author":"屈大均","text":"衡岳精灵满粤中，朱明洞府总相通。\n天教火帝司南海，万古扶胥祀祝融。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14106,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄查韬荒","author":"屈大均","text":"为客相传在豫章，雷轰诸葛读书床。\n高人岂可驯龙性，归卧林丘策最长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14107,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄岑金纪 其一","author":"屈大均","text":"谈兵曾向岳阳楼，自谓书生胜虎头。\n归卧故山怜海目，鱼花春截大江流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14108,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄岑金纪 其二","author":"屈大均","text":"亦作池塘学养鱼，青青桑叶映蓬庐。\n何须老母哀长剑，自有真人识素书。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14109,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"天涯","author":"屈大均","text":"天涯萧瑟又逢秋，不待霜飞已白头。\n明月何曾知客恨，黄花只是笑人愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14110,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题席允叔册子","author":"屈大均","text":"三闾苗裔有诗篇，哀怨千秋莫与传。\n行尽江南与江北，知音人在竹林边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14111,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题江丈小影","author":"屈大均","text":"高柳垂垂拂晓空，愁心多半与天风。\n羲皇以上何曾没，总在先生梦寐中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14112,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠旧令楼君 其一","author":"屈大均","text":"黄花一丈似君长，十月炎天未著霜。\n彭泽篱边那有此，掇英频泛酒杯香。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14113,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠旧令楼君 其二","author":"屈大均","text":"湘湖空忆紫莼时，一笑江山似奕棋。\n种秫未收频解组，流溪父老至今思。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14114,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠某弁新婚 其一","author":"屈大均","text":"此日佳人宜换马，而君偏惹丽华来。\n燕裙赵带从军乐，不念闺中长绿苔。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14115,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠某弁新婚 其二","author":"屈大均","text":"髯美偏宜红袖拂，身轻要共紫骝驰。\n早随公主持犀杖，莫使将军恋玉姿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14116,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题叶氏山房","author":"屈大均","text":"城外青山千万重，城中独有一芙蓉。\n君家正在芙蓉上，一片楼台云气浓。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14117,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和人黄山杂吟","author":"屈大均","text":"千峰云起白龙潭，玉乳泠泠滴翠岩。\n斜倚瑶琴盘石上，卧看秋月出松杉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14118,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"姑苏杨柳枝词 其一","author":"屈大均","text":"姑苏台畔卧经春，歌管凄凉忆美人。\n杨柳无情飞絮乱，可怜如雪亦成尘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14119,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"姑苏杨柳枝词 其二","author":"屈大均","text":"水绿山青一片愁，销沉玉槛与铜沟。\n生憎茂苑多杨柳，长使行人系紫骝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14120,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"姑苏杨柳枝词 其三","author":"屈大均","text":"家家垂柳系相思，况复吴侬唱竹枝。\n未曙啼乌肠已断，行人难待月斜时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14121,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"姑苏杨柳枝词 其四","author":"屈大均","text":"长条阿那不牵人，一任花飞送好春。\n未化浮萍犹是雪，宫莺衔过锦帆津。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14122,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"姑苏杨柳枝词 其五","author":"屈大均","text":"美人香水尚留溪，溪畔桃花亦姓西。\n无限风流与杨柳，千条万缕任乌栖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14123,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"姑苏杨柳枝词 其六","author":"屈大均","text":"露咽烟啼总不明，飞花如送复如迎。\n长条不忍轻攀折，为尔临风最有情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14124,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"姑苏杨柳枝词 其七","author":"屈大均","text":"嫩叶柔条一夜长，啼莺催客到吴阊。\n千千金缕多情甚，欲为愁人绩断肠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14125,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"姑苏杨柳枝词 其八","author":"屈大均","text":"四百桥边茂苑东，纤腰舞杀为春风。\n吴娘一一娇莺似，生长游丝落絮中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14126,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"姑苏杨柳枝词 其九","author":"屈大均","text":"浅碧轻黄暖乍催，流莺各占一枝来。\n相思化作江南树，丝缕纷纷结不开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14127,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"姑苏杨柳枝词 其十","author":"屈大均","text":"金缕垂垂拂水流，梧宫花草不曾秋。\n蛾眉飞作天边月，长为君王照凤楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14128,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"峡山号子","author":"屈大均","text":"潮至胥江水渐微，峡门开处野猿归。\n空王亦爱禺阳好，飞寺而今更不飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14129,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送客","author":"屈大均","text":"春草方生瘴气微，子鹃催客不如归。\n渔舟但向桃花入，莫问仙源是与非。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14130,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题袁彊名画 其一","author":"屈大均","text":"墨气空濛化水烟，春光犹湿半晴天。\n生机笔下知多少，流出真如石上泉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14131,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题袁彊名画 其二","author":"屈大均","text":"瀑水长悬纸上声，松烟浮动日微明。\n疏帘欲捲愁风雨，独拥春寒寐不成。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14132,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"勿上人将乞荔支斋僧为说偈以达其意","author":"屈大均","text":"岭南珍果是离支，乞作伊蒲供导师。\n龙象能知琼液味，餐时即是报恩时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14133,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"怀李生哺园","author":"屈大均","text":"之子娱亲有一园，竹花桐实绕芳萱。\n白门多少慈乌鸟，反哺如君更不言。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14134,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春望","author":"屈大均","text":"烟雨催春春欲归，荒城最少是芳菲。\n生憎浦口多鸿雁，食尽芦花未北飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14135,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"怀灏灵楼 其一","author":"屈大均","text":"云边长忆灏灵楼，峰似莲花朵朵浮。\n玉井上通东井宿，天河下接浊河流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14136,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"怀灏灵楼 其二","author":"屈大均","text":"高高仙掌正当楼，云际双垂白帝旒。\n汉柏唐松苍翠甚，不须烟雨已成秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14137,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"怀灏灵楼 其三","author":"屈大均","text":"春赛人多向岳宫，纷纷鸡鞠是秦风。\n楼中白帝筝琶绕，妓女边妆队队同。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14138,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过弼唐精舍有怀亡友英上","author":"屈大均","text":"兰若初开水竹边，故人多半此栖禅。\n蜉蝣最是英居士，欲学无生未有年。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14139,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"柬罗颢甫","author":"屈大均","text":"白首为儒尚未醇，斯文菽粟更何人。\n紫阳羽翼期吾友，及此林泉自在身。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14140,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"观象作","author":"屈大均","text":"劝汝长星酒一杯，何劳空指白龙堆。\n乾坤自合归沙漠，日月从教在草莱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14141,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"沙亭漫兴 其一","author":"屈大均","text":"先公留得宋时村，乔木家家影在门。\n一水曲从江口入，人言风景似湘沅。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14142,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"沙亭漫兴 其二","author":"屈大均","text":"村南村北一溪分，咫尺桥梁隔暮云。\n鸡犬无声人寂寂，羲皇一枕至斜曛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14143,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"沙亭漫兴 其三","author":"屈大均","text":"丈人伛偻八旬馀，口授诸孙不用书。\n为爱榕阴风日好，移樽相与脍黄鱼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14144,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"沙亭漫兴 其四","author":"屈大均","text":"蕉向心中抽叶叶，凌朝露重苦低垂。\n深秋子熟香甜甚，持作酥醪不用炊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14145,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"沙亭漫兴 其五","author":"屈大均","text":"风寒落叶易成悲，叶叶秋来亦有思。\n萧瑟最愁蝉响外，一声先与梦魂知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14146,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"溪上 其一","author":"屈大均","text":"烟波一片静含空，雨过渔梁处处通。\n明月有声声在水，涓涓流入玉琴中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14147,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"溪上 其二","author":"屈大均","text":"微微木叶点涟漪，潮去潮来白鹭知。\n鱼食秋光浮出水，竿头不用系长丝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14148,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"溪上 其三","author":"屈大均","text":"流尽愁心是此溪，新生秋水与桥齐。\n牛羊争道过清浅，枫叶芦花踏作泥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14149,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"初秋","author":"屈大均","text":"八月天风始作秋，松声吹得一山浮。\n寒随片雨来空外，萧飒将含一片愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14150,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自题易叶轩 其一","author":"屈大均","text":"叶叶霜红写几秋，微言多为古人留。\n画前岂有庖牺易，一片天心似水流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14151,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自题易叶轩 其二","author":"屈大均","text":"虫书叶叶是河图，画卦当年得见无。\n花绝无言吾亦尔，馨香吹出一林孤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14152,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自题易叶轩 其三","author":"屈大均","text":"一庭梧竹最宜秋，蕉叶新书雨不流。\n人是羲皇高枕外，黄花亦为义熙留。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14153,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自题易叶轩 其四","author":"屈大均","text":"几树蝉声慰寂寥，无人风叶自萧萧。\n日长观化无馀事，周蝶何知又一朝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14154,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自题易叶轩 其五","author":"屈大均","text":"九卦先生忧患馀，年衰一倍惜居诸。\n思求易史莲须阁，表里春秋作一书。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14155,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"步出一天门北望白云山色作 其一","author":"屈大均","text":"山翠阴阴欲变霞，水帘开处有人家。\n生憎洞口菖蒲水，片片随流是落花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14156,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"步出一天门北望白云山色作 其二","author":"屈大均","text":"谷口烟深昼不开，松声捲起鹤舒台。\n风吹瀑布时时断，飞作晴川数道来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14157,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]