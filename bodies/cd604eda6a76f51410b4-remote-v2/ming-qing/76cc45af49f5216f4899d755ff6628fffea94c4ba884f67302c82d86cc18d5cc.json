[{"title":"从军行 其三","author":"屈大均","text":"精兵扼虎五千多，后距何烦路伏波。\n龙勒秋来觇敌去，黄门骑吹杂铙歌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13346,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从军行 其四","author":"屈大均","text":"阴山风雪暮纷纷，独出旌门望卤群。\n天子深恩怜浞野，重将血汗洒边云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13347,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从军行 其五","author":"屈大均","text":"香貂宝马猎天山，塞女酡酥捧未閒。\n长与丁零俱用事，汉臣无计赠刀环。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13348,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"偶忆太华醉中作 其一","author":"屈大均","text":"太华峰边有醉溪，醴泉更在玉泉西。\n酿泉作得松花酒，山女教人醉似泥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13349,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"偶忆太华醉中作 其二","author":"屈大均","text":"醉度苍龙岭似飞，羽人争揽紫霞衣。\n生憎瀑布三千丈，遮却天边白玉妃。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13350,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"北狩辞 其一","author":"屈大均","text":"虎斗笼争寂不闻，銮舆频别靖南军。\n长安旧帝无人识，空有阏氏拜彩云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13351,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"北狩辞 其二","author":"屈大均","text":"沙冷秋高战马閒，蕃儿千队锦衣还。\n江南天子单于客，竞献酡酥毳帐间。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13352,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春日雨花台眺望有感 其一","author":"屈大均","text":"烟云霏霏碧草齐，断肠春在孝陵西。\n松楸折尽寒山露，无处堪容杜宇啼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13353,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春日雨花台眺望有感 其二","author":"屈大均","text":"高台一上一含悲，况复清明上巳时。\n多谢朝烟兼暮雨，不令人见蒋山姿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13354,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春日雨花台眺望有感 其三","author":"屈大均","text":"二陵寒食雨连天，禾黍荒凉复几年。\n愁绝江南空骋望，君臣犹隔九疑烟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13355,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春日雨花台眺望有感 其四","author":"屈大均","text":"春去风花飞更狂，马蹄无主踏残香。\n丝丝最恨河边柳，日夕牵愁短复长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13356,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春日雨花台眺望有感 其五","author":"屈大均","text":"朱雀门前花草空，明驼尽载景阳宫。\n六朝春色龙沙去，一片江南雁塞同。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13357,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"焦山作","author":"屈大均","text":"浮玉山中浮玉春，醉来忘却华阳巾。\n天风吹上雷轰石，一夜啸声惊羽人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13358,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠东洞庭席翁","author":"屈大均","text":"四皓旧楼林屋洞，今君清啸莫釐峰。\n楼前七十二峰月，不及仙人冰雪容。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13359,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"沙河","author":"屈大均","text":"沙河双绕巩华城，一道飞桥接帝京。\n往日君王上陵寝，红旗翠辇此中行。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13360,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"河阴戏赠老将","author":"屈大均","text":"高柳城边折柳多，送君千里渡榆河。\n美人骏马平生物，欲赠其如白发何。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13361,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"代黔中苦雨曲 其一","author":"屈大均","text":"黔中多雨少人行，尽道天无三日晴。\n千里茫茫烟务海，雨师偏好贵阳城。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13362,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"代黔中苦雨曲 其二","author":"屈大均","text":"千叠峰峦万叠岚，奔腾不断至安南。\n雨从山下朝朝起，山上晴多见玉簪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13363,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"代黔中苦雨曲 其三","author":"屈大均","text":"攀花日日出江潭，泪落他乡酒半酣。\n杜宇多啼偏向北，鹧鸪有志但怀南。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13364,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"入蜀行 其一","author":"屈大均","text":"荆门西上即瞿塘，一路猿声莫断肠。\n应有巫云化神女，朝朝暮暮慰思乡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13365,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"入蜀行 其二","author":"屈大均","text":"蜀道无如三峡难，猿声况复满诸滩。\n滩多峡少滩尤险，日日篙舟不及餐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13366,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"入蜀行 其三","author":"屈大均","text":"生竹青青作缆长，鼓声须急缆须强。\n将舟一折穿危石，滩滪堆边险莫当。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13367,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖上柬宋子 其一","author":"屈大均","text":"临风一啸作秋声，天籁何如人籁清。\n南郭先生休隐几，须知鸾鹤不胜情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13368,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖上柬宋子 其二","author":"屈大均","text":"谁驻兰桡海上洲，不将明月照人愁。\n一声风雨笙歌乱，始信仙人不下楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13369,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠宋元亨 其一","author":"屈大均","text":"旗门直入报仇还，孝子威神岂等閒。\n天马不惊樗里去，坐令追吏至深山。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13370,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠宋元亨 其二","author":"屈大均","text":"雄刀三载箾中鸣，报怨而今事已成。\n何必君思频见赦，千秋人识子崔名。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13371,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寿钱舍人母 其一","author":"屈大均","text":"舍人词赋擅西京，春日开筵五凤城。\n我有麻姑台上月，光华不减许飞琼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13372,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寿钱舍人母 其二","author":"屈大均","text":"月华特献太夫人，王母桃花莫与伦。\n散作朝霞与令子，文章丽似上林春。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13373,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"答郭皋旭","author":"屈大均","text":"知子云天义至高，相逢每念笔耕劳。\n养亲未有彫胡饭，惭愧山阴一顾翱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13374,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题惠阳叶氏园 其一","author":"屈大均","text":"江山战后日萧条，壮士闻笳惨不骄。\n兄弟登高犹九日，君臣失路已三朝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13375,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题惠阳叶氏园 其二","author":"屈大均","text":"门外双湖水合流，丰湖春似鳄湖秋。\n有时象岭烟霞散，隐隐空中二石楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13376,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题惠阳叶氏园 其三","author":"屈大均","text":"湖心亭子更风凉，山雨飞来若散霜。\n莲叶莲花争出水，不愁无处宿鸳鸯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13377,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题惠阳叶氏园 其四","author":"屈大均","text":"九月银鱼出水长，银鱼风起水泱泱。\n银瓶汲取姚坑水，来煮银鱼香复香。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13378,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题惠阳叶氏园 其五","author":"屈大均","text":"可惜江山今已非，先臣功业在金微。\n汉家祗有天山月，来照樽前旧锦衣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13379,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"张丽英","author":"屈大均","text":"不嫁吴王凤作群，山中偃卧发纷纷。\n冰纨照面如明月，石鼓歌声入紫云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13380,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"留别弄雏轩 其一","author":"屈大均","text":"新梳堕马可怜妆，独少秦珠耳后光。\n此去青莺池上买，归来明月照兰房。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13381,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"留别弄雏轩 其二","author":"屈大均","text":"雷阳纫葛杂银条，一著凉风生舞腰。\n应倩纤纤蛮女手，为卿织得比龙绡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13382,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"弄雏轩有赠 其一","author":"屈大均","text":"日斜花始渡江来，一到云鬟花尽开。\n博奕输卿花百串，将花结作素馨台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13383,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"弄雏轩有赠 其二","author":"屈大均","text":"学写曹娥未就时，閒来只爱弄花枝。\n何当结得樱桃子，不负春风作意吹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13384,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"弄雏轩有赠 其三","author":"屈大均","text":"牡丹新髻出维扬，衣带题春句有香。\n纤手把将团扇好，练巾携拭口脂长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13385,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"弄雏轩有赠 其四","author":"屈大均","text":"凌晨画就鸳鸯眉，纤手频来擘荔支。\n输与郎君三百颗，花前不肯再弹棋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13386,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠仙苮 其一","author":"屈大均","text":"越女年来多善书，钟王笔法学无馀。\n珠江郑卉年犹小，势得惊鸾总不如。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13387,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠仙苮 其二","author":"屈大均","text":"兼临画本作丹青，花鸟如生出素屏。\n前掩林良后张穆，天南绘事一娉婷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13388,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠仙苮 其三","author":"屈大均","text":"垂髫已作女棋师，玉子纵横落不迟。\n岑李近来称国手，岂知无敌在蛾眉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13389,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠仙苮 其四","author":"屈大均","text":"吾家闺阁有书生，夫婿为师学渐成。\n嗟尔聪明殊未遇，不知谁可教飞琼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13390,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送客上端州号子","author":"屈大均","text":"十月嘉鱼出穴来，随波东下至崧台。\n梧州寄酒冬尤美，莫惜天寒匹马回。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13391,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"逢查逸远","author":"屈大均","text":"家在沙场不忍回，他乡秋色老相催。\n忧心一片长如醉，不必貂衣换酒来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13392,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"桂林送远曲","author":"屈大均","text":"湘漓二水陇头分，一道飞流出白云。\n漓水不如湘水好，君行更为吊湘君。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13393,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"妆楼","author":"屈大均","text":"妆楼寂寞委苍苔，春到梨花不忍开。\n一片愁心乱如雪，东风吹去复吹来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13394,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"五蓝词","author":"屈大均","text":"垂垂腰下绣囊长，中有槟门花最香。\n一笑行人齐下骑，殷勤紫蟹与琼浆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13395,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鸳鸯","author":"屈大均","text":"鸳鸯相对已忘机，共命何曾要共飞。\n天女有花空自散，风吹不著净名衣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13396,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从人乞荔枝","author":"屈大均","text":"闻君荔子满棠溪，五月胭脂裹玉齐。\n欲向佳人分万颗，香随翠笼过桥西。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13397,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从弟某折并蒂石榴花簪予冠侧请作诗 其一","author":"屈大均","text":"枝枝露滴紫金盘，千叶葳蕤胜合欢。\n花萼同心兄弟似，殷勤簪向御风冠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13398,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从弟某折并蒂石榴花簪予冠侧请作诗 其二","author":"屈大均","text":"绿叶丹葩连理枝，折来偏与玉冠宜。\n迷花自是仙人事，周蝶逍遥两不知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13399,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"酬尹生贻木兰花 其一","author":"屈大均","text":"木兰枝上露瀼瀼，津液因之吸正阳。\n之子采花数相赠，为怜屈子爱芬芳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13400,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"酬尹生贻木兰花 其二","author":"屈大均","text":"屈子餐英自润泽，正阴精蕊在秋花。\n不如朱夏木兰好，与尔凌朝饮露华。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13401,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"荡舟海目山下捕鲥鱼为鲙 其一","author":"屈大均","text":"雨过苍苍海目开，早潮未落晚潮催。\n鲥鱼不少樱桃颊，与客朝朝作鲙来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13402,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"荡舟海目山下捕鲥鱼为鲙 其二","author":"屈大均","text":"烂鳞粉颊满渔船，煮用涓涓海目泉。\n海目山人不可见，中流一啸?寄川。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13403,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"荡舟海目山下捕鲥鱼为鲙 其三","author":"屈大均","text":"羚羊峡口嘉鱼美，不若鲥鱼海目鲜。\n黄颊切来纷似雪，绿尊倾去更如泉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13404,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"荡舟海目山下捕鲥鱼为鲙 其四","author":"屈大均","text":"刮镬鸣时春雪消，鲥鱼争上九江潮。\n自携鲙具过渔父，双桨如飞不用招。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13405,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其一","author":"屈大均","text":"后皇嘉树产番禺，朱实离离间叶浓。\n珠玉为心君不见，但将颜色比芙蓉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13406,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其二","author":"屈大均","text":"蓬莱一岛海浮来，上有离支下有梅。\n五色仙禽餐不尽，纷纷衔过越王台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13407,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其三","author":"屈大均","text":"绿萎青华似桂丛，岁寒攀折与谁同。\n南州炎德钟花木，郁郁冬荣雨雪中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13408,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其四","author":"屈大均","text":"六月增城百品佳，居人只贩尚书怀。\n玉栏金井殊无价，换尽蛮娘翡翠钗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13409,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其五","author":"屈大均","text":"端阳是处子离离，火齐如山入市时。\n一树增城名挂绿，冰融雪沃少人知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13410,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其六","author":"屈大均","text":"照人最是凝冰子，五月光生一片寒。\n未启朱苞光已出，可怜更在水精盘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13411,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其七","author":"屈大均","text":"翡翠墟边种更佳，客来仙核不须怀。\n葡萄此日应归汉，橘柚繇来不踰淮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13412,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其八","author":"屈大均","text":"东洲烟水接西洲，载出离支万斛舟。\n自夏徂秋皆辟谷，不知人世有通侯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13413,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其九","author":"屈大均","text":"扶胥江口祝融宫，积水茫茫吐日红。\n十里缃枝连黛叶，朝来一望海霞同。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13414,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其十","author":"屈大均","text":"未曾夏至难齐熟，最喜蝉声日日催。\n笑口但令香玉满，愁心尽与绛囊开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13415,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其十一","author":"屈大均","text":"风里氤氲杂芰荷，闻香不觉玉颜酡。\n兰膏倘得长滋润，白发如丝奈我何。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13416,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其十二","author":"屈大均","text":"小至清甜尽上糖，宋香陈紫最先尝。\n夜来坐对青天月，心似云英化水光。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13417,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其十三","author":"屈大均","text":"龙眼独从阴处长，荔枝先向日边红。\n仙人肌体如冰雪，玉液丹成大火中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13418,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其十四","author":"屈大均","text":"雨月山中烟火寒，春衣典尽为琅玕。\n仙人服食如无汝，那得红颜生羽翰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13419,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]