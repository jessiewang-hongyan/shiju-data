[{"title":"怀沙亭独坐有作 其一","author":"屈大均","text":"宴坐山手动一年，光风霁月本非禅。\n无言最与梅花似，开落教人见自然。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14158,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"怀沙亭独坐有作 其二","author":"屈大均","text":"咫尺江门有我师，依依孀母白头时。\n文章直与天无作，画破鸿濛笑宓羲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14159,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"怀沙亭独坐有作 其三","author":"屈大均","text":"一片神明在玉琴，图书先得古人深。\n天边况有团圆月，流出寒光是此心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14160,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吊龙津李氏六烈","author":"屈大均","text":"冬青一树分男女，近日男青让女青。\n不见龙津诸女子，万年枝下头精灵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14161,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题绵羊图","author":"屈大均","text":"平沙漠漠草如茵，只见绵羊不见人。\n北海不知羝乳否，白头苏武欲归秦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14162,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春日仙寒草堂作","author":"屈大均","text":"一声黄鸟一深杯，尽日林中户不开。\n惟有东风怜寂寞，时时吹得落花来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14163,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"增城道中作","author":"屈大均","text":"青青山色每窥人，林外烟含一带春。\n昨夜风吹新水长，桃花片片逐游鳞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14164,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"口占送人还德庆","author":"屈大均","text":"三峡羚羊大小湘，牂牁江水贯中央。\n江干十月嘉鱼美，白舸随君返故乡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14165,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送戴使君 其一","author":"屈大均","text":"君向珠池作大官，三年未得夜光看。\n心知更有明珠好，好似天边白玉盘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14166,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送戴使君 其二","author":"屈大均","text":"天南处处是贪泉，不饮何如饮者贤。\n香浦只今无两浦，君船尚有水沉烟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14167,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送戴使君 其三","author":"屈大均","text":"诗篇一一擅风华，高义还如海上霞。\n以我故人双季布，知君当日一朱家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14168,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送戴使君 其四","author":"屈大均","text":"旌节翩翩度岭云，红梅不及尔清芬。\n惭予亦与罗敷似，不识东方一使君。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14169,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏史 其一","author":"屈大均","text":"黄云一望断人肠，天岭东南是故乡。\n十六军州成大漠，石郎妻子亦辽阳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14170,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏史 其二","author":"屈大均","text":"能为汉语亦多情，夫妇双吹木叶声。\n教上辞乡高岭望，云边尚见塔儿城。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14171,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏史 其三","author":"屈大均","text":"战败牛羊弃玉河，穹庐不见百头多。\n天寒草谷无寻处，冒雪方乘白橐驼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14172,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏史 其四","author":"屈大均","text":"松林抛盏不曾迟，鬼向阴阳食有时。\n正是南朝寒食节，思归莫使汉儿知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14173,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏史 其五","author":"屈大均","text":"蛾眉队队出龙沙，横帐前头哭落花。\n秋夜只须烦蔡女，为传哀怨与金笳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14174,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏史 其六","author":"屈大均","text":"风急霜雕落羽多，茫茫沙草失凌河。\n群飞野马人争射，日暮催归有海螺。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14175,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏史 其七","author":"屈大均","text":"鱼皮种落在扶馀，妇女人人解射鱼。\n持取小鱼为綵缕，绣成方领似芙蕖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14176,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏史 其八","author":"屈大均","text":"鱼皮新作羽林军，毳帐横开长白云。\n辽海多鱼持作饭，黄羊不用射千群。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14177,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏史 其九","author":"屈大均","text":"八月辽阳雪已飞，纷纷乳雁起南归。\n西风一夜催砧杵，木叶征人泪满衣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14178,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏史 其十","author":"屈大均","text":"松杏相连紫翠开，峰峰亦解向南来。\n血花红作燕支草，汉女休持上镜台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14179,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏史 其十一","author":"屈大均","text":"万里城横内外边，筑愁知自祖龙年。\n何如引取黄河水，直绕辽东到朔天。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14180,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"示榆林君","author":"屈大均","text":"而姑昨自越王台，远寄珊瑚笔格来。\n写就玉台新咏未，兰花欲向腕边开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14181,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送人上顶湖","author":"屈大均","text":"瀑布东西水大飞，日光晴映玉帘肥。\n天湖开向千峰顶，迟尔秋来一浣衣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14182,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"杨花 其一","author":"屈大均","text":"风飘一夜落南家，连臂歌残是白花。\n不爱胭脂红上靥，但怜飞絮满宫斜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14183,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"杨花 其二","author":"屈大均","text":"半作香泥吹复飞，茫茫一片逐春归。\n春归有路从烟水，愁绝杨花蔽夕晖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14184,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"杨花 其三","author":"屈大均","text":"沾泥落水不曾知，似雪飘飖得几时。\n为语东风莫吹尽，留将一片与游丝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14185,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"柳 其一","author":"屈大均","text":"不恨杨枝恨柳枝，牵肠一种乱如丝。\n啼乌为尔头先白，正是花飞似雪时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14186,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"柳 其二","author":"屈大均","text":"临风舞断细腰肢，不管黄莺在上枝。\n拂水千千那忍折，长条犹记短条时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14187,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"柳 其三","author":"屈大均","text":"一片花飞似白头，为萍亦复逐风流。\n银装筝子红牙拍，谁按杨枝不起愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14188,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浮琼海 其一","author":"屈大均","text":"风帆朝自石塘开，白浪如山万里来。\n白是海天青是水，茫茫不辨有琼雷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14189,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浮琼海 其二","author":"屈大均","text":"一气空濛作海天，风吹飞水白如烟。\n三潮三汐东西至，捲去长沙不见边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14190,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浮琼海 其三","author":"屈大均","text":"岛屿沉浮一点青，鸡声彷佛在空冥。\n断虹一片天边起，乱落风帆向翠屏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14191,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"明妃 其一","author":"屈大均","text":"阴山一望战云寒，汉月凄凄不忍看。\n都尉不辞封右校，明妃何惜嫁呼韩。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14192,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"明妃 其二","author":"屈大均","text":"自作新辞教绿珠，明君舞罢赐珊瑚。\n翔风莫抱房中怨，塞上阏氏似尔无。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14193,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"明妃 其三","author":"屈大均","text":"琵琶马上送蛾眉，汉帝思同公主时。\n善舞明君梁氏女，不甘秋草学阏氏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14194,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"文君","author":"屈大均","text":"绿绮琴声亦是媒，人间那得长卿才。\n白头吟罢重欢好，也似长门一赋来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14195,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"韶阳道中望诸峰","author":"屈大均","text":"削出枝枝是箨龙，无人道是一峰峰。\n山灵作意为韶石，欲使巉岩似次宗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14196,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送人之云中","author":"屈大均","text":"山西门户是云中，上谷三关俯汉宫。\n君向长城城上望，秋鹰应念郅都雄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14197,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送人返徽州","author":"屈大均","text":"黄山白岳梦魂间，之子乘秋一杖还。\n洗研莫污飞瀑水，濯缨吾拟向潺湲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14198,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和太仓许子题宋高宗赐岳武穆王班师手诏后 其一","author":"屈大均","text":"自写班师诏纸来，思陵花押玺函开。\n东南自足为天子，一片湖山绕露台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14199,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和太仓许子题宋高宗赐岳武穆王班师手诏后 其二","author":"屈大均","text":"龙颜多为讲和开，有诏班师手自裁。\n雪耻枉居勾践国，会稽山解笑人来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14200,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏吹笛者","author":"屈大均","text":"惊鸿不似似行云，日夕含香笑语芬。\n应是绿珠高弟子，笛声吹出舞明君。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14201,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"琪林","author":"屈大均","text":"琪林日暮喜乘凉，羽客殷勤拂石床。\n欲得银钩真与草，白鹅多养在池塘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14202,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"故苑","author":"屈大均","text":"故苑昌华在海头，离宫亦傍荔枝洲。\n蝉声如水流高树，催尽斜阳又一秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14203,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"子陵 其一","author":"屈大均","text":"卧见君王在北军，客星光射紫微云。\n狂奴但肯为巢许，已是中兴一大勋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14204,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"子陵 其二","author":"屈大均","text":"前有商颜后富春，汉家高逸两天民。\n钓台双向青天出，香饵何曾到锦鳞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14205,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"偶忆春州十三叠瀑布 其一","author":"屈大均","text":"阳春白水十三叠，势比增城白水长。\n更有崆峒岩洞好，龙床偃卧绝清凉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14206,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"偶忆春州十三叠瀑布 其二","author":"屈大均","text":"一叠冰霜一叠云，峰峰沾湿女萝裙。\n白猿不敢潭间饮，镇日雷轰隔岭闻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14207,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"兰","author":"屈大均","text":"兰叶青青不厌长，宜阴一半又宜阳。\n花开多在微风外，夜静无人始有香。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14208,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜谢九丈自莞中见过之作 其一","author":"屈大均","text":"咫尺乡园未得还，城中闭户亦深山。\n故人只有香农父，来共琴书一日閒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14209,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜谢九丈自莞中见过之作 其二","author":"屈大均","text":"汝种多香与子孙，胜于全买荔枝园。\n紫囊一树人争食，明岁招予作白猿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14210,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜谢九丈自莞中见过之作 其三","author":"屈大均","text":"相见无多万历人，白头冠箨是遗民。\n山中酒熟须多饮，为我长留太古春。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14211,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜谢九丈自莞中见过之作 其四","author":"屈大均","text":"白发翩翩海鹤姿，河清已过杖乡时。\n岁寒不用愁风雪，自有春阳到柳丝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14212,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"严关 其一","author":"屈大均","text":"雪至秦城不复南，严关一道满烟岚。\n松间欲访秦皇庙，匹马盘回上玉簪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14213,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"严关 其二","author":"屈大均","text":"秦城长比越城长，筑怨当年在瘴乡。\n天作严关元限越，东南天地总羊肠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14214,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"夫溪曲 其一","author":"屈大均","text":"夫溪溪水水分流，流向东西似御沟。\n恨绝当年征戍妇，潮痕长与泪痕留。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14215,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"夫溪曲 其二","author":"屈大均","text":"鸳鸯不向此溪游，岂有鸳鸯得白头。\n溪水不将浓泪去，泪红长似落花浮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14216,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"燕子泉","author":"屈大均","text":"秋去春来同燕子，翁山山下一蒙泉。\n八泉与尔同天一，流出千岩万壑烟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14217,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏罗浮 其一","author":"屈大均","text":"浮山浮海自东来，嫁与罗山不用媒。\n合体真同夫与妇，生儿尽作小蓬莱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14218,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏罗浮 其二","author":"屈大均","text":"四百三十二儿孙，上界飞云势并尊。\n浮岳不将罗岳去，白云长锁洞天门。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14219,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏罗浮 其三","author":"屈大均","text":"飞桥天半接罗浮，铁柱双标在两头。\n锁住蓬莱东一股，浮山不逐海潮流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14220,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏罗浮 其四","author":"屈大均","text":"瀑泉无数落峰腰，九百还馀八十条。\n布水不言庐岳好，泉源福地是东樵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14221,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏罗浮 其五","author":"屈大均","text":"东瀑何如西瀑长，交飞云际似鸳鸯。\n瀑花吹满黄龙洞，冰雪人愁六月凉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14222,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏罗浮 其六","author":"屈大均","text":"一帘飞水挂云高，半落流杯与药槽。\n风接寒声人天际，时时散作万松涛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14223,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏罗浮 其七","author":"屈大均","text":"丫髻双开紫翠新，瑶台石笋斗嶙峋。\n笑他玉女峰娟妙，长伴云边一老人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14224,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏罗浮 其八","author":"屈大均","text":"一道飞桥乍有无，台边问路得麻姑。\n石楼大小中天出，开阖何人在玉壶。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14225,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送人入罗浮 其一","author":"屈大均","text":"天边飞磴似桥飞，玉柱双双夹翠微。\n自是铁桥人不识，君行好度莫来归。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14226,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送人入罗浮 其二","author":"屈大均","text":"祗愁蝴蝶大如箕，食尽山花人不知。\n红翠纷纷难与守，芳菲又遇艳阳时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14227,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送人入罗浮 其三","author":"屈大均","text":"仙禽五色不知名，日夕相依最有情。\n莫捕林间小凤子，裁为羽服似云轻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14228,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送人入罗浮 其四","author":"屈大均","text":"山衣一袭似轻霞，著去东寻萼绿华。\n缝用麻姑金线草，补将玉女大丹花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14229,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"青旗江口所见","author":"屈大均","text":"微霜生暖雪生寒，鱼爱新泉上钓竿。\n渔父挂帆二水去，白头人作鹭莺看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14230,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"席上谈及罗浮神蝶有赋 其一","author":"屈大均","text":"蝴蝶元生蝴蝶洞，仙胎不必鲍姑衣。\n天教凤子如箕大，不向梅花岭外飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14231,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"席上谈及罗浮神蝶有赋 其二","author":"屈大均","text":"五色文章亦羽毛，仙灵变化在金膏。\n雌雄却笑蒙庄客，栩栩空教梦寐劳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14232,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]