[{"title":"汪扶晨六十有赠 其一","author":"屈大均","text":"梦魂元处所，只是向潜溪。\n白发有吾友，黄山知更西。\n命将盘石似，身已偃松齐。\n六十诗逾好，峰峰笑旧题。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11240,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"汪扶晨六十有赠 其二","author":"屈大均","text":"老友稀江左，年龄尽与君。\n无才真大药，有道总浮云。\n得草麑相命，逢花鹤不分。\n未知潜口路，多少桂丛薰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11241,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"汪扶晨六十有赠 其三","author":"屈大均","text":"殷勤来尺素，读罢置兰襟。\n雀亦开全尾，蕉休捲半心。\n故人真好我，旷世一知音。\n百岁期钟子，洋洋听玉琴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11242,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"汪扶晨六十有赠 其四","author":"屈大均","text":"早年温丽笔，衰白益生春。\n玉满文鱼腹，珠多老蚌唇。\n墨分胶漆友，茶与水云人。\n养寿同园绮，商颜待作邻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11243,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠金磬北 其一","author":"屈大均","text":"隶书师郑叟，惊绝已知名。\n求写无缣素，飞毫忆老成。\n一生耽墨妙，三体未研精。\n谷口能模楷，从君至旧京。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11244,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠金磬北 其二","author":"屈大均","text":"白发汤高逸，书家亦一人。\n鸠兹称二篆，虿尾更三真。\n以我师心拙，多君得法新。\n归时烦致语，名迹寄来频。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11245,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠金磬北 其三","author":"屈大均","text":"白首思乘暇，临池学伯英。\n法书研玩少，真迹梦魂倾。\n师有江东友，人知汉隶名。\n秘传须口授，汤郑总关情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11246,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送黄叔威还阁 其一","author":"屈大均","text":"君归金太少，亦慰旨甘求。\n国老存乔木，天年得大秋。\n三山醇酒设，九日菊花浮。\n海气金银外，仙人在蜃楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11247,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送黄叔威还阁 其二","author":"屈大均","text":"知交闽越少，为我语亡诸。\n有友梅鋗在，无人大汉馀。\n侯官数灾异，高叟断音书。\n晚景忧孙子，题诗恐太疏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11248,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送黄叔威还阁 其三","author":"屈大均","text":"君来惭地主，值我最贫时。\n一日房栊语，三年梦寐思。\n仙留钤记在，老作华嵩期。\n英霸吾非器，龙光骋已迟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11249,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送黄叔威还阁 其四","author":"屈大均","text":"水菽艰难甚，关山跋涉中。\n能勤双白发，又是一黄童。\n别处愁残日，归时苦飓风。\n福兴诸好友，心事为相通。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11250,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"林子饷梨有作","author":"屈大均","text":"多君大谷梨，紫实压霜枝。\n亦未含消似，偏令津润滋。\n冷愁尊老嗜，香恐小男知。\n稍待微酣后，甜冰食不迟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11251,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"郭君酌我延寿佳酒赋以答之","author":"屈大均","text":"多君仙酝好，不惜瓮头开。\n为我斟元气，留春在玉杯。\n长年凭美禄，名饮见狂才。\n自此乘佳日，频过踏紫苔。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11252,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"林岕","author":"屈大均","text":"峒山真岕好，学制有遗人。\n庶子今林姓，周家旧懿亲。\n金精栽绝巘，紫笋摘先春。\n庙后香全似，泉兼蟹眼新。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11253,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"扶晨屡以紫霞茶见寄赋以答之","author":"屈大均","text":"紫霞频见寄，香白露芽鲜。\n摘定先寒食，烹须就乳泉。\n摩娑双白甀，斟酌一青娟。\n岁岁封题意，殷勤感汝贤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11254,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寿光轩作","author":"屈大均","text":"白发犹良食，婆娑花树阴。\n弄雏过白日，饮乳向青琴。\n菡萏无双薏，鸤鸠只一心。\n膝前孩笑好，两两助清吟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11255,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题吕纪梅雀图","author":"屈大均","text":"绝似边鸾好，枝枝雪可攀。\n粉微沾翠羽，香欲出寒山。\n啄蕊当明月，惊花坠玉颜。\n画时图辟暑，宜尔素屏间。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11256,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜侃士病愈赠之 其一","author":"屈大均","text":"炎方人易病，勿药汝迟迟。\n难老无如学，多才自有时。\n暖风荠麦秀，凉露蕣华滋。\n不及黄黄菊，神仙食更宜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11257,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜侃士病愈赠之 其二","author":"屈大均","text":"莎鸡初在野，最早得秋寒。\n亦未伤迟暮，其如行路难。\n忘言但吟啸，与道日游盘。\n青岁还经学，纷纶一井丹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11258,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜侃士病愈赠之 其三","author":"屈大均","text":"坐隐须棋局，从君奕旨求。\n马融思作赋，祖讷待忘忧。\n黑子饶难少，香囊赌尚留。\n萧萧枫叶下，相对一高秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11259,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜侃士病愈赠之 其四","author":"屈大均","text":"君家富山水，复有父兄贤。\n孝友光闾井，壶觞媚老年。\n白华无大小，朱萼总芳妍。\n汝也吹篪好，声高五子前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11260,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜侃士病愈赠之 其五","author":"屈大均","text":"石笋森如束，枝枝上有松。\n有时仙掌出，镇日谷烟封。\n羽化三天子，髯留一老龙。\n容成应可接，归向玉芙蓉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11261,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜侃士病愈赠之 其六","author":"屈大均","text":"新安多好友，招手十年间。\n以我浮丘客，应居黄帝山。\n明春单舸往，及尔故园还。\n一浴朱砂水，乘秋返庾关。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11262,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜罗君又持扶晨书至","author":"屈大均","text":"新安江好水，生得有情鱼。\n岁岁衔芳信，年年到敝庐。\n萝魄因尔少，音问更谁疏。\n自古潇湘客，鳞鳞爱媵予。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11263,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"白云泉","author":"屈大均","text":"白云山上水，几处作名泉。\n今夕龙团味，全胜蟹眼鲜。\n湍流非瀑布，仄出向岩烟。\n酒渴真宜汝，壶觞玉井边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11264,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"元孝六十又一生日赋以为寿 其一","author":"屈大均","text":"长兄叨一岁，十六结交知。\n以尔真贤友，而翁更哲师。\n忠贞三世早，事业两家迟。\n此日难为寿，惭过耳顺时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11265,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"元孝六十又一生日赋以为寿 其二","author":"屈大均","text":"同生霜降月，摇落每相怜。\n乔木先朝古，黄花故国妍。\n琴惟天马引，歌是楚渔篇。\n未可伤衰暮，殊多独漉年。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11266,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"元孝六十又一生日赋以为寿 其三","author":"屈大均","text":"汉代羽林子，孤儿今几何。\n瓶侯孙氏少，剑客李家多。\n寇雉衔霜去，边雕蔽日过。\n文渊雄顾盻，明岁未蹉跎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11267,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"元孝六十又一生日赋以为寿 其四","author":"屈大均","text":"臣妾谁凫藻，迷途一布衣。\n又嗟寒露湿，未见太阳晞。\n壮发霜虽短，初心日未非。\n杖乡多一岁，好待据鞍飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11268,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"元孝六十又一生日赋以为寿 其五","author":"屈大均","text":"却老文章在，无欢亦写心。\n寿光还导引，方朔只浮沉。\n味爱筼筜苦，香怜橘柚深。\n齐名从少小，千载一雕琴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11269,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"元孝六十又一生日赋以为寿 其六","author":"屈大均","text":"出处一浮云，穷通祗共君。\n无忧惟作述，有道即功勋。\n竹影龙公合，松阴鹤子分。\n缠绵敦世好，彼此挹灵芬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11270,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉题惠阳王郡侯署中忆雪楼 其一","author":"屈大均","text":"岭海行春罢，楼开尽物华。\n欲将天北雪，来润日南花。\n二岳窗间直，双江槛外斜。\n自来仙太守，山水满官衙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11271,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉题惠阳王郡侯署中忆雪楼 其二","author":"屈大均","text":"岂无南雪好，朔雪易成花。\n幸有罗浮树，光含涨海霞。\n使君移绿萼，么凤自金沙。\n手泽楼前满，甘棠即白华。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11272,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉题惠阳王郡侯署中忆雪楼 其三","author":"屈大均","text":"姑射元冰雪，炎方亦觉寒。\n神凝在浮峤，梦去只中盘。\n瀑布为膏泽，芙蓉即大丹。\n更令楼外水，清作使君滩。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11273,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉题惠阳王郡侯署中忆雪楼 其四","author":"屈大均","text":"峰爱穿帘小，来从双玉盘。\n莫将湖内外，都作月明看。\n政事惟高卧，颜容更渥丹。\n谢公鳷鹊句，书遍碧琅玕。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11274,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"为顺德徐明府寿","author":"屈大均","text":"未知碧鉴水，清似使君不。\n莫掷沉香去，将成芳草洲。\n政成高卧里，年与大春留。\n难老无烦祝，徐陵正黑头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11275,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"大寒 其一","author":"屈大均","text":"大寒偏易暖，寒向小寒时。\n亦有空林雪，梅花似不知。\n病烦春色早，贫恐水仙迟。\n多谢萋萋草，穿冰已作丝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11276,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"大寒 其二","author":"屈大均","text":"穷阴天外积，寒绝逼春来。\n尚苦连朝雾，南风湿不开。\n已新长至柳，重吐小年梅。\n腊酒谁家早，莺知为我催。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11277,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟次小塘 其一","author":"屈大均","text":"北风向暮起，心折峭帆斜。\n两岸卷黄叶，一江吹白沙。\n那堪与鸿雁，自此长蒹葭。\n舟发才三夕，苍茫已忆家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11278,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟次小塘 其二","author":"屈大均","text":"北风吹水浅，势使沓潮回。\n冻苦江沙合，阴愁雪色来。\n消寒馀酒滓，拥暖只炉灰。\n且喜河边柳，年光已暗催。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11279,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟入横槎水作","author":"屈大均","text":"渔舟不觉远，深入一溪霞。\n烟火烧红雨，牛羊饭落花。\n水声分乱石，山影散晴沙。\n莺唤人酤酒，垂杨第几家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11280,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"烂柯山作","author":"屈大均","text":"阴森十馀里，榕间木棉多。\n啼鸟不知处，嘤嘤连伐柯。\n斜峰飞欲堕，乱水响难和。\n猿狖时窥客，相将下女萝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11281,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送李君还秦兼寄怀其舅孔德太史 其一","author":"屈大均","text":"白头知己尽，而舅最相思。\n万里空魂梦，平生此别离。\n自矜辞爵早，人恨著书迟。\n针药凭谁进，萧条卧疾时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11282,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送李君还秦兼寄怀其舅孔德太史 其二","author":"屈大均","text":"越有南枝鸟，秦馀北地人。\n文章高并起，羽翼夙相亲。\n汝病躬方有，吾衰性未驯。\n参商应有日，再见渭川滨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11283,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送李君还秦兼寄怀其舅孔德太史 其三","author":"屈大均","text":"尚得存尊足，奚劳患有身。\n孤桐虽半槁，硕果定重新。\n高卧复何事，蘧庐馀一人。\n平生知作达，佚我岂沾巾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11284,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送李君还秦兼寄怀其舅孔德太史 其四","author":"屈大均","text":"为予催李汉，文录早成之。\n往日昌黎婿，而今伯道儿。\n全书留太华，副本在京师。\n作序题前后，芜言不敢辞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11285,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"林叔君六十生日赋以赠之 其一","author":"屈大均","text":"少予犹二岁，髯白已三年。\n未是桑榆日，方开草昧天。\n加餐休服食，好学即神仙。\n六十多吾友，参差杖国前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11286,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"林叔君六十生日赋以赠之 其二","author":"屈大均","text":"六十蘧公化，前贤似者希。\n未能惟寡过，不尽是知非。\n道与浮云卷，情终故国归。\n有君同此意，衰白益光辉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11287,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"林叔君六十生日赋以赠之 其三","author":"屈大均","text":"白首如新识，情因患难长。\n白公磨剑利，黄叟采芝香。\n慷慨歌同病，艰难笑备尝。\n未应春色里，送老是壶觞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11288,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"林叔君六十生日赋以赠之 其四","author":"屈大均","text":"更使诗歌好，风华要绝伦。\n莺花争一日，笔墨斗三春。\n世弃沈冥客，天迷故旧人。\n阿兄应待汝，开目似冯信。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11289,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"林叔君六十生日赋以赠之 其五","author":"屈大均","text":"令子知名早，雍容友教时。\n一家能有学，二祖更无师。\n理窟禺山下，谈林莞水湄。\n趋庭说风雅，先解阿翁颐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11290,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"林叔君六十生日赋以赠之 其六","author":"屈大均","text":"石上围棋罢，乘凉坐到明。\n烛残须日出，胶尽自河清。\n寂寂生前事，茫茫身后名。\n一杯空所有，何物是殇彭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11291,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄赠歙人汪伯子四十 其一","author":"屈大均","text":"不因仲弟好，安识伯兄贤。\n孝友寻常事，如君自可传。\n飞腾才四十，文藻且连翩。\n黄白双名岳，相期蹑紫烟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11292,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄赠歙人汪伯子四十 其二","author":"屈大均","text":"子舍多山水，娱亲烟翠重。\n乞将三十六，都作老人峰。\n为长已强仕，栖閒多好容。\n三珠三弟在，花萼有馀恭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11293,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"汪仲子持令兄栗亭及诸君书自歙至广州相问于其归也为诗二章送之兼寄诸君 其一","author":"屈大均","text":"玉琴久不抚，萧瑟向烟汀。\n岂不志山水，知音非栗亭。\n一人持尺素，诸子在云屏。\n相望亦云久，君归慰杳冥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11294,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"汪仲子持令兄栗亭及诸君书自歙至广州相问于其归也为诗二章送之兼寄诸君 其二","author":"屈大均","text":"相思黄岳甚，况复故人多。\n汝向丰溪曲，为予传啸歌。\n白云无事否，春色奈愁何。\n心似诸峰月，依依在女萝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11295,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"夕向诃林承二三禅人留宿风幡堂即事赋赠得风字","author":"屈大均","text":"解与陶潜饮，清狂即远公。\n好将虎溪水，移入酒泉中。\n烛秉何须月，幡吹只是风。\n欲眠无醉石，为拂半床空。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11296,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其一","author":"屈大均","text":"送至禺阳返，含情是海潮。\n峡犹云母隔，峰已石人招。\n古寺愁飞去，无人问泬寥。\n菩提兵火后，一树自南朝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11297,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其二","author":"屈大均","text":"胥江沙水浅，取蚬疍船多。\n男女无馀粟，生涯是扁螺。\n吞腥安水土，足跣弄烟波。\n苦竹春丛外，时时闻斗歌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11298,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其三","author":"屈大均","text":"潮鸡鸣未已，微月逐潮生。\n水宿难为夜，舟开不待明。\n半帆烟树影，一枕草虫声。\n不寐怀衰白，劳劳水菽情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11299,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其四","author":"屈大均","text":"夜久息群动，寒萤听渐微。\n那知零白露，但觉湿罗衣。\n鱼食星河影，凫眠水石矶。\n坐来斜月上，吟啸发清机。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11300,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其五","author":"屈大均","text":"江中蕉叶似，小艇卖鱼家。\n蚝疍虽无女，钗鬟亦有花。\n荡桡杨柳浦，晒网鹭鹚沙。\n白发多公姥，萧萧水一涯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11301,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其六","author":"屈大均","text":"不觉舟行远，仙源信几重。\n二禺兄弟峡，一石妇人峰。\n涧断知无栈，林空似有钟。\n春来霪雨少，瀑势太从容。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11302,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其七","author":"屈大均","text":"一日始一峡，舟行苦逆风。\n暮春犹苦冻，长路正愁穷。\n栈阁飞岩外，橧巢古木中。\n繵夫歌有哭，声与断猿同。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11303,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自胥江上峡至韶阳作 其八","author":"屈大均","text":"草映一川绿，萋萋含夕曛。\n有无樵子路，三两鹿麛群。\n峰束易成峡，岩空多出云。\n削成无数壁，奇自华山分。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":11304,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]