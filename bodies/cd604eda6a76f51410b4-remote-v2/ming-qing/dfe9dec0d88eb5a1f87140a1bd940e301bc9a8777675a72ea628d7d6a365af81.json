[{"title":"广州竹枝词 其一","author":"屈大均","text":"边人带得冷南来，今岁梅花春始开。\n白头老人不识雪，惊看白满越王台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14233,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州竹枝词 其二","author":"屈大均","text":"日食槟榔口不空，南人口让北人红。\n灰多叶少如相等，管取胭脂个个同。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14234,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州竹枝词 其三","author":"屈大均","text":"佛桑亦是扶桑花，朵朵烧云如海霞。\n日向蛮娘髻边出，人人插得一枝斜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14235,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州竹枝词 其四","author":"屈大均","text":"洋船争得是官商，十字门开向二洋。\n五丝八丝广缎好，银钱堆满十三行。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14236,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州竹枝词 其五","author":"屈大均","text":"十字钱多是大官，官兵枉向澳门盘。\n东西洋货先呈样，白黑番奴拥白丹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14237,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州竹枝词 其六","author":"屈大均","text":"女葛无多况女香，纷纷香尉在炎方。\n归舟莫过沉香浦，风雨难留一片黄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14238,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州竹枝词 其七","author":"屈大均","text":"好笋是人家里竹，好藕是人家里莲。\n好崽是人家女婿，鸳鸯各自一双眠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14239,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题烟波垂钓图","author":"屈大均","text":"鸳鸯湖水连长水，渔父而今有一人。\n白白鲈鱼人不识，芦花多处日相亲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14240,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"龟峰白云 其一","author":"屈大均","text":"离离宿草几经春，万里相寻珠海滨。\n母子繇来如水月，黄泉重见不关人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14241,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"龟峰白云 其二","author":"屈大均","text":"东望辽阳泪并流，翩翩归鹤向浮丘。\n白云终古随魂气，飞作天南一片秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14242,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题东来紫气图","author":"屈大均","text":"华阴尚有青牛树，树亦犹龙似老人。\n紫气氤氲在枝叶，持来为尔五千春。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14243,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏马伏波 其一","author":"屈大均","text":"将军南涉武溪深，双植金标镇象林。\n铜鼓铸成奇马式，汉皇留在馺娑阴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14244,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏马伏波 其二","author":"屈大均","text":"麋冷双女自为王，锦绣旌旗海上张。\n一自伏波亲讨伐，日南长作汉封疆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14245,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏马伏波 其三","author":"屈大均","text":"飞鸢站站堕炎云，薏苡加餐莅政勤。\n骆越至今遵约束，岁时频祀马将军。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14246,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"见初月有怀 其一","author":"屈大均","text":"娟娟初出绛河滨，只见蛾眉不见人。\n欲寄清光与卿去，风吹不肯落西秦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14247,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"见初月有怀 其二","author":"屈大均","text":"一半晴光一半阴，相看只在碧天心。\n盈盈最恨明河水，长为牵牛织女深。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14248,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠东莞叶君","author":"屈大均","text":"千亩香林在莞中，君家正是密香丛。\n罗浮四百铜垆器，一气双烟睡处通。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14249,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"素馨斜","author":"屈大均","text":"花田旧是内人斜，南汉风流此一家。\n千载香销珠海上，春魂犹作素馨花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14250,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题西宁张邑侯山响亭 其一","author":"屈大均","text":"官舍苍苍万叠山，琴声半落瀑泉间。\n春风只自弦中出，吹得桃花去复还。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14251,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题西宁张邑侯山响亭 其二","author":"屈大均","text":"拄笏朝朝见翠屏，瑶琴色映数峰青。\n陶公自有无弦者，写出元音满讼庭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14252,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"贫居口占 其一","author":"屈大均","text":"乞食长生一木瓢，香粳为粥手亲调。\n八旬堂上老莱母，盐豉加餐暮复朝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14253,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"贫居口占 其二","author":"屈大均","text":"膝下黄头历齿多，休惭儿子且高歌。\n七旬始得完婚嫁，五岳其如欲往何。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14254,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"贫居口占 其三","author":"屈大均","text":"彫胡饭共露葵香，白发清斋苦北堂。\n疏磬泠泠花架下，春来强健佛声长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14255,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"贫居口占 其四","author":"屈大均","text":"瓶中粒粒砚田来，云子香流齿颊开。\n世上尽多仁者粟，陶潜未有叩门才。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14256,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"贫居口占 其五","author":"屈大均","text":"七龄黄口谢家儿，解爱葩经绝妙辞。\n初读未终三百五，频将比兴问经师。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14257,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题画竹卷","author":"屈大均","text":"谁写枝枝竹影长，墨花飞处即潇湘。\n琅玕不必栽千亩，自有清阴满石床。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14258,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"翡翠","author":"屈大均","text":"雌青雄赤是鱼师，日夕清波浴不迟。\n低处为巢因爱子，花工捕向月明时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14259,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"杜鹃","author":"屈大均","text":"生作春鹃只苦啼，山山红染落花泥。\n天教怨鸟催人老，一夕星星白发齐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14260,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题王给谏乌丝红袖图 其一","author":"屈大均","text":"芙蓉无数水中开，化作鸳鸯七十来。\n争爱夕郎辞赋好，持笺一一向琴台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14261,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题王给谏乌丝红袖图 其二","author":"屈大均","text":"太华仙人鲁女生，三千玉女不知名。\n何如少华黄门客，解和诗篇有丽英。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14262,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题王给谏乌丝红袖图 其三","author":"屈大均","text":"西从西岳至罗浮，诗满天边二石楼。\n五色仙禽多狡狯，麻姑教向使君求。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14263,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题王给谏乌丝红袖图 其四","author":"屈大均","text":"斑骓携得素馨花，陆贾风流映汉家。\n一片罗阳歌舞石，看君飞满笔端霞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14264,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题五诗人图","author":"屈大均","text":"诗人复有五君贤，渭北江东啸咏传。\n一片丹青争画出，风流谁复羡凌烟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14265,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题画 其一","author":"屈大均","text":"松树横斜似酒龙，不须奇石已成峰。\n朝来墨气淋漓甚，写出秦时烟雨容。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14266,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题画 其二","author":"屈大均","text":"玉井移将入画图，芙蓉十丈世间无。\n三花直与三峰似，开向仙人白玉壶。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14267,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题寒江钓雪图","author":"屈大均","text":"雨雪江中一钓竿，天生渔父不知寒。\n蓑衣白尽无人识，都作双双白鹭看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14268,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"观彭子与苏子别有作 其一","author":"屈大均","text":"珠水今春柳叶迟，因君不忍吐长丝。\n将归一曲尊前唱，黄鸟无声为别离。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14269,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"观彭子与苏子别有作 其二","author":"屈大均","text":"山木歌残不自持，情深重使越人悲。\n天南自此多连理，细叶榕阴满水湄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14270,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟自康州东下作 其一","author":"屈大均","text":"大湘未尽小湘来，两岸青山向峡开。\n直到羚羊江始放，西江倒捲北江回。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14271,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟自康州东下作 其二","author":"屈大均","text":"羚羊一口雨中开，潮截牂牁水倒回。\n四月鱼花犹绝少，祗因西水未曾来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14272,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟自康州东下作 其三","author":"屈大均","text":"黄鱼不取取嘉鱼，举网频乘细雨馀。\n一夕锦江新水长，双帆未肯返扶胥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14273,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"绛桃","author":"屈大均","text":"露井桃花似玉妃，东皇频使著绯衣。\n晴开朵朵如杯大，醉杀朝阳露未晞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14274,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题扁舟图","author":"屈大均","text":"孤帆一片没浮云，可惜舟中只有君。\n相送夷光五湖去，风流谁似白鸥群。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14275,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吴江曲 其一","author":"屈大均","text":"吴江风味胜姑苏，玉鲙金莲世所无。\n桥北三腮休道美，桥南更有四腮鲈。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14276,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吴江曲 其二","author":"屈大均","text":"鸭嘴船轻去不迟，吴儿十岁作舟师。\n舵楼有女歌相接，唱罢杨枝又竹枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14277,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吴江曲 其三","author":"屈大均","text":"莺脰银鱼细似丝，紫须秋蟹饱霜时。\n鲈鱼肉紧堪为腊，绝胜吴淞人不知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14278,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吴江曲 其四","author":"屈大均","text":"尖头船子荡田边，莼线秋来处处牵。\n更向越来溪畔去，吴娘鸡豆点茶鲜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14279,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题阳春白水之山","author":"屈大均","text":"匡庐三叠挂虹梁，复有黄山九叠长。\n争似春州十三叠，交飞白水一天凉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14280,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"掩扉","author":"屈大均","text":"半掩山扉及昼长，登高不赴小重阳。\n三真六草教儿女，写尽秋林叶叶霜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14281,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"覆额","author":"屈大均","text":"覆额兰云渐欲长，未簪花朵髻先香。\n芙蓉结子何须早，且为佳人一拒霜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14282,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题画红梅","author":"屈大均","text":"姑射仙人处子同，玉颜偏爱老来红。\n微酡绝与红梅似，雪染胭脂两颊中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14283,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题画梅赠同庚刘叟","author":"屈大均","text":"仙种分从太古天，岁寒松树与同年。\n白头不管如冰雪，自有春光绝代妍。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14284,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"东向","author":"屈大均","text":"东向金陵荡画桡，愁心不逐暮烟消。\n多情最似江南柳，尽是依依为六朝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14285,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"断肠","author":"屈大均","text":"断肠无计更留欢，凤去罗帷香未残。\n昼下空帘愁脉脉，祗应花作美人看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14286,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春水","author":"屈大均","text":"春来新水满炎洲，步步鱼花载满舟。\n天半羚羊悬一口，西江吞吐北江流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14287,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"仲秋五日客端州承太守王公招同诸公游七星岩分赋得秋字 其一","author":"屈大均","text":"芙蓉一朵一丹丘，紫翠长含一片秋。\n太守殷勤是山水，閒同上客弄轻鸥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14288,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"仲秋五日客端州承太守王公招同诸公游七星岩分赋得秋字 其二","author":"屈大均","text":"翩翩白鹿夹车游，自得神君岁有秋。\n谢眺最宜山水郡，金波丽句照炎洲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14289,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"仲秋五日客端州承太守王公招同诸公游七星岩分赋得秋字 其三","author":"屈大均","text":"中湖山作七螺浮，势截牂牁上下流。\n石笋中通多地道，东西穿出大龙湫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14290,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"仲秋五日客端州承太守王公招同诸公游七星岩分赋得秋字 其四","author":"屈大均","text":"天光日与水沉浮，清绝湖风不待秋。\n吹尽七峰珠斗影，白云不使镜中留。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14291,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"仲秋五日客端州承太守王公招同诸公游七星岩分赋得秋字 其五","author":"屈大均","text":"礼加徐孺动南州，政暇还同烟水游。\n鸾鹤只知能啸咏，一声寒作碧天秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14292,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送麦子之松江 其一","author":"屈大均","text":"闻道鲈鱼三泖多，季鹰秋兴在烟波。\n君行更尽吴淞酒，身后浮名奈尔何。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14293,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送麦子之松江 其二","author":"屈大均","text":"风吹不散落花愁，泪共三江江水流。\n一代红颜是知己，为予多谢月珠楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14294,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送麦子之松江 其三","author":"屈大均","text":"明到红梅古驿边，停车且傍酒家眠。\n酒星天上应无酒，不若人间作酒泉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14295,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"示秀容 其一","author":"屈大均","text":"昔年曾过秀容楼，楼上佳人挽紫骝。\n今夕秀容来入座，昭君一曲泪还流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14296,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"示秀容 其二","author":"屈大均","text":"蒌叶结成双蛱蝶，槟榔一瓣在中央。\n殷勤赠与青莲客，入口甜如玉女浆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14297,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"席上赠叶仙","author":"屈大均","text":"吹人无那素馨风，更送桃花上脸红。\n但得佳人称太白，不辞沉醉月明中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14298,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湛烈女哀词 其一","author":"屈大均","text":"雾隐芙蓉未见莲，为欢贞介结缡前。\n频同雒女沉罗袜，不使蕃兵拾翠钿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14299,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湛烈女哀词 其二","author":"屈大均","text":"妾被惊风断兔丝，君看明月忆蛾眉。\n泰山不弃孤生竹，犹把枯枝种玉墀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14300,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湛烈女哀词 其三","author":"屈大均","text":"春魂化蝶恨难消，谁使韩凭放大招。\n赖得蹇修明礼义，女萝虽死附松条。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14301,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湛烈女哀词 其四","author":"屈大均","text":"不藉少翁归夜月，不随神女出朝云。\n明诗习礼阴阳隔，欲报琼瑶故见君。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14302,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"四关烈妇诗 其一","author":"屈大均","text":"侬有青莲不独枝，太阿难断藕中丝。\n缠绵竟入洪炉里，一气凌霞无尽时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14303,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"四关烈妇诗 其二","author":"屈大均","text":"丹心一点在兰膏，生得芙蕖并蒂牢。\n光采流连欺皎月，夜台相与乐衾帱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14304,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"四关烈妇诗 其三","author":"屈大均","text":"浮萍无水复何依，绝代芙蓉露易晞。\n哭向黄泉同穴去，恩情不减华山畿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14305,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"四关烈妇诗 其四","author":"屈大均","text":"采得明珠可报君，便归泉下逐鸯群。\n长歌直入桐柑里，一片哀心彻白云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14306,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]