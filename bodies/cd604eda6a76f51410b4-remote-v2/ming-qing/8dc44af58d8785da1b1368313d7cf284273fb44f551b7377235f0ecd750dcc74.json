[{"title":"初至雁门赠陈祺公使君 其二","author":"屈大均","text":"武安方略在，烽鼓坐来消。\n犄角三关壮，凭陵万里骄。\n铙歌开乐府，羽猎会嫖姚。\n惨淡黄云外，天盘八月鹞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8989,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"陪陈使君游雁门山水 其一","author":"屈大均","text":"斗绝开双阙，浮云莫与齐。\n一夫当贾屋，干骑阻磨笄。\n白草龙沙阔，黄天雁塔低。\n使君多古意，秋爽共攀跻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8990,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"陪陈使君游雁门山水 其二","author":"屈大均","text":"派水重陉出，愁人独漉过。\n流离辞广武，呜咽入滹沱。\n欲把浮萍寄，其如饮马多。\n王公爱行潦，明信愿无他。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8991,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送田丈自代返秦将登华岳 其一","author":"屈大均","text":"艰难随雨雪，边马急归心。\n赵塞辞句注，秦关向华阴。\n晴开天井阁，夜听羽人琴。\n两戒河山首，无令壮志侵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8992,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送田丈自代返秦将登华岳 其二","author":"屈大均","text":"春阴连朔漠，白日惨无多。\n喜别楼烦道，愁听敕勒歌。\n东峰襟玉女，西瀑泻黄河。\n最忆神灵岳，期君扫薜萝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8993,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"繁峙道中赠赵侯苍篆","author":"屈大均","text":"三泉从太戏，西下作滹沱。\n白日秋来少，黄云战后多。\n弯弓随大猎，扣剑和清歌。\n回首人烟里，城楼接二峨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8994,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"闻雁","author":"屈大均","text":"雁门无数雁，一夜尽南飞。\n我忆罗浮暖，难将雨雪违。\n愁来弄羌笛，梦里著莱衣。\n明岁梅花发，乡园归未归。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8995,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"岁暮送李天生出雁门","author":"屈大均","text":"雄关高柳北，鸿雁出其中。\n天井开句注，长城接大同。\n青苔馀战骨，白草失离宫。\n岁暮多风雪，愁君一转蓬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8996,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"答天生","author":"屈大均","text":"蒲柳先秋落，河山异代倾。\n报恩无剑术，乞食有箫声。\n海鹤双栖少，边雕自猎轻。\n君怜慈母在，高义赠生平。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8997,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"述婚 其一","author":"屈大均","text":"岂意飘萍客，天涯得好仇。\n佳期牛女夕，独立凤凰楼。\n玉帛迎秦塞，笙歌入代州。\n威仪应敬尔，拜手荷天休。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8998,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"述婚 其二","author":"屈大均","text":"三星光邂逅，揽执合欢襦。\n天使朱弦续，人怜蕙草苏。\n鹿车归故里，鱼鲙奉慈姑。\n万里成婚媾，恩情良独殊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":8999,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"述婚 其三","author":"屈大均","text":"慈闱黄鹄苦，子舍白华贫。\n菽水凭诸弟，关山隔一春。\n乱离鸡在国，高尚亦依人。\n庑下须裘褐，相将作隐沦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9000,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"述婚 其四","author":"屈大均","text":"霸陵能共隐，不复慕姬姜。\n乐我惟綦缟，娱亲在酒浆。\n心悬珠海月，泪洒雁门霜。\n愿作双鸿鹄，南飞返故乡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9001,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"初春代州作","author":"屈大均","text":"二峪冰犹壮，三关草欲薰。\n积阴开白日，春色散黄云。\n帐小争人合，沙平猎马分。\n武皇诸乐府，遗响在罗裙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9002,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广昌","author":"屈大均","text":"此地蜚狐塞，神京一线通。\n长城带天末，古戍接云中。\n马踏三秋雪，鹰吟万里风。\n河流声太苦，应为客途穷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9003,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浮图峪","author":"屈大均","text":"石路飞狐入，天梯束马过。\n峰头千仞堞，峪口两重河。\n榆柳新秋少，牛羊落日多。\n往时高杀气，诸将此横戈。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9004,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"紫荆关","author":"屈大均","text":"天半旗台起，霞连落日黄。\n山开关路小，河绕塞垣长。\n蹴鞠将军戏，酡酥上客觞。\n夜来笳鼓动，凄切助思乡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9005,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"大同旅次","author":"屈大均","text":"独宿天难曙，孤征日易曛。\n梦魂青冢月，涕泪白登云。\n书断随阳雁，笳连守冻军。\n代王宫咫尺，砧杵更愁闻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9006,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"边夜","author":"屈大均","text":"万古明妃月，光含汉苑愁。\n吹来龙塞影，散作雁门秋。\n白露沾衣湿，天河接泪流。\n南飞鸿雁尽，何处寄离忧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9007,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"已恨","author":"屈大均","text":"已恨关山阔，还愁鼓角悲。\n家贫难在外，年长易伤离。\n弟妹农桑苦，园林雨雪迟。\n梦中见慈母，白发总如丝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9008,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"代州夏日冯方伯招饮故大司马白谷孙公园亭即席赋 其一","author":"屈大均","text":"何以炎洲翠，而辞大庾梅。\n因君有琼树，故拂羽仪来。\n峨口朝霞起，圭峰暮雨开。\n殷勤赋公宴，持以答金罍。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9009,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"代州夏日冯方伯招饮故大司马白谷孙公园亭即席赋 其二","author":"屈大均","text":"当年大司马，手植此蒲莲。\n池引滹沱水，堂开紫府烟。\n沙场功不遂，薤露恨空传。\n苔径馀行迹，劳君拂绮钱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9010,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"代州夏日冯方伯招饮故大司马白谷孙公园亭即席赋 其三","author":"屈大均","text":"昔同浣纱女，弄楫太湖亭。\n南北穿莲叶，东西入洞庭。\n何期句注塞，亦有采香泾。\n无数芙蓉发，山光映水青。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9011,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雁门","author":"屈大均","text":"雁门十八隘，天欲界华夷。\n主父长城在，蒙恬古戍移。\n雄图归竖子，王气走燕支。\n万古扶苏谷，泉声尚恨斯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9012,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"再送天生携家自代返秦 其一","author":"屈大均","text":"他夕高堂乐，倾觞河汉边。\n天教儿女月，长在掌中圆。\n花萼连韦曲，田园傍渭川。\n从今衣带缓，宴会复何年。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9013,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"再送天生携家自代返秦 其二","author":"屈大均","text":"祝牧思偕隐，行行负戴难。\n青霞悲自郁，白首畏人看。\n朔雪先花发，炎风到海寒。\n鸡鸣频送尔，带梦上征鞍。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9014,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"再送天生携家自代返秦 其三","author":"屈大均","text":"招摇直双华，河伯汇三秦。\n泰时神明地，宗周礼乐人。\n霞流明月满，露浣白华新。\n不共千秋业，离居惜此晨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9015,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"平城","author":"屈大均","text":"往日平城困，阏氏畏汉威。\n三军方彀弩，一角忽开围。\n娘子城犹在，陈平计不非。\n只今频月晕，谁复救龙旂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9016,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将从雁代返岭南留别程周量 其一","author":"屈大均","text":"汉垒悬高柳，胡门控太行。\n三年愁出塞，万里梦还乡。\n马陷浑河雪，裘沾白草霜。\n无才营菽水，萧杀一行装。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9017,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将从雁代返岭南留别程周量 其二","author":"屈大均","text":"太华当秦阙，终南作汉标。\n图书藏玉井，儿女下青霄。\n信美非桑梓，言归逐海潮。\n三闾元隐士，费尔小山招。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9018,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将从雁代返岭南留别程周量 其三","author":"屈大均","text":"高高峨口月，万里照边愁。\n白雁衔霜信，明河挂戍楼。\n庭闱南海隔，井臼朔天留。\n去住难为计，悲歌历九秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9019,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将从雁代返岭南留别程周量 其四","author":"屈大均","text":"流落真无计，依人古所难。\n自怜因老母，不敢谢长安。\n骨肉归相保，关山去正寒。\n劳君治行李，歧路泣相看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9020,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将从雁代返岭南留别程周量 其五","author":"屈大均","text":"岂少簪缨客，无如桑梓情。\n相依期白首，此别见平生。\n孝友惭诸弟，诗歌慕两京。\n才华竟何益，早去事躬耕。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9021,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将从雁代返岭南留别程周量 其六","author":"屈大均","text":"炎洲山水好，秀色满烟霄。\n与子为兄弟，东西若二樵。\n相怜皆翡翠，自媚一兰苕。\n此日京华隔，予行秋泬寥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9022,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将从雁代返岭南留别程周量 其七","author":"屈大均","text":"声诗满京国，大雅似君稀。\n不有黄钟奏，谁知白纻非。\n先公多乐府，西汉一音徽。\n更作离骚传，佳人志不违。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9023,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将从雁代返岭南留别程周量 其八","author":"屈大均","text":"罗浮双岳峙，一半是蓬莱。\n风雨时离合，波潮若往回。\n宁无蝴蝶洞，不及凤凰台。\n文献曲江后，须君接武来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9024,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"答王阮亭","author":"屈大均","text":"朝攀枫树吟，暮拂洞庭琴。\n楚客元多怨，淮王最赏音。\n先臣有芳草，移植罗浮阴。\n采撷沾行露，凭将答所钦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9025,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"答锡鬯","author":"屈大均","text":"白日今谁照，途穷总苦辛。\n乱离难自食，高尚易违亲。\n水咽扶苏谷，花悬紫塞尘。\n凄凄知己泪，千载一沾巾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9026,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"马上","author":"屈大均","text":"马上听横吹，征夫心最悲。\n边云多惨淡，陇水易流离。\n翠嶂盘陵邑，浑河绕岳祠。\n时艰思用武，未忍采华芝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9027,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"望田子","author":"屈大均","text":"天寒宜射猎，君向大同川。\n紫兔悬鞍后，银筝在马前。\n沙城迷积雪，岳树出晴烟。\n日暮行人尽，关门待玉鞭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9028,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠楚客","author":"屈大均","text":"声诗江汉始，莫谓楚无风。\n我祖离骚赋，人称小雅同。\n明珠贻下女，香草惠童蒙。\n之子荆南起，还将乐府工。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9029,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别颜修来 其一","author":"屈大均","text":"斗柄垂双华，龙门控大河。\n精灵从此得，哀乐向来过。\n白帝开珠阙，苍龙引玉珂。\n登临吾与汝，万古一高歌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9030,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别颜修来 其二","author":"屈大均","text":"我忆炎洲好，乘秋返故乡。\n鹧鸪长向日，桂树不惊霜。\n别酒愁燕市，征车苦太行。\n青云君已达，应自惜圭璋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9031,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"同陈子游五台作 其一","author":"屈大均","text":"公子追康乐，名山挟少文。\n觞浮二峨水，马蹴五台云。\n北岳连阴翠，黄沙似夕曛。\n酒酣能射虎，不必李将军。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9032,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"同陈子游五台作 其二","author":"屈大均","text":"并骑登岩岫，行行红叶深。\n五峰秋积雪，双瀑日穿林。\n孤鹤先知曙，神龙善处阴。\n先朝钟鼓在，草莽最惊心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9033,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"同陈子游五台作 其三","author":"屈大均","text":"雪杂山花落，随风入翠微。\n冰崖愁马滑，霞壁羡猿飞。\n高尚何曾得，佯狂亦觉非。\n林泉殊可住，无奈隔庭闱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9034,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"答杜子","author":"屈大均","text":"万里高堂月，光从涨海来。\n衣裘军幕冷，笳管戍楼哀。\n高举思黄鹄，娇歌厌落梅。\n音书频报尔，秋别白登台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9035,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"武安君庙","author":"屈大均","text":"往日多奇阵，飞扬教射夫。\n守真如处女，出即扫林胡。\n伏腊三关泪，兼并百战图。\n代州祠畔月，英爽飒虚无。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9036,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"唐晋王祠墓 其一","author":"屈大均","text":"代北威名著，飞扬射马鞭。\n长安回帝驾，天祐纪臣年。\n三矢山河启，千秋俎豆悬。\n从来赐姓者，独有晋王贤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9037,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"唐晋王祠墓 其二","author":"屈大均","text":"发愤收京阙，当时节度无。\n奸雄纷割据，父子一征诛。\n辇路迷秋草，陵门怨夜乌。\n三垂冈上泪，老去惜雄图。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9038,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"唐晋王祠墓 其三","author":"屈大均","text":"何代丹青妙，雄姿动武皇。\n精灵犹白日，弓剑已秋霜。\n石马嘶风急，沙河绕塞长。\n应州金凤井，霸气共苍苍。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9039,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"九日","author":"屈大均","text":"西风吹白雁，天半落秋声。\n感此无衣客，登高赋不成。\n并门横大漠，涞水绕长城。\n惜别那能醉，樽中酒自清。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9040,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠故将军","author":"屈大均","text":"无事客辽西，名王共角抵。\n飞腾空射虎，汗血枉成泥。\n苏武犹生子，要离已衅妻。\n无繇持报汉，愁向朔云啼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9041,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"晋祠 其一","author":"屈大均","text":"风雷缠一水，松柏贯双溪。\n注向横汾北，来从悬瓮西。\n霸图烟漠漠，王迹草萋萋。\n蟋蟀催迟暮，王孙思欲迷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9042,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"晋祠 其二","author":"屈大均","text":"一水称难老，交流出晋阳。\n东西穿古柏，左右结飞梁。\n报祀追桐叶，雍容见衮裳。\n金沙不可拾，月照一苍苍。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9043,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"平刑 其一","author":"屈大均","text":"全晋咽喉地，城横万叠山。\n西屏句注塞，东控紫荆关。\n砧杵三秋急，旌旗一代閒。\n天心元朔漠，临眺且开颜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9044,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"平刑 其二","author":"屈大均","text":"塞垣寒太早，裘马凛秋分。\n山雪争初日，河冰乱白云。\n一关天上度，双角月中闻。\n故国南归好，无因逐雁群。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9045,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"武灵王墓","author":"屈大均","text":"威灵传主父，四战霸山东。\n六国朱旗却，三胡紫塞空。\n沙丘留大冢，夏屋失离宫。\n长技开中国，谁思骑射功。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9046,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送田子之应州","author":"屈大均","text":"桑浑二水合，缭绕塔儿城。\n知远基王迹，沙陀起义兵。\n黄风吹日落，白草与天平。\n太守君知己，诗应奋夏声。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9047,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"代州冯氏园亭赋呈主人杨冯甥舅 其一","author":"屈大均","text":"叠嶂纷苍翠，随云渡水来。\n芙蕖方伯沼，杨柳尚书台。\n试马分金埒，流莺送玉杯。\n主人挟丝管，更欲画船开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9048,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"代州冯氏园亭赋呈主人杨冯甥舅 其二","author":"屈大均","text":"花飞棋局乱，月出射堂高。\n易饮兰英酒，难酬金错刀。\n荒淫三楚秀，游侠五陵豪。\n万里成欢宴，笙歌莫告劳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9049,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"代州冯氏园亭赋呈主人杨冯甥舅 其三","author":"屈大均","text":"雁门旌节罢，宾客少逢迎。\n之子连甥舅，诸侯托友生。\n依人意气尽，失路羽毛轻。\n慷慨抚长剑，知君亦不平。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9050,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"代州冯氏园亭赋呈主人杨冯甥舅 其四","author":"屈大均","text":"江南少鸿雁，塞北足鸳鸯。\n送老凭歌管，违亲为稻粱。\n云含阴馆尽，城与朔天长。\n与子将分手，谁堪此战场。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9051,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"夏日清宴堂小集","author":"屈大均","text":"高馆清和候，披襟化气薰。\n菲菲怜细草，黠黠望重云。\n捉麈谈秋水，衔觞待夕曛。\n边庭人事少，游戏莫离群。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9052,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送汪生","author":"屈大均","text":"北纪山河曲，中都雨雪边。\n客来秋屡晏，人去月空圆。\n梦绕三关道，愁连万里天。\n离亭频折柳，送尔更凄然。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9053,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"代昭生朔州客邸作","author":"屈大均","text":"坐见星河落，思乡寐不成。\n边风吹鬓尽，朔酒带愁倾。\n五岳非予志，双鬟送此生。\n皇天憎管乐，已矣罢经营。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9054,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]