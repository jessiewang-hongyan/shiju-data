[{"title":"春山漫兴","author":"王夫之","text":"千心一病总消除，随处中原且卜居。\n馀草舜根堪药裹，安流禹治付苍书。\n枕函带梦花阴徙，钓竹过春筱尾舒。\n雾眼能留临曲沼，桃花虽谢长芙蕖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2110,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"挽烈妇廖周氏","author":"王夫之","text":"冒刃扶姑命，躯残刃折铓。\n至今荒冢里，赢得血痕香。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2111,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"悼亡四首 其一","author":"王夫之","text":"十年前此晓霜天，惊破晨钟梦亦仙。\n一断藕丝无续处，寒风落叶洒新阡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2112,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"悼亡四首 其二","author":"王夫之","text":"读书帷底夜闻鸡，茶灶松声月影西。\n閒福易销成旧憾，单衾愁绝晓禽啼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2113,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"悼亡四首 其三","author":"王夫之","text":"生来傲骨不羞贫，何用钱刀卓姓人。\n撒手危崖无著处，红炉解脱是前因。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2114,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"悼亡四首 其四","author":"王夫之","text":"记向寒门彻骨迂，收书不惜典金珠。\n残帷断帐空留得，四海无家一腐儒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2115,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"十六字令 落花影二首 其一","author":"王夫之","text":"落花影，款款映春江。\n终相就，贴水不成双。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2116,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"十六字令 落花影二首 其二","author":"王夫之","text":"落花影，风飐小桥西。\n掠素袷，疑是染香泥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2117,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"捣练子 晚春","author":"王夫之","text":"云似梦，雨如尘。\n花泪红倾柳黛嚬。\n也算人閒春一度，明年莫更不还人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2118,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"如梦令 本意二首 其一","author":"王夫之","text":"花影红摇帘缝。\n苔影绿浮波动。\n风雨霎时生，寒透碧纱烟重。\n如梦。\n如梦。\n忒杀春光调弄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2119,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"如梦令 本意二首 其二","author":"王夫之","text":"如梦花留春住。\n还梦春随花去。\n一片惜春心，付与游丝飞絮。\n无据。\n无据。\n不觉梦归何处。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2120,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长相思 本意二首 其一","author":"王夫之","text":"宝刀分。\n宝钗分。\n绣带分开坠画裙。\n馀香犹自温。\n锦鸳群。\n野鸳群。\n三十六双认得真。\n旁人莫漫嗔。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2121,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长相思 本意二首 其二","author":"王夫之","text":"不思量。\n也思量。\n密语何曾得话长。\n惊鸿夜渡湘。\n真成双。\n假成双。\n侬似莲心苦薏藏。\n怜他菡萏香。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2122,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇 牡丹二首 其一","author":"王夫之","text":"春未分明，觌面始知韶日晓。\n朱凝粉袅。\n费尽春多少。\n人在绿窗，艳影朦胧绕。\n碧天杳。\n瑞云回含。\n锦襭空青表。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2123,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇 牡丹二首 其二","author":"王夫之","text":"不道人閒，消得浓华如许色。\n有情无力。\n殢着人相识。\n阅尽兴亡，冷泪花前滴。\n真倾国。\n沈香亭北。\n此恨何时释。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2124,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇 月桂","author":"王夫之","text":"蟾馆飞英，随他月在秋长在。\n冻云如黛。\n幻出香严界。\n曾订青娥，有誓深如海。\n春光改。\n清芳缥缈。\n还与山矾赛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2125,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇 碧桃","author":"王夫之","text":"碧海凝霜，问谁唤作春光住。\n绿烟轻处。\n月染幽香聚。\n缥缈云魂，旧厌霓裳舞。\n天台路。\n山空月冷。\n不管刘郎误。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2126,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇 矮桃","author":"王夫之","text":"绛襭盈盈，墙头怕惹游人顾。\n幽情谁诉。\n芳草萋萋处。\n燕眼偷窥，早倩绿云护。\n勤嘱付。\n低飞蛱蝶。\n莫惹香泥污。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2127,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"女冠子 卖姜词○余旧题茅堂日姜斋此更称卖姜翁非己能羡聊以补人之不足尔戏为之词且卖且歌之","author":"王夫之","text":"卖姜来也。\n谁是能酬价者。\n不须悭。\n老去丝尤密，酸来心愈丹。\n垂涎休自闷，有泪也须弹。\n最疗人閒病，乍炎寒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2128,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"女冠子 慈竹","author":"王夫之","text":"萧疏不可。\n簇簇绿烟深锁。\n一枝枝。\n乳凤梳翎细，游鳞蜕甲迟。\n天高难借问，风横怕相欺。\n且自团圞住，要谁知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2129,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 山行","author":"王夫之","text":"曲曲屏山翠幕垂。\n啼禽不拣浅深枝。\n逗人斜转竹林西。\n绿玉竿柔愁露浥，翠烟叶密耐风欺。\n溪光一半染玻瓈。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2130,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 过熊男公夜话","author":"王夫之","text":"炊稻烟阑煮笋香。\n溪流萦岫半斜阳。\n閒宵不觉剪灯长。\n鱼计向春元得水，蝶魂入梦不惊霜。\n无劳濠上讯蒙庄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2131,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 即景","author":"王夫之","text":"幸草犹馀几段残。\n烧痕斜插野鸡斑。\n灰堆无数米家山。\n双眼瞢腾疑梦觉，一天晴雨两阑珊。\n不愁也索带愁看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2132,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 望归雁","author":"王夫之","text":"病眼遥天认不真。\n一双双影未全分。\n空花摇曳乱春云。\n香篆欲消拖蔂尾，平波初皱起鱼鳞。\n乌丝阑染素笺纹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2133,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"霜天晓角 怀旧","author":"王夫之","text":"平湖春水。\n日落扁舟舣。\n话到伤心深处，双泪落、青樽里。\n天不。\n留愁绪。\n拚遣愁人死。\n刚有一丝春怨，又花落、鹃声止。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2134,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨鬘 早春","author":"王夫之","text":"梅花绽锦催寒去。\n霜花铺粉留寒住。\n去住两悽然。\n衰翁惜岁年。\n烧根红茁草。\n巳报春生早。\n莫惹晓莺啼。\n啼时花乱飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2135,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"添字昭君怨 秋怀","author":"王夫之","text":"谁染千山乌桕，欺杀一株衰柳。\n微霜何似镜中霜，万丝长。\n蜡屐从今几两，冰级当年屡上。\n夜阑星汉耿清空，挂残虹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2136,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"添字昭君怨 春怀","author":"王夫之","text":"茸草偏生南浦，桃叶半遮芳树。\n东风何用苦相催，缓缓来。\n刚倩柳绵黏住，又被落红勾去。\n麟洲闻有返魂香，海天长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2137,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"减字木兰花 冬尽","author":"王夫之","text":"烟笼残月。\n遮屋五更霜似雪。\n小爱东窗。\n逗漏玻瓈数点黄。\n梅风疏缓。\n冻蝶乍苏幽砌暖。\n生怕春生。\n生雨生风困早莺。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2138,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"减字木兰花 春怨","author":"王夫之","text":"落花飞絮。\n只有閒愁吹不去。\n雨雨风风。\n消受残春一梦中。\n苍烟碧霭。\n一望迷离天似海。\n燕燕莺莺。\n尽说离愁话不成。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2139,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"忆秦娥 镫花二首 其一","author":"王夫之","text":"心未冷。\n娟娟还弄斜阳影。\n斜阳影。\n半点红轻，一天烟暝。\n残香犹袅金猊鼎。\n泪痕微映鸳鸯枕。\n鸳鸯枕。\n如何落去，孤衾难整。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2140,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"忆秦娥 镫花二首 其二","author":"王夫之","text":"残膏少。\n零红难待春宵晓。\n春宵晓。\n灰飞无迹，更谁弄巧。\n朦胧睡眼微萦绕。\n疑无疑有幽光小。\n幽光小。\n破镜寒辉，死萤残照。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2141,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"清平乐 咏萤","author":"王夫之","text":"夕风乍定。\n冉冉穿芳径。\n曲沼欲寻鸳侣并。\n却是伶俜孤影。\n来回柳岸苔阴。\n不知露冷更深。\n几点残星未落，一弯斜月初沈。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2142,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"清平乐 嫩柳","author":"王夫之","text":"霏霏屑屑。\n略上些儿色。\n敛尽翠眉刚半缬。\n应是春光不彻。\n未妨雨细寒轻。\n绿波浅映盈盈。\n更着一分螺黛，和烟绾住流莺。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2143,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西江月 俗□","author":"王夫之","text":"到处冻脓络索，逢人㰤閜謰謱。\n无多弊摋总酸馊。\n罯得英雄沤□。\n傝?几分即溜，郎当一味鼾?。\n砰訇浪里囫囵游。\n谁受{满字去氵}干僝僽。","collection":"明末清初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2144,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南乡子 留别家兄","author":"王夫之","text":"老去别堪惊。\n日暮长亭亦短亭。\n镜里朱颜，唯梦里惺惺。\n刺柏堂前一字行。\n此去更无凭。\n药饵谁扶瘦骨轻。\n望断岳阡，魂缥缈伶俜。\n万叠烟波两叶萍。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2145,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹧鸪天 刘思肯画史为余写小像虽不尽肖聊为题之","author":"王夫之","text":"把镜相看认不来。\n问人云此是姜斋。\n龟于朽后随人卜，梦未圆时莫浪猜。\n谁笔仗，此形骸。\n閒愁输汝两眉开。\n铅华未落君还在，我自从天乞活埋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2146,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹧鸪天 藤蓑词○藤蓑白沙隐服五首 其一","author":"王夫之","text":"籊籊江门旧钓竿。\n如今落手尽清閒。\n鳞鳞三六双双鲤，历历千重叠叠山。\n斜月落，晓霜残。\n藤蓑耐得一江寒。\n橛头信水亭亭去，鲸浪惊雷午梦安。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2147,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹧鸪天 藤蓑词○藤蓑白沙隐服五首 其二","author":"王夫之","text":"拾得藤蓑挂破船。\n芦汀柳岸两悠然。\n曈昽海日生残夜，烂漫江春入旧年。\n霞散绮，绿飞烟。\n侬家何处不青天。\n星辰滥摘从人买，只索苔阴数颗钱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2148,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹧鸪天 藤蓑词○藤蓑白沙隐服五首 其三","author":"王夫之","text":"不唱江门旧棹歌。\n人閒今古有藤蓑。\n况逢木落天空后，柰此风清月白何。\n穿衰柳，度残荷。\n一行白鸟掠清波。\n孤吹铁笛腾腾去，惊落残花罥女萝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2149,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹧鸪天 藤蓑词○藤蓑白沙隐服五首 其四","author":"王夫之","text":"云自垂垂水自流。\n藤蓑晴晒钓鱼舟。\n蓼花双映迎红粟，鹭影斜拖颤玉钩。\n从阐缓，尽搂搜。\n丹枫叶落不关愁。\n閒愁只为多愁客，镜里狂寻头上头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2150,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹧鸪天 藤蓑词○藤蓑白沙隐服五首 其五","author":"王夫之","text":"藤蓑别样有新裁。\n不打江门旧谱来。\n自怜艇子容双桨，不羡鲈鱼有四腮。\n帆已挂，柁频开。\n掀涛拍岸且徘徊。\n涪翁漫道风波险，似此风波亦快哉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2151,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"虞美人 落花","author":"王夫之","text":"柳风催送横天雨。\n自是难留住。\n更无消息教人知。\n不解一宵惊去、定因谁。\n香膏酿出红芳密。\n费尽东风力。\n到来无绪恋东风。\n为爱半溪流水、㬉溶溶。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2152,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"临江仙 山矾","author":"王夫之","text":"本是玉玚天上种，几时还驻云軿。\n檀心粉颊两盈盈。\n香迷双嫩蝶，熏恼一林莺。\n手折一枝相借问，何如蟾阙秋清。\n东君着意更殷勤。\n朦胧烟月㬉，骀宕柳风轻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2153,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蝶恋花 早秋","author":"王夫之","text":"落日青空分燕尾。\n一片残云，犹作孤峰紫。\n剪剪白蘋风歘起。\n藕花露滴清波里。\n为问贴天双燕子。\n底事能忘，辛苦春前垒。\n回首垂杨无限意。\n无情也应悲秋死。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2154,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蝶恋花 春景","author":"王夫之","text":"薄日蒸云光影碎。\n白霭濛濛，罩住春山睡。\n一树梨花轻雾里。\n玉山斜倚冰绡醉。\n半吐山矾香孕蕊。\n小步寻春，好了莺花事。\n莫待楝花花信至。\n子规难挽东流水。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2155,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"醉春风 遣病","author":"王夫之","text":"未了游丝债。\n莫被浮云碍。\n鸡声历历曙光微，在。\n在。\n在。\n月挂西楼，风轻柳岸，虹垂天外。\n但遣愁城坏。\n不怨霜荷败。\n情知腊尽雪须消，耐。\n耐。\n耐。\n未必他生，还如今日，长年禁害。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2156,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"青玉案 忆旧","author":"王夫之","text":"桃花春水湘江渡。\n纵一艇、迢迢去。\n落日赪光摇远浦。\n风中飞絮，云边归雁。\n尽指天涯路。\n故人知我年华暮。\n唱彻灞陵回首句。\n花落风狂春不住。\n如今更老，佳期逾杳。\n谁倩啼鹃诉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2157,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"江城子 咏雪二首 其一","author":"王夫之","text":"依依欲待人帘栊。\n怕回风。\n怨回风。\n一霎惊飞、吹过小桥东。\n梅信未来枫叶尽，谁款款，与从容。\n前溪流水忒匆匆。\n拚孤踪。\n碧波溶。\n冷淡魂消、旧恨有无中。\n不似柳绵归计晚，人只解，惜残红。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2158,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"江城子 咏雪二首 其二","author":"王夫之","text":"惊风淅沥渐无声。\n恰泠泠。\n早盈盈。\n促拍悲丝、转入凤笙清。\n唤醒梅花月下梦，看咫尺，有瑶京。\n人閒何用久留情。\n晓风轻。\n晓烟晴。\n流水斜阳、莫惜玉山倾。\n解释消沈千种恨，明镜里，鬓丝横。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2159,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"祝英台近 初夏","author":"王夫之","text":"碧莎蹊，菖叶渡，寂寞寻芳处。\n梅雨无凭，更把残红误。\n清池几片荷钱，浮萍相乱，留不住、泪珠如雨。\n空凝伫，柳枝低亸夕阳，犹作旧时舞。\n也自无聊，怕惹香泥污。\n问双飞乳燕何心，閒情閒绪，向枝上、娇憨对语。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2160,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"满江红 初夏","author":"王夫之","text":"霞映晴空，惊晓梦、馀寒消尽。\n日影转、绿阴叠叠，碎痕红印。\n燕子归来憨不语，柳塘樾径都相认。\n尽从今、长日小楼空，无人问。\n浮萍叶，鱼难信。\n商陆子，鹃犹恨。\n怕黄梅雨浥，湿烟还困。\n记得年时游冶处，轻衫碧映荷钱嫩。\n奈柳丝、閒挂葛巾斜，窥霜鬓。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2161,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"满江红 新月","author":"王夫之","text":"远碧无涯，但约略、清光瑩澈。\n凝望处、谁匀松玉，斜分云叶。\n幽魄可怜凉似水，一丝浅漾冰纹缬。\n问青天、何事送新愁，从谁说。\n栖不稳，惊禽咽。\n风不定，波光叠。\n眄南枝高处，素痕明灭。\n认得遥山青不了，半峰微露峨眉雪。\n便迢迢、飞梦入层霄，还孤怯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2162,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"满江红 忆旧","author":"王夫之","text":"镫影萧疏，身还在、为谁消受。\n拚尽了、月下吹笙，花前纵酒。\n寂寂仲华今已老，太阿知我还知否。\n向中宵、寒铁喷清光，雌龙吼。\n骨已白，黄泉友。\n魂已杳，黄头妇。\n便长吟梁父，溪山非旧。\n飞尽楝花天不管，韶华难得春风又。\n听啼鸦、啼彻五更心，栖衰柳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2163,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"满庭芳 重九","author":"王夫之","text":"芦展霜英，蓼开红粟，三分秋在堪怜。\n芙蓉木未，午压绛痕鲜。\n似欲将人共醉，何须问、谁健他年。\n吹不去，当头皂帽，直上有青天。\n飞仙曾授我，汝南真诀，壸里清元。\n已住云山，绝顶芸尽芝。\n田何处更寻高，巘累芒、鞋竹杖横。\n肩凝眸处，齐州数点，万里罩平烟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2164,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"水调歌头 咏怀","author":"王夫之","text":"钓竿落吾手，意不在鱼边。\n六鳌何处，一艇缥渺凌孤烟。\n耐可乘流直上，不避回风吹转，蹴破浪花圆。\n一曲棹歌里，星斗落帆前。\n白蘋洲，芳草渡，扣哀弦。\n落花细数，坐久目送荇丝牵。\n出入无肠国里，烂漫无愁天上，鼎鼎度华年。\n唯有千丝雪，镜里自相怜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2165,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"黄莺儿 苦雨","author":"王夫之","text":"昏昏昏晓忘春曙。\n几尺幽窗，半掩苍苔，一抹青山，平铺飞絮。\n似酒醒乍扶头，镫灺难留炷。\n沈沈天海濛濛，早把韶光，暗里消去。\n拚与。\n白鸟荡银波，清猿隐高树。\n芭蕉几叶，莫有绿肥，轻寒依然勒住。\n想流水小桥东，密筱浓阴处。\n应有怨老莺声，细把閒愁诉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2166,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"高阳台 蛛丝落叶","author":"王夫之","text":"拚却无情，更谁厮惹，西风檐角萧萧。\n留看人閒，斜阳一晌光摇。\n蘋花应笑归期误，又争知、孤绪无聊。\n被殢人，轻蝶憨憨，片影相撩。\n天涯一梦迢迢，任露侵衰草，月冷危桥。\n便随尘土，离魂不倩人招。\n前时难忆藏鸦处，有归飞、孤雁低邀。\n望谁为，并刀一剪，剪断情苗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2167,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"念奴娇 咏蝶","author":"王夫之","text":"流莺啼遍，唤不醒芍药，丛中双蝶。\n待把红香留住稳，无待雨狂风劣。\n流水浮萍，垂杨飞絮，都是閒枝节。\n殷勤为甚，飘零了不孤怯。\n纵好绣带云裳，来回弄影，荡芳情一捻。\n日暮帘垂归燕语，池上晚风猎猎。\n渺渺天涯，归魂何处，便是烟花劫。\n无人说与，阳关梦里三叠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2168,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"念奴娇 对镜","author":"王夫之","text":"閒愁自昔，到如今当得，雪欺霜负。\n云亚天低抬不起，随意白衣苍狗。\n剑跃双龙，笔摇五岳，也是閒筋斗。\n蝶黏蛛网，丝毫动得还否。\n别有一线霏微，轻丝杪忽，系蟠泥秋藕。\n一恁败荷凋叶尽，自有玉香灵透。\n眉下双岩，电光犹射，独运枯杨肘。\n无情日月，也须如此消受。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2169,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]