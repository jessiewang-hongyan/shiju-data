[{"title":"西江月 其九 芦笔","author":"尤侗","text":"书带草生笔冢，墨池人在芦中。\n白头翁变黑头公。\n夜夜飞花入梦。\n画荻教成孺子，编蒲学近儒宗。\n雁行衔去向江东。\n写出锦书珍重。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2992,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西江月 其十 橘灯","author":"尤侗","text":"金颗千头火树，玉荷四照霜花。\n书生怀袖向窗纱。\n长伴红衣不夜。\n心事任教分剖，风光尚费周遮。\n美人对影暗嗟呀。\n决意为郎吹罢。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2993,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西江月 其十一 核桃船","author":"尤侗","text":"种自玄都道士，载从渡口渔翁。\n小儿偷出碧云宫。\n顷刻帆樯飞动。\n芦苇似来江上，竹枝疑泛图中。\n桃根桃叶棹歌同。\n两桨春风吹送。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2994,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西江月 其十二 莲蓬人","author":"尤侗","text":"妾比芙蓉解语，郎如碧藕多思。\n个人憔悴倒悬时。\n知道无心怜子。\n空洞此中无物，崛起犹昔孤支。\n乱头粗服貌如斯。\n未必六郎相似。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2995,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南柯子 其一 懒懒和卿谋韵","author":"尤侗","text":"侍女休催绣，才郎莫画眉。\n春来常倩梦追随。\n只为罗衣、不耐晓风吹。\n垂手嫌红袖，凭肩恋锦帷。\n生憎花影学人窥。\n央得鹦哥、传语却忘谁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2996,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南柯子 其二 旅中苦雨","author":"尤侗","text":"土雨埋荒草，金风剪败荷。\n行人滑滑奈泥何。\n不道梦魂、夜夜渡滹沱。\n遣兴搜书里，关愁伴枕窝。\n孤衾早怯晓寒多。\n试问江南、小阁尚轻罗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2997,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"醉花阴 其一 闺病","author":"尤侗","text":"海棠夜向西风哭。\n瘦损枝头玉。\n秋雨冷啼妆，半枕红痕，泪染罗裙绿。\n药烟细袅湘帘曲。\n镜掩芙蓉褥。\n闲杀画眉人，懊恼文君，倒犯相如狱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2998,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"醉花阴 其二 寒食","author":"尤侗","text":"春光百五浑依旧。\n细雨宵来凑。\n未到落红时，默默东风，已向桃花咒。\n江城客居孤单候。\n白日清寒透。\n天意也销魂，捲尽疏烟，禁得垂杨瘦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":2999,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"双调望江南 其一 西山烧香曲","author":"尤侗","text":"清早起，天色趁新晴。\n飞鬓斜拖双燕翠，画衣薄衬小鸦青。\n素裹玉丁丁。\n回镜照，时样称人情。\n多分拼教游子看，私先殃及侍儿评。\n公论是轻盈。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3000,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"双调望江南 其二 西山烧香曲","author":"尤侗","text":"呼女伴，好趁一春闲。\n红板浪船行缓缓，白藤山轿坐端端。\n低扇避人看。\n拜佛罢，本意不相关。\n戏买粉孩敲木棒，强分叶子赌金环。\n图得大家顽。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3001,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"杏花天 旅思","author":"尤侗","text":"消磨白日浑无计。\n算只有短眠长睡。\n归梦做来千万次。\n纸上重重牢记。\n相思样子都相类。\n换不出思乡新意。\n悬知闺梦多佳事。\n得个书儿题寄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3002,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浪淘沙 其一 楼上愁和卿谋韵","author":"尤侗","text":"赢得许多愁。\n岁月悠悠。\n秋风秋雨冷双眸。\n欲赠湘君搴杜若。\n难问芳洲。\n长啸倚南楼。\n霜鬓飕飕。\n栏杆拍遍把吴钩。\n惆怅归来无个事，又上灯篝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3003,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浪淘沙 其二 楼上愁和卿谋韵","author":"尤侗","text":"回首仲宣楼。\n浩浩江流。\n楚云湘雨几家收。\n画角西风声一片，烽火神州。\n准拟泛新愁。\n一叶扁舟。\n珠帘捲尽雁行秋。\n无赖梦魂飞不定，何处相留。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3004,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浪淘沙 其三 咏昭君套","author":"尤侗","text":"一握小丁貂。\n艳色茸毛。\n金珰满座总粗豪。\n妆向美人头上去，别样妖娆。\n双尾鬓云交。\n秀映眉梢。\n若教上马更多娇。\n从此香闺添小字，唤作昭昭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3005,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浪淘沙 其四 感旧","author":"尤侗","text":"故旧半凋残。\n满目青山。\n姓名恍惚古人看。\n追忆平生都似梦，今日魂还。\n老去鬓毛斑。\n努力加餐。\n百年应作六如观。\n世事浮云君莫管，还我渔竿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3006,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浪淘沙 其五 题刘六皆桃源图","author":"尤侗","text":"红树满青山。\n涧水潺潺。\n烟霞无恙洞门关。\n前度刘郎今又至，绿鬓微斑。\n花下倚双鬟。\n一笑追欢。\n胡麻屑饭劝加餐。\n莫学淮南天上去，鸡犬云间。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3007,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹧鸪天 其一 和叶小鸾梦中作","author":"尤侗","text":"口咏金经手采香。\n自言自笑自相忘。\n云游瑶碧三山远，舟戏珊瑚一水长。\n花筑榭，树回廊。\n闲持藜杖逐流光。\n何人松下敲棋坐，子落丁丁犹费忙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3008,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹧鸪天 其二 题吴冰仙画","author":"尤侗","text":"拂水佳人堕马妆。\n春来响屧满横塘。\n绣襦甲帐无消息，暮雨潇潇空断肠。\n笔翡翠，砚鸳鸯。\n吴绫三尺写红窗。\n青山碧水无人处，乱点桃花赚阮郎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3009,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"河传 戏拟闺中十二月乐词  其一 正月","author":"尤侗","text":"新年吉利。\n华胜妆钗，宜春贴字。\n檀郎把酒，屠苏索醉。\n道儿家得岁。\n闹蛾满路鳌山会。\n猜灯谜。\n输了鸳鸯翠。\n却拉邻家姊妹。\n紫姑相伴戏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3010,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"河传 其二 二月","author":"尤侗","text":"春半社来飞燕。\n丽日花朝。\n茜裙扑蝶过红桥。\n垂腰折柳条。\n汉宫寒食新传火。\n贻雕卵。\n耍笑郎家果。\n墙头马上看秋千。\n喧阗。\n争分白打钱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3011,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"河传 其三 三月","author":"尤侗","text":"春午红雨。\n湔裙曲水，采兰江渚。\n万花舆。\n百子襦。\n伴侣。\n踏青芳草舞。\n拾来斗合鸳鸯谱。\n瑶环赌。\n赢取同心缕。\n晚还家。\n倚碧纱。\n周遮。\n金铃偷护花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3012,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"河传 其四 四月","author":"尤侗","text":"红英已谢。\n绿枝方亚。\n拂拂薰风。\n一番谷雨，晓来香透帘栊。\n鼠姑红。\n罗敷日日条桑下。\n缫丝罢。\n梅润罗裙钗。\n小窗闲处，提壶自试新茶。\n换轻纱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3013,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"河传 其五 五月","author":"尤侗","text":"佳辰重午。\n钗悬艾虎。\n臂缠彩缕。\n龙舟两两竞渡。\n画鼓。\n雕弓射角黍。\n兰汤浴罢蒲觞泛。\n红生面。\n窈窕摇葵扇。\n凭栏杆。\n亸髻鬟。\n阑珊。\n乞郎半夏丸。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3014,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"河传 其六 六月","author":"尤侗","text":"玉骨冰肌，天然无汗。\n纨素风来，鬘华香散。\n小池边。\n棹船歌采莲。\n昼长独抱青奴卧。\n桐阴破，枕畔金钗堕。\n起看明月上纱窗。\n萧郎。\n桃笙今夜凉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3015,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"河传 其七 七月","author":"尤侗","text":"高楼乞巧。\n綵花飞起，云霞缭绕。\n金钿七孔试穿针，袅袅。\n穿出双头巧。\n戏呼乌鹊填河去。\n凌波步。\n便唤郎来渡。\n渡来时。\n赴佳期。\n水嬉。\n银盆弄化儿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3016,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"河传 其八 八月","author":"尤侗","text":"琼楼玉宇。\n紫云霓羽。\n广寒何处。\n有人问月府。\n白衣歌舞。\n是嫦娥小女。\n月圆正值人圆夜。\n箫楼下。\n彩凤应同跨。\n泛金卮，弹锦丝。\n红儿。\n为郎折桂枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3017,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"河传 其九 九月","author":"尤侗","text":"重九。\n酌酒。\n茱萸遍插，频开笑口。\n小楼帘捲也登高。\n相邀。\n同餐小鹿糕。\n自怜人比黄花瘦。\n垂罗袖。\n瑞脑薰金兽。\n背罘罳。\n步庭墀。\n秋思。\n题诗梧叶儿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3018,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"河传 其十 十月","author":"尤侗","text":"春小。\n暖早。\n鹦哥报道。\n海棠开了。\n妆台乍晓。\n云髻新添通草。\n画衣飞翠鸟。\n琐窗容易斜阳下。\n香奁卸。\n无计消长夜。\n剪金凫。\n倒玉壶。\n胡庐。\n偷窥秘戏图。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3019,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"河传 其十一 十一月","author":"尤侗","text":"冬至。\n亚岁。\n日初长。\n八尺花间细量。\n新添宫线绣鸳鸯。\n尊章。\n檠将履袜双。\n六出花飞风絮起。\n毡炉底。\n瑞炭煎沉水。\n饮羊羔。\n弹凤槽。\n蛮腰。\n何妨夜夜娇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3020,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"河传 其十二 十二月","author":"尤侗","text":"岁暮。\n腊鼓。\n悬螺画虎。\n爆竹争喧，藏钩戏赌。\n女伴馈节如何。\n口脂翠管多。\n黄金泻水成双凤。\n梅妃弄。\n拟献椒花颂。\n向围炉劝酒，妾意与郎同。\n火儿红。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3021,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"河传 其十三 旅思","author":"尤侗","text":"川犬。\n民眼。\n凄凄孤馆。\n悠悠日晚，醒来谁伴。\n只剩残书败卷。\n昼长嫌梦短。\n天涯怅望云中树。\n江南路。\n点点疏星吐。\n何不归。\n何日归。\n相催。\n春风叫子规。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3022,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹊桥仙 其一 七夕","author":"尤侗","text":"玉钩画烛。\n金风箫鼓，迎送鹊桥云雨。\n鸳鸯债欠许多时，着意在、今宵赔补。\n才郎乞巧，佳人穿缕，痴绝不知甘苦。\n夜深宛颈睡双浓，那听得、人间私语。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3023,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹊桥仙 其二 佳人","author":"尤侗","text":"月眉星眼，烟鬟雾髻，浑是一天妆束。\n尤云殢雨更风流，甘折却、人间庸福。\n莺莺燕燕，红红翠翠，删尽侍儿名录。\n鸳鸯谱样总平常，新翻出、怜欢题目。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3024,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鹊桥仙 其三 落花","author":"尤侗","text":"乍晴乍雨，乍寒乍暖，做作几般天气。\n个人犹自不禁持，何计教、花魂回避。\n正青芳草，未衰杨柳，只短夭桃年纪。\n落红万点总无情，赚多少、香闺清泪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3025,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南乡子 其一 春愁","author":"尤侗","text":"红雨晓阑珊。\n寂寞梨花泪未干。\n飞絮满庭人倦起，偷怜。\n尽日鹦哥话夜寒。\n巫峡梦云单。\n懊恼春光一半残。\n索性闭门推却去，孤眠。\n独让东风自倚栏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3026,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南乡子 其二 病集药名","author":"尤侗","text":"弱骨怯天冬。\n满地黄花憔悴同。\n云母屏边休伫立。\n防风。\n乌头却似白头翁。\n自笑寄生穷。\n愁脉难将草木通。\n泉石膏肓甘遂老，从容。\n领取云山药饵功。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3027,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南乡子 其三 闺中除夕","author":"尤侗","text":"榾柮暖炉烟。\n笑劝屠苏称合欢。\n自爇沉檀供绣佛，低言。\n愿妾红颜胜旧年。\n隔夜整钗钿。\n守着梅花不去眠。\n更有一椿郎谶取，团圆。\n预乞明朝拜节钱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3028,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南乡子 其四 闺中元旦","author":"尤侗","text":"灯下了妆奁。\n玳瑁堂前春色添。\n万福归来无一事，憨憨。\n自揭薰笼换绣衫。\n迎喜出门檐。\n笑看家家下竹帘。\n瓜子满阶人莫扫，纤纤。\n曾带脂香唾舌尖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3029,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南乡子 其五 吊邹氏废园","author":"尤侗","text":"华屋委荒丘。\n萧瑟西风十二楼。\n留下空梁巢燕，啾啾。\n梦忆珠帘碧玉钩。\n歌舞彩云流。\n野草斜阳伴客愁。\n惟有青山依旧在，悠悠。\n看尽红颜又白头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3030,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南乡子 其六 席上戏赠女伶文玉","author":"尤侗","text":"珠箔舞蛮靴。\n浅立氍歈宛转歌。\n忽换猩袍红烛艳，瞧科。\n锦伞将军小黛蛾。\n鬒发尚盘螺。\n一瓣丝鞭燕尾拖。\n为待情人亲解取，谁何。\n春草江南细马驮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3031,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"虞美人 其一 怜病","author":"尤侗","text":"病魔才别书帷去。\n又借香奁住。\n恹恹瘦骨怯春纱。\n犹向药烟影里问残花。\n晓来强起妆台立。\n揽镜愁眉窄。\n侍儿且罢掠云鬟。\n恐怕春风多厉不胜寒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3032,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"虞美人 其二 虞美人花","author":"尤侗","text":"重华昔向苍梧死。\n羽亦重瞳子。\n至今舞草号虞兮。\n可似黄陵斑竹泣湘妃。\n君王莫恨江东小。\n暖日花光好。\n开时常对杜鹃红。\n一样暗伤亡国月明中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3033,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"虞美人 其三 石榴花","author":"尤侗","text":"李家妹子陶家姊。\n甘逐封姨死。\n石家房老剩翾风。\n好把小名醋醋换红红。\n艳妆底事心如火。\n生日逢重午。\n萧郎笑插玉人头。\n问道留侬侬去若为留。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3034,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"虞美人 其四 思归","author":"尤侗","text":"官街听彻三更鼓。\n缩脚寒衾苦。\n无眠终夜眼常开。\n那得巫山湘水梦魂来。\n隔江望断家乡路。\n小雪冬垂暮。\n扁舟归去未嫌迟。\n正是纸窗炉火芋香时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3035,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"玉楼春 其一 为黄大宗悼亡郭少君","author":"尤侗","text":"柔肠最怕伤心赋。\n听说埋香泪便堕。\n红颜惯是误青春，断送桃花一夜雨。\n飞琼携手瑶台路。\n应驾钿车游戏去。\n可堪抛向玉钩斜，梦散彩云无觅处。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3036,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"玉楼春 其二 为黄大宗悼亡郭少君","author":"尤侗","text":"落花急似三更漏。\n弱质盈盈才十九。\n杜鹃哭杀少年坟，小字彤碑碧血绣。\n萧郎梦断蘼芜后。\n宝镜鸳鸯难再偶。\n可怜薄命玉容人，值得挽歌三十首。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3037,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梅花引 晓行","author":"尤侗","text":"晓星稀。\n晓风低。\n晓月如霜冷射衣。\n晓鸡啼。\n晓鸡啼。\n啼上征鞍，朦胧古道西。\n水声呜咽行人泪。\n雁声嘹呖归人字。\n影凄其。\n影凄其。\n斑马频嘶，前村望酒旗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3038,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"踏莎行 其一 闺怨","author":"尤侗","text":"独上妆楼，青山如昨。\n画眉彩笔春来阁。\n休弹红雨湿花梢，泪珠自向心头落。\n可恨东风，年年轻薄。\n天涯不管人漂泊。\n漫将薄幸比杨花，杨花犹解穿罗幕。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3039,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"踏莎行 其二 题周宝蹬坐月浣花图","author":"尤侗","text":"坐月青莲，浣花工部。\n闺房之秀兼佳趣。\n燃脂写出丽人行，风鬟雨髻姗姗步。\n碧杜红兰，明珠翠羽。\n药房移傍湘君住。\n可怜荡子不归家，长吟荡妇秋思赋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3040,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"踏莎行 其三 题周宝蹬坐月浣花图","author":"尤侗","text":"放诞文君，风流樊素。\n殢人更在仓庚妒。\n武昌新柳自青青，生憎隔岸晴川树。\n欢晕红凝，愁眉绿聚。\n幽情难向狂夫诉。\n莫携此卷渡江来，津头有个兴风雨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3041,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"踏莎行 其四 客店","author":"尤侗","text":"残月在林，晨钟动野。\n行人惯听乌啼夜。\n一鞭古道又斜阳，村田看尽羊牛下。\n草席泥床，瓦盆茅舍。\n东餐西宿何时罢。\n孤灯半枕梦江南，隔帘惊起萧萧马。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3042,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"小重山 其一 金陵怀古","author":"尤侗","text":"依旧青山绕建康。\n南朝佳丽地、草茫茫。\n景阳脂井冷银床。\n秦淮月，犹照故宫墙。\n吊古石头冈。\n大江流日夜、几兴亡。\n鸡笼鼠雀满祠堂。\n君莫问，策蹇下斜阳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3043,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"小重山 其二 维扬旅思","author":"尤侗","text":"锦缆牙樯金犊车。\n竹西歌吹地、斗繁华。\n闲来独吊玉钩斜。\n隋宫女，为我诉琵琶。\n客梦绕天涯。\n江山虽窈窕、不如家。\n二分明月广陵花。\n一分月，斜照小窗纱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3044,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"临江仙 其一 迎春","author":"尤侗","text":"昨夜饯冬三寸雪，晓光俄报春回。\n绿杨青草媵红梅。\n东风齐着力，送入我门来。\n箫鼓綵毬迎去也，游人蚁走长街。\n珠帘影里笑金钗。\n老姬驮瘦马，儿戏唱低牌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3045,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"临江仙 遣兴二首 其二","author":"尤侗","text":"搔首问天天不语，光阴无计消磨。\n挑灯看剑自摩挲。\n浇胸冷热酒，拍手短长歌。\n遮莫英雄老去也，山林经济如何。\n平章重事到烟波。\n铙吹传玉鸭，水战教金鹅。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3046,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"临江仙 遣兴二首 其三","author":"尤侗","text":"少日驱车兼跃马，锦裘风雪行边。\n十年回首鬓萧然。\n蹇驴花下路，短笠渡头船。\n凭寄壮心歌舞地，绿樽翠袖红弦。\n不然散发事金仙。\n蒲团香影里，横槊自参禅。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3047,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"临江仙 其四 旧内","author":"尤侗","text":"六代青山依旧在，霸图吹断西风。\n行人驻马问离宫。\n游船建业水，旧寺景阳钟。\n百战精灵应未散，周郎独步江东。\n旌旗夜拥紫髯翁。\n漫追亡国恨，又见孝陵松。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3048,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"临江仙 其五 旧院","author":"尤侗","text":"十四楼前歌舞地，珠帘画障神仙。\n月明花底弄红弦。\n无双桃叶曲，最小莫愁年。\n战鼓催残金粉尽，空寻坠舄遗钿。\n香销南国忆婵娟。\n东风芳草绿，裙带我犹怜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3049,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"临江仙 其六 题汪蛟门锦瑟图","author":"尤侗","text":"二十四桥佳丽地，砚斋十二平分。\n江郎梦笔助奇文。\n情深聊尔尔，才妙漫云云。\n二十五弦弹夜月，花间锦瑟横陈。\n春风鬓影看文君。\n一窗三妇艳，谁雨复谁云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":3050,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]