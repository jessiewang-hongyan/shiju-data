[{"title":"宁远温泉","author":"方拱乾","text":"温与探汤异，边城旧擅名。\n无心何自热，有本得长清。\n调燮功谁擅，寒暄理自平。\n衰年苦萧飒，一濯已春生。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14891,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"晤林茂之时年八十五矣","author":"方拱乾","text":"群奉丈人行，相看若鼎彝。\n别时贫到骨，近日老能诗。\n结客前朝重，遗民后代知。\n嗟予随仗履，鬓发已如丝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14892,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"旧鹤","author":"方拱乾","text":"老鹤迎人作意鸣，三年前是一般声。\n别来何物不经变，知尔于人无所争。\n旧侣分飞怜独立，故交相遇倍多情。\n卫廷岂少乘轩辈，谁卧长松梦玉京。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14893,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广宁","author":"方拱乾","text":"医巫闾是望中山，指点残黎惨淡间。\n北镇祀谁凭享殿，南冠人尚恋榆关。\n光熹往事伤心久，刘杜征魂带血还。\n惭愧高冈祀李靖，纪功碑断藓花斑。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14894,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"译使至高丽","author":"方拱乾","text":"天荒地老更谁邻，属国惊闻接海滨。\n豺虎窟多中土客，风凰城是旧朝臣。\n泉刀重译旃裘雪，盐铁归装塞马春。\n试问为奴当日祖，流传《洪范》可能陈？","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14895,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其一","author":"吴伟业","text":"扬州明月杜陵花，夹道香尘迎丽华。\n旧宅江都飞燕井，新侯关内武安家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14896,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其二","author":"吴伟业","text":"雅步纤腰初召入，钿合金钗定情日。\n丰容盛鬋固无双，蹴鞠弹棋复第一。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14897,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其三","author":"吴伟业","text":"上林花鸟写生绡，禁本钟王点素毫。\n杨柳风微春试马，梧桐露冷夜吹萧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14898,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其四","author":"吴伟业","text":"君王宵旰无欢思，宫门夜半传封事。\n玉几金床少晏眠，陈娥卫艳谁频侍。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14899,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其五","author":"吴伟业","text":"贵妃明慧独承恩，宜笑宜愁慰至尊。\n皓齿不呈微素问，蛾眉欲蹙又温存。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14900,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其六","author":"吴伟业","text":"本朝家法修清宴，房帷久绝珍奇荐。\n敕使惟追阳羡茶，内人数减昭阳膳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14901,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其七","author":"吴伟业","text":"维扬服制擅江南，小阁炉烟沈水含。\n私买琼花新样锦，自修水递进黄柑。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14902,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其八","author":"吴伟业","text":"中宫谓得君王意，银镮不妒温成贵。\n早日艰难护大家，比来欢笑同良娣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14903,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其九","author":"吴伟业","text":"奉使龙楼贾佩兰，往还偶失两宫欢。\n虽云樊昵能辞令，欲得昭仪喜怒难。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14904,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其十","author":"吴伟业","text":"绿绨小字书成印，琼函自署充华进。\n请罪长教圣主怜，含辞欲得君王愠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14905,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其十一","author":"吴伟业","text":"君主内顾恤倾城，故剑还存敌体恩。\n手诏玉人蒙诘问，自来阶下拭啼痕。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14906,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其十二","author":"吴伟业","text":"外家官拜金吾尉，平生游侠多轻利。\n缚客因催博进钱，当筵便杀弹筝伎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14907,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其十三","author":"吴伟业","text":"班姬才调左姬贤，霍氏骄奢窦氏专。\n涕泣微闻椒殿诏，笑谭豪夺灞陵田。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14908,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其十四","author":"吴伟业","text":"有司奏削将军俸，贵人冷落宫车梦。\n永巷传闻去玩花，景和门里谁陪从！","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14909,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其十五","author":"吴伟业","text":"天颜不怿侍人愁，后促黄门召共游。\n初劝官家佯不应，玉车早到殿西头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14910,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其十六","author":"吴伟业","text":"两王最小牵衣戏，长者读书少者弟。\n闻道群臣誉定陶，独将多病怜如意。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14911,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其十七","author":"吴伟业","text":"岂有神君语帐中，漫云王母降离宫。\n巫阳莫救仓舒恨，金锁雕残玉箸红。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14912,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其十八","author":"吴伟业","text":"从此君王惨不乐，丛台置酒风萧索。\n已报河南失数州，况经少子伤零落。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14913,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其十九","author":"吴伟业","text":"贵妃瘦损坐匡床，慵髻啼眉掩洞房。\n豆寇汤温冰簟冷，荔支浆热玉鱼凉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14914,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其二十","author":"吴伟业","text":"病不轻秋泪沾臆，徘徊自绝君王膝。\n苔没长门有梦归，花飞寒食应相忆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14915,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其二十一","author":"吴伟业","text":"玉匣珠襦启便房，薤歌无异葬同昌。\n君王欲制《哀蝉赋》，诔笔词臣有谢庄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14916,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其二十二","author":"吴伟业","text":"头白宫娥暗嚬蹙，庸知朝露非为福。\n宫草明年战血腥，当时莫向西陵哭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14917,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其二十三","author":"吴伟业","text":"穷泉相见痛苍黄，还向官家问永王。\n幸免玉环逢丧乱，不须铜雀怨兴亡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14918,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其二十四","author":"吴伟业","text":"自古豪华如转毂，武安若在忧家族。\n爱子虽添北渚愁，外家已葬骊山足。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14919,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其二十五","author":"吴伟业","text":"夜雨椒房阴火青，杜鹃啼血濯龙门。\n汉家伏后知同恨，止少当年一贵人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14920,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其二十六","author":"吴伟业","text":"碧殿凄凉新木拱，行人尚识昭仪冢。\n麦饭冬青问茂陵，斜阳蔓草理残垄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14921,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永和宫词廿七首 其二十七","author":"吴伟业","text":"昭丘松槚北风哀，南内春深拥夜来。\n莫奏《霓裳》天宝曲，景阳宫井落秋槐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14922,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"画中九友诗","author":"吴伟业","text":"华亭尚书天人流，墨花五色风云浮。\n至尊含笑黄金投，残膏剩馥鸡林求。\n太常妙迹兼银钩，乐郊拥卷高堂秋。\n真宰欲诉穷雕搜，解衣盘礴堪忘忧。\n谁其匹者王廉州，神姿玉树三山头，摆落万象烟霞收。\n尊彝斑剥探商周，得意换却千金裘。\n檀园著述夸前修，丹青馀事追营丘。\n平生书画置两舟，湖山胜处供淹留。\n阿龙北固持两矛，披图赤壁思曹刘。\n酒醉洒墨横江楼，蒜山月落空悠悠。\n姑苏太守今僧繇，问事不省张两眸。\n振笔忽起风飕飕，连纸十丈神明遒。\n松圆诗律通清讴，墨庄自画归田游。\n一犁黄海鸣春鸠，长笛倒骑乌牸牛。\n花龛巨幅千峰稠，小景点出林塘幽。\n晚年笔力凌沧洲，幅巾鹤发轻王侯。\n风流已矣吾瓜畴，一生迂癖为人尤，僮仆窃骂妻孥愁。\n瘦如黄鹄闲如鸥，烟驱墨染何曾休。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14923,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雪中遇猎","author":"吴伟业","text":"北风雪花大如掌，河桥路断流澌响。\n愁鸱饥雀语啁啾，健鹘奇鹰姿飒爽。\n将军射猎城南隅，软裘快马红氍毹。\n秋翎垂头西鼠暖，鸦青径寸装明珠。\n金鹅箭褶袍花湿，挏酒驼羹马前立。\n锦靴玉貌拨秦筝，瑟瑟鬟多好颜色。\n少年家住贺兰山，碛里擒生夜往还。\n铁岭草枯烧堠火，黑河冰满渡征鞍。\n十载功成过高柳，闲却平生射雕手。\n漫唱千人《敕勒歌》，只倾万斛屠苏酒。\n今朝仿佛李陵台，将军喜甚围场开。\n黄羊突过笑追射，鼻端出火声如雷。\n回去朱旗满城阙，不信沟中冻死骨。\n犹有长征远戍人，哀哀万里交河卒。\n笑我书生短褐温，蹇驴箬笠过前村。\n即今莫用《梁园赋》，扶杖归来自闭门。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14924,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏拙政园山茶","author":"吴伟业","text":"拙政园内山茶花，一株两株枝交加。\n艳如天孙织云锦，赪如姹女烧丹砂。\n百年前是空王宅，宝珠色相生光华。\n歌台舞榭从何起，当日豪家擅闾里。\n苦夺精蓝为玩花，旋抛先业随流水。\n儿郎纵博赌名园，一掷输人等糠秕。\n后人修筑改池台，石梁路转苍苔履。\n曲槛奇花拂画楼，楼上朱颜娇莫比。\n斗尽风流富管弦，更谁瞥眼闲桃李。\n齐女门边战鼓声，入门便作将军垒。\n荆棘从填马矢高，斧斤勿剪莺簧喜。\n近年此地归相公，相公劳苦承明宫。\n真宰阳和暗回斡，长安日日披熏风。\n花留金谷迟难落，花到朱门分外红。\n一去沈辽归未得，百花深锁月明中。\n看园剩有灌花老，为道此花吴地少。\n宋代经今六百年，虬干成围更成抱。\n嘉宾开宴醉春风，火齐堆光上穹昊。\n于今忽作无主花，满地飘残竟谁扫！\n闻语还思出塞人，玉门关外无芳草。\n梦魂遥想故园花，未见名花颜色好。\n对花不语泪沾衣，惆怅花间燕子飞。\n折取一枝还供佛，征入消息几时归？","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14925,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"读史杂感","author":"吴伟业","text":"吴越黄星见，园陵紫气浮。\n六师屯鹊尾，双阙表牛头。\n静镇资安石，艰危仗武侯。\n新开都护府，宰相领扬州。\n莫定三分计，先求五等封。\n国中惟指马，阃外尽从龙。\n朝事归诸将，军输仰大农。\n淮南数州地，幕府但歌钟。\n北寺谗成狱，西园贿拜官。\n上书休讨贼，进爵在迎銮。\n相国争开第，将军罢筑坛。\n空馀苏武节，流涕向长安。\n贵戚张公子，奄人王宝孙。\n入陪宣室宴，出典羽林屯。\n狗马来西苑，俳优待北门。\n不时中旨召，著籍并承恩。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14926,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"遇旧友","author":"吴伟业","text":"已过才追问，相看是故人。\n乱离何处见，消息苦难真。\n拭眼惊魂定，衔杯笑语频。\n移家就吾住，白首两遗民。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14927,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"家园次罢官吴兴有感","author":"吴伟业","text":"世路嗟谁稳，栖迟可奈何！\n官随残梦短，客比乱山多。\n闭阁疑香坐，行厨载酒过。\n却听渔唱响，落日有风波。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14928,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"课女","author":"吴伟业","text":"渐长怜渠易，将衰觉子难。\n晚来灯下立，携就月中看。\n弱喜从师慧，贫疑失母寒。\n亦知谈往事，生日在长安。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14929,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过朱买臣墓","author":"吴伟业","text":"翁子穷经自不贫，会稽连守拜为真。\n是非难免三长史，富贵徒夸一妇人。\n小吏张汤看倨傲，故交庄助叹沉沦。\n行年五十功名晚，何似空山长负薪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14930,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"台城","author":"吴伟业","text":"形胜当年百战败，子孙容易失神州。\n金川事去家还在，《玉树》歌残恨未休。\n徐邓功勋谁甲第，方黄骸骨总荒丘。\n可怜一片秦淮月，曾照降幡出石头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14931,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"功臣庙","author":"吴伟业","text":"画壁精灵间气豪，鄂公羽箭卫公刀。\n丹青赐额丰碑壮，棨戟传家甲第高。\n鹿走三山争楚汉，鸡鸣十庙失萧曹。\n英雄转战当年事，采石悲风起怒涛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14932,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秣陵口号","author":"吴伟业","text":"车马垂杨十字街，河桥灯火旧秦淮。\n放衙非复通侯第，废圃谁知博士斋。\n易饼市傍王殿瓦，换鱼江上孝陵柴。\n无端射取原头鹿，收得长生苑内牌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14933,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送曹秋岳以少司农迁广东左辖","author":"吴伟业","text":"秋风匹马尉佗城，铜鼓西来正苦兵。\n万里虞翻空远宦，十年杨仆自专征。\n山连鸟道天应尽，日落蛮江浪未平。\n此去好看宣室召，汉皇前席问苍生。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14934,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"杂感","author":"吴伟业","text":"武安席上见双鬟，血泪青娥陷贼还。\n不为君亲来故国，却因女子下雄关。\n取兵辽海哥舒翰，得妇江南谢阿蛮。\n快马健儿无限恨，天教红粉定燕山。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14935,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"登缥缈峰","author":"吴伟业","text":"绝顶江湖放眼明，飘然如欲御风行。\n最高尚有鱼龙气，半岭全无鸟雀声。\n芳草青芜迷远近，夕阳金碧变阴晴。\n夫差霸业销沈尽，枫叶芦花钓艇横。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14936,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"与友人谈遗事","author":"吴伟业","text":"曾侍骊山清道尘，六师讲武小平津。\n云髦大纛星辰动，天策中权虎豹陈。\n一自羽书飞紫塞，长教钲鼓恨黄巾。\n孤臣流涕青门外，徒使田横客笑人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14937,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蠲租行追同元次山舂陵行韵","author":"龚鼎孳","text":"皇帝将改元，制书诏所司。\n方春重民事，王政务急施。\n水旱兼资贼，人气诚伤悲。\n万方惟正供，悉索亦已疲。\n新饷五百万，剜肉疗饥羸。\n国计在本根，毛附先存皮。\n民困必失所，拯溺焉能迟？\n丞相下郡国，一切蠲除之。\n先是加赋意，岂不哀穷黎？\n水衡算金钱，桥陵方告期。\n滇闽各用兵，军行粮辄随。\n朝廷尚恭俭，大事须藉资。\n痌瘝上帝心，四海宁尽知。\n况复州邑吏，鞭挞到孑遗。\n御史□大夫，陛下真圣慈。\n元元乐宽大，生息理可为。\n民贫不独富，斯义古所持。\n流离与死亡，号呼欲向谁。\n固知非得已，久大难权宜。\n我皇本尧舜，天听顷刻移。\n谏行膏泽下，千载明良时。\n煌煌社稷寄，辅导良不亏。\n君仁则臣直，拜手陈古辞。","collection":"明末清初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14938,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"岁暮行","author":"龚鼎孳","text":"天寒鼓柁生悲风，残年白头高浪中。\n地经江徼饱焚掠，夜夜防贼弯长弓。\n荒村哀哀寡妇哭，山田瘦尽无耕农。\n男逃女窜迫兵火，千墟万落仓箱空。\n昨夜少府下争牒，军兴无策宽蜚鸿。\n新粮旧税同立限，入不及格书驽庸。\n有司累累罪贬削，缗钱难铸山非铜。\n朝廷宽大重生息，群公固合哀愚蒙。\n揭竿扶杖尽赤子，休兵薄敛恩须终。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14939,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"姑山草堂歌","author":"龚鼎孳","text":"上书不踏金华省，苍头瘦马冲沙冷。\n拔剑不割金门肉，老寺残僧铛折足。\n姑山草堂天下重，松菊东篱阅晋宋。\n园宅全因宾客荒，才名未逐风尘用。\n嵚寄历落谁能嗤，烟波五湖足钓丝。\n秦淮垂柳楚州雪，病夫吟眺恒相期。\n重逢酒楼下，色定还惊疑。\n浩荡江海人，何意来京师。\n门巷疏花掩深酌，高城鼓角寒星落。\n总教世事属青云，但爱吾徒有丹壑。\n拂袖长辞骠骑府，脱粟安用公孙阁。\n卢龙叶堕边霜来，江南林涧还秋苔。\n知裘日暮何为哉，芒鞋竹杖无氛埃。\n留君不住羡君去，萧萧易水挥残杯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14940,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"樟树行","author":"龚鼎孳","text":"古樟轮囷异枯柏，植根江岸无水石。\n风霜盘亘不计年，枝干扶疏讵论尺。\n望中转柁愁易过，道旁掉臂真可惜。\n其下萧瑟枫林青，其侧参差茅宇白。\n十年跃马桑乾东，双松诘曲慈仁宫。\n紫鸽翔舞避偃蹇，苍龙蜒蜿回虚空。\n今来荒野忽有此，数亩阴雪争天风。\n当时万幕驻金甲，大树飒沓开神功。\n勿言将压烦榱栋，傲睨高原川谷重。\n寒翠宁因晚岁雕，孤撑不畏狂澜送。\n地近军城耀水犀，天开阿阁巢云凤。\n自古全生贵不材，樟乎匠石忧终用。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14941,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"飞来峡","author":"龚鼎孳","text":"浈水沿江曲，双崖浪欲吞。\n石欹崩峡口，云涌荡天门。\n地截蛟龙断，山埋日月昏。\n楼船飞渡后，惘惘失空村。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14942,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"癸未十月初七日以言事下狱","author":"龚鼎孳","text":"社稷关元老，忧天语信狂。\n九重容折槛，万死待浮湘。\n鹿马人犹眩，龙蛇道已荒。\n贾生年少哭，终是岁岩廊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14943,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吴郎南征赋别","author":"龚鼎孳","text":"一剑朱云得，今看出匣锋。\n饭难忘巨鹿，人不异卢龙。\n国士知弓治，家声薄鼎钟。\n击奸兼破贼，吾欲卷书从。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14944,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"感事和王子云韵","author":"龚鼎孳","text":"江潭摇落自行歌，威凤惊闻有罻罗。\n三黜风雷天意定，百年环玦主恩多。\n贾生岂爱投荒去，张禹终如折槛何。\n去国未收忧国泪，苍生十载望岩阿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14945,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"登晴川阁小饮二首 其一","author":"龚鼎孳","text":"大别山前落照迟，丹梯百尺正逶迤。\n天连江汉迷烟艓，人傍星辰倒玉卮。\n岁晚不消芳草梦，路遥难约旅鸿期。\n寒风乍卷涛如雪，却忆淮南八月时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14946,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"登晴川阁小饮二首 其二","author":"龚鼎孳","text":"登高风物郁苍苍，何处寒花发战场。\n吴蜀健儿犹裹甲，汉江游女自褰裳。\n中洲鹦鹉萋芳草，隔岸楼台受夕阳。\n满眼昆明消一醉，烽烟真不上渔航。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14947,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]