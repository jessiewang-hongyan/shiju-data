[{"title":"赋得摇落深知宋玉悲 其二","author":"屈大均","text":"萧条草木变衰时，秋气悲哉汝更悲。\n感梦空劳天帝女，招魂不返水仙师。\n三闾哀怨多高弟，南楚荒淫总寓辞。\n我亦徉狂能讽谏，多惭山鬼善相思。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12160,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赋得摇落深知宋玉悲 其三","author":"屈大均","text":"天生芳草作衣裳，词赋还争日月光。\n楚水兰荪从此盛，巫山云雨至今香。\n三闾尸谏因同姓，千载魂归为哲王。\n辛苦大夫歌九变，泬寥天气感潇湘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12161,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赋得摇落深知宋玉悲 其四","author":"屈大均","text":"一代离忧写未央，无穷芳草在文章。\n骚经自可为诗传，逐客繇来是楚狂。\n风雅再教高弟变，童蒙先拾大夫香。\n大招亦解惊魂魄，岂似悲秋易断肠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12162,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赋得摇落深知宋玉悲 其五","author":"屈大均","text":"秭归乡里满梧楸，宋玉悲深此地秋。\n枻影依依渔父在，砧声隐隐女媭留。\n泪成玉米田何处，身别龙门夏已丘。\n临水登山归莫送，汨罗南望断离愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12163,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赋得摇落深知宋玉悲 其六","author":"屈大均","text":"风高气肃水泉清，憭慄增人志不平。\n海燕翩翩频失影，山蝉咽咽早无声。\n生悲楚地元多怨，死恨秋天不肯明。\n自作招辞骚一变，江南哀罢有馀情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12164,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赋得摇落深知宋玉悲 其七","author":"屈大均","text":"萧萧秋气满枫林，一片离忧托素琴。\n好色只知神女丽，微辞难得大夫深。\n玉钗罗袖徒为尔，秋竹幽兰不忍侵。\n笑为君王陈讽赋，与师芳洁有同心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12165,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赋得摇落深知宋玉悲 其八","author":"屈大均","text":"自来南楚好才华，祖述风骚始宋家。\n渔父歌声同缥缈，接舆辞采共纷葩。\n湘江水冷长含雪，巫峡山多易变霞。\n一自悲秋成九辩，至今哀怨满星沙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12166,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过马佐领克起粤秀山房赋赠 其一","author":"屈大均","text":"一峰飞向穗城头，下有书堂傍药洲。\n骠骑不曾耽蹋鞠，征南祗爱注春秋。\n朝台古木穿云上，越井寒泉抱石流。\n多种芭蕉无暑入，相将壶矢绿阴留。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12167,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过马佐领克起粤秀山房赋赠 其二","author":"屈大均","text":"玉山南枕草堂偏，门出呼銮古道边。\n九眼泉华朝吐雪，五层楼影暮含烟。\n芙蓉秋到惟知醉，杨柳春来只解眠。\n笑道将军诗总好，辞场战胜势无前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12168,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"示罗 其一","author":"屈大均","text":"岂是罗敷定婉罗，秦家好女共娥娥。\n旧书纨扇辞还少，新学瑶琴曲未多。\n香发似云休用剃，玉颜如酒不须酡。\n黄花不忍簪双朵，日夕东篱拂翠萝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12169,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"示罗 其二","author":"屈大均","text":"架笔珊瑚玉作床，水岩真砚墨凝香。\n笺花字字曹娥小，绘竹枝枝赵管长。\n粉镜弄馀嫌日短，衣砧捣罢喜秋凉。\n小姑吟讽能相伴，日夕葩经在绣筐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12170,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"食菊 其一","author":"屈大均","text":"白苦黄甘早已知，生餐好及岁寒时。\n落英不落真惟汝，香国无香总在兹。\n瘴地岂愁南雪食，炎天那得早霜欺。\n朝朝采摘当篱落，未有忘忧酒满卮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12171,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"食菊 其二","author":"屈大均","text":"食尽枝枝白与黄，鲍焦蔬好让芬芳。\n终年灌溉图秋饱，最早栽培为晚香。\n味芳不妨虫蚁避，影孤那代李桃僵。\n梅花至日劳相伴，佳色参差映寿阳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12172,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"食菊 其三","author":"屈大均","text":"烹瀹甘酸任意餐，仙人服食不曾难。\n芝华岂是疗饥物，菊药繇来久视丹。\n九日色同高士醉，三秋香为逐臣寒。\n芙蓉坠露长兼饮，高洁如蝉取自欢。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12173,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"己巳腊月十三日家慈大人八十有六生日恭赋 其一","author":"屈大均","text":"八旬有六老亲年，杖国婴儿在膝前。\n孝子身终须大耋，贫家养薄只荒田。\n诸孙酒馔争擎案，三妇衣裙竞上笺。\n乞取桃花向王母，更分长寿小银钱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12174,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"己巳腊月十三日家慈大人八十有六生日恭赋 其二","author":"屈大均","text":"麻姑白发七朝身，带闰参差已九旬。\n门下三千酿酒客，堂前六十弄雏人。\n纷纷䰀鬌教扶手，一一酥醪要入唇。\n孩笑未知吾老大，莱妻少艾亦忘贫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12175,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"己巳腊月十三日家慈大人八十有六生日恭赋 其三","author":"屈大均","text":"家贫谋食计元疏，日日妻孥作白鱼。\n养志已成高尚士，娱亲更著外家书。\n白头多事惟调药，青岁无才枉断裾。\n汉代孙嵩吾得似，康宁有母百龄馀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12176,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"己巳岁除作 其一","author":"屈大均","text":"避地飘摇未定栖，贫家骨肉满中闺。\n去年左氏三媛在，明岁商瞿五子齐。\n梅实早从冬至结，莺雏休待立春啼。\n街头花胜无钱买，黄口牵衣向小妻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12177,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"己巳岁除作 其二","author":"屈大均","text":"春来依旧未阳和，生事萧条罢啸歌。\n孺仲妻孥花絮少，韩康母子药丸多。\n梅葩似雪嫌红甚，草色如烟奈绿何。\n岁暮苦寒喧暖日，更无名酒使颜酡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12178,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"己巳岁除作 其三","author":"屈大均","text":"未办肴蔬守岁盘，小除儿女有馀欢。\n东风向腊频开冻，朔雪含春不作寒。\n碧玉甘贫能啜菽，青琴善病未徵兰。\n蓬门不识年光早，剪綵莺花梦里看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12179,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"示姬人 其一","author":"屈大均","text":"红粉春当冰雪容，看如桃杏倚寒松。\n梦吞南海初圆月，欢得公沙第六龙。\n中馈祗知馨夕膳，女红惟有佐晨舂。\n莱妻未老能恩汝，逮下螽斯是礼宗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12180,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"示姬人 其二","author":"屈大均","text":"白华无欲益芬香，六十年华又一霜。\n居士未沾红菡萏，丈人已足紫鸳鸯。\n眉开五岳双蛾秀，掌出三珠一树香。\n恭敬好同裘褐妇，先将甘脆进高堂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12181,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"示姬人 其三","author":"屈大均","text":"当酒珠钗久未还，山葩占断绿云鬟。\n三春大妇蚕桑里，百岁威姑几杖间。\n么凤香收双翅满，郁鸡花点一身斑。\n织蒲愧我伤仁甚，日暖风和总不閒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12182,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"庚午元日作 其一","author":"屈大均","text":"银烛高含曙色光，天鸡声里见东皇。\n乾坤未毁终开辟，日月方新尚混茫。\n儿女参差从小起，杯盘次第进椒香。\n欣欣举寿慈颜喜，有道曾孙满北堂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12183,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"庚午元日作 其二","author":"屈大均","text":"岁朝频献万年觞，令节三元此日长。\n夜半已知周正朔，年深犹记鲁春王。\n白头金胜来瑶水，素手椒花出洞房。\n作颂更同刘氏妇，慈容相映有馀光。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12184,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"庚午元日作 其三","author":"屈大均","text":"莺向开元已弄歌，风光一倍在岩阿。\n萱花日暖幽香满，樛木春深茂阴多。\n红恨樱桃频作子，青怜杨柳欲侵蛾。\n双成萼绿东西侍，王母偏怜是婉罗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12185,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"庚午元日作 其四","author":"屈大均","text":"小大同欢及上春，蓬门双帖画鸡辰。\n湔裳士女非荆俗，戏水鱼龙是汉人。\n耳顺过年方一日，家贫遇食未三旬。\n凭将啸咏除衰老，莫负开云令节新。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12186,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"庚午元日作 其五","author":"屈大均","text":"笼葱得到杖朝无，日日闺庭即玉壶。\n方朔未衰频仰乳，老莱犹稚更将雏。\n饥同食字神仙蠹，冻似啼霜子母乌。\n一片春晖那媚得，油油草色羡蘼芜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12187,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"庚午元日作 其六","author":"屈大均","text":"庚午重为堕地人，愁逢烈帝第三春。\n生从十五无君父，罪有三千是子臣。\n一日鸡豚犹逮母，平生犬马未违亲。\n早孤少得先公教，报答慈威恨不辰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12188,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送人入巫峡","author":"屈大均","text":"看杀芙蓉十二图，黄牛朝暮一人孤。\n生当绝峡谁求女，化作名峰亦望夫。\n辞赋不愁迁客少，梦魂得似楚王无。\n香溪更与高唐接，莫吊明妃泪似珠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12189,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送人往长白 其一","author":"屈大均","text":"长白山当宁古西，秋深雪压一天低。\n泉飞早作三江大，云起时将万木齐。\n寒射鼲貂弓力劲，晚呼驼鹿角声凄。\n仙灵定指多蔘处，五叶三稏采不迷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12190,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送人往长白 其二","author":"屈大均","text":"天将长白作长城，东界龙荒接北平。\n万里沙含黄雪影，半空风乱黑松声。\n鱼皮衣服关前部，雕羽穹庐岛上兵。\n汝向林间寻楛矢，射生知有野人迎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12191,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过林子本茅草堂奉答见赠之作 其一","author":"屈大均","text":"城东胜地是长塘，汝作松坡一草堂。\n兰蕙不教花箭少，荼蘼肯任露华香。\n依依白首惟春色，隐隐南朝祗夕阳。\n念我多情同庾信，平生萧瑟在辞章。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12192,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过林子本茅草堂奉答见赠之作 其二","author":"屈大均","text":"开径相招喜地偏，因君来枕素琴眠。\n黄花有节忘甘苦，白酒无心问圣贤。\n山色每含朝雨冷，海光时夺暮霞妍。\n贫中自得新诗赠，不觉蠲愁涕泪边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12193,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"杜鹃花","author":"屈大均","text":"杜鹃开及杜鹃啼，朵朵猩红踏作泥。\n望帝春心烟雨外，蚕丛故国夕阳西。\n将归有客愁三峡，再拜何人忆五溪。\n血洒至今花瓣湿，莺衔不忍过香闺。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12194,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"三水舟中","author":"屈大均","text":"青山一路翠沉浮，雨过潮生竞放舟。\n贺水东趋西水去，绥江南入北江流。\n半天花发斑枝树，三月红开荔子洲。\n昨夜黄鱼随电至，野人抛网遍沙头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12195,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"代呈某观察","author":"屈大均","text":"新开宪府尉佗宫，三郡宣威露冕中。\n南国总教阴雨遍，东方元与岁星同。\n干旌自可来姝子，风雅谁当和召公。\n灯火满城欢士女，为君歌舞衮衣风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12196,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"集梁季子斋分赋得鱼字","author":"屈大均","text":"故人有弟凤城居，门外寒塘洗药馀。\n苔色冷含丹嶂影，花光晴出绿天书。\n香鲥正美樱桃颊，紫荔兼来翡翠墟。\n语我甘滩垂钓好，潮平潮落总多鱼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12197,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"席上赋得甘滩鲥鱼限鱼字 其一","author":"屈大均","text":"甘滩最好是鲥鱼，海目山前味不如。\n丝网肯教鳞片损，玉盘那得鲙香馀。\n多惭食饫先王母，敢恨尝新后老渔。\n四月金钱人竞掷，未应黄颊当园蔬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12198,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"席上赋得甘滩鲥鱼限鱼字 其二","author":"屈大均","text":"滩下肥过滩上鱼，罨中泼剌诉流初。\n冰鳞触损烹无及，玉箸殷勤食有馀。\n三月乱随西水下，九江争向北山渔。\n嘉名更得三来好，为惜膏流作网疏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12199,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"为陈封翁八十寿","author":"屈大均","text":"青丝角髻貌如桃，桃得绥山已足豪。\n卞氏六龙忠自教，淮南一老节谁高。\n含精白兔依神药，饮乳仙人代玉醪。\n黄发不须忧国计，冢君启事有山涛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12200,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"为九十有一岁黎门陈节母寿","author":"屈大均","text":"六十三年失故雄，吾家寿母亦相同。\n九旬又得春秋一，百岁长居燕喜中。\n黄鹄贞良如鲁女，白华芳洁有孙嵩。\n天怜守义教难老，绀发垂芬入管彤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12201,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋雨","author":"屈大均","text":"潇潇半在梦魂中，爽气吹来不待风。\n摇落未应悲澧浦，萧条且喜到梧宫。\n香开夜合花争白，色乱朝霞叶欲红。\n湿尽葛衣凉欲透，一尊须向画栏东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12202,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠同庚叟","author":"屈大均","text":"阴阴蕉荔两村连，乡里衣冠爱汝贤。\n与我同生光庙后，无人独在上皇前。\n陶公亲戚多情话，白傅耆英少昔年。\n难老不妨耽饮酒，相过时醉绥桃边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12203,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠家将军","author":"屈大均","text":"吾家一派在辽东，世世蒙恩作总戎。\n子姓有君承将略，威名此日扫蛮风。\n石城笳吹三秋咽，炎海楼船万里空。\n念是连枝欢不浅，经过频驻玉花骢。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12204,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寿龚给谏母苏太夫人","author":"屈大均","text":"令子循良擢琐闱，斑衣恩赐五时衣。\n辞朝暂与鹓鸾别，拜母频为鸿鹄飞。\n谏果秋含朱实大，慈萱春映白华肥。\n黄门献纳相须甚，早奉宣文向紫微。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12205,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"答姚叔烟 其一","author":"屈大均","text":"晞发曾攀落雁台，朝从玉女洗头来。\n金天肃杀三峰出，玉井清泠一镜开。\n白帝宫前逢赋客，苍龙岭上把离杯。\n狂歌道我时时醉，舞向仙人掌上回。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12206,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"答姚叔烟 其二","author":"屈大均","text":"燕市悲歌落日昏，故人相见念丘樊。\n无情沮溺终忘世，有恨屠沽未报恩。\n鸿雁暖先南雪到，牛羊寒作朔云屯。\n篱间紫菊能过赏，为尔殷勤具绿尊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12207,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠增城冉明府","author":"屈大均","text":"咫尺罗浮两县分，增城烟雨博罗云。\n重来鲍靓三千岁，复治朱明四百君。\n白水化将膏泽下，桃花吹作杜兰薰。\n春台只在春冈曲，父老仁声处处闻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12208,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠前松溪张明府","author":"屈大均","text":"秋色凄清白露前，知君拄笏凤台烟。\n浮山来作罗山客，葛令行同鲍令仙。\n生日登高逢令节，平时止酒足新篇。\n渊明自昔怜重九，采采黄华复汝贤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12209,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"重至何仙姑坛作 其一","author":"屈大均","text":"逍遥爱向女仙坛，玉井真同华顶看。\n气涌天花三窦小，光含云母一泓寒。\n无烦冰雪求姑射，解饮清泠即大丹。\n素绠金瓶争汲取，莓苔休滑碧栏杆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12210,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"重至何仙姑坛作 其二","author":"屈大均","text":"蓬瀛只在相江湄，羽化云含少女姿。\n石鼓虚无被发影，玉盆荡漾洗头时。\n无多水碧金膏诀，绝妙芙蓉白雪辞。\n终古仙灵多阒寂，笑他香雨逐瑶姬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12211,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"重至何仙姑坛作 其三","author":"屈大均","text":"凤子初生即羽翰，龙孙未老已檀栾。\n月中自解飞金镜，天上何劳坠玉棺。\n萼绿早归瑶水去，麻姑时上石楼看。\n阿琼漫把箫声寄，吹彻笼葱夜夜寒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12212,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"重至何仙姑坛作 其四","author":"屈大均","text":"瑶坛东北是罗浮，仙女殷勤为二楼。\n飞雪不教萧史赠，采珠那与宓妃游。\n纷纷作使来么凤，一一翾飞向药洲。\n轻举只须能服食，羽人何必问丹丘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12213,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"重至何仙姑坛作 其五","author":"屈大均","text":"少好仙颜旭日红，丹成早遣密香通。\n龟台太妙依尊母，凤笈青真掌小童。\n故宅秋馀金井月，荒台夜引玉萧风。\n自惭玉斧犹尸浊，未得攀鸾上碧空。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12214,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"增城万寿寺乞取丫兰之作 其一","author":"屈大均","text":"僧多兰蕙作花师，乞取离骚第一枝。\n叶短花长争尺寸，春黄秋紫间参差。\n焦冈树色含霜早，丹井泉香出雪迟。\n莫笑湘累哀窈窕，频来只住女仙祠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12215,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"增城万寿寺乞取丫兰之作 其二","author":"屈大均","text":"丹丘白水胜潇湘，最产丫兰茎叶长。\n有地欲求香祖种，无金枉入女花乡。\n皆知服媚尊王者，更喜栽培出上方。\n及此秋分分数本，争贻野客作归装。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12216,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送李浣庐使君之湖北方伯任 其一","author":"屈大均","text":"三年听讼已神明，爱士风流更擅名。\n齐相最能知石父，鲁人那得目荆卿。\n频为岳牧过南楚，遂使台门隔玉京。\n一片恩波珠浦水，中含鲛泪送公行。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12217,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送李浣庐使君之湖北方伯任 其二","author":"屈大均","text":"高义云天世所希，殷勤解网凤衔飞。\n青莲自得汾阳爱，白屋惟将公旦归。\n师保炎方长服德，藩屏楚国更宣威。\n衮衣不为东人处，盼望遵鸿泪欲挥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12218,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"庚午季秋六十有一岁生日作 其一","author":"屈大均","text":"婆娑膝下舞衣回，老子还童作少莱。\n尊母九旬颜并驻，烈皇三祀历重开。\n芝华总作西王养，萼绿全充侍女才。\n鸿鹄翩翩需羽翼，商颜莫使子房来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12219,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]