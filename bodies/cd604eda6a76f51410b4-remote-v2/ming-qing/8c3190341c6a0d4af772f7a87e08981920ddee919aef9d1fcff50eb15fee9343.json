[{"title":"送姚君之官贵县丞 其一","author":"屈大均","text":"左江西上即浔中，贵县东屏邕管雄。\n人杂徭狼蛮语乱，地多粳稻估船通。\n门高不惜乌衣贵，官小偏宜柳下工。\n水接夜郎愁瘴毒，簳珠多采伏波宫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12101,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送姚君之官贵县丞 其二","author":"屈大均","text":"崧台薄暮尽离觞，帆指浔梧去渺茫。\n令子相从师政事，故人持赠是循良。\n乌蛮滩口当城出，交趾江关接县长。\n他邑莫辞频摄令，春行一日即甘棠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12102,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"峡里 其一","author":"屈大均","text":"峡里千峰似堵墙，时时阴雨见羚羊。\n双江吐纳桃溪口，一水滢洄蕉利乡。\n潮到苍梧咸味薄，春归员屋石花香。\n鹧鸪知是多情者，日日催归使断肠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12103,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"峡里 其二","author":"屈大均","text":"栈道盘回出万峰，千金凿破几芙蓉。\n心悲化石秦时女，泪洒啼猿汉代松。\n岩际海棠终岁见，林边山翠有时逢。\n斜阳野戍休催泊，乘月思寻峡口钟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12104,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"无题","author":"屈大均","text":"暖老双双燕玉同，况多沉水爇熏笼。\n马缨蝴蝶妆都好，莺粟樱桃笑总工。\n春色全归朱阁里，轻寒半入玉杯中。\n紫烟不断香狼藉，曲曲云屏隔尽风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12105,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"红梅","author":"屈大均","text":"生当屋角恨多阴，几朵微红半吐心。\n暖处易香嫌日薄，寒时难落怕风深。\n休教摘去围云髻，且使移来傍玉琴。\n小小相思怜不啄，枝间久立忽穿林。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12106,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菉猗亭次张观察韵","author":"屈大均","text":"使君才藻见声诗，公暇挥毫向曲池。\n吐绶文禽花暖处，晒珠琼蚌月晴时。\n冬开最喜梅枝早，夏熟多愁荔子迟。\n野客相通情不厌，笑倾金屈酒盈卮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12107,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉和张紫阁观察己巳元日书怀之作次韵","author":"屈大均","text":"使君三阁启云扉，一列终南志未违。\n扬越诸侯推独立，商颜四老待相依。\n开年柏叶春同暖，隔岁梅花晚不肥。\n元日书王存草野，春秋长恐史臣非。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12108,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"远公贻我莲种赋此答之","author":"屈大均","text":"白莲本是远公物，分我池中藕数枝。\n预拟花开成菡萏，恰当酒熟有酴醾。\n淤泥欲浅教行笋，雨水休深恐烂丝。\n但得田田南北满，叶香即与美人期。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12109,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送程相音返关中为尊人朴庵先生寿 其一","author":"屈大均","text":"秋风首路出台关，西指秦中一骑还。\n南海珠归文笔里，罗浮花在綵衣间。\n壶觞晚就轩辕观，射猎朝过祋祤山。\n堂上知君尊老健，桃红不及岁星颜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12110,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送程相音返关中为尊人朴庵先生寿 其二","author":"屈大均","text":"一樽相送五仙城，鸿雁南来尔北征。\n越鸟解催归计早，岭梅不笑客装轻。\n秦多气概诗无敌，汉少关河事已平。\n华下故人知好在，教同葛氏记西京。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12111,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄富平李子德 其一","author":"屈大均","text":"闻君养疾事丹砂，焚却银鱼鬓有华。\n弘景辞官犹宰相，田骈不宦似邻家。\n漆沮水满浮鱼笱，祋祤云深拥鹿车。\n知道扶风时讲授，门墙不少是侯芭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12112,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄富平李子德 其二","author":"屈大均","text":"别离长忆十年情，出处同高一代名。\n四皓暂为秦博士，五经终作汉康成。\n家临北地元天府，人在西方是帝京。\n河华几时重握手，尊开石冻话生平。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12113,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄华阴王山史 其一","author":"屈大均","text":"都门一别廿馀霜，两地幽居白发长。\n皇甫首裁巢父传，孔明惟拜鹿门床。\n梦随秋月过西岳，愁作春云黯渭阳。\n坚卧未教猿鹤笑，书传却聘有馀芳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12114,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄华阴王山史 其二","author":"屈大均","text":"独鹤亭西下榻时，风流儒雅互相师。\n王家墨妙仙灵授，刘氏文心父子知。\n螺老不曾珠子少，竹枯未见箨龙迟。\n频同玉女持浆去，南至罗浮讵有期。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12115,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄华阴王伯佐 其一","author":"屈大均","text":"君昔西归未送君，离心飞逐华山云。\n大家词赋人难及，名父风流子易分。\n消渴尚多松桧露，微官未愧鹿麛群。\n重来岭海知无日，尊酒依依忆论文。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12116,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄华阴王伯佐 其二","author":"屈大均","text":"枉驾云林爱汝贤，贫家鸡黍及宾先。\n三秦羌弋须王猛，五岭神仙属稚川。\n渊静益深多病后，飞腾长忆未衰前。\n西飞几夕寻君梦，缭绕三峰紫翠边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12117,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"大树轩诗为吴副戎作","author":"屈大均","text":"汉家大树属将军，细叶榕阴郁似云。\n幕府开当萝薜影，铙歌吹起羽毛群。\n惊鸾书就仍无敌，猛虎篇成已策勋。\n作镇崧台多紫砚，青天割得肯相分。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12118,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"张馀庵先生年六十有九七十有七八十八十有四时皆生一子今己巳八十有五矣诗以寿之","author":"屈大均","text":"老蚌偏于珠子宜，七旬生到九旬时。\n张苍日日餐香乳，方朔年年娶小姬。\n几树白华芳子舍，一群雏凤引原枝。\n真仙咫尺须瞻拜，肉角峨峨复秀眉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12119,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自蒲涧入濂泉寺作","author":"屈大均","text":"阴阴灌木夹山蹊，入石穿泉路易迷。\n虎去未寒苔上迹，蝉来忽断竹间嘶。\n蒲根可食因多节，叶背堪书为少泥。\n不雨水帘成滴沥，梦魂消绝寺楼西。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12120,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送姜克犹归山阴 其一","author":"屈大均","text":"深秋岂是送君时，落叶哀蝉悲复悲。\n青岁自怜多独往，白头人恨少相知。\n风流南国无词客，秀丽西家有美施。\n为向若耶溪上问，苍苍苔色几人思。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12121,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送姜克犹归山阴 其二","author":"屈大均","text":"握手佗城恨太迟，平生吴越罕相知。\n故人东市多中散，知己辽阳有子期。\n尔向云门披宿草，予从珠浦荐江蓠。\n姜家大被应无恙，为致殷勤雨雪时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12122,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠黄叟逸閒","author":"屈大均","text":"八旬有二鬓如丝，见我能文十四时。\n天为无书留古老，人因有道得期颐。\n山蝉夜咽寒泉响，海鹤秋高白露姿。\n拾穗相随吾未厌，西郊烟水岁寒宜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12123,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠小妓凤求","author":"屈大均","text":"小楷钟王解画沙，卫夫人法使纷葩。\n五年孔雀频成尾，三岁夭桃已作花。\n苏小心将芳草结，薛涛诗向锦江誇。\n大娘剑器看他舞，六草三真更到家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12124,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南城眺望有作 其一","author":"屈大均","text":"帆拂城墙影不迟，海风吹乱飏潮时。\n楼飞似挟蛟龙气，笛奏休惊雁鹜池。\n上下巡盐勤白打，东西抽货苦波斯。\n江鱼价贱金钱贵，疾苦炎州只自知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12125,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南城眺望有作 其二","author":"屈大均","text":"日斜愁见断头虹，飓母来时尚练风。\n海底鱼龙喧夜市，潮头宫阙起秋空。\n盐烧积雪千田白，花吐攀枝十里红。\n大小虎门多戍卒，莫令洋寇势相通。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12126,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"汪子栗亭右湘吴子绮园属山僧师古画黄山册子寄予为六十寿诗以酬之 其一","author":"屈大均","text":"黄山黄海白云开，画取芙蓉六六来。\n三道天门三瀑布，一枝石笋一丹台。\n烟霞作寿凭仙笔，岳渎难生是逸才。\n知尔竹林相待久，会将舟向阮溪回。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12127,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"汪子栗亭右湘吴子绮园属山僧师古画黄山册子寄予为六十寿诗以酬之 其二","author":"屈大均","text":"复见风流二阮来，思君数把画图开。\n炎方山水无黄海，太古衣裳有老莱。\n绿髓祗须餐石髓，丹台不用写云台。\n含毫更为添三笑，白首溪桥泥饮回。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12128,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"汪子栗亭右湘吴子绮园属山僧师古画黄山册子寄予为六十寿诗以酬之 其三","author":"屈大均","text":"一松缭绕一芙蓉，松似藤萝不似松。\n偃盖倒生多至地，飞枝斜出亦成峰。\n云林掩映皆巢鹤，石笋参差是箨龙。\n多谢山僧能画得，苍髯巧作老人容。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12129,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"汪子栗亭右湘吴子绮园属山僧师古画黄山册子寄予为六十寿诗以酬之 其四","author":"屈大均","text":"只见僧繇画作龙，何曾韦偃写成松。\n因生石上能千岁，要向云间化一峰。\n白岳迟分天子种，黄山早定老人宗。\n兔丝千尺牵魂梦，何日身披紫翠重。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12130,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"汪右湘以银卮为寿诗以酬之 其一","author":"屈大均","text":"汪伦最爱酒仙人，金屈相贻酌老春。\n形似海棠香朵大，色宜秋露白光新。\n独清未敢长中圣，难老惟须善葆真。\n知尔踏歌情不浅，欲将潭水变芳醇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12131,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"汪右湘以银卮为寿诗以酬之 其二","author":"屈大均","text":"徽州螺钿酒杯轻，偏寄乌银接紫琼。\n日出一双飞在手，风流千载饮知名。\n墨烟兼惠分儿女，胶漆频忘是友生。\n岁岁有书还唱和，天涯咫尺枕中行。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12132,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉答汪于鼎赠予六十岁之作 其一","author":"屈大均","text":"白头频得故人怜，惠寄诗歌祝大年。\n莱子妻存难作相，苏耽母在不登仙。\n六旬有耳师尼父，八十无心待渭川。\n生日劬劳空涕泪，未知何以报穹天。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12133,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉答汪于鼎赠予六十岁之作 其二","author":"屈大均","text":"墨香分惠小郎宜，未学犹惭最老师。\n蝴蝶岂应称凤子，螺蛳那得号珠儿。\n九旬玉杖争扶日，两代斑衣赛舞时。\n但使闺庭多乐事，浮云富贵不须期。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12134,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉答汪于鼎赠予六十岁之作 其三","author":"屈大均","text":"岭海相期又十霜，无因笑语郁川阳。\n玉勾自可分兄弟，姑射何须应帝王。\n瀑里云门三洞小，谼中石笋一天长。\n何时邂逅虬山麓，并坐谈经花满床。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12135,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"答吴绮园长歌为予六十寿之作","author":"屈大均","text":"长句相贻及贱辰，山东李白斗清新。\n能忘老大交初笃，雅有文章道不贫。\n百幅兼将云母粉，十螺仍致墨花春。\n弟兄爱我推吴氏，岁岁音书托锦鳞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12136,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"答洪雨平待臣兄弟见寿之作","author":"屈大均","text":"终年痛饮酒家邻，忽忽悲歌到六旬。\n豁达岂期青岁客，沉冥偏爱白头人。\n老龙未得狂言尽，雏凤难当妙响新。\n兄弟参差三石笋，黄山削出总嶙峋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12137,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"答黄扶孟 其一","author":"屈大均","text":"新安耆旧在人间，不住黄山住白山。\n司马已能千赋熟，大春那得五经閒。\n乔松自爱龙鳞老，衰凤谁惭雉子斑。\n念我白头依膝下，赋诗频寄卧云关。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12138,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"答黄扶孟 其二","author":"屈大均","text":"与君心结廿年知，删述垂名岁月迟。\n太白狂歌人欲杀，少陵儒雅自能师。\n长生但向文章得，不死何须药饵持。\n待我云峰三十六，饥来亦复一茹芝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12139,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜谢修五归自高凉","author":"屈大均","text":"久戍高凉宦未成，悲歌日日答猿声。\n炎天少雪头难白，瘴海多雷萝易惊。\n家在长干迷去马，归乘春色听流莺。\n新诗字字干将似，一片寒光照不平。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12140,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄怀施虹玉","author":"屈大均","text":"白门分手十馀霜，不见双鱼别思长。\n三易早明黄氏学，一丘长守考亭乡。\n商歌日夕流金石，汉腊春秋泣豆觞。\n友教肯来南越否，为君先扫读书床。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12141,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄怀闵宾连","author":"屈大均","text":"山经著就轩辕岳，不逐浮丘去学仙。\n白首图书消日月，紫微文字富霞烟。\n鄣开自得三天子，云卧谁争一大年。\n久别星霜知几易，音书难到石堂前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12142,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"答修五见赠香杯","author":"屈大均","text":"久嫌金屈双擎重，最爱香雕独酌轻。\n生结但知油速好，清芬不辩水沉名。\n琼南买得从黎峒，海外持来到越城。\n开取漆箱频赠我，待将樽酒答秋清。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12143,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"呈武番禺","author":"屈大均","text":"天水雄才六郡高，早年频佩吕虔刀。\n来临百粤多膏泽，坐拥三城失海涛。\n秦地风诗还驷驖，楚臣苗裔亦离骚。\n殷勤礼数能忘分，日侍神明敢告劳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12144,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从澹翁乞兰","author":"屈大均","text":"新分兰本满庭开，种自增城白水台。\n自是丈人能灌溉，谁言女子好栽培。\n花宜香柚多阴处，根喜膏泥半熟来。\n肯惠一盘频割爱，将凭诗句报琼瑰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12145,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"为张宪使寿","author":"屈大均","text":"九月新寒上绣裳，炎方易作使君霜。\n茱萸暖寿多蛮酒，茉莉清心满越香。\n姬旦少男惟孝友，康公贤胄更文章。\n东郊南海能为政，平格他年总未央。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12146,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"姬人新制琴囊赠以诗","author":"屈大均","text":"每惜蛛丝十指萦，琴囊借得自琼琼。\n外铺古锦鸳鸯厚，中衬文绫蛱蝶轻。\n凤尾稍宽愁更剪，螺纹微损恨难成。\n休教粉壁时时挂，懒作幽兰积雪声。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12147,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"白鹅潭眺望 其一","author":"屈大均","text":"半空波撼越王台，秋水含烟昼不开。\n海雨忽将山雨去，新潮频截旧潮来。\n风吹岛屿随龙气，月引楼船逐蚌胎。\n南出虎门天险失，诸夷咫尺二洋回。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12148,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"白鹅潭眺望 其二","author":"屈大均","text":"暮天风雨白鹅浮，险绝三江此倒流。\n珠海月开龙女市，玉山霞起蜃王楼。\n人烟掩映桄榔屿，渔火虚无茉莉洲。\n几欲飘洋过日本，白艚东作百蛮游。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12149,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"白鹅潭眺望 其三","author":"屈大均","text":"五仙楼出五羊城，东尽扶胥一日程。\n海道多歧那得问，江门有戍未为兵。\n诸番与我分全险，十郡凭谁举大名。\n直抵金陵舟楫便，孙卢往事足心惊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12150,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"白鹅潭眺望 其四","author":"屈大均","text":"番禺山抱越华楼，势似长城控郁洲。\n偏霸未分东井气，雄图频逐大江流。\n抄关使者三门海，进贡番人万里舟。\n舶口至今蚝镜失，西洋端恐有阴谋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12151,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"白鹅潭眺望 其五","author":"屈大均","text":"秋色苍茫入鬓蓬，潮鸡唤起越王宫。\n龙嘘一气江天失，蟹食三秋水国空。\n月下烹鱼催妇子，云边射雁戒儿童。\n芦花宿处无人觉，跳白船轻任海风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12152,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赋得六旬犹健亦天怜 其一","author":"屈大均","text":"年高但愿似慈亲，白首长为膝下人。\n六十未同蘧瑗化，九旬应返子桑真。\n方刚帝与经营力，未老天留问学身。\n菉竹诗篇教日诵，莫辞圭璧琢磨新。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12153,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赋得六旬犹健亦天怜 其二","author":"屈大均","text":"黔娄未老已甘贫，莱子初衰始暖人。\n婚嫁少完须大耋，酥醪多酌望长春。\n先寒塞雁衔霜苦，欲曙天鸡唤日新。\n蓬鬓不劳青女点，蕙心方与翠娥亲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12154,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送人之延绥 其一","author":"屈大均","text":"延绥此去谒将军，市口西驱马几群。\n地近盐池多渴水，天含沙碛一愁云。\n赫连山势榆台合，无定河声圁水分。\n紫兔黄羊红黍酒，醉来笳鼓不曾闻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12155,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送人之延绥 其二","author":"屈大均","text":"风吹沙绉作龙鳞，沙柳烟含雾柳春。\n耕少家家惟黑黍，战馀处处有青燐。\n受降未拓三城旧，互市频开万帐新。\n茶布好从蒙古易，紫貂银鼠莫辞贫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12156,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送人之延绥 其三","author":"屈大均","text":"水到边头海子多，雨馀饮马兔毛河。\n风寒有酒围黄鼠，雪冻无衣拥紫驼。\n红石飞流银甲洗，黑山断碣宝刀磨。\n边人只解从军乐，战罢琵琶唱卤歌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12157,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送人之延绥 其四","author":"屈大均","text":"款贡楼当马市开，羊绒氂尾总驮来。\n关城曲曲河为套，烽堠山山石作台。\n柏叶柳毛春戴罢，沙葱地软暮收回。\n茶烟税薄堪行贾，博取蔘貂亦见才。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12158,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赋得摇落深知宋玉悲 其一","author":"屈大均","text":"无端宋玉始悲秋，萧瑟长令异代愁。\n楚国大夫多丽则，湘累弟子更风流。\n美人不向离骚取，神女频从梦寐求。\n词客最知摇落早，况闻猿啸满林丘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":12159,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]