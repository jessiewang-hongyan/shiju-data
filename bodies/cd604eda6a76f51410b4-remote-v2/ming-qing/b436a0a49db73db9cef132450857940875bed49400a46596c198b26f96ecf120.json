[{"title":"赠厉子还西泠 其二","author":"屈大均","text":"离亭雨雪暮萧萧，换酒无从得紫貂。\n他日相寻君有梦，东樵不在即西樵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13493,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题友人饮酒图","author":"屈大均","text":"君能中圣复中贤，自可长生作酒仙。\n不见酒星三四五，千秋历历绛河边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13494,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"七夕","author":"屈大均","text":"天上依然揽玉珂，人间不复画青蛾。\n而今却羡双星好，犹得年年一渡河。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13495,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"三川","author":"屈大均","text":"三川水落限门长，秋色苍苍接越裳。\n海月明时拾海月，人人素足白如霜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13496,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后高凉曲 其一","author":"屈大均","text":"不见仙人驾石船，鉴江秋水正连天。\n石篙撑折三千尺，愁绝蓬莱路渺然。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13497,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后高凉曲 其二","author":"屈大均","text":"父子捐身百战时，魂随少帝入天池。\n潘州忠烈推潘氏，一片莓苔蚀旧碑。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13498,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后高凉曲 其三","author":"屈大均","text":"北向金陵哭旧君，天生忠义在斯文。\n一师六弟祠宫在，正气苍茫接白云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13499,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后高凉曲 其四","author":"屈大均","text":"幸蜀当年扈六龙，凄凉故宅草全封。\n心伤二帝馀遗诏，泣向三泉见御容。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13500,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后高凉曲 其五","author":"屈大均","text":"观山近接下宫湾，一棹烟波向夕閒。\n玉井流从金井出，朝霞飞作暮霞还。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13501,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后高凉曲 其六","author":"屈大均","text":"宝山春色照珠台，中有龙湫万壑回。\n父老时时望苍翠，麖鸣知有赦书来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13502,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后高凉曲 其七","author":"屈大均","text":"蜃气苍茫望欲无，天边一道限门孤。\n蚌含明月浮沧海，珠鳖江中亦吐珠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13503,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后高凉曲 其八","author":"屈大均","text":"孔雀花时金翠多，自怜文采舞婆娑。\n珠毛向夕无楼处，飞向人间触网罗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13504,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后高凉曲 其九","author":"屈大均","text":"南巴城下绕江流，二广山川此上游。\n天险可怜资敌国，更无冯盎出潘州。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13505,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠袁锡泉 其一","author":"屈大均","text":"不用仙人绿玉筇，朱明门户水重重。\n因君识得香溪路，舟入罗浮四百峰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13506,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠袁锡泉 其二","author":"屈大均","text":"三日仙源路不穷，冲虚观口系孤篷。\n自来渔父无寻处，曲曲千岩万壑中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13507,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠袁锡泉 其三","author":"屈大均","text":"棹入芙蓉路尽迷，虚传七十二长溪。\n君非五色仙禽引，定是双鬟玉女携。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13508,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠袁锡泉 其四","author":"屈大均","text":"罗阳一水从丫髻，云母双溪自凤冈。\n此道香溪百馀里，山灵为尔辟鸿荒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13509,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠袁锡泉 其五","author":"屈大均","text":"太白当年旌九子，翁山今日命香溪。\n君今名与香溪著，莫惜罗浮白首栖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13510,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭稚女雁 其一","author":"屈大均","text":"当年设帨雁门关，代北诸军尽解颜。\n共道榆林飞将种，明驼莫载木兰还。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13511,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭稚女雁 其二","author":"屈大均","text":"我怜堂上有慈姑，老凤啾啾喜弄雏。\n得此左思娇女子，堪令白发日欢娱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13512,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭稚女雁 其三","author":"屈大均","text":"汝母秦人父越人，汝生于代紫河滨。\n万里三人成骨肉，三年一旦作埃尘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13513,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭稚女雁 其四","author":"屈大均","text":"初生一月即南征，历尽龙沙紫塞城。\n九月霜花凝绣褓，苦寒不断有啼声。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13514,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭稚女雁 其五","author":"屈大均","text":"祖母欢分一味甘，时时枣栗满花篮。\n殷勤剪发为双髴，更与炎洲翡翠簪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13515,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭稚女雁 其六","author":"屈大均","text":"两龄失恃汝何知，哭向桐棺索乳时。\n万里将来孩抱物，何人见尔不生悲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13516,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭稚女雁 其七","author":"屈大均","text":"孩笑朝朝绣佛前，那知有母在黄泉。\n殷勤赖有楼烦女，似燕将雏得两年。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13517,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭稚女雁 其八","author":"屈大均","text":"朝弄书篇夕画图，聪明不独识之无。\n女中博士吾真望，不比寻常掌上珠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13518,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭稚女雁 其九","author":"屈大均","text":"频同曹子伤金瓠，不共任妻哭泽兰。\n汝母劬劳应未足，九泉相待共饥寒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13519,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭稚女雁 其十","author":"屈大均","text":"三月艰难瘴海行，归来不见一枝琼。\n家中大小相持哭，尽作哀猿肠断声。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13520,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭稚女雁 其十一","author":"屈大均","text":"四十商瞿未有儿，初生一女不曾悲。\n三年鞠育何辛苦，作母多于作父时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13521,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭稚女雁 其十二","author":"屈大均","text":"空留汝母嫁时衣，雾縠花罗香渐微。\n欲与他人今不忍，华山高处瘗斜晖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13522,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭稚女雁 其十三","author":"屈大均","text":"罗浮亦作衣冠冢，令化麻姑蝴蝶飞。\n留与人呼小凤子，文章五色有光辉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13523,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭稚女雁 其十四","author":"屈大均","text":"阿母桐花儿小凤，桐花小凤命相关。\n羽毛未就花先死，凤自无心在世间。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13524,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭稚女雁 其十五","author":"屈大均","text":"汝母泉台久寂寥，香魂应念女儿娇。\n月中顾兔难离腹，风里杨花易失条。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13525,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭稚女雁 其十六","author":"屈大均","text":"无端母子来烟瘴，送却浮生数月中。\n无母不应还有子，芙蓉蒂断易随风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13526,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭稚女雁 其十七","author":"屈大均","text":"暂到人间未四秋，为谁辛苦作蜉蝣。\n朝生暮死非予罪，哭向皇天泪迸流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13527,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭稚女雁 其十八","author":"屈大均","text":"葬汝先人墓道西，白杨多处作幽闺。\n若知汝父长相忆，莫向黄泉汝母啼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13528,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭稚女雁 其十九","author":"屈大均","text":"母子之思水月同，月轮只在水当中。\n汝今母子重相见，须识灵光一片空。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13529,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"荔支 其一","author":"屈大均","text":"三闾相见定相亲，颂尔芳辞艳绝伦。\n暮采兰英朝采菊，从来好色一骚人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13530,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"荔支 其二","author":"屈大均","text":"餐来五内金沙发，自是丹砂世不知。\n却笑晋时勾漏令，求仙不解种荔枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13531,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"荔支 其三","author":"屈大均","text":"摘来先饲小鹦哥，万颗匀圆裹芰荷。\n娇女堂前争不已，侍儿花底斗谁多。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13532,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"荔支 其四","author":"屈大均","text":"月中不辨赤瑛盘，笑揽飞琼仔细看。\n君欲身轻成大药，莫辞多啮女唇丹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13533,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"荔支 其五","author":"屈大均","text":"一朵红酥被酒馀，笑从掌上解绡裾。\n丰肌欲拊难留手，乍比凝脂尚不如。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13534,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"荔支 其六","author":"屈大均","text":"摘来经宿尤甜美，日气全消色尚丹。\n一片冰霜凝火实，正阳津液吸来寒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13535,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"荔支 其七","author":"屈大均","text":"新梳宝髻牡丹松，旧染绫襦荔子同。\n金钏换来媚夫婿，一盘都是状元红。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13536,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"荔支 其八","author":"屈大均","text":"小姬生日喜含春，绣佛堂前百果陈。\n三爵奉卿何所祝，玉颜长似荔枝新。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13537,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"荔支 其九","author":"屈大均","text":"沉香浦口万枝悬，鹤顶葳蕤浥露鲜。\n浣女憨妆人共笑，和花插在髻鬟边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13538,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"荔支 其十","author":"屈大均","text":"琵琶洲畔卖花船，溪女娇娆工数钱。\n玉腕罗裙摇橹至，荔支擎出与红莲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13539,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"荔支 其十一","author":"屈大均","text":"流花桥上踏春还，回首荣华薤露间。\n一片冰心堪内映，宁愁时俗薄朱颜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13540,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"荔支 其十二","author":"屈大均","text":"少小嬉游向狭邪，容颜如日映丹霞。\n荔支不用金钱买，自有佳人掷满车。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13541,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"荔支 其十三","author":"屈大均","text":"水枝未尽复山枝，自上枝头摘不迟。\n多食不须忧折福，殷勤为作荔支辞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13542,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"荔支 其十四","author":"屈大均","text":"何来一队绿罗裳，花渡头前弄晚妆。\n欲结同心无所有，怀中大小总丁香。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13543,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"荔支 其十五","author":"屈大均","text":"入口甜霜一片消，美人含吐与琼瑶。\n不愁多食中生热，更有梅花蜜可调。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13544,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"荔支 其十六","author":"屈大均","text":"情深草木奈君何，欲补荔支入九歌。\n异日兰台诸弟子，招魂须用柘浆多。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13545,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将往琼南口占别司香者 其一","author":"屈大均","text":"收香么凤是前身，又作焚香小玉人。\n此去琼南众香国，水沉多买奉仙真。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13546,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将往琼南口占别司香者 其二","author":"屈大均","text":"怜尔朝朝向绣床，只薰东莞女儿香。\n琼州为买奇南去，不惜天风接海长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13547,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将往琼南口占别司香者 其三","author":"屈大均","text":"花田昔作花农去，香市今成香估来。\n黎女定多油速好，金钱数数笑颜开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13548,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将往琼南口占别司香者 其四","author":"屈大均","text":"生本珠娘不爱珠，每将明月换香榆。\n绣成天女兼毛女，沉水多薰取自娱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13549,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将往琼南口占别司香者 其五","author":"屈大均","text":"多栽香子傍芙蓉，家有香田即素封。\n欲向东官金桔岭，尽将妻子作香农。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13550,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"读史","author":"屈大均","text":"惨淡龙颜向六军，马嵬山下血沾裙。\n当时何不弃天子，直抱瑶妃入白云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13551,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"丰湖","author":"屈大均","text":"内湖水暖外湖寒，看杀鸳鸯忘钓竿。\n一叶一花都弄遍，月明还向大夫滩。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13552,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"霁后望罗阳诸峰","author":"屈大均","text":"几朵芙蓉雨外分，麻姑玉女翠氤氲。\n青青一髻无多雪，日夕光含一片云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13553,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题邹元焕荷锄小影 其一","author":"屈大均","text":"化鹤卢耽去几年，蜉蝣衣服已成烟。\n羚羊峡口君休去，柯烂归来未是仙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13554,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题邹元焕荷锄小影 其二","author":"屈大均","text":"丁丁我亦一山樵，斤斧秋来日在腰。\n欲作仙人棋弟子，芝房赌取董仁娇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13555,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"有赠","author":"屈大均","text":"碧玉相思君已深，双莲且寄一枝簪。\n不愁叶底无甜藕，只要花中有苦心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13556,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"望茭塘海滨诸村","author":"屈大均","text":"树树穿榕是木棉，人家多在海门边。\n初晴雨气犹含日，乍暖春阴尚作烟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13557,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"所见 其一","author":"屈大均","text":"不将■鬌学中华，亦有胭脂似汉家。\n一自明妃天上落，春光留得在龙沙。","collection":"明末清初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13558,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"所见 其二","author":"屈大均","text":"多饮酡酥玉貌红，盘头大脚出辽宫。\n生憎走马穿花去，更打鸳鸯一弹弓。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13559,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠金陵歌者","author":"屈大均","text":"筝琶近得教坊师，尽学金元杂剧词。\n小唱最嫌时曲贱，此音惟有顿仁知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13560,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"闻笳和徐太史 其一","author":"屈大均","text":"一片湖山是塞沙，招魂只用一声笳。\n魂兮解向阴阳食，不必清明奠乳茶。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13561,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"闻笳和徐太史 其二","author":"屈大均","text":"南北湖干尽白坟，笳声催去哭边云。\n满州兵妇衣如雪，一半红妆学汉军。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13562,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"落花","author":"屈大均","text":"枝枝都被晓风催，岂有黄莺啄复开。\n已是落花花已落，何须吹去复吹来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13563,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蘼芜","author":"屈大均","text":"生作芙蓉即断肠，蘼芜可幸不曾香。\n青青青到天涯路，一片惟知惹夕阳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13564,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"花前","author":"屈大均","text":"花前小立影徘徊，风解吹裙百摺开。\n已有泪光同白露，不须明月上衣来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13565,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠东湖校书侍女","author":"屈大均","text":"扫镜青衣亦自妍，相逢正及破瓜前。\n人言白白泥中藕，却胜红红水上莲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13566,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"新眉","author":"屈大均","text":"新眉懒画月斜斜，调粉无心注露华。\n解道海棠因泪化，莫教沾洒又生花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13567,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]