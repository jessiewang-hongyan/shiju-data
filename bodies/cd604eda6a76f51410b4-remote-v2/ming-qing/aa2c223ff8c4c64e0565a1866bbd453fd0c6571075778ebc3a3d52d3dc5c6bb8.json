[{"title":"故人","author":"屈大均","text":"故人惟五老，长在匡庐山。\n笑我十年去，无成终不还。\n玉川飞瀑上，金竹大坪间。\n两处堪栖止，浮云且自閒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10250,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哀殇 其一","author":"屈大均","text":"母魄藏梅子，儿魂在上河。\n荆吴千里隔，风雨两秋过。\n梦以黄泉好，情当白首多。\n高堂知此信，沾洒更如何。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10251,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哀殇 其二","author":"屈大均","text":"无母谁怜汝，酸啼绝乳时。\n提携劳二妾，丧乱苦孤儿。\n大别魂来抱，长干骨未持。\n归舟多涕泪，总为两坟悲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10252,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口守风作 其一","author":"屈大均","text":"舟自秦淮发，江行岁欲除。\n一风起彭蠡，十日望匡庐。\n身在因闻道，途穷为著书。\n妻孥纷涕泪，食尽有湖鱼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10253,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口守风作 其二","author":"屈大均","text":"清浊鸳鸯水，微茫此合流。\n江穿彭蠡去，山逐落星浮。\n雁早先过岭，凫寒故近舟。\n萧萧双短鬓，空与荻花秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10254,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口守风作 其三","author":"屈大均","text":"渔父劳相问，芦中又一人。\n图书青草没，儿女白鸥亲。\n十日依沙屿，三年似水蘋。\n浮沉吴楚好，终是北堂身。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10255,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口守风作 其四","author":"屈大均","text":"鹧鸪飞不北，归计只番禺。\n妻子皆南客，蛮夷有老夫。\n水声秋在石，山影晚当湖。\n莫恨多憔悴，先人是左徒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10256,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口守风作 其五","author":"屈大均","text":"左蠡苍茫外，黄岩彩翠中。\n双帆难出浦，十里亦悲风。\n瀑布无心望，梅花有梦通。\n天生大蝴蝶，只许在禺东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10257,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口守风作 其六","author":"屈大均","text":"鹧鸪元有志，岂畏朔天寒。\n日是罗浮早，花惟涨海丹。\n将归儿女喜，未到水风难。\n清绝高堂月，犹从梦里看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10258,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口守风作 其七","author":"屈大均","text":"县外江湖合，波涛尽白头。\n芙蓉吹已落，复作大孤浮。\n苍翠连三楚，萧森起一洲。\n平生惭惠远，不向虎溪留。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10259,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口守风作 其八","author":"屈大均","text":"庐岫须臾失，湖光变白云。\n波涛将布水，总作雨纷纷。\n竹影何时见，松声昨夜闻。\n梦魂如可再，更去访匡君。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10260,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口守风作 其九","author":"屈大均","text":"万仞香垆影，飞来带紫烟。\n窗从疏雨入，帆与乱云悬。\n月射湖光直，风吹岳势偏。\n白鸥知寂寞，一一酒尊前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10261,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口守风作 其十","author":"屈大均","text":"雨中多白鹭，争拂钓船飞。\n枫叶明墟落，芦花隐翠微。\n石钟风外响，渔火夜深归。\n未遂浮家志，霜鳞此地肥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10262,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口守风作 其十一","author":"屈大均","text":"幽幽三峡涧，人饮玉泉肥。\n自向白云去，长因萱草归。\n九江愁挂席，五老枉开扉。\n日与南风守，那能白发稀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10263,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口守风作 其十二","author":"屈大均","text":"片帆旬日驻，未赴石人期。\n鸾鹤那知义，龙蛇自有时。\n霜惊寒气早，雨爱暮声迟。\n渔钓难为食，王孙且莫悲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10264,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口守风作 其十三","author":"屈大均","text":"苍翠朝来好，风多影不分。\n吹将千仞水，散作半空云。\n兰棹那能发，渔歌故使闻。\n厌看烟火外，白鹭点氤氲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10265,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口守风作 其十四","author":"屈大均","text":"朝朝湖口泊，五老笑人愁。\n日月三年掷，鸿濛一啸收。\n妻孥催白发，射猎及清秋。\n归向梅鋗岭，英豪事可求。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10266,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口守风作 其十五","author":"屈大均","text":"求鱼飞复下，谁道鹭鹚閒。\n芳草虽无地，浮云亦有山。\n风波消壮志，岁月长愁颜。\n收拾浮生事，天容更掩关。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10267,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口守风作 其十六","author":"屈大均","text":"飓风如涨海，十口日惊心。\n雷雨争何事，蛟龙病至今。\n云开湖镜小，山没浪花深。\n三日羹鱼好，行将典素琴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10268,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口守风作 其十七","author":"屈大均","text":"兼旬风雨苦，力尽半船书。\n老使文章贵，愁令啸咏疏。\n沙寒初有雁，石浅更多鱼。\n安得高堂许，柴桑竟隐居。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10269,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口守风作 其十八","author":"屈大均","text":"香炉空外起，一气日氤氲。\n石色青天地，花光白水云。\n雨来凫雁合，风起瀑泉分。\n县小围山半，人烟易夕曛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10270,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口守风作 其十九","author":"屈大均","text":"娇小怜儿女，从人望翠屏。\n不知庐岳好，只爱大孤青。\n三岁来吴楚，全家作水萍。\n风波惊一路，最险是宫亭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10271,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口守风作 其二十","author":"屈大均","text":"烟雨同三妇，潇湘礼二灵。\n眉将南岳写，衣得女花馨。\n抱子还梅峤，从姑说洞庭。\n无穷风水事，江汉肯重经。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10272,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口守风作 其二十一","author":"屈大均","text":"胜地惟江左，留居惜未成。\n妻孥思素业，兄弟恨虚名。\n散帙惊涛溅，开帆白鸟迎。\n彭湖不可渡，半月阻归程。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10273,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口守风作 其二十二","author":"屈大均","text":"首路争鸿雁，深秋家未还。\n西江掩桂楫，南塞阻梅关。\n宝剑空多气，香醪不上颜。\n裁诗颂风伯，咫尺是庐山。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10274,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湖口守风作 其二十三","author":"屈大均","text":"乌鸟思归养，雌雄失路时。\n音声南客爱，文采北禽欺。\n日落收帆早，风清解带迟。\n故林多食物，最好是离支。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10275,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"峡江县","author":"屈大均","text":"县小全无地，城高半在山。\n人家双杵急，野渡一舟閒。\n月出夕阳际，烟生秋水间。\n沙洲防阁浅，帆宿及前湾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10276,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吉州感事 其一","author":"屈大均","text":"螺川清且浅，水色映青原。\n沙渍三年血，风飘百战魂。\n皆怜都尉苦，莫念郦生冤。\n一自生降去，声今为尔吞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10277,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吉州感事 其二","author":"屈大均","text":"两年酣战苦，人恨小韩信。\n雨暗青燐影，风高白骨尘。\n亲军难救汝，奇道不先人。\n永夜帆樯宿，因君泪满巾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10278,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吉州感事 其三","author":"屈大均","text":"惊人惟间道，老我是孤城。\n深入应无敌，迟行自受兵。\n师徒随雨散，壁垒与云平。\n饮尽将军血，苍茫哭一声。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10279,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吉州感事 其四","author":"屈大均","text":"少卿词赋客，岂意亦能军。\n玉貌重围损，金笳怨曲闻。\n刀环谁赠汝，剑客几从君。\n一片骅骝气，长吞大漠云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10280,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"三峡涧","author":"屈大均","text":"廿四溪潭汇，惊雷响不通。\n如何三峡水，都在一桥中。\n白喷炎天雪，寒吹古涧风。\n栖贤僧舍外，坐久瀑声空。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10281,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梅鋗 其一","author":"屈大均","text":"庾岭惟秦塞，台侯是越人。\n重瞳封万户，勾践有孤臣。\n浈水乡闾旧，鄱阳俎豆新。\n千秋交广客，欲继入关尘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10282,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梅鋗 其二","author":"屈大均","text":"艰难自梅里，此地奉君王。\n岂欲兴于越，惟知祀少康。\n雠从高帝复，名在汉书长。\n食采梅花国，人钦万古香。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10283,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梅鋗 其三","author":"屈大均","text":"蠢尔龙川令，乘时窃一州。\n徒能欺二世，不解助诸侯。\n冠带迟南越，车书阻上游。\n将军句践裔，智勇著春秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10284,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠安远水驿汪丞 其一","author":"屈大均","text":"一路连舟下，艰难至越门。\n汝官秋水驿，吾卧白云村。\n十口蛟龙出，三城虎豹存。\n轩辕读书处，为我置琴樽。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10285,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠安远水驿汪丞 其二","author":"屈大均","text":"莫道官微甚，前贤重抱关。\n况当中宿胜，堪在上方閒。\n帝子弄长笛，佳人归玉环。\n经过多赋客，因尔叩云山。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10286,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠安远水驿汪丞 其三","author":"屈大均","text":"山水矜三峡，君臣在二禺。\n官衙纷彩翠，仙迹未虚无。\n吹角江城暮，维舟野寺孤。\n随潮经一宿，多谢酒频沽。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10287,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏史","author":"屈大均","text":"匕首频虚发，无成愧丈夫。\n心悲虽故国，事去未穷途。\n钜野堪为盗，朱家且作奴。\n如何惭一母，无食向江湖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10288,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过陈丈园","author":"屈大均","text":"七载不相见，玉兰如我长。\n香多王者物，花是老人粮。\n养寿宜閒事，留春在醉乡。\n东园公寡友，相与只张良。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10289,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"珏砚","author":"屈大均","text":"雌雄双玉砚，追琢益天然。\n日月元同命，圭璋自比肩。\n气应为美女，光定烛高天。\n宜尔题诗笔，沾濡出紫烟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10290,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠尹子生日 其一","author":"屈大均","text":"君从少年日，人外已能閒。\n有道须耽酒，无心即闭关。\n水摇窗户绿，花点鬓毛斑。\n岁岁春无事，相逢总玉颜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10291,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠尹子生日 其二","author":"屈大均","text":"夜夜观垂象，长星欲竟天。\n心惊离乱后，计得废兴前。\n硕果谁能食，乔松自有年。\n红桥花里渡，咫尺即飞仙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10292,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"尹君有三孙甚怜爱诗以赠之","author":"屈大均","text":"君里亦西豪，人才两代高。\n儿生珠子树，父与凤凰毛。\n不以龙孙小，而忘燕翼劳。\n家声承乃祖，青琐更分曹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10293,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠友侄林赤见","author":"屈大均","text":"有美忠良后，人称小凤凰。\n汝才须丽则，吾道亦文章。\n珠晒当明月，梅开及一阳。\n亲仁诸父在，孝友与天长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10294,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"答于鼎 其一","author":"屈大均","text":"今代神交我，无如君弟兄。\n心从天外得，目向梦中成。\n黄海期终践，炎州事已平。\n寄言峰上月，留为绿樽明。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10295,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"答于鼎 其二","author":"屈大均","text":"风雅三闾变，离骚万古师。\n汉时多帝子，今代只孙枝。\n尔赋追南楚，人称似景差。\n贻予双五律，丽则掩当时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10296,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"九月药亭宅见梅","author":"屈大均","text":"梅喜炎州暖，长开在菊前。\n年芳能自早，秋色为君妍。\n朔雪从无地，南花更有天。\n忘忧须此物，泛泛酒杯传。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10297,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菊","author":"屈大均","text":"蛮花皆早发，黄菊独宜寒。\n雪少英难落，霜微叶已丹。\n香从梅外得，甘以露时餐。\n秋色为春色，留君隔岁看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10298,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"冬菊赠人","author":"屈大均","text":"节过无人赏，芬芳实在今。\n香分梅萼暗，色与雪花深。\n甘苦平生节，荣枯一日心。\n年年当小岁，君向粤中寻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10299,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄扶晨于鼎文冶兄弟 其一","author":"屈大均","text":"一片成黄海，黄山信有无。\n汤池在烟雾，石笋似菰蒲。\n峰好人相让，松多汝不孤。\n平生怀小华，可得上天都。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10300,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄扶晨于鼎文冶兄弟 其二","author":"屈大均","text":"爱尔贤兄弟，真同大小山。\n松高争岳出，花好与人閒。\n岁事先秋尽，天心及早还。\n才多无不可，啸咏且相攀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10301,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梧宫","author":"屈大均","text":"范蠡未霸越，五湖安可浮。\n故人尽西子，终古一扁舟。\n雪气含烟白，山光逐水流。\n梧宫何处是，萧瑟近长洲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10302,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏史","author":"屈大均","text":"自古皆亡命，英雄岂异人。\n龙蟠忧有气，虎变患无身。\n孺子虽神智，圯桥且隐沦。\n箧中兵法在，端可灭强秦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10303,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寓居江乡有作","author":"屈大均","text":"扶床多稚子，敦杖有慈亲。\n甘苦同黄菊，浮沉在白蘋。\n未归华夏国，犹是乱离人。\n松树能霜雪，天寒苍翠新。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10304,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠水岩砚与韬荒","author":"屈大均","text":"一片九渊质，摩娑真气蒸。\n端方山岳立，温润水云凝。\n洗涤防儿女，提携得友朋。\n赠君归著作，世世宝相承。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10305,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"移家返沙亭赋赠家泰士兄 其一","author":"屈大均","text":"亲年若流水，喜惧两交心。\n身许须他日，家移且旧林。\n君能衣彩笔，我亦食瑶琴。\n一自为高节，穷秋共至今。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10306,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"移家返沙亭赋赠家泰士兄 其二","author":"屈大均","text":"二月沙亭好，家家有蜀茶。\n閒持一尊酒，遍赏四邻花。\n哀怨伤天性，沉酣答岁华。\n贤兄见春草，丽句辄相誇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10307,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"田尾村居","author":"屈大均","text":"葛蔓滋三径，榕阴蔽数家。\n农收霜降稻，圃落小寒瓜。\n鱼戏流云乱，蝉嘶落日斜。\n杖藜无事极，吟绕未开花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10308,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日石门山房作","author":"屈大均","text":"一叶惊山鸟，萧萧秋欲分。\n天寒难作雨，地湿易生云。\n石气衣裳透，兰香几席薰。\n美人如玉魄，月下影纷纷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10309,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"沙湾作","author":"屈大均","text":"青镜休相照，愁人未有颜。\n年丰偏乏食，时至尚扃关。\n云白花迷路，霜黄叶满山。\n扁舟安所往，鱼蟹足西弯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10310,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟入漓山赠内","author":"屈大均","text":"舟穿岩洞出，石乳滴人寒。\n袖湿千峰翠，颜分万叶丹。\n烟深山影少，风乱水声难。\n一树幽兰草，青青尽日看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10311,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"草堂夜坐作","author":"屈大均","text":"萧瑟草堂风，无眠夜欲中。\n剑光寒透室，琴响静流空。\n智在年方壮，文多道自穷。\n行藏殊未定，且作浣花翁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10312,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"京口眺望和人","author":"屈大均","text":"岷峨万里水，东下阻金焦。\n淼淼连三楚，茫茫送六朝。\n乱帆随白鸟，哀角响青霄。\n京口英雄地，摴蒱未寂寥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10313,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"对月","author":"屈大均","text":"暮雨过天末，秋光出水滨。\n幽心知最早，白首见如新。\n皎洁终辞夜，悲欢几累人。\n他宵江海上，寂寞更相亲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10314,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"朱人远曾经屈沱作歌屈沱者三闾大夫所居楚人谓江之别流为沱云 其一","author":"屈大均","text":"秭归南郭外，传是左徒家。\n有客寻苗裔，维舟向水涯。\n仙成为海伯，赋就散天葩。\n祖述多高弟，如君更丽华。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10315,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]