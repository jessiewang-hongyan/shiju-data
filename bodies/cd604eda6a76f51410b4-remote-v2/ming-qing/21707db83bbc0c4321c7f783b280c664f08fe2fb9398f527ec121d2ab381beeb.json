[{"title":"后秋兴八首壬寅三月二十三日以后，大临无时，啜泣而作 其七","author":"钱谦益","text":"枕戈坐甲荷元功，一柱孤擎溟渤中。\n整旅鱼龙森束伍，誓师鹅鹳肃呼风。\n三军缟素天容白，万骑朱殷海气红。\n莫笑长江空半壁，苇间还有刺船翁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14770,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后秋兴八首壬寅三月二十三日以后，大临无时，啜泣而作 其八","author":"钱谦益","text":"夷山填海莫逶迤，复汉争如丈尺陂？\n故国楼桑围羽盖，上林仆柳发条枝。\n坐看河鼓云旗动，笑指渐台斗柄移。\n金粟堆前空翠裹，金烬犹傍玉衣垂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14771,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吟罢自题长句拨闷二首 其一","author":"钱谦益","text":"孤臣泽畔自行歌，烂熳篇章费折磨。\n似隐似俳还似谶，非狂非醉又非魔。\n呕心自笑才华尽，扪腹其如倔强何？\n二祖历宗恩养士，几人吟咀泪痕多？","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14772,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吟罢自题长句拨闷二首 其二","author":"钱谦益","text":"不成悲泣不成歌，破砚还如墨盾磨。\n拌以馀生供漫兴，欲将秃笔扫群魔。\n途穷日暮聊为尔，发短心长可奈何？\n赋罢无衣方卒哭，百篇号踊未云多。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14773,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后秋兴八首自壬寅七月至癸卯五月，讹言繁兴，鼠忧泣血，感恸而作，犹冀其言之或不诬也 其一","author":"钱谦益","text":"地坼天崩桂树林，金枝玉叶痛森森。\n衣冠雨绝支祈锁，阊阖风凄纣绝阴。\n丑虏贯盈知有日，鬼神助虐果何心？\n贼臣万古无伦匹，缕切挥刀候斧砧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14774,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后秋兴八首自壬寅七月至癸卯五月，讹言繁兴，鼠忧泣血，感恸而作，犹冀其言之或不诬也 其二","author":"钱谦益","text":"海角崖山一线斜，从今也不属中华。\n更无鱼腹捐躯地，况有龙涎泛海槎。\n望断关河非汉帜，吹残日月是胡笳。\n嫦娥老大无归处，独倚银轮哭桂花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14775,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后秋兴八首自壬寅七月至癸卯五月，讹言繁兴，鼠忧泣血，感恸而作，犹冀其言之或不诬也 其三","author":"钱谦益","text":"庸蜀经营付落晖，宫车消息转依微。\n空留赤血从三后，无复遗言诏六飞。\n马角乌头期已误，龙姿虎步谶俱违。\n逆臣送喜猖狂甚，趣兴燃脂照腹肥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14776,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后秋兴八首自壬寅七月至癸卯五月，讹言繁兴，鼠忧泣血，感恸而作，犹冀其言之或不诬也 其四","author":"钱谦益","text":"自古英雄耻败棋，靴刀引决更何悲？\n君臣鳌背仍同国，生死龙胡肯后时？\n事去终嗟浮海误，身亡犹叹渡河迟。\n关张无命今犹昔，筹笔空烦异代思。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14777,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后秋兴八首自壬寅七月至癸卯五月，讹言繁兴，鼠忧泣血，感恸而作，犹冀其言之或不诬也 其五","author":"钱谦益","text":"梦回犹傍五溪山，历井扪参吐雾间。\n却指帝星临楚分，如闻王气满吴关。\n地翻黑水才伸足，天转青城始破颜。\n辛苦苍梧旧留守，忠魂常领百僚班。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14778,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后秋兴八首自壬寅七月至癸卯五月，讹言繁兴，鼠忧泣血，感恸而作，犹冀其言之或不诬也 其六","author":"钱谦益","text":"麻衣如雪白盈头，六月霜飞哭九秋。\n两耳也随风雨劫，半人偏抱古今愁。\n地闲沮洳教鱼鸟，天阔烟波养鹭鸥。\n谁上高台张口笑？\n为他指点旧皇州。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14779,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后秋兴八首自壬寅七月至癸卯五月，讹言繁兴，鼠忧泣血，感恸而作，犹冀其言之或不诬也 其七","author":"钱谦益","text":"踰沙轶漠百王功，二祖威凌浩劫中。\n高庙石龟晴吐雨，长陵铁马夜呼风。\n南临日驾千重紫，北借霓旌万队红。\n葛藟绵绵周祚远，明神岂诳白头翁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14780,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"后秋兴八首自壬寅七月至癸卯五月，讹言繁兴，鼠忧泣血，感恸而作，犹冀其言之或不诬也 其八","author":"钱谦益","text":"蛟宫螭窟势逶迤，蹙浪排波似越陂。\n荷鼓虚危新气象，白茅青社旧孙枝。\n磨刀雨过看兵洗，舶䑲风来想檄移。\n昨夜江天聊举首，寒芒二八已昭垂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14781,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"癸卯中夏六日重题长句二首 其一","author":"钱谦益","text":"漫漫长夜独悲歌，孤愤填胸肯自磨。\n敌对灾星凭酒伯，破除愁垒仗诗魔。\n逢人每道君休矣，顾影还呼汝谓何。\n欲共老渔开口笑，商量何处水天多。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14782,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"癸卯中夏六日重题长句二首 其二","author":"钱谦益","text":"百篇学杜拟商歌，墨沈频将渍泪磨。\n世难相寻如鬼疰，国恩未报是心魔。\n射潮霸主吾衰矣，观井仙人奈老何？\n取次长谣向空阔，江天云物为谁多？","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14783,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠江右施伟长一首","author":"陆典","text":"须眉历落舌纵横，讲武论文满座惊。\n提笔杀人犹带血，杖藜哭世不闻声。\n踢翻北斗身须见，吸尽西江气未平。\n千古鲁连归海上，何人一矢躲聊城。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14784,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"移居半野堂","author":"钱谦益","text":"残生天与慰途穷，是处云霞媚此翁。\n卜宅已居青嶂里，移家仍在翠微中。\n映门杨柳萋迷绿，掩户桃花合匝红。\n但放秦人鸡犬去，也应识路似新丰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14785,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"红豆诗","author":"钱谦益","text":"春深红豆数花开，结子经秋只一枚。\n王母仙桃余七颗，争教曼倩不偷来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14786,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"三峰晚秋","author":"吴伟业","text":"晓色近诸天，霜重万象悬。\n鸡鸣松顶日，僧语石房烟。\n清磬秀群水，幽花香一泉。\n欲参黄蘖义，使向此中传。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14787,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题王石谷虞山枫林图","author":"吴伟业","text":"初冬景物未萧条，红叶青山色尚娇。\n一幅天然图画里，维摩僧寺破山桥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14788,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"挽河东夫人","author":"龚鼎孳","text":"岂少完人传，如君论定稀。\n朱颜原独立，白首果同归。\n绝脰心方见，齐牢宠不非。\n可怜共命鸟，犹逐绛云飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14789,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"游虞山","author":"曹溶","text":"几折嶙峋上，烟云杳霭间。\n侵衣见苍翠，沸耳听潺湲。\n俗爱三春闹，余欣半日闲。\n从兹蜡两屐，揽胜始虞山。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14790,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"龙泉寺题壁","author":"刘蓼雪","text":"我来挥泪看钟阜，零落梅花绕树飞。\n宗国故宫嘶战马，孝陵荒草卧肥豨。\n杏开乍见红成市，柳暗初嫌碧掩扉。\n怪煞俗人如傀儡，明朝拼与世相违。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14791,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"述怀","author":"丁文瑗","text":"痛说江城破，于今已卅年。\n丹心终不改，白发幸能全。\n薇蕨拌生采，衣冠敢死捐。\n顽民嗤我是，论定盖棺前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14792,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赋赠黄介子先生","author":"吴芳植","text":"自古文章厄数奇，惜公磨砺度年时。\n淩云枉自誇三赋，避世何堪发五噫。\n绕陌昏烟人去远，隔山皓月梦来迟。\n秋期海上鲸鱼至，更觅长竿理钓丝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14793,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"十六字令 怀远，代人作","author":"商景兰","text":"瓜。\n今岁须教早吐花。\n圆如月，郎马定归家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14794,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"忆秦娥 忆外，代人作","author":"商景兰","text":"寒夜冷。\n终日离愁如断梗。\n如断梗。\n日久春长，银瓶落井。\n落梧惊梦凭谁醒。\n窗前窗后花枝影。\n花枝影。\n玉漏催残，孤灯半隐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14795,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长相思 暮归","author":"商景兰","text":"过桥西。\n花满堤。\n步印香泥小径归。\n烟笼万户低。\n月初辉。\n星渐稀。\n光到窗前知未知。\n何处夜乌啼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14796,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长相思 赋惜花春起早","author":"商景兰","text":"月刚斜。\n日影些。\n一路香风绕碧纱。\n忙忙贴鬓花。\n冷莓■。\n遍地遮。\n满院春情委露华。\n枝头宿鸟喳。","collection":"明末清初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14797,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春光好 代姊别妹","author":"商景兰","text":"枫树冷，菊花黄。\n伴行妆。\n画舫归途十里塘。\n为谁忙。\n烟水萍丝荇菜，沙汀鸂鶒鸳鸯。\n多少离情此际有，待佳章。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14798,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 送女归，代人作","author":"商景兰","text":"唱罢骊驹神暗伤。\n阑干小月印虚堂。\n花枝影度隔帘香。\n人去空留千里梦，寒深午夜怯银床。\n独留灯烬照荒凉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14799,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"忆秦娥 怀远，代人作","author":"商景兰","text":"云将暮。\n寒砧声送愁无数。\n愁无数。\n孤鸿只影，极天难诉。\n片帆不返金陵渡。\n相思难道相思路。\n相思路。\n千里风尘，一帘霜露。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14800,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"如梦令 怀远，代人作","author":"商景兰","text":"寂寞寒深孤枕。\n风度罗帏梦醒。\n梦醒却无情，此际离愁漫整。\n夜冷。\n夜冷。\n花动闲窗月影。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14801,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长相思 即事","author":"商景兰","text":"水绕溪。\n花满堤。\n鹦鹉声高烟柳迷。\n愁多恨鸟啼。\n香霏霏。\n泪凄凄。\n坐看西山虹影低。\n诗成雪乱飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14802,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长相思 即事","author":"商景兰","text":"花影圆。\n月正妍。\n隔林啼鸟夜声传。\n相看情倍牵。\n整翠钿。\n拂朱弦。\n熏尽罗帏未肯眠。\n庭前霜满天。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14803,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长相思 春景","author":"商景兰","text":"芳草齐。\n鹧鸪啼。\n满院花光傍竹篱。\n行行日已西。\n柳条长，宝马嘶。\n问尔王孙归未归。\n楼高望转迟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14804,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"捣练子 秋思","author":"商景兰","text":"风草草，露浓浓。\n筑起愁城几万重。\n黄叶满庭人未扫，一声哀雁五云中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14805,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"少年游 冬景","author":"商景兰","text":"梅头未绽，朔风如历，白雪暗飞香。\n轻寒到枕，愁肠顿起，小胆怯空房。\n满天云气，一炉烟烬，迢递此韶光。\n高唐路杳，楚台无梦，何处写鸳鸯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14806,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"上西楼 夜阑闻雨","author":"商景兰","text":"江城云暗星稀。\n鸟孤飞。\n帘外绿残红瘦、漏声催。\n正风雨。\n凄凉处。\n烛花微。\n警醒梦魂时节、捲罗帏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14807,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"画楼春 夜阑闻雨","author":"商景兰","text":"城楼吹漏声长。\n玉炉宝篆生光。\n乱红落尽暗遗香。\n浴后残妆。\n画槛雕楼花鸟，曲屏远挂潇湘。\n窗前漫整薄罗裳。\n无限凄凉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14808,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇 暮景","author":"商景兰","text":"时候黄昏，兰房独坐愁多少。\n寒云缥缈。\n深把梅枝绕。\n海月初升，远寺钟声早。\n炉烟袅。\n离情未了。\n步即兰灺小。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14809,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"探春令 暮归","author":"商景兰","text":"斜阳远树晚鸦栖，薄暮愁云闭。\n又朔风、吹入孤舟里。\n荡双桡月浮江碎，过沙汀三四。\n看渔灯、隐隐芦苇岸，一派腊深天气。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14810,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长相思 春游，代人作","author":"商景兰","text":"思悠悠。\n恨悠悠。\n懒整残妆独倚楼。\n寒光动玉钩。\n星也愁。\n月也愁。\n不耐孤衾拥碧秋。\n离怀未肯休。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14811,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"思帝乡 闺怨","author":"商景兰","text":"鸳帐冷，烛光浮。\n帐冷光浮梦短，思悠悠。\n添得满腔憔悴，满身愁。\n纵到花间月底，意难留。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14812,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"忆秦娥 雪景","author":"商景兰","text":"彤云恶。\n六花片片穿帘幕。\n穿帘幕。\n鸟栖深树，人登高阁。\n茫茫无际愁烟薄。\n玉龙盐虎添萧索。\n添萧索。\n一天飞影，半林松鹤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14813,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"忆秦娥 雪中别谷虚大师","author":"商景兰","text":"空留恋。\n杨花袅袅随风战。\n随风战。\n弥天道远，流光如箭。\n冰壶夜月凝光殿。\n朔风减碎鹅毛片。\n鹅毛片。\n飞翔莫定，何时相见。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14814,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"忆王孙 雪夜即事","author":"商景兰","text":"凄风夜夜打空林。\n金锁烟寒上绣衾。\n春滞莺黄未敢鸣。\n倍多情。\n寄恨鹍丝三两声。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14815,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 初春夜坐","author":"商景兰","text":"玉漏频催夜气清。\n篆烟深锁绣帏轻。\n满庭明月照残更。\n雁柱十三空寄恨，关河百二总离情。\n春恨何事巧相侵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14816,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"醉花间 春恨","author":"商景兰","text":"愁离别。\n偏离别。\n别恨多周摺。\n无计解离情，独倚天边月。\n窗外子规啼，正与春风杂。\n问鸟语花光，何时皆愁绝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14817,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长相思 雪中作。寄宝姑娘","author":"商景兰","text":"梅蕊青。\n雪花萦。\n雪重梅寒万里平。\n微风窗纸声。\n问卿卿。\n定有情。\n篆冷香消却怎生。\n同心两地明。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14818,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"诉衷情 雪中怀女僧谷虚","author":"商景兰","text":"无端小立琐窗前。\n飞絮影连天。\n蒲团雪深三尺，参透几多禅。\n花欲绽，鸟犹寒。\n孰相怜。\n歌翻白雪，笛弄梅花，两鬓霜添。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14819,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"捣练子 春日舟中见月","author":"商景兰","text":"烟漠漠，路茫茫。\n桃李无言万树芳。\n百啭黄莺催日暮，白云深处透微光。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14820,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春光好 坐河边新楼","author":"商景兰","text":"山色秀，水纹清。\n落花轻。\n沙上鸳鸯泛绿汀。\n棹归声。\n小鸟如啼如话，春光乍雨乍晴。\n一派霞光催日暮，月东升。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14821,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 坐河边新楼，代人作","author":"商景兰","text":"画楼槛外啼黄鸟。\n山光横断残阳渺。\n春色杳难留。\n衔杯花下愁。\n绣窗笼晓日。\n紫燕穿帘急。\n柳拂水痕清。\n渔歌渡远汀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14822,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"菩萨蛮 坐河边新楼，代人作","author":"商景兰","text":"春光难驻伤心色。\n远山暮影烟如织。\n花气傍高楼。\n游人在上头。\n闲倚阑干敞。\n湖水平如掌。\n浪影乱晴空。\n渔舟荡晚风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14823,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"海棠春 赠侄女吴子","author":"商景兰","text":"绿窗春透垂杨影。\n更多少、月明风冷。\n花枝黄鸟声，绣阁酣初醒。\n被底鸳鸯，阶前白璧。\n都是欢时美景。\n惭愧白头人，空叹时如锦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14824,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"更漏子 闺中四景词 春","author":"商景兰","text":"艳阳天，流水曲。\n处处莺啼柳绿。\n初睡足，晓妆迟。\n帘开燕子飞。\n桃如火，梅如豆。\n添得玉颜消瘦。\n眉淡淡，鬓星星。\n王孙草正青。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14825,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"更漏子 闺中四景词 夏","author":"商景兰","text":"湘帘外，池水侧。\n双燕风前归急。\n移玉簟，弄双纨。\n黄梅雨正翻。\n薰风起，芙蓉乱。\n叶底鸳鸯寻伴。\n一队队，一双双。\n联翩宿野塘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14826,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"海棠春 闺中四景词 秋","author":"商景兰","text":"西风萧瑟梧桐老。\n闻处处、寒砧夜捣。\n罗袂拂霜轻，雾髻侵云袅。\n绿窗声送孤鸿早。\n纨扇上、离愁多少。\n月下桂香浮，限煞秋光好。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14827,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"海棠春 闺中四景词 冬","author":"商景兰","text":"朔风剪出鹅毛片。\n柳絮与、梅花相见。\n木落万山空，正大江如练。\n红炉拨尽寒犹战。\n况夜夜、玉壶添箭。\n耐得岁寒心，又苦桃花面。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14828,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"卜算子 初春游寓山看花","author":"商景兰","text":"春半绿茵齐，处处香风透。\n满目青山点翠苔，景色依然秀。\n尽道柳丝黄，不解梅花瘦。\n回首莺啼深树时，正是秋千候。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14829,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"忆秦娥 初春剩国忆子","author":"商景兰","text":"莺声咽。\n柳梢烟雨梅梢月。\n梅梢月。\n谁家玉笛，十分凄切。\n迢迢子去伤离别。\n空亭寂寞愁心结。\n愁心结。\n梨花飞碎，香飘尘绝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14830,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞天春 初春同友坐剩国书屋","author":"商景兰","text":"黄鹂槛外声小。\n曲径残梅未扫。\n淑气含春遍芳草。\n正晴光缭绕。\n闲庭竟日悄悄。\n无奈佳人去早。\n蛱蝶轻飞，风飘花乱，新愁多少。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14831,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]