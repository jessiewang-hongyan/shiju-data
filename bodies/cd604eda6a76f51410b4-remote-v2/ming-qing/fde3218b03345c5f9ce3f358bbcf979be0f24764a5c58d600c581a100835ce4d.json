[{"title":"哭华姜一百首 其五十一","author":"屈大均","text":"麻姑怪尔恋人间，云母丹成去不还。\n寻遍罗浮峰四百，峰峰烟翠似双鬟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13642,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其五十二","author":"屈大均","text":"珊瑚挂镜未消愁，媚尔方营翡翠帱。\n香里奇南为屐齿，花中么凤作钗头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13643,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其五十三","author":"屈大均","text":"终日焚香礼彩云，云中不见旧仙居。\n画图悬在梅花洞，蛱蝶无情亦上裙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13644,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其五十四","author":"屈大均","text":"生时居尔珊瑚洲，为近麻姑二石楼。\n巫岫未开神女馆，罗浮先作淑人丘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13645,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其五十五","author":"屈大均","text":"白云何处望西凉，魂绕花田应更香。\n紫玉可能邀入冢，木兰不得送还乡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13646,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其五十六","author":"屈大均","text":"月明环佩莫踟躇，此地仙灵窟宅馀。\n太华休归毛女洞，罗浮且在鲍姑庐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13647,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其五十七","author":"屈大均","text":"岂有芙蓉得久妍，秦嘉针药累三年。\n三年词赋无多作，乐府惟歌妇病篇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13648,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其五十八","author":"屈大均","text":"令晖才藻已成尘，笑妾春风今不春。\n闺里兰开四五叶，题书谁复寄行人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13649,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其五十九","author":"屈大均","text":"早识佳人命不长，殷勤花底作鸳鸯。\n三年不肯如泥醉，恐致卿卿恼太常。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13650,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其六十","author":"屈大均","text":"万里相携庙见来，麻姑台作望乡台。\n红蕖结子心难遂，白鹄衔雌口不开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13651,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其六十一","author":"屈大均","text":"孤鸾舞绝镜中央，碧水丹山恨路长。\n天上岂无秦弄玉，人间那有杜兰香。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13652,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其六十二","author":"屈大均","text":"秋风吹叶满空闺，不见盘中苏氏妻。\n黄口小儿怜失乳，夜深犹向玉棺啼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13653,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其六十三","author":"屈大均","text":"左思杖策方招隐，林下风流失谢家。\n娇女有谁怜织素，小郎何处见青纱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13654,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其六十四","author":"屈大均","text":"万里从夫泪满巾，烟花不似故乡春。\n越人庄舄元思越，秦女罗敷自忆秦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13655,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其六十五","author":"屈大均","text":"情如孙楚难除服，愁似潘安日望坟。\n蒿里一朝生白发，榆林万里隔黄云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13656,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其六十六","author":"屈大均","text":"渐似中郎鬓有丝，将雏歌罢不胜悲。\n琴书定与他人去，门户终无健妇持。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13657,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其六十七","author":"屈大均","text":"夜夜灯前笑语同，梦回方觉玉床空。\n黄泉共友惟兰氏，白首相依失蕙丛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13658,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其六十八","author":"屈大均","text":"处处相随兰麝闻，中间分袂去从军。\n裴卿枉嫁浮云婿，张子虚寻仓海君。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13659,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其六十九","author":"屈大均","text":"小姑嬉戏怜初七，七日为人治酒浆。\n大嫂生辰逢此日，更将人胜媚新妆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13660,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其七十","author":"屈大均","text":"戴胜争誇王母降，点梅还道寿阳来。\n明年人日人何处，人日欢娱只一回。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13661,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其七十一","author":"屈大均","text":"白日魂交翠帐低，家人难唤梦中啼。\n英雄气为红妆尽，况复多才窦氏妻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13662,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其七十二","author":"屈大均","text":"西京诗句似朱弦，士会还工赠妇篇。\n纨扇白头卿最爱，玉琴弹出月明前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13663,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其七十三","author":"屈大均","text":"天生明月断人肠，今夜方知秋夜长。\n一照愁人生白发，风吹不去皎如霜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13664,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其七十四","author":"屈大均","text":"日暖琉璃研匣开，真书临罢上妆台。\n金钗不肯持沽酒，为购兰亭宋拓来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13665,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其七十五","author":"屈大均","text":"董生佣作致甘肥，天降神娥为秉机。\n今日高堂惭孝养，故乡烟雾独归飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13666,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其七十六","author":"屈大均","text":"自古来卿与女休，壮年能报父兄仇。\n功成俱上列仙籍，嗟尔今朝命不犹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13667,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其七十七","author":"屈大均","text":"稚女无人抱惠芳，秋来多病不扶床。\n可怜水火无能免，靧面桃花忆何娘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13668,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其七十八","author":"屈大均","text":"锦衾多泪雨同流，罗袂无声风自秋。\n纵有少翁能致汝，帷中那得玉魂留。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13669,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其七十九","author":"屈大均","text":"去时真似箭离弦，风过长河雨绝天。\n人命踟蹰曾不得，千秋遗恨素馨田。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13670,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其八十","author":"屈大均","text":"日出秦楼睡起迟，黄莺啼杀海棠枝。\n湘东未得持斑管，先取豪犀理鬓丝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13671,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其八十一","author":"屈大均","text":"年年生日好烟花，不用胡琴寄谢家。\n塞上疾驰千里雪，房中亲奉一流霞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13672,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其八十二","author":"屈大均","text":"七夕穿针事已非，家人不忍晒遗衣。\n年年一渡银河去，却羡双星相会希。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13673,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其八十三","author":"屈大均","text":"天花无蒂月无台，游戏人间更不回。\n多事许家丞相女，楼中捉得酒仙来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13674,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其八十四","author":"屈大均","text":"啼到无声血满枝，杜鹃何似客心悲。\n英雄自古原无主，不殉佳人欲殉谁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13675,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其八十五","author":"屈大均","text":"风雨连宵送海棠，空馀兰麝土生香。\n檀奴不忍看遗挂，叠损罗襦满一箱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13676,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其八十六","author":"屈大均","text":"天风吹散洞箫声，忆共莲花峰上行。\n青紫已无奇女气，芬芳空有玉姜名。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13677,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其八十七","author":"屈大均","text":"一片落花天上飞，茫茫春色去何归。\n三生石上因缘浅，不管情人泪满衣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13678,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其八十八","author":"屈大均","text":"不断莲枝不见丝，丝长无补断莲枝。\n他生愿作田田叶，捧尔芙蕖出水湄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13679,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其八十九","author":"屈大均","text":"自失鸳鸯百事慵，寻仙依旧向云峰。\n不因裘褐人相逐，吴市何须去赁舂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13680,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其九十","author":"屈大均","text":"双泪已如潮有信，一心还似柳多丝。\n那能学取蒙庄子，漠漠彭殇总不知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13681,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其九十一","author":"屈大均","text":"不学神仙为玉颜，蓬莱只在洞房间。\n而今既失鸾皇侣，纵得神仙亦是閒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13682,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其九十二","author":"屈大均","text":"杖剑西从紫塞游，偶因儿女觅封侯。\n可怜织锦秦川女，不待功成去十洲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13683,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其九十三","author":"屈大均","text":"甘蕉不实恨如何，秋雨萧萧叶上多。\n夜夜玉琴相伴宿，閒情不复着青娥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13684,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其九十四","author":"屈大均","text":"胡雁频从越鸟翔，情知水土畏炎方。\n红颜竟为而姑死，白首徒令阿母伤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13685,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其九十五","author":"屈大均","text":"狼藉珠钗与翠钿，红埃更满夜飞蝉。\n光浮玉臂犹馀泪，香冷金炉似有烟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13686,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其九十六","author":"屈大均","text":"研泪为书告佛陀，才多不忏忏情多。\n生天莫使为天女，八月休教作月娥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13687,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其九十七","author":"屈大均","text":"林泉相对只綦巾，笔墨凭君绣雒神。\n为爱狂夫诗句好，金珰平与刻书人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13688,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其九十八","author":"屈大均","text":"自折宜男与侍儿，苔痕犹有小香綦。\n殷勤拂去飞花片，想像凌波冉冉时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13689,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其九十九","author":"屈大均","text":"才人自古归厮养，亦有文姬毳幕中。\n吾子不须悲薄命，千秋芳誉孟光同。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13690,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭华姜一百首 其一○○","author":"屈大均","text":"松柏何须附女萝，思将白日醉中过。\n天教武子为情死，人是文通赋恨多。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13691,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其一","author":"屈大均","text":"芦荻将花雁未来，早秥初熟鸭船催。\n玄黄膏满三秋蟹，迎送咸潮向酒杯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13692,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其二","author":"屈大均","text":"禾未垂头正晾花，秋成望断海心沙。\n吾田远在茭塘曲，九日租船可到家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13693,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其三","author":"屈大均","text":"无端龙气起潖洲，捲去人家江上楼。\n幸未潮田败禾稼，秋分白露二秥收。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13694,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其四","author":"屈大均","text":"不向池塘把钓竿，白头人作老渔看。\n秋江岁岁同凫雁，随意芦花宿暮寒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13695,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其五","author":"屈大均","text":"多载香粳要换鱼，鱼多只恨绿尊虚。\n西江疍女多相识，白首扁舟似老渔。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13696,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其六","author":"屈大均","text":"家家榕树小塘西，雨过施罛妇子齐。\n素足不须怜浣女，天生莲藕在淤泥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13697,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其七","author":"屈大均","text":"粼粼非石亦非沙，天作涟漪水作霞。\n不畏江寒频濯足，中流羡杀白莲花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13698,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其八","author":"屈大均","text":"清江白石厌相看，葭菼风多已早寒。\n吹起涟漪身湿尽，不如滩上鹭鹚乾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13699,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其九","author":"屈大均","text":"无穷芳草是蘼芜，绿到天边不见夫。\n不是多情频化石，人归那识故人姝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13700,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其十","author":"屈大均","text":"牵路林中一线长，萦纡不断似回肠。\n并刀欲剪千千尺，不使征夫到瘴乡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13701,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其十一","author":"屈大均","text":"飞来古寺是耶非，何处归猿向此归。\n长啸至今烟雾隔，无情亦为一沾衣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13702,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其十二","author":"屈大均","text":"南国多情易别离，登高临水总相思。\n凄清越女吹芦管，绝似巴童唱竹枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13703,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其十三","author":"屈大均","text":"鹰吟松上起惊飙，蝉咽泉间似暮潮。\n萧瑟不须摇落候，悲秋有客是南朝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13704,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其十四","author":"屈大均","text":"波涛鼓舞乱峰回，出峡还愁入峡来。\n百十长篙争一石，香炉撑破断厓开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13705,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其十五","author":"屈大均","text":"不愁舟碎瞿唐石，爱触中流滟滪来。\n象马丛中穿一发，篙篙相接斗惊雷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13706,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其十六","author":"屈大均","text":"排空乱石阵图多，铁壁银山一折过。\n南越北门天设险，万人城在要人和。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13707,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其十七","author":"屈大均","text":"削竹千枝作缆枝，枝长枝短似游丝。\n年年百丈无穷路，牵断肝肠人不知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13708,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其十八","author":"屈大均","text":"水作青罗带百围，镜光晴浣白云肥。\n帆过未易秋痕合，雾縠风吹似卷衣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13709,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其十九","author":"屈大均","text":"何年剪碎万芙蓉，莲叶莲枝总作峰。\n壁断时时阙一峡，参差青嶂夹天重。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13710,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其二十","author":"屈大均","text":"烟霭苍苍暮几重，山云低接水云浓。\n乱峰回合成天井，片月无因出万松。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13711,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其二十一","author":"屈大均","text":"山围明镜易成圆，四壁松杉黯似烟。\n花缺依稀知峡口，片帆斜出断厓边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13712,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋日自广至韶江行有作 其二十二","author":"屈大均","text":"一峰不作一峰看，青翠瑶篸十万竿。\n多半髻螺盘叠叠，白云膏沐湿秋寒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13713,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]