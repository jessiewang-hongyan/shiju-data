[{"title":"儿明洪生日示之 其四","author":"屈大均","text":"苦汝因高节，饥寒更几时。\n敢求儿智慧，但望我耆颐。\n成立那能早，慈威亦未迟。\n十年吾杖国，看尔有孙枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10779,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"瓶花 其一","author":"屈大均","text":"瓶花吾与汝，相对一春多。\n白发今如此，夭桃奈若何。\n养须生水好，薰用熟香和。\n日夕壶觞里，狂夫但有歌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10780,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"瓶花 其二","author":"屈大均","text":"最是桃花口，偏多欲笑时。\n红颜吾解驻，白发汝休欺。\n玉女浆无尽，仙人禄在兹。\n玉壶留日月，长照岁寒姿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10781,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"手插梅枝得活喜赋","author":"屈大均","text":"绿萼和枝折，乘春插即生。\n水留元气在，土得上膏荣。\n造化非无本，东皇亦有情。\n他时根尽发，移上玉缸轻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10782,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"波罗江上作","author":"屈大均","text":"南海阳明谷，扶胥浩淼流。\n龙衔红日上，蜃作白云浮。\n十里莺花满，三春士女游。\n祝融兼水帝，祠庙在章丘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10783,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"攀枝花 其一","author":"屈大均","text":"朵朵天边发，烧云是木棉。\n丹楼开十二，玉女笑三千。\n瓣里巢红翠，须间吐紫烟。\n越王烽火树，多在祝融前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10784,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"攀枝花 其二","author":"屈大均","text":"朵朵争红日，枝枝作烛龙。\n炙天光尽煖，映水色还浓。\n不叶珊瑚似，全花彩翠封。\n年年春二月，先发海边峰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10785,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"攀枝花 其三","author":"屈大均","text":"枝枝将海日，吐纳在朝霞。\n自是炎天德，全钟大绛花。\n香薰南海帝，红映越人家。\n么凤纷无数，须边立不斜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10786,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"立春日送雁","author":"屈大均","text":"一声辞涨海，飞向雁门归。\n是日春盘会，因君启竹扉。\n相看人渐远，相忆字应稀。\n南国如今日，谁言塞上非。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10787,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"瓶中桃花","author":"屈大均","text":"暖令花大朵，一一向瓶开。\n笑入佳人镜，香浮上客杯。\n芳春殊未半，嫩叶莫相催。\n及此夭夭好，溪边更折来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10788,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"诃林雅集","author":"屈大均","text":"诃子虞翻树，阴含汉代青。\n千年无啸咏，一日且沉冥。\n花少因寒食，莺多为玉瓶。\n东风香浦至，解带挹清泠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10789,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送钱子目天 其一","author":"屈大均","text":"年来珠海客，如尔独难归。\n今此春将暮，方随雁北飞。\n狂歌元有道，名饮未为非。\n异日浮丘上，重游定不违。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10790,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送钱子目天 其二","author":"屈大均","text":"到手泥沙似，黄金不使留。\n珍禽市泷水，锦石买端州。\n持此娱三妇，兼之遣四愁。\n未知么凤子，可得一双不。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10791,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送钱子目天 其三","author":"屈大均","text":"春草能相送，依依直到家。\n无言江上柳，不及岭南花。\n户向山塘掩，行缘石路斜。\n殷勤人载酒，奇字与侯芭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10792,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠杜陵刘汉臣 其一","author":"屈大均","text":"老友年来尽，馀君是故人。\n心犹青岁壮，情似白头新。\n饥渴催为客，恩仇待许身。\n相逢休慷慨，且饮玉杯醇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10793,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠杜陵刘汉臣 其二","author":"屈大均","text":"蔡泽能知命，飞扬在暮年。\n卧龙须老大，跃马未屯邅。\n飘泊高堂外，艰虞白发前。\n无穷忠养事，十口总茫然。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10794,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠杜陵刘汉臣 其三","author":"屈大均","text":"布衣吾与汝，贫贱古人中。\n事去才偏老，身存道未穷。\n灯含杯影绿，袖隐剑光红。\n又作湘漓别，依依一转蓬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10795,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏古","author":"屈大均","text":"艰难垂钓日，一食困英雄。\n漂母哀何晚，王孙报欲穷。\n龙兴迟沛上，虎视正关中。\n市井无知己，徒高国士风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10796,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"杜鹃花","author":"屈大均","text":"子鹃魂所变，朵朵似燕支。\n血点留双瓣，啼痕渍万枝。\n开当寒食后，人正断肠时。\n望帝春心在，花含万古悲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10797,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春日沙亭作 其一","author":"屈大均","text":"梨叶春方落，无霜亦自红。\n移花教日到，疏竹使烟通。\n北洒过云雨，南吹作雾风。\n故人抱琴至，清响满墙东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10798,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春日沙亭作 其二","author":"屈大均","text":"雾重知天暖，今朝减一衣。\n雨应随湿至，风已送寒微。\n芳草愁将满，桃花恐遂稀。\n莺雏娇不语，似惜美人违。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10799,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"王将军府中牡丹盛开有赋 其一","author":"屈大均","text":"繇来南海上，未有雒阳花。\n植自将军手，频开朵朵霞。\n香教天早煖，红使露多华。\n越客争知得，春光出魏家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10800,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"王将军府中牡丹盛开有赋 其二","author":"屈大均","text":"花估持来远，兼金买几枝。\n露香多在蕊，酒晕更生姿。\n地暖重楼少，天晴淡粉滋。\n将军饶丽藻，最与紫芳宜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10801,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西洋郭丈赠我珊瑚笔架赋此答之 其一","author":"屈大均","text":"何年沉铁网，海底得枝枝。\n以此为钩好，偏于挂镜宜。\n亲劳如意击，重向玉台贻。\n才愧徐陵甚，难为架笔时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10802,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西洋郭丈赠我珊瑚笔架赋此答之 其二","author":"屈大均","text":"分来烽火柏，持作笔床先。\n小架宜斑管，长书得锦笺。\n归凭纤手润，益使大红鲜。\n未有琼瑶报，殷勤奏短篇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10803,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭侍妾梁氏文姞 其一","author":"屈大均","text":"十六归吾室，兰云覆额初。\n王家桃叶似，石氏懊侬如。\n未老铅笔洗，长贫笔墨疏。\n芳春三十四，花落委庭除。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10804,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭侍妾梁氏文姞 其二","author":"屈大均","text":"忍弃双儿去，匆匆赴夜台。\n死亡多口谶，斋戒早心灰。\n玉化紫烟气，珠倾明月胎。\n事予空二九，朝露苦相催。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10805,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭侍妾梁氏文姞 其三","author":"屈大均","text":"稚儿初咽哺，无母与肥腥。\n断乳才三夕，扶床始四龄。\n无穷哀子日，有尽老人星。\n风雨衾裯冷，凄凄想淑灵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10806,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭侍妾梁氏文姞 其四","author":"屈大均","text":"离家未十朝，蕙草汝频凋。\n不及黄泉送，空期紫玉邀。\n医来无术救，巫至只魂招。\n针药平生少，桃花致早夭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10807,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭侍妾梁氏文姞 其五","author":"屈大均","text":"美目应难瞑，无依膝下儿。\n茫茫成立日，落落贱贫时。\n苦节劳妻子，多才致渴饥。\n腹中无限泪，滴尽不曾知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10808,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭侍妾梁氏文姞 其六","author":"屈大均","text":"失时伤汝极，多日中风深。\n香好魂难返，情多魄恐沉。\n儿痴啼欲抱，姑老哭无音。\n湿尽其君袂，朝昏泪不禁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10809,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭侍妾梁氏文姞 其七","author":"屈大均","text":"殷勤汤药事，两抱女君哀。\n亦复归蒿里，无缘逐老莱。\n三人无百岁，一穴作双台。\n左右分黄土，连阴待种梅。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10810,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭侍妾梁氏文姞 其八","author":"屈大均","text":"怪鸟啼三夕，声声入曲房。\n非祥吾早识，薄命汝偏当。\n忽绝青琴响，频埋碧玉光。\n免怀双稚子，犹自唤姨娘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10811,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭侍妾梁氏文姞 其九","author":"屈大均","text":"好色平生累，情深可奈何。\n老知偕老少，愁为莫愁多。\n肉割劳方朔，丹成失鲍娥。\n仙人难旷达，哀乐损天和。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10812,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭侍妾梁氏文姞 其十","author":"屈大均","text":"白杨风叶下，三度送红颜。\n涕泪惭如水，恩情悔似山。\n空多闺阁累，未有啸歌閒。\n哀痛平生足，吞声返竹关。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10813,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送刘生之金陵就昏 其一","author":"屈大均","text":"少年频首路，江左问乡园。\n廉吏难为子，忠臣易有孙。\n礼方恙雁执，诗有兔丝言。\n自此孤生竹，依依泰岱尊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10814,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送刘生之金陵就昏 其二","author":"屈大均","text":"此去非为客，枌榆是故都。\n婿怜齐赘好，儿念羽林孤。\n烈祖丹书在，先人素业无。\n鸡鸣思大母，回首白头乌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10815,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送刘生之金陵就昏 其三","author":"屈大均","text":"外舅吾知己，殷勤为致书。\n地非三楚旧，人是六朝馀。\n散带难云卧，牵船已岸居。\n不知徐庾笔，奇丽复何如。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10816,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠汪少府","author":"屈大均","text":"三年劳佐郡，每得接清芬。\n不欲石门水，何殊铜柱勋。\n仙人能有政，令子复飞文。\n千里趋庭日，英才莫不闻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10817,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"大司马吴公惠田赋此奉答 其一","author":"屈大均","text":"公怜乌有母，发满白头霜。\n有耻归薇蕨，无才致稻粱。\n文章徒卖力，舂杵枉辞乡。\n十亩承嘉惠，从今菽水香。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10818,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"大司马吴公惠田赋此奉答 其二","author":"屈大均","text":"繇来仁者粟，方与养亲宜。\n更受山田赐，弥惭石父知。\n自今为黍早，不惜采兰迟。\n勤动同妻子，长怀粒我私。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10819,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送吴四会之任汉州 其一","author":"屈大均","text":"绥州君不爱，却爱汉州遥。\n忍舍南津水，东西接海潮。\n香寒柑子户，翠湿木棉桥。\n父老长瞻望，双旌拂大峣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10820,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送吴四会之任汉州 其二","author":"屈大均","text":"此去蚕丛路，无穷是杜鹃。\n锦官双水外，白帝万山前。\n司马辞章美，文翁教授贤。\n政成知不久，飞舄紫薇边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10821,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送李孝廉道过萍乡访邑令尚使君","author":"屈大均","text":"何处能为政，萍乡有一人。\n君闻玉琴响，复见桃花春。\n德化连南楚，声华动北辰。\n讼庭无所有，山色九峰新。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10822,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送英德陆明府","author":"屈大均","text":"繇来太白老，秋浦最相知。\n山水如英德，风流似昔时。\n梧桐乃遗爱，杨柳是将离。\n子弟多为寿，云州有所思。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10823,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠某湖州","author":"屈大均","text":"昔作菰城守，情同杜紫薇。\n女怜红泪湿，人得紫云归。\n江总前身是，扬州旧梦非。\n九贤堂上客，觞咏日依依。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10824,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寿张母","author":"屈大均","text":"令子青云早，翱翔尉北堂。\n不因熊胆苦，争得凤毛长。\n秬黍三春酒，梅花十月觞。\n诗人歌寿母，风雅有馀香。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10825,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠某广文","author":"屈大均","text":"已谢师儒事，殷勤尚在公。\n东山棋局外，北海酒尊中。\n白发虽难老，黄芝亦养蒙。\n贤劳谁得似，日事尉佗宫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10826,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠新州区丈","author":"屈大均","text":"新州廿四峰，君得几芙蓉。\n老去杯休放，春来酒贵浓。\n暖烟长在药，炎雪不知松。\n日夕芝华里，微吟入暮钟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10827,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题张丈香隐园","author":"屈大均","text":"炎海多香物，无如荔子香。\n丈人亲种者，可有素馨囊。\n花酿三春酒，溪流几处觞。\n明年过夏至，待我读书床。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10828,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题真公坐石小影","author":"屈大均","text":"似兹盘石好，何不昼眠来。\n岂为白云冷，兼之多古苔。\n坐当孤月上，心与一花开。\n谁与共禅寂，清猿夜夜哀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10829,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"从友人索取柑子","author":"屈大均","text":"君自绥州至，应多柑子黄。\n玉盘堆更满，纤手臂偏香。\n喷客多含雾，甜人已饱霜。\n就中鱼冻者，分我一笼尝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10830,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送黄太史 其一","author":"屈大均","text":"今代文章伯，娄东有一人。\n身犹金马贵，书已玉杯醇。\n拥节过南海，乘轺下北辰。\n相逢语经术，一一是先秦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10831,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送黄太史 其二","author":"屈大均","text":"稷下诸儒在，苟卿最老师。\n斯文无菽粟，吾道望耘耔。\n酌酒临香浦，安花在接䍦。\n琴中有先哲，相见抚弦时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10832,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送黄太史 其三","author":"屈大均","text":"黔中为使日，风俗记诸苗。\n负弩相如泰，浮槎博望遥。\n文能助干羽，诗欲佐箫韶。\n驷牡经全楚，蛮花处处邀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10833,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送黄太史 其四","author":"屈大均","text":"汉代黄香在，无双是五经。\n多文留海岳，有道在朝廷。\n别袂牵长水，归帆拂翠屏。\n他时东阁启，应念一飘萍。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10834,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送黄太史 其五","author":"屈大均","text":"老我惟周易，玄亭在日南。\n无人问杨氏，夫子即桓谭。\n天地心相契，羲皇梦正酣。\n京花见知己，为道雪毵毵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10835,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"悼梁氏文姞 其一","author":"屈大均","text":"二八归予好，夭桃性早华。\n尚悬明镜月，未叠锦衾霞。\n在褓双雏小，当檐一垒斜。\n啾啾谁哺汝，毛羽渐纷葩。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10836,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"悼梁氏文姞 其二","author":"屈大均","text":"化为烟与雾，梦里日氤氲。\n烛已花间灭，琴犹月下闻。\n魂应哀鞠子，影定绕慈君。\n父息情无极，悲啼向一坟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10837,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"悼梁氏文姞 其三","author":"屈大均","text":"顾复无常母，孤儿最可怜。\n扶床方四岁，饮乳未三年。\n日日黄肠侧，双双白首边。\n一秋情抱恶，无曲与冰弦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10838,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"悼梁氏文姞 其四","author":"屈大均","text":"少小青春日，行行细马驮。\n随夫冲雨雪，抱子涉风波。\n色以餐桃好，情于割肉多。\n悔予长搦管，未暇画双蛾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10839,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"人日追哭孟王","author":"屈大均","text":"年年人胜节，忆汝罢衔觞。\n泪向生前尽，情于死后长。\n镜留秦地月，衣灭汉宫香。\n屈指从庚戌，悲思十八霜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10840,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"丁卯初春作 其一","author":"屈大均","text":"一冬因太暖，酿得一春寒。\n坐恨花多湿，行愁叶不乾。\n阴从人日甚，雨到上元残。\n已是无情绪，莺声更不欢。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10841,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"丁卯初春作 其二","author":"屈大均","text":"细雨从开岁，濛濛已浃旬。\n那知垂老日，尚作苦寒人。\n烟火吾方冷，莺花尔莫春。\n柳条长复短，牵恨过东邻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10842,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"丁卯初春作 其三","author":"屈大均","text":"天含春气湿，似泪未成流。\n人去空留恨，莺来即唤愁。\n已青黄木浦，未绿白蘋洲。\n莫更吹花雪，茫茫使白头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10843,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"丁卯初春作 其四","author":"屈大均","text":"平生明镜里，未有一愁心。\n老去方多恨，春来欲废吟。\n莺须怜梦好，花莫笑情深。\n一夕生离泪，无端在锦衾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":10844,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]