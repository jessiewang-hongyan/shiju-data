[{"title":"题徐大临湖乡小景","author":"张大受","text":"鸟背岚光过夕汀，碎萍鱼唼水花腥。\n青山一角湖三面，记是塘西乙未亭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15223,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"山居","author":"张大受","text":"爱看支硎一角山，何妨身卧薜萝间。\n峰头片片秋云白，不碍虚亭鹤往还。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15224,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"清流道中梅花","author":"张大受","text":"驻马清流香气吹，东风渐近落花时。\n可怜踯躅关山路，才见江南第一枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15225,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梅花驿","author":"顾彩","text":"马迹车尘暗陌头，遥看古驿入南州。\n渡河芳草王孙去，过岭梅花使者愁。\n五夜泊船江店火，万山吹角戍人楼。\n可怜丝管长亭别，欲折垂杨不自由。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15226,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋霖","author":"汪洋","text":"君不见千村白水沟塍合，阴雨兼旬云百匝。\n禾沉水底不得收，腐烂只堪饱鹅鸭。\n书生空有恤民心，无路排云叫阊阖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15227,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阎陈二公祠","author":"汪洋","text":"奉职同时尉海滨，微官誓死各捐身。\n原知苦战违天意，甘守危城识大伦。\n南国比肩双烈士，雎阳合节两忠臣。\n百年论定还祠庙，愧尔军前纳款人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15228,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"望盘山","author":"高承埏","text":"中盘云气下盘生，紫盖峰高晚独晴。\n愿得他时解尘组，白松树底饭黄精。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15229,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"晨晦","author":"方维仪","text":"终朝无所见，茫茫烟雾侵。\n白日不相照，何况他人心。\n枯梅依古壁，寒鸟度高岑。\n静坐孤窗中，幽响成哀吟。\n春水一已平，杨柳一已深。\n故物无遗迹，萧条风入林。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15230,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"夏日偶成","author":"黄幼藻","text":"深院尘消散午炎，篆烟如梦昼淹淹。\n轻风似与荷花约，为送香来自卷帘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15231,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"武陵秋景","author":"黄幼藻","text":"湖上芙蓉近小舟，晓来清泪对花流。\n吴州客自伤长夜，不为西风怨早秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15232,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋夜忆家","author":"项兰贞","text":"一夕秋风至，天空雁忽来。\n露漙阶下草，月落掌中杯。\n故国书难到，他乡客未回。\n坐怜砧杵急，寒柝又相催。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15233,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄慰寒山赵夫人","author":"项兰贞","text":"落叶惊秋早，断鸿天际闻。\n遥思鹿门侣，愁看岭头云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15234,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"步月 其一","author":"项兰贞","text":"步月下庭除，萤飞花影侧。\n露下不知寒，鸣蛩动秋色。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15235,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"步月 其二","author":"项兰贞","text":"步月下庭除，青苔印鞋湿。\n行吟月转西，觅句还独立。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15236,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋夜","author":"项兰贞","text":"静夜砧初动，凉风雨乍收。\n一钩新月上，应照故园楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15237,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟中晚眺得青字","author":"项兰贞","text":"片帆天际阔，落日远山青。\n隐隐风前笛，行人不忍听。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15238,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"柳枝词","author":"项兰贞","text":"绿树阴阴映酒旗，欲牵春色上柔枝。\n年年为惜征夫别，折尽东风总不知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15239,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭宛君姑叶安人 其一","author":"李玉照","text":"三年空望剡溪船，惆怅儿家宕子缘。\n却似蓬山风引去，不教凡质近神仙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15240,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭宛君姑叶安人 其二","author":"李玉照","text":"想像丰姿欲见难，春风容易妒花残。\n焚香手把遗编读，百遍长吁斗鸭栏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15241,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"闺情绝句 其一","author":"沙宛在","text":"白燕双双入幕频，梨花香遍雪为茵。\n夜来纵有游仙梦，不作乌衣国里人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15242,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"闺情绝句 其二","author":"沙宛在","text":"瓜果初陈月殿高，双星今夜会云曹。\n笑来好事惟乾鹊，甘为他人髡顶毛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15243,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"闺情绝句 其三","author":"沙宛在","text":"小至时欣云气祥，玉阶渐见管灰扬。\n不知边塞征人妇，可有闲情验线长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15244,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"闺情绝句 其四","author":"沙宛在","text":"朝来报道牡丹开，拚取红纱护锦堆。\n痴蝶贪香寻不得，绕儿衣袂百千回。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15245,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"闺情绝句 其五","author":"沙宛在","text":"从来月蚀最愁予，绣佛龛前诵佛书。\n凡世不知天上事，嫦娥意念更何如。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15246,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"千秋岁 次韵赠王君丹麓","author":"钱肃润","text":"星移物换，百岁过将半。\n人世事，沧桑变。\n功名屠狗易，词赋雕虫贱。\n闲看取，浮云天际频舒卷。\n正喜逢清宴，菊蕊开零乱。\n堪娱乐，休悲叹。\n本无骑鹤想，且适持螯愿。\n须信道，人生若梦无非幻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15247,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"画堂春 上巳薛圜辅斋中社集，即景用秦少游原韵","author":"钱肃润","text":"千丝万绿柳梢长，朱廉掩映斜阳。\n花须蜂恋蝶含香。\n点缀新妆。\n争耐封姨少女，浪吹竹泪飘湘。\n春光黯淡问衣裳。\n好费商量。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15248,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"踏莎行 广陵桑楚孰斋中同杜茶村、邓孝威、宗鹤问赭子咏杏，和秦少游原韵","author":"钱肃润","text":"隋苑迷楼，曲江问渡。\n芜城景色今何处？\n路人遥指杏林来，春光点染还非暮。\n携手联翩，此心如素。\n封花啸味觞无数。\n忽然齐唱踏莎行，依依耐可花间去。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15249,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"小重山 咏徐用王斋中灵壁石","author":"钱肃润","text":"是处飞来又一峰。\n何人雕琢就？\n夺天工。\n四时风雨气空濛。\n砚屏侧，疑欲起蛟龙。\n蓄石傲坡翁。\n仇池虽有色，响难同。\n南州孺子乐其中。\n不须拜，好友愿相从。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15250,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"渔家傲 雨窗同杜茶村即席奉赠，用范文正公韵","author":"钱肃润","text":"举目山河曾否异，风狂雨骤夫何意？\n报道卧龙眠欲起。\n深泽裹，若逢三顾门毋闭。\n家在隆中相近里，石头一望无归计。\n终夜唤天还蹋地。\n浑不寐，直须信到方收泪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15251,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"满江红 戴耘野高士六十初度寄赠","author":"钱肃润","text":"聚散无常，忆当日、同行携手。\n遇知己、探梅寻菊，赋诗饮酒。\n风月江山都是主，鱼虾麇鹿呼为友。\n共陶然、朝夕任逍遥，今何有？\n我碌碌，风尘走。\n君寂寂，书帷守。\n报初周花甲，中秋时候。\n翠色方铺寒府内，紫霞正设同亭右。\n问素娥十辈驾鸾来，相逢否？","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15252,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"满江红 题金治文秋林诗思图，和陈伯驺韵","author":"钱肃润","text":"秋水盈盈，几回望、海流川曲。\n谁道是、臣之居也，非舟非屋？\n之子在焉呼不出，人遐尚喜音毋玉。\n待书成、万卷映缥缃，登芸局。\n何必种，王猷竹？\n何必采，陶潜菊？\n但枫林欇欇，声和琴筑。\n醉后厌寻槐穴蚁，梦来懒覆蕉湟鹿。\n任悠游，永日以忘年，唯君独。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15253,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"满江红  题江上外史小影赠荆默庵，时默庵为江阴学博","author":"钱肃润","text":"浩浩洪流，到今日、波恬浪息。\n看一带、云烟黯淡，翠峰屏立。\n渔艇凫舟浮水面，鸥汀鹤渚群飞出。\n坐江头、把卷独长吟，情脉脉。\n貌严重，神飘逸。\n气沉雄，才宏硕。\n本玉皇香吏，金銮仙籍。\n暂向江于称外史，品题山水无谀笔。\n论人物、上下几千年，延陵一。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15254,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"满江红·题徐用王躬耕图，和余广霞韵，是岁值大水","author":"钱肃润","text":"拍浪天浮，柴门外、江涛新涨。\n经水道、平添数尺，幸而无恙。\n荷锸也须耕月下，带经却惯锄云上。\n看载筐、及筥自南来，伊谁饷？\n瞻绿野，清波漾。\n樵父泣，渔翁唱。\n羡庞妻作黍，陶公成酿。\n曳索有时还著屩，挂钱无事将携杖。\n问徐孺、稼穑近如何？\n图难状。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15255,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"松风萝·王丹麓有书怀词，索和却赠","author":"钱肃润","text":"当醉欲眠，遇饥求食，随缘最是便宜。\n羡尔高人无系，悠悠将任其之。\n咫尺西湖，看白苏堤上，雨过红肥。\n松风一卧，不位蚁梦，定是柯棋。\n觉后茫然有失，惟闻鹤怨猿啼，急起披衣。\n接洞箫舒啸，断送嗔痴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15256,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜迁莺 和陆尽思四十初度，原韵奉赠","author":"钱肃润","text":"风尘驰逐，叹时物迁移，新红故绿。\n过隙如驹，流光似电，那晓醉多醒独。\n达人自能忘世，守己居然为谷。\n报初度，正青阳方转，岂因年蹙？\n迈轴，羡我友独寤寐，言不受北山辱。\n诗就长吟，兴来清啸，却喜林间多竹。\n鸿渐杜门茶饮，鲁望乘舟书束。\n趋良会，好追芳前哲，逍遥云麓。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15257,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜迁莺 题荆溪小隐图，赠林天友别驾","author":"钱肃润","text":"荆南山麓，看烟树苍茫，层楼叠屋。\n中有高人，呼之不出，共说其人如玉。\n阳羡茶真可爱，九里水原非浊。\n暂栖住，任逍遥容与，为盘为谷。\n不俗，算自昔宦隐名流，争向溪边宿。\n杜榭犹存，任台在望，山为苏公称蜀。\n君复结庐到此，恰尔追芳齐躅。\n是图也，置五云罨画，平添一幅。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15258,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"念奴娇 送陈其年归荆溪","author":"钱肃润","text":"君才如此，是天生人物，从来希有。\n屈宋于今成鼎立，子建平分八斗。\n疋马燕台，联镳菟苑，赋出争傅口。\n乌丝新调，傲他秦七黄九。\n忆昔意气拿云，文章腾焰，直唾功名手。\n此日雄心犹肮脏，每对青天搔首。\n俄上龙山，寻过鸿水，访我烟霞友。\n来朝归去，且倾今夜杯酒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15259,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"念奴娇·戏为九龙与九烟问答词，时黄九烟有九峰舆十峰相谑词见赠","author":"钱肃润","text":"吾侪龙种，任峰头个个，腾云兴雾。\n顷刻飞烟成九点，好似星罗棋布。\n公亦犹人，安能多口，喷出烟无数。\n摅词掞藻，恐徒然拾馀唾。\n公乃大笑而言，神龙无首，岂若君浮露？\n五岳层层方寸起，笔底千山奔赴。\n为雨为云，霎时骤至，惹得天公怒。\n九峰众服，从今愿结心素。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15260,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"百字令 赠黄珍百，时珍百为安仁令归","author":"钱肃润","text":"近来彭泽，赋田园归去，陶然身逸。\n百本沅兰当五柳，兴到吟诗摇笔。\n二仲寻盟，三高作伴，山水之间出。\n天然性癖，不堪岂为多虱？\n曾记结缟家乡，联镳京里，异地情偏密。\n阳羡风光君占取，招得九龙人一。\n玉女潭遥。\n张公洞窈，何处堪容膝？\n松涛声彻，可能假我仙术。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15261,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"百字令·赠徐竹逸","author":"钱肃润","text":"金銮仙品，叹遭逢不偶，竹溪同逸。\n兴到淋漓挥翰墨，急起临泉浣笔。\n寄傲琴书，陶情山水，风雨何妨出？\n飘翩尘外，笑时人处裈虱。\n闻说游宦滇南，碧鸡金马，峰嶂何冥密。\n携取烟岚归正好，掩映荆南如一。\n水榭风清，琴台云绕，在在堪容膝。\n茶香樱熟，不须海上芝术。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15262,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"百字令·和史蘧庵太史见赠原韵","author":"钱肃润","text":"孤踪清节，任高飞遐举，龙潜云逸。\n国破家亡何所有？\n剩得董南真笔。\n大义君臣，同心兄弟，忠孝由中出。\n逍遥尘外，叹时人似沙虱。\n何必天子书门，有司供直，始可称华密。\n闻说荆溪风土厚，好借城边廛一。\n老妪情亲，东坡住稳，终日吟摇膝。\n俄傅唐贡，产茶更产芝术。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15263,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"百字令·赠曾青藜诞日，和杜茶村韵","author":"钱肃润","text":"频年作客，记长安花市，灯楼常共。\n自过兰陵悬百里，但听鸟鸣莺哢。\n嵇吕相思，张高迷路，做得寻朋梦。\n朝来至止，衔杯为尔情重。\n正是月贯精阳，节逢天贶，天上红云动。\n报道麒麟生此日，孔氏元来亲送。\n沂水清风，嘉祥正派，流向江西纵。\n傅家画省，到今应有池凤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15264,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"百字令·祝徐学士母亲太夫人寿","author":"钱肃润","text":"玉峰葱翠，看涓涓秀气，回环东海。\n虎跃龙骧众说道，徐氏门庭踵起。\n兄弟同朝，三人学士，鼎鼎何其美。\n高堂有母，教成时至于此。\n昔年迎到京畿，崔邠亲导，乐也荣无似。\n今日潘安舆复御，好向家园周视。\n或泛西湖，还游天竺，一子常依矣。\n五云多处，望南山更光彩。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15265,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"沁园春 题丁药园采芝图","author":"钱肃润","text":"我见丁君，太白东坡，疑其后身。\n奈花笺甫赐，空承主眷，金莲方照，徒叹卿文。\n儋耳苍茫，夜郎惨淡，万里归来故国春。\n那堪羡，羡吴山越水，做散仙人。\n一朝厌弃风尘，向何处桃源去问津？\n念高车驷马，其忧甚大，幽林邃谷，此乐为真。\n采者芝舆，绮园安在？\n共说皤皤入漠廷。\n君行矣，恐图形徵访，正具蒲轮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15266,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"沁园春·题袁重其负母看花图，和纪伯紫韵","author":"钱肃润","text":"循彼南陔，厥草油油，北堂在前。\n睹穿帘舞燕，楼檐宿鸟；夕来朝去，娱悦高年。\n陆绩思亲，仲由孝养，橘可怀兮米负肩。\n真堪羡，喜慈颜如旧，儿鬓初斑。\n婆娑地上金仙，看膝下蹁跹乐事全。\n正熏风池馆，端阳佳节；葵榴满放，杨柳三眠。\n绢拂鹅溪，笔推龙爽，点染韶光景更妍。\n留题遍，想莱衣戏彩，旷世同传。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15267,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"惜馀春慢·和徐竹逸花溪即事韵却赠","author":"钱肃润","text":"乘兴寻芳，晴丝不断，忘却春光将老。\n争传茂苑，花事澜翻，怎耐一天风扫？\n齐女门前有园，白白红红，不知多少。\n更轻盈杨柳，绿阴深处，暗藏苏小。\n入门后，亭阁参差，游人稠沓，总向花溪喧闹。\n幼舆独坐，丘壑增妍，燕语莺声俱好。\n整日挥毫赋诗，把酒论文，二三年少。\n取阳春曲送春归，春色依依回绕。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15268,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞庭春色 送华吏部凰超公入华孝子祠","author":"钱肃润","text":"我过堂前，一翁危坐，凛若明神。\n看头颅如雪，居然总角；丰容柔娈，未琢天真。\n俄报一翁堂下至，俨肃肃，峨冠博带身。\n群相羡，是先朝故老，当代完人。\n溯源厥惟曰孝，孝子后更有忠臣。\n叹发肤顶踵，皆君之赐：全归全受，且慰吾亲。\n国破君亡何所有？\n留一发，聊将挽万钧。\n那知后日，祠坛配祀，俎豆莘莘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15269,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"满庭芳 送汤中丞潜庵公入东林道南祠","author":"钱肃润","text":"旧院东林，沧桑陵谷，翻云覆雨方晴。\n一朝营造，救度也耎薨。\n丽泽规模整肃，祠堂内、丹艧梁楹。\n惊相告、俄傅檄至，不日报功成。\n丙寅，夏四月，中丞北上，迫趣王程。\n过林间停辙，讲道杨亭。\n今岁戊辰春日，云旗风马忽来迎。\n到门后，龟山降席，促膝话平生。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15270,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"水调歌头 秋夜怀陆荩思司铎束瓯，用苏东坡原韵","author":"钱肃润","text":"华盖山高矣，渺若洞中天。\n容成曾许相见，会面在何年？\n我欲乘风访道，只恐丹台石室，炉灶已灰寒。\n此日空惆恨，盼望斗牛间。\n谢巘上，春草梦，白云眠。\n临流一镜，笑看池水璧同圆。\n时有春秋冬夏，教有诗书弦诵，乐事总称全。\n今夜江心里，月色正娟娟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15271,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 戏友","author":"万树","text":"鱼子兰香小露滋。\n起来移近绣帘丝。\n嫩黄初剪两三枝。\n唤得雪儿教捧去，葵花小合豆青瓷。\n谢娘刚好晓妆时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15272,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 夜景","author":"万树","text":"浴起新围宝袜轻。\n乌栖人静夜无声。\n手携金鸭下阶行。\n榆荚柔风薰佩带，桐花斜月晒帘旌。\n谁人遣比此时情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15273,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"清平乐","author":"万树","text":"凭栏不语，坐看春归去。\n或者留春留得住，因甚全无一句。\n曾闻百舌间关，要将春色遮拦。\n百舌舌儿先倦，愁人更有何言。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15274,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"杨柳枝二首 其一","author":"万树","text":"不合临池起画楼。\n断烟疏雨叶飕飕。\n谁能数得垂杨叶，一叶垂杨一点愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15275,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"杨柳枝二首 其二","author":"万树","text":"桂楫兰舟载玉箫。\n秦淮月冷夜迢迢。\n白门朱桁无穷树，唯有垂杨是六朝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15276,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长相思 夜行吴江道中","author":"万树","text":"苏州城，秀州城。\n鸭觜船儿月样轻，往来多月明。\n一条浜，两条浜。\n夜半歌声逐橹声。\n客愁无数生。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15277,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇 愁来","author":"万树","text":"天为清明，几番排当梨花雨。\n小楼风遽，麾散黄鹂语。\n中酒心情，欲遣偏无句。\n愁来处，可堪人去，帆带吴天絮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15278,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浪淘沙 落花","author":"万树","text":"春色过清明，花事飘零。\n夜来风雨葬倾城。\n枕上泪流还似雨，忒煞多情。\n晓起卷帘旌。\n撩乱红英。\n满街听得卖花声。\n我已伤心听不得，况是黄莺。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15279,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]