[{"title":"韩公桥歌","author":"陈子升","text":"船系连环石两头，一头盐饷接官邮。\n一头刺史登临处，清镜寒潭映北流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5288,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"铁马","author":"陈子升","text":"紫燕桃花舞并旋，高台轻骨响连钱。\n人间不少关山恨，绝迹依风也可怜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5289,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自五羊至河源得二十绝句 其一","author":"陈子升","text":"帐借江风盖借云，离情倚剑帖龙文。\n楼船更倩戈船护，初学乘槎谒圣君。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5290,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自五羊至河源得二十绝句 其二","author":"陈子升","text":"行李参差两路尘，行人行矣送归人。\n风前尽醉林婆酒，白鹤晴峰无那春。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5291,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自五羊至河源得二十绝句 其三","author":"陈子升","text":"木棉临水烂红霞，躞蹀何之白鼻騧。\n傍岸每嗔童子上，插瓶渠为采山茶。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5292,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自五羊至河源得二十绝句 其四","author":"陈子升","text":"抹额成群锦缆牵，分明旗号亦喧阗。\n带牛佩犊非儿戏，待辟吾皇九有田。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5293,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自五羊至河源得二十绝句 其五","author":"陈子升","text":"带马春沙暂牧场，今朝春水没中央。\n水接房星天上厩，分明匹匹肖鸳鸯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5294,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自五羊至河源得二十绝句 其六","author":"陈子升","text":"烟起山坳有竹庐，篷窗一半对风虚。\n青衣急走奚奴马，红嘴深窥翡翠鱼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5295,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自五羊至河源得二十绝句 其七","author":"陈子升","text":"围山周匝倚高墩，多少经营近水村。\n世乱深居寻不得，那知山顶是桃源。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5296,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自五羊至河源得二十绝句 其八","author":"陈子升","text":"不见人家冷却春，青松山上立如人。\n招来试语神仙事，背指桑田拂袖尘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5297,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"瓶梅","author":"陈子升","text":"何郎徙倚不成诗，却月凌风折一枝。\n好比禅心共清净，澹然冰雪供军持。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5298,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"自先上人偶以诃林绿瓦作枕予亦效之","author":"陈子升","text":"曾从浩劫忆萧梁，瓴甋休誇汉未央。\n试为阇黎留一枕，迦陵身倚绿鸳鸯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5299,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"潘菶伯善弹琵琶比且废置聊此戏之","author":"陈子升","text":"回窗无语堕风花，玉匣纤尘闭月华。\n已识琵琶流怨久，何须今日怨琵琶。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5300,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"山中七夕","author":"陈子升","text":"不知天阙复山庭，欲近银河鹊驾停。\n几处离忧逢七夕，孤臣不寐看双星。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5301,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"七夕寄容舍人","author":"陈子升","text":"青山秋澹月初明，羽服临风望玉京。\n乌鹊桥前今夕酒，凤凰池上故人情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5302,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秦淮曲","author":"陈子升","text":"十二楼昏千斛醪，梦中和语拨檀槽。\n秦淮一夕秋风起，百尺帆樯海气高。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5303,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"素馨花","author":"陈子升","text":"宴罢红云拥素馨，紫宫回梦酒初醒。\n香风皎月横陈处，不许诸嫔出后屏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5304,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题自公房","author":"陈子升","text":"尚白只今成白法，披缁从不染缁尘。\n何须四百八十寺，始作东西南北人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5305,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"闻雁","author":"陈子升","text":"雁翅城南南雁声，朔风无尽夜凄清。\n悬知万里阙河黑，欲下方塘一片明。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5306,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送人","author":"陈子升","text":"庄蹻滇南路不迷，相如拥传汉宫西。\n而今帝业驱铜马，莫遣儒生辨碧鸡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5307,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄无可上人","author":"陈子升","text":"疏烟不断远钟鸣，枫叶殷红江水清。\n试望江南秋色里，一僧挥麈石头城。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5308,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题故园龙眼树","author":"陈子升","text":"故园龙眼实初垂，三径荒芜鸟雀欺。\n借问交亲情几许，风前消息荔奴知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5309,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送屈修古游闽中","author":"陈子升","text":"八闽一半海侵城，万里波涛一叶轻。\n边塞中原今莫问，鹧鸪声里送君行。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5310,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄周四 其一","author":"陈子升","text":"闽越烟波未阻修，春宫歌舞倚钩辀。\n遥知高宴鹏山上，笑问仙城旧贵游。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5311,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄周四 其二","author":"陈子升","text":"早将词赋答雄风，贵戚元推第一功。\n遍操南音新顾曲，周郎何必在吴中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5312,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送谭说剑","author":"陈子升","text":"也为无车出每迟，蒯缑何处合雄雌。\n闽中公子深相忆，珠履行行蹑武夷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5313,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"客馆呈主人 其一","author":"陈子升","text":"五亩方塘一亩宫，满林花叶笑飘蓬。\n何当归作灞陵隐，感激裁书报伯通。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5314,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"客馆呈主人 其二","author":"陈子升","text":"王粲当年托景升，登楼犹自意难胜。\n莫教邺下留清宴，月照秦川一水澄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5315,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题中洲水楼","author":"陈子升","text":"高楼矗矗起方塘，跨作飞桥宛转长。\n虽有荆州楼可赋，秦川元是仲宣乡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5316,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舍侄买驴因戏之","author":"陈子升","text":"犹子移家策蹇驴，定穿山径入街衢。\n悬知日日逢京兆，可得诗如贾岛无。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5317,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"晓题楼上","author":"陈子升","text":"年来踪迹太东西，归卧高楼思转悽。\n睡醒五更闻百舌，朝朝都在一枝啼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5318,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"戏画并题","author":"陈子升","text":"碧涧深深一线天，薜萝空冷石根悬。\n老僧独在涧中过，不识往来何处禅。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5319,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"昆腔绝句 其一","author":"陈子升","text":"九节琅玕作洞箫，九宫腔板阿侬调。\n千人石上听秋月，万斛愁心也总销。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5320,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"昆腔绝句 其二","author":"陈子升","text":"苏州字眼唱昆腔，任是他州总要降。\n含著幽兰辞未吐，不知香艳发珠江。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5321,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"昆腔绝句 其三","author":"陈子升","text":"青藤玉茗浪填词，馀子纷纷俚且卑。\n我爱吴侬号荀鸭，异香偷出送歌儿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5322,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"昆腔绝句 其四","author":"陈子升","text":"游戏当年拜老郎，水磨清曲厌排场。\n而今总付东流去，剩取潮音满忏堂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5323,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"读白沙先生诗","author":"陈子升","text":"虫垂虚室一条丝，炉上孤烟四壁知。\n歇下苦吟抽卷看，呼儿抄出白沙诗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5324,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"遥题药地禅师青原新得瀑泉 其一","author":"陈子升","text":"远公却住青原寺，三叠泉流七祖山。\n才向虎狼边振锡，晴虹飞下翠微间。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5325,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"遥题药地禅师青原新得瀑泉 其二","author":"陈子升","text":"混混曹溪水有源，青原一派号山门。\n不见大师传祖意，三条冰挂一峰尊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5326,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"遥题药地禅师青原新得瀑泉 其三","author":"陈子升","text":"官长樵苏尽欢喜，旧山忽见新泉水。\n师将一口吸西江，谁共解者愚山子。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5327,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"遥题药地禅师青原新得瀑泉 其四","author":"陈子升","text":"不肯常升讲法台，只应随意把山开。\n为怜旧友相如渴，片札将泉过岭来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5328,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"拜水词","author":"陈子升","text":"炎风吹日熨秋禾，拜水呼天咽浊河。\n无计可令沟洫满，千人迸泪作滂沱。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5329,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"丹阳道士浇花歌","author":"陈子升","text":"丹阳丹室牡丹台，台下鸡冠花独开。\n未到明年春烂漫，可知丹在道人胎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5330,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"谣俗 其一","author":"陈子升","text":"行乐乡中羡佛山，肯将螺髻换云鬟。\n优场亦摆香花供，唱出清词菩萨蛮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5331,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"谣俗 其二","author":"陈子升","text":"玉漏无声宝镜开，笙箫细细度云来。\n如何竞赏中秋月，打鼓鸣钲响似雷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5332,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"山子和尚索水岩研赠之系以诗","author":"陈子升","text":"文字因缘未脱离，参禅欲转宝峰机。\n虽然不解东坡带，也为山门赠研归。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5333,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"法曲","author":"陈子升","text":"翻歌换舞逐千春，求旧方能变得新。\n不见汉宫传髻样，白头梳教及笄人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5334,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"葩经体川流四章","author":"陈子升","text":"川流浮浮，我今斯居。\n不遑朝餔，吁嗟乎权舆。\n川流㶁㶁，我今斯息。\n不遑朝食，吁嗟乎宿昔。\n园中何有，有薪有蔬。\n吁嗟权舆，胡食而鱼。\n不遑朝餔，曰犹徐矣。\n薪蔬惟棘，莫之敷矣。\n园中何有，有荼有藿。\n吁嗟宿昔，胡食而鲽。\n不遑朝食，曰犹绎矣。\n荼藿骚骚，莫之藉矣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5335,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送黎遂球公车北上","author":"陈子升","text":"南地犹思北地寒，今春当作来春看。\n上林始信成名易，芳草无忧行路难。\n黄雀野田时一见，青骢到处欲为欢。\n只今愁煞离弦笛，还望青云整羽翰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5336,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄陈中洲给谏 其一","author":"王鸣雷","text":"相见年华却共悲，少年曾见柳丝丝。\n浮生浮世有何事，花落花开能几时。\n一任谏书云易过，独留诗卷石难移。\n鬓毛焦尽青铜改，白口无情说与谁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5337,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄陈中洲给谏 其二","author":"王鸣雷","text":"九江江口钓鱼湾，江上柴门尽掩关。\n阙下几年休疏去，城中十日卖文还。\n天寒燕子巢深屋，春暖桃花开浅山。\n今日工诗陈给事，题诗应记七岩间。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5338,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"夜寻容道士","author":"王鸣雷","text":"一声山磬静，洞口白云深。\n偶见鹤飞出，天坛忽在林。\n水流通涧药，风度隔窗琴。\n到此亮明月，当空持鉴心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5339,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春日江村","author":"王鸣雷","text":"柳气堤边厚，东风吹入窗。\n年衰从岁转，道困任时降。\n蝴蝶晴来巷，鸬鹚雨入江。\n故人书札少，春雁阻何邦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5340,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广陵留别友人","author":"王鸣雷","text":"衰颜顾盻即平生，况复悠悠行客情。\n瓜步晚云愁独雁，邗沟寒雨暗双旌。\n深秋读易闻流水，落日看碑对古城。\n惆怅一尊向谁尽，故人相别易沾缨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5341,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过彭蠡湖","author":"王鸣雷","text":"挂帆彭蠡即湖东，回首经过四望空。\n万顷寒光飞鸟外，千溪月色钓鱼中。\n长虹倒映天河水，远浪横吹夜岳风。\n闻说洞庭还浩浩，赤沙青草不能同。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5342,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"沛中怀古","author":"王鸣雷","text":"花傍高楼日傍杨，帝家居处本无方。\n一州亦属君臣地，大统宁分父母乡。\n黑夜吼龙蛇草湿，碧天低雁马台荒。\n今朝沛里浮云外，古驿鸟歌归路长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5343,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"岘山怀古","author":"王鸣雷","text":"断桥斜日出云津，访古登临感慨频。\n鹦鹉不吟梁浦月，铜鞮空唱岘山春。\n雍台树色西连楚，樊口桃花北向秦。\n下马便寻羊叔子，看碑几度欲沾巾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5344,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠宗兄醴侯","author":"王鸣雷","text":"脉脉春云愁，有女讴齐瑟。\n鼓瑟亦何为，收袂返终日。\n山中有仙人，披发长过膝。\n月光弹素琴，一曲幽且逸。\n一弹弹再弹，齐女和歌出。\n水升山可沉，琴瑟工难述。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5345,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"穷鸟","author":"王鸣雷","text":"穷鸟与飞鸟，所止同一树。\n南枝朝树风，北枝暮树雨。\n飞鸟大海翔，为君起烟雾。\n穷鸟意彷徨，一举一回顾。\n穷鸟一匹雏，行不远百步。\n孰如飞鸟良，瞬息万里路。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5346,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"罗浮五色雀歌","author":"王鸣雷","text":"罗浮五色雀，仙人骑白羊。\n丹雀随翱翔，群雀鸣锵锵。\n丹雀问黄雀，问君游何乡。\n道路艰且长，十里山重重，五里水泱泱。\n帝位临明堂，富贵谁相忘。\n下有大羽臣，衣绿不可当。\n朝见两翼合，暮见两翼张。\n三九不服食，四九服饧糖。\n五里见丹雀，十里衔相将。\n一见羽毛好，再见羽毛良。\n同是仙人禽，养育何生光。\n东山有鸟白，汝可揖相望。\n食叶长志气，食花长肾肠。\n大雀乐妻孥，小者哀其旁。\n问雀哀何为，道路艰且长。\n十里山重重，五里水泱泱。\n独与黑雀别，仙人返东方。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5347,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"谒南海神庙","author":"王鸣雷","text":"朱火位南离，灵命蕴川渎。\n极望见岛边，浩淼无崖屋。\n山翠下添流，日光上回浴。\n纵横起神异，须臾天地肃。\n鱼鸟失飞沉，岱岳失瞻瞩。\n日晚春云阴，江水寒且绿。\n芳香去垢秽，衣带长跪束。\n神在其左右，佑我东土族。\n人物无屯邅，及时播百谷。\n方春二三月，田女馈香粟。\n桂树为君舟，木兰为君毂。\n斿旂具旨酒，江汉遒百禄。\n天子遣使臣，远道以文祝。\n王其爱玉体，简命将斯复。\n老生心皇皇，入庙巡碑读。\n日暮松树鸦，点点引归目。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5348,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"挽王华姜诗","author":"王鸣雷","text":"上山种青松，大海多北风。\n良人虽云好，安能远相从。\n夫子为我言，五年客秦中。\n得偶曰华姜，大家其仪容。\n华姜为孟光，华夫为梁鸿。\n一日念母老，母老在海东。\n母老儿在家，菽水亦得供。\n今君远万里，何能承欢同。\n妾愿从君归，事姑永房帏。\n但看江水长，誓志不相违。\n夫何洁羹饭，一旦泉下亏。\n姑生妇归喜，妇死姑何依。\n丈夫不得志，万事皆已非。\n女子解爱才，感激知音稀。\n上山种青松，松下鹤高飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5349,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"程氏有烈女","author":"王鸣雷","text":"程氏有烈女，自名为笋姑。\n六岁诵论语，七岁奉盘盂。\n八岁工织缣，九岁绣罗襦。\n十岁慈母病，甘饿其体肤。\n三日常不饭，羹药办中厨。\n笋姑年十七，未常里门趋。\n趋趋户庭间，亦不踰门睮。\n其岁为戊申，其月为辰娵。\n野鸟守房舍，暴客执矛殳。\n公然纵白刃，获金而索珠。\n阿母病床褥，女不忍驰驱。\n宁死于母旁，慷慨行捐躯。\n暴客挥火茅，延烧乎室隅。\n救火抵母难，身与白刃俱。\n毁生存大义，气绝在须臾。\n观者如堵墙，股栗泪填衢。\n行者久伫立，叹息烈女殊。\n老者哭纸钱，焚致乎修途。\n幼者馈巾帛，村村桑叶枯。\n媒妁向婿言，此罪谁当诛。\n程氏筮十日，不久当归夫。\n岂知中道崩，使君委罗敷。\n何以拜姑嫜，姑嫜泣乌乌。\n命子各成礼，长恸恨穿窬。\n衔悲收汝骨，归葬乎上都。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5350,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"伉俪","author":"王鸣雷","text":"藁砧何翩翩，乡里方少年。\n星临格泽丽，月照蚌东圆。\n堂上致敬戒，君子其缠绵。\n不剪锦麝蜡，不烧迷叠烟。\n不华苹不绣，不连理不钿。\n乘车不异轨，井渫不改田。\n被刺共命鸟，席织共心毡。\n煮共并根麦，浴共一流泉。\n子盼我留睫，子趋我疾前。\n我欢子无怒，我起子无眠。\n两情同不蚀，金石以合坚。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5351,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"苦役行","author":"王鸣雷","text":"羊角脂，燕尾丝，上官掌粮如掌珠。\n三版字，半行朱。\n十九天狗日，主簿捋髭须。\n堂上吏，屋下呼。\n呼开门，避大姑。\n王米十八笠，笠笠连罗襦。\n老妇三日不下厨，羹汤手办绩麻菇。\n缝衣不得身上着，身脱县门心即乐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":5352,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]