[{"title":"塞上曲一百首（录一十四首） 其二","author":"李开先","text":"已过瓜期不放班，天寒路远泪潸潸。\n交河北望天连海，朔野南来雪满山。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":275,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"塞上曲一百首（录一十四首） 其三","author":"李开先","text":"风急营中忽夜惊，误将军出获胡兵。\n黄龙戍卒归无日，白马将军幸有名。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":276,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"塞上曲一百首（录一十四首） 其四","author":"李开先","text":"能令明主坐销忧，百战功高独不侯。\n冬冷春和俱入寇，三军岂但只防秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":277,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"塞上曲一百首（录一十四首） 其五","author":"李开先","text":"堂上张灯酒正豪，帐前骏马缩寒毛。\n忽闻羽檄传来急，上马酕醄弄宝刀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":278,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"塞上曲一百首（录一十四首） 其六","author":"李开先","text":"无虏到来传炮火，有人行处断炊烟。\n虚惊自是寻常事，墩堡堪怜不似前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":279,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"塞上曲一百首（录一十四首） 其七","author":"李开先","text":"探踪偶尔近龙堆，黑雾黄云冻不开。\n林外惊闻鸣镝过，始知胡骑射雕回。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":280,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"塞上曲一百首（录一十四首） 其八","author":"李开先","text":"不经大挫不知惧，怪得胡儿犯顺多。\n复套既然蒙重戮，捣巢罪复合如何。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":281,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"塞上曲一百首（录一十四首） 其九","author":"李开先","text":"黄河万里障边隅，黠虏年来谋计殊。\n不用轻帆与短棹，浑脱飞渡只须臾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":282,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"塞上曲一百首（录一十四首） 其十","author":"李开先","text":"久废屯田已可忧，盐银年例总虚浮。\n兵疲难守黄河口，况敢长驱青海头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":283,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"塞上曲一百首（录一十四首） 其十一","author":"李开先","text":"虎旅纷纷列虎牙，龙庭漠漠走龙沙。\n未交八月先飞雪，已尽三春不见花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":284,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"塞上曲一百首（录一十四首） 其十二","author":"李开先","text":"辕门士卒众还雄，更羡车攻马又同。\n自是经营能竭力，新来节制免从中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":285,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"塞上曲一百首（录一十四首） 其十三","author":"李开先","text":"城坏鸠工早筑城，练兵不必请添兵。\n细磨深刻燕然石，首列平胡大将名。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":286,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"塞上曲一百首（录一十四首） 其十四","author":"李开先","text":"破虏山前今再经，晓行尚有两三星。\n日高始辨朱旗色，风起犹闻战血腥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":287,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"田家乐二首 其一","author":"李开先","text":"四十归田已是迟，田家乐处有谁知。\n莺花作主今朝事，鸡黍邀宾隔岁期。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":288,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"田家乐二首 其二","author":"李开先","text":"田边绿树是吾居，行坐歌讴不著书。\n莫笑老农滋味薄，钓来盈尺有溪鱼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":289,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"巫山一段云 其二 集美人名","author":"尤侗","text":"紫玉雕歌扇，红绡织舞裙。\n年华小小貌真真。\n锦字写双文。\n花蕊当窗见，兰香隔座闻。\n莫愁春信夜来分。\n入梦有朝云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":290,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"卜算子 其一 夜忆","author":"尤侗","text":"秋雨急如筝，弹破江南梦。\n野外西风叶叶吹，撼起栖鸦动。\n夜永惜灯残，衾薄知寒重。\n飞尽征鸿莫寄书，曲冷文君弄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":291,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"卜算子 其二 闺思","author":"尤侗","text":"整日数归期，数了回头数。\n不信朝朝暮暮思，历本看掀破。\n特地倚门妆，依旧空床卧。\n多分宵来梦不应，今夜拼重做。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":292,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"卜算子 其三 忆别","author":"尤侗","text":"忆别燕双双，新燕添三五。\n教妾空房羞独眠，打碎巢边土。\n莫更摘花来，且自衔书去。\n唤得萧郎早早归，与汝重修补。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":293,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"减字木兰花 其一 送春","author":"尤侗","text":"重门深掩，不道背人归去远。\n倦燕娇莺，啼出阳关第四声。\n含愁想问，飘泊天涯何处定。\n梦断罗帷，今夜明朝睡起迟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":294,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"减字木兰花 其二 春去","author":"尤侗","text":"春乎欲去，何以赠之双泪雨。\n回首东风，一缕飘魂赶落红。\n绿兮满树，花影半窗秋色暮。\n人倚栏杆，愁听空梁燕语寒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":295,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"减字木兰花 其三 新竹","author":"尤侗","text":"此君一个，与我周旋林下坐。\n新出三竿，官样青袍玉笋班。\n萧萧风动，惊破西堂春草梦。\n旧箨还裁，好放些儿月影来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":296,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"丑奴儿令 偶感","author":"尤侗","text":"春来秋去何时了，昨日阴山。\n今日阳关。\n白发黄鸡弹指间。\n只求梦里流年好，今夜邯郸。\n明夜巫山。\n睡过三生亦喜欢。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":297,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"柳含烟 杨柳","author":"尤侗","text":"青青柳，正藏鸦。\n借问风吹多少，霓裳一舞自堪夸。\n旧杨家。\n可恨销魂桥畔路。\n送去征人无数。\n却教闺梦变飞花。\n向天涯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":298,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"谒金门 其一 愁","author":"尤侗","text":"奈何许。\n欲说近来愁绪。\n愁到依然无一语。\n罗衫几点雨。\n旧事子规催去。\n新恨鹧鸪留住。\n梦逐东风无歇处。\n飘零随柳絮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":299,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"谒金门 其二 寒夜","author":"尤侗","text":"人寂寂。\n一派暮愁天色。\n风剪轻寒落渐侧。\n纸窗吹半黑。\n正对孤灯萧瑟。\n又听孤鸿嘹呖。\n庭外黄花清露滴。\n泪痕依样湿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":300,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"谒金门 其三 代和韦庄","author":"尤侗","text":"休相忆。\n红叶不传消息。\n燕锁雕梁路未识。\n旧巢难再觅。\n风捲杨花无力。\n浪打萍花无迹。\n永巷夜台同寂寂。\n土花凝血碧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":301,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"谒金门 其四 题龚静照鹃红稿","author":"尤侗","text":"鹃红稿。\n静照恰同清照。\n最是销魂新句好。\n回身将梦抱。\n叵耐氤氲颠倒。\n彩凤教随乌鸟。\n晓镜画眉添懊恼。\n红颜祈速老。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":302,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"忆秦娥 感春","author":"尤侗","text":"春来矣。\n春风细剪春林绮。\n春林绮。\n梦随春住，情随春使。\n春妆含笑春衫泪。\n春光活泼春心死。\n春心死。\n一番春恨，一番春喜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":303,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"更漏子 其一 独夜","author":"尤侗","text":"五更风，三点雨。\n并作零钟断鼓。\n残叶影，落花魂。\n凄凄来叩门。\n天涯雁，飞声乱。\n叫出伤心一片。\n倚半枕，拥孤衾。\n相思睡不成。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":304,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宫词（十八首） 其一","author":"张凤翔","text":"昔入宫中发未齐，尚衣今许入深闺。\n十年一得君王顾，重为班头捧紫泥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":305,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宫词（十八首） 其二","author":"张凤翔","text":"茂陵仙去已多年，牢闭深宫敢斗妍。\n昨日有人曾赐死，阿娇恰好近君前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":306,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宫词（十八首） 其三","author":"张凤翔","text":"上皇弓剑杳何追，日倚宫阑自拄颐。\n宝册有儿开大府，生离争似在宫时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":307,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宫词（十八首） 其四","author":"张凤翔","text":"青铜偷把扫蛾眉，暂饰休教主后知。\n记得比年王乳媪，香魂重遣主人疑。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":308,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宫词（十八首） 其五","author":"张凤翔","text":"自谢南荒十二年，焚香得侍玉皇前。\n绛罗误露春初笋，能遣君王重爱怜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":309,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宫词（十八首） 其六","author":"张凤翔","text":"阿奴元是岭南人，万里那猜近紫宸。\n不是少年粗识字，殿前争得掌丝纶。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":310,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宫词（十八首） 其七","author":"张凤翔","text":"御沟烟水自潺潺，片片桃花落正间。\n自恨不如花片落，能随流水到人间。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":311,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宫词（十八首） 其八","author":"张凤翔","text":"夜半钟声起景阳，六宫粉黛试新妆。\n就中最是施娘子，典奏时能近玉皇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":312,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宫词（十八首） 其九","author":"张凤翔","text":"蚤谙图史欠吹嘘，长侍宫闱备扫除。\n一日诏宣充典奏，秩名应赐女尚书。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":313,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宫词（十八首） 其十","author":"张凤翔","text":"玉搔头绾绿鸦横，雾縠冰绡底样轻。\n帘闭水晶无点暑，百花亭外度流莺。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":314,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宫词（十八首） 其十一","author":"张凤翔","text":"天子侵晨御正衙，内家箫管隔烟霞。\n万几日日归中秘，中有夫人为掌麻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":315,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宫词（十八首） 其十二","author":"张凤翔","text":"锦屏斜立百花春，玉貌三千侍主人。\n最是慧娘谙曲调，绣茵低舞细腰频。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":316,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宫词（十八首） 其十三","author":"张凤翔","text":"入内深蒙主后恩，赐名小姐宠便蕃。\n后来更得夫人号，长乐宫中许坐轩。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":317,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宫词（十八首） 其十四","author":"张凤翔","text":"远山凝黛口凝脂，妆就慵来坐矮簃。\n出候君王临早御，归来便殿与围棋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":318,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宫词（十八首） 其十五","author":"张凤翔","text":"曾同母后入宫敔，岭海今辞廿六春。\n启顶新蒙君手赐，六宫争贺内夫人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":319,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宫词（十八首） 其十六","author":"张凤翔","text":"禁柳春深草色新，杨花飞趁扑虫人。\n君王殿上宣名字，旋绾颓鸦抹绛唇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":320,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宫词（十八首） 其十七","author":"张凤翔","text":"井梧写句付宫沟，墨汁啼痕字面稠。\n虎豹九重严夜禁，争能禁得水东流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":321,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宫词（十八首） 其十八","author":"张凤翔","text":"日夕焚香拜斗南，愿君多寿且多男。\n戒言阿母传兄弟，只道官家法度严。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":322,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过黄玄之山居","author":"唐泰","text":"半生流落意，相见但依依。\n卧病看春尽，愁心对客稀。\n砌花飘涧户，畦药映园扉。\n莫怪频来此，沧洲兴不违。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":323,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"次陈山人隐处","author":"唐泰","text":"献春始休沐，轻策寻幽风。\n烟筱不知路，柴扉隐其中。\n杂花覆小涧，下映流泉红。\n冥心听喧鸟，解带投芳丛。\n谁识此嘉遁，心期黄绮同。\n南轩有余兴，月出鸣丝桐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":324,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"更漏子 其二 有怀","author":"尤侗","text":"春风香，秋月弄。\n断送十年残梦。\n如意曲，定情诗。\n相思不自持。\n巫山高，湘水远。\n惆怅彩鸾缘浅。\n霍小玉，董双成。\n他生定遇卿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":325,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"清平乐 其一 梅蕊","author":"尤侗","text":"烟姿玉骨。\n淡淡东风色。\n勾引春光一半出。\n犹带几分羞涩。\n陇头倚雪眠霜。\n寒肌密抱疏香。\n待得罗浮梦破，美人打点新妆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":326,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"清平乐 其二 芦花","author":"尤侗","text":"秋风泽畔。\n小草霜华染。\n比似杨花吹不断。\n却被雁衔天半。\n月明野渡苍茫。\n伴他枫叶吴江。\n堪笑白头老子，夜寒尚倚红妆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":327,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"清平乐 其三 春闺","author":"尤侗","text":"懒妆草草。\n怕说春光好。\n几日伤春吟未了。\n一幅乌丝残稿。\n昼长午梦初醒。\n碧桃花下微行。\n闲唤侍儿消遣，小楼偷放风筝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":328,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阮郎归 旅思","author":"尤侗","text":"他乡无处不凄其。\n晚春人易悲。\n杨花飘泊水蛄啼。\n高楼忆别离。\n宿酒醒，篆烟微。\n愁来眉渐低。\n满帘风雨断肠时。\n一声玉笛吹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":329,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜迁莺令 贺李丹壑秋捷时年十六岁","author":"尤侗","text":"唐学士，李青莲。\n公子更翩翩。\n荷衣总角赋高轩。\n名字报红笺。\n曲江宴，樱桃畔。\n争看紫骝白面。\n嫦娥应遣小婵娟。\n花插帽檐边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":330,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"海棠春 其一 晚妆和阮亭韵","author":"尤侗","text":"更衣斗帐流苏响。\n拂舞镜、垂垂丝网。\n一片美人云，弄影秋波漾。\n小鬟帮衬新兴样。\n梳掠罢、口脂相赏。\n飞鬓恼春风，莫放罘罳敞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":331,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"海棠春 其二 午睡和韵","author":"尤侗","text":"氤氲绣幕香生足。\n欹山枕、弓腰低曲。\n一搦藕肢柔，刚贴芙蓉褥。\n梦中辅体靡红肉。\n蓦惊起、坠钗寒玉。\n笑看抱谁眠，却是夫人竹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":332,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"海棠春 其三 晚浴和韵","author":"尤侗","text":"画帘双燕争花影。\n睡未足、海棠惊醒。\n玉骨六铢轻，心怯温泉冷。\n起来弄色芙蓉镜。\n分外好、髻松鬟整。\n无力倚薰笼，呼点龙团饼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":333,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"海棠春 其四 夜坐和韵","author":"尤侗","text":"井梧叶落声如雨。\n又风送、小楼砧杵。\n淡月隐屏山，花底闻私语。\n空床好梦抛人去。\n厮守尽、更更更鼓。\n不见谢郎归，烛影摇松尘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":334,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"海棠春 其五 为吴茵次韵寿马少君","author":"尤侗","text":"沙星畔扶风马。\n看绿鬓、白眉相亚。\n月里嫁吴刚，桂殿鸳鸯瓦。\n娇儿玉雪妆台下。\n自句读、焉哉乎也。\n生日在豳风，君子歌需雅。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":335,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"摊破浣溪沙 其一 春闺","author":"尤侗","text":"愁倚东风唱踏莎。\n画屏十二自腾那，殃及斑鸠天外去，唤哥哥。\n无限翠颦低远岫，几番红泪上横波。\n却与落花千万点，一般多。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":336,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"拂霓裳","author":"徐石麒","text":"望中原，故宫锦树障烽烟。\n惊坐起，凉宵梦断蒋陵前。\n金人倾宝露，玉女绣苔钱。\n问当筵，有谁能、醉鼓渐离弦。\n西台哭罢，三户里、识遗贤。\n欹皂帽，吹箫乞食总堪怜。\n英雄身未死，屠钓技常连。\n又何颜，许青门、瓜种故侯田。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":337,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阮郎归 秋雨","author":"杨士聪","text":"风吹黄叶客心惊，暗云秋雨生。\n青山飞霭入楼轻，摽摇连暮声。\n沾垄润，洒溪清，疏烟藏橘橙。\n江天千里一樽倾，萧萧白发更。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":338,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"眼儿媚 赠卞校书","author":"万寿祺","text":"花弄香纹春满楼，桃叶引江流。\n个人何事，斜阳独倚、曲曲肠柔。\n垂帘淡淡扑杨球，私心好处投。\n侍儿敛态，闭门作意，不上金钩。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":339,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙","author":"钱继章","text":"春尽园林褪闹红，阴阴静绿意从容。\n须眉俱碧住山翁。\n花卷半阶通履舄，柳开一面出帘栊。\n管人闲事是东风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":340,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙","author":"钱继章","text":"睡损眉黄澹未添，凤屏残麝透花尖。\n下阶幽梦背人占。\n柳外疏莺声睨睆，竹边归燕语呢喃。\n斜风细雨隔重帘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":341,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]