[{"title":"初归居巢感怀","author":"龚鼎孳","text":"失路人归故国秋，飘零不敢吊巢由。\n书因入洛传黄耳，乌为伤心改白头。\n明月可怜销画角，花枝莫遣近高楼。\n台城一片歌钟起，散入南云万点愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14948,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秦淮社集白孟新有诗纪事和韵","author":"龚鼎孳","text":"放船烟水色苍然，尽谢朱门酒肉膻。\n落日凤台邀李白，离宫花谱泣伶玄。\n十年兰艾天难问，诸子膺滂事可怜。\n虎豹于今尽萧索，吞声还似九关前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14949,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雪航侍御还朝","author":"龚鼎孳","text":"青霜一夕起鸳班，有客乘骢万里还。\n苜蓿夜肥西极马，葡萄秋入玉门关。\n盛名博望槎同远，往事朱游槛独攀。\n长为膺滂生意气，盈廷卿相已摧颜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14950,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"留别彦远","author":"龚鼎孳","text":"子夜吴趋锦瑟弹，人归江海各风湍。\n谁怜纵酒嵇中散，不异挥锄管幼安。\n名重尔偏藏著述，路穷吾转讳饥寒。\n西山薇蕨东山屐，输与时贤白眼看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14951,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蒿庵都谏谪官建宁","author":"龚鼎孳","text":"乍闻鸣凤下丹霄，捧檄重惊去路遥。\n当殿人谁同庆忌，谪官天许对皋陶。\n风霆正足旌狂直，禄秩将无点圣朝。\n到日岛门烽燧息，蕉红榕绿引轻桡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14952,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"丘曙戒侍讲谪倅琼州","author":"龚鼎孳","text":"南武山川一叶舟，行看蜃气吐危楼。\n无天有海原奇境，挝鼓回帆亦壮游。\n地逼崖门春涨黑，啸清帘阁战旗收。\n相逢泷吏多嘲笑，笑汝如弦愧曲钩。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14953,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"生辰曲","author":"龚鼎孳","text":"琉璃为箧贮冰霜，谏草琳琅粉泽香。\n哭泣牛衣儿女态，独将慷慨对王章。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14954,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"上元词和善持君韵","author":"龚鼎孳","text":"紫雾晴开凤阙初，五侯弦管碧油车。\n芳闺此夕残灯火，独照孤臣《谏猎书》。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14955,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"百嘉村见梅花","author":"龚鼎孳","text":"天涯疏影伴黄昏，玉笛高楼自掩门。\n梦醒忽惊身是客，一船寒月到江村。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14956,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题绛雪吴君画册","author":"龚鼎孳","text":"卖珠补屋意高闲，万叠烟霞拥玉颜。\n想像乱峰睛雪里，自临眉黛写青山。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14957,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"韬光庵和高忠宪公韵","author":"曹溶","text":"选日届山宇，意适常有馀。\n喧寂两无染，乃得还其初。\n古草幽更绿，巢鸟鸣阶除。\n独往泉上游，人境忽已疏。\n檐表得微路，高下随所如。\n肃肃清昼阑，月出松林虚。\n解带聊宴息，岂曰非我居。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14958,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"答顾宁人","author":"曹溶","text":"北鄙寡同俦，中情正枯槁。\n谬蓄四方略，救溺甚援嫂。\n束缚无所施，空堂对衰草。\n有美三吴杰，险要动深讨。\n良马碧玉鞍，兴到踏丰镐。\n土既经时，行李湿秋潦。\n西南征调繁，万里赋纳藁。\n囊有本务书，利病满怀抱。\n采掇及细流，访我平城道。\n艰辛戈戟间，匡坐说苍昊。\n撞钟得洪音，太朴去纤缟。\n汲古沃其根，枝叶倍姣好。\n下视班张徒，炫目但虚藻。\n是月凉露零，长边静杲杲。\n旨酒共话言，愁绪惄如捣。\n我性本浮游，悠忽将终老。\n外物丧本真，进德未能早。\n蒙君下针砭，宿疾期一扫。\n自知良独难，人鉴庶为宝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14959,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"悯荒二首 其一","author":"曹溶","text":"寇祸烈兹土，举目无故观。\n百里一空城，蓬蒿郁相蟠。\n村妪土中出，肘肉伤雕残。\n生长不识布，石灰暖我寒。\n匍匐向前途，力尽酸肺肝。\n苦菜萌已晚，采之不能餐。\n撤屋备朝薪，露处难久安。\n边境既流离，内地何由完。\n宸聪听还卑，讨论穷众端。\n减赋息长徭，万方用腾欢。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14960,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"悯荒二首 其二","author":"曹溶","text":"游民轻去乡，担釜卧沟侧。\n未知何方好，奔走昧南北。\n无乃吏政苛，聊欲避所逼。\n持檄疾招来，计口给汝食。\n诚恐失初心，展转成盗贼。\n踉跄返前村，日影正曛黑。\n面目半已改，父子不相识。\n劝汝秉锄犁，陇上艺黍稷。\n妇女勿娇惰，轧轧当户织。\n壮者习弯弓，努力卫邦国。\n人事苟修诗，天道岂终极。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14961,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"堕驴行简叶星期","author":"曹溶","text":"横山山人出无车，浩兴欲往钟山隅。\n葛衣炙日仅掩骭，腹底万卷聱牙书。\n奇书岳渎鲜能载，况此风雪桥边驴。\n雪昏石滑骤欹侧，前却俄顷纷趑趄。\n中途一蹶在平地，长耳狡诈奔荒墟。\n仕路艰危靡不有，陷阱往往生巾裾。\n万物之灵尽如此，驴也学步师其馀。\n山人前年宰邗邑，阳侯毒啮不得舒。\n堤成泽国始平陆，遍挽鱼鳖归耰锄。\n岂徒民疾快完聚，车马孔道皆安徐。\n无钱竟触长官怒，一朝谤箧遭驱除。\n多才自昔召倾覆，更乃傲骨丘山如。\n瘦驴效尤聊复尔，未若此辈深而狙。\n山人熟识倚伏理，细事那足烦嗟歔。\n长干六月暑气合，画桡宛转衔清渠。\n三日行药两日卧，趫健不异少壮初。\n慎勿悔此暂时失，诗肠遽使添郁纡。\n堕驴一笑古有诸，会看治象开皇舆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14962,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"李云田以虔州怀予诗见示奉答","author":"曹溶","text":"避兵曾说到江东，十幅春帆下北风。\n烽火依然连郡国，文章真解误英雄。\n梦回老友蓬蒿里，泪尽军州鼓角中。\n岁月奔驰还话别，异时搔首望征鸿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14963,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"酬徐子能山人","author":"曹溶","text":"武原狂客闭关居，花外新传尺素书。\n重见伟长留撰述，不教元亮擅篮舆。\n玉山暖映春风动，铁甲晴收水国虚。\n痛定较量流寓事，皋桥遗迹定何如？","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14964,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秋柳","author":"曹溶","text":"灞陵原上百花残，堤树无枝感万端。\n攀折竟随宾客尽，萧疏转觉道途寒。\n月斜楼角藏乌起，霜落河桥驻马看。\n正值使臣归去日，西风别泪望长安。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14965,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"观工人琢砚二首 其一","author":"曹溶","text":"廿年裘马半从军，羞见羊家白练裙。\n自笑归装轻似叶，不妨多载岭南云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14966,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"观工人琢砚二首 其二","author":"曹溶","text":"南唐官务久凋零，海国重来倚玉屏。\n不信穷途知己有，一双鸲鹆眼常青。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14967,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"北固山","author":"陈之遴","text":"危磴侵云策杖遥，琳宫积翠拥岧峣。\n烟开铁瓮生残照，风起金山急暮潮。\n饮马几回虚割据，卧龙从古混渔樵。\n六朝佳丽依稀在，花月春江响玉箫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14968,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"江行杂感","author":"周亮工","text":"逐客江干夜寂寥，无端铁笛起中宵。\n深秋梁苑新沙碛，明月清溪旧板桥。\n万里梦回千嶂雨，一帆风动五更潮。\n草堂空有农书在，桑柘如今尽已凋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14969,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟中与胡元润谈泰淮盛时事次元润韵","author":"周亮工","text":"红儿家近古青溪，作意相寻路已迷。\n渡口桃花新燕语，门前杨柳旧乌啼。\n画船人过帘波动，翠幔歌轻扇影低。\n明月欲随流水去，箫声只在板桥西。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14970,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寒食后一日新乡道上示许傅岩","author":"周亮工","text":"南辕西向浊河边，叹息时违境屡迁。\n半绽桃花全待雨，平飞柳絮欲为烟。\n敝车羸马吹新火，古道荒林拜杜鹃。\n烽燧十年归未得，却愁明发渡旃然。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14971,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"靖公弟至","author":"周亮工","text":"荒城兀坐对灯残，归计先愁百八滩。\n尔又远来余未去，高堂清泪几时干？","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14972,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜蒋用韬至自闽南","author":"周亮工","text":"海水群飞百丈高，同君城上拥弓刀。\n战瘢莫共灯前看，恐惹霜华上鬓毛。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14973,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"冬日田家二首 其一","author":"赵进美","text":"北风夜来息，茅宇觉微暖。\n比邻机杼鸣，平畴麦叶短。\n初日聚童稚，坐卧杂鸡犬。\n屋梁悬众耜，寂寞岁事晚。\n石寒溪流激，雪霁烧痕浅。\n疏林不隔烟，冬野能见远。\n飞鸿顾前渚，饥乌噪空坂。\n长啸登东皋，暮逐樵声返。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14974,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"冬日田家二首 其二","author":"赵进美","text":"星尽晓色分，日出飞鸟外。\n高枝残雪压，寒村散微霭。\n田家门始开，篱落闻犬吠。\n草际风未定，树杪霞犹在。\n方见牛羊群，一一远岭背。\n农夫倚仗立，默念将卒岁。\n鸟雀鸣阶前，儿女笑窗内。\n八口饱新粒，未冬完官税。\n皎皎清溪水，飒飒幽林籁。\n板桥无屐迹，静与草舍对。\n时有旧邻家，拂石坐相待。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14975,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"武昌杂感","author":"赵进美","text":"朔月堕白日，水立天昼昏。\n江汉难分流，岁暮蛟螭尊。\n怒鳞拔巨浪，势欲无厚坤。\n鳣鲔亦跳梁，变化随山根。\n舟楫下可恃，客意谁与论？\n遥望耆旧里，丁彼汉运屯。\n我怀沔上翁，长歌归鹿门。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14976,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"太原","author":"赵进美","text":"漠漠寒沙映戍楼，乱馀烽火未全收。\n天清句注连云起，木落汾河抱郭流。\n白草昼明吹角晚，黄榆风冷射雕秋。\n亦知万里轻行役，岁暮旌旗发旅愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14977,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梨花","author":"赵进美","text":"暮烟无语更依依，清影含春望欲稀。\n疏近琐窗留月照，寒垂网户见莺飞。\n共停阁外青丝骑，细舞灯前白纻衣。\n莫向后庭歌《玉树》，故宫风雨已全非。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14978,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"冬夜集梁园水堂","author":"赵进美","text":"千门初月动笳声，秉烛虚堂夜气清。\n大漠风云乘塞入，危檐星斗落尊明。\n交情四海谁悬榻，天意中原未厌兵。\n亦有一丘堪自老，故园东去虎纵横。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14979,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南康登楼","author":"赵进美","text":"返照临高阁，寒烟澹澹分。\n空城何所有，一半是匡君。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14980,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"别滇中僚友之官粤西","author":"彭而述","text":"二月春风已送寒，诏书昨日下长安。\n宦游不谓边城苦，远别其如知己难。\n孝武石鲸昆水动，日南铜柱海光寒。\n鹧鸪亭子梅花驿，万里征人马上看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14981,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"再登黄鹤楼","author":"彭而述","text":"飞楼缥缈著江干，霜鬓登临记往年。\n隔岸春城浮槛外，乱帆斜日到樽前。\n山连秦蜀开荆甸，水下东南尽楚天。\n回首沧桑生感慨，孙刘兴废几茫然。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14982,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"庚寅八月六日忆母","author":"彭而述","text":"遗恨行舟阻太行，难堪此日又潇湘。\n安东未遂怜温峤，《党锢》无名耻范滂。\n万里依人空作客，十年遇主尚为郎。\n萧骚短鬓经秋日，雁杳江城忆故乡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14983,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鄂渚别赵兴宁柱史之官滇南","author":"彭而述","text":"春城烟雨酒盈卮，大别山前赋别离。\n黔郡犹传秦岁月，昆明应识汉旌旗。\n千盘路上槟榔坞，一线天开玳瑁池。\n他日益州来驿使，武昌云树足相思。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14984,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"渝关道中","author":"孙廷铨","text":"菀柳荒亭下，残碑古戍前。\n秋光晴到水，山色净于天。\n气变虫音急，河沉月影偏。\n鸣鸡催候吏，问渡石溪船。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14985,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏史","author":"孙廷铨","text":"田叔归来窦后伤，萧条梁苑下微霜。\n一时宾客多枚马，不遣雄文悟孝王。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14986,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"河上","author":"高珩","text":"流水向人间，向水人亦尔。\n客心何淡淡，清波正齿齿。\n人境两萧然，太清游无始。\n劳劳车马尘，谁是沧浪子？","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14987,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"使君愁","author":"高珩","text":"巡鹾使者来何许，平干太守颜如土。\n敲扑卒吏血满堂，豸冠诟厉如虓虎。\n卒吏附耳守再拜，事上礼仪聊具备。\n使者一笑回春阳，还朝荐尔真循良。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14988,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"闻舟师相语","author":"高珩","text":"天风争顺逆，人事有参差。\n昨我停舟处，知君得意时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14989,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送阮亭东归时予亦有归志","author":"高珩","text":"青山约略有前期，犹听骊歌乱客思。\n少折都门东去柳，霜条留待我归时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14990,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠雪海","author":"高珩","text":"西清重到侍垂衣，万死人从浿水归。\n正可极言天下事，莫言主圣谏书稀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14991,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"归舟杂兴","author":"高珩","text":"逐岸移舟屡转篷，乘流自可任西东。\n人生末路住方稳，何用登舟祝顺风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14992,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"王铁枪","author":"梁清标","text":"王铁枪，真男儿。\n人留名，豹留皮。\n河上血战志不移，梁运既去一木支。\n问破敌，期三日。\n谗毁既已行，大功那可必。\n斗鸡小儿事业成，国耻未雪宁偷生！\n朝梁暮晋者谁子，段凝之辈真如蚁。\n嗟乎义士一死重太山，砀山朱三群盗耳。\n良禽栖木贵能择，将军之死亦可惜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14993,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送李蘅若同年之岭右","author":"梁清标","text":"五岭天垂尽，曾经马伏波。\n气蒸飞鸟避，木合夜猿多。\n徭洞堪传檄，楼船尚枕戈。\n汉家铜柱在，事业莫蹉跎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14994,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送萧都阃之云中","author":"梁清标","text":"缓带翩翩早策勋，旌旄北逐雁鸿群。\n日高涿鹿消边雪，马渡飞狐起朔云。\n却敌吹笳刘越石，弯弓饮羽李将军。\n坐看紫塞烽烟绝，盾墨先驰露布文。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14995,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送张仲若司马开府云中","author":"梁清标","text":"甲帐风清昼不欢，壮君三十早登坛。\n每烧北阙莲花炬，俄进西台獬豸冠。\n组练千群应变色，塞垣六月自生寒。\n居庸关外山形峻，涿鹿云开驻马看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14996,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送李吉津出塞","author":"梁清标","text":"生别妻孥出塞门，严城哀角动黄昏。\n文章自昔憎时命，痛哭终当感至尊。\n汉吏多持廷尉法，中朝谁举鲍生幡？\n此行渐入龙庭去，不用投诗吊屈原。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14997,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送张伯珩同年按蜀","author":"梁清标","text":"衔命西行白简寒，儒臣初著惠文冠。\n蚕丛惟有青磷起，伏莽当如赤子看。\n按部诸侯争负弩，洗兵三峡见安澜。\n兹行雨露沾殊俗，无复兴歌《蜀道难》。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14998,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"包孝肃祠","author":"梁清标","text":"孝肃祠堂剑佩闲，香花墩畔听潺湲。\n严霜落后瞻遗像，浊水澄时见笑颜。\n异代姓名童语习，中宵风雨鹤飞还。\n古今此地无关节，白日孤城冷蜀山。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":14999,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"拜张许六王祠","author":"梁清标","text":"名城蹀血共安危，道左飞尘剩古祠。\n六矢当年知号令，千秋为万见旌旗。\n江淮力障孤军日，睥睨风生苦战时。\n每读昌黎书传后，伤心南八是男儿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15000,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蕉林书屋绝句","author":"梁清标","text":"淡烟晴日满帘栊，春色依依上小红。\n客为看花频载酒，海棠开否问东风。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15001,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"柳敬亭南归白下","author":"梁清标","text":"军中轶事语如新，磊落宁南百战身。\n为问信陵当日客，侯门谁是报恩人？","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15002,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"姚若侯至感赠","author":"王崇简","text":"侧身天地岁时迁，岂意重逢北斗边。\n万里风波双眼内，三年悲喜一灯前。\n独宜纵酒聊谐俗，何处狂歌可问天。\n莫向帝城怀往事，五陵松柏半荒烟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15003,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"新秋感兴三首 其一","author":"王崇简","text":"忆昔谁人秉国成，甘泉烽火岁频惊。\n盈庭聚讼惟钩党，伏阙求官藉论兵。\n坐使威权归北寺，遂令盗贼躏西京。\n五陵豪贵皆尘土，日暮青磷遍野横。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15004,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"新秋感兴三首 其二","author":"王崇简","text":"殉国曾闻有数公，犯颜敢谏向来同。\n卫宫几见杨文义，伏辇还逢嵇侍中。\n荆棘荒凉悲夜月，蟪蛄哀怨吊秋风。\n至今箕尾光难灭，古木寒烟恨不穷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15005,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"新秋感兴三首 其三","author":"王崇简","text":"渔阳秋色照桑乾，日暮沙飞雁度难。\n御苑金茎迷细草，上方银汉挂阑干。\n西风欲诉明妃怨，千载空歌易水寒。\n怅望高天成太息，数声清角月中残。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15006,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"入栈纪行四首 其一","author":"杨思圣","text":"极望峰峦稠，云飞常没顶。\n空翠沾衣裳，堕作涧溪影。\n花鸟乱听闻，心眼细细领。\n晞阳射碧潭，石粼碎光炯。\n蒙笼草成阴，树老身戴瘿。\n山鬼时一啸，肃肃毛发冷。\n前行隔后行，后岭迷前岭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15007,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]