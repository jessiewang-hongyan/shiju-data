[{"title":"保定重别陈少参 其一","author":"屈大均","text":"去尽雁门客，无依馀片云。\n往时托琼树，鸾鹤共纷纷。\n幕府虚秋宪，滹沱但夕曛。\n何当逐旌节，重向朔方军。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9055,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"保定重别陈少参 其二","author":"屈大均","text":"三年求菽水，流落向人看。\n膂力风尘尽，衣裘雨雪寒。\n非君重骚赋，之子枉游盘。\n挥手此为别，依然行路难。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9056,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"保定重别陈少参 其三","author":"屈大均","text":"返顾同黄鹄，将分恋玉杯。\n泪从今日堕，愁自故乡来。\n夫子且丝竹，中原尚草莱。\n梦中如识路，应向谢公台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9057,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将游五台宿繁峙客舍作","author":"屈大均","text":"文殊声色里，何处问仙灵。\n风涌滹沱壮，云含太戏青。\n浮生悲过雁，薄俗贱飘萍。\n不寐怀明发，疏钟起塞亭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9058,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"答李孔德","author":"屈大均","text":"浮云久失所，空忆洞庭阴。\n一叶惊秋早，微霜点鬓深。\n感甄劳玉枕，要列费清琴。\n君惠招辞好，魂归枫树林。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9059,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"留别陈正子","author":"屈大均","text":"塞北罢游猎，江南思采莲。\n高堂有书札，久废东皋田。\n别尔渔阳路，愁悬鸿雁边。\n临觞可无赠，只此白华篇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9060,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送麦生","author":"屈大均","text":"人生故乡好，亲戚使情多。\n常叹远游者，无如山水何。\n君归毕婚嫁，莫即浮沧波。\n往日陶彭泽，田园事匪他。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9061,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"九日集陈大夫署中","author":"屈大均","text":"落叶将蝉去，浮云逐雁来。\n可怜出塞客，不上望乡台。\n贾屋悬歌席，滹沱泻酒杯。\n佳晨同戏马，聊倚宋公才。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9062,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠李武曾灌园","author":"屈大均","text":"平生慕农圃，之子在丘园。\n为母艺花竹，岁寒无与言。\n人烟不出谷，古木自成村。\n兄弟桔槔举，一溪流到门。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9063,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"真定道中 其一","author":"屈大均","text":"秋色晚苍苍，驱车过太行。\n千山盘上党，万木落渔阳。\n结客黄金少，投人白璧伤。\n男儿羞血战，谈笑报君王。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9064,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"真定道中 其二","author":"屈大均","text":"饮马浊漳流，茫茫去国愁。\n沙阴迷雉堞，草色暗狼沟。\n博浪千金尽，淮阴一饭留。\n谁怜飘泊苦，忍死为神州。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9065,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"豫让桥","author":"屈大均","text":"国士感知己，能将七尺轻。\n击衣譬已报，吞炭气难平。\n漳水西风急，邢台落日晴。\n千秋石桥上，过客马犹惊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9066,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"永平","author":"屈大均","text":"碣石悬天柱，卢龙接北庭。\n海吞滦漆白，山拥蓟辽青。\n古塞燕王筑，雄关汉将扃。\n威名思李广，猿臂障朝廷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9067,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠汪子苕文 其一","author":"屈大均","text":"梁鸿慕游札，昔向姑苏台。\n岂意延陵子，今逢蓟北来。\n为君奏风雅，是日陈樽罍。\n曲半新声变，宫商待尔裁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9068,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠汪子苕文 其二","author":"屈大均","text":"君问罗浮里，仙灵事若何。\n须知蝴蝶大，更是梅花多。\n时有麻姑客，纷从翠羽过。\n峰峦胜庐岳，四百玉嵯峨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9069,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"别蒲城王子","author":"屈大均","text":"思家珠海月，望母白登台。\n此去随南雁，明春见早梅。\n折贻金粟客，一汎索郎杯。\n莫令欢娱少，行歌太华来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9070,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"首山","author":"屈大均","text":"叠巘华山北，连峰蒲坂东。\n巨灵挥斧凿，黄帝采金铜。\n翠障三边尽，洪流九曲通。\n茫茫天下脊，形势为谁雄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9071,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"三原题杜子草堂","author":"屈大均","text":"从君来谷口，日夕赋閒居。\n田傍池阳薮，门临郑国渠。\n峰高先积雪，花落细沾书。\n太华劳相导，游仙驾鹿车。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9072,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"答王六惠葛巾","author":"屈大均","text":"叔夜能含垢，科头已有年。\n飞蓬悲发乱，堕马愧妆妍。\n劳子裁云葛，为巾象岳莲。\n醉来休倒著，珍重竹林前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9073,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送曾庭闻返宁夏","author":"屈大均","text":"宁夏推雄镇，咽喉花马池。\n膏腴鱼米地，灌溉汉唐陂。\n尔爱贺兰翠，家临河水湄。\n功名边上好，莫即叹流离。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9074,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"留别钱舍人","author":"屈大均","text":"万里庭闱在，言归涨海隅。\n谁能弃乡井，自此作屠沽。\n京雒辞知己，关山命仆夫。\n从客君退食，书札问慈乌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9075,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"日食","author":"屈大均","text":"端阳逢日食，惨澹蓟门边。\n黑水无全地，黄云有半天。\n鲁阳戈尚在，羲仲御应旋。\n万里蒲甘国，龙旗正倒悬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9076,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送鲁人刘六茹入华山兼寄彭范二道者","author":"屈大均","text":"鲁国何男子，夷齐尚不希。\n昔当猛虎步，今叩老龙扉。\n日观辞沧海，莲花揽翠微。\n华阴双隐者，萝薜好同衣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9077,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"张二丈为予画支公养马图","author":"屈大均","text":"支遁怜神骏，今朝得紫骝。\n风沙生素练，剪拂向高秋。\n牢落千金骨，苍茫万里侯。\n含毫何惨淡，怜尔在林丘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9078,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠毗陵毛子 其一","author":"屈大均","text":"总角逢君日，羊城正卜居。\n心摧哀痛诏，泪洒治安书。\n仓卒贻兰草，飘零断鲤鱼。\n时闻骚些曲，沅上吊三闾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9079,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠毗陵毛子 其二","author":"屈大均","text":"我爱吴音好，悠扬国士风。\n美人怀别鹤，清夜拂焦桐。\n月迥秋河失，花深镜水通。\n天风吹不散，一曲彩云中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9080,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠毗陵毛子 其三","author":"屈大均","text":"客心如顾兔，长在月中生。\n只影赊春带，繁声恨宝筝。\n骅骝虚朔漠，蟋蟀满秋城。\n芜绝寻君梦，连宵到柳营。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9081,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠二张太史","author":"屈大均","text":"之子生京口，金焦秀色多。\n文章若江水，万里下岷峨。\n日月趋丹禁，双双鸣玉珂。\n弟兄皆早达，花萼共婆娑。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9082,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠别楚客","author":"屈大均","text":"相逢蓟门月，如入洞庭秋。\n楚客多奇服，湘娥善暮愁。\n平生慕宗国，亦既适荆州。\n岂意狂歌客，偏从燕地求。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9083,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"慰刘六茹病","author":"屈大均","text":"吾道宜多病，栖迟及暮年。\n同心沟壑尽，受命雪霜偏。\n山色寒当户，河声远上天。\n祗应娥月好，长抱客星眠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9084,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠某大司马 其一","author":"屈大均","text":"鸾皇止阿阁，鰋鲤出清川。\n夫子衮衣日，而多白屋贤。\n从容命词赋，顾盻生云烟。\n未忍罗浮去，徘徊玉麈前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9085,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠某大司马 其二","author":"屈大均","text":"一代持风雅，宗臣道自优。\n离骚多讽谏，比兴即春秋。\n空翠浮槎落，微茫淝水流。\n后生师典则，不向杜陵求。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9086,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠某大司马 其三","author":"屈大均","text":"汉代才华合，西京乐府开。\n人传大司马，诗冠柏梁台。\n我有朱弦曲，思陈清庙来。\n楚声俄变乱，挟瑟待公裁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9087,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送赵生就婚庆阳","author":"屈大均","text":"羔雁经河岳，威仪尔敬兹。\n先生桑梓地，君子瑟琴时。\n祖德同瓜瓞，天休是兔丝。\n兢兢秦士会，莫忘述昏诗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9088,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"高奴客舍作","author":"屈大均","text":"今夜宿高奴，天寒尊酒无。\n风惊闻堕雁，月出见吹箛。\n紫塞难障汉，黄河不限胡。\n千秋无定水，呜咽为扶苏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9089,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"别王十二杜五之作","author":"屈大均","text":"万里为兄弟，交情岂偶然。\n欢娱曾几日，契阔又穷边。\n紫阁悬斜照，樊川起暮烟。\n离忧尝似醉，不必酒杯传。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9090,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"流曲访张孝廉文谷","author":"屈大均","text":"一代遗民在，平生海岳求。\n同心漆沮客，招手荆山楼。\n黄帝鼎边月，武皇祠畔秋。\n秦人怀白露，应问此河洲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9091,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"泾阳访王大春","author":"屈大均","text":"之子复何事，泾阳方灌园。\n三峰开瓠口，二水出寒门。\n薇蕨先公节，桑麻郑子村。\n相过秋色好，清绝似仙源。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9092,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"携姬游华山赋赠","author":"屈大均","text":"谁知玉井里，亦复有鸳鸯。\n玉女洗头罢，莲花无数香。\n更怜毛女好，于此素琴张。\n风捲水帘雪，愁卿罗袂凉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9093,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"渡渭","author":"屈大均","text":"秦川涵帝泽，渭水像天河。\n襟带雄三辅，朝宗鼓大波。\n含泾清自在，宜黍力偏多。\n有客扁舟渡，苍茫发棹歌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9094,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送吴子归河中","author":"屈大均","text":"昔年上泰华，遥望薰风台。\n一片苍梧恨，茫茫天外来。\n君今蒲坂去，门对首阳开。\n并向夷齐墓，松间扫绿苔。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9095,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"怀悬公","author":"屈大均","text":"闻尔莲花客，新栖铜井山。\n飞泉为玉麈，明月满松?。\n戎马时方急，罗浮我欲还。\n相思蓬海隔，流泪损朱颜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9096,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"望三涂","author":"屈大均","text":"壁立如天阙，三涂险在前。\n陆浑云晻暧，伊水雪潺湲。\n逐兔过双涧，弯弓落一鞭。\n当时辛有泪，沾洒为东迁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9097,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"挽王安生 其一","author":"屈大均","text":"雄臣驰骛日，慷慨咏扶风。\n赴节人谁力，谋军尔匪躬。\n千笳沉白帝，一矢落冥鸿。\n遂使王孙草，迷离朔漠东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9098,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"挽王安生 其二","author":"屈大均","text":"飘零军祭酒，老向雁门营。\n北海羝难语，南枝鹊易惊。\n鲁连无玉貌，辅嗣有金声。\n潦倒笙歌里，何知后世名。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9099,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"挽王安生 其三","author":"屈大均","text":"寿命非金石，边州历苦辛。\n怜才多走卒，洒泪更羁臣。\n龙性驯何补，松枝脆有因。\n遗音幸不坠，骚雅与同伦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9100,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"河套 其一","author":"屈大均","text":"三面黄河阻，千群铁骑飞。\n受降城已没，白马将无归。\n风乱哀笳曲，霜生利剑威。\n赫连台上望，杀气接金微。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9101,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"河套 其二","author":"屈大均","text":"长城那足恃，绝壁彼能攀。\n卫卒虚分戍，边人苦卖关。\n贺兰天失险，花马地成閒。\n一片延绥草，谁寻白骨还。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9102,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"河套 其三","author":"屈大均","text":"草迷元昊国，山绕卫青城。\n海子黄云散，盐池皎月生。\n防秋稀宿将，媒卤尽游兵。\n坐使三秦困，边功竟不成。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9103,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"河套 其四","author":"屈大均","text":"一片长城暮，边声不可闻。\n羌儿秋月下，笳吹动成群。\n榆柳迷青海，牛羊下黑云。\n今年高太白，努力汉将军。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9104,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"河套 其五","author":"屈大均","text":"属国无三卫，中华有一墙。\n阉人分锁钥，债帅作金汤。\n地产边才少，天行劫运长。\n六骡殊未遁，出没在沙场。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9105,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"巢父墓","author":"屈大均","text":"却笑箕山客，幽光使帝知。\n至人无物累，天下有尧治。\n饮犊临清涧，悬瓢在上枝。\n高风何处溯，遗墓草离离。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9106,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"颍桥谒颍考叔祠墓作","author":"屈大均","text":"颍桥临颍谷，纯孝忆封人。\n绕墓慈乌夕，缘祠蔓草春。\n远游乖子职，明发愧天伦。\n菽水求无处，艰难万里身。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9107,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将从潞河南还赋别刘吏部","author":"屈大均","text":"平生在五岳，晚作京华游。\n欲共山公醉，竹林无处求。\n仙人隐声色，远思凝沧洲。\n送我兰桡去，情同河水流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9108,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"天津夜泊","author":"屈大均","text":"九河归帝甸，二海出天津。\n潮气凝风雨，灯光见鬼神。\n孤舟今夜冷，月明异乡亲。\n回忆承平日，笙歌两岸春。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9109,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄何子","author":"屈大均","text":"病里知秋早，凉风生鬓丝。\n梦随林叶落，心与海云迟。\n明月不长满，青山空有期。\n斜阳在南浦，每忆送君时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9110,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送杨职方使安南","author":"屈大均","text":"尔建相如节，宣威象郡中。\n从来神武策，不用羽林戎。\n早晚歌钟赐，西南战垒空。\n功名归使者，勒石伏波宫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9111,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送陈氏兄弟还清苑 其一","author":"屈大均","text":"送君桑梓路，蹀躞塞门霜。\n拒马河桥滑，飞狐磴道长。\n兰膏调夕膳，玉树发春堂。\n不共弹棋戏，相思殊未央。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9112,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送陈氏兄弟还清苑 其二","author":"屈大均","text":"平城挥手别，无计挽鸾镳。\n鸿雁三云隔，参商一水遥。\n趋庭过岳渎，戏赋入云霄。\n愁绝将军饯，铙歌合短箫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9113,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送陈氏兄弟还清苑 其三","author":"屈大均","text":"别绪萦春柳，离心逐玉鞭。\n黄云愁朔漠，白日惨幽燕。\n歌舞思凫藻，楼台惜绮钱。\n王孙招不远，望尔小山篇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9114,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送陈氏兄弟还清苑 其四","author":"屈大均","text":"凫雁怀梁藻，松杉爱菟丝。\n壶觞心贶后，歌舞目成时。\n雨过平川入，云来垒嶂移。\n晨葩侔处子，采撷得连枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9115,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"咏唐晋王","author":"屈大均","text":"当年频请讨，知罪总春秋。\n谁忍窥神器，惟知壮帝猷。\n英雄多汗马，王霸有箕裘。\n憔悴宫边柳，烟含五代秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9116,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寿榆林赵侯 其一","author":"屈大均","text":"旗偃黄花岭，笳沉白草沟。\n武安勤飨士，太尉暇登楼。\n霸气沙陀早，军声阴馆秋。\n无须黄老术，儒将自风流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9117,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寿榆林赵侯 其二","author":"屈大均","text":"幕府依严武，溪堂筑浣花。\n雄才惊不世，浪迹托为家。\n岳吐孤生竹，天含五色霞。\n年年持献寿，忠信是丹砂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9118,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"别阮亭 其一","author":"屈大均","text":"今代青云客，渔洋丽句多。\n芙蓉开晓日，鳷鹊漾金波。\n拥传扬州去，回鞭上苑过。\n玉钩斜畔月，水调奈君何。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9119,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"别阮亭 其二","author":"屈大均","text":"昔年寻白社，君赠庐山谣。\n以我栖禅寂，相思不见招。\n今来望宫阙，又欲返东樵。\n喜尔容台上，殷勤玉佩要。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9120,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"别阮亭 其三","author":"屈大均","text":"不堪人老大，种柳已成围。\n羽翼中朝少，埙数故国稀。\n微言及庄老，散带临芳菲。\n莫惜閒书札，雁门多雁飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9121,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]