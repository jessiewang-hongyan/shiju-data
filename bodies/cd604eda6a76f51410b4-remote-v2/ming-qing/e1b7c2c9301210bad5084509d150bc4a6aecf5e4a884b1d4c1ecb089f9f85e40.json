[{"title":"绿树","author":"屈大均","text":"江南芳树满，色似水波鲜。\n一半为杨柳，风吹绿涨天。\n长因新叶好，益念故花妍。\n黄鸟藏何处，声声总可怜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9785,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"秣陵张氏园看黄牡丹","author":"屈大均","text":"花亦有黄裳，移从上苑旁。\n枝枝新御气，叶叶旧天香。\n露滴成金液，风吹到玉觞。\n不须誇异种，此土本中央。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9786,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雪中送人入太湖作 其一","author":"屈大均","text":"采香泾太远，雪重压渔舟。\n暖欲洞庭去，晴先胥口留。\n梅花堪舍命，明月不容愁。\n一片湖山里，夷光更可求。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9787,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雪中送人入太湖作 其二","author":"屈大均","text":"春寒多水雪，光入镜中无。\n月上花潭薄，烟含竹屿孤。\n香知开万树，影尚隔重湖。\n白首须来往，人间此玉壶。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9788,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄怀王伯佐","author":"屈大均","text":"阴晋标双华，弘农会两河。\n关门春水阔，马首白云多。\n起舞当仙掌，归飞得凤窠。\n向来张饮地，哀乐奈君何。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9789,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题李箕山画","author":"屈大均","text":"汝画匡庐好，峰峰紫翠流。\n长疑三叠水，飞虬九屏秋。\n天与高人妙，神从太素求。\n烟云挥洒去，诗卷总丹丘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9790,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"别高氏兄弟 其一","author":"屈大均","text":"隋宫落日时，相见问新辞。\n爱我雷阳曲，风流似竹枝。\n月催连夕饮，花作一春期。\n芳草牵人去，茫茫失所思。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9791,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"别高氏兄弟 其二","author":"屈大均","text":"不知公子意，何以解离忧。\n自向江南去，长含江北愁。\n雪云连两岸，风叶满孤舟。\n亦有红桥好，踟蹰自不留。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9792,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"燕中春日作","author":"屈大均","text":"一雨消冰雪，春光万户开。\n金貂新子女，花柳旧楼台。\n长乐钟仍度，昭阳月复来。\n空馀御沟水，流恨到龙堆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9793,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"大都宫词 其一","author":"屈大均","text":"楚舞复吴歈，风流作帝图。\n阿房频止凤，太液复歌凫。\n小妓玉条脱，中官金仆姑。\n不知高力士，犹忆上皇无。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9794,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"大都宫词 其二","author":"屈大均","text":"暖殿开春宴，才人赐锦袍。\n舞低吴蛱蝶，歌倚郑樱桃。\n学士调花曲，阏氏按凤槽。\n只愁金漏短，日出未央高。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9795,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"大都宫词 其三","author":"屈大均","text":"具带盘龙锦，垂髾堕马妆。\n汉宫丹凤女，胡地白羊王。\n夜醉葡萄酒，朝开蹋鞠场。\n邯郸诸小妇，杂坐弄笙簧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9796,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"大都宫词 其四","author":"屈大均","text":"佳丽徵南国，中官锦字宣。\n紫宫双凤入，秘殿百花然。\n卓女方新寡，冯妃是小怜。\n更闻乔补阙，愁断绿珠篇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9797,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"大都宫词 其五","author":"屈大均","text":"白马饰金羁，琵琶再拨时。\n昔曾调玉树，今复妒蛾眉。\n纨扇秋终弃，兰台晚易悲。\n何如若耶女，采葛作黄丝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9798,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"大都宫词 其六","author":"屈大均","text":"朝来逢百骑，蹀躞御河堤。\n小队芙蓉簇，娇歌杨柳齐。\n锦装春菔艳，貂压翠鬟低。\n游猎知何去，阏氏在苑西。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9799,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠鲁山人","author":"屈大均","text":"羡君游海岳，缥缈羽衣轻。\n北斗斟元气，昆崙采玉英。\n千金若草芥，一笑成功名。\n谁似鲁连子，高风振赵城。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9800,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"别吴统持","author":"屈大均","text":"君平休弃世，市肆亦容身。\n黄老何须学，英雄自有神。\n云生长水白，花发曲台春。\n寂寞钩帘下，行吟念楚臣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9801,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"怀梅上人","author":"屈大均","text":"此日惟禅寂，干戈满海滨。\n悲欢能累道，贫贱易违亲。\n孤月先秋冷，群峰过雨新。\n一灯林壑夕，迟我作山邻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9802,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雪","author":"屈大均","text":"一时群籁寂，天地入鸿濛。\n万里瑶华落，寒光望欲穷。\n春传梅信早，夜入月明空。\n有客当楼坐，凄清洞壑中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9803,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过徐州作","author":"屈大均","text":"百战悲丰沛，群雄问草莱。\n斩蛇留大泽，戏马失高台。\n山向彭城出，云从泗水来。\n萧条王气尽，父老有馀哀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9804,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"柬戴生","author":"屈大均","text":"此日天涯意，艰难莫可论。\n死生惭往哲，贫病负中原。\n野月含霜冷，山泉带雨浑。\n只应返庐岳，鸾鹤自相存。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9805,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"黄河舟中作","author":"屈大均","text":"河流黄日月，万里客愁中。\n天入清霜苦，人过白草空。\n暮心生寂寞，春气破鸿濛。\n吾道宜沧海，乘桴孰可同。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9806,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟泊宿迁作","author":"屈大均","text":"月出黄河白，微茫带晚霞。\n一蓑同白鹭，双鬓似芦花。\n乱火归渔艇，寒云覆酒家。\n悲来思买醉，不忍赋怀沙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9807,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"邺城","author":"屈大均","text":"浩浩漳河水，迢迢魏武年。\n歌台馀蔓草，战垒没寒烟。\n兴废虽无定，奸雄自可怜。\n空令铜雀妓，留恨绮罗边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9808,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"保定客舍","author":"屈大均","text":"城楼吹角罢，归客逐斜阳。\n风急雕翎脱，冰坚马骨伤。\n通侯亡铁券，故将典银裆。\n握手天涯略，沾衣泪数行。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9809,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"鄗邑","author":"屈大均","text":"塞北三关没，江南四镇空。\n至尊频按剑，元老独临戎。\n龙起黄河雨，狐鸣白草风。\n千秋台岋嵘，回首鄗城东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9810,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过晋太尉刘琨墓","author":"屈大均","text":"扶风歌未罢，国势日仓皇。\n辛苦卢从事，相依在晋阳。\n笳吹边地草，月满戍楼霜。\n遗墓东安县，萧萧遍白杨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9811,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟次河西务","author":"屈大均","text":"千里桑乾水，分流至直沽。\n日黄含朔气，潮白没平芜。\n井邑归龙户，楼船指帝都。\n东南频转饷，犹自缺军需。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9812,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"谒文丞相祠","author":"屈大均","text":"萧条柴市口，就义忆先贤。\n碧血归无地，丹心痛入天。\n武侯师未捷，箕子道空传。\n终古宗臣泪，斜阳麦秀边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9813,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"玉熙宫","author":"屈大均","text":"玉熙宫里月，几夕照龙颜。\n过锦陈春戏，回风无白鹇。\n愁从河内乱，不见至尊閒。\n流落龟年在，相逢两鬓斑。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9814,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"哭剑","author":"屈大均","text":"七宝雌雄剑，先皇掌上飞。\n当时刃公主，血溅翠云衣。\n入地雷霆郁，冲霄日月辉。\n应同周驸马，化作两龙归。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9815,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"西苑","author":"屈大均","text":"芳湖荷芰满，旧映洗妆楼。\n夜月迷辽后，秋风失御舟。\n管弦无盛事，花草有深愁。\n落尽行人泪，兴亡总一丘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9816,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"经巩华城","author":"屈大均","text":"秋风鞍马苦，独过巩华城。\n龙瓦飞空殿，雕旗折大营。\n奚儿弯石弩，赵女割银筝。\n讵念良家子，凄凉出塞情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9817,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"铜马门","author":"屈大均","text":"铜马门前望，风沙惨不开。\n昭王无旧墓，郭隗有荒台。\n断雁冲云去，妖狐渡水来。\n凄凉蒿里上，多少霸王才。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9818,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"塞上曲 其一","author":"屈大均","text":"汉垒卢龙固，燕城涿鹿雄。\n阵云横海黑，猎火照天红。\n大将披金甲，妖姬喂铁骢。\n控弦诸种落，强半是辽东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9819,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"塞上曲 其二","author":"屈大均","text":"八月渔阳外，凄凄塞草腓。\n满城炊白骨，几处捣寒衣。\n细雨连狐啸，惊风断雁飞。\n长安多戍妇，可复梦金微。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9820,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"塞上曲 其三","author":"屈大均","text":"亭障三边接，风沙万古愁。\n可怜辽海月，不作汉时秋。\n白草连天尽，黄河倒日流。\n受降城上望，空忆冠军侯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9821,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"塞上曲 其四","author":"屈大均","text":"滦河诸将士，十月少征袍。\n大雪僵花马，阴风折宝刀。\n水营朝浴铁，沙市夜巡槽。\n十载榆关战，谁知汗血劳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9822,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"塞上曲 其五","author":"屈大均","text":"万古燕云泪，千秋战伐场。\n黄河流不尽，白日到无光。\n杀气随风转，边声入夜长。\n轩辕台已没，何处望渔阳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9823,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"塞上曲 其六","author":"屈大均","text":"太行天下脊，万里翠微寒。\n日月相摩荡，龙蛇此郁盘。\n云横三晋暗，水落九河乾。\n亘古飞狐险，凭谁封一丸。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9824,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄沈阳剩惮师 其一","author":"屈大均","text":"驱马今何适，凄凉岁暮间。\n心悬青海月，泪洒铁门关。\n雪窖人应老，辽东鹤未还。\n近闻随部落，又徙贺兰山。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9825,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄沈阳剩惮师 其二","author":"屈大均","text":"汉家臣妾尽，馀尔牧羝人。\n自食天山雪，长怀上苑春。\n短书无雁寄，愁鬓带霜新。\n夜夜闻笳吹，因君泪满巾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9826,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"尸上人将出渝关赠之","author":"屈大均","text":"不及辽阳雁，乘风渡黑河。\n偏愁矰缴密，讵畏雪霜多。\n岁月愁中尽，沧桑梦里过。\n孤心寄明月，夜夜照蓬婆。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9827,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"吊袁督师","author":"屈大均","text":"袁公忠义在，堪比望诸君。\n百战肌肤尽，三年训练勤。\n凉州无大马，皮岛有骄军。\n一片愚臣恨，长悬紫塞云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9828,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送叶氏郎","author":"屈大均","text":"八尺渥洼骢，龙花染汗红。\n功名思塞北，豪俊结山东。\n巨麓秋云满，渔阳白日空。\n肯令班定远，燕颔独称雄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9829,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠某上人 其一","author":"屈大均","text":"世外交难得，如师洽素心。\n疏狂元有道，哀乐亦同音。\n野径通人小，禅枝宿鸟深。\n愿君如海月，长为照弹琴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9830,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠某上人 其二","author":"屈大均","text":"支遁山非买，深公莫笑人。\n禺阳新有主，帝子久无春。\n瀑布无馀说，明霞亦是尘。\n何时捐物役，鸾鹤与为邻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9831,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠某上人 其三","author":"屈大均","text":"且复怜神骏，何须戏季龙。\n图澄非正法，支氏亦真宗。\n麈尾悬河汉，狮声应鼓钟。\n风流馀逸少，相赏更云松。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9832,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠某上人 其四","author":"屈大均","text":"少师殊不义，留恨在岩阿。\n吾道先名教，斯人且啸歌。\n晓将云气散，春使鸟声多。\n麋鹿饶甘草，分人亦太和。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9833,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"壬戌人日前一日予得一子名之曰泰先是辛酉除夕有友人为予筮得泰谓必生子故以泰为名云 其一","author":"屈大均","text":"吉日先人日，熊罴堕地声。\n刚从正月长，泰作小时名。\n饮乳兼双母，分书止一兄。\n婚时须舞象，吾亦七旬成。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9834,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"壬戌人日前一日予得一子名之曰泰先是辛酉除夕有友人为予筮得泰谓必生子故以泰为名云 其二","author":"屈大均","text":"五十又三时，生儿是次儿。\n承先曾四子，为后且双支。\n道长欣逢泰，文明望作离。\n阿娘珠在腹，每觉媚生姿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9835,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春人曲","author":"屈大均","text":"春从江上至，先入美人心。\n笑是桃华好，愁惟绿草深。\n竹枝传旧怨，团扇写新吟。\n欲寄离居者，殷勤托翠禽。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9836,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟入陈村有作","author":"屈大均","text":"山光因雨发，林气得风清。\n啼鸟元无意，当春自有声。\n溪随花路远，云向水村明。\n一棹斜桥外，归时月已生。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9837,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"一冬","author":"屈大均","text":"一冬嫌太暖，春至乃微寒。\n雷未三阳发，冰先十月残。\n毡裘今岁贱，灯火昔年欢。\n岭海诛求尽，哀鸿末得安。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9838,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春日怀故园作","author":"屈大均","text":"春光生雨后，万象喜新晴。\n雾以南风盛，云含朔雪明。\n江干愁作客，谷口忆归耕。\n十亩无先业，终怀鸿鹄情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9839,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"发白","author":"屈大均","text":"发白愁儿女，情多愧圣贤。\n无成非事业，不病即神仙。\n孔雀沙为浴，梅花石作田。\n河清如可俟，坚卧更三年。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9840,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"喜白上人至","author":"屈大均","text":"春寒因有雨，冬暖竟无冰。\n天向炎方变，人愁毒气蒸。\n鹤来明月寺，花寄白云僧。\n二月山如锦，如何兴未乘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9841,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"林赤见以谷皮纸见赠予将以为衣赋诗志喜","author":"屈大均","text":"山中尊野服，谷纸亦宜人。\n吾粤多奇布，无如此更珍。\n染成黄栗色，裁称白华身。\n感子持相赠，轻寒及暮春。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9842,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春思","author":"屈大均","text":"毵毵西苑柳，拂水最多丝。\n岁岁嬉春节，风流不自持。\n无人犹独舞，有客正相思。\n欲折长条寄，天涯不可知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9843,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"黄鸟","author":"屈大均","text":"依依窗柳下，黄鸟解亲人。\n有意频催曙，无情亦怨春。\n髻沾红雨泾，衣染绿烟匀。\n绝似吾娇女，绵蛮语不真。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9844,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"闻人述鹿马山感赋","author":"屈大均","text":"如何龙凤穴，乃在贵妃园。\n君弑难书葬，臣亡莫报恩。\n三良为内使，二井自高原。\n杜宇声声血，行人久断魂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9845,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雉子 其一","author":"屈大均","text":"斑斑双雉子，一者白花男。\n并蒂蒲桃髻，连枝玳瑁簪。\n鹦哥悬綵架，荔子贮花篮。\n日夕供孩笑，兰饴祖母含。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9846,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雉子 其二","author":"屈大均","text":"兄妹生同月，堂前五见春。\n明年从外传，不日望成人。\n黎锦裁衣艳，洋珠作帽新。\n争花喧未已，呵喝忍教频。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9847,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雉子 其三","author":"屈大均","text":"三字经频教，童蒙正可求。\n聪明如有种，典籍即无忧。\n舐犊情虽切，闻鸡舞未休。\n及时完子女，鞭弭遍神州。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9848,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"移家返沙亭有作","author":"屈大均","text":"浮云亦有庐，归与老农居。\n半亩林塘外，三春风雨馀。\n将乘无事日，更读古人书。\n咫尺先公墓，松间且荷锄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9849,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送蒲衣子往潮阳有作","author":"屈大均","text":"越鸟无非翠，蛮花只是红。\n何需命兰械，更向海阳东。\n幸得园林接，方期啸咏同。\n殷勤为此别，归日及秋鸿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9850,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送客 其一","author":"屈大均","text":"君行驱匹马，梅岭踏梅红。\n望望无南雁，依依是北风。\n徘徊燕市上，慷慨酒人中。\n自许为鸿鹄，何时奋翼同。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":9851,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]