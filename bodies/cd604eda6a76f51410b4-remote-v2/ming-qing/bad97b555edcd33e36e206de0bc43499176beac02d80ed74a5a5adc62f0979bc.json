[{"title":"礼诵后作寄道侣","author":"陈子升","text":"十年伤白发，万虑息金经。\n春鸟鸣鱼梵，天花落草亭。\n高堂嗟见背，大块实劳形。\n为寄潮音去，宗风满塔铃。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4734,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"佛日东游答欧奏孚陈皖公","author":"陈子升","text":"西方传佛日，东去访仙山。\n五十未闻道，江湖稀闭关。\n苍烟奔急翼，霁景媚衰颜。\n君问逢迎意，方将乞大还。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4735,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"度龙川","author":"陈子升","text":"佗城游不得，孤棹上龙川。\n岂挟千金橐，而冲五岭烟。\n江风吹苦竹，津树咽新蝉。\n又策斑骓去，无诸海国边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4736,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"五日龙川舟中时文晖先归","author":"陈子升","text":"百里仍秦县，千秋忆楚臣。\n符开银艾小，粽裹绿荷新。\n乡土能无恋，愁思郁未伸。\n那堪观霸气，临水送归人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4737,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"困酒入诃林留宿自公房","author":"陈子升","text":"祇园甘露滴，使我宿酲消。\n独自留方丈，诸天不寂寥。\n行踪泥芳草，吟兴写芭蕉。\n已作逃禅客，无烦折简招。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4738,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"海幢寺阿字首座屡约相过未果作此简之","author":"陈子升","text":"隔江曾自度，长约渡江人。\n绝迹淹残雨，浮生阅仲春。\n钟吟清水泛，门迥白鸥邻。\n不到真空地，梨花月漫新。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4739,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"澹归大师自丹霞山至海幢寺有赠","author":"陈子升","text":"多君驻白足，结宇向丹霞。\n依树珠林矗，缘藤石径斜。\n閒摇下山策，方值泛源花。\n可念江城客，飘零似出家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4740,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"移居 其一","author":"陈子升","text":"携家似行脚，重卜佛山居。\n避寇图中策，呼童载旧书。\n春风开瓮牖，夏屋谢权舆。\n莫谓皆稠杂，萧萧竹影疏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4741,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"移居 其二","author":"陈子升","text":"怅别仙湖里，何期住佛山。\n乌衣离乱后，青琐市尘间。\n花鸟欺容膝，亲朋劝破颜。\n来逢脩禊日，觞咏且宜閒。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4742,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"与家明敬","author":"陈子升","text":"后于君学道，实是愧称兄。\n岩岫有同适，江湖嗟各行。\n殊勋閒料易，俗事偶谈清。\n何故疏踪迹，骑牛独到城。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4743,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄尹右民","author":"陈子升","text":"蝉鸣江稻熟，鹭食渚荷香。\n送客东官去，怀人夏昼长。\n高歌求伐木，不远得维桑。\n门内论公道，山公是弟行。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4744,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"七夕过李琬若希素兄弟斋中时有谈禄命者","author":"陈子升","text":"秋宵疏柳下，群坐见双星。\n独作江头月，浮来满户庭。\n候虫参语默，天爵测玄冥。\n莫论纷纭事，邻箫细可听。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4745,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"桐江方君及妻祝氏孝节诗","author":"陈子升","text":"七里严陵濑，三声旧断猿。\n成仁身后事，之死梦中魂。\n白日空军幕，青编美相门。\n南来一鸣雁，犹感鹡鸰原。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4746,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄谭公子","author":"陈子升","text":"南游无赠橐，君本是南金。\n自别过穷腊，相思作会吟。\n吟清卧薪骨，文细浣纱心。\n草屋稽山上，悬知春又深。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4747,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"佛日至端州","author":"陈子升","text":"疏钟岩畔发，孤棹峡中行。\n是岸西方到，兹辰大圣生。\n望农花雨急，问禁竹房清。\n旅食同僧乞，依稀舍卫城。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4748,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"戏赠山中长者","author":"陈子升","text":"往往山家语，多君善住山。\n券焚收责便，租散课耕閒。\n入酿蒸苍耳，迎人使白鹇。\n不知江水上，那遣辙鱼还。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4749,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"遥送孙无言自扬州还黄山","author":"陈子升","text":"维扬不久客，故里有黄山。\n厌听竹西唱，欲怡松际颜。\n鸾高方解啸，鹤在更知还。\n望以罗浮月，寥寥天地间。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4750,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雨中过离公房","author":"陈子升","text":"禅房高柳色，晴雨共依依。\n我到不知屡，所闻惟觉稀。\n堂邀云板食，炉烘水田衣。\n坐对烟郊晚，嗈嗈沙雁飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4751,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送人游西岳","author":"陈子升","text":"山色淡无尽，片云飞向西。\n身将落日上，背指秋旻低。\n我独未得往，三峰空有倪。\n因君寄清梦，寥绝问高栖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4752,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送吴熙申之潮州兼讯故将军吴葛如家予时有豫章之行","author":"陈子升","text":"江南芳草气，蒸作岭南云。\n更客江南久，相逢对夕曛。\n北风随落雁，西第忆将军。\n我亦东林去，山钟使尔闻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4753,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将之吴越留别亲友 其一","author":"陈子升","text":"童年随历宦，胜地祇谙名。\n记得山川遍，重为老大行。\n垂杨萦越岸，娇鸟入吴声。\n谁谓家乡远，逢人识父兄。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4754,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"将之吴越留别亲友 其二","author":"陈子升","text":"赭颜当别酒，不饮且先陈。\n衣食堪生我，妻孥暂托人。\n回肠千水曲，迎面众山新。\n肯厌一茅屋，端居养性真。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4755,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"发舟言怀 其一","author":"陈子升","text":"丛花三月重，百戏一村喧。\n静者那同俗，兹焉遂出门。\n路纡思逐鸟，吟断待呼猿。\n已得无穷意，当为别后言。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4756,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"发舟言怀 其二","author":"陈子升","text":"独自装瓢笠，还谁宠远行。\n人人嬉上巳，物物得由庚。\n话就官亭短，诗将客货轻。\n江风与山瀑，初作枕间声。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4757,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过飞来寺","author":"陈子升","text":"忽见飞来寺，去心还欲飞。\n前山青不已，孤鸟白初微。\n樯杪杂千树，帆阴封半扉。\n泠然于此过，风笛在渔矶。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4758,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟中示从侄孙寂珠上人","author":"陈子升","text":"儒业痛非时，沙门早愿归。\n为君持一杖，犹未著三衣。\n船卧宵中密，斋炊午后稀。\n远峰灵鹫色，只待兴如飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4759,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"泊樟树访屠梦破","author":"陈子升","text":"岸上话将续，橹声难久停。\n欲攀彭泽柳，一系楚江萍。\n灶隐朱砂暗，门开樟叶青。\n不嫌霜鬓老，秋晚许重经。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4760,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"宿栖贤寺","author":"陈子升","text":"听得万松声，如传五老迎。\n到门云旧识，释子晚经行。\n怪石云衣覆，虚寮夜瀑明。\n终期此禅寂，安用昔贤名。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4761,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"游万杉寺","author":"陈子升","text":"拄著茶枝杖，龙钟入万杉。\n石欹泉自咽，山午日教衔。\n竹箸挑中饭，棕鞋下半岩。\n老师浑坦率，眼见葛藤芟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4762,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寓南康东观赠章松樵道人","author":"陈子升","text":"东观同为客，南阳老鍊师。\n玉京遗草莽，庐岳借茅茨。\n泣鬼多将字，饶人半在棋。\n连朝沥酒出，鹤发仅如丝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4763,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"逢邓子敬讯郭天门先生家居有寄","author":"陈子升","text":"中丞归老处，一片洞庭秋。\n客至鄱湖上，湖光远近浮。\n天风吹鹤氅，海国忆龙舟。\n若有离骚作，知子赋远游。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4764,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"与彭海翼夜话","author":"陈子升","text":"旅夜众嚣息，与君谈便长。\n看诗双眼大，阅世二毛苍。\n帘洞垂深影，炉峰袅静香。\n我行思隐遁，休取贱名扬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4765,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过彭蠡湖","author":"陈子升","text":"禹迹停终古，湖光荡至今。\n涵云四天影，注瀑一山心。\n垂白浮孤棹，飞乌背远林。\n所思犹未见，渔唱夕烟深。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4766,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"望九华","author":"陈子升","text":"江南莲乍动，帆背二孤开。\n水气偏浮上，山光忽照来。\n地增人峭绝，云合路纡回。\n明到池阳郡，思君且上台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4767,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"石埭访姚六康明府","author":"陈子升","text":"白笴陂前路，长吟问玉人。\n琴堂时一望，雨霁九峰新。\n野寺弛官禁，江楼纳客身。\n还凭仙舄力，能使入山频。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4768,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"同毕牧生萧湘隐游万松庵","author":"陈子升","text":"城喧时得避，松为响飕飕。\n复与行吟接，因令旅思留。\n维新香火故，结夏石堂秋。\n看展华严礼，殊无一字酬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4769,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"逢沈从弱","author":"陈子升","text":"忆打渔阳鼓，风流自皖江。\n忽然清梦断，消息宝钟撞。\n夫子复解此，难将宿习降。\n相期鸾啸处，江阁对虚窗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4770,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"石埭昭明太子庙","author":"陈子升","text":"只在删诗后，斯文入选初。\n能收百家作，非但一朝书。\n山出菁华外，江流绮靡馀。\n何期向萧寺，野服拜仙储。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4771,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湾沚 其一","author":"陈子升","text":"江南山县里，不省是江南。\n野鸟啄亭木，狞龙胶石潭。\n照鱼松火猛，驱魃纸旗惭。\n今作投湾沚，心惟江月涵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4772,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湾沚 其二","author":"陈子升","text":"湾沚宣州地，水乡连众山。\n蝉嘶溪木上，虹饮岳湖间。\n带梦依垂钓，囊诗应榷关。\n偏宜远游兴，浩荡大江还。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4773,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"过句容作","author":"陈子升","text":"微凉初贴地，稍稍上行踪。\n远树漏人语，斜阳明句容。\n排门询葛令，宿店倚茅峰。\n明又催僮起，马头闻曙钟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4774,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"兰陵赠庄书采进士","author":"陈子升","text":"兰陵荀祭酒，绛帐马扶风。\n岂敢一日长，惟应千里同。\n吞沙龙嘴现，射日凤毛红。\n不忘行吟叟，弦歌或向东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4775,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠吕半隐常博","author":"陈子升","text":"巴江隐隐流，岂是浙江秋。\n君住湖山曲，峨嵋天际头。\n云松巢独鹤，沙屿过群鸥。\n千里论胶漆，真堪此处投。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4776,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"长兴大雄寺听吴仲徵弹琴","author":"陈子升","text":"古寺过从密，秋心不待言。\n鸣琴匣里出，歌凤指端翻。\n独作高阁啸，犹嫌邻磬喧。\n当携画溪上，弹向老梅根。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4777,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"同朱五瑞吉人兄弟游画溪","author":"陈子升","text":"君家兄弟好，邀我画溪游。\n一幅展松雪，几回来隐侯。\n停桡访高阁，过树俯清流。\n已得忘筌理，持竿何所求。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4778,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"客长兴时京口李司直自卞山买舟相寻","author":"陈子升","text":"浮萍各自飘，折简不烦招。\n知有五千字，来从丁卯桥。\n埋名已东郭，访古尚南朝。\n想借天人供，禅房慰寂寥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4779,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"铁如意","author":"陈子升","text":"新得铁如意，浑如来一朋。\n斜根芝贴石，耸脰鹤陪灯。\n只许频更仆，何须叩默僧。\n深冬还一捉，心解冷如冰。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4780,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"张友鸿司李招饮竹深书屋王衡之工部适自白下至","author":"陈子升","text":"华堂屏歌舞，深馆特邀余。\n馔倚商周鼎，杯参甲乙书。\n论心欢有素，赏句讶无初。\n更喜同声至，休令促膝疏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4781,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"旅馆折蜡梅花贻王衡之","author":"陈子升","text":"敬致王工部，孤心在蜡梅。\n虽然经折了，犹有未曾开。\n东莞牙香片，西洋蜜珀杯。\n不堪乡物奉，客思为君裁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4782,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"游穹窿山上真观闻施亮生尊师有岭南之行留此为赠","author":"陈子升","text":"真师请于帝，应世住穹窿。\n锁院凭雷掣，飞楼惹鹤翀。\n神形符字凸，鬼血剑花红。\n见说南行久，多应遇葛洪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4783,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"京口金山寺","author":"陈子升","text":"归逐赣船行，金山下且停。\n閒身无北顾，道味在中泠。\n雉堞分城出，鲸钟带浪听。\n家乡海珠寺，髣髴似宁馨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4784,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"金陵 其一","author":"陈子升","text":"六朝君莫问，千古并生愁。\n宫似咸阳创，江胜雒水流。\n鹓鸾何日散，芦苇飒然秋。\n独有秦淮月，时时照客舟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4785,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"金陵 其二","author":"陈子升","text":"往日南京事，閒时共尔论。\n江来千万派，城启十三门。\n剑佩留勋府，戎衣在寝园。\n兴亡看六代，何必远伤魂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4786,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"辛亥秋遇沈从弱于石埭遂往白门相期归路访其安庆家居兼取药地和尚近耗明年归舟经过乘风不及登岸为之怅然","author":"陈子升","text":"去岁曾相约，春江草阁中。\n拟闻清啸足，兼与老禅通。\n破浪浮扬子，看山失皖公。\n无由登彼岸，人世易西东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4787,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"归宗寺戒后与记汝阇黎夜话","author":"陈子升","text":"与师谈娓娓，浑不著绵藤。\n戒后身知贵，穷来愿解宏。\n春将枯树美，瀑似石崖崩。\n才觉抛儿戏，归鞍倚大乘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4788,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"开先寺留呈山鸣和尚","author":"陈子升","text":"招提经林麓，不觉过桥来。\n赑屃兼山负，虹蜺落涧开。\n衣摊春草染，杖发暝钟催。\n未敢酬言语，山阳有殷雷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4789,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"敷浅原","author":"陈子升","text":"别有深深意，舟行敷浅原。\n水通神禹智，山鉴谪仙言。\n火食参烟气，风衣燥雨痕。\n不因飘荡极，那解卧林园。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4790,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寿曾旅庵","author":"陈子升","text":"鼓枻过沧浪，看君正钓璜。\n参差分老少，一半共行藏。\n古意含灵寿，春风满豫章。\n请歌新乐府，惟采旧芝房。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4791,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"往还岭上皆值佛日","author":"陈子升","text":"佛日出梅关，踰年佛日还。\n有怀惟野老，如愿即乡山。\n衣逐缁流破，鞭垂白马閒。\n如何卢行者，归路发先斑。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4792,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"初发连州","author":"陈子升","text":"岁晏穷千里，心知恋本州。\n山川交楚粤，文藻忆韩刘。\n对雁方怀岳，看云却背楼。\n疏林晴可数，寒鸟不妨投。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4793,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"中宿峡","author":"陈子升","text":"舟过罕攀跻，幽奇事可稽。\n笛传黄帝子，环系白猿妻。\n古迹分明在，新松髣髴齐。\n老僧如久定，期宿此招提。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4794,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"江上","author":"陈子升","text":"水程天易晚，客思此逡巡。\n斜日铺江面，遥帆卸树身。\n休灯窥岸烧，息语会船邻。\n此去犹悬绝，离忧近楚人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4795,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"湟水舟中","author":"陈子升","text":"腊近客都归，吾游尚未几。\n楚萍催发迹，江雪溅行衣。\n山僻僧孤往，潭明鸟对飞。\n陶潜偶然出，毋乃为愁饥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4796,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送远斋上人北游","author":"陈子升","text":"了得南宗义，因人漫北行。\n衣藏珠自现，锡指雁新横。\n舌底将莲种，眉毫斗雪生。\n遥知直署客，休沐出都迎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4797,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄潘子","author":"陈子升","text":"南园旧诗社，潘子此翱翔。\n城树标吟出，渠花引步香。\n纵横轻白璧，谑浪倚红妆。\n傥问离居者，虫声满草堂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4798,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"夜潮","author":"陈子升","text":"维舟偶终日，不约肯重来。\n雁翅城边月，虎头门外雷。\n岸高渔火上，沙暗縠纹回。\n可是期神女，非关行雨台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4799,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]