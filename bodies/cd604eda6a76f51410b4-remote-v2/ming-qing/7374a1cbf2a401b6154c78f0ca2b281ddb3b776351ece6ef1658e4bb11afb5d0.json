[{"title":"和梅花百咏诗 其五 江梅","author":"王夫之","text":"横梢淅沥入船窗，低映棠桡乱雪淙。\n雁尽天南人未返，憎他带影一双双。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1849,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其六 溪梅","author":"王夫之","text":"香雾氤氲霭碧湾，流澌一夜送潺湲。\n低垂乱惹珠光溅，疑是疑非响佩环。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1850,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其七 岭梅","author":"王夫之","text":"藏春有坞贮轻融，直上千寻故御风。\n平甸下看烟漠漠，孤擎宝露出清空。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1851,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其八 野梅","author":"王夫之","text":"牧笛无心倚玉箫，青帘得意远兰桡。\n生憎杀景张功甫，浪与移栽向六桥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1852,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其九 忆梅","author":"王夫之","text":"先春不得待春阑，渺渺西洲欲见难。\n唯有梨花赊剩粉，黄昏烟雨殢人看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1853,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其十 梦梅","author":"王夫之","text":"湘簟凝凉菡萏开，幽香冷触幻春回。\n因缘漫向痴人说，只作当先及第猜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1854,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其十一 寻梅","author":"王夫之","text":"消息心知在别峰，南参烟水尚重重。\n溪云乍捲流泉细，一点香飘带影逢。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1855,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其十二 问梅","author":"王夫之","text":"不是桃源惘去津，知开知落也难真。\n南邻酒伴经旬饮，欲与商量恐过春。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1856,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其十三 探梅","author":"王夫之","text":"扳枝已见绿催新，敛萼犹疑粉未匀。\n子夜霜鸡惊晓起，逢迎不早怕花瞋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1857,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其十四 索梅","author":"王夫之","text":"楼头遥望识春生，雪径过从奈宿酲。\n闻说冻禽争采啄，何妨分我一杯羹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1858,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其十五 观梅","author":"王夫之","text":"脉脉从看为解颐，阳和一茧细抽丝。\n捐情似水容相见，不许香车宝马窥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1859,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其十六 赏梅","author":"王夫之","text":"徵诗檄就隔林催，鹤膝猩毡渡水来。\n婪尾不须倾腊酒，瓮头还有煮青醅。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1860,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其十七 友梅","author":"王夫之","text":"大夫已见受秦封，君子还惊化鹤容。\n独抱冰心邀瑞叶，溪头三笑一相逢。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1861,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其十八 寄梅","author":"王夫之","text":"红尘日日促香乾，欲赠相思行路难。\n知到陇头春已尽，祗应将作柳枝看。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1862,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其十九 评梅","author":"王夫之","text":"绝色平分雪几曾，清香不怕月难胜。\n双标第一花卿品，莫遣姚黄妒汝能。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1863,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其二十 歌梅","author":"王夫之","text":"乍炙银笙试朔吹，旋抛珠串赛清姿。\n晓风残月伤心句，不待杨花扑岸时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1864,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其二十一 别梅","author":"王夫之","text":"离筵及早酌屠苏，留看镫宵待得无。\n知有前期霜信后，小窗人奈雪侵须。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1865,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其二十二 惜梅","author":"王夫之","text":"情知无计奈春何，水涘山椒玉一波。\n密筱藏阴香几瓣，还愁微霰祝暄和。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1866,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其二十三 折梅","author":"王夫之","text":"蹑藓墙东带笑披，暄风还向手中吹。\n閒情贪授寻春客，不管高枝怨别离。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1867,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其二十四 剪梅","author":"王夫之","text":"当窗妨绣凤头鞋，出閤惊捎小燕钗。\n拚取惜花情几许，并刀一割玉龙乖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1868,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其二十五 浴梅","author":"王夫之","text":"台上天花白㲲巾，戒香腊日洗尘尘。\n寒崖莫有三冬㬉，为现瞿昙四月身。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1869,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其二十六 浸梅","author":"王夫之","text":"清泉细点石硫黄，留得荀公几日香。\n蜡蒂涓涓升宿润，犹疑疏雨过银塘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1870,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其二十七 簪梅","author":"王夫之","text":"宜春燕子缕金花，抛掷偏拈紫玉芽。\n风味爱他林下好，妆成掬雪试烹茶。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1871,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其二十八 妆梅","author":"王夫之","text":"低回怕得近帘钩，宝髻当心五瓣收。\n萼绿华传新样子，吴娃错道牡丹头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1872,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其二十九 蟠梅","author":"王夫之","text":"藤捎蔓惹怕清狂，收拾闲心寸步香。\n向日迎风千笑合，来回无影过东墙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1873,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其三十 接梅","author":"王夫之","text":"裁素纫红半臂嵌，缝成知费手掺掺。\n新恩特赐加绯服，仍带银鱼旧日衔。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1874,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其三十一 谱梅","author":"王夫之","text":"乡国原标大庾南，飘零偶籍百花潭。\n宗支的的吴门隐，指李荒唐笑老聃。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1875,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其三十二 苔梅","author":"王夫之","text":"紫葆初含故叶稀，孤茎独秀绿茸肥。\n晴云润浥虬枝软，倒写溪光碧玉围。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1876,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其三十三 杏梅","author":"王夫之","text":"薄袂圆襟一式裁，骎骎旋接落英开。\n便娟为少新条绿，遥向日边掠彩来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1877,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其三十四 蜡梅","author":"王夫之","text":"弱粉难支雪色侵，檀痕相倚赖知音。\n连床各梦还同调，冻蝶迷香记浅深。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1878,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其三十五 竹梅","author":"王夫之","text":"妩媚檀栾共一时，鸭头新浴鹭飘丝。\n长疑剩粉归何处，密裹龙孙出箨枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1879,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其三十六 雪梅","author":"王夫之","text":"减取琼花一片开，五铢轻较六铢裁。\n亭亭小立雕楹外，白纻闲看舞袖回。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1880,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其三十七 月梅","author":"王夫之","text":"轻梢无叶出空微，弱片多惊定影非。\n碧海胧胧烟似水，清晖略带一分肥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1881,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其三十八 风梅","author":"王夫之","text":"云痕乍裂袅孤烟，薄媚东君试一暄。\n背水独摇香阵阵，芳心透过柳枝边。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1882,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其三十九 烟梅","author":"王夫之","text":"一片芳情悄自拘，未分明处不模糊。\n凭谁洗涤幽香魄，为倩绵山缟臆乌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1883,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其四十 孤梅","author":"王夫之","text":"空明碧瀁粉离离，寒鹊寻香远不迷。\n野渡问津人共指，重来犹记折残枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1884,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其四十一 移梅","author":"王夫之","text":"徼欢得向玉堂栽，油帟朱阑碧甃台。\n断岸当年生长地，春云如絮野棠开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1885,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其四十二 疏梅","author":"王夫之","text":"暮雨萧萧梦几忘，晨星落落意争狂。\n从教子结调羹用，不倚多金傲雒阳。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1886,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其四十三 老梅","author":"王夫之","text":"天涯迟暮岁寒心，浅着铅华远罩阴。\n消渴文园相待久，黄金为买白头吟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1887,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其四十四 新梅","author":"王夫之","text":"试雨禁风始出胎，根苗忘尽旧亭台。\n倡条冶叶轻前辈，庾信江南老自哀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1888,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其四十五 矮梅","author":"王夫之","text":"舞衣不浪费冰绡，仰笑垂杨衒楚腰。\n罗袜风生惊飏起，旋看缘带上头娇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1889,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其四十六 远梅","author":"王夫之","text":"邻院新栽叶未滋，窗前无分慰相思。\n逢人把过石桥去，借问攀从晓露时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1890,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其四十七 落梅","author":"王夫之","text":"乍㬉初催朵朵齐，蛟冰风捲画楼西。\n琉璃国土堪埋玉，不遣馀香上燕泥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1891,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其四十八 瘦梅","author":"王夫之","text":"断岸欹危挂古藤，红泉瑞露饱何曾。\n清羸百鸟衔来易，将供日中一食僧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1892,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其四十九 宫梅","author":"王夫之","text":"玉鳞遍覆软条青，合殿金铺尽日扃。\n唯有楼东人睡起，垆烟移远水晶瓶。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1893,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其五十 檐梅","author":"王夫之","text":"纤枝上与午烟齐，坠玉旁依乳雀栖。\n冰溜夜悬三百颗，双邀斜月漾玻瓈。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1894,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其五十一 寒梅","author":"王夫之","text":"生缘同在凅阴天，栗烈何因授记偏。\n为有临风观望客，迟迟春日拥黄绵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1895,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其五十二 咀梅","author":"王夫之","text":"闻说犹疑耳亦贪，终年不食更何堪。\n轻松脆软清泉味，池底夺将雪藕甘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1896,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其五十三 盆梅","author":"王夫之","text":"平塘梦断夕阳红，曲槛容遮五夜风。\n一点春愁分不去，当阶斜睨锦熏笼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1897,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其五十四 红梅","author":"王夫之","text":"对色疑非香不非，迎暄莫问素心违。\n光风灼灼传新喜，残雪全消散落晖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1898,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其五十五 粉梅","author":"王夫之","text":"从捐螺黛洗鸦黄，金母熏成姹女妆。\n色坏为铅难似此，凌风九转更欺霜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1899,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其五十六 青梅","author":"王夫之","text":"花事阑珊绿覆除，累累带雨更愁余。\n涛笺藉染胭脂色，聊寄江南一纸书。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1900,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其五十七 黄梅","author":"王夫之","text":"酿就莺醅已过春，日长还遣翠眉嚬。\n石家莫倚风狂味，霪雨新添妒妇津。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1901,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其五十八 盐梅","author":"王夫之","text":"鼎烹鼎食在逡巡，谁遣酸寒入梦真。\n滋味何如末下豉，秋风招隐啜湘莼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1902,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其五十九 千叶梅","author":"王夫之","text":"赊春无已索春添，簇簇新齐闹不嫌。\n狂瘦痴肥从肉眼，神清无事卖廉纤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1903,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其六十 鸳鸯梅","author":"王夫之","text":"青豆相思意偶通，开时疑说并头红。\n无端赚杀林和靖，三十六双一梦中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1904,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其六十一 绿萼梅","author":"王夫之","text":"叶色通梢晓气醒，趺香浮干艳心扃。\n单于莫怪胭脂失，汉月昏黄冢自青。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1905,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其六十二 胭脂梅","author":"王夫之","text":"红蓝染髓换霜肤，血滴灵芸凝玉壶。\n莫讶施朱教太赤，入时学得牡丹图。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1906,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其六十三 西湖梅","author":"王夫之","text":"缥渺芳情送画船，苏堤莫诧柳如烟。\n葑田捲尽琉璃现，此是开山白乐天。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1907,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其六十四 东阁梅","author":"王夫之","text":"香国扬州锦阵豪，诗情偏向峭寒高。\n都官吟后输声价，倾盖白头只水曹。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1908,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其六十五 清江梅","author":"王夫之","text":"沙明难辨几枝生，浪碧微看浅色轻。\n一疋练飞花样细，还从豆蔻夜熏成。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1909,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其六十六 孤山梅","author":"王夫之","text":"放鹤亭空客已仙，裙腰褪粉断桥边。\n广陵新送青娥怨，苦判馀芳作杜鹃。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1910,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其六十七 罗浮梅","author":"王夫之","text":"客路相逢散旅愁，桄桹月落海天悠。\n何当移向神山种，得共师雄赋白头。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1911,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其六十八 汉宫梅","author":"王夫之","text":"长门春锁万花深，纨扇无愁到玉林。\n记得虞渊官簿说，紫华紫叶结同心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1912,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其六十九 廨舍梅","author":"王夫之","text":"被拥黄紬晓睡醺，蜃窗晴送暗香闻。\n故山春色今何许，空署当轩五朵云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1913,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其七十 书窗梅","author":"王夫之","text":"檐牙折向纸镫龛，数蕊巡香漏已三。\n误捡秦风求故实，终南原只有条楠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1914,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其七十一 琴屋梅","author":"王夫之","text":"晴轩融敞静香传，器冷心闲好扣弦。\n一片低飞疑窃听，随风巧入郭公砖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1915,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其七十二 棋墅梅","author":"王夫之","text":"未了寻香又拂枰，冰绡遥映碧纱明。\n春前开亦随春落，先手何心百转争。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1916,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其七十三 钓湾梅","author":"王夫之","text":"小穗侵波曲罥钩，危根拿石细分流。\n羊裘垫卧收缗晚，争唼落英看白鸥。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1917,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其七十四 樵径梅","author":"王夫之","text":"谷口凝阴宿雪淹，槎枒望断白云尖。\n夜来野烧刚馀得，一树垂垂出短檐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1918,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其七十五 僧舍梅","author":"王夫之","text":"宝刹疑看珠雨飞，香烟幢影共霏微。\n雪山十九因缘熟，那但长留舍利衣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1919,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"和梅花百咏诗 其七十六 道院梅","author":"王夫之","text":"鹤径风回香细萦，仙衣长似御风轻。\n砂胎初剖银芽出，还恐流珠㬉易倾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":1920,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]