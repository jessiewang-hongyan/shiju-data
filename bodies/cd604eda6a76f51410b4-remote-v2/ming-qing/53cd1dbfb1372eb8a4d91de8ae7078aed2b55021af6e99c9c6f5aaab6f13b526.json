[{"title":"广州荔支词 其十五","author":"屈大均","text":"何来香似素馨花，生长花田越女家。\n汉使当年推第一，兼携抹丽向京华。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13420,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其十六","author":"屈大均","text":"愁来急泻青丝笼，欢至频开翠羽帘。\n中酒更须含绛雪，如花不用进红盐。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13421,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其十七","author":"屈大均","text":"日夕林中坐紫苔，一杯一颗荔枝开。\n天将汝作仙人禄，好断人间烟火来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13422,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其十八","author":"屈大均","text":"朱楼初日上窗纱，镜里妆成阴丽华。\n不用胭脂边地草，但调南国露头花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13423,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其十九","author":"屈大均","text":"罗衣乍解汗如珠，烛下光生白玉肤。\n更爱昭仪膏滑甚，兰房出浴不曾濡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13424,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其二十","author":"屈大均","text":"罗浮蝴蝶大如云，旧是麻姑五色裙。\n火齐竞餐仙树上，化为威凤影缤纷。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13425,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其二十一","author":"屈大均","text":"满山红翠教飞时，荔子低低拂水湄。\n红翠爱雏毛羽好，为巢不敢在高枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13426,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其二十二","author":"屈大均","text":"蝙蝠千年白雪同，一餐扶荔羽全红。\n双飞双宿芭蕉树，服可成仙似葛洪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13427,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其二十三","author":"屈大均","text":"雾縠轻衣著未曾，明珠新出玉壶冰。\n君看不是鲛人泪，日月精华一片凝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13428,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其二十四","author":"屈大均","text":"系马高楼日欲斜，笑攀琼树美人家。\n冰盘共载同心藕，翠袖兼携并蒂花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13429,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其二十五","author":"屈大均","text":"水上园亭向晓开，主人尝后鸟群来。\n多情不忍和枝折，留取芳阴在绿苔。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13430,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其二十六","author":"屈大均","text":"甘酸二味总宜人，髓滑兰香妙入神。\n烈日正中看尽熟，红如血珀媚卿唇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13431,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其二十七","author":"屈大均","text":"绛雪含滋不留齿，十分膏润可生津。\n朝来被酒清狂甚，一颗能成独醒人。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13432,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其二十八","author":"屈大均","text":"神农本草未曾知，绝代容华过岭迟。\n一自汉宫抉荔筑，尽惊南海有琼枝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13433,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其二十九","author":"屈大均","text":"辞汉金人去不回，帝思甘露万年杯。\n炎方幸有三珠树，剖出天桨进御来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13434,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其三十","author":"屈大均","text":"枝枝交荫钓鱼矶，翠鸟啾嘈食尽肥。\n雨桨溪边随意摘，露华偏湿美人衣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13435,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其三十一","author":"屈大均","text":"七月株株是火山，抛书往摘不曾閒。\n小华山子尤多汁，红绣鞋儿亦自弯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13436,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其三十二","author":"屈大均","text":"一本分来花岭头，年年留得殿清秋。\n天鸡未唤扶桑日，已有霞光照海楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13437,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其三十三","author":"屈大均","text":"蒲桃宫锦九天来，皇帝恩晖满越台。\n归汉自缘南海尉，至今春色上林开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13438,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其三十四","author":"屈大均","text":"正月花开香更清，酿为仙酒得长生。\n世人只解求丹实，真子先教采素英。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13439,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其三十五","author":"屈大均","text":"绝似含消御宿梨，冰鲜玉脆更多肌。\n丹心一点成焦核，抛掷泥中君不知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13440,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其三十六","author":"屈大均","text":"渔父酒船香复香，春酥卖罢更琼浆。\n我持兰棹过前浦，醉向榕阴纳晚凉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13441,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其三十七","author":"屈大均","text":"美人天上忆琅玕，生长南荒绝羽翰。\n路入白云迷子午，心随红日到长安。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13442,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其三十八","author":"屈大均","text":"甘溪水接菖蒲涧，南汉君王旧泛杯。\n岁岁红云张御宴，美人歌秦火珠来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13443,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其三十九","author":"屈大均","text":"一株高出少微家，膏叶当年覆翠华。\n一自端皇亲摘后，至今香烈胜群葩。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13444,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其四十","author":"屈大均","text":"初开芳汗湿微微，白白红红不染衣。\n委质玉盘思见食，葡萄石蜜似君稀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13445,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其四十一","author":"屈大均","text":"槛外已多鲜荔子，瓶中复有佛桑花。\n仙人好色无过此，两两朱颜伴鬓华。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13446,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其四十二","author":"屈大均","text":"一队红妆娘子军，英雄多在石榴裙。\n花田百里为汤沐，香国千年驻彩云。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13447,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其四十三","author":"屈大均","text":"五色穿将续命丝，珠娘笑掷与珠儿。\n兰桡相并沉香浦，好是龙舟竞渡时。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13448,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其四十四","author":"屈大均","text":"锦苞初擘露华红，掌上寒光映月空。\n玉女之浆不忍咽，当年太华事相同。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13449,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其四十五","author":"屈大均","text":"江南黑叶已称珍，玄墓杨梅敢与伦。\n塞外葡萄宜酿酒，燕中频果莫沾唇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13450,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其四十六","author":"屈大均","text":"五年不见水晶丸，今日酸时已饱餐。\n四月先红犀角子，故人分惠一冰盘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13451,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其四十七","author":"屈大均","text":"枝枝双结绛云阴，近蒂檀痕一点深。\n玉芝爱尔柔无骨，莲子怜他苦有心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13452,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其四十八","author":"屈大均","text":"露井寒泉百尺深，摘来经宿井中沉。\n日精化作月华冷，多食令人补太阴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13453,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其四十九","author":"屈大均","text":"三月桃花五月油，面脂香泽为谁求。\n荔支亦可娇颜色，无那佳人去凤楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13454,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其五十","author":"屈大均","text":"鸡鸣若木海先红，一片离支夜火同。\n露湿紫房晞不得，摘来天酒满杯中。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13455,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其五十一","author":"屈大均","text":"木兰不用充朝饮，零露瀼瀼满荔支。\n可惜骚人曾不见，流甘委素美如饴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13456,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其五十二","author":"屈大均","text":"日领花篮摘数千，高堂真是荔支仙。\n儿孙一一皆丫髻，绿核喧争满膝前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13457,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其五十三","author":"屈大均","text":"侍女笑斟玄碧酒，高堂注以荔支浆。\n令予醉后一嘘噏，水露化作酥醪香。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13458,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"广州荔支词 其五十四","author":"屈大均","text":"谁爱三闾橘颂辞，更将骚思写离支。\n曾含甘液方能赋，汉代风流有叔师。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13459,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"莲丝曲","author":"屈大均","text":"莲丝长与柳丝长，歧路缠绵恨未央。\n柳丝与郎系玉臂，莲丝与侬续断肠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13460,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"紫梗曲","author":"屈大均","text":"紫梗西从海外来，染衣红似石榴开。\n芳香更有扶留汁，不必胭脂上口来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13461,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"买鱼词 其一","author":"屈大均","text":"买鱼争唤向烟波，摇橹无如弱腕何。\n人好遂令鱼亦好，钱多不觉笑逾多。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13462,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"买鱼词 其二","author":"屈大均","text":"两日羚羊峡上居，鲥鱼下酒不曾虚。\n小姑鱼贵人偏买，用尽金钱为买鱼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13463,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梅","author":"屈大均","text":"咫尺梅关雪不来，梅花开罢腊梅开。\n炎州十月春如海，处处飞香半是梅。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13464,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"梅花","author":"屈大均","text":"梅花十月已开齐，日夕花间素手携。\n玉映无惭顾家妇，冰清真是楚狂妻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13465,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"采珠词 其一","author":"屈大均","text":"合浦秋清水不波，月中珠蚌晒珠多。\n光含白露生琼海，色似明霞接绛河。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13466,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"采珠词 其二","author":"屈大均","text":"中秋月满珠同满，吐纳清光一一开。\n明月本为珠作命，明珠元以月为胎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13467,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"采珠词 其三","author":"屈大均","text":"珠池千里水茫茫，蚌蛤秋来食月光。\n取水月中珠有孕，精华一片与天长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13468,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"采珠词 其四","author":"屈大均","text":"家家养得采珠儿，兼采珊瑚石上枝。\n珠母多生珠子树，海中攀折少人知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13469,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"采珠词 其五","author":"屈大均","text":"暮春争赛白龙池，挂席乘潮采不迟。\n千尺螺筐垂海底，翻波不使大鱼知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13470,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"采珠词 其六","author":"屈大均","text":"珠市西头近接城，客餐珠肉当琼英。\n廉州个个珠娘媚，祗为珠池水色清。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13471,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"东湖曲 其一","author":"屈大均","text":"东湖水接珊瑚洲，吏部开为万里流。\n高阳虽有酒池好，那得人人尽拍浮。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13472,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"东湖曲 其二","author":"屈大均","text":"虎门潮水与湖通，士女如山出镜中。\n香气皆为荷叶气，颜红尽似荔支红。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13473,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"东湖曲 其三","author":"屈大均","text":"天生一片素馨田，来作炎洲士女妍。\n多食荔支颜更好，楼船不隔碧纱烟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13474,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"东湖曲 其四","author":"屈大均","text":"处处龙舟金鼓来，兰桡桂楫沸如雷。\n东江水斗西江水，夺尽花红暮未回。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13475,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"东湖曲 其五","author":"屈大均","text":"堤畔青楼隐柳阴，笑声时与水云深。\n东家蝴蝶西家燕，飞入芙蓉不可寻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13476,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"东湖曲 其六","author":"屈大均","text":"船船尽挂宝镫来，万朵芙蓉火里开。\n明月满天照不入，光中人影乱楼台。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13477,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"东湖曲 其七","author":"屈大均","text":"善才三两弄蛮弦，水马如飞欲上天。\n羡杀金花倭帽客，夺标能得一婵娟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13478,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送张南士返越州因感旧游有作 其一","author":"屈大均","text":"可怜一片镜湖水，祗有西施一浣纱。\n千载芙蓉为谁发，君归好上钓鱼槎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13479,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送张南士返越州因感旧游有作 其二","author":"屈大均","text":"雪窦山人去几秋，弹琴东市亦风流。\n相思最是耶溪月，夜夜清光为我愁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13480,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送张南士返越州因感旧游有作 其三","author":"屈大均","text":"谈禅昔爱祁居士，咳唾天花落石床。\n自向花边见天女，至今不散梦魂香。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13481,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送张南士返越州因感旧游有作 其四","author":"屈大均","text":"云门一老未龙钟，七十能登秦望峰。\n一代遗民在禅寂，袈裟空挂六陵松。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13482,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送张南士返越州因感旧游有作 其五","author":"屈大均","text":"处处沙场吊鬼雄，故人多在国殇中。\n钱郎侠骨香犹在，谁葬要离古墓东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13483,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送张南士返越州因感旧游有作 其六","author":"屈大均","text":"怅望稽山宿草齐，故人墓在禹陵西。\n天生志士填沟壑，魂魄休为杜宇啼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13484,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送张南士返越州因感旧游有作 其七","author":"屈大均","text":"梅市西边秋山波，中丞怀石恨如何。\n公孙爱我三闾裔，岁晏相邀卧薜萝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13485,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送张南士返越州因感旧游有作 其八","author":"屈大均","text":"书台此日委寒烟，鸾鹤飘零各一天。\n君去落花应自扫，时时石上作春眠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13486,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送张南士返越州因感旧游有作 其九","author":"屈大均","text":"汝亦多才似叔师，南方朱实写离离。\n明年若在萧山县，莫把杨梅拟荔支。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13487,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送张南士返越州因感旧游有作 其十","author":"屈大均","text":"薄暮人人待月华，三城争买素馨花。\n珠儿更比珠娘好，莫向耶溪苦忆家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13488,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送张南士返越州因感旧游有作 其十一","author":"屈大均","text":"珠江江上尽花田，花似明珠彩缕穿。\n粤女将花围宝髻，风流不到陆郎前。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13489,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送张南士返越州因感旧游有作 其十二","author":"屈大均","text":"汝度梅关越两秋，乘桴几尽海南头。\n夜深欲见扶桑日，应上罗浮大石楼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13490,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送张南士返越州因感旧游有作 其十三","author":"屈大均","text":"英雄泪尽此刀环，我欲浮家镜水间。\n越女繇来天下白，凭君寄语苧萝山。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13491,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠厉子还西泠 其一","author":"屈大均","text":"长忆西湖歌采菱，六桥秋水涨渔罾。\n逢君急剪松江绢，乞写双峰烟雨凝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":13492,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]