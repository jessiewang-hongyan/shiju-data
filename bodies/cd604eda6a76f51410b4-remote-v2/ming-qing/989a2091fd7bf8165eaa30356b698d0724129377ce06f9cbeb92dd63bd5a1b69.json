[{"title":"苍梧扈驾谒兴陵","author":"陈子升","text":"旧邸瞻神庙，前旌指孝陵。\n松坛开虎拜，桂海溯龙兴。\n羽卫千官导，戎衣列圣凭。\n他时天子孝，文在泰山登。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4601,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉和瞿相公劳师全州见道上古松之作","author":"陈子升","text":"不掩将军树，言开召伯棠。\n苍梧生大道，偃盖复成行。\n积甲龙鳞见，投醪琥珀香。\n军心欢不已，声共舞风长。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4602,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"留别刘及叔兵部","author":"陈子升","text":"刘生为我别，何以写衔杯。\n一曲东平意，相如西蜀才。\n蒯缑悬锦水，花笔掩兰台。\n但断忧时泪，吟诗瘦莫哀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4603,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"夜度梅林","author":"陈子升","text":"即不疲行役，何方作逸民。\n风林摇入暮，沙水咽迷津。\n远灶翻刍狗，低篷仰杞人。\n江边如秃节，可共雁来宾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4604,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题朱子洁小舫","author":"陈子升","text":"五湖何处去，一叶且经营。\n犹可汎溪月，将子同濯缨。\n兰幽期绝迹，豆落怅归耕。\n倚棹或堪近，桃花鸡犬声。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4605,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赋得云中辨江树","author":"陈子升","text":"已极扶桑影，微依委杖林。\n因波闻脱叶，傥别即伤心。\n牛马虚秋水，猿猴隔楚吟。\n安知如荠外，不是八公寻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4606,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"述哀 其一","author":"陈子升","text":"心摧娲后石，泪尽蜀山鹃。\n自恨无容地，谁还共戴天。\n飞尘金齿路，沈日点苍烟。\n愿挽乌号射，欃枪会应弦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4607,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"述哀 其二","author":"陈子升","text":"黄竹歌残雪，苍梧泣断云。\n三年曾克鬼，诸□乃无□。\n逐日还何及，呼天竟不闻。\n定知图箓秘，哀痛为斯文。","collection":"明末清初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4608,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"述哀 其三","author":"陈子升","text":"列圣恒如在，孤臣尚苟生。\n生年从万历，往恨积崇祯。\n流落捐躯免，传闻洗耳惊。\n将来纪年月，良史正含情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4609,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"述哀 其四","author":"陈子升","text":"云沈六诏外，天远七盘西。\n不义为彭宠，休屠无日磾。\n难期大树赏，空使具茨迷。\n他日还钟簴，如何慰鼓鼙。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4610,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"村社饷予酒肉","author":"陈子升","text":"古树小桥幽，江村赛社秋。\n恒饥双稚喜，多病一杯酬。\n底事周人栗，贫时曲逆侯。\n摐金人语歇，天外暮云流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4611,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赋得花丛乱数蝶","author":"陈子升","text":"梅花与李花，相趁复相加。\n大都多粉色，子细认东家。\n绿窗春有梦，雕槛昼无哗。\n不堪垂手伎，烂漫舞茵斜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4612,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赋得风帘入双燕","author":"陈子升","text":"芳春荡晓风，双燕向帘栊。\n尔是新还旧，谁知雌与雄。\n振襟钩自上，拂尾剪俱空。\n似恨歌尘寂，金塘泥正融。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4613,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"送人之牂牁","author":"陈子升","text":"居人殊郁郁，送尔客何方。\n白露将秋色，青莲愁夜郎。\n沙分胡雁小，天合楚云长。\n为问牂牁水，楼船何渺茫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4614,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠景公峻兼讯陆参军骏如","author":"陈子升","text":"风月羁离际，论交二十年。\n吹箫还入市，取醉不忧天。\n鹿閟苏台迹，羊孤海峤仙。\n芙蓉峰四百，持照幕中莲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4615,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"招旧游","author":"陈子升","text":"游情向春鸟，鸟语在庭柯。\n我罢归欤叹，谁为劳者歌。\n青春将进酒，白日倩挥戈。\n何不还携手，高高藏绿萝。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4616,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"巫山之阳香溪之阴明妃神女旧迹存焉 其一","author":"陈子升","text":"碧峰连枕席，青冢隔烟萝。\n汉道寖微矣，荆王如梦何。\n遥知云色寡，夕想雨容多。\n欢怨皆芜没，回肠发浩歌。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4617,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"巫山之阳香溪之阴明妃神女旧迹存焉 其二","author":"陈子升","text":"阏氏留汉月，芳草藉巫云。\n清怨独和胡，微辞因奉君。\n溪萦香缥缈，台驻梦氤氲。\n不蹑风流迹，荒山空旧闻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4618,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"巫山之阳香溪之阴明妃神女旧迹存焉 其三","author":"陈子升","text":"楚汉风流事，千年迹并稀。\n巫云象神女，塞月照明妃。\n余欲登高赋，征人怨不归。\n清秋如有梦，应逐朔鸿飞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4619,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"艳诗","author":"陈子升","text":"南林苏合弹，西堰木兰舟。\n藻动文鱼戏，花飞艳妇愁。\n遥闻轻薄子，新拜富平侯。\n树背无萱草，飞蓬两鬓秋。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4620,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雨中即事简在城亲旧","author":"陈子升","text":"细雨滋何限，浮生澹不营。\n碧苞防露笋，红吐拒霜英。\n鹤发来扶杖，渔歌迥濯缨。\n轩车任流水，书此报寒城。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4621,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"石门吴刺史祠","author":"陈子升","text":"石门之水清，刺史昔年情。\n日照龙骧节，风高雁翅城。\n江河遮贝阙，俎豆出芹羹。\n极浦香沈尽，西山薇欲生。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4622,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"展观朱仲韶所画梅花作诗寄怀","author":"陈子升","text":"梅花开棐案，岭路未曾知。\n偏是南州士，孤芳劳我思。\n青山无半亩，白眼亦多时。\n君解轩辕历，崆峒何处期。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4623,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄徐巨海","author":"陈子升","text":"南州徐孺子，高卧有青山。\n往日蒲轮弊，穷年桂树攀。\n溟鱼不得运，雾豹迥无斑。\n却望罗浮色，知予亦闭关。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4624,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄陈元水","author":"陈子升","text":"吴王苑边客，憔悴豫章江。\n伊昔宰百里，踌躇之一邦。\n新篇寄金错，旧恨剪兰釭。\n赭白吾将尔，骄时各自降。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4625,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄蒋南陔先生","author":"陈子升","text":"南海神明宰，归吴赋五噫。\n内廷虽一召，末路叹多歧。\n小子亦鸿渐，终焉同凤衰。\n因声寄丹穴，雏羽日威仪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4626,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄徐子能","author":"陈子升","text":"美人家何处，百尺姑苏台。\n麋鹿游今日，龙威书几开。\n迷离天末客，放浪湖上杯。\n遥知二毛落，秋兴倍从来。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4627,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"游中宿望西樵怀家园所钦","author":"陈子升","text":"出户辞容膝，征途重久要。\n吟空峡猿夜，梦变楚云朝。\n中宿将三宿，西樵非两樵。\n沿江新柳色，回首见攀条。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4628,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"灌园","author":"陈子升","text":"磬折君勿嗤，为园勤注兹。\n民生不匮事，草木向荣时。\n子月馀清浅，仙源动碧滋。\n淮南洵汲井，鍊药更何为。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4629,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雨中弹琴作","author":"陈子升","text":"飞雨洒檐轻，轻弦逗雨鸣。\n器泠因得法，心语欲无声。\n水泛中郎弄，风将列子行。\n徐收玳瑁匣，还见峄峰晴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4630,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"岁暮过海幢寺谒空隐禅师寄薛二","author":"陈子升","text":"渡江寻净域，了自不关人。\n息影入中岁，生烟开早春。\n启扉无一语，踧踖愁书绅。\n归对同门友，溪风萌绿萍。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4631,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄一灵上人","author":"陈子升","text":"中洲千嶂月，何处一龛灯。\n独坐旷无侣，高吟遥对僧。\n别来云共水，空外谷为陵。\n待发秋江棹，松门最上层。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4632,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"卜筑","author":"陈子升","text":"九江村色明，三径欲经营。\n最喜池塘遍，圆波连月生。\n此中有桑竹，无以异蓬瀛。\n谁信扶摇翼，而甘择木情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4633,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"江村","author":"陈子升","text":"昔游九江郡，今寄九江村。\n禹迹复何处，佗城非故园。\n乡关生死泪，亲旧岁时论。\n那得深山入，西风吹暮猿。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4634,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题乡事寄静者","author":"陈子升","text":"俗尚吾何羡，乡情君莫嘲。\n鱼花千里舸，鸡菜万家庖。\n竞渡黄头出，柔桑皓腕交。\n惟馀读书客，高卧静衡茅。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4635,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"山寺听蝉","author":"陈子升","text":"偶同高士出，一路听蝉嘶。\n雅尚宜秋露，何心怜夏畦。\n晚风清梵外，茂树翠微西。\n复此令人远，依依飞鸟栖。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4636,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"奉题欧先生南圃","author":"陈子升","text":"南圃人安节，东篱菊吐英。\n苍凉开画色，閒暇读书声。\n远水浮秦树，斜阳澹汉城。\n所欣吟月下，一傍古松行。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4637,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"题朱子茂茅亭新成","author":"陈子升","text":"中表过从好，巢居又一枝。\n金鳞云锦烂，玉树月华披。\n坐即频呼酒，行应为采芝。\n不逢尧与舜，安敢望茅茨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4638,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"濠上逢旧妓","author":"陈子升","text":"骄马几时迎，桃根艳柳营。\n半生重入梦，两度总倾城。\n日澹青楼色，笳悲子夜声。\n藁砧何可道，山上若为情。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4639,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"大历琴","author":"陈子升","text":"端居珍所尚，三叹少知音。\n不遇丁年友，那称大历琴。\n徽明千古月，匣向万山岑。\n最是同閒止，商歌入旧林。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4640,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"家无长物琴砚特佳聊为之咏","author":"陈子升","text":"紫云鸲鹆砚，绿绮凤凰琴。\n静者亦何有，兹焉朋盍簪。\n诗书敦宿好，山水有清音。\n欲解无弦趣，惟操匪石心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4641,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"城中寄怀某郎","author":"陈子升","text":"想子中洲夜，月斜春帐深。\n新蛙乱欹枕，起坐空横琴。\n予实同栖鸟，飞翔惟近林。\n春潮日来往，因信平生心。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4642,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"英石砚山","author":"陈子升","text":"英州小小石，宛似文君眉。\n一抹不加画，千峰何处移。\n白云侵半岭，清海或环之。\n紫砚琉璃匣，缘情赠汝诗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4643,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"朱子勷赠予墨拓瘗鹤铭喜赋","author":"陈子升","text":"何代华阳逸，遗音瘗鹤铭。\n胎禽漠然化，腕兔若为灵。\n势挟云螭驾，图分山海经。\n羽仙将墨客，无不掞天庭。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4644,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"赠陶大","author":"陈子升","text":"君家原五柳，知不重千金。\n结客非游宦，移居为入林。\n天风双袖阔，花雨一帘深。\n长向东方倩，高歌度陆沈。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4645,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"寄旧游二三诸公","author":"陈子升","text":"岁晏沧江雨，空濛一望君。\n校书犹马队，临帖几鹅群。\n白雪从歌聚，青帘引袂分。\n王通归老处，知是恋河汾。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4646,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"舟夜闻雁","author":"陈子升","text":"春雁不宿渚，夜飞鸣向舟。\n三江惊始旦，二月重南游。\n且复韬羽翼，谁能忘匹俦。\n溯洄将倩尔，明发见中洲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4647,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"用乐府题作唐体十二首 其一 有所思","author":"陈子升","text":"贱妾对流萤，良人备北庭。\n金闺淹日月，沙碛动风霆。\n去梦萦蛛网，归书暗雁翎。\n君恩治第否，天末不遑宁。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4648,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"用乐府题作唐体十二首 其二 关山月","author":"陈子升","text":"边月散边霜，长城月正长。\n狼烟虚远色，驿火断寒光。\n北照惟依斗，南临一望乡。\n营门钲鼓静，昨夜遁贤王。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4649,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"用乐府题作唐体十二首 其三 紫骝马","author":"陈子升","text":"国事勤玄塞，将军跃紫骝。\n都门一发迹，千里去悠悠。\n大漠风多逆，长城水不流。\n功成何用赏，骨立视封侯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4650,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"用乐府题作唐体十二首 其四 刘生","author":"陈子升","text":"卿家赤帝后，走马黄云间。\n独入咸阳市，报雠时度关。\n愁将边月远，卧对酒垆閒。\n傲尽王公席，青春抚绿鬟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4651,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"用乐府题作唐体十二首 其五 折杨柳","author":"陈子升","text":"离情相送送，大道夹垂杨。\n千里从兹远，一枝空折将。\n结为腰带缓，吹与鬓丝长。\n何必闻羌篴，方知断客肠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4652,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"用乐府题作唐体十二首 其六 梅花落","author":"陈子升","text":"陇右五歧路，梅花寒并飘。\n春风上冰雪，人迹澹溪桥。\n白破胡天晓，香分庾岭遥。\n谁知金屋里，坐使玉容销。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4653,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"用乐府题作唐体十二首 其七 从军乐","author":"陈子升","text":"南征忘苦辛，百万出咸秦。\n破竹看崩角，分茅掩沸唇。\n箭穿无石虎，车载有金人。\n遂使光天下，皆称率土臣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4654,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"用乐府题作唐体十二首 其八 明妃怨","author":"陈子升","text":"物色归骄虏，蛾眉镇独颦。\n迁延上马地，决绝贯鱼人。\n觱篥风相切，琵琶语不真。\n君王有飞将，妾是玉关尘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4655,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"用乐府题作唐体十二首 其九 古意","author":"陈子升","text":"玉匣鸣琴出，繇来是爨桐。\n中含太古意，侧想先生风。\n抚罢不成操，知音人已空。\n滔滔流水去，悽绝对仙宫。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4656,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"用乐府题作唐体十二首 其十 难忘曲","author":"陈子升","text":"花径入檀郎，君家不可忘。\n交精飞过水，反舌唤登墙。\n南国明珠佩，东家白玉床。\n微躯何所托，端在婉清扬。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4657,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"用乐府题作唐体十二首 其十一 关陇吟","author":"陈子升","text":"秦地双崤阻，周王八骏雄。\n水流巴子国，山压隗嚣宫。\n榆细森关月，梅春袅笛风。\n寄言被褐者，相助守山东。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4658,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"用乐府题作唐体十二首 其十二 长安道","author":"陈子升","text":"古树咸原色，繁华大道春。\n长风与流水，翠粲复龙鳞。\n狐白逢公子，鸦黄见美人。\n萧条道旁客，叹息经情亲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4659,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"上巳海目山禊饮 其一","author":"陈子升","text":"羽觞何处流，飞渡羽人丘。\n斗酒黄莺语，山枝青翰舟。\n春丛烟雾气，波荡古今愁。\n楚水长相接，言归芳杜洲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4660,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"上巳海目山禊饮 其二","author":"陈子升","text":"海目更长望，珠江云水连。\n因仍京洛事，飘泊楚人船。\n细雨滋平仲，春风愁杜鹃。\n当杯酣上巳，何必问丁年。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4661,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"种柳","author":"陈子升","text":"池水如明镜，杨枝是细腰。\n宅边宜有此，花外不堪飘。\n昔在长杨苑，因风拂灞桥。\n桥西几攀折，今日抚柔条。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4662,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"无题 其一","author":"陈子升","text":"桃李自成蹊，媻姗并上堤。\n秦宫花底活，周史月边迷。\n乐府能传凤，天河恨报鸡。\n因君逢嫁娶，端是不须啼。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4663,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"无题 其二","author":"陈子升","text":"不矜交甫佩，不羡莫愁堂。\n死认罗浮树，生怜西国香。\n老来将药却，忧至倩萱忘。\n定有龟台使，馀桃泥汉皇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4664,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"纸帐","author":"陈子升","text":"素丝缝侧理，兹帐息深深。\n一榻何高卧，洞房非此心。\n云封虚白室，月在梅花林。\n个里雕龙思，天孙无自寻。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4665,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"春日与薛刚生期于崔千上江馆崔子谷在焉因并留赠","author":"陈子升","text":"门前杨柳色，日日向通津。\n一水过春雨，三杯逢故人。\n垆头卖浆至，座右勒铭新。\n无使穷途泪，阑干缨上尘。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":4666,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]