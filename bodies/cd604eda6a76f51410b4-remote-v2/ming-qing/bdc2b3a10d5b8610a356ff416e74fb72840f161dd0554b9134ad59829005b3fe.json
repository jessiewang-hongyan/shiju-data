[{"title":"贺圣朝","author":"屈大均","text":"休憎春色如浓酒。\n纵醉人难久。\n愁心搅乱任莺声，更丝丝垂柳。\n歌长歌短，总催白发，但瑶琴在手。\n飞花片片解相依，到天涯犹有。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15654,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"虞美人","author":"屈大均","text":"青山渐渐围天尽。\n峡口春难认。\n渺茫烟树带渔村。\n愁见白云红叶又黄昏。\n沙鸥贴水随波远。\n吹笛教飞断。\n炊烟欲湿雨来时。\n恨尔衔鱼高下不曾知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15655,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"感皇恩  煎香","author":"屈大均","text":"熟结水沉同，煎宜火细。\n不取香烟取香气。\n氤氲一缕，不作巫云苍翠。\n味生空里令人醉。\n日暖尚熏，夜深难睡。\n四下风帘恐凉吹。\n鸪斑半烬，片片总留芳蜕。\n岕茶再浴惊精在。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15656,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"渔歌子 二首 其一","author":"屈大均","text":"开到棠梨不是花。\n莺啼莫忆旧繁华。\n朝雨急，暮风斜。\n出光催去去谁家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15657,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"渔歌子 二首 其二","author":"屈大均","text":"夹浦夭桃树树斜。\n一湾不见一湾花。\n云带岸，水侵沙。\n白鸥多处有人家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15658,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"纱窗恨","author":"屈大均","text":"蜘蛛会织难成疋。\n枉多丝。\n玉琴半露光如漆，网经时。\n戒罗袖绿尘休拂，任柳绵、花片依依。\n更使啼痕在、似烟霏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15659,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"海棠春","author":"屈大均","text":"清箫未弄肠先绝。\n正槛外、朦胧帘月。\n露冷雁声沉，水湿萤光灭。\n柳枝难作同心结。\n但有絮、纷纷似雪。\n莫傍画裙飞，片片成蝴蝶。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15660,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"醉花间","author":"屈大均","text":"花相识。\n柳相识。\n无限春颜色。\n荡漾酒船时，费尽抛香力。\n将情交玉笛。\n弄去生生逼。\n天边月莫圆，留待人圆夕。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15661,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"酒泉子  二首 其一","author":"屈大均","text":"不恨啼鹃，苦苦只催春日去，春来只是作春阴。\n冷难禁。\n生憎泥陷马蹄深。\n尽是紫霞红雪□，得归香垒也甘心。\n燕须寻。","collection":"明末清初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15662,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"酒泉子  二首 其二","author":"屈大均","text":"最恨蘼芜，消受罗裙双带影，暖风吹去复吹来。\n在苍苔。\n踏青争上越王台。\n蝴蝶不因朝雨散，鹧鸪休为夕阳催。\n且徘徊。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15663,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙","author":"屈大均","text":"欲使绯桃嫁碧桃。\n瓶中交插两枝高。\n朝朝对取酌香醪。\n白发不须求大药，红颜自可解离骚。\n并州那有剪愁刀。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15664,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"浣溪沙 桃溪","author":"屈大均","text":"榕叶阴阴又木棉。\n芭蕉黄映一溪烟。\n人家半在峡门边。\n虾菜未残三月市，鱼花争上九春船。\n愁同百丈尽情牵。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15665,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇 二首 其一","author":"屈大均","text":"分付东风，卷愁西向秦天去。\n瓮翁香乳。\n旧解貂衣处。\n那日花开，持取歌金缕。\n鞍难驻。\n泪和红雨。\n半湿关门树。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15666,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"点绛唇 二首 其二","author":"屈大均","text":"看杀春山，翠眉何必长如许。\n黛边烟雨。\n莫使人描取。\n掩映高楼，花缺偏窥汝。\n斑枝树。\n令栽无数。\n遮尽芙蓉路。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15667,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"小桃红","author":"屈大均","text":"不怨春光去。\n不望春光住。\n只愿愁人，一年一度。\n与花相遇。\n纵青霜、白雪总盈头，也为莺燕主。\n花作谁家絮。\n莺作谁家语。\n化蝶韩妻，乘鸾秦女。\n总归尘土。\n且安排、红酒紫金杯，听玉儿低诉。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15668,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"荷叶杯  二首 其一","author":"屈大均","text":"图取玉颜酡甚。\n多饮。\n吹醒畏东风。\n桃花要与尔相同。\n红么红。\n红么红。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15669,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"荷叶杯  二首 其二","author":"屈大均","text":"春日春人惟又。\n春酒。\n朵朵照琼枝。\n山茶花被海棠催。\n开么开。\n开么开。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15670,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"伤情怨","author":"屈大均","text":"枝间红泪渐少。\n喜杜鹃开了。\n收拾春心，休从花内老。\n怜他梅子尚小。\n打乳莺、一一难到。\n入口先酸，青黄愁未蚤。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15671,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南乡子","author":"屈大均","text":"琵琶尾，凤凰头。\n相逢识是柳城舟。\n双双桂楫摇纤玉。\n沙鸥逐。\n思得湔裙香水浴。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15672,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"临江仙","author":"屈大均","text":"前镜那知侬影好，怜人更有菱花。\n研制忘作脸边霞。\n春来无力，日日髻鬟斜。\n不使香貂为抹额，天寒尚束轻纱。\n海棠簪罢又山茶。\n恨伊双燕，衔去向西家。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15673,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"醉春风  友人饷金陵雪酒","author":"屈大均","text":"春色如眉黛。\n篘成香可爱。\n梅花三白总将来，赛。\n赛。\n赛。\n花里封泥，柳边开瓮。\n客愁全解。\n叹尔情如海。\n红友频相赉。\n可能移得惠山泉，再。\n再。\n再。\n频使溪翁，玉杯长满，玉颜长在。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15674,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"减字木兰花","author":"屈大均","text":"梨花未绝。\n朵朵沾泥犹是雪。\n欲嫁东风。\n自有蜂媒送落红。\n连朝烟雨。\n一见春光都欲语。\n斟酌庭前。\n忍舍莺声去昼眠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15675,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"天仙子  二首 其一","author":"屈大均","text":"双鬓但将蝴蝶赛。\n露花油好嫌香大。\n吴阊学得牡丹头，钗不戴。\n珠不爱。\n只有一枝兰作态。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15676,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"天仙子  二首 其二","author":"屈大均","text":"自织纤纤娇女葛。\n露花蝉翼同轻滑。\n裁为夫婿夏时衣，风莫绉。\n汗莫透。\n管取清凉长似旧。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15677,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"捣练子","author":"屈大均","text":"春欲去，去天涯。\n片片残红似落霞。\n蝴蝶飞过蝴蝶草，鹧鸪啼上鹧鸪花。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15678,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"苏幕遮  题盘斋","author":"屈大均","text":"虎头云，狮口水。\n风卷虚无，飞入疏帘里。\n古木阴阴凉不已。\n无数蝉嘶，又送松声起。\n荔成花，蕉有子。\n多种丫兰，分我茎茎紫。\n甘蔗还教甜到尾。\n抱瓮相从，我亦忘机矣。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15679,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"江城子","author":"屈大均","text":"春魂如雨复如烟。\n暗吹断，落天边。\n无情花片，相逐又明年。\n人笑海棠消受尽，明镜好，尚相怜。\n软同人柳只多眠。\n怕啼鹃、到帘前。\n愁压春山，不使黛云妍。\n枕簟为谁寒欲绝。\n教宝鸭，断沉笺。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15680,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"清平乐","author":"屈大均","text":"海棠丝短，不遣风吹断。\n一朵依然红玉软。\n留与妆楼寄远。\n杨花未作浮萍。\n枝间交映青青。\n拾絮殷勤作枕，郎归定爱芬馨。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15681,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"洞仙歌  赠潘季子花烛","author":"屈大均","text":"开年几日，喜蛮花香杂。\n未尽春寒尚重祫。\n正佳期、十五明月团圆，初一度，蟾兔阴阳开合。\n王郎题赋罢，盼睐双星，冉冉仙人下云阁。\n自有板桥长，灵鹊殷勤，休环绕、绛河三匝。\n问七夕、何如上元时，有处处、张灯火花烟蜡。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15682,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"诉衷情  小妓","author":"屈大均","text":"开唇只唱月儿高。\n未熟小樱桃。\n雏鹰身似琵琶，短短绣花袍。\n能劝客，白酥醪。\n绿葡萄。\n娥眉教画，鸟爪教搔，莫弄檀槽。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15683,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"阮郎归","author":"屈大均","text":"春来莫使杜鹃知。\n杜鹃花已飞。\n海棠更是泪红时。\n片片付游丝。\n琴不弄，酒空持。\n愁心尽在眉。\n裙边蛱蝶怕风吹。\n房帘深自垂。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15684,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"散天花浪花","author":"屈大均","text":"吹作芙蓉上下飞。\n天边纤收散，是江妃。\n风为根蒂水为枝。\n天然冰朵幻，出涟漪。\n舞入云中不用衣。\n沙鸥惊复下，欲衔时，依依不认别斜晖。\n为伊春不用，自芳菲。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15685,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"雨中花慢  越王台下怀古","author":"屈大均","text":"雁翅三城，龙荒十郡，秋来不减边沙。\n恨牛羊有地，鸡犬无家。\n虽少诸军浴铁，还馀几队吹笳。\n口朝台试望，天似穹庐，直接京华。\n赵佗箕踞，南武称雄，遗墟问取栖鸦。\n谁得似、斑骓汉使，才藻纷葩，汤沐千年锦石，文章五岭梅花。\n彩丝女子，争看旌节，色映朝霞。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15686,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"行香子  渔歌","author":"屈大均","text":"第一鱼鲳。\n第二鱼?。\n第三鱼是马膏?。\n潮咸潮淡，一任鱼郎。\n喜春风来，黄花短，白花长。\n江水鱼香。\n鱼子滋阳。\n大罾船、满载盐霜。\n罛公罛姥，两两开洋。\n更鲚鱼寒，鲈鱼热，脍皆良。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15687,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"万年欢  为百有五岁梁淳儒翁寿","author":"屈大均","text":"绿随青瞳，好眉华发，八公推尔年尊。\n膝下公沙龙子，一一多孙。\n一百春秋又五，奇龄好，天与东园。\n东方妾，大小鸳鸯。\n蚌胎新产珠媛。\n凝脂滑肤作枕，与辟寒燕玉，日夜春温。\n玉女明星浆水，两乳相喷。\n不使张苍齿落，多饮取、孩笑同喧。\n茶枝杖，扶过花村，寿星人喜临门。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15688,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"燕归梁","author":"屈大均","text":"几片春光燕嘴边。\n红湿露啼鲜。\n海棠丝短也相牵。\n残梦后，断魂前。\n粉馀飞雪，香消沉水，无计更留仙。\n东风好，送向花田。\n花麝土，早成烟。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15689,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"江南春","author":"屈大均","text":"花已搅，柳边牵。\n荷丝萦一缕，荷叶叠千钱。\n苦心成藕悲莲子，莲子成时郎不怜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15690,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"一斛珠   二首 其一","author":"屈大均","text":"媚儿开袖。\n芙蕖花出樱桃口。\n多生定念莲经否。\n欲吐芳香，辄自含辞久。\n荷叶不离双玉手。\n朝朝暮暮来擎酒。\n半酣方肯歌红豆。\n不信娇莺，似尔春声溜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15691,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"一斛珠   二首 其二","author":"屈大均","text":"海棠丝短。\n输他杨柳丝难断。\n流莺系得枝枝满。\n莫只贪眠，不耐腰身软。\n花絮无情风自乱。\n眉痕一任春深浅。\n生憎一树含烟暖。\n每共芭蕉，片片心舒倦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15692,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"一斛珠  乞某子作树","author":"屈大均","text":"古肥今瘦。\n三真六草多仙授。\n银钩趸尾人争购。\n一幅鹅溪，为写兰亭就。\n笔虎如今谁怒手。\n天门龙跳争驰骤。\n墨涛翻处蛟螭斗。\n更乞惊鸾，字字教如斗。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15693,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"更漏子","author":"屈大均","text":"无数落花人不惜，拾红浴向清溪。\n胭脂不使作香泥。\n莺掠去东西。\n休絮乱，与丝齐。\n牵人只似柔荑。\n无情枉作有情啼。\n杜鹃声且低。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15694,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"罗敷媚  碧桃","author":"屈大均","text":"洗红尽褪夭夭色，雪粉犹多。\n不肯颜酡。\n浓淡胭脂总笑他。\n看朱成碧朦胧甚，只为相思。\n不见红儿。\n化作瑶华怎得知。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15695,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"蝶恋花  春情","author":"屈大均","text":"似雨如晴春乍暖。\n漠漠烟青，未肯含愁浅。\n怅望不知人已远。\n踏红似向花间转。\n乱落杜鹃馀几片。\n付与游丝，莫被风吹断。\n紫燕衔香知有怨。\n怨他情与东风短。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15696,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"天仙子","author":"屈大均","text":"翡翠兰开如翡翠。\n朵朵教人日长醉。\n玉壶无酒又春愁。\n因柳色，怕登楼。\n一任年光逐水流。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15697,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"帝乡子","author":"屈大均","text":"花花。\n一枝红一家。\n大小髻鬟都有，似朝霞。\n蝴蝶逐人来去，粉沾青额沙。\n团扇扑将三两，莫伤他。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15698,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"古调笑　二首 其一","author":"屈大均","text":"蝴蝶。\n蝴蝶。\n片片如花似叶。\n休教乱舞春风，搅起苔间坠红。\n红坠。\n红坠。\n半化胭脂香泪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15699,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"古调笑　二首 其二","author":"屈大均","text":"杨柳。\n杨柳。\n日日长条在手。\n流莺何苦多情，啼到枝边月明。\n明月。\n明月。\n冷浸满头冰雪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15700,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"诉衷情","author":"屈大均","text":"为爱腰肢多种柳，拂朱桥。\n垂绣户。\n双舞。\n当妖娆。\n看煞落花朝。\n摇摇。\n流莺花外招。\n向长条。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15701,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"河传","author":"屈大均","text":"芳草。\n芳草。\n萋萋官道。\n恨尔如烟。\n一春相逐夕阳边。\n扬鞭。\n趁晴天。\n天愁却比人愁重。\n雨如梦。\n暗把韶光送。\n东风休作花落媒。\n吹来。\n含啼向酒杯。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15702,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"河滨神","author":"屈大均","text":"榕树与油葵。\n掩映天妃庙西。\n一江新水带春泥。\n数行鸂鶒飞低。\n妇女枫香烧早暮。\n魂断茫茫江路。\n生怕去年风飓。\n破蓬休起渔浦。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15703,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"醉花阴  以竹节大斗为元兄寿","author":"屈大均","text":"一节琅玕开大斗。\n斟汝满春酒。\n金老饱风霜，磨用阴山，玉爪清光透。\n龙公早向罗浮取。\n光怪像灵寿。\n叶大似芭蕉，倦作荷筒，更可娱黄耇。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15704,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"锦堂春慢  贺廖君新宅","author":"屈大均","text":"地是兰湖，城当穗洞，华堂新见翚飞。\n羡王家春燕，复返乌衣。\n碣石宫边久客，浮丘市上初归。\n镇向花林偃卧，长弄瑶簪，长弄珠徽。\n锦里先生接近，又青莲白苧，词笔同嬉。\n笑桐孙百尺，桂子双围。\n蕉老雌雄仙蝠，梅芬大小豪犀。\n未化千年霜羽，尚识庐耽，尚识令威。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15705,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"东风第一枝  送张君携假返杭州","author":"屈大均","text":"荔蕊初含，棉花欲吐，春光渐与膏沐。\n乳莺催意香泾，旅雁引辞槛曲。\n兰桡荡漾，羡归客，鸳鸯相逐。\n漫计程，想到明湖，尚未藕肥菱熟。\n知佩又、大红媚蝠。\n么凤子、再看羽绿。\n早从奔月灵娥，乞得兔儿在腹。\n罗孚曾至，怎忘得、芝甘如肉。\n待宦成，散带重游，肯作洞天梅福。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15706,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"木兰花慢  竹业符","author":"屈大均","text":"向笼葱摘取，问虫篆、是谁书。\n似蠹绣丹经，鱼餐绿子，巧出仙馀。\n麻姑。\n戏将凤爪，印龙纹、一晕一河图。\n更缀阴阳小押，辟邪留在冲虚。\n研朱。\n箨陨亦沾濡。\n掩映雪消初。\n笑带鱼与露，腻香春粉，总赠芳姝。\n林于。\n洞庭万树，奈斑斑、只有泪如珠。\n那得双钩片片，惊鸾迹遍萧疏。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15707,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"水龙吟  五色雀","author":"屈大均","text":"洞天偏是朱明，凤凰生长纷孙子。\n更多五色，绛翎作长，绿兄红姊。\n大石楼边，锦屏峰际，群飞相比。\n与碧鸡丹翠，雌雄三两，教王母、长驱使。\n又有鹲䴀越翅。\n粪奇香，水沉真似。\n鵁鶄对对，捣馀灵药，连声呼尔。\n解识仙儒，洞门遥迓，导归花市。\n爱回翔逐我，彩衣儿女，作高堂喜。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15708,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"粉蝶儿  本意","author":"屈大均","text":"兰出朱明，翩翩凤凰孙子。\n笑麻姑、绣裙难似。\n触飞丝，穿落粉，尽他春戏。\n更谁人，逍遥漆园如尔。\n莺捎不去，缠绵一生花底。\n与风流、绿毛丁髻。\n共收香，到静夜，方开双翅。\n怕娇娥，轻罗扑伤金翠。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15709,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"七娘子","author":"屈大均","text":"愁来又路从烟草。\n东风不把蘼芜扫。\n丝短丝长，将愁萦绕，萋萋一片先春老。\n紫骝娇向香泥倒。\n绿乾红湿多行潦。\n欲问萝村，无人知道。\n茫茫不觉山花好。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15710,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"少年游  芭蕉","author":"屈大均","text":"水蕉心老苦难开。\n春作剪刀催。\n油罗衫影，冰消裙影，荡漾拂帘来。\n猩红花蕊层层卷，愁拘束、待轻雷。\n最怕秋声，冷含风雨，且莫折苞胎。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15711,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"南乡子  蓬松果","author":"屈大均","text":"一树蓬松。\n身如井上两梧桐。\n雄树生花雌结子。\n鸳鸯似。\n不是多情争有此。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15712,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}},{"title":"一落索  落花二首 其一","author":"屈大均","text":"消受春光无几。\n流莺催尔。\n无端开落太匆匆，枉去争红紫。\n苦被东皇驱使。\n梦中相似，行云行雨总无情，教宋玉、空悲泪。","collection":"明末清初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明末清初.csv","pointer":15713,"sha256":"e0987d82e81e86c470b3cfc377b42f602a847f07513d066f74ace71d94e5d613","dynasty":"明末清初"}}]