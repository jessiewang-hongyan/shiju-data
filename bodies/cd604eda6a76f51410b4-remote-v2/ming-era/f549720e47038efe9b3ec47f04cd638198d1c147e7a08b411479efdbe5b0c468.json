[{"title":"题刘让夫明府行乐图十二 其二","author":"成鹫","text":"解得官钱赎官树，换将官服拜官松。\n他年化作甘棠去，留取春郊绿荫浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50374,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题刘让夫明府行乐图十二 其三","author":"成鹫","text":"智人应不比狐疑，独立寒凘欲解时。\n笑与水冰相对语，三人清白总相知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50375,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题刘让夫明府行乐图十二 其四","author":"成鹫","text":"相随琴鹤上轻车，满载清风万卷书。\n野鸟亦知天路远，飞鸣三嗅劝归与。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50376,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题刘让夫明府行乐图十二 其五","author":"成鹫","text":"臣心百折类抽丝，欲写丹心退食时。\n那得朝廊千万丈，代将牙笏为书思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50377,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题刘让夫明府行乐图十二 其六","author":"成鹫","text":"青莲老子心胆怯，会么居士太饶舌。\n不难不易在当人，剑门劈破乾坤裂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50378,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题刘让夫明府行乐图十二 其七","author":"成鹫","text":"舞干七日苗民格，何以文翁化蜀时。\n月下群苗自歌舞，抱关檄文也相宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50379,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题刘让夫明府行乐图十二 其八","author":"成鹫","text":"为蚓为蜩原一体，饮泉饮露也同清。\n腹中岂有不平事，飞出枝头咽一声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50380,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题刘让夫明府行乐图十二 其九","author":"成鹫","text":"曾笑贫儿誇暴富，又怜老姥作贫婆。\n提筐植杖沿街乞，餍足墦间不较多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50381,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题刘让夫明府行乐图十二 其十","author":"成鹫","text":"仓颉未生先有字，包羲才画已无书。\n瓜园共看如意帖，借问三?如不如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50382,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题刘让夫明府行乐图十二 其十一","author":"成鹫","text":"选官须近圣人边，选佛直到然灯前。\n选石全凭方寸地，清风两袖米家颠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50383,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题刘让夫明府行乐图十二 其十二","author":"成鹫","text":"尺幅波涛万里思，坳堂杯水即天池。\n凭君开只摩醯眼，看到扶桑日出时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50384,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和诸笠山县尉见过一韵四绝 其一","author":"成鹫","text":"牢锁重关路不通，何人过我扣参同。\n问君识得真空否，法界空时讼狱空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50385,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和诸笠山县尉见过一韵四绝 其二","author":"成鹫","text":"大地春光一气通，河阳花与武陵同。\n花时花下逢梅福，一笑相看色是空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50386,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和诸笠山县尉见过一韵四绝 其三","author":"成鹫","text":"挟策宁兼博塞通，亡羊前路却相同。\n暂时放下官家事，莫放花前茗椀空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50387,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和诸笠山县尉见过一韵四绝 其四","author":"成鹫","text":"春水浮天万派通，扬舲鼓枻往来同。\n画船去后松门闭，归雁一声过远空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50388,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送高邑佐伴贡入京用来韵十首 其一","author":"成鹫","text":"代耕未易得逢年，宦况诗情总冷然。\n閒却簿书问重译，风光何处不周还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50389,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送高邑佐伴贡入京用来韵十首 其二","author":"成鹫","text":"江上大郎连二郎，江干番舶并官航。\n远人不用誇奇货，馆伴明珠在锦囊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50390,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送高邑佐伴贡入京用来韵十首 其三","author":"成鹫","text":"登舟风便抱琴眠，梦逐飞凫上九天。\n此去莫愁天路远，清风先到圣人前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50391,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送高邑佐伴贡入京用来韵十首 其四","author":"成鹫","text":"雕题黑齿共朝天，浊水污泥种白莲。\n擎出一枝承雨露，东林须记再来缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50392,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送高邑佐伴贡入京用来韵十首 其五","author":"成鹫","text":"九重瑞日射彤云，万里天鸡到处闻。\n閒与侏离说声教，好教遗子受三坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50393,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送高邑佐伴贡入京用来韵十首 其六","author":"成鹫","text":"相随断发及文身，异俗殊音强自亲。\n除却声华与文物，不知谁假复谁真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50394,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送高邑佐伴贡入京用来韵十首 其七","author":"成鹫","text":"真中有假假中真，行役行吟总一身。\n直造鹓行陪贡使，也知差胜折腰人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50395,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送高邑佐伴贡入京用来韵十首 其八","author":"成鹫","text":"粤水燕山路未赊，观风问俗兴无涯。\n异言异服休相讶，同轨同文本一家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50396,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送高邑佐伴贡入京用来韵十首 其九","author":"成鹫","text":"买鹤修琴罄俸钱，朝来棒檄心茫然。\n罢琴惆怅鹤起舞，飞上丹霄宁受怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50397,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送高邑佐伴贡入京用来韵十首 其十","author":"成鹫","text":"毙裘羸马太郎当，祖道乘风挂席忙。\n妒杀隔江老渔父，船头初月白如霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50398,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"风花雪月","author":"成鹫","text":"瓶中一枝花，天上一轮月。\n花落月归天，风吹满地雪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50399,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阙题","author":"成鹫","text":"古寺荒凉不记年，隔江招手问前缘。\n常人记得灵山否？\n一笑相逢岂偶然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50400,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏灵云桃花公案","author":"成鹫","text":"可笑灵云不作家，眼花错认是桃花。\n原来咫尺天台路，满地残红总是它。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50401,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中逢故人","author":"释慧度","text":"如何山不老，须鬓白成银。\n试问香山社，于今尚几人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50402,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨花庵题壁","author":"释霁月","text":"一僧一蒲团，钟动众僧坐。\n日暮经梵声，松风相与和。\n于此得清閒，胡受俗尘挫。\n兴生即可游，神疲即可卧。\n人生天地间，但勿作昏惰。\n书此告后人，万虑庶可破。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50403,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游阴那诗","author":"释慧机","text":"众壑含清晖，晨夕朔风冷。\n扶杖展健步，遂上诸峰顶。\n翘首望云关，恍惚散仙骋。\n我心如木枯，况获兹幽境。\n理感兴自超，不关众山静。\n日暮踏下山，斜阳照孤影。\n叩扉闻清钟，猛然发深省。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50404,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重游东岩","author":"释印元","text":"重来不见主人颜，只见松梢鹤自还。\n煮茗昔曾眠怪石，吟诗今又叩禅关。\n天低青入烟中树，云湿光连水上山。\n卓锡泉香千古异，洞门空锁白牛闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50405,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韩山亭","author":"释超雪","text":"集仰小亭间，幽人独往还。\n风微花气足，树密鸟声闲。\n鱼跃有源水，云登无尽山。\n骋怀神自远，万汇各开颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50406,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀","author":"释超雪","text":"比来秋落莫，高枕菊花前。\n古木收残雨，疏篱宿冷烟。\n三山人自远，千里恨难传。\n何处砧声急，悠悠到耳边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50407,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄陈延煜文学","author":"释超雪","text":"同在乾坤内，何曾有别离。\n川原人自隔，魂梦客多疑。\n野趣凭谁话，寒花托使迟。\n山房悬一榻，待汝夜裁诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50408,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏梅","author":"释超雪","text":"风霜盈草莽，独出占春芳。\n闲卉肥何益，清姿瘦不妨。\n林花方匝匝，风景自苍苍。\n每作罗浮想，梦回袭暗香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50409,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋云","author":"释超雪","text":"出没难留迹，去来不自任。\n繁生疑有蒂，随处见无心。\n石坞封寒翠，松门落片阴。\n金风吹正急，飞逐九皋禽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50410,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鼓山喝水岩","author":"释德薪","text":"划破青山劈箭来，冷然一喝忽飞回。\n截流机峻吹毛利，逐浪声消劫石灰。\n空有烟霞同寂寞，绝无丘壑起喧豗。\n松门落得幽闲甚，烂熳黄花覆绿苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50411,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马聘三司马同许野公别驾过访和韵","author":"释德薪","text":"撩人好句带烟霞，何幸相将薜荔家。\n荒径扫除无剩叶，空林点染尚馀花。\n厨中盘供惟烧笋，竹里涛声只煮茶。\n但得骚人频过往，当年白社莫相誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50412,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"余自虔入闽赠明府张次元一律后公寄我以诗盖悔黑海之飘溺而世网之难出也然顺水张帆每荡神志惟逆风按棹益验骨力历观古锥无不从荆棘林中打开通天大路乃依前韵复成一首答之","author":"释德薪","text":"何物幻成性与名，世人于此枉钟情。\n应同鸿羽云间发，莫作萍踪浪里行。\n庐岳移来山有色，西江汲尽水无声。\n回思不是他家事，定可将心旧处明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50413,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漂母祠","author":"释源昆","text":"王孙艰一饭，千古数豪英。\n不识封侯相，焉成漂母名。\n施时无复念，报者亦常情。\n一片祠前月，悠悠淮水声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50414,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次陈心之陈比之二居士过访东皋韵","author":"释海会","text":"结屋离人境，时看云去来。\n新花迎客笑，一径为君开。\n茶煮春前水，芋搜劫后灰。\n莫言村寺僻，握手步松台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50415,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华首台","author":"释行敏","text":"有约罗浮不易逢，偶来林下问仙踪。\n遥看茂树馀千麓，初入名山第一峰。\n华首已非昔日会，缁流犹撞旧时钟。\n浪游欲极溪岩胜，竹杖凭须化作龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50416,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿飞来次韵","author":"释南野","text":"岭南多胜迹，此地最幽深。\n殿角空天外，风泉落石音。\n猿啼山有月，花笑客无心。\n不尽登临兴，凭高几度吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50417,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝林寺六景 其一 飞来钟","author":"释性晓","text":"曾闻大地出胞胎，蓦地洪音震蛰雷。\n唤醒定中霜夜梦，却疑狮子复飞来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50418,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝林寺六景 其二 初有潭","author":"释性晓","text":"何年潭水翳林间，今有清光见此山。\n一任风来波不起，潭心可似老僧闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50419,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝林寺六景 其三 一线泉","author":"释性晓","text":"泉与曹溪一样深，纡回一线出幽林。\n世人不解清清意，抛却源头向外寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50420,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝林寺六景 其四 桃花溪","author":"释性晓","text":"清闲未许住深山，手种桃花溪几湾。\n回顾落花红片片，不随流水到人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50421,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝林寺六景 其五 闻经石","author":"释性晓","text":"无论晨钟午磬时，堂前惟恐听经迟。\n世间那有痴如石，住在深山已不痴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50422,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝林寺六景 其六 掷锡峰","author":"释性晓","text":"曹山万屻翠巃嵷，再进竿头路可通。\n昔日隐峰何处去，空留一锡白云中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50423,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晖吉大居士游阴那招韵","author":"释代贤","text":"紫气翩翩入翠峦，千峰掩映出林看。\n鸟鸣荒径谁知曲，星聚云间应识官。\n石火烹茶谈古事，泉声和韵起新欢。\n山灵歌舞君留带，琴鹤相随上急滩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50424,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题罗浮合掌岩高数百丈","author":"梁珍","text":"嶙峋怪石耸仙山，礼尽诸天肯信顽。\n欲證三生归佛国，漫参二体破尘寰。\n池边洗衲苔侵袖，壁上蒸霞暮掩关。\n翘首巨灵堪仰止，寻常丘壑自应删。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50425,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落梅","author":"罗素月","text":"为怜清净出尘中，喜逐仙山午夜风。\n弄玉去时云暗淡，飞琼下界月朦胧。\n冰魂卧骨全真性，绝岛荒郊入化功。\n铁笛吹残人在否，依然深锁蕊珠宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50426,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮蝶","author":"罗素月","text":"浪说衣冠幻化成，翩翩庄梦信虚情。\n绕林五彩来天上，吸尽人间露气清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50427,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏鹤","author":"罗素月","text":"游遍芝田与九皋，沧江养就雪霜毛。\n楼中若遇仙吹笛，飞上云霄万丈高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50428,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花村","author":"罗素月","text":"麻姑仙窟鲍姑山，凤子翻飞远峤还。\n玉女峰头人冷笑，杜兰香去嫁人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50429,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠铁桥道人","author":"罗素月","text":"仙郎昨到洞天时，花下閒拈笔一枝。\n收拾春山漫归去，岂应窗下画娥眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50430,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石洞","author":"罗素月","text":"水疑天际来，声自云间起。\n耳根本无尘，对此何以洗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50431,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"栎社","author":"峡山中仙","text":"远自罗浮巅，弭棹返凝碧。\n有木卷且樛，高可百馀尺。\n托生名山阿，结根古磐石。\n岁寒积风烟，可屈不可易。\n垂垂广亩阴，匠石不察识。\n不为明堂用，遂免斧斤戚。\n抚尔兴长谣，托尔施枕席。\n处夫不才间，尔真吾友籍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50432,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"狮子石","author":"峡山中仙","text":"既不射为虎，又不叱为羊。\n遂化为狮子，据此山之阳。\n何不往兜率，一吼醒迷方。\n会挟广成辈，煮为五岳粮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50433,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"眺虚岩","author":"峡山中仙","text":"但闻笙鹤音，迥与尘凡隔。\n横玉弄寒云，万里天一碧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50434,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题丹灶","author":"无名仙","text":"仙翁元不死，遗迹俨然存。\n伏虎看丹灶，灵虬护洞门。\n人间恶风日，物外好乾坤。\n便欲辞尘网，来兹养道根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50435,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东坡钓矶","author":"无名仙","text":"学士南迁极海滨，曾于此地数投缗。\n等闲不遣风流尽，片石犹存鸟篆新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50436,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登清远峡飞来寺四首 其三","author":"汪广洋","text":"才到生公讲后经，蛟龙夜出石潭听。\n骊珠正照维摩室，优钵花香兰叶青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50437,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"云壑石壁","author":"无名仙","text":"崖石势欲落，令人发怪想。\n载拜濡玄云，颜之衣裙上。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50438,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"红梅驿题壁","author":"梅本裕","text":"依旧墙垣接断崖，停车何事亦伤怀。\n深山裹足真无术，歧路相逢未有涯。\n去马鹿随云影没，落花香付燕泥埋。\n台侯故宅凭谁问，只自题诗关送谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50439,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过沙水村有感","author":"黄印（进士","text":"路逢人口说珠玑，沙水村前仍旧基。\n水木本源深有感，古人殊世路多歧。\n新亭不举伤春目，岘首垂成坠泪悲。\n回首壶山原草绿，白云晴日身迟迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50440,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺情集古 其一","author":"黎瑜娘","text":"故园东望路漫漫，泣雨伤寒翠黛残。\n去日渐多来日少，别时容易见时难。\n春蚕到死丝方尽，沧海扬尘泪始乾。\n无可奈何无可奈，五更风雨五更寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50441,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀故园","author":"康麟","text":"京华旅食觉秋深，那更怀归思不禁。\n几处清霜寒度角，万家明月乱敲砧。\n宣尼有意淹齐淅，庄舄无乡动越吟。\n遥忆番山旧诗社，何时携手一登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50442,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"槎溪钓叟为邓乡执赋","author":"康麟","text":"门前流水碧潆洄，上有浮槎作钓台。\n几点鹭鸥当镜落，一竿风月自天来。\n羊裘任著随闲梦，星象何曾犯上台。\n只恐鹤书求隐逸，未容华发老蒿莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50443,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙亥再复命退朝作","author":"康麟","text":"封章重奏上金銮，喜得天颜两度看。\n银汉月低仙仗晓，玉阶霜重绣衣寒。\n自惭谫薄沾恩早，谁谓精忠报国难。\n退食从容还北望，丹心飞傍五云端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50444,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王元还南海","author":"康麟","text":"紫陌香尘逐马蹄，一尊相送凤台西。\n行人已向今朝别，杜宇何须尽日啼。\n明月孤舟湘水阔，夕阳芳草楚天低。\n遥知此去春光好，无限莺花入品题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50445,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]