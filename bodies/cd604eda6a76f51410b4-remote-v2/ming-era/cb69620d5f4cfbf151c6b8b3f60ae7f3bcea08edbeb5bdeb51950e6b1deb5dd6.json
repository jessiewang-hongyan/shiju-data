[{"title":"暮秋病肺梦中作时有鼓盆之变 其二","author":"胡应麟","text":"竟日焚香坐，丹枫敞画屏。\n参同原有契，道德岂无经。\n白露高涂屋，青山远抱亭。\n那能世缘縳，华发已星星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题赵鸿胪文镇西园并蒂黄花","author":"胡应麟","text":"并蒂秋难老，同心暮更嘉。\n金茎双濯露，玉蕊对凌霞。\n色映天随圃，香飞靖节家。\n翩翩白衣过，把酒兴无涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花朝吴孝父邀集高深甫湖上园亭","author":"胡应麟","text":"名园总宜客，春半大堤头。\n渌水时扃户，青山日满楼。\n携壶新雨过，挟瑟乱云流。\n漫惜花朝宴，䠞成列炬游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴文仲使君并怀参知睿父二首 其一","author":"胡应麟","text":"鼓吹钱塘驿，帆樯趁暮潮。\n双龙初析羽，驷马暂停镳。\n绣钺吴门近，牙旌越岭遥。\n异时成握手，列炬坐深宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴文仲使君并怀参知睿父二首 其二","author":"胡应麟","text":"后乘遵吴苑，前驱问蓟方。\n瞻依犹大树，蔽芾尽甘棠。\n雾蹑三天紫，云停六洞苍。\n提携更何日，烂醉旧高阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄吴希学徵士兼怀启元茂才","author":"胡应麟","text":"万事总长铗，一身馀短筇。\n别三天子障，吟五大夫松。\n沧海有时涸，丹砂何岁逢。\n周颙卜居近，忆卧定林钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过俞羡长小饮二首 其一","author":"胡应麟","text":"极目函关晓，居然异气停。\n姓名高逸传，身世太玄经。\n独鹤云踪杳，双龙电色灵。\n孤山梅万树，新著少微星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过俞羡长小饮二首 其二","author":"胡应麟","text":"四壁图书满，藤萝压座苍。\n陆浑新邸僻，阳羡旧田荒。\n大业占毛颖，雄心托杜康。\n褐衣吾自贵，未拟谒金张。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送汪山人归四明四首 其一","author":"胡应麟","text":"两鬓怀人短，双瞳作客方。\n文渊神矍铄，叔夜思昂藏。\n薜荔裁衣古，兰荃结佩芳。\n戴颙精舍近，归卧白云长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送汪山人归四明四首 其二","author":"胡应麟","text":"相逢宁海岱，对语即江湖。\n肯抱临淄瑟，聊携督亢图。\n官衙吟苜蓿，客馆寄菰芦。\n异日山阴兴，能来白玉壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送汪山人归四明四首 其三","author":"胡应麟","text":"玄亭吾久闭，问字不辞劳。\n妙诀青囊古，雄谈白氎高。\n东瀛朝濯发，北海夜持螯。\n极目河梁雨，寒光隔佩刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送汪山人归四明四首 其四","author":"胡应麟","text":"邂逅青山陌，飘然思不群。\n乍归鄞海月，长啸瀫溪云。\n剑拥苍精气，符悬赤伏文。\n东山逢谢傅，好作片鸿闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽祝母","author":"胡应麟","text":"飘飘易迁驾，凝望白云长。\n桥迥分乌雀，台高失凤凰。\n东陵辞圣母，南海谒空王。\n何夕双溪水，重悬婺女芒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"唁祝逊之","author":"胡应麟","text":"传闻倚庐客，布帽碧山阿。\n读礼依松柏，传诗废蓼莪。\n熊丸魂梦远，鸡骨泪痕多。\n迢递支机石，无由问绛河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒董江都祠二首 其一","author":"胡应麟","text":"太息江都相，遗风尚宛然。\n帷疑曾下日，园忆未窥年。\n大业尼山后，真源洛水前。\n天人三策在，不废万年传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒董江都祠二首 其二","author":"胡应麟","text":"一径浮云入，千崖落照明。\n广川新庙貌，繁露旧家声。\n水绿平吞市，山青半压城。\n九原人可作，相对话西京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄潘上林二首 其一","author":"胡应麟","text":"廿载长安陌，君能忆酒狂。\n片鸿来庾岭，双鲤到钱塘。\n赋草新藜阁，诗篇旧柏梁。\n春明退朝晚，掷果遍奚囊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄潘上林二首 其二","author":"胡应麟","text":"落魄南皮社，壶觞数往来。\n夜眠光禄邸，晨叩秘书台。\n永绝抽毫彦，犹馀执戟才。\n重看潘骑省，题赋入蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿王山人子英 其一","author":"胡应麟","text":"初度逢元日，华筵正七旬。\n遗经藏甲乙，秘箓授庚申。\n庭树三株发，阶蓂一叶陈。\n共欣兰水上，比屋颂灵椿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿王山人子英 其二","author":"胡应麟","text":"宅寄吴山外，筹添越海傍。\n玉壶悬大药，金匮谒长桑。\n紫府青牛驻，玄关白鹤翔。\n东风门第在，拂面杏花芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄野人二首 其一","author":"胡应麟","text":"倦作兰阴客，花期一棹閒。\n真形模五岳，秘箓授三山。\n电掣苍龙下，云驱白鹤还。\n越王台渐近，先到若耶湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄野人二首 其二","author":"胡应麟","text":"自得茅山秘，休粮卧翠屏。\n铢衣朝绛阙，玉简诵黄庭。\n六甲时观象，庚申夕炼形。\n石床云雾满，悬佩湿青萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题黄上仲大有山房卷","author":"胡应麟","text":"吾怜黄叔度，一榻抱云眠。\n早赋中原雪，长吟大有天。\n瑶芝荣积石，玉乳喷飞泉。\n笑我金华洞，羊群正熟眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"破山寺偶题","author":"胡应麟","text":"高禅何处寻，杖屦入祗林。\n古寺无人到，虚堂落叶深。\n溪光经雨灭，瀑响过云沈。\n兀兀绳床客，谁明定慧心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王文学还武昌时以陈从训书至","author":"胡应麟","text":"问姓曾惊座，藏名类接舆。\n到偕京口雁，归趁武昌鱼。\n竹素千秋上，芸编万帙馀。\n相逢不成醉，天末意何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瀫溪别业二首 其一","author":"胡应麟","text":"茅庐南郭外，十亩带横塘。\n曳杖青山远，飞槎渌水长。\n花香浮雪壁，竹影动云房。\n五岳游堪卧，悠然号上皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瀫溪别业二首 其二","author":"胡应麟","text":"卷帙桓谭富，篇章杜甫贫。\n乾坤容傲骨，海岳遂閒身。\n坐挟垂纶客，行招荷锸人。\n一痴殊未厌，久已绝贪嗔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿范茂才","author":"胡应麟","text":"当年闻五范，阀阅首吴中。\n咫尺金阊下，仍看玉树丛。\n青鸾翔海日，白鹤舞天风。\n谩逐东方去，冰桃万核红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"叶太孺人挽章六首 其一","author":"胡应麟","text":"懿行标彤管，芳声动紫宸。\n庭前骢马客，膝下豸袍人。\n南岳金珰返，西华玉佩陈。\n惟应万家泪，雨注婺州民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"叶太孺人挽章六首 其二","author":"胡应麟","text":"鸾章晨北极，凤管暮西池。\n万室悲慈训，三朝颂母仪。\n修龄逾大耋，上寿接耆颐。\n咫尺潘舆在，伤心白日驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"叶太孺人挽章六首 其三","author":"胡应麟","text":"劬劳初罢诵，圣善旧徵歌。\n母德传中垒，仙踪赴大罗。\n音容吴里隔，涕泪越天多。\n寂寂支机杳，无由觅绛河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"叶太孺人挽章六首 其四","author":"胡应麟","text":"惨淡丸熊夕，辉煌冠翟年。\n宁知蒿里泪，偏洒柏台前。\n素翣含霜动，丹旗抱月悬。\n异时良史笔，阃德照重泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"叶太孺人挽章六首 其五","author":"胡应麟","text":"令誉中闺擅，恩纶上国来。\n青鸾朝玉阙，紫凤集瑶台。\n落日萱花逝，飞霜蕙草摧。\n朝看携萼绿，联袂上蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"叶太孺人挽章六首 其六","author":"胡应麟","text":"何来三鸟使，相逐绛台傍。\n夜月残西岛，晨霜浸北堂。\n丛兰芳独远，寸草恨空长。\n尚忆飞云起，停车望太行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湖头夕汎","author":"胡应麟","text":"十里平湖色，芳菲夹大堤。\n山回云梦泽，水出武陵溪。\n渚净凫鹥浴，篱明鸟鹊栖。\n沙塘何处泊，隔港已闻鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李太史使湘中","author":"胡应麟","text":"片帆春草外，千里问衡阳。\n剑履金闺色，衣冠玉座香。\n攀云游岳麓，冒雨宿高唐。\n蚤就湘娥赋，鸣珂入建章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿严滩作","author":"胡应麟","text":"扁舟富春渚，回望瀫溪濆。\n渌水晨生雾，青山暮出云。\n荒村猿啸侣，废崦鹿成群。\n会著羊裘在，毋令汉殿闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望湖亭雨中作怀祝鸣皋","author":"胡应麟","text":"极目危栏外，秋光乱夕舂。\n雨声千涧集，云气两湖重。\n翠压仙坛竹，青舒佛院松。\n美人烟水畔，何处采芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"一梦","author":"胡应麟","text":"一梦遥天末，羁人万里心。\n关河秋气早，风雪夜来深。\n拥褐闻征雁，褰裳见宿禽。\n谁哉共尊酒，烧烛自长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘内翰使岭西","author":"胡应麟","text":"拂曙下征轺，鸣鞭出灞桥。\n方舆穷百粤，土俗辩三苗。\n树色桄榔古，花香豆蔻饶。\n金门持戟暇，魂梦忆琼瑶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"彭城云龙山晚眺憩项王故台并酹亚父冢有怀题","author":"胡应麟","text":"返照长河急，浮云大泽空。\n遥凭孤阁上，俯眺万家中。\n地废悲王略，天亡惜霸功。\n荒坟犹亚父，涕泪尽城东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李鸿胪之白下","author":"胡应麟","text":"白面紫薇郎，承恩出建章。\n啼鹃催别骑，舞燕逐征航。\n日抱金珂影，星摇玉剑光。\n秣陵佳胜地，蚤晚赋长杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送闵孝廉之苕中二首 其一","author":"胡应麟","text":"落日抱离旌，萧萧白雁鸣。\n夕阳孤剑别，秋水一帆征。\n粉署宁亲思，彤扉谒帝情。\n河东新草就，珥笔上瑶京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送闵孝廉之苕中二首 其二","author":"胡应麟","text":"野色飘行旆，江光照客船。\n长林枫叶路，孤馆菊花天。\n狗监文初达，龙门赋已传。\n浮家何日事，问汝霅溪烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九龙别业","author":"胡应麟","text":"何年遗别坞，十亩乱云边。\n五柳长垂碧，双松对草玄。\n断崖撑阁迥，飞瀑挂亭偏。\n满目忘机客，花时数放船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"问李惟寅病","author":"胡应麟","text":"已似休文瘦，还耽叔夜吟。\n梦回芳草远，病起落花深。\n雨泞黄金甲，风疏白玉琴。\n蚤知朝谒懒，药饵称閒心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿吴淑人","author":"胡应麟","text":"春色重帘外，笙歌昼未阑。\n屏开回白鹤，席上舞青鸾。\n浥露金芝秀，凌云玉树寒。\n冰桃漫留核，方朔已偷残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴山人持斋戏赠","author":"胡应麟","text":"笑汝清狂客，持斋绣佛前。\n周颙元护法，何胤旧逃禅。\n岭砌须弥石，池疏阿耨泉。\n翛然携手去，尘外息诸缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白云世德诗为林孝廉赋","author":"胡应麟","text":"谁专巴穴富，夙擅渭川封。\n薛氏誇三鷟，荀门羡八龙。\n新居蟠翠柏，旧垄夹苍松。\n何限孙枝在，林林玉树茸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16847,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题林孝廉家庆图","author":"胡应麟","text":"棠棣偕芳日，椿萱并茂时。\n金茎悬五叶，玉树绽双枝。\n海鹤传书近，山莺度曲迟。\n今来上元宴，麟脯擘含卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16848,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈季相还七闽","author":"胡应麟","text":"乍得溪头信，俄欣海上逢。\n云山偕独往，湖海狎高踪。\n坐啸双黄鹄，归骑两赤龙。\n相携子骞侣，十日幔亭峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16849,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄真如上人","author":"胡应麟","text":"行乞过三市，随缘住五陵。\n南徐先舍筏，北地远传灯。\n古洞云埋柏，清池月挂藤。\n门前多宝塔，出定几同登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16850,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽邓太翁兼唁远游明府四首 其一","author":"胡应麟","text":"此夕仙槎逝，当年宦辙回。\n松犹彭泽抚，木已豫章颓。\n献赋名空藉，修文业未摧。\n祇应丰狱底，剑色谢风雷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16851,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽邓太翁兼唁远游明府四首 其二","author":"胡应麟","text":"东华新剑佩，南楚旧弓裘。\n世系蕃高密，乡评重太丘。\n经犹传马队，敕已下螭头。\n藉藉承家誉，相望在斗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16852,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽邓太翁兼唁远游明府四首 其三","author":"胡应麟","text":"政尔生刍隔，将无宿草茸。\n孤亭徐孺子，大厦郭林宗。\n素旐霜华薄，丹旌露色浓。\n异时铭太史，不受汉亭封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16853,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽邓太翁兼唁远游明府四首 其四","author":"胡应麟","text":"化鹤还丹嶂，骑鲸上碧虚。\n一竿遗蠡泽，双屐挂匡庐。\n日朗新题碣，云寒旧著书。\n盐车何足恨，千里属騊駼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16854,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"歙中谒徽国文公祠作","author":"胡应麟","text":"闽粤真人起，高标自不群。\n丁年穷百氏，乙夜揽三坟。\n力障鹅湖水，神游鹿洞云。\n至今灵爽在，长对武夷君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16855,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清源寺中戏效晚唐人五言近体二十首 其一","author":"胡应麟","text":"寺忆支公住，林馀惠远踪。\n浮杯来大壑，振锡上孤峰。\n径僻云埋树，窗明雪照松。\n踟蹰贪佛日，归趁暮天钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16856,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清源寺中戏效晚唐人五言近体二十首 其二","author":"胡应麟","text":"大地悬香刹，中天筑化城。\n重檐飞岳色，古壁撼河声。\n法座琪花暗，经坛贝叶明。\n异时斋绣佛，帝释下瑶京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16857,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清源寺中戏效晚唐人五言近体二十首 其三","author":"胡应麟","text":"香积何年启，天风蹑屩攀。\n白云平讲座，青霭覆禅关。\n断碣横高陇，疏钟出乱山。\n一僧头白坐，兀兀定林间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16858,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清源寺中戏效晚唐人五言近体二十首 其四","author":"胡应麟","text":"云霞寻老衲，尘土拂征衫。\n鹿叩谈经石，猿啼说法嵓。\n寒云封密筱，冻雪堕危杉。\n何限宗雷句，穹碑百尺镵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16859,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清源寺中戏效晚唐人五言近体二十首 其五","author":"胡应麟","text":"杖策平堤外，轻风拂面柔。\n寒山成独往，老衲话重游。\n怖鸽萝龛下，飞萤竹径流。\n将因谢尘鞅，丈室住牛头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16860,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清源寺中戏效晚唐人五言近体二十首 其六","author":"胡应麟","text":"能仁元海峤，伏毒旧江濆。\n隘地龙藏雨，高天鹤跨云。\n岚深秋径失，瀑远夜堂闻。\n寂寂盂兰想，先题发愿文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16861,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清源寺中戏效晚唐人五言近体二十首 其七","author":"胡应麟","text":"户牖生虚白，楼台上郁蓝。\n谈经狮子吼，护法象王参。\n桧老斜撑石，松枯半压潭。\n何因挈天女，绝顶卧茅庵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16862,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清源寺中戏效晚唐人五言近体二十首 其八","author":"胡应麟","text":"杖履初辞越，庵堂半住吴。\n腊深松树老，禅久桂丛疏。\n五岳云高下，三峨雪有无。\n异时腾劫海，片笠授潜夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16863,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清源寺中戏效晚唐人五言近体二十首 其九","author":"胡应麟","text":"蚤净三生业，真传二祖衣。\n莲花丛佛座，柏叶护禅扉。\n石为悬灯动，泉因卓锡飞。\n居然离捧喝，默会洞仙机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清源寺中戏效晚唐人五言近体二十首 其十","author":"胡应麟","text":"为叩西方刹，因停北上槎。\n金身悬宝树，玉髻涌瑶花。\n梦已清圆觉，心将悟法华。\n恒河归去路，云雾绕三车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清源寺中戏效晚唐人五言近体二十首 其十一","author":"胡应麟","text":"震旦聊乞食，佛座涌金鳌。\n骨瘦知吟苦，眉长见腊高。\n香灯岩洞月，杖锡海门涛。\n近失潇湘谱，瑶琴废不操。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]