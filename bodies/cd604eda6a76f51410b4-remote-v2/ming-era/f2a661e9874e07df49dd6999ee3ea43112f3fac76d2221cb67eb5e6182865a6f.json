[{"title":"癸酉秋苦雨 其一","author":"赵完璧","text":"带雨閒云西复东，朝昏巫女意匆匆。\n蓬瀛望绝连天雾，湖海波翻蓦地风。\n临水花涵青镜里，看苔人在翠帷中。\n炊珠爨桂秋将晚，秪有题诗兴未穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13329,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"癸酉秋苦雨 其二","author":"赵完璧","text":"天空石破偶惊猜，逗漏鸿泉海国来。\n长昼翻盆迷白日，连宵注瀑斗狂雷。\n三旬水潦无馀地，八十年来未见灾。\n老插渔竿閒卧处，中原点检济川才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13330,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小楼晚兴","author":"赵完璧","text":"独倚阑干眺夕晖，山城秋色正依稀。\n蝉声不定风枝袅，虹影初残雨意微。\n看去墨云双鸟没，听来紫塞一鸿归。\n悠然清兴不可写，明月满庭梧叶飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13331,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春晓枕上偶成","author":"赵完璧","text":"语燕匆匆傍曙归，幽人慵起闭柴扉。\n梦回花坞啼春鸟，人静松窗锁晓霏。\n城市意閒青嶂在，交游情澹紫尘违。\n衰残无事冥搜苦，清对琴床卧翠微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13332,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蛩声","author":"赵完璧","text":"清秋何事此悲蛩，散入尘寰恨不同。\n旧国荒榛寒雨里，古陵衰草夕阳中。\n沉沉庭院残更月，寂寂楼台落木风。\n无奈年年苦相值，是谁沉醉在笙镛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13333,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日楼上琴馀小饮","author":"赵完璧","text":"长昼如何惬好怀，琴樽清暇画楼开。\n朱弦久为王门绝，白雪新传郢客来。\n骏马五花能换酒，浮生一梦可衔杯。\n醉中更有凭阑兴，满目山川愧匪才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13334,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"盐城新秋即事","author":"赵完璧","text":"凉风吹人七月前，清秋爽气开新鲜。\n狂雨既过乱藓湿，远山欲瘦孤云连。\n黄叶萎庭自作舞，青虫吐丝相对悬。\n稻花飞香海署静，何处老翁来醉眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13335,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庚戍京邸除夕","author":"赵完璧","text":"的的寒灯照寂寥，悽悽乡国望迢遥。\n樽前欲醉肠应断，客里逢春冷未消。\n雪暗归鸿书不至，云迷孤鹤思无聊。\n衰年合笑燕山客，独对东风慕圣朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13336,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再次韵孙小渠除夕","author":"赵完璧","text":"一年将尽寄金台，千里萧条独举杯。\n腊候无聊灯下别，春光有顷暗中来。\n身羁异境添霜鬓，心逐薰炉化劫灰。\n乡国好凭飞梦去，数声寒角故吹回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13337,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白川","author":"赵完璧","text":"万顷长川入望平，烟开渺渺澹虚清。\n翔鸥飞鹭茫如失，落絮游丝迥未明。\n极目晴光霜练净，迫人寒色玉尘轻。\n悠然太素还千古，一幅齐纨画未成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13338,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春夜饮王吉庵兄弟宅醉归赋简","author":"赵完璧","text":"春夜沉沉漏未终，画堂银烛暖摇红。\n钟期古调尘氛外，逸少家风谈笑中。\n紫陌醉迷青海月，苍苔健倒白头翁。\n天涯何幸逢知己，聊慰羁愁日夜东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13339,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"京邸清明","author":"赵完璧","text":"遥忆芳菲故里春，长安怜作一羁人。\n松楸望断青山外，花鸟清孤沧海滨。\n黄雾楼台相识尽，玉壶醽醁为谁斟。\n寂寥独倚东风醉，帘幕黄昏燕子新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13340,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵送张省几司城归休","author":"赵完璧","text":"镆干繁剧试多年，报主衰颅惕皓然。\n回首不堪孤鹤怨，拂衣曾为一丝牵。\n斜阳晚浦怜樽酒，归雁春风慰海天。\n满目红尘陶令去，羁人泪落五云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13341,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"艾山晚归","author":"赵完璧","text":"斜日亭亭石径归，秋风飒飒捲征衣。\n林声度晚醒残酒，山气生寒下翠微。\n黄菊暂留乌帽去，落霞遥逐断鸿飞。\n苍茫犹自馀清兴，新月依人弄夕晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13342,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"癸丑寒食","author":"赵完璧","text":"无限花开无限情，此身那得一閒行。\n银鞍柳外谁家子，玉笛风前何处声。\n俗务绊人春已老，清光犹梦醉难成。\n赏心久负浮生意，鸥鹭争如早缔盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13343,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春暮感怀","author":"赵完璧","text":"春色初阑杏雪飞，恼人情思暗依依。\n风尘满目谁相慰，觞咏无心久自违。\n云断远山虚淑景，帘垂清昼送斜晖。\n天真欲写仍羁旅，白首淹迟未拂衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13344,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日集饮边乐亭工所二首 其一","author":"赵完璧","text":"不见黄花两度秋，西风此日共优游。\n青山入望飞难近，俗事侵人却未休。\n佳节祗今怜白发，赏心思昔对金瓯。\n征鸿落叶无吟兴，暂把茱萸一破愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13345,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日集饮边乐亭工所二首 其二","author":"赵完璧","text":"燕山风物向高秋，税驾尘机合暂游。\n寒日晚篱黄欲破，淡烟晴野绿初休。\n官衙窃禄惭金阙，人事伤怀到玉瓯。\n山水幽閒何日遂，蓬瀛回首浪生愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13346,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚秋过城西广通寺用韵","author":"赵完璧","text":"飒飒秋风静法堂，幽吟无与共酣觞。\n疏疏宝树垂清影，冉冉天花散异香。\n落照催归山郭寺，渔舟看弄水云乡。\n迟留合慰偷门意，俗扰从来抱恨长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13347,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵李东冈关山","author":"赵完璧","text":"逢人是处说关山，岩险真成百二关。\n空谷阴寒催白发，崇峦颠顿损朱颜。\n才输周召应知止，老入氐羌却忆閒。\n落日啼猿肠欲断，可堪征袖泪痕斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13348,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"流曲河","author":"赵完璧","text":"流曲河边促晓行，桃源乍喜赴仙程。\n溪声雪激寒潮吼，山色屏开翠黛明。\n杨柳石矶白昼静，桑麻村落碧烟轻。\n倥偬不慰徘徊意，风送黄尘无限情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13349,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早春用韵","author":"赵完璧","text":"东风策策拂馀寒，静掩柴扉戴鹖冠。\n晷影渐舒閒里度，梅红初上醉中看。\n烧兰暖合芳庭霭，煮茗清分活水湍。\n衰谢却宜春色早，韶华真与意相安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13350,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次黄海野韵寄李翁明斋","author":"赵完璧","text":"壮心飞向白云头，桂窟蓬瀛拟漫游。\n勋业不堪青镜老，璠玙早为碧山留。\n孤踪怅望韶华暮，双眼迢遥烟树稠。\n风月满天春寂寂，相违相忆两无休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13351,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨后夜坐","author":"赵完璧","text":"赤日煎沙苦未休，墨云拖雨倏然收。\n中天霁魄三更昼，一夕新凉六月秋。\n深院无人风细细，古槐垂露夜悠悠。\n坐斜星汉清无寐，酒醒芳庭独自讴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13352,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵登艾山","author":"赵完璧","text":"风尘梦想故山游，白发投簪向急流。\n世路不堪惊险绝，幽怀自合老林丘。\n放歌邈逸青冥鹄，把酒茫然沧海洲。\n黄绮一归紫芝老，白云此日慰乡愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13353,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵刈麦","author":"赵完璧","text":"宦海风波已倦游，东山生计老春秋。\n杜鹃啼歇桑重绿，梅雨晴初麦乍收。\n饼饵香风新足慰，流移此日故还稠。\n巢由何与唐虞事，自是江湖魏阙忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13354,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庭下新凿二小泉","author":"赵完璧","text":"小泉新甃碧泓渟，混沌凿开双眼明。\n入夜沦光动银汉，浮空霁色接沧溟。\n孤居适意寒江破，一片閒心秋影澄。\n不敢濯缨荡萍翠，鱼龙时作雨云冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13355,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七月苦热","author":"赵完璧","text":"才喜新秋不自胜，岂期烦暑转相仍。\n微风小动炉中出，虚阁高凌甑里蒸。\n汗浃徒劳白羽扇，肺乾空想玉壶冰。\n翛然欲奋凌风翼，汗漫清虚去未能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13356,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠江龙所别驾署胶","author":"赵完璧","text":"风流文藻挹英贤，綵笔通灵有异传。\n冀北群空还自负，汉南独步更谁先。\n沧溟治绩曾无右，青史勋名不道前。\n垂老会逢今日盛，相忘夔契醉尧天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13357,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曹文村晚归","author":"赵完璧","text":"斜日荒山返旆旌，野烟迢递暗孤城。\n路迷春草连云碧，水绕寒川隔岸明。\n细雨不禁花外冷，惊风可奈树边声。\n芳菲有兴催归急，每苦登临不称情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13358,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"癸酉夏日赴西庄","author":"赵完璧","text":"翠柳千条拂晓风，乱山如迓拥晴空。\n閒情缓辔蝉声里，幽兴题诗烟霭中。\n野草连天望迢递，人家隔水正冥濛。\n青松短壑遥相慰，一入白云暑自穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13359,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"癸酉七夕","author":"赵完璧","text":"雨霁风清佳夕閒，从人遥指绛河间。\n鹊桥诞妄今何在，牛女虚无岁往还。\n秪以盈盈一水隔，却疑脉脉两情关。\n人间底事仍相乞，梦向颠迷话更艰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13360,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"癸酉秋阅慎几应试晓发感书","author":"赵完璧","text":"一番清爽雨初晴，正是英才折桂行。\n云路秋风香飒飒，海山晓色翠盈盈。\n壮怀有激仍昔日，大笑无成奈后生。\n白发关情还作喜，几家麟凤叠芳声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13361,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王碧溪太守","author":"赵完璧","text":"晋鲁勋名夙所钦，朱幡适慰海之滨。\n苍生旷被岐风旧，白首重看汉吏新。\n妙简无私遭圣主，催科有政属能臣。\n虎牢晚托重关险，犬吠生釐拟诵频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13362,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻试沧海遗珠感赋","author":"赵完璧","text":"精英夙自结骊龙，明月清光重海东。\n拟破幽昏当暮夜，合增辉彩向琼宫。\n沉泥沧浦知谁惜，按剑朱门总未逢。\n安得高风来象罔，便应长价到隋公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13363,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明","author":"赵完璧","text":"春入清明自可游，窃将乐事脱閒愁。\n落花烟里从春酌，细柳风前纵野讴。\n去岁陇添今岁墓，千年人误百年谋。\n六龙不为人间驻，莫遣风尘空白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13364,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"残腊小雪晚晴","author":"赵完璧","text":"小雪随风旋复晴，晚曛独眺自分明。\n云归海浦寒空净，烟迥川原冷玉轻。\n顷刻作花非积素，颠狂为瑞竟虚名。\n冬深不协苍生望，徒遣微阴蔽太清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13365,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书能仁寺上人壁间","author":"赵完璧","text":"十二回廊月正明，菩提相见悟三生。\n法云真际醒尘眼，宝树清阴慰客情。\n一壑泉鸣惊卓锡，半天风下质飞旌。\n金绳梦想开迷境，此日相从憩化城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13366,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五夜不寐","author":"赵完璧","text":"脩篁移影月初沉，青女侵窗夜不禁。\n星下繁机犹在眼，海边归梦尚关心。\n啼残沙雁燕云冷，开遍篱英塞日深。\n辗转寒更浑不寐，愧羁升斗未抽簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13367,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"旅夜","author":"赵完璧","text":"霜清月白酒初醒，呜咽悲笳调凤城。\n纱静老梅横瘦影，庭空疏竹送寒声。\n羁愁多病头应白，王事关心梦不清。\n辗转残更眠未得，宦情争似故乡情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13368,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵秋园晚兴","author":"赵完璧","text":"残照离离带远林，秋园晚色豁尘襟。\n玉栏风细梧桐落，石窦烟涵蟋蟀唫。\n题句恨无堪刻竹，归巢喜有倦飞禽。\n金钱满地知谁惜，醉卧苍苔兴独深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13369,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜月林奉使回京师","author":"赵完璧","text":"他乡大喜故人回，尘抱相从一暂开。\n芝宇三秋孤馆梦，萍踪万里五云偕。\n北风兴逸燕山酒，皎月歌残郭隗台。\n宦海由来无定所，老怀可奈济川才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13370,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"海屋添筹寿尹金峰侍御太翁","author":"赵完璧","text":"关河迢递思无穷，落照苍茫望未通。\n金阙日淹周柱史，碧山云老汉芝翁。\n烟开青鸟揖金母，筹徙沧溟礼木公。\n天泽年来更优渥，紫泥黄阁下清风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13371,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将旦盐城作","author":"赵完璧","text":"窗外惊风飒五更，敝衾时觉冽寒生。\n乍回旅梦闻残鼓，倦写新词向短檠。\n斜月半窗馀纸淡，疏钟几杵带霜清。\n十年不为朝鸡扰，今听儿衙报晓声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13372,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日西庄","author":"赵完璧","text":"炎赫西来耽野芳，古槐疏柳荫茅堂。\n破窗不阻南薰细，深院常涵宿雾凉。\n茵枕清眠移白日，柴门幽启对沧浪。\n杖藜散步平沙晚，悽送鹡鸰泪万行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13373,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南窗昼卧","author":"赵完璧","text":"石床偃仰趁南风，窗落閒云雪倚空。\n一枕清凉三伏外，片时仙梦十洲中。\n凌歊歌舞云飞尽，结绮繁华水自东。\n七尺微躯沧海上，悠然情兴老崆峒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13374,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感蝗","author":"赵完璧","text":"六月飞蝗过目频，奇灾何事苦斯民。\n天空不断回风雪，陇际还惊蔽日尘。\n倏作青娥摧绿野，旋看赤土泣苍旻。\n谁将无食悲生计，秪有催租愁杀人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13375,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵喜雨","author":"赵完璧","text":"阿香驱车海上来，白雨跳波云暗隤。\n灵泽千峰润枯槁，洪泉一息消氛埃。\n荷喧战剧明珠碎，竹净凉生寒玉堆。\n何幸苍生迓天锡，从开一噱一衔杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13376,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"明川","author":"赵完璧","text":"晴碧横开滟滟春，封姨乍息湛天真。\n青冥聚散孤云影，白鸟微茫落日津。\n烟破不知镕鉴客，月临拟有弄珠人。\n清光不借银河色，瑩彻灵襟觉日新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13377,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓过章台","author":"赵完璧","text":"晓霜驱马过章台，弱柳依依门半开。\n梦破巫山云未散，香销鸳被日初回。\n竹低护犬垂朱箔，花落无人扫绿苔。\n满眼烟花无限恨，独输刘阮到天台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13378,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"简吴兴谢生","author":"赵完璧","text":"康乐清风费梦思，敢题凡鸟到门时。\n瑶华日仰今何暮，玉树云停迥未期。\n半夜丝桐还自贮，平生尘榻为谁私。\n碧窗看尽沧溟月，寥落燕山浊酒卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13379,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中趋公","author":"赵完璧","text":"半夜红灯踏雪行，北风凛凛玉珂鸣。\n貂裘被体故仍薄，羔酒冲寒力己轻。\n千里辛劳成底事，一官衰老笑微名。\n海边茅屋何时返，金鉔融融睡到明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13380,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春夜不寐","author":"赵完璧","text":"金柝声残夜已深，鸭炉香灺拥寒衾。\n松根馀雪侵窗冷，竹杪顽云接地阴。\n坐久虚堂春悄悄，梦回琐闼夜沉沉。\n无眠不尽山城漏，暗送啼鸿过北岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13381,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春晓水边感兴","author":"赵完璧","text":"晓策花骢傍水涯，清光何限竟谁知。\n平湖雨霁兼葭绿，曲岸风柔杨柳垂。\n烟渚鸥閒开逸兴，沧洲春晚负佳期。\n尘埃满目空奔走，衰倦应惭归去迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵李南川览赵氏山泉","author":"赵完璧","text":"啼歇莺声午闭关，捲帘长昼看春山。\n洞门花落怜风雨，石窟泉鸣讶佩环。\n幽景不知辞组去，红尘空自羡人閒。\n相过聊对芳菲醉，合释羁怀顷刻间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜晴","author":"赵完璧","text":"封姨夜半驱黑云，羲和海上推朱轮。\n氛埃净洗碧天阔，物色清开玄圃新。\n光景无涯输老眼，觞诗有兴属何人。\n迂疏夙愧抽簪末，白首红尘误此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋晚","author":"赵完璧","text":"孤城秋老欲黄昏，扶杖閒阶踏藓痕。\n芳咀落英来砌畔，吟听促织傍篱根。\n微风病叶先投地，斜日寒烟半在门。\n诗景满庭人独倚，飞鸿送尽水南村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄酬阳信董光禄二首 其一","author":"赵完璧","text":"燕山鸿雁惜离群，二十馀年杳未闻。\n绿野可能敦夙好，凤城长忆醉宵分。\n沧溟迢递劳春梦，岭树苍茫送暮云。\n白发巳衰空桂结，琼枝何以慰清芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄酬阳信董光禄二首 其二","author":"赵完璧","text":"碧筒衔凤翠屏岩，青眼披云白雪篇。\n风雅旷闻金石韵，辉容宛睹玉堂仙。\n东山久亦从疏放，西子那能斗媚妍。\n醉里挥毫何以报，不成金错意茫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13387,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送丘月林制阕还京","author":"赵完璧","text":"故人北上黄金台，烟花春暖沧溟隈。\n荒山人远不相送，仙尘望绝空徘徊。\n十载朝廷慰如渴，九天雨露欣重回。\n岩廊拟翼明圣绩，烟波一竿何快哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13388,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻喜五咏 其一 飞报捷音","author":"赵完璧","text":"痴儿谬附黄金榜，阿祖今酬素日心。\n六纪桂香承杏苑，十年云路到琼林。\n禹门雷吼蛟龙化，魏阙风飞海岱音。\n垂老不知天地报，壮怀记取慎清勤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13389,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻喜五咏 其二 临轩策试","author":"赵完璧","text":"太平天子肃临轩，广辑英贤慎采言。\n金殿日明春昼永，翠帘烟捲御香翻。\n凤鸾际运鸣时盛，豚犬倾愚答圣恩。\n野叟愧无今日训，早期董贾此回论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13390,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻喜五咏 其三 胪传丹陛","author":"赵完璧","text":"瑞腾烟霭溢彤庭，仙御旌幢拂曙星。\n千载龙飞云雨合，九宵綍下姓名馨。\n黄金台上天恩渥，玄锡人间晓梦醒。\n济济凤麟辉日月，儿曹忝窃庆周宁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13391,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻喜五咏 其四 宴赐琼林","author":"赵完璧","text":"琼林赐宴平生慕，粲子何知此日荣。\n玉斝碧桃穷日醉，宫花绿鬓袅烟轻。\n恩光沧海三千里，人在瑶台十二城。\n遥想逢山归路晚，新郎箫鼓竞相迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13392,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]