[{"title":"发南康过左蠡","author":"霍与瑕","text":"朝发南康道，沙洲驷马班。\n寒云连北浦，冻雨合西山。\n物候风霜外，人家水石间。\n征夫惊岁晚，愁思上容颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13060,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都昌晓晴晚别张都阃","author":"霍与瑕","text":"行邑问农桑，江干话更长。\n祈寒思早暖，连雨喜朝阳。\n鼓角穿山壮，旌旗拂树光。\n画眉谁窃喜，明日见张郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13061,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得家书讣仲兄少石仲弟少玉之报 其一","author":"霍与瑕","text":"残腊归南浦，乡亲天际来。\n喜看鸿雁信，忽报鹡鸰哀。\n泮水今谁在，家风近太衰。\n欲知凄断意，冻雪满山台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13062,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得家书讣仲兄少石仲弟少玉之报 其二","author":"霍与瑕","text":"庚寅年以降，甲子未云多。\n尔既先秋萎，吾今奈老何。\n断魂迷绿树，衰泪落沧波。\n白石青山路，无因得再过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13063,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春夜泛湖漫兴 其一","author":"霍与瑕","text":"昨日攀元洞，今宵泛碧空。\n舟航绝星汉，机杼见天工。\n问路迷云渚，知郎有道风。\n水晶仙阙是，努力挂高篷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13064,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春夜泛湖漫兴 其二","author":"霍与瑕","text":"短棹击空明，扁舟似叶轻。\n残星低两汉，缺月上三更。\n木铎他山响，渔歌隔坞声。\n恍疑仙岛近，身世在蓬瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13065,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春夜泛湖漫兴 其三","author":"霍与瑕","text":"天近四更头，风高载月舟。\n短箫悲塞雁，长篴起江鸥。\n农艇纷摇橹，渔罾远挂钩。\n歌豳谁献曝，辛苦遍沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13066,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春夜泛湖漫兴 其四","author":"霍与瑕","text":"弄月不须疑，萧疏半世痴。\n逢人深浅酌，见尔妙高词。\n旧有紫之癖，今仍白出奇。\n幸依卢扁在，箴砭足吾师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13067,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日泛湖漫兴 其一","author":"霍与瑕","text":"匆匆春似水，滚滚向东流。\n细草时迎棹，飞花故傍舟。\n天孙传好句，帝子莫多愁。\n更鼓寻芳楫，光风在隔洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13068,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日泛湖漫兴 其二","author":"霍与瑕","text":"阔水飘银浪，芳汀浸绿云。\n迟迟江柳色，蔼蔼岸花芬。\n旭日渐加永，凉风欲变薰。\n暮春千古意，谁共此微醺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13069,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日泛湖漫兴 其三","author":"霍与瑕","text":"望湖情落落，天远碧萋萋。\n绿树新黄鸟，青山旧锦鸡。\n五风随鹢舫，三户傍渔堤。\n处士高栖在，移舟更水西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13070,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日泛湖漫兴 其四","author":"霍与瑕","text":"谁开姑射镜，人在镜中行。\n映草船船绿，垂杨岸岸明。\n西山云外影，南浦日边声。\n吟弄从吾好，空青一鹤横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13071,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王中宇宪长赍捧入贺赠别 其一","author":"霍与瑕","text":"少壮纡朱紫，朝朝夙在公。\n春官隆体貌，霜节凛威风。\n驷牡驱河朔，夔龙祝华嵩。\n旧臣金鉴在，谁献大明宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13072,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王中宇宪长赍捧入贺赠别 其二","author":"霍与瑕","text":"声名洋溢旧，定远始相逢。\n聚首无多日，倾心见古风。\n道义常相勖，疏狂赖发蒙。\n便知新宠下，何处罄交衷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13073,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"发南浦渡鄱湖杂咏 其一","author":"霍与瑕","text":"出郭风殊好，缘堤景更妍。\n紫鹅依绿草，白鹭点青田。\n水客维秋舰，农家起晚烟。\n始知郊外胜，婉似故乡廛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13074,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"发南浦渡鄱湖杂咏 其二","author":"霍与瑕","text":"渐通湖口路，田家傍碧浔。\n早稻鹅黄嫩，秋枫翡翠深。\n唱歌摇慢橹，打鼓振高林。\n候吏仍津渚，那知物外心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13075,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"发南浦渡鄱湖杂咏 其三","author":"霍与瑕","text":"湖望渺无极，稀微见太嵩。\n船行天汉上，人在月华中。\n长篴关山曲，高帆广漠风。\n独怜牛女渚，无路借媒通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13076,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"发南浦渡鄱湖杂咏 其四","author":"霍与瑕","text":"明月照沧浪，天光接水光。\n朱帘疏度彩，锦簟细生凉。\n酌酒风踰爽，争棋夜未央。\n绣衣船尚远，蒲席莫高张。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陪侯戎院何方伯张都阃东巡避暑铅山观音洞 其一","author":"霍与瑕","text":"骢马出东郊，缘溪剪草茅。\n地分闽越界，天在夏秋交。\n古洞鸣泉籁，晴烟隐树梢。\n纳凉无此胜，吾欲结新巢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陪侯戎院何方伯张都阃东巡避暑铅山观音洞 其二","author":"霍与瑕","text":"远水来青障，横桥锁绿流。\n芳溪循曲径，危石立高邱。\n为避无穷暑，欣逢物外秋。\n华胥仙界在，那更问三洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陪侯戎院何方伯张都阃东巡避暑铅山观音洞 其三","author":"霍与瑕","text":"洞外似沃焦，洞里忽水消。\n六月不知暑，八风常自调。\n尘避庾公扇，泉分巢父瓢。\n隔山丛桂在，何处隐堪招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陪侯戎院何方伯张都阃东巡避暑铅山观音洞 其四","author":"霍与瑕","text":"古寺嗟零落，云岩羡寂寥。\n有峰如卓笔，入洞似乘轺。\n景胜诗偏壮，风多酒易销。\n不知东道主，还肯再招邀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再游青莲洞 其一","author":"霍与瑕","text":"再入青莲洞，阴森路不迷。\n市声听渐远，禾稼出将齐。\n水碓凭龙踏，山梁有雉啼。\n风清兼境寂，真可遂高栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再游青莲洞 其二","author":"霍与瑕","text":"谁说三天界，人间不可通。\n桥从乌鹊渡，洞是广寒宫。\n听奏霓裳曲，坐当阊阖风。\n新诗多逸态，为篆玉霄中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重游石井庵","author":"霍与瑕","text":"昨日鹅湖道，重陪仙侣游。\n断桥新补砌，寒壑旧萦流。\n龙卧魂嫌冷，蝉鸣响及秋。\n东南真胜地，谁与更淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饯侯戎院入闽 其一","author":"霍与瑕","text":"霜威清楚㵝，霓望切闽中。\n六月鹅湖畔，千山鸟道通。\n迅雷驱骤雨，急电引凉风。\n扫尽人间暑，衮衣方始东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饯侯戎院入闽 其二","author":"霍与瑕","text":"搴帷过绝峤，婉在画图中。\n万壑松涛合，千溪竹径通。\n暑涤冰台雨，尘清霜节风。\n独怜违渐远，望断海潮东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饯侯戎院入闽 其三","author":"霍与瑕","text":"忆昔岁初冬，抠趋彭蠡中。\n数言窥度量，一见仰明通。\n业有传家旧，文当媲国风。\n每于清宴暇，时嗟小大东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饯侯戎院入闽 其四","author":"霍与瑕","text":"渊谟人莫测，言论每时中。\n调鼎真和燮，垂规有变通。\n豺狼潜秽迹，凰凤煽祥风。\n江表经纶绪，应知遍海东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饯侯戎院入闽 其五","author":"霍与瑕","text":"追陪五花骢，祖饯万峰中。\n薄暮山家宿，先秋凉气通。\n驿楼更断雨，官角韵随风。\n永念不成寐，明朝吾道东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春和卢星野方伯韵杂兴 其一","author":"霍与瑕","text":"野鸟唤关关，熹微岁腊残。\n陇梅新叶暗，棠棣旧枝寒。\n醒眼无多梦，繁忧有百端。\n沧江烟艇稳，便欲把渔竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春和卢星野方伯韵杂兴 其二","author":"霍与瑕","text":"云雨暗山窗，残书乱竹床。\n倦游思稳睡，知止且深藏。\n风暖菜花烂，烟轻草树光。\n更堪供美馔，芹叶涧边长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春和卢星野方伯韵杂兴 其三","author":"霍与瑕","text":"新酿流连熟，吾生更曷求。\n招招清海侣，日日醉乡游。\n有亭名佚老，拄杖自寻幽。\n彼美今何处，相思西阁楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春和卢星野方伯韵杂兴 其四","author":"霍与瑕","text":"寡合知无援，多言得屡憎。\n自嗤三已仕，深愧上乘僧。\n去国嗟年暮，持家尚夙兴。\n他时遗世谱，清白或壶冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春和卢星野方伯韵杂兴 其五","author":"霍与瑕","text":"昔逐孤山伴，曾抄种树书。\n春来荒圃润，归去学畦蔬。\n带月便高笠，开云借小锄。\n挥金谁氏子，隔壁老陈馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春和卢星野方伯韵杂兴 其六","author":"霍与瑕","text":"春来馀十日，日日雨霏霏。\n海上鲸波恶，天边雁信稀。\n入市黄花贱，回潮白蟮肥。\n浊醪还可醉，莫问羽书飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春和卢星野方伯韵杂兴 其七","author":"霍与瑕","text":"吮舐嗟流俗，叔疑岂异哉。\n蝇声纷止棘，蛇影每侵杯。\n枸杞参差长，桃花次第开。\n春风如许趣，行乐且蒿莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春和卢星野方伯韵杂兴 其八","author":"霍与瑕","text":"少负豪雄气，先贤谓易过。\n贾涕嗟太甚，廉饭恨空多。\n通塞谁知命，功名老作魔。\n祇今凭法水，一洒永清和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春和卢星野方伯韵杂兴 其九","author":"霍与瑕","text":"投老归村落，交游总旧知。\n春灯先打谜，社席更争谁。\n灌药分新水，编藤补破篱。\n老农仍老圃，聊得共生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春和卢星野方伯韵杂兴 其十","author":"霍与瑕","text":"前身谁照邻，标格足清真。\n郁水有馀乐，云庄无限春。\n诗篇都大雅，文字逼先秦。\n终似飞升去，水晶宫里人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春和卢星野方伯韵杂兴 其十一","author":"霍与瑕","text":"春诗无次序，聊寄旧同袍。\n蚁吠声何巨，鹪飞翼更高。\n看花迷雾眼，掩镜有霜毛。\n落落长吟兴，除非借酒豪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春和卢星野方伯韵杂兴 其十二","author":"霍与瑕","text":"立春今岁早，春色杳无边。\n忙办游春席，仍呼隔海船。\n村沽频续罍，酒债借征廛。\n骤雨新濠涨，西湾任急前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春再和韵杂兴 其一","author":"霍与瑕","text":"灼灼桃烽烂，匆匆梅阵残。\n燧更新岁火，炉战旧冬寒。\n虚席客殊绝，执弓人颇端。\n结交沧海上，皓白且垂竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13102,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春再和韵杂兴 其二","author":"霍与瑕","text":"云容迷绮幕，雨气湿绳床。\n紫蟹偏宜炕，黄柑得善藏。\n开樽分岁事，觅句答年光。\n更与仙山侣，围棋引日长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13103,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春再和韵杂兴 其三","author":"霍与瑕","text":"丁丁歌伐木，啼鸟故相求。\n国有牛医子，人推马少游。\n款段寻春远，追陪选地幽。\n南园时一涉，遥见粤山楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春再和韵杂兴 其四","author":"霍与瑕","text":"独立吾知我，何妨多口憎。\n磨砻还美玉，彗定亦高僧。\n弄月歌仍啸，临风坐复兴。\n恍疑春已暮，岭外少泮冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春再和韵杂兴 其五","author":"霍与瑕","text":"夕除寒不寐，挑烬对残书。\n献岁供香粉，迎春剪细蔬。\n野花随乱放，庭草不教锄。\n亲旧时来下，追欢半醉馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春再和韵杂兴 其六","author":"霍与瑕","text":"朔云连月密，知是雪雱霏。\n西土人云靖，北门出故稀。\n彗星新法象，朝贵旧轻肥。\n时事知何似，犀觥且屡飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春再和韵杂兴 其七","author":"霍与瑕","text":"天皇留相国，兹事果康哉。\n勉勉垂温语，频频赐御杯。\n亲丧时遣使，帝德日宏开。\n会睹盐梅合，鸿恩遍草莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春再和韵杂兴 其八","author":"霍与瑕","text":"馀生仍有几，岁月忽虚过。\n适意事常错，操心闵既多。\n断藤今借剑，坚壁任飞魔。\n守一从吾好，绵绵保太和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春再和韵杂兴 其九","author":"霍与瑕","text":"脉脉此趺坐，洗心还自知。\n有言俱剩语，无隐更关谁。\n移桂添新土，勾花结短篱。\n缊袍时向曝，扪虱是生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春再和韵杂兴 其十","author":"霍与瑕","text":"静里看玄化，林林总是真。\n鸡鸣风雨夜，龙见水云春。\n蜉蝣衣自楚，鹦鹉语能秦。\n万物人皆备，成人今几人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春再和韵杂兴 其十一","author":"霍与瑕","text":"明志宜蔬食，便身祇布袍。\n从奢难入俭，自下可升高。\n渥产多龙种，瀛洲有凤毛。\n后生基搆重，承绪属英豪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春再和韵杂兴 其十二","author":"霍与瑕","text":"欲买西郊地，新濠鬼驿边。\n晚归江浦渡，春荡柳波船。\n山外开三径，花间受一廛。\n芳邻千万贯，祇在帽庄前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"二月二十一日清明如樵展扫 其一","author":"霍与瑕","text":"久负西樵约，今朝见四峰。\n日中星正鸟，春晚月初笼。\n绝径宜山屐，缘溪可水舂。\n桃源知不远，花气霭溶溶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"二月二十一日清明如樵展扫 其二","author":"霍与瑕","text":"冲云迷咫尺，不记旧山腰。\n雨骤便高帽，溪深得短桥。\n岩花红楚楚，野竹绿萧萧。\n多少来游客，春心可奈骄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"二月二十一日清明如樵展扫 其三","author":"霍与瑕","text":"清明山务急，四远集纷纷。\n雾里縠如雾，云中女似云。\n采茶歌自细，隔叶语微闻。\n断尽征人目，罗敷正不群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"二月二十一日清明如樵展扫 其四","author":"霍与瑕","text":"野鸟歇芳晨，黄莺失暮春。\n云深偏足雨，雷细不惊人。\n峻壁存三户，穹岩绝四邻。\n到时近昏黑，衣袂湿纷缤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"二月二十一日清明如樵展扫 其五","author":"霍与瑕","text":"天晚度山南，荒邱歇小骖。\n雨花封短砌，烟树锁澄潭。\n邃阁盈新藓，遗书忆旧函。\n童年庭训地，悽断可能堪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"二月二十一日清明如樵展扫 其六","author":"霍与瑕","text":"天皇垂世泽，高冢赐封题。\n手植雪梨在，眼看风木萋。\n香灯春雨涩，拜跪少年齐。\n信有流光远，跄跄执币圭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"二月二十一日清明如樵展扫 其七","author":"霍与瑕","text":"本源同水木，雨露总遐思。\n白纸山山簇，红花帽帽欹。\n舟车随远近，坟墓遍高卑。\n开凿何为者，苍空鉴不迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"二月二十一日清明如樵展扫 其八","author":"霍与瑕","text":"独上高楼上，清歌一拊阑。\n鬓斑春冉冉，心远路漫漫。\n旧壁留题壮，新亭纵饮难。\n吾衰知己甚，天暖觉偏寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得同亭杂咏 其一","author":"霍与瑕","text":"风雨晦冥冥，独坐得同亭。\n微茫松隔水，萧飒竹临汀。\n远意空千古，春山且一瓶。\n醉来歌白石，天晚少人听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得同亭杂咏 其二","author":"霍与瑕","text":"古岸簇青莎，同亭枕碧波。\n野云连树密，春水过田多。\n村女坭侵骭，郊童雨满蓑。\n不知农作苦，群唱插秧歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得同亭杂咏 其三","author":"霍与瑕","text":"山村长夏静，爽气袭涟漪。\n接水都荷芰，临流尽荔枝。\n树怜先世植，花忆去年移。\n漠漠江天思，谁当共赋诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得同亭杂咏 其四","author":"霍与瑕","text":"八仙分水槛，四老共浮槎。\n轮日排蔬果，迎风酌藕花。\n隔山疑有洞，深巷是谁家。\n佛隐来寻惯，篙师莫近沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得同亭杂咏 其五","author":"霍与瑕","text":"澄潭覆晓烟，小艇日高眠。\n紫禁非无梦，沧洲合有缘。\n豸衣仍在笥，蚁酒且如船。\n心曲凭谁寄，孤鸿没远天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得同亭杂咏 其六","author":"霍与瑕","text":"白露下青草，微凉透葛衣。\n江天静烟霭，风日有光辉。\n鹅鸭家家闹，鸡豚在在肥。\n秋成人共乐，社报醉忘归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]