[{"title":"题张山人子嘿孝思卷","author":"黎民表","text":"已向沧洲老，还从燕市游。\n行藏丹检在，风月锦囊收。\n搦管云生纸，披衣雪满裘。\n江湖千里梦，犹忆到松楸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5712,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠医士姚允升","author":"黎民表","text":"蚤年耽内学，一室事医王。\n蓟子传仙术，桐君与药方。\n终朝常扣齿，一榻自焚香。\n若访丹砂去，双凫问草堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5713,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大司马东沙张公挽诗 其一","author":"黎民表","text":"故老三朝尽，芳名一代尊。\n麒麟身未画，丘壑道终存。\n赤水馀篇翰，丹霄投梦魂。\n千秋文冢在，荣耀竟谁伦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5714,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大司马东沙张公挽诗 其二","author":"黎民表","text":"典午馀勋伐，中朝尚典刑。\n书能穷左史，文竟薄玄经。\n紫气终难翳，沧波逝不停。\n疏才惭许与，头白尚飘零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5715,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读书楼为曾阳白先生赋","author":"黎民表","text":"风月昔登临，丹梯尚可寻。\n青藜天禄阁，白雪郢中吟。\n几席岚霏湿，轩窗露气深。\n琅然云水外，犹是凤鸾音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5716,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"锦标轩","author":"黎民表","text":"锦帜中流得，泥金上国来。\n衣冠通两世，星象接三台。\n题柱荆山积，雕楹汉水开。\n桓荣稽古力，千载复论才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5717,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西圃馀清","author":"黎民表","text":"野望通云上，衡门在水西。\n骚人搴薜荔，游客唱铜鞮。\n橘树千林遍，桃花隔岸迷。\n凤毛霄汉在，垂钓任清溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5718,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭徐子与六首 其一","author":"黎民表","text":"岳牧才名大，中朝礼数优。\n天文垂左辖，风谊起南州。\n羽卫森开府，江山自倚楼。\n玺书虽未下，为政已风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5719,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭徐子与六首 其二","author":"黎民表","text":"词场应冠绝，心匠亦兼能。\n崛起无前辈，雄飞值中兴。\n浮沉玄理胜，时俗吏才称。\n往事穹碑在，千秋下马陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5720,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭徐子与六首 其三","author":"黎民表","text":"苍苍不可问，叹逝每如斯。\n岂意长安酒，为君永诀时。\n鸿都今绝笔，大雅久无诗。\n不独风流尽，文章属数奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5721,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭徐子与六首 其四","author":"黎民表","text":"无书才几月，委蜕得非真。\n道丧应歌凤，吾衰更泣麟。\n簿书聊偶世，时命仅同人。\n醉墨纵横处，星沉霅水滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5722,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭徐子与六首 其五","author":"黎民表","text":"讼牒常移少，高斋日扫除。\n故人无政府，门客满公车。\n酒德应堪颂，官箴亦未疏。\n汝南多赋客，犹是大风馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5723,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭徐子与六首 其六","author":"黎民表","text":"中原称五子，附骥亦纷纷。\n国色应殊众，清言独见君。\n不逢非汉谶，垂老见雄文。\n凄切邻人笛，长安醉后闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5724,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林计部德基同丘使君谦之陈山人汝信自通州泛舟送予至潞河","author":"黎民表","text":"赖是官曹简，何妨胜事偏。\n金章参野褐，青黛倚楼船。\n宿鹭惊人起，残虹傍雨悬。\n空江回骑吏，留兴绿尊前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5725,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别丘谦之以苏晋图奉赠","author":"黎民表","text":"岂谓逃禅者，临岐欲别难。\n昔联东省玉，今佩楚江兰。\n落日催回舸，春风岸客冠。\n披图见颜色，何异屋梁看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5726,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠顾舍人","author":"黎民表","text":"东阁多奇士，文章未陆沉。\n诗言自匡鼎，家学得刘歆。\n出入清华地，翻飞翰墨林。\n交情元竹下，况乃接朝簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5727,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鴳适斋为朱张水文学赋","author":"黎民表","text":"一室蓬蒿下，清斋似杜机。\n但求栖息稳，不恨稻粱微。\n喜客开山笥，乘閒款竹扉。\n山川一何广，黄鹄待翻飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5728,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同谦之丘使君自天宁寺骑至西湖上","author":"黎民表","text":"欲送残春去，长堤日已曛。\n村舂隔水远，浦树到湖分。\n惜别贪携手，行吟独共君。\n莫惊沙上鸟，飞去各青云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5729,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙潭","author":"黎民表","text":"何年龙已去，野色澹荒陂。\n元气回深洞，阴风出古祠。\n探珠寻赤水，沉璧问清时。\n牧竖犹回首，千灵访具茨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5730,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿瑗上人房","author":"黎民表","text":"久客应难寐，中宵独据床。\n心无蕉鹿竞，梦已路途长。\n曙色斋钟动，行厨野蔌香。\n更衣问前路，惆怅别云房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"功德寺牡丹","author":"黎民表","text":"一径交深竹，千丛暗野堂。\n碧疑天女唾，花是佛王香。\n绝艳休相妒，佳期不可忘。\n飘零一杯酒，长啸望西房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"华岩洞有耶律楚材故桓夏公石刻","author":"黎民表","text":"深壑因谁造，挥斤亦有神。\n江山留王气，题咏待词人。\n泉作窗间雨，苔生石上尘。\n碧纱笼底墨，萧索竟千春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望湖亭","author":"黎民表","text":"层崖出天半，应接颇纷纭。\n山合溟濛雨，湖通来去云。\n春风吹桂棹，野日散鸥群。\n一片江南色，吟思越鄂君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酌玉亭上","author":"黎民表","text":"登山方改屐，把酒爱临流。\n龙去还成雨，风鸣并作秋。\n开奁鸿照影，弭盖凤经游。\n绝胜频来往，毵毵笑白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同谦之午憩金口寺石榻上","author":"黎民表","text":"济胜心无己，看山日暂停。\n梦回云屋冷，衣藉石床扃。\n佛境看如幻，尘途笑独醒。\n僧房无所供，亦自遣沉冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慰慈上人坠马","author":"黎民表","text":"经禅不出户，山色举头新。\n绝磴应妨马，危途转畏人。\n尘劳余裹足，电路尔观身。\n莫更生嗔恼，西游本宿因。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丘谦之下碧云寺予往香山两作速归","author":"黎民表","text":"出谷应疑早，看山欲去迟。\n日斜人影独，林薄鸟声悲。\n咫尺犹相去，逢迎重有期。\n不嫌骑马倦，难和碧云诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同邬汝翼黄清甫陈崇训汪公干李季常过焦山访郭次甫","author":"黎民表","text":"钓鳌生远兴，歌凤上高台。\n海气风吹断，江流树引回。\n莓苔行径滑，钟梵寺门开。\n如此佳山水，生涯几度来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桐庐道中寄谢侍御 其一","author":"黎民表","text":"有美吴山水，星轺宠命新。\n涛声驱海曲，风采肃朝绅。\n入社推高足，追班沗近臣。\n未酬虚左席，长愧报恩身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桐庐道中寄谢侍御 其二","author":"黎民表","text":"剑气凌东越，奎文映紫垣。\n人伦开藻鉴，礼数起龙门。\n白发存知己，丹心奉至尊。\n汉庭如物色，虚薄讵须论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答邻止少侯","author":"黎民表","text":"高步谁能似，名驹本帝家。\n向人操白雪，投迹寄青霞。\n宾榻频开醴，山窗屡试茶。\n清言疲梦想，丛桂又开花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与梁少仲林开先汲古亭夜坐","author":"黎民表","text":"归来无所适，剩有草玄亭。\n岩溜千丝滴，云萝四壁青。\n燃灯听佛偈，酌酒试茶经。\n若论浮生理，惟知醉与醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少仲开先过宿山楼","author":"黎民表","text":"数过争悬榻，乘閒就隐居。\n竹风披卧簟，松火照山厨。\n远梦觉幽鸟，清神把道书。\n长歌云水外，豪气不曾除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石羊馆为郭学宪赋","author":"黎民表","text":"一室类安禅，铜梁策骑旋。\n试看持节日，犹似下帷年。\n花气迷春岛，藤阴覆玉泉。\n清吟不觉夜，月在石桥边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归田杂咏十二首 其一","author":"黎民表","text":"一雨淹晨暮，閒居似避喧。\n邻人难假盖，樵客少过门。\n脱粟应妨罄，残书懒自翻。\n本无经济术，藏拙在乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归田杂咏十二首 其二","author":"黎民表","text":"近卜城西地，新畬渐可耕。\n耰锄课童仆，丰俭付阴晴。\n白水分畦映，青烟冒垄平。\n萧然茅屋底，无力谢生成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归田杂咏十二首 其三","author":"黎民表","text":"一丘堪偃卧，暇日掩柴扉。\n山果垂藤熟，林莺接翅飞。\n春风难再得，世事况多违。\n但坐南窗下，休论昨日非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归田杂咏十二首 其四","author":"黎民表","text":"颇怪频年事，江湖屡滞游。\n王程妨野寺，身世落渔舟。\n徒费千金伎，空馀一敝裘。\n素丝虽可叹，知足亦何忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归田杂咏十二首 其五","author":"黎民表","text":"鹏阁曾三入，龙门幸一登。\n散才当艺苑，妙语属山僧。\n交态看贫贱，荣途有爱憎。\n机心今已矣，稳卧玉山层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归田杂咏十二首 其六","author":"黎民表","text":"家传馀万卷，世故半凋零。\n虽识数行墨，终销两鬓青。\n人多矜敝帚，世复笑玄经。\n但饮尊中酒，胜于案上萤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归田杂咏十二首 其七","author":"黎民表","text":"久欲游衡岳，轻舟信所如。\n川程限楚越，生计系樵渔。\n未种龙洲橘，先驰汶岭书。\n四愁无处写，胜事恐成虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归田杂咏十二首 其八","author":"黎民表","text":"浮丘吾郭近，策杖屡经过。\n神室无留火，沧溟有逝波。\n灵踪天亦秘，遐举事如何。\n乘屩非吾意，空悲去日多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归田杂咏十二首 其九","author":"黎民表","text":"岂谓归田拙，幽居事足娱。\n虫鱼诠古刻，山海咏新图。\n名已落朝藉，身当隐市沽。\n虽无乡里识，亦懒著潜夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归田杂咏十二首 其十","author":"黎民表","text":"苦忆平生友，怜予颇好奇。\n能供光禄酒，常和法曹诗。\n宦拙骑官马，朝回补竹篱。\n风尘关塞黑，魂梦故来迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归田杂咏十二首 其十一","author":"黎民表","text":"短衣殊入宋，凭轼似经蒲。\n宦辙十年有，乡书累月无。\n推毂庙廊在，归山酒伴孤。\n白头惟强饭，亦足慰长途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归田杂咏十二首 其十二","author":"黎民表","text":"自卜三间隐，宁多二仲贤。\n王家甥舅易，何氏弟兄禅。\n琴酒中年辍，江湖远梦悬。\n浮云尔何物，不似渌尊前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西庄迟梁少仲林开先过访 其一","author":"黎民表","text":"林霏将欲敛，瓜地正堪耘。\n隔竹频呼酒，开轩一待君。\n拿音出浦远，人影过桥分。\n莫谓馀西日，临堂见碧云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西庄迟梁少仲林开先过访 其二","author":"黎民表","text":"二妙联镳至，尘襟顿觉披。\n山风吹薜荔，野日澹茅茨。\n浮白君能醉，还丹我较迟。\n莫论风共雨，俱是入林时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梁少仲林开先招游西池泛舟 其一","author":"黎民表","text":"岁月欺人得，乘閒只浪游。\n看花迷浦口，回棹泊沙头。\n细雨孤村暝，凉风野树秋。\n无心论去住，云水共悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梁少仲林开先招游西池泛舟 其二","author":"黎民表","text":"近出循西水，中流具画船。\n清游藉朋好，适兴任江天。\n鲙落金盘细，杯行野割鲜。\n当垆怜少妇，不解惜华年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同赵太史游罗浮宿冲虚观","author":"黎民表","text":"寒宵无击柝，把剑起鸡鸣。\n紫阁浮生梦，沧洲独客情。\n风回瑶室响，云去铁桥平。\n何处参差发，乘鸾朝玉京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庞太守湛别驾招同赵太史周明府叶刺史祁孝廉张茂才饮青霞楼","author":"黎民表","text":"五马能供具，关门驻使车。\n饭香抄白石，酒味沥丹砂。\n入幕风初起，扳林日未斜。\n笙歌临路发，归去葛洪家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同赵太史诸公过叶刺史石洞","author":"黎民表","text":"怜君专一壑，犹是俸钱馀。\n涧水锵鸣玉，云萝引曳裾。\n山都能送酒，木客解窥书。\n予亦瑶台客，过逢两鹿车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同诸子憩玉女峰瑶石台下","author":"黎民表","text":"飞云烟雾里，流水自潺潺。\n一片瑶台石，飞来积翠间。\n月应临晓镜，风为敞玄关。\n玉女休相笑，予方鍊大还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄龙洞听赵太史与诸生讲学","author":"黎民表","text":"钓鳌遗旧迹，水石有黄龙。\n使者乘轺至，诸生挟筴从。\n晨餐长白粥，夜坐石楼钟。\n讵意风雩乐，还于世外逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水帘洞畬人献酒","author":"黎民表","text":"暂憩云门外，冬衣亦尚寒。\n风烟词客赏，薇蕨野人餐。\n白雨怀中落，残红岛外看。\n临流何所羡，吾已挂尘冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王鹅峰有钜石可隐赵太史题曰千丈厓","author":"黎民表","text":"翠削逾千仞，嵌空若二陵。\n下方雷雨合，阴洞鬼神凭。\n起坐心犹掉，艰危气益增。\n何人劖石壁，文字暗苍藤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱明洞见梅花","author":"黎民表","text":"南园多嘉树，繁花旧有村。\n天应留绝艳，仙为返香魂。\n雪后深缘壑，风前半掩门。\n一枝难折寄，惆怅到黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"社中诸公怀予游罗浮归而奉答","author":"黎民表","text":"名山期独往，采药不同君。\n夜听罗浮雨，心摇桂水云。\n风尘终自远，鸾鹤可为群。\n惟有东林社，斋钟讵复闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同李季常汪公干过林开先草亭","author":"黎民表","text":"万木俯城闉，空亭绝四邻。\n竹清娱永日，花发占残春。\n认草成书带，行蔬岸葛巾。\n衡门常昼掩，时过好奇人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浴佛日同汪公干李季常邓君肃黄公补梁少仲林开先过小东林 其一","author":"黎民表","text":"隐树为莲座，鸣螺集梵筵。\n不知成佛后，犹记下生年。\n义岂因文字，心难灭世缘。\n閒来林下坐，亦是小参禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浴佛日同汪公干李季常邓君肃黄公补梁少仲林开先过小东林 其二","author":"黎民表","text":"净业无多地，经禅只五君。\n襟期同月朗，经卷借兰薰。\n苏晋犹耽酒，周颙久绝荤。\n纵然离世网，终未断知闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿端溪口","author":"黎民表","text":"风烟犹故土，信宿亦长途。\n水绕羚羊峡，山藏明月湖。\n平沙渔火乱，远戍角声孤。\n津吏休相问，沧波一钓徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同梁思立邓君肃梁少仲林开先宿梅庵","author":"黎民表","text":"名山宜结夏，亦自断尘情。\n支竹同僧懒，煎茶爱水清。\n石间移席坐，松下挟书行。\n但惬浮生兴，无忧佛不成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠聪上人","author":"黎民表","text":"移住端溪寺，还因古佛缘。\n梅花清倚阁，野水细通泉。\n夜续传灯偈，贫资卖药钱。\n壮游君不见，来此十经年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"烂柯山","author":"黎民表","text":"白石经时烂，仙踪岂易寻。\n但传看奕去，不记入山深。\n蛮触悲人世，沧桑阅古今。\n丹砂君莫问，对酒且披襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八贤祠","author":"黎民表","text":"万里南冠客，生涯老瘴溪。\n庭荒新薜荔，阶长旧吾提。\n孤愤堪填海，遗踪独杖藜。\n暂来无絮酒，泪落楚云西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中读泰泉先生文集","author":"黎民表","text":"光岳留遗草，功名逐逝波。\n祥麟悲鲁史，孤凤避云罗。\n一代风流尽，馀生感慨多。\n夜台今拱木，吾敢拟西河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新邑","author":"黎民表","text":"本意通茅箐，谁知摧钓舟。\n野田荒䆉稏，山木叫钩辀。\n转饷悬孤戍，开边实隐忧。\n槎头成稳坐，浮海任悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]