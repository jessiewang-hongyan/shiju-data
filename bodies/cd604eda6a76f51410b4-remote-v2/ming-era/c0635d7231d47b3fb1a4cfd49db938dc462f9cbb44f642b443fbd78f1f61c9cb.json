[{"title":"十四夜对月集陶良伯","author":"何景明","text":"陶令堂中月，深更酒为携。\n金波流未满，白露迥含凄。\n鸿雁秋江北，芙蓉汉苑西。\n一杯同帐望，万里各羁栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":554,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十六夜月集侯汝立","author":"何景明","text":"秋月尚不减，客堂清宴阑。\n把杯看玉兔，驻马簇金鞍。\n渐觉岁时暮，况惊关塞寒。\n霜笳中夜发，叶落满长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":555,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜集勤甫宅时秉衡至","author":"何景明","text":"同乡耽宴集，浮岁感飘零。\n况复故人至，相邀明月亭。\n琴清繁玉露，坐久密秋星。\n从此冀佳贶，无忘瑶草青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":556,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同崔子钟过董文玉宅","author":"何景明","text":"崔生亭伯兴，董子仲舒才。\n不为相邻近，那能数往来。\n霜天留把菊，风槛促行杯。\n尚忆秋参落，酣歌送我回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":557,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十月四日过良伯","author":"何景明","text":"古堂秋色暮，霜昼静烟沙。\n邻并常杯酒，寒天尚菊花。\n流云行苑细，返景抱檐斜。\n只雁南翻去，飘飘各念家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":558,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜集世其次戴子韵","author":"何景明","text":"醴酒燕京夕，朱弦楚客心。\n情亲不觉醉，慷慨岂忘吟。\n哀柝霜天迥，丛篁雪馆深。\n江湘旧行地，何日更南寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":559,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正月四日同子纯过刘汝忠次韵二首 其一","author":"何景明","text":"并辔来仙第，深杯好共挥。\n远天初夜色，新月更春辉。\n灯夕看相近，花时会莫稀。\n云霄望羽翼，真喜接高飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":560,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正月四日同子纯过刘汝忠次韵二首 其二","author":"何景明","text":"邂逅怜新岁，朱弦为客挥。\n风春归柳色，月夕助灯辉。\n歌酒三人共，乾坤一笑稀。\n看君俱妙思，操翰忽如飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":561,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"顾以行诸客见访次韵","author":"何景明","text":"海内朋簪盍，天涯意气亲。\n雪峰斜暮景，霜草劲寒春。\n客席留尊久，仙曹染翰新。\n诸君千里骏，霄汉迥风神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":562,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"人日斋居过王德徵","author":"何景明","text":"斋居春昼冥，独过子云亭。\n雨雪逢人日，江湖问客星。\n望来花渐发，愁剧柳还青。\n更话东归棹，遥遥海思停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":563,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立春管汝济见过次韵","author":"何景明","text":"胜日高人过，蓬门气色新。\n青榆初改岁，白卜共尝春。\n鼓吹阗京邑，楼台接汉津。\n扳留慨时序，晤语觉情亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":564,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寺中张子言自浙来话","author":"何景明","text":"石阁晴云抱，花宫夕漏催。\n我游天姥梦，尔向海门回。\n日月双龙剑，乾坤一酒杯。\n山中问百草，早晚折春雷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":565,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜过刘以道兄弟","author":"何景明","text":"风灯悬岸馆，竹色静春沙。\n山水停湘瑟，池塘到谢家。\n雪融花尚细，烟袅柳初斜。\n对酌情亲夜，能无恋物华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":566,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过城南寺","author":"何景明","text":"出城春渐近，到寺日犹高。\n野望增楼閤，沙行散竹桃。\n吏情双白鸟，世故一青袍。\n苦被微名系，乾坤无地逃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":567,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过以道喜其弟以正至限韵得衣字","author":"何景明","text":"美人今夕酒，行子暮春衣。\n常念贤兄弟，经年望尔归。\n喜占乌鹊噪，愁忍鹡鸰飞。\n谑浪相逢地，银缸照益辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":568,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出游城南寺","author":"何景明","text":"楼閤倚清妙，春寻景未斜。\n听莺到竹院，并马入桃花。\n不倦登山屐，犹迟泛海槎。\n芳樽烂熳倒，吾醉亦忘家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":569,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王寿夫过分韵得吾字","author":"何景明","text":"自别君昆弟，同游独愧吾。\n十年常道路，万里各江湖。\n乍见形容异，相思梦寐俱。\n向来飞动意，执手五云衢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":570,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明日同诸友游城南寺","author":"何景明","text":"风昼人游少，沙郊马并行。\n穿花寻野寺，冒雨出春城。\n骨肉新伤泪，宾朋远至情。\n天边有芳草，故向客愁生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":571,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子纯邀过东卿","author":"何景明","text":"朝回闻折简，骑马过西邻。\n把酒对今雨，看花逢故人。\n云阴初薄暮，莺啭尚馀春。\n向日江湖梦，飘零见尔频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":572,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"亮公房雨后","author":"何景明","text":"夕宿钿林院，萧萧竹树分。\n风雷回骤雨，星月度微云。\n妄色空中灭，名香静处闻。\n早知禅可托，末忍去人群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":573,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀麓堂集将游东园以风雨遂止二首 其一","author":"何景明","text":"仲夏阴晴半，林塘水石隈。\n窗云开远色，檐日度轻雷。\n雨阻东山屐，天留北海杯。\n门墙接苑树，长昼得迟回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":574,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀麓堂集将游东园以风雨遂止二首 其二","author":"何景明","text":"东圃春馀丽，西亭昼不哗。\n雨来留听竹，风起罢看花。\n堂是裴公野，庄仍李相家。\n庭阶有碧草，早见茁兰芽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":575,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李川甫戴时亮过访","author":"何景明","text":"岂是高人室，能劳二妙来。\n炎天西雨豁，深院郁蒸开。\n改革因风树，留尊对晚苔。\n高吟俱感激，琴罢转馀哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":576,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮雨刘以正过饮","author":"何景明","text":"骤雨暮不止，轰雷昨夜奔。\n炎蒸三伏破，风雾二仪昏。\n款客深投辖，宽愁细倒尊。\n秦川与楚塞，留滞两乡魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":577,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鉴上人房访太和兄饮","author":"何景明","text":"雷雨思炎月，尘沙苦冀方。\n久?河朔饮，今醉雪山乡。\n萝月摇丹牖，松云抱石堂。\n怜君依宿地，棋簟转清凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":578,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同川甫寺中避暑","author":"何景明","text":"偶到清凉地，番思苦热哀。\n水堂菡萏折，风殿薜萝开。\n逃暑无三伏，凭虚有一台。\n西山昼雷雨，不见洗天来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":579,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同李川甫邹子家过张子言舍","author":"何景明","text":"白昼风雷过，城波静碧沙。\n湿云翻抱暑，西日半笼花。\n元礼舟堪并，邹阳赋更嘉。\n同游仲蔚宅，杯酒重年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":580,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访子容自荆州使回二首 其一","author":"何景明","text":"使节荆门返，文章楚郡传。\n綵云神女赋，班竹帝妃篇。\n吊古南游日，忧时北上年。\n停杯问世事，转眼几回迁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":581,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访子容自荆州使回二首 其二","author":"何景明","text":"下马逢今雨，东堂觅旧醅。\n入秋翻暑湿，过午复云雷。\n花已经年放，人今万里回。\n世情吾懒道，但饮莫停杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":582,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中刘汝忠过对棋观诗谈边事作","author":"何景明","text":"城晚客居静，边秋胡马多。\n黑云浮日动，白雨映天过。\n谢傅惟棋局，刘琨只啸歌。\n异时安见汝，谈笑却干戈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":583,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋十三日子容楼","author":"何景明","text":"对酒中秋日，凭栏万里遥。\n风高塞国雁，月近海门潮。\n兴逐燕歌起，魂从楚望销。\n无边汉宫柳，烟色昼萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":584,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十四夜李川甫宅","author":"何景明","text":"独院淹杯酌，高秋惊旅魂。\n风蝉急白露，沙叶静黄昏。\n月上看天柱，潮来望海门。\n平生壮游志，非尔向谁论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":585,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十五夜刘子纬宅子静初至对月","author":"何景明","text":"长安今夜月，复满桂花轮。\n笛里三年泪，尊前万里身。\n关山上云雾，楼閤下星辰。\n况接离群友，悲歌对怆神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":586,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月一日过刘氏昆弟对菊","author":"何景明","text":"谢庭看朔菊，楚客醉燕邦。\n琼树元相对，金花亦自双。\n霜云阴夕院，灯火灿秋窗。\n待到重阳日，还来倒玉缸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":587,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同许补之刘子纬登定州塔","author":"何景明","text":"塔閤盘空上，笙箫绕洞行。\n悬梯出万井，飞盖府孤城。\n燕岱风云色，滹沱雁鹜声。\n登高并回首，直北是神京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":588,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜集锦夫同本贞限韵","author":"何景明","text":"万里同乡友，飘零叹此逢。\n江山饶涕泪，岁月老形容。\n风散城边角，云传海上烽。\n中原尚格斗，未可问云松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":589,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"绣水晴澜","author":"何景明","text":"独怜绣溪水，却出锦屏山。\n岸夹桃花浪，沙明碧石湾。\n泛霞开漱滟，乘月弄潺湲。\n千载高人去，谁来钓此间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":590,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"以行自西山还相访","author":"何景明","text":"闻汝西山去，题诗十日还。\n独行翠微里，应到玉泉湾。\n石璧云孤袅，冬岩菊自斑。\n烟霞发妙思，高咏眇尘寰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":591,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜归昌化寺","author":"何景明","text":"日落归山刹，松风处处声。\n幽深不易到，昏黑更多惊。\n壑断寻溪入，峰回截岭行。\n兹游藉朋好，奇绝冠平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":592,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"平坡","author":"何景明","text":"晚眺平坡上，苍茫万壑前。\n一僧行树杪，诸客到寒天。\n险骇将崩石，清怜乍坼泉。\n翠华公主塔，缥缈碧山巅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":593,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"圆通寺","author":"何景明","text":"晓问圆通寺，青山拄杖寻。\n飞梁袅石涧，寒日抱霜林。\n殿閤攀跻远，关河眺望深。\n下看孤鸟翼，万里送遥心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":594,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仁寿寺","author":"何景明","text":"塔庙开龙象，丛林会法筵。\n散花金布地，拄杖石飞泉。\n漂泊登高兴，依栖习静缘。\n北风吹袖起，昏黑下诸天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":595,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏天宁寺塔","author":"何景明","text":"七级芙蓉起，千年舍利藏。\n地形标海岳，人代阅隋唐。\n镜现三天象，珠含四日光。\n白毫空万里，处处有迷方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":596,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"菊庄","author":"何景明","text":"吾怜陶处士，潇洒出尘埃。\n白发秋逾短，黄花晚自开。\n百年常对酒，九日漫登台。\n却顾轮蹄者，悠悠徒尔哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":597,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大功德寺","author":"何景明","text":"宝地烟霞上，珠林霄汉间。\n宣皇留殿宇，今日共追攀。\n御榻临丹壑，行宫锁碧山。\n帝城看不远，时见五云还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":598,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望湖亭","author":"何景明","text":"独上湖亭望，霜空万里明。\n槛疑天上立，槎是斗边行。\n云雾开山殿，芙蓉暗水城。\n先朝四百寺，秋日遍题名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":599,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慈恩寺","author":"何景明","text":"海子桥西寺，高楼御苑花。\n中流自日月，平地有烟霞。\n客至开金殿，宸游想翠华。\n十年复到此，朋辈各天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":600,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"一舫斋","author":"何景明","text":"乾坤聊一舫，高卧此斋深。\n竹散琴书色，窗开岛屿阴。\n乘桴浮海意，击楫渡江心。\n无限风波里，何人叹陆沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":601,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"镜光閤","author":"何景明","text":"峻閤岧峣上，层城眺望中。\n风铃齐送响，云磴曲盘空。\n海色摇窗碧，蓬莱影日红。\n翠华无复到，长锁翠微宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":602,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"关门","author":"何景明","text":"虎卫关门迥，龙沙塞曲深。\n风云时有气，日月昼长阴。\n中使西来讯，千官北望心。\n天寒汉宫阙，翠盖忆春临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":603,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题苍谷寺","author":"何景明","text":"曲水盘山地，松门路不分。\n青天望嵩少，白昼吐风云。\n过客空高兴，徵君自有文。\n霜钟翠微里，日暮渺相闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":604,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鉴公房石镫","author":"何景明","text":"石碗何年凿，瑶灯此夕然。\n云流自五岳，月色近诸天。\n定里金轮转，光中玉镜悬。\n西来不灭影，常照法筵前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":605,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张侍御仲修送弓","author":"何景明","text":"绣服意相亲，彫弓把赠新。\n独怜投笔志，未老据鞍身。\n昼控鸣风镝，宵弯抱月轮。\n倚天时一望，西北有胡尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":606,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新郑道中","author":"何景明","text":"客路临新郑，云沙望转平。\n夕烟生断堑，野水入荒城。\n下马看碑志，逢人问地名。\n千秋陵谷在，怀古益多情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":607,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洪门","author":"何景明","text":"何处问商圻，荒原寻断碑。\n鸡鸣深市井，雁入古城池。\n斜日人空吊，浮云世自移。\n秪馀淇上竹，绿色映寒漪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":608,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"铜雀台","author":"何景明","text":"美人望陵处，无复翠华过。\n殿冷闲歌吹，宫春罢绮罗。\n落花娇靥尽，方草怨魂多。\n日暮漳河水，东流空白波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":609,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿邝廷瑞太守","author":"何景明","text":"五马归来日，闲身六十强。\n春花自烂熳，云水共徜徉。\n邑种菜公竹，邦留召伯棠。\n平生天下志，白首付沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":610,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初度","author":"何景明","text":"此日吾初度，深杯且自挥。\n眼看儿女大，身觉弟兄稀。\n未得浮沧海，徒然傍紫微。\n齿年今不小，心事已多违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":611,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秦翁挽章","author":"何景明","text":"不见此翁起，谁寻处士家。\n邑人传月旦，蒿里惨霜笳。\n水面蓝田月，春残清渭花。\n陇云深一墓，寒月昼空斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":612,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽谢晚耕","author":"何景明","text":"五十不入城，独吟称晚耕。\n日南提剑志，海上却金名。\n故里松犹在，秋田草自生。\n江湖梦颜色，怅望有馀情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":613,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽谢中丞","author":"何景明","text":"闽海通南极，三山产异才。\n循良三历郡，镇静久登台。\n神鬼愁先见，蛮夷望复来。\n谁看大星落，天柱使人哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":614,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴中丞双挽","author":"何景明","text":"近读中丞传，兼闻节妇吟。\n死收铜柱绩，生有柏舟心。\n沧海空潮汐，青山自古今。\n双魂俱不泯，何恨九泉深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":615,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"海岳陈翁挽章","author":"何景明","text":"白云送秋老，一墓海门边。\n花忆啼莺日，风悲种树年。\n人间馀翰墨，天上有神仙。\n从此辽东鹤，千年更一旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":616,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"百战","author":"何景明","text":"百战将军死，中原将士哀。\n山河犹汗马，霄汉已云台。\n敢料安危势，须还节制才。\n南征闻日远，消息几时来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观兵二首 其一","author":"何景明","text":"将帅俱分阃，朝廷再剖符。\n选徒皆虎士，战马尽龙驹。\n直指黄河外，长驱碧海隅。\n感恩须此辈，万一为捐躯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观兵二首 其二","author":"何景明","text":"组练回天地，戈鋋白日摇。\n王师一奋怒，寇贼可潜消。\n使过传金节，军行奏玉箫。\n人言汉家将，今是霍嫖姚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诸将","author":"何景明","text":"万方皆寇盗，诸将半公休。\n未息苍生困，犹烦玉食忧。\n珥貂前日赐，汗马几时收。\n莫倚兵车力，安危在运筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"防寇","author":"何景明","text":"万国犹防寇，三年未罢师。\n天清闻鼓角，野旷见旌旗。\n岸雪晴含照，山云晚趁姿。\n孤臣北上日，想望太平时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"盗起","author":"何景明","text":"盗起从畿甸，徒劳将帅心。\n徵兵摇白羽，募士散黄金。\n天地河嵩隔，风尘海岱阴。\n万方吹画角，此曲激沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花当","author":"何景明","text":"闻道花当种，缘边部落遥。\n百年为汉卫，每岁款天朝。\n犯顺若无敌，背恩谁尔骄。\n侧想文皇日，龙骧亲渡辽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]