[{"title":"壬戌元宵应制绝句八首 其四","author":"顾清","text":"华星宝月满长安，绣屋金釭夜未阑。\n遥望千门起庭燎，尚宫先辇奏回銮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53323,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"壬戌元宵应制绝句八首 其五","author":"顾清","text":"紫坛回仗溢天津，特策金吾弛夜巡。\n为有蕃禧助阳令，六街花柳一时新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53324,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"壬戌元宵应制绝句八首 其六","author":"顾清","text":"宵旰忧勤十五年，鳌山灯火亦初筵。\n小臣未识鱼龙戏，中宴先歌蟋蟀篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53325,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"壬戌元宵应制绝句八首 其七","author":"顾清","text":"紫檀红蜡夜频添，万岁声中乐未厌。\n华月正当云母障，微风莫动水精帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53326,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"壬戌元宵应制绝句八首 其八","author":"顾清","text":"乾清前殿夜将分，万烛交光绚綵云。\n传敕明朝散灯宴，词臣好进劝农文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53327,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"后二日有旨再赋律诗四首 其一","author":"顾清","text":"乐岁逢春物物宜，圣人行乐是乘时。\n天垂玉烛三千纪，地涌金莲十万枝。\n星阁捲帘红日近，虹桥按曲綵云迟。\n愿因欢庆思幽隐，更法光明事缉熙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53328,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"后二日有旨再赋律诗四首 其二","author":"顾清","text":"千灯高列奏宫悬，五凤齐飞拱御筵。\n春到上元真富贵，月临双阙正清圆。\n甘泉西北长无警，瀛海中间大有年。\n暂弛金吾三夕禁，未妨宣室九宾延。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53329,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"后二日有旨再赋律诗四首 其三","author":"顾清","text":"好景新春属上元，蓬山排日会群仙。\n丛金间玉灯千树，翔凤回鸾月一天。\n直以升平留燕赏，肯将光景付流连。\n綵云遥望笙歌合，知奏邠风第几篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53330,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"后二日有旨再赋律诗四首 其四","author":"顾清","text":"紫皇宫阙夜通明，飞阁回廊白昼行。\n宸极本同天下乐，霓裳不度月中声。\n河山表里归全盛，云物光华溢太清。\n愿祝圣人千万寿，年年灯火看升平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53331,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"许百户从军普安州至潞渚卒时其子鲁从予游赋此吊之","author":"顾清","text":"拟作燕歌赠粤行，剑棱中断不成声。\n一天冻雨红旗敛，万里炎烟碧草横。\n假息忍看徵侧在，裹尸谁吊伏波营。\n伤心最忆湖阴路，垂柳閒门几送迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53332,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊行忆徵伯与德卿希大联句 其一","author":"顾清","text":"故人丘垄望中孤，古木荒村旧路纡。\n野奠有怀空酹酒，交游无兴更携壶。\n人间流落文章在，梦里依稀涕泪枯。\n此日九原如可作，问君曾记玉楼无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53333,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊行忆徵伯与德卿希大联句 其二","author":"顾清","text":"把笔英姿在眼中，笑谈曾共此堂东。\n乾坤苍莽游何处，花雪追随梦未终。\n价重连城惊毁璧，气消神骏想追风。\n悲歌亦是伤春调，却与伤春调不同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53334,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊行忆徵伯与德卿希大联句 其三","author":"顾清","text":"石桥归路又斜阳，旧日经行宛未忘。\n何物山川收间气，向来星斗避寒芒。\n青乌未卜前冈吉，白雪空传下里章。\n一滴九泉今定到，骑龙休问白云乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53335,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送道士周翠岩还松江","author":"顾清","text":"飙轮不到海东头，梦里三山日夜浮。\n归去有时应驾鹤，别来几处见乘牛。\n风清晓殿思金磬，云淡春空送綵辀。\n借问赤松千载后，幅巾还许伴清游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53336,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送萧指挥还金山","author":"顾清","text":"将军承宠出明光，归骑东风满路香。\n家有六韬藏虎豹，身堪百战扫豺狼。\n北来烽火边无警，南去波涛海不扬。\n细柳绕营春日静，雅歌谁与共壶觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53337,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄高曾唯","author":"顾清","text":"千里南河入望赊，美人有约赋皇华。\n乡音不远经冬雁，云路常瞻八月槎。\n官好水曹清彻底，名高玉树净无瑕。\n北堂春日花如锦，时向公馀奉小车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53338,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送吴汝玉下第用己未春韵","author":"顾清","text":"建业西风忆系舟，燕台此别又经秋。\n也知和璧终传世，恨向荆江复倚楼。\n且莫临岐伤远道，要须游刃视全牛。\n长安春色年年似，一样王孙烂漫游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53339,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送百户徐钦袭职还松江","author":"顾清","text":"曲墙垂柳荫清池，十载高门路不迷。\n尽说柏舟同节苦，惊看玉树与云齐。\n恩光晓日瞻龙仗，行色秋风入马蹄。\n拂拭家藏旧弓剑，从今步步上丹梯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53340,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋蟠桃图为张时震父母寿","author":"顾清","text":"玄洲髣髴海东涯，海岸蟠桃大比瓜。\n画入彩缣疑着雾，望迷仙苑欲生霞。\n稀年令德真相配，紫府丹台别是家。\n我欲金壶借馀墨，一枝并写杏园花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53341,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"维扬魏文璧工诗能琴善画幅巾布袍游京师萧然不与尘土杂将还与德卿御史各赋诗送之","author":"顾清","text":"清沟绿树绕江都，树里人家画不如。\n舣棹十年同过鸟，临流此日羡閒居。\n乾坤老眼丹青在，江海神游梦寐馀。\n西北月湖连甓社，几时携手弄明珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53342,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题扇寿爱蔬吴先生尊人","author":"顾清","text":"江海归来一幅巾，东风八十四回春。\n日长勘罢参同契，坐对青山即故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53343,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泰和萧生将赴临汀驿留三日为予写真赋此为赠 其一","author":"顾清","text":"本自烟江坐钓矶，春风强使著荷衣。\n不知面目从来假，更与萧郎问是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53344,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泰和萧生将赴临汀驿留三日为予写真赋此为赠 其二","author":"顾清","text":"南望临汀路八千，皇华四牡日纷然。\n江湖或有商岩相，倘可因君送上天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53345,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张晦夫长史之沂州","author":"顾清","text":"犹记征车逐后尘，离亭回首十经春。\n衣冠稷下谁公右，礼乐河间合此新。\n长日横经当便坐，有时纡锦见乡邻。\n绿杨骑马城坳路，应向西风忆故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53346,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"还金行为叔武郎中赠济南姚龙","author":"顾清","text":"故人留金儿不闻，故人已死人谁云。\n昨日结交今有变，何况天涯生死分。\n延州挂剑事已矣，济南高风见吾子。\n金还故人事则已，事吾当然非有以，江海千秋歌义士。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53347,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送宁庵学士赴南院","author":"顾清","text":"紫清仙吏亦分曹，瀛海晴虹隔翠涛。\n词下掖垣花欲动，讲回前殿日初高。\n城临秋水迎飞盖，阁倚春风想运毫。\n为谢白云荆渚上，楼船不似北河劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53348,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送盛春雨还吴","author":"顾清","text":"未来消息满长安，小住何妨趣驾还。\n海内正悬春雨望，山中谁放夏云閒。\n每寻燕语多高论，转觉鸿飞不易攀。\n翘首阊门烟月路，几时携酒扣玄关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53349,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭次儿天叙寄两弟五首 其一","author":"顾清","text":"孤根托浅土，所赖众叶扶。\n斧斤日相寻，谁能不伤枯。\n根伤叶乃落，叶落根转孤。\n不知天地仁，根也真何辜。\n仰天天苍苍，扣地惟黄垆。\n有语不可道，泪下如倾珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53350,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭次儿天叙寄两弟五首 其二","author":"顾清","text":"虎狼亦爱子，乌鸟亦恋雏。\n生子不能庇，悲恨当何如。\n伯也归故乡，漂泊无宁居。\n仲子最孝谨，性复爱诗书。\n百方挠其中，一病辞寒庐。\n垂死与母言，血泪沾衣裾。\n沈思不忍道，命也有生初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53351,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭次儿天叙寄两弟五首 其三","author":"顾清","text":"养蠹伤桂根，击鼠伤定盆。\n盆伤鼠故在，桂死蠹转蕃。\n明明世间事，瞀乱与谁论。\n吾儿曾闵性，至死无馀言。\n念之益我痛，作诗愬烦冤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53352,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭次儿天叙寄两弟五首 其四","author":"顾清","text":"十年住京国，日与忧患随。\n逢人得家信，十书九攒眉。\n芝兰日以瘁，荆棘日以肥。\n宿累本在我，馀殃及吾儿。\n种树已结子，养雏已能飞。\n一朝委尘土，烦冤当告谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53353,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭次儿天叙寄两弟五首 其五","author":"顾清","text":"汝母初来时，骨肉共团栾。\n依依恋微禄，幸尔免饥寒。\n负乘知有愧，酷罚倘可宽。\n弱女在旅殡，十年犹苦酸。\n如何复及尔，中道摧羽翰。\n萧条古僧房，兄妹两孤单。\n疏窗对寒雨，念之伤肺肝。\n何当归尔魂，恸哭淞水干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53354,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乔时章除瑞安侯训导侯实慈寿宫弟时章内翰师召子也","author":"顾清","text":"长乐清风动内朝，汉宫阴马宋高曹。\n外家多福遵慈训，西塾延宾得隽髦。\n永日青襟环讲坐，有时红烛对挥毫。\n相看益重酬恩地，身是銮坡旧凤毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53355,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南有蛮为阴子淑宪副作","author":"顾清","text":"南有蛮，穴都匀，反乎覆，傲以嚚。\n反噬厥主戕我民，鸱张四顾掠且焚。\n繄阴侯，算若神，戢我武，绥以文。\n绥之弗来歼乃群，蛮破胆，伏以驯。\n释不问，弘我仁，豕入其笠吾谁嗔。\n呜呼普安城，亦吾人，一不戒，血成津。\n胡为不遣当使君，呜呼胡为不遣当使君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53356,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"程德望祠部于书室前凿池作亭秋望落成而正之内翰适至因名其亭曰登月室曰聚奎要予同赋 其一","author":"顾清","text":"方塘开我前，明月出我东。\n仙人骑鹤来，憩我亭之中。\n调笑弄月影，徘徊吟天风。\n夜久月渐高，光满池若空。\n遗我丹桂枝，自携白芙蓉。\n飘然凌风去，千秋怀德容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53357,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"程德望祠部于书室前凿池作亭秋望落成而正之内翰适至因名其亭曰登月室曰聚奎要予同赋 其二","author":"顾清","text":"文星近东壁，煌煌照图书。\n千秋五纬聚，煜煜联明珠。\n岂徒兆文运，皇步跻亨衢。\n美哉君子堂，春风迓簪裾。\n高会既有以，嘉名谅非虚。\n君看庭下人，星斗罗襟襦。\n高朗自今始，太史徵明符。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53358,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送汤千户还吴","author":"顾清","text":"留守将军金虎符，明光传警肃周庐。\n新恩宠拜双龙阙，别路光生驷马车。\n投笔书生终刻印，入关童子已抛繻。\n楼船八月吴江燕，谁共雕盘荐玉鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53359,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宗伯傅体齐先生挽诗","author":"顾清","text":"两朝名德重儒绅，西掖南宫列近臣。\n典礼百年归考论，文章四海入陶钧。\n春风遽撤朝回座，夜月徒伤画里神。\n地下青溪定相待，霓旌先后想纷纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53360,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送顾汝馨","author":"顾清","text":"通家人物旧知名，十载相看倍眼明。\n捧檄君方感毛义，思贤我复到颠闳。\n青云未觉流芳远，白发多应别路生。\n无限羁愁与乡思，并先秋雁过吴城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53361,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舜臣以诗慰问次韵","author":"顾清","text":"故人千里寄新诗，正是愁人阁泪时。\n黄鸟有情依灌木，碧萝无命托松枝。\n寻思往事多艰阻，却悟深盟是祸基。\n长叹一回还自慰，重哀宁望老天知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53362,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"卫景玉生辰席上作","author":"顾清","text":"我生于君后三算，我及君游已十年。\n浮世升沈几搔首，高秋风物又登筵。\n银钩欲转薇花月，金兽初腾柏子烟。\n他日仙班只今定，丹梯须让海鸥先。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53363,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"戏简王汝楫","author":"顾清","text":"短日西风木叶飞，游人无处不思归。\n连廒百室如云峙，肯念吴儿未授衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53364,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"方石先生季父逸老以宝庆守致仕先生名其居曰悬车旧第宝庆殁先生有诗命次其韵","author":"顾清","text":"执鞭无地候巾车，逸老编中识面初。\n露冕犹闻下江汉，云山谁与画衡庐。\n青槐古柏京尘远，寒日西风宰树疏。\n莫向方岩诵哀些，竹林回首正欷歔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53365,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画鹊","author":"顾清","text":"朝阳欲上万年枝，九色光芒射绀衣。\n昨夜银河济灵驾，露华寒湿未禁飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53366,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题花鸟二绝 其一","author":"顾清","text":"边鸾不起林良老，海内丹青合到谁。\n晴日窗间弄沙鸟，楚烟湘树不胜思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53367,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题花鸟二绝 其二","author":"顾清","text":"黄凫不食聚沙觜，芦鸡相将踏清泚。\n飞燕翩翩软风里，江乡春晴景如此。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53368,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五马行赠宋舜和之广信","author":"顾清","text":"翩翩五马城东隅，车载两轓兼隼旟。\n雪晴尘清马蹄健，长鸣跋地当云衢。\n汉家太守唐刺史，握节专城殿千里。\n古来青史亦吾人，肯使诸公尽专美。\n西江望君如望云，驱车跃马无逡巡。\n闻道群偷先出境，已识新侯是宋均。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53369,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送赵起龙兼简其季父济民","author":"顾清","text":"白鹤城西是旧游，赵家亭馆菊花秋。\n乡关客邸劳魂梦，风物天涯惜去留。\n高隐久应忘世味，美材还合树勋猷。\n竹林会语从容地，真诀参同可再紬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53370,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送吴克常南京光禄监事","author":"顾清","text":"通家亲戚故乡人，临别相逢意转亲。\n晤语留连下城日，宦程迢递促车尘。\n高冈合止冲霄翼，浅水宁容纵壑鳞。\n朱雀乌衣壮游地，为君惆怅十年春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53371,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送朱文宿谒告东还","author":"顾清","text":"天寒游子正思家，手把离觞感物华。\n乡梦五更犹禁漏，归轩千里即仙槎。\n庭萱屡报东风鹊，宫锦争看上苑花。\n同学故人应问我，绿莎春雨候江沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53372,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十二月十一日进会典","author":"顾清","text":"黄盖亭亭拥赭函，箫韶声起殿东南。\n百年盛事中天见，八圣深仁薄海覃。\n尧典合从虞史润，周官不假汉儒参。\n愿言善述光前训，竹帛千秋作美谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53373,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"明日宴礼部","author":"顾清","text":"大官供帐称殊恩，队舞番歌出内园。\n礼肃上公尊奭旦，书成新典迈虞轩。\n雍容不止过三爵，披览何由望九阍。\n经幄小臣沾醉甚，但歌天保对尧尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53374,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送沈继昌","author":"顾清","text":"丝纶阁里凤凰毛，五彩朝阳映碧霄。\n出使口衔天语重，拜辞衣傍御香飘。\n里门驻节惊梅蕊，驿路逢春问柳条。\n为忆圣情深眷倚，肯耽山水后趋朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53375,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"戴宝之祖韶轩翁挽诗","author":"顾清","text":"西风林壑晚凄其，叹息仪刑不可追。\n天地并临刲股夕，里闾相泣盖棺时。\n谋深丰芑金楼册，心切苞桑白傅词。\n翘首玉辉原上路，几人下马读穹碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53376,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"廿一日夜坐忆亡儿 其一","author":"顾清","text":"清夜长吟动四邻，吟成人静独沾巾。\n不知此段缠绵意，天地相关复几人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53377,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"廿一日夜坐忆亡儿 其二","author":"顾清","text":"视不成形举目存，青灯一盏近黄昏。\n彭殇竟是谁分出，妄使瞿昙欲断恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53378,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"茅山书屋","author":"顾清","text":"小茅山下三间屋，养默斋中万卷书。\n竹帛散馀嗟往事，海桑迁后复吾庐。\n檐头树色低侵帙，门里泉流曲贯除。\n想见日长佔毕倦，时来凭槛数游鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53379,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"封知府叶公挽诗","author":"顾清","text":"百岁閒身五马封，向来江海复谁同。\n门阑庆建看诸子，兄弟椿津对两翁。\n身后诗书方自远，眼前林壑便忧空。\n碧山烟雨淮南路，尚想扁舟理钓筒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53380,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵启衷给事病后见寄","author":"顾清","text":"宋玉杨朱各有悲，杜陵曾借草堂资。\n由来造物多儿戏，毕竟风流是我师。\n梦里青山休作意，眼前黄卷足新知。\n春风几日开西馆，聊欲携尊问所疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53381,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋僮仆欢迎贺叔武尊人都宪致仕","author":"顾清","text":"陶令还家日，欢迎走仆僮。\n人间长见画，林下复添公。\n物色殊相近，遭逢夐不同。\n飞腾会明盛，扬历践昭融。\n苕水犹遗爱，横山早息戎。\n全归渠亦喜，远涉路何穷。\n指点桑榆茂，传观里巷空。\n挽衣参稚子，扶杖杂村翁。\n黄菊霜前约，青山雨后功。\n行藏自吾道，消息任天工。\n晚景看如此，皇恩信有终。\n丹青如解写，何羡洛城东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53382,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题学生画","author":"顾清","text":"枝头野花红欲语，草绿犹带朝来雨。\n狂蜂浪蝶不自持，下上东风作容与。\n画师好手亦难逢，陶成已老况孙龙。\n南薰殿里和丹粉，犹堪一笑解天容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53383,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送史景贤同知考绩","author":"顾清","text":"君侯北州英，淳直自天予。\n青云二十载，安驾何容与。\n朅来东吴郡，已复三刈黍。\n庞统足方展，休徵名日举。\n于焉朝天行，万里看凤翥。\n尧门开九重，舜目周万宇。\n才良合高位，疲瘵念慈父。\n舟行望不尽，目断斜阳渚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53384,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月桂秋香送刘生还宜春应举","author":"顾清","text":"月桂生月宫，一月一开落。\n逢秋气弥盛，芬馥遍寥廓。\n世人望影空裴?，刘郎自是神仙才。\n兄弟相携月中去，正值秋风花烂开。\n嫦娥玉手亲折赠，双枝香满黄金台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53385,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]