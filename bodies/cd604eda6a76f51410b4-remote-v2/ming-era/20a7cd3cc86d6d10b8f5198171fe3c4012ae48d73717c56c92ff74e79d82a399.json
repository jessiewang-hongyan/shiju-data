[{"title":"宿海云寺 其四","author":"屈修","text":"禅房留信宿，诸虑冷然销。\n黄叶飞山寺，梅花开板桥。\n人天留境界，鱼水待逍遥。\n谁订灵槎约，将乘来去潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42975,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉陪袁银台游海云寺","author":"屈修","text":"揽衣旧识雷峰路，不到雷峰四十年。\n步履得陪林下客，笑谈真出世中仙。\n楼台远近来山色，村舍周回绕稻田。\n欲拚余生筑茅屋，学参黄蘖白头禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42976,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉寄远公","author":"屈修","text":"高楼名薝卜，绕壁总琅玕。\n竹色生秋气，棋声入夜寒。\n出门问农事，歛迹即心观。\n最忆过从处，茶瓜十日欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42977,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"幽居","author":"李万龄","text":"养性惟宜拙，山中一草堂。\n风来门自动，月到院生光。\n径僻青苔滑，窗虚绿树藏。\n淡然无一物，高卧对羲皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42978,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"何颖","text":"长忆乔仙去不回，师雄幽恨几时开。\n罗浮睡冷梅花月，夜夜佳人入梦来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42979,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"墓上梨花","author":"何颖","text":"一春伤薄命，粉脸忆啼痕。\n风雨泉台莫，深深独闭门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42980,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"潘嗣英","text":"销尽铅华自可怜，樽前歌舞总寒烟。\n虎丘冢冷馀青草，燕子楼空委翠钿。\n风过竹声疑解佩，春传莺语想当筵。\n芳魂东逐罗浮近，一枕梅花入梦仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42981,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"墓上植百合花","author":"潘嗣英","text":"芳魂素质似乔仙，花气宜人百合传。\n移向山头和露种，与君重结后生缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42982,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"苏秩","text":"伤心玉殒看情史，长恨红妆薄命多。\n兰麝土归空怅望，芙蓉香冷易消磨。\n猿声啸夜悲风月，鹃血啼春惜绮罗。\n可是广寒云重锁，却教无路觅霜娥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42983,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"彭永","text":"幽芳着雨晓枝空，枉杀忙蜂万叶中。\n春思徒依南浦绿，夜魂犹入小窗红。\n竹含烟翠留清韵，柳变霜黄罢舞风。\n可惜芳华容易歇，忍看琼树委墙东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42984,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"杨兆鹏","text":"施僧衣笥尽零凋，留得罗裙金缕销。\n无复嵩山任处士，芳魂谁与韦生招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42985,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆昔行","author":"杨兆鹏","text":"石自嶙峋水自潺，登临疑是虎丘山。\n蛩吟衰草埋冰骨，花笑孤坟伴玉颜。\n铜雀旧怜春暗锁，泉台新恨夜长关。\n絮觞浇祝如容见，挟取仙真带月还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42986,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆昔篇","author":"杨兆鹏","text":"繇来名艳倾天下，叠翠堆红春似画。\n才子多将藻思搜，佳人未易芳菲嫁。\n张家之子字乔婧，螓首蛾眉花作面。\n淡淡春山黛晕娇，盈盈秋水波光溅。\n等閒拾翠江南地，破瓜年纪多才思。\n妙舞蹁跹蝶乍翻，清歌缭绕莺初试。\n彭郎故是怜香客，走马章台过紫陌。\n流霞潦倒许同倾，蛾眉黯淡教新画。\n绣被香罗鸳梦遥，春去春来几暮朝。\n银绡绾就同心结，碧月和吹引凤箫。\n自言恩重死生同，岂意分携东复东。\n愁山有路千重隔，恨海时将一线通。\n秋光见月长相忆，可怜两病俱愁剧。\n西窗有恨游魂知，东浦无音飞梦觅。\n只期终久共此情，那堪玉折更珠倾。\n巫峡风凄惟鸟语，梨园花落但猿声。\n冰销艳骨香犹在，月冷梅妆梦不成。\n空使檀郎肠暗断，伤心无异雨淋铃。\n嗟尔昔年才十九，占断繁华花与柳。\n霓裳化作不归云，飞遍罗浮仙洞口。\n君不见薛较书，锦江春色袭人裾。\n芳魂醉绕痴情蝶，赋赠田洙思有馀。\n又不见苏小小，钱唐江月不知晓。\n堤边白马日如云，油壁轻车何缥缈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42987,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"马捷","text":"不入阳台梦，徒悲柳叶颦。\n华奁脂散馥，逸藻韵传神。\n了却前因业，还归不染身。\n倚肩谁密约，怜杀意中人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42988,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"胡翼运","text":"罗敷愁逐楚山云，偏向东方恼使君。\n披咏莲香长恨句，断猿三叫不堪闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42989,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"徐良策","text":"瑶琴声绝月黄昏，深院凄凉空掩门。\n清事已非茶灶冷，痴情曾寄墨卿存。\n镜沉秋水菱花影，帐断芙蓉蛱蝶魂。\n从古芳菲易零落，且将哀绪托啼猿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42990,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"周文豹","text":"超却尘寰出大千，方乔无复遇乔仙。\n泉台渺渺难穷照，镜得纯阳也枉然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42991,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"陈子随","text":"露下荒台秋思添，美人一去月重蟾。\n麻姑鸟爪书书小，樊素樱桃字字纤。\n别鹤语留天已老，断箫声冷病方恹。\n返魂香竟无消息，多少花枝恼隔帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42992,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"刘汝楫","text":"愁倚孤桐别思添，美人曾忆醉秋蟾。\n歌翻激楚朱樱小，钗按窝云玉笋纤。\n巫女梦阑宵寂寂，沈郎病怯昼恹恹。\n芳魂归处凄风动，仙影微茫怆隔帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42993,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"叶元凯","text":"兰土伤埋玉，芳词剩绮霞。\n纤腰元绾柳，润脸昔呈花。\n流盼馀青琐，徵歌杳缝纱。\n赏音怀格调，留恨怨琵琶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42994,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"杨之琦","text":"濛濛春色暗青楼，歌谢台荒舞亦休。\n锦队凄凉云雨恨，花钿零落燕莺愁。\n心飞南国香何在，目极东洲水自流。\n却忆当樽人似玉，月明无复引箜篌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42995,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"李士悦","text":"一朝闻信息，尽日念成痴。\n世有不平事，花无长艳时。\n昏沉人鬼路，凄断死生期。\n瘗玉谁同恨，怜才心独悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42996,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"周官","text":"弱水蓬山总杳然，访寻谁得见神仙。\n珠飞合浦还何日，剑落延津别几年。\n云散楚台悲月死，雨过隋苑惜花眠。\n裴航忍断蓝桥路，愁向天涯盼暮烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42997,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"彭德盛","text":"袖里相思字未残，阳台一望路漫漫。\n亦知恨结珊瑚碎，无奈愁深翡翠单。\n太液池边香乍冷，若耶溪畔曲生寒。\n迢遥仙旆何繇觅，从解骖虹会也难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42998,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"何澜泰","text":"薄命伤红粉，风流忆翠翘。\n歌藏花底舌，舞绝柳边腰。\n楚馆生牢落，骊山锁寂寥。\n素娥邀尔伴，仙路可逍遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42999,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆昔行","author":"何澜泰","text":"寂寞逗春愁，一丘兰麝土。\n可怜泣露花，尚作迎风舞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43000,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"陈世绂","text":"恻恻微风几度思，芙蓉端不耐寒迟。\n当年命薄欢成梦，今日情痴怨入诗。\n笑语画中呼欲出，环声梅下到应疑。\n红楼旧恨知多少，得似莲香绝一时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43001,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"彭廷赞","text":"粉褪香销翠帐空，章台不复恋春风。\n迢遥洛浦人何在，缥缈蓬山路岂通。\n旧恨有诗怜好好，新声能记羡红红。\n高唐云雨今寥寂，愁杀襄王忆梦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43002,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"方朔","text":"为雨为云事渺然，尚馀芳韵在诗篇。\n步虚仙队嫌狂逸，小谪人间十九年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43003,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"苏子桢","text":"歌舞楼前香缥缈，珍珠帘内影玲珑。\n海棠春睡迷蝴蝶，长在华清一梦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43004,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"庄煜","text":"弱水茫茫路几千，蓬莱从此返飞仙。\n空馀昨夜西风急，憔悴芙蓉倍可怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43005,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"姚启璧","text":"一死如何一笑轻，西楼消息问飞琼。\n儿家旧倚清商曲，长付秋蛩怨月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43006,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"彭忠铭","text":"染得桃花巧作笺，浓香腻骨号书仙。\n软绡红泪今犹在，欲对清歌却渺然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43007,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆昔行 其一","author":"彭忠铭","text":"风流疑是楚莲香，曾惹蜂忙与蝶忙。\n极目綵云歌舞尽，大堤芳草断人肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43008,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆昔行 其二","author":"彭忠铭","text":"真娘墓上可题诗，墓上栽花花可悲。\n狼藉嫩红残雨后，盈盈珠泪落胭脂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43009,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"区应槐","text":"明艳春容天下丽，嫣香薄质霎时残。\n竹枝染泪愁偏剧，草色笼烟怨未阑。\n星海茫茫尘梦断，巫山寂寂雨情乾。\n金钗小冢频浇祝，那得芳魂月下看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43010,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆昔行","author":"曾炜","text":"昔日铜台中，歌舞殊未已。\n一朝委灰尘，空台对流水。\n岂知恩爱如古人，不及檀郎怜妾死。\n垒垒古坟松柏生，犹忆西园桃与李。\n秾华不得度，玉质伤铅素。\n不道君心妾不如，冥漠重泉永遐锢。\n欲感君恩顾，妾心祇应化作西陵树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43011,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花冢","author":"曾炜","text":"花墓平临种芋田，寒松瀑水忆歌弦。\n春堤无数冶游客，一见棠梨心自怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43012,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒食过墓","author":"曾炜","text":"细雨湿棠梨，春风吹柳枝。\n野花行客泪，林木杜鹃悲。\n远寺传钟梵，寒村带酒旗。\n王孙旧游处，白露日应滋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43013,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"卢若嵩","text":"文采风流世所传，吴姬高调正堪怜。\n红英香落愁蝴蝶，青冢春深怨杜鹃。\n梦断阳台遗玉珥，魄沦湘水冷金钿。\n由来艳骨伤尘土，感慨何论齐物篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43014,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"池天琛","text":"当年歌舞醉仙城，想像精魂泪欲倾。\n终古嫣香应不歇，骚坛期结后生盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43015,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅坳题石 其一","author":"简耀","text":"曾醉荷筒泛绿潮，吴姬歌舞笑相邀。\n风飘轻袂香初冷，雨褪残妆魂未招。\n潭比薛涛花作岸，坡连苏小玉为桥。\n猿啼巫峡青青冢，裘马王孙不惮遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43016,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅坳题石 其二","author":"简耀","text":"河汉桥成怅别离，萦怀到处忆蛾眉。\n舞疑蝶粉翻花径，曲似莺簧唤柳枝。\n妆匣半留新翡翠，镜台犹冷旧胭脂。\n可怜艳骨埋香土，莫惜黄金买篆碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43017,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅坳题石","author":"区谨","text":"斜月沉沉辞逝波，落花纷纷辞故柯。\n人生有情苦未免，悲来欢尽知奈何。\n记昔青楼官道侧，莺时曾控黄金勒。\n鹧鸪歌罢春风低，螺翠鸦黄擅颜色。\n望陵新曲谁最妍，铜台高处落婵娟。\n一片晴霞纷出岫，繁花近眼娇可怜。\n云散风流徙回转，芳春恰谢娇红浅。\n崔徽掩镜生绿尘，剩有丹青在空卷。\n芙蓉落尽湘江空，残脂遗翠昏房栊。\n香魂去后新坟在，衰杨宿莽摇悲风。\n昔盐吟尽分今古，一代蛾眉但黄土。\n滔滔漳水向东流，凄断彭郎矶上雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43018,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅坳题石","author":"孔闻圣","text":"冷艳荷香蘸碧漪，每怜解语忆芳姿。\n风飘柳陌当年态，月傍花楼旧日眉。\n巫峡雨云迷楚女，瑶台歌舞失吴姬。\n荒山红紫留文采，千古多情见勒碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43019,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅坳题石","author":"何日精","text":"青楼空擅一时名，铜雀风流自属卿。\n笑脸祇从遗影艳，醉怀偏逐步虚声。\n牵愁检韵难赓咏，掩泪缘君半减枰。\n可是莲香知已足，尚留佳事在孤茔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43020,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆昔行 其一","author":"陈士忠","text":"泠泠石涧旧同游，道左俄惊拱木修。\n忆自雀台春锁后，阿谁兼美擅风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43021,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆昔行 其二","author":"陈士忠","text":"返魂无计续湘英，欲写蛾眉愁未成。\n却有钟情迈今古，累累青冢为君营。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43022,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆昔行 其一","author":"苏兴裔","text":"忆昔花丛绝世人，含情宜笑复宜颦。\n容华艳艳谁相比，拚却巫阳一片云。\n若兰才调韩娥色，锦字回文心线织。\n檀槽玉柱按梁州，缠头容易堆狼籍。\n邀欢上客郁金堂，拂弦时误顾周郎。\n祇道朱颜耀朝日，宁知鶗鴂妒年芳。\n年芳一去如飘忽，漠漠绮尘封锦瑟。\n翠被馀香俨尚留，彤管新诗从此毕。\n鸣佩珊珊迟艳魂，惆怅难逢李少君。\n东海仙楼扃玉户，北邙明月照孤坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43023,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆昔行 其二","author":"苏兴裔","text":"松柏樛枝兔丝缀，女萝引蔓犹萦结。\n三春愁杀有情痴，杜宇啼红疑恨血。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43024,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆昔行","author":"黄晟元","text":"梦断高唐几度秋，白杨风急水东流。\n可怜艳骨知多少，青冢垒垒尔独留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43025,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆昔行","author":"彭兹","text":"东风寒食踏芳郊，一种春来豆蔻梢。\n闻道花田今寂寞，采花人向小梅坳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43026,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆乔 其一","author":"方万","text":"垂老虬髯感旧知，西风吹泪赴江湄。\n红颜薄命伤今古，莫怨茅山乞药迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43027,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆乔 其二","author":"方万","text":"画阑珠箔小楼西，逐伴听歌惜醉携。\n一自燕巢无社信，马过花巷只长嘶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43028,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆乔 其三","author":"方万","text":"荒郊霾雾掩残香，惜舞怜歌总断肠。\n脆折锦棚呼谢豹，数声哀些咽斜阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43029,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病起梦张乔","author":"黎本安","text":"笑语依然步绿苔，天风环佩下瑶台。\n生前几见乘鸾过，死去何因捉蝶来。\n频顾带移怜瘦损，恍惊钗坠迸疑猜。\n早知香魄还奔月，拥定霓裳不放回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43030,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阅小乔诗画","author":"麦如章","text":"挥洒纨笺剩几张，清词澹墨总生香。\n大都作意撩人恨，莫怪彭郎诗断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43031,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿海曙楼有悼","author":"罗耀正","text":"独坐捲湘帘，空阶雨初歇。\n掩泪忆蛾眉，不敢看新月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43032,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"集古挽乔仙 其一","author":"岑尔孚","text":"娇歌一曲口氤氲，红粉青蛾映楚云。\n艳骨已成兰麝土，人间那得几回闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43033,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"集古挽乔仙 其二","author":"岑尔孚","text":"芙蓉如面柳如眉，春色人间总未知。\n谁为含愁独不见，夜来风雨葬西施。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43034,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过二乔墓","author":"梁培德","text":"偶来青冢畔，松柏故人心。\n花落啼红泪，泉声泻素琴。\n寒云低远岫，斜日照高林。\n草色留眉黛，知君恨每深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43035,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无弦琴歌为某作","author":"李以贞","text":"弹琴如赋诗，声声出心曲。\n心泰声和平，心愁声迫促。\n迫促弹来意未安，无弦还得一盘桓。\n若教再把柔弦续，菊也飘零酒也寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43036,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桃源图 其一","author":"李以贞","text":"一路桃花水，回头是战尘。\n飘然剌船去，领略桃花春。\n云际得古洞，花深知有人。\n人家不寥落，鸡黍共留宾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43037,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桃源图 其二","author":"李以贞","text":"古洞白云锁，归途天一涯。\n翻思钓湘水，不及种桃花。\n碧润林间雨，红蒸屋角霞。\n画图时省识，吾欲放仙槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43038,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题郑所南画兰呈家二河太史","author":"李以贞","text":"黍离麦秀叹周原，憔悴兰英散澧沅。\n才得骚歌吊魂魄，又无王土寄愁根。\n弃之沙砾花无语，写向云笺泪有痕。\n绣槛珠帘重伫目，风流不及赵王孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43039,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"避乱","author":"李以贞","text":"战尘一望已糊模，野哭千家泪已枯。\n且废琴书习弓剑，并将踪迹杂屠沽。\n神仙渔父古秦晋，流水桃花今有无。\n走尽关山千百里，月光依旧照人孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43040,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铁汉楼","author":"李以贞","text":"公也昔如铁，我来思铸金。\n楼前古梅树，骨立冻云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43041,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东岩石鼓和家悔庵孝廉","author":"李以贞","text":"顽石都堪作警人，唤回尘梦一场春。\n风波道路豺狼恶，合向名山老此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43042,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]