[{"title":"南安偶题七首 其五","author":"林光","text":"弄月吟风旧有台，台中谁为扫浮埃。\n浪游曾见芭蕉树，几卷芳心展未开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51929,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南安偶题七首 其六","author":"林光","text":"霁月光风只此心，程家兄弟感来深。\n如今欲识溓溪面，只把光风霁月寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51930,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南安偶题七首 其七","author":"林光","text":"铁汉楼边旧有台，白云红树拥成堆。\n行人莫讶南安小，会见三贤讲道来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51931,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦罗一峰先生","author":"林光","text":"湖西两马过金牛，屈指星霜二十周。\n山斗英灵还接我，共将文字了春秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51932,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题娄武库洪都东湖小楼","author":"林光","text":"小楼湖北借清漪，湖水分来又小池。\n寒月留人还照夜，晴波对我得无诗。\n南音喝罢渔家傲，醉眼看醒孺子祠。\n惟问登临今日意，输赢参破几层棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51933,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和子翼八叙别","author":"林光","text":"笠影江湖习已忘，雪花遥见数峰藏。\n残年有兴惟搜句，老病无医自检方。\n千古英雄悲岁月，一时师友易参商。\n隆冬试把天机看，消却重阴又一阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51934,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和子翼喜予至南昌","author":"林光","text":"孺子亭前怀孺子，滕王阁上吊滕王。\n羞将南海双蒲屦，又蹈燕京万里航。\n步进竿头成脱洒，践那叉顶未仓皇。\n湖山造次还携手，百咏须教醉百觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51935,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"彭蠡舟中二首 其一","author":"林光","text":"握手真谁话两忘，官卑还爱一身藏。\n云龙天地回双眼，弧矢男儿更四方。\n山着烟云皆画本，橹榣湖月自宫商。\n匡庐尚有无穷意，欲起千秋朱紫阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51936,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"彭蠡舟中二首 其二","author":"林光","text":"人世千年留老眼，乾坤万化起天王。\n春秋未秉伤麟笔，鲁叟真成泛海航。\n已觉升沈皆梦寐，谁将幽渺更张皇。\n庐山满目添诗料，且尽行边酒一觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51937,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鄱阳舟中对匡庐小酌四首 其一","author":"林光","text":"薄雾挟山光，推篷杯在手。\n湖风忽南来，空翠落杯酒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51938,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鄱阳舟中对匡庐小酌四首 其二","author":"林光","text":"返照在湖波，冉冉见山影。\n安得挟天风，飞上山顶?。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51939,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鄱阳舟中对匡庐小酌四首 其三","author":"林光","text":"船头一杯酒，嚼碎匡庐峰。\n湖波添砚水，尽日舞蛟龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51940,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鄱阳舟中对匡庐小酌四首 其四","author":"林光","text":"层崖削苍玉，长薄郁佳气。\n颓然一挥杯，拂面风细细。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51941,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阻风二首 其一","author":"林光","text":"颠狂尽日捲洪涛，机轴谁操莫大劳。\n梦里每疑身计左，险中方悟荜门高。\n江深似有蛟龙斗，夜静如闻鸟兽号。\n小港偷安眠未稳，且将村酒醉酕醄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51942,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阻风二首 其二","author":"林光","text":"入夜长江骇万艘，畏途欹枕梦魂劳。\n彭城震动来韩信，赤壁喧呼破老曹。\n误怪江豚迎浪拜，几看鹰隼入云号。\n中和位育吾人事，却笑寒毡坐不牢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51943,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中和子翼雪茶","author":"林光","text":"玉碗閒挥拨玉尘，梅花烹就腊前春。\n龙团点化元无滓，沆瀣餐来更迫真。\n铁鼎青烟回别鹤，瓦瓯元酒劝何人。\n云山傥入周南梦，更话云山未了湮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51944,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中遣闷","author":"林光","text":"五日维舟傍涨沙，刚风吹落冻云斜。\n琵琶厌聒苏州曲，虾眼新烹雪水茶。\n谩拨红炉披败絮，拟沽村酒到谁家。\n年光便作匆匆别，不候东君管物华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51945,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客中小年四首 其一","author":"林光","text":"岁月不肯住，看看又小年。\n诗穷残腊后，杯引大江前。\n乐事思南土，閒情寄短篇。\n夜来风势恶，惊徙五更船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51946,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客中小年四首 其二","author":"林光","text":"远客无佳节，狂风又小年。\n江吞湖岭外，舟避涨沙前。\n阅世慵双眼，题诗更短篇。\n迷途还买醉，高枕赣州船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51947,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客中小年四首 其三","author":"林光","text":"老境无多日，明年耳顺年。\n天风还自逆，舟楫敢求前。\n远道几千里，穷愁数百篇。\n吾能悲杜甫，来往蜀中船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51948,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客中小年四首 其四","author":"林光","text":"萧萧双短鬓，忽忽渡流年。\n心远空鞭策，穷途自不前。\n莺花聊岁计，糟粕谢陈篇。\n柔橹轻烟里，朝来理我船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51949,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮","author":"林光","text":"岁暮濒濒酒，长江处处诗。\n谁能怜子翼，吾亦爱廷仪。\n宦辙几千里，乡心十二时。\n行边频数九，花鸟及京畿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51950,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客中除夕二首 其一","author":"林光","text":"一日光阴尽一年，云帆穿破小姑烟。\n虽无异馔供除夕，亦有长风送我船。\n膝下怀深儿女念，眼中天假故人缘。\n屠苏入手何妨后，更掷同安买酒钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51951,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客中除夕二首 其二","author":"林光","text":"甲子书穷丁巳年，无端身计过浮烟。\n思家心断屠苏酒，守岁宵连客子船。\n老句未工犹有债，衰颜欲换笑无缘。\n长风果协篙师愿，晚向沙汀插纸钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51952,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"余既出湖狂风夜作舟阻三日形于声律矣今复大雪遣怀","author":"林光","text":"造化小儿颠倒颠，谁知堪恨是堪怜。\n狂风已破迷途梦，瑞雪今占大有年。\n柳絮积深芦荻岸，梅花堆重老夫船。\n党家安识罗浮味，坐拥羊羔醉玉筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51953,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和子翼湖中对匡庐小酌","author":"林光","text":"山如庐阜眼中稀，笑挽长江入酒卮。\n翠壁丹崖烟淡淡，洞云岩树晚依依。\n心非到处真成梦，画不能如更着诗。\n歌罢沧浪一回首，湖鸥故故傍人飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51954,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟次南浦","author":"林光","text":"南浦桥边水，还来泊我船。\n江深寒雨足，山远暮云连。\n贾客波波市，帆樯簇簇烟。\n浮生俱物役，谁复惜流年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51955,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊午元旦试笔","author":"林光","text":"元旦新挥笔，元云洒墨香。\n乾坤初换景，花鸟未须忙。\n帆挂南风稳，江浮旭日光。\n梦中行草势，吾爱皂衣郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51956,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄庄定山","author":"林光","text":"三宿淹留去本迟，乞身容笑未知几。\n明夷偶见伤垂翼，大雅宁教变绿衣。\n老去江山终得计，本来花鸟是忘机。\n流行坎止平生意，不道先生与世违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51957,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吏部候选 其一","author":"林光","text":"晨钟初罢起随群，偃仰檐前几欠伸。\n殊色已无西子梦，欲将眉宇效谁颦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51958,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吏部候选 其二","author":"林光","text":"步步冲尘步步迷，振衣回首日斜西。\n疏槐仰见深春鸟，几度惊飞不肯啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51959,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠熊士选进士尹平湖二首 其一","author":"林光","text":"旧游曾此去迟迟，拈弄风情托几诗。\n赤手看君扶此道，白头閒我浪忧时。\n东南赋歛财应竭，闾里征差力已疲。\n奏最他年徵宰绩，了将民瘼入丹墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51960,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠熊士选进士尹平湖二首 其二","author":"林光","text":"金榜知名识面迟，赠君仍赋弄璋诗。\n新莺细柳供诗酒，暖日和风嘱别时。\n兴趣雅凭山水助，精神休为簿书疲。\n牛刀小试经纶手，会有旌章降玉墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51961,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"屠亚卿索次周司徒分献星辰二坛韵","author":"林光","text":"邕邕天乐协和銮，袅袅心香肃礼坛。\n珠斗艳藏苍玉斝，露华清润紫云冠。\n三斟秬鬯神应格，九奏登歌夜未阑。\n君动臣随皆至礼，天人何以不交欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51962,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵庆成宴","author":"林光","text":"御筵排拥帝星高，五彩云边列俊髦。\n昭代君臣欢此会，百年礼乐宠谁叨。\n春藏御酝传金斝，械卖诸伶傍节旄。\n咫尺天颜恩似海，任教仙脸醉绯桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51963,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵宴归喜雪","author":"林光","text":"醉眼看飞六出琼，老臣欢忭若为情。\n庆成宴彻当今夕，大有年初兆此徵。\n灿烂名花谁点缀，参差台殿玉堆成。\n都门击壤还来我，清韵追赓颂太平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51964,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望西山十首 其一","author":"林光","text":"苍翠拥成堆，尘中眼忽开。\n凉飙吹雨散，清气迫人来。\n胜处岂易到，浮生更几回。\n狂心似孤鹤，飞入白云隈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51965,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望西山十首 其二","author":"林光","text":"青玉削芙蓉，云边数百峰。\n弄晴芒种雨，吹面石尤风。\n景色诗难状，骞腾势本雄。\n千年留王气，深护紫微宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51966,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望西山十首 其三","author":"林光","text":"何处寻真境，桥过远见峰。\n烟消魂欲断，风定兴偏浓。\n岩转应藏寺，潭深或卧龙。\n会携青竹杖，高步翠微中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51967,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望西山十首 其四","author":"林光","text":"江左誇庐阜，闽南羡武夷。\n尘氛俱自累，真境可谁知。\n王气开天府，降龙抱帝畿。\n人间如未见，听诵老夫诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51968,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望西山十首 其五","author":"林光","text":"世计妨吾懒，名山识面迟。\n峰峦新宿雨，花草入谁诗。\n梵宇三千界，泉声十二时。\n何能脱尘鞅，边涧弄晴漪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51969,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望西山十首 其六","author":"林光","text":"小旱偏宜雨，尘空见远山。\n丹青藏佛阁，花鸟隔人寰。\n涧道穿吟屐，松风洒醉颜。\n无由避烦暑，怅望薜萝关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51970,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望西山十首 其七","author":"林光","text":"闻道西山里，僧居面面佳。\n云根穿石窦，泉影照岩花。\n松月门堪打，荷花路未赊。\n鞭羸无限兴，含笑指烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51971,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望西山十首 其八","author":"林光","text":"金银宫阙地，西北势来雄。\n万马从天下，群龙豁眼中。\n壮图基帝里，胜景渴诗翁。\n指点岩花去，云边若个峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51972,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望西山十首 其九","author":"林光","text":"烟霞尘梦醒，日月大丹还。\n玩弄应无厌，儒官我亦閒。\n□□□□□，□□□□□。\n□□□□□，□□□□□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51973,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望西山十首 其十","author":"林光","text":"群峰青不了，冉冉势参天。\n耳寄松风里，心悬涧月边。\n百年真梦境，万事过浮烟。\n安得圆机士，深论易外传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51974,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿三原王冢宰","author":"林光","text":"扶植斯文最有功，谁教大老老关中。\n春延鹤算应无极，天驻仙颜老更童。\n万姓每思文彦博，三边犹惮寇莱公。\n千钧何处逢乌获，吟望青山话未穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51975,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将之严州写怀留别京师诸友八首 其一","author":"林光","text":"尘缘三月住京师，去傍桐江一钓丝。\n三沐三薰扬葛袂，半醒半醉咏鸱夷。\n备尝世味心灰后，拈弄风花景暮时。\n凉雨几番思到骨，卖书争恐买舟迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51976,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将之严州写怀留别京师诸友八首 其二","author":"林光","text":"拜望都门别帝畿，南薰拂面鬓丝丝。\n官如捷举叨祠禄，山到严州似武夷。\n世路怯逢秋暑恶，漕渠争趁雨凉时。\n卑官自笑无多福，閒弄金丹得老迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51977,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将之严州写怀留别京师诸友八首 其三","author":"林光","text":"东风策马出郊畿，莺啭千回柳万丝。\n送我严陵惟钓濑，何心鲁叟欲居夷。\n斯文颇入支离后，至乐深于寂淡时。\n山水天留奇绝处，更将何事怨衰迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51978,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将之严州写怀留别京师诸友八首 其四","author":"林光","text":"问柳寻花出帝畿，新题留别写乌丝。\n何愁浙水无薇蕨，真信严光是伯夷。\n去棹快经霖雨后，计程刚到暮秋时。\n乌纱白葛严州路，祇恐山灵讶到迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51979,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将之严州写怀留别京师诸友八首 其五","author":"林光","text":"海内英豪满帝畿，斯文常欲辨毫丝。\n閒因旧学窥千古，何用虚名慕四夷。\n剩水残山皆乐地，乘田委吏乃吾时。\n阳关几曲都门酒，肯放深杯入手迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51980,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将之严州写怀留别京师诸友八首 其六","author":"林光","text":"叠叠新声写旧畿，别情端似绎吾丝。\n真源会处忘饥渴，世路经来识险夷。\n直把斯文供职业，更将何事答明时。\n宅南宅北春风动，贪种名花岂厌迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51981,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将之严州写怀留别京师诸友八首 其七","author":"林光","text":"千年麟凤几郊畿，道脉悠悠寄一丝。\n诗笔未能忘大雅，羲爻端恐忽明夷。\n苏湖振起文衰后，濂洛开当宋盛时。\n无限怀贤今日意，三千里外铎声迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51982,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将之严州写怀留别京师诸友八首 其八","author":"林光","text":"老眼南畿又北畿，几人倾倒不留丝。\n庙堂何患无韩范，边境今应扫貊夷。\n溟海屡瞻鹏化后，朝阳真听凤鸣时。\n诸君总有匡时策，莫遣封章入奏迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51983,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠吴道夫侍御","author":"林光","text":"乌台风节动京畿，两鬓何曾白一丝。\n赤手正堪扶社稷，高才还拟奠华夷。\n观风屡试繁难地，奏最方当简拔时。\n进退行藏俱未问，爱君真悔识君迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51984,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀竹为孙志同稽勋","author":"林光","text":"何物人间可上心，此君此老爱能深。\n圆通每恐忙边失，虚直还于静处寻。\n挺实正堪留凤鸟，截筒真拟奏韶音。\n箨龙变化云烟外，自有清风动古今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51985,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题陈明之郎中四像","author":"林光","text":"冠袍分四像，同是一明之。\n金榜名题后，莺花酒半时。\n彤墀端步武，冰雪肃容仪。\n无限胸中蕴，丹青恐未知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51986,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白岩为乔希大考功","author":"林光","text":"西北高峰有太行，白岩奇秀在何乡。\n横山喜见云龙变，三晋回看道路长。\n谁许陈抟眠华顶，天催诸葛起南阳。\n平生仰止无穷意，又逐风花入锦囊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51987,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵内翰刘可大赠别","author":"林光","text":"道眼看来透几层，斯文未语意先承。\n诗传肺腑惭康节，病对膏盲得子陵。\n交谊话深连日雨，旅怀书破几宵灯。\n医人医国吾何敢，自笑从前三折肱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51988,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠北京王端馆主","author":"林光","text":"帝城南去更东寻，又有人间一卧林。\n庭宇洁除无俗态，丝桐留挂待知音。\n英豪屡过神皆爽，花木无多趣自深。\n豆饭杯茶何以报，南川诗是笔头金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51989,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答任国光侍御过访","author":"林光","text":"清晓乘骢此赋诗，风清穆穆更熙熙。\n从游却愧相知晚，潇洒端推抱负奇。\n凉浸晨烟聊荐酒，静看庭树小支颐。\n未知他夜严州月，肯送清光及泮池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51990,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵陈学之郎中与客谈诗","author":"林光","text":"语到安排便不符，人间空自费锤炉。\n蝶穿花草春光满，鱼戏江湖月影孤。\n廊庙箫韶终自别，仙家烟火本来无。\n阿谁一笑回风雅，不落陶韦及李苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51991,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中偶述四首 其一","author":"林光","text":"滚滚洪流泻运河，垂杨两岸绿阴多。\n行人无处逃秋暑，欲借清风消几何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51992,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中偶述四首 其二","author":"林光","text":"千尺长牵溯逆河，清流偏少浊流多。\n孤舟小憩浓阴下，更奈秋蝉聒耳何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51993,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中偶述四首 其三","author":"林光","text":"推篷一枕看银河，秋入新凉夜更多。\n翻忆长安骑瘦马，尘埃两眼奈悲何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51994,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中偶述四首 其四","author":"林光","text":"戊午初秋别潞河，双眸空笑阅人多。\n浓阴也爱河边柳，争奈秋风欲送何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51995,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]