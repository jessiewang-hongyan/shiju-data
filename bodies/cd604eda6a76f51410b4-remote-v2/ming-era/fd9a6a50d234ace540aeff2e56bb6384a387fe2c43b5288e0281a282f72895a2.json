[{"title":"长至前七日饮霞峰宗侯宅","author":"苏升","text":"西园开宴近芳辰，卜夜寒樽意倍亲。\n千载宗英推李白，一时豪侠重陈遵。\n飞来郢雪谁堪拟，未动莩灰律已新。\n自笑令堂难浣俗，咏君佳句可怡神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30607,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙沙秋夜酌曹伯缨吴飞子","author":"苏升","text":"龙沙一曲枕江流，白月凉风古寺幽。\n自有芙蓉能蘸水，却怜荷叶不禁秋。\n树边野鸟啼僧舍，江上渔灯映客舟。\n但得相逢须强饮，百年歧路总悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30608,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠董文仲山人","author":"苏升","text":"风仪皎皎曳霞衣，此日湖天见少薇。\n何事鹿门深敛迹，却从鸥渚共忘机。\n剡藤绚烂才双美，烟水沧茫兴倍飞。\n一榻久悬知有待，千秋徐稚好同归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30609,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西昌九日","author":"苏升","text":"重阳无地不登台，万里西风送雁来。\n荷叶尚馀南国色，菊花不似故园开。\n苏卿履谢人何处，徐稚亭孤榻已灰。\n千载凭高徒记忆，好将生事问金罍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30610,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西昌送子曼兄归应举","author":"苏升","text":"世上相亲只弟兄，异乡长傍见真情。\n还家却恨三千里，奋翼犹看九万程。\n青鬓不愁知遇短，白眉宁得与齐名。\n堪怜仲智徒攻火，清梦池塘草自生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30611,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西城夜望","author":"苏升","text":"清流一带抱江城，望入西山尽月明。\n隐隐人家藏树里，轻轻渔舸傍沙横。\n径中不睹陶潜迹，榻下空留孺子名。\n怀古伤今徒白首，夜深无限故乡情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30612,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶成和云西宗侯次韵","author":"苏升","text":"残春天色半晴阴，偶立閒亭伤客心。\n啼去黄鹂复相过，生来青草几时深。\n歌成白雪应留和，酒忆高阳独不禁。\n最是王孙行乐好，马蹄过处足幽吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30613,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"署中竹园偶成 其一","author":"苏升","text":"种竹未成阴，萧疏协素心。\n篱边初著笋，叶处已鸣禽。\n月入风翻影，春过暑不侵。\n閒来听夜籁，恍惚若闻琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30614,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"署中竹园偶成 其二","author":"苏升","text":"忽忽春云暮，寥寥人事过。\n青尊喜相见，白发竟如何。\n诗以忙中废，愁从懒处多。\n未能赋归去，种秫亦蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30615,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"署中竹园偶成 其三","author":"苏升","text":"閒立望龙沙，春风几万家。\n晴云团野色，白日入山斜。\n见地即栽竹，无心学种花。\n孤亭时一立，几点夕阳鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30616,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"勘圩到赵家围","author":"苏升","text":"一年几到赵家围，每到围前泪欲挥。\n已有平田从水出，却无流客异乡归。\n新堤近见黄牛迹，低畔还多白鹤飞。\n最怪老农解春事，挥锄犹欲向渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30617,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠雷元亮先生","author":"苏升","text":"朅来间数白头翁，有尔清标回不同。\n此日说诗能化俗，百年看剑自家风。\n春光好处心俱壮，月旦从人耳似聋。\n尘世一官任年少，酒杯常混野人中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30618,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙沙寺酌汪鲁望孝廉寺中独多莲柳","author":"苏升","text":"中原佳胜几龙沙，有客谈诗玩物华。\n漫忆白莲当日社，却怜新柳在僧家。\n晚风细细归前席，烟雨濛濛湿暮鸦。\n得意看君须尽饮，百年杯酒是生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30619,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"章江忆故园四首 其一","author":"苏升","text":"五月江深似海潮，临流一望暑全销。\n不知小筑当门水，此日何人过板桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30620,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"章江忆故园四首 其二","author":"苏升","text":"亦有渔人出钓矶，江鱼得似海鱼肥。\n无端忽作张郎想，不到秋风也忆归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30621,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"章江忆故园四首 其三","author":"苏升","text":"潮入孤村灌小池，新泉正好濯缨时。\n隔溪应有人来往，五月年年折荔枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30622,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"章江忆故园四首 其四","author":"苏升","text":"十亩荒芜一径斜，清流日日绕人家。\n堪怜昨夜罗浮梦，开尽池塘萏菼花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30623,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊午立秋","author":"苏升","text":"夏雨过新秋，凄清到枕头。\n柳条仍带喜，荷叶莫须愁。\n世事应无定，吾生自百忧。\n葛巾亦无恙，空负酒人游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30624,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿武阳次王敬宇先生壁间韵","author":"苏升","text":"秋山过雨后，一望有云连。\n水落归前港，村深出暮烟。\n疾风憎木叶，白月漾江天。\n景物堪幽赏，车尘自可怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30625,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜客散偕南昌令杨介孺登楼风急望江","author":"苏升","text":"秋到豫章城，登楼入夜清。\n未能分树色，空自有江声。\n客散尊仍绿，山横月半明。\n风波看满目，行者莫须行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30626,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日风雨酌兄季文偶成","author":"苏升","text":"秋风何太急，吹落半庭槐。\n野草自添绿，芙蓉未肯开。\n弟兄一日酒，勋业百年灰。\n此意谁人解，相酬到几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30627,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北行风尘","author":"苏升","text":"风急红尘动，昏昏白日寒。\n马从云里出，人在雾中看。\n群仆竟何去，周行却自宽。\n眼前分未得，望不到长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30628,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入觐留诸宗侯","author":"苏升","text":"征轺驾就出南州，又得相从上酒楼。\n南浦至今人送别，章江终日水环流。\n怜余空抱苍生计，有尔还深宗国忧。\n此去九重勤夜半，鬼神端不借前筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30629,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己未元旦入朝 其一","author":"苏升","text":"万国寺璋向紫宸，禁钟敲彻曙光新。\n乾坤白白开青帝，阊阖森森御圣人。\n星落天高金阙迥，烟生柳亸玉阶春。\n欲知此日龙颜喜，朝罢从容问侍臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30630,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己未元旦入朝 其二","author":"苏升","text":"丹墀次第绕鹓行，烧罢庭燎夜欲央。\n旭日远分金阙色，祥云低引御炉香。\n新莺啼破千宫柳，碧玉敲残万国珰。\n此日临轩筹社稷，诸公应有报君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30631,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"生日夜酌","author":"苏升","text":"堪笑百年徒一瞬，他乡今夕又生辰。\n却怜底事真无定，但得尊醪何厌频。\n望入白云惟见月，梦馀青草不知春。\n殊惭多病为官苦，空有腰肢折与人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30632,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西昌觐行送季文兄南归","author":"苏升","text":"迢迢直上北风高，千里南归路亦劳。\n此日歧途恋骨肉，一时车马驻江皋。\n逼关鼙鼓空惊胆，披甲将军未试刀。\n肯谓书生堪报国，寻常出处只挥毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30633,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北行苦雨","author":"苏升","text":"阴雨迷行色，朝朝不放晴。\n直愁千里滑，转觉一身轻。\n旅食惟家好，征途速路程。\n行行复何顾，忙尽为虚名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30634,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北行杂咏四首 其一","author":"苏升","text":"烟雨多情为洗尘，征途落落且乌巾。\n忘机久失江鸥侣，喜见寒鸦不避人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30635,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北行杂咏四首 其二","author":"苏升","text":"落日无人共酒杯，征轺欲驻雪飞来。\n江南漫道春光早，几树于今尽是梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30636,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北行杂咏四首 其三","author":"苏升","text":"何人赤脚落层冰，敲出深湖见活魿。\n最是渔郎能解事，前村曾有酒如渑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30637,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北行杂咏四首 其四","author":"苏升","text":"沽酒长安日暮寒，风尘马上一冬残。\n荆高饮去馀燕市，此地今谁意气看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30638,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长安得谢伯子书却寄","author":"苏升","text":"十年乔木慰同声，此日翻憎世上名。\n我自风尘怜独往，君今块垒几时平。\n两人已许俱生死，四海从交说弟兄。\n惟讶竹林当日事，山涛无计挽嵇生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30639,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨子江","author":"苏升","text":"杨子江头计日归，春风偏与布帆违。\n黑鱼白鱼迎浪拜，山鸟水鸟向人飞。\n日落群渔依港口，江清微月映船扉。\n夜来沽酒却无事，急抵前村问典衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30640,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己未西昌七夕同诸子分赋得寒字","author":"苏升","text":"可恨银河约，年年但一欢。\n穿针停夜巧，挥扇问秋寒。\n落叶催诗急，疏灯静酒阑。\n吾生相视处，天上一般难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30641,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日龙沙与万元白年兄小酌得秋字","author":"苏升","text":"龙沙日日枕江流，古寺高天一素秋。\n未有芙蓉解芳节，独馀葭菼入新愁。\n西风欲尽当门柳，章水徒撑渡马舟。\n杯酒看君忧世事，辽阳金鼓几时休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30642,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己未九日同徐丰城见初寅丈陈南昌君冯年兄登龙沙","author":"苏升","text":"龙沙一曲枕城隈，今古登高酒数杯。\n日暮紫霞山外落，秋深红叶寺边催。\n最怜南国归鸿蚤，羞见东篱有菊开。\n作赋只今公等在，北风还为孟嘉来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30643,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杪秋萧雁宕丈招饮学中即席赋 其一","author":"苏升","text":"西风吹遍百花摧，留得芙蓉独的开。\n更有主人能醉客，不教箫鼓座边催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30644,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杪秋萧雁宕丈招饮学中即席赋 其二","author":"苏升","text":"尊酒临风万木彤，夜深明月上高桥。\n旁人错认谈经好，听罢歌声未肯饶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30645,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚申元夜雨","author":"苏升","text":"春雨来何早，几宵不放晴。\n江流空有涌，树色半分明。\n灯烛随乡土，尊醪忆弟兄。\n故园今夜月，独坐一含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30646,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夜滕王阁酌陆宁州陈武宁陈南昌诸丈","author":"苏升","text":"家家火树满城春，樽酒凭高入望新。\n锦浪半含灯色涌，轻风还送柳条频。\n论文千载应推陆，下榻当年亦有陈。\n此地独怜经几烬，不堪重问阁中人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30647,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"积雨","author":"苏升","text":"积雨溟溟何日歇，对酒看春心自伤。\n好花试蕊寒仍落，弱柳垂条湿不妨。\n四水入江翻浪白，断云开气出山光。\n此时最苦惟蜂蝶，燕子衔泥因底忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30648,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山行杂咏 其一","author":"苏升","text":"香垆峰上少香烟，鸡犬时闻村舍边。\n尽说群仙留药在，玉隆宫里夜灯悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30649,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山行杂咏 其二","author":"苏升","text":"愁绝山中酒肆稀，独馀青笋路边肥。\n石桥鸣水孤村晚，花落春残雨气微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30650,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山行杂咏 其三","author":"苏升","text":"赤江春雨不曾收，流水涓涓度客愁。\n恨杀小舟无觅处，顿令飞梦碧江头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30651,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山行杂咏 其四","author":"苏升","text":"懒执归途酒一卮，马蹄忙处意偏迟。\n芒鞋已负西山约，何日匡庐识面时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30652,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿青溪观","author":"苏升","text":"晚去寻村路不平，青溪道上已逢迎。\n群山半染浮云色，孤月时明新雨晴。\n天宝石泉帘自白，秦人蜡炬水空横。\n相逢乱指神仙迹，一夜罗浮梦未成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30653,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚申立秋","author":"苏升","text":"金风初入小亭幽，白发依稀送上头。\n篱菊笑人徒岁月，盘荷不自解春秋。\n西山禾黍收空急，紫塞干戈练未休。\n世事关心忧总切，岂堪重上仲宣楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30654,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿王君万年伯母","author":"苏升","text":"锦江碧浪何汪洋。\n瞿塘汹涌势莫当。\n溯源岷岭初滥觞。\n溁流骏发占灵祥。\n岷之族氏谁最扬。\n琅琊伟业垂青箱。\n参军往筮信非常。\n从川合淮流转长。\n徵庭先生閒义方。\n韫奇蓄懿滋温良。\n读书万卷探归藏。\n青藜夜半犹悬光。\n一毡自托清且凉。\n爵衔三鳝登公堂。\n德钜秩小福未央。\n有子葳蕤轶凤凰。\n迹腾碧汉瞻辉煌。\n花县遍栽桃李香。\n孙为鷟鸑仍跄翔。\n旭日照射云锦章。\n来游上苑随鹓行。\n庭阶仪舞瑞虞唐。\n永怀世德夫何忘。\n水木缅邈积馀庆。\n赠诗绚烂盈缣缃。\n金茎仙液看瀼瀼。\n鸿碑驰锡风遐方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30655,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曹母贞节诗","author":"苏升","text":"凛凛青松节，泠泠古桂枝。\n许身原不二，誓志转无私。\n忆昔于归日，双鸾舞玉墀。\n君膺墨绶贵，余亦佐朱丝。\n弦歌推卓绩，兼之扬壶仪。\n一朝凫舄化，拥镜独衔悲。\n捐躯亦何难，所恤在孤儿。\n顾影但私吊，泪尽血交垂。\n断机追往躅，慈训即为师。\n仙雏翼果奋，采羽光陆离。\n既淩秋汉起，复向春云披。\n上苑看花壮，观者羡盈岐。\n世德天所厚，矧兹幽节奇。\n里巷歌声播，天朝宠诏施。\n丹心堪自照，白首事含饴。\n异时辉史册，可以励须眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30656,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王母贞节诗","author":"苏升","text":"结帨事君子，白首以为盟。\n所天一以逝，哽咽但吞声。\n绿发付并剪，单鸾掩镜明。\n九死亦已矣，爱惜怀中婴。\n抚儿甫就读，寒机轧轧鸣。\n一朝苞羽举，烨烨照云京。\n母心既不负，子志亦云成。\n圣世扬风化，高门棹楔旌。\n千载垂杰范，陶孟且齐名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30657,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题同年李仲达孝思亭册 其一","author":"苏升","text":"风木志馀思，犹龙节行奇。\n仰桥空致敬，树背每怀慈。\n戏舞留残彩，嬉啼忆小儿。\n天高何以报，长诵蓼莪诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30658,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题同年李仲达孝思亭册 其二","author":"苏升","text":"业已箕裘扩，恩今雨露蕃。\n哺乌曾寄嘅，容驷有高门。\n岁月亭虽古，杯棬泽尚存。\n庭阶芳气满，料得慰兰孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30659,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿同年刘疏河长兄","author":"苏升","text":"旭日射华堂，祥烟绕一方。\n灵椿披露渥，棣萼带秋光。\n自识金门隐，遥瞻紫气长。\n看君多寿岂，频酌莫辞觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30660,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题翟吉野善应篇","author":"苏升","text":"物数俱有尽，大造总好生。\n同托天地间，苦乐自关情。\n枯骸枕原野，触目胡不惊。\n杳杳逐游魂，微微动转燐。\n愁云翳白日，暮雨哭荒蓁。\n幸得遇贤良，感念无不真。\n一发慈悲心，封土尽成坟。\n揶揄已称异，盎缶如有神。\n古□无主骨，灵台称积仁。\n能雪孝妇冤，沛泽飞苍旻。\n精诚通金石，至信感羽鳞。\n君看隋侯珠，绝代得灵珍。\n载读魏子书，治命立奇勋。\n不与报应期，冥报自嶙峋。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30661,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元日对雪","author":"苏升","text":"元晨飞雪一天寒，赢得梅花腊后看。\n车马缤纷千里道，不知何处卧袁安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30662,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过东林寺","author":"王猷","text":"曲磴千盘道，圆光百丈身。\n碑存前代迹，僧阅几番人。\n聚石谈经后，流泉入耳新。\n到寻三笑路，衣拂虎溪尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30663,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庐山瀑布","author":"王猷","text":"谁将白玉结帘栊，挂上香炉第几峰。\n雨暗幽崖龙吐沫，云流绝壑浪翻空。\n排连直欲倾三峡，错落飞来动八风。\n一吸灵津清彻骨，冰心时在心壶中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30664,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日渡九江步韵酬黄玉轮宫詹先抵通远见寄兼呈李葵孺奉常","author":"王猷","text":"远翠笼深寺，疏钟到客亭。\n江霞千顷练，石竹万峰青。\n月上蟾飞镜，霜横雁带星。\n相期探胜赏，先此寄山灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30665,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同黄玉轮宫詹过濠梁各步前韵","author":"王猷","text":"帝宅瞻佳气，津头步晚亭。\n菊篱霜始白，柳岸浪犹青。\n剑合疑干象，槎浮似泛星。\n冷听歌濯者，适意趣偏灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30666,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪行","author":"王猷","text":"六载王程鬓欲丝，三冬客路雪偏飞。\n行人莫讶寒衣薄，剩得冰衔带月归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30667,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虚阁迎薰","author":"王猷","text":"孤阁凭虚纳晚凉，清樽遥对芰荷香。\n湘帘尽日宜高捲，迎取南薰一味长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30668,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"如亭听籁","author":"王猷","text":"坐倚如亭夜正孤，疏林空见月平铺。\n忽听树杪微风起，错认笙箫乍有无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30669,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"层台远眺","author":"王猷","text":"层台高构对江潮，海色岚光入望遥。\n谩倚危栏长极目，冥鸿千里快云霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30670,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庭院飞花","author":"王猷","text":"庭院春回白昼迟，飞花片片逐游丝。\n相看莫向风前舞，留得馀香扑酒卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30671,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"课耕涉趣","author":"王猷","text":"一犁烟雨带微曛，闲课儿童事晚耘。\n自是鹿门堪涉趣，西风回首见黄云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30672,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]