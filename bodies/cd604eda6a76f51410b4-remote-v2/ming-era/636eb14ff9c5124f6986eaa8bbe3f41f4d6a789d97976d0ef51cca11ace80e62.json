edf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨士宪之云南佥事","author":"杨士奇","text":"万里滇南候绣衣，炎州十月凛霜飞。\n丰城古剑神光动，一道澄清属有威。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3518,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹赠徐绍祥之云南佥事","author":"杨士奇","text":"貌得湘皋脩竹枝，赠君万里赴滇池。\n霜台白简澄清暇，时对琅玕念别离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3519,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹赠陈汝衡之云南佥事","author":"杨士奇","text":"柏台御史承天宠，楚水黔山万里行。\n无限离情何以赠，一枝潇洒凤毛清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3520,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李德固县丞引疾还乡就用问讯巽溪宗长二首 其一","author":"杨士奇","text":"三年佐邑有清名，来往人传不负丞。\n寄语乡闾莫轻看，官卑终不忝西平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3521,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李德固县丞引疾还乡就用问讯巽溪宗长二首 其二","author":"杨士奇","text":"宗老年高八十馀，溪山清趣乐閒居。\n别来思忆心当切，为谢衰残久旷书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3522,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹赠蹇布政复任归湖广 其一","author":"杨士奇","text":"旬宣六载居南纪，喜有清名达紫宸。\n圣主宵衣念民瘼，益惇忠厚佐皇仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3523,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹赠蹇布政复任归湖广 其二","author":"杨士奇","text":"挺特平生冰檗操，自从宪府陟藩翰。\n临岐更赠琅玕玉，相对清风到岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3524,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题少师建安杨先生行乐图 其一","author":"杨士奇","text":"圣明图治任忠良，正倚纯诚柱庙堂。\n画史但知尘外意，青山为写午桥庄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3525,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题少师建安杨先生行乐图 其二","author":"杨士奇","text":"马蹄踏遍龙沙路，载笔频年从属车。\n且缓驰情向萧散，禁中颇牧有谁如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3526,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题少师建安杨先生行乐图 其三","author":"杨士奇","text":"手扶金鼎事调元，玉署贤劳四十年。\n待致雍熙却归去，丹山真作地行仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3527,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题少师建安杨先生行乐图 其四","author":"杨士奇","text":"水色山光绝世尘，长松千尺绕龙鳞。\n何妨添我青藜杖，俱是蓬莱顶上人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3528,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题少师建安杨先生行乐图 其五","author":"杨士奇","text":"玉堂金马同三纪，晏岁梅花雪共妍。\n庐阜武夷归去日，东西来往挟飞仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3529,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题彭甥士淳梅花 其一","author":"杨士奇","text":"北风猎猎捲飞沙，之子南辕道路赊。\n正直冰霜岁华暮，阖闾城下看梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3530,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题彭甥士淳梅花 其二","author":"杨士奇","text":"南溪先生秉高洁，曾乘别驾阖闾城。\n想像梅花丈人行，须知玉润映冰清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3531,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题彭甥士淳梅花 其三","author":"杨士奇","text":"讲堂春永坐横经，绕席梅花相对清。\n想见长洲萧博士，往来吟咏共高情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3532,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅送钟沔 其一","author":"杨士奇","text":"武山秀拔五千仞，下有乔木蟠深根。\n故家文采重清白，铁干璚葩今尚繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3533,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅送钟沔 其二","author":"杨士奇","text":"墨绶铜章向永嘉，人如素璧净无瑕。\n琴堂画永玩香雪，绝胜河阳县里花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3534,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅送钟沔 其三","author":"杨士奇","text":"名县幽偏说瑞安，县公嘉政海同宽。\n牡丹芍药无清趣，只看梅花到岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3535,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题凌士昌所藏张子厚山水 其一","author":"杨士奇","text":"苍崖万仞悬飞练，玉笥匡庐笔底开。\n孤负平生谢公屐，红尘白首未归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3536,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题凌士昌所藏张子厚山水 其二","author":"杨士奇","text":"云山深处草亭幽，磐石垂萝古木稠。\n世外不知尧舜理，超然放意似庄周。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3537,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送凌士昌归省 其一","author":"杨士奇","text":"锦树成行白雁飞，暂辞天阙赴慈闱。\n金陵到日年光晚，别有梅花艳舞衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3538,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送凌士昌归省 其二","author":"杨士奇","text":"温似阳和清似玉，蓬来东阁久相亲。\n北堂归省真堪乐，忆得重来是暮春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3539,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赖编脩读书庄诗 其一","author":"杨士奇","text":"清流城外读书庄，旧隐诗书岁月长。\n玉署归来春正永，松门溪水落花香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3540,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赖编脩读书庄诗 其二","author":"杨士奇","text":"潇洒幽庄县郭南，屏山近屋翠于蓝。\n閒开书卷消长夏，好似龙眠白石庵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3541,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赖编脩读书庄诗 其三","author":"杨士奇","text":"圃有嘉蔬沼有鱼，庭闱甘旨奉安居。\n桂花露重香浮屋，秋爽满林闻读书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3542,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赖编脩读书庄诗 其四","author":"杨士奇","text":"天上蓬山暂赐归，书庄重理旧茅茨。\n锦衣光映梅花雪，具庆筵中奉寿卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3543,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送蒋廷晖致事归临安 其一","author":"杨士奇","text":"御前承敕立挥毫，近侍蒙恩已四朝。\n常有丹心怀报主，不堪霜鬓久萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3544,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]