:"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3499,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题龙泉陈知县竹 其一","author":"杨士奇","text":"遂溪县里春潇洒，密叶繁枝满绿阴。\n白日天风动清韵，如闻单父奏弦琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3500,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题龙泉陈知县竹 其二","author":"杨士奇","text":"筼筜百尺翠亭亭，凤翥鸾骞拂汉清。\n应共龙泉陈令尹，冰霜同结岁寒盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3501,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题张子素竹","author":"杨士奇","text":"冠带朝回夏日长，石泉仙井橘浮香。\n井傍双玉凌空翠，结实须教引凤凰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3502,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题张子素竹石图","author":"杨士奇","text":"练就长生万寿丹，金函拜捧献金銮。\n归来庭掩娟娟玉，静倚珊瑚石畔看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3503,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题蒋生墨竹兼寄声吾望隐居 其一","author":"杨士奇","text":"故家三径盛风流，六月林阴夏似秋。\n但有清香合金石，何须佳客引羊求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3504,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题蒋生墨竹兼寄声吾望隐居 其二","author":"杨士奇","text":"浓比密云清比玉，连枝接叶翠重重。\n严庄庄上堪深隐，最忆君家阮嗣宗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f