[{"title":"寄张幼于庐居","author":"王世贞","text":"吴阊春望欲何如，张仲蓬蒿故有馀。\n青史未荒游侠传，白云长卧孝廉庐。\n隔林幽鸟工催泪，拥榻寒山好著书。\n解道王筠能辨霓，可无双鲤示郊居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"华存叔暨犹子幼圜数有慰和之咏聊此志答","author":"王世贞","text":"华发萧萧卧涧阿，洛阳芳草自铜驼。\n穷来白璧甘萋菲，病起青灯废蓼莪。\n秋色尽饶归计早，阳春翻觉和人多。\n浚冲豪兴真垂尽，奈汝风流二阮何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10983,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辱存叔幼圜和过黄淳父诗再叠奉答","author":"王世贞","text":"论文握手夕阳斜，罢酒还呼顾渚茶。\n久自中原无后进，渐来江表见名家。\n荆山月上人人玉，大庾春生树树花。\n莫以机云誇伯仲，至今千载恨才华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10984,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴江别子与先归迟仲蔚未至辱见贻有答","author":"王世贞","text":"长桥握手惜分离，兴尽东风独解维。\n落日汝耽元礼棹，碧云吾拟惠休诗。\n江天柳暝行人小，泽国波宽度鸟迟。\n可向吴阊访踪迹，旗亭酩酊已多时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10985,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"史叔载有见怀之什及贻所著二咏编有答 其一","author":"王世贞","text":"对酒春风芳草违，怀人东海碧云飞。\n吴门市旧多仙隐，高士星今拟少微。\n书为穷愁翻早就，身因战胜转堪肥。\n野夫事事俱成懒，解把新编卧钓矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10986,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"史叔载有见怀之什及贻所著二咏编有答 其二 周公瑕出示小像见者无不绝倒命余题焉因步往韵","author":"王世贞","text":"隐囊纱帽褐宽袍，丘壑依稀亦我曹。\n名似卢郎堪比玉，颊如裴令欲添毫。\n朱颜雅负阳春在，綵笔能令气象高。\n不独陶然君自好，见来争若醉醇醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10987,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过叶子寅作","author":"王世贞","text":"此日因君驻笋舆，即看骚雅未全疏。\n剑题吴里鱼肠字，帖辨征西䘍尾书。\n斗茗涛声生几席，移床山色在庭除。\n幽兰薜荔真成隐，尚有长杨问子虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10988,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄嘉定杨司训","author":"王世贞","text":"谈诗匡鼎旧名家，且为诸生拥绛纱。\n吏部名仍悬日月，广文官欲带烟霞。\n春风暂假专城绶，秋水犹疑上汉槎。\n为问高斋今夜色，可无清梦到京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10989,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄吴明卿邵武","author":"王世贞","text":"襆被当年出汉庭，中原秋色共飘零。\n吴天剑夺真人紫，闽海符分使者青。\n别后登龙愁自掩，道傍歌凤好谁听。\n因君更熟扬雄赋，怃悴风尘懒独醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10990,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨子用舍弟韵见贻且及助甫旧游之感遂酬一律","author":"王世贞","text":"共传经术授诸生，赋就还闻动两京。\n偶为吴阊新柳色，却怜张绪旧游名。\n江天暮霭空云树，汉苑秋风自露茎。\n池草总题那敢寄，五言君已号长城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10991,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得子与书有卖田之耗用旧寄田字韵为赠","author":"王世贞","text":"西望菰城秋可怜，故人秋兴许谁传。\n微名岁月依稀尽，佳句江湖次第偏。\n辽落生涯文是苑，拍浮身世酒为船。\n休将罢?论归橐，已卖南山种豆田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10992,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同子与诸君游大司寇顾公箬溪书院分韵时公不出且折简见召 其一 得松字","author":"王世贞","text":"壶觞选胜一从容，负郭堂开面面峰。\n地拥菰城横翡翠，天回箬水浸芙蓉。\n敢从门外题凡鸟，曾向云间识卧龙。\n抱日苍虬雄对舞，主人亲植两株松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10993,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同子与诸君游大司寇顾公箬溪书院分韵时公不出且折简见召 其二 得穷字","author":"王世贞","text":"石峭亭虚瞰碧空，振衣长啸许谁同。\n千林瀑过初疑雨，万叶秋归自起风。\n洛下名流唯白傅，襄阳耆旧有庞公。\n仍闻东阁高开宴，不为登临兴易穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10994,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访子与长兴道中","author":"王世贞","text":"客路逢秋倍可怜，布帆如练挂苍烟。\n绿醽若下堪满盏，紫蟹湖头不论钱。\n千里敢言中散驾，百年差胜子猷船。\n怀贤徙倚孤吟发，句就人间懒向传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10995,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日再过伯寅作","author":"王世贞","text":"清渠曲曲护苍苔，剥啄衡门手自开。\n主在未须题凤去，客频宁为好龙来。\n窗前竹色分茶盌，径里橙香入酒杯。\n闻道西山月更好，可能乘兴一登台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10996,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"解斋后过瞻美弟山池一首","author":"王世贞","text":"杜门旬日偶初出，物色风光相映鲜。\n为问攒眉莲社后，能无把臂竹林前。\n青山大可供词客，新月殊堪费酒钱。\n报汝过从应更数，莫教童稚厌周旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10997,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次仲蔚韵题扇赠沈生","author":"王世贞","text":"石头城下草迷离，梦里分明玉树姿。\n纨扇已题桃叶句，白门空唱柳枝词。\n裁将尺鲤羞人问，锁就双蛾祇自知。\n腰带休文浑欲减，可无单舫慰相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10998,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答于鳞","author":"王世贞","text":"岁晏天高首重回，中原万里一书来。\n峥嵘未病惊人笔，黯澹长浮避客杯。\n雁后江湖开气象，灯前风雨失时才。\n自怜身隐文焉用，纵有微吟懒向裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10999,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"于鳞有重寄余兄弟作再答","author":"王世贞","text":"客有将归金错刀，暮云寒色动江皋。\n故人知未驯龙性，小弟凭谁与凤毛。\n名尽酒狂差自若，病来诗态任儿曹。\n相闻不浅埙篪思，莫放阳春调转高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11000,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题于鳞白雪楼 其一","author":"王世贞","text":"平楚苍然万木齐，嵯峨飞阁岱云低。\n峰头玉蕊春长在，槛外金茎夜不迷。\n赋就梁园无左席，书来郢曲有新题。\n何人强责元龙礼，不遣清樽我辈携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11001,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题于鳞白雪楼 其二","author":"王世贞","text":"伏枕清秋海岱边，高楼中擘俯苍烟。\n同云不尽千家晓，寒月长开万古妍。\n天上几看新玉树，山中端合老朱弦。\n誇他信美仍吾土，句就还应两地传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11002,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至日即事示舍弟","author":"王世贞","text":"至后郊居殊可怜，剧昏霾色隐寒烟。\n战馀天地心难识，剥尽阴阳气尚偏。\n海内厌长多事日，山中仅有得归年。\n开尊棣萼能明眼，差胜悲吟剑岭边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11003,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"魏济南顺甫寄过李于鳞之作","author":"王世贞","text":"翩翩露冕拥朱轩，十二诸侯济上尊。\n才大梗阳无讼狱，政馀元礼有登门。\n齐风共许中原色，楚些能忘大泽魂。\n枫叶寒云空自晚，欲将憔悴傍谁论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11004,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲子元日试笔","author":"王世贞","text":"今年云日媚元正，村径衡门也自晴。\n天地容吾新甲子，风尘少尔一书生。\n樽前柏叶将迟得，槛外梅花更剧明。\n但醉婆娑仍起舞，不烦儿女岁时情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11005,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答吴邵武明卿","author":"王世贞","text":"江城腊尽雨萧萧，忽有鸿书破寂寥。\n海内风尘仍岳牧，故人踪迹满渔樵。\n休论往事才空老，不为微名贱转骄。\n东望浮云真咫尺，武夷寒色锁岧峣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11006,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张善甫罢归为酒要之","author":"王世贞","text":"早时海国看除目，晏岁云霄已罢官。\n宦后急流谁退勇，曲中行路古来难。\n春盘入菜贫堪供，社酒含椒醉不寒。\n今日可能相共否，野夫园竹甚平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11007,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄少司马丁公","author":"王世贞","text":"十年曾见补天才，谁遣留侯倦汉回。\n听履星辰仍五岳，拂衣湖海更三台。\n窗前瀑布秋声发，镜里香炉紫气来。\n莫以齐门称国士，剑歌空上阖闾台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11008,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仲春望后二日与彭孔嘉章道华刘子威魏季朗张伯起张幼于舍弟敬美过袁鲁望遇雪探韵得先字","author":"王世贞","text":"袁安馆卧连三日，雷雨初晴雪可怜。\n欲出龙蛇惊暂后，未舒桃李眩争先。\n十年空擅游梁席，此夕俱传倡郢篇。\n极目西山吾并老，拟将春事傍谁妍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11009,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日同彭孔嘉黄淳父周公瑕章道华刘子威袁鲁望魏季朗舍弟过张伯起幼于园亭探韵得梅字","author":"王世贞","text":"吴门忻接二难才，况复筵从七子开。\n句里池塘今夜草，笛中春雪故园梅。\n轻阴作润花偏发，薄暝将寒酒自催。\n别径难忘仍易识，野人芒屩颇能来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11010,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日为西山之游仲蔚病不克偕贻诗见问率尔有答","author":"王世贞","text":"亚字城西春色来，春江日日酒船开。\n杖头排比花间月，屐齿分疏雨后苔。\n济胜可无玄度具，倦游空自长卿才。\n新诗句好堪惆怅，拥鼻篝灯被底裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11011,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与周公瑕袁鲁望张伯起舍弟访要离墓分韵得幽字","author":"王世贞","text":"杖策携樽选胜游，古墩残堞境仍幽。\n千年草傍梁鸿泪，万里潮分伍员愁。\n病后风尘贪自保，醉来然诺暂堪酬。\n延陵故有遗祠在，暮色苍茫未可求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11012,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"横塘春汎得馀字","author":"王世贞","text":"杏脸犹含柳眼初，春江为带月为梳。\n青油荡水丝难挽，白苧和烟调未舒。\n妾住横塘那用问，君收隔垞欲何如。\n越来东去无多路，飘瞥风波恨有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11013,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灵岩晚眺得思字","author":"王世贞","text":"天敞峰回入暝迟，兴来携策未全疲。\n摩挲草暗琴台色，徙倚风传苧妇词。\n穿涧乍惊残屧响，落霞犹似罢妆时。\n还闻越馆仍陈迹，极目凭栏重所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11014,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虎山桥同鲁望公瑕子求道振子念舍弟作得然字","author":"王世贞","text":"桥坐天空自爽然，青山面面吐青烟。\n千花映水霞争发，双崦分流月对悬。\n踞石醉呼光福酒，隔林歌起太湖船。\n不须指点论王气，麋鹿苏台更可怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11015,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"铜坑看梅花作","author":"王世贞","text":"望来千玉缀烟萝，一水维梢香气多。\n峡坼峨眉全拥雪，风回洛浦半凌波。\n渔人只自能寻楚，水部于今不姓何。\n惆怅角声催暝色，醉归还和陇头歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11016,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜登虎丘作","author":"王世贞","text":"松挟春涛万铎呼，忽看飞镜挂浮屠。\n穿池倒映芙蓉紫，立石寒侵薜荔孤。\n不尽澄光行处得，欲观空色坐来无。\n生公倘有门徒在，醉后藜床许借扶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11017,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与舍弟及殷无美饮沙头大梅树下作","author":"王世贞","text":"铜坑万树看不足，沙头一株春可怜。\n霓裳黯淡初月上，玉鳞历乱东风颠。\n骄同白雪论先辈，耻向繁英媚少年。\n但使酒糺苛亦得，不妨今夜藉花眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11018,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀徐荆州子言却访之因先寄","author":"王世贞","text":"野人归卧沧江头，衡门翛然何所求。\n一榻颇为徐孺子，双眼愿识韩荆州。\n即馀丘壑傍谁赏，欲往烟波牵我愁。\n此日扁舟定相遇，可容人唤剡溪游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11019,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐荆州枉驾为诗见贻再答一章","author":"王世贞","text":"暂解专城入梓乡，还将五马问高阳。\n云霄偶自閒中失，湖海真堪醉里狂。\n愁向羊肠论故旧，懒从蜗角辨行藏。\n微名已尽何妨老，句就青山意转长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11020,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王使君明辅迁陕西行省君有惠政于吴好谈禅理雅与余合故末章寄意焉 其一","author":"王世贞","text":"帐饮军容满道傍，朱颜玉节自生光。\n攀辕泪合吴天雨，立马春开太华霜。\n乌徙大江无列柏，雉驯分陕有甘棠。\n炎风朔雪归三表，年少何须怨洛阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11021,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王使君明辅迁陕西行省君有惠政于吴好谈禅理雅与余合故末章寄意焉 其二","author":"王世贞","text":"铃阁翛然静掩门，还容麈尾共玄言。\n能令白社尘中得，肯许青云事外论。\n何地可回严武驾，故人甘卧浣花村。\n唯应破却无生后，不向秋风赋别魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11022,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"殷无美和余与徐荆州还往之作聊尔奉酬并申别臆","author":"王世贞","text":"娄江西望碧如丝，来往扁舟慰所思。\n青山总爱南州榻，白雪长飞郢里词。\n王掾不痴难自解，殷生无恙尔何为。\n倘问别来堪寄忆，沜东杨柳月低时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11023,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龚生夙脩净土近以施药膺冠带之锡索诗为赠","author":"王世贞","text":"衡门冠盖一时新，赐级争誇及汉辰。\n总道净脩居士业，也应微现宰官身。\n岐黄已自成馀事，铜墨由来有胜因。\n我更新秋思漉酒，从君乞取旧纶巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11024,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"殷无美应试留都赋此为赠","author":"王世贞","text":"矫矫诸贤共论文，殷生开美向来闻。\n清词祇和千秋雪，彩笔长干五色云。\n已自江东称独步，还应冀北有空群。\n男儿出处俱常事，莫向青山问右军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11025,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访饮张宪副诚之遇两张有作聊此奉酬","author":"王世贞","text":"萧洒图书四壁间，盘飧此日累君闲。\n别来乡国论今雨，语罢江云失旧山。\n拥砌疏花争霢霂，隔林脩竹弄潺湲。\n自听张恊愁霖咏，不作王猷汎雪还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11026,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠华存叔授官鸿胪","author":"王世贞","text":"十年投璧感知难，今见云霄掌上看。\n业就韩非初著说，赋成扬子一迁官。\n春风故郁含香省，晓月长悬典客冠。\n绵蕞汉仪君解未，建章新阙在长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11027,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日同公瑕鲁望及舍弟游支硎山得林字","author":"王世贞","text":"秋色翛然祗树林，人言避迹此山岑。\n中峰院废空吴晋，石室泉流重古今。\n路尽丹枫时自引，壁危苍藓渐成侵。\n兴来休问支公马，万壑寒云一杖寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11028,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游天池山得遥字","author":"王世贞","text":"萧瑟泓渟胜转饶，华池一镜隐岧峣。\n青莲色借青天近，玉乳寒分玉洞遥。\n树底流云停客榼，竹间凉思满僧寮。\n但容陶令无妨酒，入社篮舆可待招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11029,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天平山饮废寺还谒范祠作得名字","author":"王世贞","text":"千级穿萝望渐平，万峰拥笏骤相迎。\n秋空月并蟾蜍吐，夜壑风疑虎豹惊。\n荒草不传兰若迹，古松犹识范祠名。\n自怜长诵先忧语，拄颊看山尽此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11030,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游木樨岭得峰字","author":"王世贞","text":"酒榼琴囊到处从，风微桂岭昼溶溶。\n亿身金粟光能满，十里旃檀气已浓。\n灵隐不随明月堕，小山长爱白云封。\n狂来一鼓三秋曲，乱插繁花过别峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11031,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"一云山小饮徐氏园归途山中作得身字","author":"王世贞","text":"入眼山家事事新，长松历落踞苍旻。\n苔文剪绿移幽径，竹色分青与近邻。\n双屐天容归后态，一尊秋属醉馀身。\n莫愁斜照行相迫，但宿那能问主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11032,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中公瑕邀游石湖登治平寺作得来字","author":"王世贞","text":"系榜湖桥屧径开，偶逢精舍锁崔嵬。\n莲花倒插空中镜，萝薜长悬定后台。\n夕雨渐从茶磨敛，故人能载酒船来。\n无烦听讲三生法，倚石看云更几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11033,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠章道华宪副","author":"王世贞","text":"相逢慷慨欲如何，桐柱铭成鬓未皤。\n病后风波无薏苡，归来天地有松萝。\n名山禽向终应遍，小径羊求好并过。\n为问洛阳车马客，千秋业就许谁多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11034,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至日作","author":"王世贞","text":"至后阳回万象苏，荒村形影独愁吾。\n疏钟似傍寒光早，步屧仍催返照孤。\n纵饮江湖忘令节，得归天地尚穷途。\n鸡豚自爱田家有，肯向周京忆赐酺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11035,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虎丘寺同子与孔嘉淳父公瑕伯龙舍弟送别袁鲁望张伯起会试北上得阳字","author":"王世贞","text":"绝巘精蓝半夕阳，清尊别思倚苍茫。\n凭栏顿喜云霄近，结驷毋惊道路长。\n池拥双龙元是剑，天回北斗尽成章。\n因窥雁塔岧峣里，似有题名在上方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11036,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送袁鲁望会试","author":"王世贞","text":"把酒河梁白日垂，霜风游子重凄其。\n十年艺苑称先辈，此日公车未后时。\n冀北人来金作帖，河东赋就色为丝。\n中朝岂少鹓行旧，肯向青山问桂枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11037,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张伯起兄弟会试","author":"王世贞","text":"结束翩翩指帝乡，共将新赋献长杨。\n握中联璧终收楚，天上双星旧姓张。\n题塔更闻誇雁序，驱车今已出羊肠。\n唯应仲蔚蓬蒿语，犹似连枝泪几行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11038,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读枢筦集答寄蔡侍郎子本","author":"王世贞","text":"忆尔曾都将相权，欲将名姓勒燕然。\n俱听越石清秋啸，不废东山零雨篇。\n卿月暂违双掌露，使星翻傍五湖烟。\n亦知刘白多移请，洛下新诗大好传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11039,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与徐汝南过许给事饮作许素精事馔是夕特穷水陆畅饮至醉","author":"王世贞","text":"今夕何夕兴不孤，锦堂烛煖红珊瑚。\n尊中若下谁可拟，眼底高阳何处无。\n主人自为孺子榻，下客叨入郇公厨。\n当门乌语树将白，犹自狂吟倾玉壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11040,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠梁伯龙","author":"王世贞","text":"汉关题罢鬓初华，梁苑文成席更誇。\n匣里秋霜诸侠少，曲中春雪旧名家。\n江陵客写金楼子，建业人歌玉树花。\n谁道归来仍壁立，文君窈窕自煎茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11041,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠郭子","author":"王世贞","text":"紫髯狐腋自翩翩，万里风烟指掌前。\n策杖天穷章亥步，然藜夜校景纯篇。\n城佳白马时能识，地暖青牛可再眠。\n好杜悬河吾薄晓，吴山何地不堪怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11042,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]