[{"title":"赠刘提盐署郡捕","author":"卢龙云","text":"三城苍赤幸依刘，筹策兵农事事优。\n万灶牢盘供裕国，一方锁钥佐为州。\n官閒未比曹疑马，俗易行看剑买牛。\n盐铁不须持汉议，消弭兼颂富民侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20294,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柏茂蒲芳图寿周宪副","author":"卢龙云","text":"早年三径遂鸿冥，柏实蒲香学制龄。\n直干长留千尺黛，灵根不断四时青。\n乌栖朱博台中府，鹤舞安期涧畔亭。\n耆社只今尊洛下，太丘门更聚群星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20295,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游氏迎晖堂","author":"卢龙云","text":"鸡鸣晓日映扶桑，万里烟消见曙光。\n影动楼台初上下，色增台构共苍凉。\n中天瑞霭开长夜，满地清晖豁大荒。\n最是飞腾宜凤羽，先从海外得朝阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20296,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"锦江春色图","author":"卢龙云","text":"万里休嗟蜀道难，披图春色满江干。\n烟开巫峡峰千叠，花接岷峨树几盘。\n金马岧峣苍霭合，青羊占候紫云宽。\n何当舣棹星桥下，草阁琴台载酒看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20297,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送萧孝廉初上春官","author":"卢龙云","text":"五云翘首望金台。\n万里群游亦壮哉。\n江月满船催晓发，岭梅迎骑报春魁。\n山中豹变开玄雾，浪里龙吟起蛰雷。\n最是登瀛需妙选，泥金消息待南来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20298,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题鹤南飞图寿陈勋卿","author":"卢龙云","text":"图南羽翼出尘寰，矫首层霄未易攀。\n琴伴昔年游蜀道，笙吹何日到缑山。\n九皋闻野风前听，千岁巢松月下还。\n谁解穿云调玉笛，苏仙文物正堪班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20299,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归粤寿母卷为马仲高作","author":"卢龙云","text":"万里观光入帝畿，瞻云犹自恋春晖。\n总缘罔极怀明发，岂为羁愁赋式微。\n璧水桥门推论难，平津阁道见知希。\n归来慈母看缝线，片片天香染彩衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20300,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈勋卿招饮龙津别墅先遗长篇赋谢","author":"卢龙云","text":"折简重来忆隔年，深尊容我复谈天。\n杯前云影千行雁，棋里秋声几树蝉。\n双屐东山游暂卧，盈门北海坐常延。\n诗情更觉飞扬甚，彩笔先悬白雪篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20301,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送举主何侍御还京","author":"卢龙云","text":"闽海当年奉属车，姓名叨列荐贤书。\n周南迹滞登龙后，冀北群惭相马初。\n大泽风雷愁魍魉，閒居岁月傍樵渔。\n孤臣恋阙心犹在，已逐前旌梦玉除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20302,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和体韶妹丈劝发","author":"卢龙云","text":"几年泉石托清流，差胜尘途感百忧。\n苦为交亲辞野服，又随京国梦宸旒。\n山间木叶催寒序，径里花枝恋酒筹。\n更美莼鲈思缓发，免教长路即悲秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20303,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诸叔侄兄弟携具促发赋别","author":"卢龙云","text":"几载郊居罢远游，复劳相赠看吴钩。\n祗因汗漫思湖海，更逐风尘应马牛。\n竹叶临岐催去棹，芦花和雁宿前洲。\n閒身又判从人没，敢向天涯咏四愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20304,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答亲友赠别十九首 其一","author":"卢龙云","text":"归来似为厌时名，又听阳关送别声。\n得丧漫同失马叟，去还宁比弃繻生。\n惭余浪迹过三仕，喜尔雄文重二京。\n莫遣风尘双鬓改，东隅犹及见功成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20305,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答亲友赠别十九首 其二","author":"卢龙云","text":"幽居曾傍水云开，已分清时只草莱。\n最是亲朋工劝驾，非关廊庙远抡才。\n天閒拟共驰中驷，列宿还从望上台。\n握手慇勤各持赠，多君别赋旅中裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20306,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答亲友赠别十九首 其三","author":"卢龙云","text":"瞻天万里觉途长，叠尽阳关酒一觞。\n处处江山人是客，盈盈秋水露为霜。\n朋游上国多鹓侣，鞭弭中原有雁行。\n山鬼笑人君莫讶，楚舆犹为凤歌狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20307,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答亲友赠别十九首 其四","author":"卢龙云","text":"为园久拟著潜夫，惭愧当年屡剖符。\n圣世几曾需俗吏，公车元自盛文儒。\n天涯预叹书邮杳，斗下翻疑剑气孤。\n迟尔赋成须诣阙，早看鲲运试南图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20308,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答亲友赠别十九首 其五","author":"卢龙云","text":"江湖漂泊隔鹓班，草野何知觐圣颜。\n被褐似从方外至，鸣珂仍向日边还。\n鹍鹏敢谓搏南海，猿鹤先教怨北山。\n试问弹冠当早晚，未应长恋钓鱼湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20309,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答亲友赠别十九首 其六","author":"卢龙云","text":"尘途老我仍脂辖，艺苑多君擅斲轮。\n拙宦久孤金结士，神交偏羡玉为人。\n驱驰自觉风霜久，岁月相期雨露新。\n自是同声怜去住，故传篇咏到通津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20310,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答亲友赠别十九首 其七","author":"卢龙云","text":"拟因遗世谢浮名，颇为傍人笑独清。\n岂比隋珠能照乘，敢方赵璧抵连城。\n仍为小草惭羁旅，已就长杨羡墨卿。\n时事正须幽侧问，治安何日奏承明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20311,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答亲友赠别十九首 其八","author":"卢龙云","text":"飘摇征袂拂霜寒，老大深惭独据鞍。\n至后喜看时渐改，行边不记路曾难。\n裘怜季子尘中久，铗笑冯生暗里弹。\n尘世几人堪共济，怀香应待谢家兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20312,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答亲友赠别十九首 其九","author":"卢龙云","text":"草堂无事只科头，谁遣膏车赋远游。\n开径转应怜仲蔚，轻舟难复似王猷。\n因耽薄禄居频卜，久识微名世共浮。\n明到蓟城春未晚，与谁觞咏散乡愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20313,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答亲友赠别十九首 其十","author":"卢龙云","text":"衡门幽寂久烟萝，又赋骊驹兴玉珂。\n往事只看云共散，致贤难俟礼为罗。\n人情黯淡遭时晚，宦绩优游较孰多。\n似尔林泉堪寄傲，南山休续饭牛歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20314,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答亲友赠别十九首 其十一","author":"卢龙云","text":"江头彩鹢应潮开，犹记龙津月下台。\n桂树有丛淹作赋，菊花留径狎传杯。\n中朝事业推耆旧，末路蹉跎愧不才。\n孤剑斗光明灭半，五云何日傍三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20315,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答亲友赠别十九首 其十二","author":"卢龙云","text":"樽酒河梁忆路岐，海天风雨正纷披。\n鹿门已道终遗世，狗监何心更遇时。\n升斗逢迎衣食累，关山迢递鹤琴知。\n公车岁岁徵贤硕，草野能无念国危。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20316,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答亲友赠别十九首 其十三","author":"卢龙云","text":"念载驱驰道路难，买邻曾借一枝安。\n暂违松菊先生里，敢附风云国士坛。\n蜀赋祗今危鸟道，楚歌元自爱幽兰。\n山中猿鹤君能主，莫拟移文异日看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20317,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答亲友赠别十九首 其十四","author":"卢龙云","text":"閒居水石差怡性，恋阙驺车又戒途。\n已愧朝阳冈上凤，漫随波泛水中凫。\n考槃羡尔开三径，作赋令人重两都。\n康济并需岩穴士，先忧宁道只江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20318,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答亲友赠别十九首 其十五","author":"卢龙云","text":"忆昔分符海上城，寸心无日不悬旌。\n官同即墨宁干誉，政比丹徒却坐清。\n拙宦久劳州郡职，汉庭多薄少年生。\n蛾眉渐老应销妒，启事何当辱鉴衡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20319,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答亲友赠别十九首 其十六","author":"卢龙云","text":"千古东山慕谢安，蓬蒿一径岂同看。\n玄言并拟幽人宅，赤帜谁堪大将坛。\n霜映万枫帆影度，斗连五夜剑光寒。\n悠悠燕粤音书隔，期尔方弹贡禹冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20320,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答亲友赠别十九首 其十七","author":"卢龙云","text":"祖道不堪乡土别，绨袍偏恋故人心。\n祗缘慷慨思燕筑，却任漂零作越吟。\n白社几年曾伴月，苍生何处拟为霖。\n疏才薄宦知无补，竹户谁开待抱琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20321,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答亲友赠别十九首 其十八","author":"卢龙云","text":"落月常悬照屋梁，临岐不得共持觞。\n藏珍敢谓明时重，伏枥仍期知己良。\n万里关山重作客，十年漂泊老为郎。\n弓旌何日求岩穴，召对看君入帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20322,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答亲友赠别十九首 其十九","author":"卢龙云","text":"醇交自昔推公瑾，诗伴如君复建安。\n再向风尘驱下走，又从羁旅对南冠。\n衡门水石思仍系，客路星霜迥自寒。\n但道时艰须共济，过都迟尔路非难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20323,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁寒松柏图","author":"卢龙云","text":"朔气能寒海上山，却留苍翠倚云间。\n时看舞鹤笙前下，长听栖乌月里还。\n天泽九重承自远，霜标千仞渺难攀。\n休疑绿鬓年年好，柏实松苓总驻颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20324,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟行值雨","author":"卢龙云","text":"长江烟雨泛兰桡，极目关山万里遥。\n踪迹重违门外柳，功名犹是梦中蕉。\n客来转忆孤山鹤，寒至偏侵季子貂。\n何日功成归绿野，丛林丰草任渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20325,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度庾岭逢雪","author":"卢龙云","text":"重游不似旧看山，满目琼瑶应接间。\n好拟新篇歌郢里，莫将匹马比蓝关。\n山阴月色扁舟往，江上渔歌独钓还。\n此日寒云征路满，驱驰难任意同閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20326,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"取道浙行值岁方暮","author":"卢龙云","text":"岁暮阴阳羁旅泊，天涯泉石梦郊居。\n红尘再拟看花会，白社初抛种树书。\n适越有怀探禹穴，浮江无用吊三闾。\n春来依旧王孙道，芳草东风不负余。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20327,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟次葛阳","author":"卢龙云","text":"容与扁舟度葛阳，停桡相问总他乡。\n几般笑语山川异，两月舟帆驿路长。\n腊尽官梅含雪色，春来群卉换年芳。\n旅吟只讶同声少，行李萧萧大道傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20328,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春群玉山楼滞雨二首 其一","author":"卢龙云","text":"天畔楼台面面峰，游人朝暮感萍踪。\n云连塔影笼山寺，雨带溪声急野舂。\n榆柳渐还新岁色，松杉不改旧时容。\n祗因留滞伤羁旅，极目烟霄路几重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20329,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春群玉山楼滞雨二首 其二","author":"卢龙云","text":"青青麦陇发华滋，烟雨微濛望亦宜。\n林冻乍消飞燕雀，涧泉初暖浴凫鹥。\n千家城郭春偏丽，百叠云山翠转奇。\n最是旅游思道路，目悬钟鼓报晴时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20330,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕泊舟钱塘","author":"卢龙云","text":"春波荡漾水悠悠，今夕钱塘始系舟。\n潮拥一江寒白马，路如三峡见黄牛。\n城中箫鼓千家月，客里云山独酌愁。\n况是旅怀思旧切，不堪闻笛过西州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20331,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早行","author":"卢龙云","text":"结束登程恨未裁，出门周览尚徘徊。\n披星马首钟前动，带月鸡声梦里催。\n两地宾朋愁再别，九天阊阖待重来。\n相逢若问游人意，怀抱当春只好开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20332,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初入京黄士明吉士夜过谈旧","author":"卢龙云","text":"风尘羸马入燕关，杯酒逢君意气间。\n夜话故园难竟语，远来孤客亦开颜。\n长杨已羡能遭主，小草何心更出山。\n最是春光饶上苑，教人仍向日边还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20333,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送翟思信同年之任抚州别驾","author":"卢龙云","text":"夹堤杨柳绿初稠，折赠屏星上道周。\n历国霜蹄新展骥，出硎莲锷自冲牛。\n专城保障资分画，一路风烟净借筹。\n治行只应全活众，汉庭思拜富民侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20334,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王直夫令宁远","author":"卢龙云","text":"藉甚文名自国华，分符无亦为丹砂。\n登坛已就千秋业，制锦初看一县花。\n经术由来堪?吏，闾阎念及总为家。\n汉庭最重循良治，次第承恩未有涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20335,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"巢燕","author":"卢龙云","text":"海国微茫识路长，衔泥时带落花香。\n绸缪岂为防阴雨，栖息从来托画梁。\n择木不教群鸟妒，将雏能待九霄翔。\n即论秋去春还至，旧垒依然王谢堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20336,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答黄将军","author":"卢龙云","text":"海上楼船系夕阳，弯弓何日挂扶桑。\n时平独抱匡时略，客久多从结客场。\n白堕每邀山月上，绿沉閒卧野花香。\n怪来横槊新篇富，最喜沧波静不扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20337,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春暮京邸","author":"卢龙云","text":"门掩残春独咏诗，羁怀愁对好花枝。\n功名自古违心事，道路于今感鬓丝。\n迹学东方聊玩世，名惭司马却同时。\n漫游处处堪乘兴，何必山中旧紫芝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20338,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送林桢灿别驾督运事竣还江南","author":"卢龙云","text":"几年云树忆同袍，杯酒都门藉尔豪。\n刍粟万方军国计，舳舻千里使臣劳。\n上林花鸟归囊草，客路星霜引佩刀。\n试看昔时称汉吏，独凭转饷见功高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20339,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送罗尊生太学南归","author":"卢龙云","text":"衣马翩翩惬壮游，几回见月忆刀头。\n百年礼乐观王国，万里江湖傍客舟。\n赤日喜沾梅子雨，微风时送麦花秋。\n临岐预有重来约，迟尔书成又帝州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20340,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"京中承诸年丈招饮","author":"卢龙云","text":"回首看花越廿年，霜蹄次第着鞭先。\n艰危独自悲行路，意气重逢念各天。\n礼数尽宽中执法，醉歌休拟上留田。\n南游复指浔阳道，湖月江风孰与怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20341,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都门赠马平俞生","author":"卢龙云","text":"二十年前忆柳州，论文当日几相投。\n积薪似我方沦落，抱玉如君亦滞留。\n再出尚图怜故剑，重逢更欲赠吴钩。\n匆匆又作都门别，莫向桑榆薄晚收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20342,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"京邸即事","author":"卢龙云","text":"朋游折简日相呼，客舍何言一事无。\n匡坐残更醒酒困，篝灯阖户理诗逋。\n尘中挟刺心偏苦，花外论文兴未孤。\n到处品题多物色，不知世上有穷途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20343,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答张孟奇秘书","author":"卢龙云","text":"玩世优游此日心，岂于名利问升沉。\n閒身幸许依庐岳，混迹何须羡汉阴。\n鸟道艰危容拙宦，凤池清切足高吟。\n琵琶若对江州月，最是新诗豁远襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20344,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答袁大观","author":"卢龙云","text":"苦雨阴霾黯不舒，临岐驻马意何如。\n已应走卒知君实，那得中朝问子虚。\n握手赠言千里思，加餐念旧隔年书。\n江风纵与滕王便，尚隔舟帆一月馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20345,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"京口望长江","author":"卢龙云","text":"飘蓬何地不天涯，吴楚东南望尚赊。\n暑雨濯枝辞凤阙，西风闻雁转龙沙。\n九江亦接浮湘路，八月宁同奉使槎。\n万里关山无定泊，教人回首忆京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20346,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瓜洲别廖文学之饶平便道过里","author":"卢龙云","text":"捧檄同君出帝城，扁舟南下棹波平。\n中流过雨增河广，两岸鸣蝉送客行。\n忆李他时云树意，师韩潮士斗山情。\n月明瓜步分岐处，二字乡园为寄声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20347,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送郭朝谔司理之螺川","author":"卢龙云","text":"潞水方舟慰合并，维扬杯酒别愁生。\n余过吴会惊秋早，君泊秦淮对月明。\n饬治久知经术富，谳疑先借法曹行。\n双鱼一水非难达，莫忘吾兼吏隐情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20348,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七月六日舟过广陵别同行诸子并柬庞与虔明府","author":"卢龙云","text":"相从理棹下扬州，葭菼离离满目秋。\n却笑此身非跨鹤，又将时序会牵牛。\n弟兄海内希长合，萍梗天涯不自由。\n二十四桥今夜月，箫声谁与伴维舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20349,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜龙光寺宴集","author":"卢龙云","text":"双林幽寂抱龙沙，有客携樽傍晚霞。\n江静游鱼听笑语，秋深鸣雁出蒹葭。\n洪都自古称人杰，高会于今共物华。\n夜久不知霜露冷，砧声淩乱月千家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20350,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日滕王阁宴集","author":"卢龙云","text":"连甍飞阁俯芳洲，载酒乘閒作胜游。\n拄笏山来空翠爽，凭阑波带夕阳浮。\n千年艺苑人云远，八月清江序复秋。\n客子登临思正渺，还谁高士擅南州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20351,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答方伯闇太学","author":"卢龙云","text":"几回明月暗中投，江上寻芳杜若洲。\n暂可陆沉追酒伴，岂终牢落困书囚。\n琴缘流水思同调，璧是连城合晚收。\n却笑天涯羁薄宦，每烦诗句慰淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20352,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"馀庆堂为郝司理赋二首 其一","author":"卢龙云","text":"华堂清峻表西河，高士当年号乐窝。\n荀氏星辰元聚德，张家门巷待鸣珂。\n功方种玉应同大，遗比籯金较孰多。\n况是作求称嗣美，致祥端合迓天和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20353,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"馀庆堂为郝司理赋二首 其二","author":"卢龙云","text":"亲舍瞻云万里遥，桂丛犹记小山招。\n莫论巢许轻尧禄，须信金张重汉貂。\n玉树栽培来已远，金茎雨露喜初饶。\n总缘召顺膺多福，不尽恩光下九霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20354,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答罗茂才兼送南归","author":"卢龙云","text":"萍蓬天外忆罗浮，客路风霜感百忧。\n孤鹤唳穷千里月，断鸿声彻九江秋。\n时情漫道同云薄，往事都教付水流。\n悬榻自知惭仲举，可能徐孺共淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20355,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄寿黄懋忠明府","author":"卢龙云","text":"忆别尊前感岁华，又传香雪散梅花。\n风尘道路分千里，表里关河亦一家。\n南极有星光海峤，东山胜地傲烟霞。\n阶庭雨露多兰玉，颂入华封庆倍嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20356,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]