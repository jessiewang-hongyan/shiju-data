[{"title":"送蒋廷晖致事归临安 其二","author":"杨士奇","text":"甲申诏命举能书，第一能书众未如。\n霜木晨星几人在，又承恩旨遂閒居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3545,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送蒋廷晖致事归临安 其三","author":"杨士奇","text":"两京三十馀年住，家在钱塘旧业残。\n想见西湖千树雪，岁寒还似昔时看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3546,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送蒋廷晖致事归临安 其四","author":"杨士奇","text":"钟繇笔法传羲献，此是临池最上源。\n玉堂无事曾同论，别后何人更共言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3547,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送蒋廷晖致事归临安 其五","author":"杨士奇","text":"洪熙诏下体群臣，七十归休旧典伸。\n眼底同年人去尽，自怜犹是未归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3548,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨允宽贤良省觐后南还 其一","author":"杨士奇","text":"家住龙津好山水，杨墩流泽百馀年。\n田园不待论生计，孙子森森秀更贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3549,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨允宽贤良省觐后南还 其二","author":"杨士奇","text":"白鹤山前松柏地，春秋拜跪奠清杯。\n何堪父子衷情切，万里天涯几度来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3550,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨允宽贤良省觐后南还 其三","author":"杨士奇","text":"严亲一片丹心苦，上为邦家下庶民。\n白发满头躬匪懈，远来深慰暮年情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3551,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨允宽贤良省觐后南还 其四","author":"杨士奇","text":"春趋门下侍亲闱，秋别亲闱出帝几。\n已别欲行仍缱绻，为承亲命敢迟违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3552,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨允宽贤良省觐后南还 其五","author":"杨士奇","text":"河上秋风九月高，临河酹酒发归舠。\n县知一路思亲意，回首京华梦寐劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3553,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨允宽贤良省觐后南还 其六","author":"杨士奇","text":"曾看髫岁勤书卷，黑发于今已抱孙。\n莫讶衰翁七十二，且同论旧倒离尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3554,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨允宽贤良省觐后南还 其七","author":"杨士奇","text":"同宗同道同官署，金石交情三纪周。\n建安有子真龙种，惭愧吾家犬彘流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3555,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨允宽贤良省觐后南还 其八","author":"杨士奇","text":"娟娟玉树照人明，仪表雍容意度新。\n珍重茂年勤德业，承芳终合到公卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3556,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨允宽贤良省觐后南还 其九","author":"杨士奇","text":"良玉由来不自沽，但脩天爵待时须。\n君家忠厚多馀庆，请视流传万木图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3557,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨允宽贤良省觐后南还 其十","author":"杨士奇","text":"故乡南去路迢遥，红树凌霜叶半凋。\n桑梓人人望归客，沿流休驻木兰桡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3558,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"示训升侄","author":"杨士奇","text":"学人有道戒骄盈，谦益由来著圣经。\n看取千流并万派，尽沿东下作沧溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3559,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送民则弟南归 其一","author":"杨士奇","text":"用舍行藏皆有命，山林朝市岂关心。\n故乡归去谢尘累，吟坐武公淇澳林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3560,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送民则弟南归 其二","author":"杨士奇","text":"叨禄词垣四十年，白头无补日忧悁。\n羡渠拂袂还山去，潇洒云林一散仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3561,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送民则弟南归 其三","author":"杨士奇","text":"沃壤自耕三亩秫，水边林下澹无荣。\n高车驷马多颠覆，得似幽人隐趣清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3562,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送民则弟南归 其四","author":"杨士奇","text":"深溪文献三百载，水竹园田清绕居。\n归及宗家敦六行，还勤简册乐三馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3563,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送民则弟南归 其五","author":"杨士奇","text":"匡山先生乡达尊，临川道学有渊源。\n脩齐堂上遗书在，莫负青春细讨论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3564,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅送民则弟南归","author":"杨士奇","text":"万里南归莫叹嗟，东风持赠玉梅花。\n百年乔木诗书泽，珍重桂林同守家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3565,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送张振文","author":"杨士奇","text":"新捧除书上贰车，郁林迢递望苍梧。\n到时知及春三月，闻彻竹枝闻鹧鸪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3566,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅送辉侄赴宣城训导","author":"杨士奇","text":"腊前定到宣城邑，斋舍梅花吐正妍。\n看取岁寒冰玉色，莫忘清白有家传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3567,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送士弘郎中归省 其一","author":"杨士奇","text":"金銮殿下拜天恩，二月辞天出禁垣。\n归到比当春正暖，东风慈竹子孙繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3568,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送士弘郎中归省 其二","author":"杨士奇","text":"夏官郎署二十载，玉立亭亭故可人。\n万里江南看归省，清风不改旧时贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3569,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题四皓","author":"杨士奇","text":"初下商岩入汉廷，脩眉疏鬓雪霜明。\n从容一语安邦国，信是君王任老成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3570,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"邑萧生为余写小像因求朱中书添竹数竿以示不忘东皋之意","author":"杨士奇","text":"春雨东皋竹万竿，主人白发未休官。\n常将一片冰霜意，期尔青青共岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3571,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题和侄竹","author":"杨士奇","text":"清溪溪上似淇园，散叶分枝绿正蕃。\n又看移根度江去，石塘春雨长儿孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3572,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题和侄梅","author":"杨士奇","text":"故家昼锦坊中住，连屋诗书绝点埃。\n好傍溪山结精舍，不看桃杏只看梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3573,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题弼侄鹤","author":"杨士奇","text":"午夜月凉清露下，舞馀嘹唳九皋音。\n萧閒不是轩墀物，海阔天高万里心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3574,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题弼侄竹 其一","author":"杨士奇","text":"清溪溪上竹如箦，旧隐林中趣味长。\n堪笑幽閒大小阮，也劳尘事逐山王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3575,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题弼侄竹 其二","author":"杨士奇","text":"单父堂前玉两竿，政閒每日报平安。\n可人千尺冰霜操，要看亭亭到岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3576,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题弼侄山水","author":"杨士奇","text":"平生端绂侍金闺，万里云山忆故栖。\n正是江南三月暮，枫林茅舍子规啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3577,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题弼侄梅","author":"杨士奇","text":"轻薄纷纷桃李过，梅花独擅岁寒清。\n为语子孙坚雅操，莫隳清白旧家声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3578,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画送韩御史旸归省 其一","author":"杨士奇","text":"秦望山清近若耶，纷纷云树映溪沙。\n数椽茅屋无尘杂，知是安阳御史家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3579,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画送韩御史旸归省 其二","author":"杨士奇","text":"十载怀归归未得，越中山水望中迷。\n封章早晚天恩下，昼锦乘骢入会稽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3580,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题邢参议竹","author":"杨士奇","text":"六年嵩洛佐藩翰，劲节清风九夏寒。\n阅历冰霜长不改，青霄终到五云端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3581,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹寄一夔侍讲 其一","author":"杨士奇","text":"翰苑銮坡日月边，五更联辔共朝天。\n独封青简收金匮，去傍云林作散仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3582,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹寄一夔侍讲 其二","author":"杨士奇","text":"江南三瑞同升日，邂逅京华意最亲。\n阅历风霜三十载，一枝留擅故林春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3583,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹寄一夔侍讲 其三","author":"杨士奇","text":"风流文采玉堂人，冰雪襟怀夐绝尘。\n好在江南烟雨外，翠壶时醉洞庭春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3584,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹寄一夔侍讲 其四","author":"杨士奇","text":"娇花媚草谩纷纷，直节清风见此君。\n我忆词林余太史，题诗聊复继停云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3585,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送孙徽州诗","author":"杨士奇","text":"仙郎朝捧天书出，五马双旌别路寒。\n遥想阳和与嘉政，新年一并到新安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3586,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题何司历梅 其一","author":"杨士奇","text":"谁将烟艇过西湖，写得梅花入画图。\n八卦推馀白昼静，焚香何假博山炉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3587,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题何司历梅 其二","author":"杨士奇","text":"大庾关头第一枝，会稽笔法几人知。\n疏影清香坐相对，君平初是下帘时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3588,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题江乡归趣图 其一","author":"杨士奇","text":"手握天机丝五色，大庭补衮不辞勤。\n如何一夕秋风兴，忆著沧波旧钓纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3589,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题江乡归趣图 其二","author":"杨士奇","text":"绿水青山写作图，无边逸趣在樵渔。\n不闻昔老渭川叟，八十初来载后车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3590,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题江乡归趣图 其三","author":"杨士奇","text":"早年八九吞云梦，老见乾坤四海心。\n为语江云缓飞去，从龙还用作甘霖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3591,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题江乡归趣图 其四","author":"杨士奇","text":"七十年高鬓未皤，新来归兴似江波。\n玉堂更住三千日，去和尧民击壤歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3592,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题江乡归趣图 其五","author":"杨士奇","text":"一带江乡五千里，春风浩荡画图新。\n莘野磻溪有相似，明时耕钓岂无人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3593,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题江乡归趣图 其六","author":"杨士奇","text":"金陵南上到江陵，看画依稀感嘅生。\n赤壁尚馀沉戟在，黄州谁和洞箫声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3594,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题江乡归趣图 其八","author":"杨士奇","text":"少年初赋远游篇，曾看三湘七泽连。\n共是玉皇香案吏，他时随去挟飞仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3595,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题江乡归趣图 其九","author":"杨士奇","text":"鹦鹉洲前杨柳树，飞花偏著钓蓬多。\n何时半醉蓬窗底，卧听沧浪孺子歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3596,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题江乡归趣图 其十","author":"杨士奇","text":"半生近侍共清班，行见天恩并赐閒。\n重过南楼跨黄鹤，寻君须到绣林山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3597,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹鹤双清图寄宾畿弟 其一","author":"杨士奇","text":"初下云霄息羽翰，清风閒傍翠琅玕。\n无边玄圃沧洲趣，寄与家林老弟看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3598,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹鹤双清图寄宾畿弟 其二","author":"杨士奇","text":"忆别宾畿九历春，天涯霜鬓各如银。\n悬知林下多情事，还对皋禽念远人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3599,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题给事中梅花","author":"杨士奇","text":"螭头簪笔退朝迟，小阁银瓶玩竹枝。\n想见襟怀清似玉，冰霜还结岁寒期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3600,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题富溪山水图 其一","author":"杨士奇","text":"曾从萧峡溯桐江，隔岸青山拥客艭。\n何处水亭沽酒幔，谁家云树读书窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3601,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题富溪山水图 其二","author":"杨士奇","text":"富溪邈在江南曲，水色山光画不如。\n知有幽人茅舍住，尽抛尘事事樵渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3602,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"老妻郭夫人命服像赞","author":"杨士奇","text":"从嫁黔娄执勤俭，奁中犹贮旧荆钗。\n内朝屡作东班首，拜庆金宫玉殿来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3603,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题魏仲房梅","author":"杨士奇","text":"潇洒东风万玉林，清香终日伴清吟。\n都无一点流尘到，雅称平生冰雪心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3604,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄孙徽州","author":"杨士奇","text":"新安太守布宽仁，想见新安物物春。\n公暇高情倚盘石，閒听幽鸟看粼粼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3605,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅送廖子谟 其一","author":"杨士奇","text":"河间佐郡屡经秋，几度怀人增别愁。\n报政重来又分手，白云红树思悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe529429