[{"title":"岁暮五首 其四","author":"李梦阳","text":"叹往嗟来秪自痴，未衰那即鬓如丝。\n同朝鹓鹭云霄隔，故国松楸道路疑。\n园草唤愁偏勃勃，槛梅偷腊故垂垂。\n端居寂寞无双蒂，强食栖迟有一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55732,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岁暮五首 其五","author":"李梦阳","text":"岁当癸酉庐山曲，冬尽扁舟记独栖。\n湖海合冰龙尽立，溪林压雪虎时啼。\n阴阳晴晦双过鸟，南北行藏一杖藜。\n今日中原对河岳，暮云回首楚江西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55733,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春暮丁丑年作","author":"李梦阳","text":"岁岁花时出醉归，伤心今日复芳菲。\n善开朱杏非双蒂，懒转黄鹂只自飞。\n海内诗朋官罢减，城中酒伴病来稀。\n庭枝烂熳催春暮，日午风香独倚扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55734,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜风堂前冬青架仆折其二干晓雪骤至","author":"李梦阳","text":"冬青手植年真久，冷日寒姿颇映堂。\n追悔木阑晴未补，忍教风干夜俱伤。\n乱阶朱实离离静，仆雪青条茜茜长。\n翘首高云忆松柏，后凋溪壑转苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55735,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"戊寅早春上方寺","author":"李梦阳","text":"地阔城空春自幽，青松黑塔云常浮。\n入门铃磬忽一发，暇日台池聊共游。\n连钱汨来谁氏骑，白玉竞浴何年鸥。\n醉笔要知吾漫兴，明朝休用碧纱留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55736,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题戏效李义山体","author":"李梦阳","text":"曾倚清酣奏綵毫，象床冰簟王楼高。\n徐娘老去风情在，班女愁来赋兴豪。\n秦柳日斜伤渭曲，楚兰春暮怨湘皋。\n仙根寂寞昆崙远，浪说人间有碧桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55737,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"莳植甫毕风雪遽至漫尔有作","author":"李梦阳","text":"草树新培置药阑，醉吟閒凭足心宽。\n岂虞晨雪娟娟布，无那春枝飐飐寒。\n犹有一花当坐媚，幸留双柏与人看。\n日晴红绿应全胜，为劝先生且放餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55738,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"为园","author":"李梦阳","text":"平生走马呼鹰地，白首为园学种瓜。\n碧草故要安石屐，青天常满邵雍车。\n围阑换土心真苦，绕菊依松径不斜。\n昨遇日晴閒自步，别蹊桃李又风花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55739,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚秋明远宴集","author":"李梦阳","text":"斜日层城合暮烟，新晴高阁敞秋筵。\n衣冠四海追游地，霜露中原感慨年。\n去鸟来鸿凭槛外，飞云落木把杯前。\n回身忽在星辰上，醉眼直疑到九天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55740,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新年作次喻监察韵","author":"李梦阳","text":"新年雨雪亦大恁，十日中无一日晴。\n岂应雷电除夜作，复尔天鼓东南鸣。\n诸军幸捣莲池穴，大将宜坚缅柳营。\n几欲临风抚长剑，白头还自笑书生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55741,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"甲申元日试笔柬友","author":"李梦阳","text":"人生五十惊衰丑，五十从今又数三。\n老漫更何防市虎，少狂曾亦滥朝骖。\n鹓鸾旧侣俱鸣佩，鹿豕深山自结庵。\n短发不须忧重白，吾居元傍菊花潭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55742,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日诣东庄遇水则舟之同黄子符李二生","author":"李梦阳","text":"出门万水吟风叶，挈友重阳上野舟。\n数月雨阴今白日，一身天地此清秋。\n逐时庄菊花初放，应节村杯酒暂酬。\n晚暮更催双棹返，汴州谁信有沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55743,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"正月大雨雪遣怀","author":"李梦阳","text":"梁园春初云不开，雪花压城滚滚来。\n似有驱龙朝玉阙，岂无骑鹤下瑶台。\n光牵五色黄烟动，势拥三河白浪回。\n欲向琼楼问寒暖，袁安久巳卧蒿莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55744,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陶君誇其分司桃花独树予往观之次其韵","author":"李梦阳","text":"老懒今来特为花，花奇亲见主人誇。\n入门风片时时坠，近酒春枝故故斜。\n湖海一尊怜旧侣，乾坤双鬓愧年华。\n明朝许赴柴门约，共醉东园万树霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55745,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和君席上海棠赏之二首 其一","author":"李梦阳","text":"老兴看花不厌频，折红攀绿总怡神。\n孤枝解动双樽影，数朵能回四座春。\n谁遣物华成岁色，自多人世有閒身。\n年来断酒因脾湿，为尔还应暂入唇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55746,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和君席上海棠赏之二首 其二","author":"李梦阳","text":"瓶中海棠亦太剧，细小翠拥胭脂深。\n秾姿故薰欲醉眼，芳信暗传尝苦心。\n偶逢一枝已自惜，若临全树更须吟。\n花时不道天无意，一日常横半日阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55747,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"庄上看花归见庭中海棠落英与客同赋","author":"李梦阳","text":"三日野花风打稀，朝游酒伴暮醒归。\n临门夭桃不汝惜，当院海棠胡自飞。\n巳怜锦绣半铺地，更讶芳香时点衣。\n便应与君酌明月，醉眼天地生光辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55748,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日过黄公新堂","author":"李梦阳","text":"黄家新堂逼春起，紫燕寻巢时自来。\n久阴烟云眼底豁，乍晴河岳窗中开。\n物情野色且幽寂，日光人意能徘徊。\n持杯布席就芳草，醉深同卧林边苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55749,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日","author":"李梦阳","text":"稍喜夏来天日晴，遽看诸物尽生成。\n累累杏实攒高蚁，赤赤榴花坐小莺。\n昼夜寒暄犹混杂，乾坤清浊固分明。\n留宾酒茗吾能供，春笋满林今更生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55750,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陶公过曹濮分司见丛菊蔓草中移之自随有诗伤之岂以为家物邪予览而和之","author":"李梦阳","text":"野馆寒芳抱自知，好吟公子发秋悲。\n春风世路元桃李，霜露乡关有鬓丝。\n三嗅草莱行复立，数株车马载还随。\n东篱可谓君家物，竹帛勋名晚节垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55751,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"正月四日始出赴黄子之宴南邻何仪宾以美醪助杯即席口占","author":"李梦阳","text":"杜门常日追游少，新岁初筵独诣君。\n幸有邻家能过酒，况多宾客善论文。\n楼台霁日斜含雪，竹树和烟暮阁云。\n入夜不归双烛秉，近尊犹喜落梅芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55752,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陶王二君来赏牡丹","author":"李梦阳","text":"同城何苦不同欢，况复春风到牡丹。\n香满正宜携酒问，色深番奈近灯看。\n綵云红雾晴长拥，澹月微霜夜故寒。\n任使群芳妒倾国，古今须让百花冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55753,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬日学司偶见庭菊","author":"李梦阳","text":"冻雨晴霜尔自开，偶逢私恨过秋来。\n违时只为含中色，入药终须显上才。\n巳许数花卷袖采，能分一本向篱裁。\n冬巡若忆重看约，莫使文轺触雪回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55754,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日东庄宴集","author":"李梦阳","text":"郊园秋晚只风林，冠盖群游是盍簪。\n枫叶近尊朝映日，菊丛淹坐暮横阴。\n烟霞故引旌旗色，鸟雀应疑箫笛吟。\n月底金鞍散归马，野云回首少微深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55755,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"二月望留云阁两集","author":"李梦阳","text":"今年花朝花烂开，春风细雨临高台。\n绕阑红湿舞英重，隔窗黄闪流莺回。\n连日霢霂地巳足，薄暮风云天更来。\n眼看万物歘生色，尔我胡惜黄金杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55756,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"海棠烂然要诸君子赏之分韵得壶字二首 其一","author":"李梦阳","text":"绕树巡檐兴恨孤，缛红繁绿似渠无。\n童知小径晨先扫，客有高轩夜特呼。\n巳拚落英欺舞袖，更堪歌鸟劝提壶。\n幸能老去花常健，遮莫尊前醉共扶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55757,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"海棠烂然要诸君子赏之分韵得壶字二首 其二","author":"李梦阳","text":"春深花树烂模糊，花下朋游酒一壶。\n帽侧故搴轻朵插，席安仍取积英铺。\n日烘扰扰蜂能趁，烟动关关鸟更呼。\n客散独烧高烛照，老来真自笑狂夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55758,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中海棠","author":"李梦阳","text":"怜花常欲报花安，醉眼冥冥两自看。\n朵朵胭脂深更湿，杯杯竹叶满须乾。\n等閒细片休轻落，率尔春风且恁寒。\n朝为行云暮仍雨，凌波独立汝应难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55759,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"艮岳","author":"李梦阳","text":"宋家行殿此山头，千载来人水一丘。\n到眼黄蒿元玉砌，伤心锦缆有渔舟。\n金缯社稷和戎日，花石君臣弃国秋。\n漫倚南云望南土，古今龙战是中州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55760,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"潼关","author":"李梦阳","text":"咸东天险设重关，闪日旌旗虎豹閒。\n隘地黄河吞渭水，焱天白雪压秦山。\n旧京想像千官入，馀恨逡巡六国还。\n满眼非无弃繻者，寄言军吏莫嗔颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55761,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题云台观","author":"李梦阳","text":"云台观枕玉泉湄，翠削三峰对不移。\n窗里山光时隐见，晚来云气壁淋漓。\n醮辰绛节朝群帝，天路金童引凤螭。\n头白扫门怜弟子，斸松石碍白苓滋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55762,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"榆林城","author":"李梦阳","text":"旌干袅袅动城隅，十万连营秪为胡。\n不见坐销青海箭，尽言能挽绣蝥弧。\n白金兽锦非难锡，铁券貂珰莫浪图。\n昨夜照天传炮火，过河新驻五单于。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55763,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出塞","author":"李梦阳","text":"黄河白草莽萧萧，青海银州杀气遥。\n关塞岂无秦日月，将军独数汉嫖姚。\n往来饮马时寻窟，弓箭行人日在腰。\n晨发灵州更西望，贺兰千嶂果云霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55764,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武昌","author":"李梦阳","text":"武昌城北大江流，沱水夹城鹦鹉洲。\n楚蜀帆樯风欲趁，蛟龙涛浪暮堪愁。\n青烟自没汉阳郭，新月故悬黄鹤楼。\n无限往来伤赤壁，三分轻重本荆州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55765,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江行","author":"李梦阳","text":"江行日日随风雨，日日迎风帆不悬。\n颇怪蛟龙欢出没，更兼鸥鹭剧连翩。\n窗开淅淅琴书湿，岸转冥冥竹缆牵。\n回合万山心目破，撇漩谁忍向湖烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55766,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泛湖","author":"李梦阳","text":"匡庐彭蠡曲相连，伐鼓蛮歌趁进船。\n屏见云横石壁净，镜开日破浪花圆。\n渔樵山泽堪时给，盗贼于戈枉自缠。\n遣帅巳添新节制，指挥符见扫风烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55767,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南溪秋泛三首 其一","author":"李梦阳","text":"闻说南溪径尺鱼，渔人何事网常虚。\n鱼行碧苇深先见，网入寒潭迥不舒。\n东舍刈禾摇夕浦，西邻决水溜秋渠。\n平生肉食忧空切，此日临渊意有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55768,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南溪秋泛三首 其二","author":"李梦阳","text":"乍见鸬鹚立钓矶，还惊翡翠掠波飞。\n汀葭挽宿濛濛雾，野竹晴含宛宛晖。\n谢传未忘舟楫兴，楚臣空恋芰荷衣。\n苍茫水落云泥静，怅望林翁却自归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55769,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南溪秋泛三首 其三","author":"李梦阳","text":"却向林亭观水硙，暂移沙舸蹑云堆。\n奔湍迅毂元相激，石窦桐标故不摧。\n旋影动摇波底日，断声吹转地中雷。\n何人解识机心事，后世徒矜造化才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55770,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游西山归呈熊卓","author":"李梦阳","text":"高阁开襟生远兴，西山当眼更分明。\n酒边花树三春暗，湖上风林尽日清。\n忆昨并穿岩洞入，只今疑绕薜萝行。\n浮生扰扰非吾意，去鸟悠悠空世情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55771,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出辉县城望石门山其上有仙潭玉鲤","author":"李梦阳","text":"明星欲落开县城，千峰万峰初雪晴。\n源泉乱石涓涓溢，削壁孤云袅袅生。\n估客深穿猛虎窟，樵夫习傍翠岩行。\n仙门屹立三潭水，玉鲤空悬一线情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55772,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"盘山道中作","author":"李梦阳","text":"涧道晴云雪草春，石门丹壁斗嶙峋。\n闻雷不羡蛟龙起，避地番将虎豹邻。\n少室山人虚索价，壶关三老实藏珍。\n烟花白日经行处，鸿雁冥冥叹此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55773,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游上方寺晚登钟楼","author":"李梦阳","text":"东北丛林冠此都，地分清寂聚僧徒。\n青天宝塔还今古，赤日珠光乍有无。\n草径鹭乾时独立，松林鹤并晚相呼。\n登楼更见河流急，叹世因悲马负图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55774,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"王孟寺北望","author":"李梦阳","text":"暑路尘沙淹客心，晚原台榭慰登临。\n西山日抱重檐落，汝水云移尽栋阴。\n盗贼两河犹转战，朝廷万载莫轻侵。\n怀芹欲献江湖远，北望徒伤北极深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55775,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"贤隐寺","author":"李梦阳","text":"谷寺鸣钟午未深，耽幽特与伴相寻。\n行穿树杪楼台见，坐傍山腰紫翠沉。\n独响涧泉传石窦，并飞梁燕入松阴。\n徘徊自笑三江客，伫望谁知万里心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55776,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"开元寺","author":"李梦阳","text":"读书台倚鹤鸣峰，回合千山翠万重。\n白昼悬泉喧霹雳，清秋双剑削芙蓉。\n撑持古寺还云阁，寂寞前朝自暮钟。\n瑶草石坛应不死，兴来真欲跨飞龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55777,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"瀑壑晚坐","author":"李梦阳","text":"醉踏匡山晚未迟，翠岩丹壑凛秋姿。\n峰高瀑布天齐落，峡静星河夜倒垂。\n远害欲寻麋鹿伴，暂羁终与世人辞。\n磨崖遍剔苍苔读，独坐云松有所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55778,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五面石","author":"李梦阳","text":"东华山北五面石，削成五面何嶙峋。\n崩崖鼠餐何代雪，阴洞苔滋千古春。\n映日闪闪上云气，步天渺渺升仙真。\n草衣木食亦吾志，放浪胡为羁此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55779,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东华山赠友","author":"李梦阳","text":"午时叱驭踰重险，薄暮扪萝到绝巅。\n四海风烟落日外，万山闽越酒杯前。\n剧伤岭谷旌旗满，暗忆家园道路偏。\n自古有人同戮力，吾曹须拟太平年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55780,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"龟峰寺","author":"李梦阳","text":"弋阳县南山下寺，三十二峰罗列奇。\n最爱紫烟生石鼎，绝怜青嶂削灵芝。\n哨崖哀壑还人世，古往今来自鬓丝。\n巳遣野场维玉骑，合留岩月照金卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55781,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"别龟峰","author":"李梦阳","text":"江上龟峰天下稀，挈朋贪赏夜忘归。\n冠常他日思丹壑，车马平明发翠微。\n归路竹萝偏拂幰，出山云气故随衣。\n杳然一笑怜踪迹，自不投簪愿孰违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55782,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铅山石井","author":"李梦阳","text":"吁嗟此岩太奇古，云牙石乳相拄撑。\n碧泉中洞尽亦黯，青草倒垂冬尚生。\n即令入海信谁遏，秪怪出山云底清。\n搣促桑拓会欲落，猗此可濯惭我缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55783,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铅山陆趋宿南岩寺","author":"李梦阳","text":"北风越南山木稀，关西宦子常念归。\n远烟漠漠谷日瞑，前路回回冬烧微。\n村舂水旋疾徐应，滩雁夜惊高下飞。\n钟鸣骑合岩寺近，松火竹深开石扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55784,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"自新喻马赴新鋈方等寺晚饭","author":"李梦阳","text":"趋途暝雨巳忽霁，入寺晚饭鸟将栖。\n仲夏稻苗特袅袅，黄昏松桂何凄凄。\n流年远村换物色，旷野青天悲鼓鼙。\n峨峨百丈屹在眼，策马欲攀交虎蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55785,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"快阁登眺","author":"李梦阳","text":"江上冥冥风浪生，阁中清眺会儒英。\n野舟冒险只自度，汀鸟避人时一鸣。\n四海登临吾白发，万山回合此孤城。\n剧谈转切忧时念，日暮浮云况北征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55786,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"麻姑山","author":"李梦阳","text":"冒险探深云雾收，麻姑山水冠南州。\n潭深自激风雷黑，谷迥谁群鹿豕游。\n仙女石坛残欲没，鲁公碑版断仍留。\n可怜踪迹俱尘土，两瀑云霄万古流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55787,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题玄坛观","author":"李梦阳","text":"江行昼静便清暑，水口山奇锁吉安。\n岂为天生饶怪石，遂令人拟筑玄坛。\n潭涡地转常年黑，楼阁崖悬五月寒。\n风牖把杯聊暂倚，海蒸云起故须看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55788,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"将至安仁","author":"李梦阳","text":"安仁古岸叉河滨，细柳浓烟密弄春。\n花发北山翻盗贼，眼昏南国且风尘。\n盘涡浴鹭缘谁喜，下濑双帆他自亲。\n破浪会看风万里，采薇应许毕闲身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55789,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"看庐岳","author":"李梦阳","text":"春时看岳落星洲，夏来看岳复江州。\n独行稔负烟霞伴，久住非贪麋鹿游。\n石室丹书吾异世，锦屏双剑晚遮楼。\n登寻拟纵凉天目，一叶飘飘江汉流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55790,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"楚望望襄中形势","author":"李梦阳","text":"楚望峰头望楚云，遥怜紫盖紫阳君。\n庐荒不断盘龙气，碑灭犹存堕泪文。\n地转江淮浮远戍，水同巴峡堑雄军。\n里名冠盖非吾事，愿访鹿门麋鹿群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55791,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"繁台雨望和田生","author":"李梦阳","text":"感事逢时恨不稀，水城寒食半花飞。\n青郊白马朝谁并，细雨轻帆晚自归。\n何计上宾留凤驭，无书北狩挽龙旂。\n层台独上休翘百，牢落江州易湿衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55792,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"大梁城东南角楼","author":"李梦阳","text":"城楼占角分孤峻，野色生烟合杳冥。\n华夏亦为元社稷，古丘曾是宋朝廷。\n直看紫极云霾壮，昔触黄河风浪腥。\n日暮冯轩益愁思，夷门今有少微星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55793,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚过禹庙之台","author":"李梦阳","text":"暮行群过禹王宫，瑟飒松林静入风。\n步竞石梯秋独健，眼收沙海月还空。\n声名北上青骢客，潦倒中原白发翁。\n杯酒重伤分手地，古今踪迹本飞鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55794,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]