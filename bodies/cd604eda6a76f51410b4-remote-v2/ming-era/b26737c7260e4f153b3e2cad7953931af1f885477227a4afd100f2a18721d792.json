[{"title":"何园夏夜呈朱叔烈","author":"释今沼","text":"雨沥风飔池上亭，行人暮暮见鵁鶄。\n篱穿嫩槿侵枝绿，架引浮瓠接蔓青。\n乡路渐迂违小雀，道心犹昧愧流萤。\n高轩閒砌逢秋洁，谁对流霜话晓屏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48260,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旅馆与邻人麦朴生夜话","author":"释今沼","text":"故里已应无第宅，异乡今始见邻人。\n疏篱浊酒惊初定，高阁明灯话重陈。\n阶下暗虫愁往事，枕边黄叶梦归身。\n乱离旧业知谁在，共道飘零泪满巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48261,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醴泉帖故人谢溶所遗每一展观辄为怆然","author":"释今沼","text":"故人遗帖留残匣，几度临书似旧时。\n懒拙已忘王卫法，凄凉徒有范张悲。\n墨痕尚忆师秦漏，石拓犹闻辨宋螭。\n今日清斋想奇字，玉楼天上勒新碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48262,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何兵曹拜命赴端州行在","author":"释今沼","text":"新加露冕拜纶丝，远水寒山木落时。\n天子刻期传诏诰，三军指日罢旌旗。\n思乡欲上高崧路，望阙先扳古桂枝。\n别后若逢佳节近，数丛黄菊拟东篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48263,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题","author":"释今沼","text":"越国相思楚水涯，江蓠如箭柳如丝。\n云迷巫峡神娥去，水绿湘潭帝子悲。\n汉苑兰生人已寂，洞庭木落雁先知。\n佩蘅谁向芳洲远，寥落灵均一帙辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48264,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春楼","author":"释今沼","text":"绿屏春晓露珠稀，地尽南天草木葳。\n石角柳芽风不到，小窗梅绽雨初微。\n身随玉液寻仙侣，手捻沉香事小妃。\n碧草远郊人寂处，开帘唯见燕双归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48265,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春尽","author":"释今沼","text":"故园绿满春将尽，野路初晴雀正飞。\n细草落花残雨湿，小荷抽叶午风微。\n山深夏木鹃啼急，巷寂红榴日照晖。\n愿及芳时须一醉，独携尊酒送春归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48266,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花","author":"释今沼","text":"东风恻恻雨凄凄，飘断残英蝶欲迷。\n无数踏归青草路，有时浮出武陵溪。\n深宫尽日同人泪，荒苑无声伴鸟啼。\n闻道洛城春日好，明朝期发杏园西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48267,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠江村马巡司","author":"释今沼","text":"越国才名旧有华，身为微吏滞天涯。\n重门石壁春流水，独树寒江晚闭衙。\n金马几年烦献策，棘林何处更开花。\n岭云潭月深相忆，农伴欢锄今万家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48268,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王邑宰佐宣城郡","author":"释今沼","text":"紫泥初拜谏书清，善政弦歌在武城。\n五马近依新雨露，三年从拂旧尘缨。\n南来崇岭千峰出，北望衡阳数雁征。\n此去裁诗秋正好，谢公楼上月初明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48269,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登阅江楼","author":"释今沼","text":"古台摇落对长洲，极浦寒山返映楼。\n官渡乱鸦乔树晚，夕阳黄叶海天秋。\n层峦逼立峰皆见，石塔遥临影尽流。\n宾客莫辞连夜饮，前途还有木兰舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48270,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿黄氏园亭","author":"释今沼","text":"轻舟欲泊日黄昏，愁绝青袍有泪痕。\n林壑未忘同逸兴，水云犹自绕孤村。\n涂当海国易流滞，人在天涯空梦魂。\n春草闭门花欲发，卧看蝴蝶到西园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48271,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日山中","author":"释今沼","text":"青门杨柳渐稀疏，醉倚江楼月上初。\n南浦秋残多坠露，衡阳雁尽不飞书。\n千家寂静砧逾切，四壁萧条贫自如。\n谁念山中松桂满，探玄空负子云居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48272,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再过白衣寺元约上人山房","author":"释今沼","text":"重访支公叩上方，数栏花木闭禅房。\n旧栽松菊侵山径，新种梧桐近井床。\n僧定蝉声连静室，鹤归松色带斜阳。\n浮生但觉身无住，唯看青山忆故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48273,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日晚郊咏归","author":"释今沼","text":"枫叶纷纷落径繁，游人望望下郊原。\n归云挟杖过山涧，落日题诗倚竹园。\n孤鹭远翻秋浦静，乱鸦频聚夕阳喧。\n夷犹月上蓬蒿处，长笛一声城外村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48274,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山影","author":"释今沼","text":"碧峰巉崒影沉沉，尽日晴轩得半阴。\n仄劈嶙峋图屋角，寂衔空翠落波心。\n似因临写窥高下，欲仰仪型想静深。\n遥忆香炉脚边寺，一峦残照倚风吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48275,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"城影","author":"释今沼","text":"遥阴兀兀在城濠，一带因山影愈高。\n倒照宿乌连埤堄，趁凉归卒绕周遭。\n昼承古木临偏巷，夕转荒郊落野蒿。\n漠北塞垣孤障在，云黄沙白更萧骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48276,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠莫先生","author":"释今沼","text":"乱离多籍老儒冠，一宦曾经海岛寒。\n对案斋心犹苜蓿，逢人变色是波澜。\n诗篇遣兴多容易，世路无心不觉难。\n近爱禅门好消落，拟将心境问求安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48277,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠郭亦知参军","author":"释今沼","text":"盛朝身属邮亭长，越岭燕台走马闻。\n壁满题诗当路客，堂多勒铭教儿文。\n重辎几散黄巾栅，深巷閒拖白练裙。\n昨约林僧扫园径，半庭残叶落纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48278,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏赠黄塾师","author":"释今沼","text":"问年惟数六身知，貌欲龙钟学守雌。\n石磴结垆供酒馔，书堂击鼓集童儿。\n汲舂妇没无相谪，社腊孙强每后随。\n当日里闾喧笑处，醉归多唱步虚辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48279,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠刘菭石宪副归荆南","author":"释今沼","text":"十年旅宦梦潜溪，乱后归帆路不迷。\n鸲鹆砚携端水署，橘橙家到洞庭西。\n栽菱渡口来渔父，酿秫厨边卧鹿麛。\n谁候太常斋满日，叩门壶榼手亲携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48280,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽台设师","author":"释今沼","text":"尚忆溪桥遇我师，自挑衣履到山时。\n久谙细行劳皆喜，远赴檀那病不辞。\n寒骨似霜流辈服，夜坛无食野魂悲。\n供亲捆屦终难待，几日春条为倒吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48281,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中怀旧游","author":"释今沼","text":"书剑论交两不成，思君愁剧尉佗城。\n人逢故里空分手，梦绕寒林恍隔生。\n逝者苦多存者少，中年堪念少年情。\n时来赖有忘怀处，月共川潮夜夜平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48282,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日村郊","author":"释今沼","text":"刺桐鲜映绿槐芽，春水初平海堰沙。\n江燕掠泥寻旧垒，山樱成子落馀花。\n雨残时见桑梯倚，林外遥逢酒旆斜。\n最爱村原寒食候，杂香晴径野人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48283,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"何石人仿王叔明笔作画赠余入匡山竟不果行题此","author":"释今沼","text":"住山烦为写山容，半幅阴晴壑万重。\n风过泉声来绝壁，云疏鹤影落高松。\n清斋似对西林客，落日疑听北岭钟。\n何事乡园留滞久，石桥边畔草茸茸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48284,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬黎务光养疴海云寺以余营亡友李仲藏丧还见示之作","author":"释今沼","text":"清羸得静在云林，药碗绳床近树阴。\n恳向医王频接足，寂依禅子与栖心。\n疏篱槿吐伤荣促，曲岸波回感逝深。\n几日浮生同怆恨，独吟君句夕阳沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48285,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雷峰山寮寄徐四同","author":"释今沼","text":"自住上方聊寄迹，山窗长在竹竿边。\n昨来是处秋风好，忆尔生时明月圆。\n捧橘定知怀袖阔，食梨应喜弟昆连。\n偶拈茗碗生閒思，却记前年共酒筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48286,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏井","author":"释今沼","text":"惜此井泉长不改，寒光迥出碧梧疏。\n苔床蛙鲋资清渗，石甃朝昏上气虚。\n湕渫漫随孙楚赋，清滢空冷傅咸居。\n年来频梦城东宅，贫巷萧条自晏如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48287,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送足两师之嘉禾请藏却还庐山栖贤寺","author":"释今沼","text":"癯然鹤骨若为支，又向秋风话远离。\n遥请梵书来藏阁，便从匡岳卧茅茨。\n吴讴越榜添吟韵，瀑雨松涛助寂思。\n梦里溪山成独送，暮天愁拟碧云期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48288,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠蜀中喻胜力居士","author":"释今沼","text":"颊边耸带蜀中山，鬓脚言从乱后斑。\n未到汉原悲旧国，才离海岛似生还。\n一篙绿水寻僧远，半榻疏钟到梦閒。\n莫厌虚房强留住，半生曾几住人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48289,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮冲虚观","author":"释今沼","text":"仙宫长掩烟霞里，绝磴才攀屦欲轻。\n龙虎气藏山殿冷，蝌鱼书瘗石坛倾。\n胎禽日永栖还去，灵药林深死又生。\n犹有成鳞两松树，侧临丹井势峥嵘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48290,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋江萧寺寄谢法航","author":"释今沼","text":"閒操一勺挹沧溟，寺外秋潮没远汀。\n云映蜃楼邻岛市，波深龙室傍函经。\n鹤归树碧摇烟月，鱼怕灯明误水星。\n谢客此时閒蜡屐，可堪思诗满东亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48291,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送人归闽中","author":"释今沼","text":"闽山粤水无多异，为积羁愁始欲归。\n离绪暗滋伤逝恶，客心长计浪游非。\n从经海岛诗偏怪，欲别林僧话转稀。\n世故为儒谁可奈，苍苍苦觅旧渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48292,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄顿公","author":"释今沼","text":"雁带馀声入海烟，霜林空末望高天。\n愁团半是送行日，閒咏偏多寄远篇。\n枕畔湖山风叶搅，书边意况雪花溅。\n春来纵有莺尖惠，不得桥边招隐泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48293,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张尧山归杭州","author":"释今沼","text":"往岁言归计未成，今秋始得挈家行。\n张衡久有归田愿，王粲知无恋客情。\n去日海帆同燕渺，到时江岸与潮平。\n湖边若果添三径，莫吝双鱼寄远声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48294,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋朝山寮柬黎务光","author":"释今沼","text":"山寮村馆共秋朝，数里疏林叶似烧。\n架积遗书从许借，吟同小隐不须招。\n蓼红野艇回孤棹，霜白行人过板桥。\n欲拉支公寻寂寞，恐埋踪迹入渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48295,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重过徐四同宅","author":"释今沼","text":"宅舍重过又一时，对君诸弟黯然悲。\n论交既是中年分，学道空多后日期。\n风闪疏灯回旧榻，月移寒橘落秋池。\n直倾一夕无穷泪，不待邻家短笛吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48296,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送石鉴大师住栖贤","author":"释今沼","text":"本师畴昔幽栖地，杖拂亲承出庾关。\n侧听道声喧法窟，共推骨相称奇山。\n钁头有法提应俊，茅屋随时结岂难。\n千七百人看满会，肯令庸质老南蛮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48297,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出家日自嘲 其一","author":"释今沼","text":"蹉跎到此竟何为，才撇尘缘万事宜。\n已觉形容除俗态，任教颠倒落僧祇。\n眼昏且喜经文大，鬓秃如藏腊序卑。\n四十披缁谁谓老，只应精猛事吾师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48298,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出家日自嘲 其二","author":"释今沼","text":"故交屈指复谁存，似我馀灰尚足论。\n于世已惭微友道，入山偏觉谬师恩。\n时擎粥钵烟村外，閒放棕团水石根。\n从此名山高顶上，一凭筋力恣孤鶱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48299,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏效杜体","author":"释今沼","text":"陶公茅斋垂柳长，卧疾已过园林芳。\n水浅渐忘越舟楫，山深每有秦衣裳。\n洒桑野老开蚕屋，薰树儿童换蜜房。\n巡食沙渠一白鹭，忽冲烟雨过横塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48300,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"千佛道场即事","author":"释今沼","text":"锦角幡旌喷沫烟，栴林龙象率陀仙。\n观成万象金光涌，礼遍千名梵响圆。\n花树齐发催百鸟，香渠分供出诸天。\n萧郎夙慧多生事，眼见池开上品莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48301,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送人归宿五羊驿因忆匡山感而成梦","author":"释今沼","text":"海门送别帆樯去，瓶笠閒投邸阁开。\n客半羊肠关路至，货多蚌腹海滨来。\n心悬河岳前期远，影落河山梦断回。\n却似津梁疲马道，霜桥残月晓鸡催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48302,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠前宪副汤惕庵","author":"释今沼","text":"箨冠麻服混埃尘，座上犹钦峤岳身。\n千里海津逢故吏，一肩行橐倩邻人。\n殊方案牍谁相问，旧国瓜园且自贫。\n庐顶蒿茆吾欲剪，浔阳踪迹可能频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48303,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访甘竹黄符升村居","author":"释今沼","text":"一笠随舟涨易乘，故人门巷隔崚嶒。\n仍缘旧刺通身姓，乍出疏篱讶远僧。\n斋后折蔬劳静浣，窗前积翠引频登。\n惯同文字摅幽抱，谁论诗情涩未能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48304,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄某邀同过公子黄符让却赠","author":"释今沼","text":"蕙英本出崇兰干，鹓翼原留老凤纹。\n独上危楼欣胜日，深垂绡幕较奇文。\n雨过桧柽烟全碧，花落池塘水半芬。\n十里沧波南北阮，乍凭诸从一寻君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48305,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南海神祠","author":"释今沼","text":"百川亦汇归南海，望秩灵祠自历朝。\n石镌凤书苔藓驳，像垂龙衮水云飘。\n波鸣海市晴输税，雾捲鲛宫夜贡绡。\n日暮商飙动林木，鼓声催起海门潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48306,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"达奚司空像","author":"释今沼","text":"树老庭荒不记春，天朝裳服俨遗身。\n空悲乡国生翰鸟，似立朝门待舌人。\n灯火青荧通晦夜，廊龛寂历罥丝尘。\n从今断却当年恨，海舶无因过此津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48307,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"碧鉴溪泛舟","author":"释今沼","text":"带郭人家野霭间，一溪深棹不知还。\n云晴近海低成雨，水色连莎淡到山。\n好影入诗愁不尽，欢心着事累终閒。\n他年若别高峰去，定向渔翁占一湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48308,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阿大师应请琼州书到却寄","author":"释今沼","text":"槐竹阴阴已夏居，客来喜得海南书。\n藤蘧白满安禅榻，椰叶青疏挂锡庐。\n击水时闻轩翼鸟，怪松新识竖须鱼。\n从师欲问寒暄意，塞北厓南话一如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48309,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"塔影","author":"释今沼","text":"槛户淩虚影倍长，羲和高臬候青阳。\n涵灯未透琉璃影，浮水初韬舍利光。\n风到草间吹欲转，日中沙界迹偏藏。\n焰埃幻灭劳相问，惟向清阴礼法王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48310,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿华首阁","author":"释今沼","text":"石路回斜树影重，月临高阁罢昏钟。\n山衔古寺秋初半，叶满虚廊露正浓。\n南岭宿云笼翠草，东溪瀑水映疏松。\n睡醒却悟身何处，四百峰中此一峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48311,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客舍梦故山寄无师","author":"释今沼","text":"渐逼秋风客思催，梦魂犹忆在香台。\n山头野鹤归松处，门外江潮带雨来。\n地竹丛枝滋暗笋，龛灯微燄到明灰。\n山中长老频相念，误觑閒窗日几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48312,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋蝉 其一","author":"释今摄","text":"为爱清秋白露时，满腔积绪向谁披。\n乍依红叶任舒卷，长噪碧云远险夷。\n残月晓风偏入梦，登山临水倍堪思。\n不须切切频相告，自有知音过子期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48313,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋蝉 其二","author":"释今摄","text":"绝尘高蹈一身轻，浊世徒劳怨独清。\n长挹金风资冷韵，只茹珠露谢贪名。\n晓飞自爱云山胜，晚噪如闻天籁声。\n不似芳时莺语巧，三秋常有雪霜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48314,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋月","author":"释今摄","text":"一轮高挂五峰前，云散长空正可怜。\n自与金河同混派，不教玉殿重含烟。\n孤踪掩映澄潭底，疏影朦胧瘦竹边。\n寄语烟波垂钓叟，芦花堪系月明船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48315,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陆亦樵上白崖","author":"释今摄","text":"步入东南翠霭重，白崖深处雾烟封。\n金鹅咫尺通三叠，玉练千寻并五峰。\n学易欲随才子后，读书偏傍谪仙踪。\n他年副墨藏名壑，百变风云共淡浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48316,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访亦庵中千上人","author":"释今覞","text":"维舟西昌城，秋色净闾闬。\n去城未里馀，一阁摇霄汉。\n悠然水竹居，清况亦云罕。\n阁中虚且閒，回转恣登览。\n低揖紫袍峰，前趋若下坂。\n俯影入横塘，浮光上朱槛。\n复道迂小楼，夹花明幽栈。\n危桥柏径深，曲渚秋云绽。\n苍茫不可穷，瞩空真如幻。\n中公此坐卧，亦既适以衎。\n相逢更扬眉，放怀共疏散。\n长啸夜月孤，策杖江天晚。\n应嗟华亭翁，覆船未成懒。\n三峡余隐沦，亦自笑担板。\n且勿复多言，饥索香厨饭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48317,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠谢振万","author":"释今覞","text":"土室白云封，寻僧一短筇。\n高怀寒浦月，清论夜堂钟。\n世事已如此，浮生未易逢。\n匡庐飞瀑处，还有六朝松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48318,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"栖贤除夕","author":"释今覞","text":"雪净高楼迥，灯明梵宇空。\n山中犹记腊，世外亦成翁。\n自惜壮心暮，徒嗟吾道穷。\n敢云丘壑卧，足绍古人风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48319,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仁化江口寄丹霞澹公","author":"释今覞","text":"高住丹霞去，名山自昔传。\n江边开洞壑，天半见林泉。\n竹坞清霄梦，梅花石屋禅。\n我来尚行役，空自望云烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48320,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄别何石人","author":"释今覞","text":"十年离乱昔同忧，此日成僧忆旧游。\n每值好秋怜独坐，何人明月共登楼。\n旧村到处空青草，故老只今谁白头。\n閒寺相期不相过，鄱阳余又棹孤舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48321,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]