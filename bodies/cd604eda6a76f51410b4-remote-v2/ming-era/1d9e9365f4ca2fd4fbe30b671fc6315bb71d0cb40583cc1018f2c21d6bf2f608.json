[{"title":"访黄公绍隐居","author":"区大相","text":"久抛簪绂谢人群，独闭藤萝注古文。\n桂发秋山多偃蹇，兰生春谷本清芬。\n双童竹下扶迎客，短榻花间卧看云。\n近日称诗遍城市，风流终愧不如君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22631,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"制府陈公设斋食招集崧台时以忧旱故","author":"区大相","text":"小队临江昼不喧，高台烟树接辕门。\n杯行碧玉斟明水，馔出香厨供净根。\n风月几人陪坐啸，关山万里属櫜鞬。\n楼船下濑非今日，何事南征曲尚存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22632,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登天池山","author":"区大相","text":"层层石路上无涯，㶁㶁流泉听转赊。\n万仞壁间藏古刹，千岩云际吐奇花。\n望穷天汉人难住，行尽烟霞佛有家。\n一点尘心何处著，夜来风雨长灵芽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22633,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒食维舟南浦孔阳王孙酌别","author":"区大相","text":"清时未得言逃禄，冷节何堪赋采蘋。\n高阁朱阑怀帝子，长堤碧草迟佳人。\n莺花南浦舟中酒，冠盖东郊道上尘。\n行乐也知随处好，独怜分手过馀春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22634,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"密县天仙宫白松","author":"区大相","text":"霜根翠叶此何奇，传道轩辕宫里时。\n玉质不缘三女化，瑶台争睹万年枝。\n风飘偃盖鸣环过，露浥流膏带粉滋。\n不独皇英去湘浦，至今斑竹使人思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22635,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观滴水蓬","author":"区大相","text":"玉女宫前小洞天，忽逢灵境兴翛然。\n阴崖乱滴非关雨，碧甃承流若有泉。\n风递清声摇杂佩，涧含春溜泻平田。\n醴泉神瀵何如此，便欲抽毫续水篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22636,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日城西眺望","author":"区大相","text":"季秋风日已凄清，况是羁人骋望情。\n红叶不曾殊海国，黄花只少对山亭。\n京华作赋悲摇落，故里登高忆弟兄。\n何用茱萸今日会，年年酒向客中倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22637,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何公露佥宪之豫章","author":"区大相","text":"豫章东望即东吴，宪节西行人画图。\n部下神仙称悬尉，赋中山水美洪都。\n秋风骑从登庐岳，明月官斋对蠡湖。\n见说南州能下榻，不知谁向府中趋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22638,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送郭希参分守川东开镇夔府","author":"区大相","text":"远上荆门望蜀城，褰帷无复叹长征。\n公孙废苑秋风早，神女荒台暮雨生。\n兰省昼开南客宴，竹枝宵动北人情。\n瞿塘水落漩涡小，倚棹安流万里行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22639,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏和汪公干塞上逢妓","author":"区大相","text":"关前日照红罗襦，马上香生赭汗珠。\n紫塞连朝逢侠少，青楼何夜梦狂夫。\n歌成都护名征虏，学得琵琶不嫁胡。\n若使阏氏见颜色，花间妒杀小单于。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22640,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬至前一日郊坛寓目","author":"区大相","text":"瑶京散雪气微和，玉律来阳景渐多。\n太一降生烟缥缈，上宫行处佩逶迤。\n坛边瑞霭迎仙跸，日下卿云待帝歌。\n借问甘泉陪从客，天门何处翠华过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22641,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬至","author":"区大相","text":"黄钟律转日南至，缇室灰浮阳气潜。\n苑外窥梅才的的，河边觅草未纤纤。\n楼台消雪皆迎暖，云物呈祥不待占。\n闻道南郊恭代毕，定将昭事答威严。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22642,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"少年行赠人从征","author":"区大相","text":"银鞍玉勒锦缠騣，秣赵驰燕似下空。\n犀甲镂金光错落，貂裘拂雪紫蒙茸。\n腰间宝剑明秋水，臂上雕弧应落鸿。\n待与将军全属国，方论年少有英风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22643,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独坐","author":"区大相","text":"独坐寒斋雪里开，遥思山院落残梅。\n花明赤岸鸿犹去，冰结黄河鲤不来。\n但遣清笳吹夜月，难教长袖送春杯。\n侵晨喜鹊檐间散，薄暮栖乌城上回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22644,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四月六日与客游高梁桥","author":"区大相","text":"燕郊四月如春月，景物暄妍宿雨晴。\n仙苑名花裁罥蝶，御堤芳树始流莺。\n平林翠幕褰风飏，落日红妆照水明。\n自幸太平多乐事，共将弦管寄欢情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22645,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四月八日高梁桥即事","author":"区大相","text":"西方降生传此日，北土行乐开群迷。\n艳艳游尘障去岸，纷纷杂伎拥回堤。\n秉兰藉草逢新浴，赠李投桃历旧蹊。\n独有瞿昙心境寂，天花落水不沾泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22646,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋乐词 其一","author":"区大相","text":"云楼奕奕敞朱扉，玉宇重重彻紫微。\n轮满天庭分昼景，桂开仙阙吐圆晖。\n深深罗幌焚香出，队队霓衣侍辇归。\n忽听云中催按笛，怕令乌鹊又惊飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22647,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋乐词 其二","author":"区大相","text":"朣胧玉宇御瑶觞，佳景千秋乐未央。\n自有重轮开玉镜，何须仙曲舞霓裳。\n兔宫久閟长生药，桂殿新薰百和香。\n此夕关山人尽望，愿分馀照及穷荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22648,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和四家兄九日武场观射","author":"区大相","text":"明时讲武重疆场，九月霜清塞草黄。\n跃马抡材争入彀，登坛奏技识穿杨。\n泽宫旧纪周文盛，猛士还思汉道昌。\n闻说登高羡能赋，与君同醉紫萸觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22649,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀西樵","author":"区大相","text":"溪上茅堂昼掩扉，松门咫尺往来稀。\n秋林响处归鸾鹤，春雨生时长蕨薇。\n樵径定穿云里入，泉声应向竹间飞。\n不知空外茶烟起，若个人家住翠微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22650,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"盛夏偕宫赞林公司成胡公过陈任大斋中得湖字","author":"区大相","text":"何为触热客来俱，槐市东头赤日无。\n座上清言皆月露，樽前閒兴尽江湖。\n敲冰凉沁玻璃碗，挂壁云生水石图。\n雍馆风流有如此，将因著论老潜夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22651,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蓟门早秋","author":"区大相","text":"蓟城杨柳早寒知，不待秋来气已悲。\n乡国看为天尽处，塞门愁记雁来时。\n关前汉骑侵晨发，楼上胡笳向暮吹。\n叶落深闺徒下泪，从今征戍几年期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22652,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠黎惟仁先生","author":"区大相","text":"竹径松斋养道机，闻将名姓寄丹扉。\n盈阶兰玉森相茁，绕树鹓雏始学飞。\n红叶晚堆烧药鼎，白云閒补住山衣。\n尊前却笑磻溪叟，犹伴周王射猎归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22653,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得万中丞朝鲜书问却寄","author":"区大相","text":"中丞家住雁门边，破虏功高在少年。\n出塞惯骑胡地马，渡辽还泛汉楼船。\n黄龙戍外书千里，玄兔城头月几圆。\n横海只今誇绝漠，鸡林新勒照燕然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22654,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明日公干过谈郊游","author":"区大相","text":"河堤嫩柳拂游人，为惜韶华插鬓新。\n冠尽五陵朝墓路，郊原一片踏青尘。\n山中榆火过寒食，江上蘋花照莫春。\n不见风光可怜处，年年伴乐客中身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22655,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻宪府李公增修星岩之胜遥有此寄 其一","author":"区大相","text":"岩栖好去沥湖陂，风景年来倍昔时。\n出镇近逢羊叔子，胜游重睹习家池。\n经春桃水迷仙棹，长夏荷筒杂羽卮。\n闻此令人发心赏，羡君霞路拥旌麾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22656,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻宪府李公增修星岩之胜遥有此寄 其二","author":"区大相","text":"石室从来洞壑幽，近传胜事足风流。\n小儿缓舞铜踶曲，游女明妆罨画舟。\n奕奕朱扉窥水榭，隆隆丹障隐山楼。\n南岩北寺寻俱遍，驷马高车何处留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22657,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"侍御七弟携诸侄游西樵遥寄","author":"区大相","text":"前溪旧隐接松关，别岫新题引蔓攀。\n十里烟萝行象外，千家鸡犬住云间。\n回椒竹涧春流满，曲崦茶畦夕照閒。\n昨日闻君携侄往，西樵应好作东山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22658,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻侍御弟石室之游","author":"区大相","text":"旧日行歌沥水滨，已知巾舄出风尘。\n近逢桂树聊攀咏，宁为桃花始问津。\n往往岩间闻伐木，悠悠潭曲见垂纶。\n谁怜绣服清朝彦，暂向云林学隐沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22659,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苑西书楼宴坐兼答陈生","author":"区大相","text":"小楼东面禁林芬，闲坐高谈到夕曛。\n天近彩云排牖入，风回清漏隔花闻。\n观书滥许三坟富，对酒才过数盏醺。\n见说名山好藏副，欲探石室与论文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22660,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚子十月朔颁历","author":"区大相","text":"凤纪恩光隔岁传，万方正朔仰尧天。\n卿云但遣灵台奏，恒雨何劳太史编。\n蓬阙曈曈迎晓日，蓂阶馥馥绕祥烟。\n从今新令更新政，遂比成周过卜年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22661,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张廷评赴南都","author":"区大相","text":"南去云山郭里登，法曹闲似六朝僧。\n城边人吏迎淮水，竹下官斋到蒋陵。\n策马晨趋三署月，挂帆春断九河冰。\n东南民力须封事，可但凭高问废兴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22662,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和公干冬日入显灵道院感昔","author":"区大相","text":"陵谷依然迹已陈，早逢真诀想还真。\n窗馀朱箓抄经字，房少丹炉候火人。\n羽节芝幡云外寂，石坛瑶草雪中春。\n金茎捧罢琼箫冷，玉手攀花惜此辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22663,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"使大梁赠同行范中翰","author":"区大相","text":"连翩征骑帝城西，四牡骄嘶玉齿齐。\n池上凤书谁比翼，阁中星使旧分藜。\n千花汴口明朱邸，二室云边落紫泥。\n传道輶轩将问俗，共裁谣咏入封题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22664,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过卫作","author":"区大相","text":"环辙何心在磬声，卫多君子昔知名。\n陈诗无复桑中咏，问俗翻从枣下行。\n沁水繁花朝饮马，淇园深竹暮啼莺。\n最怜静女风流尽，谁识当年垂钓情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22665,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过卫河太守年兄席上作","author":"区大相","text":"善政由来继卫侯，宾筵况复甚风流。\n地过淇上多遗咏，客指周南未滞留。\n竹树千竿如水郭，荷花六月似江楼。\n他年胜事追河朔，紫李甘瓜即旧游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22666,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将至苏门途中寄黄平倩宫谕次见赠韵","author":"区大相","text":"我向淇园问竹竿，闻君犹阻啸台看。\n归朝司马游宁倦，历国延陵意未阑。\n卫水客来篇咏少，苏门人去酒杯残。\n探奇倘就梁都赋，题品能无重士安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22667,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孟津殿下新建书堂得请赐额勉学书院恭赋","author":"区大相","text":"玉槛银潢接颍川，肯堂新沐帝恩偏。\n奏诗早擅河间誉，好学今称卫武贤。\n东壁赐书光列邸，西斋留客咏初筵。\n游梁枚马虽能赋，何似奚斯颂鲁年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22668,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王乔飞舄处","author":"区大相","text":"仙令曾闻谒紫微，千年城郭是耶非。\n风前乍想霓旌去，天外惟传玉舄归。\n暮雨霏微芳草径，空山摇拽白云衣。\n讵须鹤语留华表，始信辽东有令威。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22669,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题博望驿壁","author":"区大相","text":"汉家边堠抵河源，又出莎车伐大宛。\n遂侈葡萄筑宫观，更歌天马度昆崙。\n但贪绝域封侯印，谁顾勤兵扰塞垣。\n今日称臣遍属国，不劳持节扣关门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22670,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出均州赴太和行驰道上","author":"区大相","text":"百里天街石路平，游人指点近瑶京。\n芳林隔水闻花气，虚谷含风有鸟声。\n衣上岚光千片落，帷前山色数峰晴。\n逢迎道左多真侣，未入云门觉思清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22671,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登太和顶谒玄帝宫 其一","author":"区大相","text":"皇家香火此开宫，上帝由来有寓公。\n雷电曾驱太一阵，楼台真殚鬼神工。\n霓旌拂雾斜连汉，宝盖浮烟晚御风。\n为问古来封禅代，参差独向海云东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22672,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登太和顶谒玄帝宫 其二","author":"区大相","text":"万峰蹲踏向天门，仪卫森严黑帝尊。\n士女焚香杂环佩，真官拜表领幢幡。\n心归净乐生身地，口诵降魔度世言。\n独以无为参圣道，更从无始问玄元。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22673,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登太和顶谒玄帝宫 其三","author":"区大相","text":"金阙岧峣天柱安，瑶阶千折上危阑。\n妙香不断朝天路，真气时逢礼斗坛。\n羽客尽擎青羽盖，云仙皆著紫云冠。\n先朝数遣祠官出，探得真函进御看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22674,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与番禺穆侯宴浮丘","author":"区大相","text":"丹台路绕碧城隅，茂宰真游道驾纡。\n近报政成能下凤，更传仙去似飞凫。\n蒲香欲驻安期舄，云气常封葛令炉。\n愿藉流霞歌进酒，暂停轩盖白云衢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22675,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈勋卿龙津别业开并头莲邀客共赏陈公往岁曾有此祥适拜徵命","author":"区大相","text":"津桥缭绕碧池浔，翠岛红云倚盖临。\n昔见芙蓉开并蒂，今来菡萏发同心。\n定知浥露无浓澹，不见含霞有浅深。\n日暮横塘歌未已，年年欢宴此追寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22676,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠梁少仲东山旧隐","author":"区大相","text":"三珠洞口玉台东，台上逍遥玄发翁。\n药市可曾逢葛令，博徒何必隐毛公。\n松间石髓凝霜白，囊里丹砂漉酒红。\n更说茅斋无一事，日调么凤竹林中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22677,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和孔阳王孙舟中听琵琶赠别之作","author":"区大相","text":"鹦鹉杯浓醉复醒，琵琶调急弄还停。\n小童曲奏凉州伎，上客欢留陇水听。\n远浦霜横烟漠漠，空江月落风泠泠。\n不知凄切缘何事，徒使离人泪暗零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22678,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗敬叔送至赵家圩晚泊赠别","author":"区大相","text":"江路萧条兴更乘，扁舟岁暮旅怀增。\n天边回雁犹冲雪，水上潜鳞渐负冰。\n远戍孤烟吟塞笛，荒村独树引渔灯。\n君今且作三湖长，厌向风尘问五陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22679,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秦侍御钱吏部张宪副招游湖上泊孤山","author":"区大相","text":"莫踏笙歌一路尘，共将文酒话清真。\n长谣绿水无来客，独往青山有昔人。\n鸟啭芳林移谷口，烟含轻舸出池漘。\n更逢幽境须留醉，山寺梅花水际蘋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22680,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"栎园精舍为潘子朋赋","author":"区大相","text":"作赋闻君拟遂初，为园溪上爱清虚。\n烟霞半拂轩楹入，萝薜能将绂绶疏。\n岭树攒云遥似盖，阶虫萦叶尽成书。\n莫言才散为时弃，得遂天年乐有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22681,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鄂墓 其一","author":"区大相","text":"曾将遗事访朱仙，又见孤坟浙水边。\n南渡总无恢复意，中原空有誓师年。\n战场地远馀春草，垄树林疏起夕烟。\n若使黄龙勋业就，遗封应更象祁连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22682,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鄂墓 其二","author":"区大相","text":"外都回首见旌旗，洒扫宫庭已有期。\n细柳不闻曾奉诏，金牌何事遽班师。\n雁来尚记南侵日，松古应无北向枝。\n一掬西陵千载泪，断桥斜日草离离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22683,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与客登湖心亭","author":"区大相","text":"玉函亭子水仙栖，面面雕阑着水齐。\n云树迥悬三竺路，绮罗斜带六桥堤。\n飞花往往随风度，好鸟时时隔岸啼。\n幸是兰桡皆可息，桃花春水不愁迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22684,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水退后呈郑使君十四韵","author":"区大相","text":"四载风烟拥节旄，大川舟楫属贤豪。\n金沙涨挟青岩下，锦石秋吹碧浪高。\n西郡日来沉雾雨，南溟天阔簸风涛。\n四方大水无不尔，九载襄陵此重遭。\n已悼室庐同泛梗，转愁衢市渐容舠。\n三山欲出层波底，千水遥吞百雉牢。\n万命一丝悬蚁穴，孤城三板足乌号。\n蛟龙纵意骋巨壑，鸿雁伤心哀暮壕。\n十道变书连日上，颓隍版筑不时操。\n官疑苍水充行使，书出玄夷领郡曹。\n陷溺似曾须宝筏，阻饥急用散仓廒。\n安危谁辨堤防力，利涉兼知抚字劳。\n白马至今歌瓠子，黄楼终古奠徐漕。\n看君保障功成日，合有玄圭锡异褒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22685,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"汉江舟中待胡襟寰中丞不至寄怀","author":"区大相","text":"中丞鹊印近登坛，白钺彤弓映豸冠。\n入掌中台专弹射，出兼四镇拥材官。\n周秦形势原交错，楚蜀山川更郁盘。\n千里封疆劳节制，万年江汉静波澜。\n缨歌似逐铙音发，鱼乐皆成阵势看。\n西上儿童舞盘木，南中父老望旌竿。\n秋高岘首游宜数，岁晏隆中卧莫安。\n沧浪月为牛渚月，租船何夜傍江干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22686,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瀛海长春歌为宪副刘翁作翁家瀛海以元日生时夫妇皆寿八十馀长子礼部侍郎次子副都御史故并侈其家","author":"区大相","text":"世家瀛海近长安，天上夔龙接武看。\n大子文章领宗伯，次儿勋业冠台端。\n庭闱自昔荣三乐，人物中朝数二难。\n家宴烟霞元日酒，仙人楼阁五云盘。\n风前玉树连枝发，雪后蟠桃并蒂餐。\n为问年来清浅处，几回蓬阁更承欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22687,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城八景 其一 石门返照","author":"区大相","text":"石门江嶂断，来往思无穷。\n万水浮天外，千帆落照中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22688,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城八景 其二 蒲涧帘泉","author":"区大相","text":"一道香蒲水，奔流下翠微。\n醉起弄珠箔，回风捲雪飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22689,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城八景 其三 灵洲鳌负","author":"区大相","text":"花宫环碧水，百尺驾春涛。\n缥缈金银阙，云门控巨鳌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22690,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城八景 其四 景泰僧归","author":"区大相","text":"松门送客返，栖鹤满珠林。\n昏黑藤萝外，钟鸣山翠深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22691,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城八景 其五 大通烟雨","author":"区大相","text":"江上日烟雨，禅林渺何许。\n磬声时一闻，不见僧行处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22692,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]