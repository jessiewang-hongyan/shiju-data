[{"title":"送马自牧南游清漳","author":"郑关","text":"故国春还草木深，百壶长拟共登临。\n如何此际翻成别，碧海春云日夜心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33746,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送周又玄","author":"郑关","text":"伯劳飞燕苦西东，载酒看云几日同。\n别后相思君识否，断肠多在雨声中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33747,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"竹枝词三首 其一","author":"郑关","text":"几度秋风叹独居，羞将蛱蝶绣罗襦。\n南来万点千行雁，不寄侬郎一字书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33748,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"竹枝词三首 其二","author":"郑关","text":"强来梳洗倦还休，说着西湖只泪流。\n谁道荷花不如妾，开时犹得近郎舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33749,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"竹枝词三首 其三","author":"郑关","text":"十二滩头水拍天，千山阴雨万山烟。\n自从一值风波恶，不敢回头望客船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33750,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀林鸿","author":"郑阎","text":"寒月照古树，朔风吹城楼。\n如何咫尺居，致我千里愁。\n俯景暂自遣，浩歌无与酬。\n思君若逝水，旦暮长悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33751,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题山水图","author":"郑阎","text":"迢迢江上云，杳杳云边树。\n云光与树色，染映如朝雾。\n泉响岩壑秋，帆归海天暮。\n恍惚月明时，轻舟浣溪渡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33752,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题高四友竹轩","author":"郑阎","text":"东林有修竹，茂密成幽林。\n声寒嶰谷雨，色暗湘江阴。\n劲节金石操，虚中天地心。\n故兹耿介士，托交良独深。\n愿言慎终始，永与同冲襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33753,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题宾月楼赠陈伯炜","author":"郑阎","text":"楼居有仙客，耻交时俗流。\n仰寻霄汉上，远与明月俦。\n月色自圆素，冰怀冥相投。\n于焉悟消息，永结忘情游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33754,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寒食写怀","author":"郑阎","text":"岑居对寒食，遣怀出郊墅。\n累累陌上坟，宿草添新土。\n却望故山松，寥寥邈何许。\n念彼松下人，心悲泪如雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33755,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登小孤山","author":"郑阎","text":"群峰若龙驰，一峰出云表。\n壮观天地间，孤高海门小。\n停舟恣登临，腾身过飞鸟。\n却望大孤山，濛濛在冥杳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33756,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀密斋王称","author":"郑阎","text":"丰城有宝剑，弃置归泥沙。\n神物纵淹郁，锋芒讵生瑕。\n精气射牛斗，谁能辨莫邪。\n雷张去已远，终恐沈光华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33757,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"感遇","author":"郑阎","text":"瑶台有孤鹤，脩洁仙中禽。\n本与凤鸾偶，翻为鸡鹜寻。\n谷食颇自耻，松栖亦何心。\n徘徊失所止，惆怅谁能禁。\n引领望徒侣，茫茫玄圃深。\n徒鸣九皋远，孰赏凌空音。\n俯仰再三叹，凄然沾素襟。\n泣玉愿一顾，投珠难至前。\n中山未见与，直道皆徒然。\n君子耻自献，达人甘弃捐。\n衡门有遗叟，千载高其贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33758,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题环青楼","author":"郑阎","text":"辕丘之子神仙客，暂向人间寄踪迹。\n紫绶金章意不趋，白云芳树情偏惜。\n旧构危楼野水边，青松翠竹满楼前。\n寒光静绕湘帘碧，暝色萦回翠黛连。\n望极沧洲几千里，叠嶂微茫鸟边起。\n倚槛朝看出岫云，开门日对悬崖水。\n予亦牵缨未得过，此时风物更如何。\n与君欲毕登临兴，独有陶潜归去歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33759,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题东山草堂","author":"郑阎","text":"山中幽人爱幽独，远搆茅庐傍崖石。\n云边静掩半窗閒，帘外长凝数峰碧。\n佳致应知胜辋川，石桥花竹漫相连。\n閒心久已狎鱼鸟，落日更听鸣风泉。\n别后君还几回首，茂陵仙客深知久。\n兴来笔下自纵横，却扫云山系君肘。\n予亦常留栖遁怀，见此令人心孔开。\n何当拂袖同归去，与汝日醉眠苍苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33760,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清泠台","author":"郑阎","text":"高台临绝顶，我辈此时过。\n落景空山满，秋声晚树多。\n宿云依涧集，野鸟向人歌。\n薄暮归城市，尘氛奈若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33761,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登鼓山寺","author":"郑阎","text":"冠盖临清境，攀跻契夙心。\n悬崖宜远望，邃谷恣幽寻。\n石径苍苔合，珠林古木阴。\n断烟行处湿，落叶坐来深。\n秋色连云暝，钟声与日沈。\n不知沧海外，谁伴羽仙吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33762,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日登高怀公启公立二先兄","author":"郑阎","text":"凄凉心绪正堪怜，此日登临倍怆然。\n无复谩题鹦鹉赋，有怀空咏鹡鸰篇。\n烟林叶落深秋后，萝径猿声向夕边。\n浮世几经人事变，惟馀山色自年年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33763,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重九前一日期同社登乌石山","author":"郑阎","text":"世事悠悠等逝波，休教清景任蹉跎。\n百年几遇看山兴，九日还同载酒过。\n挂月台前云可席，宿猿洞口鸟能歌。\n群公自有飘然兴，谩说参军逸气多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33764,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"钓龙台怀古","author":"郑阎","text":"无诸宫殿粤江隈，千古登临怆不回。\n逐鹿已成今日梦，钓龙空有旧时台。\n潭云片片将秋落，山色苍苍拂曙开。\n世事升沈何足问，且乘清兴共衔杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33765,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽鸣秋山人","author":"郑阎","text":"白湖小隐入云间，忆绝心知泪自潸。\n花径鸟归春正好，衡门人去昼常关。\n新诗空有澄江句，问字惟因载酒还。\n旧业荒凉偏可恨，萧萧烟雨闭青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33766,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜读书寄堂士渊文契","author":"陈煇","text":"凉风动秋叶，惊鹊翻庭树。\n散帙读遗书，寒灯照疏雨。\n冥探玄妙理，应得发归趣。\n寸心常湛如，虚明自呈露。\n依依林木昏，隐隐星河曙。\n寄谢希颜徒，悁勤保贞素。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33767,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游絓月轩","author":"陈煇","text":"灵境閟空寂，云门入中峰。\n玩奇事幽赏，因得相过从。\n方以静中趣，共忘尘外踪。\n攀登散情性，语笑谐心胸。\n萧条林木昏，群物生秋容。\n暝色半潭雨，寒声双涧松。\n行吟送落叶，归思闻疏钟。\n莲社有佳约，东林期再逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33768,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和林范伯琴与诗韵","author":"陈煇","text":"凉露滴草木，微风散衣冠。\n閒将石上琴，遥向山中弹。\n苍苍水云起，瑟瑟枫叶乾。\n初月照秋夕，长松连夜寒。\n寄言赏音者，知遇良独难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33769,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日同诸公登清泠台","author":"陈煇","text":"灵峰起千仞，高台郁岑寂。\n烟萝穷攀登，林谷恣探历。\n凭高一长啸，顿觉万缘息。\n长江天际来，茫茫去无极。\n黄花点醉衣，落叶满行迹。\n万籁送天声，连山起秋色。\n更听白猿啼，东林澹将夕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33770,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山水","author":"陈煇","text":"谷口日耽幽，閒云闭岩扃。\n烟林积空翠，坐见群山青。\n适意调桐丝，洗心期道经。\n以兹对名迹，无乃俱忘形。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33771,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"桃竹百禽图","author":"陈煇","text":"原野蔼初霁，百卉何芳荣。\n雍雍众禽鸟，得意欣春晴。\n迁木恣栖息，惊枝复飞鸣。\n于焉林谷态，自适天地情。\n刷羽耀朝彩，流音杂风笙。\n竹垂琅玕实，桃艳瑶池英。\n吾当披此图，三复羡群生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33772,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得二题送严克谦之京 其一 分水晨关","author":"陈煇","text":"西上有仙关，岧峣望超忽。\n二水隔东南，连山走吴越。\n晨过听曙钟，夕宿投寒月。\n去去何所之，趋朝拜金阙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33773,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得二题送严克谦之京 其二 鹅湖晚钟","author":"陈煇","text":"朝从鹅湖游，暮投鹅湖宿。\n古寺入空山，疏钟出深竹。\n孤舟荡复行，清响断还续。\n百八犹未终，前溪水如玉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33774,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为井轩题孤雁诗","author":"陈煇","text":"露下江色秋，沙明水容夕。\n孤飞尔何来，独立随所适。\n惊弦恨转深，系字情何极。\n扁舟月下闻，愁绝三湘客。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33775,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山水题赠自怡徵士","author":"陈煇","text":"野服每耽幽，东山恣吟眺。\n烟潭落虚镜，风涧生弦调。\n趣惬苍树云，心閒碧溪钓。\n犹疑向苏门，落日共清啸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33776,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"松泉清响赠善琴无幻上人","author":"陈煇","text":"上人了真如，孤琴寄遐想。\n开轩对松泉，宴坐犹偃仰。\n有时閒拂拭，落叶共清响。\n寒声入霜指，秋啸动林莽。\n余尝爱鸣弹，愧乏知音赏。\n一曲殊未终，东林月初上。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33777,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山水图","author":"陈煇","text":"危峰东南来，气势何磅礴。\n下有幽人居，投情在丘壑。\n山云檐下宿，瀑布空中落。\n境静神自舒，地偏心亦乐。\n野桥带行客，孤琴引双鹤。\n日夕候相过，烟霞有深约。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33778,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"旅次武林期叔刚脩撰不至","author":"陈煇","text":"寓宇闭幽寂，羁怀转凄其。\n况兹梅雨候，值此麦风时。\n门登溪上楼，怅望吴天涯。\n长风捲潮来，倏忽银山移。\n潮水尚有信，我行岂无期。\n缅怀同心人，恻然起遐思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33779,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白塘归隐为莆阳陈维祯赋","author":"陈煇","text":"陈生小隐读书处，白塘远隔青山墅。\n地接沧浪九曲烟，门迎壶翠双峰雨。\n寂寂幽栏鸟雀閒，草堂昼掩青松关。\n冲朝猿鹤来何事，落日渔樵相与还。\n清溪月出弦高调，盘石风来可垂钓。\n山鸟声中彭泽吟，海鸥影里苏门啸。\n年来为客意都迷，眼前几负沧洲期。\n片帆明日武陵去，桃花笑杀归来迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33780,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"庐山秋瀑歌寄王四秀才","author":"陈煇","text":"君不见五老芙蓉峰，绝顶邻霄翠万重。\n又不见香炉紫烟石，高标照日气千尺。\n东南胜槩称绝奇，庐山秀色含碧滋。\n半天飞瀑洒云汉，峡龙作雨风雷悲。\n仰观气势何盘礴，一道长流喷穹壑。\n素崖尽裂丹壁开，白虹乍起银河落。\n知君素有江海心，对之不觉清烦襟。\n响入百潭秋水去，听如三峡流泉音。\n子今西行向何处，秋瀑长吟聊寄汝。\n相思得似石上声，倒海随君流不住。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33781,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"浯溪夕秀","author":"陈煇","text":"浯溪山水最奇绝，幽居隐隐依林樾。\n片雨晴浮北砌花，双松暝挂西峰月。\n董仙茆屋居其间，深林尽日闭松关。\n有时相访匆不见，采药云中犹未还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33782,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"青门歌寄居易子","author":"陈煇","text":"青门桥南二月时，青门城北梨花飞。\n忽闻啼鸟道乡信，应念行人何日归。\n东风一夜青门道，客舍萧条但春草。\n远树苍茫感客情，遥山寥落伤怀抱。\n酒幔高楼日未斜，参差桥上几人家。\n钓鲈潮落见归雁，螺女春深起暮鸦。\n此中回望南天路，抚剑悲歌水东去。\n欲问红楼醉别时，正是青门忆君处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33783,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日寄琴乐家兄","author":"陈煇","text":"佳节岁希遇，良会人罕同。\n况逢九日一延赏，兄弟不得相追从。\n凉风萧萧送飞雨，独闭高斋向荆树。\n断雁声悲落木秋，寒鸦影度残阳暮。\n去年此日登高台，邻霄眺望形神开。\n酒酣倒帻醉起舞，长江浩荡天风来。\n念此使人恋携手，骨肉伤心重回首。\n拂石空歌白雪吟，开尊惭对黄花酒。\n始知行乐多暌违，眼中不见令心悲。\n秋来更欲一登眺，赢得潺湲泪满衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33784,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题石田山水障","author":"陈煇","text":"昔游东山访幽独，谢公西亭傍深曲。\n檐楹日落云气凉，百丈空潭澹寒绿。\n衡茆列坐若群仙，蒲衾草榻心悠然。\n长林落叶散巾袖，绝涧飞泉清素弦。\n吟啸于兹足幽赏，野水江云共来往。\n雁渚风回钓艇还，鸥沙月上寒潮响。\n石田画史何清真，毫素机妙如有神。\n丹青放宕竟谁似，岂必辋川贤达人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33785,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题山水","author":"陈煇","text":"海国霁烟景，长林气鸿濛。\n遥峰积翠起千丈，九天秀出金芙蓉。\n石泉淙淙洒风雨，银河半落横苍穹。\n恍疑身坐天姥下，万壑五月生寒风。\n对此发长啸，逸气凌丹虹。\n閒移轻棹入空碧，武陵尽处缘源穷。\n鸥沙潮落见溪钓，鹤林月上闻烟钟。\n以兹便欲赋归去，孤琴未许来相从。\n始知幸接明盛世，谁能敛迹对尘踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33786,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三峡流泉题赠九龄文学","author":"陈煇","text":"蜀江之水何雄哉，奔腾疑从天上来。\n飞流直下几千丈，大壑五月鸣风雷。\n飘然一望失西北，巫峡清秋起寒色。\n声撼长川白日寒，气蒸大漠青冥黑。\n我时曾向锦城游，观涛独上瞿塘舟。\n划然长啸震林谷，短箫呜咽回中流。\n与君对此嘉兴发，便欲因之泛溟渤。\n好挟飞仙汗漫游，孤篷醉倚西江月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33787,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟次武陵书别龚章二友","author":"陈煇","text":"驰马下金陵，买棹上湖鄂。\n扬帆十日过临皋，春风三月登黄鹤。\n黄鹤楼前江水春，春光淡荡堪娱人。\n同舟有客来相访，执手宛若平生亲。\n知君不学悠悠者，宁甘遁迹衡门下。\n落笔词章接惠连，壮游湖海踪司马。\n以兹遇我情最多，长吟击筑气偏豪。\n洞庭纵酒看月色，梦泽推篷望雪涛。\n人生所贵在知己，结交在结青云士。\n那能回首叹萍蓬，况乃立身志弧矢。\n同舟直到武陵城，桃花夹岸春霞明。\n临流慷慨一为别，云树茫茫不尽情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33788,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜泊钓龙台","author":"陈煇","text":"烟村带晚景，落日驻征桡。\n夜色海中月，秋声江上潮。\n鱼灯连水岸，霜月映枫桥。\n明发频回首，乡山别望遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33789,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"落屴峰性上人山房","author":"陈煇","text":"听梵来山寺，逢僧宿石楼。\n风泉行处满，花竹坐来幽。\n别涧钟声晚，空潭树影秋。\n东林微月白，相送虎溪头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33790,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寒夜留宿故人隐处","author":"陈煇","text":"高斋期夜宿，萝径独携琴。\n尊酒成幽酌，孤灯照短吟。\n竹泉分小涧，霜叶响空林。\n且尽山中醉，谁论物外心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33791,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自牧小亭","author":"陈煇","text":"草阁西风下，幽人独考槃。\n涧声和雨听，山色捲帘看。\n好鸟吟花坞，閒云覆药栏。\n孤琴如有约，萝径候鸣弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33792,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中天楼阁为思实赋","author":"陈煇","text":"楼阁东南秀，衣冠翰墨流。\n云来蓬岛暝，潮落镜天秋。\n扫石弦霜轸，开窗捲露钩。\n相逢霄汉上，何必访丹丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33793,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄公鲁文兄","author":"陈煇","text":"薄晚有佳兴，忆君江上山。\n碧云红树远，黄叶白鸥閒。\n岩瀑当空落，渔舟钓月还。\n清晖多雅趣，石磴拟跻攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33794,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"绿筠轩","author":"陈煇","text":"筑室依何许，幽栖向竹林。\n一尘浑不到，万玉自萧森。\n挂月澄明镜，吟风响素琴。\n知君有高节，惟与尔同心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33795,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"古灵旧隐","author":"陈煇","text":"昔贤读书处，今子隐兹山。\n闭户心恒寂，看云意自閒。\n衣冠尘世外，尊俎石林间。\n向晚樵歌起，相随落日还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33796,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泛舟螺江忆旧游寄郡斋诸文学","author":"陈煇","text":"曾向江头倚玉箫，与君同驻木兰桡。\n白波千里秋闻雁，凉雨孤舟夜听潮。\n几处人家连竹坞，数行渔笛过枫桥。\n今来却忆同游侣，烟景苍苍转寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33797,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄仁美同好","author":"陈煇","text":"秋深寥落旧交疏，况复思君万里馀。\n粤国山河违故邑，吴门烟月怨离居。\n数声落木啼猿后，几处疏砧过雁初。\n知尔西游多胜槩，别来诗兴近何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33798,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送又玄周先生应辟","author":"陈煇","text":"把酒河桥独送行，春风此别若为情。\n布衣却起东山卧，京国争传北海名。\n极浦寒潮迎去棹，清川斜日满重城。\n旧游白社成寥落，莫厌题诗慰后生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33799,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重九前七日同郡斋诸文学登邻霄台","author":"陈煇","text":"西风吹眺最高台，云物苍苍入望来。\n秋兴不随黄叶尽，晚樽偏对菊花开。\n岩前落木蝉声急，天际澄江雁影回。\n归去若迎重九日，还从此地送陶杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33800,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"小景题赠密斋先生","author":"陈煇","text":"长寻幽绝避嚣喧，野服吟秋到鹿门。\n几处青山连断岸，数家黄叶带孤村。\n风潭石濑清琴响，烟径苔花翳屐痕。\n却羡渔樵林下趣，白云相对欲忘言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33801,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寒夜有怀宗武","author":"陈煇","text":"坐向东楼月上时，怀君不寐益凄其。\n独拚斗酒山中醉，深负孤琴雨后期。\n夜久霜风还动竹，天寒雪雀自争枝。\n也知别后能相忆，故遣新诗慰所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33802,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题上清方壶山水","author":"陈煇","text":"曾过蓬岛访茅君，路入中峰紫翠分。\n琪树寒生双涧石，石门秋卧半潭云。\n捲帘山色当窗见，拂轸溪声入坐闻。\n何日暂辞尘服累，青松白鹤日为群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33803,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东林别意送善琴无幻上人","author":"陈煇","text":"冶城秋尽此相逢，远别惊心思万重。\n细雨扁舟闻梵语，空山落叶寄行踪。\n孤琴夜对松间月，一锡朝经海上峰。\n莫向西江閒洗钵，恐教风雨起鱼龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33804,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得螺渚征帆送邓孟芳徵士","author":"陈煇","text":"女螺江上唱离歌，百尺云帆挂碧波。\n孤屿断烟天际没，乱峰残日鸟边过。\n榜人洲渚渔讴起，墨客琴樽逸兴多。\n桂棹行当霄汉近，乘流应拟到天河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33805,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"江郎山","author":"陈煇","text":"闻说江郎有弟兄，钟为灵石孕元精。\n气分乔岳峰如削，壁立中天地欲倾。\n风动松枝甘露降，云开石井碧莲生。\n驻车便欲褰衣上，飞步峰头望帝京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33806,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]