[{"title":"古像赞二百零五首 其一四二 宋度宗","author":"孙承恩","text":"度宗绍图，国事日去。\n奸邪肆行，忠义屏气。\n忘情军国，恣乐宫闱。\n天亡由人，巳矣曷悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一四三 赵韩王","author":"孙承恩","text":"天眷有宋，公实佐命。\n辅相两朝，四海底定。\n强敏以断，沉毅以刚。\n显允有闻，式重庙堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一四四 曹武惠王","author":"孙承恩","text":"懿美济阳，仁厚慎敬。\n总师专征，武略亦竞。\n义杀不妄，秋毫不私。\n一代元戎，忠贞无疵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一四五 吕文穆公","author":"孙承恩","text":"太宗重光，文穆柄政。\n悃悃其厚，侃侃其正。\n孰侮孰诬，我嘿我容。\n休休其中，大臣之风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一四六 寇忠悯公","author":"孙承恩","text":"立朝侃侃，直道靡顾。\n致身鼎铉，秉节清素。\n手扶日毂，不震不凌。\n社稷之功，莫能与京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一四七 李文靖公","author":"孙承恩","text":"和靖镇俗，忧勤励君。\n体国寥寥，孰知公心。\n天书矫诬，新法乱政。\n异言纷纷，始颂公圣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一四八 王文正公","author":"孙承恩","text":"王公盛德，休休其容。\n人讦我誉，荐贤为公。\n智名勇能，公无可述。\n致时太平，乃见公绩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一四九 晏元献公","author":"孙承恩","text":"以臣事君，大臣之义。\n公在相位，实克有是。\n嫉恶匪隘，检身益严。\n弗丏恩泽，世称尔贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一五○ 韩魏公","author":"孙承恩","text":"魏公间气，崇志雅量。\n乘时奋庸，出将入相。\n表仪朝著，正笏垂绅。\n光辅三帝，社稷之臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一五一 范文正公","author":"孙承恩","text":"德行纯备，贞金粹玉。\n风节峻厉，霜松雪竹。\n先忧后乐，思济斯民。\n一代贤相，前后绝伦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一五二 富郑公","author":"孙承恩","text":"志节皎皎，忠勤劬劬。\n国有宪章，恪遵弗渝。\n奖善若培，去恶如莠。\n大臣之事，君子之守。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一五三 文潞公","author":"孙承恩","text":"休休元臣，堂堂大耄。\n端雅静重，镇压浮躁。\n危疑定策，社稷之功。\n天下异人，夷使改容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一五四 欧阳文忠公","author":"孙承恩","text":"勋业闻望，韩范并驰。\n古文奥学，匹休昌黎。\n复三代醇，黜五季陋。\n一代宗工，孰居其右。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一五五 胡直讲","author":"孙承恩","text":"经术名家，旁通乐律。\n苏湖之教，造士有术。\n束以条格，率以躬行。\n百世一时，尚怀典刑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一五六 包孝肃公","author":"孙承恩","text":"面目棱棱，刚气烈烈。\n势力苞苴，莫我敢敚。\n严肃者政，苛刻匪心。\n非汉法吏，乃古直臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一五七 蔡端明","author":"孙承恩","text":"吏事严明，绰有异政。\n辞翰精美，传播夷境。\n矫命非抗，风节在兹。\n进茶效忠，贤者之疵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一五八 刘集贤","author":"孙承恩","text":"天禄石渠，野史稗官。\n博学洽闻，莫与子班。\n忠信而恭，方大以直。\n庶几其全，后学之式。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一五九 徐节孝","author":"孙承恩","text":"孝不为名，廉不矫世。\n吾尽吾心，吾安吾义。\n晚膺荐书，乐育多士。\n训告数辞，听者兴起。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一六○ 张忠定公","author":"孙承恩","text":"刚气自负，奇节自喜。\n中庸或乖，顽懦愧死。\n正论难合，直道不容。\n一代名臣，孰能置公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一六一 李旴江","author":"孙承恩","text":"才质俊辨，制作明洁。\n考定明堂，博采众说。\n周礼有论，平土有书。\n疑孟何为，见斥后儒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一六二 程大中","author":"孙承恩","text":"其心悃悃，其行慥慥。\n老成典刑，克慎家教。\n钟和毓粹，笃生二贤。\n寻源究本，后世式瞻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一六三 周元公","author":"孙承恩","text":"天不丧道，乃生哲人。\n建图著书，发挥道真。\n德容清和，襟度朗彻。\n俨如见之，光风霁月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一六四 程淳公","author":"明道","text":"睿质天成，充养完粹。\n和风庆云，盈溢宇内。\n神悟默识，道体洞然。\n敦其似之，我怀子渊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一六五 程正公","author":"孙承恩","text":"气质