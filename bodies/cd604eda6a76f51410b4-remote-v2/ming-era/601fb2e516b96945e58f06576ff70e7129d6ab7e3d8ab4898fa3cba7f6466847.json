llection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一九○ 文丞相","author":"孙承恩","text":"烈烈文山，忠节孤劲。\n身荷纲常，还报列圣。\n正气不亡，百世犹昨。\n山川峙流，风霆磅礴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一九一 谢叠山","author":"孙承恩","text":"蚤岁英迈，议论激发。\n晚遭崎岖，不失臣节。\n饱忠饫义，我腹匪枵。\n充然而归，文山并高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一九二 饶双峰","author":"孙承恩","text":"道发紫阳，瑩彻具足。\n子也成学，笃志佩服。\n尊德道问，益精以详。\n离同合异，将无赘厖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37867,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一九三 元世祖","author":"孙承恩","text":"雄武以断，聪明而仁。\n扶舆间气，笃生此人。\n驱策贤豪，振扬武烈。\n继统中华，式钦大业。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一九四 耶律文正王","author":"孙承恩","text":"用夏变夷，辅仁胜杀。\n弥缝化工，洗濯日月。\n创立帝制，底绥民生。\n仁者之功，孰能与京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一九五 临淮王","author":"孙承恩","text":"临淮桓桓，严凝若神。\n百万貔貅，御如一人。\n讨定江南，混一九土。\n武功洸洸，永载盟府。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一九六 刘文正公","author":"孙承恩","text":"脱迹空门，致身台铉。\n大计密谋，忠勤不倦。\n滦京崇崇，王气所钟。\n定鼎宅中，召公之功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37871,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一九七 许文正公","author":"孙承恩","text":"尊闻行知，潜心圣道。\n岂惟堂基，巳及阃奥。\n司马笃实，伯子粹纯。\n考亭之后，见子一人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37872,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一九八 程文宪公","author":"孙承恩","text":"贞柔不失，大雅有容。\n昭回制作，文饰帝躬。\n敦凝厚庞，像或其侣。\n望之俨然，可愧薄鄙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37873,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一九九 姚文献公","author":"孙承恩","text":"立志卓越，倡道苏门。\n上溯邹鲁，下探关闽。\n謇谔在朝，立纲陈纪。\n身尊道行，莫窥其际。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37874,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其二○○ 廉文正公","author":"孙承恩","text":"庙堂陈谟，方面专制。\n渊渊嘉猷，烈烈正气。\n轲训义利，孔戒孝忠。\n一世人豪，呜呼廉公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37875,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其二○一 刘文靖公","author":"孙承恩","text":"宅心高明，立志坚勇。\n择义既精，任道亦重。\n泥涂轩冕，寤寐圣贤。\n威凤九霄，其飞翩翩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37876,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其二○二 吴文正公","author":"孙承恩","text":"少而英迈，晚就平实。\n潜心六经，殚力著述。\n道明业广，德盛礼恭。\n北许南吴，并称儒宗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其二○三 赵文敏公","author":"孙承恩","text":"前代王孙，异时翰学。\n粹质令仪，高吟大作。\n绘事拟圣，墨妙入神。\n文采风流，照映后人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其二○四 许文懿公","author":"孙承恩","text":"山川蕴灵，哲人继出。\n子承三贤，亦克绍述。\n沿流溯源，直穷昆崙。\n紫阳之道，得子益尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其二○五 虞文靖公","author":"孙承恩","text":"魁凝巨人，淹贯博学。\n探求本原，驰骋制作。\n经纶之妙，寓于文辞。\n弗尽厥用，后世惜之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其二十一 荷蒉","author":"黄省曾","text":"荷蒉者何，逃名卫地。\n宣尼鸣乐，闻音知意。\n翩然出讽，比之厉揭。\n斯行斯言，果于忘世。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其二十二 长沮桀溺","author":"黄省曾","text":"悠悠沮溺，并耜荒墟。\n敬询渡济，暂驻浮车。\n飘然无荅，齐口致讥。\n物情不足，隐德有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其二十三 石门守","author":"黄省曾","text":"石门门者，阖辟是尸。\n仲路宵投，乃询其师。\n鲁尼入耳，强仕致讥。\n閟光韬彩，百世所希。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其二十四 荷筱丈人","author":"黄省曾","text":"丈人绝轨，倨接洙贤。\n天涯日暮，鸡黍是延。\n载陈夫子，寻返客辕。\n先几扫迹，虚室依然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其二十五 陆通","author":"黄省曾","text":"接舆厌浊，放隐佯狂。\n徵罗上士，徙适遐方。\n歌衰凤德，车下道傍。\n洞天周涉，妙药为粮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其二十六 曾参","author":"黄省曾","text":"孝哉子舆，领道泗滨。\n浩浩之气，常骄大人。\n为都不乐，好爵难婴。\n单居秘论，传耀千春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]