[{"title":"送晋宁张知州","author":"黄佐","text":"鹇袍镂带剖麟符，此日官为州大夫。\n冀北风云方快睹，滇南山水更长途。\n心胸洁可兼天净，政化平堪辟地芜。\n吏散閒庭无一事，张衡还拟赋三都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沙河新阙","author":"黄佐","text":"六龙飞动五云间，沙碛宫城迥莫攀。\n百丈丹梯依日月，四围朱户见河山。\n虬翻晓箭趋金殿，雉簇春星带玉班。\n闻道朝陵频露冕，共看花鸟未须还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"彭城怀古","author":"黄佐","text":"华发萧萧羁旅情，片帆冲雨过彭城。\n黄楼此日河声急，赤帝当年剑气横。\n魏阙自生千里草，长陵谁荐一杯羹。\n歌风台下休回首，惟有寒潮溯水明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"院中同龙湖少湖二学士赏红莲 其一","author":"黄佐","text":"池上芙蓉开渐多，日长金马独来过。\n人怜紫袖随彫辇，帝遣明妆出绛河。\n燕树日高犹浥露，楚台风静欲淩波。\n倾筐只在深宫里，未采芳馨奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"院中同龙湖少湖二学士赏红莲 其二","author":"黄佐","text":"供奉当年紫殿东，相看真似朵云红。\n御香冉冉生衣上，皇泽迢迢落镜中。\n长见倾心惟向日，莫教欹盖只随风。\n沉香亭北堪移汝，还唱清平满汉宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"院中同龙湖少湖二学士赏红莲 其三","author":"黄佐","text":"赤日矞云明蓟丘，亭亭羡尔立中流。\n花边御气通鸾仗，池上薰风绕凤楼。\n临镜晓看波色静，弄珠时见露华浮。\n嫣然笑向瀛洲客，长有清香飘素秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"院中同龙湖少湖二学士赏红莲 其四","author":"黄佐","text":"我为寻花到玉堂，谁曾起草入明光。\n碧筒正拟沾尧酒，藻火还堪补舜裳。\n七十紫鸳浮水殿，三千珠翠簇天香。\n琴尊对尔不知去，松壑萧萧生夜凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送费都事使饶州","author":"黄佐","text":"南宫建礼趋庭日，北阙承恩奉使时。\n潞渚晓行垂柳径，鄱阳秋思碧梧枝。\n传家节操闻鸾掖，华国文章出凤池。\n回首五云天咫尺，泰阶平处是昌期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"俨山学士招赏葵菊次前韵三首 其一","author":"黄佐","text":"清霜元不到仙家，锦席淹留对万花。\n寒日北连燕树晚，高云西绕汉宫斜。\n尊前黄菊明瑶斝，窗外红葵映碧纱。\n醉眼迷离还自笑，靓妆那觉有铅华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"俨山学士招赏葵菊次前韵三首 其二","author":"黄佐","text":"朱户沙堤近帝家，招邀曾见一阑花。\n蓬莱日出同霞绚，阊阖风来带露斜。\n细细落英依砌玉，亭亭交影上窗纱。\n合欢对尔青冥里，肯信年华改鬓华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"俨山学士招赏葵菊次前韵三首 其三","author":"黄佐","text":"长安西畔合移家，葵菊经霜尚有花。\n把酒芳馨随手满，倚阑红白亚枝斜。\n生憎鸟啄纷如雨，不分烟笼宛似纱。\n梦想可堪欢赏后，挥毫何惜寄瑶华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再和俨山韵二首 其一","author":"黄佐","text":"凤城西下久为家，铃阁前头半是花。\n秀色不随庭草变，交枝遥带禁烟斜。\n杯香冉冉风生席，窗影离离月在纱。\n谁道岁寒易摇落，五云多处更妍华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再和俨山韵二首 其二","author":"黄佐","text":"摇摇旅梦向谁家，暖艳寒香为忆花。\n雪后尚怜姿绰约，风前仍爱舞欹斜。\n若为折去宜簪帽，忽漫拈来讶剪纱。\n自笑故园看亦得，独骑羸马客京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"听泉为许御医","author":"黄佐","text":"新安仙客许宣平，长爱流泉出涧声。\n红杏雨中竽籁合，绿杨风外佩环鸣。\n梦回春浦犹欹枕，歌罢沧浪更濯缨。\n我有钓鳌竿万丈，大江南去听潮生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄佥宪之江右","author":"黄佐","text":"浙水相逢情转亲，凤台分袂又龙津。\n壶公山下家声旧，孺子亭前宪节新。\n泽国春深花绕树，亭皋夜静月随人。\n轻舟此去江南路，应有清风吹白蘋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日有怀草堂效白沙","author":"黄佐","text":"乾坤纳纳藏春处，草木欣欣向暖时。\n消日只须移钓艇，留人惟共咏陶诗。\n浴沂有志群曾点，浮海何心独仲尼。\n最是闲行观物态，晚来栖鸟在深枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镇海楼宴集次潘少承韵时少承适至自冲鹤赋诗故以鹤仙称之为诸朋载酒者梁思伯中翰也","author":"黄佐","text":"五明楼俯粤台幽，绮席平临天际头。\n载酒正从鹓沼至，裁诗还喜鹤仙游。\n琼云似向檐前宿，珠海潜随岛下流。\n荡荡尧天才咫尺，与君同散杞人忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"八月十日万寿圣节梦侍朝有述","author":"黄佐","text":"銮坡供奉胜金貂，紫殿东头侍早朝。\n鹓鹭序时观典礼，凤凰仪处听箫韶。\n驰驱南北凋双鬓，归计罗浮梦九霄。\n此日嵩呼瞻望切，五云天路碧迢迢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"至日偶成","author":"黄佐","text":"天南南至暖如春，向晓祥云捧日轮。\n旅雁似嫌关塞冷，野梅应笑岁时新。\n洗兵力欲翻银汉，鸣佩心犹侍玉宸。\n岭海阳回真乐事，调和葭琯是何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"腊日有感","author":"黄佐","text":"镐京腊日开芳宴，春满仙桃侍九重。\n击壤只今垂白发，挥杯何处觅黄封。\n金銮每见瑶词妙，玉兔长闻瑞气浓。\n寄与掖垣风月道，别来谁听景阳钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元日偶成","author":"黄佐","text":"甲子初开玉历长，朱衣皤发映朝阳。\n休兵自昔沾周宴，击壤于今贡越裳。\n华月未临仙掌露，东风初度御炉香。\n夜来冷觉钧天梦，惟喜王春遍万方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花朝写怀","author":"黄佐","text":"雨后园林生午凉，登台持酒兴偏长。\n遥山带日曈昽碧，曲径浮花淡荡香。\n蓟北昨曾妆玉节，潮南今复动牙璋。\n春来驿使传消息，却喜蓬莱是帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日登玄览台偶成","author":"黄佐","text":"莫春春服喜初成，玄览台前日最明。\n鼓瑟未能追雅调，浴沂聊试濯尘缨。\n济川似见南溟楫，怀阙偏依北斗城。\n欲会点狂当日意，满林梧竹送春声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杪秋甚热偶成","author":"黄佐","text":"蒹葭盈海蔚苍苍，谁见梧桐一叶黄。\n残月带星如散火，凯风吹露未成霜。\n宾鸿应候还遵渚，蔓草何知只过墙。\n一笑东篱正迢递，解缨惟爱濯沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2142,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小寒节有感","author":"黄佐","text":"雨霁风恬始见花，野梅含笑正横斜。\n红芳此后周千里，绿树仍前荫万家。\n寒日自能明蔀障，轻雷应为蛰龙蛇。\n老来衰惫偏多感，时有新诗纪物华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2143,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元日述怀","author":"黄佐","text":"静守黄庭玉漏长，晓来嵩祝整冠裳。\n庭前草色交新翠，檐外梅花送暗香。\n漠漠绪风传鼓吹，丝丝过雨净林塘。\n粤南自笑康衢老，曾听流莺绕建章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2144,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题一苇所如卷为何石川","author":"黄佐","text":"珠江千顷碧连天，一苇逍遥快似仙。\n寻乐岂须蓬岛外，采真元是粤台边。\n扶桑下照金浮晕，轮桂空明玉作田。\n多少钓徒烟浪里，羡君来往过年年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2145,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别张松陵宪副之浙藩大参","author":"黄佐","text":"曾向琼台上柏台，粤人歌颂出群材。\n江花似雪留春在，浙路淩云计日回。\n燕树北来天柱合，胥涛南下海门开。\n夜寒剑气看牛斗，应自松陵烛上台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2146,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠潘罗阳自南户部赋归","author":"黄佐","text":"蕊珠宫外鹤舒台，又见翀霄驾鹤回。\n一亩閒居重作赋，十年荣路独归来。\n阶前玉树联云起，篱下黄花带露开。\n莫向罗阳问青紫，罗阳今是小蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2147,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次潘少承寿七十一韵","author":"黄佐","text":"玄览台前闻雅音，滋兰豪唱麟蒲深。\n玩梅谁谓越山雪，采菊自多疏传金。\n三径烟霞娱白首，九天日月悬丹心。\n何当一曲解民愠，浩浩南薰吹北林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2148,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦作三朝祝寿诗","author":"黄佐","text":"东风吹漏出宫迟，鹓鹭追趋祝圣时。\n九奏共闻周雅乐，三朝欣睹汉官仪。\n青旂日色明仙仗，紫殿天香满玉墀。\n鸣佩缓归金水畔，新莺初啭万年枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2149,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春夜曲为边将妇作","author":"黄佐","text":"玉围消尽恨缘君，金剪呵寒减翠裙。\n照泪悔将菱作镜，织愁羞见锦为文。\n陌头杨柳惊春色，楼上花枝伴夕曛。\n凤阙几时曾扈辇，龙城何事只从军。\n去年提剑屯秦塞，今岁搴旗驻晋汾。\n落叶飘摇应可拟，哀笳呜咽岂堪闻。\n交河北向犹旋凯，瀚海南回已策勋。\n桐井乌啼钟易断，药栏蛩语漏难分。\n情同牛女期想见，影逐鸳鸯愿作群。\n夜半朔鸿呼梦起，一天凉月沁香云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2150,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"粤洲塘前丝瓜除架有感","author":"黄佐","text":"回塘瓜架蔓交垂，嗟尔无知却有知。\n临水升高如赴约，向阳腾茂亦逢时。\n开花缦缦黄成绮，结实累累翠作丝。\n野鸟下窥惊袅娜，游鱼潜伏跃涟漪。\n春时把钓供诗兴，夏昼乘凉对酒卮。\n万籁响沉龙自舞，九皋遮遍鹤来迟。\n山河影动烟霏合，天地恩深雨露滋。\n味入庖厨常有赖，功收结构更无私。\n退藏直待根芽长，摇落方随岁序移。\n环复化机寒事里，满前松竹共心期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2151,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读见素救李空同奏疏偶成二绝 其一","author":"黄佐","text":"梁苑花间河水长，柳条谁遣媚风光。\n怜才不是云庄老，愁杀中山猎后狼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2152,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读见素救李空同奏疏偶成二绝 其二","author":"黄佐","text":"贾谊忧时旧有名，楚骚何事不胜情。\n长安宿鹭冲人起，应是风波到处生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2153,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮朱明洞二首 其一","author":"黄佐","text":"萝茑阴阴径树斜，东风吹处尽闲花。\n前身自是轩辕集，笑指朱明是我家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2154,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮朱明洞二首 其二","author":"黄佐","text":"卜筑朱明五百年，芒鞋重踏旧云烟。\n山灵只恐频归去，微雨潇潇锁洞天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2155,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花首台","author":"黄佐","text":"紫府仙人碧玉车，往来花首日传书。\n玄机浩劫皆云篆，葛令新裁锦不如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2156,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"麻姑峰","author":"黄佐","text":"鹏背天风万里长，玉霄飞动上元章。\n桃花流水千年在，不遣麻姑有鬓霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2157,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西清词六首 其一","author":"黄佐","text":"璧月珠星满紫坛，莲花齐簇切云冠。\n瑶池岂必传青鸟，蓬岛惟应集绛鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2158,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西清词六首 其三","author":"黄佐","text":"兰麝氤氲化庆霄，芝龙迤逦度虹桥。\n万花似锦环清馥，午夜月明闻洞萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2159,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦游穆天子观作","author":"黄佐","text":"穆满南征事已空，尚馀猿鹤噪天风。\n长松俯慨人间世，日夜涛声霄汉中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2160,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦中题画","author":"黄佐","text":"中原逐鹿几经秦，劳向桃源更问津。\n何似邵平生计好，种瓜赢得满园春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2161,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莫春朝陵西游次张石川韵十首 其五","author":"黄佐","text":"山陵重构集戎机，旧日明楼燕自飞。\n琬琰已教金作砺，松楸还见翠成围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2162,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莫春朝陵西游次张石川韵十首 其六","author":"黄佐","text":"青袍白马泰陵行，十五年前路惯经。\n一诵君诗一惆怅，几回赓和几回停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2163,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莫春朝陵西游次张石川韵十首 其七","author":"黄佐","text":"紫翠南头楼殿开，燕门王气亦雄哉。\n中兴此日经营力，重见诗人咏子来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2164,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莫春朝陵西游次张石川韵十首 其八","author":"黄佐","text":"缓辔微吟鸟亦歌，沙河迟日水增波。\n为飏圣教光千古，还与寰区保太和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2165,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莫春朝陵西游次张石川韵十首 其九","author":"黄佐","text":"西湖闻道泛龙舟，紫盖黄旗照碧流。\n奎藻万年华宇宙，矢歌何日复来游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2166,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莫春朝陵西游次张石川韵十首 其十","author":"黄佐","text":"宫前唱礼鼓钟急，马上发行星斗稀。\n咏向风林真自得，莫春疑是舞雩归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2167,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潞河阻冻戏赠文衡山五绝 其一","author":"黄佐","text":"研池涵月映窗虚，中有骊龙万斛珠。\n安得天瓢翻作雨，一时飞洒尽公书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2168,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潞河阻冻戏赠文衡山五绝 其二","author":"黄佐","text":"元气淋漓接混冥，毫端山水自仙灵。\n桂坊走马求蓬岛，芸阁移书问洞庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2169,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潞河阻冻戏赠文衡山五绝 其三","author":"黄佐","text":"山如文债海诗逋，追骑飞尘出帝都。\n归去太湖烟水上，不知能对白鸥无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2170,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潞河阻冻戏赠文衡山五绝 其四","author":"黄佐","text":"阖闾城下浩烟波，日日沙头载酒过。\n垂杨系艇不知数，一纸黄庭双白鹅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2171,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潞河阻冻戏赠文衡山五绝 其五","author":"黄佐","text":"纷纷车马款柴关，焚却银鱼亦未闲。\n输我疏顽无一事，日骑黄犊访青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2172,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿封君王乐葵","author":"黄佐","text":"乌纱白发拜枫宸，酒酌麟蒲岁岁春。\n秀色满庭倾向日，种葵真似种槐人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2173,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题西园为马主事文祥","author":"黄佐","text":"萧萧松竹间坛栾，满架图书绝世喧。\n燕坐不知红日近，倚阑东望是长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2174,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南归途中杂诗二十二首 其一","author":"黄佐","text":"委佩朝辞白玉阑，褰帷夕驻潞河干。\n半帘兔影照清梦，满院虬阴生翠寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2175,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南归途中杂诗二十二首 其二","author":"黄佐","text":"陇麦枯乾径草生，杜家园榭坐传觥。\n唐求罗隐过逢地，共指河冰未可行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2176,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南归途中杂诗二十二首 其三","author":"黄佐","text":"曈昽白日照河西，杨柳萧萧绿未齐。\n回首九重犹咫尺，青天何处有云霓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2177,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南归途中杂诗二十二首 其四","author":"黄佐","text":"杰架彩绳摇远天，茜裙儿女竞鞦韆。\n夭桃灼灼短篱上，轻燕飞飞高岸边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2178,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南归途中杂诗二十二首 其五","author":"黄佐","text":"朔风日日吹黄埃，忽闻李白歌声来。\n德州春事可人意，江上杏花无数开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2179,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南归途中杂诗二十二首 其六","author":"黄佐","text":"南旺湖边沙柳春，鹅黄凫藻相鲜新。\n棹歌歌遍江南曲，袅袅长风吹白蘋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2180,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南归途中杂诗二十二首 其七","author":"黄佐","text":"半隐园中鸣桔槔，曲淙趋沼白珠跳。\n河流浅兆真堪笑，积雪虚瞻泰岱高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2181,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南归途中杂诗二十二首 其八","author":"黄佐","text":"黄河迢迢趋亳州，上洪下洪俱断流。\n漕船估客不可度，云石风沙无那愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2182,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南归途中杂诗二十二首 其九","author":"黄佐","text":"枸杞翘翘杂浅莎，呼童采摘不嫌多。\n若令牵路来车马，纵有雕盘柰尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2183,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南归途中杂诗二十二首 其十","author":"黄佐","text":"荷锸野夫淘浅水，悬鹑羸妇出深村。\n沙滩岂有金银气，筐筥空存草木根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2184,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南归途中杂诗二十二首 其十一","author":"黄佐","text":"清河舟楫达孟城，夹岸青青麦浪平。\n闻说江南好风雨，绝怜江北望秋成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2185,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南归途中杂诗二十二首 其十二","author":"黄佐","text":"十里隋堤尽鹤群，春来应见玉宸君。\n帝城已结三珠树，仙苑长盘五色云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2186,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]