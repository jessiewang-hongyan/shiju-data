[{"title":"咏史","author":"邵宝","text":"麻衣力尽泣孤臣，回首江南草色新。\n独恨乾坤如许大，首阳无地可埋身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春庭八绝句 其一","author":"邵宝","text":"三年种松五尺彊，松枝盘桓松叶长。\n岁寒节操久应见，春日开花清更香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春庭八绝句 其二","author":"邵宝","text":"偶栽梅树是红花，每岁花开对客誇。\n知己相看心自白，尽将颜色付诗家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春庭八绝句 其三","author":"邵宝","text":"菖蒲本是仙灵物，却为冰霜穴底藏。\n过尽东风更梅雨，水中央看婉清扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春庭八绝句 其四","author":"邵宝","text":"西园移来两丛竹，千古湘皋宛旧斑。\n莫道吴天非楚地，主人眼底有江山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春庭八绝句 其五","author":"邵宝","text":"新梧树傍旧桐栽，俱自青山寺里来。\n几见霜黄春又绿，有诗空和凤凰台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春庭八绝句 其六","author":"邵宝","text":"买裁金橘短婆娑，向来洞庭风雨多。\n分付苍头好浇灌，莫教人力负天和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春庭八绝句 其七","author":"邵宝","text":"燕居亭前石子台，两株银杏一时栽。\n莫言未得弦歌地，画里尼山许见来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春庭八绝句 其八","author":"邵宝","text":"九畹新成古井田，滋兰又似赋骚年。\n不如无界还无数，雨露茫然太古天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画送胡仁夫 其一","author":"邵宝","text":"酌泉饮君君莫疑，此泉德本与君宜。\n烦君持向开河去，宋老祠前奠一卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画送胡仁夫 其二","author":"邵宝","text":"东山寺里相逢地，陆子泉头再会年。\n震泽烟波彭蠡月，乾坤回首一茫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望云庵为林提学题用素翁韵 其一","author":"邵宝","text":"白石山前云气深，有时飞起有时沈。\n太行顶上南回首，千里慈闱隔岁心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望云庵为林提学题用素翁韵 其二","author":"邵宝","text":"黄河东绕太行深，云薄西峰日未沈。\n万里乾坤同一慨，北南行止两无心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中柬文玉 其一","author":"邵宝","text":"雨中闭阁自焚香，门外诗来故故忙。\n梦里风骚犹远在，却教白日破羲皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中柬文玉 其二","author":"邵宝","text":"梅天散帙动芸香，谁信閒人尽日忙。\n不见青藜照清夜，欲将遗事问东皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题石庵画竹","author":"邵宝","text":"萧萧数叶不胜看，到此方知画竹难。\n谁信中书曾放笔，片时行尽楚江干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为俞立夫题秦务本小画","author":"邵宝","text":"诗兴逢秋日渐深，相知独寄画中琴。\n青山影照斜桥水，时往时来共赏音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"成汝从惠鲈鱼口占荅之","author":"邵宝","text":"溪边渔艇日相寻，谁遣鲈鱼动我吟。\n我脍我羹人莫易，当年张翰亦劳心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿涯翁老师用癸酉守岁韵","author":"邵宝","text":"濯缨歌罢水无尘，静里乾坤太古春。\n藜杖有情随兴远，綵毫无象与时新。\n星辰又值初生日，山斗同瞻未老身。\n白发门生江海上，捧觞真羡在庭人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"閒居用旧韵","author":"邵宝","text":"短墙隔断市桥尘，地为容春早得春。\n春雨却扶嘉树老，草堂方舞綵衣新。\n经纶不入间边梦，笔砚长随病后身。\n刚爱绿阴帘阁坐，抱琴惊见扣门人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜与东泉澜庵坐月","author":"邵宝","text":"病起寻诗此夜多，隔帘月竹弄婆娑。\n灯光相对知人否，酒戒未开如夜何。\n它日更期天淡荡，去年犹忆雨滂沱。\n西风吹绽东篱菊，须向花前一浩歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲戌正月三日山行次史敏甫","author":"邵宝","text":"万壑春姿一夜还，画船载酒共看山。\n泉经古寺自双涧，亭倚危峰还几间。\n真乐竟须同客醉，浮生何必羡僧閒。\n南岩更得和风早，笑索梅花不作悭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐用中寓松风阁诗以为问","author":"邵宝","text":"舞雩何处问高坛，松阁春风晚带寒。\n病起不须操几杖，诗成刚在凭阑干。\n榻缘徐孺初教下，垆为王郎试索看。\n我欲坐君听古调，隔墙还有玉千竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中漫成","author":"邵宝","text":"阳春门外水田田，野老歌声远近连。\n雨应雪来曾计日，月从星在故占天。\n漫看东渚横孤艇，久拟南风振五弦。\n更爱亭前新种竹，一番沾洒一森然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄许东庐","author":"邵宝","text":"老去诗篇兴若何，一春城郭少经过。\n阴怜绿树风偏好，湿怪黄梅雨太多。\n静力更凭閒打整，狂心都逐病消磨。\n劳君问讯无堪报，微醉亭前独放歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅桂子朴","author":"邵宝","text":"南行将母底须悲，浙水滩高恐到迟。\n秋月春花皆我梦，海风江雨此何时。\n孟郊心苦吟游子，韩老情多赋别知。\n尽把新怀对难弟，玉峰回首思冥迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻李四顺讣","author":"邵宝","text":"百年家学有箕裘，晚擢高科仕亦优。\n北斗望中心凤阙，西山归处首狐丘。\n一封诰尚虚新墓，万卷书还满旧楼。\n最是渠南亭子在，黄梅细雨不胜秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次杨淡成","author":"邵宝","text":"去年雁早曾闻赋，今赋还闻雁晚来。\n信入上林云有路，居空彭蠡水无陔。\n独看黄菊疑秦令，未猎长杨愧汉才。\n莫道喘牛非我问，饭牛歌罢自生哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠边伯山教授","author":"邵宝","text":"看尽长安一日花，还从八月返星槎。\n儒官故冷师模重，宦路虽迂国体华。\n地接苏湖风有自，天空蓬阆海无涯。\n栋梁榱桷皆时用，歌向先生不是誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送费鹅湖先生归铅山","author":"邵宝","text":"归兴乘秋度玉山，始知佳境在人间。\n云鸿影外江湖远，皋鹤声中日月间。\n秘阁文章天下手，都门图画老臣颜。\n感公相问无能荅，病客江南正掩关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿贾封君","author":"邵宝","text":"上寿人膺太史封，白头林下庆遭逢。\n清时恩典隆冠冕，令子文章重鼎钟。\n鸠杖晚扶閒处立，兕觥春映醉时容。\n仁源不在南阳水，莫问今生菊几丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"屋舟为京口钱宗玉赋","author":"邵宝","text":"风波懒逐世浮沈，小阁凭虚敞素襟。\n采药每牵浮海梦，乘槎聊遣济川心。\n水能载覆旁观久，天与周旋独坐深。\n闻道江南船似屋，中泠何地觅帆阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自和幽居四咏 其一","author":"邵宝","text":"晚晴无物不含晖，此树天将悦我非。\n一碧故涵秋水净，半黄初着晓霜微。\n吟随望远长凭几，情忆阴多坐解衣。\n莫道寂寥谁与共，天风时引白云归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自和幽居四咏 其二","author":"邵宝","text":"忽有幽香共午风，小春庭院菊篱东。\n一丝何处来应远，百和无端界本空。\n漫道芝兰随物化，真闻黍稷与神通。\n麓堂地隔四千里，三叹馀情数纸中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自和幽居四咏 其三","author":"邵宝","text":"绿树春声正自怜，秋深幽鸟复庭前。\n谷中音似闻人语，池上书应为客传。\n短调自须风静听，多情谁起日高眠。\n閒来漫拟成新曲，长啸临流付一弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自和幽居四咏 其四","author":"邵宝","text":"饶州遣鹤剩风流，小圃新开竹径幽。\n见影浅将于水监，闻声高欲自天求。\n图中恨识青田晚，梦里疑看赤壁秋。\n莫向主人撩醉眼，病馀如我且须休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄吴宪使","author":"邵宝","text":"濂泾草堂清可怜，幽期已在立秋前。\n社中诗自无新什，方外书应有别传。\n野旷正堪乘月步，日高犹为避风眠。\n伯牙山水钟期耳，万古知音不在弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿涯翁老师","author":"邵宝","text":"缄诗到已过弧辰，十月书回墨尚新。\n独乐园成身未老，静观心在物皆春。\n千钧笔试三杯酒，数仞墙趋四海人。\n古华山泉深更远，年年持此庆生申。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿吴宪使","author":"邵宝","text":"东藩回首兴飘然，须信吾儒有列仙。\n湖海正当初返地，星辰还值始生年。\n南山静对陶潜菊，春酒香分陆羽泉。\n笑问丹丘何处是，为君重赋远游篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观红梅次玉林韵 其一","author":"邵宝","text":"两树新从浙上来，一株先向槛前开。\n春回老干经三月，酒入酡颜定几杯。\n画笔词锋争胜负，花情人意两徘徊。\n玉林高唱南沙和，月上东山客始回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观红梅次玉林韵 其二","author":"邵宝","text":"清兴逢春似水来，红梅花下小筵开。\n尽将颜色降诗律，独引风情入酒杯。\n积雪不知香逗遛，落霞还与影徘徊。\n海棠更有西轩在，赏事真须第二回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中红梅","author":"邵宝","text":"红入梅花淡更妍，一株曾向麓堂前。\n为春独步还今日，与雪相违又几年。\n素质已参丹鼎客，朱颜应作羽衣仙。\n凭谁唤醒罗浮梦，不信瑶池别有天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得莫如山浦文玉和章复用韵一首禁体物语","author":"邵宝","text":"初阳一点便成妍，占断容春小阁前。\n犀浦有招须避地，海棠相见定忘年。\n姿容漫倚云边客，香影空传海上仙。\n寄语诗人休物色，已知描画不如天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送梅","author":"邵宝","text":"吹残玉笛有馀妍，愁向东风问雨前。\n共矢心情如白日，长留颜色似青年。\n看过春陌且从客，餐尽朝霞还访仙。\n何处江皋可遗玦，罗浮回首海南天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再咏红梅","author":"邵宝","text":"江头两株来越人，却依旧树争鲜新。\n竹松相与可偕老，桃杏不知应妒春。\n特书方将补月令，殊色乃复烦花神。\n倚阑独对东风语，万古清香真绝尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送秦中丞国声之湖南兼呈东山先生","author":"邵宝","text":"中丞旌节自东来，黄鹤楼高倚宪台。\n江汉朝宗千古地，风霆鼓舞一时才。\n洞庭水阔春初渡，衡岳云深晚正开。\n老矣东山烦问讯，苍生回首柰何哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送华大参文光 其一","author":"邵宝","text":"老鹤风清蜀道寒，使君直节动朝端。\n峨眉月小天非远，滟滪春深水正宽。\n今雨客怀还对榻，平生交谊自胜冠。\n益州画像闻犹在，石本凭君一寄看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送华大参文光 其二","author":"邵宝","text":"兵戈销尽蜀江深，甘雨和风使者临。\n宽得一分非小惠，远从三殿是佳音。\n他年鸣凤曾为瑞，何处甘棠不作阴。\n提学分司如我问，古梅花下忆论心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨坐","author":"邵宝","text":"桃花水来花正飞，鸣雨既过还烟霏。\n道人多情自晚阁，童子好事空春衣。\n溪上芳洲白鸥剧，城边野塘青草肥。\n山园竹萌未盈尺，有仆修篱乘棹归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈嘉言送双鹤以诗遣之次韵为谢","author":"邵宝","text":"病后身轻欲御风，羽人谁遣过墙东。\n乾坤有地云随驭，日月多情鸟出笼。\n诗社几人时野服，使君五马古侯封。\n天机动我鸣还舞，更爱新巢在老松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"馈笋于侯明府明府有诗用韵荅之","author":"邵宝","text":"玉在山中敢自珍，令君诗到便成春。\n坡翁他日言何剧，石老此庵看已真。\n巢凤欲来先振羽，箨龙方卧渐生鳞。\n筠笼落落惭为政，只馈清馋不馈贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"以梅实樱桃赠文玉文玉索诗用前馈笋韵","author":"邵宝","text":"人有相知果有珍，盘中朱绿眼中春。\n休论金鼎调还未，且道筠笼赠是真。\n试熟漫凭犀浦鸟，荐新兼侑锦江鳞。\n无端生意诗囊在，报尽璚瑶正不贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得乾笋法于文玉用前韵为谢","author":"邵宝","text":"待聘多君久席珍，等閒熏炙亦成春。\n相知岂谓新时好，不厌曾闻淡里真。\n煮石每教寻活火，屠龙谁解斸生鳞。\n庭前更有双梅实，古鼎无劳笑我贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再荅文玉用前韵","author":"邵宝","text":"市桥樱笋竞相珍，四月风光未尽春。\n病欲自医须此静，才难时用是吾真。\n南山地近无丛桂，沧海波深有一鳞。\n数亩小园千挺竹，野人家事不曾贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三荅文玉 其一","author":"邵宝","text":"十载胸藏万古珍，挥毫应待殿前春。\n群龙变化知非幻，二鸟遭逢恐未真。\n独夜坐醒云鹤梦，长风歌动石鲸鳞。\n古人青眼如犹在，肥马宁教笑士贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三荅文玉 其二","author":"邵宝","text":"蕨芽未许殿山珍，孤竹根回地底春。\n歌菉千年风故好，闻韶三月味应真。\n沧江雷雨龙无种，深谷霞烟玉有鳞。\n漫咏杜诗还自笑，数株桃树济谁贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"追挽庄定山","author":"邵宝","text":"尺疏曾闻奏玉皇，上元灯火谢词章。\n百年不起燕台马，万古犹存鲁庙羊。\n剑委烟霞还岳气，笔参星斗动江光。\n长歌滴尽东堂雨，祗缺青山一瓣香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次浦文玉夏日遣怀","author":"邵宝","text":"午风清爱葛为袍，销尽炉薰政寂寥。\n愁里得诗如客到，梦中观物笑僧骄。\n三年病合投閒计，十里游辞避暑招。\n有曲和君还自已，古琴疏越未堪调。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"待曙楼为俞司谏国昌赋次涯翁老师韵","author":"邵宝","text":"高栋层轩带宿霏，明星耿耿见依稀。\n天回北斗还何指，地向东方渐有晖。\n寺下云林僧未出，城边野水鸟初飞。\n主人听彻金门漏，五凤楼前候衮衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"热中和杜自遣","author":"邵宝","text":"时行风咳十人九，而我欲逃还不能。\n漫扣苏槃弄白石，且诵欧赋憎苍蝇。\n万里楼台正隐隐，三年几格何仍仍。\n所思宛宛隔秋水，墨汁飞来字字冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次侯明府登湿云亭","author":"邵宝","text":"两载忧民太瘦生，偶乘秋兴试山晴。\n路过野寺云初湿，人在危厓鹤共清。\n有石尽堪他日颂，此泉真与我心盟。\n大夫能事登高赋，莫讶天风起旆旌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次侯明府九日游惠泉","author":"邵宝","text":"病不登高数负秋，却怜令尹此閒游。\n清知流水山中出，远见云飞海上浮。\n僧具袈裟惟茗供，客过方丈有诗留。\n秪应稼穑关心在，莫话忘机欲对鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十四夜小酌","author":"邵宝","text":"将圆未圆天上月，似老非老人间人。\n醉时歌调几年复，病起酒杯今夜新。\n多情不啻共千里，何地更堪容一尘。\n明日南楼独清咏，风吹星汉欲粼粼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46847,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日侯明府见过","author":"邵宝","text":"病中三度见秋风，车骑时时枉县公。\n野服岂堪迎上客，清谈真可慰深衷。\n地从泰伯风流在，人与中牟惠爱同。\n帘阁不知移日影，薰炉茗盌有双童。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46848,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵立之应贡","author":"邵宝","text":"君门北望政如天，有志元从鼓箧年。\n岁赋远追三代典，命题亲御九重筵。\n诗成行卷如携岳，酒尽离觞更酌泉。\n莫向秋风逐车骑，新春须上渡江船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46849,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西郊观稼奉次涯翁先生","author":"邵宝","text":"诏许明农值此年，西郊垂稼正田田。\n一时偶出游还赋，四海方询食与眠。\n溪水多鱼供有馔，野人皆酒飨无筵。\n寿村风景谁堪拟，韦杜同归尺五天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46850,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢侯明府遣医视老母用壬申岁闻侍养命韵","author":"邵宝","text":"偶于文檄见都俞，多少忧怀为扫除。\n父母歌传千载上，君臣药在一言馀。\n三春寸草慈亲德，片纸千金令尹书。\n医国有人吾岂敢，秪从花径导潘舆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46851,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]