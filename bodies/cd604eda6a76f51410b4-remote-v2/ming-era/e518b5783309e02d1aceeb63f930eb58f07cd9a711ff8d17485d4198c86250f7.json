[{"title":"题樵","author":"谢士元","text":"远近人家远近山，丁丁长斧白云间。\n等閒斫断吴刚树，收拾堪寻旧路还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34765,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题白菜","author":"谢士元","text":"露茎风叶味偏清，咬尽能教百事成。\n写出一根常寓目，知君忘却五侯鲭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34766,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"仲春陪祀先师于太学","author":"刘大夏","text":"吾道乾坤大，神功宇宙长。\n六经垂宪典，百世乐虞唐。\n圣主崇殷礼，春丁启旧章。\n制从天上下，诚在币先将。\n斗柄回霄汉，黉宫列冕裳。\n炉烟环殿袅，庭燎烛天煌。\n飒沓韶钧奏，清芬黍稷芳。\n舞容辉俎豆，歌吹杂笙簧。\n肃肃神如在，颙颙气若藏。\n致恭三献爵，饮福再升堂。\n遥听青衿赞，稀闻玉佩锵。\n松阴移晓月，人影散寒霜。\n回首看车马，徐徐过庙墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34767,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陌上耕农","author":"刘大夏","text":"春风吹暖布新晴，远迩频闻击壤声。\n为乐自忘终日倦，遗安应效古人耕。\n更无世故来萦虑，只解农功是养生。\n堪笑宦游江海客，几人勋业著升平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34768,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"早朝","author":"刘大夏","text":"夜色苍苍月渐西，千官待漏立金闺。\n龙飞咫尺天颜近，虎拜从容佩响齐。\n花迓宫袍云锦重，柳披春仗露梢低。\n眼中并识文明治，东阁前头取次题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34769,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"早朝寄所知","author":"刘大夏","text":"漏残高阁月华低，曙色分来紫禁西。\n帘捲香烟龙衮见，佩和仙乐鹭班齐。\n陛头咫尺承天语，花底从容坐御堤。\n遥忆故人何处是，楚天云树望中迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34770,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖山雅趣图为太仓张俞题","author":"刘大夏","text":"青山隐隐水悠悠，此日披图忆旧游。\n远树云开湘浦晚，孤帆日落洞庭秋。\n萍踪自昔随流转，华发谁今为国忧。\n却笑薄才终恋阙，湖山雅趣付君收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34771,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"红梅","author":"刘大夏","text":"别是江南一种梅，年年先占早春开。\n东风有意怜冰骨，冻雪无情压绛腮。\n仙子自知丰格在，北人宁作杏花猜。\n虽然未见调羹实，一寸丹心绝点埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34772,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寻功德寺失道","author":"刘大夏","text":"最是祗园佳境深，白云堆里路难寻。\n禅房未了看花兴，清梵空闻隔叶音。\n酒醒微风双树远，诗成斜日半山阴。\n相逢拟就汤休宿，古钵分泉洗渴心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34773,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"六月三日登净寺望西湖","author":"刘大夏","text":"谁将西子比西湖，此日凭栏一吊苏。\n楼外江山依旧在，湖中歌舞几时无。\n自怜白发千茎短，徒有丹心一寸孤。\n归去九重如赐问，萧条今日在三吴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34774,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送人还江西","author":"刘大夏","text":"黄金台下唱骊驹，送客南归万里馀。\n一命未沾天子泽，满囊空载古人书。\n暖侵山雪新晴后，春入江梅欲绽初。\n宦况何如家食好，白云飞处是匡庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34775,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和李宾之再游西山韵","author":"刘大夏","text":"匹马迎风㧕外嘶，停鞭私语换前题。\n千年故事怀江左，一路青山似镐西。\n此地传闻曾见虏，何人谈笑合封齐。\n感时无限伤春意，潦倒都因醉后迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34776,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乙巳二月在闽雨中度福安县大岭","author":"刘大夏","text":"青春作客几经年，白发犹怜未息肩。\n领得丝纶来远峤，不辞风雨度危巅。\n半空云锁浑无地，一径人通直有天。\n闻道前途山更险，及时须着祖生鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34777,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游闽中玄妙寺晚归偶成奉同行徐沈二公","author":"刘大夏","text":"清时作宦得閒游，更喜祗园景物幽。\n山色连云迷晓径，松声绕涧杂寒流。\n层台回首诸天近，半日凭栏百念休。\n薄暮归来心更乐，离离禾黍万家秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34778,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山居偶成","author":"刘大夏","text":"重阴绕屋蔽晴晖，独卧东庵半掩扉。\n日似小年人事简，风如太古世情稀。\n石田有稻供蔬食，野径无尘染素衣。\n一段山居多少趣，临风几度倦高飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34779,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠李西涯","author":"刘大夏","text":"蚤年书剑客京师，愧以疏慵辱子知。\n龙榜已欣曾并举，凤池犹幸重相随。\n交游满眼还谁厚，尔汝忘形有宿期。\n总道玄都盛桃李，东风宁肯弃残枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34780,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赴广东过东平马上因简萧九鼎","author":"刘大夏","text":"奉命南来十二程，风光感目不胜情。\n几家桑梓编新户，何处松楸蔽旧茔。\n问俗独怜今日异，留田敢废后人耕。\n相逢莫道悠悠者，牧守如今是弟兄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34781,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南宁遇冬至雨中有感呈同事二王公","author":"刘大夏","text":"风雨凄凄客思凉，况逢冬至在殊方。\n愁看瘴岭遮天短，独拥寒衾觉夜长。\n地杂夷情休问俗，庭无官事懒升堂。\n醇醪幸接周公瑾，百感伤怀总欲忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34782,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻从者谈邕州土俗柬王佥宪","author":"刘大夏","text":"邕州壤地接交南，凄楚夷风不忍谈。\n男女歌谣成卺礼，官民尔汝集茅庵。\n瘴来山谷云应黑，毒入溪河水尽蓝。\n漂泊独怜吴楚客，故园回首意何堪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34783,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"往香山海上","author":"刘大夏","text":"烟波沧海九衢尘，北去南来笑此身。\n清世自惭无补地，白头犹作未归人。\n故乡儿女多荒废，仕路交游半隐沦。\n洛社诗成何日事，楚江西畔觅香莼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34784,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次西涯学士饯衍圣公作","author":"刘大夏","text":"欹枕秋风负胜招，群仙遥忆下烟霄。\n红螺醮甲金波重，宝鸭迎风玉篆消。\n古锦奚囊推贺笔，清时吏隐笑由瓢。\n山花与主新名字，老我吟成侑酒谣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34785,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题孙懋仁沱西别业","author":"刘大夏","text":"临沱新作辋川庄，乔木牵萝接草堂。\n山势东环云泽远，水源西出汉江长。\n秀钟人物滋三世，清绕门栏擅一方。\n君实归来须入社，黄花酿酒日闻香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34786,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿新乐县寿圣寺壁间有唐人早朝诗依韵写怀","author":"刘大夏","text":"早窃湖南第一筹，时承蟒玉宠光优。\n八千里外充行伍，四五年前别冕旒。\n捧檄丹心怜我拙，乘桴沧海共谁忧。\n逢人若问停车处，直到关西最尽头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34787,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过六盘山遇雪寄西涯阁老","author":"刘大夏","text":"平生自顾百年间，九分驱驰一分閒。\n绿野误违三品地，白头今到六盘山。\n冰行雪渡知前定，运去年衰值后艰。\n寄语同年老知己，天涯孤客几时还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34788,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蓝州渡河孙守备领兵护行","author":"刘大夏","text":"界限山河汉与胡，生成天险卫秦都。\n初经边塞劳军送，老步冰桥倩客扶。\n故老千年思蹇叔，长城万里惜扶苏。\n不知鹿走坑儒事，更有何人诫后车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34789,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"俞佥宪报京师信息","author":"刘大夏","text":"老年飘泊在天涯，番汉丛中信作家。\n塞下风寒愁戌火，城头日暮惨悲笳。\n山溪险阻来时路，江汉微茫梦里槎。\n故旧乘骢来又别，殷勤为我报京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34790,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"端午日感怀","author":"刘大夏","text":"东望乡关各一天，闭门閒坐思悠然。\n时催节候临端午，地尽江山到醴泉。\n往岁忧劳浑是梦，老年眈静似成仙。\n感怀吟罢无他事，祝颂君王有万年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34791,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"彰德别叶庭荗","author":"刘大夏","text":"临岐莫厌酒杯深，此去何年更盍簪。\n秋塞比来多便雁，殷勤时慰故人心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34792,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题杨参将出征","author":"刘大夏","text":"甲胄森严意气豪，马头威振阵云高。\n戎王胆落天山外，鼠首穹庐望羽旄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34793,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自题衣冠乘马小像","author":"刘大夏","text":"博带乌纱步骤迟，风流不似阵前时。\n将军岂是乖戎略，要使边人识汉仪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34794,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谪回东莆田林都宪","author":"刘大夏","text":"到处烽烟警客肠，津头幸有济舟航。\n暮云春树怀人处，独倚春风醉晚觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34795,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戌中故旧无来见独严仲洪赠诗和之","author":"刘大夏","text":"老冒风尘万里行，蒲轮今日出都城。\n独怜陌上王孙草，一任寒霜不世情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34796,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄谢浙江陈都阃","author":"刘大夏","text":"荷戈老出玉门关，圣主恩深又许还。\n独感多情陈阃使，音书频问到东山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34797,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宫词","author":"李麟","text":"青春閒里过，华发暗中催。\n往事俱流水，初心未死灰。\n御炉香缥缈，宫扇影徘徊。\n脉脉停针久，銮舆幸倘来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34798,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和李商隐无题 其一","author":"李麟","text":"花落萧墙别院风，眼看漂泊水流东。\n有怀团扇缄题在，无计长门买赋通。\n翡翠梦衾春草绿，守宫愁臂夜灯红。\n十年怕见青铜面，肯信云鬟半欲蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34799,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和李商隐无题 其二","author":"李麟","text":"心事无凭欲话难，几经憔悴怕灯残。\n东风蝶粉春犹涩，西日蜗濡露易乾。\n梦断银河铜漏滴，愁回金屋锁窗寒。\n临鸾敢谓婵娟误，宫样眉妆八字看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34800,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"牧羊图","author":"李麟","text":"万死间关抗虏尘，廿年北海未亡身。\n牧羊不羡弥山富，仗节惟拚齧雪贫。\n已分此生甘苜蓿，岂知他日画麒麟。\n河梁相向䧏奴泣，白发怜看汉老臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34801,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东原为王廷直赋","author":"李麟","text":"越山迢递接蓬莱，山下平原一径开。\n树绕江流天外尽，鸟分云影日边来。\n东风道路迷芳草，残雪溪桥见野梅。\n安石未应高卧久，天涯回首独怜才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34802,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杨柳枝词 其一","author":"李麟","text":"淡烟笼日影婆娑，露叶曾经步辇过。\n咫尺宫墙看不见，年年长是别离多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34803,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杨柳枝词 其二","author":"李麟","text":"帘捲青青水殿凉，晓妆随手斗眉长。\n含颦待与君王折，一月看花到上阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34804,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿怀化驿题壁","author":"薛纲","text":"朝从辰溪来，暮抵怀化宿。\n奔驰百里途，祗慱三升粟。\n尝求古人心，谋道不谋禄。\n我非行道具，往来徒碌碌。\n九年不徙官，扬雄老且秃。\n归草太玄经，郊居掩花竹。\n功名适意休，美味染指足。\n题诗谢山灵，兹游恐不续。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34805,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登黄鹤楼","author":"薛纲","text":"凭栏瞰碧流，拍手招黄鹤。\n黄鹤去不来，白云满城郭。\n怅望鹦鹉洲，狂生不可作。\n曹瞒尚忌才，黄祖奚堪托。\n文高竟杀身，身后名寂寞。\n祗遗旧江山，千载恒如昨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34806,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题萧彦祥四景画二首 其一","author":"薛纲","text":"昨夜东风入幽谷，春草生香春树绿。\n茅檐星散八九家，中有先生读书屋。\n读书偏于静处宜，白云堆里长吾伊。\n只恐鸣驺陡然至，好山却被英灵移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34807,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题萧彦祥四景画二首 其二","author":"薛纲","text":"黄菊花开黄叶飞，柴桑先生犹未归。\n蕙帐风高夜鹤怨，石梁水浅寒鱼肥。\n我亦天涯倦游客，对景徒为增叹息。\n何由卜得柴桑邻，稳坐溪头钓晴碧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34808,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜思归寄乡友孙廷振","author":"薛纲","text":"江汉思家客，秋来倍寂寥。\n碧山虽不负，白发肯相饶。\n贫恋无功禄，官惭有道朝。\n徒然羡冥鹄，风翮任逍遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34809,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿慈利布政分司爱其北窗山水之胜题诗于壁","author":"薛纲","text":"县境烟霞表，薇垣紫翠间。\n览穷南楚胜，爱杀北窗閒。\n乱石长鸣水，低墙不碍山。\n休官堪吏隐，地与庙堂关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34810,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"石门至澧州舟中作","author":"薛纲","text":"水从天际落，舟破镜中来。\n古庙千年树，清溪两岸苔。\n豸冠兼吏隐，鸥鸟亦疑猜。\n再到知无日，东归买钓台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34811,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题山塘驿壁","author":"薛纲","text":"辰溪三十里，乘晓到山塘。\n瘦马千峰雪，征人两鬓霜。\n路如斜谷险，梅似故园香。\n岁暮不归去，閒云笑我忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34812,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"思归","author":"薛纲","text":"游宦几同星，浮踪一叶萍。\n家贫羞恋禄，年老厌谈经。\n客鬓愁边白，乡山梦里青。\n何时镜湖曲，结取狎鸥亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34813,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吊汨罗江","author":"薛纲","text":"宗臣义与国同休，谁谓先生可九州。\n死恨张仪曾相楚，生惭微子独归周。\n两间正气沉湘骨，千载人心竞渡舟。\n欲吊忠魂何处所，寒泉一勺奠中流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34814,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄越中社友","author":"薛纲","text":"浮萍踪迹倦西东，愁挂湖湘一席风。\n客鬓潇疏波影里，乡心摇曳橹声中。\n清宵有梦迷庄蝶，远地无书托楚鸿。\n忽忆镜湖诗酒会，飞觞联句几人同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34815,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送莫同知还吴江","author":"薛纲","text":"十年前已识韩荆，今日相逢眼倍明。\n黑鬓挂冠高世见，沧江对酒故交情。\n鸾凰不寄人间迹，鸥鹭还寻物外盟。\n举俗好名君好隐，三吴风月更谁争。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34816,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿远安县清溪寺","author":"薛纲","text":"谁信清溪别有天，上方台殿下方连。\n红尘不混金沙地，碧涧长流玉液泉。\n一榻茶烟浮鬓外，四窗山色落吟边。\n年年王事经游此，肯结三生石上缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34817,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿宝泉寺","author":"薛纲","text":"元社丘墟已百年，梵王宫殿景依然。\n层层古铁山头塔，滴滴真珠涧底泉。\n僧老犹能谈往事，予来不是爱逃禅。\n填胸俗虑无由遣，借得云窝一夜眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34818,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送林允吉少参督运金州","author":"薛纲","text":"职在湖藩却入秦，祗缘王事属王臣。\n襄郧有限桃花水，关陇无穷菜色民。\n万斛香粳舟载玉，一团生意律回春。\n凭君致语诸民牧，自此边储务积陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34819,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"潇湘秋水","author":"薛纲","text":"薄宦驱驰厌四方，老怀偏独恋潇湘。\n一江秋色雨新足，万顷晴光天共长。\n回雁峰高清照影，采蘋舟散暗浮香。\n何当为结临流屋，汲取寒涓浣热肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34820,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"炎陵古木","author":"薛纲","text":"炎帝坟陵何处寻，曾凭火梦得荒林。\n万年白骨惟尘土，百尺青杉自古今。\n守护山灵阴有意，往来樵斧寂无侵。\n神功圣德昭无极，斯邑斯民仰更深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34821,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柏沟涵碧","author":"薛纲","text":"人说崇冈直万金，环冈左右柏沟深。\n四时景色相辉映，一派清流自古今。\n晴爱落花浮水面，晚宜明月到天心。\n沧洲旧主乌台客，鹭社鸥盟未许寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34822,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鼓楼回照","author":"薛纲","text":"何处青山最可情，鼓楼宜晚亦宜晴。\n峰衔落日半轮在，叶漏残阳几树明。\n鸦背分来金闪烁，雁行飞度字纵横。\n能诗独数青莲裔，好景相望咏不成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34823,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"牛首晓钟","author":"薛纲","text":"牛头山寺最知名，百尺层楼挂海鲸。\n嘹喨洪音敲月早，悠扬馀韵出花清。\n惊回老鹤游仙梦，引起寒鸡唱晓声。\n却忆长安候朝处，天风吹佩入端明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34824,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄世昌王先生复用前韵","author":"薛纲","text":"最爱荆山郢水雄，徜徉山水得相从。\n久知龙非池中物，暂喜鸿留雪里踪。\n诗就劳公投白璧，缶鸣容我次黄钟。\n于今咫尺成胡越，何况天门隔九重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34825,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚翠冈","author":"薛纲","text":"谁把松杉植满冈，岁寒时节独苍苍。\n总无桃李胭脂色，自有冰霜铁石肠。\n密叶淡笼秋后翠，清阴长送午前凉。\n主人旧订同心约，壁立薇垣老未忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34826,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"房陵道中","author":"薛纲","text":"山外青山关外关，重重天险倦跻攀。\n十盘峰影浮云上，八渡泉声乱石间。\n草满畬田烧后黑，苔侵崖树雨馀斑。\n架岩多少流居者，独恋殊风忘却还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34827,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游君山","author":"薛纲","text":"湖上看山认未真，登山方见翠嶙峋。\n对城相去无多路，破浪能来有几人。\n镜里楼台千古寺，鸥边花木四时春。\n兴阑又复登舟去，回首烟螺隔世尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34828,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"临湘舟中有怀孔儒太守李承恩进士三昆季","author":"薛纲","text":"朝离沙羡暮临湘，万种新愁七泽长。\n泛泛世情凫逐浪，飘飘身计雁随阳。\n沽来竹叶不成醉，采得蘋花空自香。\n却忆相知阻相见，溯游宛在水中央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":34829,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]