[{"title":"送余子华归省","author":"孙承恩","text":"诏许宁亲去，争看太史归。\n春深花雾重，寒退柳风微。\n越岭茶堪摘，姚江鳜正肥。\n因君动余兴，夜夜梦班衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"使交过嘉兴舟中对雨","author":"孙承恩","text":"雨上群山暝，云深万木稠。\n横斜飞迥野，飒爽送高秋。\n弭节依萧寺，孤吟倚舵楼。\n故园犹咫尺，早巳动离愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游龙渊寺二首 其一","author":"孙承恩","text":"蹑屐此登临，云关深更深。\n佛香霏雾气，僧呗殷潮音。\n竹院浮空翠，松窗积暝阴。\n世途吾亦厌，欲此学安心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游龙渊寺二首 其二","author":"孙承恩","text":"徙倚禅林胜，瞻依佛界宽。\n雨花飘石座，幡影落松坛。\n地迥红尘隔，云阴碧殿寒。\n一泓杳深黑，疑是有龙蟠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重游沈氏山庄四首 其一","author":"孙承恩","text":"弭节追嘉会，留欢惜此筵。\n投壶青障里，洗盏白云边。\n东道千金意，皇华万里船。\n题诗不尽兴，把笔看秋天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重游沈氏山庄四首 其二","author":"孙承恩","text":"旧艇仍同泛，名山得再窥。\n野塘添活水，脩竹更新枝。\n仆喜曾来客，篇题未了诗。\n明朝复成别，沉醉不须辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重游沈氏山庄四首 其三","author":"孙承恩","text":"径熟登应便，苔深步屡惊。\n山灵知旧客，天意与新晴。\n空翠沾衣润，幽花照眼明。\n忽思张柱史，慷慨百年情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重游沈氏山庄四首 其四","author":"孙承恩","text":"薄与山灵素，重来续旧缘。\n深岩栖宿雾，曲涧咽飞泉。\n不计觞行急，从教帽影偏。\n醉中浑忘我，随意舞风前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石屋次韵","author":"孙承恩","text":"石屋何年凿，秋风此度来。\n空明通日月，苍翠叠莓苔。\n元气蒸常湿，烟霏锁不开。\n何当傍幽胜，随意筑琴台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"螺川与杜元吉话旧二首 其一","author":"孙承恩","text":"九日江波上，一杯逢故人。\n清时无藻鉴，沧海有遗珍。\n惜会频催饮，临风漫正巾。\n王程还此别，回首隔云津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"螺川与杜元吉话旧二首 其二","author":"孙承恩","text":"几载交游隔，兹晨笑语同。\n清樽酬令节，彩鹢共秋风。\n道谊襟怀里，乾坤感慨中。\n独怜鸡黍约，有日更从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚泊","author":"孙承恩","text":"野屋平临岸，江流曲抱城。\n星移拖水白，月近接沙明。\n梦杳青山隔，愁多白发生。\n灯前闻戍鼓，独坐正含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江夜","author":"孙承恩","text":"月出四山静，江空独鸟飞。\n远汀渔火暗，茅屋住人稀。\n病体愁冲险，中年志息机。\n秋风吹日夕，老却故山嶶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36632,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江舟对月","author":"孙承恩","text":"静夜瞻明月，孤唫怆客神。\n独怜蟾窟地，能照白头人。\n细草虫鸣近，深林鹊啭频。\n明朝清镜里，霜鬓又添新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36633,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至梧州","author":"孙承恩","text":"的的炎荒路，苍梧云物幽。\n孤城淡斜日，叠嶂肃高秋。\n鲛室光常秘，龙洲水自浮。\n兵戈闻处处，感事重添愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36634,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游韩太监山园小酌二首 其一","author":"孙承恩","text":"宫监园亭好，天开枕翠微。\n境宽鱼鸟乐，地僻吏人稀。\n细草薰苔径，寒花照竹扉。\n无端幽意动，惆怅故山薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36635,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游韩太监山园小酌二首 其二","author":"孙承恩","text":"清宴随飞盖，长筵对碧岑。\n徵歌鱼出沼，选射鹿惊林。\n樽斝花香度，帘笼树色深。\n无因长借榻，有约更窥临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36636,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忠州道中","author":"孙承恩","text":"晨发瞻长路，苍凉映晓暾。\n寒藤萦古木，野竹翳荒村。\n径合黄茅盛，山连碧雾昏。\n垂堂宁敢论，去去任乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙州候信不至","author":"孙承恩","text":"王事何缘毕，乡心动欲飞。\n只将挨白日，唫到几斜晖。\n事变看常错，人谋每自违。\n愁来损眠食，应减带腰围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题仙岩","author":"孙承恩","text":"峭壁开青嶂，幽居锁翠微。\n玄猿将子挂，苍隼引雏飞。\n神斧曾经凿，仙人杳不归。\n惟馀一片月，终古自依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙岩二首 其一","author":"孙承恩","text":"山郭行厨近，平原小队齐。\n頫窥临石屋，飞步忆丹梯。\n日薄烟光暝，天垂树影低。\n寻幽豁羁思，吟倚更凄迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙岩二首 其二","author":"孙承恩","text":"空洞含阴雾，虚明漏远天。\n扳游偶今日，开凿自何年。\n逸兴飞云外，遐思邃古前。\n夕阳还命驾，乌帽受风偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归途至南宁喜见二仆三首 其一","author":"孙承恩","text":"岭表将归日，天涯欲尽年。\n偶于童仆遇，翻成儿女怜。\n望杳青山外，心驰白雁前。\n中年颇恇怯，触事易凄然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归途至南宁喜见二仆三首 其二","author":"孙承恩","text":"已是临归日，何堪见汝曹。\n羁栖怜若病，行役问吾劳。\n滩束江声急，山藏瘴雾高。\n故乡犹隔远，离思转滔滔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归途至南宁喜见二仆三首 其三","author":"孙承恩","text":"幸喜多安稳，聊将慰客途。\n入舟翻自失，对酒更频呼。\n骨肉凭谁讯，鳞鸿有到无。\n白云瞻不极，清泪落江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阻风同邓太守子几小酌崇礼舟中","author":"孙承恩","text":"野旷饶风色，江空阁使槎。\n一樽聊此会，万里共天涯。\n局覆谁应伯，枭成各自誇。\n腐儒浑不解，袖手看君哗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟行复值风","author":"孙承恩","text":"白日行将晚，沧江流正深。\n风声动地至，云物接天阴。\n牢落孤舟梦，飞腾故国心。\n今宵何处泊，莫近有猿吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36646,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠吴参戎四首 其一","author":"孙承恩","text":"岭表三冬使，沧江万里槎。\n幸逢贤地主，聊复慰天涯。\n方叔周心膂，嫖姚汉爪牙。\n羡君多将略，随处向人誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36647,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠吴参戎四首 其二","author":"孙承恩","text":"南国威名旧，朝庭简命专。\n殊方人绘像，素节士称贤。\n拂剑风生锷，弯弓月满弦。\n军中多暇豫，亦不废诗篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36648,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠吴参戎四首 其三","author":"孙承恩","text":"山郭笼寒雾，江波浴远天。\n长风雄鼓角，斜日送楼船。\n文事将军解，名家武略专。\n相期树勋业，博取汉貂蝉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36649,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠吴参戎四首 其四","author":"孙承恩","text":"岭海吾行远，风尘道未休。\n疮痍方日甚，武略更谁优。\n慷慨捐躯志，从容应敌谋。\n去将铜柱洗，来伴赤松游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36650,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"季冬重游韩太监山园二首 其一","author":"孙承恩","text":"使节兹仍驻，名园喜再过。\n入山黄叶满，贮屋白云多。\n水静鱼深隐，林空鸟不歌。\n重来知莫遂，回首意如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36651,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"季冬重游韩太监山园二首 其二","author":"孙承恩","text":"有暇还寻胜，无庸问报书。\n题诗不尽兴，刺眼尚如初。\n地主仪文备，儒生礼法疏。\n祗将连日会，摘尽一园蔬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36652,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与蒋舜咨夜宴话别二首 其一","author":"孙承恩","text":"吏散庭除静，筵开笑语亲。\n不嫌通夕话，俱是异乡人。\n岁月空双鬓，高深独此身。\n相期树勋业，岭海正风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36653,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与蒋舜咨夜宴话别二首 其二","author":"孙承恩","text":"文饮樽频阁，清谈语不哗。\n高楼传戍鼓，瑶席散灯花。\n寒日他乡梦，春风海上槎。\n萍蓬无定所，相忆又天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36654,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别舜咨二首 其一","author":"孙承恩","text":"万里家山兴，兼旬故旧欢。\n轺车君暂住，使节我当还。\n王事有离索，天涯须勉餐。\n高堂垂白在，为子报平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36655,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别舜咨二首 其二","author":"孙承恩","text":"幸喜逢南国，愁看赋北梁。\n江湖催日景，原野媚烟光。\n藩省专民社，贤科得俊良。\n莫嗟久借寇，会见早徵黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36656,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭都谏俞崇礼三首 其一","author":"孙承恩","text":"向晓从容话，俄惊生死分。\n牵衣频顾我，忍哭更呼君。\n书剑亲孤榇，精灵结暝云。\n无言向僮仆，衰泪落纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36657,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭都谏俞崇礼三首 其二","author":"孙承恩","text":"契阔无终日，颠危实异乡。\n皇天生变故，白日照苍黄。\n谊切幽冥隔，魂归山水长。\n病躯那值此，顾影独神伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36658,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭都谏俞崇礼三首 其三","author":"孙承恩","text":"王事驰驱久，间关岭表行。\n才猷当首让，冰檗共心盟。\n似子堪人物，于今失俊英。\n临棺寄一恸，岂独友于情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36659,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"发梧州","author":"孙承恩","text":"移棹青山动，扬舲沙鸟鸣。\n诸公劳祖席，万里快归程。\n天与微躯健，囊知使节清。\n夕阳重回首，烟雾隔孤城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36660,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中对雨二首 其一","author":"孙承恩","text":"旧雨连今雨，江云接岭云。\n冥冥看转密，漠漠认难分。\n汉节归无恙，乡书杳不闻。\n推篷试孤酌，容易得微醺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36661,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中对雨二首 其二","author":"孙承恩","text":"密雨声犹续，高天黯不开。\n忽看横野去，还作蔽江来。\n水鸟拂舟健，溪猿啸侣哀。\n客愁多寂寞，北望正悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36662,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中有怀三府却寄二首 其一","author":"孙承恩","text":"展席劳扳饯，持觞愧屡辞。\n醉来浑忘别，醒去漫能思。\n清夜筹添后，蓬窗雨到时。\n此身萍梗似，回首益凄其。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36663,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中有怀三府却寄二首 其二","author":"孙承恩","text":"喜托兼旬爱，真成万里违。\n不堪怀别恨，赖是故乡归。\n目极连山阻，帆开带雨飞。\n平生苦情累，几日重依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36664,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中夜雨","author":"孙承恩","text":"淅沥何曾住，孤舟寒气侵。\n只将一夜雨，滴碎百年心。\n不寐频欹枕，呼童更揽衾。\n朝来江水长，应没旧痕深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阻风二首 其一","author":"孙承恩","text":"浩浩北风疾，阴阴春日寒。\n孤舟溯逆浪，百丈曳高滩。\n转觉归心切，空嗟行路难。\n白云遥引领，当食不能餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阻风二首 其二","author":"孙承恩","text":"朔吹翻波汹，孤舟坐浪欹。\n客情空黯黯，雨意欲垂垂。\n诗句删唫后，炉薰打坐时。\n天涯喜归去，不敢怨迟迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠鸥江徐老先生四首 其一","author":"孙承恩","text":"暂弭皇华节，来过君子乡。\n龙门惊倒屐，草阁共焚香。\n世服投閒早，天教阅岁长。\n只应高隐地，白发照沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠鸥江徐老先生四首 其二","author":"孙承恩","text":"喜见桑榆日，乡推齿德尊。\n岂知萍梗地，得奉笑言温。\n蒙养恩犹昔，通家谊更敦。\n因公多恻怆，风木暗消魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠鸥江徐老先生四首 其三","author":"孙承恩","text":"童子抠趋日，先公道谊俱。\n凄凉嗟岁远，福祉似公无。\n逸思还堪赋，高年不用扶。\n独惭浅薄者，酬德志犹孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36670,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠鸥江徐老先生四首 其四","author":"孙承恩","text":"问讯经年约，登堂此日欢。\n清言喜新得，往事动长叹。\n江阔浮孤屿，春阴生薄寒。\n重逢浑未卜，再拜别公难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36671,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重会杜元吉昆玉二首 其一","author":"孙承恩","text":"鸡黍经时约，皇华此日旋。\n追陪荷高谊，离合固多缘。\n清话淹终夕，明河落远川。\n不堪谈往事，二十九年前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36672,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重会杜元吉昆玉二首 其二","author":"孙承恩","text":"京国同门日，天涯话旧时。\n故交怜久别，浮世叹多岐。\n浅薄惭非分，飞腾自有期。\n勉旃崇德业，候子凤凰池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36673,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠吴黄洲五首 其一","author":"孙承恩","text":"忆自公归后，吾人切去思。\n即看今日论，已断百年期。\n贤哲谁无毁，行藏更弗疑。\n受知惭浅薄，未有答恩私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36674,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠吴黄洲五首 其二","author":"孙承恩","text":"欲识黄洲贵，今看孰与同。\n谁能于宦满，犹只似儒穷。\n天道终当定，人言久自公。\n英标看骥子，会拟振家风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36675,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠吴黄洲五首 其三","author":"孙承恩","text":"为问黄洲隐，何惭绿野贤。\n閒情渺烟水，高兴薄云天。\n道在宁论贵，身轻即是仙。\n曾闻极玄思，注得卫生篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36676,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠吴黄洲五首 其四","author":"孙承恩","text":"浩荡黄洲上，超然谢世喧。\n水禽时近榻，俗客不过门。\n憩石云生袂，唫诗月满樽。\n浮荣亦何有，勘破底须论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36677,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠吴黄洲五首 其五","author":"孙承恩","text":"久别情何极，相逢话独长。\n世途嗟蜀道，心事付沧浪。\n问我幽栖地，添奇水石旁。\n无由得公去，重醉旧茅堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36678,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别黄洲二首 其一","author":"孙承恩","text":"孤楫清江渚，离筵落照边。\n一樽同笑咏，明日隔山川。\n契谊看如此，愁怀益渺然。\n无由慰瞻溯，时望寄诗篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36679,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别黄洲二首 其二","author":"孙承恩","text":"把盏春风动，唫诗白雪香。\n归心迷故国，别意满河梁。\n后会浑难卜，骊歌不厌长。\n心知无近远，底事重徬徨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36680,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"常山喜得家信三首 其一","author":"孙承恩","text":"此日逢家信，千金喜更真。\n客瞻异乡月，人别故园春。\n安稳无馀望，康强有老亲。\n拳拳寸草意，感激戴苍旻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36681,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"常山喜得家信三首 其二","author":"孙承恩","text":"幸有平安慰，兼云得两儿。\n抱惭非孔释，梦巳恊熊罴。\n天意将无定，吾年巳渐衰。\n宗祧百年事，抚已重嗟咨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36682,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"常山喜得家信三首 其三","author":"孙承恩","text":"失学怜儿辈，临缄意不无。\n即看语造次，讵有苦工夫。\n春雨招梅友，秋风聘橘奴。\n小园多干当，幸不至荒芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36683,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过嘉兴","author":"孙承恩","text":"望入吴山水，乡音听渐真。\n天涯空岁月，脚底几风尘。\n桑梓人情好，莺花客意新。\n男儿讵怀土，堂上白头亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36684,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"抵家杂诗四首 其一","author":"孙承恩","text":"解装谢长路，及门当晚春。\n风光浑自喜，花鸟似相亲。\n慰讯州司厚，过从父老真。\n山川多历览，时或诧乡人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36685,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"抵家杂诗四首 其二","author":"孙承恩","text":"跋涉巳云毕，低回不自禁。\n更因归日喜，还忆去时心。\n毫末真无补，高深实有临。\n老亲多慰藉，添得二毛侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36686,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"抵家杂诗四首 其三","author":"孙承恩","text":"小圃多新思，苔阶觅旧踪。\n胸中富万壑，眼底失孤峰。\n兴动王孙草，诗哦处士松。\n更怜茅屋角，添得竹阴浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36687,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"抵家杂诗四首 其四","author":"孙承恩","text":"徙倚当春晚，行唫步翠苔。\n犹思曩日别，不道隔年回。\n柳及时新插，桃经手旧栽。\n似怜主人出，迟得数枝开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36688,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]