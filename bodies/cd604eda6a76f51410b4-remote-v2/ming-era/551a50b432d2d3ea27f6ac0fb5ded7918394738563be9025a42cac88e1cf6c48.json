[{"title":"送张汝州","author":"郑善夫","text":"汝水元依洛，嵩山直配天。\n今君簿领去，兼结水山缘。\n世路黄尘里，官曹紫逻边。\n谁能废组绶，跨鹤去翩翩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19554,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陈思献赴金陵","author":"郑善夫","text":"昔慕蔡夫子，今知陈使君。\n深居避矰弋，用志到羲文。\n却向金台别，翻将宝剑分。\n秣陵依隐地，养拙幸相闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19555,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"河陇","author":"郑善夫","text":"河陇时多事，兵车岁几奔。\n犹闻遣太仆，长计向军门。\n羌羯方酣战，骅骝尽不存。\n西归报天子，已到渥洼源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19556,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西山杂诗三首 其一","author":"郑善夫","text":"春尽一到此，散愁幽意繁。\n西湖草已绿，南国桂应蕃。\n宫殿浮今日，山河控北门。\n时艰羡飞锡，来往给孤园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19557,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西山杂诗三首 其二","author":"郑善夫","text":"昔日西湖钓，宣皇游幸来。\n至今鲛室里，彷佛锦云开。\n岁月芙蓉殿，关山龙虎台。\n东巡志更远，谁挽八鸾回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19558,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西山杂诗三首 其三","author":"郑善夫","text":"西山五百寺，多傍北邙岑。\n土木春岩尽，楼台海雾深。\n僧皆传玉食，地更垒黄金。\n纵目翻愁极，长安岁岁阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19559,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送洪南安","author":"郑善夫","text":"平生洪大理，朴直古人心。\n执法汉庭上，春风吹六阴。\n一麾横浦去，相失庾山深。\n他日逢梅使，听歌行路吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19560,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"伍中丞拟归田索题","author":"郑善夫","text":"伍公江海思，鱼鸟久相安。\n拟逐鸱夷去，翻怜铁豸冠。\n萝云药圃细，竹月锦堂寒。\n矍铄风尘里，忧时且㨿鞍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19561,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"周公器弘治初为庆符令赋诗追忆之","author":"郑善夫","text":"周君为邑日，江汉尽桑麻。\n帝力谁知识，长安无狭斜。\n但将九溪水，频灌庆符花。\n遥想弹琴处，南风吹未涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19562,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"余侍御珊喜湖","author":"郑善夫","text":"柱史湖边宅，柴扉开皖峰。\n晴天回鹳鹤，暮水迥鱼龙。\n芰服身偏稳，渔竿意可慵。\n眼中秋浩荡，为尔咏芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19563,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西山杂诗","author":"郑善夫","text":"落日春湖上，烟波正渺茫。\n衣冠非敢倚，鱼鸟坐相忘。\n痛饮还山简，招携有葛疆。\n濯缨计未得，意气总沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19564,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送人归渤海","author":"郑善夫","text":"尔去秦台上，秦台秋正繁。\n城深渤海郡，草歇乐陵原。\n蓬阁风云至，若华波浪翻。\n看君有道气，早晚共腾骞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19565,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送人之宣州二首 其一","author":"郑善夫","text":"白也风流处，云山满意幽。\n兹为宛水隐，况得敬亭游。\n桃李含清夜，梧桐下素秋。\n澄江净何日，转忆谢宣州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19566,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送人之宣州二首 其二","author":"郑善夫","text":"宣城仙圣地，山水作名州。\n石控琴高鲤，江深谢眺楼。\n白龙降已久，黄鹤唤何由。\n尔去乘云月，飘飘过十洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19567,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送屠文治侍御使苍梧","author":"郑善夫","text":"衰䬃仍乖别，羁栖几过从。\n驽骀无熟路，鹰隼自秋空。\n铜柱扶桑下，郁林沧海东。\n南征且乡邑，大不类秋蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19568,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"张子言家移旋覆草","author":"郑善夫","text":"旋覆知名草，秋斋不住花。\n群芳尽摇落，此地且年华。\n坐领幽人意，行辞处士家。\n相看到霜雪，采掇辅丹沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19569,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吾邦","author":"郑善夫","text":"丧乱秋风起，吾邦尔独回。\n徒伤羁鸟赋，不见钓龙台。\n少谷芝仍茁，南昌角正哀。\n建安七子下，流落仲宣才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19570,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送蒋君佩视弟还谯","author":"郑善夫","text":"太丘二令子，伯也是难兄。\n枥下垂骐骥，原头过鹡鸰。\n燕关共卧后，亳社独归情。\n万国今戎马，愁云日夜停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19571,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"屏息","author":"郑善夫","text":"屏息经纶志，栖迟阊阖云。\n风尘蒙不解，龙虎乱相闻。\n秪有还山梦，空馀谏猎文。\n长缨系越颈，感激汉终军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19572,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"薛君采见过","author":"郑善夫","text":"薛稷过逢日，新诗向我传。\n聊炊太仓米，一诵陜郊篇。\n薄宦虚谈剑，危时合引年。\n秋风下沧海，掷置广文毡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19573,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题虎溪三笑图","author":"郑善夫","text":"东林卓锡地，宛在昆崙西。\n莲社谁堪入，庐峰不可梯。\n一空无色相，三笑岂菩提。\n便合攒眉去，酕醄过虎溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19574,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送林以乘谪夷陵二首 其一","author":"郑善夫","text":"宜都三峡口，迁客意如何。\n落日黄陵庙，秋风骇浪多。\n巴蛮伐鼓祭，江女踏蹄歌。\n莫唱渝州曲，猿声近汨罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19575,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送林以乘谪夷陵二首 其二","author":"郑善夫","text":"水部青云志，忧君双鬓斑。\n同时谏羽猎，独尔窜荆蛮。\n波撼黄牛峡，天连白虎关。\n栖迟下客食，直以长瑜还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19576,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋月","author":"郑善夫","text":"秋月长安社，光清太液池。\n蟾蜍终不灭，乌鹊竟何之。\n铁骑喧今夜，金波及四夷。\n关山正阻绝，却向篴中吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19577,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"思道约游西山病不赴漫答兼问宗林二首 其一","author":"郑善夫","text":"嗟尔棠陵客，乖期秋独归。\n香山有夙诺，幽事忽相违。\n木石机心损，云霞朔气微。\n时时梦鱼鸟，未返薜萝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19578,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"思道约游西山病不赴漫答兼问宗林二首 其二","author":"郑善夫","text":"昔游湖上寺，犹记释宗林。\n语我菩提树，恒河深复深。\n风沙晚识面，江海后知音。\n白鹤翩翩去，青天何处寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19579,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十日对酒姚氏园二首 其一","author":"郑善夫","text":"野老经时病，深秋出郭情。\n辋川聊对酒，京洛未离荣。\n小水行丹壑，馀花藉绮楹。\n松阴立不倦，何限暮涛声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19580,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十日对酒姚氏园二首 其二","author":"郑善夫","text":"病跨山公马，秋过习氏池。\n远天鸿雁尽，昨日菊花期。\n棋局翻相恼，鸥群总不疑。\n生涯抱瓮外，一任隐君为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19581,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"上毗卢阁二首 其一","author":"郑善夫","text":"远上毗卢阁，崇高望不稀。\n关山仍此地，城阙自斜晖。\n羽檄流星过，行营万马围。\n渔阳暮色至，引领翠华归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19582,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"上毗卢阁二首 其二","author":"郑善夫","text":"阁迥临虚旷，秋高入渺茫。\n燕歌动易水，骏骨望昭王。\n日落城笳起，天寒塞草黄。\n扬雄辍扈从，空自赋长杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19583,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"城戍","author":"郑善夫","text":"戍鼓长鸣夜，军容更入朝。\n北风尘漠漠，南讨意迢迢。\n秋有苍梧狩，能无黄泽谣。\n遐方尽玉帛，八骏自应骄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19584,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陈执之宅同诸君酌菊二首 其一","author":"郑善夫","text":"秪抱霜雪姿，风沙怅独悲。\n亲朋更此地，酩酊对花枝。\n栗里归心远，潇湘秋事迟。\n东君不相识，只自向华滋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19585,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陈执之宅同诸君酌菊二首 其二","author":"郑善夫","text":"绣衣都下宅，丛菊好花枝。\n延客尊罍罢，良宵风露垂。\n娉婷岂自媚，迟暮宛相宜。\n故国鳌峰上，繁英今满篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19586,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冬日顺门陪九卿请驾视牲","author":"郑善夫","text":"春曙复冬初，仍瞻白鹭车。\n礼从郊庙损，天入震离虚。\n江汉哀戎马，岩堂望谏书。\n生惭百里子，去国意踌蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19587,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送苏侍御从仁使蜀","author":"郑善夫","text":"骢马今何去，玄冥岁已残。\n风云行剑阁，钲鼓动松潘。\n事在西戎部，功亏旧将坛。\n怀柔亦边略，要识圣恩宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19588,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"依依","author":"郑善夫","text":"独有南冠客，依依郭氏台。\n未酣燕市酒，翻惜陇头梅。\n汉戍连城动，秦关千角哀。\n县金买骏地，徒使壮心颓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19589,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梦与王阳明论学","author":"郑善夫","text":"美人入我梦，惠我白云词。\n述作何多事，经纶非尔时。\n空斋下鸟雀，深水伏龙螭。\n尚愧瑶华赠，悠悠江汉思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19590,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柬顾华玉","author":"郑善夫","text":"在昔过逢日，天台山雪生。\n何期易水上，同忆赤霞城。\n杯动青春色，堂含沧海声。\n终焉谢朱绂，㩗手石梁行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19591,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送人之赣州","author":"郑善夫","text":"西江兵乱后，作宦意悠悠。\n秪爱青油幕，高横白鹭洲。\n风尘鄱下战，岁月赣江流。\n应羡陶皮隐，桃花开未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19592,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠方梅墅","author":"郑善夫","text":"方干乐道处，小墅野梅开。\n对客翻高调，飞花片片来。\n萝云蒙卧榻，陇日照行杯。\n不耐王孙思，春深未却回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19593,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送人之惠州","author":"郑善夫","text":"名家参政下，独觉仲容贤。\n宦辙今何往，毕栖此最便。\n物情沧海俗，天气百蛮烟。\n秪近啼猿树，乡心日夜县。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19594,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"马伯淳西归","author":"郑善夫","text":"与君同去国，别路各悠悠。\n吾邑东海上，终南西雍州。\n何时报缟带，于此解纾裘。\n万事将慈母，长歌渭水流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19595,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春暮游城西寺","author":"郑善夫","text":"毗卢千佛阁，近在绿云中。\n客到虚无岸，春归莺燕丛。\n燕台望不及，古意渺何穷。\n拟入东林社，殷勤向远公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19596,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山人","author":"郑善夫","text":"吕公嘉遁处，云鸟静相亲。\n日与嵇中散，沈冥山水滨。\n雁荡斜连海，桃源直避秦。\n斋居玩易理，龙性可能驯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19597,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别林克相二首 其一","author":"郑善夫","text":"邺下传诗句，沧洲拂钓竿。\n正思龙卧稳，翻惜雁归难。\n燕壁云回合，闽关天郁盘。\n飞腾最怜汝，慷慨一弹冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19598,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别林克相二首 其二","author":"郑善夫","text":"汝复弹冠出，余今解绶回。\n平生一掬泪，洒向黄金台。\n戎马东南剧，鼓鼙城阙哀。\n无能奏羽猎，翻愧子云才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19599,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠吴生","author":"郑善夫","text":"稻粱荒楚塞，鸿雁尚安归。\n秪避云中弹，冥冥天外飞。\n子有鸾凤质，枋榆非所依。\n风尘好自惜，莫损綵云衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19600,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠山人受封","author":"郑善夫","text":"念彼南山隐，南山郁自怡。\n时闻春雨外，高倡紫芝词。\n猿鹤心同远，裘羊径不缁。\n莫嫌儿女笑，宫锦照庞眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19601,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"昆崙子","author":"郑善夫","text":"君本昆崙客，岩扉星汉连。\n流沙拂袖去，述作为谁传。\n紫芝秀可掇，青牛何当还。\n异时求物色，萧䬃白驹篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19602,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"安陵阻风","author":"郑善夫","text":"落日安陵上，荒芜望蓟丘。\n风沙无昼夜，家室此淹留。\n江汉悲多故，干戈赋远游。\n河清是何日，吾志欲东周。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19603,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠杭方伯兼柬东卿提学","author":"郑善夫","text":"邴原犹薄宦，疏广已遗荣。\n无复周王猎，谁钦钓渭名。\n余亦武夷去，探玄学久生。\n逢君五湖畔，北眺有馀情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19604,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同晋陵诸子游水西二首 其一","author":"郑善夫","text":"共有烟霞想，言过西水浔。\n薜萝迷远近，鱼鸟入高深。\n花气含风满，山堂附郭阴。\n宴酣忘主客，谁赋越乡吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19605,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同晋陵诸子游水西二首 其二","author":"郑善夫","text":"喜到晋陵郡，行逢诸子招。\n竹林初散帙，槐树已鸣蜩。\n绕径驯朱鹤，通池接画桡。\n遥思荷蓧者，去作羽山樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19606,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陈遂初进士邀宿赪谷草堂夜观西湖渔火","author":"郑善夫","text":"税驾归闽土，寻山入浙中。\n客情逢胜友，东路任飞蓬。\n夜艇流渔火，秋杯折渚筒。\n巢由圣世事，直北大明宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19607,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过孙山人苕溪旧居","author":"郑善夫","text":"耿耿忆孙楚，溪边青竹门。\n未同苕水月，竟失汉阴原。\n寿天真诠外，风云孤梦存。\n平生少谷榻，独下向谁论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19608,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄施粤之侍御","author":"郑善夫","text":"南昌隐君子，寄迹绿云端。\n念尔神交久，惭余色会难。\n此时歌伐木，伊昔阻风湍。\n何日下县榻，相看黄箨冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19609,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"碧岩下小憩望太湖","author":"郑善夫","text":"长夏碧岩好，萧萧千竹林。\n看山白屋静，息驾古藤阴。\n震泽惊波在，洞庭归鸟深。\n楚臣新去国，漫有卜居吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19610,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谒孙太初坟二首 其一","author":"郑善夫","text":"草堂琴瑟罢，羽化竟何如。\n那复乌藤杖，空传白鹿车。\n沙湍且鸥鸟，天地即蘧庐。\n白首林君复，终无封禅书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19611,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谒孙太初坟二首 其二","author":"郑善夫","text":"伊昔丘园隐，风流谁似君。\n谈诗振大雅，抗志入高云。\n宅拟王官谷，山名太白坟。\n寥寥广陵散，定向夜深闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19612,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄赤城诸子","author":"郑善夫","text":"自别赤城去，藏身金马门。\n莼鲈心独苦，林壑道何尊。\n万事风波过，三年魂梦存。\n终焉共携手，采秀入桃源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19613,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠张南陵","author":"郑善夫","text":"张翰风流在，南陵溪谷间。\n一为香案吏，便得敬亭山。\n饭饱鲈鱼味，身随鸥鸟班。\n后期望星汉，知尔御风还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19614,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿胜果寺","author":"郑善夫","text":"游吴复适越，漫宿赞公房。\n小隐薜萝密，大观江海长。\n钵龙蟠夜壑，云篴语秋堂。\n稍觉菩提长，森森松橛凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19615,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠秀公","author":"郑善夫","text":"不作寻诗计，沉情日闭关。\n牛车载上乘，锡杖拄空山。\n玩世风尘外，放身花鸟间。\n秋斋食橡栗，见尔好容颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19616,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题潘山人水居","author":"郑善夫","text":"习静不出郭，著书长闭门。\n烟霞结白日，薜芷避缁氛。\n巾舄从吾好，钟彝有道存。\n埋名爱蒋诩，多事陋扬云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19617,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荒村","author":"郑善夫","text":"荒村连日雨，散发不曾梳。\n岁月报恩子，生涯种树书。\n无因致故旧，岂是爱空虚。\n门巷曈曈日，轻车恣所如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19618,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠叶少府","author":"郑善夫","text":"吾闻隰城尉，通练更文章。\n坐扫封狐雪，行开射鸭堂。\n诗篇穷地秘，海水识风凉。\n似尔纡黄绶，巢云意不忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19619,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"行宋宫故基","author":"郑善夫","text":"西门数顷地，旧是帝王宫。\n复道清波没，妆台碧藓空。\n王侯混丧狗，臣庶议从龙。\n莫谩歌禾黍，山河涕泪中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19620,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴山","author":"郑善夫","text":"吴山入阛阓，佳气自苍苍。\n洞窈通仙隐，龙盘集吉祥。\n犹宜雪后对，莫为岁寒妨。\n所历多酸鼻，兹山耿不忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19621,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"凤林","author":"郑善夫","text":"凤林五百户，活计在山溪。\n野碓远堤水，嵓田高治畦。\n新年传糗饵，旧俗诵菩提。\n生女无人育，男长少娶妻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19622,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"屴崱峰","author":"郑善夫","text":"盘礴地灵在，东南天柱高。\n三江转燕尾，百粤乱牛毛。\n未出无生网，难忘大觉刀。\n巢云定何日，万国且旌旄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19623,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]