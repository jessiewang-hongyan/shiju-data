f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"二月八日予生辰也喜浙江左大参桂坡先生至绝不饮酒茶话甚适赋此以识 其二","author":"张弼","text":"梅灯桦烛庆云桥，左相楼船忽住桡。\n白首相看夜深语，十年尘土一时销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜宴胡九皋因闻生子","author":"张弼","text":"丹桂堂前晚醉馀，兰闺擎出掌中珠。\n钓滩尽讶文星应，疑有光芒烛太虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"附录桂坡左大参先生赠诗二首 其一","author":"张弼","text":"去年钿醉紫薇楼，有约云间续胜游。\n此日庆云桥下泊，心期便欲结沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"附录桂坡左大参先生赠诗二首 其二","author":"张弼","text":"花甲重逢贺客都，无声诗意有声图。\n我来亦效长生颂，重赋扁舟放五湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予素抱热疾夜卧少安昨夜喜桂坡先生左大参至而夜话遂快肰若脱始悟火郁而肰医师未能及耳作一绝以志喜云","author":"张弼","text":"忽闻高论起沉疴，悔却从前问华陀。\n可奈明朝又分手，短桥新柳雨声多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"生日蒙天台叶太守崇礼诸公寄双鹿为寿谢","author":"张弼","text":"呦呦双鹿庆云堂，仙子驰来献寿觞。\n翘首天台在何许，桃花流水路茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30979,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢任先生寄寿烛一绝","author":"张弼","text":"霞城画烛大于椽，远寄云间庆寿筵。\n自笑无缘照歌舞，夜窗频剪读遗编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30980,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨饮","author":"张弼","text":"花朝风雨阻清游，便蹑棕鞋上小舟。\n白发周郎留共饮，大吴桥下酒如油。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上巳游庆云庄口号","author":"张弼","text":"村庄花鸟媚春晴，画舸将筵任意行。\n嬴得身閒伴觞咏，乾坤随处是兰亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"约游凤凰山","author":"张弼","text":"三十年前赋此山，凤凰形势笔波澜。\n西风有约重游赏，欲借幽轩半日閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30983,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿藏","author":"张弼","text":"万顷晴云一茧窝，春风载酒听笙歌。\n问渠何日来居此，且看桑田生白波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30984,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽邹允章母","author":"张弼","text":"小楼黄叶雨声寒，泣母孤儿泪不乾。\n记得阃仪三伯字，细磨贞石共誊刊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30985,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送野鸡与叶廷茂","author":"张弼","text":"缙云司里旧同游，老我归来巳白头。\n射得五茸双锦翼，携来花下醉风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30986,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"道士郭初旸寓王参议廷玉家","author":"张弼","text":"翩翩鹤背郭初旸，子晋相携入醉乡。\n东海老仙三日笑，醯鸡瓮里为谁忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30987,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄白花","author":"张弼","text":"花开黄白鹭鸶藤，疗却诸疮最有灵。\n只恐医师犹未信，老夫重为注图经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30988,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙潭寺有听雷处乃吾二郎弘宜读书所也寺","author":"张弼","text":"白龙潭寺听雷处，满地楚云生昼寒。\n追想旧游诗兴逸，紫箫明月醉乘鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30989,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢医一首","author":"张弼","text":"年来老懒谢交游，只接人间扁鹊流。\n月下花前能醉舞，绝胜骑鹤上扬州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30990,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南坛斋宿有怀李同府廷芳","author":"张弼","text":"李牧楼船江水涯，听风听雨亦如斋。\n灯花落尽频挥笔，应写铙歌寄好怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30991,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南坛斋宿简同宿韩推府驭民","author":"张弼","text":"鸢飞鱼跃眼中情，莫把微言入杳冥。\n若说槐黄催举子，文章只合问西厅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30992,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题可梅卷","author":"张弼","text":"千红万紫不胜春，独有梅花最可人。\n三尺枯桐一声鹤，海天明月斗精神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30993,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓居仙人巷口号","author":"张弼","text":"有约春风看杏花，远携书剑客京华。\n故人若欲寻踪迹，仙巷东头第一家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30994,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"椰瓢","author":"张弼","text":"海气溟濛硕果肥，中涵乳酒浸酥肌。\n北人剖饮难成醉，万里鲸波路崄巇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30995,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悬榻轩为金陵刘某作","author":"张弼","text":"一榻高悬坐者稀，眼中浑不为轻肥。\n挑灯细读陈蕃傅，徐孺原来是布衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30996,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"棠梨白头","author":"张弼","text":"春到棠梨春巳深，赏春不称白头吟。\n金尊自共东风醉，花底关关听好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30997,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答柯在亨同年","author":"张弼","text":"浙省同年七八人，相思无复更相亲。\n钱塘江上今宵月，却有清光到海滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30998,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送道州何秀才","author":"张弼","text":"濂溪阙里旧风烟，仰止于今五百年。\n太极有图谁会得，后生立志正希贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30999,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"淡轩为胡运同赋","author":"张弼","text":"鹾亭父老说真廉，百数年来姓一瞻。\n世上繁华多不试，布袍轻暖菜根甜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31000,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读史","author":"张弼","text":"随世功名迈等夷，也于竹帛姓名垂。\n若教范我驰驱法，六合中间知有谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31001,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]