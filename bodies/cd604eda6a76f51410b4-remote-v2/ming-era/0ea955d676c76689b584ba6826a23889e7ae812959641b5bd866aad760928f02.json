ollection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自况","author":"张弼","text":"十载南安一醉翁，归来潦倒鬓飞蓬。\n故人又寄醉翁倚，如跨青天鹤背风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄南安蔡经府","author":"张弼","text":"相逢闽友厌闽音，莲幕先生动我心。\n接得南安书一纸，年来应恐二毛侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"史教授","author":"张弼","text":"桃花落尽杨花飞，别后还应添带围。\n昨日姑苏台上望，洞庭山水思依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30958,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送高进士赴京","author":"张弼","text":"听雪听风过半春，江南杨柳尚含嚬。\n一枝折赠仙郎去，好做调和玉烛人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30959,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄胡九万二首 其一","author":"张弼","text":"诗景诗朋双美具，多因酒困废吟哦。\n别来最是关心处，轩外青山瞰绿波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30960,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄胡九万二首 其二","author":"张弼","text":"凄风挟雨滞归舟，孤负归期信宿留。\n借问昨宵东阁下，果烹鸡黍待来否。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":