[{"title":"为桂花芙蓉雪冤","author":"张弼","text":"天香幽艳应时开，岂作山乡疠鬼媒。\n寄语土人休浪怪，正堪相对倒金杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题辽海","author":"张弼","text":"郁蓝波接郁蓝天，主圣臣贤又宴肰。\n欲问吾家在何许，鹘飞尽处白云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题弘善寺壁","author":"张弼","text":"好山围绕老僧居，碧玉环中一绀珠。\n尘鞅偶来分半榻，便忘身世在寰区。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"珉玉池付金莲寺僧为香炉","author":"张弼","text":"平平艮岳黍离离，拾得龙眠洗玉池。\n付与山僧作清供，兔毫深椀对吟诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"惜母山新路词","author":"张弼","text":"傍水绿山石路萦，昔时荦确今时平。\n伊谁凿者文知县，千载行人有颂声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒文献祠","author":"张弼","text":"远上梅峰九转螺，曲江祠庙郁嵯峨。\n悠肰俯仰人千载，旧石消磨名不磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张靖州","author":"张弼","text":"记得相逢其食□，桃花开遍十三遭。\n此行若到玄都观，应被刘郎笑二毛。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题芭蕉二首 其一","author":"张弼","text":"秾绿丛中吐茜红，直从盛夏到深冬。\n于今始信王维画，能写当时雪里容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题芭蕉二首 其二","author":"张弼","text":"休说高台月与风，芭蕉花发半年红。\n也能妆点庭中草，都在濂溪意思中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送景方还南京","author":"张弼","text":"黄金台下见秋风，回首钟山意万重。\n寄语秦淮楼上月，归来还与故人同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"补旧罗员领","author":"张弼","text":"针线殷勤补旧罗，细看墨迹酒痕多。\n如何不肯轻抛掷，曾听南薰帝舜歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"补红褐衣","author":"张弼","text":"毳袍红褪著多年，重命针工细补联。\n却忆当时旧襦裤，慈亲手眼夜灯前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"足梦中句","author":"张弼","text":"读罢离骚铃阁卧，苍龙挟雨窗前过。\n起来一笑足前章，东山红日车轮大。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四儿作对句赋此","author":"张弼","text":"我方幼稚能作对，武库先公向客誇。\n今日弘圭亦如我，不胜感旧泪横斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五儿六期口号","author":"张弼","text":"弘玉今年巳六期，娇痴未肯事诗书。\n却来戏弄如椽笔，搅我清风翰墨池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻造楼船甚丽，余明年归必在嘉兴或姑苏相见矣，喜而先此寄诸贤弟","author":"张弼","text":"三贞坊前巨綵船，笔床书卷煮茶烟。\n何时东海先生醉，水调歌头三百篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书怀二首 其一","author":"张弼","text":"东海先生懒学仙，饥时得食倦时眠。\n年来欲试挥锄手，弱水蓬莱尽种田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书怀二首 其二","author":"张弼","text":"饥时得食倦时眠，即此修行玄更玄。\n说此修行浑不省，却从方外觅神仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"两访施同知汉章不遇","author":"张弼","text":"两度相寻两不逢，马蹄金谷醉春风。\n谁怜寂寞蓬窗客，坐对沙鸥落照中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归途望西林寺塔","author":"张弼","text":"西林古塔势凌霄，是我门庭碧玉标。\n归马尚悬□五堠，行人先指读书巢。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苏州别驾周德中以余致仕居间而称神仙太守作十绝复之 其一","author":"张弼","text":"归休太守似神仙，布被蒙头日宴眠。\n却怪门前来热客，马蹄踏破紫芝烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苏州别驾周德中以余致仕居间而称神仙太守作十绝复之 其二","author":"张弼","text":"不入清都不溷尘，吟诗落魄任天真。\n苏州别驾何须问，元是缙云司里人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苏州别驾周德中以余致仕居间而称神仙太守作十绝复之 其三","author":"张弼","text":"诗不求工字不奇，天真烂熳是吾师。\n归来东海烟霞里，时复高歌攀桂枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苏州别驾周德中以余致仕居间而称神仙太守作十绝复之 其四","author":"张弼","text":"官居南郡二千石，诗咏关睢三百篇。\n衮职惭无一字补，虚生六十又三年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苏州别驾周德中以余致仕居间而称神仙太守作十绝复之 其五","author":"张弼","text":"单车夜走榆关雪，五马晓冲梅岭烟。\n南暑朔寒俱历遍，老归林下荷苍天。","collection":"明","notice":"","provenance":{"repo":"Wer