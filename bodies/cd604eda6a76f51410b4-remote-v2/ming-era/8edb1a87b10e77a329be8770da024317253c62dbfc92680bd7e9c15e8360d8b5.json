[{"title":"送陆子传请告还吴","author":"欧大任","text":"西掖符台汉列卿，风尘君自厌承明。\n东方可是浮沉客，司马多传赋颂名。\n震泽颇堪供玉鲙，建章何处望金茎。\n游閒公子应相待，斗酒深欢圣主情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5928,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽葛明府子静","author":"欧大任","text":"循吏高风孰与齐，去思多在七闽西。\n贤声邺郡春秋纪，乡行平舆月旦题。\n马鬣只今封玉碗，鸾书何日下金闺。\n诸孙结驷多冠盖，人向闾门忆杖藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5929,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张台州","author":"欧大任","text":"铜虎符分亦壮哉，浙东名郡表天台。\n褰帷江郭春能出，下榻山楼日自开。\n高浪每疑沧海入，飞霞半挟赤城来。\n玺书上计看君去，曾是承明侍从才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5930,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀方员外","author":"欧大任","text":"闻君郎署罢官贫，十口樵川过几春。\n鸡犬相随怜避地，江山无恙待归人。\n天边高枕青萍在，海内雄辞白发新。\n客有感恩称邑子，羞将名姓问荆榛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5931,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈徐诸生邀余同徐王二僚长饮法海寺遂登迷楼","author":"欧大任","text":"天空风急雁飞回，留滞经春恋酒杯。\n偶约同官行并辔，更携诸子醉登台。\n汴堤烟柳丝丝出，淮水云帆片片开。\n凤舸龙舟俱莫问，且看持楫渡江来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5932,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王元美起家按察备兵天雄","author":"欧大任","text":"使者秋辞督亢亭，主恩宁许遂鸿冥。\n行资庙略临洺水，手握兵符出井陉。\n朔雪东连沧海白，蓟云西落太行青。\n重关自昔雄三辅，慷慨看君报汉廷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5933,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答陈评事玉叔见怀","author":"欧大任","text":"楚歌何以念同声，然诺深知慷慨情。\n雁下蓟门书万里，星相淮海客孤城。\n广文官自留毡冷，廷尉名缘结袜成。\n巴曲岂堪酬白雪，独悬清梦到西京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5934,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送冯方伯汝言赴江西","author":"欧大任","text":"十载闻君自有曹，名家不羡五陵豪。\n位尊方岳提封远，地控东南屏翰劳。\n綵笔匡庐回夕照，楼船彭蠡压春涛。\n江淮还待趋朝日，剑佩秋悬北斗高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5935,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送卢惟忠僚长归黎阳因忆次楩","author":"欧大任","text":"皋鱼归哭大?东，祖帐淮南柳色中。\n黎水冰澌驱夜骑，太行云断散春鸿。\n舄飞人望仙郎久，毡在谁怜学士穷。\n曾过马陵思侠客，为传双泪寄悲风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5936,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒食集吴氏园亭得春字","author":"欧大任","text":"园林芳草半成茵，好事偏多载酒人。\n池引玉凫淮水长，烟含金柳汴堤新。\n千家禁火供寒具，几树啼莺傍角巾。\n醉倚箜篌看浴马，主恩还忆曲江春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5937,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张仲实过杨州为余写容赋此以别","author":"欧大任","text":"苜蓿斋前丘壑姿，雄飞君尚写当时。\n青云不止山公启，白发空能水部诗。\n三月烟花还此别，十年风雨几相思。\n故园为扫罗浮石，归访轩辕已有期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5938,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄大司马濮阳苏公","author":"欧大任","text":"司马仙班压汉貂，赤松何事早相招。\n乞身剑履星辰近，挥手烟霞海岱遥。\n镜水已能留贺监，玉关那得老班超。\n谁知濮上持竿客，白首勋名在圣朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5939,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜过宝应湖","author":"欧大任","text":"飞涛寒涌柁楼深，永夜星河堕欲沉。\n病后江湖曾起色，醉来书剑有雄心。\n苇间明月双珠出，蘋末悲风万籁吟。\n回首芜城平楚尽，中原何处不萧森。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5940,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"淮口大风同吴子化张子豫临眺","author":"欧大任","text":"百万飞艘旌帜黄，惊沙忽起半苍茫。\n支祁西锁涡河下，桐柏南连泗水长。\n秦使何来求海上，汉臣谁敢薄淮阳。\n楼前芒砀风云气，多少征人望帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5941,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访胡给事","author":"欧大任","text":"淮楚城高泗水斜，西来夹毂问君家。\n绿槐门巷丝丝雨，青锁衣裳片片霞。\n阙下谏书曾削草，斋中法供只拈花。\n谁知献纳蓬莱客，已种东陵五色瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5942,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答周给谏兴叔过广陵见怀","author":"欧大任","text":"渡江忆我鬓萧骚，此地千秋见綵毫。\n园且谈经帷更下，涛堪起色翰曾操。\n菰蒲每狎鸥为客，苜蓿犹疑马是曹。\n近侍只今趋锁闼，西京回首五云高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5943,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答皇甫子循见寄","author":"欧大任","text":"双鱼消息五湖还，玄晏先生尚闭关。\n人候小车乘下泽，书成残草寄名山。\n江南烟月参差际，淮浦风云澒洞间。\n尺素怀君三百里，竹林何日一追攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5944,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻吴明卿谪高州","author":"欧大任","text":"汉家迁客意如何，五岭风烟拥传过。\n借客姓名奇节在，窥人魍魉畏途多。\n中原尚走铜鱼使，下里能高白雪歌。\n已约葛洪迎鲍靓，罗浮秋色更嵯峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5945,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黎职方惟敬北上见过","author":"欧大任","text":"负弩争迎画省郎，为余驻马问凄凉。\n泪挥一掬江头月，鬓乱千茎岭外霜。\n南国昔年同小草，西京今日待长杨。\n自怜曾是公车客，老向芜城忆建章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5946,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新秋陪黎惟敬宴迷楼得帆字","author":"欧大任","text":"亭皋落叶乱枫杉，拥传来游得并骖。\n骤雨千山泉并下，高楼双树日犹衔。\n隋堤南走荒金埒，汴水西流散锦帆。\n平楚萧条君更望，莫因离别湿青衫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5947,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送惟敬兼怀思","author":"欧大任","text":"綵毫东省旧词臣，君到长安万事新。\n将略直须论騕袅，主恩还待画麒麟。\n广陵别后空遗散，碣石年来更几人。\n同舍翩翩金尽起，燕歌能不念江滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5948,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄江子云","author":"欧大任","text":"淮阴枚叔尔同乡，赋里江涛字几行。\n秋水只堪论濮上，白云犹自堕沧浪。\n溪舲一系双莲阁，山笥曾抄五石方。\n东海何时明月色，觅余千尺钓丝长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5949,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冯妹夫用唯至","author":"欧大任","text":"姻娅过从万里途，远劳慈母报欢娱。\n看云泪尽江流急，见月身遥雁影孤。\n客有苜盘当晚食，家惟橘树指秋租。\n明年归傍潘舆日，白板门前候我无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5950,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送霍别驾致仕次乃弟太仆韵","author":"欧大任","text":"回首西樵十五年，使君归兴已翛然。\n孤帆雨色三江树，绝峤秋阴百粤天。\n数马尚留坰外策，买山还少橐中钱。\n铁泉老作烟霞客，趋府何如拥褐眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5951,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送赵职方","author":"欧大任","text":"六传晨催使者餐，衔恩忼慨入长安。\n台临讲武黄图壮，书去筹边紫塞寒。\n上苑跨胡驰羽猎，呼韩归汉拜衣冠。\n知君不易谈兵事，曾过中原立马看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5952,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送傅惟忠","author":"欧大任","text":"汴堤疏柳拂征鞍，十载逢君尚鹖冠。\n射虎陇西工饮羽，连鳌海上老持竿。\n赋成片札淩云起，气结双钩照斗寒。\n白首谈兵传介子，汉家还待斩楼兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5953,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"范太史胡比部九日见过邀郑明府同集","author":"欧大任","text":"携手黄花绕径行，为谁斗酒缓王程。\n孤城风雨双帆影，万里江淮一雁声。\n东观旧知彤管客，西曹今见白云情。\n佩萸因尔随飞舄，秋色飘零傍汉京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5954,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张幼于还吴门","author":"欧大任","text":"双钩寒照白云天，离夜悲歌浊酒前。\n吴楚星分公路浦，江淮秋送孝廉船。\n岂堪苜蓿还相忆，几处蒹葭不可怜。\n知尔五湖烟水阔，陆沉金马是何年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5955,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史少尹德初还自海上会余淮南以子与元美诗见示索赠一首","author":"欧大任","text":"学书学剑早成名，老握阴符气未平。\n太尉东行求剧孟，伏波南下得袁生。\n凿空百战皆王略，蹈海孤臣岂世情。\n自昔江淮多侠客，知君还欲请长缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5956,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过白子直","author":"欧大任","text":"蹩躠风尘尔蚤回，射阳渔长兴悠哉。\n好书竹简三车积，纳印柴门五柳开。\n浯水僧携唐颂至，谷城人榻汉碑来。\n白家更有香山社，宾客何因得共陪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5957,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中同陆山人渡杨子江","author":"欧大任","text":"招隐高歌念我曹，剡溪宁得似江皋。\n花飞银浦冲寒色，风起璚楼涌暮涛。\n咫尺蒋山千树没，参差瓜步片帆高。\n西来欲听阳春曲，醉里还同郢客操。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5958,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金陵逢张玄超同集许仲贻宅","author":"欧大任","text":"雪满清溪溪水滨，怜余憔翠鬓毛新。\n秋风久已闻张翰，朗月何期遇许询。\n文学宴中将别客，太常斋里是醒人。\n明朝汝颍西游路，江左风流忆葛巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5959,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈子野邀笛阁","author":"欧大任","text":"何年佳士泊秦淮，曾为徽之弄笛来。\n归客洞庭山亦送，罢官江左阁重开。\n远游艇子能依槛，乍落梅花尚满台。\n积雪泠泠还有约，天涯帆影自西回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5960,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒卞忠贞祠读其裔孙蓘所集遗事","author":"欧大任","text":"晋代衣冠散九京，南来骠骑有荒茔。\n世家诸夏宁称爵，国士千秋不为名。\n紫气已沉朱雀桁，白云犹堕石头城。\n诸孙纂业山精泣，萧飒灵风泪满缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5961,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访金山人在衡不遇","author":"欧大任","text":"桥分白下斗门斜，髯自何年此寄家。\n代出陇西连鸟鼠，曲传江左半梅花。\n掩关竹里多题凤，夹水槐堤尽宿鸦。\n日暮不闻中岭啸，只留名姓在烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5962,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过李太史子田","author":"欧大任","text":"先朝供奉渥恩浓，一出承明守秩宗。\n淮水尚看秦日凿，周南犹滞汉家封。\n寻君江浦将千里，携我钟陵第几峰。\n早晚紬书徵太史，殿头东角候飞龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5963,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"盛仲交余伯祥访予姚氏园不值","author":"欧大任","text":"听偈长干讲座间，君携斗酒问柴关。\n曲高白雪歌谁和，兴尽青溪艇自还。\n草市能寻江令宅，版桥应望谢家山。\n虚闻二妙题诗去，惆怅披云未可攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5964,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"佘侍御彦纶宅饮别","author":"欧大任","text":"路逢驱马人争避，门幸登龙我独来。\n岭外颇传千垒散，江东还共一尊开。\n青毡老作谈经客，白简时推草奏才。\n此别关山风雪里，相思吾在景夷台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5965,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同张玄超陆华甫姚元白沈子高集邢太常伯羽宅邢六十初度且诞子诸君已有贺章因继此作","author":"欧大任","text":"神武归来赋最豪，西京犹是列仙曹。\n门占气色多麟趾，家有文章总凤毛。\n爱客黄庭经每写，向人白雪调偏高。\n持觞醉问东方朔，金马能无忆露桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5966,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘太常孟真携酒过青莲庵饯送","author":"欧大任","text":"芳草燕郊送锦鞯，相逢白下又离筵。\n一从铨府音尘绝，何意容台礼数偏。\n风鬣频嘶山院外，雪花还积酒尊前。\n校书早晚归天禄，莫向寒毡忆郑虔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5967,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"随牒光州留别广陵诸公","author":"欧大任","text":"吏隐淮南爱薜萝，居閒宾客日相过。\n云蒸讲论淹中久，星聚衣冠许下多。\n病后尊犹倾北海，别来人或忆西河。\n不须握管推能赋，五十功名鬓易皤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5968,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甘泉山下答诸生相送","author":"欧大任","text":"雪里驱车路渐分，青山何以别诸君。\n传经祇自惭刘向，问字徒劳念子云。\n庭长琅玕鸾已散，斋荒苜蓿马能群。\n风烟汝水千余里，回首江淮雁数闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5969,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"盱眙渡河访张泗州","author":"欧大任","text":"府中曾识范功曹，皂盖专城此郡劳。\n河兼淮泗增波急，山自荆涂拥雪高。\n远客征衣怜薜荔，使君斗酒惜蒲萄。\n谁携宾从登楼上，笑倚胡床拂綵毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5970,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泗州宿客盱眙院中院在山半雪后游眺","author":"欧大任","text":"馆开石壁雪泠泠，下马蓝田是此亭。\n大圣塔留开士颂，玻瓈泉勒使君铭。\n河西一水城头白，淮曲诸山枕上青。\n一笑莫论逢醉尉，部中谁更望双星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5971,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中都","author":"欧大任","text":"钟离山绕鼎门东，此地曾橐万里弓。\n王气远浮珠树外，帝乡犹在白云中。\n衣冠几夜游原庙，父老千秋拜沛宫。\n笔札小臣思奏赋，自怜摛藻愧杨雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5972,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"霍丘除夕","author":"欧大任","text":"濛泗飞骖过寿阳，逼除犹滞霍丘旁。\n水侵诸郡荒官舍，雪积千山照客床。\n马上驰驱羞薄宦，灯前儿女傍他乡。\n天涯白发遥相忆，椒颂何年献寿觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5973,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得佘合肥书酬寄 其一","author":"欧大任","text":"忆昨輶轩逼岁除，万山残雪独驱车。\n邗沟一望濡须口，犹得淮西双鲤鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5974,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得佘合肥书酬寄 其二","author":"欧大任","text":"督邮岂解折腰迎，闻道庐江出带星。\n谁怜玉舄风尘色，会送飞凫入汉庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5975,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答许左史殿卿汴中见怀 其一","author":"欧大任","text":"昔日谈天碣石宫，梁园知尔赋偏雄。\n小山不见丛生桂，只道淮南有八公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5976,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答许左史殿卿汴中见怀 其二","author":"欧大任","text":"雁池兔苑宴欢馀，犹得西来长史书。\n雪后平台宾客在，文园谁道病相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5977,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"首蓿斋初成郭山人霁上人自焦山见过","author":"欧大任","text":"高士能同首蓿盘，僧携明月下天坛。\n谁云郑老斋中坐，不似焦仙洞口看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5978,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"霁上人裹白云茶至汲大明水试之同次甫斋中作","author":"欧大任","text":"闻师曾采虎丘茶，还汲清冷煮雪芽。\n无双亭下长镵客，第五泉头大士家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5979,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"六弟自金陵渡江省予广陵即还岭南因寄诸弟","author":"欧大任","text":"西陵曾寄惠连诗，江北深冬见汝迟。\n归去家园如问讯，杨州官阁有梅枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5980,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄赠曾以三督学关中 其一","author":"欧大任","text":"阊阖云开气象新，西京礼乐重儒臣。\n观风一过邠岐下，不用诸生论借秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5981,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄赠曾以三督学关中 其二","author":"欧大任","text":"解颐匡鼎去谈经，西学长安佩尽青。\n槐市翩翩能论难，秋风催送入彤廷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5982,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄赠曾以三督学关中 其三","author":"欧大任","text":"轺车西望说经台，万里关门紫气来。\n侍从只今持玉节，崆峒先问广成回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5983,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄赠曾以三督学关中 其四","author":"欧大任","text":"华岳岧峣一振衣，仙人掌上露初晞。\n醉歌郢曲三峰下，从此天门白雪飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5984,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄赠曾以三督学关中 其五","author":"欧大任","text":"天马西来亦汉恩，临洮刍秣向中原。\n君看百万飞黄入，燕市千金且莫论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5985,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄赠曾以三督学关中 其六","author":"欧大任","text":"作赋谁如楚大夫，词人偏解诵西都。\n终南渭水高秋色，阁上晴虹一片孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5986,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀吴明卿兼寄沈嘉则 其一","author":"欧大任","text":"炎天五马忆秋嘶，汉主何时召会稽。\n莫怪年来无尺素，雁飞不到七闽西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5987,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀吴明卿兼寄沈嘉则 其二","author":"欧大任","text":"郡符兼领武夷山，怀惠移家客未还。\n应是丹砂犹可学，江淹长向白云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5988,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题海云山人秋鹰图","author":"欧大任","text":"西风秦树色苍苍，独立秋鹰正击霜。\n汉主跨胡还此日，何人给札奏长杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5989,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"淮南早秋马上作","author":"欧大任","text":"隋堤疏柳似枫潭，送客逢秋酒半酣。\n马上不知家万里，只看鸿雁过江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5990,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜从召伯堰五十里还杨州","author":"欧大任","text":"听鸡埭上过邗沟，片片霜华扑弊裘。\n不是马卿游易倦，十年词赋事诸侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5991,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴山人还四明 其一","author":"欧大任","text":"芜城摇落楚云边，何处秋风不可怜。\n十载一冠犹侧注，渡江人识孝廉船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5992,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴山人还四明 其二","author":"欧大任","text":"千金裘马未须论，岁晚天涯短剑存。\n独少归装双白璧，应知不是过平原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5993,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]