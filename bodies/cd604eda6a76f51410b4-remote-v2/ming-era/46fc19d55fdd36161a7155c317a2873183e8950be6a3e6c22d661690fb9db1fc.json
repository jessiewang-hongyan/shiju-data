[{"title":"东干晚眺","author":"程敏政","text":"旷目秋无际，佳晴夜有霜。\n花寒明废陇，叶落蔽横塘。\n朔气山容瘦，斜晖屋影长。\n一缣真画本，峰麓下牛羊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47051,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南山十二咏集古 其一 南山平","author":"程敏政","text":"陌上行人看石麟，三朝出入紫微臣。\n桃花坞接啼猿寺，直到南山不属人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47052,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南山十二咏集古 其二 榆庄聚","author":"程敏政","text":"隔林遥见起人烟，林畔莺声似管弦。\n何处貌将归画府，杏花榆荚晓风前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47053,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南山十二咏集古 其三 车田坳","author":"程敏政","text":"山屐经过满径踪，不堪吟罢夕阳钟。\n白沙翠竹江村路，云碓无人水自舂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47054,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南山十二咏集古 其四 渔村步","author":"程敏政","text":"短墙荒圃四无邻，水绿天青不起尘。\n何处渔樵将远饷，野航恰受两三人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47055,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南山十二咏集古 其五 陈公渴","author":"程敏政","text":"雨湿菰蒲斜日明，交交戛戛水禽声。\n幽居地僻经过少，野渡无人舟自横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47056,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南山十二咏集古 其六 见山垞","author":"程敏政","text":"力上东原欲试耕，远山如画翠眉横。\n川原缭绕浮云外，野店高低带古城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47057,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南山十二咏集古 其七 水南养","author":"程敏政","text":"箨冠新带步池塘，二顷湖田一半荒。\n忽到庞公栖隐处，柴门临水稻花香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47058,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南山十二咏集古 其八 半庄坂","author":"程敏政","text":"清江一曲抱村流，水物轻明澹似秋。\n村径绕山松叶暗，人家多住竹棚头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47059,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南山十二咏集古 其九 华果柴","author":"程敏政","text":"傍岩依树结檐楹，五月榴花照眼明。\n地僻寻常来客少，偶逢樵者问山名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47060,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南山十二咏集古 其十 眠弓沜","author":"程敏政","text":"西岩一径不通樵，扶病呼儿斸翠苕。\n一水暗回閒绕涧，霏霏拂拂又迢迢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47061,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南山十二咏集古 其十一 杨林干","author":"程敏政","text":"偶因行乐到村前，地湿莎青雨后天。\n日暮长堤更回首，绿杨花扑一溪烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47062,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南山十二咏集古 其十二 墓祠寮","author":"程敏政","text":"杖藜巾褐称閒情，客至从嗔不出迎。\n金磬泠泠水南寺，愿为閒客此间行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47063,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄题少华山","author":"程敏政","text":"山房一日启云缄，此地分明隔圣凡。\n玄石似当天狗堕，玉峰元出鬼工劖。\n珠帘直下千寻瀑，翠锦齐张九叠岩。\n砂拂涧毛红簌簌，露垂仙掌碧巉巉。\n桥横羽盖留真迹，室贮丹经锁秘函。\n蜃气半空浮殿阁，銮声终夕度英咸。\n十洲暖雾薰瑶草，万壑天风响雪杉。\n封禅可无群后集，往来疑有百灵监。\n蛟龙在下今犹蛰，萝茑盘空古未芟。\n揽胜谁飞王令舄，凭高时见浙江帆。\n微生愧乏神仙骨，迩岁容抛学士衔。\n林下每回思却老，人间何许更忧谗。\n吟筇漫踏新芒屩，野服仍裁短葛衫。\n幽谷紫芝应最盛，便期明日荷长镵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47064,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十一月偶至南山黄落颇甚夜宿闻雨作","author":"程敏政","text":"清溪浅可涉，朔气动原野。\n数日与山别，残菊不盈把。\n多病恒鲜欢，新篘谢杯斝。\n夜寒梦屡续，凉雨忽鸣瓦。\n俯仰天地中，流光疾于马。\n纷纷岁将晏，稍幸世缘寡。\n上想云谷仙，幽怀浩难泻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47065,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"芦塘山庄今岁始一克到其境实清邃为留竟日忘返他日略加脩辟可以佚老因赋一诗","author":"程敏政","text":"隔坞岚深路欲迷，石田遥带白沙溪。\n临塘便拟观澜阁，绕舍仍添种药畦。\n此地居然堪佚老，几年空尔择幽栖。\n寒梅一树柴门下，直与盘桓到日西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47066,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杨村道中","author":"程敏政","text":"几处炊烟认水村，数声山犬吠篱门。\n寒天日落明鸦背，荒岁田空剩草根。\n垂涧石如牛马饮，排云山似节旄屯。\n眼中无限诗情在，欲对沙鸥了一尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47067,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题为师鲁侄所作梅竹图","author":"程敏政","text":"皎皎冰肌瘦，翛翛凤尾清。\n众芳摇落后，同保岁寒盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47068,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长至前二日闻李锦衣士敬自南阳扫墓取道访予新安奉迓杨山寺是日相传皇子诞生有赦将到","author":"程敏政","text":"九地一阳今渐回，道傍山寺独徘徊。\n拾薪煮茗消馀日，刻竹题诗试老才。\n黄纸正悬天下望，锦衣遥为故人来。\n一时欢动沧洲客，潦倒江亭白酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47069,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十一月十四日饮流塘詹存中家晚归时李锦衣士敬公便过县同行","author":"程敏政","text":"五里青山下夕晖，一林松影罥宫衣。\n主人远送到溪返，众客相随乘月归。\n诗垒笑予非巨敌，酒兵须子突重围。\n他时莫忘渔樵会，南国西风候雁飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47070,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"下纹溪过渡调士敬","author":"程敏政","text":"肩舆出山星已繁，寒月堕影金波翻。\n钟声木杪寺门远，灯火渡头人语喧。\n浅滩阁舟弄水戏，曲坞问路随乡言。\n人生此乐亦不易，风景何如君故园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47071,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送周长嵩","author":"程敏政","text":"书院当时借榻眠，壮游曾赋宛陵篇。\n因君忽记乘轺日，来往悠悠十四年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47072,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题李锦衣士敬写真","author":"程敏政","text":"七尺堂堂美丈夫，几年官拜执金吾。\n蓝田价重连城璧，丹穴文成五色雏。\n翰苑八砖同儤值，天山三箭待弯弧。\n等閒莫负封侯相，看续麒麟阁上图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47073,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"弘治辛亥岁仲冬念五日在万山观作","author":"程敏政","text":"城头雾敛青天开，平地忽见双蓬莱。\n捲帘下瞰白云起，拂手近招黄鹄回。\n一龙拿石树根古，万弩射潮风壑哀。\n鍊师纵尔能谢客，容我到城须一来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47074,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题宗贵道纪族兄清忠世家卷","author":"程敏政","text":"相国家声重歙城，耳孙遗迹半蓬瀛。\n犹馀一纸奎文在，夜夜虹光烛太清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47075,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"书二张真人诗文后","author":"程敏政","text":"西璧澹然俱已矣，词章尽可入吾曹。\n挑灯夜读不成寝，寒水一溪霜月高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47076,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮乐山阁留别张慎隐君","author":"程敏政","text":"偶凭高阁寄閒情，白鸟寒空野望平。\n三径叠云通后坞，一峰飞翠落前楹。\n樵人向晚长过岭，地主经旬不到城。\n与客醉来仍借宿，夜谈重理旧诗盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47077,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送李锦衣士敬 其一","author":"程敏政","text":"骨肉情深近所无，野人争看执金吾。\n如君亦是簪缨胄，白发苍颜愧老夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47078,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送李锦衣士敬 其二","author":"程敏政","text":"太师新庙万人看，庭下双松翠色寒。\n台辅几人应祀法，休休心事古今难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47079,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送李锦衣士敬 其三","author":"程敏政","text":"伪学乡人洛党孙，正宜耕钓水云村。\n诗书久废仍多病，只祷丰年答至尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47080,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送李锦衣士敬 其四","author":"程敏政","text":"一尊何许慰离颜，寒日江亭送北还。\n草草短篇君莫怪，颇愁贻累到溪山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47081,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十一月廿七日送士敬至浦口别后赋此","author":"程敏政","text":"一尊倾尽下江楼，带郭晴岚午未收。\n树杪天长围石岭，竹根溪浅露沙洲。\n隔林烟火三家市，下水风帆一叶舟。\n相送远游惊岁晚，不禁离思逐东流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47082,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和提学王侍御明仲游茅山诗韵","author":"程敏政","text":"翠壁分明鬼斧裁，蕊宫亦自化城来。\n寰中雨罢龙归穴，海上风生鹤唳台。\n葛令丹垆今寂寞，陶君仙骨此胚胎。\n病来欲作寻真客，三洞閒披鸟篆猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47083,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和吊梅宛陵诗韵","author":"程敏政","text":"诗垒犹传草木馨，烟云长锁旧池亭。\n魂游宛下空秋月，客散河阳几曙星。\n昆体战降孤帜赤，都官名重一衫青。\n晚生欲附宣州派，惭愧牛辕逐凤輧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47084,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十二月三日早下纹溪待渡不至步过桥行南山中","author":"程敏政","text":"欲济长川乏苇航，屐痕初试板桥霜。\n举头日驭回南陆，缩手寒威似北方。\n斜压石梁松骨瘦，细攒沙陇麦芽长。\n十年再走朱村道，消得浮生几度忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47085,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过会里遐富渡宗孙希周来迎","author":"程敏政","text":"借得樵夫杓，中流一棹开。\n岚消还荏苒，溪浅亦萦回。\n困欲凭乌几，寒思问绿醅。\n阿咸真外我，犹道玉堂来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47086,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"家畜一犬甚驯每出入必随至山斗宗侄希达家戏作","author":"程敏政","text":"掉尾长随竹轿行，深山穷谷了无惊。\n似知驺从都星散，终日栖栖管送迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47087,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四日大雪过新岭时山斗梦吉侄孙侍行","author":"程敏政","text":"老天开异境，琼岛落尘寰。\n鸟没黄云外，人行玉树间。\n石陉翻齿齿，冰溜激潺潺。\n剩得新诗料，奇观慰往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47088,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"下扶车岭山行饭三宝寺","author":"程敏政","text":"复道蛇盘百丈岑，石间流水乱鸣琴。\n仆夫戒险时相詈，学士逢奇只自吟。\n溪雪涧风清病骨，野猿山鸟绝机心。\n岭南古寺今重到，一饭匆匆及岁阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47089,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"成化壬寅冒雪至大畈今兹之来雪有加而兴不孤夜谈及山阴故事因赋此赠诸眷长","author":"程敏政","text":"平生颇怪山阴客，中道何缘兴便灰。\n可为倡酬悭酒量，还因嘲咏乏诗才。\n一时猿鹤劳相迓，百里溪山笑独回。\n我病虽衰心却健，冒寒今是两番来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47090,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五日宿浯村明日饮大畈","author":"程敏政","text":"畈上重来有所思，水风山雪似当时。\n壶觞夜话春坊宅，香火晨瞻御史祠。\n鱼出小塘供馔屡，鸡鸣深巷报炊迟。\n病惭两日淹留地，才薄难胜画里诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47091,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠文公八世孙上舍桢特授婺源训导","author":"程敏政","text":"博士承恩领故乡，自应徽国庆源长。\n黉宫百世诗书富，阙里三时俎豆香。\n社下廪人来继粟，门前童子候升堂。\n知君不负维桑托，霄汉巍巍见紫阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47092,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"七日与浯村大畈诸眷家别","author":"程敏政","text":"亲戚情深别酝浓，蓝舆摇兀两三峰。\n酒醒已过扶车岭，犹问前山第几重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47093,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"塔坑铺","author":"程敏政","text":"一村鸡犬塔坑前，老我山行暂息肩。\n路转岭阴残雪在，峰回林杪夕阳偏。\n渡惊削木通危径，舂爱机槽响暗泉。\n旷目此回真得意，数声寒鹊绕吟边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47094,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"重拜山斗世忠庙","author":"程敏政","text":"先祠高占水云村，十载重来叩庙门。\n一抹冻岚消木杪，半规寒日下松根。\n情深暖族新杯面，手拂题名旧墨痕。\n俎豆巍巍风烈在，济时才劣愧闻孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47095,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"八日游双门寺入山观石门及龙潭爱其奇胜赋短歌以畀寺僧时山斗汝耆文真梦吉德吉守道诸宗彦偕行","author":"程敏政","text":"诗翁远爱山峭拔，兴奇不忧霜径滑。\n支溪独木掉手过，势落颠厓几七八。\n翩然直到石门下，鬼斧劈山如劈瓦。\n中分一道白虹来，直薄巉岩速于马。\n岩口潭深杳难测，下有千年伏龙宅。\n自今泉石吾可专，世外何人空物色。\n山僧导前野老后，寒日四山风木吼。\n振衣长啸匝溪行，遥揖山灵尽三斗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47096,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过五城怀黄世瑞亡友","author":"程敏政","text":"落日五城道，怀人思不禁。\n村酤浇恨短，邻笛寄愁深。\n好古韩公辨，忧时贾傅心。\n百年公论在，吾道未消沈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47097,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"施秋官彦器公务至休宁汝彝黄司训过予请同登齐云岩中道值雨少饮阳山寺作时立春前五日","author":"程敏政","text":"冒雨追随出郭人，萧萧寒吹逼车裀。\n喜看赤地尘埃净，转觉青山面目真。\n多病此时心便足，奇观三匝句方新。\n广文须办重来约，五日东风又报春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47098,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"限韵一首","author":"程敏政","text":"路转东溪雨脚催，行窝聊驻白云隈。\n机舂堰水翻晴雪，梵起潮音激暗雷。\n遥看省郎双节过，暂为山主一尊陪。\n诗成却恐阴何笑，拨尽纷纷石鼎灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47099,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"庭梅盛开与施秋官黄司训联句三首 其一","author":"程敏政","text":"先春元是百花魁，历尽冰霜暖自回。\n冷艳不虞蜂见妒，清标应许鹤相陪。\n心中夙负调羹具，眼底终惭作赋才。\n愿与松筠结三友，罗浮山月待重来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47100,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"庭梅盛开与施秋官黄司训联句三首 其二","author":"程敏政","text":"几年京国梦梅花，香影真宜退士家。\n兴动巡檐频索笑，吟成煮雪一烹茶。\n向来红紫浑无赖，此去孤高讵有涯。\n颇觉逋仙心太苦，相看赢得鬓双华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47101,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"庭梅盛开与施秋官黄司训联句三首 其三","author":"程敏政","text":"一日花神遇赏音，岁寒于此见天心。\n阁杯且论閒边易，对雪谁声谱外琴。\n佳实终为商鼎用，暗香不许汉宫吟。\n山堂从尔增高价，杜老何须策蹇寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47102,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬夜烧笋供茶教子弟联句","author":"程敏政","text":"坐拥寒炉夜气清，烹茶烧笋散閒情。\n品从雀舌分佳味，价许龙孙得贵名。\n七碗喜催诗兴竦，百壶真谢酒权轻。\n疏窗已上梅花月，更取瑶琴鼓再行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47103,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"壬子元日试笔四首 其一","author":"程敏政","text":"春到山城晓色鲜，放臣赢得病躯全。\n田庐拙似安巢鸟，岁月忙于下水船。\n爆竹已惊残腊尽，屠苏犹在几人前。\n天公一霁开佳兆，稍卜丰年胜去年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47104,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"壬子元日试笔四首 其二","author":"程敏政","text":"渐及知非感二毛，履端佳庆遍江皋。\n八方共喜前星耀，万里遥瞻北斗高。\n蜜瓮酿春先试醉，短衣锄月敢辞劳。\n馀生已负酬恩地，惭愧君王旧赐袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47105,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"壬子元日试笔四首 其三","author":"程敏政","text":"眼见增崇企德祠，重来不觉鬓成丝。\n阳和一转当今日，文运中兴仰盛时。\n谁起邹郎新换律，我惭洛党旧分支。\n寒阶草色无人会，伫立东风有所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47106,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"壬子元日试笔四首 其四","author":"程敏政","text":"童稚欢迎伯仲陪，沿城一饷可周回。\n到门不用投新刺，煖岁翻劳泼冻醅。\n日落鼓声还杂遝，雨晴山色转崔嵬。\n春来第一诗成处，野老庭中得瓮梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47107,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"李太守诞日","author":"程敏政","text":"五十年光刺史身，却当人日庆生申。\n松筠饱历冰霜久，金紫沾荣雨露频。\n曲度鸾笙随律转，酒开银瓮泼醅新。\n凭将方寸长生地，散作山城一路春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47108,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和答庄定山年兄","author":"程敏政","text":"江外千峰剧九疑，梦回真见定山时。\n翠交草色春常在，活遍鱼苗水不知。\n素履只安持敬法，丹心都入愿丰诗。\n停云极目溪亭上，小圃群芳正陆离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47109,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿榆村宗人宗本","author":"程敏政","text":"青山如画酒如泉，高会分明十载前。\n锦轴为君题寿句，便惊春色满榆川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47110,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丰城涂处士夫妇哀挽 其一","author":"程敏政","text":"百世家声出豫章，萦垣乔木几斜阳。\n豸冠重写丰神伟，蠹简犹存手泽香。\n些曲漫成蒿里怨，吟筇閒倚菊篱荒。\n季方风节元方孝，身后谁能有二郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47111,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丰城涂处士夫妇哀挽 其二","author":"程敏政","text":"母仪真足重台端，联德应无愧伯鸾。\n白日雨寒神剑合，华堂春暖寿卮残。\n梦陪鹤驭身难返，恩宠龙章姓不刊。\n冢上谁题慈孝碣，淳风留与后人看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47112,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"约汪仲温过南山","author":"程敏政","text":"春绕南山花正开，一尊专待可人来。\n不辞共作寻芳客，预遣樵青扫径苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47113,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和答福建提学宪副罗明仲旧寅长","author":"程敏政","text":"蕉鹿当年亦漫惊，肯将家学负平生。\n六经药我苍颜在，万古行天白日明。\n多病一廛初去国，几人三馆旧同盟。\n春风桃李闽南路，谁道黄金不可成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47114,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"二月廿八日吕侍御惠新历","author":"程敏政","text":"春风疑不到山城，两月阴无几日晴。\n玉历初分试披检，已惊时节近清明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47115,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]