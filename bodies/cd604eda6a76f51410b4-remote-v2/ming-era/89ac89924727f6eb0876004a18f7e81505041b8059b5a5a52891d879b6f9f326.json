[{"title":"赠梁生琴士","author":"薛始亨","text":"不见梁生每永叹，朅来为我援琴弹。\n久逃东海羞秦帝，犹操南音戴楚冠。\n明月未应投反暗，阳春自是和皆难。\n扁舟将子偕容与，白尽芦花倚醉看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39906,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访陶隐君","author":"薛始亨","text":"摇落空山赋采芝，秋风门巷草离离。\n衣冠一自悬神武，甲子何曾纪义熙。\n夜永鹤鸣松露坠，谷深蝉噪柘光欹。\n颇闻明府轻馀子，莫讶狂生诩大儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39907,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访区叔永","author":"薛始亨","text":"锦鲤相思一水通，翩翩海曲见冥鸿。\n林间危坐西畴雨，窗里高眠夏月风。\n长剑旧沾辽雪冷，短筇曾挂岳云空。\n尊倾不厌疏狂客，绿鬓忘年对孔融。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39908,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠莫休倩","author":"薛始亨","text":"情人一见若披云，向暮江村柳絮纷。\n曾客五陵衣短褐，尚馀双泪洒高旻。\n梦回芳草天涯远，卧听邻鸡晓漏分。\n莫忘对床风雨话，湖山他日更期君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39909,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"区叔永携酒偕弈客见访用前韵","author":"薛始亨","text":"花暗溪边半亩宫，秋来犹见几枝红。\n日高素案彫胡熟，雪满青山坐隐工。\n学道每羞连骑客，息机方作灌园翁。\n大儿原是忘年者，况复相逢酒不空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39910,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠张都护孙绳","author":"薛始亨","text":"天上勾陈映列营，长河如带忆卢城。\n十年弃马霜蹄破，四壁饥鹰雪羽轻。\n夜饮霸陵呵李广，薄游榆次目荆卿。\n貂裘且向花前典，猿臂俄看柳已生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39911,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曹溪礼大鉴禅师塔","author":"薛始亨","text":"掬水西来识肉身，法衣夜嘱岭南人。\n一花五叶终成果，明镜非台不惹尘。\n幡影度风禅刹夕，锡声含雨石泉春。\n游踪未晤无文字，唐代遗碑读尚新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39912,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上怀所钦","author":"薛始亨","text":"银汉迢迢大火流，兰桡弭节揽中洲。\n远书未寄逢征雁，暮杵初鸣对素鸥。\n舞影每孤鳷鹊镜，琴心空敝鹔鹴裘。\n卿卿不惯如泥醉，离梦风吹上翠楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39913,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送岑金纪游琼海","author":"薛始亨","text":"朱厓云际即天池，词客南浮岁晏时。\n万斛海舟轻一叶，五山猺洞接诸夷。\n珠胎入夜生明月，鹏化先秋起飓飔。\n吾道不行身欲老，乘桴空与此心期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39914,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠愚公","author":"薛始亨","text":"故人流落鬓星星，重忆当时涕欲零。\n躞蹀控残朱户改，琵琶弹罢玉楼扃。\n南冠一别成缁染，旧国无归任梗萍。\n看破豪华真是梦，龛灯长愿诵金经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39915,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿冲虚观","author":"薛始亨","text":"春水新乘锦鲤鱼，梅花路入葛仙庐。\n月笼药市啼红翠，云锁瑶坛秘绿书。\n玉舄遗轩通碧落，羽衣荒冢傍冲虚。\n钧天何处劳清梦，石室閒调五野猪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39916,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答区叔永沅溪见怀","author":"薛始亨","text":"闻道荷衣赋遂初，草茅谁念卜诛锄。\n金门一谢三升恋，环堵偏垂五柳疏。\n岭合鸾栖云外啸，春归燕拂袖中书。\n青青兰芷思公子，欲向沅溪驾鲤鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39917,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别朱锡鬯","author":"薛始亨","text":"黯然挥手向江干，暮雨凄凄失笑欢。\n鸿鹄怜君翻远举，芙蓉使我佩忘餐。\n素心晨夕幽居好，青岁飘零行路难。\n龙性岂堪邻马队，凤趋何日问渔竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39918,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮度庾岭","author":"薛始亨","text":"鸡鸣关月照蘧庐，马色寒生雪霁馀。\n客梦不成灯已烬，归程况是岁将除。\n荒原罢牧经寒烧，远水分流入晚畲。\n每向道傍添白发，悔抛田里载私车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39919,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春羊城社集","author":"薛始亨","text":"南园春草遍池塘，客里邀欢一举觞。\n上巳风流传曲水，建安词赋擅清漳。\n江云莫辨三株树，驿路难寻五色羊。\n谁道海滨邹鲁地，咏归还有舞雩狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39920,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱芝园侍御过访赋赠","author":"薛始亨","text":"结驷翩翩问草莱，后车犹羡托邹枚。\n天潢江汉垂南纪，斗柄招摇接上台。\n中垒上书空往事，小山有赋未归来。\n建安邺下非今日，珍重淩云独步才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39921,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄山人耀之新跛戏之","author":"薛始亨","text":"闻道篮舆病益贫，葵心日暮更忘身。\n凤栖未献空完璞，骥伏长鸣枉绝尘。\n门下不须识子产，车中还可坐孙膑。\n小冠制就传经倦，莫注春秋学半人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39922,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙江紫云岩集唐句","author":"薛始亨","text":"故园归去又新年，重到云居独悄然。\n丹凤昼飞群木冷，骊龙春暖抱珠眠。\n孤高堪弄桓伊笛，壮志仍输祖逖鞭。\n几处松筠烧后死，绿杨花扑一溪烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39923,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王迈人太守擢宪粤西","author":"薛始亨","text":"旄节前麾海气森，霜威初动岭云阴。\n雄文再睹驱鱼笔，雅操终存酌水心。\n古洞石床窥鸟迹，西江官舫听猿吟。\n清风相送沉香浦，秋月遥生八桂林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39924,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄区叔永兼答论文之作","author":"薛始亨","text":"漫笑嵇康七不堪，还怜太史滞周南。\n人归沅水滋兰蕙，天接西江入蔚蓝。\n脉望化时空二酉，绵蛮啼处挟双柑。\n典型幸及徵文献，涩体何心学筱骖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39925,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"塞上","author":"薛始亨","text":"营开一望四郊空，阵破长驱疾雨风。\n明月汉关雄嶪嶪，暮云秋碛远濛濛。\n旌摇重雪朝穿甲，指堕寒冰夜挽弓。\n征戍每年穷塞北，惊心客处绝飞鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39926,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄锡山朱赋游兼怀蜀中王使君","author":"薛始亨","text":"偶入红尘忆去年，逢君如饮惠山泉。\n洞箫行酒庭无暑，广袖淩风客欲仙。\n别后谁持霜下蟹，愁来独听夕阴蝉。\n交游海内论知己，巫峡秋深隔楚天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39927,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旧识邯郸歌妓后入靖江藩府藩国遭乱姬遂流落偶于逆旅逢故宦者述姬寄语","author":"薛始亨","text":"零落中涓泣道傍，侯门曾识杜韦娘。\n玳筵洒露邀词客，羯鼓飞尘脱舞裳。\n湘竹泪凝虞庙暗，巫云梦断楚台荒。\n邯郸羞比才人嫁，愁倚西风寄八行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39928,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过方流堂","author":"薛始亨","text":"二毛秋入竹皮冠，病起私怜束带宽。\n策杖独过文杏馆，持盐还醉水晶盘。\n松摇山月侵孤幌，鹤舞庭烟起曲栏。\n苛礼岂为吾辈设，清言直到夜将残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39929,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将入罗浮书南枝堂壁","author":"薛始亨","text":"江天露下忆清都，浊世飘零酒一壶。\n心似暮花逢处谢，影同秋月入宵孤。\n云林鹤警三洲枕，石室龙耕九节蒲。\n风佩珊珊从此去，铁桥高揖列仙儒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39930,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"烂柯山赠朱道士","author":"薛始亨","text":"庞眉松下诵黄庭，座有新锄白茯苓。\n每步斗罡曾验诀，但称甲子不知龄。\n正容少倦时危坐，法语无多待细听。\n爱客见留今夕永，石坛高树隐疏星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39931,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬朱德先琼州见怀","author":"薛始亨","text":"芳草王孙尚未归，群鸥海上已忘机。\n金丹欲附青冥翼，玉趾曾过白板扉。\n翡翠度烟秋岸阔，桄榔吹雨估船稀。\n劳君千里长相忆，为报加餐但采薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39932,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿景山人","author":"薛始亨","text":"不将奇筴谒重瞳，却醉秋霜入橘中。\n绿发岂随沧海变，素衣曾拂洛尘空。\n清高堪并吴门隐，骚赋原推楚客工。\n闻说卧游多胜事，扁舟还忆五湖东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39933,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送查伊璜携妓还西陵","author":"薛始亨","text":"越台倦客感飘蓬，腊尽遥天岭树空。\n远志东山鸿鹄羽，将离南海马牛风。\n井中投辖筵初散，梁上流云曲未终。\n春到湖堤君试看，渡江梅叶比花红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39934,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"劳奇玉见访","author":"薛始亨","text":"逸羽翩翩万仞翔，更怜高论挟风霜。\n大廷封事存师友，名岳藏书辨霸王。\n十载灌园惟古处，几人佐锻共清狂。\n岁寒未减松筠色，肯拨蓬蒿过草堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39935,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊戌岁暮","author":"薛始亨","text":"山市犹喧夕已曛，岁残人事各纷纷。\n桥逢白鹤谈尧代，家乏黄羊似灶君。\n逋客星霜容易改，草堂蟋蟀不堪闻。\n嘉平欲向桃津问，何处骑茅上紫氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39936,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴妙明女真人还罗浮时真人有玉京上元之召","author":"薛始亨","text":"海客曾乘八月槎，名山原属列仙家。\n松巢老鹤将雏子，石壁苍藤落细花。\n绛节有期朝玉阙，芳词何处寄瑶华。\n上清路比明河远，秋入无缝片片霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39937,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顶湖山栖壑律师道场","author":"薛始亨","text":"云根寒彻水泠泠，开士严居雪满扃。\n上品莲台皈净土，六时禅诵入青冥。\n老猿解学跏趺坐，慧鸟能持般若经。\n葬石自从成幻化，昼间花院响风铃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39938,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邺台怀古","author":"薛始亨","text":"清漳自绕邺城边，霸气雄图入野烟。\n蒲叶唾残千里井，豆萁歌断上留田。\n周文事业惭分鼎，宋玉风流惜感甄。\n铜雀至今春不锁，应徐羁旅忆当年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39939,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杜门后答友人僧舍见寄","author":"薛始亨","text":"古木垂藤委巷穷，柴门长掩鸟声中。\n风光傍砌怜书带，日影沉溪怯射工。\n孤磬每参音响断，残灯时窹燄华空。\n故人欲问春来事，颇与禅关老衲同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39940,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠林勋卿","author":"薛始亨","text":"竹里悬车十载间，萧然光禄在东山。\n酒船爱客金鱼换，经笥传家玉笋班。\n半岭烟霞闻凤啸，三朝火藻近龙颜。\n未论卿月临宵迥，沧海清辉岂易攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39941,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"素有足疾近苦头风伏枕经旬摩顶放踵慨然兴怀","author":"薛始亨","text":"频年服饵慕身轻，赢得萧萧白数茎。\n皂帽移家仍是客，篮舆没世可怜生。\n登台纵遇房中笑，传檄应教枕上惊。\n老去臣精销已尽，唾壶愁击不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39942,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居","author":"薛始亨","text":"一枝深卜白云邻，生事萧条着葛巾。\n织素女娇真似玉，辟纑妻老尚如宾。\n清斋法供梵音静，浊酒农谈野趣真。\n桃核昔遗今作树，几株溪畔不胜春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39943,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟泊平步寻孙典籍蕡读书堂 其一","author":"薛始亨","text":"三百年来生也晚，溯洄孤棹访前徽。\n阁寒藜火遗编在，床落琪花旧国非。\n自昔垆头鸾独铩，只今华表鹤无归。\n明堂大雅空宵梦，甚矣吾衰泪满衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39944,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟泊平步寻孙典籍蕡读书堂 其二","author":"薛始亨","text":"黯黯残云吊夕晖，高才沦落圣朝稀。\n攀龙不为迟冯衍，闻鹤翻怜误陆机。\n百里枌榆乡土接，一廛耕凿子孙微。\n风流莫问长江水，惟有南园蝴蝶飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39945,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟泊平步寻孙典籍蕡读书堂 其三","author":"薛始亨","text":"荒村寒木掩荆扉，人指词臣旧钓矶。\n再召长沙恩未薄，一辞彭泽愿终违。\n年深颓壁棠梨长，日落空田鸟雀饥。\n何处羊裘江畔客，清时犹食越山薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39946,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送梁生东归","author":"薛始亨","text":"倦客东关赋五噫，轻裘数事故时衣。\n野棠花外春归棹，山鸟声中昼掩扉。\n寄养鹤应朱见顶，手栽桐定绿成围。\n人间行路难如此，十亩江苗莫叹饥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39947,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈生游吴 其一","author":"薛始亨","text":"清霜南浦折芙蕖，黄叶秋风恨索居。\n送客暂倾千日酒，辞家宁为四腮鱼。\n吴王苑外乌啼早，范蠡湖边雁影疏。\n从此论文中夜月，寂寥空掩旧精庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39948,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈生游吴 其二","author":"薛始亨","text":"乍到金焦泛淼茫，广陵涛气切帆樯。\n参差白日□京县，留滞浮云非我乡。\n三月烟花迷枉渚，六朝钟鼓冷斜阳。\n将军何处闻高咏，枫叶纷纷客路长。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39949,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过江村访朱屺孺明府","author":"薛始亨","text":"高柳门前一水清，几年傲吏濯尘缨。\n解颐每逞雕龙辩，强项曾知卧虎名。\n莲社晚招篮舆近，杯湖秋放酒船轻。\n自怜缝掖今时贱，客里劳君倒屣迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39950,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜别楚公子","author":"薛始亨","text":"怜君归去鬓如丝，欲赋平生愧景差。\n客舍空囊馀宝剑，离筵残烛罢枯棋。\n霜悬橘柚荆门路，月照蒹葭桂水涯。\n愁向梦魂中断处，更凭南雁寄相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39951,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄怀江夏隐士艾木田","author":"薛始亨","text":"横槊吟边积战尘，息机空羡汉阴人。\n祇园腊度恒沙劫，茅屋秋归四壁贫。\n冷月庭中垂橘柚，闲花门外落荆榛。\n只今马队多名士，谁拟从君颍水滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39952,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归次三水","author":"薛始亨","text":"萍踪两月逐浮沤，千里归心系客舟。\n潮拍远天江欲曙，烟开晴浦岸初秋。\n担簦已谢虞卿璧，负郭应嗤季子裘。\n渐近乡园对寒色，寻思去住转生愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39953,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙江贞女桥","author":"薛始亨","text":"贞女高踪方万古，石桥功德亦难酬。\n年深庙祀何人问，日落墟烟故老讴。\n银汉影横秋寂寂，华畿路断水悠悠。\n只今多少鸣驺过，翻笑空闺甘白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39954,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登冈州东城马山寺访丹徒谈蘧怀留别","author":"薛始亨","text":"申旦高吟客未归，冈州新霁见容辉。\n钟清小院分禅榻，荷绿他乡换旅衣。\n东郭寥寥天籁发，南冥淼淼夏云飞。\n何堪衔取啁啁羽，来伴空城雀苦饥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39955,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游江门深入云潭寄答邑宰翁念吾","author":"薛始亨","text":"曾闻紫水溯关闽，千尺流波欲问津。\n岭半若为舒啸处，风前谁念舞雩人。\n官衙静掩高悬榻，客路凉生折角巾。\n今日弦歌比邹鲁，岂劳盂薤访州民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39956,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辛卯乱后重寻白沙先生故居","author":"薛始亨","text":"高衢牢落乱离情，三亩儒宫野草生。\n火后壁经蝌蚪缺，锄残笔冢蠮螉鸣。\n黄云脱屣留芳躅，白发峨冠想濯缨。\n世去百年居又近，自伤迟暮道无成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39957,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜度海门寄诸弟","author":"薛始亨","text":"霜满空江夜气清，海门更下客舟轻。\n月高罢棹候潮上，风急举帆闻浪鸣。\n衰鬓又逢秋叶落，愁心偏向晓云生。\n岁华将晚归期早，雁断浓烟字不成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39958,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送谈蘧怀还京口","author":"薛始亨","text":"郊寺钟声午寂寥，卢城送客雨潇潇。\n桃花春水长江路，杨柳离亭二月条。\n但有白云过北固，能无清梦到西樵。\n淹留多少骚人赋，归去淮南隐可招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39959,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过宿海幢寺时空和尚病疡将归罗浮余不及追侍","author":"薛始亨","text":"一水人间宛隔天，海龙长护上方禅。\n冥丘观化俄生柳，劫火经烧忽涌莲。\n潮落夕曛黄木口，露浓春曙素馨田。\n东游须借琴高鲤，鹤米新来缺闰年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39960,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答陈元孝订游罗浮","author":"薛始亨","text":"陆沉无地不扬波，清梦谁怜在薜萝。\n济胜一生长蜡屐，服奇将老漫烟蓑。\n山僧旧有参禅契，词客新赓招隐歌。\n心想定须身共到，莫徒留韵付羊何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39961,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈元孝游罗浮而不携酒余病不果往雨中寄怀","author":"薛始亨","text":"攒眉无酒病兼侵，之子飘然入碧岑。\n月黑见灯知哑虎，风清闻杵识仙禽。\n重游福地凭身健，一堕人间苦障深。\n今夜梅花应笑客，独醒那得梦相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39962,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄耀之归自海外过赋得分字","author":"薛始亨","text":"飘零双鬓雪纷纷，笑整南冠带海云。\n丁令乍归为鹤语，左慈曾化入羊群。\n琴调碧玉临流水，酒泛黄花对夕曛。\n心折时危身似梦，相逢还恐又离分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39963,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"有叟来自句容携一童子入朱明洞诛茅力耕采药自给不言其姓只称觉非道人予异其踪将往从之奉此寄怀","author":"薛始亨","text":"华阳地脉接罗浮，鹤发真人住石楼。\n风息天池看野马，烟销海市对江鸥。\n采苓方伴青精煮，种菽将为白酒收。\n半岭欲闻鸾凤啸，芒鞋期在菊花秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39964,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大科峰见日台","author":"薛始亨","text":"寒光一片上芙蓉，万壑含秋独倚筇。\n风静渔歌来极浦，云深鸡唱隔高峰。\n凭虚始觉天难问，绝顶方知道未从。\n心迹泠然双寂寞，移情何处觅仙踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39965,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀阮伯髦中秘 其一","author":"薛始亨","text":"当日金门卧岁星，赤符曾奉汉皇廷。\n长杨自悔雕虫技，句曲新传瘗鹤铭。\n溪上潇潇千亩绿，檐前历历数峰青。\n最怜蜡屐乘秋色，应向垆头挈榼瓶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39966,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀阮伯髦中秘 其二","author":"薛始亨","text":"村北村南万竹林，曾逢青眼对嵇琴。\n人从薇省辞清切，家在芝田笑陆沉。\n神虎筐边丹杏熟，化龙杖底碧云深。\n苍茫野水蒹葭外，谁念相思永夕吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39967,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]