[{"title":"登马岭关口","author":"王世贞","text":"回崖宛转异晴昏，片白浮空列戍尊。\n一线地排为北戒，双轮天捧作中原。\n蘋端噫气千崖拆，木杪蒸云万古屯。\n我欲著书从此逝，毋烦令尹候关门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11227,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"许殿卿左史有悼内之戚请告归里赋此寄赠","author":"王世贞","text":"休沐周原可惮劳，悼亡潘鬓转萧骚。\n烟霞不逐长裾老，霜月还依拥传高。\n暂去临邛无卓女，将归梁苑有枚皋。\n君看醴酒缘谁设，莫向春风恋浊醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11228,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"履魏三日受筴易州行府承诸公为会高台有作","author":"王世贞","text":"秋声忽傍羽书寒，易水萧条雁影残。\n今日和戎无魏绛，当时结侠有燕丹。\n府僚高宴从军乐，客子悲歌行路难。\n莫向旧台称买骏，倦游无计可辞官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11229,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登黄寺堡太平楼作","author":"王世贞","text":"秋风列戍满邢州，敢为筹边独上楼。\n千骑月回清啸响，一尊天豁大荒愁。\n移屯渐老韩长孺，作客谁怜马少游。\n出处圣朝应易得，即论非土竟谁留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11230,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"真定谒大士像十二年矣薄暮复过此留题","author":"王世贞","text":"中天飞刹逼星辰，曾睹莲花法像真。\n千劫不贪调御位，十年仍现宰官身。\n恒河暝借金篦指，大卤云争宝髻新。\n彼岸祇应容尔度，可能无意问津人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11231,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"真定陈使君邀饮大悲阁","author":"王世贞","text":"恒阳霜后洗嵯峨，宝界横开窣堵波。\n万里悲风吹大陆，千山落木下滹沱。\n尊前暝色灵鹙破，坐里边声法雁过。\n不是摩尼能夜炯，自来和璧赵王多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11232,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄谢茂秦","author":"王世贞","text":"罢醴谁堪邺下居，世情秋共鬓毛疏。\n家移潞子云边国，门少梁王雪后车。\n歌罢此生唯短铗，赋成何地不长裾。\n漳流转自并门上，可怪天南断鲤鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11233,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"调方景武方长仅三尺而为戚大将军幕客","author":"王世贞","text":"宽裾乍曳蓟门尘，曾睹新篇动七闽。\n名似要离那恨小，请同方朔莫言贫。\n东门此去无长狄，上帝由来有弄臣。\n见说府公难喜怒，可将书记属王珣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11234,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得谢茂秦寄新集时孔汝锡冯汝言二公为刊定","author":"王世贞","text":"十载兰心托路岐，凌云綵笔健谁知。\n还寻玄晏先生序，共表邯郸幼妇辞。\n不尽交游天并老，重来作者世应迟。\n君看党锢中兴解，可忘龙门御李时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11235,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东明送别郜侍御子元","author":"王世贞","text":"浊酒邮亭感慨频，知君此去有埋轮。\n乾坤不尽开时色，霜雪长含至后春。\n贾傅总能忧圣主，郑公元自爱良臣。\n人间大有澄清地，岂必沧波问逆鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11236,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪后同杨少参张山人分韵 其一","author":"王世贞","text":"连城十二吐明光，极目千村混渺茫。\n微雨忽扶鳷鹊出，峭风徐起玉虬狂。\n歌成郢曲人为宋，赋就相如苑是梁。\n拟向瑶池看戴胜，不教晴旭捧扶桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11237,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪后同杨少参张山人分韵 其二","author":"王世贞","text":"飞甍雪霁拥岧峣，睥睨光凝迥未消。\n白凤羽从全魏落，苍龙鬐挂浊漳遥。\n褰帷秀色峥嵘至，信马寒声凿落骄。\n却忆西山多气象，千官拄笏紫宸朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11238,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪夜使院有感","author":"王世贞","text":"雪色将风警独愁，不眠中夜揽貂裘。\n层关七萃歌黄竹，故里文君咏白头。\n宦路艰如秦岭骑，客情轻似剡溪舟。\n渔灯社酒真堪托，何必征途始倦游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11239,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪后十日始大晴喜作","author":"王世贞","text":"十日雪阴今日晴，北窗旭红吾眼明。\n树头玉花故片片，檐底珠雨时声声。\n总愁千村露摇落，暂喜二候还澄清。\n放衙蜡屐何所念，石湖湖头双桨横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11240,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄郑山人若庸","author":"王世贞","text":"平台宾从怅离群，岁晏鸿书喜乍闻。\n太守可题通德里，故人谁是信陵君。\n邺中玄醴寒于水，稷下雄谈逞似云。\n俱道少年输济胜，青囊肘后若为分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11241,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄吴明卿","author":"王世贞","text":"十年调笑殿中郎，?阁空传下凤皇。\n天到七闽犹未尽，人过五岭向谁狂。\n青云究至疏词客，白雪于今满瘴乡。\n总为明时应少住，莫教寒色甚潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11242,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中山遇罗参政国华自蓟镇被言调归","author":"王世贞","text":"屈指层关百战馀，运筹开府几人如。\n宁因大汉无长策，自是中山有谤书。\n千帐寒声争伏匿，七陵佳气拥储胥。\n篝灯欲竟防边事，怕遣霜毛一夜疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11243,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢中丞翁公孺参","author":"王世贞","text":"宪府寒开济上春，百城公吏望清尘。\n櫜鞬不动趋庭色，杯酒还叨入幕宾。\n末路雕虫惊眄睐，当年塞马出酸辛。\n投君明月寻堪掩，何处能无按剑人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11244,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"承于鳞为先公作传将勒石墓道聊抒鄙感","author":"王世贞","text":"攀柏千年黯自悲，九京心事向谁期。\n新题季予延陵墓，不数中郎许下碑。\n震泽涛声寒雪涕，天山冢色卷云旗。\n江南倘有回鞍日，更与重披绝妙辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11245,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀岑绍兴允穆","author":"王世贞","text":"忆尔飞书请尚方，一时风裁许谁当。\n丹心昼捧丹山日，白简春生白下霜。\n总为马迁奇禹穴，不教长孺薄淮阳。\n兰亭禊月仍堪赏，倘有新编可寄将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11246,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"途遇徐宁波迁广臬率师平寇有赠","author":"王世贞","text":"即教瓯越威南越，故转宁波号伏波。\n五马春将时雨去，千帆秋破瘴烟过。\n折冲樽俎谁堪儗，治郡功名业已多。\n此夜相逢便为别，欲翻铙吹入离歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11247,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄杨伯章提学","author":"王世贞","text":"曾向兰台挹御芬，中原桃李又归君。\n房心好映三台象，河洛仍开万古文。\n经术相家韦氏擅，秀才门客汉庭闻。\n应知大夏须梁栋，二室长松有卧云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11248,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己巳大名元日试笔","author":"王世贞","text":"冯扶帝里未全遥，物色王正喜更饶。\n四海三新隆庆朔，百年两见孝宗朝。\n条风应候吹仍暖，腊雪留祥炯不消。\n一酌椒花还自慰，颇闻迁地近渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11249,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"于鳞自浙藩迁长汴臬时予实为代有赠","author":"王世贞","text":"十年清泌未蹉跎，已见三台岁里过。\n盛世词坛牛耳在，中原宦迹凤毛多。\n梁园再起千秋雪，汴水遥增万里波。\n薇省至今江左地，代兴公意竟如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11250,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正月十六日于鳞会于齐河挟一生为姑布术者","author":"王世贞","text":"天涯得代非为远，元夕初过尚勒春。\n小酌可成烧尾宴，壮心俱付耗磨辰。\n原无蔡泽轻肥想，自喜桓伦历落人。\n不是誇君轻去就，五湖生事未全贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11251,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过滁州赠太仆簿许元复","author":"王世贞","text":"邮亭徙倚对斜晖，宦兴如君可不微。\n小吏时时牵马过，新书种种换鹅归。\n苍山迹忆环滁古，青史人堪拟岘非。\n胜具自来饶许掾，莫教春色负褰衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11252,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡江天界寺会舍弟作","author":"王世贞","text":"北风归骑卷黄埃，柳色江春一棹开。\n厌俗聊依天界住，参方端为世亲来。\n昙花暖借荆花发，雁塔高鶱雁序回。\n任使远公饶酒戒，可能相见废衔杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11253,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡江承吴中丞惟修出访有赠","author":"王世贞","text":"二月江春霜色寒，俄闻骢马出台端。\n借来汉剑环同赐，哭罢秦庭璧遂完。\n一代风棱南史笔，两朝天意惠文冠。\n孝陵只在钟山里，紫气千秋仗尔看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11254,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"莺脰湖洗天亭月夜与公瑕子念王复舍弟饮别 其一","author":"王世贞","text":"湖光天色澹相和，今夜离筵乐更多。\n云作翠屏装宝镜，风为金斗熨青罗。\n尊前鹦鹉知衡在，曲里含桃柰郑何。\n一水峭帆归便得，不须低首怨骊歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11255,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"莺脰湖洗天亭月夜与公瑕子念王复舍弟饮别 其二","author":"王世贞","text":"为尔狂歌思欲飞，壶中天地到应稀。\n玉山偏软乌程酒，银露徐欺白苧衣。\n月色总依双旆在，风流俱逐片帆归。\n西湖自好谁行乐，始信浮荣有是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11256,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钱塘遇江侍郎顺之南归有赠","author":"王世贞","text":"江上逢君对莞然，自矜挥手秣陵烟。\n两朝倾捧心长赤，八座归来鬓尚玄。\n天意笔留常侍在，主恩车借大夫悬。\n故人潦倒仍趋府，愁记含香并署年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11257,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自吴兴寄于鳞大梁","author":"王世贞","text":"忆醉齐南白玉壶，浮云天地为踟蹰。\n高名自汝中诸岳，傲吏堪谁长五湖。\n亭午夷门过结辔，乍晴苕上有归舻。\n他时大陆仪鸿羽，回首中兴意未孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11258,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"由钱塘门度六桥堤","author":"王世贞","text":"拂幰莺啼出谷频，长堤天矫跨苍旻。\n六桥天阔争虹影，五马飙轻散曲尘。\n碧水乍摇如转盼，青山初沐竞舒颦。\n莫轻杨柳无情思，谁是风流白舍人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11259,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜登吴山访紫阳庵即事","author":"王世贞","text":"吴峰顶畔市烟霏，裁脱红尘便翠微。\n城外春山城里色，树根流水树头飞。\n逶迤踏月疑沾屩，䆗窱藏云暗湿衣。\n解道丁家留鹤蜕，至今华表未闻归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11260,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同年马通政吴太常顾沈二臬及凌守要予与蔡宪使饮太虚楼","author":"王世贞","text":"不须槎上访蓬莱，咫尺云霄法象开。\n挟日千峰凌睥睨，浮天万顷浸楼台。\n西泠棹影烟从破，下界钟声晚自来。\n十载故人尘外景，醉翁宁为酒徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11261,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"飞来峰","author":"王世贞","text":"涛声不断舞苍虬，忽尔巑岏万玉抽。\n劫尽修罗移佛土，愿深阿育涌南洲。\n悬崖宛转疑龙藏，叠岭鶱腾尽鹫头。\n自有真如飞不去，幻躯天地任沈浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11262,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉泉寺观鱼","author":"王世贞","text":"寺古碑残不记年，清池媚景且留连。\n金鳞惯爱初斜日，玉乳长涵太古天。\n投饵聚时霞作片，避人深处月初弦。\n还将吾乐同鱼乐，三复庄生濠上篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11263,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北高峰望大江暮归即事","author":"王世贞","text":"扪萝直上鹫峰头，缥缈平沙瞰碧流。\n匹练中分吴越地，双高对表帝王州。\n凭虚霁景骄相袭，入暝湖光炯不收。\n扶路啸歌那觉晚，丽谯清响滴银虬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11264,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游净慈寺","author":"王世贞","text":"拥刹芙蓉翠欲翔，拂云双练吐寒香。\n十千乾闼婆天乐，五百阿罗汉道场。\n未必应真超劫火，还因胜地属空王。\n南园实傍珍珠墅，指点烟踪并渺茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11265,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与诸公携酒昭庆戒坛陈少参从僧讲律仪口嘲","author":"王世贞","text":"白莲社前倒玉缶，僧将戒律宰官听。\n三车菩萨何妨圣，五柳先生不爱醒。\n家家湖水门前绿，处处春山雨后青。\n识得此中无染意，波旬能唱梵王经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11266,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送比部吴枢季之金陵时舍弟在仪部","author":"王世贞","text":"东山六月下何迟，此去风流建业知。\n行李夜投朱雀巷，墨花秋染白云司。\n棠阴故郡迎舟出，槐色清人抱案移。\n欲觅阳春春署在，侬家团扇是新词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11267,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠潘中丞时良尝视北畿学按部南中","author":"王世贞","text":"十年华省隔鸣珂，惊见勋名霄汉多。\n揽辔马群空冀北，按章霜色扫牂牁。\n中丞饷道专持节，天子宣房宠赐歌。\n何似君家潘博士，萧条拙宦二毛过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11268,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邀中丞潘时良大参陆理之登岘山作","author":"王世贞","text":"岘山云锁玉璘珣，洼顶尊开兴自新。\n名胜东南元此地，文章潘陆更何人。\n平湖涨起高青雀，刺史吟成老白蘋。\n虾菜吴兴知不贵，过从休惜郡厨贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11269,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陆大参别余与潘中丞登飞英塔","author":"王世贞","text":"招提只在白云封，绝顶岧峣望莫从。\n忽有丹梯通箭栝，还如玉井护芙蓉。\n菰城午色烟争袅，苕水春流雨自重。\n可道诸天无别思，愁君明日度千峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11270,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"袁鲁望考功奏最不上与舍弟留饮白下赋此促之","author":"王世贞","text":"三月朝天理传车，不将留滞惜居诸。\n清曹爱弟难为别，上考知君已自书。\n酒尽长干须策马，花明幕府又牵裾。\n何如且作移旬去，鲈鲙莼丝到有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11271,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黎惟敬内翰自南海访余吴兴登岘山分韵 其一 得蘋字","author":"王世贞","text":"为具青山莫厌贫，天涯惊见赏心人。\n还将温室中郎树，来咏吴兴太守蘋。\n霅水远拖双带玉，何峰斜抹一钩银。\n明朝尘世应誇取，未必蓬莱事事真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11272,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黎惟敬内翰自南海访余吴兴登岘山分韵 其二 得湘字","author":"王世贞","text":"岘山亦是关情地，屈指从君话旧长。\n此夕梅花辞大庾，十年秋雁隔清湘。\n应徐笔底多陈迹，吴粤尊前暂一乡。\n披藓为磨方石在，祇凭诗句敌襄阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11273,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别惟敬北上兼简梁舍人","author":"王世贞","text":"渺渺吴江西逝波，峭帆风紧奈君何。\n遇来龙剑无长合，裁就骊驹未忍歌。\n鸡舌可沾供奉赐，凤毛谁较舍人多。\n中朝旧是誇联璧，晓对双星白玉珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11274,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送长谷徐先生赴罗仙翁约炼药玉阳山房 其一","author":"王世贞","text":"青鸟衔书向薜萝，下元今日上升多。\n西行侍者还徐甲，无上仙人是大罗。\n玉柱故应句曲有，瑶箱只待阿环过。\n三天倘草诸公制，谁应宏词第一科。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11275,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送长谷徐先生赴罗仙翁约炼药玉阳山房 其二","author":"王世贞","text":"闻君拟炼大还丹，与唱仙家行路难。\n空里云车骄欲堕，风前石髓健堪餐。\n胡髯日射黄金鼎，蜕骨天遗白玉棺。\n何似羃䍦藏宛若，年年春色醉长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11276,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岘山赠故孙宪副","author":"王世贞","text":"十年归汎五湖舟，蓬鬓翛然守一丘。\n家似桃源非避难，身如桑楚更奚求。\n紫衫不解为何物，青眼唯将向旧游。\n好语吴兴诸掌故，岘山今日重风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11277,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陈太常廷祼","author":"王世贞","text":"帝念先朝折槛郎，徵书贺色动明光。\n还将白简酬青琐，不厌清斋守太常。\n天峻容台多日月，夜严宣室傍星霜。\n未须论到波臣事，推案看山也自强。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11278,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"御史大夫南充王公俯为先君子作传悲感之极情见乎辞","author":"王世贞","text":"中丞自握如椽笔，绝胜班生在石渠。\n片语褒能光日月，千秋事敢借吹嘘。\n从看京兆阡头草，长护延陵墓里书。\n纵有鲛人一掬泪，不堪持报愧恩虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11279,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠杨锦衣今太宰公子时上以秋日大阅杨当扈从","author":"王世贞","text":"左櫜明月绣蝥弧，右箙连星银仆姑。\n别赐戟门丞相里，新从缇骑执金吾。\n山西将帅古来有，越公儿郎天下无。\n夺得头标还草檄，君王宴镐赐醍醐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11280,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同年彭子殷贻诗见寄君令新淦三月而调郎白下一岁而免","author":"王世贞","text":"屈指行藏转自嗟，让君今日弄烟霞。\n千秋建业归时草，三月河阳梦里花。\n揽镜清霜争岁色，题诗白雪失天涯。\n江州卤簿由来简，倘许相携过酒家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11281,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柳洲亭即事作","author":"王世贞","text":"紫微分馆曲城阿，碧甃朱栏奈胜何。\n一一芙蓉争插汉，双双舴艋戏回波。\n烟将暝色归萝薜，风引歌声出芰荷。\n今日吴兴使君道，柳洲佳较白蘋多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11282,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送范状元伯祯召入尚宝时君乡大水予方有疏请恤","author":"王世贞","text":"先朝开殿策贤良，第一鹓班侍玉皇。\n仙籍谪来唯太白，岁星收去是东方。\n西清共识含香吏，中禁仍呼尚玺郎。\n最是天颜朝暮接，可能垂省度支章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11283,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大宗伯董丈用均初度","author":"王世贞","text":"屈指先朝供奉班，柏梁高倡更谁攀。\n宁因八座方称贵，总为千秋暂许閒。\n吏部文章天北斗，吴兴名胜地东山。\n当时乞取仙桃在，炼得瑶池醉里颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11284,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宗伯董丈枉饮岘山泛碧浪湖时范太史伯祯陈都谏体乾在坐太史将赴召北上宗伯遂成一章予嗣得其二一用公原韵一用近赠公韵 其一","author":"王世贞","text":"诸贤名价重南州，岘首吴兴亦胜游。\n痛饮争呼明月至，狂歌欲断彩云流。\n那知碧浪重湖夜，别作金台万里秋。\n我是安期饶落穆，过江今日始言愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11285,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宗伯董丈枉饮岘山泛碧浪湖时范太史伯祯陈都谏体乾在坐太史将赴召北上宗伯遂成一章予嗣得其二一用公原韵一用近赠公韵 其二","author":"王世贞","text":"承明促入旧仙班，此日膺舟尚许攀。\n返照只看归鸟乐，临风仍羡去鸿閒。\n夕郎高议传青琐，学士清盟向碧山。\n独有周南留滞客，懒将秋水照颓颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11286,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱山人见过碧澜欢饮却去赋此赠之","author":"王世贞","text":"醉石先生不爱醒，一瓢初过碧澜亭。\n那无令尹占真气，忽漫吴兴下酒星。\n须似蘋洲怜我白，眼如苕水为君青。\n何当夜半扬舲去，与报床头双玉瓶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11287,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]