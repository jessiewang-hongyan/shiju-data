[{"title":"灵岩竹房对雨","author":"于慎行","text":"旧日题名处，山窗竹未残。\n重游春欲暮，复向雨中看。\n暝色来千嶂，寒声到万竿。\n应添禅悦味，新笋入盘餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灵岩主僧邀游五峰亭遇雨即事","author":"于慎行","text":"已成三日醉，更上五峰亭。\n岭外云犹碧，尊前雨半青。\n唯然南岳偈，莞尔北山铭。\n向夕传清梵，泠泠自可听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灵岩禅室子冲兴甫夜饮大醉","author":"于慎行","text":"对酒不能醉，明星已在天。\n放歌知爱客，纵饮是逃禅。\n世事惊心后，时才屈指边。\n乾坤吾党在，把臂意茫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"买洪范泉旁隙地规作园池","author":"于慎行","text":"谁言泉上筑，不作辋川看。\n山色宜书幌，溪阴可钓竿。\n分流防短岸，樊圃避危湍。\n稍待西畴毕，移家事未难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日黄石山庄即事","author":"于慎行","text":"山居涉长日，散发不容簪。\n酒熟床头漉，诗成枕上吟。\n移花常待雨，种树稍成阴。\n欲叩金闺侣，何须此陆沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日山居周砺斋太史奉使周藩过邑见访赋赠二首 其一","author":"于慎行","text":"送君远行役，六月过山城。\n细雨钟前落，微风树里生。\n茶瓜凉夜色，车马故交情。\n却忆横门道，分途岁已更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日山居周砺斋太史奉使周藩过邑见访赋赠二首 其二","author":"于慎行","text":"夏日门常掩，何因驻使车。\n时同河朔饮，地似武陵渔。\n天地容高枕，烟霞有定居。\n莫将奇字问，独少著成书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"因周太史使还海上寄杨鍊庵丈及澄上人一首","author":"于慎行","text":"苦忆东林侣，逢人附报书。\n花残陶令宅，月出远公庐。\n世念归应尽，幽怀病未疏。\n三山知有路，正拟戒游车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"午日独酌","author":"于慎行","text":"邑里逢佳节，无欢坐草亭。\n年华双鬓白，心事一杯青。\n柳畔惊鶗鴂，花前叹鹡鸰。\n少人与同醉，不是独为醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山庄独居","author":"于慎行","text":"岂无山水慕，只是旧游孤。\n陇上遭田父，垆边问酒徒。\n颓年资药饵，野性适江湖。\n回首鹓行地，春风满鹧鸪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻胡竺西山人被絷有怀二首 其一","author":"于慎行","text":"慷慨关东侠，词场旧所欢。\n如何燕市筑，忽作楚臣冠。\n翻覆人情险，倾危世路难。\n夜来丰狱剑，虹色为君看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻胡竺西山人被絷有怀二首 其二","author":"于慎行","text":"长铗今何适，从军赴桂林。\n谈天时网密，逐客庙谟深。\n寥落词人赋，凄凉国士心。\n沅湘何处望，愁绝雁书沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十月四日张就山初至同饮东园菊花下作","author":"于慎行","text":"上客来何暮，山斋菊欲残。\n犹馀秋径色，聊待酒人欢。\n艳蕊迎霜立，寒香浥露餐。\n晚酣休便去，新月出林端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"安我素吏部倚舟过访酬赠","author":"于慎行","text":"沙边能系缆，相顾到林庐。\n斗室虚高枕，衡门有驻车。\n桃灯秋雨后，漉酒菊花初。\n好在山公启，休忘北阙书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬夜宿香山寺","author":"于慎行","text":"一宿招提境，匡床坐夜分。\n山深迟见月，石冷细生云。\n仙梵林中发，名香座上焚。\n老僧应出定，时觉语相闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮抵吴家渡杨令君携酒宿王户部别业","author":"于慎行","text":"十月荒山道，迷茫起暮阴。\n凄风吹古渡，寒雾结平林。\n地主尊垒远，山家巷路深。\n因过故人宅，怀旧一悲吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"往吊于子冲黄家渡口大雪","author":"于慎行","text":"寒冬涉济水，雨雪满征裘。\n欲解留徐剑，犹疑访戴舟。\n马蹄临渡涩，人迹过山稠。\n渐近齐州路，伤心触旧游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中济南道上携张就山同行忽失所在诗以觅之","author":"于慎行","text":"雨雪携同好，行行失所如。\n细寻东郭履，久驻信陵车。\n误恐迷花径，寒应殢酒庐。\n居然成间阔，暝色野踌蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张山人告行灯下言别","author":"于慎行","text":"幽居无与晤，殊喜故人来。\n秉烛频开卷，逢花数举杯。\n寒云江上树，冻雪陇头梅。\n明发黄山路，离愁不可裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张就山西游赵国及赴萧大司马之召","author":"于慎行","text":"关河冰雪满，游子去何之。\n长揖云中幕，高谈邺下诗。\n西园飞盖夜，北塞勒铭时。\n回首秋山赏，能忘桂树枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"查虞皋仪部道出济上遣书赐问赋答二首 其一","author":"于慎行","text":"别绪三秋迥，书来慰梦思。\n林中醒酒后，河畔倚舟时。\n雪静关山影，云生涧壑姿。\n岁寒无可赠，惟有折松枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"查虞皋仪部道出济上遣书赐问赋答二首 其二","author":"于慎行","text":"有怀江左彦，夙昔共兰襟。\n报国青萍器，承家玉树林。\n郎曹双管旧，禁漏五云深。\n无恙西山色，犹堪柱笏吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壬辰冬月连营兄弟二葬抚今追昔潸然有感聊赋四首 其一","author":"于慎行","text":"无限伤心地，连朝薤露吟。\n仁兄归永夜，爱弟托荒岑。\n华萼俱凋落，松楸渐郁森。\n寸肠摧断久，犹自涕沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壬辰冬月连营兄弟二葬抚今追昔潸然有感聊赋四首 其二","author":"于慎行","text":"累岁遭家难，心悲不可论。\n鲁门疑远梦，易水送归魂。\n取次栽坟树，从新拭泪痕。\n乞休曾有疏，酸侧动天阍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壬辰冬月连营兄弟二葬抚今追昔潸然有感聊赋四首 其三","author":"于慎行","text":"门庭思往日，文雅盛当时。\n共目三珠树，相辉五桂枝。\n一朝虚枕被，万事罢埙篪。\n怊怅馀生在，衰颜欲对谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壬辰冬月连营兄弟二葬抚今追昔潸然有感聊赋四首 其四","author":"于慎行","text":"久客归何倚，孤踪只自怜。\n顾瞻鸿雁影，吟叹鹡鸰篇。\n翰墨藏春雨，池塘惨暮烟。\n经过酬倡地，无处不潸然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石门道中","author":"于慎行","text":"风雨石门道，凄凄衣袖单。\n人家烟树隔，山径草花寒。\n萧索前朝寺，荒芜何代坛。\n十年来往路，立马一长叹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再过汶上路凤冈民部出送河桥留别","author":"于慎行","text":"邑里经年别，重逢春草芳。\n一杯临汶水，三月绾垂杨。\n豪侠齐公子，风流汉省郎。\n乡山多胜赏，后会莫相忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"任城魏松轩山人携琴见过从游溪山数日书赠","author":"于慎行","text":"自遣樊中累，常多物外游。\n看君携绿绮，访我到沧洲。\n月色和烟映，泉声作雨流。\n吾庐山水际，是处可淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南溪石上听魏山人弹琴送别","author":"于慎行","text":"溪树午萧森，因君理素琴。\n乍将流水引，写作落霞吟。\n别鹤飞何远，游鱼跃自深。\n只今怀往路，何处觅知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴门周画师从游溪上数日赋赠","author":"于慎行","text":"林壑看如画，幽人此地过。\n弹琴流水近，对酒暮云多。\n地僻无来往，山深足啸歌。\n床头有匹练，试为扫烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日从诸亲友饮城南溪上遇雨呈亭山周师二首 其一","author":"于慎行","text":"雨后南溪水，新添几尺流。\n壶觞陪父老，笑语到林邱。\n扫石聊施簟，烹鱼旋摘钩。\n酒阑更坐起，随意看凫鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日从诸亲友饮城南溪上遇雨呈亭山周师二首 其二","author":"于慎行","text":"阔略师生礼，相将把钓竿。\n青山閒共适，白发醉同欢。\n雨色尊前近，滩声树杪寒。\n踏泥连骑缓，归路不知难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六月十二夜可大小酌即事","author":"于慎行","text":"客乘残雨至，席对晚凉开。\n酒畔移灯去，花间送月来。\n风流河朔会，倡和柏梁才。\n更忆长杨路，青葱玉树栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕可大小会即事和韵","author":"于慎行","text":"小阁驱残暑，当筵夜色青。\n楼头生片月，河畔度双星。\n桃叶虚称扇，松枝戏作屏。\n秋声惊白纻，沉醉不能听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和可大七夕书怀","author":"于慎行","text":"新凉浮玉宇，客馆易为愁。\n天上明河夜，人间白露秋。\n逃名惟对酒，乞巧讵登楼。\n自有丰城气，迢迢映斗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江右黄淮朐文学可大客也以书授其弟侄东游赋赠","author":"于慎行","text":"南州有高士，邂逅见风流。\n雅醉荆卿酒，常随郭泰舟。\n穷经探鲁壁，作客佩吴钩。\n门下推师授，名成两夏侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陪朱可大丈游陶山幽栖寺绝顶同张士师李鸿胪黄文学赋","author":"于慎行","text":"幽栖真此地，绝壁到人稀。\n石角斜钩杖，藤稍曲桂衣。\n壶飧高洞险，钟磬下方微。\n共有登临兴，谁能不醉归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陶山怀古","author":"于慎行","text":"越相何年隐，齐山旧有名。\n地连肥子国，路出铸乡城。\n洞杳秋云白，岩深古木平。\n临池怀往迹，颇识种鱼情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陶山赠张东山士师","author":"于慎行","text":"陶朱今不见，君是鲁朱家。\n侠骨千金剑，仙炉五色霞。\n生涯随畜牧，乡语话桑麻。\n早结东山隐，惊看鬓有华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游云台山","author":"于慎行","text":"窈窕黄山路，秋云入几重。\n寒声泉上竹，古色寺前松。\n地隐秦时洞，天连月观峰。\n由来真迹秘，不许世人逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同可大宿黄山张氏精舍","author":"于慎行","text":"谷口隔疏篱，林深鸟不啼。\n石泉萦户转，山果亚枝低。\n涧壑参差映，藤萝咫尺迷。\n苦无向平累，聊可共依栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同可大对饮黄山玉龙峡上","author":"于慎行","text":"看山意不厌，复此濯尘缨。\n涧落飞虹影，泉飘喷玉声。\n隔花分送酒，凿石共题名。\n相对濠梁意，翛然少世情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泰山客馆送朱可大登岳","author":"于慎行","text":"息驾泰山麓，何以慰所思。\n送君九节杖，拄上五松枝。\n涧底出云处，夜中观海时。\n同游不同醉，应忆旧题诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重游三阳观宿","author":"于慎行","text":"曾向春山宿，重来似旧青。\n坛风落橡栗，岩雨长芝苓。\n试觅长生药，聊翻内景经。\n不知凉夜永，星斗挂疏棂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三阳观木末亭晚眺因迟可大未至","author":"于慎行","text":"木末堪凭槛，秋空四望开。\n晚烟迷汶水，落日满徂徕。\n酒忆垆头醉，人从岳顶回。\n那逢摇落候，萧瑟易悲来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"傲来山","author":"于慎行","text":"不断青螺色，依然万仞峰。\n云间翔鷟鸑，天杪秀芙蓉。\n岳界三千里，仙闾十二重。\n神功何处敛，此地宅蛟龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同诸君饮竹林寺树下","author":"于慎行","text":"灵岳多真境，禅宫路更深。\n五峰常隐日，双树自成林。\n涉涧逢瑶草，临流漱玉琴。\n晚钟归骑缓，沉醉北山岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观泰山百丈崖瀑布","author":"于慎行","text":"尽日水声中，还看匹练空。\n盘涡喧万马，削壁斗双虹。\n派抉天河落，源从月窟通。\n固知灵境异，融结骇神功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望仙影岩","author":"于慎行","text":"何劫飞来影，分明鹤上仙。\n侧身疑面壁，作礼似朝天。\n观化兴云雨，凭虚阅岁年。\n扶桑终日在，几见海成田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西汀临汎呈印泉舅氏二首 其一","author":"于慎行","text":"秋水寒塘净，兰樯别渚通。\n林端悬片雨，蘋末起微风。\n孤屿浮波外，长天一棹中。\n渔竿堪自老，不是慕非熊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西汀临汎呈印泉舅氏二首 其二","author":"于慎行","text":"西汀怀旧隐，秋杪片帆来。\n落照樽前树，寒烟水上台。\n舟移明镜转，云尽画屏开。\n笑语淹吾舅，浮槎夜未回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙未十月傅金沙侍御殷洗心舍人过访山中赋赠","author":"于慎行","text":"命驾何相值，开尊夜向寒。\n风高边雁尽，霜冷菊花寒。\n天地吾徒在，江湖此会难。\n占星应有地，总傍少微看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬初傅金沙侍御过访因韵赋和","author":"于慎行","text":"百里寒山道，劳君问隐居。\n玄言聆喻马，往事笑焚鱼。\n岳色青尊外，秋声白苧馀。\n良游知不厌，卜筑意何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日閒居有怀黄大宗伯","author":"于慎行","text":"万里温陵道，含情忆旧游。\n梦迷明月夜，人老白蘋秋。\n海阔休看雁，山深自倚楼。\n何时江路柳，重见木兰舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中寄徐少宰丈","author":"于慎行","text":"契阔同心侣，多年叹索居。\n吴门遥系马，鲁国久悬舆。\n岁晚怜交态，天长阙报书。\n悠悠清汶水，一为觅双鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春邢子愿侍御过访邀登虎窟山洞遇雨和韵","author":"于慎行","text":"春尽无登眺，留山待客来。\n残花岩际落，野席雨边开。\n雾合峰阴树，云飞洞口台。\n醉忘归路远，昏夜踏泥回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子愿过宿云楼小酌用韵","author":"于慎行","text":"看山常独醉，无奈索居何。\n那值春光暮，能邀上客过。\n钩帘芳树近，挥麈白云多。\n欲似南楼月，胡床发啸歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子愿饮东流池上","author":"于慎行","text":"春入桃源路，飞觞日未斜。\n溪头逢燕子，池面落杨花。\n听树萧萧雨，看山片片霞。\n与君忘世虑，沈醉即为家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子愿饮天柱峰下赠吴人薛文学南旋","author":"于慎行","text":"缥缈高峰下，相从蹑屐来。\n攀崖行觅草，欹石坐传杯。\n半岭开琼观，中天倚玉台。\n吴门应系马，有客岱宗回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"倚槛","author":"于慎行","text":"倚槛多佳气，高峰敛夕曛。\n林梢斜上月，麦陇细蒸云。\n宵柝连城动，田歌隔舍闻。\n空岩响麋鹿，地僻亦惊群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆鹤","author":"于慎行","text":"独鹤曾为友，翩飞已隔年。\n几时归华表，何处觅青田。\n影断空山月，声凄远树烟。\n瑶台应有伴，宁忆旧林泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"放鹿","author":"于慎行","text":"园鹿知无恙，羁栖亦自愁。\n本非笼槛物，岂有稻粱谋。\n缥缈云中驾，虚无海上游。\n只应常放汝，相伴踏林丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"楼月","author":"于慎行","text":"小楼凉不寐，白月静娟娟。\n半岭含秋气，千林灭晚烟。\n海边烽火动，塞上羽书传。\n此夜关山曲，寒光万里悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"萝轩","author":"于慎行","text":"室成无四壁，为藉绿萝阴。\n五月清风至，空庭白日深。\n野花犹恋树，径竹未成林。\n幸少藩篱隔，长堪对远岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"田父","author":"于慎行","text":"欣承田父过，相对亦陶然。\n泥客携村酒，迎神醵社钱。\n禾麻新受雨，桑柘远成烟。\n解问兰台史，还书大有年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓望","author":"于慎行","text":"早凉开野曙，迥眺出岩扉。\n日旭风吹面，林香露湿衣。\n流莺深树语，掉雀野田飞。\n来往逢村叟，相将荷蓧归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成","author":"于慎行","text":"传道东封事，扶桑路渺漫。\n不成威百粤，何取度三韩。\n零落王人节，低垂大将坛。\n可怜当日画，犹欲斩楼兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]