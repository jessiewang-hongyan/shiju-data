[{"title":"和荅胡可泉郡伯","author":"边贡","text":"籍籍胡安庆，新声满旧都。\n讵知金马客，翻领玉麟符。\n退食还经史，登楼即画图。\n昔贤忧乐地，元只在江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17483,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"溪翁","author":"边贡","text":"未觌溪翁面，中宵梦已先。\n关山非逆旅，舟楫是登仙。\n雁语惊霜别，莺啼候谷迁。\n烟波夕渺渺，留恨满江田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17484,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠李都阃","author":"边贡","text":"好武将军独，能文更爱君。\n异勋江左策，名阀陇西闻。\n散帙临秋水，投壶过夕曛。\n长怀醉别处，箫吹遏溪云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17485,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉荅王载卿方伯","author":"边贡","text":"菊蕊南山屐，荷华北渚船。\n胜逢无节序，佳句有云烟。\n列郡讴歌里，沧溟览眺前。\n故乡谁地主，回首忆当年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17486,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"写怀","author":"边贡","text":"欲逃中夏暑，暂上上江船。\n夜卧对松月，晓行披水烟。\n佳期渺天末，良觏阻尊前。\n相问各华发，遥悲青镜年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17487,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再赠载卿","author":"边贡","text":"宾堂瞰水浒，沙柳系行船。\n袅袅绿萝月，冥冥芳浦烟。\n乡关百里外，世事一尊前。\n记取相逢地，清河旅食年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17488,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戏赠张守公荐","author":"边贡","text":"蜀郡留工部，任城卧谪仙。\n古人多逆旅，地主几称贤。\n岁月青尊里，乡关白雁前。\n知章与严武，君不愧当年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17489,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"近闻石翟子驻节河口喜而有赠二首 其一","author":"边贡","text":"近闻临驻处，陌上草萋萋。\n碧水春风外，青山晚月西。\n君车建高节，旅舸系平堤。\n岂料漳河饮，同闻络纬啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17490,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"近闻石翟子驻节河口喜而有赠二首 其二","author":"边贡","text":"栖棘诚堪惜，崇迁且汴台。\n不因盘错试，谁辨镆铘才。\n赤日昭天鉴，黄河殷地雷。\n凌秋泛槎去，知向斗边回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17491,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柬王美卿万户","author":"边贡","text":"见说君家圃，新开夜合花。\n暝云含洞石，炎雨净溪沙。\n想像王郎剑，迟徊汉使槎。\n一尊虚旧约，惆怅坐昏鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17492,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"旅寓清源有怀故乡亲友","author":"边贡","text":"雨过双松午，云阴覆閤长。\n柳蜩迎日嘒，芹燕落泥香。\n碧水通官舍，青山接故乡。\n怀人不可见，归思转苍茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17493,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠宋医","author":"边贡","text":"施药漳河口，高龄鬓未华。\n地疑京兆市，人即宋清家。\n石壁垂金草，丹炉起玉花。\n愿传玄牝诀，交臂入青霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17494,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中卧病谷来许以诗来问荅之","author":"边贡","text":"尔本游扬侣，吾惭程氏门。\n遥怜雪盈尺，何似雨翻盆。\n久病抛书卷，长斋闭酒尊。\n草堂霞色晚，好过一相论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17495,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重阳冷二守过访留酌","author":"边贡","text":"九日逢知己，开尊傍水涯。\n壮怀馀白首，幽赏有黄花。\n日隐郊台暮，云连浦树斜。\n未须论去住，乘兴即为家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17496,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"徐园夜坐有怀","author":"边贡","text":"避暑将军府，青青竹满园。\n坐看台上月，吟忆水西轩。\n萤火流烟度，蚊雷接暮喧。\n美人漳浦卧，何日奉清言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17497,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠环峰王总戎西征","author":"边贡","text":"开府驰声旧，辕门授钺频。\n日华承盖转，江色映袍新。\n去作郧山雨，来经蜀道春。\n军中人尽说，筹策妙如神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17498,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荅罗兖州","author":"边贡","text":"我抱文园渴，君淹曲阜城。\n中年俱抱屈，异地各悬情。\n永夜孤蟾色，新秋旅雁声。\n况闻吴楚变，汉帝且南征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17499,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄胡文甫","author":"边贡","text":"不见胡文甫，七回明月圆。\n家林且如此，宦海益堪怜。\n碧柳秦台马，红蕖济水船。\n往来馀百里，同醉是何年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17500,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"午日卧病有怀张王二子","author":"边贡","text":"栖迟仍旧国，愁病且端阳。\n白发能相妒，清尊漫自香。\n壁虚悬艾好，溪迥入舟妨。\n苦忆青骢客，盈盈水一方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17501,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠郑少尹","author":"边贡","text":"我正雪中卧，君从天上还。\n节高元自苦，才大可能閒。\n淅沥听疏竹，苍茫对远山。\n夜深拚一醉，休当剡溪湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17502,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠刘希容","author":"边贡","text":"籍籍刘京兆，还家尚黑头。\n无心恋簪组，有子绍箕裘。\n月夜楼中坐，花时郭外游。\n不堪相访地，醒眼话离愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17503,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀王生","author":"边贡","text":"世弃君平久，狂疏老更添。\n绝人吾岂好，嗜酒子应嫌。\n荷叶翠出水，榴花红入帘。\n晚当西牖坐，山日映书签。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17504,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜访德宣不值","author":"边贡","text":"坡陀古堤上，往来伤独游。\n相违岂在远，一见已无由。\n水宿厌栖泊，暮行多懔忧。\n琼枝不可即，肠断卫川流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17505,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄徐进甫","author":"边贡","text":"城东徐孺子，不见已三年。\n鸿雁几时至，音书谁与传。\n钓鱼寒涧曲，注易古林边。\n遥想府中榻，常因高士悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17506,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过汴呈献吉","author":"边贡","text":"两年京郭居，空望故人书。\n五月梁园道，来乘长史车。\n川流赴海急，隰日漾沙虚。\n欲访渔樵径，蓬蒿不可除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17507,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜泊汉阳却望武昌有怀矩庵","author":"边贡","text":"对岸武昌郭，清宵回望频。\n离心系舟远，旅梦涉江新。\n积水明疑昼，浮烟霭似春。\n楼空黄鹤杳，延伫独劳神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17508,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白泉王子居山相近","author":"边贡","text":"尔能耽野趣，吾亦爱村居。\n白屋情偏好，苍山画不如。\n桑麻通雪径，鸡犬接烟墟。\n岁晚青藜在，相过且校书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17509,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同王白泉步过北村访孙胡二子","author":"边贡","text":"少日同门客，山居晚共依。\n孤村一相访，深树鸟声稀。\n面水心逾静，班荆愿不违。\n苍苍平野际，还望瞑烟归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17510,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谷子访予别业","author":"边贡","text":"谷生怜我独，相访到山家。\n碧水孤村抱，垂杨一径斜。\n野人共白酒，稚子饭胡麻。\n坐爱残阳里，庭槐吐细花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17511,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀三屏子","author":"边贡","text":"北郭雨冥冥，东山云雾青。\n三屏不我对，九柳自吾亭。\n短发嗟同病，长歌笑独醒。\n临溪抚身世，百载一浮萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17512,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陆子引","author":"边贡","text":"世业机云后，声光慱望前。\n使星连禹服，卿月渺吴天。\n岸迥山回枕，泥香燕拂船。\n壮游应不负，随处有诗篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17513,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送唐仁夫","author":"边贡","text":"象阙指龙洲，天南海北头。\n岛夷随使节，山鬼避行舟。\n墓采秋蘋奠，乡看昼锦游。\n归期定何日，瑶草思悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17514,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送施克和","author":"边贡","text":"楼敞壁灯悬，归心夜不眠。\n袖中怀楚玉，江口泛吴船。\n兴寄风人外，名收国士前。\n秋来消息好，知向鹿鸣传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17515,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送刘氏叔侄赴举","author":"边贡","text":"双马饮溪流，溪边雨乍收。\n方趋棘围战，不比竹林游。\n礼学传三世，家声动九州。\n太行山上月，几日桂花秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17516,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送徐德章兼寄杭世卿吏部","author":"边贡","text":"迢递延陵路，新乘使者车。\n国风收外史，庙号布中书。\n海色宵征里，薇花午梦馀。\n相逢杭吏部，归楫问何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17517,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送范掾尉仁和","author":"边贡","text":"入仕得亲欢，舟行且问安。\n青山越州路，黄绶汉时官。\n暑服裁江练，名花荐渚兰。\n六桥三塔景，公暇几回看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17518,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送刘博之参政南阳二首 其一","author":"边贡","text":"蓟北才能会，声华早见收。\n道高传吏部，诗好入随州。\n别宴当梅雨，官程过麦秋。\n江湖忧正切，休上望京楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17519,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送刘博之参政南阳二首 其二","author":"边贡","text":"津桥南渡头，落日片帆收。\n冠盖新方岳，河山古豫州。\n树深燕市晚，云冷爵台秋。\n两地分千里，怀人各倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17520,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送黄端州","author":"边贡","text":"春水泛桃花，飘飘海上槎。\n官崇先领郡，亲老一还家。\n石抱溪云紫，烟含岭树斜。\n夜深登望处，北斗是京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17521,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王秉衡归省","author":"边贡","text":"津树隐春艭，林花集暮江。\n天涯归客远，堂上老亲双。\n捧日心常切，看云梦未降。\n閒来书谏草，谁与坐山窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17522,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送曹元孝监河之徐州二首 其一","author":"边贡","text":"水部移舟楫，临津问所须。\n离心汉宫柳，幽梦楚垓芜。\n雁迥云重覆，花寒地一隅。\n吟诗坐东阁，谁与鉴冰壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17523,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送曹元孝监河之徐州二首 其二","author":"边贡","text":"石閤延春望，洪舠送酒须。\n断蛇荒泽徙，戏马旧台芜。\n碧树通江徼，苍烟接海隅。\n三山不可见，休更问蓬壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17524,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再寄其子毅之","author":"边贡","text":"相寻空缱绻，相别太斯须。\n一去青门道，几回生绿芜。\n文章传海内，消息阻天隅。\n岁晚登高忆，劳歌缺唾壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17525,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"藏六轩夜别东卿","author":"边贡","text":"到寺钟初寂，高城夕漏迟。\n閤云昏冉冉，庭雨冻丝丝。\n留客灯前席，怀人海上诗。\n树鸦啼不断，岁杪怨相离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17526,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠周予庚使辽左","author":"边贡","text":"翩翩鸣玉珂，千里渡辽河。\n尔本诗书客，宁闻铙吹歌。\n立朝同汲黯，出使比萧何。\n莫厌貂裘敝，霜风塞上多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17527,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"简别华文光同年","author":"边贡","text":"朔野北风起，沙蓬飞不休。\n端居念行客，明发动归舟。\n古堞鸣禽暮，虚堂落木秋。\n重来不相见，离梦转悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17528,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送华文远","author":"边贡","text":"早蝉鸣树头，归棹渡江秋。\n孝子祠重建，徵君传已修。\n泪痕双苧袖，身世一弓裘。\n不学龙门客，逢人说远游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17529,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送董汝淳太守之楚雄二首 其一","author":"边贡","text":"诗人重出守，万里一朱轓。\n苦节留三郡，英声振五言。\n山深夜郎道，花乱武陵源。\n月下劳相忆，清秋几处猿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17530,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送董汝淳太守之楚雄二首 其二","author":"边贡","text":"井鬼占星地，滇云问路时。\n岭暄秋瘴湿，江远暮帆迟。\n竹弩迎津吏，毡裘拜岛夷。\n课耕还吊古，应到孔明祠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17531,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别顾华玉同年四首 其一","author":"边贡","text":"问讯金陵客，南归近有期。\n马行沾雨慢，蝉响入秋迟。\n水稻供慈膳，江绡制寿帷。\n閒居赋成后，曾见几人为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17532,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别顾华玉同年四首 其二","author":"边贡","text":"落日长干渡，西风短棹过。\n故人归后少，秋草望中多。\n谢墅荒碑碣，吴宫閟绮罗。\n趋庭休浣外，临眺意如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17533,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别顾华玉同年四首 其三","author":"边贡","text":"官署依乡土，幽求满素心。\n窗临逸少帖，墙挂宓生琴。\n种药开春径，看云坐晚林。\n避名名转出，休爱碧山深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17534,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别顾华玉同年四首 其四","author":"边贡","text":"达人氛垢远，流品自应殊。\n骏枥分天厩，鸾巢托省梧。\n葛洪勾漏尹，阮籍步兵厨。\n未识图南志，相逢说著书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17535,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送秦用中邑博得盐字","author":"边贡","text":"残溜滴崇檐，离杯雨夜添。\n儒官归郑老，诗客去高蟾。\n调发囊琴古，光涵匣剑铦。\n昔贤身未达，多少在鱼盐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17536,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"芮令尹之兴宁","author":"边贡","text":"万里惠州去，旅情应独伤。\n暮云牛岭暗，秋草雁池荒。\n古迹怀苏老，清吟和李纲。\n遥怜蛮聚落，从此识甘棠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17537,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠别三首 其一","author":"边贡","text":"相逢不忍别，相送思悠悠。\n风雨一宵话，关山千里愁。\n暮潮通极浦，寒燕逐行舟。\n短发年年白，重看是几秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17538,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠别三首 其二","author":"边贡","text":"早叶半辞林，晚蟾初罢吟。\n入秋乡国梦，垂老故人心。\n道在宁须禄，官清尚有琴。\n城隅分手处，惆怅水云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17539,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠别三首 其三","author":"边贡","text":"独持文字印，遥泛木兰舟。\n古驿寻京口，寒城过石头。\n诵声分馆夜，吟思捲帘秋。\n欲问前朝迹，青山是蒋州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17540,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送孙志同经略居庸二首 其一","author":"边贡","text":"宝剑青骢马，秋高出塞行。\n田公新受律，武子旧传兵。\n鼓角边云惨，旌旗海日明。\n穹庐莫南徙，中国有长城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17541,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送孙志同经略居庸二首 其二","author":"边贡","text":"马出燕关道，人如定远侯。\n眼空沙漠气，心系庙堂忧。\n绝塞苍烟暮，荒山白草秋。\n军都城下过，怀古一登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17542,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送朱文表","author":"边贡","text":"关河积雨晴，千里一舟行。\n庾廪司农计，山川故国情。\n古碑寻盻子，芳草识聊城。\n想见登临处，遥心览八瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17543,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨生","author":"边贡","text":"相见十年外，相寻千里馀。\n青衿子老大，白发我何如。\n涕泪丘园草，风尘故旧书。\n别情那可忆，云月晓窗虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17544,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王载卿","author":"边贡","text":"万里云霄使，三秋泽国船。\n冰霜消岭瘴，旌盖丽江烟。\n国赋徵求里，民风奏记前。\n独怜诗社冷，一别又经年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17545,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李佥宪维之北上","author":"边贡","text":"桓典乘骢日，相如卧病春。\n伤心一杯酒，回首十年人。\n雪暗关山色，风飘驿路尘。\n郭西慵出饯，愁见柳条新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17546,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王君宠主潼津驿","author":"边贡","text":"潼津佳胜地，驿舍近潼关。\n立马看河水，开窗对华山。\n客怀登览际，官守送迎间。\n倘见三秦友，传予鬓已斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17547,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送刘文振宰驿华山兼寄汝公太守","author":"边贡","text":"我抱游秦志，君今先我行。\n一杯同出廓，千里独含情。\n雨入新丰晚，云移少华晴。\n寄言桑郡守，天子近知名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17548,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李司务思善二首 其一","author":"边贡","text":"可怪皇华使，相逢九日过。\n地偏秋雁少，天迥莫云多。\n北渚青帘舫，南山白玉珂。\n未能同一醉，离别思如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17549,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李司务思善二首 其二","author":"边贡","text":"苏门形胜地，往岁忆经过。\n书院青山近，仙潭赤鲤多。\n月中攀古树，雪里并游珂。\n六载重携手，清尊柰尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17550,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送殷近夫谢病归寿张二首 其一","author":"边贡","text":"论交方恨晚，为别更匆匆。\n风雨深期阻，山川幽恨同。\n杏田淄水北，草阁汶阳东。\n乡路元相近，清宵有梦通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17551,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送殷近夫谢病归寿张二首 其二","author":"边贡","text":"并居城下陌，经岁往来疏。\n薄宦惟多病，穷愁有著书。\n春山怀紫蕨，夕浦怅红蕖。\n去去仙踪渺，何人伴索居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17552,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]