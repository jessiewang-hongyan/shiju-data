[{"title":"中秋遇风雨","author":"徐熥","text":"寒溪秋色满，临汎意如何。\n高枕乱流去，挂帆千嶂过。\n梦应通月窟，槎已到星河。\n不负烟霞想，无妨风雨多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23184,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同惟秦兴公舟中夜坐","author":"徐熥","text":"临流趺坐久，夕露坠衣繁。\n山色晚逾翠，滩声宵更喧。\n林深灯避影，云重月亏痕。\n不爱闻鸡犬，停舟莫近村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23185,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠惟秦","author":"徐熥","text":"平生隐不出，出便为寻真。\n世上风波免，途中闻见新。\n抛家无内顾，学道有前因。\n却笑虚名客，江湖劳此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23186,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓发","author":"徐熥","text":"枕上榜歌起，溪中行侣稀。\n缆牵烟缕细，帆挂月痕微。\n曙逐鸡声尽，涛惊客梦归。\n沿洄三五里，犹未见朝晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23187,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠黄君甫山人","author":"徐熥","text":"烟霞久已亲，无语到红尘。\n著姓同江夏，逃名比富春。\n长贫玄草客，未老白云身。\n不脱吴钩赠，君家在剑津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23188,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登接笋峰","author":"徐熥","text":"丹梯悬削壁，铁索缆萦纡。\n鱼贯嵓当面，猿攀石碍趺。\n气同看月喘，声各入云呼。\n蜿蚺过龙脊，茅房见一区。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23189,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陷石堂","author":"徐熥","text":"缘溪下复登，山色翠层层。\n洞以水流辟，石从云压崩。\n落花魂卧草，空树腹吞藤。\n渐觉非人境，风光近武陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23190,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠安道人","author":"徐熥","text":"丹房占翠微，静极悟玄机。\n玉液喉间咽，金精肘后飞。\n礼经随众惯，挥麈见人稀。\n岂是无家客，三年不一归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23191,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠江仲鱼","author":"徐熥","text":"君家虽附郭，多在武夷居。\n有水皆移棹，无山不结庐。\n胸全藏洞壑，交半混樵渔。\n怀友秋风里，从今或到予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23192,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀颜廷愉","author":"徐熥","text":"流落有如此，壮心终不酬。\n文多为客难，剑未报君雠。\n失职辞戎幕，移居近比丘。\n世情容易变，莫向灞亭游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23193,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送兴公弟游吴越","author":"徐熥","text":"献书予未遇，弹铗汝何依。\n片刺投人拙，诸侯礼士稀。\n出门家累断，为客众愁归。\n不必羞贫贱，诗名在布衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23194,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画菊赠黄博士印坤","author":"徐熥","text":"南山相对处，篱下有馀芳。\n开向三秋晚，餐来五内香。\n叶同颜不老，花与发俱黄。\n岁岁金风起，披图一荐觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23195,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陈平夫","author":"徐熥","text":"闻说清溪上，经年但索居。\n诗因閒转废，交到老偏疏。\n酒癖难全减，雄心可便除。\n灯前思旧好，空检往来书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23196,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过惟秦幽居","author":"徐熥","text":"数歇经村落，到门红日西。\n柳阴牛独寝，草舍燕双栖。\n野绿云千亩，郊青雨一犁。\n空林烟火起，留客晚蒸藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23197,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同郑吉甫过仁王寺怀徐仲和久客莆中","author":"徐熥","text":"灯火佛堂虚，经行月上初。\n草生游子路，松偃化人居。\n春尽莺花老，天长蝶梦疏。\n如何逢九鲤，不寄半行书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23198,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病","author":"徐熥","text":"一春馀几日，况复卧文园。\n山色来欹枕，莺声老闭门。\n拥衾无早晚，来札半寒温。\n渐觉诗签减，惟看药裹存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23199,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中屠田叔使君招集乌石山同钱叔达陈幼孺王粹夫曹能始兴公弟分得深字","author":"徐熥","text":"选胜坐危岑，山高紫翠深。\n受潮千涧满，翳雨半峰阴。\n衣中春寒薄，钟过暮霭沈。\n使君行役近，犹不废登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23200,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张孺愿之漳南","author":"徐熥","text":"离亭柳正长，匹马向临漳。\n别路闻莺语，遥空起蜃光。\n?风吹海暗，蛮雨洗天凉。\n去去频沽酒，兹行是瘴乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23201,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"屠田叔雨中过酌草堂分得穷字","author":"徐熥","text":"谁谓诸侯贵，来过一亩宫。\n天低峰影逼，云耗雨声穷。\n残溜虚檐滴，新苔怪石蒙。\n惭无池馆胜，不敢醉山公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23202,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄张成叔","author":"徐熥","text":"杯酒片时亲，都亭各问津。\n玉河堤畔柳，又见一回新。\n月冷闽天梦，花明越峤春。\n闻君庐墓侧，白兔向人驯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23203,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼殇子","author":"徐熥","text":"五日人间世，千秋骨肉情。\n未能留幻质，空自试啼声。\n眷属知何劫，轮回又此生。\n愁心安可慰，婚嫁累尤轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23204,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏佛手柑","author":"徐熥","text":"兜罗软似绵，移种到人天。\n妙相终成果，清香不让莲。\n交枝疑合掌，屈指欲为拳。\n肯向车中掷，留将供法筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23205,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜康元龙归自灵武","author":"徐熥","text":"自逐征西府，空惊两鬓斑。\n尘沙过陇水，风雪度萧关。\n刁斗边城暗，烽烟戍垒閒。\n故园初下马，一剑在腰间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23206,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽周候官","author":"徐熥","text":"双凫何处飞，父老泣沾衣。\n旧客云同散，虚名露易晞。\n关河孤榇远，风雨旅魂归。\n他日过荒陇，松楸大几围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23207,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柬陈汝大","author":"徐熥","text":"爱君栖隐处，一室白云深。\n古壁藤花乱，空庭桐叶阴。\n静能销世态，老得遂閒心。\n自愧嵇生懒，经年不入林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23208,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈可栋还松溪","author":"徐熥","text":"相见复离群，一杯歌送君。\n轻红辞荔火，寒翠梦松云。\n树影缘山转，溪流向县分。\n蝉声脩竹里，明日不同闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23209,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈汝翔游龙虎山","author":"徐熥","text":"布褐与黄冠，遥寻正一坛。\n灵符求玉印，神鼎问金丹。\n礼斗七灯焰，降魔双剑寒。\n龙沙遗谶合，计日待骖鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23210,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈彦宗之永嘉","author":"徐熥","text":"皖城归未久，又复向东瓯。\n总为饥寒出，不然何所求。\n帆飞瘴雨湿，衣触火云流。\n纵是囊羞涩，还须雁宕游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23211,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送余印卿秀才还濉阳","author":"徐熥","text":"相违虽不远，相送亦应难。\n宝剑脱为赠，瑶琴何处弹。\n行装三伏雨，孤棹百重滩。\n想到家林日，犹怀荔子丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23212,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郑震卿之吴越寻兄","author":"徐熥","text":"汝兄游不返，汝去远相寻。\n试问孤身客，飘零何至今。\n见时应恸哭，语罢定伤心。\n坐待离群雁，联翩向故林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23213,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林应卿进士理梧州","author":"徐熥","text":"拥传过藤峡，开衙傍郁林。\n苍梧寒岫翠，青草瘴云深。\n蛮吏多夷礼，猺民杂土音。\n此乡山水好，公暇足登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23214,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张公鲁还甬东","author":"徐熥","text":"知己难为别，况逢摇落时。\n断猿吟树惨，羸马过山迟。\n夜月严陵濑，秋风贺监祠。\n清狂怀小阮，谁共竹林期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23215,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅赠黄君甫","author":"徐熥","text":"家居延水濆，剑佩七星文。\n竹杖干山月，荷衣五岳云。\n迹多方外见，名喜世间闻。\n从此辞尘网，飘飘鸾鹤群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23216,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄朱善侯秀才","author":"徐熥","text":"虽然盖未倾，年少即闻名。\n才似王文考，狂如祢正平。\n鸡坛盟越国，龙剑出丰城。\n自有惊人语，看君时一鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23217,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭王孔振客死泸州","author":"徐熥","text":"飘零万里客，客死更谁依。\n路远讣音缓，家贫吊者稀。\n巴歌舁榇曲，橦布附身衣。\n蜀道难如此，游魂归不归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23218,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭顾道行先生","author":"徐熥","text":"谁谓江干别，竟成生死分。\n梨园翻薤露，苔馆閟萝云。\n地远讣难定，天高哭不闻。\n酬恩空一剑，何敢挂孤坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23219,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送叶秀才还松溪","author":"徐熥","text":"兹行路几重，去矣不从容。\n试问君归兴，何如秋色浓。\n香残霜后菊，涛响月边松。\n隔断相思梦，千峰与万峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23220,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为亲乞禄诗赠丁文统邑丞 其一","author":"徐熥","text":"薄宦不谋身，卑栖向海滨。\n暂为黄绶客，少慰白头亲。\n退食称觞便，休衙问寝频。\n有人犹负米，五斗莫嫌贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23221,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为亲乞禄诗赠丁文统邑丞 其二","author":"徐熥","text":"岂是爱微官，因承禄养欢。\n公厨充菽水，海错佐盘餐。\n振藻宜花县，哦松傍药栏。\n浮沈元世路，莫谓折腰难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23222,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题陈幼孺招隐楼 其一","author":"徐熥","text":"丛桂许谁攀，经年不闭关。\n池平吞月浅，林静受云閒。\n草色春愁外，禽声午梦间。\n开窗岚翠满，疑对八公山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23223,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题陈幼孺招隐楼 其二","author":"徐熥","text":"石磴转松阴，高楼面翠岑。\n薜萝春雨细，橘柚暮烟深。\n夜月喧林犬，微风掠水禽。\n一丘招隐处，应慰白云心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23224,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成","author":"徐熥","text":"吟咏随真性，行藏听自然。\n因穷閒半世，托病谢诸缘。\n乞字人催债，脩琴铺索钱。\n辛勤犹一事，洗砚竹根边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23225,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题博古斋赠蒋子才","author":"徐熥","text":"寄迹多湖海，逃名且市廛。\n一区扬子宅，四壁米家船。\n玉辨荆山里，书收汲冢前。\n耽奇同有癖，相过定留连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23226,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日同闵寿卿钱叔达兴公弟过定光庵访乐上人","author":"徐熥","text":"避俗懒迎客，斋心同结缘。\n树枝增一腊，柏叶禁诸天。\n法供更新水，香炉宿旧烟。\n空门无岁月，尘世自知年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23227,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闵孝昭送其尊人隐武夷自归广陵赋此以送 其一","author":"徐熥","text":"忍泪别严亲，长途剑卫身。\n烟花归路客，风浪渡江人。\n马踏梅天雨，莺残瓜步春。\n从今闽海熟，定省莫辞频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23228,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闵孝昭送其尊人隐武夷自归广陵赋此以送 其二","author":"徐熥","text":"送父隐九曲，辞归天一涯。\n他年同拔宅，此日独还家。\n别梦萦芳草，征帆过落花。\n无劳虑甘旨，嵓洞足烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23229,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再送曹能始","author":"徐熥","text":"此日鸣驺去，当年战胜归。\n故人供别酒，关吏识行衣。\n起草依丹禁，含香觐紫微。\n汉廷方贵少，年少似君稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23230,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林兆纶游武夷","author":"徐熥","text":"飘飘鸾鹤群，去谒武夷君。\n溪曲斜流月，峰多乱占云。\n石床深草色，玉简翳苔文。\n半夜天坛上，一声清磬闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23231,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张叔麟别驾归永嘉","author":"徐熥","text":"言别泪潸然，况君非少年。\n残莺孤店雨，羸马断桥烟。\n剑已分雷焕，刀犹佩吕虔。\n故山邻雁宕，莫惜系书传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23232,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同吴元瀚兴公弟暮过神光庵","author":"徐熥","text":"薜萝深处入，一径自逶迤。\n待月嫌林翳，看云怯石危。\n岩阴灯影晦，山静磬声迟。\n虽有重来约，重来知几时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23233,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同闵寿卿柳陈父吴元瀚兴公弟避暑仁王寺因憩天秀岩","author":"徐熥","text":"结夏依禅窟，松关闭寂寥。\n摩厓猜古篆，相地徙团瓢。\n赤日过林尽，红尘到寺销。\n清凉元有境，人自爱炎歊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23234,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题吴元瀚小像","author":"徐熥","text":"披缁还戴笠，独自坐崚嶒。\n有相元虚妄，无言即上乘。\n形将同木槁，心已似波澄。\n不是旧相识，翻疑何处僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23235,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同萧二丈林子真兴公弟微上人定上人过遇公转华庵","author":"徐熥","text":"因与山僧熟，祗园来往频。\n一时无俗客，半日有閒人。\n岩树云边暮，池花水畔春。\n扫除嫌太洁，翻觉此身尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23236,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西禅寺","author":"徐熥","text":"野旷烟光薄，林深暑气微。\n乱蝉鸣觉路，一犬护禅扉。\n花竹通诸径，旃檀大几围。\n云房吟卧久，直到晚凉归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23237,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日偶成柬惟秦","author":"徐熥","text":"何方堪避暑，胜地觅清幽。\n坐选云边石，吟寻水畔楼。\n偏宜山友共，唯许野僧留。\n一日一丘壑，安閒直到秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23238,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日园居柬履吉","author":"徐熥","text":"山静晚凉初，僧寮寂不如。\n碍云嫌竹密，受月爱藤疏。\n茶熟焚香饮，诗成洗砚书。\n惟君知此况，愿数过吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23239,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀元直客金陵","author":"徐熥","text":"经年客白门，书札见寒温。\n共作几回梦，各销无限魂。\n听莺桃叶渡，嘶马杏花村。\n欲识思君泪，请看衣上痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23240,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈广文弃官还温陵","author":"徐熥","text":"白首厌微官，沧江恋钓竿。\n隐耽初服贵，老怯旧毡寒。\n绿酒枌榆社，清斋苜蓿盘。\n好将平子赋，时对刺桐看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23241,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送白经历入觐","author":"徐熥","text":"迁客朝天去，王程不可留。\n谁知飞鞚日，政及赐环秋。\n残雪燕山路，微霜济水舟。\n从来白司马，未合老江州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23242,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钱叔达还吴兴","author":"徐熥","text":"住伤流落久，去惜别离难。\n衣上三年泪，尊前片刻欢。\n西风杨柳岸，夜雨蓼花滩。\n山水含孤调，从今何处弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23243,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过惟秦响山堂","author":"徐熥","text":"习隐栖南亩，躬耕受一廛。\n激流崩野岸，凿井割邻泉。\n蟾黾游丝困，凫鹥乱苇眠。\n考槃吾有志，敢吝买山钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23244,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"经废寺","author":"徐熥","text":"宝殿莽萧萧，残僧宿敝寮。\n壁馀昏后画，树绝挂时瓢。\n碑毁龟趺损，梁荒鼠族骄。\n听经知识少，驯虎度危桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23245,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王献子还袁州","author":"徐熥","text":"相逢当夏首，相别忽秋残。\n逆旅淹留久，空囊去住难。\n芦飞鸿外白，枫落马头丹。\n已乏绨袍赠，霜风今又寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23246,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题邓国弼贮青亭","author":"徐熥","text":"烟霞处处深，紫翠满遥岑。\n夜静松分籁，天凉竹送阴。\n野麇随独往，山鸟荅閒吟。\n古木苍苍色，居人指邓林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23247,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题余伯明龙沙遗谶","author":"徐熥","text":"相逢证九还，一窍指玄关。\n道契鸿濛外，神游鹤驭间。\n丹砂延绿发，白日驻红颜。\n试问龙沙回，予名列几班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23248,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"涪州张节妇","author":"徐熥","text":"涪水澄如练，还同节妇心。\n柏舟吟自苦，湘竹泪何深。\n矢志终箕帚，留颜见稿砧。\n贞魂应不朽，褒宠有纶音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23249,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"方山严孝子","author":"徐熥","text":"苦节甘辞禄，幽栖濑水边。\n为忧亲白发，非薄宦青毡。\n名列高贤传，山留处士阡。\n遗孤垂老日，犹废蓼莪篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23250,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"芊江雪夜留别社中诸子","author":"徐熥","text":"岁晏强为客，时危怯离家。\n孤身冲雨雪，双泪别烟霞。\n前路天难尽，故山云易遮。\n半生于役苦，赢得鬓将华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23251,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"不寐","author":"徐熥","text":"展转怀乡国，愁心夜更繁。\n猿声烟外峡，渔火水边村。\n屡醒无完梦，频啼有乱痕。\n廿年婴世网，销尽几多魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23252,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嵢峡道中即事","author":"徐熥","text":"腊尽天犹暖，林深翠未凋。\n石多盘谷口，路半出山腰。\n云色愁当岫，滩声怒过桥。\n邮亭看尚远，落日见归樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23253,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]