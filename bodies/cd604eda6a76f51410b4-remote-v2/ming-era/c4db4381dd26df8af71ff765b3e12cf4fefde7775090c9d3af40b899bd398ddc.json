[{"title":"从军行八首 其六","author":"王世贞","text":"蹀马吹尘紫极昏，洗刀飞血九河浑。\n长城直拓三千里，表取阴山作北门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12020,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从军行八首 其七","author":"王世贞","text":"胡姬学得汉宫眉，辛苦风尘损玉肌。\n不为青春容易改，十年番地失焉支。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12021,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从军行八首 其八","author":"王世贞","text":"铁骑横驱瀚海尘，戈船直捣瘴天春。\n不知南北功多少，羞作麒麟第二人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12022,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"横江词四首 其一","author":"王世贞","text":"越女红妆隐画桡，惊波无际雪山摇。\n贪趋破镜西陵约，不怕风江八月潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12023,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"横江词四首 其二","author":"王世贞","text":"江上檀郎来往频，婆娑妙舞赛江神。\n来时风水随船尾，欲往惊涛好涉旬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12024,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"横江词四首 其三","author":"王世贞","text":"锦缆罗帆翡翠舠，长年催趁午时潮。\n江头杨柳深相恨，折损春风几万条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12025,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"横江词四首 其四","author":"王世贞","text":"青江一线日边开，万古东流去不回。\n闻道海波穿地底，可能还向碛西来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12026,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋宫曲","author":"王世贞","text":"桂宫飘粟御筵香，银漏初添恩正长。\n唱罢凉州天似水，百花仙队按霓裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12027,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春宫曲","author":"王世贞","text":"十二珠帘帖绛纱，山香一曲驻飞花。\n当筵拜领葡萄酒，纤月双弯衬脸霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12028,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凉州曲 其一","author":"王世贞","text":"玉门春色胜临洮，敕使东来赐锦袍。\n闻道酒泉香似酒，不烦银瓮贮葡萄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12029,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凉州曲 其二","author":"王世贞","text":"千帐奚王作外臣，射雕归暮管弦新。\n笑来杯酒称兄弟，曾是沙场百战人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12030,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采莲曲","author":"王世贞","text":"千枝婀娜媚朝阳，风汎红衣露碧房。\n疑是吴王开水殿，酒深初散越姬妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12031,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨柳枝 其一","author":"王世贞","text":"西蜀竹枝君莫听，且听东吴杨柳枝。\n是处春阴堪画舫，何村树杪不青旗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12032,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨柳枝 其二","author":"王世贞","text":"杨柳吴阊千万枝，横塘风绾曲尘丝。\n不缘游子无攀折，总为情人少别离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12033,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨柳枝 其三","author":"王世贞","text":"飞花欲捲翠蛾颦，浪打萍飘恼杀人。\n犹胜洛阳东陌上，北风吹作马蹄尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12034,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨柳枝 其四","author":"王世贞","text":"十月寒轻叶未凋，淡黄疏绿短长条。\n无情有态堪怜处，日脚云头雨半腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12035,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浪淘沙 其一","author":"王世贞","text":"晴沙万叠倚江开，不断银山滚滚来。\n片晌只疑随浪去，千秋长自锦成堆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12036,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浪淘沙 其二","author":"王世贞","text":"潮来银海欲连天，潮落平沙故宛然。\n得似古查能贯月，一年一度女牛边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12037,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苏幕遮 其一","author":"王世贞","text":"碧魋朱氁紫金瞳，噏日濆波倒射空。\n不为偃师偏作眴，大家元住化人宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12038,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苏幕遮 其二","author":"王世贞","text":"鱼龙曼衍戏如神，簇队金牌色色新。\n珠帘不动天颜肃，始信支那有圣人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12039,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弘治宫词十二首 其一","author":"王世贞","text":"甲帐银灯夜未央，渐看鸳甃有寒霜。\n三千粉黛浑如扫，圣主重翻日讲章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12040,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弘治宫词十二首 其五","author":"王世贞","text":"五月鲥鱼白似银，传餐颇及后宫人。\n踌躇欲罢冰鲜递，太庙年年有荐新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12041,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弘治宫词十二首 其七","author":"王世贞","text":"琵琶双鸽暗凝尘，玉指生疏调未匀。\n自是经年无曲宴，不愁供奉数中人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12042,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弘治宫词十二首 其八","author":"王世贞","text":"御前黄盖进羹汤，玉箸频停不肯尝。\n应是司农闻水旱，蹙眉时读两三行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12043,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弘治宫词十二首 其十","author":"王世贞","text":"雪乳冰糖巧簇新，坤宁尚食奉慈纶。\n祈年好在斋宫宿，莫遣羊车别院频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12044,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弘治宫词十二首 其十一","author":"王世贞","text":"掖庭愁闭自年年，今日承恩雨露边。\n又是铺宫新例薄，空劳少府积金钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12045,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正德宫词二十首 其一","author":"王世贞","text":"十年彤管侍先皇，太液甘泉蔓草荒。\n七叶神孙今好武，苑西新辟斗鸡场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12046,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正德宫词二十首 其二","author":"王世贞","text":"蜀马分弸对打毬，纤腰帖地涴青油。\n金牌银盌从渠爱，谁敢争先第一筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12047,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正德宫词二十首 其五","author":"王世贞","text":"兔首熊蹯载后车，长杨辇道不须除。\n敕教颁给言官了，玉几知无谏猎书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12048,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正德宫词二十首 其七","author":"王世贞","text":"急敕甘泉暂解围，期门百骑少光辉。\n中官昨夜闻歌管，知道初从长信归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12049,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正德宫词二十首 其十一","author":"王世贞","text":"淡黄初缬草屠苏，侧坐萧家老秃驹。\n薄暮西风吹袂起，小龙团底露真珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12050,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正德宫词二十首 其十二","author":"王世贞","text":"西师入座讲莲经，敕许娙娥取次听。\n缨络宝珠从密施，莫留馀障在宫庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12051,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正德宫词二十首 其十四","author":"王世贞","text":"上阳宫里进葡萄，争道沾恩色自骄。\n小合黄封双御押，大官将赐霍嫖姚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12052,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正德宫词二十首 其十五","author":"王世贞","text":"六军容卫自星罗，熊馆鹰房处处过。\n此日灵台颛候望，不知龙虎气谁多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12053,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正德宫词二十首 其十六","author":"王世贞","text":"帐殿春眠日色饶，掖垣簪珥自群僚。\n中官又启排当就，亭午传宣且放朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12054,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正德宫词二十首 其十七","author":"王世贞","text":"纯银八宝白如霜，金豆离离出尚方。\n撒放御阶凭拾取，内人男子拜君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12055,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正德宫词二十首 其十八","author":"王世贞","text":"百子池头九子祠，太皇恩许进香时。\n深宫岂少宜男草，何地曾沾雨露私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12056,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正德宫词二十首 其十九","author":"王世贞","text":"传呼京兆进春牛，百戏鱼龙曼衍游。\n杂遝香车看不见，好登辽后洗妆楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12057,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西城宫词十二首 其六","author":"王世贞","text":"红轩步挽碧油轮，白玉阶头不动尘。\n阿监排当须次第，喜来俱作放班人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12058,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西城宫词十二首 其八","author":"王世贞","text":"梨园弟子鬓如霜，十部龟兹九部荒。\n妒杀女冠诸侍长，大罗天上奏霓裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12059,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西城宫词十二首 其九","author":"王世贞","text":"鳌山烟火冠春城，步辇龙旌倒褪行。\n忽报大官供法酒，玉音宣唤五先生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12060,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西城宫词十二首 其十","author":"王世贞","text":"西苑传看白鹿归，金鳌桥下立依依。\n不论供张能如鹿，愁见鸳鸯接翅飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12061,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西城宫词十二首 其十二","author":"王世贞","text":"不御坤宁二十年，玉阶埋月树迷烟。\n联房自信无人到，閒放猧儿自在眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12062,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴中迎春曲八首 其一","author":"王世贞","text":"十五女儿好容颜，恰似杨花太剧颠。\n贪过吴桥新水发，湿着罗襦不解怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12063,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴中迎春曲八首 其二","author":"王世贞","text":"侬家少年来看春，绣帢雕鞍色色新。\n拾得金钿便骄惜，不道红妆恼杀人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12064,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴中迎春曲八首 其三","author":"王世贞","text":"弓鞋罗袜细温存，偏爱春泥印齿痕。\n看到阊门天欲暝，六街灯月照黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12065,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴中迎春曲八首 其四","author":"王世贞","text":"今年冰雪太迟春，分外催花羯鼓频。\n行过贵家春不度，隔帘呼住打毬人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12066,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴中迎春曲八首 其五","author":"王世贞","text":"桥边宛宛双柳株，贾客蹀?千金驹。\n停鞭半醉道春好，笑入胡姬旧酒垆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12067,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴中迎春曲八首 其六","author":"王世贞","text":"青天幻出木兰舟，对对妖童发似油。\n齐唱采莲新乐府，高楼抛下锦缠头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12068,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴中迎春曲八首 其七","author":"王世贞","text":"白发田家一老翁，欲行翻更仗儿童。\n只问勾芒甚颜色，还呼社酒醉东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12069,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴中迎春曲八首 其八","author":"王世贞","text":"帝城风物倍光华，却比吴阊少见花。\n解道天街春尚晚，不知先落五侯家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12070,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"燕京四时乐四首 其一","author":"王世贞","text":"城南韦曲春可怜，侯家铺埒黄金钱。\n即妨蹀?要归去，十五搊筝杨柳烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12071,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"燕京四时乐四首 其二","author":"王世贞","text":"东华空望碧栏杆，高栋承云赤日寒。\n不是蒲萄浑难醉，银冰片片水精盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12072,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"燕京四时乐四首 其三","author":"王世贞","text":"蓟门霜叶马初肥，蜀锦轻装七宝围。\n日暮金丸弹不尽，红尘一骑趁鹰归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12073,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"燕京四时乐四首 其四","author":"王世贞","text":"青楼小妇熨瑶筝，飞雪敲窗万玉声。\n三十六簧寒不起，自歌金缕到天明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12074,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古意 其一","author":"王世贞","text":"传君移戍古梁州，明月心悬陇水流。\n莫怪梦魂逢不得，书来依旧玉关头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12075,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古意 其二","author":"王世贞","text":"莫誇灵药镜中过，自是君恩薄更多。\n不信雕弧摧九日，却留明月隐嫦娥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12076,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏戍卒 其一","author":"王世贞","text":"夜静风高角自鸣，铁衣长挂酒频倾。\n细君莫厌离家语，争道明朝又出兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12077,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏戍卒 其二","author":"王世贞","text":"岁岁从军出酒泉，未知何日勒燕然。\n相逢莫更嫌衰贱，多少黄沙掩少年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12078,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏戍卒 其三 送蒋子南归","author":"王世贞","text":"乍逐春风上帝畿，如何短棹乂将归。\n看君身似潇湘雁，不厌年年南北飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12079,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏戍卒 其二","author":"王世贞","text":"潞水驿前双画桡，送君频上又相邀。\n征衣半湿离筵酒，心到阊门第几桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12080,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏戍卒 其五 病起","author":"王世贞","text":"推枕春林送曙莺，渐惊虚白上窗棂。\n书尘贫病无他业，一卷黄庭内景经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12081,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏戍卒 其二","author":"王世贞","text":"萧疏病骨怕逢秋，伏雨斜风到枕头。\n一夜芭蕉恼不彻，他自无情我自愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12082,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"计偕途中四绝句 其一","author":"王世贞","text":"阊门女儿妆髻轻，十三十四学银筝。\n行人不解丝中语，都道阳关送别声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"计偕途中四绝句 其二","author":"王世贞","text":"金陵望中山抹烟，铁瓮城头浪拍天。\n居人尽说风波恶，江口何时不放船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"计偕途中四绝句 其三","author":"王世贞","text":"日落徐河水乱流，高城椎柝漏声愁。\n相逢欲解珊瑚玦，不见胡姬旧酒楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"计偕途中四绝句 其四","author":"王世贞","text":"济河北流复南流，行到天津南北愁。\n人生顺逆虽有分，耐可此身居上游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立春日与吴峻伯席上分韵呼采得一枝花","author":"王世贞","text":"绮裀分彩占年华，叠翅鸳鸯色并誇。\n最是夜来春信早，就中呼得一枝花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将还故乡醉别燕中友人 其一","author":"王世贞","text":"葡萄新酿紫霞文，累釂深卮谢数君。\n挂席还依蓟门月，鸣榔初荡阖闾云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将还故乡醉别燕中友人 其二","author":"王世贞","text":"酒肆藏名君不知，别来方解问相思。\n江南添个疏狂客，莲叶风前唱竹枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏题徐迪功五集后 其一","author":"王世贞","text":"一贫无梦到封侯，屠狗吹箫不自由。\n今日功成身亦贵，可堪人记少年游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏题徐迪功五集后 其二","author":"王世贞","text":"十年家火炼凡铅，一日中原遇大还。\n君自羽仪朝帝阙，莫将垆鼎误青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别于鳞子与子相明卿十绝 其一","author":"王世贞","text":"十年为客问吴山，锦缆安流此日还。\n唯有故人歌一阕，行云不度似阳关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别于鳞子与子相明卿十绝 其二","author":"王世贞","text":"鸣鞭醉色傲幽州，饮马滹沱水乱流。\n明月独悬南北泪，黄云偏载古今愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别于鳞子与子相明卿十绝 其三","author":"王世贞","text":"西风独许季鹰回，紫酒青莼亦快哉。\n八月吴江潮水发，挂帆天际雪山来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别于鳞子与子相明卿十绝 其四","author":"王世贞","text":"五子应从五岳来，钧天帝享动天台。\n相逢此地原非偶，散入中原岂乏才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别于鳞子与子相明卿十绝 其五","author":"王世贞","text":"日观峰高高插天，天门双辟俯苍烟。\n无人共拾金光草，拄杖行吟望斗边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12096,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别于鳞子与子相明卿十绝 其六","author":"王世贞","text":"扁舟八月向维扬，素魄含波欲似霜。\n北地翻传广陵散，故人天外意茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12097,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]