[{"title":"溪隐为友人作","author":"程本立","text":"练溪闻说草堂成，拟托幽闲老此生。\n楠树秋风棋局晚，桃花春水钓丝晴。\n群鸥烟雨忘心迹，一鹗云霄荐姓名。\n为尔题诗翻自笑，沧浪何日濯吾缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25701,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临清道隐为豫府饶纪善作","author":"程本立","text":"秋水一波清且深，隐居谁识道人心。\n流行不息终归海，开辟俱生直到今。\n川上曾闻尼父叹，源头重感晦翁吟。\n何时一笑空明里，同照扁舟雪满簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25702,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠良医杨士达","author":"程本立","text":"南京旧识杨医师，北来中都重见之。\n亲王纪善为作传，护卫将军能赠诗。\n石田芝草白云里，丹屋杏花春雨时。\n刀圭乞我脱凡骨，身到玉堂应未迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25703,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠眼科俺都刺","author":"程本立","text":"人生妙处惟青卢，光明不息照八区。\n胡为虾蟆蚀白月，欲以象罔求玄珠。\n青囊系肘甚奇秘，金篦刮膜只斯须。\n吁嗟世俗盲五色，俺师俺师绝代无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25704,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠庄浪王镇抚","author":"程本立","text":"左陈书史右弓刀，谁道边城军务劳。\n万马秋风肥苜蓿，一䲭春水醉葡萄。\n山山部落西戎静，夜夜旌旗北斗高。\n政是太平无事日，不妨诗态忆吾曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25705,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠吏隐","author":"程本立","text":"我志本伊傅，我学非申韩。\n胡为窘簿书，得匪负衣冠。\n圣哲动以时，否泰识其端。\n卷舒则在我，何适非所安。\n冉冉雁鹜趋，聈聈龙蛇蟠。\n旷心遗困辱，沉迹远疑患。\n关门古有令，封疆亦有官。\n公庭有执钥，涧阿有考盘。\n请渠勿投笔，努力以加餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25706,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九我堂为王彦麟赋","author":"程本立","text":"匪亲曷有我，有我能无亲。\n我当供我职，我情莫我申。\n父生母鞠畜，长育我拊循。\n出入又腹我，反复顾我勤。\n亲恩有如此，罔极同苍旻。\n儿心若寸草，胡能报阳春。\n七闽去六诏，不翅越与秦。\n母发镜中雪，父骨山下坟。\n祭扫旷岁时，定省缺晨昏。\n瞻望悲行役，何怙哀鲜民。\n上山山有颠，涉水水有津。\n悠悠百年内，孝子难具陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25707,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立春前一日寿左布政鴳居张先生 其一","author":"程本立","text":"好风明月自东来，岁酒先沾柏叶杯。\n元气机缄生万物，寿星光焰烛三台。\n汉廷尽对贤良策，董子独怀王佐才。\n愿使斯民乐长治，熙然鼓腹上春台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25708,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立春前一日寿左布政鴳居张先生 其二","author":"程本立","text":"五十儒臣两鬓丝，政缘赤子切寒饥。\n化行南诏同中国，道在西铭觉后知。\n宾幕梅花春意早，公堂柏树午阴迟。\n偕跻寿域苍生愿，载拜称觞岂我私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25709,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题风木堂卷","author":"程本立","text":"男儿徒食禄，亲没为谁荣。\n竟抱终天憾，深违爱日情。\n九原双泪彻，万事一毫轻。\n最是堂前木，悲风日夜生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25710,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题鹤湖草堂卷为况伯章司税","author":"程本立","text":"飞尘不到鹤湖边，隐者堂成似列仙。\n弱水蓬莱三万里，人民城郭一千年。\n煮茶风雪烟浮树，载酒空明月满船。\n此趣直忘身与鹤，扬州何意问腰缠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25711,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题君山别业画卷为黄伯昂","author":"程本立","text":"画图林壑起云烟，使者高怀寄静便。\n背郭真成浣花屋，看山如坐洞庭船。\n柴门黄叶邻僧扫，石径苍苔野鹿眠。\n如此故巢劳远忆，只应头白是归年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25712,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题天竺昙敷上人法华山房卷","author":"程本立","text":"昙师法华室，只在鉴湖边。\n白日开三竺，清光出五莲。\n海龙曾听咒，庭鸟亦知禅。\n一月云床宿，吾生信有缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25713,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题黄氏山水小画 其一","author":"程本立","text":"青山绿树有楼台，春水晴天一镜开。\n兴发不因寻贺老，酒船那得过湖来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25714,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题黄氏山水小画 其二","author":"程本立","text":"忘机得与白鸥亲，春雨汀洲杜若新。\n一笑题诗山水画，不知身是画中人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25715,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题吴门孝子卷","author":"程本立","text":"股刲儿可忍，病去母能存。\n不是轻遗体，其如感至恩。\n秋风多在树，夜雨自生萱。\n今日终天戚，衣襟满泪痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25716,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题紫阳书屋画卷为鲍掾","author":"程本立","text":"朱子道鸣濂洛后，紫阳山并华嵩高。\n生民不被当时泽，从祀方从后世褒。\n封事万言焚谏藁，棹歌九曲付渔舠。\n看君图画增予感，千里云林怅望劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25717,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题刘士平竹所卷","author":"程本立","text":"凤凰溪头十亩园，我昔种竹竹已蕃。\n揃除杂乱扶正直，不使恶类相牵援。\n春雷动地儿孙长，森然玉立参天上。\n玄冬何嫌霜霰重，赤日自憩风飙爽。\n一从宦辙梁宋游，熇埃眯目挥汗流。\n琉璃八尺谁卷送，琅玕一个不可求。\n腐儒本非食肉相，十年归梦随吴榜。\n余生未了苜蓿盘，此身须付桃枝杖。\n永嘉刘郎思故山，有庐亦在万竹间。\n觅我狂歌托幽抱，歌成转觉俱愁颜。\n长竿把得溪头钓，短箫吹作江南调。\n此时烧笋饭刘郎，喷案不妨同一笑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25718,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题望云图","author":"程本立","text":"忆弟杜陵恨，思友陶翁情。\n矧兹登太行，能不怀所生。\n天伦孰为重，孝感莫非诚。\n无形恒有视，岂直云英英。\n依云眷亲舍，益使忧抱萦。\n斯人已千载，简册垂令名。\n披君望云图，今古一章程。\n谁独非人子，令我心茕茕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25719,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题张德麟活水轩卷","author":"程本立","text":"川流虽浩浩，泉出乃涓涓。\n地势东南下，河图一六先。\n净心涵湛碧，探理入幽玄。\n我学如潢潦，诗成益惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25720,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题严氏苍苍楼严氏子陵后也今居上虞山中楼名盖取范文正公云山苍苍之句云","author":"程本立","text":"严陵滩下水潺潺，千载高名宇宙间。\n风节最称东汉士，子孙犹隐上虞山。\n沧江烟雨群鸥没，落日云霄一鸟还。\n好倚楼居同极目，久淹官署独何颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25721,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题墨桃","author":"程本立","text":"天台美人红雪肌，玉洞春深曾见之。\n今日风沙吹面黑，出山不似在山时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25722,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画 其一","author":"程本立","text":"瀑雪青天落，松涛白日飞。\n罢琴成独赏，得趣在忘机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25723,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画 其二","author":"程本立","text":"山水东南好，持竿我亦曾。\n只今江海上，何地着严陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25724,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题梨花锦鸠图 其一","author":"程本立","text":"别愁归恨是清明，眼眯风沙白发生。\n纵有花枝如画里，看花不似少年情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25725,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画送人归越中","author":"程本立","text":"十年归梦落沧波，一日飞帆渡浙河。\n指点南山最青处，故巢依旧白云多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25726,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题山水画 其一","author":"程本立","text":"白云载青山，青山欲飞去。\n㶁㶁石间泉，沉沉谷中树。\n得非匡庐游，无乃天台路。\n愿与幽人期，逍遥岁年暮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25727,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题山水画 其二","author":"程本立","text":"舣舟上层台，抱膝寄遐想。\n飞鸥闪余晖，秋色凄苍莽。\n山川岂不好，岁月忽已往。\n悲来一长啸，旋飙激清响。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25728,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题友人剡溪书屋画卷","author":"程本立","text":"好买山阴二顷田，草堂只住剡溪边。\n谁无白饭鱼羹吃，未有青鞋布袜缘。\n万壑烟霞晴看画，五更风雨早朝天。\n乞身得遂南归愿，雪夜怀人即放船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25729,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题子昂烟波归兴图","author":"程本立","text":"此生只合住湖州，罢得微官任白头。\n尽买太湖三万顷，烟波随处着渔舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25730,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题浦舍人画梧桐竹石 其一","author":"程本立","text":"云林弟子浦长源，风雪相逢白下门。\n请写江南山水窟，着我读书秋树根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题浦舍人画梧桐竹石 其二","author":"程本立","text":"锦石成山花满川，子孙一旦鬻平泉。\n疏篁古树苍厓雪，茅屋看来已百年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题三余斋卷送钱掾还乡","author":"程本立","text":"白门送客日已斜，车马塞路风吹沙。\n金印何须大如斗，锦城不如早还家。\n雨夜空庭惟木叶，雪晴深谷有梅花。\n三余斋中自足乐，闭门读书双鬓华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题兴平教谕罗时可西山清啸集","author":"程本立","text":"西山老人须发苍，舒啸直登千仞冈。\n应谷大声穿石裂，旋风遗响入云长。\n江流赤壁空寒月，树倚苏门几夕阳。\n今古英豪本同调，不胜遐想接微茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌撒题画四绝 其一 鹡鸰","author":"程本立","text":"急难思我弟，万里各漂零。\n原上西风急，伤心见鹡鸰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌撒题画四绝 其二 白头翁","author":"程本立","text":"乌蛮天万里，客鬓不禁秋。\n自在高枝鸟，胡为也白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌撒题画四绝 其三 杜鹃","author":"程本立","text":"啼血口流丹，月明花影寒。\n不堪愁里听，只好画中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌撒题画四绝 其四 双燕","author":"程本立","text":"不归江上宅，烟柳暗春郊。\n多愧双飞燕，年年觅旧巢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐景旸趋庭卷","author":"程本立","text":"柱石老臣持使节，芝兰儿子拜亲闱。\n九重天语传丹陛，五色云章制彩衣。\n官舸夜帆风力便，寿觞春酒雪花飞。\n人生一乐真难得，况尔名家世所稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题陈谷宾思亲卷","author":"程本立","text":"春雨白鱼江水深，夕阳乌鸟塞垣阴。\n谁无远道思亲泪，不及高堂念子心。\n五色斑衣云满袖，百年华发雪盈簪。\n如何此乐恒难得，陟岵诗成感至今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题梦彩堂大理推官冯思齐氏自为监察御史时扁其堂曰梦彩洪武廿一年岁次戊辰冬予过大理思齐以卷征诗","author":"程本立","text":"身上彩衣今夜梦，囊中绣线旧时缝。\n两眼忽迷云五色，八翼直飞天九重。\n袖翻蝴蝶春阶舞，盘斫鲤鱼朝馔供。\n百年此乐人间少，睡起倒裳听禁钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题韩伯时寿藏卷 其一","author":"程本立","text":"自营寿穴松林护，预乞墓铭厓石镌。\n四海交游几人在，百年宇宙一身全。\n判山容与花时酒，剡水溟茫雪夜船。\n去住何乡非乐土，死生今日任苍天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题韩伯时寿藏卷 其二","author":"程本立","text":"老来斑鬓谢朝簪，买得青山有赐金。\n汗简文章千古事，茧窝骸骨百年心。\n冰霜旧柏乌群集，风雨小松龙一吟。\n蒲裹车轮鸠刻杖，苍天有待意何深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题王理问宜休亭画卷","author":"程本立","text":"老来多病懒衣冠，结得间亭日倚阑。\n岂为好名聊傲世，正缘知止欲辞官。\n三更海气云霞赤，六月树声风雨寒。\n归到闽中旧台观，不须山水画图看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题凌景南春露轩 其一","author":"程本立","text":"忆昔园林春露时，高堂慈母看孤儿。\n金茎愿得承仙掌，玉屑和来献寿卮。\n润入锦棚生竹笋，湿沾斑袖滴花枝。\n于今怵惕兴悲感，恍若音容一见之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题凌景南春露轩 其二","author":"程本立","text":"母榇扶来魄未安，春山草木露漙漙。\n松间晓滴花还破，薤上阳晞泪不干。\n旧宅鱼泉空有井，小囊熊胆尚留丸。\n构轩题扁情何极，乞得诗铭后代看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画龙","author":"程本立","text":"水底或沉盈尺梭，天际忽腾千丈波。\n神灵变化固莫测，世能豢之奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画菜","author":"程本立","text":"酒酣夜发清冰瓮，朝罢春沾白玉盘。\n十载旧恩天上梦，一根生意画中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题山水小画 其一","author":"程本立","text":"太湖三万六千顷，七十二峰湖上山。\n草阁酒醒风雨过，棹歌声在水云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题山水小画 其二","author":"程本立","text":"江南不到几秋萤，风壑云林梦草亭。\n万里乾坤双老眼，他山不似故山青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题望云卷","author":"程本立","text":"几见夕阴天际合，恒瞻晓气日边开。\n百年只愿斑衣着，五色何当玉女裁。\n下土苍生渴霖雨，边城白发走尘埃。\n陈情倘许排阊阖，归到庭闱心尚孩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题郭掾未伸轩卷","author":"程本立","text":"亲丧不葬孤儿罪，声欲彻天成永号。\n一日九原封马鬣，百年万事付鸿毛。\n秋风白发身今老，寒食青山梦转劳。\n家圃卖瓜归去好，墓庐攀柏种来高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题山水画送人归楚","author":"程本立","text":"西南六诏山无数，多在蛮烟瘴雨间。\n不似故乡归去好，洞庭湖上看君山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题百鸟图","author":"程本立","text":"燕雀安知鸿鹄志，凤凰岂同鸡鹜群。\n君看九十九禽外，一禽举翮摩青云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题刘中云海蓬莱轩","author":"程本立","text":"谁信刘郎是谪仙，行轩不减洞中天。\n蛟龙嘘气成楼阁，岛屿余波见市廛。\n鹤到诗坛通远信，人凭棋局惜流年。\n卜居自爱三山好，赢得烟波满目前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题蔡氏同寿堂","author":"程本立","text":"八荒仁寿域，四海太平时。\n盘古乾坤久，华胥日月迟。\n长年非大药，至乐在标枝。\n总是吾君力，苍生恐未知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"费孝子诗","author":"程本立","text":"蔡河冰坚夜苦寒，将军上马重裘单。\n谁知一卒独念母，解衣卧冰良足叹。\n剖冰求鱼鱼易得，有母不见供谁食。\n万事无如子母全，一寒敢为形骸惜。\n尔虽不自惜，天也宁无知。\n一朝有王命，命尔求母任所之。\n山川邈邈荆湖路，儿行遑遑母何处。\n澧州城边求得之，母发萧萧已垂素。\n初逢不觉泪交颐，却话兵戎始别时。\n一失乡闾二十载，只今谁在谁孤嫠。\n奉母还居蔡河上，人力胡能神所相。\n王恩不特赐之金，且复其身俾终养。\n新妇从夫未识姑，吁天一诚夫与俱。\n儿能负米妇能爨，返哺不愧禽中乌。\n宋朝孝子河中倅，苏公文章传海内。\n江南流落孝僧诗，鲜于草书称近代。\n军中小卒谁所誉，金华作传不我诬。\n忠臣孝子何代无，呜呼忠臣孝子何代无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寻刘集贤隐居","author":"程本立","text":"方瞻紫锦屏，倏览青玉案。\n兹山亘百里，我行山未半。\n余雪云俱白，新泉冰始泮。\n春姿动晴壑，好鸟自相唤。\n探幽会披榛，纪胜欲濡翰。\n西投集贤里，息鞅日已旰。\n衣冠拜遗老，使我发深叹。\n垂世贵立言，有竹青可汗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"斋宿皇陵夜起俟王驾","author":"程本立","text":"济济肃冠佩，隐隐聆和鸾。\n彤庭炯斜月，松柏飒以寒。\n神山卫皇陵，左右龙虎盘。\n孝思穆宸衷，王心岂遑安。\n秋尝日维吉，夙驾夜未阑。\n骏奔执笾豆，臣亦备祠官。\n所职在诚恪，匪曰盛容观。\n斯言告在列，同心臭如兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登封至日","author":"程本立","text":"登封一室青山下，长至千官玉陛前。\n赤脚欲凌神盖雪，朱衣曾惹御炉烟。\n惭无衮职丝毫补，愿祝皇图亿万年。\n静坐寒窗看羲画，经筵或者问韦编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庄浪王镇抚省先墓于永嘉道经大梁持卷索诗随笔塞命","author":"程本立","text":"秦之山，越之水，将军去家五千里。\n南云飞，北风起，将军忆亲何日已。\n男儿得禄不逮养，有泪直彻黄泉底。\n呜呼秦之山，越之水，锦衣煌煌照桑梓，九原有知能不喜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出使钱塘收书籍发大梁","author":"程本立","text":"奉使南行晓出关，回瞻宫殿紫云间。\n乡里那从枉道入，图书只载满船还。\n百年艮岳尘飞海，八月胥涛雪涌山。\n一到钱塘一怀古，鄂王坟下泪潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"简宝鸡王二尹","author":"程本立","text":"南经险道入褒斜，十步跻攀九叹嗟。\n奇骏旧曾分上厩，蹇驴今欲借东家。\n渭河夜雨鸣清濑，秦岭朝云化紫霞。\n万里一官谁见忆，天涯更复有天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏咏石饼","author":"程本立","text":"我心匪石不可转，炼石作饼心弥坚。\n自看一丸凝白雪，谁将五色补青天。\n缩葱侍御世所鄙，全椒道士骨已仙。\n铅金砂汞苦难得，不如服此能延年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]