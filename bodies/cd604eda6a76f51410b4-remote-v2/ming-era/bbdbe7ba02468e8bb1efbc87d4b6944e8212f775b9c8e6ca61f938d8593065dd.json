[{"title":"答和王君载感白发作","author":"王世贞","text":"拄颊听歌白发词，久知无复少年时。\n君怜日日真难挽，我狎星星不解悲。\n青镜总拚微业过，红颜聊借浊醪迟。\n无论老子心犹热，懒向禽釐叹染丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"肖甫中丞拟八月见过近九日始达吾州贻诗有黄花孟嘉句聊此奉和","author":"王世贞","text":"八月遥闻使者槎，过期霜色近寒花。\n自云卤簿江州守，偏识柴桑处士家。\n旧事数从杯底得，壮心时傍句中加。\n君知布帽应难堕，莫以风流嗣孟嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梁思伯内翰过访","author":"王世贞","text":"芜城分手叹离居，尺素论心岁不虚。\n君爱王维诗里画，我悬梁鹄帐中书。\n娄江柏叶将云暖，庾岭梅花带月疏。\n此会何年更何地，可能杯酒不踌蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"思伯过小祗园分韵得飞字","author":"王世贞","text":"洗竹穿萝坐钓矶，杯行到手莫教挥。\n峰头初月迎船出，树杪清霜应曲飞。\n花色可沾鸡舌施，鬓毛疑拂马肝归。\n君知奉使停青雀，差胜为郎在紫微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11410,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陆叔原楚生兄弟自江右归携德甫用晦书见存且剧谈二君相遇之厚赋此寄之","author":"王世贞","text":"三十六鳞秋乍肥，枫江回望思依依。\n斗间人觅双龙去，吴下书从二陆归。\n剑曲未终迁幸舍，筑歌才和对沾衣。\n菰芦何限东南美，其若霜风识者稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11411,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"销夏湾","author":"王世贞","text":"挂帆秋色太空低，缥缈峰回上与齐。\n别借五湖天一曲，中分双崦地东西。\n松杉翠合家堪隐，橙橘黄萦路不迷。\n莫问吴王销暑事，采芳春径草萋萋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11412,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登缥缈峰二首 其一","author":"王世贞","text":"不辞芒屩破蒙茸，贾勇先登第一峰。\n湖外山围青玉案，波间岛插紫芙蓉。\n龙宫袭籁俄成吹，鹿苑嘘烟忽自封。\n指点空濛浑未定，乍惊云物荡吾胸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登缥缈峰二首 其二","author":"王世贞","text":"风物清秋转自佳，抚膺高眺渺无涯。\n千家射日鱼鳞上，百舸穿云雁字排。\n天目障青遥入眦，角头分翠近当怀。\n胥涛怒激非吾分，蠡汎逍遥兴不乖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"资庆寺","author":"王世贞","text":"径转峰回寺宛然，古桥深草锁戋戋。\n客将流水同无住，僧似长松不记年。\n法食喜分龙女供，禅房幽借鹿麑眠。\n行歌颇爱归途好，屐齿斜阳乍一穿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠洞庭九十三蔡翁","author":"王世贞","text":"由来黄绮擅高风，今代耆英又属公。\n家住两山人世外，身安六帝太平中。\n青藜暂借还能却，白雪因多转更工。\n自是耳根能入妙，无烦社酒为治聋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿长圻寺赠僧解空","author":"王世贞","text":"偶从湖汊系归船，曳杖寻钟古刹悬。\n幢石草侵天监字，讲坛松漏莫釐烟。\n僧云净社难呼饮，汝不长斋返近禅。\n临别杨枝犹解赠，宰官重到定何年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归自东洞庭望莫釐峰","author":"王世贞","text":"已凭藜杖恣攀缘，兴尽还胜入剡船。\n远水蒸霞开色界，空林答响奏钧天。\n莲华倒挂双帆影，橘柚寒收万井烟。\n最是莫釐堪骋望，吴门匹练为谁悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陆叔平邀过山庄看菊","author":"王世贞","text":"夫君种菊自年年，买得支公胜地偏。\n甘谷移来鸣玉水，给园分作布金田。\n雅闻彭泽翻为具，能使江州忘遗钱。\n今夜东篱月色好，野夫从醉不回船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再游天池诸山","author":"王世贞","text":"十年三踏天池路，路转峰回胜自知。\n树老寒暄无异色，山深向背有馀姿。\n寺当托钵分斋候，僧是闻钟出定时。\n大好忘言领秋兴，笋舆松影夕阳移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张助甫至日见访作","author":"王世贞","text":"寒色柴门午未开，谁嘘邹律动葭灰。\n天将化日为长至，人忆丁年访旧来。\n夜语莲华惊促点，晨传竹叶喜宽杯。\n还应太史能书奏，海上祥云片片回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"助甫过小祗园分韵得云字","author":"王世贞","text":"王家宾从气凌云，争似风流张长君。\n一片清冰看自见，千秋白雪倡堪闻。\n空林啸月传铙吹，小艇回波荡縠文。\n今夜子猷斋畔竹，祇应翻向夹池分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭醉石山人朱察卿二首 其一","author":"王世贞","text":"岁逢单阏日逢斜，玉折兰摧重可嗟。\n不独文章无醉士，何人游侠是朱家。\n孤儿痛检囊中草，旧客愁悬匣里花。\n此后只应黄浦雪，子猷高兴向谁誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭醉石山人朱察卿二首 其二","author":"王世贞","text":"空闻雅度拟林宗，未有微官及曼容。\n忽陨大星名是酒，纵埋丰狱气成龙。\n人疑一醉还千日，君自孤魂度九峰。\n满目风流都欲尽，莫将吾涕讶无从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"癸酉元日试笔","author":"王世贞","text":"爆竹严声彻夜传，曈昽旭日渐东悬。\n天开万历王正朔，人乐群方大有年。\n及尾屠苏深蜡色，含苞玉蕊媚春烟。\n相逢未卜行藏事，且向条风试酒钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邀助甫游虎丘","author":"王世贞","text":"寒色高台頫万家，坐来衿袖隐烟霞。\n逃禅再起生公石，倚醉频呼陆羽茶。\n今日青牛干气象，早时白虎出精华。\n司空自有冲星佩，来向兹丘问莫耶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"顾丈伯刚重封异数其先大夫再得给事京兆诰封","author":"王世贞","text":"两朝恩数向君偏，圣主人推达孝年。\n共道丝纶徵旧德，自将忠荩格皇天。\n西清再视中书草，北垄重题京兆阡。\n从此江东论四姓，还应甲族表诸贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四明吴生游大梁甚久其再往也谒余诗为赠","author":"王世贞","text":"束书担簦一奚囊，拟向人间识二王。\n音似庄生犹带越，赋如枚叔好游梁。\n春风骑从夷门去，烟雨鱼羹幸舍尝。\n授简只今多左席，古来词客有辉光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卢使君君万手植一松百花洲且侑以诗走笔奉谢","author":"王世贞","text":"万卉当春不敢开，孤松瞥见使君栽。\n犹惊柏府霜威重，似挟天门雨色来。\n陶令尽堪归后抚，生未许醉时颓。\n悬知满树秦风在，中夜龙吟首重回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"楚行意颇不决聊成一章","author":"王世贞","text":"邸吏空惊腰绶新，婆娑仍惜据梧身。\n文章殢我终投笔，岁月欺人转积薪。\n旧事懒听湘水曲，衰颜羞睹武陵春。\n何如且作祗园主，经卷茶铛次第陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送鸿胪侄孙赴官","author":"王世贞","text":"何言垂白始为郎，十上公车意未央。\n入洛风流追小阮，过江门第数诸王。\n传呼曙应金鸡唱，立仗春分玉笋行。\n况是朝端多父客，到厅丞相为施床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太师华亭相公枉驾海上因游小祗园奉赠一章","author":"王世贞","text":"悬却安车谢过从，忽占台斗暂移踪。\n千家儿女看司马，片语乾坤识卧龙。\n日暮林泉翻起色，春来桃李竞为容。\n知公不浅行云意，倘施西山最上峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"伏承太师相公枉驾祗园以五言八句留题皆真谛语不揣奉谢一章","author":"王世贞","text":"东来紫气有真人，给苑含辉祗树春。\n草忍自谙菩萨行，潭澄初现宰官身。\n杯中水月无明失，句里云霞法界新。\n若语世尊应好慰，只今魔地隐波旬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"皇甫子循佥事七十","author":"王世贞","text":"尊前金缕乍成衣，与唱人生七十稀。\n胜具总誇玄晏上，微官不厌曼容非。\n凌云健笔长馀綵，玩世青衫始易绯。\n共道荀家好兄弟，白云犹见一龙依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"要刘子真光禄出会","author":"王世贞","text":"十载时通白雪盟，朅来犹自昩平生。\n双鱼入袖元难灭，老骥逢师可不鸣。\n文度江东惭独步，真长晋代许齐名。\n船斋少宿丹阳尹，牛女应誇紫气横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陆与绳太仆","author":"王世贞","text":"尺一书来绶便丹，共传鸣玉上金銮。\n那知此日攻驹在，犹作当年失马看。\n人爱赐环时却易，我怜完璧晚逾难。\n如闻楚泽波臣状，庶子泉头好自宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"举主御史大夫傅公同年大司寇谢公款宴江寺感谢","author":"王世贞","text":"把酒青回江上峰，净筵分供玉芙蓉。\n凉从鸠署秋声起，暑避乌台霜气浓。\n海内何人能附骥，江南有客旧登龙。\n艰难往事那堪数，惜别衔恩意万重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金山与送者饮别登舟作","author":"王世贞","text":"江天高阁倚傀俄，惜别犹呼金叵罗。\n送客总归唯月在，游人欲老柰山何。\n才闻出夹吴音少，稍入中流楚调多。\n争道壮游官亦得，不知吾意已蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"肖甫中丞自采石驰归一醉而别至江州寄怀","author":"王世贞","text":"初闻牛渚驻旌旂，小队元戎早自归。\n乍合延津疑剑是，才违汉浦觅珰非。\n歌偏白石成名晚，身在青云折节稀。\n也道武昌鱼雁便，那能相忆不沾衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泊安庆江口即事","author":"王世贞","text":"扁舟孤泊下江干，父老能言保障难。\n楼观日将金紫锡，江山天辟画图看。\n风庐似倒降王旆，烟雀犹喧誓将坛。\n莫倚台城龙虎气，几愁无地可迎銮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登小孤山","author":"王世贞","text":"忽有苍翠来眉锋，跃然令我呼短筇。\n波心倒插白玉柱，水面秀出青芙蓉。\n平分吴江楚江地，对耸天南天北峰。\n老夫铁笛欲吹却，恐向盘涡惊卧龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至江州尚不得舍弟敬美除官信闷成却寄","author":"王世贞","text":"有鸟双栖偶一鸣，无才那敢论时清。\n才经楚泽人堪老，若到燕台马自轻。\n白雪和来难后辈，青云是处畏先声。\n与君暗忆祗园地，不冷莲花惠远盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江州答谢徐司空世寅时尚抚江藩兼致声德甫","author":"王世贞","text":"先朝抗疏许谁雄，白下偏惊鲍氏骢。\n出领江藩中执法，还平邦土少司空。\n情如庐岳千层厚，书借浔阳九派通。\n犹有丰城孤剑在，待君嘘拂便成虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七月望夕大参郑邦用佥事蔡景明戢敬之邀游赤壁二首 其一","author":"王世贞","text":"宾主西南胜事并，此游端足慰平生。\n杯仍七月称秋望，赋是双珠可夜明。\n战血至今高壁色，词源终古大江声。\n与君聊释盈虚意，忽听山城漏五更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七月望夕大参郑邦用佥事蔡景明戢敬之邀游赤壁二首 其二","author":"王世贞","text":"将坛文苑代称雄，指点千年感慨同。\n名在江山翻借色，事过天地竟何功。\n乡心暂托烹鲈后，客梦都抛别鹤中。\n秋月偶圆风自好，坐来群绪为君空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"癸酉秋再监楚棘感怀二首 其一","author":"王世贞","text":"从叨三晋领贤扉，南纪秋风又锁闱。\n屈产自良吾齿老，楚珩虽贵国工非。\n残灯晃影疑裁素，清柝传更似捣衣。\n功业少年诸不乏，倘容洴澼一翁归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11446,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"癸酉秋再监楚棘感怀二首 其二","author":"王世贞","text":"紫衫垂敝白须偏，潦倒惭非入棘年。\n听语雕虫身自厌，由来相马事空传。\n差强泽畔吟行地，却送河东赋上天。\n论赏进贤当不薄，可应还记介推田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11447,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋夜登明远楼观月作","author":"王世贞","text":"列炬分行鼓角催，江光如练倚栏开。\n初疑卞璧排空上，忽有隋珠破夜来。\n入坐天香真桂苑，披襟风色胜兰台。\n还将校获誇云梦，磊砢纷纶尽楚材。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11448,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠曾参议公公子中丞以三抚蜀甫迁官即归郢","author":"王世贞","text":"挂绯刚及赐绯时，总为云山惬素期。\n有子陈咸那教谄，为郎颜驷肯论迟。\n高从郢里倡春雪，远许巴人寄竹枝。\n见说原陵多祓地，可知童冠解相随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11449,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽九十三汤翁翁尝为吴邑丞时令子中丞以候代留襄","author":"王世贞","text":"共拟鸠筇履汉庭，忽惊鹤驭指青冥。\n吴中旧雨留棠树，天上新霾掩岁星。\n听罢府乌头欲白，攀来台柏树非青。\n襄阳耆旧能相挽，墨绖聊为借寇停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11450,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登黄鹤楼","author":"王世贞","text":"缥缈高凭崔氏楼，依微西眺祢生洲。\n天容孤鹤排空上，水合双龙抱郡流。\n一代真成春雪倡，千年谁识岁星愁。\n老夫聊玩人间世，任遣浮云黯不收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11451,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄鹤楼饯别蔡使君景明","author":"王世贞","text":"柏台高卧白云秋，静者由来有蔡侯。\n识我姓名真倒屣，念君离合重登楼。\n中天日傍长安出，薄暮云生大别愁。\n倘是五羊能见忆，莫辞双鲤向吴洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11452,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"魏顺甫晴川阁分韵得芳字","author":"王世贞","text":"忆醉渔阳春草芳，蹉跎回首廿年强。\n青萍斗傍孤城合，白首天容二子狂。\n高阁对悬今古色，浮云不尽往来樯。\n尊前忽语登龙事，慷慨悲歌泣数行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11453,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄答张助甫 其一","author":"王世贞","text":"中原高枕白云深，春草玄关懒自侵。\n不怕汝南人月旦，所愁江上鲤浮沈。\n凤皇独揽千寻德，鹦鹉双悬异代心。\n此日为君成感慨，武昌风色昼阴阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11454,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄答张助甫 其二","author":"王世贞","text":"中郎不爱卖碑钱，盛德那因乞米传。\n念尔去凌淮蔡雪，向谁呼觅孝廉船。\n忽惊鱼素冲江渚，骤有骊珠射楚天。\n无限故人推毂意，愁君手板少年前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11455,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过京山王太仆汝化期还日过饮以病从汉江抵省太仆有作赋此解嘲","author":"王世贞","text":"十载登龙愿不违，见来词赋有光辉。\n已拚送酒陶家醉，敢作凌风列御归。\n席畔黄花寒不负，江头青雀病相依。\n谁言郢里今辽落，白雪逢君片片飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11456,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"敬美需次不调于秋夜倡和有庾公南楼之思走笔为答时予有岭右命","author":"王世贞","text":"北游吾弟困长安，南徙而兄老一官。\n欺客秋风生裋褐，误人春事在弹冠。\n莫誇同调兰金易，纵得时名桂玉难。\n俗杀武昌中夜月，庾公那自折腰看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11457,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答寄子深镇国","author":"王世贞","text":"著成鸿宝世称奇，十载匡庐有梦思。\n忽尔赠余青玉案，萧然如对白云姿。\n鱼书但到那论晚，龙剑须逢自有时。\n俱道陈王饶丽藻，可能重赠仲宣诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11458,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"武昌奉别省中诸公","author":"王世贞","text":"差池霜色鬓毛侵，三月移藩已滞淫。\n惜别故人分手泪，思归傲吏折腰心。\n赪鱼下水犹堪溯，黄鹤摩天不易寻。\n回首莫论萍梗事，古来天地有浮沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11459,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上庐山天池寺","author":"王世贞","text":"使君五马一踟蹰，为爱匡山胜不虚。\n亭出御书天子鄣，水成仙乐圣僧庐。\n微阴液雪瑶时破，寒色留枫绣自如。\n未有仙才同谢监，将分佛地卜吾居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11460,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登天池回望下方俄而昼晦","author":"王世贞","text":"胜地初凭一杖收，正教吴楚落双眸。\n千峰尽袅香垆气，九派平拖瀑布流。\n忽暝乾坤垂混阖，欲归身世半沈浮。\n佛灯纵出难为照，天眼虽尊不破幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11461,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"周银台汝学携酒净海寺贻诗见赠时余适有太仆之除落句云云遂成答谢","author":"王世贞","text":"江头初驻木兰舟，谁解携琴载榼游。\n三国声华公瑾早，六朝风物秣陵秋。\n诗成古刹寒堪失，酒尽长干暝欲愁。\n纵有除书君莫怪，马曹元自属王猷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11462,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠姚继文学宪由楚迁江西大参","author":"王世贞","text":"史谈留滞逾三载，启事山公愿不孤。\n剖尽荆珉无卞泣，教成郢雪失巴歈。\n文星入夜冲南斗，化雨将春下蠡湖。\n还道木天当日地，只今明主赐环无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠殷无美获隽留省入试南宫","author":"王世贞","text":"见说贤书有著声，词场吾党日峥嵘。\n一枝肯作寻常桂，尺璧能偿十五城。\n往嗣东吴元秀出，深源今代岂虚名。\n还从雁塔看前辈，莫向龙门负此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11464,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题洞湖卷赠凌玄旻","author":"王世贞","text":"玄旻托好凌九纮，一曲犹能小贺生。\n书似灵威偏嗜秘，宅如和父仅馀名。\n烟霞不散奚囊色，日月长寻钓艇盟。\n倘读吴侬旧游记，令君风骨坐来轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11465,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送侍御河南李子兴还朝因伸鄙感","author":"王世贞","text":"揽辔名高九道闻，攀辕人惜二天分。\n论才岂必相如似，荐疏空劳北海勤。\n骢马风生千里足，神羊霜压五花文。\n欲知下走沾沾意，今日真成御李君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11466,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岭右张羽王明府邀合郡诸名胜会饯虎丘时江右龙司理亦集辄成二章为谢 其一","author":"王世贞","text":"府公高宴入春开，江左风流异代才。\n茂苑自骄群玉聚，桂林初见一枝来。\n分题竞胜灯前草，欲折还含雪后梅。\n赢得班生仙骨在，手携星藻向三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11467,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]