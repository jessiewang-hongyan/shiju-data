[{"title":"村居","author":"欧主遇","text":"背城数十里，来雁两三行。\n落日芙蓉醉，疏林橘柚香。\n授衣不可得，穫稻更何望。\n儒术谋身拙，空悲秋夜长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34864,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜过访谢儒美馆对月","author":"欧主遇","text":"虚窗邀月好，永夜得天多。\n落叶飞无处，秋风寒奈何。\n杯香篱菊在，琴响塞鸿过。\n共醉幽怀发，谁闻白石歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34865,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠安义陈明府","author":"欧主遇","text":"宿雨过山城，山春花鸟迎。\n榻开官舍冷，琴抚讼堂清。\n胜地邻陶令，游人托马卿。\n相逢怜别路，惆怅故交情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34866,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送赞公入吴","author":"欧主遇","text":"三秋飞落叶，万里起寒烟。\n锡杖此时去，金山空杳然。\n乘云穿岭树，泛月借湖船。\n但学无生理，离居莫记年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34867,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"何象冈相君携同泛舟送李定夫","author":"欧主遇","text":"绕林红缀荔枝新，雨过争看垫角巾。\n绿野到门同作客，仙舟移酌欲留人。\n柳藏蝉唱依依听，江浴鸥群款款亲。\n惜别却忘归路远，肯于沉醉问车茵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34868,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"汎湖","author":"欧主遇","text":"避暑淩风六月秋，前山罗列水悠悠。\n山花笑待多情客，水鸟飞随不定舟。\n衣制芰荷期遁迹，歌翻桃叶欲消愁。\n兴酣勿问归何宿，新月澄波一枕流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34869,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"滩上口号","author":"欧主遇","text":"谁解西行一段愁，掉头归去正逢秋。\n月轮初上滩声急，流尽清光送客舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34870,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黎遂球公车北上","author":"欧主遇","text":"竹房芝阁数相从，先出云林四百峰。\n夹道看花金腰袅，群仙分露玉芙蓉。\n尊闲夜雨飘红满，帆带青山点翠浓。\n却忆同时曾拟赋，吹嘘犹切五云重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34871,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题潜曜龙湫","author":"区怀炅","text":"何处谒龙湫，烟霏带岩渚。\n唤龙时起来，苍生待霖雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34872,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九星岩芝兰","author":"梁思诚","text":"似见九星分九畹，即看三径秀三芝。\n水连番舶春帆阔，冰溜寒岩石洞迟。\n剑叶春归湘女佩，玉苗香入楚人辞。\n乱峰几点遥天外，谁策飞筇一探奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34873,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五桂山飞瀑","author":"梁思诚","text":"桂岭插云表，苍茫天四围。\n洪泉劈涧落，寒瀑破空飞。\n百道穿危磴，千寻下翠微。\n晓烟洗残黛，白雾掩轻扉。\n流响方成韵，闻声未觉希。\n香垆思渺渺，庐阜梦依依。\n雨气杂晴霰，电光浮夕晖。\n沿洄卷绡幕，喷薄洒珠玑。\n低咽青溪玉，斜侵白袷衣。\n云垂大鹏翼，风助巨鳌威。\n树杪层冰折，帘间赤日晖。\n隔崖烟袅袅，阴壑草霏霏。\n蜿地长虹似，绷云綵带非。\n莲开太华晓，芝吐雪苗肥。\n清啸灵禽和，高吟木客稀。\n二楼山月白，三岛露桃绯。\n遇物结遐想，观空悟化机。\n重林时徙倚，鸾鹤夜深归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34874,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"葛仙坛","author":"黄拱寅","text":"探奇载酒兴偏赊，指点仙踪物外誇。\n青似朱明台畔草，芳馀勾漏县中花。\n闲身赢得频支杖，近阪还堪学种瓜。\n试问遗丹今在否，怜余同是野人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34875,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沧江夕照","author":"陆允馨","text":"晚霞浮日锁蒹葭，红翠痕深燕尾沙。\n帆影挂云穿岸柳，渔歌随棹度江花。\n翩翩暮霭凌孤熃，远远疏林集暝鸦。\n回首江天烟景好，白蘋洲畔欲移家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34876,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"狮带晴云","author":"陆允馨","text":"碧如带倚云隈，片片岚光槛外堆。\n叠嶂远浮霄汉合，轻风微荡翠屏开。\n剪将玉女裁春服，飞入茅檐冷酒杯。\n最好落霞添补缀，怒猊天畔耸瑶台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34877,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钓台夜月","author":"陆允馨","text":"一鉴寒光印碧川，石台风细水连天。\n芦花荡漾迷烟艇，鹤露翻飞点白莲。\n鸥梦静酣香稻岸，钓丝閒捲湿云边。\n渔翁自唱沧浪曲，不管乘除伴月眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34878,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莲社春风","author":"陆允馨","text":"百尺扶疏古木阴，千秋童冠共招寻。\n风前文酒丁年会，月下弦歌子夜音。\n桑枯影馀归醉客，莺花春暖逗诗林。\n邀欢不用陶彭泽，莘野蟠溪共此心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34879,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虹桥绿荫","author":"陆允馨","text":"村外清溪曲带桥，云林烟树缘萧萧。\n行人共喜浓阴布，归鸟飞从别浦遥。\n细水流花穿晓岸，应龙拖雨涨春潮。\n何人万里新题柱，香雾淋淳玉栋腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34880,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"排石松涛","author":"陆允馨","text":"虬龙鳞甲倚天游，风捲涛声满小楼。\n入耳隐君怜雅韵，壮怀枚叔讶清秋。\n巢云野鹤惊残梦，吸露鸣蝉不自由。\n可是伯牙千古调，官商閒弄草堂幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34881,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游崆峒岩和洪邑侯韵","author":"蔡宗周","text":"海上何人访十洲，碧天遥见一岩浮。\n门涵紫气平林曙，径护青霞古壑幽。\n曲涧泉飞岩外响，悬崖凉散洞中秋。\n丹流石壁清疑绝，露裛苍苔翠欲收。\n风静晴云团皂盖，赋成白雪点轻裘。\n岁除村鼓喧桑社，其喜公馀览胜游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34882,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜梁叔一归省","author":"陈其志","text":"红云片片出东溟，赢得芳名此日馨。\n王事去勤蘋欲白，莱衣归戏柳垂青。\n谁登百尺风能御，独笑高阳晚未醒。\n为报西邻诸鲍叔，茅斋吾已懒横经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34883,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次临封八景韵二首 其一 江口归帆","author":"陈道蕴","text":"渺茫遥望绿如苔，三道江流到此开。\n落日寒烟樵檐渡，收帆系桨客船回。\n怀人几度看维缆，寄远未逢笑折梅。\n满目风光迟晚照，乘闲临眺独徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34884,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次临封八景韵二首 其二 灵洲渔唱","author":"陈道蕴","text":"渔舟泛泛倚长洲，欸乃数声古渡头。\n向夕风微天籁寂，一江露冷苇萧秋。\n惯乘巨浪朝朝险，无碍平波日日流。\n堪笑汉军机太巧，而今空付笠蓑游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34885,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遇刘磐石道中","author":"陈壮学","text":"年来未挹春风暖，冬早相逢锦里傍。\n丛菊尚牵三径色，寒梅欲吐一园香。\n宣卿世颂长词赋，仲举谁怜少鹔鹴。\n溪上立谈盟雉旧，暮云又觉碎琳琅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34886,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄自如袁大司马","author":"陈壮学","text":"华轮久矣不相亲，海国遥瞻报国身。\n阃外自能神石略，胸中元是溢阳春。\n千秋日月开明圣，一曲关山静塞尘。\n搔首天南惊绩奏，勒名端在见麒麟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34887,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伍国开李梓若见访晚集","author":"陈杓","text":"笼槛疏烟日暮时，主宾怡得泛霞卮。\n三缄人世吾犹歉，双剑云霄尔不羁。\n地僻岂无栖凤竹，冬森殊有耐寒枝。\n情酣正懒周行示，漫道亡羊只路歧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34888,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"熊将军祠","author":"陈杓","text":"卜筑巍祠胜自宜，山行啼鸟日迟迟。\n扶王实赖孤忠在，倾室真难一木支。\n云掩春光花溅泪，塘横银影客生悲。\n只今正气弥天地，蘋藻应交荐岁时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朔夜与袁大司马话别","author":"陈杓","text":"绿浓溪上淡春烟，曲奏霓裳夜正怜。\n共信筵芳须待月，应知交态自忘年。\n人堪□别花边语，谁结狂来醉后缘。\n万里胡尘他日扫，一天晴色凯歌还。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"溪居","author":"陈曰昌","text":"人多物外役，而我独无营。\n浩浩复落落，湖山注夙情。\n因之不适俗，壮心淹老成。\n园林聊日涉，守拙若硁硁。\n欲散今古意，每每踏潮行。\n一溪入花气，万木度风声。\n遥峦层耸逸，瞻顾别开明。\n念虑此俱涤，水鸟时嘤嘤。\n纵浪东皋外，于焉得此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答唐卧公 其一","author":"陈曰昌","text":"共住江村一带偏，如君相与出尘缘。\n春风入座人同拂，秋月当窗魄迥悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答唐卧公 其二","author":"陈曰昌","text":"几淬青虹怜古剑，独翻黄石得奇篇。\n等閒疑义恒相析，何异当时对榻眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿孝廉祁尔见社长四十一","author":"邓逢京","text":"入洛名高暂息机，淡怀强仕薄轻肥。\n江湖我欲同君醉，诗酒谁云旧隐非。\n未向赤松飧玉瀣，且携绿蠡卧渔矶。\n商山遗老无须问，四皓堂前映紫芝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34894,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次临封十咏颂方侯德政 其一","author":"蒙尧仁","text":"侯治吾封好，仁风播不赊。\n昼闲单父瑟，春满河阳花。\n投老逢循令，为民不恤家。\n化行无狱讼，休吏蚤归衙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34895,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次临封十咏颂方侯德政 其二","author":"蒙尧仁","text":"侯治吾封好，风回化日长。\n弦歌连里巷，鸡犬静村庄。\n相庆多襦裤，谁忧少稻粮。\n男耕兼女织，彷佛豳风乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34896,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次临封十咏颂方侯德政 其三","author":"蒙尧仁","text":"侯治吾封好，视民浑一家。\n采芹同曝献，鼓腹任晖斜。\n泛蚁酣椒酒，分泉煮蕊茶。\n不偏荣瘁理，帝载乐无涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34897,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次临封十咏颂方侯德政 其四","author":"蒙尧仁","text":"侯治吾封好，六春寓水滨。\n忘机鸥共适，徵异雉来驯。\n秋碧天涵水，江清月对人。\n濯缨渔父曲，不厌往来频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34898,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次临封十咏颂方侯德政 其五","author":"蒙尧仁","text":"侯治吾封好，奎文满璧宫。\n台州先正事，左氏古陈风。\n比屋冠裳雅，盈门桃李红。\n诗书敦上国，端养豫蒙童。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34899,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次临封十咏颂方侯德政 其六","author":"蒙尧仁","text":"侯治吾封好，增光江与山。\n雄图万里壮，鸿藻两京间。\n力大批剸易，才长驾驭闲。\n桑阴来驯雉，乐意每相关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34900,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次临封十咏颂方侯德政 其七","author":"蒙尧仁","text":"侯治吾封好，政醇风气还。\n书生遵芳躅，俗客控尘寰。\n华表联云水，麒麟展绛山。\n王乔仙子吏，双舄往来闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34901,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次临封十咏颂方侯德政 其八","author":"蒙尧仁","text":"侯治吾封好，祥光十路遥。\n二星联璧合，五友聚亭邀。\n好锦霞千缕，清规冰一条。\n馀生才尔见，难数楙猷饶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34902,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次临封十咏颂方侯德政 其九","author":"蒙尧仁","text":"侯治吾封好，居然第一流。\n凫飞天北阙，凤集海西洲。\n休吏常垂幕，吟诗每上楼。\n政成无讼化，黄白任嬉游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34903,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次临封十咏颂方侯德政 其十","author":"蒙尧仁","text":"侯治吾封好，厢坊并五乡。\n书声联闲里，物望傲冠裳。\n蟠井龙泉异，桂江翰墨香。\n璧奎辉映照，景运应胶庠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34904,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次临封八景韵二首 其一 灵洲渔唱","author":"蒙尧仁","text":"昔人制险据灵洲，曾料渔船泊上头。\n挂网烹鱼天欲暮，鸣榔清唱晚来秋。\n衣莲艳艳留霞在，葭苇苍苍带露流。\n遥想当年争胜急，可曾闲作弄波游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34905,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次临封八景韵二首 其二 西山晴雪","author":"蒙尧仁","text":"昨日六花凝作冰，今朝四望遍销零。\n曦和东禦绿螭驾，织女西牵素锦屏。\n霁色讶闻檐溜响，寒威快睹槛松青。\n王公自是神仙态，披氅曾登海上亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34906,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次临封八景韵二首 其一 南寺钟声","author":"陈必荣","text":"晓气清明绝世氛，寺钟遥到枕边闻。\n几声催上扶桑日，馀韵留回鹫岭云。\n词客吟怀佳句得，禅僧功课早堂勤。\n觉我昏衢省我志，悠悠克念重华勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34907,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次临封八景韵二首 其二 景星夜月","author":"陈必荣","text":"见说招提号景星，劫灰剩对月华明。\n一轮宝镜虚空照，千古毫挥返太清。\n大地遥临空界净，长天迥与烟波平。\n不闻梵语闻琴韵，蕞尔封城是武城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34908,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次临封八景韵四首 其一 江口归帆","author":"苏万国","text":"两岸孤蒲映绿苔，江山如画锦屏开。\n千层巨浪排天涌，一叶轻舟带月回。\n入眼堕云随落鹜，愁人短笛调寒梅。\n难赊暮景毋虚过，待趣将来识几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34909,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次临封八景韵四首 其二 灵洲渔唱","author":"苏万国","text":"苍波千顷泛灵洲，信宿渔翁隐上头。\n曛醉夕阳笠蓑畔，闲歌沙浦水云秋。\n孤航薄暮知何适，桂棹乘潮任自流。\n到处烟霞连网钓，芦汀菰渚惯浮游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34910,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次临封八景韵四首 其三 南寺钟声","author":"苏万国","text":"宝刹无尘迥绝纷，疏钟隐隐出林闻。\n三扣觉人亲佛日，数声唤鸟度岩云。\n已惊蝶梦栩然醒，何事轮蹄遝尔勤。\n遥想东方犹未息，楼兰快斩树华勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34911,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次临封八景韵四首 其四 景星夜月","author":"苏万国","text":"古寺当年号景星，今馀桂影满山明。\n四天霁色万缘寂，一片寒光千里清。\n宝树高连东岭出，云华深罩锦涛平。\n布金长者名还在，不灭馀辉倚赤城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34912,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花阡","author":"伍瑞俊","text":"剩粉残香未易忘，胜于新蕊断君肠。\n不知福地真何福，得护佳人绿鬓香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34913,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"移居铁城贻友人二首 其一","author":"伍瑞俊","text":"驰驱别丘壑，太息问孤城。\n地水师中吉，天山咸五贞。\n寻源虽未逮，择里幸同声。\n相见为欢日，差忘离乱情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34914,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"移居铁城贻友人二首 其二","author":"伍瑞俊","text":"乱离云壑浅，草草漫谋生。\n我病因贫剧，君怀到老清。\n何期值兹日，宁暇问浮名。\n虽有还丹日，驰驱恐未成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34915,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庐陵赠别马季房","author":"叶芝","text":"怜君意气重南金，倾盖欢然思不禁。\n世有青箱传绛帐，文从学海起词林。\n芳樽却许归同社，里曲何来遇赏音。\n别后相思天共远，五云遥望紫云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34916,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄门人张芷园闽中","author":"林荐","text":"闻君江上拥旌旄，共羡书生胆气豪。\n家学旧传黄石略，汉恩新赐紫貂袍。\n一身许国风霜苦，半壁支天汗马劳。\n此日艰难知不惜，沙场麟阁属吾曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34917,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临刑诗","author":"林荐","text":"愿续当年李侍郎，遗言谢世报高皇。\n独怜一片忠贞骨，不死沙场死法场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34918,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁亥春感","author":"林荐","text":"石羊城下越王宫，天尽东南浪拍空。\n万顷可怜春饮马，重关不见士弯弓。\n威仪有日过三辅，草木何人借八公。\n寒食古台新雨后，断笳零乱起悲风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34919,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛舟沥湖遥望邻天阁阆风岩飞仙阁诸胜","author":"区怀嘉","text":"层峦耸翠影参参，清浅沿洄一水涵。\n龙卧石床收暮雨，鹤归岩岫带秋岚。\n楼台隐映摩霄汉，磴道斜飞入洞庵。\n不为过寻幽寂地，兰桡何用泛澄潭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34920,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龟峰塔初成喜赋","author":"区怀嘉","text":"杰构凌空起，棱层压海埏。\n障流疑砥柱，倚岫类擎天。\n复道青霄下，虚窗北斗边。\n迎风檐铎响，映日网珠妍。\n秀气人文萃，精英世代延。\n光腾奎壁次，名纪凤凰年。\n望日身弥近，梯云步欲先。\n会心超广劫，挥手弄晴烟。\n渐觉诸缘息，翻惊万象旋。\n登临多逸兴，于此倍悠然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34921,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郡伯陆廉石公祖招饮星岩","author":"何钟英","text":"隔岁曾订星岩履，宁负岩云绣如绮。\n共将相知一片怀，精神顷刻常伊迩。\n先生雄名胜二玄，冰壶濯濯琳琅前。\n何以饮我惟玉液，何以赠我惟云笺。\n人生山水共朋友，倏忽还随岩云走。\n明朝欲泛珠江船，惆怅别君羚羊口。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34922,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游烂柯山宿莲圣庵　 得清字","author":"罗晋侯","text":"绝壁先登猿鹤惊，千盘危磴喜微晴。\n云封远瀑明还暗，路入层峦险复平。\n莲漏静分香涧寂，松风飘落石棋声。\n缘兹结得山灵约，翠湿衣衫尘梦清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34923,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石室赠仰虚道士","author":"罗晋侯","text":"炼成紫府白朱砂，别有仙人远折麻。\n且待青鸾觞柏叶，莫驱鸡犬住桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34924,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午日区启图偕游玄笈岩　　岩为启图新题","author":"郑旸","text":"搜胜寻真路欲迷，剪繁除碍共攀跻。\n焚茅绕径穿云入，濡墨抽毫扫石题。\n壁藓含烟笼外户，虹泉喷雪落前溪。\n何劳骄语龙歌兴，且沐兰汤拂涧霓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34925,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午日玄笈岩送区启图","author":"梁廷标","text":"不用菱歌发楚倡，岩前急舸即三湘。\n离情何但千丝缕，映向云浮江水长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34926,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午日玄笈岩送区启图","author":"杨蒙","text":"兰舟一棹碧溪阴，玄笈杯中万里心。\n惜别莫探龙颔去，梦回笳鼓倍沉吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34927,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]