[{"title":"九日限韵 其一","author":"陈邦彦","text":"令节属高秋，舟行当远搜。\n露蝉寒未歇，霜叶醉初抽。\n屐齿閒中过，山容卧里偷。\n遥看青一点，庐阜是耶不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40521,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日限韵 其二","author":"陈邦彦","text":"飞翰发早秋，山郭引旁搜。\n语岂连宵尽，身从一日抽。\n褰裳缘国难，封事嫉时偷。\n为问临邛令，曾经此客不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40522,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日限韵 其三","author":"陈邦彦","text":"猎猎酒旗秋，长年何处搜。\n为怜风半驶，奈此水如抽。\n渴忆江州送，狂思吏部偷。\n吴城知远近，前路待侬不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40523,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日限韵 其四","author":"陈邦彦","text":"此日故园秋，云萝处处搜。\n萸囊随俗佩，筝线信风抽。\n酒熟人从醉，花黄蝶怕偷。\n右丞佳句在，颇念异乡不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40524,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日限韵 其五","author":"陈邦彦","text":"为客复悲秋，枯肠半已搜。\n路歧犹怅罔，河上类旋抽。\n命酒酤辞债，称诗律戒偷。\n醉歌忘采菊，知是豫章不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40525,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鄱阳湖","author":"陈邦彦","text":"浅原垂禹贡，巨浸列周官。\n浪飐孤山动，光摇五老寒。\n远帆疑鸟翼，编户半渔竿。\n何意栖栖客，淹留日夜看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40526,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雾","author":"陈邦彦","text":"寒峭不成雪，漫漫晓雾生。\n凝眸迷咫尺，扑鼻觉纵横。\n山色彭郎隐，江声石妇平。\n羁愁久无赖，挝鼓劝晨征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40527,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"横石舟夜","author":"陈邦彦","text":"野烧平林晚，荒村白苇秋。\n鸣钲严夜号，藏火辨更筹。\n破浪怀空切，闻鸡志未酬。\n前途看渐近，羁客莫深愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40528,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"抵芜湖","author":"陈邦彦","text":"扁舟曾不暮，此日亦芜关。\n地望分三辅，军储佐九圜。\n滞留江上迹，衰飒镜中颜。\n漫道风云近，宵来梦故山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40529,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"发芜湖别同舟诸子","author":"陈邦彦","text":"度岭爱乡声，联舟况复情。\n怜君初即次，而我戒孤征。\n江折西梁险，天回北极明。\n未堪离思急，桂酒更同倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40530,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠苏宇霖饷部 其一","author":"陈邦彦","text":"多难今相见，神州半陆沉。\n有怀劻国步，何意恋朝簪。\n扬历皆殊绩，朋交寄素襟。\n独怜缝掖旧，空负济时心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40531,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠苏宇霖饷部 其二","author":"陈邦彦","text":"踰淮无寸土，浮海独全师。\n突骑增蕃卫，长鲸避羽旗。\n才名交口遍，威略建牙迟。\n何日妖氛靖，韩陵读旧碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40532,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠苏宇霖饷部 其三","author":"陈邦彦","text":"古人云已邈，铁汉可能多。\n有剑曾枭敌，无钱肯系靴。\n乘车盟不负，卮酒醉频过。\n世路仍资格，清名奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40533,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠苏宇霖饷部 其四","author":"陈邦彦","text":"当年曾并辔，十载让先鞭。\n牍岂三千奏，樽惭五石坚。\n山河供雪涕，岁月入霜颠。\n为忆曾夫子，酬知意惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40534,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冠颂","author":"陈邦彦","text":"生年踰二十，拜命始三加。\n岁旦留尊柏，春光到槛花。\n北堂童稚梦，东郭旅人家。\n漫笑谋身拙，吾生未有涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40535,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡江","author":"陈邦彦","text":"别来能几日，不觉渐成寒。\n风景他乡异，梅花两地看。\n渡江人欲倦，临水路偏难。\n尚笑絺衣在，听砧夜向残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40536,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕赠人新昏","author":"陈邦彦","text":"剑气双龙合，銮声四牡骄。\n宫妆凝楚黛，仙吹咽秦箫。\n夜永同牢烛，春开献岁椒。\n江城新柳发，仿佛见纤腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40537,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"还自凤城寄谢潘孺文太学","author":"陈邦彦","text":"胜赏烦相命，高轩枉再过。\n君应怜意气，予自笑磋砣。\n旅馆蒹葭思，青灯杕杜歌。\n不辞课僮仆，长为剪藤萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40538,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送朱镜澄解官还吴","author":"陈邦彦","text":"言辞越江水，归醉洞庭春。\n南国浮云尽，天涯别梦新。\n垂杨迷驿路，綵服倦游尘。\n渐喜秋风近，承欢荐美莼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40539,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重别叶公士 其一","author":"陈邦彦","text":"萍迹何来此，风尘不可留。\n报书逾十部，交谊足千秋。\n旧业空环堵，归装一蒯缑。\n相期无限意，休问敝貂裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40540,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重别叶公士 其二","author":"陈邦彦","text":"大雅风斯远，知音世所稀。\n他山情独切，两地梦俱飞。\n楚塞丹枫暗，吴门翠岫微。\n秪凭文赋在，万里未相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40541,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭门人潘幼韩 其一","author":"陈邦彦","text":"十日增沉痼，千秋隔死生。\n人间金屋闭，天上玉楼成。\n遂作修文梦，难伸自牖情。\n有怀吁南斗，无术拟公明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40542,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭门人潘幼韩 其二","author":"陈邦彦","text":"片土能埋玉，悬河易染衣。\n不堪论宅相，何以慰慈闱。\n身岂乘箕去，魂疑化鹤飞。\n三生如不昧，重向旧庭归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40543,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同舟","author":"陈邦彦","text":"不寐夜偏永，无媒春自怜。\n江湖梦欲断，胡越意茫然。\n树色笼孤月，鸡声阨曙烟。\n转令亲浊酒，犹自悔宾筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40544,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨夜宿吴朝泗江阁","author":"陈邦彦","text":"去家五百里，相过重乡音。\n客路樽前语，江流槛外心。\n风连三峡暗，云隐二禺深。\n莫作登楼赋，柴扉尚可寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40545,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"薄游","author":"陈邦彦","text":"极目枫林外，故园安在哉。\n山川曾有约，秋半未归来。\n暝色千峰雨，江声万壑雷。\n薄游仍度峡，乡梦莫轻催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40546,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶成","author":"陈邦彦","text":"率尔成新句，因之寄所思。\n故人俱可念，生事独多歧。\n旅夜惊寒早，乡园返棹迟。\n塞鸿南去尽，吟望到归期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40547,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"避人","author":"陈邦彦","text":"烛跋惊初至，杯深奉片谈。\n舌存浑欲满，痴绝小成憨。\n露浥琴心冷，愁兼酒力酣。\n不堪城漏转，参伐独当南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40548,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿江上杂诗 其一","author":"陈邦彦","text":"草阁平临水，江沙远带霜。\n寒林知岁暮，烟月是他乡。\n估客维舟晚，晨门报漏长。\n旅怀馀万叠，清梦失羲皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40549,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿江上杂诗 其二","author":"陈邦彦","text":"水落时添岸，山遥半作云。\n满帆来片片，斜日照曛曛。\n双㹀归前崦，孤鸿入远雯。\n倚栏谁与语，招手二禺君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40550,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿江上杂诗 其三","author":"陈邦彦","text":"岁事颇不恶，严霜差未凝。\n水流低岸月，风捲隔林灯。\n烟树无高下，寒香有废兴。\n遣怀拚一醉，安得酒如渑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40551,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿江上杂诗 其四","author":"陈邦彦","text":"江水朝宗急，宵行尚作声。\n千林人乍静，半壁月微明。\n柔橹尔何早，晨鸡初未鸣。\n萧然听群籁，孤枕意纵横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40552,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿江上杂诗 其五","author":"陈邦彦","text":"五夜催城角，千峰簇晓烟。\n如何今岁月，空度此宵圆。\n有客皆怀土，云谁独旅眠。\n朝朝凝望眼，送尽下江船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40553,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿江上杂诗 其六","author":"陈邦彦","text":"北上通湟武，南流会郁黔。\n蔽江浮巨筏，依岸割馀盐。\n汉客波胡贡，吴儿越女缣。\n熙攘人尽尔，遑问岁时淹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40554,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿江上杂诗 其七","author":"陈邦彦","text":"公荣多酒伴，育长是情痴。\n小作清狂事，差忘羁旅时。\n醉迷中圣约，歌愧外孙辞。\n莫笑诙谐惯，人间几大儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40555,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿江上杂诗 其八","author":"陈邦彦","text":"未须惊晏岁，且得坐朝暾。\n海气蒸初浴，霞光尚半吞。\n熹微窥曲槛，隐跃见江村。\n故里云峰外，何人独倚门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40556,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿江上杂诗 其九","author":"陈邦彦","text":"天末仍孤客，江干亦小除。\n未遑理舟楫，省得觅瓜蔬。\n歌啸且度日，醉醒谁是予。\n晚来朱叔子，新寄数行书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40557,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿江上杂诗 其十","author":"陈邦彦","text":"浪迹成何事，归心日夜增。\n年光催爆竹，春色入孤灯。\n世态秪如此，他乡未可凭。\n明朝人献岁，南望意飞腾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40558,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端午前一日同马子龙寓家珶赤兄拳曜轩吴尔景载酒过访邓行玉梁苑郎适至赋得二首 其一","author":"陈邦彦","text":"彩丝云已近，鼍鼓寂无喧。\n世讲能过酒，怀人兼在门。\n雨销烦暑瘴，灯乱去留魂。\n谁遣淳于醉，离情未许论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40559,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端午前一日同马子龙寓家珶赤兄拳曜轩吴尔景载酒过访邓行玉梁苑郎适至赋得二首 其二","author":"陈邦彦","text":"烛光频见跋，笑语尚馀喧。\n小作平原约，如高靖郭门。\n山城悬宿梦，泽畔慰吟魂。\n莫以归与叹，前期更可论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40560,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遥别谢衷伯 其一","author":"陈邦彦","text":"江阁听鸣雨，乡心一夕催。\n所嗟谈未半，相忆首频回。\n郑重侯门俊，琳琅上客才。\n马卿游已倦，何计伴邹枚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40561,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遥别谢衷伯 其二","author":"陈邦彦","text":"正忆庭阶下，崇兰半亩滋。\n无人春自赏，为客梦还驰。\n江上聊三宿，关前岂五噫。\n新诗遥作别，长路更相期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40562,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠郭我示","author":"陈邦彦","text":"十日避旗鼓，相逢未赠言。\n小巫良自怯，大雅更谁论。\n伏暑宜杯酒，秋光忆故园。\n共将诗作活，工拙两堪存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40563,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻变 其一","author":"陈邦彦","text":"漠漠腥风动蓟门，鼓鼙声死日黄昏。\n殷忧共忆宵衣久，遗泽犹闻血诏存。\n满目河山留义烈，故宫黎庶逐啼魂。\n江流不尽敷天耻，薪胆凭将献至尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40564,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻变 其二","author":"陈邦彦","text":"朔雪炎天尽帝臣，都城金粟亦因陈。\n不闻一矢能遗敌，敢谓中朝尚有人。\n野树春残巢幕燕，鲜原日暮泣幽燐。\n独凭沟壑酬君父，曾否当年悟徙薪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40565,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻变 其三","author":"陈邦彦","text":"羽林北落奉王鈇，入市何人也荷殳。\n束伍自知存尺籍，餐钱空复饱侏儒。\n内廷阅操军声旧，貂贵临戎庙算殊。\n城社隐谋窥不得，况堪泥首又中枢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40566,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻变 其四","author":"陈邦彦","text":"面孔犹人自肺肠，也曾金殿献文章。\n家门肯谓恩私浅，忠孝谁传作述芳。\n未论奚珣终伏锧，却怜王衍亦排墙。\n如何率土惭回部，霜剑棱棱五十行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40567,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻变 其五","author":"陈邦彦","text":"闻道空门忽济然，缁流谁著辨真篇。\n犹存四大终何着，旋證无生可是禅。\n按舞徵歌新燕婉，求田问舍旧因缘。\n却疑顶戴朝簪重，报国唯应义最先。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40568,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻变 其六","author":"陈邦彦","text":"十年谋国事招携，清野频经补牍题。\n土有分民城内外，生随流浪水东西。\n魂摇乍觉离豺虎，手实俄惊录大鸡。\n谁为绘图持入告，郊坰元亦是黔黎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40569,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻变 其七","author":"陈邦彦","text":"重门列雉与云俱，奔溃相仍寂若无。\n何限鹓鸾随挺鹿，浪传蛇豕是驺虞。\n黄巾匝地烽烟断，白羽经年夜月孤。\n安得昔时颜太守，平原一郡障狂胡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40570,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻变 其八","author":"陈邦彦","text":"榆关春老草芊芊，列骑如云荷戟眠。\n不向运河留一线，可谁飞挽佐三边。\n西凉士马终怀晋，索部鱼羊解扰燕。\n南北安危忧不细，早腾恩诏到居延。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40571,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻变 其九","author":"陈邦彦","text":"天末提封自尉陀，戈船曾记下牂牁。\n危峰骇浪山川旧，白雉文犀岁月多。\n未见星轺来北极，却防佩犊起南讹。\n漫劳慷慨怀忠烈，言念瞻乌可若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40572,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻变 其十","author":"陈邦彦","text":"荟蔚遥怜季女饥，榛苓长忆美人迟。\n空教夏屋依荷柱，犹有循良治茧丝。\n经界似占无妄课，鱼盐宁问土风辞。\n天家板荡今如此，谁向清宵有所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40573,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻变 其十一","author":"陈邦彦","text":"三百年来世泽长，讴吟俄已遍炎荒。\n反裘未许哀鸿雁，饱宿何当养凤凰。\n溪畔渔竿拚啸傲，江城驷介自翱翔。\n朝廷可是书生责，倚剑酣歌笑尔狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40574,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻变 其十二","author":"陈邦彦","text":"金陵六代帝王都，此日龙兴气象殊。\n最爱鄗南符建武，肯论江左有夷吾。\n开天堂搆留神谶，率土弓旌识圣谟。\n陇上隗纯今在否，早教黎献乐樵苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40575,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次答大参区几蘧先生","author":"陈邦彦","text":"不道狂胡俄犯阙，浪传繻葛亦能军。\n中原半已成鱼烂，草野宁当恋鹿群。\n燕蓟攀髯愁祲孛，秦淮扈跸盛风云。\n安危此日资元老，蚤应蒲车翼圣君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40576,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次郡丞卢缜存先生韵兼答黄子 其一","author":"陈邦彦","text":"谁赌长安与□臣，海隅无路叩高旻。\n不因庙社钟真主，那得江湖寄此身。\n故国惔焚兼玉石，兴朝延揽盛弓轮。\n临歧绮赠惭珍重，未遣□□笑妄人。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40577,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次郡丞卢缜存先生韵兼答黄子 其二","author":"陈邦彦","text":"宵衣闻道叹无臣，就义从容泣上旻。\n不那已成千古恨，可应深恋百年身。\n河南邓禹非因荐，晋国郇模岂待轮。\n漫道明珠已寥阔，度关迟尔弃繻人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40578,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次答家珶赤兄 其一","author":"陈邦彦","text":"济时自昔仗英雄，非曰能之愿下风。\n但遣行藏殊小草，敢论词赋拟长虹。\n龙飞建号嘉祥合，雁序临歧感奋同。\n漫向九关忧虎豹，金陵王气正菁葱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40579,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次答家珶赤兄 其二","author":"陈邦彦","text":"恒干瞿然亦自雄，孤舟横野更飘风。\n难将幽愤填沧海，剩有悲歌贯白虹。\n列镇王师元不战，万邦侯王几来同。\n传闻征戍防淮北，方叔于今已佩葱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40580,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次答黎洞石先生","author":"陈邦彦","text":"巨浸无堤纵所如，馀波疑欲及吾庐。\n感时泪尽频看剑，报国身微但著书。\n天下尚仍平世习，几时重起故宫墟。\n丹成一缕同精卫，繇蘖悬知自可嘘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40581,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次答罗文昭","author":"陈邦彦","text":"闻报旬来独卧干，魂摇天阙梦犹寒。\n公车未必如方朔，木榻还应愧幼安。\n谁为君王申九伐，况闻功业起三韩。\n艰危宏济须公等，肯遣萧条老鹖冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40582,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟发珠江承诸子携酒饯送用前韵赋别","author":"陈邦彦","text":"扬舲挝鼓发江干，变徵声高七月寒。\n夜竹可能知大汉，日边何处是长安。\n杯因惜别兼贤圣，策为忧时杂管韩。\n燕石自惭仍跃冶，归来休笑旧儒冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40583,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清远江上饮故人旅舍","author":"陈邦彦","text":"峡江西下水漫漫，山郭当年醉里看。\n朋好几回悬梦寐，扁舟何意此盘桓。\n岁华别去催颜老，时事忧来问路难。\n能似客秋凉月夜，饼?初熟戏新欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40584,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿峡","author":"陈邦彦","text":"旧游曾忆逐残春，急雨惊雷夜卜邻。\n古刹尚能来远道，劫灰何事付飙轮。\n千龄兴废疑先兆，半岭诛锄忆达人。\n此日巨灵应有意，片帆如驶度江津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40585,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七月念五日黄塘道中","author":"陈邦彦","text":"双江如注石嶙峋，日晚维舟倍怆神。\n芹曝未知能报国，树风其奈已违亲。\n北来度岭乡关浅，南下思家客梦频。\n况是遗臣泣弓剑，天涯何事不沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40586,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次答罗若思","author":"陈邦彦","text":"犹及生初识太平，盛时风物叹斯征。\n但闻帝子啼魂怨，不见军中胡胆惊。\n万国可能忘祖德，九玄终自祐皇明。\n披吟却简迎降传，愁极翻令欲绝缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40587,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]