[{"title":"过普舍","author":"程本立","text":"普舍今无县，营田尚有城。\n新军饥欲死，何力事春耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25636,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿昆阳","author":"程本立","text":"饮酒美人家，出门山日斜。\n门前一株树，说是蜜檀花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"昆明池","author":"程本立","text":"昆明海水不成潮，一镜涵空山影摇。\n明月碧鸡飞夜夜，白云苍狗变朝朝。\n登临未必南荒恶，瞻恋其如北极遥。\n汀草汀花自春色，无人同放木兰桡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"?㟽驿西山","author":"程本立","text":"千仞峰头一振衣，群真有约莫相违。\n清风咳唾人间落，白日羽翰天上飞。\n玄圃自生珠树老，石田多是玉芝肥。\n吹笙子晋能骑鹤，应向缑山月夜归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至日炼象关","author":"程本立","text":"忆昔王门候晓钟，直庐银烛照纱笼。\n东方日射旌旗动，五色云浮殿阁重。\n白发于今伤老大，朱衣无复待从容。\n鸡鸣拜舞瞻天远，寒雾蒙蒙万壑松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早发禄丰驿","author":"程本立","text":"驿楼灯火见西屯，使者出门人语喧。\n天寒马渡此溪水，月落鸡鸣何处村。\n六诏山川皆郡县，百年身世任乾坤。\n若为看见梅花树，忽乱乡愁入故园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过舍资关","author":"程本立","text":"山来绝厓虎跳跃，路入半空蛇结盘。\n安得云霄生羽翰，直排阊阖献琅玕。\n晓行函谷星初落，晚渡轘辕雪正寒。\n所历未知今日险，何乡能托此身安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"广通驿","author":"程本立","text":"路甸驿前溪水回，驿楼打鼓使臣来。\n满头白雪岁月改，对面青山云雾开。\n万里逢人相劝酒，一身去国每登台。\n醉看大字忆都督，跃马赋诗何壮哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚至楚雄","author":"程本立","text":"楚雄城郭暮云间，城上悲笳惨客颜。\n僭国曾称白鹿郡，居人犹说卧龙山。\n葡萄直自张骞得，薏苡空随马援还。\n今日封疆非汉土，王师无地不平蛮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"姚安醉歌","author":"程本立","text":"景云僇尸李知古，天宝召乱张虔陀。\n唐兵莫讨阁罗凤，宋师不踰大渡河。\n村村小屋鸡狗少，处处青山豺虎多。\n今日安危在诸将，请君听我姚州歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过小云南","author":"程本立","text":"眼明百里眺晴川，洗我悲辛一迥然。\n山气成云无五色，石光如镜有千年。\n荷戈戍士终怀土，卖剑居民尽力田。\n自古华夷归混一，今人未必重开边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25646,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白厓关","author":"程本立","text":"晓行清子川前月，夜宿白厓关上云。\n宇宙有生俱是客，江湖无日不忧君。\n人心可使豚鱼应，绝域真同鸟兽群。\n饱暖残年得强健，未惭蛮府作参军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25647,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过赵州","author":"程本立","text":"青山环抱水争流，行尽云州入赵州。\n四野耕耘多乐岁，诸蕃出候不防秋。\n过桥花竹前村近，入谷松萝小寺幽。\n妻子谁能免相忆，他乡虽好莫淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25648,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"入龙尾关","author":"程本立","text":"山为城郭海为池，一卒当关万卒窥。\n越隽郡开通汉使，吐蕃兵结覆唐师。\n只知地险如难服，岂信天亡遂不支。\n历览华夷每怀古，临风倚马读残碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25649,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大理","author":"程本立","text":"西南形胜此山川，蒙段偏安五百年。\n圣主龙飞无僭窃，王臣虎拜有旬宣。\n登临已觉心神豁，战伐安能骨肉全。\n多幸远民皆赤子，夫耕妇馌戴尧天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25650,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留洱西驿因过三塔寺","author":"程本立","text":"眼中城郭与山川，生我江南罨画船。\n云气半峰飞白雪，水光一镜落青天。\n野墙棕树人家住，官路梅花驿使传。\n最是禅房听梵呗，此心能洗百忧煎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25651,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邓州驿","author":"程本立","text":"平冈走马神摩洞，荒驿闻鸡邓赕川。\n丹壑泄云朝翳日，玉泉阴火夜生烟。\n一年残历愁来检，万里新诗老去编。\n山水不殊人事异，中原归计正茫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25652,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丽江雪山","author":"程本立","text":"玉龙峰高九千仞，日色晦明云气寒。\n何当赤脚踏冰雪，更有红颜生羽翰。\n石洞僧来昼骑虎，瑶台仙去夜乘鸾。\n山灵于我岂无意，一路天花落锦鞍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25653,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出龙尾关之永昌","author":"程本立","text":"崎岖万里入遐陬，尚觉山川是壮游。\n倒海鲸波奔石马，极天鸟道凿金牛。\n昔人于此成三窟，老我而今隘九州。\n生入玉门班定远，未归能不悔封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25654,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兰沧江","author":"程本立","text":"曾观樊绰云南志，今入兰沧江上舟。\n山自哀牢皆北向，水如弥渃尽南流。\n乾坤瓮盎多蚊蚋，蛮貊襟裾类马牛。\n揽辔登高一回首，悠悠何处望神州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25655,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万箭树","author":"程本立","text":"行人好怪亦何愚，万箭空存树半枯。\n一日风飙纷羽镞，百年霜露此根株。\n侧身飞鸟惊还落，抱子哀猿穷更呼。\n斩伐未能吾所愤，独骑官马向山隅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25656,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"永昌山行","author":"程本立","text":"阴崖积雪涧流冰，自入哀牢感慨增。\n老我只今诸事废，此山从古几时登。\n武侯祠屋应难泯，樊绰志书犹足征。\n纵到五天依象教，不如三泖下渔罾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25657,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江头绝句 其一","author":"程本立","text":"勤苦南蛮子，相迎远出山。\n短衣双黑胫，大耳两金环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25658,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江头绝句 其二","author":"程本立","text":"骑象豪酋出，牵牛老父来。\n马头风雨过，一洗瘴烟开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25659,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江头绝句 其三","author":"程本立","text":"山影东西合，川声日夜流。\n片云还作雨，九月未成秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25660,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江头绝句 其四","author":"程本立","text":"蕉叶碧逾净，榴花红更明。\n知秋惟蟋蟀，唧唧草间鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25661,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江头绝句 其五","author":"程本立","text":"冰壶银作顶，餐具竹为盘。\n父老知蛮语，儿童睹汉官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25662,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江头绝句 其六","author":"程本立","text":"竹壶倾白酒，草阁坐青山。\n自笑居夷久，逢人语亦蛮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25663,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江头绝句 其七","author":"程本立","text":"跣行无履袜，科首匪冠巾。\n绝域亲朋远，何由见故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25664,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江头绝句 其八","author":"程本立","text":"金盌冰蔗浆，银盘烂蕉黄。\n食物岂不美，不如归故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江头绝句 其九","author":"程本立","text":"金杯阿刺吉，银筒速鲁麻。\n江楼日日醉，忘却在天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江头绝句 其十","author":"程本立","text":"小树香橼子，疏篱匾豆花。\n人情悲异土，物色似吾家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江头绝句 其十一","author":"程本立","text":"土俗诸蛮异，人心一理同。\n古今鸡犬月，南北马牛风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江头绝句 其十二","author":"程本立","text":"孰知中国外，民俗乃驺虞。\n舞意存千羽，歌情在裤襦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江头绝句 其十三","author":"程本立","text":"谁似夷民乐，欢呼醉即狂。\n妇人无妒忌，儿女各成行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25670,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江头绝句 其十四","author":"程本立","text":"辛苦夷人妇，鱼篮各在腰。\n纺丝还夜夜，舂米亦朝朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25671,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江头绝句 其十五","author":"程本立","text":"卉裳缠胫窄，藤笠盖头圆。\n日日清江浴，生儿不记年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25672,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江头绝句 其十六","author":"程本立","text":"文锦腰间带，黄金顶上丝。\n浣纱如越女，解水似吴儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25673,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江头绝句 其十七","author":"程本立","text":"络臂银丝钏，缠头白帨巾。\n纷纷趁街子，卖酒坐藤轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25674,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚至昆阳州饮通守家土官留此州俟予至同宿马氏有邻妇李氏抱子携酒而至赋此","author":"程本立","text":"晚次同酋长，晨装戒仆夫。\n剁鱼炊白饭，系马与青刍。\n但喜人情合，宁论土俗殊。\n谁家小儿女，直欲挽吾须。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25675,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚宿山中与土酋共寝情亦真率因赋此诗","author":"程本立","text":"寂寂空岩夜，凄凄急雨寒。\n土酋分武帐，山鬼怪儒冠。\n天欲劳筋骨，人当见胆肝。\n忘形自高枕，睡熟梦金銮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25676,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早行忽数人被甲持弩至道左俟土酋及见余或揖或跪译者曰此倚石村部民也期此地迎酋而归既而上马从行至晚同宿山中赋此 其一","author":"程本立","text":"部落皆亭障，民氓尽卒徒。\n甲兵无外侮，弩矢有前驱。\n擒贼非难事，安边是远图。\n君恩同雨露，何地不沾濡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25677,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早行忽数人被甲持弩至道左俟土酋及见余或揖或跪译者曰此倚石村部民也期此地迎酋而归既而上马从行至晚同宿山中赋此 其二","author":"程本立","text":"杂种诸蛮部，深山一野人。\n树枝低作屋，松叶厚成茵。\n自祝身无恙，谁知句有神。\n生还见妻子，话此益酸辛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25678,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"以书词招火头忽纳归顺诗以记之","author":"程本立","text":"徼外之官日，山中僦屋初。\n游盘同鹿豕，孚信及豚鱼。\n已集投荒录，将驰谕贼书。\n中原一万里，人事近何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25679,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"时忽纳与死可伐刀木板皆已归顺山中无事与长官饮剧偶成","author":"程本立","text":"旧酿筒能吸，新诗藁未删。\n及瓜今日到，行李几时还。\n风雨家家碓，烟云面面山。\n不因边事息，那得宦情闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25680,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送韩县丞之官","author":"程本立","text":"退朝无事坐读易，索诗有客来扣门。\n每看新进诸才杰，都是故家之子孙。\n金兰结交岁迟暮，玉树照人天晏温。\n百里宁非大贤路，一饭敢忘明主恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25681,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送安处善司税之官青州","author":"程本立","text":"买酒直倾囊底钱，都门醉别意茫然。\n人生白发屐几緉，子去青州路一千。\n鸦背夕阳江雨外，马头秋色岱云边。\n大梁东接齐封近，书信频烦使者传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25682,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送月潭上人省母","author":"程本立","text":"日日慈乌啼树林，空山念母思难任。\n了经夜月三花影，洒泪春晖寸草心。\n远道归来尘满屦，高堂老去雪盈簪。\n衲衣便作斑衣舞，自觉天伦乐意深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25683,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送纪善黄宗仁归省闽中","author":"程本立","text":"王门朝并入，官舍暮同归。\n子负明经学，予惭窃禄讥。\n有言犹药石，相戒比弦韦。\n念此交期久，嗟时友道非。\n挑灯频夜雨，把酒及春晖。\n不寐缘听漏，无钱即典衣。\n兹晨陪祖饯，万里问庭闱。\n皆决闽山小，心先越鸟飞。\n白头今老大，彩服更光辉。\n乐意何终极，离歌莫叹唏。\n水深鸢跕跕，风急马騑騑。\n路黑桄榔暗，林红荔子肥。\n到家良愿幸，去国亦瞻依。\n楼阁云长绕，烟花露未晞。\n谬随书殿直，颇觉侍臣稀。\n细订凉秋约，重来慎勿违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25684,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钱仲沐赴京师","author":"程本立","text":"官舍五年居大梁，□□□人思故乡。\n词伯而今无铁史，门生何幸识钱郎。\n渡头打鼓船开驿，花底卷帘书满床。\n未论心期又相别，席上题诗烦寄将。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25685,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送洧川李主簿被荐赴京师","author":"程本立","text":"儒生有策致时康，送子城南别意长。\n四十脱身辞簿尉，九重虚已问贤良。\n杠梁往往农功后，榆柳阴阴官路傍。\n洧上曾过见佳政，于今父老不能忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25686,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张长史往闽中收书籍","author":"程本立","text":"亲王开国日清闲，讲殿同趋独厚颜。\n宿德造门如北海，善书留本似河间。\n禁渠冰尽微波绿，苑树春生细蕊斑。\n珍重大夫南粤去，满船图籍几时还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25687,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送欧阳太守之官东昌 其一","author":"程本立","text":"文忠孙子尽儒冠，汝最华年拜好官。\n白日锦衣行五马，青云彩翮翥孤鸾。\n闻名何似承颜色，握手谁能出肺肝。\n生别新知半悲乐，他时书札报平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25688,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送欧阳太守之官东昌 其二","author":"程本立","text":"倾盖金陵白下门，照人玉树色清温。\n殿前礼乐三千字，海内文章六一孙。\n雨露自天承紫诰，风云随地送朱幡。\n山东到日应春社，父老传呼花满村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25689,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋观鱼台送李濠州归河北","author":"程本立","text":"庄周非惠子，惠子非庄周。\n二子濠上意，固知鱼乐否。\n我陪李使君，聊复濠上游。\n漠漠野屋古，悠悠淮水秋。\n濠鱼不盈尺，数罟日相求。\n喁喁讵能乐，政似苍生忧。\n吾祖养鱼作，德与元化侔。\n庄惠满一哂，抚掌风萧飕。\n使君将北归，脱履巢云丘。\n濠州失父母，遮道不可留。\n涸辙无活鲋，深渊有潜虬。\n徘徊下台晚，极目送孤舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25690,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋海珠寺送史倅之肇庆","author":"程本立","text":"泓然小沧海，烱若明月珠。\n楼阁起中央，突兀金仙居。\n夜闻诸天乐，时有群龙趋。\n谁谓黍米微，大与八极俱。\n矧兹摩尼光，一碧涵空虚。\n府公或游息，赋诗怀抱舒。\n清风吹欬唾，散落天南隅。\n为政岂不劳，聊复乐公余。\n去珠行南还，民命其少苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25691,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李学正之易州为赋桃花崦","author":"程本立","text":"野性好林壑，胡为来市廛。\n岂无桃花崦，着我屋数椽。\n深深崦中花，万树春霞鲜。\n居民非避秦，鼓腹戴尧天。\n花间长儿孙，看花不计年。\n我欲往求之，路隔松萝烟。\n怅望小孤峰，玉立青娟娟。\n相逢李博士，颇似长庚仙。\n江东事幽讨，已有青鞋缘。\n得官不厌冷，幡然向幽燕。\n振衣山上风，洗耳石间泉。\n期君早归来，和我桃花篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25692,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王幼度待制致仕归大梁应教 其一","author":"程本立","text":"簪笔三年直禁坡，扬铃一日上淮河。\n归来疏传黄金重，老去冯郎白发多。\n野陌早花才点缀，官亭新柳已婆娑。\n梁园到日春如海，儿子将军奈乐何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25693,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王幼度待制致仕归大梁应教 其二","author":"程本立","text":"白发红颜七十龄，中原文物有仪刑。\n君王昼日勤三接，博士春秋老一经。\n宫锦赐来天上使，苑花开遍水心亭。\n都门祖帐千年事，犹有声光在汗青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25694,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送终南道士还山","author":"程本立","text":"脱屣都门骨已仙，山中故物尚依然。\n寒窗火伏烧丹灶，暖谷烟生种玉田。\n一马看来齐万物，双龙化去历千年。\n长生久视宁无诀，安得从师老后天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25695,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送日本僧游五台","author":"程本立","text":"中国有僧来日本，铁船过海是耶非。\n三更地底金乌出，万里云边白鹤飞。\n性本圆明能作佛，迹无拘碍已忘归。\n五台到日应残臈，看取天花满衲衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25696,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送征江倅朱克正赴京师","author":"程本立","text":"骑马出城官路长，滇池风雪正茫茫。\n北来地气符王化，南下天兵克鬼方。\n土鼓污樽皆礼乐，毡裘椎髻已冠裳。\n重来莫道边庭远，父老思君意不忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25697,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送云南通守朱绍祖考满赴京师","author":"程本立","text":"城南城北作春游，父老逢人说郡侯。\n田野只今无外事，衣冠何地不中州。\n马头红雨花都落，海子白云山欲浮。\n昨日新知今日别，可堪东望独凭楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25698,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送云南刘推官赴京师","author":"程本立","text":"恩承雨露出金銮，不是南蛮罚爽官。\n六诏山川开郡县，百年父老见衣冠。\n吏无隳突民何幸，狱有平反母所安。\n忽报政成将入觐，青云回首送飞翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25699,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柏峰为希仙道士作","author":"程本立","text":"何处仙家紫翠房，一峰烟雨柏苍苍。\n羊眠白石云根烂，麝过青苔雨气香。\n羽节凌风天有籁，彩囊盛露玉为浆。\n头颅我已将华发，便欲传君却老方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25700,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]