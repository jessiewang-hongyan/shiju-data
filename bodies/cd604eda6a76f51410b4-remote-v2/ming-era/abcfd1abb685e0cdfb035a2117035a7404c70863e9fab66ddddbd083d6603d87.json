[{"title":"寄邵希远校书兼简叔行东屏","author":"王绂","text":"萍踪俱是客，书馆喜相临。\n来往无多路，分违又一旬。\n酒应端午醉，囊似去年贫。\n烦语贤东道，池鱼好饷宾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25966,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代雪洲端阳招客","author":"王绂","text":"佳节逢端午，葵榴照眼新。\n君虽非饮客，我岂独醒人。\n綵索宁须繫，蒲樽正可亲。\n高情如不弃，林下望车尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25967,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中述怀二首 其一","author":"王绂","text":"卧病得休暇，提撕百念非。\n任真招物议，随俗与心违。\n露草乱虫响，云霄一鹤飞。\n君恩知未报，何敢道思归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25968,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中述怀二首 其二","author":"王绂","text":"问年才五九，底事便奄奄。\n壮志逐时减，新愁与病添。\n日晡思啖粥，风冷怕钩帘。\n有客来看命，犹谈蔗境甜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25969,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王检讨使朝鲜","author":"王绂","text":"秉节赴朝鲜，衔恩玉殿前。\n封圻宁有间，雨露自无偏。\n驿骑经辽地，云帆拂海天。\n远人迎拜处，应识使君贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25970,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病后寄同志","author":"王绂","text":"少小颇知学，老来何足论。\n自惭书翰力，难答圣君恩。\n一病较才好，两眸看渐昏。\n客囊无旧物，唯喜短檠存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25971,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄沈徵士","author":"王绂","text":"东阳沈徵士，于我久相疏。\n间别已三载，往来无一书。\n情怀终自若，客鬓近何如。\n遥想诸郎好，家庭乐有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25972,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠蒋御医用文","author":"王绂","text":"医名追扁鹊，传派自长康。\n叠见回生效，多藏经进方。\n竹深通药径，花外掩丹房。\n修合常供御，衣衫袭异香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25973,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送宏上人住保宁寺","author":"王绂","text":"别来忘岁月，相见又飘然。\n去住浑无著，行藏只任缘。\n故山唯落木，废刹锁荒烟。\n师去重开社，香灯祝万年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送鲁府黄谦纪善归莆田","author":"王绂","text":"饯别秦淮上，春潮没浅沙。\n寸心应恋阙，千里暂还家。\n客路多芳草，都门正落花。\n徵书看又起，未必久烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人归省","author":"王绂","text":"远别念亲闱，君恩独赐归。\n乡关经月到，烟水片帆飞。\n粱稻岁初熟，蟹螯秋正肥。\n遥知调膳处，綵服映春辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送怀益州长老之四明","author":"王绂","text":"怀公方外士，去住两翛然。\n有相皆成幻，无心即是禅。\n钟声山寺月，杯影海门烟。\n为续祖灯去，能忘应世缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送章秀才归松江","author":"王绂","text":"挟策来京国，经年未一官。\n籍名通秘阁，僦屋住长安。\n身病怜亲老，妻亡念子寒。\n恩教暂归去，不是学张翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽吴母","author":"王绂","text":"令子居郎署，慈亲白发垂。\n每闻期就养，谁料遽成悲。\n太史书阡表，名卿集挽辞。\n独怜斜日里，无复倚门时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25979,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郑州同知","author":"王绂","text":"考绩上铨衡，三年喜政成。\n郡人多颂德，朝士半知名。\n落日孤城远，秋风上马行。\n遥知溱洧上，父老久相迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25980,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋对月追忆去年诸公遂有存没升沉之感因成近体一首","author":"王绂","text":"中秋已过半，芳樽谁共亲。\n可怜今夜月，空忆去年人。\n得失蕉间鹿，存亡草上尘。\n挥杯劝孤影，只合伴閒身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄蔡景颢","author":"王绂","text":"始因从宦出，先世福州人。\n踪迹久居楚，语音犹带闽。\n田庐依妇族，图绘赠交亲。\n千里聊相问，身安莫厌贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄刘士俊","author":"王绂","text":"刘郎医术好，夙契已逢仙。\n制药少人见，秘方多祖传。\n家贫虽寂寞，客至即留连。\n廿载不相见，令人思惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25983,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄徐伯玉","author":"王绂","text":"每怀徐孺子，寥落共谁亲。\n早岁应多疾，衰年又复贫。\n苔痕封古巷，松影过比邻。\n独喜添丁好，传家幸有人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25984,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄徐九鼎","author":"王绂","text":"氏族南州派，遗风亦好潜。\n幽居邻陆羽，清艺祖蒙恬。\n地近傍城角，花深露屋尖。\n年来怕徵起，踪迹隐鱼盐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25985,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄潘子安","author":"王绂","text":"潘郎豪且逸，佐郡上瞿塘。\n纵酒宦情薄，耽诗野兴狂。\n才名虽藉甚，家业已荒凉。\n闻说乔公女，鸳鸯锁洞房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25986,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋宴集分韵得青字","author":"王绂","text":"秋半露初白，月高天更青。\n相逢如此夜，不饮若为醒。\n急管奏清响，长筵列广庭。\n百年能几会，杯到莫留停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25987,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题源隐","author":"王绂","text":"风景似仙家，山厨饭熟麻。\n恐人知姓字，避地隔烟霞。\n流水一溪雨，种桃千树花。\n莫教渔父识，出向世间誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25988,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈司仓廷玉","author":"王绂","text":"司仓虽小职，京国掌军储。\n天近屡朝见，官閒如隐居。\n秋风三亩宅，春雨一园蔬。\n咫尺频相过，毋烦重致书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25989,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张邦达之四会","author":"王绂","text":"送君之四会，接境近番禺。\n夷獠居相杂，炎凉候颇殊。\n时清销瘴疠，地广辟膏腴。\n政绩三年后，应知德化孚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25990,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王生还钱塘迎养","author":"王绂","text":"亲老当迎养，江帆去路赊。\n故乡翻是客，上国久移家。\n慈竹添新笋，春萱著晚花。\n到来应倍喜，甘旨乐繁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25991,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨教授之邵武","author":"王绂","text":"教铎之闽郡，诸生待琢磨。\n莫言居职冷，应见育材多。\n晚棹投孤驿，春衣换夹罗。\n去途经浙水，旧业喜相过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25992,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽菊庄金德厚先生","author":"王绂","text":"别去两经春，寄来书更频。\n只期重握手，宁料永伤神。\n禄养悲贤子，情亲泣故人。\n遥怜篱下菊，今岁为谁新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25993,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪夜凯师留宿戏赠","author":"王绂","text":"自笑年将老，无繇断爱憎。\n闭门辞俗客，下榻待吟僧。\n茶煮春冰溜，梅横雪夜灯。\n要能同此趣，京国许谁曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25994,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄匡世德","author":"王绂","text":"匡君一别久，踪迹近谁依。\n囊尽风流在，年高故旧稀。\n浩歌邀月上，独立看云飞。\n只叹阶庭下，无人戏綵衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25995,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题临清书屋","author":"王绂","text":"君家旧文献，世业喜联芳。\n书积数千卷，门开半亩塘。\n天光朝鉴满，灯影夜窗凉。\n未许终嘉遁，还应入帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25996,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"深静轩为云石长老赋盖取杜少陵竹深留客处荷静纳凉时之句以扁其轩云","author":"王绂","text":"何处可追游，兹轩景最幽。\n穿林开小径，凿地引清流。\n竹色明书幌，荷香散茗瓯。\n高僧尤好客，欲别更迟留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25997,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈景中昆仲题所画竹上","author":"王绂","text":"到京今六载，衰病独茕茕。\n在客谁知己，惟君弟与兄。\n经过常馈药，慰问每留情。\n持此岂云报，相期岁晚盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25998,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初度","author":"王绂","text":"此日逢初度，长年客帝乡。\n两京叨扈从，四海共安康。\n振佩趋青琐，濡毫向玉堂。\n不须称寿者，歌此进瑶觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25999,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"济宁分水闸访乡人王大使","author":"王绂","text":"自说到官久，往来多见临。\n上堂询旅况，对酒话乡音。\n日落郡城晚，河舂闸水深。\n南归应有待，停棹拟重寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26000,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东昌与陈德耔夜别","author":"王绂","text":"匆匆客路边，不得共留连。\n公馆灯前酒，王程月下船。\n孤城横旷野，断雁落平川。\n别后重相忆，应知夜不眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26001,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和赵彦如中秋对月韵","author":"王绂","text":"秋半晚凉新，空庭迥绝尘。\n共看今夜月，况是故乡人。\n展席聊呼酒，烹鱼底用莼。\n清光千万里，随处可相亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26002,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送台州医官裘训科南归","author":"王绂","text":"学业究岐黄，新除拜宠光。\n济人唯用药，从宦不离乡。\n选胜登霞峤，寻真访石梁。\n因知归思趣，不敢问奇方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26003,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋椰瓢","author":"王绂","text":"炎方充贡物，颁赐出金门。\n外表匏瓜质，中涵雨露恩。\n香甘宜作果，坚确可刳尊。\n铭刻须珍袭，留荣及子孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26004,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽李母","author":"王绂","text":"闾里共称贤，中途丧所天。\n教儿登显仕，抱志卒馀年。\n京国舆灵榇，横山入墓阡。\n铭文书琬琰，尤足慰重泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26005,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得家书","author":"王绂","text":"昨夜乡人到，家书喜见投。\n展开三四读，添却万千愁。\n舍弟贫依旧，山妻病未瘳。\n那堪诸幼稚，日日望归舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26006,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送倪知县克明服阕赴京","author":"王绂","text":"解绶归来庐墓侧，俄然三载废鸣琴。\n哀情那尽思亲泪，壮志难忘报国心。\n马识京尘嘶晚道，人经官驿听秋砧。\n恩荣不日除书下，好为林泉早寄音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26007,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题蔡教谕先生鹤冢卷","author":"王绂","text":"琴罢杏坛长自舞，蹁跹何遽永相违。\n漫追坡老舟中梦，谁复丁仙海上归。\n声断夜窗松月在，迹存春径雨苔微。\n空留泮水萧萧冢，落日凄风鸟雀飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26008,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿雪洲","author":"王绂","text":"半百才过一载馀，鬓须如漆美簪裾。\n富将诗礼传先业，老向田园乐隐居。\n椿桂阴森环第宅，芝兰萌茁满阶除。\n况闻贤母冰霜操，千古名传太史书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26009,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过赵徵君文鼎隐居","author":"王绂","text":"只今谁识旧王孙，高隐澄江郭外村。\n宗室世传家谱在，状元坊建鼎魁存。\n清秋山色横当槛，静夜潮痕直到门。\n拟得初春重相过，索尝新酒荐河豚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26010,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬华樗林见寄韵","author":"王绂","text":"可笑先生七十馀，年时宿习未能除。\n閒身寂寞难忘酒，老眼昏花不废书。\n半榻秋声吟细细，一樽灯影鬓疏疏。\n几番欲得相寻去，尚恐嫌人识隐居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26011,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨昂从戍","author":"王绂","text":"溪口停桡别故人，临行不觉泪沾巾。\n一身囊橐亲同旅，满眼松楸托近邻。\n蛮洞晓云晴复雨，瘴乡冬日暖如春。\n于今圣主多恩泽，久屈应知渐可伸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26012,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别雪洲东屏","author":"王绂","text":"地好况闻名习礼，参差高第映乔柯。\n偶来为客住因久，渐喜居人识较多。\n春暖壶觞陪燕集，秋清帘幕听弦歌。\n无端漫复西游去，主意勤惓奈若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26013,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜宿丹阳道中","author":"王绂","text":"行李出门才两日，离情无那便思家。\n初从异县登平陆，又下轻舟上小车。\n客路晚来投旅店，乡音日复近京华。\n不眠苦被诗情恼，吟落寒灯一穗花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26014,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿天界寺用石庵游惠山诗韵","author":"王绂","text":"木落空山古寺秋，寻僧聊遣世间愁。\n尘劳似海何时了，踪迹如萍著处浮。\n对榻暂同林下宿，煮茶閒引涧边游。\n明朝又欲飘然去，一幅轻帆过石头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26015,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢庆寿寺长老惠线香","author":"王绂","text":"插向薰炉玉箸圆，当轩悬处瘦藤牵。\n才焚顿觉尘氛远，初制应知品料全。\n馀地每延孤馆月，微风时飏一丝烟。\n感师分惠非无意，鼻观令人悟入玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26016,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"歌风台","author":"王绂","text":"黄屋初乘入故乡，悲风曾此醉壶觞。\n固知有国因三杰，复恐无人守四方。\n丰沛到今何寂寞，风云终古自飞扬。\n荒台独上追陈迹，空见残碑傍夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26017,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日早朝","author":"王绂","text":"七年从事玉堂閒，又值新正立晓班。\n夹道旌旗严五辂，充庭犀贝杂诸蛮。\n和风暖入承明殿，瑞霭晴开万岁山。\n圣代信然无隐者，布衣都得拜天颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26018,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和钱博士先生除夕感怀韵","author":"王绂","text":"京华住久客囊殚，对影萧然守岁阑。\n酒浸屠苏怜独饮，盘堆苜蓿共谁飧。\n家山梦在相思切，心事逢人欲说难。\n年复一年多白发，驻颜何处觅金丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26019,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观大祀","author":"王绂","text":"云汉昭回月正中，圣君严祀答苍穹。\n冕旒肃肃威仪盛，玉帛煌煌典礼崇。\n卤簿香飘凝瑞霭，箫韶声奏度祥风。\n百神咸格宸衷喜，愿祝繁釐万国同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26020,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕有感","author":"王绂","text":"坐拥寒炉夜不眠，漏声听彻欲朝天。\n但知旧岁逢新岁，不觉中年又晚年。\n斗转正临丹阙近，春回应自上林先。\n幸当昭代惭无补，独立东风思惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26021,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱叔服还江西写送别图并诗于上","author":"王绂","text":"柳拂东风弄晓寒，送君沽酒出长干。\n閒身已遂还家乐，直道方知处世难。\n云尽匡庐山色好，雪消彭蠡水容宽。\n离情一段归图画，留取相思别后看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26022,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张副使赴四川宪司","author":"王绂","text":"宪节遥临白帝城，圣心欲慰远民情。\n豺狼退伏霜威劲，雕鹗高抟海宇清。\n剑阁日斜骢马骤，锦江春好绣衣明。\n遥知到日循行处，父老欢呼夹道迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26023,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题住长老万竹深处","author":"王绂","text":"万竿森立翠交加，苍雪纷如天雨花。\n风度微凉侵贝叶，月明清影覆袈裟。\n林深灯暝时闻磬，径里烟生自煮茶。\n何日相过参玉版，禅关尤恐碧云遮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26024,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"牡丹","author":"王绂","text":"魏紫姚黄取次栽，清和将近始花开。\n群芳任意参前去，国色多情殿后来。\n帘外日高施帐幄，酒边风暖醉亭台。\n东君赋予何多也，无限繁华独占魁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26025,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梧桐","author":"王绂","text":"近种高梧金井旁，重重如盖映彫墙。\n岂惟清庙中琴瑟，伫看朝阳鸣凤皇。\n得地自怜承晓露，知时那肯著秋霜。\n贤侯公退钩帘处，满院清阴白昼长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26026,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴太仆还京","author":"王绂","text":"岁莫金台雨雪飞，匆匆相见即相违。\n年来每忆交游少，别后休令信息稀。\n马渡淮船春意早，人还京阙晓光微。\n亲朋见问无多及，况味依然老布衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26027,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重过小姑山","author":"王绂","text":"不到小姑今十年，望中风景尚依然。\n庐山金削遥天外，汉水绿浮飞鸟前。\n祠下女巫鸣赛鼓，沙头津吏官船。\n登临重觅旧题处，崖石岁深萝薜牵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26028,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄鹤楼","author":"王绂","text":"日暮江天独倚楼，楼高凝望思悠悠。\n仙人不见鹤不返，江水自流山自秋。\n七泽渺茫孤鸟度，三湘寥落片云收。\n数声长笛知何处，怀抱不胜今古愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26029,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄牛峡早行","author":"王绂","text":"滩下待明船子发，起来篷底尚馀酣。\n浪花夹棹捲晴雪，空翠扑人飞晓岚。\n胜迹登临多自惬，畏途跋涉信难谙。\n何当长揖人间事，老卧林丘颇自甘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26030,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜过瞿塘","author":"王绂","text":"瞿塘滟滪足风波，一叶官航抵暮过。\n峡尽顿看江路阔，山开尤喜月明多。\n图分八阵石犹在，柱锁重关铁未磨。\n惆怅英雄俱已矣，令人千古独悲歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26031,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重庆道中苦热","author":"王绂","text":"地近瘴乡秋暑热，客行长日汗流腮。\n草蒸恶气薰人醉，马蹴飞尘扑面来。\n望近驿楼思偃息，行当山路苦萦回。\n虚怀漫有相如渴，深愧应无作赋才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26032,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜发资县","author":"王绂","text":"过雨晚来凉气好，征鞍夜发肯迟留。\n月华炤路皎如昼，风叶满山浑是秋。\n度水柝鸣津口逻，隔烟灯起驿边楼。\n驱驰本亦勤王事，添得诗情分外幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26033,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]