[{"title":"题画寄陶良伯","author":"陆深","text":"东谷先生谷水东，黑头归去五云中。\n门前五柳今如许，不负陶家有祖风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40972,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题悦茶卷","author":"陆深","text":"水竹交居事事宜，更将春思斗枪旗。\n分符调得中泠到，未放松阴鹤梦迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40973,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予与袭锦子别凡十年矣丙戍冬初再得书不胜驰想题此寄之","author":"陆深","text":"人间真有杨州鹤，海上宁无青鸟书。\n一纸应须万金价，相思又是十年馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题马麟画兰","author":"陆深","text":"秋风九畹正离离，画里相看一两枝。\n欲寄所思无柰远，閒拈湘管对题诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅雪绝句三首 其一","author":"陆深","text":"岭南多梅却少雪，塞北苦寒花绝无。\n争似吴峰千尺白，暗香疏影两三株。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅雪绝句三首 其二","author":"陆深","text":"主人亭子青山曲，雪护梅花傍绮疏。\n扶起隔宵淹酒病，裹头袖手仗消除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅雪绝句三首 其三","author":"陆深","text":"浅沙细水独相亲，无赖飞琼妒早春。\n本是玉肌偏耐冷，捲帘孤负惜花人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽人失偶","author":"陆深","text":"春辞原上花销雨，鸾去台空凤独飞。\n寒夜灯前开故箧，不知泪满旧缝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40979,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题竹隐卷","author":"陆深","text":"抛却閒缘谢畏途，短床方簟竹閒铺。\n睡馀满地西风后，乱扫枯枝下酒垆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40980,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过无锡","author":"陆深","text":"泉声高下青山里，树影萧疏废堞前。\n无数客愁驱不尽，买鱼沽酒唤开船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"人持元史至用二十陌得之","author":"陆深","text":"囊中恰减三旬用，架上新添一束书。\n但使典坟常在手，未嫌茅舍食无鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿阳察院次壁间韵二首 其二","author":"陆深","text":"疏慵聊与拙相安，华发萧萧镜里寒。\n门掩万山深院静，古槐成盖绿阴团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40983,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"试院初寒偶阅陶诗","author":"陆深","text":"三日无诗太好奇，莫将胸次恼希夷。\n不知彭泽缘何事，十七年来九首诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40984,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄姚文光","author":"陆深","text":"白鹤江头白鹤村，水芳沙暖有名园。\n溪南九月黄花信，欲觅餐英夜过门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40985,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乡人送菊列之堂中","author":"陆深","text":"满堂秋色又年华，白白红红客到家。\n不似东篱老陶令，只愁无酒对黄花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40986,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"前十年愿丰堂曾识金宗鲁后十年宗鲁之子复至江山如昨而余已老矣不知今吾故吾宁何如耶漫兴一首","author":"陆深","text":"曾看老马五花纹，骥子风神又出群。\n世上骊黄总相似，不知谁为扫千军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40987,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过溪庄留题","author":"陆深","text":"漠漠平田水漫流，溪庄端合雨中游。\n主人爱客千金寿，报尔天香万斛秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40988,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢何登之惠玉兰","author":"陆深","text":"扬州何逊最能文，江水东流隔暮云。\n我有好峰三十六，玉兰花发正思君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40989,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白云谣","author":"王世贞","text":"白云西来，弥漫四垂。\n虽有赤骥，畴能不迷。\n将子暂留，有桃如饴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40990,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"穆天子谣","author":"王世贞","text":"予洽东夏，偕化人居。\n岂无群后，唯子是仪。\n执袪而腾，不以胫驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40991,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"易水歌","author":"王世贞","text":"易水立兮，虹缭天。\n壮士一出兮，秦为燕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40992,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"垓下歌","author":"王世贞","text":"群雄伏兮，婴授首。\n纵孤豚兮，齧人肘。\n虞兮骓兮，弃若遗。\n天亡我兮，将告谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40993,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大风歌","author":"王世贞","text":"大风发兮，扬天威。\n一剑游兮，万乘归。\n愿得五臣兮，赞无为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40994,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋风辞","author":"王世贞","text":"秋风谡谡兮，霜未飞。\n草木忍雕兮，待恩晖。\n晋有璧兮，汾有珠。\n君心怿兮，自敷腴。\n鏦金钲兮，雷大鼓。\n神鱼跃兮，黄鹄舞。\n志谈荡兮，媒慨慷。\n来日短兮，去日长。\n望岧峣兮，耸双龙。\n恭已无为兮，垂舜裳。\n后天地兮，凋三光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40995,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李夫人歌","author":"王世贞","text":"人耶仙耶，宛然而来者，畴为汝之权耶。\n仙耶人耶，翩然而去者，畴为汝之身耶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40996,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"平城歌 其一","author":"王世贞","text":"汉使来，胡马死。\n汉使归，死马起。\n生何致致汉天子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40997,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"平城歌 其二","author":"王世贞","text":"曲逆腹，如腲膇。\n不能出，一奇彼。\n有阏氏此有戚姬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40998,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"平城歌 其三","author":"王世贞","text":"开一角，纵汉兵。\n汉天子，有神灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40999,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"平城歌 其四","author":"王世贞","text":"汉天子，何神灵。\n韩彭死，冒顿生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41000,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"平城歌 其五","author":"王世贞","text":"阏氏妒，妒汉女。\n单于乐，乐翁主。\n金珠纨縠压驼马。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41001,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌孙公主歌","author":"王世贞","text":"妾人自惭兮，诸侯女。\n谬托嘉名兮，汉翁主。\n宠我饵我兮，作远婚。\n匈奴贱种兮，号乌孙。\n昆弥老兮，非我偶。\n少王壮兮，实余后。\n念欲一死兮，为国忧。\n失身苟活兮，贻国羞。\n丞相何人兮，爵通侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41002,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蹛林歌","author":"王世贞","text":"六骡马，白羽笴，嫖姚物故天助我。\n单于自将会蹛林，左贤一矢贯两禽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41003,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"敕勒歌","author":"王世贞","text":"银服匿，紫酡酪，宁胡阏氏奏汉乐。\n北风摄羊一万角，十道壮马不得索。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41004,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"娇女诗","author":"王世贞","text":"娇女好姿首，不为他人媚。\n阿母手簪花，花掷弃之地。\n作女任汝骄，作妇恐不易。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41005,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三洲歌 其一","author":"王世贞","text":"阿母见钱喜，女今见钱悲。\n金铸估客身，不得好心期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41006,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三洲歌 其二","author":"王世贞","text":"万斛峨珂舟，人道是珍贿。\n一头载红妆，一头载绿蚁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41007,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三洲歌 其三","author":"王世贞","text":"船过第三洲，日落门前树。\n定有可憎人，侬今不肯住。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41008,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"襄阳蹋铜蹄 其一","author":"王世贞","text":"襄阳老龙堤，爨石铁作泥。\n骏马骄凿落，真是蹋铜蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41009,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"襄阳蹋铜蹄 其二","author":"王世贞","text":"买得樊城酒，来醉襄阳伎。\n人道江波险，侬道是平地。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41010,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"襄阳蹋铜蹄 其三","author":"王世贞","text":"宜城七十里，朱楼与云齐。\n无地着酒馆，眼饱肚中饥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41011,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"襄阳蹋铜蹄 其四","author":"王世贞","text":"醉倒习家池，扶郎郎不归。\n道侬工下泪，去看羊公碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41012,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿阿曲","author":"王世贞","text":"天门三十六，地户七十二。\n门门与户户，一一一天帝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41013,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石城曲 其一","author":"王世贞","text":"石城诸郎子，结束种种新。\n眼角多留媚，是侬昨夜人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41014,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石城曲 其二","author":"王世贞","text":"广陵细腰女，搦搦裁一束。\n不敢望同生，一宵抱亦足。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41015,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"莫愁乐 其一","author":"王世贞","text":"家家迎莫愁，人人说莫愁。\n莫愁歌一字，恰恰印心头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41016,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"莫愁乐 其二","author":"王世贞","text":"十万作缠头，莫愁不肯留。\n银缸黯欲尽，翻为莫愁愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41017,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"休洗红","author":"王世贞","text":"休洗红，洗多渐成碧，裁作侬衣不中饰。\n红随逝水杳不归，何似当初但为白。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41018,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"千里马","author":"王世贞","text":"千里马，胡不疲。\n五帝渐以骤，三王不免驰。\n焉能饱食安步歌皇羲，上乘此马将何之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41019,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"轵深井里门行有叙","author":"王世贞","text":"韩国嬖大夫，轵深里中客。\n车马委巷过，贵贱不相敌。\n长跪觞母前，别致金百镒。\n为母隐狗屠，未敢轻七尺。\n惟有径寸丹，耿耿桂其臆。\n母死服已除，慨焉欲有伸。\n大夫不共天，侠累相且亲。\n偻行至韩国，仗剑入其闉。\n长戟五百队，戢戢若鱼鳞。\n傍睨陛楯间，眇若无一人。\n挺刃不三挥，立斮其君臣。\n所当悉糜碎，愤血射青旻。\n皮面屠出肠，顷刻捐其身。\n法当购主名，千金尸诸市。\n亲友皆避匿，乃独惊其姊。\n抚尸独呼天，是轵深井里。\n聂姓以政名，心借严仲子。\n捐躯为其友，毁形为其姊。\n弟昔从母生，姊今从弟死。\n仲子愿已酬，株累亦可矣。\n安能顾区区，千秋掩贤弟。\n我欲竟此曲，一曲酒百卮。\n宁如豫与荆，身殁有余悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41020,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"信陵行","author":"王世贞","text":"侯嬴夷门监，朱亥猪狗屠。\n薛公卖浆者，毛公一博徒。\n公子枉见之，腰膂屈若无。\n上客气未平，下客眼为枯。\n畴击晋将军，畴窃宫中符。\n畴能动公子，趣驾返魏都。\n一战王龁走，再战蒙骜逋。\n邯郸复称赵，大梁不为墟。\n五国所宾从，响应复景趍。\n秦间一何亲，令弟一何疏。\n秦王一何狡，魏王一何愚。\n少来不纵酒，亦不恋名姝。\n称病不复朝，谢客日都卢。\n宁为汴郊鬼，勿作咸阳俘。\n英风感异代，天子酹其丘。\n可怜安厘王，不得麦一盂。\n客从咸阳来，几作诸侯奴。\n亦言骊山足，久已窟妖狐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41021,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鲁朱家行","author":"王世贞","text":"朱家昔在汉，与高帝同世。\n为侠不沾沾，中心实自喜。\n藏活豪贤以百数，余人不胜纪。\n斥买十钳奴，中有季将军，画策谒滕公。\n上为赦其罪，得复拜郎中。\n将军既尊贵，若遗忘故恩。\n朱家终身不相见，亦不复自言。\n将军与弟心，共乃师其意。\n一勇一诺，闻诺者至死长负愧。\n侠儿有田孙有剧，任侠不已郭翁伯，嗟嗟膂断族亦赤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41022,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鸱夷子行","author":"王世贞","text":"计然有七策，少伯五用之。\n刍粟如丘山，坐使会稽肥。\n灭吴既强越，弃之忽若遗。\n扁舟适齐邦，自称鸱夷子皮。\n为田僇子我，阴使齐社移。\n忽复谢所宗，以其重宝归。\n陶适天下中，众贿所化居。\n黄金直千万，三致三复挥。\n少子诛，了不悲，老氏张翕吾所师。\n神龙变化那可羁，安用区区相印为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41023,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雁门大守行","author":"王世贞","text":"太守未行屯，与敌共雁门。\n雁门得太守，始复为汉有。\n太守来，匈奴走。\n碧眼番儿射雕手，目瞬舌噤畏木偶。\n临江死，太守生，长信官中气未平。\n太守死，单于喜，未央宫中上拊髀。\n曷不早赦临江王，孝子忠臣两无伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41024,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东方曼倩行","author":"王世贞","text":"孝武帝时有东方生，长九尺余。\n月请一囊粟，不能并侏儒。\n用奇钓上闻，待诏始离公车。\n射覆多巧中，往往解上颐。\n舌折郭舍人，戟止馆陶儿。\n拔剑割伏肉，殿上或小遗。\n怪哉辨秦狱，驺牙表降夷。\n歌郑必终雅，为谀不废直。\n偶尔乞大官，无官意亦得。\n上赐颇不赀，梁肉金钱帛。\n悉送宛若家，相与行交接。\n海鸥一世主，儿戏诸王公。\n首阳呼为拙，柱下始云工。\n宁学公孙丞相，脱粟不令舂。\n厨车载渭桥，巫蛊满东宫。\n挥手谢世人，竦身白云中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41025,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"颍水浊","author":"王世贞","text":"颍水浊，灌氏族。\n灌氏族，魏其僇。\n结交莫结侠，结侠身似叶。\n使气莫使酒，酒中三尺铁。\n捐身为名名不美，当时悔作有心鬼，不教田鼢磔东市。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41026,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"莫跋扈","author":"王世贞","text":"莫跋扈，付丁旿。\n莫侜张，付桓康。\n半面哭，半面啼。\n死与生，在一时。\n坏长城，犹自哿。\n蚀明月，我灭我。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41027,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古押衙","author":"王世贞","text":"蛙黾在沟中，求吃天鹅肉。\n仙客小鳏夫，思从宫嫱宿。\n明珠故自珍，龙颔有逆鳞。\n富平古押衙，一片有心人。\n一片心，几腔血，杀人灭口身并灭。\n淮西有李朝有裴，七尺不售君王奇，坐忍万姓皆攒眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41028,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"施殿司","author":"王世贞","text":"施殿司，不了事。\n可怜一片心，化作千载泪。\n窃国误国凡几辈，夜博氍毹满堂醉。\n千人颦眉万人指，不见头颅化为水。\n我疑古来少剑客，不然剑客非男子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41029,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贾团练","author":"王世贞","text":"循州窜，漳州窜，懊恼吴团练不见。\n贾团练，芜湖覆，临安覆，生憎陈。\n都督死为贾都督，当时失刑赖虎臣。\n虎臣小臣何足论，惜哉宋季终无人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41030,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"顶生王","author":"王世贞","text":"顶生王，福德圆，三十二相种种全。\n生时七宝俱见前，遂冯金轮王四天。\n一天一王二万年，帝释之宫须弥颠。\n天厨天乐天无边，愿分半席长周旋。\n欢娱不足贪念至，欲逐桓因夺其位。\n咄咄未绝倏堕地，七宝俄然尽捐弃。\n铁围城中火方炽，烧君四大能不悔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41031,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阿修罗","author":"王世贞","text":"阿修罗，报生大海中，金银为阙琉璃宫。\n五欲约略人间同，寿亿万岁永无终。\n犹恨不及帝释天，贪嗔在心吻吐烟。\n耸身直上须弥颠，两手欲掩日月圆。\n却敌城头戟如霜，四天奔波悉勤王。\n法华宝经置中央，修罗万众倏败亡，藕丝中细不得藏。\n事已非，空倨骂。\n缚汝不杀特汝赦，何颜复立须弥下。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41032,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"琉璃王","author":"王世贞","text":"疏璃王，母为波斯匿王女。\n宫中小婢称翁主，不产麒麟产狼虎。\n儿时漫陟狮子座，释种小语摩诃祸。\n琉璃王，嗔心一起火燎冈。\n十万剑戟横清霜，倒曳窣堵躏佛场。\n可怜诸释种，不蓄四兵抱头死。\n血作阿耨池头水，云胡破戒呼婢子。\n琉璃王，水中有火如汝嗔，火车拥入阿鼻门。\n嗟嗟能仁未为仁，死不能救称宿因。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41033,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无忧王","author":"王世贞","text":"无忧王，昔作童子戏。\n抟沙奉世尊，遂登铁轮位。\n以此夙因皮肉粗，宫中为欢不成娱，三千娇女并就屠。\n拔将蔑戾车，生主阿鼻狱。\n镬汤与火床，碓剉诸业毒。\n但入不得出，入者已非一。\n不独祸平人行复，赚王入烹烧恶狱。\n主刬平，生阿鼻。\n昔作无厌杀，今作无厌施。\n发取八万四千佛舍利，立造八万四千窣堵波。\n一夜役鬼神，为我分置娑婆。\n九十六千亿黄金，不如当时一掬沙。\n金器银器及铜瓦，不如最后半诃摩。\n勒果摩登伽鸯崛摩，一念回向成阿罗。\n福德可似人王多，倘不蚤悔将奈何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41034,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乐府变十章 其一 楚悯王","author":"王世贞","text":"楚悯王，坐武昌，金瓶酒寒夜未央。\n中弦调移角奋扬，铁椎交飞血从横。\n可怜玉匣黄金床，不得全颅置中央。\n太子距跃不下堂，美人如花列两行。\n含辛饮泪娱新王，焉用擗棘茨垣墙。\n御史来，鼓彭彭。\n黄纸当头槛车迎，长安大人食枭羹。\n食枭羹，语枭子，而枭之父亦如此。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41035,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乐府变十章 其二 黄河来","author":"王世贞","text":"黄河西来昆仑，小复前汇玉关。\n自是白羊楼烦。\n汉将所筑城，犬牙其间。\n敌阑入之不休。\n橐驼騊駼牦牛。\n控弦穹庐四周。\n自我失新秦州。\n与敌杂治共繇。\n大夫大夫，曾君忧虞。\n人吏买马具车。\n诘朝慷慨就途。\n上请誓剑玺书。\n咄嗟大夫，不睹长安之城，武安魏其。\n日夜引绳龂龂，千金偏行奚为。\n金吾白发之赫哉天威。\n咄嗟大夫，不见兵出玉关，乃见藁街之西，不悬郅支，乃悬大夫。\n万水东流，鱼西上钩。\n谁独为敌，人快私雠。\n咄嗟大夫，乃为相君快其雠。\n咄嗟大夫气尽，不复欢谣。\n离离山下苗，托荫山上桃。\n风吹桃根堕，苗行代桃焦。\n可怜生无常，生死借人骄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41036,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]