[{"title":"送蔡祯启归端州","author":"叶春及","text":"千盘风雨落高秋，有客能逢桂树留。\n碑镌夏王生绿字，书传周史拥青牛。\n洞中列籍渑为酒，海上名山石作楼。\n明到星岩枫叶下，扶桑东望是丹丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13716,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送柯广文先生赴建阳","author":"叶春及","text":"传经雪色满罗浮，桃李阴阴出郡楼。\n衔鳣晚占卿士服，啼莺春伴孝廉舟。\n家临龙穴三山近，水到虹桥九曲流。\n千载方塘云袅袅，为将蘋藻寄沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13717,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题沈参戎风木图 其一","author":"叶春及","text":"万家葱郁太湖滨，佳气吴阊疋练新。\n过眼千钟悬鹳雀，伤心高阁画麒麟。\n天空落木萧萧下，岁暮长空淅淅频。\n有客览图愁独立，因君回首泪沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13718,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题沈参戎风木图 其二","author":"叶春及","text":"百岁光阴隙里过，悠悠天地竟如何。\n惊看逝水奔流易，忍见飞云出岫多。\n漫说千钟酬罔极，谁怜三釜叹蹉跎。\n悬知大孝终身慕，愁绝为君赋蓼莪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13719,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甘棠遗爱卷为李明府题","author":"叶春及","text":"凫舄飘飖向碧空，楚天西望楚王宫。\n峰高白鹤千家雨，峡静黄牛一笛风。\n到日泸川迎五马，他年碣石看孤鸿。\n罗浮万树梅堪折，曾有棠阴满越中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13720,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和沈参戎晓发望平海韵","author":"叶春及","text":"?吏鸡鸣报晓程，角声初散远烟横。\n追风万马联镳度，照日双龙出匣明。\n大海阴云低幕府，乱山孤戍入前旌。\n将军按塞还能赋，愿以铙歌答太平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13721,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"逸史流芳卷为保昌吴令乃翁赋","author":"叶春及","text":"忽漫青牛紫气来，关门令尹自仙才。\n天空汉阙双凫下，日落湘山一雁哀。\n白雪调高空黯淡，朱陵洞杳没蒿莱。\n少微寂寞休回首，列宿光今接上台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13722,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日高士峰宴集 其一","author":"叶春及","text":"傲吏名山不厌游，况逢佳节更悲秋。\n浮云晓向千峰散，落木寒临万壑流。\n海上楼台澄蜃气，樽前鸿雁起边愁。\n腐儒岁晚真何补，欲向沧浪买钓舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13723,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日高士峰宴集 其二","author":"叶春及","text":"作赋兼随汉大夫，更怜叶县有飞凫。\n深秋我饱青精饭，避世谁藏白玉壶。\n老去风尘双鬓改，晚来砧杵一城孤。\n莫辞此日樽频倒，愁见当年角夜呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13724,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同祁山人登高士峰","author":"叶春及","text":"城畔群山亦不遥，县斋终日对岧峣。\n登临白帻还高士，海国青天自暮潮。\n南浦佩环心欲折，北风樽酒鬓随飘。\n朱明石室同游地，松桂因君问寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13725,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丰谷道中洪子颐邀饮分韵得涯字","author":"叶春及","text":"洛阳谷口自逶迤，云木苍苍满古祠。\n宅近青山微有路，潮来沧海浩无涯。\n穷愁短鬓先秋色，落日青樽对晚飔。\n泽畔相逢容易醉，肯教渔父向人疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13726,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵怀李宗阳赴袭","author":"叶春及","text":"金台迢递塞鸿边，君去繁霜正黯然。\n忆我定携燕市酒，与谁同醉蓟门烟。\n铁衣天上承恩早，玉殿云中入梦偏。\n明到都城兴非浅，开襟应待小春天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13727,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄刘玉汝","author":"叶春及","text":"严君交谊薄雷陈，两世金兰分最亲。\n裋褐幸逢明主圣，绨袍遥忆故人贫。\n乡园鼙鼓秋来急，村郭蓬蒿雨后新。\n生计萧条非独尔，题缄南北共伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13728,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送侄男兆备兵宁绍 其一","author":"叶春及","text":"滇池节钺回三殿，横海楼船壮四明。\n虎旅旧传君子阵，鲸波今为圣人平。\n天清蜃气通蓬岛，霞起鸾标见赤城。\n自合寻仙求大药，东夷无用请长缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13729,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送侄男兆备兵宁绍 其二","author":"叶春及","text":"建旄分府领诸侯，万壑千岩亦胜游。\n山削芙蓉常带雨，寺藏松桂不知秋。\n青春草满严陵濑，白露潮生范蠡舟。\n若到东山一回首，须知小谢最风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13730,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元旦","author":"叶春及","text":"去岁今晨皇极殿，龙飞宝幄静朝鞭。\n垂绅曳佩此何处，伐鼓椎钟异往年。\n草色渐辉闽海日，柳条遥弄蓟门烟。\n传经抗疏非吾事，漫说仙郎白玉篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谷日登盘谷岩楼诸生同游言岩西南有芹山观旧址乃白玉蟾脩炼之所遂往寻之席地复酌 其一","author":"叶春及","text":"高楼谷日欢同赏，弄柳攀梅又此时。\n开岁斜川谁共往，暮春沂水尔何迟。\n年丰绿蚁邻能续，谷煖黄莺树屡移。\n满眼物华喧勃勃，即看岩壑迥多姿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谷日登盘谷岩楼诸生同游言岩西南有芹山观旧址乃白玉蟾脩炼之所遂往寻之席地复酌 其二","author":"叶春及","text":"剧游芹观贪寻历，度岭穿林坐翠涛。\n山里杯盘吾自放，镜中冰雪鬓何逃。\n路难时欲辞朱绂，洞窈春应长碧桃。\n惆怅暮云堪酩酊，古原斜日满蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中抱病遣怀","author":"叶春及","text":"抱病东还望不孤，罗浮回首见清都。\n膏肓自信为泉石，雨雪谁堪载道途。\n伏枕夏云生几席，观涛秋色满江湖。\n丹砂未就头先白，叶县何因舄化凫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"叶韡夫李宗阳携酒见访","author":"叶春及","text":"城上阴云静不开，为谁携酒到蒿莱。\n醉骑白鹤昏钟迥，书付青鸾暮雨来。\n垂老几人还跃马，狂歌孤剑更登台。\n亦知逃暑同河朔，倘许明朝尽我杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雾雨至太和宫俯视一气咫尺不辨 其一","author":"叶春及","text":"五日阴云郁不开，千崖萧瑟气悲哉。\n祇凭客子青藜杖，拄到仙人白玉台。\n万里风抟天柱动，百灵涛涌雪山来。\n俱言石洞堪龙卧，不遣荆南驾鹤回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雾雨至太和宫俯视一气咫尺不辨 其二","author":"叶春及","text":"叆叆浮云满九关，帝宫只在紫微间。\n雨沾万国看龙变，雾匝千岩隐豹斑。\n骏骨已知轻郭隗，蛾眉何复妒麋山。\n具茨咫尺襄城道，牧马宁虚七圣还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"质明谒帝期雨亦往忽然晴朗遂得遍游","author":"叶春及","text":"天门初日照扶桑，雾捲千峰见八荒。\n遂使冲星朝玉帝，始知遇雨异秦皇。\n山连瀛海三神出，水划中原万里长。\n霁雪开云俱往事，丹梯南望迥苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登太和山 其一","author":"叶春及","text":"缥缈灵光信有无，秋高天柱倚踟蹰。\n云扶汉畤藏仙箓，天福燕京护帝符。\n宣室席前怜贾谊，茂陵书就愧相如。\n悲风落日增萧瑟，极目中原一雁孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登太和山 其二","author":"叶春及","text":"玉梯矗立碧天愁，金殿高悬万壑秋。\n坐拥龟蛇神北极，地分龙虎壮南州。\n衡庐半逐炎荒落，江汉双环太岳流。\n更有蓬莱云五色，曣㬈长傍帝乡浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过虎岩访不二上人","author":"叶春及","text":"一龛高傍虎岩栖，为访东林到虎溪。\n转后三车空贝叶，悟来双树失菩提。\n云间玉麈秋相对，镫映金轮夜不迷。\n天籁声中闻软语，依依凉月曲栏西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林均州招饮沧浪亭席上口占同席王杨两孝廉余门人东官黄于广","author":"叶春及","text":"路迷江汉百愁生，亭入沧浪一棹轻。\n鼓枻偶闻渔父唱，濯缨宁比使君清。\n层崖雨过芙蓉湿，曲岸烟开翡翠明。\n尘满素衣归未得，石泉空负故山盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送廖大夫解绶归闽","author":"叶春及","text":"石洞归耕卧白云，幔亭招隐又逢君。\n举杯闽越飞鸿远，把袂江楼比翼分。\n尘世几回伤按剑，北山无复更移文。\n他年相访渔樵地，九曲溪边对夕曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄吴一庵别驾","author":"叶春及","text":"我从西粤罢弹琴，君赋东征返故林。\n转眼江湖双白鬓，侧身天地几同心。\n逃归实就罗浮卜，怅望时为梁甫吟。\n莫怪虞卿轻去国，著书元不为愁深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元旦同梁懋孚叶思叔冒雨游湖是夜风雨大作随波达旦","author":"叶春及","text":"元日今年雨不绝，玉壶画舫兴何豪。\n城边暝合青山失，夜半风鸣白浪高。\n咫尺楼台藏洞壑，参差钟磬出林皋。\n明朝只在沙鸥畔，冻草寒云共羽毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赴西粤投檄祁在德崔子玉送至石门","author":"叶春及","text":"为渔湖海昔同盟，回首风尘此濯缨。\n十日平原生夜色，一帆春雨见交情。\n苍梧愁听湘妃曲，五柳空高处士名。\n闻说淮南堪卧理，梁鸿早已去西京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访曾明吾","author":"叶春及","text":"为谁挂席趋炎海，忽尔穿松到夜关。\n满眼交游吾白发，侧身天地此青山。\n蛟龙涛浪秋仍壮，鸟雀园林晚独还。\n偃蹇尚怜丛桂内，他年寒色共君攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题白鹤山房","author":"叶春及","text":"主人茅堂秋瑟瑟，留宾柏坞酒常开。\n山空白鹤何年去，日暮流萤隔幔来。\n池草世传鹦鹉赋，海门东瞰凤凰台。\n黄金白发俱尘土，鸥鸟从君幸不猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游海隅山","author":"叶春及","text":"海上双峰镜里开，芝城宫阙亦蓬莱。\n九江秀色东南尽，三峡涛声天地来。\n薄暮鱼龙喧鼓角，中流日月隐楼台。\n沧洲吾道真堪付，渔子帆樯共往回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠郑叔异","author":"叶春及","text":"谷口风流有子真，故园松竹晚逾亲。\n绨袍晓带烟霞色，蓬径秋兼芋栗贫。\n下榻郡斋清漏永，传经幕府绛纱新。\n翟公门巷罗堪设，载酒时能访野人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送祁马石赴京","author":"叶春及","text":"燕台侠客日相将，走马曾游易水傍。\n明月逢人常按剑，白云何处不飞觞。\n行边骏骨黄金重，到日莺花紫陌长。\n卜筑茅溪怜爱弟，为谁春草赋池塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送叶韡夫赴京","author":"叶春及","text":"燕京宫阙倚云开，君去重登郭隗台。\n千里骅骝元道路，五湖鸥鹭自徘徊。\n天涯公子思芳草，海上怀人寄折梅。\n卜筑正怜羊仲在，几时松菊赋归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬梁少仲见寄","author":"叶春及","text":"不见经年梁少仲，东园禊饮使人思。\n风回宝刹潮生处，雨过银塘客醉时。\n病起忽来青鸟使，缄开重见白云词。\n清秋拟鼓扶胥柁，为尔同攀桂树枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄欧祯伯","author":"叶春及","text":"故人薄宦滞燕京，尚忆江都怅别情。\n三徙不离秦博士，六经空对鲁诸生。\n西山晚映青毡色，北阙谁同白雪声。\n朝罢九衢寒漏永，可能清梦到朱明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"铜岭吊古","author":"叶春及","text":"千峰天畔簇旌旗，想像勤王转战时。\n故宅有基巢水鹤，空山无庙荐江蓠。\n悲风松柏人何在，落日壶觞我不辞。\n满地属镂无处死，扁舟生计学鸱夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别陈辅德李敬可","author":"叶春及","text":"泽畔行吟晚有君，天涯不复叹离群。\n高斋实下陈蕃榻，对酒重论李白文。\n醉后旗峰当面出，别时铜岭一溪分。\n亦知会合离非久，伫望?堪日暮云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归罗浮","author":"叶春及","text":"轩车十载走风尘，灵境归来学隐沦。\n猿鹤隔林如识主，峰峦当户似窥人。\n紫萝尚拂游时路，白发惭非洞里身。\n结屋已连南涧曲，移文休拟北山神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕","author":"叶春及","text":"屡将时节客中过，今夜双星又渡河。\n天上佳期应有数，人间欢会苦无多。\n合离不定桥边影，巧拙何心杼里梭。\n我亦年来解玄理，却怜尘世尚蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重阳后一日梁懋孚约游北山","author":"叶春及","text":"侵晨共到寒山里，薄暮扁舟入晚阴。\n黄菊独怜今日醉，白衣偏称故人心。\n经年始得归蓬舍，野性从来在竹林。\n不是重阳能补会，那逢樽酒涤烦襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"閒居 其一","author":"叶春及","text":"逐逐炊烟故不除，豗豗鸡犬伴閒居。\n鼠肝虫臂劳天地，凤矫龙盘接里闾。\n作粥每寻长白寺，闭门空著太玄书。\n傍人莫笑扬雄宅，紫府清都是我庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"閒居 其二","author":"叶春及","text":"穷巷回车本自偏，田家犹喜石堂眠。\n立锥近市非无地，抱瓮林山尚有园。\n栖共鹪鹩资一树，乱闻豺虎遍中原。\n伤心此日缘何事，愁听孤城角夜喧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵寄内 其一","author":"叶春及","text":"畏途牢落己忘机，旧学荒凉叹昨非。\n览胜欲寻白鹿洞，题缄寄与乐羊妻。\n田耕沥脚天常旱，粟尽瓶中我未疲。\n正赖宿瘤将历齿，莫教岁暮泣牛衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵寄内 其二","author":"叶春及","text":"金陵怅望才烹鲤，玉帐遥闻已梦蛇。\n翟令无钱犹养女，刘公有约好为家。\n乾坤委蜕人何与，缓急由天我未嗟。\n不学向平毕婚嫁，浪游聊御白羊车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赏侄文兆菊","author":"叶春及","text":"侬家小阮碧栏杆，移菊梁园傲岁寒。\n已有郢人白雪曲，那愁陶氏黄金盘。\n疏枝曳曳冻渐解，密蕊滴滴露欲团。\n我会呼儿醉阶下，何须载酒东篱看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和刘古唐翁论学诗 其一","author":"叶春及","text":"春陵一窍在图先，挈领提纲旷世贤。\n悟后洛阳归自别，熟时关内夜应眠。\n怜蛇怜蚿情俱失，逃俗逃禅见各边。\n动静无端惟此理，是谁参透大因缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和刘古唐翁论学诗 其二","author":"叶春及","text":"未发之中不是先，一齐穿纽几前贤。\n回三未解挥戈舞，吹万何妨隐几眠。\n朱陆异同俱有说，周程风月迥无边。\n明珠欲得惟沧海，却恐求鱼向木缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梦中作","author":"叶春及","text":"第一楼中静晚涛，忽闻仙乐下云旓。\n青蛇舞共南天远，黄鹄飞连北极高。\n万里长江堪属目，百年佳兴独挥毫。\n元精饱食朝霞气，老妇无劳唤浊醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"不寐","author":"叶春及","text":"露下天空秋可怜，高楼明月倍娟娟。\n一株桂影江湖上，半夜钟声霄汉边。\n玉壶击碎笑今日，金阙攀援思往年。\n慷慨劳歌不成寐，挥衣起舞双龙泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉送按察马公治兵河东","author":"叶春及","text":"太行北望郁嵯峨，建节人传马伏波。\n宪府山川雄魏国，油幢霜雪下汾河。\n汉庭久拟三旌待，晋史徒誇五利和。\n猃狁只今须薄伐，期君出塞拥雕戈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕前二日武昌孙大守李别驾韩司刑置酒黄鹤楼席上口占","author":"叶春及","text":"欲乘黄鹤鹤不来，黄鹤仙人安在哉。\n雪飞楼阁客肠断，岁莫江湖老鬓催。\n蜗角误我葛洪洞，骏骨欺人郭隗台。\n泽上那能歌独醒，为君一饮三百杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽东泉李将军","author":"叶春及","text":"漏尽钟鸣罢晓筹，飞将军不待封侯。\n楼船泛海五千里，斧钺成家六十秋。\n玉树西风愁里折，宝刀南斗匣中收。\n伤心两世交游泪，呜咽真同陇水流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"直沽","author":"叶春及","text":"复泉卫水还归海，吞吐漕渠是直沽。\n秦汉黄河非禹迹，幽燕紫气本皇都。\n舳舻岁转吴江远，日月天回碣石孤。\n莫问凄凉元季事，古今形胜仗吁谟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆祁仲绳","author":"叶春及","text":"河上游丝晴袅袅，忆君尊酒惜年华。\n西樵松桂还秋色，北阙风尘自暮笳。\n落日帆樯惟纵饮，避人江海且为家。\n忧时寄远俱无赖，肠断朱明一片霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀梁佥宪","author":"叶春及","text":"画戟青骢柏府尊，致身霄汉自高鶱。\n途泥愧我惟孤剑，岁月真谁可并论。\n天地只今长阒寂，酒樽何日共黄昏。\n东南鸿雁来应少，目断罗浮海上村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鳄湖道中","author":"叶春及","text":"鳄湖灯火杉篁夜，疋马寒嘶万木中。\n明月正悬淮上镜，怒涛先到涧边松。\n干戈满地风传角，堞垒连天野烧空。\n奔走不堪鸿雁里，岂缘行役限西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登飞来寺","author":"叶春及","text":"峡束滇江静不流，深藏绀殿对江幽。\n玉环洞杳风生树，金锁潭空月满舟。\n帝子南来山竹裂，仙人东去谷亭留。\n少年彩笔频经此，捧檄重游笑白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临湘驿忆曾明吾","author":"叶春及","text":"草际微凉过雨初，怀人山月到庭除。\n云长汉北随鸿雁，水满湖南断鲤鱼。\n芳树晚留逋客驾，皇华秋忆使臣车。\n菟裘暂别吾将老，前席须君待禁庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日学宪李万卿同男兆侄见过","author":"叶春及","text":"岁岁柴门长绿茵，少城元日到何人。\n忽传车马填三径，旋拂杯盘荐五辛。\n淝水阿玄新锡命，玉堂太白旧词臣。\n故人一去云霄迥，惟有春风伴葛巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]