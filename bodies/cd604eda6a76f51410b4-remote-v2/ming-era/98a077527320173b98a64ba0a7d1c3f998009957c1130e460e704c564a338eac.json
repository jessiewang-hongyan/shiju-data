[{"title":"云山人家","author":"曹义","text":"茆屋人家野山濆，迢迢苔径过桥分。\n日长车马浑无到，惟有青山带白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32523,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蒲萄为许信赋","author":"曹义","text":"西风窗户晚飕飕，架上蒲萄已熟秋。\n细数不过三十颗，争如一斗慱凉州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32524,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃花白头翁","author":"曹义","text":"何事幽禽也白头，多情想是为春愁。\n绯桃一树花开遍，啼断东风意未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32525,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅山茶","author":"曹义","text":"一枝娇艳雪中开，醉怯寒风傍腊梅。\n野鸟似怜春色好，繁华深处故飞来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32526,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和靖图为洪中书作","author":"曹义","text":"老鹤归来暮雪深，山童衣薄冷难禁。\n先生独淂梅花趣，坐拥双肩费苦吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32527,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆味道","author":"曹义","text":"一自衔哀别蓟门，几回惆怅叹鹤群。\n春风拟约寻诗伴，同上三茅看白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32528,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅为汤伯安赋","author":"曹义","text":"孤根几许托巅崖，个个疏花映水开。\n忆淂罗浮明月夜，梦中疑是玉人来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32529,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪梅为蔡宗濂作二首 其一","author":"曹义","text":"春动官桥雪未消，蹇驴随处探孤标。\n秪应误踏罗浮路，惊见仙娥整压翘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32530,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪梅为蔡宗濂作二首 其二","author":"曹义","text":"雪压冰枝冷不禁，寒香素影傍琼林。\n追思东阁清吟夜，月到纱窗玉漏深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32531,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为强德中题菊二首 其一","author":"曹义","text":"百般红紫尽离披，独有黄花晚节奇。\n几度醉扶筇竹杖，行吟拄月迥东篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32532,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为强德中题菊二首 其二","author":"曹义","text":"解组渊明鬓未霜，可怜三径渐荒凉。\n独馀晚节寒花在，几对清香醉夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32533,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画竹二幅为强德中赋 其一","author":"曹义","text":"此君标格本清真，惯历风霜不受尘。\n愧我平生心性廦，爱渠真节日相亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32534,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画竹二幅为强德中赋 其二","author":"曹义","text":"翛翛凤尾拂云长，翠色凉阴护石床。\n午醉醒来心似水，恍疑清兴落潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32535,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重九前二日思孟老亲送酒口号以荅其意","author":"曹义","text":"节近重阳菊未开，故人先遣白衣来。\n病馀正喜无灰酒，且对东篱进几杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32536,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题子陵垂钓","author":"曹义","text":"太史当年奏客星，恩深无计可逃名。\n从先不著羊裘去，钓得桐江□水清。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32537,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"时病初愈默坐中忽小童采芙蓉花一朵戏指索题遣怀","author":"曹义","text":"病起筠窗九月时，伤怀几度独支颐。\n芙蓉花发红如锦，老却秋光总不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32538,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画牛为汤伯安赋","author":"曹义","text":"怕向齐王堂下过，竟随牧竖度烟萝。\n时清贤俊俱登用，更有何人扣角歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32539,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘进学之宣州任小画","author":"曹义","text":"昔年玉署共遨游，此日分携计莫留。\n展卷题诗增叹息，一重云树一重愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32540,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小景四幅为竹鹤友人袁州何太守赋 其一","author":"曹义","text":"树底茅堂带远村，望中野色过桥分。\n携琴何处寻知己，拟约琳宫卧白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32541,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小景四幅为竹鹤友人袁州何太守赋 其二","author":"曹义","text":"孤舟晚泊水云乡，一枕南薰卧石床。\n残醉醒来凉雨后，忽惊渔笛在沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32542,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小景四幅为竹鹤友人袁州何太守赋 其三","author":"曹义","text":"江上芙蓉老素秋，西风乱飐白蘋洲。\n渔翁罢钓归来晚，一曲沧浪古渡头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32543,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小景四幅为竹鹤友人袁州何太守赋 其四","author":"曹义","text":"门外茫茫雪满天，江边寒压钓鱼船。\n先生独发清幽兴，郢曲高砍任醉眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32544,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋冬小画 其一","author":"曹义","text":"秋高老树半荒凉，篱下黄花晚独香。\n一自渊明归去后，几回对酒忆柴桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32545,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋冬小画 其二","author":"曹义","text":"门外青山尽白头，此时谁棹剡溪舟。\n先生独拥吟肩坐，应赋梁园兴未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32546,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为克让赋竹","author":"曹义","text":"忆我江南竹外居，几多苍翠荫窗虚。\n碧云风捲凉生后，曾借清阴画读书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32547,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈克让","author":"曹义","text":"几度都门送故人，每回时节倍伤神。\n驿亭杨柳秋狼藉，独有黄花带露新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32548,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题梅花","author":"曹义","text":"独逞幽姿冰雪中，不同桃李竞春风。\n莫言此日未成实，停看调和鼎鼐功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32549,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小画梅竹幽禽二首 其一","author":"曹义","text":"玉骨冰肌傲雪清，岁寒碧筱结同盟。\n幽禽也似怜芳质，故故飞来啄落英。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32550,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小画梅竹幽禽二首 其二","author":"曹义","text":"罗浮仙子脱尘缁，远访湘江鼓瑟妃。\n拟结岁寒冰霜操，不妨幽鸟占南枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32551,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅竹二首 其一","author":"曹义","text":"姑射仙人弄粉姿，此君相倚绿参差。\n啾啾何处飞来鸟，争占春风第一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32552,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅竹二首 其二","author":"曹义","text":"斜倚烟梢傍水涯，暗香疏影月明时。\n一团清气无人识，独有栖寒冻雀知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32553,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和韵题竹二首 其一","author":"曹义","text":"凤尾摇风翠雨寒，湘江云暗几千竿。\n扁舟记淂经过日，吟倚蓬窗醉后看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32554,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和韵题竹二首 其二","author":"曹义","text":"湘浦朝看宿雨晴，隔林犹听鹧鸪鸣。\n碧云风净凉生后，顿觉烦襟分外清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32555,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白鹦鹉","author":"曹义","text":"黑距黄冠玉雪姿，清时应效凤来仪。\n上林栖处饶丹荔，肯学鷡鹩恋旧枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32556,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋竹","author":"曹义","text":"梦忆湘江路渺漫，鹧鸪啼处碧云寒。\n澹烟疏雨孤舟晚，曾记推蓬醉后看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32557,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"海棠白头翁","author":"曹义","text":"独怜幽鸟有何愁，飞向花间也白头。\n应是春归留不住，东风啼断恨无休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32558,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅竹幽禽","author":"曹义","text":"陇梅花发雪晴时，独□疏篁晚色宜。\n何事幽禽不归去，应怜冰玉到寒枝。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32559,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻讣音后不入睡省口号","author":"曹义","text":"纱窗日上梦初醒，惊喜官闲志虑宁。\n记淂金门听漏日，几回和月候龙庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32560,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽老先生高味道之祖也时因过其家见壁上所题之诗故和其韵","author":"曹义","text":"翰墨淋漓色尚鲜，竟骑玄鹤上辽天。\n别来十载重相迥，读罢题文思惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32561,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆味道因窗外有蔷薇花一架故因起兴时永乐廿二年春三月也","author":"曹义","text":"满架蔷薇带露鲜，小窗相对暮春天。\n看花有忆同心友，尊酒孤吟思渺然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32562,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自述","author":"曹义","text":"乌纱玉佩锦衣鲜，待漏金门月满天。\n朝罢归来兮曙色，银鞍笑坐兴飘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32563,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中口号","author":"曹义","text":"十载编摩侍禁闱，一朝优诏许南归。\n春风满面欢无极，暂脱朝衣著綵衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32564,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蓬窗晓眺","author":"曹义","text":"蓬窗睡起春日晓，远山数点晴更好。\n白云飞处树依稀，紫翠空濛如可扫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32565,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过洪","author":"曹义","text":"徐州洪下吕梁洪，巨石飞涛势若舂。\n疏凿当年谁氏力，生民犹赖禹王功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32566,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过高邮湖是日烟雾望东岸彷佛如寺","author":"曹义","text":"野树茫茫夹岸斜，望中烟浪浩无涯。\n高低楼阁云深处，彷佛僧家与道家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32567,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送性初南还兼蕳诸故旧","author":"曹义","text":"宦游蓟北一年馀，每叹离群学业疏。\n传语江南诸故友，如何不寄半行书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32568,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送同年田进士","author":"曹义","text":"紫陌香尘荡绿漪，雨晴江上草离离。\n鸟啼花落□□□，□□行人肠断时。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32569,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬日独坐口号","author":"曹义","text":"木落林空风怒号，不堪寒雨苦潇潇。\n衡门镇日无人到，坐久吟怀转寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32570,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为汤靖题小景","author":"曹义","text":"门掩青山白昼閒，野云时逐鹤飞还。\n幽人话到忘机处，尘事纷纷总不关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32571,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题小画牛","author":"曹义","text":"草暖郊原老牸肥，牧童青笠绿蓑衣。\n想应耕罢东皋晚，急度河