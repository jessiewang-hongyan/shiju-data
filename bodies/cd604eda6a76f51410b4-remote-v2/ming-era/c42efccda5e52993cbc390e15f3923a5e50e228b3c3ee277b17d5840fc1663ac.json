[{"title":"春日山中寻泉","author":"李昌祺","text":"春泉试独寻，度壑复穿林。\n忽见流红远，方知入翠深。\n色浑因悟雨，声淡只宜琴。\n盥弄忘归去，穷源空有心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39424,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟唐塞下曲九首 其一","author":"李昌祺","text":"沙尘涨北天，卫霍出居延。\n苦雾埋沙碛，穷荒乏水泉。\n战酣鼙鼓壮，戍久铁衣穿。\n试上长城望，中原若个边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39425,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟唐塞下曲九首 其二","author":"李昌祺","text":"羽箭雁翎刀，风沙北地豪。\n弓开关月满，雕没阵云高。\n劲骑三边出，匈奴一夕逃。\n将军方得意，新拜玺书褒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39426,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟唐塞下曲九首 其四","author":"李昌祺","text":"十五去防秋，于今已白头。\n一身犹是卒，诸将久封侯。\n部伍嫌羸病，亲知识壮游。\n寒灯孤戍里，挥泪看吴钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39427,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟唐塞下曲九首 其五","author":"李昌祺","text":"久在边城里，风霜不可论。\n六亲皆骨朽，百战偶身存。\n烽燧连天暗，沙尘惮日昏。\n征人家万里，谁吊国殇魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39428,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟唐塞下曲九首 其六","author":"李昌祺","text":"犬戎窥近塞，羽檄发精兵。\n不识沙场苦，焉知性命轻。\n饥鹰投古垒，疲卒卧空营。\n日暮辕门里，愁听鼓角声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39429,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟唐塞下曲九首 其七","author":"李昌祺","text":"塞马啸悲风，旌旗惨澹中。\n卫青持左钺，李广在前锋。\n壮士俱亡命，朝廷重论功。\n将军承宠诏，天子锡新封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39430,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟唐塞下曲九首 其八","author":"李昌祺","text":"秋霜剑在腰，曾事霍嫖姚。\n诸将威无敌，全军气不骄。\n弓鸣惊过雁，炮响走栖貂。\n敢惮穷边苦，天家雨露饶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39431,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟唐塞下曲九首 其九","author":"李昌祺","text":"大漠阴山外，霜天气候殊。\n阴沙明远燐，寒日惨穷庐。\n北阙无来使，中原少得书。\n凯歌今未奏，壮士誓捐躯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39432,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病起遣兴","author":"李昌祺","text":"羸弱怯衣单，徐行觉尚难。\n平和欣脉复，疏懒喜身閒。\n古砚从教洗，孤琴久未弹。\n朝衣如可解，归去卧秋山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39433,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送人南归四首 其二","author":"李昌祺","text":"百年同旅寓，大半在殊方。\n白发羞明镜，青山问故乡。\n落霞秋水阔，新雁暮天长。\n安得随君往，溪南访草堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39434,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送人南归四首 其三","author":"李昌祺","text":"候馆停杯处，扁舟欲发时。\n归帆投远浦，斜日隐层陴。\n暑退秋来早，潮生月上迟。\n经行逢胜槩，都付酒兼诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39435,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜坐彭赞礼竹坞二首 其一","author":"李昌祺","text":"独坐依修竹，秋声近户多。\n疏钟清紫禁，凉露湿银河。\n野饭思薇蕨，儒衣想芟荷。\n小山招隐意，丛桂有遗歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39436,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜坐彭赞礼竹坞二首 其二","author":"李昌祺","text":"静夜凉风动，林疏宿鸟惊。\n玉绳低万户，银汉转三更。\n露重絺衣薄，香浮茗碗清。\n班姬纨扇曲，此际最关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39437,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送沈太守之云南","author":"李昌祺","text":"滇阳南望迥，五马引双旌。\n鸟道云边断，猿声月下清。\n黔江通远海，僰树拥孤城。\n已是诸侯贵，毋论万里行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39438,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送谢明府之桃源","author":"李昌祺","text":"楚地佳山水，桃源境更幽。\n汀兰行处采，湘水抱村流。\n门掩山城暮，蝉鸣驿树秋。\n昔人遗洞在，骑马一来游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39439,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"红叶","author":"李昌祺","text":"染树初凝茜，连林渐积丹。\n露丛消黛色，霜片妒朱颜。\n菊避重阳艳，花羞二月殷。\n娥眉争拾取，题字寄人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39440,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送周编修侄还文江","author":"李昌祺","text":"落景照离筵，华音促别弦。\n老亲长日念，游子几时还。\n玉雪中郎贵，青春小阮贤。\n重来拾瑶草，迟尔五云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39441,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王佥事之湖广","author":"李昌祺","text":"江汉维南纪，星辰近太微。\n地分方岳重，官到宪台稀。\n远水连秋阔，轻帆彻夜飞。\n人生骢马贵，好是绣为衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39442,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄刘三髦五首 其一","author":"李昌祺","text":"刘子穷经处，柴门野水滨。\n俗人那可到，往哲自相亲。\n道在宁论命，家空不叹贫。\n幽栖如可遂，迟子结南邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39443,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄刘三髦五首 其二","author":"李昌祺","text":"吾爱刘公子，浑如汉士风。\n古心真自得，高操更谁同。\n绿水溪边舫，朱弦膝上桐。\n我惭簪组累，不得远相从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39444,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄刘三髦五首 其三","author":"李昌祺","text":"濯足清潭里，移家碧涧边。\n非关傲轩冕，自是爱林泉。\n野鹤閒同往，溪云静与还。\n东山谢安石，何日起高眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39445,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄刘三髦五首 其四","author":"李昌祺","text":"才俊青云早，嗟君独出迟。\n宁甘身未达，不与世相知。\n霜月邻僧磬，凉风野客棋。\n怀人在天末，无地写幽思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39446,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄刘三髦五首 其五","author":"李昌祺","text":"剡书多日下，犹卧碧山隈。\n只叹相如病，空淹贾谊才。\n窗虚云自宿，门掩鹤初回。\n好在禾川上，应愁驿骑催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39447,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题世德楼","author":"李昌祺","text":"高楼无四邻，阑槛逼秋旻。\n创造怀先代，登临属后人。\n水云供远眺，山月共清贫。\n羡尔丘中士，云霄寄此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39448,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王知州赴禄劝","author":"李昌祺","text":"行尽天涯路，黔南尚几州。\n孤城藏万壑，残月在扁舟。\n剑阁云边断，巴江树杪流。\n两回经鸟道，应记旧曾游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39449,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送梁佥事还蜀二首 其一","author":"李昌祺","text":"腊尽催行色，天涯起别愁。\n暮云遮雨湿，寒水带冰流。\n鸟道青骢马，乌台紫豸裘。\n汉廷诸俊彦，风裁范滂优。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39450,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送梁佥事还蜀二首 其二","author":"李昌祺","text":"行人冒晓霜，白简绣衣裳。\n复任辞三殿，观风动一方。\n秋林黄叶暗，春水碧芹香。\n杜子留遗迹，烦君访草堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39451,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送刘教谕还沛县","author":"李昌祺","text":"相望浑未远，相会竟难常。\n交态贫如故，离情醉暂忘。\n淮流通海近，丰树入云长。\n羡尔官非贱，横经汉祖乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39452,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送人还永丰二首 其一","author":"李昌祺","text":"迢递京华道，萧条岁晏时。\n江风寒酿雪，淮水夜流澌。\n远浦帆来小，残钟乌去迟。\n泷冈天下重，欧子有穹碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39453,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送人还永丰二首 其二","author":"李昌祺","text":"腊尽促归桡，离魂黯欲消。\n故园频在望，知己邈难招。\n灯火江村市，梅花野岸桥。\n行边怜寂寞，况值雨萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39454,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送邓宗经还永新训导二首 其一","author":"李昌祺","text":"相逢疑是梦，乍见总堪怜。\n良会来天上，长贫在客边。\n青云违故旧，华发感流年。\n明发征帆去，依然各一天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39455,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送邓宗经还永新训导二首 其二","author":"李昌祺","text":"十载留京国，三年别故人。\n贾生犹未达，郑老尚居贫。\n灯火黉宫夕，菰蒲野水春。\n谁知他域别，凄断更伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39456,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄萧教谕三首 其一","author":"李昌祺","text":"见说昆山县，孤城在水乡。\n汐潮通海近，云树接吴长。\n夏暑圩田熟，秋阴学舍凉。\n年年春色里，桃杏烂宫墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39457,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄萧教谕三首 其二","author":"李昌祺","text":"县斋蒲苇里，鸥鹭与相亲。\n众水春环舍，孤峰晚对人。\n海鲜便久客，儒服称閒身。\n肯念同袍者，缄书莫厌频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39458,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄萧教谕三首 其三","author":"李昌祺","text":"身名俱未达，朋旧故应疏。\n多病惟高枕，何人慰索居。\n纵鳞思旷野，疲马倦长途。\n谁似儒官好，优游翰与觚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39459,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"耕乐亭二首 其一","author":"李昌祺","text":"孤亭临夐野，空阔四无邻。\n车马来游少，农夫就饷频。\n晴檐鸠唤雨，社瓮鸟啼春。\n窃禄真何补，投簪愧野人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39460,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"耕乐亭二首 其二","author":"李昌祺","text":"苔痕临水润，树叶近秋稀。\n细雨群农集，残阳一鸟归。\n村童收滞穗，野老候空扉。\n亦有躬耕意，青莎拟制衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39461,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送人还永丰三首 其一","author":"李昌祺","text":"君家簪绂裔，群从玉连枝。\n游子龙头贵，中郎燕颔姿。\n双尊论久别，千里慰遐思。\n六一遗风在，怀哉百世师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39462,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送人还永丰三首 其二","author":"李昌祺","text":"行李归期促，山川去路遥。\n疾风狂入夜，淫雨晦连朝。\n帆逐孤飞鸟，江通逆上潮。\n凭将栖遁意，乡国寄渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39463,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送人还永丰三首 其三","author":"李昌祺","text":"候馆促离杯，愁颜且强开。\n砌蛩惊露泣，巢燕避秋回。\n菊径深黄叶，衡门掩绿苔。\n缅怀西汉士，据地独奇才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39464,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊祀斋宿彭太常永年公署二首 其一","author":"李昌祺","text":"寂历容台署，高吟逸兴生。\n泉香春井溢，钟断夜堂扃。\n清漏随风度，流云傍月行。\n暂来犹爱此，住久转忘情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39465,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊祀斋宿彭太常永年公署二首 其二","author":"李昌祺","text":"竹静风停后，瓶香茗熟时。\n灯寒人未寝，露冷鹤偏知。\n颇爱良宵静，翻嫌白日迟。\n年年此斋宿，载诵我将诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39466,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"太庙孟秋时享同陆员外斋宿","author":"李昌祺","text":"槐露滴新秋，斋房夜色幽。\n罢琴期月上，捲幔见星流。\n池冷菰蒲静，窗寒竹树稠。\n清宵容易尽，香茗且淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39467,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"碧峰寺慎公房","author":"李昌祺","text":"碧嶂屏风秀，清流束带圆。\n烟霞醒醉梦，钟梵寤僧禅。\n乱叶当人落，孤云引鹤还。\n声闻如可契，应此息尘缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39468,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谢赐西洋布","author":"李昌祺","text":"异缕何纤细，轻盈玉雪紑。\n鲛宫初织罢，海国远输来。\n捧拜荣恩赐，纫缝称体裁。\n微躯增照耀，被服愧非才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39469,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹所二首 其一","author":"李昌祺","text":"何地偏多竹，翛翛庭院幽。\n夜凉难得月，雨过易成秋。\n不厌贫家看，那妨好客留。\n绿阴多处坐，疑泛渭川舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39470,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹所二首 其二","author":"李昌祺","text":"王子幽栖地，萧森修竹林。\n好风催布席，疏雨罢鸣琴。\n天籁醒尘梦，凉阴伴醉吟。\n几竿浑不俗，赖尔悦閒心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39471,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送曹判官苏州治水二首 其一","author":"李昌祺","text":"别驾之官日，都城欲夏过。\n一篷畿甸雨，双桨石湖波。\n郭外青山少，城边白水多。\n三吴民垫久，拯援术如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39472,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送曹判官苏州治水二首 其二","author":"李昌祺","text":"闻道姑苏郡，东南近海潮。\n圩田多夏潦，场圃减秋苗。\n平易遵前训，烦苛革旧条。\n更应持洁慎，玉帛此乡饶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39473,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏蝶","author":"李昌祺","text":"栩栩戏晴光，留连媚露香。\n舞随花片白，栖共柳丝黄。\n树杪莺捎急，帘间扇朴忙。\n南园芳草地，撩乱逐蜂狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39474,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寓舍梅一株翳榛莽中诗以唁之","author":"李昌祺","text":"筱蔓翳颓垣，娟然玉雪痕。\n寒香偏晚节，春色自名园。\n鸟啄梢头蕊，苔沿砌下根。\n犹能异桃李，不在狄公门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39475,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"席上赠妓","author":"李昌祺","text":"绾雾纤纤指，凌波小小莲。\n春山银烛下，秋水玉尊前。\n舞袖鸳鸯锦，歌珠玳瑁筵。\n座间俱狎客，惟属杜樊川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39476,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈生归吉水赤岸二首 其二","author":"李昌祺","text":"归心无日夜，孤舫不停牵。\n沙蟹寒缘草，江豚暝触船。\n银河通赤岸，翠壁泻红泉。\n莫恋幽居好，功名贵壮年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39477,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送周布政还河南","author":"李昌祺","text":"出镇名藩重，来朝异眷隆。\n残年将欲尽，知己忽相逢。\n泥淖梁园雨，埃尘艮岳风。\n旬宣如有暇，烦吊宋遗宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39478,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"灵谷寺","author":"李昌祺","text":"一径入青松，楼台峙化宫。\n雨深山果落，云去石床空。\n树老多巢鹤，潭清或见龙。\n上方禅寂地，暂得寄尘踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39479,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南溪书屋","author":"李昌祺","text":"松竹连村暗，轩窗面水清。\n藓痕留屐齿，滩响杂书声。\n行药因过寺，输租暂到城。\n静观簪绂累，还喜布衣轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39480,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张巡检之云南","author":"李昌祺","text":"弓剑巡荒徼，衣冠别上林。\n路经三峡险，人到百蛮深。\n枸酱谙夷俗，儿童解僰音。\n点苍山色古，道便一登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39481,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送人之京","author":"李昌祺","text":"上巳风光好，新晴物色妍。\n青山林下屋，绿水镜中船。\n节换榆烟火，花残谷雨天。\n壮游逢胜景，况觐五云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39482,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈郎中重使西域十首 其一","author":"李昌祺","text":"九重辞凤阙，千骑度龙荒。\n宝剑悬秋水，珠袍照雪霜。\n泉源随地少，沙碛亘天长。\n人羡皇华使，谁知粉署郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39483,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈郎中重使西域十首 其二","author":"李昌祺","text":"天使下边州，青丝控紫骝。\n风云随节旆，雨露到毡裘。\n斜日羌城晚，微风塞草秋。\n壮心知未已，万里快重游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39484,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈郎中重使西域十首 其三","author":"李昌祺","text":"逐水安营晚，鸣笳渡碛迟。\n穹庐无旧馆，行卷有新诗。\n骏骨天生马，奇毛地产狮。\n蕃酋迎候处，一曲汉歌词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39485,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈郎中重使西域十首 其四","author":"李昌祺","text":"叠鼓杂鸣笳，天风送使槎。\n内臣金镂带，壮士铁为檛。\n去路缘青海，行营驻白沙。\n单于争慕义，不用李轻车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39486,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈郎中重使西域十首 其五","author":"李昌祺","text":"骊马紫金环，行行出玉关。\n悬河三寸舌，积雪万重山。\n旗影连云卷，弓弦向月弯。\n封侯儒者事，天子待君还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39487,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈郎中重使西域十首 其六","author":"李昌祺","text":"大漠连川远，行人去国遥。\n乌孙遗种在，狼望旧名消。\n夜雪戎王帐，秋风使者轺。\n悬知专对好，谈笑款天骄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39488,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈郎中重使西域十首 其八","author":"李昌祺","text":"地势三城远，河源二水分。\n火山稀好雨，盐泽足寒云。\n雕没平沙外，驼鸣古涧濆。\n凭高时引睇，何处是中原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39489,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送李生还安城","author":"李昌祺","text":"北蓟辞严父，南京别故人。\n一身勤远道，千里念慈亲。\n柳暗江城晓，萍香野岸春。\n灯花先报喜，应更倚门频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39490,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南京送高教授赴选 其一","author":"李昌祺","text":"卿家本同郡，客路又离群。\n夜柝敲寒月，霜钟度暝云。\n征袍迷草色，古屿带潮痕。\n寥落分携处，秋鸿不可闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39491,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南京送高教授赴选 其二","author":"李昌祺","text":"共是浮萍迹，偏怜鬓易新。\n江湖留滞久，朋旧别离频。\n试数中朝士，应多故里亲。\n莫嫌毡独冷，年纪政青春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39492,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]