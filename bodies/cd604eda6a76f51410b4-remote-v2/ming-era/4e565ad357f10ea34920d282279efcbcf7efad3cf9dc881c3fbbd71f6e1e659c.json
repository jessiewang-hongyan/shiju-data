[{"title":"舟中","author":"鲍楠","text":"野渡溶溶春水，夕阳点点寒鸦。\n欸乃数声何处，行人一棹天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11977,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵杨柳枝词 其一","author":"杭济","text":"玉沟萦绕水烟凉，嫩叶垂垂窣地长。\n百尺宫墙遮不尽，飞花犹自入昭阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11978,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵杨柳枝词 其二","author":"杭济","text":"东风袅袅拂朱阑，万树千条露未干。\n玉涘声中人不见，倚楼烟雨正春寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11979,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送徐石东佥宪湖南分题得潇湘","author":"杭淮","text":"潇湘他日梦，今上合江亭。\n天阔浮吴楚，山青入洞庭。\n鹧鸪春渺渺，斑竹雨冥冥。\n舟楫云中见，依稀帝子灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11980,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闲居漫兴五首 其一","author":"浦瑾","text":"草堂幽事许谁分，石鼎茶烟隔户闻。\n长日如年双燕睡，晴风似酒百花醺。\n软莎新步青丝履，浓墨闲书白练裙。\n稍待溪南荷芰满，扁舟十里看红云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11981,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闲居漫兴五首 其二","author":"浦瑾","text":"雨熟枇杷树树香，绿阴如水昼生凉。\n客疏却喜阶苔厚，身懒初便簟竹光。\n阳羡紫茶团小月，吴江白苎剪轻霜。\n投壶散帙还随意，消得人间白日长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11982,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闲居漫兴五首 其三","author":"浦瑾","text":"此身闲外复何求，长日安居事事幽。\n隔竹敲茶妨鹤梦，临池洗墨戏鱼浮。\n风牵翠带翻阶草，雨湿红绡落海榴。\n散尽飞虫生晚色，月明已上水东头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11983,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闲居漫兴五首 其四","author":"浦瑾","text":"高梧树下足凉风，满地清阴一亩宫。\n阶战闲看排阵蚁，檐喧静觅课衙蜂。\n日斜天外初微雨，云薄楼西忽断虹。\n客至莫谈尘底事，年来多病耳初聋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11984,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闲居漫兴五首 其五","author":"浦瑾","text":"南里桥东一草堂，乌皮隐几竹方床。\n池萍涨雨青浮岸，邻树分阴绿过墙。\n乳燕出时炊麦熟，茧蛾飞后曝丝香。\n不知何处炎蒸在，日日清风洒葛裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11985,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闲居漫兴十首 其一","author":"李东阳","text":"此日真何日，阴云掩上台。\n晦冥天色变，呜咽水声哀。\n旧恨齐山岳，遗恩遍草莱。\n万方同一恸，痛哭转成雷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11986,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闲居漫兴十首 其二","author":"李东阳","text":"圣德同天纵，皇图与日升。\n乾维中断绝，坤轴乍崩腾。\n辇盖辞双阙，河山护六陵。\n生成真罔报，攀送竟何能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11987,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闲居漫兴十首 其三","author":"李东阳","text":"恭己同虞帝，祇台比夏王。\n内廷无女谒，外囿绝禽荒。\n富有天和养，终期历数长。\n彼苍何弗吊，民物共摧伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11988,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闲居漫兴十首 其四","author":"李东阳","text":"圣道通三极，王言似六经。\n面开天日表，书作虎龙形。\n杞国忧方剧，华胥梦不醒。\n万年金匮在，遣训炳丹青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11989,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闲居漫兴十首 其五","author":"李东阳","text":"鹤发承颜日，龙楼问寝辰。\n宁宫同奉养，九庙极精禋。\n孝可通金石，诚能动鬼神。\n徽称高万代，垂宪及千春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11990,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闲居漫兴十首 其六","author":"李东阳","text":"畎亩苍生念，闾阎白屋情。\n览章时昃日，露祷必深更。\n岁旱忧疑狱，天寒悯戍兵。\n尚遗宽恤诏，朝野共吞声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11991,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闲居漫兴十首 其七","author":"李东阳","text":"极意穷幽隐，虚怀仰治平。\n近臣常造膝，阁老不呼名。\n道合君臣义，恩深父子情。\n化机元不偶，天意竟何成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11992,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闲居漫兴十首 其八","author":"李东阳","text":"玉几终宵坐，彤闱彻晓通。\n孙谋思祖训，家教托储宫。\n天语丁宁际，龙颜仿像中。\n此身真隔世，地下倘相从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11993,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闲居漫兴十首 其九","author":"李东阳","text":"海宇熙平日，乾坤梦幻间。\n虹流始华渚，龙卧已桥山。\n尧荚惊新换，湘筠忆旧斑。\n翠华天上去，无路可追攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11994,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闲居漫兴十首 其十","author":"李东阳","text":"灵驾归何处，茂陵西更西。\n日轮埋地轴，云路隔天梯。\n月迥鸣鉴静，山围簇仗齐。\n玄宫松柏里，赡望转凄迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11995,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南京谒孝陵有述","author":"李东阳","text":"礼乐千年会，腥膻四海空。\n商周终愧德，唐汉敢论功。\n凤历归真统，龙山绕旧宫。\n秋风霸陵树，落日鼎湖弓。\n万国讴歌在，余生覆载中。\n小臣瞻拜地，江汉亦朝东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11996,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"重谒孝陵有述","author":"李东阳","text":"龙虎诸山会，车书万国同。\n星躔环斗极，王气绕江东。\n地涌神宫出，桥分御水通。\n丹炉晨隐雾，石马夜嘶风。\n日月无私照，乾坤仰圣功。\n十年瞻望地，云树郁葱葱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11997,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"胡忠安公挽诗（四十韵）","author":"李东阳","text":"文庙临朝日，英皇复辟年。\n我公台鼎贵，臣职始终全。\n旧锡恩荣榜，仍居侍从员。\n皂囊繁出入，彤陛俨周旋。\n扰扰群疑会，皇皇《四牡》篇。\n路应穷地轴，岁屡变星躔。\n晓谒班留笋，宵归炬拥莲。\n至今天上语，不遣外人传。\n少海惊波定，金縢密疏虔。\n论功同李泌，辱命岂张骞。\n南国非旁郡，东僚亦左迁。\n献陵贻睿想，宣室问遗贤。\n典礼烦咨岳，为舟亿济川。\n庙廊资治理，帷幄赞兵权。\n讨逆东平汉，从征北过燕。\n从容陈俎豆，谈笑却戈鋋。\n仗钺风尘际，留司雨露边。\n两曹兼掌握，三少累登延。\n紫诏蛟龙织，珍羞玳瑁筵。\n篆分银印细，花簇锦袍鲜。\n棨戟城西第，桑麻海上田。\n云霄三接近，优遇一时专。\n绿野家山在，丹心圣主怜。\n挂冠双凤阙，归棹五湖船。\n老子元知足，陶朱不爱钱。\n弟兄头总白，宾客户常阗。\n面受娄公唾，身无董氏弦。\n恩鱼随网散，驯犬上阶眠。\n碑板寻常见，医方次第诠。\n瓮留京口酿，瓶引惠山泉。\n寿恺堂何愧，忠安谥有焉。\n相台秋正坼，卿月夜虚圆。\n异骨殊凡品，前身本解禅。\n浮生过九十，空界出三千。\n海内文章伯，人间富贵仙。\n姓名儿女说，簪笏子孙联。\n桃李当时盛，葭莩后代连。\n高山嗟仰止，先辈已茫然。\n日月居诸里，江湖涕泪前。\n赋诗裨国史，讵有笔如椽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11998,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"立春日车驾诣南郊","author":"李东阳","text":"暖香和露绕蓬莱，彩仗迎春晓殿开。\n北斗旧杓依岁转，南郊佳气隔城来。\n云行复道龙随辇，雾散仙坛日满台。\n不似汉家还五畤，甘泉谁羡校书才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11999,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元日早朝","author":"李东阳","text":"九门深掩禁城春，香雾笼街不动尘。\n玉帐寒更传虎卫，彤楼晓色听鸡人。\n帘前乐应红灯起，阶下班随彩仗陈。\n朝散东华看霁日，午烟晴市一时新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12000,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪后早朝","author":"李东阳","text":"六日长安雪满城，五更钟鼓一时晴。\n冰精宫冷云犹冻，鳷鹊楼高月正明。\n朝马不嘶金勒静，院灯无影玉堂清。\n只应天上寒如许，怪底人间梦不成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12001,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元日早朝","author":"李东阳","text":"紫殿朱阑白玉坡，天风吹乐下云和。\n城头星斗知春早，苑外旌旗拂曙多。\n龙集载看新岁纪，凤池初暖旧恩波。\n拟将无逸陈周戒，咫尺君门奈远何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12002,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊祀喜晴有述","author":"李东阳","text":"碧消烟尽露华凝，目极瑶坛第九层。\n清佩缓随驰道月，绛笼高应午门灯。\n风传广乐声初下，天近燔柴气已升。\n人意可占神意悦，万年灵祚永堪膺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12003,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十八日听传胪有作","author":"李东阳","text":"金莲影与赭袍明，华盖前头次第行。\n黄纸数行丹诏字，鸿胪三唱甲科名。\n云边晓日中天见，梦里春雷昨夜声。\n归向长安听人语，圣朝罗网尽豪英。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12004,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十九日恩荣宴席上作","author":"李东阳","text":"队舞花簪送酒频，清朝盛事及嘉辰。\n星辰昼下尚书履，风日晴宜进士巾。\n围撤汉科三日战，苑看唐树九回春。\n丹心未老将头白，犹是当年献策身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12005,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赐藕","author":"李东阳","text":"只向名花看画图，忽惊仙骨在泥涂。\n轻同握雪愁先碎，细比餐冰听却无。\n郭北芳菲怀故里，江南风味忆西湖。\n渴尘此夜消应尽，未羡金茎与玉壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12006,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"院中即事","author":"李东阳","text":"砚冰呵墨印开封，独坐高檐落叶中。\n筹唱有声催短日，氅披无力御长风。\n羸骖向晚还思秣，老鹤惊寒欲唳空。\n遥羡玉堂诸院长，酒杯能绿火能红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12007,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"分献次青溪太宰韵（时青溪分得星辰二，是日立春）","author":"李东阳","text":"星坛对立本联班，复磴凭空不易攀。\n良久夜方移斗柄，早时春已到人间。\n朱旗影隔天门静，玉佩声随阁道还。\n旧日同年今并命，共从光霁识威颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12008,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"斋居和舜咨侍读院署见寄韵","author":"李东阳","text":"绿槐庭馆坐春风，十九年前此兴同。\n未老身犹书卷里，不眠人在漏声中。\n大鹏南去云连海，群鹤西飞日绕空。\n灯火忆君连夕话，不胜幽思满斋宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12009,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"斋和居世赏编修韵","author":"李东阳","text":"半夜开门雪满坡，清吟无奈玉人何。\n人间路与红尘隔，天上春随翠辇过。\n灵吹下时神语寂，琼楼高处晓寒多。\n笙箫本是虞廷乐，不为秋风遣棹歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12010,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"大行皇帝挽歌辞二首 其一","author":"李东阳","text":"北阙南都象镐丰，我皇身自际时雍。\n只应龙种如高帝，何止虹髯似太宗。\n草木有情皆长养，乾坤无地不包容。\n因思二十年前事，长蹑仙班侍九重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12011,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"大行皇帝挽歌辞二首 其二","author":"李东阳","text":"圣朝偃武修文日，共道王言似六经。\n宋史重施新衮钺，孔庭增饰旧笾铏。\n垂衣共仰升龙象，赐墨皆成翥凤形。\n回首茂陵松柏树，春来还向裕陵青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12012,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五月七日泰陵忌晨二首 其二","author":"李东阳","text":"曾上銮坡侍玉堂，朝衣新惹御袍香。\n传宣暖阁天颜近，奏近年台午漏长。\n化国有人悲短梦，幽都无地仰余光。\n从容顾命分明语，一日伤心泪万行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12013,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答奚元启次韵","author":"李东阳","text":"诗老龙门昼不关，东坛西社几人还。\n看君秃笔何曾住，笑我高眠尽日闲。\n实怕行尘多似雨，更怜官马瘦如山。\n无因一见春风面，空把清诗对病颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12014,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"黄土道中李员外同年留宿","author":"李东阳","text":"雨澹荒溪野水昏，萧条鞍马入空村。\n平沙问渡逢渔子，深树闻钟隔寺门。\n白饭青刍非旧主，细泉嘉果得名园。\n东曹一榻分灯意，夜下虚庭白露繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12015,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九峰书屋和曹时和韵","author":"李东阳","text":"江上草亭新卜筑，已闻扬子著书成。\n每逢社日聊随俗，久住青山却有情。\n霜入晚松经岁老，雨繁春笋过邻生。\n小堂若许临江阁，杖屦无须匹马迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12016,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵答邵户部文敬","author":"李东阳","text":"葛巾芒屦坐题诗，只欠江边一钓丝。\n药检旧囊书欲遍，梦回春枕事多遗。\n人情更与新年别，草色宁知要路私。\n独在卷帘深处望，西山无数雨晴时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12017,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和若虚郎中赠行韵","author":"李东阳","text":"赤日黄尘马倦行，石桥山店有官程。\n城头路尽千峰隔，袖里诗来两腋清。\n蝉杂柳风秋渐远，鹤翻松露夜还惊。\n欲知小吏将诗意，记取柴门剥啄声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12018,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与顾天锡夜话和留别韵（时天锡谪永州府同知）","author":"李东阳","text":"路转三湘去更深，潞河西岸浙东浔。\n潜鳞自足波涛地，别马长怀秣饲心。\n湘女庙前山似黛，柳公亭下石如林。\n征科亦是公家事，民力江南恐未禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12019,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和韵寄答陈汝砺掌教","author":"李东阳","text":"寂寞天涯叹所依，海风江月意俱违。\n茱萸岁改身仍健，苜蓿秋荒马不肥。\n白雪屡传新调寡，青云半觉旧人非。\n家山不隔长安路，应倚南楼望夕晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12020,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游城西故赵尚书果园与萧文明李士常陈玉汝潘时用倡和四首 其一","author":"李东阳","text":"漫忆江湖万里游，西园风景似南州。\n青苔地湿频经雨，白苎凉生不待秋。\n尘事已醒前日梦，岁华空白几人头。\n松醪载得浑拚醉，莫遣飞花浪作愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12021,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游城西故赵尚书果园与萧文明李士常陈玉汝潘时用倡和四首 其二","author":"李东阳","text":"官曹无计可招寻，坐爱林风满素襟。\n醉后颇思醒酒石，贫来须办买山金。\n花蹊柳径稀疏见，茗碗冰壶次第斟。\n欲问五陵歌舞地，几家园树得成阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12022,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游城西故赵尚书果园与萧文明李士常陈玉汝潘时用倡和四首 其三","author":"李东阳","text":"句入西园字字清，葛衣纱帽称闲行。\n苔侵翠壁应全遍，果熟青林已暗生。\n流水断堤人共远，片云孤鸟意俱轻。\n闲官爱说山中话，为有归田录未成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12023,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游城西故赵尚书果园与萧文明李士常陈玉汝潘时用倡和四首 其四","author":"李东阳","text":"残樽系马立斜阳，忽送秋声满树凉。\n花落始知留客久，雨来偏为作诗忙。\n山堂竹户寒犹闭，石径苔泥滑不妨。\n独有园人爱沾洒，不随僮仆问归装。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12024,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"予素不善饮文明诗来有西涯烂醉欲人扶之句且以二樽见惠步韵答之","author":"李东阳","text":"梦断高阳旧酒徒，坐惊神语落虚无。\n若教对饮应差胜，纵使微醺不用扶。\n往事分明成一笑，远情珍重得双壶。\n次公亦是醒狂客，幸未粗豪比灌夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12025,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮士常新居和席上联句韵","author":"李东阳","text":"寂寞官曹似隐居，清风时动一床书。\n花应旋种栏将满，客不频来席尚虚。\n诗好忽惊传锦字，酒狂真欲换金鱼。\n多情愧有东邻卜，已办城西款段车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12026,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游白秉德西园次韵","author":"李东阳","text":"行逐溪流过野亭，望疑山色绕空冥。\n池鱼自跃非因饵，园蝶还飞不受扃。\n傍渚幽花怜寂寞，舞风疏柳爱娉婷。\n郎君门地清如水，不待平泉石已醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12027,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵体斋病起见寄","author":"李东阳","text":"坐倚孤筇卧拥衾，重门未放野寒侵。\n疑蛇已辨杯中影，病鹤长怀海上心。\n诗券负来应渐释，方书验后懒重寻。\n灯前细认银钩笔，不待平安报好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12028,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪后饮胡彦超冬官归叠席上韵","author":"李东阳","text":"马蹄冲雪叩君门，坐爱飞花扑酒尊。\n帘未卷时先作阵，屐曾来处已无痕。\n寒檐叶落蛛丝堕，老树巢倾鹤梦翻。\n今夕定知何夕是，好风明月未堪论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12029,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王世赏韵","author":"李东阳","text":"石门惟许白云留，我亦何心恋此游。\n竹里行厨烟未午，水边萧寺叶先秋。\n行贪觅句忘吹帽，醉怯登高不上楼。\n诗景满前谁会得，野僧名是远公流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12030,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"邵东曹堕马伤足次武昌韵","author":"李东阳","text":"十年双足躏词场，我亦怜君坠后伤。\n历块敢夸千里俊，乘船翻笑四明狂。\n扶颠老仆空随路，学仆娇儿更倚堂。\n应似崔家亭下鹭，独拳秋雨向寒塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12031,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵贺彭阁老先生二首 其一","author":"李东阳","text":"吏部衔清带翰林，路随仙步转高深。\n人间别有登云地，天下空劳仰斗心。\n瀛海新波添夜雨，玉堂乔木长春阴。\n归来更觉门如水，不受车尘半点侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12032,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵贺彭阁老先生二首 其二","author":"李东阳","text":"半生名行重儒林，吏隐官曹岁月深。\n文靖旧无旋马地，敏中元有耐官心。\n川原暖入三春雨，殿阁凉分六月阴。\n欲效禹称书院壁，向来官序敢相侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12033,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵答愧斋先生","author":"李东阳","text":"历历星霜岁屡移，病来双鬓几茎丝。\n故人别久翻疑梦，往事心劳尚有期。\n天上浮云初变日，江南芳草未青时。\n只应千里神交地，不识人间是路歧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12034,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵寄题镜川先生后乐园二首 其一","author":"李东阳","text":"药栏花圃背堂开，一日朝回几度来。\n范老心终念廊庙，寇公家不起楼台。\n海边钓石鸥盟远，松下棋声鹤梦回。\n多少旧题诗句在，碧纱笼底认青苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12035,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵寄题镜川先生后乐园二首 其二","author":"李东阳","text":"绿阴繁处小堂开，野蝶园蜂自去来。\n细草有情双驻屐，远山无数一登台。\n幽花坐爱栽时满，俗客空教到后回。\n病起三年犹未赏，短垣多雨长莓苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12036,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次夏提学韵","author":"李东阳","text":"衣袖归时雨尽沾，卧闻凉叶响虚檐。\n鸟情幽寂将依树，苔意夤缘欲上帘。\n静里只应闲尚在，病来长与懒相兼。\n读书自笑成何事，细取虫鱼几字添。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":12037,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]