":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1059,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日杂兴十五首 其十四","author":"何景明","text":"鱍鱍鲤鱼三尺身，纤鳞照水白如银。\n未须更论成龙势，只在溪中亦有神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1060,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日杂兴十五首 其十五","author":"何景明","text":"竹静沙寒野日低，门前秋草不成蹊。\n山禽汝亦何多事，来向棠梨树上啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1061,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鸡鸣曲三首 其一","author":"何景明","text":"鸡鸣城中满树霜，青楼旭日照流黄。\n鸣筝锦瑟秋尘里，玉雁金蝉共一行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1062,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鸡鸣曲三首 其二","author":"何景明","text":"青楼遥临大道衢，美人鸡鸣著绣襦。\n谁家公子过楼下，那不系尔千金驹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1063,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鸡鸣曲三首 其三","author":"何景明","text":"楼上罗帏映早霞，不须重斗镜中华。\n春兰秋菊皆零落，争似菖蒲不作花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1064,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜戴仲鹖得乡荐二首 其一","author":"何景明","text":"梁园未苑却宜秋，夹道槐花照绮楼。\n试问东瀛海边住，何如金明池上游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e0