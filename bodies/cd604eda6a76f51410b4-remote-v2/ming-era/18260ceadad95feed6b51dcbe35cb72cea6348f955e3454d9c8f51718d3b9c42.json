[{"title":"雨雪歌","author":"何景明","text":"千岩云电烈，万室风霆翻。\n中宵雨撼壁，平明雪满山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1003,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小景四首 其一","author":"何景明","text":"楼阁倚江滨，桃花照暮春。\n安知看花者，不是武陵人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1004,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小景四首 其二","author":"何景明","text":"草阁散晴烟，柴门竹树边。\n门前有江水，常过打鱼船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1005,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小景四首 其三","author":"何景明","text":"煦日枫林赤，含风菊蕊黄。\n家家白酒热，何处过重阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1006,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小景四首 其四","author":"何景明","text":"远岸冻云落，高林寒日斜。\n前村昨夜雪，闻说有梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1007,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄李献吉二首 其一","author":"何景明","text":"君作梁园客，予登楚水台。\n春风河上柳，不寄一枝来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1008,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄李献吉二首 其二","author":"何景明","text":"渭水天边树，黄河日暮流。\n春来千里外，知尔故乡愁。","collection":"明","notice":"","provenance":{"r