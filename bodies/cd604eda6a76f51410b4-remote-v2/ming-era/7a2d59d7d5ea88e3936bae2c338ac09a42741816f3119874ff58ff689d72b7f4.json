[{"title":"钟山僧寺赓单仲右韵 其一","author":"朱元璋","text":"游山必是叩僧禅，闻说神僧透宿缘。\n山果玄猿摇绿树，方知入定是金仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53322,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钟山僧寺赓单仲右韵 其二","author":"朱元璋","text":"精蓝幽谷寺嵯峨，风过松声韵碧波。\n寂寞出尘天外景，骅骝杂遝意奚何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53323,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钟山僧寺赓单仲右韵 其三","author":"朱元璋","text":"山势崚嶒谷隐僧，六通具足势层层。\n鹊巢冠顶忘机处，午夜明星识已能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53324,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞舄化鸟","author":"朱元璋","text":"幻化由来显妙工，幕天席地自从容。\n还知飞舄成双鸟，犹且同尘入宦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53325,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仙人","author":"朱元璋","text":"仙人鹤背几经秋，神出尘寰宇宙游。\n铁笛横吹天地外，肯将精气浑汹俦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53326,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天界寺春雀","author":"朱元璋","text":"春风夜雨沐花妍，晓霁檐前雀噪喧。\n孰谓可知机里事，飘然翕翮舞长天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53327,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赓玘太朴韵","author":"朱元璋","text":"花逢雨夜晓看妍，实蕊凋时阶不喧。\n试问老禅幽得处，谓言物外有青天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53328,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"神乐观道士","author":"朱元璋","text":"闻说仙人岂等闲，年年辟谷炼金丹。\n虚心尽却玄中览，特假弦歌谒帝坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53329,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏菊花","author":"朱元璋","text":"百花发时我不发，我若发时都嚇杀。\n要与西风战一场，遍身穿就黄金甲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53330,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"示僧谦牧","author":"朱元璋","text":"寄与山中一老牛，何须苦苦恋东洲。\n南蛮有片荒草地，棒打绳牵不转头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53331,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"征陈至潇湘","author":"朱元璋","text":"马渡沙头苜蓿香，片云片雨过潇湘。\n东风吹醒英雄梦，不是咸阳是洛阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53332,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"不惹庵示僧","author":"朱元璋","text":"杀尽江南百万兵，腰间宝剑血犹腥。\n山僧不识英雄汉，只恁哓哓问姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53333,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"永虹霓","author":"朱元璋","text":"谁把青红线两条，和云和雨系天腰。\n玉皇昨夜銮舆出，万里长空驾玉桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53334,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏雪竹","author":"朱元璋","text":"雪压竹枝低，虽低不著泥。\n明朝红日出，依旧与云齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53335,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春吟","author":"李弃","text":"东风吹我衣，不能开我眉。\n何曾如草木，动辄得芳菲。\n有葽皆秋气，无声不子规。\n踏青驱拄杖，席地误沾泥。\n呼仆抬愚谑，过僧值掩扉。\n会心行到且，疏雨促人归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53336,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登来熏楼","author":"叶元玉","text":"绝顶南山上，斯楼亦壮哉！\n群峰排戟立，一水抱城来。\n地利虽云险，人心未可猜。\n若非得良牧，剑阁也罹灾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53337,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东华翠嶂","author":"叶元玉","text":"出郭相将二里赊，寺钟鸣处是东华。\n直跻绝顶三千仞，俯视平原几万家。\n流水竟朝东海去，长安不受片云遮。\n风流自笑非安石，也有登山兴未涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53338,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游金莲寺","author":"叶元玉","text":"金莲山寺万松阴，流水花开自古今。\n几发青螺撑佛顶，半岩秋月印禅心。\n满天风雨龙归洞，入座笙歌鸟隔林。\n骏马神鹰无觅处，一声鸡犬在云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53339,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏东华翠嶂","author":"伍堣","text":"东华高嵯峨，幽胜冠今古。\n禅房卧白云，籁空静尘土。\n悬壁削芙蓉，丹枫衬红雨。\n竹月粘碎金，松风集鸣杵。\n一涧玉龙嘶，千仞飞鸟舞。\n翠色摇沧溟，雄螺跨天府。\n岩花染素流，秋月漾寒渚。\n有客邀我游，扪萝觅仙侣。\n八竑壮胸襟，万山攀石许。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53340,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登屏山","author":"伍堣","text":"亭亭溪北倚危峰，景色看来淡又浓。\n红树晓闻金翡翠，白云秋叠玉芙蓉。\n桥边溪月穿疏竹，雪里梅花间古松。\n闲对此山扪虱坐，一声孤鹤入高空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53341,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观澜亭","author":"伍堣","text":"一亭雄丽倚溪头，拭目危栏几度秋。\n元气不停天地脉，化机无息古今流。\n星疏水国河图出，月印潭心太极浮。\n老我望洋成一笑，羞将经史卧沧州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53342,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上东华咏蝉","author":"伍堣","text":"蝉若与山深，深山不可寻。\n鸣虽应以候，听亦岂无心？\n日暮林中送，人间枕上吟。\n岂惟处暑至，对此自沉沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53343,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿南极山","author":"裴应章","text":"老兴少年同，寻芳二月中。\n桃花红落雨，杨柳绿摇风。\n泉连琴书润，云深榻几笼。\n论心贪夜话，不觉晓鸣钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53344,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆磊园山居明","author":"李于坚","text":"岸回千路合，枫夹大江寒。\n梳土通云气，删苗入药栏。\n蕉衣长受墨，笋箨落为冠。\n静了花间事，看舟渡石盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53345,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏读书庄","author":"杨士奇","text":"清流城北读书庄，旧隐诗书岁月长。\n玉署归来春昼永，松门流水落花香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53346,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渔沧亭诗","author":"曹学佺","text":"我来患暌隔，唯子为好仇。\n禊事期云愆，于兹亦可修。\n危亭俯溪上，溪水傍城流。\n白沙映如玉，绿草披若油。\n濯绥垢既逝，行觞数亦周。\n渔父不可见，垂钓空沧州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53347,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赞雁塔晓钟","author":"赖世隆","text":"早鸡声里听钟鸣，映起当年野老情。\n林外月斜敲正急，山中露冷韵偏清。\n客船夜泊愁惊梦，官署辰衙喜报晴。\n我有新诗寄僧壁，纱笼却笑宋人赓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53348,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九龙行","author":"赖世隆","text":"九龙之险无与比，江淮河汉风波耳。\n岂如此水怪石多，朝夕无风浪自起。\n天开地辟几春秋，何人凿空先泛舟。\n畏途一开不可塞，至今来往行人愁。\n乘风鼓棹碧潭心，喧天万壑隐雷鸣。\n日色无光昼如夜，忽忽孤蓬一叶轻。\n峡口初过第一龙，禹门吕梁高更雄。\n船从天上直坠地，回头白雪翻晴空。\n第二龙中长且大，狂澜骇浪争澎湃。\n前呼后应疾若飞，生死须臾不停待。\n三龙乍过四龙还，鲸波拂面舟人惊。\n欲寻小径避险阻，倚天峭壁难飞腾。\n五龙曲折忧回舵，六龙峻濑防危祸。\n乱涛势合如山来，船从水底钻将过。\n急流数里诣七龙，俗传压怪留神踪。\n莫云此龙易与耳，前后复溺在眼中。\n八龙崎岖犹是畏，浪高石大难回避。\n九龙出峡且安行，维丹岸下如更生。\n相对斜阳须畅饮，梦魂半夜犹频惊。\n起来四望远山色，龙里月沉云气黑。\n经过历历皆可陈，悔将微躯临不测。\n九龙之险甲九州，瞿塘滟滪如安流。\n自笑好奇穷涉览，诗成空说鬼神愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53349,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"官坊洞","author":"叶宫桃","text":"古洞傍溪头，突兀真奇迹。\n门前萝薛深，阴阴入路窄。\n白昼飞晴云，滴沥泻山液。\n空响撼轰雷，坐蹬润苍壁。\n四壁烟云象，玲珑如刻画。\n再从深处寻，晞微光照隙。\n寒生流水声，听久清魂魄。\n未审荒村中，灵秘自谁辟？\n胜境不知名，沉晦良可惜。\n吁嗟乎人生，遁迹亦同然！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53350,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吊裴尔成","author":"李弃","text":"几年同笔砚咿唔，醴酒频供我湎濡。\n醉里妄言始妄听，醒时庄语识庄图。\n丝从渐染分黄黑，眼眩苍暝混雁凫。\n世人结交云雨幻，三人臭味若生无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53351,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广琴操十首 其一 将归操","author":"朱右","text":"河之深兮，谁将厉之。\n河之浅兮，谁将揭之。\n河洋洋兮，不我济之。\n竭泽以渔兮，蛟龙辟之。\n覆巢夭胎兮，凤凰去之。\n夫人有知兮，予实类之。\n九州博大兮，将予遂之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53352,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广琴操十首 其二 猗兰操","author":"朱右","text":"习习谷风，以阴以雨。\n岩穴幽阻，谁其晤语。\n猗兰之芳，煜煜其光。\n不我佩服，昊天孔明。\n子如好修，维我之求。\n子如不好，于我何邮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53353,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广琴操十首 其三 龟山操","author":"朱右","text":"维龟有山，造初鸿濛。\n自龟之东，淮夷来从。\n膏泽既施，草木实多。\n周公上天，奈龟山何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53354,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广琴操十首 其四 越裳操","author":"朱右","text":"天之聪兮，瞆瞆其音。\n天之明兮，窅窅其深。\n天之仁兮，实临下民。\n文王在上兮，于穆不已。\n浩浩其天兮，时旸时雨。\n越裳来臣兮，万物斯睹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53355,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广琴操十首 其五 拘幽操","author":"朱右","text":"羑之阴兮，罘罘。\n羑之室兮，幽幽。\n嗟室之人兮，为死为囚。\n匪维伊愆兮，实我之邮。\n日月有明兮，容光勿留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53356,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广琴操十首 其六 岐山操","author":"朱右","text":"自邰有家，于夏之先。\n克承勿怠，瓜瓞绵绵。\n开我邠宇，衍我宗禋。\n嗟狄之人，敢乘以奸。\n彼岨矣岐，将遂于迁。\n既有我土，勿戕我民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53357,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广琴操十首 其七 履霜操","author":"朱右","text":"驱车驱车，车行无迟。\n儿在中野，父宁不悲。\n驱车驱车，车行无违。\n儿当有母，孰使儿饥。\n天生众民，罔不同仁。\n风雨霜露，实活我人。\n民生有知，以顺天赋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53358,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广琴操十首 其八 雉朝飞操","author":"朱右","text":"雉于飞，山之陲。\n孤雄啄，群雌随。\n雉于飞，音下上。\n阴阳和，鸣声畅。\n胡我人，朝出薪。\n入无家，徂岁年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53359,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广琴操十首 其九 别鹄操","author":"朱右","text":"黄鹄双飞，朝随莫归。\n山川悠邈，不女乖离。\n今当乖违，且复徘徊。\n女啄女饮，毋使女悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53360,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广琴操十首 其十 残形操","author":"朱右","text":"狸维兽，不见其首。\n我梦之形，吉凶曷究。\n式协于占，载观其繇。\n曰修尔躬，自天之佑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53361,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钱塘怀古题仙源云仍家谱 其一","author":"赵宜诚","text":"重过西湖访故宫，还思往事恨无穷。\n长城自坏封疆蹙，重镇轻捐堡障空。\n目断寒潮孤落日，愁看秀麦几生风。\n时危英杰犹难济，况任奸回托幼冲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53362,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钱塘怀古题仙源云仍家谱 其二","author":"赵宜诚","text":"皇元兵势克樊襄，南下临安事可伤。\n玉牒无光随建业，金闺遗址属僧房。\n年深堤柳还春色，岁晚宫梅尚暗香。\n景物不殊人事改，六桥风月几炎凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53363,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钱塘怀古题仙源云仍家谱 其三","author":"赵宜诚","text":"繁华胜景误前朝，留恋湖山锐气销。\n七世衣冠还寂寞，百年宫苑总荒寥。\n屯营将士符天命，故国君臣恨海潮。\n天堑风涛犹莫恃，寒更梦觉雨潇潇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53364,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钱塘怀古题仙源云仍家谱","author":"刘深","text":"前朝遗老尽销磨，感慨临风发浩歌。\n地辟天开新日月，龙飞凤舞旧山河。\n西湖夜雨红莲少，南苑秋风碧草多。\n惟有浙江潮水好，年年此日涨鲸波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53365,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钱塘怀古题仙源云仍家谱","author":"罗宜城","text":"南渡戎衣寄海壖，中原王气集幽燕。\n寒潮落日三千里，秀麦东风六十年。\n梦里玉鱼无葬地，劫馀金像出中天。\n谁知客子登临处，已后当时尚惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53366,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钱塘怀古题仙源云仍家谱","author":"赵则荣","text":"自是东迁染路尘，鲁论谁识旧君臣。\n龙飞凤舞山如旧，国破家亡恨莫伸。\n潮水不来风正冷，梅花吹落韵偏新。\n巍巍白塔胡僧醉，一卷金经奉紫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53367,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钱塘怀古题仙源云仍家谱 其一","author":"聂琚","text":"昼守东南鼎祚过，翠华冉冉渡黄河。\n宫基雨过饶苍藓，御苑春回长碧莎。\n闾井至今崇绮丽，湖山依旧事讴歌。\n玉鱼金椀无从问，塔影山阴夕照多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53368,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钱塘怀古题仙源云仍家谱 其二","author":"聂琚","text":"天目峰摧王气终，长江战舰顺流东。\n翠华摇落三宫远，紫禁荒凉六鼓空。\n和靖湖边虚夜月，岳王坟上老秋风。\n兴亡自昔关天运，莫遣哀吟两鬓蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53369,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读赵君家谱感十六朝衣冠文物之盛为赋","author":"聂琚","text":"乾坤毕竟属昌陵，夹马先惊紫气腾。\n汴水九龙临大统，吴山七叶绍中兴。\n庆云瑞日君臣际，甘露祥风海岱清。\n三百年馀深德泽，生灵草木尽光荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53370,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钱塘怀古题仙源云仍家谱","author":"黄鲤","text":"仙源家谱见云孙，尽把钱塘往事论。\n宫殿故基今佛屋，山河遗恨有冤魂。\n春风画舸闲湖曲，落日寒潮怒海门。\n不改孤山只梅树，年年疏影月黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53371,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钱塘怀古题仙源云仍家谱","author":"王复（中行","text":"函封仙谱慨前朝，派接天潢世胄遥。\n九庙已迷梁苑雪，诸陵空倚浙江潮。\n山中父老今何在，海上王孙不可招。\n掩卷共君悲丧乱，天涯风雨客魂销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53372,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钱塘怀古题仙源云仍家谱","author":"胡东皋","text":"旧家流派出天潢，往事秋来可断肠。\n宫树春深迷汴水，海潮风起暗钱塘。\n星垂五彩天文焕，道启诸贤国运康。\n犹有云仍已为庶，细书家谱泪浪浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53373,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钱塘怀古题仙源云仍家谱","author":"甘渊（伯清","text":"炎祚当年德业隆，细编家谱见遗风。\n忠良筹略隳奸佞，颠蹶皇图悯幼冲。\n梁苑绿莎深夜雨，吴宫白塔倚晴空。\n岳王坟畔西湖路，千载登临恨莫穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53374,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钱塘怀古题仙源云仍家谱","author":"李叔钧","text":"钱塘潮水急于雷，千载兴亡亦可哀。\n神器固知关气运，朝廷何以任奸回。\n诸陵秋草空遗恨，南海风帆更不来。\n宇宙茫茫今古意，江山回首又尘埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53375,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钱塘怀古题仙源云仍家谱","author":"彭卓（文博","text":"玉辇南迁驻海头，朔尘如雨暗神州。\n孤臣绝援樊襄失，四将空存社稷忧。\n红树号蝉荒苑暮，白茅没马故宫秋。\n行人欲寄英雄泪，还有寒潮向北流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53376,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钱塘怀古题仙源云仍家谱","author":"周友德（桃川","text":"钱塘曾属宋山河，王气衰来奈若何。\n人死海洋沉玉玺，棘生宫苑没铜驼。\n诸贤不及文风少，六鼓无闻寂寞多。\n惟有西湖只如旧，画船来往逐清波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53377,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居四首 其一 春景","author":"陈士元","text":"淡淡轻烟巷陌，晖晖晴日楼台。\n人在管弦声里，踏花沉醉归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53378,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居四首 其二 夏景","author":"陈士元","text":"竹屋日长茶熟，水亭风细荷香。\n不用蒲葵小扇，自然心地清凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53379,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居四首 其三 秋景","author":"陈士元","text":"金井梧飘一叶，楚天雁唳三秋。\n何处数声长笛，月明人倚高楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53380,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居四首 其四 冬景","author":"陈士元","text":"古木寒鸦山径，小桥流水人家。\n昨夜前村微雪，诗思欲问梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53381,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题葛原良所藏王元章所作梅鸟图 其二 梅花翠鸟","author":"谢肃","text":"雪馀梅发映春空，咫尺仙凡有路通。\n为问绿衣歌舞后，更谁曾到合欢宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53382,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题赵叔诚所藏斑婕妤团扇图","author":"谢肃","text":"不硕同车奉至尊，竟归长信掩重门。\n梦魂肯到夫容帐，犹托齐纨写怨恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53383,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为张知县题挟弹图","author":"谢肃","text":"紫陌春风万物荣，王孙驻马最多情。\n金丸不肯轻弹射，却听黄郦隔叶鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53384,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题陈孟文所藏青山白云图","author":"谢肃","text":"若人好是希夷孙，文彩风流迥出群。\n往岁入关闲驻马，袖中携得华山云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53385,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题挟弹图","author":"谢肃","text":"五陵才子本豪华，倚马沉吟傍日斜。\n岂惜金丸千万个，自缘不肯打慈鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53386,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题天际归舟图","author":"谢肃","text":"闲云澹澹树离离，天远江清小舸归。\n一段诗情谁会得，风流当属谢玄晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53387,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题巫峡潇湘图","author":"谢肃","text":"蜀人休笑杜陵狂，倚阁哦诗雨气香。\n自有波澜能浩荡，欲回丞峡作潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53388,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]