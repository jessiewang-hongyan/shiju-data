[{"title":"养蔬四首为汉府教授王先生作 其四","author":"王褒","text":"御冬当旨蓄，应得治芳园。\n挂壁藏新种，培泥拥宿根。\n萍齑怜凤炙，玉糁诧熊蹯。\n拟作冰壶传，雄才独讨论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31675,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄唐进士震","author":"王褒","text":"我忆京华侣，经年意若何。\n别深乡思减，客久物情多。\n淡月回银烛，疏钟带玉珂。\n青云如可及，倾盖一相过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31676,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送友人之京","author":"王褒","text":"银缸盛美酒，江上送君行。\n共惜孤舟别，那知几日程。\n阙寒逢断雁，宫曙听新莺。\n早献金门策，休论汉贾生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31677,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题雪景图","author":"王褒","text":"高阁凝云闭，虚窗带雪开。\n鸟寒空辩鹭，树暝总疑梅。\n遣兴惟诗句，衔情秪酒杯。\n遥知函丈下，已遣二生回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31678,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽徐母施氏","author":"王褒","text":"极目乌程路，高堂旅榇归。\n音容芳树远，心绪片云飞。\n别泪茅生馔，荒尘莱子衣。\n青山佳兆在，寂寞掩春晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31679,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元夕观灯应制","author":"王褒","text":"鱼钥春开虎豹关，五云星斗近天颜。\n绛河月湿金盘露，火树香分玉笋班。\n鳷鹊漏传花外观，蓬莱仗列海中山。\n万方乐事同元夕，恩赐千官十日閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31680,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送裴孝感归省","author":"王褒","text":"都门霜落雁南飞，官舍萧条独忆归。\n淡月疏星辞帝阙，乱云高树近亲闱。\n渊明对酒心犹好，杜甫能诗趣不违。\n闻说邑人相候久，高堂莫恋老莱衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31681,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"采石江上元夕简武昌周博士临湘李驿宰","author":"王褒","text":"朝回无处不淹留，元夕江干繫去舟。\n九奏箫韶天上听，千家灯火月中游。\n然犀壮志空流水，倚马长才见故丘。\n佳节谩劳伤往事，百壶堪醉鹔鹴裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31682,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送张指挥","author":"王褒","text":"龙虎旌旗度朔河，羽林诸帅拥天戈。\n银潢净洗刀兵气，玉垒穷搜虎豹窠。\n万里山川传驻跸，九重日月共鸣珂。\n边庭不用防秋计，沙漠如今总汉歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31683,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送曾太守之官","author":"王褒","text":"谁言五马共翩翩，百丈维牵水上船。\n故吏青山开候馆，遗民绿野趁春田。\n颂声遥播啼猿外，归梦长随落雁边。\n闻说颍川曾入相，知君未必让先贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31684,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次郑校书左掖闻莺之作","author":"王褒","text":"白头著作文人行，左掖闻莺有短章。\n委佩乍分花外仗，停骖归滞柳边墙。\n谪仙老去乡心切，贾至才高野趣长。\n自笑云泥踪迹异，无因倾耳接飞觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31685,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送匡行人显回京师","author":"王褒","text":"儒冠岁月易蹉跎，孤馆相看奈别何。\n匡裕栖迟名独盛，王猷落魄兴偏多。\n流莺高树双壶送，积雨长江一棹过。\n自笑烟波为客久，阳关休向醉中歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31686,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送教谕陈廷杰归湖口","author":"王褒","text":"腊月江头送季方，北山飞雪扑离觞。\n匡庐树影吟边近，彭蠡江声梦里长。\n晚岁重瞻尧日月，清时独擅汉文章。\n春来多少南归翼，毋惜题缄寄玉堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31687,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陈主簿稔过宿赋答","author":"王褒","text":"君门已许解朝衣，此后相期过竹扉。\n池上青山留客醉，郢中白雪和人稀。\n雨晴閒馆花空落，月上层城鸟倦飞。\n明日独怀乘兴地，不堪愁思更依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31688,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陈生温陵省亲","author":"王褒","text":"问君何处拜庭闱，海国苍茫去路微。\n洛社旧游同北望，温陵积梦独南归。\n春行树外空闻鸟，夜坐花边静掩扉。\n转向高堂思綵服，云山惆怅与心违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31689,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠道士陈清隐","author":"王褒","text":"琳宫遁迹学无为，姓字休劳世上知。\n庐阜远公莲，社鉴湖贺老。\n酒船期石床，花落因风扫。\n丹灶云深近水移，几度钧天闻九奏，馀音半入步虚词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31690,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送校书陈秀才省亲","author":"王褒","text":"都门雨雪正霏霏，马上双壶送独归。\n阙下马周留客邸，郡中潘岳访亲闱。\n万花岛屿春移棹，五柳郊原昼掩扉。\n霄汉朋游总知己，此行休恋故山薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31691,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题刘仪部山水图二首 其一","author":"王褒","text":"江城四月见更生，岐路劳劳慰别情。\n秉笔南宫词独擅，盍簪东阁酒同倾。\n白云旧业灯前思，青镜流年客里惊。\n自笑萍踪也如此，悠悠书剑谩题名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31692,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题刘仪部山水图二首 其二","author":"王褒","text":"谁作丹青慰壮游，潇湘风雨谩淹留。\n雨深远渚黄花夕，霜落平芜白雁秋。\n憔悴屈平应有念，才华贾谊自无俦。\n骚人南去应肠断，芳草寒烟不尽愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31693,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽云窝林处士","author":"王褒","text":"青山何处白云窝，不见诗人掩薜萝。\n策杖谁寻盘谷隐，辍耕偏忆鹿门过。\n芳蹊此日成桃李，野服当年制芰荷。\n欲酹吟魂招楚些，宁堪洒泪客中歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31694,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题墨梅赠苏上舍","author":"王褒","text":"翠屏山下水云香，别墅归来月在床。\n今日看图诗兴动，浑如东阁送何郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31695,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梦作","author":"王褒","text":"楚山飞雨湿行旌，犹记临岐唱渭城。\n横笛江头闻折柳，断肠偏是别离情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31696,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过九江二绝似同舟诸游好 其一","author":"王褒","text":"孤舟几日别京华，望尽南天不见家。\n客里相看须尽醉，江心何用泣琵琶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31697,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过九江二绝似同舟诸游好 其二","author":"王褒","text":"层峰断岸见涵城，风景依稀灞上营。\n最恨春来长是客，新莺细柳不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31698,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中斋居寄倪烱","author":"王褒","text":"空斋疏雨又黄昏，那复孤灯坐掩门。\n纵道异乡常不雨，举头看月也消魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31699,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日病卧寄同舍二三知己","author":"王褒","text":"独怜卧病送残春，说著春光恼杀人。\n把酒看花等閒事，布衣空惹陌头尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31700,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题高安朱少尹莆山书舍","author":"王褒","text":"林下横门隔断桥，溪边草径入云遥。\n青山绿树知多少，谁道书声到市朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31701,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题俞紫芝临怀素千字文","author":"王褒","text":"昔年舣棹桐江道，草圣相传紫芝老。\n长风千里吹夏云，落日空山迹如扫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31702,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题唐马图","author":"王褒","text":"锦鞯金铎舞倾杯，驿路相传换马台。\n零落黄尘鼙鼓歇，秪从图画识龙媒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31703,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"储御史光羲田家杂兴","author":"高柄","text":"野老安贫贱，力作不辞苦。\n把锄行晨风，南山看禾黍。\n今秋谷稍登，方思广场圃。\n归来茅檐下，团团聚儿女。\n落日在西山，悠然望孤渚。\n昨宵天始寒，虫声满篱户。\n田家衣食薄，黾勉岁时取。\n掩关未成眠，东邻响机杼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31704,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"岑补阙参同诸公登慈恩寺浮图","author":"高柄","text":"香界出尘表，孤标屹峥嵘。\n直上凌半空，言是羽翼成。\n迥梯接元气，磴道盘青冥。\n雄观隘川岳，乃觉形神轻。\n俯视寒渭白，平临终南青。\n神州一掌中，双阙云端明。\n穷历诸磴尽，飒然凉飙生。\n千峰挂飞雨，秦塞何凄清。\n早割区中缘，永怀参道情。\n今日高兴尽，期君谢浮名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31705,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"刘随州长卿江中晚钓寄荆南一二相识","author":"高柄","text":"楚水东去远，故人离别心。\n登舟望落日，岸绝荆门阴。\n晚棹向孤屿，收纶度前林。\n天寒大泽暝，鸟没长淮深。\n十载梦烟波，幽期共投簪。\n白鸥故友待，向我如招寻。\n渺渺初月色，嗷嗷飞鸿音。\n相思若千里，遥寄沧浪吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31706,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与林九龙门夜宿迟明赠别兼寄周一玄","author":"高柄","text":"江郭梅已白，飞霜肃严冬。\n故人惜短景，握手龙门东。\n群壑倏暝色，虚亭寒夜空。\n明灯照孤月，相对情未终。\n明发忽惆怅，拂衣如飘风。\n长天西北倾，三山落云中。\n中有淡荡人，孤高含清真。\n三年阔风采，百里悲胡秦。\n前日游远方，登堂别严亲。\n出门向西笑，逸气凌秋旻。\n雪度日边棹，风吟江上蘋。\n清诗落吴楚，此地生阳春。\n郢曲和者稀，剑歌不复陈。\n归来使酒气，酒酣气益振。\n青楼唤歌舞，日见罗衣新。\n却笑相如宅，凄凉四壁尘。\n交欢徒结面，肝胆向谁陈。\n因子写远意，风期越江滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31707,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答陈沧洲留别之作","author":"高柄","text":"海上春欲暮，楼头花满林。\n一樽风雨夕，千古幽期心。\n平旦忽惆怅，怆然惜离襟。\n踟蹰歌白雪，留赠比黄金。\n十日不尽欢，临岐徒悲吟。\n举目望霄汉，浮云蔽重阴。\n沧洲渺何许，春水洪涛深。\n此别非万里，无时间徽音。\n以我子猷船，期君安道琴。\n毋为叹白发，岁晚重招寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31708,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"顾山斋分韵志别","author":"高柄","text":"孤云与独鹤，千里怅悠悠。\n时因长风吹，双落碧海头。\n郑侯念长违，董子经时别。\n几望西南天，孤吟啸台月。\n昨日放扁舟，辍棹三江流。\n中夜造我语，片言解离忧。\n逸兴横素襟，吐辞若流水。\n挥杯对黄花，兀然不知醉。\n欢乐情未极，复此成分飞。\n矫首秋风外，徒惊蕙草稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31709,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"望庐山作","author":"高柄","text":"挂席度彭蠡，停桡望匡庐。\n苍苍五老峰，秀出东南隅。\n气势掩衡霍，峥嵘压东吴。\n千岩散秋色，倒影澄江湖。\n倏忽霁飞雨，瀑流挂香炉。\n悬崖残雪古，涧落垂虹孤。\n耸目万仞表，茫茫飞鸟无。\n飘然挹空翠，心与浮云俱。\n我欲呼谪仙，结巢松已枯。\n迟回徒仰止，飞鹢上天衢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31710,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题云林书隐图赠梅江许宗显","author":"高柄","text":"爱尔江海居，清风继箕颍。\n起予丘中赏，逸兴探灵境。\n粉墨含天光，丹青藏云影。\n窗开象湖阴，帘捲龙峰顶。\n林静弦诵閒，波空棹歌冷。\n沧浪可洗心，白鸥待孤艇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31711,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"韦苏州应物西郊燕集","author":"高柄","text":"原野谷雨霁，熙阳丽芳辰。\n良游出西郭，集我平生亲。\n野酌藉芳草，飞花落衣巾。\n时闻幽鸟哢，复眺群山新。\n眷此不尽欢，行当念徂春。\n回心勿暌离，愿言保其真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31712,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题千里掀篷图效常建体","author":"高柄","text":"日没川路阔，松阴澄晚流。\n掀篷卧天色，超忽江潭秋。\n渚月镜中净，孤辉漾轻舟。\n心将空际云，身与波上鸥。\n了视无外物，旷然神远游。\n予亦沧浪情，从君问方洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31713,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得春草碧色送丘少尹归四明","author":"高柄","text":"春色有佳兴，送君惜别情。\n帐前见芳草，绿尽空江浔。\n千里霭晴翠，夕阳烟际深。\n遥分白鸥水，近映青枫林。\n萋萋满行衣，苒苒生别心。\n王孙行当归，蘪芜思越吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31714,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"远屿堆蓝","author":"高柄","text":"江晚波自阔，天空谐远寻。\n渚霞霁孤岛，绿映沧浪深。\n残日镜中没，馀晖在前林。\n黛云结玄发，碧气横素襟。\n其以罨画山，寄君无声吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31715,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠友渔樵歌","author":"高柄","text":"我本渔樵者，结交青云人。\n朱门华馆不下士，青山白屋归来贫。\n闻君爱与渔樵友，每逐渔樵在林薮。\n两屐松风万壑间，孤舟萝月双溪口。\n朝与渔者亲，暮与樵者邻。\n山厨束薪煮白召，野饭折荷包紫鳞。\n春风行歌出林曙，落日叩舷渡江渚。\n负策閒随黄鸟吟，濯缨时对骚人语。\n世人结交徒结名，黄金不多交不成。\n羡君不交黄金贵，却友渔樵如弟兄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31716,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"古咸阳行","author":"高柄","text":"长安古城尽禾黍，故国荒凉变今古。\n秦地山河满夕阳，汉家宫阙随尘土。\n咸阳昔时何壮哉，离宫复道飞空回。\n五陵白日歌钟起，三辅红尘车骑来。\n一朝坐见繁华歇，冠盖散为烟雾灭。\n草木犹缠战血腥，丘墟尚带行轮辙。\n年代悠悠经几秋，空馀渭水向东流。\n回中古道无游辇，关内何门寻故侯。\n伤心此地不能道，惆怅雄图成蔓草。\n惟有终南万仞青，年年阅尽行人老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31717,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题边文进桃花双禽图","author":"高柄","text":"词人工粉墨，花底见双禽。\n青鸟飞来日，瑶池春色深。\n乱红看欲雨，幽哢听非琴。\n莫到成蹊处，金丸满上林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31718,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题叶士谨石林精舍","author":"高柄","text":"开径馀松菊，藏书富简编。\n砚池春霁雨，琴几晚凉天。\n酒伴呼浮白，儒生问草玄。\n应耽名教地，倚杖信流年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31719,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题华峰望日图","author":"高柄","text":"飞步青莲花，耸身凌紫霞。\n天鸡弄海色，西挂三峰斜。\n咽漱太阳精，逍遥金母家。\n长安日下影，回首望京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31720,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"野渡横舟","author":"高柄","text":"落帆逗前浦，渡口喧已寂。\n野艇横浅流，空江带愁色。\n渔归绝岛遥，鸟度群山夕。\n应有待潮人，吟成山月白。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31721,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"牛路春耕","author":"高柄","text":"浅渚蒲叶长，深村杏花吐。\n东皋春事兴，尽室相随去。\n谷鸟劝我歌，青山澹吾虑。\n日暮望柴关，牛涔取归路。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31722,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"龟湖晚钓","author":"高柄","text":"湖上夕水寒，潜鳞避深钓。\n野老本无营，一竿挂残照。\n人知白首心，我爱沧浪调。\n何必客星高，将贻故人笑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31723,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄陈五先辈","author":"高柄","text":"春山曾共赏，一别又西风。\n岐路非关远，心期恨不同。\n暮天孤嶂静，秋水夕阳空。\n为有相思寄，云边送断鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31724,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚春寄怀林八员外董七侍读先有游董岩之期","author":"高柄","text":"黄鸟堪求侣，青山独掩扉。\n相思空夜月，一别换春衣。\n江树云边出，林花雨外稀。\n董岩佳赏地，连佩莫相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31725,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜泊官塘见新月","author":"高柄","text":"落日长川暝，孤舟独客愁。\n若为今夜月，不是故园秋。\n片影悬珠斗，微光下玉钩。\n心期明镜满，指日大刀头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31726,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送许志学北游","author":"高柄","text":"闻说幽并北，严冬雪作花。\n长空无过雁，念子独辞家。\n朔月迎仙棹，滦云引客车。\n蓟门登览处，颙望忆京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31727,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"除夕","author":"高柄","text":"腊尽雪初晴，春回促漏声。\n孤灯亲远客，一岁只残更。\n律候青阳转，年随白发生。\n迎新应待旦，端佩谒承明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31728,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重送许子之巴西","author":"高柄","text":"双凫新被命，万里远从官。\n闻说巴山好，何愁蜀道难。\n峡猿惊印绶，蛮吏识衣冠。\n圣德怀荒服，贤劳莫惮烦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31729,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"松岭樵歌","author":"高柄","text":"峻岭饶朽木，采之行且歌。\n歌长白云外，远与松声和。\n日落望烟归，山风吹薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31730,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日同郑二逸人董七侍读林一秀才雨中宴集朱聘君碧潭轩以微雨潭上来分得微字","author":"高柄","text":"微霜昨夜塞鸿飞，雨里逢君未授衣。\n华馆把杯仙菊润，青山对面故人稀。\n泉飞百道溪声远，风度重林酒气微。\n明日相逢乘霁景，登临不用怨斜晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31731,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送秀上人远游","author":"高柄","text":"一灯初别祖师禅，孤月寒云思渺然。\n飞锡却从红日外，浮杯还渡白鸥前。\n寻钟野寺经残雪，乞食春城向暮天。\n我有采真秋兴逸，相期何处听寒泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31732,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄林七膳部兼呈林怀之广文","author":"高柄","text":"无诸台下叶初黄，客里相逢值早霜。\n秋馆醉看仙菊满，禅房坐识雨花香。\n别来塞雁江云隔，梦去青山海路长。\n白发广文凭问讯，门前还有几升堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31733,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送雪峰僧龙渊归三山","author":"高柄","text":"新持半偈出青莲，孤鹤閒云思渺然。\n金锡来承天汉语，紫衣归坐雪峰禅。\n寻钟野寺残山外，漱齿寒流落照边。\n行至东林休结社，松枝已偃旧房前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31734,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"江亭别","author":"高柄","text":"春江澹澹白鸥波，一曲阳关为尔歌。\n莫向樽前惜沈醉，青山长在别离多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31735,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"江上扁舟图为林维德赋","author":"高柄","text":"扁舟一叶楚天寒，远树空江野照残。\n忆得湘潭归棹晚，千峰倒影镜中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31736,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题界画台阁","author":"高柄","text":"铜雀高楼借日悬，姑苏舞榭入云烟。\n繁华一落金屏影，半是吴山邺水边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31737,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]