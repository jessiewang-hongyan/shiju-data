[{"title":"元夕","author":"顾璘","text":"上元佳节在山城，逝水流年忽自惊。\n灯火殊方同节候，歌钟何处起春声。\n衰残断酒江梅笑，飘泊怀乡鬓雪生。\n四海幸逢阳道泰，官曹端坐咏升平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57261,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郴台官梅","author":"顾璘","text":"郴州行台风日妍，官梅两株清可怜。\n祗缘老干临高榭，故著繁花媚远天。\n绕院蜂声喧不去，隔江鱼素渺谁传。\n脩篁怪石俱无赖，点缀幽情向客边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57262,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"至郴访司马李贻教同年夜话二首 其一","author":"顾璘","text":"仄叠郴阳坂，怀君夙驾过。\n风神清不减，著作老仍多。\n饮量开江海，幽栖脱网罗。\n素丝劳枉赠，疲薾奈吾何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57263,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"至郴访司马李贻教同年夜话二首 其二","author":"顾璘","text":"屈指分携久，披心旧好谐。\n悬灯如梦里，接席自天来。\n世变秋云改，民穷泽雁哀。\n莫嗔无酒兴，深语阻衔杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57264,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乍暖","author":"顾璘","text":"阴厓春令几时回，即有山花映路开。\n冰雪祗今无处著，柳丝桃萼莫疑猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57265,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"度岭赴耒阳三首 其一","author":"顾璘","text":"斜日半岩阴，回溪百丈深。\n蹬危元借石，叶老不辞林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57266,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"度岭赴耒阳三首 其二","author":"顾璘","text":"元夕村村鼓，春山处处花。\n韶光宜对酒，行客倍思家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57267,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"度岭赴耒阳三首 其三","author":"顾璘","text":"椒团黄粉腻，柳染翠丝匀。\n献颂宜新岁，攀条怆远人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57268,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"口占次郑时明国学梅花诗韵二首 其一","author":"顾璘","text":"玉体珠衣岂洛神，前生姑射是元真。\n芳菲管领先天气，风格依稀绝粒人。\n明月池台横浅水，艳阳桃李隔红尘。\n广平见说心如铁，别有调羹万斛春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57269,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"口占次郑时明国学梅花诗韵二首 其二","author":"顾璘","text":"閒将标格品花神，独许梅花自有真。\n雪里清香无俗艳，水边潇散一高人。\n盟心特挺冰霜节，透骨那薰脑麝尘。\n招引东皇回淑气，任教红紫领馀春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57270,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"耒江夜行","author":"顾璘","text":"耒江春浩荡，兰棹夜夷犹。\n风止灯花喜，天空角响愁。\n滩流嗽欹石，岸犬吠行舟。\n累月劳车骑，篷窗得暂休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57271,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"重到石鼓书院","author":"顾璘","text":"石鼓灵踪渺不存，朱陵仙洞已无门。\n洋洋弦诵歌邹鲁，只仰朱张道学尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57272,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"花药寺","author":"顾璘","text":"古佛祗阇苑，前朝帝子居。\n龟龙缠石碣，虎豹守松庐。\n尘海波翻覆，人天事有无。\n想临烦恼障，应悔就金舆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57273,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春意三首 其一","author":"顾璘","text":"正月垂杨绿映堤，傍山新溜碧澄溪。\n暖风消尽寒岩雪，换得黄鹂向客啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57274,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春意三首 其二","author":"顾璘","text":"日满高原云满汀，天涯随处草青青。\n山茶落尽樱桃发，遥忆家园载酒亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57275,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春意三首 其三","author":"顾璘","text":"郴南周览几山城，更向澬州问客程。\n春色平铺三百里，梅花千树伴经行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57276,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"远笔铺夜坐待药","author":"顾璘","text":"老境形神减，征途药饵随。\n长勤应损寿，多病渐通医。\n公事谁能了，仙人不可期。\n凭将行止意，清夜叩灵龟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57277,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"大云山","author":"顾璘","text":"衡岳有馀秀，大云如削成。\n春烟浓染树，晴嶂曲连城。\n采药怀仙隐，经丘畅野情。\n飘飘霞外赏，真薄世间名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57278,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"高楼寺二首 其一","author":"顾璘","text":"静夜宿高云，心清远世氛。\n奇峰移座得，鸣涧下阶闻。\n瓶注杨枝水，灯翻贝叶文。\n经年尘土面，借尔妙香薰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57279,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"高楼寺二首 其二","author":"顾璘","text":"萝径冲云入，松房听雨眠。\n佛幡摇殿吹，野火照蛮烟。\n院静那成梦，形劳不近禅。\n闾阎苟无补，空使负林泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57280,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宝庆府澬江之上有石矶焉当水之冲甚峭特旧固无名余偶登之题曰砥柱矶系四韵","author":"顾璘","text":"昆崙一卷石，飞落碧江漘。\n尽日浮佳气，中流立此身。\n楼台悬峭景，桃李点芳春。\n阅尽狂澜色，何须顾水神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57281,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出宝庆四首 其一","author":"顾璘","text":"十日澬城未出门，登车芳草暗平原。\n深红浅白花无赖，转为春光一断魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57282,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出宝庆四首 其二","author":"顾璘","text":"过雨泉声绕树来，隔云山色映花开。\n吏人若过桥东少，唤取村翁共酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57283,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出宝庆四首 其三","author":"顾璘","text":"树树桐花素雪披，行台迎暖试罗衣。\n逢春到老能多少，一度韶华忽已违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57284,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出宝庆四首 其四","author":"顾璘","text":"细雨沾衣不见飞，隔墙桃李雾中微。\n家园酒熟梅如豆，稚子应怜客未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57285,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"禽言六首 其一 行不得哥哥","author":"顾璘","text":"楚山造天，楚水扬波。\n轻舟良马，败亦孔多。\n二物不备，将奈楚何。\n行得不得，寄言尔哥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57286,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"禽言六首 其二 不如归去","author":"顾璘","text":"置酒高堂，佳殽且庶。\n白日未晡，有狂者倨。\n我性亶愚，惧不我与。\n不我与，将必有处。\n不如俛首，及昼归去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57287,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"禽言六首 其三 姑恶","author":"顾璘","text":"姑兮我母，胡宁我虐。\n弗慎于仪，衅自下作。\n母也尔容，姑乃义合。\n上行其义，怨者归薄。\n是究是图，诚匪姑恶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57288,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"禽言六首 其四 泥滑滑","author":"顾璘","text":"终风发发，周道如刷。\n零雨沾之，足不得劄。\n匪足不劄，覆车及辖。\n尔行弗时，勿谓泥滑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57289,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"禽言六首 其五 婆饼焦","author":"顾璘","text":"阿姥作饵，妇也烧之。\n承令弗虔，火则燎之。\n古有顺妇，叱犬摽之。\n尔婆有饼，宜尔妇焦之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57290,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"禽言六首 其六 看蚕看火","author":"顾璘","text":"蚕生于原，匪温斯瘅。\n火以炀之，烈则杀我。\n尔将崇利，毋贻我祸。\n既看我蚕，请看尔火。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57291,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武冈道中雨二首 其二","author":"顾璘","text":"风狂花片轻，春事恼閒情。\n急雨潜鱼起，新雷乳鸭惊。\n浮生悲代谢，大造剧生成。\n笑断杯中物，来干身后名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57292,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿兰桥山馆大雨","author":"顾璘","text":"山雷划辗长空过，檐雨平添积水深。\n去住总关神物算，阴晴何与道人心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57293,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨度车轮岭二首 其一","author":"顾璘","text":"野馆三更雨，山溪一尺泥。\n王尊驰折坂，马援下蛮溪。\n高举羞鸿翮，长途厄马啼。\n圣朝方用壮，冉冉独庞眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57294,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨度车轮岭二首 其二","author":"顾璘","text":"山泼风前雨，人浮道上波。\n农家戒耕作，行者答劳歌。\n云暗遥峰少，春深缘树多。\n行藏两孤负，身世转蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57295,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿西桥铺听雨旧有西桥月色之榜","author":"顾璘","text":"西桥月色昔人游，南楚春光野客收。\n堪笑地灵多爱惜，一宵鸣雨送羁愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57296,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"空山","author":"顾璘","text":"空山行尽不逢人，三户曾传旧楚贫。\n幽冀如山收贡税，丹砂仍备尚方珍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57297,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"至武冈望云山可爱因忆金陵东郊武冈山甚动乡思","author":"顾璘","text":"楚国春花伤客情，台居频梦秣陵城。\n名山忽向殊方得，客路如从故里行。\n碧水护田生野兴，黄鹂穿竹送歌声。\n归时若上崇冈望，正想南云万里横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57298,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"自武冈行边往靖州","author":"顾璘","text":"清昼行边列校随，貔貅十队拥军麾。\n青山得云美如画，骏马当路平堪驰。\n泉明宝剑悬金甲，风引崇牙飏绣旗。\n老手十年椎钝极，更来横槊一裁诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57299,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饭山口堡","author":"顾璘","text":"平峦高捧百夫城，四野花开战垒平。\n饭罢独行观戍卒，枕戈閒调凯歌声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57300,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岭傍深溪见花柳甚幽","author":"顾璘","text":"孤峰天畔绝人家，山杏山桃夹路花。\n欲访韩终求石髓，洞门深锁一溪霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57301,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出武冈关","author":"顾璘","text":"连岭横天白日微，溪流下堑客行稀。\n山花照水开还落，野雉出林鸣且飞。\n万里承恩虚仗钺，九重柔远正垂衣。\n巡行本欲输筋力，敢谓乘春布德威。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57302,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"度磨石岭","author":"顾璘","text":"磨石岭头春日晴，白云如絮绕车生。\n前生似得丹砂力，长向青天掉臂行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57303,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"度火甲诸小岭","author":"顾璘","text":"大岭何如小岭多，车如鸟翼倏经过。\n千岩万壑穷奇状，阆水蓬山更若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57304,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"度退田安乐诸坡三首 其一","author":"顾璘","text":"平峦绝顶路逶迤，飞盖青霄引画旗。\n只恐人从千里见，误传旌节降云师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57305,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"度退田安乐诸坡三首 其二","author":"顾璘","text":"千仞峰头见日光，起挥袍袖拂青苍。\n蛮天且喜浮云尽，拭目长安紫极傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57306,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"度退田安乐诸坡三首 其三","author":"顾璘","text":"仰随飞鸟起高天，俯逐游鱼坠九渊。\n若遣王阳经此地，定知中道即回鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57307,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"青靛山","author":"顾璘","text":"望望青瑶柱，登登碧汉梯。\n石角垂高壁，泉流响暗溪。\n朱萍仍布沼，紫蕨乍生荑。\n好寻黄石约，相傍偓佺栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57308,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"靖州吊宋义卿","author":"顾璘","text":"皇天不吊颜公死，湘水无情屈子沈。\n彊圉一身关国体，忠贞千古动人心。\n精魂白日涛犹怒，祠庙空山柏已森。\n宿草孤坟何处奠，只馀清泪洒衣襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57309,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"靖州阅武","author":"顾璘","text":"圣代舆图广，襟包及夜郎。\n连城严屏翰，万旅肃封疆。\n星驾行春远，霜台校武强。\n六韬呈战略，五善肃边防。\n花暖蛮烟息，风雄士气扬。\n戈鋋寒雪色，旗帜锦云光。\n力羡争超距，材精许擅场。\n射雕飞迅镝，走马背长枪。\n本藉皇威大，还资国器良。\n辕门推毂重，帷幄运筹长。\n羽扇吾真忝，干城尔各当。\n紫宸宵旰虑，应免顾南荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57310,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登飞山","author":"顾璘","text":"渠阳众山内，飞山郁岧峣。\n平嶂蟠近郭，孤峰插层霄。\n仰攀万丈梯，弱袂飞狂飙。\n股栗不能定，地轴如动摇。\n云房妥明神，百灵俨相传。\n风雷在左右，倏忽应招邀。\n丰凶非所遗，祈报争喧哓。\n苗夷伏石陛，犦牲时献膋。\n磴边数小树，野火不敢烧。\n谁云俗尚鬼，实以威灵昭。\n神道可设教，勿谓同昏妖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57311,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谒鹤山祠","author":"顾璘","text":"魏公圣人徒，志比曾闵肩。\n讲道振西蜀，学子从如烟。\n一朝动九重，黄纸飞传宣。\n郡吏俛负弩，小夫争执鞭。\n持议或矛盾，风云俄变迁。\n时相既侧目，众口森戈鋋。\n汉世锢党人，唐贤投浊川。\n渠阳一掬水，岂纵蛟龙旋。\n所赖坦荡怀，安土乐其天。\n福坡采秋薇，书堂酌星泉。\n教覃儒化远，身老士节坚。\n啾啾鬼蜮辈，粪壤何足捐。\n空堂仰遗像，清风犹洒然。\n残编等白璧，愿为浮世传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57312,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"下双厓岭入会同","author":"顾璘","text":"双厓分剑门，石道中贯出。\n危如坠渊下，经过已非一。\n所荷皇天慈，惠我得晴日。\n翩翩转轻舆，荦确千怵惕。\n嗟尔冰雪晨，行者慎其术。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57313,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"下松厓岭入黔阳","author":"顾璘","text":"荒云莽苍石厓横，不见青松但有名。\n嗟来诛求贫到骨，肯容材木遂生成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57314,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"石亭寄诗和答","author":"顾璘","text":"休官独向山中住，久厌疏狂学孟公。\n盘薄解衣时作画，跏趺临水亦谈空。\n松萝野兴宜明月，海岳文光贯彩虹。\n愧我离君走尘土，高情徒寄梦魂中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57315,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟晓","author":"顾璘","text":"溪流涨新绿，稍浣尘中衣。\n岸草媚春色，林霞开曙晖。\n樯燕惊忽去，水烟晴渐微。\n倚篷悟节改，轻风飞絮稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57316,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟午","author":"顾璘","text":"窗中日气暖，杜若花微芬。\n舟轻后浪迈，野晴前嶂分。\n炊烟隔浦见，莺声临岸闻。\n兰桡兢利涉，界破波心云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57317,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟晚","author":"顾璘","text":"扬帆背落日，云昏半溪阴。\n归鸦已喧噪，游凫尚浮沈。\n奔程促橹节，警戍悲笳音。\n龙标夕烟暗，悠悠伤客心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57318,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟夜","author":"顾璘","text":"道人爱夜寂，习静虚舟中。\n开帘恐辜月，系缆讵忧风。\n眼鸥恋暖渚，归雁喧晴空。\n乡心不及水，坐驰徒向东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57319,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"自沅溪拥小队汎舟向辰","author":"顾璘","text":"双橹夹船鹅鹳鸣，五溪春日照行营。\n朱旗耀水翻风影，画鼓凭厓殷谷声。\n蛮洞卉裳趋使节，辕门花帽拥儒生。\n当年铜柱劳筋力，此日轻裘凛甲兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57320,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"黔阳顺流下滩","author":"顾璘","text":"云锼岭脚跨盘涡，怪石浮沈万骆驼。\n一片轻舟飞箭过，却疑槎影渡天河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57321,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄寿陈石亭","author":"顾璘","text":"梦里钟山万仞青，江天东望少微星。\n当朝旧擅扬雄赋，有子新传卜氏经。\n止酒先生逃净社，焚鱼学士住岩扃。\n遥怜耆旧称觞会，独少尘容在画屏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57322,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五溪曲六首 其一","author":"顾璘","text":"皇天辨下土，夷夏各有防。\n冠冕与椎祼，人兽本殊方。\n三五圣哲代，建国但中疆。\n有苗或侮予，干羽舞阶隍。\n悠悠七旬内，卉服歌来王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57323,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五溪曲六首 其二","author":"顾璘","text":"五溪何滔滔，夷落限穷岑。\n天王主岳渎，衡山屹南临。\n秦皇苦多事，汉武志亦淫。\n楼船渡牂牁，铜柱开郁林。\n舆图自此广，戈矛长见寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57324,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五溪曲六首 其三","author":"顾璘","text":"殷宗伐鬼方，三年始休兵。\n淮南谏南征，瘴疠哀群生。\n山多蛇虺毒，水有含沙腥。\n苟非蛮种类，白骨死榛荆。\n寄言兵家子，勿与绝域争。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57325,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五溪曲六首 其四","author":"顾璘","text":"白金如流水，丹砂血色殷。\n羌儿急衣食，关市委丘山。\n珍异虽云贵，采掇良艰难。\n不见乳穴记，戕生犹等閒。\n所宝在五谷，远物何足悭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57326,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五溪曲六首 其五","author":"顾璘","text":"百里屯一军，五十置一堡。\n舂陵达酉溪，士卒联部伍。\n财粟日转输，外禦苗夷侮。\n况复粤巂间，岁益征戍苦。\n楚人今凋残，请勿拓边土。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57327,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五溪曲六首 其六","author":"顾璘","text":"孤戍高山颠，鸣角夜呜呜。\n月明尚苦颜，况临风雨途。\n主将位日贵，重帷锦模糊。\n李牧今去久，谁闻捐市租。\n哀哉古人言，一功万骨枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57328,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出武溪","author":"顾璘","text":"龙标远在夜郎西，鼓楫扬歌下武溪。\n却笑伏波无猛气，水鸢何事动悲啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57329,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"见水上飞燕","author":"顾璘","text":"辰溪燕子点波飞，恰似江南带雨归。\n对入画梁相并语，满庭红艳发蔷薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57330,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]