[{"title":"游曹溪与任崧翰宪使作 其二","author":"释今无","text":"驰驱无计息贤劳，风雅文坛惯自操。\n千朵芙蓉云外瘦，一行鹓鹭日边高。\n本来堂好疑青琐，明镜台方现白毫。\n木叶夜来风战急，满庭花雨泛江涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47647,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游曹溪与任崧翰宪使作 其三","author":"释今无","text":"千章木护一孤亭，塔院憨师别有名。\n不早解衣恣偃蹇，暂时凝睇亦凄清。\n龛云断续晴含雨，磴竹萧疏自发声。\n线底明珠归慧业，出山饶有道人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47648,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游玲珑岩始兴班明府赠予脚力 其一","author":"释今无","text":"镌得骊珠九曲明，瑶台叠叠向人清。\n鼓钟自发云根响，狮象齐驱药力轻。\n名胜未须誇泰岱，岩峦恰好称山城。\n客愁无处消烦暑，今日因君挟纩行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47649,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游玲珑岩始兴班明府赠予脚力 其二","author":"释今无","text":"洞门别辟转聱岈，石燕喃喃亦有家。\n琢玉自成栖凤穴，倚天高散护龙霞。\n忙生白发情难问，静数青峰兴尚赊。\n乍入片云无路出，化为冰乳渍莲花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47650,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游玲珑岩始兴班明府赠予脚力 其三","author":"释今无","text":"巉岩支拄逼层空，矫矫真看奋玉龙。\n只见石连诸洞口，不知人在几天中。\n鼎烟尚染仙云冷，僧米空悬布袋穷。\n四海一瓢休未得，青骡谁可借淩风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47651,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西石岩 其一","author":"释今无","text":"洪濛擘破出云窝，石色青葱自郁峨。\n倒挂玉莲钩地轴，平分银汉碍天河。\n月临枢室光先满，路转阴厓穴更多。\n黑帝一碑灵气壮，飞来犹自镇山阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47652,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西石岩 其二","author":"释今无","text":"城西三里泐溪阴，览胜先存避世心。\n湖海岩峦原不少，风尘归客只难寻。\n流霞且酌壶中月，清梦能披物外襟。\n岘首至今传盛事，肯将华鬓换黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47653,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊清远","author":"释今无","text":"九夏行残暑气侵，孤城风雨客途心。\n原非有我忙偏剧，只是投人意便深。\n宿虬划雷惊欲动，湿云过树断还沉。\n廿年万里探奇迹，惆怅而今祇独吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47654,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"持福堂成移植刺桐树 其一","author":"释今无","text":"刺桐移种福堂前，柔干融融带海烟。\n布叶未能遮晓日，开花先爱起枯禅。\n土痕蚀退根初定，雨气侵多色更鲜。\n留得故人遗意在，婆娑吟弄自年年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47655,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"持福堂成移植刺桐树 其二","author":"释今无","text":"五丝续命觉难牢，种树先寻丈二高。\n旋有烟云归户牖，即供吟笑助蓬蒿。\n花开映彻千层锦，风摵喧成八月涛。\n髣髴峄山分异种，淹留名久入词骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47656,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"持福堂成移植刺桐树 其三","author":"释今无","text":"拱把而今正可怜，栽培爱尔大庭前。\n从来有相标无相，此意依然又惘然。\n海上云霞吹雨气，林间星斗照诗篇。\n春深叶密须防护，莫使凄凉叫杜鹃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47657,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"持福堂成移植刺桐树 其四","author":"释今无","text":"中丞道味实纯和，执卷微言析更多。\n未捷戎衣歌薤露，空留山月照藤萝。\n庭森独树难寻梦，天丧斯人可奈何。\n转盻浮生吾亦幻，口碑从此寄岩阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47658,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"持福堂成移植刺桐树 其五","author":"释今无","text":"燕山尚有结茅茨，数载交情一梦辞。\n未丧此心君正活，难忘旧日我长悲。\n寒风有意吹松柏，墓草无情爱别离。\n似种冬青遗恨在，刺桐高发向南枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47659,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"持福堂成移植刺桐树 其六","author":"释今无","text":"万里烽烟白下归，抚棺空自湿征衣。\n重言共过梅花岭，伤逝同嗟弹子矶。\n幸有一龛分佛火，定知遗恨在金微。\n箕星骑得光芒甚，照树年年到十围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47660,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送周瑞长之任程乡","author":"释今无","text":"为官节尚重清贫，此际尤当学古人。\n要使徵输歌孔迩，还昭明恕起斯民。\n芙蓉岸冷行相念，明月高天自可亲。\n欲写一篇循吏传，近来衰懒意空勤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47661,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿戴怡涛太守","author":"释今无","text":"喜见枌榆此日春，笳吹动地羽书频。\n千秋渤海称龚遂，几度舆情得寇恂。\n仙石洞中留日月，蓬山岛外隔风尘。\n旷怀体用能兼备，一斛流霞满酒樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47662,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿金国瑞都阃 其一","author":"释今无","text":"白璧无瑕方寸心，十年岭海振清音。\n行间战垒龙泉壮，夜柝诸门虎钥深。\n鸑鷟舞回蓬岛月，麟麒高夺泰华阴。\n交情千古齐仙佛，意气知君不可寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47663,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿金国瑞都阃 其二","author":"释今无","text":"箫管中宵佐酒卮，不须更问夜何时。\n乾坤落落双旗健，星月煌煌万里宜。\n守道拜除甘执戟，书空劘盾陋题诗。\n登仙惯挟还丹术，炼就刀圭到凤池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47664,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿金国瑞都阃 其三","author":"释今无","text":"閒烧龙脑炙金仙，只手凭君梵宇悬。\n玉笛暗吹梅调冷，碧波频渡月华圆。\n移来椿树遮新甓，唤醒灵犀见别天。\n只道赤松能辟谷，此中底事竟谁传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47665,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿邝檗庵六十一","author":"释今无","text":"满堂香饭结华筵，瞬息流光又十年。\n四海共传高士传，一丘閒卧鹿门仙。\n经纶水石成三径，睥睨戈干笑九埏。\n若月照临龙战后，好将信史为人编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47666,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张母祝词","author":"释今无","text":"蓬莱水色变沧溟，瑞气流光绕户庭。\n刺史旧传龚遂宅，麻姑今见伍乔星。\n文章精义方麟脯，松柏高枝入月棂。\n自有珊瑚支笔架，何须石脑重金瓶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47667,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蔡母祝词","author":"释今无","text":"又见麻姑降蔡家，齐飞三凤拥红霞。\n岛中琪树年年绿，堂上珠帘日日赊。\n青鸟不须归洞口，白云今又沃仙花。\n兰孙满地无馀事，绣佛惟閒爇马芽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47668,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"惜鹤","author":"释今无","text":"九皋心事委平原，毛羽飘零一翮存。\n不向蓬山寻旧侣，且从萧寺宿云门。\n长鸣夜梵侵禅磬，閒啄朝烟破月痕。\n却笑当时华表上，可知何处是归魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47669,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"轻巧莲","author":"释今无","text":"日月初悬色未匀，芙蕖一朵正平分。\n香流银汉寒光澹，水入苍虬紫气屯。\n素羽未藏鹓鹭背，绛纱先作斗牛文。\n远公曾种东林社，迟及江枫送雁群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47670,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜梦也学士与赵铁源典闱见过","author":"释今无","text":"沧海骊珠已尽收，华轩喜得接风流。\n高怀愈觉文光远，标致空宜岭月秋。\n酒入花田潮正满，迹当奇甸赋能酬。\n联舫况有词林客，三笑山门话未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47671,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠杨沛若秋捷","author":"释今无","text":"琥珀香光亦异葩，月中姓字国人誇。\n胸排锦绣遮银汉，笔架珊瑚夺綵霞。\n舞象正开金菡萏，乘槎忽捉玉虾蟆。\n师门最喜侯芭敏，心法传探上苑花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47672,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙卯小雪梦也与赵铁源典闱从敝院还遂抱恙欲不果花田之游予适亦感风寒梦也成二诗因以索和 其一","author":"释今无","text":"绕潭霜菊正相宜，好景依人不暂离。\n何事维摩称卧病，亦同衰秃及秋悲。\n远怀览胜情终急，短杖迎江步已迟。\n况复笳声传海国，几人文酒得追随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47673,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙卯小雪梦也与赵铁源典闱从敝院还遂抱恙欲不果花田之游予适亦感风寒梦也成二诗因以索和 其二","author":"释今无","text":"开怀毕竟是登临，客里奇书且莫淫。\n胠箧舟藏看转壑，炉烟累息见初心。\n禅关欲破修鲸梦，尔雅欣同小雪吟。\n他日南朝天监寺，与君长坐对枫林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47674,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铁源赵典闱见访奉赠一律同入花田携二章见赠用予原韵即于花田叠詶其意 其一","author":"释今无","text":"虚江亭午日犹存，桂楫看花拨水痕。\n太乙使星分地轴，风霓到影入天门。\n平原易起芳时恨，丽句堪招北月魂。\n欲觅草青无处觅，明妃那得有孤村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47675,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铁源赵典闱见访奉赠一律同入花田携二章见赠用予原韵即于花田叠詶其意 其二","author":"释今无","text":"新诗浮海尽先传，万里皇华已极天。\n入寺冷心窥石井，采风蛮语杂秋田。\n衣轻宝地嚣尘远，手绾明珰上国还。\n更询同游方学士，可探还有正中偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47676,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻李紫澜解元秋捷寄此","author":"释今无","text":"云山别后岁空长，此日惊闻折桂香。\n巨笔早曾期雪夜，燕花还喜踏春塘。\n奔云逸足鞭尤健，作赋鸿名志自强。\n我老扶筇频斫额，何时烧茗对匡床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47677,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次方誉子韵","author":"释今无","text":"材华荷笔入文昌，翰苑君家是栋梁。\n联璧慰予频见玉，谈樨期汝独闻香。\n还家客梦悬羊石，过岭梅花覆竹箱。\n万里远游拓心境，始知身世重空王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47678,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送徐武原归白门先定灵谷之约兼寄令兄周来道兄索寄宣纸入岭","author":"释今无","text":"钟山月色寺中梅，最爱山头坐雪堆。\n今日倦游归海国，他年相约共林隈。\n霜花过岭侵行李，松影还家覆酒杯。\n长想阿兄金玉句，肯将宣纸捲诗来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47679,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王观察仲锡以鹿放生赋诗纪之","author":"释今无","text":"鹿苑今朝始识名，几多生意遍山城。\n寻来寺草循幽径，留得微灵听宝经。\n能踏金莲随步出，解衔仙玦此心明。\n养成头角双龙准，骑向芝田月下行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47680,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重九前五日奉陪吴采臣粮宪入雷峰谒天老人","author":"释今无","text":"官閒喜与野人同，欲叩真机访远公。\n江卧爱当中夜月，山行恰值九秋风。\n寒鸥映水微微白，短蓼迎船款款红。\n棒喝醒人今莫醒，此时沉醉即英雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47681,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴采臣粮宪约同入雷峰官舟先发","author":"释今无","text":"芙蓉蘸水曲江逢，逸兴遄飞过碧淙。\n先我锦帆分野色，知公新趣逗樊笼。\n排云击节波千顷，策杖寻僧月一峰。\n终岁鼓鼙人事改，相随真觉此情浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47682,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和舟行即事","author":"释今无","text":"秋气才深万木降，云涛轩豁失幽窗。\n陈琳有檄谁操管，庾亮移尊已入江。\n词客多情看水鸟，荒村乱后少山狵。\n三星的铄鱼龙睡，一阵笙歌咽玉缸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47683,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采臣粮宪与社中诸公赴出泉梁吟草堂雅集之招予偶从雷峰便道亦与其盛奉和二律 其一","author":"释今无","text":"便从山径趁芳菲，为问参军白板扉。\n才羡玉麟机独敏，筵邀金马客原稀。\n娇娥半额花为国，宝鸭沉香月满帏。\n按节夜凉心已适，白云偏爱逐人飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47684,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采臣粮宪与社中诸公赴出泉梁吟草堂雅集之招予偶从雷峰便道亦与其盛奉和二律 其二","author":"释今无","text":"花黄月白暮烟霏，甓社珠浮白玉扉。\n乱后相逢人独好，歌中欢绝事还稀。\n谁探铃匣金盈手，莫采芙蓉香满帏。\n为倩长房施妙术，壶间迟放一乌飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47685,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和回舟花田小憩 其一","author":"释今无","text":"兰浦停舟兴未孤，花田累累接平芜。\n烟波凭吊推高士，冰雪丰神认藐姑。\n潦倒客星贪夜饮，光芒剑气逼云衢。\n珊瑚出水原因网，未必能閒是魏珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47686,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和回舟花田小憩 其二","author":"释今无","text":"已抛竹杖不须扶，线断芒鞋脚也无。\n瀹笋兴能添此际，寻花人自费工夫。\n昨宵月窟醒如梦，今日荒原梦亦苏。\n爱杀短莎江上绿，曲肱吾且任真吾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47687,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴采臣粮宪吊素馨墓","author":"释今无","text":"香骨全消化紫霓，千年陈迹草萋萋。\n冰衫尚怯花魂薄，月影还疑雪夜迷。\n长袖风难回白日，时王力不到黄坭。\n芙蓉岁岁秋江上，一度来僧惜杖藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47688,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴采臣粮宪九日书怀 其一","author":"释今无","text":"秋江云物向人佳，转觉空濛动素怀。\n九陌行尘驱铁马，三山仙路隔芒鞋。\n鲈莼不用催归桨，蒟酱聊同赋水涯。\n海上青骡原健足，肯教身世叹秦淮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47689,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴采臣粮宪九日书怀 其二","author":"释今无","text":"暂时抱膝此情佳，落落丹枫伴客怀。\n赋就江南文思拙，望穷塞北雁行乖。\n岛中日月留银瓮，世上风尘惜铁鞋。\n洞鹤不来金薤冷，敲冰谁热品头柴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47690,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何鸣玉宰曲江","author":"释今无","text":"九成台畔见来仪，云际双凫自在飞。\n锦是天孙原巧制，花逢韶石更芳菲。\n十年鹾竹称明敏，一路琴声彻翠微。\n万里乍逢忻送别，白云珠海愿非违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47691,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿汪汉翀","author":"释今无","text":"乍归万里旅魂惊，喜向华筵祝寿星。\n古道自能添语笑，长生谁得学仪型。\n金炉火煖堪怡悦，碧海波腾几变更。\n国论文章推一席，商山谁逐采芝行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47692,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿吴采臣粮宪","author":"释今无","text":"仙郡开初绕径香，罗浮佳气入春光。\n隋珠词赋名偏重，粤甸烟云望独长。\n坐听鸡声深国计，暗消民瘼引清觞。\n蓬山一路笙箫起，只在鸿才玉署旁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47693,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀焕之连阳","author":"释今无","text":"徵兵羽檄急连阳，清啸刘琨引盻长。\n投分十年乾茗碗，求仁三月凛秋霜。\n鸟啼夜垒云侵槊，气薄长蜺酒满觞。\n自是经纶本邹鲁，不从利钝苦商量。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47694,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日","author":"释今无","text":"庾关几度躝旌旗，驿使萧条去马迟。\n入梦故人惊夜枕，乞油双衲阻归期。\n海螺雉堞催烽火，香草郊原长乱离。\n藿食自无廊庙意，不知衰病欲何之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47695,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏面壁初祖 其一","author":"释今无","text":"海国何尝问水程，风涛历尽不知名。\n已无我相堪留石，解学人言总是鹦。\n休向水痕笼日月，都提木偶辨逢迎。\n神光急犯西来手，已拔心头黑暗旌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47696,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏面壁初祖 其二","author":"释今无","text":"梁园魏苑不多程，一别无人识姓名。\n月里兔归原羿妇，罗中人语是秦鹦。\n刊山琴斧须难折，入海狂波莫乱迎。\n兀兀微微相非相，天龙长此护云旌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47697,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏面壁初祖 其三","author":"释今无","text":"灵降尽说有归程，觌面何须设异名。\n吠日固多川地犬，爱毛浑堕陇山鹦。\n雷轰殿角疑难听，剑落岩头未易迎。\n一夜雪光偷髓去，只留残壳卓金旌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47698,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏面壁初祖 其四","author":"释今无","text":"儒林原自逊朱程，真宰何尝有定名。\n偶聚千花薰塔石，曾闻一偈悟神鹦。\n每思岳麓终难继，自入熊山不可迎。\n酷似报知求剑者，刻舟留画记云旌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47699,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿徐浩然方伯","author":"释今无","text":"紫薇星更耀中天，万象澄新散晓烟。\n南服久歌文种治，大农原著茂先贤。\n三山仙列慈仁长，十载僧怀德泽偏。\n最喜流霞逢晋爵，台莱声满藕花船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47700,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"六贞词","author":"释今无","text":"碧天无路水无情，六朵芙蓉一夜倾。\n未信香魂能啖虎，须知烈魄已干星。\n黄金乱世人难得，红粉捐生事易轻。\n好向苍梧最深处，几多衷曲诉娥英。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47701,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"祝词","author":"释今无","text":"谁知谯火别然犀，蝶梦华胥一样齐。\n范蠡有船千顷月，商山无伴一枝藜。\n人间胜事知俱幻，世外良缘渐不迷。\n桂树玉堂留懿业，便应随意步丹梯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47702,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春风 其一","author":"释今无","text":"郊外閒田十亩宽，竹窗孤坐到更阑。\n长鸣檐马听无倦，乍过山花不耐看。\n浊酒客添烦思满，幽香僧爱石楼寒。\n微微几阵黄梅雨，随意莓苔上石坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47703,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春风 其二","author":"释今无","text":"月明小立爱纷披，数九初停境物移。\n雁翅暖归过岭候，炉烟断见入帘时。\n梅花落地飘还起，凤尾捎云薄易知。\n欲煮一瓯春露茗，将铛悬向白莲池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47704,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏水 其一","author":"释今无","text":"鸟击三千入太清，巢风驻月动尤明。\n能歌壮士悲燕史，易堕孤忠撼楚城。\n洗药故山空有梦，浮花洞口自无情。\n春深藻荇频频绿，拟棹轻舠自在行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47705,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏水 其二","author":"释今无","text":"捧出莲花绿玉香，微茫积气接天长。\n但逢七夕填灵鹊，每爱孤吟泛野航。\n浸润功分归汉渚，桔槔声歇息斜阳。\n月明仙掌融融湿，曾向方珠里面藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47706,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿张致堂学宪 其一","author":"释今无","text":"太乙光分照岭头，金陵风雪逐仙舟。\n流霞共醉江花冷，野鹤长鸣古渡秋。\n烽火一回悲地轴，文章八代贵天球。\n鸿儒自有操持力，独拥皋比意莫酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47707,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿张致堂学宪 其二","author":"释今无","text":"羽檄分驰校士中，天涯霜雪鬓边同。\n忧时未易消乡梦，搦管尤深识化工。\n孺子受恩收棫朴，何年报德答沙虫。\n安期岩上清风起，枣色离离映远虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47708,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]