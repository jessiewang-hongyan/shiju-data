[{"title":"为园四首 其三","author":"欧大任","text":"一丘亦自足烟霞，不以萧条负岁华。\n草市纵非江总宅，橘洲何论李衡家。\n中山但可求醇酒，小队谁期过浣花。\n海雁南飞新朔气，夜来霜已满蒹葭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8002,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为园四首 其四","author":"欧大任","text":"赤花洲曲入沧溟，屋里山移碣石青。\n江革坐持菩萨戒，扬雄归守太玄经。\n三千水击犹抟羽，四百峰疏好勒铭。\n筋力傥能从父老，荷锄吾欲斸松苓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8003,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"家弟经季初度日予适还山酌酒为寿","author":"欧大任","text":"吾弟知非岁已添，藏真事事总能兼。\n太医脂习称中散，高士华陀本孝廉。\n碧海为瀛通曲渚，青山如岱满前檐。\n归来寿汝梅花下，玉照茅家二老髯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8004,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗怀仁隐居","author":"欧大任","text":"华盖山前候小车，向予惟指海边霞。\n已知到溉曾移石，不羡东陵旧种瓜。\n晋室铜鞮公子贵，荆州茅屋隐人家。\n由来尺五归时论，更看城南树树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8005,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答左司马汪伯玉见寄","author":"欧大任","text":"抽簪岂论七宜休，千里偏劳问隐侯。\n书去何能酬缟带，人归空自老菟裘。\n东山秀色占君起，南岳幽居待我游。\n他日蘼芜还可寄，楚云飞度歙江秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8006,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵洲山寺送戚少保还东牟 其一","author":"欧大任","text":"纳节东归兴自超，旂常勋业在三朝。\n黄金铸印频成鹊，白马鸣鞭惯射雕。\n去问精庐书带草，钓从沧海木兰桡。\n浣花我亦投簪客，独向江村老寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8007,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵洲山寺送戚少保还东牟 其二","author":"欧大任","text":"楼船郁水路初分，鹅鹳春洲讵可闻。\n细柳旧逢周太尉，武陵今送马将军。\n江南鼓吹歌黄鹄，岭外旌旗袅白云。\n一代登坛谁得似，中原何日不思君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8008,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄芾斯宗侯","author":"欧大任","text":"豫章千岁冠洪都，忽向西堂涌坐隅。\n汉姓谁能称祭酒，周家犹得拜司徒。\n鹤来缑氏青丝辔，醑出河东白玉壶。\n我上罗浮为君寿，肯将鸿宝寄潜夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8009,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜次羚羊峡口","author":"欧大任","text":"端溪泊舟处，今夕待秋风。\n落叶江波上，啼猿峡雨中。\n曙将催榜枻，凉已到梧桐。\n不用津人识，藤蓑自钓翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8010,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入峡","author":"欧大任","text":"一峡束江水，千峰不可攀。\n庐皆匡氏宅，壁似谢公山。\n有迹游方外，何心出世间。\n倘逢乘鲤客，明月棹歌还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8011,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仙花寺逢竺僧坚公","author":"欧大任","text":"浮海南来已几年，问师何者是单传。\n法门不二无文字，岂必西天更有天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8012,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王宪副宗鲁见邀崧台改席阁上","author":"欧大任","text":"阁道逶迤百级来，名山况是古崧台。\n江中鹅鹳低凭槛，峡里鱼龙对举杯。\n兵偃尚谈司马法，赋成谁似大夫才。\n与君细数长安日，极北风烟首重回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8013,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大司马督府吴公召饮端州行台","author":"欧大任","text":"幕府邀宾绮席光，分庭人出浣花堂。\n铙吹夜看江头月，帐饮秋飞峤外霜。\n奏曲已逢刘越石，注书谁似杜当阳。\n不缘折节相留意，谁遣宵阑更进觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8014,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠大司马中丞连江吴公四首 其一","author":"欧大任","text":"上台星与法星齐，尺一亲劳圣主题。\n为赋建櫜江左右，朅来赐履粤东西。\n开尊词客犹漳滏，吹笛门生似武溪。\n可及千金称寿日，中朝还待锡玄圭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8015,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠大司马中丞连江吴公四首 其二","author":"欧大任","text":"竹使当年洛下看，吴公治行甲长安。\n七闽阀阅书盟府，五岭风云护将坛。\n扶木津连南海徼，老人星照惠文冠。\n沧波欲酌为春酒，持向崧台介寿欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8016,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠大司马中丞连江吴公四首 其三","author":"欧大任","text":"严城晴霭昼氤氲，玈矢彤弓见策勋。\n海截东南秦一尉，关通吴楚汉诸军。\n苍茫斗下双钩气，咫尺天边五色云。\n盛代疏封推季重，岂惟名擅建安文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8017,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠大司马中丞连江吴公四首 其四","author":"欧大任","text":"开府谁如百粤雄，远劳司马出临戎。\n诏从淝水徵安石，恩下平舆拜晋公。\n清啸每逢江月上，新诗多在射堂中。\n芝苓正有延年祝，握管何人解勒功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8018,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郑朱二郡侯邀饮澄江阁","author":"欧大任","text":"卜夕邀欢就客居，使君连骑兴何如。\n行厨载有吴兴酒，秘简探来越绝书。\n月出遥津波浩渺，凉生虚阁竹萧疏。\n东南明牧雄边徼，岂但山城得孟舒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8019,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅庵","author":"欧大任","text":"西来浮海后，獦獠起南邦。\n悟得心为印，经行法是幢。\n拈花看几叶，现月散千江。\n独有唐年凿，寒泉下石淙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8020,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石室山","author":"欧大任","text":"云深南斗墟，朱草半凋疏。\n洞长三花树，山藏二酉书。\n良常曾不远，宛委更何如。\n纵检残编在，惟堪老荷锄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8021,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沥湖","author":"欧大任","text":"杖从紫竹洞，津口问湖船。\n笭箵收凉雨，跏趺向晚烟。\n隐无郫上宅，耕少汶阳田。\n便可移家去，渔歌共岁年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8022,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游七星岩","author":"欧大任","text":"积金削壁引巑岏，洞府谁知日月宽。\n三竺烟光当晓出，九华江色入秋寒。\n天窗渐豁山犹屋，地肺潜通谷亦盘。\n我欲岩栖星是客，不妨人作少微看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8023,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛舟过流霞岛遂登阆风岩","author":"欧大任","text":"洞頫穹窿一岛开，棹歌曲曲共沿洄。\n风帆上下浮蓬苑，露掌东西矗菌台。\n泛黛乍从丹浦落，飞霞半自赤城来。\n游人岂解金声句，知有梁园赋客才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8024,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莘儿侍游三洲岩","author":"欧大任","text":"神仙窟宅在，海涌一坡陀。\n狮象银为阙，鱼凫雪作波。\n山将通句曲，江可上牂牁。\n玉斧从吾后，升真路若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8025,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南江口至水瓜营李裕德苏文甫章弟莘儿舟饮","author":"欧大任","text":"望中泷水郡，道是古蛮城。\n篁竹深犹避，薪蒸搉未平。\n笋菹供客食，花布襁儿耕。\n野酌烟岚里，邮签问去程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8026,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"连滩砦讯罗定风土寄王兵宪索平蛮碑","author":"欧大任","text":"兴尽非关道路难，两山烽息久平安。\n游人茉莉簪藤帽，上客槟榔荐竹盘。\n疆理更开周日月，井闾今有汉衣冠。\n西行不索图经去，愿借韩陵片石看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8027,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"经罗旁山下","author":"欧大任","text":"烽火楼前十万山，蓬婆滴博在云间。\n凯歌留得南征曲，犹记将军破寨还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8028,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王兵宪邀泛沥湖登石洞再至七星岩","author":"欧大任","text":"胜游宁但晋东嘉，星渚南来又一槎。\n天际云为江上树，烟中山似洛阳花。\n何年飞石犹存洞，几处开林不带霞。\n衮绣亦知难久驻，耕樵堪自寄吾家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8029,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"从海上至香山涂明府汝光置酒","author":"欧大任","text":"百里神君一见难，会稽父老肃衣冠。\n船从锦海洲前入，琴听仁山院里弹。\n对酒已欢良夜醉，种花偏得满城看。\n归人渔弋今怀惠，何限烟霞隐谢安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8030,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题朱履方青藜阁","author":"欧大任","text":"小侯今秀颖，开阁更何如。\n梦已持镂管，名宁减灌蔬。\n校文中垒后，给札尚方馀。\n太乙来然火，应能问著书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8031,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送潘子素游太学","author":"欧大任","text":"书剑乘春去，潘郎正少年。\n宾鸿新起粤，图骏尽归燕。\n玉渚波犹雪，金堤柳欲绵。\n旧游俱在眼，槐市赤丝鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8032,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"侯大参东郊别业","author":"欧大任","text":"挂冠神武是何年，岳伯归来乐事偏。\n未少山中千岁侣，共知林下一人贤。\n黄花浊酒秋开径，紫绮沧洲月满船。\n舒啸东皋还倚杖，青冥鸿鹄去翩翩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8033,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日过唐寅仲青门隐居同梁彦国邓君肃赋得高字","author":"欧大任","text":"种秫归来客是陶，隐居君亦掩蓬蒿。\n山中此日开荒径，门外何人载浊醪。\n井里东临沧海近，风烟西望汉台高。\n过从爱有浔阳侣，白首篮舆未惮劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8034,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄张希周明府","author":"欧大任","text":"西望湟溪欲溯源，寿星光烛太微垣。\n赋归蚤去称彭泽，投老遗安似鹿门。\n静福山开藏剑石，昌黎台傍读书园。\n伏生经学曾同授，黄发庞眉道更尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8035,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天尺楼为陈方伯玉叔赋","author":"欧大任","text":"丹霞缥缈起觚棱，赐有丝纶在上层。\n韦杜家声天最近，崔庐门第日方升。\n秘文万卷题宛委，遗草千秋出茂陵。\n湖海未论豪气在，祇凭绳武佐中兴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8036,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杨黄门江库部奉命校文还朝八首 其一","author":"欧大任","text":"阊阖晴开五色云，敕符南校粤中文。\n九成台下如观乐，一奏薰弦答圣君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8037,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杨黄门江库部奉命校文还朝八首 其二","author":"欧大任","text":"青琐夕郎司马公，双旌遥度峤云红。\n南中桂树谁称赋，江总杨脩是国工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8038,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杨黄门江库部奉命校文还朝八首 其三","author":"欧大任","text":"天球翠釜并辉光，大贝文犀入越装。\n遣诣公车随计吏，汉家今待奏长杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8039,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杨黄门江库部奉命校文还朝八首 其四","author":"欧大任","text":"黄金高筑古台名，蹀躞霜蹄万里行。\n剪拂劳君增价去，一时飞骑满神京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8040,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杨黄门江库部奉命校文还朝八首 其五","author":"欧大任","text":"陆贾何年自粤回，至今汉使馆重开。\n鲛鱼孔雀宁堪献，似有明珠照乘来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8041,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杨黄门江库部奉命校文还朝八首 其六","author":"欧大任","text":"日射扶桑海色秋，西风初起尉陀楼。\n飘飘使节淩寒入，万国冠裳会帝州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8042,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杨黄门江库部奉命校文还朝八首 其七","author":"欧大任","text":"剑悬明月照芙蓉，尊酒离亭思万重。\n看尔趋朝乘驷马，不堪南斗望双龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8043,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杨黄门江库部奉命校文还朝八首 其八","author":"欧大任","text":"碣石谈天雪欲寒，部中星使向长安。\n傥思五岭经行地，驿寄梅花岁岁看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8044,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"后九日小园登阁志感","author":"欧大任","text":"闰双重把菊，三十九年来。\n篱下酒不至，江头雁独哀。\n身曾随几杖，迹已落莓苔。\n惟有河山在，依稀戏马台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8045,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"至后同侯李诸公浮丘迟汪侍御","author":"欧大任","text":"朔吹联镳度曲陂，入山宁怨得归迟。\n二云深护朱明馆，诸水潜通阿耨池。\n井渍石苔留鹿迹，亭空岩菊照鸱夷。\n客来岂但霜威促，黄发堪从谢傅期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8046,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜同陈大参郑冼二别驾陈明府陈都护集陈少参明佐西第","author":"欧大任","text":"银烛铜槃起绛烟，寒威不到玉缸前。\n周旋忽共衔杯夕，慷慨何如揽辔年。\n绿绶可能搴薜荔，青山犹得奉櫜鞬。\n即看蒋诩开三径，岂乏风流二仲贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8047,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同陈大参道襄梁佥宪思立陈少参明佐夜饮陈都护忠甫宅","author":"欧大任","text":"将军猎后灞亭寒，磬折邀宾兴倍欢。\n桂树似招岩畔隐，梅花偏爱月中看。\n割鲜僮每持铜斗，下食儿能进玉盘。\n沈醉不知霜霰过，箜篌犹向夜深弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8048,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕集朱氏兄弟山下草堂得歌字","author":"欧大任","text":"宝马骖驔十里过，九枝灯里丽人多。\n城临花月春江曲，风袅笙箫子夜歌。\n坐密羽觞行未已，醉深玉漏问如何。\n社中诸少忘吾老，犹自牵情洽薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8049,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄浔州陈郡丞","author":"欧大任","text":"君求勾漏几年游，关内何如万户侯。\n黔北路犹通郡郭，粤南人自忆江楼。\n襜帷乍出湘漓月，羽扇曾挥骆越秋。\n信美亦知深恋阙，赋成宁但胜荆州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8050,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王侍御唯吾谪判兴国州","author":"欧大任","text":"千里周阹广上林，汉家词客几虞箴。\n麒麟未引朱门献，獬豸犹驰白简心。\n下雉路偏臣职远，旅獒书在主恩深。\n贾生不是长沙日，莫向沅湘作楚吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8051,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答朱廉宪秉器蜀中见寄","author":"欧大任","text":"书来闻已入长安，马首西山雪未残。\n词赋三朝推握管，风云一日起弹冠。\n君歌沧海邮中寄，我忆峨眉梦里看。\n纵有八行那可去，衡阳南下雁应难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8052,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得周使君国雍书却寄","author":"欧大任","text":"使者巴西雨雪中，犹题尺素付归鸿。\n即看草奏明光近，何似驱车峻坂雄。\n童子自能迎郭伋，诸生谁不待文翁。\n他时若问扁舟客，秋色江头万树枫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8053,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄吴明卿","author":"欧大任","text":"别矣金陵岁两徂，怀人落日在江湖。\n游曾太室周封史，赋似湘潭楚大夫。\n澹荡容余闲弄钓，峥嵘知尔老操觚。\n尺书远寄衡阳雁，不道天南是海隅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8054,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午日泛舟登海上台观竞渡得峰字","author":"欧大任","text":"西望湘灵上小?，涉江因得采芙蓉。\n桡前涛白将千里，瑟里云青第几峰。\n萧飒羽飞犹似鹘，参差鳞起半成龙。\n沧洲不是昆明日，徙倚何妨听暮钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8055,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄郑武缘","author":"欧大任","text":"白下一相别，俄更五岁华。\n广文曾学士，高密故名家。\n闻蹑王乔舄，知求葛令砂。\n山应藏郁石，江自合横槎。\n远浦三湘竹，清斋八桂花。\n题诗如问我，秋色在蒹葭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8056,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈贰府及乡旧司理吾郡自浔州还晋江过五羊送别","author":"欧大任","text":"载得西来石似冰，送君吾亦出支藤。\n法曹郡比都官署，蛮部人歌太守丞。\n竹马纵难期郭伋，莼鲈何事老张鹰。\n泉南知有求羊待，九日山头第几层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8057,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"费郡丞民益思恩书至","author":"欧大任","text":"蛮府迢迢折寸心，娵隅谁得寄西音。\n云霄紫闼频相忆，烟水青溪不可寻。\n坐绾银章千里隔，书来铜柱万山深。\n爱君寥廓衿情远，何必金门是陆沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8058,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日龟山宴集得身字","author":"欧大任","text":"家园重九物华新，济胜犹扶病后身。\n杖舄偶随探菊客，烟霞闲作佩萸人。\n开林十笏青莲社，临海千帆白马津。\n一醉蓝田还此日，不妨鱼鸟更相亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8059,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赵郭八景为郭学宪舜举赋 其一 红杏春风","author":"欧大任","text":"种得匡山片片霞，蓬莱使者问君家。\n至今九炼丹砂熟，犹似溪头万树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8060,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赵郭八景为郭学宪舜举赋 其二 新桥夜月","author":"欧大任","text":"华表何年鹤更回，仙人楼倚郁蓝开。\n缤纷月里金支导，曾向溪桥半夜来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8061,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赵郭八景为郭学宪舜举赋 其三 大树团阴","author":"欧大任","text":"参天黛色忽千寻，掩映房栊十里阴。\n桂崦不知淮曲远，花源将入武陵深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8062,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赵郭八景为郭学宪舜举赋 其四 杨湾漾碧","author":"欧大任","text":"烟笼杨柳夹堤生，渺渺汀洲碧浪平。\n何必山阴道中过，兰桡堪放酒船行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8063,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赵郭八景为郭学宪舜举赋 其五 语水渔舟","author":"欧大任","text":"禦儿溪溯越来溪，舟子鸣榔水鸟啼。\n沽酒夕阳歌欸乃，鸱夷何事五湖西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8064,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赵郭八景为郭学宪舜举赋 其六 斜林牧笛","author":"欧大任","text":"会稽人去谢浮名，曾著貂裘采药行。\n醉后骑牛吹短笛，西林今听两三声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8065,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赵郭八景为郭学宪舜举赋 其七 净寺晓钟","author":"欧大任","text":"曙色鸣钟曲槛凭，隔林经梵听山僧。\n宰官身亦称居士，为问西来第几灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8066,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赵郭八景为郭学宪舜举赋 其八 邬泾暮雪","author":"欧大任","text":"洛塘风急玉虹飞，泾上柴门客到稀。\n春入江南梅正早，马头新折一枝归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8067,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]