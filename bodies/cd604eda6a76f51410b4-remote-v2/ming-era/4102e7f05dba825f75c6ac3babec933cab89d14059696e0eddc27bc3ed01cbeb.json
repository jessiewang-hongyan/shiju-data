[{"title":"阙下遇沈纯甫召入为比部郎","author":"欧大任","text":"别君携手上河梁，紫陌何期遇骕骦。\n共议南方勾漏令，朅来西省尚书郎。\n青云世态看蓬鬓，浊酒交情忆草堂。\n惟羡王褒才最异，赋成须早献明光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6865,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送霍观察勉衷理江西屯盐","author":"欧大任","text":"谁向明时荐朴忠，满朝尽道似先公。\n豸冠吴楚名偏重，龙剑江湖气更雄。\n盐铁早收文学议，屯田终见老臣功。\n君今已出吾将隐，一榻西樵未可同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6866,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重阳前一日同丘谦之朱子得二民部康裕卿管建初二山人登毗卢阁饯吴明卿","author":"欧大任","text":"寥廓飞楼并倚阑，十年今复醉长安。\n天连大漠三边尽，秋入渔阳万里寒。\n恋阙班行疲执戟，托交名姓庆弹冠。\n谁知明日龙山色，白露金茎别后看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6867,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日同朱民部王太仆集李宛平后堂玩菊","author":"欧大任","text":"三人司隶青骢马，明府同时此会难。\n地引关河秦内史，秋高钟鼓汉长安。\n南阳潭似樽中色，彭泽花开县里看。\n莫笑鬓丝樗散客，旧游能得几交欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6868,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送袁文谷宰黄岩","author":"欧大任","text":"片玉名高重士林，分符今惬壮游心。\n台旁城似标霞起，海上山藏委羽深。\n包橘出村犹越贡，裹盐登市半闽音。\n弦歌百里神明宰，入奏君王更赐金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6869,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄宪副文断调守衢州","author":"欧大任","text":"闽山粤徼借澄清，何事褰帷复此行。\n岂谓季公蒙毁誉，转令黄霸著功名。\n縠溪船上千家渡，姑蔑旗搴百丈城。\n计日外台君执钺，循良还召入西京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6870,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴大参明卿还大梁 其一","author":"欧大任","text":"嵩祝声中阊阖开，秋深青锁暂徘徊。\n枚生游自梁都重，驺衍谈从碣石来。\n十载侍臣称赋客，一时方岳尽卿才。\n掀髯转觉关河远，可是风流在吹台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6871,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴大参明卿还大梁 其二","author":"欧大任","text":"重逢司隶典章新，共是三朝健在身。\n昔日悲歌吾叩角，少年封事尔批鳞。\n斗鸡乍别诸陵客，控鹤将寻二室人。\n醉后都亭分手去，岂堪华发向风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6872,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送谈参军思重请告还无锡","author":"欧大任","text":"五陵宾客尽朱幡，疋马乘秋下蓟门。\n书奏乍辞骠骑府，风流不数辟疆园。\n青山病起邀棋局，华发归来傍酒尊。\n纵有五湖宁久住，知君犹恋汉宫恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6873,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"颐虚草堂","author":"欧大任","text":"谢却浮名赋遂初，功多定性得澄虚。\n一经箧里韦家业，几卷床头老氏书。\n舍筏已知登彼岸，考槃真自爱吾庐。\n龙津鹭渚能来往，何日扁舟信所如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6874,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅宪副天逸阁","author":"欧大任","text":"宣州草阁傍山开，家是都官旧姓梅。\n宛水雪从江涨下，敬亭云向郡城来。\n清尊自许能逃世，华发宁论未尽才。\n谁羡诸荀名汉代，高阳今更表崔嵬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6875,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"颁历","author":"欧大任","text":"庭燎高照殿东头，玉历初颁拜冕旒。\n蓂荚自能知晦朔，竹书何但纪春秋。\n漕船半议沧波转，弩骑新归大漠游。\n三五泰阶今可奏，侍臣谁最似吾丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6876,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"敬观高庙御容于临淮侯家因见曹国公铁券遗像","author":"欧大任","text":"千年草昧识龙颜，一代君臣想像间。\n亲以舅甥周肺腑，盟同带砺汉河山。\n鼎湖日月开钟阜，甲帐风云出玉关。\n奕叶勋劳麟阁上，至今貂冕尚崇班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6877,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送袁光禄邦表归葬太宜人合先大夫兆域","author":"欧大任","text":"啼乌万里怆悲襟，薤露西风岁又阴。\n九垄松楸儿泪尽，三朝纶綍主恩深。\n延陵碑古镌成玉，石窌封存郁似林。\n絮酒何人来下马，白茅应慰介休心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6878,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送丘计部谦之出守潮州二首 其一","author":"欧大任","text":"省郎四十已专城，忼慨何妨度岭行。\n綵笔长安传赋草，铜符沧海借才名。\n鱼龙久避戈船战，粳稻新收甲士耕。\n下教应知求赵德，州人不用更谈兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6879,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送丘计部谦之出守潮州二首 其二","author":"欧大任","text":"万里风云一据鞍，天边旌旆渡桑乾。\n酒人西送犹燕筑，使者南行尚汉冠。\n翡翠越裳簪玉暖，荔枝炎海椀浆寒。\n青山处处襜帷色，竹马津头夹道看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6880,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春草亭为谢录事赋","author":"欧大任","text":"十年圭组事沉冥，谢客风流复此亭。\n梦里棣华双树秀，诗中草色一池青。\n名山岂但题三谷，别墅应知胜始宁。\n况有羊何能共和，扁舟吾欲问烟汀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6881,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恭候圣驾出郊视牲","author":"欧大任","text":"千官警跸下斋宫，圣主郊禋秩祀崇。\n碑丽牺牲严在涤，邸行琮璧待升中。\n登坛似见燔柴上，灌玉因知陟降同。\n闻道礼图黄阁奏，甘泉堪自老杨雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6882,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答朱子深见寄","author":"欧大任","text":"南浦亭前雪满舟，别来犹揽黑貂裘。\n诗羞匡鼎为文学，交得平原是列侯。\n碣石雁声延阁夕，江门帆影爽台秋。\n八公山过长淮近，招隐何年桂树留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6883,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"讯杨懋功姚安解归","author":"欧大任","text":"割炙酣歌过几春，诙谐曾是汉庭臣。\n一麾拥去惟书笥，五斗抛来有葛巾。\n发愿乍从庐阜社，解归何但汝南人。\n芙蓉十里秋无恙，尚可江头事隐沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6884,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄陈宪副于韶","author":"欧大任","text":"朔风吹雁过城头，解摈知君在阆州。\n蜀栈梦悬千里月，巴山寒照一江秋。\n正看太液飞黄鹄，何事沧波弄白鸥。\n客有张衡今珙赋，岷嶓西望不堪愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6885,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答朱孔阳","author":"欧大任","text":"忆从江上访精庐，尺素频劳寄鲤鱼。\n十日石尤思尔酒，一官天禄校何书。\n公孙出处怜垂老，中散风流愧不如。\n飞盖西园知爱客，章门何但似漳渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6886,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答邵长孺李季常淮南见寄","author":"欧大任","text":"二子谈诗大历间，少年名字动江关。\n剑看斗下雌雄气，雅似淮南大小山。\n绿酒尚思黄篾寺，白头犹恋紫宸班。\n广陵何日扁舟去，得与袁郎共载还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6887,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄顾郁林玄言","author":"欧大任","text":"璨山词客已名家，二酉书成鬓未华。\n地历铜标辞印绶，园开锡浦卧烟霞。\n郁林只载孤舟石，勾漏曾求五釜砂。\n笑是岁星犹避世，欲从海上醉桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6888,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"皇极门贺蓟辽奏捷是日安南入贡","author":"欧大任","text":"圣朝端冕戢兵戈，露布东来喜气多。\n黄竹不闻天欲雪，越裳今奏海无波。\n市还沙苑迷骐骥，战后都城满橐驼。\n万里谷蠡看扫荡，甘泉烽火听铙歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送苏光禄子川倅巩昌","author":"欧大任","text":"西征朔气自萧萧，巩树东风待使轺。\n戊己屯兵中校尉，春秋趣对圣明朝。\n款关胡部多随马，捕虏羌儿惯射雕。\n何事词人监郡去，将因投笔似班超。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答李伯承见寄","author":"欧大任","text":"遂初赋就竟东归，词客宣城蚤拂衣。\n河水寒流通别墅，钓台疏柳护渔矶。\n鸦啼曙色鄄原过，雁起秋风濮上飞。\n千里尺书能问讯，长安何处望柴扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答程子虚登吴虎臣飞云楼见怀因寄丰干诸子","author":"欧大任","text":"吴家楼上飞云还，万里罗浮在此间。\n别后君曾呼白酒，梦中吾每驻青山。\n已知慧远新开社，愿学刘伶善闭关。\n寄与江南故人道，朔风萧飒鬓毛斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曾少参关中致政遂封中丞七十初度遥有此寄","author":"欧大任","text":"何年解组自西归，赤钺彤弓照紫薇。\n气似青牛关内过，歌曾白雪郢中飞。\n驻颜不待餐金液，绕膝惟看舞綵衣。\n从此著书堪百岁，笔床深傍钓鱼矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张武库巡延宁甘固诸边","author":"欧大任","text":"六传旌旗万里行，黄河西抱汉边城。\n不因拊髀过郎署，谁遣飞书夺虏营。\n揖客缓驰骠骑幕，材官分隶羽林兵。\n五原岂用看烽堠，扼腕年来更请缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6894,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴宗高解官归毗陵","author":"欧大任","text":"挂冠神武出燕都，不握汀州使者符。\n诗卷尽题名下士，俸钱堪施酒家胡。\n归舟冲雁过防坞，落日停云满具区。\n世有延陵今未乏，柴门高枕著潜夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6895,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王符卿敬美携酒同石廷尉拱辰见过","author":"欧大任","text":"山色西来紫气屯，一时词客满柴门。\n趋朝石奋迂车骑，乘兴王猷载酒尊。\n坐奉清言都讲舍，斋分寒食给孤园。\n持觞醉问风尘事，尚有藤萝足避喧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6896,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王僚长邦举司理瑞州因归泉州省觐","author":"欧大任","text":"九年旅服寄燕阳，衣彩趋归问草堂。\n筵取武夷云作幔，酒分沧海月为觞。\n梅花官阁题何逊，薤叶山斋礼任棠。\n曾是平津门下客，相将鸣佩忆鹓行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6897,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送胡侍御明卿补令襄垣","author":"欧大任","text":"都亭人识鲍家骢，出宰今看潞子雄。\n上党北连三晋外，浊漳西入九河中。\n尚方舄在朝常早，司隶章来步逾工。\n召对主恩原不薄，玉珂春色阙门东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6898,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送曾京兆转大中丞巡抚贵州","author":"欧大任","text":"开府黔阳万里遥，西南天地画铜标。\n尽令槃瓠安蛮落，自昔牂牁奉汉条。\n羽扇麾兵丞相垒，铙歌帐饮侍中貂。\n都人岂但思京兆，剑履何年入圣朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6899,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王敬美使秦","author":"欧大任","text":"张旃西去赋皇华，朱邸筵开帝子家。\n汉使简书惟笔札，秦城楼阁半烟霞。\n明星夜照芙蓉锷，白马秋嘶苜蓿花。\n计日郊迎携斗酒，莫令相忆滞天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6900,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄张助甫","author":"欧大任","text":"魏阙重来气色新，一时推毂起沉沦。\n暂劳分陕犹雄长，谁念游梁已倦人。\n折柳不堪千骑雨，看花又过五陵春。\n尺书经岁关门隔，目送飞鸿尽向秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6901,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘太史衍亨奉使韩藩因还任丘为尊公寿","author":"欧大任","text":"天书捧出建章宫，西望金城百二雄。\n秦地诸王符是玉，汉家使者佩成虹。\n关门曙色青云上，陇树秋风紫塞东。\n君著赐衣行戏彩，归持彤管奏回中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6902,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘太史子良册封周府","author":"欧大任","text":"词臣握节向中原，帝宠亲藩玉册尊。\n过市更持公子辔，抽毫应赋孝王园。\n黄河浊浪今双下，少室三花尚几存。\n十载游梁曾作客，羡君兰佩奉明恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6903,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日王银台方太常李明府饮绣佛斋观榴花得盐字","author":"欧大任","text":"松下清斋破午炎，海榴邀客共巡檐。\n红蒸散雾时侵席，紫艳披香乍满帘。\n密坐周遭山步帐，照盘羞涩水晶盐。\n看花不废逃禅兴，吏隐谁能得易兼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6904,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送戴赣州","author":"欧大任","text":"书帷十载故园开，执戟谁期得共陪。\n家出侍中传礼学，名推东省算缗才。\n分符章贡江为郡，露冕崆峒雪作台。\n南望蘼芜心更远，赐金何日汉庭来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6905,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"方太常邀饮谢驸马山亭避暑得微字","author":"欧大任","text":"王家邸第綵云围，百尺亭空入翠微。\n觞榼暑轻千日酒，藤萝秋挂六时衣。\n桥边石在鲸犹动，台上箫停凤欲飞。\n雪藕冰桃盘白玉，晚凉吾亦醉忘归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6906,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"二子","author":"欧大任","text":"东方奏牍介休巾，二子抠衣半已鹑。\n未必风云俱失士，不知刍秣待何人。\n公卿宁以三鳣贵，天地今惟一马真。\n寥廓千秋君自爱，羖皮堪笑入西秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6907,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"积雨初霁集王银台宅时银台长孙晬日","author":"欧大任","text":"燕山晴色照城闉，柳市南头问葛巾。\n家自传经韩太傅，酒今留客汉陈遵。\n晬盘金印欢方剧，舞袖犀钱醉莫嗔。\n从此荀郎能坐膝，不妨频访颍川人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6908,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答吴虎臣广陵元夕见寄","author":"欧大任","text":"歙下看灯忆尔觞，闻君献岁客江阳。\n九枝影里今犹梦，五色毫中尽放光。\n朝罢懒随高宴会，别来羞逐少年场。\n薛公何处堪藏市，犹向明时老卖浆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6909,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立秋日王于慎李于美方允治见过迟刘仲修不至得天字","author":"欧大任","text":"轻葛难禁溽暑天，秋风忽动兴翛然。\n居惟蒋径能来客，官似萧斋不废禅。\n丛桂几花飘月下，疏桐一叶坠尊前。\n伯伦此际关犹闭，何事空传颂酒篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6910,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答朱宗良方士功朱贞吉彭稚修赵修甫五子","author":"欧大任","text":"老向风尘鬓易皤，豫章消息更如何。\n遥知对客持三雅，谁解逢人寄九歌。\n绝学河间传礼在，诸生郫上好玄多。\n倦游倍觉离愁远，渐欲江南托薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6911,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送冯署正擢应天府倅","author":"欧大任","text":"南去怜君捧檄劳，秦家内史汉功曹。\n天开丰镐城为石，江出岷峨雪作涛。\n渚下暂邀桓野笛，府中今佩吕虔刀。\n故人蓟北长相望，尺素春来白雁高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6912,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张比部文起审决江南","author":"欧大任","text":"建节南行秋色高，主恩三尺寄西曹。\n便宜封事灯前检，论决爰书笔下操。\n候馆郊迎停海月，斑衣家庆涉江涛。\n称诗谁似张公子，多少词人待綵毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6913,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张仪部以孚使曲阜","author":"欧大任","text":"东方千骑气成虹，圣主临雍召上公。\n乡射正逢邹峄礼，民诗兼采海沂风。\n城边建旆桑犹绿，河畔垂鞭枣欲红。\n斗酒别君堪计日，清秋归谒大明宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6914,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"驾幸太学赐衣","author":"欧大任","text":"桥门成礼佩锵锵，敕赐宫衣出尚方。\n照日拜时皆湛露，自天题处尽披香。\n恩沾御沼双鸿鹄，光射彤楼五凤凰。\n橐笔西痈虽欲颂，小臣何以赞垂裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6915,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄许殿卿","author":"欧大任","text":"三年岭峤望中原，赤管还来荷帝恩。\n授简梁园诸子散，和歌燕市几人存。\n客知蒋诩能开径，玄似杨雄独闭门。\n羡尔秋风华不注，白云犹自傍清尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6916,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十日田子艺魏季朗茅平仲朱邦肃胡茂承郭建初莫云卿马用昭邵长孺程无过汪元初程虞仲诸子见过得先字","author":"欧大任","text":"狂夫肮脏讵堪怜，马队何如祖谢年。\n恋阙恩深佩萸后，还山心在杖藜先。\n书藏已蠹空成帙，榻坐皆穿未有毡。\n词客不妨频过我，餐钱新送酒家钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6917,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大司马曾公以三宅同诸公集","author":"欧大任","text":"紫宸朝罢一飞骖，星聚云中白玉簪。\n总武今尊周太尉，著书谁似杜征南。\n樽前盘郢醒犹看，袖裹阴符老更谈。\n尽道十年宾客在，独怜双鬓已䰐鬖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6918,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄大司徒钟阳马公","author":"欧大任","text":"桂冠神武事烟波，大老三朝出入多。\n塞下飞刍曾煮海，宣房沉璧已成河。\n隐堪白首餐松柏，赐有黄金醉薜萝。\n闻道殿庭思曳履，幔亭秋宴兴如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6919,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送钟侍御改宪副督学广西","author":"欧大任","text":"茱萸湾似陟阳情，八载都亭复送行。\n绣豸共知周柱史，苍梧今授汉经生。\n山分衡岳过梅峤，江下牂牁绕桂城。\n君向伏波谈粤事，可能无念朔方兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6920,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送司武库奉使还江陵省觐","author":"欧大任","text":"鸡鸣紫陌肃骅骝，使者南行拥传游。\n家近内方盘楚甸，江连三峡入荆州。\n黄封归献金茎露，綵袖酣歌玉树秋。\n汉署承恩催草奏，莫令留滞仲宣楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6921,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬皇甫子循以新刻见寄","author":"欧大任","text":"玄晏归来头未白，谁令江左卧烟霞。\n三朝琬琰司勋集，六代菁华学士家。\n山可藏书同马史，门今问字几侯芭。\n思君忽动扁舟兴，醉看胥湖万树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6922,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王百谷半偈庵","author":"欧大任","text":"何许蒿庐学陆沉，王珣断俗已修心。\n千金自布袈裟地，多宝初成薝卜林。\n斋后满窗黄叶积，禅时一径白云深。\n萧然人外相从久，玄度犹能策杖寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6923,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送宗伯孙公请告还清平省觐","author":"欧大任","text":"箧中五色已裁衣，入讲经筵出虎闱。\n诏下暂容扶疾去，恩深兼得问安归。\n蓟门霜叶鸿边度，黔阁春云马首飞。\n官属此时多怅望，明年还待谒彤扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6924,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潘子朋入京闻黎惟敬将至","author":"欧大任","text":"万里翩翩海鹤群，燕台风雪始逢君。\n名家早已迎王粲，父党偏能敬子云。\n洛下衣冠缑氏学，漓江戈甲伏波军。\n故人消息期秦腊，斗酒高歌醉里闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6925,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送谢明府改教漳州","author":"欧大任","text":"宰官何事绛纱帷，斗酒燕歌怆别离。\n已籍才名成宅相，不将经术负明时。\n七闽弦诵清漳郡，六代风流小谢诗。\n君息天池还北徙，图南千里是前期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6926,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]