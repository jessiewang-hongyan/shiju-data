[{"title":"寄送侄孙鸿胪定鼎 其一","author":"王世贞","text":"青衫垂故鬓丝新，解带能眠丞相茵。\n纵有悬河君莫尽，古来三语定何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12702,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄送侄孙鸿胪定鼎 其二","author":"王世贞","text":"当年公望有安期，今日蓝田玉一枝。\n若问江东米贵贱，但言王掾未全痴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12703,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄送侄孙鸿胪定鼎 其三","author":"王世贞","text":"吴阊风起木兰桡，祖道秋新绿旆骄。\n见说时清官更好，教人何地问渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12704,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄送侄孙鸿胪定鼎 其四","author":"王世贞","text":"金马门前无限春，岁星何处不藏身。\n明年社肉初颁后，可向天涯忆远臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12705,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送孙兆孺还华容 其一","author":"王世贞","text":"玄经罢草不胜閒，愁遣幽人问字还。\n别后相思何所道，尊前秋色似君山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12706,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送孙兆孺还华容 其二","author":"王世贞","text":"铃阁深沈漏渐稀，新凉綷縩上荷衣。\n相逢始信无官好，今夜思家明夜归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12707,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赵中丞良弼便道过里为促其行","author":"王世贞","text":"武昌为祖接天开，六月风清御史台。\n休汝莫令车骑众，燕中专待一骢来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12708,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"补题冬日村居四绝 其一","author":"王世贞","text":"纬萧风急蟹全肥，黄雀头头饱不飞。\n自有牵绵新酿在，不烦机妇授寒衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12709,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"补题冬日村居四绝 其二","author":"王世贞","text":"莫怪田家置酒频，绵花盈椟米盈囷。\n从他俗饮无妨事，七贵筵头俗杀人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12710,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"补题冬日村居四绝 其三","author":"王世贞","text":"踏车?水欲深池，看网银鳞过别陂。\n刮面西风浑不峭，烹鱼压酒夕阳时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12711,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"补题冬日村居四绝 其四","author":"王世贞","text":"冲寒来叩野人家，不遣萧条负岁华。\n蜜结苔梅俱馨口，青葱簇出水仙花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12712,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送于信夫还武陵 其一","author":"王世贞","text":"千叠青山拥上游，戟门翻见武陵舟。\n郧江一线成归路，可似桃花洞口流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12713,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送于信夫还武陵 其二","author":"王世贞","text":"抛却铜符十五年，谈玄倦了复谈禅。\n石头路滑君知否，明月家山自在圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12714,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沈侍御汝材按秦至耀州而卒为四绝挽之 其一","author":"王世贞","text":"秦中秋尽法星残，祋祤城头黯淡看。\n从此柏台乌不住，白杨风色四时寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12715,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沈侍御汝材按秦至耀州而卒为四绝挽之 其二","author":"王世贞","text":"抗手輶轩西入秦，蓝田玉折竟成尘。\n蛾眉班上应愁看，鸿雁行中少一人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12716,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沈侍御汝材按秦至耀州而卒为四绝挽之 其三","author":"王世贞","text":"游子魂无忆故乡，一身天地任茫茫。\n车前素旐悠扬去，犹带西台御史霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12717,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沈侍御汝材按秦至耀州而卒为四绝挽之 其四","author":"王世贞","text":"莫怪休文减带围，由来仙骨不胜衣。\n孤山一片梅花月，可是能骑鹤背归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12718,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅李侍御惟贞时方按柳州 其一","author":"王世贞","text":"瘴色惊霜一马骢，故人谁似李端公。\n柳州垂柳应无数，心在襄西落木中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12719,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅李侍御惟贞时方按柳州 其二","author":"王世贞","text":"郧岭春初雪不残，柳江风物已堪观。\n莫言岭表无他寄，蕉实能黄荔子丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12720,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春寒东阁外花事未动有感 其一","author":"王世贞","text":"阴风猎猎雨丝丝，苦勒新红未上枝。\n人道春光从此出，不知元自得春迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12721,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春寒东阁外花事未动有感 其二","author":"王世贞","text":"空传驿使到天涯，不见梅花寄一枝。\n弇山园里千团玉，尽日婵娟为阿谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12722,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻敬美使秦中要取道太和一晤 其一","author":"王世贞","text":"怀中白璧月同圆，纵入秦庭莫浪传。\n可怪人间无合处，郧江虹色已经年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12723,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻敬美使秦中要取道太和一晤 其二","author":"王世贞","text":"莲花朵朵扑函关，使者褰帷紫气间。\n分付锦囊收拾尽，与君移较太和山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12724,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"摘桑葚作供二绝 其一","author":"王世贞","text":"蔫红黝紫簇成堆，但摘儿童莫更猜。\n说与故园风物好，玉盘冰醴浸杨梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12725,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"摘桑葚作供二绝 其二","author":"王世贞","text":"凉州遮莫小江南，桑葚虽鲜也未堪。\n解道谢公怀远略，已誇风味胜黄甘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12726,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠寄陈道易 其一","author":"王世贞","text":"处处凭镌幼妇辞，银钩拓得慰相思。\n襄阳岘首依然在，千载惟谈堕泪碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12727,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠寄陈道易 其二","author":"王世贞","text":"休汝毋言计尽非，麦田虽薄价还微。\n吴阊旧俗君应晓，垂橐归来未当归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12728,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"以曾益州筇杖并诗赠九十七左翁","author":"王世贞","text":"百年踪迹仅庭除，毋事门人进笋舆。\n欲识使君珍重意，益州方竹右军书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12729,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太和绝顶赠敬美少参弟时游自太华新领部南康为匡庐主人 其一","author":"王世贞","text":"玄岳能玄太华青，到来词笔动山灵。\n莫言迁客恩波少，何似金门老岁星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12730,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太和绝顶赠敬美少参弟时游自太华新领部南康为匡庐主人 其二","author":"王世贞","text":"太和宫阙写黄图，匡庐旧称天子都。\n共是玉皇香案吏，不妨南北领香垆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太和绝顶赠敬美少参弟时游自太华新领部南康为匡庐主人 其三","author":"王世贞","text":"汝兄新赋未堪难，岳色撩人试自看。\n但使登高须授简，主恩新拜大夫官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太和绝顶赠敬美少参弟时游自太华新领部南康为匡庐主人 其四","author":"王世贞","text":"鹅笙凤管写潺湲，豹尾熊幡簇满山。\n疑是茅君兄弟别，未分天上与人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王上饶将入觐与余有酒人燕市之约寻余赴留任归里君亦当便道省觐走笔戏赠","author":"王世贞","text":"驷马于公爱里闉，双凫叶令畏京尘。\n新丰酒价毋劳问，且作高阳社里人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"由郧江抵均州即事 其一","author":"王世贞","text":"下江双橹鸣啾啾，上江橹声亦不柔。\n今春三月桃花水，不似常年竹箭流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"由郧江抵均州即事 其二","author":"王世贞","text":"龙涡瀺灂硿然鸣，小滩大滩势欲争。\n棹入前崖浑不见，还从阙口出歌声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"由郧江抵均州即事 其三","author":"王世贞","text":"大石奋攫狮王身，小石槎牙不可驯。\n若令水清能见底，更有眠虬愁杀人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"由郧江抵均州即事 其四","author":"王世贞","text":"落日未尽新蟾催，无那层崖黯不开。\n一线金波初欲动，错疑神女送珠来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天柱峰","author":"王世贞","text":"生平漆室意堪怜，见语中峰便跃然。\n盘到最高金顶上，依然无际蔚蓝天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"显定峰","author":"王世贞","text":"显际神光无处踪，定时贤劫不相逢。\n老夫拟向峰头住，自取犍槌撞晓钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"皇崖峰","author":"王世贞","text":"雨脚霏霏暖不收，皇崖风起忽成秋。\n浮云半捲青天外，一线襄江抱日流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大小笔峰","author":"王世贞","text":"七曜天文万古看，长馀綵笔插空寒。\n欲书人鸟宫中事，龙汉年来罢史官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七星峰","author":"王世贞","text":"天上白榆秋历历，人间翠岭昼亭亭。\n自从题壁新诗就，北斗行中见一星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中笏峰","author":"王世贞","text":"手板三时朝紫宸，天符九锡下青旻。\n自能鹤禁辞王位，不向高真道寡人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c0685