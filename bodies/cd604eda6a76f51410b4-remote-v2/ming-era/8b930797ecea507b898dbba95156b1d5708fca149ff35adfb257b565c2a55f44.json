[{"title":"送陈宪伯入觐便道归省","author":"徐熥","text":"万国诸侯会建章，使君千骑出东方。\n绣衣正奏三年绩，綵服还称百岁觞。\n辔揽朱轮宵拥月，疏封白简昼飞霜。\n法星渐与闽天远，遥望精光帝座傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23701,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送闵孝昭侍尊人还广陵","author":"徐熥","text":"暂得相逢又解携，滩声高下桨声齐。\n束装欲跨扬州鹤，问寝频听旅店鸡。\n夜月故园淮浦北，秋云乡路海门西。\n还期共醉芜城酒，系马隋宫旧柳堤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23702,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送温永叔郡丞守南宁","author":"徐熥","text":"符分铜虎寄专城，新驾朱轮岭表行。\n八桂瘴云迎五马，二江岚月引双旌。\n禁将巫蛊蛮丁化，燃出灵犀?母惊。\n地近交州风土别，每逢春雨劝刀耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23703,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邓德咸刺史官沔阳","author":"徐熥","text":"楚江猿啸岂堪听，野水连天过洞庭。\n夜月褰帷逢汉女，秋风行部吊湘灵。\n九疑峰色参差碧，三峡云光黯淡青。\n君去不愁难寄远，萧萧兰芷满寒汀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23704,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题黄懋中大学士硕宽堂","author":"徐熥","text":"多年簪笔侍螭头，焚却银鱼早乞休。\n十亩云霞开径日，半楼烟雨捲帘秋。\n小山桂树丛丛绿，曲涧桃花片片流。\n不是能耽泉石趣，几人青鬓老菟裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23705,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别陈叔度","author":"徐熥","text":"几日相逢意未阑，谁知相别不成欢。\n尊前草色销魂易，笛里梅花寄远难。\n鸡唱晓霜孤枕怯，马嘶残雪一鞭寒。\n虽然千里同明月，两地伤心各自看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23706,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕前二日同康元龙集江参藩先生园亭","author":"徐熥","text":"停骖岁晚向名园，满径寒花映酒尊。\n雪色半侵青玉案，星光多傍紫薇垣。\n几年愧下高人榻，一剑长衔国士恩。\n不是残年催去客，敢辞十日饮平原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23707,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"武林驿别康元龙","author":"徐熥","text":"钱唐江上浪层层，此地分携感慨增。\n客路残年悲短剑，驿亭寒夜忆孤灯。\n归魂黑度千林雨，乡泪红凝半枕冰。\n江北江南天万里，不堪回首望西陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23708,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"语溪舟中除夕用旧韵","author":"徐熥","text":"满江灯火照帆樯，断送韶华在异乡。\n红烛也流今夕泪，青铜犹忆去年妆。\n孤身长路思千里，半世虚名梦几场。\n欲解离愁谋一醉，行厨何处有椒觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23709,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕西寺访朗公","author":"徐熥","text":"停棹清溪值岁除，匆匆溪上访僧居。\n残年只听莲花漏，半偈犹翻贝叶书。\n爆竹声喧人语沸，石灯光照佛堂虚。\n五噫悔作飘零客，愿得从师證六如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23710,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌元日槜李舟中","author":"徐熥","text":"千里关河更问津，东风吹动柳条新。\n鸡声不挽难留岁，马齿偏催易老身。\n楼上绮罗谁氏女，帆前箫鼓异乡人。\n客心久已如荼苦，何用盘中荐五辛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23711,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曾人倩秘书招饮衙斋话旧分得昏字","author":"徐熥","text":"悠悠往事不堪论，燕市悲歌欲断魂。\n折柳岂忘逢驿路，颂椒还记醉祗园。\n千金橐尽心犹壮，一剑锋销侠尚存。\n酒后对君思起舞，浮云西北易黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23712,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀陈伯孺","author":"徐熥","text":"六溪疏柳几条斜，不异柴桑处士家。\n日午山窗书薤叶，春深江阁画梅花。\n邻庄与弟同渔猎，古寺寻僧共结跏。\n独有故人伤远别，年年衰鬓客京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23713,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪事 其一","author":"徐熥","text":"汉家台殿敞蓬莱，玉柱盘龙接上台。\n廿载皇仁深雨露，一时天意变风雷。\n宫墙夜静啼乌急，苑树春归乳燕来。\n翘首五云天万里，小臣双泪泣秦灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23714,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪事 其二","author":"徐熥","text":"纷纷兵甲满中原，市井萧条有几村。\n总为琼林伤地脉，非贪宝气凿云根。\n中涓数献便宜策，丁壮难招恸哭魂。\n辛苦西台姚柱史，画图空自叩天阍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23715,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪事 其三","author":"徐熥","text":"王师一夜报苍黄，大将星沉昼不光。\n塞外忠魂酬玉剑，沙中枯骨带金疮。\n黄昏燐火新亡卒，白日烽烟古战场。\n莫向居庸城上望，霜天笳管总悲凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23716,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪事 其四","author":"徐熥","text":"欃枪夜望射天弧，边计年来困挽输。\n万里君门谁伏阙，四郊皇店尽徵租。\n虎贲宿将多凋谢，乌合新兵屡噪呼。\n时事艰危堪涕泪，太平能到白头无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23717,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得王元直金陵书却寄","author":"徐熥","text":"芳草天涯怨不胜，怀人魂梦苦无凭。\n何来一骑过淮水，传得双鱼自秣陵。\n桃叶暖风春访伎，杏花微雨夜寻僧。\n玉蝉精舍葳蕤锁，寂寞疏林半点灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23718,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王思延都护","author":"徐熥","text":"年少登坛拥隼旟，欲将长剑扫穹庐。\n黄金世佩通侯印，彤管家藏太史书。\n异域葡萄杯上绿，边城杨柳笛中疏。\n运筹自合阴符秘，兵法无劳习穰苴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23719,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王君密民部","author":"徐熥","text":"年少风流粉署郎，赋成争诵鲁灵光。\n閒曹不废青箱业，先世犹传白简霜。\n九折羊肠曾叱驭，一官鸡舌正含香。\n潞河公暇门如水，花竹阴阴客满堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23720,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潞河逢梅子马时子马自楚使燕","author":"徐熥","text":"当年同听白门鸦，别后风烟几岁华。\n万里飘零逢潞水，一官牢落傍长沙。\n新愁绿岸帆前柳，旧事青楼梦里花。\n草草离尊犹未醉，数声残角又天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23721,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天津道中怀王玉生","author":"徐熥","text":"老向郊原受一廛，村中幽事总堪怜。\n园栽桑柘同韦曲，坞筑辛夷学辋川。\n花下笔床临粉本，松间茶鼎扇青烟。\n自从南北风尘远，不到东山又几年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23722,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"连窝舟中与张叔韬话旧","author":"徐熥","text":"同泛归舟下潞河，空将身世感蹉跎。\n十年京洛红尘满，三载朱崖白发多。\n云暗戍楼喧断角，月残官渡起悲歌。\n愁君此去王程急，两岸芦花奈别何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23723,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"淮阴舟夜寄怀二云歌姬","author":"徐熥","text":"淮浦东边月影斜，相思何处问琵琶。\n别时折是章台柳，梦里歌为玉树花。\n万里客魂销绿鬓，几回幽恨寄红牙。\n遥知香骨怀人瘦，宽尽春风系臂纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23724,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"广陵七夕闻歌有怀","author":"徐熥","text":"每看秋水忆临波，况值天孙夜渡河。\n衣上馀香怀贾女，竹间残泪怨湘娥。\n书从蓟北传来少，梦到江南别后多。\n二十四桥桥畔月，不堪重听绕梁歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23725,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"真州逢谢在杭司理","author":"徐熥","text":"萧萧书剑傍风尘，况对天涯骨肉亲。\n半夜断猿知己泪，经年羸马异乡身。\n飘零湖海愁归客，憔悴江潭问逐臣。\n此日世途君自见，莫将青鬓叹沉沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23726,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟次枫桥寄陈汝大先生","author":"徐熥","text":"萧萧羸马厌驰驱，愁听枫桥月落乌。\n开遍芙蓉思故国，折来杨柳记西湖。\n十年献赋青云薄，千里题诗白社孤。\n我为飘零双鬓短，忆君霜雪满头颅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23727,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀李仪卿","author":"徐熥","text":"梅花绡帐晓寒生，怨似流苏百结成。\n远岫犹怜眉黛浅，凌波还忆袜罗轻。\n倦来司马偏多病，老去徐娘更有情。\n十载旧欢真一梦，钓龙台上月空明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23728,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"驿亭夜坐书怀寄内","author":"徐熥","text":"十年书剑两无成，飘泊江湖愧姓名。\n络纬声沉愁易集，芙蓉花老怨难平。\n枕边暮雨离魂结，镜里秋霜客路生。\n共隐青山期白首，古来曾有鹿门耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23729,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠沈稚咸","author":"徐熥","text":"爱君蓬荜绿萝閒，住近枫桥第几湾。\n短屐一春游茂苑，疏钟半夜听寒山。\n门多词客寻诗至，寺有高僧乞画还。\n数顷烟波满船月，歌声来往水云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23730,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过沈从先江居","author":"徐熥","text":"停棹来寻江上居，闭门知与世情疏。\n买鱼入市儿沽酒，负米还家母倚闾。\n委巷几留高士辙，寒窗长课小童书。\n空怜四壁萧条甚，薄俗何人重子虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"垂虹夜泊怀陈幼孺","author":"徐熥","text":"吴江残露冷丹枫，万里还家叹转蓬。\n世路升沉同塞马，乡书寥落怨边鸿。\n舟移晚渡三更月，桥跨秋波百丈虹。\n犹忆当年分别处，征衣憔悴泣西风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"姑苏怀郑翰卿","author":"徐熥","text":"十年踪迹遍天涯，散尽黄金满狭斜。\n庄舄岂能忘越国，莫愁原自属卢家。\n孤莺白岳啼衰柳，匹马青楼过落花。\n日暮思君心独远，片帆江上阻蒹葭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张叔韬令罗浮","author":"徐熥","text":"琼海曾乘博望槎，惠阳为政又携家。\n琴床半落姑仙雪，印匣全封葛令砂。\n输税山农冠箬叶，趁墟蛮女卖梅花。\n官閒好作罗浮长，四百峰中早放衙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日访徐茂吴司理","author":"徐熥","text":"青鬓投簪二十年，菟裘高筑虎林偏。\n胸吞云梦全无楚，屋贮华阳小有天。\n杨柳影侵游寺屐，竹枝歌送泛湖船。\n钱唐江上潮如马，定赋观涛第几篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西湖秋夜寄紫玉侍儿","author":"徐熥","text":"他乡流落怨归期，天外秋风雁去迟。\n枕上雨声灯下泪，湖心山色镜中眉。\n难将双楫迎桃叶，愁听孤舟唱竹枝。\n遥忆琐窗肠断处，残更哀角梦回时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钱唐感旧","author":"徐熥","text":"吴山残黛晚烟低，满目桃花路又迷。\n夜夜泪痕悲角枕，年年幽恨闭香闺。\n分枝菡萏难连理，隔水鸳鸯暂并栖。\n司马琴心今渐老，断肠明月小楼西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七里滩怀惟秦","author":"徐熥","text":"桐江风冷露华漙，舟过严陵七里滩。\n秋晚雁声枫外老，夜深渔火蓼边残。\n月明古渡波千顷，云暗高峰路几盘。\n遥忆故人沧海上，白头犹自守纶竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过武夷访闵寿卿蘧庐一宿而别兼柬浑然道人江仲鱼秀才","author":"徐熥","text":"蘧庐高结傍岩峦，翠壁千重路几湾。\n霞色全飞丹灶火，溪声长绕白云关。\n风尘已作经年别，烟水聊分一夜閒。\n唱罢金鸡天欲晓，渔郎踪迹又人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻屠田叔转运擢守辰州寄赠","author":"徐熥","text":"新驾朱轮驿路赊，甘棠初种郡庭花。\n三苗纳款沅陵地，五马行春楚水涯。\n酉室名山探绿字，辰溪深洞觅丹砂。\n桃川正属提封内，试问秦人尚几家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈汝翔游惠州","author":"徐熥","text":"马蹄随处认桄榔，千里孤身入瘴乡。\n岭路春声啼翡翠，蛮村秋色变蕉黄。\n朝云香骨累累土，夜月花神淡淡妆。\n莫向异方思故国，夏初先得荔枝尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为屠田叔悼亡姬 其一","author":"徐熥","text":"渺渺凌波去绝踪，每看遗挂恨重重。\n魂同睡蝶招难返，血比啼鹃拭更浓。\n黄土有情封玉骨，青铜无计铸花容。\n君行正近高唐路，肠断巫阳第几峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为屠田叔悼亡姬 其二","author":"徐熥","text":"一别妆楼闭寝门，梨花风雨泣黄昏。\n蚌枯沧海珠无泪，鱼葬青山玉不温。\n金谷尚传三斛价，罗帏空负十年恩。\n春来忍看孤飞燕，恐是娇姬恋主魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自题小像 其一","author":"徐熥","text":"平生非侠亦非儒，半世游閒七尺躯。\n却为疏狂因偃蹇，未忘柔曼转清癯。\n违时傲骨贫犹长，对客诗肠老渐枯。\n五字吟成心独苦，不知身后得传无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自题小像 其二","author":"徐熥","text":"展卷徒为老大悲，形容将槁鬓将丝。\n有时愤世空饶舌，何处谈诗不解颐。\n足为无车行路健，心因多累记书迟。\n自知瘦骨宜贫贱，莫怨人间只相皮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀李惟顺赞府","author":"徐熥","text":"岩邑萧条早闭关，翠屏高映讼庭间。\n官同潘县栽花至，客到龙门御李还。\n衙听孤莺声共放，吏兼双鹤影俱閒。\n琴床一曲停流水，又对青娥画远山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林子真久客临汀闻余归自长安贻书慰藉感而赋荅","author":"徐熥","text":"经年离思杳难裁，望断江南雪后梅。\n锦字忽传孤雁至，明珠惊向九龙来。\n雄心已耗刘蕡第，死骨谁收郭隗台。\n总为穷愁才易尽，岂堪重问笔花开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送屠使君至芋江是夕留饮驿亭以梨园佐觞使君首倡依韵奉荅","author":"徐熥","text":"追欢三载别今朝，对酒离魂黯欲消。\n楚国行春迎露冕，邮亭卜夜驻星轺。\n残鸡唱断风生柝，万马声寒月送潮。\n暂歇梨园留刻烛，莫教红蜡一时烧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渊关再别屠使君次来韵 其一","author":"徐熥","text":"使君才藻似枚皋，立得词坛赤帜高。\n薄俸半因开社费，閒心多为著书劳。\n年来淮桂歌招隐，此去湘兰赋反骚。\n五马骖驔人独远，楚天遥望首空搔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渊关再别屠使君次来韵 其二","author":"徐熥","text":"万里沅陵楚水隈，一麾今出越王台。\n当筵客尽留诗别，卧辙人多掩泪回。\n津汎神龙悲剑去，峰过回雁望书裁。\n九疑渐近三山远，何处登临屐再陪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"崇德令孙先生挽诗","author":"徐熥","text":"语溪为政号神君，黑发俄脩地下文。\n远道野僧歌薤露，寒宵山鬼哭松云。\n斗间久失郎官宿，郭外新添令尹坟。\n忽听悲风生垄树，犹疑长啸半空闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云阳葛隐君双寿诗","author":"徐熥","text":"句容元说葛洪家，配得仙姬萼绿华。\n几度化龙陂上竹，寻常喂鹤鼎中砂。\n笙吹缑岭声声月，衣剪茅山片片霞。\n待到丹成同拔宅，遥空双驾紫鸾车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌除夕 其一","author":"徐熥","text":"独对残灯暗自惊，世途谁复念虚名。\n索钱有虏诗难退，祀灶无灵术未精。\n半壁图书先代业，四邻歌管少年情。\n二毛岂必缘衰老，只恐穷愁白易生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌除夕 其二","author":"徐熥","text":"办得椒盘橐已虚，残年衣褐叹全无。\n先人墨绶空廉吏，贱子青衫只腐儒。\n自祭诗神斟柏叶，欲驱穷鬼挂桃符。\n灯前不改贫家乐，堂上慈颜膝下雏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己亥元日 其一","author":"徐熥","text":"开遍梅花腊尽归，声声爆竹启山扉。\n去年愁苦将谁告，今岁平安向佛祈。\n三径烟霞吾独老，六街风雨客来稀。\n朱门通刺慵随例，自古閒身是布衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己亥元日 其二","author":"徐熥","text":"灯烛烧残见曙光，伤情多为惜年芳。\n无田更切三时望，有闰翻添一月忙。\n已分狂歌惟草泽，喜占春梦在池塘。\n生憎稚子吹芦管，落尽梅花树树香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同幼孺惟起由琼河泛舟至义溪","author":"徐熥","text":"寒风微雨共扬舲，无数渔歌竹外听。\n浦口小洲悬半月，海门孤塔涌罗星。\n洪涛敛势奔归峡，众水分流散入汀。\n三十六湾溪路转，一湾山色一重青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林道鲁就婚之楚妇翁王献父时为吉藩左相","author":"徐熥","text":"二月春风咏摽梅，征衣还见锦初裁。\n舟经剑浦乘龙去，路入衡阳捧雁来。\n卺合贤王新赐醴，镜开神女旧妆台。\n兔园正授枚生简，年少谁当作赋才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山居漫兴学晚唐","author":"徐熥","text":"野服黄冠绝世情，小斋无客罢逢迎。\n蜂窠衙静如山县，蚁穴泥深似土城。\n雨久芭蕉心半捲，春迟杨柳眼初生。\n只缘编得花屏好，每日沿阶几度行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朝宗上人还金山","author":"徐熥","text":"天涯行脚偶相逢，又向空门忆旧松。\n千里月嘶春涧马，半江云起晓堂龙。\n临流独浣归山衲，礼佛重鸣到寺钟。\n闻说慈航堪度世，几时禅榻待周颙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈道育之官汉阳","author":"徐熥","text":"万里传经入楚乡，新莺初啭柳丝长。\n毡存子敬官非冷，舆御潘郎母可将。\n山色千重看大别，江流九派过浔阳。\n座间定有三鳣坠，地近嘉鱼对武昌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠呼允龄将军","author":"徐熥","text":"黄金横带气如虹，儒雅还看郤縠同。\n鱼鸟阵开云变黑，鲸鲵血溅海生红。\n肘悬幕府新雕印，手挂天山旧赐弓。\n注就阴符刁斗急，夜深灯照柳营中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钱连江尊人双寿诗","author":"徐熥","text":"宿应郎官接上台，岁星还傍婺星开。\n丹烧勾漏霞干片，酒进麻姑露一杯。\n琪草祗从阶下长，蟠桃都向县中栽。\n承家自有关门尹，日日真人紫气来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]