[{"title":"从军五更转 其二","author":"王世贞","text":"二更刁斗鸣，却比捣衣轻。\n南风好吹去，并作断肠声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从军五更转 其三","author":"王世贞","text":"三更月未斜，凄切送胡笳。\n天山无草木，空听落梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从军五更转 其四","author":"王世贞","text":"四更山月昏，屈指旧从军。\n白骨年年是，何人入玉门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从军五更转 其五","author":"王世贞","text":"五更听乌啼，乌是汝南鸡。\n闺中双玉箸，点点为辽西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采菱曲","author":"王世贞","text":"蜻蛉刺水去，不复畏欹斜。\n渠自爱菱角，侬自爱菱花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江南乐八首 其一","author":"王世贞","text":"少小阊门住，不爱阊门道。\n约伴礼社还，羞人道侬好。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江南乐八首 其二","author":"王世贞","text":"窗前樱桃树，累垂红靺鞨。\n侬爱结子时，的应胜花发。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江南乐八首 其三","author":"王世贞","text":"与欢皋桥别，日日上皋桥。\n不比西陵浦，唯看两度潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江南乐八首 其四","author":"王世贞","text":"妒杀宜城酒，夜夜将欢醉。\n昨夜欢不来，翻怜醉时味。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江南乐八首 其五","author":"王世贞","text":"郎家流苏帐，对对玉蟠螭。\n登车辞阿母，强作数行啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8646,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江南乐八首 其六","author":"王世贞","text":"闻欢夜中语，轻舟汎若耶。\n兴阑须返棹，来泼雨前茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8647,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江南乐八首 其七","author":"王世贞","text":"东女日鸣机，西女日条桑。\n侬今袖手坐，绡绮亦盈箱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8648,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江南乐八首 其八","author":"王世贞","text":"芍药百种花，真红大难得。\n侬家众姊妹，无侬好颜色。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8649,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"估客乐","author":"王世贞","text":"醉后美人舞，落花江上席。\n不是此地堪，何缘作估客。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8650,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"襄阳乐","author":"王世贞","text":"大堤诸女郎，妆成出芳阁。\n瞥见千树空，馀花乱飞落。\n道是避妾妆，不信风雨恶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8651,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江南曲 其一","author":"王世贞","text":"欢似吴江水，西去不通潮。\n妾如独活草，无风长自摇。\n安能对阊阖，暮暮复朝朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8652,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江南曲 其二","author":"王世贞","text":"庭前百合花，露冷烟脂赤。\n对镜理新妆，羞他好颜色。\n从此不簪花，恐欢心更易。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8653,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江南曲 其三","author":"王世贞","text":"杨花眠更起，飞向阿谁家。\n曲槛青丝箔，雕鞍白鼻騧。\n垆头无那醉，小妇摘琵琶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8654,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江南曲 其四","author":"王世贞","text":"西湖水似油，袅袅采莲舟。\n双鬟正十五，垂手玉葱柔。\n罗带飘相近，风波可自由。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8655,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌栖曲 其一","author":"王世贞","text":"碧烟作幮月作钩，双星荧荧对如眸。\n天鸡叫昏日吹海，欢娱辞人不能待。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8656,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌栖曲 其二","author":"王世贞","text":"城乌哑哑唤春曙，只解将啼诱郎去。\n玉笼金索娇鹦哥，呼郎不来奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8657,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌栖曲 其三","author":"王世贞","text":"青纱羃䍦象牙毂，皎如柔冰浸温玉。\n还君一掬鲛人珠，持将染衣茜不如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8658,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌栖曲 其四","author":"王世贞","text":"宁馨玉儿雪白马，丝鞭软垂不相舍。\n妾家采菱东渡头，来往风水木兰舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8659,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江南弄","author":"王世贞","text":"江南百花百般香。\n江南少娃百样妆。\n百端撩人百念狂。\n百念狂，殊未已。\n千欢尽，万恨起。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8660,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙笛曲","author":"王世贞","text":"苍龙啸波夜泬寥。\n美人如云袂飘飖。\n历乱纤玉启樱桃。\n启樱桃，吹杨柳。\n度关山，尽回首。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8661,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凤笙曲","author":"王世贞","text":"瑞垆兽焙蜀锦床。\n要眇倡凤复和皇。\n馀音弥弥郁金梁。\n郁金梁，宿流烟。\n与女偕，逝缑山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8662,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"后采莲曲","author":"王世贞","text":"密叶藏艇花迷妆。\n中有清歌逐芬芳。\n随风去来咽复扬。\n咽复扬，雨缭起。\n摘叶归，忘收子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8663,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采菱曲","author":"王世贞","text":"下裙鹅黄衫藕丝。\n拨蔓纤指玉参差。\n采菱倾筐露未晞。\n露未晞，甘且芳。\n折腰红，持赠郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8664,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朝云曲","author":"王世贞","text":"巫云欲阑接朝日。\n流辉斗艳无定质。\n若恋如惊态非一。\n态非一，境将残。\n拟追寻，渺无端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秦筝曲","author":"王世贞","text":"咸阳少娃十三馀。\n十三新弦莺不如。\n商偏羽弱调乌乌。\n调乌乌，和纂纂。\n新欢长，旧欢短。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赵瑟曲","author":"王世贞","text":"素女留弦清且悲。\n谁其工者邯郸姬。\n玫瑰贴柱黄金徽。\n黄金徽，白玉管。\n侬意长，欢意短。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游女曲","author":"王世贞","text":"双蛾作眉鸦作髻。\n睩波芙蓉近相媚。\n不买新丰意先醉。\n意先醉，可奈何。\n千金舞，百金歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阳春曲","author":"王世贞","text":"杨柳窣地万千丝。\n金堤碧桃花吐荑。\n攀条折花将遗谁。\n将遗谁，心自了。\n人耳多，黄耳少。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"莫愁乐","author":"王世贞","text":"绕渡碧桃花，停鞭白鼻騧。\n客程无暇问，先访莫愁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8670,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日于鳞邢州郡斋分韵赋十二体","author":"王世贞","text":"白日来，凄以阴。\n柅余车，将余衾。\n觏倾国，申同心。\n目流■，意荡淫。\n酿高霞，弋遥岑。\n鲙沧海，脯穷林。\n饔者何，字兰金。\n削峥嵘，缓萧森。\n觞前跃，无停斟。\n万木飞，变徵音。\n洪涛走，北陆沈。\n衷愲结，竟沾襟。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8671,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卮语二首 其一","author":"王世贞","text":"贵为掾，三语荐。\n贫为客，万言策。\n饱欲死，长三尺。\n饥欲死，东方朔。\n厕中鼠，空仓雀。\n卵有毛，马生角。\n巧抱瓮，愚炙毂。\n真渐离，假孙叔。\n叶公龙，淳于鹄。\n矢欲直，钩欲曲。\n归去来，卧空谷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8672,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卮语二首 其二","author":"王世贞","text":"世间事，那有此。\n齐国王，卒饿死。\n沛亭长，作天子。\n岁百战，垂千祀。\n并六合，传二世。\n厕中人，断君头。\n堂下客，代君侯。\n魏冉走，刚成入。\n白起逝，安平出。\n吕易嬴，政僇韦。\n歇在楚，亦如之。\n臣相君，窃其母。\n君僇臣，弑其父。\n人既工，天亦巧。\n唶何为，日胶扰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8673,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄河之诗 壬子南使至徐邳间事","author":"王世贞","text":"黄河南奔，疾风北来。\n两重莫下，激而为灾。\n万籁喧呼，三维震颓。\n鹢首戒南，风斯忌而。\n亦言戒北，河其厉而。\n悠悠我心，曷既济之。\n谁云利涉，不复改辙。\n谁云走峻，不复理楫。\n川平为陆，陆汇作泽。\n芃芃禾黍，登之场圃。\n下有守人，匿而左顾。\n彼实自卫，曷不疑我。\n虽有季昆，远不相援。\n虽有雠敌，难思共存。\n仰天长歌，涕泗汍澜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8674,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西山诗 其一 戊申冬以秩祀行作","author":"王世贞","text":"朝上西山，艰哉?崟。\n溪谷多风，倏旸而阴。\n胗䁾中肤，?慄缘音。\n十步五步，不能见人。\n牛马却走，熊罴号吟。\n仆夫告痡，口舌屈噤。\n修途无端，北陆遵沈。\n道有鼷鼠，结穴何深。\n忽而过我，杳不可寻。\n菀菀好鸟，栖栖中林。\n我独何为，伛偻不禁。\n皇命秩祀，俾孔之钦。\n肃肃卿相，咫尺尔临。\n我躬不遑，简书是忱。\n念思愲结，盻此高岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8675,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西山诗 其二","author":"王世贞","text":"皇命卿士，尔往祗谒。\n夙戒卒事，毕礼以发。\n仰盻河汉，如近寝阙。\n敛其狂飙，纵以明月。\n绵绵连山，与月见没。\n峨峨隧途，松柏郁杌。\n茫茫平原，积气如渤。\n巉巉冰岩，忽起飘鹘。\n耳听骚屑，足蹑恍忽。\n岂不遄返，悯此驭卒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8676,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戒诗 其一","author":"王世贞","text":"行逢宋人，狂且见妍。\n虽有夷施，为谁朱颜。\n南山之雾，可以隐斑。\n埋照韬光，其乐闲闲。\n浮云自逝，大化长还。\n畏垒祀我，贤人之间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8677,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戒诗 其二","author":"王世贞","text":"黄帝肃驾，南游具茨。\n襄城之野，七圣皆迷。\n慰暋亡途，道逢小儿。\n一语瞭彻，拜称天师。\n岂必大隗，治其庶而。\n足已不逊，他人之资。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8678,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自青诗 其一","author":"王世贞","text":"赫赫始兴，绍晋维庸。\n爰启家族，于江之东。\n圭组蝉嫣，郁为大宗。\n改社改邑，我祀无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8679,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自青诗 其二","author":"王世贞","text":"谔谔司谏，为帝喉舌。\n棠彼晋陵，菟裘于越。\n乃启闻孙，乃脂宦辙。\n惟良吴会，以卜堂棁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8680,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自青诗 其三","author":"王世贞","text":"世益其滋，畀我皇祖。\n厥秩伊何，贰卿司马。\n恺悌君子，民之父母。\n姻族闾里，是粥是乳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8681,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自青诗 其四","author":"王世贞","text":"遹发厥祥，严君奋扬。\n绣绂皇皇，被汉及江。\n如冬之日，如秋之霜。\n作屏王畿，以承宠光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8682,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自青诗 其五","author":"王世贞","text":"唯余小子，甫离于蒙。\n鸣鹿陪京，班鹓上宫。\n曾是衮裳，而荐雕虫。\n驿驿秋官，方迓聿从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8683,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自青诗 其六","author":"王世贞","text":"严君曰咨，毋女作敖。\n毋旷女守，毋好是导。\n毋恣狎侮，以贻余诮。\n人亦有言，匪疢则药。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8684,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自青诗 其七","author":"王世贞","text":"嗟予小子，胡言弗受。\n般淫于咏，沈湎于酒。\n惟我狂简，一二朋友。\n亦既肆口，亦既濡首。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8685,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自青诗 其八","author":"王世贞","text":"小道可观，致远则非。\n从臾如流，狂张若驰。\n嶭彼乔山，蹇拟陟之。\n爚彼烈炎，徒思炙之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8686,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自青诗 其九","author":"王世贞","text":"高冠切云，长裾被趾。\n联臂蹋足，遨于都市。\n玄白惟心，雌黄在齿。\n曲突将炎，燕雀恬止。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8687,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自青诗 其十","author":"王世贞","text":"天觏闵凶，突如来如。\n猃狁孔蕃，元戎用驱。\n王锡未终，谁将竹书。\n薮雉翩翩，凤离于罝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8688,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自青诗 其十一","author":"王世贞","text":"嗟嗟小子，越隔千里。\n冠裳其燬，手足其胝。\n号旻莫应，呼霜莫起。\n人而得死，何所无死。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8689,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自青诗 其十二","author":"王世贞","text":"嗟嗟小子，饮息覆盆。\n白日未昭，畴为启昏。\n宇宙虽广，胡颜自存。\n咎衅实招，已矣何言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8690,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悯生篇","author":"王世贞","text":"上坐莫喧，下坐一言。\n今者食荠，焉知我酸。\n南山有柏，朝牂暮斤。\n北山有柽，生而参天。\n何以弹乌，请用随侯。\n何以攻革，请用吴钩。\n案鹓从禽，命豹逐鼠。\n谓汝不捷，卒当僇汝。\n迷阳升堂，国香道傍。\n土杯在坫，玉卮汲浆。\n嫫母挟瑟，夷施幽闭。\n师涓教射，夔习击技。\n磁石引金，阿锡禦冰。\n扬舲太行，骋骏洞庭。\n寄愁九天，渺旷无梯。\n埋忧九渊，沈深无蹊。\n千日之外，中山曷力。\n百岁而往，司命奚德。\n金丹在口，噤不能餐。\n岂无永生，逝者实叹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8691,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓怀 其一","author":"王世贞","text":"大禹迷终北，黄帝游华胥。\n化城高天表，古莽西南隅。\n阴阳亡交气，民人恒晏愉。\n乃知八极外，至乐故有馀。\n沴戾堕中央，令我不可居。\n阴谋相挡㧙，肉攫自纷拿。\n冥心超形外，冀得恣所如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8692,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓怀 其二","author":"王世贞","text":"矫氏脉季梁，任治为众医。\n泣者既不肖，歌者亦焉知。\n王孙戒祼葬，其友遂因之。\n庄氏等彭殇，达人守其规。\n求化焉能化，齐物故不齐。\n万类日樛纷，忘言将庶几。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8693,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓怀 其三","author":"王世贞","text":"甲兵被天来，朝野无偃居。\n思欲从园绮，筑坯商山庐。\n优游终馀日，俯仰多所愉。\n恒恐坤维拆，陵谷荡为墟。\n展转不克谋，憣然悟微躯。\n吾闻至人造，水火置若无。\n浊酒且自浇，块然还太初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8694,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓怀 其四","author":"王世贞","text":"成季推郤縠，礼乐贵戎机。\n范宣让伯游，汰者亦不违。\n端揖堂皇上，彊楚辑衡雎。\n六氏为三家，蚕食公室卑。\n岂惟惭先节，晋德日言衰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8695,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓怀 其五","author":"王世贞","text":"神龙含夜光，千祀自无饥。\n即且甘其带，栩栩来见嗤。\n刘累气块结，上诉咸巫师。\n大化偶万形，此妍彼宁媸。\n两好各自固，焉在相是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8696,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓怀 其六","author":"王世贞","text":"骊姬适晋侯，戎车啼妆湿。\n入宫与君欢，匡床愧其泣。\n才人邯郸艳，自誇倾城国。\n朝陪君王荐，夕作厮养匹。\n履荣仍讥贱，在约方念适。\n焉知非梦幻，役役劳真则。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8697,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓怀 其七","author":"王世贞","text":"左氏饰繁辞，乃在丧其明。\n子长下蚕室，述史拟麟经。\n毋论委质亏，所爱千秋名。\n夸诩尺寸长，冀与大化争。\n无趾笑仲尼，桎梏被天刑。\n何况于二生，没齿徒营营。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8698,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓怀 其八","author":"王世贞","text":"孔德岂不弘，匡人恨阳虎。\n参孝亦以孚，曾母为投杼。\n平原虚掩涕，毛生非溺者。\n古有两秋胡，空惊茂陵女。\n似是诚有端，偶来故无主。\n君子修冥冥，毁誉安足数。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8699,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓怀 其九","author":"王世贞","text":"彘王蔑周武，中兴振宣谟。\n殷忧歌云汉，虽旱不告逋。\n山甫实明哲，方召有良谟。\n徐夷既宁只，猃狁亦奔徂。\n人情戒其恒，勤思内自渝。\n祈父怨爪牙，杜伯蹈淫诛。\n遂令轮台诏，千古惜终初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8700,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓怀 其十","author":"王世贞","text":"秋风杀万物，春气滋群苗。\n何如谢寒暑，不荣亦不凋。\n老氏薄圣人，赏罚日哓哓。\n天地为之端，生人安不浇。\n寄情太始外，恬穆日逍遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8701,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓怀 其十一","author":"王世贞","text":"大禹甘旨酒，愀然若有惩。\n万机日坌至，焉能事尊罂。\n陶公但湛饮，千载自休名。\n贫贱足肆志，富贵长营营。\n黼衮与布衣，交伸不可争。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8702,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓怀 其十二","author":"王世贞","text":"昔有无支祈，佻负百夫力。\n终古腥淮流，金锁时掣搦。\n贰负杀窫窳，帝讨羁石室。\n梏拲锢其形，千载郁如腊。\n中祀无百年，滔滔恶焉极。\n宣淫荡天纪，一死事以息。\n怅然念休代，奸人易为贼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8703,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓怀 其十三","author":"王世贞","text":"皇王宪天则，广覆物不遗。\n四门列九服，大开明堂基。\n嬴帝吞六雄，扬兵震四垂。\n炎武因遗迹，滇岭悉来归。\n魋结袭冠簪，卉服改裳衣。\n西琛并南赆，王会无后期。\n善哉太史公，谓得圣人威。\n竖儒守一经，安能知是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8704,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]