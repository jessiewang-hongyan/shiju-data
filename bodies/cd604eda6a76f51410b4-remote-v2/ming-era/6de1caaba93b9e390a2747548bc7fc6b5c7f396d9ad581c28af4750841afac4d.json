[{"title":"渔村夕照 其四 江天暮雪","author":"李梦阳","text":"长江浪滚雪，烟黑花争飞。\n可怪横流者，孤舟一笠归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56434,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渔村夕照 其五 洞庭秋月","author":"李梦阳","text":"天水本自空，圆月况秋映。\n皛皛起霜色，千里一悬镜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56435,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渔村夕照 其六 潇湘夜雨","author":"李梦阳","text":"夜响起秋竹，浩浩楚云白。\n晓来看沙觜，新水添一尺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56436,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渔村夕照 其七 远浦归帆","author":"李梦阳","text":"秋风五两席，点点聚复散。\n不信小小觉，飞飞速征雁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56437,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渔村夕照 其八 山市晴岚","author":"李梦阳","text":"峰晴堆夜岚，晨炊翠犹湿。\n但闻山鸟鸣，不见鸟出入。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56438,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"薜荔园","author":"李梦阳","text":"芳园蓊薜荔，水石非人间。\n昔闻西洞庭，今为学士山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56439,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"恩乐堂","author":"李梦阳","text":"肯堂钦古训，修祠报前功。\n酌洞歌行潦，采蘩遵召风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56440,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"石假山","author":"李梦阳","text":"磊奇成我山，云气遽袅袅。\n勺水即溟渤，拳石是蓬岛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56441,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"水鉴楼","author":"李梦阳","text":"风吹池萍开，天空水如镜。\n幽人时凭阑，下看行云影。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56442,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"风竹轩","author":"李梦阳","text":"吾轩自有竹，暑月常寒声。\n山静无风时，满林空翠生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56443,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蕉石亭","author":"李梦阳","text":"看石忽有诗，攀蕉书其上。\n夜来雨打叶，惊闻金石响。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56444,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观耕台","author":"李梦阳","text":"洞庭有兴云，太湖无落波。\n登台问农者，下勤将如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56445,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蔷薇洞","author":"李梦阳","text":"洞口蔷薇密，石花压云湿。\n晓采枝上露，不知鹤飞出。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56446,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"荷池","author":"李梦阳","text":"山风吹水香，脱巾池上坐。\n盈盈千岁龟，飞上荷叶卧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56447,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柏屏","author":"李梦阳","text":"堂堂千尺材，为屏忍屈曲。\n终抱凌云情，不改岁寒绿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56448,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"留月峰","author":"李梦阳","text":"峰奇自成窍，似月非有心。\n月来尔何意，徘徊光与深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56449,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"通泠桥","author":"李梦阳","text":"雨过崖水响，石梁袅山涧。\n晴天挂一虹，溪断云不断。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56450,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"花源","author":"李梦阳","text":"落英泛流水，点点如飘霞。\n为有问津者，不敢种桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56451,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"钓矶","author":"李梦阳","text":"矶根浸寒水，细草绿如发。\n夜鱼不受饵，石上坐秋月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56452,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三五七言","author":"李梦阳","text":"天秋暮，月如素。\n金窗隔烟纱，花槛流萤度。\n良人远戍玉门西，谁念空闺玉箸啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56453,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四六八言","author":"李梦阳","text":"五阶风发，蕙花时歇。\n莎鸡夜鸣衰草，捲帘独望秋月。\n黄云没万里之关山，使妾空老而凋红颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56454,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三五七言","author":"李梦阳","text":"望云海，陟高京。\n秋风令百物，天地何冥冥。\n黄河岸头能覆车，何况羊肠诘曲行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56455,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四六八言","author":"李梦阳","text":"明月在隅，蟪蛄夜鸣。\n仰观天上列星，三三五五成行。\n憭慄悽兮不可以寐，嗟哉四时之气靡常。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56456,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金山寺 其一","author":"顾璘","text":"俯槛江心寺，涛声两带分。\n天晴秋见海，山润午生云。\n短棹今重到，名泉昔有闻。\n西风吹别酒，斜日未成醺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56457,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金山寺 其二","author":"顾璘","text":"云雾空江水，维舟陟翠岑。\n坤灵开别岛，佛界净空林。\n岩洞攀跻险，鱼龙窟宅深。\n行逢黄叶下，秋思转萧森。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56458,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"虎邱寺","author":"顾璘","text":"远游访名山，虎邱得初陟。\n溪门乍深隐，石径转崔嶪。\n阴壑注鸣泉，风林振疏叶。\n岩僧解将引，探古恣幽蹑。\n波沉贞娘魂，灰冷生公业。\n伤哉剑池名，祗见寒流渫。\n酹酒呼干将，千秋激豪侠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56459,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"石湖同陈亨父汎饮","author":"顾璘","text":"浩渺石湖水，泛舟宜素秋。\n群山倒波下，树拂青天流。\n白日光荡潏，蛟龙互沉浮。\n长风激箫鼓，放歌销人愁。\n觞行金逶迤，鸾刀荐群羞。\n请君但酣饮，岁月不我留。\n越城空黄土，范碑委榛邱。\n陵谷恒变易，顾之增烦忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56460,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吕翁南庄","author":"顾璘","text":"渔樵三五户，恬淡自成村。\n乱竹深藏宅，平田近绕门。\n松高巢水鹤，花老过河豚。\n长醉丰年酒，还思零雨恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56461,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"苕溪同刘西安元瑞话旧并棹至武林港别去 其一","author":"顾璘","text":"念子苕溪上，孤舟远过从。\n去乡身万里，对酒意千重。\n岁计看秋稼，离心寄晓钟。\n柴荆期白首，何日定行踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56462,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"苕溪同刘西安元瑞话旧并棹至武林港别去 其二","author":"顾璘","text":"良晤殊方重，交情晚岁深。\n两溪秋并棹，孤烛夜论心。\n谑浪输肝胆，飘蓬变语音。\n因悲辞骨肉，转忆向山林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56463,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岘山浮碧亭呈黄湖州子和","author":"顾璘","text":"平湖短棹镜中来，翠岫红亭罨画开。\n雾树散分洲渚断，云峰横带海天回。\n登高共续黄花节，藉草仍探白石杯。\n传道使君多暇日，每携宾从恣徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56464,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西湖","author":"顾璘","text":"群山窈回合，豁尔开洪区。\n澄波汇且广，宛在都城隅。\n灵秀自天辟，台观绝世无。\n虹桥荫芳树，烟渚发红蕖。\n兰桡斗转捷，越女夸容姝。\n莲歌荡人心，挥金盛中厨。\n靡靡即欢宴，岂遑顾菑畬。\n但苦白日暮，西风吹水枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56465,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游静慈寺因访孙山人一元","author":"顾璘","text":"晨游招提境，爱此幽胜偏。\n南山峙其后，西湖漾其前。\n华标凌波起，邃阁承崖悬。\n修竹挺寒翠，长松濯秋鲜。\n岂惟会禅悦，亦以招灵仙。\n吾生厌尘网，久怀奉真诠。\n刀圭脱相授，情爱亦易捐。\n攀援洪厓侣，翱翔凌紫烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56466,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孤山","author":"顾璘","text":"孤山葱而郁，仰止林逋宅。\n舍舟入荒蹊，森森荫松柏。\n往代云龙会，夫子戢鸿翮。\n皋夔道已沉，巢许心所获。\n岂无桃李颜，寒梅自贞白。\n皎皎空谷遗，长愧缨冕客。\n西瞻岳山坟，悽其暮烟碧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56467,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"灵隐寺","author":"顾璘","text":"水泛趣已绵，山行路仍窈。\n迤?经层峦，花宫冠林杪。\n峭壁槩微霄，下映楼观小。\n崖倾树孤撑，亭远泉重缭。\n萧条僧气閒，肃穆人声悄。\n来游属秋暮，蕉叶青袅袅。\n入径薰名香，憩涧狎幽鸟。\n顾瞻桃源幽，捐佩苦不早。\n寄言都城子，来者一何少。\n诛茅傥吾遂，庶离寰中扰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56468,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"飞来峰","author":"顾璘","text":"灵峰自何来，嵚嵜待苍凤。\n羽翮不肯敛，时时欲飞动。\n海云结轮囷，㟏岈互勾控。\n虚房缀悬蜂，横梁亘垂蝀。\n巨灵苦雕削，真宰资玩弄。\n初临侧躬入，稍深复轩洞。\n蹈危若浮槎，瞰空疑覆瓮。\n洼深日影坠，谷转风驭送。\n阴森絺衣寒，踯躅芒履重。\n班荆趺旧席，剜苔纪新颂。\n归来眠不稳，一夜劳噩梦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56469,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岳王坟","author":"顾璘","text":"崔巍中兴业，浩荡英雄才。\n刺身誓日月，驱甲鸣风雷。\n艰哉朱仙镇，天地划再开。\n君王亦何意，自卷旌旗回。\n中原本吾土，突骑胡为来。\n家昏鬼蜮啸，国破长城摧。\n宰木空南向，厓山益悲哀。\n举觞酹宿莽，歌罢魂俱颓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56470,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"桐庐江行寄汪佥宪一夔","author":"顾璘","text":"晓发富春渚，暮望桐庐宿。\n江空寒水净，岸转云峰矗。\n孤帆缅逶迤，霁景聊寓目。\n渺渺沙际村，浮烟霭丛木。\n垂岩杞菊班，覆垄禾黍熟。\n兹方静无虞，生理见耕牧。\n高贤涖行台，敷政况清肃。\n眷尔鸿雁居，幸脱豺虎毒。\n沉忧正浩荡，且用慰心曲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56471,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"严子陵祠","author":"顾璘","text":"垂纶客去今千载，犹见高台对碧流。\n几户蓬茅馀凤种，万方戈甲一羊裘。\n天空大泽星辰动，露下秋山草木愁。\n岂料平生逃绂冕，却遗名姓在乡州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56472,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"常山道中 其一","author":"顾璘","text":"旅况逢秋尽，山行叹路赊。\n旱来无野渡，乱后少人家。\n橘柚寒多实，夫容晚自华。\n愁云黯无极，肠断楚天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56473,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"常山道中 其二","author":"顾璘","text":"迢递常山道，千岩落木风。\n客程忧患里，秋色乱离中。\n问俗嗟生理，逢人说战功。\n伤心乌桕叶，默默不禁红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56474,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泊弋阳溪","author":"顾璘","text":"孤帆逗何处，残月弋阳溪。\n晚水澹相照，寒鸦惊自啼。\n远游惭薄养，多病忆幽栖。\n岂是怀荣禄，来过楚水西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56475,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄广信朱太守亨之","author":"顾璘","text":"南州腰笏始经年，美政相传过昔贤。\n洞寇买牛捐带剑，野人无吏索租钱。\n霜前禾黍孤城雨，月下弦歌万井烟。\n惭愧樗材亦何用，皇恩又遣到湘川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56476,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中溪行杂诗 其一","author":"顾璘","text":"十日溪中舟，格格响溪石。\n孤篷过鸣雨，忽失沙上脊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56477,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中溪行杂诗 其二","author":"顾璘","text":"暮雨寒溪急，秋烟远岫微。\n扁舟冲浪去，何日顺潮归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56478,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中溪行杂诗 其三","author":"顾璘","text":"暮程投野镇，逆旅恋乡人。\n怕有金陵客，逢舟借问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56479,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中溪行杂诗 其四","author":"顾璘","text":"悬薄者谁室，宛在水边居。\n停舟试借问，高人或姓徐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56480,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中溪行杂诗 其五","author":"顾璘","text":"秋容殊可悦，客棹且须迟。\n霜叶飞红雨，烟岑抹黛眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56481,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中溪行杂诗 其六","author":"顾璘","text":"小舟乱如叶，沉雅深渊中。\n衔鱼自飞起，不敢惊蛟龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56482,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中溪行杂诗 其七","author":"顾璘","text":"尽知为客恶，还见别家多。\n风雨空愁在，山林奈晚何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56483,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中溪行杂诗 其八","author":"顾璘","text":"楚天寒信迟，况入小春月。\n冉冉横山烟，青青缀林叶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56484,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中溪行杂诗 其九","author":"顾璘","text":"远客经时节，孤舟积雨寒。\n无心争道路，嬴得梦魂安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56485,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中溪行杂诗 其十","author":"顾璘","text":"沧波生暮霭，渺渺钓船归。\n细雨寒蓑重，斜风并棹稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56486,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中溪行杂诗 其十一","author":"顾璘","text":"艰难伤物役，澹泊爱舟居。\n晚饭客遗酒，夜灯儿读书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56487,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中溪行杂诗 其十二","author":"顾璘","text":"云断雨声歇，水清天影流。\n苦吟双短鬓，高枕一扁舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56488,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中溪行杂诗 其十三","author":"顾璘","text":"山水行踪美，风霜岁序阑。\n高堂遥送喜，游子且加餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56489,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中溪行杂诗 其十四","author":"顾璘","text":"日暮争渡喧，天阴野风急。\n孤客来何迟，萧萧荷锄立。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56490,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中溪行杂诗 其十五","author":"顾璘","text":"晚云横树薄，寒雨入帘微。\n川净鱼堪数，人间鹭不飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56491,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过馀干","author":"顾璘","text":"古城云暝草萧萧，废井人稀昼寂寥。\n三户凋零伤旧楚，百年熙皞忆先朝。\n江头白骨乌鸢噪，洞里黄巾虎豹骄。\n闻道将军饶战略，不应多垒遍苍郊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56492,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"独吟 其一","author":"顾璘","text":"湘浦孤舟玉露寒，戌楼鸣鼓烛花残。\n青云怅望孙弘阁，白首飘零子夏冠。\n秋梦过家惟伏枕，月华临水独凭栏。\n参差欲就淮南隐，已见山中桂树团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56493,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"独吟 其二","author":"顾璘","text":"平川渺渺客愁生，极浦丹枫映晚晴。\n江水正连杨子渡，离人何赖楚歌声。\n天涯一郡空劳梦，云里千峰不辨名。\n长路栖迟阳月尽，繁霜摇落瘴烟清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56494,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"独吟 其三","author":"顾璘","text":"戎马中原鬓已华，一麾迢递向天涯。\n荒城白屋犹征税，故国青山更别家。\n秋梦南归江汉阔，暮程西望斗牛斜。\n扁舟独宿空滩冷，野戌悲风急夜笳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56495,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"章江留别李宪副献吉屠少参文魁","author":"顾璘","text":"恻恻伤远别，眷此清江流。\n悲风激长薄，浮云隐重洲。\n去家邈千里，惘然增百忧。\n弭棹适洪都，果谐心所求。\n良友始邂逅，道言互赓酬。\n感叹风波事，委曲舟车谋。\n倾觞远饯送，毕景情未休。\n嘉晤殊慰悦，旅泊何淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56496,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"豫章江上逢方大参文玉","author":"顾璘","text":"瓷罂酒湛碧玉浆，雕盘鸡割黄金肪。\n故人停舟劝我饮，捲帘四座临苍茫。\n江山信美客抱豁，白日未午空罍觞。\n气酣谈剧增叹息，悲歌起舞江云黄。\n忆昔先朝侍东署，冠簪济济朝明堂。\n芝兰閒馆重交结，金玉艺苑腾文章。\n一朝风尘忽澒洞，故旧转盼多凋伤。\n纷纭群盗乱中土，大夫负剑从戎行。\n与君相逢江水上，值予憔悴流南荒。\n赠予荆南玉练纸，相邀作赋庐山阳。\n羁怀龌龊那能尔，明朝拂曙下潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56497,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"临江丛竹间虎","author":"顾璘","text":"西林白日暮，溪上无村坞。\n牵夫仓皇啼入舟，幽丛虓虎几噬汝。\n舣舟侧望白额狞，双睛㸌电对人怒。\n吁嗟尔虎太不武，近渚鼋鼍肉磈礨，岩穴豺狼饱而舞。\n尔何不往搏食之，顾来溪头惊我小儿女。\n惜哉我无蛇弓雕羽箭，一发毙尔腊为脯。\n呜呼豫章猛士千百群，安知无一李将军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56498,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮泛秀江 其一","author":"顾璘","text":"桂岭望何极，孤舟行转迷。\n秀江斜景里，衡岳乱云西。\n宿雁冲帆起，哀猿傍客啼。\n多愁厌乡梦，夜坐听鸣鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56499,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮泛秀江 其二","author":"顾璘","text":"游梁方失意，适楚更悠悠。\n寒野牛羊夕，空江雁鹜秋。\n腐儒悲末路，幽兴狎扁舟。\n欲向桃花水，垂纶待白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56500,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮泛秀江 其三","author":"顾璘","text":"路转清江外，舟移锦石中。\n爪香分绿橘，目艳对丹枫。\n检药防山瘴，陈诗叙国风。\n冒霜梳短发，应愧鹿门翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56501,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮泛秀江 其四","author":"顾璘","text":"石壁攒江狭，风樯逆浪飞。\n渐看湘国近，转与客心违。\n芳桂临波发，遥岑隔雾微。\n明妆浣纱女，妍笑竞斜晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56502,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮泛秀江 其五","author":"顾璘","text":"蓬舠依濑转，筦簟枕肱眠。\n急浪鸣舷过，危峰就幕悬。\n茭蒲时碍楫，鱼鳖不论钱。\n自喜幽襟洽，浑忘物役牵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56503,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"严太史惟中东堂","author":"顾璘","text":"新堂诛茅仍故墟，寒溪度郭鸣阶除。\n春风入帘语巢燕，朝日映户坐看书。\n酒熟时来长者辙，山深何厌廛中居。\n诗筒独驱一黄犬，尘壁宛挂双银鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56504,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]