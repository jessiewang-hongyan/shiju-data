4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4487,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别太冲兼怀同社诸公","author":"庞嵩","text":"紫霄回首白云蒙，粤社天关在望中。\n此去江长天渐远，论文杯酒几时同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4488,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再步甘泉师韵","author":"庞嵩","text":"紫云开院已多年，衣钵衡阳得几传。\n千里我来江上望，恍如真境忽参前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4489,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登天台寺","author":"庞嵩","text":"紫薇天北有三台，此寺天台天与来。\n我与天游空一望，万山苍翠总低回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4490,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"维舟石鼓访别驾林怀兰丈未遇寻邂逅于衡山江浒次韵奉答二首 其一","author":"庞嵩","text":"一笑浮云世已轻，每从山水寄幽情。\n山僧何处供茶果，浪报人间得姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4491,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"维舟石鼓访别驾林怀兰丈未遇寻邂逅于衡山江浒次韵奉答二首 其二","author":"庞嵩","text":"孤鹤每希和靖节，三春空老鹿门耕。\n陇头相对如宾馌，岂料荆州误识名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4492,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"有感示儿德","author":"庞嵩","text":"昔年侍母暂违父，严侍今朝长背母。\n彬湘两度皆冬寒，手线游衣今独苦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4493,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"关公庙","author":"庞嵩","text":"江涛滚滚沸天风，一障回澜砥柱雄。\n东去六朝流水尽，威灵惟见武安宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4494,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书自然上人卷","author":"庞嵩","text":"面壁荒山廿载馀，静中端的见真如。\n从今信脚无拘束，一任行云过太虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4495,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书太初僧卷","author":"庞嵩","text":"一画原来未画先，色空空色两茫然。\n若教会领真空趣，籁息山幽月在天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4496,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为常山陈君荻洲题扇 其一","author":"庞嵩","text":"露湛兼葭秋水深，美人家住水云阴。\n怀贤知有崇贤意，欲向知音一鼓琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4497,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为常山陈君荻洲题扇 其二","author":"庞嵩","text":"未见浑如曾识面，素心宁为俗尘缁。\n故人天上来千里，正是清风拂面时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4498,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠友","author":"庞嵩","text":"过雨长安洗旧尘，新泉活水几添新。\n八溟剩有连鳌手，共整长竿理钓纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4499,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和巾石翁钟灵即事","author":"庞嵩","text":"看山欲识真山面，会到钟灵山始见。\n灵元默运成胚胎，化化生生形万变。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4500,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登小金山望斗南弟不至 其一","author":"庞嵩","text":"石径无尘古刹幽，僧开方丈傍丹邱。\n昙花阶下和云落，山色波间抱日流。\n出洞烟霞封宝殿，悬厓星斗护灵洲。\n宦情羁思添离恨，骢马不来独倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4501,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登小金山望斗南弟不至 其二","author":"庞嵩","text":"海上仙都紫翠堆，壮游今夕复登台。\n金钩露拔星河转，玉麈斜挥瘴疠开。\n石壁藤萝留宿雨，云岩钟鼓没浮埃。\n凭高一望风涛息，不见官船荡月来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4502,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山飞来寺","author":"庞嵩","text":"几载飞来惯梦游，飞来今喜舣行舟。\n笑看世界浮云梦，坐定禅心百虑休。\n猿返玉环烟漠漠，犀沉金锁水悠悠。\n等閒拟约听僧偈，招手天风丹桂秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4503,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送曹峒峰擢广西宪副 其一","author":"庞嵩","text":"皇初世弥远，大朴日已漓。\n蒙泉到西湖，溢载筝与丝。\n挺挺苍玉质，矫矫逵羽仪。\n愿言绍于迈，揽辔追黄羲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4504,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送曹峒峰擢广西宪副 其二","author":"庞嵩","text":"老翮冲图南，眷集琼海北。\n虎门扇艚么，聊借干羽格。\n惭余藐太丘，恶少苦群迫。\n欃枪落旄头，东阳见生白。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4505,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送曹峒峰擢广西宪副 其三","author":"庞嵩","text":"神尧驭疆宇，杰俊罗四方。\n章缝集佳士，韎鞈呈素长。\n荐书效奇策，烨烨明天章。\n因之骛遐轨，永以驰康庄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4506,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送松陵太守之任琼州","author":"庞嵩","text":"玉井金风拂素台，心星西下暑初回。\n送君去去梅关路，正有芙蓉江上开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4507,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游衡山追和甘泉先师韵","author":"庞嵩","text":"万仞峰头一振衣，雪睛烟树半霏微。\n祝融捧出南天日，紫盖平连赤帝畿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4508,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卧仙岩","author":"庞嵩","text":"壶中别有天，谷口浑无事。\n一枕八百秋，风雨轰雷鼻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4509,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"明明","author":"欧大任","text":"太一明明，十二紫宫匡卫成，五岳泰华恒嵩衡。\n皇帝坐明堂，左右以股肱。\n群吏奉法，民不知兵。\n征繇息，庾禀盈。\n沐日浴月五谷生，烟火万里狗吠而鸡鸣。\n六七十翁敖户庭，自未尝至闾井行。\n比屋为宾主，妇子治糁羹。\n考钟拊鼓，弹丝吹笙。\n灵芝华华槃舞终，嘉福穰穰熙和蒸。\n为我谓客，且安坐而酌兕觥，今我不乐将何营。\n击壤游以嬉，天地惟曼宁。\n百昌并，四海正，陛下万载人太平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4510,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"芳树","author":"欧大任","text":"芳树翠葳蕤，照我东西厢。\n嘉祀承蚃肸，郁鬯百醴芗。\n一人庆成，九门有闶。\n卿云缦缦朗景长，戛鸣球镛奏笙簧。\n万民愉，庶物康。\n凤凰秋秋，鸿鹄将将，辟邪天禄纷而翔。\n茝兰结佩玑璇英，千秋万岁奉我皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4511,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"艳歌行","author":"欧大任","text":"日出东南隅，陌上光景杲。\n妾心畏蚕饥，闺中起常早。\n言采陌上桑，少年逢路旁。\n驷马立踟蹰，遣吏下请将。\n妾跪长太息，妾家有夫侍中郎。\n侍中五日一洗沐，门前车马烂生光。\n君自有妇妾有夫，钱刀何用徒区区。\n君可速归去，勿复问罗敷。\n采桑采桑朝露多，闺中蚕饥愁奈何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4512,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]