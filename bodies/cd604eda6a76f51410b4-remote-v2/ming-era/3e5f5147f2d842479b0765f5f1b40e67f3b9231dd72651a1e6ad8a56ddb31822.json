[{"title":"应制作潇湘八景 其五 平沙落雁","author":"朱同","text":"秋色澄空碧霄远，蓐收气肃寒云捲。\n数声嘹唳天外来，低落平沙水清浅。\n羽毛独尔知随阳，岂为饥肠怀稻粱。\n衔芦不烦避矰缴，解网今已同商汤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33994,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"应制作潇湘八景 其六 远浦归帆","author":"朱同","text":"灏气满空秋洒洒，潦尽潭清木叶下。\n片帆几点天际来，破浪乘风如走马。\n江汉今为雁鹜池，商舶钓艇从所之。\n暮归晨出会有时，慎勿纵欲令人嗤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33995,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"应制作潇湘八景 其七 渔村夕照","author":"朱同","text":"茅屋人家小门径，红蓼白蘋欲齐胫。\n收缗晒网插疏篱，短渚长洲递相映。\n红轮留照悬远空，水村泽国俱春融。\n饭饱不知身外事，欸乃一曲歌淳风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33996,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"应制作潇湘八景 其八 山市晴岚","author":"朱同","text":"平湖远接青山麓，瓦屋布帘烟簇簇。\n曈曈海日出山头，晻霭林霏淡平陆。\n鲜鳞可买醪可沽，醉归不倩傍人扶。\n皇风万里被海隅，渔樵乐土无处无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33997,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"感怀癸卯 其一","author":"朱同","text":"报国空怀策，思乡懒上楼。\n家山千里远，湖海二年秋。\n世态须青眼，羁栖自白头。\n倚门思子泪，应寄浙江流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33998,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"感怀癸卯 其二","author":"朱同","text":"不作东山卧，空登王粲楼。\n丹心朝对日，病骨夜惊秋。\n故里频来梦，吴霜易上头。\n憾如江水阔，薄暮接天流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33999,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送人归后有怀","author":"朱同","text":"岁月怀桑梓，霜风到客衾。\n思亲方寸乱，送客泪痕深。\n此去望乡信，何时闻好音。\n神光应变化，宝剑暮龙吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34000,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵冯伯昂同发姑苏","author":"朱同","text":"鲁酒不可饮，须倾三百杯。\n君恩犹未报，丹寸肯成灰。\n自有鲲鹏路，可令鸥鹭猜。\n长江波万里，谁负济川才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34001,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵伯昂见寄","author":"朱同","text":"家山不可望，南国暗旌旗。\n怕读登楼赋，长吟伐木诗。\n云低江树远，天阔海帆迟。\n却忆同舟夜，何如载雪时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34002,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"可惜","author":"朱同","text":"可惜碧桃树，孤根远日华。\n绿微枝底叶，红淡雨馀花。\n傍水含朝露，照人生晚霞。\n明朝重去看，一一堕泥沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34003,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画","author":"朱同","text":"密树深藏寺，轻舟暖棹烟。\n藤萝垂石上，草阁俯江边。\n高岸立峭壁，归鸿来远天。\n平生江海志，付与画诗传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34004,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"端午中黄亲招饮齐明楼分韵得榴字","author":"朱同","text":"五月春花树，墙头有火榴。\n情因亲故重，酒为倡酬留。\n山色入窗满，溪声绕座流。\n何须问蓬岛，只此是丹丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34005,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟过石崇湖次韵彦铭 其一","author":"朱同","text":"山势西来尽，波平接太清。\n地连天堑重，名盖石崇轻。\n镜净空无滓，风翻浪忽惊。\n掀篷莫回首，何限故乡情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34006,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟过石崇湖次韵彦铭 其二","author":"朱同","text":"舟行堤渐阔，圆影浸空清。\n浪荡四山动，帆飞一叶轻。\n望远心如醉，思亲梦亦惊。\n君恩天广大，那可不陈情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34007,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠王若霖二首 其一","author":"朱同","text":"且酌樽中酒，重逢未有期。\n歙南看月夜，江右望云时。\n路逐溪声转，山随行处移。\n明朝登岭后，回首倍相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34008,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠王若霖二首 其二","author":"朱同","text":"幼学壮行志，书生本自期。\n方当勤苦日，莫负圣明时。\n雨过岚光重，云开树影移。\n祗应崇令德，千里慰遐思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34009,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题折枝梨花兼实图","author":"朱同","text":"秋日梨花咏，道园曾有诗。\n青枝已秋实，白雪尚春姿。\n苏子非今梦，杜陵忆少时。\n不因良友笔，谁重昔贤思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34010,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题自画扇赠曹子纯","author":"朱同","text":"野树秋容老，层峦晓气蒸。\n寺钟如隐隐，江水自澄澄。\n举世悲伤足，何人乐曲肱。\n抱琴林下者，好结浴沂朋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34011,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠智惠忆归南泉","author":"朱同","text":"欲破愚痴障，须悬智惠幢。\n三生漫吴越，一吸尽西江。\n泉石曾供眼，云山故入窗。\n祖灯期再续，已见外魔降。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34012,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上巳苦雨呈汪养晦","author":"朱同","text":"三月三日苦淫雨，春游无计令人愁。\n云低暮色近垂地，风捲涛声遥撼楼。\n青天白日果何处，急电轰雷方未休。\n最怜桃李花开树，零落离披不自由。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34013,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"大雨","author":"朱同","text":"三月十八苦炎蒸，客子解衣如甑中。\n忽惊雷电绕庭户，已见风云盈大空。\n雨声倒挽银汉落，水势直与沧溟同。\n前村咫尺断来往，令人倍忆济川功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34014,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登子陵钓台有感","author":"朱同","text":"清晓扁舟维岸阴，百年几渡来登临。\n游人仰扳石磴险，飞台俯瞰沧波深。\n客星帝座一时事，江水云山千古心。\n哲人去矣不可见，击剑空作秋龙吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34015,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"汊口程伯龄扁所居曰容膝山房求余写乔松古木图因题以为赠","author":"朱同","text":"老松参天倚清濆，卓立迥出凡木群。\n百年生息饱雨露，一日变化超风云。\n云溪故家足乔木，容膝山房更清淑。\n知君每爱林下风，故写幽人坐溪腹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34016,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山居述怀","author":"朱同","text":"投迹穷山休便休，閒身犹抱古今愁。\n百年自分田园乐，万里谁思社稷忧。\n郭令岂无陶令志，董生宁有贾生筹。\n经纶本是男儿事，莫理雕虫到白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34017,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉寄陈秉初","author":"朱同","text":"欲写刍荛报所知，楚天云阔雁书迟。\n扶倾已藉诸公力，侧席应劳圣主思。\n旧俗难忘周社稷，危时空望汉旌旗。\n投鞭何日踰天堑，晋拜元龙会有期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34018,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梦归梅花初月楼","author":"朱同","text":"一剑新从死地来，梦魂长绕故山隈。\n清辉万里秋光老，寒影几枝春信回。\n但觉亲恩天广大，岂知世事日尘埃。\n片时枕上团圞乐，无奈城头画角催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34019,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过永乐田家有感","author":"朱同","text":"移舟暂泊钓鱼矶，一径委蛇入翠微。\n落日园林鸡犬富，秋风平野稻粱肥。\n农翁但道征徭重，啼鸟那知世事非。\n莫怨栖迟身是客，家山亦有旧柴扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34020,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"严君诞日","author":"朱同","text":"年年称寿梅花月，今日凄凉思故扉。\n堂上有亲垂白发，阶前无我戏斑衣。\n浙江秋老人空瘦，回岭风高雁过稀。\n安得元戎先十乘，洗天风雨早同归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34021,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"七月登吴山感去年离家之作","author":"朱同","text":"江上秋风吹客衣，江头塞雁又南飞。\n报君寸铁曾无补，作客一年犹未归。\n黄菊未沾新雨露，白云应锁旧柴扉。\n登楼莫忆去年事，且向栏杆看落晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34022,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中奉寄李仲吉员外戴子华二契兄","author":"朱同","text":"兴来欲访戴安道，诗好长怀李谪仙。\n客里风光浑是梦，雨中官舍小于船。\n已知生死同今日，莫使才名愧古贤。\n世上英雄谁是主，与君努力中兴年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34023,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉寄山阴县丞陈大用","author":"朱同","text":"才名本自重南金，未许相逢叹陆沉。\n异路共为千里客，故乡谁念五更心。\n海门日上天光近，江浦云归树色深。\n莫道过门风致尽，扁舟正拟过山阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34024,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同年仲望参谋高德初过嘉兴三塔寺分韵赋诗得门字","author":"朱同","text":"风急舟轻似马奔，楚吟又动望乡魂。\n暮云三塔林间寺，茅屋几家湖上村。\n雁阵远冲霜浦令，边尘遥接戍楼昏。\n平生每爱逢僧话，带月何妨叩梵门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34025,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿嘉兴通济院题壁","author":"朱同","text":"过尽平湖拟问津，忽惊林屋傍湖滨。\n竹阴风细疑无暑，花落莺啼别有春。\n身世不逃嗔妄想，飘零长作别离人。\n何时一了平生愿，归去家山拜老亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34026,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"至日登吴山","author":"朱同","text":"闻道春从地底还，望春独上吴山巅。\n海帆几点落天外，塞雁一声来日边。\n弹铗敢求迁代舍，思莼未许赋归田。\n男儿出处关风化，不用抬头问老天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34027,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵高德初述怀 其一","author":"朱同","text":"梦破梅花夜不眠，满床明月正中天。\n一时用舍真儿戏，千古兴亡著简编。\n身老自堪归杜曲，诗成谁使效张颠。\n平生心事何人解，拟向王门一上笺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34028,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵高德初述怀 其二","author":"朱同","text":"笛声惊起海龙眠，送作江南雨满天。\n世上风云閒老手，山中灯火废残编。\n窜身岭海悲韩愈，借榻禅房喜大颠。\n自是草庐无意卧，不烦束帛为戋戋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34029,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉赠唐佐衡老师","author":"朱同","text":"平生每愧朱公惔，岁晚忽逢唐子西。\n上国未瞻郊凤至，故居空听夜乌啼。\n谈诗抵掌唾壶缺，把酒临风江月低。\n他日卜邻何处好，黄山高与白云齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34030,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵杨思齐感怀","author":"朱同","text":"百鍊冰清任断魂，吹竽无意上王门。\n三年未有匡时策，一饭总成明主恩。\n献赋得金真易与，草玄投阁不堪论。\n头颅镜里今如许，莫遣秋霜鬓上存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34031,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同冯伯昂泛舟由姑苏过吴江抵钱塘舟中有作","author":"朱同","text":"连床夜听姑苏雨，柔橹晓棹吴江云。\n大地北来山势尽，长江东去浪花分。\n知君久抱屠龙技，叹我空怀封禅文。\n安得扁舟早归去，故山高卧谢知闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34032,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴江即景分韵得池字","author":"朱同","text":"平湖万顷去帆迟，遥见孤村列戍旗。\n一塔已无当日箭，三高犹有昔年祠。\n风掀急浪飞桥动，霜满高楼画角悲。\n欲访鸱夷何处是，望中烟树自参差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34033,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过吴江思归","author":"朱同","text":"岁暮江春忆故园，片云犹隔路三千。\n长歌作客岂今日，拔剑出门思去年。\n古歙春归梅似雪，吴江风静水如天。\n双亲欲望儿归日，无奈南来有障烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34034,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵冯伯昂见赠","author":"朱同","text":"扁舟载雨夜沉沉，好语时闻咳唾音。\n弹铗作歌知客憾，论功坐树见臣心。\n无缘可结三生梦，有志终成百鍊金。\n江左几时休战伐，与君携手步园林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34035,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元日有感","author":"朱同","text":"万国衣冠拜衮衣，两年元旦负归期。\n江云朝捲千寻碧，海日晴曛五色旗。\n江上雪消春水长，山中寒重早梅迟。\n莫思乡党常年会，宝剑当酬国士知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34036,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"慈亲花甲之日是夜梦中称寿觉后有感","author":"朱同","text":"梦中樽酒寿慈亲，梦觉登楼望白云。\n四海尚闻悲战伐，百年何计树功勋。\n眼枯自洒孟宗泪，情裂谁怜李密文。\n但得寰区归上国，便当万死报明君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34037,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵万寿塔长老赠天真藏主天真宣人","author":"朱同","text":"万寿寺前古木森，系舟时复远相寻。\n诗成不作人间语，琴好谁听世外音。\n琪树风生惊夜雨，法坛云静覆春阴。\n敬亭山色何年别，日暮江东千里心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34038,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题冷起敬如此江山亭","author":"朱同","text":"亭搆吴山百尺梯，更阑时听海鸡啼。\n丝桐夜雨清猿梦，杨柳春风送马蹄。\n雪涨海门天堑阔，潮回江浦月痕低。\n登临若问登临句，如此江山如此题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34039,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"发钱塘至馀杭城阻雨三日题城北楼 其一","author":"朱同","text":"三载江淮奔战尘，济时空负百年身。\n青山尚是来时路，城郭今非旧日人。\n追信已无萧相国，举贤谁似晋胥臣。\n明朝又上新安道，回首钱塘泪满巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34040,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"发钱塘至馀杭城阻雨三日题城北楼 其二","author":"朱同","text":"百雉孤城流水东，青山掩映戍旗红。\n蛙声日夜乱城柝，岚气作云漫碧空。\n茅屋几家兵火后，关河千里战尘中。\n鹍鹏自有天池路，非复吴中旧阿蒙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34041,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过昌化次前韵","author":"朱同","text":"未拂征衣满面尘，云林何计乞閒身。\n荒村白日有啼鸟，废屋颓垣无住人。\n大地岂应终破碎，普天谁为正君臣。\n高堂自有二亲在，且向晨昏事盥巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34042,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"度昱关宿老竹田家及抵家述怀","author":"朱同","text":"险阻艰难备此程，百年生死一毛轻。\n但知憾比徐方寸，深愧才非杜北征。\n茅屋昼藏牛共卧，山溪夜渡虎同行。\n归来已喜双亲健，莫遣秋霜上鬓茎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34043,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵李仲吉见赠","author":"朱同","text":"千里还乡已到乡，故人应是更凄凉。\n珠还合浦神光在，雁叫寒云别憾长。\n沧海桑田心不变，山林钟鼎事何妨。\n雪深山径药苗小，何日林间遇阮郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34044,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉简敬道兄长见顾","author":"朱同","text":"林间终日坐苍苔，有客过从此地来。\n厚馈远称慈母寿，好怀今为故人开。\n黄昏烛尽云山出，半夜诗成风雨催。\n莫厌田家供奉薄，看花村坞当衔杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34045,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题自作山水 其一","author":"朱同","text":"小阁独坐日无事，几回飞梦到天台。\n一时风雨眼前过，万里山河笔底开。\n林下有人閒白昼，世间无地不黄埃。\n便当办取九节杖，剑阁匡庐频往回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34046,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题自作山水 其二","author":"朱同","text":"谁剪吴江半幅天，沧洲诗思便悠然。\n长江万里云垂地，锡杖一条僧上船。\n怪石定从山上落，乔松势与海相连。\n好山是处堪图画，任取旁人笑米颠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34047,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过瑶溪访俞敬道不遇因留宿是时敬道有金陵经商之行","author":"朱同","text":"故人别去忽三月，乘兴泠然御晓风。\n避客本非段干木，泛舟应拟陶朱公。\n窗间月影生林外，壁上灯花落酒中。\n自是过门不相见，风流难与昔人同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34048,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别鲍尚絅赴人才选","author":"朱同","text":"五月炎天金石流，故人何事买行舟。\n兴亡莫问乌衣巷，啸咏应过白鹭洲。\n几载焚膏传世学，一朝束带应时求。\n欲知别后相思处，月上梅梢夜夜楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34049,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"施杜端三使君见访索赠","author":"朱同","text":"联翩三骑出城东，此日追游清赏同。\n但向梅花玩初月，肯随柳絮逐春风。\n稻收平野郊原旷，雁叫清霜宇宙空。\n先后锦还京阙近，莫言耕钓有隆中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34050,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋雨感怀","author":"朱同","text":"云锁干岩昼不开，揽衣小阁独徘徊。\n风飘翠色纷纷下，雨送寒声阵阵来。\n竹叶已空前日醉，桂花莫受晓霜催。\n眼中千古兴亡事，拨向炉中铁箸灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34051,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"实夫有金陵之行令人重增慨叹短章奉寄以见下怀","author":"朱同","text":"春首过从到敝庐，谈诗清夜剪园蔬。\n久知衡宇能容膝，岂料王门再曳裾。\n见志但知孙绰赋，济时莫上贾生书。\n眼中故旧飘零尽，回首西风叹索居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34052,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"汪尚书挽章","author":"朱同","text":"敬亭秋色何人敌，天挺奇才出士林。\n问学始膺先代泽，艰危终见老臣心。\n乾坤推转有兴废，贤圣操持无古今。\n德业已垂青史笔，却令后死重哀吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34053,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"归故宅","author":"朱同","text":"曲曲清溪来往频，故园又得见先春。\n笋穿舍北竹绕屋，梅倚墙头花笑人。\n泉石几家供客眼，江山万里暗兵尘。\n由来轩冕多翻覆，涧水松风未是贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34054,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同鲍氏诸公游灵山绝顶松林","author":"朱同","text":"大地山河一览中，登临感慨古今同。\n片云又作人间雨，万里自来天外风。\n尚有尘埃盈下界，全无纤芥碍虚空。\n吹箫玉女云中下，指点蓬莱沧海东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34055,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬夜","author":"朱同","text":"千林秋尽夜迢迢，十二栏杆倚碧霄。\n道统已惭周茂叔，将门还许霍嫖姚。\n乱山明月凉如雪，半夜狂风怒似潮。\n白面书生成底事，莫将身世老渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34056,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题白云楼","author":"朱同","text":"自作茧窝人已仙，白云明在尚悠然。\n登楼作赋伤今日，荷锸携壶思昔年。\n栏倚长空秋见雁，林藏积雨夜啼鹃。\n九龄帝与誇当日，白发重看继世贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34057,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]