[{"title":"和答郭杏冈司成三首 其一","author":"孙承恩","text":"见说官居好，悠然吏隐情。\n花边棋屡覆，竹上句时成。\n勋业看前辈，才猷范后生。\n况闻门第寂，冰雪照人清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36689,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和答郭杏冈司成三首 其二","author":"孙承恩","text":"我亦幽栖好，新开水竹居。\n道心成澹泊，习气半消除。\n慷慨能忘世，疏慵不废书。\n驰驱有王事，明发又巾车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36690,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和答郭杏冈司成三首 其三","author":"孙承恩","text":"暂领幽栖乐，都忘作宦时。\n迂疏故人念，踪迹野鸥知。\n引月牵吟幔，留云护药篱。\n平生但随运，何地不相宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36691,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"叠清字韵述怀一首","author":"孙承恩","text":"养拙谙生理，端居感世情。\n易从今日学，丹忆几时成。\n浅薄惭明主，声名藉友生。\n幽斋谁是伴，风月送双清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36692,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郭杏冈别业八首 其一","author":"孙承恩","text":"郭泰藏脩地，城东十亩庄。\n苍筠深夹径，绿薜漫缘墙。\n采药云侵屐，吟诗月近床。\n幽怀渺无际，清啸海天长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36693,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郭杏冈别业八首 其二","author":"孙承恩","text":"闻说东庄好，居然远世纷。\n短筇行引鹤，颓石坐看云。\n邻父时遗酒，山僧解乞文。\n秪缘幽意狎，鱼鸟亦欣欣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36694,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郭杏冈别业八首 其三","author":"孙承恩","text":"天上辞鸾掖，山中结草庐。\n乾坤容寄傲，江海渺愁予。\n静有思玄赋，贫无乞米书。\n素心厌尘俗，非敢谓怀居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36695,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郭杏冈别业八首 其四","author":"孙承恩","text":"选得宽闲地，幽居取次成。\n曲栏通窈窕，高栋自虚明。\n鹤舞持杯看，朋来倒屣迎。\n都将廊庙志，一任寄芳衡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36696,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郭杏冈别业八首 其五","author":"孙承恩","text":"野步来春寺，清吟对晚沙。\n启扉巢语燕，移酌坐临花。\n宰相陶弘景，仙人蔡少霞。\n极知盛幽事，真足向人誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36697,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郭杏冈别业八首 其六","author":"孙承恩","text":"未必能忘世，遗荣是此心。\n浮名虚岁月，幽与且云林。\n地僻车尘远，门閒草色深。\n陶翁有真意，吾亦厌鸣琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36698,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郭杏冈别业八首 其七","author":"孙承恩","text":"沃壤平林接，虚堂曲径通。\n薜萝淡幽翠，篱菊艳寒丛。\n散食留山鸟，收芸辟蠹虫。\n野情真自喜，无事入城中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36699,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郭杏冈别业八首 其八","author":"孙承恩","text":"未拟身全逸，聊将服返初。\n不忘勤葺搆，得有此林庐。\n留客閒垂钓，焚香静读书。\n风情有如此，何异辋川居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36700,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东郊别业用前韵 其一","author":"孙承恩","text":"何处容归隐，诛茅辟此庄。\n山青纷作供，云白缭为墙。\n野竹生当户，宵虫鸣近床。\n水边与林下，时自放歌长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36701,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东郊别业用前韵 其二","author":"孙承恩","text":"济世无长策，归休有敝庐。\n云山如媚客，花鸟亦忘予。\n冥悟安心法，閒抄种树书。\n即看幽隐兴，宁羡市朝居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36702,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东郊别业用前韵 其三","author":"孙承恩","text":"危石当窗叠，疏林傍水成。\n万竿脩竹色，一径野花明。\n土沃宜耕稼，村荒少送迎。\n坐来鸡犬静，长日掩门衡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36703,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东郊别业用前韵 其四","author":"孙承恩","text":"草阁临鸥渚，衡门接鹭沙。\n披星催刈穫，冒雨看移花。\n有感歌黄鹄，无才咏落霞。\n幽怀聊喜述，非欲向人誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36704,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东郊别业用前韵 其五","author":"孙承恩","text":"性僻违时好，居閒惬赏心。\n昼眠来雨阁，晓栉坐风林。\n密藻潜鱼稳，寒丛聚雀深。\n空花看世事，一慨雍门琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36705,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东郊别业用前韵 其六","author":"孙承恩","text":"掩户青春静，焚香斗室虚。\n地留高士宅，天锡野人居。\n自喜迂慵称，惭于礼法疏。\n行藏俱有命，莫问道非欤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36706,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东郊别业用前韵 其七","author":"孙承恩","text":"抗志浮荣外，游心邃古初。\n幸兹投散迹，政类爱吾庐。\n庾有新登粟，家藏旧赐书。\n陶然足俯仰，不欲赋贫居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36707,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东郊别业用前韵 其八","author":"孙承恩","text":"渔艇深依岸，炊烟远隔林。\n喜无俗客到，时有幽人寻。\n落日心犹壮，中年感易侵。\n考槃仰先哲，千古继高吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36708,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仲夏廿二日同吴石湖苏一斋杨麟山会王鹤城别业漫赋四首 其一","author":"孙承恩","text":"薄有丘园兴，同心喜见招。\n野航春水阔，茅屋午烟消。\n花静休蜂课，篱闲长药苗。\n傍邻如可卜，终老混渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36709,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仲夏廿二日同吴石湖苏一斋杨麟山会王鹤城别业漫赋四首 其二","author":"孙承恩","text":"我亦村庄近，新知王子居。\n良菑枕茅屋，蔓竹匝脩渠。\n野叟惊冠盖，閒心狎鸟鱼。\n追从恋朋好，日过欲无虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36710,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仲夏廿二日同吴石湖苏一斋杨麟山会王鹤城别业漫赋四首 其三","author":"孙承恩","text":"村径门深隐，溪塘水漫流。\n高原人放犊，古木客维舟。\n坐久褰衣步，诗成把酒讴。\n蹉跎竟何事，吾道付沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36711,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仲夏廿二日同吴石湖苏一斋杨麟山会王鹤城别业漫赋四首 其四","author":"孙承恩","text":"喜托斯文契，休辞酒浅深。\n晤言今日事，道谊一生心。\n野日留馀照，溪云阁暝阴。\n兴阑吾欲返，宿鸟渐归林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36712,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六月廿七日诸君子会予草堂次前韵四首 其一","author":"孙承恩","text":"重订茅堂约，无嗔折简招。\n追游匪公等，意气向谁消。\n村酿分邻瓮，山蔬荐菊苗。\n安期如可访，欲去海门樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36713,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六月廿七日诸君子会予草堂次前韵四首 其二","author":"孙承恩","text":"门驻高人辙，光生贱子居。\n开轩纳凉气，展席俯清渠。\n野老遗朱果，溪翁留白鱼。\n轻雷应送雨，百里殷空虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36714,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六月廿七日诸君子会予草堂次前韵四首 其三","author":"孙承恩","text":"岁月堂堂去，江河靡靡流。\n笑谈且樽酒，身世自虚舟。\n莫易催归思，须教倚棹讴。\n更容移小艇，同傍白蘋洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36715,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六月廿七日诸君子会予草堂次前韵四首 其四","author":"孙承恩","text":"座拂花香细，阶连草色深。\n狂歌吾巳醉，不饮公何心。\n烟水三江阔，风云万里阴。\n素怀邈何许，托迹在岩林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36716,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七月廿五日会苏子嘉会堂再次前韵四首 其一","author":"孙承恩","text":"名酒吾当恋，行云不可招。\n素心丹自炯，衰鬓雪难消。\n短袖随风叶，长镵刬芋苗。\n尽?书籍弃，买断北山樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36717,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七月廿五日会苏子嘉会堂再次前韵四首 其二","author":"孙承恩","text":"樽俎同清宴，江山赋索居。\n登楼欣眺望，濯热欲临渠。\n文火残香篆，芸香落蠹鱼。\n俗纷浑不到，羡尔志恬虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36718,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七月廿五日会苏子嘉会堂再次前韵四首 其三","author":"孙承恩","text":"逸兴孤云远，年光逝水流。\n陶翁三径菊，范老五湖舟。\n我酌公须饮，公诗我为讴。\n长生如有诀，同觅向玄洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36719,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七月廿五日会苏子嘉会堂再次前韵四首 其四","author":"孙承恩","text":"文饮吾情颇，清言丽泽深。\n风光行乐处，慷慨醉时心。\n花散霏霏雾，云开白白阴。\n谁云宦游好，不博此园林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36720,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会饮吴石湖精舍次前韵四首 其一","author":"孙承恩","text":"吴子幽栖地，闲来荷胜招。\n玉舟浮白堕，翠釜映红消。\n菜长雨馀荚，禾抽壅后苗。\n知君轻俗累，雅志在耕樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36721,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会饮吴石湖精舍次前韵四首 其二","author":"孙承恩","text":"水竹王维宅，烟花老杜居。\n寻芳穿曲径，浥赏憩清渠。\n草软飞蝴蝶，萍开跳白鱼。\n百年多暇景，幽兴莫教虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36722,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会饮吴石湖精舍次前韵四首 其三","author":"孙承恩","text":"对酒歌明月，濯缨怀碧流。\n不须移短榻，欲去棹扁舟。\n花当婵娟舞，鸟如弦管讴。\n晚风声断续，渔唱隔汀洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36723,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会饮吴石湖精舍次前韵四首 其四","author":"孙承恩","text":"物意人同适，韶华酒共深。\n云山如媚我，花鸟亦知心。\n石鼎青霞气，胡床碧树阴。\n晚蝉鸣未稳，曳响过前林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36724,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宋樗庵李鹤峰同一斋过访次前韵四首 其一","author":"孙承恩","text":"上客时难致，和风特为招。\n壶觞容我对，鄙吝向公消。\n野色迎新霁，天香发旧苗。\n共言岁事好，䆉稏渐堪樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36725,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宋樗庵李鹤峰同一斋过访次前韵四首 其二","author":"孙承恩","text":"有客高轩过，惭予木石居。\n寒蝉频到耳，秋水渐通渠。\n酿熟尊多酒，溪深馔有鱼。\n未须愁日暝，松月照庭虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36726,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宋樗庵李鹤峰同一斋过访次前韵四首 其三","author":"孙承恩","text":"贱子耽幽寂，诸公总胜流。\n西山堪拄笏，野渡见横舟。\n玉屑聆高论，巴俞愧俚讴。\n临风一舒笑，逸思满沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36727,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宋樗庵李鹤峰同一斋过访次前韵四首 其四","author":"孙承恩","text":"天际凉风急，庭前秋色深。\n触怀若有累，静玩夫何心。\n鱼跃频依藻，鹤鸣方在阴。\n白驹歌皎皎，我欲絷中林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36728,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会麟山别业再次前韵四首 其一","author":"孙承恩","text":"风月自堪适，壶觞复此招。\n野情转萧散，习气未全消。\n海上金光草，山中白雪苗。\n浮荣如可弃，吾与子同樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36729,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会麟山别业再次前韵四首 其二","author":"孙承恩","text":"地僻无尘事，高人称隐居。\n启扉云在户，决溜水通渠。\n瀚海闻抟翼，濠梁看跃鱼。\n百年知道寡，粗得究盈虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36730,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会麟山别业再次前韵四首 其三","author":"孙承恩","text":"小径花阴合，闲阶日影流。\n主言宜尽兴，仆语好回舟。\n岁月无公案，沧浪有棹讴。\n白鸥閒似我，随意立芳洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会麟山别业再次前韵四首 其四","author":"孙承恩","text":"物外乾坤别，樽前意兴深。\n云山欣属目，事业愧初心。\n野水淡秋思，庭槐生夕阴。\n商歌二三子，逸响振云林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"述怀","author":"孙承恩","text":"远道心为恻，隆冬天与晴。\n风轻官棹稳，野旷暮寒生。\n惜别怀知厚，匡时耻圣明。\n离群有孤雁，嘹呖不堪听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江夜","author":"孙承恩","text":"永夜风威盛，蓬窗烛影孤。\n鱼龙舞幽壑，星月堕澄湖。\n无补乾坤大，空悲年岁徂。\n病驹怀秣饲，心折向长途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"野望","author":"孙承恩","text":"朔地寒偏极，河源冻欲枯。\n遥天围迥野，落日滞长途。\n戍古昏雅集，村荒旅店孤。\n中年萧索意，览眺不能无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中对月四首 其一","author":"孙承恩","text":"明月清江上，临流思爽然。\n练摇无定影，璧碎不成圆。\n鸟雀翻枝警，鱼龙抱影眠。\n美人渺何处，孤笑落云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中对月四首 其二","author":"孙承恩","text":"良夜不思寐，蓬窗漫倚风。\n月光连浩渺，水气接空濛。\n大地将无尽，银河似可通。\n谪仙还许约，乘兴访龙宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中对月四首 其三","author":"孙承恩","text":"月映千山雪，波摇万道金。\n水风生澹爽，林木坐阴森。\n远塞征人泪，高楼独妇心。\n有怀多感慨，吾亦动悲吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中对月四首 其四","author":"孙承恩","text":"皓魄开无际，清辉满大千。\n白榆摇历历，玉露滴涓涓。\n羁旅添愁思，家园兴渺然。\n年年看月白，吟倚草堂前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月下舟行","author":"孙承恩","text":"灯晃蓬窗静，舟行夜色荒。\n无眠情黯黯，开户月苍苍。\n宿鸟栖枝稳，危堤隐雾长。\n忽闻人语近，不省是何乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南归会金陵李栗斋同行夜雨栗斋邀饮舟中 其一","author":"孙承恩","text":"黯黯篷窗雨，迢迢故国心。\n斯文喜荆识，樽酒共宵斟。\n濩落江湖迎，驰驱岁月深。\n因君谈往事，凄恻恨难禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南归会金陵李栗斋同行夜雨栗斋邀饮舟中 其二","author":"孙承恩","text":"淅沥听寒雨，篷窗半夜阑。\n孤城乱鸣柝，高浪急江滩。\n细数灯花坠，休辞酒盏乾。\n独怜身抱病，何以奉清欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南归会金陵李栗斋同行夜雨栗斋邀饮舟中 其三","author":"孙承恩","text":"夜阒江声迥，雨深风色寒。\n不禁归思切，翻念仆夫单。\n末路增长叹，间情渺大观。\n小山幽兴在，露满桂花团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同栗斋饮张仰山别驾舟中三首 其一","author":"孙承恩","text":"细酌清歌动，微风锦缆牵。\n居常惜萍梗，邂逅合留连。\n古道低残日，冥鸿度远天。\n无端故园兴，飞越酒樽前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同栗斋饮张仰山别驾舟中三首 其二","author":"孙承恩","text":"川迥兼天末，帆开背日斜。\n孤村依远戍，宿鹭聚寒沙。\n病体樽深怯，清谈兴更赊。\n即看冰雪晚，能不惜年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同栗斋饮张仰山别驾舟中三首 其三","author":"孙承恩","text":"城市多违阻，官程喜接联。\n平川移远棹，高柳俯长筵。\n旧识王祥贵，新承董相贤。\n幸陪今日话，已胜读经年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卫河舟中短述奉同行诸君子","author":"孙承恩","text":"野旷居人少，河流逐岸纡。\n苍烟迷古戍，落日聚啼乌。\n已是悲长道，还闻警不虞。\n相依有群彦，聊慰客心孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚泊","author":"孙承恩","text":"舣棹息风澜，樵炊暂倚滩。\n疏星垂野近，明月浸江寒。\n吠犬时闻警，栖乌卒未安。\n帝京与乡国，离思共漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕","author":"孙承恩","text":"岁尽惟今夜，炉薰只自围。\n年华随日去，事业与心违。\n斗北星河曙，天南乌鹊飞。\n披衣还出户，瞻望独依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日","author":"孙承恩","text":"把笔书元旦，弹冠肃令辰。\n帝城千户晓，皇统万年春。\n岁月淹黄卷，云霄怅紫宸。\n悠悠空窃食，无补愧前人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朝天宫习仪和甘司空几山韵三首 其一","author":"孙承恩","text":"大礼展仙宫，瞻天咫尺东。\n衣冠明旭日，环佩散微风。\n覆载功难报，黄虞道正隆。\n祗应勤颂祷，想见万方同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朝天宫习仪和甘司空几山韵三首 其二","author":"孙承恩","text":"阁道云移采，炉薰篆袅烟。\n乾坤资帝极，虚薄忝官联。\n云闪开黄幄，霆惊肃晓鞭。\n自多垂老日，身际太平年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朝天宫习仪和甘司空几山韵三首 其三","author":"孙承恩","text":"琳宇千官集，新春万象苏。\n尧廷闻华祝，汉室陋嵩呼。\n电绕开昌运，龙飞恊瑞图。\n圣明求治切，虚臆伫嘉谟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留都玉署无梅怅然有怀小园","author":"孙承恩","text":"古署空梅朵，幽怀若为消。\n几株东海上，千里梦魂遥。\n生意馀硕果，贞柯靡柔条。\n春风岁岁好，底用怅今朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东园宴集","author":"孙承恩","text":"胜日张高宴，名园集巨公。\n笑谈霏玉屑，歌舞动春风。\n花雾迷城堞，山云接梵宫。\n从来幽兴剧，欣赏意无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]