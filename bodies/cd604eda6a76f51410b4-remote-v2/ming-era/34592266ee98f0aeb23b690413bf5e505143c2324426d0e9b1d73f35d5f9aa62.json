[{"title":"出郭","author":"袁宏道","text":"稻熟村村酒，鱼肥处处家。\n轻刀粘水去，独鸟会风斜。\n落日流红浪，长江徙白沙。\n山僧迎客喜，颠倒著袈裟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江上","author":"袁宏道","text":"白雾迷荒楚，青流带远空。\n沙平晴献雪，树老夜屯风。\n旷野眠饥兕，孤洲落晚鸿。\n布帆如屋里，何处有城中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郊外小集 其一","author":"袁宏道","text":"赖有沧洲意，聊行浊酒杯。\n白波吹日上，粉堞映江开。\n米谷舟中市，人烟水面来。\n息机吾已久，鸥鸟莫相猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郊外小集 其二","author":"袁宏道","text":"浪迹真无赖，狂心今若何。\n一尊聊对酒，万事且狂歌。\n稚子矜黄叶，渔人语白波。\n芦花青袅袅，秋意满溪蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三弟回志喜 其一","author":"袁宏道","text":"送汝才三月，那知西复东。\n客中何地返，橐里几时空。\n世事穷来见，文章病后工。\n浮湘而涉海，司马之遗风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三弟回志喜 其二","author":"袁宏道","text":"突兀英雄气，飘零病苦身。\n黄金憎赋客，青眼谢时人。\n按剑投珠恨，呼牛应马真。\n无钱觅知己，到底白头新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三弟回志喜 其三","author":"袁宏道","text":"万里将孤舫，长江与太湖。\n山川几尽越，文字耻为吴。\n见我故人否，识君高义无。\n士安交不薄，珍重序三都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三弟回志喜 其四","author":"袁宏道","text":"东去人人叩，西来事事疑。\n苦心真学者，出世好男儿。\n消息蕲州得，机缘老宿知。\n何人皮相士，道尔定狂痴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花朝日呈伯修 其一","author":"袁宏道","text":"垆气薰高阁，歌声绕细厨。\n桂尊清且满，坐客美而都。\n共唱三妇艳，同开百子图。\n主人将夜饮，傍晚禁啼乌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花朝日呈伯修 其二","author":"袁宏道","text":"宛转花如结，差池燕似知。\n佳人炊寿饼，童子按新辞。\n珠履散还聚，兰膏尽复吹。\n青轩红丽蕊，第一好天时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44887,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"京师夜坐","author":"袁宏道","text":"兀坐酲酲闷，读书字字难。\n竹枯知凤馁，瓶涩验天寒。\n事往心方省，穷来交渐宽。\n微官犹窘我，赢马日长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44888,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北行道中示弟","author":"袁宏道","text":"惜别无多日，驱驰看逼年。\n客愁繁似雨，官路远如天。\n冻碛酸车毂，严霜齧马鞭。\n流光付行旅，尔我递相怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44889,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽苏母","author":"袁宏道","text":"喜得全归日，郎君巳致身。\n凭将万死事，泣报九原人。\n野气迷丹旐，秋风冷石麟。\n但留天语在，一纸夜台新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44890,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜感怀","author":"袁宏道","text":"莫以千人和，遂轻白雪歌。\n支离常调失，突兀此生过。\n薄俗论交尽，秋风阅世多。\n鹓雏终万仞，嚇我待如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"余山居六年矣丙午秋复北上临发偶赋","author":"袁宏道","text":"又被閒驱出，冥鸿那可飞。\n添多新蒜发，典尽旧荷衣。\n柳密云侵郭，荷长水浸矶。\n鸥凫争作语，客子几年归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过荆门观蒙惠泉","author":"袁宏道","text":"云过山城没，溪回磴道平。\n一沤淙石底，万户枕泉声。\n童子将茶去，僧雏负钵行。\n居人传好语，得似长官清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石桥道中","author":"袁宏道","text":"上上仄岩颠，清溪落马前。\n陂陀聊作馆，硗确以为田。\n人出斜山照，鸡鸣废寺烟。\n亭翁颜半赭，知得有丰年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"襄阳道中逢龙君御君御节镇西宁便道省太夫人","author":"袁宏道","text":"征马隔林鸣，双旌忽背行。\n白头橑远梦，红树促归程。\n银管书生去，铁衣老将迎。\n羌胡知姓字，檄草在边城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壬辰秋日余与伯修兄俱得请先后出都门至郑相及同宿州署今相去十五年伯脩厌世亦六年矣电火惊心山川触目因书数语兼示小脩方平两弟","author":"袁宏道","text":"十五度春秋，沤花转眼休。\n含悲上东里，无路避西州。\n孤月伤鸿阵，寒云障马头。\n对床今夜雨，清泪几行流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邺城道 其一","author":"袁宏道","text":"何处魏离宫，荒烟断苇中。\n猎蹄晴捲雪，高隼怒盘风。\n苑古梧桐秃，墙崩枸杞红。\n空台与流水，想像旧帘栊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邺城道 其二","author":"袁宏道","text":"白日悲难驻，英雄谁不然。\n鱼膏焚地底，蛾黛哭生前。\n南国香成雾，西山石化烟。\n人间绝快事，天子作神仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邺城道 其三","author":"袁宏道","text":"碧草涨寒塘，菖蒲花下香。\n山禽犹翠羽，野果尚丹房。\n残粉迎新帝，妖魂逐小郎。\n曹家兄弟好，无那太淫荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邺城道 其四","author":"袁宏道","text":"且著双眉目，休随俗笑嚬。\n帘前挝鼓吏，床上捉刀人。\n胡粉装尤怪，蔗竿舞入神。\n精光如可画，宁与魄俱尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邺城道 其五","author":"袁宏道","text":"那得长无语，无情泪亦垂。\n碑馀汉岁月，水洗邺城池。\n楼外羌雏啸，宫中寡妇悲。\n好还不再世，凶狡亦何为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邺城道 其六","author":"袁宏道","text":"近得铜台瓦，重来五十锾。\n无方鬒白发，空自治青山。\n上马蒐才藻，横戈按髻鬟。\n霸图今已矣，文采照人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邺城道 其七","author":"袁宏道","text":"仆去前王碣，耕来故国坟。\n蜂巢无两大，兔窟有三分。\n夜火生空树，阴龙战野云。\n美人何处所，试与定遗文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邺城道 其八","author":"袁宏道","text":"且勿度前村，白杨路渐昏。\n一丘文字鬼，千古战争魂。\n历数孙曹闰，风流魏晋繁。\n成蹊人自省，桃李不须言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邺城道 其九","author":"袁宏道","text":"谋士虎兼龙，三家霸局同。\n文章分鼎足，才品第英雄。\n龌龊司徒后，昏顽锻锡公。\n陈琳檄自有，离可愈头风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邺城道 其十","author":"袁宏道","text":"校尽中原士，初逢国手棋。\n孙郎争一道，刘冑仅双持。\n石悍刀方利，风高海始奇。\n唐宗与宋祖，应悔不同时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游崇国寺得明字 其一","author":"袁宏道","text":"入寺稀人识，僧雏尽老成。\n花犹香废苑，石莫话前生。\n壁上苔栖墨，廊间雨坏楹。\n春衣能几日，又复过清明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游崇国寺得明字 其二","author":"袁宏道","text":"只作幽探计，如来与證明。\n出门皆黛色，入寺有泉声。\n酒似溪光嫩，身如云影轻。\n閒官无别侣，头白旧方情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"惠安伯圜亭同顾升伯李长卿汤嘉宾看牡丹 其一","author":"袁宏道","text":"古树暗房栊，登楼只辨红。\n分畦将匝地，合燄欲焚空。\n蝶醉轻绡日，莺捎煖絮风。\n主人营一世，身老众香中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"惠安伯圜亭同顾升伯李长卿汤嘉宾看牡丹 其二","author":"袁宏道","text":"通国皆狂死，谁家解满栏。\n径须一石醉，消得几生看。\n小榭迎初月，层岚作晚寒。\n携归才数朵，掩尽百罗纨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浴佛日刘元定邀诸公偕游高梁桥得为字 其一","author":"袁宏道","text":"节是祗园会，欢同曲水池。\n妖童歌串乱，天女鬟华随。\n是树皆停盖，无波不泛卮。\n鱼龙与角抵，乐事看君为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浴佛日刘元定邀诸公偕游高梁桥得为字 其二","author":"袁宏道","text":"万队千骑出，燕游第一时。\n繁华虽有态，烟水未曾知。\n西去层层岫，东来面面池。\n胸中好丘壑，借与主人为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜归来与长孺道旧仍用前韵","author":"袁宏道","text":"盛事那堪记，衰来亦自悲。\n看穷烟柳地，老尽露桃枝。\n算酒休论石，税花莫计池。\n平生心种种，难及壮时为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偕曾退如过净土盖","author":"袁宏道","text":"像设都非丽，疏题亦不红。\n花移牛槛日，槐老一庭风。\n寓目皆成淡，诸方敢斗空。\n到门有醉客，乡里旧山公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汤嘉宾以使事入江西将遍游诸名胜诗以送之 其一","author":"袁宏道","text":"碧渚苍云路，长帆几叶还。\n趁秋行九子，携谱看庐山。\n采药灵溪见，映花石户关。\n孤藤双竹屦，听尽水潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汤嘉宾以使事入江西将遍游诸名胜诗以送之 其二","author":"袁宏道","text":"亦解惊人语，干君数倍难。\n片鳞犹变化，尺水尚波澜。\n万卉经春烂，千山过月寒。\n欲知才大小，试取昔贤看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汤嘉宾以使事入江西将遍游诸名胜诗以送之 其三","author":"袁宏道","text":"九派浔阳地，寒潮一叶通。\n少年姑狡狯，太舌石玲珑。\n触路飞泉雨，扪碑怪穴风。\n到时秋正老，江景绘丹枫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汤嘉宾以使事入江西将遍游诸名胜诗以送之 其四","author":"袁宏道","text":"携去山盈袖，书来墨满岩。\n岚光疲瘦仆，泉水洗尘衫。\n识遍金仙侣，搜残玉简函。\n楚云青咫尺，汉水莫停帆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早起入朝书册午间冲暑走城外别汤嘉宾晚赴刘元定饮时诸公已半酣赋得原字","author":"袁宏道","text":"晓出铜龙署，暮归曲水村。\n座凉心乍贴，觥乱饮初喧。\n妥尾筠侵阁，长头客在门。\n公然去巾屣，奴态亦堪原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日城西园亭闻蝉得阴字 其一","author":"袁宏道","text":"清响彻平林，云深树亦深。\n乍闻心爽豁，蠲尽午昏沉。\n琴里高山韵，诗中瘦岛吟。\n乡园频梦尔，中里柳湖阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日城西园亭闻蝉得阴字 其二","author":"袁宏道","text":"未曾离溽暑，亦不到云林。\n坐觉暄凉变，遂令院舍深。\n声来如远壑，宿处必层阴。\n燕子与黄鸟，难除闺阁音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日城西园亭闻蝉得阴字 其三","author":"袁宏道","text":"虽在高云地，长怀冷石心。\n羽流分体魄，骚客与声音。\n竹柏风相乱，笙歌耳可箴。\n如何君与我，俱不守长林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦雨吟和曾退如 其一","author":"袁宏道","text":"陵雨无朝夕，呻吟益病妻。\n床头新墁落，灶下老㜎啼。\n一室坳堂芥，千家乱水畦。\n侍儿持茗语，满褶裤花泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦雨吟和曾退如 其二","author":"袁宏道","text":"旧势将排砌，新痕又没花。\n街头眠野鹜，窗上语池蛙。\n古佛龛生菌，娇儿面有沙。\n东斋无额字，便可唤浮槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦雨吟和曾退如 其三","author":"袁宏道","text":"似道雷焚火，又闻水决墙。\n哭声来远巷，昏火照方床。\n小屋苇帘破，邻家苍术香。\n儿童浪惊喜，檐底有微光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦雨吟和曾退如 其四","author":"袁宏道","text":"莫是天家乐，轻闻下土哀。\n九州吹立水，万部役雕雷。\n地远声难彻，阍高唤不回。\n巢居与穴处，曾见有唐来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋泊潞河看月同子公云影赋 其一","author":"袁宏道","text":"秋树泠泠白，添衣也觉寒。\n如何今夜月，不共昔人看。\n客路风停阁，民居水破残。\n那堪更值此，衰草漫流滩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋泊潞河看月同子公云影赋 其二","author":"袁宏道","text":"万水千山路，羁魂来不来。\n双签题姓字，两处送钱财。\n风叶牵钩幔，寒花背镜台。\n思量具杯酒，有口向谁开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋泊潞河看月同子公云影赋 其三","author":"袁宏道","text":"亦欲消孤闷，其如不去心。\n稚儿神惨淡，病客语呻吟。\n野戌风传柝，空艚火隔林。\n更怜明月里，尚有独飞禽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋泊潞河看月同子公云影赋 其四","author":"袁宏道","text":"道侣前宽解，君深天竺书。\n我心自检点，试比毗邪庐。\n法喜妻辞世，散花天异居。\n任他金粟老，亦有泪涟如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潞河舟中和小修别诗 其一","author":"袁宏道","text":"鹤老翻辞侣，松寒乍剪萝。\n孤舟将幼累，北海望南讹。\n乱苇藏村社，枯槎卧古河。\n所嗟人异路，不畏客程多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潞河舟中和小修别诗 其二","author":"袁宏道","text":"昔日饥寒伴，凄凉无一存。\n去花难返榭，好月不留轩。\n龟手衣犹在，齐眉案尚温。\n一门新旧鬼，强半北方魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潞河舟中和小修别诗 其三","author":"袁宏道","text":"一恸出云堂，秋高雁影凉。\n容颜渐朽谢，恩爱日销亡。\n竹老湘君庙，花深油水阳。\n解君旧箧笥，拟买白莲庄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潞河舟中和小修别诗 其四","author":"袁宏道","text":"欲觅藏身处，瞿童路上寻。\n鱼宁愁不阔，鸟岂畏山深。\n秋叶虹霜寺，春苞紫笋林。\n辟如纵鹦鹉，未有恋笼心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潞河舟中和小修别诗 其五","author":"袁宏道","text":"少谢人间事，歌坛与舞筵。\n有山皆种竹，无水不栽莲。\n见死知生苦，月鳏识道缘。\n一杯从惠远，白社问诸贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潞河舟中和小修别诗 其六","author":"袁宏道","text":"江柳江枫道，秋来倍损神。\n琼花撩怨客，香草梦离人。\n白鸟谁非故，青山不厌贫。\n陶朱吾可学，整水养鲲鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潞河舟中和小修别诗 其七","author":"袁宏道","text":"客路虽云苦，烟波亦自清。\n云开九子近，月上五湖明。\n石壁同僧看，花坊信马行。\n家缘无十口，少累省忧生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潞河舟中和小修别诗 其八","author":"袁宏道","text":"弟也檀州去，征南尚可依。\n青油寒夜醉，画戟晓风威。\n塞草鞲鹰疾，胡天字鸟飞。\n吾庐行信美，乡社几时归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潞河舟中和小修别诗 其九","author":"袁宏道","text":"小艇烟江雨，长堤杮叶霜。\n一洲鱼子市，千树木奴乡。\n客去寻空谷，书来话酉阳。\n繁华销枕上，家近吕仙堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潞河舟中和小修别诗 其十","author":"袁宏道","text":"禅味争如醉，无何即是乡。\n休心为曲蘖，省事作资粮。\n慢世稍同朔，绝交亦似康。\n东?犹滞酒，余乃醒而狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沧洲逢瞿太虚运使问及近事偶题 其一","author":"袁宏道","text":"问我京华事，动君一日愁。\n添多新世态，无复旧交游。\n北寺凉阴尽，西堂讲席收。\n烟光逐日改，那不念归休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沧洲逢瞿太虚运使问及近事偶题 其二","author":"袁宏道","text":"白帢生蕉屦，知君亦悼亡。\n忧时心耿耿，学道鬓苍苍。\n老衲同三昧，稚儿守一床。\n所惭不共隐，魂魄滞他方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"德州舟中逢沈何山 其一","author":"袁宏道","text":"鬓上微添雪，衣间亦有尘。\n俱为行役客，孰是自由身。\n处世真妨达，归山无那贫。\n且收鱼鸟韵，检点作时人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"德州舟中逢沈何山 其二","author":"袁宏道","text":"敢谓冯唐老，为郎十五年。\n不因君濡滞，那与我周旋。\n历历分行树，匆匆两去船。\n此心无近远，月在浩池边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶作","author":"袁宏道","text":"为道知难进，求閒亦未成。\n凭将无益事，娱此有涯生。\n见水移觥去，闻山皆襆行。\n感时多长语，虚窍偶然鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]