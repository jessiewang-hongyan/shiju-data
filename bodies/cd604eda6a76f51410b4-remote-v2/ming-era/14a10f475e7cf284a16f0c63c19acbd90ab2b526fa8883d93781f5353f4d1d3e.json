,"commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10764,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"绿扇","author":"罗伦","text":"碧云从天来，清风落君手。\n老龙睡初醒，恍惚无何有。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10765,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题饶雯峰雁","author":"罗伦","text":"时序炎凉异，南来又北归。\n乾坤三百里，惟尔识天机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10766,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陈舜明泰斋","author":"罗伦","text":"秋候天如水，风清月正明。\n浮云断一点，长望泰阶平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10767,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题松与溧水袁济","author":"罗伦","text":"人心是浮云，一日几变易。\n吾友山下松，此心已如石。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10768,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梦","author":"罗伦","text":"日晏歌黄鹄，时清茹紫芝。\n君心天下独，天意独君知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10769,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"初四日梦","author":"罗伦","text":"东井回天地，西奎应古今。\n已无生与死，况复说浮沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10770,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e3