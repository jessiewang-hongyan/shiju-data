enance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18736,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自葛阳驰广济驿轺中即事 其五","author":"张萱","text":"门前新柳似人长，飐飐青帘驿路傍。\n竹屋垆头炤木客，泼醅春酒正堪尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18737,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自葛阳驰广济驿轺中即事 其六","author":"张萱","text":"临溪白板两三家，暖日松篁覆浅沙。\n汲妇入林佯避客，桃花斜插鬓如鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18738,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自葛阳驰广济驿轺中即事 其七","author":"张萱","text":"柴门傍水是通津，夜理渔蓑昼卖薪。\n晚市醉归逢鼓吹，笑携稚子看官人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18739,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自葛阳驰广济驿轺中即事 其八","author":"张萱","text":"新成茅屋憩轮蹄，种得山桑叶未齐。\n搔背负暄樊圃侧，白头老子牧黄鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18740,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自葛阳驰广济驿轺中即事 其九","author":"张萱","text":"生计年来喜渐多，旋栽乌桕旋婆娑。\n担头新蜡浑如雪，卖与朱门照绮罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18741,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自葛阳驰广济驿轺中即事 其十","author":"张萱","text":"落日危桥客过稀，梳翎水鸟立渔矶。\n何来笳鼓諠腾甚，惊起双双背客飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18742,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自广济至濲水舟中即事 其一","author":"张萱","text":"广济驿前春水生，鸣笳击鼓声喤喤。\n南风日勍布帆饱，水急滩多莫浪行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18743,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自广济至濲水舟中即事 其二","author":"张萱","text":"驱车长苦雨淋铃，独漉歌残不忍听。\n却喜开帆风日好，一川晴色柳青青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18744,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自广济至濲水舟中即事 其三","author":"张萱","text":"斜阳渡口石塘街，估客安流放木箄。\n买得春醪醉明月，斧声不断夜箍柴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18745,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自广济至濲水舟中即事 其四","author":"张萱","text":"衢州城子枕江干，粉堞参差照水寒。\n绿鬓彤幨乘五马，逢人尽说是清官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18746,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自广济至濲水舟中即事 其五","author":"张萱","text":"高低影水竹遮楼，楼外垂杨系客舟。\n两岸长青千树橘，家家应作富民侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18747,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自广济至濲水舟中即事 其六","author":"张萱","text":"西安东去是龙游，春涨江平却肯流。\n春月一船浑似昼，竹枝高唱橹声柔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18748,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自广济至濲水舟中即事 其七","author":"张萱","text":"帆前春水泻琉璃，桂若香浮日暖时。\n为语鱼儿莫吹浪，前滩今已放鸬鹚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18749,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自广济至濲水舟中即事 其八","author":"张萱","text":"横山山下水汤汤，驻楫乘春问国香。\n春服将成须杂佩，年来幽谷几枝芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18750,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自广济至濲水舟中即事 其九","author":"张萱","text":"捩柁从流风正便，船头叉手坐长年。\n推窗尽放青山入，无数芙蓉镜裹悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18751,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自广济至濲水舟中即事 其十","author":"张萱","text":"峭帆斜日挂危樯，叠鼓呼风亦太忙。\n却听舟人话潮信，欲乘新月汎钱唐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18752,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重过桐江钓台留题 其一","author":"张萱","text":"片帆又过富春山，新水平添旧日滩。\n再上双台舒一啸，不妨啼鸟报春残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18753,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重过桐江钓台留题 其二","author":"张萱","text":"莫将急鼓叠回风，且向中流看织荭。\n石上相逢休问姓，当年我亦一渔翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18754,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重过桐江钓台留题 其三","author":"张萱","text":"缁川亦是钓璜馀，错把安车拟副车。\n干象犹堪频入梦，君房空奏一函书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18755,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重过桐江钓台留题 其四","author":"张萱","text":"欲屈狂奴作汉臣，交情总是白头新。\n垂竿莫说前贤误，文叔于今非故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18756,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"方处士玄英祠留题 其一","author":"张萱","text":"芙蓉七里郁苍苍，百尺双台一瓣香。\n怪底先生诗句好，数椽原傍汉严光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18757,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"方处士玄英祠留题 其二","author":"张萱","text":"桐江东去是通津，共把奚囊贮陌尘。\n却叹长安车满载，总输千古属閒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18758,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谢义士皋羽祠留题 其一","author":"张萱","text":"高台白日哭忠魂，一剑长怀未报恩。\n请把严滩添旧泪，好随明月到崖门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18759,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谢义士皋羽祠留题 其二","author":"张萱","text":"青山独洒秦庭泪，绿水应怜博浪狙。\n为问桐江春到日，鹃声亦是五坡无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18760,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠月儿 其一","author":"张萱","text":"五柳园中花正飞，东方犹自惜芳菲。\n笑将一束缠头锦，却为它人作嫁衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18761,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠月儿 其二","author":"张萱","text":"歌馆初逢即目成，陟将心事许卿卿。\n自怜老去无金屋，笑杀伶玄浪得名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18762,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠月儿 其三","author":"张萱","text":"榕溪渡口木兰船，欲去还留更可怜。\n惜别正须郎一顾，试将误曲唱尊前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18763,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]