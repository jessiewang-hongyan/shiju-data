[{"title":"南归途中杂诗二十二首 其十三","author":"黄佐","text":"姑苏城外草萋萋，游冶王孙望欲迷。\n歌彻玉桃仙侣醉，枫桥明月夜乌啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2187,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南归途中杂诗二十二首 其十四","author":"黄佐","text":"半醉行歌宝带桥，桥边齐驻木兰桡。\n掀髯笑向?隆子，水色山光共泬寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2188,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南归途中杂诗二十二首 其十五","author":"黄佐","text":"净慈开宴西湖上，莲叶田田未有花。\n浩荡湖光千里月，参差烟树万人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2189,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南归途中杂诗二十二首 其十六","author":"黄佐","text":"严陵祠上白日光，严陵祠下沧波长。\n清风满山似相慰，去路飘飘花草香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2190,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南归途中杂诗二十二首 其十七","author":"黄佐","text":"怀玉山高云半空，佳人遥在碧云中。\n草萍回首三年梦，修竹满庭摇午风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2191,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南归途中杂诗二十二首 其十八","author":"黄佐","text":"舟子持篙弓样弯，天南天北百重滩。\n篮舆飞度沙溪上，野水浮天相对闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2192,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南归途中杂诗二十二首 其十九","author":"黄佐","text":"日出洪城紫雾开，风生江渚锦帆回。\n滕王绘蝶频相赠，犹带西山爽气来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2193,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南归途中杂诗二十二首 其二十","author":"黄佐","text":"薰风拂拂吹野花，石濑涓涓明早霞。\n天边未辨龙泉气，江上徒乘牛斗槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2194,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南归途中杂诗二十二首 其二十一","author":"黄佐","text":"敦叙堂前坐不辞，交南时雨有王师。\n清泠池阁无丝竹，还胜鸣皋送客时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2195,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南归途中杂诗二十二首 其二十二","author":"黄佐","text":"新年芳草恋春晖，梦里还家愿不违。\n岭上白云回首近，缁尘犹未染莱衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2196,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王学录之大理通判二首 其一","author":"黄佐","text":"除书春晚下贤关，去去潘舆喜奉攀。\n知尔公馀登玉局，碧天无际照苍山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2197,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王学录之大理通判二首 其二","author":"黄佐","text":"倅车晓发怆离情，济济青衾此送行。\n洱海自今沾化雨，谱将歌颂入芦笙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2198,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题钓舟梦中作","author":"黄佐","text":"罢钓归来抛却蓑，扣舷还唱竹枝歌。\n得鱼沽酒共君醉，一片江天明月多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2199,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日遣兴","author":"黄佐","text":"风雨初收花满城，青门乔木啭流莺。\n草坡瓜瓞无人见，谁谙偷閒学邵平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2200,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦后偶成","author":"黄佐","text":"西风三径雨潇潇，又见晴烟满柳条。\n高枕更无轩冕梦，梦中犹自咏渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2201,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春游","author":"黄佐","text":"红杏正当沽酒市，绿杨斜系钓鱼船。\n春融海宇惟风日，游遍江山自岁年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2202,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦中与人评严陵因赋","author":"黄佐","text":"谁把云台较钓台，帝星犹让客星回。\n桐江今夜芦花月，曾与羊裘照影来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2203,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"招提联句同林见素何燕泉赋","author":"黄佐","text":"散步逢招提，借榻共盘礴。\n祇园峙双树，玉署来孤鹤。\n藻镜湛清渊，贯城明碧落。\n三人坐未行，六籍文可博。\n孔壁开心传，汉庭重经学。\n活水浚源头，禅流嘲注脚。\n度世创虹桥，谈空抗鳌阁。\n鸣磬诵涅槃，传灯恣谈谑。\n扫除忘自身，解脱问谁缚。\n削发逃君亲，布金入囊橐。\n姚师遗影堂，靖难建荣国。\n往事如浮云，彼髡竟冥漠。\n携尊且尽欢，列俎纷参错。\n浩浩襟期同，亹亹指趣各。\n花朝药始齐，鸟弄歌仍作。\n兰烟袅篆猊，松露惊栖鹊。\n聊成石鼎联，匪赴旃檀约。\n老梦在沧洲，荩怀效葵藿。\n披衣起翱翔，振缨望寥廓。\n浅霞绮尚明，返照丹犹烁。\n尘劳倏已消，兴喻殊可托。\n初月出碧山，咏归得真乐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2204,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"草堂夜饯陈两江大尹集杜句","author":"黄佐","text":"琴瑟几杖柴门幽，独立缥缈之飞楼。\n青眼高歌望吾子，不减昔时陈太丘。\n夜如何其初促膝，岁云莫矣增离忧。\n百壶且试开怀抱，一躯交态何悠悠。\n漂零已是沧浪客，每语见许文章伯。\n人生交契无老少，酒酣耳热忘头白。\n济世宜引英俊人，大贤为政即多闻。\n邦人思之比父母，世上儿子徒纷纷。\n近闻下诏喧都邑，青春复随冠冕入。\n神倾意豁真佳士，会是排风有毛质。\n扬眉结义黄金台，客行岁晚尤相催。\n牙樯捩柂青楼远，鲸鱼跋浪沧溟开。\n君不见犬戎锁甲闻丹极，费心姑息是一役。\n三城守边却可图，独使至尊忧社稷。\n君不见蓬莱宫阙对南山，齐纨鲁缟车班班。\n高马达官厌酒肉，岂可久坐王侯间。\n吾为子起歌都护，白沙翠竹江村暮。\n杜鹃不来猿狖寒，潜龙无声老蛟怒。\n百年世事不胜悲，比屋豪华固难数。\n文章有神交有道，富贵何如草头露。\n衣冠是日朝天子，秦城楼阁烟花里。\n香飘合殿春风转，蛱蝶飞来黄鹂语。\n致君尧舜付公等，各使苍生有环堵。\n会送夔龙集凤池，万岁千秋奉明主。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2205,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"少城篇赠别三洲李子","author":"黄佐","text":"东望少城花满烟，忆君诵诗神凛然。\n君有长才不贫贱，李白斗酒诗百篇。\n朝回君是同客舍，垂鞭亸鞚淩紫陌。\n感君意气无所惜，南寻禹穴见李白。\n君今幸未成老翁，忆献三赋蓬莱宫。\n汉官威仪重昭洗，迥立阊阖生长风。\n况复得之名誉早，歌辞自作风格老。\n但觉高歌有鬼神，不知明月为谁好。\n我有新诗何处吟，鸣鸠乳燕青春深。\n窃攀屈宋宜方驾，颇学阴何苦用心。\n即事非今亦非古，反锁衡门守环堵。\n唯见群鸥日日来，留连戏蝶时时舞。\n柴门杂树向千株，种杏仙家近白榆。\n玄圃沧洲莽空阔，金支翠旗光有无。\n似闻昨者赤松子，揽环结佩相终始。\n江深竹静两三家，云白山青万馀里。\n黄金台贮俊贤多，几时回首一高歌。\n宴筵曾语苏季子，勋业终归马伏波。\n知君未爱春湖色，且将款曲终今夕。\n人生几何春已夏，此心炯炯君应识。\n似君须向古人求，宿昔一逢无此流。\n炯如一段清水出万壑，万壑东逝无停留。\n南有龙兮在山湫，听曲低昂如有求。\n时俗造次那得致，如今岂无腰袅与骅骝。\n君不见蛟之横，出清泚。\n青冥却垂翅，迢迢隔河水。\n君莫笑，骥之子，皮乾剥落杂泥滓。\n走过掣电倾城知，万岁持之护天子，英雄有时亦如此。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2206,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"迎春贻余子仲栗","author":"黄佐","text":"朝来新火起新烟，长笛短箫悲远天。\n细柳新蒲为谁绿，浊醪粗饭任吾年。\n已闻童子骑青竹，唤取佳人舞绣筵。\n此日此时人共得，晴窗点检白云篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2207,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灯夕草堂池中初泛小舟值春雨新霁","author":"黄佐","text":"宛在中流渤澥清，淡云疏雨过高城。\n春风自信牙樯动，新月犹悬双杵鸣。\n休怪儿童延俗客，不劳钟鼓报新晴。\n未填沟壑惟疏放，江汉风流万古情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2208,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"草堂喜诸生至","author":"黄佐","text":"男儿须读五车书，老马为驹总不虚。\n剑佩冲星聊暂拔，草茅无径欲教锄。\n病躯动觅藜床坐，懒性从来水竹居。\n高阁捲帘图画里，曳裾终日盛文儒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2209,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早秋送何御史","author":"黄佐","text":"日满楼前江雾黄，秋风此日洒衣裳。\n烟绵碧草萋萋长，雨浥红渠冉冉香。\n近侍只今难浪迹，贤声此去有辉光。\n寡妻群盗非今日，草奏何人入帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2210,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁晚寄怀程参戎","author":"黄佐","text":"忆昨欢娱同见招，独能无意向渔樵。\n揽环结佩相终始，人事音书漫寂寥。\n细马时鸣金腰袅，将军只数汉嫖姚。\n天涯春色催迟莫，只在忠良翊圣朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2211,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"至后诸郎中子兴过草堂寻梅登玄览台循城墙而归集杜句以纪其事","author":"黄佐","text":"茅斋寄在少城隈，冬至阳生春又来。\n万里相逢贪握手，百年多病独登台。\n短墙若在从残草，皂盖宁忘折野梅。\n正是江南好风景，蓬门今始为君开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2212,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日送同年刘鄜南归秦中集杜四绝 其一","author":"黄佐","text":"酒尽沙头双玉瓶，穷途阮籍几时醒。\n故园杨柳今摇落，怅望秋天虚翠屏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2213,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日送同年刘鄜南归秦中集杜四绝 其二","author":"黄佐","text":"青枫叶赤天雨霜，三叹聚散临重阳。\n篱边老却陶潜菊，托身白云还故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2214,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日送同年刘鄜南归秦中集杜四绝 其三","author":"黄佐","text":"但觉高歌有鬼神，回风飒飒吹沙尘。\n酒阑击剑蛟龙吼，羞见黄花无数新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2215,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日送同年刘鄜南归秦中集杜四绝 其四","author":"黄佐","text":"南国浮云水上多，几时回首一高歌。\n秦城楼阁烟花里，兴在骊驹白玉珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖晚别金徐邵三同年","author":"黄佐","text":"湖上林风相与清，山头落日半轮明。\n酒阑却忆十年事，银汉遥应接凤城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2217,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"草堂饯别诸生偶成三首 其一","author":"黄佐","text":"篱边野外多众芳，中有松柏参天长。\n落花游丝白日静，玉杯锦席高云凉。\n舟辑渺然自此去，人生会合不可常。\n卧龙跃马俱黄土，金谷铜驼非故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2218,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"草堂饯别诸生偶成三首 其二","author":"黄佐","text":"浊醪粗饭任吾年，自断此生休问天。\n衮职曾无一字补，将诗不必万人传。\n深山大泽龙蛇远，复道重楼锦绣悬。\n一卧沧江惊岁晚，断肠分手各风烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2219,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"草堂饯别诸生偶成三首 其三","author":"黄佐","text":"独宿江城蜡炬残，匣琴流水自须弹。\n浮云不负青春色，玉座应悲白露团。\n复有楼台衔暮景，也从江槛落风湍。\n看君谊着五乔履，直道无忧行路难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2220,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明自太霞洞过草堂","author":"黄佐","text":"阆风县圃与篷壶，物色分留与老夫。\n休怪儿童延俗客，敢论松菊久荒芜。\n虚沾焦举为寒食，细学何颙免兴孤。\n高阁卷帘图画里，远分山岳散江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2221,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宋行宫","author":"黄佐","text":"沙涌清夜月，曾照宋行宫。\n未抵黄龙府，空悲白雁风。\n丹心思蹈海，正气化成虹。\n若遂厓门愿，吾乡有大忠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2222,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寓言","author":"林大钦","text":"曾读巫女赋，更闻河上公。\n神仙自有友，不与世人同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2223,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其二","author":"吴允禄","text":"南山有乔木，采伐常丁丁。\n念此岁云暮，蹉跎竟无成。\n把镜昔黟然，忽已为星星。\n感叹不能已，晨曦照东荣。\n愿因归飞鸟，寄言勖友生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2224,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其三","author":"吴允禄","text":"踌蹰复踌蹰，感此秋节至。\n群芳犹未歇，寂寂已如是。\n岂薄邵平瓜，东门苦无地。\n安得乔松子，遗我金丹秘。\n举翮乘风游，飘然入无际。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2225,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其四","author":"吴允禄","text":"古道诚寥寥，相思一何深。\n相思夫奚为，将以慰吾心。\n白日没西岭，须臾出东林。\n朱颜不复回，变幻徒相寻。\n缅彼意中人，一别竟沉吟。\n岂无安期子，聊尔奏徽音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2226,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其五","author":"吴允禄","text":"银河耿夜光，竟夕临西牖。\n秋蝇虽复多，蹙蹙讵能久。\n不见绵蛮鸟，忽已辞衰柳。\n凉飕一已至，宿瘴复何有。\n殷勤命僮仆，策杖出林薮。\n致语头上巾，东篱迫重九。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2227,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏轩辕台","author":"吴允禄","text":"洞庭之水浮天地，中有君山若螺髻。\n山上谁崇百尺台，黄云紫雾常徘徊。\n相传昔日轩辕子，铸鼎烧丹此遗址。\n丹成白日升苍穹，黎民独抱乌号弓。\n千年事往今何在，吊古临风增感慨。\n呜呼真伪谁得知，日暮平芜鸟乱飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2228,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江行","author":"吴允禄","text":"宿雨晨初霁，春云午未收。\n浦烟笼过鸟，沙涨起眠鸥。\n隐隐鱼舠远，依依岛树幽。\n行人正前棹，江水自东流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2229,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"衡山道中","author":"吴允禄","text":"渐入衡阳境，溪山画不如。\n长桥危度马，仄径怕妨舆。\n岸转清流合，秋回古木疏。\n行行时问俗，花鸟傍輶车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2230,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"幽居遣怀用王象川韵","author":"吴允禄","text":"藏身何必武陵溪，心远人间路自迷。\n容膝不妨茅屋小，爱云聊放竹垣低。\n书成药谱还亲校，钓罢鱼筐祇自提。\n一醉杜门閒蜡屐，任教风雨溅春泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2231,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与区白斋梁毅所江虚谷何古林游东山寺次联句韵","author":"吴允禄","text":"西郭潮生晓放舟，江风萧飒满帘秋。\n岸傍短竹青如染，云外奇峰翠欲流。\n赏兴正逢新月上，吟踪应为野花留。\n乾坤已付游人乐，莫把閒盟负白鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2232,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"右溪新楼落成次青萝韵 其一","author":"吴允禄","text":"方池曲径隔花迷，百尺楼高缓步跻。\n吟罢倚栏闻越鸟，梦回欹枕忆朝鸡。\n朱弦漫许幽人弄，粉壁还邀过客题。\n欲向罗浮开望眼，海天辽阔暮云低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2233,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"右溪新楼落成次青萝韵 其二","author":"吴允禄","text":"三城秋色远浮空，坐倚层轩望不穷。\n山静颇疑尘世隔，磴危真讶广寒通。\n朱帘绿映千门柳，碧簟凉生四面风。\n珍重主人閒未得，佩声行谒未央宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕","author":"吴允禄","text":"高楼今夜月，女伴斗穿针。\n却笑为官拙，偏无乞巧心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"驻东湖驿用壁间六言韵","author":"吴允禄","text":"日出疏林露滴，风生远浦烟消。\n渔父移舟款款，征人策马萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湘妃庙","author":"吴允禄","text":"帝子别兮椒房，从六龙兮炎荒。\n望苍梧兮隔潇湘，君不见兮空断肠。\n秋风起兮洞庭波，蛟螭出没兮猿狖多。\n兰佩芳兮日夕，君不返兮奈何。\n血泪兮潺潺，滴幽篁兮成斑。\n愿从君兮溟漠，魂徘徊兮江干。\n往古兮来今，山高兮水深。\n俨仪容兮后饬，崇庙祀兮孤岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九泽鹤鸣","author":"吴允禄","text":"老鹤何年下，昂藏九泽鸣。\n影同孤竹瘦，声彻五云清。\n静养丹砂顶，閒梳白雪翎。\n乘轩宁似汝，宿食了无惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2238,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"樾泉园亭会饮","author":"吴允禄","text":"习池堪共醉，更值早凉秋。\n地迥红尘隔，杯深绿蚁浮。\n柳垂杨子宅，花拥鉴湖舟。\n此会知难数，酣歌尽日留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2239,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨后海珠登眺 其一","author":"李义壮","text":"梦回残月转长廊，何处僧归半夜航。\n水色不随山色改，风声偏助雨声狂。\n依依鹈鸊栖林樾，个个芙蓉隔石塘。\n幽兴杳然从此远，不堪渔笛起沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2240,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨后海珠登眺 其二","author":"李义壮","text":"半亩高亭百尺强，坐来天地自生凉。\n朝临爽气南山近，夜浣银河北斗长。\n立马来牛原并逐，浊泾清渭不同行。\n十年窗下羲皇梦，肯放轻尘到石塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2241,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游小金山","author":"李义壮","text":"一灯明灭江心寺，梦里孤蓬半夜雷。\n岁月共怜人易老，江山应笑我重来。\n平芜湿月流萤度，极浦随潮旅雁回。\n起对沧洲意无限，登临休上妙高台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2242,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别伦侍御右溪王刑部青萝","author":"李义壮","text":"昔与二三子，谒帝承明庐。\n拊翼欣同条，翻飞悲异途。\n苟无凌霄翮，徘徊守故株。\n春阳茁潜耀，百卉芬以敷。\n发轸越山侧，扬鞭燕路隅。\n伫立怅飞盖，沉欢意何如。\n离索古所叹，志士慎驰驱。\n丹云荫纤服，朱华迎轻车。\n愧无杂佩赠，揽结空踟蹰。\n慎言明令德，庶以永终誉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2243,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洞庭望岳阳楼","author":"李义壮","text":"久客思归日，江湖得暂留。\n君山一叶下，知是洞庭秋。\n日月双吟鬓，风波一钓舟。\n平生忧乐志，不系岳阳楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2244,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒陵道中","author":"李义壮","text":"西北半明灭，悲风催夕阴。\n紫云团隧道，红叶入霜林。\n天地河山老，松楸雨露深。\n遣弓攀莫及，回首罢登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2245,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望西苑","author":"李义壮","text":"水晶帘外百花桥，太液波寒欲上潮。\n篽苑春回丹壑近，禁城云老翠华遥。\n琼楼珠阁天俱远，银杏金桃露未消。\n归去蓬瀛三万里，月明犹听紫鸾箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2246,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早朝","author":"李义壮","text":"天上鸣鸡迥不闻，城头残月夜初分。\n楼台爽气通三岛，环佩秋声杂五云。\n阁道鸾灯供御辇，周庐龙钺护亲军。\n小臣章疏何由达，空望炉烟拱圣君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2247,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望茅山","author":"李义壮","text":"绛石蒸暮霞，练江拂晴昊。\n长风吹兰苕，波涛在芳草。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2248,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]