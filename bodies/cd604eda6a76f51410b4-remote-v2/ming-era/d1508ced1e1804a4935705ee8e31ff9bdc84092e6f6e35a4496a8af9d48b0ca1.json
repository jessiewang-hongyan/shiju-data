[{"title":"读邻笛遗悲卷","author":"林庭桂","text":"死别俄经二十秋，忽看遗墨泪如流。\n风帘寂莫灯前雨，谁复能禁此夜愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35659,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别张朝升太学","author":"陈崇德","text":"朝发金陵道，暮泛龙江潮。\n驰心在桑梓，宁辞归路遥。\n送客星初散，离人酒半消。\n秋风起天末，秋月明通宵。\n俯仰吟怀壮，逸兴何飘飘。\n念子青云器，高谈见风标。\n况历贤关久，薰陶非一朝。\n兹行趋觐省，拜庆乐陶陶。\n明当奋鹏翼，九万看扶摇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35660,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题山水图 其一","author":"陈崇德","text":"山外山，水外水。\n微茫夕照中，黯淡白云里。\n幽花野草山中春，葛巾野服山中人。\n彷佛桃源武夷境，笔端造化妙夺神。\n羡君自是隐逸者，门外不闻喧车马。\n心目长存山水间，无声之诗有声画。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35661,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题山水图 其二","author":"陈崇德","text":"云渺渺，水溟溟。\n高树低树连阴密，远山近山无数青。\n中有高人抱幽独，坐卧烟霞隔尘俗。\n瑶琴一曲来宫商，俯仰乾坤心自足。\n嗟余游宦住江东，此身未脱樊笼中。\n披图蓦尔怀乡国，家在云山第几重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35662,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏菊","author":"陈崇德","text":"商飙净群芳，秋光满径黄。\n清香留晚节，佳色壮重阳。\n叶外稀蝉语，篱边谢蝶忙。\n陶公虽任懒，三径未曾荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35663,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春园晓起","author":"陈崇德","text":"春光无限意，晓日压栏红。\n诗兴随吟笔，幽怀入钓筒。\n人游交翠里，鸟语密阴中。\n金谷真堪赏，朝朝与客同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35664,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同沈宪长饮观音阁","author":"陈崇德","text":"坐客总非凡，狂吟醉石岩。\n诸峰连座榻，极浦送归帆。\n地迥凌高阁，春寒透旧衫。\n仆夫催上马，钟响隔林杉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35665,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同静夫游石磐岸","author":"陈崇德","text":"同游看策杖，云净露山腰。\n绿树分阴入，幽禽向晚招。\n菊斟陶令酒，风淅许由瓢。\n非是烂柯者，行行听采樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35666,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梨云轩","author":"陈崇德","text":"不随桃李结芳邻，院落梨花伴此身。\n带雨飘零千片雪，堆云暗护一枝春。\n梦回窗外红尘远，忘却人间白发新。\n几度黄昏禅定后，相看清况更宜人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35667,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题春山卷","author":"陈崇德","text":"高人僻爱春山好，一段幽怀尽向开。\n清气都收诗卷里，风光总付酒杯来。\n繁花乱吐红交白，啼鸟惊飞去复回。\n却笑纷纷名利客，白头犹自走尘埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35668,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日游桂山","author":"陈崇德","text":"上尽层波山上山，兴来气力健无悭。\n衣冠艳拂黄花畔，仆御声传碧嶂间。\n不学孟嘉当日醉，却怀陶令此身閒。\n何时办了公家事，随处青山策杖攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35669,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湘南别意送詹廷信入贺","author":"陈崇德","text":"花满江亭酒满觞，十分春色送行装。\n看山马首吟行壮，别路天涯客思长。\n万国衣冠同际会，三湘文物仰辉光。\n祝呼圣寿瑶觞后，更取边情入奏章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35670,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寓阳朔","author":"陈崇德","text":"四野山多少有墟，山形露骨洞岩虚。\n眼前疮疾谁能疗，纸上文移我厌书。\n功利乘时奚可久，治安长策竟何如。\n列城愿得朝歌长，盘错何愁不尽除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35671,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寓灌阳","author":"陈崇德","text":"六年踪迹未曾停，冒走风尘每见星。\n按节敢辞滩路恶，看山直入灌阳青。\n竹篱茅舍千门月，石径溪桥几处亭。\n但得客身长是健，瘴乡虽久不妨经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35672,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠陈秉衡宪副归田","author":"陈崇德","text":"金印何如二顷田，秋风万里一归船。\n休将前路征夫问，笑拂青松野鹤翩。\n玩水观山真有味，吟风弄月欲忘眠。\n功名到底成何用，乐得閒身未老年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35673,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日登宾州南楼","author":"陈崇德","text":"烟树苍茫眼界赊，楼头踏遍日西斜。\n云开远景看林木，风带微香度野花。\n山不断青连碧汉，水微拖绿护田家。\n近来喜得边尘净，仰仗兵威镇泰华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35674,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游灵峰寺","author":"陈崇德","text":"满眼峰峦总是诗，挥毫难尽个中奇。\n鸣琴声彻归云洞，曲水流同品字池。\n啼鸟忽闻无觅处，好山贪看立多时。\n兴游忘却归途晚，望海亭前月上迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35675,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"归休次静夫韵","author":"陈崇德","text":"飘然逸兴浩无涯，乞得閒身莫浪誇。\n堪笑老来偏爱酒，每占春到着飞葭。\n青山识面常当户，明月知心自到家。\n静里东风看若许，每逢花落惜年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35676,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"菊花十月始开","author":"陈崇德","text":"今岁黄花开较迟，入冬才见绽东篱。\n一秋空负有佳色，九月无由望白衣。\n橘绿橙黄添好景，桃娇柳媚任先时。\n须知晚节坚如许，似接寒梅雪里姿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35677,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"有感","author":"陈崇德","text":"人生不定似飘蓬，老至安能少壮同。\n短发更无千日黑，酡颜刚借一时红。\n添年换岁聊为乐，粝食粗衣未底穷。\n敢告东邻与西舍，将余错认旧乘骢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35678,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"朗司务上京过别饯于风山洞","author":"陈崇德","text":"偶得公馀半日閒，追寻佳境恣跻攀。\n行听好鸟出孤嶂，看尽閒云到远山。\n翠色岩边千树合，夕阳林下一僧还。\n樽前喜有能吟客，管领风光共笑颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35679,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"来青亭閒咏","author":"陈崇德","text":"君恩曾未报涓埃，便学渊明归去来。\n尽日从容无一事，好花犹自倩人栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35680,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日书怀","author":"陈良贵","text":"一自春回睡觉甜，起来无语独掀髯。\n园林触目深红间，池馆惊心嫩绿兼。\n袅袅柳枝低舞袖，霏霏杏叶衬妆奁。\n别离到处王孙草，摇曳东郊酒客帘。\n邠老病因沉醉宿，少陵狂为恼花添。\n寻芳翠映金钿湿，斗草香怜玉指尖。\n沂水已看波映岸，谢池谁赋雪为盐。\n弄簧愁极莺啼树，顾垒情多燕入帘。\n薄暖几回生短褐，轻寒犹自恋重幨。\n莺啼似怨春将暮，燕语因知夏聿渐。\n祗恐东皇归去急，惜花诗句短长占。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35681,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日即事","author":"陈良贵","text":"青毡坐对此虚堂，惟有荷风过短墙。\n早起却怜春已去，閒来自觉日偏长。\n绿迷隋苑颦杨柳，红褪唐宫怨海棠。\n光景如流寒又燠，天时未定雨违旸。\n梅梢细听潇潇雨，草色行吟浅浅塘。\n尽有蓬门堪问字，更无胜地可寻芳。\n诗从得句吟偏苦，鬓到中年觉渐苍。\n赢得芸编频课子，官贫方免此身忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35682,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题彭工部山水","author":"陈良贵","text":"江风夜散溪头雨，枫叶萧萧满沙渚。\n沙边野客送轻舟，舟上离人若相语。\n风多语急了不闻，橹声咿轧谁能分。\n回波极浦无寻处，只隔中流一片云。\n君住江南我江北，长记相逢未相识。\n忽将归兴逐飞鸿，举袂欲招招不得。\n挥毫作画者何人，画中之意颇亦真。\n向来人事几迁易，碧水青山秋复春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35683,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"关山月","author":"陈良贵","text":"关山月，别来二十四圆缺。\n孤舟露下湿郫筒，对此清光愁断绝。\n故园两度开黄花，鸠妇看花双黛蹙。\n人生那得长相随，倏忽天南又天北。\n推篷抚景谩咨嗟，愿风吹作碧云遮。\n幽闺免此共相忆，肠断月高还自斜。\n关山月，底事经年照离别。\n君不见三关烽火羽书驰，壮士冲寒泪流血。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35684,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再题彭工部山水","author":"陈良贵","text":"竹屋斜连江上台，沿波芳草青如苔。\n沙头雨急春水长，云飞极浦轻舟开。\n百年浮世谁非客，却怪今朝有离别。\n万山千山不尽思，相思夜夜同明月。\n无情岁序如水流，初春一别又深秋。\n梦中犹记别时语，只在门前双树头。\n因嗟王粲滞归去，思乡空有登楼句。\n披图如得到江南，历历当年旧游处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35685,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"大安驿","author":"陈良贵","text":"逢人音语异，作客叹殊方。\n北去连孤嶂，西飞又夕阳。\n雪霜侵被冷，风雨入更长。\n独拥皇华卧，孤灯绕梦凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35686,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夕无寐","author":"陈良贵","text":"一番风雨过，庭院觉新凉。\n老至夜无寐，秋来更转长。\n萤光斜入户，蟾影漏侵床。\n抚枕无言处，流年两鬓霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35687,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乙酉阳朔除夕","author":"陈良贵","text":"每食叹无馀，官贫岁又除。\n家山频入梦，京国久稽书。\n枥上空羸马，池边欲涸鱼。\n归心闽海峤，课子带经锄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35688,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"觉衰","author":"陈良贵","text":"老来筋力倦，拜起异寻常。\n把酒惜馀景，对花愁断肠。\n数茎空白发，一饭足黄粱。\n俯仰能无愧，浮生付彼苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35689,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寓兰溪","author":"陈良贵","text":"旅食惭萍梗，孤舟坐黯然。\n酒思陶令日，诗负菊花前。\n薄柳蝉声急，平坡雁阵偏。\n一年光景去，聊纪此秋篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35690,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"苏堤","author":"陈良贵","text":"晚风吹柳拂堤匀，人去堤空草自春。\n潭月尚留方外趣，湘裙谁咏景中人。\n茅椒山拥青螺髻，䆗窱烟迷渌水滨。\n却笑樊笼双短鬓，几能来此濯氛尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35691,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过钓台","author":"陈良贵","text":"万古清风系此山，钓台高瞰碧波湾。\n落花无数晓风急，啼鸟几声春梦閒。\n半夜空占星斗渚，一竿先破利名关。\n自惭薄宦犹羁旅，舟过黄昏也赧颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35692,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游万松山寺","author":"陈良贵","text":"墨水东驰一鉴悬，隔江幽趣浩无边。\n閒凭古刹峰千点，远望春波水满田。\n野客到时鸥自狎，禅僧定后鹤初旋。\n重寻未有三生约，一笑归来月满川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35693,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送春书怀","author":"陈良贵","text":"镇日书堂静掩扉，乱红飘尽觉春归。\n好花似共流光老，衰柳应同故旧稀。\n斑管不教题五凤，锦文谁复理残机。\n疗贫虽得毛生檄，欲奉双亲愿已违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35694,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陪李太守俞别驾游玲珑岩","author":"陈良贵","text":"层层鸟道乱云通，岩际灵泉漱石宫。\n穿坞柳风吹鬓绿，傍岩花影落杯红。\n仇池往事真成幻，勾漏丹成已驭风。\n留此好山供胜赏，不辞归路夕阳中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35695,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜吟","author":"陈良贵","text":"银床一叶败梧飘，旋觉天潢斗转杓。\n风竹有声如玉佩，月华多影类冰绡。\n幽虫砌下双催织，邻女风前自弄箫。\n秋景满怀刚不寐，那应楚客独无聊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35696,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日游凌江","author":"陈良贵","text":"倚棹渔郎短笛风，凌江疑在画图中。\n一篷春思蘼芜绿，十里烟光踯躅红。\n望远共怜山色异，寻真直溯水源穷。\n笙箫莫遣韶华迈，一片花飞西复东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35697,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"古塔","author":"陈良贵","text":"冈势盘盘耸碧空，何年古塔定方中。\n银河色映三山月，铁马声随五夜风。\n七级开花悬汉表，千寻倒影挂楼东。\n未论佛语诸天近，且壮临淮巨镇雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35698,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"七夕","author":"陈良贵","text":"银河虽广鹊桥通，牛女佳期此夕中。\n九曲回肠终岁结，双星顾影暂时同。\n瑶情月下和丝乱，血泪人间作雨红。\n莫道别多相会少，绝胜仙子广寒宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35699,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游西湖","author":"陈良贵","text":"涌金门外水如天，湖上风光倍爽然。\n杨柳有情怜野客，梅花无主梦诗仙。\n摇摇帘影迎春旭，隐隐钟声起暮烟。\n莫羡兰亭脩禊事，风流堪比永和年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35700,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜月","author":"陈良贵","text":"冰轮光映桂花天，风露娟娟夜未眠。\n老景逢秋多少思，良宵见月几回圆。\n浮云灭没银河净，灵籁凄凉北斗悬。\n踏遍琼瑶花影碎，数声鸿雁落云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35701,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"野望","author":"陈良贵","text":"花光浓艳鸟声娇，野水平田透小桥。\n云散天边千丈碧，雨晴江上数峰遥。\n閒从门径多栽柳，静向山林学弃瓢。\n节序催人春又去，绿添芳草转无聊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35702,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜","author":"陈良贵","text":"一夜凉飙透葛裳，满庭诗景剩凄凉。\n虫声雨后鸣荒砌，萤火风前度短墙。\n竹簟冷涵流水气，藤樽清惹败荷香。\n人生感慨无今古，不特悲秋是宋郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35703,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题英石","author":"陈良贵","text":"闻说元章拜石翁，顿令今古想高风。\n鲛人斫碎云根处，水母擎来石案中。\n斑驳有情春雨湿，玲珑无语夜堂空。\n何须更蹑东山屐，镇日仪刑岳丈同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35704,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中","author":"陈良贵","text":"江云堆墨暗春城，十日都无一日晴。\n杨柳陌头窥冷眼，桃花枝上落红英。\n莺当苦雨啼应涩，燕为留人语有情。\n明发别君江上路，王孙芳草恨牵萦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35705,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"立春","author":"陈良贵","text":"独拥青毡随分安，梦醒长是日三竿。\n惭无补报酬明主，敢以清贫叹冷官。\n客里每怜新岁至，閒来犹把旧书看。\n春风骀荡千门里，虚度年光强自欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35706,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"渔浦","author":"陈良贵","text":"渔浦东头几问津，风波仍旧客怀新。\n云山千里劳乡梦，萍水经年少故人。\n楚客候潮舟似蚁，吴儿歌调月如银。\n推蓬无那霜华重，多少寒威怯早春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35707,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"车盘次许都谏韵","author":"陈良贵","text":"狂风疏雨暗消魂，车马纷阗客路喧。\n流水亭台环翠竹，出林鸡犬间孤村。\n旅怀对此偏增感，乡信凭谁可寄言。\n注目长安遥万里，一鞭行色又黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35708,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"客中示儿","author":"陈良贵","text":"怅望闽关万里游，迢迢亲舍隔沧洲。\n还家有梦三更月，阅世无能四十秋。\n黄卷功勤频致望，青毡官冷复何求。\n乘时好赖贤孙子，莫待区区半白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35709,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"玲珑仙室","author":"陈良贵","text":"杖藜穿透碧玲珑，九折虚岩有路通。\n一自神仙归去后，桃花开遍几春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35710,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"跃溪春涨","author":"陈良贵","text":"神龙早已跃沧溟，胜迹于今水尚腥。\n昨夜桃花春雨泛，溪流沉璧浸沙汀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35711,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"翰林同年绘像图六首 其一","author":"吴希贤","text":"岁聿云暮，玉河之堧。\n霰雪澄霁，风日清妍。\n君子有酒，来我同年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35712,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"翰林同年绘像图六首 其二","author":"吴希贤","text":"惟岁甲申，圣人临御。\n风虎云龙，邂逅相遇。\n登我诸友，玉堂之署。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35713,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"翰林同年绘像图六首 其三","author":"吴希贤","text":"玉堂巍巍，亦曰瀛洲。\n十载登兹，以遨以游。\n愿言相勖，无沗前修。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35714,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"翰林同年绘像图六首 其四","author":"吴希贤","text":"房杜既远，孰为我师。\n协力同心，惟王之毗。\n云胡十载，而多仳离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35715,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"翰林同年绘像图六首 其五","author":"吴希贤","text":"如彼抟沙，易涣以散。\n今者具在，式燕以衎。\n穫菽采萧，逢此岁晏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35716,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"翰林同年绘像图六首 其六","author":"吴希贤","text":"既搦尔管，亦抚尔琴。\n嗟我诸友，东西北南。\n言笑云云，实谐我心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35717,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元宵会谢鸣治宅得必字韵","author":"吴希贤","text":"京城重元宵，鳌火及明发。\n士女嘻以游，清歌绕天阙。\n胡彼风雪雱，而有此萧瑟。\n阴晴固难定，兹会胡可必。\n行乐须少年，人生易华发。\n从此复何为，且尽杯中物。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35718,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"上巳倪舜咨会瓮山得木字韵","author":"吴希贤","text":"世路苦氛埃，缅怀在山谷。\n晓出西郭门，珂马纷相逐。\n细草迷旧津，屡问烦僮仆。\n小径入湖阴，穿云过林麓。\n僧房雾露清，石磴莓苔绿。\n主人携酒至，盘餐杂殽?。\n杯行既已频，诗赋未能续。\n逸思转昏倦，欲借藤床宿。\n归骖不可留，夕阳在林木。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35719,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冯佩之之江西督学和宫谕谢木斋韵","author":"吴希贤","text":"霜台值春晚，芳草都门多。\n故人夙严驾，欲别还相过。\n感时愧余拙，黄鸟丘之阿。\n正学久蓁芜，异说纷蝉蛙。\n西江远可涉，帆影天一涯。\n吾道皦如日，此去将如何。\n赠君锦绣段，听君白玉珂。\n锄茅忆山径，濯锦夸天河。\n愿君更努力，洙泗多流波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35720,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"水口遇宗弟廷隆","author":"吴希贤","text":"兄向江南还，弟上金台去。\n水口一相逢，离愁渺烟树。\n今兹一邂逅，留君留不住。\n欲为回车轮，暂慰我朝暮。\n天意复从人，潇潇来夜雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35721,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]