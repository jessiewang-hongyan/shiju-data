[{"title":"哭李于鳞四首 其四","author":"欧大任","text":"过江诸子各天涯，得我犹将剧孟誇。\n自许会稽收竹箭，似从华顶弄莲花。\n代兴共有中原约，绝学能传博士家。\n谁料交游携手尽，扁舟淮海梦高沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6231,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题王元美小祇园","author":"欧大任","text":"宰官身已事东林，厌向金门学陆沉。\n醉后双钩沧海色，灯前半偈白云心。\n持经颇解清斋久，投老偏能住岳深。\n策杖给园精舍近，可容同社一相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6232,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虎臣子禹惟中时雍子交集斋中","author":"欧大任","text":"下马嚬呼浊酒瓶，西游宾客在黄亭。\n布衣谁敢轻朱建，木榻空羞老管宁。\n舞罢长虹秦气紫，头来明月楚天青。\n君看汝颍千秋会，曾为何人一聚星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6233,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中酬吴虎臣招饮普惠院","author":"欧大任","text":"持经寄宿似灵台，祇树林中一径开。\n白醴醲■缘客设，银鞍沾湿为君催。\n他乡留寓秦川远，羁宦风尘洛下来。\n飘薄况逢秋雨里，不妨沉醉夜深回。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀八首 其一","author":"欧大任","text":"书牍三千奏上方，酣歌铜马昔年狂。\n露桃笑进金盘湿，明水看斟宝鼎香。\n芝火夜深朝太乙，华旗秋早猎长杨。\n龙髯一与乌号堕，何处天涯望建章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀八首 其二","author":"欧大任","text":"一出金闺荷主恩，远游心寄白云垣。\n嵩呼太室封高邑，岱倚东方拜羡门。\n扼腕谈仙逢海客，凿空遣使问河源。\n向来痛哭轮台诏，万载安危属至尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀八首 其三","author":"欧大任","text":"双峰天阙秣陵开，定鼎河山亦壮哉。\n淮海烟花陪尾下，岷嶓冰雪大江来。\n军悬万垒胡尘断，漕转千艘浊浪回。\n笔札十年趋走地，张衡虚负二京才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀八首 其四","author":"欧大任","text":"塞下呼韩纳款成，衣冠未可讳言兵。\n九关斥堠通胡使，万国均输入汉京。\n夕戍远连骠骑幕，秋风还勒亚夫营。\n小臣敢预云台议，愿以铙歌答圣明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6238,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀八首 其五","author":"欧大任","text":"北上黄花一障孤，朵颜三卫半吹芦。\n征人夕堕看烽泪，使者秋飞出塞符。\n沙苑巳驱青海鹘，天闲不用大宛驹。\n宫罗马市无劳计，父老中原望赐租。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6239,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀八首 其六","author":"欧大任","text":"洛下鸣珂半弭貂，上书多入紫宸朝。\n五都任侠贫偏剧，三辅论才老未招。\n赋后风生云梦猎，楼前月忆广陵潮。\n何人不有图南翼，只道鸾凰在赤霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6240,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀八首 其七","author":"欧大任","text":"黄河东下引归怀，挂席清秋欲渡淮。\n簪笏未能忘紫闼，儿童先已办青鞋。\n百年天地尊吾足，十岳烟霞乞此骸。\n金液析将成晚岁，葛洪山畔一茅斋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6241,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀八首 其八","author":"欧大任","text":"彩笔诗从万里题，薜萝今自赋幽栖。\n游梁岂必逢停驷，怀越宁能恋执圭。\n南海潮来黄木口，罗浮云傍赤花西。\n束书沽酒堪投老，不为弹冠负杖藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6242,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴虎臣过新蔡寄张助甫","author":"欧大任","text":"长裾落魄一交情，白马车寻蔡渡行。\n置驿已知频请谢，扫门何处不逢迎。\n西河客礼骄田子，江夏时名忌祢衡。\n把袂千杯看意气，中原还汝并纵横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6243,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄方藩伯","author":"欧大任","text":"雁过江南梦渐多，十年燕草送鸣珂。\n关中饷待萧丞相，海上军劳马伏波。\n琛贡百蛮应已入，铭题五岭更如何。\n野人怀惠思归去，惟与渔樵一醉歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6244,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄胡郡伯","author":"欧大任","text":"郡阁君来已及瓜，怜余为客未还家。\n礼尊下榻逢迎简，诏许褰帷父老誇。\n独忆千觞南海月，曾同九日广陵花。\n王褒欲奏中和颂，四百峰头卧紫霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6245,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀陈督学道襄豫章解归","author":"欧大任","text":"忆君偃蹇畏途难，南楚诸生恋讲坛。\n自理钓鱼归客艇，谁论簪豸侍臣冠。\n海边瑶草曾相寄，岭外梅花只自看。\n报遁倦游书已上，莫令烟水旧盟寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6246,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈使君敬甫张进士于皋过斋中对菊","author":"欧大任","text":"僻居冠盖肯同游，花似柴桑烂熳秋。\n久客岂知逢使者，故人犹自得江州。\n天青杖底嵩云落，霜白尊前汝水流。\n南望峭帆归欲去，宦情何处不沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6247,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送袁左州","author":"欧大任","text":"西下陀陵竹马欢，虎符何日出长安。\n登楼山月诸蛮伏，吹剑边风万骑寒。\n郁水星摇秦使节，苍梧云傍汉臣冠。\n明年羽猎誇胡客，归赋长杨雪未残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6248,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张进士于皋使河南因归岭外省觐","author":"欧大任","text":"蓟门烟柳故人疏，谒者秋辞侍从庐。\n桐柏西来迎负弩，梅花南去傍停车。\n风云关外终军使，水旱河南汲黯书。\n封事粤中须早上，君王深念及樵渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6249,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答黎惟敬梁思伯潘少承燕京见怀","author":"欧大任","text":"汉苑秋风侍綵旄，故人近幸似王褒。\n千鸿浮弋书来远，匹马长安梦去劳。\n河曲浊流通汝海，关门紫气接嵩高。\n飘飘便可寻仙隐，不为将归感二毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6250,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"予至汝南林干夫王叔经亦自朗陵至携酒夜过开元精舍见访二君各谈中条天台之胜因赋","author":"欧大任","text":"严城击柝夜临关，斗酒能寻讲寺间。\n宦业君犹持笔橐，乡心吾已视刀环。\n司空亭寄王官谷，支遁铭题瀑布山。\n处处烟萝偏有梦，平舆东望白云还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6251,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访观汉碑至淮渎庙与继上人邓道士望大复山","author":"欧大任","text":"桐柏山头客未归，深栖真与世情违。\n璧投淮渎龙争避，锡过胎簪鹤并飞。\n黄绢共持花水供，白云偏恋薜萝衣。\n虎溪一望双林晚，犹笑浮名误息机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6252,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过南阳饮方司勋允治宅","author":"欧大任","text":"浮光客似广陵贫，五载逢君是故人。\n省闼挥毫知赋就，风尘握手见情亲。\n玉箫吹月江淮夜，宝马看花宛洛春。\n明日关河千里去，肯辞深酌负陈遵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6253,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"裕州光武庙","author":"欧大任","text":"帝子亲将九鼎扶，飞泉犹足骇愚夫。\n冰前骑士滹沱水，阙下书生赤伏符。\n唐邓北来存旧宅，崤函西锁卜东都。\n投戈汉业千年盛，惆怅荒祠乱夕乌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6254,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登昆阳楼","author":"欧大任","text":"一片孤城日欲低，极天沙草共凄凄。\n乾坤尚想风云阵，苍莽犹惊虎豹啼。\n万恨连营惟剑戟，诸山京观尽鲸鲵。\n中原从此雄图定，河陇长驱白帝西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6255,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓登龙门寺楼","author":"欧大任","text":"烟中隐隐见层台，僧卧高龛户始开。\n曙早残星连汉没，春时飞翠过河来。\n伊流天际舟初渡，洛下花时雁已回。\n宝地珠林堪出世，自怜川陆日悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6256,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北邙山临望洛阳城","author":"欧大任","text":"汉主河山锦绣多，西人望幸意如何。\n金墉半纳缑嵩月，鼎观平临谷洛波。\n自昔五经称白虎，只今诸少满铜驼。\n抽毫赋客兰台下，听得东都父老歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6257,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洛西楼怀岑给事叶侍御","author":"欧大任","text":"回磴层云睥睨愁，为君孤眺独夷犹。\n关门西引三峰色，河水东悬万里流。\n卷幔绿吹榆柳细，开尊红映杏花稠。\n春深远作他乡客，满目风尘易倦游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6258,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偃师东寄王元美","author":"欧大任","text":"书来桐柏岁将残，雁过姑苏雪未乾。\n二室我游能卖畚，五湖君去但持竿。\n乾坤万事垆头尽，风雨孤征匕首看。\n知有江南春可赠，梅花偏忆玉骝寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6259,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白马寺","author":"欧大任","text":"河山百二走关门，经入中原佛自尊。\n白马驮从天竺国，青鸳飞傍给孤园。\n蒲团雪积花前供，贝简云深石上翻。\n自昔南宗称弟子，不将文字与僧论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6260,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登少室山","author":"欧大任","text":"削壁嵚崟万木摧，天边寒色大荒开。\n白云玉检封中出，紫气函关马上来。\n三辅干城分陕地，五陵宾客集仙台。\n秦坛汉畤虚无里，杖底西风首共回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6261,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"从太室遂上岳顶","author":"欧大任","text":"白鹤观前人迹稀，独探灵气谒天扉。\n岳云低向祇林落，瀑雪遥从御路飞。\n狩日庭颁群后玉，宴时鸟识侍臣衣。\n只今圣主巡游少，父老何劳望羽旂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6262,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒嵩岳庙登天中阁","author":"欧大任","text":"金支翠盖百灵趋，测影天京宅此区。\n只尺扶风开二华，苍茫□楚望三涂。\n洛曾卜历千年在，路为升中万岁呼。\n嘉祀告成多协气，词臣何日奏西都。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6263,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嵩少山中怀张助父","author":"欧大任","text":"策杖高临百八盘，雄心忽自上巑岏。\n飞虹不断千峰色，积雪长吹五月寒。\n河水晓萦秦路树，岳花春覆汉封坛。\n叔卿白鹿能相待，二室何时共尔看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6264,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中访朱灌甫","author":"欧大任","text":"萧条匹马汳梁行，海内深驰十载情。\n敢藉交欢为重客，尚能都讲领诸生。\n歌风大国闻何晚，积雪平台赋未成。\n箧里书藏应早奏，河间雅乐在西京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6265,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠孟中丞","author":"欧大任","text":"夷门文苑自君开，雪满黄河我独来。\n过郑岂期逢七子，游梁偏自愧群才。\n满延客坐还推毂，曾总戎机数举杯。\n圣主借筹今欲召，不知何处望三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6266,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱仙镇岳王庙","author":"欧大任","text":"百万长驱虏不支，金牌谁遣哭班师。\n英雄未饮匈奴血，天地空摧马革尸。\n二帝梦魂沉朔漠，两河父老望旌旗。\n西风折尽沙城柳，犹似将军督战时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6267,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"许州游西湖寄吴少修兼怀陈士鹄","author":"欧大任","text":"斗酒星亭不共携，使君远在七闽西。\n昔来听水谁开槛，老去看花一杖藜。\n五岳自能寻向长，三亭那得侍王嵇。\n太丘为吏今何似，楼上怀崧早寄题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6268,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邵长孺访余光州遂赴汳上","author":"欧大任","text":"三年汝海见君迟，念我江淮苜蓿时。\n家故牛医游最久，世无狗监去何之。\n平原十日偏能饮，梁苑诸生雅善诗。\n西上吹台沙草绿，相思惟有白云期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6269,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘太守玄湖别业十九首 其一 于野堂","author":"欧大任","text":"明农君早归，荣宦世多巧。\n呼鹰自贤豪，行歌饭牛饱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6270,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘太守玄湖别业十九首 其二 依云楼","author":"欧大任","text":"高丘尽牛眠，云里松几个。\n扶策一登楼，目送双鸿过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6271,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘太守玄湖别业十九首 其三 注经阁","author":"欧大任","text":"笔格置墙隈，闭窗山叶堕。\n谁来候先生，夜深把藜火。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6272,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘太守玄湖别业十九首 其四 龙山","author":"欧大任","text":"千里开平楚，丹梯延伫中。\n山山堪落帽，不必待秋风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6273,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘太守玄湖别业十九首 其五 翠霞坞","author":"欧大任","text":"鹤前平欲临，松杪高可吸。\n此中敷坐时，难偈僧来揖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6274,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘太守玄湖别业十九首 其六 香雪巢","author":"欧大任","text":"玉林积飞霰，风过筼筜寒。\n烦热何所有，天花洒蒲团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6275,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘太守玄湖别业十九首 其七 桔槔亭","author":"欧大任","text":"湖田岁岁熙，颇似瀼西村。\n俯仰无机事，丈人方灌园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6276,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘太守玄湖别业十九首 其八 舴艋亭","author":"欧大任","text":"渔人榜小舟，诘曲桃花水。\n鸡黍能相邀，问津傥来此。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6277,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘太守玄湖别业十九首 其九 秋水亭","author":"欧大任","text":"鹓雏发南海，逍遥吾所之。\n鸱之自腐鼠，奚用相嚇为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6278,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘太守玄湖别业十九首 其十 野云亭","author":"欧大任","text":"风静云归山，风起云作雨。\n伛偻久无心，日倚亭前树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6279,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘太守玄湖别业十九首 其十一 茶汀","author":"欧大任","text":"卜居天门下，置园顾渚山。\n茶灶支泉侧，夕待樵人还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6280,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘太守玄湖别业十九首 其十二 酒屿","author":"欧大任","text":"丘中酥醪香，叠曲松花旁。\n隐矣桐柏水，剪圭封醉乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6281,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘太守玄湖别业十九首 其十三 苇滩","author":"欧大任","text":"湖波激苇滩，其下石齿齿。\n何异潇湘秋，和歌沧浪子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6282,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘太守玄湖别业十九首 其十四 丙畴草堂","author":"欧大任","text":"父老谈稼穑，柴门巾我车。\n远怀古田舍，击壤今何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6283,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘太守玄湖别业十九首 其十五 驯鹤楼","author":"欧大任","text":"缑氏一羽衣，翩跹行独驭。\n相将浮丘公，接上嵩高去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6284,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘太守玄湖别业十九首 其十六 鹿曲","author":"欧大任","text":"仙人卫叔卿，云中醉骑汝。\n蜿蜒成白龙，服骖叩灵圉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6285,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘太守玄湖别业十九首 其十七 桂栅","author":"欧大任","text":"好道仙人至，尊生逸老年。\n淮南一万树，樛曲小山前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6286,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘太守玄湖别业十九首 其十八 楂园","author":"欧大任","text":"出世一大事，骈梅诚何意。\n那知薝卜林，婆娑漆园吏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6287,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘太守玄湖别业十九首 其十九 射圃","author":"欧大任","text":"控弦风鸣镝，长楸古城下。\n白头报主心，金埒且驰马。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6288,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送苏君锡二首 其一","author":"欧大任","text":"伊阳下汝河，大淮望西浙。\n如何故乡人，却在他乡别。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6289,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送苏君锡二首 其二","author":"欧大任","text":"日望江南路，秋风吹苧衣。\n钱唐君欲渡，应与雁同飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6290,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郡楼下临淮河","author":"欧大任","text":"三洲树似荠，千里沙如月。\n何处落帆还，登楼望吴粤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6291,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜过褒信听桥下流泉","author":"欧大任","text":"涧下鸣琴响，披衣白露寒。\n忆在东林宿，僧来石上弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6292,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白公寺与二三释子夜坐","author":"欧大任","text":"尘缨偶一濯，潇洒泉上石。\n何期趋府人，共此听钟夕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6293,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答张乾甫二首 其一","author":"欧大任","text":"俯仰人间世，经年客未还。\n不堪持手版，马上望嵩山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6294,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答张乾甫二首 其二","author":"欧大任","text":"河洛忘归路，东寻大吕亭。\n委心曾十载，不是爱沉冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6295,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答李荫京师见寄三首 其一","author":"欧大任","text":"开椷不忍读，字字念情人。\n多少登楼恨，烟花又一春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6296,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答李荫京师见寄三首 其二","author":"欧大任","text":"上书君未遇，闻欲下燕台。\n何事青毡冷，先生亦肯来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6297,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答李荫京师见寄三首 其三","author":"欧大任","text":"徇禄犹卑吏，归山已后时。\n长安书不到，君但寄相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6298,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"斋夜","author":"欧大任","text":"廨里双林月，城边一涧烟。\n西斋诵经罢，寥寥兹夕眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6299,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]