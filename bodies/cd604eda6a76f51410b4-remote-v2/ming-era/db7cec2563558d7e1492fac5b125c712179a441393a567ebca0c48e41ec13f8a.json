[{"title":"乙卯十九首 其一","author":"范景文","text":"万历乙卯天行酷，齐城八百付荼毒。\n虐魃驱将火云飞，烧尽荒原无半菽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22375,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙卯十九首 其二","author":"范景文","text":"闾右几家蓄红粟，早供恶少眈眈目。\n乌聚横抢白昼间，眼看贫富计同蹙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22376,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙卯十九首 其三","author":"范景文","text":"羊豕杀尽继以犊，木皮草根聊充腹。\n掘得饥鼠带毛啖，爨底无薪煮不熟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22377,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙卯十九首 其四","author":"范景文","text":"资用斥尽典敝服，圮颓止剩半间屋。\n拆将难得易一饱，明日忍饥草间宿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22378,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙卯十九首 其五","author":"范景文","text":"吹霜打雪北风号，惨裂肌骨息不属。\n老人一夜卧且僵，少待将无幼壮续。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22379,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙卯十九首 其六","author":"范景文","text":"荷锄携釜出门泣，欲行不行空踯躅。\n本以逃死去其乡，此去生死那可卜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22380,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙卯十九首 其七","author":"范景文","text":"揾泪伤心走穷谷，稚子牵挽跌且仆。\n眼前饥死不能起，暂作生离委中麓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22381,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙卯十九首 其八","author":"范景文","text":"羸妻冲风行且哭，偕毙不如将去鬻。\n市价斗米值千金，一妻难籴一升谷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙卯十九首 其九","author":"范景文","text":"中贫人赈数升谷，持去连糠和苜蓿。\n一勺分作两日餐，食尽还愁生计促。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙卯十九首 其十","author":"范景文","text":"今年饥望明年熟，野赪曾无一寸绿。\n村南尽有田可耕，谁使卖剑为买犊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙卯十九首 其十一","author":"范景文","text":"减俸劝施收几斛，沟中或可存遗骨。\n青州富守亦何人，苦口属告我良牧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"红叶","author":"范景文","text":"霜林谁点染，老翠见深红。\n色重娇新艳，条苏怯晚风。\n春滋休欲妒，秋杀莫言功。\n亦有寒松柏，长青向此中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬夜王性甫招饮署中同段汝器吕介孺二年兄","author":"范景文","text":"吾辈多通率，更深尚赴邀。\n官閒馀胜致，岁晏快长宵。\n杂坐都忘套，诙谈不厌嚣。\n独嫌司令者，酒政密科条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22387,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬夜同王季木介孺泛舟","author":"范景文","text":"看月兼听浪，湖中胜事多。\n迎寒消浊酒，得景付清歌。\n木落澄空镜，梅开映素波。\n秋游那得此，好去傲仙坡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22388,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"行荒","author":"范景文","text":"行荒尽日见孤村，室内无人昼掩门。\n无数寒鸦啼断树，凄风苦雨又黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22389,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早观趵突泉和尔律","author":"范景文","text":"谁使人意閒，听浪宜向晚。\n谁使澄素心，波静快平远。\n泉脉此何来，乱溅崩雪堰。\n滚滚漾冰花，斗此珠珍苑。\n相斗势未降，碎击琉璃散。\n每誇匡瀑飞，玉跳胜瓴建。\n应是天液灵，巧与地籁混。\n渟泓不尽奇，故此束而卷。\n试取浣尘空，喷薄省决挽。\n照之须眉扬，挹之醒沉懑。\n寄语洗耳人，此际堪嘉遁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22390,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"腊月十五日夜作是年闰八月及此后二日而立春","author":"范景文","text":"不是天多事，今宵已上元。\n年长因有闰，月好更无喧。\n灯负春前约，蓂馀腊后存。\n晚梅与早柳，閒试一争论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22391,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"腊月廿后初雪前三日立春","author":"范景文","text":"忧暵兼祈雨，年来当课程。\n望穷看雪落，分外见春生。\n逼岁如相约，乘阳似有情。\n归功难草草，好勒一亭名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22392,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙卯除夜 其一","author":"范景文","text":"忽惊明日是明年，检点从前祇自怜。\n好日半多消马上，深怀时复望云边。\n无文难送穷中鬼，入俗羞称吏是仙。\n守岁也思聊应景，烧灯独坐展残编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22393,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙卯除夜 其二","author":"范景文","text":"忙忙辞腊又迎春，似笑如何却似颦。\n祇为二东烦百苦，才添一日已三旬。\n历头细数惊馀半，天下谁教更换新。\n独快佳名称除岁，除他俭岁见丰辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22394,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿长清署中晓起将发感而有作时丙辰正月六日","author":"范景文","text":"古驿昏鸦睡，长途暮马饥。\n宵寒停柝早，时亟启关迟。\n落月三更信，春风六日期。\n年年行役苦，两度已于斯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22395,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王季木招饮济上高林堂","author":"范景文","text":"风物何时最爽森，除将秋霁是春阴。\n客因同调成孤赏，地以高林畅远心。\n梅影偏宜灯下取，竹香细向酒中寻。\n眼前未尽氛埃气，欲掬寒泉洗碧岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22396,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得春寒花较迟即用为韵 其一","author":"范景文","text":"不是闻莺啭，那知入晚春。\n时因耽月闰，花作待年身。\n扫雪云流树，踏青草作茵。\n游人拘故事，犹向武陵津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22397,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得春寒花较迟即用为韵 其二","author":"范景文","text":"花事原宜早，妒人奈薄寒。\n似忘三月信，急望一枝看。\n日下閒分种，风前巧护栏。\n主人须爱惜，将放胜将残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22398,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得春寒花较迟即用为韵 其三","author":"范景文","text":"颇似关情事，春光恨未奢。\n宜留霜后菊，虚想雨前茶。\n伴竹依新月，妆林倩晚霞。\n群芳嗟异候，何不似梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22399,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得春寒花较迟即用为韵 其四","author":"范景文","text":"神欲取其清，韵格欲取峭。\n譬如品美人，倾国不关貌。\n竞艳抹浓脂，何似天然妙。\n此亦需解人，细与閒商较。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22400,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得春寒花较迟即用为韵 其五","author":"范景文","text":"意思虽幽冷，晴光到即知。\n前林申后约，明岁卜先期。\n冻蕊香弥远，晚芳褪自迟。\n有辞催艳发，胜作落花诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22401,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁巳再饥 其一","author":"范景文","text":"彼苍何可问，异祲若为常。\n秋至还祈雨，田空又见蝗。\n疗饥人啖鬼，劝赈肉医疮。\n沟瘠填难尽，流离满路旁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22402,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁巳再饥 其二","author":"范景文","text":"何不陈灾状，轻于背尔乡。\n去非心所愿，留恐肉先僵。\n墓委他人守，儿充此日粮。\n知能来复否，言下意悲凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22403,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁巳再饥 其三","author":"范景文","text":"岂无贤宰牧，缓颊说如伤。\n点铁原无术，催科自有方。\n计穷生胜死，众弱聚能强。\n比岁歼群盗，将无元气戕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22404,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁巳再饥 其四","author":"范景文","text":"开庾仍分镪，也知数发棠。\n穷应呼父母，乱亦费赀粮。\n天虐君能补，帑空赋可偿。\n蠢兹邦本在，持以告吾皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22405,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟行","author":"范景文","text":"簿领埋头苦，舟行快不艰。\n倚窗听细浪，捲幔看晴山。\n稻黍逢人问，烟云信手删。\n醉馀时一卧，梦境共鸥閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22406,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和秋禊六首 其一","author":"范景文","text":"春禊何如秋禊佳，高情远致自吾侪。\n会无常数馀閒日，坐有清流宜水涯。\n旧谱翻成添韵事，新题吟去散诗牌。\n祓除此际知尤快，风淡无尘月不霾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和秋禊六首 其二","author":"范景文","text":"春禊何如秋禊佳，中元上巳亦何乖。\n暑当初去如芳候，月到方圆畅好怀。\n度曲和容林外鸟，飞觞劝借雨中蛙。\n未能免俗聊应尔，献果分瓜拆玉钗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和秋禊六首 其三","author":"范景文","text":"春禊何如秋禊佳，月新花老较争差。\n山光似睡疑初醒，蛩叫如吟乍自喈。\n情胜不寻三月例，诗成懒作四言排。\n临池势向空中取，雁字分明折股钗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和秋禊六首 其四","author":"范景文","text":"春禊何如秋禊佳，气清天朗应时谐。\n随缘杂坐能忘套，率语倾心不忌俳。\n林里真堪称小隐，花前亦可学长斋。\n主人欲傲山阴会，丝竹如教故故喈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22410,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和秋禊六首 其五","author":"范景文","text":"春禊何如秋禊佳，时时觞咏可兴怀。\n鸿宾莺友谁调舌，殇寿彭夭我放骸。\n流水声悽弹绿绮，蘋花风紧踏青鞋。\n凭将格外通疏意，探雪观莲总未乖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22411,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和秋禊六首 其六","author":"范景文","text":"春禊何如秋禊佳，幽芳九畹露滋荄。\n风传金气园邻谷，门接桑田里是柴。\n貌出群贤皆似鹤，坐当古木半如楷。\n远香无用标新榜，即曰兰亭义却谐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22412,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"先曾大父丞郯城有惠政两邑求摄争之境上至今传以为异观风至此忾然有感","author":"范景文","text":"郯子遗封旧，临淮去鲁迟。\n云将山起伏，烟带草迷离。\n地僻民风古，差多驿路疲。\n留馀先泽在，行部使人思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋和介孺韵时桂花未开 其一","author":"范景文","text":"爱杀中秋好月光，竹边清切水边凉。\n西风吹向花栏过，错认兰香是桂香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋和介孺韵时桂花未开 其二","author":"范景文","text":"一枝且莫怨开迟，桂萼须知胜柳丝。\n嫩绿初黄凭看取，晚秋风物早春诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜有梦","author":"范景文","text":"秋宵长自可，只是梦无端。\n境幻非因想，时多不肯阑。\n关情温旧事，得意遇新欢。\n佳处偏逢醒，其如漏未残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新草","author":"范景文","text":"春光吹到未全匀，偏是新青自可人。\n无力摇风因带雪，有情就雨怕沾尘。\n欲寻多处须临水，正趁柔时好作茵。\n乘晓踏青原上望，离离烟际辨曾真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初柳","author":"范景文","text":"春情乍被柳相挑，尽费支持不自聊。\n作意将来令眼媚，关情偏可惹魂销。\n瘦犹含态骄梅格，暖故拖寒带雪条。\n漫教疏黄与深绿，好风吹绽看来朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐辰叟以诗名家而书法画品亦复擅奇一时遂有三绝之目夫三者足为辰叟重哉高情寄托尚别有在而此其馀也然馀亦称绝是之谓辰叟耳","author":"范景文","text":"谁似君三绝，当由韵不如。\n试看诗在画，直以篆为书。\n披卷生情慧，含毫寄想疏。\n文心通体映，此亦但其馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"魏仲雪过餐冰斋遇雨","author":"范景文","text":"清风吹袂惹烟萝，正是冰厅许尔过。\n密坐深谭尘事少，新知细访隽人多。\n酒间啜茗肠如浣，卷里题诗手自摩。\n当夏快来秋意爽，兼将凉雨快如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"米仲诏斋中观剧与辰叟赋","author":"范景文","text":"小名应是唤盈盈，声态偏能想性情。\n低度静闻梁上响，步虚小试掌中轻。\n翻嫌杂和吹弹寂，别见馀姿顾盼生。\n不是今宵消不得，花醒人醉月清清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"看月","author":"范景文","text":"雨馀宜对月，虽夏亦云秋。\n物象生新爽，襟情与淡幽。\n庭空容水映，夜永许人留。\n祇觉情无尽，凭虚又上楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瓶花影与仲诏同赋 其一","author":"范景文","text":"应是花魂乱，支离壁与瓶。\n水烟分体魄，灯月幻精灵。\n寂照能为色，有无好问形。\n耳根忘却否，落瓣亦堪听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瓶花影与仲诏同赋 其二","author":"范景文","text":"与画难同看，曾无粉墨遮。\n描时聊取似，插处却宜斜。\n灯背深笼幕，蜂回懒报衙。\n天机传灭没，绝胜镜中花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瓶花影与仲诏同赋 其三","author":"范景文","text":"试参象外花，何若人中景。\n照壁宁非真，折枝仍作影。\n谁云嗅有香，意在浓时冷。\n但当影子观，个中犹未领。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同辰叟集仲诏葆光堂得阳字","author":"范景文","text":"何期官舍里，见此紫芝房。\n种竹无伦次，栽花有秘方。\n琴生惟取韵，右聚亦能香。\n试解仙人意，悠然思葆光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题米家童","author":"范景文","text":"生自吴趋来帝里，故宜北调变南腔。\n每当转处声偏慢，将到停时调入双。\n坐有周郎应错顾，箫吹秦女亦须降。\n恐人仿此翻成套，轻板从今唱大江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月十一夜与介孺看月成醉共赋十四盐 其一","author":"范景文","text":"秋虽方过半，月却尚能纤。\n况有人相映，偏教景似添。\n挹清倾露液，取影下湘帘。\n诗里须情韵，何如此际兼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月十一夜与介孺看月成醉共赋十四盐 其二","author":"范景文","text":"诗就还看月，移时兴未厌。\n更深花意寂，坐久梦思恬。\n浪谑皆成雅，新声不忌纤。\n生情爱凄冷，对酒可能廉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闱中晓起次介孺韵","author":"范景文","text":"平章文事罢，枯坐却如僧。\n占喜听喧鹊，耽眠扑倦蝇。\n诙资残酒助，倦向小栏凭。\n客况谁消得，香烟蔓石藤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"憩寿张署中次介孺韵","author":"范景文","text":"谁是当官不苦忙，敲冰且复浣诗肠。\n来青乍快迎风竹，送日常焚入夜香。\n行色三更随月冷，襟期六月带秋凉。\n远心自在尘鞅里，小憩何须定解缰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独寐","author":"范景文","text":"布枕馀清意，形神得自亲。\n薇风时动幕，小月夜窥人。\n境欲参喧寂，梦先断想因。\n疏梅交暗影，与作睡乡邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟行","author":"范景文","text":"两年马上睡，今始快舟居。\n水溅时来枕，尘吹不上裾。\n拂云朝洗砚，钓月夜惊鱼。\n捉笔知飞舞，南游纪胜初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟行见荷花折插瓶中 其一","author":"范景文","text":"不用陂池不用钱，乘舟采向冶湖边。\n但须插架妆生态，自去疏枝自拣泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟行见荷花折插瓶中 其二","author":"范景文","text":"清通高远挺孤妍，况有山矾作侍鬟。\n石几纸窗无别供，花成香雾水成烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟行见荷花折插瓶中 其三","author":"范景文","text":"闻香餐秀总堪怜，君子呼名品是仙。\n茗赏得神原胜酒，水云傍置一茶颠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泊舟书所见","author":"范景文","text":"蒹葭已自见秋容，何事舟横浅水中。\n滞橹停摇频问雨，破帆斜挂懒呼风。\n波间试水喧艄子，篷下铺蓑睡柁公。\n爨罢吴娘无个事，滩头閒采蓼花红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初秋看水中新月 其一","author":"范景文","text":"月固深秋好，逢秋已自奇。\n况当初出候，绝胜入残时。\n清映空中色，寒侵骨与肌。\n有无烟水里，正足使人思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初秋看水中新月 其二","author":"范景文","text":"一片波文润，居然冷画屏。\n水疑工小景，月故皱全形。\n若使光无剩，犹嫌写不灵。\n最奇声称色，细籁吹玲玲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初秋看水中新月 其三","author":"范景文","text":"閒将花比月，花老不如新。\n意敛翻多态，肤清并入神。\n纤轻工半面，游戏解分身。\n暗想怜花者，其时定早春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜邓未孩冯上仙曹愚公招饮淮河楼上看演黄粱传奇","author":"范景文","text":"秦淮河上低杨柳，歌舞楼中小月明。\n异地谁教宾作主，同襟方见弟和兄。\n已从戏局还看梦，纵使诙谈总自清。\n一曲游仙催漏短，贪欢怕是听鸡声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄李仁常","author":"范景文","text":"李郎好情致，都不关山水。\n虽尔负才多，渊静无自喜。\n两人称淡交，政此元味尔。\n许日不见时，辄欲生吝鄙。\n况是别经年，中怀能已已。\n把酒读离骚，所思在兰芷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]