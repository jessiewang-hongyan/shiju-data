[{"title":"亭菊 其五","author":"何维柏","text":"迢迢我思，远莫致之。\n三闾餐英，宏放厥词。\n卜居之什，其心孔悲。\n柴桑三径，作德是宜。\n允矣君子，百世之师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8497,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瞻彼萱草 其一","author":"何维柏","text":"瞻彼萱草，植于北堂。\n怡颜养志，嘉乐允臧。\n我思古人，百顺是将。\n循省内■，寝食靡遑。\n心之忧矣，曷其能忘。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8498,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瞻彼萱草 其二","author":"何维柏","text":"瞻彼萱草，其叶四垂。\n顾諟晤对，秩秩其仪。\n我思古人，跬步弗遗。\n先意承志，念兹在兹。\n不见是图，毋敢斁斯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8499,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瞻彼萱草 其三","author":"何维柏","text":"瞻彼萱草，灼灼其华。\n兄弟具在，宜尔室家。\n孙曾嬉戏，慈颜孔嘉。\n和德致祥，善庆讵涯。\n天伦至乐，大行何加。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8500,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瞻彼萱草 其四","author":"何维柏","text":"瞻彼萱草，维其时矣。\n朝跻于西，邈难及矣。\n维日不足，心乎忧矣。\n迟迟春晖，云何报矣。\n终身之思，曷维其已。\n悠悠我心，以告吾子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8501,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游飞来寺 其一","author":"何维柏","text":"寺古老于树，云深鸟道微。\n钟鸣群兽走，风送片帆飞。\n拄杖青崖抹，丹心白日驰。\n登台千载思，双鬓任风吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8502,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游飞来寺 其二","author":"何维柏","text":"曲涧泻春泉，寒松带晚烟。\n半云侵客座，斜日落渔船。\n风细岩花静，月明山色鲜。\n酣歌迷去路，倚榻欲栖禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8503,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游飞来寺 其三","author":"何维柏","text":"白发閒无事，招携峡上游。\n友生千古意，吾道一孤舟。\n云静僧归洞，山空月满楼。\n探幽情不极，随处是丹邱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8504,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵月夜感旧","author":"何维柏","text":"万丈松风吹客衣，月明山色望霏微。\n石泉洞古春长在，云谷天空鸟自飞。\n此日登临仙犬吠，十年踪迹主人非。\n岩花似领无言意，且向樽前一咏归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8505,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵道中","author":"何维柏","text":"胜日寻芳上翠岑，鸟啼花落总春心。\n杖藜到处有真乐，松岭招云一径深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8506,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"经方少保西樵山居","author":"何维柏","text":"五龙深处相公家，楼阁连空锁暮霞。\n门外久荒车马迹，庭前犹放木樨花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8507,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"紫云楼雨夜书怀","author":"何维柏","text":"夜坐西樵百尺楼，忽惊风雨起春愁。\n十年回首论心地，寂寞寒灯数旧游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8508,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北江别亲友","author":"何维柏","text":"孤舟万里迅宵征，细雨深更寝复兴。\n别岸数声传野柝，前湾几点落渔灯。\n非才捧檄成何事，多病匡时愧未能。\n倚枕不胜怀土梦，白云回首几千层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8509,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三溪印月","author":"何维柏","text":"扁舟晚向三溪宿，独坐遥看秋水生。\n明月澄江天共远，双松孤鹤夜同清。\n眼中滚滚俱尘梦，海上悠悠非世情。\n更欲乘槎何处所，扶桑东去即蓬瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8510,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"昆都耸翠","author":"何维柏","text":"孤峰立霄汉，万木森青苍。\n振衣时一登，流盼睐大荒。\n昆都自昆仑，岧峣宗衡阳。\n屏山亘横石，白云秀东方。\n西樵挹我前，大雁列我旁。\n灵郁合浈武，迢迢浮大江。\n罗浮指顾间，沧海东茫茫。\n广土万馀里，惟兹奠中央。\n众山互联络，奇胜独昂扬。\n灵窍发天籁，花名吐异香。\n下有千仞渊，蛟龙时潜藏。\n上有千年枝，可以栖凤凰。\n吾坐二十载，蹑足探孤芳。\n结茅山南麓，胜事日徜徉。\n竹门度幽禽，松风韵清商。\n门户事探讨，默坐澄心腔。\n冰壶镜杜溪，翠草交周窗。\n缅然景前哲，亦有崔与张。\n崔张日以远，江门浩汤汤。\n泰山入青徐，叹彼道路长。\n决策时及早，驱车历周行。\n今人亦古人，后生当自强。\n壮行在初学，时发贵含章。\n从龙云致雨，起凤天际翔。\n他年纪胜迹，兹山讵能忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8511,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"文昌宫壁漫题","author":"何维柏","text":"森森古树鸟频声，静唤春深入胜形。\n漫觉忧时孤梦远，敢云去国一身轻。\n半生事业卑题柱，一曲沧浪有灌缨。\n万里瞻依天北极，五云晴绚日边明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8512,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠陈允卿","author":"何维柏","text":"光岳气完通海峤，纲常任重属胶庠。\n珠州勿谓非沂水，芹泮谁怜远庙堂。\n模范已知师仲节，英才行见出文庄。\n故园昼锦休迟恋，化雨春风好播扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8513,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日游普陀岩","author":"陈天资","text":"海国秋深乐事稀，普陀岩下扣禅扉。\n寺经岁月几僧在，木落山空一鸟飞。\n欲觅黄花迷故径，暂从玄圃问真机。\n题糕忽忆当年事，插遍茱萸酩酊归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8514,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游阴那寺","author":"陈天资","text":"闻说那山古道场，迟迟马策此羊肠。\n眠云嫩草时承坐，飞涧松花半送香。\n昙馆风清禅寂寂，芸窗月上夜央央。\n数声钟磬鸡鸣彻，欹枕閒听讲梵王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8515,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"河西务钱郎中邀饮歌以赠","author":"陈天资","text":"大夫为人崇谦抑，舟中枉顾始相识。\n同年张愿是同乡，邀我登堂候颜色。\n虎丘禹穴聚奇伟，龙汉延津在胸臆。\n斯文相识即相亲，谈论无方亦无极。\n平生尚友颜平原，临是平原真墨刻。\n高吟朗诵好文章，斗采投琼令行亟。\n君举空杯我举满，主人怯饮客不管。\n风霜何事苦生寒，谈笑忘怀各自煖。\n台人来报更已深，相辞上马月如浣。\n归到舟中睡不成，但有台斗相陪伴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8516,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶成","author":"陈天资","text":"寻风步入海塘西，山草山花径路迷。\n野叟不知天已老，犹拖筠杖过江湄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8517,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庐溪谒周濂溪祠","author":"陈天资","text":"庭草青青照昔年，图书千载发幽传。\n几回独上萍江望，风定光生月满川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8518,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"途中有感漫纪","author":"陈天资","text":"披雾蒙烟散晓行，萧萧疋马引双旌。\n老僧扫榻日当午，笑破机关三两声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8519,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石宝寺阻雪","author":"陈天资","text":"僻寺藏荒谷，空庭落叶稠。\n雪侵虚殿冷，松冥曲廊幽。\n江逐濛烟阔，山迎宿霭浮。\n褰帷亭夕驻，对境若为愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8520,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"萍乡道中和枫潭韵","author":"陈天资","text":"飘泊天涯路，孤伶客里身。\n云山常作伴，琴鹤旧相亲。\n历惯风霜苦，空惊岁月频。\n廿年驰部檄，不换此身贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8521,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"憩桃川宫和韵","author":"陈天资","text":"秋入桃源路，烟霏淑景深。\n云回千嶂合，风动万松吟。\n古洞留仙迹，孤舟系客心。\n渔郎不再遇，空自费登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8522,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"良乡夜雪","author":"陈天资","text":"五夜窗冰白，推窗见雪明。\n群鸦禁不诣，画鼓寂无声。\n银塔联瑶树，琼宫隐玉城。\n独怜天际客，孤枕梦难成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8523,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪晴过庾岭","author":"陈天资","text":"逢人尽说庾关险，此日闲登绝顶来。\n远近紫梧巢鹤睡，清虚楼阁倚云开。\n摩空日映双旌过，鸣涧风生万壑哀。\n极目千山一澄霁，许身今已在瑶台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8524,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕 其一","author":"陈天资","text":"辽左维车滞异乡，再逢除夕动悲伤。\n一身系国三更梦，万里思亲九断肠。\n云物触膺惊岁月，霜风和泪洒衣裳。\n伫看海上苍茫外，即是悲人卜筑场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8525,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕 其二","author":"陈天资","text":"绝塞逢春岁欲新，天涯稚子转相亲。\n千家未撤三城戍，孤枕犹羁一病身。\n北警频来魂亦怒，南书不至泪交侵。\n巡檐散步青云下，苦忆霜鬟守岁人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8526,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山飞来寺","author":"车邦佑","text":"晓入翠微寺，迢遥上半空。\n云藏帝子阁，日射梵王宫。\n已觉尘嚣远，恍如霄汉通。\n天开奇胜地，偏镇十洲雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8527,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山飞来寺","author":"李兆龙","text":"昔人传有白猿洞，此地空遗碧玉环。\n白猿不知何日去，玉环早已出人间。\n长松百尺跨短壑，飞鹭几点起前湾。\n借问山人何年往，云生谷口欲忘还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8528,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山飞来寺","author":"李兆龙","text":"珠宫画阁俯江陂，借静寻幽历翠微。\n石壁有天窥色相，松林来月照禅衣。\n云间琪树经年艳，竹里玄蝉向晚悲。\n一自飞来传语后，玉环金锁尽堪疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8529,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"捧诏书出长安门","author":"饶相","text":"紫凤衔书降九天，禁城花木发春妍。\n丹墀百职翔云下，青琐孤臣去日边。\n鸿绩已镌清庙鼎，龙文光映彩霞笺。\n遭逢愧玷丝纶地，重作皇华应宿缠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8530,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镇远道中有怀严太守","author":"饶相","text":"绝壁悬崖路不平，双旌缥缈雾中行。\n恩临远地嗟岖险，威被遐方喜肃清。\n雨浥烟花多艳郁，天连云树少晴明。\n良宵展读溪亭赋，照夜隋珠映彩灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8531,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登关索岭","author":"饶相","text":"嵯峨古庙碧山巅，香火由来不计年。\n忠烈本存兴汉志，艰危肯负托孤虔。\n威清南服夷方地，名著中原敌国边。\n独有吴王犹稳卧，知君遗恨尚绵绵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8532,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日宴集沈氏庄次王遵严韵","author":"饶相","text":"昔读古人书，夙抱先忧志。\n心源未澄彻，每为外物累。\n因循度岁时，龌龊牵俗事。\n迩来反诸身，颇觉有真意。\n吾气大且刚，浩然塞天地。\n一为物所役，四海无容袂。\n鬼神启我衷，吾道今有契。\n鸿雁落河皋，远自天边致。\n踪迹风尘内，议论云霄际。\n启心输忠赤，瞩目览苍翠。\n天阔云烟敛，波光鱼鸟戏。\n观物悟道机，触景发人思。\n浮生惜寸阴，饮食须知味。\n误几三十载，不饮长如醉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8533,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日与石蒙泉长官对奕于花园中","author":"饶相","text":"地僻喧哗少，人閒草木幽。\n花枝藏宿蝶，柳树隐鸣鸠。\n酌酒消馀兴，围棋较夙筹。\n客愁无处着，聊此乐优游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8534,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日同诸寅丈次韵中秋夜月","author":"饶相","text":"秋波浸月海天摇，落叶翻空逐舞飙。\n幽兴独凭诗可遣，閒愁惟有酒能消。\n欲攀玉宇忧寒迫，拟向蓬莱怯路遥。\n南北关情暂排遣，嫦娥莫惜举杯邀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8535,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次王遵严大参韵忆别","author":"饶相","text":"衡储计重乏良筹，忝奉宸章督两州。\n恩诏悯荒宽国赋，私心藉解为民忧。\n自怜弱植多离索，幸接时髦共晏游。\n四教未遑频请益，萍踪又逐水东流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8536,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杏树","author":"饶相","text":"一株文杏当庭心，绿叶层层满院阴。\n隐却青虫无觅处，时招黄鸟弄佳音。\n风来静听多清响，雨过閒看自豁襟。\n顾盼此君增雅兴，祇忧秋色暗相侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8537,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小园对景","author":"饶相","text":"小院馀花草，春深引兴浓。\n芳枝来啄雀，残蕊惹游蜂。\n触景知时令，隔墙聆夕舂。\n公馀閒对此，生意与之同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8538,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题福泉寺温汤","author":"饶相","text":"百沸温汤寺，一泓清可怜。\n体明无遁照，用广不论钱。\n避俗潜边谷，从僧傍野禅。\n谁当钻地脉，试看孰为燃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8539,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蓟州公署遇雨久阴奉怀王亭皋寅丈","author":"饶相","text":"积雨园林润，鸣鸠处处闻。\n拨愁开卷读，避湿炷香焚。\n傍砌花应瘦，归巢鸟失群。\n闭阴谁有术，推日出层云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8540,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄吴潜渠窗兄","author":"饶相","text":"秉铎珠崖去，迎亲报母慈。\n子材徵善教，家立见能持。\n日月悬双念，邱茔抱独悲。\n一官成禄养，忠孝两兼之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8541,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送林质轩先生之文昌司训","author":"饶相","text":"之子吾乡彦，明经邃古今。\n玉堂曾品第，琼海拜儒林。\n出处关垂教，荣枯少绊心。\n春风无限好，须耐岁寒侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8542,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郑州除夕","author":"饶相","text":"连年奔走长安路，骨肉音疏仆从亲。\n驰逐渐消髀里肉，摩挲浑是鬓边尘。\n岂无杯酒供诗兴，为有乡愁入梦频。\n万里孤身犹似昔，岁华来日又更新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8543,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临湘道中","author":"饶相","text":"连月征长路，经年别故园。\n高飞无过雁，清啸有哀猿。\n谷转萝偏密，山深木愈繁。\n天涯行欲遍，何日慰椿萱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8544,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日江行","author":"饶相","text":"发棹趋南郡，春江两岸平。\n风帆随去鸟，人迹逐浮萍。\n钓艇山腰系，舟樯树杪行。\n离家方信宿，浩荡似遥征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8545,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"红梅纱帐","author":"饶相","text":"十幅轻绡悬卧榻，银钩高挂隔纤尘。\n昼掀寝客魂偏爽，夜罩幽人梦不惊。\n缜密难教蚊蚋近，玲珑能逗月华明。\n谁将上苑红梅树，彩笔描来无限清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8546,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀林秋崖别驾","author":"饶相","text":"岭表知名士，年来始识荆。\n忧时多确论，居室重乡评。\n旅邸论交日，沧州忆别情。\n停云空怅望，遥隔几长亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8547,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清秋夜坐","author":"饶相","text":"露发坐清夕，商飙生夜凉。\n穷愁衣带缓，假寐梦魂长。\n宇下鸣虫聒，天边归雁忙。\n孤云傍南斗，永夜一相望。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8548,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日閒居杂咏","author":"饶相","text":"绿树鸣蝉尽日闻，炉香绕篆气氤氲。\n羁怀多少关心事，遥隔天南万里云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8549,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴方伯苏原先生见寄佳作次韵酬答","author":"饶相","text":"负谴南州宦况寥，喜君湖上每相邀。\n柳阴对景如看画，竹外闻歌似听韶。\n燕石自呈惭赵璧，木瓜何幸报琼瑶。\n风骚动我沧州兴，安望冥鸿附碧霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8550,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸卯岁江南北大旱黎民饥馑秋行即事","author":"饶相","text":"田野萧条处处同，断蓬枯草逐秋风。\n愁闻富屋仓庚罄，忍见贫家杼轴空。\n啜泣暵乾嗟莫及，熟筹拯救计安从。\n逢人便说闾阎苦，惆怅长吟大小东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8551,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋泗川对月","author":"饶相","text":"去年过此重阳后，今岁还来月半秋。\n微迹总如萍梗寄，壮心宁为稻粱谋。\n婵娟正好将谁共，歌笑遥闻亦唤愁。\n安得庾楼清兴客，相携谭道暂忘忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8552,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日同杜刺史游百万湖因芙蓉盛开舣舟湖中主翁苏原山人携尊以赏之散后苏原赠以佳章遂次韵以答谢云 其一","author":"饶相","text":"秋菊盈盈九月天，木莲湖上亦呈鲜。\n飘如西子缠绡舞，艳似真妃带酒眠。\n偶对芳姿呼二妙，却逢具眼号双贤。\n从今作古风流远，未遇知音莫漫传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8553,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日同杜刺史游百万湖因芙蓉盛开舣舟湖中主翁苏原山人携尊以赏之散后苏原赠以佳章遂次韵以答谢云 其二","author":"饶相","text":"公馀并辔之东郭，兴发停骖泛柏舟。\n却喜簿书无废阁，可堪尊酒俯清流。\n萧条时事浑忘乐，荡漾湖光亦散愁。\n为爱秋芳西照暝，从容笑语未能休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8554,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日同杜刺史游百万湖因芙蓉盛开舣舟湖中主翁苏原山人携尊以赏之散后苏原赠以佳章遂次韵以答谢云 其三","author":"饶相","text":"节逢寒露风初凛，景入秋深山色臞。\n欲就闾阎访隐逸，恐惊村巷罢传呼。\n丛花作伴堪乘兴，斗酒相须不用沽。\n借问东君谁得似，贤哉广受汉农夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8555,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日同杜刺史游百万湖因芙蓉盛开舣舟湖中主翁苏原山人携尊以赏之散后苏原赠以佳章遂次韵以答谢云 其四","author":"饶相","text":"贤哉广受汉农夫，幸识荆州乐与娱。\n对榻剧谈真旷达，同舟共酌复何拘。\n风来听竹如琴奏，醉后攀花似杖扶。\n安得江淹传彩笔，为君题景比西湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8556,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲辰岁仲冬再过高井驿重次壁间韵","author":"饶相","text":"边城暂喜静胡笳，奎宿文明照海涯。\n剑气几时光射斗，笔峰何日梦生花。\n九天雨露恩如许，下国云烟路独赊。\n勋业无闻频对镜，腐儒空叹岁华加。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8557,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄郑澹泉和州别驾 其一","author":"饶相","text":"郑虔自昔称三绝，海内于今识令名。\n砥柱临流终屹立，古松凌雪不彫零。\n此时淮右攀辕轴，他日天边听履声。\n休羡东山风景好，会须霖雨为苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8558,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄郑澹泉和州别驾 其二","author":"饶相","text":"怅望和阳隔翠屏，江天遥见少微星。\n汇征本学山公启，左试翻为贾傅行。\n烟树苍苍徒极目，岁华冉冉若为情。\n知君终作商霖雨，愧我蓬蒿负此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8559,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕 其一","author":"饶相","text":"明发更新岁，残年独此宵。\n荣枯犹默默，勋业叹寥寥。\n坐久炉香息，眠迟绛蜡销。\n绕床还览镜，糜禄愧清朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8560,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]