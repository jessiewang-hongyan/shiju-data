[{"title":"予家旧藏潇湘图聊因旧题各成短咏八首 其七 远浦归帆","author":"陆深","text":"孤帆自天际，出没见秋毫。\n归心同逝水，飞度挟风涛。\n临流一怅望，空觉此生劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1303,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予家旧藏潇湘图聊因旧题各成短咏八首 其八 平沙落雁","author":"陆深","text":"雁阵惊寒早，平沙衬水圆。\n同怀稻粱意，南下尽翩翩。\n谁念关山远，犹有尺书传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1304,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉华杂咏七首 其一 玉华山","author":"陆深","text":"海风吹海雨，飞过玉华山。\n山中人不见，窈窕翠微间。\n得月乘鸾度，开云放鹤还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1305,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉华杂咏七首 其二 白云窝","author":"陆深","text":"云来如有情，云归本无迹。\n归去群山青，来时林树白。\n窝中卧云人，偶值爱云客。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1306,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉华杂咏七首 其三 万柳塘","author":"陆深","text":"千条万条黄，垂柳复垂杨。\n连云难辨色，荫月不留光。\n幸不当岐路，别离那复伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1307,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉华杂咏七首 其四 望湖楼","author":"陆深","text":"登楼望澄湖，楼高湖面小。\n金波月里秋，青草雨中晓。\n心閒境逾静，悠然见鱼鸟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1308,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉华杂咏七首 其五 韩山","author":"陆深","text":"一发韩江水，韩山相对起。\n扁舟乘海潮，回首渺千里。\n上流春雨多，夷犹弄清泚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1309,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉华杂咏七首 其六 越王走马埒","author":"陆深","text":"燕台骨已朽，渥洼种未生。\n何年走马埒，尚带越王名。\n榕叶斜阳外，坐看海云轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1310,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉华杂咏七首 其七 鹤舟","author":"陆深","text":"买得青田种，相携共一舟。\n碧箫吹夜月，飞度百花洲。\n借问华亭唳，何如赤壁游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1311,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过安山几间有高达夫集偶拈东平路作一首戏效其体","author":"陆深","text":"飞鹢指金台，扬帆出钜野。\n细柳萦长堤，新蒲弱堪把。\n烦襟散遥岑，好风送朱夏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1312,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云山图赠严介溪西还","author":"陆深","text":"美人别我还楚封，遥望云山如画中。\n忆昔燕市初相逢，年少意气双飞鸿。\n朅来射策披心胸，五云旭日蓬莱宫。\n玉堂对榻闻晓钟，南郊献赋追扬雄。\n旁人忽忽称儒宗，文彩往往惊相公。\n过从莫限风雪冲，卜居长安家屡通。\n眼见天日升潜龙，石渠夜照藜火红。\n退食联步时从容，移书论道相磨砻。\n岂徒握手期协恭，自信肝胆摩苍穹。\n今我日月催衰慵，近有白发临青铜。\n世事浮云无定踪，况子缞绖俨在躬。\n十年契谊萝施松，一旦掺袂成西东。\n人言此图千万重，我意试比应难穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1313,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中山图次韵俞国昌都谏送许补之侍御谪定州","author":"陆深","text":"中山风物美且都，无乃贤达避世区。\n芝山许子今钜儒，虬髯逸论如大苏。\n只手欲作回天图，七月诏狱朱颜敷。\n我生有癖惰且迂，辱子契谊时与俱。\n两都三试要不殊，空怜警夜雁有奴。\n寂寞府中栖树乌，剸割修复见昆吾。\n聊试儿童夹道呼，中山山中劝种榆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1314,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜与高进之沈德桢诸友过簳山次壁间韵","author":"陆深","text":"棹歌欲停山月吐，月影照人清可数。\n疑心已断壁间蛇，壮气犹惊草中虎。\n清溪曲曲淡不流，此月重来犹故我。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1315,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋思","author":"陆深","text":"空庭萧索帘栊雨，秋色漫漫四山里。\n閒花不语伤朱颜，落叶无声风未起。\n依稀三五少年游，凤凰台畔临吴楚。\n家书自怪满纸题，犹剩胸中数行语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1316,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"何舍人馆中对雪","author":"陆深","text":"燕地春犹浅，高城雪更明。\n相逢为客处，同有望乡情。\n栈阁因风积，楼台入夜清。\n不知梁苑赋，何似蔡州城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1317,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过卢沟桥","author":"陆深","text":"野适意自惬，逢春更可怜。\n弄黄初试柳，破碧已分泉。\n马足腾晴雾，鸡声隔午烟。\n翠华巡幸日，驰道直如弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1318,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"孝庙挽词","author":"陆深","text":"帝座宵沈彩，皇祇昼啸风。\n人怀三代治，天忌万年功。\n衮冕丹青里，山河涕泗中。\n圣恩如可报，精卫海涛东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1319,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下陵","author":"陆深","text":"片月青山外，遥灯绿树中。\n马蹄知熟路，人语杂回风。\n台殿参差出，冠裳彷佛同。\n穹碑犹入望，挥涕忆神功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1320,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"对月","author":"陆深","text":"连夜月色好，此宵看满轮。\n金波惆怅里，碧海别离新。\n冰雪南征雁，关山北望人。\n琴书照清影，舟楫对通津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1321,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"假寐","author":"陆深","text":"假寐依洄洑，篝灯伴水云。\n晚潮随月上，归雁带霜闻。\n地古三江合，星移五夜分。\n冥行吾岂敢，露宿畏离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1322,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三日出大明门","author":"陆深","text":"日华丽高阁，风光媚轻尘。\n喧喧车马动，蔼蔼岁年新。\n花柳回芳甸，关山念远人。\n履端逢泰运，大飨卜明禋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1323,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得玉河烟柳","author":"陆深","text":"御堤新水上，细柳织轻烟。\n隐映金銮外，低回玉甃前。\n晓容横一抹，春色试三眠。\n地接天门近，常沾雨露偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1324,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得刘子书","author":"陆深","text":"念子不能寐，中宵鸣素琴。\n近闻衡岳去，遥望楚江深。\n入梦多岐路，缄书有好音。\n隔窗风雨横，愁绝故人心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1325,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄李献吉","author":"陆深","text":"客到梁园者，仍烦致起居。\n夜来新有梦，春去久无书。\n绿野深花径，黄河抱草庐。\n迢迢千里道，目短鬓萧疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1326,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和张玉溪山行","author":"陆深","text":"一径出林坰，四山开画屏。\n霜钟度远寺，雪柳带长汀。\n路转城闉出，云深石洞冥。\n千年埋玉处，龙气昼常扃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1327,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"华盖殿外候驾雪中有怀崔后渠严介溪上陵","author":"陆深","text":"此去西陵好，花骢并辔行。\n桥山瞻王气，礼殿肃精诚。\n吏供宵饭，归鞭促晓程。\n立残金殿雪，忆尔到昌平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1328,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"分水祠漫成","author":"陆深","text":"江头十日坐，无日不吁嗟。\n绿暗连天柳，红明委地花。\n衔泥新燕子，傍水旧人家。\n南望无终极，青天又一涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1329,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谷亭经旧寓","author":"陆深","text":"土屋曾为客，朱炎夜见星。\n枣林连驿路，麦饭趁鱼腥。\n万里看双鬓，三年抱一经。\n经行重俯仰，枫树晚冥冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1330,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过清河烟雾不见山","author":"陆深","text":"春气浓如酒，沈沈醉远山。\n爱飞孤鸟没，随意片云閒。\n兴为寻芳发，尘怜扑面还。\n石桥流水漫，立马听潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1331,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐州洪次韵","author":"陆深","text":"表里山河胜，东泉复上流。\n斜阳明石佛，古堞绕徐州。\n溪影尤宜月，潮声不待秋。\n去来风雨横，奇绝冠兹游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1332,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月下抵彭城","author":"陆深","text":"险中不觉险，家近转思家。\n世路元无尽，人生故有涯。\n乡音传白苧，秋事付黄花。\n今夜彭城驿，清尊对月华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1333,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宝应晚泊","author":"陆深","text":"天接湖光迥，云开塔影圆。\n老渔明宿火，客子傍归船。\n晚市风声静，秋沙月色偏。\n绝怜净如练，閒拟谢公篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1334,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡江","author":"陆深","text":"几日江南路，灵旗发画船。\n江流馀旧日，山色入新年。\n风细蛟龙卧，云开虎豹眠。\n夕阳京口闸，吟兴酒尊前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1335,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过丹阳","author":"陆深","text":"平明辞铁瓮，日暮过丹阳。\n远道初知客，方言忽近乡。\n苔封联艇绿，泥涴小车黄。\n柳暗河桥下，平分麦秀凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1336,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游金山次唐韵","author":"陆深","text":"过水金山寺，真怜地脉分。\n潮声生绝壁，江影堕孤云。\n凉吹先秋到，长歌入夜闻。\n登临殊不极，斜日伴微醺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1337,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘉定登圆通寺佛阁次王节推韵","author":"陆深","text":"酷暑宜高阁，时花上槛红。\n水沈销活火，冰簟受南风。\n鸟背层霄外，龙腥古钵中。\n晚凉频徙倚，村郭失西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1338,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄纯玉之再游龙华也予不及再陪怅然次韵","author":"陆深","text":"浦口桥西寺，水深尘事稀。\n重来黄叔度，尚忆陆探微。\n霜后惊红树，天南望紫微。\n还将五色手，归补衮龙衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1339,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游昭庆寺","author":"陆深","text":"秋风昭庆寺，初日满回廊。\n地古松能偃，山深橘未霜。\n移舟还傍麓，著屐试登堂。\n高阁凌云表，凭阑意自长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1340,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"坐月喜易钦之见过","author":"陆深","text":"方庭兀坐久，漏水静来闻。\n雉堞孤云补，旗竿片月分。\n乡心基远梦，凉意感微醺。\n赖有同心者，敲门慰藉勤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1341,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题竹送张钟美待御按云南","author":"陆深","text":"临岐欲有赠，赠此比琅玕。\n南国多炎暑，因君见岁寒。\n风雷山岳动，潇洒画图看。\n白雪真难压，青云亦可干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1342,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚过元明新居","author":"陆深","text":"岁暮天涯客，相依愿好邻。\n楼台残夜月，梅柳隔年春。\n契谊怜知己，驰驱愧此身。\n浮云终日事，偏感异乡人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1343,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦雨","author":"陆深","text":"长安十日雨，雨中孤客愁。\n泥深妨著屐，乡远怕登楼。\n水气偏欺日，云阴每妒秋。\n不知畿甸里，禾黍尚堪收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1344,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月下与张碧溪汎舟","author":"陆深","text":"微月堕止水，空明漾浅沙。\n放舟沿柳岸，看竹过邻家。\n林静一枝鸟，溪喧两部蛙。\n不应张博望，别自有仙槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1345,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠沈举人铨","author":"陆深","text":"岁晚风江阔，天空朔雁孤。\n君行自冰雪，吾意且江湖。\n骥北千金价，鹏南万里图。\n文章关国运，把酒对青蒲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1346,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"俨山春晓二首 其一","author":"陆深","text":"濛濛连夜雨，曲曲带溪山。\n隔水分喧寂，经旬断往还。\n天连沧海近，人比白鸥閒。\n多藉东风力，吹春到闭关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1347,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"俨山春晓二首 其二","author":"陆深","text":"初有江山胜，况逢花柳春。\n晓云含宿雨，暖吹约轻尘。\n树里看孤棹，烟中辨四邻。\n几年京国梦，唤醒爱閒身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1348,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄孙思和","author":"陆深","text":"竟负回舟约，虚烦下榻留。\n惟馀三亩宅，遥望七峰楼。\n天接星文动，江涵雁影流。\n烟花正无数，老眼几时休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1349,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中行史泾","author":"陆深","text":"江路西南永，端阳亦不晴。\n草堂松粉润，花坞藓痕平。\n桥古行人迹，田低过水声。\n兹游自奇绝，云树望中生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1350,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六日雨二首 其一","author":"陆深","text":"郊居世尘少，农月雨声多。\n暝色连葭菼，繁阴动薜萝。\n歌谣终帝力，沾润即恩波。\n漠漠江天外，时时白鸟过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1351,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六日雨二首 其二","author":"陆深","text":"长閒缘性懒，爱雨为年丰。\n入夜声逾急，因风势转雄。\n灯前欹病枕，江上忆渔翁。\n亦有沧洲兴，相期泛水东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1352,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南浦阻风","author":"陆深","text":"西风催逝水，一片布帆轻。\n渺渺江鸥去，离离锦树明。\n兴高偏有恨，秋老最关情。\n咫尺溪南路，天留访戴行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1353,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留布金寺","author":"陆深","text":"宿宿俱投寺，行行莫问津。\n麦波摇落日，花雨恋残春。\n水国攻农事，禅房清世尘。\n乡心与野意，从此往来频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1354,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋斋夜听雨二首 其一","author":"陆深","text":"鹳鹊林栖尽，秋窗细雨来。\n野云天共远，凉气夜交催。\n檐溜断仍滴，灯花落更开。\n幽人心赏足，孤咏寄高怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1355,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋斋夜听雨二首 其二","author":"陆深","text":"南亩苦刈稻，秋风兼送寒。\n老农舂旧谷，红女捣残纨。\n暗响随黄叶，疏香消紫兰。\n物华知节改，加意几回看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1356,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿碧云寺","author":"陆深","text":"西崦碧云寺，天空近太微。\n堂虚寒吹入，檐宿暮云归。\n听履仙卿集，留僧锡杖飞。\n偶因方外胜，殊觉世情非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1357,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵严介溪上陵","author":"陆深","text":"帝遣修陵祀，秋来得并行。\n雨声连日夜，山色洗幽并。\n远道防残暑，斋心冀晚晴。\n敬皇弓剑地，挥泪想西征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1358,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酌别何舍人兼问讯空同子","author":"陆深","text":"年少谁如子，他乡怯病身。\n春风满归路，几日罢征轮。\n尘合青山远，河开碧树新。\n故园如见月，应念未归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1359,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别王瑩中二首 其一","author":"陆深","text":"孤舟连夜发，客子念还家。\n远道多秋卷，高城急暮笳。\n一身笼外鸟，万虑壁间蛇。\n春色淮南路，江蓠绕白沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1360,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别王瑩中二首 其二","author":"陆深","text":"爱尔不能住，高楼空暮思。\n浮云连日脚，流水绕天涯。\n未有孙阳遇，虚烦楚客辞。\n故园江上好，风咏况相宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1361,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五坞山房为卢师陈赋","author":"陆深","text":"不是黄金地，毋烦白石歌。\n春风湖上路，夜月镜中波。\n插案图书在，缘阶兰桂多。\n遥知梅雪后，杖屦待经过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1362,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚自西堤携楫儿散步","author":"陆深","text":"夕阳江水外，曲曲带沙堤。\n生意随汀草，閒心付杖藜。\n渔舟天上下，人语瀼东西。\n稚子偏怜我，相携过竹溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1363,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赴储芋西少参中途过陈氏庄避雨","author":"陆深","text":"合下陈蕃榻，真成访戴行。\n燕泥妨马力，花雨弄春晴。\n十里缘江路，中年故国情。\n不须团盖拥，风澹正云轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1364,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"人日雪二首 其一","author":"陆深","text":"院深勤扫地，帘静爱闻香。\n堕壑随风力，穿云逗日光。\n山城阁道迥，松径石衣长。\n欲试煎茶水，丁宁近竹房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1365,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"人日雪二首 其二","author":"陆深","text":"人日岁常阴，今年雪更深。\n天空山竞出，春早柳难禁。\n四海三农望，孤城独客心。\n故园江上路，梅坞有谁寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1366,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"看云","author":"陆深","text":"筠簟瑩冰纹，开帘卧看云。\n随风还作阵，映水复成文。\n出岫连绵起，奇峰次第分。\n更能呈五色，持此献明君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1367,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"人日","author":"陆深","text":"春日复人日，乡心乱客心。\n东山游不到，西岭雪常阴。\n城郭林泉绕，风云殿阁深。\n梅花临水发，抛事且须寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1368,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月下行舟","author":"陆深","text":"水曲风帆渺，云开月殿圆。\n金波千片动，珠斗半空悬。\n树影连山合，歌声入夜妍。\n舵楼高似屋，归兴坐来偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1369,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兰溪道中","author":"陆深","text":"朝日晖江路，平林映远山。\n宿云收不尽，高鸟与俱还。\n秋草弄幽色，寒松有好颜。\n时时上高濑，隐几听潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1370,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"教岩暮发","author":"陆深","text":"向夕秋山紫，西风吹白云。\n纳凉移榻屡，待月引杯勤。\n岭树参差出，渔歌次第闻。\n去留俱有适，吏隐欲中分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1371,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]