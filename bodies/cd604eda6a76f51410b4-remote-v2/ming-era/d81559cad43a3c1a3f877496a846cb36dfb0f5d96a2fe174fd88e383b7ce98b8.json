[{"title":"题四友图用香山体","author":"毕自严","text":"长安为觅壬辰谱，纫佩相看几故人。\n共荷清时联八座，每逢雅集拚兼旬。\n低徊素发三千丈，颉颃青霄四十春。\n松柏岁寒终不改，波澜世事莫重陈。\n诗缘兴会旋成韵，酒对心期讵问巡。\n醉后披图从指点，商山吾欲卜芳邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21518,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"惜庭花","author":"毕自严","text":"提瓮汲新水，阶前著意浇。\n好花初烂漫，底事苦飘飖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21519,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"屈指归来日效白体七首 其一","author":"毕自严","text":"屈指归来日，中秋桂影圆。\n赏心无个事，棠棣倍相怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21520,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"屈指归来日效白体七首 其二","author":"毕自严","text":"屈指归来日，东篱花正开。\n寒香三四种，斗室共徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21521,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"屈指归来日效白体七首 其三","author":"毕自严","text":"屈指归来日，悬弧逼贱辰。\n蓼莪空洒泪，茅茨却无春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21522,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"屈指归来日效白体七首 其四","author":"毕自严","text":"屈指归来日，依然韦素看。\n杜门甘养晦，当路耻相干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21523,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"屈指归来日效白体七首 其五","author":"毕自严","text":"屈指归来日，清贫守故常。\n缊袍体自暖，藜藿味偏长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21524,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"屈指归来日效白体七首 其六","author":"毕自严","text":"屈指归来日，荒园满绿苔。\n夷犹堪得句，放浪可衔杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21525,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"屈指归来日效白体七首 其七","author":"毕自严","text":"屈指归来日，竹桃正著花。\n还应识故主，烂漫吐红霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21526,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟游黄华洞以大风不果","author":"毕自严","text":"咫尺困罡风，黄华不可见。\n山灵解妒人，藏却本来面。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21527,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠曹长庚二首 其一","author":"毕自严","text":"世情洗尽直如弦，耽酒工诗妙悟禅。\n莫道曹丘空四壁，满囊珠玉总娟娟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21528,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠曹长庚二首 其二","author":"毕自严","text":"蜡屐行吟逸兴多，墨花飞洒遍山阿。\n道经写罢无他羡，翻笑羲之欲换鹅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21529,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汉寿亭侯墨竹","author":"毕自严","text":"凌霜心事许谁知，书付萧萧竹两枝。\n秘意当年浑未解，丹青千载绘新诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21530,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏东曹长庚问病","author":"毕自严","text":"为问东村曹长庚，匡床何事负春风。\n药炉初沸参苓饮，好泻纤纤玉手中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21531,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壬子初春有感","author":"毕自严","text":"荏苒春光去不还，朝来白发镜中斑。\n簿书扰扰成何事，返我山中学驻颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21532,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"于?先天才隽逸久别乍晤感喜交集长至有诗倚和二首 其一","author":"毕自严","text":"阳生缇室初惊序，斗灿奎光已映身。\n三十年前铅椠友，于今重作论文人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21533,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"于?先天才隽逸久别乍晤感喜交集长至有诗倚和二首 其二","author":"毕自严","text":"但著千秋不朽业，无劳深羡宰官身。\n若教科制仍词赋，君是龙头第一人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21534,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壬戌长至有感时事漫赋二绝用白苏韵 其一","author":"毕自严","text":"一灰葭动新吹律，五夜香焚旧检身。\n笑我硁硁还碌碌，圆通常是不如人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21535,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壬戌长至有感时事漫赋二绝用白苏韵 其二","author":"毕自严","text":"泰道将亨尚未回，侧身天地一孤荄。\n故园松菊今相待，屈指春和归去来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21536,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"真如寺春日杂咏二首 其一","author":"毕自严","text":"籍田旷典萃鹓斑，萧寺孤臣抱膝眠。\n戆骨自嗟还自艾，梦魂空绕御炉烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21537,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"真如寺春日杂咏二首 其二","author":"毕自严","text":"家音读罢暗销魂，季子疾侵仲议婚。\n堪叹此身同桎梏，爱缘抛却任乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21538,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和张华东年翁斋居祈雨韵","author":"毕自严","text":"雷电惊心夜不眠，一朝浩荡九霄传。\n初衣已遂无他愿，但乞时丰供税钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21539,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"途次和张年翁咏桃花","author":"毕自严","text":"绿杨春树荫芳邻，中有夭桃别样新。\n马上不烦频指点，好花应笑白头人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21540,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁丑夏月和韩邑侯喜雨二绝句 其一","author":"毕自严","text":"青騣谁驾代天工，一夜甘霖万井同。\n岐麦共欣沾化雨，虞弦还喜奏薰风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21541,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁丑夏月和韩邑侯喜雨二绝句 其二","author":"毕自严","text":"夕曛洒润抵朝阳，悔祸天心忽降康。\n试向翳桑阴里听，声声布谷唤人忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21542,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊寅正月寿张华东年兄七十三初度兼订观海之约 其一","author":"毕自严","text":"宦海同游五十年，归来衰鬓各皤然。\n于今抛却人间事，共向王乔问大还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21543,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊寅正月寿张华东年兄七十三初度兼订观海之约 其二","author":"毕自严","text":"传闻海蜃幻楼台，仙屋筹添瑞气开。\n岱岳孔林游屐遍，何当把臂向蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21544,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐翼所年伯素履图说十二首 其一 庭闱受业","author":"曹于汴","text":"人以官拓产，伊产以官落。\n何能卑小官，而不清献若。\n世情难与偕，所贵在空橐。\n贻谋亦有良，一经不为薄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21545,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐翼所年伯素履图说十二首 其二 泮宫发轫","author":"曹于汴","text":"曩未采芹日，芸窗现鬼魑。\n移居免覆压，人谋讵及斯。\n毋乃人四旁，有鬼相依随。\n慎旃涤厥衷，谁云可射思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21546,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐翼所年伯素履图说十二首 其三 兄弟联登","author":"曹于汴","text":"昔人羡一鹗，况乃双桂芳。\n贺者交于闾，若为共荣光。\n或亦怙其贵，邻里转彷徨。\n徐翁仍往役，吾以酬吾乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21547,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐翼所年伯素履图说十二首 其四 率子瞻天","author":"曹于汴","text":"天远不咫尺，宫阙高嶙峋。\n徘徊耸瞻视，兹地致吾身。\n致身未为报，丁宁启后人。\n而勿忘此日，应更念吾君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21548,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐翼所年伯素履图说十二首 其五 持节平番","author":"曹于汴","text":"曾闻南方强，情与北方异。\n吾不虐其人，渠亦不为祟。\n贪将故生衅，馘杀自网利。\n一札平番书，千里免兵燹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21549,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐翼所年伯素履图说十二首 其六 奉诏抡材","author":"曹于汴","text":"千章出万壑，躬先不畏苦。\n神为画良筹，梦里频开剖。\n人恐遗之累，输金不啻土。\n神人不可格，何不于斯睹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21550,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐翼所年伯素履图说十二首 其七 持衡校士","author":"曹于汴","text":"从昔论事主，以人为上臣。\n一人曾无几，安得百千人。\n若得人千百，便是百千身。\n守蜀蜀人化，兹意良独真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21551,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐翼所年伯素履图说十二首 其八 靖海扬戈","author":"曹于汴","text":"余闻古圣人，出入剑为佩。\n奈何悬蓬矢，慑志黄云塞。\n挥毫睨武夫，武夫歼巨憝。\n扬戈沧海中，不比龊龊态。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21552,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐翼所年伯素履图说十二首 其九 奕世承恩","author":"曹于汴","text":"从昔有事使，从昔有君臣。\n不闻君负臣，惟闻臣负君。\n试睹龙章锡，皇恩被两亲。\n负曝还自暄，何以报王春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21553,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐翼所年伯素履图说十二首 其十 待漏闻胪","author":"曹于汴","text":"余诵闻胪说，林泉见一人。\n有子朝通籍，若翁暮乞身。\n不缘寄寸赤，岂释负千钧。\n侃侃嘱报国，吾亦怵吾神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21554,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐翼所年伯素履图说十二首 其十一 归田课孙","author":"曹于汴","text":"昆弟俱白首，兰桂何翩翩。\n读罢七训语，霞觞欣流传。\n亲亲共长长，风世以家先。\n莫道赋归去，经纶更灿然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21555,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐翼所年伯素履图说十二首 其十二 宾筵介寿","author":"曹于汴","text":"舆人皆曰贤，跻诸鹿鸣席。\n先生曰予眊，检身转惕惕。\n惟其检厥身，兹筵得上客。\n知非不为非，伯玉映今昔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21556,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和冯慕冈年兄五诗 其一 械系吟","author":"曹于汴","text":"臣工壅主泽，万姓苦如焚。\n怨气干天怒，重罚夺良臣。\n譬如家有谴，贤子应邅迍。\n有士颈如雪，一朝系黑组。\n一组活万人，巨珰亦去楚。\n木械更不恶，木械真有灵。\n能令三湘众，滂沱涕泗横。\n能令夏畦子，忸怩颜可憎。\n能令忠烈士，芳名齐岱恒。\n亦或唁其忠，亦或贺其祸。\n烈士意如何，脉脉不可揣。\n引袂时掩饰，吾君那械我。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21557,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和冯慕冈年兄五诗 其二 易帽吟","author":"曹于汴","text":"昔闻头象天，无乃非骨肉。\n我生发未燥，郑重忻修沐。\n郑重固郑重，小帽如冠玉。\n乌纱贵且荣，乃至忘初服。\n我首生于天，可黝亦可华。\n我冠制于君，可帽可乌纱。\n皇恩自浩阔，髡钳不汉家。\n易冠以小帽，不殊纯易麻。\n帽下头颅直，一举戴旻苍。\n上士薄斯语，不冠忧惶惶。\n中士契斯语，不冠乐洋洋。\n下士嗤斯语，不冠胡凉凉。\n相契不相薄，毋宁幸相嗤。\n贤人解其冠，天下无宁时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21558,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和冯慕冈年兄五诗 其三 龙兴寺候逮","author":"曹于汴","text":"缧绁南来若有得，语音充朗貌颜和。\n萧寺候逮四十日，御制披观三两过。\n方窥大道萃皇祖，果觉殷忧增慧多。\n百步衡门亦可入，为彰法纪荅恩波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21559,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和冯慕冈年兄五诗 其四 寄衣","author":"曹于汴","text":"十椽草屋破生尘，户外时闻索债人。\n有妾抱子俱稚齿，阿兄赖嫂绝微颦。\n千里缄衣不堕泪，九秋披葛已忘身。\n珍重针缕莫轻视，病妻凭我且悬鹑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21560,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和冯慕冈年兄五诗 其五 祭皋陶","author":"曹于汴","text":"昔闻尧阶指佞草，想是今时珥笔人。\n慢道草多佞全歇，当应佞夥草不神。\n果如谳狱系皋士，何独悲囚痛夏君。\n安得无佞亦无草，尧皇皋佐乐长春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21561,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题首善书院","author":"曹于汴","text":"维皇建有极，日月丽霄汉。\n借问极云何，至善谁容畔。\n此善来自天，大宝逾琼瓘。\n主之为师模，阐之为性案。\n为之圣者徒，积之庆可断。\n帝京天下首，千方支体贯。\n坦坦王路遵，蒸蒸登于岸。\n明善善以明，洵其乐且衎。\n先觉觉斯民，构馆敩学半。\n将期实行修，宁啻缛文烜。\n登其门崔嵬，升其堂轮奂。\n入其室深幽，敬止何敢玩。\n不学善乃湮，不善世乃乱。\n谁兮匪天民，勿作如是观。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21562,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感怀","author":"曹于汴","text":"喜夷怒则蹠，人蹠我则夷。\n肉糜吾胡饱，羹藜尔岂饥。\n甘可使为苦，妍可使为媸。\n味不主于口，色非目所司。\n有物盘其间，强横踰穷奇。\n变化若牛鬼，播弄如儿嬉。\n突起千寻障，何论目如离。\n能幻舌如马，食蜜胡甘之。\n吾生患此物，敬奏主君知。\n明灯照奥窔，峭壁捍边陲。\n刚刃晃似雪，诛剪靡孑遗。\n口目贺且泣，从前何太痴。\n夷蹠自有真，饥饱莫相岐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21563,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗二十二首 其一","author":"曹于汴","text":"周道榛莽交，凭谁询济渡。\n劳劳古人心，蔬水澹啜餔。\n赤日揭中霄，六宇撤其锢。\n我行不可求，殷勤悲日暮。\n二竖勿相凌，会当振其步。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21564,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗二十二首 其二","author":"曹于汴","text":"昊天制厥命，万类共相俟。\n命之贵绾组，命之贱秉耜。\n命之厌膏粱，命之乏糠秕。\n命之健超乘，命之惫床笫。\n命之为彭叟，命之为殇子。\n命之彝鼎垂，命之秋草萎。\n智人达其窍，素位坦如砥。\n愚蒙罔有窥，营营良苦耳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21565,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗二十二首 其三","author":"曹于汴","text":"柏干何挺挺，藤枝一何柔。\n傲霜秋赏菊，倾阳夏誉榴。\n有赏应有咎，毁誉总堪休。\n谁能代之喜，谁能代之愁。\n旷怀观物理，触景聊优游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21566,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗二十二首 其四","author":"曹于汴","text":"桃花殊绰约，举俗艳其芳。\n弥空连锦幄，落地纷红妆。\n誉口若市沸，恋赏奔如狂。\n孤竹生涧畔，掉臂一何凉。\n为语涧畔竹，韶丽堪相将。\n飞霜千仞壁，聊此共岚光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21567,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗二十二首 其五","author":"曹于汴","text":"好鸟鸣高枝，声如管弦流。\n池水尺有咫，鱼跃何悠悠。\n人生欲无涯，忽忽起蜃楼。\n不见青春子，两鬓倏成秋。\n呼酒酬今日，勿为明朝忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21568,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗二十二首 其六","author":"曹于汴","text":"少年种多疚，中岁相侵寻。\n病久更惜日，观时感慨深。\n感慨千里外，杳杳怀同心。\n奋袂欲策蹇，乘风凌高岑。\n望望不可即，潸然涕沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21569,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗二十二首 其七","author":"曹于汴","text":"草根共木皮，藉以延岁年。\n疢疾应由我，修短固在天。\n便欲御风去，其如至情牵。\n留往总不易，寒风凄枕边。\n韦编苦难读，平生愧众愆。\n且乘尚健日，问膳高堂前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21570,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗二十二首 其八","author":"曹于汴","text":"瓶罂罕储粟，谬怀挥千金。\n蓬门有贫客，原田乏澍霖。\n带钩固无几，解以酬知音。\n秋气正萧瑟，勿厌杯中斟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21571,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗二十二首 其九","author":"曹于汴","text":"秋日犹溽暑，秋风亦已凉。\n披襟南轩下，无语叹流光。\n暑馀岂遽谢，凉至时则当。\n时乎天弗违，人生胡徬徨。\n螗蝉当此日，深树噪夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21572,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗二十二首 其十","author":"曹于汴","text":"中宵忘在病，披衣睇月辉。\n铮铮匣中铁，寒光交青帏。\n鲸鲵百丈强，盍往奋一挥。\n否否且宁卧，意广百年微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21573,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗二十二首 其十一","author":"曹于汴","text":"昨晨一齿落，今晨目茫茫。\n两体似共期，衰岁行相将。\n胡不当壮盛，勉学如不遑。\n此君否大嚼，落齿应未妨。\n目茫阻诵读，何以睹虞唐。\n世态多变幻，崎岖繁眦眶。\n便可昏昏然，且免窥雌黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21574,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗二十二首 其十二","author":"曹于汴","text":"有斐谁氏子，楚楚青春姿。\n藐藐予云圣，施施我既知。\n日入坐叹息，支言良自嗤。\n世季匪旦暮，皇皇乎何为。\n三秋月中桂，一芥尘上枝。\n生民天未厌，会当惬所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21575,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗二十二首 其十三","author":"曹于汴","text":"追日毙于渴，说难亦已沦。\n事有不可为，三闾悴江滨。\n善哉陶靖节，漉酒以葛巾。\n茅檐坐扪，澄怀赖昔人。\n达士临川上，流坎良循循。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21576,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗二十二首 其十四","author":"曹于汴","text":"黄金辞暮夜，关西畏四知。\n清节励严霜，芳名千古垂。\n家人共冰檗，欢诃今莫知。\n亦闻薛夫子，出都杖其儿。\n二家秉峻德，遐风念在兹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21577,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗二十二首 其十五","author":"曹于汴","text":"苏卿处漠北，突厥为比邻。\n毡雪为食饮，不忘君亲伦。\n晨起整衣冠，仁礼向具陈。\n初陈嬉以讶，再陈怒以嗔。\n侏㒧生相习，华言袖不闻。\n吁尔焉用道，物生固难均。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21578,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗二十二首 其十六","author":"曹于汴","text":"骨骸植丘山，对面燕楚异。\n赤心赤逾日，谁剖谁以视。\n纵令枯其舌，如簧应不翅。\n所以抱心人，幽怀付掬泪。\n吾师固有言，当是诚未至。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21579,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗二十二首 其十七","author":"曹于汴","text":"孔方何丑类，昔人誉为兄。\n或亦名之奴，差似称厥情。\n仍为奴中贼，残狡恣纵横。\n渠能离至戚，因之失良朋。\n渠去凋人颜，渠来躁人膺。\n内险藏岩谷，外狞耸刀兵。\n幻忽安可诘，举世堕其坑。\n便移绝交檄，勿致扰吾庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21580,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗二十二首 其十八","author":"曹于汴","text":"平生不了事，凭此数行书。\n抱病逾一载，方寸成荒墟。\n短檠未能亲，药饵时则茹。\n解组归田里，所怀宁此知。\n厥虑匪朝暮，那不惜居诸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21581,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗二十二首 其十九","author":"曹于汴","text":"大事如小事，有事如无事。\n神閒气自融，华岳土垤峙。\n万类穹窿间，太空只如是。\n因物付以物，天下本无事。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21582,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]