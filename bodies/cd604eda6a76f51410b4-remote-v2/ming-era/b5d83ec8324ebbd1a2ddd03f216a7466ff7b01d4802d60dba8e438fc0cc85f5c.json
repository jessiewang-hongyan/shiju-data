[{"title":"晓枕作","author":"吴与弼","text":"穷通夭寿宁非命，消息盈虚自是天。\n试咏黄流歌玉瓒，谆谆笺注慨前贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10012,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"饶烈使问讯日暮途遥旅宿无衾恻然成诗","author":"吴与弼","text":"暝色驰驱山正深，投装安问有无衾。\n解衣虽荷主人眷，宁慰风霜永夜心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10013,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"独坐偶成","author":"吴与弼","text":"为已工夫何处寻，须知至要在于今。\n它山之石能攻玉，宁问阳舒阴惨心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10014,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自警","author":"吴与弼","text":"日日寒檐读我书，观生愈似挂钩鱼。\n人情固莫分轻重，事体焉能知卷舒。\n百行自应诚是本，一身端合道为枢。\n圣贤龟鉴昭昭在，争奈灵台不易虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10015,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"阅去年日录簿此日寓娄谅氏怅然成诗","author":"吴与弼","text":"去年今日正阳生，觅句论文暂鲤庭。\n北雁不来西梦切，杖藜何处问君平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10016,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠程李二友","author":"吴与弼","text":"又报冲泥二妙来，远传天使意悠哉。\n寒炉拥罢霜檐立，明月清风共此怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10017,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题谭大参庆寿堂","author":"吴与弼","text":"北阙恩波浸正深，南山瑞气福骈临。\n奎光明月春盈卷，总是莱衣爱日心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10018,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉题程佥宪清风亭","author":"吴与弼","text":"世间何沴善侵陵，强者谁欤抗郁蒸。\n万姓低垂炎海里，洒然天表见斯亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10019,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"新正重沐县侯贲临茅舍敬裁二十八字充一笑耳","author":"吴与弼","text":"误辱明时降玉音，贤劳吾宰岁寒心。\n前溪遇雨春流驶，试问恩波深几深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10020,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠太守林侯","author":"吴与弼","text":"匪才焉敢厕儒流，光宠频烦误我侯。\n从昔斗筲何足算，愿均慈造遍林丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10021,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"迎恩桥诗","author":"吴与弼","text":"青石流传亦有年，迎恩于此庆尧天。\n山呼北阙晴云表，玉烛祥光正煜然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10022,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"皇华亭","author":"吴与弼","text":"皇华胜岭旧名神，使节遥临雨露新。\n草木从今皆可敬，一亭晴映万山春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10023,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"天使亭诗","author":"吴与弼","text":"伊昔奇尖号聂家，名峰今喜属皇华。\n谁人领得峰头趣，舜日霓旌拂晓霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10024,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"集庆亭","author":"吴与弼","text":"拜罢天书使节归，徽音暂此驻旌麾。\n闾阎荷庆何多也，共仰文光焕璧奎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10025,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"綵云亭","author":"吴与弼","text":"旌旆腾辉鼓吹雄，青山尽属綵云红。\n群黎奔走矜奇遇，满路讴歌日正中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10026,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉陪天使重游皇华亭","author":"吴与弼","text":"前日风云拥护多，兹晨气色倍清和。\n遥空一瞩春无涘，共听重歌胜岭歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10027,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"天使临胡氏族谱亭喜添胜迹诗以纪焉","author":"吴与弼","text":"华亭雄构野塘滨，天秩昭昭笃大伦。\n品汇一经时雨化，山川出色境增新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10028,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"天使游山归旌旆暂停戴禄氏","author":"吴与弼","text":"喧天笳鼓踏新晴，踏遍春山几处亭。\n旌节暂停归兴好，梅花溪上问诸生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10029,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"天使归五峰綵旗联句","author":"吴与弼","text":"纶綍夙传丹阙表，旌麾遥贲翠微中。\n四民瞻仰乾坤大，万灶歌谣雨露浓。\n竞托皇华人似玉，顿令白屋气如虹。\n祖筵箫鼓腾三市，驿道风云壮五峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10030,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"徐廖二友承天使命来","author":"吴与弼","text":"车舆灯火递相哗，互认前村处士家。\n款款细传天使语，春风早约上京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10031,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题饶氏祖德亭","author":"吴与弼","text":"男儿能不负儒冠，赢得功名万古看。\n几度怀人吟不寐，梅梢残月五更寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10032,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"棠溪道中","author":"吴与弼","text":"细雨新泥江路长，忙冲暝色急投装。\n笋舆非忍长须困，争奈先茔不敢忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10033,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南原道中","author":"吴与弼","text":"茅屋石桥西，行行日未低。\n地名时问讯，春兴入新题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10034,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吕中良引拜罗源冈李氏夫人墓","author":"吴与弼","text":"马鬣巍巍久已平，状元空忆旧时名。\n若无故老慇勤意，徒有慈孙缱绻情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10035,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"葛藤科先陇","author":"吴与弼","text":"蓬科不见当时葛，马鬣犹传旧日名。\n星火程期京国梦，春风花柳故乡情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10036,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"经方升氏","author":"吴与弼","text":"难兄客邸共乡心，令弟高居辱爱深。\n问讯若逢南雁使，春风早寄白头吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10037,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠石井黄徐二生","author":"吴与弼","text":"爱尔黄徐二秀才，重逢故意倍悠哉。\n他日松楸劳梦寐，频期鱼雁到金台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10038,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"天使曹侯枉顾金石台","author":"吴与弼","text":"一上名台百虑消，况承使节在青霄。\n黄徐预拟忘忧物，程李同歌击壤谣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10039,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"罗原冈诗","author":"吴与弼","text":"冷派衰宗各渺茫，荒山寒溆久凄凉。\n东风为我回春色，衣被罗原几处冈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10040,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠廖良斋崇杰行人归乐安","author":"吴与弼","text":"马嘶芳草正清明，高下风花远近亭。\n他日金台谈旧雨，青山总是故乡情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10041,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠鳌溪茂宰林侯","author":"吴与弼","text":"秋月窗前天似水，春花县里日如年。\n民谣若达观风使，处处流传茂宰贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10042,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄张璧","author":"吴与弼","text":"双冢遥依凤水傍，朝烟暮霭久荒凉。\n维持曾荷尊公爱，重喜如今得令郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10043,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次白旰李大章赠行韵","author":"吴与弼","text":"髣髴当年暂接颜，忽勤缟纻辱柴关。\n何曾实行出人上，空惹虚名在世间。\n樗散岂宜私雨露，驽慵只合老云山。\n误蒙明诏乘春去，嫩蕊浓花满目斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10044,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同程庸诸生游集庆亭","author":"吴与弼","text":"皇华岭畔又奇峰，峰上新亭结构雄。\n亭子主人良得意，来游多侣共春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10045,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"承判簿戴侯掌教陈君下顾","author":"吴与弼","text":"联辔儒冠顾匪才，春风揖别话金台。\n残书数卷青山曲，满赖馀光烛草莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10046,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"承天使遣胥余二生枉顾茅舍","author":"吴与弼","text":"暂坐清溪畅病身，又瞻联辔两儒绅。\n行装自促无劳迓，定在旬馀蹑后尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10047,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉别乡邻亲友","author":"吴与弼","text":"流传遐迩尽虚声，君子从来耻过情。\n惜别误蒙乡里敬，匪才何以答升平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10048,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠李晏诸生","author":"吴与弼","text":"我承明诏远观光，付尔琴书与雪窗。\n好笃男儿灯火志，莫随浮俗一般忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10049,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"外孙瑞康索诗","author":"吴与弼","text":"明日朝天去，今宵索我诗。\n莫添离别感，喜有盍簪期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10050,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西津舟中口占授同宿诸生","author":"吴与弼","text":"停舟西日四三生，共宿津头风雨情。\n须信万缘皆有命，肯将行止问君平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10051,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"发张家石","author":"吴与弼","text":"黄昏西北浮云敛，清晓东南霁月明。\n红日满窗春睡稳，拍天新涨棹歌声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10052,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"贵溪道中","author":"吴与弼","text":"懒慢宜閒不得閒，衰龄却事道途间。\n晓程匆遽严牵路，昼梦依稀在故山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10053,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉寄临川傅贰令","author":"吴与弼","text":"令闻宜民夙所钦，琅玕欲报愧微吟。\n更烦细问南来雁，日夜天涯念万金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10054,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"周文娄谅徐綖棹舟远迓","author":"吴与弼","text":"暂亲铅椠向清流，忽遇波心荡漾舟。\n老去久于浮世淡，重逢端似梦相求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10055,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草萍驿","author":"吴与弼","text":"暂息草萍驿，心安即我庐。\n万山新雨霁，半枕黑甜馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10056,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白石铺道中","author":"吴与弼","text":"早稻青青小麦黄，杜鹃声里野花香。\n好山递送程程秀，咫尺云帆是浙江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10057,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄龙游洪茂宰","author":"吴与弼","text":"沙头倾盖重青年，别后重歆单父贤。\n好看岁寒冰雪表，管教松柏转巍然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10058,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠梁布政","author":"吴与弼","text":"曾陪崇礼少年游，一隔江湖五十秋。\n碌碌那堪今日会，空怜岁月白人头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10059,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄严州刘太守","author":"吴与弼","text":"我爱霜松托趣深，慇勤特表岁寒心。\n当年缟纻休相讶，遥寄新诗咏断金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10060,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠伍御史","author":"吴与弼","text":"与君共饮西江水，却向钱塘话旧乡。\n拙笔漫持虽偶尔，男儿从古贵流芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10061,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"王宪副顺德堂","author":"吴与弼","text":"钱塘江上接珠玑，顾我何堪顺德题。\n思遍古人无健笔，断云残照画桥西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10062,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杨太守雪艇","author":"吴与弼","text":"一艇寒凝雪满窗，棹歌声里铁为肠。\n把君诗卷摩挲久，人在冰壶月似霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10063,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次杨太守见赠韵","author":"吴与弼","text":"承家曾读鲁春秋，多病因循漫白头。\n野性只应木石侣，道心深愧圣贤俦。\n万缘久分同春梦，束帛何期贲晚丘。\n画舫滥为偕计客，偶陪高兴一登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10064,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠毕王二进士","author":"吴与弼","text":"丹桂亭亭两妙龄，相逢江上话诗情。\n冰霜自是男儿志，稳步青云万里程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10065,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"姑苏驿馆即事","author":"吴与弼","text":"尊酒为欢偶共斟，江清地迥夜沈沈。\n感君流水高山意，畅我光风霁月心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10066,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"桐乡舟中","author":"吴与弼","text":"两日劳劳昼梦长，斜风细雨度桐乡。\n卧薪自是男儿志，何事寥寥数越王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10067,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠郑御史","author":"吴与弼","text":"江上相逢话旧知，姻门兰雪共心期。\n行春大展经纶手，碌碌何烦索小诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10068,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陆主事紫微庵先陇所在","author":"吴与弼","text":"一庵遥托紫微坡，马鬣巍巍事若何。\n惆怅孝思维则处，始终名教为君歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10069,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"皇华馆即事","author":"吴与弼","text":"沈沈台馆绿阴浓，一榻高眠咏午风。\n时止时行皆乐地，梦魂依旧白云中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10070,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陆大参宅","author":"吴与弼","text":"成均高谊古人俦，江右仁风播更优。\n今日德门恭一拜，白云埋玉几春秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10071,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"浒墅铺舟中","author":"吴与弼","text":"一席中流快好风，平畴时喜看吴农。\n推篷细话园林趣，总在乾坤生意中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10072,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白鹤溪铺舟中","author":"吴与弼","text":"我爱佳名白鹤溪，客情舒处又题诗。\n分明画得无怀世，杨柳家家卖酒旗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10073,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次罗宪副见赠韵","author":"吴与弼","text":"蹉跎夙志久随流，到处逢人愧白头。\n滥奉天书趋魏阙，猥蒙春酒醉常州。\n圣门道远良难进，贤辙风高不易俦。\n安得鲁戈回白日，重将旧业共君修。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10074,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"邗城","author":"吴与弼","text":"丹阳古渡接瓜洲，万顷黄云麦正秋。\n一榻午风清梦觉，又题新句过扬州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10075,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"高邮湖","author":"吴与弼","text":"图经旋展认邗州，童稚传闻老始游。\n一曲倚楼怀古调，烟空漠漠水悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10076,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"渡黄河次唐人昨夜微霜初渡河韵","author":"吴与弼","text":"平生踪迹半樵歌，岁晚昏眸始识河。\n名姓误叨天上荐，琴书端似梦中过。\n洲连碧水浮埃少，席满薰风逸兴多。\n却忆青山同学侣，可胜名教两蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10077,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆家","author":"吴与弼","text":"独吟沂泗向黄昏，漠漠云天远近村。\n前月小陂今夜思，细分诗帖与诸孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10078,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杜主事荣寿堂","author":"吴与弼","text":"堂上严亲八十强，天恩厚处锦袍香。\n多才令子方腾踏，百福如川日正长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10079,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"徐州","author":"吴与弼","text":"前月兹晨别小陂，通宵风雨泊西陲。\n看山问水何乡客，帆指彭城薄暮时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10080,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠宋知州","author":"吴与弼","text":"沙头载酒话蕲州，胜水名亭怅旧游。\n闻道彭城多善政，盘根正属有为秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10081,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"即事","author":"吴与弼","text":"一湾未尽一湾连，处处垂杨荫道边。\n高缆势宽夫力缓，行行喜带夕风牵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10082,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"王锦衣望云思亲诗卷","author":"吴与弼","text":"使节驰驱南复南，高堂华发梦毵毵。\n一杯春酒归心切，指日云边落锦帆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10083,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"曹天使重庆堂","author":"吴与弼","text":"馀庆重重见老莱，斑衣华发映春罍。\n青山门巷时时扫，待领天边紫诰回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10084,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"平野望邹鲁次少陵韵","author":"吴与弼","text":"古意千秋上，孤踪九夏初。\n高山方仰鲁，洪道已过徐。\n慈教三迁外，雄韬百战馀。\n堪舆频怅望，风日共踌蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10085,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"望鲁山","author":"吴与弼","text":"闸水仍相阻，河堧又独行。\n兹山含万态，于我故多情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10086,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梦家","author":"吴与弼","text":"百体衰慵两眼花，云山久已隔纷华。\n宵来鲁水桥边榻，一片离魂只在家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10087,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"济宁道中","author":"吴与弼","text":"一逢胜地忆平江，缘道薰风满绿杨。\n岂独阴凉人共惜，助予诗兴更无疆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10088,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"济宁南城驿","author":"吴与弼","text":"庭树阴阴转嫩凉，琴书喜博济宁航。\n短歌不尽悠悠兴，泰岳峰前送夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10089,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]