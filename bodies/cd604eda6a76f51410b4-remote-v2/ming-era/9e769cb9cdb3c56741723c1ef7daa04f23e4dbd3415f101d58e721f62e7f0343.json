[{"title":"榕间即事","author":"林大钦","text":"高榕长寂寞，幽竹自青青。\n閒卧观物化，冥思会性灵。\n浮光速流电，身世一浮萍。\n悠然清轩暮，步履出林坰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3340,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贫居","author":"林大钦","text":"贫居依谷口，灌木赖幽清。\n欲往风云会，其如泉石情。\n日明花自媚，山寂鸟还鸣。\n寥寥烟波外，悠然慰此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3341,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吾门","author":"林大钦","text":"吾门客不到，永日坐萧疏。\n花拂琴书色，风清枕簟馀。\n观心知世妄，省朴解予初。\n芜蔓从榛草，幽偏炯自如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3342,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"幽情","author":"林大钦","text":"白日卧慵稳，幽人自有群。\n从容问鱼鹤，洒豁观图文。\n木食随仙子，霓衣驾五云。\n坐观城市者，车马滋纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3343,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨","author":"林大钦","text":"高堂风雨过，五月疑清秋。\n独坐清尘垢，冥心散远愁。\n利名今寂寞，出处若虚舟。\n杳然迷所虑，天地一云浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3344,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"积雨","author":"林大钦","text":"积雨昏林畔，庭前咫尺迷。\n叶心愁朱实，佳赏叹揆携。\n羽雀追飞尽，回烟拂树低。\n何当凌白日，杖履过东畦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3345,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"幽意","author":"林大钦","text":"五月荷花雨，阴晴屡不分。\n苔容常带润，山意欲垂云。\n日滉楼台侧，风蒸草木薰。\n幽情恋萝石，鸥鸟可为群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3346,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高楼乍晴","author":"林大钦","text":"风吹浮云流，雨晴荷花秋。\n烟容开野望，佳气绕台浮。\n翠柏凉可食，閒情迥不愁。\n明发怀幽兴，还为招隐游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3347,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观荷","author":"林大钦","text":"爱尔炎阳日，偏开烂熳花。\n通枝扶水萼，翠盖驻流霞。\n净拂丹心破，清添松子家。\n临风泛薰酌，暂此惜留华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3348,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日雷雨","author":"林大钦","text":"白日轻雷迥，风林当昼吹。\n二仪消炎伏，一雨到云涯。\n水色光虚滉，烟堂花暮思。\n净心澄物役，聊此寄卑栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3349,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"避暑","author":"林大钦","text":"避暑仍兹地，薰风吹我襟。\n和光随鸟性，萧寂旷云林。\n道虑谢欣戚，达思齐古今。\n逍遥对萝薜，永矣解余簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3350,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"堂上见流云郁兀峰峦特绝自昔奇观也","author":"林大钦","text":"流云今出没，绿浦动清歌。\n秀色连天表，清晖奈若何。\n南薰吹短袖，白水增澜波。\n向夕岚烟起，连山郁嵯峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3351,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏园对月","author":"林大钦","text":"白露团新月，清晖照北林。\n检诗宜寂静，在野兴萧森。\n入蔓光难整，移云影未侵。\n篱芳兼瑟历，徙履更追寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3352,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏园即事四首 其一","author":"林大钦","text":"兹辰苦烦燠，复此款芳园。\n翠竹通云过，朱枝落果繁。\n静偏堪避俗，疏爽未闻喧。\n绕屋畦蔬满，栖迟慰夕餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3353,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏园即事四首 其二","author":"林大钦","text":"荒园带乔木，疏篱古蔓悬。\n地幽忘客会，兴远步炎天。\n散业琴书偃，裁酒竹叶传。\n不妨人意迫，随处到真玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3354,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏园即事四首 其三","author":"林大钦","text":"吾生何倚着，雅欲逃自然。\n况此炎阳会，萧疏水木天。\n步草风吹面，抛书竹共眠。\n未应频悔吝，早已慰幽全。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3355,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏园即事四首 其四","author":"林大钦","text":"炎暑惟兹夏，三旬将欲移。\n芳树射明灭，青云静逶迤。\n晴光迟夕照，风鸟会清思。\n慷慨伤神寂，泉林慰渴饥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3356,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"见萤","author":"林大钦","text":"草根明不定，星夕故飞飞。\n乍点琴书色，时傍竹木微。\n匡帷传胜事，吾幌赖多辉。\n可怜清霜夜，飘零何处归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3357,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻蝉","author":"林大钦","text":"晴蝉号玄叶，已动凉秋悲。\n响入云俱迥，风回声故迟。\n抱贞依露食，远害卜高枝。\n羡尔孤清意，夷犹空暮思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3358,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒适","author":"林大钦","text":"多病惭冠绂，归休步紫苔。\n野堂人事少，秋色雁边回。\n采药情偏逸，吟诗兴未摧。\n却恋云萝月，清夕照徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3359,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜雨","author":"林大钦","text":"夜雨鸣不止，端居苦沉沉。\n风寂秋灯静，气溟烟堂深。\n天地思寥落，诗书静可寻。\n漂零随生理，无闷到于今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3360,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新霁","author":"林大钦","text":"原野新晴绿，乾坤一望遥。\n断烟依碧水，列岫上青霄。\n鱼鸟从相得，濠梁谁见招。\n平生怀幽兴，临眺独长谣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3361,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夕怀","author":"林大钦","text":"白日原上没，芳草夕离离。\n惜此浮云滋，空馀千古思。\n冥心托松石，幻迹谢人为。\n未因飞锡去，长与鹿门期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3362,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀二首 其一","author":"林大钦","text":"勋庸乖昔愿，飞锡邈难期。\n偃卧青山晚，沉吟白雪词。\n人事嗟沦易，雄图空尔为。\n还将迟暮意，聊自慰兴衰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3363,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀二首 其二","author":"林大钦","text":"世事转漂泊，吾道自萧疏。\n长揖车马会，来与烟萝居。\n赏心散逸帙，玄识迥清虚。\n因得无生趣，长以慰舒徐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3364,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋霖","author":"林大钦","text":"幽霖苦不彻，杲日苍云愁。\n积水迷寒草，残烟带夕流。\n游鱼翻底浪，征鹤度莎洲。\n怅望虚斋里，閒讴惜素秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3365,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居","author":"林大钦","text":"林园滋幽独，横经幸不违。\n碧草怜秋萎，青山尚鸟归。\n景寂绝繁乱，人閒无是非。\n吾志在寥廓，于此聊忘机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3366,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋斋閒眺","author":"林大钦","text":"碧草清秋丽，斋居思渺然。\n远山催落日，白水净寒天。\n故国风烟满，荒原独鹤还。\n何当凌倒影，飞锡问真玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3367,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钓歌二首 其一","author":"林大钦","text":"壮心久零落，捆屦傲江津。\n丘壑撄怀满，乾坤独眼真。\n垂纶消白日，倚杖看风晨。\n不阻蓬荜兴，时从畎亩民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3368,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钓歌二首 其二","author":"林大钦","text":"散地宜高枕，生涯又素秋。\n高情属云日，浪迹轻王侯。\n徙履堪人并，餐霞祇自由。\n絺衣挂萝薜，还钓水西头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3369,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"塘上二首 其一","author":"林大钦","text":"古木萧疏地，苍黄日雾时。\n秋风吹锦水，可以荡人思。\n远看飞云势，低吟组织诗。\n素心固如此，吾道竟何之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3370,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"塘上二首 其二","author":"林大钦","text":"青田望不极，野水夕离离。\n落日诸山暮，归禽独树枝。\n高吟宜野静，杖屦失秋悲。\n自觉尘机少，幽行步每迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3371,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋望","author":"林大钦","text":"清秋时极目，世情今已閒。\n海阔浮云远，天空独鸟还。\n寒流明野际，落日半幽山。\n于兹任吾惬，萧散风烟间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3372,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"楼中夕思","author":"林大钦","text":"避俗时观眺，登高复此楼。\n山连越隽尽，海接风云秋。\n石室留丹诀，仙槎泛碧流。\n童颜如可驻，应与葛公游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3373,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"不寐","author":"林大钦","text":"中宵思寂寞，苦被秋蛩鸣。\n星临万户动，月傍九霄清。\n天地容吾拙，云山此夜情。\n松筠归卧处，萧瑟养残生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3374,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜思","author":"林大钦","text":"凉园依蔓草，零露惜秋情。\n行藏千古思，天地一身轻。\n月出云间静，风来松上清。\n虚怀澄物滓，于此正无营。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3375,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步月二首 其一","author":"林大钦","text":"今夜清秋月，分明照羽毫。\n旷野怜人少，列宿共天高。\n影落风枝乱，光飘星海涛。\n瞻依倚北斗，直欲舞潇骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3376,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步月二首 其二","author":"林大钦","text":"夜气泛虚爽，中天月白迟。\n云岩风桂落，林表露华滋。\n独赏通玄理，高歌慰素思。\n本无身外虑，清夕每相随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3377,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋夜月","author":"林大钦","text":"明月度中天，流光正回萦。\n可怜一片影，共此万方情。\n随风吹永夜，并露滴孤清。\n牛女云河外，何曾波浪生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3378,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"楼中对月","author":"林大钦","text":"中夜虚天静，巍栖月迥明。\n乾坤独老眼，时序故山情。\n度汉光难灭，兼星照愈清。\n万方分气象，伏枕看流萤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3379,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"有思","author":"林大钦","text":"河清不可俟，天命信难期。\n不涉沧江路，空吟采蕨诗。\n白露依时落，蒹葭仍在斯。\n秋水依稀在，茫然有所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3380,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除棘","author":"林大钦","text":"怪尔何延蔓，高秋未觉衰。\n自施锄艾力，会见根株移。\n宁使芝兰长，毋令荆棘滋。\n剪棘如弗力，芝兰常为欺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3381,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜","author":"林大钦","text":"寥落寒空暮，凄其叹索居。\n银汉光脩草，星辰动夜虚。\n萤辉明水次，秋唧薄阶除。\n多少残生思，空催清夜徂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3382,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居遣怀三首 其一","author":"林大钦","text":"野外遂生理，支离准自休。\n三时长病懒，一月解梳头。\n把钓供幽事，看花复素秋。\n杖藜从白首，身世两无尤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3383,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居遣怀三首 其二","author":"林大钦","text":"短景难幽卧，秋风差自强。\n村幽宜杖履，岁暮识行藏。\n农父秫粱秀，园家橘柚香。\n蹉跎依物色，纵谑向穹荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3384,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居遣怀三首 其三","author":"林大钦","text":"久爱吾庐好，柴门少树遮。\n浮云悲世事，流水惜生涯。\n有兴寻亲侣，尝新剥枣瓜。\n静喧翻自乐，衰劣岂吾嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3385,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"披籍","author":"林大钦","text":"萝苔协素尚，云籍展清幽。\n激发兴亡事，萧条古今愁。\n华名终寂寞，出处任虚舟。\n信步生涯晚，吾行何所求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3386,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚望二首 其一","author":"林大钦","text":"白屋临秋水，幽期可奈何。\n坐观凫鸭乱，远眺风云多。\n荒树连斜日，寒烟落晚波。\n于兹伤寥寂，浩荡一高歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3387,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚望二首 其二","author":"林大钦","text":"极目杳无际，连山接素秋。\n云迷粤岭树，日涌大荒流。\n饥雀喧枯木，寒乌薄晚楼。\n仍馀今古思，萧索增暮愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3388,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对菊二首 其一","author":"林大钦","text":"秋菊有佳色，盘根手自栽。\n兴与佳宾发，尊对艳花开。\n天地生奇质，山林老此才。\n九月清霜下，中逵蕙草摧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3389,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对菊二首 其二","author":"林大钦","text":"种菊黄花满，纵横野兴多。\n生涯随杯酒，风景自山河。\n静后天机透，吟馀秋色过。\n衣冠惭世会，清寂慰蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3390,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日","author":"林大钦","text":"今日云景好，高斋空复情。\n开尊延夕景，搴菊泛流英。\n地与陶潜迥，思同谢脁清。\n长歌待松月，曲尽亦何营。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3391,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宴集","author":"林大钦","text":"沉冥俗所捐，岁月寄秋山。\n亲侣时萍集，壶觞引兴间。\n看云未碍远，看月不须攀。\n扰扰风尘际，谁开芳夕颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3392,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒云","author":"林大钦","text":"摇落秋将晚，寒园菊尚花。\n天风吹断柳，旭日霁清沙。\n故国高云气，烟堂暮景斜。\n谁能更拘束，啸豁是真涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3393,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋暮书怀四首 其一","author":"林大钦","text":"秋风吹古道，行旅渐疏稀。\n天地故人少，江山独鸟归。\n清同沧海客，静傍竹林微。\n吾爱茹芝老，时清犹息机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3394,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋暮书怀四首 其二","author":"林大钦","text":"清溪修竹里，隐者自盘还。\n须发明云日，衣裳照薜山。\n地幽人眺静，天杳鹭飞閒。\n早晚相将意，乾坤一寄间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3395,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋暮书怀四首 其三","author":"林大钦","text":"白露滴秋月，壮心悲暮年。\n思深云没地，醉舞菊花天。\n短鬓吹霜入，寒轩索雾眠。\n蹉跎聊自哂，容易岁时迁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3396,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋暮书怀四首 其四","author":"林大钦","text":"摇落残秋地，乾坤一散人。\n蓬门稀过客，胜日谩垂纶。\n尊酒琴书并，弦歌卜筑真。\n浩思齐云月，啸谑羲皇春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3397,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"啸歌","author":"林大钦","text":"青山谁与语，白云空婆娑。\n壮心徒激烈，岁暮将若何。\n三杯起高咏，一啸净秋波。\n纵横何足道，意气郁嵯峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3398,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮斋独步","author":"林大钦","text":"山轩来晚照，落叶益纷纷。\n古径行人少，荒斋归鸟闻。\n寒云依渚静，绿水向田分。\n独步兹何缓，萧骚意不群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3399,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬原眺望","author":"林大钦","text":"极目清烦垢，荒原古迹馀。\n地形连海尽，天影落江虚。\n旧赏人频隔，新游乐未疏。\n良辰多感慨，临眺一踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3400,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月庭","author":"林大钦","text":"虚庭纷凉白，中天夜寂寥。\n星河高不动，风月自清宵。\n天地岂予独，知音谁见招。\n冥心祈有合，怅望空云霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3401,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮","author":"林大钦","text":"抚几千山暮，凉轩独夜情。\n净心澄物役，了性到无生。\n寂寂林云满，悠悠花露清。\n平生用幽意，非爱百年名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3402,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬斋遣兴四首 其一","author":"林大钦","text":"雪苑开三径，閒情搆一居。\n地幽人卧稳，天迥月明疏。\n种读移生纪，樵歌会起予。\n时闻好事者，载酒及吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3403,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬斋遣兴四首 其二","author":"林大钦","text":"绝迹幽栖境，南涯水气中。\n松萝蟠日月，花鸟杂春冬。\n道为今名隐，情应古者同。\n蒿蓬何必问，于此拟仙踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3404,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬斋遣兴四首 其三","author":"林大钦","text":"自厌尘嚣杂，悠然坐碧林。\n谈玄归造化，守黑慰初襟。\n日月飘零疾，云山芜没深。\n知音倘有会，应许抚瑶琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3405,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬斋遣兴四首 其四","author":"林大钦","text":"幽居虽寂寞，浩思动乾坤。\n日月风烟积，山林典象存。\n冥搜穷物极，达识探天根。\n慷慨高歌里，谁能测至言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3406,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"生日","author":"林大钦","text":"经济惭长策，归山有敝庐。\n思随鱼鸟幻，道想羲唐初。\n身世同漂泊，渔耕慰寂居。\n桃源如可问，于此定何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3407,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放歌","author":"林大钦","text":"道人颜色好，称是汉时民。\n不逐龙虎斗，空随麋鹿春。\n浩歌移嵩岳，意气凌衣巾。\n轩荣何足语，高节滋嶙峋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3408,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白云","author":"林大钦","text":"白云南山来，天际自捲舒。\n寥落今何事，对此心益虚。\n浪迹羲皇后，纵意无怀初。\n惟应洗心者，绝迹会真予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3409,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"好古","author":"林大钦","text":"好古甘寥落，嗜静无冬春。\n诗书侵雪幌，霄汉洒风神。\n白发催年老，青阳革岁新。\n从今幽卧稳，天地惜烟尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3410,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]