[{"title":"庆宣和 其四 行住坐卧卷","author":"程敏政","text":"五更风雪候趋朝。\n玉漏迢迢。\n纸窗明月上梅梢。\n睡著。\n睡著。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47236,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"人月圆 为人寄寿钱塘王嘉瑞 故孔目天与之孙","author":"程敏政","text":"钱塘江绕吴山翠，相望隔天涯。\n镇海奇观，泛浙佳兴，尽属谁家。\n闻说王郎，翰林孙子，四十年华。\n遥想同人，一回相寿，几醉流霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47237,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孙启风竹为师鲁题","author":"程敏政","text":"孙郎写竹有天趣，落笔萧萧一两枝。\n六月相看北窗下，满身毛骨动凉飔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47238,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"讷轩为富溪宗人道宣赋","author":"程敏政","text":"白圭重三复，金人亦三缄。\n如何啬夫辈，利口矜詀諵。\n多君素淳朴，玉立青巉巉。\n以讷署斋扁，岂为忧讥谗。\n非法炳明训，琅琅若英咸。\n慎哉一言出，谨尔六辔衔。\n进德匪自此，云胡分圣凡。\n轩居北山下，天籁多风杉。\n安得寡尤者，为子铭高岩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47239,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和答吉安顾天锡太守同年","author":"程敏政","text":"篱菊新黄百草枯，天涯相忆共朝晡。\n一缄秀句题钤阁，千里虹光射镜湖。\n致主有才淹老守，全身无策笑庸夫。\n喜闻述职行将近，几日风帆过直沽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47240,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪后至南山精舍","author":"程敏政","text":"为贪奇赏到山斋，玉树琪花拥断崖。\n瀹茗半宵勤瓦鼎，采梅今日试芒鞋。\n来年沃衍占丰岁，尘土清空惬素怀。\n白战旧盟谁愿续，一尊同此系诗牌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47241,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"一剪梅 庆郑君存良七十寿","author":"程敏政","text":"乔木江村映锦沙。\n尚义人家，积善生涯。\n画堂开宴鼓频挝，砌拥兰芽，鬓点霜华。\n辉辉晴日上檐牙。\n词吐天葩，酒泛流霞。\n百年冰玉两无瑕，醉眼生花，仙枣如瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47242,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月波楼为吴孟实题","author":"程敏政","text":"遥天无片云，溪水荫清樾。\n谁开溪上楼，早见溪上月。\n恍然冰壶中，涌此烂银阙。\n主人时独来，水鸟声乍歇。\n橘林晚霜过，荷沜微风发。\n晴峰远相带，隐隐青一发。\n水天荡无垠，斗柄正高揭。\n凭阑击唾壶，神爽已飞越。\n我欲往从之，乘夜泛渔筏。\n一笑捲疏帘，促席共薇蕨。\n酒力清易醒，诗怀浩难竭。\n入眼竹洲寒，何时解尘袜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47243,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"椿萱图为祁门方锲赋","author":"程敏政","text":"堂前椿树盘根久，千岁常期大人寿。\n春风蝶梦早匆匆，一事无凭漆园叟。\n堂北紫萱娱白头，对花日日思忘忧。\n宜男已壮母何在，赢得临风双泪流。\n方家郎君湖海客，春雨秋霜心恻恻。\n凭谁貌入丹青中，犹似升堂候颜色。\n我观椿萱图，为作椿萱歌，夭桃秾李空复多。\n写生纵有黄荃笔，风教无关知奈何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47244,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十二月廿一日得旨昭雪复官感激赋此","author":"程敏政","text":"紫凤衔书下九霄，君王还念旧宫僚。\n春回大地阳初动，日转阴崖雪尽消。\n犬马有情终恋主，山林无分又趋朝。\n旁人欲问酬恩事，洛党尘编未寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47245,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"耕读遗民为富溪宗人彦旻赋","author":"程敏政","text":"鸡峰渺何许，下有衡门翁。\n朝耕事拮据，夜读如颛蒙。\n不慕万钟禄，安此一亩宫。\n逍遥斯世间，绰有先民风。\n北顾仰莘野，南征忆隆中。\n躬稼乐古道，致主成元功。\n圣贤今已远，出处孰可同。\n洁身爱徐君，遗安得庞公。\n毛发久云变，儿孙亦成丛。\n代耕复胜读，世态从污隆。\n恒产蔚有秋，陈编浩无穷。\n何当挟册往，一与歌年丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47246,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题临川曹庭瑞爱兰卷 其一","author":"程敏政","text":"口谈禄命似君平，相见无劳问姓名。\n手弄国香诗满把，已应人识爱兰生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47247,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题临川曹庭瑞爱兰卷 其二","author":"程敏政","text":"紫蕤烨烨翠茎长，不是当年九畹香。\n愿子佩时须拭目，野花山草正芬芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47248,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"除夜家燕听埙子鼓琴","author":"程敏政","text":"山乡明日是新年，寿母情深夜不眠。\n耳畔莫嫌无管籥，小儿初解拂冰弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47249,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南山梅盛开以将北行不得赏立春日始克至精舍与客夜饮听逸清歌上清词有作","author":"程敏政","text":"许时不到山中来，今日赏春兼赏梅。\n苦于日落未成句，直到灯前方举杯。\n投閒得忙博一笑，北去南来经几回。\n道人为歌白雪曲，尘累扰扰何时开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47250,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿绩溪宗人景贵八十","author":"程敏政","text":"双瞳如水雪垂肩，才及非熊应兆年。\n上世黑头曾入相，平生丹诀笑求仙。\n东风送暖开仁里，南极流辉落寿筵。\n从十到千应可数，为君先赋大椿篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47251,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题殷氏东溪泛舟卷 其一","author":"程敏政","text":"雨过东溪好放船，四山如黛水如烟。\n风前细检逋诗卷，抚景悠悠十二年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47252,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题殷氏东溪泛舟卷 其二","author":"程敏政","text":"蟹潭风物定如何，南北驱驰岁月多。\n此日又从尘里去，几时来赋濯缨歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47253,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题吴氏知止卷","author":"程敏政","text":"大江风息好收船，莫待巍巍浪拍天。\n戒险不惭三让裔，为君思咏卜居篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47254,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题公明侄江湖览胜卷","author":"程敏政","text":"江湖风景最宜人，北去南来不厌频。\n长遣一身安素舸，肯将双足涴黄尘。\n鸥边芳草诗城远，鸟外青山画障新。\n收卷付君还自哂，又随徵节上征轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47255,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"李白问月图为巡按吴天弘侍御赋","author":"程敏政","text":"山东李白真王孙，天才逸若天马奔。\n醉中双眼俯八极，弄月似扣玻瓈盘。\n安得长江化春酒，诗成百篇供一斗。\n拔取蟾宫玉兔毫，为副金銮草麻手。\n江月空明山月高，停杯一问歌声豪。\n贺监归湖郭令远，寂寞当时宫锦袍。\n文章万古光不歇，过眼清光几圆缺。\n世间欲访谪仙人，煜煜长庚皎如月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47256,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"胆瓶梅为邵用珍赋","author":"程敏政","text":"雪后山窗读易时，胆瓶清晓见冰澌。\n老人坐悟先天理，无限春光在一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47257,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题虎图","author":"程敏政","text":"一啸风生百草枯，阴霾消处见于菟。\n眼中颇觉妖狐静，不道相看是画图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47258,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"廿五日北上留别乡友","author":"程敏政","text":"吾道行藏贵有名，分甘丘壑了馀生。\n世臣恩重须仍出，廷议公多久更明。\n东壁图书客再阅，北山猿鹤愧初盟。\n非才何力胜君召，馆阁江湖只寸诚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47259,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿岩寺方彦仁","author":"程敏政","text":"高年从昔数方瞳，近识多君一笑中。\n六十健来堪走马，百千人里羡冥鸿。\n灵椿影荫庭心绿，竦桂香传盏面红。\n寿算不须盘甲子，古岩家世汉仙翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47260,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题宋王晋卿画鹅","author":"程敏政","text":"猎猎风吹芦叶黄，瑶鹰如雪点江乡。\n钩帘素壁看摹本，想见当时宝绘堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47261,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登歙学岁寒亭和旧韵录寄岩镇汪君士和","author":"程敏政","text":"隐隐长松带石屏，小亭仍揭岁寒名。\n古碑字灭苔争绣，曲径人稀草乱生。\n松老不随霜雪变，景多真比画图清。\n凭阑小立斜阳里，春鸟初闻第一声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47262,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过淳安拜大司空胡公于里第别后奉寄","author":"程敏政","text":"玉立长身海鹤姿，归来谁得健如斯。\n了无俗气侵怀抱，才见青霜点鬓丝。\n优宠再看纶诰出，高情不改布衣时。\n朝廷次第收耆旧，拟有人赓庆历诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47263,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题致政应文贞典宝山水","author":"程敏政","text":"出门便见好溪山，却为丹青一破颜。\n想是宦途双足倦，高情长在卧游间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47264,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题白头翁","author":"程敏政","text":"莲塘十亩动凉飔，水鸟閒忙任所之。\n对画主人无一事，功名真到白头时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47265,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"二月六日睦州城东遇雨野泊杂言一首","author":"程敏政","text":"东风日夕至，倚棹桐江浔。\n淅淅打篷雨，渺然动羁心。\n老夫起读易，小儿坐鸣琴。\n相随二三子，一笑开烦襟。\n山家隔溪渚，上有青竹林。\n依依出烟火，阁阁飞沙禽。\n他乡忽值此，颇似南山岑。\n人生若萍梗，况彼霜毛侵。\n临流发孤啸，极目江云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47266,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"严先生祠","author":"程敏政","text":"不作中兴谏议臣，归来仍许禄终身。\n要令公相惭台鼎，正为先生乐钓纶。\n黄鹄溯风非漫士，赤龙当极是真人。\n雨中未得供蘋藻，一日乘潮入富春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47267,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赤松山","author":"程敏政","text":"碧霄千仞赤松山，怅望仙踪不可攀。\n直拟御风游海岛，肯来随俗住人寰。\n夭桃一树野烟里，老鹤数声空翠间。\n辟谷有灵应笑我，尘中双足几时还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47268,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饭道旁定明寺","author":"程敏政","text":"竹篱双户对山开，何代精蓝迹未灰。\n僧苦自为征税长，地荒谁起晒经台。\n匆匆一饭惟青菜，隐隐诸方半绿苔。\n落日未胜怀古意，聊题尘壁记曾来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47269,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出清波门过净慈寺饮于京兆先祠庵","author":"程敏政","text":"一笑逢君似隔晨，相违惊是五回春。\n青峰湖上不改色，白发尊前无数新。\n寝庙阴风瞻大老，梵宫斜日下游人。\n绕堤莫放篮舆速，偿我山中未了因。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47270,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过杭次陆大参同年留别诗韵","author":"程敏政","text":"风雨纷纷岁月催，不堪行处送君回。\n自应鸥鸟忘机事，谁识龙媒本异才。\n周览试看双目净，分携聊与一尊开。\n皇恩未谢尘缨在，何日还容入社来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47271,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"二月十四日李修撰子阳请饮江北陈家王修撰德辉在座","author":"程敏政","text":"客里欣逢两状头，东风三日系兰舟。\n浙西何处春色好，江北旧家池馆幽。\n醉任往来冲细雨，情牵离合付新讴。\n忽惊巷额题潘阆，愧我无诗纪胜游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47272,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"北上过武林再会竹东刘君虽右手痿痹神采胜常酌别之顷因赋此竹东当倚歌而和之舟中把玩如故人之在眉睫也","author":"程敏政","text":"谁道相如病不堪，尊前一笑两俱酣。\n持螯有趣供豪饮，扪虱无心事剧谈。\n执笔不妨聊任左，奋身何必羡图南。\n杖黎稳作湖山主，为子临岐祝再三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47273,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"王天禄侍御为玲侄写山水便面","author":"程敏政","text":"豸冠趣在丹青表，公子情多山水中。\n六月高堂不知暑，向人随手拂清风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47274,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"驻船月洲亭下闻似都宪将至暮雨有怀","author":"程敏政","text":"舣棹江亭待故人，阖闾城下雨如尘。\n鱼传尺素来三月，柳系离情管一春。\n菜色可怜畿内地，萍踪难定客中身。\n半生忧乐当何似，篷底青灯坐及晨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47275,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鹤山书院兼祀周文襄公今总宪治所","author":"程敏政","text":"圣门千载鹤山翁，再拜庭前思不穷。\n老桧尚疑含古雪，残梅犹自领春风。\n故乡西望桑榆远，敕使南来俎豆丰。\n入眼何人堪侑食，计臣今数大司空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47276,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"小饮承天寺为沈启南题林和靖二帖上有谢安抚印记","author":"程敏政","text":"咸平处士骨已稿，尺素谁传双鲤鱼。\n宝藏尚有安抚印，遗藁元无封禅书。\n人清并遣乌亦好，字劲宛得梅之馀。\n东风古寺拭卷目，想像西湖云水居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47277,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谒范文正公祠二首 其一","author":"程敏政","text":"广庭端拜一尘无，门外清溪点绿芜。\n三代伟人生庆历，千年遗庙托姑苏。\n浅夫敢窃先忧号，盛德还徵后系图。\n徽国陋儒空仰止，海峰高绝倚天孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47278,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谒范文正公祠二首 其二","author":"程敏政","text":"范家园脚步春风，皎日英标在眼中。\n银杏十围家庙古，玉粳千顷义庄丰。\n身当文正无双士，手授中庸第一功。\n却走画廊看翠碣，朱弦三叹忆欧公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47279,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"巡按赵侍御招饮宪台清风亭","author":"程敏政","text":"百舌声中春意深，小亭随步晚登临。\n千年胜地姑苏志，一代清风御史箴。\n傲岁花如图上见，乐池鱼向镜中沈。\n论文雅会匡时语，不觉残阳转树阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47280,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"似都宪华诞和韵","author":"程敏政","text":"柏府恩光锡命三，苍髯相对凛鬖鬖。\n军声旧遣戎王伏，诗律高令汉吏惭。\n泰岳炳灵分郓上，法星流彩映弧南。\n一宵晤语如公瑾，不待醇醪亦自酣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47281,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题倪氏子可竹卷","author":"程敏政","text":"毕竟君可竹，还应竹可君。\n恨无医俗句，与子播清芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47282,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"崔孝妇葑门朱存理求赋","author":"程敏政","text":"纷纷勃溪者，惊此孝姑名。\n刲股和羹进，捐钗卜地成。\n清河垂世范，吴郡有乡评。\n抚卷三兴叹，周王化已行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47283,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"虎头记","author":"程敏政","text":"豸角昔为吴郡守，虎头长赠长康孙。\n居人一日知名字，请药纷纷出葑门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47284,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题陆氏子终身之思卷 其一","author":"程敏政","text":"春色还青垄上枝，春风难染镜中丝。\n只应孝子羹墙意，一日长萦十二时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47285,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题陆氏子终身之思卷 其二","author":"程敏政","text":"抚卷令人重陆郎，思亲情共海波长。\n知君不是徒思者，手葺芸编几架香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47286,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题华氏严埭旧业卷","author":"程敏政","text":"先业沦他姓，前当野水斜。\n绿塍还旧物，白稻长新花。\n有共义民里，无惭孝子家。\n莫因心便得，诗礼足生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47287,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上巳日秦廷韶方伯与施彦清盛舜臣迓饯至惠山","author":"程敏政","text":"倚棹寻源到薜萝，任催斜日下林柯。\n游人不减吴庄盛，题字还疑宋刻多。\n万树野红真绚画，一泓寒渌未盈科。\n石床他日如堪借，来听松风和醉歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47288,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"别君谦","author":"程敏政","text":"万卷芸香手自删，知予能拨冗中閒。\n吴门七日心难了，直与殷勤过锡山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47289,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赵式画芙蓉为镇江高克明同知赋","author":"程敏政","text":"霜叶纷纷醉不知，名花全未觉开迟。\n眼中何物丹青手，解出秋江一段奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47290,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"很石行","author":"程敏政","text":"北固山前两拳石，野花茫茫土花碧。\n大如昂犬三尺强，小似伏羔才一尺。\n云当汉末风尘红，老瞒势欲吞江东。\n桓桓帝胄孙讨虏，并坐此石论雌雄。\n想像时危屏人语，惨澹风云眇蛇鼠。\n赤壁成功指顾中，石上谁宾复谁主。\n乌林一捷荆州分，同奖王室收奇勋。\n小儿奸贪败盟好，舞智蹶我髯将军。\n汉鼎分明沦异姓，质子封侯甘伪命。\n可惜棱棱不解言，恨入江声寄馀兴。\n今逢一统天下王，铁瓮城中开阅场。\n将军中峙列万垒，此君却在城东方。\n我来适过城下路，停车摩挲日将暮。\n欲从故老借图经，为尔临风写长赋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47291,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"永慕卷","author":"程敏政","text":"百龄将近委天和，累岁犹传薤露歌。\n谱在正分通德里，名高宜入孝廉科。\n蘋空南涧身刑远，兰茁东风庆积多。\n看取玉峰山下石，貤封新表待重磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47292,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮赵梦麟郎中沧江别墅","author":"程敏政","text":"潇洒郎官住京口，天性爱山如爱酒。\n长浮一斗与山盟，所不爱山如此斗。\n别墅正据沧江湾，四望宛在丹青间。\n虹月船空米老去，悠悠世代空尘寰。\n郎官作诗亦清好，不遇酣歌不挥扫。\n题遍山坳与水涯，与客江头几倾倒。\n我登沧江亭，为赋沧江篇，呼童更吸中?泉。\n临风欲洗双倦目，他时来结山中缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47293,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"古诗三十六句寄君谦仪部奉寓怀思云山迢遥不我遐弃春鸿在望用傒好音","author":"程敏政","text":"舣舟阊门下，揽衣涉南濠。\n居人爱杨子，力任细书劳。\n手校日弗给，续晷焚其膏。\n坐令书满家，一一排干旄。\n丽藻并奇字，史汉兼庄骚。\n剖击无终穷，人徒识仪曹。\n焉知漆雕意，古学非时髦。\n有如万里鸿，妙与江云高。\n又如幽兰芳，嫣然媚衡皋。\n恭惟圣所传，慎此义利操。\n明明君子心，道体求丝毛。\n忧违乐乃行，不负人中豪。\n巨舰乘安流，向尔空飞涛。\n芸编亦自幸，非君孰吾遭。\n岂若夸毗子，悻然立蓬蒿。\n相去日已远，令我心郁陶。\n故人颇谐寡，聊饮玉色醪。\n题诗寄濠上，临风愧投桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47294,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题吴天弘侍御画菜","author":"程敏政","text":"桔槔昼开春雨足，采采新苗出畦绿。\n就中一握晚菘香，何许长安夸食肉。\n柏台清节世见希，花鸟不爱丹青挥。\n向来断齑本同调，下箸亦喜霜根肥。\n此味分明吾所羡，此色宁堪上人面。\n船窗抚景一题诗，忧乐终归济时彦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47295,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"高邮湖阻风时虽开夹湖未能行舟","author":"程敏政","text":"一阵狂飙入地垠，客舟如叶浪如轮。\n凭谁上诉由风伯，任尔抛香拜水神。\n阿岸稍卑思跃马，夹湖虽好未通人。\n南来北去皆行役，篷底从容莫漫嗔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47296,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]