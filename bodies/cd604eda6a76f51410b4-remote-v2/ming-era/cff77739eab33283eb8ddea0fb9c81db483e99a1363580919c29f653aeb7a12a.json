[{"title":"游西湖呈陈水部","author":"江源","text":"湖上乘船五度过，旧时风景此山河。\n苏公堤古暮烟碧，逋老宅荒秋水多。\n沙鸟惊飞郎署旆，山禽如和美人歌。\n清时堪赏还堪喜，鬓未成丝面未婆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴次梅文渊五首 其一","author":"江源","text":"北风吹断木犀枝，物色无时不系思。\n今日正须怜曲突，此身何必叹支离。\n投簪谁复王官隐，流涕深知太傅悲。\n见说朝阳有鸣凤，岂无封事献彤池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴次梅文渊五首 其二","author":"江源","text":"秋堂枯坐不闻哗，世事悠悠付叹嗟。\n关陕日闻涂有莩，幽燕仍惜忝无花。\n寒天短景催华发，老树悲风聚晚鸦。\n叹我浮生浑不定，使舟明日海东涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52446,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴次梅文渊五首 其三","author":"江源","text":"客窗睡起首如蓬，一枕邯郸梦未终。\n短榻乱飘梨叶雨，征袍凉入蓼花风。\n鬓衰头上难饶白，诗满囊中不谓空。\n欲问松楸无恙否，乡书何处托飞鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52447,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴次梅文渊五首 其四","author":"江源","text":"秋来强放旅怀宽，越海鸥盟想已寒。\n万里风波还作客，十年尘土倦弹冠。\n炎风朔雪牵愁阔，野哭邻鸡搅梦阑。\n却羡忘情沙上雁，荻花烟雨此身安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52448,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴次梅文渊五首 其五","author":"江源","text":"奉使东南岂浪游，廿年君宠可能酬。\n也知天予此身大，敢道吾生泡影浮。\n边塞何年还卫霍，庙堂今日相伊周。\n江湖日日愁思结，谁任安危为主忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52449,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"复次前韵一首","author":"江源","text":"天地何人怨不宽，苦吟长叹孟郊寒。\n坐临秋水犹堪濯，醉倚西风不整冠。\n江上月明谁弄笛，天涯人远独凭阑。\n不才窃禄成何事，只合东山老谢安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52450,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和陈少参偶成韵兼申谢意","author":"江源","text":"秋堂夜酌酒如江，又听吴儿白纻腔。\n嘉会为君留使节，狂吟撩我写东窗。\n探囊叹乏青铜百，报德惭无白璧双。\n倾倒不知潮已长，水工催我上舽艭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52451,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次张天瑞答陈少参","author":"江源","text":"两浙江山十度游，平生欲与古人侔。\n紫微分署留连饮，严子高台惨澹秋。\n龙管凤笙天上梦，疏灯微雨驿边楼。\n行行不为征求急，西北烽烟满眼愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52452,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次倪学士韵答庄孔易","author":"江源","text":"侧闻世事乱如丝，不似山中掩耳时。\n俗子岂知黄犬叹，先生独赋白驹诗。\n少归栗里犹嫌晚，老识荆州未恨迟。\n回首定山空抱愧，西风尘土日奔驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52453,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答邵文敬","author":"江源","text":"秋风吹断绿杨丝，酾酒临江送我时。\n出使几时还使节，忆君长日把君诗。\n云遮北望瑶京远，水浅南河綵鹢迟。\n趍走王程身惭老，海波东逝日西驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52454,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答王宪佥宗吉","author":"江源","text":"登堂再拜鬓都丝，旧话方浓又别时。\n满目江花南浦赋，百年忠愤北门诗。\n秋堂秉烛还疑梦，风雨兼程未谓迟。\n国计正劳当宁念，五羊归思敢先驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52455,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答徐太守","author":"江源","text":"重逢幸未鬓成丝，西水楼前驻节时。\n魏阙风云劳我梦，嘉禾山水尽君诗。\n催科心苦趍程急，话旧情多解缆迟。\n自古男儿天下志，不妨吴越日交驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52456,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答吕秉之郎中","author":"江源","text":"节俭何劳咏素丝，回仙声价重清时。\n思亲恋阙年年梦，蓟北江南处处诗。\n着足龙门翻恨晚，低头东野未嫌迟。\n皇华四马叨同使，日夕应追骥尾驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52457,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答张东海","author":"江源","text":"大庾归来鬓已丝，庆云书舍适情时。\n教儿但读先秦典，代食唯歌大雅诗。\n谩喜田园连岁熟，莫嫌稚子候门迟。\n白头金紫还堪叹，车马红尘日夜驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52458,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次刘巡按韵","author":"江源","text":"从事何曾怨独贤，东吴西浙旧因缘。\n身驰水陆三千里，心在云霄尺五天。\n客路风光催我老，故山尘榻借人眠。\n进贤馆里停车晚，泼面霜风折短髯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52459,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"述怀","author":"江源","text":"客子光阴似转环，鬓毛不为朔风斑。\n酷怜杼轴空东国，敢谓贤劳赋北山。\n短述也能消永夜，浊醪未必破愁颜。\n乡关便道知何日，先遣音书附雁还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52460,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过杨子江","author":"江源","text":"拥节元非汗漫游，严程千里敢淹留。\n中流未击将军楫，淮水先乘使者舟。\n窅窅插天双螮蝀，轻轻傍我一沙鸥。\n逢人若问过杨子，曾驾长风破巨流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52461,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吉水分司偶成次宪佥黄九成韵","author":"江源","text":"公堂退食有馀清，敢道催科此政成。\n未忍东南频督赋，只缘西北未休兵。\n愁增鬓雪光阴老，事搅心旌感慨生。\n夔契功勋今尚在，世间谁谓是浮名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52462,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次黄山谷韵","author":"江源","text":"舣棹特来登快阁，西风两腋暮秋晴。\n幽清暂息百年虑，宇宙且开双眼明。\n板荡忠臣诗慷慨，风流太史墨纵横。\n孤标崒嵂遗碑在，应与斯文作主盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜抵进贤写景遣怀次黄九成佥宪题壁韵","author":"江源","text":"使客东行莫忆家，马蹄声里度年华。\n秋波浸月江铺练，木叶欺霜血染花。\n问俗闾阎诗易采，忍寒村店酒难赊。\n莼鲈未得如张翰，千载京尘扑帽纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52464,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"磻溪寺感怀次壁上韵","author":"江源","text":"驱车非为急征求，直北幽燕忝未收。\n羽檄西风频报虏，边兵今日正防秋。\n穷涂迢递谁青眼，古寺荒凉僧白头。\n感慨满怀何处遣，谩将诗句壁间留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52465,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"抵会江","author":"江源","text":"朝发桐江暮会江，风波巇崄客心降。\n斜阳天际去帆两，老树梢头归鸟双。\n排闷有诗裁夜烛，浇愁无酒泻秋缸。\n明朝又过钱塘去，争浪堆中泛巨航。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52466,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪梦","author":"江源","text":"风雨孤舟梦细君，相逢还是旧憨勤。\n熏笼添火烘双被，绣阁悬灯剌五纹。\n旧貌尚留前日靥，病腰犹束嫁时裙。\n觉来离恨知多少，屈指东风十四春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52467,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄过太璞宪副","author":"江源","text":"几年宪府旧同袍，拂袖归来便养高。\n彭泽俸钱偿酒债，半松烟月载渔舠。\n南窗寄傲输君乐，北地风沙叹我劳。\n欲放小舟重会面，不堪王事日忉忉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52468,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄邝时用黎景升二别驾","author":"江源","text":"舟过严濑思时用，月上兰溪忆景升。\n叹我嗟跎三尺法，看君清白两条冰。\n有诗满箧开怀抱，无术随时任爱憎。\n放棹山阴今日负，论文京国昔年曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52469,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和敖先生雪诗韵二首 其一","author":"江源","text":"一雪西江万类奇，晓来帘外更霏微。\n光摇天地月无影，冻合川原鸟不飞。\n煮茗可堪分玉屑，读书谁复映寒辉。\n闾阎冻馁知多少，敢道严威入豸衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52470,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和敖先生雪诗韵二首 其二","author":"江源","text":"斜斜整整不胜繁，猎骑缤纷走湿原。\n古径墁平人迹灭，老松擎重鹊巢翻。\n台前拒敌谁留柏，堂北淩寒更有谖。\n不独霸桥诗思苦，蓝关迁客正销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52471,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次前韵二首 其一","author":"江源","text":"银杯缟带状多奇，一色乾坤掩太微。\n越女肌肤休妒白，谢家庭院谩交飞。\n万人鼓舞占春麦，五夜光芒夺曙辉。\n忆得东华寒待漏，玉龙千丈晃朝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52472,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次前韵二首 其二","author":"江源","text":"入幕轻明扑地繁，失踪狐兔满郊原。\n人间玉树春妆点，天上银河夜倒翻。\n潘鬓斜侵吟阿可，渔蓑堪画付张谖。\n邹枚已去相如老，谁赋梁园为返魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52473,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题毛女图二首 其一","author":"江源","text":"非爱山中日月长，婵娟那忍逐降王。\n云屏石枕梅花梦，春雨秋风槲叶裳。\n龙腐沙丘悲帝子，路迷蓬岛叹徐郎。\n洞门深锁春长在，不管人间变海桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52474,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题毛女图二首 其二","author":"江源","text":"一别秦城远世氛，青山为伴鹤为群。\n承恩不记阿房日，采药长穿华岳云。\n溪叶青纫新佩子，山花红似旧罗裙。\n仙源恨隔渔樵路，谁在谁亡总不闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52475,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈监博","author":"江源","text":"昨夜谁占使者星，洪都今日驻双旌。\n独贤心壮摅王事，三绝名高共阿兄。\n瀑布泉头聊濯足，望湖亭上谩题名。\n孤舟又向章江别，江水江花不尽情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52476,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王举人春闱","author":"江源","text":"子上春官惜别宴，功名须似古人贤。\n榜登龙虎唐韩愈，策对天人董广川。\n九万云程鹏翮健，八千岐路马蹄穿。\n春风得意长安陌，好把泥金帖子传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52477,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题吉水分司月月红一首","author":"江源","text":"月月红开如有约，四时颜色染丹砂。\n沉香亭北妒妃子，结绮楼中失丽华。\n芍药便从春后老，海榴只合暑前誇。\n虽然堪赏还堪恶，恐夺霜台石竹花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52478,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙泉分司次黄九成韵寄陈吉甫","author":"江源","text":"人静台深思独幽，读书兼律足销忧。\n雨饶石壁苔花厚，日午砖阶树影稠。\n客子光阴过四月，乡园桑梓梦孤舟。\n东西奔走红尘倦，此足何年濯粤流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52479,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日写怀次敖先生韵","author":"江源","text":"后饮屠苏我半酣，衰年五十又加三。\n鬓毛有雪何须惜，吾道无闻始可惭。\n今日椒盘新岁颂，昨宵灯火去年谈。\n谁怜宦海沈溟客，春雨松楸忆岭南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52480,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次黎别驾景升归休韵二首 其一","author":"江源","text":"不逢叔度几经春，叹我胸中半俗尘。\n千里行囊双匕首，五湖烟月一归人。\n功名富贵非吾愿，钟鼎山林只此身。\n回首且寻陈太史，白沙新水是通津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52481,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次黎别驾景升归休韵二首 其二","author":"江源","text":"朝市奔趍二十春，粤江回棹洗嚣尘。\n云泉似昨寡轮鞅，松菊如今有主人。\n紫蚬青螺浇白酒，蒲葵木屐称闲身。\n区区白首何为者，宦海风波尚问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52482,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次联句韵奉答王世赏先生三首 其一","author":"江源","text":"故人十年长别离，树云千里两相思。\n愁多仗酒休辞酒，性僻耽诗爱说诗。\n哀柳秋高蝉抱叶，疏林风紧鹊争枝。\n人生见面即良会，只恐相期又过期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52483,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次联句韵奉答王世赏先生三首 其二","author":"江源","text":"秋水蒹葭共客舟，曲江歌酒昔同游。\n君看世事慵开口，我忆乡关怕倚楼。\n彭泽官闲犹恋晋，汉廷功了只封留。\n英雄回首真仙子，何必三山与十洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52484,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次联句韵奉答王世赏先生三首 其三","author":"江源","text":"江上相逢话最长，盘□草草酒茫茫。\n衰年更坐诗中瘦，豪气因非醉里狂。\n远道未应悲断梗，美人犹自隔殊方。\n重来握手何时节，又是春风燕语梁。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52485,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄刘麦二诗友","author":"江源","text":"几回对月思廷秀，千里逢人问用之。\n顾我簿书终日冗，忆君诗律老年奇。\n匡庐空阔留双眼，岭海峥嵘系寸思。\n三十宦游今五十，素餐无补负清时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52486,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次沈月屏先生见寄韵","author":"江源","text":"门下曾瞻矩范回，盛唐风骨少陵才。\n经纶有志岂长往，轩冕无心任倘来。\n千古诗豪刘禹锡，百年师道吕东莱。\n先生俯仰都无愧，莫惜霜华染鬓皑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52487,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赣州分司夜坐偶成","author":"江源","text":"作客江湖过十秋，西风今夕又虔州。\n青灯照我犹疑梦，白发欺人故满头。\n马祖岩前云似墨，虎头城上月如钩。\n行踪自叹浑无定，明日明年何处楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52488,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春闺词","author":"江源","text":"何事年年别藁砧，东风庭院独沉唫。\n落花飞絮午愁寂，燕语莺啼春色深。\n昼锦莫停桑下节，冰清休拾路傍金。\n相思相见知何日，且傍花前看玉簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52489,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋闺词","author":"江源","text":"飒飒秋风吹锦树，砧声不断思绵绵。\n玉人一别十年久，青鸟不来双眼穿。\n绣被夜寒桐叶雨，银屏霜冷菊花天。\n满前景物俱无赖，断送离愁到酒边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52490,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次曾大尹见寄韵 其一","author":"江源","text":"邂逅相逢庾岭前，我曾刮目识君贤。\n人情反覆万千状，消息稀疏十五年。\n翠竹幽居归蒋诩，枯槎沧海老张骞。\n重来嘉会知何日，汀树江云各一天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52491,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次曾大尹见寄韵 其二","author":"江源","text":"客涂又值小春天，仆从山舆未息肩。\n壮志未能忘报主，菲才终恐负绳愆。\n商彭老去难回少，西子衰来也避妍。\n今日尊前且欢谑，共将风月入唫边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52492,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"后九月九日","author":"江源","text":"西风两度重阳日，客里羁怀强放开。\n黄菊秋残堪再摘，白衣人去不重来。\n游山不著谢公屐，抱病谁登杜子台。\n今日狂吟聊遣兴，尊前何用苦敲推。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52493,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答世赏先生","author":"江源","text":"花满宣溪柳映门，玉堂学士老江村。\n溪头洗足水光净，门外卷帘山色繁。\n五凤楼台悬夕梦，四时风月役吟魂。\n尊中有酒且斟酌，尘世茫茫何足论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52494,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再次前韵奉德馨同年","author":"江源","text":"螺川驿里劳相送，日暮乘船过水村。\n性敏看君公事了，才悭觉我簿书繁。\n枕蓑谩忆山人睡，剪纸谁招旅客魂。\n二十年来新旧事，篝灯曾记一宵论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52495,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有怀德馨世赏二同年","author":"江源","text":"宣溪英迈浣灵豪，万里青云两凤毛。\n握手始为三日别，相思翻觉寸心劳。\n匡时事业卑王猛，垂世文章叹楚骚。\n坐掩船窗对孤烛，何时尊酒赋同袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52496,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉答世赏内翰见寄韵二首 其一","author":"江源","text":"玉堂文会幸追陪，怀抱十年今始开。\n对酒有时还看剑，寻诗无日不登台。\n霜前白雁催寒至，江上浓云挟雨来。\n欲识先生奇绝处，西都文字退之才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52497,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉答世赏内翰见寄韵二首 其二","author":"江源","text":"江上奇逢半日陪，胸中茅塞一时开。\n论思有道宜东阁，击搏无能负外台。\n急雨鸣芦南雁下，去帆添腹北风来。\n我闻圣主兼贤相，肯放宣溪老此才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52498,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次王顾二郡守联句韵八首客中聊以自遣 其一","author":"江源","text":"乡思撩人酒破除，宦情于我复何如。\n百年声利红尘里，一枕邯郸晓梦馀。\n王谢衣冠身后土，韩彭勋业釜中鱼。\n世间宠辱浑闲事，消得庄生一卷书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52499,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次王顾二郡守联句韵八首客中聊以自遣 其二","author":"江源","text":"豪气消磨客气除，今人曾不古人如。\n书生事业期韩范，市井交游叹耳馀。\n去晋便能轻爵禄，归吴端不为鲈鱼。\n寻常子史消长日，懒向人间索异书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52500,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次王顾二郡守联句韵八首客中聊以自遣 其三","author":"江源","text":"诗癖中年苦不除，汉庭老吏我何如。\n匡庐夜月登临外，花鸟春风掇拾馀。\n船尾汲清煎建茗，渡头沽酒脍江鱼。\n狂吟长短三千首，灯下科头趁醉书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52501,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次王顾二郡守联句韵八首客中聊以自遣 其四","author":"江源","text":"不用人前羡美除，长杨无赋老相如。\n三千客路青山外，五十光阴白发馀。\n度岭崄巇惭倦鸟，临池闲散爱游鱼。\n时行时止皆由命，羞向侯门觅荐书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52502,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次王顾二郡守联句韵八首客中聊以自遣 其五","author":"江源","text":"马蹄南北又东西，满路春风绿草齐。\n濯足洞庭千里碧，振衣庐岳万山低。\n廉夫不惮贪泉饮，好鸟生憎恶木栖。\n我有龙泉时起舞，中宵应不为闻鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52503,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次王顾二郡守联句韵八首客中聊以自遣 其六","author":"江源","text":"肃政堂前日欲西，争鸣双柏鸟声齐。\n几番骤雨打檐急，四面浓云压树低。\n楚水风烟新节序，粤山松桂旧依栖。\n拥襟正想罗浮伴，纸帐梅花梦后鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52504,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次王顾二郡守联句韵八首客中聊以自遣 其七","author":"江源","text":"客馆青灯雨泻檐，无诗空坐笔慵拈。\n虾蟆乱跃还依草，蝙蝠交飞不碍帘。\n黄菊酒边思靖节，红尘堆里老江淹。\n浮名廿载成何事，年岁偏惊历尾添。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52505,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次王顾二郡守联句韵八首客中聊以自遣 其八","author":"江源","text":"无梅索叹懒巡檐，坐对名香手自拈。\n宾馆有鱼谁鼓铗，讼庭无吏即垂帘。\n形容惭老乡音在，岭峤偏长旅梦淹。\n问我客边何所乐，锦囊风月有诗添。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52506,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]