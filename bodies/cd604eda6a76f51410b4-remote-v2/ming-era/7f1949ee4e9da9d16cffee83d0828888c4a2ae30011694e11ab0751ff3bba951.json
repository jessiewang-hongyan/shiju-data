[{"title":"后周书六首 其三 庾信","author":"郑学醇","text":"北朝羁宦意何堪，况复霜华满鬓簪。\n开府位高归不得，断肠空赋望江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15387,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"后周书六首 其四 裴侠","author":"郑学醇","text":"丁庸收直马成群，清节谁如独立君。\n奕世高风谁得似，赐田堪自老耕耘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15388,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"后周书六首 其五 卢光","author":"郑学醇","text":"檀台山上猎围屯，金镡基中锡仗存。\n岂是好生真帝德，故于围处见桑门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15389,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"后周书六首 其六 柳霞","author":"郑学醇","text":"襄阳丘陇柏青青，徵辟无心就北庭。\n移孝为忠曾不愧，始知江汉实钟灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15390,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隋书十首 其一 炀帝","author":"郑学醇","text":"百万旌旗再度辽，殿前中夜集双雕。\n只今龙舸轻游路，蔓草寒烟锁断桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15391,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隋书十首 其二 萧后","author":"郑学醇","text":"轻盈不耐是杨花，漂泊芜城不见家。\n有恨早知同蔡琰，不如青冢落胡沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15392,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隋书十首 其三 长孙晟","author":"郑学醇","text":"穷秋杀气正潇潇，突厥牙前落二雕。\n走马电飞弓霹雳，将军那数霍嫖姚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15393,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隋书十首 其四 李德林","author":"郑学醇","text":"曾是齐廷视草臣，十年天上掌丝纶。\n堪嗟出刺湖州日，还作杨家佐命人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15394,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隋书十首 其五 杜正藏","author":"郑学醇","text":"林邑迢遥进雪鹦，相君空自负才名。\n挥毫赋就重惊座，不向荆南羡祢衡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15395,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隋书十首 其六 高频","author":"郑学醇","text":"平陈仆射最元功，回首勤劳总属空。\n不为晋王留贵嫔，也应含恨报高公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15396,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隋书十首 其七 薛道衡","author":"郑学醇","text":"逶迤避地出江陵，列戟朱门衅已乘。\n何用先朝频颂美，腹心曾不似张衡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15397,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隋书十首 其八 柳䛒","author":"郑学醇","text":"麟阁曾闻尽世臣，柳䛒恩宠更无伦。\n内庭夜宴虚明月，不见词人见偶人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15398,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隋书十首 其九 史万岁","author":"郑学醇","text":"蜀将当年服远夷，至今犹自詟天威。\n亡夫决胜凭骁勇，却向南中仆旧碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15399,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隋书十首 其十 裴矩","author":"郑学醇","text":"欲将强盛远誇胡，罗绮金珠列国都。\n百戏未终兵甲起，不须重进外边图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15400,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐书十六首 其一 太宗本纪","author":"郑学醇","text":"天策将军府正开，分番学士拥驺来。\n蒹资谋断称房杜，犹向朱门蹀血回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15401,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐书十六首 其二 五行志","author":"郑学醇","text":"绣陌休歌契苾儿，百年天地几推移。\n阴阳调燮凭谁在，九月梨花折一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15402,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐书十六首 其三 乐书","author":"郑学醇","text":"花萼春风拂御楼，楼前新曲按梁州。\n宫离商乱谁堪听，似送边城一断愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15403,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐书十六首 其四 萧后","author":"郑学醇","text":"得宠深移得怨深，门横金锁漏声沉。\n汉宫衣赭人何在，骨醉难回二圣心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15404,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐书十六首 其五 武后纪","author":"郑学醇","text":"瓜熟黄台子渐稀，银潢天派一丝微。\n金鸡槲抄频颁赦，岭外流人更不归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15405,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐书十六首 其六 中宗本纪","author":"郑学醇","text":"虞渊日傍五龙飞，回首那知万事非。\n最恨不如汾水雁，年年犹作一行归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15406,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐书十六首 其七 宗室列传","author":"郑学醇","text":"弓劲霜清马绝尘，五王秋猎渭城滨。\n赤鹰黄鹘争奇逸，只有雄狐不避人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15407,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐书十六首 其八 后妃列传","author":"郑学醇","text":"腊后东风力正微，碧檐春雪尚霏霏。\n承恩赐浴温泉底，绵绣云屏暖作围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15408,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐书十六首 其九 玄宗本纪","author":"郑学醇","text":"幛掩金鸡隐祸胎，涧关不禁羯胡来。\n仙芝已枉哥舒溃，玉辇匆匆向马嵬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15409,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐书十六首 其十 杨贵妃传","author":"郑学醇","text":"露湿烟生芳草萋，翠华遥拂蜀山低。\n可怜山下花如锦，空有春魂逐燕西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15410,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐书十六首 其十一 杨贵妃传","author":"郑学醇","text":"玉漏沉沉珠露稀，粉梅檀杏歇芳菲。\n金沙洞口长生殿，万里无云秋月辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15411,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐书十六首 其十二 外戚傅","author":"郑学醇","text":"太平池馆乐游原，昔日繁华今几存。\n祓禊年年人尽乐，野花开遍水潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15412,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐书十六首 其十三 文宗本纪","author":"郑学醇","text":"堪怜蔓草竟难图，猎苑球场兴总孤。\n国命已归阉竖手，凭高空叹近臣无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15413,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐书十六首 其十四 姚崇","author":"郑学醇","text":"冯翊追趋猎渭城，丁宁天语相班行。\n当时何事亲承诏，千载君臣际会情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15414,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐书十六首 其十五 郭子仪","author":"郑学醇","text":"汾阳将略早登坛，免胄能令虏胆寒。\n声伎却因名相减，立功容易处功难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15415,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐书十六首 其十六 李泌","author":"郑学醇","text":"少帝龙飞晋水时，邺侯经画自多奇。\n衡山半似商山隐，重为储皇定国基。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15416,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五代史六首 其一 石敬塘","author":"郑学醇","text":"南北分疆自白沟，中华沦没几春秋。\n堪怜不夜临关月，兵照燕云十六州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15417,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五代史六首 其二 桑维翰","author":"郑学醇","text":"刻苦频将铁砚磨，功名偏藉晋阳戈。\n时危不废调鹰乐，世运无端奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15418,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五代史六首 其三 郑遨","author":"郑学醇","text":"世上浮名总是閒，诗篇何意落人间。\n乱来无地堪招隐，惟有华阴一片山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15419,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五代史六首 其四 王凝妻李氏","author":"郑学醇","text":"挥斤断臂完清节，颠沛犹能洁此身。\n为问归来长乐老，不知何代是君臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15420,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五代史六首 其五 王宗衍","author":"郑学醇","text":"飞鸾阁上醉妆残，风袭荷衣悄悄寒。\n仙曲未终人入草，勒铭谁道剑门难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15421,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五代史六首 其六 刘龚","author":"郑学醇","text":"岭外方舆作帝家，南郊西望尽长沙。\n只今大庾峰头月，曾照芳华内苑花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15422,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铁柱殿 其一","author":"郑学醇","text":"铁柱空劳造昔年，巍峨宫阙削寒烟。\n异香散尽秋风冷，辜负深藏廿四仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15423,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铁柱殿 其二","author":"郑学醇","text":"宝殿添开耀日光，坚牢应自卜无疆。\n金人十二今销灭，铁柱还闻铸汉王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15424,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初入词林自述","author":"李学一","text":"孔颜去既远，圣学多荆榛。\n嗟哉世儒生，空与糟粕亲。\n致主终无术，徒尔荣冠绅。\n鄙生怀壮志，愿言契道真。\n探讨虽已久，未能涉其津。\n值兹圣明世，南宫附跃鳞。\n更叨中秘选，陶镕帝泽新。\n峨峨同侪士，益友何纷缤。\n况复明师在，玄论日夕陈。\n敢不坚初服，永以答皇仁。\n入海期得珠，岂云徒效颦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15425,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪夜诣庄义","author":"李学一","text":"伟矣南华叟，飘然遗世荣。\n著书藏妙解，奥旨世难明。\n一夕程门立，微言入品评。\n既识逍遥体，因知物化情。\n火传见真性，游世见天行。\n聆此幽玄诀，锵然韶濩鸣。\n惟灵忽以畅，万虑澹无营。\n坐久闻寒柝，阶除雪已盈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15426,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"此日不再得","author":"李学一","text":"白日没何速，川波逝不止。\n人生过隙驹，光阴□此靡。\n是以古圣贤，务学恒不已。\n鸡鸣起为善，寸阴惜流晷。\n孔父犹敏求，曾生日省己。\n矧我颛蒙资，可不希前轨。\n平地可为山，功从一篑始。\n驽马十驾勤，终见能千里。\n吾人有性真，贤圣原同此。\n灵台苟无欲，止水安能拟。\n从滋涵养深，前圣岂难企。\n学与不学分，圣愚犹倍蓰。\n勉哉贵及时，慎勿忘斯旨。\n岁月去已多，不学复何俟。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15427,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"迢迢牵牛星","author":"李学一","text":"河西有牵牛，皖尔何皎洁。\n河东有织女，晶瑩若冰雪。\n欲渡河无梁，佳期杳难结。\n望望不可穷，黯然五内热。\n涕泪湿支机，乌鹊仍寂灭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15428,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"盆菊吟","author":"李学一","text":"人皆爱桃李，桃李竞春葩。\n朝花暮流水，零落令人嗟。\n岂若盆中菊，幽香未有涯。\n奇英含晓露，劲节傲霜华。\n对此意独深，孤芳日转加。\n谁云三径远，即此是陶家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15429,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠宝光上人","author":"李学一","text":"有客金陵来，武服挂雕弓。\n自言良家子，挺身远从戎。\n剑得白猿术，书传黄石翁。\n身当一校任，气夺万夫雄。\n在昔东吴战，曾摧海上艟。\n今兹来岭表，所至著奇功。\n一旦厌尘嚣，翛然慕远公。\n披剃解冠裳，逍遥入慧丰。\n焚香还扫石，洗钵浥流潨。\n英气今朝敛，槁灰此日同。\n形骸终有碍，一静万缘空。\n将为方外游，辞我上崆峒。\n予为长太息，纷华世所崇。\n而君有异尚，物化揽玄风。\n海鹤谁能絷，冥鸿岂受笼。\n从兹周八径，何地更相逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15430,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"查城道中","author":"李学一","text":"几度关索岭，去天只数刃。\n过此意坦夷，讵知山愈峻。\n洞浏万壑深，群峰削如刃。\n倏忽入幽崖，须臾陟层嶙。\n林间猿狖啼，咫尺云迷轫。\n盘江多毒淫，蛮烟古来慎。\n跋涉每艰危，念之令心震。\n名与身孰亲，斯言良足信。\n行行欲何为，内顾惭双鬓。\n岂若学巢由，高举辞尧舜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15431,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游云岩寺","author":"李学一","text":"夏日苦行役，息驾憩兹山。\n山中多白云，悠悠意自閒。\n俯聆涧底泉，潺潺鸣佩环。\n仰视林间鸟，好音时关关。\n山僧献新茗，一啜怡心颜。\n清梵度林来，人生乐翩翩。\n坐久万缘息，恍若非人间。\n遂欲乘白云，去去超尘寰。\n惜我无羽翰，白云不可攀。\n日暮景更幽，游车未忍还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15432,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游华岳","author":"李学一","text":"生平慕奇性，梦寐太华山。\n兹晨偶经过，驻马事跻攀。\n一径崎斜入，群峰嵂萃环。\n洞中新泉急，石上古苔斑。\n行行桃林境，复过沙罗湾。\n希夷有石室，蜕去永不还。\n遥望莲花峰，岧峣彩云间。\n白帝与玉女，窈绝非人寰。\n鸟飞无倦翮，猿登有愧颜。\n悬崖绝去日，穷探才所难。\n拄杖下山麓，回首眺玄关。\n多谢列仙人，相从未可閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15433,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题琴鹤相随图","author":"李学一","text":"翯翯九皋禽，营营枯桐枝。\n嗟哉贤相国，宦况恒相随。\n岂无鹰鹯志，不如华表姿。\n岂无钟鼓音，云门响独奇。\n缑岭凌空白，水仙三叠时。\n飘飘物外情，宛宛入襟期。\n清风播六合，芳名世共谁。\n伟矣阳山令，高风今在兹。\n承家誇节操，为政本仁慈。\n卫民多渥泽，单父有馀思。\n愿言崇令德，先公是尔师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15434,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日送徐名卿秀才应试","author":"李学一","text":"客从海上来，袖有双明珠。\n得自骊龙窟，精彩常不渝。\n问之将谁遗，云今有良图。\n君王遣使者，索宝穷海隅。\n怀此信已久，欲因献上都。\n余为长叹息，请君勿踟蹰。\n夜光世所珍，玆行必见孚。\n觏之人共赏，安有按剑徒。\n会看充御府，贵重拟璠玙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15435,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题蛰出始振图为高少泰作","author":"李学一","text":"黄钟初应律，春日正冲融。\n九九玄关启，重重淑气通。\n莺迁上苑柳，龙跃紫霄风。\n多少含生类，陶形覆载中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15436,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题二难纪奇卷赠潘云山公袒之昆阳","author":"李学一","text":"郊原久烽火，四野何萧索。\n畴堪倭更来，虔刘恣凶虐。\n碣石已屠城，平山复残爚。\n闯迫惠城东，公私俱惊愕。\n督府镇鹅阳，征兵连负郭。\n进战未有期，内变复中作。\n叛卒讧糜沸，反戈事剽掠。\n主将已见戕，复赴潘侯幕。\n执侯质倭夷，共缔攻城约。\n我侯了不惊，胸襟何磊落。\n兵刃谁能加，忠信驯鲸鳄。\n一朝反间行，叛徒俱受斫。\n万姓已阽危，幸免填沟壑。\n生全谁之功，日远愈炤焯。\n倭夷嗣殄灭，无恙侯如昨。\n忠义神所歆，固令脱锋锷。\n朝宁重贤能，领兹专城托。\n昆阳宠命新，蛮方待经略。\n膏车赴滇南，行李惟空橐。\n嗟余本疏庸，辱侯情匪薄。\n念侯日将远，寸衷孰云乐。\n愿言崇令德，勋业标麟阁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15437,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同潘肖径避暑西新园次韵","author":"李学一","text":"夏日苦炎暑，泛舟乘好风。\n西新清且胜，宛若憩瀛蓬。\n水脉千溪合，山光四望通。\n鸥閒兰渚上，鱼戏水云中。\n尘襟忽以静，佳兴渺难穷。\n贪赏归来晚，禅林起暮钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15438,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潘肖径重过避暑西新次韵","author":"李学一","text":"有客重相访，共乘湖上舟。\n桥阴好风集，恍惚如清秋。\n赋诗消永日，忘机对白鸥。\n聊为避暑计，讵知成胜游。\n客堪潘岳并，主愧谪仙俦。\n多少湖山景，樽前一览收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15439,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答梁滨湖","author":"李学一","text":"季子游秦日，相如困蜀年。\n敝裘人共笑，怀瑾我应怜。\n一旦风云合，崇朝事业鲜。\n黄金誇相印，负弩耀归鞯。\n穷达畴能测，荣枯那足喧。\n嗟哉梁伯子，允矣翰场贤。\n龟岭曾谈艺，鳄湖更对玄。\n文章惊斗灿，藻思类河悬。\n青紫斯同拾，声华拟并妍。\n谁知灵凤翼，偶屈九霄缘。\n豹隐君犹昔，鹏抟我幸先。\n岐途讵可怨，壮志自须坚。\n荆璞宁终弃，隋珠不久捐。\n愿言崇令德，金马待朝天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15440,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灯市","author":"李学一","text":"上元佳节春初转，灯市喧腾汉苑东。\n妙手谁能齐镂碧，巧思何处竞雕红。\n金龟彩凤风前见，蕊阙珠楼日下逢。\n白昼星辰惊错落，锦城笙鼓正冲融。\n九衢宝马香尘扰，十里珠帘丽色同。\n共说三阳开泰运，家家士女乐年丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15441,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒蝇叹","author":"李学一","text":"朔风一起吹胡雪，长安朱户寒威洌。\n堪叹青蝇当此晨，敛翼垂头何惙劣。\n忆昔炎蒸入户庭，呼群引类恣营营。\n白璧黄金遭点污，杯盂坫几餍馀腥。\n今日何为徒寂寞，堕床落叶见凋零。\n骥尾不可附，鹏翮安可攀。\n气候已变易，炎时难再还。\n因斯感叹多利子，趋炎附势宁知止。\n一旦冰山不足凭，丧身落魄皆如此。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15442,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题平倭","author":"李学一","text":"海邦鼙鼓年年急，野妇村氓相对泣。\n何当夷丑更陆梁，海上人家徒壁立。\n朝闻碣石已屠城，暮报平山复波及。\n喜看儒将有子房，帷幄运筹禽已执。\n净扫妖氛岭峤清，万井千家事耕汲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15443,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游碧云洞","author":"李学一","text":"连日山行苦山恶，时为登临出城郭。\n郭南有洞名碧云，巍峨嵂崒从天落。\n下马洞门忽敞开，飞泉万派穿幽壑。\n初疑水窦即龙门，继睹神功非禹凿。\n稍前窈暧若重关，再入琼宫复寥廓。\n天边一穴透明来，穹窿万象何炤焯。\n垂旒悬乳光陆离，翠霭丹崖森喷薄。\n石田粲粲如布棋，畎亩盈盈可种芝。\n神龙诡兽争腾跃，寿星卧佛相参差。\n胡人欲献西来宝，仙子将开海上卮。\n我亦平生好佳胜，眼中未见如此奇。\n徘徊日暮不能去，聊赋新诗一纪之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15444,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠周东隐乡宾","author":"李学一","text":"俗见羲皇古，民犹熙皞前。\n此间逢野叟，云是老莱仙。\n邀我烹鸡黍，开樽对芋田。\n依依桑柘密，疑入武陵天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15445,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿李太母","author":"李学一","text":"昼锦三秋候，慈亲喜寿康。\n华堂罗绮席，綵服献霞觞。\n宝婺常悬彩，蟠桃屡荐香。\n褒封有鸾诰，行见出明光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15446,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题双寿遐祝","author":"李学一","text":"锦绶趋庭日，三春花更妍。\n登堂双白发，拂袖御华筵。\n东海桃初熟，南山寿自绵。\n行看鸾凤诰，遥下五云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15447,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冯太母贞节","author":"李学一","text":"闻道冰霜节，千秋孰与京。\n共姜偕雅操，孟母绍芳声。\n岁晚松犹翠，秋清月愈明。\n恩光今有主，端足慰平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15448,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送曾医士","author":"李学一","text":"方外逢高士，人前且说医。\n活人心素切，治病效尤奇。\n神术传何自，芳名冠一时。\n明将烹炼去，幸示复来期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15449,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]