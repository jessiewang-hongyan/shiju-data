[{"title":"送金开府还武林 其一","author":"佘翔","text":"匡时推建节，感事遂初衣。\n威震彭湖外，功成越徼归。\n风霜依豸府，烟雨恋渔矶。\n身去名弥重，未应便息机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19798,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送金开府还武林 其二","author":"佘翔","text":"八载纾南顾，重臣两鬓丝。\n艰危满眼急，牢落寸心知。\n雁度惊风冷，帆摇带雪迟。\n五湖烟月好，长啸学鸱夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19799,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送金开府还武林 其三","author":"佘翔","text":"东南深保障，行止却踟躇。\n羽檄今初定，军储更有馀。\n自甘隐豹意，那问乐羊书。\n父老并州泪，攀留拥后车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19800,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送金开府还武林 其四","author":"佘翔","text":"孤山原结社，归去问吾曹。\n苏小门前柳，蒋公径里蒿。\n梦魂消策海，词赋盛观涛。\n不浅山阴兴，愿追载酒舠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19801,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送金开府还武林 其五","author":"佘翔","text":"心事明天日，才猷迈伯王。\n暂抛鱼鸟阵，一卧水云乡。\n葛井丹初熟，䅊侯泽正长。\n安危须将相，元是郭汾阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19802,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"曹能始王玉生沈从先同入梅岩余蹑其后不及 其一","author":"佘翔","text":"乘舟游汗漫，倚杖陟崔嵬。\n晓濑千盘雨，春梯百丈苔。\n餐霞元吏隐，采秀总仙才。\n所愧非禽向，何缘共往来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19803,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"曹能始王玉生沈从先同入梅岩余蹑其后不及 其二","author":"佘翔","text":"谢客耽山水，梅生厌市廛。\n桃源初问路，桂树不知年。\n粱糗青泥缮，刀圭白日传。\n如何乖羽翼，清夜梦相牵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19804,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"八咏禁体 其一 夕阳楼","author":"佘翔","text":"十二凌霄迥，雕甍驻晚晖。\n层霞侵绣闼，返照逗朱扉。\n倚槛群鸦集，巡檐乳燕飞。\n晚妆羞独上，花月隔音徽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19805,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"八咏禁体 其二 流黄月","author":"佘翔","text":"少妇停梭处，银河玉镜飞。\n蟾窥双镊影，兔射七襄机。\n促织声偏急，合欢信转稀。\n关山吹玉笛，何处是金微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19806,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"八咏禁体 其三 芦花风","author":"佘翔","text":"蘋末商飙动，飘飘舞絮狂。\n行空疑泛梗，著树若飞霜。\n衬水鱼争沫，披云雁作行。\n所嗟人远戍，秋老未还乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19807,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"八咏禁体 其四 芭蕉雨","author":"佘翔","text":"绮阁背园林，晴光满绿阴。\n忽闻声淅沥，自觉气萧森。\n远梦醒凉簟，清商咽素衾。\n博山炉欲烬，欹枕听馀音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19808,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"八咏禁体 其五 霜前叶","author":"佘翔","text":"园林秋色淡，青女信先知。\n憔悴自今日，葳蕤非故枝。\n洞庭波欲起，金井露为期。\n赋质元轻薄，托根终不移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19809,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"八咏禁体 其六 松上雪","author":"佘翔","text":"架壑材凌劲，孤标压六霙。\n龙疑蟠玉垒，鹤自下青城。\n气肃徂徕节，光浮琥珀精。\n肯随桃李艳，惟结岁寒盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19810,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"八咏禁体 其七 画堂燕","author":"佘翔","text":"甲第开王谢，双栖试羽裳。\n空巢依藻棁，将子下雕梁。\n尾剪差池影，泥含百和香。\n谁堪荡子妇，刺绣掩空房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19811,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"八咏禁体 其八 沙场雁","author":"佘翔","text":"阴碛排云下，边庭唳月新。\n稻粱怀汉苑，羽翼染沙尘。\n避缴愁分猎，衔芦怯渡津。\n青闺书不到，魂断玉关人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19812,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赵仁甫招饮芝园仝颜左史李茂才作","author":"佘翔","text":"华亭临曲水，避暑更适宜。\n日影松阴薄，蝉声阁外迟。\n寻诗寻竹径，佐酒荐园葵。\n池上凉风满，何妨倒接䍦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19813,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"访汪仲嘉松明山中时有传余物化者相见愕然醉后宿肇林赋此","author":"佘翔","text":"故人江左别，风雨十年多。\n蒿里空垂泪，蓬门且放歌。\n张灯如寤寐，把酒慰蹉跎。\n托宿僧僚近，往来步屧过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19814,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过汪仲淹故居感怀喜见其子无央","author":"佘翔","text":"一入千秋里，白榆感旧游。\n何年埋玉树，此日邈丹丘。\n花湿平芜雨，蝉鸣灌木秋。\n不孤嵇绍在，腰下解吴钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19815,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中柬陈鲁彦","author":"佘翔","text":"空门何寂寂，积雨暗松枝。\n抱病衣偏冷，安贫鸟亦饥。\n看经先嗽齿，断酒不攒眉。\n徙倚孤亭上，频吟伐木诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19816,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中汪仲嘉惠米却谢以诗","author":"佘翔","text":"双鬓愁中短，六时客里长。\n何期三日雨，更惹九回肠。\n谁授餐霞诀，空馀辟谷方。\n故人分玉粒，听雨饱绳床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19817,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"紫阳道中逢余珍甫","author":"佘翔","text":"忆昔夷门别，风尘阅岁华。\n君怀新甫柏，我种五侯瓜。\n乍见惊蓬鬓，相携入酒家。\n明朝分羽翼，依旧隔天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19818,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和汪司马寄题仙岩诗为云池上人作","author":"佘翔","text":"青莲初架壑，胜地已声闻。\n未得瞻花雨，徒然想法云。\n幽愁归自在，究竟总无文。\n所愿从师去，醍醐乞几分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19819,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠胡广文","author":"佘翔","text":"才名高海国，振铎向闽天。\n桃李沾春雨，鱼龙破晓烟。\n传经垂绛帐，对客坐青毡。\n独有凌云气，时悬北斗边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19820,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日登钓台 其一","author":"佘翔","text":"天涯秋乍转，重眺子陵台。\n潭古鱼龙伏，山空鹳鹤来。\n自耽丘壑老，那问伯王才。\n所愧扁舟客，忘机鸟转猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19821,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日登钓台 其二","author":"佘翔","text":"七里终垂钓，高风薄九霄。\n萧曹偏佐汉，巢许岂臣尧。\n地僻连桑野，台狐控斗杓。\n羊裘何处问，秋树正鸣蜩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19822,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日登钓台 其三","author":"佘翔","text":"犯坐星为客，狂奴重此邦。\n功虽希渭水，计自老湘江。\n古洞无眠鹿，荒祠有吠厖。\n临风听短笛，调入水云腔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19823,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日登钓台 其四","author":"佘翔","text":"凭高一长啸，眼底尽飞潜。\n齐国今非汉，渔人旧是严。\n风号流水转，云散乱峰尖。\n兴尽乘槎去，松梢吐玉蟾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19824,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"槜李别张子明 其一","author":"佘翔","text":"汗漫逢长水，愁心感岁华。\n非关贫刺骨，那得远辞家。\n双鬓经秋短，孤鸿带日斜。\n露团芳草夕，何处咏蒹葭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19825,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"槜李别张子明 其二","author":"佘翔","text":"异地怜同病，君归不可留。\n弟兄俱白首，风月正清秋。\n失路悲寒雁，忘机愧野鸥。\n一杯聊惜别，不为答吴钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19826,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"桐江舟中怀金中丞","author":"佘翔","text":"鼓棹今何适，桐庐际晓行。\n山多藏玉笈，水不染尘缨。\n别洞龙眠稳，长空鹤唳清。\n仙人云树里，犹似隔蓬瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19827,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠章少府","author":"佘翔","text":"豫章需上国，一命佐鸣琴。\n舄借双凫影，庭分五柳阴。\n贤劳推骥足，抚字见鸾心。\n自是神仙尉，莺声啭上林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19828,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日同张子明王德载陶大冶访王上之留饮舟回作","author":"佘翔","text":"共泛彪湖棹，言寻处士家。\n鹿门归采药，龙井唤烹茶。\n玉麈谈名理，青莲供法华。\n溯洄秋色里，浥露咏蒹葭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19829,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送了义上人还普陀","author":"佘翔","text":"云中开宝刹，碧海信浮槎。\n一火空尘劫，诸天护法华。\n随缘飞片锡，发愿礼三花。\n从此皈依处，禅心定洛迦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19830,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陈元朋张绍和二孝廉夜集游宗振嘉树林即席分韵 其一","author":"佘翔","text":"楚楚谈天客，归来自帝州。\n讵堪逃竹所，未许老糟丘。\n投辖星窥井，衔杯月满楼。\n相逢欢卜夜，凉气飒疑秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19831,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陈元朋张绍和二孝廉夜集游宗振嘉树林即席分韵 其二","author":"佘翔","text":"二妙才名重，论交惬素心。\n斗牛双入佩，山水独知音。\n醉月穿萝径，乘风啸竹林。\n图南绝跋扈，莫遣鬓萧森。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19832,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日林晋伯邀蔡伯达明府避暑清溪同林元和钱叔达黄尧衢柯尔珍作","author":"佘翔","text":"别墅清溪曲，宾筵但荐瓜。\n舒荷风未绽，扶荔日初斜。\n波泛空江月，香闻隔岸花。\n留连还秉烛，盘谷欲移家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19833,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题隆甫小像","author":"佘翔","text":"季鹰称任达，之子慕高风。\n貌岂缘诗瘦，愁多入赋工。\n云中惟附骥，海上自冥鸿。\n色相无劳著，万缘悉已空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19834,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿夏司马 其一","author":"佘翔","text":"龚黄推上佐，曾识汉庭名。\n北海春初煖，南山月正明。\n家传金粟盛，官比玉壶清。\n一自条风起，讴歌处处声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19835,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿夏司马 其二","author":"佘翔","text":"司马云台望，大夫雪苑才。\n清风闻八郡，紫气近三台。\n阁静鱼频挂，庭閒鹤正回。\n此时瞻法象，应可拟蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19836,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿夏司马 其三","author":"佘翔","text":"圣朝崇展骥，仙籍重骖麟。\n名在丹台旧，荣分海甸新。\n占星知是岁，问俗想行春。\n即此棠阴茂，还看饰羽轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19837,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿夏司马 其四","author":"佘翔","text":"降岳传周典，偷桃忆汉官。\n仙风应不减，吏道亦何难。\n楼橹烽烟息，菁莪湛露团。\n冈陵惭共祝，敢谓臭如兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19838,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"林太守元和招游凤林乐丘","author":"佘翔","text":"相逢半隐逸，太守醉称翁。\n中散情多放，荣期乐未穷。\n溪毛蘋藻绿，山果荔枝红。\n把酒听新瀑，长松日暮风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19839,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张证性之粤","author":"佘翔","text":"竹里啸清秋，怜君复远游。\n丹已寻勾漏，药自采罗浮。\n老骥怀千里，名山动四愁。\n何时归故国，访我白蘋洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19840,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋得东山屐","author":"佘翔","text":"谢公高卧日，江左卜安危。\n偏纵登山屐，长吟在涧诗。\n烟霞随缓步，松竹结幽期。\n雅量谁能测，犹传折屐时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19841,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五月三日仝诸君泛舟 其一","author":"佘翔","text":"南薰吹灌木，载酒命兰舟。\n兴动沧浪水，香生杜若洲。\n清言谐夙契，大块等浮沤。\n俱罄杯中物，独醒空自愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19842,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五月三日仝诸君泛舟 其二","author":"佘翔","text":"海曲分南北，为欢驾彩虹。\n三江澄碧浪，五月御薰风。\n蒲酒渔郎醉，菱歌浣女工。\n眷兹游汗漫，何必问新丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19843,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"纸帐","author":"佘翔","text":"岂厌流苏艳，还将茧素裁。\n连床堪染翰，捲幔欲妆梅。\n匹练分云出，罗纹带月开。\n个中人似玉，曾否梦阳台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19844,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽孙司理 其一","author":"佘翔","text":"岂厌天台赋，胡然遽返真。\n法星沉昨夜，仙箓注兹辰。\n闽海馀波润，吴江旧业贫。\n片心留一剑，洒泪挂松筠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19845,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽孙司理 其二","author":"佘翔","text":"垂虹何处是，归榇但扁舟。\n鹤向青城唳，马含白练愁。\n琴书孤橐冷，蘋藻五湖秋。\n赢得舆人颂，精灵逝不留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19846,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山行有怀","author":"佘翔","text":"欲采山中秀，虬髯未可逢。\n蓟门违凤啸，郑圃恋仙踪。\n云气团岩竹，泉声杂涧松。\n暝投何处宿，隔水动疏钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19847,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岁暮咏怀兼呈唐明府巫太学诸君 其一","author":"佘翔","text":"访戴停孤棹，江城岁欲阑。\n同云一夜合，积雪四山寒。\n落魄诗堪废，愁肠酒转宽。\n河阳花渐发，倚杖及春看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19848,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岁暮咏怀兼呈唐明府巫太学诸君 其二","author":"佘翔","text":"雨雪空斋暝，萧然此抱疴。\n孤篷游已倦，长铗向谁歌。\n竹翠侵衣湿，溪声入枕多。\n主人能爱客，翻不厌婆娑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19849,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岁暮咏怀兼呈唐明府巫太学诸君 其三","author":"佘翔","text":"犬马嗟余齿，蹉跎已古稀。\n百年犹转盼，三径讵忘归。\n柳色含烟嫩，梅花带雨飞。\n乡心逐流水，言采故山薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19850,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岁暮咏怀兼呈唐明府巫太学诸君 其四","author":"佘翔","text":"垂老长为客，淹留愧此身。\n如何生白室，偏爱草玄人。\n腊酒倾三雅，春盘荐五辛。\n故乡千里外，儿女梦中亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19851,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元日用元礼韵","author":"佘翔","text":"乘春初出郭，峡口一亭开。\n不为条风暖，何缘缓步来。\n鱼翻池上藻，鸟啄涧边梅。\n欲倚卢敖杖，翩翩上九垓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19852,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早春集光严寺","author":"佘翔","text":"缓步跻山寺，羁心感岁华。\n经初翻贝叶，酒已厌椒花。\n白发逃方外，青山梦海涯。\n何如双树鸟，日夕听三车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19853,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早春雷?林招集西郊","author":"佘翔","text":"乘春多载酒，把臂竹林中。\n草细沾新雨，池平漾午风。\n人家多社曲，鸡犬似新丰。\n肯惜如泥醉，劳生叹转蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19854,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早春次吴希晓韵","author":"佘翔","text":"岁事才三日，寒阴日渐消。\n忽寻芳草去，不待美人招。\n煮茗初删竹，倾醪更著椒。\n春风轻拂柳，未许折柔条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19855,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中排闷兼呈巫维贞 其一","author":"佘翔","text":"竹径藏春色，兰皋带雨声。\n年华方七日，孤客最关情。\n薜荔多垂幄，沧浪足濯缨。\n田家东作起，何事不归耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19856,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中排闷兼呈巫维贞 其二","author":"佘翔","text":"此地逢人日，空斋一雨寒。\n如何春已到，转觉路行难。\n蓂荚烟初暝，梨花雪欲残。\n故园心一片，安得借飞翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19857,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中排闷兼呈巫维贞 其三","author":"佘翔","text":"短发不堪把，流光岁已移。\n潜鱼忘巨壑，倦鸟托深枝。\n风雨貂仍敝，关山雁故迟。\n淹留愁不尽，隐几一裁诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19858,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中排闷兼呈巫维贞 其四","author":"佘翔","text":"羁栖魂欲断，暮雨不堪闻。\n怀土怜王粲，谈玄愧子云。\n灯悬金粟影，炉带玉兰薰。\n芳草王孙路，何当醉里分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19859,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送周士龙入粤兼报黄元白陈尔美","author":"佘翔","text":"寒色拥江天，离魂倍黯然。\n有怀多琬琰，相赠岂兰荃。\n啸月嶅山顶，停云瘴海边。\n同声如有问，生计老逃禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19860,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"午日分赋得桃印符 其一","author":"佘翔","text":"綵丝逢令节，仙篆表灵符。\n五木精初聚，千门祟已逋。\n采莲喧竞渡，斗草艳当垆。\n别有潇湘意，临流吊左徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19861,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"午日分赋得桃印符 其一 悼亡诗为嵇士茂题卷","author":"佘翔","text":"嵇生竹林士，伉俪系幽情。\n神爽窥圆照，肠愁寄短声。\n帐中形影在，花下去来轻。\n孙楚哀流电，临风泪满缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19862,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"午日分赋得桃印符 其二","author":"佘翔","text":"㡩幕凄凉夜，孤灯思不禁。\n为云还入梦，奔月亦何心。\n气咽凤凰管，香销翡翠衾。\n一弹瑶瑟罢，山水动哀音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19863,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"午日分赋得桃印符 其三","author":"佘翔","text":"菱镜何能掩，兰房此日亲。\n金精空坠地，玉树已成尘。\n虹断蓝桥魄，云归洛浦神。\n幽香还满室，曾是不归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19864,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"午日分赋得桃印符 其四","author":"佘翔","text":"一展悼亡卷，悲风飒飒来。\n香魂终不返，玉貌转堪猜。\n泪竭潘郎句，心怜谢韫才。\n鼓盆非不达，五恨总难裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19865,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中避暑和游元封夏日閒居十首 其一","author":"佘翔","text":"河朔耽名饮，幽栖性所怡。\n钩帘时看竹，隐几漫裁诗。\n溽暑过三伏，菩提借一枝。\n若非同调者，谁结白云期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19866,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]