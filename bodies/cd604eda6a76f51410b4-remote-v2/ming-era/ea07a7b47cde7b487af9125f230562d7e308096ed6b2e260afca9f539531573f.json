[{"title":"题竹赠廖子谟南归","author":"杨士奇","text":"芳春宰花县，久别不胜思。\n比似湘川上，清风玉一枝。\n五年重晤聚，几月又分岐。\n临发无持赠，聊歌卫武诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2761,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠建平弟","author":"杨士奇","text":"七十年兄弟，于今二老存。\n脩途余未息，古道尔能惇。\n后辈纷纷出，颓风靡靡奔。\n晨星与霜木，相对两忘言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2762,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金幼孝挽诗","author":"杨士奇","text":"英年兼令质，秋水映娟娟。\n才行诸昆重，诗书累代传。\n一朝随化物，万事逐浮烟。\n听话临终意，何人不怆然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2763,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送沈生归省","author":"杨士奇","text":"旧与休文好，曾闻小阮贤。\n行冲蓟门雨，归问浙江船。\n璞玉须成器，韶光剧逝川。\n承欢有馀暇，努力事遗编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2764,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"贻程夏二中书","author":"杨士奇","text":"扈从巡畿甸，官曹喜接联。\n屡颁丹凤诏，须属彩毫宣。\n画障分云树，琴声泻涧泉。\n春行有佳兴，相伴共悠然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2765,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陪驾观猎","author":"杨士奇","text":"武士拥周遭，前驱导彩旄。\n径危兼水石，野阔盛蓬蒿。\n鹰犬纷飞跃，狐狸莫遁逃。\n老臣方寸切，上念圣躬劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2766,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"从度居庸高峰","author":"杨士奇","text":"玉辇巡边徼，师还此伐鼗。\n紫云随警跸，红日动旌旄。\n地险关城壮，天清眺望高。\n非才叨侍从，无补只徒劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2767,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陈豫中八十寿诗","author":"杨士奇","text":"翛然无俗累，恬澹乐丘园。\n名誉三山重，春秋八帙尊。\n安居非药里，荣养自词垣。\n五月瞻南极，华星正对门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2768,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李主事赴常州通判","author":"杨士奇","text":"初出郎官署，先传府倅贤。\n天恩谢北阙，春水载南船。\n郡已无三害，民皆有一廛。\n年丰公事简，瀹茗试山泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2769,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"漳州曾氏望云卷","author":"杨士奇","text":"县城当桂岭，清昼白云垂。\n重到曾游处，偏增罔极悲。\n神游杳霭外，目断苍茫涯。\n五色衣裳在，承欢讵可期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2770,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄李德言","author":"杨士奇","text":"高州李别驾，未老倦缨簪。\n金石论坚操，冰霜烱素心。\n闭门吟对竹，延月坐鸣琴。\n半幅幽贞趣，赠君文水浔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2771,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽彭子信","author":"杨士奇","text":"昔者雩阳郡，黉宫重得师。\n合宗推孝友，后进仰威仪。\n丘垄松楸合，春秋雨露滋。\n诸郎惇永慕，尤废蓼莪诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2772,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送梁叔车","author":"杨士奇","text":"离怀不可尽，且复共芳筵。\n卞玉终须献，韦经故有传。\n河山行处好，云树望中妍。\n归路诗千首，因风寄百篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2773,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王希积泰和训导","author":"杨士奇","text":"严亲进官日，并命出彤闱。\n拜后多人羡，光前似子稀。\n离情常北恋，行色又南归。\n想侍慈颜处，簪缨胜舞衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2774,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠梁叔庄泰和训导","author":"杨士奇","text":"相违十载过，相聚半年深。\n论旧何曾尽，伤离复在今。\n黉宫双白璧，儒行万黄金。\n莫道匆匆别，无穷迟好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2775,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答黄宗载见寄","author":"杨士奇","text":"又是三年别，新来百感增。\n薰莸安可问，枘凿苦难胜。\n白发落垂尽，青山归未能。\n故人赠佳句，拟报玉壶冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2776,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠仰善主事南归","author":"杨士奇","text":"重逢方适愿，几日又分岐。\n瑚琏真堪宝，云霄自有期。\n从知万人见，肯受一尘缁。\n无限岁寒意，题诗赠别离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2777,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送苏伴读","author":"杨士奇","text":"德义儒林重，诗书学海翻。\n校雠辞秘閤，辅导向王门。\n晓铎行车远，春筵赐醴温。\n须明藩屏意，天子万年尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2778,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送刘凝节归永丰时有兴国训导之聘","author":"杨士奇","text":"都城一相见，文采动华年。\n家与先贤近，经从太史传。\n三春还旧邑，百里望平川。\n应复匆匆去，诸生候讲筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2779,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题敏求斋","author":"杨士奇","text":"閒居积文史，不厌五车多。\n白玉须成器，流光惜逝波。\n阶前春草遍，林下午风和。\n还有同门者，时来共切磋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2780,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王霖知县赴阆乡","author":"杨士奇","text":"千里河南北，忧勤切至尊。\n兵年兼旱潦，民命急朝昏。\n身倚诗书贵，功将抚字论。\n无忘当宁意，一一在覃恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2781,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"刘指挥勤学斋","author":"杨士奇","text":"时平无警柝，公暇事遗编。\n解剑闻春诵，烧灯减夜眠。\n竹深幽院里，花暗素房前。\n事业由多学，相期及盛年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2782,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王性存亲迎后归省","author":"杨士奇","text":"朝辞金阙去，千里赴庭闱。\n锦绣行春昼，何须五色衣。\n岸花明画障，江月净琴徽。\n一路弹新调，鸳鸯不独飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2783,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"张生水竹居","author":"杨士奇","text":"傍水连高竹，门前似渭川。\n雨晴看净练，风爽听清弦。\n为酒兼烧笋，持竿屡取鲜。\n还资奉甘旨，非但乐林泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2784,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戴诚问挽诗","author":"杨士奇","text":"□携如昨日，寤寐想平生。\n操比寒松劲，心同秋水清。\n诗书安素业，身世避浮荣。\n冢树西风里，凄凉故旧情。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2785,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"王好信挽诗","author":"杨士奇","text":"来往经萧峡，舟人指富溪。\n林藏君子宅，行慕古人齐。\n锦诰恩封在，青山垄树迷。\n郎曹未终养，愁绝夜乌啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2786,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"焦主簿挽诗 其一","author":"杨士奇","text":"郿县岐山侧，萍乡楚水浔。\n扶持有神力，惠爱在人心。\n往事岁年远，高坟松柏深。\n自天鸾诰出，奕奕宠光临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2787,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"焦主簿挽诗 其二","author":"杨士奇","text":"悯物由天性，能官不假威。\n重为百里佐，遽作九原归。\n瑟瑟悲风迥，荒荒零露稀。\n惟馀凤毛在，五彩翙双飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2788,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄王宗豫 其一","author":"杨士奇","text":"相别岁频改，相思心未降。\n故家沧海国，高卧白云窗。\n适趣琴三叠，随游鹤一双。\n东来抱锦轴，喜见笔如杠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2789,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄王宗豫 其二","author":"杨士奇","text":"内阁承宣地，朝朝侍柘袍。\n七人亡过半，二老去能高。\n蹇劣仍踰分，驱驰岂任劳。\n怀归归未得，鬓雪不胜搔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2790,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"胡敏御史致事出梅求题余于胡有旧故赋二诗识别 其一","author":"杨士奇","text":"秘馆曾同事，流年四十馀。\n花封有嘉政，柏府重清誉。\n致事新恩命，怀乡旧隐居。\n湖塘三百亩，已免贡菱租。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2791,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"胡敏御史致事出梅求题余于胡有旧故赋二诗识别 其二","author":"杨士奇","text":"五月出都畿，东风暑雨微。\n济河新涨发，淮浦片帆归。\n朋旧惊霜鬓，乡闾重绣衣。\n岁寒怡老处，梅雪共清辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2792,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄杨仲举长史","author":"杨士奇","text":"谁不恋丘园，兼之鬓雪繁。\n几人知道义，用世必玙璠。\n遂有贤王奏，㳟闻圣主恩。\n平生钦慕意，喜极欲飞鶱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2793,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送陈中员外","author":"杨士奇","text":"文雅陈员外，三年一度来。\n春风对玉树，浩荡好怀开。\n北阙晴云下，南河彩鹢催。\n一枝淇澳赠，临别意徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2794,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"曹侍郎乃母挽诗","author":"杨士奇","text":"曹家少司寇，至孝奉慈闱。\n衣贮亲缝线，堂县旧断机。\n喜崇二品养，遽动九原归。\n天恩下鸾诰，千岁有光辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2795,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送乐象乾并寄声陈述","author":"杨士奇","text":"京国三年别，驱驰越汉皋。\n冰霜纲纪地，旦暮简书劳。\n入觐还相慰，能官见所操。\n临分赠淇玉，更为谢同袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2796,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题王郎中九峰归趣图","author":"杨士奇","text":"老别郎中署，人看昼绣荣。\n家临三泖近，门对九峰清。\n邻叟来分席，家僮从阅耕。\n君恩重山岳，一饭未忘情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2797,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠萧斯易御史巡按苏常诸郡","author":"杨士奇","text":"绣斧辞京国，三吴候画船。\n丹枫秋水岸，白雁早霜天。\n悯物须蠲蠹，观风在礼贤。\n功名仗才俊，努力及英年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2798,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题陈宪山水","author":"杨士奇","text":"何卿妙写趣，陈宪问题诗。\n野水瀰溪涧，春云压树枝。\n群山如对客，独学更求师。\n待我归来日，披图共酒卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2799,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送凌副使归省先茔","author":"杨士奇","text":"先茔赐归省，腊尽出都门。\n雁影行途远，梅花到日繁。\n春风待旌旆，昼锦入乡园。\n情事从容毕，不忘当宁恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2800,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅月轩","author":"杨士奇","text":"清轩夕不扃，梅映月娉婷。\n移影上琴荐，浮香著砚屏。\n一尘元不染，万籁寂无听。\n即此坐閒暇，澹然心志宁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2801,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵答胡若思宾客 其一","author":"杨士奇","text":"东璧蓬山顶，曾同侍玉皇。\n碧霄龙早逝，沧海鹤高翔。\n案有庄生论，门临孺子坊。\n游心邈千载，尘虑已都忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2802,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵答胡若思宾客 其二","author":"杨士奇","text":"自别颐庵叟，星行十二周。\n天恩无寸补，世故有多忧。\n老骥力垂尽，长途驰未休。\n中怀何处写，聊用寄南州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2803,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重过鹞儿岭伤用道长史","author":"杨士奇","text":"荒山千万叠，茅舍頫河滨。\n岂意清明世，翻为憔悴人。\n命穷身不返，志屈道还伸。\n为洒重来泪，平生心所亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2804,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王希德归西昌","author":"杨士奇","text":"三岁在京畿，春生五色衣。\n殷勤承父教，归去候慈闱。\n丹桂浮香露，黄花粲夕晖。\n人生具庆少，养志在无违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2805,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送用仪之官莱芜","author":"杨士奇","text":"百里铜章贵，英年宠命新。\n侵星辞阙下，带雨发河津。\n岁歉须宽恤，民劳急拊循。\n前贤有尘甑，垂誉已千春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2806,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送梁叔脩秀才归西昌","author":"杨士奇","text":"洒落王詹事，人今第一流。\n相看佳子婿，冰柱照琳璆。\n□□留经岁，家山到及秋。\n文章千载事，珍重满归舟。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2807,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"御史陈谷乃父挽诗","author":"杨士奇","text":"行己严三畏，传家守一经。\n选才成大典，膺召谒彤庭。\n草露俄乘化，松茔已勒铭。\n平生知不泯，有子嗣芳声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2808,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杨孟潜挽诗","author":"杨士奇","text":"芳春奋科目，令器比玙璠。\n致孝亲闱乐，传经学者尊。\n一朝随化物，群行载词垣。\n光华知不泯，况有凤毛鶱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2809,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送叔纲表侄","author":"杨士奇","text":"失怙怜渠早，提携赖母慈。\n门庭已秩秩，兄弟亦怡怡。\n观国欣初见，怀乡又远离。\n外家多子侄，期尔读书诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2810,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送叶锡尹姑苏","author":"杨士奇","text":"买得吴中棹，遥辞潞渚滨。\n重为花县宰，旧是玉堂人。\n霜菊看将晚，寒梅到及春。\n从知锦绣地，不肯厌清贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2811,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅赠郭太守还镇江","author":"杨士奇","text":"每忆春坊旧，寥寥叹晓星。\n明时用郭伋，五马驻江城。\n庠序弦歌盛，桑麻雨露荣。\n梅花一片月，长伴使君清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2812,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"暇日承观上人惠访","author":"杨士奇","text":"参襌周十刹，随地演三车。\n水月心常静，烟霞趣已赊。\n胡杨皆故族，孔李更通家。\n一访空斋里，玄谭过日斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2813,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画赠梁婿叔济","author":"杨士奇","text":"萧散藩翰幕，时平净俗埃。\n河流带近郭，树色蔼高斋。\n简牍常时阅，诗篇暇日裁。\n閒情对图画，亦胜倒金罍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2814,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题任生山水","author":"杨士奇","text":"溪亭夏无暑，不假碧荷筒。\n垂柳轩窗外，青山眺望中。\n水漾玻瓈色，香生菡萏风。\n借问坐谭者，还知无极翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2815,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王志浩","author":"杨士奇","text":"凤历纪王正，新春别帝京。\n行观具区薮，先过阖闾城。\n圣主方兴教，诸生喜受经。\n他年看奏最，崇秩有光荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2816,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽冯知府","author":"杨士奇","text":"凄断南来讣，相违始十旬。\n晤言犹昨日，死别惜芳春。\n冰檗声仍在，龚黄志未伸。\n平生乡郡意，回首一沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2817,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送刘子钦","author":"杨士奇","text":"故人刘子政，契阔十馀年。\n此日重携手，相看各白颠。\n交情方恋恋，别袂遽翩翩。\n聊赠岁寒意，琅玕雪共妍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2818,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题福建吴布政竹石图","author":"杨士奇","text":"家住鄞江上，作藩闽海涯。\n旬宣有馀暇，公退足委蛇。\n竹秉岁寒操，石含大古姿。\n高斋坐相对，无忘武公诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2819,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陈斌副使之陜西兼柬陈宪使于副使","author":"杨士奇","text":"骢马向咸阳，东风驿路长。\n渭川清映月，秦树早迎霜。\n风采人心快，贪渔吏弊亡。\n陈于荣并命，冰玉共高堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2820,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄吏部尚书黄宗载","author":"杨士奇","text":"白首记同年，怀君静胜仙。\n冰霜老北地，云树渺南天。\n近俗伤多薄，无言忍独贤。\n离情何所似，春柳遽飞绵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2821,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忠孝堂","author":"杨士奇","text":"桓桓忠孝行，藉甚说冯君。\n有子传先德，能官续武勋。\n高堂名教事，巨笔史臣文。\n四海皆臣子，芳声独远闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2822,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题刘纲知县梅花","author":"杨士奇","text":"作令更三邑，兹行向海邦。\n民风尚文学，士俗亦惇庞。\n须得穷櫩好，还令蠹吏降。\n梅花玉雪意，常若对寒窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2823,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题萧氏林泉居","author":"杨士奇","text":"壮游两京路，邂逅多写真。\n一随化物尽，屡见流年新。\n承家有令子，志墓托名人。\n寂寞水南畔，依然旧松筠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2824,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陈虬延安知府","author":"杨士奇","text":"天子急民瘼，廷臣领郡章。\n平生怀玉雪，此去播春阳。\n雕鹗云霄迥，骅骝道路长。\n试看韩与范，遗迹在边方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2825,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵答颐庵 其一","author":"杨士奇","text":"十年去京国，高卧西山陲。\n天趣常自得，他人安足知。\n竹馆鸣琴处，河塘坐钓时。\n劳心尘事者，何日赴幽期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2826,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵答颐庵 其二","author":"杨士奇","text":"与君离别后，两度历边陲。\n年老衰容换，风寒病骨知。\n有心存济物，何术可匡时。\n矫首西江上，归帆会有期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2827,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送刘知县赴莆田","author":"杨士奇","text":"远邑需良宰，贤科起茂才。\n九天辞玉阙，一骑发金台。\n济北初舒柳，江南未过梅。\n能官崇富教，莫遣吏民猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2828,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题刘氏奉亲堂","author":"杨士奇","text":"双亲各垂白，至乐奉安居。\n养有日官禄，教传星象书。\n椿阴满庭户，谖草映阶除。\n日月趣朝退，班衣侍婉愉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2829,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送贡士任善归丰城","author":"杨士奇","text":"妙龄兼令质，归省自京师。\n为学功须倍，升荣计未迟。\n岁时将暮矣，霜露亦凄其。\n珍重关河道，高堂切尔思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2830,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]