[{"title":"得朗公诗却寄","author":"徐熥","text":"真僧虽出世，踪迹尚人群。\n妙法登坛演，名香入定焚。\n楼含孤嶂月，衲挂半溪云。\n千里封题寄，新诗过所闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23044,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭林文烈 其一","author":"徐熥","text":"十载神交旧，年来倍忆君。\n每疑音问阔，谁谓死生分。\n识面真无日，浮生总似云。\n难将知己泪，一洒故人坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23045,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭林文烈 其二","author":"徐熥","text":"相违三百里，消息太茫然。\n对月思玄度，披图忆辋川。\n讣来当此日，死去自何年。\n墓木今成拱，才歌薤露篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23046,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得宁夏消息 其一","author":"徐熥","text":"叛卒雄心旧，元戎血刃新。\n中原多戍垒，边郡半征尘。\n时事何旁午，吾生实不辰。\n愿闻烽火息，老作太平人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23047,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得宁夏消息 其二","author":"徐熥","text":"乱离犹未定，百姓夜虚惊。\n官府勾丁壮，乡闾练甲兵。\n笳声吹陇水，杀气暗边城。\n不识书生辈，何人敢请缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23048,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至日对客","author":"徐熥","text":"葭管灰初动，残花满故篱。\n谁知开径日，正是闭关时。\n短晷闺中线，生涯镜里丝。\n相逢聊一醉，莫问岁华驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23049,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡岘江访林熙吉 其一","author":"徐熥","text":"江路当残雪，斜阳满客衣。\n林疏村店出，浪急钓船稀。\n远屿临流断，罡风到岸微。\n炊烟看渐近，何处是渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23050,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡岘江访林熙吉 其二","author":"徐熥","text":"青山两岸阔，一叶度空江。\n叫雁云中独，浮鸥浪里双。\n霜花飘野渡，水气拍船窗。\n渔唱来前浦，随风自有腔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23051,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"旗山勾漏洞 其一","author":"徐熥","text":"溪山何逶逦，数里入鸿濛。\n斜日猿声外，残云鸟道中。\n乱峰诸洞隐，万竹一泉通。\n趺坐松间石，尘心觉尽空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23052,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"旗山勾漏洞 其二","author":"徐熥","text":"丹成不记年，古洞白云边。\n众水争趋壑，孤峰欲接天。\n路危逢乱石，山尽见平田。\n日暮休归去，还期遇葛仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23053,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"旗山勾漏洞 其三","author":"徐熥","text":"葛仙何处去，勾漏访遗踪。\n陟巘齐攀竹，听泉独倚松。\n石床荒藓合，丹灶薄云封。\n转入深林外，前山又一重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23054,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"旗山勾漏洞 其四","author":"徐熥","text":"仙都在人境，一步一嵓峦。\n怪石各有态，脩篁难计竿。\n松烟烧处煖，萝磴坐来寒。\n别去仍回首，馀生几度看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23055,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"濑下晚泛","author":"徐熥","text":"一水平如镜，西风晚度时。\n茅茨燃鬼火，榛莽翳神祠。\n潮势冲溪尽，峰形过濑奇。\n山川劳应接，进艇不嫌迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23056,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登岸","author":"徐熥","text":"兰若知何处，跻攀尚数程。\n逢沙愁濑浅，登岸得舟轻。\n古石莓苔色，空林猿鸟声。\n除将樵采者，更有几人行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23057,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山行","author":"徐熥","text":"脩竹夹篮舆，岚光欲染裾。\n小桥流水急，古路冻云疏。\n村屋乘冬结，山田隔岁锄。\n空林闻犬吠，不异武陵居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23058,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"放船","author":"徐熥","text":"孤舟回乱石，流水响潺湲。\n渔网蒹葭外，人烟竹柏间。\n断云迷晚渚，残照下秋山。\n远寺昏钟起，樵歌出谷还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23059,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠潮上人","author":"徐熥","text":"真僧住洞天，苦行已多年。\n说法苔衣上，安禅瀑布边。\n瓢餐千涧月，衲挂半林烟。\n夜静诸缘息，跏趺久不眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23060,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠波上人","author":"徐熥","text":"随师居净土，礼佛向空门。\n夜半磬犹击，旬中发几髡。\n蒲团同鹤睡，贝叶借猿翻。\n壁挂袈裟湿，因过雪里村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23061,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别方广岩","author":"徐熥","text":"灵境探应遍，言寻旧路归。\n殷勤记嵓石，惆怅别林扉。\n出洞寺全隐，下山泉渐微。\n行行频矫首，人世到来稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23062,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日晓起","author":"徐熥","text":"山色犹含暝，柴门逐晓开。\n流星坠高柳，湿雾隐残梅。\n出谷莺声冷，巢林鹤梦回。\n无缘独吟眺，春意满莓苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23063,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郑承武之东鲁 其一","author":"徐熥","text":"送君当此去，匹马向东阿。\n夜泪灯前尽，春愁梦里多。\n乱云过泗水，斜日下黄河。\n虽有远游兴，能无思薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23064,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郑承武之东鲁 其二","author":"徐熥","text":"惜别意何长，莺声满夕阳。\n残碑问邹峄，遗殿吊灵光。\n下马多新店，逢人少故乡。\n归期须及早，莫待寄衣裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23065,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚至石竹山","author":"徐熥","text":"寻真当薄暮，暝色满松关。\n绝壁猿声断，遥空鹤影还。\n云边春草路，天际夕阳山。\n应识仙都近，钟声杳霭间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23066,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜度石梁登摘星台","author":"徐熥","text":"四野苍烟暝，千峰夕照催。\n踏兹明月影，独上摘星台。\n山自鸿濛剖，人从鸟道来。\n石梁称险绝，不用说天台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23067,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠岩上人","author":"徐熥","text":"昔住毗卢殿，今居石竹山。\n春云禅衲煖，夜月梵钟閒。\n香积供狙饭，禅房倩鹤关。\n平生爱空寂，相对欲忘还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23068,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石竺山迟陈道育不至","author":"徐熥","text":"正苦经年别，终违数里程。\n谈应虚玉麈，梦已断瑶笙。\n报客空劳鹤，怀人独听莺。\n一灯松影里，吟卧若为情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23069,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读顾道行先生碑刻","author":"徐熥","text":"使者登攀处，春风又几年。\n诗留孤嶂里，人老五湖边。\n屐齿埋荒藓，碑棱隐断烟。\n摩厓惬幽赏，惆怅隔山川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23070,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东郊晚行","author":"徐熥","text":"出郭高舂后，郊原起夕阴。\n山山曳残雨，步步响新禽。\n老树莓苔厚，空林紫翠深。\n招提何处所，云际有钟音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23071,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"涌泉废寺 其一","author":"徐熥","text":"古寺荒凉久，凄然感废兴。\n残灰六十载，破衲两三僧。\n黠鼠据香积，妖狐吹佛灯。\n黄金重布地，不识有谁能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23072,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"涌泉废寺 其二","author":"徐熥","text":"净室已丘墟，荆榛久未除。\n空山樵子路，前代梵王居。\n石柱颓残后，金身煨烬馀。\n披云寻故址，一步一踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23073,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喝水岩赠瓢庵头陀","author":"徐熥","text":"何年此卓锡，钟磬度昏朝。\n瀑水引归钵，茅庵结似瓢。\n蹑云双草屩，坐月一团焦。\n隔寺有禅侣，相寻不惮遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23074,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灵源洞怀振狂在杭","author":"徐熥","text":"南郭人何处，东山屐已非。\n春风忆苕水，夜月梦芦矶。\n以我招寻惯，如君同调稀。\n摩挲旧题刻，空见白云飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23075,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟送僧归日本 其一","author":"徐熥","text":"远指扶桑外，龙宫是绀园。\n慈航寻海舶，晨磬待朝暾。\n已悟西方教，渐通中国言。\n悬知无佛处，师去定称尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23076,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟送僧归日本 其二","author":"徐熥","text":"遥天迷去住，但看指南车。\n重译同归舶，阳侯护法书。\n?风心自定，海怪咒堪除。\n此去无禅侣，应寻绝岛居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23077,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟送僧归日本 其三","author":"徐熥","text":"归程兼昼夜，天水共微茫。\n但指日出处，此中吾故乡。\n皈依多獦獠，供养有夷王。\n遥想珠龛下，常焚异国香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23078,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟送僧归日本 其四","author":"徐熥","text":"别去上星槎，沧溟道路赊。\n夷音宜咒呗，左衽自袈裟。\n演法从天竺，传灯到海涯。\n不知千劫里，何劫到中华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23079,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病僧 其一","author":"徐熥","text":"苦厄那能度，医王亦抱疴。\n苔侵双屐湿，尘翳一瓢多。\n锡杖频扶手，金刚为伏魔。\n跏趺在禅榻，或恐是维摩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23080,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病僧 其二","author":"徐熥","text":"闻钟苦夜长，形影自凄凉。\n忏悔除前障，呻吟检古方。\n坐非同面壁，卧岂倦津梁。\n气运有时尽，千花塔里藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23081,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"集郑氏乌石别墅 其一","author":"徐熥","text":"众山环曲径，乱竹掩衡门。\n塔影云中寺，人烟郭外村。\n新蝉喧白昼，归鸟报黄昏。\n此地清幽甚，依稀似习园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23082,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"集郑氏乌石别墅 其二","author":"徐熥","text":"虽是居城市，却无城市喧。\n僧归残雨寺，樵度隔云村。\n花落鸟声歇，草多萤火繁。\n斜阳人散后，留鹤守柴门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"法云寺对月","author":"徐熥","text":"空界云阴敛，祗园月色澄。\n光生初动磬，影送未归僧。\n入水悟禅意，照林疑佛灯。\n更阑纵吟眺，衣上露华凝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽陈太学 其一","author":"徐熥","text":"龙驾南巡日，何人批逆鳞。\n谁知伏阙者，却是布衣臣。\n抗疏青云薄，忧时白发新。\n至今遗庙在，蘋藻自千春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽陈太学 其二","author":"徐熥","text":"欲回江汉辇，痛哭叩重阍。\n死谏孤臣节，生还圣主恩。\n青山藏疏草，白日照忠魂。\n寂寞荒坟上，西风啼暮猿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"树下禅僧 其一","author":"徐熥","text":"跏趺依古树，偃息对峰阴。\n草屩莓苔湿，麻衣烟霭深。\n猿啼知定性，叶落见禅心。\n明日随缘去，游踪何处寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"树下禅僧 其二","author":"徐熥","text":"老树不知年，无言息树边。\n着头多雀秽，遍体有蜗涎。\n木叶寒时佩，花裀定后眠。\n月中行客过，疑是野狐禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过郑吏部墓 其一","author":"徐熥","text":"荒坟不计年，过客泪潸然。\n朽骨藏于此，吟魂何处边。\n野狐啼暮雨，石马卧秋烟。\n安得斯人起，重令大雅传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过郑吏部墓 其二","author":"徐熥","text":"西郭冢累累，经过下马谁。\n先生一抔土，词客百年悲。\n藤护将崩石，苔封未断碑。\n应知灵爽在，叹我不同时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠史使君 其一","author":"徐熥","text":"风流史使君，三载竹符分。\n吏舍积青草，公庭生白云。\n山城有弦诵，瘴海无妖氛。\n父老关门送，不持钱一文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠史使君 其二","author":"徐熥","text":"一麾初出守，三十已专城。\n露冕诸侯贵，攀辕百姓情。\n俸贫难养鹤，庭静但闻莺。\n试看长溪水，惟君能共清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠黄生懋政","author":"徐熥","text":"怜君湖海客，寄迹少年场。\n音律周公瑾，丹青顾长康。\n侠常弹短剑，贫不厌空囊。\n名姓应难问，多于酒肆藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过郑君大白云庄","author":"徐熥","text":"何处辨山家，轻云处处遮。\n乱峰围拱木，一径入梅花。\n草榻依林设，柴门逐水斜。\n主人无所事，杯酒送年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚泊七里滩","author":"徐熥","text":"寒云生近浦，落日满前汀。\n旅梦惊潮破，渔歌过濑停。\n一竿秋水碧，孤棹晚山青。\n向夕推篷望，中天见客星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中古庙 其一","author":"徐熥","text":"山深香火微，庙宇冷斜晖。\n壁古龙蛇暗，厨荒鼠雀饥。\n岁时村妇拜，水旱土人祈。\n箫鼓田间过，知为祭赛归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23096,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中古庙 其二","author":"徐熥","text":"一路人烟绝，空山见古坛。\n鼎存周款识，像塑汉衣冠。\n鸟迹残碑篆，虬枝老树蟠。\n可怜年代久，风雨庙门寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23097,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中古庙 其三","author":"徐熥","text":"古庙白云边，神妆尚俨然。\n灵应山鬼托，龛任野狐眠。\n开刱知何代，销沉不计年。\n居民流窜尽，累岁断香烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23098,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元直秀才观微上人过宿","author":"徐熥","text":"风流看许掾，定慧得支公。\n白社当年结，清言此夕同。\n乱蛩吟竹坞，一犬吠花丛。\n相对残灯下，能令尘虑空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23099,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送瀚上人游越 其一","author":"徐熥","text":"师行无定踪，此去路千重。\n投宿月中寺，经过雪里峰。\n閒身临水衲，禅意隔潮钟。\n明岁西湖上，相寻九里松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23100,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送瀚上人游越 其二","author":"徐熥","text":"虽云游浙水，未必浙中游。\n遇客皆为侣，逢山便可留。\n独行半风雪，一别几春秋。\n所惜谈诗夜，从今少惠休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23101,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送瀚上人游越 其三","author":"徐熥","text":"真僧欲度世，岂肯倦津梁。\n白足他山月，缁衣满路霜。\n一灯传异代，六祖是同乡。\n此去逢行脚，新诗好寄将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23102,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得谭比部寄先永宁书感而赋答","author":"徐熥","text":"凄风生敝庐，忽枉故人书。\n不复知存没，犹然问起居。\n一缄千里外，双泪几年馀。\n孔李通家旧，毋令鱼雁疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23103,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送危博士之官马平","author":"徐熥","text":"茫茫江水阔，相送片帆孤。\n炎海川途远，蛮天气候殊。\n瘴烟发青草，云树黯苍梧。\n想到谈经日，三鳣坠有无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23104,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陆画师还钱塘","author":"徐熥","text":"客怀当暮冬，去矣不从容。\n草屩千峰雪，柴门九里松。\n贫惟安豹隐，老任笑龙钟。\n为问经行处，云山貌几重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23105,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"峬山看梅过曾文表墓","author":"徐熥","text":"一路尽氤氲，看花倍忆君。\n白杨知己泪，宿草故人坟。\n树影含残照，猿声哭暮云。\n凄凉身后事，地下可能闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23106,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨太学之金陵","author":"徐熥","text":"劳歌动别筵，酒散各云天。\n折柳当春暮，看花正少年。\n莺声孤店月，草色六朝烟。\n无限怀人意，金陵何处边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23107,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"故黎平太守袁公挽歌 其一","author":"徐熥","text":"永别城中路，新成郭外坟。\n旐题前太守，书失右将军。\n广柳驱残月，甘棠翳暮云。\n应知千载后，不朽是遗文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23108,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"故黎平太守袁公挽歌 其二","author":"徐熥","text":"谁知五马客，竟作九原人。\n出郭有魂气，还家惟影神。\n墓中难待晓，地下不行春。\n斯世无同调，悲歌泪满巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23109,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"故黎平太守袁公挽歌 其三","author":"徐熥","text":"白马出关门，愁闻鼓吹喧。\n山灵收正气，月色引归魂。\n贵至二千石，书馀几万言。\n翩翩丹旐过，犹讶转朱轓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23110,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"故黎平太守袁公挽歌 其四","author":"徐熥","text":"赤绂人何处，青山骨可藏。\n乡邻悲道路，父老泣蛮方。\n图史虚东壁，松楸冷北邙。\n明君思起草，犹问秘书郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23111,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林伯仪自金陵还莆过访话别","author":"徐熥","text":"为客经淮楚，归途访索居。\n云山一骑远，烟柳六朝疏。\n问路知乡近，还家及岁除。\n陆生装薄甚，惟有一囊书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23112,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"癸巳除夕","author":"徐熥","text":"又见韶华换，空为老大悲。\n齿添新岁历，酒祭一年诗。\n流落忧前路，欢娱忆少时。\n生憎箫管恶，苦向隔邻吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23113,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]