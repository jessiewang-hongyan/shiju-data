[{"title":"送武安同福安柩归西江 其一","author":"金幼孜","text":"望断天涯去不还，空馀血泪染衣殷。\n西江万里归遗骨，烟水漫漫渺故山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4749,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送武安同福安柩归西江 其二","author":"金幼孜","text":"天地无情白日悲，临岐相送忍相违。\n江南草绿蘼芜怨，肠断东风哭子时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4750,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为戴容安题扇竹","author":"金幼孜","text":"三径清阴生昼寒，满林新长碧琅玕。\n何时截作参差玉，吹向瑶台听紫鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4751,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画扇写金陵送别","author":"金幼孜","text":"杨柳深深映画楼，君行又上木兰舟。\n夜深正好看明月，莫放青山过石头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4752,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为萧迪宽题息斋竹","author":"金幼孜","text":"亭亭玉节映琅玕，岁晏相看有二难。\n何日相从携凤管，夜深吹月向云端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4753,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为叶仲畴题兰竹 其一","author":"金幼孜","text":"绿叶葳蕤间紫茎，幽芳澹浥露华清。\n美人遥隔湘江外，解佩何当寄远情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4754,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为叶仲畴题兰竹 其二","author":"金幼孜","text":"自是芳姿不涴尘，西风凉露散清芬。\n莫嫌空谷无人到，岁晏相看有此君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4755,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题王母蟠桃","author":"金幼孜","text":"西来王母载河车，羽盖翩翩映紫霞。\n燕罢瑶池春似海，东风开遍碧桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4756,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题胡太守五马图","author":"金幼孜","text":"逸气腾空不可羁，几回联步上天墀。\n东风二月棠阴合，夹道争迎五马归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4757,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为兄贵质题鹡鸰图","author":"金幼孜","text":"忆昨离家忽四年，客居长诵鹡鸰篇。\n相看无奈离情苦，岁晏梅华雪满天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4758,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠人之官通判","author":"金幼孜","text":"满城烟雨落花深，离思纷纷恼客心。\n向晓玉堂揩病目，送行谩复写新吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4759,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题徐崇威所藏贵妃上马图","author":"金幼孜","text":"道前宝扇拥花骢，当日君恩第一浓。\n不是华清事游幸，后人那得见娇容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4760,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"云林书屋为萧深州赋","author":"金幼孜","text":"一径深深长绿阴，云山高下树幽森。\n闭门尽日无人到，时有书声出远林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4761,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"刘商观奕图为曾景武赋","author":"金幼孜","text":"一局忘言意若何，古松流水白云多。\n回看石室山前路，肯信樵夫有烂柯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4762,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竺上人卷","author":"金幼孜","text":"閒云流水意悠然，上谷弥陀别有天。\n欲识禅心清净处，一轮明月照窗前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4763,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"庚戌腊月十四夕写怀","author":"金幼孜","text":"末学深惭忝禁林，空馀白发伴丹心。\n平生事业知无补，坐对青灯感慨深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4764,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"立春赐宴拜和御制","author":"金幼孜","text":"海宇春回瑞景迟，年丰民物乐熙熙。\n彤庭锡宴皆沾醉，千载君臣庆会时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4765,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"恭和御制诗","author":"金幼孜","text":"熙熙海宇被仁风，民物讴歌乐岁丰。\n圣主优贤隆眷遇，愚臣何幸重遭逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4766,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"恭和御制喜雨诗有序","author":"金幼孜","text":"雨顺风调屡岁丰，民安物阜万方同。\n吾皇圣德躬勤俭，感格天心恊至公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4767,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹","author":"金幼孜","text":"翠拂琅玕落粉香，无端春色满潇湘。\n美人学得青鸾曲，何处吹箫听凤凰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4768,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为孔守忠题马","author":"金幼孜","text":"曾睹天闲八尺龙，骁腾万里振长风。\n只今图画看神骏，无复承恩侍九重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4769,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题扇画","author":"金幼孜","text":"数声黄鸟绿阴稠，一片青山翠欲流。\n坐久不知花落去，閒身只为白云留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4770,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题子昂马为赵君公复作","author":"金幼孜","text":"太液初晴雪正融，金羁新试渥洼骢。\n几回天上从銮驭，牵度长扬立晚风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4771,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题墨菊","author":"金幼孜","text":"自是芳姿不涴尘，晓妆如洗露华新。\n玉英粲粲黄金色，斜倚东篱日又曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4772,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"望惠山","author":"王惟允","text":"昔者岁庚戌，承檄离故乡。\n遽以此山别，关陕隔异方。\n缅怀林壑姿，令人归思长。\n潇洒栖白云，青松荫石床。\n泠泠第二泉，流润石髓香。\n今辰罢官守，春风促归航。\n青青九龙峰，郁然当我藏。\n我本江海人，泉石有膏肓。\n一从挂尘网，鬓发已苍苍。\n寄谢桑苧翁，卜邻漪澜堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4773,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"李丞相读书台","author":"朱升","text":"昔贤曾习静，为客借僧堂。\n听法过苔径，摊书据石床。\n佛灯然雨暗，僧饭煮泉香。\n虽自纡朱组，幽期岂暂忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4774,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过听松庵二首 其一","author":"顾协","text":"偶得读书暇，来寻野衲家。\n涧鸣凤乍起，山暝日初斜。\n到树惊啼鸟，推窗见落霞。\n同游郑高士，坐石共分茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4775,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过听松庵二首 其二","author":"顾协","text":"偶来林下叩松关，分得禅僧半日闲。\n孤兴忽生流水外，高情聊寄白云间。\n炊烟晚映高低树，落日晴分远近山。\n今夜西岩有明月，更留清话不知还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4776,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题一碧轩次范德章韵","author":"周文孚","text":"轩下水天同一色，眼中物色向谁论。\n落霞散尽秋无际，老鹤飞来雪有痕。\n空洞玉壶盛沆瀣，苍凉碧月照黄昏。\n他时若待吟风去，云梦微茫气欲吞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4777,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"观柳道传太宰留题惠山诗卷","author":"周文孚","text":"五云楼阁锦成堆，仿佛山光百里开。\n天上神龙行雨去，日边骢马踏花来。\n千年兰若春余梦，百世文章劫后灰。\n惟有石泉流不尽，月明犹照鹤飞回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4778,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游惠山","author":"沈睿","text":"春风吹我步烟霞，路入苍苔一径斜。\n新绿漫添平岸水，湿红轻送过墙花。\n劳劳尘世寻常事，隐隐烟村四五家。\n物理细推行乐好，莫从愁里过年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4779,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太湖春涨","author":"冯善","text":"震泽春深涨碧漪，静涵天影漾玻璃。\n遥增越峤千寻阔，顿减吴山数尺低。\n红泛落花通别浦，绿含芳草漫长堤。\n钓舟昨夜归来晚，没却渔矶路亦迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4780,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南禅宝塔","author":"冯善","text":"七级浮屠势壮哉，千年高枕古城隈。\n丹甍碧瓦排云起，朱户雕栏倚汉开。\n十里传闻金铎响，半天飞下玉龙来。\n几回登览舒长啸，声逐清风落九垓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4781,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄朱彦升东郭居","author":"赵次钧","text":"耿耿伤离居，幽情日萧索。\n霜寒林木变，石出溪水落。\n抱冲思寡俦，同志念非昨。\n援琴写素怀，值子在东郭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4782,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿泗州寺","author":"吕敏","text":"纤月堕高林，清风洒疏竹。\n山僧沐相慰，云榻留共宿。\n坐凉交竹阴，炉温蔼兰馥。\n于焉为申章，庶以写幽独。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4783,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"石门","author":"殷序","text":"石门我来不厌频，悠然欲酌还自酌。\n千崖冥冥送雨来，万木纷纷向人落。\n丹邱已会烦青鸟，青田犹未见元鹤。\n句漏小住亦多时，便欲从此凌寥廓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4784,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游惠山柬韶石师","author":"尤谡","text":"背郭山无十里赊，上方楼阁锁烟霞。\n径连夜色迷芳草，泉带寒香泛落花。\n斋钵暂收云外菌，竹炉聊试雨前茶。\n道人知我耽诗癖，共倚长松到日斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4785,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"笠泽","author":"秦旭","text":"溶溶新水满平湖，舴艋西风十幅蒲。\n轻逐断云归百粤，远冲寒雨落三吴。\n势凌星斗如奔马，远拂沧州起浴凫。\n周道只今平似砥，不须翘首羡莼鲈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4786,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游鸿山","author":"秦旭","text":"梁鸿山下放归舟，细雨微风晚不收。\n灯影凄迷过半夜，客怀牢落似三秋。\n老无白雪酬知己，贫有黄金买莫愁。\n一曲吴歌惊梦觉，起看河水带星流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4787,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"仲秋八月与继芳游天全亭","author":"秦旭","text":"峨峨九龙山，迢迢五湖岸。\n扁舟弄云水，山影波底乱。\n遥瞻松桂林，已觉风景换。\n长吟斜川诗，惊鸥忽飞散。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4788,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"甲辰正月六日继芳邀社予以眩疾不赴诗以申谢","author":"秦旭","text":"头白昏昏只欲眠，招呼长荷社中贤。\n余生待毙鬼门下，良会负期人日前。\n畏酒暂辞金谷罚，酌泉重结惠山缘。\n春湖绿涨桃花水，烦借米家书画船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4789,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与懋成惟清公禄叔理舜明山行归途和韵二首 其一","author":"秦旭","text":"落梅风急放湖船，六客逍遥是散仙。\n雪白河豚新图入，鹅黄杨柳未成绵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4790,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与懋成惟清公禄叔理舜明山行归途和韵二首 其二","author":"秦旭","text":"松庵相地开诗社，花市留衣当酒钱。\n寄语诸公慎终始，莫因勤怠误流年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4791,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"立夏前一日偕梅庵立夫过新安别墅","author":"秦旭","text":"裹得新茶立夏前，白龙桥下泛湖船。\n红云压地蔷薇海，黑雨翻空玳瑁天。\n急景任教随逝水，闲情何必问流年。\n山林钟鼎初能了，更与诸公保万全。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4792,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"野翁山居","author":"施廉","text":"清晨梳我头，有客过茅宇。\n呼儿具尊罍，展席集朋侣。\n钩帘对青山，潇潇落疏雨。\n可人期不来，相思渺何许。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4793,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与余民用、潘时觐同游惠山","author":"杨璿","text":"前朝湛氏宅，十载一经行。\n境胜多题咏，僧闲少送迎。\n松风禅榻静，花雨石床平。\n共饮山中水，萧然脱世情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4794,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨憩听松阁","author":"杨璿","text":"山雨正冥冥，山僧开翠屏。\n水拖千涧白，云约半峰青。\n石髓分茶鼎，尘心静佛经。\n松风坐来定，余韵绕檐楹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4795,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陆墟别业","author":"杨璿","text":"文笔峰前湖水西，幽栖地僻少轮蹄。\n花间稚子坐垂钓，竹下老翁行灌溪。\n酒熟漫判金谷饮，诗成先许锦笺题。\n已闻孙笋如蓬贱，更说雕胡似掌齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4796,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"安阳山","author":"杨璿","text":"宦辙东西未得还，十年飞梦绕家山。\n一时胜会非良偶，半世浮名总是闲。\n幽境会心诗里写，野花随意醉中攀。\n君恩早晚容归老，准拟常依水竹间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4797,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵天全公东济川上人二首 其一","author":"杨璿","text":"兰若迢遥信马行，浓花随处笑风情。\n英台仙去名犹在，清磬僧闲手自鸣。\n晓认千峰春有迹，月明万簌夜无声。\n石床细扣愣伽旨，怪底东方白易生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4798,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵天全公东济川上人二首 其二","author":"杨璿","text":"香断炉烟冷博山，蒲团坐老不知还。\n万松遮寺青围屋，一水通桥绿转湾。\n喜雨亭高云作阵，读书庵古藓生斑。\n诗成欲倩题崖石，笔意谁探柳与颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4799,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题孟氏惠麓小隐","author":"秦夔","text":"饥后家何在，归来始定居。\n丹心三尺剑，白首五车书。\n戚畹名犹在，云台业未疏。\n结庐来小隐，岁晚足耕锄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4800,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"锡谷书堂","author":"秦夔","text":"锡谷逶迤山水幽，中有隐者之飞楼。\n二泉烟霞半敛夕，九龙爽气常宜秋。\n吟边落日动遐思，望里平湖消客愁。\n山灵珍重此呵护，更约临风来上头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4801,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"复竹茶炉","author":"秦夔","text":"烹茶只合伴枯禅，误落人间五十年。\n华屋梦醒尘冉冉，湘江云冷月娟娟。\n归来白璧原无玷，老去青山最有缘。\n从此远公须爱惜，愿同衣钵永相传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4802,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同金广信宗器游番湖","author":"秦夔","text":"番湖水落秋容冷，碧色澄鲜三万顷。\n楼船嗷嘈何处来，十幅蒲帆弄秋影。\n霜晴九月葭苇枯，芙蓉著花秋满湖。\n吴兴巳远郭熙老，谁为写此秋江图。\n汀洲远近迷云树，东去沧波急如注。\n康山一发天际横，传是先皇洗兵处。\n当年血战湖水黄，日月照耀旌旗光。\n鼎湖龙去不复返，只有雁鹜飞茫茫。\n天开大泽雄今古，气撼东吴及南楚。\n巴陵洞庭何处边，目断浔阳送楼橹。\n北风猎猎握双旌，此行奇绝如登瀛。\n风波平地不须起，向来魂梦今犹惊。\n浩歌蓬底还搔首，却忆同行信州守。\n萍水飘零尽白头，相逢且醉馀干酒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4803,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖南草堂","author":"秦奭","text":"竹里衡门掩翠微，自将荷叶制春衣。\n园林雨过梅初熟，池馆风轻燕学飞。\n浊酒半缸怕我老，短琴三弄识人稀。\n明朝准买湖南棹，拟向沙头理钓丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4804,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"溪桥散步","author":"秦奭","text":"老去观书兴易阑，绿阴清昼况多闲。\n杖藜扶我溪头步，看尽湖南十里山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4805,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"龚行俭以扇索画","author":"秦奭","text":"行过溪桥日欲低，绿阴满地郭公啼。\n微风轻飏茶烟起，知有人家在竹西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4806,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"龚守诚山庄邀赏桃花和韵","author":"秦镗","text":"桃花何以武陵溪，试唱新吟续旧题。\n游舫半通沙市外，故人多在画桥西。\n山横翠霭连书屋，春酿红香拂杖藜。\n酒尽一尊归去晚，晴郊散步夕阳低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4807,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋暮过田庄","author":"秦镗","text":"十里蓉湖漫紫烟，葑溪来渡夕阳船。\n江村莽苍初寒候，杨柳昏黄欲暮天。\n白鸟有情迎我惯，好怀无句惬秋妍。\n少陵此兴今何在，一段风情寄八篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4808,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"斗室","author":"秦霖","text":"乏金难买地，结屋仅容身。\n帘破能通燕，檐低欲碍巾。\n曲肱时肆态，抱膝屡凝神。\n莫笑规模窄，中藏万斛春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4809,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"希夷道院","author":"秦霖","text":"图南曾憩迹，作院号希夷。\n地古莓苔老，林春草木滋。\n榻闲仙久化，人到鹤先知。\n愿借西亭竹，吟镌小体诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4810,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"筑凤谷行窝成","author":"秦金","text":"名山投老住，卜筑有行窝。\n曲涧盘幽石，长松窅碧萝。\n峰高看鸟度，径僻少人过。\n清梦泉声里，何缘听玉珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4811,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月夜江行","author":"秦金","text":"使舟摇曳汉江浔，望里乾坤思不禁。\n沙市淡烟笼树远，柁楼明月射波深。\n流亡满地惭荒政，风景撩人惜浪吟。\n欹枕中宵清不寐，漫惊时序百年心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4812,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南征凯旋次楚王韵","author":"秦金","text":"勋名何敢望旃常，忧国心劳鬓欲苍。\n马厌风尘还蹀躞，鸟惊霄汉几回翔。\n甲兵胸次元惭范，韬略军中每效穰。\n珍重贤王勤慰奖，百篇珠玉照遐方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4813,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和邵宝游竹山诗韵","author":"秦金","text":"乾坤何处寄真游，晴日平湖万顷秋。\n云叶洗空天宇净，浪花飞动竹山浮。\n少陵诗兴高千古，司马襟怀溢九州。\n我亦欲留双眼碧，蓬莱遥望海东头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4814,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"石门","author":"顾可久","text":"达人不婴物，雅好在邱园。\n晨兴念山游，邀客观石门。\n绿崖屡登顿，度径奋层骞。\n怀新意转胜，悲往鉴独存。\n前瞻缅江屿，俯瞰临郊原。\n石窦红泉细，鸟道白云屯。\n昭旷荡胸臆，窈窕屏嚣喧。\n朋簪惊绝倒，仙舄遥翩翻。\n复此泉上酌，谷响思穷源。\n非君多道韵，表灵谁能论。\n来者其自今，风流眷弥敦。\n倘事诠图牒，聊用嗣所言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4815,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋怀","author":"顾可久","text":"异域沧溟上，孤城斥卤中。\n经过稀汉使，托处杂黎戎。\n最苦黄茒瘴，兼愁铁飓风。\n谁能忍羁旅，转泊逐飘蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4816,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登惠山绝顶瞻望吴越五湖","author":"顾可久","text":"兹游亦已屡，今上最高峰。\n水落洞庭远，山围吴会重。\n顾瞻悲浊世，凌厉觅奇踪。\n独羡鸱夷子，扁舟欲往从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4817,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]