[{"title":"古像赞二百零五首 其七十二 司马宣王","author":"孙承恩","text":"仲达足智，用兵独优。\n殄渊擒达，算无遗谋。\n仁胜不仁，遇亮则靡。\n巾帼之受，英雄之耻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其七十三 吴大帝","author":"孙承恩","text":"仲谋强明，委任才智。\n听言能断，业乃鼎峙。\n倍义负汉，屈身事曹。\n传世四君，霸图亦消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其七十四 周公瑾","author":"孙承恩","text":"矫矫公瑾，实吴良臣。\n雄姿英发，筹策迈伦。\n老瞒长驱，志无江表。\n一战蹙之，功莫与绍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其七十五 晋武帝","author":"孙承恩","text":"帝资弘裕，明达好谋。\n纂述先志，混一九州。\n礼优三恪，忠厚之道。\n贻谋弗臧，识者所少。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其七十六 晋元帝","author":"孙承恩","text":"晋失中土，元起江东。\n皇天眷德，群贤效忠。\n冲虚性成，恭德纯至。\n雄武未优，中兴犹愧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其七十七 王司徒","author":"孙承恩","text":"江左夷吾，忠实体国。\n云雷方屯，急贤辅翼。\n建学明教，宏议远识。\n约巳夷淡，人服清德。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其七十八 谢文靖公","author":"孙承恩","text":"谢子贤辅，沉敏有文。\n和靖御物，从容解纷。\n逸志高情，日短途促。\n召埭悲思，西州恸哭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其七十九 王右军","author":"孙承恩","text":"风节雅尚，清真自如。\n超出风气，规切浮虚。\n忧国忠诚，识治通达。\n翰墨风流，秪见其末。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其八十 陶彭泽","author":"孙承恩","text":"渊明气象，五斗弗屑。\n三径艺菊，相看晚节。\n朝市非故，门庭依然。\n千古高风，我怀其贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其八十一 谢康乐","author":"孙承恩","text":"山水性僻，绳墨靡拘。\n高才傲物，谋身则疏。\n彭泽天然，子亦洵美。\n声诗并休，静躁殊矣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其八十二 宋武帝","author":"孙承恩","text":"徒步仗剑，荡残除凶。\n沉毅才略，一时之雄。\n震主功高，终膺宝历。\n清俭严正，可谓君德。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其八十三 宋文帝","author":"孙承恩","text":"恭俭德纯，元嘉政美。\n守法不苛，容物无弛。\n内清外宴，文教亦举。\n谋泄房帷，祸成商竖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其八十四 檀永兴公","author":"孙承恩","text":"永兴桓桓，将才汝嘉。\n勇见决战，智徵量沙。\n作帝股肱，为国藩屏。\n自戕谓何，邻敌之庆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其八十五 魏高祖","author":"孙承恩","text":"睿性夙成，君德纯备。\n外扬武功，内饬文治。\n礼乐脩举，民物阜丰。\n蔚然可观，太平之风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其八十六 齐武帝","author":"孙承恩","text":"宋既讫符，齐乃受历。\n简静为治，宽大御物。\n崇俭屏奢，澄流塞源。\n金土同价，斯言未然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其八十七 梁武帝","author":"孙承恩","text":"著述浩穰，齐鲁宿儒。\n性行简俭，山泽之臞。\n梵典徒勤，帝纪不立。\n反噬弯弧，皇图遂讫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其八十八 昭明太子","author":"孙承恩","text":"睿资天启，令德夙闻。\n恭俭自居，仁柔爱人。\n纂辑辞章，博涉典籍。\n潜文梵教，兹其蔽惑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其八十九 程忠壮公","author":"孙承恩","text":"侯氏乱梁，江左荼毒。\n惟忠壮公，保障南服。\n孰我胁诱，我斩以徇。\n大义茂功，百世犹信。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其九十 陈武帝","author":"孙承恩","text":"英资杰气，胜算雄图。\n荡除凶残，如拉朽枯。\n政从宽仁，志尚节俭。\n功名之盛，江左之冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其九十一 周高祖","author":"孙承恩","text":"率履勤俭，操执纪纲。\n雄图远略，匹休前王。\n鞭笞四夷，混一区宇。\n有志未酬，英雄巳矣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其九十二 隋文帝","author":"孙承恩","text":"勤俭兴邦，法律御世。\n功就混一，俗几康乂。\n猜刻习胜，夺宗计行。\n酿成厉阶，王祚遂倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其九十三 文中子","author":"孙承恩","text":"进欲为周，上策君门。\n退欲为孔，著书河汾。\n疏爽通达，志尚亦伟。\n格言良多，称隐君子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其九十四 韩新义公","author":"孙承恩","text":"韩公虎臣，猛气横骛。\n徂征江南，疾捲径渡。\n执彼国君，若缚狐兔。\n为时干城，恢我王祚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其九十五 唐高祖","author":"孙承恩","text":"真人天生，隐见随时。\n忽而泥蟠，忽而云飞。\n扫涤隋昏，光启唐祚。\n礼贤纳谏，大君之度。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其九十六 唐太宗","author":"孙承恩","text":"显允太宗，聪明英武。\n龙奋晋阳，雨泽九土。\n安夏攘夷，雪耻酬古。\n文德武功，卓冠无伍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其九十七 武后","author":"孙承恩","text":"力乘阳刚，才济阴慝。\n运用四海，驱使百辟。\n今古大变，宇宙穷凶。\n虐焰一时，秽名无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其九十八 唐玄宗","author":"孙承恩","text":"廓清内难，光践天位。\n推诚任贤，励精图治。\n四海宁谧，兆民阜成。\n开元之政，百世犹存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其九十九 唐德宗","author":"孙承恩","text":"畴咨惟勤，志意亦锐。\n斤斤其明，彊倖自遂。\n忌刻于始，姑息于终。\n弊源在兹，多言何庸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一○○ 唐宪宗","author":"孙承恩","text":"志感时艰，治慕祖烈。\n好谋惟明，成功惟决。\n强梗效顺，纪纲遂张。\n允毅允臧，中兴煌煌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一○一 唐武宗","author":"孙承恩","text":"君得臣兴，臣得君行。\n君臣道合，事乃有成。\n裕既贤弼，帝亦英主。\n会昌之功，卓然可纪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一○二 唐宣宗","author":"孙承恩","text":"法无偏颇，志尚勤俭。\n惜赏慎官，好贤纳谏。\n我思大中，亦汔小康。\n忌刻害治，卒以弗昌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一○三 长孙赵公","author":"孙承恩","text":"决谋辅主，定策立储。\n武事非长，忠恳有馀。\n辅治永徽，人多汝绩。\n孽后肆屠，天下共惜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一○四 房梁公","author":"孙承恩","text":"梁公善谋，神机朗彻。\n推毂群材，翊赞大业。\n端委宅揆，寅亮天工。\n定制作则，一代元功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一○五 杜蔡公","author":"孙承恩","text":"蔡公睿姿，明决果断。\n辅相真主，戡定祸乱。\n相资共济，协恭和衷。\n治登太平，令名无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一○六 李英公","author":"孙承恩","text":"矫矫英公，为时良将。\n料敌制变，敌莫与抗。\n荡定海宇，实多武功。\n孽后祸基，乃亏臣忠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一○七 李卫公","author":"孙承恩","text":"于惟卫公，雄武沉毅。\n掌帝九伐，扫荡氛翳。\n氛翳既清，泰阶以平。\n铁山峣峣，武功并高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一○八 魏郑公","author":"孙承恩","text":"蹇蹇郑公，维古遗直。\n补衮纳忠，危言正色。\n诋黜霸杂，敷陈义仁。\n贞观治效，功无与伦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一○九 褚河南公","author":"孙承恩","text":"河南蹇蹇，王魏之伦。\n在太宗时，谠言屡闻。\n牝鸡祸成，徒切忠谏。\n主德则昏，公节愈见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一一○ 尉迟鄂公","author":"孙承恩","text":"烈烈猛气，纠纠雄力。\n崩围摧阵，前无坚敌。\n刚毅木讷，庶几其人。\n于古孰似，绛灌之伦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一一一 虞永兴公","author":"孙承恩","text":"识综群儒，博冠当代。\n考究典章，熙帝之载。\n乃缉礼乐，乃开辟雍。\n文教肆行，维公之功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一一二 狄梁公","author":"孙承恩","text":"妖后乱唐，王祚欲绝。\n批龙扼虎，几蹈祸烈。\n拨乱反正，捧日再升。\n社稷之功，孰能与争。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一一三 姚梁公","author":"孙承恩","text":"于惟姚公，才实经济。\n遇主乘时，应变成治。\n约束官职，修举章程。\n四海以安，一人仰成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一一四 宋文贞公","author":"孙承恩","text":"抗颜伪武，合志闻元。\n挺挺谔谔，切论危言。\n清介之守，刚正之气。\n卓哉相业，吁其难继。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一一五 元鲁山","author":"孙承恩","text":"元子大雅，制行纯笃。\n孝友配古，清介绝俗。\n浑朴外著，英华内韬。\n人接眉宇，鄙吝自消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一一六 张曲江公","author":"孙承恩","text":"立朝謇谔，大臣之节。\n制作尔雅，词林之杰。\n识达治本，逆睹胡孽。\n一代贤辅，式慕风烈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一一七 郭汾阳王","author":"孙承恩","text":"尚父功高，再造唐室。\n力扫妖氛，忠贯白日。\n完名全节，福禄永终。\n人臣师表，流芳无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一一八 李临淮王","author":"孙承恩","text":"气盖三军，威摄群将。\n法令严明，莫我或抗。\n纳谏励士，麾旗破敌。\n中兴之功，令名有赫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一一九 颜鲁公","author":"孙承恩","text":"乌合抗胡，白首陷贼。\n秉执节义，甘蹈鼎镬。\n坐斥降奴，视若蚁虱。\n劲气孤忠，严霜烈日。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一二○ 张睢阳","author":"孙承恩","text":"百鍊刚心，千锤义骨。\n应变出奇，风云倏忽。\n手障长淮，气吞逆胡。\n天道人伦，百世不诬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一二一 贺季真","author":"孙承恩","text":"季真何如，性行夷旷。\n士钦风韵，帝许高尚。\n黄老寄迹，曲蘖逃真。\n镜湖一曲，流风至今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一二二 杜工部","author":"孙承恩","text":"诗圣惟甫，崇雅镇浮。\n力敌元化，手遏颓流。\n宗社隐忧，稷契素志。\n一时旅人，令名百世。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一二三 李翰林","author":"孙承恩","text":"天才踔发，逸气横出。\n龙骧鹏抟，不可控执。\n友视万乘，奴使贵珰。\n采石捉月，神游不忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一二四 陆宣公","author":"孙承恩","text":"颠沛从君，恳恻献替。\n练达古今，本祖仁义。\n唐室不竞，公用不终。\n遗言若丹，人仰休风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一二五 李西平王","author":"孙承恩","text":"烈烈西平，社稷是寄。\n讨定叛逆，一雪国耻。\n巍巍柱天，赫赫盖世。\n钟鼎勒勋，山河存誓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一二六 裴晋公","author":"孙承恩","text":"功在王室，名闻外夷。\n柱石三朝，系时安危。\n晚节优游，大雅明哲。\n全德始终，永仰风烈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一二七 韩文公","author":"孙承恩","text":"道丧文衰，子克振起。\n排斥老佛，发挥洙泗。\n并包百家，源委六经。\n北斗泰山，百世尔承。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一二八 柳柳州","author":"孙承恩","text":"才气颖敏，莫邪干将。\n制作彪炳，凌跞班扬。\n锐进速成，爰致玷缺。\n文场擅宗，令名不没。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一二九 孟东野","author":"孙承恩","text":"雕肝镂心，苦吟浚索。\n句联韩豪，才配白敌。\n诗非穷人，惟穷乃工。\n风雅百篇，将无是同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一三○ 贾浪仙","author":"孙承恩","text":"冥思犯尹，夺册忤君。\n寄兴清苦，刊落华纷。\n人亦有言，士附青云。\n识拔昌黎，子乃有闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一三一 白少傅","author":"孙承恩","text":"早登王朝，忠谠屡闻。\n再逐江州，与时浮沉。\n鸡林声价，香山踪迹。\n宠利淡然，可谓达识。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一三二 柳河东","author":"孙承恩","text":"经术名世，翰墨绝人。\n笔谏之言，有至理存。\n服涴弗贺，纳嬖谏止。\n诤臣之风，王魏其侣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一三三 李卫公","author":"孙承恩","text":"风采峻凝，经济自任。\n威慑强藩，王灵再振。\n议论侃侃，忠勤孜孜。\n克伐必行，贤者之疵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一三四 周世宗","author":"孙承恩","text":"世宗英明，志存混一。\n服强以力，怀弱以德。\n武功既振，文治亦修。\n宏规大度，邈焉寡俦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一三五 宋太祖","author":"孙承恩","text":"宋祖龙兴，仁厚建国。\n笃尊圣道，式著君德。\n慎狱恤民，惩奢塞源。\n身端化本，大哉王言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一三六 宋太宗","author":"孙承恩","text":"显允太宗，重光御世。\n修德弭灾，仁民图治。\n节重山林，功略宦寺。\n太平之政，蔚然可纪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一三七 宋仁宗","author":"孙承恩","text":"穆穆仁宗，实惟盛德。\n奉身清约，议论恳恻。\n学勤讲筵，治法无逸。\n昭陵之思，百世一日。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一三八 宋高宗","author":"孙承恩","text":"宋祚中否，高宗再兴。\n五马兆祥，七庙委灵。\n志亏勾践，才谢光武。\n恢复成虚，遗恨千古。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一三九 宋孝宗","author":"孙承恩","text":"性资英明，治行勤励。\n恢复拳拳，可质天地。\n治民振武，敬天仁民。\n事机屡乖，志卒弗伸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一四○ 宋宁宗","author":"孙承恩","text":"始政清明，登用儒硕。\n继体守文，兢业靡失。\n内斥正学，外挑强邻。\n权奸何诛，彼哉曷君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一四一 宋理宗","author":"孙承恩","text":"允矣贤德，俨然儒绅。\n表章正学，崇重关闽。\n虚名独存，实践未有。\n儒效不白，匪道之咎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]