1e979e35a2b94cc","dynasty":"明"}},{"title":"游峨眉山纪行 其二","author":"方孝孺","text":"西蜀云山处处奇，最奇人说在峨眉。\n想应踏遍千崖月，露滴松梢鹤梦时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58227,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游峨眉山纪行 其三","author":"方孝孺","text":"出郭凉风入抱清，乱山遮马似相迎。\n宁知待召登瀛客，忽作看云听水行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58228,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游峨眉山纪行 其四","author":"方孝孺","text":"王怜尘土辱凡肌，命入云山茹紫芝。\n只恐同袍不相识，误猜礼佛到峨眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58229,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游峨眉山纪行 其五","author":"方孝孺","text":"客久贤王两赐衣，不知春到巳春归。\n清朝试出都门看，留得残红一片飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58230,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游峨眉山纪行 其六","author":"方孝孺","text":"山头月出天初露，江面风生水欲波。\n正是胜游新得意，片云相引入岷峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58231,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游峨眉山纪行 其七","author":"方孝孺","text":"朝辞宫阙莫田家，江白山清两岸沙。\n卧犬不惊篱落静，麦风檐底响缲车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58232,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游峨眉山纪行 其八","author":"方孝孺","text":"孤舟湖口一名僧，咫尺乡山识未曾。\n今去峨眉同览胜，跻扳须上百千层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58233,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游峨眉山纪行 其九","author":"方孝孺","text":"名山佳处孰同游，白发缁衣四五流。\n青眼古铭乡士彦，灯前夜夜话台州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游峨眉山纪行 其十","author":"方孝孺","text":"学仙无骨佛无缘，甘着儒冠坐一毡。\n入社敢同陶靖节，不须三笑虎溪前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入山后览定水仰山二上人并吴讲师次予发成都绝句韵因复次韵述事言怀 其一","author":"方孝孺","text":"落日斜明挂树瓢，下方城郭去人遥。\n青山过雨僧深定，门外云封独木桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入山后览定水仰山二上人并吴讲师次予发成都绝句韵因复次韵述事言怀 其二","author":"方孝孺","text":"羽客禅僧也好奇，对人觅句几攒眉。\n林端新月初高夜，叶底残红落尽时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入山后览定水仰山二上人并吴讲师次予发成都绝句韵因复次韵述事言怀 其三","author":"方孝孺","text":"倚涧人家近更清，吠风惊犬走还迎。\n衲衣鹤氅从章甫，落日看山一字行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58238,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入山后览定水仰山二上人并吴讲师次予发成都绝句韵因复次韵述事言怀 其四","author":"方孝孺","text":"山南夫子待多时，庭外松花落涧芝。\n夜半梦回闻鼓响，觉来颡泚冷沾眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58239,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入山后览定水仰山二上人并吴讲师次予发成都绝句韵因复次韵述事言怀 其五","author":"方孝孺","text":"涧底白头僧浣衣，云间童子负薪归。\n幽栖更羡投林鸟，半巳寻巢半巳飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58240,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入山后览定水仰山二上人并吴讲师次予发成都绝句韵因复次韵述事言怀 其六","author":"方孝孺","text":"千寻古木巳无柯，万丈深渊不起波。\n此日胜游他日记，落花时节到中峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58241,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入山后览定水仰山二上人并吴讲师次予发成都绝句韵因复次韵述事言怀 其七","author":"方孝孺","text":"东海西头是我家，门前花径接鸥沙。\n三年别后徒多恨，敢道诗书读五车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58242,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入山后览定水仰山二上人并吴讲师次予发成都绝句韵因复次韵述事言怀 其八","author":"方孝孺","text":"山行十日只逢僧，尽道蒙恩报未曾。\n共上峨眉望宫阙，祥云五色绕三层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58243,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入山后览定水仰山二上人并吴讲师次予发成都绝句韵因复次韵述事言怀 其九","author":"方孝孺","text":"奉诏名山作胜游，壮怀如水不停流。\n今朝独坐峨眉顶，一览端能隘九州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58244,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入山后览定水仰山二上人并吴讲师次予发成都绝句韵因复次韵述事言怀 其十","author":"方孝孺","text":"榻借禅那岂夙缘，坐来浑似旧家毡。\n祗应心事惭苏晋，不解长斋绣佛前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58245,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵写怀送叔贞之成都十七首 其一","author":"方孝孺","text":"道济群生心尚歉，知周万物礼逾勤。\n能为世上难行事，始是人中寡过人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58246,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]