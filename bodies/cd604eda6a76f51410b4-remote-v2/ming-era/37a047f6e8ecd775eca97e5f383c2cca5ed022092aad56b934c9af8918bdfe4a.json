4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题杂画 其十二","author":"王世贞","text":"遥岑吐飞瀑，如泻银河水。\n本自爱人间，翻落白云里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题紫筠居三绝 其一","author":"王世贞","text":"过雨千林湿，高斋色自肥。\n箨龙一夜长，片片紫云飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题紫筠居三绝 其二","author":"王世贞","text":"新篁节未解，已作干云碧。\n偶然三径开，错拟扬雄宅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题紫筠居三绝 其三","author":"王世贞","text":"长桑夙有尚，自与此君宜。\n不独坚贞在，兼令俗可医。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂梦三绝句 其一","author":"王世贞","text":"夜来梦失官，青山色为动。\n无那梦醒时，此身还属梦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂梦三绝句 其二","author":"王世贞","text":"梦饮蓟门酒，忽复还乡国。\n犹胜觉后身，匏系太行北。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11824,"sha256":"ed4816f919f168ab0