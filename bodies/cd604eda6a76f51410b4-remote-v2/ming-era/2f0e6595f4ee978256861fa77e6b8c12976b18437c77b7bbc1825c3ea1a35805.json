[{"title":"游观音山","author":"陶益","text":"观音山下暂停舟，鸿迹依然忆旧游。\n侠客倚栏延眺望，篙人喧语莫淹留。\n炉烟出洞钟声杳，瓶水涵花梵宇幽。\n笑我江湖多孟浪，十年奔走剩离忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9968,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别乡人入永新河","author":"陶益","text":"岛影盘河出，滩声竟日悬。\n漫寻多士里，聊上永新船。\n鱼雁空分去，图书自渺然。\n奚奴忙料理，催棹截长烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9969,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四相书院夜坐有感","author":"陶益","text":"青藜灯火照书帏，上相堂虚月并辉。\n深夜乘閒还打坐，侍童怕冷尽求归。\n怀莼久客情偏重，缩地非仙愿独违。\n心折此时闻蟋蟀，更堪声雁又南飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9970,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次永新冬至","author":"陶益","text":"鲤鱼风起过禾川，侨寄俄将臈月天。\n篱落有花凌白雪，葫芦无酒任苍烟。\n思归未作陶潜赋，入梦空惊范蠡船。\n至日又增明发念，顿令簪组祝尧年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9971,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题雪景","author":"陶益","text":"几度寻梅出帝京，冒寒驴背句偏成。\n霜飞涧道瑶华洁，霰集云根玉屑清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9972,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凉风至","author":"陶益","text":"何处凉飙发，庭前落木知。\n初秋争淅沥，薄暮转凄其。\n感旧心千里，迎寒酒一卮。\n霜花摇未见，吹帽接疏篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9973,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观飞奴","author":"陶益","text":"爱尔飞奴鶱翮轻，凭虚遥望转关情。\n日边似露奎星影，云里如移玉佩声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9974,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙丑秋喜家赏月二首 其一","author":"陶益","text":"忆昔中秋客异乡，自怜形影倍凄凉。\n今宵对月庭前拜，喜见儿孙学雁行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9975,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙丑秋喜家赏月二首 其二","author":"陶益","text":"还家最喜过中秋，塔影阑阶果乱投。\n老大恐妨少小乐，自邀明月上高楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9976,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"承诸公约赴丞厅之筵赋此辞谢","author":"陶益","text":"闭户何曾一著书，吾惟守拙爱田庐。\n疏慵易就比邻榻，贫病难参长者车。\n白鸟江干随早暮，红莲浦口对清虚。\n愁来益厉躬耕志，欲学庞公恐未如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9977,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"馆中书怀二首 其一","author":"陶益","text":"昔曾结客少年场，此日南窗纳晓凉。\n非为浮名难系缚，祇缘多病切江乡。\n静观水鸟机心息，閒笑时人局面忙。\n我欲朱明诗作社，长吟采药跨青羊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9978,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"馆中书怀二首 其二","author":"陶益","text":"蝴蝶双飞出馆中，梦回空忆旧行踪。\n茂陵病去思偏远，彭泽归来兴培浓。\n瓜地半开红药尽，菜园全破绿阴重。\n何时定取罗浮约，一榻横加四百峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9979,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鹤门关念斋见寄所作朱明诗帖书法并佳因以怀之","author":"陶益","text":"朱明栖别驾，剑气发长虹。\n忽睹词章丽，还惊翰墨工。\n凤毛元自异，骥足竟谁同。\n几度遥相忆，停云入望中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9980,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜拨闷","author":"陶益","text":"斗转河明夜未央，新凉移夺芰荷裳。\n萧条作赋疑盘谷，老大悲秋忆醉乡。\n月色满林窥竹牗，砧声何处到山房。\n浮云目断心如水，习静时燃安息香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9981,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别道人","author":"陶益","text":"白面长髯云有道，餐霞吸露好居楼。\n须臾一别秋山暮，月色微明松桂幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9982,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄道人","author":"陶益","text":"偶读黄庭欲寄音，闻君今已恋琪林。\n诛茅结屋云山里，祇恐云山不住心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9983,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"听里中谐谈","author":"陶益","text":"乡园昔别已多年，月旦今评孰最贤。\n老我但知閒是好，丝瓜藤下枕书眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9984,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻寇拟呈吴督捕","author":"陶益","text":"寇至乡村多废宅，人忧离乱半投城。\n龙旂即应羽书急，雉堞随消烽火明。\n缓带轻裘挥远戍，围棋别墅系长缨。\n知君不数将家种，岂向辕门漫诘兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9985,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄吉安颜山农","author":"陶益","text":"念昔青莲舫，逢君白鹭洲。\n行藏虽各遇，气义实相投。\n畎亩躬耕乐，云山力学优。\n祇今成阔别，千里思悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9986,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄永新诸同志","author":"陶益","text":"昔入鳌城路，居连君子乡。\n襟怀皆道器，文采悉天章。\n卞璧终知遇，隋珠莫韫藏。\n相期如霁月，千里共清光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9987,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访避居","author":"陶益","text":"闻君避寇北郭中，蓬户绳枢孰与同。\n泽雾有天空隐豹，楼台无地自清风。\n经书满腹堪行义，宰木关心欲即戎。\n回首旧游增感慨，可怜世故转忡忡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9988,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"即景","author":"陶益","text":"风暖蜂房放晚衙，芰荷香气度窗纱。\n谁延入夜新来月，照见池塘远近花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9989,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠江光明二首 其一","author":"陶益","text":"忽忆淮扬万里船，俄遭目病苦经年。\n长安市上多灵药，谁似进贤江二川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9990,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠江光明二首 其二","author":"陶益","text":"江子来从金马门，原机妙处绝尘奔。\n这回海上龙睛活，不谓医人不姓孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9991,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悼黎苍宇","author":"陶益","text":"奕世鸣珂盛，多君结绶荣。\n参藩新驻节，选部旧蜚声。\n岂料星空陨，翻怜墓已成。\n松楸闻鹤唳，挂剑不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9992,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悼宋石坡及逝去诸良友","author":"陶益","text":"惜共雕龙日，怀同并马年。\n别离今隔世，愁望亘长天。\n宿草萌哀念，生刍结奠缘。\n所嗟二三子，才藻总堪怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9993,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆先兄","author":"陶益","text":"青春伯子先捐馆，白首慈亲旧倚门。\n泣向紫荆疑是梦，愁闻孤雁欲销魂。\n弃繻偶得灯前认，遗事堪于月下论。\n三十年来多涕泪，鹡鸰相急在中原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9994,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"窥园有感","author":"陶益","text":"数株桃树小园中，结子飞花花欲空。\n惟有柳条生意别，绕池终日媚东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9995,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋兴","author":"陶益","text":"携旧醅，步荒台。\n臂鹰人不见，题凤客还来。\n野酌莫将文字饮，幽怀先向菊花开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9996,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书待漏图","author":"陶益","text":"玉宇晴光发，金桥曙色明。\n倾葵今在念，炙背旧多情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9997,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大鸿胪苏州吴葵阳寄来诗札中及麻城刘思云杭州夏静郊二锦衣雅意因次韵并以答之","author":"陶益","text":"远客下庭除，遗予隔岁书。\n中言多药石，北望忆襟裾。\n入直推公寺，承恩宿帝庐。\n江湖客病吏，头白赋閒居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9998,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"代躬答谢陈邑宰","author":"陶益","text":"侧身湖海犯风波，皮骨空存可奈何。\n推德一生全未有，引年三族愧犹多。\n虞乡久病虚书籍，梅福幽栖恋薜萝。\n岸帻野袍难见令，为言吾已听弦歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9999,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"禅庭夜坐","author":"陶益","text":"寻幽养病惟依寺，心了身閒祇爱僧。\n幻界夜来窥色相，杳然空见佛前灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10000,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别行客","author":"陶益","text":"侬门复幽闭，即车临远道。\n隐见虽顿殊，一生同怀抱。\n怀抱人不知，结以长相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10001,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒夜有怀","author":"陶益","text":"半夜长空风乍生，茫然四壁尽涛声。\n绨袍不改寒凉色，雪舫徒含旧故情。\n偶记蠡湖惊感发，曾依渔火傲凄清。\n祇今病癖便幽逸，喜听檐前铁马鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10002,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴部院使人问疾医来既辞谢自讶二首 其一","author":"陶益","text":"上客姓名临草莽，山人贫薄款蔬筵。\n烟霞痼疾知难疗，任说南华第几篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10003,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴部院使人问疾医来既辞谢自讶二首 其二","author":"陶益","text":"攒眉不作白莲人，泉石膏肓病已真。\n竟日闭门惟谢客，祇馀鸥鹭自相亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10004,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瓯台谭少铉闽中书来问疾赋此答谢","author":"陶益","text":"归病久萧条，闻君位独超。\n威名唐李郭，节钺汉嫖姚。\n千里题书到，片时积热消。\n交情胜药饵，持以报渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10005,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病间閒行二首 其一","author":"陶益","text":"曾闻傲吏懒梳头，我插黄花喜病瘳。\n努力餐馀无一事，过桥穿出水边楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10006,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病间閒行二首 其二","author":"陶益","text":"梧桐叶尽冷秋光，乍出惊看鬓有霜。\n回首烟霞高阁里，空山无恙任相羊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10007,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访僧玄虚未面题壁","author":"陶益","text":"招题烟雾暝，古刹迷幽径。\n参禅不见僧，翻疑僧入定。\n踟躅山门中，梵劫总虚空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10008,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"看春","author":"陶益","text":"腊月迎春天气和，翠眉半已著轻罗。\n柳条舒眼青楼上，惟有词人幽兴多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10009,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日过渔家晓酌","author":"陶益","text":"晓从渔父访新年，觞至杯倾任自然。\n旭日未消红杏雨，薰风先散绿杨烟。\n攒茅作字都飞白，削竹谈经祇太玄。\n征盖岂堪频接引，醉怀疏旷落江边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10010,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春词","author":"陶益","text":"蚕齐忙著采桑行，隐隐春雷作磨声。\n枝叶拣残归未得，恼人风雨不时生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10011,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"纪春游","author":"陶益","text":"淡淡春风管岁华，寻芳青野水云赊。\n宾寅坐对忘忧草，饯照行临销恨花。\n谢豹夜啼惊客梦，江豚晴跃动仙槎。\n几回欲尽黄金饮，祇少前村大酒家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10012,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夜经过象冈书院","author":"陶益","text":"书院街前闻柝声，寂寥灯火□□明。\n所嗟室迩人何远，欲就棠阴怅独行。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10013,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁卯春偶述","author":"陶益","text":"尔来丑虏不攻营，细柳残条分外生。\n里闬刚逢春事好，又闻人说虎纵横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10014,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新正谒陈白沙先生祠","author":"陶益","text":"东寻祠下路，一径入丘原。\n地僻烟萝合，亭虚鸟雀喧。\n哲人云已远，心事可谁论。\n拜罢碑前立，春风空掩门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10015,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书织锦图","author":"陶益","text":"姊妹渡云海，遥窥夜织颜。\n报章谁斗巧，容易落人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10016,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"识梦","author":"陶益","text":"梦向天边折玉莲，玉莲化作一髯仙。\n人间此梦诚何梦，疑是濂溪托旧缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10017,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"期宿象冈书院不果因怀善山先生","author":"陶益","text":"象岭曾悬想像歌，今期一宿未能过。\n星辰果似何时见，爝火空疑此夜多。\n表碣藓苔迷翰墨，乡坊烟月憩松萝。\n怀贤又切西江路，惆怅东风向逝波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10018,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海棠","author":"陶益","text":"贲园心远不闻喧，浅白深红绕砌繁。\n睡足窗前残蝶舞，翩翩犹恋太真魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10019,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"樱粟","author":"陶益","text":"清风不弃野人家，袅袅红妆柳外斜。\n长日凭栏贪看汝，无人知道米囊花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10020,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"见乞食","author":"陶益","text":"缓步低声访我频，知怀一饭故来亲。\n庄生尚取骷髅语，陶令常存饥饿身。\n短锸行随还似乐，浮云看到不如贫。\n因嗟世路皇皇者，惟有伊人是任真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10021,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答闽陈梧冈年丈时闻其仲子被围得释故末联及之","author":"陶益","text":"京华作客常为侣，岭表还谁事远游。\n三岛凤箫嗟已隔，五云凫舄忆同留。\n横经馆阁君何雅，短发江湖我独忧。\n次复征求戎马急，白眉乘月啸登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10022,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄答大郡博雷曹山先生兼令侄礼部郎润溪先生","author":"陶益","text":"送客上河梁，裁诗寄异乡。\n青箱怀外翰，皂盖仰中郎。\n岭海鱼书渺，湖天雁字长。\n春风回首处，梅柳又苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10023,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登读书岭","author":"陶益","text":"鹫岭连云拥翠屏，读书人去鸟空鸣。\n扪萝登览无烟火，瀑布犹悬打麦声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10024,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游幻化岩","author":"陶益","text":"白鹤峰前踯躅红，何人蝉蜕此岩中。\n劫灰台上一怀古，回望长吟天地空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10025,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春庄杂兴四首 其一","author":"陶益","text":"池塘芳草足欢娱，次对南山日已晡。\n懒散不知春意闹，灌园犹倩一长须。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10026,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春庄杂兴四首 其二","author":"陶益","text":"门前车马不相闻，定息焚香坐白云。\n远近邻庄无历日，种瓜常拟待蜂分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10027,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春庄杂兴四首 其三","author":"陶益","text":"垂杨临水复临堤，烟锁青芜石径迷。\n虚阁草玄时一望，对巢燕嘴落芹泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10028,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春庄杂兴四首 其四","author":"陶益","text":"迩来芳信总无凭，花芷蜂房日欲增。\n春水又生溪上绿，榕阴破暇设鱼罾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10029,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"修褉二首分韵示罚 其一","author":"陶益","text":"上巳携壶出翠微，兴来犹欲典春衣。\n十千美酒谁家有，遥指青帘不忍归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10030,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"修褉二首分韵示罚 其二","author":"陶益","text":"岚烟收雨日初长，花鸟吟馀泛曲觞。\n安得川流通作酒，与君判饮润诗肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10031,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"织妇吟二首 其一","author":"陶益","text":"岁歉望蚕熟，丝成当粟看。\n残机声欲断，又得夜舂寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10032,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"织妇吟二首 其二","author":"陶益","text":"茧箔谁收敛，机丝自忖量。\n祇愁缯帛少，无褐奉姑嫜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10033,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庄次暑雨","author":"陶益","text":"归去柴桑懒折腰，田家鸡黍坐相邀。\n密云畹上蒸兰甲，疏雨篱前洒药苗。\n病体近增新傲慢，纷心遥忆旧班僚。\n昨非今是谁看破，旋著藤蓑暑气消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10034,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄绿筠社诸君","author":"陶益","text":"绿筠结屋半层阴，暑气岚烟散古林。\n淇澳月明留凤影，潇湘风动化龙吟。\n聚星已卜来贤路，漉酒犹悬入社心。\n何日招携同削竹，漫题花鸟一披襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10035,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送赠词客","author":"陶益","text":"相送出河兹，丽日照行色。\n手拗杨柳枝，离怀长恻恻。\n春水涨潮流，春风吹朴棫。\n步景答赠言，敏捷几曹植。\n最忌是才名，愿子常玄默。\n此意老聃知，师之良有得。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10036,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"涉江采芙蓉","author":"陶益","text":"美人隔千里，四德齐凤凰。\n声韵谐律吕，文绮动辉光。\n梧叶飘金井，游子之何方。\n十书不一到，情如针刺伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10037,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊辰春如练江奉怀筠社诸友四首 其一","author":"陶益","text":"改岁馀寒寂寂春，况于江畔少相亲。\n自题绿竹贻君子，谁把青芹念野人。\n欲向社闾歌乐土，还依渔榜隔嚣尘。\n清谈倘及鸱夷处，试与乘槎一问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10038,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊辰春如练江奉怀筠社诸友四首 其二","author":"陶益","text":"春风袅袅想淇坡，独倚江楼感慨多。\n鹭浴碧波翻玉宇，莺穿丝柳度金梭。\n高贤有约联诗社，野老无能缀钓蓑。\n欲倒海杯同一醉，不知芳兴近如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10039,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]