[{"title":"朝回行堤上","author":"薛瑄","text":"御沟行处早春回，春水平堤不起埃。\n柳绿蒲青无限好，客边襟抱一时开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5241,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"简焦李罗刘四侍御五首 其一","author":"薛瑄","text":"绿柳红葵满宪台，几陪簪笏共徘徊。\n昨朝一别长官去，直到新年院里来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5242,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"简焦李罗刘四侍御五首 其二","author":"薛瑄","text":"文明门外水悠悠，妓子归来雨打头。\n却笑道人心似铁，久无飞梦到青楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5243,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"简焦李罗刘四侍御五首 其三","author":"薛瑄","text":"铁扇都门镇日开，无风车马也尘埃。\n雷公不吝连朝雨，洗尽炎蒸一快哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5244,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"简焦李罗刘四侍御五首 其四","author":"薛瑄","text":"每忆清谈对数公，别来无日不从容。\n少陵自是能诗者，却笑樽中酒屡空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5245,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"简焦李罗刘四侍御五首 其五","author":"薛瑄","text":"黄榜同年双进士，青毡并榻两先生。\n四君高论应难及，别后深知鄙吝萌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5246,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"读刘靖脩黄金台诗","author":"薛瑄","text":"贤者何曾为此来，黄金空复垒高台。\n先生志节超千古，一曲清风溢九垓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5247,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再怀沅州五友五首 其一","author":"薛瑄","text":"沅阳清气满乌台，为有脩篁绕户栽。\n两载好风明月夜，新诗谁对此君裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5248,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再怀沅州五友五首 其二","author":"薛瑄","text":"无端诗兴远谁添，红白双梅倚画檐。\n千里中州风雪夜，一窗清月忆湘南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5249,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再怀沅州五友五首 其三","author":"薛瑄","text":"帘捲秋风绕砌花，沅阳几对昔年华。\n关山白露三千里，谁采金英泛紫霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5250,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再怀沅州五友五首 其四","author":"薛瑄","text":"持赠曾同驿使梅，纫香聊尔意徘徊。\n当时九畹花应在，几向光风烂漫开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5251,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再怀沅州五友五首 其五","author":"薛瑄","text":"薜荔阑边绿锦池，竹亭深坐晚凉时。\n忽成远道空劳想，秀色天香发向谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5252,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汾上春行","author":"薛瑄","text":"清汾信马踏春酣，汀草萋萋陇麦蔪。\n正是煖风啼鸟日，水村花坞似江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5253,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"骤寒","author":"薛瑄","text":"晓起题诗砚有冰，苦寒端欲诉玄冥。\n却思持节荆南道，腊月湖山草色青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5254,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"河南将归","author":"薛瑄","text":"我忆汾南田舍好，绿槐如盖拥高门。\n南园旧种双桐树，应有孙枝到碧云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5255,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忽忆","author":"薛瑄","text":"忽忆巩东峰子岭，入云遥见大河流。\n中原胜槩皆堪赋，揽辔还当遂壮游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5256,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汾河南岸看杏花二首 其一","author":"薛瑄","text":"两载东风看杏花，汾河南岸水西斜。\n几回驻马怜秾艳，只恐春流泛落霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5257,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汾河南岸看杏花二首 其二","author":"薛瑄","text":"汾水南边锦作堆，连朝相报杏花开。\n东风好景休虚掷，一日须来一百回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5258,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过寿阳用韩文公韵","author":"薛瑄","text":"征骑鸡鸣发大安，山深五月尚风寒。\n寿阳举目孤城近，东岭金乌烂晓团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5259,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宪台斋宿","author":"薛瑄","text":"宪台斋宿几连宵，绛烛银炉伴阒寥。\n斗帐梦回更漏永，只听窗外冷风飘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5260,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜雨杂咏简院长诸公八首 其一","author":"薛瑄","text":"圣明端拱太平时，好雨当春细若丝。\n应是柏台添气象，旋滋花柳更催诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5261,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜雨杂咏简院长诸公八首 其二","author":"薛瑄","text":"正是阳和溥万方，知时好雨润群芳。\n趣朝共睹天颜悦，应喜斯民乐泰康。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5262,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜雨杂咏简院长诸公八首 其三","author":"薛瑄","text":"霏霏朝雨润彤庭，恭逐鹓行谒圣明。\n白玉桥边鸣佩过，御沟春水一时生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5263,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜雨杂咏简院长诸公八首 其四","author":"薛瑄","text":"御沟新柳湿鹅黄，佩马朝回雨露香。\n柏府文书春日静，相过唯觉和诗忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5264,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜雨杂咏简院长诸公八首 其五","author":"薛瑄","text":"柏台春静昼厌厌，好雨如丝不捲帘。\n最是东君能借力，閒庭草色一时添。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5265,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜雨杂咏简院长诸公八首 其六","author":"薛瑄","text":"雨过西山翠欲流，葱葱佳气满神州。\n书生莫笑今霜鬓，骏马看花已偿游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5266,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜雨杂咏简院长诸公八首 其七","author":"薛瑄","text":"圣主龙飞第一春，天垂雨露万方匀。\n苍生坐见跻仁寿，自昔赓歌有舜臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5267,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜雨杂咏简院长诸公八首 其八","author":"薛瑄","text":"万国同心奉至尊，斯民重见饮衢樽。\n欲知和气薰天地，只在三春雨露恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5268,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"发通津驿三首 其一","author":"薛瑄","text":"六月官船发潞阳，水村烟树共微茫。\n天门忽已如天上，秪见青山一带长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5269,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"发通津驿三首 其二","author":"薛瑄","text":"新捧天书带紫泥，又承恩旨按三齐。\n通津南下波连海，渺渺风帆去似飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5270,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"发通津驿三首 其三","author":"薛瑄","text":"五色天书出禁中，儒臣将命按三东。\n沧波南下通洙泗，鱼跃鸢飞总帝功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5271,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿临清薇省行馆","author":"薛瑄","text":"薇垣潇洒九秋天，风叶敲窗夜月圆。\n有客乘骢来借宿，新诗留作赁房钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5272,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泉林寺","author":"薛瑄","text":"日午停骖暑气收，参天古木乱蝉秋。\n绝怜好景添清兴，为写新诗纪胜游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5273,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梦与陈侍御话旧","author":"薛瑄","text":"分司相见是京华，风节山东向骇誇。\n邂逅不知身是梦，觉来秋两溅窗纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5274,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"菊开忆去秋同官台中共赏","author":"薛瑄","text":"去年客里遇重阳，曾与同官摘晚香。\n今日分符行郡邑，独将远意看秋芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5275,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"嘉祥分司元宵","author":"薛瑄","text":"行台北面是苍山，古柏风生分外寒。\n又值元宵春一度，谩烧红烛伴清欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5276,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"钜野道中","author":"薛瑄","text":"钜野茫茫远际天，春风春雨淡春烟。\n河流尚自成陈迹，俯仰千年事落然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5277,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题汶上分司二小柏","author":"薛瑄","text":"霜台对植长新枝，翠叶交承雨露滋。\n直干总应无曲处，稚年俱有栋梁姿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5278,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻蛙有怀","author":"薛瑄","text":"春晚乘骢驻德平，古城墙外有蛙鸣。\n却思青草池塘夜，三载湖南厌此声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5279,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"暮春道中见桃花尚开","author":"薛瑄","text":"马穿新绿过园林，已恨秾芳误赏心。\n犹有小桃花未落，独留馀艳到春深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5280,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"邹平分司杂咏二首 其一","author":"薛瑄","text":"行台独坐听鸣鸠，乔木参天五月秋。\n举目好山青未了，应随马足遍东州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5281,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"邹平分司杂咏二首 其二","author":"薛瑄","text":"树绕行廊散碧阴，莺啼小圃送清音。\n葵花无数开如锦，解是倾阳共此心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5282,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"临淄道中","author":"薛瑄","text":"平郊漫漫树依依，人物千年总已非。\n多少荒台芳草合，不知何处是三归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5283,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"青州分司榴花","author":"薛瑄","text":"石榴小萼未开时，浑似红樱压翠枝。\n照日含风千万朵，故园千里正相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5284,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"穆陵关夜雨","author":"薛瑄","text":"万山绝顶穆陵关，一上山楼五月寒。\n烟树满川浮瞑色，晚风吹雨湿阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5285,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"胶州","author":"薛瑄","text":"几点青螺海上山，参差楼阁海天宽。\n行台五月不知暑，秪觉侵人海气寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5286,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"栖霞见青桃","author":"薛瑄","text":"来日红桃尚有花，青桃如弹过栖霞。\n无端马首还东去，直看青山到海涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5287,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"栖霞行台夏日","author":"薛瑄","text":"四山环绕柏台深，绿树浓交户外阴。\n还似湖南持宪节，坐听山鸟弄清音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5288,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"望岳","author":"薛瑄","text":"揽辔西来过泰安，拂空青霭掠征鞍。\n东还算是初冬日，拟上天门次第看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5289,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"莱芜怀古","author":"薛瑄","text":"清节谁能似范丹，清名千载重人间。\n莱芜县里停骖日，坐对南山秋色寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5290,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再咏汶上分司二小柏","author":"薛瑄","text":"一回相见一回高，夹砌行看翠叶交。\n伟器定如房与杜，相期耸壑更昂霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5291,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鱼台分司","author":"薛瑄","text":"翠竹红榴掩映间，柏台清昼鸟声閒。\n情知物理相关处，心与乾坤一样宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5292,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三咏汶上分司二小柏","author":"薛瑄","text":"高标离立入檐长，已有清阴近画堂。\n别后又看新子结，风生满院散天香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5293,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题松鹤图","author":"薛瑄","text":"忽惊虚室起潜蛟，云气阴森爽气飘。\n霜雪不知几千古，长年惟有鹤来巢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5294,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"临朐分司四小柏二首 其一","author":"薛瑄","text":"解是平生独爱材，新移四柏后堂栽。\n悬知数百年来后，应有清阴满宪台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5295,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"临朐分司四小柏二首 其二","author":"薛瑄","text":"四柏移来拱把馀，一行分植傍阶除。\n故应雨露均培养，直干争看耸碧虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5296,"sha256":"d4c6bdc86d2b