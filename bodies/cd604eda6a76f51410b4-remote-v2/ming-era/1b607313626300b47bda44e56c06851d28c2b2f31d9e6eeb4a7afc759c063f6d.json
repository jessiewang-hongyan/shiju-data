[{"title":"秋日写怀","author":"黄仲昭","text":"一官南北总穷途，浮世逢人笑腐儒。\n囊里无钱还药债，门前有客索诗逋。\n满天风露鸣蝉乱，万里烟云旅雁孤。\n一片归心留不住，非因故国有莼鲈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27535,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺太常少卿夏公升大理卿代孙寺丞赋","author":"黄仲昭","text":"久向云霄仰盛名，同官今喜挹馀馨。\n伯夷暂典虞廷礼，定国还详汉室刑。\n门绝苞苴春草绿，狱求钦恤夜灯青。\n似闻太史占玄象，执法星高烛紫冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27536,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题谷城春色图为徐若川秋官赋","author":"黄仲昭","text":"谷城风景浩无涯，春入林峦景更嘉。\n万顷松阴晴滴翠，半岩花气煖蒸霞。\n降神长见钟人杰，兴雨时能润物华。\n早晚公卿佳应协，凤㘅丹诏到君家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27537,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题四景山水为林君叔孟赋 其一","author":"黄仲昭","text":"门掩青山尽日閒，纷纷朝市懒相干。\n交游满眼知音少，笑拂瑶琴独自弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27538,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题四景山水为林君叔孟赋 其二","author":"黄仲昭","text":"水边亭榭绝炎熇，坐对遗经日易消。\n载酒有人来问字，隔溪撑过木兰桡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27539,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题四景山水为林君叔孟赋 其三","author":"黄仲昭","text":"秋入林坰晚觉凉，閒寻诗景步斜阳。\n笑渠羸马风尘客，底事匆匆有许忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27540,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题四景山水为林君叔孟赋 其四","author":"黄仲昭","text":"滕六飞花散九垓，乾坤万象变琼瑰。\n诗翁胸次春无限，溪上冲寒晓访梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27541,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪夜归舟和周次玉太守韵 其一","author":"黄仲昭","text":"晚风吹雪满江流，酒尽宾筵便解舟。\n归去养成文五彩，他年天上赞皇猷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27542,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪夜归舟和周次玉太守韵 其二","author":"黄仲昭","text":"江上梅花开已齐，蟾光雪色望还迷。\n归心拟献庭闱寿，不是风流忆剡溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27543,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题乡先生卓季新龙山别业卷","author":"黄仲昭","text":"龙山风景足徜徉，况是林峦接故乡。\n万顷松云当户暝，一天花雨入帘香。\n荷锄烟陇春阳动，散帙晴窗月色凉。\n浮世氛埃飞不到，分明一段辋川庄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27544,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽韶州贰守方源学先生","author":"黄仲昭","text":"渊源家学绍难兄，璧水翱翔羡老成。\n共说王祥能佐郡，还誇疏受早辞荣。\n龙蛇倏尔惊新梦，松菊翛然负旧盟。\n赢得五花鸾诰在，龙光千古贲丘茔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27545,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丘山风木为林崇起赋","author":"黄仲昭","text":"一双白璧閟佳城，春雨秋霜岁屡更。\n泉壤无由醒蝶梦，松楸不断起风声。\n感时空洒皋鱼泪，终古难酬季路情。\n我亦与君同此恨，临图悲怆欲无生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27546,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题周广德翠渠亭次周鹤洲韵","author":"黄仲昭","text":"翠渠绕舍净无埃，渠上孤亭傍竹开。\n数载各因微禄去，今朝同载小舟来。\n闲听啼鸟裁诗句，笑对青山酌酒杯。\n情景留人归未得，隔林已见晚鸦回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27547,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题周鹤洲延绿亭次吴修撰韵","author":"黄仲昭","text":"无事频将兔颖拈，批风抹月坐虚檐。\n春回兰蕙香浮几，雨过庭除翠入帘。\n门外渟涵诸水汇，天南依约数峰尖。\n个中何物尤清绝，满架琴书一鹤兼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27548,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽三山林质斋处士","author":"黄仲昭","text":"隐君仙去已多时，月旦高名尚在兹。\n负土不辞营宅兆，买田多为恤孤嫠。\n芝兰钟秀香风蔼，棣萼连枝春日迟。\n我亦高山兴仰止，楚招歌罢不胜思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27549,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和答余以贞佥宪见寄韵言怀二首 其一","author":"黄仲昭","text":"迂疏已分老闽垓，松菊当年手自培。\n却笑浮云无住著，误含雨意出山来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27550,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和答余以贞佥宪见寄韵言怀二首 其二","author":"黄仲昭","text":"误含雨意出山来，枯槁难将一滴培。\n便欲陈情乞骸骨，荷锄归理旧田垓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27551,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送丘安重侍御之京次周时可佥宪韵","author":"黄仲昭","text":"雁声催老剑潭秋，客里那堪送客愁。\n人海凭君标砥柱，狂澜尽使向东流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27552,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游武夷九曲僭用文公先生韵赋棹歌十首 其一","author":"黄仲昭","text":"我来九曲访仙灵，积雨初收天气清。\n旧日虹桥无觅处，依然山色与溪声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27553,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游武夷九曲僭用文公先生韵赋棹歌十首 其二","author":"黄仲昭","text":"一曲呼来隔岸船，棹歌齐唱过前川。\n山灵似识游人意，敛尽峰峦远近烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27554,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游武夷九曲僭用文公先生韵赋棹歌十首 其三","author":"黄仲昭","text":"二曲溪头耸碧峰，分明玉女镜中容。\n到来已讶非人境，峰外奇峰更几重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27555,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游武夷九曲僭用文公先生韵赋棹歌十首 其四","author":"黄仲昭","text":"三曲丁宁缓刺船，兹游预拟几经年。\n壑舟不必穷真□，岩上烟云自足怜。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27556,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游武夷九曲僭用文公先生韵赋棹歌十首 其五","author":"黄仲昭","text":"四曲回看天际岩，岩头空翠落毵毵。\n个中何物尤清绝，云影天光共一潭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27557,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游武夷九曲僭用文公先生韵赋棹歌十首 其六","author":"黄仲昭","text":"五曲峰峦转觉深，千年精舍在云林。\n古今游客知多少，谁识先生一片心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27558,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游武夷九曲僭用文公先生韵赋棹歌十首 其七","author":"黄仲昭","text":"六曲幽林拥碧湾，拟分隙地辟柴关。\n细穷往哲传心要，溪月岩云相伴闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27559,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游武夷九曲僭用文公先生韵赋棹歌十首 其八","author":"黄仲昭","text":"七曲停桡乱石滩，层崖叠巘恣吟看。\n更怜云际千寻瀑，爽气逼人毛骨寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27560,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游武夷九曲僭用文公先生韵赋棹歌十首 其九","author":"黄仲昭","text":"八曲悠然眼界开，溪山如此可能回。\n兹行须尽平生兴，未卜何时得再来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27561,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游武夷九曲僭用文公先生韵赋棹歌十首 其十","author":"黄仲昭","text":"九曲桑麻翠渺然，数家鸡犬隔晴川。\n奇踪到此都看尽，还比人间别一天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27562,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同昭武刘太守仁甫游西庵二首 其一","author":"黄仲昭","text":"刺史观风出郡南，偶陪轓盖到西庵。\n四山回合攒幽树，一径萦纡入碧岚。\n移坐竹阴耽野趣，论心杯酒绝浮谈。\n诛茅便欲林间卧，未报君恩尚未堪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27563,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同昭武刘太守仁甫游西庵二首 其二","author":"黄仲昭","text":"看山游遍郡城南，清绝都应让此庵。\n流水到门澄碧沼，乱松绕屋拥晴岚。\n浮生无奈多纷扰，偶暇何妨一笑谈。\n此景此人能几遇，夕阳归路思难堪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27564,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同昭武刘太守王贰守万通守游西峰寺三首 其一","author":"黄仲昭","text":"青山一脉似游龙，山势将穷秀气钟。\n?宇深藏幽树里，行人指点是西峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27565,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同昭武刘太守王贰守万通守游西峰寺三首 其二","author":"黄仲昭","text":"林外应疑无路入，道傍惟见有僧迎。\n行行渐觉招提近，隔崦时闻吠犬声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27566,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同昭武刘太守王贰守万通守游西峰寺三首 其三","author":"黄仲昭","text":"停骖相与坐论文，人得浮生暂息纷。\n怪底襟怀清似许，僧房面面对松云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27567,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用同年林一中韵哭陈弘载佥宪二首 其一","author":"黄仲昭","text":"宦辙南都偶共驰，相逢一笑即相知。\n才高拟报君心眷，数尽难逢国手医。\n朋旧一觞归榇远，妻孥千里旅魂悲。\n怀君何处肠堪断，月落空梁梦觉时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27568,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用同年林一中韵哭陈弘载佥宪二首 其二","author":"黄仲昭","text":"按节遥冲瘴雨寒，西风闻讣泪交潸。\n忆君九曲分岐去，问我三山岁月还。\n柏府此时经旧宅，泉台无路觅清颜。\n全归俯仰应无愧，百岁谁能脱此关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27569,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送仙游陈司训考满归潮州省亲","author":"黄仲昭","text":"十年芹泮育英才，夜夜庭闱有梦回。\n喜趁瓜期过梓里，欲从华旦献霞杯。\n趋朝重捧毛生檄，访古闲登郭隗台。\n旧日诸生犹仰斗，佳音好寄便鸿来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27570,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梨关入浙江界感怀","author":"黄仲昭","text":"朔风孤骑别莆阳，还说闽山总故乡。\n今日忽惊风土异，闽山又隔暮云黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27571,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽夏孺人用刘钦谟大参韵","author":"黄仲昭","text":"斧封春雨长苔痕，孝子临风欲断魂。\n衣线百年长感恨，旨甘三釜未酬恩。\n霜凝堂北宜男老，云锁天南婺女昏。\n愁绝壸仪招不返，束刍还拟奠清尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27572,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画竹三首为同年鲍栗之赋 其一","author":"黄仲昭","text":"苍苔迸破箨犹含，太守清贫亦不馋。\n剪伐不加生意足，凌霄高节碧毵毵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27573,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画竹三首为同年鲍栗之赋 其二","author":"黄仲昭","text":"饱沭东君雨露私，森森劲节与云齐。\n春风养就林间实，留待丹山彩凤栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27574,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画竹三首为同年鲍栗之赋 其三","author":"黄仲昭","text":"忆昔銮坡寓直时，琅玕节下遍题诗。\n十年湖海仙凡隔，今日披图有所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27575,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈廷章经历之任松江","author":"黄仲昭","text":"除章朝捧出枫宸，新拜吴淞入幕宾。\n千里侯邦归赞画，一时民瘼要咨询。\n地偏白日逢迎少，事简青山览眺频。\n莫叹才华君独屈，鹏程九万是通津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27576,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽杨太安人","author":"黄仲昭","text":"早共夫君挽鹿车，韶仪淑德世谁逾。\n子承慈训登朝著，孙服遗休剖郡符。\n八帙遐龄今古少，五花封诰宠恩殊。\n登堂我忆曾瞻拜，丘陇何当奠束刍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27577,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿弋阳黄宪使七十","author":"黄仲昭","text":"青春飞步上蓬莱，看破浮荣便乞骸。\n十载乘骢豺虎肃，两藩执法士民怀。\n童颜鹤发稀年届，绿酒黄花晚兴佳。\n况有仙郎能继美，锦衣献寿舞庭阶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27578,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢病得请口号四首 其一","author":"黄仲昭","text":"病怀偏恋故山薇，乞得闲身别衮衣。\n汲黯十年长在告，陶潜今日始真归。\n还山谩说馀生乐，报国终悲始愿违。\n匹马金台重回首，寸心还傍五云飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27579,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢病得请口号四首 其二","author":"黄仲昭","text":"归路新秋暑渐微，到家正及菊花时。\n沉冥岂是甘沮溺，经济元须让稷夔。\n书卷昼长聊足遣，山田岁熟可无饥。\n高车驷马从知好，只恐风尘涅素丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27580,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢病得请口号四首 其三","author":"黄仲昭","text":"十五年间列从臣，在公仅阅四回春。\n庙堂不乏经纶手，天地堪容樗散人。\n富贵百年聊染指，田园数亩足安身。\n逢人若问馀生计，秋水芦花一钓纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27581,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢病得请口号四首 其四","author":"黄仲昭","text":"羁絷终非性所禁，暂来旋复忆山林。\n衡门已分栖身稳，生计何须著意深。\n健翮冲霄元有路，闲云出岫自无心。\n亲朋共说如疏傅，只是行囊乏赐金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27582,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽三山陈叔熙先生","author":"黄仲昭","text":"青年挟策觐重瞳，一命荣沾教泮宫。\n宁海已看端士习，定安还喜变夷风。\n清朝共拟升杨震，绛帐俄惊失马融。\n纪行有铭垂不朽，知君瞑目九泉中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27583,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大田驿和任提学见竹偶成二绝 其一","author":"黄仲昭","text":"驿亭孤寓无人识，赖有此君相对清。\n明日俗尘仍滚滚，乾坤双眼为谁明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27584,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大田驿和任提学见竹偶成二绝 其二","author":"黄仲昭","text":"托根亦在尘寰里，独得乾坤一味清。\n朝暮相看心似洗，林梢况有月华明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27585,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和韵题周宪副墨菊二首 其一","author":"黄仲昭","text":"秋满乾坤菊有花，筼筜经雨玉无瑕。\n苍然太古云根石，饱阅风霜共一家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27586,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和韵题周宪副墨菊二首 其二","author":"黄仲昭","text":"老圃秋风见此花，玉人相对总无瑕。\n落英闻说堪延寿，好散苍生百万家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27587,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题扇面伯牙鼓琴图为同年谈时英赋","author":"黄仲昭","text":"山水遗音识者稀，浮生幸有故人知。\n明朝又向江头别，安得黄金铸子期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27588,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桂花仙子","author":"黄仲昭","text":"蟾窟当年花发时，天香深处识仙姿。\n尘凡一隔经三纪，万里红云系梦思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27589,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凌波仙子","author":"黄仲昭","text":"拍天秋水浩无涯，尘袜凌波任溯洄。\n安得微躯轻似许，同过弱水看蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27590,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题羲之观鹅图","author":"黄仲昭","text":"纷纷世事不堪论，典午乾坤势已分。\n书罢黄庭无个事，闲开池馆看鹅群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27591,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六月十六日晓起作","author":"黄仲昭","text":"浮生无计挽流光，岁月催人似箭忙。\n屈指又惊秋欲到，晓来微雨试新凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27592,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"承太守王先生见示和林宪使守岁诗次韵","author":"黄仲昭","text":"六年守岁宦途遥，何幸乡园度此宵。\n老至生涯惟药裹，春来心事付诗瓢。\n痴鸠自诧今巢稳，骢马空劳曩日骄。\n凤历明朝又新岁，还从野老祝轩尧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27593,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵王太守感春诗","author":"黄仲昭","text":"举世逢春不解悲，春风应合笑人痴。\n赏春只说春光好，白发侵头却未知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27594,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又用前韵","author":"黄仲昭","text":"人喜春回我独悲，化工虽巧亦还痴。\n阳光遍及闲花草，空谷幽兰想未知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27595,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送方寿卿秋官之京二首走笔和林见素韵 其一","author":"黄仲昭","text":"五色祥云北望赊，君恩未报便辞家。\n缙绅拟听鸣阳凤，岁月须惊赴壑蛇。\n离思悠扬萦弱柳，诗怀浩荡逐飞花。\n酒阑催上骅骝去，回首乡关隔暮霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27596,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送方寿卿秋官之京二首走笔和林见素韵 其二","author":"黄仲昭","text":"河桥握手若为情，矧听阳关醉后声。\n冰玉祗应坚晚节，鼎彝终见勒明廷。\n馀生笑我头空白，浮世何人眼更青。\n后夜思君天万里，只凭清梦睹仪刑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27597,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和答郑司训赏莲诗并订重游之约","author":"黄仲昭","text":"萍踪十载寄江湖，空涉风涛负壮图。\n此日红莲欣共赏，昔年白璧悔重酤。\n功名随分心常泰，势焰薰天骨亦枯。\n还约中秋同玩月，九龙山下候车徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27598,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿林通府景源七十次林见素韵","author":"黄仲昭","text":"伉俪稀年锡自天，仙经何用更钩玄。\n阶前菊映斑斓服，堂上歌喧锦绣筵。\n老得身闲增矍铄，貌因德邵觉清妍。\n从今寿考谁堪并，万仞南山倚翠烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27599,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己未九日乌山登高次刘静常郑藏庵东庵韵 其一 次静常韵","author":"黄仲昭","text":"白露凝霜催短景，黄花泛酒续良游。\n山横翠黛云开处，雁带斜阳天尽头。\n百岁功名成画饼，几人姓字覆金瓯。\n题糕且尽生前乐，洒泪何劳身后忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27600,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己未九日乌山登高次刘静常郑藏庵东庵韵 其二 次东庵韵","author":"黄仲昭","text":"谁能燮理顺阴阳，偶为登高一感伤。\n多稼盈畴怜就槁，三农终岁叹徒忙。\n且呼绿醑互酬酢，聊挽春和归肺肠。\n老得兹游良亦幸，浮生丰约底须量。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27601,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己未九日乌山登高次刘静常郑藏庵东庵韵 其三 次藏庵韵","author":"黄仲昭","text":"浮云漠漠拥遥岑，不解为霖空自阴。\n人事忽看今日改，菊花还作去年簪。\n庙堂谁是忧民者，畎亩空怀爱国心。\n万斛闲愁何处遣，盈尊春酒不辞斟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27602,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]