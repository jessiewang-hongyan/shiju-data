[{"title":"游南岩诗 其三","author":"郑真","text":"树影重重日渐西，春风送我上丹梯。\n水深农务催黄犊，径曲人声杂画眉。\n面壁孤僧心似铁，传觞众客醉如泥。\n簪裾多幸斯文共，石上须将姓字题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25224,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题文江卷 其一","author":"郑真","text":"松窗高倚碧崔嵬，滚滚长江天际来。\n春雨半空龙变幻，暮云千里鹤飞回。\n神仙入海鸾车驻，慈母升堂燕席开。\n宪府从容归未得，绿阴清昼赋南陔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25225,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题文江卷 其二","author":"郑真","text":"西江遥望白云层，万里光辉近玉绳。\n地脉聚灵多俊杰，天潢演派见孙曾。\n悬崖鸟道秋风杖，隔岸渔家夜雨灯。\n山水娱情吾欲去，老来双鬓雪鬅鬙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25226,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题文江卷 其三","author":"郑真","text":"松竹庭阶舞袖齐，锦萱开傍绣帘低。\n鸾刀缕切鱼成脍，翠釜珍烹鹿进臡。\n使节增华催入幕，天恩有待赐封泥。\n江花江水春风衷，落日遥闻唱大堤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25227,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄弋阳杜知县孔传","author":"郑真","text":"名家奕世一经传，嗣续今逢百里贤。\n梦草石床过夜半，种花山县及春妍。\n耕桑满野躬亲劝，图籍充庭手自编。\n笑我异乡同作客，一樽试与话朝天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25228,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贻弋阳主簿林敬伯","author":"郑真","text":"学省中都接帝庭，襟期多幸共谈经。\n可应绝笔伤麟获，自许闻韶叶凤鸣。\n绮席笑倾春酒碧，云床忆对夜灯青。\n老来撰述成何用，耒德堂深问勒铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25229,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弋阳主簿林敬伯出示会试录而吾临淮学生桂满预焉谂知己登高甲授官随朝喜而成咏 其一","author":"郑真","text":"耿耿奎星粲晓光，科名淮海破天荒。\n芸编鼓勇三余学，棘院雄夸百战场。\n内仗唤朝听舜乐，纶音报可拜尧章。\n少年早际文明运，好把丹心答圣皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25230,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弋阳主簿林敬伯出示会试录而吾临淮学生桂满预焉谂知己登高甲授官随朝喜而成咏 其二","author":"郑真","text":"折桂还夸姓桂人，天风听履上星辰。\n凤鸾飞翥金门晓，鹓鹭联翩玉殿春。\n制草封缄颁巨轴，宫花拂席耀重茵。\n老来笑忝师传旧，客底多烦送喜频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25231,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻方同知入朝还府 其一","author":"郑真","text":"玉佩玲玲上玉除，天颜咫尺听都俞。\n鹓班同致尧年祝，鸾阁亲登禹贡书。\n上冢还家分折俎，建牙开府候遄车。\n别时许得新冠带，应费囊中月俸余。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25232,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻方同知入朝还府 其二","author":"郑真","text":"玉笋班齐肃静鞭，笙箫杂沓听钧天。\n云低雉扇开三殿，日射龙帷寿万年。\n蜀绮剪花分彩胜，闽柑饤果赐琼筵。\n多才竟上椒盘颂，匹马归来话日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25233,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉山柳都勒巡检闻有相知之契作律诗以寄","author":"郑真","text":"忆昔同听吏部铨，客乡想象夜灯前。\n河汾谩说文中子，京洛还夸贾少年。\n云透溪窗青简帙，月高岩砦宝刀悬。\n盛时材武需经济，来认秋风博士毡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25234,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题槐庭","author":"郑真","text":"白日高堂正绿阴，座中宾客尽华簪。\n门阑预儗公侯谶，嗣续宁忘举子心。\n碧落晴看双凤下，清风晚听一蝉吟。\n南来千里难为客，胜赏何由杖履临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25235,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题梅隐卷","author":"郑真","text":"山南山北种梅花，何似西湖处士家。\n铁石誓同坚节操，轩车宁复慕荣华。\n瑶琴曲奏宫商叶，画角声传梦寐赊。\n独鹤归来天万里，笑看疏影上窗纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25236,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赵通判煮雪窝诗","author":"郑真","text":"一铛松火焰初红，座席春回造化功。\n每笑词臣惭党尉，多烦谏省寄卢仝。\n银葩散彩虫声扑，玉液生香蚓窍通。\n身世不随流俗化，飘飘清思渺空蒙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25237,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用方参政文敏述怀韵五首 其一","author":"郑真","text":"涂山禹会帝城深，翠辇曾纡御步临。\n玉帛流风传往昔，衣冠盛治睹于今。\n直言每羡刘蕡策，遣兴多惭杜甫吟。\n矫首城南天尺五，大明当宁廓群阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25238,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用方参政文敏述怀韵五首 其二","author":"郑真","text":"云气蓬莱咫尺间，太平盛观喜开颜。\n象犀南贡踰银海，骐骥西来度玉关。\n多士曾承前席问，将军正奏凯歌还。\n才华独羡瀛洲客，不数淮南大小山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25239,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用方参政文敏述怀韵五首 其三","author":"郑真","text":"黄道天开曙色浮，瀛仙催觐紫云楼。\n未容四皓归深隐，宁许三闾赋远游。\n河汉星辰曕北极，风沙海岛望东州。\n传家自有康成学，睿览终当彻帝旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25240,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用方参政文敏述怀韵五首 其四","author":"郑真","text":"禁城秋水映芙蓉，甲第煌煌绮绣重。\n麟趾已闻歌圣化，虎头还见儗侯封。\n周南太史怜司马，洛下耆英忆邵雍。\n尚有前朝勋伐在，云霄不日庆从龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25241,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用方参政文敏述怀韵五首 其五","author":"郑真","text":"淮南草木正高秋，千里长怀宋玉愁。\n濠水桥梁通广运，滁阳关险接清流。\n芸编辟蠹香犹润，瑶轴生辉墨尚浮。\n莫道遗珠沧海阔，老成仍许占鳌头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25242,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再用韵五首 其一","author":"郑真","text":"山河萧飒正秋深，想象谁将粉墨临。\n形胜万年夸自古，风流三杰数斯今。\n甘泉欲奏扬雄赋，梁甫新成葛亮吟。\n客底不禁形影只，剪灯愁坐月庭阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25243,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再用韵五首 其二","author":"郑真","text":"雅志由来丘壑间，逢人谈笑强形颜。\n江山路远愁千里，河汉云深怅九关。\n汉署冯唐宁老去，羌村杜甫定生还。\n故园消息西风暮，望断瀛洲海上山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25244,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再用韵五首 其三","author":"郑真","text":"落日沧茫海气浮，多情祇欲赋登楼。\n陶潜久有归田兴，吴札宁忘上国游。\n玉室金堂夸福地，丹山赤水记明州。\n同乡漫忆同年友，冠佩锵锵侍主旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25245,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再用韵五首 其四","author":"郑真","text":"晴山空翠削芙蓉，迤逦长淮百万重。\n周礼职方烦载牍，汉家汤沐趣行封。\n文明广被闻弦诵，礼化旁流咏穆雍。\n亦有沧江千里客，夜看剑气拂苍龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25246,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再用韵五首 其五","author":"郑真","text":"编年二百鲁春秋，舒卷宁忘楚客愁。\n圣意可能参笔削，师承聊复记源流。\n草窗短褐风声透，土屋孤灯雨气浮。\n富贵自行天所付，珥簪敢望立螭头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25247,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵夏原威述怀七言六首 其一","author":"郑真","text":"雉堞煌煌壮国都，移家住近月明湖。\n秋风篱落花长好，夜雪庭阶草不枯。\n烟远山庖供晚爨，云舂野碓急秋租。\n浮生已付形骸外，何羡商岩隐者徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25248,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵夏原威述怀七言六首 其二","author":"郑真","text":"山气巃嵷旦夕佳，万年形胜览河淮。\n云开画幛尊罍列，日近晴窗砚席排。\n吴郡张翰频发兴，荆州王粲独伤怀。\n太平久已边声息，笑指台缠近泰阶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25249,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵夏原威述怀七言六首 其三","author":"郑真","text":"霜寒碧落晓鸿鸣，久客何堪梦底听。\n淮海雪晴拖练白，荆山云暖送螺青。\n长卿多病愁仍在，阮籍穷途醉不醒。\n何似隐君松竹里，焚香阅世了残经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25250,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵夏原威述怀七言六首 其四","author":"郑真","text":"滚滚浮尘上客衣，登临祇欲赋将归。\n黄钟大吕遗音邈，白雪阳春和者稀。\n山木寒声风满壑，渚苹晚色水浮矶。\n采芝应念青云客，谈舌纷纭总见几。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25251,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵夏原威述怀七言六首 其五","author":"郑真","text":"制草须曾儗玉堂，乐歌亦复用霓裳。\n马良谩说眉纯白，韩子多怜鬓已苍。\n霄汉沾濡欣雨露，关河涉历怕风霜。\n相逢青眼谁知己，欲吐平生锦绣肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25252,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵夏原威述怀七言六首 其六","author":"郑真","text":"山川远作子长游，风雨难忘宋玉愁。\n旧日封疆夸芈楚，盛时礼乐睹姬周。\n晓庖每笑尘生甑，夜榻空怜月满瓯。\n沧海东头波浪阔，依依清梦绕瀛洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25253,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送洪毅夫","author":"郑真","text":"佩服翩翩映紫霞，东风千里望还家。\n灵丹夜长黄金汞，仙杏春开锦绣葩。\n天阙政须依日月，云程从此隔尘沙。\n袖中况有青囊秘，莫道流年两鬓华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25254,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和刘太守纪怀","author":"郑真","text":"龙杓光照上元初，燕处从容视篆余。\n五马春风晴簇仗，九重晓色瑞充闾。\n藜灯高照青云步，鸿宝犹传素箧书。\n自笑孟尝门下客，弹歌宁叹食无鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25255,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送应德中上任","author":"郑真","text":"家住天台第几峰，年来为□□□容。\n郭熙每说丹青手，李白仍夸锦绣胸。\n晓榻尘编挥玉麈，夜床宝剑拂苍龙。\n幕官掌故非轻授，定有声名动九重。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25256,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱元助上任高唐典史","author":"郑真","text":"蓬莱东望海天隅，千里淮山赋卜居。\n夜月蚁香芸屋静，春风蝶梦竹园虚。\n公车宠赴京都召，宾幕恩承省部除。\n形胜中原夸自古，浮云苍野览青徐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25257,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"学中与诸公饮酒分韵得晴字","author":"郑真","text":"藻頖波光漾午晴，煌煌庠序蔼簪缨。\n樽前未觉刘伶醉，席上还推许劭评。\n翠釜传庖夸禁脔，银刀斫鲙胜侯鲭。\n斯文共际千年运，儗咏菁莪乐太平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25258,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送胡彦通乃常往西京大同府","author":"郑真","text":"雁门西望是云州，风雪飘飘万里游。\n蕃汉封疆空旧垒，辽金冠盖总荒丘。\n边声暮走兹曲，日色寒欺季子裘。\n堂上乃翁如问讯，为言衰老盼瀛洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25259,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏周克复先生三友轩","author":"郑真","text":"松竹依依政可怜，玉葩况复睹清妍。\n江湖归老成三益，泉石相辉共百年。\n黄鸟有声春冉冉，翠禽无语夜娟娟。\n人间正熟繁华梦，幽意从今莫浪传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25260,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和李推官劝农日咏花篮韵","author":"郑真","text":"花神送喜碧云篮，华发萧萧莫浪簪。\n一曲山香垂舞袖，双头国色驻飞骖。\n珊瑚网出春波艳，锦绣囊倾午席酣。\n过眼未须夸富贵，故园有梦过江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25261,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈君祥上任襄阳府照磨","author":"郑真","text":"每读南平旧勒碑，襄城风物思依依。\n小儿谩唱铜鞮曲，贪将曾夸玉带围。\n水满檀溪寒月上，天低岘首翠云微。\n幕官九载应多暇，往事毋令胜赏违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25262,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送嘉祥县主簿","author":"郑真","text":"麟绂由来纪地灵，宣尼绝笔载遗经。\n千年已见河流碧，万里遥看岱岳青。\n鸾凤林低栖棘枳，鲲鹏海阔奋空冥。\n春花满县归来日，玉佩玲玲月下听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25263,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送庐陵郭氏怡怡堂","author":"郑真","text":"棠棣花开晓砌空，埙篪度曲奏春风。\n绮筵每爱樽罍共，绣被多怜寝席同。\n鸾凤联飞云出洞，雁鸿相近月当空。\n德星早应贤才聚，双璧终看奉帝宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25264,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄咸阳知县臧九畴","author":"郑真","text":"篝灯夜雨共论心，鼓角声寒玉漏沈。\n赵国竟全和氏璧，不疑宁取舍郎金。\n花绫赐诰龙廷近，彩笔凝香燕署深。\n闻说孔君碑更好，人来烦寄客窗阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25265,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送卢文刚","author":"郑真","text":"矫首丹丘海上山，布衣每欲谢朝班。\n百篇藻翰真无敌，万斛牙筹祇等闲。\n彭泽传闻陶令去，羌村报道杜陵还。\n林泉未许终萧散，有待明廷召赐环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25266,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用万玉麟先生端午韵四首先生临淮知县公父也 其一","author":"郑真","text":"椿庭孝养舞斑衣，玉律蕤宾正及时。\n毛义已应称孝子，惠连终不似常儿。\n淮鱼细斫银丝脍，闽果新供锦荔枝。\n海上仙山如可到，便从王母醉瑶池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25267,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用万玉麟先生端午韵四首先生临淮知县公父也 其二","author":"郑真","text":"兰汤浴罢试罗衣，樽俎风流记一时。\n青眼每怜题柱客，白头今见起家儿。\n五声宛转歌桃叶，双袖娉婷舞柘枝。\n淮海从容京阙近，置身如在凤凰池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25268,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用万玉麟先生端午韵四首先生临淮知县公父也 其三","author":"郑真","text":"上帝恩荣儗赐衣，百年永负太平时。\n政须宝幛开云母，从使新声教雪儿。\n竹底行庖烹玉柱，花边聚佩杂琼枝。\n翰林帖子谁供奉，香染群公洗墨池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25269,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用万玉麟先生端午韵四首先生临淮知县公父也 其四","author":"郑真","text":"山中结绶上王畿，四十年来不遇时。\n空使庄生迷蝶梦，解令杜老忆熊儿。\n客窗影透榴千叶，仙窟香余桂一枝。\n泽畔独醒惭楚屈，朱门何处酒成池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25270,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"见山草堂","author":"郑真","text":"满径霜花锦绮斑，开门忽复见青山。\n宁知淮海沧茫外，如在柴桑远近间。\n白鹤孤飞云出洞，苍鸥相逐水流湾。\n客来欲问悠然趣，缥缈天风飒佩环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25271,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送何主簿权河北税毕还睢宁","author":"郑真","text":"故家文献春秋学，盛代贤良甲乙科。\n麟获久闻探鲁狩，鹿鸣今许听周歌。\n九重宫阙恩波近，千里河淮贡赋多。\n跨马归来公署静，木犀香里候鸣珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25272,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送分教戴汝庄奉旨还京","author":"郑真","text":"江海名家阀阅重，文章多说剡源翁。\n云仍尚喜风流在，乡社还怜契谊同。\n讲席三年垂绛帐，征途千里跨青骢。\n天光咫尺云霄近，献赋终当彻帝聪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25273,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送分教陈宗穆奉旨还京四","author":"郑真","text":"璧水衣冠被宠荣，沛中分教育群英。\n客毡不废三余学，家阀犹存五节名。\n汗竹光寒秋月白，碧芸香暖午风清。\n檄书催入天官选，金殿当头觐圣明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25274,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵答樊孟学 其一","author":"郑真","text":"天开泰运廓人文，江海风流喜识君。\n千里玄鸿翔碧汉，三山彩凤驾红云。\n菊松晚色吟坛共，芹藻晴香讲席分。\n百岁襟期承许与，前修何必慕崔群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25275,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵答樊孟学 其二","author":"郑真","text":"金汤形胜睹中京，宫阙煌煌万雉城。\n司马自为题柱客，终军本是弃繻生。\n久闻鸡黍原同约，须信盐梅可作羹。\n矫首奕坛仙迹近，月明来听步虚声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25276,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再用韵简沈文举 其一","author":"郑真","text":"夜窗曾忆共论文，翰苑声华独许君。\n万里光摇瀛海月，半床气湿楚山云。\n琼醅战蚁清杯泛，玉馔行庖翠釜分。\n桥梓一门华晚节，旌招当复似陈群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25277,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再用韵简沈文举 其二","author":"郑真","text":"早向吴淞数俊英，移家住近凤阳城。\n蜀中自古称扬子，洛下从今重贾生。\n共说相门频吐哺，终烦御手为调羹。\n九重步武星辰近，好听春风玉佩声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25278,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用向知事韵律诗二首 其一","author":"郑真","text":"床头旧笏积成车，阀阅前朝识故家。\n翠墨香浓廷疏草，彩毫光动诰绫花。\n濠梁雁过风生壑，归峡猿啼月印沙。\n将母不忘千里念，周诗应儗赋皇华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25279,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用向知事韵律诗二首 其二","author":"郑真","text":"松桂山中夜月凉，碧天西望峡云长。\n帝乡旅泊春秋老，使幕宾陪旦夕忙。\n苍镜启奁惊鬓白，朱衣引骑迓腰黄。\n幸逢四海文明日，霄汉终看彩凤翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25280,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"借韵二首奉呈贾通判令尊翁先生 其一","author":"郑真","text":"岱岳青齐碧海涯，伏生故里有谁家。\n秋风不用倾桑落，晓露须烦看菊花。\n剩有声名传历下，共称词赋比长沙。\n客乡喜遇忘年契，相约云端望翠华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25281,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"借韵二首奉呈贾通判令尊翁先生 其二","author":"郑真","text":"年逾七十鬓成霜，甲子从容化日长。\n堂上政须夸福寿，人间不必论闲忙。\n霜天稻熟鱼烹鲤，雨夜橙香蟹擘黄。\n衣彩已闻成乐养，风云有路看飞翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25282,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送洪太守上任淮安","author":"郑真","text":"九重诏启紫泥封，太守新除马首东。\n从使淮阳尊汲黯，解令蜀郡化文翁。\n黄阴堂覆甘棠日，皂盖香飘细麦风。\n有待政成书上考，佩声催觐大明宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25283,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈德俊归天台","author":"郑真","text":"前朝冠冕认貂蝉，劲正堂深月满天。\n共睹甘棠存旧笏，从知汗竹有遗编。\n衣冠幸际千年盛，礼乐须征百代传。\n珍重先公曾撰述，殷勤儗寄白云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25284,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄万玉麟郡公 其一","author":"郑真","text":"佳儿作郡树双旌，上国遥传月旦评。\n三釜琼羞成乐养，九重花诰盼恩荣。\n高风愿下陈蕃榻，往事宁夸李愬兵。\n海寓一家文启运，祇将歌颂答升平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25285,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]