[{"title":"送吴生甫还新安","author":"欧大任","text":"垂杨通潞渚，客问五湖船。\n世事丹铅里，归心白岳前。\n秫香堪足酒，橘熟不论钱。\n画手吴生老，思予说剑年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6736,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁庸卿陆华甫顾汝修黎惟敬顾汝和同集王彦贻斋中谈五岳之胜得龙字","author":"欧大任","text":"一室晤言几，诸郎握麈从。\n青云看似鹫，紫气识犹龙。\n游可期禽庆，归能待邴容。\n十年怀住岳，不用酒泉封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6737,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伏日同陆华甫李惟寅李于美胡茂承朱汝修避暑普安寺得云字","author":"欧大任","text":"清凉惟净土，坐久蔼氤氲。\n竹院飘苍雪，花台驻白云。\n欢深投辖得，歌歇绕梁闻。\n谁谓楼烦客，宗雷亦可群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6738,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送稿城王少府","author":"欧大任","text":"并州君作尉，手版府中趋。\n家自文无害，人今德不孤。\n行春开石溜，游徼过卢奴。\n梅福南昌客，封章满汉都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6739,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱邦肃山中葬母","author":"欧大任","text":"千秋阴隧闭，鸡骨不堪支。\n慈训哀何及，馀生敢自期。\n群乌衔土日，大鸟下坟时。\n莫诵劬劳句，门人已废诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6740,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"方伯求持卷见过有赠","author":"欧大任","text":"三都今奏赋，两浙尔称才。\n自昔霸王略，多从羁旅来。\n负薪曾未倦，扣角不须哀。\n突兀黄金气，风云满蓟台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6741,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送文子排赴浦江令","author":"欧大任","text":"绾绶向仙华，城边瀫水槎。\n孝廉新授邑，太史故名家。\n百榼兰阴酒，双溪橘子花。\n行春劳茂宰，丹诏下天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6742,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中集玉河堤之光远堂得披字","author":"欧大任","text":"冲泥吾不怯，观雨得佳期。\n入树莺全湿，沾林锦半披。\n病同漳水客，饮似曲江时。\n刷羽年垂老，栖迟感鬓丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6743,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诒馨堂为潘子朋赋","author":"欧大任","text":"吾州称令族，诸子冠高阳。\n林似幽人宅，谷多王者香。\n商颜芝并茂，楚水蕙曾穰。\n彤管谁诒女，家声奕叶长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6744,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"永上人邀李明府及余兄弟过广济寺逢金陵恩上人同登藏经阁","author":"欧大任","text":"净因吾欲习，偶尔过珠林。\n花露沾清供，松风发妙音。\n片霞高阁色，一鹤白云心。\n庐阜能开社，攒眉亦可寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6745,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京送舍弟经季南还","author":"欧大任","text":"归人不忍送，况是雁行疏。\n愧尔求初服，先予问隐居。\n良常茅氏宅，鄮上陆云书。\n岂必栖名岳，朱明有弊庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6746,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别陆华甫","author":"欧大任","text":"别去易经岁，萧条久客情。\n轻装燕雁后，短策岱云行。\n有发称居士，无家似外兵。\n故人还待汝，羁马蓟门城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6747,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答黄清甫因讯谈世重","author":"欧大任","text":"故人能枉策，已是十年期。\n到寺惟看竹，题门一赋诗。\n参军枢筦客，徵士汝南师。\n不厌青毡冷，黄花尚未迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6748,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九月朔昌平道中少宰何公见示登览之作用韵奉和","author":"欧大任","text":"千骑出郊坰，行寻督亢亭。\n露华长塞白，秋色太行青。\n玩世求中圣，尊生学大宁。\n从公玄览处，何但小沧溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6749,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陵祀毕夜还昌平馆","author":"欧大任","text":"清霜一叶下，陵木忽苍然。\n玉漏秋偏急，银灯夜不迁。\n卷芦军幕外，促织客床前。\n回首思园邑，天山片月悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6750,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张仪部被播还安成","author":"欧大任","text":"兄弟交偏久，风波别奈何。\n编韦家学贵，汁竹世臣多。\n山气聊支笏，江烟不废蓑。\n主恩元自厚，行矣慰蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6751,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄方太常","author":"欧大任","text":"满目浮云过，惟君善闭关。\n思玄平子宅，抱膝武侯山。\n酒熟奇谁问，诗成句自删。\n江东消息好，须赋二京还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6752,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"残岁二首 其一","author":"欧大任","text":"久客怜残岁，微才负盛时。\n买曾羞骏骨，妒敢恨蛾眉。\n漫灭三年刺，沉冥五字诗。\n青山猿鹤在，何日不相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6753,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"残岁二首 其二","author":"欧大任","text":"头颅吾自爱，簪笏未堪捐。\n世事随沤泛，天年似栎全。\n梦难忘马箠，书不废鱼笺。\n寂莫扬雄阁，惟应守太玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6754,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕过任山甫不遇","author":"欧大任","text":"任昉诗谁似，风流大郡僚。\n贡金同九牧，鸣佩已三朝。\n岁暮家炊桂，天涯客颂椒。\n寻君不可见，羸马玉河桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6755,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送大宗伯古林何公致仕南归二首 其一","author":"欧大任","text":"行藏四十载，今不愧乾坤。\n世仗名儒议，天全圣主恩。\n著书留石室，隐几杜柴门。\n从此罗浮上，烟霞道益尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6756,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送大宗伯古林何公致仕南归二首 其二","author":"欧大任","text":"再出完名去，朝廷念朴忠。\n言为汉班伯，学似鲁申公。\n沧海扁舟月，西樵大笠风。\n投簪吾亦逝，倘许褐衣同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6757,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李维周太学南还省觐","author":"欧大任","text":"岳立忠臣胄，追趋在虎门。\n才优三百乘，学擅五千言。\n笋蕨思调膳，蓬蒿喜满园。\n通家怀尔祖，头臼几人存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6758,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送沈符卿以安赴留都","author":"欧大任","text":"奉玺傍云霄，才名本自超。\n诗传鲍氏体，带学沈郎腰。\n草色连三市，江声似六朝。\n却看卿月近，相忆白门桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6759,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上巳同周子翼汤尧文朱子忠冯汝行曹应麒高升伯过陈炼师馆观海棠","author":"欧大任","text":"客来修褉事，春在列仙家。\n窈窕萦烟出，扶疏结绮斜。\n窗留玄圃月，山倚赤城霞。\n谁更誇西府，新移玉树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6760,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同黎秘书孙太史顾评事诸君过王鸿胪宅静修上人亦至得轻字","author":"欧大任","text":"紫宸班始散，数骑巷西行。\n密坐逢缁侣，长斋对曲生。\n避人双树小，出世万缘轻。\n但得沉冥理，谁知大隐名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6761,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同于殿讲黎秘书李明府静修上人集圆通精舍得天字","author":"欧大任","text":"躧履金门下，而来宝树前。\n花林开十地，萝径到诸天。\n净土匡山社，宗风雪窦禅。\n田衣参讲席，莫向外人传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6762,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郑光禄邀游智化寺登万佛阁同黎秘书李明府二张光禄分得繁字","author":"欧大任","text":"能不缁尘厌，纷其车马繁。\n阁临平乐观，春在给孤园。\n星汉回燕甸，河山绕蓟门。\n郑庄宾客盛，犹自足清尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6763,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送怀远李明府","author":"欧大任","text":"郎官今出宰，行矣慰黔黎。\n驿过龙城北，山盘象郡西。\n莎庭看鹿下，竹濑听猿啼。\n双舄何年起，留诗似冉溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6764,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬吴曰南入都见贻","author":"欧大任","text":"吏隐半烟霞，相逢鬓已华。\n江淮频有梦，京洛久无家。\n我自悉炊桂，君今待赐麻。\n席茵须蚤就，春过五陵花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6765,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寺居病起酬京口陈从训过访","author":"欧大任","text":"谁能同把苦，何意挹清芬。\n句丽东溟月，装轻北固云。\n深谈怜贝简，新草愧玄文。\n似为茶瓜乐，相携到夕曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6766,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕同黎惟敬范子宣张元易郑伯良王彦贻朱汝修集华存叔馆时存叔初至得长字","author":"欧大任","text":"故人忽以至，十载曾相望。\n顾我愧三益，爱君怀七襄。\n夜深乌鹊度，秋色银河长。\n离合浑难定，不妨频进觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6767,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"司马东沙张公挽歌二首 其一","author":"欧大任","text":"枢筦陪京日，东南羽檄飞。\n姓曾铭阁重，策岂画江非。\n远志惟看剑，先朝有赐衣。\n谷城山下石，犹共赤松归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6768,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"司马东沙张公挽歌二首 其二","author":"欧大任","text":"悬车忻蚤岁，曳履忆崇班。\n书似关门著，丹从海上还。\n烟霞新茂屿，几杖半名山。\n寂寞麒麟画，威灵在百蛮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6769,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘园饯唐惟良入贺还扬州得园字","author":"欧大任","text":"犹作趋朝客，难忘去国恩。\n使君停上驷，伧父到名园。\n石竹乌皮几，秋花浊酒尊。\n江淮如见月，应忆灞陵原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6770,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同惟敬仲修袭美元易于海子亭再别惟良得阴字","author":"欧大任","text":"泠泠海子曲，斗酒似情深。\n兰芷骚人赋，刀环国士心。\n天风回爽气，岛日下秋阴。\n君去淮南路，山幽尚可寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6771,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"士鹄见过同宿显恩禅房得深字","author":"欧大任","text":"同舍别何久，乍逢秋已深。\n君方理簪绂，吾欲乞山林。\n橐笔三朝客，支筇五岳心。\n故园萝薜约，开阁待长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6772,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬姚元白画梅见寄","author":"欧大任","text":"不见故人久，梅花何处秋。\n溪园开白下，法署似扬州。\n把笔鹅群阁，巡檐鹤氅裘。\n南归吾计决，相忆在罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6773,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄陈子野","author":"欧大任","text":"篱门君不出，五柳未萧条。\n明月新林浦，秋风白下桥。\n津人理舟楫，江客候风潮。\n去矣吾将隐，名山不待招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6774,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王鸿胪彦贻得请归养二首 其一","author":"欧大任","text":"一疏归怀遂，宁论典客官。\n梦为扇枕恋，游得奉舆□。\n华参供调膳，初衣待沐兰。\n主恩天共远，能不忆长安。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6775,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王鸿胪彦贻得请归养二首 其二","author":"欧大任","text":"诏许宁亲去，秋风兴渺然。\n裹茶二泉寺，吹笛五湖船。\n橘子新开辅，鲈鱼不论钱。\n青山招隐久，吾亦赋归田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6776,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黎秘书携酒同顾舍人吕蒋二山人礼永二上人集普恩寺得过字","author":"欧大任","text":"精舍双峰外，君能载酒过。\n开筵邀翰墨，驻马系藤萝。\n客恋名山几，僧修净土多。\n甘泉烽不到，深酌意如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6777,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同黎秘书王纳言李临淮李宛平过刘观察园玩菊","author":"欧大任","text":"三秦归白首，园似辟疆开。\n北海樽能满，东篱客渐来。\n霜华碣石馆，秋色蓟丘台。\n摇落登高日，谁怜作赋才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6778,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中张平叔杨汝德汪子建茅平仲诸君见过得钟字","author":"欧大任","text":"苜蓿饭不足，伊蒲馔稍供。\n持经吾尚病，问字客能从。\n斋后容呼酒，醒时一扣钟。\n出门双树下，雪色满西峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6779,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈比部君谟考绩还留都","author":"欧大任","text":"冻坂紫骝鸣，都亭奏最行。\n雪花燕甸树，雁字石头城。\n经术陪庭议，循良起吏名。\n君看金虎署，自昔重西京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6780,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陶文僖公挽词二首 其一","author":"欧大任","text":"国礼尊师傅，皇恩重范型。\n尚书麻作诰，学士幄存经。\n器给东园秘，阡题上相铭。\n当时楹奠后，遗迹在丹青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6781,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陶文僖公挽词二首 其二","author":"欧大任","text":"世表寻阳系，明公自庆源。\n周家八士盛，汉日五更尊。\n封禅曾收草，精禋尚赐膰。\n千秋麟凤宅，谁得似云门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6782,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭徐子与四首 其一","author":"欧大任","text":"一哭豫章信，浮生安可论。\n书犹椷小草，魂已入修门。\n诸路江藩重，三阶岳伯尊。\n所嗟玄未就，遗札待谁存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6783,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭徐子与四首 其二","author":"欧大任","text":"青萝馆前色，悽怆白云残。\n儿岂蓝田胜，家犹霅水寒。\n时情曾睚眦，吾道尚艰难。\n他日西州路，谁同驻马看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6784,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭徐子与四首 其三","author":"欧大任","text":"岂料蓟门别，交期尽此生。\n江湖徐稚宅，涕泪灌婴城。\n旧业空书卷，中兴有赋名。\n悲风号顾渚，萧瑟一含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6785,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭徐子与四首 其四","author":"欧大任","text":"宗梁凋落蚤，李谢丧亡频。\n今日哀词伯，中原失故人。\n笳箫三楚雨，井径五湖春。\n剑自延陵许，愁攀宰树新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6786,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日答范京兆景伯郡斋见柬","author":"欧大任","text":"共是积薪客，欢闻乔木声。\n班仍鹓序旧，官以马曹名。\n岭峤吾将隐，潇湘问去程。\n报君人日句，未敢拟同行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6787,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答梅禹金见寄","author":"欧大任","text":"吾将深敛屐，君尚待支藤。\n归似辽东鹤，抟看海上鹏。\n婆挲曾偶寄，疲薾谢先登。\n便候江花发，何时到宛陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6788,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"久客","author":"欧大任","text":"五斗意悠悠，他乡又几秋。\n毡寒诸幼念，书懒老妻愁。\n禁籞羞黄鹄，烟波负白鸥。\n归人不相待，先傍钓渔舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6789,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莫肇襄携酒夜过听冯文在弹琴","author":"欧大任","text":"荒斋惟二子，渐觉故人稀。\n下榻松风过，鸣弦竹露飞。\n官犹怜有酒，客敢叹无衣。\n双瀑朱明馆，何时共掩扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6790,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同伍舍人谢侍御饯朱民部使代州便道省觐二首 其一","author":"欧大任","text":"燕郊荐玉觞，送美度支郎。\n赵璧圆疑月，并刀削似霜。\n听鸡过汴水，下马入蕲阳。\n早奉中涓教，归来谒建章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6791,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同伍舍人谢侍御饯朱民部使代州便道省觐二首 其二","author":"欧大任","text":"春草度飞狐，星轺肯驻无。\n雁门劳使者，鸡塞走单于。\n岳色青萍远，边歌白雪孤。\n长杨趋奏赋，天子正誇胡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6792,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄山人孔昭见过","author":"欧大任","text":"尔自何方至，丹青手自携。\n身游三辅北，家在七闽西。\n廓落心俱远，逍遥物共齐。\n朱门慵削牍，丹壑惯扶藜。\n笠小披山雾，鞋穿踏雪泥。\n隐囊双管玉，大布一袍绨。\n班氏书堪借，扬亭酒欲赍。\n愁惟歌九咏，力肯破群迷。\n揖客将军贵，工诗处士题。\n不嫌盘苜蓿，频约过禅栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6793,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明日同王银台方奉常集李宛平宅观红梅花赋得春字十韵嘉靖末余与王方二君广陵游咏最久隆庆中会李君于汝南别亦七载今并集京师不佞病且思归篇中故兼述云","author":"欧大任","text":"汉宫传蜡后，万户禁烟新。\n密坐谁邀客，寒花尚待人。\n赤珠褰幔错，紫玉缀条匀。\n色借霞标晚，光摇彩笔晨。\n县中桃比艳，佩里蕙同纫。\n汝水欢初识，扬州醉几巡。\n千山惟有梦，十载忽相亲。\n赏得长安令，香沾近侍臣。\n乡书愁寄驿，塞笛暗伤春。\n独忆江南远，尊前愧此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6794,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送程别驾子白赴平乐","author":"欧大任","text":"考牧功初奏，弯弧志出群。\n官犹劳郡倅，誓欲扫边氛。\n白羽秋摇月，青油暮捲云。\n泽深临贺水，威傍伏波军。\n坐啸堪资画，谈兵蚤策勋。\n城开诸洞伏，山拥九疑分。\n铜鼓多欢宴，匏笙实饱闻。\n敢轻程不识，看尔报明君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6795,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日同方奉常刘舍人饮李明府吏隐轩得江字限八韵","author":"欧大任","text":"退食能邀客，春阴满北窗。\n苑花飞片片，山鸟下双双。\n吏散琴开匣，歌成笛按腔。\n俸宁论百石，酒但泛千缸。\n醉眼君堪白，愁眉我自庞。\n祇应随执戟，谁便得归艭。\n禄赐俱称隐，乡心未易降。\n宅边西海子，曾解似丹江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6796,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莆田陈比部怡老园其子中允君索赋","author":"欧大任","text":"昭代西曹彦，儒林起大名。\n业从漆简授，法以竹书精。\n鲍氏骢堪继，于门驷可行。\n挂冠神武蚤，卜筑木兰清。\n乐志园初辟，尊生世已轻。\n相才推叔向，家学得玄成。\n紬史衣簪盛，囊经侍从荣。\n人传彤管事，天适白鸥情。\n宪老歌三寿，临雍召五更。\n谁知沧海上，南极一星明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6797,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张元易迁上林苑丞访其别署偶作","author":"欧大任","text":"故人张仲蔚，斋馆学逃禅。\n岂薄汤官小，偏閒苑监年。\n树萩犹济上，司竹似淇边。\n简出常封印，清歌不废弦。\n薮连钩盾署，餐给水衡钱。\n颇足沽燕酒，相从一醉眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6798,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"万玉山房为司武选赋","author":"欧大任","text":"十里筼筜谷，幽居称考槃。\n郢都连负郭，沱水引飞湍。\n绿雪双溪净，苍云一径寒。\n餐曾分沆瀣，句已满琅玕。\n隐迹罗含远，禅心大士安。\n雅歌裁凤管，学钓选鱼竿。\n强起瑶为节，长怀箨可冠。\n东山回首处，词客在金銮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6799,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]