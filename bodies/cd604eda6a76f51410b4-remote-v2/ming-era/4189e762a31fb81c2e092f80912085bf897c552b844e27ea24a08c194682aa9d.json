[{"title":"读文山传三首 其二","author":"薛瑄","text":"丞相声名二百年，分明往事在遗编。\n初离故国悲禾黍，再立危邦惨杜鹃。\n大势已倾宁畏死，孤忠自许敢求全。\n当时桃李知何限，回首春风尽落然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5597,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"读文山传三首 其三","author":"薛瑄","text":"氛祲冥冥暗海波，英雄无地用干戈。\n精忠在我当如此，成败由天奈若何。\n渺渺苍梧西日淡，萧萧大地北风多。\n睢阳锦里皆祠庙，丞相勋名共不磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5598,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登南坡","author":"薛瑄","text":"土阜层层有万盘，偶来高顶望人寰。\n满川宿麦浮青浪，一带晴岚列翠鬟。\n何处云霞迷碛石，数村桑柘绕绵山。\n唐风晋问凭谁说，地阔天高雁影閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5599,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日怀刘佥宪三首 其一","author":"薛瑄","text":"千里关河归故邑，两年风景忆虚庵。\n郢中白雪知谁和，爨下清琴想自谙。\n君拥霜台名未已，我伤风木意难堪。\n近来几欲裁书寄，春雁其如不向南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5600,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日怀刘佥宪三首 其二","author":"薛瑄","text":"南望中州有所思，山川回首岁华移。\n早春京索衔杯处，晚岁崤函驻马时。\n月满覃怀陪款语，霜清河朔寄新诗。\n旧游一一成追忆，此后相逢更有期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5601,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日怀刘佥宪三首 其三","author":"薛瑄","text":"虚庵事业久砻磨，宪府乘骢岁月多。\n已见风霜清郡邑，况闻词赋动关河。\n几回邂逅情如旧，两载相思意若何。\n自古中州多胜迹，拟从飞盖尽经过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5602,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重登故镇寺楼","author":"薛瑄","text":"重来故镇已三秋，又上招提百尺楼。\n山绕飞甍浮翠黛，岸遮远日断黄流。\n回溪俯瞰粼粼玉，乔木深藏曲曲丘。\n莫谓此时穷胜槩，还期汗漫九垓游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5603,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"纪先人旧游三首 其一","author":"薛瑄","text":"树已成林麦满郊，春风春雨自飘萧。\n孤云出岫飞还逐，众鸟归林啸且招。\n俯仰空惊天地在，低迷深觉岁华遥。\n旧游山水俱成感，抆泪思亲首屡搔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5604,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"纪先人旧游三首 其二","author":"薛瑄","text":"阴阴夏木绕茅庐，曾是先人旧寓居。\n梁上又来前度燕，箧中空有昔年书。\n声音尚想当窗发，杖履犹疑隔户趍。\n五内此时摧裂甚，诗成满纸泪如珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5605,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"纪先人旧游三首 其三","author":"薛瑄","text":"秖愿庭椿过百龄，宁知奄忽便摧零。\n旧游山水皆悲思，昔住园庐荩惨情。\n菽水有欢成昨梦，衣冠无计睹平生。\n孙儿指点经行处，清泪如泉散漫倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5606,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中简周秉忠三首 其一","author":"薛瑄","text":"独抱离忧罢酒樽，更看连日雨倾盆。\n庭除汨汨深流潦，几砚层层润积痕。\n往事一编聊自诧，永怀千古向谁论。\n先生最是知音者，咫尺何由一扣门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5607,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中简周秉忠三首 其二","author":"薛瑄","text":"两耳潇潇怯雨声，三更起坐到天明。\n小濡自合通宵湿，大厦何由不日成。\n倾泻只疑天汉竭，奔流深恐地维倾。\n会须万里清风至，尽扫云阴放晓晴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5608,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中简周秉忠三首 其三","author":"薛瑄","text":"客居长日少人过，况复经旬积雨多。\n自爱窗前生绿草，不妨门外注银河。\n顽云碍日能为沴，流潦因风解起波。\n为问郡庠周博士，此时官况定如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5609,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠海昌李太亨四首 其一","author":"薛瑄","text":"客里终天痛有馀，感君相慰意难舒。\n细论往日交情厚，却讶连年音问疏。\n肝胆旧看如古鉴，诗篇今睹胜明珠。\n暂时相见还相别，况是关河雁过初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5610,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠海昌李太亨四首 其二","author":"薛瑄","text":"我在中州君在吴，几年寥落雁书无。\n每思谢氏登山屐，长忆黄公卖酒垆。\n忽共青灯谈肺腑，细看白雪点头颅。\n英雄不减当时壮，耿耿秋空剑气孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5611,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠海昌李太亨四首 其三","author":"薛瑄","text":"古今身世共茫茫，出处无端总是常。\n才俊从来推贾谊，功名未必老冯唐。\n几看上谷秋鸿影，忽对中州夜月光。\n圣代只今登俊彦，岂容江海久徜徉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5612,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠海昌李太亨四首 其四","author":"薛瑄","text":"中州风景正凄清，忽与交亲话旧情。\n往日襟怀常浩荡，昔年豪杰渐飘零。\n一渠汴水涵秋碧，万仞嵩山露晓青。\n胜地相逢应不偶，好将佳句咏耆英。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5613,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"简揭克英府幕","author":"薛瑄","text":"闻道徵租日正忙，暂移行幕驻僧房。\n红莲泛水浮朝彩，绿树摇风引夕凉。\n公暇不妨寻好句，讲时端复炷名香。\n好将宽政安黎庶，留取功名汗简光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5614,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪后寄杨景端","author":"薛瑄","text":"雪白山青北望高，相思咫尺兴滔滔。\n若人未必伤沈郁，吾道何须叹寂寥。\n董贾文章鸣治世，皋夔事业拟清朝。\n村居不识杨夫子，懒慢何心作解嘲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5615,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"读许鲁斋思亲诗","author":"薛瑄","text":"思却千思与万思，音容无复见当时。\n草窗夜静灯前教，蔬圃春深膝下嬉。\n将谓百年供色养，岂期一日便生离。\n泰山为砺终磨灭，此恨绵绵未易衰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5616,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵 其一","author":"薛瑄","text":"触目家山总是思，思亲况遇早春时。\n日长每听诗书训，风暖频随杖履嬉。\n百载韶华成荏苒，终天涕泪感睽离。\n自缘孤子无诚孝，不是人生有盛衰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5617,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵 其二","author":"薛瑄","text":"风光满目动哀思，春草春花似旧时。\n堂斧已成终古恨，斑斓不复往时嬉。\n中宵秖解追前梦，隔岁犹如在远离。\n却忆高堂览明镜，曾将华发叹年衰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5618,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵 其三","author":"薛瑄","text":"彷佛音容彷佛思，衣冠出入忆当时。\n成人未返林乌哺，稚子曾骑竹马嬉。\n椿老暮庭风槭槭，草荒春冢雨离离。\n固知罔极恩难报，只恐终天孝易衰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5619,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"曲沃道中二首 其一","author":"薛瑄","text":"孟秋雨霁过新田，绿树人家断复连。\n汾浍波光晴泛日，绛乔山色晓参天。\n申生大孝留天地，里克遗名载简编。\n何事齐姜坟上草，忍将芳意度流年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5620,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"曲沃道中二首 其二","author":"薛瑄","text":"四围山抱一川平，新晋犹传旧日名。\n汾隰涨消秋色淡，虒祁宫老夕阳明。\n歌传乌鸟空遗恨，诗赋椒聊谩有情。\n往事无端何足问，且听父老说秋成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5621,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荥阳咏古八首 其一","author":"薛瑄","text":"京索千年能战尘，空将往事问居民。\n山川远近皆陈迹，道路东西是要津。\n黄屋几回思义士，赤精终古有真人。\n拔山举鼎知何似，马到乌江感慨频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5622,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荥阳咏古八首 其二","author":"薛瑄","text":"万山依旧接嵩丘，京索于今不断流。\n庄段是非留隧道，项刘成败有鸿沟。\n古槐树历岁时久，大海寺经风雨秋。\n更上高原访遗迹，荒城故垒暮云稠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5623,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荥阳咏古八首 其三","author":"薛瑄","text":"日迥天高秋气清，登临怀古倍多情。\n山连广武故城在，路入鸿沟草树平。\n甬道年深无旧迹，索流岁久只新声。\n兴亡莫道皆如梦，终古犹存楚汉名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5624,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荥阳咏古八首 其四","author":"薛瑄","text":"楚汉干戈久已休，尚存遗迹在中州。\n几湾流水风烟暮，一片荒城草树秋。\n力战可堪离广武，分疆空见指鸿沟。\n当时四百兴刘计，只在张良一运筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5625,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荥阳咏古八首 其六","author":"薛瑄","text":"陵谷高低控虎牢，战声消息水滔滔。\n旌旗满眼无遗迹，壁垒连云只旧壕。\n广武西原通巩洛，万山南面接嵩高。\n悠悠往事皆如此，怀古登临何太劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5626,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荥阳咏古八首 其七","author":"薛瑄","text":"荥阳景物似当时，不见唐朝老画师。\n隧道庄姜今已矣，京城太叔果何为。\n留侯计用炎光振，亚父身亡霸业衰。\n多少是非成往鉴，莫将遗事使人悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5627,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荥阳咏古八首 其八","author":"薛瑄","text":"冈峦回合一川平，涧壑高低绕故城。\n千古好山宁改色，满溪流水不停声。\n留侯总得翕张术，汉祖深存驾驭情。\n更莫登高发长啸，当时豪杰已成名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5628,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题沈令送别卷","author":"薛瑄","text":"双凫缥缈上青霄，令尹朝天不惮遥。\n密县于今思卓茂，淮南自昔想时苗。\n玉阶仗引龙旗合，宝殿香浮雉扇高。\n鸿雁近秋多健翮，佳章早慰此心劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5629,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西郊看刈禾二首 其一","author":"薛瑄","text":"为农每爱宽平地，已向中州住七年。\n莫道功名当早岁，且看禾黍熟秋天。\n萧萧满地收霜穗，整整成摞积晚烟。\n浊酒一壶劳僮仆，素餐深恐愧前贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5630,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西郊看刈禾二首 其二","author":"薛瑄","text":"西原秋气早生凉，禾黍离离被陇黄。\n穫处风烟轻捲席，积来雁鹜整分行。\n大田已见多遗穗，客廪应知足剩粮。\n莫叹书生亲稼穑，躬耕有客卧南阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5631,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"酬黄养正韵","author":"薛瑄","text":"翰苑香名乂已闻，蓟门秋晚又逢君。\n孤城木落虫吟月，旅馆风来雁唳云。\n眼底江山期共赋，马头岐路惜重分。\n辽西不久留才子，昭代如今正右文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5632,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"经王素亨旧居","author":"薛瑄","text":"野浦荒村访旧居，鸟啼花落碧窗虚。\n芜园不复栽红药，閒馆曾经看素书。\n对酒每怀陶靖节，论文长笑马相如。\n自从雕鹗因风去，水色山光思有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5633,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"经玉田挽待诏鲁仲辉","author":"薛瑄","text":"孤树山前两度过，怀人搔首重悲歌。\n文章事业今如此，别鹤行云竟若何。\n渺渺夕阳乡树远，萋萋芳草旅封多。\n人间俯仰堪惆怅，不必临流叹逝波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5634,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"都城即事","author":"薛瑄","text":"曈昽晓日上蓬莱，缥缈祥云拥泰阶。\n旌旆风摇龙虎动，箫韶声奏凤凰来。\n九衢车马香尘合，万井笙歌曙色开。\n千古上游形胜地，两都欲赋愧非才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5635,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过苑仲仁庄居","author":"薛瑄","text":"爽气澄清暑雨馀，乘閒信马到村居。\n桑麻影里元卿径，杨柳阴中靖节庐。\n纵饮百壶贤圣酒，剧谈千古帝王书。\n篱边黄菊烦多种，九日还来一访渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5636,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"无题四首 其一","author":"薛瑄","text":"逸思飘然赋远游，可堪三岛隔瀛州。\n曾闻神女云侵鬓，见说麻姑雪满头。\n海上楼台常似昼，山中瑶草不知秋。\n若为借得仙家鹤，鸣佩珊珊玩九州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5637,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"无题四首 其二","author":"薛瑄","text":"桂馆琼扉薜荔墙，清脩独尔意难忘。\n已将兰芷为芳藉，更集芙蓉制锦裳。\n洛浦佳人鸣佩玉，茂陵才子咏鸾凰。\n应须一卺仙家酒，散作人间雨露香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5638,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"无题四首 其三","author":"薛瑄","text":"风满珠帘月满楼，瑶台有路可追游。\n香生宝鸭沉烟细，露滴银床玉宇秋。\n楚岫三更云渺渺，蓝桥千里浪悠悠。\n花笺写就烦青鸟，更为殷勤到十洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5639,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"无题四首 其四","author":"薛瑄","text":"绝世青娥二八馀，仙容绰约好楼居。\n鲛人夜织绡为帔，云女秋裁锦作裾。\n碧海兰苕巢翡翠，瑶池清水泛芙蕖。\n秖应待得吹箫伴，共跨飞鸾蹑太虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5640,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题旧石桥","author":"薛瑄","text":"古桥欹侧岸萦回，立马临流一怆怀。\n鲸兽水沉沙底石，蛟螭碑莳雨中苔。\n阑干几曲人频倚，华表千年鹤再来。\n扰扰劳生只如此，好将襟抱酒中开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5641,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿水村二首 其一","author":"薛瑄","text":"日暮江头送客还，寂寥清夜不成欢。\n连天海气当窗白，一枕江风入梦寒。\n鸡唱远村皆落月，潮生古渡已层澜。\n披衣久坐待明发，白石歌馀兴未阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5642,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿水村二首 其二","author":"薛瑄","text":"投宿江村日已昏，村童还为启柴门。\n壶觞欲醉黄翁酒，盘馔深惭漂母飧。\n夜雪生香芦被煖，晚烟添绿土床温。\n清宵总是沧波趣，莫向人寰取次论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5643,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日遣兴","author":"薛瑄","text":"霭霭春云度女墙，萋萋春草遍芳塘。\n园林风景非吾土，庭馆莺花是异乡。\n野岸波纹浮鸭绿，官桥柳色弄鹅黄。\n不知多少相思意，秖逐游丝百尺长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5644,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日寄王嘉靖","author":"薛瑄","text":"渔阳秋色动关河，辽右天晴一雁过。\n白社高人浑懒慢，青毡学士久蹉跎。\n西风对酒砧声切，良夜调琴月影多。\n珍重远书劳问讯，相思千里奈情何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5645,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日次徐怀玉韵","author":"薛瑄","text":"对酒东篱自咏诗，远山晴望转逶迤。\n秋容淡薄黄花节，风景萧条白雁时。\n醉阅人寰聊纵目，静思尘事久支颐。\n年年此日无穷意，笑把茱萸欲赠谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5646,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"简白沈吕三藩府二首 其一","author":"薛瑄","text":"雄镇堂堂相府深，炉烟不受晓寒侵。\n调元总属经纶手，下士常存吐握心。\n岁晚松枝留劲节，春来棠叶蔼浓阴。\n丰功会见铭钟鼎，应有清光照古今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5647,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"简白沈吕三藩府二首 其二","author":"薛瑄","text":"大卤提封接帝居，大藩公相尽名儒。\n观风岁久山常静，宣德冬来日渐舒。\n画省煖云浮瑞鸭，雕阑晴雪照金鱼。\n书生亦有扶摇翼，更借刚风到碧虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5648,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别文孙王宋四广文","author":"薛瑄","text":"我客并州岁宴时，偶然相见即相知。\n香醪浅酌还深酌，佳句朝题复暮题。\n意气难逢今日好，风流不让古人为。\n嗟予走马明朝去，雪岭冰崖有所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5649,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"早过天津","author":"薛瑄","text":"烟收泽国晓天晴，日出扶桑万里明。\n二水交流东海阔，一城雄镇朔方清。\n连云风送孤帆远，夹岸潮随大舶平。\n借问关门来往客，不知谁是弃繻生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5650,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"七夕雨","author":"薛瑄","text":"天孙不乞人间巧，故使秋云蔽月辉。\n银汉晚烟迷鹤驭，玉霄凉雨溅仙衣。\n更无綵结看蛛缀，秪想桥成有鹊飞。\n独立秋风倍惆怅，通津何处问榰机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5651,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日怀旧游简胥贡士二首 其一","author":"薛瑄","text":"蓟门春色阻关河，汴野东风长绿莎。\n正是怀人烟景暮，不堪对酒雨声多。\n閒中谩写凌云赋，醉里谁听白雪歌。\n惟有流莺相厚意，柳溪花径数来过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5652,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日怀旧游简胥贡士二首 其二","author":"薛瑄","text":"落落襟怀正黯然，早春时节忆前年。\n玉田城外花经雨，蓝水桥头柳带烟。\n千里交游成远梦，百年踪迹任皇天。\n高山流水知音在，还对东风理素弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5653,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登资圣阁二首 其一","author":"薛瑄","text":"梁苑清秋白昼閒，偶寻名刹扣禅关。\n百盘飞磴身遥上，千尺危阑手自攀。\n已见神游朝贝阙，便从羽化出尘寰。\n中天俯仰多时节，飒飒天风冷佩环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5654,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登资圣阁二首 其二","author":"薛瑄","text":"化人楼閤倚晴霄，大地山河极望遥。\n秋入淮黄波浩荡，云开嵩少影岧峣。\n九天沆瀣寒堪吸，八牖星辰近可招。\n十二曲阑浑倚遍，一襟凉思正飘飘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5655,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鹿鸣宴二首 其一","author":"薛瑄","text":"揭晓乡闱日正晴，大开藩府会文星。\n绣衣弭节皆英俊，章甫持衡尽老成。\n龙管缓吹金缕细，凤笙齐逐玉杯行。\n酒阑归骑西风稳，蟾魄秋高万里明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5656,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鹿鸣宴二首 其二","author":"薛瑄","text":"古木森森政事堂，兴贤开宴会金章。\n绯衣送酒倾鹦鹉，翠袖吹笙引凤凰。\n晴日渐移珠箔影，暖烟深护瑞炉香。\n秪知醉里风云阔，袖拂归鞭满路霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5657,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚翠轩为李大参赋","author":"薛瑄","text":"为嫌红紫竞春风，独爱幽轩晚色浓。\n霜后翠飘千个竹，雪中清蔼数株松。\n自缘品汇孤根别，解与忠良劲节同。\n画省公馀看未足，一襟清思岁寒中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5658,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题沧州丹室卷","author":"薛瑄","text":"道人结屋沧州里，四面阑干枕碧湍。\n石榻生寒秋气润，柴门涌月夜涛寒。\n鸾凰佩影空中见，龙虎丹光水底蟠。\n清绝一尘飞不到，蓬壶元只在人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5659,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送友人下第归山东","author":"薛瑄","text":"残红满地草萋萋，把酒都门惜解携。\n秪拟大鹏抟碧落，可应骝马蹶霜蹄。\n天开汶水龟蒙近，日转瀛洲岱岳低。\n一曲瑶琴休怅别，重来云路有丹梯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5660,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]