[{"title":"秋日龙山写怀","author":"安国","text":"收拾农功始得闲，西风吹我上龙山。\n白云满路迷行迹，红叶千林斗醉颜。\n半日聊成鸡黍约，几人能脱利名关。\n偶逢老衲流连久，月吐松梢尚未还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20704,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"胶山","author":"安国","text":"梵王宫殿锁烟霞，墓接萧郎道路斜。\n锡窦乳泉常煮玉，金牛足迹未沉沙。\n香花桥古横螮蝀，涤砚池荒聚乱蛙。\n还有古人砺剑处，碎琼石坞到仙家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20705,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"胶山万玉亭","author":"安国","text":"老僧种竹十千竿，环绕幽亭六月寒。\n我顾龙孙添满眼，清风千古报平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20706,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"碧山吟社和匏庵吴太师韵二首 其一","author":"安如山","text":"骚坛结客出湖南，径僻由来车马谙。\n绝壁旧题荒藓合，空潭倒影乱峰涵。\n高踪讶许香山并，名理真徒莲社探。\n拟向邻僧分半榻，皈依常傍白云龛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20707,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"碧山吟社和匏庵吴太师韵二首 其二","author":"安如山","text":"江左风流感昔贤，寥寥谁复寄真诠。\n攒眉不禁陶公酒，合掌同参惠远禅。\n词赋一时追绝响，莺花三月缔清缘。\n相看惚是耆英侣，丘壑论文老更全。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20708,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜浚复涤砚泉","author":"安如山","text":"束发山间访废泉，茫然衰草与寒烟。\n今朝试向源头问，古脉原从地底穿。\n未必中泠真冠绝，合将窦乳共流传。\n砚池幸启千年閟，谁继钟王笔如椽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20709,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"新夏饮南林","author":"安广居","text":"绿为帘幕翠为屏，半绕回塘半绕亭。\n午梦乍醒山欲紫，高歌有伴眼逾青。\n坐来月色林间出，醉去松风枕上听。\n一度清欢吟不似，却疑佳思倚云停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20710,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"步友人过西林韵","author":"安广居","text":"林皋初过雨，岩翠欲飞来。\n浩落何年客，荒凉此日台。\n小吟都会理，大隐亦须才。\n遗迹方堪挹，轻凫去泽莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20711,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再游金陵寺","author":"柏坚","text":"久忆金陵寺，重来纪胜游。\n花开今夜月，叶落去年秋。\n白社三生梦，青山六代愁。\n醉归应待晚，钟磬隔林邱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20712,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"李丞相读书台","author":"陈勉","text":"读书台下立多时，极目遥天去鸟迟。\n古寺久无丹柰树，一床残梦老僧知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20713,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元日即事","author":"陈希鲁","text":"去岁兹辰彩袖欢，高堂儿女庆团圞。\n钗头彩胜翻春燕，镜里红颜破晓鸾。\n万事伤心兵火炽，五更归梦草堂寒。\n孤城此日堪肠断，愁折梅花带雪看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20714,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题小蓬瀛轩三首 其一","author":"陈公懋","text":"芙蓉窗户赤阑桥，瀛水蓬山路不遥。\n唤取仙人千石酒，海棠花底漫吹箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20715,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题小蓬瀛轩三首 其二","author":"陈公懋","text":"花香历乱瀛洲雪，风色依微阆苑霞。\n地入幽源疑隔世，人临虚阁似乘槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20716,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题小蓬瀛轩三首 其三","author":"陈公懋","text":"涧头绿水流花净，谷口青林送雨凉。\n银鹤舞空秋澹澹，玉笙吹月夜茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20717,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"子胥庙","author":"陈公懋","text":"江上潮声日夜流，鸱夷未散霸图收。\n虎狼敌国英雄恨，麋鹿荒城鬼魅愁。\n西子捧心终作祟，越王尝胆始成谋。\n一人存失兴亡系，楚水吴山尽是秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20718,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"张俊墓","author":"陈公懋","text":"湖山有骨葬重泉，惆怅青衣杳莫旋。\n偏业复成南渡日，中原无复北归年。\n荒凉古寝颓秋雨，零落残碑湿暝烟。\n武穆坟头春满树，时时箫鼓庙门前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20719,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"入闽遣怀","author":"陈周","text":"奉命使南闽，八千里外行。\n敢辞山水恶，须尽葵藿诚。\n嶂云开复合，鸥鸟去还迎。\n欲猛催科政，疮痍尚念氓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20720,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"漫兴","author":"曹恕","text":"钓有清溪采有山，市声浑不到柴关。\n桃花水满鸥常近，松坞云深鹤未还。\n睡起沧浪闻欸乃，行吟曲涧弄潺湲。\n缘知静里乾坤别，不属劳生扰扰间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20721,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"饮泉亭次张水南宫谕韵","author":"曹怀","text":"挂席暂辞鹓鹭直，逢山喜接薜萝筵。\n难邀天下无双士，闲试人间第二泉。\n翠湿宫衣香满地，润分鸿笔雨平川。\n习池为问山公马，归路铜鞮月已偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20722,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"感怀用吴克温太史韵","author":"陈昌","text":"小窗灯火客愁多，未饮先酣怪酒魔。\n五十功名成潦倒，廿年交谊藉渐磨。\n漫论明月清风价，谁和阳春白雪歌。\n几度欲归归未得，一身牢落竟如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20723,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"横山别墅四首","author":"成始终","text":"庄园堪寄老，裘马意何赊。\n颓岸新帮石，疏篱晚映花。\n枇杷香压树，翡翠暖眠沙。\n磷火村舂急，西林是钓家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20724,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"横山写兴","author":"成始终","text":"寒泉漍漍石池深，竹屋松窗称野心。\n三月青山花正好，一帘红日酒初斟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20725,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"无题","author":"成淳","text":"女郎堤畔赤阑桥，十二楼台锁寂寥。\n杨柳不知歌舞散，春条犹学小蛮腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20726,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠罗处士","author":"成淳","text":"旧业稽山下，客游吴市门。\n片言轻季布，直道似刘蕡。\n愁发千丝白，雄心一剑存。\n逢人露肝胆，谁是赵平原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20727,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题寓安堂","author":"成绘","text":"草堂新构瀼之滨，钓月耕云更可人。\n樽酒且谋今日计，山林随分此生身。\n暖风燕子寻常到，晴雪梅花著处春。\n何用别寻蓬岛去，分明大易示敦仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20728,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李参政还吴","author":"丁信","text":"武略雄才出陇西，牙旗玉帐驻梁溪。\n已知马援能匡汉，孰谓樊侯久失齐。\n百物意荣春雨足，三台影落晓天低。\n澹烟芳草沙堤软，一路东风万马嘶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20729,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秦从川重建观鹅亭例赠","author":"邓仪","text":"缅想风流王右军，操觚终日对鹅群。\n千年旧迹几兴废，徒使游人慨夕曛。\n怀古读推川上叟，鼎新重勒壁间文。\n落成更嘱林僧守，不遣山阴道士闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20730,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏绣球花","author":"邓仪","text":"广庭春日正暄妍，一树名花玉槛前。\n百颗毳毬谁织就，几枝琼萼露和圆。\n清华公子夸冰格，雅淡佳人拥雪筵。\n自是明皇沉醉后，梨园遗种至今传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20731,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日过绿萝庵遇王驾部叙话赋","author":"邓仪","text":"解组归来筑旧山，新栽五柳荫云关。\n彤庭载锡褒封诏，白发重跻献纳班。\n仙履浮香盈绮席，官袍纡锦映朱颜。\n辰溪灵秘如勾漏，亶觅砂床炼九还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20732,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题绿萝庵寄希公并致王司马","author":"邓仪","text":"熙春门外鄂城南，古阜丛林锁翠岚。\n坛净不容纤垢入，禅高那许俗人参。\n云归虎洞萝阴合，日照龙潭塔影涵。\n莫怪辞荣王驾部，偏来此地结茅庵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20733,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"龙山古墓行","author":"堵孙正","text":"九龙山下白日荒，九龙山上愁云黄。\n中有古坟几千百，泉为鸣咽鸢为翔。\n龙钟翁仲烟中卧，危崖瘦石苍苔裹。\n一片萧疏插素秋，白日黄狐看山坐。\n我来纵步深林行，苍山合沓间泉声。\n古木千寻不枝叶，土垒三尺堆荒荆。\n残碑藓蚀无名字，无蹄石马流清泪。\n墓门老鬼夜半哭，断桥磷火黄昏炽。\n斜倾老屋唤谁扶，病柏伛偻枝干疏。\n春深草色醉黄鸟，月白松涛咽鹧鸪。\n尘世沧桑不可料，百年驹隙双丸跳。\n不如无植亦无封，骚人无处兴凭吊。\n呜呼赤松子，黄石公，张良辟谷行相从，遥望三山东海东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20734,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"归舟","author":"冯有年","text":"十年已悔沈攸之，此日还家笑太迟。\n云自茫茫波自绿，隔烟人语卷风丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20735,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题莫云楼松月双清图二首 其一","author":"范穆","text":"此中万籁寂无声，月到松间分外明。\n我愿抱琴图画里，与君相对坐三更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20736,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题莫云楼松月双清图二首 其二","author":"范穆","text":"枝头皓魄夜深悬，老翠模糊半湿烟。\n疑是龙潜沧海底，水晶宫里抱珠眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20737,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"京师书事次舒国裳殿撰","author":"傅起岩","text":"京国烟花重，卢沟雪树消。\n宫陈开帟幄，仙仗下箫韶。\n御酒蒲萄绿，官庖芍药调。\n天颜多喜色，报捷在今朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20738,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"出塞奉送邃翁相公专征西夏","author":"傅起岩","text":"薄伐遵周典，长驱出汉关。\n猿啼黑水峡，云暗碧篸山。\n士气雄三辅，天威震百蛮。\n直教平碛石，枭取月氐还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20739,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"书院秋风","author":"傅起岩","text":"宣圣曾经此地游，荒城依旧枕溪头。\n时看草色侵窗几，常见文章射斗牛。\n飒飒枫林寒坠雨，飘飘梧叶夜惊秋。\n晒书今已成陈迹，千古斯文天地侔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20740,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乙卯二月二日从川举吟社邀予同赋","author":"高应奎","text":"碧社梅花散，春泉细细流。\n晴岚浮谷口，好鸟语枝头。\n海迅波无溢，时占麦有秋。\n醉来仍散步，遐想洛中游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20741,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"正月二十五日修敬吟社宴集次韵","author":"高直","text":"池亭面面绕朱栏，每月探泉到碧山。\n乐事还寻诸老共，浮生能得几时闲。\n行厨送馔来花外，啼鸟催诗出树间。\n扶醉登舟天已暮，月明湖上放歌还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20742,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"竹石开社赏牡丹","author":"高直","text":"白首论交保岁寒，人间富贵等闲看。\n斯文结社能追洛，稽古成名岂慕桓。\n青帝欲归犹驻驾，彩云将堕乱遮阑。\n一时乐事应无价，且尽樽前半日欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20743,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"初归","author":"高材","text":"照眼芙蕖薄宦回，欢迎稚子驾船来。\n携亲不敢携鱼鲊，裕后何妨剩砚台。\n漫说风波满平地，且呼朋旧共深杯。\n酒酣拔剑婆娑舞，自笑丹心老未灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20744,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄怀少梅山人","author":"高材","text":"千里逢迎抱素琴，独怜子晋是知音。\n婆娑老子欲长啸，犹愧苏门鸾凤吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20745,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游委羽山次孙邦采韵","author":"高材","text":"糁糁松花树树金，仙人跨鹤剩空林。\n洞门方石还遗迹，鼎里玄丹独悟心。\n笑我未除湖海气，怜君能发凤鸾吟。\n青春况是天崖暮，莫惜花前酒重斟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20746,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过吴江平望","author":"顾起纶","text":"江驿临平望，渔洲带石梁。\n风吹阖庐棹，晚泊会稽乡。\n水国惟闻雁，寒原但植桑。\n前程多歧路，何处是康庄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20747,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清溪渡","author":"顾起纶","text":"清溪雨后碧山明，渡口泠泠绝涧声。\n谷鸟怯啼如汉语，岭梅零落故园情。\n沅陵客过无寒雁，楚国春来几日晴。\n万壑千溪烟瘴里，明朝何事向南征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20748,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"初冬得报敝邑筑成防寇承澜沧周兵宪公枉书相问聊此代简","author":"顾起纶","text":"闻到吴门未解围，千家村郭爨烟微。\n长川白骨沧波冷，满地绿林豺虎肥。\n烽火迢迢中夜梦，云山渺渺几时归。\n故乡消息劳相问，惟有新城闭落晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20749,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日登龙山返舍独酌作","author":"顾起纶","text":"登高陟山阁，佳日授衣初。\n四壑俱摇落，极目情未舒。\n岂有素心侣，俗驾阗郊墟。\n荡舟出泾口，悠然返敝庐。\n采菊对樽酒，蔬食甘无鱼。\n拙养心所适，闭门十年余。\n屏迹澹尘想，吾生惟晏如。\n秋风日瑟瑟，向夕增欷歔。\n阳乌悄方至，寒蛩鸣已疏。\n物候疏经变，岁时良不居。\n栖栖鲁中叟，徒劳问溺沮。\n处世苟无术，再咏耽师书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20750,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过香山丞黄外兄官署","author":"顾起经","text":"香山香作尉，柳郡柳为樊。\n庭下闲罗雀，岩头时挂猿。\n秫田余臈酒，江鲞入宵飧。\n薄禄聊供日，何烦眷故园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20751,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"得京信二首 其一","author":"顾荣章","text":"双义门中立，三株树上花。\n谁言风又雪，应为国忘家。\n清白丹心在，苍黄白日斜。\n举头遥北望，尺五听宣麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20752,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"得京信二首 其二","author":"顾荣章","text":"碌碌真余子，闲闲亦可人。\n苍生谁祷祀，白首竟因循。\n广路喧车马，明时起凤麟。\n老怀何日放，只恐堕淄尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20753,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同伯兄仲兄至惠山观杨叔理所作螭首二首 其一","author":"顾荣章","text":"寻常云起九龙脊，今见螭头喷玉泉。\n从此出山原不浊，澄清风力浩无边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20754,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同伯兄仲兄至惠山观杨叔理所作螭首二首 其二","author":"顾荣章","text":"我思问字子云亭，生怕中郎倒屣迎。\n珠吐龙头出龙腹，中藏万斛向天鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20755,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题复吟社倡和诗卷次韵二首 其一","author":"顾可学","text":"昭代耆英绍洛南，当年肥遁我曾谙。\n蒹葭露白三丘寺，裙屐风流一镜涵。\n龙缝澄清应见底，人间胜赏费幽探。\n痴僧莫漫争门户，谁是长存不老龛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20756,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题复吟社倡和诗卷次韵二首 其二","author":"顾可学","text":"惆怅前贤岂后贤，百年风雅寄心诠。\n倦飞野鹤春云梦，出定残僧夜月禅。\n碧社撚须谁最老，青天抚掌我延缘。\n鉴湖若使容归卧，支杖同寻乐事全。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20757,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"惠山寺与孟无涯话别","author":"顾可学","text":"携尊同古寺，降节憩重阴。\n怅别山云起，遐思江水深。\n明贤廊庙重，多病岁年侵。\n空谷还来日，跫然听足音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20758,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"华阳洞","author":"顾可学","text":"郁郁华阳洞，仙传直至今。\n松含千岁色，云卧半山阴。\n玉柱元关閟，琅函禹穴深。\n鹤鸣初月上，独立阆风岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20759,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题王仲山宝界山庄","author":"顾可适","text":"王子幽栖地，真能谢世缘。\n湖藏深壑里，门掩半山前。\n窈窕寻花径，崎岖错水田。\n林亭留客坐，啜茗且挥弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20760,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月潭赠夏友人","author":"顾可适","text":"明月行中天，寒潭见露白。\n寓物即成形，一过本无迹。\n道人得禅心，即性定真魄。\n鸢鱼浴天光，湛然随所适。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20761,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和彭别驾石屋登锡山观五湖之作","author":"顾可适","text":"锡岭披前迹，丹邱出上方。\n七盘凌绝磴，千仞俯沧浪。\n鸟道浮天碧，鲸波落日黄。\n玄珠遗罔象，白石起群羊。\n陵谷推迁外，蓬瀛飘渺乡。\n云谣惜荒宴，万里泛琼觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20762,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答与新弟题蓉湖庄四首即次其韵 其一","author":"顾可立","text":"皋鹤终非凫雁俦，秋风肯为稻粱留。\n须知不忆鲈鱼烩，自抱清琴卧旧邱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20763,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答与新弟题蓉湖庄四首即次其韵 其二","author":"顾可立","text":"欲采芙蓉不自由，芙蓉湖水绕阶流。\n门前终日无人到，只与青山共一楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20764,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答与新弟题蓉湖庄四首即次其韵 其三","author":"顾可立","text":"龙头龙尾属群公，添我湖山又一峰。\n借问游人都不识，朝霞暮霭若为容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20765,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答与新弟题蓉湖庄四首即次其韵 其四","author":"顾可立","text":"近郊近郭即山林，人境吾庐不解深。\n风自掩门云自锁，飞飞鸥鹭共相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20766,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题十峰兄芙蓉庄四时四绝同洞阳兄作 其一","author":"顾可宗","text":"谁识人间顾古泉，幅巾藜杖亦神仙。\n令兄园柳黄鹂语，春草青青唤阿莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20767,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题十峰兄芙蓉庄四时四绝同洞阳兄作 其二","author":"顾可宗","text":"荷叶荷花骨节香，雨丝微点已生凉。\n疏帘清簟看棋罢，飞起鸬鹚上石梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20768,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题十峰兄芙蓉庄四时四绝同洞阳兄作 其三","author":"顾可宗","text":"古松悬瀑挂清秋，分付人间百道流。\n半壁明霞一藤杖，夕阳为我小勾留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20769,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题十峰兄芙蓉庄四时四绝同洞阳兄作 其四","author":"顾可宗","text":"只应湖面种芙蓉，莫怨开迟霜正浓。\n到得此花摇落后，寒松晚翠欲成龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20770,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]