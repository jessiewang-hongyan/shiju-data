[{"title":"播川驿闲坐","author":"江源","text":"宦情愁独客，光景过三春。\n白发不私我，青山常对人。\n地偏尘鞅少，日落鹊声频。\n人坐能忘此，真成物外身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次前韵","author":"江源","text":"官职何须热，繁华独厌春。\n十年淹俗吏，何日作闲人。\n山水贻情远，松筠入梦频。\n红尘徒扰扰，老却百年身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九龙坡","author":"江源","text":"独客心何壮，九龙坡自高。\n风颠猿抱树，人过雉藏蒿。\n我喜诗怀阔，谁怜仆从劳。\n今朝持节过，题石托吾曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"驿舍偶成六首 其一","author":"江源","text":"驿对青山近，门临绿树重。\n萧条堪昼卧，幽敞足诗供。\n溪静水偏响，天阴蝶也慵。\n我来聊托迹，犹未定行踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"驿舍偶成六首 其二","author":"江源","text":"蜀国山河丽，吾人跋涉遥。\n树深啼杜宁，林暝啸山魈。\n野趣凭诗画，愁肠籍酒浇。\n谁能会吾意，吟眺一相邀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"驿舍偶成六首 其三","author":"江源","text":"半岁无书寄，三春少雁来。\n恨无千里目，看到五仙台。\n鬓发缘愁白，家山籍梦回。\n宦途如此耳，杯酒且徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"驿舍偶成六首 其四","author":"江源","text":"落日照林坰，昏鸦集远汀。\n关河夷险路，风雨短长亭。\n辛苦罹寒暑，光阴换荚蓂。\n粗酬身事了，归看□山青。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"驿舍偶成六首 其五","author":"江源","text":"绕舍山千叠，当庭柏七株。\n四时松坎景，一幅辋川图。\n此地堪留客，高情颇惬吾。\n几多游宦者，不识有诗无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"驿舍偶成六首 其六","author":"江源","text":"日出阴霾伏，天晴野色开。\n地偏无俗客，山远有遗材。\n蜀魄催春苦，奔泉激石哀。\n悠悠付题咏，只恐□诗才。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客思","author":"江源","text":"春尽思家切，年来出使频。\n叨居外台客，长作异乡人。\n紫绶非吾愿，青山是旧邻。\n秋风不归去，老却粤江莼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌江坡 其一","author":"江源","text":"远度千寻岭，空瞻万里家。\n畏途旋鸟道，怪石竖狼牙。\n绿树飞残雨，丹崖映断霞。\n斜阳增感慨，步步是天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌江坡 其二","author":"江源","text":"只道厓门险，乌江复过之。\n鸟飞犹畏坠，马度每惊危。\n慷慨玉尊志，艰难杜老诗。\n备尝此中味，平地好深思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"安稳驿夜坐 其一","author":"江源","text":"小驿鸣宵柝，空堂泣暮虫。\n千山孤月白，四壁一灯红。\n客睡何曾着，宦情应亦慵。\n此时心欲拆，谁道我诗工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"安稳驿夜坐 其二","author":"江源","text":"月色留人坐，灯花结客愁。\n家书长不达，乡泪莫频流。\n鸡犬孤村静，溪山万籁幽。\n此情当此夕，无计可消忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚发綦江","author":"江源","text":"昨来初驻马，今日复登舟。\n新水弥沙岸，斜阳入舵楼。\n酷吟诗作伴，不饮酒为雠。\n明发知何地，江津天际头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"綦江道中","author":"江源","text":"故国长牵梦，衣半梁泥风。\n风烟愁远道，饥渴念深闺。\n涧草长书带，野花开蒺藜。\n物情有如此，短句促吾题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"永川言怀","author":"江源","text":"粤客易生愁，他乡万里游。\n一身癯似鹤，百计拙如鸠。\n驿路蝉鸣夏，山城雨酿秋。\n此怀谁复慰，从事在青州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋雨夜书感","author":"江源","text":"秋色平分夜，寒堂独坐时。\n松州万里客，穗石十年思。\n云重月轮没，风狂烛影攲。\n欲寻天柱赏，谁是赵知微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重阳遇雪言怀","author":"江源","text":"九日黄花节，孤城白雪寒。\n望中山色改，松杪叶声乾。\n衰鬓催秋暮，芳樽负菊餐。\n异乡逢此日，谁与尽清欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿茂州","author":"江源","text":"此地连三宿，长吟对一灯。\n闷怀倾白酒，冻足护青绫。\n煮茗炉添火，濡豪砚结冰。\n思家值长夜，百虑坐相仍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松州寒食四首 其一","author":"江源","text":"寒食千山雨，春风万户烟。\n风光非故土，身世在穷边。\n旧冢孤穿穴，新坟妇哭天。\n无端增客恨，目断粤山阡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松州寒食四首 其二","author":"江源","text":"三月古松州，春风亦似秋。\n天涯游子泪，寒食异乡愁。\n麦饭思先垄，棠梨忆故丘。\n浮名还自累，归计更谁由。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松州寒食四首 其三","author":"江源","text":"寒食又清明，偏伤粤客情。\n悲哀闻寡妇，寥妇住孤城。\n雨洗山松净，风摇陇麦清。\n西邻且沽酒，微饮醉还醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松州寒食四首 其四","author":"江源","text":"十月荒城住，三春故国思。\n不堪寒食雨，偏助旅人悲。\n节至那无酒，囊空赖有诗。\n天涯牢落甚，独坐对痴儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过新堡子","author":"江源","text":"新堡今再过，吐番一何多。\n擂石据危岭，岭弓射隔河。\n将军每示怯，戍卒欲请和。\n封章达明主，征伐挥天戈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游宝陀寺十四韵","author":"江源","text":"昔名宝陀寺，今扁小金山。\n我辈曾三到，东坡不再还。\n楼台张锦绣，松竹列屏藩。\n天地浮孤岛，风烟尽百蛮。\n幻身疑水木，佛相镂沉檀。\n何处逢圆泽，闲云伴懒残。\n粉墙藤蔓合，画壁土花斑。\n去鸟春帆外，孤村夕照间。\n野僧忘俗扮，佳境在人寰。\n素乏三生约，聊偷半日闲。\n谁寻白莲社，我爱绿萝关。\n尽日穷幽讨，何年拟再攀。\n昔贤留景待，而我叹才悭。\n草草题诗去，深惭句未安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52958,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次顾别贺拟归韵四首 其一","author":"江源","text":"归来旧业任从容，数亩湖田一掌宫。\n浮上送人青雀舫，山中饮客碧荷筒。\n家山久念荒蓠菊，猿鹤重来识主翁。\n三径想公行乐处，杖藜徐步夕阳中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52959,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次顾别贺拟归韵四首 其二","author":"江源","text":"清时解组赋来归，泉石膏肓愿不违。\n林下纵情诗与酒，道傍疑我是耶非。\n绿杨门巷回车辄，红蓼汀州认钓矶。\n更问市朝名利者，不知谁息汉阴机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52960,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次顾别贺拟归韵四首 其三","author":"江源","text":"五羊城外泛归舟，知尔从今释百忧。\n千载喜逢明主圣，一官何事壮年休。\n机关眼底应先识，进退胸中已熟筹。\n宦海不堪回首望，风波白尽几人头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52961,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次顾别贺拟归韵四首 其四","author":"江源","text":"公未白头先勇退，一身轻却也便宜。\n独嫌裴度相唐久，敢道渊明去晋迟。\n岭海风烟闲里梦，莆阳山水画中诗。\n科头跣足青松下，叹我归期未有期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52962,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登粤秀山次霍东皋先生韵四首 其一","author":"江源","text":"云岩石磴几千层，策我青骢快一登。\n陆贾功名留太史，赵陀兴废问山僧。\n万年大块眼中尽，百首新诗醉后增。\n薄宦独惭诸俊彦，尘冠何日濯淄渑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52963,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登粤秀山次霍东皋先生韵四首 其二","author":"江源","text":"远步高台最上层，眼中豪气逼陈登。\n百壶遣兴到斜日，一叹忘归值野僧。\n岭海诗名推独步，洛阳纸价为谁增。\n乾坤处处皆行乐，翻叹前贤不渡渑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52964,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登粤秀山次霍东皋先生韵四首 其三","author":"江源","text":"青山崒嵂白云层，诗社诸贤拉我登。\n十载功名真似剧，百年尘俗不如僧。\n尊前浮白兴非浅，閒里看山句倍增。\n此地从来堪适意，叹他冠盖会于渑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52965,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登粤秀山次霍东皋先生韵四首 其四","author":"江源","text":"着屐嬉游第几层，老年曾忆少时登。\n武王霸粤终朝汉，韩愈留衣也爱僧。\n泉石人闲千日醉，江湖身远百忧增。\n兴来三怀欧阳句，酒泼浮醅绿似渑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52966,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月溪为孝宗赐题次邝藻舟韵","author":"江源","text":"月色溪流万派秋，山人坐□足销忧。\n鹿门已共孤高兴，牛渚何须汗漫游。\n波印冰轮同上下，影翻银浪自沉浮。\n此情此景知谁会，我复弦歌着一舟。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52967,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成","author":"江源","text":"春半江南尚北风，宦情离思两相攻。\n鱼沉碧海乡书杳，鸟没青天楚望空。\n万里关河劳跋涉，百年身世信穷通。\n狂来欲饮无多量，三酌茅柴也面红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52968,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜泊横石矶","author":"江源","text":"横石矶头系短蓬，数家村落寂□中。\n江云作暝千山暗，墅火连冈几处红。\n客况膝边怜阿子，乡音灯下语家童。\n愁来谩拥青绫坐，看取囊中宝剑雄。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52969,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜宿黄塘舟中言怀","author":"江源","text":"一宿黄塘值雨天，坐披绒褐爱轻便。\n眼前喜我有诗料，囊里从他无酒钱。\n故国莺花牵客梦，异乡春色恼人眠。\n更将底事消长夜，剪烛闲看抱朴篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52970,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次洪宪副宣之夜坐联句韵四首 其一","author":"江源","text":"画省同官不偶逢，晚衙初散一尊同。\n韭芽入馔宁无肉，鹅掌供餐也胜熊。\n锒烛送阄来隔座，玉壶传漏出深宫。\n丈夫四海从来志，莫笑扶桑谩挂弓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52971,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次洪宪副宣之夜坐联句韵四首 其二","author":"江源","text":"剪烛西堂共倚扛，骚坛今久仰麾幢。\n雨寒苑树争号鹊，风坠檐花起吠尨。\n石鼎新联裁蜡纸，金盘旧酿出银缸。\n宦途未拟归休计，徒梦溪山步小矼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52972,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次洪宪副宣之夜坐联句韵四首 其三","author":"江源","text":"笑口偶开能几逢，坐谈今古过宵钟。\n寒风飒飒声依树，凉月娟娟影在松。\n老我诗篇浑潦草，看君才调岂凡庸。\n青尊共酌无馀沥，安得酒泉重请封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52973,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次洪宪副宣之夜坐联句韵四首 其四","author":"江源","text":"诗囊羞涩酒为媒，十酌催诗亦乐哉。\n五夜秦城闻奏角，十年燕市梦寻梅。\n新知阙下联官署，旧宅山中长雨苔。\n公暇便趍文字饮，我生何必访天台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再次按察司题壁韵","author":"江源","text":"楚水孤舟蜀道车，忽惊枪鸟又春馀。\n十年骨肉长抛别，半纸功名任卷舒。\n几昧变通方学易，耻随流俗幸知书。\n等闲爱杀江门老，竹杖生吟信所如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过大庾岭","author":"江源","text":"大庾经行谩记春，眼看花柳几番新。\n不辞白发犹为客，只恐青山也叹人。\n去马来牛南北路，风餐路宿利名身。\n霎时便是西江境，横浦桥头又问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醴陵道中","author":"江源","text":"行尽萍乡是醴陵，地分吴楚控蛮荆。\n观风到处长留眼，着意看山每问名。\n夹道野花红间白，触人诗思景无情。\n明朝又过三湘路，茅店山桥送客程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客途漫兴寄黄汝章贰守","author":"江源","text":"客里光阴属莫春，乡书朝报两无闻。\n千山寂寂鸠啼雨，万壑阴阴树拂云。\n今日吊湘还有赋，他时谕蜀岂无文。\n长沙馆里逢知己，剪烛论心到夜分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃源分司次沈仲律先生题壁三首 其一","author":"江源","text":"骢马行行盻蜀都，王尊高兴可能无。\n路经全楚吟怀壮，书绝三春望眼枯。\n忤世也知缘性僻，病身端不为诗癯。\n且看一派湘沅水，没尽春江百尺芦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52979,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃源分司次沈仲律先生题壁三首 其二","author":"江源","text":"登山临水兴悠然，安得闲行作地仙。\n千室歌谣堪我采，十年逋税肯民蠲。\n长途几月劳筋骨，重担何人任背肩。\n去去不须檐尹卜，殆将行止付苍天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52980,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃源分司次沈仲律先生题壁三首 其三","author":"江源","text":"十里肩舆又渡江，江晴沙煖燕飞双。\n楚山花果诗堪写，蜀道风波志欲降。\n野哭村舂闻北里，凉天高枕忆南窗。\n桃源馆里停车晚，坦腹藤床足抵杠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过桃源次沈仲律韵","author":"江源","text":"桃洞风烟惨不开，昔人可是避秦来。\n萧条桑竹无鸡犬，荏苒岩扉但草莱。\n江边渔父不重到，世上神仙莫浪猜。\n人事兴亡今又古，夕阳立马重徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿山塘次题壁韵","author":"江源","text":"驿馆寥寥半壁灯，可堪独坐想平生。\n恼人无赖狂风雨，羁我不闲虚利名。\n旧事十年孤枕梦，新愁一种百虫声。\n客怀展转不成寐，又听边楼杀五更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52983,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙阳道中","author":"江源","text":"终日山行入品题，万峰壁立与天齐。\n白云冉冉生衣袂，乱石崚崚割马蹄。\n古渡桥梁春涨没，深林风雨画猿啼。\n此情此景堪图画，何日重过信伏藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52984,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次简宗敬题邮亭壁韵","author":"江源","text":"朝来舴艋渡江沱，翘首辰州路尚赊。\n送雨溪云千骑合，舞风江柳几株斜。\n时时望阙心何壮，处处看山眼欲花。\n沽酒邮亭拼一醉，不知身在楚天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52985,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成","author":"江源","text":"作客天涯长苦辛，子规声里催残春。\n溪花欲放苦遭雨，山雉乍飞长避人。\n才高也被造化忌，诗恶不为吾辈嗔。\n世事须知乃如此，风波丛里先抽身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52986,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过马鞍山","author":"江源","text":"昨过牛栏今马鞍，崚嶒石磴费攀援。\n深林蔽日晴犹湿，古木生风夏亦寒。\n击揖长淮如昨梦，登山全楚是奇观。\n岩前少憩停车看，爱杀松阴五里村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52987,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"栗子岭在沅州四十里","author":"江源","text":"栗岭嵯峨千万寻，肩车乘我快登临。\n眼前数点青山小，足侧千岩碧树深。\n奇怪可能摩诘画，形容须倩谪仙吟。\n啼鹃催得残春去，又听疏林变夏禽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52988,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿晃州驿","author":"江源","text":"风透疏棂雨洒灯，孤怀只合醉腾腾。\n廿年有病长为客，万里无家亦似僧。\n离别未忘儿女恋，疏慵深负宠恩承。\n分明一枕还家梦，苦被邻鸡又唤醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52989,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"相见坡去镇远三十里","author":"江源","text":"上尽高坡复下坡，下扶青竹上扪萝。\n乍看世上坦途少，便觉人间险路多。\n游子可堪行靡靡，鹧鸪休更唤哥哥。\n经过此地名相见，其奈乡关不见何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52990,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望城坡去偏桥十里","author":"江源","text":"望城坡上望偏桥，城郭差参物色饶。\n千涧浮花春水碧，万山推翠晓烟消。\n利名客子来还去，风雨鸡声莫复朝。\n今日登临重回首，乡关迢递雁书遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52991,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿偏桥驿","author":"江源","text":"两宿偏桥刚雨夜，异乡孤烛合魂消。\n阿儿颇解宽离索，婢子犹能慰寂寥。\n边戍此时频击柝，山城何处更吹箫。\n跏趺久坐浑忘睡，安得绕愁酒百瓢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52992,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小腮坡","author":"江源","text":"小腮坡长谁尺寻，我趍全蜀此登临。\n鸟啼白日千岩静，人度青林十里阴。\n泉声汩汩自朝暮，山色年年无古今。\n词客不知曾几过，天教留与助清吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52993,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"跌驴坡","author":"江源","text":"持节侵农度此坡，长林丰草险偏赊。\n老松倚壁盘龙爪，乱石当途列虎牙。\n崖蜜采晴花作食，山禽投暝树为家。\n跌驴客子今何在，瘦马蹉跎我复过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52994,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"厓门坡","author":"江源","text":"小腮过尽度厓门，万木参天白日昏。\n石磴嶙峋春雨滑，碧岩迢递湿云屯。\n当年孝子应回辄，今日孤臣合断魂。\n何事区区不归去，消埃曾未答君恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52995,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿湄潭驿","author":"江源","text":"我来古驿悬灯坐，谁与芳尊对酒歌。\n未许孤臣归岭海，且留双眼看岷峨。\n英雄几曲少年子，富贵一场春梦婆。\n谩想平生弹不寐，茗杯时醒睡中魔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52996,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仁水道中","author":"江源","text":"溪色山光雨后新，也无巇崄也无尘。\n万竿脩竹深藏鸟，几树野花红媚人。\n壮岁功名惭潦倒，故山归计叹因循。\n湄潭过去经仁水，蜀道观风定几旬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52997,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]