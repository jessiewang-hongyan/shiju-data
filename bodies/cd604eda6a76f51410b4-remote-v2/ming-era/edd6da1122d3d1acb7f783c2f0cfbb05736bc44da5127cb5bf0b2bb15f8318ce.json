[{"title":"赠别康孟担","author":"徐熥","text":"一丘栖隐近何仙，不异庞公在汉年。\n名混布衣堪傲世，斋供绣佛可逃禅。\n尊前有客同浮白，身后谁人识太玄。\n此别相思劳梦寐，壶山云树鲤湖烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23513,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈元凯明经北上兼觐省 其一","author":"徐熥","text":"津亭落叶点衣斑，斗酒临岐动别颜。\n江上流澌前岭雪，马头晴树隔淮山。\n征途岁晚鸿声断，上苑春深草色閒。\n此去趋庭驩不浅，可无飞梦到乡关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23514,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈元凯明经北上兼觐省 其二","author":"徐熥","text":"江干分手动悲歌，迢递关山岁杪过。\n独夜怀人魂梦远，中年知己别离多。\n车驱微月寒登陇，马踏残冰晓渡河。\n若遇长安旧相识，为言生计久蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23515,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送叶进卿太史还朝","author":"徐熥","text":"星轺万里上长安，岁晚关河雪欲残。\n剑佩晨趋金阙霁，丝纶夜草玉堂寒。\n千条御柳鸣鞭过，五色宫云拄笏看。\n幸有同心在霄汉，清时无用赋猗兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23516,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈汝大六十初度","author":"徐熥","text":"年少曾窥宝笈文，老来高卧谢尘氛。\n吟边野兴随青草，世外馀生付白云。\n大药已传龙虎秘，閒身应混鹿麋群。\n桑弧正及黄花节，一度花开一寿君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23517,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人之边 其一","author":"徐熥","text":"万里横戈赋远征，天涯去住不胜情。\n隔河猎火秋调马，古戍狼烟夜列营。\n沙碛春深无草绿，边城乱后少人行。\n客中知有还乡梦，莫听孤笳月下声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23518,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人之边 其二","author":"徐熥","text":"漠漠黄尘匹马孤，马头今去向飞狐。\n望乡台畔无青草，策勒城头有白乌。\n满路寒霜朝倚剑，一天明月夜吹芦。\n单于莫近阴山猎，南国书生正弃繻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23519,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题和李义山 其一","author":"徐熥","text":"香烬金猊烛散风，月沉西岭水流东。\n云迷洛浦人何处，柳暗章台路不通。\n远岫似凝眉上翠，守宫犹染臂间红。\n凄凉往事休重省，十载游踪叹转蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23520,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题和李义山 其二","author":"徐熥","text":"为雨为云无定踪，半衾幽恨数声钟。\n弦于离绪同时断，墨与啼痕一样浓。\n无复芳心含豆蔻，空将薄命委芙蓉。\n西邻只在高楼畔，似隔天台路几重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23521,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟刘晨阮肇入天台效曹唐","author":"徐熥","text":"历尽千山与万山，白云飞处见松关。\n路从碧涧通仙窦，梦绝红尘出世间。\n花落洞中春寂寂，日斜溪上水潺潺。\n哀呼四壁多猿鸟，迷却来踪不可还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23522,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘阮洞中遇仙子","author":"徐熥","text":"路入天台境寂寥，空中吹送白云谣。\n桃花片片流丹壑，瑶草青青映翠翘。\n五色烟霞迷鹤梦，数声环佩隔虹桥。\n人生莫道仙凡别，携手春风是此宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23523,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仙子送刘阮出洞","author":"徐熥","text":"鸡犬声中羽袖分，桃花折赠寄殷勤。\n愁来玉液谁同饮，别后瑶笙忍独闻。\n踪迹但随溪上水，仙凡只隔洞前云。\n从今万劫仍千劫，惆怅无缘再遇君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23524,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仙子洞中忆刘郎","author":"徐熥","text":"佳期谁信此生休，梦断巫山几度秋。\n瑶草似怜人远去，桃花仍逐水东流。\n红尘夜月空留枕，紫府春风独倚楼。\n只恐重来迷处所，洞门深锁碧苔幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23525,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘阮再至天台不复见仙子","author":"徐熥","text":"重到仙源路转深，旧游踪迹已销沉。\n千年山水自朝暮，四壁烟霞成古今。\n不见胡麻流别涧，独闻幽鸟噪空林。\n早知一别无寻处，应悔当时出洞心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23526,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"萼绿华将归九疑留别许真人","author":"徐熥","text":"缥缈云軿驾彩霓，半天遥听玉麟嘶。\n身归紫府难为别，目断红尘不住啼。\n新启离筵铺凤髓，重封真诰印龙泥。\n黄金条脱空留赠，九点青山望已迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23527,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉女杜兰香下嫁张硕","author":"徐熥","text":"黄金钗股紫金钿，忽驾鸾车降碧烟。\n百尺虹桥天上路，万条花烛世间缘。\n云璈曲妙调龙琯，露液杯浓启凤筵。\n却笑裴郎仙分浅，一双玉杵种多年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23528,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张硕重寄杜兰香","author":"徐熥","text":"渺渺灵踪去不还，空劳珍重碧云鬟。\n人间无路通瑶阙，梦里何因见玉颜。\n兰露半销香冉冉，花风初度佩珊珊。\n欲将一札传青鸟，知住蓬莱第几山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23529,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"织女寄牛郎","author":"徐熥","text":"临流几度待金飙，天帝无情恨鹊桥。\n玉宇微茫空隔水，银河清浅不通潮。\n心随凤驾思灵匹，泪逐龙梭上锦绡。\n难得欢娱容易别，年年肠断可怜宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23530,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲午迎春","author":"徐熥","text":"家家箫鼓响何频，海国惊看物候新。\n自有东风吹綵胜，不愁微雨洒红尘。\n土牛未送山中腊，宝马先行岁里春。\n三十三龄容易过，蹉跎又是隔年人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23531,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁暮感怀","author":"徐熥","text":"年来踪迹叹蹉跎，独向衡门恋薜萝。\n前路虚名青鬓少，先人遗业白云多。\n匆匆短晷愁中尽，冉冉浮生梦里过。\n时事凄凉应莫问，空山相对意如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23532,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲午元日","author":"徐熥","text":"平明曙色乱春烟，独对东风意惘然。\n蓂叶乍开尧砌上，椒花先献佛灯前。\n忽闻爆竹迎新岁，愧饮屠苏后少年。\n莫道清霜随腊尽，只愁飞入鬓毛边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23533,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠邓道鸣都阃","author":"徐熥","text":"千骑如云瘴海间，一天明月照刀环。\n营门昼静笙歌沸，部曲秋高剑戟閒。\n乐奏金铙新破敌，名标铜柱旧平蛮。\n玉关他日功成后，犹见将军鬓未斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23534,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林贞发之汉阳兼寄陈仲敬明府","author":"徐熥","text":"江干折柳正春初，闽楚相看万里馀。\n满路愁云过七泽，一天明月吊三闾。\n帆飞汉水莺声早，书到衡阳雁影疏。\n为语神明河上宰，故人生计已樵渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23535,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王相如文学千里来访诗以赠别","author":"徐熥","text":"少年名姓满词场，千里相寻问草堂。\n博物每披周石鼓，摛文能赋鲁灵光。\n九龙夜吼门前水，疋马秋归岭外霜。\n收得秘书盈万卷，王家事业本青箱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23536,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送欧阳霖仲归乡","author":"徐熥","text":"梁狱书成泪未乾，天涯流落畏途难。\n杼投已信曾参语，袍赠谁怜范叔寒。\n逆旅相逢愁咄咄，故乡归去路漫漫。\n布衣正好弹长铗，何必逢人变鹖冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23537,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周公子还金溪","author":"徐熥","text":"彭蠡西归去棹长，东风江上送周郎。\n数声忍顾歌骊曲，三月惟赍养鹤粮。\n寄远柳应攀驿路，思亲花每梦河阳。\n家山况与丰城近，别后遥看剑气光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23538,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐半刺之官淮阳","author":"徐熥","text":"东风吹送片帆轻，江北江南万里程。\n隋柳似迎行客过，淮流难比使君清。\n尚怀太姥看山梦，新就盐官煮海名。\n盘里水晶堪饷客，几时重见故人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23539,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲午端阳即事","author":"徐熥","text":"满市贫民尽噪呼，谁家尊酒汎菖蒲。\n汉廷久已饥方朔，楚泽何人吊左徒。\n残喘厌看长命缕，空囊安用辟兵符。\n愁来试上孤城望，几处炊烟几处无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23540,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将发芋江别惟起惟扬二弟","author":"徐熥","text":"霜落乌啼半上潮，江头那忍解兰桡。\n已悲去路关山远，况复归期岁月遥。\n衰鬓依人愁冉冉，荒年为客橐萧萧。\n他时两地同相忆，记得离筵是此宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23541,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮胡元瑞萝月轩","author":"徐熥","text":"停棹来寻瀔水阳，半窗萝月坐飞觞。\n阶前鹤迹留苔浅，秋后蝉声出树凉。\n客路蒹葭寒细雨，他乡砧杵度微霜。\n布帆东下江流急，满目西风别恨长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23542,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄别幼孺次来韵","author":"徐熥","text":"故国青山又远违，怀人空有梦魂飞。\n猿当暮雨声偏惨，雁到秋风影尚稀。\n一夜思乡华发变，中年为客壮心微。\n竹林此日无多侣，莫向山中厌布衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23543,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠屠长卿仪部 其一","author":"徐熥","text":"姓名曾注玉皇家，吸尽遥天五色霞。\n一点真阳封土釜，六时神水转河车。\n黄冠长日居蓬岛，紫气中宵隔若耶。\n莫道相逢期太晚，于今佳谶有龙沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23544,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠屠长卿仪部 其二","author":"徐熥","text":"一区长傍鉴湖边，坐对三花九品莲。\n家散黄金惟塑佛，诗成白雪半游仙。\n栖禅净室云堪卧，驭气遥空电可鞭。\n他日从君无别语，祗应同證大因缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23545,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题公朗宝函楼","author":"徐熥","text":"危楼百尺梵王居，禅诵声高晚磬初。\n一榻秋云松火冷，半窗残月竹阴疏。\n鹫峰花雨诸天外，猊座金身六代馀。\n多少尘劳都遣尽，独留诗癖未全除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23546,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀瀚公","author":"徐熥","text":"逆旅裁书问道安，故园明月几回看。\n身閒对客题诗易，岁俭逢人乞米难。\n风动空山孤锡响，霜深禅榻衲衣寒。\n知师不作天涯梦，长夜忘眠坐戒坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23547,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松陵舟中","author":"徐熥","text":"西风吹袂失炎蒸，落日波光似镜澄。\n囊里钱馀缘戒酒，途中舟缓为寻僧。\n孤村近浦船为市，古寺临江塔有灯。\n一带人烟何处所，榜歌遥指是松陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23548,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴阊吊高季迪太史","author":"徐熥","text":"吴门灯火正黄昏，读罢遗编湿泪痕。\n五字几人传故业，一杯何处吊吟魂。\n秋风茂苑留荒草，暮雨寒山泣断猿。\n欲向居人问封土，衣冠未必葬家园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23549,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"旅次石头岸","author":"徐熥","text":"石头城下水微茫，回首乡关驿路长。\n瓜步烟波连断霭，秦淮云树隔斜阳。\n秋高落木迷村舍，夜静寒潮到女墙。\n客里愁心已如此，一闻南雁更凄凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23550,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵怀古","author":"徐熥","text":"白门京阙旧山川，朱雀乌衣夕照边。\n百代荒陵崩夜雨，六朝遗殿锁秋烟。\n胭脂岁久销宫井，苔藓春深绣御筵。\n往事凄凉无限泪，伤心最是建文年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23551,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客中感秋呈王德载卢子明柳陈甫诸公","author":"徐熥","text":"他乡为客长离忧，一夜新寒感敝裘。\n对酒正当桑落后，思家偏向雁来秋。\n白门月冷砧初断，淮水霜深叶自流。\n不是天涯有知己，萍踪那得久淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23552,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张孺愿还四明为儿娶妇","author":"徐熥","text":"离情黯淡白门西，何处云山是会稽。\n作客暂辞桃叶渡，思乡多梦若耶溪。\n寒芦夜雨鸿初断，衰柳残阳马倦嘶。\n待汝尚平婚嫁毕，五湖明月共招携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23553,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送胡彭举之衡阳","author":"徐熥","text":"愁折衰杨过御堤，吴门遥望楚云低。\n高峰见月秋回雁，野店逢霜晓听鸡。\n九派江流湓浦外，一天帆影洞庭西。\n知君作客年来惯，不畏猿声日夜啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23554,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"葛震父招游雨花台同张康侯姚佩卿诸子","author":"徐熥","text":"高台千尺俯烟霞，却望当年旧帝家。\n百雉都城仍踞虎，六朝宫树半栖鸦。\n云边淮水连天远，林际钟山带郭斜。\n独有空门不销歇，至今犹落讲坛花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23555,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陆纂父山人还洞庭别业","author":"徐熥","text":"他乡相见又离群，满目西风落叶闻。\n二水空洲孤棹远，三吴秋色一江分。\n白衣出郭金陵雨，绿酒看山震泽云。\n从此游踪各南北，月明无处不思君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23556,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同吴翁晋姚叔乂诸子集陈公衡衙斋","author":"徐熥","text":"南朝仙吏擅风流，四海论交半敝裘。\n粉署鸟啼花外雨，白门鸦散柳边秋。\n故宫云气销长乐，近郭湖光起莫愁。\n马踏夜分归路晚，疏钟遥动景阳楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23557,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠李茂承太学","author":"徐熥","text":"云间才子气翩翩，偶尔相逢入洛年。\n半夜孤帆三泖月，一秋双屐六朝烟。\n匣中紫气频看剑，笔底青山不卖钱。\n同是天涯流落客，何妨长醉酒垆边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23558,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"隔帘美人","author":"徐熥","text":"环佩声闻见不真，多情绰约往来身。\n只缘竹纬垂千缕，似对菱花隔一尘。\n绣带暗飘纹外影，秋波潜送隙中春。\n重重锦浪生罗袜，彷佛云间遇洛神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23559,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同梅季豹林叔度碧峰寺访如愚上人","author":"徐熥","text":"行尽空林到沃洲，满林黄叶上方秋。\n松遮古殿半山翠，竹隐空房三径幽。\n宝盖影飘依佛座，昙花香散拂经楼。\n年来绮语方除障，不敢题诗赠惠休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23560,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同闵寿卿王献子二山人集王德载都护溪阁同得萧字","author":"徐熥","text":"尊酒凭虚破寂寥，秣陵云物晚萧萧。\n窗开远岫常邀月，阁枕寒溪共听潮。\n万里风烟天外尽，满林秋色雁边遥。\n主人久傍墙东隐，不向西山更射雕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23561,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"马姬馆赠梅子马","author":"徐熥","text":"宝剑逢人脱赠轻，平生肝胆片言倾。\n千秋白社工文客，半世青楼薄倖名。\n枕上杨花今日泪，渡头桃叶旧时情。\n囊中不管黄金尽，犹买娇歌夜夜声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23562,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿雪浪禅师九月九日五十初度","author":"徐熥","text":"祗林遥见白毫光，发祝多年尚未苍。\n菩萨应期生下土，圣人此日出西方。\n阶前记腊松长在，座上拈花菊正香。\n一自九龙仍吐水，从今浴佛说重阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23563,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵故宫","author":"徐熥","text":"先朝遗殿闭尘埃，零落空劳过客哀。\n五夜铜壶乾罢滴，六宫金锁涩难开。\n翠华去后全无影，罗绮焚馀尚有灰。\n弓剑尽埋烟雨冷，椒房一半上苍苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23564,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重阳后顾世卿招游清凉寺翠微亭","author":"徐熥","text":"虚亭高与翠微连，尚有黄花照法筵。\n下界梵音中夜磬，半空帆影隔江船。\n马行十里松阴月，人藉孤峰草色烟。\n我本倦游多感慨，老僧休说六朝年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23565,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈彦庄侍御招游清凉寺","author":"徐熥","text":"同向空门结白莲，琳宫遥隐帝城边。\n闭关僧是他方衲，题壁人多异代贤。\n江北江南千里月，山前山后万家烟。\n座间自有霜威肃，避暑何须说往年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23566,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送何伯达太学还鲤湖","author":"徐熥","text":"岁晚扁舟发水濆，劳劳亭下叹离群。\n一行雁影斜阳见，几处砧声半夜闻。\n作客厌看吴苑月，思亲翻望秣陵云。\n他时九漈劳魂梦，跨鲤仙人正是君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23567,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"燕子矶","author":"徐熥","text":"芦荻萧萧远水平，沉江铁锁尚留名。\n半空鹳鹤飞来影，千载鼋鼍化去精。\n石占中流危截浪，云侵残垒暝吞城。\n山僧似惜游人别，犹送疏林磬一声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23568,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观浦口珠泉","author":"徐熥","text":"一泓如练净无尘，幻出明珠颗颗新。\n疑是鲛宫逢贾客，难于金谷换佳人。\n夜光不说昆明水，照乘何须合浦滨。\n生灭由来归泡沫，欲将灵迹问波神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23569,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访梅禹金秦淮客舍","author":"徐熥","text":"舟过长干问客星，风流不用叹飘零。\n一秋桃叶居淮水，十月梅花梦敬亭。\n游遍南朝多宝寺，翻残西竺几函经。\n赠君欲折藏鸦柳，满目隋堤何处青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23570,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢司理招游道场山","author":"徐熥","text":"碧树香台一径纡，满林幽鸟避前驱。\n重重翠巘看苍弁，渺渺层波见太湖。\n钟送馀声过下界，云留残影挂浮屠。\n画船载月归来晚，十里烟光澹欲无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23571,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒孙山人太初墓兼怀郑吏部继之","author":"徐熥","text":"道场山下见荒阡，欲吊吟魂一怆然。\n寂寂梨花寒食雨，萧萧蒿草夕阳烟。\n空林夜静闻猿啸，断碣年深借鹿眠。\n若把梅亭比苕水，千秋黄土总堪怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23572,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺情","author":"徐熥","text":"深闺长日望刀环，锦被香销绣幕閒。\n岂有梦魂通暮峡，更无眉黛画春山。\n情牵夜月孤蛩泣，目断秋风一雁还。\n不是狂夫恩意浅，由来薄命怨朱颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23573,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同强善长包蒙吉计仲嘉徐子晋斯学上人集宝林寺镜公房时蒙吉来自东瓯仲嘉归自燕赵","author":"徐熥","text":"吴市飘零感岁华，偶携瓢笠到僧家。\n孤云静结人天果，朔气寒生佛座花。\n作客畏闻燕地雪，逢君先问赤城霞。\n山中欲别各留偈，送过虎溪将日斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23574,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为王百谷悼亡","author":"徐熥","text":"不顾房帷十载恩，窃将灵药月中奔。\n楚台有枕难通梦，汉殿无香可返魂。\n夜静鸳鸯虚锦帐，昼长鹦鹉唤璚轩。\n小星三五沉何处，垂老青衫湿泪痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23575,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]