[{"title":"许少卿伯诚席上遇马司业仲房一首","author":"黄省曾","text":"天路花初雨，皇居燕始翰。\n俄于一席上，得有二龙看。\n故对承筐恋，新交伐木欢。\n清言相映发，不厌吐如兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38259,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同冯明府全邑博诸君宴虞山南轩一首","author":"黄省曾","text":"冠岭崇嘉胜，南轩始共过。\n驾舆凌紫汉，张酒挹明河。\n地即神仙境，人逢文学科。\n似怜歌舞夕，澄月借金波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38260,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宴俞光禄宅飨自毙象脯闻侍朝仪五十馀载矣二首 其一","author":"黄省曾","text":"南越当时献，充庭五十年。\n天房叨上豢，龙陛杂多贤。\n徒毙空瑶象，为珍秪御筵。\n如何髦约美，传向草茅边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38261,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宴俞光禄宅飨自毙象脯闻侍朝仪五十馀载矣二首 其二","author":"黄省曾","text":"作献殊云贵，居朝似所安。\n□藏那可得，丘徙任相看。\n致远能千里，残生当一餐。\n偶分南海味，为尔寄清叹。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38262,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同孟中丞集边司徒官舍一首","author":"黄省曾","text":"九列华堂集，萝衣愧简招。\n霞将仙液泻，风借玉河飘。\n分夺南金重，欢移北斗杓。\n谁云鹏鹖异，今日共逍遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38263,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同谢少南徐霖宴魏国东园四首 其一","author":"黄省曾","text":"竹把瑶樽惬，山登紫屐宜。\n玉浆催凤俎，红烛继龙曦。\n月是金堂照，风为锦幕吹。\n胜情犹未已，移席向芳池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38264,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同谢少南徐霖宴魏国东园四首 其二","author":"黄省曾","text":"九日王园燕，金风锦席飘。\n竹新三叠翠，花映百重娇。\n丝柳牵游兴，鸾弦动赏谣。\n澄空生片月，为我作芳宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38265,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同谢少南徐霖宴魏国东园四首 其三","author":"黄省曾","text":"飞盖成幽烛，骈筵作旷寻。\n薜萝堪解带，泉石合开琴。\n林曲花如隐，池清鸟似临。\n宛辞陵子贵，高有灌园心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38266,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同谢少南徐霖宴魏国东园四首 其四","author":"黄省曾","text":"星沼天为泽，仙陬帝与开。\n云皆怡客吐，雁乃侑樽来。\n山拟蓬壶筑，花如洛下栽。\n不须妆绮绣，春色自常催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38267,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宴友人园一首","author":"黄省曾","text":"凉月始临仲，园亭启宴杯。\n客逢皆故好，花对即新开。\n江鲤为林馔，朱霞趁客怀。\n秋风彫柳色，何得管中催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38268,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大司马乔公觞余清凉寺一首","author":"黄省曾","text":"虎士行芳馔，虚亭倒玉壶。\n殷勤司马意，登览纵潜夫。\n二月清云落，三山白日孤。\n遥看春草色，醉杀莫愁湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38269,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"超果寺访张进士承宪宴集一首","author":"黄省曾","text":"谓子高衿者，经时栖鹫林。\n旧能谈德观，兹复撰文心。\n眺处青山郭，閒来绿水琴。\n何期芳醑载，江国共游临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38270,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同钟贰守赵别驾樊郡推宴何别驾官衙得阳字一首","author":"黄省曾","text":"淑候启黄堂，嘉筵命绿觞。\n人瞻五马贵，河润四星光。\n玉树攀才妙，兰风挹政芳。\n幸同吴国草，于此沐春阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38271,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈园三月之宴二首 其一","author":"黄省曾","text":"翠苑韶华丽，绡衣物候和。\n春花催夏放，夕鸟换朝歌。\n杯绿承芳草，筵红接绛河。\n平生掩穷巷，情为辟疆多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38272,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈园三月之宴二首 其二","author":"黄省曾","text":"翻燕红帘幕，流霞玉酒壶。\n坐莺垂密柳，傒凤列高梧。\n弱草如轻带，名花学子都。\n当杯宁惜醉，龙剑尔须扶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38273,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山阴郡守南子大吉招饮大观堂一首","author":"黄省曾","text":"岩半标公署，冰心掩阁寒。\n为歌青嶂里，听讼白云端。\n仙吏真成隐，山城易集鸾。\n邀宾化行日，清把玉琴弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38274,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瓜州乡思一首","author":"黄省曾","text":"平生未远别，远别倍言愁。\n北路同春入，南心并水□。\n寓书瓜步马，积梦广陵舟。\n愿借东飞翼，归传少妇栖。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38275,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登金刚宝座一首","author":"黄省曾","text":"金座参差表，言开中印图。\n五区空界出，千劫帝轮扶。\n籁入层铃度，云含众象敷。\n凤城归路晚，偏系客心孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38276,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山阴与陈太守季昭同泛镜湖览秦望少微诸山月上归一首","author":"黄省曾","text":"海日生秦望，山云涌少微。\n南湖浮画舫，初著暮春衣。\n草色天际合，桃花镜里飞。\n澄波三百里，新月共沿洄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38277,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱阳馆步至陶隐居墓傍二首 其一","author":"黄省曾","text":"昔日朱阳馆，陶公悦白云。\n结庐追选客，标舍近茅君。\n久向玄津去，空馀告逝文。\n客来春欲暮，瑶草閟仙坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38278,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱阳馆步至陶隐居墓傍二首 其二","author":"黄省曾","text":"福地长谣罢，阳春窈窕游。\n花深朱阳馆，柏古玉晨楼。\n石颂今犹在，龙芝何处求。\n白云持不可，岭上自悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38279,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登茅山同仲兄作一首","author":"黄省曾","text":"山椒丽飞殿，遥望际天涯。\n不见龙镳客，空看洞口花。\n衰颜怜日月，大劫小河沙。\n日暮征车歇，衔杯羽士家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38280,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢公墩一首","author":"黄省曾","text":"往时王与谢，命驾冶城游。\n千载闻遐想，二公今古丘。\n同心有李白，异代仰风流。\n感激生青草，予来空复愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38281,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初泛五湖二首 其一","author":"黄省曾","text":"大阙帆轻挂，东山日浩临。\n蛟龙蟠地稳，波浪际天深。\n少作杨泉赋，遐生范蠡心。\n相风无不可，寒色对孤吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38282,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初泛五湖二首 其二","author":"黄省曾","text":"得性真良计，宣城有故谣。\n选来多胜迹，行处有灵潮。\n触雾偏含席，穿云渐隐舠。\n霜前秋塞雁，骈翼向南飘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38283,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄山一首","author":"黄省曾","text":"洞壑容丘宅，灵源曹阮家。\n辟岩皆玉府，流水亦丹砂。\n五色云方吐，千年树乃花。\n仙踪何处觅，徒挹紫城霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38284,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大石山寺一首","author":"黄省曾","text":"学凤飞峦峻，如龙偃岫长。\n午崖犹未日，秋洞不凋芳。\n芝磴霞沾屐，林楼翠惹觞。\n旷寥僧坐久，摘果供焚香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38285,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月八日泛石湖一首","author":"黄省曾","text":"山气带烟浮，湖波纳雨流。\n树梭莺织晓，天字雁书秋。\n礼石参灵象，停矶并女牛。\n弥空萦柳色，随处接芳游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38286,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"禅兴寺一首","author":"黄省曾","text":"妙域千年搆，金堂七代华。\n香云流化国，慈雨洒禅家。\n翠拥天孙树，红开帝女花。\n宝琴清觉思，寥寂语河沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38287,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"禅兴寺梁公主墓一首","author":"黄省曾","text":"梁日乘龙第，当时舞鹤归。\n沁园开施果，明月掩容辉。\n玉匣藏金苑，秋云护夕扉。\n吹箫人不见，犹忆凤凰飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38288,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过吉草庵一首","author":"黄省曾","text":"池刹居偏野，云霞日异开。\n松声清座梵，竹气洒林苔。\n白鹤佺期觅，青梯灵运来。\n偶看香阁咏，因爱皎然才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38289,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春泛镜湖一首","author":"黄省曾","text":"佳丽摇新望，云空鸟不稀。\n树春花欲语，山暮日知归。\n小棹浮群象，澄波映客衣。\n暝馀还镜里，天月借清辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38290,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予游牛首山大司马乔公馈以法酒兼命武士导之夜宿僧舍二首 其一","author":"黄省曾","text":"雨径探双洞，云房酌两泉。\n牛头吟古寺，兜率醉高天。\n夜榻流僧梵，春岩受客眠。\n应知西省客，怀我紫霞边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38291,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予游牛首山大司马乔公馈以法酒兼命武士导之夜宿僧舍二首 其二","author":"黄省曾","text":"忆昔高皇帝，春山转翠旗。\n龙颜开远眺，天笔赏新诗。\n八代无停晷，羁人有独思。\n不眠牛首夜，偏动鼎湖悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38292,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"报恩寺一首","author":"黄省曾","text":"帝祉开金刹，皇郊启象林。\n凤云邀客驻，龙日想天临。\n宝树交加络，华廊窈窕深。\n浮图辉宝炬，夜夜耿河心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38293,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金坛令任佃约游顾龙山雪阻不果一首","author":"黄省曾","text":"顾龙山寺古，崒嵂倚春塘。\n翠辇经游远，扶车照烛长。\n松云留法曲，萝薜挂仙床。\n怅望金坛雪，攀登意不忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38294,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨相国送酒金山寺泛舟大江登妙高台五云朝阳二阁吞海亭饮中冷泉二首 其一","author":"黄省曾","text":"绝岛浮莲宇，明江涌化城。\n龙回银浪转，鳌戴碧山行。\n南北舟樯带，东西日月萦。\n中泠流玉髓，宛似汲蓬瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38295,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨相国送酒金山寺泛舟大江登妙高台五云朝阳二阁吞海亭饮中冷泉二首 其二","author":"黄省曾","text":"一片回波石，何年梵刹开。\n江流万古去，涛带六州来。\n释子呼鼋起，山人指雁回。\n洪澜须不作，荀羡在高台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38296,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兰亭一首","author":"黄省曾","text":"人世有生灭，江山无古今。\n千岩犹秀色，五月始登临。\n自到流觞处，因生风烛心。\n吾游亦陈迹，回首动悲吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38297,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丹徒留侯庙一首","author":"黄省曾","text":"留侯有遗庙，幽枕碧江浔。\n偶此白云谒，犹钦黄石心。\n椒浆秋一奠，松子我将寻。\n明月下孤棹，苍苍杨柳阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38298,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泊舟支硎经灵岩游赤山夜珠坞二首 其一","author":"黄省曾","text":"林麓转秋清，花村间岭成。\n遥寻赤山奥，言就白云生。\n霞塔留吴殿，烟墟辨越城。\n人间不贵宝，何用夜珠名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38299,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泊舟支硎经灵岩游赤山夜珠坞二首 其二","author":"黄省曾","text":"室以支公建，山犹皇妹名。\n红云升白马，绿草掩珠缨。\n奏酒开今眺，游轺动古情。\n石门栖玉馆，弥使客怀萦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38300,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水宿溪上一首","author":"黄省曾","text":"移舸含山宿，推篷向月停。\n茝兰杯夕气，蟋蟀枕秋声。\n野咏神襟王，萝衾梦寐清。\n忽闻歌子夜，江上荡游情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38301,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"探桂岭一首","author":"黄省曾","text":"言与寻芳者，来攀桂岭阳。\n九山归烛丽，万树并杯香。\n远袭乘风细，高零挟露凉。\n鲜葩临吐月，如竞摘姬妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38302,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六月廿四日荷花荡一首","author":"黄省曾","text":"竞楫都人集，喧游国事传。\n探芳怜胜日，携客讨湖天。\n玉笛催新柳，红妆夺始莲。\n开襟欢未极，沽酒不论钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38303,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"理棹虞川一首","author":"黄省曾","text":"林候转秋光，云阴喜乍凉。\n遥持故人意，还觅旧游乡。\n秀野弥山绿，流川接海长。\n预欢遵躅胜，不觉酩清觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38304,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登达观亭一首","author":"黄省曾","text":"绝嶂危亭搆，言登四烛开。\n村畴千拱带，邑水七盘回。\n云气将山至，秋光挈海来。\n况看壶峤迩，应可问银台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38305,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明日望西苑一首","author":"黄省曾","text":"紫殿含云列，黄居吐日攒。\n人间杨柳色，天上得先看。\n藻鲤腾文浪，华莺度玉栏。\n万年瞻郁翠，春象映游观。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38306,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登清凉山一首","author":"黄省曾","text":"古刹石城里，逶迤丹磴攀。\n殿悬秋霭树，江吐夕阳山。\n法食供游馔，林杯悦旅颜。\n无劳支遁马，碧草步人还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38307,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"琼花观一首","author":"黄省曾","text":"宛转云郊步，探芳问福庭。\n凤台非旧树，龙箧閟残经。\n安得丹如日，虚惭鬓巳星。\n紫烟乘鹤者，为我接霞軿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38308,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过沛一首","author":"黄省曾","text":"偪阳千古国，泗上起飞龙。\n帝业黄沙在，山城紫气空。\n旧亭迷草绿，新县接霞红。\n馀迹犹堪访，歌台标大风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38309,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留城怀古一首","author":"黄省曾","text":"帝师怀宝剑，此地遇高皇。\n绿草封侯土，华芝辟谷方。\n算成秦楚灭，谋罢鬼神藏。\n尚有留城月，千年属子房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38310,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登来青轩一首","author":"黄省曾","text":"峻阁标灵嶂，盘回翠岫连。\n佛香云和袅，天烛斗齐然。\n万色虽看界，诸空悉露禅。\n道林调白马，于此业青莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38311,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与邵莫二子游七真诸洞一首","author":"黄省曾","text":"驻马翠微中，山萝漾夕风。\n言探七子躅，因蹑五城宫。\n洞草徒看绿，丹炉巳罢红。\n飙轮不可见，吾欲母禽通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38312,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游驸马山庄一首","author":"黄省曾","text":"贵主辟灵扉，黄村倚翠微。\n星榆当子牖，天柳拂孙矶。\n仙犬迎花吠，金樽款客挥。\n碧台明月里，常度凤笙飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38313,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"境山寺一首","author":"黄省曾","text":"石磴层悬刹，花梯客驻攀。\n云侵萧子国，天入楚王山。\n马法藏金殿，龙灵护绿关。\n林台销赤日，旅眺一怡颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38314,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿尧峰山寺一首","author":"黄省曾","text":"华年来宝地，中岁扣香关。\n听鸟惟常集，栖云不待还。\n松宵风洒榻，湖晓气弥山。\n况有林间侣，霞镳喜共攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38315,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灵岩山寺一首","author":"黄省曾","text":"古峤空烟暮，前宫蔓草秋。\n山看吴国尽，湖睇楚门周。\n金沙销佛劫，玉殿罢王游。\n讵识登临里，犹深麋鹿愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38316,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西施洞一首","author":"黄省曾","text":"西子芳游处，山椒尚有名。\n花留看镜色，云断舞衣情。\n河在无星度，台空罢雨行。\n总言誇绝代，终是怆倾城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38317,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采香径一首","author":"黄省曾","text":"缭绕湖山上，君王昔艺香。\n年年二三月，女伴掇芬芳。\n茝佩含风远，兰心逐水长。\n千秋馀绮径，寥阒带川阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38318,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"姑苏台一首","author":"黄省曾","text":"白壁妆游岭，黄金饰舞台。\n春宫千妓歇，秋泽五湖开。\n云犹诘屈搆，花学绮罗隈。\n览古情何极，烟桡怅暝回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38319,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉泉寺一首","author":"黄省曾","text":"散趾遵萝径，张筵俯玉津。\n来凭仙石濑，暂洗客车尘。\n灵鸟如听法，文鱼不避人。\n吾侪行褉所，奚减洛川滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38320,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玛瑙山居一首","author":"黄省曾","text":"崖半标精舍，春中止佛扉。\n楼交灵霭气，竹洒夕阳辉。\n丹井今言绿，仙凫昔道飞。\n游衿随挈榼，于此澹忘归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38321,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北高峰一首","author":"黄省曾","text":"冉冉投灵刹，盘盘陟峻云。\n春山攒地象，朝日观天文。\n金策排人境，玄怀涤世氛。\n抱城江海气，登顿挹氤氲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38322,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"韬光寺一首","author":"黄省曾","text":"昔有韬光者，岩栖向此中。\n法流还挹润，禅秀尚翘风。\n院树经冬绿，林曦薄午红。\n沦蔬供奏酒，区外乐嘉同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38323,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灵隐寺一首","author":"黄省曾","text":"一殿临飞岛，诸禅丽拥山。\n层层琴咽水，处处碧成关。\n昃景迟春眺，屯云待客攀。\n美人馀岁月，信宿不知还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38324,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"飞来峰一首","author":"黄省曾","text":"洞室曲仍曲，峰椒奇复奇。\n赋华形不似，游习胜还迷。\n西鹫应宜诧，东壶谅可齐。\n至今盘郁境，犹似众灵栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38325,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天竺寺一首","author":"黄省曾","text":"窈窕招提境，何年阿育开。\n泉泉皆八绕，树树作双栽。\n雁刹青鸳出，珠函白马来。\n碧题看竺国，何异化城回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38326,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]