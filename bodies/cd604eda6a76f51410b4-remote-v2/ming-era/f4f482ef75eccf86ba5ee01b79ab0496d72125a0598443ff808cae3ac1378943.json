[{"title":"回风岭","author":"王佐（汝学","text":"南北风来到此还，南边和暖北边寒。\n怪来天地人犹憾，一样琼南两样看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51537,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石船在崖州大洞天稍北","author":"王佐（汝学","text":"老我来游看石船，洞门别是一风烟。\n昔人已去无回辙，犹记淳熙丙午年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51538,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"澹庵井","author":"王佐（汝学","text":"中兴封事百年无，身倚皇天自不孤。\n酌罢清泉问秦桧，已无寸土寄头颅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51539,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏史八首 其一 赵简子世家","author":"王佐（汝学","text":"摩笄山前风日凄，代人犹自说当时。\n宝符藏地今安在，知爱男儿爱女儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51540,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏史八首 其二 秦始皇","author":"王佐（汝学","text":"不禁奸邪禁古书，至愚应不至秦愚。\n生前遗臭熏千古，不待沙丘混鲍鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51541,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏史八首 其三 秦二世","author":"王佐（汝学","text":"地能埋死不埋愚，黔首不愚秦自愚。\n胡亥一愚愚到死，却将法令罔诗书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51542,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏史八首 其四 李斯","author":"王佐（汝学","text":"李斯相秦留逐客，要使英雄六国无。\n岂料灭秦开汉者，只消闾左一声呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51543,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏史八首 其五 赵高","author":"王佐（汝学","text":"大树参天十亩云，万年直欲荫乾坤。\n指头小鸟来施粪，粪尽桐枝死到根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51544,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏史八首 其六 诸葛武侯","author":"王佐（汝学","text":"老瞒凶焰欲烧天，江左孙郎又少年。\n识得左军真帝胄，可能三顾不幡然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51545,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏史八首 其七 唐玄宗妃杨贵妃","author":"王佐（汝学","text":"渔阳动地鼓鼙声，虢国秦封斗粉城。\n谁为马嵬同驻马，莫随玉辇向西行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51546,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏史八首 其八 李卫公德裕","author":"王佐（汝学","text":"孤寒八百望崖州，恩怨分明未是仇。\n但使君心合君子，不须憎李自憎牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51547,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瓦窑原开生圹 其一","author":"王佐（汝学","text":"千年乔木护佳城，慷慨邀宾载酒行。\n一十八年重觅我，化为乌有一先生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51548,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瓦窑原开生圹 其二","author":"王佐（汝学","text":"一十八年风景殊，鸿濛汗漫是吾墟。\n吾墟迥与人间异，渣滓人间不是吾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51549,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄龙夜宿","author":"王佐（汝学","text":"棹歌到港鱼初上，人语过门月渐低。\n老景神清无梦寐，几回攲枕听潮鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51550,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中失约寄张凤彩","author":"王佐（汝学","text":"老懒作魔忧采薪，造化小儿来苦人。\n范张约冷负鸡黍，笑杀榴花瓮底春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51551,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词 赠两墩为乐老之章四首 其一","author":"王佐（汝学","text":"莫笑风前两鬓丝，老来偏爱竹枝词。\n若将年纪方彭祖，八十方才是小儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51552,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词 赠两墩为乐老之章四首 其二","author":"王佐（汝学","text":"试遣云英唱我词，我词便是璞墩诗。\n璞墩风月无边景，还是青春年少时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51553,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词 赠两墩为乐老之章四首 其三","author":"王佐（汝学","text":"碌碌红尘四十年，归来仍被世情牵。\n昨朝闲到桐墩下，信有人间快活仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51554,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词 赠两墩为乐老之章四首 其四","author":"王佐（汝学","text":"两朵能行白牡丹，妒花风雨忍相残。\n主人不吝东风面，明日还来一倚栏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51555,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柬唐榕冈处士尚义 其一","author":"王佐（汝学","text":"榕树公家有后昆，故家文献百年存。\n如今子好万事足，但可怡情日弄孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51556,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柬唐榕冈处士尚义 其二","author":"王佐（汝学","text":"椿株老祝八千龄，桂朵红攀第一茎。\n仙籍行香书具庆，白头林下胜登瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51557,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病长老","author":"王佐（汝学","text":"茕茕对影佛前灯，八尺绳床阁瘦藤。\n时有南宗诸子弟，来祈香火拜卢能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51558,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙眼二首 其一","author":"王佐（汝学","text":"本是骊龙颔下珠，昨因龙睡到寰区。\n世人只恐龙来取，讳却龙名不敢书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51559,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙眼二首 其二","author":"王佐（汝学","text":"少昊车前照乘珠，祝融部下岂台舆。\n荔枝只为肌肤厚，买得人间佞口谀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51560,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哀四义士","author":"王佐（汝学","text":"五更风雨晦乾坤，守信鸡鸣自不昏。\n万户千门皆已死，汗青今见四人存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51561,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"问汉亭","author":"王佐（汝学","text":"试将我意问明河，牛女曾无七夕过。\n河说经星元不动，人间自是语言多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51562,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卢相多逊","author":"王佐（汝学","text":"青天明主不堪欺，磐石元勋岂可移。\n莫怪老姬穷旅邸，能谈京邑旧因依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51563,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"知风草","author":"王佐（汝学","text":"飓母崩腾海岳移，方当寂寞未来时。\n高堂广厦人如醉，独有泥沙小草知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51564,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"麻竹笋谢友兄陈汝谐","author":"王佐（汝学","text":"莫怪频参玉版师，眉山学士旧相知。\n可怜一种真禅味，四百年来识者谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51565,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五指水","author":"王佐（汝学","text":"五指分山列四州，一支北上最当头。\n建瓴泻下朝东水，去与琼州作上流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51566,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏金鸡岭","author":"王佐（汝学","text":"闻说云中好养鸡，仙人家住武陵溪。\n何年海上朝三岛，鸡放云峰顶上啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51567,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金鸡夜鸣","author":"王佐（汝学","text":"闻道金鸡半夜鸣，九重颁诏欲宽征。\n年来正苦征科急，安得金鸡叫一声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51568,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鹦鹉杯","author":"王佐（汝学","text":"海不扬波三载来，飞潜蠢动在春台。\n枯螺托质为鹦鹉，去作南山万寿杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51569,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梁老桥","author":"王佐（汝学","text":"梁老修桥前代前，至今遗泽似当年。\n我行欲觅云仍问，四顾山荒石路偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51570,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"波萝蜜","author":"王佐（汝学","text":"硕果何年海外传，香分龙脑落琼筵。\n中原不识此滋味，空看唐人异木篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51571,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀归","author":"王佐（汝学","text":"万卷书生刘鲁风，闲来无事不从容。\n香风不动松花老，宿雨初收草木浓。\n莫把文章动蛮貊，悔将名利役疏慵。\n人生到处知何似，泛剡寒宵兴一蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51572,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"解友兄王宗一","author":"王佐（汝学","text":"几人回首愧朝班，此客空弹贡禹冠。\n江国草花三月暮，客毡风雨十年寒。\n闲来觅句空搔首，老去悲秋强自宽。\n万事看来忙不得，不如高卧且加飧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51573,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南溟奇甸歌","author":"王佐（汝学","text":"南溟奇甸褒封到，天语便代天地造。\n天地造物犹因材，南北不能齐杏梅。\n帝造一统涵春台，春台玉烛照九垓。\n甸服荒服同胚胎，南溟万里微汉台。\n七叶失宠缓五百，八十年代边维颓。\n后汉南朝遵祖，包荒姑勿推。\n隋唐一统，然犹因循旧染，视以四远待柔徕。\n宋设科目网人才，五星聚奎应光彩，文明之祥期千载。\n士有白袍倡文运而肇破天荒，有黄榜推少年而歆羡时辈。\n八榜蝉联，连裾接佩。\n自大观极科目之盛，至德祐厄阳九之悔。\n无何道穷天水归，海南运去物亦改。\n地莽翳天涯，朔风悲海外。\n白日苍海岛，化作黄尘寨，九十三年迷世界。\n皇天震怒，眷命下土。\n涤荡华夷氛，千古荒莽腥臊埃。\n圣祖奉天，焕发丝纶，褒封南溟奇甸天上来。\n比内邦畿甸服，万年民物奠居。\n落土著根荄，南溟为甸天地开，天荒地莽豁恢恢。\n海静波涛，千里白雪平皑皑。\n山增气色，一天青秀高崔嵬。\n光天之下，重光协日，南陲陆海隅，幽景光照回。\n望祭山川岳渎，骏奔相追推。\n溟甸有阶侯焚柴，溟甸有阶荷焚柴。\n皇天后土，混合山海元气回。\n钟灵毓秀生英才，后先衮衮登公台，位居九棘面三槐。\n群才属休明，奉承盈运纷徘徊。\n玉烛馀光照草莱，遗民遗黎荷栽培。\n南溟为甸方，恰才未及十纪。\n而人物增品之盛，遽与隆古相追陪。\n衣冠礼乐之美，遽与中州相追陪。\n诗书弦诵之兴，遽与邹鲁相追陪。\n财成之道，天地不能财。\n帝造独代天安排，抚育南北同婴孩。\n民胞物与分形骸，是盖分殊而理一恒该。\n含生并育，各得其所安其分，一一孰非帝造恩播筛。\n海不扬波百神谐，巨灵效顺驱风协平荡海岛，禹迹不到蛟龙堆。\n又驱黑海跋浪翻溟吞舟，巨鳅群归尾闾清海灾。\n鼋鼍龙鱼鳖，海错万状不可枚，源源来游来臻南溟殖货财。\n岂直玳瑁可翊冠冕之华美，而砗磲独与七宝争奇瑰。\n此皆圣造，既已赞育两间，同于天地覆载。\n夫天地分形，海岳奠位。\n南溟奇甸，圣人先同轨。\n蓦地太古荒服，丕变侯邦而虚丽武卫。\n人文物华钟奇此萃，此岂人为而能然哉。\n所谓圣人先天而天弗违，此其类也。\n以人文言，汉唐以前世远不赘，赵宋奉天造草昧。\n内地诸州，咸相胥于乱而不治之区。\n而以华为夷，皆相率于暗而不明之域，而视昼为晦。\n是故海南人文，为国守死，抗节无愧。\n始焉祥兴勤王，而吾人独倡先锋之孤危。\n终焉厓山运移，而吾众复守后凋之寒岁。\n茕茕吊影于胡天，而伤百年之无君。\n乾乾待命于中土，而俟千载之嘉会。\n古有守礼义之国，此其古之流风遗爱。\n洪武开天，诏恤下慰。\n首言海南习礼义之教，有华夏之风砺世，天章光昭五纬瑞。\n是盖先天圣人将欲降生，而天不违之，人民以先钟奇此萃矣。\n以物华言，山海物产，千状万态。\n难置百喙，姑举长流，以通异派。\n是故物华所先，则田美两熟，而有三熟之加。\n蚕禁原蚕，而有八蚕之倍。\n珍珠麦利济军师，桄榔面应济饥馁。\n天南星药品耳，既同薯蓣济饥，而亦与中秋节物。\n鸭脚粟草部耳，既均谷菽赒给，而恒充四季家醅。\n花之穗知年有秋，草之叶知风有飓。\n蜜株酒树之硕果，不假人为而自出天然。\n凤卵龙乳之佳实，不用酋盐而能令人醉。\n既有三超园品之奇，复同一守甸土之贵。\n邻封仅逾百里，限天堑而根不敢移。\n寰宇虽购千金，守天定而节不敢贷。\n盖曾受戒真宰于千载之前，而预为南溟奇甸万年之待。\n又若陇山之莺，岭南所无也，而甸域有之，是谁使之有哉，盖为奇甸表章稀世之瑞。\n通国之虎，岭南所有也，而甸域无之，是谁使之无哉，亦为奇甸禁绝万年之害。\n馀若鸡有灵，放啼三声而占否泰。\n雀有长，就观五色而别章采。\n是皆甸山钟奇吐秀，而自然发露之英华，靡物物刻雕而调习采绘。\n古有嘉禾异蓂灵物之属，此其古之遗迹。\n大概维岳降神，岂惟生贤，亦必有逾古嘉精灵应，出为治世光贵。\n况今先天圣人嗜欲将至，而天不违之，物华亦皆钟奇此萃矣。\n人文物华，钟奇此萃。\n一触圣心之天机，而天光宇泰，自然鸣天籁。\n隐尔天声，形于金石玉音之宣，遂为南溟人物，万世永赖。\n噫嘻，龙马浮河而羲画成，神龟出洛而禹畴遂。\n南溟献奇，而圣祖皇帝玉音克配。\n先圣后圣，本同一揆。\n仰观古今，南溟一地。\n治乱安危，何曾择代。\n隋唐两开幕府，徒费罢郡食邑，未闻进德而嘉会。\n圣神一褒疆域，不止进德嘉会。\n而置荒服于邦畿侯甸之安，纳民于安富尊荣之内。\n圣恩罩被疆域，有如是哉。\n鼎湖龙去天巍巍，元元蠢蠢，惟亿万世思荣哀，圣子神孙执鬯杯。\n吾甸吾人，为犬为马，世报恩德南溟隈。\n南溟奇甸，永抱玉音，穷极宇宙，而历万万飞劫灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51574,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"伤石鼓赋送国子监丞先生赴徽州经历","author":"王佐（汝学","text":"鼎非没器兮，麟难服车。\n用之违其材兮，物乃龃龉。\n孔子西行兮，返晋水浒。\n删诗三百兮，逸此石鼓。\n天实爱道兮，鬼物守护。\n存此至宝兮，昭示万古。\n载籍茫然兮，居然再睹。\n巍巍荡荡兮，周宣御宇。\n嗟彼何人兮，是之裁取。\n此其为臼兮，焉可爱许。\n使我心伤兮，泪下如雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51575,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"飓母","author":"王佐（汝学","text":"断虹饮海日光微，西北崇朝气惨悽。\n飓母呼风千里至，土皇伤木万山悲。\n掀天坐看乾坤变，剥地浑惊海岳移。\n最是桐乡心独苦，三间茅屋可能支。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51576,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"圆山村","author":"王佐（汝学","text":"胜槩圆山水竹村，故家文献百年存。\n书香济美今如昔，科第光华祖又孙。\n酒兴诗情惟岁月，水遭山独自乾坤。\n白头慢忆通家旧，世难无因一过门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51577,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"落笔峒","author":"王佐（汝学","text":"路入烟霞一洞深，悄无鸡犬昼沉沉。\n老僧尚有栖禅迹，游客时闻击磬音。\n石窍漏天三百丈，井泉到海几千寻。\n仙家景象人难道，天遣悬崖落笔吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51578,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"珍珠麦","author":"王佐（汝学","text":"汉师南下扫妖氛，胜瘴轻身亦著勋。\n利口苦遭梁驸马，知心还是马将军。\n可怜荒服多奇产，辜负中兴有圣君。\n千载寥寥效忠意，谩醺山叟睡闲云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51579,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蛱蝶","author":"王佐（汝学","text":"山花一朵色幽閒，自恃幽姿懒出山。\n若到上阳媒蝶幸，滕王错置画图间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51580,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"葵","author":"王佐（汝学","text":"问花已漏青皇籍，何事频开九夏红。\n花性向阳心独盛，耻同桃李竞春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51581,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刺桐","author":"王佐（汝学","text":"东君三月剪猩红，分著枝头片片工。\n海国乡村随处有，田家门巷一般同。\n离披风火欲生焰，烂熳晴霞几闹空。\n地迥幸无车马到，闲看花候毕农功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51582,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"攀枝花","author":"王佐（汝学","text":"焰焰烧空出化炉，一春花信最先孚。\n看花未暇评牛李，且醉东风听鹧鸪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51583,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荔枝","author":"王佐（汝学","text":"火珠压树红离离，五月炎州荔熟时。\n买树有时来野老，窥枝终日戒群儿。\n红尘不媚烟花笑，玄圃深韬玉雪肌。\n昨向祝融求再熟，点头惟与后年期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51584,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"椰子","author":"王佐（汝学","text":"累累青子压秋房，千尺高株挂碧苍。\n清庙周罍云捧得，渑池秦缶化陶将。\n涵濡璞玉精英嫩，美满金茎滴露香。\n欲和金茎餐玉屑，茂陵曾有寿生方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51585,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"馀甘","author":"王佐（汝学","text":"直友久来方见益，危言过后始思忠。\n吁嗟山果能回味，自觉迟迟味不穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51586,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"野茶","author":"王佐（汝学","text":"谁识炎州一种茶，天教灵产閟烟霞。\n建溪斗美非吾事，阳羡先尝自一家。\n闽客错猜龙换骨，国风休咏鼠无牙。\n陆生谩有茶经著，谁识炎州一种茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51587,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"知风草","author":"王佐（汝学","text":"造化无端亦有偏，世间无限好英贤。\n何如小草无情物，独与天机测妙玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51588,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石蟹","author":"王佐（汝学","text":"李相口藏心里剑，晋公身作眼中丁。\n何如化石枯螃蟹，身死犹存济物情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51589,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"益智子 其一","author":"王佐（汝学","text":"花开三节去年丰，今岁无花苦岁凶。\n益智不如多益饱，免教饥馁怨春丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51590,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"益智子 其二","author":"王佐（汝学","text":"百万闾阎冻馁家，只因征敛丧生涯。\n农谈畎亩知何事，却向深山责野花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51591,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"槟榔","author":"王佐（汝学","text":"海国居奇货，何当最上珍。\n丘园逃禄爵，商贾忽金银。\n白泽通寰宇，红潮到八闽。\n岐黄宠臣使，别命管交亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51592,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和李本德槟榔叹","author":"王佐（汝学","text":"居货无如此货奇，十州俗尚总相宜。\n定交两姓轻盟血，坐易千金似折枝。\n繁实独超南国产，孤根不受北方泥。\n琼农本有天然利，飓母秋风自适时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51593,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鹦鹉杯","author":"王佐（汝学","text":"雉入水为蜃，难穷变化神。\n非荣陇山质，要复化来身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51594,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄张翙","author":"王佐（汝学","text":"闻君新制槟榔扇，几欲求观未有因。\n坐拥定如聃老子，行持应类吕仙人。\n编蒲织锦千般旧，剪月裁云一样新。\n安得芸窗来一握，手挥三伏播秋旻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51595,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"藤作 其一","author":"王佐（汝学","text":"惟我祖宗怜远土，两朝优诏特矜楚。\n公使踰法许具闻，气焰权奸犹敛阻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51596,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"藤作 其二","author":"王佐（汝学","text":"后至先皇弘治初，大禁贡献民熙和。\n振儋金香罢唐例，南宁银姜无宋科。\n民赖优游三十载，肇此厉阶谁复再。\n公贿私贡恐已迟，谁体圣心存海外。\n妻号儿哭无朝夕，催奴那知更下石。\n谁能临武叫天阍，守有徐方留郡迹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51597,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]