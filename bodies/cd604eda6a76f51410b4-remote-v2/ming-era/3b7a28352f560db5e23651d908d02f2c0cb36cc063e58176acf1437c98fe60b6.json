a256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜思友","author":"张元凯","text":"琴尊久寂寞，常忆故人驩。\n不待飞霜雪，蘼芜此夕寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29292,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日山中","author":"张元凯","text":"藤萝蔽日月，一室翠生寒。\n科头立松下，飞瀑来岩端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29293,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"静夜对月有怀故人","author":"张元凯","text":"朔雁来高天，山桂落清夜。\n所思万里人，只在明月下。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29294,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与客竹下分得深字","author":"张元凯","text":"白云留不住，翠霭飞自深。\n美人潇湘来，与之弹素琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29295,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"军中乐二十首有序 其一 出塞","author":"张元凯","text":"元戎十乘度龙沙，旌旆悠悠士不哗。\n踊跃长驱三万里，烽烟未熄肯言家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29296,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"军中乐二十首有序 其二 乘障","author":"张元凯","text":"亭障巉岩照夕烽，盛秋都护肃临戎。\n渔阳塞外严凝气，一片阴山积雪中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29297,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"军中乐二十首有序 其三 战胜","author":"张元凯","text":"云中不闭雁门关，减灶沉烽白日閒。\n蕃骑寇边三百万，单于仅以六骡还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29298,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"军中乐二十首有序 其四 受降","author":"张元凯","text":"汉家飞将会龙城，面缚千群向柳营。\n幕府何须计首级，但图麟阁是功名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29299,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"军中乐二十首有序 其五 屯","author":"张元凯","text":"时平塞外野苍苍，休息三军艺稻粱。\n耕凿已堪忘帝力，不知何地是沙场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29300,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"军中乐二十首有序 其六 猎","author":"张元凯","text":"走狗呼鹰遍草莱，干城须仗兔罝才。\n经过捕得云中敌，畜产车辎席卷回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29301,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"军中乐二十首有序 其七 击剑","author":"张元凯","text":"剑佩昆吾靖朔边，镮生明月匣生莲。\n斑痕任积边庭血，一击精灵耀紫烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29302,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"军中乐二十首有序 其八 蹋鞠","author":"张元凯","text":"鞠室才穿约佽飞，香尘浮处曳单衣。\n晏安只恐髀生肉，且试轻蹻掣绛帏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29303,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"军中乐二十首有序 其九 超距","author":"张元凯","text":"投石三军技最优，况曾超跃羽林楼。\n春和塞草平铺翠，贾勇争先博一筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29304,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"军中乐二十首有序 其十 赋诗","author":"张元凯","text":"莲花幕里笔如椽，横槊雄词邺下传。\n却笑李陵非国士，创为儿女别离篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29305,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"军中乐二十首有序 其十一 射","author":"张元凯","text":"期门结伴试穿杨，忽断秋空朔雁行。\n猿臂自誇如李广，应弦曾倒左贤王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29306,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"军中乐二十首有序 其十二 骑","author":"张元凯","text":"善马群空宛贵人，执驱校尉拜官新。\n试将紫燕平原猎，却使苍鹰望后尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29307,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"军中乐二十首有序 其十三 歌","author":"张元凯","text":"幕府初开镜里莲，秦青新曲乍教传。\n知音不返周郎顾，含态偏承主帅怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29308,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"军中乐二十首有序 其十四 舞","author":"张元凯","text":"长袖蛮靴曳翠裳，依歌赴节俨成行。\n军中自有缠头锦，不学梁家堕马妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29309,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"军中乐二十首有序 其十五 春游","author":"张元凯","text":"行春小队拥材官，尚觉边城草色寒。\n马度水来抛玉勒，鸟穿花去避金丸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29310,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"军中乐二十首有序 其十六 贺雪","author":"张元凯","text":"雪没阴山大将牙，兽尊高贮紫流霞。\n关城不夜清笳月，营树冲寒细柳花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29311,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"军中乐二十首有序 其十七 博","author":"张元凯","text":"春到边城不射雕，营中高卧霍票姚。\n偏裨夜博千金注，已识军前但用枭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29312,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"军中乐二十首有序 其十八 饮","author":"张元凯","text":"连营尽唱凯旋歌，塞酒浑如塞上河。\n主帅投醪能爱士，三军常得醉颜酡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29313,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"军中乐二十首有序 其十九 拜爵","author":"张元凯","text":"天山箭定海无涛，马上旌书纪战劳。\n姓字一时题幕府，不为强弩即弓高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29314,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"军中乐二十首有序 其二十 班师","author":"张元凯","text":"封侯万里报功成，放马桃林散甲兵。\n生入玉关非志愿，丈夫高抱乐长征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29315,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闺中词二十首有序 其一 春晓","author":"张元凯","text":"晓睡蒙蒙锦帐低，合欢床在最深闺。\n梦魂化作双鸳鸟，飞向并头莲里栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29316,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闺中词二十首有序 其二 锦筵","author":"张元凯","text":"华堂疏越响朱弦，有女明妆对俨然。\n玉斝乱飞翻翠袖，淳于先已醉初筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29317,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闺中词二十首有序 其三 临花","author":"张元凯","text":"花枝不减去年红，妾貌今年似不同。\n游子不归花又落，年年人老怨东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29318,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闺中词二十首有序 其四 见月","author":"张元凯","text":"月昔圆时人共怜，人今远去月空圆。\n亦知天外原同照，无奈人间各一天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29319,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闺中词二十首有序 其五 览镜","author":"张元凯","text":"晓帐晴晖照影孤，桃花片片扑流苏。\n一枝镜里犹堪摘，未识狂夫记得无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29320,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闺中词二十首有序 其六 持筐","author":"张元凯","text":"取斧携筐卷袖罗，柔荑无奈远扬何。\n桑间莫浪逢人语，调笑秋胡世上多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29321,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闺中词二十首有序 其七 秋思","author":"张元凯","text":"鸾凤衾裯不复陈，任从蛛网任从尘。\n秋风一夕容华落，总是长门赋里人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29322,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闺中词二十首有序 其八 远书","author":"张元凯","text":"尺素含啼寄塞垣，锦囊缄处绣双鸳。\n远书未必真能达，纵郁烦忧肯尽言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29323,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闺中词二十首有序 其九 山阁","author":"张元凯","text":"凭高罗袂不胜寒，笑插山花倚石阑。\n无限远峰浮黛色，飞来镜里入眉端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29324,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闺中词二十首有序 其十 野航","author":"张元凯","text":"兰桨轻摇莲叶开，孅孅罗袜净无埃。\n雨云不向巫山去，容与还从洛水来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29325,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闺中词二十首有序 其十一 晓汲","author":"张元凯","text":"汲罢清泉露湿鞋，碧梧飘叶半空阶。\n羞他井底孤凰影，堕却嫁时双凤钗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29326,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闺中词二十首有序 其十二 夜奕","author":"张元凯","text":"手弹玉垒照银缸，闺閤和亲未受降。\n自是南风犹不竞，无端输子一双双。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29327,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闺中词二十首有序 其十三 采莲","author":"张元凯","text":"凫鹥撩乱起蒹葭，弄桨穿莎湿绛纱。\n世上恨无连理藕，波间喜有并头花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29328,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闺中词二十首有序 其十四 乘骑","author":"张元凯","text":"联镳举袂柳风吹，银镫金莲步步垂。\n按辔要郎花下语，莫教马首暂参差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29329,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闺中词二十首有序 其十五 洞房","author":"张元凯","text":"兰气俄从翠被生，烛辉犹傍绣床明。\n枕边栩栩双蝴蝶，搅断鸳鸯梦不成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29330,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闺中词二十首有序 其十六 酒肆","author":"张元凯","text":"糟丘忽漫出芙蕖，却向垆头粉靥舒。\n含态含娇情不一，似曾相识马相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29331,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闺中词二十首有序 其十七 小饮","author":"张元凯","text":"夜寒孤坐强持杯，惆怅红颜对落梅。\n淑女未能忘旨酒，周南什里赋金罍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29332,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]