h":"明_1.csv","pointer":22258,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"仲春望日予为社主诸公有不赴者是日无诗且散去雨中闷怀因取杜句继以唐宋人句集诗九律各志所感奉寄诗皆人所习闻者姓名故不列载萝石隐翁时在禹穴 其六 西皋太守","author":"朱朴","text":"洞口春晴花正开，无人不道看花回。\n山妻早报蒸藜熟，村巷传呼宰相来。\n白昼放歌须纵酒，百年多病独登台。\n明朝别后门还掩，风雨惟知长绿苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22259,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"仲春望日予为社主诸公有不赴者是日无诗且散去雨中闷怀因取杜句继以唐宋人句集诗九律各志所感奉寄诗皆人所习闻者姓名故不列载萝石隐翁时在禹穴 其七 海村麾使","author":"朱朴","text":"自笑鄙夫多野兴，谩劳车马驻江干。\n双双瓦雀行书案，片片轻鸥下急湍。\n杏酪渐香邻舍粥，花枝欲动春风寒。\n且看欲尽花经眼，明月明年何处看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22260,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"仲春望日予为社主诸公有不赴者是日无诗且散去雨中闷怀因取杜句继以唐宋人句集诗九律各志所感奉寄诗皆人所习闻者姓名故不列载萝石隐翁时在禹穴 其八 紫峡隐士居峡川","author":"朱朴","text":"诸公衮衮登台省，东老虽贫乐有馀。\n岭树重遮千里目，故人那惜一行书。\n藤花委地香犹在，谷雨乾时手自锄。\n闻说小斋多野意，白云閒钓五溪鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22261,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"仲春望日予为社主诸公有不赴者是日无诗且散去雨中闷怀因取杜句继以唐宋人句集诗九律各志所感奉寄诗皆人所习闻者姓名故不列载萝石隐翁时在禹穴 其九 石林上人","author":"朱朴","text":"石林精舍虎溪东，尽日门前独看松。\n年老身閒无外事，眼看春尽不相逢。\n月明古寺客初到，睡觉东窗日已红。\n今日鬓丝禅榻畔，一番清话又成空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22262,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"为勾溪画独钓图","author":"朱朴","text":"松吹凉生锦箨冠，鸟还云出坐中看。\n勾溪数亩清泠水，更著何人并钓竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22263,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题文衡山竹","author":"朱朴","text":"衡山先生玉堂客，援笔戏写青琅玕。\n萧萧瘦干疏疏叶，疑有清风六月寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22264,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"为僧浩公画雪嵓图","author":"朱朴","text":"雪嵓道者僧中杰，踏雪曾参雪窦禅。\n归到雪岩心似水，梅花纸帐日高眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22265,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"访许云村不遇","author":"朱朴","text":"发兴寻閒为破閒，閒人底事出青山。\n春风似惜空归去，一路飞花送客还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22266,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪景","author":"朱朴","text":"水映平林雪满山，孤舟撑出断桥湾。\n梅花未漏春消息，閒向湖边载鹤还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22267,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"红梅","author":"朱朴","text":"寒花本是冰霜面，怪见谁家雪里红。\n应恐路人轻著眼，故将颜色换春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22268,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孝隐村沈元懋国初人夏荣作孝子传程都宪巽隐为跋于后","author":"朱朴","text":"巽隐为书元懋传，昌黎曾作董生行。\n安丰县即丰山里，今古同存孝隐名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22269,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"为朱南野画扇","author":"朱朴","text":"镜中白发星星变，江上青山日日閒。\n尽向镜中忧白发，谁来江上看青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22270,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"为养泉上人题","author":"朱朴","text":"洗钵脩斋煮茗芽，道心涵泳静尘砂。\n閒来礼佛无馀供，汲取瓷瓶浸野花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22271,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鸡冠花","author":"朱朴","text":"绛帻昂藏绿叶稀，凌风起舞欲高飞。\n无因为报天门晓，独立閒阶顾羽衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22272,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"联节坊张方洲二姬剪发自誓邑闻于朝表其门","author":"朱朴","text":"剪落乌云四十秋，死生孤苦雪盈头。\n金兰玉树联芳第，不数张家燕子楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22273,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"画寄孙白峰","author":"朱朴","text":"枫落吴江叹索群，草青南浦正思君。\n春深不见归飞雁，独上危峰望夕曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22274,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"正月十五日谢乡饮","author":"朱朴","text":"邑宰持书枉及门，野人安敢负君恩。\n群贤毕集衣冠盛，老我虚当齿发尊。\n芹泮煖风闻雅乐，杏坛晴日丽芳樽。\n酒阑拜罢扶归路，月挂梅梢雪后村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22275,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上巳同友辈村郊行乐","author":"朱朴","text":"三月三日出郭行，风和日暄天气晴。\n衔泥补巢旧家燕，隔水唤春何处莺。\n垆头小姬酒正熟，道傍古坟人自耕。\n劝君行乐贵及早，明日清明花满城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22276,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赏菊","author":"朱朴","text":"草堂秋色富于春，霜露飘香上幅巾。\n病眼又酣前度酒，寒花应识暮年人。\n三闾赋后谁曾咏，五柳看来迹已陈。\n千古清风君独领，肯教篱落负芳辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22277,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初度日","author":"朱朴","text":"一度生辰一掷梭，百年有限奈如何。\n同时骨肉看将尽，后辈才能觉又多。\n乡饮荐书惭久负，社祠嘉会数相过。\n白头又识春风面，笑折梅花对酒歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22278,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"箫杖","author":"朱朴","text":"五音刳节过眉裁，七尺连枝九窍开。\n筇干固非韶乐具，紫鸾聊假化龙材。\n停吹夜月歌桃竹，倦倚春风奏落梅。\n年少风情衰老伴，扶持还想凤凰台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22279,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题南极老人图寿爱槐王德泽","author":"朱朴","text":"南极老人霜满颠，瓣香图像寿觞前。\n人间五福元推右，天上三星合让先。\n赤县王乔同谱系，缑山子晋亦神仙。\n为君遐算从今祝，愿见重登六十年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22280,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孝子顾子芳刻木为母奉事如生及顺继母慈孝相感以诗嘉之二首 其一","author":"朱朴","text":"刻木为娘刻意深，视成怡悦听成音。\n雕工易刻慈亲貌，难刻人间孝子心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22281,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孝子顾子芳刻木为母奉事如生及顺继母慈孝相感以诗嘉之二首 其二","author":"朱朴","text":"事死怜君若事生，母无前后孝俱成。\n卧冰守柰千年后，肯许王祥独擅名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22282,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丰山孝子徐览割股救母因赠","author":"朱朴","text":"儿股伤残母命存，神功亦为感慈恩。\n悬知今日丰山里，不愧当年孝隐村。\n清誉只应敦薄俗，上书谁与乞旌门。\n由来此道无他报，会见传芳到子孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22283,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"近山为徐履卿题","author":"朱朴","text":"垂萝绝壁好跻扳，只隔烟岚数步间。\n不用移居深处隐，桃源风景在人寰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22284,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中晚行","author":"朱朴","text":"烟光寂寞夕阳时，远近钟声即复离。\n路静久无尘鸟迹，客来惟有鹤先知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22285,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送汪白野还杭立春日","author":"朱朴","text":"野寺门前江可怜，柳条难系木兰船。\n穷郊岁晚冰霜合，刚待春风上别筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22286,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏盆中桧寓怀","author":"朱朴","text":"老桧何年解服盆，病肤犹带石苔痕。\n不知多少挛拳苦，消得斯须灌溉恩。\n屈节无材干梓匠，秾华有类阅朱门。\n从渠束缚人休笑，岁晚心期只自存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22287,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"走索","author":"朱朴","text":"绒索为桥跨綵虹，步从平地上虚空。\n绣鞋半湿花梢露，罗袂轻杨柳面风。\n神女踏波行洛浦，素娥辞月下蟾宫。\n更怜玉臂垂双翼，彷佛青鸾舞镜中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22288,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送孙白峰北上次韵","author":"朱朴","text":"千里南还又北行，碧江烟艇画中清。\n雕弓中鹄须持满，粉饰倾城让后生。\n老我期君尝结梦，是谁推尔定知名。\n都城见月孤吟夜，应忆山中别后情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22289,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"为云居正长老画小幅山水","author":"朱朴","text":"记得危岩倚石楼，西湖烟景坐来收。\n遥岑寸碧空王殿，断岸飞凫独客舟。\n九曲屏山因雨洗，六桥练水带花流。\n重游预订春来约，未许青山笑白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22290,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谷芳上人创二石桥谢以画并题","author":"朱朴","text":"村径两徒杠，津岐赖相接。\n岁久木尽摧，来往多病涉。\n吾师好施予，毅然探囊箧。\n伐石来西山，架梁通便捷。\n摅心不知劳，旬日足功业。\n行人履坦途，无复待舟楫。\n平生好修葺，于此意自惬。\n福报固不图，一念历千劫。\n愿焉寿无疆，期颐稳登蹑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22291,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"悼孙太初","author":"朱朴","text":"太白山人谪仙李，气节风流无乃似。\n拄颊香炉瀑外烟，翻身采石矶头水。\n一从骑鲸飞上天，复来人间今几年。\n来无定踪去无迹，只有丽句人间传。\n终南山高几千里，苕溪霅溪渺涯涘。\n此老精灵何处归，还在西湖月明里。\n孤山放鹤招同心，巢阁先生林处士。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22292,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谢王雨舟灵寿杖","author":"朱朴","text":"武当山高几万丈，中有千年灵寿杖。\n金光玉芝秀所钟，生在青霞石嵓上。\n雨舟先生道者流，赠我一枝东海头。\n琅玕润滑铁坚瘦，昂首屈项苍精虬。\n老夫病足如跛鳖，藉此扶持少颠蹶。\n朝出横拖石壁云，暮归倒拄溪桥月。\n乘舟著篙马著鞭，凌高涉下无不便。\n为寻短句谢远意，绕径啄碎青苔钱。\n不愁化龙忽飞去，不愿提携朝玉陛。\n但愿长挑沽酒钱，日日登堂共君醉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22293,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中寄勾溪","author":"朱朴","text":"冥冥稻花雨，漠漠野云秋。\n飒响悲黄落，丝飞乱白头。\n乍于灯下细，偏傍枕边稠。\n累月宁苏旱，愆时却送愁。\n湿萤仍草莽，迷鹤独林丘。\n天地非无为，江湖可散忧。\n积阴霾御气，深淖阻宸游。\n忍冻吾庐足，啼饥比屋侔。\n自非原宪病，谁是子桑俦。\n颇忆钓鱼伴，孤吟蘅杜洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22294,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"醉閒卷","author":"朱朴","text":"富翁买田过千亩，日日匆忙不饮酒。\n贫老无钱囊橐艰，日日饮酒醉且閒。\n富翁回首问贫老，酒尽囊空奈何好。\n贫老答曰翁不知，树上好花开几时。\n儿孙各有儿孙计，死抱黄金将付谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22295,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哀湛秋江","author":"朱朴","text":"瓶锡江湖三十年，姓名遍与诗流传。\n山中老屋裹薜荔，一爨累月寒无烟。\n采辑盛音仍绣梓，行道参禅了生死。\n身事忙如风外云，心情淡若江头水。\n翩然踪迹归乎来，维摩示病销筋骸。\n一龛寒月锁委蜕，三昧热火烧成灰。\n老我交游痛凋丧，不解吾师脱凡相。\n肠断吟魂何处飞，也应只在秋江上。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22296,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"风入松 次宋人题西湖","author":"朱朴","text":"武陵春酒不论钱，红杏竹篱边。\n画桥一带青青柳，兰舟系、玛瑙坡前。\n隔树数声鹦鹉，谁家一簇鞦韆。\n朱唇玉板鹧鸪天，歌罢鬓云偏。\n杜鹃啼歇清明雨，楼台锁、几处新烟。\n沈醉折花归去，路傍拾得遗钿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22297,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"念奴娇 雨中","author":"朱朴","text":"荼䕷初谢，又山丹开过，蔷薇零落。\n二十四番花信了，清暑绿阴帘幕。\n五月陂塘，熟梅风雨，病怯春衫薄。\n重门静掩，客怀无奈萧索。\n惆怅绿绮弦空，紫箫声断，好事翻成恶。\n睡起无聊还欲睡，梦绕白云丹壑。\n怨别伤离，新愁旧恨，一醉都抛却。\n数声山鸟，醒来人在西阁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22298,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南溪精舍","author":"林逢春","text":"曾记当时醉此斋，此斋初辟菊初栽。\n今朝携酒重来赏，醉插黄花笑口开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22299,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"钱塘江头寄兴","author":"张希载","text":"寻真偶过大明庵，斗径纡回步不堪。\n傍竹幽禽啼欲暮，眠云老衲梦初酣。\n归心时逐江流急，逸兴春从树色贪。\n更欲振衣千仞去，笑将行止与琴弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22300,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过长陵","author":"张希载","text":"三月春光满画屏，侵晨策马过长陵。\n遥看山碧连天碧，细听人声似鸟声。\n屏转不禁怀抱恶，间关方觉利名轻。\n他时倘遂投间计，呼酒东篱泛菊英。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22301,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过柳州紫云洞有怀吴司寇东湖","author":"张希载","text":"几树梅花间本樨，东湖流泽满轮蹄。\n细听多少行人语，谩把甘裳作品题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22302,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过横州怀昊士羡侍御骆天爵二尹","author":"张希载","text":"山山不断鹧鸪啼，风雨孤舟路欲迷。\n何处相思人不见，几回翘首隔城西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22303,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与李大厓宿听泉楼怀甘泉贲斋诸君","author":"张希载","text":"山楼此夕共铺云，月满长空水满津。\n笑我自耽林下乐，独怜多少未归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22304,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"沐恩归养卷送吴希之还琼山","author":"张希载","text":"客里那堪一送君，归心几度逐溪云。\n九重雨露新承宠，万里舟航只为亲。\n煮蕨自知甘列鼎，铺霞偏觉胜重裀。\n彩衣岁岁堂前舞，不愧当年奉檄人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22305,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽陈衍死敌","author":"戴轸","text":"百越风尘暗铁衣，捐躯报国是男儿。\n龙泉尚照孤臣血，马革何怜烈士尸。\n志灭鲸鲵心欲奋，气吞虎豹力难支。\n岭南一段纲常事，付与当年史氏知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22306,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"置堠岩","author":"邓翘","text":"泠泠岩上水，滴滴出云根。\n境野烟霞寂，林深鸟雀喧。\n幽龛留藓迹，怪石长苔痕。\n归路逢樵叟，濛濛夕照昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22307,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿湛甘泉尚书八十","author":"梁亿钟","text":"瑶池宫中何所有，琪花瑶草自光茂。\n内有蟠桃万岁枝，六千一度真奇秀。\n玉堂金马旧主人，却逢王母西来寿。\n昔年折桂游蟾宫，文章璀璨齐韩柳。\n唾壶错落聚珠玑，彩毫恍惚连牛斗。\n文河捲雪走龙蛇，学海飞涛起蝌蚪。\n归来高卧几度春，寿域适今逢九九。\n神仙驾鹤举霞觞，玉女云鬟妙吹奏。\n捧将玉露调金丹，摘取松花酿春酒。\n簪缨斑綵满阶前，朱门珠履如云辏。\n皇华使者乘骢来，特遣存公安乐否。\n衣冠赫奕路辉煌，翠帆锦毂相驰走。\n我来上爵颂南山，获从梓里诸绅后。\n祝言甲子不记年，愿与天地长且久。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22308,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西湖图录二 其一","author":"陈滔","text":"谁写西湖一段奇，主人閒寄旧游时。\n红楼倚醉临空阔，画舫移歌入渺瀰。\n解语荷花争献酒，多情桃叶索题诗。\n丹青此意谁堪会，肠断三生杜牧之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22309,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西湖图录二 其二","author":"陈滔","text":"闻说杭州胜颍州，平湖千顷净如秋。\n东坡到处留新话，西子何年忆旧游。\n十里荷花迎画舫，六桥杨柳送鸣驺。\n摩挲老眼丹青里，惆怅天堂负白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22310,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春山行二首 其一","author":"周昌龄","text":"洞壑回千叠，行行兴不穷。\n云添短鬓白，花映老颜红。\n峭壁稀人到，仙源有路通。\n飘飖更深入，始觉脱樊笼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22311,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春山行二首 其二","author":"周昌龄","text":"绝巘苦跻攀，莓苔一径斑。\n恍疑到天上，未信是人间。\n黄鹤窥人舞，玄猿引子还。\n壶觞憩松石，聊共白云閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22312,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"芸窗幽思四首 其一","author":"周昌龄","text":"遥看草色天连雨，坐见苔斑水渍山。\n风月招邀惟我懒，莺花撩乱几人閒。\n新葩呈艳菁葱合，古树园阴紫翠环。\n点检药囊参术在，不妨扶老驻衰颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22313,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"芸窗幽思四首 其二","author":"周昌龄","text":"水榭乘风恣浪游，隔江歌沸小凉州。\n冰盘荐荔堆红玉，琼椀浮瓜漾白沤。\n天地一时回爽气，林峦随处散閒愁。\n相思有约知何地，只在青山碧水头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22314,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]