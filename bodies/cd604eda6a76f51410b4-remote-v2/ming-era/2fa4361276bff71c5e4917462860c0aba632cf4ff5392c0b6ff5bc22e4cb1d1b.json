[{"title":"巫山高","author":"徐熥","text":"宫殿伤芜没，峰峦入杳冥。\n猿声经峡惨，山色近湘青。\n神女魂何处，襄王梦已醒。\n朝昏见云雨，犹自想精灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花落","author":"徐熥","text":"繁花生绝塞，春至几枝空。\n舞杂梁园雪，飘随庾岭风。\n妆台香点砌，官阁影辞丛。\n少妇高楼上，含悽曲调中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"折杨柳","author":"徐熥","text":"别时曾一折，羌管不堪听。\n愁锁眉同翠，娇回眼共青。\n征途悲雨雪，古驿望流星。\n却恨飞空絮，随波化作萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"关山月","author":"徐熥","text":"一片关山月，悲欢望不同。\n穹庐光照海，沙碛影连空。\n轮满开秦镜，弦斜倚汉弓。\n年年三五夜，魂断玉楼中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陇头水","author":"徐熥","text":"秦川分两水，呜咽不能休。\n饮马冰犹冻，磨刀血半流。\n东西随陇坂，远近入边州。\n万古声无尽，惟添征戍愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"紫骝马","author":"徐熥","text":"蹀躞横行意，悲鸣恋主身。\n金鞭垂汉月，玉勒控边尘。\n影绝追奔易，蹄高转战频。\n不辞流汗血，未可事和亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"铜雀伎","author":"徐熥","text":"铜台遗令在，玉座主恩非。\n旧曲流哀管，馀香散舞衣。\n穗帷空寂寞，罗绮失光辉。\n日日西陵望，君王归不归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人赴安西","author":"徐熥","text":"离亭征马嘶，送子赴安西。\n后会知何日，前途方鼓鼙。\n天寒白草瘦，沙阔黄云低。\n所惜同心远，能无心惨悽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题方广岩廨院","author":"徐熥","text":"参禅觅野寺，凉月满空山。\n行到丛林里，溪流隔几湾。\n老僧拥衲坐，孤鹤闻钟还。\n回首来时路，渺茫烟霭间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞上逢故人","author":"徐熥","text":"胡笳声正喧，一骑向秋原。\n偶尔闻乡语，因之伤旅魂。\n停鞭问姓氏，掩泪叙寒暄。\n未尽悲欢意，沙场日又昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送僧还山","author":"徐熥","text":"深林长闭关，岁久欲西还。\n落日人烟少，秋风梵磬閒。\n锡飞孤鹤外，衲过断云间。\n应叹无期别，相寻何处山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元夕集宗少府宅 其一","author":"徐熥","text":"胜地春光早，开尊卜夜驩。\n更深银烛短，风细玉箫寒。\n露气凝疏幌，花阴罩画栏。\n六街冶游子，香雾扑雕鞍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元夕集宗少府宅 其二","author":"徐熥","text":"令节逢元夕，春光此地偏。\n竹枝游女唱，桂酌主人传。\n渐觉银河坠，还惊珠斗悬。\n悠然归路晚，万井散灯烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"溪行","author":"徐熥","text":"空山收晚照，秋色满川原。\n砧杵谁家妇，鸡豚何处村。\n丛林喧怪鸟，绝壁挂孤猿。\n白发高堂上，遥遥正倚门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重宿灵源洞怀珠上人","author":"徐熥","text":"重借蒲团宿，吾师已度杯。\n烟霞虚白社，衣钵入黄梅。\n犹忆无生偈，空馀般若台。\n灵源今夜月，依旧照苍苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈平夫归六溪","author":"徐熥","text":"送尔出关门，潮生野渡喧。\n离心数行雁，愁思一声猿。\n月暗迷前浦，林疏见远村。\n今宵灯影里，相忆倍销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乱后经电白县有怀故园","author":"徐熥","text":"一夜搀抢落，东南乍息兵。\n黄云依旧垒，白骨委孤城。\n八口蛮烟路，千家野哭声。\n故园残月影，偏向马头明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"樵川道中","author":"徐熥","text":"停舟当薄暮，古寺报昏钟。\n茅店斜临水，柴门半倚松。\n云萝催暝色，霜叶老秋容。\n片月飞清影，寒山翠几重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邓郡丞擢河东转运","author":"徐熥","text":"征马忽闻嘶，飞花趁马蹄。\n一官司斥卤，万里隔云泥。\n路入滹沱近，城连恒岳低。\n知君才驻节，名已震关西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟次小箬溪遇邵广文梦弼话别","author":"徐熥","text":"邂逅白云边，停桡一问玄。\n去沽桑落酒，来醉广文毡。\n月色催更柝，霜花压钓船。\n相逢俱逆旅，明日各风烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"剑津夜泛","author":"徐熥","text":"夕翠飞丹壑，葱茏色不分。\n神龙前代化，山鬼隔村闻。\n零露清残月，流星入断云。\n溪边高阁在，何处遇雷君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"度何岭忆家","author":"徐熥","text":"乡泪正纷纷，猿声到处闻。\n孤峰遥耸翠，怪石自成文。\n忆弟吟春草，思亲指白云。\n投繻向关吏，何意学终军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塔岭道中","author":"徐熥","text":"树老根盘郁，峰奇势不齐。\n单车穿宿莽，双巘夹清溪。\n古驿喧猿语，荒郊印虎蹄。\n王孙归未得，愁见草萋萋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仙霞晓发","author":"徐熥","text":"早起肃行役，寒威何太严。\n防身惟短剑，沽酒有长髯。\n故国山河尽，愁心日夜添。\n鸡声催出客，残月挂茅檐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"度西阳岭","author":"徐熥","text":"绝巘疑无路，披蓁雾里行。\n千寻皆鸟道，四壁半猿声。\n田父扶犁出，山僧倚锡迎。\n停骖聊买醉，霜月满孤城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟次龙丘遇尹光禄留饮赋谢","author":"徐熥","text":"黑发朝参懒，听松枕石眠。\n胸中才八斗，门下客三千。\n望气关常紫，挥毫草正玄。\n自惭同侣笑，休觅孝廉船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西湖立春","author":"徐熥","text":"春色薄城阴，东风到武林。\n暖回邹子律，病作越人吟。\n儿女他乡泪，莺花故国心。\n西湖有狂客，相对酒杯深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王百谷招饮半偈庵","author":"徐熥","text":"岁晚过吴市，飘零念此身。\n投君三指刺，醉我百壶春。\n名下无虚士，天涯有故人。\n相逢谈半偈，江上月华新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"毗陵舟中","author":"徐熥","text":"行行惊岁暮，孤棹滞天涯。\n远岸经桥合，寒流抱郭斜。\n何人分竹叶，无使寄梅花。\n苦为微名累，萧萧两鬓华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南徐除夕","author":"徐熥","text":"倚棹南徐下，燕山北望遥。\n客程犹未半，残岁只今宵。\n乡泪当孤烛，愁心逐夜潮。\n高堂有白发，何意向云霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扬子江望金山寺","author":"徐熥","text":"才过扬子渡，便觉气萧森。\n地势分南北，江流自古今。\n浪翻塔影动，云拥寺门阴。\n未惯风波苦，空馀涕泪深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漂母庙","author":"徐熥","text":"淮水流无尽，荒城古庙存。\n何人怜国士，老妪识王孙。\n虽有千金报，宁酬一饭恩。\n平生知己意，难与世人言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"任邱道中","author":"徐熥","text":"马足怯春霜，燕山路正长。\n生涯惭小草，离绪寄衰杨。\n白骨新邱垄，黄沙古战场。\n平安空有信，来往少同乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李惟实过集客舍","author":"徐熥","text":"击筑过燕市，逢君醉浊醪。\n龙门叨御李，虫刻愧投桃。\n岁月虚长铗，风尘暗大刀。\n可怜灯影里，相对两青袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出都门怀程五表兄","author":"徐熥","text":"献策不得意，呼童便束装。\n人皆悲失路，我独喜还乡。\n拓落嘲玄草，驱驰愧绿杨。\n归寻河朔侣，同擘荔枝香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游虎邱寺","author":"徐熥","text":"一棹过兰若，斋心礼法华。\n荒坟深踞虎，古木乱栖鸦。\n宝塔凌空迥，幽岩逗月斜。\n生公讲亭在，何处有袈裟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同吴之卫马云卿饮张幼于曲水草堂","author":"徐熥","text":"两度过吴市，今来得问奇。\n榻从花下设，人在竹间窥。\n座客皆黄发，先生自白眉。\n名园依曲水，芳宴共题诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谐赏园别顾世卿","author":"徐熥","text":"共醉尊中酒，惊看别后颜。\n神龙分剑浦，羸马出阳关。\n园似游金谷，人如行玉山。\n相逢又相别，空有泪潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"午日过江郎山","author":"徐熥","text":"车度蒙茸里，侵衣树色凉。\n土音闻越客，山色见江郎。\n萍梗悲游子，菖蒲忆故乡。\n龙舟何处竞，箫鼓断人肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至家","author":"徐熥","text":"故里经年别，今朝慰倚闾。\n关河空阻绝，岁月易居诸。\n燕麦埋荒径，莺花老旧庐。\n莫嫌金已尽，还有一囊书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"行脚僧","author":"徐熥","text":"何年辞故院，足迹遍云天。\n有寺皆投宿，逢人便结缘。\n木杯穷岁月，锡杖老风烟。\n人境元成幻，行藏总是禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"旱 其一","author":"徐熥","text":"入秋犹不雨，望已绝三农。\n处处忧豺虎，村村祭土龙。\n人情皆悯岁，天意岂乾封。\n米价腾如此，军储不罢供。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"旱 其二","author":"徐熥","text":"上天未悔祸，四野正皇皇。\n溪涧水亦涸，桔槔何处忙。\n诛求今正急，谁敢议开仓。\n苦乏谋生策，须求辟谷方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嵩山寺赠净上人","author":"徐熥","text":"古寺门空闭，青林紫衲僧。\n风传斋后磬，雨暗座前灯。\n经不念中品，禅能参上乘。\n夜深谈半偈，无愧佛图澄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"芝山寺逢游元封兼怀宗振","author":"徐熥","text":"当年曾一面，此夜遇禅居。\n乍见不相识，惊看鬓渐疏。\n阿咸元自达，痴叔竟何如。\n别后馀玄草，毋忘寄敝庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴","author":"徐熥","text":"入春才数日，春意满疏林。\n苔补阶前色，禽传竹外音。\n山容开晓霁，云气散轻阴。\n虚室无尘想，泠然物外心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访瀚上人","author":"徐熥","text":"遁迹芝山寺，长年不出龛。\n行深忘色相，客至但和南。\n传世灯千劫，随身经一函。\n无言即真意，禅理岂须谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"溪行晚眺","author":"徐熥","text":"溪上欲黄昏，潮平浪不翻。\n钟声云外寺，灯影水边村。\n荒坂牛羊下，前林鸟雀喧。\n桃花最深处，莫是武陵源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明客中寄惟起弟","author":"徐熥","text":"迢递京华路，风尘多苦辛。\n可怜三月暮，又负一年春。\n故里莺声老，天涯柳色新。\n孤灯风雨夜，忆汝倍伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同王玉生惟扬弟登剑州明翠阁因怀宗思兼先生","author":"徐熥","text":"高阁倚崚嶒，年来几度登。\n危栏紫野竹，怪石抱枯藤。\n上界空香坠，前山翠色凝。\n因思旧游者，望断白云层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王台驿","author":"徐熥","text":"古驿枕溪流，群山抱驿楼。\n滩声寒午梦，莺语动春愁。\n芳草王孙路，桃花渔父舟。\n白云与流水，相对共悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟行 其一","author":"徐熥","text":"空山驻夕阳，山色更苍茫。\n隔岸蘋花白，满汀芦叶黄。\n寒蝉抱树咽，金气侵衣凉。\n此际溪行者，能无思故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟行 其二","author":"徐熥","text":"舟行正暮秋，晚眺思悠悠。\n驿路当溪断，渔家傍竹幽。\n山阿全隐寺，石罅乱回舟。\n坐听寒溪水，潺湲日夜流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日同汝翔伯孺惟起集汝大山斋","author":"徐熥","text":"高斋秋气清，残暑坐来轻。\n竹外商飙度，松间天籁生。\n一杯桑落酒，千载薜萝盟。\n我辈疏狂甚，谁当嵇阮名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"剑浦得幼孺书","author":"徐熥","text":"别君经一年，迢递各云天。\n彼此有消息，全凭书札传。\n雁飞九峰外，梦到六溪边。\n把臂知何日，开缄空惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中迟陈道育不至","author":"徐熥","text":"幽斋啼暮禽，扶病自沉吟。\n孤烛当残夜，疏钟度远林。\n月窥松隙小，云闭竹房深。\n空有怀人意，杳无车马音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22958,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈元之刺史","author":"徐熥","text":"先生宗炳流，山水卧中游。\n隐矣能自适，澹然何所求。\n紫云当日梦，黄菊此时秋。\n投老六溪上，依稀如十洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22959,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慰陈振狂失钓艇 其一","author":"徐熥","text":"一夜秋江涨，闻君失钓航。\n声应停欸乃，歌忽罢沧浪。\n荻岸空残月，芦矶但夕阳。\n溯回知所去，宛在水中央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22960,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慰陈振狂失钓艇 其二","author":"徐熥","text":"枯缆何时绝，飘然叹断蓬。\n岂知渔父枻，翻作楚人弓。\n鹤侣今谁载，鸥群旧已空。\n中宵频起望，或有石尤风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22961,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慰陈振狂失钓艇 其三","author":"徐熥","text":"青钱费几缗，买棹作渔人。\n岸火焚孤缆，秋风罢钓纶。\n飘零疑海怪，去住听波臣。\n不返缘何事，君其问水滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22962,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁暮怀郑六初","author":"徐熥","text":"忽忽岁云暮，天涯客未还。\n梦回瓜步月，人隔秣陵关。\n驿路梅花瘦，空斋竹影閒。\n何时理归棹，相对说青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22963,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜坐","author":"徐熥","text":"空斋寒似水，独坐倍凄然。\n叶响林间雨，风声竹杪泉。\n应门双鹤睡，照佛一灯悬。\n暝色生萝径，飞来绝壑烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22964,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁尽","author":"徐熥","text":"范叔寒如此，其如复逼年。\n文章能作祟，吾道合迍邅。\n吏预催官税，门多索子钱。\n纵然贫到骨，不敢怨皇天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22965,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦雨 其一","author":"徐熥","text":"淫雨经旬月，蓬蒿掩敝庐。\n饥乌藏树杪，行蚁徙阶除。\n天意高难问，云游迹渐疏。\n山中蓑笠在，长日自挥锄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22966,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦雨 其二","author":"徐熥","text":"竟日云阴合，千峰雨脚连。\n田禾烂欲死，平陆溃成川。\n竹径坐来恶，蕉房听可怜。\n因之废栉沐，白日枕书眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22967,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦雨 其三","author":"徐熥","text":"九夏苦无雨，冬来何太繁。\n冥冥翻浪急，莽莽塞天昏。\n野服沾松翠，空墙绣藓痕。\n山斋幽寂甚，愁绪岂堪论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22968,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"约汝大汝翔振狂惟秦在杭藤山看梅 其一","author":"徐熥","text":"藤山梅万树，冬尽一齐开。\n粉面怀人瘦，香魂入梦来。\n翠微将失色，玉屑渐成堆。\n昨得花神檄，迟君共举杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22969,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"约汝大汝翔振狂惟秦在杭藤山看梅 其二","author":"徐熥","text":"梅坞馀残雪，疏枝冷不禁。\n去招梁苑客，同作灞桥吟。\n十里花为市，千家玉作林。\n慎毋披鹤氅，树里恐难寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22970,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同汝翔在杭看梅先宿芦中矶 其一","author":"徐熥","text":"雪后寻梅坞，芦中问钓矶。\n榻同陈仲举，诗得谢玄晖。\n朔气凝青幌，寒香动翠微。\n前林春色好，折得几枝归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22971,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同汝翔在杭看梅先宿芦中矶 其二","author":"徐熥","text":"白龙江上路，五里即梅林。\n暂借芦中宿，同谐物外心。\n清霜明竹屋，凉月坠花阴。\n姑射仙人梦，朝来不可寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22972,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"芦中矶晓起喜汝大惟秦至","author":"徐熥","text":"犬吠荜门前，遥惊石榻眠。\n携来双竹杖，穿破一林烟。\n袖出梅花谱，囊添曲米钱。\n岁寒盟不负，同醉白云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22973,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]