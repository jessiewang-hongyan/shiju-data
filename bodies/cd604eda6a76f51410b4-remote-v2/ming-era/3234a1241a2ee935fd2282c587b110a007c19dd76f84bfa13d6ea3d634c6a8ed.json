":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20199,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游弦歌台是尼父绝粮处","author":"佘翔","text":"栖栖陈蔡道何穷，此地今留俎豆宫。\n日暮平林天籁发，弦歌疑是鲁人风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20200,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登陈西城感淮阴事","author":"佘翔","text":"会陈万乘托南游，计縳功臣户牖侯。\n鸟尽弓藏何所恨，山东隆准薄千秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20201,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"经陈思王墓","author":"佘翔","text":"八斗相传绣虎才，路傍石马翳苍苔。\n洛神留得黄初赋，千载霓裳去不回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20202,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登苏子由读书堂","author":"佘翔","text":"镜中荷叶绿离离，夹岸如云杨柳枝。\n不见风流苏博士，高山犹自仰峨眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20203,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铜雀台怀古","author":"佘翔","text":"孤台突兀客初登，邺下山河感废兴。\n花似绮罗人不见，惟馀春草满西陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20204,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游仙曲","author":"佘翔","text":"曾伴仙人萼绿华，随风飞入上清家。\n别来欲寄金光草，海上青鸾隔綵霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20205,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上赵王 其一","author":"佘翔","text":"朱邸如云王气中，邺都形胜万年雄。\n自从汉室分茅后，带砺山河誓始终。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20206,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上赵王 其二","author":"佘翔","text":"君王乐善汉东平，几度褒章下玉京。\n端拱由来无一事，龙楼清夜望金茎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20207,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上赵王 其三","author":"佘翔","text":"桐叶分封不计年，汉家隆准更谁贤。\n小山却慕淮南道，招隐还歌丛桂篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20208,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上赵王 其四","author":"佘翔","text":"芙蓉池上擅风流，今代宗藩古帝州。\n借问西园飞盖夜，何人托乘月中游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20209,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄牛瑞卿","author":"佘翔","text":"梁园春事近如何，风雨池台入梦多。\n花压阑干三径好，求羊无日不相过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20210,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渡江","author":"佘翔","text":"岁暮天涯雨雪多，孤帆此去叹蹉跎。\n故园回首千山外，一片归心逐逝波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20211,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元妙观闻箫 其一","author":"佘翔","text":"月明仙院夜沉沉，鹳雀高巢古木阴。\n独坐西楼钟磬寂，玉箫吹起故园心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20212,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元妙观闻箫 其二","author":"佘翔","text":"扶藜笑指赤松家，踏破空中五色霞。\n缥缈何人吹玉笛，春风开遍武陵花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20213,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泗水逢雪","author":"佘翔","text":"泗水风生古渡寒，长途无?客衣单。\n鬓边忽点飞来雪，纵是瑶华不忍看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20214,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过蒙城","author":"佘翔","text":"漆园为吏傲当时，世远风流尚在兹。\n欲起斯人论物化，梦中蝴蝶许谁知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20215,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"风猛不得渡淮薄暮投宿","author":"佘翔","text":"朔风吹雪路漫漫，浪涌长淮欲渡难。\n今夜谁家堪寄宿，荒村犬吠一灯寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20216,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋得荆山玉示王汝存","author":"佘翔","text":"荆山一望气嶙峋，玉韫山中泣鬼神。\n莫怪陵阳当日泪，即今抱璞献何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20217,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丰县道中","author":"佘翔","text":"山东隆准起雄图，西望关中定帝都。\n见说枌榆遗社在，未央还属汉家无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20218,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏史赠薛生","author":"佘翔","text":"七雄争竞客如云，珠履三千未有闻。\n不是卖浆人掉舌，却秦谁趣信陵君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20219,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"为张大赠妓","author":"佘翔","text":"柳亸莺啼夕照间，黄金买酒醉红颜。\n双眉不用张郎扫，翠黛分明似远山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20220,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西苑 其一","author":"佘翔","text":"御沟流水出宫迟，花落花开春不知。\n惟有梁间双燕子，看人楼上斗腰肢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20221,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西苑 其二","author":"佘翔","text":"涵碧亭台蔽夕晖，渚花汀草静相依。\n青鸾自是仙家鸟，只在瑶池水上飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20222,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀徐大惊鸿","author":"佘翔","text":"新诗字字巧春蚕，堕马妆成白玉簪。\n我住三洲流水曲，几回子夜梦江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20223,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀长干恩公","author":"佘翔","text":"六朝梵刹半金陵，谁得头陀最上乘。\n雪里摊经花不著，文殊原是五台僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20224,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日即事","author":"佘翔","text":"东风吹雨昼生寒，独锁柴门午梦酣。\n花下衔杯拚潦倒，不妨人作酒徒看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20225,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日题林学士菊花园","author":"佘翔","text":"门垂五柳带閒烟，栗里风流屋数椽。\n人在南山秋色里，一樽醉杀菊花天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20226,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过钓台","author":"佘翔","text":"羊裘曾卧白云间，烟水苍苍去不还。\n回首云台俱寂寞，至今人说富春山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20227,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日题紫云楼 其一","author":"佘翔","text":"为爱元龙百尺楼，登临气压万峰秋。\n开尊醉杀青天月，一片银河欲倒流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20228,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日题紫云楼 其二","author":"佘翔","text":"海上群峰列翠屏，楼开霄汉德为星。\n翛然一笑天风起，织女机声入夜听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20229,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题白云楼有怀 其一","author":"佘翔","text":"槛外芙蓉插汉斜，登楼似驾五云车。\n夜来北望星辰近，欲向空中摘九华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20230,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题白云楼有怀 其二","author":"佘翔","text":"高楼上逼斗牛寒，何事伊人日倚阑。\n最是千秋堪洒泪，紫云山作白云看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20231,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题白云楼有怀 其三","author":"佘翔","text":"槛外千峰拥翠来，万家烟树望中开。\n主人不浅登楼兴，对月频倾绿酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20232,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题白云楼有怀 其四","author":"佘翔","text":"面面青山入画图，閒来与客醉屠苏。\n衔杯笑问楼居者，月里霓裳竟有无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20233,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题白云楼有怀 其五","author":"佘翔","text":"徙倚楼头望翠微，晴霞片片锁柴扉。\n醉来欲乞天孙锦，制就仙人五色衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20234,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题白云楼有怀 其六","author":"佘翔","text":"风流原不减孙山，百尺楼中日往还。\n笑满乾坤人不见，凤凰深驻白云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20235,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]