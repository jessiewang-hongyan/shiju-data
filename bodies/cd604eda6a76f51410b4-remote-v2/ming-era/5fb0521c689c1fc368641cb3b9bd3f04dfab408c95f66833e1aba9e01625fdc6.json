[{"title":"送陈稚登游南雍 其三","author":"孙继皋","text":"石头城下大江回，陵庙春深紫气来。\n彩笔动摇云五色，两都新赋待君裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20697,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中谣 其一","author":"孙继皋","text":"芙蓉湖边杨柳斜，家家啼鸟村村花。\n水面歌儿摇画舫，陌头游女渡香车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20698,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中谣 其二","author":"孙继皋","text":"参差楼阁映山开，往往舟船叠鼓催。\n树下花阴游子避，朱旗皂盖使君来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20699,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中谣 其三","author":"孙继皋","text":"黄公涧前春水声，碧山社里有啼莺。\n流觞按曲纵横坐，选胜探奇偪仄行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20700,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中谣 其四","author":"孙继皋","text":"船船击鼓与鸣锣，岸岸青帘紫障多。\n翻尽江南行乐曲，居人犹唱水荒歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20701,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春暮同朱光禄华鸿胪顾谢二徵君陈逸人泛五里湖","author":"孙继皋","text":"五里湖流棹绿芜，郎官千载事堪符。\n波连大泽回天镜，树罨青山坐画图。\n樯底莺声春欲尽，席边鸥侣暖相呼。\n遗荣不浅他年兴，乞得君王一曲无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20702,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同登宝界山绝顶望太湖","author":"孙继皋","text":"扶策登临到上方，重湖如练与天长。\n千年禹贡犹山泽，一带吴都是水乡。\n云汉几人骖鹤驭，风波无恙钓鱼航。\n春来大有浮家兴，回首飞蓬更渺茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20703,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立夏日同杨钱二孝廉浦进士黄公涧观泉遇王孝廉携美人文如文如擅新声赋十三韵","author":"孙继皋","text":"春归已昨日，宴赏未应休。\n以我能行乐，诸君总好游。\n暖宜裁白苧，晴不载青油。\n路爱云山近，溪连夏木稠。\n襟怀容啸傲，胜槩复清幽。\n逸兴纵横并，良缘邂逅投。\n中贤行浊酒，何客坐飞流。\n公子思黄歇，佳人命莫愁。\n柳疑回舞态，莺剧转歌喉。\n佩可同心解，花因比貌羞。\n桃源成误入，竹径许淹留。\n及暮犹持烛，乘风且放舟。\n当尊肯惜醉，转眼易逢秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20704,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏为元方送文如 其一","author":"孙继皋","text":"泪滴何如江水深，江潮来去日相寻。\n亦知不是长离别，其奈朝朝暮暮心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20705,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏为元方送文如 其二","author":"孙继皋","text":"沼花惟有荷花红，卿比荷花又不同。\n爱得花开将结子，再三珍重五更风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20706,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代文如答王郎 其一","author":"孙继皋","text":"欲上兰桡意转迟，别君生怕忆君悲。\n蘼芜一日阊门路，却似千山万水随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20707,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代文如答王郎 其二","author":"孙继皋","text":"雨雨云云不偶然，朝朝暮暮谢君怜。\n干行别泪堪成血，愁杀看花又杜鹃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20708,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四月朔日同浦进士蔡户部二年兄饮","author":"孙继皋","text":"今夜逢君话，相看鬓有星。\n三秋怀月桂，十载怅云萍。\n兴懒违簪笔，歌狂爱拊瓴。\n春风不待客，唯拟醉无醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20709,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陆华甫自新都归阳羡别业枉顾惠山","author":"孙继皋","text":"踏遍沧江一布衣，故人相见白头稀。\n身如陆羽尝泉至，家近张公指洞归。\n谷雨过时宜茗椀，松云长日在荆扉。\n逢君爱问山中事，尘世浮名有是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20710,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同王鸿胪顾进士杨王二茂才谭陆二徵君赏蒋氏杜鹃花甚盛因作短歌","author":"孙继皋","text":"濯锦江边杜鹃鸟，血泪声声啼不了。\n春魂化作江南花，花开如血流红霞。\n枝盘十层高一丈，自从何处移君家。\n我来欢赏日未夕，花下一时罗众客。\n翠幕朱阑兴不孤，金尊绿蚁倾须百。\n曾闻此花在润州，鹤林寺中天女游。\n重九之日忽烂漫，楚天失却寒云秋。\n仙葩异种何常有，阆苑蓬莱帝命守。\n俗杀人间桃李花，海棠睡足差可偶。\n向君高歌进君酒，一年三百六十日，几度对花开笑口。\n君如不饮更漏残，月落城头万杨柳，繁华易谢君知否。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20711,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古柏词寿虞母 其一","author":"孙继皋","text":"古柏森森护邑闾，风霜历尽影扶疏。\n共传寿母长年似，只恐贞心柏不如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20712,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古柏词寿虞母 其二","author":"孙继皋","text":"青桐为干石为根，万岁千秋此树存。\n生在南山深涧底，移来长傍北堂萱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20713,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古柏词寿虞母 其三","author":"孙继皋","text":"大树千年饱雪霜，无论地久与天长。\n新枝早已凌霄汉，还为君王起柏梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20714,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题秦茂才效云林扇景","author":"孙继皋","text":"远山疏树小亭孤，拓得云林烟景图。\n为问先生独往意，如今倘许画人无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20715,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四月十二日秦太学邀同赵吏部饮衍泽堂达旦坐有陈李二姬堂为余故读书处","author":"孙继皋","text":"城中何年赤虹起，秦氏一门被金紫。\n甲第云连两河峙，风流更见诸公子。\n我是金门老太史，亦有南宫少进士。\n予告同辞天上薇，得閒且采山中芷。\n秦君高堂绣文梓，秦君张筵列锦绮。\n折简相招意独勤，未曾下车先倒屣。\n银壶贮酒琥珀浆，玉盘行鲙金丝鲤。\n半酣解却罗衣起，起视当阶明月光。\n似闻芗泽氤氲至，忽报美人离药房。\n绿珠碧玉誇双艳，翠袖红裙一样装。\n夜如何其夜未央，合尊促坐醉不妨。\n低鬟浅笑初成目，小口新词欲断肠。\n一曲莺声慢，再曲梁尘乱。\n三曲天星坠如雨，鹍鸡不闻日已旦。\n主人无用独留髡，深杯在手业无算。\n童仆不嗔但顾笑，昨日客来今日散。\n日出易暮暮易晨，谁将绿鬓驻青春。\n请思窗下同君读，转眼今为十载陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20716,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林御史筑堤成有纪","author":"孙继皋","text":"儆予连岁轸皇情，四载亲劳使者行。\n芜草晴搴堤势固，麦苗春秀水痕平。\n东南载起全吴命，上下仍输大禹征。\n闻道河渠书已就，定知深计为苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20717,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"载酒山中招沈太史庄黄俞三山人安太学向王二茂才祝王二徵士饮分韵得流字","author":"孙继皋","text":"青云李郭几同舟，天禄曾经与校雠。\n长为故人愁岁晏，偶逢词客尽风流。\n閒居落魄耽杯蚁，畏路关心羡海鸥。\n独向交游仍意气，感君畴昔脱吴钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20718,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中送沈太史不及","author":"孙继皋","text":"萍踪太无定，去去复何之。\n风雨舟难上，乾坤路总疑。\n采芳愁远道，视草忆同时。\n怅望成轻别，空吟伐木诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20719,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中饮钱惟一小斋","author":"孙继皋","text":"一室晤言好，谁为覆手炎。\n宦清贫亦得，交澹贵无嫌。\n单裌春风换，深杯夜雨淹。\n频过吾望汝，次第检牙签。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20720,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送施屿南比部恤刑畿内","author":"孙继皋","text":"金科玉节去翩翩，多少衔情拜马前。\n明主自亲三辅地，使君身是万人天。\n几回丙夜停丹笔，合有阳春曜紫渊。\n预想平反偏称旨，垂衣风动四方传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20721,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"入山有感仲山师隐居","author":"孙继皋","text":"夫子传经日，何人不及门。\n云从绛帐隔，空此青山尊。\n源正河汾广，春深桃李繁。\n谁寻各言志，感遇共酬恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20722,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中怀友人","author":"孙继皋","text":"十年叨禁近，梦落五湖边。\n此日山中住，居然静者缘。\n清阴花覆地，大壑树参天。\n却忆同怀子，萋萋生暮烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20723,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中 其一","author":"孙继皋","text":"山中无栋宇，小屋但诛茅。\n境僻人烟少，林深虎迹交。\n暗泉通石窦，炎日避松梢。\n寂寞元吾事，披襟诵解嘲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20724,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中 其二","author":"孙继皋","text":"渡湖山色好，此路即沧江。\n避世谁知汉，居人或姓庞。\n岩花鲜亚石，水竹净当窗。\n采药兼垂钓，长容系小艭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20725,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观稻","author":"孙继皋","text":"仲夏山中来，山田才插秧。\n今来凉风至，稻苗舒且长。\n借问田间叟，岁倘在金穰。\n田叟前致辞，皇天德难量。\n自从东作齐，不悭水与浆。\n车床卧东壁，车斗閒前场。\n稂莠既已除，螟蟊亦潜藏。\n瀰瀰平畴绿，郁郁遥相望。\n再过八九日，午风稻花香。\n消长理庶有，救此连岁荒。\n感君殷勤问，为君竭中肠。\n不愁无佳谷，数口亮不妨。\n但恐刈未了，催租吏下乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20726,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中七夕口号","author":"孙继皋","text":"七月七日天气凉，一年一度双星翔。\n城中女儿斗佳节，齐洁瓜果薰衣裳。\n深深祠拜何夭姣，乞向天孙赐馀巧。\n去年针眼线皆穿，今年穿线还多少。\n争怜竞巧望天河，桥沉驾去怅如何。\n湖滨野人拙不避，僵卧空床掩薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20727,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鼋头渚游眺同蒋文学王茂才","author":"孙继皋","text":"渚势欲吞湖，湖流归旧吴。\n天浮一鼋出，山挟万龙趋。\n浪急悬厓动，风颠系艇孤。\n持竿堪此地，渔钓本吾徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20728,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中 其一","author":"孙继皋","text":"山中栽松树，山下种荷花。\n荷芳映绿水，松老蟠青霞。\n徙倚结幽想，攀折惜年华。\n上山复下山，日暮未还家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20729,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中 其二","author":"孙继皋","text":"朝朝上山去，不记山中路。\n偶逢樵采人，言从石梁渡。\n信策入孤云，鸟归西日暮。\n下山不见人，长歌抚松树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20730,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘昆山以重九日举子贻此为贺","author":"孙继皋","text":"县斋秋色照悬弧，梦里熊罴悦自符。\n昆岫故应辉片玉，冰壶今见出明珠。\n高阳裔远繁芳芷，九日人生系紫萸。\n君是慈君谁不颂，新谣并入凤将雏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿朱芹溪","author":"孙继皋","text":"家住梁溪上，门前野水回。\n但知芹菜美，不记桃花开。\n渐老垂玄发，逢人倒绿醅。\n年年春宴罢，云里鹤飞来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题一竹卷","author":"孙继皋","text":"会心不在远，寄兴不在多。\n寒窗一个竹，岁晚奈君何。\n日出凤飞来，夜深龙化去。\n无言一竿小，托根得其处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陆文学北上应举","author":"孙继皋","text":"马首春云片片繁，送君北上帝城尊。\n文齐二陆才人后，家表三吴孝子门。\n游向月宫新侣得，贡升天府旧名存。\n长安风物应如昨，次第清朝好拜恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答刘子玄孝廉 其一","author":"孙继皋","text":"以我趋朝日，逢君待诏年。\n大名时辈避，高唱国人传。\n往迹浮云散，离心乱柳牵。\n书来足慰藉，犹隔孝廉船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答刘子玄孝廉 其二","author":"孙继皋","text":"君昔罢公车，余寻下石渠。\n云天不可望，月旦近何如。\n薄宦堪中隐，明王好子虚。\n殷勤卒大业，青鬓莫令疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答刘子玄孝廉 其三","author":"孙继皋","text":"别来频岁换，书到及春寒。\n落月劳相忆，因风劝强餐。\n寸心国士尽，端绮美人看。\n廷荐吾惭汝，儒冠何处弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿李惠峰文学八十","author":"孙继皋","text":"曾奏贤能不受官，风云无意托高翰。\n犹龙自昔元尊李，非虎人今未离磻。\n老去江湖双屐远，醉来天地一杯宽。\n长生何用求丹诀，三月桃花岁岁看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱竹","author":"孙继皋","text":"亦是檀栾池上枝，何缘殊色污胭脂。\n轻阴却讶繁红藉，劲节难随大绛移。\n结实定为朱凤食，腾空堪作赤龙骑。\n多应血染湘妃泪，赋客梁园总未知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱郡理入贺万寿","author":"孙继皋","text":"千里朝天羽骑催，龙旂夹向殿门开。\n中秋月过呈金镜，大海潮生献玉杯。\n呼彻嵩高元老赞，宴分宫禁近臣陪。\n因君百拜瞻双阙，曾是云霄侍从来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少沂曾丈惠书云阁诗次韵酬之","author":"孙继皋","text":"幽栖早与世情疏，岂有才名耀石渠。\n爽气自来支笏后，玄心偏会报钟初。\n高天好去骑黄鹄，大海何当钓白鱼。\n彩笔劳君频问讯，新诗已付赫蹄书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和曾少沂泊舟绿萝庵韵","author":"孙继皋","text":"明月蛾眉若个边，怜君归思在秋先。\n官程半借祇园树，客梦长回栈道烟。\n入眼花枝何冉冉，留人燕子故翩翩。\n终知沈陆成高隐，不羡金貂满座蝉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王大行起家北上","author":"孙继皋","text":"杨柳尚堪折，挂帆秋色过。\n长悲读礼尽，专对诵诗多。\n拜阙仍持节，趋朝及赐罗。\n槎浮吾忆汝，夜夜望星河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠田司榷","author":"孙继皋","text":"弃繻君自少年人，持节今看控大津。\n河上帆樯千里色，关前草树万家春。\n恰怜西望青山好，可有东来紫气真。\n归奏明光知不远，肯言精算尽商缗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过成山人因赠","author":"孙继皋","text":"席门君自掩，乘兴一相过。\n老去才名大，人来问字多。\n巷深秋草长，城近午烟和。\n贫贱閒身得，无劳学醉歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湖心亭坐月","author":"孙继皋","text":"湖心亭子里，客到月初来。\n杨柳秋先落，芙蓉夜倒开。\n醉疑凌袜去，梦想弄珠回。\n渺渺波千顷，临流诗可裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大佛头寺","author":"孙继皋","text":"香阁俯清泠，禅扉静不扃。\n云连天目紫，山对佛头青。\n雁聚秋成塔，龙降昼听经。\n下来湖日晚，飞磬杳冥冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西湖杨柳枝词 其一","author":"孙继皋","text":"西湖十月烟水平，游船两两趁风轻。\n不知春满桃花岸，多少女郎连袂行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西湖杨柳枝词 其二","author":"孙继皋","text":"西湖十月暖风吹，游客乘船醉不辞。\n日落波停山掩黛，却怜西子罢妆时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西湖杨柳枝词 其三","author":"孙继皋","text":"湖边无数古禅林，尽是游人与布金。\n日晚西山钟磬发，随风远近到湖心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西湖杨柳枝词 其四","author":"孙继皋","text":"江南十月早寒催，杨柳千条叶半摧。\n閒杀六桥堤上路，月明不见踏歌来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清湖道中晓起即事","author":"孙继皋","text":"早起看江色，多愁雾雨侵。\n水容清照鬓，萍梗暗伤心。\n旅食赍粮远，人家绕树深。\n双鸥尔何意，飞傍一浮沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江行 其一","author":"孙继皋","text":"风色挂帆好，舟人倚棹歌。\n江光如绿酒，不饮奈君何。\n树密全浮嶂，鸥翻恰趁波。\n此方居可卜，吾欲问渔蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江行 其二","author":"孙继皋","text":"不作南游计，那知远客情。\n滩争水碓疾，风叠布帆轻。\n地势连闽越，山容幻雨晴。\n行行殊未已，烟树总前程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江行 其三","author":"孙继皋","text":"遵江泛轻舸，江浅挽仍推。\n帆影流云度，滩声骤雨来。\n川原寒自澹，钲鼓暮相催。\n借问天边雁，南飞几日回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代内","author":"孙继皋","text":"君昔游长安，侬记长安路。\n君今问闽天，闽天何处度。\n在家夏日短，出门冬日长。\n雨雪难预期，谁为添衣裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答","author":"孙继皋","text":"南行江水清，不比渡黄河。\n青山两厓间，隐隐轻舟过。\n去时挽逆流，且喜东风便。\n归来水应驶，无风好放船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"旅怀","author":"孙继皋","text":"不见闽天路，依稀度越乡。\n心将潮共折，身与雁俱翔。\n渐远方言异，多愁客鬓苍。\n况逢桑梓暮，回望思何长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五月砧声 其一","author":"孙继皋","text":"清砧切切捣更残，葵叶榴花不忍看。\n昨夜潇湘风雨恶，闺中五月已先寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五月砧声 其二","author":"孙继皋","text":"日长无意理金徽，夫婿从军不暂归。\n关塞路遥人最远，伤心五月捣寒衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五月砧声 其三","author":"孙继皋","text":"暮砧声断火云收，力尽深闺泪暗流。\n谁道玉门寒信杳，妾心何日不如秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题清湖主人壁","author":"孙继皋","text":"溪浅石可渡，山程问主人。\n淹留愁雾雨，飘泊动星辰。\n岚气当楼入，乡音逐路新。\n吾生原旅寄，?付酒家缗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]