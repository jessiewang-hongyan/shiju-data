[{"title":"杨参仁甫招至东麓亭上","author":"李舜臣","text":"幽栖半岭白云生，曲磴随岩碧蔓萦。\n阁上晴光连御柳，城中流水带山楹。\n凭栏历历群峰出，种竹萧萧一院成。\n不似邀欢为地主，独能选择此来行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4997,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送秦凤山尚书致仕归无锡","author":"李舜臣","text":"如闻珍重疏閒情，为遣安车遂晚荣。\n海上青山归旧隐，篱边黄菊待遄征。\n衣冠愿谢明时事，功德长垂君子名。\n无限观人多下泪，追攀不复驻高旌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4998,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙申至日太学斋居和费钟石侍郎喜晴次韵","author":"李舜臣","text":"竟夕阴云掩太清，高斋寥廓对松声。\n长风忽送银河出，倒月能翻壁水晴。\n夹路旌旗凌海日，中宵星宿带坛灯。\n为欢天意成禋祀，一曲真堪答圣明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4999,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"内兄来自松江留宿鸡鸣山舍","author":"李舜臣","text":"一别清扬那更攀，相思只上对门山。\n山中乱木愁仍剧，海上归云梦几还。\n自尔惊人生白发，聊因为客慰离颜。\n一尊虽复同明月，恐是来朝东出关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5000,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"费钟石侍郎宅宴集用联句韵奉酬一首","author":"李舜臣","text":"敢拟文星聚此宵，春来冠盖忝相招。\n不妨四坐随佳会，实托群公在本朝。\n华烛光中清漏滴，玉箫声外綵云飘。\n新诗字字归能咏，曾比鸣球尽可敲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5001,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送傅光禄朝晋赴京","author":"李舜臣","text":"都门清雅古来名，复此微官托俊英。\n南陌联镳常日得，西郊别袂片时轻。\n春帆处处江花落，寒食朝朝山雨生。\n无限垂杨堪系缆，临流且为一尊倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5002,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送傅御史归省","author":"李舜臣","text":"江汉滔滔制节繁，榴花五月映归轩。\n身边凤字供亲寿，阶下骢鞍荷主恩。\n杖屦旧称君子德，诗书今并母仪论。\n东南若到称觞日，定有葱烟上里门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5003,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钱给事出守袁州钱旧南昌推官","author":"李舜臣","text":"载笔洪州日月迁，至今歌颂四明贤。\n乙明自悔春田讼，伯起如多夜馈还。\n锁闼移官仍楚俗，褰帷行县亦章边。\n道途若问新为守，应有人传佐郡年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5004,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题陈司封荣寿瞻思卷","author":"李舜臣","text":"浙水吴山产独奇，为郎宰府众人推。\n皇恩并录三迁日，爱子忻承七帙时。\n阁上龙章多气色，尊前象服有威仪。\n还闻常为称觞罢，永痛游仙更一悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5005,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴郎中母挽诗","author":"李舜臣","text":"独乘鹤驾去安之，俪美高堂彼一时。\n总角图诗多自授，荐筵蘋藻尚人知。\n河山百里天书映，邑井千年母德垂。\n惟有沾襟身贵后，大夫无日不亲思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5006,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈给事赴京陈绍兴人","author":"李舜臣","text":"明时台谏道俱申，琐闼留朝讽议臣。\n补衮宣年多志意，探书禹穴旧经纶。\n江城日出青山合，海路云生采鹢新。\n共送晨风来祖席，依依应恋玉为人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5007,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鸡鸣山望玄武湖","author":"李舜臣","text":"金陵天下险，兹山在北门。\n凭高览八极，夕阳满平原。\n杂花落岩树，大江正东奔。\n馀流注为泽，春水何其繁。\n洲岛列相望，凫鹭鸣相喧。\n波光静可鉴，照影群山翻。\n千年寄歌舞，百里滋兰荪。\n时时出云雾，长添王气存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5008,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题","author":"李舜臣","text":"茵席沟渠各所宜，巧耶有道得如斯。\n平生正不人怜受，岂有乌头变白时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5009,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江西送陆参赴陕西右使陆旧讲官","author":"李舜臣","text":"江头频送客，此日复君行。\n望里青山合，尊前采鹢明。\n秦川遥问俗，宣室旧知名。\n闻有甘泉赋，雄情待是成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5010,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梦","author":"李舜臣","text":"万里临淄路，顷缘梦里看。\n村居还昨似，树色正冬残。\n道旧过亲友，怜余勉饭餐。\n忽然疏竹雨，催觉曙衾寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5011,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贡院桂花","author":"李舜臣","text":"秋风凋众叶，桂树晚应开。\n几日空深院，清香伴碧苔。\n拂衣人共觉，移席雁初回。\n念独能为客，看花是再来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5012,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日雪集和张宪使子鱼","author":"李舜臣","text":"客偶高堂集，春初上国还。\n一尊仍对雪，众喜或丰年。\n落处花枝重，融时草色鲜。\n最难君是唱，终和未能妍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5013,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十四夜藩省宴集","author":"李舜臣","text":"薇垣看月上，兹夕已婵媛。\n楼度庭初满，灯张市渐諠。\n寒花滋露发，火树映星翻。\n几似今为乐，笙歌倒一尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5014,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十五夜都司宴集","author":"李舜臣","text":"月迥光无缺，星寒烂已施。\n百枝张幕色，万舞任渠为。\n激壮军中曲，纵横坐上卮。\n高朋复佳节，聊得此追随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5015,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十六夜滕王阁宴集","author":"李舜臣","text":"怜此光犹满，迎曛阁已开。\n江摇银汉动，山度紫烟来。\n万火纷南陌，层楼逼上台。\n凭栏无限好，应约早春杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5016,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮赵佥子玉别署","author":"李舜臣","text":"缘陪众君子，飞盖偶能来。\n暝色稀人吏，高堂命酒杯。\n月明花露泫，秋晚竹风回。\n无限相逢意，羁愁为一开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5017,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"近郊宴集值雨","author":"李舜臣","text":"出谷旌旗转，缘江鼓吹来。\n异方多胜览，春色复相催。\n野旷风生竹，山青雨映梅。\n惜无今夜月，留酌踏烟回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5018,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湖上","author":"李舜臣","text":"望极东湖水，春来益可怜。\n长堤回草色，斜日澹波烟。\n窈窕鸥双下，逶迤渚自连。\n何当呼小艇，相与出潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5019,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卧起","author":"李舜臣","text":"簿书时复暇，聊得掩晴闺。\n卧觉衾犹薄，行来鸟正啼。\n药畦深石畔，花径绕亭西。\n在远心常惬，春兼事事齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5020,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陆副使罢归吴江","author":"李舜臣","text":"吴下能文者，明时复陆机。\n偶逢章水上，已拂早春衣。\n啼鸟晴相和，归云晚竞飞。\n倾都人正惜，君去掩山扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5021,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将按饶州","author":"李舜臣","text":"正好秋蓬似，因风转未休。\n世途轻宦拙，儿女别家愁。\n庭次梅初吐，江南橘再收。\n蒹葭何处夜，今去泊孤舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5022,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风阻涉湖复指进贤","author":"李舜臣","text":"始拟残年棹，如闻震泽平。\n轻帆虚水色，揽辔复山行。\n出郭风扶毂，穿林雾濯缨。\n不辞遥役去，霖潦此纵横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5023,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"进贤晓发","author":"李舜臣","text":"道路北风发，飘飖吹我行。\n他乡换双鬓，残岁转孤旌。\n夜雨草根活，晨晖山色明。\n经过从候吏，杂树识方名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5024,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阅武","author":"李舜臣","text":"晨烟万突杂郊氛，遥逐肩舆阅一军。\n云薄寒城旌外涌，江鸣远树坐中闻。\n人多猿臂堪擒敌，马或龙媒乍不群。\n归路徐看衰柳色，似缘钲鼓片时欣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5025,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庭中植有红梅偶过李参兼有红白二种因简","author":"李舜臣","text":"南州十月桂枝荣，小院梅开近亦明。\n色借紫云凌雾薄，香滋玉露入宵盈。\n客怀聊得尊中遣，诗句应能树畔成。\n天府兼如瑶萼发，从君临赏倍含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5026,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宪使张子鱼馈鱼","author":"李舜臣","text":"入门双鲤濯苍鳞，知是君分与故人。\n钓得云逢缄素遣，将来应比错刀新。\n初晴雪色融斜日，半吐花芳报早春。\n安得烟波还此去，正怜杯水叹吾频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5027,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早春贡院宴集弋阳王遣伎咸至","author":"李舜臣","text":"江城郁郁朝常雨，溪馆泠泠雾始开。\n地僻经冬封绿藓，春来随处接金杯。\n莺声管吹如相妒，竹色波光倏尽回。\n纷屡中庭方万舞，兼能分赏片时来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5028,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"亭上","author":"李舜臣","text":"高亭独坐怯馀寒，渐已晴晖转画阑。\n杨柳总归湖外色，梅花宛似雪中看。\n疏池种竹随春事，散帙挥毫亦暂欢。\n回首故人微禄在，惟应拙薄自江干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5029,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同诸公贡院小集","author":"李舜臣","text":"最宜南陌静缁尘，况复高城过雨新。\n夹路啼莺歌似响，一春踏草到应频。\n侵苔薜荔萦初蔓，隔水衣裳挂满筠。\n无限夕阳堪共醉，明朝世务恐牵人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5030,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨","author":"李舜臣","text":"南中一雨动成霖，湖上春云几日阴。\n似妒花开能烂漫，全滋竹色使萧森。\n阶寒水濯繁苔出，地僻烟封省树深。\n异域应常怜病骨，兹晨聊得散幽襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5031,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东轩对雨","author":"李舜臣","text":"长风吹雨过东园，炎德驱无五月繁。\n坐对遥山烟乍合，正怜高鸟湿能翻。\n微官垂白空双鬓，久客耽幽稍一轩。\n栏药盆花看益好，已多停水蕙兰根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5032,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贡院池上","author":"李舜臣","text":"江城此地独知名，试共寻幽处处行。\n选得松根千树合，移来水面各言清。\n娟娟隔径明丹实，袅袅当波出翠茎。\n未便观鱼好垂钓，从渠窥客去来轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5033,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宴都司樟树下","author":"李舜臣","text":"幕府樟阴几亩垂，将军绮席肯阶移。\n分明翠湿添杯酌，竟夕清吟杂管吹。\n乌鹊堪轻三伏雨，青霄不碍万年枝。\n还须满月情何似，纵卜今宵露那知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5034,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陪在滕王阁饯客","author":"李舜臣","text":"共追使节到潺湲，为复登楼在别筵。\n近槛不胜游子意，当杯祗觉众人贤。\n秋风磬折终谁是，竟日笙歌亦自妍。\n正忆陶潜初便去，那曾束带小儿前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5035,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬李伯华寄书","author":"李舜臣","text":"忽惊平楚万山秋，稍喜行台此地优。\n白石青松逢处是，危亭曲阁坐来幽。\n一春种药供多病，方寸忘机减独愁。\n能枉遥书霄汉上，相从同作豫章游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5036,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙未中秋","author":"李舜臣","text":"一从系缆迈流光，再见高楼满月凉。\n总为婵媛偏此夕，不知留滞尚他乡。\n团团草露清难似，细细萝烟袅乍长。\n行色欲依河汉曲，待看瑶采度微茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5037,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈都御史致仕陈苏州人赣州巡抚 其一","author":"李舜臣","text":"记曾颜色望青霄，此地逢迎斧钺飘。\n下邑祗传安石在，南中空惜去旌摇。\n云连浦树明秋野，水浸江沙落早潮。\n他日虎丘问耆旧，清时龙德独逍遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5038,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈都御史致仕陈苏州人赣州巡抚 其二","author":"李舜臣","text":"求贤诏许尚岩阿，今复东还且奈何。\n终属陶潜三径有，真嫌刘宠一钱多。\n江间绿水明心曲，海上青山著鬓皤。\n处处秋兰犹自好，扁舟采揽足经过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5039,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈都御史致仕陈苏州人赣州巡抚 其三","author":"李舜臣","text":"几人勋德在明时，南纪公来偶视师。\n谁使中军生气色，独筹前箸卧旌麾。\n岘山有泪堪常堕，章水无情任所之。\n辽海只今忧未浅，不当还出佐支离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5040,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病怀","author":"李舜臣","text":"吾生蹇拙合微名，无奈侵寻病所婴。\n南国炎蒸今再过，中秋医药尚无情。\n苔残白石庭阴合，木落苍阶露气清。\n门外江澄闻练似，犹多虚负片帆轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5041,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瑞州寄别陆使迁广东左使","author":"李舜臣","text":"西来每忆城隅别，左省初闻岭外真。\n倚望长天遥赐玺，叨陪往日得驱轮。\n春风祖席群公出，江阁楼船几鹢新。\n昏见渐南星独迥，晖晖应为紫垣人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5042,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五老峰","author":"李舜臣","text":"群仙赤霞佩，谒帝青霄通。\n倏过昆崙颠，八荒逝安穷。\n庐山偶回首，沧海蓬莱宫。\n须臾酌彭蠡，还驾来时鸿。\n高高去无极，遗迹兹巃嵷。\n遂为万仞石，削壁凌苍穹。\n盘回万岩壑，湖上峰独雄。\n朝云变紫翠，旦夕飞轻虹。\n寒暑岂不化，芝草四时红。\n昨出江州道，天地览斯崇。\n仿佛见揖手，招客令予东。\n感此结深意，夜寝烟山空。\n忽若乘风下，怡然数老翁。\n把臂一共笑，千年始相逢。\n梦中忆所授，病后扶衰躬。\n复从碧涧侧，倚望瑶华丛。\n极愿捐微禄，致身与之同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5043,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吉安谒文山公祠公孙生员熙出公遗翰因示","author":"李舜臣","text":"宋道昔云季，戎马摧中州。\n独公历万死，感慨当时谋。\n庐陵在南域，冠盖元名陬。\n嵯峨瑞华出，浩荡螺川流。\n富田馀揖让，夙昔公园丘。\n荒山辟祠舍，生气谁为收。\n飞桥驾长虹，松篁罗道周。\n凉飙却炎暑，好鸟鸣未休。\n哲孙出遗翰，忽若苍龙游。\n鲁公称妙绝，惟此真其俦。\n护持属山灵，栋宇终天留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5044,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒文山公祠道中作","author":"李舜臣","text":"在远日多思，钦贤夜忘寐。\n缘与簿书辞，况复郊原遂。\n野旷宜风生，山深似云戏。\n临流缨欲濯，出谷衣全翠。\n顾兹难久留，拘迫惭为吏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5045,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将按九江泊石头口","author":"李舜臣","text":"江阁远犹雄，江流澹若空。\n晴沙行白鸟，缺岸出青枫。\n野泛清秋色，山回落日风。\n真同渔父宿，亦在钓矶东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5046,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃花山","author":"李舜臣","text":"岩随茅屋过荆扉，水落溪田刈稻稀。\n赤坂度山泥滑滑，青松出谷雾霏霏。\n寒帷北下聊吾事，逐禄南中亦昨非。\n稍喜云开还在眼，香炉石耳自晴晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5047,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"德安道中","author":"李舜臣","text":"蔓草垂藤引使车，石田流水带人居。\n清秋不落丹岩树，薄午方缘白石渠。\n谷口鱼梁旌旆转，山中萝径牧樵馀。\n为应问俗迟迟去，才可尘烦渐渐疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5048,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"圆通寺","author":"李舜臣","text":"百里庐山胜独寻，山山林壑带秋阴。\n微风夹路参差见，竟日娱人紫翠森。\n稍讶飞轩行树杪，忽看削壁入云深。\n幽居谢尔为僧在，清磬时时物外心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5049,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾未识李空同先生每读先生诗且官渠后钦其为人过圆通寺悬多诗刻而僧独取先生者有静言看石耳之句石耳峰名庐山佳处","author":"李舜臣","text":"先生是在武皇年，彩笔沧江动远天。\n僧徒亦识山中字，学士今传邺下篇。\n当日鸣泉邀节钺，清秋高阁自云烟。\n谁令流落明时去，石耳空知炫独妍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5050,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿东林寺 其一","author":"李舜臣","text":"谷转还青峤，烟扶下赤坡。\n秋山凋叶少，暝径咽泉多。\n旧迹馀溪沼，深斋到薜萝。\n更邀明月上，徙倚辨嵯峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5051,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿东林寺 其二","author":"李舜臣","text":"山寺忽云端，山行处处欢。\n晚凉岩际宿，秋色月中看。\n缓步多幽壑，清声即近滩。\n苍阶疑露湿，瀑水堕空寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5052,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"发东林","author":"李舜臣","text":"东林千载后，尚种芙蓉池。\n出门见初日，夹路云烟随。\n深谷忽无极，洒峤泉奔驰。\n潺潺碧涧吞，袅袅垂猿枝。\n微风动幽响，万壑清秋时。\n长林郁光景，竹树何参差。\n苍茫虎溪路，故蹊不可窥。\n前山复回合，度岭扬旌麾。\n恍若乘风翔，果与丹霄期。\n杂花半岩上，草露团葳蕤。\n雄蟠三百里，奇峰方在兹。\n峥嵘乍可望，浩荡今晨思。\n登游能累宿，肯负幽人姿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5053,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月八日始闻雁声","author":"李舜臣","text":"东山常八月，夜夜雁归声。\n何至江州听，方多菊露清。\n倚檐长送尔，远道总关情。\n不问都门过，知无系帛轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5054,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九江分司对雨","author":"李舜臣","text":"偶出庐山下，轻云随盖飞。\n度河为暝色，洒雨满秋扉。\n细细从东至，森森洗竹晖。\n捲帘入苍雾，还寝更絺衣。\n渐夕阶生溜，群峰势乍稀。\n江流何震荡，鸿雁亦来归。\n是月黄花节，清宵玉露挥。\n高城恐寂寞，滋菊使芳菲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5055,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日","author":"李舜臣","text":"佳晨烂漫隔篱枝，水国烟霜落木时。\n百里庐山堪胜绝，三秋鸿雁独归迟。\n肩舆尚尔行花县，戏马应渠载酒卮。\n止饮经年还肺病，萧条一任北风吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5056,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九江分司九日刘副使见过","author":"李舜臣","text":"遥水楼船拥节旄，明公斧钺静江皋。\n为逢雁度俱今日，肯假霜威过浊醪。\n手里黄花清露满，城隅白浪暮天高。\n出门历历明星在，指点秋河到玉镳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5057,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九江李主事招至洗心亭上时同刘副使在坐","author":"李舜臣","text":"江流雾敛自晴川，江阁秋深况绮筵。\n幔卷微风添坐色，阶含溅水倍花鲜。\n当歌浪鼓蛟鼍夕，隔岸山摇竹树烟。\n李白刘桢应逸兴，时时能此共潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5058,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将发九江","author":"李舜臣","text":"啼鸡催晓发，度雁倏秋深。\n自是羁怀甚，兼多草际吟。\n风清山易冷，月落阁还阴。\n木叶兼江浪，方添隐几心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5059,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]