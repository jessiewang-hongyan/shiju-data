[{"title":"中秋夕招智公入社","author":"韩上桂","text":"尝时对月每思僧，君是僧家老惠能。\n破衲补成花褐暖，芒鞋踏遍碧峰层。\n弥天鸾鹤从栖树，大地琉璃不用灯。\n驴背好诗今有几，啸声还记虎溪曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23494,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饮霍仲斌宅","author":"韩上桂","text":"高堂酒尽兴仍添，彩笔凭陵且竞尖。\n半壁藤萝萦作蔓，一庭花树亚相兼。\n囊馀将略谁遗剑，架有侯书尽着签。\n坐久不知更欲下，出门回首月纤纤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23495,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏赠张约之","author":"韩上桂","text":"芙蓉叶底碧兰芳，君住人间独胜场。\n最好吟时秋月白，偏宜望处野云黄。\n閒将涧水调新茗，静读丹经爇宝香。\n彩笔近闻工刻画，有人梦里忆张郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23496,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄与东新筑","author":"韩上桂","text":"新开堂构近城东，短桷疏楹太古风。\n郭内恍含丘野趣，宅边遥结桂林丛。\n如藏邺架签休着，若仿玄经易可通。\n为报春来双白燕，依栖应许傍帘栊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23497,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠黎君选君献","author":"韩上桂","text":"岭峤文章万丈悬，君家占去已多年。\n偏嗔老凤争先起，犹怪双雏逐后翩。\n灵运池塘知有梦，平原騑服几存篇。\n何因得与吟坛末，月照媸颜亦获妍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23498,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饮梁石楼明府西园","author":"韩上桂","text":"云去云来总不知，窗前列岫静难移。\n不须白眼骄人世，看取青丝映酒卮。\n百鸟可能供和曲，群花亦解助成诗。\n同游上客俱名彦，幸订芳辰肯独迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23499,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同刘觐国民部过苏汝载芘隐楼五石斋","author":"韩上桂","text":"芘楼小隐旧相求，此日停车兴倍幽。\n剩有一床容偃卧，更馀五石任迟留。\n壁间蠹简吾将老，海内苍生尔独忧。\n辛苦山涛能雅量，暂从嵇阮故林游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23500,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"呈谢大方伯太蒙王公四首 其一","author":"韩上桂","text":"方岳高临佐命悬，罗浮屹峙镇南天。\n公从间气钟名世，人自雄藩识重贤。\n一柱力回涛势急，寸心长映日华鲜。\n金瓯完好知无极，回首宸都颂圣年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23501,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"呈谢大方伯太蒙王公四首 其二","author":"韩上桂","text":"民力东南亦已微，频年榷采事仍非。\n幸逢轸辖能流照，会见棠阴有所依。\n翠羽肯疲重驿贡，珠光从傍故池辉。\n膏苗转慰三农望，岭峤春深草木肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23502,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"呈谢大方伯太蒙王公四首 其三","author":"韩上桂","text":"石门流水自清泠。\n一酌令人意欲醒。\n旧道先贤敦素洁，即今上佐式蕃屏。\n鹿随毂转花从绚，鹤向阶鸣草尽青。\n千载羔羊重寄咏，高风端可树仪型。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23503,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"呈谢大方伯太蒙王公四首 其四","author":"韩上桂","text":"访古今看到五羊，贲禺丛桂郁苍苍。\n寒枝自爱清霜苦，润叶翻沾湛露瀼。\n招似淮王能好士，佩同楚客独怜芳。\n干旌岩穴无多见，分俸何劳借壁光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23504,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五石斋听雨","author":"韩上桂","text":"雨声滴沥转淋铃，久旱枯条尽欲青。\n五石恍攒云外出，半池疑杂涧中听。\n间支藤枕聊高卧，静掩柴扉且密扃。\n世事纷纭都不管，床头止有太玄经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23505,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜过苏汝载","author":"韩上桂","text":"阁夜灯光接汉光，无端幽思挹清芳。\n布帷欲动风旋透，竹簟初侵水并凉。\n满架残书宁久厌，一庭閒草未相妨。\n虚言万里能游目，不似高斋啸咏长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23506,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重阳前一日同汝载登城北台兼怀邓玄度给谏","author":"韩上桂","text":"炎岭秋迟菊未开，重阳先日此登台。\n斗边剩有双龙在，蓟北曾无一字来。\n细雨微芜荒欲尽，高崖曲垒折犹回。\n明朝胜事看如昨，点检萸囊映酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23507,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重阳日同苏汝载家大人季弟登白云峰","author":"韩上桂","text":"白云山畔白云飞，乔木浓阴幸可依。\n九日城头看雁字，百年膝下试莱衣。\n通家孔李情原契，入洛机云愿讵违。\n向夕定知烦史奏，德星南斗傍奇辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23508,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重阳日同提舶刘天虞公暨万伯文彭于兰游月溪寺饮文昌宫","author":"韩上桂","text":"绀宇琼扉敞独雄，谁人提举玉霄宫。\n天文北斗遥堪接，地势南溟近可通。\n宝勒閒调嘶五马，石桥高跨挹长虹。\n专城共羡犹青鬓，吹帽何妨任野风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23509,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饮月溪苏太尉墓","author":"韩上桂","text":"太尉坟前日未斜，黄花数遍酒杯赊。\n千年华表疑归鹤，百尺枯藤似挂蛇。\n古寺毫光晴欲吐，轻阴云影递相遮。\n登临转悟无生理，还向诃林问鹿车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23510,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜","author":"韩上桂","text":"秋风萧瑟洒寒衣，一枕空床百虑违。\n瘦骨可禁霜雪冷，枯肠那取梦魂饥。\n吟馀调苦虫声切，病后交疏雁影稀。\n布被浣残轻着枲，半生与汝特相依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23511,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"愁","author":"韩上桂","text":"愁思枯桐一样凄，秋来坠叶满庭西。\n霜袪络纬舒情唤，月落金鸡尽意啼。\n敝榻依墙眠未稳，残编扰案杂难齐。\n频年病瘠腰仍瘦，靠取行囊药一剂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23512,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠谭公瑾","author":"韩上桂","text":"君之侠气少人知，口里长吟七字诗。\n不为萧疏那有致，将因放傲转成痴。\n一编芸草馀生计，数幅松笺泛古思。\n无限里儿空赚事，葛巾徒步顾相欺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23513,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜同苏汝载踏月","author":"韩上桂","text":"一天明月照城虚，有客同行步委闾。\n更寂悄无人笑语，林深潜见鸟踟蹰。\n轻谈舒卷终惟我，閒数升沉可问渠。\n大地此时成落莫，好餐丹液跨蟾蜍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23514,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈心谦司理","author":"韩上桂","text":"廿载玄文祇自娱，蘧庐作计一生孤。\n袖中几漫襧衡刺，壁上长悬宗炳图。\n未许千金矜敝帚，却怜五石挟坚瓠。\n今朝喜迓同声应，云际苞鸾亦见呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23515,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题五羊驿壁","author":"韩上桂","text":"驿舍千年几阅人，恰同流水度行津。\n谁家不作蘧庐梦，若个能消马足尘。\n地注贪泉饶异味，天开瘴海有晴春。\n空劳梅萼从先折，得似犀珠索寄频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23516,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"呈赠大观察汪云阳公二首 其一","author":"韩上桂","text":"观风使者远乘轺，霜气遥令瘴热消。\n遂有神羊能奋触，伫看独鹗转横飘。\n南蕃雨露心偏系，北极星辰首重翘。\n旧著一编盐铁论，可无收采及刍荛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23517,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"呈赠大观察汪云阳公二首 其二","author":"韩上桂","text":"珠光南海旧昭回，何意翻投老蚌胎。\n岂是长庚垂欲下，多因释氏送将来。\n甘泉远取三山注，瑞土重凭五色培。\n咫尺弧星连寿极，为公满酌紫霞杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23518,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送邓太素归豫章","author":"韩上桂","text":"豫章大木本奇材，古干原凭雨露栽。\n止可雕摩供栋柱，岂应剥蚀付莓苔。\n梦随栎社谁相顾，爨比桐琴肯竟摧。\n潮海上通银汉杳，仙槎一去几时来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23519,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗幼良泊如斋成答寄","author":"韩上桂","text":"新斋颜取泊如名，珍重瑶笺几寄声。\n茅屋定容巢燕乳，竹窗从听野鸠鸣。\n壁函五岳神俱远，草就玄经梦亦清。\n丛桂昔年期结社，岁寒重许顾芳盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23520,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠督学潘完朴公二首 其一","author":"韩上桂","text":"清朝礼乐几人优，间代文章属胜流。\n持鉴务题天下士，乘轺先到日南州。\n一江春浪鱼从变，万里云罗鸟尽收。\n愚自不材无可见，但承郢琢复何求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23521,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠督学潘完朴公二首 其二","author":"韩上桂","text":"一朵花开万国春，罗浮梅萼几枝新。\n最宜交映惟仙品，敢望相投拟故人。\n运去六朝销粉丽，文回当代振丰神。\n倚门桃李知无限，沾洒思分雨露匀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23522,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜坐黄与东西堂","author":"韩上桂","text":"无数水光浸满堂，玉壶爽气连天荒。\n一双白鸭听人语，百尺青棕似我长。\n北斗下垂六七点，南华偶读两三行。\n此中啸傲翛然足，休问人间沧与桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23523,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柬余承采","author":"韩上桂","text":"千金缔结始为邻，片语殷勤遂见亲。\n白水尚盟坛坫旧，青云翻接凤鸾新。\n诗声暗彻从侵梦，烛影遥分任借贫。\n神物古来常作对，双龙今已会延津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23524,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"思约山人释系过访","author":"韩上桂","text":"三城谁是鲁朱家，叹尔空乘广柳车。\n去后怨深孤树鹤，归来閒杀满庭花。\n一杯浊酒情犹旧，几曲新声兴倍赊。\n何事缇萦能救父，阶前青桂已萌芽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23525,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同梁元珍万伯文诸子社集粤秀山","author":"韩上桂","text":"钟声远出碧云间，千载荒台尽日閒。\n剩取酒杯浇白社，不妨词赋媚青山。\n桂枝荏苒幽堪结，鹤羽飘飖逸可攀。\n平地丹梯怜咫尺，朝寻石磴暮能还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23526,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠黄纯言","author":"韩上桂","text":"百代文章不可知，君今振足强争奇。\n北风雨雪声常满，大海波涛势似驰。\n对客但须酣美酒，逢人且勿说新诗。\n明珠径寸浮光怪，夜半相投恐博疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23527,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答李伯襄","author":"韩上桂","text":"把赠新诗带素秋，白云低向箑端流。\n十年朋好依坛末，一夕鸿声到枕头。\n面孔世人饶见妒，骚篇山鬼稔生愁。\n丈夫剩有肝肠在，匣里孤龙吼未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23528,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿张五岭丈人","author":"韩上桂","text":"丈人一石已陶然，更加五斗亦垂涎。\n不须拔剑击曲士，便可即封拜酒泉。\n长柄鸬鹚堪度活，高丘糟檗好夤缘。\n人生要择几良友，清者圣人浊者贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23529,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏赠玉卿","author":"韩上桂","text":"美人金屋自舒徐，何事忙乘广柳车。\n义重绿珠宁怕死，奔随红拂未安居。\n罗衣典尽惟沽酒，玉珥捐残但买鱼。\n却笑堂前豪侠客，报仇谁得似专诸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23530,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄张绍和","author":"韩上桂","text":"千年碣石有高坛，爽气遥临易水寒。\n尔自只轮当大队，予从下厩佐雕鞍。\n尊前剑解龙声切，雪后书迟雁影单。\n珍重斯文期砥砺，相思何独慰加餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23531,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈伯畴","author":"韩上桂","text":"落魄仍虚陆贾装，青山止剩老诗囊。\n天生彩笔人何负，霜逼貂裘客转忙。\n眼下有权操黑白，舌端无力辍雌黄。\n一竿钓艇悬新月，何处沧洲不奈狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23532,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读汪伯耳诗寄赠","author":"韩上桂","text":"新诗不减碧琅玕，案上常留气色寒。\n响绝久无赓白雪，调高真许抗雄坛。\n来游八桂声名藉，旧入苍梧道路难。\n何事彩毫能博妒，少陵终薄鵔鸃冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23533,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"盘菊","author":"韩上桂","text":"嫩紫轻黄似斗妍，幽芳何事学嫣然。\n时无送酒难邀醉，术有餐英可驻年。\n最喜离骚清作对，却宜皂帽淡为缘。\n閒阶盘盎森相错，胜比东篱不用编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23534,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜同余承采张闰生罗幼良无极诸子集张约之斋中得一先韵","author":"韩上桂","text":"冻杀疏林断野烟，一天孤月未成圆。\n诗非我辈谁当咏，话入寒更拚不眠。\n星聚厌烦朝史奏，烛残虚想阁藜燃。\n千秋偃蹇容相狎，肯信乾坤独有权。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23535,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"集约之馆赠幼良无极二罗丈","author":"韩上桂","text":"罗含孙子尽能诗，瑞鸟云中五色披。\n日暖池塘知有梦，春晴花树定连枝。\n廿年结社看犹旧，百代遗文将在兹。\n莫笑剧谈空孟浪，片言真与古人期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23536,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"腊夜集约之馆送张闰生还广陵得春字","author":"韩上桂","text":"冬尽寒销又是春，荒林初报野花新。\n本期竟夕盟知己，那得明朝送去人。\n二十四桥歌兴动，一百六声钟漏频。\n知君满掇奇芳在，莫惜幽兰寄作纫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23537,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏效晚唐体和邓玄度给谏 其一 秋柳","author":"韩上桂","text":"一片閒愁寄两眉，春来风起动长丝。\n如今短带羞难舞，犹恨纤腰瘦易衰。\n路远河梁无可赠，曲残羌笛不堪吹。\n玄蝉亦解怜孤影，怕作清吟助暮悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23538,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏效晚唐体和邓玄度给谏 其二 秋槐","author":"韩上桂","text":"鸟集双游几共听，倚庭连理旧青青。\n时逢岁晏昏难合，火灼心头梦易醒。\n漫说弟兄为橘树，却怜牛女是虚星。\n长安大道忙如许，日走朱轮不暂停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23539,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏效晚唐体和邓玄度给谏 其三 秋桐","author":"韩上桂","text":"愿托朱弦写细吟，祇妨秋后有哀音。\n栖鸾昨去谁为伴，别鹤空弹思不禁。\n脆薄暗知寒到早，凋残时恐爨来侵。\n无端夜月浮清影，照见庭阶促暮砧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23540,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏效晚唐体和邓玄度给谏 其四 秋枫","author":"韩上桂","text":"别泪芳襟尽染丹，至今啼血未曾乾。\n天风一动声如诉，江水微含影已寒。\n南郡有香徒烬落，华林无凤共盘桓。\n美人千里魂何去，极目伤心不忍看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23541,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏效晚唐体和邓玄度给谏 其五 秋荷","author":"韩上桂","text":"当年学步试娇娆，此日残妆恨寂寥。\n风袭纨罗衣渐薄，露抛金粉气全销。\n扁舟游女劳相忆，去国骚人枉见招。\n独守空房双蒂断，寸心谁为寄归潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23542,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏效晚唐体和邓玄度给谏 其六 秋兰","author":"韩上桂","text":"欲把离心寄远人，鼓成幽操倍伤神。\n洞庭霜冷杳无际，湘畹香销恨莫纫。\n锦帐有缘曾入梦，閒房深掩渐生尘。\n更阑独对华灯落，任湛芳尊讵到唇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23543,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏效晚唐体和邓玄度给谏 其七 秋菰","author":"韩上桂","text":"平湖一望水连天，弱带愁肠暗自牵。\n饭煮雕胡无可进，席分蒲莞竟难眠。\n沉云似墨情俱黯，逐浪如鸥势不前。\n闻道沈郎曾寄咏，近来腰瘦付谁怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23544,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏效晚唐体和邓玄度给谏 其八 秋葭","author":"韩上桂","text":"何处边楼起暮声，捲成笳管太多情。\n霜翻玉露俱凝白，水接银河却尽清。\n鸿雁高飞知避弋，鸳鸯独宿惯怀惊。\n溯流拟逐伊人去，道远天长恨未平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23545,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏效晚唐体和邓玄度给谏 其九 秋草","author":"韩上桂","text":"曾作芳茵送马蹄，随君几处踏长堤。\n凉飙极力推蓬急，野火无情逐日低。\n似带罗裳能久系，为萤幽径复多迷。\n亦知生意终难断，祇恐王孙易怨凄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23546,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏效晚唐体和邓玄度给谏 其十 秋燕","author":"韩上桂","text":"踰海来游已半年，羁栖空愧主人贤。\n飞花欲尽宁长恋，垂柳将残不耐穿。\n月照虚檐魂欲冷，风高前路力犹绵。\n金椷锦字无消息，回首香闺入梦悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23547,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏效晚唐体和邓玄度给谏 其十一 秋雁","author":"韩上桂","text":"野性由来好远游，惯将清影逐云流。\n竞传北地堪逃夏，转眼西风欲报秋。\n芦荻渐深知可恋，稻粱将熟慰相求。\n上林亦有怀归客，昨得音书敢浪投。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23548,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏效晚唐体和邓玄度给谏 其十二 秋蝉","author":"韩上桂","text":"饮露吟风性独清。\n翳形无叶却心惊。\n序逢摇落怜孤影，人厌悲悽戒乱鸣。\n得势弹冠谁借便，防危写调讵知情。\n经行莫向陇头歇，恐有流泉学暮声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23549,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏效晚唐体和邓玄度给谏 其十三 秋萤","author":"韩上桂","text":"一点微光祇自如，敢云腐质敌阳曦。\n照书比雪心防懒，入袖如珠众易疑。\n隋苑繁华聊作戏，杜陵幽寂较相宜。\n死灰亦复能燃否，得似青藜可待吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23550,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏效晚唐体和邓玄度给谏 其十四 秋虫","author":"韩上桂","text":"篱落幽情黯自伤，调将碎语动人肠。\n频年多病呻难禁，竟夕孤吟韵转长。\n响切寒泉危咽石，怨深衰草冷凝霜。\n空房更觉添寥寂，透见蟾光但满床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23551,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏效晚唐体和邓玄度给谏 其十五 秋笛","author":"韩上桂","text":"一曲关山泪满衣，思乡游子欲何依。\n波翻辄恐龙宫震，云暗偏怜月色微。\n谩说垂杨堪蚤折，惊看独鹤故南飞。\n胡床三弄谁相识，惆怅柯亭知者希。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23552,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏效晚唐体和邓玄度给谏 其十六 秋笳","author":"韩上桂","text":"芦叶初长尚未齐，岂知哀怨使人凄。\n边声一起黄云合，胡曲重翻白雪迷。\n颇似邻家新妇泣，又如幽室小儿啼。\n思归借汝围堪解，起舞何劳听晓鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23553,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏效晚唐体和邓玄度给谏 其十七 秋烽","author":"韩上桂","text":"火彻甘泉达汉宫，边书间道下云中。\n流星阵后仍摇剑，落月楼头欲引弓。\n贾谊少狂能系虏，谢安谈笑亦成功。\n十年上策嗟无用，枉杀丹心直贯虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23554,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]