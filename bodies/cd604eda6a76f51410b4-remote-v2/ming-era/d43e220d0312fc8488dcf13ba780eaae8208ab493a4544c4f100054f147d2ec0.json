[{"title":"和千家诗六十首 其五 春夜","author":"李江","text":"银灯剔尽梦中残，帘外花枝月影寒。\n知是玉堂非社席，恼人何事倚栏杆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55145,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其六 题邸壁间","author":"李江","text":"春来自怕客衣寒，砧杵封书手未闲。\n身达黄金人万里，长安常望寄家山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55146,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其七 初春","author":"李江","text":"天气融和温若酥，万卉人间总沾无。\n鹅黄柳绿成金缕，争似看花满御都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55147,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其八 元日","author":"李江","text":"重光新影照阶除，万物今朝困始苏。\n春事又与人事好，百年相贺两相符。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55148,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其九 上元侍宴","author":"李江","text":"锦云红日映金章，春满蓬莱草亦香。\n千载奇逢应不易，更从何处问三皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55149,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其十 绝句","author":"李江","text":"排闼高山看小月，虚襟如水坐中天。\n洛阳云接东吴路，不买江湖买钓船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55150,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其十一 海棠","author":"李江","text":"十二栏前弄岁光，玉妃半醉月回廊。\n不知香雾空濛处，多少红妆间淡妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55151,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其十二 清明","author":"李江","text":"漫天柳絮雪纷纷，万里家山入梦魂。\n风景不殊人事异，可怜买酒过江村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55152,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其十三 清明","author":"李江","text":"百载春光老眼明，萧然竹院果如僧。\n不知玉烛烟何在，五夜窗前供杖灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55153,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其十四 社日","author":"李江","text":"江廓山村暮雨肥，鼕鼕社鼓动柴扉。\n南闾北舍皆欢喜，总话秋成竟日归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55154,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其十五 寒食","author":"李江","text":"春风不减小兰花，门外风轻燕子斜。\n怀古每逢寒食节，无穷情恨为谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55155,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其十六 绝句","author":"李江","text":"绿树青山一揭蓬，水晴烟断岸西东。\n月来竹院无人过，闲扫松花对午风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55156,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其十七 游小园不值","author":"李江","text":"白石苍苍久绿苔，却疑花木未曾开。\n东风莫道无春色，且看墙蝶也飞来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55157,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其十八 题屏","author":"李江","text":"尘鞅纷纷一梦间，机心惊起白鸥闲。\n閒居莫道无人识，半面分明与半山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55158,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其十九 庆全庵题桃花","author":"李江","text":"相对桃花不识秦，岸馀花似未逢春。\n深红浅碧相并逐，留得清香过别津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55159,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其二十 戏赠看花","author":"李江","text":"拂风清影隙中来，光景相逢又一回。\n抹粉涂脂还竟日，不知芳草满庭栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55160,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其二十一 再游玄都观","author":"李江","text":"大袖婆娑拂点苔，玄都观里眼重开。\n道人已远休相笑，何事花边又再来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55161,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其二十二 漫兴","author":"李江","text":"百年天地一青毡，随处江山不费钱。\n谩倚栏杆看月上，惹人何事不成眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55162,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其二十三 花影","author":"李江","text":"云破金碎月满台，春晴冷坐笑颜开。\n一枝不上佳人发，残落还教蝶梦来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55163,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其二十四 滁州西涧","author":"李江","text":"秋寒岁晚绿阴生，涧底风清鸟雀鸣。\n遮断兰皋云万里，江篱槛木几根横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55164,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其二十五 北山","author":"李江","text":"钟山倒影入寒陂，南北风烟慨昔时。\n花草有情皆偶见，千年勘破此机迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55165,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其二十六 湖影","author":"李江","text":"水色山光鸟自啼，乱红趁紫画中飞。\n欲拈金剪来裁度，直取前头一幅归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55166,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其二十七 春晴","author":"李江","text":"万倍韶华归眼孔，十分清景可裁花。\n疏枝冷暖春情好，相知只有老人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55167,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其二十八 春暮","author":"李江","text":"东风一路欲寻花，冷色残香老海涯。\n莫道春光无意绪，月明歌笛满池蛙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55168,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其二十九 落花","author":"李江","text":"花当开处为谁开，笑杀花前羯鼓催。\n惟有红颜长住得，鬓毛色滟绿如苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55169,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其三十 春晚游小园","author":"李江","text":"碧桃红杏斗新妆，暮雨春残睡海棠。\n嗟彼婆娑梅独老，青青深绿傍邻墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55170,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其三十一 莺梭","author":"李江","text":"抛梭花底自怡情，穿尽机来不有声。\n夺得天孙真妙处，肯教云锦与相成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55171,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其三十二 暮春即事","author":"李江","text":"阴深雨绿迷芳径，狼藉春红映小池。\n却讶芳兰香不断，随风吹送落花时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55172,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其三十三 登山","author":"李江","text":"俯仰从容天地间，时来乘兴可登山。\n何人说破长生偈，不道閒中更有閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55173,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其三十四 晚春","author":"李江","text":"九十春光未肯归，天工雕刻总芳菲。\n蝶儿不解韶光意，只恐香尘入梦飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55174,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其三十五 伤春","author":"李江","text":"万紫千红滟且浓，那堪一阵落花风。\n明年有幸相逢处，诗酒淹留花柳中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55175,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其三十六 送春","author":"李江","text":"兰药虽残荷又开，桃花酩酊送春来。\n明朝又是相迎处，惹得生香一样回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55176,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其三十七 居洛初夏","author":"李江","text":"洛南山色雨初晴，十五年来两眼明。\n一阵青苗寒拥绿，鬼神知我此心倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55177,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其三十八 有约","author":"李江","text":"门深睡觉三竿雨，水煖听残几个蛙。\n隔坐红尘成万里，争教红叶问黄花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55178,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其三十九 初夏睡起","author":"李江","text":"流水高山老伯牙，孤桐谁许碧笼纱。\n枕痕春色天长午，坐对蔷薇一树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55179,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其四十 三衢道中","author":"李江","text":"振袖街前晓色晴，天风吹马日边行。\n两傍古树排牙立，一路幽禽喝道声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55180,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其四十一 即景","author":"李江","text":"手卷斜抛对小窗，花心两蝶恋斜阳。\n但知感我伤情处，不道清风恨更长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55181,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其四十二 晚楼閒望","author":"李江","text":"山外山光接水光，楼前楼下野花香。\n眼前不带斜阳景，只爱清风别样凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55182,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其四十三 山居夏日","author":"李江","text":"绿满柴扉日更长，天心彻底一方塘。\n闲来独向清风立，始觉荷花送远香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55183,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其四十四 北谢碑","author":"李江","text":"贾生谏疏谪长沙，天下驰名共一家。\n回首洛阳何日是，江梅结子柳飞花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55184,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其四十五 秋景","author":"李江","text":"钟山云枕大溪头，冷落丹崖草树秋。\n欲归烟断江楼水，相看宇宙共悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55185,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其四十六 七夕","author":"李江","text":"眼穿肠断竟如何，只怕光阴去若梭。\n莫信宗元前夜语，只留机巧自家多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55186,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其四十七 立秋日","author":"李江","text":"火云馀焰尚烧空，乍起初秋一阵风。\n十里芰荷香欲断，眼前黄菊满篱中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55187,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其四十八 秋夕","author":"李江","text":"淡扫秋山一幅屏，堂前蟋蟀草间萤。\n不须眼界看牛女，东井边头有五星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55188,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其四十九 中秋月","author":"李江","text":"楼外楼前夜却寒，不胜狼藉此杯盘。\n男儿四海多离合，都与嫦娥对面看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55189,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其五十 江楼有感","author":"李江","text":"世事关情岂戛然，江楼危坐问青天。\n到头老眼须凭久，管看花前醉少年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55190,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其五十一 西湖","author":"李江","text":"万顷湖光一鉴中，瑶池翠水许相同。\n锦帆只怕西风便，打破残霞几幅红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55191,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其五十二 入直","author":"李江","text":"夕照寒光闪暮鸦，老臣宠渥荷分茶。\n玉堂步步春如海，多少清香得染花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55192,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其五十三 登车盖亭","author":"李江","text":"清风吹下到藜床，袖拂香尘路亦长。\n老眼花枝还带雨，不知何事笑沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55193,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其五十四 直中书省","author":"李江","text":"风沉禁院门深锁，香尽金炉觉夜长。\n声中自有黄金屋，翰苑知是读书郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55194,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其五十五 观书有感","author":"李江","text":"川上春流眼色生，天心坐处物能轻。\n面前光景何由到，只在致知又力行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55195,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其五十六 冬景","author":"李江","text":"曲栏偏槛风霜晚，百卉花中菊一枝。\n老景但知非冷寞，宠恩何异在春时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55196,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其五十七 寒夜","author":"李江","text":"十年故旧天涯远，一朵灯花夜半红。\n不是剡溪兴欲尽，月痕争与雪痕同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55197,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其五十八 枫桥夜泊","author":"李江","text":"琴对高山剑倚天，枫桥月落夜孤眠。\n钟声惊破还家事，惆怅江湖万里船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55198,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其五十九 霜月","author":"李江","text":"青娥不见鬓如蝉，青女青妆下九天。\n有色有相成独冷，分明萧萧又娟娟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55199,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其六十 答钟弱翁","author":"李江","text":"破帽春风闲弄笛，梅花落处妙无声。\n长官不到江村外，剩水残山眼独明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55200,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"厓山吊古","author":"李江","text":"人生怀古不胜悲，况向前朝说盛衰。\n白浪泣声如恨宋，青山排戟欲诛夷。\n君臣谦让称奴日，骨肉间关忍死时。\n嗟彼汴杭闽广路，月痕云影谩相疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55201,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感旧 其一","author":"陈繗","text":"翁寿七十春，庆生七儿子。\n传家良有人，功业皆由己。\n既不忝所生，又何憾于死。\n哀哉酒一杯，荒草斜阳里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55202,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感旧 其二","author":"陈繗","text":"光阴如过客，尘世一梦耳。\n七十古来稀，百年亦无几。\n学已成麟角，名彰附骥尾。\n后古人而生，不先古人死。\n口口复令终，如斯而已矣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55203,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别友步原韵","author":"陈繗","text":"青青水间萍，绿绿萍间水。\n萍水两相逢，江湖一团美。\n自春还自秋，于沼更于沚。\n到处可滋培，随时任荣萎。\n忽闻波浪声，便觉金风起。\n吹动楚天头，荡开越江尾。\n何期萍水交，判尔参商异。\n聚散无定期，往来亦常理。\n矧余有生身，本自无根蒂。\n生养天地间，遨游山水里。\n大收满腔春，充塞浩然气。\n萍水俱浮游，匏瓜那着系。\n用之则流行，舍则随坎止。\n奋发云水边，激昂霄汉际。\n风云庆会时，日月重熙世。\n郅治昭文明，又兼修武备。\n英雄文武才，将相公侯位。\n何事不可为，能行亦自至。\n肯为游子颜，忽弃男儿志。\n功业尚可图，别离那足计。\n今日萍水边，分却金兰袂。\n只在两仪间，何愁不相会。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55204,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过武城","author":"陈繗","text":"蕞尔武城邑，今城仍古城。\n城郭虽然是，人民日已更。\n当年子游子，曾宰治编氓。\n辙环孔宣父，过此访门生。\n不觉筦尔笑，笑闻弦歌声。\n于今筦尔笑，笑无弦歌鸣。\n筦尔貌则同，筦尔原异情。\n遥遥千载后，何人育群英。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55205,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万竹轩","author":"陈繗","text":"先生偏爱万竿竹，君子林中处幽独。\n披月凌云节节高，连轩累槛猗猗绿。\n荣华生瘁本无心，清风明月自古今。\n个中龙种无穷趣，低叶时来有凤吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55206,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题丞君山水","author":"陈繗","text":"君家一幅画山水，劝我题诗在画里。\n我观山水真绝奇，历历江山鲜堪比。\n欲比蓬莱山，三岛有其间。\n欲比桃源洞，桃源千古成幻梦。\n不是蓬莱山，不是桃源洞。\n金陵好风景，只在个中看。\n春云入树暮山碧，秋波打空烟水寒。\n水光山色交相映，泛泛孤舟几亭榭。\n蓑笠巾裾山水间，阿谁还是仁智者。\n智者却乐水，仁者须乐山。\n乐山寿弥久，乐水乐自宽。\n二者自为二，一之良亦难。\n君能乐山复乐水，山水两全仁且智。\n今看山高兼水长，寿考无疆乐不已。\n我今写此为君歌，此歌不入俗人耳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55207,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为傅本荣令器启蒙学书作","author":"陈繗","text":"山下泉初出，涓涓漱石流。\n污泥沉涧底，活水有源头。\n河海汪汪日，鱼龙跃跃秋。\n个中能变化，霄汉任遨游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55208,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚归","author":"陈繗","text":"云外横归鸟，松梢挂落晖。\n一身轻似掷，双足疾如飞。\n客舍初明火，人家半掩扉。\n儿童笑相问，底事此时归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55209,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与李秀士","author":"陈繗","text":"介胄文章客，均为琼海人。\n交游萍水上，离别剑江滨。\n两地皆寻祖，孤舟各问津。\n何时重见面，依旧一乡亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55210,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送别三首 其一","author":"陈繗","text":"雨雪正纷纷，相看欲断魂。\n绨袍犹恋恋，征袂已翻翻。\n秋色鹤山月，春空马岭云。\n知君怀我处，便是我思君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55211,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送别三首 其二","author":"陈繗","text":"出处有时节，行藏无定期。\n游踪何落落，归路莫迟迟。\n璞玉还堪琢，骊珠不可遗。\n要将怀素宝，售此盛明时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55212,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送别三首 其三","author":"陈繗","text":"南北东西路，驱驰秋复春。\n十年孤苦客，万里一归人。\n屋宇皆非旧，襟怀亦自新。\n到家何事好，惟有弟兄亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55213,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送彭孔明膺荐入京","author":"陈繗","text":"携手上离亭，江山总是情。\n雨馀花色重，风细柳烟轻。\n出匣双龙奋，横空一鹤鸣。\n独怜今日酒，犹自为君倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55214,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜乘舟","author":"陈繗","text":"云净江还净，风清月更清。\n芦花两岸阔，莲叶一舟轻。\n天影随波动，帆光带月行。\n流连闲兴尽，回棹已三更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55215,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]