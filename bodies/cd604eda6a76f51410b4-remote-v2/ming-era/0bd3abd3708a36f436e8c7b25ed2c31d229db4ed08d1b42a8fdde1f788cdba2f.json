[{"title":"送潘伯振守汉中三首 其二","author":"边贡","text":"白马河边春日晴，黄牛山下百花明。\n家家耒耜居民出，太守来时亲课耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18372,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送潘伯振守汉中三首 其三","author":"边贡","text":"金城户曹张凤翔，埋玉空山宿草长。\n天上故人驱五马，经过流涕问孤孀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18373,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送苏通判四首 其一","author":"边贡","text":"天涯相见地曹郎，郡阁清尊夜语长。\n休向灯前易成别，江头春水正茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18374,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送苏通判四首 其二","author":"边贡","text":"曾并长安逐马蹄，谪居同过楚云西。\n他年纵有看花句，休向玄都观里题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18375,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送苏通判四首 其三","author":"边贡","text":"去岁秋风别省闱，木樨花落雨霏霏。\n那知此日江陵郡，春草连天送客归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18376,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送苏通判四首 其四","author":"边贡","text":"春风江阁喜同游，苦恨逢君不少留。\n东去巴陵三日路，几时同上岳阳楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18377,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送张元亮二首 其一","author":"边贡","text":"知君元在识君先，水国相逢亦偶然。\n何日一尊还远别，暮云春树暗江天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18378,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送张元亮二首 其二","author":"边贡","text":"冉冉游云覆短檐，霏霏寒霭度重帘。\n羁怀正苦逢春别，行李何妨入夜淹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18379,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送林赞贤医士归临清四首 其一","author":"边贡","text":"送君泺源溪水滨，岸桃堤柳俱鲜新。\n黄鹂声中白日晚，又是乡园一度春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18380,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送林赞贤医士归临清四首 其二","author":"边贡","text":"林花欲开春草生，村烟漠漠午鸡鸣。\n君行落魄似阮籍，休叹路歧纵复横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18381,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送林赞贤医士归临清四首 其三","author":"边贡","text":"腊月驱车东郡来，元宵今始雪中回。\n临清城外成林杏，尽是州人为尔栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18382,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送林赞贤医士归临清四首 其四","author":"边贡","text":"鸡声喔喔宵近庭，出户忽闻春雨腥。\n西江高士别我去，日出烟消山更青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18383,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送贾廷臣司训二首 其一","author":"边贡","text":"行李萧条石径荒，贾生东去路茫茫。\n卢龙不是长沙地，莫把吾皇比汉皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18384,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送贾廷臣司训二首 其二","author":"边贡","text":"卑耳溪边秋草深，裂坡山北树阴阴。\n西风匹马吊孤竹，一曲商歌千古心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18385,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送毛东塘侍御北还后怀寄八首 其一","author":"边贡","text":"汴上相逢一载馀，五云回首送轺车。\n河梁别意真堪画，行李萧萧几卷书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18386,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送毛东塘侍御北还后怀寄八首 其二","author":"边贡","text":"霜云千里朔风寒，豸锦貂裘独据鞍。\n大厦如今要梁栋，凭君归报得材难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18387,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送毛东塘侍御北还后怀寄八首 其三","author":"边贡","text":"夜来风雨晓来晴，万里无尘海岳清。\n白日共看骢马色，青天不负使君名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18388,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送毛东塘侍御北还后怀寄八首 其四","author":"边贡","text":"漫谈时事共伤神，白首丹心许国身。\n归觐正逢长至节，六阴行且见阳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18389,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送毛东塘侍御北还后怀寄八首 其五","author":"边贡","text":"荣亲报国皆吾事，孝子忠臣只此心。\n闻说致身同养志，莫分朝市与山林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18390,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送毛东塘侍御北还后怀寄八首 其六","author":"边贡","text":"客窗风雨对寒灯，午夜怀人思不胜。\n梁苑宋台秋色里，也应回首忆同登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18391,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送毛东塘侍御北还后怀寄八首 其七","author":"边贡","text":"别来公署易黄昏，心曲凭谁与细论。\n宦海风波无定处，相逢何日对芳樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18392,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送毛东塘侍御北还后怀寄八首 其八","author":"边贡","text":"梦回欹枕夜三更，烟树微茫隔卫城。\n独向屋梁惊落月，不堪还听雁来声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18393,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卫辉阻雨奉别幸庵彭太保","author":"边贡","text":"宦情时事剧秋云，话到伤心不忍闻。\n别梦迢迢似明月，汉关楚塞远随君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18394,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别汤万户","author":"边贡","text":"半生湖海识君迟，可奈相逢是别期。\n扁舟独泛秋溪水，采得芙蓉欲赠谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18395,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送吕二守西征二首 其一","author":"边贡","text":"六月戎船上逆流，书生弹铗取封侯。\n夜来羽檄江边过，闻说西戎破剑州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18396,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送吕二守西征二首 其二","author":"边贡","text":"巫峡瞿塘十丈波，大宁盐井火云多。\n贼巢散满空山里，旧日居民有几何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18397,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"客怀六首 其一","author":"边贡","text":"万山深护一书楼，此际栖迟景最幽。\n浮海未酬当日志，北归还买洞庭舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18398,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"客怀六首 其二","author":"边贡","text":"薰风江上棣花开，醉倚兰桡首重回。\n孤影却随南雁去，尺书还附北鸿来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18399,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"客怀六首 其三","author":"边贡","text":"水耨方閒即火耕，土风遥识楚江程。\n汀花冉冉凫鹥色，岸柳阴阴布谷声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18400,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"客怀六首 其四","author":"边贡","text":"鬓丝端为别兄皤，魂梦真如道路何。\n滇海万峰秋雁少，楚江千里月明多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18401,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"客怀六首 其五","author":"边贡","text":"远从江左入湖南，姜被初分思岂堪。\n閒算长公年纪数，白头今已六旬三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18402,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"客怀六首 其六","author":"边贡","text":"望远时从郭外游，好登江阁与山楼。\n烟开碧树通吴苑，日落黄云接楚丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18403,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送雷州赵太守四首 其一","author":"边贡","text":"苏公楼前海日晴，伏波祠畔瘴烟清。\n荔枝垂实桄榔暗，太守来时双鹤迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18404,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送雷州赵太守四首 其二","author":"边贡","text":"诗人出守是寻常，万古心期一瓣香。\n若道雷州非乐土，请君时到十贤堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18405,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送雷州赵太守四首 其三","author":"边贡","text":"海邦云雾昼霏霏，榕树林中孔雀飞。\n驿骑忽传天使到，九重亲赐玉环归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18406,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送雷州赵太守四首 其四","author":"边贡","text":"我在江陵望帝乡，登楼时恨楚天长。\n怜君更隔三千里，岭树湖烟更渺茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18407,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹梅","author":"边贡","text":"黄梅绿竹两寥寥，一段清光惜浪抛。\n看遍乾坤空老眼，几人解取岁寒交。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18408,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋海棠五首 其一","author":"边贡","text":"海棠盈盈开素秋，雨晴斜日上帘钩。\n幽芳不与春风约，碧榭朱阑俱暮愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18409,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋海棠五首 其二","author":"边贡","text":"海棠开日近重阳，秋蝶翩翩过短墙。\n题品要知观物眼，只须风骨不须香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18410,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋海棠五首 其三","author":"边贡","text":"海棠花开秋雨霏，休将迟暮怨芳菲。\n东园桃李盈千树，昨日秾华今日稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18411,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋海棠五首 其四","author":"边贡","text":"庭下秋棠开紫绵，映风含雨净娟娟。\n羽人自解丹丘术，种得花来亦是仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18412,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋海棠五首 其五","author":"边贡","text":"梧桐叶凋金井阑，芭蕉风雨怨秋残。\n海棠十月犹含蕊，故伴青松当岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18413,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"向曹伯通乞白菊","author":"边贡","text":"节过重阳菊已残，倚霜欹露不胜寒。\n山堂正少黄金蕊，试看君家白玉团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18414,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"王使君诲处觅猫","author":"边贡","text":"雪白狸奴尾胜金，曾娱白发戏花阴。\n急须分乞邻姬养，莫遣空摧孝子心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18415,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"伦上人遗杏戏荅","author":"边贡","text":"带叶生英颗颗新，竹蓝初发齿生津。\n清酸本是儒家味，不道山僧亦戏人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18416,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚雪","author":"边贡","text":"梅花枝上报初春，泺水源头忆故人。\n天宇自清心自白，不知何处有红尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18417,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和蒋儒士韵题便面","author":"边贡","text":"江树青山歇晚秋，草堂幽僻对寒流。\n故人远赴关西去，明月芦花系钓舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18418,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题张秀才钓鱼便面","author":"边贡","text":"鲈鱼钓得上纶钩，归去应须与妇谋。\n携取一尊同客醉，江风山月更何忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18419,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次正斋韵题石冈图","author":"边贡","text":"白石冈头榆柳新，苍苍茅屋掩深春。\n山翁不注扬云易，怪底门无问字人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18420,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三友图为蔡石冈题","author":"边贡","text":"岁寒池馆暮相依，雪共心期月共辉。\n南北宦游三十载，碧山回首故人稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18421,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题扇","author":"边贡","text":"绿惨红蔫春色阑，枝间黄鸟任绵蛮。\n知机自合高飞去，莫遣矰罗绊羽翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18422,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"以兔图赠王生兼附短句","author":"边贡","text":"我来赠君玉兔图，我去留君双湛卢。\n月殿秋风桂花发，一枝能斫寄来无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18423,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题陆子引画","author":"边贡","text":"水榭山林向夕幽，笛声遥在木兰舟。\n江空处处多明月，不用相寻秉烛游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18424,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题萱图","author":"边贡","text":"绕膝曾玄认不真，北堂风景日长春。\n堂前满种宜男草，一度花开一度新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18425,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题廷相兄扇头","author":"边贡","text":"万里乾坤见此亭，四围山色绕阑青。\n何当著我亭中坐，閒校神农本草经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18426,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"毛骠骑扇头","author":"边贡","text":"玄菟城外草连天，鸭绿江头春可怜。\n将军饮马临江水，东指扶桑在日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18427,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题行南卷","author":"边贡","text":"小结幽亭倚大江，万竿深处听飞泷。\n横琴试鼓湘妃怨，彷佛鸣珂过北窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18428,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题家园风景图二首 其一","author":"边贡","text":"苕水羌山清更深，萧萧芦渚间桑林。\n青枫树里三间屋，十载常悬万里心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18429,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题家园风景图二首 其二","author":"边贡","text":"万竹深深一径斜，草堂门巷接江沙。\n主人游宦不归去，时有白鸥来钓槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18430,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题墨萱","author":"边贡","text":"华发当年倚笑看，北堂春色映朱阑。\n披图彷佛慈颜在，零落霜风夜雨寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18431,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题天鹅海青图","author":"边贡","text":"云暗霜天雪满衣，鴐鹅声乱海青飞。\n李陵台下燕山北，正是单于夜打围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18432,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题金宪长舜举蓉溪书屋图四首 其一","author":"边贡","text":"蓉溪主人溪上来，来时廉访去都台。\n共道溪花似溪主，暂时摇落又还开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":