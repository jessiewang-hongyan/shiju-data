[{"title":"初秋","author":"黄佐","text":"玉河杨柳已萧萧，羁思逢秋转寂寥。\n亲舍每疑云外近，长安翻觉日边遥。\n浮名肯似莼鲈美，壮志宁随髀肉消。\n自笑行藏浑未卜，巫阳堪问竟谁招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜大兴隆寺玩月","author":"黄佐","text":"玉壶对酒秋色满，金地坐看明月高。\n北戍不随胡马暗，南巡应照圣躬劳。\n山河有影看蓬鬓，风露无声生缊袍。\n忽忆越江垂钓叟，流光千顷一浮舠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得七月家书志喜","author":"黄佐","text":"红叶声中醒客梦，白云飞处忆亲庐。\n情多岂保鬒不变，计拙乃为饥所驱。\n燕颔果谁还有相，羊肠何路是无虞。\n临风正觅伤秋句，忽领平安两字书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送祁惟允","author":"黄佐","text":"执手别君何郁纡，帝城秋色野踟蹰。\n离情不学晓云淡，知己渐随烟柳疏。\n去国未须言勇退，还家聊且赋閒居。\n想应明主不相弃，谁合南山有弊庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠西蜀胡秀才","author":"黄佐","text":"遥遥蜀道亘天端，来去惟君不作难。\n来为慈颜欣奉檄，去缘皤发倦弹冠。\n柳摇燕市听莺别，云拥峨眉驻马看。\n索句赠君还自笑，一年为客向长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陶二尹之任元城","author":"黄佐","text":"风流此日陶彭泽，善唱吴歈向别筵。\n制锦正当佳丽地，弹冠初遇中兴年。\n一庭诗景孤松里，疋马春风立柳边。\n倾盖相逢又分手，金台凉月夜娟娟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄梁应房","author":"黄佐","text":"去年萧寺忆殷勤，长剑高歌入夜闻。\n异国风烟能慰我，同年交谊不如君。\n落霞秋倚新丰树，疋马晴瞻震泽云。\n南北祇今成怅别，夜来樽酒梦论文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送余崇一使蜀","author":"黄佐","text":"凤凰衔诏出蓬莱，剑气峥嵘拂曙开。\n万里风烟驰蜀道，五云宫阙梦燕台。\n浣花溪在搜唐迹，洗墨池荒忆汉才。\n闻道故园沧海上，星槎争羡自天回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荆庭春恨和潘源鲁","author":"黄佐","text":"东风庭院雨丝丝，姜被寒生梦后悲。\n浅绿正添鸿雁沼，轻红初上鹡鸰枝。\n流年未觉音尘尽，往事空诒肺腑知。\n断送一番吟鬓白，可怜荆树似秋时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠梁明仲","author":"黄佐","text":"都门杨柳映愁生，久客怀归此送行。\n乡梦昔曾随去马，春光今已别流莺。\n舟移北渚龙光窅，路入南天剑气明。\n他日一尊寻旧约，白云溪上濯尘缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"席中赠伦彦蕃","author":"黄佐","text":"看君意气薄青霄，京邸相逢即久要。\n凤沼每传贤父子，雁行多在圣明朝。\n虹横楚水朝看剑，月满吴门夜听潮。\n何事春明携手地，满堤垂柳正萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别伦彦周侍御","author":"黄佐","text":"青藜灯火同高阁，皂盖声华独内台。\n日月祇随燕树转，云山长羡粤鸿回。\n劳劳世事关蓬鬓，黯黯离怀付酒杯。\n姜被莱衣荣子去，风江烟艇待谁来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宜阳八景次东溪郑尚书韵八首 其一 黄岑叠翠","author":"黄佐","text":"晓入宜阳见万峰，鸡声人语共疏钟。\n停车最爱黄山好，滴袖俄惊翠黛浓。\n陆海鱼龙凭砥柱，青天波浪出芙蓉。\n淩风欲挟飞仙去，直上蓬莱第一重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宜阳八景次东溪郑尚书韵八首 其二 白水垂虹","author":"黄佐","text":"扣舷何处有渔歌，泉拥西山景最多。\n云外恍疑垂玉蝀，人间真觉近银河。\n静涵桂魄天同色，流入桃花锦作波。\n若到春郊频极目，东风吹润遍嘉禾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宜阳八景次东溪郑尚书韵八首 其三 玉溪春涨","author":"黄佐","text":"玉溪流水碧沉沉，巧算还谁测浅深。\n细雨斜风浑二月，鲸吞鼍作忽千寻。\n敲诗日忆澄江练，倚仗时闻绿树禽。\n何事临流歌仰止，三星桥外有遥岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宜阳八景次东溪郑尚书韵八首 其四 宝刹云幡","author":"黄佐","text":"碧树苍烟锁绀园，四民曾此礼三尊。\n岧峣地上开金刹，仿佛云中立翠幡。\n山色可能随世改，烧痕长是到秋繁。\n凭高莫漫搜陈迹，时倚衡云望蓟门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4446,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宜阳八景次东溪郑尚书韵八首 其五 蒙洞泉香","author":"黄佐","text":"景星灵洞足探奇，石上浮觞漫尔为。\n碧落玉书空往梦，葛巾藜杖可芳时。\n香分下泽烟花绕，暖入东陂雁鹜知。\n羽客不归瑶草暮，桃源何处问蛾眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4447,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宜阳八景次东溪郑尚书韵八首 其六 良岩龙隐","author":"黄佐","text":"独倚苍岩玩碧澜，共知龙向此中蟠。\n九天空阔疑雷动，万木萧疏带雨寒。\n马鬣不教桑楚歉，鸟耘那见稻畦乾。\n行藏笑与髯翁道，潜跃由来不是难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4448,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宜阳八景次东溪郑尚书韵八首 其七 榜山晴旭","author":"黄佐","text":"列岫排云切太苍，曲江银榜宛如长。\n当衙已献千重秀，带日还成五色光。\n秋净烟霞开锦绣，春深风雨散红香。\n地灵人杰从来是，满耳蜚声说庙廊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4449,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宜阳八景次东溪郑尚书韵八首 其八 普化晚钟","author":"黄佐","text":"涉水循山问化宫，翠微深处有村舂。\n僧来且共松间坐，溪午遥闻烟外钟。\n贝叶昙花空寂寂，琼帘珠栱自重重。\n旧游回首思长乐，无限诗情到晚浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4450,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"华节亭别亲友","author":"黄佐","text":"宿雨冥冥晓正开，故人遥放酒船来。\n啼莺语燕催春事，绿水红亭照客杯。\n别梦绸缪犹粤海，片帆迢递又荆台。\n临岐欲尽分携意，满目停云郁未裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4451,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洸口寄伦子彦式","author":"黄佐","text":"魁冈南望隔湘烟，闻道征帆别后悬。\n楚粤山川空寄梦，江湖风雨正连天。\n明光起草逢今日，京洛看花忆去年。\n岐路祇今随使节，可堪心折五云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4452,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赣州紫霄岩赠林二山","author":"黄佐","text":"凭空飞观倚岧峣，风磴盘盘入紫霄。\n章贡滩声天外落，燕云山色日边遥。\n百年气谊堪杯酒，万里离忧自市朝。\n笑与使君图后会，扁舟何日重相招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4453,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日游何氏园","author":"黄佐","text":"漠漠朱光接翠寒，萧萧林樾隐风湍。\n浣花暂尔栖疏放，古柏终当宿凤鸾。\n遂有卧龙清洛水，还从飞雁望长安。\n种榆袅袅成何事，心折云边金露盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4454,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"放船","author":"黄佐","text":"城乌翻月鼓沉沉，虎丘寺前初放船。\n青山白水晚如画，枫叶芦花秋可怜。\n皇华万里但原隰，供奉三年犹俸钱。\n鸱夷邈矣不可见，隔浦缓歌闻采莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4455,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"海珠别方塘汪宪副","author":"黄佐","text":"海珠山下寒潮生，击鼓放船君欲行。\n酾酒千巡谷鸟啭，粤城十月江花明。\n碧鸡金马在何处，游子孤臣俱有情。\n此去登临不同赏，倚楼诗句向谁成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4456,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送范衢村大参","author":"黄佐","text":"桂州城南漓水流，白蘋芳芷满中洲。\n即看彩鹢随春色，聊遣清尊消别愁。\n画省交游成旧雨，彤云瞻望及新秋。\n相逢若问鸱夷子，已向江湖买钓舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4457,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大藤峡徭老","author":"黄佐","text":"大藤勋业使人疑，今日褰帷始见之。\n每忆韩公成感叹，且令徭老望威仪。\n江山道梗空千里，兵甲屯云又一时。\n闻道招安成妙算，从前真觉费王师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4458,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洮阳野次","author":"黄佐","text":"画船箫鼓拥青衿，岂有当年木铎音。\n故国烟花那在眼，长途风雨若为心。\n三湘秀色来天地，五岭华风自古今。\n耿耿有怀成野宿，梦魂虚绕泰山岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4459,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日","author":"黄佐","text":"晓来簪弁换荷衣，遥望祥云夹日飞。\n北塞风尘应已静，南溟楼橹竟安归。\n乾坤脉脉移花柳，林壑欣欣动蕨薇。\n谁在青冥生白发，且持春酒对春晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4460,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"粤山诗社试笔分得清字","author":"黄佐","text":"碧山云卧倚江清，衣马何人献岁行。\n丽日楼台明万井，轻风箫鼓庆三城。\n东南漂泊嗟悬磬，西北驱驰费请缨。\n且向烟萝开野酌，渔樵相与话升平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4461,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"人日和陈天游韵 其一","author":"黄佐","text":"骀荡春光满隐窝，放狂判到鬓双皤。\n柳条色映青丝骑，柏叶杯翻白纻歌。\n莺燕不嫌三径僻，风烟偏在五陵多。\n年来无地寻花胜，世道应随东逝波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4462,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"人日和陈天游韵 其二","author":"黄佐","text":"东风吹遍海天涯，隐几萧条忽见花。\n人日钩诗谁对酒，草堂携鹤自移家。\n冲星剑佩真吾事，满地江湖又岁华。\n何事步兵从晋室，春来犹咏救侯瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天开图画亭","author":"黄佐","text":"突兀茅斋跨石台，玉杯瑶席倚云开。\n天边湘色褰帷入，地底漓江逐马来。\n北极自勤瞻阙梦，西山谁有济时才。\n侧身天地酣歌里，鸿雁冥冥首重回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4464,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"肇庆李东渠中丞邀游洒然亭次韵二首 其一","author":"黄佐","text":"岭海栖迟有岁年，草堂今喜识高贤。\n钓残野水从鱼乐，锄罢寒葵带露鲜。\n世事驱驰真梦里，天涯谈笑且尊前。\n朔云他雨劳相问，犹记萍踪自洒然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4465,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"肇庆李东渠中丞邀游洒然亭次韵二首 其二","author":"黄佐","text":"崧台今夕是何年，投辖倾杯见此贤。\n半亩方塘开罨画，一亭明月共澄鲜。\n习池已觉心俱醉，宣室还看席屡前。\n勋业古来戎马地，可能无意勒燕然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4466,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苍梧言归口号","author":"黄佐","text":"十载行囊一素琴，寥寥天地几知音。\n渊明已有归来赋，和靖初无禄养心。\n北郭晚田堪白酒，东篱秋菊尽黄金。\n扁舟一去随明月，回望苍梧空绿阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4467,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙申元日","author":"黄佐","text":"阳吹朝来动远空，九重春与万方同。\n金盘北望思承露，玉琯东回验相风。\n日月催人双鹤鬓，江湖容我一渔翁。\n十年旧梦成追忆，曾侍朱衣紫殿中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4468,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灯夕立春","author":"黄佐","text":"东风澹澹月团团，灯市逢春倍觉欢。\n汉苑烟花曾驻马，秦楼歌舞更骖鸾。\n传柑错忆红云殿，缕菜惊看白玉盘。\n官柳野梅俱在眼，莫教长笛倚阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4469,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和邓沃泉宪副元夕","author":"黄佐","text":"升平灯火几喧阗，笑指东风十二年。\n陆海鱼龙春变化，艳阳桃李夜暄妍。\n镐京尚忆红云宴，郢曲遥传白雪篇。\n同是江湖怀圣主，步随明月望尧天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4470,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春赠别李仪部四首 其一","author":"黄佐","text":"离梦摇摇倦倚阑，江城春共一尊残。\n马前红雨真堪驻，鸿外青山正耐看。\n粤国龙蛇蟠大泽，汉家卿相满长安。\n趋朝好在南薰殿，莫待金风吹玉鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4471,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春赠别李仪部四首 其二","author":"黄佐","text":"满院樱桃齐作花，柳条袅娜牵风斜。\n即看春事遽如许，自信吾生安可涯。\n南国浮云供伏枕，北山孤鹤望移家。\n酒阑相送柴门莫，月满遥林明钓沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4472,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春赠别李仪部四首 其三","author":"黄佐","text":"石门云树浩悠悠，鸿雁拚飞并彩舟。\n君去可堪还北望，此心无尽亦东流。\n月明桂馆烟花晓，风落榆关笳鼓秋。\n倾倒渌尊频看剑，江湖何处有离忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4473,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春赠别李仪部四首 其四","author":"黄佐","text":"荔子红时风满枝，彤云飘忽望京师。\n瑶坛晓日銮舆度，珠树微凉彩仗移。\n北阙已新周典礼，南宫曾识汉官仪。\n十年畎亩丹心在，跂尔承恩向玉墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4474,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"草堂酌别刘仙令","author":"黄佐","text":"东方之日赤轮囷，照我庭前双树根。\n仙凫到门化飞舄，神鱼入网开清尊。\n南归暂与山水会，北去莫受风尘昏。\n玉墀青琐寄消息，夜夜梅花劳梦魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4475,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春醉游","author":"黄佐","text":"东风飘飘吹絮衣，沉醉不忧生计微。\n粤台云朗木客啸，珠寺花深江燕飞。\n山川有恨天相罩，薇蕨无言春自晖。\n已抛簪弁逐渔钓，浩浩放歌明月矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4476,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登观海楼醉后作","author":"黄佐","text":"逍遥短褐沧洲上，突兀高楼霄汉间。\n潮落鱼龙犹并出，日晴鸥鹭已知还。\n冲帆野色来千里，入座春声殷万山。\n飞絮又随杯酒尽，东风何事亦偷閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4477,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"缁尘","author":"黄佐","text":"缁尘休问旧貂裘，十月轻衫试薄游。\n春事只看芳草变，清尊聊尽白云求。\n雪车冰柱燕山路，枫叶芦花楚水舟。\n偶忆少年成独笑，夜调玄鹤上丹丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4478,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别黄子章北上次铁桥司马韵二首 其一","author":"黄佐","text":"沙头寒日照津旗，南雁初飞北棹移。\n谢客池塘新入梦，于门车马重相期。\n江湖冉冉冰霜尽，花柳欣欣雨露私。\n春近可堪人渐远，停云应是渺予思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4479,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别黄子章北上次铁桥司马韵二首 其二","author":"黄佐","text":"芙蓉阙下绾银章，彩笔当年逐俊良。\n沙苑月明驰骏足，掖垣花暗散鹓行。\n西山爽气朝应在，南海遗珠夜有光。\n若到凤池相问讯，扁舟今在白云乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4480,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"粤王台怀古二首用王李二子韵 其一","author":"黄佐","text":"粤城秋日转觚棱，与客登台感废兴。\n孤鸟迥随云影没，野花寒带露华凝。\n楼船有路天低海，剑玺无踪谷变陵。\n留得当年歌舞地，断猿清夜啸烟藤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4481,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"粤王台怀古二首用王李二子韵 其二","author":"黄佐","text":"百年天地静风尘，吊古临觞莫怆神。\n鸟雀似闻弦管夜，云霞犹见绮罗春。\n湟关北去元通汉，肄水南来不向秦。\n绝胜楚台暮摇落，白蘋空对独醒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4482,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梦游洞庭作","author":"黄佐","text":"瑶台今夕侍宸游，五色云中驾彩虬。\n银汉有章回紫极，碧天如幕护皇州。\n未央日转芙蓉殿，太液波涵翡翠楼。\n欲奏霓裳先按舞，凤笙吹彻洞庭秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4483,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送程太史舜敷二首 其一","author":"黄佐","text":"十月露葵青满溪，嘤嘤山鸟向人啼。\n梯飙直与鸾霄近，步壑回看象纬低。\n池上引杯玄鹤舞，花边多烛紫骝嘶。\n湘弦一奏清商曲，离思如云暗柳堤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4484,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送程太史舜敷二首 其二","author":"黄佐","text":"供奉当年紫禁东，扁舟吾已谢鹓鸿。\n烟花北望开秦苑，江海东流绕汉宫。\n婺郡趋庭双舄远，粤台倾盖一尊同。\n白头迟尔青冥翼，兴在骊驹感慨中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4485,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦雨","author":"黄佐","text":"即看苍翠逐人来，何限藩篱向水开。\n北极云烟连粤树，南溟波浪接燕台。\n蘅皋惯见蛟龙舞，草屋长闻燕雀回。\n自笑野夫贫亦得，小楼高枕胜蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4486,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日方氏园池小集分韵得狂字","author":"黄佐","text":"宝月团团山雾黄，薰风拂拂水烟苍。\n尊前白纻翻新调，槛外红蕖妒艳妆。\n柳榭拂云来鹳鹤，兰桡冲雨散鸳鸯。\n习池金谷风流在，谁道江湖放酒狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4487,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋白莲沼上见月","author":"黄佐","text":"穆穆金波照玉泉，人间天上共婵娟。\n云移宝镜初离匣，风定骊珠正在渊。\n万里河山看桂阙，九霄环佩听娥仙。\n芙蓉不为烟霜老，更觉光辉异昔年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4488,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜卧疾","author":"黄佐","text":"西风瑟瑟到芙蓉，寒入琼楼十二重。\n极浦云烟连朔雁，满城砧杵间疏钟。\n宫中思妇歌秋扇，塞上征人望夕烽。\n何事文园止消渴，金盘应有露华浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4489,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"腊月立春感怀次梁南皋韵三首 其一","author":"黄佐","text":"岁晚春阳开淑景，海滨林薄振暄风。\n朱门杂沓笙歌里，皂帽逍遥水石中。\n南国暖回莺易至，北河冰结鹢难通。\n沉香亭上花应发，谁奏清平入汉宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4490,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"腊月立春感怀次梁南皋韵三首 其二","author":"黄佐","text":"粤城歌吹晓纷纷，隐几萧条实饱闻。\n生菜又从年里见，彩花曾向御前分。\n有情北雁随迟日，无赖西郊自密云。\n最羡梁鸿诗律好，五噫何事怅离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4491,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"腊月立春感怀次梁南皋韵三首 其三","author":"黄佐","text":"萱草淩寒先自生，皋禽掠暖复交鸣。\n百年未满秖须醉，万事逢新殊可惊。\n楚地雪霜当岭尽，粤台云物到春明。\n登临一笑人间世，犹有沧浪堪濯缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4492,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游泰泉席上与陈京兆天游邓宪副沃泉分韵得文字","author":"黄佐","text":"一尊何处可论文，买得青山近白云。\n野色不随秋气改，松涛长共涧声闻。\n剪茅渐作花三径，种稻频来鹤数群。\n吟眺不知仙客去，满林萝月白纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4493,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]