[{"title":"扈跸词三十二首 其二十六","author":"陆深","text":"御笔分程意最深，相兼七日到河阴。\n凡情亦有思乡急，何况君王社稷心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2124,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸词三十二首 其二十七","author":"陆深","text":"旧路重经不厌多，龙舟衔尾俟黄河。\n天心却与人心合，若比来时气更和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2125,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸词三十二首 泊黄河二首 其二十八","author":"陆深","text":"元帅旌旗护六飞，河南河北尽光辉。\n追趋侍从联舟发，欢喜都人大驾归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2126,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸词三十二首 其二十九","author":"陆深","text":"兼程通夕雨还风，却望行宫信未通。\n文武先行遵诏旨，好浮新霁镜光中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2127,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸词三十二首 其三十 赵州闻柏乡驻跸","author":"陆深","text":"回銮分日第邮程，御辇常兼四站行。\n圣旨特怜人马乏，柏乡驻跸道栾城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2128,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸词三十二首 其三十一 良乡行宫候驾","author":"陆深","text":"青山叠叠绕行宫，万骑千官四面风。\n綵绣趋跄灯影下，旂常摇曳月明中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2129,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸词三十二首 其三十二 发良乡","author":"陆深","text":"红日西飞白马东，锦袍织带从官同。\n亲知相见如相问，日有新诗纪圣功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2130,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桂洲夜宴出青州山查荐茗色味佳绝","author":"陆深","text":"岩背山椒一万株，青州糖毬天下无。\n火龙行雨归东海，抛却红明颔下珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2131,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张家湾棹歌四首 其一","author":"陆深","text":"当年海运数朱张，湾泊帆樯正渺茫。\n帮着擢船愁水涩，隔舱相唤剥南粮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2132,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张家湾棹歌四首 其二","author":"陆深","text":"转湾脱堑水生衣，惆怅轻船载月归。\n约略寄居三百石，尽拈香纸礼天妃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2133,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张家湾棹歌四首 其三","author":"陆深","text":"百年漕运最称能，今岁河洪见未曾。\n司马中丞新领敕，圣神天子坐中兴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2134,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张家湾棹歌四首 其四","author":"陆深","text":"张湾水出北山头，十里洪身九里洲。\n惟有老渔知进退，深滩撒网浅滩揫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2135,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天津棹歌六首 其一","author":"陆深","text":"擘除军饷顾长夫，北上南来愁直沽。\n十只画船如屋大，火忙飞票报前途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2136,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天津棹歌六首 其二","author":"陆深","text":"垂杨覆水晚湖平，箬笠蓑衣一棹轻。\n何处官船初解缆，抄关给廪唱花名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2137,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天津棹歌六首 其三","author":"陆深","text":"满船箫鼓载春归，燕子衔泥掠岸飞。\n杨柳风多黄鸟健，桃花水涨白鱼肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2138,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天津棹歌六首 其四","author":"陆深","text":"拍拍襟怀泼泼身，南来北去尽通津。\n何如平地千层浪，无影无形愁杀人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2139,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天津棹歌六首 其五","author":"陆深","text":"船头青雀碧纱帏，樯上黄旗猎猎飞。\n中贵少年纡蟒玉，南京差遣进龙衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2140,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天津棹歌六首 其六","author":"陆深","text":"一沟黑马百泉东，万里黄河五月终。\n南运未离淮海岸，北船难上吕梁洪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2141,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送鹤池出镇贵阳拟铙歌二首 其一","author":"陆深","text":"将军开阃向西南，文渊孔明今成三。\n草绿辕门春昼永，磊落兵谈如手谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2142,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送鹤池出镇贵阳拟铙歌二首 其二","author":"陆深","text":"汉武开边到渥洼，张骞奉使上星槎。\n何如将军今日去，蹀?龙驹烂五花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2143,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭拟太祖高皇帝孝慈高皇后上册乐章 其一 迎神","author":"陆深","text":"惟皇高祖，英灵在天。\n神功大化，裕后光前。\n寝庙俨若，音容僾然。\n竭我孝思，以格于重。\n玄云车龙，驭髣髴盘。\n旋与乾元，同运何万。\n斯年肃以，跂予若有。\n见焉永佑，予小子对。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2144,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭拟太祖高皇帝孝慈高皇后上册乐章 其二 初献","author":"陆深","text":"俎豆既陈，酒醴维清。\n既戒既慄，明德允升。\n孝孙始奠，庶展精诚。\n鸿称徽号，听于无声。\n昭格可冀，绥我思成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2145,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭拟太祖高皇帝孝慈高皇后上册乐章 其三 亚献","author":"陆深","text":"载酌载献，惟圣顾歆。\n庭陈万舞，乐备八音。\n端冕有恪，以表予一。\n心灵风习，习祗拜钦。\n钦大礼斯，举有壬有。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2146,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭拟太祖高皇帝孝慈高皇后上册乐章 其四 终献","author":"陆深","text":"神降伊迩，终秩有严。\n三爵既右，百礼具瞻。\n惠我多福，以让以谦。\n罔极难报，感惧载兼。\n洋洋皇祖，如见兮厌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2147,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭拟太祖高皇帝孝慈高皇后上册乐章 其五 彻馔","author":"陆深","text":"奠献既备，敬彻不迟。\n亦有馀休，默鉴在兹。\n肃雍显相，益秉孝思。\n我祖我妣，惠我恩慈。\n仰德无替，终事有仪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2148,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭拟太祖高皇帝孝慈高皇后上册乐章 其六 还宫","author":"陆深","text":"祀事孔明，神休滋锡。\n孝孙有庆，法宫云适。\n心虔体和，礼严境寂。\n景云祥风，荏苒翚翟。\n抚此瑶图，永膺宝历。\n于万斯年，过庙必惕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2149,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌秋明堂礼成庆成宴乐章七首 其一 万岁乐","author":"陆深","text":"风调雨顺秋光好。\n启明堂、吾皇有道。\n尊亲飨帝多仁孝。\n际昌期成大报。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2150,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌秋明堂礼成庆成宴乐章七首 其二 朝天子","author":"陆深","text":"宫悬绣帘，黼座黄金殿。\n雕龙彩凤簇琼筵，湛露初沾宴。\n尧舜重逢，唐虞再见。\n五云天，御炉烟，遥瞻圣颜，雉尾开宫扇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2151,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌秋明堂礼成庆成宴乐章七首 其三 水龙吟","author":"陆深","text":"五色祥云拥六龙。\n开禁殿，列臣工。\n主恩皇泽，礼乐象成功。\n文华物采，极天风动。\n万国来朝贡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2152,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌秋明堂礼成庆成宴乐章七首 其四 一奏开明堂之曲","author":"陆深","text":"大礼候昌朝。\n崇孝敬，正宗祧。\n钧天声里韵箫韶。\n金殿凌云切紫霄。\n圣君万寿，臣节百僚。\n愿上华封谣。\n仰祝唐尧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2153,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌秋明堂礼成庆成宴乐章七首 其五 四边静","author":"陆深","text":"国祚万年。\n礼乐重光一统天。\n玳瑁筵，麒麟殿。\n瑞霭祥烟，圣主开恩燕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2154,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌秋明堂礼成庆成宴乐章七首 其六 凤鸾吟","author":"陆深","text":"时文圣明运中兴，道太清。\n业敷天，功扶世，治化升平。\n和神人，靖边境，叙彝伦，协咸英。\n一德秉精诚。\n璇衡齐，七政享，明堂大典斯成。\n奠玉帛，洁粢盛，妥神灵，兆休应。\n报深恩，罔极难名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2155,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌秋明堂礼成庆成宴乐章七首 其七 万岁乐","author":"陆深","text":"鹓联鹭序臣拜舞。\n荷醲恩躬逢圣主。\n配天勋业高千古。\n同声祝，文共武。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2156,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其一 万岁乐","author":"陆深","text":"五百昌期嘉庆会。\n启圣皇龙飞天位。\n九州四海重华日，大明朝，万万世。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2157,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其二 朝天子","author":"陆深","text":"满前瑞烟，香绕蓬莱殿。\n风回韶律鼓渊渊，列陛旌旗绚。\n日至朱躔，阳生赤殿。\n气融和，彻上玄，历年万千，长庆天宫宴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2158,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其三 水龙吟","author":"陆深","text":"宝殿金炉瑞霭浮。\n陈玉案，列珍羞。\n天花炫彩，照耀翠云裘。\n鸾歌凤舞，虞廷乐奏。\n万岁君王寿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2159,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其四 一奏上万寿之曲","author":"陆深","text":"圣主垂衣裳。\n兴礼乐，迈虞唐。\n箫韶九成仪凤凰。\n日月中天照八荒。\n民安物阜，时和岁康。\n上奉万年觞。\n胤祚无疆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2160,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其五 四边静","author":"陆深","text":"天启嘉祥。\n圣主中兴正纪纲。\n颂洋洋，功荡荡。\n国运隆昌，万载皇图壮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2161,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其六 凤鸾吟","author":"陆深","text":"维皇上天佑圣明，景命宣。\n五云辉，三台润，七纬光悬。\n协气生，嘉祥见，正万民，用群贤。\n垂衮御经筵。\n宵衣勤，政殿礼，圜丘大祀精虔。\n明水洁，苍璧圆。\n秉周文，承殷荐。\n眷皇家，亿万斯年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2162,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其七 二奏仰天恩之曲","author":"陆深","text":"皇穹启圣神。\n钦乾运，祗郊禋。\n一阳初动霭先春。\n万福来，同仰至仁。\n祥开日月，瑞见星辰。\n礼乐协神人，宇宙咸新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2163,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其八 水龙吟","author":"陆深","text":"春满雕盘献玉桃。\n葭管动，日轮高。\n熹微霁色，遥映衮龙袍。\n千官舞蹈，钧韶迭奏。\n曲度升平调。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2164,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其九 水龙吟","author":"陆深","text":"紫禁琼筵煖应冬。\n骖八螭，乘六龙。\n玉卮琼斝，黻座献重瞳。\n尧天广运，舜云飞动。\n喜听赓歌颂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2165,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其十 太清歌","author":"陆深","text":"长至日，开黄道。\n喜乾坤佳气，阳长阴消。\n奏钧韶音调。\n凤轸律协鸾箫。\n仰龙颜天日，表如舜如尧。\n金炉烟煖御香飘，玉墀晴霁祥光绕。\n宫梅苑柳迎春好，燕乐蓬莱岛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2166,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其十一 上清歌","author":"陆深","text":"云捧宸居，五星光映三台丽。\n仰日月层霄霁。\n日月层霄霁，中兴重见唐虞际。\n太和元气自阳回，兆姓欢愉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2167,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其十二 开天门","author":"陆深","text":"九重霄。\n日转皇州绕。\n燕天家，共歌鱼藻。\n龙鳞雉尾彩云高。\n祝圣寿，庆清朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2168,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其十三 御銮歌","author":"陆深","text":"雅奏乐升平。\n瞻绛阙，集瑶京。\n黄童白叟喜气盈。\n讴歌鼓舞四海宁。\n金芝结秀，玉树含英。\n听康衢，击壤声。\n帝力难名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2169,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其十四 贺圣朝","author":"陆深","text":"华夷一统，万国来同。\n献方物，修庭贡。\n远慕皇风。\n自南自北自西自东。\n望天宫。\n佳气郁重重。\n四灵毕至，麟凤龟龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2170,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其十五 殿前欢","author":"陆深","text":"瑞云晴霭浮宫殿。\n一脉阳和转。\n礼成交泰开周宴。\n凤笙调，龙幄展。\n天心感格人欢忭。\n四海讴歌遍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2171,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其十六 庆丰年","author":"陆深","text":"赖皇天，锡丰年。\n勤禹稼，力舜田。\n喜慰三农，愿嘉禾秀瑞麦鲜。\n赋九州，贡八埏。\n神仓御廪咸充满，养民以养贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2172,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其十七 新水令","author":"陆深","text":"圣德精禋格昊穹。\n一大统，四夷来贡。\n玉帛捧，文轨同。\n世际昌隆。\n共听舆人颂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2173,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其十八 太平令","author":"陆深","text":"诞明禋天监元后。\n光四表，惠泽周流。\n来四裔，趋前拥后。\n献万宝，充庭盈囿。\n稽首顿首。\n天高地厚。\n祝圣人，多男福寿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2174,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其十九 三奏感昊德之曲","author":"陆深","text":"昊德运光明。\n一阳动，万物生。\n升中大报苍璧陈，礼崇乐畅歆太清。\n星悬紫极，日丽璇庭。\n乾坤瑞气盈。\n海宇安宁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2175,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其二十 新水令","author":"陆深","text":"五云深护九重城。\n感洪恩，一人有庆。\n阳初长，礼方行。\n帝德文明。\n表率家邦正。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2176,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其二十一 水仙子","author":"陆深","text":"万方安堵乐康宁。\n九域同仁荷圣明。\n千年抚运承天命。\n露垂甘，河献清。\n见双岐秀麦连茎。\n喜雪随冬应。\n睹祥云拂曙生。\n神与化，并运同行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2177,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其二十二 四奏民乐生之曲","author":"陆深","text":"大报礼初成。\n象乾德，运皇诚。\n神州赤县永清宁。\n灵雨和风乐太平。\n阴阳交畅，品物咸亨。\n元化自流行。\n允殖群生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2178,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其二十三 水龙吟","author":"陆深","text":"五色祥云捧玉皇。\n开阊阖，坐明光。\n钧天乐奏，冬日御筵张。\n文恬武熙，太平气象。\n人在唐虞上。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2179,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其二十四 水龙吟","author":"陆深","text":"玉律阳回景运新。\n燕镐京，蔼皇仁。\n光昭云汉，一气沸韶英。\n锦瑟和声，瑶琴清韵。\n瞻仰天颜近。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2180,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其二十五 太清歌","author":"陆深","text":"万方民，乐时雍。\n鼓舞荷天工。\n雷行风动喜今逢。\n南蛮北貊东夷西戎。\n来朝贡，大明宫。\n星罗斗拱，九重天上六飞龙。\n五色云间双彩凤，普天率土效华封。\n允协河清颂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2181,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其二十六 庆太平","author":"陆深","text":"惟天眷我圣明。\n礼圜丘，至德精诚。\n乾元永，清洪膺。\n景命休徵。\n应泰阶平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2182,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其二十七 千秋岁","author":"陆深","text":"圣主乘龙御万邦。\n庆云翔，化日重光。\n群臣拜舞称寿觞。\n载歌天保章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2183,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其二十八 滚绣毬","author":"陆深","text":"五云车，度九重。\n利见飞龙。\n耀衮章，火藻华虫。\n击虎敔考，凫钟鼍鼓逄逄。\n八珍列，九鼎丰隆。\n尧眉扬彩舜重瞳。\n万国咸熙四海雍。\n齐歌颂，圣德神功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2184,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其二十九 殿前欢","author":"陆深","text":"万年礼乐中兴，日大化，睹重熙。\n河清海晏臻祥瑞。\n五行顺，七政齐。\n超三迈，五贞元会。\n既醉颂凫鹥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2185,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其三十 天下乐","author":"陆深","text":"万灵朝拱接清都。\n享南郊，钦天法祖。\n愿圣人，承乾纳祜。\n中和位育，龟范马陈图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2186,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其三十一 醉太平","author":"陆深","text":"醉乐万年规。\n讴歌四海熙。\n衣冠蹈舞九龙墀。\n丽正仰南离。\n紫云高捧唐虞帝。\n垂衣天下文明治。\n镐乌岐凤呈嘉瑞。\n真个是，人在成周世。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2187,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其三十二 五奏感皇恩之曲","author":"陆深","text":"双阙五星光。\n霓旌树，紫盖张。\n璇台玉历转新阳。\n钧天广乐谐宫商。\n恩深露湛，喜溢霞觞。\n日月焕龙章。\n地久天长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2188,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌冬至南郊礼成庆成宴乐章四十九首 其三十三 六奏庆丰年之曲","author":"陆深","text":"圣主懋承乾。\n绥万邦，屡丰年。\n神仓御廪登大田。\n明粢郁鬯祀孔虔。\n舆情咸豫，协气用宣。\n万古帝图传。\n璧合珠联。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2189,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]