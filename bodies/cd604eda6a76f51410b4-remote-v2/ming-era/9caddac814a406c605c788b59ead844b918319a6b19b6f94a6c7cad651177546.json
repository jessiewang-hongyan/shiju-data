:"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25312,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"甘棠里遇山人粟千钟见道傍奇峰问其名举无知者戏赠一绝","author":"刘崧","text":"行尽翁源山万重，高人喜遇粟千钟。\n可怜老却观书眼，不识云间一个峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25313,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"下人阳乌石二泷初闻猿声二绝 其一","author":"刘崧","text":"万石崩腾互犬牙，两山盘沓欲横遮。\n泷流直下三千尺，不见船头见浪花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25314,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"下人阳乌石二泷初闻猿声二绝 其二","author":"刘崧","text":"白日青崖烟雾生，深林绝涧少人行。\n残年乌石泷头路，听得山猿第一声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25315,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过德庆忆万户刘公衡","author":"刘崧","text":"锦裹石前江水流，故人曾此戍康州。\n当年旌节随云散，尚对山花识旧游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25316,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]