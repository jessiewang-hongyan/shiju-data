[{"title":"戏咏红锦帐","author":"刘崧","text":"红锦帐子薄于纱，四壁清风汎綵霞。\n昨夜月明春梦熟，误吹长笛入桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25238,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"偶见","author":"刘崧","text":"槐树阴阴雨满池，晚风滟滟绿生漪。\n槎头出水才三尺，便有蜻蜓立许时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25239,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"池上偶赋","author":"刘崧","text":"画栏碧树午阴斜，小扇微风拂帽纱。\n最怜一时春水绿，不教五月看荷花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25240,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"溪上晚眺","author":"刘崧","text":"槿花蓬门处处同，行人桥外各西东。\n荒原斜日牛羊下，一路西风蒴藋红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25241,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"珠湖","author":"刘崧","text":"珠湖湖里蚌生珠，野老传言定有无。\n昨夜月明湖上望，一川寒色秀菰蒲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25242,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初闻木樨","author":"刘崧","text":"老桂初开试一枝，吹香时有外人知。\n深林尽日何当见，自是秋风不敢私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25243,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初闻木樨","author":"刘崧","text":"连云长爱绿团团，一片清阴九夏寒。\n自有秋香三万斛，何人更向月中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25244,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜送伯衢别","author":"刘崧","text":"山风吹落桂花枝，江上停杯欲别迟。\n半夜酒醒柔橹发，一篷烟雨过平陂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25245,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出石门滩舟行书所见七首 其一","author":"刘崧","text":"石门滩下浪如雷，西岸人家夕照催。\n乱石满江滩路浅，唱歌踏水负薪来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25246,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出石门滩舟行书所见七首 其二","author":"刘崧","text":"石潭秋水漾清萍，两岸青山夹去津。\n钩箭缠丝挟长弩，柳阴时见射鱼人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25247,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出石门滩舟行书所见七首 其三","author":"刘崧","text":"龙福渡头滩最高，断桥崩石鼓秋涛。\n小船不敢当江下，独傍洲湾送短篙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25248,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出石门滩舟行书所见七首 其四","author":"刘崧","text":"秋雨生苔绿正肥，江心石面暗浮衣。\n渔人网罟应难下，野鸭鸬鹚满钓矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25249,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出石门滩舟行书所见七首 其五","author":"刘崧","text":"马颊庙前江水长，马头石下绿潭光。\n出山估客来求卜，抛纸放船浇酒香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25250,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出石门滩舟行书所见七首 其六","author":"刘崧","text":"沙岸崩时惟见石，江流曲处却逢山。\n荒林野屋元星散，古路行人自往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25251,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出石门滩舟行书所见七首 其七","author":"刘崧","text":"放船出峡遇回风，石角参差尽向东。\n贪看好山如走马，不知波浪入船中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25252,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过平陂望南平王庙","author":"刘崧","text":"阳台石下水离离，梦阁犹传故老知。\n千载神游竟何往，满江明月照荒祠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25253,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题温日观蒲萄","author":"刘崧","text":"老人醉墨走蛇虬，风露潇潇数叶秋。\n无复驼囊盛马乳，却教图画忆凉州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25254,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五岳道士携至故人梁仲闻诗因和奉答","author":"刘崧","text":"朝真坛上月明时，白鹤归来见好诗。\n三月青塘芳草路，十年风雨最相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25255,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题雪竹","author":"刘崧","text":"筼筜谷中三日雪，深林无人鸟飞绝。\n翩翩翠袖出岩阿，路转风回闻佩玦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25256,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题雨竹","author":"刘崧","text":"沧波石面晚阴凉，翠筱娟娟过雨香。\n何许鹧鸪啼不断，黄陵祠下是三湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25257,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题石竹","author":"刘崧","text":"翠叶枝低雨过时，钓台石上影离离。\n记得月明江浦夜，舟人解唱竹枝词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25258,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题墨竹","author":"刘崧","text":"石边修竹两三竿，渭水萧森暮色寒。\n会见秋风吹结实，凤皇吹下五云端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25259,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"为郭吟所题竹","author":"刘崧","text":"长丰隐者年八十，种竹满林皆老苍。\n莫将翠玉轻裁管，留取长竿钓渭阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25260,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋南园敧笋","author":"刘崧","text":"秾花嫩蕊各争春，乳燕鸣鸠亦恼人。\n偃蹇南园敧竹笋，独依榛藋蔽閒身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25261,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题伯衢扇","author":"刘崧","text":"华山收雨两江晴，夏竹屯云一径清。\n门外绿阴眠野鹿，隔帘时听打棋声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25262,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题扇画","author":"刘崧","text":"玉露凋伤赤岸枫，寒江月落雁呼风。\n谁知茅屋荒山夜，亦有长吟抱膝翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25263,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻莺","author":"刘崧","text":"雾雨初晴万竹低，莺声彷佛度前溪。\n忽然飞去无人见，却在绿杨深处啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25264,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观禾川新涨","author":"刘崧","text":"胜乡三日雨如秋，两江新水拍山流。\n长杉短筏不敢下，怕有蛟龙乘夜游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25265,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上闻莺","author":"刘崧","text":"宣华西上是敖城，江水弓弯复镜平。\n五月行人西岭下，满山青树只闻莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25266,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谩题","author":"刘崧","text":"为谢高阳旧酒徒，相逢从此莫言酤。\n野鸟不知官禁苦，向人犹自说提壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25267,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉和吟所翁二首 其一","author":"刘崧","text":"苍颜皓首一癯翁，谈笑衣冠有晋风。\n昨夜卷书灯下看，眼明犹自辨鱼虫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25268,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉和吟所翁二首 其二","author":"刘崧","text":"林间净扫白云眠，萧散宁为外物怜。\n自说东华年少梦，千金歌舞看花前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25269,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"松棚","author":"刘崧","text":"高架松棚荫绿苔，忽看片影上层台。\n可缘畏日翻嫌月，并隔清光不入来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25270,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖上曲","author":"刘崧","text":"湖阴微雨裛新妆，隔浦风来水气香。\n閒凭船舷不归去，绿荷花底看鸳鸯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25271,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖上曲","author":"刘崧","text":"绿荷缭绕水为城，十里红云照眼明。\n不知昨夜花开满，清晓船来不可行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25272,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖上曲","author":"刘崧","text":"郎船夜傍隔溪云，清晓看花不见君。\n自拨兰桡唱歌去，却嫌荷叶混罗裙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25273,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖上曲","author":"刘崧","text":"新莲乍出即昂头，叶底红菱不解浮。\n菱角沉泥终暗老，莲花落尽即漂流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25274,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖上曲","author":"刘崧","text":"鸂鶒双飞乱绿蘋，画船终日倚湖滨。\n泥中踏藕何由得，水上看花恼杀人。","collection":"明","notice":"","prove