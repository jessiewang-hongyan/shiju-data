[{"title":"答王中丞元美郧阳见寄三首 其二","author":"欧大任","text":"郧乡西北望秦中，楚客悲秋赋自工。\n七泽旌旗新校猎，登台何处不雄风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答王中丞元美郧阳见寄三首 其三","author":"欧大任","text":"执法廷中汉列卿，三年持钺镇方城。\n归来好就长杨草，扈从君王大阅兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀西樵吟送梁生南还二首 其一","author":"欧大任","text":"大科峰顶听山鸡，日出沧溟雾不迷。\n赠尔金闺双綵笔，为余题遍碧云西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀西樵吟送梁生南还二首 其二","author":"欧大任","text":"西樵千丈望罗浮，十载藏书尚有楼。\n蓟北归人凭问信，七松明月铁泉秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伏日李明府邀游邓园水亭同刘宪使王太仆分得边多衣寒四韵 其一","author":"欧大任","text":"小舟能送酒如泉，七十鸳鸯五色莲。\n似是看花韦杜客，凤城宫殿曲江边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伏日李明府邀游邓园水亭同刘宪使王太仆分得边多衣寒四韵 其二","author":"欧大任","text":"玉泉流水入官河，公子园林爱客过。\n罗袜淩波骄不得，芙蓉偏在露寒多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伏日李明府邀游邓园水亭同刘宪使王太仆分得边多衣寒四韵 其三","author":"欧大任","text":"割肉金门满袖归，朔来沾醉湿宫衣。\n晚凉浴马荷花荡，鸂鶒鸬鹚惯不飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伏日李明府邀游邓园水亭同刘宪使王太仆分得边多衣寒四韵 其四","author":"欧大任","text":"采菱艇子钓鱼竿，万柳堤平六月寒。\n太白原西金谷路，醉来浑作五湖看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题朱贞吉瀑泉图","author":"欧大任","text":"西望青天挂玉龙，风来飞洒石门松。\n罗浮归客将寻汝，沐发匡庐第一峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送马用昭还闽中四首 其一","author":"欧大任","text":"并门回首太行山，公子翩翩一骑还。\n夜斫探丸朝蹴鞠，谁能驰逐五陵间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送马用昭还闽中四首 其二","author":"欧大任","text":"剧辛乐毅已尘埃，突兀昭王百尺台。\n多少涓人求骏马，黄金能不待君来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送马用昭还闽中四首 其三","author":"欧大任","text":"何事喑呜鞘里鸣，幽州年少猎冠缨。\n青天不断鲛龙气，尽作延平浦上声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送马用昭还闽中四首 其四","author":"欧大任","text":"公车奏牍竟如何，綵笔纵横意气多。\n归去钓鱼沧海上，九仙秋色郁嵯峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜过北海子堤上","author":"欧大任","text":"玉泉流入汉宫墙，十里金堤半是霜。\n马上不知身是客，月明犹似过江乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送恩上人归白下","author":"欧大任","text":"清公已作五台僧，雪浪君今挂一藤。\n京洛浮云弹指过，头陀归对佛前灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题日本人画王母图","author":"欧大任","text":"西望瑶池五色霞，海东开遍露桃花。\n长安自昔神仙宅，青鸟飞来入汉家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题沈周画渔父问屈原图","author":"欧大任","text":"避世吾堪老一蓑，江潭憔悴尔如何。\n远游未可南疑去，犹及沧浪咏九歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送华光禄致仕归无锡","author":"欧大任","text":"监州不向古虔台，一疏辞天拂袖回。\n闻道步兵家有酒，寻君期访二泉来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答丘潮州二首 其一","author":"欧大任","text":"南望潮阳百粤偏，楚乡犹隔路三千。\n故人不谓君侯远，恩在黄金拜赐年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答丘潮州二首 其二","author":"欧大任","text":"蜃楼直接郡楼高，一片黏天万里涛。\n横海戈船功不细，知君频看鸊鹈刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洗砚东庄","author":"欧大任","text":"砚庄流水绕柴门，泼剌游鱼墨可吞。\n纵有红尘飞不到，依然何胤一家村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"彩云江阁","author":"欧大任","text":"阁上书声江上闻，峤南人识孝廉君。\n衣冠此日朝明主，带得彤墀五色云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题琵琶图","author":"欧大任","text":"香山伊水不禁秋，况是浔阳九派流。\n一曲琵琶弹夜月，教人无赖忆江州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吕心文宰泰兴二首 其一","author":"欧大任","text":"邑中湖荡稻田多，花月春江奈乐何。\n趋府若寻杨子渡，为余行听竹西歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吕心文宰泰兴二首 其二","author":"欧大任","text":"天目崚嶒吴越间，分符借得海陵山。\n知君不薄淮南令，诏下长安计日还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舍弟经季山人华甫从子及游西山还同于善果寺送别子及因怀虎臣二首 其一","author":"欧大任","text":"五月西山积雪阴，荷花荷叶玉湖深。\n君行采寄吴郎去，一片江南塞北心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舍弟经季山人华甫从子及游西山还同于善果寺送别子及因怀虎臣二首 其二","author":"欧大任","text":"十日饮从河朔来，离歌犹击唾壶哀。\n酒徒若挟金陵过，问筑糟丘何处台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7142,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题王进士子牧琼林宴归图二首 其一","author":"欧大任","text":"赐对彤墀子大夫，家传经学冠西都。\n宫袍绿映浮云骑，谁似蒲州五色驹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7143,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题王进士子牧琼林宴归图二首 其二","author":"欧大任","text":"红杏花开柳欲丝，曲江春色醉归时。\n金鞭策过蛮夷邸，尽指郎君似太师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7144,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答张山人勤夫见寄二首 其一","author":"欧大任","text":"伏生九十尔堪俦，莫学陶公不下楼。\n我欲挂冠神武上，日移烟艇共沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7145,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答张山人勤夫见寄二首 其二","author":"欧大任","text":"青螺山畔老烟霞，十载题诗处士家。\n招隐劳君书万里，春来不用寄梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7146,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠胡仲子二首 其一","author":"欧大任","text":"曾于酒颂识刘伶，岂但东方是岁星。\n双鬓又看霜草白，不妨江海托鸿冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7147,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠胡仲子二首 其二","author":"欧大任","text":"侠游燕市紫骝嘶，三尺芙蓉手自携。\n何限青山招隐去，苍茫秋色大鄣西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7148,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送文子初还虎丘读书梅花楼二首 其一","author":"欧大任","text":"名山君去卧烟霞，文苑风流更几家。\n已报江南春最早，楼前千树尽梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7149,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送文子初还虎丘读书梅花楼二首 其二","author":"欧大任","text":"海涌山前一草庐，下帷三箧有藏书。\n五经他日咨同异，来共诸儒讲石渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7150,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄文休承","author":"欧大任","text":"十载金门共尔趋，今闻矍铄老姑苏。\n太丘乡行康成学，谁信名儒在五湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7151,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送灵璧汤五侯督运漕河四首 其一","author":"欧大任","text":"河山带砺汉诸侯，供亿军储寔借筹。\n应向平江祠下过，凿渠今得护千艘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7152,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送灵璧汤五侯督运漕河四首 其二","author":"欧大任","text":"大淮东下接黄河，功比当年瓠子多。\n治粟舳舻衔尾入，黄旗珠纛照烟波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7153,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送灵璧汤五侯督运漕河四首 其三","author":"欧大任","text":"岁岁江南百万来，飞帆扬子急如雷。\n太仓红积纲头雪，又报均输一度回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7154,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送灵璧汤五侯督运漕河四首 其四","author":"欧大任","text":"漕河运道上燕都，身佩元戎赤虎符。\n给饷萧何功不细，九边飞挽足防胡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7155,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过巩华城二首 其一","author":"欧大任","text":"汉家仙仗七陵东，步辇曾留五祚宫。\n边燧不来犹望幸，玉窗珠户绣帘栊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7156,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过巩华城二首 其二","author":"欧大任","text":"胡马鸳鸯赭白肥，射生年少半绯衣。\n城边尘暗长杨路，玉勒秋田校猎归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7157,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十日答张光禄送菊二首 其一","author":"欧大任","text":"昨日同君醉摘花，宅边今日似陶家。\n独醒却笑颜光禄，不送金钱送绛霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7158,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十日答张光禄送菊二首 其二","author":"欧大任","text":"卷绯蹙绣额涂黄，亦到青毡学士堂。\n聊与幽人慰岑寂，风流谁道在柴桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7159,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同汤尧文朱子忠看菊二首 其一","author":"欧大任","text":"拒霜花傍石阑干，家有青毡坐不寒。\n闻道宜城新酿熟，应知不厌客频看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7160,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同汤尧文朱子忠看菊二首 其二","author":"欧大任","text":"盏为黄花送几巡，夜深烧烛尚留宾。\n独怜不敢登坛赋，五鹿偏愁折角巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7161,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初雪高僚长升伯见过","author":"欧大任","text":"急风快雪满燕台，萧寺柴门午始开。\n童子惊看乘兴客，王猷新自剡溪来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7162,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中同诸僚携酒过马伯懋宅","author":"欧大任","text":"绛帐青毡事不平，郑虔何似马先生。\n广文新馆千门雪，羸得同官载酒行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7163,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何生赴塞上","author":"欧大任","text":"投笔新持金仆姑，漠南秋散五单于。\n男儿一障酬恩日，还拜君王丈二殳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7164,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马上口占","author":"欧大任","text":"岭南何但隔天涯，只见长安不见家。\n马上风尘犹是客，年年空自忆梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7165,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黎君华宰定陶四首 其一","author":"欧大任","text":"百里曹南祢水头，东方千骑拥君侯。\n桑阴雉雊春风细，此乐何劳羡爽鸠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7166,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黎君华宰定陶四首 其二","author":"欧大任","text":"陶邑诸侯地四通，衣冠海岱故称雄。\n宰官问俗兼能赋，更似泱泱大国风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7167,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黎君华宰定陶四首 其三","author":"欧大任","text":"使君飞盖雪花残，四野行春路不寒。\n谁共山公时载酒，范家湖作习池看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7168,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黎君华宰定陶四首 其四","author":"欧大任","text":"游猎呼鹰出孟诸，万家歌吹足储胥。\n偃师召对今何日，赐有君王尺一书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7169,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题马远画菜","author":"欧大任","text":"篱门膏雨一畦春，酒醒偏宜菜甲新。\n谁似先生盘苜蓿，于陵甘作灌园人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7170,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"司马曾公见过不值留诗壁上次韵 其一","author":"欧大任","text":"杖藜宁问路何之，应客山童午未炊。\n不谓故人能枉驾，自怜犹愧子云奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7171,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"司马曾公见过不值留诗壁上次韵 其二","author":"欧大任","text":"蛟龙壁上有新诗，匡鼎归来一解颐。\n门巷已甘车马绝，白云秋色见旌麾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7172,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻张助甫乞归不允二首 其一","author":"欧大任","text":"建节凉州万里回，若为乞取铁丘台。\n江南大似淮南日，强为君王卧治来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7173,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻张助甫乞归不允二首 其二","author":"欧大任","text":"固陵一疏拟求閒，开府恩深未许还。\n岂但六州军事重，借君题遍九华山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7174,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送礼上人游五台却还金陵 其一","author":"欧大任","text":"是心是佛闭吾关，何事文殊坐不还。\n师见此中禅悦处，千竿修竹五台山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7175,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送礼上人游五台却还金陵 其二","author":"欧大任","text":"泠泠苍玉洒毫端，雪作天花石作坛。\n识是清凉吾自性，归来明月满长干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7176,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登塔","author":"欧大任","text":"华胥国在弇州西，七圣何为路尚迷。\n稽首五云台百尺，竺乾今有化人栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7177,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"慈寿寺","author":"欧大任","text":"千佛祝釐山下听，中天百尺似明庭。\n太行不断西来色，长送甘泉万岁青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7178,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西塞曲","author":"欧大任","text":"绝漠烧荒汉使还，秋风先到贺兰山。\n大宛大马年年入，谁道丸泥闭玉关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7179,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十月桃","author":"欧大任","text":"十月新尝内苑桃，雪中青颗满神皋。\n曾看结子三千岁，归向君王乞斗醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7180,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题礼公墨竹赠洪元虚","author":"欧大任","text":"梅是沙弥蜜是师，长干弟子已传衣。\n毫端无数青鸾尾，半似瑶池月下飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7181,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张光禄元易使边因述其五载供事之荣辄得六首 其一","author":"欧大任","text":"阙下千官貂玉间，羡君簪笏侍仙班。\n五云深护蓬莱殿，宫扇开时识圣颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7182,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张光禄元易使边因述其五载供事之荣辄得六首 其二","author":"欧大任","text":"天寿山前原庙开，千盘王气郁崔嵬。\n皇家岁遣朝陵使，记得松阴策马回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7183,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张光禄元易使边因述其五载供事之荣辄得六首 其三","author":"欧大任","text":"九译来宾尽入朝，欢传宴犒下云霄。\n大官颁给蒲萄酒，赞谒夷玉半赐貂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7184,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张光禄元易使边因述其五载供事之荣辄得六首 其四","author":"欧大任","text":"园里芭蕉曙色晴，北扉给札奏书成。\n先朝实录来焚稿，曾傍词臣雁字行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7185,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张光禄元易使边因述其五载供事之荣辄得六首 其五","author":"欧大任","text":"长秋正位卜婚年，妫汭涂山内教先。\n夹陛看君嘉礼使，至尊亲遣御楼前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7186,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张光禄元易使边因述其五载供事之荣辄得六首 其六","author":"欧大任","text":"张旃西去出榆关，蜀锦吴罗市马还。\n家有令公新纳节，白头应问贺兰山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7187,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顾玄言以游赤城诸作见寄漫赋四首 其一","author":"欧大任","text":"石梁飞雪赤城霞，察岭欢溪处士家。\n金策君曾鸣玉过，西流曲曲尽桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7188,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顾玄言以游赤城诸作见寄漫赋四首 其二","author":"欧大任","text":"铁船硖过洞犹封，石绾双鬟翠几重。\n玉女紫霄三万丈，晓妆天镜浸芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7189,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顾玄言以游赤城诸作见寄漫赋四首 其三","author":"欧大任","text":"海上仙人华顶行，闾丘太守乍相迎。\n琼台双阙中天起，常有云霞五色明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7190,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顾玄言以游赤城诸作见寄漫赋四首 其四","author":"欧大任","text":"北望雁山门户开，大龙湫下昼如雷。\n金庭咫尺群真会，茅狗何年更一来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7191,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]