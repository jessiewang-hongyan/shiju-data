[{"title":"己酉科七月初送三男赴试","author":"张天赋","text":"岩花甘雨报新秋，行李光芒剑气浮。\n弱干自惭榱桷用，灵枝汝可栋梁收。\n老龙渡上通南海，健笔场中占上头。\n何日泥金好消息，菊花香里醉金瓯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3978,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己酉季十日雨雪忆孙环山进士","author":"张天赋","text":"曾试京师踏雪时，环山共酌共赓诗。\n数千百里聚萍梗，一十八年违面眉。\n踪迹自怜终草莽，功勋谁擅上穷碑。\n五更风雪闻敲瓦，沼沚浓兰有所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3979,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"用前韵答王塔溪来简","author":"张天赋","text":"病怀耿耿有怀时，秪诵停云采葛诗。\n云树各天怜夜榻，羹墙每自见庞眉。\n引年塔上擎仙掌，遗爱山西堕泪碑。\n展诵一缄多启迪，顿令洗却渴尘思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3980,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次前韵怀大宗伯盛程斋因柬塔溪相及云","author":"张天赋","text":"拜翁越王台下时，挥毫曾赋曲江诗。\n忠肝永作千秋鉴，龙衮先瞻八彩眉。\n家学凤麟昭世瑞，天朝金石勒功碑。\n高山深切终身仰，何日抠衣慰所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3981,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"程斋书荐泉州同安庠友用前韵","author":"张天赋","text":"帆拖云影过潮时，喜带梅花陆凯诗。\n白石应知藏白玉，绿窗终见绿娥眉。\n金兰幸订百年约，玉屑期谈八字碑。\n双眼望洋徒老恨，美人何以慰吾思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3982,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东涧自象山致政归田诗以贺之","author":"张天赋","text":"楚归老病卧柴关，无日心旌不象山。\n扶教昔怜同困苦，投簪今喜共安閒。\n棠阴春盎遗千古，淅水官清羡一般。\n洛社迩来多寂寞，海头天放鹤飞还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3983,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邑侯陶涟洲诗来云欲致政且喜其欲建河桥","author":"张天赋","text":"渡口纷纷问渡船，未容停棹系厓边。\n喜驱白石长虹跨，争似青龙短竹编。\n击楫渡江誇壮志，捕风捉影陋虚禅。\n野人拭目林皋下，花满江城月满天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3984,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和陶公感秋次前韵","author":"张天赋","text":"白云扰扰起楼船，梧叶初惊落井边。\n莼菜谩劳思故国，梨花端合读遗编。\n风波浪里宜持柁，歌舞场中莫讲禅。\n治行秪今谁第一，循良拟是汉家天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3985,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次前韵奉陶公","author":"张天赋","text":"莫向湘江恋钓船，试思身世属谁边。\n一方民物归陶冶，千古循良续汉编。\n雨露暖融春似锦，门庭清净寂如禅。\n醉来仰卧东篱下，明月弦歌百里天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3986,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵写怀 其一","author":"张天赋","text":"罢钓归来不系船，浅滩曳止蓼花边。\n乾坤纵我疏狂醉，月旦从人品第编。\n路有荆榛怜碍脚，门无释衲可谈禅。\n几时得向仙郎问，何处人间更有天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3987,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵写怀 其二","author":"张天赋","text":"陆无车马水无船，依傍山前与水边。\n朝出课农耕绿野，夜归训子读青编。\n纷纷蕉鹿徒劳梦，了了机心懒坐禅。\n世界看来浑缺陷，且拚沉醉菊花天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3988,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵写怀 其三","author":"张天赋","text":"欲买青山与钓船，紫芝鲈脍口傍边。\n休论昔日非今日，且注长编及短编。\n千古采薇成个是，一桴浮海岂如禅。\n焚香读易心如洗，勘破先天与后天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3989,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又写怀 其一","author":"张天赋","text":"寒江鸥鸟共忘机，半榻閒云梦已痴。\n得意风光随日遣，无言造化许谁知。\n俄惊世态装新局，渴想灵丹医病脾。\n咫尺故人千里外，虚窗明月满梁西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3990,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又写怀 其二","author":"张天赋","text":"谢事来归不与公，山斋门径白云封。\n喜将兰桂栽庭下，羞把须眉对镜中。\n世事看同花上露，情怀落在柳边风。\n空中楼阁层层上，仰止无名太古翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3991,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又写怀 其三","author":"张天赋","text":"坐老山斋觉病侵，一天鱼鸟障氛尘。\n雕虫深愧苏公学，负米宁辞子路贫。\n蕙芷得时香楚畹，江离有幸傍阳春。\n梅花无分离骚卷，路远何凭达美人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3992,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次长沙胡一松韵借梅花写怀奉答","author":"张天赋","text":"系马江梅问楚津，恍然疑假又疑真。\n吐枝满缀如檠玉，落地平铺似集鳞。\n踏雪风情推孟老，调羹手段让商人。\n南洲相望渺何许，折寄临风意似醺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3993,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和胡介石掌教立春写怀","author":"张天赋","text":"运转三阳推去阴，杏坛春暖锦成林。\n墨池化雨无穷妙，学海惊澜莫测深。\n转眼瓜期当有待，思家魂梦莫相侵。\n天涯万里逢乡曲，星斗同倾北望心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3994,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次一松山人过司徒岭韵写怀","author":"张天赋","text":"浮云作态弄晴阴，芳草无情碍马行。\n恰值歌停闻短笛，忽当林断遇宽坪。\n閒花野草无边趣，秋水长天一色清。\n棋局正酣柯木烂，寒江何日结鸥盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3995,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端溪谒包孝肃公祠","author":"张天赋","text":"关节当年透不过，人间真信有阎罗。\n千金赢得名珍重，一砚看来价几何。\n紫石树碑扬妙墨，碧天明月湛秋波。\n祠前车马纷纷也，顽懦曾知感激么。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3996,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送孔白石掌教","author":"张天赋","text":"开辟文章第一家，悠悠教化泽无涯。\n灵苗秀气钟来异，清世奇才喜会嘉。\n自笑半生觔力软，谁云东鲁路头赊。\n相思后夜知何处，梦绕门墙月影斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3997,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"承邑侯黄龙坡请乡饮使来诗以辞之","author":"张天赋","text":"白发潇潇两鬓皤，南山北山枳棘多。\n等閒欲梦不成梦，快活要歌才放歌。\n世道看来今若此，人情复望更如何。\n玉函盥手焚香诵，报答君侯别网罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3998,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题碧湖池边六柱亭","author":"张天赋","text":"异卉奇花映碧湖，湖干亭对白云居。\n周遭翠色群峰合，隔断红尘半点无。\n风静安閒玄鹤梦，月明清浸夜光珠。\n桃花浪煖天雷雨，争看池中变化鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3999,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与番禺黎练溪","author":"张天赋","text":"六载寒斋莫接颜，云林真是隔尘寰。\n蓬莱今信原无路，弱水谁云更有山。\n太极庭前春荏苒，华封顶上月安閒。\n仙翁采药天台去，何日乘风跨鹤还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4000,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"门人吴贯索勉诗静中有感一律晓之","author":"张天赋","text":"老大乾坤理在人，人从何处认天真。\n梧桐杨柳看时景，月窟天根辨主宾。\n六位莫非三极道，无端都是一丸春。\n胸中活水常教滚，谁谓商霖做不成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4001,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺弄璋","author":"张天赋","text":"天际云收现彩虹，郁葱佳气绕堂中。\n骊珠捧出欺明月，秀气钟来并圣童。\n宁邑共誇生俊杰，采花应见续豪雄。\n与君俱遂南山约，八句诗成兴未终。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4002,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丙戌冬末彻讲诸生送至老龙而别赋遗之","author":"张天赋","text":"灯火相亲几夜阑，点金愧我乏灵丹。\n梅花初霁枝头雪，桂棹同翻海上澜。\n打约蚤登周世岸，分携当记老龙滩。\n休嗟吾道无南汝，体认都从一念间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4003,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登重驿亭次余寒谷韵","author":"张天赋","text":"劲节无妨远瘴侵，光风满眼拂香尘。\n百年谁识纲常重，万里人甘道义贫。\n野鹤谩酬青嶂梦，老龙深蛰碧潭春。\n登楼一笑成诗赋，不把风流学楚人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4004,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵写怀","author":"张天赋","text":"登眺玄龙百尺楼，浩歌惊破洞庭秋。\n霏霏滴耳檐前雨，落落屠龙海上舟。\n世态随时更旧局，风光为我遣閒愁。\n仙人黄鹤归何处，欲借遨游遍十洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4005,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀穷神道人我广黎练溪二丈","author":"张天赋","text":"西有穷神东练溪，吾居于此间东西。\n诗怀练老开余兴，易学昌翁指我迷。\n莫道山川殊气习，应知豪杰共襟期。\n何当夜榻同三老，话到樽前月落时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4006,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵送雷师傅行","author":"张天赋","text":"天风颠倒越江滨，眼底轮云局面新。\n正拟凭栏大观海，俄惊啼鸟倍伤春。\n临岐此日应难别，遗教终身不失亲。\n后夜武夷峰顶月，秋旻遥望是丰神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4007,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵送双湖还潮","author":"张天赋","text":"拭目神龙出海头，白云飞绕气相求。\n江亭难别歌离曲，岸柳无缘系去舟。\n衣钵浚源流泽远，行囊带月剑光浮。\n春风次第花消息，为问多情肯寄不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4008,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答双湖","author":"张天赋","text":"方塘活水引源头，有志商霖此处求。\n遇陆必腾追电马，临流须作济川舟。\n风恬上水天机发，月照虚窗夜气浮。\n世道好时鸡唱早，闻声曾学祖生不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4009,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邹中舍介石过访一律归之","author":"张天赋","text":"山斋微雨送新凉，老倦抛书梦正长。\n柳外忽惊人系马，花间喜见蝶寻香。\n斯文骨肉无今古，世变江河有异常。\n介石远来应有意，莫辞诗酒伴疏狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4010,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"墨庄十有为庐陵高半穷神道人题","author":"张天赋","text":"寂寂无声太古弦，先天冥会坐端然。\n光风霁月从烹炼，春蚓秋蛇共蜿蜒。\n生意两间归范冶，广寒平地见婵娟。\n清泉白石堪脩禊，笔砚终身结好缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4011,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒中写怀","author":"张天赋","text":"笑指青山头不白，古今见尽白头人。\n从来那个人长主，百岁教谁我后身。\n云树潇疏泉石梦，莺花寂寞洞天春。\n年来欲学纯阳诀，跨鹤翩翩过洞庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4012,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和邑博林吴航韵四首录二 其一","author":"张天赋","text":"天马真空冀北群，吴江枫落协前闻。\n词源鬼泣并神泣，义理更分与漏分。\n樗栎却怜多类我，梅花翻恨不如君。\n一缄拜领焚香诵，似在春风北面论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4013,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和邑博林吴航韵四首录二 其二","author":"张天赋","text":"笑狎沙头鸥鸟群，鸾翔凤翥不相闻。\n水天月色人何在，渔火江风夜半分。\n爱我有情能识我，见君无地却思君。\n六经煨烬难凭据，同向先天妙处论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4014,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长乐邓东峰诗来和以答之论学","author":"张天赋","text":"只拳提起破玄机，唤醒惺惺旧梦痴。\n自我一身全太极，何人千古认良知。\n高攀月窟开心目，清吸山泉洗胃脾。\n周岸共登无障碍，坦行南北与东西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4015,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵写怀","author":"张天赋","text":"六十五年又遇春，独怜过半百年人。\n难将事业酬天债，莫遣丹青写我神。\n箫鼓儿童争闹热，梅花月色共清新。\n高朋满座人如玉，爱我还须识我真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4016,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵论为学自得之趣与杨子泰唐","author":"张天赋","text":"满眼韶光共看春，个中得趣独何人。\n地无限也天无禁，我有情兮花有神。\n泉水源深方达远，芭蕉心尽又添新。\n生生认到无穷处，万紫千红总是真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4017,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"螺峰别号与洪司训题次其韵也 其一","author":"张天赋","text":"插空突兀仰螺峰，八表溶溶淑气冲。\n色映落霞丹穴并，顶悬孤月夜光同。\n高操星斗文章笔，妙合风云变动功。\n桃李春融沾化雨，可人红白万花丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4018,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"螺峰别号与洪司训题次其韵也 其二","author":"张天赋","text":"振衣崔嵬千仞峰，大鹏直上九霄冲。\n苏湖教铎规模别，沂水春风乐事同。\n天地经常凭作主，栋梁榱桷看收功。\n名园万紫千红境，携我同观锦绣丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4019,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次莆友王次溪见示潮州金山迁建周元公祠落成次大尹颜双塘韵四首录三 其一","author":"张天赋","text":"远水危岑彻望收，青青庭草结清幽。\n欲将太极从头认，直向先天未画求。\n一气浑沦常迭运，六虚变动自周流。\n千年海岳精英地，何处乾坤更十洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4020,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次莆友王次溪见示潮州金山迁建周元公祠落成次大尹颜双塘韵四首录三 其二","author":"张天赋","text":"望洋白首恨难禁，仰止高山足未临。\n杲日漏光虚室白，春风摇绿草堂深。\n异端欲使无炎烬，吾道休教有陆沉。\n活泼天机在何处，数声啼鸟绿阴阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4021,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次莆友王次溪见示潮州金山迁建周元公祠落成次大尹颜双塘韵四首录三 其三","author":"张天赋","text":"高祠瞻拜恨无缘，几度羹墙思俨然。\n好调莺啼脩竹里，清流水绕画栏前。\n四时草合金山地，十丈花开玉井莲。\n太极生生何所拟，一轮月落万千川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4022,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄覆泉州安溪年兄詹晴溪 其一","author":"张天赋","text":"曾向秦淮共问津，几多家国话投真。\n却怜清世文章客，閒作炎荒草莽臣。\n沂水拟寻曾点乐，首阳甘受伯夷贫。\n小春梅报先天信，谩折征鸿寄美人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4023,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄覆泉州安溪年兄詹晴溪 其二","author":"张天赋","text":"越峤迢迢与楚津，行行如梦半虚真。\n宣尼有道甘环辙，孟氏何心肯致臣。\n蹠纵百年难谓寿，颜虽如洗未为贫。\n胸中自有灵丹在，不问街头卖药人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4024,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李和山来韵寄素庵兄转达","author":"张天赋","text":"红蓼滩头系钓舟，故人不见几生愁。\n月明洞口鹤初转，风静江心水自流。\n南国文场悲往屈，武宗实录忆同脩。\n金陵夜半平南话，怎得青春再壮游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4025,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀永丰秋江刘浩然","author":"张天赋","text":"少共疏狂忆浩然，今为何处地行仙。\n金龟欲换长安酒，铁笛空吹落洞天。\n月照剡溪怜有兴，辖投陈井叹无缘。\n凭谁跨鹤秋江上，把手招来醉瓮边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4026,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"择术","author":"张天赋","text":"屠龙海上驾空船，经岁无龙可近边。\n三载始能成技艺，千金空费授师编。\n挥戈退舍浑从梦，炼石驱鳌却类禅。\n双眼举头天咫尺，此天天外更无天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4027,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次黎练溪来韵","author":"张天赋","text":"愧负初期铁砚穿，沧江今弄钓鱼船。\n交投友分兼师分，乐在花边与柳边。\n蒲涧白云斟绿醑，河南春茗煮青天。\n潇潇白发东西路，何日重逢了宿缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4028,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵漫兴","author":"张天赋","text":"不将閒事乱心头，漫向清虚试讲求。\n朱明半夜见红日，武夷五曲驾涸舟。\n古云窃药月中去，谁睹来山海上浮。\n安得面问东方朔，蟠桃许我学偷不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4029,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"袁州偕郡博两川郭进士陈平斋胡前溪邑博陈阳山潘木斋窦益斋兴贤楼共饮观竞渡","author":"张天赋","text":"秀江桥下浪头开，兴贤楼上酒今催。\n齐声着力鼓棹去，拍掌浩歌夺锦回。\n未必百年逢百度，何缘同志聚同堆。\n马蹄明日东西路，廊庙山林莫浪猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4030,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十九夜到袁州念九发舟承五台邀邑博陈阳山潘木斋窦益斋临流饯别复遣使送至江滨一律谢之","author":"张天赋","text":"宜春台下放行舟，酌别多君谩习酬。\n三叠阳关歌浩浩，一溪杨柳水悠悠。\n君期奋迹三层浪，我仰齐云百尺楼。\n脚板此行无障碍，项斯到处说风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4031,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登最高亭","author":"张天赋","text":"山城微雨夜生凉，月上山头喜复光。\n荆棘已除当日秽，桂兰新放九秋香。\n岩花带笑留人醉，野鹤忘机见客忙。\n遥指西郊在乾上，美人平地着黄裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4032,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平川别号为庐陵宗侄介题","author":"张天赋","text":"不是飞淙十八滩，悠悠一派绕银山。\n晴波荡漾天光动，止水沉潜夜月寒。\n自在船如天上坐，虚明人似镜中看。\n此情更向晴江问，春水新添几寸澜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4033,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送郭君坤简归江西","author":"张天赋","text":"十年别去坐层山，一旦乘风渡粤关。\n笑语未终重解袂，饯行深苦又愁颜。\n相期捧日心诚赤，莫待登云鬓惹斑。\n点检叶冈无所有，梅花高折赠君还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4034,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟宿吊钟潭漏雨","author":"张天赋","text":"欲买兰舟笑乏钱，破篷仰面见青天。\n滴来寒雨何堪苦，惊起游人不得眠。\n梅信有春何日转，柳丝无力被风牵。\n阴晴望下都休管，造化应知不倚偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4035,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜访清贫兄因其出病中之作和似之","author":"张天赋","text":"雪夜遥遥访戴过，故人相见意如何。\n灯前笑语无穷尽，眼底知心有几多。\n松竹丛中增晚趣，梅花香里报阳和。\n壁间神妙谁能测，雷震须臾睹化梭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4036,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"承旧潮阳尹莆田宋公良翰访余于河源文明书院一律别于宝江云","author":"张天赋","text":"拨破浮空万里云，光芒星斗见天文。\n春风何幸来明道，妙墨常怀索右军。\n吊汨有词悲楚客，采芹无路献明君。\n此行后会知何地，忍把槎江醉袂分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4037,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次程雪生都阃韵似之","author":"张天赋","text":"威武将军道德心，阳和到处袭儒林。\n比门分阃恩光渥，东阁开筵气味深。\n事业看君垂竹帛，衷肠幸我托瑶琴。\n万年鱼水春风乐，打破贤关拟共寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4038,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"时事有感","author":"张天赋","text":"举日伊谁重绨袍，江河趋下愈滔滔。\n党碑有屈嗟如晦，天命无知笑伯寮。\n生死是非都一梦，从违冷暖总皆劳。\n贞元自有天然妙，错把繁华看小桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4039,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]