[{"title":"伏暑经桐庐道中 其一","author":"黎民表","text":"清浅无如七里湾，层崖飞瀑下潺潺。\n子陵不为南阳起，赖是清源有此山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6599,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"伏暑经桐庐道中 其二","author":"黎民表","text":"丹霄回首梦魂惊，避暑还催奏赋成。\n沧池何处堪停跸，笑指荷花放舸行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6600,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"伏暑经桐庐道中 其三","author":"黎民表","text":"草烂松枯太剧晴，转多烦热是舟行。\n惊湍夜入还家梦，疑是青林风雨生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6601,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"伏暑经桐庐道中 其四","author":"黎民表","text":"玉盘盛水贮甘瓜，蝉鬓迎风翠袖斜。\n冰水如山供坐客，骄阳不入五侯家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6602,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张元易饮紫菊二首 其一","author":"黎民表","text":"谁倚名园斗丽华，霜风披拂似晴霞。\n不如开落空山里，浅白轻黄靖节家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6603,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张元易饮紫菊二首 其二","author":"黎民表","text":"丛桂秋风若有期，一生铅粉不曾施。\n如何偃蹇东篱下，犹学长安半额眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6604,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李春卿文学之博罗","author":"黎民表","text":"鼓箧诸生待绛纱，不同勾漏远移家。\n天鸡唤醒游仙梦，倒览扶桑五色霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6605,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送传成之文学之闽中","author":"黎民表","text":"日射蓬莱气色高，无诸城下海生涛。\n赋成应有凌云气，台倚仙人旧钓鳌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6606,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"命家僮于庭前杂莳花木戏为九绝 其一","author":"黎民表","text":"南陌东城无限花，竹篱藤架任欹斜。\n柴门亦有閒风景，不道归期已过瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6607,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"命家僮于庭前杂莳花木戏为九绝 其二","author":"黎民表","text":"金谷园中堕绣裀，一枝憔悴可怜春。\n但将酩酊酬高格，不与铅华作后尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6608,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"命家僮于庭前杂莳花木戏为九绝 其三","author":"黎民表","text":"骑马长安日几回，梅黄已过麦秋来。\n蔫红纵好非春色，凭仗东风几日开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6609,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"命家僮于庭前杂莳花木戏为九绝 其四","author":"黎民表","text":"游蜂舞蝶太匆匆，争较繁华一瞬中。\n纵使花开能烂漫，不知荣落总成空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6610,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"命家僮于庭前杂莳花木戏为九绝 其五","author":"黎民表","text":"微雨初睛蓓蕾开，更教长袖夜深回。\n开时正好留连看，待到飘零几客来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6611,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"命家僮于庭前杂莳花木戏为九绝 其六","author":"黎民表","text":"古木长藤半斧痕，霜丛犹自宿篱根。\n烦君着意防风雨，待到深秋发满园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6612,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"命家僮于庭前杂莳花木戏为九绝 其七","author":"黎民表","text":"插槿编篱费讨量，此生穷达任苍苍。\n若教小草看成径，绿竹抽梢已过墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6613,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"命家僮于庭前杂莳花木戏为九绝 其八","author":"黎民表","text":"强半光阴在直庐，莺花笑我太相疏。\n故园亦诧忘归去，不寄长安五月书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6614,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"命家僮于庭前杂莳花木戏为九绝 其九","author":"黎民表","text":"小队红妆结束新，妖娆偏泥远游人。\n纵饶顿逊杯中物，不似铜驼陌上春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6615,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张光禄元易使边兼还河东展省 其一","author":"黎民表","text":"翠釜黄封劳外臣，关门乘传遣词人。\n燕支拜舞君王赐，一曲琵琶绝塞春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6616,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张光禄元易使边兼还河东展省 其二","author":"黎民表","text":"三休亭上狎樵渔，爱子持觞问起居。\n不似东山输别墅，愿从黄石授兵书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张光禄元易使边兼还河东展省 其三","author":"黎民表","text":"单于内属已销兵，瀚海天山夜不惊。\n玉节尽驱龙种至，大宛何必堕重城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张光禄元易使边兼还河东展省 其四","author":"黎民表","text":"马上微吟更击鲜，齐州回望入青烟。\n綵毫奏技明光日，不羡封侯到酒泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张光禄元易使边兼还河东展省 其五","author":"黎民表","text":"貂裘日贳酒垆家，夜半笼灯上日华。\n马湩金杯休醉客，春风思对五陵花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈汝信","author":"黎民表","text":"扬帆万里楚江行，君是无机亦有情。\n千树梅花如问讯，罗浮同看日初生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题天长馆壁 其一","author":"黎民表","text":"日色晓残野草花，行人触热转堪嗟。\n仙瓶自汲清泠水，谁解鹴裘付酒家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题天长馆壁 其二","author":"黎民表","text":"尊酒文园会不稀，五陵豪客自轻肥。\n荒鸡唤醒山邮梦，犹忆更衣入琐闱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邓君肃以菊花见贻口占五绝奉荅 其一","author":"黎民表","text":"燕台几见此花开，急管繁弦处处催。\n篱下白衣虽寂寞，尽教明月照深杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邓君肃以菊花见贻口占五绝奉荅 其二","author":"黎民表","text":"重溟天气煖如春，霜后繁花作意新。\n桃李园中相映发，却将秾艳趁芳尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邓君肃以菊花见贻口占五绝奉荅 其三","author":"黎民表","text":"山人老作灌园翁，手插疏篱玉满丛。\n莫道看花容易得，长年多雨更兼风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邓君肃以菊花见贻口占五绝奉荅 其四","author":"黎民表","text":"篁竹烽烟起战旗，西风迸泪对花枝。\n柴桑便合抽簪去，难得閒田种紫芝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邓君肃以菊花见贻口占五绝奉荅 其五","author":"黎民表","text":"零落西园万片霞，颠狂呼酒醉邻家。\n鵔鸃冠上虽簪却，绝世元称隐士花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"隔墙桃花戏作","author":"黎民表","text":"十日春光偏泥酒，雨中犹见隔墙花。\n丈人已自无机事，莫道东邻是宋家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同君肃少仲公绍开先诸子饮舍弟惟仁宅赠歌者","author":"黎民表","text":"故园杯酒肯辞频，今夜云间月色新。\n不信清歌能醉客，莺花曾见五陵春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和端州太守王君宗鲁七星岩二十景诗 其一 石室龙床","author":"黎民表","text":"紫气冥冥护白龙，玉鳞千载尚留踪。\n天门一去成霖雨，閒却金梯十二重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和端州太守王君宗鲁七星岩二十景诗 其二 沥湖渔棹","author":"黎民表","text":"欸乃渔歌远近闻，青油晴卷沥湖云。\n莲舟荡漾归来晚，笼烛城边候使君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6632,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和端州太守王君宗鲁七星岩二十景诗 其三 虹桥雪浪","author":"黎民表","text":"牛女相望一水中，神人驱石便成虹。\n奔云喷雪三千丈，不是灵槎岂易通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6633,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和端州太守王君宗鲁七星岩二十景诗 其四 天阁晴岚","author":"黎民表","text":"赤阑曲曲绕层台，风荡岚光水倒回。\n一片青天涵石镜，菱歌原未有人来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6634,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和端州太守王君宗鲁七星岩二十景诗 其五 金阙朝阳","author":"黎民表","text":"珠旗掣曳七星文，万壑朝暾射紫云。\n清漏一声犹未歇，星妃如雨导神君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6635,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和端州太守王君宗鲁七星岩二十景诗 其六 宝陀夜月","author":"黎民表","text":"西方初月吐婵娟，湖上轻风罢钓船。\n遥想水晶宫殿里，莲花灯下一僧禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6636,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和端州太守王君宗鲁七星岩二十景诗 其七 星亭拥翠","author":"黎民表","text":"随波上下似蓬壶，白玉楼台天下无。\n惟见七星浮水面，不闻词客赋仙都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和端州太守王君宗鲁七星岩二十景诗 其八 霞岛飞璚","author":"黎民表","text":"丹霞为阙石为扉，玉溜淙淙欲湿衣。\n湖上只开双玉镜，飞璚乘月几时归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和端州太守王君宗鲁七星岩二十景诗 其九 树德松涛","author":"黎民表","text":"幽人伏枕兴无聊，何处翻江作怒潮。\n夜半天鸡惊梦醒，万川明月照空寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和端州太守王君宗鲁七星岩二十景诗 其十 栖云榕阴","author":"黎民表","text":"栽花种柳满溪浔，太守风流苦费心。\n后人指点甘棠树，密叶曾遮十亩阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和端州太守王君宗鲁七星岩二十景诗 其十一 紫洞禅房","author":"黎民表","text":"一半禅栖出翠微，苍苔石滑到天稀。\n西天弦管休回首，只合山门老衲衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和端州太守王君宗鲁七星岩二十景诗 其十二 蓬壶仙径","author":"黎民表","text":"白石参差径路斜，玉壶终日秘青霞。\n紫芝满地无人采，十里风吹古桂花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和端州太守王君宗鲁七星岩二十景诗 其十三 临壑荷香","author":"黎民表","text":"桂棹沿回一水香，秋风吹冷芰荷裳。\n洛神邀得陈王赋，故向瑶池试晓妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和端州太守王君宗鲁七星岩二十景诗 其十四 方塘鱼跃","author":"黎民表","text":"千顷澄波溢作池，为君添作豢鱼陂。\n江湖老去应忘我，只是临流少惠施。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和端州太守王君宗鲁七星岩二十景诗 其十五 杯峰浮玉","author":"黎民表","text":"菱叶荷花素锦铺，中流一点落星孤。\n扁舟曾逐玄真子，呼酒狂歌碧浪湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和端州太守王君宗鲁七星岩二十景诗 其十六 天柱浮虹","author":"黎民表","text":"玉笔高簪黛色浓，海门长日驻高舂。\n世情尽逐颓波去，谁住罗浮四百峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6646,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和端州太守王君宗鲁七星岩二十景诗 其十七 仙掌春风","author":"黎民表","text":"五夜吹班凤沼东，亭亭仙掌立春风。\n蓬蒿寂寞文园里，错忆金盘出汉宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6647,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和端州太守王君宗鲁七星岩二十景诗 其十八 阆岩夕照","author":"黎民表","text":"秋作千峰翠作陵，松间织鸟挂寒藤。\n道人半醉斜阳酒，指点金银最上层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6648,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和端州太守王君宗鲁七星岩二十景诗 其十九 河波泉涌","author":"黎民表","text":"翠壁千重玉斧开，中间一道出风雷。\n若逢李白香炉上，定取银河入酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6649,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和端州太守王君宗鲁七星岩二十景诗 其二十 石洞云封","author":"黎民表","text":"人间日月易飞奔，浪水桃花自一村。\n怕有渔樵来往路，白云长积掩柴门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6650,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送梁少嘉内侄北上 其一","author":"黎民表","text":"鹄沼麟园望不迷，丈夫何事恋卑栖。\n豪游曾结长安客，千里人知碧玉蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6651,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送梁少嘉内侄北上 其二","author":"黎民表","text":"海子荷花十丈开，龙舟避暑未应回。\n无媒亦有江南树，扶荔宫中着意栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6652,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"一苇所如为何太仆作 其一","author":"黎民表","text":"肘后黄金亦可怜，身閒羸卧五湖烟。\n人间纵有瞿塘险，不到芦花钓渚边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6653,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"一苇所如为何太仆作 其二","author":"黎民表","text":"三径谁寻仲蔚家，秋风几度桂松花。\n卧游想到蓬莱阙，一片山窗落海霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6654,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送欧公孙游南雍兼寄其祖虞部公 其一","author":"黎民表","text":"金陵花月不曾空，粽汁曾经饮楮公。\n伏暑梦回茅屋底，何人酤酒话江东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6655,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送欧公孙游南雍兼寄其祖虞部公 其二","author":"黎民表","text":"江夏童年已拜郎，殿前扶侍有辉光。\n冶城高会群公在，白首山林引目长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6656,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"城南夜雨","author":"邱云霄","text":"出宿城南夜，江空雨满舟。\n迟迟风外断，耿耿叶边稠。\n伴柝传山郭，随更下驿楼。\n初程云水近，还作别乡愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6657,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"螺滩","author":"邱云霄","text":"雀舫江声乱，螺滩浪势骄。\n乾坤蕉鹿梦，岁月梗萍漂。\n五里山亭出，孤城烟树遥。\n秋风双鬓外，落木晚萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6658,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归宗岩","author":"邱云霄","text":"鸟道悬空翠，龙筇拂晓寒。\n逶迤回碧嶂，突兀散朱栏。\n怪石云边堕，虬枝雪后看。\n振衣山果落，听法鼎香残。\n庭鹤巢松近，林僧种药还。\n气蒸玄洞湿，珠落古厓丹。\n引火窥仙窦，临河纵大观。\n孤亭摩汉出，斜磴倚云安。\n煮茗游烟细，攀藤着屐难。\n泉幽贪洗耳，天近想飞翰。\n岁晚悲行役，登临兴渺漫。\n浮生无住着，空羡结蒲团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6659,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临江门夜泊","author":"邱云霄","text":"城抱江流急，沙回浪势安。\n烟云归树暝，风雪酿梅寒。\n客梦随更转，溪声入夜残。\n渔翁相傍宿，应笑欲弹冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6660,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登君子楼","author":"邱云霄","text":"落日下平浦，乡心倚莫楼。\n孤台联万井，百雉俯双流。\n衰柳惊行役，浮云近故丘。\n偶因临水意，无语向江鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6661,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅仙山次谢石涌副守韵","author":"邱云霄","text":"仙人去何许，空此青山名。\n我来蹑高云，凛凛神骨清。\n虹亭照空谷，丹井莓苔生。\n如何千载下，无人申此盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6662,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅仙山奉次李古冲宪长春霭凭栏之赠抚昔人之遗踪感高怀于莫既悲怅自失不觉有言 其一","author":"邱云霄","text":"春含翠筱密如城，江拥晴岚蘸水明。\n云护虹亭无客到，石藏丹井为谁清。\n章缝却向青山老，羽翮空怀白日生。\n别后松枝如寄折，报君惟有岁寒盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6663,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅仙山奉次李古冲宪长春霭凭栏之赠抚昔人之遗踪感高怀于莫既悲怅自失不觉有言 其二","author":"邱云霄","text":"解缆殷勤问后期，登楼回首是相思。\n龙唇敢拟钟期调，鹤态宁如叔夜知。\n寒月每随朝北梦，停云欲寄望南诗。\n上林多少卑栖处，幸托春风到一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6664,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过古冲七里别墅因呈","author":"邱云霄","text":"溪山待时胜，云霞本仙宅。\n台控松桂深，花覆行径窄。\n孤舟系潭阴，沙月照林白。\n为问辋川人，来作桃源客。\n主人玄鹤姿，栖息青霄翮。\n欢爱谈夙襟，罗尊重离别。\n揽衣事攀登，坐我心怡悦。\n春熙林气芬，新篁欲抽节。\n清晖已满楼，他时想颜色。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日蹑云岩","author":"邱云霄","text":"野外黄花节，山中绿酒芬。\n晴岚开绝巘，秋意满高云。\n客至妨僧定，樵諠散鹿群。\n幽探成汗漫，尊酒惜馀曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒露同李洗松宿方塘书舍","author":"邱云霄","text":"露重怜今夕，秋深试薄寒。\n溪声乱篱落，月色动柴关。\n菊密欲藏径，花娇故傍栏。\n相看疑梦寐，秉烛问更阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李双溪读书处","author":"邱云霄","text":"径逗山堂静，庭间花木深。\n双流迟岁月，孤阁此登临。\n夜雨疏蕉绿，秋云结柳阴。\n漫谈千古上，应笑二毛侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋尽复南行","author":"邱云霄","text":"寒月浴江水，疏花傲竹林。\n岁惊群物变，秋逐莫江深。\n愁入三山梦，空怀百世心。\n沙鸥浑识面，夜伴建溪浔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]