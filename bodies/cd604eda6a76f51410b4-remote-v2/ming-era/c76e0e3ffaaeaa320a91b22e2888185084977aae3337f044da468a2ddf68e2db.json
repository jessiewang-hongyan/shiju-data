[{"title":"踏清日山行有感 其三","author":"李孙宸","text":"狐狸穿穴走荒原，鬼火阴阴照墓门。\n酹尽酒浆人去后，月明依旧锁黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29665,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"踏清日山行有感 其四","author":"李孙宸","text":"三月山花处处开，提篮山妇暮归来。\n斜插满头欢索笑，不知身为酹坟回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29666,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酹祖墓有感","author":"李孙宸","text":"华表空传鹤驭归，墓前松柏已成围。\n当年手植人何在，肠断饥乌日暮飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29667,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别诗","author":"李孙宸","text":"月夜骊歌酒一卮，花开如亦解愁思。\n冰心自是同明月，夜夜花前照别离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29668,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春江词 其一","author":"李孙宸","text":"春花开遍大江头，花落江边片片浮。\n荡送繁华波面去，枝头谁解惜春愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29669,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春江词 其二","author":"李孙宸","text":"春江二月柳如丝，带雨笼烟晓日迟。\n欲折一枝寄行客，沿堤难见向南枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29670,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春江词 其三","author":"李孙宸","text":"江上春云似舞衣，乱流残照弄晴辉。\n浮云自爱无拘刺，流水年华去不归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29671,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十六夜旅怀","author":"李孙宸","text":"珠海楼头月似霜，故园应得共清光。\n裁书未有刀头约，圆缺遥怜此夜望。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29672,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画","author":"李孙宸","text":"芦汀沙渚杳难分，日与群鸥争白云。\n薄暮得鱼须买醉，姓名犹畏酒家闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29673,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春閒思 其一","author":"李孙宸","text":"南园花柳斗芳菲，野蝶随风祇自飞。\n不是春光吾懒管，花时心事转相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29674,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春閒思 其二","author":"李孙宸","text":"三月之春春未阑，烂漫春花浥露寒。\n已识蹉跎春易老，幽怀终是怯花看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29675,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春閒思 其三","author":"李孙宸","text":"欲写春词寄所欢，所欢如隔碧云端。\n春风处处同骀荡，不念侬家几夜寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29676,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感怀寄友人 其一","author":"李孙宸","text":"误将圆月比襟期，圆缺惟应月自知。\n君道清光原不减，照来蟾影有参差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29677,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感怀寄友人 其二","author":"李孙宸","text":"曙色迟迟听杜鹃，午风漠漠见莺迁。\n韶华总似君心掷，不用怜芳怨岁年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29678,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感怀寄友人 其三","author":"李孙宸","text":"江边吾欲荡兰舟，雨雨风风殊未休。\n纵有芙蓉芳可采，不如相逐大江流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29679,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感怀寄友人 其四","author":"李孙宸","text":"万缕千丝抽渐匀，思君多在柳园春。\n欲将折寄烦相忆，未必君情似柳新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29680,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感怀寄友人 其五","author":"李孙宸","text":"门临溪水接瑶池，池上仙人旧有期。\n安得侬如池畔草，奉君长醉紫霞卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29681,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居六绝 其一","author":"李孙宸","text":"新营半亩寄林邱，种竹移花事事幽。\n差可旧游寻酒伴，知无骑马客相求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29682,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居六绝 其二","author":"李孙宸","text":"辟径还留蔓草肥，野人原自惜芳菲。\n焚香小怪儿童懒，高枕从他过客稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29683,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居六绝 其三","author":"李孙宸","text":"午风初指睡初醒，酒伴相寻到水亭。\n既醉不教乘月去，新蝉偏爱与君听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29684,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居六绝 其四","author":"李孙宸","text":"方沼潜通地肺开，新潮朝暮去还回。\n瀑流况接前山近，一夜飞泉滚滚来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29685,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居六绝 其五","author":"李孙宸","text":"斗酒閒携问绿阴，黄鹂树树送清音。\n饶他鼓吹诗肠得，懒慢无心学苦吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29686,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居六绝 其六","author":"李孙宸","text":"穷身受享偏宜少，懒性经营岂得多。\n负郭何须盈二顷，三餐但足不知他。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29687,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"有感漫成六绝 其一","author":"李孙宸","text":"肯以生涯傍世人，百年石火幻中身。\n今朝且把柴荆闭，扫地焚香谢俗尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29688,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"有感漫成六绝 其二","author":"李孙宸","text":"閒身原不是漂零，睡足东窗鸟唤醒。\n三径何时过二仲，杜门聊自草玄经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29689,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"有感漫成六绝 其三","author":"李孙宸","text":"莫说逃虚意未真，世情何处不风尘。\n十年亦有莲池在，谁解青云藉故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29690,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"有感漫成六绝 其四","author":"李孙宸","text":"笔砚尘封卷乱抛，荒芜三径懒诛茅。\n但便短榻高吾枕，不用玄亭解客嘲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29691,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"有感漫成六绝 其五","author":"李孙宸","text":"流水门前谁问津，碧桃开落不知春。\n儿童莫漫惊鸡犬，恐有人疑是避秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29692,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"有感漫成六绝 其六","author":"李孙宸","text":"纵横曾忆少年场，醉拥如花解骕骦。\n若问豪华何处减，佛前新供一枝杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29693,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"圆榄山有双树连枝者下有古墓存焉与诸子异而赋之 其一","author":"李孙宸","text":"双根古木接枝垂，下有荒坟事可疑。\n应是芳魂曾未死，故将幽恨表连枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29694,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"圆榄山有双树连枝者下有古墓存焉与诸子异而赋之 其二","author":"李孙宸","text":"想像泉台事岂真，来生未尽宿生因。\n人间欢合随流水，得似双枝岁岁新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29695,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"圆榄山有双树连枝者下有古墓存焉与诸子异而赋之 其三","author":"李孙宸","text":"白杨烟雨昼冥迷，何处牛羊下古堤。\n独有关情双□□，春来偏傍墓枝栖。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29696,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同诸子寻梅偶得一花八出者因成二绝 其一","author":"李孙宸","text":"共访山梅雪后香，几枝六出媚斜阳。\n最怜粉黛相倾处，更遣双娥入艳妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29697,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同诸子寻梅偶得一花八出者因成二绝 其二","author":"李孙宸","text":"玉质浓将雪里团，开时谁为剪冰纨。\n疏窗八面玲珑处，插向庭中片片看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29698,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"木芙蓉","author":"李孙宸","text":"晓妆初绾玉笼纱，渐映朝阳绚彩霞。\n任说夹城香十里，何如湘岸一枝斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29699,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杜鹃花","author":"李孙宸","text":"鹤林仙药自年年，漫以开时号杜鹃。\n玉女不劳珍护惜，老僧欲普钵中传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29700,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酴醾","author":"李孙宸","text":"玉面檀心暗吐香，涂黄争妒汉宫妆。\n薰人欲醉浑无力，说甚琉璃杯未尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29701,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"安石榴 其一","author":"李孙宸","text":"十八年来汉使槎，名花憔悴度龙沙。\n一枝映水珊瑚媚，疑是瑶台宴彩霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29702,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"安石榴 其二","author":"李孙宸","text":"鲁女东窗指绛衣，锦房初擘雪为肌。\n当筵乍发清歌齿，多少金茎望露晞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29703,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"葵花","author":"李孙宸","text":"檀心国色比姚黄，几度风前刺道装。\n自是丹心偏向日，露华先得领秋光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29704,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉簪花","author":"李孙宸","text":"风前浴罢澹妆新，玉质偏宜碾未匀。\n堕珥共怜西阿母，搔头还妒李夫人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29705,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"槿花","author":"李孙宸","text":"秋蕣开时绚晓光，飘零曾不待斜阳。\n花前不用深相惜，底事催人总自忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29706,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海棠花","author":"李孙宸","text":"蜀都浓淡满千枝，何事希传杜甫诗。\n欲识今人肠断处，沈香亭畔未醒时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29707,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梨花","author":"李孙宸","text":"渐暖柔芳出锦闱，梦回残月思依依。\n春深未少飘零恨，自托风前燕子飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29708,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"牡丹","author":"李孙宸","text":"天香原自擅花王，何用雕阑百宝妆。\n怪杀清平新乐府，浪传倾国倚沈香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29709,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水仙花","author":"李孙宸","text":"江滨妃子俨成行，几向花前扫澹妆。\n为谢春风相披拂，解将玉佩赠东皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29710,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"茉莉花","author":"李孙宸","text":"南海移栽岁月深，夜凉芳露湿罗襟。\n休将暗麝怜香腻，记取西来不染心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29711,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桂花","author":"李孙宸","text":"岭外秋清瘴乍消，小山赋就隐同招。\n月寒几夜霜华落，祇恐仙娥灵药彫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29712,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"菊花","author":"李孙宸","text":"浅白轻黄秋露团，落英犹共楚臣餐。\n莫疑三径开偏晚，为与群芳殿岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29713,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兰花","author":"李孙宸","text":"九畹原誇大国香，秋江几度浥风光。\n应知不为当门掷，自爱无人理素芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29714,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桃花","author":"李孙宸","text":"度索移根几度开，东风吹暖到池台。\n武陵得入秦人洞，绝胜天边和露栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29715,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李花","author":"李孙宸","text":"成蹊源伴碧桃春，缟练还怜艳独新。\n陌上风光最相惜，歌秾几处动香尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29716,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蔷薇","author":"李孙宸","text":"濯锦啼妆紫玉肌，花期相恋每牵衣。\n莫愁故蕊随风散，尚有香魂伴客归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29717,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉兰花","author":"李孙宸","text":"澧浦湘皋浅碧花，国香原不借群葩。\n不知谁傍蓝田种，尽向金茎浥露华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29718,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辛彝花","author":"李孙宸","text":"紫苞红艳韩家花，二月春光压槛斜。\n知是江郎清梦后，彩毫浮动赤城霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29719,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瑞香","author":"李孙宸","text":"万绿丛中蹴绛裳，晓寒犹似怯春霜。\n却怜惠远栽莲吐，尚负庐山梦里香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29720,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"芦花","author":"李孙宸","text":"秋风绿水漾明霞，瑟瑟菰芦两岸花。\n带雨沈波人不到，钓船深处夕阳斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29721,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蓼花","author":"李孙宸","text":"两岸西风拂蓼花，轻红缕粟蘸晴沙。\n秋怀清绝秋江晚，自绾花枝系客槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29722,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金凤花","author":"李孙宸","text":"金吐钗头缕粟微，九苞五彩竞光辉。\n移根莫傍梧桐植，恐向朝阳结队飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29723,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"萱花","author":"李孙宸","text":"浥露原同蔓草披，修茎应不混凡枝。\n今人但爱朱华艳，说甚忘忧总未知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29724,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"芭蕉","author":"李孙宸","text":"芳心密捲细抽红，叶叶依阑扇晚风。\n最恨夜来疏雨过，凄清偏入梦魂中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29725,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柳","author":"李孙宸","text":"春风杨柳变江湄，织雨笼烟不自持。\n莫漫风流比张绪，年来扳折不成丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29726,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莲花","author":"李孙宸","text":"采莲朝暮荡长湖，莲叶如轮子似珠。\n寄问麻姑花解变，可能开作并头无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29727,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杏花","author":"李孙宸","text":"东风前殿几枝开，不用君王羯鼓催。\n寄语曲江春宴客，莫教轻负倚云栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29728,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏署中即事 其一","author":"李孙宸","text":"新蝉嘒嘒苑墙西，柳色辞寒缕渐齐。\n玉署昼长无所事，彩毫閒弄课新题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29729,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏署中即事 其二","author":"李孙宸","text":"梅雨阴阴逼署清，论文散帙有馀情。\n最怜黄鸟如相识，日送枝头唤友声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29730,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏署中即事 其三","author":"李孙宸","text":"薰风初拂小瀛洲，洲畔清流接御沟。\n帝泽从来深似海，恩波先沐凤池头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29731,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏署中即事 其四","author":"李孙宸","text":"藤花已谢绿阴稠，数啭流莺雨乍收。\n信好词臣供奉地，白云镇日锁清幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29732,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过孟尝君养士处","author":"李孙宸","text":"狗吠鸡鸣客未非，居然虎口脱危机。\n不知万乘齐廷相，何似相如一璧归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29733,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过白乐天琵琶亭 其一","author":"李孙宸","text":"日暮浔阳古渡头，芦花瑟瑟似含秋。\n悬知司马江州泪，不为琵琶也自流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29734,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过白乐天琵琶亭 其二","author":"李孙宸","text":"含情相对感漂零，谱入琵琶曲里听。\n一别扁舟何处去，空馀江上使君亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29735,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过白乐天琵琶亭 其三","author":"李孙宸","text":"远山如黛鬓云缄，水学鹍弦因石岩。\n薄暮征衣沾小雨，犹疑当日湿青衫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29736,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题兰砌图为陈仲慈","author":"李孙宸","text":"雨露犹传奕叶光，谢庭楚泽竞芬芳。\n握来会起明光草，不向猗兰论国香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29737,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居漫兴 其一","author":"李孙宸","text":"半亩为园傍涧阿，楼成隙地已无多。\n数丛兰草数丛竹，拚得幽情付薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29738,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居漫兴 其二","author":"李孙宸","text":"尊开时傍竹间亭，秋色宜人酒易醒。\n最爱门前新水绿，半溪凉月半溪星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29739,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居漫兴 其三","author":"李孙宸","text":"幽栖岁月借疏慵，鸡黍邻翁问过从。\n最是清时宽吏隐，野人丘壑渐相容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29740,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居漫兴 其四","author":"李孙宸","text":"平生少近竹和丝，何事清音山水期。\n閒听黄鹂携斗酒，露蝉还咽最高枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29741,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居漫兴 其五","author":"李孙宸","text":"长夏高眠过日中，懒魔不改阅秋风。\n才便一觉羲皇足，晚饭中厨送小童。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29742,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居漫兴 其六","author":"李孙宸","text":"少出经时事事真，倦眠饥食足閒身。\n从他剥啄休相管，世法应饶世外人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29743,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]