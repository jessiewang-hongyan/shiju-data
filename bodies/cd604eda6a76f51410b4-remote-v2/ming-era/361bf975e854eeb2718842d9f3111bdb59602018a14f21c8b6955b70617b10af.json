[{"title":"登阅江亭","author":"赵完璧","text":"独上江亭望，长江豁壮眸。\n风帆随雾捲，雪浪拍空浮。\n天堑中原迥，王灵百世悠。\n酒酣千里客，聊尔一优游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13076,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新中驿夜雨","author":"赵完璧","text":"即次昏黄雨，潇潇夜未停。\n孤灯烧欲暗，宿酒醉初醒。\n辗转那能寐，淋淫不忍听。\n何如飞梦去，绕我故山亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13077,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"房山道中","author":"赵完璧","text":"晓日房山道，行看亦自幽。\n空山鸣野鹤，小水立閒鸥。\n断霭迷村树，晴云结海楼。\n东风吹款段，倦客重回头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13078,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送范惠泉地曹南守浒关","author":"赵完璧","text":"别送沧江渺，怜分青海情。\n楚天春草合，吴水暮烟平。\n萝月清无寐，丝桐秘不声。\n关山劳望迥，报绩计仙程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13079,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"都城西望湖亭","author":"赵完璧","text":"云外下长坂，湖南过小亭。\n寒泉冷石窦，细草暗沙汀。\n骇鹭开青霭，游鱼破翠萍。\n钓矶来暂息，波影俗怀醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13080,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纵舟张家湾","author":"赵完璧","text":"早解云边缆，初归海上宾。\n双凫冲翠霭，孤鹤出红尘。\n回首燕台月，离情汉苑春。\n雨昏留别浦，沽酒暂相斟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13081,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚泊长芦","author":"赵完璧","text":"晚泊长芦月，凉生瀛海风。\n云川凄暮笛，岸苇泣寒蛩。\n酒尽空明里，诗成欸乃中。\n天涯浮桂棹，星畔老槎翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13082,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜饮静宁刘陵沙太守","author":"赵完璧","text":"凉月飞寒巘，清宵遇故人。\n共将辽海思，相慰塞垣春。\n把酒黄尘倦，论文清兴新。\n挑灯放襟抱，海内为谁真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠许空石解元刺史贵南","author":"赵完璧","text":"荆识今何幸，萍踪亦可怜。\n声光齐鲁外，俊逸汉唐前。\n塞日孤城暮，蛮烟万里天。\n何当一朝宠，相慰五云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"广济寺","author":"赵完璧","text":"迢递驱山径，倥偬入梵宫。\n长廊喧燕雀，古殿郁杉松。\n采药神僧去，霏香禅榻空。\n清魂欲延伫，俗役未从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄丘月林给事","author":"赵完璧","text":"旷望天低树，孤吟月满林。\n断云春寂寂，落日晚沈沈。\n青琐钦怀玉，沧溟拟断金。\n封书将别恨，迢递过西岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月林见枉遥践琴约西还赋送","author":"赵完璧","text":"故人欢有陨，永夜问何其。\n釂饮酬良觌，调丝慰夙期。\n霜寒红蜡短，水冷玉龙迟。\n竹里清风起，连床无寐时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚行溪畔","author":"赵完璧","text":"翠盖斜阳外，雕舆绿水边。\n清风吹细葛，微雨散遥天。\n沙鸟盟何在，溪鱼乐自牵。\n好来垂钓处，只是近人烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初秋暑退晚坐","author":"赵完璧","text":"蟋蟀鸣阶下，凉风动槛前。\n露华侵袂湿，月魄缀檐翩。\n酷暑知何去，清宵自不眠。\n幽吟对修竹，相与斗㛹娟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"对雪限韵","author":"赵完璧","text":"错落明垂地，岑寥冷闭关。\n寒庭花满树，青海玉连山。\n作赋才难企，高眠迹可攀。\n怀人清兴发，孤棹夜中还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏夜独坐","author":"赵完璧","text":"独坐芳庭晚，遥依银浦清。\n竹风披溽暑，山月静荒城。\n有酒閒仍醉，无官负自轻。\n年年沧海上，高兴此平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中","author":"赵完璧","text":"冥雨朝还暮，凄风夏作秋。\n竹光联榻润，苔色上衣浮。\n古木惊涛转，飞甍瀑布流。\n清轩人独倚，尽日看浮沤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"官衙夜雨","author":"赵完璧","text":"清馆鸣寒雨，离人寄远天。\n高风岁欲暮，孤烛夜如年。\n妻病沈双鲤，儿官苦独贤。\n羁愁千里外，鱼目五更前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"盐城闻促织","author":"赵完璧","text":"忽闻鸣促织，应自感清秋。\n花底来何暮，风前听未休。\n异乡人不寐，故里思难酬。\n骨肉经年别，湖天回白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月四日官署晚坐","author":"赵完璧","text":"海邑消烦暑，星河坐晚凉。\n清风来独树，新月挂危墙。\n水气生寒早，蛩声向夜忙。\n客怀秋渐老，官邸漏初长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"盐城八月十五夜二首 其一","author":"赵完璧","text":"飞镜当庭静，衔杯向夜深。\n清光霜满地，寒色水侵襟。\n不觉银河落，偏宜玉漏沈。\n暂将江国景，聊慰海瀛心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13096,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"盐城八月十五夜二首 其二","author":"赵完璧","text":"八月盐城客，孤吟桂魄秋。\n阅时常惜老，对月欲销愁。\n把酒添清兴，酣歌慰白头。\n郎官今不斁，犹慊此同游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13097,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"淮阴冬夜","author":"赵完璧","text":"羁客当寒夜，惊魂自不眠。\n风帘清寂寂，霜月冷娟娟。\n衰鬓淮阴道，归心岁暮天。\n敝裘拥独坐，谯鼓暗云川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13098,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吊黄海野早发","author":"赵完璧","text":"残月策行骖，青娥戒晓严。\n征衣鸣落叶，宿雁起寒湍。\n烟迥苍茫外，曦明紫翠间。\n北风吹老泪，悽恻度林峦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13099,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归宿柴沟","author":"赵完璧","text":"馀映沈冈疾，悲风捲地寒。\n烟中度淮水，月下扣柴关。\n半醉霜犹冷，孤眠灯欲残。\n可怜今夜梦，肠断野云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13100,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十二月立春日简栾侍御二首 其一","author":"赵完璧","text":"腊日逢春日，新年入旧年。\n野梅残雪后，江雁暖风前。\n老眼园林雾，閒身湖海天。\n朱颜那可再，偷向醉中还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13101,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十二月立春日简栾侍御二首 其二","author":"赵完璧","text":"鼓角春初报，阳和物自私。\n冰溪澌欲绿，岸柳媚将丝。\n云壑堪乘兴，霜台好赋诗。\n相知无异地，相赏莫相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13102,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日出西直门","author":"赵完璧","text":"秋日游晴旷，西风被面凉。\n征袍红叶满，羸马白沙长。\n曲水惊閒鹭，荒池度野芳。\n碧峰千万点，一望慰愁肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13103,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日兴教寺","author":"赵完璧","text":"古寺青林外，轻车白日斜。\n秋怀开野色，午茗惬僧家。\n山鸟清吟兴，云松静物哗。\n禅关醒俗梦，坐晚意犹赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13104,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"都城送栾岱沧进士尹溧水","author":"赵完璧","text":"相逢忽复别，羁客不胜情。\n衰柳高秋晚，寒山淡日明。\n歌残春酒尽，帆远暮潮生。\n何慰潘郎梦，芳声达凤城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13105,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"都城冬日公出同杨东川寅丈宿僧舍二首 其一","author":"赵完璧","text":"冬夜宿僧房，萍踪觏帝乡。\n松风韵骚屑，窗月照苍凉。\n不寐清宵短，论文雅谊长。\n谁怜沈伯起，相与慰壶觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13106,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"都城冬日公出同杨东川寅丈宿僧舍二首 其二","author":"赵完璧","text":"僧寺清无极，羁臣愁未涯。\n月明寒吠犬，风静夜啼鸦。\n心苦仍依国，魂飞不到家。\n悲歌逢义士，弹铗和京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13107,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朝回望西山","author":"赵完璧","text":"初日早朝回，金天秀色开。\n綵云连巘崿，翠霭接城隈。\n幽远牵高兴，奔趋笑俗埃。\n何时谢朝组，随意踏莓苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13108,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中不寐","author":"赵完璧","text":"身老名何在，岁残人未归。\n乌纱成晚祟，白发悟前非。\n十口知谁托，千山隔雁飞。\n泪痕挥不尽，暮雨北风微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13109,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"落日","author":"赵完璧","text":"落日崦嵫外，新蟾粉蝶边。\n严扉栖暮霭，悲角调霜天。\n倦点灯前易，徐调膝上弦。\n酒醒无限恨，头白梵钟前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13110,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代送人二尹闻喜","author":"赵完璧","text":"阑暑金风早，离觞野馆西。\n关河秋杳杳，云雨晚凄凄。\n良吏新承宠，殊方久望霓。\n即看今日业，拟与古人齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13111,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵山行即事","author":"赵完璧","text":"白云幽石古，青壁瀑湍鸣。\n空翠侵衣湿，山花照眼明。\n啼莺寒谷静，落絮晚风轻。\n何处弥征盖，松门一慰情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13112,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵宿弘恩寺","author":"赵完璧","text":"残阳投古寺，乘月访高僧。\n佛土风尘净，禅心池水明。\n玄关欣妙悟，白首绊浮名。\n半榻三生幸，千缘一芥轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13113,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东归过邹平山下","author":"赵完璧","text":"昔去冰霜岁，今归五六年。\n青山如旧约，赤日自堪怜。\n两鬓空成雪，孤忠负所天。\n偷閒过海畔，故旧半萧然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13114,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"硖石","author":"赵完璧","text":"昔闻硖石崄，此日度应难。\n烟洞深无极，云梯不可干。\n人从天上落，树向井中看。\n空翠茫茫里，征衣暗浥寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13115,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张茅道中","author":"赵完璧","text":"世路应愁绝，胡为来此哉。\n崄巇崖畔度，窈窕壑中回。\n仰面青天小，低头黄雾来。\n艰危向衰老，不觉此心灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13116,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郭城驿道中","author":"赵完璧","text":"塞雁惊斜日，边沙捲北风。\n敝舆山雾里，冷饭驿亭中。\n黄草连云暗，青峦带雪丛。\n壮怀元不老，犹慕伏波翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13117,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞垣晓行","author":"赵完璧","text":"野寺疏钟尽，寒山残月斜。\n冰溪惊雁阵，石径破霜花。\n杯酒全无力，边风不可遮。\n孤臣一万里，肠断塞垣笳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13118,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵夜过六盘山","author":"赵完璧","text":"初月上银盘，登高夜倍寒。\n谷风肌粟慄，山露鬓珠团。\n身为微名苦，心应老病酸。\n秦程良不易，蜀道浪惊难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13119,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵夜过分水岭","author":"赵完璧","text":"素娥迎暮岭，青女伴寒空。\n龙剑明摇雪，貂褕薄透风。\n征车长入夜，王事久忘躬。\n稳羡山翁睡，独惭西复东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13120,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"静宁道中用韵寄凌沙太守","author":"赵完璧","text":"霜气晓仍肃，烟花迥未销。\n龙冰千尺绕，乌景一铛高。\n同气青天远，孤征紫塞遥。\n行行不自己，翻恨我车膏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13121,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中夜雨","author":"赵完璧","text":"细雨江风晚，萧条落小舟。\n一身千里外，百虑五更头。\n水绕还乡梦，云凝去国愁。\n沈沈不知晓，一雁叫寒洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13122,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻蛩","author":"赵完璧","text":"疏帘玉露冷，深院候蛩鸣。\n切切寒如诉，悠悠夜几更。\n半窗山月白，一榻竹风清。\n秋色竟何意，愁人自有情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13123,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨花","author":"赵完璧","text":"点点过楼台，因风何处来。\n庭空雪历乱，帘静日徘徊。\n汉苑春仍老，吴宫寂可哀。\n飘飖度江水，肠断几时回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13124,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日西畴","author":"赵完璧","text":"春日踏西畴，东风阳焰浮。\n暖云屯陇畔，活水浸溪头。\n百亩周王业，一犁莘野谋。\n此身同鹿豕，此乐岂人侔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13125,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵除夕","author":"赵完璧","text":"灯前辞腊尽，漏底易年华。\n拨火围青夜，倾醪泛紫霞。\n清香流柏叶，懿颂起椒花。\n学道侵衰暮，经年愧聚沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13126,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弹琴","author":"赵完璧","text":"弹琴有佳音，对竹弹且吟。\n清风来几席，俗虑涤胸襟。\n青峰对终日，绿酒沽千金。\n太古慕高调，冥冥独此心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13127,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日过凉台寺","author":"赵完璧","text":"野寺风尘静，乘春一暂游。\n参禅违俗世，驻履傍林丘。\n贝叶僧窗寂，金沙圣迹留。\n慇勤访学地，随意却闻愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13128,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"碧沟战场","author":"赵完璧","text":"微雨晓初歇，阴烟过战场。\n悲风翻野蔓，流水咽荒塘。\n枯骨生新藓，残魂断故乡。\n谁输全胜策，干舞念虞皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13129,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月下闻钟","author":"赵完璧","text":"鸦影风前定，钟声月下闻。\n高僧閒暮霭，古寺隔河濆。\n冷度千门雪，清分双树云。\n夙怀超静土，终愧恋尘氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13130,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"茨菰花","author":"赵完璧","text":"忽讶秋风玉，由来冰雪姿。\n孤光明绿苇，独秀出污池。\n宠谢华堂剪，閒依野钓丝。\n清芬烟水外，不受一尘欺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13131,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送姜省吾少参驻抚商州","author":"赵完璧","text":"人去三秦地，花飞四月天。\n离魂销别浦，断霭暗前川。\n美政酬明主，芳声茂昔贤。\n商山兼吏隐，清暇抱琴眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13132,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚发莱城","author":"赵完璧","text":"羸马策新秋，清光自可游。\n残霞依古木，野水舣孤舟。\n人迹新沙润，蝉声落日遒。\n征鞍何处息，沽酒便淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13133,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵南庄","author":"赵完璧","text":"一心无俗物，满眼是春光。\n杨柳孤村静，烟花曲径芳。\n看山同野鹿，藉草当胡床。\n回首红尘里，无如此地狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13134,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重阳","author":"赵完璧","text":"佳节际重阳，西风野日黄。\n鸣鸿云外度，细菊目前香。\n遣兴诗从拙，冲愁酒放狂。\n独醒还独醉，尘俗默低昂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13135,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵雪声","author":"赵完璧","text":"片片落来轻，幽听细细鸣。\n扑纱灯影静，泻竹夜深清。\n梦破黄芦雁，愁添紫塞兵。\n何堪击鹅鹜，蔡下不分明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13136,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵雪色","author":"赵完璧","text":"穷阴凝皓洁，青女未依稀。\n越犬风前吠，梁园月下归。\n疏梅迷玉魄，孤鹤失仙衣。\n粹质谁能夺，缁尘迥自违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13137,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"野鹤","author":"赵完璧","text":"野鹤集沙渚，悠悠向晓阳。\n长鸣寒野阔，振翼海天茫。\n仙格违尘俗，閒身足稻粱。\n好随王子去，已与卫轩忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13138,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题","author":"赵完璧","text":"秦筝声琅琅，越女歌绕梁。\n响剧倾众耳，曲终断人肠。\n高情五陵客，醲赏一朝偿。\n古音岂不雅，寂然贮锦囊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13139,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬月感怀","author":"赵完璧","text":"窗月明如练，松风轻入檐。\n不成清夜寐，相对烛花残。\n往事翻新恨，凋年损故颜。\n馀龄春酒在，何必问还丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13140,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"招蜂","author":"赵完璧","text":"何处黄蜂集，招来野叟家。\n凿苔仍岁计，掇蕊阅年华。\n努力知谁利，依人正尔嗟。\n君臣负明识，何事恋尘哗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13141,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙丑正月二日慎脩北赴礼闱十一日大雪怀思","author":"赵完璧","text":"儿作燕山别，亲留溟海情。\n北风吹大雪，何处驻行旌。\n春入琼林早，云开玉殿明。\n望遥天渐迩，计日慰佳声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13142,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵寄答莱城张南溪老长府旧友","author":"赵完璧","text":"相思分异地，相应自同声。\n各抱悬悬意，频看字字情。\n馀年知几许，何日续重盟。\n南北应天限，离鸿怨弟兄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13143,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓霁","author":"赵完璧","text":"细雨夜渐歇，侵朝云初晴。\n竹槛宿霭散，松阶馀寒清。\n旭日野鹤奋，轻烟林雁鸣。\n远巘润画碧，新荣鲜图猩。\n乱藓叠紫翠，平池摇空明。\n启牖爽气溢，开帘微风生。\n俯仰尽胜览，徘徊多高情。\n作赋谢妙思，横琴鸣佳声。\n抚玩兴未已，萧然偕谁赓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13144,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]