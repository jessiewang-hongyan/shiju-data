[{"title":"山中怀龙山诸兄弟","author":"宋登春","text":"鲁多君子儒，赵有慷慨士。\n结缨蹈仁义，提剑死知己。\n雕龙岂足珍，刻鹄终见鄙。\n缅怀子怅而，静言吾老矣。\n□栖惬素心，谷汲劳孺子。\n僶俛慕前修，耳顺方知耻。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"池中雁","author":"宋登春","text":"林卧寡俦侣，振褐临清池。\n露彩集蕙草，霜华变青滋。\n翩彼随阳鸟，唼藻戏涟漪。\n返顾患人指，回翔稻粮羁。\n冥冥呈长羽，绘缴何由施。\n伊子敦孤性，带索终栖迟。\n藜藿岂满腹，百年厌饥劬。\n物婴因住念，达生焉怅而。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬夜宿郡斋","author":"宋登春","text":"空斋少物役，独夜有余清。\n柏子阶前落，梅花笛里生。\n岂须山栎寿，徒结畹兰情。\n明日鹅池上，看云还濯缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"人日寄所知","author":"宋登春","text":"落莫江村里，偏怜物候新。\n百年长作客，此日愧为人。\n薄俗存身计，残生随世因。\n楚兰渐堪把，采采寄情亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同句吴周秀才登岳阳楼雨中望君山作","author":"宋登春","text":"久客知吴语，高楼自楚歌。\n青山浮木面，白鸟没烟萝。\n仙去苍梧远，云生天岳多。\n乡关眇何许，日暮洞庭波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巴陵别徐使君归荆州邸舍","author":"宋登春","text":"日暮寻江陵，凉风满白蘋。\n归来应寂寞，临别更情亲。\n孤剑三秋梦，扁舟万里身。\n着书沧海上，还着旧纶巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29887,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石首江阻风雨舟中夜坐怀荆州公","author":"宋登春","text":"八月悲风生，翛翛鸿雁鸣。\n白头多病日，黄叶此山城。\n细雨孤帆落，长江独夜情。\n遥传一掬泪，洒向楚臣缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29888,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再送俞山人游黄冈兼讯袁郡丞","author":"宋登春","text":"昔别在何处，今看白发新。\n无钱愁滞客，多术耻谋身。\n锦瑟悲燕士，幽兰忆楚臣。\n相思有书扎，时寄草堂人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29889,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻徐使君留滞汉阳寄赠","author":"宋登春","text":"道直谪官蚤，扁舟何去迟。\n秋深纵酒后，家远寄书时。\n凄断秦云色，悲凉越鸟枝。\n汉阳江树瞻，摇落对相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29890,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日寻杨山人因过贺将军园二首 其一","author":"宋登春","text":"空谷春将赋，幽人独可寻。\n风香红药近，鸟语绿萝深。\n一笑缘巴调，三年学楚唫。\n童扶还杖策，随意步华林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日寻杨山人因过贺将军园二首 其二","author":"宋登春","text":"茅屋斜临水，石阑曲拂衣。\n松深鹤子冷，花近药苗肥。\n老去诗犹健，春来酒不违。\n欲寻江路去，竹下有柴扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曹中丞以新诗见遗雪中书此简答","author":"宋登春","text":"冻雀飞还去，空房秪欲眠。\n高云断楚塞，大雪满江天。\n竹叶春仍绿，梅花寒可怜。\n归来曹执法，峕寄短长篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日陪暂中丞饮城北庄晚至东湖草神堂野望感赋","author":"宋登春","text":"芳草春初折，游丝晚正繁。\n渔樵杨丫岸，鸡犬野棠村。\n怅望荆门路，凄述楚客魂。\n酬思留宝剑，还爱赵平原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日闲居","author":"宋登春","text":"青山歌伐木，白首赋闲居。\n鸿雁春能至，梅花寒更疏。\n茧丝从妇织，菜甲教儿锄。\n日莫北窗下，尊中幸不虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋晚江上书怀","author":"宋登春","text":"一望家园一惘然，湘云易水共长天。\n山中薜荔日萧索，江上芙蓉秋可怜。\n楚些独唫长下泪，燕鸿又过记残年。\n黄金台上无名字，醉后还歌宝剑篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日闻曹中丞东湖庄堂楼初筑以诗奉赠","author":"宋登春","text":"云霞江色晚，楚客意何如。\n金散身无累，才高世其疏。\n开门闻鸟雀，落日见樵渔。\n玄阁还应闭，白头长着书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄嘉定徐刺史","author":"宋登春","text":"柴荆乌鹊定，风叶正萧萧。\n落日清江上，怀人沧海遥。\n年华随杖屦，生事寄渔樵。\n楚客销魂处，秋来谁为招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月十四夜忆徐刺史","author":"宋登春","text":"桂华初发小堂东，绿芷红兰别一丛。\n翡翠屏前秋寂寞，芙蓉塘外月朦胧。\n宝书玉笈为谁隐，云锦霞笺还自封。\n鸿雁不来秋又晚，故人闻巳到江东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜","author":"宋登春","text":"天秋鸿雁来，夜寒桂华落。\n空馆复相思，清飙振丛薄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日鹅池庄与故人王惟材闲酌","author":"宋登春","text":"秋水浮田叶，凉风吹稻花。\n白衣燕客醉，红树楚人家。\n翡翠鸣鱼笋，鸳鸯立钓车。\n鹅池堪避地，与尔种胡麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江陵遇同乡王惟材","author":"宋登春","text":"未路谁相问，无家我独亲。\n他乡今接袂，童稚昔为邻。\n江海飘零客，风尘沦落人。\n十季俱白首，笑此梦游身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日携王惟材陪曹公饮城东湖亭","author":"宋登春","text":"漠漠林塘五月寒，王人长日竹皮冠。\n酒炉茶灶从儿理，菜圃爪田引客看。\n老去坐忘青锁梦，归来囊贮紫金丹。\n鹅池道者频相访，笑索村醪苜宿盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与王惟材夜坐话旧","author":"宋登春","text":"醉歌燕市笑颜红，十载离家似梦中。\n闻说存亡重凄恻，对君何必叹飘蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闭门","author":"宋登春","text":"庭梅横似画，篱菊缀如钱。\n闭户琴书客，翻悲草木年。\n黄金无药物，白发满颅颠。\n花径从儿埽，谁来问尚玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月十四夜游太晖观呈忠教真人","author":"宋登春","text":"碧天高处是三清，金作楼台□作城。\n白鹿仙人秋弄笛，青牛道士夜吹笙。\n惊残鹤梦江云冷，幻出松阴海月明。\n欲写阴符寄幽事，山中老子有书迎。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同郡盖子材寄示文稿作此简答","author":"宋登春","text":"万金散尽一身轻，白首为儒掉臂行。\n郢里谁传春雪调，楚山应系薜萝情。\n自知未上于秦策，肯信归来感妇迎。\n却笑文章憎命达，十年犹在鲁诸生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登岳阳楼","author":"宋登春","text":"吴楚江山阔，巴陵水国遥。\n江流分九派，山势控三苗。\n卉服通州里，蛮方翊圣朝。\n每希常道泰，饮啄老渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"芳树","author":"宋登春","text":"金井梧桐树，碧枝华叶芳。\n月明移翠影，风细吐清香。\n共惜三春色，谁怜九月霜。\n闺中有少妇，岁岁忆辽阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄嘉定徐二刺史","author":"宋登春","text":"豪华犹六代，胜事在吴门。\n绿树湖边寺，红云海上村。\n桑麻常夜缉，橘柚向秋繁。\n拂袖还乡日，应怜松菊存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠庐岳僧","author":"宋登春","text":"何日别东林，浮杯梦泽深。\n云山随去住，水月即禅心。\n钵润龙将见，衣残珠未沉。\n行踪遍五岳，留偈待知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日鹅池昼卧","author":"宋登春","text":"卑栖佚老日，高枕物华年。\n橘柚垂茅屋，菰蒲间渚田。\n意中人不见，事外客孤眠。\n习静眇身世，长唫秋水篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月十三夜","author":"宋登春","text":"江月满江城，客愁何处生。\n残蛩依砌响，新雁与云平。\n露重楸梧白，天寒松桂清。\n弟兄在万里，此夕各含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江夏舟中值元日","author":"宋登春","text":"乘舲下吴会，寒日水增波。\n江路鱼虾美，山城橘柚多。\n维舟燕客醉，倚棹楚童歌。\n明发汉阳去，相思柰若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"经彭泽县舟次小孤山阻雨","author":"宋登春","text":"山塞分吴楚，山城辩土风。\n人烟泽国异，春色故乡同。\n晓饭孤山下，孤帆细雨中。\n樯乌飞自去，诗罢意无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"芜湖沙洲阻浅","author":"宋登春","text":"草树山头驿，云霞江日村。\n苇人惊虎迹，舟子记潮痕。\n欲买吴姬酒，能招楚客魂。\n长波浩无际，目极更何言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苏台览古","author":"宋登春","text":"吴王昔目好吴钩，义士三千尽列侯。\n霸业巳随云北散，雄图空复水东流。\n荒台寂寂渔樵路，故垒萧萧草树秋。\n惟有馆娃宫里曲，至今歌向采菱舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜泊长桥","author":"宋登春","text":"落日长桥外，维舟竹屿孤。\n春潮不满岸，江鸟下平芜。\n负笈终归楚，寻山且在吴。\n自伤漂泊意，深夜醉嘑卢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日饮唐山人竹园","author":"宋登春","text":"蝴蝶满园春日晴，桃花梨花飞素馨。\n千竿万竿何菁菁，时时风雨闻秋声。\n淇园阔节不足数，渭川绿玉难为称。\n尔莫斸为化龙杖，虚劳万里升天行。\n尔莫截作学凤笙，拘牵众乐相和鸣。\n饰金缀玉非本性，不如抱箨全尔精。\n高阳徒，箨冠生，引觞大嚼无俗情。\n其如晋代竹林彦，枕曲眠糟损性灵。\n却怪王猷多傲世，入门先问主人名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"楚中送僧还嵋山隐居","author":"宋登春","text":"半偈曾闻法，虚空无住心。\n楚云飞锡去，巴水渡杯深。\n一室寄何处，千峰独可寻。\n有身缘未子，此别且长唫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送洪都道士","author":"宋登春","text":"霞外寻真侣，山中问赤松。\n仙坛花雨静，石鼎绿苔封。\n坐炼金光草，行持九节筇。\n闻师还旧隐，何日得相从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王生西游","author":"宋登春","text":"雪里荆门道，愁中汉水春。\n三湘曾滞客，万里欲归身。\n献赋还过楚，谈兵莫入秦。\n自伤流浪久，偏惜远游人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春阴","author":"宋登春","text":"竹里松间石径斜，春云长绕野人家。\n幽窗睡觉鸟声响，童子开关埽落花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊辰夏六月江陵大水","author":"宋登春","text":"水气迷津树，江声骇市居。\n川原那辨马，黎庶几为鱼。\n荆楚年频异，沅湘老计疏。\n近饶浮海兴，东下定何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江陵草堂漫赋因忆杨少通","author":"宋登春","text":"疏阔平生事，支离迟莫年。\n乡关朔雁外，客舍楚江边。\n酒伴曾谁访，诗狂还自怜。\n经过杨执戟，许寄买山钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日小园雨后遣怀","author":"宋登春","text":"性直难干谒，峕清愧贱贫。\n江山双草屦，岁月一纶巾。\n秋色梧桐老，晴光橘柚新。\n寥寥宋玉宅，千古闭荆榛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日即事","author":"宋登春","text":"少年恃意气，长醉酒家楼。\n不倚金吾势，曾随剧孟游。\n卧山学剑术，历国揖诸侯。\n白首无人识，空悲易水秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"敝园夏日遣怀","author":"宋登春","text":"压架葡萄熟，巡檐竹木清。\n摇翻葵扇小，欹侧箨冠轻。\n楚俗原非怨，燕歌空复情。\n云霞仙不就，书剑老何成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同杨少通宿荆南驿馆","author":"宋登春","text":"孤亭明月冷，疏馆碧梧秋。\n雁宿新沙岸，萤飞古驿楼。\n短歌多楚调，永夜看吴钩。\n皎皎江关梦，相悬万里愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江陵为仙居儿赋","author":"宋登春","text":"性疏非傲物，懒慢竟何求。\n身老兼多病，他乡况值秋。\n衣冠随楚俗，饮啄且荆州。\n好似张平子，曾无儿女忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江上逢罗炼师因简霞西道者","author":"宋登春","text":"老去沧洲计，春来湘水深。\n白云松子梦，芳草楚臣心。\n摇荡江边兴，萧条泽畔吟。\n明霞如可掬，不惜报知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"家兄曾学医于郑邦辅别十年郑逝矣兄至江陵因感同泣下作是时","author":"宋登春","text":"兄弟悲迟暮，燕关忆壮游。\n壶中仙客去，肘后秘方留。\n谷日花仍发，山阳笛更愁。\n平生多感激，泪洒白云丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重九前一日同王杨二山人饮胡将军东郭草堂","author":"宋登春","text":"丫下寻陶令，篱边问葛疆。\n南山足芋栗，东郭此茅堂。\n萸酒年年事，菊花岁岁芳。\n白头还醉舞，休笑野人狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江陵送僧还蜀","author":"宋登春","text":"烟树寒云楚水西，残瓢破衲独行迟。\n心无一事即相见，千里何须叹别离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少年行","author":"宋登春","text":"明月芙蓉发，秋风薜荔生。\n歌从山鬼啸，剑任奚奴擎。\n斸地留残药，休粮检落英。\n南枝有羁鸟，同结越乡情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春还海上因赠嘉定王山人","author":"宋登春","text":"云度苍江冷，花飞碧海春。\n谁家无斗水，涸辙有穷鳞。\n自笑投珠客，犹怜泣玉人。\n肯邀笙鹤侣，共尔觅玄津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日登荆州少津观音阁塔","author":"宋登春","text":"塔院收花雨，楼台散佛香。\n山青巴国近，鸟白楚天长。\n树色分衡岳，江流入汉阳。\n古来争战地，谁是水云乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋夜月","author":"宋登春","text":"萧萧风露寒，耿耿客衣单。\n萤火流花砌，桐阴上井阑。\n楚云常独卧，巴月共谁看。\n身世何须计，生涯此箨冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江陵送李梓老还苏州","author":"宋登春","text":"十载江陵共白头，枫桥橘酒忆苏州。\n此生见面应稀少，客泪因君洒素秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"破闷","author":"宋登春","text":"暖老凭湘酒，为园仗楚童。\n风残青豆架，露满菊花丛。\n流水十年事，浮云一病翁。\n达生还自古，陶令不羞穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"承天寺再赠王秉之山人","author":"宋登春","text":"贫贱论交日，凄凄多苦颜。\n井寒晨炊少，室静共僧闲。\n囊里常留药，人前笑买山。\n飘零王逸少，海上几时还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苏州汪秀才见访江陵草堂以诗贻之","author":"宋登春","text":"漂泊江乡老此身，柴门长闭任家贫。\n云霄放鹤浑闲事，风雨看花又一春。\n抱玉几年终献楚，怀书垂老莫于秦。\n昨朝忆共接舆醉，竹下狂歌见性真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴二首 其一","author":"宋登春","text":"蕉叶临窗卷，幽花向砌分。\n楚童秋洗竹，江鹤夜鸣云。\n地僻应增懒，身潜不用文。\n近来饶酒券，秋思更纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江陵送王惟材还赵郡","author":"宋登春","text":"湘皋烟草洞庭云，此地逢君又送君。\n湘瑟悲凉那可问，楚歌凄断不堪闻。\n遥山对酒春将暮，临水扳花日未曛。\n憔悴形容独归去，江楼细雨叹离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辽府赠杨山人","author":"宋登春","text":"故乡因别久，逆旅有新知。\n吊古过燕市，哀歌问渐离。\n楚筵分醴后，蜀肆下帘时。\n欲就百钱卜，长贫老不疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠薛郎","author":"宋登春","text":"画史风流数薛郎，竹间茅屋对潇湘。\n床头金尽还沽酒，爱学吴歈和楚狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日陪葛刺史胡少府吕尹汪三山人饮曹公东湖水亭 其一","author":"宋登春","text":"竹里逢仙尉，花间隐使车。\n围棋临水槛，把酒看游鱼。\n黄鸟鸣深丫，青荷覆小渠。\n物情忻自遂，而我乐□□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日陪葛刺史胡少府吕尹汪三山人饮曹公东湖水亭 其二","author":"宋登春","text":"支枕茅檐下，秋风正到时。\n菊花开较晚，鸿雁故来迟。\n栖托终何事，行歌且杖藜。\n百年非有道，心迹岂无疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]