[{"title":"幽居","author":"张元凯","text":"烟霞元自癖，寤寐向谁论。\n净业莲为社，青山鹿应门。\n暂留徐孺子，深避窦王孙。\n为语冥冥雁，中原矰弋繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28865,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饯客","author":"张元凯","text":"细雨孝廉棹，经过芳草城。\n渚云飞不尽，山月正初生。\n白帢谈名理，清樽惜别情。\n如逢燕赵客，为报厌纵横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28866,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠子念二首 其一","author":"张元凯","text":"吾自识曹丘，同为长者游。\n下帷虚董策，借箸竟良筹。\n清圣元无羡，情痴卒未休。\n花间呼小友，张绪最风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28867,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠子念二首 其二","author":"张元凯","text":"谢傅爱羊昙，东山日并骖。\n称名当第五，受爵敢过三。\n浪谑曾无虐，风骚秖自耽。\n庭花莫閒种，芳草树宜男。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28868,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"濠上逢客","author":"张元凯","text":"相逢木兰棹，同过渚莲亭。\n散发新添白，看山不改青。\n种花无旧业，视草有玄经。\n寂寞江湖上，常占处士星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28869,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送客之滇","author":"张元凯","text":"始遂四方志，何知万里长。\n雪消犹故国，草绿已他乡。\n旅鬓欲垂白，行囊尽点苍。\n巴江元学字，不阻校书航。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28870,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"访顾朗","author":"张元凯","text":"野径莽无迹，山园摽有梅。\n客能骑马到，主自饭牛回。\n藉草深趺坐，临花浅送杯。\n狂生今尔汝，清话总成诙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28871,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"逢王承父","author":"张元凯","text":"苇叶梁溪舫，蘋花秋水风。\n两人斗酒共，千古寸心同。\n诗是山东白，才非吴下蒙。\n词坛分赤帜，吾党小英雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28872,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同卫僚游虎丘","author":"张元凯","text":"彻侯戎理暇，小队出城西。\n金勒材官鞚，银瓶健卒提。\n云根堪试剑，兰叶亦然犀。\n为作军中乐，林莺不敢啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28873,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过郑丞","author":"张元凯","text":"郑公门似水，杨柳绿如丝。\n自哂官阶小，那嫌堂构卑。\n飞花竟亡赖，归燕不愆期。\n投辖人皆醉，毋烦置驿为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28874,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"端午二首 其一","author":"张元凯","text":"风雨淹佳节，搴裳独采蒲。\n久无观妓咏，近有辟兵符。\n竹径留中散，江流忆左徒。\n乾坤自拘碍，吾意只菰芦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28875,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"端午二首 其二","author":"张元凯","text":"角黍绿离离，茶瓜与客期。\n短衣悬艾艾，长命续丝丝。\n燕乳过初夏，蜂喧恰午时。\n葵榴幸无恙，折取伴芳卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28876,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"遇京口程秀才因寄朱将军","author":"张元凯","text":"羽檄关河静，风尘客路分。\n相逢伯休父，因忆季将军。\n组练长江雪，旌旗建业云。\n还应赋秋兴，不草出师文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28877,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"客夜","author":"张元凯","text":"剑锋消不尽，一室欲飞霜。\n孤戍猿声里，高城鸟道傍。\n风尘存季布，肝胆借田光。\n我马玄黄色，伤心去路长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28878,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"家信","author":"张元凯","text":"雁高呼不下，凭汝报平安。\n作客年年别，为官事事难。\n黑貂孤泪夜，白发一丝寒。\n愁绝江南信，梅花雪后残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28879,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"卷六 出塞二首 其一","author":"张元凯","text":"赤帜空邻壁，朱麾满汉营。\n受降当夜半，飞捷入春明。\n赐锦麟裁就，悬金鹊化成。\n玺书频慰劳，天子重干城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28880,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"卷六 其二","author":"张元凯","text":"列骑猎飞狐，龙城出虎符。\n宝刀寒太白，绣甲卷天吴。\n都尉称强弩，将军字破奴。\n控弦三十万，踊跃取休屠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28881,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"侠客二首 其一","author":"张元凯","text":"六郡连三辅，秦城接楚疆。\n无非游侠地，总是少年场。\n万户片言得，千金一掷亡。\n青楼多艳妇，虽老觅徐娘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28882,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"侠客二首 其二","author":"张元凯","text":"平生未识愁，出入富平侯。\n彊灌令人釂，居间倩客筹。\n乘黄千里驷，狐白万金裘。\n厌说雕虫技，梁园只浪游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28883,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陇水","author":"张元凯","text":"陇水陇头清，氐羌陇下营。\n不堪刁斗乱，况复夜猿鸣。\n转战黄云合，寻源白发生。\n月明边籁静，肠断此中声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28884,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"落梅","author":"张元凯","text":"清夜梅花落，冰霜行路难。\n金微残梦绕，玉篴一声寒。\n马上凭谁寄，闺中只独看。\n忽流明月影，双泪湿阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28885,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"婕妤","author":"张元凯","text":"长信悬孤月，增成愁望中。\n身轻不如燕，那敢怨东风。\n流水朱弦断，飞花舞袖空。\n还将辞辇意，随分处深宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28886,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"明妃","author":"张元凯","text":"单于愿称婿，宫女出良家。\n犀带黄金饰，旃裘白雪花。\n照来犹汉月，看去已胡沙。\n握发羞明镜，飞蓬恨未华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28887,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆别","author":"张元凯","text":"别去弥年载，容华异昔时。\n镜分残两月，弦断散千丝。\n雨泪含花脸，春愁结柳眉。\n归期聊出卜，多露晓行迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28888,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"堤柳","author":"张元凯","text":"大堤千树柳，尽是故倡家。\n憨态向谁好，柔枝空复斜。\n掌中身似燕，钗畔髻如鸦。\n遮莫思张绪，无心折杏花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28889,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"从军二首 其一","author":"张元凯","text":"结发事戈矛，新从定远侯。\n横行非面谩，感激许身酬。\n烽火消雄剑，燕姬脱战韝。\n军中无饮器，好借月支头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28890,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"从军二首 其二","author":"张元凯","text":"仗钺出甘泉，将军秋备边。\n骍弓善猿臂，凤铠称鸢肩。\n结客通中贵，擒王得左贤。\n功名陋田窦，麟阁许谁先。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28891,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铜雀","author":"张元凯","text":"奉寝传遗教，留欢觅故心。\n梦为云雨薄，恩向死生深。\n解犹纤玉，香分剩郁金。\n可堪漳水月，夜夜照孤衾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28892,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"芳树","author":"张元凯","text":"芳树映窗纱，容华散早霞。\n临妆恐生妒，搴幔故相遮。\n欲结同心子，先开并蒂花。\n东风莫吹落，夫婿恰还家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28893,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖上宴集二首 其一","author":"张元凯","text":"桂楫出横塘，兰陵绿酒香。\n露桃无赖色，夜月可怜光。\n客赋元鹦鹉，山名是凤凰。\n江南风物丽，罗绮俨成行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28894,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖上宴集二首 其二","author":"张元凯","text":"使者解金龟，春风倒接䍦。\n柳丝缫燕子，花瓣掠鱼儿。\n水绿平铺绮，山青远画眉。\n落梅新制曲，红袖隔船吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28895,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"朗上人林泉二首 其一","author":"张元凯","text":"筑室栖支遁，为园象给孤。\n流泉动朱瑟，松露落明珠。\n施食山禽睨，翻经野鹿趺。\n言寻许玄度，先遣具醍醐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28896,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"朗上人林泉二首 其二","author":"张元凯","text":"古木藏精舍，春风日闭关。\n飞花自容与，乳燕任游閒。\n禅影清池上，经声绿竹间。\n何须携锡远，自有赤城山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28897,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊外","author":"张元凯","text":"野望晓苍苍，川原喜载阳。\n云飞山动影，露湿草生光。\n柳下寻元亮，花间遇仲长。\n携来一壶酒，开与故人尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28898,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"友人新斋","author":"张元凯","text":"草构方除旧，蓬门今始开。\n春衣黄似柳，岁酒碧于苔。\n野水从傍引，山花取次栽。\n孔融新第宅，张俭又轻来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28899,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观猎","author":"张元凯","text":"都护班师日，龙城会猎齐。\n兔藏鹰侧目，鹿失马穿蹄。\n诡遇元干律，偏师亦自提。\n擒生市斗酒，明月灞陵西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28900,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"朱楼","author":"张元凯","text":"结绮兰芬散，临春环佩鸣。\n黄金寿爰叔，绿酒醉陈卿。\n隐几三眠柳，迷花百啭莺。\n朱楼巢翡翠，燕子陋为名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28901,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同黎徐二帅游南屏山二首 其一","author":"张元凯","text":"并骑骅骝美，芳郊桃李秾。\n酒光明琥珀，山色秀芙蓉。\n卫霍春多暇，邹枚日过从。\n材官俱乐凯，饮至奏歌钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28902,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同黎徐二帅游南屏山二首 其二","author":"张元凯","text":"柳下对呼卢，朱丝系玉壶。\n绮罗临水乱，鼓吹入云无。\n红杏村村雨，青山处处湖。\n步兵良酝具，不问酒家胡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28903,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春闺二首 其一","author":"张元凯","text":"罗袖裁全疋，轻盈出桂房。\n柳眉莺睥睨，花靥蝶颠狂。\n夜月求凰调，春风堕马妆。\n良人知未返，较猎入长杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28904,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春闺二首 其二","author":"张元凯","text":"应识娇亡赖，悬知态尽憨。\n采芳非怨女，带草是宜男。\n窥玉全生妒，留髡半倚酣。\n无凭云雨梦，都使寸心含。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28905,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚步二首 其一","author":"张元凯","text":"偶来寻野寺，忽复过柴桑。\n听鸟竹林下，逢僧流水傍。\n绿云生麦陇，斜日上鱼梁。\n嵇阮时相问，黄公尚卖浆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28906,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚步二首 其二","author":"张元凯","text":"楚客混渔樵，清溪散步遥。\n涧藤栖暝翠，山磬韵春潮。\n野兴花能引，羁魂酒可招。\n久无瓯冶佩，常挂许由瓢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28907,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岣嵝山居二首 其一","author":"张元凯","text":"岩扉对灵隐，山阁启清晖。\n水浅溪如剡，花深曲似韦。\n触人香麝过，背客锦禽归。\n飞瀑飘晴雪，泠泠湿我衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28908,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岣嵝山居二首 其二","author":"张元凯","text":"窈窕桃源路，渔樵只浪猜。\n巢居同幻住，峰影逼飞来。\n乌几云流湿，黄庭风展开。\n彼将身隐矣，吾岂避秦哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28909,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠阮都尉二首 其一","author":"张元凯","text":"砥砺收民誉，吹嘘借士评。\n一官成皓首，五字擅长城。\n对月吴钩跃，临风越甲鸣。\n汉庭徵老将，犹可代专征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28910,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠阮都尉二首 其二","author":"张元凯","text":"南阮贫如昨，步兵犹可怜。\n吁嗟威武士，寂寞广文毡。\n幸有官厨酒，曾无负郭田。\n建安多丽藻，谁在咏怀前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28911,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"园居二首 其一","author":"张元凯","text":"种柳门初绿，浣花堂亦深。\n秖将投笔意，不负灌园心。\n独抱庐中膝，时操弦外琴。\n翻嫌扣角者，飒飒动商吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28912,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"园居二首 其二","author":"张元凯","text":"买得钓鱼矶，依然昼掩扉。\n小窗摊蠹简，斜日晒牛衣。\n亭子乌皮几，山妻白苧机。\n柴桑不开径，彭泽敢言归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28913,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晏坐二首 其一","author":"张元凯","text":"日接林中侣，时来方外群。\n楚山隐几见，羌笛卷帘闻。\n绿树啼黄鸟，青天流白云。\n北窗閒悦绎，柱下五千文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28914,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晏坐二首 其二","author":"张元凯","text":"挥麈青松净，披衣白苧轻。\n断霞归屿迥，纤月堕江明。\n清啸嵇中散，沉酣阮步兵。\n何知身世促，咄咄但谋生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28915,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"广陵遇客","author":"张元凯","text":"敝裘仍岁月，短棹只菰芦。\n歌凤身留楚，负薪家在吴。\n仓庚三月雨，平仲一城芜。\n零落东西去，高阳旧酒徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28916,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"彭城","author":"张元凯","text":"去国久为客，思家更属秋。\n鲛人月中泪，燕子水边楼。\n绿树帆飞度，青山云乱流。\n可堪张仲蔚，借住李膺舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28917,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鲁桥","author":"张元凯","text":"凫绎青岚近，龟蒙黛色连。\n看山浑不厌，把酒正相便。\n津树常遮月，沙滩少住船。\n平生击楫志，都付卜居篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28918,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过王文学","author":"张元凯","text":"作客三千里，为儒一亩宫。\n蛛丝缫户上，鸟迹篆沙中。\n解佩湘皋共，藏书邺架同。\n沉沦何必叹，著述起王通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28919,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"魏季朗贡入太学寄赠二首 其一","author":"张元凯","text":"驱车随计吏，杖策度黄河。\n岳色凌空下，云英夹日过。\n梦悬金马隔，路出碧鸡讹。\n千古豪雄事，居然限制科。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28920,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"魏季朗贡入太学寄赠二首 其二","author":"张元凯","text":"握中神物在，沦落世犹惊。\n照乘三光失，支机五采生。\n解颐周列国，抵掌汉西京。\n若说雕虫技，翻令意不平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28921,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金陵徐园宴集分得壶字二首 其一","author":"张元凯","text":"卢橘园千顷，葡萄酒百壶。\n溪声来远瀑，云影曳流苏。\n花落纷迎蝶，萍流曲引凫。\n主人能好客，当代执金吾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28922,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金陵徐园宴集分得壶字二首 其二","author":"张元凯","text":"凤凰犹馆榭，朱雀半蘼芜。\n公子元封魏，佳人本姓卢。\n云霄开甲第，歌舞出名都。\n不羡金为埒，唯怜玉作壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28923,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晦迹","author":"张元凯","text":"清时真自失，世路岂相援。\n晦迹蠖同屈，雄谈虱屡扪。\n绨袍存国士，脱粟进王孙。\n执戟艰危在，秋霜拂泪痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28924,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"漫兴","author":"张元凯","text":"欲移愚谷住，乞得醉乡封。\n久自甘人弃，难为悦已容。\n时情轻马走，世态厌龙钟。\n落落沉冥者，吾师阮嗣宗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28925,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清郡访郑丈二首 其一","author":"张元凯","text":"处士芰荷裳，相将舞媚娘。\n竹枝新度曲，桃叶旧怜香。\n碧椀银丝鲙，冰壶白玉浆。\n清泉自销暑，落月尚飞觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28926,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清郡访郑丈二首 其二","author":"张元凯","text":"白首美遨游，他乡行乐稠。\n朱弦被琴瑟，绿树系骅骝。\n虚席迎无忌，倾囊问莫愁。\n每劳银不律，只为锦缠头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28927,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清郡大宁寺二首 其一","author":"张元凯","text":"借住元常住，深藏是善藏。\n注瓶泉水冷，开卷法华香。\n古桧如虬偃，新松比鹤长。\n红尘将赤日，亦避寺清凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28928,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清郡大宁寺二首 其二","author":"张元凯","text":"初地能逃暑，中宵暂问禅。\n草中生熠耀，藕上吐婵娟。\n同舍病摩诘，东邻老郑虔。\n吁嗟坎壈岁，忏悔佛灯前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28929,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"兖州晓行","author":"张元凯","text":"残月照征衣，村荒人住希。\n三星犹耿耿，四牡正騑騑。\n岱翠云中落，霜华剑上飞。\n经过获麟处，吾道泪堪挥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28930,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"沙河道中","author":"张元凯","text":"洲渚河流剩，沙堆风卷馀。\n牛羊纷认牧，禾黍乱成畬。\n枣熟人憎鸟，荷枯獭趁鱼。\n秋霜欲侵鬓，愁绝独驱车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28931,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"天津遇只都尉秉忠","author":"张元凯","text":"匹马西京路，风尘遇冠军。\n姓奇希见世，名美不忘君。\n邀笛关山月，登楼海岱云。\n相看头尚黑，塞下可邀勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28932,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岁暮过淮阴","author":"张元凯","text":"摇落出燕市，仓皇过楚城。\n黄金随岁尽，白发待春生。\n雪后鹑衣重，风前草笠轻。\n几年悲命运，握粟问君平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28933,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渡江","author":"张元凯","text":"十二月将尽，三千里外还。\n船犹冲白浪，家已近青山。\n暂罢穷途哭，难为故国颜。\n解装无长物，朔雪处囊间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28934,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]