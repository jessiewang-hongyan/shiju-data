[{"title":"送杨维立侍读莅任南京","author":"程敏政","text":"特奉新恩旧所无，奎星光采映南图。\n暂分晓日鹓行侣，未觉春风雁影孤。\n江左诗盟添社友，关西经学盛门徒。\n不须对酒增离思，天遣才名重两都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46310,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送庶吉士吴俨养疾南还","author":"程敏政","text":"一舟遥出潞河浔，赐告南还喜不禁。\n吟望铜官秋屐远，梦回天禄夜灯深。\n青年暂赋思归引，白日长萦恋阙心。\n屈指重来身更健，春风双佩入词林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46311,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蟠桃图寿星者王璧母句容陈孺人八十","author":"程敏政","text":"海上仙桃熟几番，写生光映北堂萱。\n九重好见旌孀节，八帙今看启寿元。\n庆衍太丘知阀阅，秀钟勾曲是乡园。\n贤郎最解君平术，甲子无烦绛老言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46312,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送姑苏仰彦政同知滨州","author":"程敏政","text":"离歌一曲帝城南，喜佐名州促去骖。\n禾黍送香秋正熟，衣冠为别酒初酣。\n人材久说虞庠盛，德化宁当汉史惭。\n阙下有期重到日，闾阎甘苦听君谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46313,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿亚参吴文盛母夫人许氏七十","author":"程敏政","text":"七十精神不用扶，庆辰须见雪盈颅。\n寿萱吐秀侵香鸭，慈竹连阴护酒凫。\n恩湛北堂重赐诰，瑞徵南极更张图。\n分藩有客归宁便，无限情申反哺乌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46314,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别徐廷盛亲契南行","author":"程敏政","text":"残暑西风促去装，潞河南下听鸣榔。\n小槽酒罄乡情在，半榻尘生别意长。\n脉理近谁谙太素，名途还子逐飞黄。\n题诗为订重来约，多病相烦写异方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46315,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽工部颜员外泾父母","author":"程敏政","text":"纶书初赠水曹郎，旌典仍题贞节坊。\n家声何止万金直，吉壤俄看双玉藏。\n遥望吴山为谁好，忽闻楚些令人伤。\n史臣有刻诏千载，寿算宁须论短长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46316,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"尚书谢大韶先生哀挽","author":"程敏政","text":"文章座主大司空，晓梦惊随逝水东。\n汗竹香生良史墨，宫花尘拂状元红。\n英魂彷佛陪仙驭，恤典分明感圣衷。\n丹旐素舆攀送地，不胜清泪落西风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46317,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送侍御朱朝用副宪山东","author":"程敏政","text":"圣主龙飞景运开，豸冠人数出群才。\n方期抗疏当前席，忽报承恩佐外台。\n晓路星辰瞻北拱，春城车马候东来。\n洗冤泽物君能事，听取欢声遍草莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46318,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮会昌侯公子锦衣池亭","author":"程敏政","text":"白苧风生暑未收，夕阳容我复迟留。\n危亭翠匝诸峰晚，小洞阴涵六月秋。\n醉里尚能窥画品，兴来何必置诗邮。\n摩挲欲剖琅玕节，留取题名续胜游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46319,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中饮孙雪亭家看竹留题与雪亭子颐","author":"程敏政","text":"紫翠中盘一径苔，竹庭深处绝纤埃。\n穿林剩见新篁出，破暑俄惊旧雨来。\n秋露不辞分瓮吸，春风何必选花栽。\n主人爱客能传子，白社还应几度开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46320,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送徐用和御史调平凉镇原县令","author":"程敏政","text":"东风作轻阴，寒雨半成雪。\n端居政不怡，况子有远别。\n子本江汉英，所学重名节。\n平生爱君心，讵忍结吾舌。\n一疏天九重，冗食愧饕餮。\n皇恩真浩荡，暂遣谢朝列。\n迢迢西入关，山水几盘折。\n从来行路难，士岂动忧悦。\n相送城东门，车声晓幽咽。\n劝子酒一卮，世故若骚屑。\n勖哉夷险地，仗此一寸铁。\n不久应赐环，离歌勿终阕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46321,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆家山有作寄逸民用光道新 其一","author":"程敏政","text":"古城岩下半庄山，恰对澄江水一湾。\n列岫拖岚围竹坞，小塘分绿浸柴关。\n醉招猿鹤惊相下，清爱渔樵去复还。\n此景近来频入梦，病身何日可投閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46322,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆家山有作寄逸民用光道新 其二","author":"程敏政","text":"隔林沙径到岩扃，绕舍奇峰叠翠屏。\n野话有时逢衲子，溪行随处课租丁。\n看云净扫松间石，避暑閒登竹下亭。\n一自别来空怅望，移文真愧北山灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46323,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"分题履寿周原已院判乃尊","author":"程敏政","text":"老人不踏红尘路，踪迹常便水竹居。\n蹑屐登山如北日，杖藜随步胜安车。\n庭中任解王生袜，桥下谁传孺子书。\n但祝仙乔同寿考，双凫他日得凌虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46324,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送似都宪大器巡抚畿北","author":"程敏政","text":"宪节煌煌出帝州，一时风采属君侯。\n姓名已副苍生望，筹策应分圣主忧。\n六郡锄犁思乐岁，三关兵甲待防秋。\n行台咫尺红尘近，先听封章达冕旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46325,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送翰林检讨方昌言考绩还南京","author":"程敏政","text":"风流文采旧词臣，阙下重逢喜暂亲。\n别意两分鳌禁月，官情三及凤台春。\n山行水宿仍归路，饮社诗坛足慰人。\n何日南中容半席，玉亭深处看霜筠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46326,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丁祭日简费司业廷言","author":"程敏政","text":"陪祀年年候孔庭，每从司业借莎厅。\n衣冠假寐环东壁，钟漏传签报上丁。\n礼罢佩声风隐约，归时灯火夜晶荧。\n病躯无分随班列，展转斋居寝未宁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46327,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陈通政夫人哀挽","author":"程敏政","text":"晓日高堂罢起居，鬓丝萧索晚霜馀。\n回鸾色惨皇封诰，辟蠹香销女戒书。\n潮落钱塘悲逝水，山围龙井见幽墟。\n贤郎啼血扶归衬，不忍重看旧板舆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46328,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西宁侯著色牡丹为英国公题 其一","author":"程敏政","text":"侯门三月花如锦，分得春光与上公。\n何用洛阳求异谱，彩毫随处落香风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46329,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西宁侯著色牡丹为英国公题 其二","author":"程敏政","text":"镜中谁点旧姚黄，金缕衣轻翠袖长。\n倦倚东风娇白日，王孙亭榭见花王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46330,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送徵书纪南游","author":"程敏政","text":"炉薰经卷束装行，秋入船窗水气清。\n禅室未忘星北拱，乡心遥逐雁南征。\n三吴锦树长洲苑，六代青山建业城。\n来往诗筒应不绝，听人传取惠休名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46331,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送定西侯总戎北征","author":"程敏政","text":"手提金印下龙荒，九月边城草木黄。\n随处建牙分战士，刻期舆榇得戎王。\n风吹汉月笳声远，霜拂胡云剑气长。\n拟听玉关驰露布，泰阶那复候天狼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46332,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄于文远户侯","author":"程敏政","text":"横经日日缀鹓班，致主无才独厚颜。\n追忆旧游春醉处，梦魂常绕歙州山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46333,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画二首 其一 枯荷鹁鸽","author":"程敏政","text":"白苇枯荷两岸霜，水禽相恋水云乡。\n人间手足情何似，落日秋原引睇长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46334,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画二首 其二 梅花翠禽","author":"程敏政","text":"竹间无数玉森森，渐觉春随雪意深。\n山下地偏人迹少，野禽能识岁寒心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46335,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"为周都尉题沈石田画","author":"程敏政","text":"不见姑苏老沈郎，披图疑在石田庄。\n眼看雪乳春酲解，手拂云根午坐凉。\n高柳似填山下缺，奇峰如出镜中妆。\n草庭都尉能珍鉴，何日重开宝绘堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46336,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送户部叶叔通郎中知宁国府 其一","author":"程敏政","text":"民部清风十载馀，金绯一日荷恩除。\n秧田麦陇宣州道，多少人迎五马车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46337,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送户部叶叔通郎中知宁国府 其二","author":"程敏政","text":"桑梓悠悠共歙城，宦游京国倍多情。\n红尘离合常无定，从此相看听雁声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46338,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送户部叶叔通郎中知宁国府 其三","author":"程敏政","text":"昔年曾过敬亭山，花雾濛濛湿翠鬟。\n别后山容应不改，凭君传语慰孱颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46339,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送户部叶叔通郎中知宁国府 其四","author":"程敏政","text":"宛陵祠下竹娟娟，一榻曾分听夜泉。\n携酒寓公谁复在，六回春色到吟边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46340,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送户部叶叔通郎中知宁国府 其五","author":"程敏政","text":"故乡乔木隔山青，山郡人应候福星。\n民俗士风谙已熟，不须随路借图经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46341,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送户部叶叔通郎中知宁国府 其六","author":"程敏政","text":"村村鸡犬日相亲，宣歙山川本近邻。\n他日钓游仍作伴，不惭曾是受田人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46342,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"司言仪宾府赏菊","author":"程敏政","text":"眼低众芳摇落时，主家犹见菊花枝。\n偶同远客灯前笑，却后诸公卷里诗。\n乐趣定期邀月饮，交情谁比傲霜姿。\n晚香明岁还如故，百遍相招我未辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46343,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题沈石田悬崖松","author":"程敏政","text":"根蚀苍崖露半腰，声随风雨落寒潮。\n小堂六月题诗处，不觉人间暑气消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46344,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送长洲孙进士林赴南京刑部主事","author":"程敏政","text":"东风吹尘扑征车，欲行未行立踟蹰。\n行装萧萧一何有，上载经史下刑书。\n子向金陵意甚适，咫尺吴门是乡邑。\n登舟坐想春渡江，饯者如云晓亭集。\n亭前新柳飏金丝，手折听人歌柳枝。\n鲥鱼竹笋满南国，正是官曹开宴时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46345,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"慰李世贤学士丧子 其一","author":"程敏政","text":"双凤联胎本夙缘，小郎头角更堪怜。\n那知一片青云器，只向人间住七年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46346,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"慰李世贤学士丧子 其二","author":"程敏政","text":"聪明何止识之无，礼貌分明似壮夫。\n惜此钟情何日了，朱门愁绝旧悬弧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46347,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"慰李世贤学士丧子 其三","author":"程敏政","text":"每回骑马到君家，延坐中堂解供茶。\n白日重来空泪落，窗间惟有字如鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46348,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"慰李世贤学士丧子 其四","author":"程敏政","text":"春入高堂夜启筵，爱渠长立彩灯前。\n丁宁劝酒呼程叔，此语何时去耳边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46349,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"慰李世贤学士丧子 其五","author":"程敏政","text":"全婴有术贵徐徐，忍遣庸师断送渠。\n同榜弟兄虽异姓，为君思药诵医书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46350,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"慰李世贤学士丧子 其六","author":"程敏政","text":"暂寄藤棺古佛堂，神仙空说返魂香。\n月河桥下东流水，那及人家此恨长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46351,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"慰李世贤学士丧子 其七","author":"程敏政","text":"瓜祝诗成岁几更，人间悲喜漫多情。\n他时返吊还成贺，添取新篇续旧盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46352,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"慰李世贤学士丧子 其八","author":"程敏政","text":"气数从来有短长，达人那复计彭殇。\n知君年力犹精健，他日须同窦十郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46353,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"李士常侍御瓜祝卷次韵 其一","author":"程敏政","text":"弄璋那惜酒频赊，奇谶新徵李氏瓜。\n香实下临苔径密，瘦藤纷绕竹棚斜。\n歌声久入风人谱，庆泽先归友婿家。\n闻道诸郎能典谒，款门他日待供茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46354,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"李士常侍御瓜祝卷次韵 其二","author":"程敏政","text":"梦熊今已十年赊，入手真怜二月瓜。\n根胜预期穿土早，子多从遣压篱斜。\n来禽青李思临帖，白雪阳春愧作家。\n他日饷人分数蒂，一封兼侑歙州茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46355,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送乡人方亮南归","author":"程敏政","text":"佳水佳山说古岩，每回回首望云杉。\n松花有约分春瓮，贝叶无从启夜函。\n南国风光劳客梦，东华尘土弊朝衫。\n因君想像还家乐，浦口滩声早下帆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46356,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题定西侯画莱次俞振恭侍郎韵","author":"程敏政","text":"画史当年亦奋庸，园情犹共墨花浓。\n土酥辣玉真堪羡，菜色何人动两峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46357,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南窗遗教为刘道亨编修赋","author":"程敏政","text":"南窗人去几朝昏，遗墨能看一卷存。\n素楮装潢皆手泽，缥囊舒卷半啼痕。\n后生继述心良苦，先达流传道可尊。\n风散芸香沾剩馥，春回兰玉长芳根。\n泉蒙养处占羲象，庭训闻诗企鲁论。\n策似董生还及第，经传刘向本专门。\n玉堂绳武推严侍，紫诰貤封荷霈恩。\n弃简三年嗤伯鲁，书绅终日慕颛孙。\n菑畬转觉名家盛，慈教堪令薄俗敦。\n祀典何当分里社，书声犹记出沙村。\n拟?一勺西江水，遥酹青山处士魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46358,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题周草庭驸马二小景画 其一","author":"程敏政","text":"幽人最得幽居乐，山上危亭溪山阁。\n时容野客到柴关，不放红尘过林薄。\n新秋众木青且黄，烟中远浦闻鸣榔。\n渔樵倘许结新社，便欲垂涎云水乡。\n半枕悠悠梦初起，忽见丹青如梦里。\n披图说梦两茫然，蕉鹿分明浪惊喜。\n草庭都尉冰雪颜，胸中丘壑非等閒。\n何时对景瀹新茗，细话江南溪与山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46359,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题周草庭驸马二小景画 其二","author":"程敏政","text":"一夜山中三尺雪，银海周回烂银阙。\n呼童扫径启柴扉，竹外梅花正清绝。\n主人高眠尘虑空，有客扶杖来溪东。\n千崖万壑暗香度，乘兴不减孤山翁。\n旱风吹尘不成雨，对画欣然一挥麈。\n四围寒气欹凌人，如坐冰壶失炎暑。\n去酷来清君子心，平生不受炎凉侵。\n梅花三弄白雪调，惟有周郎知此心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46360,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮王世赏侍讲园亭限韵一首","author":"程敏政","text":"向晚移尊傍石屏，客身修竹两亭亭。\n诗悭并上酡颜赤，齿壮难留短鬓青。\n豪论未须挥玉麈，渴心常欲系铜瓶。\n感时更悯东郊雨，目送晴云入杳冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46361,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过丰润伯曹公留饮","author":"程敏政","text":"何处西城远市哗，南薰亭榭五侯家。\n主人赌令频输酒，侍史敲冰旋瀹茶。\n清暑最怜风外竹，慰人犹得雨前花。\n蹇予旧契非生客，一任山头白日斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46362,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杨应宁舍人相邀避暑韩太仆园与倪舜咨学士联句","author":"程敏政","text":"赤日黄尘奈暑何，郊园惟此绿阴多。\n四窗潇洒馀桃李，一径萦纡绕薜萝。\n地主盘餐饶楚味，野人丝竹尚燕歌。\n斜阳欲忘归途远，十里新堤带玉河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46363,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题王司言仪宾文会轩","author":"程敏政","text":"门前车马涨尘黄，静里开轩得趣长。\n当院日翻槐荫密，绕畦风送菜花香。\n谁家歌舞堪寻乐，此地衣冠欲擅场。\n满壁定多诗纪胜，主人无惜费壶觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46364,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送傅挥使还辽阳","author":"程敏政","text":"新命金绯自日边，匆匆鞍马又东旋。\n朱颜似有封侯骨，绿鬓方当报主年。\n沙碛夜屯占堠火，塞垣秋猎护营田。\n功成异日先诸将，莫负家传豹略篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46365,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送同年戴时中侍御谪判雅州","author":"程敏政","text":"一尊清晓钱行轩，又见名流出宪垣。\n南北暂为今度别，卷舒还诵昔人言。\n怒江舟楫经三峡，绝塞弓兵控六番。\n莫谓相忘天万里，九霄恩露不胜繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46366,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵沈廷美尚宝考绩还南京 其一","author":"程敏政","text":"金殿西头旧奉宸，重来何处问归津。\n尚方玉醑频沾醉，南国乌纱不耐尘。\n千里盈亏江上月，十年离合社中人。\n初秋倾倒旗亭宴，莫问诗神与酒神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46367,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵沈廷美尚宝考绩还南京 其二","author":"程敏政","text":"客邸相逢语未穷，分携俄复笑萍蓬。\n肯因官况侵头白，且遣离觞拂面红。\n古寺藤阴堪系马，水村芦叶待归鸿。\n两京不远那伤别，几日钟山入望中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46368,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"归省图为宋珍监生赋","author":"程敏政","text":"几宵客梦绕慈闱，仕路将亨喜暂归。\n倚杖涕随青露落，称觞心共白云飞。\n何蕃誉重诸生馆，莱子光添五色衣。\n忠孝一原君努力，他时分宠报春晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46369,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"刘振之自求寿诗","author":"程敏政","text":"岁岁佳辰一宴开，坐中相寿总诗才。\n因诗记子悬弧日，也约明年载酒来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46370,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿吴门蒋竹居九十进士县尹昂之父","author":"程敏政","text":"银烛东风作上元，正看称寿客盈门。\n朱颜鹤发真人瑞，绣服乌纱称主恩。\n令尹才名分甲第，此君风节共丘园。\n佳龄满百浑閒事，膝下重摩几世孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46371,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孙公子养正求题松赠徵上人南游","author":"程敏政","text":"谁分岩下种，孤秀出丛林。\n力饱冰霜健，根培雨露深。\n坐怜方外友，持结岁寒心。\n已共论三宿，临风更一吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46372,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和焦孟阳侍讲经筵宴退韵","author":"程敏政","text":"讲馀开宴日曈瞳，仰荷君王礼意隆。\n法酝似篘金水绿，宫衣遥射玉阑红。\n班资间阔亲元老，门榭追趍属上公。\n致主有心才不逮，十年陈说负天聪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46373,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]