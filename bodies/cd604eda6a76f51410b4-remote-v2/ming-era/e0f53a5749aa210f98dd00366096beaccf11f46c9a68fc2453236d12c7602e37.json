[{"title":"喜得酒联句","author":"夏良胜","text":"荒村难问市，古刹倒芳樽。\n强饮开怀抱，沈酣罢讨论。\n欹枕无多梦，连床更几人。\n明朝回马首，归路莫逡巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18743,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"醉中斗谑联句","author":"夏良胜","text":"吟尖方滑溜，醉眼欲摩挲。\n总为高情遣，其如逸兴何。\n儒风便脱落，僧话转多罗。\n且莫嘲同异，孔门有四科。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18744,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚眺联句","author":"夏良胜","text":"登高穷暮景，云树郁苍苍。\n牛饱眠烟草，鸟归送夕阳。\n渔艇趋前浦，僧钟出上方。\n坐深清到耳，寒涧落铿锵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18745,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"食瓜联句","author":"夏良胜","text":"剖破绿云房，来供天上郎。\n白分成片玉，清嚼满池霜。\n红子堆盘灿，馀甘浔齿香。\n青门随处是，何必问炎凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18746,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乘凉联句","author":"夏良胜","text":"披襟纳晚凉，微雨洒回廊。\n松吼虬龙怒，稻翻云雾黄。\n新词称绝唱，爽气协清商。\n更到山城远，檐铃代击梆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18747,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杏林春意","author":"夏良胜","text":"杏坛作孔道，杏林鸣仙居。\n儒医次第业，董樊先后车。\n三部脉息会，一点灵台虚。\n移此药天下，何必论刀圭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18748,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和荅云山塔寺小憩 其一","author":"夏良胜","text":"招提清欲水，不许点尘侵。\n径曲履痕薄，云封塔影深。\n佛说幻于古，人心巧似今。\n几多朝市客，方寸有山林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18749,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和荅云山塔寺小憩 其二","author":"夏良胜","text":"野寺寻真处，凭高望眼遥。\n天心留胜槩，人语在层霄。\n俗气从前避，清歌取次饶。\n明朝南北梦，嘉会惜寥寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18750,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过石门寺次邵二泉先生韵","author":"夏良胜","text":"水啮沙中石，声声入耳幽。\n忽然疑砥柱，何处觅瀛洲。\n野寺偏宜夏，溪毛可荐秋。\n棹歌来往发，到底不惊鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18751,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"洪都和胡副郎赴召二首 其一","author":"夏良胜","text":"脚根不避路，到处便为家。\n醉过十年梦，风抟一望沙。\n闲情诗入画，生意草方芽。\n长者须投辖，清清一味茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18752,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"洪都和胡副郎赴召二首 其二","author":"夏良胜","text":"尘封簪笏厚，一拂自今年。\n屯拟经纶济，忧当天下先。\n亭深风月上，书饱夜灯前。\n直到亨衢稳，披云见此天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18753,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次谢家埠用前韵 其一","author":"夏良胜","text":"烟草软十里，江云绕几家。\n犬灵夜当户，鸥懒晓眠沙。\n有缘寻道路，无处问根芽。\n兀兀推蓬坐，方壶有剩茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18754,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次谢家埠用前韵 其二","author":"夏良胜","text":"去路还归路，今年似昔年。\n坐高三尺浪，争著一篙先。\n风急鸟更疾，云移岸欲前。\n不堪回首处，家在一方天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18755,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟中夜坐","author":"夏良胜","text":"坐入江村夜，凄风两鬓生。\n渔灯忽明灭，野渡尚纵横。\n匣剑嫌光逸，囊琴觉调更。\n谯声不到耳，忽过雁归衡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18756,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过番阳湖二首 其一","author":"夏良胜","text":"宵发龙头镇，午过番阳湖。\n潴容百流秽，风轶片帆孤。\n光芒镜未似，畔岸天为模。\n野笛渔舟晚，行行雁落芦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18757,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过番阳湖二首 其二","author":"夏良胜","text":"眼眶才落此湖光，却叹身如湖里航。\n破浪只销心上稳，乘风何必望中洋。\n浃宵飞渡真为策，泛月归来不用忙。\n许国有怀如李泌，孤城明日是端阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18758,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过范光湖遇变自慰","author":"夏良胜","text":"岸圻湖光恶，天翻万叠云。\n真于百死地，扶出再生人。\n未构唐公稿，几随屈子沦。\n冯夷应有意，留我献明君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18759,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟中写怀","author":"夏良胜","text":"一舸放此老，泛泛江湖游。\n寄迹真浮梗，何心问撞舟。\n路通颜氏濑，诗入米家流。\n有子横舟在，白头高卧丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18760,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"对月书怀","author":"夏良胜","text":"厌家思作客，客久梦还家。\n两睫抉此月，寸心纷似麻。\n亏盈真有度，南北更无差。\n岑寂谁驱得，开尘放瓮霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18761,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春雨散衙后用杜公韵写怀三首 其一","author":"夏良胜","text":"春半尚无花出墙，一番疏雨为催芳。\n煖从南去多应早，寒到北来真较长。\n金粟陌头才柳色，银瓶窗外乱梅香。\n何如燕子还相识，衔得空泥占屋傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18762,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春雨散衙后用杜公韵写怀三首 其二","author":"夏良胜","text":"春思苦撩乱，啼乌来树间。\n寒光尽流水，雨暝失高山。\n案牍求生意，妻孥强笑颜。\n家乡在万里，长是梦中还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18763,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春雨散衙后用杜公韵写怀三首 其三","author":"夏良胜","text":"何处开怀抱，天涯问讯人。\n懒成长似癖，酒薄也添春。\n只拚心中苦，相看竹上青。\n应门无客报，头秃不须巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18764,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春雨二首 其一","author":"夏良胜","text":"晓风吹面软，轻帽送寒归。\n山阁雨声碎，野亭云气霏。\n草知催地力，青欲上人衣。\n闲数随来雁，今朝似较稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18765,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春雨二首 其二","author":"夏良胜","text":"雨凉侵短榻，春睡起偏迟。\n鸠拙寻遗构，鹰扬耐蚤饥。\n干戈经路滑，箫管动乡悲。\n愿和征夫泪，吹来鬓上丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18766,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春雪","author":"夏良胜","text":"云点行人鬓，相看尽是翁。\n檐流翻作雨，衫薄尚禁风。\n欲混鹅毛白，休迷鹤顶红。\n梅花惊大晚，春老北枝空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18767,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和三厓寿陈封君竹坡先生七十","author":"夏良胜","text":"少壮薄宦游，老作隐学士。\n种竹缘江坡，清风日来此。\n此心虚且贞，对竹颜无泚。\n扬尘落飘飘，夜雨频磨洗。\n老劲掣六鳌，渭川不在彼。\n垂垂雪低枝，寒梢依日起。\n白发映绿簪，何必论年纪。\n龙孙呈萧森，断截备国史。\n椽管秃瓮多，董狐良足儗。\n丹砂天上来，绯衣忽加尔。\n故人重相过，无主亦自美。\n引泉务厚滋，醉日还移祉。\n威凤谐笙簧，笑歌闻正始。\n再过三十年，此坡付儿子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18768,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"对雪二首 其一","author":"夏良胜","text":"积雪堆还堕，贪心欲占秋。\n桥迟驱蹇策，江晓打鱼舟。\n山向云中老，人如画里游。\n僵眠饿茅屋，歌舞乱南楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18769,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"对雪二首 其二","author":"夏良胜","text":"夜雪密于昼，春寒忽过秋。\n忙搊东郭履，不见子猷舟。\n枝压鸟争啄，花浓蝶怕游。\n望中浑一色，何处认琼楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18770,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春郊杂兴五首 其一","author":"夏良胜","text":"茅屋不知得，春来三月深。\n蛛丝过游目，鸟语自伤心。\n谋到野中获，诗随景上寻。\n何人兼吏隐，吾欲再生今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18771,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春郊杂兴五首 其二","author":"夏良胜","text":"社鼓村村闹，相看又一年。\n好怀因出郭，尘肺欲浇泉。\n山怪云堆恶，林疏日影穿。\n笑歌惊落帽，无意仰书天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18772,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春郊杂兴五首 其三","author":"夏良胜","text":"高柳未匀绿，小桃初著红。\n两家斗芳媚，一任付东风。\n供茗来方士，扶犁见老翁。\n杜鹃非吊蜀，肠断莫岑中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18773,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春郊杂兴五首 其四","author":"夏良胜","text":"短墙垂薜荔，茎嫩绿眠苔。\n吊古谁能事，匡今我不才。\n烟萝孤隼落，泉镜乱鱼开。\n立马长桥问，源头何处来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18774,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春郊杂兴五首 其五","author":"夏良胜","text":"孤村寻窦氏，古庙拜刘生。\n风节乾坤老，流光草木荣。\n感时思警策，屯难厌浮名。\n俯伏山陵下，卑陈犬马情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18775,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽李从事母","author":"夏良胜","text":"贼来夫就縳，贼去妇欲捐。\n赎身尚可百，挥金安惜千。\n赤手捍锋刃，死心良可镌。\n亦有几男儿，鱼肉终无传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18776,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿杨玉峰先生八十","author":"夏良胜","text":"晴霞绚朝日，相对玉峰高。\n白发明蓬矢，青樽送海桃。\n洛中应主社，林下已忘骚。\n何处寻司马，斑衣未二毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18777,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻东征得捷","author":"夏良胜","text":"将军驰露布，有喜上龙颜。\n破竹迎锋下，持斨未缺间。\n天地若为大，鲸鲵秪自顽。\n论功书杰阁，欲拟燕然山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18778,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冬日言志","author":"夏良胜","text":"翛翛此长夜，一榻百虑生。\n何如晏眠人，日上三两楹。\n眷彼金石声，杂我砌下鸣。\n心茅日斩刈，寒谷迁双莺。\n开口笑未得，著耳颓垣倾。\n恶风穿鸟户，相对独关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18779,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题四皓","author":"夏良胜","text":"泥涂四老翁，伏腊商山侧。\n不堕留侯机，安使汉庭识。\n天子惊且疑，梦寐见颜色。\n颓衰挟痴儿，隐祸顿销息。\n一言系炎鼎，表表人臣极。\n非无经国资，所志在逃匿。\n冥鸿奋高秋，习习快两翼。\n岂知觊觎人，有恨填胸臆。\n神器匪私授，造化良可测。\n白云方英英，紫芝窅无迹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18780,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哀征夫","author":"夏良胜","text":"西风听鸣镝，马首云已东。\n征夫诜诜行，惨淡尘烟中。\n潢池恣狗鼠，崩骞并元戎。\n霜重铁衣冷，奔突驱群?。\n杀气日未薄，岂必三刑同。\n旧鬼乌啄肉，新鬼号瑶空。\n寒月照营白，暝色霏濛濛。\n岂不念妻儿，饥冻垂飞蓬。\n北里倾尊醁，南邻烧烛红。\n岁暮未归得，何当思挂弓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18781,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日郊行","author":"夏良胜","text":"春来三月好，景足四郊中。\n豁豁羁怀放，骙骙马首东。\n林深藏鸟语，香远送花风。\n缓辔真如意，当途肯叹穷。\n远山青掩霭，短草绿蒙茸。\n思入兰亭妙，诗嫌谢老工。\n洗觥钱换酒，侧帽鬓垂蓬。\n野气迷坰坞，茅檐接大空。\n感时谁可后，忧世我当雄。\n百亩全无种，春饥未卜丰。\n杜鹃桥上过，休遇洛阳翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18782,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽白司厅表之","author":"夏良胜","text":"世为衣冠重，文兼道义名。\n夏官思赞理，天部写铭旌。\n夜月秋亭古，春风晚棹轻。\n旧游元是梦，寒骨照山明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18783,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽陶纯甫","author":"夏良胜","text":"纷纷入世路，生死竟如何。\n两县野棠合，西曹旧案多。\n濠梁遗好伴，薤露踏哀歌。\n萧索盱眙墓，还看宿草么。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18784,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"写荣恩卷","author":"夏良胜","text":"教子祈忠国，匡扶愿显亲。\n元非博富贵，终见荷丝纶。\n乌帽新笼发，霞绡稳称身。\n焚香开玉轴，举目是枫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18785,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郊行陪祀十首 其一","author":"夏良胜","text":"乍出寒郊外，分明似坝桥。\n合冰连断野，孤树入层霄。\n瘦马还堪策，饥乌信可招。\n一程兼百里，行尽不知遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18786,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郊行陪祀十首 其二","author":"夏良胜","text":"地旷心逾远，天寒气更清。\n识时曾似雁，解语不闻莺。\n公瑾元非酒，羊斟却怨羹。\n宦情羁思并，怅怅此郊行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18787,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郊行陪祀十首 其三","author":"夏良胜","text":"厚颜思肉食，何意数干支。\n葭管愁添线，昆明待凿池。\n奔波三日路，滋味几人知。\n收得闾阎事，琅玕向我披。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18788,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郊行陪祀十首 其四","author":"夏良胜","text":"独有乾坤意，墙头欲放花。\n先几催草木，候气蛰龙蛇。\n塞上翁难识，垆边酒易赊。\n更无人肯问，温饱是谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18789,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郊行陪祀十首 其五","author":"夏良胜","text":"好日瞢腾过，幽怀拍塞开。\n空随驴上老，不见雪中梅。\n和气因人致，风烟逐我来。\n城头悲鼓角，寒璧落残苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18790,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郊行陪祀十首 其六","author":"夏良胜","text":"不问燕山桂，那知玉井泉。\n稚儿方缊草，老妇未衣绵。\n夜梦追三窟，朝餐费万钱。\n提兵须几镇，何独向西川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18791,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郊行陪祀十首 其七","author":"夏良胜","text":"春祠冬烝夜，清清入妙香。\n一班随进退，终岁异温凉。\n册祝昭禋远，衣冠卜吉藏。\n不须占王气，寒冱树苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18792,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郊行陪祀十首 其八","author":"夏良胜","text":"何处寻云窦，泉凝雪满池。\n林端悬鲫鲙，山麓集江蓠。\n貂帽寒绵卒，茅檐哭饿儿。\n为探幽兴出，番惹闷相随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18793,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郊行陪祀十首 其九","author":"夏良胜","text":"松密堪承露，山高不碍云。\n金汤元有主，天地本无文。\n仰赖祖宗德，从教夷夏分。\n若非雄据稳，戎马尚缤纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18794,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郊行陪祀十首 其十","author":"夏良胜","text":"去路还归路，伤怀更几何。\n风尘随处是，须鬓笑人多。\n衰草牛横笛，霜林鸟乱歌。\n无端情思恶，掩耳莫相过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18795,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠傅生宗会归南城","author":"夏良胜","text":"傅生姻家子，少独事一室。\n野气薄城郭，大朴浑不失。\n长途买棹夫，抱难纷如质。\n质之者为谁，王子我所密。\n入口即禹穴，雅不伸佔毕。\n忽来告我归，四方志了一。\n居然改大观，逾望已六七。\n为告我故人，作器须树漆。\n我行与王子，摩厉方自弼。\n遽曰前人车，飞骞杳无匹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18796,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送朱侍御按蜀","author":"夏良胜","text":"剑外行骢日，春风为拂鞍。\n相思劳太史，知己尚儒冠。\n象马须忘险，疮痍未剧安。\n无缘起诸葛，留与阵图看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18797,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"天寿山三十韵","author":"夏良胜","text":"列圣联宾驭，开山閟玄灵。\n熊罴俨象魏，喉嗌限边庭。\n文皇主万国，武略呵六丁。\n南天立斧扆，北漠空毡屏。\n诏檄靖氛祲，弧矢威麋泠。\n仁宗薄世祚，章帝垂遥青。\n文人号宣朗，载籍辉繁星。\n英庙驻狩辙，策士惊羸瓶。\n穹庐覆真主，臣妾居靡宁。\n回天入缵服，杰阁图渠形。\n两朝定主鬯，多难携常经。\n外蛇就藩府，永巷辞严扃。\n殿色日炯炯，宫流夜溁溁。\n柴桑犬睡屋，荻藻渔翻汀。\n老农问旱魃，乐腊功玄冥。\n升平见歌舞，贤俊易岧嵉。\n梦觉过百岁，垣墉谁一听。\n风愆布后轨，剑舄分遗馨。\n六驾宫车晏，八音山谷停。\n木天元有撰，铁笔已忘硎。\n汉原陪翼亮，秦祀增光荧。\n谩记鼎湖谶，毋刊狠石铭。\n龙髯攀弰角，凤翥献翘翎。\n午夜风潜壑，霜天月在坰。\n虎丘干象纬，骊阜失崤泾。\n贱臣愧肉食，闵世随漂萍。\n分行拜釐祝，五云和露零。\n老马先主心，腐草后秋萤。\n长夜代烛光，冷石殊醉醒。\n天地有常主，断鳌撑北溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18798,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠刘侍御还蜀寿母","author":"夏良胜","text":"长安日已远，蜀道胡尔难。\n恋恋佳儿心，夜夜梦中还。\n一命得取道，万里谁当关。\n去时年少行，惊见毛发斑。\n母寿古亦稀，儿归良独艰。\n菊花酿露魄，豸绣明春颜。\n东望拜天子，南国方威蛮。\n九阪须叱驭，四牡行歌还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18799,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"久雨和荅崇道一首","author":"夏良胜","text":"潦雨没街渠，源头水亦活。\n归骑惊瀊涡，努力睛闪烁。\n入门坐空斋，旅思苦索莫。\n岂无居高堂，谁复念蛙窟。\n疏茅湿已穿，重絺疑大薄。\n愁添甲子头，望入巫山脚。\n昨夜方酣眠，清风动帷幕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18800,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中闲叙荅和崇道二首 其一","author":"夏良胜","text":"闭门深寂寂，有待为君开。\n书笥元无底，酒乡羞未醅。\n鸣鸠雨不歇，惊燕夜方回。\n飒飒清凉足，明朝秋气来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18801,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中闲叙荅和崇道二首 其二","author":"夏良胜","text":"交谊论今古，知心见子期。\n只缘多病癖，深荷寄方奇。\n行蚁竹枝上，小车花外移。\n盘餐聊尔共，重约抱琴时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18802,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽林节妇","author":"夏良胜","text":"掩袖黄昏泪，深闺白发新。\n不缘身后语，能系未亡人。\n有子承衰谢，无家合苦辛。\n君恩还士论，赢得对苍旻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18803,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"除夕和石江韵 其一","author":"夏良胜","text":"暂把好怀抱，开颜向客边。\n岁穷还有日，醉倒不须钱。\n笳鼓儿童市，寒酸尺五天。\n不妨论甲子，明日又添年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18804,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"除夕和石江韵 其二","author":"夏良胜","text":"客愁连岁积，都到夜灯边。\n家信来三日，官衔直几钱。\n买痴作白眼，把酒问青天。\n卧听晓钟发，翻疑说去年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18805,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"除夕和石江韵 其三","author":"夏良胜","text":"燕歌墙外度，高遏彩云边。\n袖出降魔剑，囊无卖赋钱。\n星躔随历次，更漏一壶天。\n莫怨宫流水，泠泠不系年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18806,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]