[{"title":"阙调名 中秋夜小酌即席示二弟小词二首 其二","author":"杨慎","text":"月照三更。\n鹊绕南枝雁亦惊。\n庾楼高兴，休教辜负今夜十分明。\n凄清何处管弦声。\n彷佛燕台紫陌行。\n便从今夕话离情。\n明年此景，又隔凤凰城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28378,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙","author":"杨慎","text":"远道明朝万壑冰。\n华堂今夕九枝灯。\n娇歌姹管醉难胜。\n幻玉风流南北院，飞琼仙梦短长亭。\n青楼回首十三层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28379,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"黑漆弩 其一 谢曾少岷题扇","author":"杨慎","text":"梁尘飞绕停教住。\n有哲匠坐上原父。\n早梅时、新月弯弓，喜见遥天收雨。\n尉迟杯、满酌休辞，半臂急催忙去。\n写蒲葵，一字千金，付阿买、珍藏好处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28380,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"黑漆弩 其二 谢熊南沙跋帖","author":"杨慎","text":"月仪蠹简留君住。\n索靖是右军师父。\n笑藏真、酗酒狂僧，说甚龙蛇风雨。\n戏鱼堂、响榻重镌，莫道影留形去。\n熊朋来，鼎韵钟铭，鉴赏到、西台妙处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28381,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"唐多令 中秋与夺客泛舟","author":"杨慎","text":"飞镜露云头。\n金波水面浮。\n水晶宫、今夜中秋。\n唤取官奴吹玉笛，香雾湿，锦云留。\n二客亦风流。\n螂川泛小舟。\n问何如、赤壁黄州。\n坡老有灵应鼓掌，天地寄浮蝣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28382,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蝶恋花 二阕 其一","author":"杨慎","text":"璧月琼枝风韵在。\n皎皎盈盈，自拗梅花带。\n一笑倾城迷下蔡。\n暗香疏影春难赛。\n年纪无多情性快。\n翠袖金杯，满劝深深拜。\n禅室散花元不碍。\n道人还了鸳鸯债。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28383,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蝶恋花 二阕 其二","author":"杨慎","text":"月白珠玄成一派。\n灼灼红灯，光映猩猩菜。\n天女从来银色界。\n肌肤冰雪牵人爱。\n护粉羞黄如有待。\n镜约钗盟，只恐旁人怪。\n弦上分明传意态。\n何时许解香罗带。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28384,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金字经 二首 其一 江上晚归","author":"杨慎","text":"璧月寒生晕，银河冻欲冰。\n稳坐蓝舆酒半醒。\n登。\n渔舟红蓼汀。\n樵楼暝。\n冬冬初起更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28385,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金字经 二首 其二 江上晚归","author":"杨慎","text":"窗纸风偏透，衾裯冷不胜。\n欹枕挑灯诗又成。\n听。\n更鼓最无凭。\n同云暝。\n檐花滴到明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28386,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"减字木兰花","author":"杨慎","text":"乌衣椎髻。\n龙女改妆歌薜荔。\n立近梅花。\n弄粉团香衬脸霞。\n真真唤醒。\n便出墨池登雪岭。\n醉写乌丝。\n齐唱东风第一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28387,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"锦缠带","author":"杨慎","text":"谁家红袖倚江楼。\n手卷珠帘上玉钩。\n眼波娇溜满眶秋。\n笑抬头。\n头上花枝颤未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28388,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"折桂令 昭君出塞图","author":"杨慎","text":"乱纷纷，玉蕊冰花。\n气结愁云，泪湿腮霞。\n高阙千寻，停骖一顾，漠漠黄沙。\n只见三队五队，槊旌旗，舞风番马。\n千点万点，绕穹庐，成阵寒鸦。\n一曲琵琶。\n几拍胡笳。\n目断飞鸿，恨满天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28389,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鹧鸪天","author":"杨慎","text":"恰喜高秋爽气新。\n却愁秋月解伤神。\n酒阑二十年前事，梦醒三千里外身。\n枫叶岸，菊花津。\n且须勤买阿宁春。\n帐头傀儡元来假，枕上邯郸岂是真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28390,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"临江仙","author":"杨慎","text":"水上生尘罗袜，风前束素纤腰。\n陈王瞥见已魂消。\n妒云开翠幄，笑电闪红绡。\n此去但留今夕，重来定约何朝。\n西陵南浦路迢迢。\n徘徊花上月，空度可怜宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28391,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西江月","author":"杨慎","text":"漫道革囊盛血，休言炭帚污人。\n禅机仙术两成尘。\n输与花门柳阵。\n被欲生棱夜永，带翻成结灯昏。\n东园桃李片时春。\n不是少年风韵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28392,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"巫山一段云 绍途遇雪","author":"杨慎","text":"梅柳春相近，关山雪正飞。\n寒光朔气冷侵衣。\n玉塞隔金微。\n久戍人将老，长征马不肥。\n帛书欲寄雁声稀。\n秃节几时归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28393,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"临江仙 送刘珥江洎杨许二子","author":"杨慎","text":"官柳野梅西郭路，昆桥直接丰桥。\n相思百里不辞遥。\n春山同载酒，月地共联鏕。\n南去北来人自老，怜予心旆摇摇。\n短亭暂别亦魂销。\n生烟寒漠漠，飞霭晚潇潇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28394,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"千秋岁 壬寅新正二日寿内","author":"杨慎","text":"瑶池阿母。\n本是神仙侣。\n谪向人间官府。\n住摄提，贞孟月，中子逢初度。\n琅霄宴，春回北斗斟云醑。\n麟笔春秋谱。\n彤管毛诗语。\n女洙泗，闺邹鲁。\n五福中天聚。\n百秩从今数。\n最难得，芝兰庭下斑彩舞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28395,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"好事近 煮茶进，和蔡松年韵","author":"杨慎","text":"彩线利如刀，解破团圆明月。\n兰薪桂火筠炉，听松风翻雪。\n唤取眠云跂石人，赛十洲三绝。\n焚香朗诵黄庭，把肺肝清彻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28396,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"霓裳中序第一 雨中刘珥江送鸡头","author":"杨慎","text":"青霞裁雾縠。\n正锦潋瑶潘碧澳。\n水底鲛人织女。\n当翠房深处，新妆乍沐。\n尘消罗袜，冶步盈盈出鳞屋。\n向何许，满身璎珞，云辙转风毂。\n皎镜全澄独漉。\n相掩映、荷裳芰服。\n昨夜龙宫失晓也，养天鸡、启明传旭。\n啄粮无半菽。\n算只有明珠满腹。\n江妃把、金针穿玩，递与素娥掬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28397,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鹊桥仙 七夕","author":"杨慎","text":"冰盘荐巧，珠帘堆莹，半卷生绡光致。\n嫦娥妒眼便西沈，又早倩、羲和催辔。\n多情瑞鹊，填桥度我，何不晓来回避。\n但教三万六千年，也不若、人间百岁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28398,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"滇海竹枝词 其一","author":"杨慎","text":"罗汉孤峰祇树林，梁王辇道海中心。\n海垠青青堪牧马，海眼只今无处寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28399,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"滇海竹枝词 其二","author":"杨慎","text":"东浦彩虹悬水椿，西山白雨点寒江。\n烟中艇子摇两桨，空里鹭鸶飞一双。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28400,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蜀中竹枝词 其一","author":"杨慎","text":"夔州府城白帝西，家家楼阁层层梯。\n冬雪下来不到地，春水生时与树齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28401,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蜀中竹枝词 其二","author":"杨慎","text":"日照峰头紫雾开，雪消江面绿波来。\n鱼腹浦边晒网去，麝香山上打柴回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28402,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蜀中竹枝词 其三","author":"杨慎","text":"江头秋色换春风，江上枫林青又红。\n下水上风来往惯，一年长在马船中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28403,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蜀中竹枝词 其四","author":"杨慎","text":"最高峰顶有人家，冬种蔓菁春采茶。\n长笑江头来往客，冷风寒雨宿天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28404,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蜀中竹枝词 其五","author":"杨慎","text":"青江白石女郎神，门外往来祈赛频。\n风飐青旗香雨歇，山桂花开瑶草春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28405,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蜀中竹枝词 其六","author":"杨慎","text":"红妆女伴碧江濆，蓪草花簪茜草裙。\n西舍东邻同夜烛，吹笙打鼓赛朝云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28406,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蜀中竹枝词 其七","author":"杨慎","text":"神女峰前江水深，襄王此地几沉吟。\n?花温玉朝朝态，翠壁丹枫夜夜心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28407,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蜀中竹枝词 其八","author":"杨慎","text":"上峡舟航风浪多，送郎行去为郎歌。\n白盐红锦多多载，危石高滩稳稳过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28408,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蜀中竹枝词 其九","author":"杨慎","text":"无义滩头风浪收，黄云开处见黄牛。\n白波一道青峰里，听尽猿声是峡州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28409,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杨柳枝词 其一","author":"杨慎","text":"汉东门外柳新栽，拂晓长堤露眼开。\n野老攀条相向语，去年曾被贼烧来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28410,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杨柳枝词 其二","author":"杨慎","text":"临水临风漾碧漪，含烟含雾一枝枝。\n战尘收后无离别，又见长条到地时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28411,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西江月 廿一史弹词第一段总说开场下场词二首 其一","author":"杨慎","text":"天上乌飞兔走，人间古往今来。\n沉吟屈指数英才。\n多少是非成败。\n富贵歌楼舞榭，凄凉废冢荒台。\n万般回首化尘埃。\n只有青山不改。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28412,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西江月 廿一史弹词第一段总说开场下场词二首 其二","author":"杨慎","text":"滚滚龙争虎斗，匆匆兔走乌飞。\n席间花影坐闲移。\n百岁光阴有几。\n说古谈今话本，图王定霸兵机。\n要知成败是和非。\n都在渔樵话里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28413,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南乡子 廿一史弹词第二段说三代开场词","author":"杨慎","text":"携酒上吟亭。\n满目江山列画屏。\n赚得英雄头似雪，功名。\n虎啸龙吟几战争。\n一枕梦魂惊。\n落叶西风别换声。\n谁弱谁强多罢手，伤情。\n打入渔樵话里听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28414,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西江月 廿一史弹词第二段说三代下场词","author":"杨慎","text":"阅尽残编断简，细详千古英雄。\n功名富贵笑谈中。\n回首一场春梦。\n昨日香车宝马，今朝禾黍秋风。\n谁强谁弱总成空。\n傀儡棚中搬弄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28415,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"临江仙 廿一史弹词第三段说秦汉开场词","author":"杨慎","text":"滚滚长江东逝水，浪花淘尽英雄。\n是非成败转头空。\n青山依旧在，几度夕阳红。\n白发渔樵江渚上，惯看秋月春风。\n一壶浊酒喜相逢。\n古今多少事，都付笑谈中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28416,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西江月 其一 廿一史弹词第三段说秦汉下场词","author":"杨慎","text":"落日西飞滚滚，大江东去滔滔。\n夜来今日又明朝。\n蓦地青春过了。\n千古风流人物，一时多少英豪。\n龙争虎斗漫劬劳。\n落得一场谈笑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28417,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西江月 廿一史弹词第四段说三分两晋开场下场词二首 其二","author":"杨慎","text":"道德三皇五帝，功名夏后商周。\n英雄五霸斗春秋。\n秦汉兴亡过手。\n青史几行名姓，北邙无数荒丘。\n前人田地后人收。\n说甚龙争虎斗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28418,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西江月 廿一史弹词第四段说三分两晋开场下场词二首 其三","author":"杨慎","text":"豪杰千年往事，渔樵一曲高歌。\n乌飞兔走疾如梭。\n眨眼风惊雨过。\n妙算龙韬虎略，英雄铁马金戈。\n争名夺利竟如何。\n必有收因结果。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28419,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清平乐 廿一史弹词第五段说南北朝开场词","author":"杨慎","text":"闲行闲坐。\n不必争人我。\n百岁光阴弹指过。\n成得甚么功果。\n昨日羯鼓催花。\n今朝疏柳啼鸦。\n王谢堂前燕子，不知飞入谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28420,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西江月 廿一史弹词第五段说南北朝下场词","author":"杨慎","text":"飒飒西风渭水，萧萧落叶长安。\n英雄回首北邙山。\n虎斗龙争过眼。\n闲看灞桥杨柳，凄凉露冷风寒。\n断蝉声里凭阑干。\n不觉斜阳又晚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28421,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"点绛唇 廿一史弹词第六段说十六国开场词","author":"杨慎","text":"暮鼓晨钟，春花秋月何时了。\n七颠八倒。\n往事知多少。\n昨日今朝，镜里容颜老。\n千年调。\n一场谈笑。\n几个人知道。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28422,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西江月 廿一史弹词第六段说十六国下场词","author":"杨慎","text":"六代瓜分世界，五胡云扰中原。\n纵横三百有余年。\n几度交锋索战。\n马过生灵齑粉，血流河洛腥膻。\n耳闻犹自不堪言。\n有眼休教看见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28423,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"临江仙 廿一史弹词第七段说隋唐开场词","author":"杨慎","text":"一片残山并剩水，年年虎斗龙争。\n秦宫汉苑晋家茔。\n川原流恨血，毛发凛威灵。\n白首诗人闲驻马，感时怀古伤情。\n战场田地好宽平。\n前人将不去，留与后人耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28424,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西江月 廿一史弹词第七段说隋唐下场词","author":"杨慎","text":"追想千年往事，六朝踪迹茫然。\n隋唐相继统中原。\n世态几回云变。\n杨柳凄迷汴水，丹青惨淡凌烟。\n乐游原上草连天。\n飞起寒鸦一片。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28425,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"定风波 廿一史弹词第八段说五代十国开场词","author":"杨慎","text":"雨淋漓滩赴选场。\n秀才落得甚干忙。\n白发渔樵诸事懒。\n萧散。\n闲谈今古论兴亡。\n虞夏商周秦楚汉，三分南北至隋唐。\n看到史官褒贬处。\n得趣。\n不摇纨扇自然凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28426,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西江月 廿一史弹词第八段说五代十国下场词","author":"杨慎","text":"千古伤心旧事，一场谈笑春风。\n残编断简记英雄。\n总为功名引动。\n个个轰轰烈烈，人人扰扰匆匆。\n荣华富贵转头空。\n恰似南柯一梦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28427,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蝶恋花 廿一史弹词第九段说宋辽金夏开场词","author":"杨慎","text":"检尽残编并断简。\n细数兴亡，总是英雄汉。\n物有无常人有限。\n到头落得空长叹。\n富贵荣华春过眼。\n汉主长陵，霸主乌江岸。\n早悟夜筵终有散。\n当初赌甚英雄汉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28428,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西江月 其一 廿一史弹词第九段说宋辽金夏下场词","author":"杨慎","text":"三百余年宋史，辽金西夏纵横。\n争强赌胜弄刀兵。\n谁解倒悬民命。\n富贵草梢垂露，英雄水上浮萍。\n是非成败总虚名。\n一枕南柯梦醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28429,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西江月 廿一史弹词第十段说元朝开场下场词二首 其二","author":"杨慎","text":"山色消磨今古，水声流尽年光。\n翻云覆雨数兴亡。\n回首一般模样。\n清景好天良夜，赏心春暖花香。\n百年身世细思量。\n不及尊前席上。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28430,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西江月 廿一史弹词第十段说元朝开场下场词二首 其三","author":"杨慎","text":"细想三皇五帝，一般锦绣江山。\n风调雨顺万民安。\n不见许多公案。\n后世依他样子，齐家治国何难。\n流芳百世在人间。\n万古称扬赞叹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28431,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谒金门 落花","author":"王世贞","text":"风渐陡。\n排比饯花春酒。\n憔悴一枝红欲皱。\n问花花恋否。\n寂寞乍长清昼。\n无计与他拖逗。\n犹胜销魂人去后。\n折来还在手。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28432,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浪淘沙","author":"杨慎","text":"春梦似杨花。\n绕遍天涯。\n黄莺啼过绿窗纱。\n惊散香云飞不去，篆缕烟斜。\n油壁小香车。\n水渺云赊。\n青楼珠箔那人家。\n旧日罗巾今日泪，湿尽韶华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28433,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鹧鸪天 西庄","author":"杨慎","text":"秋水澄清胜酒醅。\n野烟笼榭似楼台。\n弹声林鸟山和尚，写字寒虫水秀才。\n乘兴去，兴阑回。\n夕阳影里记徘徊。\n正思修禊明年约，无奈鸣驺得得催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28434,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"凤栖梧 送薛治曲泉之镇雄勘夷手卷","author":"杨慎","text":"借寇歌廉春有脚。\n皂盖朱幡，辉映江阳郭。\n一喢清泉斟且酌。\n候人无事闲铃阁。\n瘴域岚方劳锁钥。\n静柝沉锋，虎凶成鸾鹤。\n风飐归旌诗满橐。\n休迟竹马儿童约。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28435,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"青玉案 昆明邝尹升万州守歌","author":"杨慎","text":"昆明春水盈盈渡。\n咫尺又、销魂路。\n金马碧鸡遗爱处。\n卧辙攀辕，留綦解佩，望望仙尘去。\n鹏海鲸波天一柱。\n紞紞鼓声催欲曙。\n金紫重来还肯许。\n帝加三锡，民歌五裤，早沛清时雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28436,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜迁莺 贺薛曲泉抚台旌奖","author":"杨慎","text":"青阳有脚。\n喜五马重临，江阳城郭。\n南定云开，西岷波静，帘卷风清幕。\n旱魃化为甘雨露，祷不须泥鹤。\n兆万宝，咏千箱四野，丰年如约。\n斟酌。\n曾见说，老手剧郡，利器无盘错。\n犬吠花村，鱼游春水，桴鼓长闲却。\n伫闻考绩薇垣，复报荐名荷橐。\n计晨夕，莺迁燕贺，金明紫渥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28437,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"归朝欢 亨衢陟明歌","author":"杨慎","text":"秋尽汀洲苹未歇。\n掩映荻花相向折。\n一枝好赠朝天人，还如鳷鹊楼前雪。\n琼凹连玉凸。\n五城边银为宫阙。\n墀声寒，非烟丛里，卿蔼瑞云缬。\n五马骄嘶虬漏彻。\n鞘静佩鸣鹓簉列。\n朱衣引队奏彤帏，天言清问尧阶切。\n俞音传衮鷩。\n赐金增秩干旄孑。\n把勋名，昭回青简，身许稷和契。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28438,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"百字令 病中起登楼填词一首","author":"杨慎","text":"遥峰青染，见天外树杪，余霞红闪。\n小榭轻埃喜屏翳，层阴才收有渰。\n钟鼓新晴，楼台暮景，快听渔阳掺。\n酒市旗亭，何处青帘飞飐。\n惆怅枕病凋年，棐几尘生，荆扉昼掩。\n药里关心诗总废，谁问东皋西崦。\n过却重阳，篱边都不见，玉镶金锬。\n峭寒无寐，沉沉细数更点。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28439,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酹江月 和坡仙韵，赠陈广文致政归","author":"杨慎","text":"阳关休唱，且须尽、陶令杯中之物。\n宦海无津喜君归，仙叟紫房青壁。\n泉石新盟，烟霞旧梦，怀抱皆冰雪。\n清风堪挹，斜川栗里争杰。\n缅想松菊门庭，田园幽事，兴头先发。\n情话琴书消遣处，笑看浮沤生灭。\n棋局酒樽，桑榆境相对，朱颜玄发。\n行歌坐啸，一任抹风批月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28440,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]