[{"title":"赠霓裳十二首 其一","author":"胡应麟","text":"响遏行云未足多，阳春流水定如何。\n夜来小玉飞银汉，传得开元第一歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19173,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠霓裳十二首 其二","author":"胡应麟","text":"一枝明艳照窗纱，曾事仙人萼绿华。\n唱彻山香蓬岛上，瑶池千树尽飞花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19174,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠霓裳十二首 其三","author":"胡应麟","text":"玉面朱唇陌上逢，香车油壁乍从容。\n莫教行雨峰头去，寻遍巫山十二重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19175,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠霓裳十二首 其四","author":"胡应麟","text":"睡足纱窗昼漏迟，白樱桃下画蛾眉。\n珠帘百尺重门闭，沉水香销月上时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19176,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠霓裳十二首 其五","author":"胡应麟","text":"金屋何曾盼阿娇，临春歌吹总寥寥。\n遥空一片飞云驻，人倚危阑弄玉箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19177,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠霓裳十二首 其六","author":"胡应麟","text":"月底朱丝竞管弦，风前红袖趁鞦韆。\n争誇静婉腰围细，不解湖头唱采莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19178,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠霓裳十二首 其七","author":"胡应麟","text":"紫燕双飞掠画楼，黄莺百啭和箜篌。\n妖姬十五颜如玉，底事长干唤莫愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19179,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠霓裳十二首 其八","author":"胡应麟","text":"女伴相携斗晚妆，风鬟云鬓若耶傍。\n乍宵湖上归来晚，阿姊同游字蕙芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19180,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠霓裳十二首 其九","author":"胡应麟","text":"振袂飞霜袭彩毫，新声频奏郁轮袍。\n十千长恨真堪买，三百灵光漫诧豪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19181,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠霓裳十二首 其十","author":"胡应麟","text":"瘦妻羸女各伤神，紫凤天吴拆洗频。\n笑杀杜陵溪水畔，云鬟香雾是何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19182,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠霓裳十二首 其十一","author":"胡应麟","text":"七香霞佩午珊珊，骏马金羁照玉颜。\n跋扈飞扬湖海上，前身莫是李东山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19183,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠霓裳十二首 其十二","author":"胡应麟","text":"园桃巷柳色纷纷，素口蛮腰并出群。\n不信寒酸饶下驷，西京谁并卓文君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19184,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题艺苑五游册 其一 琴","author":"胡应麟","text":"玉轸閒挥望太空，目随中散送征鸿。\n无劳郢国千人和，白雪晴飞大海东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19185,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题艺苑五游册 其二 棋","author":"胡应麟","text":"杖底双龙跨夕阳，荒村仙妪坐更长。\n枯棋三百无人共，零乱青霞满石床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19186,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题艺苑五游册 其三 书","author":"胡应麟","text":"八法纵横晋永和，鸾笺十幅照春罗。\n科头独抱兰亭帖，散步临池看白鹅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19187,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题艺苑五游册 其四 画","author":"胡应麟","text":"沉水香焚白玉壶，洞门深锁碧云孤。\n窗明几净人声绝，閒写初平叱石图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19188,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题艺苑五游册 其五 诗","author":"胡应麟","text":"独坐匡床枕半敧，山堂寒雨涨秋池。\n夜阑松子前阶落，吟得襄阳五字诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19189,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曳杖村西閒步见壁间二语甚佳而不知名字漫为易数字足成之","author":"胡应麟","text":"红白花开篱豆齐，野人茅屋乱云西。\n庭前桑树老无叶，日午邻鸡飞上啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19190,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐惟得冲漠斋十二绝 其一 壶丘示观","author":"胡应麟","text":"寂寂玄关闭万缘，颓然一榻抱枯禅。\n天游未许时人识，正是壶丘入观年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19191,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐惟得冲漠斋十二绝 其二 姑射凝神","author":"胡应麟","text":"肌肤绰约瑩秋霜，绝顶凝神眺八荒。\n得丧窅然天地外，不知身世住何乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19192,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐惟得冲漠斋十二绝 其三 郑圃御风","author":"胡应麟","text":"羊角鹏程快羽毛，罡风八极送飞涛。\n窅然天际真人度，始信长沙蹋翼劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19193,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐惟得冲漠斋十二绝 其四 南郭隐几","author":"胡应麟","text":"静坐焚香一亩宫，灰心槁念夕阳中。\n那能滥作吹竽客，凭几萧然万虑空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19194,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐惟得冲漠斋十二绝 其五 化人蹑景","author":"胡应麟","text":"振袂翩翩到北辰，中天城阙跨金银。\n谁言半亩差容膝，十二瑶台属化人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19195,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐惟得冲漠斋十二绝 其六 华胥梦游","author":"胡应麟","text":"勇退何人犯急流，分司犹摄醉乡侯。\n朝来梦入华胥界，一榻轩皇尽意游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19196,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐惟得冲漠斋十二绝 其七 摩诘散花","author":"胡应麟","text":"掷戟归来理钓竿，不将零露望金盘。\n飞花散尽三千界，丈室分明有大观。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19197,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐惟得冲漠斋十二绝 其八 少林面壁","author":"胡应麟","text":"勇猛精修万劫离，穷年枯坐更何疑。\n为言一苇浮江日，可似三花面壁时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19198,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐惟得冲漠斋十二绝 其九 雪山空寂","author":"胡应麟","text":"战胜归来岩穴间，空花落尽闭禅关。\n大千世势冥心处，恍惚当时坐雪山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19199,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐惟得冲漠斋十二绝 其十 五台清凉","author":"胡应麟","text":"古寺清凉辟草莱，三湘门巷半莓苔。\n翻然杖锡腾空去，閒看飞云落五台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19200,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐惟得冲漠斋十二绝 其十一 漆圃逍遥","author":"胡应麟","text":"一枝殊自慰鹪鹩，身世千年付泬㵳。\n北海南溟俱莫问，长空何处不逍遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19201,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐惟得冲漠斋十二绝 其十二 昙阳恬澹","author":"胡应麟","text":"空山寂寂午闻鸡，一路桃花照旧蹊。\n漫说娄江恬淡观，真仙今在武陵西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19202,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐惟得冲漠斋又题八绝 其一 丛青阁","author":"胡应麟","text":"叠搆危梯入窈冥，长空不断暮天青。\n松阴竹色凭栏处，次第千山入画屏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19203,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐惟得冲漠斋又题八绝 其二 白云洞","author":"胡应麟","text":"石洞苍茫闭水帘，碧窗云冷玉龙潜。\n不妨行雨邀巫峡，犹记为霖出傅岩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19204,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐惟得冲漠斋又题八绝 其三 水竹居","author":"胡应麟","text":"袅娜千竿翠欲沉，一区烟雨坐来深。\n君恩乞与潇湘地，閒听苍龙日夜吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19205,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐惟得冲漠斋又题八绝 其四 习家池","author":"胡应麟","text":"岘首穹碑百尺遗，襄阳仍睹习家池。\n如泥不学山公醉，自唱铜鞮岸接䍦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19206,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐惟得冲漠斋又题八绝 其五 九玄室","author":"胡应麟","text":"画栋雕甍挟斗牛，瑶箱琼笈锁层楼。\n五千何代传周史，三万当今跨邺侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19207,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐惟得冲漠斋又题八绝 其六 适意轩","author":"胡应麟","text":"九列三孤亦偶然，能将簪绂误流年。\n归期趁得西风蚤，何限鲈鱼七泽前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19208,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐惟得冲漠斋又题八绝 其七 四顾亭","author":"胡应麟","text":"万壑千岩照眼明，中天苍翠扑檐楹。\n凭栏四顾皆秋色，疑是山阴道上行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19209,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐惟得冲漠斋又题八绝 其八 偃息居","author":"胡应麟","text":"水击天飞快羽翰，巢林聊借一枝安。\n参差已熟邯郸道，枕上从他万劫残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19210,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即席","author":"胡应麟","text":"刺史苏州欲断肠，腰围尺六舞霓裳。\n若为并作卢家燕，双宿双飞玳瑁梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19211,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万伯修中丞东巡歌十首 其一","author":"胡应麟","text":"大纛高牙拂绛霄，青袍白马似风飙。\n千帆掣海鲸波静，万炮抟空蜃市消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19212,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万伯修中丞东巡歌十首 其二","author":"胡应麟","text":"三千门客报晨鸡，八百家丁耀水犀。\n何处精兵逾代北，由来飞将出山西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19213,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万伯修中丞东巡歌十首 其三","author":"胡应麟","text":"平倭望海说刘江，闽越新传戚继光。\n底似中丞文武略，弯弧飞檄到扶桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19214,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万伯修中丞东巡歌十首 其四","author":"胡应麟","text":"平壤王京铁骑屯，西飞青政尽游魂。\n笑他定远空投笔，华发萧萧望玉门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19215,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万伯修中丞东巡歌十首 其五","author":"胡应麟","text":"对马洲前积甲悬，黑云东起雾连天。\n辕门夜缚平行长，露布星飞北极前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19216,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万伯修中丞东巡歌十首 其六","author":"胡应麟","text":"关白头枭太白旗，白狼河上羽书驰。\n楼船却笑文皇帝，百万雕戈困不支。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19217,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万伯修中丞东巡歌十首 其七","author":"胡应麟","text":"麾下俱封万户侯，金戈净洗萨摩洲。\n山城肥后诸酋长，叩颡遥天拜玉旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19218,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万伯修中丞东巡歌十首 其八","author":"胡应麟","text":"诗才旧压丁都护，将略平欺霍冠军。\n一代鸡林传丽句，千秋麟阁画元勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19219,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万伯修中丞东巡歌十首 其九","author":"胡应麟","text":"烂漫黄金百尺台，将军飞骑入蓬莱。\n何须更奏征东曲，十八铙歌尽手裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19220,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万伯修中丞东巡歌十首 其十","author":"胡应麟","text":"万甲凭陵大海东，清江鸭绿乱流红。\n元戎奏凯归来日，天子晨开碣石宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19221,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送安头陀还兰阴作同少傅公四首 其一","author":"胡应麟","text":"野鹤孤云去路长，袈娑随处谒空王。\n楞伽一卷焚香坐，先到裴公绿野堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19222,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送安头陀还兰阴作同少傅公四首 其二","author":"胡应麟","text":"百丈金身照绿苔，青莲璎珞护瑶台。\n天龙一指犹堪竖，莫诧西方大士来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19223,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送安头陀还兰阴作同少傅公四首 其三","author":"胡应麟","text":"十年湖海话禅机，归问云山旧衲衣。\n后夜月明金锡冷，遥空笙鹤不停飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19224,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送安头陀还兰阴作同少傅公四首 其四","author":"胡应麟","text":"六洞三山次第看，白云回望满长安。\n何须更觅莲花藏，一代金轮属宰官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19225,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东园四时词 其一 春","author":"胡应麟","text":"尺书何处候青鸾，吟遍东风十二栏。\n金谷楼台春尚蚤，海棠憔悴不禁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19226,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东园四时词 其二 夏","author":"胡应麟","text":"薰风长日度帘钩，河朔园林总胜游。\n珠箔银屏清吹满，石榴花底按梁州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19227,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东园四时词 其三 秋","author":"胡应麟","text":"朝来檐树著新霜，小玉银筝抱雁行。\n红蓼碧芦秋十里，不知亭榭在潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19228,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东园四时词 其四 冬","author":"胡应麟","text":"雪片高天坠草庐，瑶台鸾鹤望清虚。\n梅花万树孤山下，何似桥头策蹇驴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19229,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王太学至卿一子四岁未能言尝两遇大厄梦异僧获存或夙生有缘习也一绝纪之","author":"胡应麟","text":"似梦如痴画阁前，前身谁为问梯仙。\n三生我亦琼楼客，一堕风尘四十年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19230,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王生庭中二雏鹤见余甚狎即席赠诗二章 其一","author":"胡应麟","text":"尺八翩跹凤鸟文，雌雄追逐气凌云。\n怪来花下如相识，曾是当年鹳鹤群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19231,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王生庭中二雏鹤见余甚狎即席赠诗二章 其二","author":"胡应麟","text":"凌风相逐下瑶池，雪羽霞标灿陆离。\n自是主人多逸兴，庭前双鹤解看棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19232,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题浮屠秋溟卷时以姑布术游都下 其一","author":"胡应麟","text":"扶馀国小漫称王，定远封来白发长。\n自是青莲多傲骨，错将奇句恨昭阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19233,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题浮屠秋溟卷时以姑布术游都下 其二","author":"胡应麟","text":"射虎年来渐白头，南山风雪夜悠悠。\n他时太史传飞将，肯信平阳第一筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19234,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万伯修东巡歌八首 其一","author":"胡应麟","text":"麟阁由来画虎头，辕门此日拜貂裘。\n金泥玉玺从天下，御笔亲题定远侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19235,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万伯修东巡歌八首 其二","author":"胡应麟","text":"闻道将军武略饶，频年横槊绝临洮。\n酡酥一醉楼船上，十万雄师已渡辽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19236,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万伯修东巡歌八首 其三","author":"胡应麟","text":"亲提精甲到平襄，汛扫鲸鲵百丈强。\n莫诧伏波年尚少，大标铜柱在扶桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19237,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万伯修东巡歌八首 其四","author":"胡应麟","text":"征马翩翩度北风，干将曾授白猿公。\n胡床静夜梅花落，万骑长驱一啸中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19238,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万伯修东巡歌八首 其五","author":"胡应麟","text":"铁甲三千照大幢，金戈百万洗长江。\n前茅壮士讴歌发，一箭天山夜请降。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19239,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万伯修东巡歌八首 其六","author":"胡应麟","text":"无定河边息鼓笳，受降城下听琵琶。\n何劳更问燕然碣，万丈穹碑勒海涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19240,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万伯修东巡歌八首 其七","author":"胡应麟","text":"山西诸将定谁贤，烈烈营平四海传。\n尽扫先零何足道，千秋勋业付屯田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19241,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万伯修东巡歌八首 其八","author":"胡应麟","text":"露布千言尽手裁，霜笳奏凯入蓬莱。\n西京枉貌麒麟阁，文武何人吉甫才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19242,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王行父惠簟赋谢二绝 其一","author":"胡应麟","text":"伏天无处避斜曛，冰簟何由借鹤群。\n漫作巫娥云雨梦，月明环佩下湘君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19243,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王行父惠簟赋谢二绝 其二","author":"胡应麟","text":"珠帘十二照华堂，一卷湘云白日长。\n已悉王恭无长物，莫教残夜踞胡床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19244,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再送远游明府二绝 其一","author":"胡应麟","text":"一叶晴飞大海傍，东南云色满钱塘。\n谁言蓟阙三千里，夜夜双凫入上阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19245,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再送远游明府二绝 其二","author":"胡应麟","text":"千秋重睹豫章材，五夜狂歌雪色来。\n莫向斗牛占紫气，雌雄龙剑合燕台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19246,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉城十景为侍御泾邑叶公赋 其一 石门锁翠","author":"胡应麟","text":"峭壁危崖暮霭屯，桃花开落自乾坤。\n中天积翠无人到，万岫飞霞锁石门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19247,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]