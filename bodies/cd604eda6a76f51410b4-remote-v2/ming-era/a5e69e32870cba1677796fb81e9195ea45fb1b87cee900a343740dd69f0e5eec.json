[{"title":"秋郊晚望","author":"区怀年","text":"玉露凉侵白苧衣，早惊沙雁渐郊扉。\n戈鋋风劲悲摇落，城郭秋阴怅式微。\n葭际远村渔火暗，水边孤寺梵钟稀。\n何人静扫烟氛色，痛饮黄龙夜猎归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33449,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓门吊古","author":"区怀年","text":"吴山勒马事难量，肯信勾陈落大荒。\n陬澨几人消血泪，劫灰何日更冠裳。\n九渊天水归墟际，三创王仁过化乡。\n文治苟存终积弱，不禁渔父怨苍茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33450,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦天","author":"区怀年","text":"蹑云仙□露光团，桂影横秋半渥丹。\n碧落素霞生组练，高空瑶水振漪澜。\n驱鸾广殿征新曲，受简深宫赋晓寒。\n迢递彩虹香陌远，无人同倚月中看。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33451,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻有辟丹梯洞者既而不果戏题一律","author":"区怀年","text":"何处丹梯倚碧天，翠微千尺隐秋烟。\n巨灵肯借移山斧，徐福空劳泛海船。\n岩户远扃人不到，乳泉无混鹿初眠。\n行将短策牵幽侣，一访餐蒲煮石仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33452,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春兴","author":"区怀年","text":"曲池新水戏纤鳞，琐尾谁怜涸辙人。\n愁雨一窗花气损，暖风千结柳容伸。\n菑畴待展耕烟镈，里闬还馀漉酒巾。\n莫引素琴翻白雪，恐惊巢燕落香尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33453,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春暮有怀","author":"区怀年","text":"越井荒榛晏禊期，呼鸾人逖涨江湄。\n杜韦曲暗龙媒袅，王谢门更燕子疑。\n新水藕塘烟漠漠，断云兰泽雨丝丝。\n采芝歌罢东园老，迟眺云山怅黍离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33454,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄梁非馨司马","author":"区怀年","text":"犹忆班荆鲍井东，佩刀尘涴累雕虫。\n惊心虞圃青笳月，别梦邮亭白芷风。\n三径就荒容客傲，四愁赓赋与君同。\n鹿裘带索行歌晚，不及云霄逐剪蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33455,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答黄宗伯","author":"区怀年","text":"一从江岭暗流氛，凄断彤墀鸳鹭群。\n沉璧晚依沧海月，采薇春剪越山云。\n西周薄伐思雄旅，南国专征有冠军。\n憔悴夷门旧时客，白头空负信陵君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33456,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋前一夕月下剧谈感赋","author":"区怀年","text":"海天华月散微凉，门倚霜皋芡芰香。\n觱篥远愁虚枕簟，蒹葭离思满溪塘。\n风惊野鹜秋将半，木落栖乌夜未央。\n迢递蒋陵烽火隔，斗城宫树郁苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33457,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋夜同诸兄弟侄孙小集分得寒字","author":"区怀年","text":"秋光如绘四愁拚，襦绤宵轻却绮纨。\n兰畹旧滋香不减，桂轮高拥魄初寒。\n书将海国兵车厉，咏入凉风缟带欢。\n沾醉几人羞短发，可堪牛斗自阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33458,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋后一夕溪上对月","author":"区怀年","text":"素魄哉生黯佩缑，迟回银汉夜深愁。\n孤砧远戍烦霜杵，长笛谁家听海楼。\n清霭眺残珠树杳，碧云思断桂花秋。\n溪光临影牵乌鹊，葛屦凉侵露未收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33459,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西园述感","author":"区怀年","text":"半亩芳阴长碧荃，十年孤愤答龙泉。\n愁同谢豹深藏影，欲借巫咸试问天。\n幽戺石苔空返照，短篱霜叶带疏烟。\n萧条里闬秋堪赋，何处青山有暮田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33460,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日江洲忆望先垄","author":"区怀年","text":"厌裛凉风白堕杯，繁霜空薙越山莱。\n孤村萸菊沦荒燹，野戍亭皋问劫灰。\n云老杜鹃乡国泪，草枯黄犊墓田哀。\n伤心无限西州路，落日寒烟首重回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33461,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沅溪除夕","author":"区怀年","text":"愁踵星霜老葛巾，几堪垂暮戒劳薪。\n乱离不损溪山客，畸贱还同草莽臣。\n天际碧云閒梦虑，枕边华发倦风尘。\n年光欲换疏更度，岩桂先知海国春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33462,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古灞川上作","author":"区怀年","text":"金西舟楫半鱼家，碧堰萧萧带夕霞。\n谷月暗催彭泽酒，西风寒襭邵平瓜。\n孤村水落牛涔见，远戍烽高雁字斜。\n蓬转未须愁晦迹，暂随宵梦到蒹葭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33463,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"?川晚眺有感","author":"区怀年","text":"苍鹰不上钓鱼矶，烟圃香生笋蕨肥。\n海势日涵孤屿出，溪声时答片帆归。\n白蘋埭堰过春潦，芳芷汀洲恋夕晖。\n回首莫淹乡国虑，竹窗谁识故人违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33464,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲午七夕小酌溪上草堂","author":"区怀年","text":"门倚溪阴野钓收，藕花含影露香浮。\n孤村淡月迷乌鹊，斜汉凉风倩女牛。\n方狎雅盟消永夜，转宜蔬酌对高秋。\n搴衣欲附星槎上，醉拥仙人十二楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33465,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月酌忽为微云所掩筦尔成篇","author":"区怀年","text":"野堂酾酒动星文，榆社秋阴怅未分。\n歌倚绿樽酣坠露，坐閒瑶瑟思停云。\n关山万里征人梦，河汉三更唳鹤闻。\n十二玉窗寒不启，琅璈应撤紫宸君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33466,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋夜半溪上对月","author":"区怀年","text":"何许西风掠钓竿，满溪蟾魄籅香残。\n凉生几席三更展，情溢关山几处看。\n兰桨箨冠分野趣，绮窗瑶瑟阙清欢。\n玉绳高际怜孤影，莫遣微霜到广寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33467,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕","author":"区怀年","text":"星渚云軿夜不禁，填桥乌鹊静高林。\n溪堂薄暑宽秋扇，海国凉风引暮砧。\n瓜果席边残醉咏，机丝天上隔年心。\n飞觥欲问乘槎客，碧落愁牵几度阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33468,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日漫兴","author":"区怀年","text":"何许西风醵酒钱，鹿门人卧菊花天。\n霜飘旅雁愁汀屿，木落巢乌恋井廛。\n穹海钓竿疏晚节，小山丛桂发秋烟。\n凭高莫易生惆怅，曾倒萸觞醉日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33469,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谢关少宰为司徒季父题撰墓志","author":"区怀年","text":"旧德庸舒国计忧，青云谁解泣西州。\n峰坳石倚延陵剑，涧户霜含大壑舟。\n天宠十年寒马鬣，墨花何处借龙楼。\n凭君一曲山阳笛，吹入凉风垄树秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33470,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山馆待月","author":"区怀年","text":"谷口莎鸡趁寂寥，碧天无碍客星摇。\n萧疏院落含秋霭，咫尺江干遝暮潮。\n霜浦荻花迷雁字，露檐枫叶冷鲛绡。\n飞光远溯今何夕，槁发愁侵漫欲凋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33471,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"从云端还阮溪示乡中亲友弟侄","author":"区怀年","text":"?东菑稼近如何，箬笠难消野兴多。\n秋雨泽梁生石发，夕阳山寺界烟萝。\n鹤巢无恙闲中觑，鸥社忘机狎处过。\n相劳岂愁津渡远，客怀今已付行歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33472,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春夜薄醉放声长歌俄成一律","author":"区怀年","text":"新腔忽忆浣溪沙，谁拥珠徽奏落霞。\n蝴蝶戏残香是粉，杜鹃魂黯血仍花。\n悲风早激湘君浦，谑浪曾专谢客家。\n酣倚玉缸春兴损，曲尘飞尽见生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33473,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中漫兴","author":"区怀年","text":"曲篱疏牖对烟溪，春雨微微水槛西。\n过浦远帆牵客思，比邻深树听莺啼。\n屠荒薤芋供朝馌，税壅菑畴课晚犁。\n坚卧莫愁沾湿苦，垄云方借一枝低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33474,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀五羊别业兼寄所知","author":"区怀年","text":"酒帘花市旷径过，幽事宁如老去何。\n山近尉城春草绿，井连萧寺夕阳多。\n国香空谷邀琴写，家食衡门带索歌。\n疏雨自沾苔径曲，几人鸠杖破烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33475,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"松堂村晚步","author":"区怀年","text":"招隐曾攀桂树柯，病馀诗兴总消磨。\n还谁载笔趋金马，挟侣锄云种木鹅。\n虚负雅怀千日醉，转怜衰季一身多。\n兵争郡国无宁役，日暮愁听劳者歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33476,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新月","author":"区怀年","text":"桂苑初辉碧汉隈，商歌休按紫云回。\n玉环当夕谁应剖，宝镜临妆半欲开。\n零落蒹葭催捣素，晚风楼阁待传杯。\n嫦娥此际怜孤寝，斜抱银钩护影来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33477,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孀妇顿为人妾因赠以诗聊申爽德之戒","author":"区怀年","text":"检点残妆雅操轻，柏舟曾否慰同声。\n十年素雪坚冰誉，一夕浓香丽粉情。\n天上结璘愁独处，日南么凤厌孤鸣。\n殷勤寄语青闺伴，莫矢寒灯老布荆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33478,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立夏前一宵溪上待月","author":"区怀年","text":"溪烟如缕散斜曛，度口渔歌隔浦闻。\n甫醉欲留春不住，微吟胥警夜初分。\n虚甔偃蹇愁逋客，野角牢骚懈戍军。\n蟾魄似知风候转，独迟清梦溯鸥群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33479,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阮溪七夕","author":"区怀年","text":"闲情披豁到沧州，静侣时呼问酒筹。\n烟覆井栏窥宿鸟，月横河鼓怅牵牛。\n溪窗暑散蒹葭暮，石几香盈菡萏秋。\n迢递七襄云未展，夜深徐觉暗萤流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33480,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答陈乔生给谏","author":"区怀年","text":"中洲新咏迈吾曹，逸事增传海屿高。\n猿啸九秋閒只影，凤仪诸夏戢轻毛。\n班荆野酌忧难属，拾蓣长欃课独劳。\n咫尺美人天际想，棣花零落重忉忉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33481,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊戌早春","author":"区怀年","text":"绿藻沿溪荡暖烟，忽惊衰鬓度华年。\n风声厌柘循梅事，露处愁荒岛屿天。\n兰畹旧香迷匼匝，果桥新市旷秋千。\n孤鶱物外歌黄雀，晦影蓬蒿啄野田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33482,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感遇","author":"区怀年","text":"薪劳悔悟晚寻幽，积恨丛愆自水流。\n尘外物情閒纪梦，酒边花醉薄销愁。\n人归远浦青帆暮，雁旅寒烟碧树秋。\n身放病留天意解，圃云栖倦笔耕俦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33483,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将订诸子为尘外之游","author":"区怀年","text":"餐霞秘事幽言结，浪迹游仙慕阮嵇。\n兰芷护书留鹤梦，醁醽邀约待莺啼。\n残香冻雨莎亭圮，薄霭晴沙莽隙低。\n观化悦心閒卧稳，圃场分荫绿汀西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33484,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花朝寄友人","author":"区怀年","text":"九十春光半已销，几堪离索鬓丝凋。\n烟深楚塞愆榆火，露拂吴堤变柳条。\n海燕有情先社至，逵鸿无虑报书遥。\n采芳南国乌衣客，蹀躞桃花锦障骄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33485,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜宿山家","author":"区怀年","text":"畦蔬荐豆倾尘曲，净榻悬灯护槿扉。\n栖鸟暮喧林外壑，断虹秋隐石边围。\n溪烟漱瀑疏兰若，磴月缘天掠翠微。\n西浦极看遥埭暗，习风凉露薄沾衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33486,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花朝席上即事","author":"区怀年","text":"虚窗午坐邀谈麈，小阁书函数帙尘。\n如梦野人溪鹿失，远怀幽客海鸥驯。\n锄烟垄外村炊析，襭藻池边社酌新。\n疏雨绿阴垂柳岸，怆神先度一分春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33487,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗若思贻珍珠菊与客同赋","author":"区怀年","text":"芳菲愁断未能裁，谁展霜姿到碧苔。\n鲛室泪消琼岛月，凤城香绽素霞杯。\n佳人咳唾三秋色，野客追攀九日台。\n欣赏岂须银烛照，坐阑应有夜光来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33488,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答黄石公明府","author":"区怀年","text":"十载论交梦亦虚，青云天上动离居。\n弦更单父春风满，舄诣河阳太史书。\n永誉几番传鸑鷟，新诗何日寄江鱼。\n衡门渐老牛衣客，白石歌残思有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33489,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠高公调","author":"区怀年","text":"玉峤情深赋蒯缑，仲宣才具怅依刘。\n名花好鸟看春遍，剩水残山戏墨收。\n流转朱门伤客散，乱离襄国待兵休。\n何时笑引桓伊笛，醉倚江城黄鹤楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33490,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"迦陵庵偶述","author":"区怀年","text":"庵罗小结野情宽，逸步谁停百尺竿。\n人在定中闻唳鹤，客从归后忆栖鸾。\n藤窗挂月宵逾迥，石磬穿云夏亦寒。\n畦径自纡尘不扫，入门休作懒融看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33491,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"溪晚","author":"区怀年","text":"十里波光快濯缨，颍川逃迹岂关名。\n驱鸡似托巢云想，听鸟空怜伐木声。\n文誉别山存副墨，劫尘荒圉畏佳兵。\n迂怀漫洒千秋泪，待拂寒霜眺贾城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33492,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画 其一","author":"区怀年","text":"远树碧阴合，孤峰秋霭微。\n钓竿閒不那，溪畔有渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33493,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画 其二","author":"区怀年","text":"江村春已暮，杜若满芳洲。\n急雨翻丛薄，前山翠欲流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33494,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画 其三","author":"区怀年","text":"清溪绕屋流，古木苍烟积。\n竹牖带风雨，山光来几席。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33495,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"崧台杂曲 其一","author":"区怀年","text":"石乳含秋叆，松姿敛夕曛。\n岩前怕吹笛，惊起鹜鸥群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33496,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"崧台杂曲 其二","author":"区怀年","text":"莫凿流霞岛，从教紫翠深。\n偶扶藜杖去，閒听水龙吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33497,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟居书事 其一","author":"区怀年","text":"雨馀鸥社合，风袭钓缗轻。\n晚食怜渔父，同深洲渚情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33498,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟居书事 其二","author":"区怀年","text":"秋蔼薄云樯，汐光连浦树。\n迟迟海月生，独惬烟波趣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33499,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟居书事 其三","author":"区怀年","text":"罟网疏阴合，蒹葭白露寒。\n醉眠孤棹底，聊作枕流看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33500,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花 其一","author":"区怀年","text":"若问寒梅意，香分庾岭多。\n江南无限雪，清润见阳和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33501,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花 其二","author":"区怀年","text":"槎影横孤屿，风姿别一亭。\n鸟驯香欲醉，花落意还醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33502,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花 其三","author":"区怀年","text":"独占溪山胜，寒香问有无。\n但持风格在，不受俗尘污。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33503,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题集华林","author":"区怀年","text":"涧绕香厨竹，风披草阁烟。\n野猿机事少，林外学安禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33504,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"樵山杂咏 其一","author":"区怀年","text":"丘中恣遐眺，篱落散炊烟。\n细雨鸿花发，山山红欲燃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33505,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"樵山杂咏 其二","author":"区怀年","text":"绿稠山径小，农隙黍香微。\n草际喧童牧，牛羊薄暮归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33506,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺中新月","author":"区怀年","text":"宝镜光疑蚀，金波影尚亏。\n却怜孤寂况，不是妒蛾眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33507,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城八景 其一 越台秋月","author":"区怀年","text":"古径罢呼鸾，高台不堪上。\n奈此霜魄孤，悠然照林莽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33508,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城八景 其二 石门返照","author":"区怀年","text":"断石横烟渚，菰蒲日易昏。\n片帆千里客，漭漭欲销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33509,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城八景 其三 灵洲鳌负","author":"区怀年","text":"郁水抱璿宫，飞甍湛新渌。\n势欲浮空明，何人断鳌足？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33510,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城八景 其四 景泰僧归","author":"区怀年","text":"溪阴老云衲，乞食过前村。\n薄暮疲筇笠，空山闻扣门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33511,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城八景 其五 蒲涧帘泉","author":"区怀年","text":"入林缨可濯，百尺泻清泠。\n不用张萝幌，潺湲待客听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33512,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城八景 其六 扶胥浴日","author":"区怀年","text":"桑木难为攀，金乌荡空白。\n三山倒影来，转觉沧溟窄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33513,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城八景 其七 大通烟雨","author":"区怀年","text":"春皋閒霢霂，积霭昼多阴。\n欲指烟中寺，霏微不可寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33514,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花信愁 其一","author":"区怀年","text":"花愁累月不解，酒债经时暂逋。\n浑脱从他作队，高阳笑我非徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33515,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花信愁 其二","author":"区怀年","text":"夙昔未谙愁况，蹉跎远寄孤踪。\n若计松滋晚穫，石田处处妨农。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33516,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花信愁 其三","author":"区怀年","text":"巢松注想匡谷，棹雪空怀剡溪。\n岁月满腔愁谱，都从烟雨凄迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33517,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花信愁 其四","author":"区怀年","text":"蹇劣徒悲浪迹，迂慵薄拟焚修。\n千秋脍炙平子，叙咏空闻四愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33518,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]