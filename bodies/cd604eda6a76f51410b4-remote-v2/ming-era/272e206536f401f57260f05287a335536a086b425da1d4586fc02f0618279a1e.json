[{"title":"题墨菊 其二","author":"郑真","text":"纷纷桃李若为容，篱落秋深晚色重。\n山月暗时人不寐，墨香何似菊香浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题红菊","author":"郑真","text":"西风有梦过园篱，帐底佳人睡起迟。\n应是秋香空淡泊，晓妆亦得点胭脂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题王右军书扇面","author":"郑真","text":"越山高步碧云梯，洗墨池寒落照低。\n仙子已骑鸾鹤去，白团如月问谁题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题广信王氏园菊本十种 其一 胜金黄","author":"郑真","text":"幽花黄胜袅蹄金，唤醒人间富贵心。\n正色本来天造化，风霜不怕九秋阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题广信王氏园菊本十种 其二 御爱黄","author":"郑真","text":"秋香送喜入天容，采采承恩雨露浓。\n愿奉君王千万寿，御袍黄映玉袍重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题广信王氏园菊本十种 其三 相袍紫","author":"郑真","text":"□□□□□□□，西风篱落九秋高。\n檀心岂羡公侯贵，彭泽归来独慕陶。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题广信王氏园菊本十种 其四 鹤顶红","author":"郑真","text":"折得秋葩鹤顶红，丹砂点染幻神功。\n苦心欲寄蓬莱客，愿借胎仙两翼风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题广信王氏园菊本十种 其五 赛琼华","author":"郑真","text":"往事繁华逐水流，西风吹梦到扬州。\n花心不与青春竞，冰雪萧萧过九秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题广信王氏园菊本十种 其六 万卷书","author":"郑真","text":"芳信谁传万卷书，花神可是费工夫。\n凭君寄与陶居士，香露漙漙泻玉壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题广信王氏园菊本十种 其七 状元红","author":"郑真","text":"西风花看状元红，芳气纷纷正恼公。\n莫向人间夸折桂，当年也到广寒宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题广信王氏园菊本十种 其八 探花白","author":"郑真","text":"忆向琼林去探花，瑶台玉宇认天家。\n月明彷佛群仙过，素袖娉婷帻岸纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题广信王氏园菊本十种 其九 榜眼黄","author":"郑真","text":"榜眼谁夸进士科，却怜秋色恼人多。\n双瞳眩转金钱富，无酒陶潜奈汝何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题广信王氏园菊本十种 其十 金佛莲","author":"郑真","text":"潮音洞里现慈颜，万朵金莲雪浪间。\n花色近人秋似海，恍然身到补陀山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题雪霁图","author":"郑真","text":"银界参差百万重，太虚清气压鸿蒙。\n旧来行处频观画，如在冰崖雪壑中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"唐十八学士登瀛洲图 其一","author":"郑真","text":"学海波环翠石重，长春花木炫丹红。\n神仙秖在人间世，何羡沧溟恍惚中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"唐十八学士登瀛洲图 其二","author":"郑真","text":"禁漏无声昼刻移，天家敕旨出廷墀。\n诸公且尽仙洲乐，未到分番上直时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题山水扇面","author":"郑真","text":"山翁唤我上饶来，坐对南屏迭迭开。\n一片白云长作伴，分明认得是蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题陈生子翼画扇面","author":"郑真","text":"悬崖晴瀑泻银河，杂沓松风送佩珂。\n世外红尘飞不到，山童却报晚凉多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"觅竹栽芭蕉简祥符古芳禅师 其一","author":"郑真","text":"石上来参玉版师，殷勤觅得凤凰枝。\n分明认得如来意，坐到林扃月上时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24958,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"觅竹栽芭蕉简祥符古芳禅师 其二","author":"郑真","text":"越客南来梦转添，移床听雨近虚檐。\n绿蕉分得祇园树，晓露承来似蜜甜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24959,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王绍泰计偕京师 其一","author":"郑真","text":"西江贡士上春闱，天上星光近璧奎。\n从此名题龙虎榜，殿头释褐赐金泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24960,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王绍泰计偕京师 其二","author":"郑真","text":"盛时多士蔚招徕，银钥声寒棘屋开。\n丹杏琼林春宴早，红旗先报捷书来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24961,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王绍泰计偕京师 其三","author":"郑真","text":"碧溪冰解水融融，满眼晴山紫翠浓。\n客邸要聆新进士，鸿书好寄白云重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24962,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题广信李通判梅竹画四轴 其一","author":"郑真","text":"山中消息问如何，昨夜前村雪更多。\n莫道此君坚节操，玉妃还得共婆娑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24963,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题广信李通判梅竹画四轴 其二","author":"郑真","text":"冰雪天寒不自禁，晚风吹动翠阴阴。\n溪光一片清如镜，照见佳人铁石心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24964,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题广信李通判梅竹画四轴 其三","author":"郑真","text":"帝子湘江翠袖寒，云深风雪佩珊珊。\n罗浮仙客频相遇，牢落冰姿不耐看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24965,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题广信李通判梅竹画四轴 其四","author":"郑真","text":"姑射神人杂佩瑶，月明深夜许相招。\n鹤声唤起瑶台梦，百尺琅玕雪未消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24966,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题红梅","author":"郑真","text":"花仙曾到玉皇家，有敕春香泛紫霞。\n薄醉着颜红有晕，日高含笑近窗纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24967,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花","author":"郑真","text":"调羹商鼎愧非才，孤负百花头上开。\n夜半西湖空有梦，月明谁见鹤飞来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24968,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题兰","author":"郑真","text":"国香散落翠巉岩，晔晔芳丛玉露寒。\n楚佩可怜零落尽，春风吹梦过湘南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24969,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题红梅 其一","author":"郑真","text":"岁寒曾到玉皇家，浅浅琼杯醉碧霞。\n睡起不知凡骨换，分明素质点丹砂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24970,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题红梅 其二","author":"郑真","text":"绰约山中万玉妃，冰天有梦到瑶池。\n调羹誓许供珍御，却笑春风上玉肌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24971,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同通判李德高相公雪中 其一","author":"郑真","text":"洒洒春风玉树枝，何人吟得灞桥诗。\n画堂卷起珠帘看，三白人间正及时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24972,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同通判李德高相公雪中 其二","author":"郑真","text":"琼葩玉蕊点疏枝，吟得刘叉五字诗。\n谩道阶前深似尺，程门独立有杨时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24973,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同通判李德高相公雪中 其三","author":"郑真","text":"冰帘高卷看琼枝，谁寄回文锦上诗。\n寝笑从容人未起，客中何似在家时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同通判李德高相公雪中 其四","author":"郑真","text":"轻花洒洒凤凰枝，锦绣联篇百韵诗。\n羔酒千金歌吹乐，山城正属太平时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同通判李德高相公雪中 其五","author":"郑真","text":"折得梅花第一枝，雪儿唱得雪中诗。\n扁舟夜半人归去，正是王猷访戴时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同通判李德高相公雪中 其六","author":"郑真","text":"缟袖娉婷舞柘枝，天花飞落锦笺诗。\n山川晃荡真如画，要觅当年李伯时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同通判李德高相公雪中 其七","author":"郑真","text":"隔屋女娘歌竹枝，凄凄秖似少年诗。\n浅斟低唱微微醉，如在绡金帐里时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同通判李德高相公雪中 其八","author":"郑真","text":"阿蛮折得素琼枝，舞向华筵索赠诗。\n散乱天花声扑簌，向来忆在碧窗时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24979,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同通判李德高相公雪中 其九","author":"郑真","text":"万树嵯峨重压枝，可怜冻吻不成诗。\n天光大窖炉无火，正是苏卿握节时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24980,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同通判李德高相公雪中 其十","author":"郑真","text":"击碎珊瑚五色枝，锦笺写就谪仙诗。\n公庭早起人初集，正似陶公布屑时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"人有为石梁谣者录成 其一","author":"郑真","text":"乔木重重惠子窑，濠梁水带九洪桥。\n淮西自古夸形胜，表里山河拱圣朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24982,"sha256":"ed4816f919f16