[{"title":"送邓汝高进士还朝 其一","author":"徐熥","text":"献岁赴王程，全家向北平。\n断冰淮口渡，残雪蓟门城。\n烟柳迷征盖，风花引使旌。\n长安春色好，莫起故园情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23114,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邓汝高进士还朝 其二","author":"徐熥","text":"柳色催离况，椒花恋别筵。\n梦繁人去后，春到客行先。\n挂席河通楚，驱车路向燕。\n相思明月夜，惆怅隔山川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23115,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游通谷洞","author":"徐熥","text":"小径斜通谷，跻攀及晚晴。\n草荒寻鸟道，磴险作蛇行。\n暮色千峰合，春流一镜平。\n石间旧题刻，半是紫苔生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23116,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登乌石山","author":"徐熥","text":"绝巘分青霭，高台接绛霄。\n钟声多近寺，墨迹半前朝。\n径小疑藏洞，山穷忽遇桥。\n凭栏时纵目，沧海望中遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23117,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同微师至面壁洞","author":"徐熥","text":"竹径云阴乱，松门夜色虚。\n佛多同客礼，洞半借僧居。\n幡动风来后，钟残月上初。\n何须别栖隐，此地即吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23118,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题惟扬弟法云寺书舍","author":"徐熥","text":"谁知菩萨界，亦有子云居。\n厨趁僧炊后，膏分佛照馀。\n窗窥施食鸟，笥窜蠹经鱼。\n方衲时相叩，秖应来借书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23119,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"绝粒僧","author":"徐熥","text":"苦行凡心绝，休粮道气清。\n斋惟供弟子，食不乞王城。\n已觉形骸幻，能令香味轻。\n云游经处处，不用载瓢行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23120,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送颜廷愉将军料兵海坛山","author":"徐熥","text":"少年初建节，走马向孤城。\n蜃气云中市，狼烟海上营。\n晓霜明雪戟，夜月捲霓旌。\n幕府防秋急，看君独请缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23121,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同微公元直兴公弟至鼓山","author":"徐熥","text":"看山俗虑清，况复与僧行。\n径密草交色，林回鸟换声。\n披云孤衲重，挂月一瓢轻。\n不用忧迷路，灯光见化城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23122,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鼓山寺","author":"徐熥","text":"空门有夙因，岁岁往来频。\n方丈墨犹湿，祇园花又新。\n佛应怜熟客，山但借閒人。\n不分居城市，红尘老此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23123,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灵源洞与微公赋","author":"徐熥","text":"洞藏青嶂里，路出白云层。\n苔色侵禅榻，松阴暗佛灯。\n树撑危石坠，藤束古崖崩。\n不用寻僧语，同游自有僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23124,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赵用拙招游白云洞迷路而返却寄","author":"徐熥","text":"古洞知何处，山僧路亦迷。\n行来千嶂外，犹隔数峰西。\n径险猿难度，林深鸟自啼。\n渔郎真梦境，浪说武陵溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23125,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜果慧禅师见访","author":"徐熥","text":"多年居古洞，偶尔到王城。\n老益禅心定，贫谙世谛轻。\n空犹嫌有相，火久断无明。\n再拜求真偈，流传度众生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23126,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠赵用拙居士","author":"徐熥","text":"留发不披缁，行藏众所疑。\n慧因闻道早，壮悔出家迟。\n果以今生满，僧应夙世为。\n悬知他日遇，改却旧须眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23127,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"问伯孺病","author":"徐熥","text":"时事已如此，看君转自愁。\n不堪燃桂苦，况抱采薪忧。\n药以何钱买，粮应几日休。\n妻儿皮骨在，相向泪交流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23128,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠张少府 其一","author":"徐熥","text":"恋越终辞楚，幽栖似鹿门。\n烟霞长作侣，车马不闻喧。\n世事惟高枕，生涯只灌园。\n自耽泉石趣，岂是学桃源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23129,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠张少府 其二","author":"徐熥","text":"黑发弃轩冕，归耕南亩田。\n不飞云外舄，时挂杖头钱。\n野性耽丘壑，幽居远市廛。\n中峰高隐处，长抱白云眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23130,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲午赴京留别社中诸子","author":"徐熥","text":"瓠落甘南郭，飘零又北征。\n愁心悲远道，短发恋微名。\n别苦嫌情重，时危幸橐轻。\n劳歌听已惯，任作断肠声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23131,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别陈惟秦","author":"徐熥","text":"劳歌君莫吟，吟即泪沾襟。\n若比前年别，此情应更深。\n梦能知道路，交只恋山林。\n何处还相忆，天涯一片心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23132,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"溪行即事寄汝翔平夫","author":"徐熥","text":"客路空回首，浮生未息机。\n愁多难得醉，梦短不成归。\n石势流边缺，滩声过后微。\n翻因旅泊处，转忆旧渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23133,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泊黯淡滩登观音寺","author":"徐熥","text":"古寺俯空滩，溪深客到难。\n浪疑南海涌，山作普陀看。\n幡影临流湿，钟声出谷寒。\n禅心如止水，元不碍风湍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23134,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金凤山逢许道人","author":"徐熥","text":"高人隐洞天，鸟道入云烟。\n且莫论真诀，大都无世缘。\n丹炉长自爇，火候岂轻传。\n别去不留意，相逢皆偶然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23135,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渔梁道中怀叶志卿","author":"徐熥","text":"当年联辔处，已是七周星。\n野店曾同宿，流泉忆共听。\n殊音来往客，愁思短长亭。\n不尽怀乡感，因君增涕零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23136,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七里滩夜泛","author":"徐熥","text":"严滩行未尽，雨气逼黄昏。\n峡束天疑小，溪深水不浑。\n榜歌何处客，灯影几家村。\n最是堪愁绝，三声半夜猿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23137,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桐庐晓发","author":"徐熥","text":"挂帆山县晓，云气满溪阴。\n虽有风尘役，能无丘壑心。\n人烟依水近，塔影坠江深。\n所叹垂纶者，高踪不可寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23138,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"紫阳洞","author":"徐熥","text":"石室奇如此，全无斧凿痕。\n虚岩悬作屋，曲窦巧成门。\n避日晴犹湿，屯云昼自昏。\n平生游历惯，到此亦惊魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23139,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三茅观寻许灵长不遇","author":"徐熥","text":"山色翠氤氲，松关闭白云。\n礼星孤磬发，受箓妙香焚。\n夜静天花落，秋高木叶闻。\n无由寻许掾，长揖问茅君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23140,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀黄道晦 其一","author":"徐熥","text":"各送皆先别，君留更一宵。\n江头两分手，相对各魂销。\n南望驿楼远，北看帆影遥。\n折来亭畔柳，此日定萧条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23141,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀黄道晦 其二","author":"徐熥","text":"长贫家累少，有道世缘轻。\n山许高人占，田归别主耕。\n老惟安落魄，隐不爱虚名。\n下榻怜吾弟，秋来几到城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23142,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚至毗陵","author":"徐熥","text":"榜人穷日力，向晚到荆溪。\n近驿舟航满，沿城灯火齐。\n角声悲断续，山色黯东西。\n客子愁无寐，昏雅莫乱啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23143,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"句曲道中望茅山","author":"徐熥","text":"停车句曲望，缥缈见仙家。\n旷野分青霭，遥天结紫霞。\n山秋生异草，溪午出胡麻。\n欲證延年诀，其如道路赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23144,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游牛首山弘觉寺","author":"徐熥","text":"前身疑老衲，所至爱禅林。\n肯惜跻攀力，偏宜清净心。\n山钟吴地秀，园布汉时金。\n日午僧寮寂，岩扉闭塔阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23145,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"牛首祖堂寻雪浪禅师不遇","author":"徐熥","text":"云气掩禅栖，山空鸟自啼。\n塔阴依日转，铃语坠风低。\n白社虚牛首，青山费马蹄。\n无由问真偈，归路夕阳西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23146,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鸡鸣寺赠印空上人","author":"徐熥","text":"不用觅三车，心能转法华。\n问年忘岁月，留客借云霞。\n乞食朝行脚，焚香夜结跏。\n志公金骨在，长日礼干花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23147,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜林天懋至得家书","author":"徐熥","text":"故人传信至，喜极却忘餐。\n虽有平安字，未开犹胆寒。\n算程何日寄，秉烛几回看。\n两月思乡泪，今宵应暂乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23148,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卢子明张子明何性中胡彭举林叔度小集客舍","author":"徐熥","text":"客中方落莫，诸子偶来过。\n有相皆丘壑，无言非薜萝。\n红尘穷巷少，青眼异乡多。\n总是飘蓬者，为欢能几何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23149,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瓦棺寺赠全上人","author":"徐熥","text":"禅房云气深，一榻傍蕉阴。\n不种生天果，常怀出世心。\n鹫峰脩白业，象教礼黄金。\n何以精名理，先师有道林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23150,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同陆纂父郭圣仆雨夜集曹重甫客舍得凉字","author":"徐熥","text":"客居非蒋径，亦自过求羊。\n绿酒人来贳，黄花节后香。\n敝裘霜气肃，残烛雨声凉。\n漏尽欲为别，秋宵苦不长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23151,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送何性中还回稽","author":"徐熥","text":"之子竟落魄，故人空断魂。\n烟霞归旧隐，风雨出关门。\n红叶足秋色，白衣多泪痕。\n看君年尚少，莫即恋丘园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23152,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王献子山人客粤西","author":"徐熥","text":"君行当象郡，投宿尽蛮家。\n椰暗黎村叶，梅寒庾岭花。\n神符宵厌蛊，人面昼防蛇。\n若到南中日，先寻勾漏砂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23153,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林吾宗南还时余将入燕","author":"徐熥","text":"相逢虽暂喜，相别倍含情。\n渡水雁孤影，出关鸡一声。\n愁从归路减，寒近故乡轻。\n所叹飘零者，风霜向北平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23154,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林叔度之庐江寻刘使君","author":"徐熥","text":"怜君方倦游，岁晚复依刘。\n衰草逢霜死，寒涛逐雪流。\n淮南丛桂老，江北荻花秋。\n渡口一相送，目穷天际头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23155,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题静海寺庆良上人房","author":"徐熥","text":"入寺已高舂，禅关暮霭封。\n潮喧临水梵，云引过江钟。\n驯象诸天教，卢龙近郭峰。\n几年湖海别，此地又相逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23156,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灵谷寺","author":"徐熥","text":"一径万松通，钟山俯梵宫。\n谷声虚应掌，塔影峻凌空。\n不坏金身古，无梁宝殿雄。\n未忘生灭相，长此泣遗弓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23157,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏雨中新草","author":"徐熥","text":"烧痕才转绿，含雨未萋萋。\n且缓佳人斗，方闻玉勒嘶。\n苔深看莫辨，柳亚望初齐。\n为语寻春者，无令踏作泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23158,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"不寐感怀示元直","author":"徐熥","text":"孤馆听寒漏，灯残夜未央。\n雁声悲带雨，蛩语急含霜。\n旅梦醒难续，乡心醉暂忘。\n念君初作客，不敢说凄凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23159,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠魏考叔","author":"徐熥","text":"所居虽近市，苔锁荜门幽。\n巾舄遵王制，图书应客求。\n挥毫无俗韵，下榻有名流。\n满壁沧洲在，依稀顾虎头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23160,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别金陵","author":"徐熥","text":"人境元如梦，兹游真惘然。\n一帆扬子月，双屐白门烟。\n遇寺多留偈，逢僧尽问禅。\n独馀千佛岭，待我再来缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23161,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀王粹夫","author":"徐熥","text":"我游当蓟北，君隐在墙东。\n两地魂俱断，中宵梦不同。\n烛销山店雨，笳散戍楼风。\n雪后无南雁，乡书何处通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23162,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同温允文史声伯集张稚通清远居分得留字","author":"徐熥","text":"此地本清远，主人情更幽。\n游多乘兴至，客不问名留。\n坐卧半临水，往来都泛舟。\n醉馀溪上别，月色满中流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23163,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天圣寺","author":"徐熥","text":"高阁对诸峰，禅关入乱松。\n断碑留赑屃，古殿错蛟龙。\n尘静难侵佛，林疏不碍钟。\n潇湘图满壁，彤管有遗踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23164,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"碧浪湖泛月同在杭","author":"徐熥","text":"扁舟过碧浪，孤月出林端。\n兔影摇波碎，婵娟落镜寒。\n湖光澄似练，山色秀堪餐。\n别后几圆缺，今宵才共看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23165,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题顾学宪先生闻禽阁","author":"徐熥","text":"高阁傍林阿，林深众鸟过。\n飞当残照急，噪向晚晴多。\n振翼同呼侣，归巢各认柯。\n翟公门似水，日日可张罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23166,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈道源参军","author":"徐熥","text":"冷曹堪傲性，大雅见遗音。\n衙只听莺放，山多信马寻。\n一官同鲍照，五字比陈琳。\n俸薄难供客，时捐卖赋金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23167,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓至甘露寺因憩观音洞","author":"徐熥","text":"乘晓到香台，钟残僧梦回。\n岩阿精舍隐，石窦普门开。\n初日跃林出，罡风跨浪来。\n披榛寻旧迹，一半委苍苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23168,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲午汶上除夕","author":"徐熥","text":"旅馆逢除夕，空怀故国情。\n荒村三户寂，土屋一灯明。\n臈逐鸡声去，春随马足生。\n客中非守岁，自是梦难成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23169,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀张道辅","author":"徐熥","text":"婚嫁中年毕，馀生老一区。\n市声穷巷寂，山色小楼孤。\n林密身堪隐，田荒口仅糊。\n诗僧同酒伴，日日往来无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23170,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得逍遥游送邬子远山人","author":"徐熥","text":"逍遥非避世，只是爱清閒。\n汎月渡千涧，随云过几山。\n游同僧共往，倦与鸟俱还。\n踪迹多湖海，故园长闭关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23171,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题许灵长快雪亭","author":"徐熥","text":"亭倚吴山麓，春晴雪未乾。\n色分江影白，光入石门寒。\n洞古藏犹湿，墙阴销欲残。\n应怜高卧者，日日映书看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23172,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题吴象文抱膝轩","author":"徐熥","text":"越绝风流客，栖迟一亩宫。\n闭门人迹少，趺坐世缘空。\n帘向雪中捲，径从花里通。\n主人长抱膝，或恐是隆中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23173,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张子环下第枉道之楚寻丁亨文法曹","author":"徐熥","text":"天涯同失路，君岂不怀归。\n客久行囊罄，家贫生计微。\n同来知己散，便道故人稀。\n独有荆南吏，或能怜布衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23174,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮出茌平宿二十里村店","author":"徐熥","text":"征车贪远宿，宿处更荒凉。\n出郭才数里，几家成一乡。\n灯燃绵炬暗，茶煮柳条香。\n不待晨炊去，主人无晓粮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23175,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠瑕丘灌园郭叟","author":"徐熥","text":"胜地近洙水，主人同汉阴。\n未忘为圃意，偏称耦耕心。\n草色怜颜巷，柏枝分孔林。\n下车聊共语，莫作凤衰吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23176,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"滋阳道中逢金陵秀峰和尚因讯雪浪耶溪秋园诸上人","author":"徐熥","text":"如何当此地，亦得见名僧。\n托尽他乡钵，传来几代灯。\n烟霞生有果，云水迹无凭。\n问遍南朝寺，因师住秣陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23177,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登云龙山放鹤亭","author":"徐熥","text":"叠嶂隐香台，门当楚水开。\n河流幡影去，云引磬声来。\n寺古龙犹伏，亭空鹤不回。\n因寻碑上字，剔尽雨中苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23178,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中书怀 其一","author":"徐熥","text":"一别变春秋，相随半是愁。\n思乡餐䪺减，感旧泪空流。\n金尽羞开箧，途遥厌换舟。\n非无山水兴，客久畏淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23179,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中书怀 其二","author":"徐熥","text":"岂是依人拙，此行谁可依。\n途穷胜事少，身贱势交稀。\n客路儒无术，关门吏有威。\n时时戒童仆，莫比昼游归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23180,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将别幼孺","author":"徐熥","text":"离人元作恶，况复是心知。\n预洒临岐泪，各抄同赋诗。\n分襟愁路促，恋别愿舟迟。\n童仆追随久，犹能相向悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23181,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松陵舟中送幼孺入苕川兼柬在杭使君及苕中诸旧游","author":"徐熥","text":"怀土情虽切，他乡且暂留。\n去寻苕水吏，独作太湖游。\n顾影同看烛，含啼各买舟。\n我来惭父老，不敢再依刘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23182,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"溪夜时与惟秦兴公游武夷","author":"徐熥","text":"往日游都倦，兹行心独閒。\n片帆投月宿，一笠戴云还。\n夜色沙边水，秋光烟外山。\n旅怀长似此，那解鬓毛斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23183,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]