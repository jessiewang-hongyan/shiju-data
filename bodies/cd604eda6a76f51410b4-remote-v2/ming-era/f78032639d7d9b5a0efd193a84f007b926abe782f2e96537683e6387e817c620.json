[{"title":"挽霍元方处士七首 其一","author":"宋讷","text":"苍天何意坠斯文，来向淇东哭隐君。\n丽泽友朋谁讲习，鹿门妻子自耕耘。\n梦中彩笔投寒月，屋外青山惨白云。\n白发旧交重怅望，荒原衰草记新坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽霍元方处士七首 其二","author":"宋讷","text":"玉芝一夕悴奇芬，悲动儒林远近闻。\n委畚老妻收旧褐，过庭嗣子集遗文。\n东崖花木诗无句，北海樽罍酒不醺。\n楚些招魂歌未彻，渡头惊起白鸥群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽霍元方处士七首 其三","author":"宋讷","text":"伾山英气降鸿儒，一病光阴隙过驹。\n医俗主人辞劲竹，吊亡高士致生刍。\n牙签架上遗经史，宝墨床头卷画图。\n莫怪挽诗多惨切，白杨风雨夜台孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽霍元方处士七首 其四","author":"宋讷","text":"细数交游四十春，期君寿域作天民。\n白云不护窗前石，黄壤先埋席上珍。\n五尺丹旌书处士，一编藻句记诗人。\n伤心未及灵輀送，重对青山泪湿巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽霍元方处士七首 其五","author":"宋讷","text":"诗酒方将乐莫年，谁知含笑掩重泉。\n异端惑世遗言拒，正道忘身爱子传。\n砌下翠干新剥竹，池中香断旧栽莲。\n平生清致无由觌，漫看东崖起断烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽霍元方处士七首 其六","author":"宋讷","text":"浮生六十四年春，酒圣诗豪到处闻。\n千里腾骧空冀北，一家清白傍淇滨。\n箪瓢巷有高轩客，诗礼门无杂吊宾。\n想见九原清节在，再歌哀挽荐溪蘋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽霍元方处士七首 其七","author":"宋讷","text":"弱冠登临赋远游，壮年谈笑揖公侯。\n水边花竹黄茅舍，天上文章白玉楼。\n三载书帷留董子，一朝布被盖黔娄。\n嗟君去后淇河上，更为谁乘雪夜舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浚县知县项如英筑野遣人远馈酒殽仍寄诗相问随用韵以答其盛意为后日之会一笑 其一","author":"宋讷","text":"天台高士项斯贤，诏牧黎阳治化宣。\n事业远符殷傅说，文章曾赋汉甘泉。\n双罂酒美劳人送，一纸诗新染翰传。\n自愧非韩亦非孟，不知君许作忘年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浚县知县项如英筑野遣人远馈酒殽仍寄诗相问随用韵以答其盛意为后日之会一笑 其二","author":"宋讷","text":"天姥精英产一贤，来从筑野事承宣。\n臣心东注朝宗水，士节清悬瀑布泉。\n桃李河阳潘岳种，弦歌鲁邑子游传。\n政随春雨东皋足，伫听歌谣大有年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浚县知县项如英筑野遣人远馈酒殽仍寄诗相问随用韵以答其盛意为后日之会一笑 其三","author":"宋讷","text":"治平天子久招贤，卓鲁循良陋董宣。\n奕世英姿温若玉，挥毫吟思涌如泉。\n琴堂政暇留宾话，泮水功成勒石传。\n祥凤景星争快睹，识君从记甲寅年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浚县知县项如英筑野遣人远馈酒殽仍寄诗相问随用韵以答其盛意为后日之会一笑","author":"宋讷","text":"暮境无能愧昔贤，诗葩词藻强敷宣。\n不随隐士巢丘壑，且伴樵人乐石泉。\n酒向落花茵上饮，道从汗竹简中传。\n山城后日寻君处，残恨光阴已来年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再过故人霍元方故居因作诗以寄嗣子怡伯怡仲","author":"宋讷","text":"重过东崖处士居，门前犹有故人车。\n九原风雨三生梦，一壑烟霞万卷书。\n华表何年重见鹤，淇滨今日独观鱼。\n知君不减遨游兴，万里骑鲸入太虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再过故人霍元方故居因作诗以寄嗣子怡伯怡仲","author":"宋讷","text":"欲登医俗旧茅亭，主去亭空德自馨。\n载酒无人重问字，闻诗有子自趋庭。\n程门谁立诸生雪，淇水先沈处士星。\n缥缈吟魂何处在，竹梢空见岁寒青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉中寄霍东崖元方","author":"宋讷","text":"昔读昌黎醉留东野诗，深羡昌黎重东野。\n我与东崖生并里，踪迹参差不相舍。\n东崖清致多，幽居足图写。\n不上青云梯，笑傲王侯者。\n自愧堕尘网，身轻薄名惹。\n再拜问东崖，肯许作邻也。\n东崖笑不应，令我如喑哑。\n近闻赋归田，便欲往结鸡豚社。\n东崖起屋淇水滨，我亦结茅汉堤下。\n门前柳拂头，篱边菊盈把。\n香秫故园种，新鱼小船打。\n访道讲参同，寻僧问兰若。\n有诗次清韵，有酒倾老瓦。\n留客出笑谈，课儿诵风雅。\n太行烟翠入登览，终日风神两潇洒。\n又恐弃我还城郭，白雪阳春和弥寡。\n想见亭下此君为我苦留之，桑榆意气同倾泻。\n庶几古人心，相得真匪假。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元方见和复次韵以寄之","author":"宋讷","text":"唐方干，宋魏野。\n诗名遗在鉴湖甘棠上，高隐流芳合中舍。\n东崖处士居淇东，诗成好事争传写。\n英风卓行无古今，举头仰羡皆作者。\n炼句风月嘲，西隐烟霞惹。\n白头始赋归来辞，不知是也还非也。\n是非几欲问青山，鼓掌大笑成痴哑。\n愿结渔樵侣，更入耆英社。\n茅屋底，衡门下。\n秋郊看禾穗，春畦供菜把。\n栽松放云宿，种竹听雨打。\n十首新诗和少陵，数曲瑶琴知贺若。\n香笺笔扫凤楼锦，古砚墨磨铜雀瓦。\n忘形懒冠佩，陶情咏骚雅。\n杖藜散步瓠子堤，风露从教来沐洒。\n斟花酌柳会东崖，俗驾远回逋客寡。\n后日寻盟医俗亭下去，翠琅玕动清风泻。\n对话闻秋声，此乐谁能假。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太行险一首送李尚友秦士能二秀才还陵川县学兼寄教谕马训导路世安刘九成三契旧","author":"宋讷","text":"太行之势高倚天而险拔，地鸿蒙磅礴不可以涯际兮，中原万古之名山。\n山中之路不知何年始开辟，羊肠萦纡孰得以形状，险巇可畏惊尘寰。\n下瞰涧壑微茫之天井，上拥峰峦缥缈之云鬟。\n商来贾往迤逦而不绝，梯危磴绝劳跻攀。\n嗟予乘蹇十步五步一下，时见草腥而木恶，土老而石顽。\n搴衣扶杖以登顿，远望俯视黄河之在目，微如潦水澄一湾。\n山家诛茅斩木作旅馆，小如蜗舍蔽风雨，衣食之资何其难。\n一尺树根不出土，凿臼舂米于道左兮，行人为叹生涯悭。\n流民负戴襁褓者，吾亦悯其妇寡而夫鳏。\n青林仰不见白日，中无人兮不可以久留，三日之路万曲而千弯。\n惟有珍禽奇鸟得所乐，惺忪巧语和绵蛮。\n石城之畔几蹭蹬，石苔树藓苍斓斑。\n黄崖之巅雨中过，行不可行，立不可立兮，使人睥睨凋朱颜。\n欲下未下更回首，不数马陵之道居庸关。\n卓卓仙李英华秦仲裔，梁栋之梓非茅菅。\n往返相送五百里，我独东去君西还。\n翩翩文采不忍别，双鹄飞入青云间。\n传道授业有师在，愿加雪窗萤几之功兮，寸阴莫使成虚闲。\n后日南宫战艺想得隽，玉笋并列枫宸班。\n送君有诗无好句，芜词正望重加删。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东崖行一首为处士霍元方作","author":"宋讷","text":"东崖之秀几何年兮，草木几蕃殖，雄踞太行之麓黎阳野。\n适有幽人处其下，自将埋光铲采兮，半世行藏知用舍。\n远挹大伾之山兮，岫云岩霭入冥搜，近临淇水之渡兮，岸花汀草供模写。\n幽人崖下起茅亭，种竹尽似筼筜者。\n窗户晴来燕子飞，帘栊春去杨花惹。\n规模别是安乐窝，短歌长啸栖迟也。\n宾朋满座尽风流，叱去侯痴与萧哑。\n良时杖屦入秋郊，丰年鼓笛随春社。\n间有赏音人，径造亭竹下。\n拄笏山共看，开樽酒同把。\n我亦尝记骑马来，几回半醉柴门打。\n望中见胜槩，静里得兰若。\n崖畔白云生鹤氅，屋头红叶封鸳瓦。\n珍重半生交，不是一日雅。\n愧非王粲劳君倒屣迎，风吹竹露尘容洒。\n如今重和东崖诗，气乏凌云吐霓兮，君应一笑珉多而玉寡。\n安得鹭鸶之杓鹦鹉杯，红醅绿蚁医俗亭中泻。\n诗成却怪我效颦，倾国之颜岂容粉黛假。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再用前韵寄东崖霍元方","author":"宋讷","text":"九皋鸣鹤声闻野，翠弓有矢不虚舍。\n先生抱负两相似，莫笑狂歌为君写。\n昔年医俗绕亭多种竹，十载干戈少存者。\n故基神护尚遗竹，兔葵燕麦相萦惹。\n先生今日重构亭，移花养竹归来也。\n俊游清赏尽佳辰，何有天聋并地哑。\n鸥鹭群，农桑社。\n淇水渡上东崖下。\n阶前笋箨添数竿，阑外柳丝生一把。\n凤笺粉褪笔锋粘，燕巢泥落琴弦打。\n醒梦茶香煮石乳，养生汤好倾般若。\n雪三尺，霜万瓦。\n先生此时都不知，剧饮豪吟集文雅。\n胸臆不拘拘，情思常洒洒。\n愧我结金兰，膺门得者寡。\n凤雏昨日送佳什，词源倒峡琼瑰泻。\n君不闻戴昌窃听潘京谈，惟才不可假。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王克让归湖南侍亲并柬李中卿县丞","author":"贝琼","text":"五两风生楚客归，梦魂先已到庭闱。\n九疑舜冢苍梧野，三国周郎赤壁矶。\n天地茫茫人自老，古今历历鸟空飞。\n若逢李白烦相问，别后平安一字稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题庾岭图 其二","author":"郑真","text":"两崖天倚画图开，万里风高猿啸哀。\n闻道万年崔相国，白头也复赐归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题苏武握节图 其一","author":"郑真","text":"啮雪餐毡使节孤，老来不肯困穷途。\n如何娶妇为姬妾，教得生儿也姓苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题苏武握节图 其二","author":"郑真","text":"草冻沙干又乳羝，天寒大窖雪成围。\n节毛落尽空头白，忍死边廷未得归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题蔡琰归汉图 其一","author":"郑真","text":"玉颜没入左贤王，万里天高恨雪霜。\n名父不应儿失节，九泉羞杀蔡中郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题蔡琰归汉图 其二","author":"郑真","text":"呜咽胡笳曲未终，秋风马上路匆匆。\n梦回暗忆恩情重，毡帐寒深雪满空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题蔡琰归汉图 其三","author":"郑真","text":"銮车处处看春花，又过陈留董祀家。\n不是戎王荒塞夜，夜深何事咽悲笳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题蔡琰归汉图 其四","author":"郑真","text":"历历风沙貌得真，两雏牵挽意逡巡。\n不知野店黄昏后，谁画当年断臂人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题秋江举网图","author":"郑真","text":"西风波浪刮鱼腥，何处幽人独下罾。\n百岁想甘清节守，桐江不必问严陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题季璋梅花","author":"郑真","text":"三年为客海东涯，万里罗浮一梦赊。\n霜月夜寒天地合，开门曾忆看梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答任彦舜送香橙 其一","author":"郑真","text":"皇都传说上元春，罗帕包封赐近臣。\n海角未沾天宠洽，却怜霜颗特分珍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答任彦舜送香橙 其二","author":"郑真","text":"红盘擎到碧窗纱，三寸黄柑擘永嘉。\n亲老正思甜舌本，蜡封谁为寄吾家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题渔樵问答图 其一","author":"郑真","text":"百年生计近如何，霜雪萧萧鬓未皤。\n我志在山君在水，负薪何似得鱼多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题渔樵问答图 其二","author":"郑真","text":"山中应许暂逍遥，滚滚尘埃远市朝。\n见说朝廷正招隐，吾侬未必老渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢丁相公惠牡丹 其一","author":"郑真","text":"青春正绽洛阳花，千里东风一梦赊。\n多谢公侯珍重意，甔瓶分到碧窗纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢丁相公惠牡丹 其二","author":"郑真","text":"几年作客向蓬莱，一捻胭脂笑口开。\n想见故园春满眼，淡妆浓抹待归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画竹","author":"郑真","text":"轩居曾种碧琅玕，满目秋声白昼寒。\n旧日林泉今总废，画图空向醉中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长江落雁图","author":"郑真","text":"联翩羽翼映秋波，芦荻飘萧已厌多。\n长笛一声归棹晚，江天目断奈渠何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题鲛川赠别图 其一","author":"郑真","text":"鲛门海阔蜃楼低，仙子乘空一鹤飞。\n想见故园春正好，归来乔梓映清辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题鲛川赠别图 其二","author":"郑真","text":"彭泽归来尚有田，莺花三月醉琼筵。\n故人矫首沧江上，万里东风浪拍天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题马图","author":"郑真","text":"天厩骅骝汗血身，沙堤滚滚不惊尘。\n春深谁奉明廷对，许赐当头第一人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄汴韩豫斋 其一","author":"郑真","text":"往岁曾看艮岳图，还夸形胜帝王都。\n风流有客今三载，千里相望夜月孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄汴韩豫斋 其二","author":"郑真","text":"秋风悄悄动荒埃，篱下黄花菊又开。\n试问城头双过雁，中原何日定归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"腊月夜读袁文清公集口占二绝 其一","author":"郑真","text":"万年倾泻似悬河，传出人间不厌多。\n奎阁春明天语笑，词臣喜得似东坡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"腊月夜读袁文清公集口占二绝 其二","author":"郑真","text":"夜月分明在树杪，西川故老许神交。\n文章可是传衣钵，风雪寒窗记手抄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题瘦马图","author":"郑真","text":"万里沙场踏雪还，凌然病骨箭痕斑。\n内官有意勤刍牧，置在春风十二闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题孔雀图","author":"郑真","text":"石根苍竹净晖晖，暖翠翻花遍羽衣。\n见说上林春似海，乘风好与凤凰飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蒋仲原官府谷 其一","author":"郑真","text":"长城万里控延安，饮马泉腥夜月寒。\n山县休衙人事少，旧时经略许谁看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蒋仲原官府谷 其二","author":"郑真","text":"云屯万灶玉骢嘶，斜日青山听鼓鼙。\n落木秋高边地远，却怜枳棘凤鸾栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王以宁官神木 其一","author":"郑真","text":"同乡相遇说瀛洲，海阔天高白雁秋。\n老我不禁霜雪苦，俸余应为买貂裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王以宁官神木 其二","author":"郑真","text":"霜风吹晓过潼关，万迭青青塞上山。\n淮海有人西望远，故园时许附书还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24847,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得家书忆儿复升","author":"郑真","text":"小儿遗毒痛难胜，苦道爹爹唤不应。\n我实怜渠那得去，淮山深夜对孤灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24848,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题水仙","author":"郑真","text":"湘江仙子佩珊珊，罗袜凌波翠袖寒。\n目断楚云归未得，岁阑冰雪两相看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24849,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题菜图","author":"郑真","text":"绿畦雨过润如酥，瓮有新齑市有酤。\n三月已应忘肉味，先生近欲传冰壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24850,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七月望宿府学口占一绝呈梁先生伯益是夜月既蚀濠梁卫随班行礼","author":"郑真","text":"庭阶数问夜如何，谁继卢仝月蚀歌。\n尚喜吾侪风致别，当筵呼酒问嫦娥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24851,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题瀛洲夜宴图","author":"郑真","text":"天风杂沓送鸣珂，樽俎纷纭乐事多。\n明日有人陈奏疏，当筵数问夜如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24852,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题钱舜举山水卷 其一","author":"郑真","text":"海国青山旧隐居，望乡千里客心孤。\n西风落照频看画，彷佛楼船过太湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24853,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题钱舜举山水卷 其二","author":"郑真","text":"山外有山深复深，苍松红叶暮云阴。\n繁华滚滚尘迷眼，不负林泉百岁心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24854,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题韩允传所藏钱舜举山居图 其一","author":"郑真","text":"烟雨春深拥翠螺，山人独赋考盘阿。\n柴门有客频相问，泉石生涯奈汝何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24855,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题韩允传所藏钱舜举山居图 其二","author":"郑真","text":"翩翩鞍马过桥西，荒崦人家竹树低。\n见说草堂春似海，杜陵不数浣花溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24856,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题韩允传所藏钱舜举山居图 其三","author":"郑真","text":"竹窗松阁翠重重，点染应归造化功。\n水镜涵空秋一色，置身如在广寒宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24857,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题韩允传所藏钱舜举山居图 其四","author":"郑真","text":"飘然湖海逐浮沤，风雨淮山两度秋。\n野色微茫舟似叶，令人归兴眇瀛洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24858,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题韩允传所藏钱舜举山居图 其五","author":"郑真","text":"白云相望海天遥，桂树山中不受招。\n故国百年遗老尽，画图披玩似琼瑶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24859,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题秋江送别图 其一","author":"郑真","text":"忆上西江贡士船，故人把酒意茫然。\n今年却送南归客，红树秋山怅远天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24860,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题秋江送别图 其二","author":"郑真","text":"烟雨秋深紫翠浓，仙人楼阁暮重重。\n故园松菊西风外，笑指天台第一峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24861,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋江独钓图 其一","author":"郑真","text":"轻舟摇漾钓丝风，野水如天一镜空。\n盛世明廷正招隐，渭川当复梦非熊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24862,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]