[{"title":"草堂元夕同华父观灯闻长孺时客都下","author":"欧大任","text":"火树千枝并，西堂夜不寒。\n客因同舍至，灯爱故园看。\n旧赏偏能续，深杯半欲乾。\n十年飞鞚地，犹自说长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6444,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小楼初成陆华甫同登有作","author":"欧大任","text":"海上楼成倚啸台，风流河朔几人来。\n稍呼江鹳偏能下，何处秋涛不壮哉。\n病起五湖行欲乞，家贫三径待谁开。\n君看天地容高枕，岂向烟霞负酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6445,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄黎维敬","author":"欧大任","text":"秋色笼葱玉树青，忆君委佩傍尧蓂。\n三朝扈阁仍紬史，五世名家只授经。\n勾漏丹砂吾自给，罗浮朱凤几时听。\n深山岂似东方朔，从此金门识岁星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6446,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄吴明卿","author":"欧大任","text":"黔中万里忆君劳，我向罗浮药市逃。\n归兴已同鸾啸远，诗名敢并雁行高。\n山间白帻空皮骨，海内青云各羽毛。\n才子汉廷徵尽入，可能一字寄蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6447,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送梁思立参藩贵州","author":"欧大任","text":"七闽法吏意如何，西去还鸣白玉珂。\n三楚风烟连僰道，五溪鱼鸟下牂牁。\n关通绝徼巴人少，日近长安汉使多。\n岳牧只今开府地，玺书行且慰蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6448,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送梁生侍其尊人少参公赴贵州","author":"欧大任","text":"敬客知公子，承家一俊人。\n郢歌飞白雪，越锷照青春。\n下马谈经地，听鸡问寝晨。\n荆梁游远徼，归看锦囊新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6449,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕沈纯甫邀集禺山园同陆华父黎惟仁黄公补公绍分得台字","author":"欧大任","text":"池阁初逢此夕杯，使君天上赐金回。\n珠随明月三更出，槎似银河万里来。\n砧杵乡心频作赋，河山秋色一登台。\n尊前共有沉酣兴，莫遣城头画角催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6450,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潘子朋佘季美雨夜见过时华父还洲上","author":"欧大任","text":"江雨篱门暗，扁舟二妙过。\n通家堪孔李，和者到羊何。\n茅屋秋声早，松醪夜语多。\n客居同甫里，犹得慰蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6451,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈道囊赴阅","author":"欧大任","text":"长安君到日，才子得陈琳。\n连璧惭同舍，双钩托片心。\n侠游燕客贵，经术汉儒深。\n为问金门下，何人解陆沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6452,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答黄公绍","author":"欧大任","text":"千里风尘澒洞间，故园秋共一尊閒。\n帆前沧海卢敖路，杖底朱明葛令山。\n越骑兵戈闻息战，汉家金铁许通关。\n知君不上干时策，落日渔樵数往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6453,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日同陆华父黄元光泛海登佛教台","author":"欧大任","text":"涛上西风起片帆，青山携手上巉岩。\n双江秀色看俱发，十载清觞得共衔。\n远浦不禁回雁鹜，高台犹为护松杉。\n求羊若许能相待，三径归来荷短镵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6454,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郢中三咏为曾中丞赋 其一 读书楼","author":"欧大任","text":"秦中还使节，汉上卧文园。\n散帙便欹枕，看山足杜门。\n书藏京岭近，剑倚石城尊。\n知有南熏奏，长歌圣主恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6455,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郢中三咏为曾中丞赋 其二 西清圃","author":"欧大任","text":"拂衣无不可，学圃在江乡。\n僮理栽花径，人寻载酒堂。\n歌能飞白雪，笛自和沧浪。\n蚤遂冥鸿志，非耽野趣长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6456,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郢中三咏为曾中丞赋 其三 锦标轩","author":"欧大任","text":"城上霞成锦，开轩向郢都。\n一毛标凤穴，千里识龙驹。\n寒并金茎直，光侵玉树孤。\n韦贤推相业，曾是汉名儒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6457,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日同陆华父张仲实蒋子瑞黄元先龟山游宴得花字","author":"欧大任","text":"江乡秋色在黄花，宾客来寻锦水涯。\n风起平芜吹鹳鹤，山寒丛薄散麇麚。\n林光稍入三珠树，酒气犹蒸五色霞。\n谁遣白衣能就我，紫桑荒径是吾家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6458,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重阳后一日同陆张蒋三子集黄元光宅","author":"欧大任","text":"劳君招隐意，念我倦游人。\n不恨交为晚，空知醉是真。\n宅边环细菊，林外带荒榛。\n莫问江州酒，时来漉葛巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6459,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陪陆华父诸君集舍弟经季海霞阁池上","author":"欧大任","text":"白社能频访，乌衣亦可游。\n花含三径色，木落一庭秋。\n海鹤寒相傍，山池澹不流。\n持觞遥问月，犹自恋沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6460,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华父元光诸子过舍弟明叔酒禅阁同集","author":"欧大任","text":"好客田家少，清斋秋事閒。\n益惟三友者，游岂五侯间。\n玩世非关酒，逃禅不在山。\n诸生依绣佛，长笑虎溪还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6461,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十四夜同陆华父登方清臣问月台","author":"欧大任","text":"万户正西风，登台得谢公。\n清光摇几席，寒影入帘栊。\n笛起沧波外，觞飞白露中。\n还同吴苑客，今夕赋江枫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6462,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题小竹林图赠黄元光","author":"欧大任","text":"覃怀西望竹为林，箕踞谁知托隐心。\n我忆酒炉曾醉处，河山宁隔万重深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6463,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"景云楼为元光赋","author":"欧大任","text":"万峰西走白云平，二仲来时小径成。\n登望更谁知此意，楼前何限太行情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6464,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杪秋同陆华父登青罗山顶望罗浮","author":"欧大任","text":"嶂前松栝九秋残，紫逻东回路几盘。\n秦戍风烟馀燧火，粤门天地一泥丸。\n铁桥云落银涛涌，朱鸟星高玉舄寒。\n为报安期今可待，去从神武挂吾冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6465,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题仙鹿图","author":"欧大任","text":"十年夹毂路缤纷，今去还山卧白云。\n五老峰头飞瀑下，不知何处遇匡君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6466,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别沈纯甫陈宗谟","author":"欧大任","text":"朔吹津亭澒洞间，海天寒色照刀环。\n谁令雁字催征骑，颇为梅花恋故山。\n玉舄共占仙令起，金门遥待侍臣还。\n他时把袂知何处，应笑冯唐鬓共班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6467,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题马醉狂梅雪图赠潘婿幼恭","author":"欧大任","text":"梅花枝上鹊寒栖，雪涨江天月满溪。\n词客挥毫何处醉，玉壶春酒秣陵西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6468,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过潘子朋栎园 其一","author":"欧大任","text":"大栎萧森江上村，杖藜寻尔辟疆园。\n瓜山文藻风流在，金马何论更避諠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6469,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过潘子朋栎园 其二","author":"欧大任","text":"激湍流水绕房栊，古木长含万里风。\n问字曾称老宾客，浊醪今日忆杨雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6470,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曾中丞平都蛮凯歌八首 其一","author":"欧大任","text":"釜钺西征都掌来，峭天孤壁倚崔嵬。\n铭勋已勒平蛮日，万岁君王万历开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6471,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曾中丞平都蛮凯歌八首 其二","author":"欧大任","text":"绳桥堑垒各县军，父老先传论蜀文。\n夺取淩霄挥毒雾，冲梯飞磴一时焚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6472,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曾中丞平都蛮凯歌八首 其三","author":"欧大任","text":"岪郁云边铁是城，九丝摧破洞巢平。\n凤头山接鸡冠岭，建武新屯十万兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6473,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曾中丞平都蛮凯歌八首 其四","author":"欧大任","text":"青羌遗种号云郎，山鬼呼群满大荒。\n玄甲金戈霄汉下，西南天地扫欃枪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6474,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曾中丞平都蛮凯歌八首 其五","author":"欧大任","text":"岩箐归民岁可租，荆榛剪作绣氍毹。\n将军露布飞传捷，天子明堂坐受俘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6475,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曾中丞平都蛮凯歌八首 其六","author":"欧大任","text":"蚕丛为族竹为王，越巂犍为达夜郎。\n今日櫜弓亲享贽，武侯铜鼓汉金铛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6476,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曾中丞平都蛮凯歌八首 其七","author":"欧大任","text":"赫赫中丞是世臣，封君任子诰仍新。\n楚材原自兴都起，画作麒麟第一人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6477,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曾中丞平都蛮凯歌八首 其八","author":"欧大任","text":"辕门铙吹拥雕戈，大夏西收笮马多。\n汉殿侍臣欢上寿，白狼槃木尽成歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6478,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"徐子与闽中书至时余在青萝山中","author":"欧大任","text":"昆明万里久无书，尺素东来十月馀。\n玉笛遥传沧海曲，綵虹新傍武夷车。\n弹冠豸映双蓬鬓，伏枕乌啼一草庐。\n消渴经年惭削槁，茂陵堪自老相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6479,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北上答诸亲友相送","author":"欧大任","text":"曙催河斗转阑干，垂老怜予把别难。\n鹢首舟烦诸子送，竹皮冠笑故人弹。\n出门天地涛声壮，凭轼关山雪片寒。\n醉后强抛沧海去，曲尘终恋钓鱼竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6480,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宋郡丞季鹰邀饮署中同华父得吟字","author":"欧大任","text":"雄郡开名胜，三年我甫寻。\n池渟浈水出，窗纳岭云深。\n客里多吴语，尊前半越吟。\n淹留堪水夜，一慰故人心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6481,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"保昌黄明府邀饮因念亡友傅木虚","author":"欧大任","text":"词伯今为令，开尊爱客过。\n岁阴江树冷，山色县斋多。\n双舄知将去，三枫更若何。\n因君谈旧侣，空忆幔亭歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6482,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭下酬蒋宋二使君见过","author":"欧大任","text":"梅花岭下老担簦，敢向中原论代兴。\n置驿岂期逢掖贵，觅船犹愧孝廉称。\n虞廷此日咨州牧，汉相何人起郡丞。\n闻道长安推毂地，归朝行见玺书徵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6483,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度岭怀钱汝瞻沈纯甫黎惟仁诸君","author":"欧大任","text":"粤江三醉故人觞，立马关前一望乡。\n袅缀白云千垒石，飘零孤剑万家霜。\n别来痴岂谙时事，老去歌堪傍酒狂。\n无赖征鸿飞欲尽，那能相忆不沾裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6484,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中过赣同华父集叶太守郡斋","author":"欧大任","text":"地主今逢旧豸冠，麟符千里借才难。\n席边章贡波声壮，郡里空同雪色寒。\n五夜题诗邀客赋，十年封事为君看。\n张灯不浅持觞兴，已听关城画角残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6485,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宋都阃邀游天竺寺","author":"欧大任","text":"轻裘缓辔访禅关，愧我来游鬓已斑。\n猎向蓝田非小队，灯传天竺是名山。\n逐臣双泪愁边赋，狂客偏酡病后颜。\n谁料虔州竟分手，蓟门车骑可能攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6486,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"攸镇驿陪叶赣州饯送何中丞","author":"欧大任","text":"滩头五马饯筵开，共送中丞绣斧回。\n山拥玉虹随去节，雪吹金液照行杯。\n单车曾见埋轮疏，独坐今推补衮才。\n乡里衣冠吾已愧，客星犹自傍三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6487,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过豫章访朱用晦","author":"欧大任","text":"朔风隃岭为君行，岂但西园斗酒情。\n饮是布衣留十日，交无缟带赠平生。\n以予下走称驽蹇，借客中原但姓名。\n此夕不禁飞动意，双龙今在豫章城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6488,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱宗良方士功朱贞吉朱巍甫朱佳甫赵脩甫彭稚脩邀集竹在亭得秋字","author":"欧大任","text":"豫章城下系扁舟，暂得南皮一日留。\n颂酒二豪先酩酊，称诗七子尽风流。\n仙才已过周封史，帝胄谁如汉小侯。\n脩竹檀栾池水在，可因枚乘托千秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6489,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"抱膝轩为朱宗良赋","author":"欧大任","text":"双钩挂壁閒，长啸问匡山。\n酒客呼卢过，诸生佐锻还。\n玄言存系表，白眼向人间。\n君自吟梁父，何妨一掩关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6490,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饮朱同伯匡南草堂","author":"欧大任","text":"十度封书问闭关，披襟心比白云閒。\n校书汉代题中垒，奏雅淮南号小山。\n辔可控持风鹤上，剑曾飞射斗牛间。\n为君三醉清歌起，似胜当年七日还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6491,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伯融潜甫宗平诸王孙邀饮怀白堂","author":"欧大任","text":"公子西来孰辔过，千秋虚左事如何。\n岂缘白发劳车骑，曾是朱门爱薜萝。\n家自列侯人竞爽，风存大国客能歌。\n深杯不觉淹清夜，共向灯前散玉珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6492,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"彭稚脩听雨斋","author":"欧大任","text":"客子息心久，高斋缃帙开。\n濯枝初淅沥，忽过豫章台。\n瀑雪飘空下，松风杂响来。\n此时欹枕听，赋罢兴悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6493,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱巍甫春草堂","author":"欧大任","text":"公子称时彦，抽书夙好奇。\n谁知春草梦，更似谢家诗。\n碧杜初萦渚，青莎乍映池。\n赋成藏玉笥，心赏更向疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6494,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"佳甫上雅堂","author":"欧大任","text":"名家开艺苑，负笈许相寻。\n大雅何人力，中兴百代心。\n酣歌存妙理，丘壑寄长吟。\n知尔方求试，金门一寄音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6495,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南浦亭遇朱孔阳自桃花岭还","author":"欧大任","text":"稍栖牛屋欲何依，客似前洲伐荻归。\n岭外魂惊书后梦，河梁泪洒别时衣。\n渡江讵意逢袁叔，入洛犹能共陆机。\n朱丘故人如寄忆，春来无数朔鸿飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6496,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阴廉宪见过","author":"欧大任","text":"滕王阁倚楚天长，秋宪相寻上短航。\n十载门徒文蜀郡，一时宾客杜当阳。\n匡床长啸鄱湖月，绣斧先飞粤海霜。\n归赴内台应独坐，建章春色望鹓行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6497,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中同陆华甫泛舟章江忆曾与华甫自广陵冒雪渡扬子过白下","author":"欧大任","text":"玉鳞波急布帆开，扬子扁舟访戴回。\n谁料岭梅今共折，章江冲雪十年来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6498,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华甫往寻武山予舣舟泰和望之未至","author":"欧大任","text":"丁戊山人驻此山，石坛丹井绿云间。\n尔今欲就陶皮隐，待我匡庐白鹿还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6499,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自百家渡放舟西上何中丞见过夜饮","author":"欧大任","text":"霜威犹向酒边寒，沙碛频经九十滩。\n幸是顾荣同入洛，不妨人作季鹰看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6500,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"行次庐陵逢梁公智谪教吉州","author":"欧大任","text":"巴西傲吏不相闻，把袂谁知路又分。\n江艇夕停螺水雪，山斋寒宿鹭洲云。\n持经但可传诸士，罢酒何妨咏五君。\n侍从纵然非狗监，岂无人诵子虚文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6501,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东湖草堂访赵脩甫","author":"欧大任","text":"卜筑承先业，徵君旧有湖。\n池流通蠡泽，窗色入香垆。\n樗老材非散，山移谷似愚。\n闭关今日善，从此著潜夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6502,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪后同华父泛湖望康郎山","author":"欧大任","text":"西拥艅艎作胜游，宫亭湖上晚萧飕。\n帆吹匡阜诸峰雪，书隔湓江九派流。\n高浪楼盘蛟蜃气，大风军散鹳鹅秋。\n黄麾尚想高皇日，咫尺双龙傍斗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6503,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饶州酬黄兵宪士弘妙果寺饮别","author":"欧大任","text":"楚天风雪几停舻，西过康郎更问途。\n置驿郑庄频请谢，秉麾陶侃在江湖。\n借才价重连城璧，映坐光摇五色珠。\n此夕尊前贪握手，出关征马各踟蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6504,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"学古斋","author":"欧大任","text":"高咏北窗前，匡山俨相向。\n谁知晞古心，已在羲皇上。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6505,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜别陈饶州","author":"欧大任","text":"寒夜双星入部初，故人相见十年馀。\n雁声鄱水牵丝笮，雪色芝山照绮疏。\n仲举留宾江郡榻，长卿谏猎汉庭书。\n为君归报中朝旧，悬向斋前只有鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6506,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"残腊同华甫宿石壁馆","author":"欧大任","text":"天涯行役愧蹉跎，路入新安腊已过。\n一夜乡心头欲白，溪声犹在枕边多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6507,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登雪浪阁谒罗太史祠","author":"欧大任","text":"书在名山尽上乘，只今那得拜孙登。\n齐盟坛坫群公后，快睹须眉十载曾。\n病起入门惟玉钥，觉时舍筏即金绳。\n君看阁外玄潭色，掠海归来下雪鹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6508,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"尊赐楼为茂材奉国题","author":"欧大任","text":"尺五天边诏展亲，璇题缥缈逼星辰。\n汗牛书重先朝赐，绣虎才称百代人。\n繁弱尚藏封父旧，悬黎今较大梁新。\n主恩更问君侯乐，元是分茅肺腑臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6509,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"容膝轩","author":"欧大任","text":"一室不求宽，易安已能审。\n君看五柳人，葛巾漉还饮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6510,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"少玄精舍为朱茀斯赋","author":"欧大任","text":"杨生一亩托幽栖，草就犹堪手自题。\n宅比岷阳今更近，尚玄人在大江西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6511,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]