[{"title":"得閒老人 其三","author":"庄昶","text":"何处龙江叟，堪专水月盟。\n众人皆此坐，天下与谁平。\n不有终南病，能甘谷口耕。\n题诗搔短鬓，老子不无情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11622,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"遗爱为扬州刘同知作","author":"庄昶","text":"扬州何处月，老去更江湖。\n赤子千年戴，青天片石孤。\n乾坤尧舜事，贤圣禹皋谟。\n我问程夫子，浮云是有无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11623,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谢景瞻送蒲石","author":"庄昶","text":"老子书斋可，虚明小弟成。\n已交庭草翠，可少石蒲清。\n拜受吾侪感，携擎此老情。\n虚灵终藉服，岂但得长生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11624,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽刘员外母","author":"庄昶","text":"感激三年戴，悲伤万古图。\n长江如可断，此泪亦须无。\n何忝真员外，无成遂老夫。\n哀歌云水地，病眼血流枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11625,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄新安宋同知","author":"庄昶","text":"把臂华亭县，匆匆一语间。\n㩳身频要路，回首独空山。\n人与何年别，书曾几字还。\n题诗无限意，分付菊花斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11626,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"承孙侍御枉顾失迓诗以谢之 其一","author":"庄昶","text":"山岳真成动，柴门乃肯过。\n看山虽我病，失接此心何。\n感激青天望，留连白首歌。\n可胜垂老意，舞破钓鱼蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11627,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"承孙侍御枉顾失迓诗以谢之 其二","author":"庄昶","text":"蛇鼠闻风窜，豺狼破胆愁。\n巡行皆此老，当宁更何忧。\n春每随流转，讴长管去留。\n谁知定山子，诗略似春秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11628,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鸢飞鱼跃亭与寿卿小酌 其一","author":"庄昶","text":"酿熟麻姑酒，携来就树阴。\n我狂能自恕，杯小不须斟。\n溪水鱼同活，花丛鸟坐深。\n此时如不饮，不是此时心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11629,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鸢飞鱼跃亭与寿卿小酌 其二","author":"庄昶","text":"图凤苍天有，霜毛老鬓垂。\n相逢真可笑，不饮欲何为。\n拄杖公才出，壶觞仆屡随。\n醉来虽只我，不记姓名谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11630,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鸢飞鱼跃亭与寿卿小酌 其三","author":"庄昶","text":"万事随天作，生涯半耳聋。\n满斟今日酒，閒与寿卿同。\n潦倒三杯后，氤氲半醉中。\n夕阳花万朵，扶下小西峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11631,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画和沈豫轩","author":"庄昶","text":"乾坤秋淡泊，万里见真空。\n谁识此中趣，我怀无极翁。\n江湖还野艇，今古各光风。\n安得神游共，青天作主东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11632,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨宿大潮寺","author":"庄昶","text":"坐便山寺雨，更爱宿山中。\n此壁孤灯影，何乡老病翁。\n诗平容自考，静极与天通。\n亦有蒲团债，吾儒但不空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11633,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"浴香泉","author":"庄昶","text":"老著天游步，江山不肯违。\n春方玄酒淡，人每太初归。\n是妙何言乐，无尘可振衣。\n笑看曾点处，似或此狂非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11634,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"臞庵","author":"庄昶","text":"平生真面目，分付几峰烟。\n病里歌惟凤，人间瓠亦天。\n坎离吾药妙，山水尔藤贤。\n醉盎还谁我，梧桐月满川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11635,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东原道中和大中","author":"庄昶","text":"何处东涯路，乾坤醉眼空。\n溪山吾老脚，日月此虚笼。\n白帽天将近，芒鞋雪半通。\n梅花消息好，还与问东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11636,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"香泉道中和大中","author":"庄昶","text":"江山同一枕，何梦与神游。\n紫气围黄鹤，青天坐白牛。\n古今云汎汎，天地水浮浮。\n莫道双凫外，王乔不可求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11637,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"香泉和大中","author":"庄昶","text":"老信风花脚，香泉又一来。\n偶同贤辈浴，烂醉野人杯。\n明月天无夜，光风路不埃。\n行藏天地在，处处有高台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11638,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"虹桥道中和大中","author":"庄昶","text":"风光随阔步，处处眼俱新。\n酒盏冬天趣，梅花句子春。\n忘形幽壑几，把手白云频。\n自笑閒潇洒，青天一幅巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11639,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谢尚同以胙城尹谪重庆卫幕 其一","author":"庄昶","text":"人才丁未榜，天地楚中英。\n况有今巴蜀，宁知且胙城。\n从吾惟子好，玉女是天成。\n短发今浑白，题诗更几茎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11640,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谢尚同以胙城尹谪重庆卫幕 其二","author":"庄昶","text":"远近迁难问，安危病不知。\n书来空父执，老去见何时。\n川蜀天非远，行藏道可疑。\n长江千万里，滚滚是相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11641,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠丰城李士远用韵","author":"庄昶","text":"白发今何去，来过亦此天。\n子能留几日，吾且庆双泉。\n世事云难定，青山雨结缘。\n好看溪上月，还与共衰年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11642,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谢医士为谢汝申作","author":"庄昶","text":"老向秋风几，长惊白发根。\n何身无礼乐，此匕亦乾坤。\n红杏谁家洞，山藤破屋门。\n题诗从谢老，倒尽菊花樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11643,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄灵璧县博陆先生 其一","author":"庄昶","text":"盖自云倾后，人间病各痴。\n生涯贫不定，世故老堪疑。\n扰扰终何益，堂堂肯自知。\n好看相忆否，抖尽小囊诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11644,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄灵璧县博陆先生 其二","author":"庄昶","text":"往日梭山老，三年梦欲猜。\n交平千古定，天送一书来。\n鱼鸟真堪约，溪云只老怀。\n梅花堪寄否，惆怅钓鱼台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11645,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"无锡游秦方伯池亭和韵","author":"庄昶","text":"池亭天放手，都付浴沂翁。\n此乐真谁得，狂夫亦偶同。\n春游三月几，酒更万花中。\n敢向鸢鱼眼，乾坤误主东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11646,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"客至","author":"庄昶","text":"野磬閒投止，寒山莫欲深。\n醉留三日雨，狂了百年心。\n云水青藜杖，乾坤老布衾。\n蒙头閒不管，何处是晴阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11647,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梅窗","author":"庄昶","text":"草阁方虚坐，江空月色新。\n乾坤还此夜，今古是何人。\n稍稍宁辞晚，茫茫忽见春。\n平生打乖意，今夜任天真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11648,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送毕都宪致仕","author":"庄昶","text":"南国来何晚，龙门去未迟。\n四方无事日，一老是閒时。\n天地凭藜杖，风花任酒卮。\n大臣终体国，去就不嫌疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11649,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送严中书用韵","author":"庄昶","text":"君随黄阁老，我爱定山泉。\n廊庙才无忝，山林性只偏。\n飞扬谁过分，行止岂无天。\n肯作虚相爱，春江乱别弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11650,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中和怀玉 其一","author":"庄昶","text":"我意留公厚，苍天知此无。\n朔风三日雪，清世两迂夫。\n玄酒污樽礼，梅花太极图。\n无言还对坐，何必论鹅湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11651,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中和怀玉 其二","author":"庄昶","text":"对坐无言处，无中更有无。\n圣贤公自是，宇宙我非夫。\n人世开天境，江村挂雪图。\n此中凭打过，老眼送江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11652,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中和怀玉 其三","author":"庄昶","text":"陈叟题诗去，江湖梦寐长。\n主人惟老屋，夫子更匡床。\n东鲁千年脉，南丰一瓣香。\n可堪知己恨，残月管江方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11653,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中和怀玉 其四","author":"庄昶","text":"天心何处问，默坐正寒更。\n古调今疏越，天和此太羹。\n夜深群动息，冬老一阳生。\n料得梅花月，乾坤只么清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11654,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中和怀玉 其五","author":"庄昶","text":"未尽孤撑力，风波却少回。\n江湖今日好，天地此帆开。\n水静天平阁，山苍雪漫排。\n行藏应此老，真见仲尼来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11655,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梅花用韵","author":"庄昶","text":"草亭天正阔，老眼又河图。\n静坐千年后，谁知一画无。\n鸢鱼还此老，天地本真吾。\n不见庖牺氏，掀髯一笑孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11656,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白马席间和白沙先生","author":"庄昶","text":"万里何乡老，青天白帽来。\n神仙在人世，随处是蓬莱。\n云影千江月，天心数点梅。\n平生夫子意，又许铸颜回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11657,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"龙洞和白沙","author":"庄昶","text":"何年留此洞，想见太初来。\n风月谁张主，阴阳此荡开。\n地灵真孔窍，元气古胚胎。\n悟得庖牺意，狂歌月满台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11658,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"浴香泉和白沙","author":"庄昶","text":"我是白沙门，块然一顽铁。\n仰视林缉熙，天地自悬绝。\n感兹铸颜功，红炉一点雪。\n何处浴沂归，吟弄香泉月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11659,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和白沙秋夜述怀 其一","author":"庄昶","text":"此老真何意，我来更忆家。\n西风聊短鬓，细雨只黄花。\n慈母谁无老，京师也自佳。\n玉台巾样好，戴著有人誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11660,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和白沙秋夜述怀 其二","author":"庄昶","text":"万里行藏意，先生不遣疏。\n此心无系著，到处有鸢鱼。\n白发看虽满，青山不受呼。\n前年荔枝熟，童子报徵书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11661,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宇门承沈慎之任以庄送至句曲诗以道别","author":"庄昶","text":"樱笋江南路，扁舟兴不孤。\n仪形吾岂敢，风韵子真无。\n水月歌潼渚，风花坐练湖。\n乌头何足虑，老力更能扶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11662,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽李仁贵大理母","author":"庄昶","text":"万古坤宁意，人间又委形。\n平生交白发，儿辈与沧溟。\n南国人三代，西江女一经。\n百年堪幻境，江冷各山青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11663,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜闻谢元吉子咨领乡荐","author":"庄昶","text":"万里湖南信，谁将到荜门。\n此翁真有后，天道岂难论。\n伯雨生何忝，元城死亦存。\n何时堪慰藉，骑马下江村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11664,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同年蒋侍御枉顾和韵","author":"庄昶","text":"古洞斜阳外，柴门得晚江。\n桃花迷处所，骢马问何邦。\n坐客茅亭几，歌诗稚子双。\n鹿门虽爱我，我岂鹿门庞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11665,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中秋无月和廷信","author":"庄昶","text":"乾坤今夜月，本色共青天。\n纵有三更雨，能遮万古圆。\n妖蟆徒自绝，顾兔岂谁怜。\n老我浮云眼，寻常北斗边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11666,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十六夜晴月朗复用韵","author":"庄昶","text":"此夜江边月，清光昨雨天。\n自知虽小待，曾不减高圆。\n以往复何闷，今看岂足怜。\n老夫观否泰，起坐钓台边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11667,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"徐光岳至 其一","author":"庄昶","text":"江寺留诗夜，今年又八春。\n溪山惟一我，肝肺更何人。\n偶此来还否，相看梦与真。\n白头无限意，分付月溪滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11668,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"徐光岳至 其二","author":"庄昶","text":"江门千古地，来往有南川。\n夫我何为者，相过亦此贤。\n水花无别趣，庭草有真传。\n活水亭前月，能留共老年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11669,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"活水亭赠光岳","author":"庄昶","text":"活水如斯活，佳山更莽佳。\n已留庄叟坐，也直寿卿来。\n拄杖随行老，风花信口开。\n百年寻乐处，须子得吾怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11670,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月溪雨后同东川光岳二徐贤叔侄坐鸢飞鱼跃草亭","author":"庄昶","text":"此亭谁谓好，最好夕阳时。\n老我三人意，黄鹂两个知。\n花枝摇太极，云影荡玻瓈。\n遂以天机妙，匆匆著小诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11671,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同东川诸友溪上晚钓 其一","author":"庄昶","text":"诸老斜阳外，长竿共把时。\n雨深花倒醮，溪晚钓频移。\n圣代渔翁我，人间此乐谁。\n醉来溪上舞，老鬓白披披。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11672,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同东川诸友溪上晚钓 其二","author":"庄昶","text":"潦倒青溪上，閒随放宕缘。\n请谁留白日，任我钓青天。\n酒舞长蓑烂，花簪破笠圆。\n醉归扶不远，家只小东烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11673,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"溪上和光岳","author":"庄昶","text":"几点庖羲画，风花数子寻。\n茫茫人物我，滚滚去来今。\n杖履平生事，溪山此日心。\n更看扶老步，云水几峰深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11674,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西峰和光岳","author":"庄昶","text":"天下閒人几，青山一短筇。\n莫言知我少，还有白沙同。\n南海五千里，罗浮四百峰。\n白头云水地，飞动意无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11675,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"活水亭和东川","author":"庄昶","text":"莽莽鳌峰子，区区活水村。\n百年真眼孔，一个小乾坤。\n几榻诸公下，吾家万古存。\n与君风月处，刚对白沙樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11676,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿伯显家","author":"庄昶","text":"平生安老睡，此夜独何期。\n病枕风谁碍，疏棂叶放欺。\n山留人愈静，月有句专奇。\n若许论更鼓，因知某亦知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11677,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"将往平湖寄白沙","author":"庄昶","text":"石翁何处是，何处石翁心。\n南海梦长到，平湖别亦深。\n桨移花在荡，瓢饮月同斟。\n明日南川至，相思各苦吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11678,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送吴明府献臣","author":"庄昶","text":"门前何处客，问是广东船。\n行止虽殊路，江山共一天。\n閒随花意思，老结酒因缘。\n未了茅根念，天峰望子旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11679,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿边处士","author":"庄昶","text":"野日苍峰路，青天一布巾。\n莺花真老计，天地此遗民。\n海瓮仙醅熟，仙居帝画真。\n白头今太古，公外更何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11680,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"王审理封赠卷 其一","author":"庄昶","text":"岁月青山在，春风短发前。\n乾坤遗此老，儿子定吾天。\n破衲存深计，秋藤结老缘。\n封章天与在，终亦到林泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11681,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"王审理封赠卷 其二","author":"庄昶","text":"此日三迁教，何惭丌氏前。\n筑埋虽恶地，贤孝果青天。\n万事慈中分，封书意外缘。\n我当贤母墓，酌以定山泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11682,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"德州","author":"庄昶","text":"两月京师路，今来尚一千。\n虚名非雅事，薄计只苍天。\n夜泊随孤驿，鸡声各放船。\n小诗留一雨，又了德州缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11683,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与国贤和西涯","author":"庄昶","text":"人间文字眼，千古得吾师。\n山馆深留夜，京师在见时。\n虚名吾道在，垂老瓣香迟。\n静坐忘言妙，终身是此期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11684,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荣庆堂","author":"庄昶","text":"诏书新命下，老子况真贤。\n岁事匆匆日，人间活活天。\n老无非分福，生有圣贤缘。\n万古春秋在，题诗肯自偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11685,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和白沙韵","author":"庄昶","text":"一老真南海，乾坤此定交。\n花深长自爱，根好不须浇。\n云水天无极，江山月满瓢。\n可人今在眼，何意欲相招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11686,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽人","author":"庄昶","text":"浮云成惨戚，天地动哀吟。\n白鹤江山泪，孤儿父母心。\n百年恩自切，天意报还深。\n万古封章在，穷碑倚墓阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11687,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽人","author":"庄昶","text":"人生庄叟癖，死乐果谁传。\n此固虽虚诞，何凭更惘然。\n乾坤都父母，今古几亲贤。\n一洒乌台泪，人间肯自偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11688,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿寒山寺用韵寄文太仆","author":"庄昶","text":"位此天何说，才今道所然。\n相逢浑旧雨，此别更青天。\n周邵平生契，江湖白发缘。\n不朦僧寺月，惆怅过江船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11689,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"张明府惠伞","author":"庄昶","text":"皇天迓不雨，青盖领初阴。\n畎浍枯遮看，岩泉脉引寻。\n此时须大厦，何处不流金。\n一卷蓑衣薄，云生枫树林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11690,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"病暑","author":"庄昶","text":"暑无今岁剧，病甚往年侵。\n月瘦频池曲，风微空树阴。\n飞情霄汉健，潜意泳游深。\n道暍人人是，金卮恐乏斟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11691,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]