[{"title":"送雷生","author":"陈子壮","text":"客子侨居就隐沦，閒园鱼鸟转相亲。\n交游名下推棋圣，来往山中采药人。\n杖有百钱免羞涩，酒非千日对清真。\n登高临水多秋兴，枫叶芦花是去津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30922,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王克仲孝廉佳诗见存用韵却寄","author":"陈子壮","text":"晨星遥望叹朋簪，永夜曾陪玉麈谈。\n为问千金市燕骏，何如匹练走吴骖。\n张凭勃窣才还健，言子精华笔更酣。\n莫讶新篇不成和，故人萧瑟赋江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30923,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送魏道安复游桂林","author":"陈子壮","text":"江城一卧岁将寒，空谷巩然罄所欢。\n看竹自携醒酒石，谈棋相映切云冠。\n高吟八树清秋蕊，轻棹分流夜月滩。\n何处不逢贤地主，经游宁畏客行难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30924,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"生日偈答石佣子","author":"陈子壮","text":"瑶室璿房就里披，黄花九日对佳期。\n生身合掌如来日，世上齐肩大小儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30925,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对菊绝句 其一","author":"陈子壮","text":"为园蔓棘固须裁，霎眼新花亦可哀。\n烂漫寒丛将一月，残英犹自照深杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30926,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对菊绝句 其二","author":"陈子壮","text":"菊花须饮过重阳，待过重阴菊更芳。\n家在甘潭人不识，年年生日酒中尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30927,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对菊绝句 其三","author":"陈子壮","text":"浮名三十脱乌纱，双鬓生成合插花。\n春去秋来浑未改，终知输尔傲霜华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30928,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对菊绝句 其四","author":"陈子壮","text":"宁有游心逐少年，名都花草斗芳妍。\n铜街马上尘随眼，大好看花兴悄然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30929,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对菊绝句 其五","author":"陈子壮","text":"归来草色破霜痕，花落苔深自扫门。\n独有秋光不相负，繁英依旧绕篱根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30930,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对菊绝句 其六","author":"陈子壮","text":"浅白深黄次第成，酿来新秫瓮边清。\n陶家岂有江潭怨，恐负花情与酒情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30931,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对菊绝句 其七","author":"陈子壮","text":"翱翔华苑绝芳尘，公子能移数本新。\n凉月醉吟秋色里，难随白露寄伊人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30932,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对菊绝句 其八","author":"陈子壮","text":"耸壑淩云百丈涛，登台为尔首重搔。\n寻常莫漫欺篱落，佳色分明绝世高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30933,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对菊绝句 其九","author":"陈子壮","text":"采菊遥怜种菊时，心情惟遣橐驼知。\n贵花贱叶非吾意，野蝶閒蜂任汝嬉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30934,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对菊绝句 其十","author":"陈子壮","text":"曾入名园更可怜，篱花矜护害天然。\n萧骚好自舒情性，万朵千枝亚野烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30935,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送帅从龙邑丞擢判睢州丞先膳部公献平西夏颂于神庙得旨录送史馆 其一","author":"陈子壮","text":"混迹风流地，清心政事堂。\n仙才多薄宦，家学自名郎。\n副墨邀浮峤，张琴答桂阳。\n南中行略遍，高步信游梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30936,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送帅从龙邑丞擢判睢州丞先膳部公献平西夏颂于神庙得旨录送史馆 其二","author":"陈子壮","text":"先朝传献颂，今日喜闻诗。\n陶谢无兼体，邹枚又一时。\n园添新雪色，人有暮云思。\n残废龙门业，劳君枉见推。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30937,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠陈彦质归闽","author":"陈子壮","text":"莆中有佳客，能作太邱声。\n永夜隋珠色，终年任钓情。\n贵游多父执，知己足生平。\n珍重题纨扇，秋风兰芷清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30938,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦憨山","author":"陈子壮","text":"绮语名场事已阑，梦游文字我曾看。\n请君细歃曹溪水，割蜜还花也不难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30939,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北望台月夜独眺","author":"陈子壮","text":"虽非岩谷里，孤啸亦孙登。\n月月晴无减，光光景欲层。\n元珠如可得，黄鹤会须乘。\n五岳真拳石，齐州安足称。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30940,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古意","author":"陈子壮","text":"根株无赖却因谁，薄命生来怯兔丝。\n情知孔雀分飞后，冢上孤鸾自一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30941,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何龙友太史还朝十首 其一","author":"陈子壮","text":"风云如此际，留滞是何年。\n总为君亲合，非关出处悬。\n有书归使节，回梦听朝鞭。\n恒说中兴事，公才善勉旃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30942,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何龙友太史还朝十首 其二","author":"陈子壮","text":"深序追前辈，通才渐老成。\n圣朝徵实录，之子匪虚名。\n贺世罗浮凤，怀人太液莺。\n东南冠冕地，行矣焕弓旌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30943,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何龙友太史还朝十首 其三","author":"陈子壮","text":"皇极巍三殿，词头夐一家。\n露茎新宠遇，云笈旧声华。\n岁月宫僚缺，聪明讲幄加。\n开元金鉴在，风度总宣麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30944,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何龙友太史还朝十首 其四","author":"陈子壮","text":"同栖南海曲，并入承明庐。\n东壁劳相照，他山自不如。\n祖刘忧国蚤，房杜论交馀。\n为谢鹓鸾侣，南枝已卜居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30945,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何龙友太史还朝十首 其五","author":"陈子壮","text":"人瞻谢傅日，吾爱郗家风。\n纪有三芝异，出非小草同。\n诸王曾拥彗，馀子竞雕虫。\n里妇矉何态，长门亦汉宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30946,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何龙友太史还朝十首 其六","author":"陈子壮","text":"已失杨朱路，那堪问水程。\n蠡湖阳鸟没，严濑客星明。\n是处江南草，春风济北生。\n思君日舟楫，不独放游情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30947,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何龙友太史还朝十首 其七","author":"陈子壮","text":"榄水临将发，风流得雅裁。\n美人明月梦，仙吏白云台。\n海鹤招琴曲，江鸥劝酒杯。\n濯缨清可听，不觉榜歌催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30948,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何龙友太史还朝十首 其八","author":"陈子壮","text":"经旬维缆意，岁色引离觞。\n若为尤风缓，从添至日长。\n梅花诗里腊，黍谷律中阳。\n云树荧荧晚，何能望帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30949,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何龙友太史还朝十首 其九","author":"陈子壮","text":"渐觉山为黛，新开镜是潭。\n条风当少女，芳草即宜男。\n玉切朝天佩，香分侍殿簪。\n东方沾社醉，归袖几馀甘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30950,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何龙友太史还朝十首 其十","author":"陈子壮","text":"何人招隐赋，复作北山愁。\n祖道揶揄笑，仙槎汗漫游。\n真看天马逸，本自岁星俦。\n纵入罗浮梦，应随到十洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30951,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黎君选同龙友北上 其一","author":"陈子壮","text":"青翰同舟发钓矶，江梅残腊雪花稀。\n夷犹似待春潮送，岭上朝朝朔雁飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30952,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黎君选同龙友北上 其二","author":"陈子壮","text":"二豪酒德并堪论，花月春江笑问津。\n共醉万重山色里，不知谁是客中身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30953,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黎君选同龙友北上 其三","author":"陈子壮","text":"一经携谒圣明初，东阁还开旧秘书。\n诸父声华满霄汉，故人文似定吹嘘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30954,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黎君选同龙友北上 其四","author":"陈子壮","text":"莫小蓬弧射五云，百年麋鹿岂堪群。\n长安大有同游兴，无那花时独忆君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30955,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"前池雁篇","author":"陈子壮","text":"高楼曾尔叫声过，瘴海无能避网罗。\n自分不鸣同野鹜，还将短翮顾清波。\n此意与君深爱惜，稻粱岂为私恩泽。\n唼喋原非解向人，栖身似觉曲池窄。\n伫予书就送将归，直度衡阳柢碣石。\n可怜羽翼等閒催，可怜亦少长风借。\n中宵那复叹离群，异方拌作不归客。\n悠悠天路向何之，误入他家更苦悲。\n世间刀鼎非无用，不记当初鱼网罹。\n一声长叫振枯槁，多谢客来言亦好。\n难随放鹤去淩霄，得与游鱼聊戏藻。\n风草凄清烟月深，欲寐不寐起沈吟。\n吁嗟为尔起沈吟，空折江天万里心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30956,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同诸君分赋梅花","author":"陈子壮","text":"疏澹合孤栖，高人自品题。\n乍看台影渺，留伴月痕低。\n绝岭寻常见，前村咫尺迷。\n亭亭不解语，何物更成蹊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30957,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和逢永水松","author":"陈子壮","text":"此物宜乡国，寒泉不待盟。\n蟠生即涧底，天籁信涛声。\n风雨龙鳞见，阴森鱼甲明。\n抱香知可爱，岂是众人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30958,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为蔡医寿母","author":"陈子壮","text":"衣冠通德里，机杼孟家邻。\n山种千年药，门盈四叶春。\n青囊负米意，綵缕舞衣辰。\n为报麻姑信，云軿即主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30959,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李伯开归泰和兼谂其尊人自得在楚","author":"陈子壮","text":"倒屣逢王粲，称诗似法曹。\n几何辞白发，虚此问绨袍。\n短策从孤往，清琴莫浪操。\n知君江路熟，还望楚云高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30960,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄君常游武夷兼寄胡瓯宁","author":"陈子壮","text":"罗浮何日返，行糈宿黄精。\n天入建云密，春开闽霭清。\n宓琴山水曲，嵇驾弟兄情。\n若问乡人宴，应知重客名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30961,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春日赠张玉笥邑侯","author":"陈子壮","text":"轻舟曾与玉凫迎，还隐桑麻海上城。\n仙观雨时怜穗起，石门风过忆泉清。\n微同草色先吹律，又借棠阴一听莺。\n莫讶闭门虚折柳，春光浑似踏歌行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30962,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春三日侍诸父泛舟桃花坞 其一","author":"陈子壮","text":"三十春光晓望初，仙城谁问武陵渔。\n孤村潮上堪移舸，万树溪深拟结庐。\n醉色宜沾红雨乱，胜情真与锦茵舒。\n得随杖履须行乐，回首元都事总虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30963,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春三日侍诸父泛舟桃花坞 其二","author":"陈子壮","text":"欲作郊西即瀼西，红芳十里胜金堤。\n不知南汉千年苑，更入刘郎第几溪。\n负局客来怜犬吠，和歌谁伴乳莺啼。\n清时群从多游好，岂是秦人世外迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30964,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登赤石冈塔","author":"陈子壮","text":"石壁新瞻九级尊，飞甍危拱散层轩。\n琶洲铃铎江声战，越井楼台海气吞。\n万里戈船归汉译，诸天宝地称祇园。\n御风直揖三山外，漫倚浮云望帝阍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30965,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黎缜之除夕六十初度与智上人同庚比同枉过","author":"陈子壮","text":"盛足文章与后贤，恰馀岁月即初筵。\n吟边海日生残夜，杖底椒花媚远天。\n双眼常逢巢父饮，三生同證沃洲禅。\n新年诗兴清新甚，肯把屠苏让少年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30966,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉兰","author":"陈子壮","text":"清露初擎出晓窗，孤生明润世无双。\n十年花下多怜汝，相接瑶枝到海邦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30967,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灯夕赴洪紫云郡守园亭之招","author":"陈子壮","text":"三城已奏三春乐，五夜还追五马欢。\n徐榻久悬高谊在，习池真许醉游看。\n林间燕雀千声入，灯下鱼龙万舞攒。\n公暇更多求瘼意，野谈容易使君欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30968,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈丰城母六帙其侄来粤索诗","author":"陈子壮","text":"女籍遥占不老身，南陔欣寄采兰人。\n定移花县金桃熟，得傍萱闱玉树新。\n龙气由来看斗极，翟珈初度见星辰。\n吴兴门地安东似，七箸从容语伯仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30969,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三水蒋令公聘黄逢永为诸生授业诗美其事","author":"陈子壮","text":"秘帐摊书久闭门，倾筐何意托兰荪。\n生平子羽行堪信，今日文侯礼独尊。\n自爱腹便惟一榻，共知口吃有千言。\n琴堂喜近谈经馆，郁水衣冠气色屯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30970,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄子应蒋三水聘","author":"陈子壮","text":"春江潮汐信，摇动美人杯。\n一雨芦苞水，孤烟玉镜台。\n书逢关尹著，船报孝廉来。\n自识游燕路，高歌首漫回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30971,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答曾霖寰民部白下见寄","author":"陈子壮","text":"马足经时失，今看骨转高。\n气清郎署月，声起大江涛。\n谁共青绫被，犹分金错刀。\n途穷知阮恸，效拙见潘毛。\n龙蠖惟公等，乾坤听此曹。\n馀生湘吊屈，处士晋称陶。\n鸡肋怜朱绂，蛾眉妒锦袍。\n千夫元诺诺，群口但嚣嚣。\n来往愁讥凤，攀援耻学猱。\n邱中多细响，天末切刁骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30972,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄赠温侍御温前今按蜀楚有声特申巨济之望云","author":"陈子壮","text":"华发勋名豸角冠，驱驰骢马慰加餐。\n兵戈况复诛求尽，楚甸何如蜀道难。\n乔木始闻游女咏，铜鞮多称里儿欢。\n当筵合罢南征曲，都入升平乐事看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30973,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读张孟奇西园诸草酬赠一律","author":"陈子壮","text":"文隐青山几度梅，溪边明月笑徘徊。\n閒情北雅佳人曲，高会西园上客才。\n焚草尚堪馀满乘，啜醨元不废千杯。\n何缘仙梦嫏环秘，真见灵光赋里裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30974,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日同张孟奇太守王幼度明府连集东皋","author":"陈子壮","text":"江上行吟名已埋，花时别墅景差佳。\n追趋五马双凫会，教放三春两日怀。\n鱼为亲人添水槛，鹤能报客扫山斋。\n丁丁又听樵声晚，留醉知君心赏谐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30975,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东皋次张孟奇韵兼订罗浮之约","author":"陈子壮","text":"谁遣春光到野莱，绕园花竹尽成栽。\n烟疏北垞啼鸠缓，人并高阳骑马来。\n望海楼台真自幻，谈天风雨若为开。\n相期最是罗浮梦，见日应须三万回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30976,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种桄榔以一株分黄士明少宰园中辄惠佳韵敬答 其一","author":"陈子壮","text":"物色桄榔小，山樵惜故根。\n生成种吾土，风雨托邻园。\n荫薄思年纪，怜深到日昏。\n榆枋亦何意，堪与栋梁论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30977,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种桄榔以一株分黄士明少宰园中辄惠佳韵敬答 其二","author":"陈子壮","text":"绿野娱清尚，奇葩不用饶。\n青春閒种树，天籁已闻韶。\n幸可存微植，多因赏劲条。\n孤根随地稳，百丈任风摇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30978,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"后池雁篇","author":"陈子壮","text":"三五同人簇席欢，鸣鸠语燕对花阑。\n门前忽入清秋思，香山太史筒方至。\n上林苑里报苏卿，玄武陂中遇曹植。\n去岁黄生得此禽，能使吾园秋气深。\n纷员无数频来往，但从天上遗之音。\n引项停眸呼不得，夜夜为传三叠琴。\n满堂笑我情如此，恰好来禽堪付子。\n曲池比目与鸳鸯，会见双禽曲池里。\n携归我则解其声，前禽未诉后禽鸣。\n曰江南北全矰缴，羌馀独也羁魂惊。\n兄弟妻孥谁复有，吞声笑递他人手。\n雨日会三易主人，才执一编行者某。\n看尔悠悠若将终，似子郁郁恐难久。\n后禽款款具前陈，撩乱前禽语不真。\n直须与尔聊相依，其那食粟翼重不能飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30979,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上巳同逢永发珠江","author":"陈子壮","text":"三江为令客，万里趁舟行。\n禊祓寻常会，夷犹山水情。\n木棉分岸照，藤枕共吟清。\n宁有一杯酒，风流感慨并。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30980,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望石门次逢永见怀之作","author":"陈子壮","text":"扁舟移信宿，风雨石门堤。\n流水春城曲，荒烟碧树齐。\n无禽栖旧井，吹笛过前溪。\n指顾江山外，重来得句题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30981,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三水候陆观察座师","author":"陈子壮","text":"蛮水滔滔转战馀，主恩遥借外台居。\n十年谁问康成业，四野人瞻孟博车。\n乍觉鹏风驱海蜃，相将军雨足江鱼。\n汉庭此日推文武，不数重来谕尉书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30982,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邂逅何龙友偕黎君选舟中分赋","author":"陈子壮","text":"乡国迟回水石春，诸峰随意碧嶙峋。\n三江烟雨人方至，上巳风流各可陈。\n舟楫长年须进峡，行藏今日定知津。\n最怜南浦蘼芜绿，迸入提壶酒色新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30983,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江行见暴骨五具诗以埋之","author":"陈子壮","text":"正子空江枕石宜，桃花春水太相欺。\n回环试听庄生语，还尔千秋万岁期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30984,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将为峡山之游赋谢蒋三水","author":"陈子壮","text":"点点云山发兴过，生涯因寄木兰多。\n春围潋滟花开县，榜入沧浪客放歌。\n日午轻阴分雉翳，雨馀清梦散渔蓑。\n不愁禺峡终难进，胥水从添百丈波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30985,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中呈黄子","author":"陈子壮","text":"半生烟水梦，今日细须论。\n垂钓饵何设，看云意自存。\n鸟声高竹店，人影暗花源。\n遂欲携家口，躬耕住鹿门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30986,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]