[{"title":"雨泊昆成遣信要仲蔚","author":"王世贞","text":"三载抱寒影，兹辰聊出游。\n春风澹疏雨，渺渺独行舟。\n瞑色动城雉，炊烟散林鸠。\n呼童洗茶盌，君解过侬否。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10073,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"余以幽忧久废吟咏至八月十二日夜忽梦於停云馆饯人北还得二句云中原垂鸟道久客自鹑衣寻改赋古体八句觉后悉记之不知其何说也","author":"王世贞","text":"留君日何短，别君日何长。\n中原鸟道路，游子鹑衣裳。\n悲风夜骚屑，白云寒苍茫。\n尽此一杯酒，踟蹰空断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10074,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过莫公远草堂有作","author":"王世贞","text":"流水欲尽处，见君白云堂。\n谁云四立壁，解有双脩篁。\n开卷动秋色，谈诗过夕阳。\n出门一长啸，迥尔高天苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10075,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题沈道士竹洲馆","author":"王世贞","text":"道人沧洲馆，拥径千琅玕。\n竟日碧云合，有时明月残。\n玄心澹相映，秀色净堪餐。\n忽忆青莲句，秋声万古寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10076,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐子与解郡过吴门司淳父辈出视分韵得弹字","author":"王世贞","text":"白发归人问，青山傲吏看。\n簪从今日盍，冠复几时弹。\n海内诗仍在，吾徒酒自宽。\n浮家苕霅里，来往莫辞难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10077,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过邵元化饮不醉戏作","author":"王世贞","text":"田父过能数，书生具颇艰。\n大都鲑菜美，遮莫酒杯悭。\n鼓腹松风外，科头树影间。\n近知醒亦好，归步不蹒跚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10078,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幼于见过分韵 其一","author":"王世贞","text":"小径苔从破，清尊雨乍过。\n亦知高枕是，其奈故人何。\n懒但安吾有，狂今较孰多。\n近耽贫贱理，慎莫厌松萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10079,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幼于见过分韵 其二","author":"王世贞","text":"踟蹰酒不醉，起见明星阑。\n片语数相苦，千秋敢独安。\n青山蜡屐在，白雪高斋寒。\n傲岂吾曹意，时名君自看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10080,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄泉守周先生","author":"王世贞","text":"为得闽中耗，愀然几废耕。\n有家俱中虏，无地不寻兵。\n此际干城在，应专保障名。\n寄言麟阁上，早晚着书生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10081,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日饮煦上人房 其一","author":"王世贞","text":"野人无一事，爱尔云床眠。\n缓带松风集，开樽江月悬。\n僧仍解中圣，客亦喜逃禅。\n欲问西来意，难从醒者传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10082,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日饮煦上人房 其二","author":"王世贞","text":"藜杖欲何适，清溪扶兴长。\n煦公茅屋底，时有松醪香。\n青菜久成甲，红莲初离房。\n谓予餐禅悦，此味讵能忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题林布政墓志后为其孙司训请","author":"王世贞","text":"残编未忍读，为忆泰陵时。\n绩是中兴纪，文如有道碑。\n已看埋玉树，还复长兰枝。\n大有棠阴在，王孙知不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长兴诸友生送别道上即事","author":"王世贞","text":"今朝霅川路，且作武陵看。\n萝色分樵斧，萍阴入钓竿。\n水怜衣带近，山忆画图宽。\n剧有浮家兴，离觞莫厌残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"义士李国卿归骨长山哭以送之","author":"王世贞","text":"生死衔恩在，间关病骨遥。\n刀头空自卜，匕首为谁骄。\n风色田横馆，寒云豫让桥。\n岂无心一寸，魂断竟难招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘佥宪罢官","author":"王世贞","text":"偶一闻朝事，君今又乞身。\n世情工射影，吾道合垂纶。\n岁月终何事，江湖渐有人。\n素衣知尚在，不染洛阳尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏赠导引者吴生","author":"王世贞","text":"池涌青莲坐，天垂白玉棺。\n暂留为说法，欲去亦无难。\n尔今习熊鸟，便欲唤鹓鸾。\n三尺齐门铗，将从紫府弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"包子以参军集见遗有答","author":"王世贞","text":"忽展参军集，殊兼鲍照长。\n篇章自吴越，今古共齐梁。\n才岂人间尽，名容我辈狂。\n归来亦有作，不拟唤柴桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕 其一","author":"王世贞","text":"江村寒转寂，桑柘欲生烟。\n竟日悬孤榻，有时手一编。\n疏灯逗馀夜，小雨作残年。\n唯有牢愁念，时时不类禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕 其二","author":"王世贞","text":"谁怜抱影意，吾卧已经旬。\n晻冉难留日，支离向晚身。\n任他新甲子，不解守庚申。\n惟有尊中物，能令隔岁春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谷日雪作","author":"王世贞","text":"霰雪飘何甚，因风袅更斜。\n腊迟偏为谷，春润未疑花。\n曙色开银甃，寒光入绛纱。\n床头社酒熟，扶醉到邻家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晦日园行初见红梅一树作","author":"王世贞","text":"孟春行已尽，入眼但红梅。\n破雪寒相假，含风晓暗催。\n萧条初辨色，烂漫不禁才。\n且莫论迟暮，陶然酒一杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"袁鲁望见过分韵四首 其一 新岁为甲子","author":"王世贞","text":"懒草玄经罢，开门春草平。\n交游随宦失，物态与年生。\n悬榻宁双下，呼樽始一惊。\n对君今日饮，差不悔虚名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"袁鲁望见过分韵四首 其二","author":"王世贞","text":"盘飧无别味，好为野人留。\n菜甲春畦熟，河鲀晓市收。\n白分燕玉暖，青擘越丝柔。\n却笑张公子，莼鲈夺宦游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"袁鲁望见过分韵四首 其三","author":"王世贞","text":"小有求羊径，能无为尔开。\n冻偏初徙竹，春勒未舒梅。\n少住因青眼，何营但醁醅。\n不须论兴尽，归舫或堪陪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10096,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"袁鲁望见过分韵四首 其四","author":"王世贞","text":"渺渺孤帆去，江头此送君。\n风光催岸柳，潮影泄春云。\n纵饮时相压，狂歌好自闻。\n亦知分手易，将老畏离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10097,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"席上探赠得鲁望","author":"王世贞","text":"春风木兰楫，遇尔阖闾城。\n西出横塘晓，寒花千树明。\n经营多酒事，飞动各诗名。\n独有分携处，依然黄鸟声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10098,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过徐徵君作","author":"王世贞","text":"城处无远瞩，念君亭馆幽。\n窥帘竹色动，隐几松阴流。\n道书久不读，清言时一酬。\n还能开径否，吾敢拟羊求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10099,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子与病后见贻新诗六章次答 其一","author":"王世贞","text":"高枕抗烟萝，春光奈病何。\n谁堪胍季子，我解问维摩。\n丈室诸天在，千秋一瞬过。\n加飧更有语，晚计莫蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10100,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子与病后见贻新诗六章次答 其二","author":"王世贞","text":"善病胡为尔，清斋药饵催。\n潮怜枚叔对，露惜马卿才。\n湖海身偏靳，文章老自猜。\n还将呕心句，次第为君裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10101,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子与病后见贻新诗六章次答 其三","author":"王世贞","text":"遥怜伏枕处，咄咄向何人。\n春色从教负，朋情转自真。\n莺花若下酒，烟雨霅溪纶。\n不独能憎达，穷来妒汝身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10102,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子与病后见贻新诗六章次答 其四","author":"王世贞","text":"病色坚高卧，生涯浅卜居。\n莫疑杯外影，须却枕中书。\n陶墅偏宜秫，潘园好艺蔬。\n残年幸犹在，随我狎樵渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10103,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子与病后见贻新诗六章次答 其五","author":"王世贞","text":"亦有清狂疾，饶君善酒尊。\n物情双药裹，吾道一衡门。\n伏枥人俱老，冲星剑尚存。\n此生终海岳，不死任乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10104,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子与病后见贻新诗六章次答 其六","author":"王世贞","text":"萧条一书札，新自霅中来。\n惫与贫争长，愁将老暗催。\n诗魔应稍退，酒债未全开。\n了却无生后，春风几百回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10105,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"法空上人虎丘翻经","author":"王世贞","text":"大有摩尼在，将从智者探。\n天花凡几点，贝叶到何函。\n千日悬龙藏，孤灯隐佛龛。\n欲知翻后境，晓色空寒潭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10106,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"法上人还石湖","author":"王世贞","text":"一钵本无住，孤云时自依。\n苍然石湖色，似爱远公归。\n忍草吐新带，香莲辞故衣。\n唯应乞食后，秋雨对柴扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10107,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄答明卿二首 其一","author":"王世贞","text":"闽海迢遥路，柴门放逐身。\n双鱼不自意，五马更何人。\n旧态俄能发，穷交转向真。\n相逢未可定，佳句眼堪新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10108,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄答明卿二首 其二","author":"王世贞","text":"侧目中原并，游踪晚路偏。\n一麾仍领郡，万死及归田。\n宦在何妨薄，诗成祇共怜。\n高鹏与低鴳，天地亦茫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10109,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄黄生舒华","author":"王世贞","text":"及尔书来日，行藏更可怜。\n一官诗自罢，万态酒堪捐。\n老岂时人力，穷馀异代权。\n何当具瓢笠，握手太湖烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10110,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟次辱华存叔见示投赠之作有荅 其一","author":"王世贞","text":"不为风尘色，吾庐卧自深。\n时名双屈指，物态一惊心。\n姓字劳波及，文章久陆沈。\n相看布衣在，飞动不能禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10111,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟次辱华存叔见示投赠之作有荅 其二","author":"王世贞","text":"莫问援琴意，惟怜执手时。\n新诗过草速，疏烛受花迟。\n岁月吾初有，乾坤尔自知。\n春波正辽阔，未敢定前期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10112,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答沈山人嘉则二首 其一","author":"王世贞","text":"满眼交游态，相过意独深。\n醉来扶任侠，老去急知音。\n零落家人产，纵横国士心。\n未须论往事，呜咽对沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10113,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答沈山人嘉则二首 其二","author":"王世贞","text":"兄弟逢家难，仓皇并挂冠。\n莫言归计早，犹作畏途看。\n萝薜褰愁入，松杉掩泪残。\n唯应狱中剑，虹色为君寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10114,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为张茂才赠张将军时治艘南京","author":"王世贞","text":"客言保障地，无复使君贤。\n礼乐原蒐贵，楼船汉将专。\n令严朱桁月，烽净白门烟。\n更有平原馆，衔恩国士偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10115,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"尤子求尝自言其手画苏长公后赤壁赋甚精索余书赋其尾未果今年冬子求忽使阿獠携此卷来乞二金为腊夕之资余如数与之还其卷为书赋且题一五言律子求可付虎儿善藏之勿售非其人也","author":"王世贞","text":"只倚曹韩贵，穷来泥所如。\n真成乞米帖，吾岂换鹅书。\n笔底青山在，灯前白发疏。\n吴门有长铗，慎莫叹无鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10116,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观夜猎醉作","author":"王世贞","text":"老分穷愁在，归堪一事狂。\n由来学剑晚，肯为著书忙。\n花径朝浮白，霜天夜走黄。\n衰颜且涂抹，阑入少年场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10117,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与舍弟郊行访旧作","author":"王世贞","text":"风日江乡好，连翩并所如。\n门人两篮舆，贫旧一茅庐。\n时见青烟远，因知黄叶疏。\n悠然浅酌罢，随意狎樵渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10118,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陆考功与绳","author":"王世贞","text":"自起东山驾，苍生果不虚。\n舜门悬水镜，尧日满公车。\n契合孤忠后，穷分一气馀。\n久安遗世略，不草绝交书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10119,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陆生","author":"王世贞","text":"自贪林下日，生计未全疏。\n时展滑稽传，间窥玄素书。\n因君获二妙，顾我罢三馀。\n尽可扶衰病，青山恣所如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10120,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过故凌京兆汝成墓有感","author":"王世贞","text":"初日松楸地，相过倍黯然。\n古今杯酒得，生死谏书传。\n旧客西州泪，新题京兆阡。\n向来同病者，老诵独醒篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10121,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"马鞍山陆氏园送别子与得新字 其一","author":"王世贞","text":"送君冰雪地，梅意独含春。\n晚更怜山色，穷能恋故人。\n篘来社酒煖，猎罢野厨新。\n昵昵深杯后，俱誇未死身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10122,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"马鞍山陆氏园送别子与得新字 其二","author":"王世贞","text":"出处关何事，因君偶试论。\n一官今转拙，十口未全贫。\n白雪衔知旧，青山惜别新。\n自安丘与壑，终不傍风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10123,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕偶忆杜诗四十明朝是语有感作曹事 其一","author":"王世贞","text":"四十明朝是，愁来酒易醺。\n流年杯后得，绪景句中分。\n寒勒孤村雪，春生大海云。\n浮名殊自苦，吾意欲无闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10124,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕偶忆杜诗四十明朝是语有感作曹事 其二","author":"王世贞","text":"四十明朝是，抽簪岁屡更。\n自贪田父日，谁妒野人名。\n腊肉来乡社，春醪有弟兄。\n不教儿辈酌，知会减欢情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10125,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"皇甫司勋宅逢故九江守王丈王於先君同年其来也为其尊大夫乞皇甫志墓因赠五言三章 其一","author":"王世贞","text":"把袂吴闾里，含香汉署游。\n风尘二千石，湖海一孤舟。\n门刺通文举，碑辞识太丘。\n岁星无物色，随地足沈浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10126,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"皇甫司勋宅逢故九江守王丈王於先君同年其来也为其尊大夫乞皇甫志墓因赠五言三章 其二","author":"王世贞","text":"客间疑鬓发，天上见文章。\n以尔丈人行，当时童子郎。\n霜风鸣蒯铗，春雨涩荷裳。\n莫作穷途恸，烟霞许并狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10127,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"皇甫司勋宅逢故九江守王丈王於先君同年其来也为其尊大夫乞皇甫志墓因赠五言三章 其三","author":"王世贞","text":"试问西京日，终童更有无。\n青云流辈尽，白雪和人孤。\n布帽时堪掷，篮舆少给扶。\n威明殊偃蹇，倒屣为王符。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10128,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答殷无美问疾","author":"王世贞","text":"欲悉春来况，头颅渐不如。\n泔鱼吾事晚，罗雀故人疏。\n懒废虽堪病，穷愁可罢书。\n唯馀止酒意，为尔尚踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10129,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"余忝青社日陆叟挟岐黄之术游余门既罢归访余江上素发被领童颜不衰云且北游余谓叟术固神能治余狂疾乎因为一诗赠之叟笑不答","author":"王世贞","text":"十年仍一老，不改酡颜春。\n身作齐鲁客，名同秦越人。\n采苓山月晚，种杏江风新。\n独有清狂疾，饶君术自神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10130,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"端午里中饮时甫有海上之捷","author":"王世贞","text":"莫以独醒意，生疏旧酒徒。\n煖香初写玉，寒碧旋添蒲。\n柳插从巾堕，花催到手无。\n海波知稍戢，为有辟兵符。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10131,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓行即事","author":"王世贞","text":"小舆凉能进，荒鸡远互求。\n无妨戴星去，仍作御风游。\n卵色天徐坼，眉纤月迥愁。\n泠泠桔槔水，随意到前畴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10132,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠徐使君之徐州宪作","author":"王世贞","text":"彭城徐子地，柱后汉臣冠。\n地挟黄河峻，冠凌白雪寒。\n风流千骑拥，祖道万人看。\n自有攀辕泪，时平借寇难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10133,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉送彭昆山特徵","author":"王世贞","text":"忽报天书下，秋星引去轮。\n吾方传循吏，君可愿良臣。\n水忆朱弦在，霜催白简新。\n草莱无限色，仗尔达枫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10134,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题东洋卷","author":"王世贞","text":"为厌人间小，沧波倘可寻。\n扶桑催日动，碣石抱云沉。\n未晚图南翼，长悬立极心。\n乘桴吾道在，对尔欲沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10135,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐徵君示灌园诸作率尔奉答","author":"王世贞","text":"一叟汉阴兴，新诗大历才。\n才宁随老尽，诗可傍穷来。\n历落秋声树，青荧晓色苔。\n衡门知久寂，肯为抱琴开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10136,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮乡人桂树下作","author":"王世贞","text":"桂树扶秋老，藜筇引兴长。\n短墙过秀色，小径袅幽香。\n客自歌招隐，人殊胜辟疆。\n前身是金粟，米汁但何妨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10137,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠广东袁生","author":"王世贞","text":"山川知粤尽，风物到吴新。\n旧业馀孤隐，时名傍此身。\n酒旗随处是，诗卷未全贫。\n为语袁宏道，谁堪赋里人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10138,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠杨茂才杨之父别驾君则先子尝受业焉杨又馆於族孙进忠其行也乞诗为别","author":"王世贞","text":"谈经而父业，门馆尽时髦。\n未竟衔鳣瑞，依然见凤毛。\n青箱王氏得，绛帐马融高。\n欲悉通家意，临岐有佩刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10139,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]