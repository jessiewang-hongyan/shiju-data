[{"title":"同年再会西园用林司空韵二首 其二","author":"尹台","text":"结驷西园践夙期，郊原春冻见花迟。\n生憎风霰飘残夜，不放笙歌沸曲池。\n漏定月华微映座，烛残林影暗摇卮。\n握君秀句吟难就，安得羊何共和之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7505,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"木末亭用韵","author":"尹台","text":"亭闻木杪人欣胜，径转云端客共灯。\n佛宇疑藏无色界，仙家似在最高层。\n孤烟晚起闻香饭，斜日林疏见钵僧。\n忽忆当年题塔会，清尊今集几英朋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7506,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答姚秀才","author":"尹台","text":"幽栖卧病乌皮几，留客小堂文行尊。\n久以宦游縻岁月，每於春至忆乡园。\n南宫地切铜龙署，北斗城高金马门。\n一出枫宸惊十载，江湖云气自朝昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7507,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王中丞致政南归","author":"尹台","text":"入春风雪转阴霏，斗酒江亭怅独违。\n迎幰冻花犹闇闇，飐旌寒柳自依依。\n新盟白鸟烟波阔，旧业青山草树稀。\n济巨期君君竟往，吾衰空忆钓鱼矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7508,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"追挽蔡居士","author":"尹台","text":"大隐谁言远市朝，我思高士竟难招。\n吊怜楚老哀同剧，荐忆庚桑报自劳。\n旧木萧萧围宅冷，长川泯泯去人遥。\n郤家故有乔林桂，何事奇芬阻碧霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7509,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿周君六十","author":"尹台","text":"何嗟杖履老中林，六十悠然抱膝吟。\n迹学南山玄雾隐，家藏西崦白云深。\n遗安自得庞公计，积果应成窦父心。\n叹我衰迟縻棘省，因君浑欲谢朝簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7510,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和周中丞喜致仕报作","author":"尹台","text":"曳佩遥辞尺五天，息机且问汉阴田。\n洛中旧盛耆英侣，海上元多服食仙。\n定拟渊明三益咏，不传平子四愁篇。\n此归访学人非少，白发还堪比伏虔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7511,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得七峰符卿书并示往岁见忆之作叙感二首 其一","author":"尹台","text":"四海论交壮齿前，多君高谊薄云天。\n莺花春寺移尊日，鼓角秋城请剑年。\n往事伤心怜白发，清词寄愤感朱弦。\n棠溪近岁传双鲤，未报琼瑶思屡悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7512,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得七峰符卿书并示往岁见忆之作叙感二首 其二","author":"尹台","text":"奕叶猗兰振代光，君家兄弟大芬芳。\n谁因采佩思王者，自咏迷阳学楚狂。\n昨忆尺题存箧笥，何时斗酒说干将。\n定知鸿鹄翔天汉，羽翮无劳弋缴防。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7513,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送考功蔡郎中提学闽中","author":"尹台","text":"海上烟尘渐息惊，闽中隼射化蚕耕。\n青衿弦诵沿郊有，白屋童冠着处迎。\n晓馆微风开帙轴，春堂细雨偃匏笙。\n试探皓首横经者，谁解铿然舍瑟情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7514,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日同年西园集二首 其一","author":"尹台","text":"花前并剧三春兴，竹下聊为六逸吟。\n弄艇共看新草色，开轩更坐古梅阴。\n幽人似隔兰苕渚，隐客谁招桂树林。\n徙倚孤亭遥骋目，高天云雾暗西岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7515,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日同年西园集二首 其二","author":"尹台","text":"黄金榜下看花侣，白发林中对酒人。\n四海渐看同辈少，百年转忆故交亲。\n桃低浅颊疑舒笑，柳放新眉似学颦。\n幸藉挥弦娱落景，可辞秉烛照归尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7516,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏石翁太常宅牡丹","author":"尹台","text":"倾城名艳出尘寰，独立春风意自閒。\n素月故应留雾佩，青山长为扫烟鬟。\n瑶池若见堪停宴，洛水如逢可待扳。\n若怪太常终日醉，白头端借驻欢颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7517,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"对花咏怀","author":"尹台","text":"九十春残花渐稀，追欢那惜典春衣。\n况逢胜侣能同兴，忍对芳丛不醉归。\n往事徒伤金谷在，名园共惜洛阳非。\n破除万事聊尊酒，尽判风花作意非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7518,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登泰岳二首 其一","author":"尹台","text":"峻岳高攒海甸标，霞光千里荡扶摇。\n为寻古帝登封迹，来赴真仙汗漫招。\n缥缈孤阴生大野，虚无灵气变丛霄。\n金绳玉检从谁问，独立高丘记往朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7519,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登泰岳二首 其二","author":"尹台","text":"夙忆名山北岸冠，天风海日振穹峦。\n金庭景倒三千界，玉栈云飞十八盘。\n九节自携青竹杖，三花谁扫碧霞坛。\n翛然下览众山小，矫首苍茫六合宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7520,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜宿雄县馆枕寐忽得诗四句若兆余南归之谶者后三日果闻报因足前四句成之","author":"尹台","text":"松菊荒庐旧径微，朱衣今喜谢朝扉。\n听声谬曳尚书履，儤直叨承学士闱。\n抱叶流萤纷吐焰，惊枝宿鸟暝争飞。\n长镵归去岂无计，黄独山中秋正肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7521,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悯忠祠别门人张别驾仁夫","author":"尹台","text":"十载孤踪隔禁扉，三秋重与故人违。\n君才尚滞黄龙塞，我梦先飞白鸟矶。\n红叶尽教飘客路，缁尘肯使化征衣。\n平生意气惟张竦，愿以经书共载归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7522,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"范兖州出送济南上留别","author":"尹台","text":"许身空自比南金，未报清朝愧陆沉。\n出处龙蛇谁定迹，去留天地亦何心。\n高贤能解孤悬榻，旧客那伤变徵音。\n回眺浮云千里色，漫弹雄剑助哀吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7523,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠祠卿徐太守","author":"尹台","text":"五月荷花开镜湖，使君曾驻画轺无。\n搴帏吏傍青山出，露冕人交碧树趋。\n旧雨几年劳展牍，停云此日忆专符。\n共言圣代尊良守，赐服行看耀弩驱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7524,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄张玉屏员外","author":"尹台","text":"李膺才气故无俦，归卧江东问几秋。\n偶以黄花传丽句，岂因莼菜寄风流。\n沙边云雾深宜隐，谷口泉萝静可留。\n远想青春行乐处，渔竿长自弄扁舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7525,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送泰和祝令入觐","author":"尹台","text":"朱弦快阁擅风流，尚忆当年旧县侯。\n共羡美才成制锦，每多异政在歌裘。\n岁残鸿雁遵沙集，春转龙蛇起陆游。\n定拟飞腾易霄汉，贤声预已达宸旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7526,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贞烈祠二章 其一","author":"尹台","text":"鼎移谁不污风尘，一妇临危独陨身。\n生誓丹心宁负义，死凭碧血与传神。\n八砖祠庙高天近，千仞宫墙皦日新。\n今古烈名畴拟并，千山嵊岭对嶙峋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7527,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贞烈祠二章 其二","author":"尹台","text":"痛哭中原二百州，东南降帜忍包羞。\n勤王八族兵先殪，死贼一门妇可留。\n伏腊贞魂长礼殿，江山遗恨漫旃裘。\n天常未向中闺绝，正气吾邦昔所流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7528,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠郑节推二首 其一","author":"尹台","text":"使君节旆惊初顾，野老冠裳讶倒将。\n敢以凿坏辞世混，聊因抱灌托机忘。\n青蝇久向林皋失，黄鹄终飞天汉长。\n共说郑卿怜汲孺，未妨樽酒狎沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7529,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠郑节推二首 其二","author":"尹台","text":"三鳣早兆知先应，双鲤忽传问所如。\n江上未追元礼棹，山中空策少游车。\n芙蓉秋老芳谁采，鸿雁天高影自疏。\n欲赠夫君千里道，翻持杂佩渺愁予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7530,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠汪君得冠服诗","author":"尹台","text":"买断清溪十里浔，结庐长占古潭阴。\n共誇卓氏车僮盛，何似朱公计策深。\n白发冠簪新宠数，青春桃李旧家林。\n悬知谢却樊笼绊，翠壁丹梯从尔寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7531,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"萃胜楼追和东廓先生二首 其一","author":"尹台","text":"白首寻春若处深，青山此地且投簪。\n悠然独立川云际，自得一村鱼鸟心。\n乍集童冠思拟胜，相宣金石感同音。\n请看不舍如斯者，尺璧宁将抵寸阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7532,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"萃胜楼追和东廓先生二首 其二","author":"尹台","text":"古树深溪相对清，晓踰孤阁玩虚明。\n数圈谁泄图书秘，万古元储河洛精。\n寂寂朱弦怜辍响，嘤嘤黄鸟悦求声。\n新知自振风鹏力，可使扶摇易息程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7533,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东山小集次答李学谕二首 其一","author":"尹台","text":"赤绂元惭鼎贵姿，青毡聊憩共儒师。\n逢时耻献河东赋，述往欣传邺下诗。\n杖履此归閒可理，溪山时眺兴偏宜。\n相将更作禅林集，笑拈庭前柏树枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7534,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东山小集次答李学谕二首 其二","author":"尹台","text":"吴市行歌非客姿，苏门长啸亦吾师。\n因嗤左氏十年赋，不及陶家五字诗。\n祗苑翻经君独悟，薝林陪座我兼宜。\n归舟醉繫梨花月，玉影离离缀夜枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7535,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戴君六十诗","author":"尹台","text":"传经几试三千牍，阅世今周六十年。\n为士岂誇长倩达，入乡应信彦方贤。\n芝含晚媚朱霞绚，桂捧秋阴碧露悬。\n醉引斑衣供戏舞，不招鸾鹤也堪仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7536,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送庐陵龚大尹北觐","author":"尹台","text":"渤海单车汉治传，风流远裔振兹年。\n青霄自下王乔舄，白日长横宓子弦。\n此别双鱼慰何日，相思一雁下遥天。\n汉庭恒召洛阳俊，宣室悬知席易前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7537,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张凤林太史竣使还朝","author":"尹台","text":"几年欢綵旷萱除，玉节遥将慰笋舆。\n九折那回邛阪驭，三长仍载汉闱书。\n江亭去雁依山棹，驿路迁莺引使车。\n往识倘垂幽侧问，为言久病卧相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7538,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送应少尹提牧留京","author":"尹台","text":"黄梅新雨涨长川，别思遥将白下船。\n汉史廉丞今见汝，蒙园傲吏昔称贤。\n三千騋牝歌駉日，百万兵车治赋年。\n渊塞似君知独少，圉人数富定无先。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7539,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和答刘少衡见寄之作二首 其一","author":"尹台","text":"先皇寤寐建豪英，凤德传歌感昨情。\n廷尉岂堪荣翟氏，公车聊复重王生。\n风波畏路同君涉，云水閒田恣我耕。\n南极一星虚尔映，六符遥愿正台衡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7540,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和答刘少衡见寄之作二首 其二","author":"尹台","text":"楚山秋色突千寻，西压云阳紫气深。\n炎帝巡车谁访昔，朱方火鸟自传今。\n餐霞未惬招朋兴，捧日应悬报主心。\n却忆汝南吟弄意，羞将白发对残经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7541,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送虞少尹督饷南都兼之官衡邸","author":"尹台","text":"三年古县鸣琴治，千里长江转饷行。\n书剑不妨随客棹，烟花聊复憩仙城。\n邹裾岂惮王门曳，蔡屣谁当贤馆迎。\n悬想过家应岁晏，片帆应共北鸿征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7542,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壬申元日试笔","author":"尹台","text":"白首先朝旧侍臣，焚香北望拜枫宸。\n抗言屡及安危计，忧国曾忘宠辱身。\n九叶幸看昌圣历，三边况喜靖烟尘。\n论思未乏岩廊俊，歌咏宜归畎亩人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7543,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答刘敏卿文学","author":"尹台","text":"忆昔词垣忝近臣，六箴惭未献丹宸。\n敢期釐室移前席，虚拟探环是后身。\n老我欣欣依旧业，诸公衮衮抗清尘。\n枌榆社里閒相过，不羡东西南北人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7544,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿汤君六十","author":"尹台","text":"鬓发苍云入镜垂，计然心力未虚衰。\n人间六十桑悬日，海上三千桃熟时。\n员峤琪花含丽景，方塘锦荇媚寒姿。\n知君澹荡烟泉意，不向商岩问紫芝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7545,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送司训余君之官衡藩","author":"尹台","text":"江门旧钓沈烟水，绣枕金针岂度人。\n清庙朱弦堪叹汝，高车白壁易生尘。\n路经稷下衣冠集，车过湘中草木春。\n访学从谁一莞尔，临岐延望独伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7546,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甘挥使膺二台奖檄","author":"尹台","text":"淮镇初传走饷符，江台遽报奖贤书。\n云中魏尚才元赡，许下韩宏计或如。\n谋绩拟镌金虎券，转输不羡木牛车。\n新游衮衮绳前武，吾老菟裘望不虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7547,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送范宫允竣试还朝","author":"尹台","text":"锦帆高飐石城秋，千里长江湛碧流。\n旧识沂公怀素志，早同范老负先忧。\n抡才自出骊闲品，得士宁资狗监谋。\n况有微言裨启沃，应知忠志动宸旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7548,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送何宫允竣试还朝","author":"尹台","text":"大复闻孙擅楚材，久于超乘见龙媒。\n朅来霄汉甄多士，遂有星躔动上台。\n讲业定招沂上士，驱车还访沛中台。\n此行不负周南使，好遣风云入壮裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7549,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿许母夫人五十","author":"尹台","text":"寿宴初称鲁颂词，祥芬正韡窦庭枝。\n人间青鸟此应降，海上碧桃熟不迟。\n推荚定知陈易衍，注年端合叫仙期。\n谖花岁岁开堂北，长有春光媚晚姿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7550,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王岩潭太守以所刻诗访余读之有作","author":"尹台","text":"青龄北苑看花日，白发南宫对酒年。\n四纪神交空海岳，三山仙路杳云烟。\n新篇招侣丹霞外，旧句怀人碧草边。\n少壮英游今几在，不知谁为听朱弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7551,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏省中旧鹤诗","author":"尹台","text":"十年旧鹤喜余亲，奇格跄踉信少尘。\n秪忆江湖俦侣隔，漫怜霄汉羽毛新。\n虞罗蔽日虚施巧，仙路乘风不易驯。\n借问西池故鹓鹭，胡然茄下慕游鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7552,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿奉常石城许公七十","author":"尹台","text":"青袍北去看花日，赤绂南归赐杖年。\n共说抡魁违鼎鼐，却成平地作神仙。\n谢公行迹江东著，白傅风流洛下传。\n愧我旧垣叨再入，虚持寿咏拟朱弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7553,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三舍友有次象山兄弟旧韵见赠者语不无轩轾先贤意因次其韵复之并以谂之师泉翁","author":"尹台","text":"寂然元不着哀钦，万古谁窥天地心。\n地阔风鹏常大海，天空野鸟自高岑。\n支离学辨成丝密，易简功亏惧陆沈。\n却叹建临无二辙，鹅湖底事戾先今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7554,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有怀孙养吾旧友作","author":"尹台","text":"十年相见重相违，况对江亭风雪飞。\n病客久为长孺卧，怀人谁共子猷归。\n好鸣天上球琳佩，莫恋山中薜荔衣。\n春近鱼龙纷变化，未应雾豹隐寒晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7555,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送任光禄赴承天幕府","author":"尹台","text":"仙客春帆径楚波，帝陵佳气郁崇阿。\n郢中白雪逢知少，汉上彤云入望多。\n此日南冠聊鼓枻，他时北阙迟鸣珂。\n齐岩赵浦风流在，拥传休烦问钓蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7556,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五日命舟过游金山寺郡守林君追至遂开宴江天之阁移席观竞渡戏二首 其一","author":"尹台","text":"五十年中几去还，尘缨兹许濯江关。\n天开鹫境苍涛里，地出龙宫紫雾间。\n旧识高僧惊灭度，新成危阁漫跻攀。\n衰颜自照冷泉水，愧汝清湍白鸟间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7557,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五日命舟过游金山寺郡守林君追至遂开宴江天之阁移席观竞渡戏二首 其二","author":"尹台","text":"羽旆参差拥岸筵，水嬉对竞暮潮边。\n却怜鹤发挥杯日，犹记龙舟侍宴年。\n云水三天周梵界，风帆万里迅归船。\n追欢莫问前朝事，南北干戈化管弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7558,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴门别秦丁二贤","author":"尹台","text":"一樽远慰劳芳棹，千里相怀感故人。\n廊庙喜抛苍玉佩，江湖聊乞白纶巾。\n鸿才陆史终应达，龙性嵇生不易驯。\n此去翩然黄鹄迹，孤飞无复碍矰缗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7559,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲戌夏再过武林诸君招游西湖感兴二首 其一","author":"尹台","text":"一别西湖已廿年，旧游林壑异风烟。\n苏公堤上花存几，林逋宅前山自妍。\n半压荷湾犹舞袖，已残柳岸尚歌弦。\n兵戈忍使繁华破，今古清波漫画船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7560,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲戌夏再过武林诸君招游西湖感兴二首 其二","author":"尹台","text":"忆乘使传此经过，四十春风转绿荷。\n人世自更新宇搆，湖山不改旧岩阿。\n公孤祠院苍苔满，侯戚坟园紫蔓多。\n一笑共君成剧饮，平原曲沼竟如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7561,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西林八景 其一 太行分秀","author":"张永明","text":"壶关胜槩冠平阳，佳丽支分自太行。\n乔岳晖含山谷秀，馀芬映带水云乡。\n颙瞻梓里青螺远，翘望邻封翠黛长。\n羡尔归来吴郡牧，西林醉酒任徜徉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7562,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西林八景 其二 漳水合流","author":"张永明","text":"交漳上党水冲瀜，翠涨瀰漫落远空。\n分处源流同且异，合时泾渭异还同。\n横塘渔笛溪山外，隔岸鸥群烟雨中。\n珍重达人无底事，月明鼓枻笑春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7563,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西林八景 其三 佛岭摩云","author":"张永明","text":"层峦耸壑势千寻，中隐西方祇树林。\n甘雨已闻青甸足，晴霄又见白云深。\n岧峣仰止天边暗，缥缈平临涧底阴。\n佛力从来能变幻，谁云出岫本无心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7564,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西林八景 其四 鸾坡积翠","author":"张永明","text":"繁阴佳秀满林皋，翠积鸾坡入望劳。\n大块文章荣草树，阳春明媚现焄蒿。\n东风有意来芳境，游子无心折宝刀。\n到此便须为乐地，任教对景醉葡萄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7565,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西林八景 其五 药王胜会","author":"张永明","text":"庙貌森严尊俎悬，方春齐祷药王前。\n壶关士女声传呗，梵刹僧伽口吐莲。\n蜡炬煇煌焚宝篆，赢囊倾倒掷金钱。\n善因祗为来生结，迟看旋登兜率天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7566,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]