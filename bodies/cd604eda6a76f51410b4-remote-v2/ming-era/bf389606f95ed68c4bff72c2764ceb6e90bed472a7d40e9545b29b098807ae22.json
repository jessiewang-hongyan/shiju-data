[{"title":"寄林待用宪长三首 其二","author":"林光","text":"采采青荷盘，吸此中秋露。\n滴露入诗杯，离情不堪赋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51725,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄林待用宪长三首 其三","author":"林光","text":"池水涵清风，鱼儿散还聚。\n安得意中人，边池纵幽别。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51726,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬官林居鲁谢病归养来访平湖赋此赠别","author":"林光","text":"清秋归棹舣江浔，何事莼鲈忽上心。\n风雨花枝聊共惜，云霞杯酒向谁斟。\n行藏在我求无忝，道义如君契亦深。\n舞罢斑斓真自得，乾坤应不乏知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51727,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"静观亭奉饯屠元勋少大理","author":"林光","text":"搆亭新著静观名，别酒逢君两度倾。\n鱼鸟自循飞跃性，湖山应识滞留情。\n花知爱客偏含笑，蝉为催诗巧送声。\n醉墨淋漓吾合赋，汉徵廷尉岂徒行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51728,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送诸生往杭州时吴提学檄选诸生听讲三首 其一","author":"林光","text":"燕语莺啼又半年，金针绣手问谁传。\n扁舟试向西湖去，画本烟云别有天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51729,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送诸生往杭州时吴提学檄选诸生听讲三首 其二","author":"林光","text":"坠绪茫茫五百年，古人糟粕古来传。\n静观坐我池亭上，鱼跃鸢飞镜里天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51730,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送诸生往杭州时吴提学檄选诸生听讲三首 其三","author":"林光","text":"无言夫子教当年，不道无言是妙传。\n千古路头须问讯，浮云消尽见青天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51731,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"牡丹忽枯悴","author":"林光","text":"此地空苔砌，谁家绚早春。\n始知花富贵，亦厌我清贫。\n恩育乾坤大，荣枯梦幻频。\n岁寒松竹在，试为问花神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51732,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重九日三首 其一","author":"林光","text":"自笑官閒岁月忙，西风吹过七重阳。\n衰颜每愧逢佳节，黄菊何曾负此觞。\n乡思暗随飞雁远，诗怀清浸碧波光。\n春花又逐秋花发，造化凭谁作主张。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51733,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重九日三首 其二","author":"林光","text":"扰扰浮生空自忙，一杯谁不负重阳。\n芙蓉且莫嗔篱菊，琥珀从教泛羽觞。\n池水三珠含晚照，秋林一带弄晴光。\n天机眼底无穷妙，织就云霞锦数张。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51734,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重九日三首 其三","author":"林光","text":"云边飞雁去何忙，小剥重阴别有阳。\n谩把新诗催晚菊，笑携诸子引流觞。\n风回舞燕窥秋色，萍散游鱼戏日光。\n坐我閒亭无一语，歌人何处忽声张。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51735,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"何子完来访平湖用白沙封子完庐墓卷韵赠别","author":"林光","text":"七年弄影笑何功，握手逢君又孟冬。\n诗味直从江浦醉，墨痕须固玉台封。\n休疑美玉栖顽璞，几见繁花舞乱风。\n坐我池亭看镜水，白云何处觅高峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51736,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"承柳郡侯檄请修郡志过庆嘉亭赋此辞谢二首 其一","author":"林光","text":"强随郡檄走嘉兴，外史才华本未能。\n文献一邦公合主，是非千载我何凭。\n昌黎史札还堪信，柳子龙门岂易登。\n多少镇嘉山上景，许携冬酒醉瞢腾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51737,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"承柳郡侯檄请修郡志过庆嘉亭赋此辞谢二首 其二","author":"林光","text":"转盼人间几废兴，惟将故纸别贤能。\n乾坤直笔应难秉，当贵浮云未足凭。\n槜李风光深此会，庆嘉亭子幸容登。\n砚池几欲挥风雨，满壁蛟龙任舞腾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51738,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镇嘉山 其一","author":"林光","text":"五老攒庐阜，三洲隐薜萝。\n云霞深晚树，径路入青莎。\n异兽雄如斗，群仙舞欲歌。\n人间天上景，会意岂须多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51739,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镇嘉山 其二","author":"林光","text":"迟迟醒醉眼，稍稍傍烟萝。\n曝背看拳石，开樽藉短莎。\n崆峒人到少，松桧鸟长歌。\n杯酒忘宾主，悠然得亦多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51740,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观山四首 其一","author":"林光","text":"山在烟霞景在诗，神施鬼设可胜奇。\n蓬莱飞落宫墙内，祇恐人间也未知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51741,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观山四首 其二","author":"林光","text":"拨破红尘透此关，天机落在片言间。\n也知虚费閒心力，争似抬头一看山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51742,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观山四首 其三","author":"林光","text":"宛转虚岸纵步时，一回着目一沈思。\n阿谁解领吾人意，却有黄花在短篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51743,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观山四首 其四","author":"林光","text":"冥鸿声落海天微，何事鹪鹩恋一枝。\n昨夜寒霜催落叶，看山吾且一题诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51744,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题石棋盘","author":"林光","text":"人间胜负几盘棋，袖手旁观着每迟。\n留得石枰方一片，不安棋子也相宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51745,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛鸳鸯湖二首 其一","author":"林光","text":"童冠相随弄碧漪，玻璃十顷画船移。\n那知今日鸳湖水，亦与吾人作酒卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51746,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛鸳鸯湖二首 其二","author":"林光","text":"爱人冬日暖如春，凫雁相忘镜水滨。\n细浪轻风催晚醉，中流一笑任吾真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51747,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书杨藩宗郡侯事","author":"林光","text":"走卒儿童口是碑，六书吾岂厌烦辞。\n翻疑槜李多豪杰，尚欠杨公血食祠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51748,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嘉兴郡斋与冯宪副兰柳郡侯琰小酌联句三首 其一","author":"林光","text":"老眼苍茫醉欲花，海东高士忽临嘉。\n云深晚雨催长句，日远骚坛愧大家。\n墙角倚寒梅正萼，樽前留赋脸初霞。\n分明坐我春风里，此意何妨日易斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51749,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嘉兴郡斋与冯宪副兰柳郡侯琰小酌联句三首 其二","author":"林光","text":"雪意漫空欲散花，山园松桧可胜嘉。\n高风合著滁州守，美句犹传杜老家。\n真率杯中深夜话，风流胸次淡秋霞。\n乡书忽度湖天雁，嘹唳冲寒几字斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51750,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嘉兴郡斋与冯宪副兰柳郡侯琰小酌联句三首 其三","author":"林光","text":"夜雨松窗对烛花，便无山水亦情嘉。\n疏才此地惭为郡，老句如公是作家。\n再咏凫翳从岁晚，独抛尘土卧烟霞。\n升沈已破浮生梦，一榻寒歌瘦竹斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51751,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"一柳双莺与冯柳二公联句","author":"林光","text":"柳州堂上画图新，摩诘诗中为写真。\n老眼暂看心欲醉，高怀相对咏何频。\n想当落笔风情别，幸得开樽物意春。\n烟雨十枝初入柳，江天双鸟最宜人。\n偶来并坐空矰弋，忽著高飞远俗尘。\n淑气谩催回百啭，閒情容与转相亲。\n碧云声落千门晓，别墅巢深万树匀。\n淡墨依稀何处得，李生往事与谁陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51752,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郡斋夜坐与冯柳工公联句有怀屠少卿","author":"林光","text":"青霄一别动经年，诗卷犹传旧咏篇。\n共拨红炉看醉墨，坐销孤独费吟笺。\n江湖风雪怀人远，歧路音书别思悬。\n春意省中千柳直，梦回阙下五云连。\n法星此夜昭河汉，驷马他年耀市廛。\n伐木再歌秋鬓短，停云独立越江偏。\n涓埃无补惭予老，鼎鼐能调羡子贤。\n何处风光还握手，几人恩宠似登仙。\n未逢驿使梅孤发，应念亲庭草自妍。\n南极未应虚梦想，白头长见彩衣翩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51753,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒陆宣公祠有感","author":"林光","text":"尘埃不放庙门扃，唐相忠魂恐未宁。\n孤月此心应自照，空阶碧草为谁青。\n经纶一代须王佐，艰阻千年仰景星。\n莫道障魔消未尽，祠前今复餂延龄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51754,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠萧天章还荆州","author":"林光","text":"短轴淋漓洒墨香，春风一笑问萧郎。\n莺花尽日催人醉，客子扁舟底事忙。\n眼界东来吴海阔，梦魂西绕楚江长。\n行边莫厌归装薄，也有吾诗在锦囊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51755,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访当湖书屋","author":"林光","text":"小结当湖屋数椽，肩舆一扣水云边。\n园林花卉开天趣，伯仲书声韵管弦。\n旋罩溪鱼供晚酌，坐看湖艇破秋烟。\n深怀取次占巢鹊，扶醉归来踏夜船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51756,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将游陈山三首 其一","author":"林光","text":"八载官垂满，三春花又深。\n人偏多系累，天未定晴阴。\n越海频飞梦，龙湫拟洗心。\n传诗订佳侣，谁谓少知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51757,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将游陈山三首 其二","author":"林光","text":"逸少谈岷岭，平生负一游。\n东吴山更少，我辈愿何酬。\n僻地栖成懒，馀生习易浮。\n古今言脱屣，谁复步瀛洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51758,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将游陈山三首 其三","author":"林光","text":"看山劳作梦，细雨果今晨。\n诗思空泉涌，狂心自鸟驯。\n盘蛇先洗石，龙母信通神。\n暗惜繁花落，春光过七分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51759,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"承庄定山先生垂访平湖喜而有作","author":"林光","text":"新水湖天注活流，欢迎千里访医舟。\n江山风韵诗全别，骨肉斯文话素投。\n喜洽禽鱼俱欲舞，情亲花木也扳留。\n从来乐地因人胜，一景须君一喝酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51760,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画","author":"林光","text":"涧水清何极，山云本自深。\n苑亭终日坐，谁识此翁心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51761,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵定山游南寺","author":"林光","text":"老树交加荫小舟，数声啼鸟寺门幽。\n湖山此日无穷意，都付先生一倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51762,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题藏有源静学卷","author":"林光","text":"鸢鱼在在领天机，恍惚虚亭独坐时。\n何处湖山真托迹，晚风凉□□□□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51763,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"定山来访再赠","author":"林光","text":"倚棹飘然退急流，真成天地一虚舟。\n春风满座人何厌，元酒开樽辖再投。\n花鸟共催诸子醉，湖山增重几诗留。\n荷衣舞烂梧桐叶，八载东吴愿始酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51764,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"静观亭次定山韵三首 其一","author":"林光","text":"地僻人来少，春回花自深。\n风光拈不尽，一物一天心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51765,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"静观亭次定山韵三首 其二","author":"林光","text":"岸帻虚亭晚，林风一洒然。\n微酡诗懒赋，寂寞对湖天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51766,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"静观亭次定山韵三首 其三","author":"林光","text":"水月来相照，双眸老更清。\n人间无限事，吾且坐吾亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51767,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赏牡丹","author":"林光","text":"春风何处不繁华，宦况萧条愧此花。\n暖日烘来娇欲语，淡烟霏处醉笼纱。\n生成只见天机妙，吟赏翻疑酒量加。\n诸老洛阳题品后，风光今日又谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51768,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡江二首 其一","author":"林光","text":"潮声汹涌傍山眉，万里江流海吸之。\n两眼未谙风节候，片帆低挂日中时。\n云藏瓜步偏疑画，景会金山忽有诗。\n衡鉴斯文能不愧，天机地轴果谁知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51769,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡江二首 其二","author":"林光","text":"八字金焦豁两眉，江中风景尽归之。\n寻常过往知如今，饱饫游观是几时。\n老去一官催白发，兴来千首欲留诗。\n蒲帆小趁南薰力，明日阴晴未可知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51770,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登高邮湖","author":"林光","text":"晨风淡淡抹湖波，水色天光一镜磨。\n细柳菰蒲村客远，数声何处采莲歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51771,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝应湖","author":"林光","text":"微茫新水涨洪波，南北行人感慨多。\n何似西湖风景好，近山青拥数堆螺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51772,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游清河经黄河感而有作四首 其一","author":"林光","text":"黄河之水入清河，滚滚浑成一样波。\n评注水经推陆羽，试分清浊果谁多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51773,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游清河经黄河感而有作四首 其二","author":"林光","text":"云帆一片驾长波，茱黍村庄瞥眼过。\n回首夕阳添泪咏，清河今已混黄河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51774,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游清河经黄河感而有作四首 其三","author":"林光","text":"中天一派淡无波，海渎精华耿此过。\n为报寻源高着眼，天河元不是黄河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51775,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游清河经黄河感而有作四首 其四","author":"林光","text":"欲张吾网向流河，定有遗珠在碧波。\n鼓枻中流情不浅，水云风景晚来多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51776,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"经白洋河二首 其一","author":"林光","text":"浮生踪迹笑奔波，百岁升沈梦里过。\n凝望郊原意无限，晚风吟过白洋河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51777,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"经白洋河二首 其二","author":"林光","text":"长牵直北溯漕河，柳色青青蘸碧波。\n淮酒尚堪供一醉，葛巾斜日定风多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51778,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中苦热","author":"林光","text":"两耳何堪近俗哗，急流牵溯几湾斜。\n孤舟亭午蒸炎暑，崩岸回风落细沙。\n堤柳浓阴空著日，星河深夜忆浮槎。\n琼浆满口浇诗渴，谢得邳州一片瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51779,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沙河道中","author":"林光","text":"青衫何日浣黄埃，老眼于今又北开。\n两脚忽从天际起，山光仍傍马前来。\n乱蝉高柳临官道，古冢残碑枕土坏。\n返照扬鞭意无限，暂投村店泻磁杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51780,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伏中由沙河舍舟而陆三日至开河","author":"林光","text":"水云三伏正煎熬，暑汗沾裳不谢劳。\n驿路驱驰疲仆马，闸河开闭任官豪。\n临棋祇恐迷当局，袖手还输不著高。\n未识新蝉意何谓，绿杨阴里日呼号。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51781,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漕运兵三首 其一","author":"林光","text":"闸河初放鼓田田，辛苦挨帮拽几船。\n惟愿漕渠春水满，任官来索赛神钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51782,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漕运兵三首 其二","author":"林光","text":"年年休叹往来频，屈指深冬又早春。\n惨目寒肤归未得，三边犹有枕戈人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51783,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漕运兵三首 其三","author":"林光","text":"风尘飞捲酒旗轻，尽日惟闻打号声。\n自顾无钱堪买酒，夜凉交枕月华明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51784,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"连窝舟中偶述四首 其一","author":"林光","text":"扁舟如箭下中流，何处风烟更可留。\n诗思乱撩官柳色，橹声摇碎闸河秋。\n湖山有梦回青眼，岁月无情易白头。\n北往南来觑未破，人间富贵是云浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51785,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"连窝舟中偶述四首 其二","author":"林光","text":"韶光去我疾如流，费尽诗辞莫挽留。\n袍葛未离三伏暑，雁声遥送一天秋。\n还凭白月开心曲，懒把焦桐上指头。\n惨目风烟醒复醉，铁桥高步忆罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51786,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"连窝舟中偶述四首 其三","author":"林光","text":"推移何日到安流，笑把新题处处留。\n舒卷未谙周卦画，支离空抱鲁春秋。\n閒将醉墨开醒眼，宽着乌纱裹白头。\n泡沫风灯容顾惜，此身天地任沈浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51787,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"连窝舟中偶述四首 其四","author":"林光","text":"慈闱飞梦泪交流，苦被微官久绊留。\n玉食谁为天下计，斯文聊寄眼中秋。\n黄花准拟供南酒，白发相将遍黑头。\n半醉半醒吾欲赋，柳风吹动野烟浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51788,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铜鼓二首 其一","author":"林光","text":"铜鼓鼕鼕聒耳频，世机纷扰正愁人。\n官夫又拨民夫辏，剥尽衣衫哭水滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51789,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铜鼓二首 其二","author":"林光","text":"铜鼓扶胥旧饱闻，数声催转海门春。\n闸河处处闻铜鼓，愁杀夫差忍饿人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51790,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"京口","author":"林光","text":"羞傍双眉著片纱，鞭羸无计避尘沙。\n秋风渐扫人间暑，老眼徐看帝里花。\n山水周遭留玉气，楼台缥缈出烟霞。\n观光我有无穷意，且放幪头破帽斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51791,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寓京兆北堂将赴试院用旧韵呈诸同事四首 其一","author":"林光","text":"不为斯文浪皱眉，鉴空毫发莫欺之。\n谁从混沌开端倪，颇学支离到此时。\n风雅未回中古制，仆臣羞对晚唐诗。\n诸君道眼相料理，何事还堪答所知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51792,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]