201,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与陈隆之太史侨寓广陵比园庐者累日临别赠余六绝用此见答 其六","author":"陈吾德","text":"酒尽离亭玉露秋，风前赠我双吴钩。\n飘然携入空山里，魑魅逢人迥自愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14202,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隆之生女赋赠二首 其一","author":"陈吾德","text":"昨夜欢声满玉堂，争言宝婺下祥光。\n卢家祇谓添丁喜，未识传书是女郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14203,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隆之生女赋赠二首 其二","author":"陈吾德","text":"喜来辄复醉霞觞，羡尔明珠掌上光。\n庭内封胡多玉树，不知人世有王郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14204,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"安义道中闻何老人道前令林君惠政以不善事上官而去有感书屋壁 其一","author":"陈吾德","text":"经过茂宰鸣琴地，忽忆孤山一鹤飞。\n候馆棠阴聊系马，居人指点欲沾衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14205,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"安义道中闻何老人道前令林君惠政以不善事上官而去有感书屋壁 其二","author":"陈吾德","text":"陶令归来五柳长，至今麦穗尚成行。\n郊原日夕驱车马，谁见伊优祇在堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14206,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"近午发舟","author":"陈吾德","text":"舟发鄱阳快稳流，一程行色淡于秋。\n叮咛莫漫标文旆，恐为江湖消浪游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv"