[{"title":"和少陵六绝 其一","author":"林俊","text":"画虎心多愧未成，老来空有气从衡。\n松根一枕羲皇梦，如盖山云石上生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13763,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和少陵六绝 其二","author":"林俊","text":"四愁汉调犹平子，嗣响郦炎格已休。\n阅尽盆渠都是水，何曾日夜大江流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13764,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和少陵六绝 其三","author":"林俊","text":"虞歌有派传风雅，汉选何名续楚骚。\n嵇阮嗣音副人意，也难蓦地拜刘曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13765,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和少陵六绝 其四","author":"林俊","text":"汉魏名家几世人，调孤无力附芳邻。\n残编断楮谁收拾，已化荒荒架上尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13766,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和少陵六绝 其五","author":"林俊","text":"九首枚生信复疑，格中何必问吾谁。\n正声变尽愁无拙，前辈终为后辈师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13767,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和少陵六绝 其六","author":"林俊","text":"陶谢风流秪两公，后来韦柳亦相雄。\n极知作者关名教，不混王杨谫薄中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13768,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"云寄失足几堕 其一","author":"林俊","text":"老难筋力出应稀，蒙密青冈取径微。\n石洞云閒喜人迹，故教藤刺强留衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13769,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"云寄失足几堕 其二","author":"林俊","text":"云寄登登续往盟，苍苔路滑几危坑。\n山人老分天还铸，起傍独高峰处行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13770,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哈密城","author":"陈诚","text":"此地何由见此城，伊州哈密竟谁名？\n荒村漠漠连天阔，众木欣欣向日荣。\n灵凤景星争快睹，壶浆箪食笑相迎。\n圣恩广阔沾遐尔，夷貊熙熙乐太平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13771,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哈密火州城","author":"陈诚","text":"高昌旧治月氏西，城郭萧条市肆稀。\n遗迹尚存唐制度，居人争睹汉宫仪。\n梵宫零落留金像，神道荒凉卧石碑。\n征马不知风土异，隔花犹自向人嘶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13772,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"肃州八景 其一 南山积雪","author":"戴弁","text":"酒泉城外碧云端，万叠芙蓉雪未干。\n素影欲迷银汉迥，晴光不逐暖风残。\n气吞沙漠千山远，势压番戎六月寒。\n公馆日长清似水，几回吟望倚栏杆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13773,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"肃州八景 其二 北陌平沙","author":"戴弁","text":"北上高楼接大荒，塞原如掌思茫茫。\n朔风怒卷黄如雾，夜月轻笼淡似霜。\n弱水西流青海远，将台南去黑山长。\n远人遥指斜阳外，蔓草含烟古战场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13774,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"肃州八景 其三 玉关来远","author":"戴弁","text":"圣代文明遍九垓，河山设险玉门开。\n月明虏使闻鸡度，雪霁番王贡马来。\n泛泛仙槎浮瀚海，翩翩驿骑上金台。\n幸逢四海为家日，独坐藩垣愧乏才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13775,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"肃州八景 其四 嘉峪晴烟","author":"戴弁","text":"烟笼嘉峪碧岧峣，影拂昆仑万里遥。\n暖气常浮春不老，寒光欲散雪初消。\n雨收远岫和云湿，风度疏林带雾飘。\n最是晚来闲望处，夕阳山外锁山腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13776,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"防秋登嘉峪楼纪事 其一","author":"陈其学","text":"铁骑行边倚佩刀，西风历历几亭皋。\n孤城斗着黄云脊，万堞斜连白雪尻。\n属国书通传旧县，磨崖剑气定谁曹。\n一声肠断梅花引，隐几侵寻早二毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13777,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"防秋登嘉峪楼纪事 其二","author":"陈其学","text":"紫峪横霄客路穷，壮怀长啸对秋蓬。\n风翻云海寒烟外，雪涨天山夕照中。\n回纥叩关先贡马，牙蛮隔塞未归鸿。\n伊州歌遍黄花戍，草色离离故垒空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13778,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"防秋登嘉峪楼纪事 其三","author":"陈其学","text":"苍茫西海有无间，多病书生愧抱关。\n日暮倚楼风万里，天涯弹铗月千山。\n驼鸣玉垒移封旧，雁带金城振旅还。\n守捉滩头递刁斗，独吟秋色水潺潺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13779,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"嘉峪关漫记","author":"徐养量","text":"揽辔酒泉西，纵横千骑列。\n朝旭丽飞旌，凯风壮长戟。\n行行招玉门，迢迢扼沙碛。\n红泉襟其南，黑水障塞北。\n五月沟草黄，一带石烟白。\n屹然华夷防，洵自鸿蒙辟。\n右臂断匈奴，越裳献重译。\n霜骏宴昆丘，天马来西极。\n遐略侈前闻，雄图载往册。\n神祖耀皇威，列圣扬武烈。\n迩年事荡除，万里烽尘息。\n东疆拓大松，西堠斥邛僰。\n端拱望垂衣，师边而臣力。\n远人慕化来，款关无虚夕。\n简阅对王庥，舞干有苗格。\n王者守四夷，天险亦空设。\n班生掷柔翰，所志在竹帛。\n执讯俘尉犁，臣服尽姑墨。\n从此入版图，五十余属国。\n穷黩罢轮台，无宁夸汉德。\n惠中绥万方，文教广四讫。\n咨诹嗟靡遑，聊为勒良石。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13780,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咸阳谒周文王武王陵有感","author":"张经","text":"文武由来几千载，园陵郁郁南山对。\n祀典频年石碣开，神功圣德昭如在。\n秦时寝殿空巍峨。\n极目萧条青草多。\n汉代诸陵谁复辨，离离禾黍秋风过。\n自昔豪华尽黄土。\n旂常独重周文武。\n伯气雄图久寂寥，丕承丕显垂终古。\n炎天使节走红尘，展拜焚香输寸诚。\n落日伤心数丘陇，东流清渭只无情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13781,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咸阳谒周陵","author":"王尚絅","text":"成康列昭穆，文武故累累。\n狐邱尚父墓，毕陌周公祠。\n显承沈谟烈，齐鲁荒周诗。\n耕犁偪隧道，率土阿邦时。\n傍有汉唐冢，邻人芒未知。\n往古讵胜叹，寒风鸣树枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13782,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过麟游箭括岭诗并序","author":"胡松","text":"平生我亦浩然徒，踏雪冲寒笑腐儒。\n惟乏官梅动诗兴，赖有村酿堪时沽。\n灞桥柳雪扑满面，辋川胜亭今焉无。\n安得与之同述作，倩渠长笔挥为图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13783,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"阅边宿瞿昙寺用杨廷俞贰守韵二首 其一","author":"蒲秉权","text":"香刹庄严甲鄯州，湟西净土此堪游。\n烟笼宝篆蟠蝌蚪，风动幡幢醒钵虬。\n贝叶朝翻云满阁，部笳宵吹月当楼。\n好将一滴杨枝水，洒濯边尘慰杞忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13784,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"阅边宿瞿昙寺用杨廷俞贰守韵二首 其二","author":"蒲秉权","text":"宰官身现也奚惭，来證如如半偈谭。\n伎俩凭教山鬼弄，禅机宁堕野狐参。\n沙门谁度众生苦，塞徼吾同士卒甘。\n偶坐蒲团尘虑息，白毫一道灿优昙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13785,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题积石","author":"张涣","text":"天上黄河天际通，凿山原有此山头。\n两崖丹峭千寻壁，一带横看万里流。\n昼夜风雷恣喷薄，古今日月与沉浮。\n追游漫有穷源兴，欲向昆仑问十洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13786,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日西征答张以元使君","author":"周国卿","text":"西原秋欲暮，萝月此同明。\n问俗驰周道，观兵引汉旌。\n古寺斜通涧，睛山巧傍城。\n重阳逢马上，惭负菊华荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13787,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠天竺比邱梵名娑羯延主北禅古刹十六韵","author":"龙膺","text":"世阅三千外，程逾十万强。\n须弥经日月，沙界饱风霜。\n崭崄攀猱狖，岩穷狎虎狼。\n佩镰炊石火，洗钵漱冰浆。\n赤脚寒无著，华颠岁亦忘。\n芜菁烹作糁，毡罽绩为裳。\n吹角驱魔鬼，持珠诵法王。\n唐音通呗咒，胡语省迎将。\n细齿如童龀，庞眉自老苍。\n娑婆同印度，膻浊混氐羌。\n二伴来殊域，三生话旧邦。\n黧皮俱瘦肋，绀目并凹眶。\n合掌跏趺惯，垂腰辫发长。\n慈悲无怨爱，解脱得清凉。\n为说宰官法，偕登选佛场。\n北禅金布地，卓锡待支郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13788,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湟中纪事","author":"刘敏宽","text":"亲提义旅虎台西，夜向荒祠藉草栖。\n秉烛措筹劳待旦，雄心起舞陋闻鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13789,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜登镇远楼作","author":"赵载","text":"边城屹屹拂云端，塞草荒凉玉宇寒。\n九曲星河天欲曙，三通鼓角夜将阑。\n虚涵万象明蟾迥，斜挂层峰列宿团。\n四望遥连浑似水，玉门辉映有无看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13790,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题镇远楼","author":"赵锦","text":"筹边雄镇有高楼，幸际唐虞日月秋。\n部落三千依积石，藩篱百二壮雍州。\n龙沙贡使连翩至，青海耕夫汗漫游。\n眼底天戈平丑类，五云深处拱宸旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13791,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"马蹄寺","author":"朱维均","text":"古刹层层出上方，云梯石磴步回长。\n金身宝相莲开座，玉梵清音月近床。\n茶沸烟腾禅出定，花飞泉落水流香。\n逢僧共说无生话，回首尘劳意自忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13792,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"复过川","author":"陈诚","text":"世事应如梦，胡川又复过。\n古今陈迹少，高下断崖多。\n识路寻遗骨，占风验老驼。\n夷人称瀚海，平地有烟波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13793,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山焰山","author":"陈诚","text":"一片青烟一片红，炎炎气焰欲烧空。\n春光未半浑如夏，谁道西方有祝融。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13794,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"流沙河","author":"陈诚","text":"桃李花开日载阳，流沙河浅水如汤。\n无端昨夜西风急，尽捲波涛上小岗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13795,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"至撒马儿罕国主兀鲁百果园四首 其一","author":"陈诚","text":"巍巍金壁瓮高台，窗户玲珑八面开。\n阵阵皇风吹箫幕，飘飘爽气自天来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13796,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"至撒马儿罕国主兀鲁百果园四首 其二","author":"陈诚","text":"加趺坐地受朝参，贵贱相逢道撒蓝。\n不解低头施揖让，谁知屈膝拜三三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13797,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"至撒马儿罕国主兀鲁百果园四首 其三","author":"陈诚","text":"饭炊云子邑相兼，不用匙翻手自拈。\n汉使岂徒营口腹，肯教点染玉纤纤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13798,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"至撒马儿罕国主兀鲁百果园四首 其四","author":"陈诚","text":"金鞍骏马玉雕裘，宝带珠缨锦臂鞲。\n身外不知天壤阔，妄将富贵等王侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13799,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"土尔番城","author":"陈诚","text":"路出榆关几十程，诏书今到土番城。\n九重雨露沾夷狄，一统山河属大明。\n天上遥瞻黄道日，人间近识少微星。\n姓名不勒阴山石，愿积微勋照汗青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13800,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"崖儿城","author":"陈诚","text":"沙河二水交流中，天设危城水上头。\n断壁悬崖多险要，荒台废址几春秋。\n羌儿走马应辞苦，胡女逢人不解羞。\n使节直从西域去，岸花堤草莫相留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13801,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鲁陈城","author":"陈诚","text":"楚水秦川过几重，柳中城里遇春风。\n花凝红杏胭脂浅，酒压葡萄琥珀浓。\n古塞老山晴见雪，孤村僧舍暮闻钟。\n羌酋举首遵声教，万国车书一大同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13802,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陈员外子鲁奉使西域","author":"胡若思","text":"旌旆西征逸气雄，玉关春早听归鸿。\n紫驼夜度交河月，骢马晨嘶瀚海风。\n黄沙古碛行行见，白草寒云处处同。\n莫言万国昆仑外，总在皇仁覆育中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13803,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陈员外使西域诗","author":"周孟简","text":"金台八月惊寒早，一夜清霜零白草。\n故人别我出都门，西风万里交河道。\n怜君草莽一书生，曾是高皇知姓名。\n挥毫每视金銮草，乘传屡入南交城。\n只今又作凤池客，天语传宣到蕃国。\n郎官不减旧声华，圣主非常赐颜色。\n新赐貂裘不惮寒，壮游谁道别离难。\n流沙只合吟边度，葱岭惟应马上看。\n看山对景多行乐，张骞伟绩今犹昨。\n圣主当图绝漠功，丹青好画麒麟阁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13804,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梁州序 戊寅腊月予幸七十初度同年王守溪少傅寄梁州序为寿依韵奉答","author":"谢迁","text":"茫茫江海，悠悠昏旦，叹惜年光易换。\n迷途世故，从来百样千般。\n眼底翻云覆雨，狂浪颓波，天也那能管。\n白云堆稳，也与公眠。\n吴越相望两地仙，传雅调正家宴便。\n当筵高咏愁怀散，赓一阕，赛强健。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13805,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梁州序 守溪明年亦七十中秋后二日其初度也仍用前调一阕寄寿","author":"谢迁","text":"中秋前夕，今辰初度，万里清光快睹。\n香生丛桂，广寒真境清虚。\n但见斗牛相映，奎璧联辉，元是文章府。\n洞庭深处，好胜蓬壶。\n青雀西来蚤寄书，王母降，玉娥舞。\n笑鹤南飞吾来暮，遥祝赞，寿彭祖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13806,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过彭城驿哭恒孙二首 其一","author":"谢迁","text":"忆昔过彭城，吾孙祸独婴。\n仓皇埋旅榇，呜咽赴严程。\n骨肉久应化，星霜倏屡更。\n伤心此停棹，老泪强吞声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13807,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过彭城驿哭恒孙二首 其二","author":"谢迁","text":"野寺邻荒驿，孤坟出短垣。\n老怀难割爱，旧鬼亦烦冤。\n岁晚乡心迫，天高泪眼昏。\n哀歌不成调，为尔一招魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13808,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭母舅二首 其一","author":"谢迁","text":"诸舅惟公在，清强步履便。\n承颜如见母，抱恨又终天。\n白鹤归何处，青山入暮年。\n伤心谁共语，涕泪独潸然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13809,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭母舅二首 其二","author":"谢迁","text":"陟屺已无地，私情尚渭阳。\n十年违杖履，两鬓各星霜。\n寿算期方远，仙游别遽长。\n西风撼秋木，悽断老乌肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13810,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鲳鱼馈雪湖辱诗见贶依韵奉答","author":"谢迁","text":"宾馆无鱼日，冯欢叹孟尝。\n渊临输结网，芹献侑称觞。\n乡社新诗卷，烟波旧钓航。\n海鲜甘住久，筌在敢相忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13811,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汪进之通判重庆堂次李西涯韵","author":"谢迁","text":"乡评推世德，家庆擅华名。\n桂籍方钟秀，兰阶剩茁萌。\n禄分三釜足，官喜一身轻。\n犹忆班衣后，趋随进寿觥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13812,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和雪湖冬菊一首","author":"谢迁","text":"寒径馀香满，疏帘倒影高。\n诗狂仍落帽，酒债拟偿袍。\n第品增新谱，餐英按古骚。\n同心不同赏，望眼为君劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13813,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"素笺馈雪湖辱诗来谢次韵答之","author":"谢迁","text":"华篇酬素楮，使至一舒眉。\n误此琼瑶报，惭非玉屑姿。\n粗疏承用乏，雅澹慰心知。\n聊伴中书老，清风旧凤池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13814,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪湖诗谢谷种次韵二首奉答 其一","author":"谢迁","text":"歉岁仅存种，先春蚤力菑。\n归耕雅同志，敷播合乘时。\n今雨应非昔，公田遂及私。\n秋成倘如愿，再续屡丰诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13815,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪湖诗谢谷种次韵二首奉答 其二","author":"谢迁","text":"取盈伤往岁，作苦念荒菑。\n乡井通吾力，镃基待此时。\n嘉禾原有种，大造本无私。\n饱饭西成日，从公细和诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13816,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和雪湖屏迹二首 其一","author":"谢迁","text":"林皋聊寄迹，瀛海久忘情。\n却老方频检，耽诗癖已成。\n晴山双屐稳，烟水一舟轻。\n日上眠犹熟，心閒梦亦清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13817,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和雪湖屏迹二首 其二","author":"谢迁","text":"谷口藤萝密，云间碓硙幽。\n萍开喜鱼跃，花褪怪莺流。\n自与青山约，谁因白发愁。\n閒身习成懒，君莫笑科头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13818,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"恭和御制除夕诗韵","author":"谢迁","text":"宇宙三阳泰，衣冠万国来。\n皇图真永固，圣德厚加培。\n丽日无私炤，明廷足俊才。\n老臣惭朽拙，遭遇亦奇哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13819,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和除夕诗","author":"谢迁","text":"大道今犹昔，青阳往复来。\n八荒归至治，万汇赖深培。\n天启重熙运，川惭巨济才。\n交修佩明训，寤寐敢忘哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13820,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和罗峰先生新春诗二首 其一","author":"谢迁","text":"太簇初回律，明堂恰祀春。\n微风来淑气，光霰浥轻尘。\n惠泽行多庆，丰占信有神。\n闾阎歌颂满，圣德与时新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13821,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和罗峰先生新春诗二首 其二","author":"谢迁","text":"生菜堆盘细，新醅溢瓮香。\n迎春先凤沼，退食总羔羊。\n宣赐真殊宠，官寮合对尝。\n素餐惭莫报，醉饱热中肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13822,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和罗峰郊坛韵","author":"谢迁","text":"圆丘分献爵，平步上天梯。\n野阔旌旗拥，坛高象纬低。\n尘埃九陌净，干羽两阶齐。\n礼毕候回辇，虚窗听曙鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13823,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"暮宿扳罾渡口","author":"谢迁","text":"水涸舟易胶，舟人时复喧。\n暮阻沙岸侧，野旷地亦偏。\n问津尚云远，西日已含山。\n寒林北风急，飞鸟尽来还。\n泊舟悔不蚤，兀坐默无言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13824,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"慈节为朱彦明乃堂作","author":"谢迁","text":"苦节良独难，慈训尤不易。\n有儿归义方，庶矣柏舟誓。\n百年未亡身，祗为家门讣。\n于今幸两全，辛苦遂初志。\n他年泉台路，良人见无愧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13825,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蚤过山庄避暑用陶韵","author":"谢迁","text":"侵晨理孤棹，山居将避喧。\n好风忽南来，吹我乌帽偏。\n宿鹭未移渚，落月犹在山。\n候门两稚子，问我何时还。\n高山与流水，此意向谁言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13826,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]