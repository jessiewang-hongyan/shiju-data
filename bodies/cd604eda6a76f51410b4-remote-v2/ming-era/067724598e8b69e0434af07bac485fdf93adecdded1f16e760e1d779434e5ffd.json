[{"title":"送游方僧","author":"徐熥","text":"春风初动雪初晴，锡杖今朝出化城。\n万里云天孤鹤影，满林烟树乱莺声。\n禅心客路随流水，古院荒山闭月明。\n自是空门无定迹，河桥此别漫关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23323,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜送客","author":"徐熥","text":"秋至关河木叶乾，送君西去路漫漫。\n潮喧古渡猿啼隐，露下空江雁影寒。\n数点渔灯归浦远，一声僧磬出林残。\n片帆渺渺知何处，后夜相思独倚栏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23324,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金山寺别恩上人","author":"徐熥","text":"忽闻钟韵出林微，话别空门思欲飞。\n日暮西风吹客棹，夜深凉月梦僧衣。\n芜城岁晚芦花尽，瓜步秋高木叶稀。\n从此分携各南北，更于何处问禅机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23325,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"炀帝行宫 其一","author":"徐熥","text":"满目繁华一夕空，至今行客说离宫。\n垂杨旧见朱旗绕，芳草曾经翠辇通。\n商女歌残花落后，妖姬魂散月明中。\n可怜淮水龙舟戏，听得江南曲未终。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23326,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"炀帝行宫 其二","author":"徐熥","text":"废殿荒凉噪暮鸦，广陵潮满夕阳斜。\n一从凤辇归黄土，无复龙舟驻翠华。\n春尽冷烟生蔓草，夜深明月照璚花。\n当时复道今何处，半属芜城百姓家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23327,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中登富春山","author":"徐熥","text":"群山万壑白嶙峋，雪里移舟问富春。\n诸将汉家依日月，故人天上动星辰。\n千年宿草埋钟鼎，七里寒烟护钓纶。\n最羡羊裘堪傲世，青袍愁染洛阳尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23328,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"姑苏怀古","author":"徐熥","text":"秋风吹送木兰桡，无那愁心逐暮潮。\n响屧廊中歌舞散，姑苏台上鹿麋骄。\n东吴霸气今俱尽，西子香魂不可招。\n半夜乌啼钟欲动，无情明月照枫桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23329,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兰陵道中寄同社","author":"徐熥","text":"木落孤城岁易阑，征途何日到长安。\n匣中宝剑霜花冷，客里金尊竹叶残。\n两浙名山方驻马，七闽诸子正登坛。\n忽闻白苧歌声起，欲倩西风寄泽兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23330,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"经黄河寄怀陈平夫","author":"徐熥","text":"隔岸惊闻伐木歌，橹声摇月下黄河。\n六溪昼静枯桐冷，三径春深芳草多。\n满路繁霜凋客鬓，半江寒雨梦渔蓑。\n思君不奈风尘远，夜夜愁心逐逝波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23331,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"易水道中答谢在杭","author":"徐熥","text":"翩翩击筑共游燕，慷慨行歌易水边。\n九曲河流看似带，三春杨柳折为鞭。\n诗成马上无须草，酒买垆头不论钱。\n此去长安应咫尺，与君同赋帝京篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23332,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明日饮陈子卿燕南客舍","author":"徐熥","text":"燕市逢君倒接䍦，几回相乐又相悲。\n天涯踪迹同萍梗，客路年华寄柳枝。\n南国词坛高赤帜，西山爽气落瑶卮。\n若非暂过梨花院，辜负春光总不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23333,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下第呈孙子乐省元","author":"徐熥","text":"黑貂裘敝出长安，客路春光半已残。\n燕市柳从归处折，故园花在梦中看。\n处囊壮士犹潜颖，落魄王孙未筑坛。\n飘泊风尘还自笑，十年依旧一儒冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23334,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"平望舟中同在杭晚眺","author":"徐熥","text":"片帆湖上正黄昏，万顷湖光浪不翻。\n别后久无千里雁，月中同听一声猿。\n半汀菱叶争迎棹，满目芦花不见村。\n无数渔歌云外起，天涯孤客易销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23335,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王百谷半偈庵赠顺公","author":"徐熥","text":"彼岸由来不易登，仲宣楼上遇名僧。\n演成西竺三车法，传得南宗几佛灯。\n纪腊每栽香国树，题诗常买剡溪藤。\n漫言自昔耽禅说，身舍空门愧未能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23336,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"娄江哭王太常敬美先生","author":"徐熥","text":"箕尾骑来历几秋，招魂恸哭过西州。\n云飞澹圃愁无色，水到娄江咽不流。\n宝剑此时悬季子，明珠何地报隋侯。\n丘山零落空华屋，徒抱人琴痛未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23337,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭王太常墓","author":"徐熥","text":"一夜文星落太空，中原惊叹失人龙。\n五湖方遂鸿冥志，千载真成马鬣封。\n门下几人歌薤露，墓前今日挂芙蓉。\n招魂宋玉吞声哭，欲叩天阍第九重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23338,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈价夫归自崖州谈粤中山水因怀旧游","author":"徐熥","text":"珠崖弹铗动经年，醉抱黎姬酒肆眠。\n笑语尚存湖海气，衣裳犹带岛夷烟。\n波罗老去甘如蜜，蒌叶开时小似钱。\n十载游踪俱是梦，不堪重听旧山川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23339,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘司理考绩之京","author":"徐熥","text":"北望京华去路赊，法星长照使君槎。\n一官佐郡来分竹，三载王程正及瓜。\n匹马夜嘶燕市月，新莺春啭上林花。\n天朝正待平反疏，父老前途不用遮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23340,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠蔡景明参知","author":"徐熥","text":"托迹江湖二十霜，名山游遍不赍粮。\n斗间能辨龙文气，粉署曾含鸡舌香。\n夜月久虚玄草宅，客星还照紫薇郎。\n山川信美皆吾土，何用登楼忆故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23341,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过邵梦弼广文山居","author":"徐熥","text":"家傍城南薛老峰，衡茅长闭白云踪。\n读书早已过袁豹，作赋元堪比士龙。\n座上一盘餐苜蓿，匣中三尺挂芙蓉。\n山间忽听苏门啸，知隔烟萝第几重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23342,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵仁甫司理左迁之京","author":"徐熥","text":"十载功名叹积薪，风波万里一孤臣。\n江潭此日歌渔父，宣室何年问鬼神。\n自是蛾眉终见妒，岂知龙性故难驯。\n迩来词客方多难，莫向长安逐酒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23343,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭邵梦弼广文 其一","author":"徐熥","text":"云黯乌山旧草亭，抚床恸哭泪交零。\n百年天地收灵气，半夜词坛陨将星。\n挂壁哀弦今已断，隔邻长笛不堪听。\n茂陵死后多遗稿，剩有残编著汗青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23344,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭邵梦弼广文 其二","author":"徐熥","text":"赋就招魂竟莫还，天阍虎豹正当关。\n更无白日能回照，岂有金丹可驻颜。\n死后脩文居地下，生前遗墨在人间。\n青门皓首幽栖处，桂树萧条不忍攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23345,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋饮西湖澄澜阁观妓","author":"徐熥","text":"八月秋风冷芰荷，西山爽气晚来多。\n千重树色浓于染，十里湖光澹似罗。\n白社共酣桑落酒，红裙齐唱竹枝歌。\n今宵若得君平卜，知泛星槎入绛河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23346,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽吴门沈汝明处士","author":"徐熥","text":"萧萧白发老山林，处士星文一夜沉。\n邻舍几能悲短笛，中原谁不叹亡琴。\n空林猿鹤春无主，满地松楸日易阴。\n墓与要离孤冢近，梁鸿高节尚堪寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23347,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"齐将军席上闻歌","author":"徐熥","text":"七载韶华叹逝波，天涯尊酒喜重过。\n春风海上销兵气，夜月军中奏雅歌。\n仙子吹笙年正少，将军入幕客偏多。\n灞亭醉尉应相避，敢问今宵漏若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23348,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送熊益中孝廉归丰城","author":"徐熥","text":"征亭尊酒暂踌躇，一曲阳关恨有馀。\n月里龙精归剑浦，云边马首出匡庐。\n故园春尽莺声老，驿路天长雁影疏。\n明到长安同献赋，知君才藻逼相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23349,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠黄瞻山先生","author":"徐熥","text":"年少声华动五侯，老来长啸卧沧洲。\n门无车辙堪罗雀，家有图书可汗牛。\n流水一村韦曲社，桃花三月武陵舟。\n知君猿鹤盟犹在，好看青山到白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23350,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠歌者","author":"徐熥","text":"莺喉宛转舞蹁跹，唱彻凉州第一篇。\n缑岭羽衣王子晋，汉宫丽质李延年。\n袖当卧处还堪剪，锦掷筵间不用缠。\n三过雍门称绝技，可能歌劝上留田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23351,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沙口夜泊答宗思兼见示","author":"徐熥","text":"薄暮停桡水一湾，沽来村酒破愁颜。\n戍楼残角吹霜落，别浦渔舟刺月还。\n几点昏鸦归木杪，数家寒火出林间。\n漫言潘岳犹年少，憔悴西风鬓易斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23352,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重阳前一日寓宝严寺","author":"徐熥","text":"为怜秋色满禅房，回首家山几断肠。\n季子黑裘淹岁月，潘郎青鬓怯风霜。\n天涯佳节愁中过，上界钟声梦里长。\n飘泊异乡知己少，明朝谁泛菊花觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23353,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江郡侯招饮西湖同曾人倩谢在杭分得游字","author":"徐熥","text":"乞假邀驩露冕游，暂从湖上驻鸣驺。\n千层粉堞连云起，一带沧波绕寺流。\n大梦山前春意动，澄澜阁上雨声收。\n江淹彩笔雄今古，敢对青尊共唱酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23354,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄居约司理英州","author":"徐熥","text":"少年新佩吕虔刀，拥传东行意气豪。\n公署遥开泷水阔，法星还傍斗垣高。\n曲江柳色迎征幰，庾岭梅花照锦袍。\n同听鹿鸣君已贵，可无书札慰蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23355,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己丑除夕迎春同陈振狂过钟山寺访曾人倩适瀚上人至同得僧字","author":"徐熥","text":"岭南才子气凭陵，剡水孤舟兴可乘。\n青树又添阶下腊，缁衣同对佛前灯。\n漫誇市上春如锦，且醉尊中酒似渑。\n总是空门无去住，好将真偈问名僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23356,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庚寅元日曾人倩过访同谢在杭分韵","author":"徐熥","text":"故人骑马到岩阿，同泛椒花醉薜萝。\n别后青云俱未达，镜中华发近如何。\n鸥盟隐去还堪结，马齿年来觉渐多。\n新柳河桥初绽绿，明朝且莫赋骊歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23357,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钟山寺送曾人倩归岭南","author":"徐熥","text":"曾向东阿酒肆逢，重来相见未从容。\n帆飞炎海三秋月，门掩青山半夜钟。\n客路迎人惟柳色，贫交赠别只芙蓉。\n遥知他日相思处，梦在罗浮四百峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23358,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送江太守兵备三吴","author":"徐熥","text":"登车揽辔正秋分，卧辙无能借寇君。\n郭外一钱遮五马，匣中双剑静三军。\n霜台俯瞰娄江水，行部遥飞震泽云。\n自愧浅才甘寂莫，谁因羽猎荐雄文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23359,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送谢伯元之金陵","author":"徐熥","text":"长江渺渺片帆开，一曲离歌落照催。\n挟妓每过桃叶渡，寻僧重上雨花台。\n芙蓉古岸犹堪采，禾黍遗宫尽可哀。\n不必登高频吊古，六朝王气已成灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23360,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"温永叔郡丞以诗见赠赋答","author":"徐熥","text":"南国风流温太真，翩翩才藻更谁伦。\n几年作吏犹分竹，何处逢人叹积薪。\n郡剧不妨三日醒，甑空宁厌一官贫。\n使君赋有凌云气，白练亲题寄隐沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23361,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻警 其一","author":"徐熥","text":"西贼寒盟秋犯边，黄尘漠漠暗高天。\n一从互市通穷塞，廿载偷安罢控弦。\n绝域羽书飞幕府，连营烽火照甘泉。\n诸公早建安危策，四海苍生正倒悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23362,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻警 其二","author":"徐熥","text":"和议当年计已疏，空将岁币致穹庐。\n总缘中夏无防禦，遂使穷边得捣虚。\n帷幄运筹贤相国，边陲经略老尚书。\n吾皇威福齐天地，杕杜歌成乐有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23363,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻警 其三","author":"徐熥","text":"传闻边郡苦天骄，三辅人心忽动摇。\n宁夏守臣纷告急，太平天子始临朝。\n中原几处忧骑虎，北塞何人得射雕。\n坐看边庭空漠北，汉家新拜霍嫖姚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23364,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻警 其四","author":"徐熥","text":"关山边骑响萧萧，司马观兵日度辽。\n天上黑光久摩荡，宫中黄屋太焚烧。\n空挥涕泪忧时变，难效涓埃答圣朝。\n安得善言同宋璟，冥冥氛祲一时销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23365,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"经涌泉废寺","author":"徐熥","text":"约客扶筇到上方，白云空绕旧僧房。\n经台岁久萝阴合，香积春深草色荒。\n遗址尚传唐甲子，残碑犹志宋文章。\n可怜几度沧桑变，惟有猿声啸夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23366,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过大笠僧太虚故居","author":"徐熥","text":"重携竹杖访禅栖，钟磬无声鸟乱啼。\n只履乍逢归竺国，众香今已指曹溪。\n幻身自昔终于灭，住世虚传得大齐。\n却笑俗情空雨泪，悟来应识世人迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23367,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠赵茹霞羽士","author":"徐熥","text":"海国真人茹碧霞，廿年云水寄生涯。\n读残紫府三千箓，看尽玄都十万花。\n天外瑶笙招白鹤，洞中霞佩隐青蛇。\n知君名姓归仙籍，为乞星坛伏火砂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23368,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吸江亭送林隐之山人还永嘉","author":"徐熥","text":"萧萧匹马万重山，遥指家林雁宕间。\n竹叶难留孤客醉，桃花如笑故人颜。\n不将旅食弹长铗，已动归心忆小蛮。\n歌罢骊驹声渐远，吸江亭外即阳关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23369,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客中忆惟起惟扬弟","author":"徐熥","text":"谁怜岁晚滞征途，无那离心满五湖。\n花外烟霞双屐冷，竹中风雨一灯孤。\n断猿叫月朝归峡，孤雁啼霜夜入芦。\n忆汝松窗读周易，莫教三径易荒芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23370,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再至京师","author":"徐熥","text":"遥控秦关百二重，九天宫阙绚芙蓉。\n醉中但击荆轲筑，梦里惊闻汉阙钟。\n才子新词皆吐凤，美人高髻尽盘龙。\n玉河杨柳丝丝绿，染得青袍色尚浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23371,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋集周光禄花亭观妓","author":"徐熥","text":"何来珠履满华堂，弦索声中漏未央。\n狂客风流歌白帻，妖姬云集斗红妆。\n月明尽撤千枝烛，花郁争分百和香。\n莫谓醇醪容易醉，主人年少是周郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23372,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送苍峡王巡检罢官归乡","author":"徐熥","text":"越王台上送将归，远树空林带夕晖。\n苍峡断猿双泪下，碧天寒雁一行飞。\n秪愁白发流年暮，不问青山旧业微。\n此别悠悠难再遇，思君惟有一沾衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23373,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄吴叔嘉","author":"徐熥","text":"当年岁晚过江都，闻说相如渴未苏。\n作客生涯云共薄，怀人愁绪月同孤。\n秋风茂苑閒清昼，春雨荒城长绿芜。\n遥想登楼定怀土，梦魂夜夜到勾吴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23374,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘宋卿还家兼讯顾长卿世卿","author":"徐熥","text":"平芜漠漠白云閒，忍向尊前送客还。\n赋别此时过候馆，怀人今夜闭空山。\n一年春色啼莺里，千里归心去马间。\n为问姑苏台上客，几人飞梦到闽关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23375,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈仲徽之齐省兄 其一","author":"徐熥","text":"都亭对酒起愁声，芳草萋萋感别情。\n一片飞帆扬子渡，五更归梦越王城。\n客途社早初逢燕，官舍春深好听莺。\n念我征鞍方暂息，不堪江上送君行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23376,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈仲徽之齐省兄 其二","author":"徐熥","text":"堤畔流莺不可闻，此行应念鹡鸰群。\n孤舟夜渡秦淮月，匹马朝冲泰岱云。\n故国烟花随梦断，天涯春色隔江分。\n欲知别后相思意，惟有登楼对夕曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23377,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陈子卿","author":"徐熥","text":"萋萋芳草满汀洲，为念王孙独倚楼。\n易水悲风孤客泪，潞河寒雨一归舟。\n征途入夜劳乡梦，野店逢春忆旧游。\n献赋不须嗟未达，于今世路总悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23378,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"孙子长居湖上别业却寄","author":"徐熥","text":"西湖水色碧连天，湖上幽栖地自偏。\n远寺钟声明月夜，隔林樵唱夕阳边。\n行当花径常逢鹿，坐向柽阴独听蝉。\n闻说荒郊少人迹，与谁同泛钓鱼船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23379,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送玉生诸子游方广岩","author":"徐熥","text":"一叶兰舟问翠微，满汀杨柳正依依。\n谷当绝壁僧行惯，寺隐深溪客到稀。\n半亩暮云禅榻冷，几番春雨水帘飞。\n花源自是堪逃世，莫学渔郎去便归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23380,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送田将军武荐上司马 其一","author":"徐熥","text":"侯门才子似君稀，鹊印貂裘赴帝畿。\n济北烟花迎去马，潞河风柳绾征衣。\n津亭春暖千莺啭，上苑秋高一鹗飞。\n圣主临轩应召对，安边何策献彤帏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23381,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送田将军武荐上司马 其二","author":"徐熥","text":"关城三月尚微寒，一曲离歌送所驩。\n客舍花飞春漠漠，长安天远路漫漫。\n舟移楚水晴烟断，马过燕山夕照残。\n独爱终军最年少，请缨还拟繫楼兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游宗谦山人见过","author":"徐熥","text":"春残花落雨濛濛，十载襟期此日同。\n一榻独悬青嶂里，数杯长醉白云中。\n已闻啸似苏门远，还羡谈如稷下雄。\n明发河桥应折柳，白头为客任西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明日感怀","author":"徐熥","text":"此心如梦复如痴，荏苒春光欲暮时。\n啼比杜鹃先有血，愁同杨柳更多丝。\n林花开遍谁为主，社燕重来亦似悲。\n寒食已过非禁火，闭门犹自绝晨炊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送妓入道 其一","author":"徐熥","text":"厌居绮陌慕丹丘，断却尘缘学道流。\n夜静有神游紫府，月明无梦到青楼。\n六时古洞春风满，十二巫山暮雨休。\n一曲云璈声缥缈，依稀犹带小凉州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]