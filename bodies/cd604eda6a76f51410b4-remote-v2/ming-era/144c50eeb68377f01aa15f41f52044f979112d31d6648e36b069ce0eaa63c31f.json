ommit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50270,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谢平川耆民钟尚义寄鲊 其三","author":"唐文凤","text":"芼以辛姜添美味，沃之苦酒吐奇光。\n冰盘碎切飞霞片，采石樽深入醉乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50271,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谢平川耆民钟尚义寄鲊 其四","author":"唐文凤","text":"瓮潭昔有铜环鲤，何事而今碎雪鳞。\n慰我老饕尚能赋，诗瓢酒杓细分春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50272,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谢平川耆民钟尚义寄鲊 其五","author":"唐文凤","text":"弹铗王门食有鱼，寄来磁瓮更鲜腴。\n谢诗愧非裹鲊帖，赠远当传双鲤书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50273,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄孝子吕叔素 其一","author":"唐文凤","text":"相传礼乐太常家，市隐城南静不哗。\n兄弟怡怡自和辑，春风庭院紫荆花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50274,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄孝子吕叔素 其二","author":"唐文凤","text":"庐墓三年孝行全，姓名已达九重天。\n蓼莪应念劬劳德，彤管当书史一编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50275,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄孝子吕叔素 其三","author":"唐文凤","text":"教子传家守一经，百年文献旧毡青。\n雄辞妙画南金价，磨石当镌太史铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50276,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄生员徐永德","author":"唐文凤","text":"明伦堂下竹疏疏，枝叶萧森凉雨馀。\n满目尘嚣俱洗尽，夜深吹烛照残书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50277,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄钟子常文学 其一","author":"唐文凤","text":"紫髯才俊总超群，笔底春生五色云。\n千里相思共良夜，东龛岩畔月纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50278,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄钟子常文学 其二","author":"唐文凤","text":"龙潭酌别惜携分，酒湿淋漓白练裙。\n何日相逢共倾盖，寸心长绕潋江云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50279,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄钟子常文学 其三","author":"唐文凤","text":"天上宏开白玉堂，老臣侍读沐恩光。\n拔茅连茹思才俊，东野云龙愿颉颃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50280,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄钟子常文学 其四","author":"唐文凤","text":"妙画清诗才思新，笑谈顿使座生春。\n白头愧我鹓鸾侣，青眼思君鸥鹭群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50281,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄钟子常文学 其五","author":"唐文凤","text":"阳山东望起朝霞，富贵功勋越国家。\n秋色可怜今寂寞，独留黄菊一枝花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50282,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄秀才罗季翔刘德明刘志用陈克让王达礼方文兴邓子民杨汝诚 其一","author":"唐文凤","text":"我来子去各东西，踪迹何殊鸿印泥。\n座上春风谁许挹，满庭棠影鸟空啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50283,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄秀才罗季翔刘德明刘志用陈克让王达礼方文兴邓子民杨汝诚 其二","author":"唐文凤","text":"师席长虚知几年，雨寒尘暗广文毡。\n扬雄已老侯芭去，寂寞何人守太玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50284,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄徐复本主簿","author":"唐文凤","text":"白发臞翁特写真，风霜骨格雪精神。\n莺花故国十年雨，鸾枳当时百里春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50285,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄杨南寿 其一","author":"唐文凤","text":"关西夫子道尤尊，清白传家到耳孙。\n几度相思程水路，白沙翠竹月当门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50286,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄杨南寿 其二","author":"唐文凤","text":"僦居近住古城边，大隐如何在市廛。\n云散西山青似洗，疏疏凉雨洒帘前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50287,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄黄子成 其一","author":"唐文凤","text":"每爱西江双井黄，食莲念母寸心长。\n东邻舅氏年将老，相见何烦忆渭阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50288,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄黄子成 其二","author":"唐文凤","text":"载酒龛岩饮石坡，危桥摇兀步难过。\n至今梦想何由到，心逐春风绕薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50289,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题墨梅 其一","author":"唐文凤","text":"前村昨夜雪晴时，春到寒花第一枝。\n错认孤山小桥路，月移疏影鹤归迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50290,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题墨梅 其二","author":"唐文凤","text":"东风吹春到南枝，三花五蕊香参差。\n幽禽戴雪头已白，月明忍冻应多时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50291,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题红梅","author":"唐文凤","text":"春沁南枝雨未乾，东风吹暖已消寒。\n何人点染胭脂裹，疑是嫦娥绛雪丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50292,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画 其一","author":"唐文凤","text":"断矶石罅两舟舣，繁木云边孤馆藏。\n有客读书忘俗虑，绿杨风软日初长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50293,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画 其二","author":"唐文凤","text":"落落长松苍干古，深深幽馆碧窗虚。\n阶除近水凫鹥集，知是山中晓雨馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50294,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题宋李纲帐绿亭诗后","author":"唐文凤","text":"狡童已沮勤王志，老桧犹贪蔽日阴。\n帐绿春深风雨横，一生空负老臣心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50295,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]