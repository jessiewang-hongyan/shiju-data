[{"title":"译鸟言七章 其一 鹧鸪","author":"释函可","text":"行不得哥哥，世无商王，谁开网罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46701,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"译鸟言七章 其二 杜鹃","author":"释函可","text":"都恶都恶，不如沙漠，沙漠有冰犹可啄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46702,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"译鸟言七章 其三 寒号","author":"释函可","text":"得过且过，身无毛，夜无窠。\n谁能留白日，莫使下沧波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46703,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"译鸟言七章 其四 鹊","author":"释函可","text":"鹊惜惜，多少新民不得食。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46704,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"译鸟言七章 其五 鸦","author":"释函可","text":"呀呀呀，安得大日轮，照此海东涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46705,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"译鸟言七章 其六 鸠","author":"释函可","text":"姑姑姑，一月三夫，旧夫瘦小新夫粗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46706,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"译鸟言七章 其七 布谷","author":"释函可","text":"快耕快锄，胡地霜多。\n今不努力，柰饥何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46707,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三五七言","author":"释函可","text":"塞草白，塞日黄。\n埋沙无老骨，挂树有饥肠。\n安得长风生此夕，尽吹残魄返其乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46708,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答邛子寄水晶蟾","author":"释函可","text":"九载不相闻，万里劳相寄。\n分明一照见肝肠，中间恍惚相思字。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46709,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏效读曲歌体六章 其一","author":"释函可","text":"辛苦道傍井，辘轳无停时。\n行路日千百，若个心相知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46710,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏效读曲歌体六章 其二","author":"释函可","text":"捶碎檐前钟，十年刚把手，此别更难逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46711,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏效读曲歌体六章 其三","author":"释函可","text":"揖谢檐前钟，幸渠话未终，话终泣何穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46712,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏效读曲歌体六章 其四","author":"释函可","text":"盘中堆红炭，炭热人亦聚，炭销人亦去。\n人去留不住，住亦无意绪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46713,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏效读曲歌体六章 其五","author":"释函可","text":"炭热盘不觉，炭销盘不知。\n劝君且住不须去，盘当再热时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46714,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏效读曲歌体六章 其六","author":"释函可","text":"大雪不得食，野雉马前飞。\n少年惜泥弹，只用马鞭捶。\n鞭捶死亦苦，其柰腹中饥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46715,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶成","author":"释函可","text":"斫却相思树，锄却金银花。\n世间自有好男子，何必嘈嘈老释迦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46716,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"槿言","author":"释函可","text":"槿之言，若曰尔松太不情。\n孤直千年苦，何似一朝荣，松闻寂无声。\n便使为薪灶下死，不愿开花世上荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46717,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"俗讴","author":"释函可","text":"海舶来，海舶不来无剪裁。\n海舶来，海舶不来饱难挨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46718,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"博里歌 其一","author":"释函可","text":"柰何许，担水放白艚，到底充不去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46719,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"博里歌 其二","author":"释函可","text":"噫于戏，鱼鳔著水交不固。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46720,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"博里歌 其三","author":"释函可","text":"休语语，休言言，扁柴烧火叹无缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46721,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"博里歌 其四","author":"释函可","text":"苦瓜苦，有时锄。\n侬心苦，无时无。\n黄蘖苦，有时枯。\n侬心苦，无时无。\n若得侬心无苦时，长河无曲路无巇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46722,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"社集诗 其一","author":"释函可","text":"塞外高松青百尺，凄风吹雨半天声。\n共经万死知生重，却羡孤身似叶轻。\n东海只今馀大老，西山不愧是难兄。\n予生匪远寒逾甚，白雪同歌岁岁情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46723,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"社集诗 其二","author":"释函可","text":"刀俎遗馀生久残，漫劳诸子摘琅玕。\n春风沙碛惊新至，腊月盘冰好共餐。\n万里乡关三岁梦，七觔布衲五更寒。\n淹留竟日归须晚，祇恐重来事又难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46724,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"招诸公入社诗十首 其一 招不二先生","author":"释函可","text":"三扣先生知不知，残僧亦有胆堪披。\n莲花一瓣归来好，上帝年来只掩扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46725,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"招诸公入社诗十首 其二 招雪蛆","author":"释函可","text":"冰作肝肠我作邻，爱君清冷绝纤尘。\n死生欲了三冬事，只恐寒消不耐春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46726,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"招诸公入社诗十首 其三 招青草","author":"释函可","text":"一寸青青自耐霜，茂陵骊岳总茫茫。\n黄尘不独埋红粉，社里莲花比尔香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46727,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"招诸公入社诗十首 其四 招子规","author":"释函可","text":"乾坤千古总糊涂，何事年年带血呼。\n只有莲花归处好，凤凰山上亦荒芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46728,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"招诸公入社诗十首 其五 招狂封","author":"释函可","text":"三韩总是尔封疆，黼哻能留只一方。\n洪范遗编存布袋，归来别有好商量。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46729,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"招诸公入社诗十首 其六 招冰鬼","author":"释函可","text":"白水青波是旧身，夜深惟许尔相亲。\n衲衣一片寒侵髓，不久当为若辈人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46730,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"招诸公入社诗十首 其七 招丁仙","author":"释函可","text":"归来莫羡海天宽，眼见天倾海亦乾。\n纵此社开时可到，千年那得一人存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46731,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"招诸公入社诗十首 其八 招石人","author":"释函可","text":"松麈招来好论心，怜君独自立高岑。\n攒眉欲去非关酒，只恐愁多抱尔沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46732,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"招诸公入社诗十首 其九 招沙子","author":"释函可","text":"大地茫茫一聚尘，我来扑面尔先迎。\n他时片骨知堪托，莫使沉埋见月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46733,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"招诸公入社诗十首 其十 招镇君","author":"释函可","text":"聪明正直亦前因，五戒曾闻授岳神。\n我到冀营君是主，净除庭雪待风轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46734,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和澹心因圃阻雪思归","author":"释函可","text":"又见千山绝鸟飞，閒拈玉麈对君挥。\n绥绥白昼荒城路，淰淰寒生破衲衣。\n粪火芋香聊共剥，梅村梦断未言归。\n年年风雪栖庑下，惆怅残更忆翠微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46735,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同澹心咏介子庭中蜡梅","author":"释函可","text":"处士庭前续旧欢，数枝开遍共团圞。\n瓣当白雪偏能见，名托浮山亦耐寒。\n金色头陀花底笑，黄衣舞女梦中看。\n胡雏何处吹横笛，拥毳踌躇到夜阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46736,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭绳海先生","author":"释函可","text":"素车犹忆十年前，生死交情更不迁。\n曾记邮筒传岭月，独赍镜老破江烟。\n何人报国身能在，赖汝孤臣节已全。\n一瓣香消寒泪溅，乱鸦啼上古城边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46737,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵感赋","author":"释函可","text":"旧堤杨柳不成裁，劫火经今五十回。\n瓦碎尚馀香粉腻，市喧疑是野魂哀。\n高飞独羡扬州鹤，倚杖难寻月观梅。\n祇为繁华易消落，遍将清泪点寒灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46738,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱溪臣临行再被价窃作此奉慰并以言别","author":"释函可","text":"两年飘泊石城东，垂死怜君病复同。\n穷鬼憎人寒不彻，黑貂诲盗数仍空。\n家乡路远心逾苦，海角天倾恨未终。\n旧社梅花看欲发，一枝惆怅老西风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46739,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对与治怀莞羊诸同志","author":"释函可","text":"论交兹夕复何疑，屋角参横动远思。\n今世几人堪久别，他乡惟子许相知。\n但看绿涨流桃叶，已是朱明负荔枝。\n去住总来成系念，一生憔悴此情痴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46740,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"路中","author":"释函可","text":"石头曾共典寒衣，五月光分几雁飞。\n前路烽烟愁正剧，一春花鸟愿多违。\n还家莫话沧桑事，迟我常开夜月扉。\n江水茫茫悲倦翮，何时同采故山薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46741,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"台中","author":"释函可","text":"无聊长寄一枝筇，悔不同君四百峰。\n旧榻尽容狞虎待，半铛常煮野云供。\n到家应共怜穷子，博饭无如学老农。\n从此入山惟稳睡，只愁僧打五更钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46742,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"博中","author":"释函可","text":"数别何曾见泪痕，长干落日自吹埙。\n故园一任荒丛菊，急难方知忆弟昆。\n小雨滴生春草梦，西风飘送老梅魂。\n为怀正好愁冬际，芦叶芦花江上村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46743,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莞中","author":"释函可","text":"蓬转长空迹未孤，柏林能不念吾徒。\n回何敢死还多畏，柴也其来幸是愚。\n强把笑歌酬木石，空令涕泪满江湖。\n浪游愧我恒终岁，白首曾成一事无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46744,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广中","author":"释函可","text":"出门又过半年期，独夜心情黯自悲。\n乡梦似随风雨入，归程仍为甲兵迟。\n一生未了嵩间泪，万里长萦涧畔思。\n想得生还重见面，几人欢动藕花池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46745,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋梦","author":"释函可","text":"荒原寂寂落花钿，锦瑟閒抛五十弦。\n蝉咽未离芳树里，马嘶偏系画堂前。\n甄山道士传兵解，阳羡书生合醉眠。\n尽向湖船载西子，城头空见草芊芊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46746,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蜚声","author":"释函可","text":"驱驰镇日自空餐，剩有逢迎好结欢。\n流涕可堪容贾谊，无鱼终欲笑冯驩。\n共誇金穴千年满，閒倚冰山半夜寒。\n一著未施全局尽，弈棋曾不似长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46747,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻黄石斋至","author":"释函可","text":"惊传一骑到江干，绕遍梅花泪未乾。\n邓禹几能扶汉室，钟仪终不改南冠。\n空馀短剑龙文暗，好付残躯马革寒。\n岂为绨袍今哭汝，澥天风雨正漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46748,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒夜偶成","author":"释函可","text":"木佛寒灯共一堂，漫思往事浩茫茫。\n何曾辱我非能忍，无柰恩多未易忘。\n门掩疏钟人自古，更残薄被月如霜。\n吾生犹及梅花发，岂必罗浮是旧乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46749,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初闻警友人约同入岭作此答之","author":"释函可","text":"长安花事独相关，荔子丹时尚未还。\n无可藏身惟酒肆，何须埋骨向青山。\n一瓢以外无馀物，荷插相从便不閒。\n到处饱餐到处死，故人多泪自潺潺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46750,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿界系师兼约同游罗浮","author":"释函可","text":"身形似鹤古来稀，深谷梅花冷共支。\n坐破蒲团千顷月，阅穷沧海两茎眉。\n閒知岁月终堪惜，老爱云山亦是痴。\n为嘱赵州行脚处，麻姑峰畔荔支期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46751,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答邢孟贞并以道别","author":"释函可","text":"高楼春尽恨难删，每见君来一破颜。\n客梦荒烟迷去道，平生知己重名山。\n却怜远别逢梅雨，早愿馀年入玉关。\n几处草庵烧不尽，秋来犹得扫苔斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46752,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别王子京","author":"释函可","text":"?毵破衲挂枯藤，敢道无情泪又增。\n不为金钱思长者，每从处士揖孤僧。\n甘贫但酌空江水，受树仍留异代陵。\n长想政閒无一事，一轩明月话高朋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46753,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别顾与治","author":"释函可","text":"岭海无家亦有忧，归心那复恋狂游。\n频年独寄扬雄宅，此后谁登谢脁楼。\n永夜月来僧不管，一春花落鸟空愁。\n茫茫正溯长江水，何日重过问石头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46754,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别余澹心二首 其一","author":"释函可","text":"春风犹滞秣陵关，晓梦先飞黄木湾。\n弟妹可能存世上，笑啼徒自向人间。\n三年不见云中信，一钵终归何处山。\n最是与君情不薄，悠悠去住两难删。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46755,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别余澹心二首 其二","author":"释函可","text":"敷天处处谷为陵，剩水残山见老僧。\n乞得一餐常自足，饶他百事总无能。\n关心独有池生草，白首何堪鼠啮藤。\n归去把茅诗卷在，思君常剔佛前灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46756,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别白门诸公","author":"释函可","text":"不因行乐亦蹉跎，几度柴门石易过。\n岂有文章逢运使，屡将香饭乞维摩。\n三山花落催行棹，五岭云飞返旧柯。\n莫叹江流千万里，莺啼无限夕阳多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46757,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次郑元白韵","author":"释函可","text":"烟缕城头日未斜，曾来乞食到君家。\n于今年代非当日，始信人间有落花。\n雨后每寻黄叶寺，春残惟听白门笳。\n临岐无住悲鸿渐，为数庭前树上鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46758,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次余澹心韵二首 其一","author":"释函可","text":"家本飞云白石龛，偶言来去亦优昙。\n遗篇青简千年事，山月蒲团一杖担。\n此日晓风歌柳岸，他时高阁坐江南。\n摩腾翻译浑多故，身外累累贝叶函。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46759,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次余澹心韵二首 其二","author":"释函可","text":"摘叶烧泉处士斋，几翻相向写幽怀。\n看残今古无天眼，踏破青山有草鞋。\n雁去休教虚只字，猿归应已共层崖。\n世间定乱非裴度，雪夜何人更度淮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46760,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次林茂之韵二首 其一","author":"释函可","text":"数间茅屋水东涯，四海为家不当家。\n钵底已无兼宿食，篱边犹忆隔年花。\n典型独喜先生在，风雅徒令异代誇。\n自笑僧贫远行脚，担头犹有旧袈裟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46761,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次林茂之韵二首 其二","author":"释函可","text":"忆昔相逢未是僧，青山处处总堪登。\n斑斓子舍终天恨，花草吴宫百感兴。\n周粟价高思义士，羊裘典尽笑严陵。\n莫言我去知心少，但过墙东有好朋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46762,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈伯玑和余留别与治诗见赠复次原韵答之","author":"释函可","text":"曰归曰归我心忧，野草荒烟失旧游。\n幸是天涯逢有道，相投杖策上高楼。\n西山遗老留云卧，赣水新魂带月愁。\n话至伤心窗又雨，何年重约虎溪头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46763,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"系中生日二首 其一","author":"释函可","text":"稽首牟尼古佛图，今朝犹剩旧头颅。\n纵经万死知何恨，欲尽馀生亦是虚。\n破寺独松撑日月，短床閒梦到江湖。\n从他知罪浑无涉，纳纳乾坤一病夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46764,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"系中生日二首 其二","author":"释函可","text":"三十七年事事非，两行新泪点田衣。\n世间白日还容我，海上青山未许归。\n天意每于穷极见，故人不为病多稀。\n明朝好恶休须论，且共团圞话日晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46765,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马潜庵宪副以折柬讯予参禅下手工夫及天堂地狱所以生起之因欲得二诗应命赋之 其一 参禅诗","author":"释今无","text":"日夕群动中，念虑自来往。\n其始体空寂，奔腾自成党。\n趋喧既失寂，逐暗已背朗。\n有本因于无，繁亦从约长。\n安得旷达人，了然发遐想。\n慧刃割凡情，朱弦奏新响。\n会理融百途，鞭过敌成两。\n铁牛阑稻花，玉童严金杖。\n此处稍偏颇，实际便卤莽。\n损之复损之，神明渐空广。\n垢尽铜自明，厥功乃不赏。\n心境忌烦理，微乐不可享。\n一涶足涴蝇，曷为羁大象。\n有即吃茶条，无亦与一掌。\n靡滞气便雄，非今亦非曩。\n华嵩倒垂看，青天平地上。\n正如夹脊间，伸手搔着痒。\n家藏不龟药，勿事缏繴纺。\n不须从外借，悠然满书幌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46766,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马潜庵宪副以折柬讯予参禅下手工夫及天堂地狱所以生起之因欲得二诗应命赋之 其二 天堂地狱诗","author":"释今无","text":"神明自圆固，犀利无与比。\n皎洁自摇动，突然有念起。\n起则号为妄，相继不可止。\n如眼着手捏，大地如浮水。\n空花落缤纷，红紫扫桃李。\n谓无已见之，呼实岂正理。\n其咎在伊何，不过此手耳。\n手去眼自宁，乱境亦戢弭。\n拙者但罪境，此境难除矣。\n夜台与玉霄，空花堪比拟。\n吾人一念放，不觉为物使。\n才放便囿物，精华成糠秕。\n弊絮逐棘途，百怒无一喜。\n即此一放心，好眼忽加指。\n本体既云变，境即生恶美。\n金阙丽天门，琉璃浮凤尾。\n洛神罗袜轻，五铢双鬟子。\n玉虬驾仙飙，琼浆饮达士。\n刘向列仙书，不独为我始。\n重壤铸铁城，赤烧遍遐迩。\n紫瞳蓝面翁，炉韛攻心肺。\n陈平冠玉人，忽然成犬豕。\n身既公刘虔，舌亦遭耘耔。\n二境反掌间，酸甜不相似。\n以为不实有，眼岂无红紫。\n以为不实无，除指乃能已。\n此中除指方，有虑即罪己。\n内抱明白翁，步步皆能视。\n如我曹溪言，知识从内扯。\n正念名佛生，邪念名佛死。\n一座安乐窝，年来皆颓圮。\n为报高明人，相助以为理。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46767,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]