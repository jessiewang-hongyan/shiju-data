[{"title":"梁未央死难二首 其二","author":"释函是","text":"嗟予肠欲断，念子且何之。\n遂志应无憾，修名亦是痴。\n当观身世幻，莫动黍离悲。\n回首云山阔，龙华为尔期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43830,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"霍觉商父子四人死难二首 其一","author":"释函是","text":"生平多慷慨，死国在儒林。\n父子情偏重，君臣义独深。\n碧潭今日事，明月古人心。\n俯仰堪谁语，一堂玄对森。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43831,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"霍觉商父子四人死难二首 其二","author":"释函是","text":"共明千古节，就义且从容。\n生死去来际，衣冠谈笑终。\n草堂云漠漠，寒夜雨溶溶。\n一片情孤绝，相期入碧峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43832,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出小持船","author":"释函是","text":"一住两三月，莲花空满池。\n郊原戎马急，里巷故人思。\n不了蒲鞋债，仍还茅舍移。\n悠悠无着意，何日白云期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43833,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答晋江陈文长","author":"释函是","text":"随处生涯足，锄云带晚霞。\n窗开青滴树，人在碧笼纱。\n问道看庭柏，当机指菊花。\n知君非俗骨，何日唱还家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43834,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日即事","author":"释函是","text":"荒山无一事，当户数松疏。\n夜短眠不足，日长饥有馀。\n风声撼林谷，雨气浸庭除。\n对此莫须惜，解襟空自娱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43835,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日写怀","author":"释函是","text":"秋月年年白，秋风岁岁清。\n自从一心静，遂使万缘轻。\n落落疏林意，萧萧寒夜情。\n旷观尘世里，谁拟学无生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43836,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题东坡画竹","author":"释函是","text":"尘垢满天地，此君清欲狂。\n浓烟生素绢，薄荫到绳床。\n覆我真难待，披人似亦凉。\n东坡千古意，相对共茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43837,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"开北径二首 其一","author":"释函是","text":"北园开一径，小景足幽情。\n俯仰乾坤阔，优游林木平。\n海连天逾白，人共月长明。\n我亦逃名者，谁当混独醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43838,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"开北径二首 其二","author":"释函是","text":"古者知何似，吾今独杖筇。\n白云常入户，青霭数当峰。\n薄照明秋雁，疏林起暮钟。\n不堪人事改，谁与觅高踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43839,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶述","author":"释函是","text":"秋雨满岩壑，横流似海潮。\n漫漫天地外，望望水云迢。\n白日知何处，晴峦不可招。\n坐看人境寂，魂梦一时销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43840,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜登楼二首 其一","author":"释函是","text":"高楼一以望，顿觉野怀赊。\n月射潮头动，云流山背斜。\n寒塘孤雁影，烟树万人家。\n百尺应难再，凭空思未涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43841,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜登楼二首 其二","author":"释函是","text":"俯仰江山外，悠悠孰共看。\n有怀瞻野岸，无语倚栏干。\n鹤下寒空净，风高碧汉宽。\n欲明今夕事，相对莫顸颟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43842,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与崔石师泛舟","author":"释函是","text":"与子乘桴去，何妨尽日游。\n江山能友我，渔佃总方舟。\n拚醉不须酒，无心亦似秋。\n他年回首处，风起绿榕洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43843,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"勉诃林诸衲","author":"释函是","text":"寒到惊秋尽，无云天欲垂。\n道情添老大，人事暗迁移。\n扫叶供烹茗，担泉先灌葵。\n韶光应共惜，世路此何时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43844,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出关前一夕","author":"释函是","text":"遂有出门意，方知破院閒。\n野云常漠漠，流水自潺潺。\n此夜望中月，他时梦里山。\n坐寒松影怯，归雁度前湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43845,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诃林春归二首 其一","author":"释函是","text":"廛居日易逝，不觉报春归。\n雁影空潭尽，禅声远树微。\n江山三月里，人事十旬违。\n积雨留寒色，焚香但掩扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43846,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诃林春归二首 其二","author":"释函是","text":"忽忆登临处，风烟足往年。\n山悬千里外，春别一旬前。\n岁月催华鬓，乾坤限远天。\n玄心惟自鉴，去住总茫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43847,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城即事","author":"释函是","text":"一郡旌旗满，孤城落照间。\n散骑何日出，大将几时还。\n近海归无渡，连云旧有关。\n犹怜竹径外，徙倚独看山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43848,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"侯若孩过访","author":"释函是","text":"忆别当残腊，重来又在秋。\n多君霜雪意，重我石林游。\n风雨摇山岳，池塘泛海鸥。\n席帘香正煖，天地一虚舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43849,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄无得","author":"释函是","text":"道人生计拙，缓步出山门。\n日日看高岭，行行过别村。\n无人知此意，有口不堪论。\n远讯熊禅者，年来或未谖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43850,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苦雨","author":"释函是","text":"一雨经旬日，闭门谁与同。\n人从烟暝出，心付水云空。\n历历江山外，濛濛天地中。\n放歌殊未已，学得古人穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43851,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜晴","author":"释函是","text":"清晨一开户，澄霁如平时。\n不减青山色，多添绿树姿。\n白云归洞急，红日上梢迟。\n策杖园林外，鹧鸪啼向谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43852,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出小持船作二首 其一","author":"释函是","text":"严城不易出，独许看云人。\n附郭馀孤木，空斋无四邻。\n水亭深夜月，烟树旧时春。\n对此清幽趣，谁怜梦里身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43853,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出小持船作二首 其二","author":"释函是","text":"帘疏月到簟，高卧独依违。\n黄鸟声何急，青山梦亦非。\n一庵烟水阔，千里雾云微。\n无限伤心处，孤城人影稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43854,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻亦非隐天目","author":"释函是","text":"天目中峰变，晴岚万壑阴。\n马嘶荒草断，人宿暮云深。\n何日乘潮上，别峰清欲临。\n遥知携手处，应尽故园心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43855,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登楼","author":"释函是","text":"濛濛烟雾里，峰岫隐如无。\n地近市廛旧，人看世界殊。\n白云迷晓日，青燕引飞雏。\n一上楼头望，临风涕欲俱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43856,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠范华宇","author":"释函是","text":"将军不尚武，矢志在安民。\n万户伤心处，孤城此日春。\n高山曾有梦，流水付何人。\n笑指溪桥近，相看忆旧因。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43857,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诃林忆旧山二首 其一","author":"释函是","text":"不见雷峰顶，心知海寺东。\n闻钟疑隔岸，对雨忆长松。\n风鹤从来旧，烟霞此际隆。\n百年多病日，归思正无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43858,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诃林忆旧山二首 其二","author":"释函是","text":"情深山水日，岂为觅桃源。\n倦鸟藏深树，惊鱼沉巨川。\n拂波杨柳月，依岸竹林烟。\n一自不知乐，浮生空惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43859,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与梁同庵王说作夜坐风幡堂","author":"释函是","text":"中夏坐宜夜，夜深鸟不啼。\n相看今古尽，无语是非齐。\n殿迥薰风细，楼高云气低。\n等閒过一夕，险韵漫分题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43860,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"一啸","author":"释函是","text":"一啸江天暮，长吟风物新。\n无家终作客，有钵未曾贫。\n不识云山路，空知林木亲。\n平生多意气，强半为人瞋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43861,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈康叔复徙仁化","author":"释函是","text":"惜别非归路，胡为千里行。\n客心徒自苦，去住此时轻。\n暴雨中席至，西风向晚生。\n前途望秋月，莫动故乡情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43862,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"示梁同庵","author":"释函是","text":"懒僧居破寺，岂是世间情。\n幸托随缘趣，相将寄此生。\n爱閒嗟往事，畏俗厌时名。\n念汝年差近，堪为林下盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43863,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与王说作","author":"释函是","text":"君但先为复，年来欲住山。\n多因酬世拙，以此乐吾閒。\n黄独岂真美，青松未可删。\n尚能不贱目，云水去留间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43864,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己丑冬赴古冈大云请因示诸衲","author":"释函是","text":"万里寒烟直，虚空起大云。\n长廊风叶捲，古殿月华分。\n历历应非物，忉忉何所云。\n一堂僧与俗，谁见复谁闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43865,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古冈除夕","author":"释函是","text":"忽忽过今夕，迢迢遂去年。\n空居人世外，犹共岁时迁。\n野火横星汉，寒鸦落雾烟。\n江城除夜禁，春色自林泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43866,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与诸衲游知园","author":"释函是","text":"名园誇独胜，想见古人心。\n渍水成寒渚，为山控碧岑。\n平台歌舞歇，荒径草莱深。\n相对同他日，悠悠自古今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43867,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游圭峰","author":"释函是","text":"人日寻幽壑，圭峰旧有名。\n徐行怜日暖，小坐爱风清。\n败叶残碑覆，枯椿野鸟鸣。\n青山空垒垒，无限古今情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43868,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古冈闻警","author":"释函是","text":"所见非今日，惊闻又一时。\n天心不厌乱，人事欲何为。\n薄海旌旗蔽，孤城画角悲。\n十年尘世外，归梦亦迟迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43869,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将还雷峰留别古冈诸子","author":"释函是","text":"一自闻风鹤，深惭遁者讥。\n寻生人有路，策杖我何归。\n旧筑青山稳，征帆野岸微。\n江城重回首，春草绿依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43870,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诸子送予江门口占慰别","author":"释函是","text":"岸柳难为别，江风欲送行。\n迢迢村路迥，漠漠野烟横。\n挥涕怜儿女，牵衣愧父兄。\n不看分手意，谁识住时情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43871,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过蓝田访岑梵则二首 其一","author":"释函是","text":"何期当此日，复见老成人。\n未乱先归隐，为园及早春。\n沙田将播种，茅屋绝无邻。\n借问生涯事，年来欲慕真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43872,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过蓝田访岑梵则二首 其二","author":"释函是","text":"惜别自今日，交游忆十年。\n雁归芦渚冷，人到杏花前。\n往事不堪论，遐心总入玄。\n悠悠江上水，遥望白云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43873,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"还雷峰","author":"释函是","text":"夜夜还山梦，梦中山宛然。\n青松犹夹岸，绿竹已参天。\n却恨忙年月，深怜旧草玄。\n看看秋又尽，归雁入寒烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43874,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"还雷峰寄王说作","author":"释函是","text":"归卧雷峰下，闻君去古冈。\n同时见秋雁，一棹入寒塘。\n篱菊何年醉，溪云看独长。\n人生几回别，老大畏行藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43875,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蕉林看岩关主病","author":"释函是","text":"昔年曾病肺，以此独怜人。\n赖有诗能懒，兼之道欲贫。\n轻风衣外冷，微月柳中新。\n疏拙林泉下，谁知閒处真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43876,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送商丘伯侯若孩","author":"释函是","text":"历乱沅湘道，迢遥潮汐西。\n身名吾辈重，离别世人迷。\n寂寂夜猿啸，萧萧斑马嘶。\n安危付君国，千里绿杨堤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43877,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜老父薙发","author":"释函是","text":"七十方离俗，皤然成老僧。\n人间犹父子，世外得亲朋。\n底事商尘劫，清宵共佛灯。\n隐峰曾有妹，先此乐仍仍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43878,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋雨","author":"释函是","text":"积雨沉秋汉，寒云没太清。\n长林迷去路，栖鸟暗闻声。\n天地何曾别，江山此一更。\n坐观烟暝阔，徒有古今情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43879,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋冯紫光过雷峰二首 其一","author":"释函是","text":"年光惊易过，忽忽又中秋。\n不见故人久，相携山径幽。\n白云横岭路，黄叶断溪流。\n借问生涯事，百年谁短修。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43880,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋冯紫光过雷峰二首 其二","author":"释函是","text":"客心差不俗，僧况亦殊清。\n共坐长林下，难忘故国情。\n水流寒雁影，林噪暮鸦声。\n郑重怜兹日，蒹葭白露盈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43881,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁同庵书辞北上赋此寄别兼讯祖心弟","author":"释函是","text":"因乱频相失，惊闻复远行。\n长安从旧路，出处此时情。\n万里山川险，三春风雪清。\n故人犹可晤，期以慰生平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43882,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日","author":"释函是","text":"厌闹思投老，甘心堕小乘。\n时危村寺稳，道替竹林增。\n适意惟高枕，清谈共数僧。\n海门红日下，危坐剔孤灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43883,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜","author":"释函是","text":"独坐高峰上，双眸寒夜中。\n乾坤容我拙，今古与谁同。\n入望青山旧，当怀明月空。\n何人知此意，冷冷忆卢公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43884,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元旦","author":"释函是","text":"元日晴明好，林泉天地宽。\n竞看新草木，犹忆旧衣冠。\n野鸟啼春昼，山僧耐晓寒。\n莫愁时序改，不尽碧云团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43885,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落齿吟","author":"释函是","text":"食笋忽落齿，方知非壮年。\n人生愁渐老，吾道乐其天。\n岁月忙中过，沧桑梦里迁。\n一杯清茗罢，吟啸自便便。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43886,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新月","author":"释函是","text":"桥头初月上，相见隔年新。\n影落千江冷，光生万户春。\n海门潮淼淼，山路石磷磷。\n何必清辉满，娟娟早可人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43887,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王说作归龙江","author":"释函是","text":"别去当正月，相期二月还。\n三旬风雨夜，百里海云间。\n吾道难为俗，君心亦自閒。\n梨花凉月上，人影待春山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43888,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诸子夜集方丈","author":"释函是","text":"相对今何事，相期尽一生。\n夜寒茶椀重，人静烛花明。\n密坐偏多意，微言岂为名。\n山中与山外，谁会此时情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜诃衍还山","author":"释函是","text":"入山将午食，风暖日光迟。\n乍别惊予瘦，归来爱汝痴。\n渐深杨柳色，应长薜萝思。\n观世同春梦，閒心欲付谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿诃林","author":"释函是","text":"不到诃林久，悠然钟磬音。\n战争成佛地，云树几人心。\n画角孤城暮，春风古殿深。\n徘徊今夜梦，依旧在长林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病四首 其一","author":"释函是","text":"始信我能病，闭门惟一閒。\n鸟声喧瘦日，人影谢空山。\n茶为伤脾少，诗因摄虑艰。\n年来方有愿，独宿寒云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病四首 其二","author":"释函是","text":"不耐秋山色，扶筇一启扉。\n畏风因步缓，倚竹觉身微。\n衰柳拂茅屋，孤鸿立钓矶。\n夕阳村犬吠，林外有僧归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病四首 其三","author":"释函是","text":"久矣无人事，病来心更休。\n只嫌筋力少，难上碧峰头。\n野火烧何处，海风吹暮秋。\n寒房掩深径，落叶空飕飕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43894,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病四首 其四","author":"释函是","text":"寒月复相见，霜天此较新。\n下庭双屦重，倚槛数峰真。\n瘴海高秋迥，清溪白石粼。\n一回伤老病，万事但随人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43895,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦达此","author":"释函是","text":"独行傍山水，病中知汝情。\n两年归未得，昨夜梦分明。\n兵火经州县，遭逢数姓名。\n帘前悲喜处，山犬吠秋声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43896,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽陈慧业道人","author":"释函是","text":"生死泥洹等，多君一去来。\n因缘如及尽，迷梦未曾乖。\n白鹭烟光净，金牛月影回。\n精魂他日旧，回首话生台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43897,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日扫老父塔","author":"释函是","text":"尚有孤坟在，空闻松柏哀。\n青山怜我瘦，黄菊向人开。\n日落大江阔，风高独雁来。\n明年记此日，珍重几登台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43898,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送思圆","author":"释函是","text":"世外应无恨，忘情亦大难。\n话空千绪失，梦剧五更寒。\n云水何人趣，溪山后日看。\n送君从此去，相忆路漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43899,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]