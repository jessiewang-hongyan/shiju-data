[{"title":"江南曲四首 其三","author":"宗臣","text":"绿窗春鸟声，思君泪如雨。\n人来泪不收，却道思家苦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29032,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江南曲四首 其四","author":"宗臣","text":"欢比堤上絮，如泥亦如雪。\n侬比镜中花，可见不可拆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29033,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄衣曲","author":"宗臣","text":"征人夜度辽，寒衣今去洛。\n妾恐如寒衣，春来不堪着。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29034,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采莲曲","author":"宗臣","text":"莲花比妾貌，妾貌花不如。\n莲子比妾心，妾心应更苦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29035,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"相逢行","author":"宗臣","text":"昔与汝相逢，今与汝相别。\n相逢万里云，相别千山雪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29036,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清夜曲","author":"宗臣","text":"明月期故人，相对坐清夜。\n濯缨绿水前，散发青松下。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29037,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅雪曲","author":"宗臣","text":"山上雪如梅，山下梅如雪。\n寂寞对空山，幽香共谁折。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29038,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月下曲","author":"宗臣","text":"月下吹紫箫，云间整玉佩。\n顾见鸳鸯鸟，一一自成对。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29039,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水中月四首 其一","author":"宗臣","text":"嫦娥三五月，玉露千万秋。\n久居天上苦，暂向水中游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29040,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水中月四首 其二","author":"宗臣","text":"袅袅青山云，湛湛清江水。\n中天落玉钩，鱼龙惊不止。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29041,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水中月四首 其三","author":"宗臣","text":"云敛波还净，云开影自随。\n绿萍与青荇，相傍桂花枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29042,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水中月四首 其四","author":"宗臣","text":"南山亦有罗，北山亦有罗。\n玉兔沧波里，罗兮柰尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29043,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采莲曲","author":"宗臣","text":"采莲莫采蒂，莲蒂丝难吐。\n采莲莫采子，莲子心中苦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29044,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江上曲","author":"宗臣","text":"青波远泛舟，碧石朝逢雨。\n伾见江上人，惟见江上树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29045,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长相思","author":"宗臣","text":"昔与汝相思，仱与汝相见。\n相见已秋鸿，相思入春燕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29046,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江南弄","author":"宗臣","text":"帘栊上夜珠，阑于倚寒玉。\n客子在天涯，相思春草绿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29047,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江南曲","author":"宗臣","text":"客去悲江左，书来滞陇西。\n相思若春草，无路不萋萋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29048,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春闺曲","author":"宗臣","text":"华枕为谁施，华衾为谁卷。\n妾肠非道路，日夜车轮转。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29049,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"楚阳曲 其一","author":"宗臣","text":"官府一开仓，含青向儿女。\n公者犹可迟，私者不可已。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29050,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"楚阳曲 其二","author":"宗臣","text":"东村有客到，相留问烹鸡。\n妇言且莫烹，租吏到河西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29051,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"楚阳曲","author":"宗臣","text":"昨者娶新妇，布裙上两褶。\n租吏呼典衣，妇在窗前泣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29052,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卖花曲","author":"宗臣","text":"长安买花者，数株十万钱。\n道傍有饥者，一钱不相捐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29053,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜吴歌九解赠李顺德于鳞 一解 其一","author":"宗臣","text":"出门望所欢，零雪忽盈尺。\n岂曰沾吾衣，畏此雪上迹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29054,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜吴歌九解赠李顺德于鳞 二解 其二","author":"宗臣","text":"与君生别离，仨年参与商。\n谁谓三年久，不如兹夜长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29055,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜吴歌九解赠李顺德于鳞 三解 其三","author":"宗臣","text":"夜半倚梧桐，明月何历历。\n梧子在其上，可见不可摘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29056,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜吴歌九解赠李顺德于鳞 四解 其四","author":"宗臣","text":"芳草五骅骝，熠熠朝元者。\n不分黄金鞭，出入依君马。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29057,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜吴歌九解赠李顺德于鳞 五解 其五","author":"宗臣","text":"自幼能采莲，兰楫荡前渚。\n如何莲子心，于今更觉苦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29058,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜吴歌九解赠李顺德于鳞 六解 其六","author":"宗臣","text":"闻君有瑶琴，来自昆仑域。\n虽未听其声，时时白云色。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29059,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜吴歌九解赠李顺德于鳞 七解 其七","author":"宗臣","text":"玉树抽新条，炎炎困赤土。\n日望天上云，不得阶前雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29060,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜吴歌九解赠李顺德于鳞 八解 其八","author":"宗臣","text":"自与君相别，剪刀日夜利。\n君有云锦裳，吾当为君制。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29061,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜吴歌九解赠李顺德于鳞 九解 其九","author":"宗臣","text":"手中珊瑚枝，光华掩白日。\n恐君一见之，疑作君家物。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29062,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"省中","author":"宗臣","text":"鸣佩下紫霄，岩岩府中趋。\n冠盖灿以繁，群吏肃前隅。\n晨风振远楹，宿鸟鸣高梧。\n起步忽不惬，叹此中怀孤。\n杨雄草太玄，相如奏子虚。\n执戟亦云晚，游梁意何迂。\n西京有七贵，黄金步天衢。\n朝欢浃车马，夕燕纷笙竽。\n富贵讵可常，为乐亦须臾。\n嗟彼荣华观，耽此寂寞涂。\n取舍一何戾，志各有所须。\n烈士多苦心，斯言良不诬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29063,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜省直","author":"宗臣","text":"驱马即高扃，秉烛照清池。\n冉冉见芙蓉，白露被华滋。\n仰见明月光，三星灿以垂。\n蟋蜶鸣重阶，繁声一何悲。\n感之长叹息，嗟此阴阳移。\n鹿鸣思野草，宿鸟怀故枝。\n人生贵帝志，羁栖亦何为。\n行行返旧服，去去清江湄。\n此意良未申，空令达士嗤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29064,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗二首 其一","author":"宗臣","text":"结发事明主，忠义谅独持。\n出门远眺望，荆棘生路岐。\n路岐阻且深，惆怅何所之。\n中心既不回，艰危何足辞。\n不暇恤其躬，安能顾所私。\n譬彼东流川，九折常如兹。\n昔为志士模，今为壮士规。\n寸心明白日，比德千园葵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29065,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗二首 其二","author":"宗臣","text":"灼灼园中葵，结根高树林。\n绿叶甤紫芬，芳华人所钦。\n白日岂不照，高林蔽其阴。\n中怀抱赤素，谁为见予心。\n予心何足惜，惜此日西颓。\n白日如可待，高林有时摧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29066,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟古二首 其一","author":"宗臣","text":"冉冉江上兰，灿灿江中芷。\n我友远行投，驾言遆江汜。\n江汜波浪深，叹息从中起。\n昔别眷卉敷，今思暮飙紫。\n游子不旋归，浮云日千里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29067,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟古二首 其二","author":"宗臣","text":"驱车事行游，岩畔见芳草。\n芳草绿以萋，采之遗所好。\n徘徊岁云晏，悠然伤我抱。\n不畏芳草歇，畏此关山道。\n关山阻且长，客子行将老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29068,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁暮","author":"宗臣","text":"岁事聿已暮，百卉何摧残。\n驱车临长河，悲飙激飞湍。\n欲济无方舟，行路一何难。\n陶潜耻折腰，贡禹弹其冠。\n出处各有性，焉能违所安。\n不见飧霞子，飘飖青云端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29069,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五子诗 其一 谢山人榛","author":"宗臣","text":"谢生隐者流，偃蹇来京国。\n朝游燕山东，暮游燕山北。\n悲歌慨以慷，惊飙奋孤翼。\n兴词日百篇，一一作者则。\n嗟彼雕虫子，不得施颜色。\n韦褐以掩形，藜藿不充食。\n荣华烨人世，匪其心所惑。\n卢生罹世网，救之一何力。\n卒能脱其患，言者长叹息。\n非吾策高踪，斯义久荆棘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29070,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五子诗 其二 李郎中攀龙","author":"宗臣","text":"大雅久寂寥，作者徒纵横。\n之子起海岳，吾道维其盟。\n中心寡所谐，长揖谢群英。\n眷言二三子，斗酒欢相迎。\n冥意何可测，奇语频自惊。\n仰并云霞翔，俯与江河倾。\n高明坠白日，非君谁与擎。\n瑶篇一以出，纷纷出时名。\n譬彼韶濩奏，缶音空尔鸣。\n功名亦垂世，无乃非其情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29071,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五子诗 其三 徐比部中行","author":"宗臣","text":"伟哉麟凤才，婉彼兰蕙质。\n含英难独持，芳华耀朝日。\n策马入金闺，声名从此溢。\n冠盖岂不荣，而独耽著述。\n结藻何翩?，札札弄缃帙。\n驾言发艺林，彷徨求侣匹。\n只言不中谐，帐望如有失。\n灿烂繁星垂，名篇谅非一。\n律吕闻凄锵，譬彼清庙瑟。\n词赋千载谋，斯人已入室。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29072,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五子诗 其四 梁比部有誉","author":"宗臣","text":"瞻彼飧霞子，万里来罗浮。\n结束长安陌，聊以寄薄游。\n中怀既不开，兀坐生羁愁。\n俛仰一世间，局促何所求。\n郁郁遂成篇，灿灿云霞流。\n凌厉起高唱，作者徒悠悠。\n人生易奄忽，焉得无深谋。\n黄庭一以悟，万事良蜉蝣。\n振衣驭天风，长逝不可留。\n咄咄迷途客，栖遑良足羞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29073,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五子诗 其五 王比部世贞","author":"宗臣","text":"天地亦寥寥，斯人怀苦心。\n弱冠厉高羽，翩?翔艺林。\n玄构入幽眇，龙涧浚其深。\n拂郁神气动，万象俱萧森。\n闭门一停思，白日常阴阴。\n雄视百代间，岂复论古今。\n高歌以慷慨，顾盻酬知音。\n不测心所之，世人空追寻。\n富贵亦云乐，而非情所钦。\n寄谢当途子，无徒耀华簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29074,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"简吴明卿舍人","author":"宗臣","text":"岩岩京洛间，天门俨九重。\n中有缨弁客，翼翼从飞龙。\n朝听比里竽，夕听南邻钟。\n嗟哉杨马才，斯人不见容。\n偃蹇以薄游，朝餐夕不供。\n抽翰灿春华，扬藻凌高峰。\n昔为一时重，今为万世宗。\n作者岂无传，谁能撄其锋。\n寄谢同心人，斯理谅可从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29075,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄江乡旧好","author":"宗臣","text":"故人渺天末，江湖阻书告。\n忽接琼瑶音，绵绵来远道。\n言采畹上兰，用以远相报。\n岂无他物贻，将投君所好。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29076,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨氏园亭饯别谢榛二首 其一","author":"宗臣","text":"名园开绮酌，芳榭停轩车。\n飞盖凌青云，冉冉振华裾。\n尊酒以斟酌，礼馔来中厨。\n秦筝奏我旁，吴歌惨不舒。\n借问远行子，离思竟何如。\n倦此燕山游，去彼漳河居。\n南北各万里，伫望沾裳衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29077,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨氏园亭饯别谢榛二首 其二","author":"宗臣","text":"离思忽超越，逍遥事行游。\n散步过华池，芙蓉夹芳流。\n悲哉蟪蛄鸣，凄切动我愁。\n凝霜莽零落，明月澹飞楼。\n感此岁华暮，耿耿生百忧。\n居者不可去，行者不可留。\n去留两不惬，何以慰绸缪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29078,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别京洛诸游三首 其一","author":"宗臣","text":"回飙振兰皋，秋风何萧森。\n神龙思远波，猛虎恋茂林。\n驾言返故乡，念子思难任。\n握手不能别，泪下沾衣襟。\n四顾何茫茫，谁为相知音。\n一为鸿鹄吟，道遥内伤心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29079,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别京洛诸游三首 其二","author":"宗臣","text":"与君结交心，世人非所窥。\n如何金石谋，忽忽生别离。\n孉娱不可再，沉思令心悲。\n君还处金闺，予将天一涯。\n江湖渺浩荡，会面茫无期。\n行人从此去，彷徨亦何为。\n君其爱玉体，慰我长渴饥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29080,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别京洛诸游三首 其三","author":"宗臣","text":"天风西北来，萧萧动高楼。\n摇落怆中怀，何以慰离忧。\n念我平生亲，涕泪不能收。\n岂不怀往路，为君暂淹留。\n执手对长河，情思良悠悠。\n愿言俱努力，千载崇良谋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29081,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"还至别业五首 其一","author":"宗臣","text":"游子倦行役，岁暮返旧疆。\n旧疆郁垒垒，观者嗟道旁。\n入门见所亲，涕下各沾裳。\n束发去家园，骨肉参以商。\n山川阻悠邈，一别永相望。\n何晤今兹夕，还复登高堂。\n兄弟敕中厨，堂上罗酒浆。\n酒中阿母言，见汝重彷徨。\n汝今幸来归，汝父在何方。\n闻之亦陨涕，四座莫不伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29082,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"还至别业五首 其二","author":"宗臣","text":"父老闻我旋，走书来相存。\n长者毡貂貐，幼者奉衣巾。\n盘飧多礼膳，络绎在吾门。\n仓皇出肃客，俱我平生亲。\n长揖失次第，各各叙寒温。\n坐中起相劳，行路多风尘。\n如何客子颜，反若生阳春。\n自汝远行游，乡国难具陈。\n豺虎满路衢，白日愁行人。\n朝餐藜与藿，夕卧无安衾。\n饥寒且不保，骨肉含苦辛。\n父老重起词，方与子所云。\n子其勿语人，恐令长吏嗔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"还至别业五首 其三","author":"宗臣","text":"结发游艺林，翩翩二三子。\n闻我返田庐，亦复来相视。\n峨峨切云冠，跄跄东郭履。\n入门将我衣，叹息伤情理。\n长跽前谢客，故人心乃尔。\n昔者远行迈，悠悠三千里。\n寒暑忽以流，眷念桑与梓。\n况我同心者，怆凄何能已。\n客请勿复叹，主人聊唯唯。\n堂上列旨酒，堂下荐嘉鲤。\n今日乐且乐，欢娱从此始。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"还至别业五首 其四","author":"宗臣","text":"驱车出郭门，远望陌与阡。\n四顾以彷徨，我马忽不前。\n别家仅俯仰，所历何推迁。\n高台或为池，崇冈或为田。\n墟里千百家，萧条无人烟。\n壮者日以衰，老者长相捐。\n纷纷少年子，白马鸣华鞭。\n旦夕成老丑，短褐不被肩。\n昔者人所钦，今者太可怜。\n见之感我心，泪下如流泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"还至别业五首 其五","author":"宗臣","text":"驾言俯长河，行行至南浦。\n荆棘一何深，没我旧时渡。\n三年滞行旅，今日返其素。\n阶上兰蕙花，是我昔所树。\n摇落萧艾旁，芬香日以故。\n洲渚郁苍苍，瞻彼鸥与鹭。\n若或见其俦，翩翩翔且顾。\n往者不可追，来者犹可悟。\n行矣事者耕，秉耒躬晨雾。\n寄谢逍遥子，与尔谐中路。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄李顺德于鳞二首 其一","author":"宗臣","text":"闻君出帝关，手握五马符。\n朝发庐龙沟，夕息涿鹿途。\n白玉挂君衣，黄金耀君躯。\n恁意殊扬扬，千骑为前驱。\n雄声满四隅，英名照八区。\n观者拥长路，皆言使君殊。\n使君自有志，岂为功名图。\n一麾乃出守，悲哉吾道孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄李顺德于鳞二首 其二","author":"宗臣","text":"煌煌京洛游，四顾浮云色。\n兴词摛雄藻，千载无终极。\n悲风起中天，奄忽乖羽翼。\n伊予归旧疆，之子出殊域。\n相去万余里，怆恻动心臆。\n登高远眺望，惟见荆与棘。\n日落豺虎吟，狐狸潜道侧。\n愿保金石躯，慰我长相忆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王元美二首 其一","author":"宗臣","text":"送子上河梁，悲风下天荒。\n右顾渺太华，左顾迷扶桑。\n振衣千仞巅，风尘杳微茫。\n尔独事远役，驾言返帝乡。\n对酒不能饮，慷慨情内伤。\n送君日以遥，思君日以长。\n安淂凌风翼，与子共翱翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王元美二首 其二","author":"宗臣","text":"执手重行行，步出城南隅。\n飞盖凌青云，食马跃长衢。\n行人不可留，中心郁以纾。\n子如云中鸿，予如汀际凫。\n浮沉既异势，羽翼何时俱。\n弩力事功名，宏此壮士图。\n愿言俟嘉誉，慰我心区区。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中与陆长庚","author":"宗臣","text":"秋日事行游，游此清江湄。\n俯视青鸟翻，仰见白日驰。\n人生寄一世，风尘岂足羁。\n贫贱安其常，富贵令身危。\n浮云起西北，帝乡不可期。\n甘此茂陵渴，愧彼首阳饥。\n商山有同调，行行歌紫芝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得吴明卿书","author":"宗臣","text":"瞻彼双飞鸿，羽翼何参差。\n哀鸣下前庭，素书忽见贻。\n开函长跪读，一一故人词。\n相违日已远，犹能忆吾私。\n忽思畴昔容，惆怅使心悲。\n受君双交绮，报君双桂枝。\n此物未为贵，聊结山中期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀谢山人茂秦一首","author":"宗臣","text":"惊飙动四野，白露下前除。\n揽衣起四顾，悠然怀所思。\n所思亦何在，乃在漳南居。\n朝设穆生醴，夕曳邹阳裾。\n西园事行游，飞盖列应徐。\n近者日以亲，远者日以疏。\n不念同心人，所须在音书。\n音书不一寄，何以慰踌躇。\n三复游燕篇，踌躇聊以舒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄子与","author":"宗臣","text":"清晨发东郊，兰蕙何灼灼。\n采之遗我友，我友在京洛。\n道路邈以修，羽翼谁能托。\n但恐霜露垂，馨香日零落。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七哀诗为伊氏作","author":"宗臣","text":"惊飙动高林，荆榛迷路岐。\n中有愁思妇，哀叹一何悲。\n借问悲何为，乃为良人思。\n良人一以逝，十载守空帷。\n十载何足言，千秋常若斯。\n风波一朝起，骨肉以相疑。\n生者不可拒，死者不可追。\n宁使妾身捐，岂使妾行亏。\n痛哭回白日，惨黯黄云垂。\n青山一愤绝，重泉以为期。\n寄谢朱颜者，贪生良足嗤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]