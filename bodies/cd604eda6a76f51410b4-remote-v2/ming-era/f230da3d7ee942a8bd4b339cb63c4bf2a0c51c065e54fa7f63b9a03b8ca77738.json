[{"title":"梅花百咏 其九十 高畅","author":"李江","text":"淡影深笼浅浅溪，香浮晓色月枝低。\n欲寻程子同佳景，也拜尧夫学品题。\n岁晚偏惊髯奋戟，春晴不似絮沾泥。\n眼前多少诸儿女，花滟纷纷绕大堤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55016,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其九十一 表仪","author":"李江","text":"人有圣贤物亦然，梅花品第亦神仙。\n谁移阆苑来窗外，能驾飞车到槛前。\n白屋玉堂甘寂寞，红楼脂粉任姻缘。\n欲拈至治馨香语，长挂梢头照海边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55017,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其九十二 形色","author":"李江","text":"谁酌寒江洗绝绡，玻璃千顷漾琼瑶。\n横斜深浅堪描画，疏古清奇难篆雕。\n东海南山长共老，青娥素女不相饶。\n水晶帘外罗浮路，两袖仙风过铁桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55018,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其九十三 即景","author":"李江","text":"疏帘寒影共徘徊，雪里癯颜镜里开。\n路冷每怜知己少，眼前应喜故人来。\n短墙路隔千层壁，曲槛花连百尺台。\n自信所闻如所见，吴江枫落不须猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55019,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其九十四 感怀","author":"李江","text":"寂寞江滨路色赊，岁寒气味不繁华。\n苍髯老叟云千里，直节故人天一涯。\n清瘦岂疑诗俊逸，横斜不类左浮誇。\n几回写遍天南景，南北风光总一家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55020,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其九十五 主一","author":"李江","text":"拨开洞府景无边，浓抹冰光淡抹烟。\n盛德深沉容貌古，性灵虚觉梦魂仙。\n残灯落尽风回阁，瀣露倾清月洗天。\n主一老翁无所适，独留风月坐窗前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55021,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其九十六 闻望","author":"李江","text":"浓淡横斜孰剪裁，自怜闻望混尘埃。\n谁知雪里风中事，曾是天成地设来。\n山峭斗寒如弗及，对花酌酒漫徘徊。\n杜公自笑头颅白，只为相看朝夕催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55022,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其九十七 致知格物","author":"李江","text":"五行性质本完全，五事由来貌始先。\n一旦栽培根得地，百年英锐色参天。\n披襟弄月乘风舞，逐步看花与斗旋。\n方法分明有纲领，许多条目自昭然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55023,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其九十八 显仁藏用","author":"李江","text":"雪融冰涣五更寒，冷逼师雄梦未残。\n肝胆清新天地晓，性情涵泳海山宽。\n疏枝浅水皆漪景，瘦绿肥红任纵观。\n昨日尚嫌春信晚，今朝飞入玉栏杆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55024,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其九十九 胜","author":"李江","text":"水浅沙寒路委偏，风花雪月皓无边。\n主人爱月长陪坐，诗伯临风相对联。\n雪后静观山似画，花前闲步伴如仙。\n纤尘不到柴门远，恍惚蓬莱十二天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55025,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其一○○ 复","author":"李江","text":"地雷通信不迟留，画出梅花为点筹。\n造化一心从此见，历元于古可推求。\n理于生处原无尽，气到穷时又转头。\n三十六宫春不断，天根月窟自周流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55026,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风哀十首 其一","author":"李江","text":"八姨凄切起秋声，肠断萧萧不忍听。\n十五于归宜妇道，百年多别为云程。\n山容冷淡人心苦，水色荒凉客梦惊。\n云散天寒明月落，八姨凄切起秋声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55027,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风哀十首 其二","author":"李江","text":"九天寥落夜无声，孤枕青灯客梦惊。\n春暖花神原不老，秋寒月姊自长生。\n绿窗人去千年别，中馈心留一段情。\n此恨西风吹不断，九天寥落夜无声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55028,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风哀十首 其三","author":"李江","text":"云影涛声天地悲，酸风凄切动愁思。\n夫君万里登天日，儿子三秋学语时。\n此恨那能消得尽，有缘何处再相期。\n晚来独向花前坐，云影涛声天地悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55029,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风哀十首 其四","author":"李江","text":"露垂珠泪滴花枝，滴断花枝天不知。\n缘分只期天到底，纲常也赖尔扶之。\n西风吹破三更梦，细雨寒生万里思。\n惆怅一声寥落外，露垂珠泪滴花枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55030,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风哀十首 其五","author":"李江","text":"鼓盆声断感庄生，叶落花残蝶梦惊。\n堂上月明姑舅老，眼中云散海田更。\n鸟啼猿哭恨千古，地冷天寒歌一声。\n泪滴西风心欲折，鼓盆声断感庄生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55031,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风哀十首 其六","author":"李江","text":"炊臼梦残气寂寥，眼中无火为谁烧。\n天涯行李未回首，人世姻缘断此朝。\n砧杵秋声云似杳，桑麻秋色雨空飘。\n西风冲破愁城外，炊臼梦残气寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55032,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风哀十首 其七","author":"李江","text":"鹊桥云断误佳期，泪滴西风事已移。\n捣杵声沈明月冷，蒸梨火尽暮烟迟。\n人间天上今分两，草木山川总为悲。\n欲寄锦文何日到，鹊桥云断误佳期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55033,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风哀十首 其八","author":"李江","text":"鱼轩月冷锁深帷，怪杀冰人不此知。\n尘鞅鹿车飞尽处，辘轳金井断牵时。\n不嫌荆布安常分，只望诗书可疗饥。\n一段姻缘全未了，鱼轩月冷锁深帷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55034,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风哀十首 其九","author":"李江","text":"古木秋声入梦中，空山琴瑟夜西风。\n糟糠麻枲宜相老，针线衣裳不斗工。\n云鹤心伤燕水北，雾猿肠断粤山东。\n愁来不觉凄凉处，古木秋声入梦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55035,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风哀十首 其十","author":"李江","text":"寒江夜泊自生哀，一阵江风一阵摧。\n花落水流情不尽，海枯石烂恨难灰。\n相思极目长万里，独叹愁肠每九回。\n果若人言虽不哭，寒江夜泊自生哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55036,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月哀十首 其一","author":"李江","text":"嫦娥殿冷锁黄昏，古木悲听声断猿。\n三十一年天外别，八千馀路梦中魂。\n蟾宫阙在清虚府，连理枝生丽水村。\n帘捲窗前空自洎，嫦娥殿冷锁黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55037,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月哀十首 其二","author":"李江","text":"婺女星沈五更长，银河倒影照愁肠。\n蚕桑事往心常苦，巾栉身能义亦当。\n雁去只凭传消息，秋来谁为寄衣裳。\n凄凉一点西风泪，婺女星沈五更长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55038,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月哀十首 其三","author":"李江","text":"雀屏虚影夜悠悠，有分天缘未到头。\n欢喜教儿蕉有叶，荒凉望石泪空流。\n鸟啼花落人如梦，冰冷霜寒月似秋。\n惆怅人生真不偶，雀屏虚影夜悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55039,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月哀十首 其四","author":"李江","text":"妆台暮冷短帘低，惆怅花前月已西。\n蝴蝶梦中风切切，杜鹃声里夜凄凄。\n只将补缀当罗绮，惟爱裙钗胜玉鎞。\n剔尽残灯肠欲断，妆台暮冷短帘低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55040,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月哀十首 其五","author":"李江","text":"綵云天远雁声残，望断音书归问安。\n垂白七旬甘旨缺，孩提三岁锦绷单。\n绩麻夜点松灯坐，捣药风生砧杵寒。\n只计前程在燕地，綵云天远雁声残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55041,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月哀十首 其六","author":"李江","text":"蓝田烟冷玉如冰，暮雨霏微草自凌。\n雍伯栽时天有意，卞和泣处世无凭。\n千年一句留红叶，夙世今宵断赤绳。\n魂梦不知何处去，蓝田烟冷玉如冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55042,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月哀十首 其七","author":"李江","text":"碧汉空虚淡欲流，九天无路夜悠悠。\n彩虹鹊拥云屏远，宝婺星高月镜秋。\n万里邺侯期世用，一花司马愿簪头。\n九霄举目无穷极，碧汉空虚淡欲流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55043,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月哀十首 其八","author":"李江","text":"绿窗寂寞月斜曛，万里游人讣不闻。\n愁杀春花付流水，空教天合似浮云。\n风寒帐底弦声绝，晓冷鸾中镜影分。\n人世看来真似梦，绿窗寂寞月斜曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55044,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月哀十首 其九","author":"李江","text":"玉露凄凉半夜时，花前泪滴枕前思。\n扊扅炊罢春烟冷，机杵声沈月色澌。\n百岁只期依老母，一朝何事别孤儿。\n此情若问堪伤处，玉露凄凉夜半时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55045,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月哀十首 其十","author":"李江","text":"金风萧瑟玉轮秋，古木声中不尽愁。\n自恨镜盆今已破，谁拈玉斧又重修。\n东西云散青山断，日夜江长绿水流。\n三十一年今已矣，金风萧瑟玉轮秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55046,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山哀十首 其一","author":"李江","text":"天门夕照暗黄昏，肠断西风恨自吞。\n花落忽惊千里梦，月明空印五更痕。\n岁邻单阏烹雌别，景未桑榆落日冤。\n魂魄精神在何处，天门夕照暗黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55047,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山哀十首 其二","author":"李江","text":"地户寒云锁万山，剥来天地泪空潸。\n焦桐入梦魂应断，上苑看花人未还。\n路上稍书天上喜，膝前抱玉眼前閒。\n八千里路南连北，地户寒云锁万山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55048,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山哀十首 其三","author":"李江","text":"三宫杳霭梦魂劳，怕听鹃声夜半号。\n月照心愁深似海，风吹怨恨快如刀。\n仙游洞府三千里，老恨青天九万高。\n却恐久忘花外路，三宫杳霭梦魂劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55049,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山哀十首 其四","author":"李江","text":"五峰缥缈雾岚深，花落春寒水木阴。\n天柱外头云漠漠，祝融中里夜沉沉。\n百年断自三更梦，千古留来一点心。\n纵有临风真道士，五峰缥缈雾岚深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55050,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山哀十首 其五","author":"李江","text":"昆崙夜雨动凄凉，一阵西风百感伤。\n妇妇性情归梦寐，卿卿声语付心肠。\n三千城外瑶池远，十二栏前翠水长。\n何日云间扶凤夙，昆崙夜雨动凄凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55051,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山哀十首 其六","author":"李江","text":"天台岁暮重堪悲，花落花开两路离。\n月照泪痕粘凤枕，风生情义动鸳闱。\n碧纱红树荒凉处，白石苍苔寂寞时。\n此恨不知何日了，天台岁暮重堪悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55052,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山哀十首 其七","author":"李江","text":"玉女春归路正长，东风吹断此韶光。\n匣封尘鞅菱波冷，月破弦棱桂影伤。\n云锁青溪空九曲，花粘白沼恨三娘。\n久为人世从今别，玉女春归路正长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55053,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山哀十首 其八","author":"李江","text":"铁桥云绝暮鹃号，人世尘缘空郁陶。\n射策高占京里寓，学言稚子膝前嚣。\n春归玉露凋瑶草，秋到仙风落碧桃。\n翻想前头真似梦，铁桥云冷暮鹃号。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55054,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山哀十首 其九","author":"李江","text":"蓬岛仙游万里间，悠悠何处不知还。\n麻姑洞彻春天远，王母楼前夜月閒。\n云鹊飘飘山影断，夜莺恰恰雨声潺。\n东风谢却桃花面，蓬岛仙游万里间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55055,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山哀十首 其十","author":"李江","text":"阆苑花飞可怆神，仙家谁为不长春。\n碧桃带雨愁如故，玉树含烟怅自新。\n三万六千虽有算，百年双老几何人。\n那堪夙愿都无是，阆苑花飞可怆神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55056,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水哀十首 其一","author":"李江","text":"玉露飞寒浪捲花，却愁流尽此年华。\n高堂供奉亲炊黍，中馈辛勤自缉麻。\n守分不嫌无锦绮，疗饥只喜有书车。\n此情怕听泉声响，玉露飞寒浪捲花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55057,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水哀十首 其二","author":"李江","text":"银河泻冷滴枝花，云散香沈月色斜。\n中馈夜寒机纤恨，驾天桥断斗牛嗟。\n眼前光景如惊梦，帐里音容似隔霞。\n风急飙轮人去远，银河泻冷滴枝花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55058,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水哀十首 其三","author":"李江","text":"十州晚浪远如秋，寒带西风日夜流。\n几幅浮云笼弱水，一番悲雨暗丹邱。\n机声了断天孙锦，蓬叶空飘太乙舟。\n千古姻缘今日别，十州晚浪远如秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55059,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水哀十首 其四","author":"李江","text":"五湖夜月路茫茫，花落春归欲断肠。\n客枕不离鸳枕冷，家书犹会鲤书长。\n亲年喜老凭供旨，京寓怕寒望寄裳。\n回首不堪千点泪，五湖夜月路茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55060,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水哀十首 其五","author":"李江","text":"桃源春别景荒凉，风断临流滴泪长。\n千里两京悲似梦，一朝千古恨偏长。\n蒹葭玉树知相倚，青桂嫦娥喜莫量。\n情义不堪成惨怆，桃源春别景荒凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55061,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水哀十首 其六","author":"李江","text":"瀛洲风冷梦中天，仙境如何亦变迁。\n玉树锦云成寂寞，春花秋月可堪怜。\n青山色似伤炊臼，流水声中哭断弦。\n万古千秋从一别，瀛洲风冷梦中天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55062,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水哀十首 其七","author":"李江","text":"桑田秋尽海涯枯，花落香消事已徂。\n琴瑟清音从此绝，纲常大义望谁扶。\n德宫身死空成恨，月老当初料也无。\n万丈赤绳今打断，桑田秋尽海涯枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55063,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水哀十首 其八","author":"李江","text":"尾闾澜倒暮天寒，福海如何一夜乾。\n黄纸金花该有分，望夫教子自知欢。\n斜阳返照身何在，大壑归流梦不安。\n自此飘然成永别，尾闾澜倒暮天寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55064,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水哀十首 其九","author":"李江","text":"龙门流断眼中过，百载春光掷一梭。\n偕老本期终莫尽，朱弦无奈断来何。\n千年丹桂依明月，万丈长松附女萝。\n那料半途遭不偶，龙门流断眼中过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55065,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水哀十首 其十","author":"李江","text":"灵府泉飞日夜流，河源本不计春秋。\n午阴花落看来恨，晴日鸠声听里愁。\n云锁昆崙风切切，雾笼天柱夜悠悠。\n无穷情爱从今了，灵府泉飞日夜流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55066,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花哀十首 其一","author":"李江","text":"海棠泣露泪西风，百载春光一梦中。\n静穆月明看旧德，杳茫路远失真容。\n九泉长夜香魂断，一日如秋夙望空。\n借问凄凉憔悴处，海棠泣露泪西风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55067,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花哀十首 其二","author":"李江","text":"牡丹悲雨夜西风，独对栏杆恨几重。\n玉骨不曾离月外，香魂疑是绕花中。\n千娇万态羞无分，暮落朝开更不同。\n人世年光真可惜，牡丹悲雨夜西风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55068,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花哀十首 其三","author":"李江","text":"菊坠黄华自可伤，花前犹想旧时香。\n糟糠贫贱宜相守，富贵荣华岂尔忘。\n五典彝伦夫妇重，三纲恩义地天长。\n那堪一夕秋霜外，菊坠黄华自可伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55069,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花哀十首 其四","author":"李江","text":"兰凋玉穗景伤春，国色天香恨失真。\n太学荠盐知自喜，高堂供奉只随贫。\n月寒雎鸟空啼怨，镜破鸾妆也怆神。\n风雨一时无可奈，兰凋玉穗景伤春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55070,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花哀十首 其五","author":"李江","text":"春暮花残月色昏，逝随流水恨还吞。\n听鸾不见窗前影，跨凤空飞夜半魂。\n万里稀音愁客路，五云声动喜天阍。\n个中悽怆无人问，春暮花残月色昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55071,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花哀十首 其六","author":"李江","text":"秋香月薄夜凄清，风冷花寒甚苦情。\n夫妇到头谁不愿，乾坤何事误长生。\n缉麻本分依中馈，寄信平安问两京。\n太息绿窗人不在，秋香月薄夜凄清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55072,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花哀十首 其七","author":"李江","text":"草头秋露婺星寒，泪洒西风鼻亦酸。\n结发只期同享福，仰夫争奈未为官。\n布裙蔽体破还补，藜饭餐时贫亦安。\n独倚楼前如一梦，草头秋露婺星寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55073,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花哀十首 其八","author":"李江","text":"隙外光阴落木悲，秋光花色月离离。\n菱花影里青鸾失，纨扇风前旧手遗。\n琴韵已非成好合，砧声只是忆空帷。\n天公实不如人意，隙外光阴落木悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55074,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花哀十首 其九","author":"李江","text":"仙草离离事可悲，家风还许后人知。\n一杯合卺今成梦，百岁同缘已了期。\n麟角岂云无可煮，鸾音只恐与前移。\n眼中一点庄生泪，仙草离离事可悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55075,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花哀十首 其十","author":"李江","text":"秋影荒凉秋月移，金风吹落菊花枝。\n在机每为夫君下，守己还教妯娌知。\n主馈千年犹可念，焚黄九土愿无迟。\n小窗独坐伤情处，秋影荒凉秋月移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55076,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"木哀十首 其一","author":"李江","text":"蟠桃秋叶落风寒，叶落风寒鼻亦酸。\n阆苑云空仙梦断，瑶池月落酒杯乾。\n韶华已付随流水，好合何期隔远峦。\n恼杀春花长不住，蟠桃秋叶落风寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55077,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"木哀十首 其二","author":"李江","text":"桑榆晚影自凄凉，泣月悲风问彼苍。\n中馈甘为荆布拙，寒门未识绮罗香。\n同声同气成虚事，宜室宜家了一场。\n脩短有期虽古语，桑榆晚影自凄凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55078,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"木哀十首 其三","author":"李江","text":"幽谷重阴锁暮寒，一重云树一重阑。\n玉兰秋叶西风落，瑶草春香北两残。\n山外屯岚如恨积，涧边流水似心酸。\n不知天意知人否，幽谷重阴锁暮寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55079,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]