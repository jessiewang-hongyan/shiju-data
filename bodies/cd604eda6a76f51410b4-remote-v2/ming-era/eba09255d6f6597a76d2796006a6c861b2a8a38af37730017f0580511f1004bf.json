[{"title":"送妓入道 其二","author":"徐熥","text":"愁把芳年老狭邪，欲寻铅汞洗铅华。\n西园公子求遗佩，南岳夫人赠紫霞。\n翠袖正宜过碧海，朱颜偏可饵丹砂。\n玉声已奏仙家乐，不向江心抱琵琶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题郭士龙隐居","author":"徐熥","text":"壶公山色白云齐，一室萧然隐者栖。\n短屐每寻芳草路，轻舟时泛木兰溪。\n春深绿酒闻莺语，昼静玄经落燕泥。\n欲觅武陵何处所，桃花干树使人迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23387,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林方伯先生七十初度是日为吕纯阳诞辰","author":"徐熥","text":"共传薇省即蓬壶，白发中朝老大夫。\n申甫何年曾降岳，仙翁此日正悬弧。\n一杯琼液承金掌，九转丹砂在玉炉。\n莫是贞元前进士，托生尘世住玄都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23388,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人还九江","author":"徐熥","text":"送君西去路漫漫，二月东风拥去鞍。\n彭蠡惊涛云外听，匡庐飞瀑月中看。\n天涯草色今犹短，驿路杨花尚未残。\n不用临岐倍惆怅，一尊还共醉长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23389,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读礼感怀 其一","author":"徐熥","text":"相见黄泉未有期，每思往事泪交颐。\n蠹生残箧长留粉，蛛匿空房乱结丝。\n花径尚看扶杖处，柽阴犹记纳凉时。\n绵绵此恨应无尽，忍读风人陟岵诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23390,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读礼感怀 其二","author":"徐熥","text":"何事当年便绝裾，误人应是荐贤书。\n九天无处阍堪叩，三釜如今愿已虚。\n却恨别离同梦寐，还惊日月易居诸。\n从今不起云霄念，长向花间御板舆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23391,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读礼感怀 其三","author":"徐熥","text":"素车白马出燕关，风急云寒雪满山。\n当日已拚成死孝，此身何敢望生还。\n忍看堂上遗容在，无复花前舞袖斑。\n丹旐翩翩人不见，抚床空有泪潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23392,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读礼感怀 其四","author":"徐熥","text":"哭向灵帏唤不醒，可怜从此隔幽冥。\n双凫影绝人何处，五柳阴浓户自扃。\n藉草祗今稀酒伴，种花谁复课园丁。\n回思二十年前事，日日窗前教一经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23393,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送兴公弟之吴为先人乞铭 其一","author":"徐熥","text":"衔哀送汝出江关，满路悲风损别颜。\n此日素车驱白马，几时黄绢勒青山。\n梦回草色离肠断，身着麻衣血泪斑。\n怜我双眸枯欲尽，不堪分手更潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23394,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送兴公弟之吴为先人乞铭 其二","author":"徐熥","text":"叮咛数语泪千行，此去关山路渺茫。\n三伏炎蒸过剑浦，一江风雨度钱塘。\n魂随远屿孤鸿断，目极遥天匹练长。\n当念倚门双白发，莫将行色滞他乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23395,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王玉生游吴","author":"徐熥","text":"几树蝉声乱夕晖，送君无奈泪沾衣。\n花间此日人伤别，竹里从今客到稀。\n吴苑山川行处遍，横塘烟雨望中微。\n登楼王粲多乡思，目断秋风一雁归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23396,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄王百谷","author":"徐熥","text":"三载吴门两见君，别来相忆倍殷勤。\n梦回半偈庵前月，望断姑苏台上云。\n赤牍此时凭雁足，黄庭何日换鹅群。\n先人墓所丰碑在，应赖邯郸绝代文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23397,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王大游吴兼讯舍弟","author":"徐熥","text":"潇潇风雨满征途，一片轻帆过阖闾。\n路指蛇门怀伍相，剑藏鱼腹吊专诸。\n砧敲八月寒声早，叶下三江树影疏。\n若到吴阊凭问讯，天涯游子近何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23398,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈子卿归墨潭精舍","author":"徐熥","text":"送君归咏卜居篇，精舍平临绝涧前。\n翠壁倒悬潭似墨，苍林遥望树如烟。\n月移竹色当虚牖，风落松花满钓船。\n闻说汉庭方羽猎，未应寂寞老扬玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23399,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨夜登玉皇阁","author":"徐熥","text":"鳌顶秋深起夜凉，飘飘云气黯虚堂。\n丹烧九转成金母，阁耸千寻礼玉皇。\n灯影乍沉孤嶂雨，磬声微度半林霜。\n古坛坐久天花落，不觉馀香满石床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23400,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋同惟秦震卿集汝大草堂看月因怀惟起客吴","author":"徐熥","text":"西风萧瑟叶初黄，入夜行歌过草堂。\n金粟散时天似水，玉绳低处月如霜。\n尊前竹色浮秋霭，槛外松阴度晚凉。\n遥望南飞有乌鹊，应怜游子滞他乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23401,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"逢庆良上人","author":"徐熥","text":"东林结社已多年，忽汎慈航到海边。\n自是真空能出世，谁知绮语不妨禅。\n洗瓢曲涧摇寒月，卓锡深山破暝烟。\n几度相从谈胜果，无诸城外即诸天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23402,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送良上人还金陵静海寺","author":"徐熥","text":"枫叶萧萧露气凝，不堪江畔送名僧。\n浮杯忍作无期别，说法谁参最上乘。\n满路凄风闻宝磬，一天残月梦金陵。\n悬知锡杖重来处，传得南宗几佛灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23403,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王百谷为先永宁表墓寄此答谢","author":"徐熥","text":"西风吹雁出菰芦，尺素衔来字字珠。\n倚马万言推绣虎，皋鱼双泪感啼乌。\n通家敢谓同文举，名笔何缘借董狐。\n片石空山垂不朽，千秋应得免樵苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23404,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王生之临邛省州守叔父献甫 其一","author":"徐熥","text":"西北胡笳不断吹，送君南浦泪如丝。\n荆门树影云中尽，巫峡猿声月下悲。\n客路装轻怀匕首，驿楼灯现望峨眉。\n天涯何处能相忆，孤馆残更梦觉时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23405,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王生之临邛省州守叔父献甫 其二","author":"徐熥","text":"驱车万里向殊方，极目邛崃路渺茫。\n官舍烟云邻越巂，人家风土杂夷羌。\n绮琴曲里挑新寡，鼙鼓声中忆故乡。\n丙穴由来鱼不乏，八行书札莫相忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23406,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读礼日谢在杭拜官湖州便道还家见访赋赠","author":"徐熥","text":"当时同听鹿鸣歌，此日云霄与薜萝。\n鸡骨支来天上泣，马蹄惊向巷中过。\n经年聚散踪无定，一见悲欢泪更多。\n天上星辰催执法，相思又隔五湖波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"后感怀 其一","author":"徐熥","text":"家难相寻最可怜，麻衣如雪泪如泉。\n慈雏返哺嗟无日，熊胆和丸忆昔年。\n总为易凋萱草色，却教重废蓼莪篇。\n杯棬尚在人何处，不待持来已惨然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"后感怀 其二","author":"徐熥","text":"满目悲风起白杨，幽明相隔路茫茫。\n穗帷尘暗灵何在，宝婺星沉夜不光。\n忽尔无心呼阿母，犹然有梦礼医王。\n板舆此日难重御，一到花间一断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"后感怀 其三","author":"徐熥","text":"才入庭帏便怆情，遗容犹在不闻声。\n蜀魂未化啼尤切，精卫空填恨岂平。\n怀似陆郎徒有橘，孝惭考叔竟无羹。\n可怜神理年来尽，已向尘中厌久生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23410,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"后感怀 其四","author":"徐熥","text":"一夕音容背北堂，人间那得返魂香。\n百年浑似枝头露，双鬓难留镜里霜。\n爻象谩劳推季主，刀圭空复藉韩康。\n此身不但如荼苦，血泪千行更万行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23411,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭李惟实孝廉 其一","author":"徐熥","text":"寒云惨淡日黄昏，壮士长衔万古冤。\n易水当年歌变徵，湘潭此日赋招魂。\n妖狐夜半啼原野，山鬼秋深哭墓门。\n明岁素车过五岭，为君?泪荐芳荪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23412,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭李惟实孝廉 其二","author":"徐熥","text":"少年侠客擅词华，埋玉空山事可嗟。\n自是关门多虎豹，总缘岁序在龙蛇。\n诗馀长吉囊中草，梦绝文通笔里花。\n十载交情惟一哭，西风吹泪到天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭李惟实孝廉 其三","author":"徐熥","text":"曾同击筑醉燕都，意气翩翩似狗屠。\n良友忽传成死别，故人犹未束生刍。\n秦廷恸哭知多少，梁狱投书果有无。\n我在苦中情更苦，伤君那禁泪模糊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭李惟实孝廉 其四","author":"徐熥","text":"重泉冥漠隔知音，从此交期梦里寻。\n飒飒悲风天外急，离离芳草墓前深。\n千秋独抱亡琴痛，万里空怀许剑心。\n杯酒他年浇白骨，北邙松柏恐成林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄刘季德","author":"徐熥","text":"故人踪迹久相违，何事犹然一布衣。\n九鲤烟霞归草屩，五羊山水寄金徽。\n竹期王子重来看，花向刘郎别后飞。\n千里停云情不浅，秋风莫遣雁鸿稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄许灵长","author":"徐熥","text":"年来何处寄行踪，闻在吴山第一峰。\n古洞烟霞生薜荔，寒窗风雨泣芙蓉。\n万家灯影千村月，半夜歌声满寺钟。\n几度思君劳梦寐，钱唐江上水重重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄旷上人","author":"徐熥","text":"瓢笠何年住化城，闭关跏坐梦魂清。\n双双月下浮屠影，夜夜云间断磬声。\n悟彻空花诸相灭，翻残贝叶一灯明。\n几时结得东林社，共證菩提了此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邓汝高进士转饷辽东便道过家见访喜赠","author":"徐熥","text":"才华籍籍赋长杨，裘马翩翩出建章。\n辽海军储凭转饷，汉廷郎署待含香。\n笑谈不带云霄气，名姓新依日月光。\n独有故人憔悴甚，岂堪相对问行藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送在杭司理湖州 其一","author":"徐熥","text":"少年拥传暂还家，捧檄新乘上汉槎。\n地接洞庭多橘柚，郡称泽国半桑麻。\n省刑网好开三面，判事才能出五花。\n手折衰杨从此别，梦魂飞不到天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送在杭司理湖州 其二","author":"徐熥","text":"长安跃马主恩新，词客今为执法臣。\n苕水共看初带印，沧波由此罢垂纶。\n宽同汉室于廷尉，情似樊川杜舍人。\n何处公馀堪引眺，三江烟雨五湖春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送在杭司理湖州 其三","author":"徐熥","text":"曾将才藻擅词坛，此日新弹贡禹冠。\n早岁共称贤宅相，少年初拜汉郎官。\n霅溪水响褰帷听，顾渚山高拄笏看。\n自是法曹关象纬，霜威先已逼人寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送在杭司理湖州 其四","author":"徐熥","text":"争传词赋是玄晖，捧得除书昼锦归。\n属吏共迎新绿绶，世家犹说旧乌衣。\n征亭霜冷孤鸿断，驿路天长驷马飞。\n君去已陪鹓鹭侣，不才空守钓鱼矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄答沈从先","author":"徐熥","text":"海国秋高一雁轻，题书千里见交情。\n鹿门君已逃踪迹，鹤市谁能识姓名。\n玄草谩忧瓿上覆，彩花长向笔中生。\n浅才何敢当皇甫，欲序三都愧未成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得胡御长诗却寄","author":"徐熥","text":"踪迹年来混酒徒，独留名姓满江湖。\n卜居已傍三天竺，处世犹悲五石瓠。\n刻石好辞传幼妇，闭门高论著潜夫。\n胸中莫是波斯国，寄得瑶函字字珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭周所谐 其一","author":"徐熥","text":"开缄忽报故人亡，双泪如倾几断肠。\n挂剑未能同季子，知音何处觅周郎。\n到来已叹交驩浅，死去空怜别恨长。\n多少遗编犹在箧，一回吟咏一凄凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭周所谐 其二","author":"徐熥","text":"当年风雨出芝山，行李萧然夜度关。\n自谓千秋同艺苑，何期此夕谢人间。\n几时客作鸣驴吊，何日人能化鹤还。\n一掬木兰溪上泪，溪声应共泪潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭周所谐 其三","author":"徐熥","text":"百年交谊隔泉扃，遥对西风泪自零。\n欲以遗文托行世，敢将良友负幽冥。\n朱弦既断谁同调，邻篴重吹岂可听。\n不道精灵沉已久，夜来犹望少微星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭周所谐 其四","author":"徐熥","text":"生来长咏四愁诗，死后凄凉更可悲。\n二顷久无尘满甑，一家虽在命如丝。\n人亡正及黄花节，客吊空违宿草期。\n未抚灵床先哽咽，难将遗嘱问孤儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏柬谢使君","author":"徐熥","text":"绿衣红袖两相宜，况值还家得意时。\n夜夜琴心调凤曲，双双屐齿伴蛾眉。\n月明古渡寻桃叶，露冷空江唱竹枝。\n不俟五湖携粉黛，今朝先已载西施。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠佘宗汉明府 其一","author":"徐熥","text":"青鬓郎官早息机，抛将墨绶变荷衣。\n一裘已傍壶山隐，双舄宁从帝里飞。\n饮似公荣常得醉，游同禽庆久忘归。\n年来门巷清如水，惟有寒鸥伴钓矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠佘宗汉明府 其二","author":"徐熥","text":"翩翩辞赋似西京，四壁萧然类马卿。\n山水到时皆屐迹，江湖何处不诗名。\n閒来柳向门前种，老去花犹笔里生。\n岁晏赍粮过九鲤，与君长啸结鸥盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李廷晔令东莞兼柬邓香山 其一","author":"徐熥","text":"初从北阙佩鸣珂，拥传遥从五岭过。\n官馔自今多海错，童谣强半是黎歌。\n广州旧甓寻陶侃，粤国荒台吊尉陀。\n只恐簿书能俗客，一封那肯问渔蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李廷晔令东莞兼柬邓香山 其二","author":"徐熥","text":"新悬墨绶赴炎方，道过家林束别装。\n海邑三秋椰子熟，公庭六月荔枝香。\n台中谒帝飞双舄，郡里寻仙问五羊。\n莫向天涯思故国，一时冠盖半同乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送丁亨文进士司理召陵 其一","author":"徐熥","text":"新将词赋献承明，万里分符佐楚荆。\n道上竹深妃子庙，郡中花暗白公城。\n山连五岭重重翠，水接三湘曲曲清。\n此去王程君莫缓，几多人吏待持平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送丁亨文进士司理召陵 其二","author":"徐熥","text":"洞庭湖上片帆轻，万顷微茫接太清。\n楚甸峰峦天际杳，巫山云雨梦中生。\n霜侵远渚鲟千尺，月照寒芦雁一声。\n白露渐零衣渐冷，遥知宋玉不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邓汝高雨中载酒见访分得园字","author":"徐熥","text":"甘将踪迹老丘园，忽听轩车到荜门。\n篱下一尊残菊色，林间双屐旧苔痕。\n暝烟疏雨山山暗，落木寒泉处处喧。\n今日主人翻作客，不须送客独留髡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"侯君右来自永嘉喜赠","author":"徐熥","text":"西园公子旧知名，负剑长歌海上行。\n何日寝丘酬楚相，谁人虚席重侯生。\n赋成白雪骄彤管，衣带朱霞恋赤城。\n闻说临邛方贵客，莫因残岁急归程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠黄道晦隐君 其一","author":"徐熥","text":"鸡犬声中隐者居，桃花流水绕庭除。\n芝苓服久容颜古，草莽交深世态疏。\n千顷沧江移艇钓，一犁春雨带经锄。\n有时唤渡过城市，不是脩琴即借书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠黄道晦隐君 其二","author":"徐熥","text":"白首幽栖只一区，耻将名姓世人呼。\n读书借得村中社，岁胜看将壁上图。\n地僻绝来高士驾，家贫先办县官租。\n山厨不问炊烟少，犹向桑间饭饿夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"问黄道晦病","author":"徐熥","text":"久讶扁舟不出溪，闻君抱病意悽悽。\n空山日晚阳乌促，古砌天阴络纬啼。\n夜冷谁人同襆被，地偏何处得刀圭。\n一从消渴文园后，门外蓬蒿与榻齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"方广岩","author":"徐熥","text":"欲觅精庐问化机，苍苍鸟道客游稀。\n上方云起暮山冷，半岭日斜残雪飞。\n古树猿惊樵子过，寒林厖吠野僧归。\n路迷叠嶂不知处，但听磬声来翠微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿华严阁","author":"徐熥","text":"万仞岩中隐化城，倚栏遥望暮云平。\n断桥残雪寒山影，绝磴凄风晚磬声。\n坐对水帘尘虑远，眠当石榻梦魂清。\n因兹悟得西来意，欲向空门了此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岩中晓望","author":"徐熥","text":"早起看山露气浓，玄岩古院有云封。\n微风入室度清梵，斜月挂林闻曙钟。\n猿带晓声过碧嶂，鹤留残梦出青松。\n倚阑但听水帘响，失却翠微千万重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重游锦溪怀邓汝高进士","author":"徐熥","text":"断桥流水自潺湲，与客重来忆所驩。\n当日共看溪上竹，于今偏握省中兰。\n云生万壑孤筇湿，雪满千山两屐寒。\n住散不须增感慨，一尊林下且盘桓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壬辰除夕","author":"徐熥","text":"人事悠悠岁月徂，堂前空对一灯孤。\n哀来瘦骨全如鹤，听得啼声半是乌。\n酹酒几回悲伏腊，称觞明日罢屠苏。\n春风不散终天恨，断尽柔肠泪欲枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23446,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"癸巳元日","author":"徐熥","text":"袅袅东风处处吹，萧条门巷自堪悲。\n独斟柏叶愁如缕，閒对菱花鬓有丝。\n三十虚名归马齿，半生薄命怨蛾眉。\n寒梅不管人无赖，开遍南枝与北枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23447,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"迎春日","author":"徐熥","text":"风流太守驾朱轮，五马骄嘶九陌尘。\n椒实共拚今日醉，梅花先报一年春。\n娇莺乍啭声犹涩，綵燕初裁色更新。\n市井繁华箫鼓沸，停鞭齐看玉楼人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23448,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]