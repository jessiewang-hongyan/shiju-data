[{"title":"拟古巡幸词五首 其五","author":"朱应登","text":"京观高筑石头城，大旆双悬日月明。\n西内旧夸提督府，南都今有外家营。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8757,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"社燕吟","author":"朱应登","text":"不忍轻飞去，低回绕井栏。\n情知归计决，祗为别巢难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8758,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭泉曲三首 其一","author":"朱应登","text":"筑城千仞山，崩城一瞬间。\n城崩见戍骨，骨上有创瘢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8759,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭泉曲三首 其二","author":"朱应登","text":"千里负骸归，万里不唾井。\n井水清且寒，照见单人影。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8760,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭泉曲三首 其三","author":"朱应登","text":"哭骨骨已灵，哭泉泉亦见。\n幸逢泉下人，不愧泉上面。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8761,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"燕","author":"朱讷","text":"三月巢干雏未成，茅堂来往日营营。\n说残午梦千声巧，剪破春愁两尾轻。\n宫柳阴浓金锁合，水芹香细绿波晴。\n画阑十二无人倚，一半梨花一半莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8762,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阁试春阴诗","author":"王韦","text":"皇都三月春正深，东风酿暖淑气侵。\n曙光溟蒙露华满，轻云阁日天沉沉。\n野色垂垂十余里，草绿柔茵低迤逦。\n半空落絮湿未扬，百丈游丝寒不起。\n鹁鸠枝上相踏鸣，若与此景偏多情。\n空庭帘卷昼亦暝，隔墙惟见桃花明。\n小院门闲莺自语，画栋泥香燕初乳。\n苔花苍润上帘栊，濛濛经雨还未雨。\n含情伫立凭阑干，远峰漠漠登楼看。\n碧窗窈窕银屏冷，金帐促回翠袖单。\n檐影频移暝云动，曲枕悠然醒午梦。\n起来小步傍闲阶，花雾袭衣寒气重。\n生意亨嘉春正时，造化于物若有私。\n明日晴光绿蘋转，吾与万物俱熙熙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8763,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游天宁寺","author":"王韦","text":"问年看井干，结夏闭山门。\n路夹双峰起，泉流百道喧。\n葡萄缠废栋，蛱蝶舞荒园。\n窈窕堪栖隐，逢人未可言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8764,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"澄江台","author":"王韦","text":"混合开天堑，苍茫壮帝畿。\n帆樯移夕景，楼殿动朝晖。\n落日波涛隐，浮烟岛屿微。\n登台歌古咏，长忆谢玄晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8765,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"芙蓉阁","author":"王韦","text":"缘曲疑难至，冯虚恐未安。\n狻猊金锁冷，鹦鹉雪衣单。\n竹倚琅玕听，云移罨画看。\n如何翠微上，犹自着尘冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8766,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀师文","author":"王韦","text":"幽蓟多北风，尘埃旦暮起。\n严冬十二月，积雪亘千古。\n落落高树摧，靡靡劲草死。\n中夜独彷徨，念我同怀子。\n遥遥涉玄冰，单车渡易水。\n岁暮人闭关，何为远游此。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8767,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春草","author":"王韦","text":"带雨和烟未可名，春风处处不胜情。\n于今南浦知多少，都向王孙去后生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8768,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柳枝词二首 其一","author":"王韦","text":"却笑梁园事已非，梁王去后燕空归。\n可怜园上多情树，风絮纷纷学雪飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8769,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柳枝词二首 其二","author":"王韦","text":"渭水西来万里遥，行人归去水迢迢。\n垂杨不系离情住，只送飞花过渭桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8770,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三月晦日送致仁南归","author":"王韦","text":"今日城南路，杨花已不飞。\n梦随家共远，春与客同归。\n酒气薰杯浅，棋声隔院微。\n韶华如别意，犹自恋余晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8771,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"问柳","author":"王韦","text":"为问故园柳，春光几许深。\n未忘攀折处，犹带别离心。\n疏雨一川暝，轻烟两岸沉。\n主人归未得，惆怅五株吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8772,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与陈宗虞夜坐","author":"王韦","text":"不知秋已晚，忽见菊花丛。\n独坐闲亭上，相期细雨中。\n烛融兰焰紫，杯泛杏膏红。\n未听歌钟罢，萧然动北风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8773,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋居杂兴","author":"王韦","text":"池面迎秋爽，山腰落暝阴。\n鹭窥霜藻立，蝉抱雨枝吟。\n不竞销棋癖，多忧损宦心。\n卷帘通夕照，端坐看枫林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8774,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"摄山道中","author":"王韦","text":"旭日晴光转，重城曙景迷。\n稻荒寒蟹出，竹暝晓禽啼。\n古社栖危堞，碑残倚断畦。\n秋风振原野，疲马亦能嘶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8775,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和翟仲鸣","author":"王韦","text":"翛然一榻愧端居，未许驽骀驾鼓车。\n胜事都归乡梦里，幽怀更在客愁余。\n别离门户从秋掩，契阔尊罍尽日虚。\n寄语多情翟廷尉，莫将交态向人书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8776,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新嘉驿遇顾九和","author":"王韦","text":"下马邮亭若有期，南还北去各凄其。\n殷勤野老来相馈，邂逅壶浆坐不辞。\n雪满郊园埋宿草，风吹林麓堕寒枝。\n十年离索惊回首，却恨逢君是路歧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8777,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"李少卿宅蔷薇","author":"王韦","text":"柔香弱蔓不胜寒，十二围屏锦绣攒。\n秦殿晓妆俱窈窕，习家春事未阑珊。\n怜将清奏愁中听，竞折高枝醉后看。\n好待诗成酬胜赏，东风休遣露华干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8778,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春尽日","author":"王韦","text":"满院杨花雨后稀，绿阴清昼思依依。\n小园风暖樱桃熟，曲岸泥融燕子飞。\n北阙明时开王气，南山青处蔼晴晖。\n眼前风景皆堪赏，莫道韶光夜已归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8779,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与卫南英玉围炉","author":"王韦","text":"围炉曾共订幽期，底事今年寒较迟。\n却喜草堂初雪后，更逢梅树欲花时。\n钟声远度啼乌垒，灯影频惊冻雀枝。\n细茗清薰供乐事，短吟长咏胜弹丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8780,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西堂偶兴","author":"王韦","text":"曲槛回廊处处通，深深帘幕暗花丛。\n一春人醉斜阳里，三月莺啼细雨中。\n柳絮不飞粘草白，樱桃初熟亚枝红。\n门前若有求逋客，为说西堂梦未终。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8781,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"除夜","author":"王韦","text":"远宦携家任路歧，夷山犹未是天涯。\n愁中抱病还增剧，客里逢春不自知。\n好记流年收柏叶，乍消残雪见梅枝。\n朝来百岁过强半，惆怅秾华负盛时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8782,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新春试笔","author":"王韦","text":"宦情离思近何如，半夜青阳到敝庐。\n鹊噪谩传新岁事，雁归应带去年书。\n乍开帘幕知寒退，剩得风烟惬闰余。\n一树杏花犹未发，欲尝春瓮更踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8783,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄题刘东之园池","author":"王韦","text":"柱史园池万竹斜，小罗山下岸乌纱。\n晚畦刈罢还抽叶，秋径归来未着花。\n不用平泉繁草树，谁言蓬海剩烟霞。\n平生赋咏多休暇，更种东陵十亩瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8784,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和人无题二首 其一","author":"王逢元","text":"晴绽东墙杏子红，露漙南内牡丹承。\n丛恩未必因词客，捐宠何劳怨画工。\n独听远鸡啼晓月，几随孤燕领春风。\n琐窗寂寂眠初定，梦见笙歌在别宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8785,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和人无题二首 其二","author":"王逢元","text":"两日闲心梦里宽，一春花事雨中残。\n垂杨不解青丝结，明月先亏白玉盘。\n琴调思长和泪鼓，镜铜衰尽带愁看。\n频过女伴颠狂甚，故着罗裙刺合欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8786,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"对酒","author":"王逢元","text":"抱病逢春亦暂欢，芳时对客更加餐。\n即看乳燕双双入，无那飞花片片残。\n潦倒不忘桃叶句，萧闲应恋竹皮冠。\n莫论往昔清狂事，且醉荒亭苜蓿盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8787,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泛舟","author":"王逢元","text":"五月浪平江可怜，诸公容与共楼船。\n得随庄叟逍遥兴，来醉襄王玳瑁筵。\n紫袖不离垂柳下，青山只在把杯前。\n君看走马长安道，此日飞尘正满颠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8788,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫柳","author":"陈沂","text":"袅袅春声里，阴阴晓色中。\n缕垂金屋暗，花散玉楼空。\n凝露啼秦苑，因风斗楚宫。\n不知行辇处，几树近帘栊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8789,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"大驾夜出南郊干端门内奉送书事一首","author":"陈沂","text":"辇属前旌尽，香闻后殿来。\n宝鞯千骑合，金阙九城开。\n天象乘微月，皇衢隐薄雷。\n但知心目眩，无复赋昭回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8790,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"还宫","author":"陈沂","text":"宝骑出长杨，金舆入建章。\n池烟香暝合，宫烛月笼光。\n鼓角春城闭，楼台夜曲扬。\n从兹罢巡幸，四海奉时康。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8791,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"内苑涵碧亭","author":"陈沂","text":"苑入黄金坞，桥回碧树湾。\n龙池观九岛，鳌禁觅三山。\n溜转云车急，花深月殿闲。\n从来人罕至，御榻在中间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8792,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"芭蕉园","author":"陈沂","text":"雨后芭蕉苑，春深杨柳宫。\n倚云悬碧盖，萦雾闭雕栊。\n辇路回天上，歌台出水中。\n久无人笑语，沙畔忽惊鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8793,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"平台","author":"陈沂","text":"海气生华蜃，天光落采虹。\n穹阶曾帝陟，飞观有仙通。\n燕士何年召，周民不日攻。\n禁西伤旧事，七校指离宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8794,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"龙舟坞","author":"陈沂","text":"帝舸频催发，初开水殿时。\n苍龙出海国，紫凤浴天池。\n夺锦星桥断，穿杨月树披。\n于今芳坞闭，闻自内家知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8795,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"正旦即事","author":"陈沂","text":"帝辇时巡久未回，天门遥拜重徘徊。\n封笺自向慈宫进，方贡还同异国来。\n春转青旂开羽仗，日临金榜上楼台。\n帷城尚在燕山外，谁献正元万寿杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8796,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武皇上宾同百官哭临于思善门外","author":"陈沂","text":"帝寝重扉寂寞开，鼎湖龙去可能回。\n芙蓉内殿初成后，虎豹离宫不再来。\n三月麻衣明晓雪，万声号动隐春雷。\n巡游幸返苍梧辔，供奉犹存玉几哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8797,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆昔四首 其一","author":"陈沂","text":"清宵藜火带星光，天禄曾为著作郎。\n门下候朝深坐馆，殿前回院曲通廊。\n群公次第多含笑，满袖氲氤尚有香。\n黄屋朱扉照初日，中官两两玉阑旁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8798,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆昔四首 其二","author":"陈沂","text":"紫宸朝退下青扉，侍从花间过锦衣。\n金吐凤皇香不发，玉倾鹦鹉醉方归。\n楹高甲帐云霞色，官冷牙牌冰雪辉。\n一自梦回天万里，长安空见塞鸿飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8799,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆昔四首 其三","author":"陈沂","text":"宫扉无禁往来宜，内使垂髫许侍随。\n清清夜声归扆帐，紫毫朝彩隔罘罳。\n窗笼树色琼花岛，砌入荷香太液池。\n天上只闻人共羡，不缘尘世竟何知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8800,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆昔四首 其四","author":"陈沂","text":"两朝稽古备词臣，上逼仙班压缙绅。\n避路火城传卫士，具餐晨馆候庖人。\n春深玉署翻红药，日晚金河出素鳞。\n莫为凉飙惜团扇，向来供奉受恩频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8801,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上呈华玉","author":"陈沂","text":"龙江东下水疑空，飞鸟流云落镜中。\n千里晴光遥漾日，满船秋色澹无风。\n青山旧国知何处，芳草离情去未穷。\n晚折蘋花思对酒，灯前还有故人同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8802,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吹角","author":"陈沂","text":"南楼吹角正黄昏，城郭千家早闭门。\n呜咽未成初似语，凄凉三叠转消魂。\n胡儿入塞应长泣，老戍临边几尚存。\n肠断关山今夜月，梅花落尽楚江村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8803,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春草","author":"陈沂","text":"夜雨江南梦，春风陌上情。\n东皇如有意，移向玉阶生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8804,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"大驾西狩还京百官出候于德胜门四首 其一","author":"陈沂","text":"遥闻振旅出居庸，八酸归来御六龙。\n莫道榆关消息近，沙河一水更千重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8805,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"大驾西狩还京百官出候于德胜门四首 其二","author":"陈沂","text":"直望氤氲紫雾遥，万重飞鞚马萧萧。\n鸳班虎队皆戎服，两度迎銮德胜桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8806,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"大驾西狩还京百官出候于德胜门四首 其三","author":"陈沂","text":"天王自纳简书回，神武将军可汗才。\n仙仗不须陈辇路，笼街喝道数声来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8807,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"大驾西狩还京百官出候于德胜门四首 其四","author":"陈沂","text":"逐队绯袍引上公，当街行酒献成功。\n人人识得君王喜，醉入仙桃两朵红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8808,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词六首 其一","author":"陈沂","text":"琼岛春泉下玉沟，年年岁岁御前流。\n无端夜雨生新涨，流出宫墙是外头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8809,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词六首 其二","author":"陈沂","text":"翠荇红莲水殿香，不知帘外易生凉。\n夜来许赐金茎露，明日惊看玉树霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8810,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词六首 其三","author":"陈沂","text":"后庭仙树是谁栽，春尽重门锁绿苔。\n闻说翠华笼烛过，上阳宫里看花来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8811,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词六首 其四","author":"陈沂","text":"金屋藏春春已归，铅华还似落红飞。\n自怜不及花零散，犹逐香尘上御衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8812,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词六首 其五","author":"陈沂","text":"泪横香粉纻双痕，怨管悲丝只为恩。\n多少春风不相属，落花啼鸟自黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8813,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词六首 其六","author":"陈沂","text":"不识君王宠爱偏，却将浓淡误争妍。\n监宫密密来相告，切莫多言在御前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8814,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"放内苑诸禽","author":"陈沂","text":"多年调养在雕笼，放出初飞失旧丛。\n只为恩深不能去，朝来还绕上阳宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8815,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"王昭君","author":"蒋山卿","text":"拭泪新装束，朝来殿里辞。\n何堪辞诀日，却是见怜时。\n汉骑临关少，胡笳出塞迟。\n琵琶写哀怨，凄切转添悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8816,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梅花落","author":"蒋山卿","text":"才见梅花发，飘零树又空。\n萧萧愁对雪，片片恨因风。\n塞外春应少，闺中信未通。\n谁家吹玉笛，明月满帘栊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8817,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乌夜啼五首 其一","author":"蒋山卿","text":"门前杨柳树，借汝乌夜栖。\n郎眠夜未半，无奈汝争啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8818,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乌夜啼五首 其二","author":"蒋山卿","text":"郎起见月光，绮窗白如曙。\n侬欢不成寐，郎起渡江去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8819,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乌夜啼五首 其三","author":"蒋山卿","text":"月明潮欲生，三江风浪恶。\n劝郎且迟留，莫便将衣着。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8820,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乌夜啼五首 其四","author":"蒋山卿","text":"长帆百幅余，大舸夹双橹。\n回头欻不见，侬心苦复苦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8821,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乌夜啼五首 其五","author":"蒋山卿","text":"从劝出门去，天寒独自宿。\n门外单栖乌，夜夜啼上屋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8822,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"采莲曲二首 其一","author":"蒋山卿","text":"翠袖双双并，红妆面面开。\n数声摇橹过，一道唱歌来。\n叶密藏难见，花深去不回。\n小姑相结伴，夫婿莫疑猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8823,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"采莲曲二首 其二","author":"蒋山卿","text":"荡桨谁家女，嬉游入浦深。\n搴花怜并蒂，拾子爱同心。\n回腕垂金钏，低鬟堕玉簪。\n相期未相值，歌曲不成音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8824,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"采菱曲二首 其一","author":"蒋山卿","text":"鹜舲乘滉漾，弭棹弄涟漪。\n拾叶萦荷盖，牵丝乱荇枝。\n比镜那能照，为盘讵易持。\n望美徒延伫，日暮重相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8825,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"采菱曲二首 其二","author":"蒋山卿","text":"新妆丽且鲜，越女斗婵娟。\n飘风落红粉，溅水湿花钿。\n紫茎牵更直，碧叶聚能圆。\n采摘将谁寄，私心只自怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8826,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]