[{"title":"送李节度赴镇","author":"金宗直","text":"鳌背楼台一俯凭，海波万里碧千层。\n太平未试龙韬策，射雉还过竹院僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59073,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花枝独鹊","author":"陈于陛","text":"天上成桥罢，人间化印迟。\n一从栖上苑，那复向南枝。\n拂羽琼花落，穿林宝树垂。\n夜飞绕明月，朝语噪晴曦。\n表瑞巢堪咏，怀仁鷇可窥。\n皇家时有喜，先报九重知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59074,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长幅茧纸仿叔明","author":"李日华","text":"远山烟重树萋萋，潮落沙寒水一溪。\n独坐茅亭无一事，晴鸠啼过雨鸠啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59075,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春入栖霞山寻张文寺","author":"纪青","text":"山气阴阴出荷锄，才分瓜子又挑蔬。\n倦来芍药花前卧，带雨鸣鸠过草庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59076,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春寒","author":"张宇初","text":"烟雨声中酒梦残，蘼芜添绿又春阑。\n鹁鸠唤处西风急，自是杨花惹暮寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋莺","author":"廖孔说","text":"喈喈秋老曙河斜，嫩曲清尘浸露华。\n黄叶误求空谷友，丹枫虚拟上阳花。\n蒹葭漠漠逢归燕，杨柳萧萧伴暮鸦。\n珠箔玉楼弦管日，金衣谁料尚天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕泥","author":"瞿佑","text":"水溢芹塘过晚潮，土膏滋润长兰苕。\n绿杨影里和烟拾，红杏香中带雨调。\n旧垒绸缪惟恨晚，空梁零落可怜宵。\n贪高笑尔双乌鹊，结得危巢易动摇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉燕","author":"朱之蕃","text":"露湛秋空送尔归，乘春海国带霜飞。\n晶瑩好入霓裳队，剪掠分将鹤羽翚。\n翠袖投来天兆瑞，梅梁栖处月垂辉。\n琼花珠树移根易，何似珍禽忆旧扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白燕","author":"朱之蕃","text":"入听呢喃旧语哗，惊看玉质点檐牙。\n乌衣国里谁同侣，白板扉中自一家。\n掠水影随冰尽泮，穿檐光透月初斜。\n上林来往翻飞处，袅袅梨花更柳花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自适","author":"李氏","text":"虚檐残溜雨纤纤，枕簟轻寒晓渐添。\n花落后庭春睡美，呢喃燕子要开帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鹦鹉","author":"马守真","text":"永日看鹦鹉，金笼寄此生。\n翠翎工刷羽，朱咮善含声。\n陇树归还远，吴音教乍成。\n雪衣吾惜汝，长此伴闺情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鹦鹉","author":"张维","text":"憔悴君家历岁年，翠襟蒙宠自须怜。\n能言肯信真如凤，钩喙应知不类鸢。\n千里云山迷陇树，几回魂梦绕秦川。\n稻粱未必虚朝夕，直为樊笼一惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画","author":"德祥","text":"鸲鹆多情语晓风，恼他枝上白头公。\n分明一段江南思，烟雨楼台似梦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"笼雀","author":"王翱","text":"曾入皇家大网罗，樊笼久困意如何。\n长于禁苑随花柳，无复郊原伴黍禾。\n秋暮每惊归梦远，春深空送好音多。\n主恩未遂衔环报，羽翮年来渐折磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戴胜","author":"王守仁","text":"青林煖雨饱桑虫，胜羽离披湿翠红。\n亦有春思禁不得，蕣花枝上诉东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"子夜歌","author":"董少玉","text":"凉风吹北窗，槐阴深几许。\n带露摘荷花，笑共鸳鸯语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜集石湖分得妆字","author":"王微","text":"云罨湖山远树苍，鵁鶄飞破藕塘香。\n月明处处添秋色，一束芙蓉正洗妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画","author":"智舷","text":"数株老树半无叶，一个茅亭终日空。\n惟有鹭鸶常到此，飞来飞去送残红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹间听反舌鸟","author":"慧秀","text":"细霭轻岚散竹林，支颐小坐听晨禽。\n未蒸花气机偏涩，乍写春声意独深。\n缓引易调多种舌，琐言难竟一生心。\n何如隐忍过残腊，末路风烟恐不禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中冬日偶题","author":"纪青","text":"镇日无人闭竹扉，阶前寒翠上人衣。\n开门修竹青如束，黄叶风前叫子规。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝泉滩即事","author":"李淑媛","text":"桃花高浪几尺许，银石没项不知处。\n两两鸬鹚失旧矶，衔鱼飞入菰蒲去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄洪时斋","author":"德祥","text":"草上东风柳上烟，溪头三日嫩晴天。\n竹鸡叫断春泥滑，閒与梅花说旧年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鸡鸣歌","author":"姚广孝","text":"金壶漏残霜满屋，鸡鸣喈喈乌尚宿。\n征夫才起促行装，马为驾鞍车整毂。\n鸡罢俄闻鼓角悲，别妇出门双泪垂。\n妇牵夫袂话归日，愿学鸡鸣不失时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题御扇所画鹡鸰葵兰","author":"申时行","text":"花萼楼前过鹡鸰，群飞相逐总含情。\n非关原上秋声急，自傍林间淑景鸣。\n影散瑶阶葵日午，音调玉管蕙风清。\n当时集木称奇瑞，何似仪庭应圣明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桂花芙蓉山雀","author":"何洛文","text":"墨华点缀九秋容，宝箑看疑御苑逢。\n金粟半含青桂树，锦云初灿木芙蓉。\n芬香宛自清风发，艳色弥从满月浓。\n更喜双双枝上雀，轻飏翠羽近飞龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乐府杂曲","author":"法杲","text":"纤鲫上芒针，小儿争大叫。\n一饵连六鳌，此是任公钓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金鱼","author":"朱之蕃","text":"谁染银鳞琥珀浓，光摇鬐鬣映芙蓉。\n清池跃处桃生浪，绿藻分开金在镕。\n丙穴灵源随地涌，离宫正色自天钟。\n群鱼漫尔同游泳，□见飞空化赤龙。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蛙鼓","author":"朱之蕃","text":"径满蓬蒿沼满蘋，产蛙相怒复相亲。\n中宵磔格连清晓，过雨喧阗送晚春。\n独听铙歌矜战胜，共徵散部乐延宾。\n郊坰寂静偏怜汝，伴我书斋不厌贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蛙","author":"张维","text":"熟梅天气雨初收，何处蛙声隔水楼。\n鼓吹翻嫌惊好梦，公私谁为乱閒愁。\n薰风候已违花信，碧草凉应动麦秋。\n赤鲤闻雷争变化，尔能烧尾跃云不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遣兴","author":"明秀","text":"白云流水度虚屏，小坐池边眼自醒。\n春事不知浑入夏，青虫无力堕槐庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59102,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜","author":"孟淑卿","text":"豆花雨过晚生凉，林馆孤眠怯夜长。\n自是愁多不成寐，非缘金井有啼螀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59103,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春蚕词","author":"朱静庵","text":"桃花落尽日初长，陌上雨晴桑叶黄。\n拜罢三姑祭蚕室，渐笼温火煖蚕房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月下闻蝉","author":"道敷","text":"林叶净堪数，山蝉吟未休。\n今宵且趁月，明日恐惊秋。\n咽露忽沈树，因风旋入楼。\n念能枯得尽，总是不关愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蝉琴","author":"朱之蕃","text":"浓云远水接檐栊，一枕南薰两腋风。\n欲鼓更停传绝调，无弦有韵别枯桐。\n不堪嵇散聊为适，谁谓钟期遇已空。\n寄语螳螂休奋臂，吾方游目送归鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄蝶","author":"瞿佑","text":"误入蜂房不待媒，巧传颜色换凡胎。\n绕篱野菜留连住，何处金钱变化来。\n傅粉已知前事错，偷香未信此心灰。\n上林莺过频回首，一色毛衣莫用猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"睡蝶","author":"沈天孙","text":"一夜和风遍海棠，家园蝴蝶拂柔桑。\n飞随芳树霞衣好，倦宿琪花粉梦香。\n似与名蕤分艳色，不堪清露湿秋裳。\n因风又度雕阑去，却伴游丝过石梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蜂房","author":"瞿佑","text":"牖户谁教各自开，花间衙内海潮来。\n分门岂虑添丁恼，酿蜜应防闸课催。\n蚁穴尚能藏郡国，龙宫亦自有楼台。\n书生苦欠立锥地，凭仗东风为作媒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"红蜻蜓","author":"瞿佑","text":"蝶粉蜂黄气正骄，爱渠款款集兰苕。\n翅攒霜叶飞难定，目聚灯花燄未消。\n偷咀仙霞传秘诀，戏涂猩血点纤腰。\n写生好倩毗陵笔，浓蘸胭脂上软绡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居","author":"通凡","text":"竹间独立时，凉风自相接。\n回顾碧池中，蜻蜓点萍叶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题院壁","author":"永瑛","text":"自爱青山常住家，铜瓶閒煮壑源茶。\n春深白日岩扉静，坐看蛛丝罥落花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏萤","author":"德祥","text":"念尔一身微，秋来处处飞。\n放光唯独照，引类欲相辉。\n白发嫌催节，青灯妒入帏。\n老僧无世相，容得绕禅衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"萤火","author":"朱之蕃","text":"中宵露坐数飞萤，隐映墙阴复广庭。\n风动花林生野烧，池摇云影度疏星。\n天街扇扑流光乱，书屋囊开夜色青。\n乘化未容随草腐，非关慧质弄惺惺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"促织","author":"朱之蕃","text":"閒阶声彻琐窗中，暗送梧桐落叶风。\n高韵不缘矜战胜，微吟端欲助机工。\n雨馀切切昏钟动，灯下叨叨午漏通。\n催得匹成输税早，贻人安枕不言功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"络纬","author":"朱之蕃","text":"谁遣缫车彻夜鸣，频催云锦织当成。\n送来枕上萦诗思，听向床头系旅情。\n露濯篱英增绚烂，风传邻杵和凄清。\n冰蚕瓮茧知难觅，何似秋虫巧弄声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏题斗促织","author":"张维","text":"自离草莽得登堂，贤主恩优念不忘。\n饱食瓮城常养锐，怒临沙堑敢摧强。\n敌声夜振须仍奋，壮气秋高齿渐长。\n眼底孽馀平剪后，功成谁复论青黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜","author":"释文贞","text":"露气夜凄迷，空庭络纬啼。\n被他风引去，忽过竹门西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄秘书直长夏祥凤","author":"德祥","text":"得见人间未见书，朝朝暮暮玉阶除。\n心如一寸芸香草，长与君王辟蠹鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苍蝇","author":"朱之蕃","text":"生从污秽忽雄飞，鼓翅摇唇觅已肥。\n剩酒残羹沾醉饱，青丝白璧妒光辉。\n营营引类来同恶，恋恋依人不暂违。\n驱斥虽严还易集，持将麈尾莫停挥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蝇","author":"张维","text":"呼朋引类竞纷然，入我房栊扰昼眠。\n鼓翼有声喧耳畔，侧身无赖簇眉边。\n频惊栩栩南柯兴，始信营营止棘篇。\n挥汗未能操咏笔，任他长剑逐堂前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"螳螂","author":"朱之蕃","text":"昂头双眼映林明，会出当车奋臂行。\n利口信难防雀啄，狂鸣端是恼蝉声。\n蓬蒿满径堪孳息，榆柳成阴寄化生。\n静默非关能养勇，慕膻羞与蚁争衡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"纺织婆","author":"朱之蕃","text":"沤麻曝絮岁功成，虫语潜催布缕征。\n篱落声宏眠讵稳，草丛音切听偏倾。\n连绵欲伴孤灯烱，悽恻还偕细雨鸣。\n几度停车增怅结，悠悠不断似离情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵张仲举承旨题卢楞伽过海罗汉图","author":"释来复","text":"僧伽神变妙莫穷，去住隐显如旋风。\n能令大海作平陆，超然独脱阎浮中。\n山君河伯备洒扫，锡飞杯渡云行空。\n安禅不避魔鬼窟，受斋直入龙王宫。\n文犀赤豹时作伍，玄猿白鹿日与同。\n腾光嘘气闪奔电，天鼓震曜惊雷公。\n世人虽呵小乘法，谁独高举随云龙。\n我昔衡山问方广，石桥每见驮经童。\n天姝散花跪双膝，金盘笑捧明珠红。\n开图恍惚睹颜色，山海遥隔精灵通。\n那知画者有深意，丹青巧夺造化功。\n君不闻幻游天地同旅泊，我身安得驾鹤从西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海东青行","author":"释梵琦","text":"海东青，高丽献之天子庭。\n万人却立不敢睨，玉爪金眸铁作翎。\n心在寒空鞲在手，一生自猎知无偶。\n孤飞直出大鹏前，猛志岂落鴐鹅后。\n是日霜风何栗冽，长杨树羽看腾瞥。\n奔云突雾入紫霄，狡兔妖蟆洒丹血。\n束身归来如木鸡，众鹘欲并功难齐。\n尔辈无材空碌碌，不应但费官厨肉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长桥晚眺","author":"吕需","text":"远眺成高陟，因之解睡魔。\n碧天秋水渺，戏树夕阳多。\n列岸摇酤旆，连舟起棹歌。\n欣逢谢康乐，吟啸更如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长桥怀周季侯侍御","author":"卓发之","text":"烟月坠汀沙，飞仙驾落霞。\n红尘迷客路，青史志君家。\n诏狱空中电，褒忠梦里花。\n何须嗟老骥，垂耳服监车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"碧天桥","author":"释大香","text":"桥夜寂行舟，天影淡空水。\n独有无事僧，往来明月里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬别二首 其二","author":"梅蕃祚","text":"一片秋林色，如迎去客舟。\n更怜江月好，且为故人留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悼楚石和尚诗 其一","author":"智及","text":"潦倒奚翁的骨孙，高年说法屡承恩。\n麻鞋直上黄金殿，铁锡时敲白下门。\n烦恼海中垂雨露，虚空背上立乾坤。\n秋风唱彻无生曲，白牯狸奴亦断魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悼楚石和尚诗 其二","author":"智及","text":"圣主从容问鬼神，当机一默重千钧。\n荼毗直下金门诏，火聚全彰净法身。\n平地惊翻三世佛，等闲瞎却一城人。\n大悲愿力知多少，枯木花开别是春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悼楚石和尚诗 其三","author":"智及","text":"匡床谈笑坐跏趺，遗偈亲书若贯珠。\n木马夜鸣端的别，西方日出古今无。\n分身何啻居天界，弘法毋忘在帝都。\n白发弟兄空老大，刹竿倒却要人扶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵寄开化一元禅师","author":"智及","text":"厌看功臣树色苍，故山端的胜殊方。\n桑麻原隰连香径，金碧楼台峙宝坊。\n瀹雪小斋云半榻，贯花新偈入千行。\n春深四大轻安否，佛祖权衡赖抑扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"师祖善权元翁和尚忌辰","author":"智及","text":"为爱团圞十亩园，红芳消后绿阴连。\n杖藜日涉真成趣，野菜时挑不费钱。\n临济栽松亲夋地，仰山种粟自烧田。\n祖翁活计谁相委，独立南荣为惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答梦堂法兄","author":"智及","text":"兵戈南北竞喧争，兄弟分违似隔生。\n瀛海丹山君宴坐，劫灰双径我徒行。\n只添束篾腰间重，依旧眉毛眼上横。\n赖有祖翁家活在，不妨日午打三更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答东皋伯远法师","author":"智及","text":"东皋尊者隐郊墟，小小屠苏睹史居。\n切柏代香朝演法，卷帘进月夜抽书。\n村园果熟秋霜后，花径苔生宿雨馀。\n心境两忘诸幻灭，更于何处觅真如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"示寿知客","author":"智及","text":"开先寺里迎宾日，禅月堂前索偈时。\n客路如天春似海，子规啼断落花枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登灵鹫山","author":"释宗泐","text":"兹山如鹫形，昂然欲骞翥。\n稽首天人师，浩劫长此住。\n山中数招提，窗户散烟雾。\n胜流不起席，钟鼓自朝暮。\n下有王舍城，民俗尚淳古。\n所嗟给孤园，民俗已非故。\n吾生一何幸，良游遂平素。\n一笑天风生，白云掩高树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"抵鸡足山","author":"释宗泐","text":"大哉圣人化，万古垂休经。\n自非上智士，何由得其精。\n饴光受遗命，传衣表相承。\n持之入大定，坐待慈氏生。\n石崖开复合，人天护幽扃。\n煌煌窣堵波，白日辉觚棱。\n魔来不得毁，斧迹尚纵横。\n鹫峰北指秀，道树当前青。\n再来旷无日，回首云冥冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宜八里国王遣使至馆所慰问","author":"释宗泐","text":"白昼楼居静，王人忽到门。\n有香聊款坐，无译自忘言。\n氎布缠头阔，檀膏点额繁。\n客怀劳慰问，此意竟难谖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仲春宜八里国道中","author":"释宗泐","text":"芭蕉叶开大如席，石榴花发红满枝。\n子规何似苦啼血，正是行客东还时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]