[{"title":"侠客行","author":"张时彻","text":"登君堂，把君肘。\n生从卫霍游，复与金张友。\n主仇尚不报，肝胆向谁剖？\n脱下纮骦裘，换得新丰酒。\n千钱作使邯郸倡，北斗阑干挂朱牖。\n平明走马长安市，翻身戏折章台柳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7435,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"子夜四时歌八首 其一 春歌","author":"张时彻","text":"朝朝听鹊报，日日掩重闱。\n莫踏门前草，留踪待郎归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7436,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"子夜四时歌八首 其二 春歌","author":"张时彻","text":"乍来结女伴，江头去浣纱。\n问讯郎消息，夜来灯烛花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7437,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"子夜四时歌八首 其三 夏歌","author":"张时彻","text":"女郎宛转歌，轻舟棹碧波。\n打动明珠碎，团团落青荷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7438,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"子夜四时歌八首 其四","author":"张时彻","text":"日出望车尘，徘徊至日曛。\n拾得红茜草，染就石榴裙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7439,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"子夜四时歌八首 其五 秋歌","author":"张时彻","text":"凄凄复凄凄，月出光尚微。\n郎衣犹未绽，何得理侬衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7440,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"子夜四时歌八首 其六","author":"张时彻","text":"恻恻复恻恻，桑黄秋露白。\n持糜不能餐，持麻不能织。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7441,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"子夜四时歌八首 其七 冬歌","author":"张时彻","text":"夜来风似箭，晨起雪盈床。\n侯门教歌舞，剪彩斗红妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7442,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"子夜四时歌八首 其八","author":"张时彻","text":"河水结层冰，疾风吹旷野。\n嗟尔衣裳单，独宿在车下。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7443,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宛转歌","author":"张时彻","text":"明星粲，露华泫。\n宛转歌，歌宛转。\n月白乌夜啼，弦长曲何短。\n绿水芙蓉夜夜开，芭蕉叶落心常卷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7444,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"幽涧泉","author":"张时彻","text":"幽涧泉，飞珠玉。\n道傍白花细如粟，绳枢小户架山麓。\n翁析薪，妇煮粥。\n小儿敲冰断青竹，风吹草屋寒肃肃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7445,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浔阳歌五首 其一","author":"张时彻","text":"九江江水九流盘，彩耽朱旗霄汉间。\n七十二峰今夜月，龙门相对骆驼山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7446,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浔阳歌五首 其二","author":"张时彻","text":"龙虎开天取上游，旌旄东下定神州。\n樯帆直照鼋鼍窟，日月双悬锦绣楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7447,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浔阳歌五首 其三","author":"张时彻","text":"锦云堆树浪花长，桃李飞来片片香。\n打鼓鸣桡何处客，怪来惊散两鸳鸯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7448,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浔阳歌五首 其四","author":"张时彻","text":"泽北喧喧商贾庐，泽南隐隐蛟龙居。\n蓬头赤脚沙中子，荡桨拿钩学捕鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7449,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浔阳歌五首 其五","author":"张时彻","text":"渔郎渡头灯火明，浔阳市上酒旗横。\n沙白水清烟水冷，琵琶犹作断肠声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7450,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"古别离","author":"张时彻","text":"春思已无那，如何又早秋。\n偏将一片叶，飞作万重愁。\n凤枕兰香细，瑶阶霜杵柔。\n暗挥双泪眼，一望大刀头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7451,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"行路难三首 其一","author":"张时彻","text":"君不见太行山，撑天拄日高郁盘。\n君不见黄河水，翻云倒雾千万里。\n渡河苦无梁，上山苦无羽。\n飒沓蓬蒿常伛偻，我往诉帝帝我拒。\n虎豹当关攫人肉，雄鸠佻巧不为理。\n时运苟未逢，材艺弃如土。\n苏秦空上咸阳书，韩信犹蒙里儿裤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7452,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"行路难三首 其二","author":"张时彻","text":"君不见连城璧碎不复完，平地水覆难再收。\n昔日弹冠取卿相，片言不合兴戈矛。\n雷开被宠比干死，窦婴失势灌夫囚。\n道旁荆棘汝自力，进退惟谷心烦忧。\n绰约春华岂久妍，青青松柏委山丘。\n君如念东门之黄犬，何如彼西域之青牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7453,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"行路难三首 其三","author":"张时彻","text":"御君文茵畅毂之宝车，升君旋题刻桷之华堂。\n饮君蒲萄琥珀之美酒，服以华袿绣结之衣裳。\n妾颜不如花与玉，妾心自比双鸳鸯。\n朝奉君前，夕侍君旁。\n承君之欢，不出洞房。\n岂知贵貌不贵心，转眼秋风霜霰侵。\n明月长虚文锦帐，清宵不断白头吟。\n行路难，心烦冤。\n自家结发尚如此，路上之人何足言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7454,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梁父吟","author":"张时彻","text":"朝上泰山，郁何盘盘。\n崩崖薛嵥，石齿阑班。\n虺蛇横树，虎豹当关。\n憭哉栗栗，曷以盘桓。\n暮上泰山，白日西匿。\n前有榛莽，后有鬼蜮。\n道险天寒，饥不得食。\n欲见云君，何由可得。\n泰山巍巍，鲁邦所宗。\n智矣齐相，七国之雄。\n二桃何甘，以杀三士。\n惟其忍心，嗟嗟晏子。\n虞罗藏机，蜂虿致螫。\n口舌之微，惨惨戈戟。\n长沙窜谊，汨罗沉平。\n谁为始祸，嗟嗟晏婴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7455,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"结客少年场行","author":"张时彻","text":"少年纵饮博，落魄废生涯。\n阴谋师鬼谷，勇气薄荆轲。\n象齿饰雕弧，黄金装莫邪。\n较猎平陵下，一发中五筱。\n横行都市中，杀人如刈麻。\n官司急追捕，埋名鲁朱家。\n亲交易名姓，剧孟相经过。\n投我千金赠，白刃重摩挲。\n驱胡出上谷，转战入交河。\n就食大宛城，饮马条支波。\n钱刀买首级，摴蒲百万多。\n生当甘鼎镬，死即弃山阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7456,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"空城雀","author":"张时彻","text":"空城索索，鼠穴狐栖。\n白骨不葬，悲风凄凄。\n嗟尔黄雀，何不去此逃？\n朝鸣啾啾，夕呼嗷嗷，慊慊长苦饥，尔生一何劳。\n雀闻心中苦，口噤不能语。\n大泽饶风波，其上鸱鸢多。\n东人挟弹，西家张罗，各自怀机智，爱惜田中禾。\n覆车之粟人尚收，官仓之储宁汝由？\n何如霝蹋空城里，草根木实无人主。\n经年不见有行踪，蓬蒿跳踉谁禁汝。\n蚩蚩尔黄口，慎莫生咨嗟。\n待得毛羽成，努力自为家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7457,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陌上柳","author":"张时彻","text":"陌上柳，陌上柳，春风披拂长短条，不知攀折谁人手。\n为问去年折柳人，今年柳发归来否？\n雉朝飞，车辚辚，柳花飞飞愁杀人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7458,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"留郎曲","author":"张时彻","text":"三月以来无一晴，郎今欲行犹未行。\n日日鸟啼行不得，郎心不定妾心惊。\n芳花尽被淫雨妒，出门只尺迷毒雾。\n风吹白浪立如山，劝郎莫问江头渡。\n哀猿叫月不可闻，妖蜮衔沙讵知数。\n深林魑魅巧弄人，百尺长蛇断行路。\n黄金之印大如斗，数奇不得悬君肘。\n有时错误犯刑书，咄嗟那复保身首。\n此时游魂何处归，此时空房难独守。\n不如炊黍且蒸藜，相对绳枢与瓮牖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7459,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"北征杂咏三首 其一","author":"张时彻","text":"客寝不能寐，旧虑杂新思。\n申旦鸡初鸣，呼童理裳衣。\n初日照疏牖，仓皇临路歧。\n风尘塞四野，车马若云驰。\n去者未云息，来者复如斯。\n鼎鼎百年内，形神空尔疲。\n顾彼蓬蒿士，旦暮偃荆扉。\n蒸藜以为食，编麻以为衣。\n不知有朝市，岂复辨雄雌。\n芳饵非所羡，网罗安得施。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7460,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"北征杂咏三首 其二","author":"张时彻","text":"牦牛不为麟，西施不负薪。\n贵贱各有尚，知者察其真。\n周公下白屋，天下乃归仁。\n田窦相倾夺，玉石俱见焚。\n大雅秉明哲，富贵成浮云。\n昨日趋跄地，今为灰与尘。\n济济鸿都士，何者结交亲。\n我欲竟此曲，此曲难具陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7461,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"北征杂咏三首 其三","author":"张时彻","text":"东涧结层冰，西涧涵清冷。\n北枝方委叶，南枝已含荣。\n本是一气物，炎凉不同形。\n何况云间翼，翻飞岂能并。\n朝客孟尝门，日夕投信陵。\n得意胶漆欢，失意寻戈兵。\n仇多终自贼，岂独丧其朋。\n不念王贡交，千载扬芳名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7462,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武陵庄杂咏二首 其一","author":"张时彻","text":"秉愿物外游，结欣在何许？\n觅路辨青山，沿洄遵枉渚。\n丹丘忽戾止，烟霞密如堵。\n中有千年松，滴翠纷成雨。\n丛篁茁新玉，樛木罗珍羽。\n眺听不胜奇，日夕憺容与。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7463,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武陵庄杂咏二首 其二","author":"张时彻","text":"河水何弥弥，白石何齿齿。\n诛茅以为宫，闲旷绝闾里。\n鸡犬不复闻，渔樵时至止。\n碧巘插云端，银河投涧底。\n苔生阶布绣，花发户施绮。\n况有虫鸟鸣，仿佛谐宫徵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7464,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"积雨简嘉则","author":"张时彻","text":"阴风吹宿雨，阴雾幂庭墀。\n怯寒花委砌，避湿鸟分枝。\n天暝非因夜，泥深不辨蹊。\n亲宾断来往，孤负黄流卮。\n兀坐悄无聊，一赋愁霖诗。\n诗成再三叹，四顾将寄谁。\n为语云栖者，启户当知之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7465,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋怀诗四首 其一","author":"张时彻","text":"虎兕狎旷野，鳟鲂怀广池。\n如何游客子，飘荡无返期。\n朝发扶桑阿，夕息望崦嵫。\n山谷屡徂迁，寒暑互推移。\n艰难经百务，鬒发变成丝。\n腰带不盈束，中心惄如饥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7466,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋怀诗四首 其二","author":"张时彻","text":"朝登太行坂，雪满太行山。\n改辙渡黄河，天寒冰塞川。\n处世多网罗，忧患坐相牵。\n哲士鄙龚胜，佞臣趣董贤。\n如何卑执戟，投阁空自捐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7467,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋怀诗四首 其三","author":"张时彻","text":"木落尚可荣，水涸尚可盈。\n如何蓬嵩士，抱艺竟无成。\n神龙制蝼蚁，斥璟嗤鹍鹏。\n小大各有遇，得失安可凭。\n达将连驷骋，穷即蓬累行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7468,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋怀诗四首 其四","author":"张时彻","text":"蝜蝂不畏重，蜗牛好高升。\n涎尽不返宅，力疲竟颠倾。\n华亭悲鹤唳，上蔡思苍鹰。\n光宠难久恃，机阱互相仍。\n宁甘首阳饿，无作五鼎烹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7469,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"君房下第归至","author":"张时彻","text":"在在有芳草，处处有青山。\n君去与之去，君还与之还。\n燕台空骏骨，汉宫摈朱颜。\n自古有如此，沉冥且闭关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7470,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊居八首 其一","author":"张时彻","text":"朝出野田游，暮向林皋宿。\n策杖入蓬门，溪云犹在足。\n霞鸟背翔，皓月江心浴。\n樵钓共为徒，庶几郑子谷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7471,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊居八首 其二","author":"张时彻","text":"幽居屏烦喧，触目恣遐眺。\n烟霞茁屡奇，峰峦互腾踔。\n宿乌竞阳枝，寒泉迸阴窍。\n欣兹十亩宫，托迹亦窈窕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7472,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊居八首 其三","author":"张时彻","text":"村居何所有，历历多修竹。\n明星阁树头，白云饱溪腹。\n钓月引鳟鲂，樵霞卧山麓。\n枯槁故所耽，饮啄亦自足。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7473,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊居八首 其四","author":"张时彻","text":"篱菊欲辞荣，林枫亦陨赤。\n清尊湛芳醑，园果繁以硕。\n邻里相劝酬，酣歌击白石。\n俯视池中鱼，仰睇云间翼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7474,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊居八首 其五","author":"张时彻","text":"寄遁匪云远，清溪即故栖。\n崇楼邀月近，列岫泄云齐。\n鸟至自相悦，人来乍欲迷。\n言访蓬瀛路，丹丘倘可梯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7475,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊居八首 其六","author":"张时彻","text":"有鼓不自鼓，有琴不自弹。\n端居习清燕，阒寂寡所欢。\n寒泉盘户碧，坠叶满庭丹。\n采采芙蓉花，云露何漙漙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7476,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊居八首 其七","author":"张时彻","text":"种禾已堪炊，种蔬已堪摘。\n梧竹俨成行，展矣幽人宅。\n鸟篆文苔阶，云衣罥兰泽。\n翘首望长空，青山净如拭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7477,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊居八首 其八","author":"张时彻","text":"伏枕不成寐，侧听司晨嗥。\n严霜切重衾，疾风梳败蕉。\n寒燠固有常，龙蛇由所遭。\n集菀本非羡，白首甘蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7478,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新城谣","author":"张时彻","text":"城乌哑哑夜未旦，城上击鼓角声乱。\n南来使客未遣行，北来夫马急须办。\n里长抱刍肩负谷，无钱顾马将儿鬻。\n吏胥逃避屋啄乌，苦遭官府相刺促。\n君不见朱甍连云列画戟，尽是将军内官宅。\n里中户口半流移，沙田草没无人犁。\n县官县官奈尔何，乞休不得泪滂沱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7479,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上行","author":"张时彻","text":"东风乍雨还乍晴，十里百里闻流莺。\n春波渺渺净素练，春山簇簇行画屏。\n江上花飞已如霰，泽中蒲柳何青青。\n五陵侠客金騕袅，潇湘美人琼玉筝。\n珊瑚宝玦照碧草，飞丝急管喧层城。\n绣服凌云翡翠动，香轮压雾鸳鸯惊。\n日中斗鸡驰道塞，日暮捶鼓纷吹笙。\n金陵美人鹦鹉杯，桂棹兰舟不计倾。\n相看莫放赤日落，白石清沙无限情。\n凤凰台上鸟初下，白鹭洲前笛一鸣。\n归途况值明月光，回首犹闻《白苎》声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7480,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"还山行赠林屋山人","author":"张时彻","text":"秋风多，秋水波，行人击汰归山阿。\n朝辞凤凰台，夕宿蒲苇中。\n月照江流白，霜催山叶红。\n征途已萧瑟，鸿雁互西东。\n行看洞庭树，远在烟生处。\n结庐枕山石，时时戴云雾。\n未种鹿门田，岁月奄已暮。\n山中九月甘菊黄，山家美酒郁金香。\n苍松荫地百尺长，好呼仙客行羽觞。\n速弦柱促，玄鹤为我舞，长歌紫芝曲。\n拂袖还沾陇上霞，著书应长门前竹。\n竹叶何青青，霞光何盈盈。\n辟谷饵金石，凌虚蹑太清。\n灵岩瀑布日夜悬，下有野雉雊远田。\n林间仿佛白玉童，双吹铁笛上青天。\n林屋之山清且虚，为问瑶草今何如？\n湖上若逢双鲤鱼，烦君惠我尺素书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7481,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陈都阃宅看烟火","author":"张时彻","text":"正月初旬长昼昏，北风吹沙江吐云。\n千门弱柳青袅袅，官院红梅开正芬。\n雨霁张灯春不迟，将军烟火夜偏奇。\n层层岛屿神仙见，灿灿云霄星斗垂。\n宝塔崚嶒跨紫峰，青天削出金芙蓉。\n芳兰映日琼瑶碧，菡萏凌波玛瑙红。\n蜡炬光中战马鸣，奔如飞电突如鲸。\n戈矛寒带阴山雪，旗甲晴挥瀚海星。\n野鸽双飞乍欲没，衔枝喜鹊喳喳发。\n芍药蒲萄悬翠屏，珊瑚宝贝流明月。\n空中捧出百丝灯，神女新妆五彩明。\n真人斩蛟动长剑，狂客吹箫过洞庭。\n翩翩舞蝶戏穿花，海上楼台散赤霞。\n须臾锦绣被满地，明珠斗大纷如麻。\n城中小儿齐拍手，声声道好如雷吼。\n击鼓弹筝时转喧，河汉低回挂朱牖。\n夜深宾客各言归，主人长跪强牵衣。\n朱苞细拆漳南橘，白碗新盛北地梨。\n联床接席出丰膳，美酒平斟玉屈卮。\n清宵良会岂再得，今我不醉将何为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7482,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿南渡","author":"张时彻","text":"路出青山峡，云移碧水艖。\n新蒲没洲渚，斜日照村家。\n林暝鸟翻树，潮来月满沙。\n缘知丘壑内，偏自有烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7483,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日舟行四首 其一","author":"张时彻","text":"出郭便如意，春光尽眼中。\n云衣浮石淡，树杪着霞红。\n野渡新添水，村禽各占丛。\n桃源在何许，宛转未能穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7484,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日舟行四首 其二","author":"张时彻","text":"为爱春流好，初晴即放船。\n林皋青带雨，江路澹生烟。\n渔唱因风乱，莺花斗日妍。\n瀛洲应不远，凝望转堪怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7485,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日舟行四首 其三","author":"张时彻","text":"空闻玄圃胜，何似碧溪行。\n积雪千峰白，斜阳一镜平。\n舻移频挂藻，岸转只闻莺。\n信是沧浪好，中流试濯缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7486,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日舟行四首 其四","author":"张时彻","text":"青云将画舫，步步可怜春。\n野草风吹绿，山峰雨洗新。\n花枝初缀蝶，燕语故招人。\n村叟亦何意，逍遥傍水滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7487,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晓起","author":"张时彻","text":"晨星开曙色，风铎响檐端。\n白发绨袍敝，青山病骨寒。\n畦蔬鸡啄乱，园果鸟衔残。\n竹里收遗箨，新裁处士冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7488,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日舟行次韵","author":"张时彻","text":"春郊芳草色，步步引仙舟。\n未试登山兴，先为载酒游。\n轻云笼过鸟，斜日趁归牛。\n最喜初晴霁，群峰翠欲流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7489,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渡黄河","author":"张时彻","text":"黄河回九曲，适郢乍经过。\n积雨初添涨，无风亦自波。\n人行沙岸小，树近夕阳多。\n为爱沧浪曲，因之鼓枻歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7490,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月夜燕客朱氏园亭","author":"张时彻","text":"窈窕将军宅，招邀长者车。\n彩霞秋竹乱，零露夕花舒。\n水抱庭除碧，屏开石镜虚。\n尊前好明月，相对意何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7491,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"广陵晓发","author":"张时彻","text":"征夫逐草露，夜夜月中眠。\n雾拥玄猿啸，风吹白雁旋。\n有江能绘树，无路不生烟。\n旭日秋光淡，芙蓉亦可怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7492,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹墟宅宴集口占","author":"张时彻","text":"谁下陈蕃榻，青山有逸民。\n来从芳草引，坐与碧山邻。\n中酒无虚日，寻花及好春。\n相看莫相笑，同是竹林人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7493,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新秋咏怀","author":"张时彻","text":"芳杜秋草冷，兰舟剡水迟。\n美人在何许，远道本难期。\n皓月临琼树，青楼出凤吹。\n曲中有深怨，不奈妒娥眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7494,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"隐居","author":"张时彻","text":"岛屿春常在，桃源路不迷。\n山禽冲雾落，野鹿抱霞栖。\n蔓引青松弱，崖悬碧草齐。\n逍遥堪避世，从此觅丹梯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7495,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]