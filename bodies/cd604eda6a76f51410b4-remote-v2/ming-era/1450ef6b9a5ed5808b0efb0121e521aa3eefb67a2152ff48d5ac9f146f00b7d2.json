[{"title":"过城陵矶","author":"杨士奇","text":"矶头水落石层层，石上鱼樯半搭罾。\n忽望高楼出城郭，舟人指点说巴陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3241,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜雨次韵寄蔡用严杨仲举 其一","author":"杨士奇","text":"秋夜夜长长寂寂，打窗飘雨似严更。\n诗情未断羁情起，不耐床前络纬鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3242,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜雨次韵寄蔡用严杨仲举 其二","author":"杨士奇","text":"江边园里擅幽居，清酒香茶夜不虚。\n定是不闻风雨发，半酣高咏漆园书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3243,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答蒋立恭","author":"杨士奇","text":"怜君拜墓不胜哀，泪洒东风奠一杯。\n芳草青烟寒食节，几家坟上子孙来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3244,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题祝教谕梅","author":"杨士奇","text":"弦诵初停子佩閒，梅花香拂绛帷间。\n玩微独对羲图坐，不假重熏金博山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3245,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题萧建平扇","author":"杨士奇","text":"五月楼船海上归，种鱼池畔足閒时。\n白罗团扇挥炎暑，重理残书莫下帏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3246,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题萧德赞四时小景 其一","author":"杨士奇","text":"二月山花如锦开，亭中坐对正徘徊。\n蹇驴又有过从者，童子相迎户外来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3247,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题萧德赞四时小景 其二","author":"杨士奇","text":"云林六月不知暑，溪上好山如越中。\n咫尺茅亭异华屋，逢迎俱见古人风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3248,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题萧德赞四时小景 其三","author":"杨士奇","text":"两行鸣雁分飞处，一个轻船逆上时。\n藉是江天好吟景，不令风物动秋思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3249,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题萧德赞四时小景 其四","author":"杨士奇","text":"十日北风吹大雪，闭门无处不漫漫。\n江头艇子船头骑，有底忙时不畏寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3250,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题高克恭墨竹","author":"杨士奇","text":"房山高韵五十仞，松雪清风二百年。\n山斋宝气不可掩，夜夜雨虹光烛天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3251,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"斋宿和胡光大庶子 其一","author":"杨士奇","text":"金门晚退坐清斋，烛影茶香对好怀。\n况复连篇写珠玉，右坊传送左坊来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3252,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"斋宿和胡光大庶子 其二","author":"杨士奇","text":"雨气霏霏压篆烟，坐消银烛未成眠。\n明朝预想南郊上，日驭光华丽满天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3253,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题子昂画嘉禾","author":"杨士奇","text":"宋代王孙元阁老，文章万丈贯天河。\n胸中不有调元事，那解挥毫写太和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3254,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄宾畿老弟 其一","author":"杨士奇","text":"安州贰守时名重，清洁持身玉不如。\n莫逐沿流同泛泛，须知泾渭本来殊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3255,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄宾畿老弟 其二","author":"杨士奇","text":"紫陌红芳映日鲜，须臾荣落亦堪怜。\n长山绝谷青松树，解阅风霜过百年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3256,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄宾畿老弟 其三","author":"杨士奇","text":"古人贫贱总清高，贤弟殷勤慎所操。\n诗书教子光先业，胜贮如山金错刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3257,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题海天秋兴图 其一","author":"杨士奇","text":"琼台太守弹琴罢，观海如观太极中。\n远水长天清一色，悠然心境共昭融。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3258,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题海天秋兴图 其二","author":"杨士奇","text":"已共安期汗漫游，海天空望白云秋。\n骖麟跨凤知何处，应在三山与十洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3259,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画赠德逊南归 其一","author":"杨士奇","text":"花落江南清浦香，春潮逦迤送归航。\n九华才过匡庐出，看遍名山到故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3260,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画赠德逊南归 其二","author":"杨士奇","text":"我昔金鱼洲畔住，云山清满旧柴扉。\n君家只在邻东曲，多酿松华待客归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3261,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄题浮梁环秀亭","author":"杨士奇","text":"地偏潇洒一尘无，水色山光绕画图。\n他日乘风溯南斗，李家亭上看蓬壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3262,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杨自然处士挽诗 其一","author":"杨士奇","text":"不慕清名达九重，全家长住水晶宫。\n芰荷为带芙蓉佩，䞉有人传惠济功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3263,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杨自然处士挽诗 其二","author":"杨士奇","text":"平生心事听皇天，流水行云任自然。\n养得凤毛成五色，青云白日看飞骞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3264,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"书周益公所题汤氏别业","author":"杨士奇","text":"不将出处间心期，邻里无时款竹扉。\n传世文章高世节，汤家千岁有光辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3265,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题李处士画","author":"杨士奇","text":"一去城中竟不归，閒依泉石谢尘羁。\n世人谁不知名姓，时有扣门来请医。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3266,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨诚都事赴山西 其一","author":"杨士奇","text":"郎官湖上先生宅，十五年前共酒樽。\n今日都门重邂逅，令人肠断郭东原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3267,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨诚都事赴山西 其二","author":"杨士奇","text":"花县幕中留惠爱，银台初近御炉香。\n又承宠命超迁去，马首青山望太行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3268,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽刘仲海 其一","author":"杨士奇","text":"心如明月湛孤圆，扫石看云度岁年。\n家在吉阳城里住，未曾轻到县门前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3269,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽刘仲海 其二","author":"杨士奇","text":"竹窗幽户久栖迟，不道无官枉盛时。\n綵笔长书五花诰，大儿身到凤凰池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3270,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽刘仲海 其三","author":"杨士奇","text":"文水仁山映角巾，常年书社会比邻。\n如今又及嘉平节，看赏梅花少一人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3271,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题舒有常画","author":"杨士奇","text":"河阳县里花争发，彭泽门前柳正繁。\n公暇小亭无俗吏，坐听流水出松根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3272,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹","author":"杨士奇","text":"双玉亭亭翡翠毛，春风晴拂綵云高。\n也知结实须来凤，即遣为竿合钓鳌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3273,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹寄曾东铭先生","author":"杨士奇","text":"乡里相违五十年，喜闻归隐得幽偏。\n一枝遥寄琅玕竹，为爱风流向阮贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3274,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送家兄及妻子还乡后感怀三首 其一","author":"杨士奇","text":"少小情亲弟与兄，老来兄弟更关情。\n五年一见头如雪，无那秋风促去程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3275,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送家兄及妻子还乡后感怀三首 其二","author":"杨士奇","text":"家在西昌旧业贫，孟光归处重辛勤。\n十年茆屋秋风破，独自牵萝补白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3276,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送家兄及妻子还乡后感怀三首 其三","author":"杨士奇","text":"迎门儿女笑牵衣，每日中庭候晚归。\n今夜片帆何处泊，应同阿母忆京畿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3277,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽颜子明 其一","author":"杨士奇","text":"曾吟楚些招颜谷，悽怆伤情久不堪。\n忽复悲歌动行路，愁云深锁万松庵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3278,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽颜子明 其二","author":"杨士奇","text":"文渊阁下集群英，清世才华重老成。\n大典已传名姓在，光荣终不负平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3279,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送皑上人住持建昌太平兴国寺 其一","author":"杨士奇","text":"持钵王城住几年，袈裟新汎上江船。\n禅心还似江心月，江自东流月自圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3280,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送皑上人住持建昌太平兴国寺 其二","author":"杨士奇","text":"迢迢旴水映禅关，水上浮云意共閒。\n讲罢楞伽无一事，㫋檀树里看军山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3281,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杨补之掀篷图","author":"杨士奇","text":"玉节葳蕤导羽麾，香风吹度翠云涯。\n披图彷佛如曾见，江上孤篷岁晚时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3282,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送人归故乡","author":"杨士奇","text":"江花江柳送船开，燕语莺歌唤客回。\n旧屋归来春未晚，青山如玉水如苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3283,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题蒋院判小画 其一","author":"杨士奇","text":"一卷深护紫苔文，乔木疏篁翠拂云。\n却