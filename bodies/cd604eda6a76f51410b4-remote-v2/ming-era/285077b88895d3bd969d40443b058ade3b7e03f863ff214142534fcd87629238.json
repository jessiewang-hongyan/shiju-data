[{"title":"送余太史云衢册封周藩四首 其一","author":"于慎行","text":"名都茅土建亲贤，春草平台万户烟。\n此日邹枚应罢赋，词臣已和柏梁篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20341,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送余太史云衢册封周藩四首 其二","author":"于慎行","text":"五月隋堤柳色醺，炎风吹浪滚黄云。\n河壖满目无青草，瓠子歌声更忍闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20342,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送余太史云衢册封周藩四首 其三","author":"于慎行","text":"夷门邸第列储胥，十里朱楼夹道居。\n少府金钱浑欲尽，王孙强半食无鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20343,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送余太史云衢册封周藩四首 其四","author":"于慎行","text":"碣石宫前负弩过，闾门秋色入鸣珂。\n可知瀛海多仙气，九派中分太史河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20344,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送田钟台殿读省觐南还四首 其一","author":"于慎行","text":"十载金门隐岁星，故园归去为趋庭。\n武夷山色休相讶，不染风尘两鬓青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20345,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送田钟台殿读省觐南还四首 其二","author":"于慎行","text":"怜君万里入沧洲，天际孤帆水上浮。\n别后相思无处寄，鸿声不到海南头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20346,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送田钟台殿读省觐南还四首 其三","author":"于慎行","text":"零落心期世路难，河梁斗酒为谁欢。\n不知十二街头月，今夜君从何处看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20347,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送田钟台殿读省觐南还四首 其四","author":"于慎行","text":"别恨归心总不支，蓟门烟雨送行时。\n离人莫折官桥柳，为我留将一两枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20348,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人作府幕二首 其一","author":"于慎行","text":"少年来作五陵游，一掾风尘已白头。\n今日送君秋色里，疏钟小雨上离舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20349,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人作府幕二首 其二","author":"于慎行","text":"幕下风流何处寻，芙蓉秋水白云深。\n府中不识参军笔，试问甘泉旧羽林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20350,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望仙吟二首送王鍊师入关 其一","author":"于慎行","text":"云中白鹿上仙家，缑氏城头落綵霞。\n吹断玉笙人不见，春风一树碧桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20351,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望仙吟二首送王鍊师入关 其二","author":"于慎行","text":"玉女芙蓉接汉京，金人高掌露华清。\n茂陵松柏今零落，云里空闻卫叔卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20352,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿京山李太封君八十 其一","author":"于慎行","text":"驻世谁称陆地仙，竟陵秋雨芰荷船。\n岁华欲问今多少，曾记兴皇入楚年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20353,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿京山李太封君八十 其二","author":"于慎行","text":"一卧沧江少世情，西窗鹤梦不曾惊。\n日高欲进雕胡饭，堂下风吹佩玉声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20354,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿京山李太封君八十 其三","author":"于慎行","text":"凤诏双函锦字芳，紫烟白石钓兰塘。\n閒来却向宫云望，香案前头绿鬓郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20355,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿京山李太封君八十 其四","author":"于慎行","text":"八十年来卧楚山，绯袍春酒醉红颜。\n从今岁月应难纪，名在丹台玉室间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20356,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞下曲八首为蓟门大夫赋 其一","author":"于慎行","text":"渔阳九月海风秋，汉使行边雪满裘。\n一拍胡笳双鬓改，应怜飞将不封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20357,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞下曲八首为蓟门大夫赋 其二","author":"于慎行","text":"落日黄云古戍平，铙歌千骑远横行。\n江南剑客多年少，笛里初闻塞上声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20358,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞下曲八首为蓟门大夫赋 其三","author":"于慎行","text":"材官角射技争施，十石轻开未是奇。\n虚发自矜能下雁，阴山愁杀射雕儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20359,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞下曲八首为蓟门大夫赋 其四","author":"于慎行","text":"铁骑翩翩塞草平，诏书十道大徵兵。\n弓悬明月秋常满，剑倚青天夜自鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20360,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞下曲八首为蓟门大夫赋 其五","author":"于慎行","text":"蓟门迢递雁门东，百二河山紫气中。\n一自单于称保塞，边城弦管识春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20361,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞下曲八首为蓟门大夫赋 其六","author":"于慎行","text":"西山重叠护燕台，凤舞龙飞势自回。\n鸟道千寻天上落，孤城一片日边开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20362,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞下曲八首为蓟门大夫赋 其七","author":"于慎行","text":"万里呼韩款塞年，君王大发水衡钱。\n从教白璧挥如土，只看龙堆一缕烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20363,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞下曲八首为蓟门大夫赋 其八","author":"于慎行","text":"城下骖驔铁骑飞，名王尽著汉臣衣。\n少年笑解茱萸带，换得胡姬善马归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20364,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梦笑","author":"于慎行","text":"不知蝴蝶是庄周，开口蘧蘧笑未休。\n若使人生浑似梦，谁能更解许多愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20365,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日怀寄可大","author":"于慎行","text":"灞上魂销已隔年，御沟烟柳送潺湲。\n春深欲问南来雁，知到潇湘若个边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20366,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送范涵虚太史请假南归四首 其一","author":"于慎行","text":"握手离亭一黯然，北风吹送渡江船。\n斗边自上丰城气，明月谁知是各天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20367,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送范涵虚太史请假南归四首 其二","author":"于慎行","text":"与君连棹谒枫宸，五见长安碧草春。\n今日送君江上去，自怜犹作未归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20368,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送范涵虚太史请假南归四首 其三","author":"于慎行","text":"年年陌上起骊歌，别恨秋声可奈何。\n欲折一枝桥畔柳，长条零落已无多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20369,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送范涵虚太史请假南归四首 其四","author":"于慎行","text":"莫拟扁舟泛五湖，六桥烟月旧游孤。\n停桡试隔秦淮听，子夜歌声尚有无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20370,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"听琴曲二首戏赠子充 其一","author":"于慎行","text":"一夜秋声入洞房，朱弦调罢理清商。\n琴心自合相如识，可道旁人枉断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20371,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"听琴曲二首戏赠子充 其二","author":"于慎行","text":"纤手双鬟一拍成，西风吹冷凤凰城。\n忽惊塞雁天南起，弹到潇湘第几声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20372,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙词二首送聂鍊师 其一","author":"于慎行","text":"玉洞沈沈晓雾寒，鼎中绛露转金丹。\n黄庭阅罢心无事，閒数飞花落石坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20373,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙词二首送聂鍊师 其二","author":"于慎行","text":"野鹤閒云自有家，万山深处住烟霞。\n无端出到人间世，落尽仙台白玉花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20374,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送静上人还鸡鸣山二首 其一","author":"于慎行","text":"缥缈灵山枕帝畿，安禅一榻旧荆扉。\n钟声杳霭秋云里，万户江烟锁翠微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20375,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送静上人还鸡鸣山二首 其二","author":"于慎行","text":"杖锡新辞阙下归，从今出世有传衣。\n经台到日春应暮，多少天花作雨飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20376,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答二兄书","author":"于慎行","text":"鸿声不到夜郎天，故国音书又隔年。\n两地愁心何处梦，长安秋月不成眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"