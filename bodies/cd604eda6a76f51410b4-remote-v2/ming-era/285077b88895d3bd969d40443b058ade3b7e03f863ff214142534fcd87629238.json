d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20401,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱可大工部奉使归省四首 其一","author":"于慎行","text":"宝马鸣珂御苑东，路人争识小司空。\n看君昼锦应难似，两袖天香出汉宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20402,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱可大工部奉使归省四首 其二","author":"于慎行","text":"才入鹓鸾旧日群，宁亲早已望江云。\n称觞剩有芙蓉色，可是仙人掌上分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20403,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱可大工部奉使归省四首 其三","author":"于慎行","text":"形影相依自两生，重游春苑不胜情。\n如何芳草横门月，又度阳关曲里声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20404,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱可大工部奉使归省四首 其四","author":"于慎行","text":"南极天高动使槎，五云缥缈上公家。\n趋庭傥问垂髫侣，避世如今鬓已华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20405,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张洪阳学士请告南旋四首 其一","author":"于慎行","text":"归舟端不异登仙，予告恩深侍从年。\n临发黄门传尺诏，尚方驰赐买山钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20406,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张洪阳学士请告南旋四首 其二","author":"于慎行","text":"长河南下水曾波，吴楚青山枕上过。\n行到浔阳江口望，应怜秋色故园多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张洪阳学士请告南旋四首 其三","author":"于慎行","text":"秋风湖上鳜鱼肥，明月扁舟兴欲飞。\n蕙带从来浑未改，江猿应识主人归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张洪阳学士请告南旋四首 其四","author":"于慎行","text":"笑遣麒麟阁上名，閒居聊得赋西征。\n只愁拈出金瓯字，夜鹤山中梦又惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题张学士閒云馆四首 其二","author":"于慎行","text":"滕王阁下碧波寒，徐孺祠前木叶丹。\n一曲池台千竹里，可知无梦到长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20410,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题张学士閒云馆四首 其三","author":"于慎行","text":"斋心自捧玉函经，永日焚香坐小亭。\n隐几萧然秋似水，不知江上几峰青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20411,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题张学士閒云馆四首 其四","author":"于慎行","text":"山中丛桂碧氤氲，十亩烟皋领白云。\n携得青萍双剑在，斗间遥夜动星文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20412,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王忠铭宗伯山房四咏 其一 文笔晴烟","author":"于慎行","text":"文笔孤峰入紫霞，管城汤沐属谁家。\n炎风吹散江淹梦，洒作仙人掌上花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王忠铭宗伯山房四咏 其二 金鸡春晓","author":"于慎行","text":"彩霞为羽日为冠，啼破桃都五夜寒。\n似向蓬莱宫里见，春声晓殿簇鹓鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王忠铭宗伯山房四咏 其三 石陇马鞭","author":"于慎行","text":"石陇双峰控锦鞍，五花蹀躞驻云端。\n不禁更向吴门望，海色遥分练影寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]