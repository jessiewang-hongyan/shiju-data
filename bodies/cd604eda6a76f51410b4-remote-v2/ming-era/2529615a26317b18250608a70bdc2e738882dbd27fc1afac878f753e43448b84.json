[{"title":"题王二采莲图次壁上沈石田韵","author":"边贡","text":"秋塘露下菰蒲冷，野鹜沙凫夜相并。\n东山月出一丈高，岸柳垂垂见疏影。\n鸡鸣浦口渔伴稀，自采红莲溪上归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17353,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题石田画二首为杨仲深作 其一","author":"边贡","text":"夕阳半落群峰高，古林萋迷猿正号。\n欲招同人眺野色，安得扬州何水曹。\n近烟苍苍远烟白，此时独作村西客。\n君不见石子冈头萝薜深，麋鹿成群讵相识。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17354,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题石田画二首为杨仲深作 其二","author":"边贡","text":"平生不识石田子，往往相逢画图里。\n世传百本无一真，抹青涂紫俱门人。\n秋高对此双眼豁，倏然置我溪与壑。\n君不闻画家贵意不贵工，只在冥冥漠漠中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17355,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为王工部大用题菜图","author":"边贡","text":"采采雨间叶，青青陌上春。\n欲知疏溉力，试问园中人。\n纷纷钟鼎徒，醉卧饱肴胾。\n不谓丹青手，能传使君意。\n使君有园十亩强，时因采摘露沾裳。\n短篱不许邻鸡入，嘉味还同过客尝。\n后来勿斸园中土，留取清风千叶长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17356,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题贞洁卷","author":"边贡","text":"贞比高陵柏，洁比阴壑冰。\n缅彼考槃客，相思劳寝兴。\n至洁不可污，至贞不可变。\n两世同一心，百年能几见。\n柏有后秋叶，冰有中夏寒。\n贞洁苟弗渝，炎雪何能干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17357,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题孔水部廷瑞双鹊图","author":"边贡","text":"峨峨中庭石，傍此寒岁花。\n离离错锦绣，五色明朝霞。\n双鹊何处来，相对声喳喳。\n似为主人报，水曹恩宠加。\n水曹住近荆门闸，千里洪流归弹压。\n疏排不数贾让功，决瀹尽遵神禹法。\n玄圭早晚当告成，天王近日已知名。\n崇阶峻级悬相待，岂用区区灵鸟声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17358,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题白岩竹","author":"边贡","text":"竹枝袅袅根卓卓，质坚不受苔藓剥。\n是谁向壁扫缣素，古色苍颜秋濯濯。\n彷佛犹自烟水区，万里湘潭土新斸。\n又疑身坐风雨窟，老蛟盘挐突头角。\n醉呼虞帝歌南风，苍梧云深翠华邈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17359,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题章郡守琼林醉归图","author":"边贡","text":"宫杨媚朝旭，沟水鸣春湍。\n别殿黄金瓦，横桥白玉阑。\n借问此何地，无乃东长安。\n长安陌头二三月，杏萼离离缀绯雪。\n伊谁种此千万株，长待儒生与攀折。\n孝皇龙飞十五春，亲策进士三百人。\n是时嘉州有章子，名姓赫赫惊朝绅。\n白马青袍速流电，日中醉下琼林宴。\n吁嗟此日画里看，犹似当年陌头见。\n陌头画里两模糊，可道今吾非故吾。\n南台罢起郎官草，东郡聊分刺史符。\n皎月寒冰清誉在，云霄随处是亨途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17360,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"椿庭荣寿图诗","author":"边贡","text":"白头注书懒出门，足迹不到东西村。\n倏忽移家向千里，远游却谢君王恩。\n钱唐夜舸冲潮发，柏署啼乌晓方歇。\n升堂见子复见孙，綵服如云映秋月。\n江鱼竹笋称觞暇，时坐肩舆过城下。\n苏公堤上闻采莲，岳王祠前看走马。\n问君北归今几春，予欲乘槎西问津。\n渡河先访封君宅，携酒来攀庭际椿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17361,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题杨四山卷","author":"边贡","text":"苍峰崔嵬，翠巘巀嶪，阿祖当年手亲叠。\n有得必失毁必成，天道往复天心明。\n我开我堂酌我酒，蔼蔼岚光映虚牗。\n朝对图书夕宾友，杨家子孙千世守。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17362,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题刘道行祖母拾禾教子册","author":"边贡","text":"朝拾田中禾，暮爇釜下薪。\n止愿儿力学，不愁家业贫。\n儿生有儿先入官，可随万里居长安。\n帝予封章不肯受，却待成名报吾母。\n江风吹船南入巴，阿孙奉使儿还家。\n拜坟呼母母不语，泪湿秋山空黍花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17363,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题周道士采苓卷","author":"边贡","text":"夫椒山中多老松，白云隐隐盘苍龙。\n山人荷钁采苓去，往往仙人松下逢。\n仙人本是山人作，山人向来满功课。\n句丽勾吴几万里，杏花阴里春风大。\n君不见蒲江古井凝绿华，乳婴绠上声唑唑。\n长秋道士不入口，放鱼女儿升綵霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17364,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题工部李侍郎给饷还朝卷","author":"边贡","text":"旄头焰射榆塞红，穹庐夜徙狼山东。\n边头十堡九堡空，虎衔髑髅狐啸风。\n箭书入奏龙改色，天兵啴啴下西北。\n旌纛卷空空宇黑，冬官老臣奉丹敕。\n百万刍粮纷崱屴，插羽鸣金捣河碛。\n朔方血云蛇火赤，勃勒残兵走无迹。\n归来谒帝甘泉宫，手执筹边书一通。\n当廷不数搴旗功，呜呼老臣开济忠。\n晓日沙堤散朝宴，黄金厩马辉相炫。\n道傍观者谁不羡，韩公范老今重见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17365,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题李客部册为其母受敕焚黄作","author":"边贡","text":"峨峨陇门碑，萧萧墓田草。\n春卿哭母处，泪尽秋山道。\n秋山云黄日脚斜，玄堂寂寂扃土花。\n祀筵俎豆杂五鼎，玉文鸾纸明江霞。\n月弦张宇登岁矢，二十星霜一弹指。\n欲问春卿哭母心，潺湲日夜龙溪水。\n水流不复返，母去何时回。\n金沙閤珠翠，碧火扬青灰。\n断机壁空蛛网窣，捣衣石冷啼蛄歇。\n还家何物最堪伤，白发中庭坐明月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17366,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"萱花图送刘汝忠归省","author":"边贡","text":"萱草花，何袅袅。\n春风入堂背，游子在远道。\n白头慈亲相对看，日暮还成被花恼。\n花未落，子登堂，白头一笑千忧忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17367,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"海樵吟","author":"边贡","text":"海樵老翁居海岛，自言不及山樵好。\n山樵伐木归作薪，隆冬满室回阳春。\n海樵网得珊瑚树，灶底欲燃燃不去。\n日将空腹对家人，敢向山樵论饱饫。\n中兴天子元会辰，大开阊阖罗九宾。\n敕使四方求宝货，海樵尚食山樵饿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17368,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"牵夫谣","author":"边贡","text":"上水逆风牵百丈，官舸真同上天上。\n后笞前咤舆皂狞，努力揽牵谁敢放。\n人喜牵夫歌牵歌，不知此中哀怨多。\n何日黄流变黄土，牵夫得免奔波苦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17369,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"竹坡子辞为徐侍御作","author":"边贡","text":"坡之竹兮茏葱，子揽辔兮在公。\n子在公兮居靡遑，蹇予独兮坡之阳。\n阳坡兮延伫，竹袅袅兮含雨。\n愿秩质兮为箫，和翔凤兮仪鸣韶。\n帝关兮峻深，与子归来兮坡阴。\n守虚静兮抱贞素，听容与兮迟暮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17370,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"爱日楼为钱水部作","author":"边贡","text":"锡山之楼，水曹所构。\n下瞰百川，上临斗宿。\n层楣切霄，飞栱丽昼。\n龙鳞差差碧瓦齐，峻梯蜒蜿垂丹霓。\n俯视穷四极，仰观凌太虚。\n雕楹列琪树，天窗秘灵书。\n三光无冬春，和气通华胥。\n不睹奇谲迹，谁明此楼是仙居。\n楼中之母健且康，脩眉如发双瞳方。\n云冠峨倒影，烟袂飘空香。\n真澄瑩含元，穆坐楼中央。\n兰孙玉息，献斝称觞。\n擘斑麟，炮紫凰。\n进文枣，倾瑶浆。\n淋漓飒沓，罗列趋蹡。\n舞拓拔，歌陵冈，一日愿作千岁长。\n千岁长，万岁久，楼长新母长寿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17371,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"弘治辛酉夏五月省元杜廷陈氏卧病旅邸予往问焉至则死矣逾四年其兄廷献会予京师言及泣数行下且谓不可无诗以哭其弟也追忆往事为补此篇","author":"边贡","text":"切切重切切，秋风桂枝折。\n哀哀复哀哀，人归长夜台。\n桐为棺兮席为舍，寒巷萧条日光下。\n孤儿五岁初学行，向人啼父不成声。\n访君来，哭君去。\n乡路迢迢隔暝烟，潍水莱山渺何处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17372,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽秦国声乃翁","author":"边贡","text":"天井峰头暮烟紫，少微星落山翁死。\n山前新墓土累累，石门题著封君字。\n封君在时山水光，鸡群寒鹤何昂藏。\n一身独作乡社表，见者呼为王彦方。\n自从仙游去不返，江波寂寂江花晚。\n钓竿三尺挂垂杨，野径无人竹门掩。\n有生会有死，全归诚独难。\n名归隐逸传，衔称大夫官。\n佳儿擅时誉，采采云中鸾。\n恩华烛幽邃，紫诰双龙盘，封君九原心亦安。\n呜呼，封君九原心亦安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17373,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"节义歌为方少参大器作","author":"边贡","text":"囊金失，行子号，还子以金不受丝与毫。\n良人殂，舅姑老，环堵麻衣不识门前道。\n吁嗟乎墓中人，虽死死不孤。\n诸郎致身文且武，恩光下照幽泉土。\n妻也贞姬夫义夫，列传有名光烈祖，谁道今人不如古。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17374,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"朱子皋挽词","author":"边贡","text":"约食墩前起新庙，乡人共说朱郎孝。\n朱郎能孝复能仁，眼看盗贼皆良民。\n直拟贞心化强暴，岂料势穷翻杀身。\n君不见钱塘潮，汨罗水，同是乾坤忠义鬼。\n春草碧色江绿波，魂招不来将奈何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17375,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"钱国子水南挽歌","author":"边贡","text":"君不见李世绩，姊病亲煮粥，粥火燎须须为秃。\n又不见闵子骞，大雪被芦裘，一言悟父母复留。\n水南茂才具二美，白首穷经辟雍里。\n冻雾空嗟岭豹藏，春雷不见江龙起。\n孝思之楼江水傍，四时礿祀烝且尝。\n岂惟急难等原涉，还誇逊产同王商。\n白鸡梦醒丹旌湿，精舍玄猿终夜泣。\n凭将都士挽歌辞，裒作它年聘君集。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17376,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陈司寇挽诗","author":"边贡","text":"野白秋草黄，颓阳下枯岭。\n谁歌蒿里曲，悽绪纷难整。\n矗矗起新坟，素旗飘断云。\n陇下笳箫哀响咽，尚书不归履声绝。\n履声绝，那可招。\n山空石麟死，松柏寒萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17377,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"王封君挽诗","author":"边贡","text":"儿在客，父在床。\n平生颜色不得一相见，虽有汤药何由将。\n父在殡，儿在野。\n生前不受豸史封，空见龙光贲泉下。\n雪林山头高筑坟，花烟漠漠愁青春。\n请看阡畔行啼者，半是当年怀惠人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17378,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴节妇","author":"边贡","text":"风雨屋萧然，孤灯四十年。\n家声越国后，心事纪姬前。\n行入先皇录，名垂太史篇。\n溪清石不转，寒影照娟娟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17379,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送周判官","author":"边贡","text":"一官成晚岁，共惜子云才。\n驱马国门路，北风声正哀。\n山形横塞起，边色映空来。\n感慨登临处，残阳照古台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17380,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送张进士孔昭赴南刑部","author":"边贡","text":"春风扬子渡，江上雪初消。\n草色连三月，山名记六朝。\n白云官舍近，红日帝乡遥。\n欲寄西来信，秦淮有落潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17381,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送郑徵之还济南","author":"边贡","text":"昼锦人争羡，居官不离乡。\n地亲王子贵，衙对佛山长。\n珂马春情远，称觞午梦香。\n相思有南雁，瑶草寄新芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17382,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送康状元乃叔上舍生还武功","author":"边贡","text":"武功山路渺，西去雪巉巉。\n里布儒生服，邮车使者衔。\n上堂修典册，登陇拜松杉。\n记取龙头事，乡人问阿咸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17383,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"阙题 其一","author":"边贡","text":"久客便醒卧，逢君一举杯。\n后山元苦节，同父旧多才。\n雨映三更烛，春飘二月梅。\n重来话相访，好记凤凰台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17384,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"阙题 其二","author":"边贡","text":"往往风雩下，行歌大雅篇。\n青春逢此地，白发感流年。\n岸柳村村合，江花处处妍。\n到官多暇日，一访谢公泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17385,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和张内翰见寄韵","author":"边贡","text":"尔向家山去，休歌蜀道难。\n乘车真得意，戏綵足承欢。\n剑阁留诗草，亭溪把钓竿。\n玉堂回首处，梦绕五云端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17386,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冯吕梁惠诗率尔酬赠兼谢药草之惠","author":"边贡","text":"高情冯水部，相见示新篇。\n钟磬悬清庙，琼瑰落九天。\n色流湖岸荇，香袭楚皋烟。\n更谢金光草，扶予衰病年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17387,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"临清舟中寄苏三泉","author":"边贡","text":"水国逢君寿，秋花荡客船。\n河流动颜色，乡土接风烟。\n天地青尊外，光阴素发前。\n吾愁随日长，叨禄漫多年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17388,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送曾世亨兵备赴蜀","author":"边贡","text":"九秋三峡道，万里一舟孤。\n夜渡剑门月，波光摇湛卢。\n诗论青冢恨，恩返绿林逋。\n岁晚东来使，梅花肯寄无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17389,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜中不寐登楼有怀","author":"边贡","text":"远漏连疏柝，山空夜寂寥。\n地看乡土隔，书寄美人遥。\n海气含春色，江云入斗杓。\n泺源桥上柳，应有拂阑条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17390,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送黄北川赴京","author":"边贡","text":"黄子黄门客，青春上国行。\n风尘遥入望，边塞独关情。\n捧日双龙阙，看云五凤城。\n怀中有短疏，知欲请长缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17391,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜访朱应辰","author":"边贡","text":"启閤悬灯坐，霜天夜转幽。\n居然剡溪兴，何异竹林游。\n水落江鸿去，城孤海月流。\n重逢好相忆，红蓼白门秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17392,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄吊松江周翁","author":"边贡","text":"不见南溪老，苍茫二十秋。\n浦云空北望，江水自东流。\n已化辽阳鹤，犹疑海畔鸥。\n存亡一掬泪，何日洒林丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17393,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"解印后病中书怀二首留别南都诸同游 其一","author":"边贡","text":"敕放青山去，恩同碧海深。\n静居谐始愿，孤往恝冥心。\n已破槐南梦，何须泽畔吟。\n我乡多水竹，苍翠想森森。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17394,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"解印后病中书怀二首留别南都诸同游 其二","author":"边贡","text":"一别齐川路，两年今始归。\n久知麋鹿侣，遥待薜萝衣。\n洞古龙还在，林深鸟不飞。\n入山城市隔，从此迹应稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17395,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过吕梁 其一","author":"边贡","text":"解缆洪流树，侵星过吕梁。\n风云犹帝里，山水即吾乡。\n砚拂秋岚湿，衣沾晓露凉。\n长年欣暑退，伊轧棹歌长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17396,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过吕梁 其二","author":"边贡","text":"泽国新秋爽，玄云起北溟。\n衣冠逢水部，风雨谢山灵。\n雅意堪留滞，清词足典刑。\n夕舟兼晓榻，谈坐忆蒲汀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17397,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王分司因过白塔寺饮","author":"边贡","text":"九日登高兴，三秋怅别情。\n重携一尊酒，此地共君倾。\n塔涌浮云暗，山衔落日明。\n还将红树色，遥送海东行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17398,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登南明山 其一","author":"边贡","text":"石磴抱云回，高高积翠开。\n苍藤昏古殿，碧树隐仙台。\n钟鼓三天下，风烟万壑来。\n不知千载后，谁忆此衔杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17399,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登南明山 其二","author":"边贡","text":"地僻无人赏，灵山迥独看。\n石梁横险绝，岩洞倚高寒。\n静已忘尘世，狂犹系冗官。\n长歌送西日，野色上虚阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17400,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南都送道士","author":"边贡","text":"自君辞白下，灵悟入玄冥。\n始信虚无外，元来别有经。\n乾坤寄水火，离坎走雷霆。\n兀兀眼前事，真如江上萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17401,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春雪","author":"边贡","text":"怪尔阳春日，凄凄昼雪寒。\n情知飞絮假，还当落梅看。\n向日偏萦户，随风故绕阑。\n同云幕千里，吟坐忆长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17402,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"分赋春雨得时字","author":"边贡","text":"为爱西堂雨，黄昏坐不辞。\n础痕移榻处，池涨捲帘时。\n瑞纪农官颂，题分水部诗。\n客车何日返，真长故山芝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17403,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日","author":"边贡","text":"白日寒城暮，清秋画角哀。\n地偏妨采菊，乡远怕登台。\n鸿雁天边去，风云塞上来。\n故交零落尽，卮酒向谁开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17404,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次陈静斋九日二首 其一","author":"边贡","text":"山水留佳赏，登临夙有期。\n却怜重九日，空读汴台诗。\n卧雨情无那，停云思欲痴。\n夜深还秉烛，閒对菊花枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17405,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次陈静斋九日二首 其二","author":"边贡","text":"九日逢连雨，宾朋屡费邀。\n实孤黄菊盏，虚想绿云箫。\n蟋蟀声逾近，梧桐叶尽飘。\n喜闻归不远，旌节候来朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17406,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日登吹台次毛侍御韵","author":"边贡","text":"对酒重阳雨，登楼万里心。\n异花开晚节，群木秀寒林。\n鼓角连天暮，风云接塞阴。\n王师捷何日，倾耳北来音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17407,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春暮","author":"边贡","text":"骨肉俱零落，还家不似归。\n自伤真块处，谁更遣花飞。\n雨揠春苗病，风摧旅雁稀。\n飘飘木兰楫，吾欲泛东沂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17408,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"颐痾清源中秋罹雨宵分言霁短音寓怀","author":"边贡","text":"隔岁乡关月，中秋想一看。\n真愁白发显，翻隐碧云端。\n桂影流烟湿，金波映浦寒。\n鸡鸣兴不浅，吟酌细凭阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17409,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"正月七日饮敖水部分司归即事","author":"边贡","text":"结舍临江岸，传觞感岁华。\n偶同人日酒，翻滞使星槎。\n水冻仍馀雪，林寒且未花。\n醉归烧短烛，高枕听昏鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17410,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宝应元夕饮朱升之舍","author":"边贡","text":"望望平安驿，春行路不遥。\n故人还此地，芳序且元宵。\n水近潮通閤，灯寒月过桥。\n计程拚取醉，佳赏更须招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17411,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"供事长陵","author":"边贡","text":"俎豆荐春芳，东陵昼漏长。\n偃松盘古榭，灵草秀虚堂。\n日月皇舆远，江河圣历昌。\n因山昭俭德，千载颂文皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17412,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西陵访王给事汝温不遇","author":"边贡","text":"狂夫多野性，春到每思家。\n却访山中客，还逢水际花。\n薄云阴古殿，鸣鸟聚连沙。\n迤逦回溪晚，西陵月正斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17413,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]