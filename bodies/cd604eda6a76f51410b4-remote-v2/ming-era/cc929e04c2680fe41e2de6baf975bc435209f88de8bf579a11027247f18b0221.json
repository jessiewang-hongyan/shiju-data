[{"title":"寄人","author":"郑琰","text":"分袂当年待晓鸡，曲栏桥外锦堂西。\n凫吞莲子房房苦，蝉抱杨枝树树啼。\n深竹梦归神女婿，暮花伤别阮郎妻。\n至今肠断春风候，豆蔻初生槿叶齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4479,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄黄山隐者","author":"郑琰","text":"传闻轩帝有仙踪，古洞无扉对乱松。\n半让石床供蟋蟀，细裁云叶补芙蓉。\n分将月夜三千里，买断秋烟七十峰。\n尚忆我留汤口寺，隔林疏雨听残钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4480,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠林纯卿","author":"郑琰","text":"十载看花入醉乡，燕姬招隐白云庄。\n罢官卜宅思栽柳，垂老将身学卖浆。\n夜月邀僧同耽首，春湖供客典鱼肠。\n孤山万树梅花发，剪烛裁诗夜未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4481,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日西湖即事","author":"郑琰","text":"苏小门前柳带烟，暖沙晴日水如天。\n杏糜供作宜春酒，榆荚分为买笑钱。\n垂柳绿遮骑马路，落花红衬钓鱼船。\n杜鹃不解游人意，催尽韶光又一年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4482,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉和张司谏左掖夜直","author":"郑琰","text":"汉殿秋生禁柳黄，露融仙掌色苍苍。\n铜龙水咽鸡人漏，金象烟销鸟篆香。\n云度钟声浮苑树，月临花影上宫墙。\n夜闻待诏传天语，法驾明朝幸建章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4483,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春晓望阙","author":"郑琰","text":"鱼藻门前晓角残，月斜干鹊露华漙。\n金舆欲动宣宫使，银锁初开拥侍官。\n辽左羽书东海沸，秦京烽火陇云寒。\n汉庭何日无封事，不许书生策治安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4484,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奇薛素","author":"郑琰","text":"野草城边油壁车，海棠开尽燕飞初。\n愁深司马舟中泪，梦逐萧娘锦上书。\n一水云阴桃叶渡，四桥春暗浣花居。\n伤心南陌垂杨月，夜夜香尘满客裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4485,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"黄山道中","author":"郑琰","text":"微霜风物色凄凄，路入黄山是五溪。\n帝子不归汾水上，行人愁过穆陵西。\n荒原晓露铜驼泣，古驿秋风铁马嘶。\n独客伤神家万里，斜阳征雁楚天低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4486,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"逢徐兴公话旧","author":"郑琰","text":"天涯离别九回肠，今日逢君复异乡。\n潞水闻猿双涕夜，黑山归马五年霜。\n兵戈消息何须问，弟妹漂零且自伤。\n此会匆匆又分手，暮云衰草更凄凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4487,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江头别","author":"郑琰","text":"江风今夜寒，郎且江边住。\n拂晓上楼看，郎船不知处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4488,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词","author":"郑琰","text":"莫将离别恨犹深，一岁相逢一夜心。\n空宫尚有如霜鬓，不识君王直到今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4489,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西湖寻曹能始","author":"何璧","text":"垂杨漠漠荇田田，何处春风十四弦。\n放鹤僧归天竺雨，听莺人过六桥烟。\n诗寻萝薜谁边寺，酒载桃花第几船。\n游子天涯魂易断，非关春树有啼鹃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4490,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"逢陈当时","author":"何璧","text":"湖海年年气尚横，相逢一笑盖初倾。\n悔因任侠轻妻子，恨不从军结弟兄。\n客里卖文难得价，市中说剑畏知名。\n灯前喜共猿公语，闻道辽阳正请兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4491,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金陵寄沈千秋","author":"何璧","text":"挟策干时任转蓬，壮夫曾悔学雕虫。\n荒年有客愁炊桂，薄俗何人惜爨桐。\n士到出山谁不贱，术惟游世最难工。\n长安官道原如发，只有狂生叹路穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4492,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郑翰卿自新安移家金陵诗以讯之","author":"何璧","text":"南北飘零逐燕飞，营巢今复傍乌衣。\n家移白下原为客，梦到黄山不是归。\n廿载看花怜并蒂，半生种柳叹成围。\n江天处处皆新水，好向垂纶燕子矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4493,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日过能始民部署中","author":"何璧","text":"为郎无一事，客到但行吟。\n落叶满官舍，此中秋更深。\n庭虚闻咽潦，门冷集寒禽。\n一自黄花对，转怀头上簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4494,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"广陵送王太古还白下","author":"何璧","text":"我有秦淮梦，虽还不是家。\n送君隋苑上，惆怅柳条斜。\n归客趁新燕，游人叹落花。\n伤春兼惜别，况复在天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4495,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早春寄柬谢宇中","author":"何璧","text":"古寺门前新柳垂，思君先订听黄鹂。\n倡楼雪满催歌扇，僧舍春寒忆酒旗。\n月到秦淮皆似面，山如钟阜始为眉。\n东风九十寻芳急，不是看花莫杖藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4496,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"园居","author":"赵崡","text":"不是夔龙侣，偏宜鹿豕群。\n自题招隐字，谁续绝交文。\n凿壁来山雨，编篱带野云。\n还思接舆子，遗世不如君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4497,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"茂陵","author":"赵崡","text":"黄山历尽见孤城，城上楼高眼倍明。\n芳树寝园今北望，暮云宫阙旧西京。\n芙蓉昼冷仙翁露，苜蓿春闲宛马声。\n回首长杨夸猎地，何人得似子云名？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4498,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"己亥初夏","author":"赵崡","text":"汉室谁高第，寥寥数赵张。\n茧丝天下计，兔窟百年藏。\n春草生金谷，秋风冷未央。\n朅来忧国意，清泪不成行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4499,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"庄河村主人","author":"赵崡","text":"落日牛羊岭上村，谁开三径召王孙。\n山容似黛斜侵槛，水字如巴曲到门。\n野客行藏无揖让，田家宾主有盘樽。\n欲将谷口烟霞色，并向桃源洞里论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4500,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西山滴水岩二首 其一","author":"崔子忠","text":"入不知高下，山春水似秋。\n星河平地看，鸡犬半天游。\n洞腹藏元气，山根养洑流。\n白云朝出宿，知是绕神州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4501,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西山滴水岩二首 其二","author":"崔子忠","text":"石似当空立，岩疑急就成。\n雨花山庙湿，雷树羽宫晴。\n绝壁洪荒在，阴畴晦朔并。\n古潭龙夜语，徐戛应泉声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4502,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"石鼓诗","author":"郭天中","text":"鼓非石霣者星，文非鼓勒者铭。\n焚外书，删外经。\n经雅颂，书典刑。\n隶秦汉，径睒庭。\n篆龙鸟，蓝溲青。\n臼谢杵，舂頠停。\n嵌辞金，波画零。\n我拜手，神之听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4503,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其一","author":"王叔承","text":"二八佳人三五宵，仙风随幸广陵桥。\n分明记得《霓裳曲》，春梦微茫月影遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4504,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其二","author":"王叔承","text":"紫翠阴阴斗草堤，柳风淡荡舞衣吹。\n众中独有宜男草，嬴得金钗百子池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4505,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其三","author":"王叔承","text":"柳外秋千拂绮楼，舞阑初解翠云裘。\n玉鞭夜踏桃花马，万朵银灯照打球。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4506,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其四","author":"王叔承","text":"别苑东风报牡丹，传宣晓出望春门。\n惜芳却覆黄罗帕，护取花王待至尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4507,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其五","author":"王叔承","text":"碧尘缕缕暗香沟，湘簟空床萤火流。\n梧叶一窗眠未得，月明秋水听《凉州》。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4508,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其六","author":"王叔承","text":"入宫新拜大长秋，歌舞平阳夜不休。\n一曲春声低按拍，御前飞坠玉搔头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4509,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其七","author":"王叔承","text":"敕下天题法曲新，书生赋奏太平春。\n雕盘红袅宫花朵，赐与传胪第一人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4510,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其八","author":"王叔承","text":"何处文星动帝庐，却怜狗监荐相如。\n汉王亲御蓬莱殿，夜半烧灯读《子虚》。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4511,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其九","author":"王叔承","text":"十五传歌隶太常，寿阳公主教新妆。\n朝来试弄琅玕笛，零落梅花玳瑁床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4512,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其十","author":"王叔承","text":"曙色参差杨柳东，额头花片点新红。\n思君梦落巫山雨，怪底黄门问守宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4513,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其十一","author":"王叔承","text":"绿云细草湿红巾，御酒倾霞欲醉春。\n试奏教坊新羯鼓，内园初赛百花神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4514,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其十二","author":"王叔承","text":"桃花飞雨腻青堤，万马骄嘶锦障泥。\n韨罢温泉仙跸晚，彩云狼籍霸陵西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4515,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其十三","author":"王叔承","text":"枌榆春社斗鸡回，鄠杜朱旂夹道开。\n寒食宫愁消未尽，夜棋弹过水晶台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4516,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其十四","author":"王叔承","text":"太平天子猎长杨，羽骑千群晓臂苍。\n金簇雕弓亲射虎，击鲜先赐月氐王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4517,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其十五","author":"王叔承","text":"碧眼胡儿细剪毛，大宛宝马贡天槽。\n殿前却奏长城曲，苜蓿秋风紫燕骄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4518,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其十六","author":"王叔承","text":"樱桃才熟报君王，万点娇含紫玉浆。\n未及寝园春荐去，沉香亭北已先尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4519,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其十七","author":"王叔承","text":"桑子青青雨压枝，宫蚕老尽簇银丝。\n侍儿擘破双蛾茧，肠断西窗有所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4520,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其十八","author":"王叔承","text":"紫燕双飞花雨香，青泥春老堕雕梁。\n不知天外乌衣国，可似宫中别恨长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4521,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其十九","author":"王叔承","text":"氤氲水殿荡朝阳，夜涨桃花锦水香。\n珍鸟千行看不禁，自将金弹打鸳鸯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4522,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其二十","author":"王叔承","text":"枝头点点送纤霞，翠阁临春锁丽华。\n十月冰霜满京国，宫人争唱《后庭花》。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4523,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其二十一","author":"王叔承","text":"玉漏声寒夜色虚，按残宫籍幸来疏。\n当时御辇迎欢日，曾向芭蕉叶上书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4524,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其二十二","author":"王叔承","text":"圣人嘉礼诏亲农，万国元年开景龙。\n内侍半天传玉册，百花深处见昭容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4525,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其二十三","author":"王叔承","text":"掖庭清晓降神仙，争贺青阳太子笺。\n报出阁门分内赐，满朝皆得洗儿钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4526,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其二十四","author":"王叔承","text":"江南江北锦帆来，妾自商歌妾自哀。\n百曲迷楼春不住，杨花飘荡李花开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4527,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其二十五","author":"王叔承","text":"复道冥冥绣户扃，灯花落尽曙烟青。\n春寒肯怨鸾衾薄，暗拂朱帘望小星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4528,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其二十六","author":"王叔承","text":"六院诸姨献宝新，天家生日幸宜春。\n凤衫噀熨蔷薇露，晓进龙床喜称身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4529,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其二十七","author":"王叔承","text":"上巳春回太液池，天青水碧晚妆迟。\n一痕初月垂芳树，学得纤纤新黛眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4530,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其二十八","author":"王叔承","text":"盈盈红玉晚妆新，静倚菱花自写真。\n一片青霞生袜底，满宫传是洛妃神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4531,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其二十九","author":"王叔承","text":"山色移青入画眉，绮疏春旭寄幽思。\n蜀藤新进松花纸，临出曹娥江上碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4532,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其三十","author":"王叔承","text":"西清环佩水泠泠，片月初生云母屏。\n却遇玉真公主到，碧萤飞照蕊珠经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4533,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其三十一","author":"王叔承","text":"宫草平阶拥泪痕，檐禽浙浙送黄昏。\n君王岂是并州估，明月梨花独掩门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4534,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其三十二","author":"王叔承","text":"汉王击筑慕边勋，妾抱箜篌歌塞云。\n莫遣玉关消息断，侬家况有卫将军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4535,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其三十三","author":"王叔承","text":"夜深刀尺烛花殷，九月边衣诏内颁。\n不合题诗落寒絮，宫愁传遍玉门关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4536,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其三十四","author":"王叔承","text":"风流阵罢更迷藏，偷入离宫伏御床。\n却向紫薇深处觅，眼花搴着圣人裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4537,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其三十五","author":"王叔承","text":"天上仙源水暗流，漫题佳句落金沟。\n凭谁拾取新红叶，万种闺情一片秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4538,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其三十六","author":"王叔承","text":"梨园歌断万花天，风雨寒铃忆旧筵。\n怪得人间传秘曲，江南春老李龟年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4539,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其三十七","author":"王叔承","text":"宝马图开雕锦鞍，殿前挥洒汗飞丹。\n婕妤手捧将军赐，玉甲光摇玛瑙盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4540,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其三十八","author":"王叔承","text":"深宫窈窕断人烟，春去春来只自怜。\n共说髫时花底乐，游郎无数看秋千。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4541,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其三十九","author":"王叔承","text":"长生秋殿夜焚香，暗语盟心礼法王。\n手录藏经还自窾，阿环亲为李三郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4542,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其四十","author":"王叔承","text":"傀儡那能识幸姬，含情流盼向天帷。\n也知歌舞偏怜色，何事君王怒偃师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4543,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其四十一","author":"王叔承","text":"卿云缥缈覆长安，仙仗凌霄颂百官。\n芝草忽生涵德殿，昭仪捧出侍臣看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4544,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其四十二","author":"王叔承","text":"一见君王认未真，依稀聊记梦中身。\n闲窗试作丹青像，阿监惊看拜圣人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4545,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其四十三","author":"王叔承","text":"朝元阁上翠烟横，太乙坛前白露明。\n曾侍上皇供法曲，蹋歌犹带步虚声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4546,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其四十四","author":"王叔承","text":"学士风流女秘书，五姬更进尚宫除。\n君王莫得虚临幸，妾在彤帏注起居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4547,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其四十五","author":"王叔承","text":"络纬啼秋梧月深，碧纱描粉绣观音。\n女僧闻作盂兰会，乞假中元施宝簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4548,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其四十六","author":"王叔承","text":"一拜昭容便直庐，丝纶窈窕自唐虞。\n十年独视通天草，彩笔含春落玺书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4549,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]