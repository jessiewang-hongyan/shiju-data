[{"title":"大贺词八首 其六","author":"陆深","text":"鸿胪声肃汉官仪，环佩珊珊满玉墀。\n黄道重开新气象，齐歌天保答恩私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2046,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大贺词八首 其七","author":"陆深","text":"星星宝炬列高楼，恩诏泥封在上头。\n忽听半空宣读罢，嵩呼声里玉阑浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2047,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大贺词八首 其八","author":"陆深","text":"字字亲将惠泽颁，十分湔洗到愚顽。\n先皇多少心中事，丹凤衔来一纸间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2048,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙寅元旦待漏","author":"陆深","text":"参横斗转晓相将，迢递宫门漏水长。\n不见满朝环佩响，坐弹冰泪忆先皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2049,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"接驾","author":"陆深","text":"晓日曈曈剑戟森，五云宫殿锁深沈。\n侍臣候立频回首，传道銮舆幸上林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2050,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"素履斋","author":"陆深","text":"新裁纸帐木绵裘，曲几围屏事事幽。\n明月射窗残雪霁，夜深人在水晶楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2051,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"隋宫词二首 其一","author":"陆深","text":"螺黛朝朝吏散来，妆残犹展镜奁开。\n门前报道宫车过，不似轻尘拂面回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2052,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"隋宫词二首 其二","author":"陆深","text":"金锁黄昏知几重，梦回疏影月帘栊。\n笙歌别殿承恩宠，半露春衫蜥蜴红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2053,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"端午词二首 其一","author":"陆深","text":"碧青艾叶倚门斜，寂寞深宫有底邪。\n几度思量背同伴，暗分咸水引羊车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2054,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"端午词二首 其二","author":"陆深","text":"石青蜥蜴泥金虎，五色綵丝长命绳。\n白发宫监催拜赐，含娇时许未能胜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2055,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江东竹枝词四首 其一","author":"陆深","text":"黄浦湾湾东转头，吴淞江下碧如油。\n不用并州剪刀快，水晶帘下上西楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2056,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江东竹枝词四首 其二","author":"陆深","text":"二月春风满地铺，茅针芦笋一齐粗。\n海门东来春潮上，春水连潮漫白涂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2057,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江东竹枝词四首 其三","author":"陆深","text":"滨口航船一字帮，棹歌和起自成腔。\n潮来上南潮落北，南到湖南北到江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2058,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江东竹枝词四首 其四","author":"陆深","text":"明月垂杨独树桥，桥西熟酒好良宵。\n红香细剥莺哥嘴，嫩白鲜羹玉面条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2059,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"步虚词四首 其一","author":"陆深","text":"晴日暖风吹紫霞，西岩开遍碧桃花。\n仙家只住岩西畔，水水山山遮又遮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2060,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"步虚词四首 其二","author":"陆深","text":"风露满山深翠微，暗尘不上芰荷衣。\n夜来拄杖成龙去，斜倚枯藤送落晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2061,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"步虚词四首 其三","author":"陆深","text":"芙蓉花下石阑干，茅屋空山生早寒。\n养得一双朱顶鹤，有时骑向碧云端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2062,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"步虚词四首 其四","author":"陆深","text":"溪后溪前路百盘，白云常护礼星坛。\n麻姑使者传书到，一派箫声双紫鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2063,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鳌峰草堂歌十首 其一","author":"陆深","text":"闽山南去是鳌峰，鳌峰草堂多卧龙。\n春随花路八千里，天锁烟霞十万重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2064,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鳌峰草堂歌十首 其二","author":"陆深","text":"谷口子真归计成，少陵老人歌北征。\n五月南风吹海雨，碧山无数荔枝明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2065,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鳌峰草堂歌十首 其三","author":"陆深","text":"御堤杨柳春日迟，折尽长条更短枝。\n天上初抛祠部禄，山中谁送草堂赀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2066,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鳌峰草堂歌十首 其四","author":"陆深","text":"平生最爱方思道，方外更交孙太初。\n作吏隐居非我意，南巡新上万言书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2067,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鳌峰草堂歌十首 其五","author":"陆深","text":"早年慕道世情疏，乞得青山背郭居。\n不为登楼赋王粲，文园真有病相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2068,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鳌峰草堂歌十首 其六","author":"陆深","text":"北来京国住三年，南去青山得似前。\n试问孤猿与孤鹤，为谁消瘦为谁怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2069,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鳌峰草堂歌十首 其七","author":"陆深","text":"新裁道服绿罗寒，别有乌霞制作冠。\n后夜相思长琐月，酒徒诗伴满长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2070,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鳌峰草堂歌十首 其八","author":"陆深","text":"山公启事孰当前，宣室求才谁少年。\n一路桃花春水涨，皂旗唯送得归船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2071,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鳌峰草堂歌十首 其九","author":"陆深","text":"群策先皇一网收，虎头高选重龙头。\n相知赖有倪宽在，与汝一时成去留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2072,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鳌峰草堂歌十首 其十","author":"陆深","text":"莫倚高歌莫著书，秋风病骨夜窗虚。\n海门近傍鳌峰起，锦字封题侯鲤鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2073,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元旦试笔二首和柴德美 其一","author":"陆深","text":"天门次第列中官，御幄含风春尚寒。\n拜罢两班文共武，相逢屈指计迎銮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2074,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元旦试笔二首和柴德美 其二","author":"陆深","text":"帝德唯天仰日新，圣经书法重王春。\n青阳应律方东令，翠辇临边正北巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2075,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书扇","author":"陆深","text":"露下瑶空雁有期，高楼凝望已多时。\n隔江一片芙蓉树，欲采红芳寄所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2076,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄江都旧友","author":"陆深","text":"平山堂外蜀冈长，十里楼台隐夕阳。\n更爱缘溪茅屋好，与君相约住维扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2077,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"节妇吟","author":"陆深","text":"深闺独抱旧分铜，泪逐黄昏怨晓风。\n惟有五更孤枕梦，尚将膏沭到飞蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2078,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺词四首 其一","author":"陆深","text":"背人憔悴转回廊，试折花枝比淡妆。\n不忍问春深几许，芭蕉新绿过东墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2079,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺词四首 其二","author":"陆深","text":"水阁看花怕到迟，白罗团扇手忘持。\n多情更向侍儿说，庭院深深称赌棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2080,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺词四首 其三","author":"陆深","text":"晚妆重整翠花钿，满指兰膏试碧泉。\n欲向姮娥诉恩怨，人间天上共孤眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2081,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺词四首 其四","author":"陆深","text":"薰笼百和晓妆残，起探阴晴绕石阑。\n折得梅花无寄处，自怜纤指怨深寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2082,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又闺词四首 其一","author":"陆深","text":"庭锁繁花昼景长，绣针刻晷记春光。\n行天嫌杀金乌懒，到得黄昏怯上床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又闺词四首 其二","author":"陆深","text":"池馆残妆坐晚凉，自将金弹打鸳鸯。\n打得鸳鸯各飞去，白莲花度并头香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又闺词四首 其三","author":"陆深","text":"帘下风来月影过，萧萧梧叶下庭柯。\n起看凤历论时令，夜刻如今未当多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又闺词四首 其四","author":"陆深","text":"娇娥自画晓鸦蟠，独对梅花拄颊看。\n直到夜深眠不得，衾笼芸火斗严寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"县斋春宴","author":"陆深","text":"蓬莱方丈像三山，舞象驯狮效百蛮。\n人自东郊向南郭，春从天上到人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清河东渡","author":"陆深","text":"乳鸭苗鱼促刺稠，紫茸翠带弄轻柔。\n渡船人语回风细，疑是江南小埠头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王兵宪于泽以二力士送予遣还二首 其一","author":"陆深","text":"雕弓羽箭烂银鞶，白马朱缨错绣鞍。\n踏雪护行三百里，一行骑射万人看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王兵宪于泽以二力士送予遣还二首 其二","author":"陆深","text":"红袍白面好儿郎，燕赵豪华独擅场。\n赠汝长缨三百尺，楼兰西去缚名王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临城道中","author":"陆深","text":"寒雅成阵掠疏林，晴雪峰头弄夕阴。\n忆向小窗茶灶下，李成一幅论千金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"逢方仲敏侍御二首 其一","author":"陆深","text":"花骢高载玺书行，忆在华亭政有声。\n尘土相逢浑不识，聊从陌上各通名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"逢方仲敏侍御二首 其二","author":"陆深","text":"依依把袂逐多情，为问何时下玉京。\n报道圣躬添万寿，南郊大礼庆初成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沛县二首 其一","author":"陆深","text":"人言捧土塞黄河，丞相开河怨亦多。\n晓日卧龙冈上望，白沙如绣涌层波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沛县二首 其二","author":"陆深","text":"山东列郡尽王臣，汉室公卿俱负薪。\n侍臣欲献河清颂，天运中兴属圣人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南旺湖","author":"陆深","text":"南旺湖中水接天，南旺湖上多渔船。\n榔声刮地风声急，赤鲤乌鱼不论钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2096,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邃庵挽歌二首 其一","author":"陆深","text":"出当紫塞入黄扉，重去重来复暂归。\n今日竟从何处去，长江空绕万山围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2097,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邃庵挽歌二首 其二","author":"陆深","text":"金书铁劵是何时，空复人传翰墨师。\n唯有铭旌题道号，更无一字上丰碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2098,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸词三十二首 保定候驾四首 其一","author":"陆深","text":"翼善冲天白玉绦，团龙鞶绣赭黄袍。\n山陵南去三千里，紫气红尘一骑高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2099,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸词三十二首 其二","author":"陆深","text":"乘鸾跨凤贯鱼随，日射行宫近午时。\n密密柱头黄幄竖，重重轩盖绣帘垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2100,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸词三十二首 其三","author":"陆深","text":"师保公侯列署分，敕书先下两将军。\n清尘雨歇祥风动，抱日常瞻五色云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2101,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸词三十二首 其四","author":"陆深","text":"画衣楚楚间青黄，佥点民间俊秀郎。\n未到御前先教习，递分班次列成行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2102,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸词三十二首 其五 吕堰道中","author":"陆深","text":"四际天垂夜气凝，平坡十里万枝灯。\n风回远戍三更漏，问讯行宫膳未曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2103,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸词三十二首 其六 博望道中","author":"陆深","text":"天际红云捧节旄，襄阳大堤三丈高。\n宿雨平添汉江水，军门传向裕州朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2104,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸词三十二首 其七 奉旨三品乘轿","author":"陆深","text":"车行历碌骑行徐，早晚谁来问起居。\n圣旨分明优老大，特教三品用肩舆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2105,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸词三十二首 其八 南阳","author":"陆深","text":"金字黄旗队队过，云霓偏傍六龙多。\n星联火炬南阳道，不到黄昏渡白河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2106,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸词三十二首 郑州道中二首 其九","author":"陆深","text":"宿雨丰泥燕子飞，客心迢递送春归。\n江河嵩少俱从幸，麦浪翻空柿叶肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2107,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc