[{"title":"别诗 其三","author":"梁柱臣","text":"怜君璚树姿，赠君菤葹草。\n心断竟何言，梦绕燕关道。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10578,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别诗 其四","author":"梁柱臣","text":"相见能几时，相思复万里。\n愿作南浦云，随君度江水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10579,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄怀苏霍云谷逸士","author":"梁柱臣","text":"吾乡隐君子，质素古人风。\n性岂琴书癖，身将猿鹤同。\n捲帘山阁暮，策杖海云空。\n一别麻源谷，相思桂树丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10580,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"京邸访欧桢伯","author":"梁柱臣","text":"春来闻尔客长安，尺素空传欲见难。\n此日风尘欣把袂，明时词赋独登坛。\n吟边景物年华暮，战后河山暝色寒。\n官拙自伤寥落久，故人犹为罄交欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10581,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初入西樵","author":"梁柱臣","text":"夙昔慕远壑，招携展临眺。\n挂席得名山，苍翠落层峤。\n谽谺自吞呷，岩穴深窈窱。\n天清瀑布闻，风集玄猿叫。\n桂松递映郁，日月隐光曜。\n盼衍既绵邈，攀崇复孤峭。\n皛皛浮云驰，晶晶寒潭照。\n舍舟乍游目，早觉心魂妙。\n况当振策游，探奇入萝茑。\n缅怀麻源踪，慨想苏门啸。\n谁云世代殊，引领冀同调。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10582,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿云谷听天泉瀑布","author":"梁柱臣","text":"枕石山房夜，翛然思不穷。\n泉声千树杪，云卧九霄中。\n暗谷长惊雨，疏林不待风。\n爽侵江月冷，响彻海烟空。\n练影飘兰幄，寒霏逼桂丛。\n幽怀真梦蝶，尘世已冥鸿。\n地即匡庐胜，才怜谢客雄。\n招携良不数，岩壑此宵同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10583,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南园五先生","author":"梁柱臣","text":"粤有五先生，风流迈千古。\n孙黄迭宕才，给事亦豪举。\n长史倦游客，潜心伊洛语。\n徵士甘肥遁，清风起岩户。\n五君岂一时，分谊深乡土。\n才情本相埒，意气堪为伍。\n穷不困泥途，达岂耽簪组。\n遭逢国运初，声名播寰宇。\n并登作者场，瑰琦擅词赋。\n结社开南园，深心托毫素。\n白雪落人间，希声在韶濩。\n一洗宋元陋，复古力何钜。\n世远迹易荒，社在谁堪主。\n前修挺芳躅，后代徒延伫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10584,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"光孝寺重修宝公殿成","author":"梁柱臣","text":"宝殿秋高绀殿成，忽传三秀向秋荣。\n璚枝乍捧慈云出，玉朵遥分慧日明。\n色借菩提光烨烨，瑞开仙掌露盈盈。\n怪来龙象经行处，紫气氤氲拂院清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10585,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日浮邱","author":"梁柱臣","text":"仙都挺灵岛，宛自罗浮移。\n天回紫烟阁，洞启朱明扉。\n山以浮邱名，井记葛洪遗。\n仙迹久芜没，胜事逢今兹。\n结伴访丹壑，探幽凌翠微。\n春光属骀荡，草树郁芳菲。\n游览历瑶圃，命酌临华池。\n鱼鸟性自得，泉石色争飞。\n耳目非人境，云霞生客衣。\n缅邈神霄上，如聆笙鹤归。\n共欣濠濮赏，载咏游仙辞。\n久谢攀笼累，将从汗漫期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10586,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱社怀赵太史","author":"梁柱臣","text":"葛洪丹井久芜没，浮邱羽人不可攀。\n万里冥搜待仙吏，千秋灵迹出人间。\n地开玄圃非凡界，客是蓬莱最上班。\n独立池台挹遗韵，天风吹鬓放歌还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10587,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱八景 其一 紫烟楼","author":"梁柱臣","text":"缥缈飞楼凌紫烟，水光山色自年年。\n月明笙鹤群仙过，云锁朱明一洞天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10588,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱八景 其二 晚沐堂","author":"梁柱臣","text":"仙客蓬莱侍直还，晚怜休沐得仙山。\n聊堪吏隐人间世，欲赋郊居未拟閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10589,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱八景 其三 珊瑚井","author":"梁柱臣","text":"珊瑚洲上葛仙井，秋入银床寒渫清。\n玉液炼成丹灶冷，竹梧幂历彩烟生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10590,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱八景 其四 大雅堂","author":"梁柱臣","text":"词臣高唱柏梁台，为采风谣海上来。\n载酒名山开雅社，赋成谁不羡仙才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10591,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱八景 其五 留舄亭","author":"梁柱臣","text":"有客何来自上方，曾留双舄此徜徉。\n仙踪去住元无定，时见飞凫入帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10592,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱八景 其六 朱明馆","author":"梁柱臣","text":"罗浮门户辟朱明，紫气灵风散化城。\n此去升真知有路，餐霞谁许学无生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10593,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱八景 其七 挹袖轩","author":"梁柱臣","text":"羽衣仙袂去飘飘，池上幽轩对泬寥。\n何日功成飞舄上，浮邱天路笑相邀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10594,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱八景 其八 听笙亭","author":"梁柱臣","text":"王子吹笙学凤鸣，缑山仙侣坐相迎。\n自从一入嵩高去，林壑长留灵籁声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10595,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"轩辕试剑石","author":"梁柱臣","text":"羽客今何在，千秋剑气存。\n古苔馀电影，断石卧云根。\n变化双龙合，冲腾万马奔。\n凭虚望牛斗，仙乐下天门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10596,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朝斗坛","author":"梁柱臣","text":"碧洞瑶坛凌紫清，真文缥缈斗边明。\n何人夜半骖黄鹤，吹落云中玉佩声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10597,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"文笔峰","author":"梁柱臣","text":"万丈文峰插海隅，苍茫五色绚蓬壶。\n怪来仙客挥神笔，幻作南天砥柱孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10598,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金鸡岭","author":"梁柱臣","text":"夜半灵乌海底生，扶桑葱郁彩云升。\n金鸡忽报龙楼晓，遥听朝阳孤凤鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10599,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马鞍冈","author":"梁柱臣","text":"璚石崔嵬耸翠峦，依然金马玉为鞍。\n名驹一入金台去，万古风云胜地蟠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10600,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居 其一","author":"云上行","text":"寂寞帘垂地，隔林鸡犬鸣。\n灌园期雨足，清暑仗风生。\n钓艇横珠浦，纤尘远帝城。\n空悲青镜里，白发戾人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10601,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居 其二","author":"云上行","text":"波静鱼龙卧，秋高风露寒。\n苍生有谢傅，白发任潘安。\n娱老书千卷，高眠日两竿。\n鳞鸿相问讯，多勉以加餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10602,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居 其三","author":"云上行","text":"幸值时方泰，无论心苦长。\n祇调参术饵，更挹蕙兰芳。\n话旧寻莲社，移家近梓乡。\n观澜看拾翠，赢得听沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10603,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"崖门吊古","author":"云上行","text":"宋室腥膻沸战场，翠华漂泊幸炎荒。\n孤忠死国悲萍梗，万乘随潮溺苇航。\n俎豆祇今祠太后，渔樵犹自忆天王。\n可怜收泪朝衣湿，落日悲风易惨伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10604,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与何粤桥计部戴东冈山人集肖玄胡明府别墅","author":"云上行","text":"草玄新柳倚云栽，寂寂山斋锁绿苔。\n饶有墙头浊酒过，不嫌花外小车来。\n瑶琴遣兴时三弄，兰艇穿城日几回。\n幸尔隔邻无隙地，好怀都在此中开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10605,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寻芝兰湖故址","author":"潘元翰","text":"北郭新晴访翠微，芝兰遗址尚依稀。\n越冈井废官蛙斗，花圃时移蔓草菲。\n霸业销沉何处问，国香摇落竟谁依。\n南薰似爱狂吟客，相送呼鸾道上归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10606,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱明馆","author":"潘元翰","text":"浮邱挹袖敞高台，秋杪登临共举杯。\n清籁似聆笙韵杳，白云如伴鹤飞回。\n仙翁已去留丹井，词客迟归步紫苔。\n秋色娱人多逸兴，尊前诗景不须催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10607,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆潮阳东山","author":"陈宗鲁","text":"二十年前访石泉，登临曾得侍高贤。\n水帘不捲聊同坐，云壑无关亦可眠。\n碧海周回环大地，文峰联络峙中天。\n祇今风景宁殊旧，咫尺怀人思惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10608,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄怀延津门人李冢宰刘侍御","author":"苏黎庶","text":"归来霜鬓几经秋，念尔鸿裁侍玉旒。\n抗疏明光推起草，澄清畿甸见宣猷。\n斗间遥睹双龙合，海外真成独鹤游。\n因忆谈经寒署后，相思人在凤池头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10609,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度大庾岭","author":"唐守明","text":"岭峣千里外，相对且含杯。\n横浦初含冻，庾关欲放梅。\n粤云倾望杳，海燕际天来。\n共向贤祠拜，相期入凤台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10610,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苍巡峒","author":"周坦","text":"四海相传福地幽，天然胜概镇炎州。\n百千万状山争秀，三十六回江转流。\n岩下鸡鸣玄圃月，云边雁度翠微秋。\n人间自有栖真地，何必浮槎海上游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10611,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读厓志有感 其一","author":"高士蜚","text":"旧迹荒凉何处寻，一从开卷见升沈。\n英雄万死扶诸夏，天地三人共一心。\n奇石波涛销宿恨，两厓宫殿锁残阴。\n哀情吊古寒江远，愁向苍茫寄短吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10612,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读厓志有感 其二","author":"高士蜚","text":"岭徼间关勤国日，北云南树望先宫。\n元戎督塞提孤旅，帝子扶天御六龙。\n夷夏提防嗟此决，厓门风雨恨成空。\n只今正气横溟漠，千古回狂障海东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10613,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟西北有织妇","author":"陈一松","text":"西北有织妇，寂寂深闺里。\n朝朝弄机丝，纷纷不成理。\n霜月夜孤明，悲风四坐起。\n谁云无所思，良人在万里。\n言欲穿寒衣，经纬乱如此。\n仰盼双飞禽，妾身差可拟。\n借问从王师，烽火何年已。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10614,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李氏山亭宴别五侍御馆丈分韵得柳字","author":"陈一松","text":"饯别出郊亭，系马亭前柳。\n袅袅向南枝，折赠同心友。\n白日照飞霜，星轺下北斗。\n当路无豺狼，澄清志不负。\n昔登白玉堂，忆君同结绶。\n晨夕恣欢谈，浪迹今何有。\n念之动中怀，况兹复分手。\n离弦促征鞍，殷勤更杯酒。\n共言别相思，宁辞坐云久。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10615,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"永丰道中次雨泉使君韵","author":"陈一松","text":"于役戒晨征，春入湘西路。\n方停永丰节，忽返黄茆驭。\n道有荷薪者，相惊问何故。\n岂急苍生病，岂勤紫芝晤。\n使君自有真，劳劳非所悟。\n语终忽我辞，飘飘若鸿翥。\n因之念故人，伐木鸟声数。\n感慨思其言，似知出与处。\n回首欲叩之，夜雨鸣空树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10616,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴之溪令宜章","author":"陈一松","text":"飞旆楚南下，别筵河上秋。\n独怜仙令去，君是故人流。\n门种五株柳，阴垂百里庥。\n眷予故相忆，何以慰离忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10617,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日衡阳道中次陈雨泉使君韵","author":"陈一松","text":"星轺临岳度，云磴倚穹跻。\n双旆凌空出，千山人望低。\n折梅惊岁换，烧竹讶春迟。\n瑞色摇书剑，琼华照眼齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10618,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岳阳晓发大雨次韵寄雨泉使君时二月十五也","author":"陈一松","text":"节序三春半，风尘一客来。\n雨藏巴国树，云暗岳城台。\n雪浪翻犹没，林花湿更开。\n商霖如可作，还拟遍穷垓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10619,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同日舟中怀雨泉使君次韵","author":"陈一松","text":"揽策逢朝雨，登舻欲夕曛。\n远天浮楚水，白日散江云。\n渔火岸将暝，莺花春正分。\n有怀成独坐，愁绝棹歌闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10620,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中有作","author":"陈一松","text":"楚国晚山霁，巴江春水生。\n雨馀烟浪阔，天远暮云平。\n若济惭非楫，临风想濯缨。\n未能投组去，泉石负幽盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10621,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日谒少鹄殿下燕饮复惠花醴侑以诗篇依韵奉谢","author":"陈一松","text":"贤王有佳趣，词客独相过。\n园胜春披画，林芳鸟竞歌。\n馀尊沾后渥，名朵赏来多。\n不尽清狂兴，其如候骑何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10622,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午日谒屈贾二先生祠有感而赋岁嘉靖甲寅也 其一","author":"陈一松","text":"去国已多恨，况乃宗将颓。\n大夫成自放，渔父谩相猜。\n白雨沉沙没，清风激浪回。\n独怜馀诛草，空作楚骚裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10623,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午日谒屈贾二先生祠有感而赋岁嘉靖甲寅也 其二","author":"陈一松","text":"三闾不可作，千古有馀悲。\n精灵向何处，宗国竟去之。\n颓风仍逝水，落日自荒祠。\n不尽临湘意，含凄赋采蓠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10624,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午日谒屈贾二先生祠有感而赋岁嘉靖甲寅也 其一","author":"陈一松","text":"汉文称右士，太傅却遐迁。\n岂谓才蒙忌，终于志转怜。\n蜚鸿魂自怆，神鬼席空前。\n惟有治安策，犹能千载传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10625,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午日谒屈贾二先生祠有感而赋岁嘉靖甲寅也 其二","author":"陈一松","text":"披策叩宸扉，瑰才近代稀。\n胡为湘水赋，空使壮心违。\n论惜过秦是，人怜事汉非。\n观风访遗庙，怀古不胜欷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10626,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"腊雪健斋方伯诗邀傅方伯邸中共赏倚韵奉答","author":"陈一松","text":"瑶华纷可折，持向古人看。\n布地怜三白，赏心同一丹。\n预知农望惬，能使客怀宽。\n莫对伤摇荡，庭中有岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10627,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送曾确庵大参之浙中 其一","author":"陈一松","text":"祖席停征盖，瑶琴伴使车。\n陇梅差可折，津柳若为舒。\n白雪歌来风，青春客佩鱼。\n不堪频送别，况乃岁将除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10628,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送曾确庵大参之浙中 其二","author":"陈一松","text":"幸托蒹葭好，因攀玉树姿。\n忽从分手处，转觉渺心期。\n越国人占岁，楚乡客问歧。\n独怜汉川上，一鹢下江湄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10629,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送蔡青山舅任丰泰仓","author":"陈一松","text":"执鞭从委吏，徇禄岂辞卑。\n行道固如此，代耕良在兹。\n岭郡蛮烟合，都亭别思滋。\n驰驱看轫发，珍重慰吾私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10630,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"通州旅怀 其一","author":"陈一松","text":"展告辞枫阙，仓茫问粤津。\n几年为客梦，万里获归人。\n冰合堪濡滞，时平足隐沦。\n无能生羽翰，利涉待江春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10631,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"通州旅怀 其二","author":"陈一松","text":"几载客京华，千山归路赊。\n误将忠作孝，敢以宦为家。\n坏土变陵谷，关河阻汉槎。\n不须叹留滞，回首是天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10632,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元日读王摩诘逆旅佳节之句感而续之 其一","author":"陈一松","text":"逆旅逢佳节，征帆未可前。\n雪华添旧鬓，岁历检新编。\n冻浦澌仍结，春云霭欲连。\n主恩同恋马，清梦尚依然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10633,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元日读王摩诘逆旅佳节之句感而续之 其二","author":"陈一松","text":"逆旅逢佳节，征帆未可前。\n帝郊回淑气，客鬓入新年。\n野色千林幸，乡心万里悬。\n东风如可借，为上泛湖船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10634,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日自衡还潭道中次雨泉使君韵 其一","author":"陈一松","text":"天风乍起吹山雪，人日那堪匝地阴。\n自托身为苍水使，何辞车度翠微深。\n乾坤客路三湘鬓，日月鸿霄万里心。\n东望白云生岭外，乡愁春思总难禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10635,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日自衡还潭道中次雨泉使君韵 其二","author":"陈一松","text":"七日春来半风雨，况逢飞雪转多阴。\n瑶华堪折美人远，仙盖欲临湘水深。\n十载风尘愁作客，百年交谊幸同心。\n索梅本谓能供笑，对尔寒花更不禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10636,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次馆壁韵","author":"陈一松","text":"湘江如练带平原，长沙自古称雄藩。\n封疆万里秦郡国，阡陌一望汉王孙。\n衡岳南来负形胜，洞庭北走开户门。\n感慨有怀洛阳少，治安策在何销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10637,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和宾岩太守夏日试士","author":"陈一松","text":"郡国祥云拂曙开，三千百战亦雄哉。\n风尘正想飞霜剑，海国应怜献赋才。\n长日莺花随彩笔，中天象纬落蓬莱。\n人文自昔看今胜，尽道曾经藻鉴来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10638,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴军门镇海楼觞乡大大之什","author":"陈一松","text":"十万旌旗海上开，南征谁似武侯才。\n一时氛祲敛空尽，满野欢声动地来。\n天极扶桑看今出，雨馀穷谷自春回。\n临觞雅有升平咏，丽藻惊昭云汉回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10639,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和武冈殿下新楼落成之什 其一","author":"陈一松","text":"齐云殿阁俨仙居，别有层楼俯万闾。\n桐叶自承茎露渥，葵花元向日光舒。\n牙签玉检清相映，宫月檐星步独虚。\n海内簪缨尽倾盖，乾坤何必访樵渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10640,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和武冈殿下新楼落成之什 其二","author":"陈一松","text":"翼轸天临帝子居，宫楼帘捲楚人闾。\n自怜刘向书能著，共识东平乐更舒。\n玉树醉攀仙盖集，朱弦独抱夜堂虚。\n岂谓河山生远思，画图时展问耕渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10641,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日苦热和林梅墩使君纳凉涌月亭 其一","author":"陈一松","text":"休沐炎蒸思不禁，江楼向夕足幽寻。\n露华向靳金茎下，熇气偏从白屋侵。\n思凿井冰沾道暍，谩挥毫雪傍栏吟。\n月明川上观流水，爱尔澄然物外心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10642,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]