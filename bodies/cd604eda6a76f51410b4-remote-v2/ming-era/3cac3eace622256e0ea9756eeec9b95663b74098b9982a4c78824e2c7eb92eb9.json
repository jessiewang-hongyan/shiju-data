[{"title":"岁暮山居杂感 其十","author":"谢元汴","text":"熊魂日象煜，怪雾秘天倪。\n白粲冈头草，鬼薪岭上桋。\n龙门终马走，鸿渐逐鸡栖。\n百里乡关迩，能无泣路迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38895,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其十一","author":"谢元汴","text":"客作混佣保，疏茅俯泌洋。\n蹲鸱刚半耜，杞犬未成行。\n厌虎方多误，树兰美不芳。\n想无庞马辈，胜似萃鱼梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38896,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其十二","author":"谢元汴","text":"自石与山水，无之不字霜。\n柳州州曰柳，蒋径径从蒋。\n留使名贤记，烦将缺事详。\n萧萧稀菊本，风物拟柴桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38897,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其十三","author":"谢元汴","text":"水根泽腹见，石腭露回湾。\n鸡黍为供少，鱼蔬适市艰。\n瞻星礼太乙，筮易兆天山。\n不与圭峰竞，选形物外间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38898,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其十四","author":"谢元汴","text":"闭门深拔剌，落落少交知。\n勿涉恶溪水，长吟不肖诗。\n重华才子谱，元祐党人碑。\n所以萧升佐，能登季札祠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38899,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其十五","author":"谢元汴","text":"种自盘瓠旧，伥蒐燎狒猩。\n荒祠画壁怪，野祭巫音伧。\n贵竹鬼方国，海童不夜城。\n譬如经滟滪，达者得其平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38900,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其十六","author":"谢元汴","text":"逐麛良已老，臣壮不如人。\n大抵鼋鼍窟，犹然虎豹邻。\n孤村明远火，细雨澹萧晨。\n未审古槃涧，今当第几伦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38901,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其十七","author":"谢元汴","text":"条枚正直挺，伐木闻丁丁。\n经济分姜韭，平章课仆伻。\n樵从青鸟度，人在白烟行。\n落日柴门掩，波澜众虑生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38902,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其十八","author":"谢元汴","text":"从兹谢坲坱，上屋骑危樯。\n绣?妇人服，蜉蝣公子裳。\n綦巾非不美，岸帻未为狂。\n到有残汀沚，相徉鸥鹭傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38903,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其十九","author":"谢元汴","text":"残年壮抱馁，宝剑床头吟。\n不见黄河水，倒连天汉深。\n牧吹纷向夕，寒鸟各依林。\n痛饮充骚隙，长歌破短襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38904,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其二十","author":"谢元汴","text":"襄城迷七圣，崱巘亦崆峒。\n松干虬形拙，岩身魑状工。\n风飘不自北，枭徙尚闻东。\n夕照灭明外，翳然水木红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38905,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其二十一","author":"谢元汴","text":"葭律叶霜信，修原眺望遥。\n颉颃上下鸟，断续短长桥。\n坠地儿先哭，参天柏后凋。\n敢为类社树，如彼系陵苕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38906,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其二十二","author":"谢元汴","text":"风雨相餤食，不为乌兔谋。\n霜呜钟亦应，蘋秀鹿能求。\n如襮如冠后，似旄似亩丘。\n神山不可到，此亦凤麟州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38907,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其二十三","author":"谢元汴","text":"韩陵石一片，以下皆驴鸣。\n白堕引群豕，青尊对老兵。\n文人无不可，太上贵忘情。\n戏作野雩逐，胸中块垒平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38908,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其二十四","author":"谢元汴","text":"古道流泉侧，馡然草木香。\n苔痕履宪耿，冰窦鹤踪光。\n避俗移深广，无人行独梁。\n明星三五嘒，衡宇永相望。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38909,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其二十五","author":"谢元汴","text":"放怀霄雿表，林表树苍苍。\n如水宁如醴，食鱼不食鲂。\n吟诗灵宝始，送老石闾方。\n几见神仙葬，白云即帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38910,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其二十六","author":"谢元汴","text":"犹使儿童识，凿山惧未深。\n不观高士传，能入酒人林。\n静兕眠清野，寒鸠笑木阴。\n天空月色正，零露肃孤砧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38911,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其二十七","author":"谢元汴","text":"若令违初迪，此生总不能。\n伐幽虫啮木，剔奥石镂棱。\n济胜非无具，空村但少僧。\n凭今与吊昔，貉貉一丘仍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38912,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其二十八","author":"谢元汴","text":"愿搜残史册，分付与麋群。\n十七部从说，三千年试云。\n迁而上仅见，瞱以后无闻。\n安得祖龙焰，都将冢屋焚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38913,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其二十九","author":"谢元汴","text":"忽笑黄江夏，徒成鼓吏名。\n菰芦中俊物，天地一苍生。\n但信青猿哭，终疑紫凤鸣。\n无端发浩想，虎仆代龙耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38914,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其三十","author":"谢元汴","text":"谁云非太古，叶落不知年。\n可笑因鸿热，难言受鬼怜。\n危峦栖逸鹤，浅濑跕飞鸢。\n莫愠芙蓉老，不如薋菉妍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38915,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其三十一","author":"谢元汴","text":"嗟予生也晚，不及揖公存。\n四海方无事，知津昔有言。\n眇然绝俗意，难与世人论。\n勿曰忠清异，寒烟合一痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38916,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送同年郑沙石之开建广文任","author":"谢元汴","text":"曩别未云易，于兹弥信难。\n穷惟此日月，世孰为张韩。\n白水同元味，筠心足岁寒。\n苍梧古帝迹，淼渺路漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38917,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答刘不注二首 其一","author":"谢元汴","text":"一汉与世隔，抱卷未云穷。\n以我闭门意，悉君率野衷。\n残书蔽古屋，霜落下秋空。\n鸣马萧萧际，于兹莫不同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38918,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答刘不注二首 其二","author":"谢元汴","text":"好友信难聚，君言将勿然。\n二三同志外，凉落古人前。\n表物孤存性，避言理独骞。\n龙渊知我者，瘗影自年年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38919,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠张丹书明府","author":"谢元汴","text":"鸾乃凤之族，寂然君子堂。\n人皆咻即墨，我独说桐乡。\n赫赫名何事，悠悠恺自将。\n江南多苦状，天意正苍黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38920,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上巳同外弟吴顺侯甥林世模弟元汉男渠饮北山寺","author":"谢元汴","text":"忽忽自兹去，澹然诣一山。\n物心因趾往，我意与松间。\n蔬茗敦醇理，耘锄恤力艰。\n便从岚翠转，绿净见汉环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38921,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七月十三夜对月","author":"谢元汴","text":"天浩岂无际，山虚寂一身。\n偶然今夜月，忽想古之人。\n奇欲凌秋壑，孤能绝众因。\n难将千圣意，轻与寒螀陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38922,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阅表弟陈克棐近诗与订同异","author":"谢元汴","text":"作诗无定例，高者不因人。\n奇险宜深稳，孤清欲峭新。\n有如臡雁鸨，何必别荪莼。\n韩杜吾师也，问谁狎主臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38923,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"予卜居大田自癸巳今庚子夏羊城归七月至于十月率病偶一日午毕循塍行邻犬有见而吠者感而赋之","author":"谢元汴","text":"七祀空山客，如蚕不出匡。\n一惭宁不忍，群吠果何妨。\n将勿怪头换，幸非同谷亡。\n灶觚存纪载，终老白云乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38924,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长至前一夕示儿渠","author":"谢元汴","text":"山月淡如许，飒然白一乡。\n霜枫父子共，老室圣贤凉。\n裂险惊奇鬼，搜荒辩土羊。\n不知当几等，始得到羲皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38925,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送同年汪尔陶之端州余拟有兹行不果","author":"谢元汴","text":"燕市矜同调，禺山相见初。\n灵光犹鲁殿，半体亦王馀。\n勿作浮湘叹，非无种树书。\n苍茫烟水望，搔首欲踟蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38926,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"编旧诗竟上后山冈子夕望述怀","author":"谢元汴","text":"悠悠千载后，此意向谁明。\n石破惊天雨，云荒落水声。\n元文资客难，黄理委时评。\n肯信蛟龙梦，空惭奥博名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38927,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中寄袁于人","author":"谢元汴","text":"青山与破帽，蹇产亦相当。\n弛壑宽龙寝，避云让豹房。\n无多求友法，但有听神方。\n何以秋冬际，孤行理不伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38928,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送子茅弟计偕","author":"谢元汴","text":"公车燕蓟路，昔昔曾兹行。\n与子期千载，笑予抱一硁。\n客心迟岸柳，孤棹发江城。\n分手明朝去，凄然暮雁情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38929,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕寓郡学明伦堂检吴茧雪粤集呈茧雪","author":"谢元汴","text":"虽在荒城里，无殊萧寺中。\n苍凉老树影，澹荡古人风。\n卜宅邻原宪，开樽忆孔融。\n微吟方拥褐，灯火簇春红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38930,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴茧雪即席","author":"谢元汴","text":"只如僧院宿，澹月见初痕。\n飒飒松湍响，微微钟梵喧。\n岁华我辈集，摇落几人存。\n忽忆西偏下，桃花隔一垣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38931,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴茧雪太守返里二首 其一","author":"谢元汴","text":"四稔春风侧，怡然古道颜。\n公归钓漂水，吾志伴韩山。\n巷论存三老，赓章见一班。\n遥瞻天际鹤，倦翮暮飞还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38932,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴茧雪太守返里二首 其二","author":"谢元汴","text":"赵德吾安敢，倘于子野归。\n寻常失觌面，高简俯尘寰。\n荆楚记谁续，循良迹可攀。\n孤帆千里掉，流水听潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38933,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送翁莱山明府之新田任二首 其一","author":"谢元汴","text":"作令文章窟，吾其旌子行。\n潇湘水可渡，单莒政能成。\n去矣蚕忙际，怀哉求友声。\n劳君勤抚字，莫漫说阳城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38934,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送翁莱山明府之新田任二首 其二","author":"谢元汴","text":"于世求元柳，孰为踵者与。\n窊樽石在否，钴鉧潭何□。\n异水奇山域，真儒古帝居。\n鸣琴若有暇，一探酉阳书。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38935,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨霁与姨弟蔡懋章客楼小酌","author":"谢元汴","text":"风雨闭门坐，连床寒色深。\n乡心红树隔，客意绿蕉侵。\n薄暮牛羊下，微晴鸟雀吟。\n一如山止聚，亭角眺苍林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38936,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕四首 其一","author":"谢元汴","text":"老至物情淡，明朝又早春。\n岁行已若此，往事何酸辛。\n寒铎闻前巷，孤舂隔数邻。\n焚香冥默坐，静忆百年身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38937,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕四首 其二","author":"谢元汴","text":"十载荒山卧，兹留亦偶然。\n交希无杂客，味冷不知年。\n白饮茗千矗，冰羞疏一笾。\n寒风吹土壁，暝色莓苔延。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38938,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕四首 其三","author":"谢元汴","text":"今夕家园宴，慈亲杖履轻。\n弟兄别后梦，儿女岁时情。\n念我高楼上，辛勤白发生。\n小亭方筑就，编竹待而成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38939,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕四首 其四","author":"谢元汴","text":"破屋巉岩侧，卜居邻老农。\n到门惟绿水，近岭多苍松。\n步武寒溪鹭，书声夜壑龙。\n兹来采白石，仆影微躬从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38940,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日同懋章步入仁寿庵","author":"谢元汴","text":"春柔草木善，吾意眷松寒。\n值此芳菲日，空歌道路难。\n悠哉黄面士，烟雪历川峦。\n寄食青龙宅，乐天得所安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38941,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冒雨繇佛山渡珠江舟眺","author":"谢元汴","text":"疏踪恒在水，弥望空濛间。\n细雨白波上，孤舟碧树湾。\n渔汀迷乱苇，岛寺没烟鬟。\n岂亦乘桴者，风霜老面颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38942,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得家报及袁于人江右书","author":"谢元汴","text":"不意儿书至，欢闻老母安。\n既云公税急，矧又仆程难。\n申以龙沙札，正当菖涧寒。\n迟予深柳下，尊酒共盘桓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38943,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西林寺赠别无味空二上人","author":"谢元汴","text":"婆娑古树侧，奈宛逢西崩。\n半日荼香寂，诸天空色澄。\n明明夫子事，炳炳一心灯。\n爱尔若霜竹，泥洹吾未能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38944,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"光孝寺登毗卢佛阁","author":"谢元汴","text":"名寺曰光孝，通禅理信然。\n我来瞻法海，碑版动心田。\n十月凤凰梦，三春陀曼天。\n危楼一凭望，萱草白云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38945,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和黄伯城见投韵二首 其一","author":"谢元汴","text":"师乎抗节死，愧我犹偷生。\n桐桂宜存种，离车不好名。\n老僧裳古拙，山鬼貌奇狞。\n寂寂田横岛，胡能不及情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38946,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和黄伯城见投韵二首 其二","author":"谢元汴","text":"洒濯观天下，予心倍憬然。\n弇兹一室内，踔厉九丘前。\n祭草从今日，纳肝忆往年。\n苌弘虽已矣，碧血弥芳鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38947,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"繇仙城放棹佛山望海珠寺","author":"谢元汴","text":"何年灵物蛰，失此颔中珠。\n坛殿留玄秘，山川列画图。\n空青万象合，寥落壮心孤。\n日日风潮涌，中流屹一壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38948,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"繇佛山溯流仙城望海珠寺","author":"谢元汴","text":"敢以批鳞笔，来探江上珠。\n流多兴废事，写出霸王图。\n黄纛蛮君贵，牂牁汉迹孤。\n不须临碣石，炎澥小蓬壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38949,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏石龙","author":"谢元汴","text":"龙以灵成形，石龙龙亦灵。\n善通朱氏梦，能染顾君青。\n夭矫叶公璧，柔驯刘累庭。\n会须腾汉沼，莫作五侯鲭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38950,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别黄观之","author":"谢元汴","text":"予亦老于客，嗟君姜桂奇。\n十年能不字，五岭倍相思。\n秋水夫何远，孤舟信所之。\n韩山吹短帽，待子黄花时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38951,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读沈石友七虞诗感而和之七首 其一","author":"谢元汴","text":"丁壮馀三户，惊闻粟米征。\n九州同贡赋，四海庆俞都。\n卜式宜边吏，弘羊信我徒。\n农桑生孝弟，敢曰力田粗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38952,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读沈石友七虞诗感而和之七首 其二","author":"谢元汴","text":"稽古井田迹，沟同列亩区。\n纷然成水火，论者局方隅。\n新莽徒多事，荆舒亦拗夫。\n何如带索叟，箕踞眠长株。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38953,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读沈石友七虞诗感而和之七首 其三","author":"谢元汴","text":"忆早悬弧日，龙驹姚且都。\n稼陶成苦窳，泉布一糊涂。\n金策昭阳九，苍廌哂腐儒。\n试询彭泽里，今有柴桑无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38954,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读沈石友七虞诗感而和之七首 其四","author":"谢元汴","text":"铜柱铭奇烈，方方事挽刍。\n催科书上考，嫠媪泣中途。\n咸欲金如粟，未间裤倍襦。\n舟车纷载宝，弊吏贵藏污。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38955,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读沈石友七虞诗感而和之七首 其五","author":"谢元汴","text":"一亭孤兀峙，有客冷焉癯。\n菽水礼书易，砚田坟壤墟。\n稀星悲在罶，止屋叹瞻乌。\n漆室贫人女，肠中百折纡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38956,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读沈石友七虞诗感而和之七首 其六","author":"谢元汴","text":"嗟来蒙袂者，半鬼半人殊。\n空下牛衣泪，勿言秧马租。\n少年轻贾谊，男子孰郇模。\n安得流民绘，丹青四野逋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38957,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读沈石友七虞诗感而和之七首 其七","author":"谢元汴","text":"春秋纪石鹢，穆子焚尪巫。\n市井虎蛟恣，山川鱼鹿枯。\n絙弦摧柱绝，柔辔引骖敷。\n数顷南山豆，谁为治秽芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38958,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀古再用前韵三首 其一","author":"谢元汴","text":"韩山高崱屶，烂斧我荛刍。\n开凿五丁手，艰虞九坂途。\n君为云汉锦，我作衣裳襦。\n譬若花开落，任其茵与污。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38959,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀古再用前韵三首 其二","author":"谢元汴","text":"孤山与梁益，晦显亦何殊。\n梅鹤非忘世，马牛可运租。\n冬青谁麦饭，汉贼费吁谟。\n心迹隆中并，高风处士逋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38960,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀古再用前韵三首 其三","author":"谢元汴","text":"若论文章事，小巫或大巫。\n吟诗贾岛瘦，咏树庾山枯。\n潋潋河流缓，离离竹影敷。\n白烟空一抹，藜莠弥平芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38961,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得揽察草木犹未得示诸子五首 其一","author":"谢元汴","text":"暮魂烟步漾银沙，㻬印印山山色霞。\n孝夏忠春谀地肺，友风子雨葬黄笳。\n焚多药树成尸沥，筮得龙荒付鬼车。\n玉女投壶天一笑，美人倒影盼流霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38962,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]