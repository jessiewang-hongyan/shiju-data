[{"title":"三封庙寄侄逊道迩道","author":"何吾驺","text":"哭绝还苏亦已疏，凤衰犹见两飞雏。\n临风纵有一行泪，何似吾儿读父书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潘宪郎友盟惠镌杯赋璧","author":"何吾驺","text":"文德当年徵让畔，维风况是道为邻。\n还君花下频斟酒，莫遣区区负古人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送冯介臣入金陵","author":"何吾驺","text":"淮阴门地本书生，翊汉功成仄治兵。\n骏马雕弓何用著，数篇黄石到天京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲申冬漫占","author":"何吾驺","text":"受命封疆死亦香，抱头奔窜谓非忙。\n老生爱读张巡传，不识人间几不妨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"履端二日赋十绝句 其一","author":"何吾驺","text":"十旬晴霁乍闻雷，出震能教万象开。\n莫道春风偏护暖，春风原是雪中回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"履端二日赋十绝句 其二","author":"何吾驺","text":"江水攒流活活春，桃花浪里问渔津。\n操舟正唤风波急，稳舵中流未易伦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"履端二日赋十绝句 其三","author":"何吾驺","text":"什千罗绮尽成尘，闾巷疏疏复贺新。\n惊喜七襄留得在，太平天子万年春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"履端二日赋十绝句 其四","author":"何吾驺","text":"绕膝儿孙喜岁添，晶盘留酌水晶盐。\n儿孙添得成人早，添老应增俗眼嫌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"履端二日赋十绝句 其五","author":"何吾驺","text":"新雨新雷造化工，君看补浴未应穷。\n长风吹向扶桑树，一顷曈昽万里红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"履端二日赋十绝句 其六","author":"何吾驺","text":"又看六十九回新，尚抱童心访夙因。\n若个岁除瓶有米，谁能酤酒话芳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"履端二日赋十绝句 其七","author":"何吾驺","text":"巢许原辞日月光，毋烦爝火溷行藏。\n春来舟楫浮空至，可有尊□奏一匡。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"履端二日赋十绝句 其八","author":"何吾驺","text":"邓禹趋扶汉鼎初，姜公应未著阴书。\n纵勷八百周京业，应诮当年老负锄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"履端二日赋十绝句 其九","author":"何吾驺","text":"尽影麒麟获亦奢，何须白镪重咨嗟。\n祇今不洗冰霜出，一统其如岁月何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"履端二日赋十绝句 其十","author":"何吾驺","text":"春元一日四风齐，应有新章入拜稽。\n但使苍生歌饱暖，普天谁不颂云霓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"履端二日赋十章际霞和之更作一章感来旨亦复倚和","author":"何吾驺","text":"曾告严陵老钓纶，汉家砥柱有伊人。\n群公尽逐声华会，岂识维风在富春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再过端水","author":"何吾驺","text":"雨过山色满松溪，风送閒云日未西。\n日暮冷风悲野雀，隔溪何处问晨鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画","author":"何吾驺","text":"亭敞轻阴望远潮，有人彩鹢驾兰桡。\n侍儿惯弄潇湘水，横笛一声入汉宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读郭汾阳传","author":"何吾驺","text":"震主声名虑祸胎，当筵红粉故铺排。\n今人未作中兴事，先办堂前十二钗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韶州岁事十首 其一","author":"何吾驺","text":"天入阳和景物佳，莺声次第绕新槐。\n太平消息开帘满，莫向东风话旅怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韶州岁事十首 其二","author":"何吾驺","text":"夭桃秾李笑逢新，浅画浓妆较未匀。\n好手得如吴道子，笔端轻染物皆春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韶州岁事十首 其三","author":"何吾驺","text":"和风缓缓散轻霜，襆被床头挹酒香。\n休讯南来书到否，挥杯看剑意俱长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韶州岁事十首 其四","author":"何吾驺","text":"十年生事理渔矶，又向天兴问故扉。\n可恨韶烟留客住，岭云片片不东飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韶州岁事十首 其五","author":"何吾驺","text":"归舟夙昔税三吴，守岁高歌兴不孤。\n十载重过虞帝庙，兵戈阻绝课樵苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韶州岁事十首 其六","author":"何吾驺","text":"露盘曾莫剪新蔬，不耐时艰几上书。\n借看未能天漠漠，夜寒清漏绕宸居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韶州岁事十首 其七","author":"何吾驺","text":"世乱驱人出敝庐，千秋知己手丹书。\n春光好送汀州道，一扫氛霾岁与除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韶州岁事十首 其八","author":"何吾驺","text":"浮尘劫运已销残，捲幔千山淑气还。\n自信南阳逢圣主，新恩频趣领鹓班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韶州岁事十首 其九","author":"何吾驺","text":"自然应运奏中兴，也待经纶道乃升。\n乘气三阳宣德泽，何愁厥角不齐崩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韶州岁事十首 其十","author":"何吾驺","text":"南来王气有南昌，春早行宫纳百祥。\n吴越坐归江楚合，燕台晓听玉锵锵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韶阳除夕承李湛一太夫适馆授餐赋谢 其一","author":"何吾驺","text":"拂拂春风照客颜，芙蓉山作武夷看。\n使君高谊移樽俎，何处天涯不素餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韶阳除夕承李湛一太夫适馆授餐赋谢 其二","author":"何吾驺","text":"入直先皇十数年，朋樽物色尚依然。\n何缘更作春明会，花烛连宵绕禁烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韶阳除夕承李湛一太夫适馆授餐赋谢 其三","author":"何吾驺","text":"血腥鱼腹断行尘，又报欃枪舴艋新。\n南粤尉佗风景暮，贺兰山北去何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韶阳除夕承李湛一太夫适馆授餐赋谢 其四","author":"何吾驺","text":"多少风光总未匀，荔枝红艳荐时新。\n旧家燕子重来少，肯信江村有送春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶书 其一","author":"何吾驺","text":"借火提灯恁认真，花开水落去来因。\n分明昼夜通知处，别有西方现圣人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶书 其二","author":"何吾驺","text":"血肉原来幻海尘，出头暗里自机深。\n碾冰煎汞殊相似，不是淘沙不见金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶书 其三","author":"何吾驺","text":"拚断恩仇平等看，眼前灭念触灵光。\n万缘若便当时歇，透体琉璃照肺肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶书 其四","author":"何吾驺","text":"大道繇来圆更圆，五帝三王治半边。\n万古悠悠生对灭，灭中消息与谁传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"河清表瑞","author":"何吾驺","text":"天一道皇极，关西献瑞图。\n洮兰初见底，匏子乍呈珠。\n忆昔高皇兆，常澄碛石区。\n神孙膺宝箓，河伯复祯符。\n三日圭光见，中流璧影扶。\n越裳知问译，作颂拟赓虞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32142,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘是庵老师生日","author":"何吾驺","text":"圣历如天永，台星傍日明。\n西山来玉乳，北极浥金茎。\n恭遇生申旦，政逢转泰亨。\n春开傅内瓮，乐奏和朝莺。\n夫子文章主，当今礼乐衡。\n百川同学海，万国待于京。\n民望夔龙相，天高辅弼名。\n世家传作楫，公子学调羹。\n绕户生荣气，通元懋德声。\n筵排三乐畅，瑞蔼五伦呈。\n忆昔廷抡士，当时物望倾。\n惧为后世颂，愿展帝廷赓。\n柳色晴初发，韶光淡不盈。\n调元方寿国，千载有长庚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32143,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同诸子集雪树斋赋","author":"何吾驺","text":"凉风玉宇迥，晚露锦荷香。\n言采金兰契，欢逢薜荔傍。\n传杯醉浩漾，把袂动翱翔。\n十载存肝胆，三秋忆慨慷。\n不辞徐孺榻，还续阮生狂。\n棋响雨声碎，灯昏夜汉光。\n烹茶怜漏箭，刻烛赋流黄。\n逸拟云英合，清疑玉树芳。\n挥毫推彩笔，搦管愧枯肠。\n授简诸生后，每嫌秋夜长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32144,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送蔡五岳明府应内召","author":"何吾驺","text":"花开如锦日，琴叶正明时。\n凤诏传天语，龙章出禁帷。\n怀珠原闪烁，韫玉更离奇。\n秀彻湖山色，寒清炎海湄。\n西方开宝筏，东鲁见心师。\n一字闻真谛，千秋仰德慈。\n剑锋从悟入，笔力借神驰。\n文藻轻班马，瑶华绝献羲。\n堂开心寂寂，政晏日迟迟。\n瘴海初闻颂，仁山静赋诗。\n宝屠浮百尺，高馆望层漪。\n欲接乾坤气，先分混沌仪。\n锄强不避虎，扶弱讵欺儿。\n才子初为令，真人今在兹。\n元风清有韵，雅度赏应私。\n忆我方倾盖，怜君便解颐。\n群鸡一此鉴，独鹤谬相知。\n言以兰同气，香随茝见贻。\n振衣秋霭净，聆语晓云披。\n自愧嵇康懒，何妨小陆痴。\n通家欣就业，解榻倏相辞。\n百里言淹滞，三洲惜别离。\n巽申天上命，离焕日中曦。\n暂借金陵署，终当玉殿随。\n埋轮看壮气，鸣凤肃霜姿。\n圣后方张网，良臣已奉绥。\n麒麟原有阁，鸑鷟待来墀。\n致主同尧舜，纡猷侣稷夔。\n河明净天影，云动起凉飔。\n送送秋光冷，行行玉露垂。\n欲随双羽翼，难写寸心期。\n题柱神先往，弃繻气未衰。\n中原犹逐鹿，天下可追骐。\n握手暂相别，馀情到酒卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32145,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺黄倬星太史母七十有一","author":"何吾驺","text":"圣寿方无极，词垣首被恩。\n岁星在金马，桃实寄庭萱。\n帝宠文章贵，天成德齿尊。\n酒将茎露冷，斑惹御炉温。\n万里南山祝，千年北海樽。\n玉堂开锦宴，鸾驭集文园。\n水陆供仙馔，笙簧绕相门。\n紫荆有令弟，兰树识芳孙。\n及此忠为孝，同誇丝是言。\n昔称三乐具，今喜五伦敦。\n兰苑镂金石，螭头洁藻蘩。\n调元应有自，毋得颂纯坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32146,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠曾鲁朴山人","author":"何吾驺","text":"先生何许客，汗漫寄云游。\n到处谈杯酒，长天挂钓钩。\n鄱阳孤剑起，渤海一星浮。\n壁立空青柳，江流任白鸥。\n虚危辞旧舍，牛斗望南州。\n梅岭旌旗振，珠江花鸟愁。\n广陵虽已邈，彩笔亦何求。\n独鹤栖何处，飞云不可留。\n狂为曾皙后，赋比浩然优。\n水调歌声急，商音耳听秋。\n疾来山落石，漫奏涧行滮。\n定远虚存瞬，严陵有敝裘。\n长裾良自拙，短铗为谁谋。\n上岸愚公谷，乘航渔父讴。\n劫灰宁黑白，石火既蜉蝣。\n在在安羁旅，飘飘识客舟。\n忘机得乐土，问地取灵邱。\n万里行龙脉，千山夺虎头。\n吾家阮叔子，平素谢元收。\n已作张天网，曾将倒屣酬。\n歌风归大苑，结袂唱高楼。\n心计嘉毛遂，文声许马周。\n丹砂期未满，白石运良遒。\n忽尔知人死，长怀国士忧。\n悲风起大漠，朔草自惊秋。\n壮志思溟渤，哀诗见逗遛。\n寥寥琴欲破，寂寂暗难投。\n我亦临风客，君来并策骝。\n褰裳看世事，开眼傲王侯。\n梁甫吟初就，渡河乐正幽。\n家留千载业，路蹴小儿毬。\n刻鹄终非计，雕虫亦已悠。\n弥衡诚肮脏，原宪岂咿咻。\n长卧怀三窟，虚名重九牛。\n关山同腐朽，亩亩伴箜篌。\n看尔如传舍，吾身亦赘疣。\n太元差可草，五色已能耰。\n栖息一枝好，风光两共繇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32147,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄邓存宇宪使","author":"何吾驺","text":"岐海波仍润，仁山月满楼。\n高名驰百粤，过化忆三州。\n柏列滇南戟，棠阴岭道稠。\n潺湲思泰岳，睇望阻遐陬。\n人弃摧枯木，君怜揽敝裘。\n金台容御李，珠海幸依刘。\n山月入帘夜，江云放棹秋。\n深杯忘我辈，横被剧仙舟。\n人自龙门远，书来雁帛遒。\n千言怜国士，双爵重吴钩。\n草莽存交谊，天涯动客愁。\n从销金石烬，不变海波流。\n杳杳嗟驹隙，悠悠问女牛。\n藐孤哀骨毁，弱羽阻云脩。\n紫气函关满，青峰太华浮。\n纡衡金马在，揽胜碧鸡留。\n霜肃社无鼠，风清夜不桴。\n勒铭关塞日，倘许借前筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32148,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄鼎湖栖老和尚","author":"何吾驺","text":"永夜看经静似冰，未须善识为挑灯。\n漏残未奈穿窗雨，拈韵题诗寄老僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32149,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送冯鄂芝归新兴","author":"何吾驺","text":"记得中秋看明月，大家握手话平生。\n明朝忍向江南别，不那风前听鸟声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32150,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"屿竹","author":"何吾驺","text":"屿竹新晴外，生香揽镜馀。\n屐痕苔径滑，菜食突烟疏。\n击磬扣门客，张徽出听鱼。\n悠然会心地，萝月夜窗虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32151,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游仙辞 其一","author":"何吾驺","text":"五岳多紫芝，天台有奇药。\n弭节聊容与，寻幽转寥廓。\n倏忽异天地，灵妃忽启钥。\n瑶池杳无尘，兰芳芬四泽。\n眩目乍生惊，怡颜遽相谑。\n引坐烟林间，玉杯浮翠酪。\n屈卮三四倾，灵颜愈灼烁。\n仙侍排云来，绕䈴进天乐。\n乐罢还命去，双携入云幕。\n一日即千秋，世间无此乐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32152,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游仙辞 其二","author":"何吾驺","text":"高楼千百尺，中有两仙人。\n金楹标雾霭，翠裾耀龙文。\n手持白玉箫，去是凤凰音。\n气动生凉风，声振入青云。\n粲然相顾笑，驾言游大清。\n挽手张孔盖，联䮽乱羽旌。\n果有双鸾至，乘之升天门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32153,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"慈惠寺作","author":"何吾驺","text":"岂尽耽禅悦，因君作胜游。\n云中閒纵目，世处此登楼。\n霜气凋群木，风威损敝裘。\n自然成肃杀，天地正深秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32154,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次答黄逢永订游西樵不果","author":"何吾驺","text":"挥杯言共访仙踪，书到云山未许从。\n玉洞明朝单系马，穗城后夜几听钟。\n扪萝选胜惟双屐，纵步行吟仗短筇。\n几欲缄题那可寄，直愁回首鹧鸪峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32155,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月下同诸子发舟游西樵","author":"何吾驺","text":"楼头月色映溪沙，大海潮生拥汉槎。\n有约浮山淹九月，偶来樵路访三花。\n扬帆似借仙人驭，洗灶凭煎处士茶。\n岂为陟幽恣胜赏，他年吾尔共携家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32156,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜诸子载酒聚仙亭","author":"何吾驺","text":"中天皓月出云端，耿耿河山剧一观。\n十郡玲珑乌鹊隐，四山寥廓斗牛寒。\n杯斟白练当仙掌，歌落清霜绕画阑。\n人坐群真君识否，凭空吾欲振飞翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32157,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中早起","author":"何吾驺","text":"晓望孤峰若可攀，江摇疏雨助潺湲。\n云深欲问茅君宅，岩畔都疑米氏山。\n便觉梦多琼岛路，不知身近玉虚班。\n却嫌刘阮俱凡士，得晤神仙草草还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32158,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辛亥春二月朔日襄事先父于鹿鸣湾月山感赋","author":"何吾驺","text":"吞声执绋不禁愁，才到天明便一丘。\n反哺只今空有血。\n望云何处更停眸。\n青山杳杳千年路，沧海悠悠百里舟。\n寒食春风岁时事，蒿庐行傍此山头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32159,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庆翁寿图赞","author":"何吾驺","text":"万山丛谷里，佳气耀真人。\n住世悬银馆，辞荣老钓纶。\n秦关深雨露，粤社隐风尘。\n道德应谁授，罗浮玉树春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32160,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"定心泉","author":"何吾驺","text":"快哉定心泉，一饮清彻骨。\n至人以此洗，胸中无一物。\n隐之云贪泉，夷齐终不易。\n假使盗蹠来，饮此将安适。\n我心如琉璃，与水澄一碧。\n若向泉觅定，定泉何处觅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32161,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游峡山寺","author":"何吾驺","text":"绝壁僧归鸣午钟，扪萝直上步晴空。\n带前坐绕千派玉，掌上平临万仞峰。\n乍入朔云高独鹤，犹馀秋色锁芙蓉。\n诸天更有清凉界，飞去何当作钵龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32162,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠王黎公大行","author":"何吾驺","text":"参天松柏影，来过此亭间。\n振古悬星汉，论心别水山。\n剑花看侠骨，冰镜照红颜。\n揽辔登东岱，丘陵孰敢攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32163,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"军中秋夜感赋","author":"王沂","text":"剑拂寒光子夜秋，屯云戎马尚淹留。\n时催雁字归炎极，谁补龙章侍冕旒。\n天宇渐清尘土梦，秋声偏动野人讴。\n月明自是孤吟侣，迢递何心上庾楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32164,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出固镇怀仲弟","author":"陈经翰","text":"忆弟看云望眼赊，频年为客滞天涯。\n梦悬池草三春色，心折秋风八月槎。\n金尽燕台悲郭隗，剑分延水失张华。\n只今尘满关西路，羞向江南再问家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32165,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠孙象山","author":"李畅","text":"遥峰写十洲，列岫环四象。\n茂树覆茆亭，曲槛开方丈。\n静观得化机，妙适恣幽赏。\n春风澹澹生，旭日曈曈敞。\n花鸟可自娱，景色觉来爽。\n嵇阮足舒啸，求羊日来往。\n令名高著作，吾道存景仰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32166,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钟明府邀酌鸳鸯湖","author":"李畅","text":"高人拉我游，浑似泛仙舟。\n箫鼓风传曲，壶觞月满楼。\n湖山青翠遍，烟雨绿荷稠。\n地挹六桥暮，风回五月秋。\n低花时度蝶，近水不惊鸥。\n酒醉未归去，应知欲枕流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32167,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"有感","author":"李畅","text":"霜露既不降，苦风何当下。\n商节已穷秋，晓色还如夏。\n蒸岚卷地翠，落叶空庭洒。\n幽怀久不惬，杯酒堪陶写。\n况兹秋意浓，独酌泪盈把。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32168,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]