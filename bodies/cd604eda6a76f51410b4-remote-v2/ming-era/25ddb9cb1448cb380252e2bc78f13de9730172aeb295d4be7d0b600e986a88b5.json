[{"title":"哭李惟寅太保十二首 其一","author":"胡应麟","text":"大将星沉易水头，五陵城阙暮生愁。\n那堪落日临淮第，珠履三千觅故侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭李惟寅太保十二首 其二","author":"胡应麟","text":"笙鹤遥天拥上才，何年华表一归来。\n黄金惨淡名流绝，落日阴风满坏台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭李惟寅太保十二首 其三","author":"胡应麟","text":"秋色辕门照大旗，塞垣金柝夜迟迟。\n危楼十丈中天月，尚忆司空坐啸时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭李惟寅太保十二首 其四","author":"胡应麟","text":"细柳营中柝夜停，衣冠朝野惜精灵。\n无烦更树中郎碣，潮海千山尽勒铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭李惟寅太保十二首 其五","author":"胡应麟","text":"露洗长空散郁蓝，无穷秋色庾楼南。\n胡床寂寞珠帘闭，不见征西月下谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭李惟寅太保十二首 其六","author":"胡应麟","text":"羽扇纶巾白纻袍，声名华貊羡人豪。\n不知累代凌烟上，若个如椽擅彩毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭李惟寅太保十二首 其七","author":"胡应麟","text":"梵宇金银簇画梁，湖山晴色遍奚囊。\n鱼龙寂寞仙槎去，四百楼台挂夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18958,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭李惟寅太保十二首 其八","author":"胡应麟","text":"十万貔貅静不哗，青门归熟故侯瓜。\n城头一夜飞霜急，落尽桓伊笛里花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18959,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭李惟寅太保十二首 其九","author":"胡应麟","text":"百尺层台近潞河，琅琊二美数经过。\n华阳座上谈天客，强半追随入大罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18960,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭李惟寅太保十二首 其十","author":"胡应麟","text":"燕子矶头落叶黄，秦淮南去是金阊。\n分襟最忆河桥畔，明月千山堕屋梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18961,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭李惟寅太保十二首 其十一","author":"胡应麟","text":"忆共春宵禁籞东，玉鞭驰骤两花骢。\n六街明月天如水，谁唤词人碣石宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18962,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭李惟寅太保十二首 其十二","author":"胡应麟","text":"国士提携最少年，青衫联袂洛城前。\n重来恸哭西州路，万树棠梨咽暮蝉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18963,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭曹子念六首 其一","author":"胡应麟","text":"历落嵚嵜赴九泉，伯通椽下最堪怜。\n扶风何处归妻子，恸哭梁鸿废冢前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18964,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭曹子念六首 其二","author":"胡应麟","text":"乘风先到凤麟洲，二舅星冠话昔游。\n树树棠梨娄水上，殡宫何处问曹丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18965,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭曹子念六首 其三","author":"胡应麟","text":"一病相如困茂陵，玉楼魂梦夜飞腾。\n亦知鹤背难胜汝，应逐齐谐跨大鹏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18966,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭曹子念六首 其四","author":"胡应麟","text":"三尺须髯十尺躯，便便大腹定谁如。\n莫言饱食曹交粟，七步才华四部书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18967,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭曹子念六首 其五","author":"胡应麟","text":"缧绁宁当罪冶长，当年书记羡邹阳。\n只今何处寻遗草，无限春风属野棠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18968,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭曹子念六首 其六","author":"胡应麟","text":"避地金阊岁不遥，荜门萝径晚萧条。\n钟声送客寒山寺，恨泊吴枫第二桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18969,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送谢文度还武夷二首 其一","author":"胡应麟","text":"长江天际一帆开，拂袖离歌下越台。\n君去幔亭回首望，霞光犹似赤城来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18970,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送谢文度还武夷二首 其二","author":"胡应麟","text":"凄风残月大江濆，送尔津亭见白云。\n摇落万山秋色里，何人同谒武夷君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18971,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过齐东不及持斗酒酹鸣皋墓二绝寄怀 其一","author":"胡应麟","text":"满眼寒山卧北邙，修文人去尚为郎。\n无劳更下杨朱泣，曾共斋头种白杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18972,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过齐东不及持斗酒酹鸣皋墓二绝寄怀 其二","author":"胡应麟","text":"殡宫遥锁石门寒，浅土齐东寄伯鸾。\n惆怅棠梨飞欲尽，乱山无语夕阳残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18973,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天香馆","author":"胡应麟","text":"缥缈孤根立翠峦，扶疏晴影拂仙坛。\n瑶台十二金风起，吹送天香出广寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"空翠亭","author":"胡应麟","text":"翠葆林林夹画墙，万株寒玉锁烟霜。\n閒来此地堪逃暑，满榻清风伴上皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"红蕖沼","author":"胡应麟","text":"徙倚清香动曲池，赤栏亭榭午风迟。\n红妆半掩青鸾扇，疑是温泉罢浴时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"来凤冈","author":"胡应麟","text":"百尺亭亭翳紫苔，清阴长夏满楼台。\n风前漫作琴声听，白昼天池凤鸟来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"断桥斜照","author":"胡应麟","text":"夹岸轻风上柳条，桃花晴逐杏花飘。\n游人不道春光晚，箫鼓楼船入断桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漳塘霁月","author":"胡应麟","text":"明月娟娟漾碧沙，银塘秋水浴蒹葭。\n凉风忽逐双凫起，零乱中流白藕花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18979,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天井平原","author":"胡应麟","text":"古木寒林四望幽，经过麋鹿共淹留。\n翛然不起红尘念，坐占平原十亩秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18980,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鹤阜清风","author":"胡应麟","text":"何年孤鹤此徘徊，引步仙风拂岛来。\n永夜月明秋万里，满空零露湿瑶台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灵鹫峰怀童子鸣二首 其一","author":"胡应麟","text":"行尽天台三十峰，春烟重叠锁芙蓉。\n孤云不作还家梦，卧听僧堂雨后钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灵鹫峰怀童子鸣二首 其二","author":"胡应麟","text":"翠拥千林路不分，夕阳回首一钟闻。\n天南词客留题处，惆怅西岩满寺云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18983,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆同俞羡长张元春何主臣吴德符游宿湖上弹指隔岁孤坐小园横塘烟雨甚思四君挐木兰飞白堕共之辄题一绝便面寄吴生传致三子","author":"胡应麟","text":"好风凉月大堤傍，何限秋光扑画墙。\n回首乱山飞鸟隔，一林烟雨满横塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18984,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王山人希曾记室戎行廿载矣归武林寄止穷巷门庭萧然余偶过啜茗其中为题此绝","author":"胡应麟","text":"老傍东林学种瓜，当年投管事龙沙。\n胡床独坐秋风里，门巷无声落豆花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18985,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆与王生酣眠小玉馆中迄今垂三十载武林邂逅纵谈畴昔则同事酒垆者什九岱宗矣把臂潸然辄复赋此","author":"胡应麟","text":"三十年前宋子侯，名花倾国烂溪头。\n箫声断绝秦楼闭，何处重携弄玉游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18986,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐茂才","author":"胡应麟","text":"竹窗萤火记当年，心折兰陵系酒船。\n纵是相逢犹有恨，西风憔悴菊花前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18987,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王生之白狼幕中二首 其一","author":"胡应麟","text":"不逐游閒抱隐囊，翩翩结束事戎行。\n闺中秋夜长如许，莫遣音书断白狼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c0685