[{"title":"题扇面","author":"郑真","text":"断坡高树昼阴阴，行转清溪路更深。\n可是草堂人不见，西风萧飒鹤孤吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25017,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题红梅","author":"郑真","text":"罗浮仙骨换丹砂，百折飞裙染翠霞。\n酒晕未消寒起早，夜来赐宴玉皇家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25018,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题墨梅","author":"郑真","text":"先春远寄墨淋漓，折得寒香第一枝。\n梦绕西湖山月暗，漆纱窗外影参差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25019,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题墨菊","author":"郑真","text":"客路游尘怕上衣，纷纷黄白眼都迷。\n归来篱落黄昏后，月露秋香暗绕蹊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25020,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题瓶梅","author":"郑真","text":"百花头上占春开，谁向山中折得来。\n碧水铜瓶甘作伴，夜深飞梦过瑶台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25021,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题梅竹","author":"郑真","text":"断崖人立锦皴粼，翠袖娉婷不惹尘。\n独有玉姬来索笑，岁寒霜雪许为邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25022,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题梅","author":"郑真","text":"玉皇宫阙拥群姬，缟素飘飘杂佩垂。\n侍辇恩深频早起，不禁霜雪立多时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25023,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画","author":"郑真","text":"楼台金碧五云边，秋水光涵一镜天。\n山郭蹇驴人去远，夕阳应棹渡头船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25024,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题梅","author":"郑真","text":"秋魁不得占春魁，惭负孤根雪里开。\n问汝不堪调鼎鼐，岁寒只许赋归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25025,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题吴道延西征卷 其一","author":"郑真","text":"万里烟沙惨淡中，西风遥跨锦花骢。\n囊中自有如椽笔，归上将军第一功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25026,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题吴道延西征卷 其二","author":"郑真","text":"重重土屋翠云腰，羌妇秋衣制黑貂。\n煤火烧红羊□□，□□□□□□□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25027,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题吴道征望云图","author":"郑真","text":"关西遥望海东山，心与浮云共往还。\n白发慈亲千里远，彩衣愿得奉慈颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25028,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题孤雁衔芦","author":"郑真","text":"塞北传书到日边，真州将信到幽燕。\n我家求得平安报，怪汝衔芦万里天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25029,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪梦 其一","author":"郑真","text":"帛璧求贤涧壑空，萧萧猿鹤恨西风。\n多君诵得春秋学，生死论交一梦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25030,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪梦 其二","author":"郑真","text":"老来应不耐尊拳，夜壑悠悠不记年。\n人事祇今如梦寐，忆君空有泪如泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25031,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题春江游玩图 其一","author":"郑真","text":"江上舟行不问潮，千金换酒特相邀。\n莺花正及青春乐，隔岸何人唱大招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25032,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题春江游玩图 其二","author":"郑真","text":"桃花渡口水如天，沧海蓬莱问列仙。\n老我长淮归未得，春风矫首白云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25033,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题春江送别图 其一","author":"郑真","text":"江水西流日夜声，棹郎挝鼓唤登程。\n滕王阁上神仙客，一曲空歌待月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25034,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题春江送别图 其二","author":"郑真","text":"满眼青山紫翠重，天风缥缈送孤篷。\n凭君一吸西江水，洗涤平生锦绣胸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25035,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题春江送别图 其三","author":"郑真","text":"渡头人唱竹枝歌，千里江山奈远何。\n春水光寒沙渚阔，忘机却爱白鸥多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25036,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题春江送别图 其四","author":"郑真","text":"风流马上为谁来，一叶风帆早欲开。\n好向紫金山下过，五云深处是三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25037,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题赵仲穆马上挟弹图","author":"郑真","text":"王孙骑马过林西，何事金莺不住啼。\n高嶂重重云不暗，春风吹送一丸泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25038,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题山水图","author":"郑真","text":"山树重重散晓岚，披图彷佛记江南。\n画船撑近檐前过，公子风流酒欲酣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25039,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题沈在新便面","author":"郑真","text":"红叶飘萧涧壑重，遥青矗矗倚浮空。\n山川自古夸形胜，不是吴中是越中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25040,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青山白云图","author":"郑真","text":"忆向山中看白云，画图披拂思氤氲。\n仙家远在空青外，一榻何时许见分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25041,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19e