[{"title":"闺怨一百二十首 其四十三","author":"孙蕡","text":"残春寂寞似深秋，风满帘栊月满楼。\n一撚芳心椰子大，若为装得许多愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48711,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其四十四","author":"孙蕡","text":"春云莽莽欲遮天，满眼如云复似烟。\n明月赶回青障外，长风吹到画堂前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48712,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其四十五","author":"孙蕡","text":"泪似花枝雨点流，愁如江上乱云浮。\n泪盈方朔三千牍，愁满瞿塘十二楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48713,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其四十六","author":"孙蕡","text":"青青桃李少年时，正好欢娱又别离。\n直到红颜都去了，却来相对喜成悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48714,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其四十七","author":"孙蕡","text":"莫入襄阳与洛阳，绮罗勾引少年郎。\n歌楼美酒三千斛，舞榭金钗十二行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48715,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其四十八","author":"孙蕡","text":"青楼曲谱怨湘娥，半是关山别意多。\n愁绪春来怕弦索，雪儿休更抱云和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48716,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其四十九","author":"孙蕡","text":"理得妆成坐少时，泪痕依旧湿胭脂。\n从今已后无心性，铅粉常抛不要施。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48717,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其五十","author":"孙蕡","text":"怨女和戎黑水河，玉环埋恨蜀山坡。\n佳人薄命头头是，比较儿身好几多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48718,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其五十一","author":"孙蕡","text":"月色花开滚滚来，不容些子暂开怀。\n杜鹃啼血方停舌，芍药移阴紧上阶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48719,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其五十二","author":"孙蕡","text":"生来自愧不为儒，敛手逢人念起居。\n空有一腔离别恨，倩谁修作万言书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48720,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其五十三","author":"孙蕡","text":"新愁旧恨积如林，欲诉还羞复不禁。\n安得越禽秦吉了，替人终日道劳心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48721,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其五十四","author":"孙蕡","text":"雨态云容恼杀人，虚无似梦复疑真。\n陈留子建多才思，莫向江皋赋洛神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48722,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其五十五","author":"孙蕡","text":"春来道是雨浪浪，却又开门见日光。\n欲启朱奁看明镜，头风半日不成妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48723,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其五十六","author":"孙蕡","text":"对花谁与掷樗蒲，自倚危阑到日晡。\n愁里漏声迟欲咽，自倾新水入金壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48724,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其五十七","author":"孙蕡","text":"记得儿孙乐事多，女郎同唱采莲歌。\n紫骝嘶入落花去，柰此空闺日暮何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48725,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其五十八","author":"孙蕡","text":"过从要与善为邻，况复炎凉世态新。\n不用为他烦恼得，阿欢原是读书人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48726,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其五十九","author":"孙蕡","text":"为怯琵琶不忍听，龙香拨子暗尘生。\n东墙怪底春风过，又是邻姬按玉筝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48727,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其六十","author":"孙蕡","text":"细展占书绣阁前，不知速喜定留连。\n恁谁断得郎归日，愿与金钗当卜钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48728,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其六十一","author":"孙蕡","text":"遥天月晕一环红，明日商量定起风。\n想怕玉娥心绪乱，故教闲住广寒宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48729,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其六十二","author":"孙蕡","text":"已许红丝绣镜囊，更饶金粉拭清光。\n镜中神圣知人意，托梦儿家白马郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48730,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其六十三","author":"孙蕡","text":"别意空凭远信传，几回临起复缠延。\n天长白雁捎将去，只在云南若个边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其六十四","author":"孙蕡","text":"黄昏也待睡些些，月影撩人故故斜。\n帘幕数重花万叠，愁来只是不能遮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其六十五","author":"孙蕡","text":"画笼鹦鹉日啁啾，自与离人替说愁。\n戏掷枇杷打金羽，儿夫去后忆奴否。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其六十六","author":"孙蕡","text":"世箓文星苦不齐，我辰生处直孤栖。\n大都离合原关命，错怨车轮与马蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其六十七","author":"孙蕡","text":"朱帘落索掉帘钩，日里狂风夜未休。\n花底过来吹蜡烛，也如人泪一般流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其六十八","author":"孙蕡","text":"愁里飞花一夕空，寸心无柰倩神通。\n闺闱不省文王易，卦落谁知吉与凶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其六十九","author":"孙蕡","text":"便拟招魂诵楚词，何缘生别故迟迟。\n临风试学巫阳些，偷把鸾钗挂竹枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其七十","author":"孙蕡","text":"春宵谁道直千金，妾独愁多思不禁。\n花月只消长惹恨，管弦惟有更伤心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其七十一","author":"孙蕡","text":"昔闻仙客好幽栖，除却清斋醉似泥。\n生世不谐遭远别，妾身何异太常妻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其七十二","author":"孙蕡","text":"百年夫妇本同心，旧爱新怜梦里深。\n料得君非题柱客，枉教人赋白头吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其七十三","author":"孙蕡","text":"少日双眸炯动人，倚风回顾颊生春。\n无因暗滴相思泪，减却秋波一半神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其七十四","author":"孙蕡","text":"午梦惊回是兀谁，阿奴偷撚紫箫吹。\n寒声未断肠先断，怨曲将成泪已垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其七十五","author":"孙蕡","text":"过眼年光总是愁，嫌春春去泪还流。\n荷香柳景凄凉夏，月色虫声冷淡秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其七十六","author":"孙蕡","text":"碧草初看上玉阶，飞花又见点苍苔。\n年年好景乖人愿，怀抱何时得少开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其七十七","author":"孙蕡","text":"绣阁朝来兴颇新，试拈钱卜问归人。\n花言巧语梁间燕，旧馆新妆镜里尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其七十八","author":"孙蕡","text":"怯雨愁花过一春，娇娆半是女儿身。\n朝来逐伴斗芳草，门外天风吹倒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其七十九","author":"孙蕡","text":"玉臂无人点守宫，戏拈花瓣贴春红。\n香痕忽被风吹落，彷佛逢君是梦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其八十","author":"孙蕡","text":"一从君去负芳春，几叹容华误妾身。\n也似崔徽啼别后，萧条不及巷中人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其八十一","author":"孙蕡","text":"供佛清斋折露葵，课经时绕白莲池。\n云鬟祇欠金刀剪，顿是山庵苦行尼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其八十二","author":"孙蕡","text":"班姬纨扇奉馀恩，蔡琰胡笳坠虏尘。\n此命一生如纸薄，好和孤妾是三人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其八十三","author":"孙蕡","text":"夜雨偏伤独睡情，芭蕉点点助寒声。\n分明隔著窗儿纸，直向心头滴到明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其八十四","author":"孙蕡","text":"村巫市媪莫相过，闻汝深中术数多。\n心似后园金井水，从来不会起风波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其八十五","author":"孙蕡","text":"采桑随伴出城隅，不谓途逢使者车。\n错把明妆照墟落，赚他驻马久踟蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其八十六","author":"孙蕡","text":"年少离家志未坚，闲云剩雨满江天。\n舟行若过巫山渚，莫向篷窗白昼眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其八十七","author":"孙蕡","text":"枉控朱帘十二钩，一身何用许高楼。\n桃花流水随郎去，只学渔家住小舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其八十八","author":"孙蕡","text":"写得鸾笺数十言，缄成不寄泪如泉。\n瑶池欲倩西飞鸟，带到湘灵锦瑟边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其八十九","author":"孙蕡","text":"窗纱云影作梅霖，冷蕊香凝案上琴。\n几日生疏弦上手，愁来无地著春心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其九十","author":"孙蕡","text":"心如金钿只须坚，归早归迟总信天。\n错听几声檐外鹊，朝朝江口望郎船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其九十一","author":"孙蕡","text":"高堂朝夕奉姑嫜，冬里温汤夏扇凉。\n不是西山春日薄，只抛孤妾亦何妨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其九十二","author":"孙蕡","text":"误透单居一味禅，丹光如月静中圆。\n人间若有蓬莱岛，也合乘风作女仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其九十三","author":"孙蕡","text":"无非祇为隔关山，若个牵缠久未还。\n二十五程荆楚路，顺流江水霎时间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其九十四","author":"孙蕡","text":"臂上红丝锦作符，灶前香火玉为炉。\n无人为起凌烟阁，书作紫姑仙女图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其九十五","author":"孙蕡","text":"欲扫鸾笺写彩云，惟将心事怨夫君。\n蜀山花竹湘潭雨，杜宇春深独不闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其九十六","author":"孙蕡","text":"婉意柔情似海深，却将离索负光阴。\n村姝野媪无风致，也解团栾作藁砧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其九十七","author":"孙蕡","text":"青草湖边日欲西，黄梅雨里鹧鸪啼。\n江南气候春来恶，莫听寒声助惨凄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其九十八","author":"孙蕡","text":"生儿岂免涉江湘，身世无成耻故乡。\n人事由来多错忤，知君不是故相忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其九十九","author":"孙蕡","text":"远路迢迢水隔天，流光冉冉箭离弦。\n惟应自筑青阳室，学炼还丹驻少年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其一○○","author":"孙蕡","text":"薄命真成枉嫁郎，嫁来三载守空房。\n鸣鸠语燕皆求匹，秋菊春兰各自芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其一○一","author":"孙蕡","text":"翻羡南邻卖酒姬，近来嫁得住家儿。\n何尝荡着春波性，步步相随不暂离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其一○二","author":"孙蕡","text":"金屋长年贮阿娇，好教虚度几良宵。\n寻常未嫁人家女，也向深闺怨寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其一○三","author":"孙蕡","text":"楚水吴山万里馀，两年方见一封书。\n都来费得鸾笺纸，何处春江无鲤鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其一○四","author":"孙蕡","text":"偶弄青梅凭短墙，谁骑白马傍垂杨。\n撩云泼雨来相扰，不是巫山窈窕娘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其一○五","author":"孙蕡","text":"洞庭暮雨起春波，翠旆金蕤帝子过。\n遥想泊舟明月渚，夜深攲枕听云和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其一○六","author":"孙蕡","text":"放着南来北去舟，江波不住也东流。\n良人解得西归日，可道相思到白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其一○七","author":"孙蕡","text":"濯锦江边杨柳条，浣纱儿女诧裙腰。\n子规啼罢春花落，游子青骖万里桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其一○八","author":"孙蕡","text":"瞿塘猿声天上哀，白帝城下水如雷。\n百折漩涡人鲊瓮，莫着郎船八月来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其一○九","author":"孙蕡","text":"湘江儿女单纻衣，娥皇庙前歌竹枝。\n春来只会闲相恼，不管人间有别离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其一一○","author":"孙蕡","text":"客程愁雨复愁风，君意怜侬却忘侬。\n把似相怜不相忘，只消那转马头东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其一一一","author":"孙蕡","text":"岁岁年年君去家，年年岁岁树开花。\n年年君去无消息，岁岁花开感物华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其一一二","author":"孙蕡","text":"寂寂寥寥纸半张，嗟嗟唧唧泪千行。\n言言语语空相忆，苦苦频频更寄将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其一一三","author":"孙蕡","text":"别恨过于别绪浓，背身斜着倚东风。\n庭前偏是春花树，树树花开枝上红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其一一四","author":"孙蕡","text":"对月临风不自由，都缘触景便生愁。\n春来总是相思夜，夜夜相思月满楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其一一五","author":"孙蕡","text":"暗卜街头好几回，连连去语道来来。\n当楼素月明于练，一任房栊彻夜开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其一一六","author":"孙蕡","text":"灵鹊朝来噪屋山，奚童先背锦囊还。\n银鞍隐隐穿青柳，珠泪滋滋湿玉颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其一一七","author":"孙蕡","text":"春铅数日不曾施，贴翠涂黄只半时。\n为报小环休写月，且教留着澹双眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其一一八","author":"孙蕡","text":"相逢错愕喜伤神，临到相亲且未亲。\n清夜已凉犹秉烛，对君疑是梦中人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其一一九","author":"孙蕡","text":"执手翻成喜极悲，到来呜咽泪沾衣。\n流光去去不相待，落尽春红君始归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]