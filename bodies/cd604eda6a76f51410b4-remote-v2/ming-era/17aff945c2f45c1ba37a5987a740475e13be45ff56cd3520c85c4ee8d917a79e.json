[{"title":"顾山人寿诗","author":"严嵩","text":"最忆芜城车马地，草堂花竹净风烟。\n地偏廛市同真隐，貌古衣冠似列仙。\n清爱碧箫吹海月，静看玄鹤舞芝田。\n绿蒲青艾俱生色，岁岁开尊午日前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33567,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱润轩寿","author":"严嵩","text":"他乡献寿逢新岁，同里相过总近亲。\n行乐不妨时序改，交驩惟有酒杯频。\n岸花樯燕能留客，对水看山不负春。\n闻说挥金多义事，江城无限待餔人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33568,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐氏东园观梅","author":"严嵩","text":"东阁开筵雪树春，主情花意共清真。\n似怜标格初经眼，自识芳香久袭人。\n鸑鷟故移天上种，珊瑚不受世间尘。\n习池宾客俱名胜，雅尚从知德有邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33569,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜雨 其一","author":"严嵩","text":"南国夏无雨，钟山朝出云。\n精虔三日祷，甘澍万家分。\n野爱商羊羽，池怜蜥蜴群。\n康衢今日颂，一饭是吾君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33570,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜雨 其二","author":"严嵩","text":"卧闻清雨至，萧飒浣烦襟。\n开轩进荷气，闭院静驺音。\n凤沼流泉细，彤楼隐雾深。\n隐几听脩竹，何异在中林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33571,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜雨和胡都宪","author":"严嵩","text":"沾席敲窗慰客心，院池新水坐来深。\n烦襟正解尘中渴，好事如听谷里音。\n霮䨴总随和气洽，萧森时逐远风沉。\n天公只借须臾力，明日郊原看绿阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33572,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜雨和汪宗伯","author":"严嵩","text":"怅望星河作夜晴，晓闻零雨度高城。\n乍迷云岫氛氲合，乱入槐轩淅沥鸣。\n正有清凉破炎毒，可无新句答高情。\n郊原明日堪携酒，自喜吾兼吏隐名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33573,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜雨和秦宗伯","author":"严嵩","text":"焦枯何计讹吹嘘，一雨全胜万斛珠。\n看舞商羊应得意，听鞭蜥蜴最怜渠。\n凉开竹簟眠方稳，日饭盘蔬味自腴。\n志喜有诗传画省，巴人惭和郢歌馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33574,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜雨和郭司业","author":"严嵩","text":"入秋忽听翻江雨，长夏空瞻落槛云。\n顿失尘熇净如洗，乍迷山翠杳难分。\n民情正望仓箱富，神荐犹凭黍稷芬。\n更喜清凉慰幽独，简编遥夜坐膏焚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33575,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠友 其一","author":"严嵩","text":"大江渺千里，金陵丽五云。\n枉棹特垂访，念子意何勤。\n久客怀故知，相见各欣欣。\n且复话乡邑，不厌穷朝曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33576,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠友 其二","author":"严嵩","text":"留都罗群署，词林最萧閒。\n古屋荫槐柏，时见檐前山。\n图史纷座隅，披玩豁心颜。\n与子坐永日，清风竹珊珊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33577,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠友 其三","author":"严嵩","text":"北风吹层波，高帆疾于马。\n矫首望云山，日夕到乡舍。\n亲友慰远归，春杯正堪把。\n故园多所欢，薄宦何为者。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33578,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"简尚宾将归赋赠","author":"严嵩","text":"相留忽是一年期，落叶西风话别时。\n宾馆寂寥寒榻在，吏情凉薄故人知。\n舟冲雾雨帆飞远，书忆乡园雁到迟。\n明日古槐修竹里，玉亭吟坐复同谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33579,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠叶刑部","author":"严嵩","text":"把酒逢宵月，登车犯早寒。\n逶迤涉远道，日夕望长安。\n霜蹄看骥展，风翮羡鹏抟。\n以我僻居者，殷勤怀所欢。\n迟归秣陵署，高咏对云峦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33580,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴司空旧家嘉鱼有东湖徙居苍梧作东湖书院命予赋","author":"严嵩","text":"问讯东湖第，司空此卜居。\n清澜堪悟道，石室可藏书。\n野绿开裴阁，花香引邵车。\n苍梧转奇胜，风景似嘉鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33581,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题罗太守画 其一","author":"严嵩","text":"何处林居好，移来庭壁间。\n风泉留喷薄，云峤锁孱颜。\n溪忆浮槎到，峰疑采药还。\n郡斋收印坐，知尔饱看山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33582,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题罗太守画 其二","author":"严嵩","text":"溪山尽瑶素，晓霁更宜人。\n不悟梁园雪，虚疑芳树春。\n剡舟乘兴逸，郢曲和歌新。\n怀君当此夕，难浣渴心尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33583,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"聂君持梅雪卷请题走笔赠之","author":"严嵩","text":"鹭沙尺书何日传，聂君近泊金陵船。\n到门览剌丞出迓，丰度雅朴神翛然。\n书云此君乐幽尚，十年寄迹江湖边。\n平生爱梅有真癖，梅雪自号争清妍。\n琼姿绰约种万本，茅屋正在春风前。\n芒鞋缓步石径月，拄杖独往青林烟。\n有时临流发孤啸，风致髣髴疑逋仙。\n只宜跨驴学肩耸，那复骑鹤思腰缠。\n青蚨沽酒与之醉，散发岸帻歌青天。\n吁嗟聂君亦不俗，挥毫赠尔梅花篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33584,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无锡茹氏惜阴楼其先世所创民泽请题","author":"严嵩","text":"茹翁读书处，高楼名惜阴。\n捲幔灯烟在，开轩草带深。\n古人勤志业，我辈得规箴。\n为诵陶公传，千秋见苦心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33585,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬陆司业见寄秋怀之作 其一","author":"严嵩","text":"书囊药裹镇吾随，岐路东西岂预期。\n多病祗怜癯骨在，素心惟荷故人知。\n游鱼远水书难寄，碧树高云意每迟。\n鳌禁掖垣追逐地，独惭虚薄□恩私。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33586,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬陆司业见寄秋怀之作 其二","author":"严嵩","text":"云海沧茫隔凤台，两年刚得一书回。\n敢将胶漆期君并，莫为阴晴与世猜。\n往日诗篇常在把，几时尊酒定重开。\n龙山又是茱萸节，珍重登高作赋才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33587,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登金陵观音山","author":"严嵩","text":"江阁凭虚似幻成，绿崖苍壁有人行。\n波晴日抱鼋鼍窟，天险山围睥睨城。\n万里涛泷争赴海，八?琛帛尽朝京。\n谁能数到层轩坐，临水看云失宦情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33588,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和顾东桥宪长游天界寺之作","author":"严嵩","text":"素衣不受市尘侵，虚谷超遥见此心。\n苔径客吟猿鹤挣，石床僧定薜萝深。\n高贤有意依莲社，开士何年建鹫林。\n更借玉琴酬雅兴，欲凭瑶草寄幽寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33589,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄寿高仰峰先生 其一","author":"严嵩","text":"勋业三朝重，年龄八帙高。\n名应书汗竹，寿及荐蟠桃。\n天远冥鸿迹，池新綵凤毛。\n圣明颁异宠，赐诰贲林皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33590,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄寿高仰峰先生 其二","author":"严嵩","text":"乡里论耆旧，惟公五福完。\n寿乡馀日月，宪府重衣冠。\n老鹤昂仙骨，贞松耐岁寒。\n青云誇令子，更折桂枝看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33591,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄寿高仰峰先生 其三","author":"严嵩","text":"昔奉秋堂宴，今歌云海篇。\n追趋怀杖履，瞻望礼星躔。\n台傍重门近，洲分碧水连。\n秫田新报熟，歌醉入丰年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33592,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蔡氏浚永阡","author":"严嵩","text":"露草眠牛集，云松吊鹤来。\n黄山开碧嶂，蒿里閟层台。\n哲士今亡矣，高风日远哉。\n渊源寻旧德，梁木叹遗材。\n不见丘原起，惟馀风树哀。\n诸孙寒食里，日暮奠椒回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33593,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉送太宰杨公赴召","author":"严嵩","text":"象德家声远，登贤国论公。\n泰应占世运，圣巳识渊衷。\n听履星辰切，持衡水鉴同。\n构堂资柱石，补衮藉山虫。\n熙洽隆殷祚，高明达舜聪。\n平章均四海，峻绝冠群工。\n霖雨收舆望，丹青肖祖风。\n四朝推练达，一节想清忠。\n播物鸿钧大，抡材杞梓充。\n山涛能荐士，王旦不言功。\n猷告宁闻外，谟询待折中。\n正容亡憸侧，轸虑切瘝痌。\n祖席逢秋净，王畿属岁丰。\n竞看威凤集，周雅咏梧桐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33594,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送汪吏侍先生","author":"严嵩","text":"叨随钟阜瞻依近，怅别江波跂望劳。\n长奉清言过玉署，重闻仙步上铨曹。\n时艰静曙纡筹定，国议新陪出论高。\n愿坐庙堂同水镜，总收贤俊入甄陶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33595,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至日信州怀寄汪石潭宗伯 其一","author":"严嵩","text":"至日题诗信州驿，泊舟虚馆近寒汀。\n江潭岁晚蛟龙蛰，岩壑霜馀桧柏青。\n鸣玉尚思金殿直，移文深忆草堂灵。\n谢公正在东山畔，日对云峰看翠屏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33596,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至日信州怀寄汪石潭宗伯 其二","author":"严嵩","text":"天畔登台望北辰，三回巳隔御筵春。\n冰霜暗惜年华老，棋局频看世事新。\n安得梅花逢驿使，欲凭瑶草寄佳人。\n白鸥片片风湍急，捩柁冲星下远津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33597,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弋阳遇赠舜卿翰检兼寄用修殿撰 其一","author":"严嵩","text":"京国何时出，舟航此地逢。\n批鳞叩龙阙，塌翼下鳌峰。\n天地生全德，江湖汗漫踪。\n相留话今夕，明发楚云重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33598,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弋阳遇赠舜卿翰检兼寄用修殿撰 其二","author":"严嵩","text":"两贤俱侍从，万里各风埃。\n鸟道青冥外，谁怜逐客来。\n醉歌频击剑，愁望且登台。\n珠树同栖鹤，蓬山迟尔回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33599,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送凌司训","author":"严嵩","text":"沅湘从此去，孤棹雨冥冥。\n烟屿宜春望，林猿足夜听。\n青云谁假翼，白首叹穷经。\n明日河阳酒，思君草色青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33600,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨泊凤洲酬寄朝望太守 其一","author":"严嵩","text":"厌听高城雨，还维古驿舟。\n琼枝那近眼，烟浪递生愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33601,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨泊凤洲酬寄朝望太守 其二","author":"严嵩","text":"鸦湿波翻木，鸥喧雨满洲。\n离心何处是，暝色载孤舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33602,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨泊凤洲酬寄朝望太守 其三","author":"严嵩","text":"凤洲几回至，一至情眷眷。\n佳期渺未忘，薄别宁当怨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33603,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨泊凤洲酬寄朝望太守 其四","author":"严嵩","text":"山阁忆春临，渚花宜晚望。\n不共瀼西游，空怀郢中唱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33604,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游洪阳洞","author":"严嵩","text":"鹤驭鸾骖去不回，林扃岫幌客频来。\n洞门日照烟萝发，岩窦泉飞雪屋开。\n始惊奇僻非人境，更爱攀临坐石苔。\n回舆出谷千峰暝，猿啸禽啼万壑哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33605,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓济鄱阳湖","author":"严嵩","text":"鸣榔发荻浦，击楫过蘋洲。\n皛皛霞日烂，盈盈天汉流。\n远帆征未息，高鸟去何求。\n汗漫江湖志，吾今几度游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33606,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泊弋阳江","author":"严嵩","text":"客思增悽断，风湍渺宿留。\n云来津树黑，雨集浦帆收。\n作宦逢杨闰，辞家感麦秋。\n龟峰岚雾里，心赏若为酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33607,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夕会顾宫谕兄姑苏驿下","author":"严嵩","text":"共怜挥手别鳌峰，烟水吴洲此夕逢。\n世事秪应论塞马，春雷正合起潭龙。\n坐阑红烛谈犹健，折赠琼枝意自重。\n借问昔时鸳鹭侣，几人同听凤楼钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33608,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"姑苏王少傅怡老园子贞中舍邀集","author":"严嵩","text":"宛似入鸡山，寥寥云壑间。\n攀松上岩翠，憩石坐苔斑。\n霄汉清班接，林园乐事关。\n昔游陪剑履，辉赫想台颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33609,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怡老园后池集","author":"严嵩","text":"竹径萝烟翠且重，行寻幽洞失前峰。\n因攀岩下丛生桂，故识云中旧种松。\n楼台碧水虚相映，车马高门日自容。\n犹道绿尊欢未尽，别来深院起歌钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33610,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虎丘临眺和朱侍御 其一","author":"严嵩","text":"泊舟禅径石门通，徙倚湖天望不穷。\n正扫书坛拜和靖，犹开梵塔礼生公。\n汀洲晚浸蒹葭水，台殿晴呼松柏风。\n惟羡观风骢马使，清游丽句满吴中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33611,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虎丘临眺和朱侍御 其二","author":"严嵩","text":"翠岭晴烟锁鹫峰，玉泉阴洞隐龙宫。\n高攀双树青冥上，俯瞰三吴宿雾中。\n沙浦断云低度鸟，石林修竹静吟风。\n禅房水石佳游在，尘世沧桑浩劫空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33612,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题悟石轩旧传生公说法石为点头轩以是名","author":"严嵩","text":"盘石寺门前，相传听法年。\n袭讹僧善幻，赏胜客犹怜。\n松桂流寒月，藤萝起夕烟。\n未须谈寂理，聊此息尘缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33613,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋少宰汪公西溪草堂","author":"严嵩","text":"山辉知玉韫，渊静识龙居。\n古邑名贤里，膺门幸到予。\n开堂瞻剑履，登阁览清虚。\n积翠罗千嶂，分流贯二渠。\n夕云生画障，春水动鸥鱼。\n庭爱森琼树，门看拥驷车。\n玉床留贮笏，丹壁会藏书。\n直道中朝仰，高名北斗如。\n凤凰需宠诏，萝月卧林庐。\n理惬心弥逸，神閒体自舒。\n萍游奉佳论，临别意踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33614,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"盘谷歌为司寇高公赋","author":"严嵩","text":"乐清山水天下奇，中间茗屿更逶迤。\n坤灵勃郁萃元气，何人卜筑开新基。\n高公百年草堂在，林色川容未曾改。\n地隔桃源长子孙，村标盘谷名江海。\n盘谷幽栖自隐君，后人济济藉芳薰。\n一溪桑梓横青野，九畹兰荪结綵云。\n堂下阴森满松柏，风雨泠泠护幽宅。\n岁时蘋藻荐明馨，阶前半是朱衣客。\n司寇承恩著锦袍，江山掩映罗旌旄。\n后来杰出况非一，上下彩凤看翔翱。\n礼成叙饮复酬倡，接盏飞觥各相向。\n里闬风猷出故家，朝廷礼乐归群望。\n吁嗟乎湛恩馀庆奕世存，路人尽识于公门。\n请君试听歌盘谷，昔日三槐安足论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33615,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题胡使君可泉","author":"严嵩","text":"秦安卦山北，相传有异泉。\n胡公读书处，钓月弄潺湲。\n漱玉云根净，牵萝雪瀑悬。\n夜弦翻雅调，春瓮泻芳涓。\n江海覃馀泽，山林结挣缘。\n鉴澄心比瑩，膏润暍同蠲。\n地以高贤胜，图将美迹传。\n次山文笔健，岩石几铭镌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33616,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"经筵进讲毕还至国庠会寮属诸生听讲","author":"严嵩","text":"翠华仙殿说经回，冠带桥门讲又开。\n岂有涓埃禆圣学，独惭模范育英才。\n云龙嘉会逢明代，奎壁祥光应上台。\n听诵唐虞风噩尔，载歌琴瑟思悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李若溪佥宪","author":"严嵩","text":"别君南国若为情，聚首无端复送行。\n同里衣冠知己少，外台风纪拜官荣。\n桄榔夜宿蛮中驿，金鼓晴登岭外城。\n儒术古来经世用，直看尊俎坐谈兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送罗南康使君","author":"严嵩","text":"犹烦领郡赴江干，千里南州路未难。\n遗爱旧栽棠树遍，别怀今放酒杯宽。\n山深洞可寻名迹，家近书能慰母欢。\n见说府中公事简，五峰苍翠倚楼看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠柳州桂二守","author":"严嵩","text":"南登桂岭道，却上楚乡舟。\n赋就江篱晚，书回旅雁秋。\n山形攒剑戟，方语杂旃裘。\n好种江边柳，还将惠化留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠简少府二首 其一","author":"严嵩","text":"客舍依莲宇，清风满竹林。\n愧予怀短剌，长喜得幽寻。\n旌节梁园迥，云山楚甸深。\n别离明月共，千里寄同心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠简少府二首 其二","author":"严嵩","text":"尔向滇中去，官程柰远何。\n云峰当马峻，雾树听猿多。\n郡僻逢迎简，天南气候和。\n相期敷惠政，早入远人歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠郑南昌复官昔与逆藩之难","author":"严嵩","text":"黄绶欣看复在身，却论前事益沾巾。\n江关乱后馀残垒，棠树春来泣故民。\n人情阅世从翻覆，直道怜君有屈伸。\n巳喜拜恩同雨露，可堪回首忆风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大理汤公寿词","author":"严嵩","text":"廷尉当朝彦，荣名晚节全。\n棘堂卿月回，天署法星悬。\n魏阙班频入，巴山使久旋。\n边陲经略后，旒冕对扬前。\n议政过松掖，听经侍翠旃。\n礼看优宠渥，貌不怠恭虔。\n利锷馀盘错，贞松阅岁年。\n书云逢令节，弥诞秩初筵。\n却老传真诀，阴功格上玄。\n于公曾活狱，贡禹解惟贤。\n宅荫宫槐近，窗迎海日先。\n愿言跻寿域，长此奉尧天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵司空致政","author":"严嵩","text":"嶷然冠剑汉司空，出入三朝操履同。\n事忤贵人知节槩，心忧王室见清忠。\n俞章赐允皇仁大，荐剡留贤物论公。\n遥羡高踪去尘网，云霄万里一冥鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送秦司徒致政","author":"严嵩","text":"履声长听殿东墀，祖席春明是别时。\n去国二贤舆论惜，登庸八座大名垂。\n云霄路隔冥鸿远，江渚情牵碧草思。\n莫谓东山成稳卧，苍生应有谢公期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郑刑部之南京","author":"严嵩","text":"人事无端类转蓬，更劳分署过江东。\n三年卧病烟霞隔，尊酒逢君笑语同。\n地胜湖波浮几席，秋深庭菊傲霜风。\n芜城亦是桑乾路，望近桥陵紫翠中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴学士视篆南京予旧领此职","author":"严嵩","text":"二年相逐喜同声，几度尘沙并辔行。\n新握院章当妙选，重吟江树动离情。\n蓬瀛地接金銮近，城阙天开晤嶂清。\n借问旧堂脩竹在，壁间虚薄愧题名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈监丞父寿词","author":"严嵩","text":"寿酒新开秋露盘，草堂高隐碧云端。\n花边玉杖閒堪拄，箧里丹经老自看。\n济郡伏生还授学，鹿门庞叟只遗安。\n胶庠有禄能分养，恬淡无心羡达官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]