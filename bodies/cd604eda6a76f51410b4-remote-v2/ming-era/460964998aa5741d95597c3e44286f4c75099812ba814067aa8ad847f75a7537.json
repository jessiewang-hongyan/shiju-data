[{"title":"白云山楼中 其一","author":"叶春及","text":"高山心自下尘寰，复有南楼在此间。\n閒坐楼中门尽辟，白云朝去暮来还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白云山楼中 其二","author":"叶春及","text":"白云朝去暮来还，一去一来俱在山。\n十载离家不知返，而今始觉泪痕斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13847,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白云山楼中 其三","author":"叶春及","text":"下山云雨上山晴，谁道山云亦有情。\n却似道人心一片，无来无去又无生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13848,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白云山楼中 其四","author":"叶春及","text":"不携尊酒上山来，只酌龙泉水一杯。\n泉水自清人自酌，不愁心地有尘埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13849,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白云山楼中 其五","author":"叶春及","text":"下山却是上山泉，欲饮还须在水源。\n不信诸君泉上看，千条万派落前川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13850,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白云山楼中 其六","author":"叶春及","text":"高坐楼中云作衣，夜来亲见郑安期。\n无情最是峰头鹤，不为游人住少时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13851,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题石山船二首 其一","author":"叶春及","text":"石船高驾碧山头，似畏风波急暮流。\n十二时中平地起，问君何处不堪愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13852,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题石山船二首 其二","author":"叶春及","text":"木兰为楫桂为桡，南接端明学士桥。\n我自虚舟人不识，海门风雨日潇潇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13853,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七月晦日同诸子大雨游三髻山鼓御风之章 其一","author":"叶春及","text":"千山雷雨震天门，万壑飞流万马奔。\n莫道游人魂欲断，瑶琴石室倒琼樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13854,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七月晦日同诸子大雨游三髻山鼓御风之章 其二","author":"叶春及","text":"秋衣重湿海天寒，秀色三峰雨里看。\n却恨多情逢佚女，双鬟犹自隔云端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13855,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七月晦日同诸子大雨游三髻山鼓御风之章 其三","author":"叶春及","text":"足下层崖万仞悬，耳边危石一藤牵。\n白云冉冉如无地，宿雨濛濛只有天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13856,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠罗浮吴道士","author":"叶春及","text":"羽人绛节自云中，四百峰头访葛洪。\n他年天柱如相见，玄鹤飘飖舞碧空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13857,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柯节妇诗 其一","author":"叶春及","text":"盘石空庭对不移，始知青镜妒蛾眉。\n子规枝上三更血，好似闺中齧指时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13858,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柯节妇诗 其二","author":"叶春及","text":"太守新题照画梁，霜风飒飒满清漳。\n汝家正在罗溪上，一水沿洄万里长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13859,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠汝诚应贡北上 其一","author":"叶春及","text":"南来梨岭万重山，绿绮逢君一解颜。\n满院梅花开不尽，朔云春树又燕关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13860,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠汝诚应贡北上 其二","author":"叶春及","text":"翠壁苍云锦绣开，夜凉萝月满松台。\n思君不见梅溪上，惆怅天风万里来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13861,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠汝诚应贡北上 其三","author":"叶春及","text":"万国儒绅肃鹭行，九天阊阖觐龙光。\n东连碣石悬鳷鹊，南度秦淮有凤凰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13862,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠汝诚应贡北上 其四","author":"叶春及","text":"九衢车马日辚辚，君去初充上国宾。\n纡紫昔无安世贵，草玄今有子云贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13863,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠汝诚应贡北上 其五","author":"叶春及","text":"排云曾奏万言书，无奈天阍独望予。\n汉室有人询贾谊，幽兰依旧结芳裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同李宗阳泛西湖招侄男兆不至口占促之时年十五","author":"叶春及","text":"西湖之水多白蘋，白蘋映水摇乌巾。\n山花水花两灿烂，君若不来花笑人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答真空上人 其一","author":"叶春及","text":"佛氏生憎五蕴山，须弥原只在人间。\n我今出世君知否，九万扶摇一日还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答真空上人 其二","author":"叶春及","text":"有中说有还归有，无里谈无又著无。\n我把此言来印證，恰如明月照江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13867,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赏报","author":"叶春及","text":"家住青山学隐沦，偶来相访武夷君。\n铁桥流水不归去，肠断清猿和白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洛阳望三髻山","author":"叶春及","text":"云锁三峰霁未开，空馀三髻象三台。\n舆人遥望遥相语，昨日亲曾云里来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宏路道中","author":"叶春及","text":"日入虫鸣草露凉，海风吹月月苍苍。\n邮亭处处看相似，高隔松林十里长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"峡江渡","author":"叶春及","text":"峡江亭前秋叶多，峡江渡口足风波。\n知君急渡如江水，帆影先开奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13871,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题茶洋驿清风亭","author":"叶春及","text":"隔树蝉声度翠屏，穿林涧水倚栏听。\n行人一到扬镳去，惟有清风恋竹亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13872,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别韦纯显赴泰和 其一","author":"叶春及","text":"书剑同游二十年，柳丝长绾万条烟。\n天涯落魄愁分手，君向西江我在燕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13873,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别韦纯显赴泰和 其二","author":"叶春及","text":"潞渚帆开独滞留，燕山尘满黑貂裘。\n愁来已就祢生赋，为我先投鹦鹉洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13874,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别韦纯显赴泰和 其三","author":"叶春及","text":"南游同唱郢人歌，楚水闽山路几何。\n欲向天涯寄杨柳，祇怜攀折已无多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13875,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别韦纯显赴泰和 其四","author":"叶春及","text":"三忠祠在上东门，古道飞沙白日昏。\n唯有前朝松柏树，霜枝聊可赠王孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13876,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朝斗坛步月","author":"叶春及","text":"太乙宫前月满时，沧波万顷碧琉璃。\n手持玉笛瑶坛上，吹起凌空锡杖飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵答林中洲见问 其一","author":"叶春及","text":"寒烟蔼蔼雨霏霏，草绿江南春未归。\n满树桃花君莫问，道人今已学无为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵答林中洲见问 其二","author":"叶春及","text":"独坐炉薰对雨霏，閒看川逝共云归。\n主翁欲问惺还否，何处惺惺更问为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"友人约赴佛会诗以答之","author":"叶春及","text":"便随大众说西天，莫以焚香种福田。\n白鹤峰头一长啸，不知谁是野狐禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十四岁读书永福寺友人伐鼓七声命诗索道士酒","author":"叶春及","text":"远公昔日东林寺，有酒曾呼靖节来。\n今夜虎溪须尽醉，莫教明月照空杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"艾如张","author":"温纯","text":"郁郁灌木，众鸟嘤嘤。\n临深酌酒，亦可怡情。\n有鸟有鸟，鷕鷕其鸣。\n厥德耿介，厥质文明。\n嗟贾如皋，但慱偶声。\n恐逢鸷鸟，触树致惊。\n以媒下翳，以艾藏形。\n庶几我获，为吾友生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"战城南","author":"温纯","text":"战城南，敌可灭。\n矢及远，马如铁。\n火齐炽，水立绝。\n愤乘骄，鼓待竭。\n卫霍生，左贤折。\n饥餐肉，渴饮血。\n幕南空，汉耻雪。\n战城南，敌可灭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五杂俎 其一","author":"温纯","text":"五杂俎，酝盈瓿。\n往复还，脱巾走。\n不得己，刃及首。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五杂俎 其二","author":"温纯","text":"五杂俎，城半虎。\n往复还，士女残。\n不得已，郊多垒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五杂俎 其三","author":"温纯","text":"五杂俎，勾远部。\n往复还，帐满山。\n不得巳，城环水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五杂俎 其四","author":"温纯","text":"五杂俎，卯历酉。\n往复还，耦尽掊。\n不得已，楼火起。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13887,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五杂俎 其五","author":"温纯","text":"五杂俎，南城促。\n往复还，矢相属。\n不得已，自屠戮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13888,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"昭君怨","author":"温纯","text":"长门回首泪盈襟，琵琶只弹薄命吟。\n休问丹青受金否，丹青得无用意深。\n君王万几日日有，忍令粉黛惑其心。\n况因丹青力，暂受君王恻。\n和戎苟有利，在胡犹在国。\n一时丹青手，但易妍媸色。\n古来更有如簧舌，鹿可为马白可黑。\n吁嗟乎鹿可为马白可黑，如此丹青杀亦得。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13889,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自君之出矣 其一","author":"温纯","text":"自君之出矣，昼永夜如年。\n芳草随时绿，秋月几回圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13890,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自君之出矣 其二","author":"温纯","text":"自君之出矣，梦中笑语并。\n既醒还思梦，复恐梦难成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自君之出矣 其三","author":"温纯","text":"自君之出矣，孤枕夏犹寒。\n况闻沙塞苦，秋冬衣又单。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自君之出矣 其四","author":"温纯","text":"自君之出矣，新人易为欢。\n丁宁语新人，莫令藁砧寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"公无渡河","author":"温纯","text":"公无渡河。\n陆行坦坦，尚有风波。\n河水不测，盘涡实多。\n深不可厉，内藏鼋鼍。\n得人则食，不知其佗。\n公无渡河。\n虽有舟楫，吞舟奈何。\n长年辟易，如见网罗。\n不如安卧，饮酒高歌。\n公无渡河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪怀并引 其一","author":"温纯","text":"计偕试南宫，遂上公车对。\n时当世太平，内外争尽瘁。\n穆穆肃皇圣，主静勤修内。\n怀柔慑万灵，纳言收中贵。\n惩贪更训廉，信赏罚无贷。\n嘉靖殷邦同，久道万方赖。\n至今思祖功，父老犹垂泪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪怀并引 其二","author":"温纯","text":"筮仕令北海，海上半凋瘵。\n初至百忧丛，视事忘向晦。\n出入童稚眠，徒为簿书累。\n亦慕卓鲁名，愧非学道爱。\n别来三十年，父老犹虚戴。\n补过恨无繇，此任不更再。\n寄语为令者，毋如余徒慨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪怀并引 其三","author":"温纯","text":"三年频于役，凭轼临沧海。\n徙倚蓬莱间，几席扶桑在。\n始觉眼界宽，西望极畏垒。\n天浮日永浴，雁迷岸分彩。\n归泄无盈虚，百川于此汇。\n始作卢敖游，高鸟惭意怠。\n回陟大泽山，日观峰未改。\n呼吸圆䆸通，应接汗流浼。\n归来爽自失，蜗居从前悔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪怀并引 其四","author":"温纯","text":"西征将之济，延颈问阙里。\n泰山高万仞，龟蒙亦难儗。\n有阜迂以曲，沂济文相似。\n卦列少昊陵，钟灵自此始。\n祷尼应如响，顶圬生夫子。\n匹夫祖尧舜，千载崇庙祀。\n荆棘故不生，异木森且美。\n当时手植桧，荣枯关泰否。\n呵护烦神明，感通有至理。\n低佪瞻拜馀，一贯如面拟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪怀并引 其五","author":"温纯","text":"庄皇初践祚，首重言官路。\n徵书罗四方，召从诸彦后。\n左掖拜夕郎，白简容敷奏。\n一时颂恭默，纳约无庸牖。\n渊哉尼父言，无为真圣度。\n升遐胡太蚤，遗弓泣宇宙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪怀并引 其六","author":"温纯","text":"朱明景风至，衔命之沈代。\n言陟天下眷，历晋出雁塞。\n上党文物集，朱门多风槩。\n沁水主人奇，论文出流辈。\n踟蹰马邑城，追慨诈为害。\n云中节至止，带砺盟千载。\n邂逅赵将军，英声无与佩。\n接武渭阳周，出师敌辄北。\n养士与双眼，屈指名仅再。\n赖有刘都督，三捷威仍倍。\n今为连炮雷，一发敌尽碎。\n省卒更省饷，不战功尤最。\n先声屈人兵，庶以威为爱。\n乃知禦侮策，全胜在修内。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪怀并引 其七","author":"温纯","text":"驱车之荆楚，暂憩习家池。\n西忆羊叔子，山有堕泪碑。\n言寻云梦泽，荒迷不可知。\n江汉依然在，皞皞濯于斯。\n朝登黄鹤楼，暮倚鹦鹉陂。\n再过巴陵道，不禁先忧思。\n一著归来赋，远谢叔子规。\n梦濯缨与足，如在江之涯。\n仲尼不可尚，千载是吾师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪怀并引 其八","author":"温纯","text":"归溯汉水西，言陟太和巅。\n太和高万丈，乌兔疑倒旋。\n诸峰亦儿孙，五岳岂比肩。\n中多学道侣，相与證真诠。\n真诠何可得，依稀守丹田。\n夜梦玄帝语，鼓琴宁俟弦。\n汝归有馀师，汝师言更玄。\n无思与无为，斯言信不偏。\n北面终邹鲁，庶几永无愆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪怀并引 其九","author":"温纯","text":"繇郧入商于，驱车历木末。\n蜿蜒七百里，天近海疑括。\n昆崙于此终，太华势相夺。\n坤厚信无疆，钟灵及辽阔。\n姬历八百年，贤圣实超越。\n历代饶荃宰，宇宙任旋斡。\n晚近忽荡潏，絪缊气疑脱。\n郁积端倪开，地维竟轩豁。\n君子期法坤，厚德以载物。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪怀并引 其十","author":"温纯","text":"入里返初服，垂涕拜亲闱。\n二亲方耆寿，偕隐共采薇。\n春秋耕南亩，不愁寒与饥。\n弟童儿方丱，挟册亦爱晖。\n岁时延宾友，欢宴愿无违。\n但怜姊与妹，各弃扊扅归。\n解郁开春酒，始幸早拂衣。\n有甥跪罗列，庶免永歔欷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪怀并引 其十一","author":"温纯","text":"壬申冬拜命，乘春临大河。\n次且崤崡道，踟蹰雒之涯。\n默思图与书，千载永不磨。\n渊哉坎之一，万象已森罗。\n五十数非阙，载籍文何多。\n南北滋路岐，杨子泣奈何。\n所以鲁尼父，无言欲回波。\n观象登道岸，守一更无他。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪怀并引 其十二","author":"温纯","text":"迤逦临熊耳，从郏及申宛。\n遵彼汝坟境，追思王化远。\n言驻隆中轸，问俗频往返。\n恨无随车雨，腼颜如餐饭。\n有召及吾师，孙公节再建。\n铜堤竹马迎，云公来何晚。\n当年羊叔子，步武尤蹇蹇。\n余在约束中，依旧炙经苑。\n会有二三子，因依共勤恳。\n忽为参与商，回首空缱绻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪怀并引 其十三","author":"温纯","text":"时值大渊献，囧命以绿绶。\n入关过里门，北征将父母。\n伏陛瞻龙衮，端拱临星斗。\n余从典属国，再步廷尉后。\n旋总大官署，六礼亲奔走。\n喜遇泰交成，远近欢盈口。\n至今三十年，乾坤同悠久。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪怀并引 其十四","author":"温纯","text":"礼乐容台司，骏奔郊庙际。\n有友赵柱史，之楚正揽辔。\n久要故不忘，相期秉忠义。\n同歌蜀道难，并失南郡意。\n解组先后归，遂初泾峨内。\n潜修卒旧业，力耕供赋税。\n山林亦有责，报恩明不倍。\n目极日月边，如睹天颜霁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪怀并引 其十五","author":"温纯","text":"初宿邯郸署，偶闻邻妇啼。\n声声如有诉，多云有所思。\n不作双飞鸟，却为征夫妻。\n征夫妻犹可，边塞苦谁知。\n不愁衣带缓，但恐寄衣迟。\n砧杵家家急，贱妾心独悲。\n手纫衣未成，衣成附阿谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪怀并引 其十六","author":"温纯","text":"倚门有二亲，下车伏地拜。\n拭泪转开颜，问讯疑梦寐。\n乍聚忘远游，囊空反增爱。\n有美弱冠弟，青衿亦聪慧。\n随行兼问字，二亲欢更倍。\n东觅仙掌莲，西慕瑶池会。\n莲实犹可得，桃熟难更再。\n但酿清为圣，浊亦贤可待。\n蓂开柏叶进，菊绽桑落美。\n张筵聚宾从，门巷填车盖。\n余舞老莱斑，弟咏南山对。\n诸孙争进履，椿荣萱树背。\n有召忽临门，承欢仅六载。\n于今涕泪多，不忍见松桧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪怀并引 其十七","author":"温纯","text":"涒滩为帝理，再侍讲筵内。\n未几拜命行，捧敕临东海。\n二亲犹及将，扶侍供甘脆。\n王事信靡盬，不遑周仍隘。\n采莼更觅鲤，奉养敢云备。\n明王隆孝思，永言锡吾类。\n遵海望天台，偶与知己会。\n手染二亲容，驻颜语仍在。\n语及世上名，洗耳有真态。\n相期雁荡游，抚景尝至再。\n归署襟已豁，如在尘寰外。\n乃知乾坤里，形骸元无碍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪怀并引 其十八","author":"温纯","text":"吴山天然境，天目于此会。\n江海襟尝合，龙凤结仍大。\n钟灵更毓秀，都会千年在。\n一水临岛夷，所恃在武备。\n余乏安攘策，坐镇浑无赖。\n官联幸同心，但于簿书内。\n民瘼尚未瘳，何论沧溟外。\n有时陟吴巅，似与昆崙对。\n我屋居其间，视之仅如芥。\n恐为形迹拘，俯仰惭函盖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]