[{"title":"舟中望虞山","author":"吴宽","text":"蜿蜒平野卧青山，相见令人独厚颜。\n徒有诗篇曾记咏，已无筋力再跻攀。\n船头旋转凭黄帽，水面低徊拟翠鬟。\n旧日同游谁在者，欲从东老学清闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52624,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四野农歌","author":"沈海","text":"烟雨冥蒙昼景昏，农歌四野竞纷纷。\n东村群唱西村和，南陇余音北陇闻。\n麦秀新腔良有节，竹枝遗调本无文。\n不知帝力吾何有，击壤声中又夕曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52625,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"巡野舟行","author":"杨子器","text":"海虞城外晓扬舲，风景依稀似偃泾。\n风拂潭塘春雨细，柳遮吴塔午风轻。\n船场有酒频沽饮，罗坝无诗懒记程。\n笑指周泾浑不远，日斜无量晚钟鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52626,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与沈石田游西岩庄","author":"桑瑾","text":"西湖一曲入山遥，风送花香落酒瓢。\n行尽清溪方见寺，忽逢飞瀑又凭桥。\n家家茅屋霏茶霭，处处莺声在柳条。\n此夜东堂谁是主，抱琴僧渡夕阳舠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52627,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"见山楼题常熟陈亚参卷","author":"李东阳","text":"虞山青近东海头，正对元龙百尺楼。\n半山闲身刚得隐，四时佳景更宜秋。\n屐曾蹑后犹余齿，帘为看来懒下钩。\n倚遍曲阑人不见，断云飞鸟共悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52628,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石梅","author":"李杰","text":"仙馆高寒地，孤梅石罅生。\n西湖千万树，何似此株清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52629,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虞山迭翠","author":"王鼎","text":"山晕太古色，日高苍龙飞。\n吾生好观物，心赏与时违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52630,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题秋江图","author":"唐寅","text":"秋容淡荡满晴江，鸂鶒鸬鹚锦翼双。\n红蓼滩头黄叶下，炼诗人正倚船窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52631,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"维摩寺","author":"钱仁夫","text":"蔓草芊芊没寺门，墙根残剥已无文。\n败檐犹滴夜来雨，高树尚屯窗外云。\n佳境故容僧管领，禅床时许客来分。\n传虚且莫穿空谷，下有松间饮鹿群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52632,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵沈先生后游虞山初得奇境","author":"祝允明","text":"虎头只自爱吾庐，题赏应嫌此是初。\n大抵未容人独受，向来刚道妙无余。\n屏回窈窕金蕖净，帘挂玲珑玉液虚。\n却笑老禅终勘事，相逢先已口嘘嘘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52633,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花","author":"孙艾","text":"因春憔悴致神伤，眼见韶华渐减光。\n暮雨不堪淹久病，夕阳犹自整残妆。\n风情为酒迷花榭，春梦随诗入草堂。\n满把落英收拾尽，依方修合百花香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52634,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东林塔影","author":"屈翀霄","text":"带郭浮图佳气绕，笔峰雄峙镇城壕。\n九层突兀齐云耸，四面玲珑与日高。\n西北有无山掩映，东南隐现水周遭。\n书楼密迩文星照，会见英贤负气豪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52635,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"两湖开镜","author":"屈翀霄","text":"昆湖遥与尚湖通，二水中分两镜同。\n鸽现神光明照夜，蜃收余翳净涵空。\n帆樯互映斜阳外，鸥鹭交飞色界中。\n混沌直从开辟判，洗天浴日意无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52636,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拂水雪岩","author":"钱籍","text":"晓来飞雪满千山，人在悬崖断壁间。\n十里平湖诗思绝，攀萝侧耳听潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52637,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"福山观社","author":"顾鼎臣","text":"游人如蚁事如麻，街巷喧阗好物华。\n本藉神功能御捍，岂缘财力竞豪奢。\n威容赫奕开生面，供奉分明学内家。\n灯火满城歌吹沸，夜深林有未栖鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52638,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"尚湖即事 其一","author":"丁奉","text":"细草香时蝶舞，平波动处鱼跳。\n渡客行僧日暮，归云去鸟天遥。\n映水明霞似火，乘风急浪如潮。\n游泳须臾百里，扁舟短剑长箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52639,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"尚湖即事 其二","author":"丁奉","text":"绕室云闲似我，对溪山秃如僧。\n住宅碧筠黄树，生涯白藕红菱。\n午市归农负担，夜邻返棹呼灯。\n钓弋俱当此境，野翁靡所不能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52640,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虞山雅集","author":"杨循吉","text":"秋日来登云水堂，使君开宴兴何长。\n虞山胜赏在此处，名教清谈有几场？\n鼓瑟时时惊鸟下，推扉隐隐见湖光。\n夜深松竹皆含露，漫举金杯吸晚凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52641,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虞山三凤赠陈原习","author":"毛伯温","text":"三凤生非偶，苞文众所惊。\n远从丹穴出，一向阿巢鸣。\n日月回毛羽，云霄列弟兄。\n虞山高嵽嵲，不朽太丘名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52642,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝岩湾晚步","author":"桑翘","text":"我到山中日已西，山中灵籁足幽栖。\n两崖木落笼霜走，万壑云烟贴汉低。\n僧寺远临松径小，谷神虚应竹风凄。\n居民住久不知乐，愁绝黄昏虎豹啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52643,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚次虞山","author":"皇甫涍","text":"朝从虞阜出，终日爱溪行。\n鸥近看疑下，云归望若迎。\n岚昏作海气，风满助江声。\n莫恨三山隔，东看烟树平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52644,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"破龙涧","author":"王同祖","text":"破龙回绝涧，灵鹫倚修林。\n绀宇烟霞静，苍崖松柏深。\n虚无侵海色，云住引禅心。\n日夕山风冷，幽禽空好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52645,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吊蒋忠烈公","author":"陈察","text":"琴川有间气，志士钟其英。\n抗疏本忧国，临危肯爱生？\n天朝公道白，泉壤露华清。\n牢落寅恭后，空惭没世名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52646,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖田","author":"桑介","text":"春风吹柳花，春水泛芦芽。\n桑阴卧黄犊，老树啼乌鸦。\n清溪一湾路，大小五十家。\n处处挂渔网，湖水作生涯。\n少妇过桥去，携筐卖鱼虾。\n老翁卧树底，醉倒日西斜。\n爱兹湖上景，风水清且嘉。\n我欲移家住，湖中放钓槎。\n渔樵共我话，至乐何如耶！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52647,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"昭明读书台","author":"皇甫冲","text":"晴晖抱芳意，丛桂结遐忱。\n风光散繁蕙，云色留松阴。\n玩景陟书台，台石蘼芜侵。\n梁王悦坟典，兼之山水音。\n探奥坐萝石，咀藻登山岑。\n选学出名贤，炳焕为儒林。\n用物岂不弘，精爽亮难沈。\n恍惚烟云间，魂魄时自临。\n怀人允在昔，睹迹乃以今。\n愿修涧沚毛，一罄平生心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52648,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖桥夜泊","author":"杨仪","text":"捧酒篷窗月倍辉，夜深水竹风微微。\n野禽背霜忽振羽，山果落泉时溅卮。\n箬笠多情能恋我，钓丝遣兴不须归。\n醉来稳作芦花梦，两两眠鸥未肯飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52649,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题山城图","author":"文徵明","text":"虞山宛转带层城，正抱幽人旧草亭。\n朵朵芙蓉浮粉堞，团团桧影落疏棂。\n百年形胜夸天设，一代文章属地灵。\n长日振衣穷眼望，杖头云气接沧溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52650,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲寅二月廿一日宿常熟城外","author":"文徵明","text":"琴川落日水粼粼，回首重来十二春。\n山色依稀乌目旧，风烟惨淡白头新。\n倚空雉堞森城守，满城戎衣感戍尘。\n独有堰泾堤上柳，依依临水似迎人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52651,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题维摩庵","author":"周诗","text":"白云藏古寺，钟磬出东林。\n殿覆千年树，台封百尺阴。\n一灯悬慧照，片月见禅心。\n愿受维摩戒，空山理梵音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52652,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆尚湖","author":"孙楼","text":"却忆西湖上，澄波宛镜中。\n短桡芦荻月，长啸芰荷风。\n浮碧三千顷，来青十二峰。\n如何辞胜赏，三载迹飘蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52653,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日泛舟过朗城庵","author":"严讷","text":"孤舟兴不浅，日暮浮方塘。\n抚景自斟酌，击榜歌沧浪。\n秋水连天碧，清风传桂香。\n渚鸥闲自得，狎我为翱翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52654,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨后桃源涧观泉","author":"陈瓒","text":"虹敛空山后，龙萦曲涧吟。\n响随风树远，气接海涛深。\n一片烟霞地，百年泉石心。\n空林归客散，幽径落寒砧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52655,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虞山","author":"董嗣成","text":"驾发吴城隈，言臻琴川路。\n触炎振短策，凌虚纵遐步。\n幽崖转盘纡，苍林莽回互。\n翠屏千余仞，虬螭肆蹲踞。\n嵌空标玲珑，错采变晨暮。\n巧岂椎凿功，力由神物护。\n穷岩缀玄珠，飞泉喷深树。\n随风奏宫商，映日炫丹素。\n疑兹琼瑶宫，诧彼仙灵住。\n因崇访道心，亦资济胜具。\n悠然遇安期，逍遥陟玄圃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52656,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大石山房","author":"孙七政","text":"结客中林伴，寻芳曲水濆。\n众山留暮雨，孤壁断春云。\n藉草飞英遍，探泉小洞分。\n不堪王逸少，今日惜离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52657,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桃源涧","author":"瞿汝稷","text":"丹溪碧磴到来幽，遥听潺湲落岭头。\n桃夹云泉环曲径，松围石室倚寒流。\n禽声每集弦歌转，花气偏娇罗绮游。\n时把一尊苍翠里，何须东海问神洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52658,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠缪仲醇","author":"郭正域","text":"有客神交已十年，论文说道更谈天。\n江湖避世如吴札，肝胆倾人似鲁连。\n送汝寸心千里去，怀人尺素隔年传。\n致声西省同心客，天地风波已晏然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52659,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中峰寺","author":"杨舫","text":"看山有余兴，杖策入中峰。\n绕屋听鸣涧，巡檐见怪松。\n杯深明月堕，诗就碧纱笼。\n尘迹向已绝，空吟壁上蛩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52660,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖田 其一","author":"邵圭洁","text":"竹桥茅屋自成村，妻子欢呼共瓦盆。\n渡口流花引舟入，此中亦自有桃源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52661,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖田 其二","author":"邵圭洁","text":"荷花十里起香风，云白天青一镜中。\n游人忽载笙歌去，无数鸳鸯起绿丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52662,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴门锁钥为邑侯王苍野赋","author":"陈逅","text":"清时韬略属文儒，百里干城望不孤。\n跃马气应吞黠寇，登陴功许殿全吴。\n承宣政绩谁方驾，经济勋阶此发途。\n愧我请缨建素志，尚余衰鬓老江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52663,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虞山新城","author":"姚煦","text":"海虞倏而增形胜，千载雄图百日劳。\n崇堞迥临明镜绕，飞楼斜倚翠屏高。\n月中雉形生瑶色，云里龙文动彩毫。\n令宰贤声应远着，弦歌满县罢兵刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52664,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王忠臣鈇墓","author":"桑孝光","text":"眼见横戈靖海洋，仓皇一夕具金汤。\n乘城顿息千家哭，追寇宁辞七尺僵。\n泪堕残碑同岘首，骨留荒冢亦桐乡。\n忠魂寂寞凭谁吊，凄断悲风撼白杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52665,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"齐女墓","author":"姚宗仪","text":"虞山秀色可餐松，齐女当年葬此中。\n枯骨终为吴地鬼，招魂岂复到山东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52666,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初平石","author":"金定乐","text":"曲磴罗奇石，悬崖烂紫芝。\n披云探石室，疑有牧羊儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52667,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登拂水岩谒真武庙","author":"严澄","text":"石门通一径，藓磴陟千盘。\n已在云中坐，方知天上寒。\n苹蘩羞祗荐，肃穆俨仙官。\n回首烟霞路，微茫鸟道看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52668,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秦坡","author":"倪巨","text":"雨后秦坡水，势若天潢注。\n非风亦非雷，摇动山中树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52669,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过石梅","author":"文震孟","text":"落落乾坤眼，茫茫江海人。\n名山劳梦寐，绝壁扫嶙峋。\n海气蒸衣桁，岩华落酒巾。\n凭栏莫长啸，波荡伏龙津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52670,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日登虞山遇雨宿兴福寺","author":"黄淳耀","text":"潭影悠悠日夜空，一宵雷雨气鸿蒙。\n啜茶共说无生话，礼足还瞻盖世雄。\n乌帽白衣真往事，黄花翠竹想遗风。\n出门独向秋山笑，身在曹溪一滴中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52671,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠钱牧斋少宗伯","author":"陈子龙","text":"汉苑文章首，先朝侍从臣。\n三君同海岳，一老是星辰。\n作直称遗古，推贤更得邻。\n当时客渐进，文举气无伦。\n陈窦圜中土，萧刘泽畔人。\n蟪蛄喧日夜，兰桂历冬春。\n旧学商王重，清流汉史均。\n范宣谁让晋，卫鞅欲专秦。\n独指孙宏被，仍污庾亮尘。\n十年耕钓乐，七略较雠新。\n当户无芳草，洪流逸巨鳞。\n睚眦流訾訾，钩党报申申。\n告密牢修急，经营伟节神。\n霜华飞暑月，剑气彻秋旻。\n明主终收璧，宵人失要津。\n南冠荣衮绣，北郭偃松筠。\n艰险思良佐，孤危得大臣。\n东山云壑里，早晚下蒲轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52672,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"君山竹院","author":"陈继儒","text":"及肩新种竹，濯足旧疏湾。\n钓月鱼为伴，偕书僧送还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52673,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"画梅为陆简敬","author":"明桓","text":"荒鸦盘云山月低，山头雪花初化泥。\n沧江万里冻蛟死，元精耿耿难为稽。\n珠光剑气霜霰质，清寒不散香四出。\n天涯岁晏孰华予，东皇夜驾罗郁居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52674,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"画梅为陆简敬","author":"明桓","text":"空山寂历苦延伫，千年老鹤作人语。\n仙人不来生白晓，天光梦影堕烟渚。\n似闻踪迹寄幽崖，欲往从之无处所。\n瑶华散下青云端。\n一声白纻春灯寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52675,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"画梅为陆简敬","author":"明桓","text":"朔风飞呼木叶嘶，东方欲明星汉低。\n酒阑顿忆隔宵梦，但闻郊野催寒鸡。\n芳心岁晚不摇落，微阴冥冥光照溪。\n山中一夜啼翠羽，玄云叫破漏寒雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52676,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"画梅为陆简敬","author":"明桓","text":"神人独立藐姑射，绰约容光歌昔昔。\n怅望寥天无与归，星光照野动寒碧。\n微风泠泠摇杂佩，掩抑芳心伫遥夕。\n荒山无人石路古，悄然何处寻行迹。\n谁家处子愁不眠，绿苔珠露生春烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52677,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"青楼曲","author":"王伯稠","text":"日长深苑小榴开，懒逗红妆傍镜台。\n偏爱双飞双燕语，自开珠箔放归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52678,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仲弟习静东园构亭奉先慈志感一首","author":"李如一","text":"圣善遗龛供小园，仲郎思永构层轩。\n偏惊蔚草心空切，欲卧冰鱼殇觉翻。\n今日怡颜惟雁塔，昔年留训在鸰原。\n栖身恨不依祠侧，吩咐司香莫过喧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52679,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿见复六十","author":"李如一","text":"数载列冠裳，朱颜鬓未霜。\n门多长者辙，酒共少年场。\n有子能不朽，随兄尚雁行。\n百年行乐健，秋月药栏香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52680,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"见复弟二月二十生作诗寿之","author":"李如一","text":"初度春逢两度晴，晚年应学少年行。\n田园共乐贫长统，婚嫁粗完老尚平。\n何必洞天藏大酉，漫携斗酒祝长庚。\n谁云一日长乎尔，满世百花皆是兄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52681,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"示孙辈","author":"李如一","text":"五世辛勤诗礼庭，相传独此旧毡青。\n风云奋迅舒双翼，灯火沈酣醉一经。\n学语自宜壮岳置，援弓莫夺弈秋听。\n孝忠已有叔榜样，须作尔曹座右铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52682,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新迁南庄，喜友人送菊，用李中麓次唐荆川咏菊韵二首 其一","author":"李如一","text":"松菊秋冬并历霜，重阳景物映松堂。\n数杯白堕吾供趣，几朵黄花人羡芳。\n老至可怜空见色，年高始信但闻香。\n英茎作供衰尤藉，花槁枝头枕未忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52683,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新迁南庄，喜友人送菊，用李中麓次唐荆川咏菊韵二首 其二","author":"李如一","text":"老非壮盛貌愁霜，陶爱霜花啐霭堂。\n我未折腰因贱异，花侵啐面逞丛芳。\n重阳过后犹含蕊，五柳名存愈觉香。\n物为高人增市价。\n得称处士景难忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52684,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元旦次日","author":"李如一","text":"雪片横飞日影随，阴晴错出使人疑。\n村中贲节纷纭过，门外酬劳步履崎。\n吟友既亡无伴侣，眇躬默坐悔迁移。\n书生夙习难抛弃，字得窗光便叫奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52685,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柬许伯清","author":"李如一","text":"衰贫出口便纷纭，尘俗形骸懒谒君。\n梦寐当今子将子，骚坛月旦可容闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52686,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次昌仲弟喜雨一首","author":"李如一","text":"迩来萧索不堪闻，笔砚虽疏尚未焚。\n幸得甘霖扶秀实，好留衰骨共芳群。\n食新屡饱无穷惠，吐故连收有韵文。\n桂树垂垂应伴月，可容豪兴席中分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52687,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书目写就自题","author":"李如一","text":"蠹简生平习，衰残展未完。\n藏书数万卷，留与子孙看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52688,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙津驿问程","author":"王济元","text":"夜泊龙津驿，西风落雁愁。\n半衾浑似水，圆月渐如钩。\n雨雪三驰阪，关河七易舟。\n晚来问行客，前路尚悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52689,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]