[{"title":"凤来朝 春日书怀旧作","author":"叶小鸾","text":"小院闲无事。\n步花阴、嫩苔雨渍。\n弄明光、几叠琴弦腻。\n曲槛畔、情何似。\n静对圣贤书史。\n一炉香、尽消梦思。\n翠幕外、东风起。\n不觉又、欲瞑矣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52756,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"满宫花 咏游春人","author":"叶小鸾","text":"日融和，花媚妩。\n粉蝶摇枝娇舞。\n轻风吹落小桃红，燕子衔归绣户。\n草芊绵，人容与。\n共羡春光如许。\n紫骝金勒系垂杨，拾翠寻芳伴侣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52757,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南柯子","author":"叶小鸾","text":"庭际花枝袅，帘前汉渚横。\n断肠何必问吹笙。\n但见海棠叶上、露星星。\n墙月深深照，炉香细细零。\n谁家闺妇又砧声。\n搅得梦魂无赖、不堪情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52758,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南柯子 九日","author":"叶小鸾","text":"日暖茱萸好，霜飞菡萏衰。\n碧云山外夕阳催。\n自有竹篱斜径、菊花开。\n烟重迷疏柳，阴浓笼湿苔。\n画楼时送暗香来。\n且去待看明月、倒金杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52759,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浪淘沙","author":"叶小鸾","text":"薄暮峭寒分。\n罗簟香焚。\n粉墙留影弄微曛。\n一缕茶烟和梦煮，却又黄昏。\n曲曲画湘文。\n静掩巫云。\n花开花落负东君。\n嫌取花开花又落，都是东君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52760,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浪淘沙 春景","author":"叶小鸾","text":"杨柳弄柔黄。\n缕缕纤长。\n海棠风醉艳红妆。\n折取一枝归绣户，细玩春光。\n春日对春妆。\n莺燕笙簧。\n横塘三月水流香。\n贴水荷钱波动处，两两鸳鸯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52761,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浪淘沙 秋怀近作","author":"叶小鸾","text":"青女降枝头。\n已解添愁。\n暮蝉声咽冷箜篌。\n试看夜来多少露，草际珠流。\n身世一浮鸥。\n岁月悠悠。\n问天肯借片云游。\n袅袅乘风归去也，直上瀛洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52762,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杏花天","author":"叶小鸾","text":"翠烟无意撩书幌。\n带芳草、侵云渐长。\n晚风初作落花声，九十将阑未赏。\n南园路、风光暗想。\n听唤雨、鸣鸠两两。\n小池水皱萍漪绿，泛得红香惝惘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52763,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中花 梨花","author":"叶小鸾","text":"泪雨琼姿娇半吐。\n又一夜、风摇鬟雾。\n绣陌啼莺，画梁归燕，莫便催春去。\n脉脉柔情慵未足，叹寂寞、玉容难赋。\n今夜黄昏，明朝庭院，空锁重门暮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52764,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鹧鸪天 夏日","author":"叶小鸾","text":"处处蝉声咽柳亭。\n隆隆日午正当庭。\n莲香有水红妆倩，竹粉无风翠影停。\n挥扇子，候凉生。\n疏帘小簟却银屏。\n南熏日暮无行雨，唤煞啼鸠不耐听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52765,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鹧鸪天 壬申春夜梦中作五首 其一","author":"叶小鸾","text":"一卷楞严一炷香。\n蒲团为伴世相忘。\n三山碧水魂非远，半枕清风梦引长。\n依曲径，傍回廊。\n竹篱茅舍尽风光。\n空怜燕子归来去，何事营巢日日忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52766,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鹧鸪天 壬申春夜梦中作五首 其二","author":"叶小鸾","text":"春雨山中翠色来。\n萝门攲向夕阳开。\n朝来携伴寻芝去，到晚提壶沽酒回。\n身倚石，手持杯。\n醉时何惜玉山颓。\n今朝未识明朝事，不醉空教日月催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52767,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鹧鸪天 壬申春夜梦中作五首 其三","author":"叶小鸾","text":"野径春来草放齐。\n碧云天晓乱莺啼。\n紫笙吹彻缑山上，清磬敲残鹫岭西。\n红馥馥，绿萋萋。\n桃花杨柳共山蹊。\n遥看一抹烟云处，带雨春帆近日低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52768,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鹧鸪天 壬申春夜梦中作五首 其四","author":"叶小鸾","text":"雨后青山色更佳。\n飞流瀑布欲侵阶。\n无边药草谁人识，有意山花待我开。\n闲登眺，莫安排。\n啸吟歌咏自忘怀。\n飘飘似欲乘风去，去住瑶池白玉台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52769,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鹧鸪天 壬申春夜梦中作五首 其五","author":"叶小鸾","text":"西去曾游王母池。\n琼苏酒泛九霞卮。\n满天星斗如堪摘，遍体云烟似作衣。\n骑白鹿，驾青螭。\n群仙齐和步虚词。\n临行更有双成赠，赠我金茎五色芝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52770,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉楼春 春寒","author":"叶小鸾","text":"南园蝴蝶飞无数。\n满院春寒帘幕护。\n深深人在小楼中，悄悄花开寒食路。\n映阶日色时将午。\n添得罗衣窗影暮。\n寂寥孤馆闭闲春，但见斜阳窥绣户。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52771,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鹊桥仙 题画山水","author":"叶小鸾","text":"柴扉不掩，翠微欲滴，断岸芦花风寂。\n远峰云树两朦胧，曲径杳、崎岖难觅。\n平波澹澹，长松历历，玉洞仙床咫尺。\n闲来看尽思悠然，恨不得、将身飞入。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52772,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"河传 秋景","author":"叶小鸾","text":"风澹。\n疏阴凉浅。\n碧汉悠悠。\n玉钩。\n柳边挂斜西画楼。\n初秋。\n井梧先自愁。\n小幔轻云澄练绮。\n清光美。\n好把镜奁比。\n倚阑干。\n亸鬓鬟。\n远山。\n秋烟点黛弯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52773,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"河传 七夕","author":"叶小鸾","text":"鸾扇。\n星钿霞钏。\n暂撇残机。\n步移。\n思量去年今夕时。\n凄其。\n未期先惨离。\n借得嫦娥初月镜。\n窥瘦影。\n拂试翠眉整。\n驾云霓。\n河汉西。\n凄迷。\n只愁鸡暗啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52774,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"河传","author":"叶小鸾","text":"人坐。\n佳时瓜果。\n气朗长空。\n月宫。\n断霞半天衫袖红。\n重重。\n紫薇花影浓。\n曲沼芙蓉香满院。\n人正宴。\n数点晚萤见。\n倚针楼。\n看女牛。\n莫愁。\n今宵犹未秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52775,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临江仙 端午","author":"叶小鸾","text":"团扇新裁明月影，珠帘半上琼钩。\n榴花红到玉钗头。\n彩丝宜续命，绿砌绕忘忧。\n酒泛菖蒲香玉碎，嫩红双靥横秋。\n画船何处闹歌楼。\n萧萧烟雨外，还锁楚江愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52776,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虞美人","author":"叶小鸾","text":"看花日日寻春早。\n捡点春光好。\n轻罗香润步青春。\n可惜对花无酒、坐看茵。\n昨宵细雨催春骤。\n枕上惊花瘦。\n东君为甚最无情。\n只见花开不久、便飘零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52777,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虞美人","author":"叶小鸾","text":"一杯淡茗聊相赏。\n莫怪人惆怅。\n近来多病损红妆。\n不耐萧条清昼、卧琴床。\n侍儿漫把胭脂埽。\n委地还馀俏。\n春风著意半蹉跎。\n燕子不知花事、已无多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52778,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小重山 晓起","author":"叶小鸾","text":"春梦朦胧睡起浓。\n绿鬟浮腻滑、落香红。\n妆台人倦思难穷。\n斜簪玉，低照镜鸾中。\n徐步出房栊。\n闲将罗袖倚、立东风。\n日高烟静碧绡空。\n春如画，一片杏花丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52779,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"踏莎行 早春即事","author":"叶小鸾","text":"檐畔梅残，堤边柳细。\n暖风先送游人意。\n流莺犹未弄歌声，海棠欲点胭脂醉。\n鸟踏风低，烟横云倚。\n湘帘常把春寒闭。\n无端昨夜梦春阑，丝丝小雨花为泪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52780,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"踏莎行 紫薇花","author":"叶小鸾","text":"细剪胭脂，轻含茜露。\n芳菲百日浓辉聚。\n红妆懒去斗春妍，薰风独据珊瑚树。\n翠叶笼霞，琼葩缀雾。\n湘帘影卷猩姿雨。\n仙郎禁院旧传名，亭亭好伴西窗暮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52781,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"踏莎行 秋景","author":"叶小鸾","text":"悴叶零愁，清香入绣。\n王孙桂小涂黄就。\n画帘日影上银钩，松风一枕消清昼。\n片雨凉生，小风波皱。\n疏疏翠玉琅玕逗。\n断云飞尽碧天长，数枝烟柳斜阳瘦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52782,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"踏莎行 忆沈六舅父","author":"叶小鸾","text":"枝上香残，树头花褪。\n纷纷共作春归恨。\n十年客梦未曾醒，子规莫诉长离闷。\n回首天涯，愁肠萦寸。\n东风空递双鱼信。\n几番归约竟无凭，可怜只有情难尽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52783,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐多令 秋夜","author":"叶小鸾","text":"灯晕伴残更。\n萧萧落叶轻。\n诉穷愁、草际虫声。\n栏外芭蕉新嫩绿，仍做出，旧秋声。\n罗被夜凉清。\n凄然梦亦惊。\n透纱窗、月影纵横。\n几遍鸡声啼又晓，空蹙损，两山青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52784,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蝶恋花 春愁","author":"叶小鸾","text":"蓦地东风池上路。\n绿怨红消，竟是谁分付。\n不断行云迷楚树。\n闭门寒食梨花雨。\n雨后斜阳芳草处。\n闲把情怀，付与东君主。\n便向西园飘柳絮。\n不能飘散愁千缕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52785,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蝶恋花 立秋","author":"叶小鸾","text":"屈指西风秋已到。\n薄簟单衾，顿觉凉生早。\n疏雨数声敲叶小。\n小亭残暑浑如扫。\n流水年华容易老。\n秋月春花，总是知多少。\n准备夜深新梦好。\n露虫又欲啼衰草。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52786,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蝶恋花 七夕","author":"叶小鸾","text":"飞鹊年年真不误。\n机石停梭，掩映河边渡。\n清露未消杨柳暮，落花借点疏萤度。\n月色风光都莫负。\n酒酌芳樽，不把佳时错。\n女伴随凉池上路，海棠花畔吹箫坐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52787,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蝶恋花 兰花","author":"叶小鸾","text":"碧玉裁成琼作蕊。\n馥郁清香，长向风前倚。\n楚畹当年思帝子，紫茎绿叶娟娟美。\n自道全无脂粉气。\n笑煞春风，红白匀桃李。\n幽谷芳菲谁得比，猗猗独寄琴声里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52788,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蝶恋花 秋海棠","author":"叶小鸾","text":"浅绿嫣红开几许。\n谁料西风，也解倾城妩。\n酒晕盈盈娇欲伫。\n檀心半吐轻含雨。\n剪向屏山深处贮。\n似笑如愁，旖旒怜还怃。\n低亸对人浑不语。\n断肠应恐人无绪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52789,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水龙吟 次父六月二十四日作","author":"叶小鸾","text":"昼长人静沉沉，绿杨正袅深深院。\n画帘低映，薄罗无暑，汗消珠钏。\n兰畹香消，湘筠影瘦，翠阴遮遍。\n听莲歌处处，悠扬逸韵，半入水风烟片。\n一霎雨馀明净，晚云如黛花如钿。\n舟移萍乱，芳香袖惹，媚风轻扇。\n一色红妆，千重翠盖，参差江面。\n更堪怜、归路平波杳杳，夕阳斜见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52790,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"点绛唇 早春有感","author":"叶纨纨","text":"小院黄昏，一庭淡月人声俏。\n梅花开了。\n春信知多少。\n又是一番，芳草天涯道。\n伤怀抱。\n年年憔悴，不似春归早。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52791,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浣溪沙","author":"叶纨纨","text":"清昼沉沉掩碧纱。\n困慵梳洗髻松鸦。\n蕙炉间袅篆烟斜。\n剪剪轻寒生绣户，霏霏细雨著庭花。\n一窗新梦晚风赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52792,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浣溪沙","author":"叶纨纨","text":"憔悴东风鬓影轻。\n年年春色苦关情。\n清魂无奈酒初醒。\n啼鸟数声人睡起，催花一霎雨还晴。\n断肠时节正清明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52793,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浣溪沙","author":"叶纨纨","text":"芳草依依道路斜。\n白云何处是仙家。\n空馀远碧暮云赊。\n红泪滴残清夜月，梦魂长绕淡梨花。\n几番临镜黯伤嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52794,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浣溪沙","author":"叶纨纨","text":"昨夜轻寒透薄罗。\n晓来微雨忽相过。\n红英一半已看无。\n好句漫成嫌未切，那知总为恨难模。\n日长双黛奈颦何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52795,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浣溪沙","author":"叶纨纨","text":"正是黄昏欲断凝。\n不堪帘外雨馀声。\n倚屏愁绝最难听。\n红烛来时朱户掩，篆香消处翠炉清。\n又看新月照疏棂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52796,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浣溪沙","author":"叶纨纨","text":"寂寂重帘画影沉。\n网丝牵恨入愁吟。\n浪痕和梦怨春深。\n罗袂暗松金缕扣，惜花潜减旧时心。\n小楼几日怯登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52797,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浣溪沙","author":"叶纨纨","text":"燕子初来垒故巢。\n晓莺啼恨更添娇。\n一春都是等闲抛。\n不怨满庭风雨恶，只教终日梦魂消。\n东风空锁绿杨腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52798,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浣溪沙","author":"叶纨纨","text":"日日枝头堕粉香。\n东君何事苦匆忙。\n鸟啼花落送韶光。\n泪蹙翠山情杳杳，闷连青海思茫茫。\n含颦无语立斜阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52799,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浣溪沙","author":"叶纨纨","text":"斗草庭边事已迁。\n画栏花影只依然。\n紫箫凄断绿窗前。\n寥落春深人病酒，萧条香径柳垂烟。\n东风回首总堪怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52800,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浣溪沙 同两妹戏赠母婢随春","author":"叶纨纨","text":"杨柳风初缕缕轻。\n晓妆无力倚云屏。\n帘前草色最关情。\n欲折花枝嗔舞蝶，半回春梦恼啼莺。\n日长深院理秦筝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52801,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浣溪沙 前阕与妹同韵，妹以未尽更作再赠","author":"叶纨纨","text":"翠黛轻描桂叶新。\n柳腰袅娜袜生尘。\n风前斜立不胜春。\n细语娇声羞觅婿，清胪粉面惯嗔人。\n无端长自恼芳心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52802,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浣溪沙 新竹","author":"叶纨纨","text":"百尺高抽出画墙。\n娟娟含粉秀冰霜。\n静临深院日初长。\n翠霭濛空笼曙色，清阴摇月照宵凉。\n南薰池馆占风光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52803,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"菩萨蛮 早春日暮，共两妹坐小阁中，晓风竹萧萧，恍如秋夜。慨焉赋此","author":"叶纨纨","text":"迟迟暝色笼庭远。\n小窗静掩香犹暖。\n风弄竹声幽。\n萧萧却似秋。\n愁怀长自讶。\n共语怜今夜。\n旧意与新情。\n湘江未是深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52804,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"菩萨蛮","author":"叶纨纨","text":"寂寥小阁黄昏暮。\n依依恍若天涯过。\n窗外月光寒。\n映窗书几删。\n话长嫌漏促。\n香烬应须续。\n几种可伤心。\n诉君君细听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52805,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"菩萨蛮 感怀","author":"叶纨纨","text":"茫茫春梦谁知道。\n绿杨一霎东风老。\n自恨枉多情。\n浮尘长苦憎。\n草堂青嶂绕。\n曲岸溪声小。\n何日遂平生。\n相携上玉京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52806,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"菩萨蛮","author":"叶纨纨","text":"凭君莫问烟霞路。\n悠悠总是无心处。\n人世自颠狂。\n空惊日月忙。\n萋萋阶下草。\n日日阶前绕。\n切莫系闲愁。\n闲愁无尽头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52807,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"菩萨蛮 和老母赠别","author":"叶纨纨","text":"樽前香焰消红烛。\n可怜今夜伤心曲。\n衫袖泪痕红。\n离歌凄晚风。\n匆匆苦岁月。\n相聚还相别。\n肠断月明时。\n后期难自知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52808,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"菩萨蛮 秋思","author":"叶纨纨","text":"蒹葭一望连天碧。\n蘼芜消尽伤心色。\n孤雁正横空。\n夕阳更又红。\n烟波多少事。\n难作归山计。\n秋泪拍堤寒。\n浮生共渺漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52809,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"踏莎行 暮春","author":"叶纨纨","text":"花落闲庭，春归小院。\n沉沉嫩绿莺初啭。\n昼长人尽掩重门，楞严读罢花阴转。\n清思幽然，尘情尽遣。\n一帘幽霭东风晚。\n数声啼鸟欲黄昏，满阶月影澄澄见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52810,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"踏莎行","author":"叶纨纨","text":"粉絮吹绵，红英飘绮。\n又看一度春归矣。\n子规啼破梦初醒，凭栏目断伤千里。\n尘世堪嗟，流光难倚。\n浮生冉冉知何似。\n旧游回首总休题，断肠只有愁如此。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52811,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"踏莎行 秋海棠","author":"叶纨纨","text":"媚晕轻妆，芳姿映砌。\n檀心一点清香细。\n对人无语似凝羞，嫣然风韵多流丽。\n酒意将酣，柔情欲系。\n盈盈泣向西风闭。\n只愁人梦月寒时，断肠无那灯前睇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52812,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"系裙腰 仿刘叔体","author":"叶纨纨","text":"窗耳半掩簟儿清。\n庭儿静，袖儿轻。\n春儿老去伤情。\n景儿明，愁懒把，步儿行。\n黛儿蹙蹙髻儿倾。\n栏儿倚，闷盈盈。\n萋萋绿草儿，迷断归程。\n叹声声，只赢得、病儿成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52813,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"满江红 秋思","author":"叶纨纨","text":"桂苑香消，芙蓉老、白苹浪起。\n又渐是、寒烟古木，夕阳流水。\n玉笛悲凉秋旅怨，金砧凄楚关山思。\n看断霞、明月照凉辉，黯凝倚。\n诗酒兴，消残矣。\n愁与闷，偏无已。\n念啼莺别后，水云烟弥。\n惆怅不通天际信，江南风景空如此。\n听秋声、萧瑟夜蛩清，心如死。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52814,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"满江红","author":"叶纨纨","text":"秋色澄清，烟光净、碧天寥廓。\n正此际、悲凉满目，岁华摇落。\n镜里流光私自惜，瑶台无路愁难托。\n奈新来、秋鬓不胜悲，浑萧索。\n问何处，堪栖泊。\n想蕙帐，悲猿鹤。\n更疏篱丛菊，草堂风择。\n无奈都成虚负了，尘劳客梦何时却。\n被西风、消息暗惊心，空思著。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52815,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"满江红 闻雁","author":"叶纨纨","text":"梧叶飘翻，花阴转、露华明月。\n风正起、深闺乍冷，罗衣寒怯。\n络纬啼寒催短梦，怨蛩声咽悲长别。\n叹可怜、回首又关情，新鶗鴃。\n憔悴尽，清秋节。\n增怅望，肠如结。\n见几行征雁，锦书周摺。\n唳落西楼飞不定，音传塞北浑难说。\n问天涯、归去是何时，情凄切。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52816,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"琐窗寒 忆妹","author":"叶纨纨","text":"萧瑟西风，啼螀满院，辘轳声歇。\n流萤暗照，归思顿添凄切。\n更那堪、近来音稀，盈盈一水如迢迭。\n想当初相聚，而今难再，愁肠空结。\n从别。\n数更节。\n念契阔情悰，惊心岁月。\n旧游梦断，此恨凭谁堪说。\n渐江天、香老蘋洲，征鸿不向愁时缺。\n待听残、暮雨梧桐，一夜啼红血。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52817,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]