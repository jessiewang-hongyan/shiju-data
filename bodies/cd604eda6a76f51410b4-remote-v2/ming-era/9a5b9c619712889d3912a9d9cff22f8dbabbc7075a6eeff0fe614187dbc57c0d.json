[{"title":"月夜舟次吴塔与顾陆二丈酣坐","author":"郭谏臣","text":"扁舟载月舣林皋，故旧相逢尽浊醪。\n坐拥黑貂青露重，行看玉兔碧天高。\n惟当佳景携三益，肯向衰年叹二毛。\n旷达从来说嵇阮，竹林还许醉山涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22933,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陈氏湖田别业晚集","author":"郭谏臣","text":"携酒临山阁，杯深客渐醺。\n湖心淹落照，树杪度春云。\n风急鸦群乱，山高鸟道分。\n归途无醉尉，谁诘李将军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22934,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过湖上友人别馆","author":"郭谏臣","text":"园林幽胜傍湖乡，春雨初晴草树香。\n落尽梅花无客看，柴门深闭陆浑庄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22935,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日游石湖因登张幼于浮黛楼","author":"郭谏臣","text":"危楼时纵目，物候向春融。\n孤黛浮天上，明湖落掌中。\n窗虚含宿雨，帘动引微风。\n坐久浑忘去，凭阑夕照红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22936,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"稽范堂怀张幼于","author":"郭谏臣","text":"范相幽栖处，风流几百年。\n清芬遗后代，华构景前贤。\n夜送吴山月，晨分笠泽烟。\n何时共公子，归老石湖边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22937,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日郊居遣兴","author":"郭谏臣","text":"春来江上景偏幽，草木欣欣雨乍收。\n花径风微黄蝶舞，萍池水长锦鳞游。\n自怜绿野今为主，谁识青门旧是侯。\n杯酒炉薰消日月，閒心总为白云留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22938,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春城送张幼于游钱塘兼寄张水部德夫","author":"郭谏臣","text":"胥江春水漫城阴，词客乘春去武林。\n三月风光湖上好，六桥草色雨中深。\n年来夙有青山约，别后应多白雪吟。\n花下若逢张水部，为言予已二毛侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22939,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晓发娄江将访王棘卿元美","author":"郭谏臣","text":"晓风吹片雨，篷底作轻寒。\n烟草连天去，江花带露看。\n幽偏勤简帙，离索懒衣冠。\n访旧还探胜，扁舟兴未阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22940,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日过王棘卿园亭二首 其一","author":"郭谏臣","text":"摩诘幽居后，蓝田别业新。\n园林三径曲，花木四时春。\n日有携琴客，时多问字人。\n颇容疏懒性，一室愿为邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22941,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日过王棘卿园亭二首 其二","author":"郭谏臣","text":"绀园春欲暮，光景入繁华。\n雨后多芳草，风前自落花。\n攒峰危柱石，曲水烂蒸霞。\n未尽登临兴，西林日已斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22942,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春郊散步","author":"郭谏臣","text":"江城春雨后，绿水映晴沙。\n缓步怜芳草，多情恨落花。\n衣沾香雾重，丝飏暖风斜。\n兴到寻游伴，前村问酒家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22943,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春水舟中小饮二首 其一","author":"郭谏臣","text":"拨棹春波绿，开帘夕照红。\n杯传新荻渚，人醉落花风。\n纵饮情何剧，狂吟句自雄。\n衰年谢轩冕，放浪一渔翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22944,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春水舟中小饮二首 其二","author":"郭谏臣","text":"携榼聊同饮，回舟已半酣。\n烟云花外绕，天水镜中涵。\n宦海风尘远，江乡趣味谙。\n疏狂时共弃，啸隐大江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22945,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"后苑牡丹盛开与诸公同赏分韵得杯字","author":"郭谏臣","text":"名花娇艳雨中开，把酒临轩待客来。\n绣幕香浮青玉案，雕阑光映紫霞杯。\n残春去夏无多日，老景看花得几回。\n且向樽前共欢赏，莫教零乱委苍苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22946,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"自云间过嘉善访金明府不遇","author":"郭谏臣","text":"停桡夜听华亭鹤，放棹晨披槜李云。\n日暮孤帆天际落，路迷何处访神君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22947,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"园亭雨后即事","author":"郭谏臣","text":"别墅红尘远，幽居日掩门。\n松声醒客梦，鸟语类人言。\n篱落斜通径，溪流曲抱村。\n池亭梅雨霁，独坐向黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22948,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送兰溪金明府赴召北上","author":"郭谏臣","text":"送君驰驿去，江上雨初晴。\n一鹤同琴往，双凫拂棹行。\n掖垣新视草，花县旧知名。\n闻说朝阳凤，偏从盛世鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22949,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"独酌","author":"郭谏臣","text":"雨洗长天净，霞飞落照明。\n行看秋色远，坐觉晚凉生。\n独酌聊乘兴，幽栖不用名。\n醉吟空向夕，四壁乱蛩鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22950,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送杨大参同年赴粤西二首 其一","author":"郭谏臣","text":"秋风江上动双旌，远驾星轺岭外行。\n夹道儿童笑相语，秋江应让使君清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22951,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送杨大参同年赴粤西二首 其二","author":"郭谏臣","text":"日落烟江路欲迷，望中一片白云低。\n使君心与云俱远，万里随风到粤西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22952,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送阙仪部之饶州","author":"郭谏臣","text":"晓向金阊折柳枝，临行赠别意迟迟。\n欲知别后相思处，梦断匡山月落时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22953,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"独坐","author":"郭谏臣","text":"孤灯明灭夜迢迢，独拥寒衾酒渐消。\n阶下虫吟和露切，窗前叶落信风飘。\n百年已悟尘栖草，一梦犹惊鹿在蕉。\n老去自怜精力改，带围应减沈郎腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22954,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"悟石轩待月归舟漫成","author":"郭谏臣","text":"悟石轩中竟日留，坐闻仙籁引箜篌。\n苍烟晴带诸天暮，丹桂香含一壑秋。\n醉喜微风生短袂，归看明月浸虚舟。\n每逢佳景偏多兴，狼藉杯盘夜未收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22955,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蠡东漫兴","author":"郭谏臣","text":"泽国秋将尽，柴荆客到稀。\n雁归枫叶改，鸡啄稻粱肥。\n涤器催盛酒，敲砧拟授衣。\n山林兴成癖，甘与世相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22956,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"塘湾舟中夜雨","author":"郭谏臣","text":"山雨暮来急，篷窗夜卧迟。\n箫声云外落，烛影席间移。\n共醉黄花酒，应多白雪词。\n因悲名利客，潦倒在天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22957,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送曾鸿胪归豫章","author":"郭谏臣","text":"握手临岐把浊醪，送君千里去江皋。\n清霜晓拂张华剑，朔气寒生范叔袍。\n彭蠡帆收山月上，匡庐雁度楚天高。\n相逢不久重为别，两地应知梦寐劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22958,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送徐明府赴海阳二首 其一","author":"郭谏臣","text":"送子潮阳去，星轺度岭云。\n当官应有法，饰治更须文。\n海近烽烟接，城临岛屿分。\n欲知新制锦，试问小冯君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22959,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送徐明府赴海阳二首 其二","author":"郭谏臣","text":"族本衣冠旧，腰悬印绶新。\n双凫飞远道，匹马逐轻尘。\n月照琴堂夜，花明海县春。\n政成歌颂起，坐见鳄鱼驯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22960,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浒墅道中","author":"郭谏臣","text":"天末长风发，孤舟送上溪。\n鸥群冲浪起，雁阵入云迷。\n林带荒烟暝，山衔落日低。\n蟹螯空荐酒，痛饮醉如泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22961,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟中偶述","author":"郭谏臣","text":"虔台游倦即归耕，踪迹浑如水上萍。\n遁世何须歌白石，养生惟喜诵黄庭。\n诗当月下偏催和，酒向花前不放停。\n自是江乡容傲吏，许谁遥应少微星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22962,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜宿山家","author":"郭谏臣","text":"车马劳劳日已斜，仆夫指引到山家。\n园蔬细摘时频进，村酒新篘不用赊。\n片月近人寒弄色，孤灯对客夜生花。\n山翁醉问家何处，惭愧吴门学种瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22963,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晓行入山","author":"郭谏臣","text":"晓别山翁去，星河压岭低。\n乱冈频驻马，数里未闻鸡。\n残月和烟没，清霜使径迷。\n仙家行渐近，徐步蹑丹梯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22964,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晨登大茅峰","author":"郭谏臣","text":"肩舆涉险到仙源，一路泉声入耳喧。\n岩畔苍松千岁古，洞前瑶草四时繁。\n龙潜幽壑生云气，龟断荒碑积藓痕。\n便欲飘然避尘世，采芝何处访东园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22965,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜宿崇明寺旧寓","author":"郭谏臣","text":"二十年前逐队行，重来萧寺不胜情。\n入门寒月侵阶白，俯槛浮云与塔平。\n灯下漫倾新贳酒，壁间还认旧题名。\n夜寒禅榻凄凉甚，一枕黄粱梦不成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22966,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南都归途中作","author":"郭谏臣","text":"整装晨向板舆升，物外云游近类僧。\n浪迹自同狂北阮，微行谁识旧东陵。\n吴中别业应归去，白下名山惜未登。\n非敢清时即长往，依违恐负丈夫称。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22967,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"虎邱访僧不遇","author":"郭谏臣","text":"停桡徐步扣禅关，门掩松阴白日閒。\n坐对寒云时怅望，萧条落叶满空山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22968,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南楼晓望","author":"郭谏臣","text":"晓向南楼望，阳光动绮疏。\n蛛丝盈几案，鸟迹污琴书。\n曝背难为献，閒心只自如。\n仲冬风日好，聊此称幽居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22969,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王大参同年南还二首 其一","author":"郭谏臣","text":"当年邂逅大江滨，策马看花上苑春。\n宦辙从来途路险，故乡归去岁华新。\n东风旧宅仍栽柳，细雨芳洲更采莼。\n别酒莫辞频劝饮，与君俱是倦游人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22970,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王大参同年南还二首 其二","author":"郭谏臣","text":"江城送客日西斜，一片孤帆去永嘉。\n泽国舟中无薏苡，官桥雪后有梅花。\n故人惜别重携手，游子先春拟到家。\n钟鼎山林俱梦幻，好将诗酒弄烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22971,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊居晨起即事","author":"郭谏臣","text":"郊居时晏起，寒色动柴门。\n日出鸡豚散，庭空鸟雀喧。\n断烟栖木杪，残雪拥篱根。\n曝背南檐下，狐裘渐觉温。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22972,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山行口占","author":"郭谏臣","text":"湖乡岁晚倚兰桡，山背阴阴雪未消。\n閒向官桥时问信，春光先露早梅梢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22973,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月夜渡湖过虎山桥","author":"郭谏臣","text":"一苇风生过五湖，山桥此夜月同孤。\n天浮皓魄连银汉，波漾流光注玉壶。\n荻渚渔歌时互答，沙汀雁宿自相呼。\n优游物外浑无累，且觅高阳旧酒徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22974,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元日","author":"郭谏臣","text":"元日还新霁，东风上柳条。\n远山岚半吐，积水冻全消。\n宝鼎香焚柏，金樽酒颂椒。\n衰年逢令节，清兴觉偏饶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22975,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王古庵侍御之夜郎","author":"郭谏臣","text":"金阊门外柳条春，客旆悠悠指去津。\n江畔寒梅迎棹发，天涯芳草映袍新。\n怜君旧是乌台使，老我今为白社民。\n别酒临行须强饮，云山万里共谁亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22976,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"閒过灵殿寺看梅","author":"郭谏臣","text":"古寺荒凉烟景赊，竹林深处是僧家。\n老梅不识寒暄态，依旧春开几树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22977,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日携榼同顾陆二文学往北寺野望","author":"郭谏臣","text":"双树寻芳坐，孤梅发兴新。\n日斜幡影坠，春入鸟声频。\n陌上韶光动，樽前趣味真。\n年来逃世网，偏觉故人亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22978,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晨起","author":"郭谏臣","text":"何处鸡声枕上闻，碧纱窗外曙初分。\n庭花欲发含朝露，海日将生散晓云。\n解组久同南郭隐，守株无愧北山文。\n残生病后堪行乐，不羡区区竹帛勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22979,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病起小斋即事","author":"郭谏臣","text":"不到名园久，春残花事稀。\n林香还入坐，草色欲沾衣。\n乔木干青汉，层台落翠微。\n平生耽胜赏，日暮竟忘归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22980,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜宿山房","author":"郭谏臣","text":"客座传杯罢，禅房借榻眠。\n小楼青嶂曲，高枕白云边。\n宝刹诸天近，瑶台片月圆。\n幽栖尘事远，积久足延年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22981,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月下与客同步","author":"郭谏臣","text":"散步千人石，钟鸣夜未阑。\n云归山阁暝，月浸剑池寒。\n花气侵衣薄，松风吹酒残。\n病馀难久立，长啸倚危阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22982,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山房晚坐","author":"郭谏臣","text":"山中初病起，三宿远公房。\n避俗寻莲社，全生礼药王。\n泉流穿涧冷，花落染尘香。\n对此逍遥坐，将迎意尽忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22983,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山房晓起简同游诸君","author":"郭谏臣","text":"无端夜雨五更寒，纸帐闻鸡客梦残。\n松籁风微还入座，花阴日上渐过阑。\n漫言桑下逾三宿，还喜樽前聚二难。\n乘兴忘归君莫讶，万金那易一身閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22984,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"后苑层楼登览","author":"郭谏臣","text":"高阁连云起，层轩逼水开。\n檐前芳树绕，座上远山来。\n景向春城聚，诗从暮雨催。\n家园增胜槩，竟日此徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22985,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"立夏日后苑漫题","author":"郭谏臣","text":"倏忽流光春又徂，朝来病骨强支吾。\n轻烟风飏时高下，细雨云移乍有无。\n深竹莺迁帘外语，平湖鸟下镜中呼。\n景随物换留无计，断送馀生酒一壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22986,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初夏南园杂兴一首","author":"郭谏臣","text":"南苑逢初夏，蔷薇满架花。\n幽香微带雨，丽色烂蒸霞。\n地拟东山胜，樽开北海赊。\n谢公行乐处，沉醉岸乌纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22987,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日过刘秀才村居","author":"郭谏臣","text":"访旧青郊外，停舟绿水滨。\n景临初夏日，情是故乡亲。\n杯酒论文久，园林发兴新。\n相看头尽白，来往莫嫌贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22988,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无锡城下夜泊","author":"郭谏臣","text":"沙洲维画舸，独坐向黄昏。\n月委溪流涌，风随麦浪翻。\n乌栖城下柳，犬吠水边村。\n心事凭谁语，惟须酒一樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22989,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与客同登吴氏园楼","author":"郭谏臣","text":"高阁凭阑坐，川原一望分。\n庭花晴媚日，林木上干云。\n山色侵窗入，鸠声隔竹闻。\n论文兼话旧，不觉酒微醺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22990,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚发岊亭","author":"郭谏臣","text":"客路通宵雨，河桥柳色青。\n水深新荻渚，烟暗古邮亭。\n对镜冠慵整，凭阑酒未醒。\n年来困尘网，华发渐星星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22991,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"毗陵道中二首 其一","author":"郭谏臣","text":"扬帆初雨霁，缥缈向毗陵。\n云敛山仍出，沙虚岸欲崩。\n渚花迎雀舫，堤柳挂鱼罾。\n归路梁溪近，名山拟共登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22992,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"毗陵道中二首 其二","author":"郭谏臣","text":"路出晋陵西，城悬落日低。\n鸥惊渔棹起，乌向女墙栖。\n水竹由来美，烟花望欲迷。\n因思漆园吏，吾道付醯鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22993,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南园散步","author":"郭谏臣","text":"向晚开三径，薰风洒客裳。\n修篁新脱粉，幽草暗生香。\n水溢群鱼泳，林深百鸟藏。\n閒来观物理，不觉意俱忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22994,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊居口号二首 其一","author":"郭谏臣","text":"懒性优游鹿豕群，閒将杯酒对南薰。\n醉来高卧北窗下，松竹萧萧锁白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22995,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊居口号二首 其二","author":"郭谏臣","text":"课仆晨耕负郭田，坐怜乔木午参天。\n也知冠盖京华客，输我林间一醉眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22996,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送马大参同年北上","author":"郭谏臣","text":"一片征帆带夕晖，官桥烟柳暮依依。\n别时红蓼迷江渚，到日黄花满帝畿。\n命下喜生毛义檄，梦回惊睹老莱衣。\n知君才力犹强健，肯向明时暂息机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22997,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴江访李中丞晚归二首 其一","author":"郭谏臣","text":"访旧携孤棹，江城落照红。\n暮林投倦鸟，秋水偃长虹。\n灯起荒郊外，帆飞细雨中。\n三高不可作，千载仰遗风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22998,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴江访李中丞晚归二首 其二","author":"郭谏臣","text":"画船时载酒，银烛夜生花。\n老去身逾懒，秋来兴每佳。\n朗吟歌白雪，沉醉岸乌纱。\n舟子兼程进，更深未到家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22999,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"琴川夜归","author":"郭谏臣","text":"百里琴川路，扁舟载月归。\n扬帆凌皓景，把酒弄清辉。\n山敛孤云尽，河悬列宿稀。\n更阑人醉后，露下湿荷衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23000,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜泊太仓城下","author":"郭谏臣","text":"醉向篷窗卧，悠悠梦未成。\n一帘秋月白，孤枕夜涛声。\n夙有江湖兴，难忘鱼鸟情。\n漏催天易晓，隔水又鸡鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23001,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]