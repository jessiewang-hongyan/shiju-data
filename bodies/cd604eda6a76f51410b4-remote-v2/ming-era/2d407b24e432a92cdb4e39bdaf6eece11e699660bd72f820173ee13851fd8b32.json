[{"title":"放言 月死 其十 八齐","author":"谢元汴","text":"月死不能救，何如后羿妻。\n蛩惟歌此穴，鸡但老于醯。\n四海麟龙斗，空山熊豹啼。\n冷风吹墓树，不到石门西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38829,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 荼衙 其十一 九佳","author":"谢元汴","text":"十丈寒青玉，荼衙列戟排。\n瘵霖人似茧，痁橘峭于柴。\n梨月照衣苦，樵风拂柏乖。\n英雄须老死，遥集撰奇怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38830,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 看世 其十二 十灰","author":"谢元汴","text":"看世同刍狗，因风委路埃。\n空山烟国雨，寒枥瘁龙媒。\n莫遂赓坎缶，徒能叹谷蓷。\n香钩丝百尺，钓不出邹枚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38831,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 孤臣 其十三 十一真","author":"谢元汴","text":"鳞怒非无谓，锄兰合有因。\n楼犹祀铁汉，鬼独啖湘筠。\n岳隐表天骨，韦脂腥肉人。\n畏人称俊物，由彼叹孤臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38832,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 其十四 短剑","author":"谢元汴","text":"短剑光于银，照吾面上尘。\n偻松何字怪，偃柳亦名人。\n石骨秋前瘦，沙痕雪后新。\n丹丘多鬼血，逋子未知津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38833,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 其十五 雪旨","author":"谢元汴","text":"雪旨邀冬住，寒花称谪人。\n抗怀将落月，委美在山榛。\n奇服自招妒，长眉不数螓。\n先春芳色死，江畔问灵均。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38834,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 香芸 其十六 十二文","author":"谢元汴","text":"天下皆兵甲，谁怜杨子云。\n桃花迷古渡，湘水吊天君。\n补阙勿忘柳，荣身焉用文。\n人才多借面，练要植香芸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38835,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 穷猿 其十七 十三元","author":"谢元汴","text":"投林亦夙志，竹径一穷猿。\n文魅连华表，桑株恐老鼋。\n物于何桀步，石有以人言。\n夸父山为我，不惟一足骞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38836,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 圣贤 其十八 十四寒","author":"谢元汴","text":"凤凰所不至，踽踽圣贤寒。\n及气天心忍，值亢人理刓。\n峡猿哭月死，岛鹤泪秋乾。\n不识九州大，无方裁箨冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38837,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 青鬟 其十九 十五删","author":"谢元汴","text":"梦葬茂陵客，凄然散席潸。\n愁过桃叶渡，勿陟燕支山。\n焚瘗判花笔，萧骚校玉颜。\n芙蓉今岁死，月下哭青鬟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38838,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 酒船 其二十 一先","author":"谢元汴","text":"争言蕉护鹿，谁信夔怜蚿。\n枫落人同冷，苔延石不言。\n臂肝久欲化，陵谷已多迁。\n吹梦坠秋雨，无因覆酒船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38839,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 吹箫 其二十一 二箫","author":"谢元汴","text":"吴门无乞地，江上听吹箫。\n怒作千夫气，指柔五日潮。\n六桥明月夜，三竺碧烟朝。\n岳墓并于墓，大招又小招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38840,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 蝮氏 其二十二 三肴","author":"谢元汴","text":"飞牙署蝮氏，择肉岂辞殽。\n呼兕耕瑶圃，令枭种九苞。\n山都宜径步，众嫭任娥媌。\n吭吭林中鹿，命悬于饪庖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38841,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 香蕙 其二十三 四豪","author":"谢元汴","text":"香蕙泣衫色，敛眉语露桃。\n莫因画黛浅，而恨远山高。\n钗冷侵蝉重，鬟斜逐燕劳。\n晨芳细雨绿，叶上作波涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38842,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 渔蓑 其二十四 五歌","author":"谢元汴","text":"扣角真无赖，凿坏亦已过。\n君平非弃世，安石其如何。\n伧魄戍尘蹍，书魂兵气呵。\n苍生板荡泪，零落下渔蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38843,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 负心 其二十五 六麻","author":"谢元汴","text":"负心非一事，唧唧秋虫嗟。\n电火驹中影，菖蒲石上花。\n三炊人詈玉，四壁我惭家。\n古筱立寒镜，灯光笑剑华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38844,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 百蚿 其二十六 七阳","author":"谢元汴","text":"百蚿噬一凤，人面而羊肠。\n失足迷天路，投荒赋夜郎。\n江河千古血，椒桂寸心芳。\n手摘少微近，蛾眉唁楚羌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38845,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 其二十七 吴倡","author":"谢元汴","text":"读罢残书哭，夜深星月凉。\n魂曾经采石，梦可到潇湘。\n仅见鬼狂稚，何疑天老荒。\n男儿七尺影，色笑学吴倡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38846,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 美疢 其二十八 八庚","author":"谢元汴","text":"了不异人也，宁知身后名。\n凡骃皆虎鬼，是剑即龙精。\n象祷山河过，螾神物不平。\n勿忘美疢意，方蹶表前生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38847,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 其二十九 孤儿","author":"谢元汴","text":"骨肉如萍叶，相依惟一甥。\n亦知眉髧短，耻与魅魌争。\n世已轻文举，谁其说正平。\n寄书地下父，莫读孤儿生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38848,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 河伯 其三十 叹雨作也","author":"谢元汴","text":"海若伐河伯，云屯喷怒鲸。\n碎如转石叩，趹甚奔骝砰。\n迸作万条泪，旋为千顷泓。\n其渔吾不恶，天意自琤琤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38849,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 书客 其三十一 九青","author":"谢元汴","text":"书客香魂冷，寒光照夜青。\n已看风坠叶，还似水辞瓶。\n洒泣卖僮约，灰心瘗鹤铭。\n暮江天碎碎，枫鬼拜前庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38850,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 天崩 其三十二 十蒸","author":"谢元汴","text":"世犹存我辈，未可哭天崩。\n象理生乎震，河心峙以冰。\n治安羿浞足，礼乐鲮鬿兴。\n遑恤从逢比，雨风泣二陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38851,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 秋坟 其三十三 十一尤","author":"谢元汴","text":"奇山不在貌，即作诗文求。\n郊贺孟门峻，蜕樵少室遒。\n古今指几屈，山鬼才谁俦。\n苍颉字成日，秋坟鬼夜啾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38852,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 二毛 其三十四 十二侵","author":"谢元汴","text":"所嗟人命短，忽忽二毛侵。\n日月苦煎迫，乾坤费瀹燖。\n梅梁今不斗，剑佩久还镡。\n钦彼乘鸾者，寥寥山水心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38853,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 眠蚕 其三十五 十三覃","author":"谢元汴","text":"薨薨而止棘，吾独作眠蚕。\n即令婴头责，誓无笑尾婪。\n多烦哀靡凤，遽敢哭蓍簪。\n臣罪当膏钺，愚衷耻未覃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38854,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 鱼鬵 其三十六 十四盐","author":"谢元汴","text":"三十五年事，酸辛咸苦兼。\n洗心龙骨水，入世虎形盐。\n不信江潭险，有如岩石憸。\n美人良未远，惟许溉鱼鬵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38855,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 河水 其三十七 十五咸","author":"谢元汴","text":"河水千年物，投躯以饲谗。\n冤亲快痛半，今昔哭歌咸。\n化枳何须颂，当门宁免芟。\n平平申狄耳，濒死未嵌岩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38856,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放言 其三十八 暝发","author":"谢元汴","text":"匹马棠梨间，冲烟出暮关。\n讯云木客啸，吊月老狐潸。\n魂夭明河路，霜瘝秋际山。\n青萍勿负我，看取报恩还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38857,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读焦桐山集赋得画堂留草本野竹淡时名寄柘乡诸友十三首 其一","author":"谢元汴","text":"鼍梁未可渡，抗手友崧高。\n孤竹不能媚，白云毋乃劳。\n南山韬雾豹，幻海吼蒲牢。\n肉食多毛颖，何人诵甫桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38858,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读焦桐山集赋得画堂留草本野竹淡时名寄柘乡诸友十三首 其二","author":"谢元汴","text":"山戴六鳌抃，衡望九面疑。\n崩风香露泣，葬雨渫云㕧。\n槲发鳞龙影，荇漪水石姿。\n棠溪问喂凤，何不栖夷楣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38859,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读焦桐山集赋得画堂留草本野竹淡时名寄柘乡诸友十三首 其三","author":"谢元汴","text":"仙掌跨云蜕，巢由今买山。\n蛟龙吟此际，日月隐中间。\n莫作招魂赋，已倾玉笋班。\n不周吹短鬓，惭负石蕳颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38860,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读焦桐山集赋得画堂留草本野竹淡时名寄柘乡诸友十三首 其四","author":"谢元汴","text":"鲵居而鲋入，且莫泣枯鱼。\n双翮冥飞后，五丁伐险初。\n山辉吊木客，鹘俊讥芧狙。\n笋石千林秀，溪云好寄书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38861,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读焦桐山集赋得画堂留草本野竹淡时名寄柘乡诸友十三首 其五","author":"谢元汴","text":"结璘唁石耋，鲛室陷波行。\n霜善鸟声耿，景寒人语清。\n全收水地影，弥纳云虹情。\n星意窥襄汉，秋烟君始生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38862,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读焦桐山集赋得画堂留草本野竹淡时名寄柘乡诸友十三首 其六","author":"谢元汴","text":"谁诏丰隆葬，濯龙既败渊。\n何知草木紧，可是石金坚。\n丘壑徒能尔，名山殊不然。\n虫音成短世，羸雨饯苔钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38863,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读焦桐山集赋得画堂留草本野竹淡时名寄柘乡诸友十三首 其七","author":"谢元汴","text":"海水飞凌影，残山尚爱才。\n炳文观虎别，弱理谢鸩媒。\n有石垂青发，无人问落梅。\n闭门春雨内，杉色数能来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38864,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读焦桐山集赋得画堂留草本野竹淡时名寄柘乡诸友十三首 其八","author":"谢元汴","text":"屈指中原秀，英雄有几人。\n奇才多剑客，劲草化秋尘。\n仇国郇模字，支天洗氏臣。\n谁能诛九日，血赤石麒麟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38865,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读焦桐山集赋得画堂留草本野竹淡时名寄柘乡诸友十三首 其九","author":"谢元汴","text":"墨魂视剑瘦，鬼语泣天荒。\n苔草能延碧，秋兰不忍芳。\n柳槐方即序，风雨亦无乡。\n何必龙文鲊，石田有禹粮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38866,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读焦桐山集赋得画堂留草本野竹淡时名寄柘乡诸友十三首 其十","author":"谢元汴","text":"选梦荔思苦，鬓星万木悽。\n不能师石户，焉敢字青溪。\n差玉非无命，融衡坐榜题。\n愤来歌猛虎，恸哭空山蹊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38867,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读焦桐山集赋得画堂留草本野竹淡时名寄柘乡诸友十三首 其十一","author":"谢元汴","text":"河北忠臣少，崖门纪白鹇。\n日鞭驱石险，月斧息鲸艰。\n碧芷苌弘血，秋山宋玉颜。\n南冠怀破镜，明月照刀环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38868,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读焦桐山集赋得画堂留草本野竹淡时名寄柘乡诸友十三首 其十二","author":"谢元汴","text":"贫贱青荓友，崎岖细雨归。\n谅冠危石娱，仍屦春冰非。\n鹤吊寒山月，烟㕧古墓薇。\n前修菹醢意，轻讽与渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38869,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读焦桐山集赋得画堂留草本野竹淡时名寄柘乡诸友十三首 其十三","author":"谢元汴","text":"遇雨张弧日，桃虫集蓼身。\n门高鬼瞰室，海大鱼吹尘。\n秉籊文章贱，锄荒明月贫。\n溪工在鸟市，白石水粼粼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38870,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石林寺寄无用上人","author":"谢元汴","text":"石林千笋髻，鬼斧斲天颜。\n怒兕排云立，苍虬拿雨湲。\n寺藏秋叶半，鸟渡黛烟间。\n侧侧幽溪月，杖龙乞鹤还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38871,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮丘诗赠林翁翁字粤夫每醉谈忠孝事则气见于须义生于齿 其一","author":"谢元汴","text":"岛上田横客，夷门古啬夫。\n吹箫剑影壮，击筑酒声粗。\n巉刻青龙杖，森茫金仆姑。\n手寒知袖短，天下一庸儒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38872,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮丘诗赠林翁翁字粤夫每醉谈忠孝事则气见于须义生于齿 其二","author":"谢元汴","text":"讵知三古后，借剑有专诸。\n柳市袁丝侣，圯桥黄石书。\n藏身测虎卜，蛰性伺龙摅。\n战血哭歌地，昆吾东户初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38873,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"栗里诗赠姚翁拂尘翁以明经拜州守不之官授经里门二首 其一","author":"谢元汴","text":"非爱陆浑秀，避人焚舄凫。\n山川流酒血，壁宅闻笙竽。\n白虎诗书苑，中条孝秀区。\n义肥跪石者，良士何瞿瞿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38874,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"栗里诗赠姚翁拂尘翁以明经拜州守不之官授经里门二首 其二","author":"谢元汴","text":"敢发群儒冢，苦匏邛友须。\n视人诅鸟怪，自我笑鱼枯。\n山放鹤猿榜，天开节义图。\n不须秋驾梦，折简到猗玗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38875,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题万青楼楼不名而题曰万青楼志也四首 其一","author":"谢元汴","text":"孤不附山水，雯青秀一魂。\n情田寄竹杖，义府濯秋根。\n勿以苍麟意，而为白马论。\n贞萋书带草，色授焘人存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38876,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题万青楼楼不名而题曰万青楼志也四首 其二","author":"谢元汴","text":"百尺元龙气，伊谁踞上床。\n秋星明杕杜，河水怯衣裳。\n宝剑书声穆，青衫草色凉。\n短垣森竹箭，秀出陆生庄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38877,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题万青楼楼不名而题曰万青楼志也四首 其三","author":"谢元汴","text":"木石有时命，干常气自青。\n玄黄殷战血，风雨一椒亭。\n已吊鲸鱼死，难寒白鹬刑。\n疏麻虽小物，危岫茂尧蓂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38878,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题万青楼楼不名而题曰万青楼志也四首 其四","author":"谢元汴","text":"文章谁后死，奇险自开山。\n肃月平蝉讼，光风正草奸。\n枝强鸟不武，篆蚀石能班。\n笑我瘦郊岛，蚕吟秋卷删。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38879,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿卓捷一","author":"谢元汴","text":"吉泽吐云绶，尧蓂叶叶新。\n荔蘅幽纫佩，璜玉静垂纶。\n白鹿宜招隐，商颜足避秦。\n橘中深日月，枕漱字天民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38880,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病起答丘搏九","author":"谢元汴","text":"瓦注敢云巧，唁兰子意诚。\n中流无定岸，恬水亦羊羹。\n叶岂是龙化，石何因肺名。\n唏嘘天地瘵，病不在膏肓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38881,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒食后微服止门人李瑞奇斋留数日未能归也勒于壁上以志所怀二首 其一","author":"谢元汴","text":"岂有焚身贿，瞻乌靡所之。\n豹之文自藉，兰以芳而錤。\n檀迹天生德，弧车鬼载疑。\n莫须道路死，不及首禾尼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38882,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒食后微服止门人李瑞奇斋留数日未能归也勒于壁上以志所怀二首 其二","author":"谢元汴","text":"匡畏颜回后，遥心与子期。\n凤衰吟旷兕，龙忌惕焚绥。\n人海孤难涉，道山危不移。\n萧萧千尺竹，竦峙江之湄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38883,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十二月二十四日与家人环列灶下烟饥不出祭之以诗因嗟天之下遂无一人自视真老妇矣 其一","author":"谢元汴","text":"媚灶吾何敢，送穷亦古人。\n兰魂无怪惑，笔墓自嶙峋。\n世事惟孤剑，文心比竹筠。\n匹夫诚有罪，怀璧山之根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38884,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十二月二十四日与家人环列灶下烟饥不出祭之以诗因嗟天之下遂无一人自视真老妇矣 其二","author":"谢元汴","text":"绝笔仍生笔，我其狂也愚。\n儿啼叶不止，血出石何辜。\n将臂等虫豸，移家托鹧鸪。\n鬓丝闻鬼哭，不必责头须。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38885,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其一","author":"谢元汴","text":"岁暮能无感，寒溪淡不声。\n荧灯一卷守，残柳数株明。\n日月忘年夭，山川摇客情。\n搴萝过绝壁，犹恐近浮名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38886,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其二","author":"谢元汴","text":"谐世无长策，青山作比闾。\n才名屈宋命，瓻甋马杨书。\n宁许续天问，偏当赋子虚。\n依稀尧禹迹，俯仰此焉如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38887,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其三","author":"谢元汴","text":"寒雨宾梅发，春枝渐向荣。\n学无通岁力，病积瘦吟程。\n二屦疏行迹，双扉覆短桁。\n惟应书史里，迸筑破愁城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38888,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其四","author":"谢元汴","text":"胸有真山水，看山何必山。\n振衣千仞际，坐客下床间。\n楚汉人安往，英雄事可删。\n嗣宗与叔夜，各梦不相关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其五","author":"谢元汴","text":"刳形为土木，疵垢全其真。\n屋角牛宫显，河湄麂步新。\n飔音凄断楚，日色冷幽蘋。\n荔佩今无恙，何妨署怪民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其六","author":"谢元汴","text":"由来世德邈，父子守残经。\n祠庙颓垣倚，墓田茂草青。\n妻奴羸百指，鹅鹜绌千翎。\n破屋吟声满，年年饯客星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其七","author":"谢元汴","text":"干戈离乱后，陟屺有慈亲。\n一杖依山曲，全家爱水濒。\n蛮风废蜡腊，竹室杂岐豳。\n摇落伤心处，峥嵘视葛巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其八","author":"谢元汴","text":"勿谓门庭寂，楮歌乐成员。\n一人知己可，四海草庐分。\n男子疲张裔，英雄壮使君。\n空山多虎啸，清险月中闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮山居杂感 其九","author":"谢元汴","text":"阅物当颓纪，交游忆曩时。\n风流我辈灭，零落在林埼。\n刻楮真无用，屠龙殊不宜。\n何如十亩上，日讽伐檀诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38894,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]