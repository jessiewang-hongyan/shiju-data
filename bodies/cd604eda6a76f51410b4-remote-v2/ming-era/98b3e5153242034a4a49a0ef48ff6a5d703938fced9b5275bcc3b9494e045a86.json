[{"title":"送薛君大秀才游武林","author":"徐熥","text":"司马南游正少年，可堪人去雁来前。\n孤舟白拥芦藏月，两岸青残柳散烟。\n帆外客星滩七里，湖中佛日竺三天。\n射潮不用钱王弩，但有观涛赋几篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邓汝高户曹督饷之浙","author":"徐熥","text":"粉署含香又几年，转输今识酂侯贤。\n还家树不言温室，行部山应访冷泉。\n玉麈夜挥天竺月，画船秋放太湖烟。\n江南水旱忧非细，愿悉民艰疏御前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送孙四之金陵","author":"徐熥","text":"一时词客叹飘蓬，无数离尊半日同。\n买笑好留钱子母，防身须仗剑雌雄。\n鹿麋夜走三吴苑，狐兔秋悲六代宫。\n建业城边堪饮水，孙郎名自起江东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古田极乐寺晓起","author":"徐熥","text":"听尽莲华刻漏长，山深岚翠满绳床。\n鸟啼松嶂声声月，僧踏枫林步步霜。\n座上落花天外雨，佛前沈水定中香。\n此生总是空门客，到处皈依有法王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过郑樵林山人市隐堂","author":"徐熥","text":"一丘高卧久忘机，双屐行歌遍翠微。\n纶挂夕阳春钓罢，笠携残雪晚樵归。\n松窗月冷烟霞梦，菊径云生薜荔衣。\n不用凿坏深避世，山城车马往来稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙申元日得惟起弟越中书闻王玉生客苕消息因柬钱叔达","author":"徐熥","text":"清尊何意醉流霞，览镜空惊鬓易华。\n阶下蓂开新岁叶，陇头梅寄隔年花。\n人逢老去常怀旧，客到春来定忆家。\n此日交游多失路，岂君踪迹独天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送翁兆震太史册封周藩事竣还朝","author":"徐熥","text":"暂缀鹓班马首东，桃花色借锦袍红。\n鞭挥上苑三眠柳，圭捧深宫半叶桐。\n飞盖兔园歌夜雪，鸣珂燕市动春风。\n汉家金匮资良史，好奏诸儒白虎通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张宗道之金陵兼怀诸旧游","author":"徐熥","text":"茫茫烟水片帆轻，学得陶朱变姓名。\n芳草楼台歌子夜，梨花村店过清明。\n莫愁湖送当年桨，瓜步江流六代声。\n欲作封题还自懒，知君今去石头城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23646,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"屠田叔使君枉过兼惠藏书赋谢","author":"徐熥","text":"艺苑相闻十载馀，应知名下定无虚。\n不拘世路寻常礼，还赠人间未有书。\n草泽敢当高士榻，蓬门终碍使君车。\n自惭巴曲非同调，空枉干旄问索居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23647,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈汝翔客建溪书林","author":"徐熥","text":"垂老江湖作校书，春风长日掩衡庐。\n经收坏壁驱残蠹，字出名山辨鲁鱼。\n著述未忘玄晏癖，往来多是邺侯居。\n不须二酉藏遗草，九曲仙都当石渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23648,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题郭张虚香雪斋","author":"徐熥","text":"高斋遥散白氤氲，历乱梅花到处闻。\n一笛残魂千树雪，半窗疏影满林云。\n寒生姑射仙人梦，香借孤山处士坟。\n何物江南堪寄远，年年春色倍思君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23649,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郑邦衡以书见贻兼惠玉章诗扇赋此荅赠","author":"徐熥","text":"相怜不必旧相欢，忽枉裁书问考槃。\n投赠一双皆楚璧，留题五字有齐纨。\n琴尊几日同花竹，魂梦中宵到木兰。\n年少声名君籍甚，浅才何敢作衙官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23650,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花朝社集送佘宗汉明府之南康访杨使君","author":"徐熥","text":"满路流莺送客轺，匡庐山色望中遥。\n朱门何处堪糊口，白发逢人反折腰。\n月下歌声虚竹径，天涯离恨记花朝。\n知君此去经彭泽，陶令高风未寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23651,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送了空禅师归长干寺是日为观音大士初度","author":"徐熥","text":"寻声疑自普陀来，又赠杨枝海上回。\n缁衲折芦初地去，白衣成果普门开。\n数千里路看飞锡，五十三参送善财。\n他日怀师劳远梦，栖霞兰若雨花台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23652,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"分得要离冢送陈伯孺之姑苏","author":"徐熥","text":"漆灯明灭半无光，断碣凋残字几行。\n黄土一抔封马鬣，紫苔三寸锈鱼肠。\n月中似听英魂泣，地下难埋侠骨香。\n况与伯鸾丘垄近，烦君并为荐椒浆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23653,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再送陈伯孺兼柬在杭 其一","author":"徐熥","text":"尊前酒尽即他乡，岂为分携始断肠。\n失路客身轻似叶，倚门亲鬓白于霜。\n归装不望中人产，内顾先营百日粮。\n未必绨袍能解赠，临行还嘱寄衣裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23654,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再送陈伯孺兼柬在杭 其二","author":"徐熥","text":"天涯休用叹穷愁，得称閒心是浪游。\n湖上翠蛾三竺寺，月中青雀百花洲。\n囊无重载身何累，交有深知刺易投。\n贫贱依人君莫愧，布衣谁不谒诸侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23655,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈振狂游玉华","author":"徐熥","text":"酒酣璚液唱游仙，万树桃花引去船。\n路绕潺湲千涧水，岩开混沌五更天。\n云根白积峰头雪，松火青飞洞里烟。\n采药倘逢秦代客，莫言人世是何年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23656,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀吴元瀚","author":"徐熥","text":"总是飘零未定身，不知吴楚与燕秦。\n远天夜雨孤舟冷，古道秋风一剑贫。\n到处南冠羞对客，谁家西第肯留宾。\n薄游只恐无归计，迹落江湖又几春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23657,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠薛君佐秀才","author":"徐熥","text":"年少词华旧有声，高标应比玉壶清。\n一春草向池中梦，五色花从笔里生。\n座满烟霞挥麈尾，匣腾风雨泣龙精。\n青云自是君家业，傲世休耽白社名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23658,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒食日陈汝大园亭看海棠","author":"徐熥","text":"寒食东风到舞筵，海棠开遍艳阳天。\n银罂杏酪香同饱，画架榴裙血并鲜。\n带雨花神娇欲泣，怯寒妃子醉无眠。\n夜深莫更移灯看，今日山厨未有烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23659,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日同叔达汝大惟秦幼孺粹夫能始兴公集无竞南郊水亭","author":"徐熥","text":"布谷声中醉倚栏，夕阳山色隔帘看。\n青团柳叶春烟薄，白散梨花暮雨寒。\n燕垒泥香芳径晚，鱼梁痕浅小池乾。\n只因地僻稀来往，门外低枝欲碍冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23660,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中试鼓山寺僧所惠新茶","author":"徐熥","text":"偃卧山窗日正长，老僧分赠茗盈筐。\n烧残榾柮偏多味，沸出松涛更觉香。\n火候已周开鼎器，病魔初伏有旗枪。\n隔林况听莺声好，移向荼蘼架下尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23661,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钟山寺访张孺愿留酌话旧","author":"徐熥","text":"客中尊酒暂淹留，共对禅灯忆旧游。\n此日听莺萧寺雨，当年骑马秣陵秋。\n风尘未肯容衰鬓，岁月何堪老敝裘。\n独有剑锋销不尽，君家神物是吴钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23662,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邀黄仲高张孺愿钱叔达张公鲁陈汝大陈汝翔陈惟秦王玉生陈幼孺王粹夫颜廷愉曹能始兴公弟雨中集万岁寺即席送徐仲和归钱唐","author":"徐熥","text":"共酌醍醐送客还，晚风吹雨暗禅关。\n绿波春草长途别，白社莲花半日閒。\n家望雷峰烟外塔，梦回天竺月中山。\n净瓶分得杨枝赠，垂柳临岐不用攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23663,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄仲高之漳州","author":"徐熥","text":"送君南去瘴云边，遥望征途路一千。\n五月枫亭扶荔雨，几村茅店刺桐烟。\n土音未辨难闻曲，海错常供不费钱。\n少妇当垆堪买醉，时时停策酒家眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23664,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送曹二进士之金溪吊周明府","author":"徐熥","text":"千里分襟怅别离，西州双泪数年悲。\n途中磨镜同徐稚，匣里亡琴痛子期。\n楚璞谩云增价早，隋珠犹悔报恩迟。\n九原未必无遗恨，不见看花上苑时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得广陵涛送客之维扬","author":"徐熥","text":"万马声喧不暂停，满天风浪昼冥冥。\n遥连铁瓮千层白，微露金焦两点青。\n吴楚山河分一水，齐梁烟月付中泠。\n伤心莫作芜城赋，好辨江干瘗鹤铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同屠田叔张孺愿钱叔达张公鲁及社中诸子集陈正夫水亭分得文字","author":"徐熥","text":"习池花木翠氤氲，忽枉高轩过使君。\n囊里诗签拈五字，尊前乐府演双文。\n杯倾竹叶春频醉，烛烬兰膏夜已分。\n地主独留髡送客，犹馀丝管梦中闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"不寐感怀","author":"徐熥","text":"杜宇啼残漏正长，满林斜月到匡床。\n浮生寤寐皆成梦，旧事悲欢总可伤。\n知己未亡琴废轸，雄心犹在剑销芒。\n枕前二十馀年泪，半在他乡半故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻伯孺由吴兴入姑苏遥有此寄","author":"徐熥","text":"一剑飘零渡五湖，半年踪迹遍三吴。\n苕溪日暮愁心远，笠泽天长客梦孤。\n旧隐云深寒薜荔，他乡春尽变蘼芜。\n满船载得乌程酒，曾酹要离墓上无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再怀伯孺","author":"徐熥","text":"登楼一望意凄凄，目极遥空白练低。\n匹马烟花吴苑曲，孤舟风雨太湖西。\n愁中芳草迷三径，别后垂杨暗六溪。\n千里怀人多感慨，每看南雁忆封题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23670,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柬程子晖","author":"徐熥","text":"求友空歌伐木声，逢君真见古人情。\n迹因避世青山近，心为忧时白发生。\n倚杖暮云花径远，捲帘春雨荔阴清。\n除将问道寻师外，那得庞公肯入城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23671,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕邓汝高民部招集玉皇阁同佘宗汉谢脩之明府邓道鸣阃帅钱叔达王粹夫山人陈汝大康元龙袁无竞秀才陈幼孺孝廉兴公舍弟赋分得五歌","author":"徐熥","text":"高阁开尊对薜萝，风吹零露下庭柯。\n三秋白帝司权早，一夕红妆乞巧多。\n夜杼暂停机上锦，凉衣初试箧中罗。\n少微历历干天象，不独双星夜渡河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23672,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邓道鸣阃帅招集邻霄台送邓汝高计部还朝","author":"徐熥","text":"三叠骊歌绕翠微，凉风初动叶初飞。\n尊倾大将葡萄酒，泪湿穷交薜荔衣。\n自信青山盟尚在，空怜白社客全稀。\n清泠台上频回首，目断燕云一雁归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23673,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月十四日夜招张孺愿钱叔达谢脩之陈汝大王玉生袁无竞集平远台观万岁神光二塔灯分得八庚","author":"徐熥","text":"良夜高台露气清，遥空灵籁送秋声。\n桂枝先自轮中满，莲炬还从镜里生。\n隐隐七层标舍利，双双百宝放光明。\n龙膏烛与蟾蜍影，同向人天照化城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23674,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张孺愿还四明","author":"徐熥","text":"津亭歌罢酒杯空，目极遥天送断鸿。\n马上夕阳孤店柳，渡头残月半林枫。\n瘴云漠漠辞闽北，乡树重重辨甬东。\n此日莼鲈归计得，思家张翰怯秋风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23675,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄仲高还四明","author":"徐熥","text":"江头尊酒别离难，满目疏林落叶丹。\n家望剡川湖一曲，车驱闽岭路千盘。\n关门晓色鸡声早，旷野秋声雁影寒。\n今夜梦君何处所，半天残月蓼花滩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23676,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄邓德咸明府","author":"徐熥","text":"一代风流墨绶郎，几年为政似庚桑。\n居官共号神明宰，判事多成急就章。\n滩送九龙来廨宇，庭留双鹤守琴床。\n春光莫羡河阳暖，六月还飞白简霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23677,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈振狂之汀州","author":"徐熥","text":"秋色将残树影稀，故人西去雁南飞。\n满林枫叶栟榈寺，两岸芦花铁石矶。\n霜冷戍楼喧暮柝，月明村舍捣寒衣。\n九龙溪上滩声急，千里羁魂一夜归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23678,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与吴元瀚话旧","author":"徐熥","text":"久客还家叹敝裘，对君犹自起离愁。\n数茎白发尊前泪，九曲青山梦里游。\n松径夕阳秋系马，竹房疏雨午啼鸠。\n明朝又作匆匆别，目断西风独倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23679,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张叔麟别驾招集钟山客舍席上听伎共限冷香二字","author":"徐熥","text":"白苧歌残欲断肠，相逢谁是有心郎。\n罗帏巫峡声声雨，玉杵蓝桥夜夜霜。\n烛泪半灰金剪冷，花魂初散宝钗香。\n红颜自昔多憔悴，岂学愁眉别样妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23680,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邓道鸣参戎东粤","author":"徐熥","text":"楼船横海发闽关，新拥高牙五岭间。\n月满柳营秋校猎，火飞藤峡夜征蛮。\n双龙斩水妖精泣，万马嘶风部曲閒。\n名在罗浮峰四百，功成何用勒燕山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23681,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠林敷毅公子","author":"徐熥","text":"年少悬书向国门，家声犹说紫薇垣。\n登坛久已推牛耳，授简曾看擅兔园。\n拥彗诸侯虚左席，操觚词客结中原。\n功名不用垂钟鼎，白首江湖亦主恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23682,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张参戎镇秦川","author":"徐熥","text":"铁衣曾典羽林兵，又握铜符海上行。\n此日八蛮传露布，同时诸将拜霓旌。\n臂开鹊血弓流影，腰泣龙魂剑有声。\n见说辕门容揖客，可能前箸借书生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23683,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送长乐令郁文叔谢病还晋陵","author":"徐熥","text":"弃官应遂白云心，行李空携单父琴。\n病骨岂堪长负弩，黑头偏乞早投簪。\n家当杨柳茶烟细，门比柴桑柳色阴。\n除却簿书劳半载，一生清福总山林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23684,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠张太医","author":"徐熥","text":"年少曾将肘后探，高名今已似苏耽。\n石烹夜月松烟细，药洗春泉橘井甘。\n函里难经翻九九，洞中炉火转三三。\n功成他日生毛羽，看驾云车白鹿参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23685,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题芳草王孙卷为罗生挽所知","author":"徐熥","text":"联璧当年旧有声，千秋埋玉怨难平。\n邯郸久作炊粱梦，都市犹传掷果名。\n肠断山阳灯下笛，魂销缑岭月中笙。\n萋萋满目王孙草，岁岁春风墓上生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23686,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙申除夕","author":"徐熥","text":"莫问残冬历一行，且将生计寄丝簧。\n烧灯客丐宜春帖，对镜人凝綵胜妆。\n衰鬓又添新岁感，童心犹记少年场。\n拥炉坐听莲花漏，待进山厨柏叶觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23687,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁酉元日","author":"徐熥","text":"岁月悠悠独自知，屠苏饮较众人迟。\n一年苦乐俱陈迹，昨日呻吟即旧诗。\n才尽敢云心似锦，颜衰犹幸鬓无丝。\n春风不厌衡门冷，吹遍繁花雪万枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23688,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送彭兴祖游燕","author":"徐熥","text":"都亭新柳折为鞭，又别闽南北向燕。\n马首一星边地火，莺声三月御河烟。\n吴侬枕上红楼曲，赵女垆头绿酒钱。\n此日离情君莫忘，落花风雨寺门前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23689,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"分得胭脂井送陈淳夫太学之金陵","author":"徐熥","text":"胭脂零落井痕荒，水面桃花照艳妆。\n碧甃一泓沉宝珥，红泉千点滴银床。\n金函半染铅华色，丝绠犹牵珠翠香。\n莫问故宫生死地，辘轳容易转愁肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23690,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈志玄还中都","author":"徐熥","text":"一片离心双泪垂，人归偏在送春时。\n鸡声残月邮亭火，马首疏烟酒店旗。\n江北琼花孤馆梦，淮南丛桂故园思。\n东风吹遍无情柳，满路青青拂面丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23691,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄君甫还剑津","author":"徐熥","text":"故园归去独扬舲，踯躅花残落远汀。\n鹦武春衔杯里月，蛟龙宵睨剑头星。\n滩回巨浪千层白，门对高峰九点青。\n莫道盈盈分一水，相思魂断几长亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23692,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"分得宫花一万树送曹能始进士赴阙","author":"徐熥","text":"芳菲丛里拜枫宸，铃索声中雨露新。\n香雾有时分太极，秾华随处拂勾陈。\n重重绿染宫袍色，片片红酣御辇尘。\n不似曲江骑马日，杏林惟探一枝春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23693,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"分得季子裘送钱叔达归吴兴","author":"徐熥","text":"旅邸淹留历几春，黑貂无复到来新。\n蒙茸莫问千金腋，褴褛翻疑百结鹑。\n失路易沾函谷雨，还家犹染洛阳尘。\n布衣落魄惭妻嫂，应悔当年浪入秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23694,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题黄伯宠秀才欧冶山房","author":"徐熥","text":"疏松影里草玄亭，屋后群峰列翠屏。\n残雨小塘萍散绿，微风幽径竹摇青。\n觞寻曲水流三月，剑拔寒潭洗七星。\n寂寂衡门无客到，林莺啼午梦初醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23695,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日邀屠田叔使君佘宗汉明府闵寿卿柳陈父王献子钱叔达吴元瀚诸山人颜廷愉都护兴公舍弟避暑平远堂分得一先韵","author":"徐熥","text":"借得琳宫结净缘，数声钟磬出诸天。\n龙江潮满千溪合，雉堞云开万井连。\n瀑布乱飞丹嶂雨，山衣同历翠微烟。\n莫言座上无丝竹，花外啼莺柳外蝉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23696,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿车郡公","author":"徐熥","text":"铜虎分来向海滨，玉皇香案记前身。\n采将瑶草三山秀，种得甘棠一郡春。\n天上紫鸾扶绛节，云中白鹿驾朱轮。\n寿筵不用蟠桃荐，丹荔冰盘色正新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23697,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题周朝寀转运三代荣封册","author":"徐熥","text":"出宰河阳旧有声，司农今复借双旌。\n转输岁向三边急，斥卤烟从万灶生。\n紫禁丝纶荣马鬣，熙朝冠盖擅羊城。\n一门雨露皆君宠，不独云霄两弟兄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23698,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林志尹谒选之京时予将入燕","author":"徐熥","text":"数声南雁叫秋烟，路指交河北到天。\n鸡送边城霜后角，马惊沙碛雪中鞭。\n贫来远道亲雄剑，老去长安索俸钱。\n我已藏名燕市久，相寻休向酒垆前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23699,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送闵寿卿从武夷还金山兼隐华阳洞","author":"徐熥","text":"历遍清溪九曲深，麻衣随意住云林。\n阴符一卷蛟龙护，秋笛数声猿鹤吟。\n玉洞烟霞通地肺，金山台殿影波心。\n空怀五岳平生志，未得从君学向禽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23700,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]