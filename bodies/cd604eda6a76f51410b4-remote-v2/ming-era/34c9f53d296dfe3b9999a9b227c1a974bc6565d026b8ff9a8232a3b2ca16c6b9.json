[{"title":"留别子羽七绝句 其一","author":"张红桥","text":"床头络纬泣秋风，一点残灯照药丛。\n梦吉梦凶都不是，朝朝望断北来鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":807,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别子羽七绝句 其二","author":"张红桥","text":"井落金瓶信不通，云山渺渺暗丹枫。\n轻罗露湿鸳鸯冷，闲听长宵嘹唳鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":808,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别子羽七绝句 其三","author":"张红桥","text":"寂寂香闺枕簟空，满阶秋雨落梧桐。\n内家不遣园陵去，音信何缘寄塞鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":809,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别子羽七绝句 其四","author":"张红桥","text":"玉箸双垂满颊红，关山何处寄书筒。\n绿窗寂寞无人到，海阔天高怨落鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":810,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别子羽七绝句 其五","author":"张红桥","text":"衾寒翡翠怯秋风，郎在天南妾在东。\n相见千回都是梦，楼头长日妒双鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":811,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别子羽七绝句 其六","author":"张红桥","text":"半帘明月影朣朣，照见鸳鸯锦帐中。\n梦里玉人方下马，恨它天外一声鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":812,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"窃见张红桥睡起","author":"王称","text":"象牙筠簟碧纱笼，绰约佳人睡正浓。\n半抹晓烟笼芍药，一泓秋水浸芙蓉。\n神游蓬岛三千界，梦绕巫山十二峰。\n谁把棋声惊觉后，起来香汗湿酥胸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":813,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"潜窥林鸿与张红桥狎作二首 其一 酥乳","author":"王称","text":"一双明月贴胸前，紫禁葡萄碧玉圆。\n夫婿调疏绮窗下，金茎数点露珠悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":814,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"潜窥林鸿与张红桥狎作二首 其二 云鬓","author":"王称","text":"香鬟三尺绾芙蓉，翠耸巫山雨后峰。\n斜倚玉床春色去，鸦翎蝉翼半蓬松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":815,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"教坊献诗","author":"铁铉长女","text":"教坊脂粉洗铅华，一片閒心对落花。\n旧曲听来犹有恨，故园归去已无家。\n云鬟半挽临妆镜，雨泪空流湿绛纱。\n今日相逢白司马，尊前重与诉琵琶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":816,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"无题","author":"铁氏次女","text":"骨肉衰残产业荒，一身何忍去归娼。\n泪垂玉著辞官舍，步蹴金莲入教坊。\n览镜自怜倾国色，向人羞学倚门妆。\n春来雨露宽如海，嫁得刘郎胜阮郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":817,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题扇诗","author":"田娟娟","text":"烟中芍药朦胧睡，雨底梨花浅淡妆。\n小院黄昏人定后，隔墙遥辨麝兰香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":818,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄木元经","author":"田娟娟","text":"闻郎夜上木兰舟，不数归舟祇数愁。\n半幅御罗题锦字，隔墙裹赠玉搔头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":819,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"慰元经","author":"田娟娟","text":"碧玉杯中琥珀光，灯前把劝阮家郎。\n不须苦忆人间世，万树桃花即故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":820,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"病剧寄木生","author":"田娟娟","text":"楚天风雨绕阳台，百种名花次第开。\n谁遣一番寒食信，合欢廊下长莓苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":821,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题树二绝句 其一","author":"木泾","text":"隔江遥望绿杨斜，联袂女郎歌落花。\n风定细声听不见，茜裙红入那人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":822,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题树二绝句 其二","author":"木泾","text":"异鸟娇花不奈愁，湘帘初卷月沉钩。\n人间三月无红叶，却放桃花逐水流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":823,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"悼亡","author":"孟淑卿","text":"斑斑罗袖湿啼痕，深恨无香使返魂。\n豆蔻花存人不见，一帘明月伴黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":824,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"长信宫","author":"孟淑卿","text":"满阶红叶雁声频，永巷秋深最怆神。\n君意一如秋节序，不教芳草得长春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":825,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"香奁冬词","author":"孟淑卿","text":"默坐深闺思有馀，霜威渐觉袭衣裾。\n青绫被冷无鸳梦，紫塞天寒断雁书。\n竹叶舞风侵户响，梅花和月上窗虚。\n双蛾争似庭前柳，腊尽春来忽又舒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":826,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日偶成","author":"孟淑卿","text":"泼眠韶光日正长，虾须帘卷燕飞忙。\n画楼绿暗欹杨柳，舞榭红多睡海棠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":827,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春归","author":"孟淑卿","text":"落尽海棠水拍堤，萋萋芳草望中迷。\n无情最是枝头鸟，不管人愁只管啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":828,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登楼","author":"孟淑卿","text":"为怜春去不登楼，才上南楼动远愁。\n满地落花红雨乱，接天芳草绿云稠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":829,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日书怀","author":"孟淑卿","text":"蝉咽庭槐泣素秋，几行新雁度南楼。\n天边莫看如钩月，钓起新愁与旧愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":830,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过惠日庵访尼题亭子上","author":"孟淑卿","text":"矮矮墙围小小亭，竹林深处昼冥冥。\n红尘不到无馀事，一炷烟消两卷经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":831,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游仙词","author":"朱静庵","text":"洞天春暖碧桃芳，瑶草金芝满路香。\n吹彻玉箫天似水，笑骑黄鹤过扶桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":832,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"长信秋词","author":"朱静庵","text":"长信深沉天路遥，玉阶凉露湿宫袍。\n不辞团扇轻抛掷，双燕俄惊别旧巢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":833,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金陵怀古","author":"朱静庵","text":"石城风起浪声齐，六代兴亡动客思。\n吴苑落花啼杜宇，宋台荒草走狐狸。\n残香犹染胭脂井，遗恨空传璧月词。\n谁道钟山佳气歇，真龙又见起钟离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":834,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"虞姬","author":"朱静庵","text":"力尽重瞳霸气消，楚歌声里恨迢迢。\n贞魂化作原头草，不逐东风入汉郊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":835,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴山怀古","author":"朱静庵","text":"万里中原战血腥，宋家南渡若为情。\n忠臣有志清沙漠，庸主无心复汴京。\n北塞春风啼蜀魄，西湖夜月照瑶筝。\n百年兴废空陈迹，回首吴山落照明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":836,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"惜春","author":"朱静庵","text":"挂树游丝旖旎，扑帘飞絮轻狂。\n杜宇唤将春去，小桃落尽红香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":837,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"竹枝词 其一","author":"朱静庵","text":"西子湖头卖酒家，春风摇荡酒旗斜。\n行人沽酒唱歌去，踏碎满阶山杏花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":838,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"竹枝词 其二","author":"朱静庵","text":"横塘秋老藕花残，两两吴姬荡桨还。\n惊起鸳鸯不成浴，翩翩飞过白蘋滩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":839,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"病中作","author":"朱静庵","text":"剔尽寒灯梦不成，拥衾危坐到三更。\n不知何处吹羌笛，落尽梅花月满城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":840,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"客中即事","author":"朱静庵","text":"华屋沉沉乳燕飞，绿杨深处啭黄鹂。\n疏帘不卷薰风静，坐看庭花日影移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":841,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日见蝶","author":"朱静庵","text":"江空木落雁声悲，霜染丹枫百草萎。\n蝴蝶不知身是梦，又随秋色上寒枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":842,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闺怨","author":"朱静庵","text":"啼鸟惊回晓梦醒，起来无力倚银屏。\n蛾眉未得张郎画，羞见东风柳眼青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":843,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"染甲","author":"朱静庵","text":"金盘和露捣晴霞，红透纤纤玉笋芽。\n翠袖笼香理瑶瑟，绿阴新锭海棠花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":844,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春雨","author":"朱静庵","text":"湿云漠漠雨如丝，花满西园蝶未知。\n金屋晓寒莺语涩，画楼春晚燕归迟。\n宫桃有恨啼红泪，烟柳多情敛翠眉。\n檀板金尊久寥落，孤城愁听角声悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":845,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖曲","author":"朱静庵","text":"湖光山色映柴扉，茅屋疏篱客到稀。\n闲摘松花酿春酒，旋裁荷叶制秋衣。\n红分夜火明书屋，绿涨晴波没钓矶。\n惟有溪头双白鸟，朝朝相对亦忘机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":846,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜坐","author":"朱静庵","text":"吴蚕初出悄无眠，数尽更筹觉暮寒。\n柳色弄阴春已暝，角声吹月夜将阑。\n金炉火冷沉烟细，罗幌风生蜡炬残。\n独坐空庭望银汉，碧天如水露漙漙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":847,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白苎词","author":"朱静庵","text":"西风肃肃天雨霜，馆娃宫深更漏长。\n银台绛蜡何煌煌，笙歌劝酒催华觞。\n美人起舞雪满堂，清歌宛转飞雕梁。\n君王沉醉乐未央，台前月落天苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":848,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春睡词","author":"朱静庵","text":"茸茸芳草含新绿，露井夭桃锦云簇。\n石阑干外早莺啼，又唤春光到华屋。\n绮窗花影摇玲珑，玉人梦破春溶溶。\n云鬟半亸凤钗滑，枕痕一缕消轻红。\n香汗轻轻透衾湿，含情欲起娇无力。\n海棠庭院鸟声和，睡足东风一竿日。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":849,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重阳","author":"潘氏（裘致中妻","text":"独坐小窗下，幽蛩不绝鸣。\n青天孤月静，满耳是秋声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":850,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋月","author":"潘氏（裘致中妻","text":"园亭当水中，两岸芦花雪。\n夜深人未眠，碧水荡秋月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":851,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画","author":"潘氏（裘致中妻","text":"屋傍青山下，人归苍莽中。\n未开云外户，先听水边松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":852,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南浦月下","author":"潘氏（裘致中妻","text":"孤舟横野渚，明月照当空。\n十年江海意，疑在小亭东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":853,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"江上","author":"潘氏（裘致中妻","text":"江上水正平，日照西江口。\n远树一尺长，岸润风吹柳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":854,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"莲塘","author":"潘氏（裘致中妻","text":"溪水流东去，垂杨对我门。\n凄凉断桥路，残月照黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":855,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋词","author":"潘氏（裘致中妻","text":"翩翩黄叶落江风，月满江亭秋夜空。\n黄菊酒香人已醉，白蘋江冷度哀鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":856,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏柳","author":"潘氏（裘致中妻","text":"烟柳青青叶已齐，半帘红日小莺啼。\n玉栖人静悲横笛，惟有东风吹向西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":857,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春词","author":"潘氏（裘致中妻","text":"小窗闲坐月朦胧，望断天涯思不穷。\n黄蝶乱飞花影里，却疑春在杏花中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":858,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西圃","author":"潘氏（裘致中妻","text":"依依杨柳映苍苔，满树桃花映日开。\n不知燕子栖何处，此际东风依旧回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":859,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"连雨","author":"潘氏（裘致中妻","text":"久雨阶前铺绿衣，烟迷竹树影稀移。\n黄莺交坐窗前语，说尽春愁来往飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":860,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"一叶芭蕉","author":"江西妇女","text":"何处移来一叶青，似同罗扇斗轻盈。\n今宵风雨重门静，减却潇湘几点声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":861,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送春诗","author":"李玉英","text":"柴扉寂寞掩残春，满地榆钱不疗贫。\n云鬓霓裳半泥土，野花何事亦愁人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":862,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别燕","author":"李玉英","text":"新巢泥满旧巢欹，尘掩珠帘欲卷迟。\n愁对呢喃终一别，画堂依旧主人非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":863,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"渡钱塘喜晴","author":"王素娥","text":"风微月落早潮平，江国新晴喜不胜。\n试看小舟轻似叶，载将山色过西陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":864,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"独愁","author":"王素娥","text":"黄昏愁听雨萧萧，挑尽残灯夜寂寥。\n彩线罢拈肠欲断，薰笼香冷火应消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":865,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题虎丘壁","author":"朱桂英","text":"梵阁频临入紫霞，凭阑极目渺无涯。\n天连瀚海三千里，烟锁吴城十万家。\n南北舟航摇落日，高低丘陇接平沙。\n老僧不管兴亡事，安坐蒲团课《法华》。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":866,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送夫四绝句 其一","author":"斗娘","text":"走马离违日，黄花正晚秋。\n君心宜自适，莫为妾多忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":867,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送夫四绝句 其二","author":"斗娘","text":"远逐风尘路，遗书满目愁。\n思君不成寐，月上看牵牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":868,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送夫四绝句 其三","author":"斗娘","text":"寂静闻天籁，愁眠觉夜迟。\n遥怜江海别，残月梦君时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":869,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送夫四绝句 其四","author":"斗娘","text":"因缘嗟不偶，永别事堪伤。\n缝缉多辛苦，君看莫易忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":870,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日","author":"顾茂俭之妹","text":"春雨过春城，春庭春草生。\n春闺动春思，春树叫春莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":871,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"临终诗","author":"嘉定妇","text":"当时二八到君家，尺素无成愧枲麻。\n今日对君无别语，免教儿女衣芦花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":872,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨望","author":"董少玉","text":"睡起凭阑望，残云晚较多。\n雨删花织锦，风熨草铺罗。\n嫩筱平穿阁，垂杨半近河。\n荡舟侬岂敢，莫唱《采莲歌》。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":873,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题西施浣纱图","author":"董少玉","text":"白石澄流水，春来坐浣纱。\n青杨愁隐凤，玄发乱飞鸦。\n倚玉浑无色，传神赖有花。\n蛾眉如淡扫，不在野人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":874,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"塞上晚春忆家","author":"董少玉","text":"新草满长堤，思乡望月迟。\n露桃深中酒，烟柳淡涂眉。\n秋塞关难掩，春江棹可移。\n此身同越鸟，夜夜想南枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":875,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆兄妹","author":"董少玉","text":"秋后梧桐雕落，故园兄弟衔杯。\n旅梦三更烛影，归心千里尘埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":876,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"从夫赴雁门","author":"董少玉","text":"雁门西近胡，一片黄沙地。\n烽火夜连天，角声入云际。\n风月尽悲凄，草木多憔悴。\n况是逐臣妻，那能不洒泪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":877,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送别 其一","author":"董少玉","text":"相看疑是梦，别恨好谁知。\n驿路花将发，离亭柳漫垂。\n浅渚孤舟泊，深山匹马迟。\n凭阑无个事，日日数归期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":878,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送别 其二","author":"董少玉","text":"飞尽杨花别，相看不自由。\n征人望绝塞，少妇倚空楼。\n易换春前色，难听角里愁。\n无情江上水，日日送行舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":879,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"采莲曲 其一","author":"董少玉","text":"看山望湖南，乘风望湖北。\n绰约荡轻舟，荷花减颜色。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":880,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"采莲曲 其二","author":"董少玉","text":"杨柳遮大堤，游女往何处？\n云破棹歌寒，鸳鸯时飞去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":881,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆别","author":"董少玉","text":"忆别河桥柳，青青送马蹄。\n妾心与羌笛，无日不辽西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":882,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄夫在岢岚","author":"董少玉","text":"流落客边州，刀环在马头。\n莫怜杨柳色，管取只封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":883,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]