[{"title":"闺怨一百首次孙西庵原韵 其三十六","author":"郭辅畿","text":"池上鸳鸯解合欢，人间一只是孤鸾。\n书来消渴因谁病，瘦尽腰围总不看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38428,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其三十七","author":"郭辅畿","text":"素书修得寄秦嘉，不劝君餐亦自加。\n微物侑函惟橄榄，回甘滋味在归家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38429,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其三十八","author":"郭辅畿","text":"蓂荚无端换叶新，闺心客况不同春。\n知君未是封侯骨，费尽黄金莫怨人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38430,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其三十九","author":"郭辅畿","text":"南方茉莉尽重台，偏向阿奴闷里开。\n妖庙屡抽签不准，明神无力遣郎来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38431,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其四十","author":"郭辅畿","text":"何来风雨忽移天，才过花朝又禁烟。\n怎似深闺身未嫁，桃开梧落不知年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38432,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其四十一","author":"郭辅畿","text":"君如兰竹骨难肥，却羡人间金带围。\n几见曹刘曾及第，英雄何必耻空归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38433,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其四十二","author":"郭辅畿","text":"遥山暗暗雨将成，妾命天心两不明。\n待寄芙蓉花已病，隔江归雁做秋声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38434,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其四十三","author":"郭辅畿","text":"艳句新词满綵笺，晓风残月六郎天。\n如何制尽江南曲，不记江南相府莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38435,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其四十四","author":"郭辅畿","text":"一朝花睡是归期，欢绪朦胧有枕知。\n梦欲留郎天不背，觉来浑似别初时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38436,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其四十五","author":"郭辅畿","text":"阶前百卉傍人生，只耗春光不耗情。\n豆蔻相思应见泪，花虽含笑不闻声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38437,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其四十六","author":"郭辅畿","text":"关河无处不霜鼙，池草虽青路必迷。\n浪子勿谈游侠事，近来骁将出山西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38438,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其四十七","author":"郭辅畿","text":"竹边蟹眼侍儿煎，谷雨新茶又一年。\n料得游人茶量减，独持酒上卖花船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38439,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其四十八","author":"郭辅畿","text":"春暮花寒玉树庭，诗心因病暂无灵。\n忆君疑中金鳌蛊，何用寻常本草经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38440,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其四十九","author":"郭辅畿","text":"七夕将来云是罗，小词闲赋忆秦娥。\n针神锦字看如土，转悔当初巧太多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38441,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其五十","author":"郭辅畿","text":"杏褪红衣柳贴毡，落花积得可铺天。\n世间缺事填难尽，愿补神仙簿上缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38442,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其五十一","author":"郭辅畿","text":"木兰香楫趁文禽，笑折红莲价似金。\n剩得莲房嗟独宿，擘开莲子亦无心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38443,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其五十二","author":"郭辅畿","text":"好花愁雨柳愁烟，正是江南醉里天。\n莫怪罗裳消素质，夜来风雨四更前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38444,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其五十三","author":"郭辅畿","text":"生女叮咛莫嫁儒，秋悲春病总离居。\n如何彤管诗千首，薄命佳人亦读书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38445,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其五十四","author":"郭辅畿","text":"门前江水断肠流，泥自沉沉水自浮。\n万物春来皆助恨，错呼萱草作忘忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38446,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其五十五","author":"郭辅畿","text":"远路柳花多似林，青楼从古费黄金。\n祇愁钱树同朝槿，不及寒松比妾心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38447,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其五十六","author":"郭辅畿","text":"爱似琼花叶似蒲，人心翻复似朝晡。\n命乖不嫁多情婿，自拔金钗击唾壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38448,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其五十七","author":"郭辅畿","text":"物理将来仔细陈，茶虽嫌旧墨嫌新。\n凭将茶意迎新爱，留取墨心照旧人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38449,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其五十八","author":"郭辅畿","text":"幽窗花气夜来清，新试冰弦指尚生。\n抱向蕉前弹一曲，就中大半是哀筝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38450,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其五十九","author":"郭辅畿","text":"紫罗麝冷小香囊，云鬓眼多亦减光。\n一朵千金呼不惜，文章偏博探花郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38451,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其六十","author":"郭辅畿","text":"月情荒尽酒魂癫，欲睡惊啼梦不延。\n提起远山愁更聚，祇因游子住眉边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38452,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其六十一","author":"郭辅畿","text":"秋草湖边稻未齐，蓼花汀上雁难栖。\n荆榛世路行休早，恐惹寒蛩怨玉蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38453,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其六十二","author":"郭辅畿","text":"六幅湘裙懒换新，镂金箱子宿红尘。\n一春都为愁荒却，寂寞翻成劳碌人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38454,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其六十三","author":"郭辅畿","text":"短行欺郎奔月宫，秋风夜夜桂花红。\n奴非窃药因何罪，一样孤眠风露中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38455,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其六十四","author":"郭辅畿","text":"金炉无气烛无情，险韵拈来尽仄声。\n不信历中添日刻，短宵依旧未天明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38456,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其六十五","author":"郭辅畿","text":"烟湿银床寒叶多，迥文欢织又停梭。\n黄昏户外连天雨，谁认春江旧绿波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38457,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其六十六","author":"郭辅畿","text":"去年相送出城隅，郎秉青骢妾乘车。\n为爱团圆明镜好，欲将分赠又踟蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38458,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其六十七","author":"郭辅畿","text":"佳期一别似青天，石作郎心有恁坚。\n岂是相思难得梦，数宵原自不成眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38459,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其六十八","author":"郭辅畿","text":"绣花无力倚银钩，双鹊欺人又过楼。\n天作红墙遮路断，拟将飞渡作扁舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38460,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其六十九","author":"郭辅畿","text":"妾爱香奁拟七言，盈盈花句注春泉。\n君才能作淩云赋，未许相如到日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38461,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其七十","author":"郭辅畿","text":"花笺书价费钗金，四壁虽空未卖琴。\n荏苒不知寒又到，落花曲里奏愁心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38462,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其七十一","author":"郭辅畿","text":"松心柏誓理须坚，负妾何妨且负天。\n不合嫁郎才大艳，香名争觅孝廉船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38463,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其七十二","author":"郭辅畿","text":"将军徵卒费铜符，云火烧天地作炉。\n此去故人谁解橐，襄中应贮荔枝图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38464,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其七十三","author":"郭辅畿","text":"晓色青青满浦云，春潭琼草怨夫君。\n到今兰露供朝饮，读遍离骚客不闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38465,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其七十四","author":"郭辅畿","text":"鸳鸯树上岁华深，散作空庭一夕阴。\n离恨天高谁补得，且敲娲石制秋砧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38466,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其七十五","author":"郭辅畿","text":"白露催寒乌夜啼，倦游公子未归西。\n月明多感为云薄，免使偷光照惨栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38467,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其七十六","author":"郭辅畿","text":"折来兰叶忆三湘，君认高唐作故乡。\n记得明珠曾佩去，当归何意竟相忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38468,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其七十七","author":"郭辅畿","text":"采采柔桑三月天，养成新茧作琴弦。\n君颜好似轻盈女，恐被蚕娘看少年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38469,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其七十八","author":"郭辅畿","text":"豆蔻含春初嫁郎，阿魁夜夜守空房。\n何堪重作参商隔，欲把星辰一改张。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38470,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其七十九","author":"郭辅畿","text":"几拍胡笳吊葬祭，红颜异代总同悲。\n回头乍见含泥燕，危坐巢中说乱离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38471,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其八十","author":"郭辅畿","text":"案畔灯花并蒂娇，钦天妙法闰良宵。\n仙郎自在人心上，眼底何时慰寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38472,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其八十一","author":"郭辅畿","text":"楚水秦关万里馀，奁前今日剖双鱼。\n九州异事盈囊底，犹喜能编风俗书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38473,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其八十二","author":"郭辅畿","text":"虎丘山下客郎当，浪迹摇摇似绿杨。\n抛却闺中红粉妇，漫题诗句吊真娘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38474,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其八十三","author":"郭辅畿","text":"晨起题梅倩墨娥，蜜香新纸蘸烟波。\n书中不作寻常字，单问名山游几多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38475,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其八十四","author":"郭辅畿","text":"茅亭竹径是君家，一入尘寰鬓星华。\n何必秋怀偏感菊，满园春菜亦黄花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38476,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其八十五","author":"郭辅畿","text":"人间何处有安流，滟滪堆前莫放舟。\n纵不归来行不得，鹧鸪声在北山头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38477,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其八十六","author":"郭辅畿","text":"花离芳树叶离条，瘦尽裙边一捻腰。\n今夜扬州明月好，儿夫应过玉人桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38478,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其八十七","author":"郭辅畿","text":"闲愁拟向醉中灰，玉液能倾酒一杯。\n身似孤云难入梦，琼花影里独徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38479,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其八十八","author":"郭辅畿","text":"昔爱兰芳助倩妆，曾教银插种天香。\n祇今倾国谁相识，欲傍红窗树白杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38480,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其八十九","author":"郭辅畿","text":"汤汤锦水古今哀，卖酒炉前变却灰。\n卓女琴心原未妒，祇缘司马不怜才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38481,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其九十","author":"郭辅畿","text":"凤笺麟管写新题，吟遍柳枝又竹枝。\n却怪淑真香句里，断肠全不为分离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38482,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其九十一","author":"郭辅畿","text":"清画深深枫叶红，轻纨力薄未成风。\n人情偏似风情变，每到秋来不肯东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38483,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其九十二","author":"郭辅畿","text":"多感殷勤惠八行，附来兰麝更盈囊。\n阿侬自是香生体，何用龙涎远寄将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38484,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其九十三","author":"郭辅畿","text":"叶上瀼瀼天酒浓，栏前花醉骂东风。\n风如吹得郎心转，谢尔封姨蜀锦红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38485,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其九十四","author":"郭辅畿","text":"绣户重帷不锁愁，随风来共影相酬。\n凄凉正恨窗前竹，又听秋声出鼓楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38486,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其九十五","author":"郭辅畿","text":"痴山拙路作游媒，引动征轮去不回。\n安得蚕丛生户倾，禁郎变足凿离开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38487,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其九十六","author":"郭辅畿","text":"佳人奇士出燕山，月冷金台人未还。\n好向风前寻侠客，莫从弦管醉朱颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38488,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其九十七","author":"郭辅畿","text":"花为流韵玉为神，何日郎君向我亲。\n骰子拈来低喝采，成双偷占意中人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38489,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其九十八","author":"郭辅畿","text":"转绿翻红无定时，曾从贫贱识西施。\n于今最恨张京兆，不做高官不画眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38490,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其九十九","author":"郭辅畿","text":"西舍青蚨似雨飞，东家白玉大如围。\n儒生落魄休相笑，只愿奇书满载归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38491,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨一百首次孙西庵原韵 其一○○","author":"郭辅畿","text":"去日真同逐队鸠，归时还似渡河牛。\n天公好为偿春债，补尽风光卖尽愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38492,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居 其一","author":"郭辅畿","text":"岩谷栖寒一片毡，奇书良酒是神仙。\n高轩不枉怀金玉，短策羞持对绮筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38493,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居 其二","author":"郭辅畿","text":"叶落叶萌花两世，月来月去事千年。\n自知贫骨宜山性，饱听黄鹂枕石眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38494,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南澳辞郎州 其一","author":"郭辅畿","text":"烟雨苍茫古渡头，辞郎谬说侍郎洲。\n河山极目忠臣恨，云树迷津义士愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38495,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南澳辞郎州 其二","author":"郭辅畿","text":"盼断征尘枯石化，挥残别泪竹斑留。\n徘徊忆得当年事，枫叶芦花远浦秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38496,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"祀灶诗","author":"郭辅畿","text":"楮镪纷纷祝灶前，闻君今夜去升天。\n郭生胎骨由来傲，不结人间炙手缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38497,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋蓬晚望","author":"郭辅畿","text":"秋心游子独，晚照终山分。\n浅浦悬鱼影，微烟簇雁群。\n年光如落叶，长梦寄归云。\n流水清无语，钟声何处村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38498,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山寺有访","author":"郭辅畿","text":"携酒寻佳友，衣纱染翠烟。\n磬音清似茗，僧意澹如泉。\n石静知逃世，山空自悟禅。\n夜谈忘日暮，聊复浩歌还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38499,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏夜","author":"郭辅畿","text":"深更无夏意，兰气发秋芽。\n户隙灯通月，窗傍树宿霞。\n团圞妃子扇，绰约六郎花。\n自拨金炉灰，烹泉试凤茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38500,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江行","author":"郭辅畿","text":"寺磬帆间落，鱼炊浦上通。\n夕阳山骨外，长路鸟声中。\n草意随波绿，花情傍晚红。\n石泉清可掬，先饮有青虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38501,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春城即事","author":"郭辅畿","text":"傍砌苔痕翠，栖梁燕语高。\n湿云笼醉杏，细雨洗新桃。\n人只春衣冷，心摇午梦劳。\n情丝飘似絮，慵倒玉壶醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38502,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]