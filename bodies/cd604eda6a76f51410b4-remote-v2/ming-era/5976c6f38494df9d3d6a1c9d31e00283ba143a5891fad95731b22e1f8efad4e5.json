[{"title":"送族侄悟会试","author":"孙绪","text":"万里天香袭佩裾，六街尘土没征车。\n离亭风笛回辕处，宦海云程发轫初。\n疏傅归来真老悖，封胡久矣重庭除。\n他年勋业期无负，漳水河边此敝庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17060,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谢郭巡按楠推荐 其一","author":"孙绪","text":"逢人怕问小山吟，野水沙田自陆沉。\n风定晚葵还向日，云来高树易成阴。\n相知常按朱门剑，报国谁同绣斧心。\n夜据槁梧频引颈，蓟南烟雾望中深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17061,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谢郭巡按楠推荐 其二","author":"孙绪","text":"柱史封章贲草莱，渚凫汀鹭共惊猜。\n松筠苦节霜应识，枯槁经年雨未来。\n天下澄清先北冀，闽南人物重西台。\n长安虽近无由到，梦里逢君笑口开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17062,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄题赵明府十松轩二首 其一","author":"孙绪","text":"小阁凭虚瞰远江，断岩呈秀映涛泷。\n檐前日对青松十，云外时来白鹤双。\n屈指默听声淅淅，累觞遥望影幢幢。\n庙堂梁栋须珍重，一榻清阴月满窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17063,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄题赵明府十松轩二首 其二","author":"孙绪","text":"南溪深处小山亭，石枕藤床任醉醒。\n四座烟霞双眼碧，一庭风露十松青。\n疏帘有月邀清影，惊鹤盘云自远汀。\n尽日推窗看未厌，杖藜夜夜独来听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17064,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"提学王侍御应鹏枉顾用老杜秋兴八首韵见贶次韵奉谢 其一","author":"孙绪","text":"高风劲节振词林，一路霜威万木森。\n到处溪山供好句，无言桃李自新阴。\n停桡许我同清话，倾盖还谁识素心。\n感慨未忘还切切，撩人何处送秋砧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17065,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"提学王侍御应鹏枉顾用老杜秋兴八首韵见贶次韵奉谢 其二","author":"孙绪","text":"参差坞曲断墙斜，反锁衡门发半华。\n敢恨长街啼露叶，忽从深谷见星槎。\n凄凉往事妨秋枕，淅沥悲风趁暮笳。\n明日汉阴亭上望，绕篱寒菊又黄花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17066,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"提学王侍御应鹏枉顾用老杜秋兴八首韵见贶次韵奉谢 其三","author":"孙绪","text":"漂泊孤云映落晖，隔篱灯火望中微。\n半窗寒月虫如诉，万里晴空鸟自飞。\n慰藉谩劳青眼在，乖疏恨与素心违。\n何须苦羡莼鲈脍，漳水波深鱼正肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17067,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"提学王侍御应鹏枉顾用老杜秋兴八首韵见贶次韵奉谢 其四","author":"孙绪","text":"醉中握槊静中棋，遣兴真成喜塞悲。\n远辱轩车辉白屋，敢将书剑负清时。\n天空野旷青骢健，风急波深綵鹢迟。\n北望旌旗见烟树，茫然何地寄相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17068,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"提学王侍御应鹏枉顾用老杜秋兴八首韵见贶次韵奉谢 其五","author":"孙绪","text":"木落天空独见山，西风常日到林间。\n莲塘菊圃秋方淡，莎径柴门夜不关。\n自爱閒鸥相伴住，喜从威凤识君颜。\n远期内直金莲贵，蚤押中朝玉笋班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17069,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"提学王侍御应鹏枉顾用老杜秋兴八首韵见贶次韵奉谢 其六","author":"孙绪","text":"野云低度短墙头，白草丹枫趁远秋。\n贾傅才名成底事，张衡词赋易生愁。\n几年坚癖辽东豕，万念都输海上鸥。\n画舫清流羡君去，漳河直北是瀛州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17070,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"提学王侍御应鹏枉顾用老杜秋兴八首韵见贶次韵奉谢 其七","author":"孙绪","text":"淳庞默挽得全功，英俊都归杖屦中。\n几处槁枯还化雨，层空山斗识高风。\n断厓霜静波新绿，远壑秋深叶尽红。\n朝宁旧游如见问，甘陵陵下一衰翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17071,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"提学王侍御应鹏枉顾用老杜秋兴八首韵见贶次韵奉谢 其八","author":"孙绪","text":"骢马翩翩路不迤，新诗慰我小塘陂。\n清名琬琰看千叶，碧海珊瑚只一枝。\n积恨敢吟东武句，抗容深愧北山移。\n别来相忆浑如梦，秋雨秋风帘自垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17072,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寓意","author":"孙绪","text":"看尽云山此杖藜，布袍随意坐山溪。\n心无困扰柴关迥，梦有馀閒野鸟啼。\n囊里桐音多旧谱，岩前树色试新题。\n美人望望家何在，流水桥东竹坞西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17073,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"初度宿马嘉贞周溪别墅三首 其一","author":"孙绪","text":"高树连云野水边，朱帘红袖映芳筵。\n不才深负桑蓬志，忍泪哀歌莪蔚篇。\n鹏翼扶摇看巧宦，虫雕辛苦忆当年。\n林丘处处堪忘世，何必苏君二顷田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17074,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"初度宿马嘉贞周溪别墅三首 其二","author":"孙绪","text":"水头秋思动疏枝，鸟外烟霞佐酒卮。\n衰老怕逢初度日，娇痴翻忆少年时。\n世无鲍叔谁相念，坐有韩娥醉不辞。\n太乙长庚俱浪说，夜深引领望南箕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17075,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"初度宿马嘉贞周溪别墅三首 其三","author":"孙绪","text":"五十四年山泽癯，懒从朋旧话居诸。\n壮心尽付沙头鹭，生计都非屋里书。\n九陌市尘天漠漠，一帘风露夜如如。\n屠龙手段今安在，笑挽栀鞭策蹇驴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17076,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戊子除夕","author":"孙绪","text":"日日头颅白发增，乖疏终老汉阴亭。\n江山今古此除夕，朋辈几人如晓星。\n占岁细看新凤历，引年深负旧熊经。\n角声处处东风外，坐惜韶华不忍听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17077,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭李公从二首 其一","author":"孙绪","text":"水自潺湲月自明，画船红烛记君行。\n连床已负平生约，败壁空题旧日名。\n老泪可堪吴季重，何人解惜李宣城。\n伤心忍死封书处，大半欹斜字不成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17078,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭李公从二首 其二","author":"孙绪","text":"沉沉清夜起新愁，处处逢人说旧游。\n粉署黄堂真一梦，怨云凄雨识孤舟。\n无儿更溯漳南泽，有恨应怜水上沤。\n回首方川隔今古，数声啼鸟故园秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17079,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送刘芸窗西行二首 其一","author":"孙绪","text":"湘帘漠漠晚阴阴，四壁寒灯一夜心。\n往事几回还执手，离忧大半付悲吟。\n薄裳应怯秋风劲，弱质宁堪夙露侵。\n咫尺柴门天万里，毕家庄上暮云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17080,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送刘芸窗西行二首 其二","author":"孙绪","text":"当年有竹轩中酒，半榻清风一局棋。\n今日周溪桥下路，两行红泪几篇诗。\n夜谈不尽鸡偏恶，秋色含悽鸟未知。\n归去西园寻旧迹，梧桐萧瑟雨声悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17081,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜宿杨师文别墅","author":"孙绪","text":"窥林纤月印庭除，曲水崇堤尽不如。\n寂寞一区杨子宅，芸缃万轴邺侯书。\n槐阴有子今成市，草色侵阶晚未锄。\n别后思君何处是，閒云无数夜窗虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17082,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"漫兴","author":"孙绪","text":"绿树葱茏透月明，夜凉如水葛衣轻。\n捧心一笑千金重，拥鼻孤吟四座倾。\n对景未忘伤往事，指天终不负芳卿。\n灯花落尽棋声碎，多少行人识姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17083,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭杨师文二首 其一","author":"孙绪","text":"北村风景总非前，记得西堂醉共眠。\n中散已亡琴自绝，徐生忍见榻犹悬。\n停云低度孤帷月，滞雨空迷万里天。\n泉路莫嗟浮世短，秋灯稚子夜如年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17084,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭杨师文二首 其二","author":"孙绪","text":"万变何如一局棋，宦途随处策勋奇。\n皂囊未惬朱云愿，素履惟应白日知。\n蚤向人间先溘露，夜归天上定骑箕。\n汉阴亭畔花如锦，还似留君不住时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17085,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"庚寅除夕寓朴庄别墅","author":"孙绪","text":"藜杖龙钟野水边，云霄壮志尚依然。\n一家此地都三口，半夜残灯是两年。\n端揆故人情渐薄，疮痍稚子老偏怜。\n梅花疏冷君休笑，明日春风下九天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17086,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"辛卯人日","author":"孙绪","text":"春波试暖绿粼粼，泰律初回未浃旬。\n百代光阴真过客，一年岁序又逢人。\n杜陵豪句愁仍在，方朔占书迹已陈。\n残照满庭双袖手，乱鸦声里柳条新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17087,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"小轩即事","author":"孙绪","text":"野水溶溶草树荒，高轩谁问郑公乡。\n门开风入笔如剑，窗破月来书在床。\n万变依稀都是梦，半生宠辱已相忘。\n鹤长凫短君休笑，终遣缁尘远素裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17088,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"嘉靖癸巳余甲子既周戏集唐句二律自寿 其一","author":"孙绪","text":"绿杨如发雨如烟，家在枚皋旧宅边。\n世事茫茫难自料，清诗句句尽堪传。\n丹台已运阴阳火，算老重经癸巳年。\n日暮长堤更回首，何人倚剑白云天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17089,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"嘉靖癸巳余甲子既周戏集唐句二律自寿 其二","author":"孙绪","text":"绿树重阴盖四邻，世情谁是旧雷陈。\n帘前春色应须惜，梦里输赢总未真。\n白酒酿来缘好客，金鱼多解乞佳人。\n五湖烟水郎山月，得见明时下寿身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17090,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过杨师文墓","author":"孙绪","text":"四十馀年老友生，独堪羸马过佳城。\n碧天万里晚风劲，斜日半林秋草平。\n修短共谁谈物理，踽凉今日见人情。\n著鞭欲去重回首，辜负山阳夜笛声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17091,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜坐怀王守信守信病久不出","author":"孙绪","text":"棋边久不见王生，月色虫声满户庭。\n杜老有情怜日暮，陶潜无酒怨云停。\n雄谈已爽年前约，霜疢空閒肘后经。\n安得对床同听雨，汉阴亭上一灯青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17092,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"弟善甫亡后数年再过其别墅","author":"孙绪","text":"万景都非此复过，绿阴还是旧婆娑。\n花当结子天机在，树不成行野意多。\n漠漠鸰原空下泪，悠悠蚁梦自南柯。\n夜床谁共姜肱被，暮笛愁谈向秀歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17093,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"商景贞草虫画二绝 其一","author":"孙绪","text":"碣石移山小，微风动红蓼。\n青蛙禁不鸣，寂寞池塘晓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17094,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"商景贞草虫画二绝 其二","author":"孙绪","text":"红芳开未繁，蜂蝶乱如织。\n莫羡上林春，同是东风色。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17095,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"李侍御秋霜瘁草卷","author":"孙绪","text":"揽辔西川路，霜飞玉简寒。\n繁枝俱殒落，明月满秋山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17096,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鱼樵图","author":"孙绪","text":"抱膝余长吟，息肩君赏音。\n歌罢解携去，山高江水深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17097,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"野鹤图","author":"孙绪","text":"云来雨满溪，天迥风生壑。\n山水谐于心，独树孤琴鹤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17098,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和杨师文短吟四首 其一","author":"孙绪","text":"春花饶艳色，春禽鸣好音。\n脉脉花前醉，悠悠别后心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17099,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和杨师文短吟四首 其二","author":"孙绪","text":"绿酒映花红，花枝美人醉。\n非关醉欲眠，思君坐成寐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17100,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和杨师文短吟四首 其三","author":"孙绪","text":"把手江头别，风波奈远人。\n清欢何日是，掷珓问江神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17101,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和杨师文短吟四首 其四","author":"孙绪","text":"羞整越罗裳，晨梳到晚妆。\n盟心秋水白，举首远山苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17102,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪 其一","author":"孙绪","text":"弱态风飘下上，寒姿地势高卑。\n疏密任君舞弄，险夷待我平治。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17103,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪 其二","author":"孙绪","text":"雪压天容甚近，日落风威未休。\n今夜冰合曲巷，明朝水添御沟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17104,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪 其三","author":"孙绪","text":"入望青山易老，深岩梅树差强。\n见说剡溪来往，何人伊洛门墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17105,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"松下问童子图","author":"孙绪","text":"羽客朝元去久，山翁有约来迟。\n风驭遥遥何在，云飞处处堪疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17106,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陆时明还镇江","author":"孙绪","text":"北固山前江水平，南徐城外月华明。\n故乡朋旧惊相问，几日除书下帝京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17107,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白头翁","author":"孙绪","text":"知止应无弋缴忧，平林斜日共悠悠。\n羽毛不预世间事，一任傍人笑白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17108,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"司马相如 其一","author":"孙绪","text":"一拂冰弦万古思，娉婷谁不愿齐眉。\n可堪题柱荣归后，不似临邛初见时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17109,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"司马相如 其二","author":"孙绪","text":"淋漓醉墨洒桥梁，意气横空组绶长。\n回顾文君通一笑，不将风韵学裴航。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17110,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"司马相如 其三","author":"孙绪","text":"临风一曲凤求凰，窗外时时腻粉香。\n风定月明人去后，孤囊今夕又藤床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17111,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题马嘉贞画四绝 其一","author":"孙绪","text":"孤琴岩壑昼阴阴，涧雨山风野水深。\n咫尺断桥心万里，美人家在翠微岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17112,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题马嘉贞画四绝 其二","author":"孙绪","text":"雨后青山画不如，山蹊深处野人居。\n花开花落年年事，閒看溪桥策蹇驴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17113,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题马嘉贞画四绝 其三","author":"孙绪","text":"看山不尽扣舷歌，双眼浮云万顷波。\n尽说鲈鱼称莼菜，秋风秋雨奈愁何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17114,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题马嘉贞画四绝 其四","author":"孙绪","text":"小桨从教野水欺，短檐偏受朔风吹。\n得鱼换酒且同醉，老尽青山总不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17115,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉和相国费鹅湖先生游待隐园","author":"孙绪","text":"一径烟霞入望深，鸟声终日在高林。\n涧边幽草青如织，谁识江湖后乐心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17116,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题扇寄杨师文三首 其一","author":"孙绪","text":"杖藜谈笑出幽林，囊底丝桐物外心。\n古调即今谁复爱，竹风山雨旧知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17117,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题扇寄杨师文三首 其二","author":"孙绪","text":"短棹横江酒满罂，细鲈偏称紫莼羹。\n何年共向茅亭醉，卧听潇潇暮雨声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17118,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题扇寄杨师文三首 其三","author":"孙绪","text":"倦客维舟倚短松，乱云流水愧行踪。\n蓬窗今夜乡关梦，飞出前山第几峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17119,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寒鸦万点图二绝 其一","author":"孙绪","text":"谷口重阴锁未开，寒风应识夜啼哀。\n南飞下攫皆无计，不见丹山老凤来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17120,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寒鸦万点图二绝 其二","author":"孙绪","text":"高树平柯满上林，夕阳未下昼阴阴。\n谁从群啄争餐处，识得无穷返哺心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17121,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谢安东山","author":"孙绪","text":"松声淅淅水声清，一曲秦筝万古情。\n自是东山无宦况，非干红粉误苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17122,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东波琴操","author":"孙绪","text":"词锋如箭口悬河，一语投机大梦吪。\n今日平康谁得似，只闻鞍马夜来多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17123,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"小斋即事 其一","author":"孙绪","text":"记得清明共此游，北窗眼望重回头。\n重来徙倚情何限，烟雨茫茫风满楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17124,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"小斋即事 其二","author":"孙绪","text":"静倚危樯水气高，一竿终日印惊涛。\n谁知我亦丝纶手，不解西江掣巨鳌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17125,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"古怨","author":"孙绪","text":"短发垂垂飏晓丝，疏槐落落怯秋飔。\n巫娥欲赴高堂梦，须及襄王未老时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17126,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"即事","author":"孙绪","text":"烟雨茫茫失远村，东陵瓜地傍衡门。\n袖中双剑依然在，换得黄牛教子孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17127,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为卢宗玉题画二首 其一","author":"孙绪","text":"杖藜偏称紫纶巾，画舫清流处处新。\n谁向山蹊更回首，竹桥西畔问幽人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17128,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为卢宗玉题画二首 其二","author":"孙绪","text":"高兴无惭秋水清，画船箫鼓一身轻。\n江天遮莫浮云变，鸥鹭烟波自有情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17129,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]