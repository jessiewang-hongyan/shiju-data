[{"title":"中秋郊送龙节 其一","author":"陈仁锡","text":"使命光生貔虎台，中天玉树尽花开。\n满城喧鼓尊王事，五采流霞绣上台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46081,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋郊送龙节 其二","author":"陈仁锡","text":"涛沸中秋都似雷，碧天如洗见蓬莱。\n东方月出来何晏，一朵红云拥节来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46082,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋郊送龙节 其三","author":"陈仁锡","text":"中州宗学被甄陶，骏惠文孙天语褒。\n自有玺书耀河岳，奚劳玉兔数纤毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上雒王","author":"陈仁锡","text":"天上来时水不旺，黄河自古辟洪荒。\n九年宗学胥称伯，一举秋闱独让王。\n松为著书深岁月，鹤因窥句步天潢。\n悬知乐善东平意，神庙奎章日月光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴大中丞年伯即席 其一","author":"陈仁锡","text":"帝念民劳露处啼，旌旗初下慰云霓。\n两河动静关秦晋，一剿回夷振鼓鼙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴大中丞年伯即席 其二","author":"陈仁锡","text":"圣主何尝讳灾异，天风应急奏颠黎。\n微臣忧杞先河决，好障中原与岳齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋 其一","author":"陈仁锡","text":"月华冷于霜，水白已成路。\n飞鸟静不鸣，羽毛纷可数。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋 其二","author":"陈仁锡","text":"何处不相思，中天照彻时。\n昌期逢圣主，月桂长新枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋 其三","author":"陈仁锡","text":"梦见关山候，愁闻风雨时。\n羁人新荡样，月影下波迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋 其四","author":"陈仁锡","text":"游人凡气尽，历历是神仙。\n但恐神仙去，独留冰雪天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋 其五","author":"陈仁锡","text":"心与鸥俱白，琴将鹤共弹。\n忽闻松子落，微听水流潺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋 其六","author":"陈仁锡","text":"无计留月住，孤城绝域看。\n居延击刁斗，闺梦到城难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋 其七","author":"陈仁锡","text":"秋气变人天，烟云胜昨年。\n能教肌骨换，人似鹤翩跹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋 其八","author":"陈仁锡","text":"几见月当头，况逢此夜秋。\n忧勤不问夜，宵旿唤穷愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出陈留忆汴 其一","author":"陈仁锡","text":"日涉芳园忆故知，纷纷芳草乱如丝。\n我行永久逢君至，执手如观未见书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出陈留忆汴 其二","author":"陈仁锡","text":"从来明月不须期，流水因风珠玉随。\n万叶秋都客梦里，平江何日不相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46096,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出陈留忆汴 其三","author":"陈仁锡","text":"曲度间云意自迟，夜阑独酌强裁诗。\n江山待我皆如旧，况有新红劈荔枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46097,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出陈留忆汴 其四","author":"陈仁锡","text":"闻说嵩山礼旧师，青囊许我共抽丝。\n苍颜古貌滋朝气，载酒飞花有夜珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46098,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出陈留忆汴 其五","author":"陈仁锡","text":"暮云草树更长林，宇净山空月色深。\n别意不须问流水，且倾三百万重心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46099,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出陈留忆汴 其六","author":"陈仁锡","text":"煮茗遍馀松桂心，引杯延赏涤烦襟。\n开红成幄翠如雨，鹤叫空庭夜未深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46100,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出陈留忆汴 其七","author":"陈仁锡","text":"剪烛巴窗话雨时，翛然太古白云姿。\n花鲜月出人皆醉，静读黄庭意欲迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46101,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出陈留忆汴 其八","author":"陈仁锡","text":"卧起何须改旧诗，名园幽兴白华滋。\n本无轩冕萦怀抱，遥寄秋风渡马迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46102,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出陈留忆汴 其九","author":"陈仁锡","text":"汉室穷经礼宿师，伏生老矣拜昌时。\n献王纂雅褒天口，歆向披忠长玉枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46103,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出陈留忆汴 其十","author":"陈仁锡","text":"秋风摇落动归思，诠理谈玄自有师。\n坐看云起两不厌，前村孤屿一题诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46104,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出陈留忆汴 其十一","author":"陈仁锡","text":"今日河南异昔时，官司倾盖有心知。\n更饶一段贤王意，设罍陈樽并载诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46105,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出陈留忆汴 其十二","author":"陈仁锡","text":"诗囊珍重冠周南，药灶封题云气函。\n自汴过陈皎倍五，举杯邀月影还三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46106,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过归德董太守万司理即席夜泛","author":"陈仁锡","text":"别有幽溪路自通，坐看秋镜挂墙东。\n乍移巨海澜生紫，忽坐仙舟灯已红。\n雨洗晴来天汉杪，月明人住水都中。\n四更照彻清讴发，绿竹乌纱影许同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46107,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再赴亮社与万司理 其一","author":"陈仁锡","text":"星聚商丘再举樽，南州留辖素风存。\n重闱寿祉怡王母，大被论文治弟昆。\n秋水为神拔奇士，閒云随我涉疏园。\n归来案牍浑无事，入奏平反劝举飧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46108,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再赴亮社与万司理 其二","author":"陈仁锡","text":"夜阑始觉湿衣裳，闻道广寒深且长。\n绕岸唐隋分古树，隔林笑语属长杨。\n蛟龙寂听惊人句，鸥鸟慈依牧郡场。\n有客明朝重载酒，相逢还似水中央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46109,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再赴亮社与万司理 其三","author":"陈仁锡","text":"历落风尘总不知，海棠开遍探阑迟。\n邦君好客翻寻主，亮社多贤乐取斯。\n绿长羲台问奇字，白分轩帝带松枝。\n文章一变人稽古，砥柱狂澜自得师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46110,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南宿州吴观察过访 其一","author":"陈仁锡","text":"元祐重题庆历游，醉翁在不举杯酬。\n霜飞佛戟雄观察，影动星辰愧大丘。\n鸿雁消沉愁赤地，蛟龙掀舞撼神州。\n干戈满地惊时事，泗上登高理壮筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46111,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南宿州吴观察过访 其二","author":"陈仁锡","text":"楚云吴树乍相逢，夜访何须醉浊醪。\n野簌山肴篱绽菊，泉香酒美客持螯。\n风回湘泽新营垒，雷动江淮利挽漕。\n泗水诸侯观壁上，溪沙鱼鸟贼诗豪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46112,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄询同门庐州严太守","author":"陈仁锡","text":"使君标格如何拟，淡月寒空笼白梅。\n风土清嘉吏事少，空庭梳羽鹤徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46113,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南宿州有感","author":"陈仁锡","text":"轮蹄四出拥荒丛，剪草编蓬立藁灰。\n十载久沉鸿雁信，八分不住版曹催。\n凿溪层垒开除道，因亩高低曲沼隈。\n闻说形家秀文脉，运沟一带水波回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46114,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜谒张许二公庙 其一","author":"陈仁锡","text":"二十四郡录元戎，一丸孤堞障环中。\n曲江齐唱升平乐，府制更张鱼钥空。\n魂魄毅兮如可作，胆肝铁也与谁同。\n风狂昼掩怍投拜，整顿山河北镐丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46115,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜谒张许二公庙 其二","author":"陈仁锡","text":"嗟公逝矣瞿阳空，叹息谁者无梦翁。\n蘋藻古城旌义烈，萧条原野响寒虫。\n当年熊虎驰戎马，此日仳离叹转蓬。\n下土茫茫谁告语，双悬神镜照民穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46116,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月朔过王庄偶读高适闭门无不可何事更登高句漫成三绝 其一","author":"陈仁锡","text":"古人悔归迟，三径随刈藁。\n有客近家园，芙蓉树树好。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46117,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月朔过王庄偶读高适闭门无不可何事更登高句漫成三绝 其二","author":"陈仁锡","text":"乍见衣薪者，秋都惨不号。\n低头弗敢问，何忍复登高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46118,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月朔过王庄偶读高适闭门无不可何事更登高句漫成三绝 其三","author":"陈仁锡","text":"遥习古人语，酒酣读书骚。\n长怀康济念，闭户即登高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46119,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中渡淮有感 其一","author":"陈仁锡","text":"澎湃神水争，萧条淮泗横。\n如何安若命，且莫问庄生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46120,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中渡淮有感 其二","author":"陈仁锡","text":"滁州不种马，千里稻田枯。\n空坐两太仆，劳劳付笑歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46121,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中渡淮有感 其三","author":"陈仁锡","text":"海运昔防漕运阻，新河今废旧河功。\n石堤洛马三百里，泇口彭城齐汎舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46122,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中渡淮有感 其四","author":"陈仁锡","text":"泗水山头坐御史，风风雨雨一孤蓬。\n断崖崎石嗟行路，破屋颓垣赋草虫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46123,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶忆泇河善后纪事","author":"陈仁锡","text":"泇河几百里，天下皆道斯。\n邳峄烦供忆，移邮设捕司。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46124,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江心道中 其一","author":"陈仁锡","text":"石田亦可耕，愿人行好事。\n舆中聊自吟，田父荷杖至。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46125,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江心道中 其二","author":"陈仁锡","text":"田父如何说，中情慨以慷。\n下车入其室，举手贺年康。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46126,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江心道中 其三","author":"陈仁锡","text":"年康不可失，遗秉寡妇攘。\n及此召业户，官家蠲逋粮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46127,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江心道中 其四","author":"陈仁锡","text":"子粒何可得，买牛筑道傍。\n邻人且协贷，处处熟黄粮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46128,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江心道中 其五","author":"陈仁锡","text":"邻人不贷牛，一荒连坐九。\n同我妇子馌，出入互相友。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46129,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江心道中 其六","author":"陈仁锡","text":"举善甲期会，凿城计户口。\n所在置沼池，积水良可久。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46130,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江心道中 其七","author":"陈仁锡","text":"守卫勿准状，军牢勿下乡。\n指挥戒私敛，牧夫急贤良。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46131,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江心道中 其八","author":"陈仁锡","text":"百善至仪真，金汤亘千里。\n勤将此法行，田畯至止喜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46132,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江心道中 其九","author":"陈仁锡","text":"汉主自临河，金钱曷足数。\n人人皆抱薪，谁识徙薪苦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46133,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江心道中 其十","author":"陈仁锡","text":"倒影入寒塘，青青映垂柳。\n回头见青山，形影俱何有。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46134,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江心道中 其十一","author":"陈仁锡","text":"乍见钓鱼人，时逢斫草妇。\n崎岖小径行，大道如莽芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46135,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"广武卫道中茶庵 其一","author":"陈仁锡","text":"树密山隈立马看，卧牛冈岭近前滩。\n乍闻似落前峰涧，久听方知近佛龛。\n未许尘容驻奔马，可教幽客写经函。\n病僧间傍溪边立，黄叶萧萧一草庵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46136,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"广武卫道中茶庵 其二","author":"陈仁锡","text":"城头便有山林色，野树蒙茸老岁年。\n低屋短垣门欲扃，花香酒熟鸟如弦。\n依依仙窟桃源里，小小溪深灵隐间。\n山水之滨容我老，半肩行李载轻烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46137,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"关山谒庙 其一","author":"陈仁锡","text":"且就关山赊月色，何妨复岭一登高。\n神皋共庆丰年乐，广武宜知稼穑劳。\n紫殿驾车轻绝塞，严霜杲日动征袍。\n十年未雪辽山耻，不斩楼兰负宝刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46138,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"关山谒庙 其二","author":"陈仁锡","text":"青青古柏插苍穹，写出丹里半岭红。\n双悬古井分清浊，独镇天中馘寇戎。\n洪武最先龙虎战，宋家漫说赵韩功。\n清流一派停公旆，百万雄兵谁与同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46139,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"关山谒庙 其三","author":"陈仁锡","text":"磨剑清泉静可探，游人三过为停骖。\n乱抽山筱栖寒野，净洗云根傍野峦。\n煮橡斋厨挑水急，寻诗玄室下山淹。\n远公送我真远矣，高阁应许日搆蓝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46140,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛未重九前四日以封册至自滁太仆徐翁夜深载酒赋诗 其一","author":"陈仁锡","text":"论交十载上公车，携手邮庭月色华。\n颇牧久高青镇闼，夔龙先借课骝骅。\n间吟昔赋春梅赠，司鼓重将秋菊挝。\n商略龙兴建置意，救时应泛丈人槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46141,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛未重九前四日以封册至自滁太仆徐翁夜深载酒赋诗 其二","author":"陈仁锡","text":"梓里同朝事圣君，秋山暮色细论文。\n三生石上曾留句，双井楼头好宿云。\n孳牧万群来渥马，屯田千里覆黄馧。\n月明载酒重扶醉，市口岩边数马勤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46142,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"滁州 其一","author":"陈仁锡","text":"牧人何处秼清湍，廿万金钱空范韩。\n百二山河雄发刱，万千铁骑盛鸣銮。\n国初累诏蠲租厚，奕叶承平放马宽。\n所在戎夷羁衅鼓，纷纷缯市掷壶餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46143,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"滁州 其二","author":"陈仁锡","text":"寒花满谷馥初晴，匹马关山倚杖寻。\n半热黄云贲穷坏，乍看紫气净阴霖。\n千家烟火炊新黍，一夜秋声急逮砧。\n南国层峦锦带远，授衣抉纩庆平成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46144,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"滁州 其三","author":"陈仁锡","text":"半村半郭树栖霞，耆旧山川总一家。\n风俗葛天追朴雅，衣冠晋代薄浮誇。\n山阴并美差无竹，阳羡同幽只少茶。\n昨月中秋册金简，晴云又覆孟嘉纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46145,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"滁州 其四","author":"陈仁锡","text":"稚子盈门岂渥洼，故园松菊自成家。\n抽书夙好初盈几，摘藕方鲜旦及瓜。\n借问芙蓉开几树，不知丹桂剩馀花。\n江南数月多风雨，碧玉琅玕未可誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46146,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙兴寺 其一","author":"陈仁锡","text":"昙花绣佛古招提，苍藓云封鸟雀栖。\n可惜风霜涂五色，剩残罗汉貌深黧。\n天台钟鼓隔凡呗，雁荡褰裳渡远溪。\n西望滁阳埋骨处，山河日月国恩齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46147,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙兴寺 其二","author":"陈仁锡","text":"琅玡山势近龙蟠，更有龙兴号古禅。\n铁铸弥陀青著眼，梦移关像小容龛。\n佛容争说李唐古，刹寺犹将显德刊。\n罗汉画神并画骨，泥金深处皱容宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46148,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙兴寺 其三","author":"陈仁锡","text":"剩有琅玡续后游，山僧指点翠云稠。\n近连丰乐浮青髻，遥拥关山戴冕旒。\n风雨龙吟杂树吼，月明人影共波流。\n重阳独立金山顶，此地吾将一梦留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46149,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙兴寺 其四","author":"陈仁锡","text":"登楼侧听吟哦近，疑载米家诗画过。\n寂寂武功剩铭碣，寥寥文事滞蹉跎。\n青山萝擘衣幽客，深树云来隐硕薖。\n六一山头深醉处，好将文字耀山河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46150,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重阳前一日憩瓜州息浪庵侯风 其一","author":"陈仁锡","text":"瓜州台畔沸如雷，此地安禅我亦陪。\n龙像似盂悬印坐，金银浮玉引青来。\n人头忽向浪中出，帆影惊翻波底回。\n卓赐五州烦寄语，法轮高出海门来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46151,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重阳前一日憩瓜州息浪庵侯风 其二","author":"陈仁锡","text":"西望五州呼冶净，高僧破衲共衾裯。\n三山宝刹朝阳供，一水甘泉吸浪收。\n客去客来逢九日，寻花寻酒触虚舟。\n老僧夜夜持龙咒，入定何妨云海游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46152,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金山渡舟","author":"陈仁锡","text":"三十年前太守约，金山一叶驾云招。\n三僧盛事吾堪纪，恰值重阳访佛寮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46153,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]