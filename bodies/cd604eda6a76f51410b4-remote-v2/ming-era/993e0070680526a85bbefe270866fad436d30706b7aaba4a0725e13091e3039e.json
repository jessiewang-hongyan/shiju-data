itle":"九日晚复同虎臣过伯玄饮湖上楼四首 其四","author":"欧大任","text":"楼前列岫碧崔嵬，仆仆先生黄鹤来。\n遥动仙人一瓢酒，看余东海渡蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6349,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦故姊夫郭明府邦翼","author":"欧大任","text":"世缘何事尽空花，梦向乌衣问谢家。\n地下金棺应有恨，不从勾漏饵丹砂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6350,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登霸王台属骤雨至","author":"欧大任","text":"何处崤函风雨来，楚天摇落正悲哉。\n玉门西眺凭陵下，不见乌骓走汉台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6351,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋晚同陈使君张进士饮喻园五首 其一","author":"欧大任","text":"淮上园林树已殷，使星入部照江关。\n习池未少风流兴，拚与山公倒载还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6352,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋晚同陈使君张进士饮喻园五首 其二","author":"欧大任","text":"空濛山翠朗陵开，楚客悲秋且莫哀。\n病后登临枚叔在，城头何羡景夷台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6353,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋晚同陈使君张进士饮喻园五首 其三","author":"欧大任","text":"金渠馆里似江湍，傍艇飞来白雪寒。\n十里芙蓉双桨过，五湖秋色醉中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6354,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋晚同陈使君张进士饮喻园五首 其四","author":"欧大任","text":"清尊曾共谢公游，客岂羊昙泪亦流。\n摇落丹枫前日路，不知何处是西州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6355,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋晚同陈使君张进士饮喻园五首 其五","author":"欧大任","text":"大陆风高万马腾，喻家围上放秋鹰。\n霸台东去堪回首，落木荒山入固陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6356,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王侍御纯甫量移内江令六首 其一","author":"欧大任","text":"当时谏猎禁庭闻，憔悴孤城汝水云。\n稍得戴星湔上去，汉家迁客最怜君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6357,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王侍御纯甫量移内江令六首 其二","author":"欧大任","text":"秋风栈道马踌躇，万里蚕丛念谪居。\n君自楚人兰作佩，岷江西上莫投书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6358,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王侍御纯甫量移内江令六首 其三","author":"欧大任","text":"广汉犍为古县存，江通土垒剑为门。\n郫筒酒熟巴童舞，纵谪难忘圣主恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6359,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王侍御纯甫量移内江令六首 其四","author":"欧大任","text":"五岭风烟行部中，按章谁似鲍家骢。\n武溪玉笛门人奏，犹忆楼船一剑雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6360,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王侍御纯甫量移内江令六首 其五","author":"欧大任","text":"锦城游处浣花寒，秋色飘零尚楚冠。\n九折畏途行叱驭，坂前人作使君看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6361,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王侍御纯甫量移内江令六首 其六","author":"欧大任","text":"翩翩仙令有王乔，江县青枫路未遥。\n凫是尚方曾赐舄，明年飞入紫宸朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6362,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"光州北楼观雪二首 其一","author":"欧大任","text":"汝海风生万壑雷，飞霙吹过汉王台。\n醉看半似秦关路，马首梅花片片来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6363,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"光州北楼观雪二首 其二","author":"欧大任","text":"杨子江深雪满舲，黄河冰侧挂帆青。\n六花又向淮楼见，那得蓑衣钓洞庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6364,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴虎臣之楚四首 其一","author":"欧大任","text":"风流江左陆平原，入洛深怀国士恩。\n车马东西交聘日，怜才谁似楚王门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6365,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴虎臣之楚四首 其二","author":"欧大任","text":"开府千秋作赋名，幕中宾客布衣情。\n西风大别涛如雪，君但褰裳采杜蘅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6366,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴虎臣之楚四首 其三","author":"欧大任","text":"解佩湘妃去不回，至今啼雁楚天哀。\n词人只自誇云梦，明月珠旗大猎来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6367,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴虎臣之楚四首 其四","author":"欧大任","text":"楼开鄂渚万枫丹，酾酒同谁七泽看。\n莫向江潭独醒去，九歌天阔白云寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6368,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郡中送膳钱至苜蓿斋渐有酒矣戏呈同僚二首 其一","author":"欧大任","text":"馆里高歌似郑虔，藜羹麦饭已经年。\n何来阿堵呼儿举，谁信先生只有毡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6369,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郡中送膳钱至苜蓿斋渐有酒矣戏呈同僚二首 其二","author":"欧大任","text":"江州刺史苏司业，似胜屠沽市上儿。\n便可从君看山色，餐钱今作酒钱支。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6370,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伯玄既答隑州行复饷双鹅重以绝句更和一首","author":"欧大任","text":"道士崇虚六翮飞，鹅群掩素草书稀。\n隑州赋共筠笼至，绝胜山阴野雉肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6371,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同赵新息行次唐县闻龚判官从舞阳已赴商城","author":"欧大任","text":"贾父何因并辔来，行谈渤海使君才。\n千山不共衔杯日，东指松陂过汉台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6372,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南阳馆夜闻淯水溜声颇似吉州滩流也枕上有作","author":"欧大任","text":"匹马关山倦客情，宛城高阁淯河声。\n北风吹梦江乡去，一夜扁舟雪浪行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6373,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"弥陀寺西馆方秀才见过","author":"欧大任","text":"宾客通家似孔融，标鲜满坐有兄风。\n一时童子即无数，看尔含香入汉宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6374,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题紫云山黄道士院","author":"欧大任","text":"紫云山里黄花洞，十里襄城路不迷。\n童子芝图何日授，玉池风谷具茨西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6375,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]