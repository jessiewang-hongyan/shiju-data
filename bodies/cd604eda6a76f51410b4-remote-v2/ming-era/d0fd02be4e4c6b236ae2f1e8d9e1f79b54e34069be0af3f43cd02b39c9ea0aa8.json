[{"title":"次韵张林泉兄弟倡和三首 其三","author":"董纪","text":"别来几度菊花黄，三径至今浑未荒。\n再见不无存没感，登高更忍作重阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55308,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丙寅岁旦试笔","author":"董纪","text":"偻指浮生半百过，少年豪气渐消磨。\n人来献岁无他祝，乡里衣冠剩不多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55309,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赵松雪承旨瘦马图","author":"董纪","text":"将军老去已封侯，汗血功成百战秋。\n得放华阳春草里，黄金何必更笼头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55310,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻鹊","author":"董纪","text":"昨夜灯花旦鹊声，不知有意与无情。\n丁宁稚子应门去，今日人来好出迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55311,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王母醉归图","author":"董纪","text":"玉麋驮醉夜阑珊，又是瑶池赴宴还。\n青鸟只通方朔信，如何再不到人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55312,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"二乔图","author":"董纪","text":"乔家姊妹尽知书，宫样云鬟学得梳。\n虽在流离欢亦足，中郎有女不能如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55313,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伍胥庙","author":"董纪","text":"谁载西施出五湖，一朝麋鹿上姑苏。\n后人说起亡吴恨，犹向台边酹子胥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55314,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华清池","author":"董纪","text":"幸蜀殃根在一身，香囊忍委马嵬尘。\n池中只有残汤水，不见当时出浴人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55315,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"昭君图","author":"董纪","text":"莫恨丹青画不真，后宫那得更无人。\n和亲果是宁边计，何惜区区妾一身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55316,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贵妃袜","author":"董纪","text":"脱下凌波一瓣莲，当时掷弃马嵬前。\n偶然老媪收藏得，犹有痴人费看钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55317,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡船老翁","author":"董纪","text":"送人北去又南来，路口垂杨眼见栽。\n自有此船摇此渡，几回到岸几回开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55318,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠隐者张山人","author":"董纪","text":"蒲团竹榻乌皮几，羽扇纶巾鹤氅衣。\n不独市朝无此客，山间林下见应稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55319,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友人续弦","author":"董纪","text":"煎得鸾胶续断弦，玉台新镜更团圆。\n刘晨合有神仙分，寻着桃源洞里天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55320,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题扇次韵姚比玉","author":"董纪","text":"甫里西来笠泽东，扁舟髣髴似龟蒙。\n旧时记得相逢处，恰与如今画里同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55321,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"深溪隐居图为广东参议金华王公正","author":"董纪","text":"故家百年乔木阴，清泠莫测深溪深。\n珊瑚已受钓竿拂，风雨时时龙一吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55322,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题姚澹如画扇寄梁彦思大尹","author":"董纪","text":"青山深处白云多，茅屋依然在涧阿。\n借问隐君归去后，故园秋色近如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55323,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春山晓思图为佥宪林彦恭","author":"董纪","text":"阁雨轻云已弄晴，窗间曙色渐分明。\n幽人正被宿酲恼，啼鸟隔帘三四声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55324,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题扇","author":"董纪","text":"蹇驴乘兴雪中来，踏遍江村不见梅。\n咫尺有无须一到，寒香寥落寺门开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55325,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画二首 其一","author":"董纪","text":"冻云压树雪漫山，楚尾吴头髣髴间。\n日暮天寒鸟飞绝，此翁何事却忘还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55326,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画二首 其二","author":"董纪","text":"春山寂寂鸟不鸣，阿咸自求弦上声。\n更无知音一赏遇，胸次磊磈难为平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55327,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚午除夕风雨大作因思壬戌岁除在按察司官舍无异今夕瞬息之间已及九载慨今念昔不能无怀遂赋此","author":"董纪","text":"向来除夕灯前雨，身在他乡忆草堂。\n今夜草堂还守岁，灯前听雨说他乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55328,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与太常典簿顾谨中题画二首 其一","author":"董纪","text":"髣髴风烟笠泽东，吴山不与越山同。\n谁家楼阁停歌舞，旧是夫差避暑宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55329,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与太常典簿顾谨中题画二首 其二","author":"董纪","text":"滕王高阁倚江浔，画栋珠帘岁月深。\n南浦西山晴复雨，后人朝暮几登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55330,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵丁和仲","author":"董纪","text":"草书入圣过张颠，笔底龙蛇势宛然。\n路破草堂铁门限，人来乞字不论钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55331,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画","author":"董纪","text":"一从刘阮离天台，洞口桃花几度开。\n知道再无相见日，当时不放出山来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55332,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵沈文举为凤阳钱文规题画","author":"董纪","text":"一自移家禹会村，十年不出草堂门。\n旧时桑梓今看尽，夜夜九山劳梦䰟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55333,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"盛叔彰山水","author":"董纪","text":"山北山南秋复春，扁舟为屋树为邻。\n谁能学得天随子，老向江湖作散人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55334,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵岩寺","author":"董纪","text":"采香无径草茸茸，响屧廊头语候虫。\n今日梵王龙象地，行人犹说馆娃宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55335,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画四首 其一","author":"董纪","text":"江蛟上岸作树立，月下风前号鬼神。\n山泽几年无隐逸，衣冠夜出是何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55336,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画四首 其二","author":"董纪","text":"或时风雨或时晴，任我渔舟到处行。\n朝去暮来头自白，水光山色有何情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55337,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画四首 其三","author":"董纪","text":"偶然行到水穷处，隔岸无船人不渡。\n白云出岫已多时，夕阳犹在西岩树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55338,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画四首 其四","author":"董纪","text":"流水响时石碍，好山缺处云遮。\n咫尺溪桥过去，茂林脩竹谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55339,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"斜塘晚泊","author":"董纪","text":"路入斜塘日已昏，田家犬吠出篱根。\n老翁开户惊相问，何处船来夜识村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55340,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画五首 其一","author":"董纪","text":"罢钓归来不汝期，无心说起烂柯时。\n仙家岁月真如许，也向山中看奕棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55341,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画五首 其二","author":"董纪","text":"水光山色晓苍茫，远树浮岚寺半藏。\n还尽夜来听雨债，片帆今日过潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55342,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画五首 其三","author":"董纪","text":"鼓瑟齐门事已非，抱琴何惜赏音稀。\n有弦争似无弦达，閒看閒云出岫飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55343,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画五首 其四","author":"董纪","text":"江上青山可隐居，钓船到处有鲈鱼。\n姓名却在人间世，只恐安车诣草庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55344,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画五首 其五","author":"董纪","text":"门外数株韦偃树，屋头一带巨然山。\n江南旧日经行处，多有人家似此间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55345,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书所见二首 其一","author":"董纪","text":"下马见人头不低，青楼日日醉如泥。\n杏花坛上摴蒱散，又向城东看斗鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55346,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书所见二首 其二","author":"董纪","text":"眉扫春山髻绾云，银条纱䙏藕丝裙。\n倚阑跛立娇无语，手托香腮酒半醺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55347,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"打姑恶二首 其一","author":"董纪","text":"有树莫容姑恶栖，尔何怨姑犹怒啼。\n人家有儿亦有妇，不愿使闻如尔妻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55348,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"打姑恶二首 其二","author":"董纪","text":"姑恶何恶怨未终，世人至今无此风。\n尔啼莫来近我屋，我姑不与尔姑同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55349,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题扇","author":"董纪","text":"无人学得广陵散，月白风清试一弹。\n万籁不鸣群动息，九霄云外舞青鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55350,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"屏风画意二首 其一","author":"董纪","text":"杏花如锦柳如丝，髣髴西湖二月时。\n诗意不过模画意，何须画里更题诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55351,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"屏风画意二首 其二","author":"董纪","text":"一番雨过一番凉，红藕花开满屋香。\n四面阑干都傍水，倒看云影度天光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55352,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"附宽河书后寄周仲鼒父子二首 其一","author":"董纪","text":"始终情意两蹉跎，离恨虽多话亦多。\n只有茜溪溪上月，照人一直到宽河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55353,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"附宽河书后寄周仲鼒父子二首 其二","author":"董纪","text":"不是无心不寄书，越添烦恼寄何如。\n那堪一一从头写，欲寄还休意有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55354,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柳下渔舟","author":"董纪","text":"柳阴日日系渔舟，渔妇渔翁尽白头。\n树已半枯人亦老，更堪落叶几番秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55355,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居二首 其一","author":"董纪","text":"茂林修竹是吾庐，身已无官也自如。\n莳药种花筋力倦，北窗高枕教儿书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55356,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居二首 其二","author":"董纪","text":"风雨连朝不出门，晚来步屧看溪痕。\n不知笋过邻家去，篱落新添竹几根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55357,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦茂名兄二首 其一","author":"董纪","text":"两夜郎官入梦频，今朝报喜应斯人。\n侍仪岂是无凭语，只恐衢州信未真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55358,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦茂名兄二首 其二","author":"董纪","text":"久无书札报平安，正惧蛮方抚字难。\n喜见故人亲口说，近时已转赣州官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55359,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦得洛容兄书","author":"董纪","text":"我与细君同梦夜，洛容县里发书时。\n至诚有感通天地，万里归音一夕知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55360,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别侄董时雨二首 其一","author":"董纪","text":"与汝同来汝独归，丁宁语别寸心违。\n丹阳车子龙江舸，明日东西各自飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55361,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别侄董时雨二首 其二","author":"董纪","text":"强近无亲骨肉稀，糟糠有妇不胜衣。\n到家说与痴豚犬，好护瓜田待我归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55362,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵俞东村见示四首 其一 自述草堂之陋","author":"董纪","text":"草茅蔽野出无蹊，寥落衡门水竹西。\n客至尚能留一饭，小儿沽酒妇蒸藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55363,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵俞东村见示四首 其二 忆弟季明","author":"董纪","text":"池塘春草梦依依，明月清风半掩扉。\n今夜灯花何太喜，多应洱海有书归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55364,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵俞东村见示四首 其三 忆武功兄","author":"董纪","text":"宗亲零落重期功，马首何时得向东。\n二十年来乡里变，半登鬼箓半称翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55365,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵俞东村见示四首 其四 中秋对雨","author":"董纪","text":"今夜平分一半秋，可怜兄弟不同游。\n片云将雨非无意，天上姮娥亦为愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55366,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与俞原肃留别十首 其一","author":"董纪","text":"别时容易见时难，莫作寻常客子看。\n二十年来逢一度，四千馀里到长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55367,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与俞原肃留别十首 其二","author":"董纪","text":"别时容易见时难，愁上心来有万端。\n传语不如亲会面，临行欲发又盘桓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55368,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与俞原肃留别十首 其三","author":"董纪","text":"别时容易见时难，对酒当歌且尽欢。\n不就目前同一醉，明朝何处盻征鞍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55369,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与俞原肃留别十首 其四","author":"董纪","text":"别时容易见时难，屈指凡经廿岁寒。\n更去更来能几度，并州已作故乡看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55370,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与俞原肃留别十首 其五","author":"董纪","text":"别时容易见时难，渺渺春江送木兰。\n三叠阳关休唱尽，一声凄楚一心酸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55371,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与俞原肃留别十首 其六","author":"董纪","text":"别时容易见时难，无计相留看牡丹。\n去向洛阳城里过，不知何处可凭阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55372,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与俞原肃留别十首 其七","author":"董纪","text":"别时容易见时难，和恨和愁写一摊。\n若遇后来相忆处，聊将纸上笔踪看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55373,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与俞原肃留别十首 其八","author":"董纪","text":"别时容易见时难，我钓吴淞尔钓磻。\n遮莫子牙钩饵大，四腮风味属张翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55374,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与俞原肃留别十首 其九","author":"董纪","text":"别时容易见时难，芳草萋萋不忍看。\n况是春深无雁过，到家谁与寄平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55375,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与俞原肃留别十首 其十","author":"董纪","text":"别时容易见时难，两地相思总一般。\n世上此情何日已，除非石烂海波乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55376,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶题三首 其一","author":"董纪","text":"东风细雨湿窗纱，日晏黄蜂未报衙。\n芳草满庭随意绿，时时吹落碧桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55377,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶题三首 其三","author":"董纪","text":"青石阑干绕曲池，株株杨柳倒垂丝。\n水心亭上钩帘坐，鱼唼残花口动时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55378,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜泊江上","author":"董纪","text":"雁叫霜汀鹊绕枝，夜长无寐客眠迟。\n一灯隔岸渔船火，愁似江枫对照时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55379,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"匡方人家","author":"董纪","text":"流水溅溅白石滩，疏林红叶半凋残。\n溪边略彴山前屋，如在黄筌画里看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55380,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒江渔者","author":"董纪","text":"浮家一叶小如梭，前载儿孙后载婆。\n今日天寒难下网，芦花深处避风波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55381,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"修竹芙蓉四首 其一","author":"董纪","text":"芙蓉花老碧波寒，竹上湘妃泪未乾。\n日落黄陵庙前路，如今髣髴画中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55382,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"修竹芙蓉四首 其二","author":"董纪","text":"十二峰头月欲昏，阳台梦里旧精魂。\n至今犹恨湘江水，不为娥皇洗泪痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55383,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"修竹芙蓉四首 其三","author":"董纪","text":"竹上当年泪未消，又将红粉湿鲛绡。\n月明听鼓云中瑟，魂断苍梧尚可招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55384,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"修竹芙蓉四首 其四","author":"董纪","text":"黄陵庙前湘水深，苍梧人去杳难寻。\n西风洒遍啼红泪，竹上斑斑恨至今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55385,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕与仲斋守岁语及乡中迁客有感","author":"董纪","text":"赌酒搏拳夜甚哗，故人屈指半天涯。\n梅花冷笑东风里，守岁开筵有几家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55386,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]