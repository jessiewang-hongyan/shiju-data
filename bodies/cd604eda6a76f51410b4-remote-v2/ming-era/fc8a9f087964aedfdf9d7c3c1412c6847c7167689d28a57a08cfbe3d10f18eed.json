[{"title":"霜夜拙清楼闻笛","author":"欧大任","text":"何处悲声起，寥寥入陇头。\n落梅怨遥夜，折柳送清秋。\n月白思乡曲，云黄出塞愁。\n谁知郿县客，听尔泪双流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4653,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋夜梁用宾陈潜甫区惟鼎过宿斋中","author":"欧大任","text":"下榻留佳客，玄谈夜不眠。\n钟声沉浦树，月色淡江烟。\n地胜南皮会，时危北海贤。\n茅斋慰岑寂，何异瀼西田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4654,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬粱彦国过洲上约同游西樵","author":"欧大任","text":"枉策劳相过，秋宵共掩扉。\n候虫当砌响，落叶近窗飞。\n月色砧偏急，溪声渔渐归。\n怜君招隐士，将拂薜萝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4655,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜同黎惟敬梁思伯泛芙蓉溪得秋字","author":"欧大任","text":"旧约寻烟浦，君来属暮秋。\n墙阴含竹色，月影入溪流。\n笛有邀桓步，舟仍访戴游。\n锦袍怜一醉，非是恋沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4656,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵山下经故相方文襄公第","author":"欧大任","text":"相府青山下，风吹戟户开。\n昔时朝士至，今日路人来。\n鹤语留华表，星文坼上台。\n千秋一洒泪，徒有雍门哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4657,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚过九龙洞","author":"欧大任","text":"疲马入云谷，柴门方解骖。\n乍从双瀑下，忽过九龙岩。\n石古苍烟积，峰横落日衔。\n期君负书笈，来此卧松杉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4658,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水帘房","author":"欧大任","text":"珠箔不可卷，石房云出门。\n岩霏侵几席，寒瀑湿兰荪。\n触户时逢鹿，窥书或有猿。\n眷言绝尘鞅，聊以涤烦諠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4659,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寻宝峰寺故址","author":"欧大任","text":"昔人卓锡地，闻有化城开。\n寺是何年废，山经几劫灰。\n雨花今寂寞，霜草独徘徊。\n念此亦几坏，浮生益可哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4660,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伦中郎彦群访予山馆不值","author":"欧大任","text":"公子能相访，主人方远游。\n空惭开径待，不为看山留。\n题凤门犹掩，笼鹅帖未酬。\n他时愿乘兴，来听竹斋秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4661,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪夜同梁仲登泛舟赤花海过水栅十里乃还二首 其一","author":"欧大任","text":"进帆赤石海，似入武陵溪。\n雪浪飞花过，汀洲宿鹭迷。\n断猿霜碛外，哀角烧林西。\n欲访情人去，何时到会稽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4662,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪夜同梁仲登泛舟赤花海过水栅十里乃还二首 其二","author":"欧大任","text":"摇艇冲溪雪，苍茫路不分。\n冒寒琴独抱，遵渚雁为群。\n月下闻河激，烟中遇鄂君。\n新林今夕望，小谢最能文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4663,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"锦溪馆月夜怀黎惟仁","author":"欧大任","text":"夜久众諠息，幽人月下吟。\n潮来疑涧响，家远似山深。\n送客烟中屦，期僧石上琴。\n何由共玄度，于此长禅心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4664,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送滕先生罢官归海盐","author":"欧大任","text":"槜李兵未解，罢归何所如。\n始宁寻别墅，善福寄精庐。\n避地堪招隐，看山更卜居。\n汉家求绝学，应访伏生书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4665,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春晚雨中寄梁仲登","author":"欧大任","text":"念汝离群久，还山已换衣。\n夕猿添客泪，春草待人归。\n花事纷将减，莺声半已稀。\n子荆愁绝处，零雨正霏霏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4666,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁思伯过洲上","author":"欧大任","text":"三径蓬蒿长，谁寻仲蔚门。\n箪瓢忘晏设，文史入宵言。\n散帙或焚蒳，钓鱼时放䑳。\n问津人罕到，不必记桃源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4667,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同郑何二子宿光孝寺颛上人房","author":"欧大任","text":"释子期过宿，诃林访化城。\n宗雷多内学，支遁是平生。\n池月澹禅性，铃风答梵声。\n此中堪出世，不寐听寒更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4668,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寻陈士鹄郭外幽居","author":"欧大任","text":"瀼西还此地，河上独精庐。\n野路渔樵外，江郊霜露馀。\n天寒一瓢酒，岁晏五车书。\n愿就于陵子，灌园何所如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4669,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮杂咏四首 其一 蓬莱阁","author":"欧大任","text":"夜静传真诀，飞仙暂此留。\n飙轮过碧水，羽盖入丹丘。\n鹤语千峰月，松吟万壑秋。\n沧桑今可待，双舄几时游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4670,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮杂咏四首 其二 单道开石室","author":"欧大任","text":"衣褐南来客，罗浮路不迷。\n初行秦甸外，肯止邺城西。\n餐石何须煮，编茅尚可栖。\n千秋蝉蜕地，谢豹为谁啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4671,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮杂咏四首 其三 王野人庐","author":"欧大任","text":"鸡犬云中去，遗墟在观原。\n岭猿啼蕙帐，山叶积柴门。\n夜月穿萝到，春林入涧喧。\n樵苏无可问，知是野人园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4672,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮杂咏四首 其四 轩辕仙人试剑石","author":"欧大任","text":"仙客携长剑，星文乍有无。\n步光开石窌，飞景骇山都。\n龙化何时出，虹流片影孤。\n越金曾敛锷，持此问风胡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4673,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄大行惟和","author":"欧大任","text":"闻道皇华使，偏承汉主恩。\n风云随玉节，岁月待輶轩。\n戏綵歌华黍，分庭拜采蘩。\n何时张博望，飞旆出河源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4674,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同黎惟敬梁思伯游西樵宿云谷洞得存字","author":"欧大任","text":"改岁吾重到，烟萝迹尚存。\n七松吟暝壑，双瀑溅云根。\n夜冷猿啼树，秋深叶满村。\n山林惭大隐，兹夕兴飞翻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4675,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"翠岩在碧云村外","author":"欧大任","text":"风泉鸣日夕，山翠入虚无。\n霁后寻芜径，云中得奥区。\n鹤来窥绿检，仙去长青蒲。\n谢客时攀叶，松门兴未孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4676,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同张中卿吴而待黎惟敬梁思伯何少羽游崇胜寺得霞字","author":"欧大任","text":"步入招提境，鸣钟日未斜。\n僧开白莲社，峰度赤城霞。\n一径苔仍滑，双林桂已花。\n皈依更何日，听尔演三车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4677,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日同梁仲登黄贤甫登刘王郊台","author":"欧大任","text":"把菊复载酒，登台酬赏心。\n荒榛满天地，片雨暗山林。\n代迥华风变，云愁霸气沉。\n十年长剑在，吾欲扫氛祲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4678,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日梁少傅邀游徐道士馆得羊字","author":"欧大任","text":"烦嚣忻暂息，落日过山房。\n坐久积庭叶，磬清闻洞章。\n青城时度鹤，白石忽成羊。\n笑问乘云去，何时到帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4679,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悼马","author":"欧大任","text":"羡女龙媒种，西来渥水旁。\n平生空慷慨，垂死独凄凉。\n细草青春软，黄沙白日长。\n中涓求骏骨，持此报燕王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4680,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"定海门楼眺望","author":"欧大任","text":"把酒烽烟后，登楼草树平。\n山连刘氏苑，江绕粤人城。\n荆北羁王粲，交南老葛生。\n故乡频徙倚，怀古一含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4681,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吉赞渡逢暮雨","author":"欧大任","text":"音书愁里隔，烟火望中分。\n五渡船船雨，千峰树树云。\n洛神波上袜，湘女竹间裙。\n赋客空相忆，瑶华一寄君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4682,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿罗二山居","author":"欧大任","text":"华盖馀秋色，幽居一院云。\n疏松度明月，高卧对夫君。\n檐下鸣蛩近，灯前落叶闻。\n西山鸾鹤在，应自远人群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4683,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西斋梦后作","author":"欧大任","text":"焚舟方得计，策蹇更如何。\n远道非难及，虚名只厌多。\n风泉鸣涧壑，云屋带藤萝。\n宁戚何为者，犹劳叩角歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4684,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答友人","author":"欧大任","text":"贫贱谁相问，生涯知者稀。\n年丰犹粝食，冬冷自荷衣。\n事免心劳拙，形因战胜肥。\n幽期倘不负，日日扫柴扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4685,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜梁师说李少偕入社得情字","author":"欧大任","text":"乐志新成趣，柴门扫雪迎。\n岂期簪绂客，而有薜萝情。\n蒋径过羊仲，梁园待马卿。\n北山旧猿鹤，莫遣怨寒盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4686,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏夜遇雨斋中颇有秋意","author":"欧大任","text":"独宿高斋夜，萧然松桂幽。\n海风频送暑，山雨渐成秋。\n散帙青藜过，鸣琴白雪流。\n潘安犹寓直，谁遣二毛忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4687,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同罗曜文夜饮从弟华宅","author":"欧大任","text":"闻有一斗酒，相携倒接䍦。\n主人非北海，词客似南皮。\n山月照弹瑟，溪风吹钓丝。\n秋怀今夕赋，偏赏惠连诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4688,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别友人归江月","author":"欧大任","text":"复与故人别，相逢知几年。\n客帆归海曲，别酒醉江天。\n草色愁中雨，江声梦里船。\n凭将尺素寄，双鲤到河边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4689,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜坐西斋","author":"欧大任","text":"拥褐观心坐，翛然万念澄。\n焚香齐乱帙，煮药候残灯。\n榻在稀逢客，瓢空懒寄僧。\n住山诸子约，何日遂担簦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4690,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仲秋八日还山有作四首 其一","author":"欧大任","text":"夕马飞偏急，相随归故园。\n秋烟江水暝，落日渡头喧。\n舍者罢争席，老亲欢倚门。\n经时无斗粟，负米向何村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4691,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仲秋八日还山有作四首 其二","author":"欧大任","text":"岂是倦游者，还山意绪真。\n青云疑畏路，黄鹤待归人。\n童应蓬门少，宾来橡饭新。\n明朝谁载酒，应得慰家贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4692,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仲秋八日还山有作四首 其三","author":"欧大任","text":"青冥吾独后，白发每能先。\n世岂高人慢，天惟醉者全。\n歌吟偏海月，渔钓自江烟。\n骨相今如此，栖栖敢受怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4693,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仲秋八日还山有作四首 其四","author":"欧大任","text":"嗒然一室内，生理更如何。\n天地有高枕，江湖仍短蓑。\n书成千载事，剑倚众人歌。\n未厌烟皋冷，秋裳且薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4694,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈潜甫于风雪中见访闻将寻张苏二逸人怅然怀之","author":"欧大任","text":"冷落人踪少，柴荆岁欲残。\n谁曾怜范叔，尔亦问袁安。\n山雪孤窗暗，溪云一棹寒。\n未能从二子，江浦羡渔竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4695,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得黄希尹金陵书答以四韵","author":"欧大任","text":"送君白门去，五载尚为郎。\n握手知何日，题书问故乡。\n潮声江浦雁，秋色石城霜。\n一叶西风外，无因到洛阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4696,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚归壁山渡口","author":"欧大任","text":"岁尽归心促，清猿苦夜吟。\n野阴生泽畔，寒烧隔霜林。\n戍堡丹枫下，渔舟白苇深。\n因思京口宿，曾听万家砧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4697,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻倭夷渐逼潮州海上徵兵甚急感事书怀因寄玄纬四首 其一","author":"欧大任","text":"岂料边烽起，真看到海门。\n楼成疑蜃过，舰失畏鲸吞。\n士气酣三战，夷兵困七奔。\n何当防兽豕，莫使满乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4698,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻倭夷渐逼潮州海上徵兵甚急感事书怀因寄玄纬四首 其二","author":"欧大任","text":"徐吴收战马，闽粤遂夷歌。\n水斗潮难至，郊寒垒渐多。\n鲸鲵今未灭，舟楫问如何。\n尔辈看铜柱，中原有伏波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4699,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻倭夷渐逼潮州海上徵兵甚急感事书怀因寄玄纬四首 其三","author":"欧大任","text":"羽檄纷传箭，龙骧乍拥旄。\n千笳吹月落，万甲积山高。\n筦库群趋府，渔樵半佩刀。\n忧时王景略，头白不堪搔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4700,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻倭夷渐逼潮州海上徵兵甚急感事书怀因寄玄纬四首 其四","author":"欧大任","text":"青岛频多事，苍生今可哀。\n使非徐福去，贽岂越裳来。\n战色千村暮，潮声万舸回。\n赠君惟匕首，行见海氛开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4701,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海上逢丁戊山人自朗宁至","author":"欧大任","text":"戎马殊方急，君今何所之。\n人群仍纵酒，客路只题诗。\n剑倚风尘过，丹成日月迟。\n管宁将度海，莫遣世人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4702,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同傅木虚集黎惟仁招仙馆得来字","author":"欧大任","text":"十方游已遍，端为故人来。\n把臂八年别，随缘千里回。\n清霜疑沆瀣，孤馆即蓬莱。\n预恐云軿去，姑山空汉台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4703,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过潘少承山居","author":"欧大任","text":"门掩深春草，潘尼爱客过。\n世疏金马召，山狎紫芝歌。\n交谊偏泉石，才名仅薜萝。\n茅斋足萧散，高枕更如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4704,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏夜同顾玄纬汪直卿黎惟仁潘少承梁少嘉集雨青楼听雨得钟字时玄纬将归无锡","author":"欧大任","text":"王粲将归夕，登楼意万重。\n风飘残垒角，云掩隔山钟。\n密响过池竹，微凉度涧松。\n他宵那可听，寂寞卧西峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4705,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潘少承枉宿弊庐","author":"欧大任","text":"暂别期相见，呼儿开草堂。\n客频寻孺仲，人已卧良常。\n身世山瓢外，乾坤石几旁。\n惟君能信宿，谁复念沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4706,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答潘少承约游金城寺","author":"欧大任","text":"尺书前日至，丈室几时开。\n客许题诗入，僧期难偈来。\n慧风传梵呗，忍草积香台。\n便逐戴颙去，斯游亦快哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4707,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"发舟黄冈渡过鹿门溪出碧鉴海与少承晚泛","author":"欧大任","text":"山行仍水汎，孤舸逗江干。\n海纳诸溪小，星摇大泽寒。\n苇花因晚白，枫叶入秋丹。\n渺渺人群远，同君且钓竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4708,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重阳前一日同陈梦庚龟山眺集","author":"欧大任","text":"秋兴閒偏逸，家山且杖藜。\n竹洲浮屿外，莲社入林西。\n恩隔萸囊赐，欢先菊酒携。\n明朝还有约，从尔问丹梯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4709,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日陪陈梦庚诸子游佛教台还饮桥东草堂","author":"欧大任","text":"佳赏因君得，怜予大隐情。\n花龛传海梵，草阁送江声。\n言就竹林宴，欣从菊径行。\n龙山千载客，徒有孟嘉名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4710,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十日陈梦庚潘少承见过","author":"欧大任","text":"南里陶徵士，西亭谢法曹。\n相逢重九后，得句白云高。\n三径犹残菊，双尊且浊醪。\n悠然堪一醉，木叶满林皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4711,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访张勤夫不遇","author":"欧大任","text":"家僮空应客，寂寞子云亭。\n山笥閒三赋，云窗老一经。\n剑将何日试，琴岂众人听。\n高咏思君曲，江峰万叠青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4712,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过梁少学斋中","author":"欧大任","text":"词赋堪招隐，非关桂树留。\n餐英含坠露，岸帻醉高秋。\n琴许山僧听，诗因海客酬。\n过从知不厌，犹似竹溪游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4713,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄幼章邀游琪林分得霜字","author":"欧大任","text":"茗宴适秋凉，琳宫开草堂。\n菊侵双涧水，桂落一林霜。\n羽客弹瑶瑟，山人送玉觞。\n翩翩鸾鹤集，何异白云乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4714,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答梁仲登旅馆雨后见怀","author":"欧大任","text":"江馆听潮夜，悠然思所欢。\n雨中佳句至，灯下几回看。\n梦远客衣薄，书迟旅雁寒。\n天涯霜露早，谁共采幽兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4715,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜集苏四丈绍节宅遂过乃侄信伯","author":"欧大任","text":"广除凉月夜，高咏思悠然。\n白社惭吾后，青山羡尔先。\n窗琴风里响，涧水席边悬。\n小阮犹多兴，移尊竹卜眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4716,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中问少傅病","author":"欧大任","text":"梁鸿何所病，莫是忆高恢。\n客岂赁舂者，人疑裹饭来。\n烟霞仍伏枕，梦寐几登台。\n消渴吾犹甚，谁怜羁旅哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4717,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大寒闭关三日","author":"欧大任","text":"浮生万事劳，仲蔚自蓬蒿。\n门掩斜阳尽，山连朔吹高。\n缁尘凋素鬓，鸟雀识绨袍。\n已会沉冥理，何心更续骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4718,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕同惟仁维乔少居幼通集公瑞宅","author":"欧大任","text":"病起能乘兴，淹留曲几凭。\n夜酣千日酒，春入九枝镫。\n欢剧银缸溢，愁深羽檄徵。\n自怜老宾客，高会十年曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4719,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"少承招余夜过山房遣骑邀吴伯纶同会","author":"欧大任","text":"桂树何年隐，招携月下攀。\n尔能寻白社，吾欲老青山。\n玩世芳尊合，狂歌白发閒。\n今宵得玄度，匹马莫先还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4720,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]