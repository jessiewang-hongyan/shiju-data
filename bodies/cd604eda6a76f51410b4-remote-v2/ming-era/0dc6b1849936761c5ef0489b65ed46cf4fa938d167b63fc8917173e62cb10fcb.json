[{"title":"大庾山口晚兴","author":"屠侨","text":"高山屏西日，未晚溪欲昏。\n百丈援滩势，丛篙避石根。\n火明依岸宿，人静听沙喧。\n家室天涯共，扁舟忆故园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28038,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赴梧诸寅饯别阻风夜泊","author":"屠侨","text":"别筵才十里，潮落海珠宫。\n欲挽无高岸，相持有逆风。\n苍茫孤夜泊，想念一樽同。\n新问交州道，山川五岭中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28039,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"水东驿道中","author":"屠侨","text":"炎海东来路，龙川曲避沙。\n江村孤驿舍，竹屋几人家。\n地瘠春无菜，山稠树少花。\n瘴烟愁未已，汗漫薄天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28040,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"龙川舟中雨望","author":"屠侨","text":"二月倾寒雨，龙川逆挽舟。\n山云凝欲冻，瘴雾湿难收。\n古树侵江碧，奇峰峙水幽。\n沾濡何所适，独酌赋清游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28041,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"龙川山行","author":"屠侨","text":"龙江谢舟楫，东麓事晨征。\n寒雨初开霁，春山未老晴。\n烟霞迎日薄，草树隔年荣。\n瞑目肩舆里，静收溪谷声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28042,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"榄潭晚泊怀广城僚旧","author":"屠侨","text":"舣舟沙树合，望瞑水云同。\n夕浦渔烟碧，春山野烧红。\n空流鸣急濑，高月动微风。\n回忆羊城旧，孤怀清夜中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28043,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"建宁山行宿大横驿","author":"屠侨","text":"路转千溪曲，泉分万壑声。\n溪云横夕景，山馆息炎程。\n院立双松古，林栖百鹭清。\n乘凉多暝思，种种旧游情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28044,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"升江西参政同寅饯别黯淡寺","author":"屠侨","text":"高阁临波迥，轻云匝寺阴。\n溪声千古壮，雨意万山深。\n祖席开青嶂，风烟洒素襟。\n行行复何处，随分是吾心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28045,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次文卿清明日老军塘阻风志感","author":"屠侨","text":"水逆兼风逆，难穷汗漫程。\n船头折杨柳，客里过清明。\n江垄凄烟雨，天涯远弟兄。\n相悲重相别，愁绝海云横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28046,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中秋将台玩月是日卢都阃为会","author":"屠侨","text":"几度中秋月，皆从客里看。\n山川照齐鲁，南北聚衣冠。\n玉笛乡心远，金樽露气寒。\n人间此良夜，应共百年欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28047,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"新嘉驿草亭次韵","author":"屠侨","text":"草亭依传舍，幽事坐中新。\n水曲池通井，花繁夏续春。\n风尘为客倦，泉石寄情亲。\n杯酒双蓬鬓，乾坤此是真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28048,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"访从兄监中晚回","author":"屠侨","text":"晚行城北道，捷径过田家。\n阴坂花犹媚，春沟柳自斜。\n鸠含深竹雨，鹜落半天霞。\n农事催将滥，池深处处蛙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28049,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"会饮暮归","author":"屠侨","text":"严城已布柝，醵饮独迟归。\n月暗马知道，风高尘满衣。\n树乌惊自语，云阁渺何依。\n稚子不知漏，残灯半掩扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28050,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿寺","author":"屠侨","text":"有官身许国，随地寺为家。\n夜火联僧榻，晨钟速禁衙。\n瑶宫分世界，白发数春花。\n我辈无穷事，相看绝两涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28051,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"园门晓望","author":"屠侨","text":"晓日园门暗，长波逝远空。\n山云寒带雨，霜柳弱摇风。\n郭索江秋老，鹈鹕水信丰。\n甬东誇海胜，原自有龙宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28052,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"积雨书闷","author":"屠侨","text":"烟火朝昏促，柴桑雾霭浓。\n高门催黍酿，野户急村舂。\n晨正忧荒岁，天胡雨孟冬。\n沈思步屧外，江阁暗晨钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28053,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鄮山桥","author":"屠侨","text":"望城三十里，野寺鄮山桥。\n废垒官奴县，残碑至正朝。\n青山来欲暮，秋水未全消。\n坱北风烟?，扁舟思寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28054,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"直院","author":"屠侨","text":"夏夜院空寂，钟来远寺扬。\n风摇孤烛短，人忆故山长。\n冷泊云霄气，淡流星月光。\n对兹浑不寐，天地息苍茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28055,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"写王天锡扇面","author":"屠侨","text":"落木风色淡，江涵万里秋。\n青山出波末，飞鸟近船头。\n执卷怀千古，澄心无一忧。\n长须此乘兴，城北是东洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28056,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次李少泉岳祠暇集","author":"屠侨","text":"岱岳开祠古，幽遐此共临。\n虚堂延野色，高阁碍峰阴。\n山月皎当户，朋僚喜盍簪。\n清樽忘永夜，一洗俗尘心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28057,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送友人游灵谷寺出朝阳道中","author":"屠侨","text":"胜事灵山愿一偿，春城十五出朝阳。\n日边云布梅时雨，马首风吹柏子香。\n涉夏酒多新市白，占年麦喜过人长。\n陵宫寂寂朱栏护，龙卧深山万古藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28058,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"病居对雨","author":"屠侨","text":"秋雨萧萧夜及晨，酿寒云气涨高旻。\n鸡愁隔幔还妨客，雀啄巡檐不避人。\n著叶声声初滴沥，随风濯濯太崩沦。\n无端沸动虚堂思，瘦损还吟病里身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28059,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"代题寿父母图","author":"屠侨","text":"闻说瑶池会事新，郁葱佳气北堂辰。\n青铜月满明珠箔，白发茎疏照锦茵。\n箫管凤凰台上侣，儿孙兰蕙圃中人。\n风霜亦屡疑春色，乌鹊年年渡汉津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28060,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"访同年陶奉川舟发城南","author":"屠侨","text":"小雨城南动晓船，长春门外柳如烟。\n客情淡泊观流水，行色萧条忆往年。\n江麦纤纤留燕语，汀花冉冉足凫眠。\n推窗慢数修程事，看尽人家雨后田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28061,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"云深楼晚眺题付住僧清涛","author":"屠侨","text":"汝有窦山百尺楼，白云朝夕深悠悠。\n乳峰烟雨千林暮，飞雪岩台六月秋。\n镜水芜平莎鸟立，藤花风落野猿愁。\n我来未尽登临兴，记尔青春卜再游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28062,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与秋官孙敏中宿佛塔亭次日陶明府行厨为会","author":"屠侨","text":"夜宿招提境上头，故人飞简此重留。\n青封入案酒筵暮，白鸟下溪山雨收。\n同榜分于南北尽，百年情属主宾酬。\n令君拟有观风日，漫写新诗纪胜游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28063,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"江头晚步","author":"屠侨","text":"薄晚江行意若何，夕阳微影漏林柯。\n缘崖白鸟玄沙浅，隔岸青山绿树多。\n下网人听潮外语，入村船载渡头歌。\n观澜不用登遐绝，百里蛟门送海波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28064,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送同年万汝信北上","author":"屠侨","text":"同陟金台映聚星，分明梧竹肖君形。\n两年簪佩北归阙，三日云山东过庭。\n梅雨沧江行汗漫，翰音瀛海入青冥。\n秋风我亦期当发，记别桃花第一汀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28065,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过宁波寺登览","author":"屠侨","text":"落日川桥野寺幽，风篁雨蔓碧遭周。\n居连一舍今方到，胜接三江昔未游。\n门外沧波飞白鸟，殿前红叶偃深秋。\n鸡声隔竹啼寥寂，僧在薜萝宫里头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28066,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"正月十五夜平望驿看月有怀","author":"屠侨","text":"平望驿前春水平，元宵月里画船行。\n湖光汗漫一千顷，人意欢欣三五明。\n胸次若于星汉朗，歌声自得里闾情。\n回头漠漠家乡远，聊遣春庭有弟兄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28067,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"渡淮","author":"屠侨","text":"风送淮流四十程，船头急鼓溯涛声。\n海光荡日长鲸没，春色窥帘细柳晴。\n天地襟喉当吐纳，江河经纬孰裁成。\n分明国脉源源在，更重微臣万里情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28068,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过济望南旺湖","author":"屠侨","text":"长堤柳外望悠悠，山远天空万顷浮。\n渔牧几家生计薄，凫鹥春水野情幽。\n扁舟草泽谁真隐，二月洲田半妇耰。\n东兖源流夫子国，获麟犹记古河陬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28069,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"淮阴吊古送刘南村归吴","author":"屠侨","text":"汗漫长淮万里天，秋风城下古祠边。\n黄茅野屋封高柳，白日云沙走逝川。\n尘世几登洴澼眼，英雄一去百千年。\n不堪皓首江湖上，短烛孤篷坐闇然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28070,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"按浮图谷山行至暝","author":"屠侨","text":"突兀山程汗漫行，晚风添恋仆夫情。\n烟霏暝里河流壮，鼓角声中戍火明。\n暸卒空闻传急柝，步邮何处咽寒钲。\n看星直到西南际，夜宿浮图已二更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28071,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"茌平道中","author":"屠侨","text":"杨柳川原绿已稠，晓风吹鬓尚如秋。\n地寒花重齐南恨，山远云连鲁北愁。\n雪后渐看麰入秀，雨前刚好谷新耰。\n行人昔是东台使，民物还叨管戚休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28072,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月夜宝应湖漫兴","author":"屠侨","text":"宝应洲前万顷波，月明载酒夜深过。\n濯缨高唱沧浪曲，鼓枻遥闻渔父歌。\n铜鼓船头鼍出听，玉箫云里凤来和。\n青天丛桂寒宫敞，清影真看舞素娥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28073,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"入京口遣兴","author":"屠侨","text":"行色忽惊春已暮，乡心无奈梦相牵。\n瓮城潮送江南路，虎寺峰临柳外天。\n云影恍疑金木相，日华遥瞩凤麟妍。\n再圆招宝山前月，十日桃花渡口船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28074,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"经西湖","author":"屠侨","text":"青山锦水春深过，酒舫渔舠镜里同。\n三竺烟霄迷去鹤，六桥歌管渡飞虹。\n风云气识将军庙，凫鹜沙连处士宫。\n寂莫行边无伴侣，伐柯清思碧林中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28075,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿九牧铺","author":"屠侨","text":"旧路梨关重问馆，浮踪云陆半分程。\n青山对我还相识，白发当年已渐生。\n九牧名香垂世远，催科政拙赖时清。\n行边且共吾民乐，霖雨秋农兆有成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28076,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重登鼓山绝顶","author":"屠侨","text":"春山有约客重来，云尽高峰面面开。\n灵洞近窥三岛路，碧霄平筑列仙台。\n风烟傲睨人千古，天地苍茫海一杯。\n乐事可堪追往事，斯文残刻扫莓苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28077,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五月梅雨","author":"屠侨","text":"才见迎梅又送梅，榴花五月雨中开。\n江南芒种田家候，白下端阳客子杯。\n古壁腥延蜗角上，空阶青引石衣来。\n离肠何苦淹淹滴，用愧当年济旱才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28078,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜泊皂林写怀","author":"屠侨","text":"一里人家古皂林，孤舟客夜几伤心。\n天青树碧野云尽，星朗月明秋水深。\n坐看东南多越思，笑歌儿女旧吴音。\n风波道路轻年少，犹戴儒冠未插簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28079,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟怀","author":"屠侨","text":"济水犹馀二百里，吴山不计一千程。\n山多胜事归无日，水共离人去有声。\n燕子风前芹正暖，杨花春后雨初晴。\n逢时不用多惆怅，汗漫孤舟自在行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28080,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登北固寺","author":"屠侨","text":"瓜步潮遵北固回，海门秋满瓮城来。\n江淮地胜存遗额，楼阁景多空旧台。\n落叶未疏犹有菊，重阳两度此衔杯。\n太平一统无天堑，万里乾坤眼共开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28081,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山陵扈祀次松皋许太宰韵","author":"屠侨","text":"微臣叨扈紫宸仪，载道欢歌利见词。\n帐殿千峰森屏翰，辕门万骑拥旌旗。\n皇图奕叶根源地，圣孝精禋雨露期。\n沕穆龙宫肃瞻对，七陵松柏郁迟迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28082,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"扈驾山陵次玉溪少宰韵","author":"屠侨","text":"苍茫素野接金城，扈从龙舆先凤旌。\n岁序隆冬寒正肃，月华中夜冷逾明。\n衰残更怯重裘护，感慨生增落木鸣。\n此际沈思惭肉食，重嗟西北有屯兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28083,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登映江楼次韵","author":"屠侨","text":"解组归来独上楼，百年今日是真游。\n江横雁影青霄外，路入桃花碧海头。\n自此山川随我乐，谩于今古共人忧。\n閒心一寄凭栏月，满地云浮与水流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28084,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵汪慎斋见遗","author":"屠侨","text":"慰籍无官身始轻，尘缘婴我事还生。\n白云丹壑鸥沙梦，骇鹤惊猿凤诏声。\n霄汉旧游空窃禄，林丘甘遁已忘名。\n谁关风雨他乡念，况复南征旅雁鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28085,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泰陵晚宿昌平瑞光寺","author":"屠侨","text":"一入寺门心便幽，禅居寂静即林丘。\n寄身京国那堪再，回首江山孰与俦。\n晚饭且甘僧供淡，清宵聊缓客乡愁。\n泰陵独慰来瞻谒，荐录初登甲子秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28086,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"龙泉关","author":"屠侨","text":"崎岖窈窕入山深，立马危台夕霭沈。\n风草胡沙漫飞雪，关城天险不言金。\n夜堂柝里闻驱虎，绕案坡前看啄禽。\n只是君王令行处，烟花无渚作幽寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28087,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"常山台署用韵","author":"屠侨","text":"有客遥从剑浦来，故乡风景此徘徊。\n山田活水千家稻，梅雨清江两岸苔。\n蝉响未秋催暑去，榴花如火照人回。\n宦游廿载双蓬鬓，报国空惭袜线才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28088,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登岱岳","author":"屠侨","text":"长风凌厉上巑岏，洞草岩花绕百盘。\n御道石屏龙驭远，古坛松树鹤巢安。\n日峰午夜扶桑晓，天阙新秋广殿寒。\n千古登临总陈迹，独馀香火拜儒冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28089,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"高邮晚泊","author":"屠侨","text":"水云佳胜此经频，杨柳菰蒲远近津。\n明日驿楼常照客，长河舟楫几閒人。\n盂城地重咽襟处，甓社珠遗草木春。\n旅泊不胜延颈意，太平鱼稻足斯民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28090,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"写扇","author":"屠侨","text":"高树满秋风，茅檐正倚东。\n相知穷白首，不厌说山中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28091,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"二渔负罾图","author":"屠侨","text":"夜饭未得熟，风涛不可罾。\n柴门桑竹雨，妻子候寒灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28092,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"席上书扇二首 其一","author":"屠侨","text":"山空秋叶落，江静野云浮。\n世事无关涉，扁舟梦远游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28093,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"席上书扇二首 其二","author":"屠侨","text":"云林道相重，相赴野亭开。\n谁有青山意，扁舟江上来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28094,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"花山","author":"屠侨","text":"花山极千仞，上有老君祠。\n何代来居此，青松有古枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28095,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西窗雨中吟二首 其一","author":"屠侨","text":"二月春寒恶，重重压雨云。\n暮窗烟数缕，愁思乱纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28096,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西窗雨中吟二首 其二","author":"屠侨","text":"好事成长恨，愁人坐雨天。\n相思无限意，挥泪写诗篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28097,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中简童纯夫求笔","author":"屠侨","text":"出门咫尺是君家，雨隔东西望眼赊。\n片帛殷勤将信使，管城初夜梦生花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28098,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"酒后南窗晚坐","author":"屠侨","text":"新柳墙边带雨青，小鸡窗下听谈经。\n酒肠爱坐凉风晚，碧落须臾三四星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28099,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵寄锡山邹光大","author":"屠侨","text":"天涯共惜故人离，夜雨灯花记昔时。\n寂莫江乡篷屋底，与君挥泪写秋词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28100,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"写扇赠柴克修","author":"屠侨","text":"百里春江浩渺平，春山苍翠乱峥嵘。\n钓船欲放沧瀛外，沙际南风是去程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28101,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"暮春即事二首 其一","author":"屠侨","text":"漫白杨花乱飞絮，落红桃瓣尽沾泥。\n东风不管愁人面，三月出门无鸟啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28102,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"暮春即事二首 其二","author":"屠侨","text":"荏苒风光三月暮，繁华时节一年回。\n眼前零落何须论，隔岁花如昨日开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28103,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画景","author":"屠侨","text":"白石桥西绿竹林，青松亭外白云岑。\n何人閒睡三万日，凫鸭碧波江水深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28104,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜行至塘栖遇风雨","author":"屠侨","text":"出关弥望冻云低，画鹢迎春未试题。\n四十五程灯火夜，一川风雨泊塘栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28105,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"发芦沟晚至房山","author":"屠侨","text":"紫荆云外渺天关，汗漫山行不等閒。\n六十里程忙走马，夜深灯火宿房山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28106,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]