[{"title":"题唐子畏二美图","author":"欧大任","text":"堤上风柔杨柳斜，歌中何处浪淘沙。\n芙蓉采得看颜色，犹似江南姊妹花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8068,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日粤秀山寺礼毗卢遮那佛","author":"欧大任","text":"地肺引炎隩，天池溢重溟。\n灵丘镇吾粤，上应朱鸟星。\n惚恍聚云状，岋嶪疏峰形。\n何年起祇苑，磴道悬紫冥。\n古佛涌地来，鹫岭倏所经。\n石从波斯现，珠以摩尼荧。\n白龙表瑞年，题有乾和铭。\n孰言梵志遗，示法耆瘏听。\n瑟居一顶礼，商秋旃檀馨。\n悠然慧吹入，忽已甘露零。\n初心本不二，至理归大宁。\n给园匪云远，镂玉兹山庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8069,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"绿绮堂听刘季德琴","author":"欧大任","text":"调轸拂金徽，谁云古道非。\n商飙一以发，悬水骤能飞。\n四壁鸣螀急，千山木叶稀。\n广陵遗散在，自可偃岩扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8070,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夕同梁祠部冼京兆陪顾徐二使君游陈少参浮丘别墅得时字","author":"欧大任","text":"冷月清霜雁鹜池，相逢斗酒自难期。\n人从安石栖山日，客及参军奉使时。\n坐上可能留北海，花前犹似在东篱。\n吴歈歌管深陶写，莫遣红颜笑鬓丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8071,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄朱宗良","author":"欧大任","text":"贞松绝巘垂，黄鹄青冥徙。\n丘中一士卧，四顾莽荆枳。\n飒沓青霞飞，萧椮白云起。\n林飙振木叶，窗牖蒙葛藟。\n幽栖断来径，居自远尘轨。\n饥逢石髓餐，散帙时隐几。\n流坎任吾生，麇鼯随所止。\n昔日青门侯，今见于陵子。\n思君同隐怀，川途渺千里。\n罗浮望匡庐，倏借王生履。\n因往證菩提，悠然共秋水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8072,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答用晦见寄","author":"欧大任","text":"芙蓉园里几秋风，迢递封书寄岭鸿。\n欲问归来瓢笠客，白头犹望楚江枫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8073,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七十一初度邓君肃潘子朋李裕德潘仲良舟过村居为寿","author":"欧大任","text":"住楫溪头曙色开，萧条门径剪蒿莱。\n正逢松菊邀欢日，况有琳琅善颂才。\n皇象醴梅供客醉，朱登遗蟹待宾来。\n交亲欲问长生诀，更煮胡麻共一杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8074,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王兵宪宗鲁救水活万人功在肇庆纪之以诗","author":"欧大任","text":"臬台西拥汉旌旗，沧水兼持使者麾。\n急峡翻江湘雨过，盘涡激石海云垂。\n河经酸枣今何日，堰定离堆似此时。\n圣主玄圭应更锡，即看持节拜台司。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8075,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送谢训先生以贡入京","author":"欧大任","text":"江门传业谢家风，经术斌斌汉日同。\n博士自应尊董相，明堂能不召申公。\n封轺走送渔阳骑，戍角惊飞碣石鸿。\n别后相思持社酒，问君谁共醉新丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8076,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日园居","author":"欧大任","text":"江村寥寂阅年华，静掩柴门小径斜。\n科斗记封茅氏箧，赫蹄书饷竺僧家。\n霜彫紫菊深留朵，腊尽红蕉盛放花。\n扶杖祇堪供一笑，尚馀彤管老天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冈州友人致北到山药诸种行园视植","author":"欧大任","text":"艺竹成楥一亩居，于陵隐矣更何如。\n欲投白社难忘酒，只对青山不著书。\n溪灌诸蔬为老圃，门垂五柳自吾庐。\n玉延莫报来禽帖，日可霜林出荷锄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陶将军伯玉防海","author":"欧大任","text":"长沙匡世业，军以六州名。\n雪色临江戍，波声截海营。\n桃花飞探骑，梅萼照行旌。\n文苑登坛久，谁堪托外兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄张羽王","author":"欧大任","text":"千里一尺素，西来烹鲤鱼。\n谁云始安郡，不似茂陵居。\n天地閒欹枕，烟霞老著书。\n相思何以报，吾已学真如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄梁计部孔适比以崇安令召入","author":"欧大任","text":"幔亭仙吏入班司，十载重来睹汉仪。\n宫鹊尚随玄武仗，江云长护定昆池。\n青溪把酒游偏洽，画省裁诗出每迟。\n君见白门千树柳，风烟何处寄相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕同陈明佐顾明卿梁少嘉诸子看灯得花字","author":"欧大任","text":"试灯频醉酒人家，更有明妆出绛霞。\n池上停看烽火树，烟中飞散钵罗花。\n扇开屏曲歌犹掩，帘捲楼头月未斜。\n归骑喧阗惊曙色，满城金吹动啼鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"垂老","author":"欧大任","text":"金闺一出几经春，垂老惟知懒是真。\n但爱曲肱留盛世，岂难挥手谢时人。\n门多翠藓何妨僻，山有青精未厌贫。\n笑杀柴桑归去客，仅能完得义熙身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬邹学宪彦吉见寄","author":"欧大任","text":"倦游吾已谢归耕，何意君先解印行。\n鞭弭十年怀旧侣，蘼芜千里寄同声。\n江淹閒就闽南赋，邹湛宁知岘首名。\n闻道青箱家学盛，七经还出授诸生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海上津亭逢张孺觉赴高州","author":"欧大任","text":"一送广陵去，书从白下开。\n五羊停楫待，双鹿夹车来。\n挺劲风云色，峥嵘岳牧才。\n高凉君到日，能忆越王台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上巳同社中诸公粤江上修褉","author":"欧大任","text":"风光骀荡属芳晨，羽爵临流引玉津。\n粤社岂殊伊洛饮，晋贤只数会稽人。\n浥烟林竹偏宜晓，濯雨江兰正及春。\n况是莺声供客醉，太平欣赏野情新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同社诸公出郊看花至东山寺","author":"欧大任","text":"报我江头花已开，披榛墟曲兴偏催。\n桥从饮马塘边过，策向呼鸾道上来。\n春草先传康乐句，暮云谁似惠休才。\n芳尊不是攒眉客，记取东林一度回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同区用孺饮黎惟仁南楼","author":"欧大任","text":"满目山川得共游，词人卜筑有菟裘。\n林开霞色常侵席，风引江声半入楼。\n笔底谁能酬赵璧，尊前犹自揽吴钩。\n不妨白首频相过，时系篱门紫玉骝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答京口陈从训见寄","author":"欧大任","text":"一辞神武挂冠归，谁谓田园计未非。\n芦笋欲肥鱼渐上，荔枝初熟鸟频飞。\n隐从海畔渔樵远，梦去江头甲楯稀。\n惟有曲阿词赋客，尺书时肯到柴扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"豫章信去寄朱贞吉","author":"欧大任","text":"百钱挂杖佩吴钩，海涌山前别几秋。\n君纵能怀南峤客，书来何处访沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答朱孔阳见寄","author":"欧大任","text":"岭外梅曾寄一枝，正逢彭蠡雁飞时。\n傥问丹成何日去，朱明洞口最相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答李孝廉惟实见寄","author":"欧大任","text":"风流何减晋潘安，绿玉堂中紫箨冠。\n游息时时搴薜荔，椷题字字寄琅玕。\n海坛晴望千山色，江阁秋生五月寒。\n半幅练裙谁解写，欲扶残醉向君看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张伯邻集同社适夏木啭黄鹂时","author":"欧大任","text":"黄鸟飞飞昼景迟，曲江家自有林池。\n烟中几啭成新弄，风里馀音入艳词。\n台倚阮公长啸夕，棋残谢傅醉听时。\n朋游何限嘤鸣意，桐帽棕鞋更可随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饮启丁藕花居","author":"欧大任","text":"荡桨酒如泉，风亭为击鲜。\n小池吾每过，曲笠尔犹贤。\n林近匡山社，溪通镜水船。\n新荷鱼自戏，何似在东田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘子脩为李裕德作小景偶避暑园中题之","author":"欧大任","text":"汲泉煮茗大岩隈，虬起长松荫绿苔。\n六月林间无暑气，白牛西涧客能来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邹明府邓山人约游三仙遗迹亭","author":"欧大任","text":"百尺梯飙异境开，峤南仙室在崔嵬。\n星看朱鸟岩头出，云逐青螺海上来。\n珠纛梦曾驰紫闼，玉函名已列丹台。\n匡山社里今谁主，为报游人亦姓雷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丙戌丁亥连举两曾孙志喜","author":"欧大任","text":"七十二翁洲上村，两年喜得两曾孙。\n可传山笥残书帙，且醉田家老瓦盆。\n下噀耕惟双犊健，广川业以一经存。\n庭阶未论多兰玉，长养深知雨露恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄区隐君","author":"欧大任","text":"星高南极斗牛墟，中有鮀洲大隐庐。\n赐爵曾逢廱序礼，藏家半似酉阳书。\n鹤栖海树三花下，松偃山窗五粒馀。\n我亦汉庭贫曼倩，西游瑶水约何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送金计部持甫守临安","author":"欧大任","text":"算缗东省才名久，此日词人出牧多。\n地尽中原雄越巂，江分南徼下牂牁。\n楼前雪照双钩色，郡里风移五裤歌。\n禁闼超迁曾不次，衔恩西上未蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"追送陆元量宪使华节亭不及","author":"欧大任","text":"青山病后出柴门，羸马迟迟惨别魂。\n清啸尚思刘越石，交情敢负赵平原。\n九峰归卧驯林虎，六月哀歌断岭猿。\n独有吴淞千里雪，梦寻堪到陆家园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱明洞鹤","author":"欧大任","text":"我岂浮丘伯，谁今丁令威。\n引吭鸣欲舞，铩翮会将飞。\n玉局云曾宿，铜盘露未晞。\n上升如可接，缑岭几时归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮丘怀赵太史","author":"欧大任","text":"学士承恩已赐麻，十年曾向此餐霞。\n歌因南国丛生桂，种岂东陵五色瓜。\n海上至今留玉舄，洞中犹自贮丹砂。\n怀君欲折江梅寄，春在罗浮万树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8102,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄王元美","author":"欧大任","text":"弇山把袂忽三秋，自向沧江伴白鸥。\n谢傅故应怜小草，张融犹得住扁舟。\n砂求勾漏今非令，瓜种青门旧是侯。\n缥缈楼高飞梦远，为君支策上罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8103,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送督府吴公转工部尚书赴留都","author":"欧大任","text":"仗钺如霜节制雄，军中新拜大司空。\n即看宅揆三台位，曾勒元戎百粤功。\n幕府风云悬海上，鼎门星斗护江东。\n主恩重有安危寄，何限苍生望谢公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华玉馆并蒂兰花","author":"欧大任","text":"文藻罗含楚国华，青云今见阮咸家。\n丛兰纵有江湘色，争似溪亭比玉花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答子朋公益子迁季美开社见寄","author":"欧大任","text":"社事初成鹖是冠，招邀何以到鱼竿。\n可因朗月思玄度，尚有残书伴幼安。\n玉履并将纶简寄，铜盘犹向竹林看。\n洛中若待扁舟客，欲系龙门八节滩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"进艇","author":"欧大任","text":"商飙昨夕至，进艇晓来难。\n灌木秋声急，荒江日影寒。\n客犹思旧雨，书不寄长安。\n闻道鲈鱼上，惟应事钓竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答华幼圜见寄","author":"欧大任","text":"江南词苑见君难，五色挥毫气似兰。\n瑶蕊乍从椷里授，白纨新向卷中看。\n春申涧下泉香近，泰伯城边雪片残。\n千里归鸿劳寄问，沉冥沧海有鱼竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刈稻","author":"欧大任","text":"舍穫在兹日，田家水旱忧。\n东皋犹惜雨，北崦稍宜秋。\n粳秫收堪积，鸡豚饱易游。\n老夫思食力，贷不向河侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈孔信读书罗浮","author":"欧大任","text":"橐书兼梵策，往寄佛龛开。\n能挟沙门去，还同颖叔来。\n青霞封石臼，朱草积香台。\n欲策桄榔杖，鸡鸣看日回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蔡方伯用卿读余诗辄编成目录见寄因报是作","author":"欧大任","text":"巴歌劳向郢人听，作者千秋大雅亭。\n内省握来兰是草，中郎书解石为经。\n缄珠每喜浮波白，镂玉惟看叠嶂青。\n国有太师今在粤，已从江海慰飘零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"还旧园酬郭学宪舜举药洲见怀","author":"欧大任","text":"介居溪上一柴门，荒径萧萧落叶繁。\n松锁仅成摩诘墅，竹深何有辟疆园。\n铜鱼使至劳相赠，金马归来学避喧。\n持报药洲谭秇客，纵能吹剑不堪论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题曾孝廉醉隐楼","author":"欧大任","text":"避世君深隐，高楼颂酒星。\n浮名逃白堕，长啸落青冥。\n大宛蒲萄熟，乌程竹叶泠。\n蟹螯持斝共，鱼脍就船停。\n痛饮差为适，酣歌不愿醒。\n陆应沉曼倩，关可闭刘伶。\n马乳谁沾赐，鸱夷每系瓶。\n竟留千石酿，曾上九江舲。\n夜月帘犹捲，秋风户尚扃。\n黄公旧垆在，回辔敢重经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"风木辞","author":"欧大任","text":"嗟海目兮嵯峨，江西下兮牂牁。\n继龙蟠兮云施，九派流兮增波。\n商秋萧寥兮噫气，愁坠檞叶兮吹女萝。\n君有母兮奄逝，禄不逮兮奈何。\n盻黄竹兮新阡，灵徕下兮山阿。\n扬翠旗兮孔盖，倏骖螭兮高驼。\n木惊飙兮旦且夕，吾诚不能解君心之苦兮，而使其涕之不涔淫而滂沱。\n悠悠兮终古，为君弦吾诗兮安歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莆田吴元翰见访","author":"欧大任","text":"竹下萧条径未成，君能千里问柴荆。\n衣裘残腊风犹急，鸿雁空江浪欲平。\n舟载剡溪招隐兴，书惭句曲下楼情。\n中原鞭弭吾今老，莫更逢人道姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答林叔度见寄兼怀邦介","author":"欧大任","text":"历落乾坤一病身，尔时谁解念桓伦。\n簪裾隐傍藤萝密，简牍交从薜荔新。\n结客纻衣劳远使，名家玉树见斯人。\n只今东望风云气，犹有双龙在剑津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李惟实枉过既去诒诗次韵作答","author":"欧大任","text":"扁舟如屋学张融，泊棹清言暂肯同。\n诗在我惟歌小国，赋成君不问司空。\n挐音坛下今虚远，剑说庭中已自雄。\n一斗槽床宁少住，但能双目送飞鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送叶明府赴召","author":"欧大任","text":"朝汉台前载酒频，出郊芳草送征轮。\n何因得借循良吏，此去应为献纳臣。\n花鸟长安晴自媚，衣冠魏阙气偏新。\n会稽父老如今日，岂必青钱可赠人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郭学宪邀集药洲","author":"欧大任","text":"夹堤修竹对花开，改席洲前数举杯。\n九曜烟光浮槛出，二云山色入帘来。\n綵毫敢并词人赋，绣斧今逢使者才。\n海月夜深留客醉，骖驔归骑未须催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李惟实二首 其一","author":"欧大任","text":"累累东田瓜，葛藟相缠牵。\n自非同根株，那能久不迁。\n爱子莫逆好，婉恋尊酒前。\n胡为互分合，复此当离筵。\n出门忽千里，念远繁忧煎。\n临岐一挥手，踟蹰顾櫜鞬。\n古交气谊固，松柏保岁寒。\n亮君秉高哲，抱策申赠言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李惟实二首 其二","author":"欧大任","text":"行行西虹桥，将送所欢客。\n去矣还乡园，嗟予异疆域。\n携手盻征途，须臾已离隔。\n江介多风霜，波涛溢川泽。\n飞藿离哉翻，浮萍尔何适。\n持觞不得留，鸡鸣怅行役。\n远道慨以慷，片言重金石。\n迟尔蓬山期，愿奋双鸾翼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈给舍懋脩量移绍兴郡丞","author":"欧大任","text":"十年琐闼伏青蒲，封事何如贾大夫。\n一出云霄容折槛，却令名姓佐分符。\n行探禹穴金为简，坐啸稽山镜作湖。\n咫尺更逢前席召，帝城春似汉西都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送郭大参笃周赴楚","author":"欧大任","text":"中令衔恩久饬戎，新劳屏翰过湘东。\n三巴人识诸儒长，十载文称大国工。\n楼更庾公延落月，台曾宋玉赋雄风。\n骖鸾此去朝方岳，紫盖高临赤帝宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日","author":"欧大任","text":"深春惟有梦，茅屋不妨贫。\n合浦沉珠尽，衡阳过雁新。\n虞翻犹在粤，王粲欲归秦。\n日暮风偏急，江蘋寄远人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小阁","author":"欧大任","text":"金膏炼药后，几榻半残经。\n石藓侵阶碧，窗筠卷幔青。\n云停春渺渺，江阔雨冥冥。\n载有何人酒，吾惭问字亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潘仲良禺南草堂","author":"欧大任","text":"溪上柴门似漆沮，桔槔灌圃小林居。\n隐同海客南禺野，读可荆人左史书。\n万壑烟霞双蜡屐，百年天地一蘧庐。\n遗安此日庞公宅，且看儿童驷马车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日郭舜举学宪枉过洲上草堂","author":"欧大任","text":"井径何来豸绣衣，儿童旋为扫荆扉。\n一江练似吴骖过，三月花犹剡雪飞。\n苜蓿佐欢聊野饮，薜萝深赏及晨晖。\n沧洲日日纶竿至，谁解星槎访钓矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邓君肃六十一初度","author":"欧大任","text":"仙人邓郁宴家园，彩服春花五色繁。\n诗自盛名标海岳，隐堪华发老乾坤。\n朱霞半入浮丘宅，紫气先开柱下门。\n我有如瓜盘里枣，昌蒲涧上共清尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潘鱼台挽词","author":"欧大任","text":"久辞薄禄兴翛然，鲁国人思令尹贤。\n入仗但飞双玉舄，还家惟守一青毡。\n会从白傅香山社，耕少陶公下噀田。\n十载南禺冈畔路，断蓬疏木怅风烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同郭学宪舜举叶刺史化甫游罗浮","author":"欧大任","text":"名山远在粤云边，使者能来访洞天。\n洒盖飞流冲涧石，褰帷高树入岩烟。\n钱唐客是姚翁仲，关内侯今葛稚川。\n绝峤纵非函谷路，已看真气满櫜鞬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]