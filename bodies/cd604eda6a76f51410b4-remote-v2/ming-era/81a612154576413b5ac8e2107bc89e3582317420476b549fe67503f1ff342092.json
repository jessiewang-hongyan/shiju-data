[{"title":"闺怨一百二十首 其一二○","author":"孙蕡","text":"去年记得打春牛，夫婿归来上翠楼。\n醉把春泥挥彩笔，引教春色上帘钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"□湖春水","author":"孙蕡","text":"朦胧晓色晚春天，鸠妇声传雨满前。\n□口水添惊鹤梦，湖心风动涌蛟涎。\n桃花暖趁龙门浪，杨柳青含蜃户烟。\n归思茫茫谁是客，隔溪频唤钓鱼船。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石潭渔钓","author":"孙蕡","text":"怪石棱层枕碧潭，渔歌谁此日回还。\n一丝风吹青蓑雨，几度舟横白鹭滩。\n平浦有盟鸥片片，红尘不到水潺潺。\n客来莫问严陵事，怕引时名上钓竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白鹤峰","author":"孙蕡","text":"峰头鹤已去，槛外水空流。\n明月山间夜，萧萧古木秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江陵女歌","author":"欧大任","text":"涉江朝采莲，涉浦夕采兰。\n送欢三峡渡，忆妾六盘关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅溪别业诗为王思谏赋","author":"孙蕡","text":"洛阳金谷车马喧，却月淩风绿苔积。\n天游物外有奇趣，令我抚卷一叹息。\n清溪一曲环诗家，上着千树寒梅花。\n苍龙浮香雪璀璨，碧玉倒影龙槎牙。\n徵君平生好奇古，坐敞幽轩对平楚。\n湘灵锦瑟云中来，滕六天花夜深舞。\n水田万顷风飕飕，此时可以穷清游。\n铁桥流水谢公屐，白舫青帘王子舟。\n闲情被花恼不彻，断角残钟寄愁绝，疏星半横翠羽歇。\n投簪岁晚许相逢，江上青蒲会堪结。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新会月华诗","author":"孙蕡","text":"急唤艄人且繫舟，月华寺里散离忧。\n苔生曲径人稀到，门对长江水自流。\n两岸峰峦千古画，一川松桧四时秋。\n坡仙遗墨成灰烬，老衲于今说未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"峡山飞来寺","author":"孙蕡","text":"曲曲江流带峡湾，扁舟来问此名山。\n六朝台榭兴亡后，百越山河指顾间。\n林下鸟啼游客醉，竹边花落老僧闲。\n登临欲上和光洞，无那猿声泣玉环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨白花","author":"孙蕡","text":"杨白花，花茫茫。\n作絮教人疑似雪，愁心搅乱向春阳。\n沉者为蘋浮者藻，白花变化君须早。\n池中赢得逐鸳鸯，免使深宫人懊恼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"牡丹后曲","author":"孙蕡","text":"江南三月春未残，虎丘十里横竹阑。\n茶店门前卖花市，粉气脂香烘牡丹。\n艳紫新红临绿水，望去人家尽相似。\n中间小榭出桥头，参差更觉娇无比。\n山塘荡漾看花回，昨日葳蕤今日开。\n有钱不肯买归去，留取朝朝暮暮来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"御宴潭","author":"梁安","text":"帝子南旋泊锦舟，浪花香煖酒香浮。\n神龙饮罢归天去，鱼鳖于今不敢游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送别鲍通判","author":"梁临","text":"江风吹浪急，送别海天长。\n白石笼寒水，青山带夕阳。\n六鳌今可钓，一苇最宜航。\n后夜相思处，梅开白玉堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洪武四年面圣恭赋","author":"梁临","text":"午门韶舞阅春辉，阊阖炉烟细细时。\n黄帕金盘擎虎榜，绯衣乌帽拜龙池。\n身临北极闻天语，面觐东宫见凤姿。\n每慕仙瀛今始到，壮行安敢负男儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赐宴中书堂","author":"梁临","text":"凤皇台上燕儒臣，丞相传宣礼意频。\n琼漾葡萄银瓮露，金摇芍药玉堂春。\n蓬莱冠盖天香满，鼎鼐盐梅道味醇。\n鼓腹愧蒙天泽溥，愿推馀滴惠蒸民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客中有怀","author":"梁临","text":"书剑蹉跎独蹇予，三年马上苦驰驱。\n云连故国人家少，月淡荒村客影孤。\n卖赋相如归上国，猖狂阮籍在穷途。\n天涯不见传书雁，飒飒西风剪白芦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄刘教谕二首 其一","author":"梁临","text":"六年甘苦与君同，秉节全身祸乱中。\n鸿燕去留南浦阔，鱼龙变化禹门通。\n山田过雨瓜浮翠，江渚沉烟蓼吐红。\n虽老犹存三寸舌，独逢四海息兵戎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄刘教谕二首 其二","author":"梁临","text":"孺子纷纷从鹖冠，相逢莫作腐儒看。\n人间未识连鳌客，天上新除别驾官。\n百药可回双鬓雪，千金难易寸心丹。\n云林饶我浑高卧，窃学东山老谢安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"烈妇陈以安妻赵氏","author":"梁临","text":"君厄凶狼度不逃，妾身妾命比鸿毛。\n血凝白刃千年艳，名压青山万古高。\n故国杜鹃愁草树，苍江精卫怨波涛。\n他年太史求遗迹，未必无人为显褒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"资福寺","author":"陈玄","text":"听经猿去已多时，梧竹风标入梦思。\n暗粉尚留多宝塔，长廊空见舍田碑。\n石池雨过添新水，老柏年深换旧枝。\n闻道灵源高阁上，至今人诵小山诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过华山","author":"陈玄","text":"我家远在南海头，朝夕相见惟罗浮。\n等闲采药逢云母，几度寻真到石楼。\n客路俄经华阴县，太华三峰望中现。\n不见花开玉井莲，空看泉泻冰崖练。\n闻道希夷睡正酣，满山松桂锁云岚。\n欲访神仙问丹诀，云深无处觅鸾骖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽戴竹林","author":"陈玄","text":"碧天夜坠少微星，处士俄然梦奠楹。\n堪惜重泉閟玉树，谩怜洛社失耆英。\n清名已著儒林传，潜德何惭太史铭。\n宿草寒烟封马鬣，贤良追慕不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙珠井","author":"陈玄","text":"神物腾空古井存，至今流派尚源源。\n山瓢汲得天边月，疑是龙珠不敢吞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游勾漏岩二首 其一","author":"张度","text":"流水桥深一径斜，仙人移出白云家。\n浪游远迹张骞石，清燕遥传葛令砂。\n洞里龙文开五色，岩前珠树散三花。\n明时岂谓逢瑶草，祇向名山采物华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游勾漏岩二首 其二","author":"张度","text":"汉史曾探禹穴奇，何如仙令繫青丝。\n霜高薜荔秋堪把，天琢芙蓉翠欲飞。\n倦拥昙云凝雪色，光摇钟孔散冰晖。\n洞中石髓今谁属，醉倚苍茫独振衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游罗浮","author":"张度","text":"忆昔罗浮海上峰，当年曾此寄遗踪。\n凭栏月色出沧海，攲枕秋声入古松。\n采药静临幽涧洗，寄书闲背白云封。\n红尘一下拘名利，不听山间午夜钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北山儒隐","author":"邓伯凯","text":"芒草分畦夹颖区，远携书剑伴云居。\n四民祈报同乡社，诸老章缝异里闾。\n泉气冷涵茶灶润，岚光晴照竹窗虚。\n唔咿隔壁声相应，应有儿孙夜读书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南畔农忙","author":"邓伯凯","text":"村南俗不好荒嬉，东作孜孜恐后时。\n黄犊耕云春起早，绿蓑披雨夜归迟。\n冠昏有节家常给，赋税无逋吏到稀。\n过客相逢莫相笑，遗安一念少人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"横浦渔舟","author":"邓伯凯","text":"绿水周遭岛屿孤，扁舟云集晓相呼。\n潮头起抹才收网，雨脚离山又晒罛。\n纳税经年粮颇足，得钱竟日酒频沽。\n今承优诏归来晚，蓑笠何妨作钓徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"尖峰樵唱","author":"邓伯凯","text":"淩晨腰斧履巉岩，采得柴荆日暮还。\n万树参差横岭畔，数声欸乃出云间。\n息肩共话投林乐，联步都忘负重艰。\n独惜栖鸟犹未隐，多应惊起过前山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙穴晓云","author":"邓伯凯","text":"神物升沉不记年，至今遗迹尚依然。\n半林叆叇存灵气，一窍穹窿带冷涎。\n饥豹夜归思隐雾，行人晓起讶炊烟。\n何如上下从龙去，化作商霖遍九天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石桥秋月","author":"邓伯凯","text":"鞭石为梁枕碧流，山河倒照一轮秋。\n三冬既免褰裳涉，五夜何须炳烛游。\n玉兔长生寒影动，彩虹横卧瑞光浮。\n醉来脱帽思题柱，又恐嫦娥笑白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独冈返照","author":"邓伯凯","text":"孤岛巉岩枕陇隈，耕锄每被夕阳催。\n一轮红挂疏林杪，几抹光涵乱石堆。\n客棹落帆饶早宿，渔家收网及晴回。\n归鸦解识诗人意，犹带黄金背上来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古寺晴岚","author":"邓伯凯","text":"过堂钟罢日三竿，如雾如烟锁佛坛。\n满地落红春寂寂，上林空翠画漫漫。\n衲衣频焙薰笼暖，贝叶浓翻讲座寒。\n安得狂风为吹散，重扶短杖叩禅关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼黎节妇","author":"邓伯凯","text":"万事消溶花上露，一生清白竹间霜。\n门闾勿谓无旌表，嬴得浔流姓氏香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甘露","author":"黎光","text":"连宵见天乳，休徵谅可凭。\n适兹瑞露降，粲粲如脂凝。\n松柏总沾被，淑气发冈陵。\n甘味胜醍醐，色白犹瑶琼。\n采之进九重，德化中外称。\n载考瑞应图，斯祥诚足徵。\n匪惟人寿康，且见岁年登。\n小臣睹盛事，歌颂喜不胜。\n宜归太史书，瑞牒光愈增。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘉禾","author":"黎光","text":"圣皇御寰宇，恩膏被万汇。\n矧兹丰年登，祯祥总来萃。\n嘉禾应时生，一茎分五穗。\n离披翠叶敷，璀璨珠颗聚。\n周岐堪共称，汉亩实同类。\n乃知淑气钟，为国表祥瑞。\n守臣远来进，籎籎陈丹陛。\n愿付太史书，休声垂万世。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花道人歌","author":"黎光","text":"梅花道人操行坚，萧萧白发今盈巅。\n开圃种梅常万树，对酒看花今几年。\n冬来花开雪满川，景致好似孤山前。\n疏影横斜月有色，暗香浮动春无边。\n花间读书事幽致，牙签玉轴联青编。\n岂知一室大如斗，能蕴春意涵全天。\n我昔闻梅花，元是姑射仙。\n人间尘垢岂能染，冰肌玉质恒瑩然。\n夭桃谩粗俗，艳杏徒嫣妍。\n孤标挺然出寒谷，百卉不敢司春权。\n吁嗟道人清且贤，生前结得梅花缘。\n寸心既会物外趣，高兴已在诸人先。\n豪吟绝类灞桥客，清梦夜落西湖船。\n有时静坐梅花下，胸中皎皎冰壶悬。\n我生酷爱梅，见花喜欲颠。\n浩然可同调，林逋堪并肩。\n何当坐我梅屋下，弹琴酌酒同周旋。\n醉呼山童供纸笔，挥毫为赋梅花篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人宰零陵","author":"黎光","text":"大尹之官去，零陵近广西。\n衡山无雁过，楚树有猿啼。\n风俗宜诹访，江山要品题。\n磨崖碑好在，莫惜到浯溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过洸口吊邵廷琄","author":"黎光","text":"宫使遭谗日，军中尽感伤。\n伍员宁负国，屈子竟沉湘。\n身殒英灵在，名留史传香。\n遗祠今已废，无处奠椒浆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人还乡","author":"黎光","text":"晓出石城西，樽前惜解携。\n当筵花锦灿，蘸水柳丝齐。\n别酒愁须饮，家书醉懒题。\n欲谭乡曲事，客思转凄迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巡按苏州舟中偶成","author":"黎光","text":"晓听纶音出大廷，驿夫挝鼓放舟行。\n江心水拥金山寺，京国云连铁瓮城。\n松节固知经岁好，葵心先已向阳倾。\n此行止为询民瘼，未暇登临畅客情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张御史陜西佥事","author":"黎光","text":"晓承恩命出鹓行，骢马西行驿路长。\n锦诰重颁新雨露，绣衣犹带旧风霜。\n山连太华三峰秀，河出昆崙九曲长。\n一道澄清俄顷事，要看当道屏豺狼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和新友黄太安见寄韵","author":"黎光","text":"便佳楼上忆凭观，万里风尘正渺漫。\n拟谓江湖长结社，岂知京国久为官。\n华勋未上麒麟阁，白笔叨簪獬豸冠。\n几度怀君清不寐，乌台霜月五更寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读渔唱稿有感","author":"黎光","text":"地下修文已十年，客窗不忍读遗篇。\n一双清泪灯前落，风木情深倍怆然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"棉江欸乃九章并序 其一 和平桥","author":"周彦敬","text":"渔翁棹歌兮石桥东，海色欲上兮含朦曈。\n荒鸡闻兮戒晓，江豚上兮知风。\n普天率土兮王之宫，阳侯受职兮龟龙率从。\n沙寒草枯兮鱼上罶，薄言戒归兮爰发我笱。\n嗔南邻兮春醅香，岂今夕兮无酒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"棉江欸乃九章并序 其二 胪溪","author":"周彦敬","text":"渔翁浩歌兮胪水曲，断港埼兮南浦缩。\n历远游兮凫洲，抚茸茸兮草屋。\n儿力田兮饷东菑，妻烧荻兮炊粳藜。\n运鸾刀兮斫蟹螯，镂鳞鳞兮鲙丝。\n人生此乐兮何期，秋月春风兮常在兹。\n良有怀兮昨之崄巇，继自今兮坦夷。\n喜徵科兮未急，且归来兮迟迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"棉江欸乃九章并序 其三 沧洲","author":"周彦敬","text":"渔翁啸歌兮沧洲浒，水寒沙虚兮石龃龉。\n杳凝睇兮北冈，忽已忘兮南浦。\n丑妻含饴兮怜儿语，夕张灯兮在极渚。\n馔鲫鲤兮羹香美，村醅虽醨兮伉俪亲。\n你操舟兮柁尾，予撒网兮当先。\n今夜水清兮霜露繁，双鸥睡熟兮黄芦天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"棉江欸乃九章并序 其四 海门","author":"周彦敬","text":"渔翁互歌兮海门上，冯夷奔遁兮海潮壮。\n云溶溶兮秋风高，天苍茫兮日晃朗。\n商船去兮淩风过，鲸鲵掀兮银山嵯峨。\n望望仙舟兮冲晓发，玉人劝郎兮无渡河。\n忘机之人兮其乐孔多，有鱼梁兮在中涡。\n发一啸兮江沱水白，山青兮情将若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"棉江欸乃九章并序 其五 鳌溪","author":"周彦敬","text":"渔翁答歌兮鳌溪头，鱼虾为活兮春复秋。\n江月白兮水悠悠，老妻劝饮兮醉瓷瓯。\n罛疏兮鲙脱，顾我兮何求。\n猗彼巨鳌兮翻波上游，虹霓为丝兮明月为钩。\n仰天长啸兮风飕飕，鼓枻扣舷兮浮中流。\n幸际时兮晴明，老翁于此兮乐无休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"治平寺","author":"周彦敬","text":"金璧楼台倚碧虚，此中风景似匡庐。\n绛龙一去海云杳，玄鹤数声山雨馀。\n茶鼎烟寒僧落漠，法堂苔满客踟躇。\n荒塘何处寻前劫，静看浮沤幻影疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梧峰夕照","author":"谢天与","text":"木落江空日已斜，半山红影半山霞。\n更兼寒带梅花角，送入苍茫闪闪鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桂岫晴岚","author":"谢天与","text":"山拥岚光翠欲流，桂花凉转雁迎秋。\n尧天不老人今古，物色经看几白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宝江渔唱","author":"谢天与","text":"扁舟一叶次寒汀，云影烟光献画屏。\n歌罢酒阑人醉后，空馀鸥外数峰青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石径樵归","author":"谢天与","text":"云石苍凉径路遥，一声啼鸟背归樵。\n行边若得仙棋看，不管斜晖转树腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙津晚渡","author":"谢天与","text":"夕阳西坠暝云津，簇立东风唤渡频。\n老尽往来名利客，不知谁是傅岩人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东埔春耕","author":"谢天与","text":"一蓑烟雨耨黄昏，半掩柴扉绿野村。\n借问庞公今去远，高风谁共此中论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龟峰宝塔","author":"谢天与","text":"屹屹孤峰万古名，浮图高耸入秋晴。\n望中好似昂天笔，倒写云笺雁字横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"燕石长亭","author":"谢天与","text":"雨湿云根燕不声，离魂消处一长亭。\n因思南浦江淹笔，草绿波光是此情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沥湖采莲曲","author":"梁敏","text":"放莲船，采莲花。\n星岩东去是侬家。\n罗裙绮袖披明霞，拈花弄叶声嗟嗟。\n花红叶绿令伊羡，莲叶遮头花映面。\n轻桡玉腕橹声柔，叶渚花潭尽游遍。\n摇风荡日垂杨阴，鸾歌凤吹行清斟。\n良人作客动经岁，几度采莲秋向深。\n秋向深，日将暮。\n少年能几何，光阴每虚度。\n藕丝不断为情牵，却问莲心为谁苦。\n回瞻紫陌控骅骝，伊家夫婿亦风流。\n妾身本是良家子，莫将言语轻相投。\n湖边酒家几茅屋，湖上采莲舟陆续。\n鸳鸯结匹雁联飞，泪泣红颜眉蹙蹙。\n眉蹙蹙，惜别离，采莲欢乐翻成悲。\n沥水湖边烟草合，石室岩头云片飞。\n去年采莲有谁在，今岁采莲人更稀。\n年年岁岁莲花好，岁岁年年人易老。\n行人昨日带回书，夫君已发长安道。\n长安道，何当还，莲叶莲花换几番。\n移船摇橹还家去，手抱银筝那忍弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"崧台春霁曲","author":"梁敏","text":"莺啭翠微晓，香风荡林扉。\n城郭已春半，新晴绚芳菲。\n歌亭酒馆幛帘幕，花衢柳巷分如棋。\n千金鞍马纵行赏，尽是官家年少儿。\n天开琼筵俯流水，羽觞飞酌延春晖。\n城南薄暮歌吹作，月上花稍犹未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48847,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"端州杂咏二首 其一 南山晓翠","author":"梁敏","text":"秀拥春华丽晓晴，巍峨气势截苍冥。\n石梳苔发堆螺鬓，露渍蓝膏湿玉屏。\n涧谷长留烟草色，松筠犹是岁寒青。\n天然一带真图画，观览无烦出户庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48848,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"端州杂咏二首 其二 莲池绿涨","author":"梁敏","text":"春风数里起高荷，梅雨新晴滟滟波。\n绿晕平渠侵稻陇，清光澄靛映星河。\n蒲交劲叶磨龙剑，鱼浴鲜鳞掷玉梭。\n家在池头东畔住，月明犹听采菱歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48849,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]