[{"title":"閒亭","author":"李之世","text":"见说閒亭閒未閒，亭下寒流去又还。\n落日半庭云贴水，野人秋思满圭山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27743,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读书处","author":"李之世","text":"一茆正可借閒居，怪底年来倦读书。\n枕箪乍凉人睡觉，香风送过绿芙蕖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27744,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柏","author":"李之世","text":"空阶流月碧如脂，几度当轩柏影移。\n三十年前乌哺子，旧巢应在最高枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27745,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"槐","author":"李之世","text":"空翠摇阶云影凉，秋来槐叶几飘黄。\n种时人尚高于树，今过墙头如许长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27746,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山涧","author":"李之世","text":"涧畔累累甃石斑，无泉休讶涧空閒。\n请君过雨时来看，嫩绿柔红流出山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27747,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山井","author":"李之世","text":"小桥转过石岩隈，玉镜圆流印碧苔。\n见说一泓清似许，每晨亲汲供如来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27748,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山松","author":"李之世","text":"龙甲龙髯袅袅青，虚堂风雨梦初醒。\n道人不管閒岁月，漫说深岩有茯苓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27749,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石几","author":"李之世","text":"山中一具天然几，黄如蒸栗滑如脂。\n问君著此有何用，海月初生云起时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27750,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饮香树","author":"李之世","text":"已闻岩树能成酒，更说椰浆解醉人。\n近谱西林新本草，众香国里一株春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27751,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和青堂","author":"李之世","text":"轻岚点点著衣衫，花气撩人似半酣。\n帘外山光帘内映，绝如浓黛写江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27752,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浣云矶","author":"李之世","text":"半挂枝头半蘸矶，轻明谁浣碧霞衣。\n长风十里吹难断，却讶吴江练色微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27753,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画","author":"李之世","text":"是处青山路尽赊，前山隐隐夕阳斜。\n高原夐绝疑无地，却望云中又几家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27754,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题折枝梅","author":"李之世","text":"曾于月下步苍苔，雪里闻香不见梅。\n刚到月斜香寂处，一梢寒影挂墙隈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27755,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏赠常姬画荷便面","author":"李之世","text":"荷花荷叶一般香，拨叶搴花两柄长。\n欲折荷花贻欢子，留将荷叶盖鸳鸯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27756,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"席中赠常姬 其一","author":"李之世","text":"轻翻拍板度新声，花底微闻百啭莺。\n座客一时齐侧耳，就中谁是最关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27757,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"席中赠常姬 其二","author":"李之世","text":"才听清歌声遏云，风前兰佩又闻薰。\n并刀一剪湘江水，可似湘娥百叠裙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27758,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"半岭题圆明庵","author":"李之世","text":"北往南来度此关，圆明庵子住山间。\n前村车马忙如许，可道逢僧便借閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27759,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度岭谒张曲江祠","author":"李之世","text":"前朝风度一瞻依，立马庾关望翠微。\n閒剔荒苔看古碣，斜阳山色逗人衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27760,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁口观灯词 其一","author":"李之世","text":"江头沓沓步如云，彻认歌声处处闻。\n铁柱千年镇浪底，家家人赛许真君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27761,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁口观灯词 其二","author":"李之世","text":"梁口村中观綵棚，江边路转黑层层。\n绛蜡有钱无处买，大家留点小鳌灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27762,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁口观灯词 其三","author":"李之世","text":"萧公庙前金额字，艳艳花灯照海红。\n恰好拢船看一会，争奈挂帆趁北风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27763,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁口观灯词 其四","author":"李之世","text":"江边冷落无灯火，一色桃花向月然。\n笑杀街头空剪綵，胭脂买断未还钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27764,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿东山道院","author":"李之世","text":"春入寒山渐解冰，风吹檐溜滴层层。\n银蟾未没金乌出，夜坐云岩不炷灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27765,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重过回龙庵","author":"李之世","text":"破落禅扉带叶关，频来只是爱僧閒。\n斋厨过午无烟火，可是多时不下山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27766,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠紫云僧","author":"李之世","text":"不置房厨不宿粮，虽然常住似游方。\n前村乞食归禅院，一个钵盂挂在墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27767,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"溪上杂题 其一","author":"李之世","text":"潮头新涨水淙淙，小步荒洼翠几重。\n行到水穷试一望，隔溪云起是圭峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27768,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"溪上杂题 其二","author":"李之世","text":"潮来潮去有常期，白白荒荒水一陂。\n流到中林还渐住，转来花下入平池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27769,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"溪上杂题 其三","author":"李之世","text":"水光澹澹著林晖，映带园■入翠微。\n贪玩晚霞溪上坐，不知凉露湿荷衣。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27770,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"溪上杂题 其四","author":"李之世","text":"截得琅玕三两株，溪边日日打鹥凫。\n觉来世事皆儿戏，赢得头颅似老夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27771,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"溪上杂题 其五","author":"李之世","text":"沿溪曲曲柳齐齐，澹景拈来尽画题。\n任是黄筌描不得，水烟人影小桥西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27772,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"溪上杂题 其六","author":"李之世","text":"閒来趺坐但垂纶，坐到潮平水不粼。\n红叶满林风乍起，行人错认浣花津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27773,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"溪上杂题 其七","author":"李之世","text":"半亩荒畦手倦耘，种花栽药苦无勋。\n年来事事成抛掷，祇有枯毫未忍焚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27774,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"溪上杂题 其八","author":"李之世","text":"底须逃俗与逃喧，拚是车尘不到门。\n红日睡残无一事，自盘青竹护兰荪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27775,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"溪上杂题 其九","author":"李之世","text":"柔风澹澹漾微澜，轻泛崇兰露乍漙。\n偏是撩人难寐著，半帘疏月碧阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27776,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"溪上杂题 其十","author":"李之世","text":"腻叶丛丛荔子湾，石梁咽处水潺潺。\n閒来却忆宣城句，絮絮云生叠叠山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27777,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄平子五羊旅舍兼讯蔡姬","author":"李之世","text":"珠海迢迢问渡时。\n我留君去各差池。\n如何一盏松花酒，不共冰盘擘荔枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27778,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无择以游圭峰记及诗见贻辄题数绝于后 其一","author":"李之世","text":"九月九日圭峰寺，处处松阴藉酒杯。\n苔花满面衣衫湿，谁向峰头看瀑来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27779,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无择以游圭峰记及诗见贻辄题数绝于后 其二","author":"李之世","text":"千仞悬崖挂古松，飞泉一道泻淙淙。\n就中想像堪描处，两个山僧扶短筇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27780,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无择以游圭峰记及诗见贻辄题数绝于后 其三","author":"李之世","text":"閒山剩水人占尽，若个游人问翠微。\n向晚欲投云际宿，禅房借得稻田衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27781,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无择以游圭峰记及诗见贻辄题数绝于后 其四","author":"李之世","text":"寺里游尘滚滚忙，岩头别占好风光。\n诗怀放却千峰外，且共閒僧话夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27782,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无择以游圭峰记及诗见贻辄题数绝于后 其五","author":"李之世","text":"谁道云中别有廛，斜阳数点带炊烟。\n山前石耳无人摘，携得瘿瓢试涧泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27783,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无择以游圭峰记及诗见贻辄题数绝于后 其六","author":"李之世","text":"最高呼吸通云雾，尘海茫茫隔大千。\n权与山灵借一席，懒将狂韵犯流年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27784,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闭关 其一","author":"李之世","text":"槐月浸阶凉不寐，晶晶虚牖写圆光。\n缘心久断閒来梦，消得蒲团一味长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27785,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闭关 其二","author":"李之世","text":"数转残经月未斜，莲灯艳艳簇窗纱。\n觉来文字无真性，迷悟何须问法华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27786,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闭关 其三","author":"李之世","text":"蟠木瘿瓢老瓦铛，随缘蔬食类行僧。\n狂心也逐猿羁锁，破得尘劳第几层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27787,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闭关 其四","author":"李之世","text":"饥与幽禽相伴食，閒随孤鹤共经行。\n玄关镇锁何来去，寒月寒潮几度生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27788,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送念心上人游补陀","author":"李之世","text":"洞口潮音杳霭间，凉风吹月堕梅湾。\n长空碧蘸琉璃净，试向云边洗钵还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27789,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄头陀端公 其一","author":"李之世","text":"层层破衲冲云寒，披发蒙头不著冠。\n话到传心无半字，活人长施一丸丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27790,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄头陀端公 其二","author":"李之世","text":"黄云山下漏声声，记得同师采药行。\n莎径稻田扪露遍，撷来蔓草不知名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27791,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄头陀端公 其三","author":"李之世","text":"三尺蒲团七尺筇，四更残漏五更钟。\n一声唤醒缘生梦，月在寒潭风在松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27792,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄头陀端公 其四","author":"李之世","text":"两年三度水云期，可似三生石上时。\n师自幻游吾幻住，相逢谁唱竹枝词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27793,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登赊月台望圭峰","author":"李之世","text":"凉梦初醒午后钟，高台閒眺信孤筇。\n微茫一带苍烟外，占断斜阳三五峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27794,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"圭岭策驴卷 其一","author":"李之世","text":"山椒夐绝无人到，流水泠泠漱古苔。\n八十山翁不扶杖，一月骑驴来一回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27795,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"圭岭策驴卷 其二","author":"李之世","text":"洞口阴飙扫石扉，欲寻云术转微微。\n月明三弄云中笛，驴背松风吹葛衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27796,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送慧公朝补陀 其一","author":"李之世","text":"一片慈云占断峰，海潮随月去溶溶。\n玉毫光彻三千界，影落斜阳杯渡中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27797,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送慧公朝补陀 其二","author":"李之世","text":"浪头高打海门关，袅袅潮音响佩环。\n一点青螺吹不动，舟人遥指洛伽山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27798,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过兴教寺题荆山上人兰若","author":"李之世","text":"通西桥畔古招提，堆石崩沙绕碧溪。\n黄叶满林僧不扫，自车泉水灌蔬畦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27799,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"老槐","author":"李之世","text":"一树繁阴澹古姿，秋来黄叶点阶墀。\n月明贪玩疏疏影，坐到露凉人睡时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27800,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"老槿","author":"李之世","text":"阅尽韶光悟色空，一场春梦附东风。\n年来领得真消息，坐向枝头数落红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27801,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"老柏","author":"李之世","text":"偃盖崚嶒解傲霜，虬枝半似攫穹苍。\n道人惯服青青叶，却讶霞衣带麝黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27802,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明同羽甫兄存固弟山行 其一","author":"李之世","text":"雨过长堤扫落花，小桥横站绿杨斜。\n儿童指点前山路，去岁清明不在家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27803,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明同羽甫兄存固弟山行 其二","author":"李之世","text":"语燕啼莺有底忙，十分春色半斜阳。\n红林隔水青帘映，转过溪桥闻酒香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27804,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明同羽甫兄存固弟山行 其三","author":"李之世","text":"软风低度碧林温，衣上花香带酒痕。\n犹记去年寒食过，蹇驴骑出水西门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27805,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古冈八景和叶六桐明府韵 其一 黄云樵笛","author":"李之世","text":"閒听风林笛一声，飞花片片递林轻。\n樵人指点云生处，石齿参差路未平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27806,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古冈八景和叶六桐明府韵 其二 紫水渔舟","author":"李之世","text":"几树疏杨间小桃，镜波如赭映城濠。\n渔船个个和烟宿，烟际遥山侣戴鳌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27807,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古冈八景和叶六桐明府韵 其三 皂幕晴岚","author":"李之世","text":"半露云牙半插天，危峰倒卓若虚悬。\n试从霁后看山色，白白苍苍几缕烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27808,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古冈八景和叶六桐明府韵 其四 圭峰瀑布","author":"李之世","text":"喷瀑奔来万马强，可堪描写入诗肠。\n瘿瓢酌罢枕松石，也爱松风午梦凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27809,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古冈八景和叶六桐明府韵 其五 江门晚渡","author":"李之世","text":"千艘如蚁集江门，却喜江声敌市喧。\n向晚绿杨归渡暝，远烟明灭认前村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27810,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古冈八景和叶六桐明府韵 其六 熊子归帆","author":"李之世","text":"空水浮烟欲上蒸，遥瞻罛舶点飞蝇。\n家山处处云相似，帆影千层涛万层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27811,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古冈八景和叶六桐明府韵 其七 厓门春浪","author":"李之世","text":"浪打厓门洗劫灰，空山草木变春雷。\n长江阅尽无穷事，閒汐閒潮自去来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27812,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古冈八景和叶六桐明府韵 其八 象冈秋月","author":"李之世","text":"城里佳山景最多，山腰亭子枕城阿。\n亭前留得棠阴在，士女秋来踏月歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27813,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"坊市迎神谣 其一","author":"李之世","text":"云盖层层引画幡，香花灯烛竞千门。\n如何水月观音现，清静场中转闹喧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27814,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"坊市迎神谣 其二","author":"李之世","text":"听来啰唣不分明，羌笛琵琶钲鼓声。\n重被拥寒侬未起，街头彻夜有人行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27815,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"坊市迎神谣 其三","author":"李之世","text":"杨枝祇合洒涓涓，化作滂沱遍大千。\n濡首沾裳浑不惜，看来人似饮狂泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27816,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"坊市迎神谣 其四","author":"李之世","text":"傅粉涂朱色色新，惊看疑鬼又疑神。\n世情卖得千般假，那个抛头肯露真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27817,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"坊市迎神谣 其五","author":"李之世","text":"沿街十室九笙歌，祇道丰年乐事多。\n试向坊头閒借问，朝来米价定如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27818,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"坊市迎神谣 其六","author":"李之世","text":"勾阑选妓一齐陈，若个当头出手新。\n我亦逢场同作戏，不须更讶闹场人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27819,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"匡云上人制斑竹龛奉佛归庐山偈以送之 其一","author":"李之世","text":"七宝庄严未是严，琅玕几点墨痕沾。\n香炉峰顶香云绕，疑对潇湘雨半帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27820,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]