[{"title":"苏君禹留集翠虚亭共赋二首 其一","author":"胡应麟","text":"一径双松里，孤亭万竹旁。\n高秋全障日，盛暑欲凝霜。\n箨自翻龙虎，枝从宿凤凰。\n画帘清绝处，浑拟坐潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16329,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苏君禹留集翠虚亭共赋二首 其二","author":"胡应麟","text":"百尺烟霄上，千竿雾雨馀。\n绿阴浮枕簟，苍霭净庭除。\n寂寞王猷驾，萧森杜甫庐。\n何如偕筱簜，取次贡乘舆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16330,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"易惟效署中避暑同赋四首 其一","author":"胡应麟","text":"逃暑仍河朔，寻幽到习池。\n青丝行共挈，白帻坐频攲。\n密竹团书舍，疏花照奕棋。\n黄鹂似相识，恰恰在高枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16331,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"易惟效署中避暑同赋四首 其二","author":"胡应麟","text":"落日孤亭上，微风动碧梧。\n净疑开雪槛，凉似浴冰壶。\n茗灶供新瀹，楸枰覆旧图。\n吟馀爇沈水，云起博山炉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16332,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"易惟效署中避暑同赋四首 其三","author":"胡应麟","text":"竹树参差绿，葵榴烂漫红。\n径幽长蔽日，林密尽含风。\n白羽高谈洽，青萍醉色雄。\n大夫饶酒德，无拟笑山公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16333,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"易惟效署中避暑同赋四首 其四","author":"胡应麟","text":"旧识燕台下，新知越水滨。\n乾坤双傲吏，海岱独归人。\n薄有骑羊骨，能同跃马身。\n万山严子濑，秋色未全贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16334,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送友人游边","author":"胡应麟","text":"怜君随汉将，策马度燕台。\n六郡风沙合，三边雨雪催。\n边笳秋色远，羌笛夜声哀。\n来岁看花节，还听草檄回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16335,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李从事之南康","author":"胡应麟","text":"十载京华陌，还为故国行。\n岸花飞客舫，江草问王程。\n晓梦匡山月，春烟白下城。\n谁堪万里外，尊酒动离旌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16336,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壬申夏生日途中作","author":"胡应麟","text":"此日还初度，葵榴照绮筵。\n鲲鹏聊息翼，犬马渐增年。\n贾傅书难上，终童策浪传。\n平生四方志，览镜一茫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16337,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题王中丞小袛园二首 其一","author":"胡应麟","text":"欲问西天乐，聊同北谷愚。\n山围迦叶坐，水净法兰居。\n藏室栖龙象，经文蚀蠹鱼。\n慈航容并载，吾亦慕真如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16338,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题王中丞小袛园二首 其二","author":"胡应麟","text":"万古乾坤意，居然见草堂。\n净心超大士，弹指谒空王。\n永悟三生劫，时翻二酉藏。\n何如浣花叟，白首杜陵庄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16339,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金山寺","author":"胡应麟","text":"绝顶开楼殿，中流见画图。\n云霞千界合，宇宙一山孤。\n远浪晴连蜀，奔潮夜到吴。\n向来舟楫念，寂寞对江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16340,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钱塘秋望","author":"胡应麟","text":"郡国三秋迥，烟波四望开。\n潮深吴相庙，山绕越王台。\n远树天边没，孤帆日下来。\n安期如可遇，指点向蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16341,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄朱汝修兼讯李惟寅","author":"胡应麟","text":"不见朱生久，新篇近若何。\n云山孤鹤在，江海断鸿多。\n筑室移青桂，鸣琴掩绿萝。\n李侯诗句好，骑马日相过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16342,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄朱在明","author":"胡应麟","text":"独有金门客，频年隐未回。\n扳花游汉殿，驻马上燕台。\n梅福神仙吏，相如赋颂才。\n五云空极目，何处是蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16343,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人游燕中","author":"胡应麟","text":"乱山霜色里，行客迥添愁。\n万里看黄鹄，孤心寄白鸥。\n高风沙塞晚，明月海天秋。\n莫以刘叉剑，狂歌对五侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16344,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮行桐庐道中","author":"胡应麟","text":"纳纳驱行旆，遥遥泛客槎。\n万山藏鸟道，一水护渔家。\n束峡天形小，奔崖地脉斜。\n严陵矶畔月，蚤已著芦花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16345,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泊舟登钓台作","author":"胡应麟","text":"峡口抱云汀，中流坐放舲。\n亭高双逼汉，台迥一窥星。\n海气吞江白，山光压濑青。\n纶竿千尺在，吾计渐沈冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16346,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄蔡侍御","author":"胡应麟","text":"宪节初临蜀，征轺旧出秦。\n襜帷开气色，斧钺静风尘。\n峡口云迎客，峨眉雪照人。\n海棠花万树，夹路待西巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16347,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蒋祠部北上","author":"胡应麟","text":"岂意青云客，飘然过草堂。\n龙门留问字，凤阁待含香。\n万树长杨外，千花太液傍。\n何人年弱冠，议礼动明堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16348,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻裕卿移居山中寄询","author":"胡应麟","text":"移家仍绝峤，秋色满垂藤。\n磴袅云千尺，峰回月半棱。\n龙湫寒独卧，雁宕晓频登。\n我亦耽奇客，寻君愧未能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16349,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喻邦相迁守括苍寄贺二首 其一","author":"胡应麟","text":"袛缘香阁吏，领郡亦仙都。\n重镇初移节，名山独剖符。\n儿童迎彩鹢，父老认青凫。\n不奈溪头别，桃花覆酒垆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16350,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喻邦相迁守括苍寄贺二首 其二","author":"胡应麟","text":"试县名方藉，专城宠骤加。\n符分苍岭月，绶结赤城霞。\n吏散朝行郭，官閒午放衙。\n何如迁客泪，九载湿长沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16351,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱在明初至长沙诗以问之","author":"胡应麟","text":"浩渺银河色，孤槎起壮游。\n乱山云梦泽，斜月武昌楼。\n解佩湘娥去，鸣笳楚客愁。\n尺书能远寄，回雁满高秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16352,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻蝉二首 其一","author":"胡应麟","text":"白雁将秋至，玄蝉入暮催。\n清吟随落叶，密响度高槐。\n暑觉帘栊断，凉俄枕簟回。\n日长堪听汝，无拟抱琴来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16353,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻蝉二首 其二","author":"胡应麟","text":"客醉秋山底，蝉吟白露时。\n凄清流古木，断续倚高枝。\n静逐凉飔转，低含夕照移。\n枋榆吾自适，九万欲何之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16354,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日过王世周寓逢汪仲嘉潘景升赋赠","author":"胡应麟","text":"逍遥孤客邸，邂逅二豪吟。\n面貌誇联璧，风期得断金。\n琴书云阁迥，杖屦雪房深。\n后夜芙蓉色，湖头次第寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16355,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题野鹤孤云卷赠闫道人","author":"胡应麟","text":"科头无一事，松下日盘桓。\n骨相堪鹏背，生年异鹖冠。\n月轮天柱顶，云色洞庭干。\n薄暮扬舲去，相携问大丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16356,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日溪南晚眺适赵生携酒共酌村店中","author":"胡应麟","text":"行行随杖履，徙倚夕阳斜。\n野寺明枫叶，山篱著豆花。\n飞鸥过浅濑，浴鹭上浮查。\n之子期方到，悠然问酒家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16357,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄大司空朱公六首 其一","author":"胡应麟","text":"德望三朝旧，勋名八座馀。\n庙堂周太保，剑履汉尚书。\n翼矫丹霄凤，鳞潜碧海鱼。\n惟应并南斗，万古照匡庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16358,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄大司空朱公六首 其二","author":"胡应麟","text":"赐履优前代，乘桴记昔年。\n龙蛇驱大陆，蛟鳄奠长川。\n宦绩昆崙外，神功碣石前。\n试看淮渎庙，禹碣至今传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16359,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄大司空朱公六首 其三","author":"胡应麟","text":"社稷忧仍在，中华问转频。\n帝能优大老，史已传名臣。\n紫气偏南极，青云自北辰。\n无论汉宫远，玉树正嶙峋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16360,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄大司空朱公六首 其四","author":"胡应麟","text":"里闬知司马，乾坤识卧龙。\n为园名独乐，抱膝寄孤悰。\n瀑布檐前水，香炉坐右峰。\n大江西望处，愁绝暮云重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16361,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄大司空朱公六首 其五","author":"胡应麟","text":"长日东林下，看花自闭关。\n绿偏裴相野，青占谢公山。\n啸傲藜床静，登临竹杖閒。\n独馀忧国梦，时到紫宸班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16362,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄大司空朱公六首 其六","author":"胡应麟","text":"尚忆风尘际，能高物色情。\n吹嘘惭国士，吐握为儒生。\n山水孤琴合，虹霓一剑鸣。\n含珠十年梦，无路报投琼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16363,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王孙贞吉以手镌印章寄惠走笔奉谢","author":"胡应麟","text":"遥遥双玉佩，赠我意何勤。\n石鼓周王篆，金泥汉帝文。\n蛟螭寒压雾，科斗暗藏云。\n万古岣嵝碣，何时一对君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16364,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪夜邦相过斋中小集四首 其一","author":"胡应麟","text":"寂寞幽人卧，追寻茂宰贤。\n飞觞临夜雪，把袂坐高天。\n剡曲三更棹，梁台万古筵。\n异时吾党事，兰水定谁传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16365,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪夜邦相过斋中小集四首 其二","author":"胡应麟","text":"不谓山斋雪，能来侍从臣。\n谈诗双郢客，和曲几巴人。\n玉笛生春早，金尊促夜频。\n晓来飞舄处，瑞气满枫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16366,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪夜邦相过斋中小集四首 其三","author":"胡应麟","text":"彩笔寒相对，朱弦晚故留。\n飞仙谁鹤氅，野客自鹴裘。\n拥坐城云立，窥筵海月流。\n预愁新赋出，人拟兔园游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16367,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪夜邦相过斋中小集四首 其四","author":"胡应麟","text":"此夜平原醉，人间更有无。\n乾坤悬玉阙，日月坐冰壶。\n磊落新词社，萧条旧酒垆。\n灞桥回首处，凄绝断云孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16368,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与惟寅一别淹冉五载消息不复相闻春来忽得手书新刻见寄赋怀五首 其一","author":"胡应麟","text":"赐履传周室，分符卫汉京。\n白虹悬结客，紫电照论兵。\n四百西山寺，三千大内营。\n几因飞檄暇，出郭遍题名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16369,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与惟寅一别淹冉五载消息不复相闻春来忽得手书新刻见寄赋怀五首 其二","author":"胡应麟","text":"带砺中朝望，诗书上将才。\n佩刀初制阃，横槊自登台。\n万骑长城合，孤鸿大漠回。\n河梁人渐老，吟望独徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16370,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与惟寅一别淹冉五载消息不复相闻春来忽得手书新刻见寄赋怀五首 其三","author":"胡应麟","text":"长啸青油幕，雄谈白氎巾。\n射雕新骠骑，图象旧麒麟。\n雪照梁园夜，风高瀚海晨。\n遥遥双鲤下，犹忆尚玄人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16371,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与惟寅一别淹冉五载消息不复相闻春来忽得手书新刻见寄赋怀五首 其四","author":"胡应麟","text":"忆昔长安骑，相逢狭路间。\n乾坤双彩笔，吾汝各红颜。\n万感归来集，千秋病后閒。\n惟应别时梦，绕夜向燕关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16372,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与惟寅一别淹冉五载消息不复相闻春来忽得手书新刻见寄赋怀五首 其五","author":"胡应麟","text":"一代华阳社，平生碣石游。\n坐携鹓鹭侣，吟傍凤凰楼。\n梦寐犹青眼，形容渐白头。\n尺书聊写寄，涕泪尽南州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16373,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄朱在明光禄","author":"胡应麟","text":"夙昔长安社，朱家兴独豪。\n深杯传竹叶，艳曲度樱桃。\n宦拙从鸡肋，身闲付蟹螯。\n近来偏忆汝，愁望大江涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16374,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄丘谦之","author":"胡应麟","text":"底事丘灵鞠，年来复罢官。\n惊心吾道左，落魄世途难。\n月过衡峰近，星离益部寒。\n九歌何日就，洒泣傍南冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16375,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄朱汝脩山人","author":"胡应麟","text":"掌露偏谁得，秋风各未苏。\n骨仍沧海立，魂傍碧山孤。\n白帢名先后，青囊术有无。\n几时携竹杖，燕市问悬壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16376,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再寄在明","author":"胡应麟","text":"见说休官后，乡园乐更饶。\n屏开张静婉，坐列董娇娆。\n紫电黄金勒，红霞白玉箫。\n兴来应载酒，时醉广陵桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16377,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"膝汝载先生卜筑武夷邀余过访余以家慈卧床褥尚孤此约感念今昔不胜怅惘敬赋小诗奉寄凡八章 其一","author":"胡应麟","text":"北极声华久，东山气象新。\n乍辞文苑秩，初乞武夷身。\n辟地连三岛，看天卧七闽。\n惟应幔亭月，时傍紫纶巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16378,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"膝汝载先生卜筑武夷邀余过访余以家慈卧床褥尚孤此约感念今昔不胜怅惘敬赋小诗奉寄凡八章 其二","author":"胡应麟","text":"九曲移家近，三山入望遥。\n楼台临碧汉，户牖逼青霄。\n坐叩梅仙诀，行逢木客谣。\n袛疑尘世隔，无路问渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16379,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"膝汝载先生卜筑武夷邀余过访余以家慈卧床褥尚孤此约感念今昔不胜怅惘敬赋小诗奉寄凡八章 其三","author":"胡应麟","text":"游神近何所，三十六峰前。\n鸟下谈经榻，猿窥问字船。\n飞萝悬白日，古树拂苍烟。\n彷佛秦人住，桃花隔涧泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16380,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"膝汝载先生卜筑武夷邀余过访余以家慈卧床褥尚孤此约感念今昔不胜怅惘敬赋小诗奉寄凡八章 其四","author":"胡应麟","text":"胜许庞公擅，名应善卷逃。\n挂瓢沧海阔，倚杖碧山高。\n万事留青鬓，孤忠藉彩毫。\n无嗟塞翁意，天地一鸿毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16381,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"膝汝载先生卜筑武夷邀余过访余以家慈卧床褥尚孤此约感念今昔不胜怅惘敬赋小诗奉寄凡八章 其五","author":"胡应麟","text":"柳色吴天梦，梅花粤峤情。\n吏才高汉代，儒术重周京。\n雾泽南山豹，云寒北海鲸。\n无言帝阍隔，咫尺是蓬瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"膝汝载先生卜筑武夷邀余过访余以家慈卧床褥尚孤此约感念今昔不胜怅惘敬赋小诗奉寄凡八章 其六","author":"胡应麟","text":"黼黻真王佐，丝纶暂钓徒。\n中天仪凤杳，大海蛰龙孤。\n入梦犹金钥，翻歌自玉壶。\n向来门下士，桃李遍三吴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"膝汝载先生卜筑武夷邀余过访余以家慈卧床褥尚孤此约感念今昔不胜怅惘敬赋小诗奉寄凡八章 其七","author":"胡应麟","text":"作赋惭鹦鹉，空群辨鹔鹴。\n千人摧稷下，一士擅襄阳。\n色借青云迥，心悬白日长。\n惟应梦中路，惚忽到沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"膝汝载先生卜筑武夷邀余过访余以家慈卧床褥尚孤此约感念今昔不胜怅惘敬赋小诗奉寄凡八章 其八","author":"胡应麟","text":"九折王阳道，千秋大隐庐。\n云山容负笈，宇宙碍驱车。\n业岂门人尽，名犹国士馀。\n凭将一掬泪，遍洒越山隅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得安仲子书却寄","author":"胡应麟","text":"叹息延陵客，清才独后时。\n三都全入赋，五岳半题诗。\n壮节摧青鬓，雄心狎翠眉。\n吴天花欲尽，好订白云期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀祝鸣皋","author":"胡应麟","text":"南归书札断，北望旧游孤。\n一铩悲鸾翮，三年问狗屠。\n汝才宁巷陌，吾道实江湖。\n几夜狂歌发，寒云碎玉壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16387,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉寄司成许公二首 其一","author":"胡应麟","text":"一代崇周学，诸生侍鲁儒。\n田何惭受易，伏胜早传书。\n八座飞腾外，三垣怅望馀。\n犹思问奇日，大雪满庭除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16388,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉寄司成许公二首 其二","author":"胡应麟","text":"载籍穷金马，论思坐玉堂。\n洪钧回稷契，大典翊成康。\n日近尚书履，霞明学士裳。\n生徒愧原宪，十载梦长杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16389,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上元观灯有怀京华旧游时集邦相署 其一","author":"胡应麟","text":"山城逢令节，灯火暂同游。\n月映千花上，星从万树流。\n遗簪连紫陌，委佩出朱楼。\n不是金吾地，无妨彻夜留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16390,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上元观灯有怀京华旧游时集邦相署 其二","author":"胡应麟","text":"远忆长安道，华灯正陆离。\n云霞千蜃结，山嶂六鳌移。\n玉佩邀春早，铜壶听夜迟。\n即今天禄畔，太乙傍谁嬉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16391,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"周公瑕书来索余赠言为赋二首 其一","author":"胡应麟","text":"作赋元惊坐，临池更擅场。\n真行王大令，篆隶蔡中郎。\n巨榜高天揭，穷碑绝域藏。\n太湖花满目，斟酌欠书航。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16392,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"周公瑕书来索余赠言为赋二首 其二","author":"胡应麟","text":"诗名人自老，墨妙世谁如。\n瘗鹤高风在，笼鹅逸兴馀。\n藜然中垒坐，花浣少陵居。\n最忆长安日，垂髫问子虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16393,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"顾朗生山人以四诗见贻赋答 其一","author":"胡应麟","text":"万感红颜尽，孤踪白眼馀。\n何堪梁苑客，遥寄茂陵书。\n雪色晴偏照，星芒昼不除。\n太湖蓑艇畔，谁共觅鲈鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16394,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]