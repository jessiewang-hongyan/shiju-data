[{"title":"忆得四首 其四","author":"孙蕡","text":"忆得曾陪紫府仙，风流儒雅兴翛然。\n夜来贪玩西窗月，花影侵阶尚未眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48563,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙江夜泊","author":"孙蕡","text":"蒋山山头秋月明，龙江江上暮潮生。\n行人又是金陵客，卧听西风鼓角声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48564,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下邳","author":"孙蕡","text":"淮南五月叫春鸠，花落清河锦浪流。\n偏恨寂寥乡思里，澹烟寒月下邳州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48565,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吕梁洪","author":"孙蕡","text":"惊涛触石雪潺潺，五月河风尚作寒。\n问讯南来荆楚客，官船几日到淮安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48566,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"聊城","author":"孙蕡","text":"雨浥颓墙草翳空，鲁连千载见高风。\n愁来自撚鸦翎箭，日落登城射断鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48567,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"聊城见荷二首 其一","author":"孙蕡","text":"疏疏寒绿间天香，细雨微风澹晓妆。\n忆在古原山县里，寂寥三载负红芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48568,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"聊城见荷二首 其二","author":"孙蕡","text":"花不成妆藕未乾，嫩红新叶卷轻寒。\n官河水落南风小，不似贺家湖上看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48569,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"武城","author":"孙蕡","text":"独上荒城野日阴，弦歌千载忆遗音。\n黄堂皂盖成尘土，何处春风绿绮琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48570,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过荏平望峄山","author":"孙蕡","text":"邑敝天寒草殒青，授经谁吊伏生灵。\n巉岩石刻虽奇古，终慊沙邱混鲍腥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48571,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"周公","author":"孙蕡","text":"帝子挥戈复故都，三监才略佐鸿图。\n扶危不仗苍髯老，谁奉新王六尺孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48572,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"范蠡","author":"孙蕡","text":"已作江湖物外仙，归舟谁遣载婵娟。\n登楼有客思倾国，几度临风夜不眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48573,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"伍子胥","author":"孙蕡","text":"忠言极谏起君猜，嚭宰谗行赐剑来。\n从此强吴随作沼，果然麋鹿走高台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48574,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄歇","author":"孙蕡","text":"终古天心不可亏，阴谋祇是得倾危。\n春申更使能成事，只似秦家吕不韦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48575,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荆轲","author":"孙蕡","text":"悲歌慷慨发冲冠，上殿披图却胆寒。\n生劫诅盟缘底事，错将秦政比齐桓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48576,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"昭陵","author":"孙蕡","text":"万里山河几战征，阿爷机不见先明。\n春城鼓吹黄金甲，肯伴藩臣奉乃兄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48577,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苻坚","author":"孙蕡","text":"战斗争雄国作墟，雠民恨不总为鱼。\n谁云未得降王长，先向长安为卜居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48578,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"二乔","author":"孙蕡","text":"中原落日一星黄，虎跃龙跳有底忙。\n漳水凤台高百尺，小姑何用嫁刘郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48579,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赤壁","author":"孙蕡","text":"百里旌旗蔽楚天，黄龙青雀化炎烟。\n可怜酾酒临江上，正是孙郎跃马年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48580,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"魏台","author":"孙蕡","text":"魏台金雀舞晴空，剑阁云烟起卧龙。\n词客倚楼空作赋，不骑羸马向西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48581,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"姑苏台","author":"孙蕡","text":"袅袅江风泛玉台，荔枝香老木瓜开。\n娥眉不饮杯中酒，日暮阊门野鹿来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48582,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灵岩寺","author":"孙蕡","text":"屧廊犹记馆娃名，照水荒台草自青。\n几树芙蓉开水阁，雨馀西子醉初醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48583,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"姑苏开元寺","author":"孙蕡","text":"梵宫春尽落花时，倦鸟犹啼竹树枝。\n想见风流唐太守，绿阴满院坐题诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48584,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望九华山","author":"孙蕡","text":"一叶扁舟渺漠间，白云飞处九华山。\n生来自有清幽兴，每被微官误却闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48585,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过赤壁","author":"孙蕡","text":"楼橹炎烟旧事非，留题孤壁月斜时。\n周郎慷慨空横槊，如此江山不赋诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48586,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过荆州","author":"孙蕡","text":"高情长记仲宣楼，醉里临风赋倦游。\n千载词华人似玉，客船今日过荆州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48587,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巫山","author":"孙蕡","text":"巫山高高知几重，朝云暮雨楚王宫。\n人心对面有巇险，更胜高唐十二峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48588,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出蜀二首 其一","author":"孙蕡","text":"白帝秋高木叶黄，蜀中长是雨浪浪。\n瞿塘水落漩涡小，一路看山到岳阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48589,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出蜀二首 其二","author":"孙蕡","text":"雄风淅淅雨凄凄，啼杀春山蜀子规。\n江到岳阳舟楫稳，梦魂从此怯巴西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48590,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次张仲举诗韵四首 其二","author":"孙蕡","text":"江上依稀栗里峰，峰前隐约故园松。\n征鸿尽向南天没，不为离人寄一封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48591,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次张仲举诗韵四首 其三","author":"孙蕡","text":"远游三载别青峰，见画长思问竹松。\n归棹五湖烟水阔，柴门应有落花封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48592,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次张仲举诗韵四首 其四","author":"孙蕡","text":"云连江上九华峰，露沐仙家五粒松。\n但使风光如画里，馀生不羡五侯封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48593,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其一","author":"孙蕡","text":"仙衣自种一池荷，采采青黄当绮罗。\n怪底迩来秋气早，水禽飞去晓霜多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48594,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其二","author":"孙蕡","text":"纨绮纷纷几战场，闲身赢得水云乡。\n扁舟日暮鸣榔去，付与沙鸥管夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48595,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其三","author":"孙蕡","text":"去日三吴乐事饶，木兰船上醉吹箫。\n松风惊觉游仙梦，疑是钱塘八月潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48596,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其四","author":"孙蕡","text":"自别瀛洲鹤背寒，石田茅屋岁漫漫。\n梅花几树先春发，犹似金莲炬照看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48597,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其五","author":"孙蕡","text":"学炼还丹岁月迟，要观沧海倒枯时。\n人间甲子成何事，不似山翁一局棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48598,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其六","author":"孙蕡","text":"偶趁新凉理钓船，秋云映水色澄鲜。\n渔童解撒拦江网，剩得槎头缩项鳊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48599,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其七","author":"孙蕡","text":"浅水渔船学抢风，竹竿斜着抗孤篷。\n青蒲叶底寒波起，吹入芦花汊港中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48600,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其八","author":"孙蕡","text":"野老烹鸡会四邻，瓦盆盛酒乱无巡。\n风林自奏阳春曲，一日莺声到夕曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48601,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其九","author":"孙蕡","text":"远公莲社久相招，老大无心到石桥。\n遥想东林山月出，白猿啼处树萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48602,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其十","author":"孙蕡","text":"十载山中读道经，石坛烟雨桂花生。\n年来卖药长安市，渐喜无人识姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48603,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其十一","author":"孙蕡","text":"隐去无心恋岁华，惟同野老问桑麻。\n门前莫种青青柳，怕有人呼县令家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48604,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其十二","author":"孙蕡","text":"酒伴诗僧日见嫌，高歌剧饮坐柽阴。\n留连莫怪杯中尽，剩有床头旧赐金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48605,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其十三","author":"孙蕡","text":"高原极目浩茫茫，鸟尽遥天若个长。\n一片夕阳秋草地，不如今古几兴亡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48606,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其十四","author":"孙蕡","text":"醉里临风吊屈原，楚吟空赋远游篇。\n凌空语气谁能解，千古惟应待我传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48607,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其十五","author":"孙蕡","text":"试学鸱夷物外情，水云空阔钓舟横。\n从来用尽无高策，浪得归湖范蠡名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48608,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其十六","author":"孙蕡","text":"终古无名识是非，百年高兴子陵矶。\n沙鸥不管人间事，细雨斜风自在飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48609,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其十七","author":"孙蕡","text":"王裴仙子住山椒，静夜能来不待招。\n莫怪寒林星斗黑，野人疏懒坐相邀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48610,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其十八","author":"孙蕡","text":"长乐歌钟醉五侯，沧浪何似泛扁舟。\n无人解得閒中意，云满秋空水自流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48611,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其十九","author":"孙蕡","text":"厌看桃李媚春阳，最是秋来乐意长。\n千点黄花数行柳，幽居人道似柴桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48612,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其二十","author":"孙蕡","text":"野吟诗句出天成，景物如云眼底生。\n白石江头乌桕树，夕阳疏雨鹁鸠声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48613,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其二十一","author":"孙蕡","text":"鹤背腰缠有几家，老陶贫薄太无涯。\n青鞋布袜归来好，却使无钱对菊花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48614,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其二十二","author":"孙蕡","text":"依山茅屋小于舟，吟对风光忆旧游。\n平地白云秋万顷，五湖烟水似扬州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48615,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其二十三","author":"孙蕡","text":"村醪旧瓮按新篘，四月蚕成麦亦收。\n但使百年都若此，吾今于世亦何求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48616,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其二十四","author":"孙蕡","text":"幽花满树酒盈樽，白水斜阳度曲村。\n曾忆少陵风雪里，也曾朝叩富儿门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其二十五","author":"孙蕡","text":"怪底襄阳孟浩然，蹇驴冲雪踏江天。\n无人说与寒梅树，只合开花暖阁边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其二十六","author":"孙蕡","text":"幽居僻类杜陵家，春日垂垂橘柚花。\n花径今朝缘客扫，瓷瓶汲水自煎茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其二十七","author":"孙蕡","text":"冻雾初开日晕青，长松落雪报新晴。\n茅檐闻瀑俄惊起，何处鸿门碎玉声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其二十八","author":"孙蕡","text":"野人于世本无营，尚有闲功日计程。\n筼竹缚梯求密筒，连宵运水捣香粳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其二十九","author":"孙蕡","text":"梦觉哦诗醉后眠，春来秋去总茫然。\n山中历日从来少，欲倩何人记岁年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其三十","author":"孙蕡","text":"本学埋名坐钓矶，谁言天上客星移。\n前滩水落西风冷，觅得羊裘不敢披。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其三十一","author":"孙蕡","text":"回塘曲渚月明多，游妇相呼采芰荷。\n老去风情浑尽减，隔花谁唱竹枝歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其三十二","author":"孙蕡","text":"归休赢得卧中林，坦腹蓬头绿树阴。\n非是葛巾浑忘着，迩来华发不胜簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其三十三","author":"孙蕡","text":"垂柳阴阴护钓矶，溪流尽处着柴扉。\n时人莫用知名姓，清世林泉老布衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其三十四","author":"孙蕡","text":"为报奚童扫绿苔，柴门长日便教开。\n晓烟晴日鹊声急，应有故人天上来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其三十五","author":"孙蕡","text":"勋名本不到旂常，徒得烟霞冷趣长。\n林下一瓢桑落酒，谁云得及市朝香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其三十六","author":"孙蕡","text":"书生元亦羡封侯，经世才迂不自由。\n万一鹤书求野逸，素琴重到碧山幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其三十七","author":"孙蕡","text":"青年出仕奉明君，老去投簪卧白云。\n千载周颙风致在，北山先自错移文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其三十八","author":"孙蕡","text":"桂树丛生山正幽，王孙岁暮尽优游。\n不知招隐缘何事，聒聒风前咏不休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其三十九","author":"孙蕡","text":"约客听琴扫石台，竹门咿轧倚风开。\n空山日暮碧云合，天外美人来不来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48632,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其四十","author":"孙蕡","text":"卯酒初醒午梦馀，南风入户北窗虚。\n闲身已在羲皇上，到此令人悔读书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48633,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其四十一","author":"孙蕡","text":"韩子高轩不再逢，草庐长倩落花封。\n苦无韬略能匡世，伏枕惟应愧卧龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48634,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其四十二","author":"孙蕡","text":"渊明千载我知音，纵有冰弦不鼓琴。\n闻说商于寻绮角，寂寥谁识古人心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48635,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其四十三","author":"孙蕡","text":"云本无心偶出山，幽林薄暮鸟知还。\n如何世上驰驱子，只在红尘扰扰间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48636,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]