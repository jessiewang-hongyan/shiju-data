[{"title":"春宴三首 其二","author":"邓云霄","text":"酒量角沧溟，谈锋落斗星。\n竹林真小饮，河朔未全醒。\n鼓为催花急，杯从斗草停。\n谁看朱似碧，转觉眼逾青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24288,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春宴三首 其三","author":"邓云霄","text":"射鸭绿毛散，呼莺锦翅骄。\n物情供笑语，身世本逍遥。\n丹药何时就，青春未肯饶。\n无如醉乡里，暮暮与朝朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24289,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻笛二首 其一","author":"邓云霄","text":"横吹高楼发，月明清露间。\n风前怨梅柳，曲里度关山。\n陇水声同咽，沙场客未还。\n西邻有思妇，坐叹损朱颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24290,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻笛二首 其二","author":"邓云霄","text":"胡床聊一弄，秋思已千重。\n萧瑟吟寒叶，微茫韵远钟。\n叫云天似水，裂石夜惊龙。\n莫奏单于曲，旄头照夕烽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24291,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送人游吴越二首 其一","author":"邓云霄","text":"送君南骋望，吴越我曾游。\n风物时时胜，湖山处处幽。\n新声余子夜，往事付春秋。\n若问扁舟客，烟波未易求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24292,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送人游吴越二首 其二","author":"邓云霄","text":"风流推二陆，蕴籍想诸王。\n虎阜春犹在，兰亭草未荒。\n徘徊南陌女，半学浣纱妆。\n客思秋偏好，蒪鲈兴不忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24293,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送人入蜀","author":"邓云霄","text":"远客孤舟夜，啼猿度峡时。\n阳台自芜没，云雨至今疑。\n栈险鬼神泣，城春锦绣披。\n峨眉山下月，几度重相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24294,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长门怨二首 其一","author":"邓云霄","text":"一种宫中月，愁人独夜看。\n光辉流别殿，歌舞未曾阑。\n妾妒矜新宠，君恩落旧欢。\n素娥青桂里，相对两同寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24295,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长门怨二首 其二","author":"邓云霄","text":"昔日黄金屋，秋来遍网丝。\n佳人掌上舞，薄命镜中知。\n砌冷蛩声急，庭空雁影悲。\n白头吟更苦，词客亦相欺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24296,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵济宫会饮分韵得天字","author":"邓云霄","text":"松柏深无暑，经堂静法筵。\n谈玄壶里趣，浮白酒中仙。\n棋罢妨柯烂，诗成有鹤传。\n醉归休觅路，人已到罗天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24297,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮相思","author":"邓云霄","text":"明月澄兰沼，金波漾水纹。\n微微写秋色，朗朗至宵分。\n不寐嗔乌鹊，佳期怨碧云。\n相思今夕里，木落一鸿闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24298,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"弹筝女","author":"邓云霄","text":"春风醉客心，二八弹筝女。\n十唤不回言，六弦将手语。\n高调本西秦，流音翻激楚。\n落花天上来，行云无处所。\n日暮泛舟归，盈盈隔河渚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24299,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"后庭隙地莳花草毕灌园成趣稍破岑寂","author":"邓云霄","text":"谁言粉署客，更作灌园翁。\n入静知生意，抽新见化工。\n开窗摇碧色，褰幌引香风。\n地僻心偏远，烟霞想像中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24300,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铜雀妓","author":"邓云霄","text":"玉衣知不举，铜雀若为登。\n漳水歌同咽，浮云势共崩。\n高枝无挂剑，石椁岂铭滕。\n独有台前月，光连汉帝陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24301,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蹴鞠行","author":"邓云霄","text":"蹴鞠蹴鞠，落花随轴。\n上巳清明，新妆袨服。\n醉脱红锦靴，倦入青楼宿。\n射堂走马回鸡，一入场日易西。\n高足遥过飞鸟上，游丝飘絮却嫌低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24302,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蟋蟀篇","author":"邓云霄","text":"城南思妇娇无力，蟋蟀环轩促人织。\n秋至寒衣空旧箱，夜深冷泪徒沾臆。\n闻此虫声意转忙，买丝典却双明珰。\n既从邻女求残烛，更向天孙乞七襄。\n织才半匹犹未了，床下喓喓似相笑。\n借问裁衣寄阿谁，停梭不语自迟迟。\n衣成又恐晨炊乏，塞外狂夫那得知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24303,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送韩孟郁三首 其一","author":"邓云霄","text":"来贵长安纸，归雕季子裘。\n豪怀君自豁，高咏孰能酬。\n易水风吹马，淮河叶洒舟。\n西斋听夜雨，别后倍悲秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24304,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送韩孟郁三首 其二","author":"邓云霄","text":"自怜羁客久，几度送人归。\n况是同心友，分为断雁飞。\n途危孤剑在，天远片帆微。\n想到家园日，鲈鱼晚正肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24305,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送韩孟郁三首 其三","author":"邓云霄","text":"寥寥千古意，谁与更论文。\n别泪悬燕树，离心隔海云。\n空囊知有舌，破釜始能军。\n行矣君须勉，毋为世故棼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24306,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"婕好怨","author":"邓云霄","text":"纨扇偷开故箧看，秋风落叶鬓同残。\n错疑香魄曾奔月，但觉深宫似广寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24307,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"促织歌","author":"邓云霄","text":"促织复促织，锦纹机上愁无力。\n长夜那堪络纬啼，思牵千里肠应直。\n皎皎庭前秋月白，月华偏照长城客。\n梦去不知能作云，坐来却恐身为石。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24308,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"野田黄雀行","author":"邓云霄","text":"唶唶碌碌，舍田而屋。\n虽有斗珠，不如掬粟。\n群集营营，日暮空城。\n催科更急，闻鞭朴声。\n引妇呼雏，何田不飞。\n既投君家，应怜我饥。\n未怜我饥，柘弹在手。\n伊我无知，哀此黄口。\n遗秉滞穗，回念丰年。\n噫嘻，此人无良，环上诉苍天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24309,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三峡","author":"邓云霄","text":"荆门控三峡，六六见巫山。\n往事余林壑，幽情想佩环。\n云归无处所，梦去杳难攀。\n宋宅同台没，悲秋一怆颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24310,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜坐","author":"邓云霄","text":"夜静群动息，明河低度檐。\n香销连暮霭，露重湿寒蟾。\n岁觉容华异，名难吏隐兼。\n闲情原有寄，看取水中盐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24311,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莲曲二首 其一","author":"邓云霄","text":"蛾眉迷叶翠，龙脑乱花香。\n两岸肠堪断，伊人水一方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24312,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莲曲二首 其二","author":"邓云霄","text":"湖上雨来急，兰舟并著归。\n谁怜花解语，水鸟亦依飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24313,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渔父词","author":"邓云霄","text":"澄潭摇绿树，百丈见游鳞。\n垂钩新月随孤艇，荷笠闲云伴老身。\n春来无限桃花水，懒问仙源碧山里。\n鱼肥酒美笑自斟，草暖沙暄常晏起。\n休论生计近如何，吹笛鸣榔发棹歌。\n大隐不须加帝腹，太平宁用把周戈。\n颇怪儿童呼系缆，洲前清浅静无波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24314,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"细雨斋居","author":"邓云霄","text":"边风吹雨来，萧疏满城阙。\n高斋一沾洒，叶底蝉声歇。\n盆鱼纷唼藻，园卉芽渐茁。\n听雨淡幽虑，观物神自悦。\n闭门人事少，吏散养吾拙。\n烹葵兼烧笋，清供堪一啜。\n呼童蓄旨酒，有待期华月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24315,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晨起","author":"邓云霄","text":"扫地焚香任此身，斋居孤兴在清晨。\n参禅已断三生想，漱齿能消五浊尘。\n眼底风花随气改，夜来蕉鹿辨谁真。\n片云作对晴丝卷，方信虚空不属人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24316,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观演西施歌舞席上赋","author":"邓云霄","text":"绿酒对芳辰，红妆倚绣茵。\n可怜花月夜，再见苧罗人。\n大小双垂手，轻盈百媚身。\n不知歌舞散，幽意定谁亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24317,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观云篇","author":"邓云霄","text":"片云停高空，微风忽相扇。\n白衣与苍狗，恍惚须更变。\n持将比世情，百态今可见。\n谁能决浮云，银汉弄清浅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24318,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湘妃曲","author":"邓云霄","text":"搴芳徒欲荐，仙佩杳难期。\n湘水无情极，行舟唱竹枝。\n君山湖上好，清镜映修眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24319,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏朝凉","author":"邓云霄","text":"细雨夜来收，高斋爽气浮。\n朝凉疑过夏，远客易惊秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24320,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻黄河又决","author":"邓云霄","text":"驱驰河上泣迷津，亲见冠裳尽负薪。\n本谓宣房无穴蚁，岂知河伯又劳人。\n铜龙未解蟠堤堰，璧马谁云奠鬼神。\n物力东南虚百万，况惊西北报胡尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24321,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"问张维成病兼邀夜话","author":"邓云霄","text":"交游漫说半中原，十载知心独尔存。\n眼底寒暄同逆旅，病中风雨易黄昏。\n著书徒益相如渴，罗雀谁过翟氏门。\n便可支愁共沉醉，短檠犹足照青尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24322,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客子","author":"邓云霄","text":"客子庖厨薄，日来蝇鼠稀。\n自知心更远，敢谓俗能违。\n上客无回辙，呼童莫掩扉。\n宦情今可见，已息汉阴机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24323,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晴","author":"邓云霄","text":"衣桁熏蒸上绿苔，新晴初报鼓钟催。\n当阶穴蚁翻相贺，隔柳流莺怅未回。\n缥缈断虹拖过雨，朦胧斜日映轻雷。\n久阴顿觉晴光好，花底何辞浊酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24324,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暑日","author":"邓云霄","text":"褦襶休经过，闲门绿树中。\n衣裁南地葛，枕待北窗风。\n换水新浇钵，焚香试小童。\n浊醪聊一酌，更截碧荷筒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24325,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暑夜","author":"邓云霄","text":"入夜暑气微，轻云如递浪。\n滔滔漾星月，转觉银河涨。\n秋期水更阔，牛女亦惆怅。\n乌鹊若精卫，危桥将安傍。\n余家云海边，万里遥相望。\n夜夜归梦劳，杂波涛峦嶂。\n一为别鹤吟，僮仆悲自向。\n寄语停梭子，人间亦天上。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24326,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"紫骝马","author":"邓云霄","text":"人好马亦好，翩翩美少年。\n挫金兼喷玉，逐电不劳鞭。\n长楸蹀躞去，草色碧如烟。\n徒矜呼鹰手，更胜斗鸡钱。\n边城烽火急，肯为向幽燕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24327,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得蜀中佳胜赠顾桐柏","author":"邓云霄","text":"蜀川形胜称佳丽，朱夏峨眉带雪明。\n水浣鱼笺巴作字，花浓鸟道锦为城。\n琴中听曲千重意，梦里行云一片情。\n屈指近时词赋客，怜君独擅马卿名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24328,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京早秋","author":"邓云霄","text":"旅食京华且岁时，西风又报入桐枝。\n积薪宦况秋逾冷，落叶惊心鬓易丝。\n朔气近边闻雁早，岭云临海得书迟。\n忧时寄远俱无赖，惆怅新停浊酒卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24329,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"家报举次子志喜","author":"邓云霄","text":"乡心秋思满瑶京，忽报添丁慰旅情。\n岂谓双珠能照乘，且看凡鸟亦和鸣。\n劬劳转忆亲恩重，生养欣逢圣世平。\n到日祗堪供笑语，傍人休浪拟徐卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24330,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"妖雹歌","author":"邓云霄","text":"君不见女娲补天今更裂，纷纷白石飞成屑。\n共工触倒西域山，纷纷积雪落燕关。\n人传涿鹿尤死，岁久游魂招复起。\n气结荆轲贯日虹，银甲白袍临易水。\n初闻诸怪屯雷风，更闻翻却鲛人宫。\n跳珠挟弹奔万马，水天一日消炎夏。\n马头鸡子古有之，阳愆阴伏谁所为。\n去年坛槐已偃仆，龙神无声老蛟怒。\n中原怨气连虎豺，休疑蜴蜥成阴霾。\n宋君片语能移灾，但愿皇天斩妖孽，香云甘露开日月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24331,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋早口号","author":"邓云霄","text":"看扫盈阶叶，因惊昨夜风。\n曙光晞早露，帘影隔残蛩。\n潦倒形骸外，羁栖旅病中。\n越吟欣得句，不拟作书空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24332,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈秘书还楚","author":"邓云霄","text":"登山临水远将归，木叶萧萧四牡騑。\n五两浮湘秋浦阔，三杯把袂故人稀。\n秘书夜冷燃藜阁，芳杜晴熏书锦衣。\n醉罢楼头跨黄鹤，几时还向帝城飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24333,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闲说","author":"邓云霄","text":"沉吟不语向秋云，仰面晴空数雁群。\n忽尔叩门来衲子，朗然闲说至宵分。\n橘中未辨谁赢局，蜗角曾闻已覆军。\n自觉豪华如梦里，不须金偈更排棼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24334,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋月吟","author":"邓云霄","text":"长安万古月，偏爱向秋明。\n冷逼怜砧急，光浮塞角清。\n狂涛翻瀚海，孤照落龙城。\n侧想征人意，堪听牧马鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24335,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋月食二首 其一","author":"邓云霄","text":"黄衢成黑道，灵兔惑妖蟆。\n祗恐琼宫女，随风落别家。\n霓裳中夜歇，鼓角万方嗟。\n铅粉轻磨镜，清光应更加。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24336,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋月食二首 其二","author":"邓云霄","text":"露华澄月色，可爱是中秋。\n岂料清光夕，翻成秉烛游。\n水轮初掩匣，玉帐乍悬钩。\n试问停杯客，何如风雨愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24337,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻陈九吾楚中讣 其一","author":"邓云霄","text":"几年淹薄宦，怜汝在长沙。\n赋鵩日斜里，哀湘天一涯。\n掀髯看意气，梦笔想才华。\n纵化辽东鹤，归来岁月赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24338,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻陈九吾楚中讣 其二","author":"邓云霄","text":"未起双凫舄，先惊白玉棺。\n岂虞终客死，翻恨有微官。\n素旐秋猿泣，舟枫楚水寒。\n诸姬帏帐冷，班竹泪同残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24339,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻陈九吾楚中讣 其三","author":"邓云霄","text":"忆昔论文夜，西垣片月高。\n形骸非俗态，天地只吾曹。\n魂返关山远，船回雁鹜号。\n广陵孤调绝，玉轸向谁操。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24340,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日书怀","author":"邓云霄","text":"怀归心正苦，九日懒登高。\n旧恨缠孤剑，新霜入二毛。\n松揪悬远梦，岐路念绨袍。\n不作悲秋赋，抽毫漫续骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24341,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬至前三日对雪时值圣母万寿与陈裕所同赋禁用雪套","author":"邓云霄","text":"黯黯严寒旅思催，香醪兽炭对衔杯。\n慈云偏向蓬莱绕，宝雨遥从佛国来。\n六管浮灰将变律，千门残笛暗惊梅。\n欲观净土琉璃界，更上西风百尺台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24342,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"至日即事二首 其一","author":"邓云霄","text":"开阁迎长半捲帘，开尊空对水精盐。\n天心暗逐微阳转，华发新随一线添。\n岁晏龙蛇藏冻浦，雪晴鸦雀下虚檐。\n苍茫杀气缠辽左，台上书云莫浪占。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24343,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"至日即事二首 其二","author":"邓云霄","text":"江湖霜雪绝飞鸿，迢递乡书杳未通。\n万里授衣思履袜，十年羸马叹西东。\n闭关行旅萧条后，吹律回春想望中。\n谁道省方当息驾，君王元只在深宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24344,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送梁书之年丈以大参提兵霸州","author":"邓云霄","text":"纷纷将吏候朱轓，清佩初辞左掖垣。\n焚草夜悬霜匣冷，登坛星拥节旄尊。\n长城胡马防南牧，圣主宵衣问北门。\n锁钥安闲多暇日，好看游骑猎秋原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24345,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送别同社太史汤嘉宾奉使册封便道省祝两尊人寿","author":"邓云霄","text":"千仞龙门昼不启，论诗对酒眼逾青。\n新持汉节虚莲社，喜奉潘舆入鲤庭。\n称庆金茎浮瑞露，延年玉札秘仙经。\n白云谣后人难和，何日逢君得再听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24346,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送冯太学还粤","author":"邓云霄","text":"入洛才名众所尊，翩翩清誉满桥门。\n朅来自挟风云气，归去谁同水竹村。\n漫唱离歌催客子，独怜芳草怨王孙。\n送君忽起罗浮思，猿鹤秋山欲断魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24347,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午日雨阻郊游同韩孟郁集张孟奇斋头得枝字","author":"邓云霄","text":"踏青郊外负前期，浮白斋头对故知。\n燕草断肠还细雨，湘兰无路寄哀词。\n辟兵处处闻鼙鼓，绩命年年长鬓丝。\n休咏四愁添旅思，越禽偏爱向南枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24348,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"问讯区用孺谪居滁阳囧寺","author":"邓云霄","text":"谁读遗骚怨谪居，风烟南望眇愁予。\n怀人不隔三湘水，经岁难逢尺素书。\n世往亭荒空对酒，卧中山色尽环滁。\n遥怜苜蓿秋原满，天马歌残意有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24349,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新制冰纱梅花帐张孟奇题额多丽词赋以戏之","author":"邓云霄","text":"帐底梅花度暗香，炎天霜雪午生凉。\n初唏短发风敲竹，半卷疏帘月到床。\n度岭寄来人更远，罗浮归去梦偏长。\n清斋已比寒梅瘦，怪尔新词恼太常。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24350,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏夜同李伯远张孟奇韩孟郁小斋听雨","author":"邓云霄","text":"蓊郁庭槐待濯枝，虚堂爽气转秋姿。\n翻灯洒幕声交响，促漏遥钟夜暗移。\n万里羁栖同逆旅，百年怀抱对传卮。\n月华合在层阴上，天柱峰头起远思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24351,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"集米仲诏湛园分得松关花径戏作长歌二首 其一 松关","author":"邓云霄","text":"巨灵驱山作平地，徂徕移在名园里。\n倒茑垂萝倚牖翻，夜夜波涛聒人耳。\n龙鳞马鬃浩呼汹，萧森转觉秋原空。\n有时风静横挂月，鹤梦渐醒露华发。\n残钟远磬度林迟，坐来谡谡凊肌骨。\n换骨求仙待■苓，更携灵笈阅丹经。\n叩门恐有赤松子，为报云关且莫扃。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24352,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]