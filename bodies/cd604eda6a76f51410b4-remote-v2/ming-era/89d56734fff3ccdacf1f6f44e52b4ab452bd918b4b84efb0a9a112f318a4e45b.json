[{"title":"题赵太祖蹴鞠图","author":"胡奎","text":"一气洪濛运化钧，乾旋坤转不停轮。\n等閒蹴起东方日，却是当年大耳人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56782,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题绿阴垂钓图","author":"胡奎","text":"白鸥分席坐青苔，一片凉阴扫不开。\n莫道清漳音信远，鲤鱼时上钓丝来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56783,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题携琴图","author":"胡奎","text":"松花落粉春昼閒，童子抱琴朝出山。\n明朝有意更相访，莫遣白云深掩关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56784,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题钓鱼图","author":"胡奎","text":"三山空翠压金鳌，钓得珊瑚出海涛。\n定有双鱼传尺素，矶头春水夜来高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56785,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"枯木竹石图","author":"胡奎","text":"蓬莱石上珊瑚树，更向琅玕一处栽。\n不是任公钓鳌手，如何移得世间来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56786,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画","author":"胡奎","text":"白石矶头春水生，南山空翠太分明。\n石南树下无人到，坐看渔翁钓晚晴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56787,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雩阳十景 其一 川江秋月","author":"胡奎","text":"江如川字月如盘，曾向龙门绝顶看。\n三载思家东海上，二千里外亦团圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56788,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雩阳十景 其二 三峡暮云","author":"胡奎","text":"西峡夕阳东峡红，白云生峡正当中。\n莫道无心作霖雨，等閒飞起便从龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56789,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雩阳十景 其三 龙门夜雨","author":"胡奎","text":"两崖千仞自天开，闻道当年手凿来。\n黑水翻江龙出峡，惊涛夜夜作春雷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56790,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雩阳十景 其四 鸡嶂晓烟","author":"胡奎","text":"旸谷金鸡天上啼，日高青嶂树烟低。\n从教截得山前路，一寸乡心定不迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56791,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雩阳十景 其五 青山瀑布","author":"胡奎","text":"银汉翻空作雪飞，近山浑欲换秋衣。\n月钩斜挂真珠箔，不碍仙人跨鹤归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56792,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雩阳十景 其六 紫阳甘泉","author":"胡奎","text":"灵泉百尺接龙潭，一日能酸一日甘。\n笑我交情淡如水，从今不必论酸咸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56793,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雩阳十景 其七 乌石砂图","author":"胡奎","text":"乌石冈头沙似雪，古来名胜说雩都。\n雨晴鸟迹分明见，画史惊看十县图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56794,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雩阳十景 其八 罗岩曲水","author":"胡奎","text":"濂溪祠在碧岩前，下有流觞九曲泉。\n前代风流遗墨在，山阴空费打碑钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56795,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雩阳十景 其九 胡僧竹","author":"胡奎","text":"西域僧来双眼碧，履声敲碎玉娟娟。\n触机悟得无生法，始信虚心即是禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56796,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雩阳十景 其十 梁山古桧","author":"胡奎","text":"斗岩老桧自梁朝，上有飞仙不可招。\n拟借玉笙吹一曲，满天凉月送王乔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56797,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨子江中有作","author":"胡奎","text":"江风吹浪葛衣单，遥认金焦两点山。\n落日片帆归鸟疾，直随秋色到龙湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56798,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜何使君至雨中有作 其一","author":"胡奎","text":"去年正月出京华，马上看灯直到家。\n今岁归时春未半，满城风雨又催花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56799,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜何使君至雨中有作 其二","author":"胡奎","text":"江城春雨酿馀寒，一尺青泥尚未乾。\n无限故园桃李树，好花留待使君看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56800,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"襄阳童儿歌","author":"胡奎","text":"高阳池水绿如苔，日日襄阳太守来。\n倒著接䍦扶上马，日斜乘醉看花回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56801,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湘妃泣竹","author":"胡奎","text":"湘竹斑斑楚水流，湘娥夜泣楚云秋。\n直教积泪成江水，一滴春痕一滴愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56802,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"二乔观书","author":"胡奎","text":"自小看书在绣帏，天生国色世应稀。\n曾知丑妇无才貌，也向南阳嫁布衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56803,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嫦娥奔月","author":"胡奎","text":"岂是人间不可居，飞身自跨玉蟾蜍。\n祗缘天上无离别，织女牵牛莫笑渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56804,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"巫女行云","author":"胡奎","text":"楚云如梦梦如云，云梦相牵两不分。\n妾若是云君是梦，云当为妾梦为君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56805,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨妃病齿","author":"胡奎","text":"侍儿扶起倦看花，不道春寒入齿牙。\n獭髓纵能医病颊，蠹根先长在唐家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56806,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西施捧心","author":"胡奎","text":"妾住西家本姓施，越王尝胆已多时。\n至今独抱心中苦，长向春宫锁翠眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56807,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虞姬伏剑","author":"胡奎","text":"当时玉斗碎鸿门，碧血空沾楚剑痕。\n满地落花皆汉土，不知何处著春魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56808,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"文君当垆","author":"胡奎","text":"苦乐相从不厌贫，白头甘守瓮头春。\n茂陵原上多姝子，未必新人胜故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56809,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"昭君出塞","author":"胡奎","text":"玉颜一别汉宫花，雁背霜寒万里沙。\n说与当时边上将，铙歌只合奏琵琶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56810,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"绿珠坠楼","author":"胡奎","text":"花飞金谷綵云空，玉笛吹残步障风。\n枉费明珠三百斛，荆钗那及嫁梁鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56811,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画扇","author":"胡奎","text":"一月春阴不见山，何人移入素纨间。\n积金峰在空青外，千仞高寒不可攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56812,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送孙府判之重庆 其一","author":"胡奎","text":"五月开船得顺风，巴江一水与天通。\n此行应有还家梦，不隔巫山十二峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56813,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送孙府判之重庆 其二","author":"胡奎","text":"一道巴江万里开，暮帆收雨过阳台。\n蜀中父老欣相报，前度皇华使者来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56814,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出都门有作","author":"胡奎","text":"青龙山前日欲斜，一雨水长没鸥沙。\n青裙老妪索钱去，遮口唤船来载车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56815,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹阳郭外","author":"胡奎","text":"茜裙女儿青髻鬟，腰镰刈麦夕阳间。\n前溪水浅早归去，墨云将雨过前山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56816,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题两翁对奕图","author":"胡奎","text":"绿萝阴阴覆丹壑，玉局仙翁自为乐。\n山中对奕不知年，世上尘缨安可缚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56817,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题梅","author":"胡奎","text":"曾过罗浮月下村，绿毛么凤立黄昏。\n如何也作三生梦，飞绕梨花一片云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56818,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题红梅 其一","author":"胡奎","text":"散花天女笑春风，醉倚维摩丈室中。\n任尔山禽偷眼看，久知颜色本来空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56819,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题红梅 其二","author":"胡奎","text":"祗王园里有频迦，偶逐春风到我家。\n本是一株无影树，也随明月作空花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56820,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题红梅 其三","author":"胡奎","text":"夜来天女散天花，笑倚春风貌似霞。\n山鸟不须偷眼看，应无一片著袈娑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56821,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题白梅 其一","author":"胡奎","text":"谁写江南雪后枝，疏花冷蕊玉参差。\n频迦也管西来意，啼到青天月上时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56822,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题白梅 其二","author":"胡奎","text":"雪压南枝冻未消，山禽和梦立寒梢。\n分明一片黄昏月，留向禅床伴寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56823,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题子猷访戴图","author":"胡奎","text":"未出门时想戴逵，扁舟兴尽复何之。\n如何不学袁安卧，大雪干人也不宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56824,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题兰亭流觞四绝为郑大尹赋 其一","author":"胡奎","text":"开元供奉侍銮坡，妙墨流传辨永和。\n定武化身千百亿，只今刻石已无多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56825,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题兰亭流觞四绝为郑大尹赋 其二","author":"胡奎","text":"永兴寺里兰亭帖，千古高风不可攀。\n却笑昭陵藏不得，又随金盌出人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56826,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题兰亭流觞四绝为郑大尹赋 其三","author":"胡奎","text":"前朝画史李龙眠，想像流觞曲水边。\n四十二人同列坐，茂林修竹尚依然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56827,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题兰亭流觞四绝为郑大尹赋 其四","author":"胡奎","text":"郑公好画比琼琚，收得山阴褉事图。\n不向昆明随劫火，却从合浦得还珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56828,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题云山图","author":"胡奎","text":"半是秋阴半是晴，数峰云树不分明。\n恍然巫峡舟中见，只欠猿啼一两声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56829,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪晴寄友","author":"胡奎","text":"快雪晴时竹色匀，江南又见一番春。\n出门苦厌青泥滑，十日无由见故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56830,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕过北寺 其一","author":"胡奎","text":"岁晚行过北寺前，枇杷花落雨晴天。\n长斋绣佛从今始，僧腊明朝又一年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56831,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕过北寺 其二","author":"胡奎","text":"岁朝万象最宜春，帖子题来醉墨新。\n今夜枇杷花畔雨，又添情思到诗人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56832,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日","author":"胡奎","text":"自笑百年浑是醉，不知今日始逢人。\n朝来净洗醒时眼，一一从头看好春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56833,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临安胜览 其一","author":"胡奎","text":"临安老父鬓如丝，解说钱王纳土时。\n吴越江山留胜概，只今惟有表忠碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56834,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临安胜览 其二","author":"胡奎","text":"钱王射潮潮倒流，尚遗铁箭在江头。\n人言此箭不可拔，永镇东南第一州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56835,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临安胜览 其三","author":"胡奎","text":"六飞南渡大江来，五月荷花水殿开。\n白塔已荒前代寺，紫云犹绕拜郊台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56836,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临安胜览 其四","author":"胡奎","text":"葛岭苍苍横暮云，旁人指点岳王坟。\n看取坟前向东树，也知生死不忘君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56837,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临安胜览 其五","author":"胡奎","text":"月殿云窗倚碧霄，江声雷动海鲜桥。\n如何敌骑屯营处，三日钱塘不见潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56838,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临安胜览 其六","author":"胡奎","text":"南山北山云气浮，东涧西涧水交流。\n灵鹫飞来天竺夜，白猿啼老洞门秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56839,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临安胜览 其七","author":"胡奎","text":"风篁岭前烟翠深，水乐洞中韶濩音。\n分明一曲无弦调，洗尽人间万古心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56840,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临安胜览 其八","author":"胡奎","text":"凤凰池中十万家，莺声燕语度年华。\n笙歌夜月家家酒，罗绮春风处处花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56841,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临安胜览 其九","author":"胡奎","text":"红泥亭子赤栏桥，二八女儿眉黛娇。\n手折荷花盖头去，瓜皮船不怕风潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56842,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临安胜览 其十","author":"胡奎","text":"八月十八看潮生，中有吴儿踏浪行。\n青盖红旗誇涉险，泰山一掷羽毛轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56843,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临安胜览 其十一","author":"胡奎","text":"黄雾涨天红日高，千门万户竞锥刀。\n当垆少妇劝郎酒，自按琵琶金凤槽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56844,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临安胜览 其十二","author":"胡奎","text":"元唱白酬诗兴豪，吴山更比越山高。\n无端月落潮平夜，相送玲珑别意劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56845,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临安胜览 其十三","author":"胡奎","text":"湖上采莲谁氏女，南风吹起棹歌声。\n劝郎莫向外湖去，外湖水浊里湖清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56846,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临安胜览 其十四","author":"胡奎","text":"小雨疏疏不作泥，流莺声满绿杨堤。\n少年莫打黄金弹，留取慈乌在上啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56847,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临安胜览 其十五","author":"胡奎","text":"苏小门前油壁车，玉泉池上金鲤鱼。\n车能载酒鱼可鲙，人生不乐将何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56848,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临安胜览 其十六","author":"胡奎","text":"坡翁通守临安后，又复能来绾郡符。\n一段风流付晴雨，直将西子比西湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56849,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临安胜览 其十七","author":"胡奎","text":"最忆孤山处士家，水边林下见横斜。\n天寒万木俱摇落，铁石心肠是此花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56850,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清晖轩","author":"胡奎","text":"罨画溪头秋水肥，倚阑日日看清晖。\n藕花菱叶当窗见，鸂鶒鸳鸯作队飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56851,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽僧 其一","author":"胡奎","text":"盐官国师古道场，犀扇无人再举扬。\n留得旧时公案在，只今拈起话头长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56852,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽僧 其二","author":"胡奎","text":"犀牛扇子久尘埃，扇破牛儿不见来。\n凭仗禅林玉麈尾，宗风重振雨华台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56853,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次复柬先生纪行之什二十首 其一 淳化","author":"胡奎","text":"金城百雉护重关，历尽千山与万山。\n见说沈郎天上去，一车行李赐金还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56854,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次复柬先生纪行之什二十首 其二 陈坟","author":"胡奎","text":"前朝孤冢已多年，望帝何心托杜鹃。\n石马长嘶风雨夜，松花如雪满山田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56855,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次复柬先生纪行之什二十首 其三 句容","author":"胡奎","text":"落照明边紫翠重，停车松下坐从容。\n何由借得瀛洲鹤，飞上茅君大小峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56856,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次复柬先生纪行之什二十首 其四 土桥","author":"胡奎","text":"四月风生白苧衣，河豚吹浪荻芽肥。\n白鸥自信閒于我，来往都忘海上机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56857,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次复柬先生纪行之什二十首 其五 白土","author":"胡奎","text":"荜门圭窦倚斜阳，榆柳阴阴过屋长。\n下马试尝新压酒，楝花风落苧衣凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56858,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次复柬先生纪行之什二十首 其六 丁庄","author":"胡奎","text":"归心有底太悤忙，此地应非五柳庄。\n野馆抱衾谋一宿，水流花谢月苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56859,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次复柬先生纪行之什二十首 其七 徐村","author":"胡奎","text":"此是徐家第几村，千年老树有盘根。\n轮囷不入公输手，樗散长蒙造化恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56860,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]