[{"title":"赠壶山","author":"黄衷","text":"迢迢陆海多才贤，大夫茂绩垂南滇。\n手中黄纸丽圣藻，玉龙三尺开夷天。\n贵山蛮落数十种，家家盗劫如春田。\n椎牛击鼓夜祭鬼，誓死不犯都匀边。\n大夫风力有如许，贵竹之人至今语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56068,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壬午岁除前二日同诸藩长登圆通寺閤和青厓","author":"黄衷","text":"笑拂高冠赋远游，梅花岁晚共蠲忧。\n吏情偶问青莲社，客梦时横白鹭洲。\n凿海更谁纡汉策，登楼何作后荆州。\n春光如锦明朝路，握手寒晖暂尔留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56069,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日宴黔国山亭","author":"黄衷","text":"令转青阳气已浓，上公台榭许从容。\n花光熳射银塘丽，霞彩回联石巘重。\n兴掩歌钟誇算马，笑分篇什记登龙。\n执规谁更司春事，好借晴和遍四封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56070,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金马关别青厓","author":"黄衷","text":"晴和风日正酣春，柳色那堪送远频。\n道古不辞青眼别，路岐谁遣白头新。\n昨宵良晤曾占梦，同省高怀类饮醇。\n旧里莫寻鱼鸟约，升平难负致君身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56071,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈少参入贺","author":"黄衷","text":"斋中高榻曾谁下，郭外征辕许暂攀。\n嵩岳天声欢北极，戎州家庆对南山。\n笑看行李清风际，苦忆心期皎月间。\n春事正深诗转丽，邮筒能为度孱颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56072,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邵佥司","author":"黄衷","text":"短亭行色一囊琴，传食仍挥卖马金。\n芳思便应轻万里，梅花满路打乖吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56073,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蝴蝶花","author":"黄衷","text":"寒露盈盈满道傍，只看浮艳更无香。\n情知不带飞扬性，谩逐东风上下狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56074,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵山亭论别二首 其一","author":"黄衷","text":"引满休辞金屈卮，漫漫天路马鸣时。\n千崖万壑随车雨，涓滴犹堪系去思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56075,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵山亭论别二首 其二","author":"黄衷","text":"几日高堂捧寿卮，野花绣地小春时。\n关山月白豺狼遁，只有巡功副睿思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56076,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早衙即事次韵","author":"黄衷","text":"薇花三对诏南秋，江閤归心付四休。\n明世也知能用短，至人曾道欲行柔。\n青藜旧杖孤窗雨，黄木澄湾独橹舟。\n眼底拥旌何所事，且看晴鹊屋山头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56077,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王教授归隐","author":"黄衷","text":"莫寻幽草赋无媒，曾播苏湖化雨来。\n尘外簪裾还逸客，眼前罗网有遗才。\n苍茫秋色孤舟发，婉转春光一径开。\n老我欲从渝水曲，柳花何处读书台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56078,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送萧兵宪还万安","author":"黄衷","text":"铁肝旧建台中议，豸角还清诏外疆。\n湖海宦情惟晚节，河桥行色有新霜。\n轻纶弄艇凫鸥狎，浊酒持螯橘柚香。\n高隐从前多古思，五云东下见柴桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56079,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵送张愈光落第还永昌","author":"黄衷","text":"南山衣屦晓寒新，归燕词华早动人。\n共道金台须骏骨，未应盐坂有龙身。\n两回那许花凝泪，九炼曾闻药奏神。\n先达如今尽知己，肯教韩愈献书频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56080,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李白夫赴南户部","author":"黄衷","text":"曾于湘水泛秋澄，为爱风流识李膺。\n云际棠阴披剑阁，雨馀山色见钟陵。\n宦情南国今如许，清论东曹素可凭。\n最是仙缘消不尽，春明天阙兴堪乘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56081,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日城北寺登高","author":"黄衷","text":"遐荒九日多幽悰，禅台隐隐临高墉。\n徘徊暂抚莓苔石，突屼已见芙蓉峰。\n兴孤南菊客不饮，心满西庄天未从。\n曲栏矫首动馀感，归鸟尽背黄昏钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56082,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南中忆弟","author":"黄衷","text":"三载相违一见难，止凭归仆话平安。\n西林近日如何遣，南国浮云不耐看。\n抛印未能怜野客，买船谁与赴春官。\n早衰我自寻常在，虾菜无烦念几餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送关给舍赴召","author":"黄衷","text":"滇池三月瘴烟轻，手上归环万里情。\n与世不妨文作业，复官仍得谏为名。\n南烹韩愈初宜味，西赋安仁旧纪行。\n前席倘询幽远俗，一篇王会几时成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄贺永斋卜居","author":"黄衷","text":"芳草街东数十椽，永斋新构小壶天。\n竹间剥琢开枰日，檐外絪缊试茗烟。\n候火稍闻珠似黍，制荷应见藕如船。\n少师绿野长邻近，二疏徒誇汉史前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悠然亭","author":"黄衷","text":"秋花色云佳，金吾足芳苑。\n南山突然来，此兴予不浅。\n渊明千古豪，固节官可免。\n如何青林下，见者一己鲜。\n低首临兹亭，敢谓高道远。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈邓二藩长见投谩尔和答","author":"黄衷","text":"君子不耻独，恒情多尚同。\n忽忽百年内，强半埃尘中。\n鄙儒伏海曲，谈笑谐群公。\n如弦把遗直，要日明愚忠。\n久闻蒉桴响，众乐忽已终。\n所爱社栎枝，不谢追琢攻。\n皓齿渐云豁，苍颐凋故红。\n此志向未渝，此乐浑融融。\n愈老识愈晦，虚心承貌恭。\n低颜就绳检，何以程勤功。\n同列两夫子，肮脏称长雄。\n才方截玉剑，又似吞涧虹。\n款款引固陋，将忘公望崇。\n仰叹不能即，有如失侣鸿。\n赵张协济业，千载随蒿蓬。\n斯道讵能昧，钦矣皤皤翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东嵎文学惠围棋口号当谢","author":"黄衷","text":"浓青润白列星文，谢向康成小阁分。\n尽以斜飞看局面，不知闲着可张军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答东嵎云巢二宪伯七首 其一","author":"黄衷","text":"森罗只道是天文，幽意曾于奕旨分。\n老我静来寻谱帖，几行淩乱散鸦军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答东嵎云巢二宪伯七首 其二","author":"黄衷","text":"月上衙回岸惠文，灯花闲落夜将分。\n王郎野性休翻覆，末着真同背水军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答东嵎云巢二宪伯七首 其三","author":"黄衷","text":"翠烟横竹坐休文，带孔频移减臂分。\n有客肯来开玉局，傍谈犹足当参军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答东嵎云巢二宪伯七首 其四","author":"黄衷","text":"原奕皮生也著文，谁家朱墨谩支分。\n方来温玉还珍重，逸气寻常走魏军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答东嵎云巢二宪伯七首 其五","author":"黄衷","text":"狂爱童儿画纸文，离离关眼暗相分。\n双奁若许当长日，合筑棋坛拜冠军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答东嵎云巢二宪伯七首 其六","author":"黄衷","text":"山人初试御前文，夺角冲关小队分。\n可是边烽无事日，谩将楸局儗行军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答东嵎云巢二宪伯七首 其七","author":"黄衷","text":"莫以论棋比较文，人间豪素敢铢分。\n若为不解欣然意，请看河湟奏凯军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻报有述","author":"黄衷","text":"由来那解务崇深，万里谁传阙下音。\n岂有涓埃裨海岳，止应泉石怨商参。\n关山处处豺狼窟，蓬蔀家家燕雀林。\n经略总看双鬓在，拥旄宁是老予心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56096,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"抚台谢恩书感","author":"黄衷","text":"万马喧喧踏晓霜，群星随月送恩光。\n书生遭际真多幸，圣主抡收亦片长。\n执法旧雄专席选，提封应尽百蛮乡。\n从前细检名贤迹，匡济无如六事章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56097,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南中初雪","author":"黄衷","text":"窗影珍珑乱晓灯，北风初劲正飞腾。\n愁还远戍无衣赋，喜为殊方有岁徵。\n澹彩欲晴犹点缀，寒威渐老更严凝。\n东亭依约梅花发，何必山阴兴可乘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56098,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"院后牡丹和江侍御","author":"黄衷","text":"旋为秾华小筑台，东皇与谢北山莱。\n芳阴转日还当席，幽味迎薰稍近杯。\n世上品流元有谱，眼前根裔岂知才。\n总教难敌阳春咏，文藻翩翩柱史裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56099,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和南园少司徒","author":"黄衷","text":"几见文章多逸气，欲从赤帜委降心。\n季鹰在日情偏放，若水还家岁未侵。\n月下酒杯长吊古，花边衣屦稍宜今。\n永昌山色南中别，谁为沧浪想嗣音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56100,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"移镇","author":"黄衷","text":"遐方裘带照双蓬，已窃华途累至公。\n三楚去天还近远，孤臣惟命亦西东。\n时名若个登楼后，地望偏多赐履中。\n虚浅岂能承沛渥，眼前江汉寸心同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56101,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"院后紫薇四月即花","author":"黄衷","text":"堂后薇花一两丛，晓来迎旭见新红。\n调和岂足三春雨，绰约先誇四月风。\n喜气谩传清似水，衰颜谁信过于翁。\n枝头树底空相惜，送我扬旌几片东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56102,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病起言怀","author":"黄衷","text":"夏气南中寒复暄，客心无计控归猿。\n扁舟欲买鲈鱼港，孤月正照梅花村。\n放鹤未期过下里，对人先拟号东园。\n著书卖卜终多事，何限悠悠可具言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56103,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六月之夕梦素翁过予郭西之居觉识以诗","author":"黄衷","text":"炯炯精神照郭西，海天风露满花溪。\n壶山灵异英贤出，世路承平逸老归。\n谩忆星辰通剑履，却看山月晃荷衣。\n玄机不道无人解，便拟从公赋式微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56104,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江风山月閤和双溪宪长淩溪参伯","author":"黄衷","text":"久客足尘鞅，宜闻郭外期。\n野航纷进楫，江路巧环规。\n幽鸟融春语，长松换劫枝。\n偶然清赏惬，不道但心知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56105,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦雨","author":"黄衷","text":"霖雨秋方积，我行殊未休。\n缁衣明客况，黄潦带边愁。\n鸡骨占难定，龙街市欲收。\n化工翻覆手，何处可销忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56106,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"马龙馆夜坐","author":"黄衷","text":"吏休重院静，万马宿孤城。\n树古风声远，山高夜气清。\n修程看月晕，久坐继松明。\n乡思悠悠地，当关报转更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56107,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病足初愈散步小院命洗竹五首 其一","author":"黄衷","text":"稍过花砖界，愁侵妙月痕。\n呼僮将我斧，吾意在除繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56108,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病足初愈散步小院命洗竹五首 其二","author":"黄衷","text":"应手孤烟落，芳榴露数花。\n小池他夜雨，幸减一枝斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56109,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病足初愈散步小院命洗竹五首 其三","author":"黄衷","text":"虚劲钦孤操，狂丛浪自多。\n讵忧风露损，方寸有萦萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56110,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病足初愈散步小院命洗竹五首 其四","author":"黄衷","text":"老爱风霜饱，将裁紫玉轻。\n江南秋色远，龙笛有新声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56111,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病足初愈散步小院命洗竹五首 其五","author":"黄衷","text":"绿谩芭蕉薄，红嫌月桂新。\n龙材不自惜，何物况孤臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56112,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柏台秋月图","author":"黄衷","text":"秋满千山璧月光，柏台清比玉壶强。\n南乡莫谩看灵彩，行奉重轮照万方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56113,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"发金马关","author":"黄衷","text":"七月边风促晓寒，河桥新霁快征鞍。\n满堤柳色溪蛮语，何处棠阴野老看。\n总谓开诚能化俗，可堪持节更之官。\n山邮供张将箫鼓，为谢南中业已安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56114,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出宣威关","author":"黄衷","text":"秋声先报出关期，小驻荒亭看旧诗。\n只有鬓毛非往日，不妨行李似来时。\n山攒下上群蛮宅，路析东西独客悲。\n茅屋一间诸葛庙，千年禁戒未曾衰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56115,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"软桥坡","author":"黄衷","text":"万曲千盘始渡河，仆人云是软桥坡。\n芬林百卉浓将瘴，饮涧双猱狎且歌。\n听雨却思孤馆静，看山真幸此生多。\n天边亦有王阳道，雾栈云梯奈若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56116,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鸦关","author":"黄衷","text":"峻极青冥鸟迹疏，征舆动处碧云扶。\n敢言老大孤怀减，曾记英雄百战馀。\n永叔庐山堪小赋，谪仙蜀道谩长吁。\n千年圣化浑无外，傍崄何劳仗一夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56117,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"安普道读淩溪子述咎十绝句","author":"黄衷","text":"至宝无横弃，泥涂有良规。\n泥涂不可即，至宝忽在兹。\n别子逾十稔，万里见子词。\n皎皎照我室，微子谁复为。\n念子不能见，涕泪双涟洏。\n关山多鬼蜮，子行仲春时。\n下岂有坎坷，上岂有崄巇。\n卉木已蔚荟，子岂履其危。\n长风羽翎健，朝举夕九维。\n久闻息淮海，何以谢暌离。\n愿言崇令德，岁晏以为期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56118,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山雾","author":"黄衷","text":"广野晨方合，征帷午尚垂。\n千峰愁隐障，万亩快潜滋。\n歊紫占应叶，蒸黄道或衰。\n劳歌增太息，不是瘴乡宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56119,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观稼","author":"黄衷","text":"七月贵阳道，畇畇我稼宜。\n脉潜华始秀，气早穗先垂。\n灭裂行堪戒，污邪旧有辞。\n理人如种树，何处访农师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56120,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"普安馆夜喜雨","author":"黄衷","text":"秋襟荡烦热，夜足普城雨。\n溪黄沛新流，石翠净回乳。\n苗田稗子垂，鹊垒鸠妇处。\n平明有长途，卧听号笛举。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56121,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙里馆牡丹未开戏咏","author":"黄衷","text":"芳苞戢戢日迟迟，绝徼谁移富贵姿。\n倚遍曲栏心自语，看花须看未开时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56122,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"关索庙","author":"黄衷","text":"南征猿鹤草青青，满眼陵丘识所经。\n偶向庙巫询往事，不知时代语英灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56123,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题东田竹冈先陇","author":"黄衷","text":"十里风烟岁欲侵，万家城邑昼阴阴。\n青鸟卜世宁非验，闻道龙材已满林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56124,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏题葵丹向日卷","author":"黄衷","text":"芳根只托冠军家，不信还同草木华。\n最是一枝红似血，有人曾见日中花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56125,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山翁四首 其一","author":"黄衷","text":"采药归来月满溪，家儿能唱白铜鞮。\n山翁有乐无人道，木槿明朝花又齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56126,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山翁四首 其二","author":"黄衷","text":"白发萧萧覆领头，瓦瓶无酒几曾愁。\n人间一醉寻常醒，懒学先生向妇谋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56127,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山翁四首 其三","author":"黄衷","text":"山上常珍紫蕨生，山中幽意白云行。\n等閒孺子休相聒，无那桥边去住情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56128,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山翁四首 其四","author":"黄衷","text":"镇日閒谈遂古初，郡中来问养生书。\n紫芝亦是商山草，此曲高歌我不如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56129,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山雨","author":"黄衷","text":"黑云肤寸眼前生，万壑松涛送雨声。\n蛮语数年刚一见，山中恐是有龙行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56130,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山家","author":"黄衷","text":"袅袅孤烟出远林，更无人语昼阴阴。\n数声缥缈闻难定，莫是仙庞吠白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56131,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠胡方伯","author":"黄衷","text":"鸿渐徵仪羽，龙飞纪甲辰。\n西曹抡法笔，东市少冤民。\n彭蠡冲襟静，匡庐爽气新。\n王风馀制作，卿月近精神。\n素业康侯裕，丛祠叔子伦。\n梅花迎按节，棠树怅移春。\n冬日诚堪负，冰壶讵可亲。\n八闽分控带，左辖盛弥纶。\n只儗开延阁，何须问要津。\n独惭王述老，奔走属车尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56132,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉送蒲川龚先生赴湖南左辖和姚维宁","author":"黄衷","text":"履素频居顺，登良遂陟明。\n直方堪地负，廉约即天成。\n气老元操简，怀虚更敛英。\n魏公真相器，君实足时名。\n京邑因河润，春皋谢木荣。\n人间冬日色，蛮裔古风声。\n乡井连吴会，山川控邓城。\n化行时伪戢，吏散道心清。\n白板馀生聚，红箱减算征。\n崇阶将义报，殊礼以贤旌。\n信节年于迈，勤功夜自程。\n国香迷畹亩，阳鸟渡湘衡。\n璧彩归仍丽，金声扣始铮。\n寓言齐物理，降色察民情。\n剖剧并刀发，摅贞汉水倾。\n总无私可恤，岂有宠能惊。\n鉴彻天潢派，词森武库兵。\n栖迟彭泽令，经济洛阳生。\n菱角新池实，莼丝晚社羹。\n四时如有序，桂棹五湖轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56133,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鸠巢醝台乳白雏二驯扰可玩作瑞鸠歌","author":"黄衷","text":"闽中醝台昼如水，台畔荔丛光薿薿。\n七子巢昏雨脚斜，两片天山雪花起。\n耿耿西沦太白精，寒林弄日试春鸣。\n素鸾且莫妒颜色，舂锄琐细鱼梁横。\n江南书客弁伊骐，晨风吹鬓数茎丝。\n临淮孝子鹄头诏，勿逐金钩变化为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56134,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]