[{"title":"题杂画 其四","author":"史鉴","text":"山云低欲流，山泉绿堪酿。\n高台人不游，麋鹿来亭上。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15589,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题杂画 其五","author":"史鉴","text":"坐石看流水，晚来忘却归。\n鸳鸯见人影，惊起一双飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15590,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"溪月吟答吴一斋 其一","author":"史鉴","text":"君家韭溪上，侬家穆溪头。\n相思不相见，恨随溪水流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15591,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"溪月吟答吴一斋 其二","author":"史鉴","text":"西山一何高，东海一何深。\n惟应天上月，得见两边心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15592,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"即景","author":"史鉴","text":"绿树原头浅草，青山谷口飞花。\n记得南湖良夜，月明曾载琵琶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15593,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题曹颙若扇寄顾东明","author":"史鉴","text":"莺脰湖边旧隐，吴淞江上行舟。\n借问离情何似，春波日夜长流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15594,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晤傅上人","author":"史鉴","text":"宝石山中看雨，冷泉亭上闻猿。\n别后几场春梦，相逢又在祗园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15595,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟中偶成 其三","author":"史鉴","text":"细草绿侵沙岸，野花红点青山。\n短棹自随流去，暮禽相与诗还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15596,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登紫虚阁","author":"史鉴","text":"江树离离江水平，紫虚高阁倚春晴。\n仙人醉坐碧窗下，吹彻洞箫如凤鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15597,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄吴铁峰姻家 其一","author":"史鉴","text":"少相亲爱子相婚，家室咸宜更有孙。\n要与外翁成宅相，莫教空羡魏阳元。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15598,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄吴铁峰姻家 其二","author":"史鉴","text":"头玉峣峣眉目清，认呼应自解人声。\n马迁闻有新编史，异日当成子幼名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15599,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题沈启南画","author":"史鉴","text":"一春风雨未曾晴，入夏湖波与岸平。\n独上江楼听布谷，畬田几处有人耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15600,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅","author":"史鉴","text":"瘦影幽香蝶未知，几番愁绝五更时。\n春寒昨夜新瓶冻，寄语东风为一吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15601,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三顾图","author":"史鉴","text":"炎火无光汉祚微，月明乌鹊又南飞。\n卧龙一起成王业，千古才知帝魏非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15602,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"桃花","author":"史鉴","text":"呼猿洞口暮春时，吟遍桃花一万枝。\n今日独看图画里，茶烟飞绕鬓丝丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15603,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送人游巴蜀","author":"史鉴","text":"雪消巴蜀水初生，此日逢君买棹行。\n钟邓有知烦一吊，降王犹到洛阳城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15604,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题扇","author":"史鉴","text":"雨过青山翠欲流，夕阳明处断虹收。\n扁舟自为寻诗去，不在求鱼下钓钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15605,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题范世良扇","author":"史鉴","text":"江南旧宅已无存，义泽依然在子孙。\n君去岁寒堂上看，长松几个立当门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15606,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"醉题西垛壁","author":"史鉴","text":"西风萧萧吹客衣，黄溪道上行人归。\n一声长笛起天外，白云满山霜叶飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15607,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十二月古中静以扇索诗","author":"史鉴","text":"一夜西风冰塞川，敝裘羸马夕阳天。\n旁人却笑犹持扇，为惜江春入暮年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15608,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题和靖观梅","author":"史鉴","text":"孤山山下断桥边，万树寒香雪后天。\n我亦骑驴来吊古，夕阳荒冢寺门前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15609,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清夜游过陈湖题翁时用扇","author":"史鉴","text":"青山隐隐暮江头，月色随波荡綵舟。\n水鸟双栖忽飞去，一声横笛起中流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15610,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题沈启南松陵别意","author":"史鉴","text":"芙蓉秋水照双旌，冠盖纷纷出送行。\n见画不堪伤往事，冷风和雨过江城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15611,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"初春题败荷鸿雁图","author":"史鉴","text":"霜落风高欲下迟，水田无食苦长饥。\n上林莫道归飞早，今日江南异昔时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15612,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"偶成","author":"史鉴","text":"一年春事已阑珊，天意应于好景悭。\n落尽桃花终日雨，逢人空自说游山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15613,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"木兰花","author":"史鉴","text":"玉色娟娟净不华，莫教零落委泥沙。\n不知刳木为舟日，开过东风几度花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15614,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题澄上人所藏竹","author":"史鉴","text":"渭川千亩影萧萧，苦旱年来叶半凋。\n见画忽然兴远思，行人应在灞陵桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15615,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题扇讽陆廷美","author":"史鉴","text":"大田尘起桔槔鸣，望雨不来无限情。\n借问金陵贵公子，此声何似搊秦筝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15616,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题马抑之画江阁捕鱼图","author":"史鉴","text":"水阁风多酒思凉，仙郎一曲和沧浪。\n祗今正是贤劳日，莫为鲈鱼恋故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15617,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和答吴廷晖 其三","author":"史鉴","text":"莺花长笑主人贫，尽日何曾酒入唇。\n珍贶忽来勾饮兴，野亭还有一分春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15618,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日郊行","author":"史鉴","text":"浪楫风帆不系舟，日斜横笛起中流。\n山青云白江蓠绿，群雁忽鸣声带秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15619,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和汝舍人行敏韵 其一","author":"史鉴","text":"故人今在承明庐，不愧昔年行秘书。\n亲随相臣侍玉陛，肯效学士焚银鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15620,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和汝舍人行敏韵 其二","author":"史鉴","text":"佩玉鸣珰居直庐，黄麻紫诰不停书。\n春来中使传宣入，内苑看花更钓鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15621,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄吴禹畴","author":"史鉴","text":"赐宴曲江归路遥，杏花如锦玉骢骄。\n旁人莫讶不成醉，明日谢恩须早朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15622,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送顾仪宾赴石城王府花烛 其一","author":"史鉴","text":"银河星度月流辉，来傍天孙织锦机。\n不道九霄风露冷，夜深催换紫绡衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15623,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送顾仪宾赴石城王府花烛 其二","author":"史鉴","text":"香车齐向内家迎，一朵宫花下殿行。\n自是和鸣应钟吕，凤仪原不为箫声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15624,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题沈启南画","author":"史鉴","text":"营邱骨冷瘗青山，逸驾遥遥信莫攀。\n近说东阳得三昩，寒林今复见人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15625,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题陈希夷睡图","author":"史鉴","text":"世事纷纷类奕棋，莲花峰下睡多时。\n春风引入华胥国，忘却浮生在乱离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15626,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴鸣翰湖上 其二","author":"史鉴","text":"多时不到南湖上，花落莺啼又一年。\n有约画船同载酒，短篷春雨看鸥眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15627,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和题梅花","author":"史鉴","text":"西湖湖头月满天，骑驴夜踏孤山颠。\n翠禽啼断不成梦，令人苦忆罗浮山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15628,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅花道人钩勒竹","author":"史鉴","text":"协律遗踪世所珍，湖州惟用墨传神。\n沙弥老去耽成癖，笔法真能到古人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15629,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汎下港","author":"史鉴","text":"短棹夷犹去复还，一声渔笛起空湾。\n主人何事催归急，且看湖南日暮山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15630,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"观海云院百丈泉","author":"史鉴","text":"接竹分来知几年，云房长得润枯禅。\n一从学士题诗后，吴下才闻有此泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15631,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿萱","author":"史鉴","text":"花开亲老百忧忘，笑对儿孙引寿觞。\n不信瑶池在天上，蛾眉萧飒也成霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15632,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题沈启南赠尹孟容画","author":"史鉴","text":"天水吴兴两地悬，椷诗遥作买山钱。\n峰峦满纸新题遍，乔木依然在涧边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15633,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题陶文式御史写竹寄衎公","author":"史鉴","text":"忆昔攒眉入社中，归来三径饱清风。\n东篱把酒馀酣在，却写横枝寄远公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15634,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"可闲 其一","author":"史鉴","text":"钩帘把酒对青山，老境无求始是闲。\n请看春波门外水，年光流去几时还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15635,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"可闲 其二","author":"史鉴","text":"自笑欲闲闲未得，却从忙里赋闲诗。\n飞云倦鸟归栖处，此意世人多不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15636,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄保叔修首座","author":"史鉴","text":"红树绿波青黛山，笙歌日在画船间。\n老僧定起浑无事，惟有长松相对閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15637,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和庆云祥公韵","author":"史鉴","text":"窗外栖禽薄暝烟，吴僧相对佛灯前。\n南能化后曹溪竭，何处人间复有禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15638,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"苏堤对酒次沈启南韵 其一","author":"史鉴","text":"湖上采花人未归，苏堤柳色妒春衣。\n踏青儿女歌声亮，惊起鸳鸯各自飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15639,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"苏堤对酒次沈启南韵 其二","author":"史鉴","text":"雨后满湖生翠苕，画船归去水迢迢。\n生憎苏小坟前草，野火曾经几度烧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15640,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游武塘瓶山道院","author":"史鉴","text":"?利当年满世间，弃瓶犹见积成山。\n何人为起楼台住，种得长松待鹤还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15641,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"塞下曲 其二","author":"史鉴","text":"河水东流风北来，孤城画角秋生哀。\n白头边将不知老，弯弓时上单于台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15642,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游冶城山 其一","author":"史鉴","text":"飞龙已废前朝榜，万岁新更此地颜。\n何事游人浑不解，叩门犹问冶城山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15643,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游冶城山 其二","author":"史鉴","text":"东望钟山王气生，祖龙曾此费经营。\n太平天子于今应，赢得秦淮绕凤城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15644,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和三原王司马韵二首 其一","author":"史鉴","text":"封章频上敢怀安，鱼水君臣古亦难。\n优老忽闻明诏下，考槃令咏硕人宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15645,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和三原王司马韵二首 其二","author":"史鉴","text":"临岐重拜大夫勤，望有音尘别后闻。\n四海一家征戍少，太平天子正敷文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15646,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"海盐张方洲太守慰予室燬临行赋赠 其一","author":"史鉴","text":"举目凄然百感侵，败垣残础烧痕深。\n流莺似惜人憔悴，未及花时送好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15647,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"海盐张方洲太守慰予室燬临行赋赠 其二","author":"史鉴","text":"宿草回青柳放芽，东风随物付繁华。\n旧时燕子今何处，已自衔泥过别家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15648,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"海盐张方洲太守慰予室燬临行赋赠 其三","author":"史鉴","text":"催花小雨湿春衣，江海茫茫越鸟飞。\n乐事赏心浑忘却，独将清泪送君归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15649,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖上暮归 其一","author":"史鉴","text":"朗月微明敛夕霏，水禽将宿未惊飞。\n画船去后笙歌歇，贪看湖光缓缓归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15650,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖上暮归 其二","author":"史鉴","text":"鸭禽呼去水云空，香滴蘋花露气浓。\n僧寺茫茫看不见，暮烟生处忽间钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15651,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"葵花","author":"史鉴","text":"黄裳采采露盈盈，清挹华房沆瀣生。\n汉武若先知此味，不教云表立金茎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15652,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鹿葱","author":"史鉴","text":"鹿葱华蘁世同珍，肯谓忘忧别有真。\n大抵人情重传信，辟邪元不是麒麟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15653,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宫词 其一","author":"史鉴","text":"自负婵娟入内家，谁知辇下即天涯。\n子夫不属平阳地，那得君王载后车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15654,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宫词 其二","author":"史鉴","text":"春思恹恹上黛眉，强来庭下立多时。\n红颜不及闲花草，也得东风一度吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15655,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宫词 其三","author":"史鉴","text":"昼永閒来水殿游，芙蓉愁寂似含羞。\n花枝自与春风别，临到开时又一秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15656,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宫词 其四","author":"史鉴","text":"自入深宫无出期，真成薄命底须悲。\n君门一任如天远，终不从人问见时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15657,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"何克廉宅观妓 其一","author":"史鉴","text":"一曲清歌绕画梁，春风吹散舞衣香。\n酒酣却笑苏州守，何事樽前欲断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15658,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"何克廉宅观妓 其二","author":"史鉴","text":"綵云歌罢翠眉低，敛笑凝眸思欲迷。\n春自无情欲归去，落花休怨杜鹃啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15659,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄家书 其一","author":"史鉴","text":"千里迢迢尺素书，几回修得寄双鱼。\n大江南去休迟暮，白发严亲久倚闾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15660,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄家书 其二","author":"史鉴","text":"握手相分更少留，渡江休得有沉浮。\n莫言一纸轻如许，无限乡心与客愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15661,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"见落花 其一","author":"史鉴","text":"野寺春归已惨悽，那堪一夜子规啼。\n东风不道人憔悴，吹入尘途衬马蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15662,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"见落花 其二","author":"史鉴","text":"风吹犹见影离离，留恋低回欲恨谁。\n莫怪来看独惆怅，如今不是故园时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15663,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"分题得震泽竹枝词送中书李舍人 其一","author":"史鉴","text":"洞庭西望水漫漫，浪打船头来往难。\n荷叶作衣蒲作帽，只遮风雨弗遮寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15664,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"分题得震泽竹枝词送中书李舍人 其二","author":"史鉴","text":"野老乘舟自打桡，闲看翡翠戏兰苕。\n连山不断南津口，曲水回通底定桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15665,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"分题得震泽竹枝词送中书李舍人 其三","author":"史鉴","text":"太湖一水跨三州，洞庭两山在上头。\n侬意如山常日静，郎行似水去难留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15666,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"分题得震泽竹枝词送中书李舍人 其四","author":"史鉴","text":"合伴送郎湖水边，柳丝无力系郎船。\n黄蘖作籓篱更苦，淤泥种藕别生莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15667,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"分题得震泽竹枝词送中书李舍人 其五","author":"史鉴","text":"震泽雨晴添水波，郎船将发唱吴歌。\n谁知三万六千顷，不及侬愁一半多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15668,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]