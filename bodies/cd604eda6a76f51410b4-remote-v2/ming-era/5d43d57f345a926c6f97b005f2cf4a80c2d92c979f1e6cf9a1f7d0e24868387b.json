[{"title":"月夜二首 其二","author":"王守仁","text":"处处中秋此月明，不知何处亦群英？\n须怜绝学经千载，莫负男儿过一生。\n影响尚疑朱仲晦，支离羞作郑康成。\n铿然舍瑟春风里，点也虽狂得我情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36233,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜","author":"王守仁","text":"春园花木始菲菲，又是高秋落叶稀。\n天回楼台含气象，月明星斗避光辉。\n閒来心地如空水，静后天机见隐微。\n深院寂寥群动息，独怜鸟鹊绕枝飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36234,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜坐","author":"王守仁","text":"独坐秋庭月色新，乾坤何处更閒人？\n高歌度与清风去，幽意自随流水春。\n千圣本无心外诀，《六经》须拂镜中尘。\n却怜扰扰周公梦，未及惺惺陋巷贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36235,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"心渔歌为钱翁希明别号题","author":"王守仁","text":"有渔者歌曰：「渔不以目惟以心，心不在鱼渔更深。\n北溟之鲸殊小小，一举六鳌未足歆。\n」敢问何如其为渔耶？\n曰：「吾将以斯道为网，良知为纲。\n太和为饵，天地为舫。\n絜之无意，散之无方。\n是谓得无所得，而忘无可忘者矣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36236,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登香炉峰次萝石韵","author":"王守仁","text":"曾从炉鼎蹑天风，下数天南百二峰。\n胜事纵为多病阻，幽怀还与故人同。\n旌旗影动星辰北，鼓角声回沧海东。\n世故茫茫浑未定，且乘溪月放归蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36237,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观从吾登炉峰绝顶戏赠","author":"王守仁","text":"道人不奈登山癖，日暮犹思绝栈云。\n岩底独行窝虎穴，峰头清啸乱猿群。\n清溪月出时寻寺，归棹城隅夜款门。\n可笑中郎无好兴，独留松院坐黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36238,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书扇赠从吾","author":"王守仁","text":"君家只在海西隈，日日寒潮去复回。\n莫遣扁舟成久别，炉峰秋月望君来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36239,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘉靖甲申冬二十一日再登秦望自弘治戊午登后二十七年矣将下适董萝石与二三子来复坐久之暮归同宿云门僧舍","author":"王守仁","text":"初冬风日佳，杖策登崔嵬。\n自予羁宦迹，久与山谷违。\n屈指廿七载，今兹复一来。\n沿溪寻往路，历历皆所怀。\n跻险还屡息，兴在知吾衰。\n薄午际峰顶，旷望未能回。\n良朋亦偶至，归路相徘徊。\n夕阳飞鸟静，群壑风泉哀。\n悠悠观化意，点也可与偕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36240,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中漫兴","author":"王守仁","text":"清晨急雨度林扉，馀滴烟梢尚湿衣。\n雨水霞明桃乱吐，沿溪风暖药初肥。\n物情到底能容懒，世事从前顿觉非。\n自拟春光还自领，好谁歌咏月中归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36241,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽潘南山","author":"王守仁","text":"圣学宫墙亦久荒，如公精力可升堂。\n若为千古经纶手，只作终年著述忙。\n末俗浇漓风益下，平生辛苦意难忘。\n西风一夜山阳笛，吹尽南冈落木霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36242,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和董萝石菜花韵","author":"王守仁","text":"油菜花开满地金，鹁鸠声里又春深。\n闾阎正苦饥民色，畎亩长怀老圃心。\n自有牡丹堪富贵，也从蜂蝶谩追寻。\n年年开落浑閒事，来赏何人共此襟？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36243,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天泉楼夜坐和萝石韵","author":"王守仁","text":"莫厌西楼坐夜深，几人今夕此登临？\n白头未是形容老，赤子依然浑沌心。\n隔水鸣榔闻过棹，映窗残月见疏林。\n看君已得忘言意，不是当年只苦吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36244,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏良知四首示诸生 其一","author":"王守仁","text":"个个人心有仲尼，自将闻见苦遮迷。\n而今指与真头面，只是良知更莫疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36245,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏良知四首示诸生 其二","author":"王守仁","text":"问君何事日憧憧，烦恼场中错用功。\n莫道圣门无口诀，良知两字是参同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36246,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏良知四首示诸生 其三","author":"王守仁","text":"人人自有定盘针，万化根源总在心。\n却笑从前颠倒见，枝枝叶叶外头寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36247,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏良知四首示诸生 其四","author":"王守仁","text":"无声无臭独知时，此是乾坤万有基。\n抛却自家无尽藏，沿门持钵效贫儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36248,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"示诸生三首 其一","author":"王守仁","text":"尔身各各自天真，不用求人更问人。\n但致良知成德业，谩从故纸费精神。\n乾坤是易原非画，心性何形得有尘？\n莫道先生学禅语，此言端的为君陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36249,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"示诸生三首 其二","author":"王守仁","text":"人人有路透长安，坦坦平平一直看。\n尽道圣贤须有秘，翻嫌易简却求难。\n只从孝弟为尧舜，莫把辞章学柳韩。\n不信自家原具足，请君随事反身观。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36250,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"示诸生三首 其三","author":"王守仁","text":"长安有路极分明，何事幽人旷不行？\n遂使蓁茅成间塞，仅教麋鹿自纵横。\n徒闻绝境劳悬想，指与迷途却浪惊。\n冒险甘投蛇虺窟，颠崖堕壑竟亡生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36251,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答人问良知二首 其一","author":"王守仁","text":"良知即是独知时，此知之外更无知。\n谁人不有良知在，知得良知却是谁？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36252,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答人问良知二首 其二","author":"王守仁","text":"知得良知却是谁，自家痛痒自家知。\n若将痛痒从人问，痛痒何须更问为？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36253,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答人问道","author":"王守仁","text":"饥来吃饭倦来眠，只此修行玄更玄。\n说与世人浑不信，却从身外觅神仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36254,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题玉芝庵","author":"王守仁","text":"尘途骏马劳千里，月树鹪鹩足一枝。\n身既了时心亦了，不须多羡碧霞池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36255,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别诸生","author":"王守仁","text":"绵绵圣学已千年，两字良知是口传。\n欲识浑沦无斧凿，须从规矩出方圆。\n不离日用常行内，直造先天未画前。\n握手临歧更可语？\n慇勤莫愧别离筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36256,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"后中秋望月歌","author":"王守仁","text":"一年两度中秋节，两度中秋一样月。\n两度当筵望月人，几人犹在几人别？\n此后望月几中秋，此会中人知在否？\n当筵莫惜慇勤望，我已衰年半白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36257,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书扇示正宪","author":"王守仁","text":"汝自冬春来，颇解学文义。\n吾心岂不喜，顾此枝叶事。\n如树不植根，暂荣终必瘁。\n植根可如何，愿汝且立志。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36258,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送萧子雍宪副之任","author":"王守仁","text":"衰疾悟止足，閒居便静修。\n采芝深谷底，考槃南涧头。\n之子亦早见，枉帆经旧丘。\n幽寻意始结，公期已先遒。\n星途触来暑，拯焚能自由。\n黄鹄一高举，刚风翼难收。\n怀兹恋丘陇，回顾未忘忧。\n往志局千里，岂伊枋榆投。\n哲士营四海，细人聊自谋。\n圣作正思治，吾衰亮何酬。\n所望登才俊，济济扬鸿休。\n隐者嘉肥遁，仕者当谁俦？\n宁无寥寂念，宜急疮痍瘳。\n舍藏应有时，行矣毋淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36259,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋","author":"王守仁","text":"去年中秋阴复晴，今年中秋阴复阴。\n百年好景不多遇，况乃白发相侵寻。\n吾心自有光明月，千古团圆永无缺。\n山河大地拥清辉，赏心何必中秋节。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36260,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘉靖丙戌十二月庚申始得子年已五十有五矣六月静齐二丈昔与先公同举于乡闻之而喜各以诗来贺蔼然世交之谊也次韵为谢二首 其一","author":"王守仁","text":"海鹤精神老益强，晚途诗价重圭璋。\n洗儿惠兆金钱贵，烂目光呈奎井祥。\n何物敢云绳祖武，他年只好共爷长。\n偶逢灯事开汤饼，庭树春风转岁阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36261,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘉靖丙戌十二月庚申始得子年已五十有五矣六月静齐二丈昔与先公同举于乡闻之而喜各以诗来贺蔼然世交之谊也次韵为谢二首 其二","author":"王守仁","text":"自分秋禾后吐芒，敢云琢玉晚圭璋。\n漫凭先德馀家庆，岂是生申降岳祥。\n携抱且堪娱老况，长成或可望书香。\n不辞岁岁临汤饼，还见吾家第几郎？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36262,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日饮月岩新构别王侍禦","author":"王守仁","text":"湖山久系念，块处限形迹。\n遥望一水间，十年靡由即。\n军旅起衰废，驱驰岂遑息。\n前旌道回冈，取捷上畸侧。\n新构郁层椒，石门转深寂。\n是时霜始降，风凄群卉拆。\n壑静响江声，窗虚函海色。\n夕阴下西岑，凉月穿东壁。\n观风此馀情，抚景见高臆。\n匪从群公饯，何因得良觌？\n南徼方如毁，救焚敢辞亟。\n来归幸有期，终遂幽寻癖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36263,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"复过钓台","author":"王守仁","text":"忆昔过钓台，驱驰正军旅。\n十年今始来，复以兵戈起。\n空山烟雾深，往迹如梦里。\n微雨林径滑，肺病双足胝。\n仰瞻台上云，俯濯台下水。\n人生何碌碌？\n高尚当如此。\n疮痍念同胞，至人匪为己。\n过门不遑人，忧劳岂得已。\n滔滔良自伤，果哉末难矣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36264,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"方思道送西峰","author":"王守仁","text":"西峰隐真境，微境临通衢。\n行役空屡屡，过眼被尘迷。\n青林外延望，中閟何由窥？\n方子岩廊器，兼已云霞姿。\n每逢泉石处，必刻棠陵诗。\n兹山秀常玉，之子囊中锥。\n群峰灏秋气，乔木含凉吹。\n此行非佳饯，谁为发幽奇？\n奈何眷清赏，局促牵至期。\n悠悠伤绝学，之子亦如斯。\n为君指周道，直往勿复疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36265,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西安雨中诸生出候因寄德洪汝中并示书院诸生","author":"王守仁","text":"几度西安道，江声暮雨时。\n机关鸥鸟破，踪迹水云疑。\n仗钺非吾事，传经愧尔师。\n天真石泉秀，新有鹿门期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36266,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"德洪汝中方卜书院盛称天真之奇并寄及之","author":"王守仁","text":"不踏天真路，依稀二十年。\n石门深竹径，苍峡泻云泉。\n泮壁环胥海，龟畴见宋田。\n文明原有象，卜筑岂无缘？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36267,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄石潭二绝 其一","author":"王守仁","text":"见说新居止隔山，肩舆晓出暮堪还。\n知公久已藩篱撤，何事深林尚闭关？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36268,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄石潭二绝 其二","author":"王守仁","text":"乘兴相寻涉万山，扁舟亦复及门还。\n莫将身病为心病，可是无关却有关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36269,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长生","author":"王守仁","text":"长生徒有慕，苦乏大药资。\n名山遍探历，悠悠鬓生丝。\n微躯一系念，去道日远而。\n中岁忽有觉，九还乃在兹。\n非炉亦非鼎，何坎复何离。\n本无终始究，宁有死生期？\n彼哉游方士，诡辞反增疑。\n纷然诸老翁，自传困多歧。\n乾坤由我在，安用他求为？\n千圣皆过影，良知乃吾师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36270,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南浦道中","author":"王守仁","text":"南浦重来梦里行，当年锋镝尚心惊。\n旌旗不动山河影，鼓角犹传草木声。\n已喜闾阎多复业，独怜饥馑未宽徵。\n迂疏何有甘棠惠，惭愧香灯父老迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36271,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重登黄土脑","author":"王守仁","text":"一上高原感慨重，千山落木正无穷。\n前途且与停西日，此地曾经拜北风。\n剑气晚横秋色净，兵声寒带暮江雄。\n水南多少流亡屋，尚诉徵求杼轴空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36272,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过新溪驿","author":"王守仁","text":"犹记当年筑此城，广瑶湖寇正纵横。\n人今乐业皆安堵，我亦经过一驻兵。\n香火沿门惭老稚，壶浆远道及从行。\n峰山拿手疲劳甚，且放归农莫送迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36273,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梦中绝句","author":"王守仁","text":"卷甲归来马伏波，早年兵法鬓毛皤。\n云埋铜柱雷轰折，六字题诗尚不磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36274,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒伏波庙二首 其一","author":"王守仁","text":"四十年前梦里诗，此行天定岂人为。\n徂征敢倚风云阵，所过须同时雨师。\n尚喜远人知向望，却惭无术救疮痍。\n从来胜算归廊庙，耻说兵戈定四夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36275,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"破断藤峡","author":"王守仁","text":"绕看干羽格苗夷，忽见风雷起战旗。\n六月徂征非得已，一方流毒已多时。\n迁宾玉石分须早，聊庆云霓怨莫迟。\n嗟尔有司惩既往，好将恩信抚遗黎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36276,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"平八寨","author":"王守仁","text":"见说韩公破此蛮，貔貅十万骑连山。\n而今止用三千卒，遂尔收功一月间。\n岂是人谋能妙算？\n偶逢天助及师还。\n穷搜极讨非长计，须有恩威化梗顽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36277,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南宁二首 其一","author":"王守仁","text":"一驻南宁五月馀，始因送远过僧庐。\n浮屠绝壁经残燹，井灶沿村见废墟。\n抚恤尚惭凋弊后，游观正及省耕初。\n近闻襁负归猺獞，莫陋夷方不可居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36278,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南宁二首 其二","author":"王守仁","text":"劳矣田人莫远迎，疮痍未定犬犹惊。\n燹馀破屋须先缉，雨后荒畲莫废耕。\n归喜逃亡来负襁，贫怜繻绔缀旗旌。\n圣朝恩泽宽如海，甑鲋盆鱼纵尔生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36279,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"往岁破桶冈宗舜祖世麟老宣慰实来督兵今兹思田之役乃随父致仕宣慰明辅来从事目击其父子孙三世皆以忠孝相承相尚也诗以嘉之","author":"王守仁","text":"宣慰彭明辅，忠勤晚益敦。\n归师当五月，冒暑净蛮氛。\n九霄虽已老，报国意犹勤。\n五月冲炎暑，回军立战勋。\n爱尔彭宗舜，少年多战功。\n从亲心已孝，报国意尤忠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36280,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题甘泉居","author":"王守仁","text":"我闻甘泉居，近连菊坡麓。\n十年劳梦思，今来快心目。\n徘徊欲移家，山南尚堪屋。\n渴饮甘泉泉，饥餐菊坡菊。\n行看罗浮去，此心聊复足。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36281,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书泉翁壁","author":"王守仁","text":"我祖死国事，肇禋在增城。\n荒祠幸新复，适来奉初蒸。\n亦有兄弟好，念言思一寻。\n苍苍兼葭色，宛隔环瀛深。\n入门散图史，想见抱膝吟。\n贤郎敬父执，僮仆意相亲。\n病躯不遑宿，留诗慰慇勤。\n落落千百载，人生几知音？\n道通著形迹，期无负初心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36282,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鉴古韵语五十九首 其三十九 玄宗","author":"孙承恩","text":"内难清夷日，当年亦治平。\n开元醒里过，天宝醉中行。\n蜀道风尘地，西宫掩抑情。\n有初终不竟，作戒甚分明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36283,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鉴古韵语五十九首 其四十 肃宗代宗","author":"孙承恩","text":"克复劻勷日，勤劳亦守成。\n权阉播威福，悍后障聪明。\n继世惟姑息，何时见治平。\n酿成藩镇乱，消沮愧王灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36284,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鉴古韵语五十九首 其四十一 德宗","author":"孙承恩","text":"聚敛非王政，偏私岂建中。\n天资伤忌刻，性学欠昭融。\n贤辅终疏斥，奸邪是显庸。\n治平虽有志，才小竟成空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36285,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鉴古韵语五十九首 其四十二 宪宗","author":"孙承恩","text":"法祖追洪烈，勤咨想治平。\n威行藩镇戢，政一纪纲明。\n谋以明能听，功因断乃成。\n远猷虽弗竟，亦不愧中兴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36286,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鉴古韵语五十九首 其四十三 文宗","author":"孙承恩","text":"寡欲心清旷，天资亦厚宽。\n虚襟容直谏，勤政绝游观。\n志为兴衰切，才于拨乱难。\n耻为凡主恨，空使后人叹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36287,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鉴古韵语五十九首 其四十四 宣宗","author":"孙承恩","text":"法赏无偏滥，忧勤有祖风。\n俭能财用节，乐与谠言从。\n一纪馀安靖，群情感大中。\n谁教猜刻胜，远略未恢洪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36288,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鉴古韵语五十九首 其四十五 懿宗僖宗","author":"孙承恩","text":"唐室懿僖日，真为板荡辰。\n普天多寇盗，继世总昏嚚。\n已是垂亡地，犹堪杀谏臣。\n谁云天降罚，酿恶尽由人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36289,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鉴古韵语五十九首 其四十六 宋太祖","author":"孙承恩","text":"仁厚开基异，崇儒圣道尊。\n至诚寓杯酒，心事洞诸门。\n慎狱钦民命，惩奢塞败源。\n身先端化本，彷佛见王言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36290,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鉴古韵语五十九首 其四十七 太宗","author":"孙承恩","text":"罪已消天变，仁民隐至情。\n厚伦施义粟，勤学购遗经。\n节为山林重，功于宦寺轻。\n不惭称令主，恭俭更仁明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36291,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鉴古韵语五十九首 其四十八 真宗","author":"孙承恩","text":"章圣几贤主，咸中亦治时。\n爱民释逋系，听谏纳危辞。\n重道颁经籍，忧蝗罢宴嬉。\n惜哉祥瑞事，白壁见瑕疵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36292,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鉴古韵语五十九首 其四十九 仁宗","author":"孙承恩","text":"仁俭承先业，遐荒仰治平。\n膳因惜费减，物为爱民轻。\n讲学忘炎暑，陈图列御屏。\n黎民怀惠泽，翼世痛昭陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36293,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鉴古韵语五十九首 其五十 英宗","author":"孙承恩","text":"让德终丧日，其如历数归。\n仁心放宫女，孝道协慈闱。\n临政参今古，求言裨缺违。\n史书经统一，千载仰前徽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36294,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鉴古韵语五十九首 其五十一 神宗","author":"孙承恩","text":"一代有为君，齐家更守文。\n游畋元不事，土木总无闻。\n法制熙丰盛，兵戈辽夏勤。\n倾心相安石，国是日纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36295,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]