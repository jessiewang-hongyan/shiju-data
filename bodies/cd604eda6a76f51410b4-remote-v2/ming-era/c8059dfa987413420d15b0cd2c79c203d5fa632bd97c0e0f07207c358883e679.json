[{"title":"舞困图","author":"郭武","text":"内园羯鼓催春风，回环转佩声丁东。\n银笼高坰百枝火，满树梧桐明月中。\n芙蓉舞困霓裳薄，重叠春寒护帘幕。\n伊州初换锦屏空，十二峰头楚云落。\n葡萄消渴樱桃小，一骑红尘报春晓。\n荔枝风味不禁酸，分与窗前雪衣鸟。\n回首渔阳促战鞍，秋风秋雨满秦关。\n谁知按尽梨园谱，都是当时《蜀道难》。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13550,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄刘草窗原博","author":"郭武","text":"空堂独坐叶纷纷，一雁南飞不可闻。\n野色连天迷远望，高城落日乱寒云。\n故人眼底无多在，客思秋来又几分。\n莫怪临风倍惆怅，江乡犹忆白鸥群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13551,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江南怀古","author":"郭武","text":"隔断中原数百年，囊沙堪笑况投鞭。\n桓温不合留王猛，安石终能举谢玄。\n日落暮云斜度鸟，雪消春水远连天。\n子山空有《江南赋》，北府凄凉最可怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13552,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿澧阳","author":"郭武","text":"蘋花风急水茫茫，今夜孤舟宿澧阳。\n谁在江城吹画角，五更残月一天霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13553,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜怀句曲山隐者","author":"郭武","text":"清霜木叶空阶满，静夜钟声独坐闻。\n遥想山中人未宿，自拈香炷礼秋云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13554,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上即事二首 其一","author":"郭武","text":"潮回沙岸渐阔，云净山蜂更高。\n扶杖僧归古寺，抱琴客度危桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13555,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上即事二首 其二","author":"郭武","text":"绿水桥边酒店，白鸥沙上渔家。\n山前山后春雨，江北江南落花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13556,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"留别京师诸友","author":"牟伦","text":"行行策马出皇畿，古木霜寒独鸟飞。\n天上故人青眼在，蜀中诸弟素书稀。\n秋风故陇云连栈，夜月胡笳露满衣。\n白发萧萧身万里，不知别后竟何依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13557,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和逯先生闻砧韵","author":"沐昂","text":"秋高万木脱林坞，与子庭前开绿醑。\n忽闻别院动砧声，西风吹断萧萧雨。\n隔岸人家红树稀，辞巢燕子故飞飞。\n酒酣自起为君舞，正爱凉飙吹我衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13558,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送胡桤轩还永昌","author":"沐昂","text":"有客乘骖过洱西，平原春草正萋萋。\n人烟迢递连金齿，山势逶迤拱碧鸡。\n流水小桥杨柳绿，落花微雨鹧鸪啼。\n遥知别后相思处，云树苍茫梦欲迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13559,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和郊居韵","author":"沐僖","text":"山势青连野，川光白映沙。\n东风遥见草，小雨半开花。\n门送携琴客，桥通卖酒家。\n徜徉游物外，随意乐年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13560,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题所画风雨渔舟图","author":"沐璘","text":"寒云翳层空，冥色生平楚。\n商吹振林峦，惊涛满洲渚。\n渔翁何处归，孤蓑立烟雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13561,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送人","author":"沐璘","text":"花柳正芬芳，天涯去路长。\n陌尘轻作雾，涧草细生香。\n舟楫通巫峡，山河拱建康。\n南游嗟我久，送尔倍思乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13562,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"古意 其一","author":"于谦","text":"妾颜如花命如叶，嫁得良人伤远别。\n别来独自守空闺，夜夜焚香拜明月。\n月缺重圆会有期，人生何得久别离。\n愿将身托蟾蜍影，照见良人不寐时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13563,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"采莲曲","author":"于谦","text":"朝采莲，暮采莲，莲花艳冶莲叶鲜。\n花好容颜不常好，叶似罗裙怨秋早。\n秋风浩荡吹碧波，绿怨红愁将奈何。\n年年采莲逞颜色，采得莲花竟何益。\n莲花虽好却无情，夫婿有情常是客。\n常是客，万里关河归未得。\n争如池上锦鸳鸯，双去双来到头白。\n采莲复采莲，采莲长可怜。\n愿比莲花与莲叶，不论生死根株连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13564,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"落花吟","author":"于谦","text":"昨日花开树头红，今日花落树头空。\n花开花落寻常事，未必皆因一夜风。\n人生为乐须少年，老后看花亦可怜。\n典衣沽酒花前饮，醉扫落花铺地眠。\n风吹花落依芳草，翠点胭脂颜色好。\n韶光有限蝶空忙，岁月无情人自老。\n眼看春尽为花愁，可惜朱颜变白头。\n莫遣花飞江上去，残红易逐水东流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13565,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画二首 其一","author":"于谦","text":"江村昨夜西风起，木叶萧萧堕江水。\n水边蘋蓼正开花，妆点秋容画图里。\n小舟一叶弄沧浪，钓得鲈鱼酒正香。\n醉后狂歌惊宿雁，芦花两岸月苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13566,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋闺","author":"于谦","text":"深闺夜胜年，刀尺如冰冷。\n缝纫不成眠，辘轳响金井。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13567,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"惜春","author":"于谦","text":"无计留春住，从教去复来。\n明年花更好，只是老相催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13568,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春晓","author":"于谦","text":"昼静暖风微，帘垂客到稀。\n画梁双燕子，不敢傍人飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13569,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日登楼","author":"于谦","text":"柳条如翠线，万缕织春愁。\n遮断东风路，无缘入画楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13570,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春小雨","author":"于谦","text":"霏霏小雨不沾衣，细逐斜风密又稀。\n好湿香尘沾柳絮，莫教零乱送春归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13571,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日忆西湖风景","author":"于谦","text":"涌金门外柳如烟，西子湖头水拍天。\n玉腕罗裙双荡桨，鸳鸯飞近采莲船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13572,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟吴侬曲三首 其一","author":"于谦","text":"忆郎直忆到如今，谁料恩深怨亦深。\n刻木为鸡啼不得，元来有口却无心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13573,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟吴侬曲三首 其二","author":"于谦","text":"忆郎忆到骨如柴，夜夜望郎郎不来。\n乍吃黄连心里苦，花椒麻住口难开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13574,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟吴侬曲三首 其三","author":"于谦","text":"侬在西边郎在东，深堂宅院几重重。\n浮麦磨来难见面，厚纸糊窗不漏风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13575,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过徐州回銮处","author":"陈循","text":"偶得回銮处，遥因想翠华。\n彩云飞辇路，象迹印汀沙。\n晓日彭城地，春风杨柳花。\n独惭随使节，重此泛仙槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13576,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"沛县","author":"陈循","text":"汉祖歌风处，荒台宿草迷。\n野云连砀北，溪雨过丰西。\n人自殊方至，书因去客题。\n鸰原千里隔，落笔数行啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13577,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"开平","author":"陈循","text":"滦河河北开平府，云是前朝故上都。\n万瓦当年供避暑，孤城此日事防胡。\n龙冈夜照乌桓月，凤辇时巡敕勒处。\n何区登临最愁寂，李陵台上望平芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13578,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山城月夜自和东行集句韵","author":"陈循","text":"蟾光如水浸清秋，防塞将军在戍楼。\n千里无尘烽火寂，夜深犹起看旄头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13579,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古四十一首 其二十","author":"薛瑄","text":"白云在高丘，绿萝在深谷。\n中有冥栖士，云萝蔽茅屋。\n独抱尚友情，缅遂硕人轴。\n古琴时复弹，古书还更读。\n逍遥无外事，俯仰长自足。\n沮溺耕在野，姜叟钓渭曲。\n伊人岂无心，耻衒荆山玉。\n将须凤来仪，朝阳满梧竹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13580,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古四十一首 其三十九","author":"薛瑄","text":"庭树微飘落，凉气始披拂。\n却忆少年时，泛舟湖湘曲。\n秋风起波澜，寒霜下林麓。\n日出江上枫，雾隐楚岸竹。\n兰芷亦萧条，芰荷不秋馥。\n灵均旧游处，骚思方满目。\n忽忽三十年，凉意复相触。\n《九歌》有遗辞，得意在云谷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13581,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋思二首 其一","author":"薛瑄","text":"秋来何所思？\n所思在远道。\n洞庭木叶霜，楚泽芙蓉老。\n欲济怀方舟，风波殊浩浩。\n寄言双白鹤，尔来苦不早。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13582,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋思二首 其二","author":"薛瑄","text":"登高望沧海，长风欻来过。\n九鳌互低昂，三山郁嵯峨。\n绰约众仙子，飘飘戏其阿。\n手把珊瑚枝，笑拂扶桑柯。\n我欲往从之，道远百怪多。\n安得骑鸿鹄，乘风越洪波。\n举鞭逐蛟蜃，仗剑驱鼋鼍。\n永与众仙会，遨游养天和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13583,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"龙阳山行遇雨","author":"薛瑄","text":"岁晚山行深，山中水重叠。\n丛篁夹溪桥，桥断横槎接。\n阴雨竟连朝，云林黯一色。\n虚风忽冷然，萧萧坠黄叶。\n抚景复何为，内顾远游客。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13584,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泊舟贻溪宿阳楼山下","author":"薛瑄","text":"窈窕入清溪，侧径何纡曲。\n鱼梁截奔流，雪濑漱寒玉。\n空翠湿人衣，雾雨满新竹。\n路穷上野航，前登得平陆。\n日暮烟火迷，似向桃源宿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13585,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"平沙落雁","author":"薛瑄","text":"霜清秋水落，风过人迹平。\n飞飞随阳鸟，相呼下寒汀。\n向夕聚俦侣，月映芦花明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13586,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"烟寺晚钟","author":"薛瑄","text":"夕照下山门，清音出烟雾。\n暝壑一僧还，侧伫寻归路。\n月上楚天宽，露落洞庭树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13587,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"潇湘夜雨","author":"薛瑄","text":"两岸丛篁湿，一夕波浪生。\n孤灯蓬底宿，江雨蓬背鸣。\n南来北往客，同听不同情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13588,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江村暮雪","author":"薛瑄","text":"落落渔樵家，苍苍起烟雾。\n岸滑移钓舟，沙平失归路。\n似有凌波人，盈盈月中去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13589,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渔村落照","author":"薛瑄","text":"钓艇收晚缗，归鸦集疏柳。\n天风吹彩霞，明月映江口。\n孤村一笛横，万虑复何有。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13590,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渡双溪","author":"薛瑄","text":"双溪始合流，崖绪遂经复。\n洄潭一镜平，秋影空寒绿。\n野渡得孤航，山家带乔木。\n适意方自兹，前呵戒僮仆。\n抚景重悠然，谁能和斯曲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13591,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘江舟中","author":"薛瑄","text":"湛湛湘水绿，夹岸丛篁多。\n挽舟逆水上，南风起微波。\n嘉此晴霄景，逍遥玩江沱。\n沙渚旷缅邈，云岫纷嵯峨。\n远目为舒畅，客意将如何。\n濯缨吾所爱，聊为扣舷歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13592,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游君山寺","author":"薛瑄","text":"为爱湖中山，遂寻山下路。\n跻攀转出邃，涧谷亦回互。\n石磴足莓苔，青林杂烟雾。\n前行如有穷，岚岭乍分布。\n招提压重湖，千里周一顾。\n孤峰四无根，形气自依附。\n山僧复导我，窈窕更徐步。\n疏篱野蔓悬，老圃寒泉注。\n径转山房深，重与绝境遇。\n白云檐外生，清风竹间度。\n庭花杂无名，岁晏色犹故。\n澄心得妙观，忘言契良晤。\n爱此林壑清，遂薄尘俗务。\n重来待何时，尚子毕嫁娶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13593,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"洞庭遇雨","author":"薛瑄","text":"孤舟行何迟，岁晚洞庭雨。\n跳波乱明珠，随风扬细缕。\n云雾失君山，波浪连吴楚。\n莫唱斑竹枝，别思满南浦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13594,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过鹿门山","author":"薛瑄","text":"西来汉水浸山根，舟人云此是鹿门。\n峭壁苍苍石色古，曲径杳杳藤萝昏。\n乱峰幽谷不知数，底是庞公栖隐处。\n含情一啸江风清，双橹急摇下滩去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13595,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武口守风四首 其一","author":"薛瑄","text":"连日北风疾，江涛拍岸鸣。\n天垂平野月，浪飐近船灯。\n湖与归心阔，秋因客思清。\n不眠听鼓角，高枕念王程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13596,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武陵晓泛","author":"薛瑄","text":"今朝风日好，来泛武陵溪。\n碧水寒依岸，苍林远护堤。\n沙光摇野鸟，人语散凫鹥。\n二月桃花发，还应处处迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13597,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"荥阳咏古八首 其五","author":"薛瑄","text":"萧萧凉吹动秋空，千古河山一望中。\n广武连营秋草碧，鸿沟分壤夕阳红。\n石麟有甲含苍藓，铁马无声散晓风。\n何限英豪俱泯灭，白云依旧出层峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13598,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"沅州杂诗十二首 其十二","author":"薛瑄","text":"辰沅风壤带三苗，一望乾坤吐纳遥。\n翼轸众星朝北极，岷嶓诸岭导南条。\n天邻巫峡常多雨，江过浔阳始有潮。\n近日诗怀殊浩渺，谩将新句写芭蕉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13599,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"戏题红白二梅花落","author":"薛瑄","text":"檐外双梅树，庭前昨夜风。\n新英兼旧蕊，坠粉间飘红。\n已见苔成锦，方疑色是空。\n妆娥初点额，舞女欲迷踪。\n雨重胭脂湿，泥香瑞雪融。\n不知何处笛，并起一声中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13600,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日出文明门","author":"薛瑄","text":"文明门外柳阴阴，百啭黄鹂送好音。\n行过御沟回望处，凤凰楼阁五云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13601,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新郑学宫夜宿","author":"薛瑄","text":"清飙槭槭响林柯，夜宿秋堂冷簟波。\n睡醒不禁乡思切，满庭明月候虫多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13602,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"巩洛道中","author":"薛瑄","text":"嵩高云气晚嵯峨，清洛西风咽急波。\n水色山光浑似旧，宋家陵墓夕阳多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13603,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"古意","author":"刘球","text":"慧星并圆月，辉映瑶台树。\n丽日隐重云，光天遂成暮。\n室暖兰无香，庭秋桂方蠹。\n长门及翠羽，寂寞无人赋。\n落花虚度春，细草偏承露。\n玉箸空自啼，金莲复谁步。\n凄然感我怀，零泪知何故。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13604,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山居","author":"刘球","text":"水抱孤村远，山通一径斜。\n不知深树里，还住几人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13605,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿道德坛柬白水道人","author":"萧翀","text":"明月不可得，孤灯还近人。\n只缘怀久别，转觉坐相亲。\n露下松坛夜，云归石洞春。\n所欣心迹静，笑语见情真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13606,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉呈子高刘先生","author":"萧翀","text":"剪烛临清夜，开轩对白云。\n眠迟诗共赋，歌罢酒初醺。\n风起松声近，溪回野色分。\n别来愁思满，南雁正纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13607,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"余自流江将归南溪刘先生亦还珠林赋此别伯昂诸友","author":"萧翀","text":"白苎明春雪，清尊注晚霞。\n客行天共远，人醉月初斜。\n武岫神仙宅，珠林处士家。\n东归三十里，好为寄梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13608,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨寒忆舍弟","author":"萧翀","text":"已过清明节，仍余料峭寒。\n风声生树底，雨气满林端。\n堤草青犹短，山花湿未干。\n季方千里隔，谁念客衣单。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13609,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉柬萧子充","author":"萧翀","text":"几年结屋向溪桥，此日飞书肯见招。\n池上看鹅朝洗砚，月中骑凤夜吹箫。\n满林西日迷花树，近水南风乱柳条。\n先与题诗寄离思，青山回首故岧峣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13610,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄吴所与","author":"萧翀","text":"南溪流水北溪云，无限新愁总忆君。\n鸿雁归时天杳杳，鹧鸪啼处雨纷纷。\n郎官湖口江流合，武姥峰头树色分。\n相去只缘三十里，此生何事苦离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13611,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题山水图二首 其一","author":"萧镃","text":"青山何岧峣，下有嘉树林。\n高亭昼闲敞，窗户含层阴。\n前村夜来雨，石濑张素琴。\n好鸟鸣檐间，始知春意深。\n迥无外物累，嘿处抱冲襟。\n对此案上书，悠悠千载心。\n安得谢尘羁，扁舟谐远寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13612,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题山水图二首 其二","author":"萧镃","text":"身已与世违，超然景方寂。\n嘉树敷层阴，芳苔间行迹。\n飞淙如练悬，断厓若天辟。\n亭亭山上云，齿齿溪中石。\n岂无同心人，高谈共晨夕。\n檐虚岚湿衣，窗迥风生席。\n雅趣良足耽，营营竟何益。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13613,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乐隐为尹克俊赋","author":"萧镃","text":"行爱溪中水，坐爱溪上山。\n富贵非所愿，悠然心自闲。\n地偏轮鞅稀，蓬门昼常关。\n清风天外来，入我窗牖间。\n岂无一尊酒，可以销忧颜。\n叶落惊秋徂，鸟啼知春还。\n既忘是与非，宁复虞险艰。\n雅志固如此，高踪可安攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13614,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题九鹭图","author":"萧镃","text":"宣德年间边景昭，彩色翎毛称独步。\n近时林良用水墨，落笔往往皆天趣。\n鸳鸯凫雁清溪流，寒鸦古木长林幽。\n等闲得意即挥洒，一扫万里江南秋。\n此图九鹭真奇绝，散立清烟乍明灭。\n日长坐久看转亲，飘来点点青天雪。\n翱翔霄汉殊不惊，欲下未下浑有情。\n潜踪独趁水边食，延颈忽向芦中鸣。\n吁嗟！\n林生精艺有如此，座客见之谁不喜。\n洞庭湘渚在眼前，暝色惨淡凉飙起。\n方今圣主覃恩波，四海山泽无虞罗。\n悠悠群鹭各自适，虽有鹰鹯奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13615,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]