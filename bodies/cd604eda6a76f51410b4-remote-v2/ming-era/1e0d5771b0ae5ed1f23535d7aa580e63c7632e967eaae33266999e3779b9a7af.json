[{"title":"寄邓升仲作四首 其三","author":"黎邦琛","text":"平生肝胆向谁论，一顾长怀伯乐恩。\n已许此身酬国士，肯将长剑负夷门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32233,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄邓升仲作四首 其四","author":"黎邦琛","text":"卧病山中岁月虚，佳期南浦怅何如。\n水云隔断浔阳路，不寄麻姑二月书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孺朗携酒过明叔山房同赋","author":"黎邦琛","text":"十年琴酒约，此度更相仍。\n病思慵司马，诗情见杜陵。\n竹云苍自落，兰醑碧如澄。\n闻说南楼上，新凉正可乘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕后作","author":"黎邦琛","text":"聚散浮云何太忙，一逢佳节一回肠。\n玉河桥断閒乌鹊，明月台空冷凤凰。\n锦石浪传曾犯斗，机丝虚自忆成章。\n柔情脉脉何人解，独看明星秋籁长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏从化景三首 其一 风门仙迹","author":"黎邦璘","text":"仙媛昔餐霞，依止此山曲。\n不见承鸾踪，空馀春草绿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏从化景三首 其二 五指凌云","author":"黎邦璘","text":"衣冠盛五岭，高山奠南服。\n五指出层云，岧岧翠相簇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32238,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏从化景三首 其三 鼓楼济渡","author":"黎邦璘","text":"孤村临野渡，轻烟罥前渚。\n借问往来人，孰是停桡处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32239,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"方寅所得捷南宫便道省觐月夕过访","author":"徐登","text":"尝怜寂寞故人疏，忽漫过从驷马车。\n月下未倾谋妇酒，此间先到故人庐。\n作霖已自饶商说，献赋曾看荐子虚。\n千里乍回珠水棹，綵衣今见绾银鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32240,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕中送云岳使南都便道省觐","author":"徐登","text":"使者承恩出紫微，南征偏喜近庭闱。\n行经白下花初放，别向都门柳正飞。\n分萼乍辞荆树阁，傍萱应著老莱衣。\n笑看昔日题桥处，争讶相如驷马归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32241,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日集海珠寺","author":"刘克治","text":"古刹何年据上游，扁舟乘兴竟淹留。\n千秋云物悬孤岛，万里乾坤到十洲。\n水怪然犀光见底，天吴如蜃幻为楼。\n酒阑莫漫愁昏黑，明月先来掌上投。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32242,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小金山怀郭景纯参军","author":"刘克治","text":"苍梧云暗九峰疑，砥柱孤高郁水湄。\n南海衣冠谁望气，弘农太守是吾师。\n学仙已尽青囊秘，委运唯应天化随。\n紫翠祇今霄汉远，无劳赋笔拟湘离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32243,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来寺","author":"刘克治","text":"传闻中宿峡，放棹客能来。\n古木丛阴合，悬泉疋练开。\n鸟啼非择树，鱼跃欲衔苔。\n霞薄归猿洞，天清钓鲤台。\n风将列禦至，云拥禺阳回。\n僧上孤亭迥，虹飞万壑豗。\n灵峰标汉外，福地枕林隈。\n洞竹声为律，山花郁映杯。\n芝童频捧药，羽客共扳梅。\n随意从初地，禅栖未拟回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32244,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱明洞歌","author":"刘克治","text":"君不见罗浮三十六洞天，嶙峋直与沧洲连。\n万丈丹梯悬晓日，千年丹灶锁苍烟。\n丹灶丹梯长不改，天真抱朴今尚在。\n金银台中虹正飞，蕊珠峰上芝堪采。\n吾家兄弟颇好奇，振缨希古同襟期。\n一朝投袂事仙赏，结侣逍遥信杖藜。\n扪萝为搜仙人箓，烂柯閒看仙人棋。\n仙人拍手齐调笑，婆娑小按步虚词。\n为爱吾侪骨相好，凤臆燕膺堪入道。\n青鸟白鹤镇相随，玉券丹砂费寻讨。\n石耳灵苗叶暗抽，胡麻青精须一饱。\n长奉囊中餐玉法，笑杀世人空草草。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32245,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗山浮山歌","author":"刘克治","text":"我本高蹈山林客，一生好探神仙宅。\n兹山并挺南斗傍，不意昔遭巨灵擘。\n神人驱之海上来，神物复合终难辟。\n熊咆龙吟山鬼灭，瑶池上界无人迹。\n我欲因之弄山月，倚石迷花坐叹息。\n逸翮迅足羡远游，笙鹤相迎山之侧。\n举身便觉三天近，我名想在丹台籍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32246,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石洞歌访叶化甫先生不值作此寄之","author":"刘克治","text":"丈人昔日栖朱明，静结茅庐倚翠屏。\n丈人今日居石洞，琼树瑶花手自种。\n玉童来授三秀草，素女邀乘九苞凤。\n我来濯缨洗耳池，山灵为我回春姿。\n泉声如沸石欲裂，天地异色云不飞。\n主人不见来何迟，枕石漱流自咏诗。\n洞天福地何萧爽，岁月重来未有期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32247,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水帘洞","author":"刘克治","text":"晨兴骑白鹿，登览水帘洞。\n喷壑瀑布泉，千丈自鸿絧。\n六月长吹霜雪蜚，四时不断风雷动。\n歘若玄岩闪飞电，隐若晴空县螮蝀。\n初讶银河洒碧天，复看珠箔捲苍烟。\n光没云林曳匹练，响韵松风和五弦。\n上有峍屼壁立之巨石，下有萦洄不测之清泉。\n百步九折始能前，但见玄猿啸古木，青鸟群巢珠树颠。\n洗药泉边多羽客，班荆藉卉醉留连。\n龙虎之衣何飘摇，鸾凤之舞何蹁跹。\n遗我流霞觞，饮我瑶池酒。\n左拍麻姑肩，右携玉女手。\n其颜如舜英，相将采尧韭。\n山中玉液复堪餐，吾与汝曹俱不朽。\n借问蜉蝣空楚楚，金石焉知龟鹤寿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32248,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登飞云绝顶","author":"刘克治","text":"我本冥寂士，放情事神仙。\n时餐金鹅蕊，屡览化人篇。\n迅足迢迢凌峻岭，一夜飞度最高顶。\n夜半见日金银台，天鸡咿喔群籁静。\n琴心三叠真箓成，手把芙蓉游太清。\n虎鼓瑟兮螭作驾，霓为衣兮云为軿。\n仙之人兮朝玉京，骑赤色龙上天行。\n愿寄一书谢王母，琼笈请授东方生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32249,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其一 石室龙床","author":"刘克治","text":"五花之树此留踪，刘累何年御玉龙。\n试问骊珠谁已得，云来云去水淙淙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32250,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其二 沥湖渔棹","author":"刘克治","text":"乱藻青榆散沥湖，清歌欸乃酒仍呼。\n渔人亦有观鱼乐，何必风尘叹食无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32251,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其三 虹桥雪浪","author":"刘克治","text":"金银池上赤霞宫，曳佩桥成白玉虹。\n雪浪浮天摇水府，若非螭驾岂能通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32252,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其四 天阁晴岚","author":"刘克治","text":"阑风伏雨扫岚光，天阁珠栊玳瑁梁。\n自是仙官难得到，白云长护翠屏傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32253,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其五 金阙朝阳","author":"刘克治","text":"朱明承夜翼彤云，金阙晴开锦绣文。\n却听步虚声未歇，真人来往动成群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32254,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其六 宝陀夜月","author":"刘克治","text":"玉绳低度紫烟轻，玄兔西冥接若英。\n寺里一僧持半偈，夜分三界响梵声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32255,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其七 星亭拥翠","author":"刘克治","text":"天畔青山白玉楼，何年波上七星浮。\n仙都拟即同君赋，乘兴还能跨玉虬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32256,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其八 霞岛飞琼","author":"刘克治","text":"青山缭绕霞为岛，绿水萦流玉作楹。\n龙骑虹旌云不断，乘风一夜下飞琼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32257,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其九 树德松涛","author":"刘克治","text":"白鹿贞松偃盖高，龙鳞寒色未雕骚。\n不知森疏风飙捲，处处翻江激怒涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32258,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其十 栖云榕荫","author":"刘克治","text":"使者年来石室傍，栽花种柳渐成行。\n角弓此日歌嘉树，勿剪兼同召伯棠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32259,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其十一 紫洞禅房","author":"刘克治","text":"兰若云林一径斜，山僧扶锡具袈裟。\n莲宫入定心宁住，应有如来为献花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32260,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其十二 蓬壶仙径","author":"刘克治","text":"碧坛丹洞路仍通，采药泠然亦御风。\n真箓草成天一笑，群仙冉冉下云中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32261,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其十三 临壑荷香","author":"刘克治","text":"芙蕖灼灼出波新，桂楫雕航沥水滨。\n为问当年曹子建，殊观何似洛川神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32262,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其十四 方塘鱼跃","author":"刘克治","text":"閒观鳞族豢彪池，日晚风回戏碧漪。\n鱼水相忘真乐在，向来庄惠岂能知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32263,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其十五 杯峰浮玉","author":"刘克治","text":"杯峰秀出锦霞侵，一点沿回半欲沉。\n王母西来应税驾，不知何似玉山岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32264,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其十六 天柱流虹","author":"刘克治","text":"嶙峋一柱削孤根，紫雾黄云互吐吞。\n别有长虹留剑彩，遥分星渚划天门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32265,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其十七 仙掌秋风","author":"刘克治","text":"秋色天风万里来，芙蓉千仞郁崔嵬。\n君王傥问金茎事，愿献仙人露一杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32266,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其十八 阆岩夕照","author":"刘克治","text":"平林瑟飒静含风，桂壑松岩夕照中。\n羽客笙歌还此地，暮行群过蕊珠宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32267,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其十九 阿坡泉涌","author":"刘克治","text":"日影泉光一镜天，盘涡群鹭浴娟娟。\n四围山色皆如许，渔子行歌亦水仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32268,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其二十 石洞云封","author":"刘克治","text":"山迥天悬石室高，烟霞洞古锁蓬蒿。\n问津或恐渔郎入，故遣云封不种桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32269,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登崇禧塔","author":"刘克治","text":"宝塔依灵宇，攀跻箭括穿。\n孤标擎日月，绝顶出风烟。\n树没嵩台迥，山连石室偏。\n法云银草净，慧雨玉毫悬。\n双树琼帘外，诸天画栋前。\n雨花三界寂，清梵一僧禅。\n目极中华尽，心纡象教缘。\n愿承功德水，金筏度迷川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32270,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高要李簿招陈浔州七星岩宴集","author":"刘克治","text":"沥湖绀殿锁虚空，山拔蓬莱有路通。\n白玉仙床依洞口，黄金秘简出云中。\n孤峰临水元浮影，锦石侵霞更上红。\n把酒与君聊骋望，泠然真欲御长风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32271,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"叶化甫修端州志寓桂林余偕李惟实访之值郑使君招饮舟中","author":"刘克治","text":"江清沙白自孤村，寂寞蓬蒿仲蔚园。\n吕氏故烦千里驾，马迁新著一家言。\n狂风岸坼鼋鼍涌，斜日林开鹳雀喧。\n独把干星龙是剑，双看载酒鹿随轩。\n短箫横笛悲雕舸，对弈探钩命绿尊。\n似盖片云来断壁，如龙五龙走平原。\n讴声绕席高还下，霞气冲杯冷复温。\n昏黑最怜分手地，山烟岩月啸清猿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32272,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潘君理古琴予重而赋此","author":"刘克治","text":"孤桐千世后，犹出峄阳传。\n莫是留清角，何如对响泉。\n月明中散曲，风淡伯牙弦。\n岂但馀书卷，无非手泽年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32273,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古梅洞","author":"刘克治","text":"索笑寒梅下，花开洞更幽。\n湖烟晴似染，山翠漭俱流。\n药许芝童采，岩宜木客留。\n游仙聊小睡，清梦到罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32274,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"迟叶太史不至先入武夷","author":"刘克治","text":"子骞曾此宴峰头，风御虹桥是胜游。\n天际吹笙攀白鹤，关前望气失青牛。\n千秋福地仙灵蜕，九曲真源太乙舟。\n司马一家言已就，可能无意向丹丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32275,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"守岁明府舅懋节福清署中赋赠","author":"刘克治","text":"岁色孤城忽夕钟，赋诗行酒未从容。\n桃花红胜河阳县，棠树高于石竺峰。\n三异君应频鹗荐，一经予自笑龙钟。\n诘朝太史如张网，遥见双凫入九重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32276,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夜曲","author":"刘克治","text":"百轮灯里七香车，大道红楼斗丽华。\n落尽越王台上月，不知春色在谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32277,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"前面笔峰","author":"王大谟","text":"嶂南参列突奇峰，对待由来奠化工。\n虹见却疑丹管架，雾飞偏似墨花溶。\n连翩云影联花鸟，错落星辉挂烛栊。\n倍信两仪多间气，三眉仿佛画图中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32278,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"后枕玉屏","author":"王大谟","text":"千亿年前原地设，宁城创造自天成。\n金鳌特起悬入顶，玉叠飞来镇玉屏。\n恬目山天烟带雨，开襟□□锦拖旌。\n乾坤橐钥钟灵脉，世代人民聚德星。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32279,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"左辅文德","author":"王大谟","text":"天地何心分布置，龙蟠文水耸文踪。\n护屏端拱舒长揖，缩嶂将来敛逊容。\n势接崔巍征德厚，望回华表挹文崇。\n古云人杰完光岳，参运弘开跨粤东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32280,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"右弼武功","author":"王大谟","text":"舆志称雄推广武，武功虎踞右西宁。\n日含叠嶂披鳞甲，风鼓乔林振哨铃。\n列戟峰前归操纵，投鞭泉下任调停。\n兵威赖有山陵赫，指日淩烟勒碑铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32281,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题县八景 其一 金鸡春晓","author":"张士猷","text":"雄峙仰金鸡，春来锦翠齐。\n一声千户晓，四顾万山低。\n日丽花争媚，风和鸟自啼。\n绿阴常不减，添得几黄鹂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32282,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题县八景 其二 仓冈夕照","author":"张士猷","text":"仓冈日云夕，极目正黄昏。\n乱噪鸦千点，微生月一痕。\n回光翻石壁，返照入山村。\n眺望因思古，挥戈战广原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32283,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题县八景 其三 江头渔聚","author":"张士猷","text":"渔父归来晚，江头聚钓船。\n风波千丈雨，桑柘一村烟。\n明月宜沽酒，鲈鱼颇值钱。\n醉眠春梦醒，坐看水沤圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32284,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题县八景 其四 谷口樵归","author":"张士猷","text":"樵径通幽谷，云深鸟迹稀。\n朝寻烟径去，暮逐夕阳归。\n互答行歌乐，谁怜托业微。\n莫愁山雾黑，孤月满荆扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32285,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题县八景 其五 贞山雨霁","author":"张士猷","text":"云收天欲霁，山色倍增鲜。\n万壑迎初日，千峰扫淡烟。\n龙池深雨后，凤竹耸天边。\n两腋清风起，翩翩我亦仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32286,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题县八景 其六 洲渚流芳","author":"张士猷","text":"沙岸分洲渚，清溪浸绿芜。\n有时翻鹭羽，深处浴鸳雏。\n细雨流芳芷，春风长嫩蒲。\n閒情谁会得，天外集双凫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32287,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题县八景 其七 丘林梅月","author":"张士猷","text":"独爱梅林月，枝头挂夕晖。\n香魂如有约，皓魄意忘归。\n疏影横斜浅，寒光掩映微。\n折来无可赠，天上古人稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32288,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题县八景 其八 柑榄松风","author":"张士猷","text":"秀挺干霄木，清阴覆石坛。\n翠摇风力劲，香湿露华漙。\n倦鹤栖枝稳，凌霜耐岁寒。\n栋梁应许尔，何事尚泥蟠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32289,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题县八景 其一 金鸡春晓","author":"梁养正","text":"金鸡振晓声，奋翮千仞上。\n华堂春满时，佳景孰来访。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32290,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题县八景 其二 仓冈夕照","author":"梁养正","text":"开明耀永昼，返照冈之麓。\n羡君桑榆功，芳名入奏牍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32291,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题县八景 其三 江头渔聚","author":"梁养正","text":"鳞鳞满江头，往来轻一叶。\n不用杞人忧，壮怀方击楫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32292,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题县八景 其四 谷口樵归","author":"梁养正","text":"谷口路应赊，前山已夕照。\n樵夫咏而归，风吹入别调。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32293,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题县八景 其五 贞山两霁","author":"梁养正","text":"雨过山色增，有如濯青泚。\n仙心足比洁，俗尘为我洗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32294,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吊热水吴节妇","author":"郑奎光","text":"予读柏舟诗，遥遥慕芳轨。\n两髦实我仪，靡他矢之死。\n不谓千馀年，闻风有麦氏。\n麦氏村家姑，羞与村姑伍。\n十六归延陵，茹荼不言苦。\n拟学双鸾飞，忽作孤鸾舞。\n一醮义不忘，妾命轻如土。\n母也不谅人，烦言益酸楚。\n母谓妾无儿，怀中抱孤女。\n母谓妾无田，衣食在机杼。\n妾心一片铁，不入红炉灭。\n妾心万钧石，不触洪波裂。\n发何剪兮元可截，妾心白兮不可涅。\n柴门寂寞草芊芊，冷落风霜六十年。\n六十年中无笑面，此日开颜见所天。\n潭流山下水悠悠，潭流山上多松楸。\n松楸不彫水不竭，清风万古留荒丘。\n吁嗟妇人谁似麦，心如冰兮肌如雪。\n至今热永村边水，流到墓前不敢热。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32295,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吊歇马梁烈女","author":"郑奎光","text":"古云烈士难，难与烈女比。\n借问烈女谁，歇马梁之子。\n烈女生来诗书族，蕙质兰心气芳淑。\n深闺待字十七年，素袂天然厌罗縠。\n一朝寇贼汹汹至，欲避不能心如刺。\n身可虏兮不可污，妾命如毛忍捐弃。\n骂贼贼怒刀乱下，血肉成糜骂益厉。\n英风凛凛英名高，日月惨淡鬼神号。\n歇马渡头青草墓，至今人说女中豪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32296,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]