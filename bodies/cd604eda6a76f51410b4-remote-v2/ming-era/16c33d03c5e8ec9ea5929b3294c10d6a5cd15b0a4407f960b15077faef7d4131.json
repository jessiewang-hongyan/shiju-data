4d192fe5294295f79689","path":"明_1.csv","pointer":40731,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"草虫二咏 其二 秋虫残蝶","author":"倪谦","text":"清秋趯趯草虫鸣，残蝶犹翻粉拍轻。\n促织不知缘底事，微躯时起触蛮争。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40732,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"牧牛图 其一","author":"倪谦","text":"怪雨盲风撼柳梢，便骑老牸返前郊。\n任将破笠轻掀去，莫捲江村屋上茆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40733,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"牧牛图 其二","author":"倪谦","text":"弄雏牧竖倚陂陀，閒纵芳村绿草多。\n残喘只今谁复问，古槐阴处痒频摩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40734,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题刻丝莲花水草","author":"倪谦","text":"渚花交映玉芙蓉，綵缕妆成锦一丛。\n自是天孙机上手，当年刻楮未为工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40735,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题枯木竹石","author":"倪谦","text":"天上曾乘泛斗槎，归来閒置海东涯。\n波涛洗出金鳌背，叶叶琅玕拥翠华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40736,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨竹","author":"倪谦","text":"九疑清梦隔烟螺，湘水悠悠别思多。\n满眼翠华秋色晚，倚风谁唱竹枝歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40737,"sha256":"0e5ded5