[{"title":"赋得御沟秋水","author":"邓云霄","text":"御沟两岸夹残莎，愁听啼螀泣露多。\n先帝宫中人去尽，秋来红叶尚随波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26048,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬雨","author":"邓云霄","text":"经旬斜雨滴长廊，冬暖苔生草又芳。\n谁剪钟山云一片？\n随风入户到绳床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26049,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凉州词二首 其一","author":"邓云霄","text":"城高楼角近旄头，边月胡风早送秋。\n不信凉州多猛将，还听稚子说封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26050,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凉州词二首 其二","author":"邓云霄","text":"生来眠食在雕鞍，霜入弓刀不觉寒。\n岂畏胡儿频挑战，却嗔烽火报平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26051,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题会仙图","author":"邓云霄","text":"洞天剑舄踏红云，流水桃花几度春。\n昨检金函谪仙籍，始知身是会中人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26052,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"衙署对燕","author":"邓云霄","text":"斜立空梁对语频，两年衙舍不嫌贫。\n多情共恨秋风早，来岁春归换主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26053,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苏李泣别图","author":"邓云霄","text":"节旄落尽始南归，降虏何人尚把衣？\n昔日河梁还忆否？\n胡风汉月两分飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26054,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"一笑","author":"邓云霄","text":"束装归去卷残书，衙署将辞尚扫除。\n静对老妻聊一笑，不知天地本蘧庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26055,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"尝樱桃有感","author":"邓云霄","text":"近市樱桃买不难，红珠嚼碎瓠犀寒。\n东风昨送长安梦，中使亲看赐从官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26056,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"会仙桥","author":"邓云霄","text":"桥跨虹腰紫翠重，群仙冉冉踏芙蓉。\n周王八骏还难到，鞭石何须笑祖龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26057,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水帘洞","author":"邓云霄","text":"水晶宫里罢仙妆，珠箔斜褰漱玉浆。\n坐处不知环佩湿，吹来犹觉雨花香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26058,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来船","author":"邓云霄","text":"银潢空阔水潺潺，破浪乘风几日还。\n好向莲花招太乙，不须更过石帆山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26059,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"圣灯岩","author":"邓云霄","text":"层岩遥放白毫光，半夜南离焰倍长。\n照落妖星留宝月，大千何处是迷方？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26060,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"流杯池","author":"邓云霄","text":"灵泉九转羽觞浮，坐石攀花作酒筹。\n莫遣花飞随水去，恐惊渔子更移舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26061,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朝旸台","author":"邓云霄","text":"三更老衲卧禅床，静笑羲和太着忙。\n尘世劳劳何日息？\n吾将散发到扶桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26062,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郴阳署中","author":"邓云霄","text":"一片孤城罩紫烟，松阴桂影戟门前。\n散衙日永浑无事，静坐焚香候九仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26063,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜闻笛","author":"邓云霄","text":"天空凉月渡河清，谁倩西风送笛声？\n正是新鸿欲回处，何须朗调更相惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26064,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"欲贻京贵书一笑掷笔","author":"邓云霄","text":"西北红云望帝京，旧游裘马尽飞缨。\n传书欲问看花伴，谁是当年管鲍情？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26065,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕雨癸丑郴州","author":"邓云霄","text":"檐声钟漏两沉沉，花月无情旅思深。\n试向山城听片雨，不知春夜值千金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26066,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"坐东斋","author":"邓云霄","text":"从来劳逸有循环，三载求閒竟得閒。\n地僻自无门外事，官贫长看坐中山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26067,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酒熟","author":"邓云霄","text":"酿熟松花满瓮香，珍珠滴沥落糟床。\n醉乡别有閒天地，不管人间岁月忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26068,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苦雨作","author":"邓云霄","text":"山城四塞响奔雷，小院残花满绿苔。\n冷节已过还听雨，冰心一片似寒灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26069,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对雨惜花","author":"邓云霄","text":"寂寞花神立浅苔，残妆垂泪湿红腮。\n湘江正恨流春去，水鹳何须唤雨来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26070,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜坐二首 其一","author":"邓云霄","text":"吏散重门锁晚春，含清阁里一閒人。\n下看城郭沉沉静，只有疏星作四邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26071,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜坐二首 其二","author":"邓云霄","text":"半似幽人半似仙，篆烟飞去白云连。\n瑶琴奏罢冰弦冷，更理逍遥第一篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26072,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"塞上曲二首 其一","author":"邓云霄","text":"昨夜天书下紫宸，赐衣分散玉门春。\n破胡只用飞三箭，绝幕休教放只轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26073,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"塞上曲二首 其二","author":"邓云霄","text":"走马追锋直到天，回看北斗落南边。\n阴山万里胡尘净，只有烧荒一片烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26074,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观山","author":"邓云霄","text":"山城四面列芙蓉，翠壁丹崖几万重。\n永日开帘看不尽，夏云如黛更添峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26075,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"城上闻笛","author":"邓云霄","text":"谁临睥睨倚江濆，玉笛声声夜叫云。\n枫树啼猿风正急，莫将哀怨动湘君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26076,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶成","author":"邓云霄","text":"无思无虑任流年，深院深秋欲暮天。\n扫地焚香工课了，竹窗听雨竹床眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"叹菊","author":"邓云霄","text":"剪玉铺金共一丛，竹篱寥落傲霜风。\n故山三径烟萝冷，叹息馀香入梦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋同许顺叔袁兰室潇水泛舟五首 其一","author":"邓云霄","text":"斋阁焚香事事幽，非缘出郭憺忘忧。\n乘舟载酒吾何意，为爱清江似鸭头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋同许顺叔袁兰室潇水泛舟五首 其二","author":"邓云霄","text":"冥蒙烟水画船移，枫叶芙蓉夹岸披。\n天送轻风徐进酒，更飞微雨急催诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋同许顺叔袁兰室潇水泛舟五首 其三","author":"邓云霄","text":"湖南冬日自喧和，锦石银砂漾碧波。\n不用舟中携乐部，芦花深处有渔歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋同许顺叔袁兰室潇水泛舟五首 其四","author":"邓云霄","text":"倚棹悬崖坐画图，晚来烟雨幻虚无。\n旧游同是姑苏客，笑指潇湘话太湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋同许顺叔袁兰室潇水泛舟五首 其五","author":"邓云霄","text":"短篷冲雨醉江烟，往事还思十载前。\n莫道知音同雅调，细听流水亦鸣弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渔父词","author":"邓云霄","text":"沽酒烹鱼倚晚汀，短篷听雨醉还醒。\n閒舒老脚和云卧，未许旁人拟客星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荡子从军词三首 其一","author":"邓云霄","text":"骝马连钱映锦袍，平生气压五陵豪。\n探丸未了封侯事，直取单于血衅刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荡子从军词三首 其二","author":"邓云霄","text":"金钗十二列蛾眉，临别牵衣控玉羁。\n越女吴姬都选遍，更将佳丽觅燕支。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荡子从军词三首 其三","author":"邓云霄","text":"美如冠玉似陈平，斗罢鸡场塞外行。\n百战功勋酬圣主，十年贫苦笑书生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小除日大雨雪","author":"邓云霄","text":"谁散天花乱打窗，高斋风味宛禅房。\n问君诗骨清如许，扫雪烹茶坐竹床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜听滴酒声","author":"邓云霄","text":"小槽滴滴搅閒眠，得似秋山夜听泉。\n潦倒不知身外事，拍浮长伴酒中仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹枝词四首 其一","author":"邓云霄","text":"峡口维舟月落时，黄陵苦竹宿羁雌。\n西风一夜吹归梦，霜满篷窗客未知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹枝词四首 其二","author":"邓云霄","text":"汉江对岸夹青楼，蜀客连樯溯上流。\n借汝一条龙竹杖，轻风半夜到夔州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹枝词四首 其三","author":"邓云霄","text":"黄牛白马上艰辛，崖下盘涡泡里身。\n齐唱竹枝牵百丈，烧钱浇酒赛江神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹枝词四首 其四","author":"邓云霄","text":"三年怨妇望廊归，买卜频停织锦机。\n谁料行人阻风水，巫山夜雨正沽衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮倚阁二首 其一","author":"邓云霄","text":"莫向他乡叹岁华，小僮初进九疑茶。\n凭栏坐对江流笑，最爱鸳鸯摘浪花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮倚阁二首 其二","author":"邓云霄","text":"痛饮狂歌颇自雄，醉乡深入宦情慵。\n俸钱归去供春酿，更买云边第一峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨柳枝词三首 其一","author":"邓云霄","text":"媚眼正窥春色好，舞腰无奈暖风多。\n莫教攀折赠行客，爱尔轻丝拂玉珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨柳枝词三首 其二","author":"邓云霄","text":"万缕千丝绕大堤，寻春衣马望中迷。\n清阴不独摇春酒，留与娇莺自在啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨柳枝词三首 其三","author":"邓云霄","text":"百花开处明如锦，雨打风飘色乍消。\n谁似青青堤畔柳？\n轻盈长学楚宫腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和贫妇吟十首 其一 睡起","author":"邓云霄","text":"牛衣夜冷忆鸳衿，起视西窗月未沉。\n行傍疏篱摘黄菊，倩他持作辟寒金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和贫妇吟十首 其二 临镜","author":"邓云霄","text":"谁道愁容怯镜光？\n菱花还妒柳眉长。\n凄凉尘匣无脂粉，自点寒梅学淡妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和贫妇吟十首 其三 晨炊","author":"邓云霄","text":"采掇雕胡荐野蒲，贫居香积是僧厨。\n兰肴玉馔侯门事，可比侬家米似珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和贫妇吟十首 其四 倦绣","author":"邓云霄","text":"好鸟啼阑蝶倦飞，绣床閒倚背斜晖。\n金针自有鸳鸯谱，懒为他人作嫁衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26102,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和贫妇吟十首 其五 午憩","author":"邓云霄","text":"无酒无花送晚春，绳床竹簟午相亲。\n妾身倦似三眠柳，无奈薰风又醉人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26103,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和贫妇吟十首 其六 浇花","author":"邓云霄","text":"乞得琼枝自隔邻，閒将清水濯花神。\n孤芳何必输金谷，处处东风一样春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和贫妇吟十首 其七 对月","author":"邓云霄","text":"夜夜婵娟只独看，天涯破镜望征鞍。\n秋声先送蓬门冷，疑挟飞仙到广寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和贫妇吟十首 其八 展枕","author":"邓云霄","text":"边塞鸿稀信息迟，空留角枕号相思。\n风穿四壁吹寒雨，远忆阴山夜雪时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和贫妇吟十首 其九 梦觉","author":"邓云霄","text":"春梦乘风远寄将，巫山云雨过辽阳。\n那堪纸帐蘧蘧后，人在沙场妾在床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和贫妇吟十首 其十 闻鸡","author":"邓云霄","text":"何处鸡声叫晓霜？\n妆成问寝上高堂。\n明朝菽水能供否？\n愿乞仙家辟谷方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题黄又谦年兄渔桹竹浪斋 其一","author":"邓云霄","text":"一叶烟波世外身，桃花流水问通津。\n閒来鼓棹游何处？\n惟访孤山放鹤人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题黄又谦年兄渔桹竹浪斋 其二","author":"邓云霄","text":"日落风轻任所如，明湖缥缈坐空虚。\n垂纶百尺元无饵，意在观鱼不取鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题黄又谦年兄渔桹竹浪斋 其三","author":"邓云霄","text":"竹里流泉万玉鸣，清酣枕石漱泠泠。\n高斋夜夜如寒雨，留得山僧许共听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题黄又谦年兄渔桹竹浪斋 其四","author":"邓云霄","text":"扶疏翠影罩山烟，细浪如鳞绕砌前。\n家近兰亭多胜事，流觞此地亦群贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赞李玉真画雁弹琴二绝 其一","author":"邓云霄","text":"微绡片片度新鸿，影在潇湘远水中。\n休曳残云泼轻墨，还留馀练作霜空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赞李玉真画雁弹琴二绝 其二","author":"邓云霄","text":"曲奏清商玉指轻，紫霞开处月华明。\n知君夜夜求凰好，个里应无别鹤声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花朝","author":"邓云霄","text":"寂寂高斋鹤是宾，花朝已过二分春。\n日西睡起浑无事，始觉閒人即上人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清凉处","author":"邓云霄","text":"閒看鯈鱼啖落红，石池清映绿阴中。\n庭深日永无来客，招得南山几阵风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和懒庵八睡诗夕睡","author":"邓云霄","text":"谁信华胥在小斋？\n人间万事总忘怀。\n閒来展簟看山卧，山气新晴夕更佳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朝睡","author":"邓云霄","text":"纸帐绳床暖活身，三竿日上不知晨。\n遥怜晓月霜华冷，犹有听鸡鞲马人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午睡","author":"邓云霄","text":"燕懒莺慵蜂蝶痴，花阴亭午日迟迟。\n困人天气宜高枕，不用频呼来梦儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醉睡","author":"邓云霄","text":"五十年来谪酒星，垆头瓮侧任沉冥。\n淋淳酣畅予何意，世上于今忌独醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花间睡","author":"邓云霄","text":"花坞平铺六尺床，梦为蝴蝶宿花房。\n蘧蘧自会逍遥理，始悟前身是姓庄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月下睡","author":"邓云霄","text":"澹澹金波拂簟流，飞仙曾到广寒游。\n梦中亲听嫦娥语，玉宇琼楼不奈秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"风前睡","author":"邓云霄","text":"一味南来动绿蘋，北窗高卧上皇人。\n君看小院千竿竹，较胜长安十丈尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨后睡","author":"邓云霄","text":"点点繁华夜寂寥，才侵荷叶又芭蕉。\n道人只作清凉梦，楚寸巫云不待招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己未元夕曲八首 其一","author":"邓云霄","text":"铁锁严城夜不扃，桂宫人亦启云屏。\n仙声不独霓裳曲，环佩珊珊自可听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己未元夕曲八首 其二","author":"邓云霄","text":"春日迟迟夜更长，华星宝月让灯光。\n灯摇酒浪飞鹦鹉，风送箫声引凤凰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]