[{"title":"和秦性初韵二首 其二","author":"曹义","text":"染翰归来兴自赊，吟鞭笑指夕阳斜。\n英英天际云飞处，几度相疑是我家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32601,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和进士胡公智留别字宗愚会稽人任御史终布政","author":"曹义","text":"久别重来到日边，那堪今又买归船。\n人生离会如秋月，几度亏时几度圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32602,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过沛县登歌风台口号一绝戏之十四年","author":"曹义","text":"少年曾诵大风歌，此日登临感慨多。\n千载英雄何处去，空馀碑石对寒波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32603,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋病中口号二绝遣兴 其一","author":"曹义","text":"夜凉碧落绝纤埃，天府谁将宝鉴开。\n素彩迷茫摇桂影，玉波潋滟浸楼台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32604,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋病中口号二绝遣兴 其二","author":"曹义","text":"玉斧仙家巧斲磨，六丁推出涌金波。\n乾坤万里俱涵壁，岁岁无如此夜何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32605,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"口号一首戏呈性初良友","author":"曹义","text":"一年一度进灯诗，才薄多惭圣主知。\n不向同侪争胜负，祗将忠悃荅明时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32606,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得家书口号寄回","author":"曹义","text":"庭闱久别客金台，几度音书远寄来。\n问我归期归未淂，西风须待菊花开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32607,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日病中感怀四绝戏嘲同年诸知己 其一 嘲秦性初","author":"曹义","text":"客窗卧病两旬馀，每叹交游日渐疏。\n独有山阴旧知己，朝回几度到衡庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32608,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日病中感怀四绝戏嘲同年诸知己 其二 嘲彭显仁","author":"曹义","text":"寄语文江彭显仁，年来风采倍精神。\n应知自淂琴书乐，不复留心念故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32609,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日病中感怀四绝戏嘲同年诸知己 其三 嘲陈显良","author":"曹义","text":"晓出长衢踏曙光，归来庭馆又斜阳。\n奔驰日日因何事，秪恐秋添两鬓霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32610,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日病中感怀四绝戏嘲同年诸知己 其四 嘲存礼","author":"曹义","text":"青年文彩最风流，玉署朝趍淂自由。\n退直归来无个事，绿窗相对拓茶瓯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32611,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽山阴王主事贤母","author":"曹义","text":"淑质清兮两鬓星，高堂正拟享遐龄。\n如何一枕游仙梦，长夜漫漫竟不醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32612,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱德和就步士初之韵","author":"曹义","text":"紫泥还拟九天来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32613,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日睡起漫兴","author":"曹义","text":"瓦枕藤床醉梦醒，竹窗幽户午阴清。\n隔林好鸟如相约，时复来啼三两声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32614,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"墨梅","author":"曹义","text":"忆昔孤山雪后时，鲜鲜缟袂绝尘缁。\n别来何事姿容老，想过羲之洗砚池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32615,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"红梅为孙瓒题","author":"曹义","text":"冰姿曾不染红尘，何事新妆也艳人。\n想是瑶池醉归晚，误随桃杏竞芳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32616,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄同年陈行人因彼人来卖茶问及故云","author":"曹义","text":"昨来试问卖茶人，为说君家是远邻。\n欲折梅花寄相忆，一枝老尽故园春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"红梅","author":"曹义","text":"铁石心肠冰雪肌，一生篱落静相宜。\n多应俗眼嫌清淡，也学桃花逞艳姿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题摺扇小舟似送行者","author":"曹义","text":"一叶扁舟柳市头，几回欲上意绸缪。\n临风唱彻阳关曲，无恨离情逐水流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题幽兰","author":"曹义","text":"露叶含曦迥绝尘，花开岩壑殿芳春。\n书窗读罢清吟处，爱尔幽香自可人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"墨梅","author":"曹义","text":"罗浮春动雪初消，嫩蕊含香色更娇。\n记淂玉堂清咏处，阑干东畔月华饶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独坐感怀悼巳故三兄挥泪成之","author":"曹义","text":"退直归来意独幽，客怀偏动鹡鸰愁。\n忆从暮雨兮飞后，几度相思泪暗流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王公器归乡 其一","author":"曹义","text":"载酒沙头送旧游，春归花柳总含愁。\n新莺也似知人意，啼傍离亭不少休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王公器归乡 其二","author":"曹义","text":"脱却朝衫著布衣，临岐莫遣思依依。\n人生淂意须回首，莫待春深花乱飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题八骏啚","author":"曹义","text":"弄影轻翻碧玉蹄，香尘辇道骋骄嘶。\n想应仙仗看呈罢，卸却金鞍出御堤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f796