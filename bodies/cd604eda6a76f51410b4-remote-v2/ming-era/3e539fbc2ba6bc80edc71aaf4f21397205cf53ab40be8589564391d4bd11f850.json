[{"title":"寄李太亨太守","author":"薛瑄","text":"会面京华两过秋，又从海岱望扬州。\n澄清志操知吾劣，出守声名觉子优。\n华馆定閒徐孺榻，清池谁共李膺舟。\n如何千里音书绝，不信交游是白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5916,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题李廷圭佥宪嵩洛渔樵卷","author":"薛瑄","text":"清门奕世古中州，洛水嵩山总旧游。\n见说斫云开鸟道，还闻溯月泛渔舟。\n自趋紫闼来乌府，望使青云伴白鸥。\n老去披图思往事，几回飞兴到林丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5917,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"松林书舍卷为李方伯题","author":"薛瑄","text":"四檐偃盖碧重重，插架牙签落影中。\n万谷惊涛沧海近，半窗凉月雪山通。\n润沾瑶席霏霏雨，响彻朱弦细细风。\n好结岁寒搜秘检，莫教飞梦逐尘踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5918,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题杨佥宪思亲卷","author":"薛瑄","text":"惆怅高堂罢綵衣，空山回首断云飞。\n梧桐井径秋风老，脩竹园林夕露微。\n紫气天边鸾下疾，白杨陇上鹤归迟。\n柏台有子情何似，厌听庭乌叫落晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5919,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题观风图","author":"薛瑄","text":"九重深诏遣星轺，使者观风郡国遥。\n水逐雕轮随地远，山开锦障拔天高。\n严城树杪门初启，候吏花边马不骄。\n万里咨询皆帝力，生民随处乐耕樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5920,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"高唐道中寄李廷圭佥宪","author":"薛瑄","text":"西来随处问先生，见说分符到博平。\n满路风花频纵目，一川烟柳最关情。\n白头每羡丹心壮，绿鬓谁知素节明。\n高论细听应有日，拟分华榻共春灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5921,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与孙大参韩宪副同按部别后寄此","author":"薛瑄","text":"分符同出济南城，揽辔东风并马行。\n逸兴细看花柳色，高谈深合古今情。\n别来并觉新春暮，到处频看缺月盈。\n绝似当年倾盖者，更期樽酒话平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5922,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄孙韩二公","author":"薛瑄","text":"忆过春风十里亭，二君携酒玉为瓶。\n小桃正吐樽前萼，娇鸟初传户外声。\n如此风光留客饮，几多怀抱向人倾。\n行台此夕忽相忆，谩掩重门惟月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5923,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀李廷圭用前诗末句起韵并书于壁","author":"薛瑄","text":"拟分华榻共春灯，到日先生去博平。\n别鹤行云那有迹，落花飞絮倍多情。\n空怜皓月明朱幌，尚自馀香袅画屏。\n我复东西南北去，壁间留语候归旌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5924,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次寿邓郎中母韵二首 其一","author":"薛瑄","text":"百岁星霜是永年，七闽闺教最称贤。\n自期西日堪留挽，不信南山可变迁。\n白发已看封紫诰，綵衣时复奉华筵。\n故应志节高如许，赢得人间福寿全。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5925,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次寿邓郎中母韵二首 其二","author":"薛瑄","text":"秋霜劲节自年年，谁似清门邓母贤。\n半世成家遭感怆，一生教子见超迁。\n恩随紫诰来华屋，春满红螺泛绣筵。\n青简上头书次第，香名留取古今全。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5926,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏新竹","author":"薛瑄","text":"知是乾坤一气催，满林新笋迸苍苔。\n抽梢渐欲侵云汉，解箨时应傍宪台。\n已觉清风连座起，更摇疏雨到窗来。\n相看尽日添新兴，白笔新诗为尔裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5927,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乐陵道中","author":"薛瑄","text":"乐陵东去古堤长，野水村烟共渺茫。\n远海天空初过雁，大田秋老未经霜。\n铁冠十载心如昨，宪节双持鬓欲苍。\n揽辔悠悠思往事，趋朝曾对御炉香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5928,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"长白山怀古","author":"薛瑄","text":"山回长白重经过，十世怀贤意若何。\n饭粥事空荒古寺，读书声歇暗烟萝。\n中朝德业应难及，西夏勋名更不磨。\n向晚凭谁话忧乐，柏台清夜月明多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5929,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金台送别为李进都指挥赋二首 其一","author":"薛瑄","text":"才将虎旅卫天居，又拥雕戈出帝都。\n部伍散行秋野阔，旌旗斜捲暮云孤。\n扶桑分阃封圻近，杕杜连歌雨露馀。\n壮节封侯应有日，青云回首是长途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5930,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金台送别为李进都指挥赋二首 其二","author":"薛瑄","text":"虎将承恩出九重，紫泥封带御香浓。\n离筵济济都门酒，征马萧萧别路风。\n雄镇行看沧海近，归旌遥指岱山崇。\n太平分阃浑閒事，万里封侯慷慨中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5931,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泰安州重寄李太亨","author":"薛瑄","text":"去年岱麓题诗寄，岱麓逢人又寄诗。\n剖竹已当耆艾日，解龟仍及圣明时。\n青山纵有归来约，黎首其如去后思。\n愧我年年持宪节，涓埃无补欲何为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5932,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"海上道中述怀","author":"薛瑄","text":"马首东来岁月频，西归犹及艳阳春。\n风烟满目溪山秀，花柳无边雨露新。\n四海甄陶明圣主，万家耕凿太平民。\n敕天千古遗歌在，每抱丹心恋紫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5933,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"青州府迎诏","author":"薛瑄","text":"丹霄快睹凤衔书，春与天恩满八区。\n不独山东扶杖听，还应海内效嵩呼。\n衣冠济济风云际，花柳欣欣雨露馀。\n柏府微臣瞻盛事，载驰忠恳恋皇都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5934,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次黄仲芳韵二首 其一","author":"薛瑄","text":"京华偶尔论斯文，知是游心出圣门。\n风度恍如瞻玉树，清谈蔼若挹芳荪。\n薇垣三载时名大，花县多年旧泽存。\n愧我无能叨宪节，缪同述职荷天恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5935,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次黄仲芳韵二首 其二","author":"薛瑄","text":"薇省分符重黑头，天官考绩冠时流。\n趋朝晓日辞丹凤，去路西风跃紫骝。\n自昔藩维求俊杰，只今典礼尚虞周。\n都门此别须珍重，还拟经邦赞大猷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5936,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王秀才省兄归京师","author":"薛瑄","text":"华不注高秋气多，大明湖水落霜波。\n山川风景今如此，兄弟分携意若何。\n宪府已应持玉节，亲闱长是近銮坡。\n明年三月春光好，更忆金台有雁过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5937,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李永年大参致仕十首 其一","author":"薛瑄","text":"四朝出入受恩多，诏许南归意若何。\n路绕青齐驺骑远，水通淮海画船过。\n故园到日收禾黍，别墅经年长薜萝。\n父老倾怀看白发，儿童佐酒发清歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5938,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李永年大参致仕十首 其二","author":"薛瑄","text":"七十悬车古亦稀，明时乞得健身归。\n朝廷已自优黄发，乡里无劳羡锦衣。\n碧水细通栽药圃，青山閒绕钓鱼矶。\n江南事事皆堪乐，莫遣流年赏兴违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5939,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李永年大参致仕十首 其三","author":"薛瑄","text":"历下山川入画图，西门怅别指征途。\n已知圣代优诸老，还似当年饯二疏。\n归路远应经铁柱，名山行复见香炉。\n江南江北相思处，鸿雁来时好寄书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5940,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李永年大参致仕十首 其四","author":"薛瑄","text":"黄甲声名四十年，薇垣粉署共称贤。\n方看荐鹗升三事，又乞归身别九天。\n恩诏近从丹阙降，使车遥向碧山悬。\n耆英莫谩誇中洛，江右风流也自传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5941,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李永年大参致仕十首 其五","author":"薛瑄","text":"白发明时老大臣，封章几上乞归频。\n四朝宠觉腰金重，三代恩沾綵诰新。\n花发薇垣成远梦，潮平扬子是通津。\n到家正值秋光好，黄菊东篱有故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5942,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李永年大参致仕十首 其六","author":"薛瑄","text":"已向明时早拂衣，家山回首兴如飞。\n丹心老去声名大，白发归来故旧稀。\n几处甘棠留画省，绕门杨柳荫苔矶。\n惟应野老来争席，坐玩沙鸥伴夕晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5943,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李永年大参致仕十首 其七","author":"薛瑄","text":"闻道江南景物嘉，薇垣有客正思家。\n池塘夜雨翻荷叶，篱落秋香散稻花。\n德誉尚为清论重，仪刑应有正人誇。\n欧公曾写归田录，好继遗芳播迩遐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5944,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李永年大参致仕十首 其八","author":"薛瑄","text":"梁苑登科二十年，乘骢频与岁时迁。\n忽逢先达青云上，已是门生白发前。\n盛世澄清惭我劣，明时归老羡公贤。\n追随冠盖城西别，心逐行舟入楚天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5945,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李永年大参致仕十首 其九","author":"薛瑄","text":"才捧除书拜好官，又承恩诏许南还。\n人辞历下山光远，船过真州水面宽。\n松菊未荒三径在，衣冠不改一身閒。\n推恩更有新鸾诰，留与家门久远看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5946,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李永年大参致仕十首 其十","author":"薛瑄","text":"邂逅东藩仅一年，先生何事著归鞭。\n曾闻碧岫云藏屋，见说清溪月满船。\n归老会寻山水乐，声名不让古今贤。\n遥知林下徜徉处，犹起丹心忆九天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5947,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泛舟思亲","author":"薛瑄","text":"天地无穷水自流，髫年已侍二亲游。\n中原道路曾驱马，江汉波涛更泛舟。\n孤藐光荣叨宪节，音容寂寞閟松楸。\n千思万想情何极，目送飞云到故邱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5948,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送夏希纯郎中归南京","author":"薛瑄","text":"云路分飞二十年，相逢鬓发各苍然。\n柏台直指心如旧，粉署郎官职又迁。\n北阙九霄瞻晓日，南风五两送归船。\n帝京到日多佳兴，虎踞龙蟠入望边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5949,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日东平道中","author":"薛瑄","text":"齐鲁西风草树秋，川原高下过东州。\n道边白鹤来华表，陌上苍麟卧古丘。\n九曲半应非禹迹，三山何处是仙洲。\n经行俯仰成今昔，却忆当年赋远游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5950,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过五道岭","author":"薛瑄","text":"峰岭连连接岱宗，路从绝顶度华骢。\n馀寒常带阴崖雪，爽气仍飘霁壑风。\n春入驿亭严候吏，云随宪节怪山童。\n方巡每岁叨天宠，长见车书海宇同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5951,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宁阳行台元夕忆黄宪使","author":"薛瑄","text":"曾忆观灯宴后堂，玉杯行酒夜何长。\n新声已觉随银甲，逸响还惊绕画梁。\n东道留宾能闭户，诸郎爱客解牵裳。\n别来好景逢元夕，空向行台对月光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5952,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"沂滨书舍为曲阜令孔公堂赋","author":"薛瑄","text":"鲁城南畔碧溪头，结屋藏书事事幽。\n入户日光浮野马，隔帘波影漾沙鸥。\n真传已觉千年远，大道还从六籍求。\n闻说浴沂当此地，春风有约事追游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5953,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"兖州道中","author":"薛瑄","text":"敷土名传旧兖州，山川遗迹快追游。\n泗沂冻解波犹浅，凫峄春回翠欲流。\n野火碑馀秦相国，闷宫诗颂鲁诸侯。\n悬知尼父当年志，梦寐长思见盛周。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5954,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和壁间虞伯生皋字韵","author":"薛瑄","text":"中书几秃管城毫，尽日抄书未觉劳。\n但得文章如布帛，不须诗句比金膏。\n淳庞每忆黄舆厚，玄鉴深期碧汉高。\n莫道知音人世少，有鱼潜渚鹤鸣皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5955,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陈都宪镇关中三首 其一","author":"薛瑄","text":"四朝风纪受恩深，又见西行捧德音。\n天上神仙知暂别，关中父老喜重临。\n戍閒部伍清河曲，地远桑麻接华阴。\n到处行台怀帝阙，封章还拟罄丹心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5956,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陈都宪镇关中三首 其二","author":"薛瑄","text":"中丞斧钺下青霄，重镇关中别路遥。\n卫水楼船春解缆，崤陵骢马晓扬镳。\n诸军共仰新旌节，列郡仍遵旧教条。\n想是归期应不远，朝元有约听箫韶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5957,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陈都宪镇关中三首 其三","author":"薛瑄","text":"九重深念及西人，山镇还须老大臣。\n宪节入关随爽气，玺书行郡布阳春。\n山连玉井晴飞雨，地接金城迥不尘。\n经济本为儒者事，功成还拟画麒麟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5958,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送金都宪镇宁夏二首 其一","author":"薛瑄","text":"大夫承诏出皇州，西夏山川是壮游。\n笳鼓尽迎新宪节，风霜仍肃旧貔貅。\n久知河陇诸蕃静，又见崆峒二麦收。\n总赖庙谋清四海，不须樽俎借前筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5959,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送金都宪镇宁夏二首 其二","author":"薛瑄","text":"西行紫诰带新泥，葱岭河隍入马蹄。\n列镇久应烽火息，连屯惟见稻秧齐。\n远通贡篚来天外，直布皇风到海西。\n万里成功归有日，青云满眼是丹梯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5960,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送卢都宪镇守宁夏二首 其一","author":"薛瑄","text":"明时出镇得才难，莫厌经行万里间。\n玉节初辞青?闼，霜风先到贺兰山。\n关河控带黄尘静，蕃落耕耘绿野閒。\n入觐天颜应咫尺，不须频看宝刀环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5961,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送卢都宪镇守宁夏二首 其二","author":"薛瑄","text":"同年於我最相亲，宪府乘骢迈等伦。\n正是趋朝承雨露，又看持节出风尘。\n山川迢递行时旧，旌旆悠扬到日新。\n暂抚西陲归有日，看花须及凤城春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5962,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"出京师二首 其一","author":"薛瑄","text":"孤臣泣血省愆尤，诏释羁缧出凤州。\n满目山光迎马首，一鞭归思绕林丘。\n罢官已是安时命，报国空惊不自筹。\n遥想到家春已暮，麦黄蚕老稼盈畴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5963,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"出京师二首 其二","author":"薛瑄","text":"久知樗散是非才，卅载超迁历寺台。\n松柏每期冬雪茂，杏花不逐艳阳开。\n数茎白发还禁老，一寸丹心未觉灰。\n此日为农归故里，河汾岁晚兴悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5964,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"患难中海昌李太守数书问及诗以报之","author":"薛瑄","text":"知己情深数寄书，问吾行止近何如。\n买车已上山西路，结屋还依水北居。\n乐意不忘寻简帙，生涯祇拟付耕锄。\n感君交义高千古，远道何由致报珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5965,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"步朱尚宝送行韵用以留别二首 其一","author":"薛瑄","text":"一枕邯郸梦已醒，归鸿千里拂高冥。\n心期皎日均能许，歌擅阳春我独听。\n别去莫惊头并白，相思终是眼长青。\n河汾故里遗风在，争似当时续六经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5966,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"步朱尚宝送行韵用以留别二首 其二","author":"薛瑄","text":"驿路春风酒半醒，离情花思两冥冥。\n穿林乳燕深深去，傍柳流莺细细听。\n官渡已过滹水碧，家山又近太行青。\n龙门旧业应如昨，樵谷渔矶取次经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5967,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚翠轩为杨大参赋","author":"薛瑄","text":"高人雅有岁寒盟，笑傲华轩寄远情。\n最喜竹风当座起，绝怜松雪近人清。\n年来劲节心能与，春去繁华眼不惊。\n若此秋香还共美，拟从良史传佳名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5968,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日游禹门","author":"薛瑄","text":"野服归来野兴幽，十年仍遂禹门游。\n崖回曲路通危栈，峡束洪涛泻急流。\n楼结飞甍临绝汉，宫高华榜焕层丘。\n乡人未必知神意，丝管啁啾聒未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5969,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭少子治","author":"薛瑄","text":"患难归来始自怜，悲伤何事又相煎。\n一经赖尔传先业，二竖婴人殒少年。\n遗卷不堪寻旧墨，荒冈忍复见新阡。\n伤心问寝寒斋夜，鸿雁行中讶失联。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5970,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题李麟惜阴卷","author":"薛瑄","text":"连城自古出蓝田，还道骊珠在九渊。\n勤苦方能求至宝，放情未必得真传。\n案头每见秋萤聚，窗里常知野马悬。\n年少惜阴真可畏，老予鬓发已星然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5971,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"用旧韵酬海宁李太守四首 其一","author":"薛瑄","text":"闻道先生近著书，高怀雅兴迥难如。\n兰栽九畹谁同采，竹种千竿自可居。\n溪水每从晴后钓，山田多向雨中锄。\n殷勤远道裁诗寄，绝胜骊龙颔下珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5972,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"用旧韵酬海宁李太守四首 其二","author":"薛瑄","text":"焚香才暇即披书，老去无能得自如。\n青简尚寻高士传，白云还似野人居。\n秋风婢子晨供织，细雨儿童晚荷锄。\n道不远人真可乐，何须象罔索玄珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5973,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"用旧韵酬海宁李太守四首 其三","author":"薛瑄","text":"四千里外一封书，纵有琼瑶报不如。\n云水当年思共步，山川此日已安居。\n霜前枣熟从人打，雨后葵荒欲自锄。\n白雪调高知和寡，强将鱼目比明珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5974,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"用旧韵酬海宁李太守四首 其四","author":"薛瑄","text":"五马无劳事简书，一生行止自如如。\n冥鸿有意随高逝，野鸟忘机伴所居。\n千树黄柑应自种，一窗青草不须锄。\n门临沧海秋先觉，长见寒光浴晓珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5975,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"立秋日","author":"薛瑄","text":"雨晴新涨落汾黄，绿树风生户牖凉。\n跋马空怀登远道，闻蝉还喜是吾乡。\n离离禾黍东皋近，缈缈云霞北岭长。\n有酒便堪消暇日，流年不管鬓成霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5976,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题冯处士卷","author":"薛瑄","text":"忽从嚣杂见真淳，谁道今人不古人。\n四礼每宗朱氏教，一门长接孟家邻。\n椿庭时雨年年润，兰砌光风日日新。\n青简会须书行义，高名直与董生亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5977,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次何佥宪自学韵二首 其一","author":"薛瑄","text":"阿閤梧桐第一枝，朝阳快睹凤鸣时。\n西江才学推虞集，北斗声名仰退之。\n直道敢抛君子志，中情还有正人知。\n青青谁似霜台柏，耸壑昂霄更有期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5978,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]