:"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11322,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送小儿会乡试 其四","author":"庄昶","text":"桂花一树几人分，吃著三场应举文。\n富贵汝知何物是，浮云之外且浮云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11323,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"华亭金藻休宁汪循上海张澡诸友枉顾定山且索一言于其别诗以道意 其一","author":"庄昶","text":"庭草真传到晦翁，无端万紫与千红。\n可知肝胆朱门学，不在经书传注中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11324,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"华亭金藻休宁汪循上海张澡诸友枉顾定山且索一言于其别诗以道意 其二","author":"庄昶","text":"风月无边问荅时，青山活水满吾诗。\n若除流动天机外，老子平生自不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11325,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"华亭金藻休宁汪循上海张澡诸友枉顾定山且索一言于其别诗以道意 其三","author":"庄昶","text":"斯道乾坤自古今，濂溪主静独吾心。\n孔颜乐处真何事，愿与诸贤更一寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11326,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"华亭金藻休宁汪循上海张澡诸友枉顾定山且索一言于其别诗以道意 其四","author":"庄昶","text":"举业经书也圣功，人间道眼费圆融。\n夜来睡醒罗浮梦，月满秋江数十峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11327,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"司训廖先生家观菊 其一","author":"庄昶","text":"睡起疏篱点物华，四三童冠几黄花。\n浴沂此日秋光里，不属曾家属廖家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11328,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"司训廖先生家观菊 其二","author":"庄昶","text":"年年老菊费栽难，每到秋来借倚阑。\n老我白云红树子，如今都作此花看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11329,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"司训廖先生家观菊 其三","author":"庄昶","text":"短篱黄菊满秋晖，把酒相看醉不违。\n却道我家元自有，帽檐不与一枝归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11330,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"司训廖先生家观菊 其四","author":"庄昶","text":"秋光莽莽到东篱，要识陶家以外诗。\n倘把傲霜徒自看，此花天妙没人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11331,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"司训廖先生家观菊 其五","author":"庄昶","text":"花到金相玉质精，真纯和粹更幽清。\n凭谁笑与梅花说，且合推尊作大成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11332,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"司训廖先生家观菊 其六","author":"庄昶","text":"圣池长共此花评，一句清深万古灵。\n天味倘知真个好，欲和朝露咽先生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11333,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"司训廖先生家观菊 其七","author":"庄昶","text":"太极人间物物新，龟书龙马各精神。\n泮池我爱三夫子，认得黄花绿叶真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11334,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"司训廖先生家观菊 其八","author":"庄昶","text":"天意秋香未肯涯，绕篱黄白尽容誇。\n物中若道无凡圣，岂有人间不落花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11335,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪雁","author":"庄昶","text":"江山万里雪如此，老雁北风何处滩。\n欲识阴阳千古梦，乾坤聊在睡中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11336,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪兔","author":"庄昶","text":"人间物物天何碍，老兔泉声亦妙如。\n笑我天机无点处，白头拈笔是鸢鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11337,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"半山亭 其一","author":"庄昶","text":"一墩千古且閒争，拗鬼何知更此平。\n蕉鹿也知真梦梦，此亭吾恐亦虚名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11338,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"半山亭 其二","author":"庄昶","text":"老眼苍茫醉欲还，数椽聊复半山间。\n谁家亭子青天上，只属虚空不属山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11339,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"思亲楼","author":"庄昶","text":"乾坤了尽了何如，怪伟公然一大书。\n明日肯君参欲破，老拳搥碎此楼居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11340,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"友山","author":"庄昶","text":"一语乾坤更几关，白头师友恐须閒。\n友山若问真何说，万古中间我一山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11341,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题江村卷","author":"庄昶","text":"溪山驴背不藏春，花柳东风眼自真。\n道得程家新句子，老夫今日拜何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11342,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王判簿归蜀时萧尹在邑 其一","author":"庄昶","text":"世务閒闻到寂寥，鸺鹠潦草得鹪鹩。\n谁真笑我长镵柄，斸断山腰枸菊苗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11343,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王判簿归蜀时萧尹在邑 其二","author":"庄昶","text":"僻坞桃花已失公，买刀何许更相逢。\n饿夫半勺秋来梦，须绕巫山十二峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11344,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王判簿归蜀时萧尹在邑 其三","author":"庄昶","text":"片语丰干偶觉违，一年风雨几柴扉。\n可知老子黄山月，也送巴江万里归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11345,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"上西华山先陇 其一","author":"庄昶","text":"丱髻殷忧遽海涯，松吴来梦几江花。\n那知此道千年拜，我祖青天是起家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11346,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"上西华山先陇 其二","author":"庄昶","text":"汉老乾坤日月光，一亭千古几纲常。\n也谁知此鸥波地，更与颓风大主张。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11347,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"上西华山先陇 其三","author":"庄昶","text":"万古平章与后先，馂馀唐汉总垂涎。\n可知花柳乾坤里，我祖风流六十年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11348,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"上西华山先陇 其四","author":"庄昶","text":"针芥劳劳漫古今，几徒鱼水草庐心。\n千年独有精英槩，不与青山壳子深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11349,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"上西华山先陇 其五","author":"庄昶","text":"抔土长埋盖世姿，西华撼动小孙诗。\n终身诸葛无人识，聊与青山绿水知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11350,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"上西华山先陇 其六","author":"庄昶","text":"孙翁衣钵只中庸，马仆牛医奠酒同。\n我辈不知谁是伋，松梢擘纸挂西风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11351,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"上西华山先陇 其七","author":"庄昶","text":"遗编甫律也翱文，世难寥寥只此坟。\n不识我来谁与看，江风天摆万秋云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11352,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"上西华山先陇 其八","author":"庄昶","text":"江蓑水月老还披，许大乾坤一片碑。\n千古无船横钓濑，墓门能拜子陵谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11353,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄沈慎之 其一","author":"庄昶","text":"雁荡天台且未堪，春潮能许挂江帆。\n空山十丈丹厓里，一个痴人一草庵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11354,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄沈慎之 其二","author":"庄昶","text":"老拙元无半寸长，逢君不语只空狂。\n白头静里焚香坐，长记移舟过溧阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11355,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"子陵钓鱼图","author":"庄昶","text":"行止丘轲总未裁，江波祗个钓鱼台。\n谁知也有渔舟画，不照严光影子来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11356,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽香岩和尚为僧寂庵作 其一","author":"庄昶","text":"来来去去非真幻，此理人间本妙哉。\n公是寂庵吾敢问，师今何去昔何来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11357,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽香岩和尚为僧寂庵作 其二","author":"庄昶","text":"钟声谁打定中魂，那有三才别立根。\n我正问公公已死，岂胜哀泪洒乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11358,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽香岩和尚为僧寂庵作 其三","author":"庄昶","text":"死却香岩未可谈，个中何者不香岩。\n静无动有吾何说，试著西庵老寂参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11359,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠星命者和东白先生","author":"庄昶","text":"人间几许卧谁龙，谈命谈星半醉中。\n且莫相逢开口易，老夫富贵是苓通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11360,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梅花 其一","author":"庄昶","text":"元自贞来妙亦深，梅花何处见天心。\n凭谁说与尧夫老，莫向乾坤子半寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11361,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梅花 其二","author":"庄昶","text":"草阁半床疏影月，梅花今夜妙何如。\n老夫自起焚香坐，周易谁知不在书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11362,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梅花 其三","author":"庄昶","text":"一花太极一丸春，何梦林逋看未真。\n自有暗香疏影句，相知千古是何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11363,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梅花 其四","author":"庄昶","text":"一白已为天下绝，千红还许独开先。\n若将齿角丘轲论，野店山桥亦老天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11364,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梅花 其五","author":"庄昶","text":"图绘相逢已太频，天谁传说许前身。\n白头岂误和盐梦，只恐匆匆画未真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11365,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梅花 其六","author":"庄昶","text":"菊花曾许是龟书，岂有寒梅不共之。\n周子通书程子易，孙翁须爱紫薇诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11366,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梅花 其七","author":"庄昶","text":"罗浮真兴许谁狂，暗暗频通万古香。\n昨夜酒醒何处梦，五更霜月满溪堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11367,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梅花 其八","author":"庄昶","text":"真香妙影舞溪园，每共山人月一轩。\n全体等閒俱露却，莫言天地不能言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11368,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梅花 其九","author":"庄昶","text":"天妙相逢几称情，平生老菊尚渊明。\n千年著放莲花眼，莫遣南枝气不平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11369,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题僧惠堂卷 其一","author":"庄昶","text":"此公元自一仁来，根向三才肯别栽。\n散得人间真种子，乾坤花满万灵台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11370,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题僧惠堂卷 其二","author":"庄昶","text":"摩顶阎浮手欲痡，不知曾惠自家无。\n明朝且把收归我，康济乾坤一丈夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11371,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题僧惠堂卷 其三","author":"庄昶","text":"真惠凭谁问且真，百年偶醉十窝春。\n定知老秃明朝顶，模著陈纲太极巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11372,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"落梅","author":"庄昶","text":"不从贞处不看元，玉篴春风总浪言。\n明日中间仁一点，始知开落是同原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11373,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梅花","author":"庄昶","text":"尽遣东风问化工，南枝何与北枝同。\n谁知无限春消息，都在寒烟一抹中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11374,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"竹梅","author":"庄昶","text":"神翠真红万古妍，化机相与荡何天。\n披图多少尼丘梦，空有乾坤雪满颠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11375,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鸡冠花","author":"庄昶","text":"古今物物疑相似，一体乾坤到几人。\n笑把天峰秋色看，万红何片不同真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11376,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"红梅","author":"庄昶","text":"万物相形本各真，东风何意醉花神。\n相看道眼休轻乱，白白红红总是春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11377,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"萱草 其一","author":"庄昶","text":"何闻謦欬不羹墙，曾与忘忧树北堂。\n留得孤儿千古泪，不知忧在几时忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11378,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"萱草 其二","author":"庄昶","text":"何处空堂梦欲残，白头片萼偶相看。\n可胜精卫无穷恨，沧海填乾泪也乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11379,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"代弟孔高荅大中时游香泉","author":"庄昶","text":"天纳吾家古朴城，祗将顽钝学痴兄。\n知君不误真衣钵，付与溪山执屦行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11380,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题徐端本画","author":"庄昶","text":"云水草亭閒自荡，风花老子动相随。\n如今我问徐端本，一体乾坤却画谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11381,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画朱永隆吴大宜求","author":"庄昶","text":"两眼堪盲病老穷，横云当面唾青松。\n大风可怪悲歌甫，卷我山茅屋几重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11382,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄司马先生 其一","author":"庄昶","text":"溪云曾每拜公来，共我渔蓑滥钓台。\n万里不知皇极手，谁家今又点蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11383,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄司马先生 其二","author":"庄昶","text":"书来无语不言还，出处谁能付等閒。\n公有鸢飞鱼跃意，武夷山亦会稽山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11384,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄司马先生 其三","author":"庄昶","text":"糟粕将无此学看，三年一语听终难。\n白头肯许相忘地，更与濂溪拜肺肝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11385,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄司马先生 其四","author":"庄昶","text":"别无书寄去无诗，形迹俱忘老病时。\n昨夜朱弦弹绝意，只惟溪月洞云知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11386,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画 其一","author":"庄昶","text":"一猎何心更许驰，此中天妙只天知。\n谁知满眼溪云趣，不在庖羲画卦时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11387,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画 其二","author":"庄昶","text":"若此烟云若此山，岂无版筑个人閒。\n不知画者今何意，只画天松屋数间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11388,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]