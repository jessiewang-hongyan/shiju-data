[{"title":"喜伦右溪回十首 其六","author":"王渐逵","text":"玉简金涵藉未除，旧时真兴定何如。\n青萝大隐春无恙，已遣山灵整鹿车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1519,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜伦右溪回十首 其七","author":"王渐逵","text":"粤山风景在南楼，久客遥看款旧游。\n喜有东风双燕子，飞来帘槛日淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1520,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜伦右溪回十首 其八","author":"王渐逵","text":"岭海于今盛事存，茂林脩竹萃诸贤。\n葛巾野服同扶醉，曾记当时入社年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1521,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜伦右溪回十首 其九","author":"王渐逵","text":"黻藻文章焕帝猷，未应高枕卧林丘。\n春风社馆劳分什，花鸟于今莫漫愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1522,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜伦右溪回十首 其十","author":"王渐逵","text":"三春淑气散熙和，弭节乡闾得暂过。\n此日相怜应尽醉，金陵朋旧已无多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1523,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦游罗浮诗","author":"王渐逵","text":"遥入三峰上界西，恍疑身与太虚齐。\n千章异木名难识，十里青霞路欲迷。\n古璧飞泉怜旧馆，断珉封藓见留题。\n春风归梦还相忆，欹枕藤床独听鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1524,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自城徒回乡间旧居寄伦白山同年","author":"王渐逵","text":"五月空山熟荔枝，两年经暑寄岩扉。\n石渠天远梦不到，藤枕林深客亦稀。\n卖宅拚耕桑梓里，卧锄真咏太平时。\n想应山禁馀清暇，亦对薰风忆旧知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1525,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"环谷八咏 其一 榕阴夜月","author":"王渐逵","text":"层荫散碧漪，月色信寒翠。\n稚子喜相呼，去拾瑶琼翠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1526,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"环谷八咏 其二 桃坞蒸霞","author":"王渐逵","text":"道人性适真，茅斋卧空碧。\n种桃岁月深，染遍青山色。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1527,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"环谷八咏 其三 河泉诗社","author":"王渐逵","text":"出语好惊人，累日不成语。\n呼童觅吴笺，忽得江头句。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1528,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"环谷八咏 其四 荔阴渔矶","author":"王渐逵","text":"兴足不设机，只以荔为饵。\n犹恨风触枝，深我群鱼智。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1529,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"环谷八咏 其五 雪岩晚眺","author":"王渐逵","text":"冬雪亦自佳，此意向谁论。\n推窗试一观，天地正混沌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1530,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"环谷八咏 其六 雪洞春眠","author":"王渐逵","text":"地僻鹿为群，山深云作洞。\n莫遣风太吹，惊我游仙梦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1531,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"环谷八咏 其七 方台竹色","author":"王渐逵","text":"绿竹环高台，青簟聊自枕。\n不作云韶声，犹带潇湘韵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1532,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"环谷八咏 其八 环谷松声","author":"王渐逵","text":"松声入我调，调切声更古。\n援手传其音，按作山中谱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1533,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕有感","author":"王渐逵","text":"縻食人间愧腐儒，遗经脩葺意何如。\n春风亦到扪萝径，茅屋空围满架书。\n交海只今烦总制，汉皇何日定居胥。\n华峰未足图南睡，又报山中一岁除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1534,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿张蒙溪方伯初度 其一","author":"王渐逵","text":"清朝岳伯度初经，岭海江山尽效灵。\n遂有祝融开寿域，即看南斗避文星。\n弧光每向秋分见，台色遥依紫极明。\n再拜峰头深一祝，半为知己半苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1535,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿张蒙溪方伯初度 其二","author":"王渐逵","text":"两勤播命奠明区，十郡欢歌寿庆馀。\n沧海白云趋屏树，赤蛇朱鸟肃冠裾。\n薇花席上秋光满，鼓角声中瑞气舒。\n盖世勋名应属望，白头今已愧迂儒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1536,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋答王岱麓 其一","author":"王渐逵","text":"山水平分未是贫，野亭终日可娱宾。\n举杯试问中秋月，拂麈遥空下界尘。\n岂谓乘槎归海岛，即看听履上星辰。\n重斯再入桃源浒，纵遇澳郎不问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1537,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋答王岱麓 其二","author":"王渐逵","text":"野簌山醪敢厌贫，独延清论枉嘉宾。\n晴云已遣重开径，冻雨应先为洒尘。\n籁气萧深供送兴，蟾光圆丽答佳辰。\n扁舟已辨溪桥桨，共采芙蓉向碧津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1538,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饮伦越溪藕花洲","author":"王渐逵","text":"三城著阅多名苑，爱尔清虚小洞天。\n筇杖芒鞋深一到，冱萝苍径曲相连。\n君山月映潇湘竹，太华泉通王井莲。\n疑是天台堤畔路，石桥横处会神仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1539,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日宴钦桃李园续太白之兴 其一","author":"王渐逵","text":"春日忽相慊，携壶尽日看。\n风生锦步幛，露滴玉琅玕。\n细草迷芳渚，轻桡泛碧澜。\n蓬壶知不远，为尔重盘桓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1540,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日宴钦桃李园续太白之兴 其二","author":"王渐逵","text":"胜地深深际，霏烟潋潋重。\n春回三径里，人在万花中。\n曲岸依瑶圃，回流对碧峰。\n辋川馀画幅，诗思苦为工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1541,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日宴钦桃李园续太白之兴 其三","author":"王渐逵","text":"红白互相竞，芳菲亦自齐。\n春应怜隐僻，吾以慰幽栖。\n太白文先著，渔郎醉后迷。\n徘徊日将暮，惆怅石桥西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1542,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋和岱麓王君韵","author":"王渐逵","text":"一水茫茫隔，双星黯黯通。\n夜深团玉露，秋正肃金风。\n机石几时卜，云程万里逢。\n津头瞻折木，幽意可谁同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1543,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别张浮峰宪长","author":"王渐逵","text":"廿年高枕越江滨，喜治真儒杳不亲。\n沂水城南今见子，阳明门下更何人。\n秋风梵宇怜交晚，夜月云山感兴新。\n何日聚星堂上意，瓦瓶烧茗细相陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1544,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谢沈侯莅川见访","author":"王渐逵","text":"使君高谊动群英，茅屋柴扉亦署名。\n遂使麾旌纡莽麓，顿令山鸟识冠缨。\n索衣自觉秋风早，促席那堪夜雨并。\n扶病强能拚一醉，冱云骈树几开扃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1545,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题蔡大行寿母图","author":"王渐逵","text":"蔡君始作皇华使，万里孤儿辞母去。\n母儿相对两茫茫，越北燕南隔天地。\n秋风慈母倚门时，屈指正是儿归期。\n文章丹毂充闾闬，污走童妇相嗟咨。\n入门拜母母大喜，蔡氏于今有贤子。\n萱花堂上进霞卮，云母屏前具甘旨。\n儿孙参差列成行，乡人争贺驱酒羊。\n古云和气多致祥，蔡氏之福不可量。\n我知蓬阆亦不远，只在君家之内苑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1546,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三月脩禊事同少参王一江佥宪龚心韦伦右溪赋","author":"王渐逵","text":"三月有八日，时俗称上巳。\n伦子邀我游，访旧脩禊事。\n高朋集宴坐，云日亦欣媚。\n密荫纡前荣，芳葩敞丹塈。\n虽无丝与竹，泉涧自清异。\n雨后山气佳，好风复殷至。\n缨组遥相忘，野服得以恣。\n村居少忌讳，醉醪多所恕。\n聊为俚语吟，于君答嘉惠。\n闻古有高会，兰亭远相怜。\n清虚挹林壑，标格凌风烟。\n逸思启灵秘，俊才复争妍。\n遗世良独珍，玄风亦云愆。\n岂无黄鹄姿，匡时以为贤。\n君今际明世，淑德播以宣。\n暇日集宾从，雅志非管弦。\n我欲倚疏峰，为文纪其巅。\n藐彼羽觞子，徒以能书传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1547,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别少参王一江","author":"王渐逵","text":"灵境启玄秘，晶光露磅礴。\n日月杳倏忽，阴阳互藏宅。\n霞扉扃不开，灵源渺深隔。\n中有蕊珠宫，融瑞冲广漠。\n琅玕映丹函，琪树依玄鹤。\n我爱王子乔，间飞钟维岳。\n羽衣侣佺期，服食栖云壑。\n千载时一来，万物少厉扎。\n四海瞻飙轮，相望如饥渴。\n无为乘赤倩，飞腾恣寥廓。\n吾闻天台路，近与赤城邻。\n玄泉挹沆瀣，灵药多长春。\n君归纡杖屦，列仙以为群。\n一笑逢陈子，乃在桃源滨。\n相携入烟萝，燕语自存温。\n时跨双白鹿，飘举辞埃氛。\n玉门铭丹书，碧林撰玄文。\n罗浮杳天际，何时还见亲。\n愿言启真诠，为我哀斯人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1548,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀余约斋 其一","author":"王渐逵","text":"夫君久客旅，吾亦事耕农。\n穗城一分暌，六载问不通。\n讵意珠海浔，野服得相从。\n世俗纷转更，尚留好颜容。\n欣对谢主人，感我一尊同。\n平潮际芳洲，广树多惠风。\n踟踷不能去，于焉托孤衷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1549,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀余约斋 其二","author":"王渐逵","text":"郭生来青萝，过我双鱼居。\n为我诵所闻，言雅意有馀。\n知君勤讲席，后辈多沾濡。\n著述日云远，所得今何如。\n负疴歉相访，遥寄尺素书。\n村居寡往来，童仆亦荒疏。\n不识城南路，借问高人闾。\n植性本真率，君当恕谬迂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1550,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠吴苕溪侍御 其一","author":"王渐逵","text":"守拙卧林浒，负疴卧粤涯。\n忽逢吾使君，邀我上高台。\n高台何所有，两祠敞崔嵬。\n借问达者谁，云是使君开。\n元公已邈矣，石斋不重来。\n千秋仰粤人，孰云吾道乖。\n多谢使君嘉，晨风独徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1551,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠吴苕溪侍御 其二","author":"王渐逵","text":"山居履深僻，感我使君贤。\n杖屦出江津，良朋亦欣怜。\n携我上小舟，相饯灵洲边。\n使君有好怀，坐我松风筵。\n野性本荒谬，礼义亦多愆。\n感君得宽恕，因之发狂言。\n倏言起遐思，令我心烦悁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1552,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄谢张方伯犀浦","author":"王渐逵","text":"林钟动炎飙，我稼怀初熟。\n驾言上小舟，遥向青萝屋。\n高畬喜得雨，田父仰沾足。\n去岁苦旱饥，赖此庶充腹。\n今朝江渡口，仓遽走儿仆。\n手持故人书，凉荫卧且读。\n书中竟何有，历历写衷曲。\n忆昔为曹郎，出入联镳轴。\n讵看岁月周，流光迈淹倏。\n负疴缅旷莽，朝事不经目。\n同时几豪彦，一一忘所录。\n而我甘耕农，已君居省辖。\n伯氏今何如，不审燕与蜀。\n人生慨萍梗，尘梦纷蕉鹿。\n知君重契谊，感意情弥笃。\n还期理篙楫，拜悟越山麓。\n临风寄咏言，于焉致忱曝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1553,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李三洲之湖广 其一","author":"王渐逵","text":"黄鹊恣轻举，乃在楚云间。\n孤踪杳弗及，此去何时还。\n霏霏汉阳树，矗矗江夏山。\n相望不相即，我心郁以烦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1554,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李三洲之湖广 其二","author":"王渐逵","text":"洞庭湖水生，茫茫杳天地。\n念子戒行迈，临期叹分异。\n岳楼敞幽虚，君山启灵秘。\n相思不相对，我心郁以炽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1555,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李三洲之湖广 其三","author":"王渐逵","text":"君慕秦人洞，遥在武陵溪。\n洄源翳重云，落花漏荒堤。\n世远道已堙，何时共依栖。\n路若逢渔父，为我指其迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1556,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李三洲之湖广 其四","author":"王渐逵","text":"衡岳镇南离，亭亭祝融峰。\n闻有神禹碑，旷世罕其逢。\n圣朝启灵运，一朝显奇踪。\n烦君打数幅，寄我千虬龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1557,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李三洲之湖广 其五","author":"王渐逵","text":"去年别右溪，今年别吾子。\n人生百年内，会合难久恃。\n白云无停踪，江水流不已。\n愿言莫遐遗，德音孔伊迩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1558,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苦雨","author":"王渐逵","text":"仲夏冱阴霭，朱火无炎熺。\n少微弛其运，司天讵能违。\n园林无畅条，岩壑汇为陂。\n欲渡无舟楫，策杖将焉浮。\n我稼稚以劣，众口仰在兹。\n迅雷无停声，重云滞还期。\n鼋鼍入井市，魑魅窥庭阶。\n旱潦频相仍，庶夫失镃基。\n哲士委时命，固穷乃其宜。\n抚恨良自慰，达顺夫奚疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1559,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄泰泉之江西","author":"王渐逵","text":"短篷疏雨共船窗，水为离人夜送淙。\n白日浮云连北阙，清秋晴黛过西江。\n文章王勃虚前阁，风土扬州亦故邦。\n此后应怜重回首，洛澄孤影对银缸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1560,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登镇海楼二首 其一","author":"王渐逵","text":"杖藜远出青萝嶂，览胜还登镇海楼。\n玉露下通星月井，綵云多傍凤鸾洲。\n凌虚不碍中原望，倒景遥思八极游。\n杰观值须南服奠，芳名应与使君留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1561,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登镇海楼二首 其二","author":"王渐逵","text":"紫霞玄雾护崔嵬，海若阳侯入贺来。\n天地独怜形胜在，江山如待使君回。\n归墟落际遥相瞰，牛渚星槎远更开。\n闻道登高能作赋，文园空羡马卿才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1562,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镇海楼夜宿同区白斋江虚谷何古林伦右溪联句","author":"王渐逵","text":"会值离明劫气消，江山风物胜前朝。\n收来王伯一图小，坐控华夷万里遥。\n沂月槎通壶苑外，捲帘人在女牛标。\n酒酣夜午聊欹枕，共听银河欲上潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1563,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别王立庵 其一","author":"王渐逵","text":"五年羁客落萍踪，垂老江湖白发重。\n丹诏有春来紫阙，孤臣无语泣东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1564,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别王立庵 其二","author":"王渐逵","text":"幽谷山头路不纡，庾南风景未应殊。\n归时莫跨青牛去，关吏迎人乞著书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1565,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别王立庵 其三","author":"王渐逵","text":"三秦豪杰可谁同，卧病沧溟喜偶逢。\n圣世只今崇作述，蒲轮今见迓申公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1566,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠张可兰总兵","author":"王渐逵","text":"将军爱饮文字杯，尊俎每于宾客开。\n峨冠博衣春自兴，悬签插架书相堆。\n有时倚剑直南斗，无事放歌临越台。\n只今太平粪走马，画角高风吹不哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1567,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与黄泰泉九日登白云顶","author":"王渐逵","text":"佳节名山万古开，是谁曾此坐崔嵬。\n烟扉霞馆依稀见，红翠青鸾缥缈回。\n涧水独怜归海去，秋风何事逐人来。\n会须更上浮云顶，虎豹相逢莫浪猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1568,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日粤山眺望","author":"王渐逵","text":"远郭晴烟合，三城春气深。\n游人出木末，鸣鸟宿碑阴。\n大地楼台簇，佳辰管吹沉。\n由来重都会，藉此一开襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1569,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈天游招饮西郊园和伦右溪韵 其一","author":"王渐逵","text":"独嫌归发点尘沙，遥向朱明浣落霞。\n才藻昔曾标玉局，休栖应得近仙家。\n矩洲黾石时相主，萱草山茶春自花。\n昨夜女牛寒紫气，欲将星野问张华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1570,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈天游招饮西郊园和伦右溪韵 其二","author":"王渐逵","text":"溪头鸂鵣戏晴沙，堤畔儿童扫绛霞。\n骈树丛中无日月，互萝深处有人家。\n邺侯秘籍多新轴，洛下名园识异花。\n乘兴唱酬惭病拙，谩题游览纪年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1571,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别李绍乾","author":"王渐逵","text":"腊月开新酒，生刍注盈尊。\n念我平生友，驾言之朔云。\n相邀坐中堂，兴逸杯自勤。\n肴疏虽简率，欢笑亦温存。\n人生如飞凫，何时还同群。\n京洛多相知，兄弟语自真。\n西山饶爽气，广陌储丽春。\n得句但勿忘，远慰同心人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1572,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送龚佥宪归吴","author":"王渐逵","text":"杖履溪头一拜公，孤心谁与献重瞳。\n看来世事浑如逆，只有归帆是顺风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1573,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"半夜起坐","author":"王渐逵","text":"忽然夜半致虚澄，始信吾心即六经。\n在昔钻研真影响，而今磨洗自光明。\n莫于赘处还加赘，须到清时更倍清。\n君看东皋岩下水，渐成溪涧向沧溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1574,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送伦穗石之留都","author":"王渐逵","text":"浦荇江篱散碧汪，朗气晴黛乱帆张。\n不因万里轻乡国，自是男儿志四方。\n白下山川元胜丽，东园花鸟谩清狂。\n归来定有鲜春句，寄我山中作醉章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1575,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再游伦樾溪静深楼","author":"王渐逵","text":"秋色冥冥寒四山，园亭深跨六池间。\n窥鸥狎鹭若为主，铁干虬枝自作关。\n水石窝中馀画幅，烟霞封外即尘寰。\n醉来欹枕沧浪上，满地榆花共一湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1576,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋对月歌同诸公在樾森楼赋","author":"王渐逵","text":"狂生狂生性任真，自称太古无怀民。\n每便赤脚踏芳草，岂知长陌纡缁尘。\n八月中旬好天气，良朋佳节来相因。\n两厓秋色高且峭，皎月为我生比邻。\n网鱼恍若赤壁口，泛舟疑是西湖滨。\n岱麓先生天下士，北门锁钥封疆臣。\n乘槎万里至南海，爱我山水期半分。\n三洲刻志若幽讨，席上往往稽玄文。\n高谈六籍翻断案，捋鬓瞠目惊鬼神。\n右溪豪气逸今古，东坡太白迥不群。\n近来不饮已数月，大浇磊落非吾闻。\n穗石文章众所爱，上凌鲍谢争鲜新。\n一杯隐几面发赤，欹枕欲作羲皇人。\n今年月色喜如此，明年月色谁相亲。\n劝君对月且尽醉，共惜天涯海角身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1577,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中奉怀诸君十一首 其一 区令尹白斋","author":"王渐逵","text":"连江禀萧旷，久抱柴桑志。\n酒酣诗调新，月朗琴声异。\n负郭无二顷，饮水蔑千驷。\n我欲思古人，于君慰深意。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1578,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中奉怀诸君十一首 其二 梁令尹毅所","author":"王渐逵","text":"象山百鍊钢，忤世卧林野。\n逍遥湖南情，脱略云谷社。\n文簪绍累叶，越士避三舍。\n金石明尔心，卓哉古狷者。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1579,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中奉怀诸君十一首 其三 李郡守壁山","author":"王渐逵","text":"李侯寡言笑，灵度缅虚敞。\n字意溯秦先，诗嗣陈黄响。\n飘飘文溪裔，霜竹恣游往。\n舞雩咏归来，高朗冒神赏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1580,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]