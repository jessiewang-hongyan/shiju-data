[{"title":"徐方伯子与将之江右过访有赠二首 其一","author":"胡应麟","text":"岂谓看山地，能令结驷来。\n人非中散卧，客是伟长才。\n把袂淹萝薜，行觞藉草莱。\n夜中占紫气，云拥豫章台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16125,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐方伯子与将之江右过访有赠二首 其二","author":"胡应麟","text":"弭节过严濑，褰帷问楚皋。\n北风千骑发，南斗片鸿高。\n抚字声先著，登临思独豪。\n万年滕阁赋，行矣待抽毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16126,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送寿山人","author":"胡应麟","text":"飘然沧海客，曾事紫阳君。\n袖里黄庭字，囊中赤伏文。\n放舲三泖月，携杖九峰云。\n后夜华亭梦，应同鹤唳闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16127,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄李季宣二首 其一","author":"胡应麟","text":"盖忆曾倾地，樯移远别年。\n千花淮浦浪，独树海门烟。\n白苧吴郎曲，青娥楚客筵。\n广陵桥上月，相望几婵娟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16128,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄李季宣二首 其二","author":"胡应麟","text":"最忆真州夜，临岐解鹔鹴。\n江风停去鹢，海月伴离装。\n柳谢君平曲，花饶杜牧狂。\n吴姬三百辈，若个擅平康。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16129,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐铨部过访不值二首 其一","author":"胡应麟","text":"何因丛桂下，驷马值仙郎。\n日驻金珂影，星流玉剑光。\n登龙馀顾盼，题凤愧行藏。\n伫听东山起，含香入建章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16130,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐铨部过访不值二首 其二","author":"胡应麟","text":"传呼鸾掖吏，来访鹿门樵。\n曲径俄双屐，空山祗一瓢。\n白云寒自倚，紫气暮谁招。\n好去蓬莱殿，千花待汉轺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16131,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游横山庵","author":"胡应麟","text":"白马何年到，名山敞梵筵。\n坛空诸佛下，洞古一僧禅。\n钵与龙俱卧，灯将虎并传。\n真如祗自得，谁为问青莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16132,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陆太史敬承二首 其一","author":"胡应麟","text":"濩落吾能返，飞腾尔故频。\n自为三馆客，谁共五陵春。\n白日流金掌，红云护玉宸。\n故园芳草外，曾否念垂纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16133,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陆太史敬承二首 其二","author":"胡应麟","text":"尔作承明客，吾归已判年。\n花香鸾掖底，柳色凤池前。\n醉任眠中秘，閒仍草太玄。\n燕姬无限好，犹记琵琶弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16134,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭唐太常二首 其一","author":"胡应麟","text":"乍辍金华讲，长投海岸簪。\n中涓谁冀北，太史竟周南。\n襚道黄泉启，关门紫气含。\n平生携手客，泪尽百花潭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16135,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭唐太常二首 其二","author":"胡应麟","text":"袛谓焚鱼卧，真成跨鹤游。\n千秋谁挂剑，万事已藏舟。\n夜壑星辰远，重泉日月愁。\n独将知己泪，恸哭洒西州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16136,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王大行使岭外","author":"胡应麟","text":"迢递双旌色，朝行大海东。\n天垂鹏翼尽，日照蜃楼空。\n玉节诸番卫，金函万国同。\n归来铜柱畔，题赋尉陀宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16137,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅汪茂才","author":"胡应麟","text":"尺素天俱远，芳尊日暂同。\n自怀和氏璧，谁问楚王弓。\n昼卧苍龙偃，宵谈白马雄。\n青云太史在，宁复念途穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16138,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日同诸子登望衢亭作呈赵明府","author":"胡应麟","text":"剧兴真飞动，层台半斗牛。\n天空疑不夏，地迥欲生秋。\n峡色双龙抱，山形万马留。\n异时怀赋客，吾岂仲宣俦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16139,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李生西游久不得问因寄","author":"胡应麟","text":"西游去何日，念尔独离群。\n履绽秦山雪，筇飞蜀岭云。\n乡心寒狖落，客思夜鸿闻。\n记取岷中事，南归报右军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16140,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵太史之岭南五首 其一","author":"胡应麟","text":"一麾辞禁阙，万里赴长沙。\n地入蛮王垒，天浮汉使槎。\n乱山梅岭树，绝徼夜郎花。\n永夜罗浮顶，谁同眺日华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16141,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵太史之岭南五首 其二","author":"胡应麟","text":"贾傅章才上，王褒命已传。\n飞霜随剑舄，大海傍楼船。\n客梦梅花里，乡谣桂酒前。\n坐看公府暇，白雪满南天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16142,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵太史之岭南五首 其三","author":"胡应麟","text":"献纳纡青琐，驱驰恋紫宸。\n珠厓百蛮路，铜柱九夷春。\n郡邑横天起，旌旗截海陈。\n祗应宣室夜，万里召孤臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16143,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵太史之岭南五首 其四","author":"胡应麟","text":"豸服层霄下，麟符夹道光。\n万峰行瘴色，独马度炎荒。\n暮雪秦关拥，春城粤海长。\n转将金掌露，移洒向扶桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16144,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵太史之岭南五首 其五","author":"胡应麟","text":"暂辍兰台讲，言乘桂水桡。\n牙旌驰绝域，绣斧出中朝。\n瘴压高凉晚，山通大宛遥。\n莫嫌文字癖，干羽遍三苗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16145,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送何山人游边","author":"胡应麟","text":"悠然尊酒别，秣马问渔阳。\n汉碛连天紫，边沙拥日黄。\n列营随骠骑，分险驻龙骧。\n会挟金城策，长缨请建章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16146,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人还桐庐","author":"胡应麟","text":"不远桐江路，归帆候月牵。\n赤霞晨际海，青壁午连天。\n鸟道从人问，猿声傍客悬。\n钓台千尺倚，谁伴子陵眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16147,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人入蜀","author":"胡应麟","text":"客畏蚕丛路，君仍驷马过。\n白波三峡满，青嶂九疑多。\n绝栈移旌节，层台梦绮罗。\n海棠花在眼，烂漫倚高歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16148,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋晚灵隐寺小憩","author":"胡应麟","text":"咫尺东林寺，栏干不厌凭。\n万山回卓锡，一水护传灯。\n梵室偕龙树，经坛接惠能。\n上方钟磬发，晚傍白云登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16149,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李逸人西游","author":"胡应麟","text":"一骑西游远，双鸿北望饶。\n雪深眠太白，云起问中条。\n汉碛名偏古，秦碑字半销。\n已无婚嫁累，何地不渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16150,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"方伯滕公由岭南过访不值二首 其一","author":"胡应麟","text":"翩翩岩穴畔，千骑远从东。\n剑履周方伯，轩輶汉上公。\n花看薇省近，竹讶草堂空。\n万古夷门道，谁论意气雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16151,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"方伯滕公由岭南过访不值二首 其二","author":"胡应麟","text":"小队行春日，华镳问俗时。\n孤亭留皂盖，万户拥朱旗。\n气色函关绕，星辰汉殿移。\n未应题凤字，曾受子云奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16152,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壬午秋以家君命北上舟过严光先生祠戏作","author":"胡应麟","text":"不向长安去，何人奏客星。\n物情违偃蹇，吾道寄飘零。\n大泽寒收钓，高天暮放舲。\n羊裘谒明主，归卧万峰青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16153,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟次槜李寄王承父山人","author":"胡应麟","text":"痴绝王摩诘，何时出辋川。\n迷花孤洞里，采药乱峰前。\n剧饮留真态，长斋断俗缘。\n虎头新使者，曾乞卖文钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16154,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再游焦山","author":"胡应麟","text":"尺地开龙象，遥江浸画图。\n排云千寺立，涌雾一亭孤。\n叠岭藏钟磬，中峰过舳舻。\n凭谁买山色，把钓作潜夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16155,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜宿金山作","author":"胡应麟","text":"叠浪天浮玉，中流地布金。\n寺围孤岛面，亭插万波心。\n日候晨钟出，潮将夜梵沈。\n妙高寒独上，风雨过龙吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16156,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵杂诗二十首 其一","author":"胡应麟","text":"宛洛飞龙地，岐丰下凤年。\n河山西控蜀，象纬北朝燕。\n玉殿淩霄出，金城截海悬。\n嵯峨帝京色，万古镇江天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16157,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵杂诗二十首 其二","author":"胡应麟","text":"宝鼎成周奠，灵符大夏开。\n日当濠水上，云傍孝陵来。\n百辟瞻黄屋，千灵扈绛台。\n时看青琐客，鸣玉凤池回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16158,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵杂诗二十首 其三","author":"胡应麟","text":"虎豹天都近，鱼龙地轴閒。\n穿壕瓜步水，锁岸秣陵山。\n上苑明冠盖，新亭集佩环。\n徘徊承露掌，百尺暮云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16159,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵杂诗二十首 其四","author":"胡应麟","text":"帝阙三秋到，人烟四望平。\n城闉盘海气，市井杂江声。\n翠管吴讴发，牙樯越舶行。\n未央宫万户，恍忽见蓬瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16160,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵杂诗二十首 其五","author":"胡应麟","text":"禁苑花如织，离宫树作行。\n虹桥悬太液，凤管集昭阳。\n日丽雕甍动，云穿碧槛藏。\n翠华双掩映，犹记六龙翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16161,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵杂诗二十首 其六","author":"胡应麟","text":"画戟三千队，雕戈十二营。\n貔貅严左翼，熊虎列前旌。\n草木环滁动，蒹葭到海平。\n越裳重译至，何事问长缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16162,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵杂诗二十首 其七","author":"胡应麟","text":"树色东华远，钟声大内开。\n红云长乐观，紫雾柏梁台。\n帝座罘罳拥，仙城睥睨回。\n蒋山青不断，百里挂崔嵬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16163,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵杂诗二十首 其八","author":"胡应麟","text":"画槛排空立，飞甍逐望低。\n观危鳷鹊度，台古凤凰栖。\n海日千门上，江云万堞齐。\n大堤杨柳色，彷佛旧乌啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16164,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵杂诗二十首 其九","author":"胡应麟","text":"巷陌连松桂，园亭翳薜萝。\n人家王谢旧，佛寺晋梁多。\n北固晨钟断，西陵夜舶过。\n紫骝浑欲住，无奈客愁何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16165,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵杂诗二十首 其十","author":"胡应麟","text":"大道开平乐，名姝傍狭斜。\n黄鹂交坐柳，白马竞穿花。\n翠箔通云气，珠帘上月华。\n画梁双燕子，遥认莫愁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16166,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵杂诗二十首 其十一","author":"胡应麟","text":"玄武湖边路，西风载酒行。\n中流藏滟滪，叠岛象昆明。\n落日喧沙雁，回风动石鲸。\n楼船三十万，犹记汉皇营。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16167,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵杂诗二十首 其十二","author":"胡应麟","text":"胜绝南朝地，淹留北上程。\n石城看虎踞，萧寺听鸡鸣。\n岫锁吴云暗，江飞蜀雪明。\n诘朝关外路，真作弃繻行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16168,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵杂诗二十首 其十三","author":"胡应麟","text":"寂寞空三殿，豪华记六朝。\n齐梁频禅代，支许竞招要。\n只字神飞动，千言思泬寥。\n昔人吾倘遇，玉麈向谁骄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16169,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵杂诗二十首 其十四","author":"胡应麟","text":"杰阁凭虚上，回瞻帝阙西。\n城开千巷陌，刹涌万招提。\n灵谷青松合，钟山碧树齐。\n朝来渡江去，击楫为闻鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16170,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵杂诗二十首 其十五","author":"胡应麟","text":"落日长干道，青丝照玉壶。\n碧桃双系马，绿柳半藏乌。\n濩落堪词客，飞扬问酒徒。\n纵邀金谷侣，长夜斗摴蒱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16171,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵杂诗二十首 其十六","author":"胡应麟","text":"衮衮牛头路，青山极望同。\n天开吴楚地，寺锁晋隋宫。\n宿雾萦窗白，朝霞出户红。\n异时飞锡到，阐化大江东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16172,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵杂诗二十首 其十七","author":"胡应麟","text":"句曲山中树，华阳洞口云。\n玉楼千地涌，金铎四天闻。\n老鹤传丹诀，乖龙护赤文。\n五芝容客采，长揖大茅君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16173,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵杂诗二十首 其十八","author":"胡应麟","text":"结绮誇前代，临春忆大家。\n清歌传宝瑟，丽藻掷瑶华。\n殿倚千门月，楼飘万井霞。\n即今商女恨，悽绝后庭花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16174,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵杂诗二十首 其十九","author":"胡应麟","text":"屈指前朝事，悲凉旧迹存。\n金瓯长日月，玉殿自朝昏。\n野雀栖朱桁，啼乌过白门。\n柳花香满店，愁绝送王孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16175,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵杂诗二十首 其二十","author":"胡应麟","text":"献赋趋鸾掖，题诗寄凤台。\n自呼狂客饮，谁问谪仙才。\n步忆金莲下，歌听玉树回。\n三山吾欲去，万仞卧蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16176,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"欧水部招同张太学刘大理顾司勋夜集徐园迟李临淮不至同用心字二首 其一","author":"胡应麟","text":"华馆夜沈沈，追随惬素心。\n佩环三署合，灯火万家深。\n白苧翻吴曲，青萍动越吟。\n征西期不至，愁绝露华侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16177,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"欧水部招同张太学刘大理顾司勋夜集徐园迟李临淮不至同用心字二首 其二","author":"胡应麟","text":"名园仍北郭，小径入东林。\n地忆先皇赐，天回上客吟。\n当尊荷芰色，满座薜萝心。\n冉冉长安月，飞光下翠岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16178,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"区用孺以端研见贻索余一诗为报","author":"胡应麟","text":"邂逅罗浮客，论心卫水傍。\n红丝劳把赠，青玉烂生光。\n偃月窥芸案，涵星动草堂。\n输他阿环丽，捧立在昭阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16179,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭黎惟敬秘书四首 其一","author":"胡应麟","text":"此日朱明洞，谁同对浊醪。\n宦途穷执戟，人代绝抽毫。\n鸡犬闻天路，鱼龙泣海涛。\n传家大令在，忍睹凤凰毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16180,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭黎惟敬秘书四首 其二","author":"胡应麟","text":"骤得天涯讣，真成地下游。\n罗浮残月堕，碣石断虹留。\n惨淡青黎阁，嵯峨白玉楼。\n梅花一万树，何处挂吴钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16181,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭黎惟敬秘书四首 其三","author":"胡应麟","text":"石室瑶华閟，泉台玉树遥。\n神游今八极，宦迹旧三朝。\n客竞传中论，人谁赋大招。\n那堪潞河望，风色暮萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16182,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭黎惟敬秘书四首 其四","author":"胡应麟","text":"邂逅为玄日，踟蹰射策年。\n飞觥桃叶下，授简竹林前。\n调已中华绝，名应大海传。\n乱山铜柱外，若个是新阡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16183,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄观察金公","author":"胡应麟","text":"按部双旌远，行边一剑雄。\n图书观鲁殿，谣颂采齐风。\n泰岱浮空紫，蓬莱上日红。\n登临时极目，作赋许谁同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16184,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日湖庄八首 其一","author":"胡应麟","text":"幽栖只数椽，野水十家连。\n静室长生白，閒亭独草玄。\n蒹葭湖北路，禾黍郭西田。\n理就沧浪曲，吴歌日扣舷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16185,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日湖庄八首 其二","author":"胡应麟","text":"湖阔疑青草，原荒近赤松。\n微名藏一壑，大业寄千峰。\n户牖岚光满，阶除露气浓。\n楼高才十尺，莫拟卧元龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16186,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日湖庄八首 其三","author":"胡应麟","text":"素发垂垂近，青阳去去多。\n霜檐飘橡栗，雨壁上藤萝。\n越女红莲棹，吴侬白苧歌。\n翛然车马绝，曳杖步山阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16187,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日湖庄八首 其四","author":"胡应麟","text":"野色看逾近，秋光澹欲无。\n凄风回大壑，骤雨入平湖。\n碧树通樵径，丹枫系钓舻。\n江东步兵后，潇洒见吾徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16188,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日湖庄八首 其五","author":"胡应麟","text":"六尺鸱夷舫，萧然系短篱。\n乱山明隔垞，积雨暗空陂。\n身世鸬鹚老，行藏雁鹜知。\n五湖秋万斛，点缀著西施。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16189,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日湖庄八首 其六","author":"胡应麟","text":"大野黄云熟，平湖白露凉。\n菰芦环笠泽，薜荔翳柴桑。\n落雁啼沙汭，流萤度石房。\n寒花缀篱落，作意近重阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16190,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日湖庄八首 其七","author":"胡应麟","text":"穷巷回车辙，柴门尽日幽。\n杜陵歌大厦，玄德卧高楼。\n地许凫鹥占，天容鹿豕游。\n虞卿懒成癖，点笔为春秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16191,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日湖庄八首 其八","author":"胡应麟","text":"此日游仙梦，当时结客情。\n玉绳鳷鹊观，金钥凤凰城。\n白眼长安卧，红颜上国行。\n十年湖海气，疏阔傍柴荆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16192,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送萧司空之南都四首 其一","author":"胡应麟","text":"剑履新南国，旌旗旧朔方。\n一麾移细柳，万舸静扶桑。\n虎豹军容肃，麒麟帝眷长。\n异时书太史，宁复论平阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16193,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]