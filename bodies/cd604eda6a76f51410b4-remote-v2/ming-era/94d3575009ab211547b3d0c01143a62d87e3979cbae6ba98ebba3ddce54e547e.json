[{"title":"钱元抑春日过访用文内翰韵 其二","author":"邵宝","text":"记得湖南节偶停，曾将新政问朝廷。\n草蔬解后衡山子，相对琅函眼共青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47564,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钱元抑春日过访用文内翰韵 其三","author":"邵宝","text":"中年笔砚未曾荒，新稿相将满旧堂。\n湖上行人时指点，钱家村是郑公乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47565,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钱元抑春日过访用文内翰韵 其四","author":"邵宝","text":"东风吹草正忻忻，又向前庭迓故人。\n一道清泉千挺竹，与君还约看山春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47566,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿九十翁杨守愚","author":"邵宝","text":"天顺年初仁寿堂，宏治年中人瑞坊。\n九十四年还此老，仰看前辈益辉光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47567,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答王子春留别 其一","author":"邵宝","text":"岁晚山林万木空，独行长向老松东。\n迂夫最爱宽閒地，未肯寻源到水穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47568,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答王子春留别 其二","author":"邵宝","text":"清静平生性所偏，晚年经济敢求全。\n尧仁浩荡元无界，何处山林不是天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47569,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉石次韵","author":"邵宝","text":"太湖之南多秀峰，湖船偶载过莲蓉。\n何当移至三峰下，参我千年双古松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47570,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏赠秦国英","author":"邵宝","text":"君家竹林邻我林，隔墙共保岁寒心。\n一番雷雨箨龙起，贻我数茎千万金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47571,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中送春三绝 其一","author":"邵宝","text":"三月中旬已送春，蔷薇架畔木香新。\n能黄能紫非无色，终与东风隔一尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47572,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中送春三绝 其二","author":"邵宝","text":"留春不住送春归，多事杨花点客衣。\n有兴重来那用约，青山白发久忘机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47573,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中送春三绝 其三","author":"邵宝","text":"苦雨却怜新水涨，喜晴还怪野花开。\n野花径畔春将去，新水桥边晚未回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47574,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"墨竹","author":"邵宝","text":"旧稍新叶绿毵毵，四十分中已得三。\n刚道清阴犹未遍，径边时有客来参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47575,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题竹枝寿凤山司徒","author":"邵宝","text":"梅花道人写竹枝，湘江风动碧云时。\n一缄北为司徒寿，如向初筵歌菉猗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47576,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山僧惠灯诵昔人诗因次其韵","author":"邵宝","text":"静清深处许吾閒，朝看云来暮看还。\n泾上再歌倪老句，邵家亭子面西山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47577,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻管大夫祈晴之勤口占用致爱助","author":"邵宝","text":"却盖褰裳走雨中，风雷坛下露丹衷。\n病夫少亦叨民社，今日低头欲拜公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47578,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兰畹尤翁以苏巾为贶奉谢","author":"邵宝","text":"贻我苏巾果姓苏，畹翁亦本旧相呼。\n明朝戴我临泉水，更觉巾名似属吾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47579,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中与叶美春","author":"邵宝","text":"雨中客不到超然，留待中秋看月圆。\n一酌清泉数杯酒，古衣冠坐对青天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47580,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"僧歌","author":"邵宝","text":"山中来往几年年，侍有双僧不论禅。\n我句僧歌还击节，隔林风叶送流泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47581,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏梅花菊","author":"邵宝","text":"篱落秋芳本自华，色香况复似梅花。\n误将栗里先生馆，认作孤山处士家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47582,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠董道卿三绝 其一","author":"邵宝","text":"旧时品士亭前客，却到吴山独慰予。\n风月东湖佳兴在，一方青竹数行书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47583,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠董道卿三绝 其二","author":"邵宝","text":"校书几度入庐峰，题遍云泉石畔松。\n高座只今尘满壁，梦中犹忆讲时钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47584,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠董道卿三绝 其三","author":"邵宝","text":"迎养东西有老亲，鱼羹不负著书人。\n百年道眼风山老，留得门墙一脉春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47585,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中感事 其一","author":"邵宝","text":"羽人鍊将蔑忠贤，神道犹能四百年。\n到此术应随数尽，秪留清洌在山泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47586,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中感事 其二","author":"邵宝","text":"当时本藉忠贤重，却为忠贤觉厉诬。\n旧庙已空新庙静，睢阳回首隔江芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47587,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为勋侄题元人诗画","author":"邵宝","text":"前辈风流画里诗，六人异代不同时。\n清平一曲多春兴，只许金华太史知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47588,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈嘉猷赴朱氏馆","author":"邵宝","text":"五里湖南御史家，春星寒带草堂斜。\n太邱今在皋比席，日与诸生泳圣涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47589,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中看梅简如山襄甫 其一","author":"邵宝","text":"山中梅比城中早，却为春寒也较迟。\n多事邻僧添转语，梅迟应待老夫诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47590,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中看梅简如山襄甫 其二","author":"邵宝","text":"墙角疏花两树香，春风滋味已先尝。\n便教万树连山谷，不似冲寒意更长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47591,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中看梅简如山襄甫 其三","author":"邵宝","text":"观梅出郭看灯还，到处春风兴独关。\n不识沙翁偕石老，有无佳句及青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47592,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画","author":"邵宝","text":"凤凰不至几千秋，仪羽胡然在石头。\n笔底是真还是幻，定应清梦到西周。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47593,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留周文起宿斋中晓起","author":"邵宝","text":"有客宿宿春风中，吾将作传如仓公。\n蓉湖药室似董奉，一色杏花千树红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47594,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄司训","author":"邵宝","text":"春江渌净带晴烟，晓发苍梧万里船。\n酒尽长亭宾客散，有人极目楚南天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47595,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观沧浪吟卷","author":"邵宝","text":"沧浪吟卷三江话，助我论诗到日斜。\n逻卒屡过宾客静，不知门外有风沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47596,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与马天常留别","author":"邵宝","text":"汪伦送我不如君，君到严州路亦分。\n莫道桃花潭水浅，回头还薄富春云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47597,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月正四日至山中","author":"邵宝","text":"晓出城门望九峰，风光处处与人逢。\n不知雪后春多少，绣岭庭前看种松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47598,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与石泉","author":"邵宝","text":"我醉欲眠君且坐，君如倦坐亦归休。\n明朝有意抱琴至，歌我风梧满院秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47599,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陆中书宏道","author":"邵宝","text":"玉貌星瞳近侍臣，礼经读罢谒枫宸。\n苏州巷口宫詹馆，犹忆光风坐里春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47600,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"约吴丁二友登超然堂遇雨不果","author":"邵宝","text":"五更风雨阻游人，树杪重泉枉自新。\n最爱南塘两门客，晚年于我独情亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47601,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿知微子七十","author":"邵宝","text":"禅心僧腊共青山，几见游云去复还。\n纵是古希休便道，静中已透百年关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47602,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"索松枝于杨正甫口占代柬","author":"邵宝","text":"每看灯市搭松枝，清在灯光映月时。\n石埠年年挑不尽，今年刚得一篇诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47603,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次卢师陈感事一绝","author":"邵宝","text":"五月新堤筑未成，低田愁听桔槔声。\n只因多却黄梅雨，不是人间地不平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47604,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"问彭明府之疾","author":"邵宝","text":"两月无聊谢簿书，金茎露远渴相如。\n二泉病客尤疏懒，只有题缄为起居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47605,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画凤","author":"邵宝","text":"凤凰不见已多年，回首西康思杳然。\n珍重钱郎移竹意，庭前雨露是尧天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47606,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画蝶","author":"邵宝","text":"借得春风便作狂，不知梦里是蒙庄。\n世间更有痴人在，涂尽朱铅竟日忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47607,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得兰畹和章再用前韵","author":"邵宝","text":"画里巾曾见大苏，短檐高桶旧相呼。\n直须唤醒千年梦，赤壁舟中认故吾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47608,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画 其一","author":"邵宝","text":"半山台殿倚秋空，仙驭荒唐野树红。\n兴到孤舟更何处，天留高阁惠泉东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47609,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画 其二","author":"邵宝","text":"仙家楼阁海中桃，丽日晴云鹤羽高。\n正是圣明开寿域，八荒民物共甄陶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47610,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庐山览秀四咏 其一 慕莲","author":"邵宝","text":"匡庐北有莲花峰，濂翁曾此留行踪。\n请君试论爱莲说，今日看花同不同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47611,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庐山览秀四咏 其二 怀鹿","author":"邵宝","text":"曾与观山到此中，西来云影接南峰。\n千年洞在无眠鹿，却忆多情少鹤翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47612,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庐山览秀四咏 其三 瞻龙","author":"邵宝","text":"石如龙卧也谁瞒，道眼无从物外观。\n吊罢武侯云满涧，西郊却怪雨来难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47613,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庐山览秀四咏 其四 寻栗","author":"邵宝","text":"菊花似与寄奴仇，草外秋风傍古邮。\n下马不须歌旧曲，九原应重感行休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47614,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"米老拜石图","author":"邵宝","text":"伊人一拜石逾高，仆仆长勤笏与袍。\n我亦低头敬贞介，焚香时复向岩嶅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47615,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶闻书香","author":"邵宝","text":"少爱新书楮墨香，不辞书价借钱偿。\n坐来精舍还怀旧，海鹤诗中万卷堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47616,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鹅湖先生以閒居二绝见寄次韵奉答 其一","author":"邵宝","text":"黄阁归来鬓未华，一缄今与故人誇。\n叫岩东下江如练，犹忆维舟傍荻花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鹅湖先生以閒居二绝见寄次韵奉答 其二","author":"邵宝","text":"经纶收却不论功，楼阁新成碧倚空。\n读罢黄庭时策杖，还从野老赋鱼虫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬日山行与从者二僧 其一","author":"邵宝","text":"肩舆乘兴入山中，晴爱西风带北风。\n指点听松庵外路，冬青树老子初红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬日山行与从者二僧 其二","author":"邵宝","text":"游从俗客不如僧，此语吾闻识者曾。\n今日山中逢二子，袈裟风引路登登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陶节妇","author":"邵宝","text":"靖江千里建高牙，元是湖南老将家。\n一发千钧传寿地，祖姑贞节已褒嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"以蜜术问南沙","author":"邵宝","text":"医家白术重天台，郡守曾将蜜浸来。\n嚼罢不知香满室，桃花流水梦瑶台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中杂诗 其一","author":"邵宝","text":"一派泉分九窍流，地中窍窍尽通幽。\n行人到此肠堪断，不用松风满月楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中杂诗 其二","author":"邵宝","text":"八年月会七人同，山水之间一醉翁。\n就里园翁更奇绝，每留馀兴托恢公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋华十咏次如山 其一 木樨","author":"邵宝","text":"小山歌罢剩条柯，漫道香多色未多。\n千古广寒真赏在，满天风露夜如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋华十咏次如山 其二 鸡冠","author":"邵宝","text":"文装簇簇向晨稠，长送星光过孟陬。\n纵是无声报昏晓，也应有色纪春秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋华十咏次如山 其三 玉簪","author":"邵宝","text":"湘妃髻畔有遗琼，却傍秋风草上生。\n莫为投桃浪相报，贞心须待月华明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋华十咏次如山 其四 孩儿菊","author":"邵宝","text":"菊名非菊恨虚闻，中有幽香为解纷。\n采采秋风篱落畔，独嫌荒草欲教芸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋华十咏次如山 其五 锦灯","author":"邵宝","text":"翘翘楚楚复茸茸，每向无人觅处通。\n野客不知莲炬美，晓行刚爱锦为容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋华十咏次如山 其六 秋海棠","author":"邵宝","text":"离离秋草缀红芳，春睡初醒又晚妆。\n不是娇姿解愁绝，人间人自有柔肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋华十咏次如山 其七 黄葵","author":"邵宝","text":"花到秋葵浅着黄，有根还自保无伤。\n野人寸赤能如此，应托芹衷献上方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋华十咏次如山 其八 金钱","author":"邵宝","text":"子母钱成不用蚨，朝朝庭下见金夫。\n采来若也堪沽酒，道上人人醉欲扶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47632,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋华十咏次如山 其九 大蓼","author":"邵宝","text":"秋风梦逐楚江蘋，谁向阶前幻此身。\n最是九歌收不尽，年年相对怨骚人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47633,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋华十咏次如山 其十 雁来红","author":"邵宝","text":"中秋月下堕红云，濯濯清波锦有纹。\n刚道雁来颜色好，更堪江上日初曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47634,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书姚雪窗扇","author":"邵宝","text":"閒来何处独幽寻，窗对西峰雪正深。\n万卷三冬非浪语，今人心即古人心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47635,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠惠训术秋山","author":"邵宝","text":"甲子须臾信矣无，人间元亦有蓬壶。\n等閒悟得循环理，坐倚高松看海枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47636,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为顾西津题画","author":"邵宝","text":"太古小年山日长，幽人梦醒坐焚香。\n东津有客至未至，乱石滩头系野航。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古琴为外舅题","author":"邵宝","text":"流水高山不在琴，无声那得有知音。\n长松落落秋风里，吹尽凡缘剩此心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"海鹤辞","author":"邵宝","text":"尾闾泄兮终古，扶桑崦嵫兮晨复莫。\n望美人兮未徕，予周章兮四方上下。\n孰援斗兮酌桂浆，天路昧兮西风凉。\n罾何为兮木末，蛟何为兮山阳。\n彼凫雁兮膏粱，凤凰翼兮焱高翔。\n骐骥不秣于天厩兮，驽骀驰骋乎康庄。\n鹤为物兮仙灵，脱樊笼兮冥冥。\n泬寥兮海阔而天清，一声鸣兮彻紫青。\n应沆瀣兮未明，唤群鸡兮梦醒。\n谓鹤兮安处，时回顾兮寰宇。\n冀万一兮飞来伫，江涓兮愁予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"于烈妇辞","author":"邵宝","text":"贼来贼来，贼来辱我。\n辱我不可，不如杀我。\n我身有如玉，可杀不可辱。\n仓卒无所逃，一死万事足。\n君不见邻家有妇，忍辱随贼上马行，风尘历尽终无生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]