[{"title":"晚春三首 其二","author":"杨基","text":"宫树参差带苑墙，暖尘兼雾扑衣裳。\n新蒲细柳皆春色，紫燕黄莺欲断肠。\n沽酒客来花未落，祓除人去水犹香。\n老怀无复登临赏，坐对钟山到夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16226,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚春三首 其三","author":"杨基","text":"辛夷如雪照庭柯，老去愁惊日易过。\n芳草渐于歌馆密，落花偏向舞筵多。\n故人别后皆黄土，南浦春来又绿波。\n便欲移家勾曲住，采芝种玉此山阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16227,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寓江宁村居病起写怀十首 其一","author":"杨基","text":"落梅风急晚萧萧，病起愁惊雪尽消。\n卮酒不添前日量，带围初减旧时腰。\n高楼锦瑟花连屋，深巷珠帘柳映桥。\n准拟青鞋踏春草，看他翡翠戏兰苕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16228,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寓江宁村居病起写怀十首 其二","author":"杨基","text":"病体支离倦裹巾，偶因行乐见阳春。\n梅缘无恨寻常瘦，柳故多愁日夜颦。\n梦里笙歌随蒐袅，画中罗绮绣麒麟。\n相期欲就吴姬饮，却恐江花笑客贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16229,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寓江宁村居病起写怀十首 其三","author":"杨基","text":"性懒逢春睡转昏，晓莺多在梦中闻。\n故人锦字凭谁寄，学士银鱼每自焚。\n布谷雨晴宜种药，葡蒲水暖欲生芹。\n相思未信蓬山远，只隔江东一片云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16230,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寓江宁村居病起写怀十首 其四","author":"杨基","text":"望尽吴山是楚峰，一缄芳信托归鸿。\n丁香暗结盈盈露，豆蔻微含细细风。\n春水染衣鹦鹉绿，江花落酒杜鹃红。\n此身曾是登瀛客，未信扶桑弱水东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16231,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寓江宁村居病起写怀十首 其五","author":"杨基","text":"不知残雪是春光，起见轻云覆野塘。\n春草春江相妒绿，新莺新柳斗争黄。\n囊无太史新颁历，衣有容台旧赐香。\n但使清尊花底醉，任教白发镜中长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16232,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寓江宁村居病起写怀十首 其六","author":"杨基","text":"东风拂柳软婆娑，野鸟啼春听未和。\n世事不随人意好，雨声偏为客愁多。\n回文篆小香如蚁，凹面杯深酒胜鹅。\n一带春江皆碧草，却愁无地着渔蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16233,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寓江宁村居病起写怀十首 其七","author":"杨基","text":"醉舞狂歌四十年，老来参得一乘禅。\n东风未湿墙腰雪，细雨微添石眼泉。\n无数白鸥闲似我，一江春水碧于天。\n莫言笠泽非彭泽，定拟金川是辋川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16234,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寓江宁村居病起写怀十首 其八","author":"杨基","text":"坐对青山觉眼明，山应怜我眼偏青。\n一官不博三竿日，万事无过两鬓星。\n花底蛛丝迷蛱蝶，草根虾族变蜻蜓。\n文章无预封侯相，莫向人夸识一丁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16235,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寓江宁村居病起写怀十首 其十","author":"杨基","text":"门外春泥一尺深，窗间云气十分阴。\n寒毡溜雨衾如铁，湿灶凝烟火似金。\n酒解驱愁时强饮，诗多感旧懒长吟。\n贫家不愿千金粟，但得阳乌照晚林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16236,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新柳","author":"杨基","text":"浓如烟草淡如金，濯濯姿容袅袅阴。\n渐软已无憔悴色，未长先有别离心。\n风来东面知春浅，月到梢头觉夜深。\n惆怅吴宫千万树，乱鸦疏雨正沉沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16237,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江畔寻花偶成二首 其一","author":"杨基","text":"细草平沙暖更融，谩随蝴蝶步东风。\n衰髯照水疑添白，老眼看花觉厌红。\n且自细听莺宛宛，莫教深惜燕匆匆。\n江村到处皆春色，聊与行人吊客中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16238,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江畔寻花偶成二首 其二","author":"杨基","text":"偶随流水到花边，便觉心清似昔年。\n春色自来皆梦里，人生何必尽樽前。\n平原席上三千客，金谷园中百万钱。\n俯仰繁华竟陈迹，野花啼鸟谩留连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16239,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"用前韵书事","author":"杨基","text":"春来不到凤凰坡，辜负江头《白苎》歌。\n轻薄衣裳宜换夹，软红泥土不沾靴。\n莺缘梦短嗔啼早，雨为花疏厌听多。\n只恐新晴便零落，南风吹老树阴萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16240,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日白门写怀用高季迪韵五首 其一","author":"杨基","text":"得归虽喜未忘悲，梦里愁惊在别离。\n尚短柳如新折后，已残梅似半开时。\n江雷殷夜虫蛇早，山雨崇朝蛱蝶迟。\n制取乌纱笼白发，免教春色笑人衰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16241,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日白门写怀用高季迪韵五首 其二","author":"杨基","text":"柴门斜对曲江头，农具渔罾晚自收。\n细雨短莎寒似腊，淡烟新柳暝如秋。\n鸥能来往缘曾识，莺或丁宁解说愁。\n回首故交零落尽，更将诗酒与谁游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16242,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日白门写怀用高季迪韵五首 其三","author":"杨基","text":"绿发无多白发长，谪居还复是他乡。\n风纫晚佩猗兰弱，雨滴春蔬早韭香。\n碧柳五株千本菊，黄牛十角一群羊。\n得闲随地为农好，不独长安与洛阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16243,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日白门写怀用高季迪韵五首 其四","author":"杨基","text":"远归偏惜窜余身，多难番为异姓亲。\n前度刘郎非故物，当时燕子总西邻。\n家贫母老难为客，酒薄愁深不醉人。\n走向津头看春色，绿波芳草却伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16244,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日白门写怀用高季迪韵五首 其五","author":"杨基","text":"绿芜迷渚水漫沙，断岸无舟路转赊。\n细柳已黄千万缕，小桃初白两三花。\n烟中晚棹兼沤远，雨里春旗趁屋斜。\n野趣莫嫌浑寂寞，近来沙觜有人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16245,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春暮有感二首 其一","author":"杨基","text":"春色鲜明不称贫，越罗川锦照乌巾。\n斜阳芳草迟迟晚，流水桃花去去春。\n万里归心沤送客，片时闲梦鸟催人。\n五湖风雨烟波阔，便着青蓑采白绩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16246,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春暮有感二首 其二","author":"杨基","text":"啼鸟匆匆变物华，雨池科蚪渐成蛙。\n青鞋谩踏闲边草，白发羞簪醉里花。\n此日骅骝思苜蓿，当时鹦鹉唤琵琶。\n遥怜箫鼓追游地，荠麦青青已没鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16247,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渐老","author":"杨基","text":"渐老无营万虑沈，莺声唤起向来心。\n春风颠似唐张旭，天气和如鲁展禽。\n结客每酬双白璧，缠头曾费万黄金。\n短筇消得江村路，步步蔷薇绿树阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16248,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答李仲弘写怀次韵","author":"杨基","text":"休对清江叹逝波，且抛簪佩著渔蓑。\n愁边卮酒欢娱少，老后文章感慨多。\n燕子绿芜三月雨，杏花春水一群鹅。\n聊将白发归来意，总和东风懊恨歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16249,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄张学录孟兼揭应奉孟同二文学","author":"杨基","text":"何用聪明万卷书，自须卑陋一廛居。\n草于闲处生偏密，花到春深看渐疏。\n绿水满渠浇药后，青山无数卷帘初。\n相过莫道柴门窄，细柳高槐可荫车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16250,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中独坐有怀荥阳道中用寄潜斋夜坐韵","author":"杨基","text":"山色秋光澹绕斋，雨声虫响互悲哀。\n清尊怜我攻愁去，白发欺人送老来。\n江柳净无余叶在，渚莲迟有一花开。\n马蹄却忆成皋路，野烧西风满面埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16251,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早秋江墅晚步","author":"杨基","text":"秋前秋后十日雨，村北村南千顷麻。\n晚渚芙蓉轻落片，午前粳稻细含花。\n仙翁蜡屐高巾帻，溪女银钗小髻髽。\n老我不知官府事，水边吟到日西斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16252,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梅杏桃李 其一 梅花","author":"杨基","text":"落莫香魂绕旧宫，讵知色相本来空。\n笛声黄鹤高楼上，诗句孤山小店中。\n晓树烟霜千万点，晚篱松竹两三丛。\n相思只尺凭谁寄，目断天南字字鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16253,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梅杏桃李 其二 杏花","author":"杨基","text":"当时庭馆醉春风，客里相逢意转浓。\n只恐胭脂吹渐白，最怜春水照能红。\n一枝争买珠帘外，千树遥看小店中。\n惆怅先生归去后，江南烟雨又蒙蒙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16254,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梅杏桃李 其三 桃花","author":"杨基","text":"深深翠竹映婵娟，湘女梳妆立晓烟。\n流水落花成怅望，舞裙歌袖是因缘。\n也无人折休相妒，才有莺啼更可怜。\n却忆东阑碧千叶，暖风香雨为谁妍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16255,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梅杏桃李 其四 李花","author":"杨基","text":"忆与卢仝共看来，花光月色两徘徊。\n江村远处长相识，风雨寒时已早开。\n霁雪玲珑愁易湿，春冰轻薄笑难裁。\n江城二月城西路，谁惜柔香满翠苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16256,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄诸葛同知彦飞","author":"杨基","text":"白发慵梳步屟迟，老于田野最相宜。\n每当酒熟花开日，正值身闲客到时。\n雪屋夜灯因妇织，月波秋舫为僧移。\n而今此乐同谁说，只有乡人马远知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16257,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭高季迪旧知","author":"杨基","text":"鹦鹉才高竟殒身，思君别我愈伤神。\n每怜四海无知己，顿觉中年少故人。\n祀托友生香稻糈，魂归丘陇杜鹃春。\n文章穹壤成何用，哽咽东风泪满巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16258,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"豫章早春","author":"杨基","text":"茸茸草色变枯荄，簌簌寒梅落径苔。\n山顶雪惟朝北在，水边风已自东来。\n不须银管催莺出，便好珠帘为燕开。\n见说岭南春更早，桃花流水胜天台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16259,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浦口逢春忆禁苑旧游","author":"杨基","text":"春冰消尽草生齐，细雨香融紫陌泥。\n花里小楼双燕入，柳边深巷一莺啼。\n坐临南浦弹流水，步逐东风唱大堤。\n还忆当年看花伴，锦衣骢马玉门西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16260,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"省垣对雨有怀方员外","author":"杨基","text":"煮得新醅滟滟红，省垣谁与晚樽同。\n人当暂别情偏恶，诗到无聊语更工。\n江浦荷花双鹭雨，驿亭杨柳一蝉风。\n论文若到虞杨地，应对清江忆范公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16261,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"立秋日怀方员外","author":"杨基","text":"几日西清昼掩屏，绿尘幽藓遍闲厅。\n病中事少翻嫌健，醉里愁多只愿醒。\n误响閤铃飞夜鹊，偶摊书卷落秋萤。\n萍踪已办东南别，风雨长更各自听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16262,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"七月三十日祖母初度时年八十九","author":"杨基","text":"白发青瞳寿者身，每逢佳节话咸淳。\n百年未尽四千日，来岁还周九十春。\n迁客无家空望拜，孤臣有表竟谁陈。\n今朝风雨茅茨底，应对儿孙说远人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16263,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谒小姑庙","author":"杨基","text":"月帔星冠敞翠屏，白腮红颊两眉青。\n鱼鳞小殿波纹滑，龙尾长旗雨气腥。\n巫女沉牛歌宛转，彭郎回马拜娉婷。\n兰舟愿祝东风便，一夜夷犹过洞庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16264,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚泊湓浦逢冷节","author":"杨基","text":"小雨笼阴护晚霞，柳边停棹听啼鸦。\n湖光已绿皆春草，风信犹寒是杏花。\n到处青鞋随蛱蝶，谁家红袖泣琵琶。\n匆匆客里逢佳节，那得行人鬓不华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16265,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟中闻邻船吴歌有怀幼文来仪","author":"杨基","text":"轻帆短楫溯烟波，叠渚回舟奈远何。\n一路诗从愁里得，二分春向客中过。\n江通汉水晴偏绿，山入湘云晚更多。\n何处思君肠欲断，楚妃祠下听吴歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16266,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"途次感秋","author":"杨基","text":"袅袅西风吹逝波，冥冥灏气逼星河。\n宣王石鼓青苔涩，武帝金盘白露多。\n八阵云开屯虎豹，三江潮落见鼋鼍。\n沅湘一带皆秋草，欲采芙蓉奈晚何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16267,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"祁阳道中见海棠","author":"杨基","text":"桂阳江口望祁阳，叠叠烟云入渺茫。\n高树绿阴千嶂湿，野棠疏雨一篱香。\n纵无春在犹回首，况有鹃啼合断肠。\n惆怅东湖堤上柳，暖风轻絮正悠扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16268,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"客中寒食有感","author":"杨基","text":"减衣时节尚寒天，暂倚东风泊画船。\n十里楼台仍细雨，五侯池馆又新烟。\n且簪杨柳酬佳节，莫对桃花忆去年。\n总是无情也肠断，鹧鸪声里又啼鹃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16269,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"桂林即兴","author":"杨基","text":"曾见重华巡狩来，漓江庙宇野棠开。\n山无桧柏皆岩穴，地有芝苓尽药材。\n花布短衣齐膝制，竹皮长帽覆眉裁。\n也应风土交州近，丹荔红椒不用栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16270,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟次邵白有怀徐幼文","author":"杨基","text":"文章小技耻雕虫，也逐群才赴洛中。\n多病不宜秋色里，相思只在暮江东。\n鸡豚篱落茅茨雨，凫鸭陂塘菡萏风。\n欲买一樽浇寂寞，伤心不与故人同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16271,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清明怀故园","author":"杨基","text":"缕缕轻烟细细风，秋千池馆万家同。\n高低草色相参绿，深浅桃花各自红。\n人意尽随流水去，风光都在笑声中。\n多情白发并州客，坐对西南雪满峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16272,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日山西寄王允原知司（五首。并序） 其一","author":"杨基","text":"十里烟光湿翠苕，二分春色到花朝。\n无人快击华奴鼓，有伴同吹弄玉箫。\n遍地锦围歌处席，满身珠压舞时腰。\n莫嗔老子疏狂甚，曾醉扬州廿四桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16273,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日山西寄王允原知司（五首。并序） 其二","author":"杨基","text":"药苗初茁水生荭，老麝收香鹿养茸。\n二月春光才霁雪，一番花信又颠风。\n参差鹦鹉全身白，浅淡棠梨半面红。\n正是江南寒食近，满帘飞絮雨蒙蒙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16274,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日山西寄王允原知司（五首。并序） 其三","author":"杨基","text":"画船摇桨荡晴波，步障围风踏软莎。\n箫鼓队冲黄鸟散，绮罗人比白鸥多。\n不知酒与愁成敌，长恨花为病作魔。\n回首六桥青草遍，水光山色近如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16275,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日山西寄王允原知司（五首。并序） 其四","author":"杨基","text":"花时无处不黄鹂，偏到垂杨着意啼。\n人立晚风携便面，马临春水惜障泥。\n踏歌趁拍催腔急，旋舞回身应节齐。\n遥想故山行乐地，紫苔侵遍十年题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16276,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日山西寄王允原知司（五首。并序） 其五","author":"杨基","text":"一茎白发已堪嗟，况是东风两鬓华。\n醉里误将裙作纸，老来羞以帽簪花。\n疏狂不识眉双结，敏捷曾经手八叉。\n闲喜日长公馆静，自分新火试新茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16277,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题和唐李义山商隐 其二","author":"杨基","text":"才向瑶台觅旧踪，曙鸦啼断景阳钟。\n薄施朱粉妆偏媚，倒插花枝态更浓。\n立近晚风迷蛱蝶，坐临秋水乱芙蓉。\n多情莫恨蓬山远，只隔珠帘抵万重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16278,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题和唐李义山商隐 其三","author":"杨基","text":"细骨轻躯不耐风，春来帘幕怕朝东。\n人间玉宇三山隔，天上银河一水通。\n眉晕浅颦横晓绿，脸销残缬腻春红。\n冰弦莫奏清商曲，满地霜华泣翠蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16279,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题和唐李义山商隐 其四","author":"杨基","text":"夜合花边待月来，宫中郤辘响春雷。\n笙调恨谱参差度，锦织愁纹宛转回。\n楼上绿珠知报主，座中红拂解怜才。\n伤心两炬绯罗烛，吹作银荷叶下灰。\n为雨为云事两难，蕙心兰质易摧残。\n筝移锦柱秋先断，漏滴铜壶夜不干。\n罗幕有香莺梦暖，绮窗无月雁声寒。\n芙蓉一树金塘外，只有芳卿独自看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16280,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长沙杂咏三首 其一","author":"杨基","text":"花深众禽寂，格格啼山鹧。\n桡响一灯来，人归碧湘夜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16281,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长沙杂咏三首 其二","author":"杨基","text":"筠屿烟长碧，兰坡水自香。\n只宜行画里，忘却在潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16282,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长沙杂咏三首 其三","author":"杨基","text":"湘人爱楼居，斜枕湘江起。\n楼下倚阑人，簪花照春水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16283,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠京妓宜时秀","author":"杨基","text":"欲唱清歌却掩襟，晚风亭子落花深。\n坐中年少休轻听，此曲先皇有赐金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16284,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆挹翠亭听歌示徐幼文余唐卿","author":"杨基","text":"清歌一曲动梁尘，只忆当时泪满巾。\n何况春归花落尽，眼前漂泊两三人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16285,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梦故人高季迪二首 其一","author":"杨基","text":"诗社当年共颉颃，我才惭不似君长。\n可应句好无人识，梦里相寻与较量。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16286,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梦故人高季迪二首 其二","author":"杨基","text":"惊人新句叹无前，故态疏狂似少年。\n便写锦囊三百首，为君披咏步凉天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16287,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟泊南湖有怀二首 其一","author":"杨基","text":"纱衣罗扇一时裁，两两三三作伴来。\n正是吴中好风景，范家园里杏花开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16288,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟泊南湖有怀二首 其二","author":"杨基","text":"单罗小扇夹纱衣，冠子梳头插翠薇。\n知是范家园里醉，无人不戴杏花归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16289,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]