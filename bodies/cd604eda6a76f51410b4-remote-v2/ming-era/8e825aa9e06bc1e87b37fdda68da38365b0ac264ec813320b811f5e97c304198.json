[{"title":"用前韵二首与宣溪 其一","author":"程敏政","text":"选胜同来窃供茶，晤言终日愧投瓜。\n幽人泉上堪刳竹，短簿祠前访种花。\n山犬不惊随鹤氅，野僧如悔认星槎。\n老天故尔供吟啸，容我登临直到家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46856,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"用前韵二首与宣溪 其二","author":"程敏政","text":"重揖山灵欲酹茶，秋风今熟几回瓜。\n题名石裂攒金薤，殉剑池深冷铁花。\n诗垒众降新立帜，酒船如泊小浮槎。\n烦君并作南游录，乞与儿孙记两家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46857,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"简沈石田启南求画","author":"程敏政","text":"孤舟摇荡出风涛，涉水登山也自劳。\n乞取生绡图四景，卧游容我醉松醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46858,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与杨君谦仪曹刘振之鸿胪游灵岩遇雨 其一","author":"程敏政","text":"夹岸吴山扫黛青，酒船随意泊沙汀。\n帘收晚雨三家市，旗飏薰风十里亭。\n沪渎旧名馀战地，灵岩佳迹播图经。\n同来莫遣游情败，僧榻何妨一夜停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46859,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与杨君谦仪曹刘振之鸿胪游灵岩遇雨 其二","author":"程敏政","text":"冒险乘舆度岭腰，石苔青遍雨萧萧。\n野人笑我游何健，客子凭谁酒易消。\n鸟外云深唯见塔，鸥边溪涨欲平桥。\n望中似觉山容喜，知有新篇慰寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46860,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与杨君谦仪曹刘振之鸿胪游灵岩遇雨 其三","author":"程敏政","text":"细雨斜风破赏缘，壮游奇兴独森然。\n采香径古云千壑，响屧廊空草一川。\n羁客坐贪船似屋，主人情惬酒如泉。\n溪山灯火论心地，不道相违是隔年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46861,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菌生船窗下作","author":"程敏政","text":"老舫经残雨，俄生一菌长。\n根连枯蘖润，色藉朵云黄。\n稚子能加护，灵苗或异常。\n题诗矜畀尔，击节和鸣榔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46862,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚登姑苏驿楼与瞿刚贡士小酌有感","author":"程敏政","text":"蹑屐重登昭赐楼，吴粳今是八回秋。\n驿夫迎舫惊生客，稚子循廊感旧游。\n塔影带云横树杪，鹊声和雨下城头。\n晚凉不尽裴?意，一饭匆匆已放舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46863,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"留别蒋长洲克明 其一 篁墩","author":"程敏政","text":"念子天涯久谪官，已看新命出金銮。\n牛刀小试真言偃，鸥社重寻愧谢安。\n旧雨故人频对酒，青霄客路正弹冠。\n明朝又作胥门别，浦树江云两地看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46864,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"留别蒋长洲克明 其二 宣溪","author":"程敏政","text":"故人重会阖闾城，十日难禁去住情。\n沙上暂维青雀舫，尊前初试紫莼羹。\n汉廷公议还须定，蜀道当时已惯行。\n不日山林闻邸报，路人应说介推名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46865,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三辰堂为工部顾郎中从善赋","author":"程敏政","text":"衣冠三叶重吴人，捷报相承似罕伦。\n金榜有名初中甲，青阳无岁不逢辰。\n韦编业在专门久，华扁题成杰构新。\n定见奇男光父祖，考工才力正当春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46866,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"姚生广好篆籀之学所居在桃花坞上予与宣溪过之欣然为刻数印既而予宴南壕杨氏池馆生复来赠一印其意甚勤因赋一绝赠之","author":"程敏政","text":"一坞桃花映草堂，个中清致属姚郎。\n可人更到池亭上，赠我归田学士章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46867,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与宣溪联句别振之","author":"程敏政","text":"黄冈泾口夜停船，草草行厨当别筵。\n吴苑已离三舍外，阊门犹在一杯前。\n离人意逐江亭远，好事诗随海舶传。\n明岁期君南入楚，溪山同足赏心缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46868,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴江驿得司马通伯侍御书","author":"程敏政","text":"小住虹桥下，翩然得素书。\n麈谈如见子，笔阵久降予。\n山雨朝酲后，江花晚眺馀。\n鉴湖真有约，归日办篮舆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46869,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄湖州王太守","author":"程敏政","text":"故人相望隔吴兴，画舫青帘见未能。\n幸我身随莲社老，喜君名自柏台升。\n清朝事业群英在，前辈风流百感增。\n客里有诗凭递入，苕溪新水绿层层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46870,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"端午日与致政于景瞻京兆同至孤山","author":"程敏政","text":"七年重憩孤山麓，一浣湖光净客衣。\n自喜舟中佳节至，谁言林下故人稀。\n暗香疏影新篇少，白石苍松旧冢非。\n更遣移尊六桥外，野鸥相见已忘机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46871,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"自岳王坟至净慈寺","author":"程敏政","text":"栖霞山色照湖东，五日还当逆旅中。\n角黍谩馀骚客恨，南枝犹寄岳王忠。\n夕阳燕影随舟远，别浦烟霏入座空。\n节序催人仍吊古，一尊同趁藕花风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46872,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖上待刘邦彦不至","author":"程敏政","text":"当时曾觅卧游篇，今日重来更惘然。\n绿芰晚风频唤酒，白沤新水漫停船。\n谁能向子封佳社，独可寻僧结净缘。\n明发又从严濑去，潮声空落暮江边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46873,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宾客楼为三山陈文用侍御追赋","author":"程敏政","text":"一楼高起面㠝岏，时肃烟云入座看。\n客礼未能相尔汝，人情那复较炎寒。\n岚飞近槛真成画，秀落疏棂似可餐。\n佳胜不妨长作主，古灵家世旧衣冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46874,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与张朝用太守饮紫阳庵晚至三茅观","author":"程敏政","text":"山上危亭四望空，不知真境落尘中。\n羽衣化鹤留仙骨，月斧穿云试鬼工。\n天狗堕馀悬石坠，金牛开出断崖通。\n酒酣更上三茅阁，万里潮翻夕照红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46875,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮定惠寺次旧韵调邦彦","author":"程敏政","text":"石梯绕涧松风香，山楼入空花雨凉。\n醒心渴恨蔗浆少，题句醉怜蕉叶长。\n古人几何开白社，灵泉一脉来朱方。\n倚阑笑问刘禹锡，禅味而今谁共尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46876,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"虎跑泉和宣溪韵","author":"程敏政","text":"于菟犹踞薜萝屏，须识名泉本地灵。\n调水可怜人更癖，濯缨谁遣梦初醒。\n魏公字簇山花艳，苏老诗镵石藓青。\n泡影果缘僧咒起，欲将真伪勘图经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46877,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"为宣溪题菊留别维扬高宪副","author":"程敏政","text":"潭水亭亭照影空，几番花木斗青红。\n相看只有霜春面，独立西风蔓草中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46878,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宣溪先出至江口有见怀之作时予尚留杭城依韵奉酬","author":"程敏政","text":"疏帘风逗葛衣凉，此夜归心共渺茫。\n去住偶然分客邸，笑谈犹似隔邻墙。\n江回白塔潮头小，节到黄梅雨脚长。\n明日蓝舆聊志喜，鸟声山色近吾乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46879,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"涵碧亭八咏 其一 文峰贡翠","author":"程敏政","text":"池上一峰孤，下瞰池亭小。\n书空兆人文，卓笔青未了。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46880,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"涵碧亭八咏 其二 石鼓浮岚","author":"程敏政","text":"小山本幽绝，晴岚湿衣裾。\n谁能琢崖藓，正作岐阳书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46881,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"涵碧亭八咏 其三 潮阁晨钟","author":"程敏政","text":"隐隐青莲居，鲸音断复续。\n幽人惊起迟，林光动朝旭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46882,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"涵碧亭八咏 其四 义溪夜笛","author":"程敏政","text":"何人弄长笛，散此柯亭秋。\n令我发奇思，风吹月波浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46883,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"涵碧亭八咏 其五 荷塘晓色","author":"程敏政","text":"池亭踏露入，冉冉闻幽香。\n方塘水如镜，照见芙蓉妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46884,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"涵碧亭八咏 其六 松径秋声","author":"程敏政","text":"四山黄落时，夹路松涛起。\n中含太古声，能清管弦耳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46885,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"涵碧亭八咏 其七 夕照鸢飞","author":"程敏政","text":"斜阳过亭西，纵目随所适。\n何处一鸢来，飞飞破晴碧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46886,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"涵碧亭八咏 其八 晴渊鱼跃","author":"程敏政","text":"白日下深沼，游鳞动腥风。\n宛有川上趣，不羡濠梁翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46887,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"姚贡士时举及其弟中书吉甫送予与宣溪至钓台下联句为别","author":"程敏政","text":"一尊相饯上桐江，客思撩人未易降。\n斜日挂帆风欲正，断崖停橹浪犹撞。\n通家义重金兰契，逸兴歌惭白雪腔。\n钟鼎山林须努力，可堪分袂隔船窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46888,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"提学宪副东园郑君廷纲置酒富春驿亭叙旧得联句三首 其一","author":"程敏政","text":"山雨初收暑气清，驿亭开宴叙离情。\n香刍未出心先醉，新茗才倾句已成。\n坐倚画阑窥净绿，笑停乌榜忘严程。\n人生聚散浑如梦，赢得重温白社盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46889,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"提学宪副东园郑君廷纲置酒富春驿亭叙旧得联句三首 其二","author":"程敏政","text":"睦州城下偶逢君，把酒相看日未曛。\n茅屋几间山寺外，兰舟一棹石堤垠。\n已知学教遵安定，久羡才名赛右军。\n明日江亭愁遽别，几声长笛不堪闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46890,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"提学宪副东园郑君廷纲置酒富春驿亭叙旧得联句三首 其三","author":"程敏政","text":"讲筵同及事先皇，谪下西湖两鬓霜。\n潦倒一尊仍话别，联翩孤榻此追凉。\n江声树色催诗急，竹笋溪鱼入馔香。\n握手严陵山下路，谁知身世在他乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46891,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与东园宣溪濒江夜坐联句六韵","author":"程敏政","text":"坐久江干月渐明，山城谯鼓报初更。\n边流官树参差影，隔岸渔舟欸乃声。\n客路屡惊时序改，诗坛长助梦魂清。\n汀芦水鸟栖初定，野草青蛙断复鸣。\n洗盏不妨更夜酌，听鸡无奈促晨征。\n独怜远浦寒潮上，不管寻常去住情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46892,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀邵文敬太守","author":"程敏政","text":"有美文章守，无情山水州。\n一宵篷上雨，了得半江愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46893,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"得萧文明衢州书","author":"程敏政","text":"喜君得内徙，身已到三衢。\n暂免尘埋足，遥闻雪上须。\n烟云供草圣，岩壑助诗腴。\n幸尔双鳞便，长应尺素俱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46894,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东园复请游天宁寺席上联句","author":"程敏政","text":"石径盘回万木中，寺门惟许白云通。\n参差楼阁烟霞古，晻映溪山户牖空。\n坐久塔铃还自语，诗豪床笔喜相同。\n兴来隔渡频呼酒，醉里看花更徙筇。\n啼鸟数声檐外树，归帆一叶雨边风。\n茶瓜留客全忘暑，泉石娱人正未穷。\n地迥百年初胜赏，僧忙半日总群公。\n飘蓬湖海怜双鬓，结草田园方寸衷。\n欲就佛龛灯下宿，萍踪那复计西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46895,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山寺听雨限韵联句","author":"程敏政","text":"寻幽过野寺，烟树迷蓝舆。\n忽惊新雨至，坐遣羁怀舒。\n因之洗烦燠，起听风檐虚。\n枕边气萧爽，为我清尘裾。\n岩花惊夜落，径草思春锄。\n跳珠卷荷净，鸣漏穿棚馀。\n寒声度纱幌，入竹还徐徐。\n林鸠苦未足，秧马今何如。\n连床续旧约，岂似古城疏。\n挑灯欲忘寐，离思谁怜渠。\n渔舟趁潮远，衲子收帘初。\n深杯一志喜，载摘园中蔬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46896,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东园口诵山色雨声一联且约为武夷之行随足成之","author":"程敏政","text":"几载各西东，相逢一醉同。\n客程山色外，离思雨声中。\n白社寻常句，苍头四十翁。\n停云知有意，江上候南鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46897,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"近得陆少卿鼎仪之讣慨念不能已因联句哭之","author":"程敏政","text":"客路遥传昆玉摧，临风挥涕不胜哀。\n西清往事成陈迹，东观遗编忆俊才。\n古木斜阳山色暮，断桥残雨野潮回。\n今宵定有怀人梦，都向山阳笛里来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46898,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"严州城下与宣溪别","author":"程敏政","text":"灯大联舟数十程，客边分袂不胜情。\n孤身去国同将母，两世通家沗作兄。\n多病正堪归计早，不才深负主知明。\n青山白水渔樵路，长报平安慰此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46899,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"用韵别宣溪弟待魁世选","author":"程敏政","text":"江派分流作两程，离愁无奈水无情。\n推篷几阅閒风雨，落笔真怜好弟兄。\n镜里年华青鬓改，社中心事白鸥明。\n凤毛麟角宁终困，努力相期在后生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46900,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"未至茶原梅水横发块坐三日","author":"程敏政","text":"几日黄梅雨，平吞绿树湾。\n犬惊船上屋，蛟纵水沉山。\n两屐难乘兴，三杯暂破颜。\n人生亦堪笑，咫尺是乡关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46901,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"留别淳安刘尹仲和兼呈大司空胡公大参应公诸乡旧","author":"程敏政","text":"淳安曾是歙东乡，地主相留合尽觞。\n梅雨势添溪涨恶，竹禽声助野歌长。\n坐惭师席亲元老，语及名途笑漫郎。\n他日重来订乡约，一廛容我寄渔榔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46902,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"商茂霖主事请饮魁星楼喜晴","author":"程敏政","text":"危楼高出孔墙东，星彩常拖万丈虹。\n圣化喜沾三日雨，客谈真动四筵风。\n人听弦诵如尘外，天与江山入画中。\n无限诗情惭句拙，晚鸦遥点夕阳红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46903,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"应文贞典宝有葡萄便面檀香为骨意甚爱之因赋一绝","author":"程敏政","text":"马乳累累紫蔓长，折枝疑带露华凉。\n等閒入手微风起，并作栴檀一味香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46904,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题宗侄孙文楷文模二便面 其一 圯桥进履","author":"程敏政","text":"莫谓老人倨，须知孺子贤。\n坑焚祸方烈，谁有素书传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46905,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题宗侄孙文楷文模二便面 其二 花鸟","author":"程敏政","text":"绕阑花似雪，枝上立珍禽。\n入手炎光散，清风动竹林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46906,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"教谕许君置酒藏书阁有怀融堂钱先生","author":"程敏政","text":"登高元不为伤离，雨后溪山一倍奇。\n野寺晴岚随画出，石林残照与诗宜。\n醉呼豆荚供新茗，閒扫苔花读旧碑。\n前辈风流谁复在，百年融老是吾师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46907,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"小金山","author":"程敏政","text":"千尺波心得异观，水云中锁碧㠝岏。\n蛟龙宅近蟠根久，鹳鹤巢危堕影寒。\n白社可能专佛印，红尘曾不了渔竿。\n他时浮玉论形胜，拟酹山灵说二难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46908,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"淳安黄训导禄养堂 其一","author":"程敏政","text":"旋开新酒摘园蔬，日日升堂候起居。\n堂上老人相顾喜，等閒知是笔耕馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46909,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"淳安黄训导禄养堂 其二","author":"程敏政","text":"菽水能供一日欢，霜毛甘共一毡寒。\n他时更享三牲养，莫忘清溪旧讲坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46910,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"己酉六月二日初至南山 其一","author":"程敏政","text":"决决溪流浅带村，层层山色翠当门。\n水边林下青莎地，今日重来试屐痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46911,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"己酉六月二日初至南山 其二","author":"程敏政","text":"六月凉生白苧袍，不知人世畏途劳。\n自惊何福堪消此，一路松风响翠涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46912,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南山杂兴 其一","author":"程敏政","text":"暑雨初晴散发眠，数声山犬吠篱边。\n农夫乘月来耕地，人影萧萧动石田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46913,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南山杂兴 其二","author":"程敏政","text":"杖藜贪看野花开，踏尽松阴一径苔。\n风外忽闻真管籥，滩声时杂树声来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46914,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"邵节妇朱氏","author":"程敏政","text":"半壁寒灯照苦辛，白头甘作未亡人。\n几家文献存孤子，一脉纲常系此身。\n雪后松筠真耐晚，风前桃李漫争春。\n登堂细阅丹青卷，击节还思板荡臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46915,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"踏车行","author":"程敏政","text":"田夫踏车如踏弩，田妇踏车心更苦。\n老天不雨将奈何，稻陇看看作焦土。\n我行见此三叹息，欲助农忙恨无力。\n假令一旱似往年，岂独忧贫复忧贼。\n我虽七尺金紫身，圣恩许作归耕人。\n诗书不了糊口计，与尔将来同苦辛。\n击鼓扬旗祷神福，且莫先忧食无粥。\n贤侯恤民天所怜，好雨时来岁还熟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46916,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜雨柬张令君","author":"程敏政","text":"稻陇尘飞早日红，不堪秋事渐成空。\n好风忽送千山雨，戾气全收百丈虹。\n父老欢声随地起，令君诚意与天通。\n他年欲续循良传，野史先书第一功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46917,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"亚卿知郡似公特书具舆马见招晚行石岭道中作","author":"程敏政","text":"香山中断路逶迤，秋色偏于客兴宜。\n红树乌犍归别陇，败萍花鸭点清池。\n镜中老壮谁相约，林下忙閒我自持。\n村巷莫惊连夜发，几人鸡黍是真期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46918,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"亚卿知郡似公提刑判府沈公邀仆与康亚卿饮席上作","author":"程敏政","text":"百雉山城两谪居，一尊相属晚秋馀。\n侵人白发凭多少，阅世浮云自卷舒。\n林下正容吾辈拙，天涯谁说故人疏。\n遥闻圣主覃恩诏，拟逐田翁款使车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46919,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]