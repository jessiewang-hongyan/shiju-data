[{"title":"送袭封衍圣公孔希学还阙里","author":"贝琼","text":"星斗光芒万丈腾，赐书连舸出金陵。\n雁违青冢天将雪，马度黄河夜已冰。\n博士经存终汉出，上公爵重自唐升。\n喜闻手植庭中桧，翠接东蒙几百层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送愚上人归越中并木奎方舟长老","author":"贝琼","text":"天界归来亦已迟，庭松此日定回枝。\n山中结社无灵运，海上留衣有退之。\n鹤去云霄随锡杖，龙收风雨入军持。\n西湖若见方舟老，为说三生梦里诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观海与鲍仲孚同赋","author":"贝琼","text":"弱水之外有蓬莱，云中髣髴金银台。\n终驱汎滥群流合，始与鸿濛一气开。\n石壁三更看日上，星槎八月到天回。\n麻姑何处窥清浅，近日无书寄鹤来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送户部尚书贡泰甫开司闽中榷盐易米给京师 其一","author":"贝琼","text":"昨日除书下五门，地兼中外亦殊恩。\n三山迥出南荒小，八座元同北斗尊。\n悟主已知如内相，封侯终见自公孙。\n荆扬乐土今凋擦，他日从客为一言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送户部尚书贡泰甫开司闽中榷盐易米给京师 其二","author":"贝琼","text":"两隅未挣出师频，圣主经营伏老臣。\n天河转粟遥通蓟，腊月看花近到闽。\n道上豺狼应避马，山中猿马不惊人。\n公馀定有诗千首，好托边鸿寄蚤春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐太章白鹤山居","author":"贝琼","text":"孤烟一曲紫云村，好客寻常远到门。\n水落已知鱼可笱，夜深不畏虎夔藩。\n邻人送酒酌花下，稚子读书当树根。\n白鹤千年时过上，屯中还有令威孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月晦日","author":"贝琼","text":"王师未下姑苏台，客子野次独徘徊。\n城南酒徒不复见，院里桃花空乱开。\n儿女新年俱已长，弟兄何日却同回。\n故人重里寄书至，相约山中拂紫苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄内弟陆熙之","author":"贝琼","text":"我别禦儿溪上宅，月当二十四回新。\n如何故国尚戎马，即恐比邻非昔人。\n箫鼓谁家犹作社，楼台废苑不成春。\n夜寒忆尔无由见，怅望黄姑祈木津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄潘时雍","author":"贝琼","text":"潘岳闲居学灌园，一椽茅屋近青门。\n野乌得食频将子，慈竹团阴定长孙。\n宾客过门车盖合，儿童汲井辘轳喧。\n春风金谷空流水，且共高歌醉瓦盆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送翁镇方归天台","author":"贝琼","text":"云气空蒙是赤城，高歌归去不胜情。\n天倾沧海东南迥，地接丹丘日夜明。\n念我好将黄独寄，知君先向石桥行。\n春风一路啼莺巧，定有花间窈窕迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题云溪耕隐","author":"贝琼","text":"屋外青山青似莲，云溪隐者即神仙。\n桑麻杜曲非无地，鸡犬桃源别有天。\n载酒邻翁时叩户，卖鱼溪女不论钱。\n卧龙何事烦三顾，祗合隆中老岁年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题丁成之清樾轩","author":"贝琼","text":"九龙山前处士宅，草堂低小尽青苔。\n树阴满地日不到，水气著人秋已回。\n无数黄鹂相对语，有时翠碧忽飞来。\n移床与客竹间坐，千里好风何快哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郑宪卿省郎织毯松江还诗以送之","author":"贝琼","text":"鹤城翠织出天机，卷付星查使者归。\n瑞草奇花春欲动，彩鸾青鹤昼交飞。\n峒人不用誇山罽，朝士何须惜地衣。\n闻说千秋佳节近，吴宫高会更光辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云间见李克敏将归吴陵作诗为别","author":"贝琼","text":"与子西东二十霜，尚思年少醉钱唐。\n人间日月如行客，马首山川忽异方。\n历历早莺初变语，翩翩归雁未成行。\n明朝陌上重分袂，更尽吴姬酒一觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋小瀛洲 其一","author":"贝琼","text":"海上瀛洲碧水新，地连方丈绝风尘。\n九光霞馆邀王母，一曲鸾笙降玉晨。\n若木回枝长挂日，桃花结子不知春。\n祖龙谩自求方士，却恐流传语未真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋小瀛洲 其二","author":"贝琼","text":"仙人长伯白银宫，不似淮王礼八公。\n日月自周三岛外，山川尽缩一壶中。\n亦麟紫凤池台胜，姹女河车服食同。\n清夜步虚相和处，琪花如雪又春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题苧溪渔友宅","author":"贝琼","text":"徵君白苧溪头住，细雨斜风一短蓑。\n山木两边啼杜宇，浪花千顷落鴐鹅。\n故人且复辞光武，使者何须认志和。\n我亦买田来结屋，沙棠船小日相过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灵鹫观灯","author":"贝琼","text":"天乐风传应壑雷，鹫峰春色似蓬莱。\n一天象纬迎秋转，千月龙宫彻夜开。\n西国胡僧依树坐，上方玉女散花来。\n夜深借榻山房宿，更欲题诗到上台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34446,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢贾齐臣惠碧盌","author":"贝琼","text":"万里坚昆来碧盌，青莲十叶类天成。\n于阗苍玉本同色，韶州白瓷空得名。\n马湩可能羞北馔，驼蹄且复荐南烹。\n茅斋此日足家具，一诗为报故人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34447,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题静天镜碧水春轩","author":"贝琼","text":"绿波如酒不成潮，一曲潜通海眼遥。\n祗树国深青鸟下，桃花浪煖白鱼跳。\n疏星夜列开天镜，细雨朝飞落虹桥。\n杜老赋诗须重过，远公结社肯相邀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34448,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送兴福寺镇静庵","author":"贝琼","text":"西山楼阁涌波涛，西国高僧见白毫。\n贝叶有文留藏室，天花无迹上方袍。\n毒龙在钵秋云湿，驯虎当门夜月高。\n听法他年陪相国，定因元亮置松醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34449,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六月三日泛舟","author":"贝琼","text":"六月三日好天气，清江转柁雨晴初。\n树头云敛出红日，石脚水生跳白鱼。\n何处老翁还独钓，可怜游子未安居。\n野王堆前三女窦，得意唱歌随所如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34450,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕","author":"贝琼","text":"沧江雨歇暑渐微，银床一叶迎秋飞。\n牵牛相对织女出，明月不照征夫归。\n寸心耿耿只自苦，双鬓萧萧今更稀。\n仰候神光向中夜，秋萤暗度鸳鸯机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34451,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十一月廿三日夜集次韵卢廷举","author":"贝琼","text":"河桥春向柳条归，买酒从教更典衣。\n倒海北风三日盛，著人南雪六花飞。\n铜盘烧蜡诗初就，羯鼓催觞令不违。\n身后空名亦何用，独怜张翰早知几。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34452,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"剪韭轩","author":"贝琼","text":"三韭行厨亦浪誇，傍人犹笑庾郎奢。\n春宵翠截山中叶，腊月黄分雪后芽。\n野饭犹能留上客，侯鲭岂复到贫家。\n盘中一箸青丝细，绝胜芜菁散作花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34453,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题玉士亨看山处","author":"贝琼","text":"看山何处候神仙，地近城南尺五天。\n林屋雪消攒玉笋，上方云影出青莲。\n行人独去西风里，倦鸟双回落照边。\n此日骑曹谁记马，閒支手板思悠然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34454,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元夕次韵铁崖杨先生","author":"贝琼","text":"元戎出号初鸣铎，狂客忘归更赋诗。\n貔虎千屯防要地，鱼龙百戏梦清时。\n月临粉蝶南楼静，天接沧江北斗垂。\n可得夜游重秉烛，佳人双唱玉交枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34455,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"二月十六日雨中遣兴","author":"贝琼","text":"城头落日啼乳鸦，城中烟火冷千家。\n断云漠漠夜还合，急雨纷纷风更斜。\n世乱不归空洒泪，春深何处独看花。\n白龙堆前水二尺，明日泛舟携紫霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34456,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送凌彦冲归杭","author":"贝琼","text":"正好听君苏武慢，倾壶共坐白鸥沙。\n十年戎马犹塞路，三月归舟催到家。\n江燕与人同是客，野桃成子乱飞花。\n使回多寄平安字，要看张颠醉墨斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34457,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄林叔大","author":"贝琼","text":"湖州别驾三年别，文采风流想见之。\n水晶宫里无传箭，浮玉山前多赋诗。\n海燕空归寻旧宅，具蚕未老卖新丝。\n金闺学士临池处，还与何人话昔时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34458,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"槐阴亭","author":"贝琼","text":"云团车盖起重重，文正三朝相业隆。\n种树百年蟠厚地，读书六月坐清风。\n蝉吟露叶初回梦，虫吐秋丝忽堕空。\n今日洛阳卿相宅，牡丹谁看状元红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34459,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立夏日","author":"贝琼","text":"江寒雨急仍北风，扣户喜闻南巷翁。\n锦城鲊送蒲茅白，玉盌酒泻桃花红。\n三月忽惊春似客，百年那得老还童。\n一双黄鹂寂无语，飞过小月高楼东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34460,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题云深处","author":"贝琼","text":"朝看云出暮云归，翁住云深已息机。\n海上仙人教种药，山中玉女未收衣。\n须知倏忽神龙变，已作絪缊野马飞。\n我亦无心共来往，五城宫阙梦魂稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34461,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题夏士文园亭","author":"贝琼","text":"窗户青红竹里开，竹深无地著尘埃。\n山移阆花千峰出，水接银河一道回。\n酿酒每留宾客醉，赋诗重许老夫来。\n暖风迟日春如海，随意何妨坐绿苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34462,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重午","author":"贝琼","text":"北里共持菖歜酒，南翁未解木绵裘。\n臼波青嶂三吴地，怪雨肓风五月秋。\n挥泪几时朝凤阙，招魂何处觅龙舟。\n海榴一点红如火，时序催人共白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瑞莲 其一","author":"贝琼","text":"双花相向复相辉，白帝西游拥一妃。\n羽盖风清朝并载，珠宫月冷夜同归。\n翠房已作鸳鸯结，红粉那成蛱蝶飞。\n亭上酒醒杏不断，满汀暮雨湿仙衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34464,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瑞莲 其二","author":"贝琼","text":"秋水嘉莲瑞一门，初花惊见出同根。\n美珠汉女无留迹，鼓瑟相灵有返魂。\n相府昔年曾制曲，仙家今日重开樽。\n合欢何限风流意，怨绿愁红谩自繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34465,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题渊明像","author":"贝琼","text":"素琴无弦不复鼓，清尊有酒还相持。\n者奴迁鼎亦苦早，先生拂衣应已迟。\n子房结客报秦日，武侯出师匡汉时。\n古人今人本同调，坐对南山惟赋诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34466,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题松鶮山居图","author":"贝琼","text":"仙客卢敖东海头，好山百转接丹邱。\n开田种玉一千顷，闭户读书三十秋。\n云气上天如白鹤，茯苓入地化青牛。\n年来浪迹吴淞道，梦里猿声忆旧游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34467,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄奎方舟后用章二上人","author":"贝琼","text":"奎公不种远公莲，卓锡西湖已十年。\n路入雪山灵草合，泉通沧海毒龙眠。\n听法每期双树下，题诗须到四卷前。\n干戈满地伤飘泊，目断千峰紫翠烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34468,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白莲","author":"贝琼","text":"太液初花宿露团，香浓粉淡不胜寒。\n金茎侧泻仙人掌，玉叶危擎帝子冠。\n水阔天空愁欲堕，风清月落好谁看。\n西湖肠断西施采，一曲菱歌唱未阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34469,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋","author":"贝琼","text":"中秋甲子无风雨，吹笛星桥意最关。\n七宝已修天上月，三神不隔海中山。\n故人此夜知何处，狂客经年且未还。\n小队羽衣新按曲，广寒宫阙梦魂閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34470,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钱塘秋夕","author":"贝琼","text":"残蜡无光小院幽，梧桐一树更萧飕。\n西陵风雨来清夜，南国山河入素秋。\n鸡唱四邻呼客梦，雁回千里带边愁。\n可怜季子貂裘弊，迟暮何为赋远游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34471,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉寄崔伯恭左丞","author":"贝琼","text":"武林城下捷书回，郡县遥知次第开。\n一柱危擎南极正，三江远阻北人来。\n讴歌复见唐虞德，匡济深期管葛才。\n东阁几时陪笑语，云间夜夜仰中台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34472,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题 其一","author":"贝琼","text":"楼台十二近蓝桥，帘幕重遮半面娇。\n洛浦有神通子建，天坛无意会文箫。\n仙衣雪皎裁蝉翼，宝髻云松插凤翘。\n月落红寒春梦断，相思空寄海门潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34473,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题 其二","author":"贝琼","text":"锦瑟鸾笙恨总牵，尚思华屋对婵娟。\n春风豆蔻初含日，玉女兰香未嫁年。\n绡拆鸳鸯裁宝扇，酒行琥珀泻银船。\n蓬莱一别三清浅，憔悴应知不及前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34474,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜坐","author":"贝琼","text":"夜寒蟋蟀语秋根，独客无眠忆故园。\n天作穹庐笼四野，月飞明镜照千门。\n胡笳相应时时发，戎马初生处处屯。\n秉烛封书寄兄弟，一身犹滞海西村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34475,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立春日燕西清高士沧洲一曲歌者李氏善胡琴者阮仲朋引觞奏伎宾主尽欢即席赋诗","author":"贝琼","text":"百花堂深香雾生，将军燕客更多情。\n春光已到筼筜谷，客梦如在芙蓉城。\n蛾眉八字远山碧，凤尾双丝流水清。\n金樽美酒敌秋露，今日为君怀抱倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34476,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别吕德常","author":"贝琼","text":"黄鹤仙人道德尊，少年曾记及龙门。\n王山照座联兄弟，白发升堂识子孙。\n衰謉已知英气尽，激昂犹喜赏音存。\n不堪杜宇催归客，明日扁舟出海村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34477,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"姑苏","author":"贝琼","text":"城溃姑苏伯业终，萧萧茂苑自秋风。\n青丝白马来江表，紫盖黄旗入洛中。\n宫殿独留残月照，绮罗应逐晓云空。\n如何十万貔貅士，不及吴陵一旅雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34478,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陆景周宅槁梧复荣以瑞梧命之为赋首","author":"贝琼","text":"石上孤上百尺标，凤皇枝老尚萧萧。\n半身秋委龙蛇蜕，一气春回霹雳焦。\n影薄未能遮月色，声和犹待按云韶。\n山童日夜勤封植，莫使青青露叶凋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34479,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钱唐春日","author":"贝琼","text":"三月皇州望欲迷，涌金门外草初齐。\n满山云气不见日，一雨天街都作泥。\n温室树移鹦鹉去，玉津花落杜鹃啼。\n断桥何日重携酒，醉和儿童唱大堤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34480,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣兴","author":"贝琼","text":"我住云间今四秋，恰如杜甫在秦州。\n赋诗黄耳冢前去，打鼓白龙潭上游。\n暮景飞腾如过翼，此身浩荡一虚舟。\n黄尘九陌绕车盖，且伴老翁随海鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34481,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春和铁崖先生水仙入韵","author":"贝琼","text":"千叶名花阆苑移，浓香百和为重肌。\n藻翘半脱春如醉，翠袖轻扶夜更痴。\n赋就陈王空自怨，佩遗交甫至今疑。\n承恩不向金涂立，入道初将羽帐离。\n步月有时羞素女，行云无意妒瑶姬。\n水边寂莫谁能赏，林下风流总未知。\n肠断二生孤旧约，眼明万槁出新枝。\n朱弦五十闲瑶瑟，黄九为君重赋诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34482,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"二月五日燕夏士文漪澜堂与者鲁道原马文壁冯困如赋诗一首歌者张宝童不至故及之","author":"贝琼","text":"漪澜堂上又东风，报荅春光酒未空。\n海鸟一双鹏尾白，山花千朵鹤头红。\n水边列坐皆词客，天上清歌少玉童。\n不省日斜谁倒载，从教拍手笑山公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34483,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浙江亭观潮","author":"贝琼","text":"山摧岸坼昼冥冥，动地西风带蜃腥。\n沧海倒流吞日月，青天中裂走雷霆。\n欲抬白马今无迹，莫信神鱼尚有灵。\n一气虚空自升降，乾坤与我亦浮萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34484,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘉禾道中","author":"贝琼","text":"秀州城下雪漫漫，一客东归更觉难。\n雁度空江寒月黑，马嘶畏路晓风酸。\n吴趋欲赋知谁和，漠节忘回不复看。\n俯仰乾坤正萧瑟，云间身寄一枝安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34485,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五月十一日过璜溪访马文璧时同门吕德厚具酒相邀犹雨夜归明日文璧有诗见寄用韵荅之","author":"贝琼","text":"因君怀抱未能开，白鹤矶头一棹来。\n江黑坐看飞雨至，酒酣催趁落潮回。\n故人有约金重过，野老无机不用猜。\n明日山瓶犹未竭，当筵更掷左慈杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34486,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"支子","author":"贝琼","text":"南风院落扫繁英，薝卜无人也自荣。\n五月六花开白雪，何年三粒种青城。\n已将色染天衣重，那惜香分水殿清。\n胡蝶梦回闻更好，酒醒夜半月微明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34487,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"绿阴轩夏日书怀","author":"贝琼","text":"锦水西头处士家，深林无径绿阴遮。\n窗前翠合书带草，阶下红开旌节花。\n本藉居亭苏老病，屡从宴赏悦清华。\n一双海鸟无机事，日日飞来傍钓槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34488,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客居","author":"贝琼","text":"移家处士桥西畔，六月蒲莲暗野塘。\n乳鸭成花能黑白，风蝉隔叶自宫商。\n买田不待沾微禄，垂钓须教具小航。\n自比成都浣花叟，旁人应是笑清狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34489,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风泾定光寺周回三里皆荷花彷佛有钱塘西湖之胜与筠谷高士同赋","author":"贝琼","text":"南风隔浦闻花气，菡萏红开十里花。\n宫女三更环白帝，洞庭千顷落明霞。\n凿池不待烦灵运，载酒浑疑过若耶。\n何日与君追胜赏，满船明日唱吴娃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34490,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题周伯昂水村图","author":"贝琼","text":"爱尔读书阳羡里，乔林古木五湖东。\n山如城郭铜棺并，水落田畴罨昼通。\n野老犹能说周处，仙人何许觅张公。\n园收橡栗霜初重，饭煮桃花岁屡丰。\n马队岂堪延祖企，草堂今复见卢鸿。\n已知贡赋随时给，还笑衣冠与俗同。\n一艇微茫在烟浪，采菱歌断夕阳中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34491,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]