[{"title":"对雪再用韵","author":"王绂","text":"一天风雪又深冬，添得诗人兴趣重。\n压树只疑花扑地，看山无复翠为峰。\n管弦沸沸青楼酒，台殿盈盈古寺钟。\n忽听阳春歌绝调，令人不和若为容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26161,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送实即中之杭州都纲","author":"王绂","text":"自是人天说法师，新承恩命授官资。\n春乘短棹还山去，晓著方袍向阙辞。\n楚甸苍茫残雪尽，海天空阔片云迟。\n诸僧迎候知应久，共看松房偃旧枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26162,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭内弟赵叔平","author":"王绂","text":"我昔新婚子弱龄，而翁从戍适当行。\n别离去国不足念，生死托孤深注情。\n万事转看皆往梦，寸心犹恐负前盟。\n别来十载不一见，老泪宁知为尔倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26163,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送胡直秀才下第归南京胄监生","author":"王绂","text":"白发科场未得名，乡闾先达半诸生。\n典文深有披沙恨，失路能无抱玉情。\n夜雨灯窗归上舍，春风花柳别都城。\n秪今且让诸年少，他日鳌头属老成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26164,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题凝碧书房为江阴徐孟熙赋","author":"王绂","text":"爱尔高斋傍柳陂，绿阴长满读书帷。\n晚凉灯火秋声早，昼静轩窗日影迟。\n略洗竹林通鹤径，远分潮水入鱼池。\n何当借地相邻住，白首同为岁晚期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26165,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瑞应狮子诗","author":"王绂","text":"西戎狮子进神京，粲粲金毛映日明。\n幸际盛时亲睹此，绝胜前史但闻名。\n万方顿使群妖息，一吼能令百兽惊。\n不是吾皇珍远物，远人深意慕朝廷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26166,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"麒麟诗","author":"王绂","text":"华夏同春海宇清，麒麟先后进瑶京。\n信知和气多祥瑞，喜见遐方仰圣明。\n声协箫韶金殿奏，步循规矩玉阶行。\n四灵称首昭仁瑞，万岁千秋享太平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26167,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽胡母吴宜人","author":"王绂","text":"身膺五福介期颐，出自名门众所知。\n井臼相夫成显宦，诗书教子达明时。\n恩荣已拜宜人诰，懿行当为女士师。\n妇道母仪俱不泯，文光辉赫墓前碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26168,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题医训张良用全安堂卷","author":"王绂","text":"医名犹得动侯王，为写全安墨有光。\n种德岂惟烧药劵，传家都是活人方。\n阶庭雨后添生意，箧笼风前散异香。\n共喜拜官沾宠渥，圣心端欲万民康。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26169,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈吏部再赴交趾安抚","author":"王绂","text":"炎荒万里喜班师，又奉纶音向阙辞。\n蛮地既平为郡县，圣心尤欲抚创痍。\n山川瘴尽风霆肃，雨露恩深草木滋。\n遥想旌旄重到日，姓名先慰远人思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26170,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周经历之广东神电卫","author":"王绂","text":"落落襟怀自不羁，客边相见即相知。\n几番官舍同谈笑，千里云帆远别离。\n拜命正当初夏日，到官应值早秋时。\n年来戎幕应无事，对酒投壶日咏诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26171,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别经馆诸僧","author":"王绂","text":"诏集高僧馆石渠，得陪清论半年馀。\n太官饭设天厨供，法藏文编贝叶书。\n柳外香来知仗近，花阴日转退朝初。\n告成又复东西别，目送飞云渺碧虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26172,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题风雨竹","author":"王绂","text":"杨柳情怀得似渠，望秋先已影萧疏。\n狂风怪雨从教横，直节贞心只自如。\n昔遇轩辕调六吕，曾同毛颖作中书。\n年来虽是无知己，志抱冰霜自有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26173,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陶给事德温福建阅武","author":"王绂","text":"驲骑南征向七闽，海霞红映锦袍新。\n威行甲胄严边备，节秉旌旄识近臣。\n花柳城池烟外晓，桑麻村落雨中春。\n圣心务在安黎庶，使者应知慰远人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26174,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"写竹题赠举人柯启晖归南京卒业","author":"王绂","text":"腊尽都城奈别离，岁寒人赠岁寒枝。\n恩承雨露应非偶，影拂云霄自有时。\n耐久情怀交后见，出尘标格静中宜。\n珊然鸣佩天风响，它日相期在凤池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26175,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陶给事之福建佥事","author":"王绂","text":"绣衣荣作外台臣，送别都门远入闽。\n天上才承持斧诏，道傍随有避骢人。\n公庭草绿榕阴午，驿路花香荔子春。\n况是皇华旧游地，困穷应达枉应伸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26176,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为项御史题张真人所画乌台春晓图","author":"王绂","text":"柏府沈沈春漏长，封章书罢动晨光。\n吏听乌鸟知朝候，人避青骢在道傍。\n花外烟开金殿迥，柳边风暖绣衣香。\n宦情喜托仙家笔，虎踞龙蟠识帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26177,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送上海道会沈练师","author":"王绂","text":"一簪华发羽衣宽，世外仙翁亦拜官。\n方朔自应从吏隐，旌阳唯欲济民安。\n剑横星斗龙光见，佩响天风鹤背寒。\n回首丹房沧海上，弱流东去路瀰漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26178,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴中书南京复职","author":"王绂","text":"送别都门臈已残，朔风吹雪思漫漫。\n计程中路逢新岁，拜命南京复旧官。\n潮落秦淮江月小，帆开扬子海天宽。\n凤池诸老应无恙，千里凭君一问安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26179,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送殷叙宾","author":"王绂","text":"闻说黄岩近赤城，怜君作宰送君行。\n檄先到县吏民喜，道便过家闾里荣。\n晓日花明山郭静，秋来禾熟海畬平。\n郎官百里应星象，好察居民疾苦情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26180,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送金先生归金华","author":"王绂","text":"令子秘书居禁闼，尊冠尤恋故山薇。\n远违未免长相忆，才到那知又欲归。\n白酒香时禾黍熟，黄花开后蟹螯肥。\n扁舟此去真堪羡，风便莫教音信稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26181,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题清目楼","author":"王绂","text":"双眸久厌黄尘眯，遥想斯楼便豁然。\n叠嶂四围横槛外，飞泉一道落帘前。\n人来晚棹归村市，鹤带晴云度海天。\n闻说主翁能绘事，好传风景客窗悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26182,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送永嘉夏子成服阕还任绛州别驾","author":"王绂","text":"别驾喜除前任处，依然城郭马头看。\n山川重对如归客，父老遥迎识旧官。\n路入晋疆秋气早，河经淮甸水容宽。\n绛人南守甘棠在，此去讴歌士庶传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26183,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送常士昌之雁门","author":"王绂","text":"匆匆又复上征鞍，何日重来叙旧欢。\n去速未能陪奉久，交深唯觉别离难。\n春回上国莺花早，岁暮边城雨雪寒。\n两地相思俱是客，好将书札寄平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26184,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送僧归吴兴用杨进士韵","author":"王绂","text":"暂将踪迹寓京畿，海鹤江云处处飞。\n老托孤藤随作伴，贫收碎帛破成衣。\n吟边灯影同清夜，别后钟声隔翠微。\n愧我浮名苦相伴，何缘参谒叩禅扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26185,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元夜玉堂斋宿分韵得星字","author":"王绂","text":"元夕正当斋宿夜，玉堂春漏隔花听。\n英才会合那能寐，好句赓酬不暂停。\n万井笙歌同皓月，九逵灯火乱繁星。\n明朝圣主严郊祀，伫见嘉徵集四灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26186,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送许可久归钱塘","author":"王绂","text":"桑梓旧居存浙水，庭闱新构住京华。\n百年寄寓谁非客，两地往还俱是家。\n回首白云离思杳，随人芳草去程赊。\n料应不久重来此，分手暂时休叹嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26187,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵赋荷花灯","author":"王绂","text":"翠芰红渠照眼新，装成灯火斗芳春。\n中庭月色涵秋水，陆地花明隔暗尘。\n归院曾随金马客，闻歌疑是若耶人。\n可容一叶乘舟去，露发何妨醉脱巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26188,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"述怀","author":"王绂","text":"到京谁信寡交亲，每每欢和却变嗔。\n俯仰顺人那尽意，浮尘随处漫容身。\n樽前强作忘情醉，镜里俄看老鬓新。\n昨夜梦归江上路，临风高振客衣尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26189,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和少师端午日赐宴诗韵时同纂修群书于文渊阁下 其一","author":"王绂","text":"位列台阶五福昌，怜才多见进贤良。\n诏编简册兴文教，宴锡蒲觞被宠光。\n雅量容人皆感德，新诗对客即成章。\n鮿生展拜嗟何晚，四海声名久播芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26190,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和少师端午日赐宴诗韵时同纂修群书于文渊阁下 其二","author":"王绂","text":"功勋尤喜晚年成，出语常令四座惊。\n重望固应居国老，谦光犹复礼儒生。\n彤庭宴罢看仪凤，黄阁诗成听禁莺。\n况是太平无事日，纂修群籍赞文明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26191,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陈仲明游茅山诗","author":"王绂","text":"希夷生爱觅仙踪，采药华阳洞口风。\n幽径草香曾宿麝，古潭云暖旧藏龙。\n丹成宝鼎铅花碧，箓秘琅函印篆红。\n归到人间施妙术，每令昏瞀豁双瞳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26192,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送僧瑀楚南住灵岩寺分题得披云台","author":"王绂","text":"古寺香台客到稀，閒云无伴待师归。\n霏霏偏解护禅榻，片片宁堪补衲衣。\n舒卷任缘那有碍，去留无著总忘机。\n讲时应有神龙听，化作遥天法雨飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26193,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"分题得彭蠡湖送施员外之南康太守","author":"王绂","text":"天开一鉴列云屏，相去南康里许程。\n夜静滩声喧郡郭，日长波影动檐楹。\n联翩雁阵惊秋早，远近渔歌起月明。\n帘捲黄堂吟对处，君心应许共澄清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26194,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"閒吟","author":"王绂","text":"原来非有亦非无，万化流行共一途。\n先要胸中存见识，还须事上著工夫。\n阳回大地和风满，影落千江片月孤。\n得此见成消息了，芳菲随处可提壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26195,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄示大儿默","author":"王绂","text":"年来老境早相寻，眼雾昏昏鬓雪侵。\n仕进谋身浑断念，思归于汝最关心。\n生涯休厌田园薄，乐事无如道义深。\n安不忘危古今戒，寻常行处索沈吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26196,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"翰林夜宴分韵得隅字","author":"王绂","text":"簪缨列坐总文儒，绿蚁浮香泻玉壶。\n炉袅兰薰横鹊尾，帘垂灯影见虾须。\n赓酬但觉诗情好，笑语浑忘礼法拘。\n醉里不知春漏促，梅花残月转城隅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26197,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花灯","author":"王绂","text":"绿萼含芳剪缀成，小窗寒照一枝横。\n韶光满座春先到，疏影当檐月共明。\n结处任教吹玉笛，看时难把插陶罂。\n夜深吟赏浑忘倦，纸帐高眠梦亦清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26198,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘秀才日升归江西挈家","author":"王绂","text":"通籍金闺步玉堂，喜同三载近清光。\n每惊得句近陶谢，复见挥毫逼晋唐。\n公宴屡分光禄酒，客庖长饫大官羊。\n到官好慰妻孥意，早谢家山入帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26199,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏独鹤","author":"王绂","text":"仙骨昂藏难偶俗，肯随鸡鹜共纷纭。\n云霄路杳非无侣，泉石情高自不群。\n月下一声来静夜，池边孤影立斜曛。\n有时还向空庭舞，满地书成铁爪文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26200,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"楮巢为王可贞先生赋","author":"王绂","text":"林下萧然人似鹤，剡藤蒙密作幽栖。\n高眠可当梅花帐，深掩难容燕子泥。\n窗牖透明云影薄，屋梁生白月痕低。\n新诗不用裁成卷，客到时教就壁题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26201,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送金元祺之常州教授","author":"王绂","text":"闻君典教吾邦去，喜意浑忘送别情。\n当见文风兴一郡，定将经术饱诸生。\n杏坛琴静移花影，芹泮吟馀对月明。\n况有黄堂贤太守，公馀应觅郑康成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26202,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送玉林师赴会还闽中","author":"王绂","text":"道风高迈素知名，诏率同袍上玉京。\n梵教宣扬超古昔，圣恩弘济及幽明。\n祥云尽集瑶花舞，甘露朝凝宝树荣。\n法会已周辞凤阙，浮杯南去海波平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26203,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽彭秀才叙古","author":"王绂","text":"一疾如何便永违，都门秋色惨斜晖。\n乡人惊报哀音去，老父来收旅榇归。\n别梦尚能联几砚，返魂应解访庭帏。\n至今馆下多残翰，每见征人泪满衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26204,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿王吉士双亲","author":"王绂","text":"阶下芝兰綵服鲜，堂前旬中重开筵。\n尊翁寿旦中秋后，阿母生朝九月前。\n椿树倚云凉气好，萱花迎日晓光妍。\n贤郎近住瀛洲上，眷属应知总是仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26205,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"分翠轩为弘道赋","author":"王绂","text":"邻舍屋头多种竹，知君庭下不须移。\n月斜送影来虚牖，雨后行鞭过短篱。\n一榻清风难独赏，两家幽致共相宜。\n余今亦有王猷癖，直造宁论主者谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26206,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新居","author":"王绂","text":"近搆行窝殊可爱，短篱蓬屋小窗纱。\n休言暂住非真宅，偶得安居即是家。\n雨过近移官寺竹，春来唯欠故园花。\n落成不待宾朋贺，新水铜瓶自煮茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26207,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王知州复任","author":"王绂","text":"政绩喜闻居上考，宦情添得鬓毛斑。\n一樽又向江头别，五马重看海外还。\n瘴雾未收天欲雨，飓风初起浪如山。\n休言南徼王畿远，文教于今被百蛮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26208,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送卓逸民归浙东迎养","author":"王绂","text":"每愧空林反哺鸦，庭闱迢递日西斜。\n暂归乡里翻如客，久住京华即是家。\n珍味可尝光禄馔，忘忧还种北堂花。\n安舆催上休迟滞，书法须君考谬差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26209,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和韵赠徐子铭","author":"王绂","text":"忘形不觉往来频，况复情怀久更真。\n稍与迟留常抵暮，纵无酣饮自生春。\n楼前夜色千门月，帘外风光九陌尘。\n满眼长安名利客，如君萧洒是何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26210,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨夜宿实上人山房因题于竹石图","author":"王绂","text":"竹窗清夜听风雨，蒲座同僧对一灯。\n自笑身形癯似鹤，谁知心事冷如冰。\n茅庵近漏牵萝补，茶鼎将枯汲涧增。\n明日天晴过湖去，云山烟树绕平陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26211,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梁不移先生以诗示其子修撰用次其韵 其一","author":"王绂","text":"渺渺白云天一隅，贤郎瞻望久离居。\n宦游虽念道途远，亲老肯教音问疏。\n椿桂同芳多雨露，芝兰交映绕阶除。\n缄题新句来京国，应向晴窗手自书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26212,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梁不移先生以诗示其子修撰用次其韵 其二","author":"王绂","text":"居处高閒体自安，襟怀谁得似君宽。\n邻家酒熟邀春社，钓艇鱼来共晓餐。\n草色池塘看细雨，杏花帘幕动轻寒。\n贤郎近得缄题至，对客时时一展看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26213,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"楮窝","author":"王绂","text":"玉堂词客行窝好，绕榻浑将茧纸糊。\n皓彩透明真月窟，红尘悬隔拟冰壶。\n最宜就壁题篇什，不必围屏写画图。\n宾退随教掩窗户，春时唯恐燕泥污。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26214,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽杨谕德尊翁","author":"王绂","text":"世难一生多索莫，唯将古道乐丘园。\n家庭不独称纯孝，盗贼犹能感片言。\n三径草荒飞梦蝶，孤坟松老惨啼猿。\n只今有子逢昭代，光显应知慰九原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26215,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长芦道中晚眺闻明日驾至德州","author":"王绂","text":"漠漠长堤起暮烟，烟深茅屋数家连。\n灯前人卖当垆酒，月下牛牵上水船。\n官柳萧条霜落后，乡山迢递雁归先。\n明朝应候銮舆近，五色龙光动九天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26216,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"德州早行遇雨","author":"王绂","text":"陆路南来第一程，晓烟寒树广川城。\n仆夫隐隐随车远，官骑萧萧冒雨行。\n野店杯盘多旅况，客途风物总诗情。\n驰驱不觉天将晚，喜见殷勤驿吏迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26217,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽盛进士衍","author":"王绂","text":"姓字登科病已缠，忽闻长逝益增怜。\n恩荣才制新袍笏，志业空遗旧简编。\n丹旐西风秋色里，白杨孤冢暮云边。\n为言堂上休悲戚，恐逐修文在九泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26218,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"静趣轩为顾德润题","author":"王绂","text":"竹树阴森映短墙，萧然绝俗似僧房。\n出城相去路三里，闭户独眠书半床。\n风暖林花飘几席，雨晴沙鸟入池塘。\n惭余扰扰红尘客，到此犹能百虑忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26219,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭亡兄","author":"王绂","text":"十年游宦滞京畿，几度缄题问我归。\n骨肉本期常会合，音容谁料永分违。\n风飘花萼鹃声切，雨暗关河雁影稀。\n闻说今朝临葬日，泪痕空满客边衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26220,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五月一日钦蒙赐扇上有古人嘉言皆当今名翰伏读之馀喜而赋此","author":"王绂","text":"新扇初颁拜宠光，格言名翰玉成行。\n一时暑气都驱却，四海仁风得奉扬。\n皓彩照人如月样，微凉拂鬓有天香。\n菲材自愧浑无补，喜睹南薰物阜康。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26221,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和吴中书阁老韵","author":"王绂","text":"班列鹓鸾肃羽仪，恩颁新扇晓光熹。\n才临北阙瞻天拜，便觉南薰遍地吹。\n在手敢忘君父德，省心常佩圣贤辞。\n凤池阁老能诗客，有倡佳章纪盛时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26222,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题江雨轩为耦武孟作","author":"王绂","text":"江上轩居晴固好，雨中风致更相宜。\n秋声满屋隐书几，爽气一帘倾酒卮。\n渺渺莎汀飞鹭下，冥冥云浪去帆迟。\n诸孙凉夜亲灯火，绝胜旅篷愁听时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26223,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]