10,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渔牧二首 其二 牧","author":"夏原吉","text":"寒傍阳坡煖浴河，闷吹芦管倦眠蓑。\n宁生当日何为者，车底区区扣角歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39211,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送春一首","author":"夏原吉","text":"燕子莺儿不住鸣，催将春去可憎生。\n今年已向燕山送，来岁还从何处迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39212,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"洪熙元年春孟钦和御制天不雨雪忧民吟一首","author":"夏原吉","text":"琼花不放舞春阳，圣主深忧二麦伤。\n清晓九重天语降，便看和气蔼穹苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39213,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"钦和御制重阳节赐糕酒诗","author":"夏原吉","text":"圣主龙飞抚四夷，万方鼓舞乐清时。\n兹维九日颁恩泽，皎皎天章著缉熙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39214,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梦先人二首 其一","author":"夏原吉","text":"严尊违养屡经春，今夕俄从梦里亲。\n应念痴儿未了事，九原犹欲诲谆谆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39215,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梦先人二首 其二","author":"夏原吉","text":"我梦严亲断我肠，揽衣起诵蓼莪章。\n劬劳罔极无能报，谩洒淋浪泪几行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39216,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀故园竹","author":"夏原吉","text":"萧萧窗底多情竹，别后儿孙长若干。\n寄语家僮好看护，莫嫌日日报平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39217,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"到京忆乐理轩","author":"夏原吉","text":"乐理轩中万卷书，不知消息近何如。\n料应此夕相思处，人在南窗月在虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39218,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠鲁冕告老疾还湘","author":"夏原吉","text":"君家三径未全荒，何处匆匆促去装。\n岂是老来腰懒折，归寻元亮学耕桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39219,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"看画","author":"夏原吉","text":"凉生白纻酒醒初，四辟筠窗看画图。\n烟水茫茫山叠叠，恍如身在洞庭湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39220,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题李教谕临清轩","author":"夏原吉","text":"屋下清流屋上山，红尘飞不到其间。\n晚凉月白酒初醒，一曲沧浪閒倚阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39221,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再题松风阁","author":"夏原吉","text":"神鳌掣断黄金索，化作髯龙立槛前。\n赑屃夜深相激搏，道人浑讶卧楼船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39222,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闲云二首 其一","author":"夏原吉","text":"飘然出岫本无心，偶尔从龙学作霖。\n大地枯荄沾既足，好寻猿鹤故山深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39223,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闲云二首 其二","author":"夏原吉","text":"我爱闲云尽日闲，故来相对一怡颜。\n无端天外微风起，吹过南山又北山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39224,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]