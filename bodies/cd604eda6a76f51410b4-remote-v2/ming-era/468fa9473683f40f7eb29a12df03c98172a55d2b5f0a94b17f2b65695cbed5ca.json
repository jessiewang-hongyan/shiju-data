[{"title":"五坞山五首 其一 飞泉坞","author":"高启","text":"山空响更远，雨过流还急。\n余沫洒回风，一林红树湿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16471,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五坞山五首 其二 修竹坞","author":"高启","text":"色映溪沉沉，秋云生夕阴。\n无限楚山意，鹤鸣风满林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16472,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五坞山五首 其三 丹霞坞","author":"高启","text":"遥闻丹霞坞，中有餐霞者。\n绛彩发朝朝，还同赤城下。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16473,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五坞山五首 其四 白云坞","author":"高启","text":"云开见山家，云合失山路。\n闻语知有人，欲寻已迷误。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16474,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五坞山五首 其五 芳桂坞","author":"高启","text":"欲攀淮南树，人去山寂寞。\n袅袅凉风生，疏花月中落。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16475,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"卓笔峰（在天平山）","author":"高启","text":"云来初似墨，雁过还成字。\n千载只书空，山灵恨何事。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16476,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"太湖","author":"高启","text":"长溪如白虹，分走荆霅派。\n具区纳群流，襟带三郡界。\n太虚混鸿蒙，元气流沆瀣。\n初疑溟渤宽，稍觉云梦隘。\n茫茫雁飞迟，飒飒帆度快。\n雨来鼍报鸣，风起鸥惊迈。\n神龙作渊都，岂复数鳞介。\n珠光照水府，不受白日晒。\n朝看炮车云，云浪动澎湃。\n声吹地将浮，势击山欲坏。\n黄头虽轻生，捩柁不敢懈。\n有时湛明镜，峰吐青几块。\n烟中树若莎，波上舟如芥。\n渔就沙岸炊，客来水祠拜。\n震泽思禹功，夫椒记吴败。\n白鱼逢夏出，黄柑待秋卖。\n我性好游观，夙负云水债。\n欲寻鸱夷舸，不顾涉险戒。\n人生亦何为，世故自拘械。\n万事风飘花，百年露垂照。\n何当叩林屋，秉炬访仙怪。\n试探不死方，为人起疴瘵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16477,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"天池（在华山）","author":"高启","text":"灵峰可度难，昔闻枕中书。\n天池在其巅，每出青芙蕖。\n湛如玉女盆，云影含夕虚。\n人静时饮鹿，水寒不生鱼。\n我来属始春，石壁烟霞舒。\n滟滟月出后，泠泠雪销余。\n再泛知神清，一酌欣虑除。\n何当逐流花，遂造仙人居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16478,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"剑池","author":"高启","text":"干将欲飞出，岩石裂苍矿。\n中间得深泉，探测费修绠。\n一穴海通源，双崖树交影。\n山中多居僧，终岁不饮井。\n杀气凛犹在，栖禽夜频警。\n月来照潭空，云起嘘壁冷。\n苍龙已何去，遗我清绝境。\n听转辘轳声，时来试幽茗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16479,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"练渎","author":"高启","text":"吴越水为国，行师利舟战。\n夫差开此河，艅艎试亲练。\n十万凌潮儿，材比佽飞健。\n鼓棹激风涛，扬舲逐雷电。\n当时意气盛，谓已无句践。\n鸥避去沙洲，龙愁闭渊殿。\n恃强非伯图，倏忽市朝变。\n台上失娇姿，泉间掩惭面。\n至今西山月，恨浸秋一片。\n犹有网鱼人，时时得沉箭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16480,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"太湖石","author":"高启","text":"没人采石山根渊，投身不试饥蛟涎。\n冯夷不解护潜宝，几片捧出如青莲。\n寒姿本是湖水骨，波涛漱击应千年。\n初疑鬼怪离洞府，珊瑚铁网相钩连。\n嵌空突兀多异态，云吐夏浦芝生田。\n龙鳞含雨晚犹润，豹质隐雾朝常鲜。\n清音叩罢磬韵远，微靥洗出珠窝圆。\n坐移各岫置庭砌，日照仿佛生紫烟。\n三峰削成泰华掌，一穴透入仇池天。\n醉中时倒倚苍藓，秋风冷逼吟诗肩。\n洛阳园墅汴宫苑，当时骈列夸奇妍。\n黄罗封盖素毡裹，万里贡饷劳车船。\n奢游事歇家园废，尽仆荆棘荒池边。\n人生嗜此亦可笑，有身岂得如石坚。\n百年零落竟谁在，空品甲乙烦题镌。\n又嗟此石何献巧，自召凿取亏天全。\n不如顽矿世所弃，满山长作牛羊眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16481,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寒泉（在支硎山）","author":"高启","text":"远络丛峰间，平流盘石上。\n月照欲成潭，风吹不生浪。\n声兼寒叶下，色映秋苔涨。\n野客照羸颜，曾来倚筇杖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16482,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"千人石","author":"高启","text":"池上无陀石，千人列坐曾。\n如今趺夜月，唯有一山僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16483,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南园","author":"高启","text":"君不见平乐馆，古城何处寒云满。\n君不见奉诚园，荒台无踪秋草繁。\n白日沉山水归海，寒暑频催陵谷改。\n皇天大运有推移，富贵于人岂长在。\n请看当年广陵王，双旌六纛何辉光。\n幸逢中国久多故，一家割据夸雄强。\n园中欢游恐迟暮，美人能歌客能赋。\n车马春风日日来，杨花吹满城南路。\n叠石为山，引泉为池，辟疆旧园何足奇。\n经营三十年，欲令子孙永保之。\n不知回首今几时，繁华扫地无复遗。\n门掩愁鸱啸风雨，种菜老翁来作主。\n空余怪石卧池边，欲问兴亡不能语。\n春已去，人不来。\n一树两树桃花开，射堂鞠圃俱青苔。\n何须雍门琴，但令对此便可哀。\n人生不饮胡为哉？\n人生不饮胡为哉？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16484,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"松江亭（在吴江垂虹桥上）","author":"高启","text":"泊舟登危亭，江风堕轻帻。\n空明入远眺，天水如不隔。\n日落震泽浦，潮来松陵驿。\n绵绵洲溆平，莽莽葭菼积。\n凭栏不敢唾，下有龙窟宅。\n帆归云外秋，鸟下烟中夕。\n欲炊菰米饭，待月出海白。\n唤起弄珠君，闲吹第三笛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16485,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登丘操","author":"高启","text":"驱车兮与马，蹇吾行兮胡为乎在中野？\n登彼兮崇丘，下茫茫兮九州，思君子兮不得与驾以游。\n山有出云兮木亦有柯，我将归兮忧之如何？\n登青丘，有怀而作。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16486,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"齐云楼","author":"高启","text":"境临烟树万家迷，势压楼台众寺低。\n斗柄正垂高栋北，山形都聚曲栏西。\n半空曾落佳人唱，千载犹传醉守题。\n劫火重经化平地，野乌飞上女垣啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16487,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"灵岩寺","author":"高启","text":"闲上香台望下方，渔村樵坞尽苍苍。\n倾城人远苔生径，归寺僧稀叶满廊。\n云散池边留塔影，雨来阁外失湖光。\n废兴皆幻何须问，独自吟诗送夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16488,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"涵空阁（在灵岩寺）","author":"高启","text":"衮衮波涛漠漠天，曲阑高栋此山颠。\n置身直在浮云上，纵目长过去鸟前。\n数杵秋声荒苑树，一帆暝色太湖船。\n老僧不识兴亡恨，只向游人说往年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16489,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孤园寺（在洞庭山，梁散骑常侍吴猛古宅）","author":"高启","text":"欲问南朝常侍宅，已为西域化人宫。\n山僧归带渔舟雨，湖鸟来闻粥鼓风。\n橘柚垂檐秋殿暗，波涛惊座夜堂空。\n给孤长者谁曾见，应在烟云杳霭中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16490,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南峰寺","author":"高启","text":"樵归众山昏，天峰尚余景。\n欲投石门宿，更度西南岭。\n远闻云间钟，萝径入寺永。\n悬灯照静室，一礼支公影。\n鸟鸣涧壑空，泉响窗户冷。\n对此问山僧，何如沃州境？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16491,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再游南峰","author":"高启","text":"放鹤庭前落叶重，吟身独上夕阳峰。\n远村近浦分诸树，后岭前山应一钟。\n高阁倚残归鸟过，空林行尽老僧逢。\n支公骏马嗟何处，石上莓苔没旧踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16492,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"楞伽寺","author":"高启","text":"夕阳西下嶂，返照东湖水。\n来寻古寺游，枫叶秋几里。\n叩门山猿惊，维马林鸟起。\n钟声出烟去，半落渔舟里。\n楞伽义未晓，尘累方自耻。\n欲打塔铭碑，从僧乞山纸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16493,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"开元寺石钵","author":"高启","text":"宝石当年琢帝青，浮波不异木杯轻。\n传灵已历乾陀国，乞食曾来舍卫城。\n渔父得时初洗献，法王在日每擎行。\n寺僧见客休频出，恐有藏龙此内惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16494,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"师子林十二咏 其一 师子峰","author":"高启","text":"风生百兽低，欲吼空山夜。\n疑是天目岩，飞来此山下。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16495,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"师子林十二咏 其二 含晖峰","author":"高启","text":"演漾弄晴晖，江山秋敛霏。\n我吟康乐句，日暮澹忘归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16496,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"师子林十二咏 其三 吐月峰","author":"高启","text":"四更栖鸟惊，山白初上月。\n起开东阁看，正在云峰缺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16497,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"师子林十二咏 其四 立雪堂","author":"高启","text":"堂前参未退，立到雪深时。\n一夜山中冷，无人祇自知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16498,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"师子林十二咏 其五 卧云室","author":"高启","text":"夕卧白云合，朝起白云开。\n惟有心长在，不随云去来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16499,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"师子林十二咏 其六 问梅阁","author":"高启","text":"问春何处来，春来在何许？\n月堕花不言，幽禽自相语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16500,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"师子林十二咏 其七 指柏轩","author":"高启","text":"清阴护燕几，中有忘言客。\n人来问不应，笑指庭前柏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16501,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"师子林十二咏 其八 玉鉴池","author":"高启","text":"一镜寒光定，微风吹不波。\n更除荷芰影，放取月明多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16502,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"师子林十二咏 其九 冰壶井","author":"高启","text":"圆甃夏生冰，光涵数星冷。\n窗有定中僧，休牵辘轳绠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16503,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"师子林十二咏 其十 修竹谷","author":"高启","text":"翠雨落经床，林鸠午鸣后。\n笋出恐人来，编篱遮谷口。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16504,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"师子林十二咏 其十一 小飞虹","author":"高启","text":"初看卧波影，应恐雨崇朝。\n过涧寻师去，端如度石桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16505,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"师子林十二咏 其十二 大石屋","author":"高启","text":"浑沌复轮囷，全无斧凿纹。\n门临五湖水，坐纳四山云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16506,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"之荆操","author":"高启","text":"粤有我土，岐山之下。\n孰是营之，维我考祖。\n今我于迈，自岐徂荆。\n岂不怀归，念我弟兄。\n民勿我思，我斯安只。\n国已有后，先君季子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16507,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"望虞山辞","author":"高启","text":"虞山峨峨兮出云油油，胡敛其施兮弗雨九州。\n下有蛟龙兮海波横流，谁使子来兮从伯氏以游。\n朝于兮望岐周，国有祀兮有何求？\n唐虞逝兮道阻修，惭德舆兮干戈日休。\n思夫人兮心焉孔忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16508,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"玉波冷双莲","author":"高启","text":"金风暮剪双头蕊，啼脸辞秋嫣血紫。\n宫女三千罢笑喧，锦云阵冷鸳鸯死。\n满江烟玉流古香，寻魂吊影愁茫茫。\n吴天队露衰红湿，一夜波凉小龙泣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16509,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"王敬伯歌","author":"高启","text":"舟初维，琴始荐。\n驿亭边，夜相见。\n词宛转，情绸缪。\n解环佩，弹空侯。\n调易阑，情难歇。\n江波寒，堕明月。\n绿壶再倾，芳音欲违。\n譬彼林鸟，逢晨各飞。\n罗衣沾霜，城乌忽起。\n明日相思，孤棹千里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16510,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"叠韵吴宫词","author":"高启","text":"筵前怜婵娟，醉媚睡翠被。\n精兵惊升城，弃避愧坠泪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16511,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鹤媒歌","author":"高启","text":"鹤媒独步荒陂水，仰望云间飞不起。\n远看过鸟下南汀，鼓翼相迎似相喜。\n共为羽族生水乡，暂从饮啄无猜防。\n草盾俄开中潜弩，弋师欢笑媒矜舞。\n嗟尔高洁非凡禽，胡为徇食移此心。\n受人驯养忘远举，好陷同类机肠深。\n呜呼！\n世间几人号君子，得利相倾亦如此。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16512,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"斗鸭篇","author":"高启","text":"春波漾群凫，戏斗每堪玩。\n宛转回翠吭，缡振文翰。\n声兼江雨喧，影逐浦云乱。\n唼喋队初交，纷披势将散。\n持敌忽同沉，呼俦更相唤。\n时陈水槛侧，或聚湖亭畔。\n长鸣若贾勇，远奋如追窜。\n荷叶触俱翻，菱丝冒齐断。\n鱼骇没中流，鸥惊起前岸。\n心逾陇雉骄，气压场鸡悍。\n海客朝自驱，溪娃晚犹看。\n稍欲碍行舟，浑忘避流弹。\n苦争应为食，幸胜非因算。\n微鸟昧全躯，临川独成叹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16513,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"慧聚寺次张祐韵","author":"高启","text":"烟敛城初出，朝来野欲吞。\n危樵缘磴角，倦衲憩松根。\n刹表藏林寺，钟闻隔海村。\n画龙飞去久，空掩殿堂门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16514,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"言公井","author":"高启","text":"寥寥武城宰，遗井虞山阴。\n千载汲未竭，九仞功应深。\n艺囿自可灌，道源谁复寻。\n弦歌听已歇，瓶绠看还沉。\n无为渫弗食，恻恻起叹音。\n一瓢乐未改，庶几回也心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16515,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"偃松行（在天平山西，旧文正书院前）","author":"高启","text":"龙门西冈魏公祠，祠前有松多古枝。\n长身蜿蜒横数亩，巨石作枕相撑持。\n春泥半封朽死骨，冻藓全聚皴生皮。\n无心昂耸上霄汉，偃仰独向荒山垂。\n蛰雷振岳撼不动，一载一梦醒何迟。\n政如卧龙未起日，深意有待风云期。\n太湖月出照夜魄，天峰雪积埋寒姿。\n涛声时吼若鼾息，野老惊起山僧疑。\n左仰右屈各异态，天自出巧非人为。\n画师安能把笔写，稚子岂敢操斤窥。\n杜陵枯楠已憔悴，蜀相老柏非瑰奇。\n何如此树怪且寿，呵卫定想烦灵祇。\n不知已阅几人代，游客过尽今存谁。\n明堂屡兴不见取，得全正爱同支离。\n我尝来观忍遽反，醉坐其上高吟诗。\n葛陂筇竹亦腾化，神物终去可久羁。\n何当一叱使飞起，载我万里游天池。\n他年还访旧城郭，正是白鹤归来时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16516,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏残灯和杨孟载","author":"高启","text":"凝寒结重晕，逼曙零孤朵。\n膏空逐漏水，焰在同炉火。\n恋影未成眠，更就余光坐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16517,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柳絮","author":"高启","text":"轻盈易飘泊，思逐春云乱。\n已拂武昌门，还萦灞陵岸。\n沙头雀啄堕，水面鱼吹散。\n官树晓茫茫，哀歌肠欲断。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16518,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠竹里子","author":"高启","text":"弭楫望迷林，闲为淇澳吟。\n君家不可见，但听烟中禽。\n日落浦云远，雨余江水深。\n非同抱清节，岁晏复谁寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16519,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王推官赴官谯阳","author":"高启","text":"久治乱所伏，国家失其防。\n初如决洪流，拱手遍四方。\n频年劳吁谟，欲补千百疮。\n子为京师客，忠愤何慨慷。\n濯冠捧书函，平明献朝堂。\n上言固大业，下言振颓纲。\n且为有万死，圣明察臣狂。\n臣言倘获施，立能致时康。\n宸居岂云远，遥指天中央。\n鸡鸣列仙仗，九门洞开张。\n谓宜只召见，拜起随班行。\n上殿笏画地，论奏尽敷详。\n如何竟报缺，不得瞻清光。\n一官非所愿，欲令赴蛮荒。\n徘徊出都门，风雨湿晓装。\n行行过吴洲，木叶秋始黄。\n逢予解鞍饮，激烈椎酒床。\n平生忧时心，辛苦不自忘。\n颇闻到官所，此去路尚长。\n红日出雾迟，孤城海茫茫。\n遗民似猿鹿，山谷多惊藏。\n繁英艳踯躅，琐实推槟榔。\n瘴疠况时作，投老恐子伤。\n何不且少留，共骛豪华乡。\n子笑不我顾，翩然决南翔。\n明朝指鲸波，高帆若云扬。\n去矣各异国，有意徒相望。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16520,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"剡原九曲九首 其一","author":"高启","text":"欲知溪流长，百转来越峤。\n舟行安能极，岚路入斜照。\n清景不足娱，昔人岂辞诏。\n石砚久谁磨，空林闭遗庙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16521,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"剡原九曲九首 其二","author":"高启","text":"殿中初未仕，高节振衰谢。\n读书在兹丘，萧然竹间舍。\n王来有深言，留宿山水夜。\n谁云南阳翁，独枉将军驾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16522,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"剡原九曲九首 其三","author":"高启","text":"山折水暂旋，山开水仍往。\n东陂汇初成，秋色弥然广。\n碧萝花茸茸，月映石壁上。\n何时试沿洄，一理烟中舫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16523,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"剡原九曲九首 其四","author":"高启","text":"密筱覆埼岸，石穴黝而深。\n居人负薪归，驻听风水音。\n回看莲花峰，霭霭生夕阴。\n不有僧钟来，高路谁能寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16524,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"剡原九曲九首 其五","author":"高启","text":"石洞篝火入，石室敷床居。\n白云开层巅，上有丹霞书。\n神仙不远人，但使粗秽除。\n何必瀛洲外，茫茫问飙车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16525,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"剡原九曲九首 其六","author":"高启","text":"危梁渡清濑，逶迤入前渚。\n犬鸣树蒙茏，烟景暗虚聚。\n雨中耕叟歌，月下归人语。\n欲寻仙尉踪，凄凉一茅宇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16526,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"剡原九曲九首 其七","author":"高启","text":"清晖泛悠悠，东与班溪合。\n菱叶间荷花，风来秋飒飒。\n久行愁寂寞，忽有人烟杂。\n我欲发棹讴，渔郎肯相答。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16527,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"剡原九曲九首 其八","author":"高启","text":"俗驾不可到，有地岙中小。\n回回别涧通，宛宛连岗绕。\n人家陵谷暗，不见旭光晓。\n东作起炊藜，惟应候啼鸟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16528,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"剡原九曲九首 其九","author":"高启","text":"入江水稍决，霜降未可涉。\n颇闻往来人，出门即舟楫。\n前飞惊鹭远，下饮垂猱倢。\n何处问兴公，风吹赤棠叶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16529,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜起观月","author":"高启","text":"一春夜多雨，今宵初月明。\n窗间幽梦觉，起忆故园行。\n露下花微委，烟中鸟忽鸣。\n谁同赏清景，惆怅倚前楹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16530,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟中早行","author":"高启","text":"隆隆津鼓动，江火留余闪。\n人家未起耕，近水寒扉掩。\n船开凫鸭散，树吐烟霏敛。\n东郭去方遥，青山见孤点。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16531,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]