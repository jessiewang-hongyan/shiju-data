[{"title":"便面","author":"孙绪","text":"结屋云山深复深，人间万事付蹄涔。\n美人只隔村西路，一夜相思万里心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17130,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"买臣负薪","author":"孙绪","text":"西望咸京路渺漫，碧霄何日劫泥蟠。\n儒生常被青袍误，莫讶山妻冷眼看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17131,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"濯足","author":"孙绪","text":"双脚曾为万里行，断厓依旧水深清。\n尘泥荡涤须教尽，莫惹征夫又濯缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17132,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太公","author":"孙绪","text":"五尺丝竿八十馀，无端西伯有徵书。\n迂疏亦抱磻溪志，却恐官家要纳鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17133,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"爱山","author":"孙绪","text":"幽人坐爱山光曙，家在深山更深处。\n绿阴碧水昼迟迟，时有閒云自来去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17134,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"圯桥进履","author":"孙绪","text":"蹙项诛秦只绪馀，争如云壑赤松居。\n也知高帝轻儒者，终负先生手授书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17135,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游春","author":"孙绪","text":"蹇驴何地不閒游，山自青青水自流。\n收拾奚囊晚归去，半桥新雨没汀洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17136,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"烂柯","author":"孙绪","text":"相逢一顾意欣然，东望蓬瀛水拍天。\n石上输赢才半局，人间陵谷已千年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17137,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"琴泉","author":"孙绪","text":"半生葵藿久相知，短发偏宜小接䍦。\n一曲猗兰青眼共，碧山无尽鸟飞迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17138,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪景","author":"孙绪","text":"松僵竹折雪未休，北风落日寒飕飕。\n水边梅树著花未，试问扁舟王子猷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17139,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"御水红叶图","author":"孙绪","text":"一叶丹枫趁素秋，都将旧管涤新愁。\n深宫谁识无穷恨，只有年年御水流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17140,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋江鸥鹭图二首 其一","author":"孙绪","text":"一夜西风拂树林，霜崖高处水声深。\n潇湘千里无穷意，漠漠长空识此心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17141,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋江鸥鹭图二首 其二","author":"孙绪","text":"共爱修翎占浅莎，鲈鱼荇带满晴波。\n谁知豢养樊笼处，不似江头野兴多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17142,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"朱买臣负薪图","author":"孙绪","text":"平生筋力此疲饥，霄汉明年见远飞。\n何须恳恳求乡郡，只为归来诧故妻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17143,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"显陵五章送严介溪宗伯","author":"边贡","text":"于穆献考，睿哲维则。\n宅兹郢方，以莅王国。\n笃生我后，膺符受历。\n奕世丕承，下土是式。\n滔滔江汉，翼轸之墟。\n我后龙翔，奄正中区。\n诞基骏命，聿绍鸿图。\n赫赫明明，肇阐徽谟。\n帝念孝思，继序不忘。\n位号既崇，复我天常。\n有严新庙，祠礿烝尝。\n是典是彝，诞告多方。\n乃命司空，伐石京师。\n郁郁我陵，大建厥规。\n载经载营，竹花卜釐。\n立极考度，备物多仪。\n帝属其文，经纬七曜。\n贞观崇封，勒我纯孝。\n亿万斯年，汤孙是诏。\n天人肃肃，卫兹隧道。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17144,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"隰柳三章寿林母也三首","author":"边贡","text":"隰则有柳，原则有杻。\n显允林侯，母德且寿。\n母寿维何，七秩是望。\n母德维何，媲古敬姜。\n殷殷其雷，在山之阳。\n侯政有声，闻于东方。\n匪维东方，四国是扬。\n母心则閒，母体则康。\n体之康矣，剃之黄矣。\n我侯燕喜，家之庆矣。\n于百斯年，钖福之无疆矣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17145,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"朝涉篇六章","author":"边贡","text":"朝涉洪流，夕步江皋。\n凯风吹衣，游子心劳。\n岸则有藻，江则有鱼。\n我钓我采，荐之中厨。\n昔曳里布，以献以舞。\n今也则亡，敢曜斯组。\n繄祭五鼎，厥养乃三。\n禄不逮存，哀哀孰堪。\n上冢爇黄，下冢回首。\n嗟嗟游子，行役已久。\n暧暧暮光，萧萧白杨。\n永怀二人，曷也可忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17146,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"墨竹","author":"夏良胜","text":"一幅写真竹，依然老嫩茎。\n不惊风雨梦，深倚雪霜明。\n有影浓且淡，无根枯复荣。\n诗魂偏入格，聊寄故人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17147,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山游荅同志","author":"夏良胜","text":"散策行迂路，离离坐石桥。\n柳烟依日睡，花雨趁风飘。\n大笑逢开口，相期怕折腰。\n深杯冯自酌，清韵倩人敲。\n家食本同舍，官资拟共寮。\n尘心无地著，客气有冰消。\n风月本人分，乾坤定我交。\n若知难重担，何以荅清朝。\n后望须刊竹，初心学理苗。\n看云还绝巘，乘月欲通宵。\n臣节千年重，君门万里遥。\n无端发长恨，画角一声谯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17148,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚眺","author":"夏良胜","text":"密云驱雨过，山为送青来。\n犬吠行人住，牛奔牧竖回。\n好句随凉得，芳樽入夜开。\n床头无所有，几卷旧书堆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17149,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"圃田诗三章","author":"边贡","text":"圃有田，田田兮，宜我硕实连连兮。\n圃之中兮，有田可宫。\n我构斯崇，维柏维桐，曷以弗永终。\n圃之周兮，翼翼盈我畴兮。\n畴有秋兮，曷其求兮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17150,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"偶书","author":"夏良胜","text":"有雨梧逾碧，无风竹自开。\n小溪深雪注，矮屋厚云堆。\n薜荔墙通径，芝兰砌少埃。\n柴门春昼掩，不见一人来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17151,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山房夜话","author":"夏良胜","text":"丈室清于洗，玄玄正可谈。\n放帘分月碎，迎户半风含。\n人寿岂无百，浮生只有三。\n抟鹏争欲上，征雁几回南。\n绕砌浇金菊，临轩数玉簪。\n茶精搜句涩，酒力助歌酣。\n岐路谁曾泣，迷途马更谙。\n芳心难妥贴，短发易差鬖。\n话到忘忧处，行储欠一担。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17152,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泉之滨哀隐士也 其一","author":"边贡","text":"泉之滨兮，白石磷兮。\n以饮以濯，育吾真兮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17153,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泉之滨哀隐士也 其二","author":"边贡","text":"泉之浒兮，锡之土兮。\n载浚载渠，溉之溥兮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17154,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泉之滨哀隐士也 其三","author":"边贡","text":"人之坠矣，泉之匮矣。\n瞻言跂兮，众之喟兮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17155,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山之阳送朱子宜归省","author":"边贡","text":"山之阳兮，有春者晖。\n草之华矣，将子言归。\n山有泉兮，㶁㶁其流。\n子之归矣，谁与我晤游。\n子之归矣，登堂寿母。\n何以赠子，曰有春酒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17156,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿中方寺三首 其一","author":"夏良胜","text":"永夜便僧话，茶膏一味真。\n破墙通月色，空阁接云亲。\n切切笛中雨，浮浮瓮底春。\n五更清梦晓，门放欲来人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17157,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿中方寺三首 其二","author":"夏良胜","text":"绝巘冯虚望大江，江花似浴白鸥双。\n自家适意闲藜杖，隔岸愁声老木梆。\n吊古岂无刍比玉，崇文直有笔如杠。\n村深寂寂无人到，山月茅檐照睡厖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17158,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵题豫斋扇","author":"边贡","text":"适意无多言，一笑成莞尔。\n我心寒沙月，君心古潭水。\n莫作江上波，随风夜中起。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17159,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送别台峰","author":"边贡","text":"皎皎中庭月，照此离客颜。\n月沈会有升，客去何当还。\n采采园中瓜，袅袅不可攀。\n草木本无知，枝蔓相钩环。\n如何宦游子，岐路长间关。\n散如蓬逐风，聚如云在山。\n聚散本莫期，毋嗟涕潺潺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17160,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"茗屿","author":"边贡","text":"湑湑海气白，楚楚衣冠聚。\n谁开高奥灵，太尉体光贮。\n缅仰世则公，乐兹清茗屿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17161,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"盘谷","author":"边贡","text":"佳气何盘盘，松柏丛林壑。\n上有大宗祠，棠棣华繁鄂。\n始自一人身，分此千万络。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17162,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宗会庙","author":"边贡","text":"庙貌俨生存，妥灵绥后禄。\n水木有本源，十辐同一毂。\n四百馀年来，因之序昭穆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17163,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"时思堂","author":"边贡","text":"苍凉海日曙，堂下森兰玉。\n愿言永孝思，俎豆差繁缛。\n岁岁荐烝尝，采蘋清涧曲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17164,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"环翠楼","author":"边贡","text":"楼前冢累累，陇上麦青青。\n岛雾开远岫，海霞明空庭。\n夜半松声作，凄其不忍听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17165,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"延月轩","author":"边贡","text":"松上有海鹤，松下有泉石。\n轩中几格明，轩外狐兔迹。\n延览兴遐情，半窗山月白。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17166,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"望云亭","author":"边贡","text":"觱沸此槛泉，脉自龙湫来。\n飞出两白龙，划然丹壁开。\n倚亭望长云，从天喷风雷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17167,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"世祀田","author":"边贡","text":"朝耕高奥田，莫耕高奥田。\n粢盛戒清酤，伏腊击肥鲜。\n良哉古人意，以此奉周旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17168,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"观苏门山图","author":"边贡","text":"昔予祇皇役，弭节苏门山。\n展眺孙登祠，薄暮松扉关。\n凄风振林木，䬃䬃流区寰。\n如聆长啸音，来彼白云间。\n又如见青蓑，囊琴弄潺湲。\n缅怀沈冥志，上与沮溺班。\n一别期再游，欲往途路艰。\n临图起遐想，延伫久忘还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17169,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再游石门洞","author":"边贡","text":"苍然郭东山，百丈萦青碧。\n石门忽中断，窈窕开仙宅。\n遥窥日月深，却转烟雾隔。\n中天屹楼居，星斗挂几席。\n芳岩眩绮绣，丛巘围苍壁。\n山鬼不避人，惊猿啸窥客。\n披榛上孤亭，奇观壮心魄。\n穷崖倚天悬，瀑水半空射。\n高流横杂佩，直下垂疋帛。\n分作四山喧，散为千顷泽。\n初冬天未寒，晨曦映岚赫。\n重来意弥眷，独往任所适。\n信美惬心期，胡为老行役。\n终然脱尘网，高举凌风翮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17170,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王内使敬夫归省","author":"边贡","text":"归骖慕乡土，欲止不可能。\n朝发华阴祠，日夕过灞陵。\n风林散轻雨，山店明春灯。\n忽忆旧时路，别来如更增。\n蟏蛸缀檐牙，游子行到家。\n邻里登墙头，顾望纷且哗。\n堂前列车马，堂上生光华。\n何以为亲寿，宫衣明绣花。\n草堂近终南，采兰日往来。\n兄弟各相勉，行歌咏南陔。\n亲心日以悦，亲颜日以开。\n閒时语家庆，笑指庭中槐。\n春潭水烟青，春岸杏花赤。\n宛转沙上径，依依记行迹。\n濯缨清浅流，还坐旧苔石。\n鸥鹭了不惊，遥应识归客。\n春分酒初熟，香满青门店。\n匹马随双童，穿林复经堑。\n夜窗清梦里，花笔生彩焰。\n好是南山灵，相寻索诗欠。\n我思何所在，乃在樊川沚。\n斜月照虚梁，微风动芳芷。\n悠悠抱沈念，脉脉感前喜。\n尺练难重持，春冰限双鲤。\n君陂水多鱼，我湖山有鹊。\n一飞与一潜，各自相娱乐。\n同游京辇下，十载镇如昨。\n昨夜问君行，朝来宦情薄。\n君才比天马，高躅不可蹈。\n我心寔亡羊，多岐赖君导。\n关山一为别，轮轸何时到。\n感激木瓜篇，琼琚愧相报。\n枕书卧南窗，月黑灯不明。\n遥夜无近梦，深交有遐情。\n鸣琴写幽怀，调苦弦亦清。\n曲罢不成寝，高林啼曙莺。\n秣马西送君，行行古城阴。\n长亭短亭路，千里万里心。\n春绿变山草，连连冈与岑。\n归林渺烟光，彷佛闻车音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17171,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陈文鸣 其一","author":"边贡","text":"郁郁深涧松，冬夏不改青。\n濯濯江柳花，随波化流萍。\n羡彼五陵客，终朝宴芳腥。\n三楚多秀士，皓首穷六经。\n谁为尺一书，荐之升王廷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17172,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陈文鸣 其二","author":"边贡","text":"达人㣘高义，立志不苟同。\n长啸六合表，傲睨一世中。\n君看今日颜，不及昨日红。\n乘运各努力，扬休树德风。\n颓年傥相值，跨鹤蓬莱东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17173,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次何逊落日泛江赠鱼司马之作奉送刘美之","author":"边贡","text":"相投已盍簪，相赠还留带。\n昨暮长安西，今朝苑城外。\n谁言车马地，复得须臾会。\n会君心暂悦，去君心转切。\n秋岐蔓寒草，隐隐烟不绝。\n归雁影联翩，坠叶声骚屑。\n端居尚兴感，况乃万里别。\n桂舸溯江湘，何时到蛮汭。\n蛮水夜悠悠，月明登郡楼。\n幽兰翠萦渚，紫蘅香绕洲。\n应歌楚人词，坐惜勋名浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17174,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"美之席上限韵送别二首 其一","author":"边贡","text":"恻恻重恻恻，当歌忽成默。\n客车驾双轮，欲挽不可得。\n华灯粲宵焰，殷勤照行色。\n月转庭榭光，风起檐树黑。\n谁能理朱丝，为鼓长相忆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17175,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"美之席上限韵送别二首 其二","author":"边贡","text":"悠悠清川波，矫矫风林翼。\n翼飞邈难止，波去何时息。\n怜君万里行，莽莽天南北。\n罹纷有孤操，涉远无近力。\n不见寒松枝，岁晚青更直。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17176,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得将有事于西畴送王中丞致仕","author":"边贡","text":"发春惊蛰始，土脉动渊泉。\n时雨宵既零，浮阳蔼平阡。\n夙兴饰耒耜，驱牛登广原。\n竭兹畎亩力，感彼农父言。\n穑事依东作，天时易流愆。\n南邻有逸夫，日晏高枕眠。\n四体苟不勤，何以穷岁年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17177,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王叔武使河南便道省觐二首 其一","author":"边贡","text":"黄河三尺雪，冰厚不可解。\n使君白马来，青云见风采。\n萧萧梁园竹，秀色遥相待。\n邹生与枚叟，借问今安在。\n日暮登吹台，含情向千载。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17178,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王叔武使河南便道省觐二首 其二","author":"边贡","text":"奕奕明农堂，脩楣耀晴彩。\n堂前春草绿，堂上春云叆。\n游子日下还，宫衣试新綵。\n夕膳饪鲜鳞，晨羞荐芳?。\n何以祝亲寿，如山复如海。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17179,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"章氏园饯别升之分得木字","author":"边贡","text":"中园飞雨过，逍遥散遐瞩。\n青云荫华榱，回飙撤炎燠。\n百卉何葳蕤，芳菲鲜如沐。\n驾言赠远人，采采沟中绿。\n迟回未终极，阳景沉西陆。\n归骥嘶长林，翔禽鸣高木。\n感物多所思，褰裳以踯躅。\n踯躅不可留，何以慰衷曲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17180,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王盛","author":"边贡","text":"朝辞双阙下，暮抵三河宿。\n古戍早鸿稀，荒城寒草绿。\n上官山吏拜，行县村童逐。\n冉冉松间亭，何人伴幽独。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17181,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋郊别意为汝南孟翁补作二首 其一","author":"边贡","text":"驱车循广术，言返故乡县。\n晨光一何绮，熹微散秋甸。\n宛宛墟曲中，盈盈露华泫。\n因之感游寓，物候倏已变。\n岂薄骨肉情，遥重桑梓恋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17182,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋郊别意为汝南孟翁补作二首 其二","author":"边贡","text":"桑梓在何许，蔼蔼汝南村。\n绿丛带长薄，清川映柴门。\n言别上春时，当秋始来还。\n禾黍一已穫，膴膴见高原。\n落日樵牧归，凉风散鸡豚。\n登堂见邻叟，呼儿具盘飧。\n依依丘中情，款款醉后言。\n即尔足为乐，安用乘华轩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17183,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别刘子二章 其一","author":"边贡","text":"文车驾四牡，迤逦度层阿。\n伊人秉朝宪，结绶辞承华。\n飞龙御宸极，期运亨以嘉。\n甘霖雨九天，皇泽被幽遐。\n顾念囹圄子，累累诚可嗟。\n宪章苟不渝，歼戮岂在多。\n行哉布天惠，庶以和邦家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17184,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别刘子二章 其二","author":"边贡","text":"昔我二三子，弱冠登皇朝。\n并迹协兰芳，联翩振华镳。\n朝出长杨苑，日夕憩平皋。\n逝矣终遐月，绸缪以逍遥。\n顾子迈南江，刘侯踰上郊。\n嘉好一乖别，驰光倏飘飖。\n临川睇浮云，结思如回潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17185,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵赠李子行之如陈","author":"边贡","text":"迢迢阻欢宴，戚戚伤离居。\n离居结中怀，郁郁惨不舒。\n若人美无度，贞抱冲以虚。\n朝为同朝客，夕暮隔林墟。\n林墟积秋霖，流潦不可除。\n四野晦苍苍，行行安所如。\n驱马临大道，瞻顾空踟躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17186,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉送大司马华容刘公致仕二首 其一","author":"边贡","text":"蔼蔼东山云，覆彼山下堂。\n乘时播皇泽，从龙弥八荒。\n八荒辽且邈，下上以翱翔。\n龙逝鼎湖阴，云归故山阳。\n何以慰蒸庶，私衷郁彷徨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17187,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉送大司马华容刘公致仕二首 其二","author":"边贡","text":"草堂何所有，有兰复有芝。\n采采山之侧，飞仙相与期。\n寄傲云霞问，可望不可追。\n抗手谢城市，去去从此辞。\n徒遗高世风，永系来哲思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17188,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为杨子赋别母诗","author":"边贡","text":"青骊载华毂，宛转度秋坂。\n母氏远别离，客子心缱绻。\n行行采芳蕙，缘陔复循畹。\n山风夕飘飖，吹我车上幰。\n车行不可返，母去日以远。\n何以保黄发，对子加餐饭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17189,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"追送宗之宪副不及","author":"边贡","text":"卧疴起恒晏，出户客已行。\n征车扬素尘，窈窕踰层城。\n行行遵故辙，阡术纵以横。\n望望不见君，悠悠伤我情。\n清川回白日，可以鉴中诚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17190,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送沈仁甫归省二章 其一","author":"边贡","text":"瞻夕临广郊，欢宴良须臾。\n之子驾言返，高登郁踟躇。\n不惜形影阔，所悲岁月踰。\n三江旷绵邈，悠悠限东隅。\n征途慎所须，愿保千金躯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17191,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]