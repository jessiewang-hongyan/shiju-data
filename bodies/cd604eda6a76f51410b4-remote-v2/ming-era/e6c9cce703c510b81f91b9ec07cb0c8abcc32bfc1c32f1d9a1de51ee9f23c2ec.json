56":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过王员外墓","author":"张天赋","text":"七尺英雄骨已收，冢前石马尚抬头。\n淡烟千古峰头晓，彷佛先生正气浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3745,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽河源赖月湖上舍","author":"张天赋","text":"失却苍生望已深，高冈千古弃璆琳。\n光涵夜夜湖中月，一点先生不死心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3746,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吊蓝茂公","author":"张天赋","text":"九十九年连闰月，公年百岁已多馀。\n愿天假我如公寿，饱读人间万卷书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3747,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访三母舅珂公","author":"张天赋","text":"半榻开云日月长，年踰八十卧神光。\n白头楚客怜多病，见舅今朝似见娘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3748,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"承郭淡水秀才过访一绝遗之","author":"张天赋","text":"老我淡然心似水，却逢淡水便投真。\n笑看流入天池去，蚤作商霖济世人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3749,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李村观竞渡临流赋诗言志","author":"张天赋","text":"几度看花空放眼，李村今日醉壶觞。\n罗浮欲上飞云顶，谁向江天弄渺茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3750,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"画鱼","author":"张天赋","text":"老我江湖熟见闻，玉鳞戏藻漾晴纹。\n潜渊在渚浑无定，何日陈歌讽圣君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3751,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"画唐马三首录一","author":"张天赋","text":"驰骋来归我自镐，致身敢怨北山劳。\n华山此去多芳草，收拾将军旧战袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3752,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题陈草堂青云得路画","author":"张天赋","text":"九皋端不入鸡群，羽衣翩跹质也文。\n健翮渐逵天上去，光依日月脱尘氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3753,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凤皇","author":"张天赋","text":"曾佐伶伦作乐场，梧桐冈上唤朝阳。\n太平万象伊谁力，开卷令人笑楚狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3754,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孔雀","author":"张天赋","text":"万丈辉煌锦绣身，自知爱尾类儒林。\n若教飞伴虞庭凤，逼眼文章莫妒嗔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3755,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鹰","author":"张天赋","text":"物情长短仗谁公，铁翮金眸威势雄。\n狐兔顿教踪迹灭，万花红烂醉春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3756,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡头送行者回","author":"张天赋","text":"云梯造就并天齐，一举飞腾趁此时。\n归到故乡如我问，菊开霜落是归期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3757,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日即事","author":"张天赋","text":"读罢俄闻野鸟啼，声声分诉与谁知。\n东皇不肯长为主，故向垂杨恋嫩枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3758,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄古槐云","author":"张天赋","text":"二八衣冠泮水游，奔波空负望封侯。\n今朝得遂归田愿，两只芒鞋踏破秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3759,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观书有感","author":"张天赋","text":"天地难逃一个真，鸢鱼随处露精神。\n子思原有胸中活，吃紧高谈为后人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3760,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹山","author":"张天赋","text":"万竿森玉绿峨峨，碧落风生舞凤多。\n雷震禹门波浪急，蛰龙翻土出龙窝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3761,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"葵花","author":"张天赋","text":"丹心倾倒向炎光，忠爱天然绝异常。\n笑杀崖头狂柳絮，随风无力乱飞扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3762,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄梅","author":"张天赋","text":"江北江南夏已临，枝头颗颗尽垂金。\n几回飞鸟偏惊弹，曾止当时渴士心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3763,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丝海棠","author":"张天赋","text":"紫茎红心七缕丝，歛藏春色许多时。\n上林回首皆零落，独趁西风艳冶姿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3764,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兰花","author":"张天赋","text":"碧影摇阶春昼长，天然灵卉异群芳。\n东风真解幽人意，时递清香入讲堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3765,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送民望兄赴试","author":"张天赋","text":"腹饱煌煌锦绣章，槐花催逼马蹄忙。\n跃然脚板青云上，一笑乾坤六合荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3766,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊行有感","author":"张天赋","text":"洞门无锁碧云封，独立东风怅望中。\n流水不将春不闭，桃花流出满江红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3767,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日写怀 其一","author":"张天赋","text":"一笑登楼兴趣赊，纷纷楼下乱喧哗。\n卖花声逐风来耳，未审秋开几种花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3768,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日写怀 其二","author":"张天赋","text":"云暗巫山万里天，茫茫何处是花园。\n等閒携酒狂游赏，醉倒花前伴蝶眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3769,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬辰京行别亲","author":"张天赋","text":"堂前稽首别双亲，去作朝天万里人。\n四十四年新贡士，儿童应笑老儒绅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3770,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡蒲村河并三十六渡水","author":"张天赋","text":"蒲村渡口唤舟人，此去何劳更问津。\n一分渡分三十六，游人到此倍伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3771,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雩都别罗东郊掌教","author":"张天赋","text":"握手江湄感慨吟，月明千里故人心。\n故乡今向他乡别，顿觉离情异样深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3772,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别雩都余大尹暨陈司训","author":"张天赋","text":"远抱行囊未解琴，天涯何处遇知音。\n东风不与梅花约，妙合乾坤一点心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3773,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赣州忆阳明翁","author":"张天赋","text":"小色空含雨后青，此生何地会阳明。\n晓烟万树笼啼鸟，犹带当年旧颂声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3774,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]