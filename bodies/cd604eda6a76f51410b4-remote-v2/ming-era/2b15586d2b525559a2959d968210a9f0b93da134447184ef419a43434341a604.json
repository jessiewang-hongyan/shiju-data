[{"title":"春日十二首 其五","author":"杨爵","text":"柝声急处雁声高，门掩圜灯夜寂寥。\n念此天涯归路杳，谁将一段楚魂招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28199,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日十二首 其六","author":"杨爵","text":"云掩燕山接地阴，霈城新雨细??。\n即看宇宙均生意，识得乾坤作用心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28200,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日十二首 其七","author":"杨爵","text":"迟日幽圜春又深，闲听燕语散愁襟。\n自知一息延朝暮，到此还余忧世心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28201,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日十二首 其八","author":"杨爵","text":"四年多罪锁危垣，惊眼金吾春草蕃。\n一点孤忠应未死，君王恰有好殊恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28202,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日十二首 其九","author":"杨爵","text":"檐头对雨雨萧萧，墙内葵心墙外桃。\n日暮东风惆怅处，闲看林鸟各归巢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28203,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日十二首 其十","author":"杨爵","text":"十载忧时一念深，竟成身世此浮沈。\n斜阳满目萧条事，写作长歌次第吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28204,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日十二首 其十一","author":"杨爵","text":"萋萋幽草映圜阶，羡尔逢春早意谐。\n此日吾生犹未泯，且歌愁句散愁怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28205,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日十二首 其十二","author":"杨爵","text":"从此超然脱故吾，天空海阔见洪模。\n无容类是假男子，有忍方为真丈夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28206,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶兴五首 其一","author":"杨爵","text":"幽中莫叹久无家，犴户难将国梦遮。\n七载悠悠何所事，赤心白发是生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28207,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶兴五首 其二","author":"杨爵","text":"欲酌春醅伴此身，榻前一盏转伤神。\n年来警戒非因祸，恐致君王杀谏臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28208,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶兴五首 其三","author":"杨爵","text":"风满圜垣月满楼，吾将风月伴幽囚。\n人机本自天机出，解到无思意便投。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28209,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶兴五首 其四","author":"杨爵","text":"坐对窗风一隙清，人间万虑总堪轻。\n无端幽鸟闲来往，却作愁人深树鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28210,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶兴五首 其五","author":"杨爵","text":"一片闲云绕翠松，还成细雨暗千峰。\n此时骨肉遥相见，多在茕茕客梦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28211,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"葵花二首 其一","author":"杨爵","text":"园葵新发几枝红，病里空悬赏念浓。\n只恐花疑吾不好，诗成转寄藉东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28212,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"葵花二首 其二","author":"杨爵","text":"谁把葵栽幽厕中，祗凭新雨秀新丛。\n出门欲赏怜多病，为问今开几个红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28213,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有所思 其一","author":"杨爵","text":"当年各为主恩深，生者难忘死者心。\n将此满腔忧世血，变成赤泪堕囚襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28214,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有所思 其二","author":"杨爵","text":"年年燕塞动悲风，应是人心愿未终。\n死去果然难遽灭，九原还得再相逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28215,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独酌十首 其一","author":"杨爵","text":"春来病未放清歌，惹得春风不甚和。\n偶酌燕山一杯酒，满怀诗兴若江河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28216,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独酌十首 其二","author":"杨爵","text":"老夫不是爱长歌，恐把流光混里过。\n一啸胸中无限量，古今天地在包罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28217,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独酌十首 其三","author":"杨爵","text":"卧醒还酌两三卮，赶出胸中无限奇。\n便笑古今忙脚者，撞来撞去总成痴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28218,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独酌十首 其四","author":"杨爵","text":"一寸修为一寸天，纷纷谁解此闲年。\n从今莫说痴儿梦，囚榻安吾日夜眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28219,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独酌十首 其五","author":"杨爵","text":"男儿寸寸是刚肠，要把尘腔百虑忘。\n聊下墙头一樽酒，不妨独酌对羲皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28220,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独酌十首 其六","author":"杨爵","text":"天地元来只一春，春光到处岂无真。\n须判努力将心戒，莫作圜中忧世人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28221,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独酌十首 其七","author":"杨爵","text":"愁来还要酒消愁，到手必须三四瓯。\n醉后吟诗诗罢卧，风流也属狱中囚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28222,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独酌十首 其八","author":"杨爵","text":"连年病不似今年，和暖风光我却眠。\n春到无诗春自去，而今要补几千篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28223,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独酌十首 其九","author":"杨爵","text":"残春隐隐恰如新，老眼浑看见未真。\n更不分天与人异，只疑共是一团春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28224,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独酌十首 其十","author":"杨爵","text":"阳春几转属艰难，未惜空余两鬓斑。\n若把皇家元气论，入牢强似入深山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28225,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣怀四首 其一","author":"杨爵","text":"故园独此念残春，无奈忧危此一身。\n莫怪片言千百死，从来蹇蹇属王臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28226,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣怀四首 其二","author":"杨爵","text":"自来幽陷几风霜，忧切空余两鬓苍。\n故惜残躯非我意，恐成一死累君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28227,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣怀四首 其三","author":"杨爵","text":"春去还留此喘余，劳心空把百年虚。\n有时不禁伤怀切，万里家乡一片书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28228,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣怀四首 其四","author":"杨爵","text":"一时感激切忧劳，便欲捐躯报圣朝。\n此日孤怀徒耿耿，九重不啻九天高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28229,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送耿良弼 其一","author":"杨爵","text":"与子交游不计年，吴山当日杏花天。\n官贫消息几年绝，忽喜音书到卧边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28230,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送耿良弼 其二","author":"杨爵","text":"七载幽窗与世忘，故人感激意偏长。\n圣明未肯杀忠直，早晚吾将归故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28231,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送耿良弼 其三","author":"杨爵","text":"蝴蝶梦中五十年，将身但合老林泉。\n冥行走入深坑里，空负良朋意戚然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28232,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送耿良弼 其四","author":"杨爵","text":"千里风尘到帝乡，悬悬念我我心伤。\n乔陵安得还相遇，共醉桃花流水旁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28233,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶有感 其一","author":"杨爵","text":"吾狂岁岁系燕台，一盏浊醪百虑开。\n醉后自忘安险处，误将囚所作蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28234,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶有感 其二","author":"杨爵","text":"吾衰久不念东周，那惜斑毛出鬓头。\n海宇升平天自造，可能一手障狂流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28235,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶有感 其三","author":"杨爵","text":"吾心原未解深思，宇宙安能独任之。\n力薄不堪身万死，疏愚空使后人嗤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28236,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶有感 其四","author":"杨爵","text":"老夫经岁卧幽窗，慨世忧时念益长。\n白日似怜吾寂寞，故从小隙放余光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28237,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶有感 其五","author":"杨爵","text":"当年祗抱素餐羞，一日疏狂七载囚。\n安得此时廊庙上，有人聊为我皇忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28238,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣怀","author":"杨爵","text":"雾断长天万里空，邅回日暮倚东风。\n纷如自是人间事，不介悠然胸次中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28239,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪茶","author":"杨爵","text":"雾后飞来满太空，巧将轻片舞条风。\n六花烹作六安水，瑞气都留玉盏中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28240,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"残雪 其一","author":"杨爵","text":"瑶花不但遍燕山，幽地虚池总一般。\n只恐春风吹得急，徘徊再赏片时间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28241,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"残雪 其二","author":"杨爵","text":"同云知不再凄凄，当午阳晖照故迟。\n赏汝笑无春脚味，兴来但有感怀诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28242,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慰章秀才","author":"杨爵","text":"多难不须日叹嗟，男儿身到即为家。\n阶前一片雪融处，饶我春深复种瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28243,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵大尹出狱","author":"杨爵","text":"我在关西子在东，百年适得此相逢。\n从今音问千山隔，人世真如一梦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28244,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读萧处士行状","author":"杨爵","text":"纷纷落到静观中，一点浮云散太空。\n老笔千年心事在，未须身后问穷通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28245,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人归秦","author":"杨爵","text":"春到燕台策马还，文旌指日度函关。\n故人若问圜中兴，道与山林总一般。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28246,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送绪山出狱 其一","author":"杨爵","text":"每道别离今果离，是谁欢喜是谁悲。\n共将心事常相忆，记我丁宁四首诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28247,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送绪山出狱 其二","author":"杨爵","text":"两共幽圜霜雪寒，而今离别要相欢。\n愿君分袂毅然去，莫向铁门回首看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28248,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送绪山出狱 其三","author":"杨爵","text":"二载相逢一旦离，徘徊孰令我心悲。\n此时此地真难得，说与儿孙世讲之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28249,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄偲母","author":"杨爵","text":"偕老糟糠重德音，圜门无奈两年深。\n寄来秦树三囊枣，见汝忧勤一段心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28250,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张本礼归乡 其一","author":"杨爵","text":"弱冠交游三十年，乃今如此共天边。\n送行诗自狱中写，安得不令我恻然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28251,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张本礼归乡 其二","author":"杨爵","text":"送君不肯泪涟涟，知为男儿心志坚。\n归去友人来讯问，道吾长夜已三年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28252,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张本礼归乡 其三","author":"杨爵","text":"目断秋云远盍簪，侧身西望泪沾襟。\n再将半纸新诗出，写我留连不尽心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28253,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭翟尚书","author":"杨爵","text":"哭罢浦周已二年，悲怀今日复潸然。\n两行出自中心泪，一洒尚书柩板前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28254,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"补衣口号次晴川公韵 其一","author":"杨爵","text":"夜补囚衣昼可穿，知君手段自心传。\n成周谁是真男子，千古人夸山甫贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28255,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"补衣口号次晴川公韵 其二","author":"杨爵","text":"会补清霄神慢穿，昔人妙诀己无传。\n高高在上真难措，炼石惟闻娲氏贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28256,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初闻黄鹂","author":"杨爵","text":"共步圜庭佳树阴，逍遥因见古人心。\n囚居莫道无真乐，也有黄鹂送好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28257,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独酌","author":"杨爵","text":"独酌燕山春瓮香，暂开宇内一愁肠。\n醉看榻上无长物，惟有孔家活世方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28258,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜梦四老人俱彷佛百余岁衣冠古朴气象庄重皆天然不事矫饰同坐一木凳予趋前长揖四老人俱起答之渊默无一言觉犹宛在目中以诗记之丁未正月初三日早间书","author":"杨爵","text":"知是商山四老翁，来吾梦里一相逢。\n凤凰千仞当年事，独在平生寤寐中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28259,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读诗偶成","author":"杨爵","text":"肥遁高风百世师，衡门愧子独栖迟。\n洋洋泌水今犹在，还有几人能乐饥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28260,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黍离篇","author":"杨爵","text":"眼底兴衰忽变迁，每将心事问苍天。\n农夫不解行人意，知说离离是有年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28261,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"豳风","author":"杨爵","text":"硕肤一逊德愈光，叹自东人乐绣裳。\n不有风云雷雨动，鸱鸮岂易悟周王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28262,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜怀绪山","author":"杨爵","text":"独坐更初有所思，悠悠令我心如饥。\n谁教咫尺同千瑞，安得梦中一见之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28263,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵白楼出狱 其一","author":"杨爵","text":"圜内霏霏雪片轻，三人同送一人行。\n须知令我难堪处，正是铁门回首情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28264,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵白楼出狱 其二","author":"杨爵","text":"与子周旋风雪中，留连送出白楼翁。\n我曹莫道别离苦，此是圣朝囹圄空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28265,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵白楼出狱 其三","author":"杨爵","text":"两年同难一朝离，世事艰危各自知。\n良友今宵何处去，忆他挥泪正相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28266,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭华州张处士","author":"杨爵","text":"寿享人间八十年，全归正寝是升天。\n可怜一掬囚中泪，不到先生坟土前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28267,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"往年一士夫劝勿作诗作此以晓之 其一","author":"杨爵","text":"罪人岂是好吟诗，诗是罪人拨闷词。\n成后朗吟闲自咏，融融满目见天机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28268,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"往年一士夫劝勿作诗作此以晓之 其二","author":"杨爵","text":"天机满目是襟怀，滚滚都从诗上来。\n付此卷舒同大运，岂容一念自安排。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28269,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"往年一士夫劝勿作诗作此以晓之 其三","author":"杨爵","text":"安排了得见人心，只向天然分上寻。\n要识此间真气象，茫茫宇宙更无垠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28270,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"往年一士夫劝勿作诗作此以晓之 其四","author":"杨爵","text":"无垠所向在先难，一本从来非二三。\n百虑根原由此出，天人未可两般看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28271,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"往年一士夫劝勿作诗作此以晓之 其五","author":"杨爵","text":"罪人岂是好吟诗，诗是罪人自得时。\n独咏一声心已解，此身此罪正相宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28272,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"往年一士夫劝勿作诗作此以晓之 其六","author":"杨爵","text":"此身十载卧松云，千古真传愧未闻。\n中夜思量年少事，雪窗曾读北山文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28273,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"往年一士夫劝勿作诗作此以晓之 其七","author":"杨爵","text":"雪窗若向静中寻，得见昔人藏用心。\n举目霄壤皆可乐，沂源正是此胸襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28274,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"往年一士夫劝勿作诗作此以晓之 其八","author":"杨爵","text":"沂源到此几千年，邹鲁心神在简编。\n谁识真陵数枝草，青青日夜秀窗前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28275,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张公弼","author":"杨爵","text":"抱痛周君意独深，柩前一哭泪淋淋。\n昊天于此昭明处，照见先生一念心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28276,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和人韵四首 其一","author":"杨爵","text":"能从定里息奔驰，即是天人合一时。\n往哲藩篱吾剖破，动无方所静无私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28277,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]