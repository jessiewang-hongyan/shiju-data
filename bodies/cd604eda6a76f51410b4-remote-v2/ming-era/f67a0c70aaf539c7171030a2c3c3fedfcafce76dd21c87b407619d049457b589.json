[{"title":"移居梅园答庞静庵来韵 其二","author":"成鹫","text":"浪迹萍踪两不知，自来自去自寻思。\n天能解语凭谁问，佛本无心是我师。\n何用枯禅同木石，有时冷笑立阶墀。\n吟诗报语陶彭泽，日暮篮舆过莫迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49864,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"移居梅园答庞静庵来韵 其三","author":"成鹫","text":"偶因北院依南院，新辟梅园近竹园。\n多谢居亭旁借径，试穿邻壁别开门。\n云霞推里疑无地，鸡犬声中别有村。\n但使榻边容鼾睡，置身何异古桃源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49865,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄鸣瑴宰梓潼","author":"成鹫","text":"雄才岂合老征尘，暂借儒官作远臣。\n但使文翁能化俗，应知蜀道即通津。\n风云有命宁辞晚，琴鹤随身不厌贫。\n我去入山君作宦，相逢那得下车人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49866,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初住大通寄华林法属","author":"成鹫","text":"偶寻江介宿荒庵，回首城中见盍簪。\n烟雨有时迷穗石，风波无路阻鹅潭。\n木鸡老去慵司晓，白雁秋来早向南。\n家在华林归未得，欲酬恩遇愧同参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49867,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄城中诸友","author":"成鹫","text":"淹留古寺爽归期，延伫江干寄所思。\n野鹤高飞浑不住，沙鸥閒立静偏宜。\n城中明月遥相见，海上孤云去独迟。\n有约不来君莫讶，此心无异住山时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49868,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答伍亦潜来韵","author":"成鹫","text":"鹿鹿生涯草草过，亡羊真觉路岐多。\n梅园自笑不归去，莲社相寻又若何。\n在世可堪成孟浪，此身难得免奔波。\n相闻共有剡溪兴，几日扁舟下白鹅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49869,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答袁崙山来韵","author":"成鹫","text":"久别何堪老景侵，月明池馆忆追寻。\n梅开已爽中秋约，菊绽犹存晚节心。\n云欲御风閒出岫，鸟如卧雪静依林。\n故人未到书先到，洒埽寒斋待苦吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49870,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答霍鼎洲来韵","author":"成鹫","text":"为爱潮声与枕连，移居恰好近江天。\n何人垂钓得双鲤，有客维舟烹小鲜。\n远札忽从鱼腹见，新诗先订虎溪缘。\n群公要识寒山否，乞食狂歌处处禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49871,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答梁安道来韵","author":"成鹫","text":"破院初来僧未閒，茅堂添结两三间。\n云容借住无宾主，鸥本忘机任往还。\n长揖朱门归矮屋，高悬青眼在深山。\n悠悠世路谁知者，莫怪逢君便解颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49872,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答洗厚光来韵","author":"成鹫","text":"十日柴门九不开，红尘飞过又黄埃。\n无心暂住何曾住，有约能来及早来。\n留客晚添煨芋火，怀人频上钓鱼台。\n世间不少攒眉者，惟许先生去复回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49873,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答张耀南来韵","author":"成鹫","text":"面面蒹葭路不通，渔灯移傍佛灯中。\n迟君羊石三城月，老我鹅潭一夕风。\n去棹归帆无远近，淡烟疏雨入雷同。\n住来渐到忘言处，凭语真难举似公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49874,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题壁","author":"成鹫","text":"长与渔樵作近邻，万缘歇尽得閒身。\n田园自是休心地，朝市何能恕懒人。\n且喜林间无杂树，岂知门外有通津。\n客来莫怪逢迎简，牛放西溪牧未驯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49875,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"至日","author":"成鹫","text":"眼边斜日下高舂，又放閒人过一冬。\n笑倚梅花搔白发，懒吹葭管候黄钟。\n药苗带雪抽新笋，鹤势冲寒唳远峰。\n大地阳回人未觉，闭门空老最高松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49876,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海云分卫赋得锡飞常近鹤杯渡不惊鸥","author":"成鹫","text":"隐隐长空振六环，金鸥乘愿出名山。\n云中羽客相容与，沙际幽禽自往还。\n高步不妨天路直，忘机真称野情閒。\n凌风破浪输神足，物我无心石也顽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49877,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送梁太史还史馆","author":"成鹫","text":"昨宵奇梦出江干，祖饯殷勤送显官。\n此事十年曾未见，逢君一笑太无端。\n鹪鹩过雪栖偏稳，鸑鷟乘风去不难。\n敢望留衣与僧别，前途多少范生寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49878,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和社中诸子咏一茎二色红白莲花","author":"成鹫","text":"分形合质羡仙葩，濯濯清渠灼灼华。\n螺女半身呈绛袖，鹤灵兼顶养朱砂。\n兔乌角立无双影，楚汉中分总一家。\n笑把丹铅付词客，雪篇吟对赤城霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49879,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小除前五日立春","author":"成鹫","text":"视历始知今岁闰，闭门先得隔年春。\n蹉跎大尽无多日，取次小除才半旬。\n野老焚香祠太乙，村童布席待庚申。\n谁家腊里吹阳律，冻谷寒消斗柄寅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49880,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸未元日李远霞过宿夜话","author":"成鹫","text":"熟客乍惊生面目，青春微换白髭髯。\n新年佛法休相管，今夜诗题且共拈。\n风引涛声来茗椀，灯移人影出筠帘。\n明朝孤棹乘潮去，有兴重来定不嫌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49881,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送双桂天公","author":"成鹫","text":"一见愚关便不疑，受恩深处少人知。\n何妨得座披衣后，正好观山玩水时。\n法社颓纲凭振起，祖庭虚席莫归迟。\n自怜后进身先老，欲侍巾瓶未可期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49882,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕赋得“暗尘随马去”","author":"成鹫","text":"为看鳌山跨锦鞯，飞埃红雾杂连钱。\n邻虚冉冉随衔勒，野马纷纷逐管弦。\n弱质半依韩国树，微躯愿执祖生鞭。\n时人要识元规否，去住和光却黯然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49883,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答报资旷老人见寄来韵 其一","author":"成鹫","text":"闹市穷山两不宜，水边林下且随时。\n孤松过午亭阴转，顽石当门捷径移。\n乌兔盈亏忙里失，鱼龙潜跃静中知。\n大鹏飞上阎浮树，应笑鹪鹩老一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49884,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答报资旷老人见寄来韵 其二","author":"成鹫","text":"出世难兼入世宜，别山长忆住山时。\n潮因风力声偏壮，月逐舟行影不移。\n往事每逢前辈说，此心惟许大人知。\n他年得侍巾瓶去，堂下宁辞为折枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49885,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答报资旷老人见寄来韵 其三","author":"成鹫","text":"境静人閒性所宜，住来遑问此何时。\n江山烟雨归名邈，今古晴阴互转移。\n兔径拓开迟客至，象王行处少人知。\n无情也解通消息，荔子先红向北枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49886,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答报资旷老人见寄来韵 其四","author":"成鹫","text":"却缘懒惰得便宜，凿枘方圜不合时。\n心在蒲团无去住，身随茅屋任迁移。\n名山路近终须到，枯木花开未可知。\n天地喻来齐一指，何妨容我作骈枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49887,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠黄寿翁","author":"成鹫","text":"旧隐曾邻上柏乡，高山遥仰在仙羊。\n移居近向鹅潭住，隔水还同鸟道长。\n千顷汪波今叔度，一庭兰桂昔元方。\n他时得作登龙客，又引儿孙上玉堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49888,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吕广文典教程乡","author":"成鹫","text":"道重东南正此时，昌黎千古有遐思。\n地经往哲曾留泽，文待斯人更起衰。\n白社只今无客至，青云何处与僧期。\n西岩本是吾家物，乘兴能来未可知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送霍友山访吕广文谒佘学士","author":"成鹫","text":"曾过梅州未入城，送君此去不胜情。\n吟随诗派今推吕，俗访遗贤旧姓程。\n七贵门前凭直入，百花洲畔莫閒行。\n莱衣留在崆同下，遥计归心在鲤庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荷珠","author":"成鹫","text":"聚处无常散即休，疏星漙露水西头。\n分明盈手难持赠，珍重逢人莫暗投。\n一月千江真也幻，十风五雨去还留。\n萍踪倾盖知多少，零落泥涂遂不收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日南园诸子过访","author":"成鹫","text":"野塘荒圃近西偏，石角松根辄缆船。\n临老投閒能几日，暂时安稳当经年。\n客曾有约须乘兴，我本无心莫问禅。\n一度吟诗一归去，清风留在水云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄璋田家无介","author":"成鹫","text":"逢人往往问璋田，见说辞家已一年。\n吟苦近知诗律细，书来惟道主人贤。\n西风白雁同为客，南国黄花老此禅。\n木叶经秋偏有色，思君题破落红笺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄谷旸惟一师","author":"成鹫","text":"草草将诗寄谷旸，更凭高足问行藏。\n蒲团别后穿多少，华发春来白短长。\n静者年高休问腊，老人身健罢抄方。\n室中狮子能哮吼，代与吾师坐道场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49894,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答李素公广文来韵","author":"成鹫","text":"郑虔官罢绿尊开，未免攒眉入社来。\n日送飞鸿天以外，心期野鹤水之隈。\n宦情寂莫歌丛桂，世味酸辛问大梅。\n早晚抽身好归去，儿孙争笑背如台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49895,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽黄摄之","author":"成鹫","text":"柳坡渡口熟黄梅，正好尝酸去不回。\n月落恰当花落候，钟声还被鼓声催。\n身随白业归乡井，头戴黄冠上夜台。\n净埽庭前晒经石，迟君于此曝龙腮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49896,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和张子白杨鬯侯游飞来寺见寄 其一","author":"成鹫","text":"县衙冷似数家村，方外多情是夙根。\n点检道书知福地，提携琴鹤到山门。\n花边雨过收棋局，席上诗成罢酒樽。\n何事定心泉下水，跳珠漱玉不胜喷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49897,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和张子白杨鬯侯游飞来寺见寄 其二","author":"成鹫","text":"白头僧住白云村，老树根烹老菜根。\n斸断松虬开小径，移来石虎守空门。\n名山往往迟双屐，浮海区区负一樽。\n多谢新诗劳远寄，开缄如对峡泉喷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49898,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和张子白杨鬯侯游飞来寺见寄 其三","author":"成鹫","text":"耳闻旧社长蒿莱，寂寂三堂昼未开。\n猿掷馀桃鸣石磬，鸟衔腥食立香台。\n百年流水心俱远，一片閒云去不来。\n古调更张难草草，小弦刚被大弦催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49899,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和张子白杨鬯侯游飞来寺见寄 其四","author":"成鹫","text":"却忘世路有平陂，白石苍苔似布棋。\n天籁响来人籁寂，五言禽和七言诗。\n奇峰隔水呈三面，斜日衔山露半规。\n我已同游君信否，默存惟有化人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49900,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和张子白杨鬯侯游飞来寺见寄 其五","author":"成鹫","text":"远近游踪分不分，峡江水接粤江濆。\n林间独鹤能无梦，天上双凫自有群。\n古寺飞来空想像，雨花散去任缤纷。\n缄书报语神明宰，持赠惟须岭上云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49901,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答张子白来韵 其一","author":"成鹫","text":"东林争敢似南皮，一月烦君两寄诗。\n水浸田园生计拙，尘封笔砚报书迟。\n委心穷达能无事，极目云山有所思。\n九夏安居才及半，商量移棹待寻谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49902,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答张子白来韵 其二","author":"成鹫","text":"积雨经旬怅滞霪，鼓钟林下自钦钦。\n频来好友怀中札，识得斯人物外心。\n梦到峡山无远近，居邻城市失高深。\n闻君笑我为诗癖，老病年来废苦吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49903,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答张子白来韵 其三","author":"成鹫","text":"十家为甲五为邻，是处应难住懒人。\n行拄短筇扶病骨，去寻枯树息吟身。\n片云无意成舒卷，尺蠖宁知有屈伸。\n密约名山倍饥渴，黄梅时节便生津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49904,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答张子白来韵 其四","author":"成鹫","text":"别业初开许挂单，秋生乔樾试新寒。\n过桥三笑惭非远，吹笛一声如是桓。\n久静不妨行当住，安居自谓易偏难。\n相期世外为知己，青白凭君换眼看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49905,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答张子白来韵 其五","author":"成鹫","text":"满地清风满县花，城南城北尽桑麻。\n经年不下陈蕃榻，是处偏宜绮季家。\n风雨怀人吟蟋蟀，烟霞迟我渡艑艖。\n何时得便寻君去，閒却奚囊讲法华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49906,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答张子白来韵 其六","author":"成鹫","text":"山绕松门水绕溪，石房深洞老猿栖。\n寻思古寺多年别，回首孤峰万象低。\n香印半销无宿火，苔钱全没有留题。\n主人记得灵山否，世路多岐定不迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49907,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西流暴涨阡陌淹没破寺宛在水中邑明府姚齐州拿舟过访快谈日夕乃别即事赋赠","author":"成鹫","text":"野寺停舟当下车，问津刚遇老长沮。\n抛将吏事谈骚雅，借得僧房视簿书。\n四座风生能偃草，一朝水到便成渠。\n相寻相送还相笑，笑我临渊不羡鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49908,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和张子白过寺韵 其一","author":"成鹫","text":"频频愿见见何如，兀兀安居怅索居。\n梦里山川怀里事，眼中人物袖中书。\n过桥有约迟彭泽，献赋无心拟子虚。\n久住渐知城市近，相逢乞地结茅庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49909,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和张子白过寺韵 其二","author":"成鹫","text":"尘中难得此身安，高处偏宜著眼宽。\n旧识渔樵惭宿诺，新知猿鹤快追欢。\n三江过雨奔如马，双峡连云立似桓。\n此地相期好乘兴，为君先制远游冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49910,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重阳前五日山行","author":"成鹫","text":"节序相将逸兴豪，乌藤白足笑吾曹。\n行行听瀑秋心冷，得得登峰云影高。\n折取山花聊当菊，书成霜叶即题糕。\n旁人莫讶兹游早，五日重来不惮劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49911,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中和张子白 其一","author":"成鹫","text":"名山有约晚思归，动处何曾与静违。\n暂宿仙槎甜鹤梦，偶随星使别渔矶。\n锦帆挂月潮初上，红树临风叶半飞。\n李郭同舟吾岂敢，不妨云水有光辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49912,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中和张子白 其二","author":"成鹫","text":"波光人影两摇摇，竹缆牵云过断桥。\n海气涳濛双塔迥，岸容点缀数花娇。\n襟期共洗临清驶，眼界全空在泬寥。\n枕畔南华经一卷，起看秋水到逍遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49913,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中和张子白 其三","author":"成鹫","text":"舟居不信有閒忙，细雨轻风过小塘。\n但见千江印明月，不须四大作禅床。\n片云西去疑无路，一雁南来觉有霜。\n莫笑转蓬归未得，请看寥廓已高翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49914,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中和张子白 其四","author":"成鹫","text":"随人俯仰与天游，疏放宁知礼数稠。\n梦到市朝增愧悔，出逢泉石足淹留。\n不知何处空诸有，所谓伊人在十洲。\n寄语登瀛老词客，隔船吟咏也同舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49915,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游松皋书院寄张子白","author":"成鹫","text":"兴尽方归兴尚豪，一回凭眺一萧骚。\n林风并入松涛乱，云日相摩峡势高。\n百里同文思大雅，孤峰独立笑方袍。\n欲知雨露无私处，满地黄花閒白蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49916,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别张子白","author":"成鹫","text":"飘飘天地一沙鸥，偶逐仙凫到十洲。\n客梦不离烟雨寺，归心分付峡江流。\n丹霞日暮知难到，中宿云深未易游。\n一曲长歌留别去，相期应在虎溪头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49917,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别李东园","author":"成鹫","text":"云山之麓珠江隈，蹉跎行脚归乎来。\n过桥一笑兴不浅，中途未到心先回。\n大田多稼食轮转，东篱采菊天花开。\n人生得此亦已足，旁观当局者谁哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49918,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送十影师还丹霞","author":"成鹫","text":"名山有约昔淹留，岐路沉吟忆旧游。\n竹里闻鸡迟见日，花边鸣鴂早知秋。\n风尘老我同漂梗，云水何人更倚楼。\n从此居亭应有主，不愁无地牧顽牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49919,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自笑","author":"成鹫","text":"红尘白发两销磨，抚景悲凉笑复歌。\n学道因循焚砚晚，著书惭愧鬻文多。\n菜佣日减长门价，风伯时扬业海波。\n旧隐欲归归未得，馀生无计补蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49920,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪夜过严滩谒严子陵先生祠","author":"成鹫","text":"兴来借得剡溪棹，怀古长歌过富春。\n一夕星辰加腹客，半天风雪羡鱼人。\n钓台自觉云台小，滩水宁知白水真。\n不用羊裘换蓑笠，狂奴游戏偶垂纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49921,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春访杨式公寓馆","author":"成鹫","text":"娇鸟啼花客里春，诗情物色逐年新。\n寒江记得同舟约，汾水初寻下榻人。\n琴瑟多情聊寄迹，奚囊无事不离身。\n明朝我欲寻山去，翻笑行云去住频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49922,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿富春山与霍西牛话别","author":"成鹫","text":"松灯照梦梦归迟，兀兀行藏说向谁。\n到眼碧峰看不厌，满头白发欲何之。\n别山知有还山约，在世难忘出世期。\n待我罢参君罢讲，重来此地结茅茨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49923,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阳春道中寄霍西牛","author":"成鹫","text":"熟道轻车何处僧，风吹鹤发乱鬅鬙。\n探奇选胜心先往，带水沾泥愧未能。\n身世飘零归社燕，情怀泮涣涉春冰。\n不周岩畔遥相忆，借问同参记得曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49924,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽梁药亭太史","author":"成鹫","text":"罢馆还家鬓有丝，文星昨夜忽骑箕。\n门前客散空啼鸟，池上僧归独咏诗。\n未免分香怜少妇，定将遗草属诸儿。\n岭南作者凋零尽，惆怅何人为起衰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49925,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄郑珠江太史","author":"成鹫","text":"记得当年太史公，桥头一笑去匆匆。\n置身九棘三槐上，留语千岩万壑中。\n别后冷将煨芋火，閒来忘却卖松风。\n金经拓就遥相质，道眼凭君辨异同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49926,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]