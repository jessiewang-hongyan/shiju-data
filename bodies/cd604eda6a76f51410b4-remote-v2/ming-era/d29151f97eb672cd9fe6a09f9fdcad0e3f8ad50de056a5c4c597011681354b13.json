,"path":"明_3.csv","pointer":35652,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"车中即见四首 其四 双窥","author":"郭之奇","text":"独鸟依深树，孤云出远山。\n双窥车马次，何客最烟颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35653,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"返照","author":"郭之奇","text":"雨过青山暮，行云湿尚飞。\n忽开峰外日，返照及征衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35654,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客程","author":"郭之奇","text":"古道夕阳平，衔西送客程。\n客程无止息，明月复东迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35655,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与伯常兄小酌","author":"郭之奇","text":"篷开山献绿，杯动水含烟。\n不用池塘梦，偏宜共酒船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35656,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊大滩","author":"郭之奇","text":"万树临滩峡，秋声出水寒。\n孤舟相对宿，有梦亦频残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35657,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊赛上","author":"郭之奇","text":"寸缆横滩雾，孤篷没树烟。\n昼行观逝者，夜泊得如渊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35658,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"下姑听啼鸟","author":"郭之奇","text":"晓鸟宿秋枝，连啼急水湄。\n归舟难久听，莫使去舟知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35659,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自大姑至硿头酌酒数滩","author":"郭之奇","text":"舟仅容瓶屈，举杯滩半沸。\n一滩酒一杯，恰尽杯中物。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35660,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对春鸟有感十首 其一","author":"郭之奇","text":"巧鸟窥帘语，飞飞令客思。\n无情翻有意，偶对似终期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35661,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对春鸟有感十首 其二","author":"郭之奇","text":"晓鹊求多舞，昏鸦不愿啼。\n群情分所见，微物转相迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35662,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对春鸟有感十首 其三","author":"郭之奇","text":"仓庚守候鸟，虽小系春声。\n最重农桑课，閒关士女情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35663,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对春鸟有感十首 其四","author":"郭之奇","text":"燕巧行霜怯，鸠新探雪威。\n相要图暖计，聚翼向朱扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35664,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对春鸟有感十首 其五","author":"郭之奇","text":"漫道鸠居鹊，真成鼠化鴽。\n春风容物变，万族自喧哗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35665,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对春鸟有感十首 其六","author":"郭之奇","text":"反舌何时至，乘春入帝都。\n啼莺含愤恨，力小未能驱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35666,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对春鸟有感十首 其七","author":"郭之奇","text":"为群非鸷种，告好亦鸩媒。\n不解诸禽性，难辞失伴哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35667,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对春鸟有感十首 其八","author":"郭之奇","text":"野鹜终朝食，云鸿竟日飞。\n无心分秽洁，何意较瘦肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35668,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对春鸟有感十首 其九","author":"郭之奇","text":"下视逢鸱嚇，冥飞羡鹄过。\n谢鸱相勖意，因鹄远虡罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35669,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对春鸟有感十首 其十","author":"郭之奇","text":"草色愁鹈鴂，乡心寄鹧鸪。\n不知春既老，竟与物为徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35670,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"所见四首 其一","author":"郭之奇","text":"去日葵倾赤，归时菊散英。\n登临观物意，来往较秋情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35671,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"所见四首 其二","author":"郭之奇","text":"总在秋光路，云山异浅深。\n山云将白尽，随地绕秋阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35672,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"所见四首 其三","author":"郭之奇","text":"晚山相对碧，残照网秋风。\n秋色如烟缈，风林一望中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35673,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"所见四首 其四","author":"郭之奇","text":"心清秋许见，山远暮能光。\n微著烟云色，所思不可方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35674,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"车中即事五首 其一 朝夕","author":"郭之奇","text":"计日尘容惯客，沿堤柳色迷天。\n朝暾马右分旭，夕照襟西送烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35675,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"车中即事五首 其二 晓夜","author":"郭之奇","text":"鸡逐晓风唤客，鸟衔夜月窥人。\n便寻家梦能几，况复醒来不真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35676,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"车中即事五首 其三 南北","author":"郭之奇","text":"野旷青天作幕，烟深白日游丝。\n南车北马何极，春草秋花共驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35677,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"车中即事五首 其四 西东","author":"郭之奇","text":"拭目云飞在阙，惊心鸟语归林。\n谁云西向真乐，还忆东山卧深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35678,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"车中即事五首 其五 闻问","author":"郭之奇","text":"所以随缘得句，频因触物关思。\n愁闻我马嘶激，若问傍人那知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35679,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"连日苦雨讯杨承之","author":"郭之奇","text":"一天云雨如织，尺地往还各疏。\n折角先生不出，草玄夫子何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35680,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"讯王山人","author":"郭之奇","text":"近山翠色多滴，远树烟容自牵。\n难付子綦偃仰，伫看摩诘诗篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35681,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"讯悦则上人","author":"郭之奇","text":"斋北斋南雨点，溪前溪后流声。\n石门泉韵非远，城郭风尘暂清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35682,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宛在堂中即事 其六","author":"郭之奇","text":"在水之中搆室，开窗于北高眠。\n何知汉与魏晋，自谓无怀葛天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35683,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宛在堂中即事 其十九","author":"郭之奇","text":"屈指粤东名业，曲江南海琼山。\n斯文未丧今日，后死何人可班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35684,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四月一日二首 其一","author":"郭之奇","text":"晓来风色北窗归，一岁几何三月非。\n谁道时光不作意，晴阴云日半依违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35685,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四月一日二首 其二","author":"郭之奇","text":"落尽黄梅四月天，空枝一鸟语春还。\n早知梅熟春同去，怨却花时信早传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35686,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"系春","author":"郭之奇","text":"曾无好事系春华，冷落閒庭片片花。\n半榻幽清贪晓睡，三杯软饱觅生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35687,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"问春","author":"郭之奇","text":"几将閒绪问春华，愁客无端怪落花。\n花落何堪兼雨夜，客愁可奈是天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35688,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"说士与逸民之品不同","author":"郭之奇","text":"张仪寸舌犹问妻，子陵两足可加帝。\n终当披裘耕富春，何事读书学游说。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35689,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得时与避世之怀各一","author":"郭之奇","text":"渊明不折小儿腰，子房却进老人履。\n归去仍招白衣人，功成亦从赤松子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35690,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"呼奚觅怪石二首 其一","author":"郭之奇","text":"山琢胎形水织纹，千年濯魄冷清濆。\n无端过客多閒绪，携取东归意亦慇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35691,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"呼奚觅怪石二首 其二","author":"郭之奇","text":"横流堆叠乱波容，戏拾诸般置夹笼。\n借问参寥谁处是，好和清水作相供。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35692,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"衢州道中二首 其一","author":"郭之奇","text":"西流一水向东潺，夹右诸陵并道擐。\n归路惟多千嶂阻，愁来欲把众峰删。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35693,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"衢州道中二首 其二","author":"郭之奇","text":"云影相从树影亲，近峰如作远峰臣。\n奇观始信天工巧，谁把丹青挂夕晨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35694,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十八早自从叔公车舫至峡江过伯常兄舟中共酌醉后口占二绝 其一","author":"郭之奇","text":"沙明涛白豁天开，江远舟轻破月来。\n阮氏风流今日事，相逢急进手中杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35695,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十八早自从叔公车舫至峡江过伯常兄舟中共酌醉后口占二绝 其二","author":"郭之奇","text":"仙舟飘渺溯潺湲，访载寻稽忽可扳。\n一笑一歌江日暮，流光山色窅然閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35696,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"时得家报伯常兄城侄痘疹新愈喜甚口占相慰二首 其一","author":"郭之奇","text":"万里江云收玉峡，数行家信出金川。\n为兄同慰凤毛种，不惜歌欢鹢首船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35697,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"时得家报伯常兄城侄痘疹新愈喜甚口占相慰二首 其二","author":"郭之奇","text":"烟波江上恰相随，春草池塘未足奇。\n醉罢不知霜色夜，诗成已是月明时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35698,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过丰城剑江二首 其一","author":"郭之奇","text":"剑光何德烛天河，已没平津又若何。\n神物终非人世玩，江充长与万年磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35699,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过丰城剑江二首 其二","author":"郭之奇","text":"江来万里独何求，剑去千年不可留。\n夜半霜华生月色，还疑精气逐舟浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35700,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望庐山有引","author":"郭之奇","text":"相对无缘认岭峰，入看祇许白云同。\n却于舟行成横侧，漠漠天屏一镜中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35701,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶占","author":"郭之奇","text":"晓风飞去片花吹，暮雨低来折柳垂。\n愁绝子规声欲断，美人独立意迟迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35702,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟发雩都苦雨随缘成八首 其一","author":"郭之奇","text":"一苇何堪万点侵，无人告诉只呻吟。\n中宵料理三移枕，竟日绸缪两蔽襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35703,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟发雩都苦雨随缘成八首 其二","author":"郭之奇","text":"无端林响引风窥，多事桅声报客知。\n缘岸低来同懒困，偏帆迟去半欹危。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35704,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟发雩都苦雨随缘成八首 其三","author":"郭之奇","text":"一片春深积雨吹，花开如喜落花悲。\n未知悲喜终谁得，雨却归春春亦疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35705,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟发雩都苦雨随缘成八首 其四","author":"郭之奇","text":"招招舟子笠蓑蒙，踯躅溇沙湿岸中。\n惊起浴鸥飞别浦，横拖醉竹压孤篷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35706,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟发雩都苦雨随缘成八首 其五","author":"郭之奇","text":"缘溪处处野花逢，裔草拖泥乱影重。\n恰似春光怜莫主，传教细雨沐新容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35707,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟发雩都苦雨随缘成八首 其六","author":"郭之奇","text":"夹陵一带碧波洄，雨脚迷离纷欲催。\n何处村烟云卷去，随缘鸟语客传来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35708,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟发雩都苦雨随缘成八首 其七","author":"郭之奇","text":"泯泯朝流晚更添，洄沙拂渚浪花兼。\n贪看激石分波过，忘却迟舟缩棹黏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35709,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟发雩都苦雨随缘成八首 其八","author":"郭之奇","text":"已恨愁来春欲痴，那堪思去雨犹疲。\n可怜百日思愁绪，迸与今宵春雨知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35710,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小卧口占二首 其一","author":"郭之奇","text":"久客何思空默默，斗舟伸足便蘧蘧。\n篙声落石午魂乱，竹影穿窗暮眠疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35711,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小卧口占二首 其二","author":"郭之奇","text":"已拚三旬从在水，偶随此刻卧行天。\n浮空一片孤云往，薄暮归山对我眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35712,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"走笔向宋尔孚乞绛桃","author":"郭之奇","text":"耽花成癖况当春，频向东风觅故人。\n闻说绛桃三月放，芳园可许一枝新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35713,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"短叶乞花不能尽意昨者一枝新之句主人以为求插净瓶乃余所求者本也","author":"郭之奇","text":"谁使陵溪别有春，桃津多事向渔人。\n当年若解贻仙种，不遣花飞出世新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35714,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"更乞百叶一种","author":"郭之奇","text":"珍重当年禁苑春，助娇消恨旧何人。\n风流争似潘郎得，付与河阳满县新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35715,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乞绛桃而得碧桃因向主人称谢","author":"郭之奇","text":"露种原从天上春，云根移自日边人。\n一枝清韵堪盈匊，不数妖红万朵新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35716,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乞绛不与而与碧兼为花神解嘲","author":"郭之奇","text":"金谷丛中万种春，淡妆羞见艳妆人。\n自知颜色承恩少，飞入茅庭逞素新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35717,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"尔孚复以诗乞余长春花新本数株此花种固来自尔孚也","author":"郭之奇","text":"娇丛离陆不胜春，春盛还归春主人。\n若使花情犹识旧，此朝投报莫疑新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35718,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"林九娘墓三首 其一","author":"郭之奇","text":"比年贼寇乱村烟，嬴得偷生问节全。\n里妇惊传刀下语，狂奴许杀未容怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35719,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]