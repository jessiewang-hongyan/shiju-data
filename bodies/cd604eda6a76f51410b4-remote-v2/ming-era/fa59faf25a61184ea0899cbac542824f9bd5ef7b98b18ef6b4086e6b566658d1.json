[{"title":"镜园和邓玄度步韵 其四","author":"李云龙","text":"日暮长林下，霜清落木齐。\n寒流驱木马，衰草闹沙鸡。\n练影摇高岸，歌声出大堤。\n诗成欲有赠，红叶正堪题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42574,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镜园和邓玄度步韵 其五","author":"李云龙","text":"笑指金光草，閒披玉蕳文。\n妙香浮水出，疏磬隔花闻。\n独木横清涧，高松挂白云。\n芝田药畦上，鸾鹤自为群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42575,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镜园和邓玄度步韵 其六","author":"李云龙","text":"大地标形胜，诸天锁泬寥。\n且拚面壁坐，不用隔江招。\n明镜悬秋月，梵音来暮潮。\n谁浮苦海上，甘作半篷飘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42576,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镜园和邓玄度步韵 其七","author":"李云龙","text":"海内推词伯，文章仆命骚。\n琴瑟原自别，竿混莫能逃。\n脩月斧堪试，穿阳弓暂韬。\n毋将济川楫，长汎武陵桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42577,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镜园和邓玄度步韵 其八","author":"李云龙","text":"断岸收残雨，清溪染落花。\n呼童扫芳径，手自掣流霞。\n报午林中狖，嘶风枥下騧。\n逍遥因有得，滴露注南华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42578,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镜园和邓玄度步韵 其九","author":"李云龙","text":"忆昨清秋日，相随杖履行。\n水光凉欲沁，霜气拂横生。\n黄菊犹含笑，丹枫未解醒。\n胜情徒自惬，幽意莫能名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42579,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镜园和邓玄度步韵 其十","author":"李云龙","text":"胜概一丘兼，归来自养恬。\n入春花事好，经雨药苗甜。\n明月时窥户，东风为捲帘。\n一泓镜园水，应照戟如髯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42580,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镜园和邓玄度步韵 其十一","author":"李云龙","text":"何用语呢喃，谗夫枉自谗。\n宜人有丘壑，毋恙是归帆。\n治地延修竹，为庵倚翠岩。\n龙阿知我者，不必咏长镵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42581,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镜园和邓玄度步韵 其十二","author":"李云龙","text":"山雨蹴溪来，林烟昼不开。\n砌芳铺碎锦，阶木挺群才。\n挈篚收松子，编篱护竹胎。\n桃花流水里，人拟是天台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42582,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镜园和邓玄度步韵 其十三","author":"李云龙","text":"瘴岭归来日，端居独怆神。\n历穷边地苦，援绝帝乡亲。\n直谏馀焚草，先几是徙薪。\n君王忧社稷，能不念孤臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42583,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镜园和邓玄度步韵 其十四","author":"李云龙","text":"垂杨覆溪水，长系木兰船。\n啸咏有馀地，升沉莫问天。\n桑麻原上业，鸡犬洞中仙。\n笑问海东石，何人先着鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42584,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镜园和邓玄度步韵 其十五","author":"李云龙","text":"鸱鸮群引类，蝼蚁亦称王。\n且自为雌伏，要能与雁行。\n采蘋当玉食，呼酒换金章。\n独有囊中草，犹馀鸡舌香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42585,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李木仙 其一","author":"李云龙","text":"何因浮海至，为觅返魂香。\n别鹤声多怨，孤鸿影自伤。\n烟花迷夜梦，风雨远归装。\n千古钟情辈，荀郎又李郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42586,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李木仙 其二","author":"李云龙","text":"远怀穷碧落，幽恨彻重泉。\n无路逢金母，何心證木仙。\n湘江添泪竹，鄂渚结愁烟。\n好向三生石，还寻再世缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42587,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送孙稚明 其一","author":"李云龙","text":"我自离乡国，三年怀此都。\n閒谈击剑术，空对和歌徒。\n京邸少投剌，关门曾弃襦。\n烦君驻徵骑，为问酒家胡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42588,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送孙稚明 其二","author":"李云龙","text":"献策长安后，回翔已十年。\n身为万夫长，家有十三篇。\n忧国惟双涕，治装无一钱。\n相逢湖水上，同调转相怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42589,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送孙稚明 其三","author":"李云龙","text":"湖水明于玉，春风好泛舟。\n如何杨柳色，忽挂别离愁。\n少妇空多恨，萧郎梦远游。\n情知匹马道，萧飒蓟门秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42590,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨后阮集之招同林六长徐介白程荩臣集咏怀堂分得八庚 其一","author":"李云龙","text":"芳林带馀润，满院绿阴生。\n为听流莺啭，弥深求友情。\n烧灯过午夜，把酒话生平。\n醉向歌儿道，毋轻唱渭城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42591,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨后阮集之招同林六长徐介白程荩臣集咏怀堂分得八庚 其二","author":"李云龙","text":"雨好晴亦好，悠然心赏生。\n楼台乘晚霁，枕簟有馀清。\n留客听啼鸟，呼童扫落英。\n别有千金笑，不醉若为情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42592,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沥湖渔棹为张道尊赋 其一","author":"李云龙","text":"一片沥湖水，烟波十里平。\n白云长就涤，惊浪不曾生。\n问渡桃花远，浮舟莲叶轻。\n还闻父老道，不及使君清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42593,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沥湖渔棹为张道尊赋 其二","author":"李云龙","text":"见一丈夫钓，临渊羡有馀。\n还应佐天网，岂待饵凡鱼。\n斗柄日在手，湖光尝满裾。\n仍期汛河汉，不羡武陵渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42594,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴充符招同集之游修竹庵 其一","author":"李云龙","text":"绿玉削寒丛，萧萧古寺中。\n破烟楼半出，披霭路初通。\n捲幔临飞雉，挥弦送远鸿。\n萧然凉籁起，仙梵满花宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42595,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴充符招同集之游修竹庵 其二","author":"李云龙","text":"正自厌嚣尘，相携就此君。\n清风飘翠色，衣袂有馀芬。\n静听数声鸟，閒分半席云。\n暮钟催客去，归梦尚氤氲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42596,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黎君选之官兴业 其一","author":"李云龙","text":"南园文酒会，与子分尤亲。\n宝剑赠烈士，幽兰遗美人。\n向来依北阙，亦得共芳晨。\n犹忆联镳去，香街踏玉尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42597,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黎君选之官兴业 其二","author":"李云龙","text":"苍梧西去近，不用怅蛮烟。\n此地邻勾漏，前贤有稚川。\n君饶红玉质，自协丹砂缘。\n何必占朝谒，方知令是仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42598,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过姑熟访曹元甫光禄 其一","author":"李云龙","text":"迢递天门外，清江一带环。\n遥乘谪仙月，来访谢公山。\n胜地谁为主，伊人在此间。\n相闻牛渚咏，应为一开颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42599,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过姑熟访曹元甫光禄 其二","author":"李云龙","text":"君如稀有鸟，千仞览清晖。\n六月久已息，三年令待飞。\n洪流沧海远，天路白云微。\n斥鴳莫相笑，榆枋非所依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42600,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阮宝夫将游朗宁过访啸楼止宿有赠次其韵 其一","author":"李云龙","text":"小楼春水上，客到梦俱澄。\n笑指东方白，遥看旭日升。\n在家能出世，有发亦为僧。\n但自空诸有，何从得未曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42601,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阮宝夫将游朗宁过访啸楼止宿有赠次其韵 其二","author":"李云龙","text":"西江杨柳绿，孤棹去搴芳。\n都峤千峰秀，蛮滩一水长。\n榻知悬郡阁，梦定到池塘。\n不厌南枝小，还随越鸟翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42602,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李美发 其一","author":"李云龙","text":"结束藤花箧，长谣去海滨。\n千山初跃马，万里独依人。\n是事犹存舌，随场且见身。\n为君谢长剑，今日有风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42603,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李美发 其二","author":"李云龙","text":"与居尝对奕，曾说似长安。\n试以周旋我，看他笑骂官。\n金台虽已杳，易水尚馀寒。\n为向酒人度，知予梦寐阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42604,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"塞上答沈璧父","author":"李云龙","text":"无事莲花府，因君破寂寥。\n胡笳催进酒，汉月引鸣镳。\n说剑已逢敌，从军直渡辽。\n无将笛中柳，瘦入沈郎腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42605,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"斐园席上咏物限韵二首 其一 古宣炉","author":"李云龙","text":"遥思成鼎日，彷佛见龙髯。\n物以先朝重，香从侍女添。\n金光浮曲几，烟篆透疏帘。\n几度摩挲看，为君长夜淹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42606,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"斐园席上咏物限韵二首 其二 古松雪砚","author":"李云龙","text":"山骨何年刘，玄云片片黏。\n相传赵氏璧，曾给汉官缣。\n水注兔朝饮，池寒龙夜潜。\n侍郎频捧出，遥映玉纤纤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42607,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿潮阳莫郡丞","author":"李云龙","text":"悬弧壮志遂，佐郡诵声传。\n莫问骖鸾事，先看下凤年。\n金山挂笏外，春树捲帘边。\n早晚东防海，应逢采药船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42608,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李宫詹过桃源有感示家明府鸣周次韵","author":"李云龙","text":"浪说桃源县，偏饶潘令花。\n有村皆吠犬，无处可栖鸦。\n水浊谁知石，蓬孤幸植麻。\n仍怜折腰苦，无梦暇还家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42609,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"以桃杯及西帨寿李伯襄各系以诗 其一","author":"李云龙","text":"本为天上种，新自广东来。\n愿以千年实，长承万寿杯。\n频浮霞彩动，欲渡云和催。\n留取君遗核，君王甲帐开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42610,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"以桃杯及西帨寿李伯襄各系以诗 其二","author":"李云龙","text":"岂是蛟人织，言从番舶将。\n龙鳞裁海雾，鹤氅葺秋霜。\n袖处云千叠，披来月一方。\n愿君勤拂拭，持补舜衣裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42611,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊园为杨元孺都督赋 其一","author":"李云龙","text":"为卜盟鸥地，遥随倦鸟还。\n架桥通草阁，隔水望春山。\n脩竹流清啸，疏花照醉颜。\n松门凡几处，都付薜萝关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42612,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊园为杨元孺都督赋 其二","author":"李云龙","text":"翛然林水里，别是洞中天。\n为守老氏黑，因知扬子玄。\n枕流殊下濑，舞鹤异飞鸢。\n近识南塘路，时来问钓船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42613,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊园为杨元孺都督赋 其三","author":"李云龙","text":"朱阑春雨过，曲曲漾涟漪。\n柳色绿于水，花枝光匝池。\n开筵藉碧草，把酒听黄鹂。\n回首阳关笛，那堪马上吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42614,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏素馨花灯","author":"李云龙","text":"九微当夕炽，素影出琼田。\n四照壁如拱，夜光珠复联。\n初疑花吐焰，忽讶火生莲。\n香国清风杳，一灯今为传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42615,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夕阳","author":"李云龙","text":"夕阳在西岭，浦溆带馀晖。\n古渡听蝉罢，扁舟载鹤归。\n沉云菰米熟，浥露蕨苗肥。\n适得溪翁信，相期明月扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42616,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送无公","author":"李云龙","text":"孤云飞不定，又去粤江滨。\n芳草伴行脚，青山现法身。\n咒龙临黑水，留偈与鲛人。\n麻麦随缘饭，贫僧也不贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42617,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"林叔宝将归莆中时余方东游作此为别","author":"李云龙","text":"尔有还家梦，余今负剑游。\n明朝临远水，各自上孤舟。\n鹏岭行逢雪，芦溪已过秋。\n不知鱼与雁，他雨若为投。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42618,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柬罗幼良","author":"李云龙","text":"卧病甘牢落，经年负胜游。\n出门见柳色，始觉春非秋。\n尔屋清溪上，门前溪水流。\n桃花开遍未，吾欲命扁舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42619,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴济之游吴","author":"李云龙","text":"草色日夜变，江城春已迟。\n杨花铺绿水，非是冶游时。\n尔入吴都去，应多怨别诗。\n莫贪淮上月，飘泊负归期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42620,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题朱惟四小青林","author":"李云龙","text":"城上山色好，主人城下居。\n入门芳树合，知是白云庐。\n匣有龙精剑，床馀鸟迹书。\n时时琴酒侣，花下过篮舆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42621,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游朱惟乐瑶林园还因过惟卓北郭草堂","author":"李云龙","text":"已罢山园酌，看山复此行。\n亭回列障出，溪迫万花明。\n对客披鹤氅，呯童吹凤笙。\n酒阑思引杖，松月夜相迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42622,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏钓竿","author":"李云龙","text":"淇园霜干好，攀折日临流。\n系以虹霓缕，兼之明月钩。\n烟波东海上，雨雪大江秋。\n直拂珊瑚树，鱼龙不自谋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42623,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南园","author":"李云龙","text":"南园栖隐处，竹户对林峦。\n九月风霜起，孤斋日夜寒。\n虫声薄幽砌，雁影度空坛。\n松月遥相待，流霞且自餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42624,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张山人归始安兼寄汪伯耳","author":"李云龙","text":"二月春江深，送君归故林。\n绿波与碧草，一倍伤离心。\n故人在天末，欲往隔湘阴。\n相见烦相问，多愁年鬓侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42625,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过黄居士山居 其一","author":"李云龙","text":"居士禅栖处，烟霞入望新。\n晴窗云作幔，幽磴树宜春。\n流水常清意，青山不染身。\n毋劳天女降，别有散花人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42626,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过黄居士山居 其二","author":"李云龙","text":"松竹遗清荫，峰峦敞画图。\n嘉蔬折绿笋，香饭煮青菰。\n鹿女衔花献，莺儿隔叶呼。\n知余禅悦味，此谷任名愚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42627,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘冲倩拥妾游罗浮","author":"李云龙","text":"葛公蝉蜕地，自昔会群真。\n尔挈吹箫伴，同为采药人。\n双飞鸾迭舞，并驾鹤相亲。\n不作梅花梦，刘郎别有春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42628,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题梁元珍修远居","author":"李云龙","text":"远游非不好，归计在渔樵。\n家住清溪曲，门临白板桥。\n兰舟弄秋水，竹屋听春潮。\n自有烟波趣，毋烦猿鹤招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42629,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送徐山人","author":"李云龙","text":"江城春色尽，归棹逐飞花。\n野鹤栖无定，青山到是家。\n海风吹袂转，沙树背人斜。\n何物持将去，罗浮一片霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42630,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘广文宰祁阳","author":"李云龙","text":"闻君西省彦，藜阁旧知名。\n昔拥一毡至，今乘双舄行。\n听猿度湘水，随雁入芝城。\n但愿讼庭上，常如斋阁清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42631,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘郡丞之任庆阳","author":"李云龙","text":"江乡政已成，边鄙藉贤声。\n言下双凫去，遥从五马行。\n野凫川绕郭，白豹寨临城。\n转挽应烦虑，秋防正勒兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42632,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张提盐入觐","author":"李云龙","text":"万里飞龙马，风云迅不如。\n自宜依綵杖，何事服盐车。\n奋鬣循金埒，长鸣向玉除。\n天闲方待尔，行矣莫踟躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42633,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和邓玄度少参归兴十首 其一","author":"李云龙","text":"风雨潇潇暮，扁舟下郢门。\n言辞紫薇省，归卧梅花村。\n山好仍当户，溪深别作源。\n不知芳径竹，几处长龙孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42634,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和邓玄度少参归兴十首 其二","author":"李云龙","text":"空门亦自可，且听演三车。\n尘世风中絮，浮名水上霞。\n一丛贞士菊，五色故侯瓜。\n自足一丘赏，何论八月槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42635,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和邓玄度少参归兴十首 其三","author":"李云龙","text":"会心不在远，鱼鸟自相亲。\n进此杯中物，挥他扇底尘。\n松云随杖屦，竹露湿衣巾。\n好觅烟霞伴，青山不负人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42636,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和邓玄度少参归兴十首 其四","author":"李云龙","text":"自是逢时拙，非关值数奇。\n独行持素履，孤调写朱丝。\n白昼啼青兕，晴天掣赤螭。\n楚江回首望，心折彼遗黎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42637,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和邓玄度少参归兴十首 其五","author":"李云龙","text":"园菜初抽甲，林花正缀须。\n寻芳引藜杖，得句付奚奴。\n是处馀三径，何天问五湖。\n仍闻歌楚调，真自托狂夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42638,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和邓玄度少参归兴十首 其六","author":"李云龙","text":"罗浮苍翠里，原是列仙乡。\n向夕开帘望，钟声到上方。\n行吟古洞口，坐卧清溪傍。\n水石看如此，风尘底事忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42639,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和邓玄度少参归兴十首 其七","author":"李云龙","text":"幽期复何在，竹下与花边。\n携鹤坐芳草，呼童种秫田。\n门多问字客，箧有卖文钱。\n莫漫论芳轨，风流是昔贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42640,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和邓玄度少参归兴十首 其八","author":"李云龙","text":"浩荡南暝外，逍遥任此身。\n湖山如往日，烟月待归人。\n野老能分布，沙鸥不厌贫。\n纷纷车马客，赢得鬓如银。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42641,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]