[{"title":"薜萝馆为裕卿题","author":"胡应麟","text":"缥缈烟萝护石扉，幽轩十尺迥忘机。\n吟窥彩笔青云堕，坐拥瑶琴白雪飞。\n洞口经春词客兴，山阿薄暮楚臣衣。\n深居莫讶时人识，夜夜寒光动少微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17113,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹在亭为王孙贞吉题","author":"胡应麟","text":"清风何处洒琴书，面面琳琅雪雨馀。\n千亩昼围中散宅，万竿晴拂子猷居。\n声摇淇澳来中坐，翠拥潇湘护碧渠。\n尊酒欲寻长啸客，美人空谷正踟蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17114,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同詹东图康裕卿胡文父集胡上舍馆有赠","author":"胡应麟","text":"大隐何妨卜市廛，华裀长日拥婵娟。\n吟馀河朔堪消暑，住久临邛不记年。\n千里壮心惭骥枥，九霄寒色舞龙泉。\n长安此夜占星斗，半入荀陈座里悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17115,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄孔昭还七闽","author":"胡应麟","text":"匹马何来自蓟城，兰皋携手白云平。\n长裾尚曳三峰色，短剑初回五岳行。\n夹岸帆樯漳水夜，中天台观武夷晴。\n离尊咫尺空相望，愁绝华阳社里盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17116,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"艾都阃见过不值","author":"胡应麟","text":"飞花长日掩柴关，小队俄来曲巷间。\n上客已惊题凤去，元戎谁共射雕还。\n青天画甲严城迥，明月牙旗大海閒。\n闻道漠南诸将在，几人名姓动阴山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17117,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄胡文父","author":"胡应麟","text":"潦倒公车记昔游，青丝白马并皇州。\n霜华夜拂高离筑，雪片朝寒杜甫裘。\n一代风期谁独往，百年肝胆自名流。\n相思倘逐飞鸿翼，綵笔同携八咏楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17118,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王先辈还二华","author":"胡应麟","text":"匹马言归太华颠，五陵行色暮飘然。\n游吴卫玠名偏重，入越中郎赋已传。\n白阁云霞孤剑底，黄河星斗一尊前。\n无嗟片语天南北，屈指看花汉殿年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17119,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄徐子与","author":"胡应麟","text":"车骑辉煌列上游，几年方岳擅风流。\n西山万树浮官阁，南浦千花入郡楼。\n授简客知王勃在，据床人忆庾公留。\n毋誇石匣丰城畔，振佩遥看接斗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17120,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄李惟寅兼讯朱山人汝修","author":"胡应麟","text":"朝悬鹊印坐长杨，锋镝平销一剑霜。\n射虎乍闻过灞岸，飞龙犹忆赋河梁。\n丹心自照论兵地，青眼频输结客场。\n独有夷门旧宾从，偏从长揖问容光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17121,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻安茂卿游临安作此问讯","author":"胡应麟","text":"飞扬裘马各游秦，拂袖俄惊海上春。\n三洞稍酬新日月，五陵犹记昔风尘。\n纷纭白眼空调世，濩落红颜已让人。\n闻道如花仍共载，若耶溪色定谁亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17122,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜滕公擢任浙中方伯二首 其一","author":"胡应麟","text":"叱驭遥看五岭来，双旌薇省暂徘徊。\n三朝骤起吹嘘色，十道谁先抚字才。\n赤日扶桑过露冕，青山鄞海傍登台。\n讴歌岂独东南借，绕夜寒光接上台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17123,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜滕公擢任浙中方伯二首 其二","author":"胡应麟","text":"南来海色傍旌旗，犹似横经越峤时。\n华省坐开新气象，青衿传迓旧威仪。\n筹输九塞军储集，佩压三曹帝宠移。\n屈指侯芭曾问字，十年长铗未酬知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17124,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送喻邦相之都下","author":"胡应麟","text":"卧掩衡门病色侵，相逢词客重开襟。\n孤尊暂诧梁园集，万里仍趋魏阙深。\n风雨大江随击楫，云霄赤县待横琴。\n殷勤片诺他年事，北望鸿书瀫水浔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17125,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张明府移任江右","author":"胡应麟","text":"拥辙千家泣道旁，飞书谁为转循良。\n清霜乍徙朝歌署，白雪俄深单父堂。\n柳色映檐江浦近，梅花入梦海天长。\n极知百里非重借，曳履晨看到尚方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17126,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋夜同诸君镇海楼玩月","author":"胡应麟","text":"缥缈银蟾落庾楼，凭高一望海云收。\n千林露色天如洗，万井河光地欲流。\n大漠旌旗谁倚啸，长门环佩迥添愁。\n追陪正忆群公语，莫讶胡床竟夕留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17127,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄边上友人","author":"胡应麟","text":"早闻词赋擅西京，更羡终军独请缨。\n万里旌旗分汉壁，十年刁斗隔燕城。\n云沈瀚海风沙起，雪满交河道路平。\n堪笑故人犹短褐，欲将孤剑事长征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17128,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人入蜀","author":"胡应麟","text":"离思翩翩把浊醪，锦城西去不辞劳。\n星辰夜拂张华剑，风雨寒生范叔袍。\n三峡啼猿青嶂远，九疑回雁碧天高。\n蜀中形胜堪怜汝，定把新诗吊薛涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17129,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐明府之琼州","author":"胡应麟","text":"春花缭绕凤凰楼，襆被怜君赋远游。\n风俗自分天外郡，山川愁问海南舟。\n珠崖云气经秋断，琼岛波光入夜浮。\n惆怅一尊芳草畔，不堪离恨对吴钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17130,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日送人之洛中","author":"胡应麟","text":"挟策怜君出汉关，驱车晴色满山川。\n浮云半落漳河水，寒日斜分博望烟。\n龙剑独携星斗外，鸿书遥寄雪霜前。\n绨袍对拂双蓬鬓，犹是京华旅食年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17131,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送中丞曾公之成都","author":"胡应麟","text":"使者新传谕蜀章，朱衣晴日下明光。\n扬旌欲挂峨嵋雪，拂剑遥生滟滪霜。\n幕府夜谈宾满坐，山邮朝发吏成行。\n共誇仆射诗情在，小队时能过草堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17132,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花朝思伯邀同诸子集李氏园亭","author":"胡应麟","text":"绿野晴开一径斜，夕阳联骑到山家。\n绨袍乍拥梁园雪，綵笔先飘汉殿霞。\n大麓春阴回远树，高城霜色堕清笳。\n看花剩有刘郎兴，十载长安鬓欲华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17133,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清源道中别裕卿二首 其一","author":"胡应麟","text":"十日平原饮未阑，更携离色上征鞍。\n浮云万里幽期隔，明月千峰旅梦寒。\n片诺久知肝胆尽，深交那问鬓毛残。\n孤帆岁暮能相过，风雪桐江有钓竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17134,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清源道中别裕卿二首 其二","author":"胡应麟","text":"几夜风云入倡酬，一朝岐路揽吴钩。\n天悬大陆双龙语，雾拥寒山疋马愁。\n忆戴未阑王子兴，登仙犹滞李膺舟。\n秋期倘问垂纶客，散发同看大海流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17135,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"齐东道中","author":"胡应麟","text":"羸马经行日草莱，齐东遥望海云开。\n春光莒父层城合，曙色琅琊万井回。\n织屦自高陈仲隐，飞书谁问鲁连才。\n遗踪九合俱零落，满目晴花度野台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17136,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀史元秉李惟寅朱汝修","author":"胡应麟","text":"浩渺春光接汉关，金茎遥望五陵间。\n诗成碣石人犹聚，赋罢长杨客已还。\n碧汉鹓鸿堪并起，青门鸾鹤几同閒。\n芒鞋莫问天台色，万树桃花照玉颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17137,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同文父登泰山四首 其一","author":"胡应麟","text":"百转丹梯上翠屏，天门遥望海冥冥。\n幽燕北护诸陵紫，齐鲁东回万壑青。\n松色自摇秦帝辇，芝封犹驻武皇灵。\n残碑七十俱尘土，千载凭谁问勒铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17138,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同文父登泰山四首 其二","author":"胡应麟","text":"缥缈飞云十八盘，高临回首尽长安。\n青天万仞楼台立，白日千重杖履寒。\n若木烟光浮帝阙，扶桑霞影落仙坛。\n相携并倚孤鸾啸，不向遥空问羽翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17139,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同文父登泰山四首 其三","author":"胡应麟","text":"独夜行吟到斗牛，阑干遥倚碧天愁。\n千峰日抱秦台上，万岭云争汉碣流。\n绛节光生群帝语，玉扉寒启众灵游。\n吹笙不浅王乔兴，杖履何年更十洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17140,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同文父登泰山四首 其四","author":"胡应麟","text":"面面芙蓉立紫烟，石门丹壑迥相连。\n遥峰雾拥星河出，绝顶天回日月悬。\n玉碣尚传司马后，苍松谁问祖龙年。\n相看十载沈冥意，梁父吟成共黯然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17141,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送文父还匡庐","author":"胡应麟","text":"涕泪江湖范叔袍，相看愁色转蓬蒿。\n人归庐岳千峰雨，梦阻浔阳八月涛。\n酒畔莲花传般若，窗前桂树咏离骚。\n临岐漫脱干将佩，斗气双悬日月高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17142,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再寄朱大司空","author":"胡应麟","text":"玄圭曾告万年功，归去堂开绿野中。\n圣主自尊前尚父，蕃人来问大司空。\n吟边驾引新调鹤，卧里车悬旧赐熊。\n愧杀酬知长剑士，白云无路到崆峒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17143,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别李季宣","author":"胡应麟","text":"万里澄江片月虚，故人相望转踟蹰。\n寒星欲堕张华剑，远道仍驱孟博车。\n独夜鱼龙京口梦，高秋鸿雁广陵书。\n花时好订吴天约，题遍楼台四百馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17144,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同茅平仲登甘露寺绝顶作","author":"胡应麟","text":"天畔危亭绣拱扶，并游词客总江湖。\n千山雪浪吹楼殿，万里云帆下舳舻。\n秋色平分瓜步远，暮烟斜合景阳孤。\n兴亡六代俱陈迹，对倚西风尽玉壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17145,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重游金山四首 其一","author":"胡应麟","text":"海色迢迢四望齐，孤峰突兀耸招提。\n亭嘘大壑千帆尽，寺绕寒空万堞低。\n天地对悬南北影，云霞不断古今题。\n凭高一片真堪画，缥缈楼台铁瓮西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17146,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重游金山四首 其二","author":"胡应麟","text":"百尺危阑坐振衣，白云苍雾满禅扉。\n天空一柱中流出，日午层涛四面飞。\n秋色帆樯淮甸远，暮钟楼殿广陵微。\n重来为搆焦君宅，对狎青山住海沂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17147,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重游金山四首 其三","author":"胡应麟","text":"曳履千盘到上头，苍烟寒梵满清秋。\n阑干曲抱孤云色，殿阁飞悬大海流。\n日落鼋鼍时自语，风高鸿鹄晚仍留。\n蓬莱咫尺堪乘兴，坐倚芙蓉望十洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17148,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重游金山四首 其四","author":"胡应麟","text":"一峰尘外耸巉岏，屹立青螺镜里看。\n万古乾坤谁卓锡，三山涛浪此凭阑。\n秋空蜃气连江暝，夜久龙宫上日寒。\n何处玉笙吹不断，五云楼殿满长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17149,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江右嵬父佳父二王孙以书翰见贻赋此寄赠","author":"胡应麟","text":"紫气丰城望不穷，雌雄龙剑拂长空。\n持觞并入莲花社，卜筑同依桂树丛。\n天际碧云回锦字，石边流水傍丝桐。\n青帆咫尺堪乘兴，为借浔阳一夜风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17150,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄曹山人子念","author":"胡应麟","text":"大雅曾闻郢客操，蒹葭何处梦魂劳。\n青萍夜啸吴门月，白舫晴飞震泽涛。\n海岳壮心藜杖远，乾坤秋色草堂高。\n西风是处堪乘兴，相对兰陵把浊醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17151,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄朱可大进士","author":"胡应麟","text":"曾共长杨谒圣君，一鸣龙种独空群。\n彤墀未捧千年日，紫殿先传五色云。\n花气上林春浩渺，酒香韦曲晚氤氲。\n酬知莫问冯驩铗，片片霜华落斗文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17152,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登临安镇海楼","author":"胡应麟","text":"郡阁冥冥雾雨开，蓬瀛遥望气雄哉。\n千樯昼挟潮声下，万树晴飘海色来。\n策石旧传秦帝辇，还乡初见越王台。\n高歌且遂乘桴客，莫问安期早晚回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17153,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苏君禹观察抵武林以手札诗扇附李参知见寄且劝驾北上意甚惓惓感事赋答二首 其一","author":"胡应麟","text":"论文曾驻木兰舠，按部长怀使者劳。\n岂谓青衿还绛帐，尚从黄绶问绨袍。\n书传大禹千秋穴，赋涌灵胥八月涛。\n不是輶轩频顾盼，桐君山色为谁高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17154,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苏君禹观察抵武林以手札诗扇附李参知见寄且劝驾北上意甚惓惓感事赋答二首 其二","author":"胡应麟","text":"双鸿迢递问柴荆，片鹢犹思下婺城。\n祗愧烟霄勤物色，能从湖海擅时名。\n遗音空谷闻三叹，大乐明堂重九成。\n莫向云泥论出处，乾坤何地不堪盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17155,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仲秋北上次武林谒大中丞滕师招饮赋谢","author":"胡应麟","text":"锦瑟沈沈夜未阑，胡床明月坐来寒。\n抽毫久愧门人籍，伏剑重登国士坛。\n一壑龙门怀豹隐，千山燕阙话鹏抟。\n青帆咫尺临安路，踯躅河桥去住难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17156,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中丞滕公遣人舟传送渡江赋谢一律","author":"胡应麟","text":"十年云水断风尘，一为酬知谢隐沦。\n击楫岂容高卧士，飞樯聊作浪游人。\n长康破冢应无恙，逸少临池合有神。\n无奈梦魂秋色里，白蘋红蓼唤垂纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17157,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别苏观察君禹作","author":"胡应麟","text":"曲槛回廊玉署开，高云斜日共徘徊。\n纵横大笔生徒候，惨淡长裾客子来。\n狂拟持竿眠汉阙，老堪携策傍秦台。\n飞查暂乞银河去，拾取支机万颗回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17158,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"君禹病疟二月馀余过访不能数语情殊恋恋途中追忆再成二律奉寄 其一","author":"胡应麟","text":"一舸芦花正夕阳，题诗秋色照河梁。\n风惊宋玉三秋鬓，露浥相如万古肠。\n剑色飞扬闽海外，琴心憔悴越溪傍。\n途逢伯乐应相笑，几度盐车扼太行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17159,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"君禹病疟二月馀余过访不能数语情殊恋恋途中追忆再成二律奉寄 其二","author":"胡应麟","text":"只字风云逐彩毫，双缄雨雪问绨袍。\n朱颜总为怀人瘦，绿鬓能无课士劳。\n歌彻四愁神已王，篇成七发兴逾豪。\n何当一唤枚乘至，万叠吴山望海涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17160,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"周元孚过访见赠奉答时元孚方有南都司马之擢","author":"胡应麟","text":"翩翩词客气凌虚，朗润周郎玉不如。\n佐郡蚤持三尺剑，安边频著万言书。\n霞飘鸡舌黄金殿，雾拥螭头白玉除。\n四百楼台春雨后，看花何处不停车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17161,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为周元孚悼亡 其一","author":"胡应麟","text":"百琲明珠照画楼，闺中林下并难俦。\n新词尽压周公瑾，绝唱先传宋子侯。\n落月素琴千里梦，西风团扇十年愁。\n亦知王母遥相忆，肯放双成到白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17162,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为周元孚悼亡 其二","author":"胡应麟","text":"十幅鸾笺丽彩云，双飞龙剑惜离群。\n哀伤奉倩倾城语，恸绝安仁祭墓文。\n夜雨乍堪琴瑟断，春风长忆佩环闻。\n天台咫尺谁携手，落尽桃花越水濆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17163,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送喻邦相移任云间","author":"胡应麟","text":"剖竹新分大郡符，朱轩华毂照行途。\n云驱五马朝辞越，雾拥双龙夜入吴。\n重遣遗民歌麦穗，尽搜奇士出菰芦。\n双旌遍阅闾阎后，酾酒能过二陆无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17164,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜登镇海楼月色瑩然万里如昼因忆王长公元美时方以司马应召南都","author":"胡应麟","text":"登坛初卸黑貂裘，玉宇无声夜色流。\n十万貔貅环汉帜，三千熊虎抱吴钩。\n歌传桃叶清江上，曲奏梅花大海头。\n徙倚胡床豪兴发，不知明月堕南楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17165,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄周元孚","author":"胡应麟","text":"含香犹是旧蓬莱，跃马长干定几回。\n搦管客留鳷鹊殿，吹箫人去凤凰台。\n黄陵异日传仙梦，赤壁今时擅将材。\n见说秦淮春满座，新词何限箧中裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17166,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀少宰赵公","author":"胡应麟","text":"衣冠何地不蓬莱，大府晨趋百吏来。\n拄笏云霞流十庙，浮查河汉接三台。\n牛头寺古寻僧去，燕子矶寒送客回。\n屈指盐梅飞诏下，调羹人在凤凰台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17167,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大司空潘公寄示河渠诸刻卒业赋此奉赠","author":"胡应麟","text":"巨轴高悬照紫霞，平成功就世谁加。\n渠通上国三千里，堰护长淮十万家。\n匝地甘棠偏捧露，参天垂柳不沾沙。\n傍观漫自工萋菲，白发臣心尽海涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17168,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄答刘君东孝廉时新刻乃族祖子高职方集成","author":"胡应麟","text":"邂逅长安握别年，清源一望路三千。\n双龙豫野偏藏匣，片鹢浔阳未放船。\n玄草阁深天寂寞，赤松亭古地葱芊。\n当筵朗润真如玉，为忆冰清梦寐悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17169,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"余君房招同刘子玄胡孟韬盛太父李季宣夜集言别","author":"胡应麟","text":"携取灵光下玉墀，敝裘无赖出关时。\n那堪水部梅花燕，却订王孙桂树期。\n青琐佩环红日近，翠微车马白云迟。\n惟应入梦君房笔，永夜同过越水湄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17170,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将出都丁元父过访数四且贻诗饯别意甚惓切赋此奉酬","author":"胡应麟","text":"片语都门醉浊醪，黄金台上共持螯。\n毫端并吐千秋色，筑畔谁当一世豪。\n紫陌天回中秘远，青山云净少微高。\n花期首探骊龙窟，肯著东方赐后袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17171,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南归留别胡孟韬区用孺李季宣王囧伯王永叔黄季主冯咸父金伯韶八子","author":"胡应麟","text":"陌上东风御柳黄，胡姬相对一传觞。\n空传八骏来燕市，未许双蛾擅洛阳。\n握手虹霓犹意气，关心岐路独文章。\n提携竞著南征赋，万叠春山万里航。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17172,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠莫廷韩","author":"胡应麟","text":"时名籍籍尚风尘，索米长安岁未贫。\n囊草欲飞三殿色，墨花长洒万家春。\n茶烹阳羡过名士，酒酿临邛醉玉人。\n莫怪相逢谈太剧，洛中词客旧为荀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17173,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈玉叔大参之蜀","author":"胡应麟","text":"握手华阳别思浓，骊驹一曲暂相从。\n雄风七泽登台近，积雪三峨问寺重。\n上客题诗留锦里，佳人携手醉临邛。\n亦知蜀道行偏易，惆怅河桥落暮钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":17174,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]