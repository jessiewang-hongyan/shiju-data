[{"title":"送钱匡庐还德清 其四","author":"孙继皋","text":"瘦骨閒心野鹤形，寒烟远水去亭亭。\n莺花不负春来约，同买湖船上洞庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日严侍御邀同王典客万中丞王太学诸公饮其东郭别业","author":"孙继皋","text":"郊扃卜筑带沧浪，载酒邀欢朱夏长。\n农事解占梅雨近，客怀偏趁竹风凉。\n遥山影塔看疑并，华月浮舟醉不妨。\n只恐青骢催赴阙，空林猿鹤怨秋霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日同王典客顾孙二太学暨诸亲故游眺蓉湖庄二太学有作余亦嗣响","author":"孙继皋","text":"秋原弭棹白云凉，剩石欹桐尚此堂。\n一壑烟霏非旧主，千秋风日自吾乡。\n芙蓉不断青湖色，薜荔曾萦锦砌香。\n为惜兴衰人尽醉，可堪渔笛送残阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张去华自华塘过访山堂留酌分得间字","author":"孙继皋","text":"春明一相失，匹马傍谁还。\n才岂三吴尽，名堪二陆间。\n入门高紫气，把酒落青山。\n世路君应见，孤云好闭关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题刘勋胄庐墓册","author":"孙继皋","text":"移家初定掩慈闱，忍听人歌薤露晞。\n哭向空山迷夜月，梦回孤垄暗春晖。\n血枯白日凄残綵，肠绝终天咽断机。\n共道象贤还死孝，风前双吊鹤来飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同万中丞过华孝廉园看五色葵花","author":"孙继皋","text":"葵开五色锦成行，照映琅玕出粉墙。\n激水调冰山阁午，围棋吹管夏堂凉。\n共推暑饮追河朔，不减春游似洛阳。\n度尽新词人未散，无官真以醉为乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿某夫人五十","author":"孙继皋","text":"方岳朝天日，中闱介寿年。\n莺迁上林后，燕喜北堂前。\n偕老才称艾，馀春转觉妍。\n帝颁鸾阁诰，人咏鹊巢篇。\n女史镌银管，仙姝捧玳筵。\n蓂开逢半百，桃喜兆三千。\n台宿初临婺，坤仪雅配乾。\n恩华兼鹤算，一品发犹玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"顾麟洲七十","author":"孙继皋","text":"有官不谒建章宫，垂老人钦片玉同。\n麟趾向歌公子瑞，虎头争羡旧家风。\n星临华室凉初动，月度高城宴未终。\n明发小山看桂树，天香仙露一丛丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题衡泌园册","author":"孙继皋","text":"为园岭下白云深，岭下花开香满林。\n人去函关馀紫气，地邻韶石足清音。\n姓名久落先贤传，堂构难忘孝子心。\n遥夜衡门空入梦，汉廷春色引朝簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王华云太学应赵明府聘校唐诗类苑还海上赠之","author":"孙继皋","text":"李唐盛词赋，作者总如云。\n雅道千秋擅，王风一代闻。\n网罗心独苦，雠校力何勤。\n白雪名家尽，青藜秘阁分。\n删诗尊圣轨，观乐仰前芬。\n重客非关令，宗工解属君。\n艺林开宝藏，骚垒勒元勋。\n书就沧洲去，清尊忆论文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中漫兴 其一","author":"孙继皋","text":"客去渺何许，遥空野屿浮。\n讵乘新涨发，不为好山留。\n黍馌孤村午，松醪五月秋。\n哀蝉响高树，寥落一维舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中漫兴 其二","author":"孙继皋","text":"彩鹢去仍还，青林许共攀。\n愁翻因止酒，病不碍登山。\n古寺苍藤路，飞泉白石湾。\n何妨住十日，与尔听潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘山人送牡丹 其一","author":"孙继皋","text":"匹马层冰淮上来，名花相赠与亲栽。\n东风十日看将近，遮莫三春烂熳开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘山人送牡丹 其二","author":"孙继皋","text":"嫩梗泥封不怕寒，移来新傍石阑干。\n丹葩绿叶关心待，翠幕金尊著意看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘山人送牡丹 其三","author":"孙继皋","text":"嘉名一一署周藩，黄紫还谁数洛阳。\n秀色定知誇绝代，此花真不愧花王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘山人送牡丹 其四","author":"孙继皋","text":"异种传来百宝装，花开应不比寻常。\n春城定惹游人看，泼却新醅满瓮香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠倪相士","author":"孙继皋","text":"几载春风别上林，逍遥吾已入山深。\n凭君照胆玄经在，未必能窥野鹤心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送沈孝廉试礼闱","author":"孙继皋","text":"不乏东南美，如君弱冠稀。\n人今誇玉树，名已动朱衣。\n朔雪飘征路，文星指禁闱。\n春风上林日，骑马看芳菲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王弘所典客还朝","author":"孙继皋","text":"依然青鬓好，去理旧朝簪。\n驿路逢朱夏，征车带绿阴。\n传呼三殿直，临御万方心。\n山海看难既，遥遥听德音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初入古希会","author":"孙继皋","text":"高会何人许盍簪，忘年偏喜荷招寻。\n敢方涑水跻耆俊，窃比山涛在竹林。\n投老总迷霄汉梦，得閒同矢岁寒心。\n从今杖履追陪数，谷鸟溪花几醉吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏孟黄思庵太府社集城西别业得寒字","author":"孙继皋","text":"密林长夏集衣冠，洛社风流异代看。\n鸳序人归曾不晚，鸥盟老去许谁寒。\n山连睥睨青临阁，水带檀栾净倚栏。\n尽日从容文酒乐，冥冥天外托飞翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏五施励庵同乡社集得吴字","author":"孙继皋","text":"一雨郊原万品苏，微寒五月动高梧。\n节临荐黍犹传楚，客为思莼已到吴。\n蜡屐共穿花外径，雕盘从出竹间厨。\n淹留不惜呼灯坐，空谷低回咏白驹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又和醒字","author":"孙继皋","text":"不见龙山九点青，层云挟雨昼冥冥。\n黄苏麦穗骄翻垄，红濯榴花艳舞庭。\n息驾此身元汎汎，投簪双鬓任星星。\n休嗟吊屈明朝事，潦倒无心任醉醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄沈祁阳复吾","author":"孙继皋","text":"徼邑带南荆，高才绾绶行。\n岳云扶舄上，湘水应琴声。\n垒堞初驯雉，栽花欲啭莺。\n政成看驿召，黼扆早书名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题曹太守三游册","author":"孙继皋","text":"一麾抛却老江门，蜡屐兰桡选胜繁。\n白社寻僧翻贝叶，青天呼酒嗽云根。\n诗题绝壑人间诵，迹傍浮沤物外论。\n我欲从之巴水阔，几回搔首望仙源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿高临溪","author":"孙继皋","text":"掷却官荣老岁华，门前新系使星槎。\n琼花看去惟扬子，玉树生来似谢家。\n物色磻溪身正健，乡心汾水梦还赊。\n閒云坐阅沧桑遍，白发秋筵进紫霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送华别驾之旴江","author":"孙继皋","text":"黄绶新萦满路辉，风流半刺似君稀。\n冈传华子来仙吏，人比王祥到海沂。\n问俗定纡花外驾，思家应梦竹间扉。\n分携无限沧洲意，月白江空彩鹢飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿王荆翁相公","author":"孙继皋","text":"三朝耆德帝王师，七十閒身海岳姿。\n行地神仙元勇退，格天勋业自勤施。\n筹行群策三垂偃，国巩孤忠九庙知。\n事定商岩芝转秀，人归绿野昼偏迟。\n温纶隔岁优存后，茂算清秋诞降时。\n曦景东山绥福履，祥光南极接台司。\n安危直是关皇室，衰健还应觇裔夷。\n袖手奈违调鼎梦，察眉谁任改弦为。\n共仪阙下编蒲召，未稳丘中辟谷期。\n龙马精神逾少壮，凤麟毛趾况英奇。\n魁名符券承能巧，相业箕裘嗣不疑。\n世笃曾闻周鲁旧，衮衣前后拜彤墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿申瑶翁相师 其一","author":"孙继皋","text":"黄扉请老十年前，绿野秋清寿酒传。\n帝以闵劳优宰执，人于勇退识神仙。\n三朝耆旧元名世，一代勋猷自格天。\n望起苍生同此日，相麻霄汉听重宣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿申瑶翁相师 其二","author":"孙继皋","text":"岳降生申事已奇，嵩呼况接万年期。\n共言丞相当朝日，偏荷君王赐寿卮。\n明月似悬金鉴在，流虹遥拜衮衣垂。\n定知终宴东山夜，清梦如闻湛露诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿申瑶翁相师 其三","author":"孙继皋","text":"曾闻优诏自天来，帝为升储宠上台。\n密疏向关宗社计，孤忠肯受外廷猜。\n赤松老伴留侯谢，丛桂閒同隐士裁。\n卿月临阶人献寿，应知茂苑即蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿申瑶翁相师 其四","author":"孙继皋","text":"一从上相下师垣，太息中官拥使幡。\n宣索已闻穷岭海，转移谁为正乾坤。\n天扶遗老身仍健，人比耆英望愈尊。\n调鼎更弦须旧德，辗蒲加璧待新恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日小园社集分得公字","author":"孙继皋","text":"菟裘聊此地，五柳宅堪同。\n潇洒馀孤赏，过从有数公。\n疏帘全却暑，曲沼自生风。\n坐看梧桐晚，盈盈月上东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又得携字","author":"孙继皋","text":"避暑玉壶携，探奇石磴跻。\n林堪六月息，人可七贤齐。\n竹翠迎风细，松阴避日低。\n云霓闵农望，一诵渰凄凄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋仲龚方伯旷适园社集蜀客雷樵阳全真适至分得先字","author":"孙继皋","text":"蒲柳怯秋先，秋风水郭偏。\n过从乘暇日，摇落感流年。\n尊俎同人乐，烟霞静者缘。\n暮颜疑可驻，野客坐谈玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又得萧字","author":"孙继皋","text":"水槛秋逾净，晴郊暑未消。\n露荷仍的的，风叶自萧萧。\n对酒宜疏豁，参玄契泬寥。\n城头暮吹笛，疑有列仙招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴求峰徙官合州","author":"孙继皋","text":"西去休歌蜀道难，太行曾已历㠝岏。\n恩深故许仍分竹，才大何妨暂徙官。\n城下双江通锦浪，花间五马度金鞍。\n行春问俗欢循吏，为政风流汉代看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湖上兴福寺","author":"孙继皋","text":"入寺怜幽绝，呼尊坐郁盘。\n共贪佛日好，不畏松风寒。\n稚子收山果，残僧供野餐。\n犹云涧道古，停策暝中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高峰坞卧佛寺","author":"孙继皋","text":"佛卧空山久，僧閒白日长。\n予方狎湖海，尔却疲津梁。\n地僻游难到，禅栖世可忘。\n谁知此峰外，高浪杳茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送华本素之官新郑","author":"孙继皋","text":"茂宰名家子，堤封古国都。\n少年初带印，春日早登途。\n芳甸栽花易，流风赠药殊。\n怀贤想遗爱，下马醉清酤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王宜兴赴阙","author":"孙继皋","text":"山县栽花春满城，召除郎位属春卿。\n双凫旧识朝天去，匹马今为谒帝行。\n候晓含香兰殿迥，深宵起草月阶明。\n仙曹十载曾分席，几听尚书曳履声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题祝山人寄亭","author":"孙继皋","text":"草玄人已去，天地此空亭。\n老悟生如寄，狂疑醉不醒。\n名题高士传，光失少微星。\n犹有寒山色，依然为尔青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题杨五川观察遗墨 其一","author":"孙继皋","text":"人间曾见署书奇，蠹卷残笺复此诗。\n想像兰台供奉日，风流文采更输谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题杨五川观察遗墨 其二","author":"孙继皋","text":"六十年来片墨新，品题珍重惜词人。\n不知万卷楼空后，多少珠玑委路尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新正十一日施囧卿宅社集次龚方伯韵","author":"孙继皋","text":"云黯春城夜，悬灯定几家。\n光摇十蓂叶，焰吐九枝花。\n簪盍星初聚，杯深雨亦嘉。\n白头思稚齿，叠鼓月中挝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄太守宅社集余以疡发不赴时梅渐放","author":"孙继皋","text":"常年怕花落，今夕愁花开。\n借问尔何意，支离断举杯。\n昼眠贪拥被，春望羡登台。\n不分枝头玉，东风故故催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大玄曹尊师雷樵仙道侣也来游梁溪客万中丞所出册子索题余病中赋赠","author":"孙继皋","text":"青城樵子今何之，尔却东游到海湄。\n浮云来往亦恒事，白日修持知者谁。\n梁溪昔有吴先生，明阳洞中餐玉英。\n丹炉药臼至今在，夜半山中捣月明。\n一从骑鹤上升去，真人之箓传其名。\n尔来度人亦访友，望见峰头紫气否。\n芝术经春谷口生，蓬莱晃日人间有。\n赤书金简世多讹，竹杖芒鞋奈尔何。\n不惜真诠扶病骨，掉头携手入烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晦日龚方伯社集看梅城南余病不赴","author":"孙继皋","text":"花满横塘雪满枝，乐游争趁早春时。\n香山老识风流并，庾岭人疑月落迟。\n欢剧定知频进酒，兴来谁拟独吟诗。\n生怜病骨偏消瘦，愁听高楼玉笛吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春仲毅翁方伯邀同顾太府贾观察吴光禄沈大令钱转运严侍御盛陆二山人城南看梅及暝悬灯树间绝胜时余病起","author":"孙继皋","text":"瑶林绰约雪千株，病起追欢兴未孤。\n二月春风何逊阁，半坳斜日辋川图。\n城头列岫排青玉，花底繁灯涌夜珠。\n不惜深杯酬胜赏，支离衰骨愧人扶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈别驾擢台幕","author":"孙继皋","text":"黄纸除书下九天，康邦功已海圻传。\n争看父老攀辕日，正及君王易辙年。\n陌上海棠春雨后，台中列柏庆云边。\n恩华此去纲维地，彩鹢凌江望若仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春仲风雨雪寒甚同黄伯传作分得窥字","author":"孙继皋","text":"冷雨挟风紧，昨暄春日迟。\n物情应似此，天意总难窥。\n转忆冬晴好，差怜午雪垂。\n君看落梅处，不醉复何为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"范东生戚不磷见访留饮玉兰花下限悬字","author":"孙继皋","text":"二妙同心者，重逢叹隔年。\n清言坐花下，皎皎似相怜。\n白雪含风舞，瑶林嵌石悬。\n酒香君且住，休负艳阳天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春仲六日同黄伯传王元穆诸君山游晚观锡山塔灯纪兴","author":"孙继皋","text":"五里山程一水通，布帆无恙信东风。\n何年松老翠欲滴，几树梅残粉未空。\n月吐寺门窥鬓白，灯围峰塔影波红。\n病馀此度才乘兴，半惜春违伏枕中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同沈明府顾文学冯茂才诸君汎莲蓉湖看香船灯时与锡山塔灯相望因赋","author":"孙继皋","text":"朝玄旧侣集艨艟，灯火春湖乱水蓉。\n宝蜡熏天香袅袅，星桥连岸影重重。\n遥光闪塔欺灵鹫，沸焰波翻骇烛龙。\n钲鼓喧阗人半醉，大江西望是篸峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贾弘庵观察山园社集玉兰花下得南字","author":"孙继皋","text":"莺花二月满江南，选胜开尊此地堪。\n九畹飘香分映玉，群峰舞黛对抽簪。\n横塘鼓吹喧游棹，上界钟声礼法龛。\n人醉瑶林归路晚，还携茗椀试甘泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春游即事","author":"孙继皋","text":"春山携屐蹑云层，花气晴丝暖欲烝。\n藉草涧边红袖女，疏泉竹下翠微僧。\n川原万顷看回合，陵谷千年感废兴。\n沾醉不辞归棹晚，数声长笛月初升。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小园社集主宾凡八人是日雨分得衫字","author":"孙继皋","text":"焚鱼早署碧山衔，舞鹤疑开滴水岩。\n洞有桃花能自发，门多芳草不教芟。\n春风旧巷宜初服，昼雨深堂黯客衫。\n坐列八公惟此会，淮南诗赋满瑶函。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答周元孚尚宝 其一","author":"孙继皋","text":"旧识行边使，曾烦尚玺臣。\n一为万里客，老却半生身。\n皓日孤怀耿，荒烟泪眼亲。\n颇闻新雨露，沾洒到流人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答周元孚尚宝 其二","author":"孙继皋","text":"谪宦尔何久，休官我不迟。\n虽然千里隔，肯负百年期。\n世态江河异，閒身日月私。\n白云如可赠，亦足慰相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答周元孚尚宝 其三","author":"孙继皋","text":"书来云梦泽，问我五湖波。\n浩渺同明月，差池隔绛河。\n辟畦分雨竹，结屋带烟萝。\n东下江风便，扬帆试一过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈猷甫还麻城君以瞽废","author":"孙继皋","text":"乐府张司业，登楼王仲宣。\n病怜新曲好，贫恋客居便。\n天岂摧才士，人应识寓贤。\n暂还仍远适，别尔怅江烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明日送冯贞白仪部奉使还朝","author":"孙继皋","text":"折柳偏逢插柳辰，猗兰歌向握兰人。\n金尊别酒三千里，竹箭才名二十春。\n蓟阙风烟驰傅入，尧天日月转圜新。\n南宫旧席鹓鸾地，老愧清班珥笔身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"榆林杜日章都护自署三教逸史索赠","author":"孙继皋","text":"词场军垒万夫雄，舞剑称诗绝代工。\n绿鬓雅闻豪举遂，玄心早悟世缘空。\n新题秘记传三教，共识前身并陆通。\n莫向人间逃姓字，燕然终拟勒元功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄章都护四首 其一 题玉举斋","author":"孙继皋","text":"灼然看玉举，风度想伊人。\n不信千秋业，今归百战身。\n才名高倚马，雅意薄图麟。\n谈笑西斋夕，尊前断塞尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]