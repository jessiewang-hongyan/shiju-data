89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴锦雯司李以诗见怀短章答之 其三","author":"释今无","text":"文心原在此中来，一拨明珠眼自开。\n愧我棒头山信短，为君斫额在蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送方大林入苏门 其一","author":"释今无","text":"明珠寸径出深渊，照耀人间万事圆。\n昔日养来今日取，何须搔首问高天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送方大林入苏门 其二","author":"释今无","text":"岭路吴江隔一关，一篷风去一篷还。\n滩声渔唱原堪乐，不向仙人乞大丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送方大林入苏门 其三","author":"释今无","text":"峰头无数是松枝，爱子殷勤为护持。\n百斛天浆浇已润，及他琥珀未生时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送方大林入苏门 其四","author":"释今无","text":"纹犀花象亦寻常，我自閒求人自忙。\n借问西湖歌舞处，有谁天竺去烧香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送方大林入苏门 其五","author":"释今无","text":"高楼明月紫箫声，万顷寒涛入耳听。\n须信此中无住着，空教白发满头生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47894,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送方大林入苏门 其六","author":"释今无","text":"秋风吹叶满江湖，竹枕桃笙客梦孤。\n莫向醒来觅相似，天南归雁集平芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47895,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送方大林入苏门 其七","author":"释今无","text":"胸怀万事不须留，珍重年光是壮游。\n一树珊瑚千里月，早从贝叶悟浮沤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47896,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长夏久无雨酷暑佘素思朱书思两明府相访顷雨随至与澹归成韵投赠 其一","author":"释今无","text":"烈燄丛中嘶骏马，通身白汗做官人。\n爱君访我维舟处，一笑禅房尽是春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47897,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长夏久无雨酷暑佘素思朱书思两明府相访顷雨随至与澹归成韵投赠 其二","author":"释今无","text":"随车甘雨走神龙，莲气兰香入此中。\n满地弦歌明月夜，还须侧听凤城风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47898,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长夏久无雨酷暑佘素思朱书思两明府相访顷雨随至与澹归成韵投赠 其三","author":"释今无","text":"两邑风流开白社，一盘清俸共丹霞。\n旧时麟凤真来否，今见优昙一叶花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47899,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吼万维那慧均典客请佛舍利于栖贤 其一","author":"释今无","text":"耶舍当年负铁来，灵光今向七贤开。\n凭君为走三千里，亲捧祥云到宝台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47900,"sha256":"dc0f9be95fde68d0587a89f7f11