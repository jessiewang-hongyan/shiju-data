[{"title":"题张天台滦河归兴","author":"金幼孜","text":"久闻作县有清声，三载惟图答圣明。\n忽向青云辞宦辙，深怀白日照忠诚。\n东风酌酒金陵馆，夜月扬帆白下亭。\n此别应须重相见，悬知鹗荐有公卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4536,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠晏彦文佥宪山东","author":"金幼孜","text":"早将姓字籍金闺，又睹乘骢别帝畿。\n十载居官心似铁，三春持节绣为衣。\n声驰当道豺狼避，力奋遥空雕鹗飞。\n为说山东凋弊久，便须揽辔遍询咨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4537,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠王持翰掾河南都司兼寄黄伴读体方","author":"金幼孜","text":"三年京国独相知，远别那堪对酒卮。\n淮浦好山晴似画，汴堤新水绿如漪。\n春风洛下堪携酒，夜雨辕门好赋诗。\n我忆故人黄伴读，为言千里重相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4538,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠宗鲁贝广文还新淦","author":"金幼孜","text":"去年暂会忽相违，此日重来慰所思。\n金阙早朝曾赐酒，玉堂夜语谩论诗。\n斗南冠冕文星聚，泮水弦歌化雨滋。\n惭愧菲材叨宠遇，感怀何以报明时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4539,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽敬先廖检讨","author":"金幼孜","text":"嗟君不见涕汎澜，未读铭文鼻已酸。\n藜阁青灯閒砚席，词林白发少衣冠。\n日边鹤化魂应远，天上楼成梦已残。\n南望孤舟回旅榇，青山叠叠暮云寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4540,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题曾沂渊沂滨清隐卷","author":"金幼孜","text":"沂上幽居乐隐沦，清心久巳谢尘纷。\n日长鸥鸟閒当户，雨后山光远到门。\n花里琴尊娱好客，案头书帙课诸孙。\n舞雩尚想前人旧，此意何时与共论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4541,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠黄彦子赴竹山教谕","author":"金幼孜","text":"与君阔别四年馀，忽领乡书上帝都。\n金殿春风膺荐后，玉堂夜雨盍簪初。\n惊传綵服还乡县，亲听纶音下玉除。\n料想重来应有日，先期稳步蹑云衢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4542,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"七夕与萧迪宽对酌赋此","author":"金幼孜","text":"又向玉京逢七夕，一尊聊与故人同。\n鹊桥有路双星会，银汉无波一水通。\n帘外蛛丝频坠露，楼前凤管独吹风。\n玉堂话旧怜知己，坐对银缸夜未终。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4543,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠杨贵琛南海知县","author":"金幼孜","text":"独膺鹗荐上枫宸，喜有清名在搢绅。\n圣主九重开日月，郎官百里应星辰。\n凉风夜送仙舟远，恩露晨沾墨绶新。\n若过岭南逢驿使，早梅先寄一枝春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4544,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题文江李允诚杏林精舍","author":"金幼孜","text":"传家久得轩岐秘，嗣世仍存济物心。\n门对好山啼鸟静，树藏红雨落花深。\n清朝洗药过松涧，落日鸣琴坐竹林。\n我忆沧洲成久别，濯缨何日共幽寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4545,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠廷振杨处士还清江","author":"金幼孜","text":"客中几见雁南飞，忽向都门赋式微。\n红树碧云迎去棹，西风凉露动征衣。\n入门扫径馀松菊，倚杖看山老蕨薇。\n遥想到家秋未晚，比邻酌酒话京畿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4546,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠魏奉祠还陜西","author":"金幼孜","text":"久向王门作奉祠，朅来京国见容仪。\n圣朝宽宥多恩泽，海㝢康宁际盛时。\n复职惟图脩祀礼，输诚还忆祝繁釐。\n都门相送情何极，折赠梅花雪满枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4547,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠罗大敏教谕之官襄阳","author":"金幼孜","text":"君家远自罗源出，道学相传有豫章。\n世系固应存庆泽，诸孙还喜绍书香。\n圣朝作育文风盛，泮水弦歌化日长。\n早晚到官有馀暇，题诗须上岘山阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4548,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送邹子翚宰通山","author":"金幼孜","text":"去年膺荐来京国，此日分符出帝关。\n行李三春经赤壁，孤舟千里问通山。\n公庭鞭扑长年少，山市喧嚣尽日閒。\n朝罢都门一相送，东风吹柳未堪攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4549,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"正月十四夕黄侍读宗豫请赏莲花灯光大胡公席上有咏走笔属和之","author":"金幼孜","text":"艳质娉婷巧制裁，琼葩高下一时开。\n偏宜午夜瑶池看，绝胜当年玉井栽。\n绛幕斜分霞影乱，画帘低引月华来。\n金吾此夕知无禁，颠倒何妨累百杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4550,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠别友人罗汝弘","author":"金幼孜","text":"久别故人心欲摧，灯前对语谩衔杯。\n严亲慰问劳书札，令弟交游数往来。\n行李欲随孤棹发，趍朝又逐五门开。\n相思莫忘金陵路，还记来时过凤台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4551,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和汝弘客中除夕之作赠别","author":"金幼孜","text":"江湖久客倍思归，行李匆匆忽告违。\n晓日江花留去棹，东风官柳拂征衣。\n壮怀每欲凌仙岛，清誉空惭在禁闱。\n问讯严亲多寿考，玉堂还有寄来诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4552,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和学士胡公陪祀南郊之作","author":"金幼孜","text":"圣君御极绍先皇，每以精神格彼苍。\n漏下斋宫移月影，烟霏紫殿散天香。\n群仙杂遝纷来下，百辟趍陪俨列行。\n预想丰年歌圣德，东郊农事又相将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4553,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠沙同知之官禄州","author":"金幼孜","text":"行人临发意如何，独向津头发棹歌。\n远浦晴烟添草色，沧江宿雨动新波。\n舆图尽入河山壮，海宇均沾雨露多。\n况是远人蒙化久，敷宣好为布阳和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4554,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠刘允佩之官怀庆","author":"金幼孜","text":"新除太守河南去，荣捧天书荷宠光。\n少日才猷期董贾，明时事业继龚黄。\n樯帆隐隐经淮浦，旌旆翩翩指大行。\n圣主忧民图治理，深期补报济时康。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4555,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠周韶凤南归","author":"金幼孜","text":"难兄太学称儒师，令弟相从志不违。\n夜雨频穿管宁榻，春风时下董生帏。\n故家文献应堪继，先世科名自可期。\n此日临岐无限意，愿言力学慰深思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4556,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠彭埙还长洲 其一","author":"金幼孜","text":"与子连宵对客床，觉来犹听诵琅琅。\n已看丱角超馀辈，想见成人更老苍。\n自昔才华推阮谢，只今述作愧班扬。\n明朝独上扁舟去，遥望姑苏隔渺茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4557,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠彭埙还长洲 其二","author":"金幼孜","text":"旧时山口说彭家，文献相传岂浪誇。\n故老百年成梦寐，诸孙今日见才华。\n青灯黄卷心逾苦，流水高山意更赊。\n相送临岐无限思，重来好赋上林花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4558,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题扇赠郭必复","author":"金幼孜","text":"汾阳公子旧知名，两度相逢在玉京。\n入觐已闻输赋足，还家更有赐书荣。\n三山晓日孤帆远，天上清风一握轻。\n乡里如逢知己问，殷勤为我道深情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4559,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠进士傅玉良玉润昆弟还临江","author":"金幼孜","text":"昔年校士忝文衡，争睹朝阳两凤鸣。\n乡里共传登进士，交游为喜得门生。\n三年恋阙君恩重，万里还家昼锦荣。\n回首帝京须到早，上林春好听啼莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4560,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽中书舍人王孟端 其一","author":"金幼孜","text":"雅韵高怀夐绝伦，矫如脩鹤出风尘。\n半生浪迹甘羁旅，一日蜚声列近臣。\n自信王维非画史，谁知贾至是诗人。\n高斋夜雨看遗墨，欲赋招魂泪满巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4561,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽中书舍人王孟端 其二","author":"金幼孜","text":"平生气槩薄虹霓，之死超然更不疑。\n流水浮云无尽意，新图妙墨系深思。\n尚怀退食归青?，犹忆挥毫对凤池。\n惆怅东风回旅榇，淡烟芳草遍天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4562,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠廖自廉沅江教谕","author":"金幼孜","text":"南北暌违又几年，重来两鬓己苍然。\n乞身不厌官资薄，典教应知德操全。\n舟过大湖晴望岳，帆经远浦瞑浮烟。\n菁莪乐育知多暇，应有新诗寄日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4563,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李德固赴分水县丞","author":"金幼孜","text":"几年从事居京国，佐县咸推有艺才。\n辞阙早登沽水驿，问程遥指富春台。\n山临附郭民无事，吏散官衙印少开。\n努力廉勤图报称，好音频寄日边来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4564,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋萧公伯辰庭桂秋香","author":"金幼孜","text":"蟾宫移得树苍苍，碧盖如云覆草堂。\n弈世盘根深雨露，四时孤翠老风霜。\n琼枝浸月秋无影，金粟含风夜有香。\n翘首南山应咫尺，早期招隐掇仙芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4565,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为杨谕德题赠蒋御医","author":"金幼孜","text":"承家旧得轩岐学，绝艺于今独罕俦。\n待漏每蒙天语召，校方不厌世人求。\n杏林花重红云晓，橘井泉香玉露秋。\n惭愧微生无恙久，独怀高谊未能酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4566,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乙未三月一日策试进士读卷","author":"金幼孜","text":"圣主临轩亲策士，新颁御敕墨淋漓。\n百年礼乐逢兴运，一代文章际盛时。\n天近蓬莱香雾湿，日回阊阖漏声迟。\n有周幸睹贤才盛，感遇惟歌棫朴诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4567,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白鹤山房为学士杨公赋","author":"金幼孜","text":"白鹤之山高插天，盘盘先垄翳苍烟。\n凌云古木千章合，映日灵芝五色鲜。\n清白远传簪笏在，诗书今见子孙贤。\n知君感遇恩尤厚，好勒封碑树墓田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4568,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题朱太守永贞堂","author":"金幼孜","text":"早岁孀居失所天，独馀白发照林泉。\n共姜有誓心难变，令女无瑕操愈坚。\n雪里松筠宜并秀，风中桃李谩争妍。\n圣朝砥砺崇名节，行睹旌书下日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4569,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题海南程氏贞节卷","author":"金幼孜","text":"痛彻苍天泪若翻，仰天长诀竟何言。\n三生不负同心约，一死难忘结发恩。\n妆镜尘生遗粉黛，泉台月冷照香魂。\n玉堂展卷题贞烈，千载芳名表墓门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4570,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠魏千户","author":"金幼孜","text":"扈驾亲曾翊圣躬，壮年应敌万夫雄。\n腰悬宝剑龙光动，手撚雕弓鹊血红。\n辇路看花春跃马，长安通籍晓闻钟。\n只今海宇风尘净，长倚恩光近九重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4571,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽沈生潮","author":"金幼孜","text":"气质温然玉雪清，未登弱冠巳先倾。\n生前总得亲知重，死后难胜祖父情。\n空见残书留箧笥，忍看遗骨瘗佳城。\n临风为尔增深慨，读罢铭文泪满缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4572,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠萧迪敏南还","author":"金幼孜","text":"晓日都门莺乱鸣，那堪把酒问归程。\n天涯绿暗花将尽，沽口船高水正生。\n莫谓难兄伤别意，极知慈母慰深情。\n故乡耆旧如相见，为道平安寄远声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4573,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"继志堂为李存节赋","author":"金幼孜","text":"闻说君家住渝阳，至今绕屋树千章。\n花前腊酒开春宴，竹里书灯照夜堂。\n自信流传多庆泽，况闻继述付贤良。\n深期努力追先烈，弈世绵绵望耿光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4574,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"贝祭酒泰求赠谢良翰","author":"金幼孜","text":"妙年文采照青云，喜有声华蔼缙绅。\n五载听鸡留阙下，一朝走马向三闽。\n野梅融雪经残腊，江柳舒云动早春。\n见说郡中尘事少，红莲绿水四时新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4575,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"龙川八景二首为宋常固赋 其一 合溪温泉","author":"金幼孜","text":"清泠一派浑堪爱，瑩彻溪流绝点尘。\n苍峡氤氲晴起雾，远空荡漾暖生春。\n光摇鲛室通银海，影泛鸥波动碧?。\n此日郎官分泻去，好为霖雨济斯民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4576,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"龙川八景二首为宋常固赋 其二 龙潭飞瀑","author":"金幼孜","text":"澄潭万顷映长天，为爱飞流在目前。\n映日似从银汉落，垂空偏讶玉虹悬。\n流归沧海翻晴浪，远度寒岩湿紫烟。\n自是长风吹不断，应同庐阜泻前川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4577,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送周编修功叙南归省亲","author":"金幼孜","text":"京华每日念慈闱，目断西江思欲飞。\n方切陈词趋北阙，喜闻给驿赐南归。\n蓟门天阔鸿声远，淮海霜清木叶稀。\n想得到家称寿日，天香犹自染班衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4578,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题傅氏双桂堂","author":"金幼孜","text":"君家伯仲最贤良，并立还胜五桂芳。\n共喜枝柯承雨露，更同节操老冰霜。\n蟾宫接武青云近，仙籍联名白日光。\n弈叶信知流庆远，年年花里掇秋香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4579,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元夕观灯应制 其一","author":"金幼孜","text":"蓬莱高耸五云端，蜡炬融春夜不寒。\n月满琼林花作阵，星垂瑶树锦为团。\n紫霞潋滟浮仙醴，香雾氤氲绕御銮。\n岁岁镐京沾赐宴，恩波浩荡海同宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4580,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元夕观灯应制 其二","author":"金幼孜","text":"金莲五夜灿瑶台，一派星河彻夜开。\n银瓮蒲萄天上出，翠华騕䮍月中来。\n地临太液虹光合，春满神都御气回。\n此夕传柑知感遇，嵩呼愿进万年杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4581,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元夕观灯应制 其三","author":"金幼孜","text":"帝京三五值佳辰，灯月澄辉霁景新。\n大地山河天不夜，满城箫鼓暖生春。\n宴游遭遇同千载，盛事欢娱及万民。\n拜祝吾皇千万寿，深惭献赋忝词臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4582,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"济美堂为郭郎中鼎贞题","author":"金幼孜","text":"故家世系出汾阳，数百年来倍有光。\n门外青山馀黛色，屋边乔木老风霜。\n传家自信诗书美，启后方知庆泽长。\n回首东梅溪上路，至今簪笏照高堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4583,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题傅玉良春山访友图","author":"金幼孜","text":"春山伐木晓丁丁，何事相求念友生。\n乍听岩前飞瀑响，还闻谷口送莺声。\n日高野寺僧犹卧，烟暝溪桥客独行。\n我亦平生爱林壑，展图此日动归情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4584,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东梅八景为刑部郎中郭鼎贞题 其一 三坳浮岚","author":"金幼孜","text":"群峰削玉倚青天，迤逦浮岚断复连。\n远树尽疑含宿雾，长林不辨杂飞烟。\n随风冉冉沾衣袖，带雨冥冥湿锦鞯。\n却忆东梅溪上路，芒鞋几度踏曾巅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4585,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东梅八景为刑部郎中郭鼎贞题 其二 九峰叠翠","author":"金幼孜","text":"叠嶂回峦复几重，千岩万壑翠连空。\n遥兼积霭林光润，近染晴云树色浓。\n深涧鸟啼迷晚黛，苍崖人语度冥濛。\n忆从蚤岁同登览，曾上凌霄第一峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4586,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东梅八景为刑部郎中郭鼎贞题 其三 石桥流水","author":"金幼孜","text":"石桥磊落跨溪流，长日溪头事事幽。\n一片雨声来枕畔，半空云影上帘钩。\n花间濯足闻清濑，柳下垂纶近白鸥。\n有约还山寻旧隐，芒鞋竹杖共追游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4587,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东梅八景为刑部郎中郭鼎贞题 其四 驿路停骖","author":"金幼孜","text":"青山叠叠树苍苍，驿骑时看驻道傍。\n嘶向柳边当薄暮，饮来花底爱微凉。\n解装暂息征途倦，振辔宁忘去驿长。\n愧我两京叨扈跸，驰驱几得从飞黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4588,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东梅八景为刑部郎中郭鼎贞题 其五 竹冈晚照","author":"金幼孜","text":"翠竹冈头景物幽，长天落日澹悠悠。\n几家返照催砧杵，半壁新蟾入画楼。\n高垄牛归樵己散，沧溪渔罢网初收。\n故家迢递金川外，犹忆登临共唱酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4589,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东梅八景为刑部郎中郭鼎贞题 其六 山寺晓钟","author":"金幼孜","text":"兰若疏钟晓露凉，扶桑海色曙苍苍。\n遥催落月沉西岭，微度閒云出上方。\n鹤下巢边鸣竹径，僧从定处启松房。\n几回待漏趋丹禁，阊阖声中拜玉皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4590,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东梅八景为刑部郎中郭鼎贞题 其七 狮山霁雪","author":"金幼孜","text":"大雪舒晴绚碧霄，山前积素拟琼瑶。\n千林日转寒将散，万壑阳和冻欲消。\n谷口问人初见路，溪头送客渐通桥。\n玉堂岁岁逢三白，吟对西山寄泬寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4591,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东梅八景为刑部郎中郭鼎贞题 其八 蛇岭晴云","author":"金幼孜","text":"苍岭蜿蜒去复回，白云千仞压崔嵬。\n高林缥缈晴光合，列嶂絪缊旭景开。\n己见从龙天上去，还闻伴鹤日边来。\n承恩屡到蓬莱岛，五色曾看拥上台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4592,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元夕赐观灯 其一","author":"金幼孜","text":"阊阖天门开九重，玉楼金殿月朣胧。\n共看鳌背辞沧海，独向龙墀拥翠峰。\n瑞雪暖融鳷鹊观，庆云晴护建章宫。\n盛时佳节逢元夜，此夕欢娱万国同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4593,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元夕赐观灯 其三","author":"金幼孜","text":"宝树金莲万炬明，春风一夜百花荣。\n绛纱含雾垂珠幕，紫焰蒸霞晃绣楹。\n洛水涵光龟象出，荥河流耀马图呈。\n仙禽灵兽多嘉瑞，尽见扬辉入太清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4594,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元夕赐观灯 其五","author":"金幼孜","text":"五色祥云奉御筵，翠华垂盖出中天。\n玉龙吐焰开灵曜，金鸭腾薰蔼瑞烟。\n淑气晴含旗影动，轻飙微带漏声传。\n教坊初进升平曲，凤吹鸾笙杂管弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4595,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元夕赐观灯 其七","author":"金幼孜","text":"罗绮含薰綵队盈，金花翠帽锦装成。\n奉琛献璧诸番贡，舞縆寻橦百伎呈。\n戏帐弄娇空外影，挈帷巧出静中声。\n三农更有丰年曲，齐向天街歌太平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4596,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元夕赐观灯 其八","author":"金幼孜","text":"锦额瑜环童伎儿，分行列队向彤墀。\n当筵齐唱摩尼曲，对御还歌大圣词。\n宝藏金钱颁出富，雕盘珍果赐来奇。\n衮衣浮动阳和满，正是天颜有喜时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4597,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]