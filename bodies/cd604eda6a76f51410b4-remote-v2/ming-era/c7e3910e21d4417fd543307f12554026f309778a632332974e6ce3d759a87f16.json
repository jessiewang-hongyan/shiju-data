[{"title":"秋夜 其二","author":"凌义渠","text":"绊云偷影玉儿神，楚楚宫钗月到门。\n祗恨抱香同一死，几多风焰喝娇魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25692,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜 其三","author":"凌义渠","text":"擘将心事恳来生，首尾伤心凑不成。\n点点明河寒似水，教人著眼怕分明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25693,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜 其四","author":"凌义渠","text":"织病缲愁未解欢，秋肌不检五更寒。\n是谁消得无明泪，堕粉零脂湿牡丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25694,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜坐柬潘右安闵园客 其一","author":"凌义渠","text":"六月疑徂暑，微凉早袭余。\n读书承以暇，兹夕专其馀。\n静置影形幻，落然相与居。\n迟君此时意，语嘿谅何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25695,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜坐柬潘右安闵园客 其二","author":"凌义渠","text":"未觉有馀思，皆因静后生。\n百虫纷欲语，秋意淡相迎。\n寒照才能续，悲欢以次平。\n灵根须共惜，辛切见交情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25696,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"七夕闺意","author":"凌义渠","text":"纤指亲能授，微诚得暂通。\n小窗勤夜祀，盆水靧馀红。\n径静人稀后，非花非雾中。\n偶然成映带，儿意逆相同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25697,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"沈令升目疾讯之","author":"凌义渠","text":"残暑未遑却，新凉日以几。\n闭门兼理疾，酬答雅能稀。\n五色纷为役，一灯寒更微。\n期君声影外，瞑坐见因依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25698,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜半馆中","author":"凌义渠","text":"拈书乱首尾，静听少传签。\n僵月冲人影，丛枝飒鬼髯。\n灯昏陪鼠坐，壁冷看蜗粘。\n亦觉撑眉苦，离披到枕甜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25699,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿丁母 其一","author":"凌义渠","text":"襞綵衣还剪，书彤笔合丹。\n明蟾窥夜杼，纺纬叫霜栏。\n覆畹芝全茁，衔沙竹透瘢。\n春韶看几许，容易勿丛残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25700,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿丁母 其二","author":"凌义渠","text":"煖阁娇新燕，閒窗扑小蝇。\n杯擎灵寿节，眉秃远山棱。\n天语夜深倚，香軿取次凭。\n无因拟百禄，拭眼照掀腾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25701,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题舅氏闵康侯一草堂 其一","author":"凌义渠","text":"偶然风绪惬，浥浥片心降。\n烛冷清连曙，吟馀梵写腔。\n荷钿开晓镜，蕉露亚秋窗。\n底怪穿棂月，移人影半双。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25702,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题舅氏闵康侯一草堂 其二","author":"凌义渠","text":"閒情纷怪冶，文几漾高危。\n书以等身僻，奇从一事知。\n种玄扬地宅，押韵李门楣。\n静倚沾茶候，芸签总懒窥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25703,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"两头纤纤 其一","author":"凌义渠","text":"两头纤纤眉尾拖，半黑半白影摩挲。\n腷腷膊膊缀寒窠，磊磊落落看谁过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25704,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"两头纤纤 其二","author":"凌义渠","text":"两头纤纤姬姓分，半黑半白秦皇嗔。\n腷腷膊膊项羽陈，磊磊落落沛亭人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25705,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"两头纤纤 其三","author":"凌义渠","text":"两头纤纤笔墨匀，半黑半白闱中人。\n腷腷膊膊六街尘，磊磊落落悬泪新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25706,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得薄命词 其一","author":"凌义渠","text":"倦倚东风两袖斑，临岐不尽水潺湲。\n题残红叶春谁主，低损成都翠几弯。\n鸣鴂也知覆百草，绛绡长得护朱颜。\n伤心拍遍无人会，个是杨家旧阿环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25707,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得薄命词 其二","author":"凌义渠","text":"叫断行云凭借梯，孤情灯箔影凄凄。\n相关不浅江湖泪，是处平分桃李蹊。\n明镜也知羞屡照，落英敢复怨飘泥。\n殷勤为语章台柳，一任群鸦傍晚栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25708,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得薄命词 其三","author":"凌义渠","text":"装云做雨总堪怜，色借芙蓉也自妍。\n几向朱门窥赠枕，时闻月下整辎軿。\n不愁入眼春无态，祗恨穿花蝶作缘。\n记取醉馀人散后，侬家合比夜舒莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25709,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得薄命词 其四","author":"凌义渠","text":"羞把腰身傍六街，自缘命薄遇时乖。\n前身误逐风流队，此日新铺烟月牌。\n笔笔远山生黯淡，声声绿绮奏淫哇。\n看谁解作东君主，寂寞梅根古玉钗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25710,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得薄命词 其五","author":"凌义渠","text":"参参逋发为谁盘，屏上腰肢作意安。\n殢雨牵云浑欲叹，同床各梦好相干。\n佳人隐语芙蓉笑，荡子相思红豆看。\n箭作风流石作侣，于今拟是望夫难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25711,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得薄命词 其六","author":"凌义渠","text":"望里春山耸复低，依依眼角转凄迷。\n楼空金谷花无主，柳暗章台鸟乱啼。\n誓许三生谐半面，又愁白日惜分飞。\n可怜的的芙蕖蕊，也照清江也照泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25712,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得薄命词 其七","author":"凌义渠","text":"饶他韵格总天真，随喜随嗔另有神。\n遮莫紫钗穷霍玉，都缘红粉误东邻。\n梦回短帕新题燕，袖笼馀香本姓荀。\n为怕洛阳人看杀，一枝聊复湿风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25713,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得薄命词 其八","author":"凌义渠","text":"倦扶玉颊强为情，枉把双蛾累此生。\n月下歌喉花下酒，秦楼吹瑟楚楼筝。\n伤心夜半留题目，屈指年来几姓名。\n任尔回头饶百万，料伊还念马长卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25714,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得薄命词 其九","author":"凌义渠","text":"含娇懒著黛螺烟，朵朵菱荷倚日鲜。\n薄倖总惭荀奉倩，微名敢傍汉伶玄。\n妆嚬做笑风流减，种柳栽桃义士偏。\n犹恨古生仗剑后，垆头春色少人怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25715,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得薄命词 其十","author":"凌义渠","text":"彼美何人天一涯，庵罗到处谩随车。\n强调朱粉犹疑梦，乍听笙簧冷自嗟。\n便道折来花有主，凭谁做得玉无瑕。\n回眸不尽苍茫色，踏踏芳茸过几家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25716,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得薄命词 其十一","author":"凌义渠","text":"搔头无奈语谵痴，赢得巉岏骨几支。\n兰玉终须随百草，凤雏久矣怯寒䲭。\n人间不少合欢曲，何处偏歌薄命词。\n阁笔茫然天地老，断肠元不为些儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25717,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日漫兴 其一","author":"凌义渠","text":"一番风雨一番尘，眼底韶华梦未真。\n面壁袛应书怪字，题诗久矣怯花神。\n谁当垒磈思浇酒，自领閒情拟赋甄。\n解道随缘无不可，少年容易惹颠嗔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25718,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日漫兴 其二","author":"凌义渠","text":"浪花溪柳总纷纷，个里连绵日易曛。\n到枕几回抽冷焰，窥铜亲与押愁纹。\n偶然会意怜三笑，不为逃禅断五荤。\n拚向南枝随偃息，窗前百舌欲何云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25719,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日漫兴 其三","author":"凌义渠","text":"局中应自混妍媸，怪雨盲风任所施。\n不信无盐饶半席，也知西子葬江鸱。\n恨馀赵氏孪生女，肠断杨家大小姨。\n一任蛾眉多薄命，妆成骨瘦悔蛾眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25720,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日漫兴 其四","author":"凌义渠","text":"聊凭短几决行藏，墨染杨岐祗自忙。\n试看眼中谁故物，那教眉画不时妆。\n棘闱射覆如骰子，艺苑留题是孔方。\n彼此一般无證佐，暂扶红额上排场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25721,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日漫兴 其五","author":"凌义渠","text":"生来韵格故崎嵚，检点时贤愧少箴。\n第一生涯惟货殖，最无回味是书淫。\n守悭未必非完策，谋食终须负苦心。\n莫怪昔人贫彻骨，昔人容易侮黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25722,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日漫兴 其六","author":"凌义渠","text":"为瑟为竽调转孤，文章千万一葫芦。\n几人能识真李贽，到处偏争假卓吾。\n每听风声思吠影，时留黛粉学妆狐。\n凭谁尽扫尘霾路，万里霜天湛玉壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25723,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日漫兴 其七","author":"凌义渠","text":"中原鞭弭许谁先，为爱雕虫道转玄。\n自昔文章重江左，即今芳誉贵临川。\n巧搜法象开天手，别运思维上水船。\n何物腐儒频缩舌，生来元不受人怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25724,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日漫兴 其八","author":"凌义渠","text":"造物何心妒复悭，凭谁叫转小儿天。\n好花长得陪妆面，锦字时能富酒钱。\n无象太平春共醉，有情夫妇月同圆。\n更须拨尽周公礼，日课南华第几篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25725,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"玉儿怨","author":"凌义渠","text":"萧家天子搯花心，田家小儿癞麒麟。\n窝云委堕抛香颈，双尖折折到宫门。\n瘦影剪肌何所似，蔷薇历乱啼幽素。\n春魂一线背斜阳，两两游蜂浥寒唾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25726,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"无题","author":"凌义渠","text":"剖分缕血为新联，文到精晖懒作椽。\n直是琵琶输饭甑，个侬无赖老临川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25727,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"双节诗为刘竟澄工部赋","author":"凌义渠","text":"派近馀溪水，澄寒君自知。\n温风及宿草，瀼露遍新枝。\n两世心如结，孤生泪易滋。\n冰渊凛日夕，念念是孀慈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25728,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和刘同人燕中即事诗六首 其一 卖衣","author":"凌义渠","text":"岂有裘和葛，冬春共一囊。\n新裁拣入市，败枲任堆床。\n已自甘由缊，谁堪裛蹠香。\n我私忍便弃，慈母泽难忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25729,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和刘同人燕中即事诗六首 其二 卖貂帽","author":"凌义渠","text":"心怯长安路，艰难备一貂。\n追欢曾几月，抛冷只今朝。\n腻紫迎沙透，香茸带雪娇。\n跨驴头戛戛，贳酒亦何聊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25730,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和刘同人燕中即事诗六首 其三 卖书","author":"凌义渠","text":"雠校每终夜，丹黄不妄研。\n购来时倒廪，换去可论钱。\n好托知音在，免随故纸捐。\n奇编难再值，追昔已徒然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25731,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和刘同人燕中即事诗六首 其四 卖镜","author":"凌义渠","text":"愁多久罢炤，出匣影濛濛。\n梳裹聊为尔，冠巾奚取同。\n伴衰惟镊白，配艳好传红。\n圆缺都无意，他年未拟通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25732,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和刘同人燕中即事诗六首 其五 卖笔履","author":"凌义渠","text":"二物虽兼售，何能遂济贫。\n摊门殊琐琐，搜箧已频频。\n颖客濡谁健，针工整始新。\n酸寒君莫笑，凑作杖头缗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25733,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和刘同人燕中即事诗六首 其六 卖剑","author":"凌义渠","text":"龙渊辞我去，床头分外孤。\n何人占宝气，枉自掷泥涂。\n侠节能酬否，儒装解佩无。\n犹疑中夜啸，酒醒辄相呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25734,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"友人席次闻杨维节白下讣悼之","author":"凌义渠","text":"剪烛更阑话未休，俄成悲怅向虔州。\n心争短晷常疑佛，力尽危条可耐秋。\n哀尔积思何太苦，念予住世倏如浮。\n推诚济物天须惜，岂有斯人不暂留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25735,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同吴磊斋集湖舫时寇陷中都有投鞭江流之意","author":"凌义渠","text":"同官闷闷欲何之，此日堤桥坦步时。\n但及世情须掩耳，尽兹天气好舒眉。\n醵钱布席交宾主，从众观场混喜悲。\n不觉闻歌中坐起，太平乐事得频追。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25736,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟宿京口","author":"凌义渠","text":"城乌绕堞怯高寒，彻曙严更听未残。\n骨肉轻离千绪结，图书稳付一肩安。\n厌兵渐觉愁江叟，转饷仍闻急县官。\n真愧蚩蚩篱壁下，远行待吉始知难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25737,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"扬州住一日警报未息城守犹严","author":"凌义渠","text":"雷塘半暝月初出，迎銮荒址未全失。\n百万釜鱼幸脱钩，朝来顾影犹戢戢。\n用物太尽神所窥，此方诲盗岂一日。\n趁兹收拾已云晚，牢键重城如勿及。\n急管繁丝咽不调，稚草嫣花叹在室。\n向来秾羡何可常，天意移人在萧瑟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25738,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"遗发咏偶感唐人欧阳詹钟情事拟为之","author":"凌义渠","text":"桐花散落无消息，开缄犹裹片云湿。\n膏腻消尽不复存，剩有红丝惨灰色。\n小小幻缘过则休，孰令此孽系心头。\n偶然触手同苔石，镜里钗边若可求。\n求不得，亦辛切，归火归风乌可说。\n凭持一缭漫招魂，野棠飞坠茫茫月。\n眼看百物几回新，丝丝飏去未足论。\n肌肉已知耕作土，半鬟能保不随尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25739,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"抵家杂感 其一","author":"凌义渠","text":"我居未定不须论，泊岸移时又出门。\n爱傍亲帏姑近市，言归旧族只依村。\n寄人廊庑篱偏绽，曝向馀冬日渐温。\n阅尽枯荣五载内，徘徊庭际亦知恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25740,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"抵家杂感 其二","author":"凌义渠","text":"久出思归念自真，乘秋初不为鲈莼。\n眼前大宅皆新主，旧日藏书即古人。\n偶窃虚名来剥啄，多因细务夺精神。\n閒时惯说家居好，百感茫茫负一春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25741,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"盛灵飞以访吴兴山水至余适自楚归雨中留饮","author":"凌义渠","text":"如兹好事见何曾，拟伴同游适未能。\n得句口忙频授子，寻山路杳辄依僧。\n情悰离合恒三稔，语话连绵共一灯。\n偶及湘天清绝处，爱君酒趣亦旋增。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25742,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"德藩内苑观白鹦鹉","author":"凌义渠","text":"绿衣诚自贱，雪色表奇姿。\n留顶装金粟，倾身抱玉脂。\n当筵花暂放，见客语偏迟。\n洁美堪谁俪，君王知未知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25743,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"饮卢德水杜亭用其原韵为赠","author":"凌义渠","text":"十载閒居户屡扃，开樽揖客有斯亭。\n如凭俎豆通今古，岂止诗文备典刑。\n念子精勤不暂息，问予浮惰几时惺。\n㴞㴞末俗存孤简，竹石无言气自青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25744,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"午日东平道中汪孺石自济上驰讯并示近刻","author":"凌义渠","text":"倥匆漕挽日相牵，偏有閒心问客边。\n热不因人仍濩落，官思称职独劳贤。\n江帆梦熟随千里，池柳风疏又一年。\n节届蒲葵成独醉，朗吟新句亦陶然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25745,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜泛大明湖","author":"凌义渠","text":"数曲城隅水，悠然别有源。\n岚光偕晚静，泽气与秋屯。\n小艓宽于掌，芳洲环似盆。\n苇乾声乍起，菰烂韵无存。\n一任风掀烛，徐当月满樽。\n沿洄随所向，近远讵须论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25746,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"枫亭驿荔枝数株甚古云数百年物","author":"凌义渠","text":"经谁手植古亭边，宅近端明世所传。\n不染烟霜肤更泽，独超尘劫气恒坚。\n根蟠苍兕疑掀地，㷔发红云直透天。\n多少澜翻人事内，秋风筐实自年年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25747,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨阻海州公署","author":"凌义渠","text":"昏黄海气日霏霏，洒到枯枝绿暂肥。\n梦绕君亲徒内讼，路迷去住可忘机。\n晨趋野市鱼蔬绝，夜伴孤城鸣吠稀。\n赖是数编相对寂，舟舆到处足因依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25748,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"历下官署杂咏 其一","author":"凌义渠","text":"即此称官隐，俄延遂一周。\n俸钱差不薄，饱食尚何求。\n静几香堪炙，尘床印懒收。\n本无迁客意，行住总夷犹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25749,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"历下官署杂咏 其二","author":"凌义渠","text":"熙朝公事毕，尽属闭门时。\n岁俭民无讼，官閒吏苦饥。\n下帷理旧业，课子得新知。\n兀兀童心在，犹堪角技为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25750,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"历下官署杂咏 其三","author":"凌义渠","text":"忤时久不调，辖地复荒残。\n蹇滞非无故，暄吹信有端。\n长途各努力，相识尽弹冠。\n古道望知己，无为嗟路难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25751,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"历下官署杂咏 其四","author":"凌义渠","text":"出门何所见，闾井盛蒿莱。\n白日饥鼯窜，中宵妖鵩哀。\n编蒲姑听政，插棘且抡才。\n版筑兴何已，秋霖处处灾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25752,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"历下官署杂咏 其五","author":"凌义渠","text":"煽乱寻常事，蚩蚩宁莫惩。\n聚徒今水泊，祀赛古东陵。\n列寨环相守，雄渠非一称。\n贼除民并尽，天意果何凭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25753,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"历下官署杂咏 其六","author":"凌义渠","text":"生逢流极运，无路得潜逃。\n骨肉忍相噬，贤愚共一蒿。\n腐尸争鸟啄，怨魄学狐嘷。\n精卫思填海，区区母太劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25754,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"历下官署杂咏 其七","author":"凌义渠","text":"靡孑成真谱，诗言岂尽诬。\n全家委夜壑，深巷惨啼乌。\n版籍空名在，田园多半芜。\n纷然漕使出，犹议急追逋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25755,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"历下官署杂咏 其八","author":"凌义渠","text":"曾将一二事，妄拟饰升平。\n未信时年好，稍怜颜色赢。\n佛龛添梵响，村塾有书声。\n止此足称瑞，怡然慰莫情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25756,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"小饮卢德水斋中","author":"凌义渠","text":"知子避人久，为予勉送迎。\n主宾仓卒事，蔬果澹交情。\n执手言无次，开怀量已盈。\n出门仍眷恋，愧羡一时生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25757,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]