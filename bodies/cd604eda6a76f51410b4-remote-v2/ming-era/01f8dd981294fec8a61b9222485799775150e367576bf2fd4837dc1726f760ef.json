[{"title":"望月","author":"黎景义","text":"天公一寸刃，昨夜杀妖蟆。\n坐使高楼月，光流五色霞。\n云山连水面，烟树杂人家。\n身在清虚府，何劳借海查。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39590,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"远寄","author":"黎景义","text":"天涯嗟隔断，金玉恨遐心。\n数夜成齑臼，因风寄稿砧。\n白云行处识，芳草梦中寻。\n愿以回文句，行行有转音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39591,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日即事 其一","author":"黎景义","text":"啸傲闲庭午，优游小院晴。\n葛衫披处爽，木屐步来轻。\n沼底看鱼戏，林阴避日明。\n景风拂短袂，饶有故人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39592,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日即事 其二","author":"黎景义","text":"但有微凉到，偏宜伏晷延。\n红垂一树枣，白挺几枝莲。\n花色骄罗绮，蝉鸣藐管弦。\n楚骚多妙意，独爱远游篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39593,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十僧诗和曾子唯 其一 诗僧","author":"黎景义","text":"莲社多佳韵，才华别趣奇。\n分题咸尚僻，觅句不嫌迟。\n七字堪为号，单言即是师。\n想从天下去，还似坐禅时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39594,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十僧诗和曾子唯 其二 懒僧","author":"黎景义","text":"禅心云水适，无事梵林间。\n捲卷红尘满，高眠白昼閒。\n旃檀灰自烬，兰若户常关。\n别有牛头上，融公若是班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39595,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十僧诗和曾子唯 其三 游僧","author":"黎景义","text":"振衲离萧寺，修途寄远踪。\n渡芦江月破，飞锡岭云冲。\n不记归来路，常闻到处钟。\n旧时方丈外，西向几枝松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39596,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十僧诗和曾子唯 其四 讲僧","author":"黎景义","text":"摇麈谈真性，青烟绕梵炉。\n任教鹅自伏，不管貉相?。\n法舍飘花雨，精坛聚石徒。\n谁云有文字，难与悟浮屠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39597,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十僧诗和曾子唯 其五 病僧","author":"黎景义","text":"尪然栖古刹，身世岂堪悲。\n药鼎相看熟，禅床独坐罢。\n发长犹懒薙，衣重不胜披。\n但遣空诸蕴，奚劳洒柳枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39598,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十僧诗和曾子唯 其六 老僧","author":"黎景义","text":"延龄忘凤历，微发白参差。\n人定心神了，安禅气力衰。\n蒲团闻道久，贝叶读经迟。\n衣钵长无恙，馀生乐住持。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39599,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十僧诗和曾子唯 其七 贫僧","author":"黎景义","text":"瓶钵生涯淡，寥寥与俗遗。\n伊蒲恒绝馔，无垢不完衣。\n塔院慈云宿，房廊慧月归。\n最饶清净况，谁复坐巍巍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39600,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十僧诗和曾子唯 其八 山僧","author":"黎景义","text":"峻岭超尘劫，云霞半寺涵。\n嶵嵬参大乘，合沓礼瞿昙。\n旷谷酬晡罄，重缁染曙岚。\n龙吟如更响，疑是在终南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39601,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十僧诗和曾子唯 其九 禅僧","author":"黎景义","text":"尘埃何所惹，无作坐幡阴。\n拂户非风动，盈庭自雪深。\n尽教三昧彻，那受万缘淫。\n悟到忘言处，空空是此心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39602,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十僧诗和曾子唯 其十 发僧","author":"黎景义","text":"自得真如湛，何须尽刬章。\n紫衣同取次，青鬓异寻常。\n洗钵游嵩径，鸣钟爇柏芗。\n莫疑非释性，烦恼已相忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39603,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游海珠 其一","author":"黎景义","text":"慈度登临美，芳樽览胜开。\n空阶初雨歇，古水自风来。\n笑傲行龙颔，逍遥踏蚌胎。\n翻疑起弱水，羽辙入蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39604,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游海珠 其二","author":"黎景义","text":"一点鲛人泪，江心戴敞亭。\n古今潮迭长，遐迩客频经。\n广海环基碧，隃山隔屿青。\n平生慕忠简，今日拜遗形。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39605,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游海珠 其三","author":"黎景义","text":"兰若中流出，征帆四面游。\n瑶台临蜃气，金地镇鳌头。\n波定形如画，涛惊势欲浮。\n兴狂不觉晚，带月泛归舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39606,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀梁七克矩","author":"黎景义","text":"有客马蹄远，无书鸿足还。\n韵裁赓雨霁，枰忆战灯閒。\n傲竹敲琅骨，酡莲哂绛颜。\n南熏吹别意，一夕渡吴山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39607,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春宵燕集喜五华伯入社 其一","author":"黎景义","text":"春晖入莲社，良会逼高舂。\n霁朗鸟情美，风和兰韵浓。\n笑来忘是虎，登处即为龙。\n醉问竹林友，何如阮仲容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39608,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春宵燕集喜五华伯入社 其二","author":"黎景义","text":"今夕天文异，璧丛多一星。\n鸱夷当世务，麈尾古人灵。\n肝胆坦飞白，勋华俟杀青。\n相期抟九万，吾亦附灵翎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39609,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春怨","author":"黎景义","text":"记得牵衣别，今年此日同。\n草含多恨绿，花褪可怜红。\n燕燕新翎协，莺莺煖语融。\n柔肠千斛怨，露出澹眉中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39610,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"烂醉","author":"黎景义","text":"此身非毕阮，亦向醉乡游。\n凭仗杯中物，浇除分外愁。\n事徂感幻梦，年改迈湍流。\n酣卧不知晓，吾生一赘疣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39611,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张启男崇南过集","author":"黎景义","text":"知己朋簪合，埙篪妙友于。\n当歌风景淡，薄醉月华都。\n读古商奇字，询年惜壮图。\n吾侪有真韵，偏与俗人殊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39612,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中书事","author":"黎景义","text":"山中颇幽僻，嚣俗不相闻。\n性果凭心植，书苗倩笔耘。\n天青光气迥，水碧细流分。\n觱发风生处，翔鹰绕朔云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39613,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮冬题斋壁","author":"黎景义","text":"腊雪飘寒色，萧萧一草亭。\n操成多绿绮，敲缺几青萍。\n客至犹扪虱，书横自炙萤。\n梅花当夜发，心绪若为馨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39614,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宗弟和生过访华伯航叔仝集却怀梁文瓒 其一","author":"黎景义","text":"星聚女牛炯，春深池草生。\n弟兄今夕酒，天地几人情。\n坐久看花发，谈豪忘雨晴。\n昨宵良不远，有客叹分萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39615,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宗弟和生过访华伯航叔仝集却怀梁文瓒 其二","author":"黎景义","text":"乘雨淹觞斝，斜阳霁晚空。\n席间惭谢羯，关外忆梁鸿。\n笈蒯年华异，交游感慨同。\n停云无限意，还寄对床风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39616,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偕方子云偶至慈度庵","author":"黎景义","text":"行行唯恐尽，意外得旃林。\n径草碧相引，疏钟遥可寻。\n听禽寒色外，啜茗小亭阴。\n幽静能如此，翛然似我心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39617,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄梁盛祥","author":"黎景义","text":"尚友如吾党，平生慎盍簪。\n喜于扬子宅，得接伯鸾音。\n目治即青色，神交先素心。\n桃源速归兴，桂水引遥吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39618,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"门人何乃图过访留宿赋赠","author":"黎景义","text":"澹交离索久，一见慰遐思。\n朗朗百间屋，汪汪千顷陂。\n壮心怜晓月，佳句逼寒飔。\n白首吾无似，青云尔厚期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39619,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭敬叔 其一","author":"黎景义","text":"与子为兄弟，生强十数年。\n相期齐白首，可惜隔黄泉。\n浩气山河壮，高名日月县。\n尔姑吾老母，悼尔重悽然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39620,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭敬叔 其二","author":"黎景义","text":"昔我壮游学，同人多冠军。\n奇君方数日，搦管便凌云。\n独步压东国，先鞭超北群。\n今朝读书处，难复与论文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39621,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭敬叔 其三","author":"黎景义","text":"十月发梅花，寒飙感物华。\n我方嗟阔别，而乃报登遐。\n电影徂騕袅，霜芒瘗镆铘。\n著书知满箧，殊马异乡家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39622,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭敬叔 其四","author":"黎景义","text":"古来皆有死，若子弗惭生。\n小学观鸮集，高科听鹿鸣。\n无双信不忝，第一愧尤英。\n更爱天彝卓，真醇自性情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39623,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭敬叔 其五","author":"黎景义","text":"岂徒伤短命，三叠叹秋风。\n世变初今异，心惟尔我同。\n门常关柳畔，径祇辟篁中。\n共励千秋业，谁知一半空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39624,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭敬叔 其六","author":"黎景义","text":"白玉楼交就，灵光殿赋传。\n寰区潜有藉，馆舍忍言捐。\n发轫摧滂轴，中流覆狄船。\n哭君无限意，总付获麟篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39625,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭敬叔 其七","author":"黎景义","text":"二人犹未老，一去竟何之。\n贾母望无迹，颜繇情孔悲。\n修文虽足任，肯构若仍亏。\n抱子怜渠小，年将及让梨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39626,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭敬叔 其八","author":"黎景义","text":"岁适届龙蛇，贤人起叹嗟。\n少微患云峤，子服谶星沙。\n造物何无尽，吾生却有涯。\n可怜徐淑女，肠断泣秦嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39627,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭敬叔 其九","author":"黎景义","text":"斯文歘已丧，天道信寥寥。\n骏骨知弥贵，虬枝讶早凋。\n崧高雯气冷，箕尾曙光遥。\n见尔英魂在，哀歌续大招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39628,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭敬叔 其十","author":"黎景义","text":"伯兄今半百，遥辱寄新吟。\n采织流霞绮，声敲掷地金。\n序仍鸿雁列，情倍脊令深。\n念此题蒿里，啼痕透楮阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39629,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭敬叔 其十一","author":"黎景义","text":"三十四青春，勋华远未臻。\n孝廉初北谒，京国转南沦。\n禹略堪兴汉，玄才可败秦。\n英雄今日泪，为尔益沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39630,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭敬叔 其十二","author":"黎景义","text":"神武风云际，明扬首见推。\n中兴方定国，大作正当时。\n漫化鸡如臂，空留豹是皮。\n不知行在所，何以慰宸思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39631,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭敬叔 其十三","author":"黎景义","text":"幼安辞寓舍，靖节命归轺。\n迹岂沦三国，时非落六朝。\n陶家原属午，汉地尚名辽。\n他日修纲目，吾将直笔标。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39632,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠黄心明丈","author":"黎景义","text":"牛医传令德，马队寄幽盟。\n世道虽然暗，君心独自明。\n蘋音飘弈远，桂影漾樽盈。\n一任双丸转，逍遥达此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39633,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"武韵酬剑客秋雨过宿","author":"黎景义","text":"连宵夜雨急，留客掩云扉。\n湿重垂黄菊，寒深入绛帏。\n潇潇游子赋，恋恋故人衣。\n幸有晶盘在，平原十日归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39634,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都粘三忠庙吊古 其一","author":"黎景义","text":"僻村清庙表忠灵，正气熊熊炳日星。\n素识姓名于旧史，歘瞻眉宇在新亭。\n寒风晚拂凄凉树，劲草秋标日月汀。\n祇谒曷胜悲往事，疾挥金管为书铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39635,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都粘三忠庙吊古 其二","author":"黎景义","text":"间关千里逐戈兵，断港行宫几战争。\n塞外雁来多愤激，江心鹇没共冤情。\n魂依粤水苍涛怒，血溅燕云碧玉成。\n更向都宁留烈绩，英豪吟啸聚沾缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39636,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都粘三忠庙吊古 其三","author":"黎景义","text":"回首中原叹陆沈，栖存澳岸避夷侵。\n南来纵少无双士，北去犹怀借一心。\n绕榭暮云传怨忾，涵山秋气动哀吟。\n牧儿樵妪何知识，亦把忠臣说至今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39637,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都粘三忠庙吊古 其四","author":"黎景义","text":"纵横干橹力勤王，存丧玄穹自主张。\n战马远来嗟屡北，飞龙新立泣旋亡。\n三分争鼎同诸葛，一旅兴基异少康。\n野草寒燐精爽在，暮秋山下月苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39638,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都粘三忠庙吊古 其五","author":"黎景义","text":"三闽四广不堪论，念及祥兴倍怆神。\n失鹿君王归海若，从龙妻子作波臣。\n乾坤抱憾峰岚黯，风雨含冤岭树颦。\n鼠臂虫肝谁得免，纲常扶植赖三人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39639,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都粘三忠庙吊古 其六","author":"黎景义","text":"舳舻破海已无功，泪洒慈元几夜风。\n故国山河汪浪里，新祠樽俎夕阳中。\n一生未雪程婴志，万死难灰祖逖衷。\n我亦临流愈慷慨，敢将成败论英雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39640,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都粘三忠庙吊古 其七","author":"黎景义","text":"红叶黄花峻岭阴，囚燕淹广恨犹深。\n化儿降祸金瓯缺，飓母扬威玉玺沈。\n太史编年多炳耀，骚人怀古漫登临。\n指南集杜那堪识，肃气萧萧透短襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39641,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都粘三忠庙吊古 其八","author":"黎景义","text":"成仁取义此心安，运去舟沉祚复难。\n大学数行酬赤扆，小楼三载误黄冠。\n川陵在在非胡地，坛宇年年祀宋官。\n山色自青波自绿，春霖秋旭粤天寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39642,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋望","author":"黎景义","text":"何处砧声向晓催，远峰斜照系高台。\n尘吹落叶归人急，影带飞霞过雁哀。\n脉脉小溪潮渐浅，离离幽径菊频开。\n登临不禁裁清赋，莫道今无宋玉才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39643,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"幽居书事三首 其一","author":"黎景义","text":"碧水池边便会心，清风林下每披襟。\n宜家喜究妻孥乐，在野羞裁婢仆吟。\n欠饵钓何非得意，无弦琴亦有知音。\n从来壮士真颜色，宁系床头一片金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39644,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"幽居书事三首 其二","author":"黎景义","text":"小閤檐铃弄响沉，短墙花树落英深。\n体胖岂向钱名癖，性洁何须水号淫。\n鄙矣卞侯投璞玉，贤哉韦相少籯金。\n前阶月冷帘风淡，忽悟箪瓢乐可寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39645,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"幽居书事三首 其三","author":"黎景义","text":"陋室安閒亦广居，魂清时化蝶蘧蘧。\n逐贫懒赋怜杨妄，乞巧无文笑柳疏。\n玩世曷辞呼是马，临流谁谓乐非鱼。\n所忻菽水遑将母，不学王孙致倚闾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39646,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水","author":"黎景义","text":"澄清惹咏濯缨歌，一望连天万顷波。\n披画有时浓藻墨，织绫随处度鱼梭。\n迎风海面银花烂，映月江心玉镜磨。\n流入七弦成雅操，钟期高悟叹江河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39647,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中山怀古 其一","author":"黎景义","text":"宜我亭依岚翠开，刘晨半载住天台。\n丁宁萋菲诗题壁，沉醉酴醾露满杯。\n树色山容犹在望，月情云意却成灰。\n梅花深坞知何处，落叶无心覆石台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39648,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中山怀古 其二","author":"黎景义","text":"传说花间有异芬，清飙吹我恍相闻。\n银床独坐看金液，青鸟遥飞隔白云。\n池柳染烟前锦带，山榴然火旧罗裙。\n可怜洞口吟仙字，岁岁薰风碧藓文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39649,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中山怀古 其三","author":"黎景义","text":"幽林如画石如屏，知是刘郎此寄情。\n二月蕙兰长寂寞，一天云鸟自纵横。\n雨迷巫峡词空赋，日落昆崙梦不成。\n谁信当年果相狎，祇今何往步虚声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39650,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒吟","author":"黎景义","text":"缓缓濡毫浅浅吟，半生消尽几升沈。\n妍媸总付人双眼，巧拙从摅我片心。\n所以醉馀还梦后，兼之昼永更宵深。\n纵愁横恨凭魔却，大笑无烦泪满襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39651,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"有感","author":"黎景义","text":"云蔽阳亏大宇霃，黄河萦转太行嵚。\n雨浓畴管蕙兰泣，风寂孰同桃李瘖。\n凿里固然难进枘，釜前无处不遗鬵。\n传闻琬琰声华贵，璞破咸惊质是琛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39652,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜","author":"黎景义","text":"阊阖吹秋到小楼，帘铃窗箔和飕飕。\n寒生石磴露容湿，香护花阴烟态游。\n烛秉绛光疑火杖，棋敲清韵当更筹。\n凭栏何事久忘寐，为爱蟾辉白欲流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39653,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自叹","author":"黎景义","text":"自叹明时却贱贫，勋华意气总流尘。\n鲍牙已死无知己，邓禹如生果笑人。\n鹤敛云阶千里翮，鲤潜湫屋万重鳞。\n盘根错节知何在，硎发年来器尚新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39654,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏夕漫兴 其一","author":"黎景义","text":"五月黄昏霁景鲜，墙蕉坳草自田田。\n云扉未动微凉入，椠枕闲亲暝色传。\n雨过沼深鱼不觉，烟浓花茹蝶先怜。\n南风拂袂挑诗兴，击节高吟和夏弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39655,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏夕漫兴 其二","author":"黎景义","text":"晚凉偏称北窗眠，火色那知满大千。\n翠石当櫩钦独立，白云推牖告初旋。\n歌来燕子欺箫鼓，舞歇荷花谢锦缠。\n更爱此君能脱俗，青筠孤影夕阳天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39656,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]