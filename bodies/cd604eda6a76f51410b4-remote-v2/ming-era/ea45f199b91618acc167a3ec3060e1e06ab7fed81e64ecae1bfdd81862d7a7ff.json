[{"title":"风雨","author":"陶安","text":"刚风吹海立，飞雨自天来。\n汹汹鲸鲵沸，萧萧鸿雁哀。\n行人淹道路，君子济云雷。\n进止从天意，知几不蹈灾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32423,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"倚柂","author":"陶安","text":"楼船雄帐纛，倚柂只遥看。\n壁上青蝇两，笼中白鹤单。\n同舟人别去，对月夜清寒。\n江面凄风起，悠然梦境安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32424,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"公子二首 其一","author":"陶安","text":"翩翩贵公子，年少美风姿。\n坐褥金钱豹，盘飧玉面狸。\n弯弓穿射的，骑马造宾墀。\n愿汝闻忠孝，光华在礼仪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32425,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"公子二首 其二","author":"陶安","text":"翩翩贵公子，新自塞垣归。\n雕翅珠玑帽，龙纹锦绣衣。\n花前牙板按，灯下羽觞飞。\n愿汝崇清素，农桑业尚稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32426,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"野人二首 其一","author":"陶安","text":"野人便土物，性懒入城中。\n水荇羊须白，山茶鹤顶红。\n开窑分贱炭，汲井截深筒。\n酒熟邀人饮，登盘芋栗丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32427,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"野人二首 其二","author":"陶安","text":"野人便土物，家计日经营。\n弋雁乾成腊，笼虾活煮羹。\n泥肥桑干密，雨湿菜芽生。\n今岁田禾熟，鸡豚养得成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32428,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"文士二首 其一","author":"陶安","text":"文士甘藜藿，林栖阅岁华。\n一衾春自足，千驷我何加。\n雨雪欺茅屋，乾坤任钓槎。\n今朝烟火晚，带露采松花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32429,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"文士二首 其二","author":"陶安","text":"文士经纶学，时来志或酬。\n玉堂清不夜，金鉴照千秋。\n白发忧民瘼，丹心为国谋。\n所期功业盛，富贵一浮沤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32430,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武昌城西观战","author":"陶安","text":"杀气黯沙场，呼声动女墙。\n官军皆虎奋，残寇尚鸱张。\n火镞飞孤垒，霜戈出万航。\n笑渠俄却走，垂灭更披猖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32431,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄示晟昱","author":"陶安","text":"兄弟年踰冠，儒门业贵精。\n别离春忽半，生理日须营。\n汝母遗清范，娇儿动语声。\n寸心思念切，不寐到天明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32432,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"二月十六日喜晟至武昌","author":"陶安","text":"偶傍船窗立，惊看雪袂来。\n羁怀三月久，欢气一时回。\n换米携盐策，延宾举酒杯。\n从知家信好，病释岸花开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32433,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"甲辰守黄州初至作","author":"陶安","text":"初入黄州市，萧然绿树村。\n刈茅低缚屋，剖竹密编门。\n桃李花零落，山川势吐吞。\n廛民来一二，敬喜为温存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32434,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三月五日晟别东归","author":"陶安","text":"客中离别苦，忍泪嘱言辞。\n背面南行处，临衢目送之。\n心随江水去，人与片云驰。\n归坐茅茨底，凄然老涕垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32435,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"久雨","author":"陶安","text":"十日久阴雨，今朝更沛然。\n尺泥深草径，三月似梅天。\n刳木承檐溜，舒瓢挹井泉。\n情怀殊不豁，寥寞对窗前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32436,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆二子晟昱","author":"陶安","text":"客窗风雨冷，唯有影随形。\n爱子别相远，老怀愁未醒。\n春残双鬓白，夜久一灯青。\n何日团栾处，欢情满户庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32437,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"苦雨二首 其一","author":"陶安","text":"皇天日日雨，何不悯吾农。\n冷逼青秧瘦，阴添绿树浓。\n晚来鸣两鹱，谁与遣顽龙。\n断送残春去，无心在酒钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32438,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"苦雨二首 其二","author":"陶安","text":"断桥春水隔，疏牖暮云昏。\n蔓草萦山郭，江涛涨海门。\n泥陈留鸟迹，壁湿乱苔痕。\n安得愁阴豁，晴晖满竹辕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32439,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"偶闲","author":"陶安","text":"古堞晴观涨，幽蹊缓踏莎。\n槐丝低挂蠖，桑茧自成蛾。\n吏散庭花落，朋稀野雀过。\n却思前数载，官事猬毛多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32440,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"立夏日纪事","author":"陶安","text":"近午生微暖，残云散积阴。\n朱明新节序，绿暗旧园林。\n幕佐论时政，山人献雅吟。\n南风来应候，解愠快民心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32441,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寓所","author":"陶安","text":"盖茅为寓所，郡治亦于兹。\n篱外獐窥吏，衣中蚁齧肥。\n昼长无讼牒，兴到有新诗。\n早食逢来使，斋厨米再炊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32442,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"穷民","author":"陶安","text":"叹息穷民苦，劳心岁不宁。\n家空遭横敛，罪薄陷淫刑。\n堡寨雄群甲，兵繇役两丁。\n我来新典郡，哀痛泪交零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32443,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"旅寄","author":"陶安","text":"旅寄存时义，居安意自如。\n风欺窗纸薄，雨透屋茅疏。\n盗息家无犬，宾来食有鱼。\n绿阴清昼永，爱读枕边书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32444,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊外","author":"陶安","text":"处处多栽竹，家家尽结茅。\n蜜房封蛹户，蜡树系虫包。\n瓮汲泉微浊，锄耕地颇硗。\n傍檐羞草具，无粟易山肴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32445,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"望家信不至","author":"陶安","text":"船去四十日，家无消息传。\n江头人不到，客旅眼徒穿。\n当暑衣无葛，愆期榻有毡。\n何当来土物，免使贷盐钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32446,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻立中书省命左右相国","author":"陶安","text":"相国经邦业，中书出治原。\n一堂文武并，百辟表仪尊。\n自顾微踪远，今符素志存。\n十年参侍久，喜极复何言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32447,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄董正则咨议","author":"陶安","text":"玉署清挥翰，彤扉老曳裾。\n怀人搔短发，来使寄长书。\n江树春弥望，山蟾夜共居。\n刚风吹弱水，不得侍云车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32448,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄罗复仁咨议","author":"陶安","text":"远怀罗閤老，爽气荡清旻。\n口伐摧邻垒，神交厚古人。\n囊悭道尊贵，笔老意清新。\n前席咨询处，遥知鲠论陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32449,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"述事","author":"陶安","text":"千村新雨过，水满绿苗生。\n蚕麦收成速，兵农赋役轻。\n纷纷挈家室，日日到州城。\n讼简有公暇，江山共此清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32450,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜泊兰溪","author":"陶安","text":"津吏临堤问，湖官隔水来。\n乘桴新竹贡，筑室旧民回。\n暮草蚊飞猛，秋云鸟唳哀。\n长星下天末，风露一襟开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32451,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过五郎矶","author":"陶安","text":"石壁银光烂，当冲似设关。\n云阴拂树走，山势隔江环。\n绝顶人稀上，飞藤鸟自闲。\n富池苍陇近，百摺枕江湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32452,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"盘塘","author":"陶安","text":"长峰飞骑突，势欲断沧江。\n路转仍无际，天高恣倚窗。\n洑流催捩柂，山港绝徒杠。\n樯上驯乌舞，迎人觅食双。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32453,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"彭泽怀古","author":"陶安","text":"昔贤才胜福，五斗亦难任。\n归饮柴桑酒，忘弹单父琴。\n羲皇上古意，晋室旧时心。\n我愧过彭泽，高风不敢寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32454,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过小孤山遇邹师颜即别","author":"陶安","text":"江妃新庙下，队伍耀弓刀。\n半载别离远，一官巡警劳。\n峰头挂星汉，关口吸云涛。\n见面即分手，舟行月满篙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32455,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"空庭","author":"陶安","text":"空庭人寂寂，环座竹猗猗。\n山净秋阴薄，林深晓色迟。\n案头蝇豹捷，壁窍鼠狼窥。\n处约还清致，湖菱杂饭炊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32456,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"迁客","author":"陶安","text":"迁客辞金马，吟情动草堂。\n公馀秋煮鳜，梦觉夜闻獐。\n静拄看山笏，清焚读易香。\n江湖踪迹远，何以报君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32457,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"遣兴三首 其一","author":"陶安","text":"斫竹藩新廨，锄茅辟古蹊。\n地偏松鼠过，树合竹鸡啼。\n信步来溪上，迟留到日西。\n移时忽得句，遣兴不拘题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32458,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"遣兴三首 其三","author":"陶安","text":"近时来井邑，远迹亦山林。\n每忆君赐食，尚期朋盍簪。\n遣文当述理，临政必清心。\n片语人皆信，无烦徙木金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32459,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖乡二首 其二","author":"陶安","text":"熟处人还聚，生涯日渐忙。\n洗鱼腌作鲊，切藕曝为粮。\n野纻栽临屋，家凫浴满塘。\n掩门儿女坐，灯下补衣裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32460,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西风","author":"陶安","text":"万树舞苍翠，西风终日来。\n一凉衣顿薄，何日客当回。\n候虫吟露切，秋鹗击云开。\n又复悲摇落，萧萧独上台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32461,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观大龙山","author":"陶安","text":"山势何所似，大龙飞入云。\n隔湖来艳翠，未晚隐斜曛。\n洞掩无兵火，林深亦斧斤。\n亭西烟雾豁，凝望意慇勤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32462,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀原夫","author":"陶安","text":"幕中曾对案，袖里秘藏书。\n出处情无异，清高我不如。\n入朝须插笔，进谏忆牵裾。\n江海苍须客，同时注起居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32463,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀仲圭二首 其一","author":"陶安","text":"天堑古为限，江淮今复同。\n国家当盛日，台閤已生风。\n独愧辞朱雀，无因望玉骢。\n却思薇省夜，共剪烛花红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32464,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀仲圭二首 其二","author":"陶安","text":"四方多取友，几载少知音。\n君子温如玉，同心利断金。\n空中难寄字，客里易沾襟。\n相会何时再，堪嗟老境侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32465,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀友","author":"陶安","text":"分携未一年，美秩已三迁。\n执笔螭头立，当廷鲠论宣。\n近因留远地，独肯寄长笺。\n五色云霄上，光分宝炬莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32466,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆昱","author":"陶安","text":"渺予成久别，闻汝理生涯。\n初夏出为旅，深秋未到家。\n江风低宿雁，晚日闪归鸦。\n舐犊情逾切，令人鬓已华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32467,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"遣兴","author":"陶安","text":"门前苍嶂列，身在白云栖。\n有地学为圃，无邻可乞醯。\n江天孤影鹤，山月五更鸡。\n自料殷员外，惭非宓不齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32468,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋祀三皇","author":"陶安","text":"蒇祠当九日，大道仰三坟。\n废邑姑存礼，皇风不在文。\n晓江生白气，秋岭湿玄云。\n茅茨土阶净，旭日照清熏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32469,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"人生二首 其二","author":"陶安","text":"人生无百岁，功业必乾乾。\n此志不忧国，何颜可见天。\n远居山邑静，如对玉阶前。\n寄语秦淮柳，还能记着鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32470,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蟆蚓","author":"陶安","text":"季秋蛰虫俯，蟆蚓尚争鸣。\n肃杀无多冷，喧啾过五更。\n幽窗常聒梦，微物各舒情。\n节候虽成晏，天心特好生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32471,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蟋蟀","author":"陶安","text":"蟋蟀傍吾语，秋寒声更圆。\n萧萧风露下，切切客窗前。\n催得鸣机织，惊回警枕眠。\n扬须频吐气，无乃甚便便。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32472,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九月蜂蝶","author":"陶安","text":"寂寞秋风老，纷纭蜂蝶飞。\n年年花落后，队队日相违。\n玉翅穿枫叶，黄须点客衣。\n山中随意好，何必逐芳菲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32473,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雾","author":"陶安","text":"阴阴似尘起，曙色忽成昏。\n绿树杳无迹，青山不在门。\n着人衣渐湿，蔽野豹深蹲。\n还喜清飙发，天开放晓暾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32474,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚风","author":"陶安","text":"暮秋连日热，向晚大风寒。\n变态如翻手，衰容怯倚栏。\n降霜中气应，吹月上云端。\n木叶萧萧脱，凄声接夜阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32475,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋雨","author":"陶安","text":"秋雨黯弥昼，暑寒相代时。\n南方谢絺绤，急吹透茅茨。\n万舞庭前树，劬劳野外师。\n园蔬承润泽，新绿动离离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32476,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"遣怀","author":"陶安","text":"十朝八九病，一世万千忙。\n未获康宁福，犹驰汗漫场。\n延龄爱芝术，游宦忆耕桑。\n习静心无扰，馀生乐未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32477,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"复雨","author":"陶安","text":"彻夜雨声急，当门溪涨高。\n枯蝇抱野蔓，寒雀起林蒿。\n泥溅新油履，风欺旧缊袍。\n邑民应笑我，官况太萧骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32478,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"昱至枞阳喜而有赋","author":"陶安","text":"宇宙身如寄，星霜岁易周。\n客乡惊见面，父子共忘忧。\n话里知亲旧，灯前问进修。\n若兄能守舍，此处暂堪留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32479,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄示晟二首 其一","author":"陶安","text":"汝弟来传说，朝仪熟见闻。\n克家严志操，事主致恭勤。\n骑射新从武，优闲更学文。\n令余沈痼释，觉此老怀欣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32480,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄示晟二首 其二","author":"陶安","text":"今年二十四，稼穑识艰难。\n处约精神瘦，居安意思宽。\n星辰天上拱，松柏雪中看。\n贫富能无累，持身始可观。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32481,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十月七日舟发枞阳","author":"陶安","text":"巡官率兵卫，父老拜溪亭。\n过鸟云间白，高天雨后青。\n两篙撑雪浪，几曲转沙汀。\n芦苇风摇荡，寒声枕上听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32482,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过山家","author":"陶安","text":"步迹随深径，春声接近村。\n鱼膏灯挂壁，栗炭火当门。\n燕去留空垒，鸡栖隔密藩。\n朔风鸣夜永，矮屋自春温。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32483,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚至白兔河","author":"陶安","text":"风雨日来数，夕阳晴色初。\n聊登沙岸步，忽到野人居。\n白兔何年出，黄花夹路舒。\n喜闻邮舍报，附至玉堂书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32484,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登陆往桐城县","author":"陶安","text":"经岁不骑马，借驴因断河。\n里行三十五，冈度几重多。\n野菊香浇袂，霜松翠压坡。\n晡时临县郭，山色动春和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32485,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"至桐城县","author":"陶安","text":"阃使留三日，慇勤待我来。\n骄骢数里迓，大帅尺书裁。\n金谷生芳草，昆明有劫灰。\n市民虽未集，官道且重开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32486,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"桐城即事","author":"陶安","text":"东郭涧声急，西藩山势高。\n井泥淘白骨，础石铲黄蒿。\n新廨林獐过，虚廛野雉号。\n从兹远兵难，庶可息民劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32487,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"灯花","author":"陶安","text":"卷然铁如意，红粟结葳蕤。\n十瓣团葩出，孤根密缕垂。\n寒风吹不动，光燄照书帷。\n黄昏至夜半，有喜报人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32488,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"甲辰仲冬望日","author":"陶安","text":"忆自秦淮别，今朝恰一年。\n山川诗画里，天地客窗前。\n节物惊心换，行藏顾影怜。\n屋东寒涧月，又见一番圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32489,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬至","author":"陶安","text":"天统书周朔，云祥纪鲁台。\n阳来第一日，山下发孤梅。\n与客尝杯醑，无人候管灰。\n南窗晴色丽，斋戒卷还开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32490,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"官廨北涧偶步","author":"陶安","text":"碧涧依山麓，苍松挂野藤。\n泉清见鱼泳，磴绝少人登。\n龙井苔封甃，凫田草没塍。\n旧时丰邑屋，废址接丘陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32491,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"腊月六日雪","author":"陶安","text":"腊天初见雪，日午已开晴。\n微暖空檐滴，馀英老木擎。\n荒城无酒卖，疏牖照人明。\n风自西南起，遥知送客程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32492,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"昱至桐城二日别去","author":"陶安","text":"儿曹各西溯，吾亦欲东归。\n陆走百馀里，一见复相违。\n雪晴沙路软，天阔雁鸿飞。\n新年望还舍，柳下浣征衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32493,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"归涂纪事","author":"陶安","text":"雨收遵水浒，卫卒拥归鞍。\n滩浅轻舠滞，泥新步屧难。\n诸峰云树净，百鹭雪翎乾。\n东渡留宣湛，相逢故旧欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32494,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]