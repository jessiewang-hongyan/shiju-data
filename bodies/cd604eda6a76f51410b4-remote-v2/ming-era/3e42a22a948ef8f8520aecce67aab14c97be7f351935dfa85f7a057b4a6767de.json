[{"title":"吴淞晚行","author":"李时行","text":"驿路晚悠悠，行人促去舟。\n乡心悬落雁，客梦入新秋。\n泽气蒸云起，江声带雨流。\n松陵看欲近，沽酒慰离忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9185,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游灵隐寺","author":"李时行","text":"清梵落诸天，香台覆紫烟。\n飞萝悬曲径，乱石漱寒泉。\n象座金莲古，龙潭宝月圆。\n三生缘已解，随地可栖禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9186,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金陵别施平叔秋官","author":"李时行","text":"知己难为别，相携白下门。\n斜阳江上树，野水驿边村。\n旧业归心在，清时直道存。\n凄凄霜月夜，尊酒共谁论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9187,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"明妃曲","author":"李时行","text":"一自辞金屋，谁怜度玉门。\n沾衣今日泪，奉帚旧时恩。\n见月空凝思，闻笳欲断魂。\n早遂安边愿，妾身宁足论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9188,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访康荡山人","author":"李时行","text":"结屋翠微间，蓬门昼不关。\n宿云长在树，倦鸟自归山。\n境为虚偏胜，心于静始閒。\n逍遥弄泉石，尽日竟忘还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9189,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诸社丈摧携酒过访","author":"李时行","text":"词流多逸兴，命酌过山堂。\n野水秋踰净，林花寒更香。\n共知閒里适，宁记醉中狂。\n万事浮云外，当歌且尽觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9190,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观天目山瀑布","author":"李时行","text":"谁将千尺练，挂向碧峰头。\n晴洒长空雨，寒生六月秋。\n褰风银浪涌，闪日雪花浮。\n不作涓涓滴，阴崖祇暗流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9191,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜宿殊胜寺","author":"李时行","text":"看竹过山寺，开樽值素秋。\n风清众籁寂，水落寒岩幽。\n僧定月当户，鹤归云满楼。\n醉来卧松石，天地等浮沤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9192,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜宿海珠寺","author":"李时行","text":"岛屿中流出，凭空结蜃楼。\n浪翻沙际月，枫落海门秋。\n照水禅灯寂，栖云秖树幽。\n坐看神女见，清夜弄珠游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9193,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓行","author":"李时行","text":"客行宁畏早，残夜度关城。\n野店月犹在，孤村鸡未鸣。\n烟深疑路失，寒重觉裘轻。\n去去明河没，东方白渐生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9194,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游钱塘紫阳宫","author":"李时行","text":"桂宇开三岛，兰宫列九仙。\n云霞尘外境，日月洞中天。\n寒溜披澄练，晴峰拥碧莲。\n涧虹朝散绮，松吹夜鸣弦。\n药圃芝凝露，丹田玉吐烟。\n函关牛度日，华表鹤归年。\n未授黄庭诀，先参紫气篇。\n杯将金液泛，鼎以宝香燃。\n身陟凡区表，心游太古先。\n静探玄妙理，兹意境谁传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9195,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张职方赴边","author":"李时行","text":"凤诏衔新命，鱼书急使旌。\n黄云浮杀气，白草动笳声。\n仗剑交河冷，登车易水清。\n朔风羌节惨，积雪絮裘轻。\n金勒装骍马，雕弓列战▆。\n祈连涵落日，瀚海接边城。\n却狄纡周策，和戎陋汉盟。\n摛文频握椠，学武喜谈兵。\n省署推贤俊，华夷仰圣明。\n麒麟储骏烈，虚席待公卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9196,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛彭蠡湖","author":"李时行","text":"浩荡湖光迥，虚涵河汉明。\n万峰朝霭净，一苇客帆轻。\n地跨三吴胜，江连七泽平。\n鱼龙时隐见，舟楫互纵横。\n日月浮金晕，风波激玉声。\n方壶晴掩映，圆峤远峥嵘。\n阳鸟寒依渚，残虹夕抱城。\n感时思击楫，俯念愧登瀛。\n塞北犹防□，江东未解兵。\n艰危堪涕泪，回首忆神京。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9197,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日游道场山伏虎寺酬信上人","author":"李时行","text":"伏虎何年寺，閒来偶一登。\n乍随攲径入，还向曲栏凭。\n山晚烟光澹，天寒水气澄。\n斜阳双去鸟，野渡一归僧。\n驯鸽栖祇树，清猿啸古藤。\n飞楼风外笛，孤塔月中灯。\n已悟西来意，因参最上乘。\n欣陪支遁语，聊此涤尘膺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9198,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日陈光禄见过","author":"李时行","text":"冠盖何年别，轩车此日来。\n故人千里合，绿野一尊开。\n鸟弄当歌席，花明近酒杯。\n激昂看侠气，磊落见雄才。\n越峤题应遍，衡阳辙屡回。\n高情出云汉，逸想绝氛埃。\n户牖临青嶂，琴书傍绿苔。\n子云元寂寞，仲蔚自蒿莱。\n僻地纡玄览，深怀寓薄醅。\n相看当尽醉，莫遣二毛催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9199,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游三洲岩","author":"李时行","text":"灵源标胜概，碧洞秘瑶华。\n旷野千峰出，横桥一水斜。\n松萝迷客径，鸡犬隔人家。\n石室云常暗，山楼树半遮。\n岩巅垂玉乳，泉际引金沙。\n仙乐和啼鸟，天香散落花。\n开樽留晚照，挥袂驻飞霞。\n延眺娱心赏，追游兴未涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9200,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬徐伯臣见寄","author":"李时行","text":"孺子南州彦，新诗海内传。\n因风奏金石，使我挹兰荃。\n鸾啸苏门隐，凫飞汉代仙。\n襟期同白社，人物似斜川。\n登陟卢敖杖，浮游范蠡船。\n閒居知有赋，习静久怀玄。\n绿绮烟霞外，青山几席边。\n黄初窥制作，墨绶谢尘缘。\n草圣誇前代，萍踪忆往年。\n关河看咫尺，吴粤隔风烟。\n服气神符妙，修真宝诀全。\n悬知千载后，石室秘瑶篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9201,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山庄月夜","author":"李时行","text":"别墅少尘踪，清溪澹晚容。\n千峰霜月白，万树野烟浓。\n碧汉回孤鹜，空林鸣暗蛩。\n山钟秋更彻，云碓夜仍舂。\n涧底泉声细，窗前竹影重。\n幽栖聊短榻，散步任疏筇。\n雅致思玄度，风流羡戴颙。\n悠然忘坐久，寒露滴青松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9202,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠陈道吾","author":"李时行","text":"彼美清修士，幽居屏俗喧。\n藏名栖白社，托迹寄青门。\n湖海情偏切，风云思独存。\n玄谈珠洒落，丽藻凤飞翻。\n案上书千卷，床头酒一尊。\n虚窗鸣翠筱，曲径长荒荪。\n王粲才何逸，袁安道自尊。\n四愁今已赋，七启更须论。\n污血终难困，龙光岂受昏。\n天衢去不远，杼翼任高鶱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9203,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游云居寺","author":"李时行","text":"地偏开胜迹，俗远惬幽寻。\n路接三台近，山罗万象深。\n香台笼古树，碧涧绕危岑。\n草露当阶绿，萝烟覆径阴。\n天花寒拂座，法雨细沾襟。\n净界疑南岳，毫光俨道林。\n竹泉澄累劫，松石长禅心。\n云盖珠幡影，风飘玉磬音。\n物情翻爽豁，客思纵登临。\n浮世多消歇，空门无古今。\n三生如可学，于此合抽簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9204,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉和李奉常天坛候驾即事","author":"李时行","text":"紫垣烟柳昼阴阴，花满仙坛春正深。\n风外时闻琼佩响，云端遥望翠华临。\n龙盘瑞气开行殿，莺啭清歌出上林。\n江海微臣亦何幸，叨陪鸳鹭列朝簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9205,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日寄直阁林员外","author":"李时行","text":"仙郎散佩侍彤闱，候吏焚香护赐衣。\n亲捧紫泥传禁语，时登青琐沐恩辉。\n飘花细傍宫墙出，乳燕斜穿御路飞。\n退食省中无一事，晚来信马柳边归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9206,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石亭馆与友人夜坐","author":"李时行","text":"客里逢君属暮秋，别情归思共悠悠。\n灯前细雨催黄叶，海内知心半白头。\n露气暗浮冰簟冷，蛩声偏助草堂幽。\n欲期后会应难定，且对青尊一暂留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9207,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆昔八首 其一","author":"李时行","text":"一别蒿莱奉紫宸，金门通籍宠光新。\n清宵曳履趋仙阙，薄暮鸣珂出禁闉。\n万户笙歌连落日，五陵车马动飞尘。\n江湖此际瞻依切，清梦犹驰汉苑春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9208,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆昔八首 其二","author":"李时行","text":"秣陵佳丽艳流霞，晋苑吴宫昔所誇。\n北固青山雄帝宅，长江一水渺仙槎。\n荒墩已没江淹梦，古巷犹传谢傅家。\n唯有青楼烟柳地，年年歌舞竞繁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9209,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆昔八首 其三","author":"李时行","text":"夹谷陶山汶水西，泰宁形胜几扳跻。\n东临日观三峰近，南望天门五岳低。\n太白楼荒销侠气，右军池古剥留题。\n江湖十载曾游地，乘兴何时还杖藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9210,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆昔八首 其四","author":"李时行","text":"甘泉猎火接天齐，塞路天寒雨雪迷。\n李广封侯惭射虎，刘琨报主忆闻鸡。\n关河杀气催杨柳，沙漠烽烟困马蹄。\n为报嫖姚宽北顾，元功先遣拜琼圭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9211,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆昔八首 其五","author":"李时行","text":"忆昔吴门秋可怜，澹烟疏柳夕阳天。\n青山易得芳时乐，白雪难逢寡和篇。\n茂苑旧游孤月外，横塘新曲晚风前。\n祇今卧病云山隔，野水芦花一钓船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9212,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆昔八首 其六","author":"李时行","text":"兵戈满地壮心惊，极目中原感慨生。\n西北转输嗟络绎，东南寇盗苦纵横。\n单车多垒谁堪使，百税穷檐愿息征。\n日暮凭轩增涕泪，江湖空抱贾生情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9213,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆昔八首 其七","author":"李时行","text":"水落天空溽气收，微茫烟渚隔沙邱。\n寒催砧杵千家月，霜到关河几树秋。\n声断塞云闻雁过，光侵池草见萤流。\n感时王粲心徒切，独倚荆南万里楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9214,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆昔八首 其八","author":"李时行","text":"云萝露草径西东，尘世幽缘不易逢。\n招隐尚怜丛桂在，问奇谁负酒杯空。\n青山日暮云随杖，碧海秋清月满篷。\n一自烟霞拌懒散，弋人宁复慕飞鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9215,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新秋感怀","author":"李时行","text":"酒罢高歌清夜阑，年来犹自滞长安。\n片云将雨消残暑，断雁迎风动早寒。\n乡国渺茫劳梦远，江湖飘泊识交难。\n欲归未定缘何事，短铗无心向客弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠陆郎中归隐林屋","author":"李时行","text":"石林幽胜远人群，清隐于今独有君。\n暑去未消岩下雪，风来犹带涧边云。\n半窗月色留僧话，一径松阴共鹤分。\n遥想北山著书处，他年应不愧移文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9217,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西苑即事","author":"李时行","text":"沉沉昼漏不闻喧，缓步听莺出禁垣。\n风送飞花来上苑，烟含细草绕长门。\n日边凤阙攒云气，柳外龙池积雨痕。\n满路金貂宾从过，共传许史近承恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9218,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明日思家","author":"李时行","text":"紫陌新烟出汉宫，柔桑遍绿杏枝红。\n楼台半落梨花雨，帘幕斜吹燕子风。\n物候渐随时思改，酒杯犹喜故人同。\n朝来亦有还家梦，无那莺声到枕中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9219,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题蕉邱王逸人隐居","author":"李时行","text":"买断蕉邱事药栏，临窗静对竹千竿。\n床头绿酒应长满，屋外青山空自看。\n涧水流云时作雨，林花带露暗生寒。\n柴门寂寂逢迎少，隐几焚香懒著冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9220,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"巫山云","author":"李时行","text":"十二峰头映晚晖，非烟非雾转霏微。\n因风吹入襄王梦，带雨乱飘神女衣。\n野树影中寒不散，啼猿声里湿还飞。\n不知秋去天如洗，万里悠悠何处归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9221,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬陈鸣野见寄","author":"李时行","text":"千里劳君问索居，江空岁晚独愁予。\n祇缘岭外无来雁，莫道天涯少寄书。\n草径秋深吟蟋蟀，石池霜冷落芙蕖。\n关河迢递风尘隔，两地同看月色虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9222,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钱塘经宋故宫","author":"李时行","text":"瓦砾重重半草莱，前朝宫阙总浮埃。\n已无辇路鸣珂入，空有春风燕子来。\n阴砌覆烟眠断柳，残碑含雨长荒苔。\n江山不管兴亡恨，依旧寒潮自往回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9223,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客中逢暮春","author":"李时行","text":"江上春归客未归，一春多恨赏心违。\n破巢新燕穿帘去，带雨桃花逐絮飞。\n薄酒易醒孤枕梦，长途犹著别家衣。\n风尘冉冉年华改，肠断江湖消息稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9224,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴国博还金陵","author":"李时行","text":"楼头霜落角声残，晓度关城匹马寒。\n岁晚交游知己少，天涯烽火别君难。\n冯驩何用空弹铗，梅福惟应早挂冠。\n归去蒋陵寻旧隐，著书宁复下长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9225,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送徐子明书记赴边","author":"李时行","text":"赤塞尘沙迥未平，多君意气喜论兵。\n已经楚上三年别，还作云中万里行。\n霁雪射雕青海岸，秋风走马白狼城。\n即随骠骑承恩泽，犹胜芸窗老此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9226,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春草","author":"李时行","text":"摇动轻烟展翠茵，萋萋长是傍幽人。\n沿阶遍杂莓苔色，近水不沾车马尘。\n浓绿映花南浦晚，柔香带雨曲江春。\n无端一夜相思发，几处池塘入梦频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9227,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋夜对月怀吴之仲","author":"李时行","text":"玉笛凄清隔院闻，枫林霜叶落纷纷。\n人间月色此时好，天上秋期今夜分。\n几处远山凝暮霭，一声孤雁起寒云。\n相思迢递天南北，坐对清光长忆君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9228,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓山吊古三首 其一","author":"李时行","text":"风吹锦舰覆江滨，回首神京半已尘。\n苏武岂能臣羯□，仲连宁肯帝嬴秦。\n天边星陨妖先见，海上龙兴谶未真。\n父老祇今犹抱恨，每逢寒食荐芳蘋。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9229,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓山吊古三首 其二","author":"李时行","text":"中原战血洒晴烟，末祚逢厓事可怜。\n祸胜六宫南渡日，仇深二帝北归年。\n奸谀误国情堪愤，闽广图安势已偏。\n千古忠魂消不得，怒涛长咽海门天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9230,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓山吊古三首 其三","author":"李时行","text":"野树云垂古庙阴，愁翻白浪众山沉。\n捐身万里孤臣泪，誓死三军恋主心。\n日照乾坤馀正气，寒生风雨助哀吟。\n茫茫沧海深如许，不似行人恨更深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9231,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠丁戊山人还闽中","author":"李时行","text":"海内名山已遍游，西风归卧幔亭秋。\n有时见月频呼酒，尽日看云独倚楼。\n采药不辞松径远，题诗偏爱石岩幽。\n拂衣我欲从君去，九曲溪边泛钓舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9232,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晋兴道中","author":"李时行","text":"水接湘江深复深，楚山迢递映枫林。\n四时不断烟岚色，两岸唯闻猿鸟音。\n帝子庙荒霜竹冷，伏波台古暮潮侵。\n苍梧回首浮云渺，明月清砧动客心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9233,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游南屏寺忆孙太初","author":"李时行","text":"太白山人竟不回，风流争羡谪仙才。\n云游五岳还词赋，豹隐三吴自草莱。\n习静著书常闭户，狂歌散发独登台。\n鸾骖一去无消息，花满西湖空自开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡杨子江","author":"李时行","text":"千里扬帆破浪游，长江浩浩漭生秋。\n城头树没青山小，天际涛翻白雪流。\n吴楚地形分北固，乾坤王气自中州。\n晴空入望风烟迥，万顷波光日月浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日寄怀异上人","author":"李时行","text":"忆昔曾同慧远游，东林几度漫淹留。\n鹤翻露滴松房冷，鹿过苔深竹院幽。\n卓锡白云生涧底，步虚明月上峰头。\n却从一别清宵话，已悟三生总是浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乱后书怀","author":"李时行","text":"频年烽火遍郊墟，到处逢人问卜居。\n荒后田庐浑是累，乱来亲友渐相疏。\n销忧独忆中山酒，闭户惟看邺架书。\n径草潇潇秋雨外，文园空自卧相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日同姚子玉费子文游云居寺","author":"李时行","text":"苍烟白石满空山，野寺深藏乱竹间。\n游客漫随清磬入，老僧长对落花閒。\n潭边宿雨从龙去，树底残云伴鹤还。\n尽日临流恣幽赏，披襟坐遍石苔斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9238,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日吴山游宴","author":"李时行","text":"千载吴宫已劫灰，吴山依旧客重来。\n子胥台迥空明月，范蠡湖堙长绿苔。\n往事但随流水去，春风又见野花开。\n登临一笑忘今古，莫负歌前酩酊杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9239,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小浮邱閒居","author":"李时行","text":"门巷春深昼不关，阶前蜗迹杂苔斑。\n邻沽任可长留客，市隐何须更买山。\n有兴独寻芳草去，无机惟爱白云閒。\n坐临磐石看流水，日暮空随倦鸟还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9240,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十八夜对月别友人","author":"李时行","text":"出饯河梁月上时，半轮清影泛金卮。\n由来天上多圆缺，何况人间无别离。\n夜静鱼龙浮远水，露寒乌鹊聚高枝。\n空山岁晚还相忆，惟有梅花寄所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9241,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠上高叶广文","author":"李时行","text":"怜君十载论文地，岳麓匡山共结邻。\n官树鸟啼飞絮雨，讲坛烟锁落花春。\n诸生重道元推鲁，博士专经共羡秦。\n独坐寒毡对清昼，身閒且莫厌官贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9242,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月下送客归湓浦","author":"李时行","text":"蒹葭洲上月如霜，楚客归心益渺茫。\n湖海十年交谊重，关山万里别愁长。\n碧梧半落秋将杪，银汉西流夜未央。\n莫惜音书寄来雁，湓城咫尺是衡阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9243,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居吟","author":"李时行","text":"草作岩居云作扉，耽幽简出澹忘归。\n村童解煮白石饭，野老自制青荷衣。\n得食山鸡去复返，近人仙鹤鸣还飞。\n有时独坐对花落，醉击瓿甊歌采薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9244,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登宣武城楼时有北□之报","author":"李时行","text":"呜呜画角语城头，四野风烟动客愁。\n露下星河双阙曙，月中砧杵万家秋。\n上书自愧冯唐老，去国空怀贾谊忧。\n赖有北门诸将在，早将戈甲护神州。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9245,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]