[{"title":"秋日与梁公实过黎氏山房次韵 其一","author":"陈绍文","text":"梧桐覆金井，一叶下西风。\n不忍听鸿雁，秋声万壑中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8684,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日与梁公实过黎氏山房次韵 其二","author":"陈绍文","text":"久不陟岩扃，秋光宛如昨。\n白云满地流，忽听松子落。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8685,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏钓舟答黄太史休沐","author":"陈绍文","text":"风动轻纶月照蓑，醉翻渔唱答樵歌。\n晓来独倚孤篷看，湖上奇峰雪后多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8686,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赏菊送陈肖溪北行","author":"陈绍文","text":"解舞腰肢列万行，风前摇曳紫罗裳。\n何当解赠朝天去，散作君王满殿香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8687,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡中曲 其一","author":"陈绍文","text":"白地狂风倒峡吹，奔涛折木影交驰。\n飘零一夜孤舟客，不听猿声亦泪垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8688,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡中曲 其二","author":"陈绍文","text":"枫叶萧萧峡气寒，渔舟多在洑流安。\n酒醒向月吹芦笛，惊起鸬鹚过别滩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8689,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠栖霞山人歌","author":"陈绍文","text":"君不见黄河急绕昆仑逝，蓦地空腾赤水气。\n白日欲出蒸成霞，万里山川尽明霁。\n又不见圆峤乃在渤澥中，鲸鲵喷激凌苍穹。\n春晴转变霞细丽，片片照耀金银宫。\n中有仙人识天趣，一生好入飞霞住。\n卧处光从蕙帐含，饮时滟向莲觞注。\n成绮能吟谢客诗，舒丹解作公孙赋。\n合散终然无定踪，世人安得知其故。\n无乃天孙发巧思，织成五色光陆离。\n越江愁杀浣纱女，蜀峡惊回濯锦姬。\n紫殿珠帏穿彩凤，华楼藻井蟠青螭。\n始觉化机妙如此，顷刻万象何参差。\n仙人本自非凡质，岁久餐霞成痼疾。\n胸中万丈吐虹蜺，倚马文章皆俊逸。\n金帔缥缈乘风轻，朝游碧落暮赤城。\n回首滚滚黄尘客，何以超然出世情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8690,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宛转歌 其一","author":"陈绍文","text":"月斜侵，钩帘鸣玉琴。\n金杯送曲移兰楫，山情水意何幽深。\n歌宛转，宛转欢未足。\n愿为雁与凫，秋浦永同宿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8691,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宛转歌 其二","author":"陈绍文","text":"晓将暾，银河澹没痕。\n金凤翠鬟乍分拆，缕祷香玉谁为温。\n歌宛转，宛转伤别离。\n愿为觿与䚢，进退恒相随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8692,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东飞伯劳歌","author":"陈绍文","text":"寒乌夜啼雉朝飞，洛娥巫妾乍相依。\n谁家倾城出朱户，摇珰曳带香风度。\n珠缀琼窗碧雾浓，缃帷绮帐隐芙蓉。\n女儿年几十六七，艳舞娇歌映春日。\n花枝欲动彩云飘，空留可怜待谁招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8693,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游罗浮阻风宿大唐田家 其一","author":"陈绍文","text":"罗浮渺何处，风雨暮萧萧。\n暂阻仙人约，来亲田父邀。\n山云低度屋，江水曲通桥。\n梦觉朱明路，双凫兴欲飘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8694,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游罗浮阻风宿大唐田家 其二","author":"陈绍文","text":"舍舟投草屋，质朴有唐风。\n禾黍寒原外，牛羊深巷中。\n提壶孤市远，更烛几宵同。\n明逐黄龙去，仙源不可穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8695,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛金川忆吴而待","author":"陈绍文","text":"挂席紫枫前，寒江清可怜。\n归樵遗野烧，贩客逐墟烟。\n山笋迎霜出，沙凫背日眠。\n美人棹歌远，谁与续残篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8696,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日游太泉得流字","author":"陈绍文","text":"早春风日弄轻柔，野服从师作胜游。\n到郭龙冈松十里，入河虹涧水双流。\n洞封玉检烟霞古，台隐金书日月幽。\n尧韭禹粮俱可掇，结茅期遂此生谋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8697,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁公实黎惟敬过心远亭探梅得风字","author":"陈绍文","text":"西墅寻梅路几重，朅来诗兴满幽丛。\n水边斜挂窥尊月，帘外轻飘断角风。\n雪羽仙人游玉苑，冰肌神女步珠宫。\n分明一片春消息，祇在孤烟峭石中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8698,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送客泛珠江宿凭虚阁听潮分得洲字","author":"陈绍文","text":"江亭青簟月华流，永夜潮生水国秋。\n万马急追风碛战，六鳌初戴雪山游。\n归渔暂失残荷浦，落雁应迷乱荻洲。\n料得此时天际客，不胜离思满扁舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8699,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"安南凯歌 其一","author":"陈绍文","text":"戟矛千里战危艘，鲸立蛟豗海若愁。\n须臾一闪东风炬，顿觉黄麾据上流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8700,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"安南凯歌 其二","author":"陈绍文","text":"占断山川列阵形，龙鳞凤翼应天星。\n翻嫌战染诸羌血，欲挽银河洗甲兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8701,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟虞世南直弘文馆贻诸同志","author":"陈绍文","text":"郁郁万年枝，兰台接紫墀。\n禁城连睥睨，御殿绕罘罳。\n列署星辰丽，三阶雨露垂。\n藜从太乙照，石是五丁移。\n要秩丝纶托，荣名翰墨司。\n沦书汲冢出，绝简羽陵披。\n签轴方盈阁，缃绨更累辎。\n芸薰深落蠹，铅椠细分疑。\n史法宗班马，经情绎孔姬。\n璇题霞薄采，金掌露华兹。\n初旭笼鸡树，微飔捲凤池。\n仙瀛叨并陟，艺苑喜同驰。\n玉笋神趋早，金莲夜赐迟。\n承麻宣帝泽，侍幄启宸思。\n已近圭璋挹，终知玄素睽。\n击蒙如有赖，庶仰罄吾私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8702,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游小金山 其一","author":"吴旦","text":"碧水流无极，苍山望不穷。\n宝花飘象驾，珠树绕龙宫。\n二梵何年续，三车此地雄。\n心猿坐来刊，知在惠门中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8703,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游小金山 其二","author":"吴旦","text":"返照到兰舲，龙宫喜暂停。\n竹边山气紫，蘋外水烟青。\n乍逆喧林鸟，低飞出草萤。\n高斋夜无寐，听诵法华经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8704,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山飞来寺","author":"吴旦","text":"招提幽绝处，千壑捧珠宫。\n山势悬疑坠，川流曲似穷。\n黄钟仙管寂，碧玉怪环空。\n忍草栖灵雾，昙花落慧风。\n灶残坭尚湿，丹化井犹通。\n夙昔登临地，题诗忆远公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8705,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曹溪观荡水石还遇沧师邀酌","author":"吴旦","text":"山路少蹊径，行吟随所之。\n偶然閒坐处，便是会心时。\n石坠分泉口，云过桂树枝。\n野僧邀共酌，不觉忘还期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8706,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿南华","author":"吴旦","text":"满天凉露净微飔，向夜疏帘手自披。\n明月故人千里共，白云禅室九秋期。\n斋钟乍断啼猿续，塔火初燃落雁知。\n一与远公谈谛义，欲投莲社恋真师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8707,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉峡夜泊闻歌吹声","author":"吴旦","text":"江潭日欲上，汀洲露未重。\n赵女歌正扬，越客魂先动。\n玉柱应离鸾，瑶笙学调凤。\n窈窕子夜声，悽恻江南弄。\n繁音逐水流，哀响因风送。\n曲罢夜苍苍，踟躇人如梦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8708,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登虎头岩","author":"吴旦","text":"日观擅东岱，朱陵揭南霍。\n惟兹襄二美，嵼然拔穷壑。\n龙惊矫以龈，鸟骇翔而矍。\n云阵中合离，水军乍前却。\n碨如树怀瘿，駮若笋摧箨。\n干云两耽耽，烛坤双腭腭。\n誇秦伟崤函，论蜀雄剑阁。\n履险令志疑，乘危俾魂愕。\n窥谷转层深，眺野增辽廓。\n神庭富椷滕，仙府多扃钥。\n清泥代不枯，石髓春踰烁。\n愿言寄考槃，孤高撷灵药。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8709,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月溪","author":"吴旦","text":"玉洞藑无门，珠帘不可捲。\n梯峰陟穷渎，刬石臻遥岘。\n蹊参灌木入，行并修篁转。\n禅界稍歇堙，灵泉犹清浅。\n花凋龙女台，草积象王辇。\n二梵行当已，三车谁能演。\n籍草停旷踪，抚柏豁英眄。\n翠函岫类滴，云抹林疑剪。\n感运心所怀，浩歌兴粗遣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8710,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无人","author":"吴旦","text":"朔月无弦杀气多，胡儿策马如掷梭。\n朝射双狼暮射虎，弯弧百万窥黄河。\n李陵战没二师走，一夜关门惊失守。\n临洮坚壁待天兵，将军十道出长平。\n觲弓羽箭照天地，联翻转战不留行。\n麾下晓遮当户骑，先锋夜拨骨都营。\n蚩尤入昴胡当灭，胡骑散乱胡兵折。\n边风飒猎骝马骄，万里长嘶饮胡血。\n阵略閒收虎豹韬，笛声细弄关山月。\n朝那之北胡尘清，捷书旁午报承明。\n十年塞下操戈客，白首无劳事战征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8711,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"翠峰草堂","author":"吴旦","text":"对君何处问，迢递草堂深。\n独坐寡尘虑，微吟生隐心。\n孤峰留晚照，平野带秋阴。\n庭下栽松树，苍苍已满林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8712,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海珠游览","author":"吴旦","text":"地控鲛人室，天回象帝宫。\n宝花纷映水，香阁迥临空。\n刹影江鸿触，钟声海雾笼。\n戒珠长不灭，灵景夜昭融。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8713,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘仙岩","author":"吴旦","text":"裹舄去何勒，灵踪在白云。\n穿林樵径逗，过垄石泉分。\n古溜空春色，孤根剥玉纹。\n岚霏行处薄，花气坐来熏。\n谷静声相答，天低语可闻。\n怪猿垂木末，高鸟出人群。\n未究丹光迹，谁探绿宇文。\n寄书找隐士，此地绝尘氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8714,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"姑苏道中","author":"吴旦","text":"川途纡曲有馀情，水国湖田曳桨行。\n震泽蒹葭寒外委，洞庭包橘望中明。\n烟波尚载扁舟影，露叶虚传响屧声。\n唯有旧时春草色，年年生绕阖闾城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8715,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夕城闉纳凉","author":"吴旦","text":"同游冠盖晚相招，泽国山川正泬寥。\n官阁迥临秦代垒，女墙斜带越江潮。\n流萤草短风先入，绕鹊枝长露易飘。\n多少高楼人不寐，碧天凉月夜吹箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8716,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"崖门吊古三首 其一","author":"吴旦","text":"舆图尽属一行宫，忍见妖星堕海中。\n阳厄九时胡有运，数逢奇处士无功。\n山藏战血应为碧，水出游魂半是虹。\n欲吊英灵何限恨，萧萧松柏起凄风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8717,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"崖门吊古三首 其二","author":"吴旦","text":"羌管胡琴一曲歌，南人渐少北人多。\n空闻杞女齐城哭，不见昭王汉水过。\n宝册有灵浮海岛，珠襦无主寄烟萝。\n千年留得孤忠在，成败休论奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8718,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"崖门吊古三首 其三","author":"吴旦","text":"误国由来一字间，上方无剑讨神奸。\n虞渊日入谁能取，沧海龙游遂不还。\n夜后蜀禽犹迸血，秋来湘竹总成斑。\n丹青俎豆休明事，一簇崇祠几仞山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8719,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九成台","author":"吴旦","text":"碧玉阑干压故基，虞王曾此驻旌旗。\n风泉尚带弦琴曲，谷鸟犹呈羽凤仪。\n二女不来云黯黯，重华何处草离离。\n郡城北望山如戟，落日微茫似九疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8720,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"心远亭探梅","author":"吴旦","text":"聊移杖屦探芳魂，翠羽飞时在兔园。\n玉屑带烟微有态，粉香随水半无痕。\n新妆巧向檐前得，旧曲愁从笛里翻。\n遥想溪桥春雪后，几枝疏影傍柴门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8721,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贵幸篇二首 其一","author":"吴旦","text":"常陪车驾幸甘泉，少小偏承汉主怜。\n日暮羽林传警跸，花骢嘶过禁舆前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8722,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贵幸篇二首 其二","author":"吴旦","text":"全家历叶事金门，诏改黄山作赐园。\n任选禁兵随出猎，九重深邃有谁言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8723,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"文衡山山水画","author":"吴旦","text":"路入云林一径斜，红尘飞断即烟霞。\n江南小隐无多地，杨柳阴中祇数家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8724,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"百丈带","author":"吴旦","text":"细草烟萝郁不分，玉泉飞下坐间闻。\n幽花莫覆岩前石，留与僧来看白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8725,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒李忠简公祠","author":"陈迁","text":"名贤祠傍海东湄，尸祝分明奕世思。\n抗疏昔曾留御榻，诏归犹有赠行诗。\n遗编尚遣流风护，丽藻重镌旧绩碑。\n旭日当窗光凛烈，还如端笏立朝时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8726,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和赵瀫阳太史答黎瑶石内史偕游浮邱之作 其一","author":"陈迁","text":"岧峣高阁倚云中，下有丹泉一窍通。\n晓起登台飞翠入，夜来看月碧山空。\n天边紫气归神鼎，世上玄机误塞翁。\n笑被松萝迷出处，坐穷今古见鸿濛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8727,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和赵瀫阳太史答黎瑶石内史偕游浮邱之作 其二","author":"陈迁","text":"一自骖鸾出上都，南来踪迹远尘区。\n山中旧有千年药，石上新栽九节蒲。\n直向宸居回剑履，岂因灵地滞江湖。\n君王此日虚前席，莫更寻仙傍玉壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8728,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游浮邱呈赵太史","author":"陈迁","text":"几回托乘赤松游，南国才名羡倚楼。\n川岳尚留宫锦色，烟光长带玉堂秋。\n天连紫阁三山近，水接瑶池一叶浮。\n此日金銮徵太史，白云芳草卧羊裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8729,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱景珊瑚井","author":"陈迁","text":"铃铃金策下人寰，密竹繁花掩映间。\n坐客诗题金谷胜，江津龙卧野云閒。\n邱中猿鹤随车盖，天际笙歌杂佩环。\n丹井尚留当日汞，银床风雨长苔班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8730,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱景大雅堂","author":"陈迁","text":"曾持宪节访诸天，缀玉联珠诗百篇。\n喜得邱中同白首，莫因桑落怨长年。\n功成独上三层阁，仙去空遗五色烟。\n风雅旧传金马客，相思多在斗牛边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8731,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱景朱明馆","author":"陈迁","text":"采药閒来往白云，琅琊消息隔嚣氛。\n远寻丹灶金银色，误入仙家鸡犬群。\n月落九霄闻鹤唳，春深五鬣长龙文。\n烟霞满地无人扫，共托芳尊对夕曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8732,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日游浔州西山","author":"陈迁","text":"晨起出西郭，飞盖恣欢游。\n芳林喜新霁，倚马听鸣鸠。\n瀑布千峰润，穿云一径幽。\n崇兰被峻坂，灌木荫丹丘。\n背岩花落尽，粤客动春愁。\n几欲策高足，栖迹复何求。\n饥餐石上芝，渴饮涧中流。\n无由弃簪绂，徒自羡留侯。\n良辰不易得，莫惜酒盈缶。\n归途日已暝，跻攀兴未休。\n独有天边月，相随到郡楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8733,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自述","author":"陈迁","text":"吁嗟陈人七十馀，蓬头跣足依敝庐。\n门无车马多榛莽，本为穷愁日著书。\n忆昔十五二十时，结交海内豪侠儿。\n至今抚膺长叹息，安得凭陵百万雌。\n击筑微吟不辞醉，朱楼红粉恣欢爱。\n桃花零乱春复春，回盼佳人今安在。\n仗剑飘飖事远游，濯缨直溯千丈流。\n狂来倚天天祇尺，日月西沉紫气浮。\n自谓樊笼羁不住，三山五岳凭虚度。\n可怜释蹻入承明，却被儒冠反相误。\n衔橛在前徒苦辛，韶光转眼如飙尘。\n览镜须臾成丑老，思心绻结难具陈。\n君不见汉家豪右歌牢石，一代繁华易消歇。\n又不见金谷园中草色芳，楼台寂寞风萧索。\n何须握粟问穷通，但愿云眠万虑空。\n自昔达人张仲蔚，阶前寂寞长蒿蓬。\n庄生老去思鸢食，枕上谁能生八翼。\n甘心贫贱复何求，且向东篱呼五白。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8734,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端阳吊古","author":"陈迁","text":"姱节垂青史，遗风遍海隅。\n榴花空笑日，楚客尚飞符。\n艾叶杯中蚁，龙文水上凫。\n灵均呼不起，愁思落菰蒲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8735,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游陈封君石桥庄次卢方伯韵","author":"陈迁","text":"西林有閒客，溪馆夕阳幽。\n草色多秋意，年光逐水流。\n云连双雁度，月带片帆收。\n为报山中伴，酣歌任白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8736,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游云帽西庄次卢星野韵 其一","author":"陈迁","text":"结茅临曲岸，祇恐海鸥知。\n明月空悬榻，芳樽欲待谁。\n白云留石枕，红槿护东篱。\n大隐归朝市，君恩岂有涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8737,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游云帽西庄次卢星野韵 其二","author":"陈迁","text":"艳舞团金屋，清歌近笛床。\n相携云外去，直向酒中藏。\n月榭留仙侣，春庭湛露光。\n词林有閒客，作赋拟长杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8738,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游云帽西庄次卢星野韵 其三","author":"陈迁","text":"有客迷幽径，披香宿霭霏。\n山中归计早，日下故人稀。\n海阔星河近，秋深橘柚肥。\n几宵烟水梦，犹向帝城飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8739,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游云帽西庄次卢星野韵 其四","author":"陈迁","text":"昔日青袍旧，来寻郑子真。\n烧丹思却老，种树欲藏春。\n钓客非轻汉，花源岂避秦。\n天边帆影杳，犹有未归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8740,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夕","author":"陈迁","text":"故山迢递思悠悠，坐对沧溟月一钩。\n万壑新凉摧落木，几宵归雁唤深愁。\n举杯莫负陶潜菊，称兴重登庾亮楼。\n自笑飘蓬空浪迹，白蘋寒渚愧眠鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8741,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金陵灯夕","author":"陈迁","text":"十二重城夜不扃，遥闻深院踏歌声。\n仙台宝扇翻鳌影，绣阁珠帘捲月明。\n千炬花光浮玉几，九天春色度云屏。\n灯前莫问昆仑事，四海升平已罢兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8742,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"何计部粤桥召宴淮上","author":"陈迁","text":"十年京洛风尘客，此日津前独泛舟。\n淮海鱼龙春梦暖，楚天烟雨雁声愁。\n坐邀明月临仙署，醉把残英感素秋。\n倾盖不知归路暝，停云芳树独淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8743,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日燕台旅次","author":"陈迁","text":"宦邸情深独倚楼，背人燕雁几声愁。\n月临睥睨怜孤客，风落梧桐报早秋。\n览镜忽惊玄鬓改，片帆长被白云留。\n百年归计何时定，北去南来愧海鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8744,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日游燕子矶得埃字","author":"陈迁","text":"忽看海岳净氛埃，与客攀欢上钓台。\n水到湓城帆影没，月横淮甸雁声哀。\n烟笼远树留残照，石漱寒潮长绿苔。\n六代繁华犹未歇，白云芳草共徘回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8745,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]