[{"title":"题寄南华寺 其三","author":"丘浚","text":"红梅过去到黄梅，正遇昙花五叶开。\n当日传衣从此去，又从此处转回来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五指参天少时曾作琼台八景郡侯程公巳刻之梓今不复存惟记其首一章谩录于此","author":"丘浚","text":"五峰如指翠相连，撑起炎州半壁天。\n夜盥银河摘星斗，朝探碧落弄云烟。\n雨馀玉笋空中现，月出明珠掌上悬。\n岂是巨灵伸一臂，遥从海外数中原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵公子还蜀","author":"丘浚","text":"柳花飞白缀征袍，击筑酣歌别思豪。\n老气逼人双剑古，好风送客一帆高。\n五湖烟水归程远，三峡云山入梦劳。\n别后相逢更何处，引杯烧烛谕龙韬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过沛县吊张克勤","author":"丘浚","text":"青山迢递绿芜深，欲吊孤坟何处寻。\n万里游魂今古恨，百年交谊死生心。\n云霄竟折升天翼，文彩空馀掷地金。\n几度泗河河上过，悲风凄惨动哀吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日郊行","author":"丘浚","text":"三月韶光满帝都，郊游士女竞欢呼。\n五花战马驮红袖，百结柔丝络翠壶。\n昼困柳眠莺急伴，春浓花醉蝶争扶。\n书生对景愁虚度，也学乘风咏舞雩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄张练师","author":"丘浚","text":"辞家学道入青冥，晓汲清泉昼斸苓。\n衣染春云同鹤色，剑涵秋水带龙腥。\n吟成白雪风生席，歌彻青天月在庭。\n几度缄书寄仙侣，蓬莱空阔隔沧溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"多景楼","author":"丘浚","text":"多景楼前景致多，倚阑吟眺奈愁何。\n浮云京国生春暝，落日乡关起暮波。\n浩荡乾坤心共远，蹉跎岁月鬓空皤。\n醉来击碎玉如意，仰面看天发浩歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽张处士","author":"丘浚","text":"少微星殒海天秋，漠漠悲风起暮愁。\n郡乘定书耆旧传，仙游真访羽人丘。\n云中鹤去茶烟歇，架上书成竹汗收。\n盛德不随身共化，百年有子绍箕裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题虎丘可中庭","author":"丘浚","text":"玉宇澄清宝界平，一庭寒影恰相应。\n柱头千载归来鹤，石上三生过去僧。\n蟾窟依然光满满，虎丘空有气腾腾。\n生公说法神听处，此日来游记我曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛未岁过扬州怀古","author":"丘浚","text":"秋风归棹倚芜城，一片闲情对月明。\n锦缆起鸥伤往事，青钱跨鹤笑狂生。\n吴公塘路巳陈迹，后主观花空有名。\n欲访平山旧阑槛，有无山色暮云横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁庚午来自金台寓新河有金陵即事之作明年复至因观高槎轩诗不意暗与之合有如剽窃然初实不知也用广其意为杂咏二首云 其一","author":"丘浚","text":"云中双阙俯秦淮，天外三山对凤台。\n二水合流趋派去，六峰飞翠过江来。\n金陵王气千年盛，钟阜晴云五色开。\n愧我才非班马匹，可能无赋奏蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁庚午来自金台寓新河有金陵即事之作明年复至因观高槎轩诗不意暗与之合有如剽窃然初实不知也用广其意为杂咏二首云 其二","author":"丘浚","text":"父老依稀说六朝，当时伯气巳全销。\n新亭别泪何须堕，古井妖魂不可招。\n爪步客帆朝带雨，长干僧艇晚随潮。\n行人不用誇天堑，南北舆图总属尧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和李太白韵寄题金陵","author":"丘浚","text":"昔年曾作凤台游，万里长江入望流。\n龙虎峙形长拂阙，金银厌气谩成丘。\n眼空八表人间世，兴寄三山海上洲。\n却笑古人多事在，烟波云月起閒愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和李子搆都门春日韵 其一","author":"丘浚","text":"碧桃花底共鸣珂，云淡风柔气候和。\n辇路雨馀生嫩草，官河冰泮动微波。\n近天楼阁逢春早，向日园林得暖多。\n我有新词三百阕，兴来呼酒对君歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和李子搆都门春日韵 其二","author":"丘浚","text":"宝马雕鞍白玉珂，花云淡荡柳风和。\n梵宫密密关金刹，海子深深湛碧波。\n郊外踏青游客醉，水边脩褉丽人多。\n谁怜寂寞杨雄宅，门巷无人自啸歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭唐珊","author":"丘浚","text":"洗耳沿途听捷音，捷音未到讣先临。\n苗生南亩初成秀，云出西郊未作霖。\n天上遽传宣李诏，世间空有铸颜金。\n青年妙质归冥漠，负我平生望汝心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中遇重九示同行友曾光启","author":"丘浚","text":"秋水芦花似故乡，客中无那又重阳。\n篱边摘菊人应异，蓬底看山兴更长。\n把酒不如前会健，登高无复少年狂。\n同行赖有曾光启，共买村醪醉一场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初读书中秘与脩天下志书柬陈宣之 其一","author":"丘浚","text":"五凤楼头百八钟，万鸦飞动晓天红。\n玉绳影转瑶阶日，金薤香生紫阁风。\n夺锦文章清禁里，登瀛人物玉堂中。\n回看人世仙凡隔，弱水浮埃迥不同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初读书中秘与脩天下志书柬陈宣之 其二","author":"丘浚","text":"峥嵘杰阁殿东头，圣代储才礼数优。\n四库有书资检阅，九关无禁任观游。\n日华暖映三珠树，云气晴浮五凤楼。\n海上仙山真浪语，玉堂深处即瀛洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄所知","author":"丘浚","text":"晋人风度楚人骚，不为悲秋叹二毛。\n席地梦回云气湿，仰天歌罢月轮高。\n凤兮览德翔千仞，鹤也扬声出九皋。\n有约蓬莱清浅处，碧桃花底听云璈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南京给事中童志昂和李商隐无题诗韵南京诸公多和之意盖有寓间出命予属和予村学究也不能外题以为诗姑咏史以复之 其一","author":"丘浚","text":"大雅无人继古风，周家辙迹一朝东。\n越裳白雉音尘绝，庸蜀金牛道路通。\n乌首百年终不白，宫烟三月尚馀红。\n淳风死去无回日，天下纷纷类转蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南京给事中童志昂和李商隐无题诗韵南京诸公多和之意盖有寓间出命予属和予村学究也不能外题以为诗姑咏史以复之 其二","author":"丘浚","text":"莫向鸿沟觅旧踪，一场春梦五更钟。\n也知赐醢缘情薄，岂是分羹爱味浓。\n万里使槎来苜蓿，半空仙掌出芙蓉。\n濛濛黄雾连天起，不见秦关百二重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南京给事中童志昂和李商隐无题诗韵南京诸公多和之意盖有寓间出命予属和予村学究也不能外题以为诗姑咏史以复之 其三","author":"丘浚","text":"一自铜仙入洛来，天开草昧几云雷。\n千年晋水飞龙起，午后周宫控鹤回。\n山下玉环啼粉面，岭南金镜忆良才。\n绣袍华帽开金统，真信人间有劫灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南京给事中童志昂和李商隐无题诗韵南京诸公多和之意盖有寓间出命予属和予村学究也不能外题以为诗姑咏史以复之 其四","author":"丘浚","text":"纷纷国步苦艰难，污简千年往事残。\n夹马营中香气散，黄龙堆上冻翎乾。\n金源运去雠方复，起辇魂惊骨巳寒。\n日月齐肩终古见，照天光彩万方看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽李克述先生之表叔","author":"丘浚","text":"天上仙游去不还，深林暮雨落幽兰。\n庚桑过后乡犹稔，贾谊亡来井未乾。\n五父衢开防墓合，九歌声断楚山寒。\n通家有子今文伯，为发潜光石上刊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽茅山隐者","author":"丘浚","text":"三茅峰下华阳洞，鹤怨猿惊失隐君。\n载酒无人问奇字，招魂有客赋骚文。\n尘埃长锁杨雄宅，车马频寻白傅坟。\n曾记题诗咏高致，不堪哀讣此时闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送尚宝凌卿使交南","author":"丘浚","text":"旭日初升万国明，钿函玉札下南溟。\n符台自昔瞻卿月，远道于今望使星。\n老树古香生桂蠹，乱山残雨带龙腥。\n兹行万里真奇绝，好把新诗纪所经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日田园杂兴 其一","author":"丘浚","text":"二月春融土脉苏，趁时农圃正耕锄。\n晓犁破草翻新块，晴瓮分泉养嫩蔬。\n鸲鹆飞来牛背立，鹁鸠对向树头呼。\n老妻携酒花间劝，醉倒残阳手就扶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日田园杂兴 其二","author":"丘浚","text":"生意津津乐趣深，一犁春雨万家金。\n绕畦菜荚初生甲，出水秧苗渐露针。\n藻漾池心鱼拨动，花藏叶底蝶穿寻。\n就中兴思知多少，尽是东皇发育心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34958,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日田园杂兴 其三","author":"丘浚","text":"二顷湖田五亩园，百年世业遗儿孙。\n风和莺语笙簧巧，雨过蛙声鼓吹喧。\n木屐穿花沾露湿，桔槔?水带泥浑。\n老妻报到茅柴熟，相约邻翁醉竹根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34959,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日田园杂兴 其四","author":"丘浚","text":"漠漠平畴沙鹭飞，畇畇樊圃野莺啼。\n绿针白水秧千亩，黄蝶青苔菜几畦。\n脚踏莓苔随意往，手持竹杖与眉齐。\n兴来独得幽閒趣，满眼春光取次题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34960,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王给事中使交南","author":"丘浚","text":"中原才子称华簪，万里翱翔快壮心。\n论俗好传司马檄，归装宁载尉陀金。\n川原辽邈荒唐县，父老依稀说汉音。\n莫过遗墟问前事，鹧鸪啼处乱山深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34961,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻人说海北事有感","author":"丘浚","text":"四海平宁独乱离，转头巳是十年期。\n兽蹄旁午侵城郭，燕垒纵横傍树枝。\n远客归来前路失，遗民假息故城危。\n荒郊白骨宵飞燐，风雨啾啾正怨谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34962,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病起写怀","author":"丘浚","text":"寸心千里日悬悬，归计今秋又似前。\n身似冻翎飞不去，事如春蔓苦相缠。\n还家路梗须浮海，报国才疏只望年。\n几度自怜还自笑，羡鱼何事屡临渊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34963,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈缉熙修撰使高丽","author":"丘浚","text":"海上天风吹节旄，玉堂仙子锦宫袍。\n诏颁龙阙恩初下，诗到鸡林价倍高。\n万顷鳌金浮晓日，一江鸭绿涨秋涛。\n远夷未见熙朝凤，争看文章五色毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34964,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"分得都门晓日送彭阁老归省","author":"丘浚","text":"承恩归省出蓬莱，晓日都门祖席开。\n三尺阳乌离海上，九苞威凤下天来。\n霞光流彩明宫锦，云气浮香注玉杯。\n此际道傍谁不羡，几人亲在位三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34965,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"都城春日","author":"丘浚","text":"宫阙巍峨紫气高，西山东去碧周遭。\n天晴鱼跃龙池藻，春老莺衔御苑桃。\n映日暖云流似水，浥尘香雨润如膏。\n太平有象寻常醉，不用携樽倒浊醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34966,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴 其一","author":"丘浚","text":"楚客多悲况值秋，都将心事付东流。\n病来岂有空青石，寒到兼无粹白裘。\n丘陇累累多宿草，江湖泛泛总虚舟。\n芙蓉零落空洲暮，一夜閒情白尽头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34967,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴 其二","author":"丘浚","text":"木叶萧萧下树柯，御河流碧送晴波。\n西山鸟雀飞鸣遍，内苑菱荷积渐多。\n日映凤凰新出穴，云迷乌鹊旧填河。\n寂寥灯下悲秋客，怀古思乡奈病何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34968,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴 其三","author":"丘浚","text":"西风吹鬓冷萧疏，宦况无多客影孤。\n海燕知时辞旧垒，塞鸿趁暖就新芦。\n渴怀甫里烹茶灶，醒爱高阳醉酒徒。\n百尺高楼千里眼，岸连萧艾水沉菰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34969,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴 其四","author":"丘浚","text":"晓色苍凉日色新，小窗睡起鸟声频。\n千秋萧瑟三秋景，九陌纷纭万井尘。\n云气乍生犹淡淡，波光将动渐粼粼。\n都门共怅多离别，谁是临岐赠策人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34970,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴 其五","author":"丘浚","text":"六街晴色散秋光，一片浮云接大荒。\n塞雁随旸如有约，岭猿叫月巳无肠。\n褰裳花下愁沾露，散步林间怕履霜。\n此日不妨多酌我，壶中广大醉乡长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34971,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴 其六","author":"丘浚","text":"风扫长空积雨晴，短槐疏柳乱蝉鸣。\n沙头鸥鸟寻常去，江上蘼芜日夜生。\n嘉树有蹊荒藓合，好山无数断云横。\n却怀九曲餐霞客，独抱寒蟾溯紫清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34972,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴 其七","author":"丘浚","text":"秋风秋雨夜凄其，凭几沉吟有所思。\n惊鸟故投曾宿处，开花还是巳残枝。\n喜看淡月穿云出，静数游丝堕地迟。\n万里乡心千古意，兴来聊诵少陵诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34973,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟次直沽简彭彦实同寅","author":"丘浚","text":"潞河澄彻卫河浑，二水交流下海门。\n直北回看龙阙近，极东遥望蜃楼昏。\n孤城近水舟多泊，列戍分耕野尽屯。\n我有好怀无处写，欲沽尊酒对君论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蒋容卒业南雍","author":"丘浚","text":"束书携剑去匆匆，此日真成点额龙。\n天意不孤清苦士，世间宁有辍耕农。\n春回南国鸿飞急，云满西郊雨气浓。\n莫谩相逢嗟未遇，秋江随处看芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王给事中使占城","author":"丘浚","text":"银汉清秋泛使槎，节旄晴拂海东霞。\n扶桑水接南溟阔，析木天遥北斗斜。\n鹢首冲风龙伯助，凤毛瑞世岛夷誇。\n皇明威德今无外，莫讳中朝第一家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴克恢南归因柬王用先生","author":"丘浚","text":"话别匆匆欲去迟，送归因忆别来时。\n平安有信因君寄，窃禄无能报母慈。\n风雨十年多旧约，云霄万里更深期。\n寄声为问王夫子，何日相逢慰所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽羽士","author":"丘浚","text":"十二楼头海月空，朝元人去蕊珠宫。\n形销忽作良非子，物化真成亡是公。\n玄牝养来神不死，庚桑过去岁犹丰。\n床头一卷参同契，谩有彬彬万遍功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郊行口占","author":"丘浚","text":"闲来策杖出城隈，信步徐徐踏翠苔。\n林下闻钟知寺近，溪边待渡喜舟来。\n一声清唳横江鹤，几点寒香映水梅。\n老我归来机事息，等閒鸥鸟莫相猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34979,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苏武归朝图","author":"丘浚","text":"茂陵烟树碧萧疏，白首生还志不渝。\n面目依稀犹似昔，节旄零落巳无馀。\n归期不待羝生乳，远信真成雁寄书。\n颇有幽怀忘未得，梦魂时或到穹庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34980,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"运筹亭为韩都御史题","author":"丘浚","text":"五岭中间数仞亭，海云山月总关情。\n三千稷下诸姜客，十万胸中小范兵。\n谈笑巳看功业就，指麾能使鬼神惊。\n先忧后乐平生志，须仗忠贞答圣明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴 其一","author":"丘浚","text":"塞雁乘春又北飞，越人何事未南归。\n十年馆阁虚糜禄，三月庭闱阻换衣。\n树背时时劳夕梦，草心寸寸恋春晖。\n几回喜惧交并处，屈指亲年近古稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴 其二","author":"丘浚","text":"百计思归未得归，梦魂夜夜到庭闱。\n愁心苦似丸和胆，泪点多如线在衣。\n爱日每怜驹易过，临风却羡雁能飞。\n朝来闻报高凉捷，万一归程或可几。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34983,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和童志昂给事自蜀督军还贬寿昌令留别韵","author":"丘浚","text":"才捧纶音出禁闱，潢池赤子遽来归。\n安边自谓无遗策，平地谁知有伏机。\n送客江亭休赠策，逢僧野寺谩留衣。\n从来六月鹍鹏息，不久乘风又奋飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34984,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭童大章庶子","author":"丘浚","text":"万里归来不见君，老怀拍塞向谁论。\n素车白马违心约，黑树青林感梦魂。\n契谊半生情最厚，相思几度泪潜吞。\n死生一盏论交酒，忍痛来浇宿草根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34985,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过旧游处有怀袁秉中","author":"丘浚","text":"昔年曾向此中游，把酒谈诗夜未休。\n别后交游云四散，閒中岁月水东流。\n哀弦凄断声难续，醉墨淋漓迹尚留。\n却恐邻家更吹笛，老怀哀飒不禁秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34986,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送祁至和郎中使高丽","author":"丘浚","text":"鸾鹊天书五色裁，中原使者下天来。\n白山绿水玄菟境，玉佩琼琚绣虎才。\n绝域喜沾新雨露，远人惊见古樽罍。\n悬知不是乘槎客，肯带葡萄苜蓿回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34987,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和杨维新学士先子除夜高咏诗韵","author":"丘浚","text":"閒中日月静中过，孤竹清风柳下和。\n文解送穷聊自剧，诗成泣鬼不须傩。\n头颅种种遽如许，世态悠悠能几何。\n不朽只消贤子在，寻常名利孰为多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34988,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽沈时晹大参之祖","author":"丘浚","text":"青衫白发老一乡，人人薰德多循良。\n醉仙或过沈东老，恶少怕闻王彦方。\n黄鹤一去久汗漫，青山千古成荒凉。\n高年厚德巳足羡，况有诸孙能显扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34989,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽淮安毕义士","author":"丘浚","text":"江淮都会楚州城，过客咸知尚义名。\n晋鄙尽薰杨子德，邾人不爱鲁侯盟。\n漆园千岁椿何在，蒿里三春草又生。\n多少邻家需举火，至今闻讳尚吞声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34990,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈宗尧侍讲署南京院事","author":"丘浚","text":"南北于今两玉堂，俨如东壁望文昌。\n趋朝暂免通门籍，视事荣看绾院章。\n竹汗消青春昼静，槐龙屯绿午阴凉。\n软红尘土长安道，还忆联镳傍苑墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34991,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]