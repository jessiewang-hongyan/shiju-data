aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"口占授章献章朴","author":"吴与弼","text":"先后篮舆送我勤，交情岁久见漓淳。\n弟兄归去皆传语，事业应须日又新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9958,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荷塘口占授族孙福宁","author":"吴与弼","text":"古市冲雺湿，山桥踏月忙。\n隔林询白塔，隐几卧荷塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9959,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"塘坑绝句","author":"吴与弼","text":"鸡鸣踏月复前期，爱日如烘霁雨时。\n青眼满堂春似海，扬州诗兴溢南枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9960,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雁塘道中","author":"吴与弼","text":"人事周旋愧不遑，岁云莫矣趁归忙。\n笋舆傲兀长须困，蓑笠欹危度野塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9961,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"除夜次唐诗韵","author":"吴与弼","text":"银灯守岁未应眠，一听阳春自洒然。\n更祝明朝风日好，梅花满眼踏新年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9962,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"丁丑元日","author":"吴与弼","text":"往事浑如梦，春风忽又新。\n浮生空白发，依旧一瞢人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9963,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"人日赠丘孔曼","author":"吴与弼","text":"人日题诗雪满篁，写向伊人念旧乡。\n惆怅百年前故事，高曾笔砚接南窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9964,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春夜述怀","author":"吴与弼","text":"多病无安枕，长吟更短吟。\n园林初雨歇，花柳已春深。\n身世双秋鬓，乾坤独苦心。\n明朝风日好，何处快登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9965,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晓枕作","author":"吴与弼","text":"四时更代谢，万事相翕张。\n升沈任吾运，何须较短长。\n风雨尘窗不知老，日进遗编诵几行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9966,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"莫春行","author":"吴与弼","text":"学不讲，德不修，二者诚吾忧。\n日亲古贤圣，残膏剩馥供涵泳。\n青春告莫我不闻，落花飞絮从纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9967,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜晴","author":"吴与弼","text":"阳春正二月，霖雨何其多。\n午窗敛暝色，高陆扬洪波。\n昨宵乃何宵，高天众星罗。\n清朝太阳升，万象成熙和。\n馀花须载酒，因之一长歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9968,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"后坊坑","author":"吴与弼","text":"风景和明春服新，缓吟疑在曾沂濒。\n行临磐石迟回久，时有低飞鸟近人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9969,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"旧游感兴","author":"吴与弼","text":"既历覆船冈，更嬉西岸圳。\n俛仰旧游心，光阴迅一瞬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9970,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梦中作","author":"吴与弼","text":"烟消雾散，海阔天高。\n历块过都，乃见尔曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9971,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"石泉望灵峰有怀周娄二生","author":"吴与弼","text":"杖策閒来步夕阳，云峰遥望意何长。\n峰前二妙相暌久，鱼雁东西两渺茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9972,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夕凉独坐","author":"吴与弼","text":"缓步阶徐爱夕凉，微吟隐几久虚堂。\n行穿山月纷纷白，庭散檐花细细香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9973,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山庭夜坐","author":"吴与弼","text":"庭树阴阴过雨凉，冰轮正照坐中央。\n等閒真意须当认，莫学浮生一样忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9974,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"六月十七日沼上玩月","author":"吴与弼","text":"碧沼溶溶月照怀，好风时送嫩凉来。\n细思黄卷多新益，懿行嘉谟实快哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9975,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"予书月台字月既毕台字误落笔而为壹又书钩以足之惜无出处也徐思曩在石泉时东窗对一钩之月在缺月五更头寒光皎清夜之句感怀","author":"吴与弼","text":"曾对东窗月一钩，五更心事澹如秋。\n蹉跎不觉空霜鬓，争奈年华似水流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9976,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"沼上对月","author":"吴与弼","text":"又对青霄月一钩，金波玉露正宜秋。\n自应暮景重加励，遮莫年华似水流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9977,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鸡鸣候晓坐对东林残月宛然昔者之景又续鄙句","author":"吴与弼","text":"坐对东林月一钩，寒光皎皎近清秋。\n当年心事今何在，碌碌那堪日下流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9978,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"避暑普济堂","author":"吴与弼","text":"三伏炎蒸午倍瘥，长原叠岭困经过。\n竹林深院宜人处，冰簟清风一气和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9979,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同宗人嗣昶辈拜罗原冈先陇","author":"吴与弼","text":"清风朝辞上寿坊，溽暑午拜罗原冈。\n冈头卜兆三百祀，鬼神守护雷潭傍。\n澄空一瞩醉心目，楚山崒嵂吴江长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9980,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"避暑刀峰祠","author":"吴与弼","text":"竹里投装暑正隆，缓寻幽事向刀峰。\n芃芄香稻连畴绿，㶁㶁寒流一涧通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9981,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿吕家壕先陇右畔李宅","author":"吴与弼","text":"眷眷先茔是夙心，肩舆又事远追寻。\n行云流水良随遇，步月看星此竹林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9982,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同族拜吕家壕先陇","author":"吴与弼","text":"昨日虚劳远候迎，竹间今喜款柴荆。\n西风一激荒山陇，何限慈孙孝子情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9983,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿吕坊寺","author":"吴与弼","text":"罢浴清溪步夕凉，四檐风月宿僧堂。\n依稀却忆高曾上，桑梓连阴是故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9984,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游园","author":"吴与弼","text":"呼童时作后园游，淡日凉风踏素秋。\n花映东西红锦绣，果连南北绿云稠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9985,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠饶镇游襄阳","author":"吴与弼","text":"湖海平生志，山林老病身。\n何由出商徼，同尔望西秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9986,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中秋夜玩月次许郢州诗韵","author":"吴与弼","text":"四海同瞻此夜圆，楼台渐喜出云烟。\n蟾光玉洁秋中候，桂影冰清雨后天。\n吟处纷纷侵卧内，梦回穆穆满庭前。\n诗成惟有疏星伴，萍梗明年忆去年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9987,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"即事","author":"吴与弼","text":"借得禅房久寓居，閒中转觉日舒舒。\n二三童冠相于好，卧听琅琅小学书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9988,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"离寺","author":"吴与弼","text":"遥为松楸此寓居，清风明月二旬馀。\n宵来红叶催归梦，明月青山是旧庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9989,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同宗人允基拜罗冈先陇","author":"吴与弼","text":"古寺相寻两度来，孝思共写百年怀。\n西风红叶桐园曲，四望青天一快哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9990,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"对月偶成","author":"吴与弼","text":"夕阳扶杖步前庭，归踏繁阴霁月清。\n灵府偶然无一物，静中意思验周程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9991,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"即事","author":"吴与弼","text":"浮世升沈一听天，竹窗养病日高眠。\n杖藜偶散东林步，丹桂秋香又一年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9992,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晓枕作","author":"吴与弼","text":"多病苏来体自轻，吟边又喜气和平。\n行云流水曾闻命，何用君平卜此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9993,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"诸生助移门楼诗以劳之","author":"吴与弼","text":"鱼贯相于冠与童，浩歌声里气如虹。\n明朝饱挹溪山胜，多赋新诗颂尔功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9994,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"牧南岸岭次横渠先生韵","author":"吴与弼","text":"碌碌浮生一梦中，并游无侣古今同。\n偶因晴牧閒行好，绝壁孤吟万壑风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9995,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜读滕元发墓志","author":"吴与弼","text":"理枉能令伛者伸，古今何处觅斯人。\n沈吟无计起公死，徒向尘编感兴新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9996,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同晏洧游铺前山","author":"吴与弼","text":"小春天气暖如烘，山果漫山黑间红。\n缓步崇冈清眺罢，悠悠归咏夕阳中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9997,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游山 其一","author":"吴与弼","text":"客归曾此眺层巅，独步重来十五年。\n人事几多随候革，山光水色自依然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9998,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游山 其二","author":"吴与弼","text":"胜游欲罢驾言还，山水盘回趣更玄。\n试问丹青难状处，朗吟人在白云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9999,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同小儿游山","author":"吴与弼","text":"幸得身閒心自休，呼儿时作小春游。\n千山莫景难描画，磐石何妨又少留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10000,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游山 其一","author":"吴与弼","text":"为爱云山深复深，筋骸粗健强登临。\n一般真意谁能辨，矫首苍茫独咏心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10001,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游山 其二","author":"吴与弼","text":"胜地曾经托趣深，和风晴日喜重临。\n筋骸又老四三载，何限依依怅旧心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10002,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游山","author":"吴与弼","text":"童冠相呼作胜游，经霜山果正优优。\n林泉好处将诗买，红日衔山咏未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10003,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三峰亭","author":"吴与弼","text":"一亭危构接云烟，亭罢基存境宛然。\n重赋新诗留故事，清风从此更谁边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10004,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"牧后坊","author":"吴与弼","text":"遮莫风霜暮景侵，又因晴牧事幽寻。\n邻童供命诸生侍，一曲真诠击壤吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10005,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"后坊牧归","author":"吴与弼","text":"林泉随处境幽幽，争奈浮生不暇游。\n日日杖藜归去晚，野心端被白云留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10006,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同诸生登聂家尖","author":"吴与弼","text":"寻常多爱此峰游，踪迹疏来已十秋。\n他日会心峰愈胜，小诗难写兴悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10007,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与诸生授康节诗道傍石","author":"吴与弼","text":"好诗歌罢乐忘忧，不管浮生岁月遒。\n忽意莫春曾此坐，独吟时喜鸟相求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10008,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晓枕作","author":"吴与弼","text":"饥寒难免切身忧，富贵由来不可求。\n日用信从吾所好，万缘有命岂人谋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10009,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晓枕感怀","author":"吴与弼","text":"年高德邵是难能，曾辱良朋妄见称。\n碌碌光阴空二纪，不堪惆怅忆平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10010,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"伤傅秉彝","author":"吴与弼","text":"竹窗琴剑寓经旬，洗墨池边迹已陈。\n惆怅玉楼吟望久，眼中那复觅斯人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10011,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]