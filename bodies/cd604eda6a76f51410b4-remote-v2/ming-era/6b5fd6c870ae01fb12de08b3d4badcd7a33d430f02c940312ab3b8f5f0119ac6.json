"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9939,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题李章芸香阁","author":"吴与弼","text":"字向金陵书，阁从五峰坐。\n绿酒共深更，剧谈忘尔我。\n阁上遗经凡几编，好惜分阴勖新课。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9940,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题程庸读书阁","author":"吴与弼","text":"旅思摇摇倦淹泊，息肩重喜登新阁。\n阁中无物不堪誇，举目咫尺皆真乐。\n赋诗不尽析薪情，负荷丁宁二雏学。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9941,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿山家","author":"吴与弼","text":"午爨辞景云，夜宿投庵下。\n山中俗朴长幼淳，也解闻风礼贤者。\n自愧虚声诳世间，到处令人误惊诧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9942,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"访饶烈 其一","author":"吴与弼","text":"逆旅初从远峤回，迂途风雨为君来。\n高轩一到留诗别，莫阻归心向酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9943,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"访饶烈 其二","author":"吴与弼","text":"莫阻归心向酒杯，怜君意气更迟回。\n龙潭丽泽荒芜久，好约良朋次第来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9944,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"访饶烈 其三","author":"吴与弼","text":"好约良朋次第来，百年时序日相催。\n分阴须惜更须惜，不学何由造达材。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9945,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"主翁莫归","author":"吴与弼","text":"中心欲投辖，风雨催归鞍。\n梦迫大刀头，长歌双玉盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9946,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉柬塘坑诸亲友","author":"吴与弼","text":"久客宁容忘式微，瓜期日念去迟迟。\n闻君好爵端孤负，棹雪山阴定有时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9947,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"道中口占授饶烈饶岳 其一","author":"吴与弼","text":"风雨联镳远送时，高谈雄辨解人颐。\n知君自有男儿志，肯负平生师友期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9948,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"道中口占授饶烈饶岳 其二","author":"吴与弼","text":"仲父前程日见功，远追祖德尔宜同。\n从今好笃男儿志，莫负皇天降此衷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9949,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"经马茨塘","author":"吴与弼","text":"云景渐清和，琴书此地过。\n不须留客饮，且喜为君歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9950,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿西廨彭氏","author":"吴与弼","text":"宿雨天清路不赊，高堂绿酒映灯花。\n金鸡声里微吟觉，归梦分明先到家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_