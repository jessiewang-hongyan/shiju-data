[{"title":"登粤秀山","author":"伦以谅","text":"攀萝犹觉苧衣单，短壑松阴午亦寒。\n孤鸟带风来郭外，片云浮雨过江干。\n高低远树如烟织，浓淡青山入画看。\n万里晴空堪眺望，晚来杯酒正交欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1833,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日游西樵集古","author":"伦以谅","text":"东风携手问桃花，直入天台石径斜。\n红杏枝头闻犬吠，青山影里见人家。\n涧边瑶草含朝露，岩际珠帘卷曙霞。\n笑杀仙凡风景异，一杯流水泛胡麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1834,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海珠寺","author":"伦以谅","text":"千江月色泻烟流，万里长空紫气浮。\n入夜涛声长似昼，列云花影不知秋。\n石床鹤叫回尘梦，海寺风生逼酒筹。\n回问南溟星斗落，笔端云锦烂江楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1835,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿峡","author":"伦以谅","text":"峡江春尽水潆洄，猿去犀沉事已灰。\n铁笛一声何处至，布帆千里故人来。\n花开洞口逢青眼，路入仙源尽紫苔。\n三十年前游赏梦，此心常在钓鱼台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1836,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海珠寺别李三洲王青萝二子","author":"伦以谅","text":"两岸西风吹白蘋，三城烟火隔红尘。\n天涯黄菊双蓬鬓，海上青尊几故人。\n谋国计从穷处拙，倦游心向暮年真。\n罗浮东去扶桑近，黄木湾头好问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1837,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钓鲤台","author":"伦以谅","text":"一水明两岸，千峰长绿苔。\n凭高窥鸟道，寻胜得鱼台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1838,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南海庙","author":"伦以谅","text":"漫游久抱扶胥梦，多病来登广利宫。\n龙势东迤溟渤远，虎头南去越裳通。\n擎天柱立烟光净，浴日亭高海气空。\n一笑江山如有意，波罗风雨住归篷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1839,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游铁泉精舍赠邓顺之","author":"伦以谅","text":"我爱铁泉子，迂疏不作家。\n尊空方乞酒，鼎沸旋沽茶。\n囊贮春山药，楼深石径花。\n时携九筇杖，天外拄明霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1840,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游七星岩","author":"伦以谅","text":"岩洞何年辟，轩车此日游。\n云深衣袂冷，星落剑光浮。\n石燕疑烟火，床龙避客舟。\n放歌归路晚，仍渡碧蕖洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1841,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游小金山","author":"伦以谅","text":"妙高台上灵峰月，爱尔孤光尽夜看。\n天上琼楼归未得，御前金炬不胜寒。\n花开古寺香风合，鸿度长空雪影单。\n踪迹平生湖海外，断碑残碣为谁刊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1842,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"葛坛","author":"伦以谅","text":"炼丹朱明洞，寄迹飞来山。\n五百年前事，春风为解颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1843,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读文山遗事","author":"余经","text":"鲁连天下士，誓不作秦民。\n至死犹忧国，临危岂顾身。\n目中无宋土，楼下有胡尘。\n梦里朝天去，徘徊散紫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1844,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和薛邑侯登黄岐山原韵","author":"黄一道","text":"步入层峦翠径微，为梯苔磴转纡迟。\n悬崖风细云犹甲，古木春深叶作旗。\n牛首谁怜当日泪，莺花莫负此时卮。\n兴馀却苦三农旱，龙卧何缘吸墨池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1845,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"常山阻雨怀同年詹黄门","author":"梁乔升","text":"去年怀玉雨，雅情多荷君。\n拨炉煨雪酒，剪烛细论文。\n五日方上马，新晴照吟襟。\n行行尚不忍，一步一沉吟。\n今年常山雨，滴滴上我心。\n山亭睡不着，岑寂寒难禁。\n美人隔一山，路近无由亲。\n愁见黑云翳，恨望枫树林。\n安得北风劲，吹散重云阴。\n旭日融融起，舆帷生氤氲。\n我爰挟我剑，我爰囊我琴。\n相见立相期，共话寒更深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1846,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海珠寺谒李忠简公祠","author":"梁乔升","text":"兀然一石江心浮，撞破江潮两道流。\n若把名祠品题遍，海珠端合在前头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1847,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广州清泉精舍","author":"梁世骠","text":"献岁乘休暇，选胜访名园。\n城春紫烟蔼，门静绿阴繁。\n逶迤鹤径窈，睍睆莺枝喧。\n五柳荫芳沼，列岫围孤轩。\n碧泉澄玉甃，丹洞隐玄猿。\n鸾情极冲想，凤翮当高骞。\n文光绚户牖，淑气浮兰荪。\n伫立檐日转，遥见江云翻。\n瞥尔翔寥廊，超然尘俗蠲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1848,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铙歌鼓吹曲二十二首 艾如张一章十三句 其三","author":"黄佐","text":"艾如张，罗毕以罗。\n雀飞避旃将谁何。\n雀以飞，罗罹之。\n钲镯何以为，嗟将问谁。\n又何以为，嗟此者谁。\n卿道不，鼓绝声。\n白云上天，日月其明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1849,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江南弄七首 其一 江南弄","author":"黄佐","text":"桃花婀娜随轻风。\n芳颜照灼舒春红。\n垂手攘袖舞未终。\n舞未终，歌羽衣。\n行云驻，梁尘飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1850,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江南弄七首 其二 龙笛曲","author":"黄佐","text":"朱唇掩抑呈妙音。\n绿水澹荡闻龙吟。\n长矕远引摇春心。\n摇春心，破春寒。\n动光风，汎崇兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1851,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江南弄七首 其三 采莲曲","author":"黄佐","text":"青娥翠楫行彩舟。\n莲花未绽含娇羞。\n颦眉聚黛扬清讴。\n扬清讴，度修渚。\n炫明妆，澹容与。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1852,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江南弄七首 其四 凤笙曲","author":"黄佐","text":"腾鸾起凤吹参差。\n幽簧动翮纤指移。\n珠垂玉振为君施。\n为君施，间歌作。\n拊秦筝，奏别鹤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1853,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江南弄七首 其五 采菱曲","author":"黄佐","text":"钿花匐叶浮香雾。\n兰桨桂楫摇江步。\n采菱声合流云度。\n流云度，和风吹。\n振罗袂，行相随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1854,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江南弄七首 其六 游女曲","author":"黄佐","text":"联娟翠翰映玉光。\n縠衣绣袿嬉江阳。\n淩波解佩游龙翔。\n游龙翔，闻芗泽。\n发浩倡，聚行客。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1855,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江南弄七首 其七 朝云曲","author":"黄佐","text":"朝云飘忽巫山台。\n扶光照耀群阴开。\n瑶姬屏伏阳春来。\n阳春来，散郁滞。\n祝君王，千万岁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1856,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞龙引阅中秘书作","author":"黄佐","text":"飞龙开治朝，承宇何翘翘。\n轻烟冒朱阁，玉除依庆霄。\n基命会文执，提剑驱天骄。\n燕台定吴鼎，奎光明斗杓。\n羽陵启方策，鲁壁闻英韶。\n遗编溢金匮，稽古师帝尧。\n渊源浚翠川，腾跃昂碧寥。\n缥缃今寂蔑，神悟畴与昭。\n白驹乐场藿，伊人正逍遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1857,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿柏台","author":"黎瞻","text":"玉树琼枝照柏台，碧纱高卷绝尘埃。\n平生未识东风面，可有秋香带月来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1858,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋忆罗浮","author":"利宾","text":"野兴登临秋更浓，罗浮念念寄尘踪。\n神驰四百飞云杪，目断千寻瀑布淙。\n洒墨犹存坛里竹，遗丹难老涧边松。\n稚川精爽依然在，杖履何年许尔从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1859,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖中纪兴","author":"利宾","text":"西湖水绕百官池，万丈飞虹任所之。\n屿亭倒影游鱼避，郊竹连阴倦鸟知。\n瀑布乘风□小艇，波光和月照芳湄。\n几家烟火相邻处，抚景年年泛紫卮。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1860,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饮伦樾溪秀野亭","author":"吴允裕","text":"地僻天偏厚，亭幽春自深。\n横塘澄碧练，过雨沐青林。\n百卉开将遍，纤埃寂不侵。\n相携有馀庆，谁复问晴阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1861,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"道中即事","author":"吴允裕","text":"碧树霜黄乱叶飞，篮舆冲雨度寒崎。\n两年窃禄惭无补，十亩将芜笑未归。\n隙里光阴蓬鬓改，望中风浪素心违。\n孤臣瞻恋天涯隔，一疏何因彻御扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1862,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游苏仙岭次彬守孙鹤洲韵","author":"吴允裕","text":"山径逶迤接碧霄，空中楼观郁岩峣。\n仙踪漫信凭虚见，尘况偏随小憩消。\n松石阴连幽洞竹，崖云晴护涧泉桥。\n相携一笑烟霞迥，何处商歌杂凤箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1863,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次郑敬道明府八景总咏韵","author":"古文集","text":"邑中奇秀多山水，宇宙名区堪比拟。\n古祯遗谶良是潜，故老传闻非率尔。\n文物诚不下他州，吾祖破荒几百秋。\n公来览胜有高调，胸次岂同俗吏流。\n梧冈落照夕返岩，岫桂拂岚晴未了。\n渔郎歌月溪浅清，径出云檐深窕窈。\n野渡横舟归客号，杏花雨湿耕农劳。\n龟峰一塔自千古，石边亭饯松花醪。\n古今赋咏若干首，此景还来待公久。\n阳春白雪和再难，斲垩肯为运斤否。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1864,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梧峰夕照","author":"古文集","text":"落霞孤鹜带苍茫，半影青山掩映光。\n纵有丹青描不就，祇应豪客赋诗章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1865,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桂岫晴岚","author":"古文集","text":"日出三竿瘴雾消，岚光掩映桂香飘。\n山中自有巢由辈，心隐清高不弃瓢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1866,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝江渔唱","author":"古文集","text":"秋水长天一色清，月明江上踏歌声。\n翻思响遏行云处，争似芦洲自在情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1867,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫桑闻北郊亲蚕赋 其一","author":"黄佐","text":"有菀宫桑，遵彼郊场。\n其叶扬扬，仓庚载鸣。\n扤扤条肄，乃集乃翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1868,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫桑闻北郊亲蚕赋 其二","author":"黄佐","text":"有菀宫桑，遵彼郊曲。\n其叶维沃，以筐以簇。\n以躬杼柚，用成我服。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1869,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫桑闻北郊亲蚕赋 其三","author":"黄佐","text":"毋曰我私，黼裳卷衣。\n爰响爰禋，既襄既宜。\n父母攸诒，云胡勿思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1870,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梧凤朝阳三章","author":"黄佐","text":"维梧有凤，鸣于朝阳。\n言翔于天，其音锵锵。\n明哲君子，御此南疆。\n维皇眷之，晋锡孔昌。\n维梧有凤，朝阳其鸣。\n其音嗈嗈，言翔于京。\n明哲君子，戎功告成。\n逖此南夷，皇心则宁。\n梧桐萋萋，朝阳杲杲。\n凤鸣高冈，其音载好。\n明哲君子，身维保之。\n懿兹戎功，皇维焘之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1871,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石径樵归","author":"古文集","text":"伐木宁辞活计疏，苍苔白石雨晴初。\n归来饱饭黄昏后，还向窗前读古书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1872,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙津晚渡","author":"古文集","text":"鲤鱼风起浪花生，薄暮行人阻去程。\n我有济川舟楫稳，与君缓载不须争。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1873,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平潮夷雅十一章","author":"黄佐","text":"于赫皇命，征彼潮夷。\n显允张公，秉钺孔宜。\n黄旗旆旆，爰董我师。\n有鞑有狼，如虎如螭。\n维公率止，既类既祃。\n元龟告祥，乃宜干社。\n四牡锽锽，梧台之下。\n金盾雕戈，光鉴于野。\n出次于广，乃涉于潮。\n虎臣洸洸，螭队翘翘。\n七萃云连，苞有三饶。\n岂敢欢嚣，我皇威孔昭。\n元戎启行，四围其薮。\n彼昏不知，如鱼在罶。\n蠢尔逆琏，悔为乱首。\n喘伏于莽，喙其群丑。\n我师翼翼，乘其石城。\n石城重重，既骞既崩。\n深入其寨，克奋克登。\n按其徂奔，罔敢有启扃。\n雷电发发，威燀旁达。\n于程于埔，震叠莫我遏。\n彼蹙且頞，癙忧如暍。\n如蘖如蘖，逢我薄伐。\n我武既扬，神机允臧。\n消其峰雪，日出之光。\n琏既徽纆，群爝胥亡。\n潮人咸喜，时雨其滂。\n旻穹穆穆，哀氓之无禄。\n既雨既洽，潮田既足。\n蠲其漂血，殖我百谷。\n扶挈旄倪，向用天福。\n彼海有鳄，噬人于牙。\n自剪且歼，俾我有室家。\n南溟汪汪，服岭嵯峨。\n四远来归，式讴式歌。\n休兵燕喜，俎豆维旅。\n箪食壶浆，祁祁士女。\n鼚鼚其鼓，轩轩其舞。\n萧勺群慝，万年无有侮。\n皇锡张公，犀鞶豸綖。\n駉駉訾黄，绥章绮軿。\n公拜稽首，神谋自天。\n公拜稽首，圣皇万年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1874,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东埔春耕","author":"古文集","text":"雨湿棠梨水满田，东郊农事正茫然。\n太平君相调元气，岁岁长占大有年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1875,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龟峰宝塔","author":"古文集","text":"浮图突兀跨高峰，万古江山胜概同。\n曾倚危栏题姓字，此身如在半天中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1876,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕石长亭","author":"古文集","text":"此是朝天第一程，柳边风飏酒旗轻。\n丈夫不洒离筵泪，任唱阳关曲几声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1877,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金山和韵诗","author":"薛侨","text":"堂敞金山胜概收，城中洞府见深幽。\n乔松绝壁长为护，明月清风不用求。\n槛外花香清益远，庭前草色翠交流。\n登临未尽高山意，欲采蘋蘩何处洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1878,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"廷杖矢志","author":"薛宗铠","text":"大奸在位，毒流缙绅。\n爰及三年，愤积神人。\n乃披忠悃，乃吁帝宸。\n惟帝时嘉，俟时而行。\n惟彼奸谗，捏搆诬绳。\n惟帝赫然，迸兹佞人。\n爰逮小臣，亦置于刑。\n于皇明圣，实余寡诚。\n大奸既去，遑恤我身。\n阳德方亨，永底乂宁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1879,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓山吊古","author":"李翔","text":"行朝谁更一登坛，借手无人为复韩。\n全浙及时堪决战，南溟何地再偏安。\n死生已判纲常在，慷慨徒多事势难。\n千古英雄追恨处，临厓空带怒涛看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1880,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨太后陵","author":"李翔","text":"天南南尽欲何之，有此天昏地暗时。\n精卫力微徒切念，杜鹃声苦剩馀悲。\n腥氛叵测瀰寰宇，块肉堪怜送海涯。\n行访适逢山雨过，泪珠犹缀野花枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1881,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"滨江即事","author":"李翔","text":"种竹为居近水傍，家家初插水田秧。\n应时雨好园林润，透幕风轻枕簟凉。\n隔墅摘归梅正熟，傍篱栽处豆初长。\n閒情不共人间世，牧唱渔歌管夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1882,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客衢夜坐二仆窃叹云寂寥如此极似寺中和上余闻之发一笑因以自嘲","author":"李翔","text":"官人时样不相称，僮仆偏怜有发僧。\n浮世生涯风外絮，异乡心事夜阑灯。\n閒拈秃笔连笺写，净拂疏棂对雨凭。\n何处天南归去路，云山犹自隔层层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1883,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉壶樵适自咏","author":"李翔","text":"率性樵夫似逼真，玉壶山远净无尘。\n松枝攀折忧妨鹤，桃片惊飞怕惹人。\n遇药身轻成往事，观棋柯烂却何因。\n非仙非释非时样，落魄云边一葛巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1884,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"翩翩者鹤贺吴子重闱荣寿三首 其一","author":"黄佐","text":"亭亭州山阴，松竹何青青。\n上有九苞羽，下有千岁苓。\n栖息东王公，照耀南极星。\n鹍弦沸瑶席，绣幄开云屏。\n奕叶惠文冠，执法天子庭。\n佩结苍精龙，金绯明玉映。\n欢声彻霄汉，恩波告冥冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1885,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"翩翩者鹤贺吴子重闱荣寿三首 其二","author":"黄佐","text":"宝日皛皛宣重光。\n玄冬丹峤瑶草芳。\n笙鸣瑟作广乐张。\n清歌妙舞回鸣珰。\n豸冠鹤发庞眉苍。\n振缨峨弁纷满堂。\n盈阶玉树侑王觞。\n瑞枣如瓜笑且尝。\n万岁千秋长乐康。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1886,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"翩翩者鹤贺吴子重闱荣寿三首 其三","author":"黄佐","text":"翩翩者鹤，鸣于菀林。\n其子和之，载好其音。\n念我重华，龙光是临。\n天子万寿，言慰我心。\n有鹤翩翩，鸣于菀柳。\n其子从之，亦翯其首。\n念我重华，锡此黄耇。\n言慰我心，天子万寿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1887,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"双节旌门诗","author":"黄佐","text":"明昭我皇，敬跻圣神。\n允文允武，无竞惟人。\n拔奇夷难，迈德振民。\n丕展彝叙，上明下亲。\n懿此双节，伯姒叔娣。\n姒固称贤，娣以子贵。\n教子伊何，敦诗说礼。\n出入乌台，表表伟伟。\n猗惟萧公，进思尽忠。\n巡彼粤西，有奋元戎。\n定姜卜征，馘夫之雄。\n百战奇法，奏此肤功。\n复巡东粤，崇我文教。\n表章先儒，是式是效。\n孟母励学，永言克孝。\n绍衣德言，犹织之懋。\n惟皇允武，公则诘之。\n匪母之教，征则匪宜。\n惟皇允文，公则崇之。\n匪母之教，又孰可师。\n文武彝德，既曰母教。\n贞节昭宣，无德不报。\n皇锡德音，旌门有诰。\n为世作程，于赫斯耀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1888,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"招颂补遗九首 其一 治洪水","author":"黄佐","text":"洪水滔天，浩浩方割。\n怀山襄陵，帝咨四岳。\n禹作司空，惟荒度土功。\n暨益秉烈火，山泽乃通。\n有鸟高飞，鸣且哺矣。\n呱呱者子，不皇顾矣。\n龙门辟兮，播为九河。\n崇禹之功兮，万世是何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"招颂补遗九首 其二 刊山木","author":"黄佐","text":"下民昏垫，哀此无告。\n禹乘四载，随山刊木。\n吕梁太岳，底柱析城。\n于恒于华，于荆于衡。\n乃畋于山，乃牧于谷。\n乃渔乃佃，于渊于陆。\n我胼我胝，我思阻饥。\n奏庶鲜食，惟下民之宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"招颂补遗九首 其三 浚畎浍","author":"黄佐","text":"禹决九川，以距四海。\n距川伊何，浚兹畎浍。\n肇河积石，江岷汉嶓。\n济淮入海，渭洛惟河。\n其鱼发发，孔庶且有。\n既汕于梁，亦获于笱。\n播奏庶艰，登彼丘陵。\n懋迁有无，化居是营。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"招颂补遗九首 其四 立烝民","author":"黄佐","text":"生生有开，烝民乃立。\n后稷播嘉种，下土斯啬。\n白壤黑坟，赤埴青黎。\n亦有黄垆，广斥涂泥。\n耕彼南亩，离离蕃茂。\n何铫何耜，载耨稂莠。\n乃迎猫虎，奏我笙庸。\n以乐我先啬，惟禹斯崇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"招颂补遗九首 其五 锡玄圭","author":"黄佐","text":"禹锡玄圭，告厥成功。\n万邦作乂，四海会同。\n庶土交正，底慎财赋。\n厥贡厥篚，厥包载路。\n金石盐絺，丝枲织皮。\n羽毛齿革，纳锡元龟。\n球琳琅玕，玄纁玑组。\n弼成五服，以修六府。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]