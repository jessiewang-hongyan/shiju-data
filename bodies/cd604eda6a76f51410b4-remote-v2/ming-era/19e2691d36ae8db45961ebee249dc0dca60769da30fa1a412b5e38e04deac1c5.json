[{"title":"题兰竹双蝶图","author":"胡奎","text":"湘浦歌竹枝，湘皋采兰叶。\n二妃招不来，贞魂化为蝶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57437,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题碧桃画眉图","author":"胡奎","text":"阿母西池上，春风碧雪多。\n一双花鸟使，也学画脩蛾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57438,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄友人","author":"胡奎","text":"一望一回头，白云千里秋。\n如何持别酒，只是送行舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57439,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄衣曲 其一","author":"胡奎","text":"倩得邻家女，裁衣信手缝。\n今年凉信早，六月见秋风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57440,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄衣曲 其二","author":"胡奎","text":"别泪千行线，愁肠万缕丝。\n夜深纤手冷，只有剪刀知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57441,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄衣曲 其三","author":"胡奎","text":"织就机中素，灯前拭泪看。\n若教郎得煖，又怕老姑寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57442,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄衣曲 其四","author":"胡奎","text":"近得平安信，官家赐赏钱。\n郎归知有日，不待厚装绵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57443,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题牛图 其一","author":"胡奎","text":"牛背稳于舟，牧儿忘百忧。\n晚凉过溪去，落日在林头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57444,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题牛图 其二","author":"胡奎","text":"一童牧两牛，牛驯童亦乐。\n放浪野田间，何曾识城郭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57445,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题牛图 其三","author":"胡奎","text":"老牸卧晴坡，回看水中犊。\n牧子过溪来，前村草痕绿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57446,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题牛图 其四","author":"胡奎","text":"江南水草肥，尔牛亦何乐。\n两童对奕时，若个先一著。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57447,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪后看山","author":"胡奎","text":"昨日白如玉，今朝青似螺。\n我留青白眼，看得此山多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57448,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"离筵赠故人","author":"胡奎","text":"叶落不返柯，水流无回波。\n人生易聚散，不饮当如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57449,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆友","author":"胡奎","text":"日没还上天，月缺还再圆。\n如何同心者，一别阻山川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57450,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题怡老堂画竹 其一","author":"胡奎","text":"玉堂高学士，远寄碧琅玕。\n此物能怡老，长年耐岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57451,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题怡老堂画竹 其二","author":"胡奎","text":"怡老堂前竹，如君好弟兄。\n裁为双玉琯，吹出凤凰声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57452,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"塞上曲","author":"胡奎","text":"边城柳色动，祗是去年春。\n借问云台将，如今有几人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57453,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"团扇联句","author":"胡奎","text":"织波千缕细，剪月一规圆。\n宠夺芙蓉后，恩深蛱蝶前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57454,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"正钗联句","author":"胡奎","text":"倦拭青铜镜，羞临玉镜台。\n钗梁金凤小，欲堕井中来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57455,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"昭君","author":"胡奎","text":"万里靖边尘，休言误妾身。\n青青原上草，犹是汉时春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57456,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古 其一","author":"胡奎","text":"望乡白云中，家本白云下。\n白云何当来，化为千里马。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57457,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古 其二","author":"胡奎","text":"青松在高冈，女萝附其巅。\n女萝无所愿，愿与松长年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57458,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古 其三","author":"胡奎","text":"匣中有长剑，防身三十秋。\n长剑何所愿，愿斩佞臣头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57459,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春风词 其一","author":"胡奎","text":"花信二十四，春愁千万端。\n年年吹不散，故故作馀寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57460,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春风词 其二","author":"胡奎","text":"通帷花气重，入户燕衣轻。\n嘘寒还作煖，吹雨复兼晴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57461,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春风词 其三","author":"胡奎","text":"朝吹杏花开，暮送桃花落。\n荣悴各因时，莫怨东风恶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57462,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铜雀妓","author":"胡奎","text":"月朝十五时，望陵作歌舞。\n歌舞綵云空，佳人化为土。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57463,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过相见湾","author":"胡奎","text":"月白霜气寒，雁宿黄芦静。\n停舟相见湾，隔林见镫影。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57464,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过相见湾遇友人","author":"胡奎","text":"大江无相知，幸识君侯面。\n舟行相见湾，况与君相见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57465,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中","author":"胡奎","text":"月白天宇高，仰见明星烂。\n坐久不闻钟，舟人夜中饭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57466,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题荷花鸂鶒图","author":"胡奎","text":"文禽好毛羽，双卧芙蓉浦。\n梦落烟水深，萧萧叶间雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57467,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长夏云村","author":"胡奎","text":"白云自何来，栖我山中树。\n愿为九夏凉，慎勿从龙去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57468,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"绩妇词","author":"胡奎","text":"小姑红烛下，夜绩到天明。\n乍可无膏火，偷光莫借镫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57469,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"商妇词","author":"胡奎","text":"花时去贩茶，叶落未还家。\n寄声船上月，慎勿照琵琶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57470,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上书情","author":"胡奎","text":"乱萤飞不停，独鸟栖还起。\n若说故乡情，深于大湖水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57471,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过平望 其一","author":"胡奎","text":"虹截江雨收，龙驱岭云散。\n渔屋起炊烟，舟人日晡饭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57472,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过平望 其二","author":"胡奎","text":"江上青裙妇，移舟夜月中。\n唤郎双打桨，好趁正南风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57473,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过阊门","author":"胡奎","text":"落日照长洲，乌啼苑上秋。\n百花都落尽，一水自东流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57474,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺情","author":"胡奎","text":"频拭镫前泪，恐沾衣上痕。\n不眠忘手冷，翻觉剪刀温。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57475,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻霰","author":"胡奎","text":"翛翛叶打窗，瑟瑟珠跳瓦。\n长夜未眠人，起听孤灯下。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57476,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客中见月","author":"胡奎","text":"初月蛾眉弯，纤纤出天外。\n幼女学穿针，多应下阶拜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57477,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题墨梅","author":"胡奎","text":"窗外翠禽啼，巡檐索笑时。\n铁心浑不改，只许墨卿知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57478,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初日","author":"胡奎","text":"旭日照罗帏，美人初睡起。\n双鹊绕檐飞，良人隔千里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57479,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉镜台","author":"胡奎","text":"妾把青铜镜，郎投玉镜台。\n芙蓉照秋水，似向水中开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57480,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"缆舟石","author":"胡奎","text":"寄语江边石，郎今隔远天。\n如何江水上，只缆别人船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57481,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题陶学士遇秦弱兰图","author":"胡奎","text":"白玉堂前明月，乌纱巾上青天。\n肯把自家风致，尽情付与婵娟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57482,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"老至","author":"胡奎","text":"今年七十有四，一岁三百六旬。\n看过故园桃李，不知几度青春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57483,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花信风","author":"胡奎","text":"二十四番花信，三千里外乡心。\n屈指落梅消息，从头数到如今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57484,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漫成 其一","author":"胡奎","text":"宁教花片沾泥，莫遣随风乱飞。\n沾泥尚留春色，随风不返故枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57485,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漫成 其二","author":"胡奎","text":"东家西家蝴蝶，南园北园杏花。\n明日花飞蝶去，不知春在天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57486,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题梅月图为长沙人作 其一","author":"胡奎","text":"黄鹤楼中玉笛，十年不到长沙。\n梦逐梨云归去，月明夜夜思家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57487,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题梅月图为长沙人作 其二","author":"胡奎","text":"罗浮洞天月上，姑射仙人夜归。\n玉骨本来贞白，缁尘莫涴裳衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57488,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题山居图","author":"胡奎","text":"亭上松风瑟瑟，琴边涧水泠泠。\n一个黄茅亭子，四窗云白山青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57489,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题林逋观梅图","author":"胡奎","text":"昔年曾访孤山，欲识诗翁半面。\n水边著意相寻，林下无心一见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57490,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题伯瑜泣杖","author":"胡奎","text":"母昔杖儿身健，母今杖儿力微。\n孝子之心爱日，喜惧之年可知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57491,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题闵损衣单","author":"胡奎","text":"母在一子衣单，母去三子衣寒。\n名列四科之首，孝为百行之原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57492,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题管鲍分金","author":"胡奎","text":"同心之金可断，仁者赠人以财。\n知我莫如鲍叔，管仲之器小哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57493,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苏武慢 八首 其六","author":"林鸿","text":"北垄耕云，南溪钓月，此是野人生计。\n山鸟能歌，江花解语，无限乾坤生意。\n荷锸归来，担簦閒眺，风景又还光霁。\n算人生、奔走如狂，万事不如沈醉。\n细看来、聚蚁功名，战蜗事业，毕竟又成何济。\n有分林塘，无心钟鼎，誓与渔樵深契。\n石上酒醒，竹间茶熟，别是水云风味。\n顺吾生、素位而行，造化任他儿戏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57494,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五噫歌梁鸿","author":"胡奎","text":"瞻彼洛京兮，噫！\n宫阙连城兮，噫！\n非我故乡兮，噫！\n鹿车辚辚兮，噫！\n归全其身兮，噫！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57495,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送胡志高赴汉中兼柬方希直 其一","author":"蜀献王","text":"趣装何处去，驱车赴汉中。\n欣然游大郡，况复依方公。\n问学日盗博，道德日益隆。\n丈夫志远大，那肯局樊笼。\n他年居馆阁，步武接夔龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57496,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荅希直","author":"许继","text":"婺岭隐天末，遥思正属君。\n慰情来远札，动目有新文。\n逸骥莫并驾，离鸿常念群。\n山空岁华晚，旧话几时闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57497,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送希直应聘赴京","author":"许继","text":"陋学窥千载，古今极寥寥。\n奇才不世出，先哲何其遥。\n方子间气英，孤凤翔九霄。\n经史敛胸臆，早岁能充饶。\n深造入玄閟，精研味腴膏。\n发为五色文，光?万丈高。\n吐辞信雄笔，江河势滔滔。\n闻者但缩喙，白首惭俊髦。\n受知潜溪翁，恩义犹同袍。\n顾托有深意，扬言岂虚褒。\n声价凌海岳，山泽焉久遨。\n神珠隐自现，宝玉终难韬。\n中使隆优礼，特起推贤豪。\n天衢丽云日，盛际宜有遭。\n纪载小班马，明良慕夔皋。\n徽猷谅巳著，荣名非所徼。\n同乡托交谊，春恋岂一朝。\n因依附劲翮，愧我腹背毛。\n会难思少留，去马疾若飙。\n情至不能别，病怀空郁陶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57498,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻希直自京还","author":"许继","text":"玉音初捧巳殊伦，天意深嘉得异人。\n众谓欧苏才复出，我知孔孟道当伸。\n赐归使就林泉养，期用留为瑞世珍。\n一旦巳成千载遇，高风矫首在清旻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57499,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄方正学内翰","author":"程仕简","text":"三十年前下董帏，姓名早见注黄扉。\n古今文字非无托，天地精华信有归。\n金匮入编严斧钺，紫泥承诏落珠玑。\n斯文盛代惟公辈，林下何曾有布衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57500,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒侯城里有感","author":"谢省","text":"侯城里，侯城老人死不死。\n万丈文光射列星，正流一派分洙泗。\n忠肝义胆照冰雪，烈气凭凭塞天地。\n神游帝侧骑箕尾，行天还整羲和驭。\n寒为阳和旱为雨，精灵飒爽谁能閟。\n冥交不用觅逢干，脩撰王郎旧知己。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57501,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒侯城里有感","author":"谢铎","text":"我忆侯城人，不见侯城里。\n悲风忽何来，令人泪如雨。\n侯城西薄山，侯城东逼海。\n西山不可饿，东海不可死。\n千秋万岁心，悽恻竟谁语。\n惟应剑光血，夜夜冲斗起。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57502,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"有感","author":"许相卿","text":"欲向西风酹一尊，乾坤何处著英魂。\n百年事过风前烛，千古名传海上村。\n香火半龛谁地主，孙枝一叶是君恩。\n夕阳满地伤心泪，付与江流自吐吞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57503,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒正学先生祠堂","author":"袁道","text":"我从东南行，清风东南至。\n往事垂百年，行人口如矢。\n大商有夷齐，大唐有王魏。\n稽首拜先生，地下知谁愧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57504,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钦和御制暑月民劳律诗一首","author":"释宗泐","text":"田夫岂暇纳微凉，赤日流金数亩秧。\n自是吾皇能体物，极知黎庶有饥肠。\n万家共仰秋成富，百世先培国本强。\n白首方袍无用客，独于林下和宸章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57505,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钦和御制思亲怀古律诗二首 其一","author":"释宗泐","text":"玄堂冬日尚玄衣，独有思亲外万几。\n虞帝泣天当雪鬓，汉皇归沛度河矶。\n中都胜地疏游幸，大孝终身靡间违。\n天下苍生钦圣化，老臣宁不念庭闱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57506,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钦和御制思亲怀古律诗二首 其二","author":"释宗泐","text":"海内承平有底愁，皇陵松柏老园丘。\n滁山南去关门壮，淮水西来郭外流。\n转眼光阴三十载，兴王事业百千秋。\n中都父老头如雪，长望龙舆此地游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57507,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钦和御制大将征回朔漠空虚二首 其一","author":"释宗泐","text":"万姓讴歌朔漠清，都缘圣主有经营。\n北边自古存瓯脱，瀚海于今属大明。\n鸿雁三秋随入塞，风云万里拥归旌。\n汉家曾奏无人曲，未若天朝此一征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57508,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钦和御制大将征回朔漠空虚二首 其二","author":"释宗泐","text":"百万旌旗蔽野阴，联翩戈甲耀南金。\n一朝白草无秋牧，千里黑松空旧林。\n追敌不知飞骑远，下营俄见涌泉深。\n将军功业过前代，刻石天山第几岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57509,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钦和御制江东桥诗 其一","author":"释宗泐","text":"玉作阑干石作梁，银河清夜共辉光。\n经营自出天工妙，锼琢仍归匠者良。\n大驾亲临观气象，群臣载拜献词章。\n谁知千古不磨迹，地久天长转更彰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57510,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钦和御制江东桥诗 其二","author":"释宗泐","text":"石梁高架奠长江，要路通津总帝乡。\n一代规模天广大，万年功业日昭彰。\n吾皇制作亲曾赐，臣下赓歌孰敢当。\n圣子神孙承大统，愿言鸿祚永延昌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57511,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钦和御制山居诗赐灵谷寺住持 其一","author":"释宗泐","text":"松风萝月满禅房，物外高情孰可当。\n鸟为衔花浑不恐，?因暖足自相忘。\n峰峦重绕何深䆳，楼阁新开更炜煌。\n敕赐良田供万衲，不须日籴太仓粮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":57512,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]