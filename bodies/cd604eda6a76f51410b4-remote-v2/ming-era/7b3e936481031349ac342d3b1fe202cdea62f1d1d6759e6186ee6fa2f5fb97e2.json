[{"title":"中宿归舟赋得落日放船好和张子白韵 其十","author":"成鹫","text":"落日放船好，明朝到广州。\n少閒思谢病，多默恐招尤。\n浅水影还见，深山愿未酬。\n武陵无可问，归向梦中求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49291,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿归舟赋得落日放船好和张子白韵 其十一","author":"成鹫","text":"落日放船好，山川草草过。\n未能舍良友，聊复答高歌。\n世网关心切，山缘失意多。\n祇应留傲骨，终老葬烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49292,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿归舟赋得落日放船好和张子白韵 其十二","author":"成鹫","text":"落日放船好，江城半掩门。\n远风飘叶尽，近水飐花繁。\n月魄销灯燄，霜痕浸发根。\n掩篷时强寐，怀抱古人恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49293,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿归舟赋得落日放船好和张子白韵 其十三","author":"成鹫","text":"落日放船好，蹉跎计未成。\n独怜归鸿晚，遥听乱鸦惊。\n戍柝萦诗思，江声入旅情。\n明明天上月，多半照浮生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49294,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿归舟赋得落日放船好和张子白韵 其十四","author":"成鹫","text":"落日放船好，篷窗向月扃。\n永怀在泉石，无梦到郊坰。\n槐火烧香篆，松灯对梵经。\n生涯吾已足，不用赋榛苓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49295,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿归舟赋得落日放船好和张子白韵 其十五","author":"成鹫","text":"落日放船好，枯形与影连。\n风轻催挂席，衣冷待装绵。\n造物有分子，劳生或未偏。\n将寻洗耳处，遑问定心泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49296,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿归舟赋得落日放船好和张子白韵 其十六","author":"成鹫","text":"落日放船好，天空雁阵长。\n三禅同木石，一气任炎凉。\n自分稽生懒，谁知点也狂。\n隔江愁过涉，招手慎搴裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49297,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿归舟赋得落日放船好和张子白韵 其十七","author":"成鹫","text":"落日放船好，秋光尚有馀。\n世由拘世谛，吾自返吾庐。\n过眼千峰瘦，澄怀万象虚。\n侯门难得到，何以曳长裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49298,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿归舟赋得落日放船好和张子白韵 其十八","author":"成鹫","text":"落日放船好，所思园绮俦。\n汉芝柔可茹，周粟饱当休。\n福地从猿住，天君与我游。\n遐心如铁石，何处不相投。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49299,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿归舟赋得落日放船好和张子白韵 其十九","author":"成鹫","text":"落日放船好，归帆卸晚霞。\n村童迎竹杖，溪鸟出芦花。\n蜡屐时行脚，蒲团长在家。\n凭谁辨劳逸，良晤阻天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49300,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游阳春作 其一","author":"成鹫","text":"自笑不知老，人前便说山。\n昨来逢好友，云自富春还。\n许以方丈地，分将一半閒。\n翛然生羽翼，飞出白云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49301,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游阳春作 其二","author":"成鹫","text":"孤棹发江口，连樯宿浅沙。\n同人皆有役，于我独无他。\n夜水闻争渡，春山梦到家。\n所思老渔父，高枕对芦花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49302,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游阳春作 其三","author":"成鹫","text":"岂有关心事，披衣坐到晨。\n鸡声前浦日，鸟语隔山春。\n多病凭僮仆，无成愧故人。\n忘机吾已矣，鸥鹭或相亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49303,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游阳春作 其四","author":"成鹫","text":"高秋别中宿，二月下阳春。\n未尽登临兴，终为寂莫人。\n虚名难隐世，文字苦随身。\n独立千峰外，长歌怀道真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49304,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊洞口赠张雪崖","author":"成鹫","text":"计程趋洞口，旧路忆筠城。\n采药逢高士，班荆识姓名。\n论交年谊密，问道世缘轻。\n明发挂帆去，相思何限情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49305,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊河头经同参故居","author":"成鹫","text":"河头曾宿处，风景已全非。\n旧社僧牢落，虚堂人到稀。\n草深车辙断，烟冷佛灯微。\n怅望同巢鹤，长空去不归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49306,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过竹步赠居亭谢处士","author":"成鹫","text":"奇峰环碧落，乔木倚云根。\n犬吠初来客，莺啼何处村。\n池塘曾梦草，桃李欲无言。\n许我陪皋座，主人无轾轩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49307,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题富春山房 其一","author":"成鹫","text":"入林见修竹，竹色何苍苍。\n旧是乌衣地，今为讲学堂。\n谷风洞虚牖，山月照禅床。\n留得孤僧住，悠然逸兴长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49308,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题富春山房 其二","author":"成鹫","text":"山以富春名，春山富现成。\n断金卑梓泽，介石薄连城。\n姜桂堪调鼎，芝兰自荐馨。\n翻嫌钓鱼叟，临老入东京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49309,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张子白舟过大通值予远游留诗而去归而和之 其一","author":"成鹫","text":"借问阳春道，芒鞋费几文。\n计程难计日，行脚即行云。\n归客无消息，虚堂静见闻。\n如何三径外，人迹乃纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49310,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张子白舟过大通值予远游留诗而去归而和之 其二","author":"成鹫","text":"久别还相问，重门偶不开。\n烦君留好句，笑我未归来。\n风过花移架，天空月印台。\n春光正如此，兹意倩谁猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49311,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初归大通张子白杨鬯侯过赠用韵赋答 其一","author":"成鹫","text":"昨暮问津去，仙源意可通。\n但寻流水入，不见桃花红。\n归路日将夕，逢君话未穷。\n东风莫相待，挥手别兰丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49312,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初归大通张子白杨鬯侯过赠用韵赋答 其二","author":"成鹫","text":"世路成胶柱，我心如转环。\n腰包无一物，脚板有千山。\n独鹤归来晚，片云飞去閒。\n何由逐春雨，潇洒到人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49313,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答罗萝石见过韵","author":"成鹫","text":"门径久不埽，何人问懒禅。\n来寻烟雨寺，高咏泬寥天。\n古调对流水，清谈如涌泉。\n野情信狂简，于尔独缠绵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49314,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅雨","author":"成鹫","text":"处处黄梅熟，轻雷布密阴。\n田衣潮气入，山屐藓痕深。\n溽暑移床榻，淋瓴溉釜鬵。\n谁怜桑扈病，来此听高吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49315,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋阳","author":"成鹫","text":"白雁来何暮，赤乌飞上天。\n凉飙不到处，炎势尚依然。\n倒影穿云薄，流黄濯锦鲜。\n秋光分一半，留作月轮圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49316,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋居","author":"成鹫","text":"黄叶满斋厨，金风为埽除。\n人皆感摇落，吾独赋閒居。\n地坼虫迁蛰，萤乾月照书。\n闭门秋事好，霜后足园蔬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49317,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋荷","author":"成鹫","text":"倾盖水云乡，蒹葭各一方。\n美人空解佩，楚客已无裳。\n静贮三秋色，寻思十里香。\n晚来涉江处，明月堕横塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49318,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋虫","author":"成鹫","text":"也有凄清意，不知鸣向谁。\n秋声愁并入，宵枕听还疑。\n感物成吾老，卑栖宁尔为。\n相思何处所，泥壁破柴篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49319,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋露","author":"成鹫","text":"风霜因有色，草木自为家。\n不去承仙掌，偏来湿桂花。\n山光流沆瀣，秋色老烟霞。\n寄语求仙者，琼浆未足誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49320,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋山","author":"成鹫","text":"空林初落木，远岫可跻攀。\n昨日涳濛际，今来几席间。\n风高樵语近，天迥鹤飞还。\n采采东篱菊，悠然心自閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49321,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋浪","author":"成鹫","text":"秋水净如练，秋风漾縠纹。\n萍踪何所寄，鸥鸟自为群。\n放眼波涛阔，澄怀清浊分。\n芦花与明月，相对白纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49322,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋雁","author":"成鹫","text":"所畏风霜迫，遂于俦侣亲。\n艰难长作客，飘泊不依人。\n岳色回寒影，秋声起塞尘。\n奋飞如可学，吾亦愿轻身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49323,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送人北上","author":"成鹫","text":"高车辞矮屋，白马饰金羁。\n风假鹏方便，天随人指挥。\n故山老薇蕨，上苑醉芳菲。\n翻笑灌园叟，傲然甘息机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49324,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春树 其一","author":"成鹫","text":"老树不知老，无文也有文。\n托根深处稳，生意静中分。\n红绽花朝雨，青留叶底云。\n荣枯今已定，何必问东君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49325,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春树 其二","author":"成鹫","text":"携手入林去，新莺处处闻。\n好春正如此，随地得逢君。\n一色远复远，群芳分不分。\n独留庭际影，高挂往来云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49326,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和诸子郊行见过","author":"成鹫","text":"此老兴不浅，朝朝起振衣。\n屐随吟客去，花送醉人归。\n得句寻僧和，馀酲扣竹扉。\n何妨茶当酒，留话到斜晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49327,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊琶洲寺访徐铎愚不遇","author":"成鹫","text":"辍棹琶洲寺，洲边访隐沦。\n相闻老词客，一去动经春。\n鹤并云心远，鸥兼野色匀。\n明朝洞天上，高咏与谁人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49328,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望罗浮怀旧隐","author":"成鹫","text":"罗浮殊有情，久别若平生。\n知我旧宾主，隔江遥送迎。\n片云开石洞，高鹤下朱明。\n是处有人在，半空闻笑声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49329,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟次明月寺访远律师不遇闻师同日至大通也","author":"成鹫","text":"昨夜见明月，所思疑在中。\n今来明月寺，不与见时同。\n一室宾亦主，片云西复东。\n愿留烟雨宿，待我转飞蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49330,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借庵即事 其一","author":"成鹫","text":"蒲团生两翼，飞出水云中。\n水浅难留月，云行不待风。\n亦知非久住，暂得免雷同。\n翘首家山路，洞门东复东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49331,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借庵即事 其二","author":"成鹫","text":"自古能閒少，求閒未易閒。\n被人知住处，移屋入深山。\n黄叶随流去，桃花送客还。\n至今成口实，陈迹待谁删。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49332,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借庵即事 其三","author":"成鹫","text":"空手把锄锸，师心学老农。\n护生耕熟地，挥汗种新松。\n梅厌饶酸气，花憎带冶容。\n客心何所寄，窗外绿阴浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49333,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借庵即事 其四","author":"成鹫","text":"藩篱原不有，草木自成围。\n坚癖牢难破，閒心静入微。\n鼠依贫屋瘦，犬傍懒人肥。\n近得轻身法，无营但忍饥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49334,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借庵即事 其五","author":"成鹫","text":"日涉须成趣，窥园见物情。\n屋随蛙背住，蓑覆鹤身轻。\n鹊为鸠藏拙，花先蜜治生。\n贫儿多活计，从此息经营。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49335,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借庵即事 其六","author":"成鹫","text":"群动静中见，孤心物外降。\n繁花蝇亦采，飞絮蚁能扛。\n拔地藤千尺，摩空鹤一双。\n野人非待兔，何事守枯桩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49336,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借庵即事 其七","author":"成鹫","text":"高枕得无梦，朝眠胜坐驰。\n蚊雷饶寸舌，虱阵朵双颐。\n寂寂原非我，惺惺却是谁。\n吾宗无此义，持去问希夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49337,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借庵即事 其八","author":"成鹫","text":"大地一孤僧，僧孤却有朋。\n雨师供茗椀，风伯致薪蒸。\n细语虫相答，求声鸟所能。\n未应嫌拣择，褦襶是苍蝇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49338,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借庵即事 其九","author":"成鹫","text":"雨后远天清，阶前异草生。\n焦芽才甲柝，败种亦勾萌。\n菌桂春芳歇，蕣花朝露荣。\n桑榆吾老矣，努力事归耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49339,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借庵即事 其十","author":"成鹫","text":"昨得山中信，园荒宿雨馀。\n虚堂旋野马，悬釜涸游鱼。\n风入翻书乱，云来借宅居。\n所闻快如此，所见复何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49340,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿胡宪公署中作 其一","author":"成鹫","text":"久不到城市，胡为为此行。\n主人真好道，知我本无情。\n坐久月光满，茶香峡水清。\n老来有深契，一笑足平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49341,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿胡宪公署中作 其二","author":"成鹫","text":"大道难久默，澹交宁羡浓。\n官衙初下榻，虚室自鸣钟。\n此地有生客，故山无老农。\n夜来作归梦，飞上最高峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49342,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"署中赠周季鹰刘山铭","author":"成鹫","text":"罢弹冯煖铗，言伴净名禅。\n真宰互相答，大虚中寂然。\n醇醪推大雅，藜火绍前贤。\n许我成三笑，相逢何处边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49343,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别胡宪公","author":"成鹫","text":"兴尽我当返，无劳怅路岐。\n田家新米熟，岁晚涤场时。\n此外复何事，怀人或有诗。\n相闻许相过，计日补茅茨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49344,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春姚明府见过即事六首 其一","author":"成鹫","text":"久懒不埽径，春风生绿苔。\n乍闻檐鹊语，知有贵人来。\n赤脚陪仙舄，黄童递茗杯。\n深言难草草，归棹莫频催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49345,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春姚明府见过即事六首 其二","author":"成鹫","text":"元日至谷日，高天无片云。\n野情逐农圃，努力事耕耘。\n城市远未远，春光分不分。\n荷锄待膏雨，搔首问东君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49346,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春姚明府见过即事六首 其三","author":"成鹫","text":"吏隐如禅隐，琴书当簿书。\n持将怀古意，来就野人居。\n竹老迟抽笋，泉寒未决渠。\n明朝春雨足，花下待篮舆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49347,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春姚明府见过即事六首 其四","author":"成鹫","text":"野寺山厨供，煎茶折露葵。\n清风生两腋，迂论解双颐。\n晚食君应饱，大烹吾岂知。\n莫嫌如水澹，冰檗恰相宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49348,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春姚明府见过即事六首 其五","author":"成鹫","text":"忆著去年别，曾将此日期。\n感君无宿诺，出我未呈诗。\n阳雪惭知己，岭云持赠谁。\n奚囊倾未尽，留待再来时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49349,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春姚明府见过即事六首 其六","author":"成鹫","text":"皎皎云边鹤，铮铮壁上琴。\n幽人称幽独，知己贵知心。\n许我一片石，随僧共入林。\n隔江招手处，相望在高深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49350,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南园梁又罙凌晨舟过大通留诗而去未及迎送即韵和之","author":"成鹫","text":"万事易知足，馀閒反类贪。\n僧犹甜鹤梦，客已渡鹅潭。\n柳暗不成五，径荒无复三。\n多君发归咏，留在破伽蓝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49351,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏莲漏限韵 其一","author":"成鹫","text":"圆音入清梵，池上有人来。\n刻作千华漏，承将九品台。\n细微通白业，馀润及青苔。\n莫道无源委，坳堂水一杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49352,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏莲漏限韵 其二","author":"成鹫","text":"脉脉割昏晓，明明无往来。\n土圭停昼影，钟乳滴华台。\n八水金沙地，千丝石发苔。\n凭谁问消息，沧海一浮杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49353,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答高裕公邑佐见寄韵","author":"成鹫","text":"隔水遥相见，清风若许长。\n全凭诗酒力，消遣簿书忙。\n大雅崇昭代，新声薄晚唐。\n野人扣牛角，为尔和康浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49354,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答梁弋云见过韵","author":"成鹫","text":"不于城市见，乃在水云边。\n我欲狂歌去，君来且驻船。\n雾深知豹变，泽媚识珠圆。\n珍重闻诗者，阳春莫浪传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49355,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮山三十咏 其一","author":"成鹫","text":"閒身初住铁桥东，回忆家山事事同。\n就树选藤增健仆，入林逢药慰衰翁。\n峰高岂碍当中日，谷静常来正面风。\n谁信岭云犹可赠，不堪持赠但长空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49356,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮山三十咏 其二","author":"成鹫","text":"洞门不掩有云封，土面灰头学老农。\n野菜盈筐因长笋，枯柴充担为怜松。\n地炉自种经旬火，水碓长留隔宿舂。\n莫道此间寡邻并，午斋风送远山钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49357,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮山三十咏 其三","author":"成鹫","text":"安居原不涉思惟，莫道吾宗也大奇。\n夙习未能遵世谛，虚名偏喜少人知。\n水边黄叶随流去，树里青山背日移。\n拾得一枝无孔笛，前人吹破不堪吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49358,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮山三十咏 其四","author":"成鹫","text":"年来得力是忘机，物外孤心渐入微。\n虫惜清声终夜语，鸟因昭质榜林飞。\n凭他风雨能侵席，到处晴阴不掩扉。\n半角好山谁作主，自怜临老始知归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49359,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]