[{"title":"重过姚约如是庵赏菊","author":"李孙宸","text":"初秋下榻留风雨，餐菊重来秋杪时。\n岁月已拚杯底过，芳菲犹喜眼中私。\n繁英不用编篱护，密叶从教傍砌披。\n自是秋光无早晚，还寻蓬径问花期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为李珏甫悼亡","author":"李孙宸","text":"遥忆安仁赋悼亡，断弦难听凤求凰。\n愁开绣幌窥秋月，懒卷珠帘任夜霜。\n梦里似闻归佩响，招来难觅返魂香。\n残机半就鸳鸯锦，不尽伤情拭泪行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋杪同邓伯乔郑宗礼集赵丕振园亭","author":"李孙宸","text":"选地为园小结庐，一邱亦自足樵渔。\n久缘意气同开社，岂为漂零赋卜居。\n丛竹渐含霜色冷，残荷犹傍晚凉舒。\n秋光容易留欢赏，宁遣高阳雅会虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花朝伍国开同其季弟有开见访旋为别席催去","author":"李孙宸","text":"宅枕清流一径斜，美人相过踏飞花。\n瑶林乍浥青霄露，玉树双披晓日霞。\n灵运旧曾誇令弟，孔融今喜识通家。\n烹葵未荐芳辰酒，容易分携隔水涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸卯秋杪还山作","author":"李孙宸","text":"摇落西风一敝裘，黄花犹及故园秋。\n归心正惬蒪鲈思，野性何妨鹿豕游。\n世路几人怜白璧，生涯聊自委沧洲。\n门前片石清流上，竟日高眠狎海鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长至后一日伍家珍伍国开见过","author":"李孙宸","text":"萧瑟残年自掩扉，可堪节候与心违。\n因逢梅树园边客，始觉阳春坐上归。\n贫病故人还共狎，交疏时俗任相非。\n藜羹且醉寒宵酒，莫待他时剡雪飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居得欧子建书寄答","author":"李孙宸","text":"琭玉斋中坐夜分，雄谈孤绝更无群。\n尔时肮脏高相许，此日漂零那可闻。\n梦后屋梁馀落月，愁来天外失停云。\n江乡腊近新醪熟，咫尺何缘一醉君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄怀方生伯情","author":"李孙宸","text":"少年白皙胜王昌，文藻风流更擅场。\n一自词坛逢少侠，愈令吾党有辉光。\n论交尚忆清秋月，握别俄惊白雁霜。\n赋就不堪摇落思，故人曾否念倡狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村斋雨后怀马伯起","author":"李孙宸","text":"高阳旧事可谁论，落落幽居但怆神。\n独夜有怀愁听雨，百年多病负逢春。\n槛梅欲结枝枝实，堤柳初萦缕缕新。\n物色风光俱可赋，祇怜孤唱易沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29102,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孟总戎生日新膺简命","author":"李孙宸","text":"万里提封建汉旌，貔貅千队振军声。\n风清海国春归马，雨过鲸鲵夜洗兵。\n简命即看黄钺重，烟霞宁忘赤松盟。\n歌钟日暮侯门宴，乞得金浆自露茎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29103,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿梁孝廉明一尊人六十","author":"李孙宸","text":"六十栖迟化日长，一区衡泌乐洋洋。\n岂凭服食留华发，自任鸿濛到上皇。\n遗少黄金籯不满，种多丹桂玉生香。\n会稽举案家声在，偕老人疑旧姓梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺丁大参晋秩掌宪","author":"李孙宸","text":"澄清万里肃冰壶，开府东南亦壮图。\n方岳旧臣仍鞅掌，宪台新命更专符。\n天连瘴海涛声静，地控罗浮岳色孤。\n计日东归怜绣衮，星辰三殿待追趋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"欧子建邓伯乔戴安仲黎有道诸子枉唁江村别后赋寄","author":"李孙宸","text":"苫块三春伏枕馀，庐前风木耐萧疏。\n山河未付支床骨，风雨谁来策素车。\n此日匪莪诗转废，十年捧檄事全虚。\n怜君易返剡溪棹，夜雪凄其涕满裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送从父于岳谒铨广文","author":"李孙宸","text":"十载文园自草玄，尘冠初拂领青毡。\n诸生都讲官非冷，三绝才名世所传。\n竹下吾家违笑语，芹宫何处奉櫜鞬。\n儒臣早晚多承宠，经术行看奏御前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顾别驾以谤解官与诸子饯之归吴","author":"李孙宸","text":"杨柳丝丝江水清，一尊送客怆离情。\n粤吟听似阳关调，吴曲翻馀子夜声。\n龙性久怜违浪迹，蛾眉一任妒时名。\n薜萝正喜还初服，知不重为泽畔行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽唐寅仲先生","author":"李孙宸","text":"处士星高越海隅，姓名长得借江湖。\n生无猿鹤移文怨，死有渔樵恨侣孤。\n事去千秋心顿折，鸿来两地眼堪枯。\n山河未邈人何在，肠断经过旧酒垆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日张彰之过访村居赋别","author":"李孙宸","text":"懒废幽栖性所偏，故人何意远相怜。\n居非戴子山阴道，访是王郎雪夜船。\n荔熟千林朝日映，荷香十里晚凉搴。\n风光未恶柴桑里，恨少平原十日缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"姚仲和以书币来为其亡兄姚约求传赋答","author":"李孙宸","text":"三春村落卧苫茨，尚忆莲池结社时。\n我自惨深乌鸟痛，君今谁问鹡鸰悲。\n延陵已许生前剑，有道宁辞死后碑。\n珍重惠连情好在，转因池草有馀思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得黄亮垣先生胪传之报","author":"李孙宸","text":"卿云缭绕散西清，圣主临轩策治平。\n一自句胪传内殿，居然声价重连城。\n衣冠重王千秋气，词赋群推一代盟。\n翻笑白莲同社客，风尘犹自系诸生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送区启图游金陵省其尊人官署","author":"李孙宸","text":"梅关春色望中微，送客看花旧帝畿。\n腊尽风霜随骑减，春来鸿雁向南稀。\n山凭牛首烟霞远，巷过乌衣燕子飞。\n览胜况无乡思促，花时应到访庭闱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春日述怀","author":"李孙宸","text":"一啸风尘三十过，浮生踪迹竟如何。\n已知幻世同蕉鹿，且拚幽怀洽薜萝。\n身贱故应人共弃，门荒兼少雀堪罗。\n今朝得荐春盘酒，醉倩阳春发浩歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春后二日尝新酒贻诸同社","author":"李孙宸","text":"晓看风物媚吾庐，又觉春回两日馀。\n迁树莺雏犹怯啭，傍檐桃蕊已纷舒。\n惊心岁月劳劳过，屈指交游事事虚。\n赖是槽床新酿熟，可能相过共踟躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灯夕寄怀伍国开有开","author":"李孙宸","text":"十里烟花翠欲浮，试灯频逐少年游。\n共怜解赠江滨佩，不尽相逢南陌头。\n缓夜笙歌方未已，撩人春恨可谁由。\n清欢不尽君同醉，梦绕驼山第几楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答谢西粤宪副邓存宇先生","author":"李孙宸","text":"西来书劄慰寒温，感激空馀涕泪痕。\n人向夷门身未老，歌翻易水剑犹存。\n新贻杂佩江篱结，旧种甘棠雨露繁。\n国士肝肠吾欲写，春风桃李自无言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿毛隐君","author":"李孙宸","text":"当年彩笔气如虹，老去逃虚万累空。\n异骨鸡群看独鹤，旷怀人外托冥鸿。\n瑶池桃结千年实，玉井花开十丈红。\n称寿正当清夏日，南薰长挹五弦风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送蔡明府升南工部","author":"李孙宸","text":"才子吴兴夙擅奇，还从制锦见清词。\n风尘愧我埋名日，月旦怜君校士时。\n水部声名兰是省，炎州惠续口为碑。\n浮萍聚散宁须问，后会人生总未期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日同诸子游飞驼山","author":"李孙宸","text":"深秋野外足烟萝，佳节招寻共踏歌。\n客有清狂同落帽，山看形势拟飞驼。\n云连远树千峰合，水落平田独雁过。\n容易插萸兄弟会，尊前沈醉且蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居感怀寄羊城诸旧好","author":"李孙宸","text":"避人聊自掩柴荆，尚忆风尘客舍情。\n一别漂零秋已老，寸心愁绝雁初声。\n幽居欲著玄经草，旧业空惭白社盟。\n独抱龙泉望霄汉，犹馀紫气夜纵横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜伍国开有开同天竺上人过宿小楼","author":"李孙宸","text":"窗外梅花映雪枝，小楼清坐二更时。\n谈玄稍藉支公偈，玩月无如小谢诗。\n幽赏共披尘外语，深盟宁负酒中期。\n南州不是陈蕃榻，何物能邀孺子私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄欧子建邓伯乔二子","author":"李孙宸","text":"十年莲社共荷衣，一别风尘万事违。\n颉颃尔应齐雁羽，漂零吾自愧雄飞。\n梅花带雪攀应满，瑶草含霜拾渐稀。\n为念山中栖隐意，好乘春水访渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伍国开斋中与诸子分赋怀五岳诗予得恒山","author":"李孙宸","text":"恒岳高凭北极天，泠泠寒色万峰悬。\n下临晋代山川尽，远瞩滹沱海势连。\n服食千年传异草，有无今日是玄泉。\n浪游亦有卢敖杖，婚嫁真怜负胜缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元日独酌","author":"李孙宸","text":"晓日曈曈媚远天，暖云和烟更油然。\n陇梅已破残腊放，谷鸟初趁条风迁。\n岁月一任隙驹过，姓名何用世人传。\n柏尊有酒吾自倒，醉后得趣任高眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄太史亮垣先生还期","author":"李孙宸","text":"春潮起色大江平，裘马乘春又远行。\n望入彩霞淩玉笋，朝回仙露赐金茎。\n衣冠气旧瞻南海，案篆班新侍太清。\n敢道弹冠王贡事，沈冥吾已谢时名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同俞子旦及其季弟子奭过驼山访戴伍二子山馆","author":"李孙宸","text":"春游不觉路逶迤，野外烟霞面面垂。\n花气暖蒸晴日雨，柳条低飏晚风丝。\n开尊地僻柴门静，把臂谈深竹影移。\n最是弟兄怜臭味，况逢侠少得新知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闰三月同俞子奭诸子游驼山晚归","author":"李孙宸","text":"自是东皇爱暮春，不教九十尽芳晨。\n看花偶逐同心侣，问竹因逢把臂人。\n黄鸟隔林啼尚涩，青山濯雨黛逾新。\n春风莫讶归途晚，赢得诗情共醉论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游观音岩","author":"李孙宸","text":"石床千尺倚云根，小有清虚敞洞门。\n风雨不惊龙卧稳，烟霞长护佛坛尊。\n云封鸟道才穿径，日落人家别有村。\n何事杖藜天外去，尽饶方内足攀援。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送郑我淳署教潮州","author":"李孙宸","text":"君才三绝早知名，不忝风流旧郑生。\n列宿向高东鲁望，一珠还傍日南明。\n横经未厌毡为席，览德惟应凤作城。\n莫恋成溪春色好，彩毫方待赋西京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"驼山冷翠亭为伍国开赋 其一","author":"李孙宸","text":"虚亭遥上翠微边，水石周遭地自偏。\n倚剑群峰来雪色，落霞环翠到窗前。\n薜萝豫长他年服，松竹初开小有天。\n便可容吾高枕得，与君聊结避人缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"驼山冷翠亭为伍国开赋 其二","author":"李孙宸","text":"落霞山下结茆庐，疏散真宜避世居。\n槛外疏篁新护植，阶前荒蔓颇芟除。\n问奇过客频携酒，闭户閒人但著书。\n赋就淮南丛桂句，小山招隐意何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"驼山冷翠亭为伍国开赋 其三","author":"李孙宸","text":"萧森别似武陵源，竹叶桃花古洞门。\n避俗未论秦氏隐，逃虚聊隔世人喧。\n白云过户时留润，碧沼浇畦渐耗痕。\n一事无营心即水，翛然宁复碍乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"驼山冷翠亭为伍国开赋 其四","author":"李孙宸","text":"倚剑峰头乱石蹲，烟霞半入野人村。\n荒榛久待吾曹辟，丘壑应怜尔道尊。\n鸟篆閒扪萝径识，松涛时向石床翻。\n只今且说高阳会，白雪留他异代论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"驼山冷翠亭为伍国开赋 其五","author":"李孙宸","text":"江村何必异蓬莱，竹里疏棂面面开。\n雨后花光疑幻出，峰前山势欲飞来。\n眠高自稳青萝石，眺远频呼浊酒杯。\n草就太玄嘲懒解，汉庭谁识子云才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仲秋十二夜戴公纶何龙友过宿小楼","author":"李孙宸","text":"楼前一雨过虚堂，忽有凉飔洒客裳。\n抱病经时人事减，因君此夕野情长。\n渐怜蟾影分秋色，愁听砧声捣夜霜。\n坐久天河浑欲曙，惊呼早雁不成行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋诸子过集迟何戴伍三子不至","author":"李孙宸","text":"蒹葭秋色夜萧然，白苧歌残思未捐。\n华烛半含兰焰吐，浊醪暗倩桂香传。\n群星未尽人间会，片月空怜海上圆。\n露下天阶浑似水，分明清梦绕婵娟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答公纶襄武二子石门舟中见怀","author":"李孙宸","text":"风生江上雁行斜，高枕怀人思未涯。\n兴儗山阴飞夜雪，梦悬东阁赋梅花。\n风尘不定孤蓬迹，岁月还伤两鬓华。\n酒态诗情俱好在，莫教轻负故罗葩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饮何隐君西畴别业","author":"李孙宸","text":"青梧翠竹绕回塘，别有风光在草堂。\n百亩无如沮溺稳，诸贤谁是阮稽狂。\n篱边菊蕊迟秋色，槛外山光到夕阳。\n遮莫尊前誇一石，如坭拚付酒人傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高柳新蝉","author":"李孙宸","text":"柳变园林拂暖丝，新蝉初咽最高枝。\n寻条未定吟风处，翳叶宁妨饮露时。\n摇扬乍飘宫里鬓，凄清如恋画前眉。\n豫怜朔吹惊寒后，撩乱章台竞噪迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邓伯乔万伯文欧子建李烟客诸子游罗浮怅余不及从也诗以讯之","author":"李孙宸","text":"矫首朱明洞里仙，十年清梦隔钧天。\n观留葛稚烧丹灶，池自麻姑长白莲。\n桑海山家仍岁月，壑舟人代几风烟。\n输君此日探奇赏，婚嫁宁终负此缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得清怨","author":"李孙宸","text":"脉脉幽情欲诉谁，旧怀新恨总难追。\n花前有约寒盟后，梦里成欢乍醒时。\n夜雨孤窗风自掩，春残虚幌月深垂。\n芳心未分同流水，多恐韶华易旧期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29142,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为何起时赠陶伯友新冠","author":"李孙宸","text":"久从传粉忆清欢，年少风流世共看。\n闻道有车仍掷果，遥知新沐正弹冠。\n春花迎露香逾媚，丝柳笼烟弱更寒。\n莫漫离尘高自倚，暮江还欲采幽兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29143,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何公子之西粤阳朔觐省","author":"李孙宸","text":"苍梧西望白云寒，此去庭闱彩袖宽。\n三百滩声喧过掉，万重山色入征鞍。\n涉江定解湘妃佩，访古应寻葛令丹。\n记取离鸾弦上曲，趋庭閒听署中弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29144,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄讯从父于岳感恩司训","author":"李孙宸","text":"登楼春色望漫漫，紫气朱崖万里宽。\n家远最怜三载别，官閒仍拥一毡寒。\n黎蛮岛外章缝地，桃李丛中苜蓿盘。\n风韵竹林俱正好，一枝吾愧谢家兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29145,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日过伍国开有开与家珍家宝诸从同集","author":"李孙宸","text":"竹下招携意转亲，开尊况复是芳辰。\n百年未老烟霞骨，七日能同海国春。\n共逐香尘群少侠，谁迟芳草待佳人。\n灯前解惜金花胜，便可同君醉浃旬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29146,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过伍家珍结云楼因赠","author":"李孙宸","text":"小结山楼半岭欹，千盘磴道绕逶迤。\n十年混俗劳生过，一日皈心习静时。\n伏枕每高朝日影，焚香时惬白云期。\n幽居礼数从君简，莫讶元龙湖海姿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29147,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈子明托病谢客秋日同诸子过访","author":"李孙宸","text":"清溪曲曲绕茅庐，客自栖真苦著书。\n乍可我乘剡曲舫，更堪谁过草玄居。\n凉秋未拟观涛赋，生计惟挥种秫锄。\n晚月在松天在水，林塘相对领清虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29148,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠淯水刘公 其一","author":"李孙宸","text":"吴楚才名自国工，长杨一赋气何雄。\n从知骏骨高燕市，未信蛾眉妒汉宫。\n多暇鸣琴调独鹤，有时把剑望双虹。\n青云莫道轻相附，不尽论文意气中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29149,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠淯水刘公 其二","author":"李孙宸","text":"才子南迁名转高，乍逢意气感绨袍。\n宦情淡泊宁鸡肋，宪府萧閒亦马曹。\n节驻春城看过雨，梦回兰署待挥毫。\n香清茶熟官衙暮，尚有词人载浊醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29150,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈子明同伍有开兄弟过宿眺霞楼重赋言别","author":"李孙宸","text":"踟蹰临发驻行舟，握手还堪信宿留。\n未论平原欢十日，居然下榻见千秋。\n雄心共按青萍赠，末路人疑白璧投。\n击缺唾壶君莫笑，丈夫宁作别离愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29151,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮送俞子旦还里因订五羊之约","author":"李孙宸","text":"江村暮色正萧然，月在澄江水在天。\n投分两年莲社约，销魂今日木兰船。\n梅花腊近含情待，菊蕊寒深著意妍。\n期尔穗城春色好，相逢应在百花前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29152,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日黎君献黄逢永邓升仲见过池亭留宿夜谈","author":"李孙宸","text":"闭门长夏听黄鹂，竹下相留晚更宜。\n玄赏十年怜臭味，高谈一夕见襟期。\n青萍竟为何人合，白雪还应和客知。\n兴剧与君拚酩酊，不妨人唤习家池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29153,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠黄逢永","author":"李孙宸","text":"赋才江夏自家声，第五还高骠骑名。\n一出词坛倾左席，居然斯道破坚城。\n神交已见双龙合，星聚应占百里明。\n屈指生平俱汗漫，尊前那惜更纵横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29154,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟过望匡庐作","author":"李孙宸","text":"仙都万仞接蓬莱，秀结芙蓉面面开。\n五老云霞空外举，九江风雨望中回。\n洞传白鹿今谁主，社辟东林几客来。\n自笑生平耽胜赏，翻从眼底负登台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29155,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]