[{"title":"洪氏池亭留酌","author":"邱云霄","text":"拙拙抱忠信，依依爱泉林。\n行行随所之，处处逢知心。\n偶上君家池，池水清且深。\n主人出敬客，欢爱同夙襟。\n享我亭下酒，乐我池上琴。\n感子意悁勤，不知日欲沉。\n古人一饭恩，此义留至今。\n知君不愿报，感激好贤吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洪塘有怀云山寺诸友","author":"邱云霄","text":"久客将归日，初程望故乡。\n海天南下阔，江水北来长。\n历历秋应尽，苍苍月弄黄。\n别来忆三益，疏竹护僧堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"平水作","author":"邱云霄","text":"千里一归帆，九秋十日尽。\n野火江上明，渔歌夜相应。\n徘徊山月孤，萧飒林风振。\n羌篴何处声，度船起清听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕","author":"邱云霄","text":"爆竹通宵尽，灯花隔岁开。\n长江流日月，残腊恋尊罍。\n千里独归梦，三山几度来。\n况逢阳长日，数问鬓毛催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"斋居书事","author":"邱云霄","text":"宦况怜今夕，孤怀傲世尘。\n溪山足吏隐，苜蓿长园春。\n昼静云移榻，阶閒雀近人。\n古来毡亦冷，聊尔遂吾真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓行","author":"邱云霄","text":"秋意动禾黍，山风稻欲花。\n疏星下平野，晓树散晴霞。\n尘世惭奔走，江流逐岁华。\n道穷堪薄禄，目断白云赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石佛岭","author":"邱云霄","text":"漫忆重游地，空悲逐世纷。\n野花低受露，斜树半迎曛。\n石磴回青嶂，肩舆度翠云。\n举头惭老衲，依旧坐江濆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿堰首","author":"邱云霄","text":"烟火成村晚，溪声送簟凉。\n心閒无鹿梦，水落见鱼梁。\n窗宿山云湿，苔荒石径藏。\n偶来公憩静，庭树想甘棠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"裕溪","author":"邱云霄","text":"日抱湥云午不骄，芦花飞雪暗溪桥。\n数家烟火自村落，随处山林傲市朝。\n习静空亭驯野鸟，忘机分席对山樵。\n却因话到桑麻乐，惭愧浮名鬓欲萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"括苍道中 其一","author":"邱云霄","text":"清世谁能蚤息机，欲将疏放问耕犁。\n浮沉世事看流水，惆怅西风过裕溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"括苍道中 其二","author":"邱云霄","text":"山泉脉脉野田平，唤雨林鸠处处呜。\n满地秋风催黍稌，月明犹听桔槔声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"括苍道中 其三","author":"邱云霄","text":"短篱疏竹入田家，石径山桥傍水斜。\n闻说前溪夜来雨，晓风争发木绵花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"堰首哭叶秀才","author":"邱云霄","text":"剧谈疏阔想通儒，鸡黍空怀笑语初。\n一去云寰归独鹤，重来茅屋有残书。\n青云潦倒遗双剑，白帻凄凉旧短锄。\n憔悴碧山寒欲瘦，秋风堰上一沾裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠叶云岩 其一","author":"邱云霄","text":"炉封玉鼎火初残，月满岩扃夜不关。\n斜枕参同迷晓蝶，碧云幌落石床寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠叶云岩 其二","author":"邱云霄","text":"曾仗双龙肃世氛，嫖姚不数霍将军。\n归来相问封侯事，笑指岩头飞白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈凤冈教授岷府便道归闽","author":"邱云霄","text":"秋入关河别梦惊，寒尊撩乱故乡情。\n海天云树三山出，湘泽烟波万里平。\n雀舫月明青简重，龙泉斗转紫光横。\n圣朝蚤晚应虚席，国体还须问贾生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南明山","author":"邱云霄","text":"山寺寻秋度玉溪，石梁斜日下松枝。\n摩挲残碣抚遗迹，剥落前朝字半疑。\n池静浴波山月小，洞閒归晚野云迟。\n逢人久懒通名姓，来去林僧总不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日何氏江楼","author":"邱云霄","text":"江楼疏雨报重阳，秋逐林光过短墙。\n野馆独怜长作客，篱花空负几回黄。\n深尊天畔惭陶醉，斜帽风前学楚狂。\n荏苒岁华双短鬓，青山不语笑人忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"裕溪与袁省庵萧东冈二寮长夜话","author":"邱云霄","text":"别馆斜阳外，山桥野水头。\n溪声寒入夜，林色晚横秋。\n尘世悲萍合，浮生是梦游。\n道穷怜白发，何处问沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游南岩同王景宁胡松阳 其一","author":"邱云霄","text":"古寺孤峰出，千林秋气横。\n野云栖玉节，山鬼避文旌。\n百仞双凫落，诸天列宿明。\n咏归松径暝，灯火动江城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游南岩同王景宁胡松阳 其二","author":"邱云霄","text":"逸兴秋旻上，移尊扫石屏。\n日回千嶂夕，云抱半山亭。\n孤柱擎幽壑，疏松结翠棂。\n林深贪一梦，恐犯夜堂星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南岩次胡明府韵兼呈周曲塘经府","author":"邱云霄","text":"远随飞舄度溪南，路转诸天控鹤骖。\n自是林塘招吏隐，喜逢野衲悟禅参。\n悬厓石柱依残照，隔水山城带夕岚。\n懒向浮名竞驰逐，烟霞自笑亦成贪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题竹杖化龙图","author":"邱云霄","text":"昔日长房有仙骨，兴落壶公白云窟。\n别时相赠绿玉杖，骑度青山梦恍惚。\n归来投杖葛陂去，烟波浩渺灵光发。\n回惊天际翻玉涛，神龙隐隐云端没。\n吁嗟数尺青琅玕，根缠风雪生光寒。\n异物自有鬼神护，终当远去非人间。\n织梭入网无人识，雷雨晦暝起空壁。\n丰城宝剑出狱中，一跃延津云气黑。\n由来变化多如此，费公竹杖何须惜。\n君不见南阳有卧龙，草庐未顾居人群。\n又不见傅岩之版筑，起向商家作霖雨。\n信是人龙自有真，尘埃物色竟何人。\n达人隐头角，独抱阳之精。\n屈信顺化理，呼吸生风云。\n绘工未必能图画，直令千古照汗青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚出括苍城","author":"邱云霄","text":"北风吹夕阳，驱车出城郭。\n百草委明霜，野烧寒烟簿。\n徬徨事上官，古道多荆柞。\n低头褰衣裳，举头见飞鹊。\n明星濯天河，风击松子落。\n白云结青山，悠然怀故国。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"发堰上","author":"邱云霄","text":"寒光弄熹微，征夫戒晨炊。\n出门风雨交，结束登前涂。\n孤村散烟火，野店开户枢。\n朔风割人肌，泥泞沾我裾。\n石磴悬幽潭，履危念微躯。\n浮名逐朝烟，短发感隙驹。\n羡彼林上禽，枝息鸣呴呴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游三岩","author":"邱云霄","text":"野晴欣出郭，幽探入萝烟。\n诸洞虚分白，三岩势欲悬。\n晴云长结雨，寒石暗通泉。\n爱此深冬草，青青池水边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中访徐龙阳留酌","author":"邱云霄","text":"骑马雪中去，仙家醉不还。\n何时菊酒熟，重得访金丹。\n寻仙白龙洞，坐我苍玉屏。\n归来醉恍惚，记得参同经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"溪月初出水","author":"邱云霄","text":"溪月初出水，照我清夜堂。\n沈忧不成寐，踟蹰步寒光。\n飞乌深夜号，绕树林烟苍。\n有怀空自知，默默心摧伤。\n白云一何遥，青山一何长。\n颓然倚脩竹，泪洒双琳琅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长风自天来","author":"邱云霄","text":"长风自天来，冉冉吹我怀。\n有怀苦蕴结，长风吹不开。\n人生怀至愿，遐迩骨肉偕。\n野草引蔓长，犹能蔽根荄。\n如何荡游子，摇落天一涯。\n伤哉晨与夕，生死永隔乖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"枯木发春华","author":"邱云霄","text":"枯木发春华，言念去日驰。\n百年一何促，决别无重期。\n所以君子心，依依重暌离。\n零雨不到天，飘花不上枝。\n物感怀有生，沉抱空自知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清清池中水","author":"邱云霄","text":"清清池中水，剌剌花间棘。\n蔓棘薪见收，池水人不汲。\n物情结吁感，幽抱徒叹息。\n岂不念蹇窘，但恐伤衷赤。\n安期服寸蒲，王孙美丈食。\n由来各所安，相逢不相易。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"毛隐仙画像歌","author":"邱云霄","text":"君不见长松山中有真隐，霞结幽栖云径暝。\n我欲寻之不可见，丹青忽得仙人影。\n紫髯玄眉鬓绿毛，颜如丹渥骨格高。\n神姿自与俗人异，青兰佩照芙蓉袍。\n牙签玉轴付儿孙，丹诀青囊理怀抱。\n兴来孤往仍独还，布袜青鞋遍酉夘。\n间采蓬莱芝，更拾瑶池草。\n石床明月梦羲皇，笑指尘区容易老。\n我亦住白云，托身武夷岛。\n偶来尘市伤枯槁，愿与仙人探鸿宝。\n仙人在何处，胡麻酒熟春风醉。\n感像发长歌，我向山中去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"对雪","author":"邱云霄","text":"僵卧闭湥户，端居拥短裘。\n同云千嶂合，朔气六霙投。\n带雨完偏损，牵风落仍浮。\n轻盈怜舞态，消没似娇羞。\n柳絮惊三月，蓬壶梦十洲。\n无情窥户牖，随意度帘钩。\n野径行应断，长江湛不流。\n远征愁堕指，老去感搔头。\n扫径情偏懒，烹茶兴不侔。\n新诗怀蹇骑，狂叫喜登楼。\n秋月迷清昼，天河洗赤陬。\n影沉知过鹭，声起得眠鸥。\n凛凛为谁烈，飘飘不自由。\n暂因留市郭，终只恋林丘。\n阴极亨阳德，光寒夺夜篝。\n终为江海泽，不作沼池沤。\n直拟山川重，应贻鸟鼠愁。\n太平先有象，孤淡傲无俦。\n玄兔迷湥穴，苍鹰懒下鞲。\n梅姿争自媚，柳脆怯枝柔。\n隐几怀中立，浮槎忆子猷。\n欲披王氏氅，更泛剡溪舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将归书壁","author":"邱云霄","text":"树影移斋日渐高，寒花初放出墙梢。\n莫言去后空培植，长有春风吹碧桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"紫荆台别袁萧二寮长","author":"邱云霄","text":"今年花发去年丛，新主怜非旧主翁。\n此日看花与君别，明年花下又谁同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"昼坐","author":"邱云霄","text":"小池红雨乱，曲径绿云生。\n白日相过少，春风似有情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜坐","author":"邱云霄","text":"帘捲流萤入，窗虚碧月来。\n据床罢书卷，独上露华台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画白鹰","author":"邱云霄","text":"华堂锦鞲双缨红，栖息孤鹰倦飞越。\n羽毛脩洁世所稀，无乃开元贡天阙。\n纵横碧落原野空，罢猎归疑带霜雪。\n不将饥饱向人啼，长怀搏击为君悦。\n回首长风势欲飞，谁人为解青绦结。\n戢翮游精意气閒，惊狐伏兔心胆裂。\n莫言爪距杀气粗，有时解变春鸠拙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题友筠卷","author":"邱云霄","text":"避俗真成癖，交情独此君。\n开尊香滴露，倚榻翠留云。\n晚节风霜外，閒心日月分。\n捲帘疏影落，长为扫尘氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏柏亭赠新都汪子","author":"邱云霄","text":"江郎好文雅，去作柏亭仙。\n结欢四海士，俱赠云霞篇。\n我本方瞳翁，芳栖武夷巅。\n久无青琐梦，长抱白云眠。\n感子丹青图，发歌声琅然。\n茅楹跨石冈，古木深缠绵。\n幽枝拂翠幌，远色摩苍天。\n山鸟下石梁，林风驱游烟。\n时有高人至，奏弄同心弦。\n世缘苦未断，抚剑怀孤骞。\n何当与子期，拟拂松萝鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"道中","author":"邱云霄","text":"曹岭原通荆岭原，小梅村过大梅村。\n落花带雨莺初歇，芳草愁人日欲昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江上晓发","author":"邱云霄","text":"疏雨打蓬声不灭，寒风吹江水欲绝。\n野寺僧敲五夜钟，船窗晓见千山雪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"见梅","author":"邱云霄","text":"忆昔游子初辞家，柳未舒荣桃未华。\n一去天涯不知岁，江边又见寒梅花。\n梅花半开复半落，行人东去海之角。\n空山落日云正愁，世路悠悠行未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"关外寄所知","author":"邱云霄","text":"芳草征车莫，新莺到处闻。\n路从关口别，水向岭头分。\n红日初收雨，青山半隐云。\n独怜双短鬓，万里谒明君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观音岩 其一","author":"邱云霄","text":"蓬岛人间隔，夫容天上开。\n清游疑梦寐，白日换形骸。\n窈窕萦霞磴，参差结玉台。\n幽探千嶂夕，尘世几人来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观音岩 其二","author":"邱云霄","text":"造化输神巧，乾坤失画图。\n风光驱雁宕，寒翠落鹅湖。\n古洞回元气，凌虚想太初。\n顿令簪绂薄，欲结白云庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"河口别于功弟","author":"邱云霄","text":"帆依细雨春江迥，雁落前沙夜影寒。\n万里风烟归计晚，一天云水别情难。\n惊心时拂双长剑，入梦频携九曲竿。\n何处春山堪采杞，关门望断白云团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过信州祥符寺","author":"邱云霄","text":"一径桥西古寺回，重来漫忆读书台。\n惊心二十年前事，只有春棠似旧开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉别江午坡宗师二十韵","author":"邱云霄","text":"北斗瞻依旧，西风汗漫游。\n芗溪秋水外，寒夜月槎浮。\n笑语疑春梦，杯盘续暮篝。\n开亭惭下榻，去国羡垂钩。\n礼乐风闽楚，师模仰泰丘。\n弥文裁后进，明抱在先忧。\n秉法成萋斐，怀忠不自谋。\n孤臣危远道，万乘布洪休。\n山水元无恙，烟霞合有俦。\n陶开三径地，范泛五湖舟。\n谢客无过骑，呼童早放牛。\n登堂招舞鹤，倚槛下驯鸥。\n青草池边句，香芸架上筹。\n寻真苍玉杖，拥雪白云裘。\n兰佩重薰袭，樗材漫见收。\n子瞻元靡匹，永叔感前修。\n直彻形骸隔，惭非气味投。\n移尊频洗酌，待月更登楼。\n杨柳疏烟晚，林塘细雨秋。\n可堪莺谷别，不断象山流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沙溪铺晚泊","author":"邱云霄","text":"初晴江落见沙痕，断浦寒舂近莫村。\n闽岭烟斜春树重，楚江风静夜云屯。\n独怜岁月心难变，短发江湖忧自存。\n何处故乡频问伴，白云遥指是关门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明","author":"邱云霄","text":"寒烟细柳暗前津，客路清明倍怆神。\n故国云天双去鸟，满船风雨远行人。\n流横通济山桥晚，关入岑阳陂水春。\n黄叶林头有归梦，沧江回首一沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉山访陈太鹤不见留此","author":"邱云霄","text":"为问青田子，峰看太鹤寒。\n著书深闭户，谢客懒弹冠。\n声律归陈玉，风流笑谢安。\n诗传题凤意，客棹渺龙滩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀玉驿别周年侄邦俊","author":"邱云霄","text":"怀玉山前路，相惊梦里逢。\n三年京国别，此日阮途穷。\n挟策怀君阙，交情想父风。\n青云看奋鹗，白发愧非熊。\n日月双龙剑，乾坤一鸟笼。\n临岐烟柳外，回首莫江东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"发桐庐","author":"邱云霄","text":"残月依林堕，寒蛩近晓鸣。\n远潮传海曙，鸣柝护楼更。\n画鹢缘江白，樯乌掠雾轻。\n桐江垂钓者，应笑重浮名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"富春驿","author":"邱云霄","text":"寒浦樯乌集，烟汀宿鹭投。\n富春江上驿，落日客边愁。\n吴越双流外，乾坤一叶浮。\n孤征频望斗，明月满严州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西湖","author":"邱云霄","text":"花到飘零春寂寥，新荷欲发不成条。\n孤山香断青梅老，别浦歌繁画舫遥。\n林影翠重迷梵宇，湖光云净荡兰苕。\n长堤斜日还深历，柳外莺啼第六桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴山","author":"邱云霄","text":"城抱吴山出，皇都宋运催。\n湖光春霭乱，江色晚潮来。\n梵刹朱轮转，鸤夷古殿开。\n幽探成怆恍，愁倚夕阳台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别沈霞川","author":"邱云霄","text":"昔别惊春梦，还来问草堂。\n竹依楼榭直，荷抱石台长。\n剪烛谈深雨，迟樽坐夜凉。\n晓云劳极目，帆影度河梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"霞川草堂","author":"邱云霄","text":"径转霞栖逗，门临川水平。\n狎鸥游处静，飞鹜落边明。\n入酌浮春艳，垂缨濯晚晴。\n却怜忧国梦，时逐五云横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湖上作","author":"邱云霄","text":"落日清籁鸣，湖烟散如带。\n碧波荡绿萍，纵迹倏已改。\n幽抱空自知，流光为谁待。\n白云飞满天，南关何处在。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏月","author":"邱云霄","text":"影冒山河出，光分斗汉微。\n愁添双杵乱，鸿带数声归。\n歌舞高楼近，关山古塞违。\n不堪江夜寂，何事故清辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湖州村舍","author":"邱云霄","text":"山静长无客，春深尚有花。\n疏林依转径，落日趁归槎。\n才薄儒称愧，云飞帝里赊。\n新蒲堪结绿，不与系年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"莫春虎丘第三泉亭子呈同游诸公","author":"邱云霄","text":"新试单衣迥自宜，幽探况是踏青时。\n长堤烟暖莎初密，碧水晴娇柳欲垂。\n人去云深听法座，客来风满舞雩枝。\n山泉休许同清洌，题品无心托世知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登浮屠绝顶","author":"邱云霄","text":"天上疑应近，人间语不闻。\n影悬愁度鸟，光落压流云。\n平野三吴合，清渠几道分。\n烟花睥睨没，春色漫成文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]