[{"title":"泊河口却寄林医士二首 其一","author":"边贡","text":"杏子成林竹护墙，傍河云物昼苍苍。\n园中似是林家屋，过客时闻药草香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18295,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泊河口却寄林医士二首 其二","author":"边贡","text":"凶年老稚多奇病，吉水仙人有妙方。\n不用相逢问名字，满城人说是医王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18296,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"孙塘秀才以芍药二枝见赠走笔奉谢 其一","author":"边贡","text":"芍药开时三月过，京华五月见犹多。\n云栽露种元相异，雨骤风狂奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18297,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"孙塘秀才以芍药二枝见赠走笔奉谢 其二","author":"边贡","text":"长安日日走尘沙，春尽多时不见花。\n蒲州公子能相送，醉倒东山处士家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18298,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠杨抚军","author":"边贡","text":"白马香风度落花，绛桃秾李避妍华。\n长安陌上归来晚，笑指龙楼是外家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18299,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五月六日柬孔倅","author":"边贡","text":"艾家河边蒲叶长，扁舟昨日过端阳。\n荆南客路千馀里，回首铜台亦故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18300,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金陵逢方日升","author":"边贡","text":"燕市分携十七春，白门相见白头新。\n凤凰楼畔含香侣，江海飘零有几人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18301,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东园徐君送藕栽戏呈短句兼求碧桃","author":"边贡","text":"玉藕根移玉井高，感君分赠谢君劳。\n书生见惯秋江色，且向名园问碧桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18302,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题扇寄钱画士","author":"边贡","text":"睡起看图气未降，丹青谁有笔如杠。\n欲烦画我茅亭下，静数飞帆涉大江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18303,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"睡起口号戏呈黎仰止","author":"边贡","text":"两家儿女对船窗，学语真同乳燕双。\n日午梦回成一莞，不知身世在清江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18304,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题菊赠俞国声归无锡次韵","author":"边贡","text":"远携尊酒惠山来，梦草情牵对月杯。\n云际忍听双雁别，水边愁见一帆开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18305,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄吕思泉次韵","author":"边贡","text":"京国论交记往年，城南风景梦依然。\n春江未卜看花地，秋水空歌伐木篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18306,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵梧山中丞寄别东塘侍史八首 其一","author":"边贡","text":"宋台梁馆暮霜馀，野色苍茫拥使车。\n马首不随南去雁，袖中元有北征书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18307,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵梧山中丞寄别东塘侍史八首 其二","author":"边贡","text":"岸苇萧萧河水寒，骄嘶骢马鞴银鞍。\n燕山代谷飞腾过，送别无歌行路难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18308,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵梧山中丞寄别东塘侍史八首 其三","author":"边贡","text":"行部能教阴雨晴，渡河还遣浊流清。\n愿磨中岳山头石，记取西江御史名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18309,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵梧山中丞寄别东塘侍史八首 其四","author":"边贡","text":"漫怀家庆感晨昏，国士须凭国士论。\n闻道阿翁将阿母，花间长日醉清樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18310,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵梧山中丞寄别东塘侍史八首 其五","author":"边贡","text":"谏草书残驿舍灯，翠华冲雪恐难胜。\n回轺莫向春明路，见说君王在白登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18311,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵梧山中丞寄别东塘侍史八首 其六","author":"边贡","text":"羽盖飘飖白日临，回光应烛小臣心。\n愿同汲黯留中闼，更拟相如赋上林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18312,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵梧山中丞寄别东塘侍史八首 其七","author":"边贡","text":"每逢朝客转惊神，北望长安几侧身。\n紫禁烟花夹城柳，别来今已十番春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18313,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵梧山中丞寄别东塘侍史八首 其八","author":"边贡","text":"闪闪龙旗树五更，煌煌芝火照层城。\n当年奉引趋蹡地，曾听钧天广乐声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18314,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柬马公顺同年","author":"边贡","text":"三载风尘一见难，每将书札报平安。\n梁园幸是同官地，春月春花却自看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18315,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"颜声寅长惠川扇","author":"边贡","text":"蜀玺离离金错光，远随骢马过秦梁。\n奉持敢作寻常看，一道清风五月霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18316,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄何仲默","author":"边贡","text":"梁王台前春草生，梁王台上鸟嘤嘤。\n美人遥在黄金屋，客子登临空复情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18317,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠长垣宗室二首 其一","author":"边贡","text":"鸟语深宫白日斜，彩毫浓墨散春霞。\n王孙不学雕虫技，只写忠花与孝花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18318,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠长垣宗室二首 其二","author":"边贡","text":"瑶室青编万卷馀，宫中谁道日閒居。\n家臣昨夜长安去，犹问君王乞秘书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18319,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重赠吴国宾","author":"边贡","text":"汉江明月照归人，万里秋风一叶身。\n休把客衣轻浣濯，此中犹有帝京尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18320,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄闾卫之同府二首 其一","author":"边贡","text":"客来君寄一双鱼，客去还君一纸书。\n欲买扁舟向东下，洞庭春浪近何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18321,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄闾卫之同府二首 其二","author":"边贡","text":"江上逢君感昔年，往来相见陆陵前。\n那知宦迹如萍梗，犹得相依一水边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18322,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄京师友人","author":"边贡","text":"同朝同寺十年情，迢递燕山隔楚城。\n一别天涯今万里，欲从何处望春明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18323,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠阮翁三首 其一","author":"边贡","text":"跃马横戈老尚堪，时时游猎过龙潭。\n遥知此日非熊兆，不在周南在汉南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18324,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠阮翁三首 其二","author":"边贡","text":"鹤发虬须八十龄，白头长对岘山青。\n朝来虎帐看云坐，閒课诸孙读武经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18325,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠阮翁三首 其三","author":"边贡","text":"眉际生毫似发长，采苓时到白云乡。\n閒来莫向桃源去，恐有渔人识阮郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18326,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜宿太常官舍怀元佐二首 其二","author":"边贡","text":"文园消息近如何，酒盏生疏药裹多。\n却向故山忆旧隐，膏肓从古在烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18327,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荅秦孟阳长史次韵 其一","author":"边贡","text":"长镵秋圃自锄荒，望入高山路渺茫。\n不信爱莲亭子上，有人白日到羲皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18328,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荅秦孟阳长史次韵 其二","author":"边贡","text":"尘满纱帷旧业荒，江都云水暮苍茫。\n清时不用天人策，方朔诙谐侍武皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18329,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"枕上简献吉二首 其一","author":"边贡","text":"自入秋来日日晴，看花看月每同行。\n一夜六街风雨恶，莫言天不解离情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18330,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"枕上简献吉二首 其二","author":"边贡","text":"早凉冲晓入纱帷，听雨听风睡起迟。\n街西咫尺不相见，却似河梁别后时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18331,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"诸友二首 其一","author":"边贡","text":"济水源南舜井旁，月明曾共坐宵长。\n六春暌隔离江路，五月相逢是帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18332,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"诸友二首 其二","author":"边贡","text":"双雁北来河水平，两岸秋阴芦荻生。\n黑头七度曾过此，不似今回感别情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18333,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"淮浦歌三章为太仆杨敬之作 其一","author":"边贡","text":"淮浦泱泱淮水流，月明长照浦中楼。\n白鹤青猿好相访，主人今只在滁州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18334,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"淮浦歌三章为太仆杨敬之作 其二","author":"边贡","text":"清淮蒲荻晚萧萧，浦口山明欲上潮。\n七里正贪渔艇乐，九重无耐鹤书招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18335,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"淮浦歌三章为太仆杨敬之作 其三","author":"边贡","text":"水蓼花红淮浦烟，晚来鸥鹭下翩翩。\n依沙宿桨当门系，莫是扬家问字船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18336,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"俞国昌大参小松二株","author":"边贡","text":"郁郁青松尺许长，似看颜色有风霜。\n何时却睹干霄势，六月浓阴覆草堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18337,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寓延津夜起天霁北望东彭太保","author":"边贡","text":"月明风静雨初收，一鹗横空万里秋。\n四海苍生正翘首，秀峰岩下莫迟留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18338,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"得同年寅之管城见寄之作酬答二首 其一","author":"边贡","text":"翩翩骢马度秋涯，思入风云句意佳。\n多病独怜梁苑客，闭门高卧草侵阶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18339,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"得同年寅之管城见寄之作酬答二首 其二","author":"边贡","text":"诗来恰值酒醒馀，起步秋庭病忽除。\n唤妇不须愁夜黑，老夫今日得明珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18340,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东王滦江","author":"边贡","text":"病里怀人掩客窗，尚闻仙舸在龙江。\n观音阁下梅花水，对雨何时倒玉缸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18341,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵寄王光生四首 其一","author":"边贡","text":"屋里琴书屋外田，绕庭松树古藤缠。\n何时却遂东山约，閒伴先生乐暮年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18342,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵寄王光生四首 其二","author":"边贡","text":"绿阴回首代红英，客舍流光只可惊。\n病起偶宽书簿债，独将尊酒向谁倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18343,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵寄王光生四首 其三","author":"边贡","text":"博得荆南五裤歌，一钱囊底奈贫何。\n匣中犹有龙泉在，閒就巴江石上磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18344,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵寄王光生四首 其四","author":"边贡","text":"一麾江郡领尘官，何似山中菽水欢。\n梁楚板舆平似砥，凭君休说路行难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18345,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"口号呈问庞二少府","author":"边贡","text":"黄鹤楼前夜泊舟，苇花枫叶似江州。\n乐天本是多情客，卧听歌声起别愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18346,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"内弟文甫至清河一见而别题扇赠之","author":"边贡","text":"逆旅相逢意惘然，四年䰟梦一灯前。\n即教乍见还分手，犹胜山阴雪夜船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18347,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谢东园送菊","author":"边贡","text":"薄暮霜篱景色加，名园分得岁寒花。\n谁知建业骚人馆，不是浔阳处士家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18348,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄閒斋少宰四首次白岩韵 其一","author":"边贡","text":"䢴江西路溯流风，城郭山林道路通。\n兄弟自为真率会，秪应随俭复随丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18349,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄閒斋少宰四首次白岩韵 其二","author":"边贡","text":"腰袅燕台白玉珂，水亭山寺赏吟多。\n相看已恨俱华发，更奈苍江远别何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18350,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄閒斋少宰四首次白岩韵 其三","author":"边贡","text":"登临随处见题名，想像当年载酒行。\n山翠不遮牛首寺，江流长抱石头城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18351,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄閒斋少宰四首次白岩韵 其四","author":"边贡","text":"竹门潇洒对江开，中有高亭扁快哉。\n为问亭中二仙客，几时骑鹤上蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18352,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"瑞卿留别以答","author":"边贡","text":"扬舲无奈客心何，暑雨平添潞水波。\n草阁驿亭谈笑别，碧山回首暮云多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18353,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题白头翁鸟图送友人归蜀省觐","author":"边贡","text":"短棹长江下蜀州，家中风景画中收。\n蒲牙出水荷钱小，一笑相看两白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18354,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"唐仁夫出使广西四首 其一","author":"边贡","text":"碧衣黄简照青春，宠宴传呼出尚珍。\n辞罢阁门东上马，道傍罗列拜王臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18355,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"唐仁夫出使广西四首 其二","author":"边贡","text":"楼船风景入春多，铙吹声中故里过。\n两岸绿杨阴不断，隔江知是柳州河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18356,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"唐仁夫出使广西四首 其三","author":"边贡","text":"手捧鸾书下九天，恩光初到墓门前。\n山川不改孤儿恨，风木萧萧似往年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18357,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"唐仁夫出使广西四首 其四","author":"边贡","text":"十年知己一绨袍，万里南云望尔劳。\n待得明年好春日，牡丹花里候旌旄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18358,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送钱水部致仕次杭秋官韵 其一","author":"边贡","text":"虎头将军图画奇，成都待诏功名迟。\n春风草草拂衣去，投老相寻知几时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18359,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送钱水部致仕次杭秋官韵 其二","author":"边贡","text":"冥鸿杳杳碧天秋，虞人网罗空复求。\n朔地苦寒江渚燠，常时虚拟稻粱谋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18360,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送钱水部致仕次杭秋官韵 其三","author":"边贡","text":"青门挂冠春欲暮，白首放歌江上归。\n野老相逢话朝市，龙飞天子正垂衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18361,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送钱水部致仕次杭秋官韵 其四","author":"边贡","text":"老子田园归兴豪，已将功业付儿曹。\n庭中手种梧桐树，他日朝阳看凤毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18362,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送钱水部致仕次杭秋官韵 其五","author":"边贡","text":"莲叶田田溪日曛，竹竿袅袅白鸥群。\n水南即是长洲苑，杳霭歌声穿暮云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18363,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送钱水部致仕次杭秋官韵 其六","author":"边贡","text":"东观鸡号风雨冥，十年通籍绾银青。\n栖栖不向故山去，兀兀穷愁何以醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18364,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送钱水部致仕次杭秋官韵 其七","author":"边贡","text":"秦州石经半埋土，藓剥苔封谁为开。\n凭君觅取吴中本，江上云帆日往来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18365,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送顾侍御出守马湖五首 其一","author":"边贡","text":"露冕南征火井西，东过漉水北泥溪。\n借问乡愁何处切，千山明月子规啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18366,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送顾侍御出守马湖五首 其二","author":"边贡","text":"五马骄嘶锦水隈，双旌遥指剑门开。\n巴童吹笛羌儿舞，重见文翁镇蜀来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18367,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送顾侍御出守马湖五首 其三","author":"边贡","text":"五月泸州蕉叶黄，武侯祠下水如汤。\n行人莫恶南中热，自有参天古柏长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18368,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送顾侍御出守马湖五首 其四","author":"边贡","text":"古箐人稀秋草深，碧松苍桧接阴森。\n高楼永日弹棋暇，海北天南万里心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18369,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送顾侍御出守马湖五首 其五","author":"边贡","text":"汉家驿路止牂牁，相望龙湖路几何。\n闻说夜郎天更远，浔阳李白亦经过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18370,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送潘伯振守汉中三首 其一","author":"边贡","text":"石栈凌云鸟路赊，汉中城府枕三巴。\n风林落叶猿声满，那得行人不忆家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18371,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]