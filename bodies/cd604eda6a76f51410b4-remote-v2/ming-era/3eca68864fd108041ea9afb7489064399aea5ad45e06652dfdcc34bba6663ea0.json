[{"title":"题林君惟华秋江独钓图和李君唐英韵","author":"黄仲昭","text":"托迹沧浪识者稀，海鸥汀鹭日相依。\n投竿一笑寒云暝，世事无心任落晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题芦雁扇和李君唐英韵","author":"黄仲昭","text":"相呼相唤下回塘，秋水芦花一望长。\n万里云霄身未达，数声嘹唳送斜阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题屈原渔父问答图","author":"黄仲昭","text":"放逐江潭恨不平，偶逢渔父话衷情。\n可怜狂楚无情甚，竟使忠臣殒此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏题钟馗","author":"黄仲昭","text":"曾向明皇梦寐中，手擒魑魅逞英雄。\n如何不斩奸邪首，纵使胡儿入后宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春深菊苗未发戏成","author":"黄仲昭","text":"堪笑春风亦世情，菊畦偏后发生仁。\n工夫全向繁桃李，未暇分来寂寞滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"方君景大家赏菊分题得锦菊二首 其一","author":"黄仲昭","text":"繁英千叠绝鲜明，列向华堂最可人。\n綵服舞时看不异，诗囊近处认难真。\n月中漏泄天机巧，露里分明蜀锦新。\n摘泛霞觞香更好，用蕲慈寿等松椿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"方君景大家赏菊分题得锦菊二首 其二","author":"黄仲昭","text":"君家盛种一篱秋，锦菊还誇异品流。\n雨里轻摇疑戏綵，风前谩舞讶缠头。\n化机巧织尘难污，湛露深沾色更幽。\n欢赏百年能几度，不妨引满酌金瓯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送同年杨君赴春闱诗","author":"黄仲昭","text":"河桥梅放雨初晴，荣捧乡书上帝京。\n藩府已推魁八郡，大廷还拟冠群英。\n虫吟驿馆三更梦，月满蓬窗万里情。\n遥想难兄相会处，对床风雨酒同倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林君贵实赴春闱诗","author":"黄仲昭","text":"久淬文锋羡老成，喜陈三策上神京。\n马冲寒雪闽山远，帆挂微风浙水平。\n霹雳一声龙化早，扶摇万里鹗飞轻。\n琼林宴罢如相忆，白雁南来好寄声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题壶山惜别图送友人周君归三山","author":"黄仲昭","text":"壶阳腊月梅花发，花下吟诗一送君。\n求道立残门外雪，思亲望断岭头云。\n旗亭此日难分手，尊酒何时更论文。\n明到故园如有忆，音书无惜寄来勤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"澄溪清隐","author":"黄仲昭","text":"久向澄溪赋考槃，白鸥独向静中看。\n四时风月归诗兴，半世功名付钓竿。\n远引溪泉来稼圃，闲开竹牖看云峦。\n醉乡笑傲无馀事，一曲狂歌宇宙宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27887,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中与郑君思亨姜君思正索菊花二首 其一","author":"黄仲昭","text":"闻道君家菊满篱，无由一到赏芳菲。\n梦魂忘却身犹病，几度吟敲花外扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27888,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中与郑君思亨姜君思正索菊花二首 其二","author":"黄仲昭","text":"春初卧病及秋深，篱菊阑珊碧草侵。\n赖有故人相爱厚，一株无惜慰忧心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27889,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢友人惠锦菊月下白菊二株三首 其一","author":"黄仲昭","text":"今年全不见黄花，对景荒凉秖自嗟。\n应是秋光深远我，赖君挽得到贫家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27890,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢友人惠锦菊月下白菊二株三首 其二","author":"黄仲昭","text":"鲜葩灿灿吐奇芬，截得天机锦绮文。\n病眼摩挲吟看久，愁怀应减两三分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢友人惠锦菊月下白菊二株三首 其三","author":"黄仲昭","text":"繁英楚楚开寒玉，应与蟾光一色清。\n疑是羽仙初宴罢，醉飞环佩下蓬瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日卧病感怀","author":"黄仲昭","text":"一卧经春秪自嗟，无由散步访韶华。\n东风似亦欺人病，吹落瓶中数朵花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"首夏病中偶成","author":"黄仲昭","text":"九十春光病里过，不堪佳景尽蹉跎。\n儿童又向床前语，树上青梅熟已多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中立秋偶成","author":"黄仲昭","text":"春初一卧历炎暑，又见新凉起天宇。\n西风曾不怜我愁，频向疏棂送寒雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题悬崖蘸水梅","author":"黄仲昭","text":"金鼎调羹未有期，独依幽谷擅清奇。\n夜深溪月弄清影，水底分明又一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题扇面画","author":"黄仲昭","text":"扁舟闲傍绿杨汀，濯足沧浪酒未醒。\n铁笛独横斜照里，数声吹与水龙听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归朝欢 送都宪秦公巡抚北畿","author":"黄仲昭","text":"使君才器由天赋。\n骅骝早聘青云路。\n京华扬历政声隆，藩郡翱翔仁泽溥。\n九重深眷顾。\n玉节煌煌明绣斧。\n到京畿，扬清激浊，千里民安祚。\n东风吹散西山雨。\n冠盖纷纷朝出祖。\n黎元深感使君恩，车前卧辙人无数。\n圣主思贤辅。\n姓名定入金瓯覆。\n怅明朝，相思两地，空望云间树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感皇恩 送李方伯之任山西","author":"黄仲昭","text":"采石古名区，秀钟英杰。\n早际风云朝北阙。\n谏垣名重，超佐西江节钺。\n襟怀清彻底，如冰雪。\n政迹著闻，帝心简在。\n又擢晋阳新牧伯。\n轺车到处，枯槁渐回春色。\n故人千里空，望明月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水龙吟 送方伯陈公大玉之任闽藩","author":"黄仲昭","text":"使君抱负不凡，少年文采称无敌。\n云霄直上，龙墀夺锦，金闺通籍。\n计省发硎，政无疵厉，民沾惠泽。\n喜受知圣主，擢参薇省，经行处、皆春色。\n天上忽颁宠命，又荣迁、闽南牧伯。\n九重宵旰，恢弘治化，还资辅弼。\n棠树阴中，旧时父老，空思行迹。\n况同寅交契，江云渭树，此情何极。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆旧游 送宪副汪从仁之任云南词并引","author":"黄仲昭","text":"喜清和时节，梅酿微酸，榴吐新葩。\n祖席酒三行，把离情搅动，乱似杨花。\n忆著英年分陕，美誉赤城霞。\n看白璧坚贞，青蝇虽点，本自无瑕。\n悯起佐西江，臬㥃吏弊，民情一一梳爬。\n九重思俊杰，抚滇南赤子，帝曰汝嘉。\n旧日夷民识面，重见喜无涯。\n待边境又宁，归朝还拟殿邦家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归朝欢 送张天瑞都宪巡抚北畿","author":"黄仲昭","text":"三伏炎曦真烁石。\n使君何事行匆剧。\n王畿分镇简贤能，君命有严遑自适。\n西江人叹息。\n福星移照天之北。\n旧同寅，暌违矩范，翘首情何极。\n使君早蕴匡时策。\n中外贤劳名赫奕。\n此行绣斧带霜威，当道豺狼看敛迹。\n九重方侧席。\n寤寐求贤敷德泽。\n看他年，进秉钧轴，霖雨苏寰域。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感皇恩 送陈大参德修升云南右方伯","author":"黄仲昭","text":"金榜早蜚英誉，两京扬历。\n剧郡分符声赫奕。\n超佐薇垣，茂著旬宣嘉绩。\n黎元沾惠爱，咸欢怿。\n入觐王庭，遂迁岳牧，万里滇南烟树碧。\n西江父老，空想甘棠行迹。\n还期霖雨遍，沛寰域。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感皇恩 送同寅罗象州迁云南宪副","author":"黄仲昭","text":"南浦祖筵开，骊歌将阕。\n彩鹢乘风江上发。\n便道乡关，山水应增秀色。\n两地相思处，共明月。\n金紫辉煌，青骢蹀躞。\n万里风云随玉节。\n冰霜满面，散作阳春德泽。\n他年金鼎还，资调燮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉烛新 送沈大参朝贺之京","author":"黄仲昭","text":"诗礼传家旧。\n喜早骋骅骝，康庄驰骤。\n十年纷署，声华著、简拔旬宣陇右。\n才转闽藩，旋复承宠恩隆厚。\n等闲间、金带生花，海国歌諠清书。\n兹逢圣主龙飞，正玉烛新调，群生咸囿。\n君函笺奏。\n朝丹陛、带得天香盈袖。\n华封祝后。\n须念及苍生颙候。\n亟旋旆、收取功名，鹓班重簉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶作","author":"杨爵","text":"飒飒西风，悠悠危困。\n雾掩长空，怀此忧疢。\n我生尚有，我心难忍。\n告尔君子，不可不慎。\n天方威降，无滋幽衅。\n飒飒西风，悠悠危困。\n我生不辰，遭此难屯。\n告尔君子，胡不自尽。\n拯溺救焚，伊谁之人。\n天方降威，无为颠震。\n飒飒西风，悠悠危困。\n自昔以来，贻我烦懑。\n告尔君子，各宜履顺。\n误国之谋，伐国之刃。\n天祸方殷，无惜忧瘽。\n飒飒西风，悠悠危困。\n我心日忧，我泪日抆。\n苍天苍天，胡降阨运。\n谋猷乖离，而日以甚。\n抱此赤心，徒尔谆谆。\n何以图之，周道惟近。\n骐骥惟良，莫耶非钝。\n听无不聪，视无或瞬。\n各欲事天，岂敢相迿。\n我为尔谋，尔无不信。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感怀","author":"杨爵","text":"志士轻天下，不类世人情。\n由来守之固，出自见之明。\n时哉诚可尚，古今不易真。\n缅怀千载上，愧此鲁连生。\n存赵片言重，却秦天下惊。\n脚跟高蹈处，无陂总是平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次杜少陵韵答人","author":"杨爵","text":"残息悠悠在，真成一懦夫。\n当年何所为，心欲见唐虞。\n世路岂翻覆，人为自险夷。\n好生与恶死，此念胸中知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采葵","author":"杨爵","text":"山中惜岁月，日暮采园葵。\n采之何所用，欲以赠相知。\n相知相去远，道路多阻蹇。\n安得藉晨风，万里寄诚恳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四丁宁赠钱员外绪山 其一","author":"杨爵","text":"留心剪枝叶，枝叶更秾鲜。\n努力勤于耒，共耕方寸田。\n吉人常默默，浮士好便便。\n觉彼高腾处，反将真意牵。\n昊天但覆帱，四运自周旋。\n孔圣无言教，真机向此传。\n丁宁一告语，告以圣同天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四丁宁赠钱员外绪山 其二","author":"杨爵","text":"结交结君子，茅茹自相连。\n媚悦增心癖，孰能示我愆。\n相同即是圣，异处且为贤。\n以此求斯道，恐成狭且偏。\n心能乐取善，善自我心全。\n舍己从人处，襟怀何大焉。\n丁宁再告语，无我自天然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四丁宁赠钱员外绪山 其三","author":"杨爵","text":"迂儒多曲语，壮士自平夷。\n千古周行在，胡为向小歧。\n荆榛不自剪，令我此心迷。\n洞识虚明体，超然即在兹。\n性分同一理，此理最渊微。\n孔圣言仁处，力行不远而。\n丁宁三告语，相与忆所之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四丁宁赠钱员外绪山 其四","author":"杨爵","text":"尚友希前哲，无劳辨浅深。\n开言动喋喋，矛戟已森森。\n祗觉胸怀隘，恐非畜德心。\n古人各有见，原本自相忱。\n岂若异流者，驰骋多诐淫。\n何苦但永矢，宜从得处寻。\n丁宁四告语，共严此心箴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠人","author":"杨爵","text":"先生藏远趋，微原欲探讨。\n仁风秀群英，礼化淑怀抱。\n讲堂逍遥处，相与笃皇道。\n芹宫滋松华，泮池润瑶草。\n瑶草日日长，松华岁岁好。\n君子尚采采，衿佩以为宝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭姜义泉郎中","author":"杨爵","text":"前日哭尚书，今日哭郎中。\n大夫相继死，应时命之穷。\n但拟同出险，岂堪忽告终。\n将吾一掬泪，频洒与西风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭姜义泉郎中","author":"杨爵","text":"吾痛翟司马，又哭姜义泉。\n人生值变故，与世自相关。\n义泉死今日，司马肉未寒。\n义泉瘗今日，司马殡未干。\n桎梏非自取，几微隐祸端。\n悠悠天地里，展转属艰难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋怀友","author":"杨爵","text":"寂寞今宵景，还如去岁秋。\n美人消息远，令我心悠悠。\n吴水东流去，秦山不可求。\n想君谈道处，念此日幽囚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋怀友","author":"杨爵","text":"碍彼清霄月，停空有片云。\n悬吾方寸地，文武赵将军。\n咫尺燕山侧，常如万里分。\n艰危知善处，君子自相群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂兴 其一","author":"杨爵","text":"雁羽冲云去，燕山春意浓。\n孤踪一路险，衰鬓两边蓬。\n戢步缘新绿，依隈挹暖风。\n将吾眼底事，都付不言中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂兴 其二","author":"杨爵","text":"地隐春迟到，幽怀更耐看。\n雁声愁远塞，云影滞余寒。\n斗笠营秦陇，丝纶坐渭竿。\n而今耕钓手，梏械亦相安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂兴 其三","author":"杨爵","text":"我心诚匪鉴，遗恨在云壤。\n岂但身忧切，更余国虑长。\n九重终自悟，一饭亦难忘。\n只恐建炎诏，徒怜陈少阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂兴","author":"杨爵","text":"身危非所恤，多罪累君王。\n万古纲常理，一躯忠义肠。\n青天掩长雾，白日下繁霜。\n儿女此时泪，未知为国伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事 其一","author":"杨爵","text":"百年吾宇宙，万里此相逢。\n阨险情犹适，经纶志复同。\n隙风动飒飒，窗月照肜肜。\n对榻闲谈后，悠然世虑空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事 其二","author":"杨爵","text":"衰危亲杖屦，步履转彷徨。\n地作临池湿，天从入夜凉。\n清飙轻燕室，云影暗幽堂。\n孤念萧萧在，闲同岁月长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事","author":"杨爵","text":"结发交游好，同舟涉渭滨。\n壮怀今若此，老泪更堪瞋。\n险地忙为苦，长天去是真。\n知从大梦里，自了百年身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中慰章秀才","author":"杨爵","text":"万事总由命，宜须安受之。\n但求一念是，莫叹百忧罹。\n窘迫宜自处，将来做广居。\n乐天境界上，得到是男儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有报周碛山先生家虑于狱中者痛而作此","author":"杨爵","text":"一朝君即死，七载我犹生。\n秪堕万人泪，空留百世名。\n乾坤藏正气，日月照精诚。\n展转思余喘，真如草芥轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"勉仕男读书","author":"杨爵","text":"长路频来往，空将岁月虚。\n百为超俗虑，一步到天初。\n只使心无蠹，何须食有鱼。\n燕山二尺屋，可读五车书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"勉仕男读书","author":"杨爵","text":"忧国吾遭难，思亲汝复来。\n青天何易蔽，赤雾总难开。\n万里豺狼路，千寻枳棘台。\n要知百死地，不是一身灾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有感八首 其一","author":"杨爵","text":"燕语遗窗外，熏风入卧边。\n真怀死难易，岁序几经迁。\n国步终成踬，双毛半已颠。\n独怜忧世念，空自九重悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有感八首 其二","author":"杨爵","text":"期亲堂上老，游子泪潸然。\n假寐惊还起，余生死复延。\n脚跟总实地，屋隙是晴天。\n骨肉心难遏，朝朝百虑牵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有感八首 其三","author":"杨爵","text":"老去心犹壮，诗成一洒然。\n襟怀羞缕缕，风景叹年年。\n伫立凶危地，出王日夜天。\n死亡诚旦暮，终不受人怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有感八首 其四","author":"杨爵","text":"忆昔躬耕日，蓬庐梦九州。\n握珠虽易出，按剑总难投。\n草芥生犹在，君王尚远谋。\n古来杀谏士，谁可免多忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有感八首 其五","author":"杨爵","text":"好景随时在，幽人心自如。\n难将当世事，得免动相于。\n总是更新念，还能展旧书。\n古人心已逝，谁共叹离居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有感八首 其六","author":"杨爵","text":"残雨急声住，窗风更觉新。\n独怜幽景暮，空抱此心真。\n跬步万方足，经年百死身。\n每忧深罪里，无以答苍旻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有感八首 其七","author":"杨爵","text":"庭院幽沉处，黄鹂声自和。\n炎风侵夏木，世道转颓波。\n夙志逢时健，韶光双鬓皤。\n如何人世上，独我忧心多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有感八首 其八","author":"杨爵","text":"有时乐兴至，触目更忧来。\n时觉寸心郁，未能尽日开。\n人谋尚消息，天意自安排。\n将此百年志，空余万虑灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻黄鸟","author":"杨爵","text":"庭柯鸣岁月，又是一番新。\n忧世总宜狱，感时却忆秦。\n早梅乘暮雨，佳木秀溪滨。\n茅屋远尘迹，空遗老此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送忽百行","author":"杨爵","text":"忽生遥以慰，五日是归期。\n倚剑无歧路，伫云有旧思。\n自吾蒙困难，于子始真知。\n人世关情处，难为此别离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣仕男归家","author":"杨爵","text":"骨肉分离久，殷忧切寸忱。\n儿无膝下苦，父有坎中深。\n顾此五年困，皆吾三代心。\n一升与一降，物运此相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢信官","author":"杨爵","text":"患难人多畏，信郎独不疑。\n再从牌上写，曩在手中提。\n每日多君厚，经年济我饥。\n老夫穷困里，报汝一联诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]