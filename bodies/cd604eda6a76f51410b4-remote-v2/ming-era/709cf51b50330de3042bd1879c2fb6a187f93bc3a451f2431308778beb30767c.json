"commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3756,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晴雨二竹为江西都挥佥汤节题 其一","author":"杨士奇","text":"潇洒渭川风日佳，展图清气满清怀。\n彩云庭院不相称，最称汤家兰雪斋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3757,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晴雨二竹为江西都挥佥汤节题 其二","author":"杨士奇","text":"凤池舍人精八法，新来写得雨潇湘。\n数竿清润如苍玉，宜寘东皋旧草堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3758,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹赠萧令复任归安 其一","author":"杨士奇","text":"我忆同乡萧县尹，人来频问水精宫。\n万里趋朝书上考，相逢还恨别匆匆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3759,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹赠萧令复任归安 其二","author":"杨士奇","text":"雪堕关河枫叶丹，扁舟南去路漫漫。\n一竿不是寻常赠，要看青青傲岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3760,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送彭佥事旒赴广东","author":"杨士奇","text":"雨收云净气澄明，千尺长空动羽旌。\n持向岭南随使节，高风犹是玉堂清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3761,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题刘城之梅花 其一","author":"杨士奇","text":"衣上缁尘四十霜，玉华东畔忆家乡。\n年年开到梅花日，吟咏疏篱野水傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3762,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题刘城之梅花 其二","author":"杨士奇","text":"窈窕文溪近武山，年年春早玉葩繁。\n南平进士北京客，常对新图忆故园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3763,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送杨仰谟同知 其一","author":"杨士奇","text":"万里为官可惮赊，从来山水说三巴。\n巴西二守清贞操，肯愧庐陵忠节家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3764,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送杨仰谟同知 其二","author":"杨士奇","text":"九河正月未消冰，匹马冲寒发帝京。\n不尽同宗临别意，题诗相送蜀西行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3765,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹赠康宜望","author":"杨士奇","text":"永嘉戎幕需贤佐，临别殷勤赠竹枝。\n白日青云看高举，岁寒冰雪在操持。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3766,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题萧彦常竹","author":"杨士奇","text":"雨苔绿遍珊瑚石，云彩晴开翡翠林。\n好作萧斋傍幽处，一编时究古人心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3767,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题杨允嘉近画 其一","author":"杨士奇","text":"碧梧翠竹论清修，介石由来君子德。\n盛年学业在操持，写向书斋作三益。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3768,"sha256":"