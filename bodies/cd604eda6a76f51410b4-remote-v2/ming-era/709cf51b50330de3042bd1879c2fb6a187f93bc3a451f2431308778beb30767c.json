[{"title":"题戴文进湘江雨意卷 其一","author":"杨士奇","text":"十年放浪湘江客，题遍江头绿玉枝。\n今日披图看烟雨，秋风霜鬓已成丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3701,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题戴文进湘江雨意卷 其二","author":"杨士奇","text":"纷驰名利不知劳，马首红尘十丈高。\n谁似钱塘戴文进，小斋无事玩湘皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3702,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题戴文进竹雪书房 其一","author":"杨士奇","text":"分栽脩竹已成林，每到严冬雪积深。\n斋馆相看不曾厌，只缘俱有岁寒心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3703,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题戴文进竹雪书房 其二","author":"杨士奇","text":"此君高节净娟娟，况复瑶华相映妍。\n王子斋居足清兴，定知不棹剡中船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3704,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题士器竹","author":"杨士奇","text":"峥嵘冰雪岁寒时，谁写琅玕赠别离。\n多为此君贞操在，岁寒冰雪有深期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3705,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题凝翠楼 其一","author":"杨士奇","text":"住近东华五云下，车尘不断扑帘屏。\n别开楼馆看尘外，万叠西山过雨清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3706,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题凝翠楼 其二","author":"杨士奇","text":"妙墨淋漓湿未乾，山光林影翠成团。\n渠家高馆偏多趣，北苑南宫绕座看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3707,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题周汝清梅 其一","author":"杨士奇","text":"本是阳春第一花，皎如冰雪净无瑕。\n自缘不与东风竞，故向寒冬作岁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3708,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题周汝清梅 其二","author":"杨士奇","text":"潇洒江南清渚曲，乘春多植傍瑶京。\n旧家只说莲堪爱，不说梅花更自清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3709,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题周汝清梅 其三","author":"杨士奇","text":"谁乐明时作冷官，羡渠萧散意能安。\n小斋一榻清于水，坐与梅花傲雪寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3710,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题曾翚主事竹石图","author":"杨士奇","text":"石上翛翛翠两竿，含风泛雪拂云端。\n时平讼简文书静，最好秋官署里看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3711,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送王时俊左迁云南 其一","author":"杨士奇","text":"铁石为心玉雪颜，远行巴峡上黔山。\n明时谪去休嗟叹，早晚天恩定赐环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3712,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送王时俊左迁云南 其二","author":"杨士奇","text":"冬官郎署过秋官，节操真成六月寒。\n万里黔南作迁客，清风持赠翠琅玕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3713,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"失题","author":"杨士奇","text":"渺渺吴江远别离，慰情持赠凤凰枝。\n岁寒但保冰霜节，柏府松厅处处宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3714,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送马检讨归阆中并寄声李全太守 其一","author":"杨士奇","text":"几多鹤发京华客，荣利关心未肯閒。\n谁似翰林马检讨，黑头苦意恋家山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3715,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送马检讨归阆中并寄声李全太守 其二","author":"杨士奇","text":"二十馀年住两京，蓬莱阁下预恩荣。\n衣冠归里何多幸，老傍林泉阅治平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3716,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送马检讨归阆中并寄声李全太守 其三","author":"杨士奇","text":"尔乡太守吾乡彦，为政心同阆水清。\n料尔到家春亦到，劭农正值出郊行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3717,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹寄一夔","author":"杨士奇","text":"夔翁又是三年别，白发论交重比金。\n万里停云频在望，一枝聊寄岁寒心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3718,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"出京留别翰苑诸公 其一","author":"杨士奇","text":"身著宫袍拜玉旒，东风二月别皇州。\n玉堂学士于今盛，一颗明珠不暗投。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3719,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"出京留别翰苑诸公 其二","author":"杨士奇","text":"东岳祠前动别骖，归心先己到江南。\n同官敢怨无言赠，玉旨丁宁已再三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3720,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"书驿舟 其一","author":"杨士奇","text":"二十六年曾过此，萧萧芦苇带荒村。\n如今重过头成雪，渺渺桑麻雨露繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3721,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"书驿舟 其二","author":"杨士奇","text":"风激黄河白浪生，画船南下日西明。\n怡人一片萧閒趣，两两水禽相对鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3722,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"新桥驿 其一","author":"杨士奇","text":"九河冰泮绿差差，洲渚凫鹥近不飞。\n夹道如云杨柳树，尽舒春色送人归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3723,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"新桥驿 其二","author":"杨士奇","text":"官船挝鼓夜过半，起视星河尽转西。\n津吏临流迎下缆，人家两岸曙鸣鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3724,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"兴济县 其一","author":"杨士奇","text":"梦到江南水竹居，计程犹是五千馀。\n行舟过处人惊讶，为有龙光动玺书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3725,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"兴济县 其二","author":"杨士奇","text":"道路相传昼锦归，人家竞出看光辉。\n岂知白水青山客，不改从来旧布衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3726,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过东昌驿遇邱诚驿丞 其一","author":"杨士奇","text":"天恩特许暂还乡，忆别乡关四十霜。\n喜见南来好春色，柳条将绿到东昌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3727,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过东昌驿遇邱诚驿丞 其二","author":"杨士奇","text":"旧同鱼浦龙洲住，岭表移家岁月多。\n今日聊城喜相见，匆匆无那别情何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3728,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过安山驿有怀蹇尚书","author":"杨士奇","text":"重过安山晓系船，东风杨柳蔼人烟。\n同来怅别人何处，寒景凄凉记昔年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3729,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"滞风雨采石有怀尹自道同知 其一","author":"杨士奇","text":"圣主深恩赐暂归，龙河冰泮别京师。\n重来不待榴花节，为报当涂贰守知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3730,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"滞风雨采石有怀尹自道同知 其二","author":"杨士奇","text":"谪仙祠下杏花残，孤客维舟倚暮寒。\n相好相思不相见，满江风雨夜漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3731,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荻港","author":"杨士奇","text":"春雨凝寒著杏花，春风吹绿上芦芽。\n行人数日江东道，次第看山到九华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3732,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"望湖亭","author":"杨士奇","text":"好风十日迎归棹，已历长江及大湖。\n晓上高亭更回首，五云直此是天都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3733,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅与李仲贵 其一","author":"杨士奇","text":"四十馀年归旧里，不胜衰薄叹民风。\n一心恬憺无尘累，闾巷相看有此翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3734,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅与李仲贵 其二","author":"杨士奇","text":"归里匆匆欲别难，画船春水发江干。\n一枝留赠罗浮玉，他日归来共岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3735,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅赠王澄渊贰守 其一","author":"杨士奇","text":"分手都门岁月赊，思君夜夜梦梅花。\n贞姿一段清于雪，不让西湖处士家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3736,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅赠王澄渊贰守 其二","author":"杨士奇","text":"铁作根株玉作神，耻随桃李混芳尘。\n一从移植青山侧，野水疏篱自在春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3737,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅赠王澄渊贰守 其三","author":"杨士奇","text":"四十年来金石交，枉烦青眼顾衡茅。\n临岐不尽岁寒意，持赠罗浮月一梢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3738,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹与李惩","author":"杨士奇","text":"上溯萧滩下彭蠡，官船十日安如山。\n为感薇垣李从事，聊书淇绿送南还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3739,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅寄钟天锡宪副 其一","author":"杨士奇","text":"早属秋官起盛名，又随司寇饬边城。\n平生一片冰霜操，移向东藩表洁清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3740,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅寄钟天锡宪副 其二","author":"杨士奇","text":"故家共住西江上，为托梅花寄远思。\n无限乡园清白意，与卿同结岁寒期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3741,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠金华刘实通判三首 其一","author":"杨士奇","text":"姓名早见书金榜，佐政黄堂又四年。\n自有郡人歌岂弟，相知何必上官贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3742,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠金华刘实通判三首 其二","author":"杨士奇","text":"金华自昔多文献，继者何人久未闻。\n胜地良才终不乏，及时培养在诸君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3743,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠金华刘实通判三首 其三","author":"杨士奇","text":"府倅官清面带霜，庭前种得翠筼筜。\n春来不爱閒桃李，只爱清风五月凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3744,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅赠杨文昭广东宪使 其一","author":"杨士奇","text":"白简绯袍宠命新，南行一路见阳春。\n明时宪府清于水，只许梅花对玉人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3745,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅赠杨文昭广东宪使 其二","author":"杨士奇","text":"华发萧萧铁作冠，梅关此去路漫漫。\n凭将使者冰霜操，散作炎州九夏寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3746,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠夏仲昭归省 其一","author":"杨士奇","text":"科名早列黄金榜，书学还趋白玉堂。\n挥洒常看五色笔，丝纶阁下染龙香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3747,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠夏仲昭归省 其二","author":"杨士奇","text":"吴山浙水名天下，笔有王维与郑虔。\n归到江南写真趣，一缄时寄五云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3748,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送周蒙南归 其一","author":"杨士奇","text":"为爱周园好竹枝，莫因风雨恨低垂。\n岁寒但保冰霜操，会有凌霄拂汉时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3749,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送周蒙南归 其二","author":"杨士奇","text":"志人厚积而迟发，春花不待秋风吹。\n龙驹一蹶岂足叹，鸑鷟重鸣应可期。","collecti