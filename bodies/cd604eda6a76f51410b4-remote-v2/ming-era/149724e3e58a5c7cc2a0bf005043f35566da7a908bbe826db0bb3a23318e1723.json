[{"title":"中秋夜与诸子归舟泊港口，玩月分赋","author":"成鹫","text":"海气连云送落晖，远寻渔火宿渔矶。\n四围夜色凉衾枕，一晕寒光浸衲衣。\n异地同舟非偶偶，中秋见月亦稀稀。\n明年此夕重来否，多恐还山各掩扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49674,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杨勉斋北上公车","author":"成鹫","text":"一回见面一回新，不觉相逢是贵人。\n未敢久留三笑侣，近须忙趁百花春。\n梦游海岳身先老，道合风云曾有因。\n君去选官予选佛，局中谁为辨疏亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49675,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中荅人","author":"成鹫","text":"不知身寄在东城，屋角青山惬野情。\n竹榻笑人长卧病，杖藜扶我且经行。\n花边独鹤迎嘉客，池上群鸥订夙盟。\n珍重新诗劳见赠，沉疴初起见枚生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49676,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲戌春偕诸子游鼎湖，雨中晚泊 其一","author":"成鹫","text":"渡头古树半栖鸦，树底维舟近浅沙。\n风势北来潮带雨，海门南望水如花。\n閒身随地堪乘兴，老眼逢山便当家。\n明发挂帆云外去，鼎湖春色在天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49677,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲戌春偕诸子游鼎湖，雨中晚泊 其二","author":"成鹫","text":"同游有约兴腾腾，信宿寒江寝复兴。\n假寐耦将孤鹤影，苦吟分得钓鱼灯。\n春多滞雨愁为客，老厌风尘愧作僧。\n何事洞天归不得，此心多恐负良朋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49678,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三入天湖呈契和尚","author":"成鹫","text":"细路入云通曲曲，乱山回首失层层。\n有人独上最高顶，长啸一声何处僧。\n胜友新知如旧识，名山三过俨初登。\n殷勤问讯天湖主，挂角羚羊见也曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49679,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答郯城明府家二兄蒙章","author":"成鹫","text":"老年兄弟久离居，物外衰慵近不如。\n马齿渐加牙齿落，道情偏密世情疏。\n胸中只有难成事，袖里长怀未报书。\n我未参方君滞宦，不堪回首赋归与。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49680,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荅陈惟深","author":"成鹫","text":"年来踪迹类飞蓬，道与时违莫强同。\n晚市放歌逢郢客，春城扶病问壶公。\n高谈直泻千山瀑，清啸遥来四座风。\n林下为君悬一榻，松门终日候双童。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49681,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋夜梦入罗浮，得诗一律，醒后仅忆登高望远之句，援笔续成","author":"成鹫","text":"一夕新凉枕簟清，秋风送客入朱明。\n登高却恐日欲尽，望远方知云有情。\n乘兴偶来嫌梦短，步虚归去觉身轻。\n何须更跨杨州鹤，当挟仙飞万里行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49682,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋舟泊小金山，宿妙高台，与僧话旧","author":"成鹫","text":"江上西风一放舟，暮云飞去见灵洲。\n古台落叶初归鸟，野渡停桡不避鸥。\n白社重来寻旧约，青山无恙忆同游。\n灯前细语人难会，顽石何因更点头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49683,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿双桂洞","author":"成鹫","text":"丛桂枝高古洞门，远风吹叶叶归根。\n祖庭频到长为客，往事空惭未报恩。\n病骨依灯嫌有影，瘦藤卓月了无痕。\n城中莫道嚣尘满，一闭閒房是故园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49684,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽萧明经邻翼 其一","author":"成鹫","text":"净名示疾已多时，消息传闻信复疑。\n岂有适来还适去，不堪成喜又成悲。\n二毛始悔参禅晚，五岳偏嫌遣嫁迟。\n岐路分携多未惜，惜哉岐路更多岐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49685,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽萧明经邻翼 其二","author":"成鹫","text":"昨日人窥董傅园，今朝客散翟公门。\n羞将雉性求田宅，止有萤灯付子孙。\n郢匠岂堪还斲鼻，楚些无复更招魂。\n劳生欲别非难别，忍泪相辞勿复言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49686,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽萧明经邻翼 其三","author":"成鹫","text":"空中野马路旁尘，去住无端自主宾。\n扪馆便为乘驿客，过桥还是隔溪人。\n多生未了三生愿，万事惟馀一事真。\n君已盖棺予亦老，相期牢记续前因。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49687,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"市中传奇僧俗杂观，诗以戏之 其一","author":"成鹫","text":"旷野歌声杂管弦，市儿灯火闹争先。\n蛮姬幻作天魔舞，开士慵参獦獠禅。\n老逐少来争接踵，閒随忙去任挨肩。\n道人本是无心者，拨尽寒灰夜似年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49688,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"市中传奇僧俗杂观，诗以戏之 其二","author":"成鹫","text":"三叠清商一笑休，旁观容我豁双眸。\n御风羽客隳神足，出定高僧过酒楼。\n野老醉归霜点鬓，佳人歌罢锦缠头。\n无情独有长天月，不与风光管去留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49689,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再过西园赠何赤木","author":"成鹫","text":"绮阁茅亭水石边，客来多爱主人贤。\n重寻旧约过残腊，一别西园动隔年。\n龙竹倚窗寒势直，凤山缭屋夕光圆。\n閒身到处堪乘兴，回首当时更宛然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49690,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南塘泛舟赠何太占","author":"成鹫","text":"我本钓鱼船上客，偶随鸥鹭下南塘。\n长空放鹤不留影，野水侵花长带香。\n屈子牢骚庄旷达，稽生懒惰阮猖狂。\n相逢大笑各归去，明日抱琴来此堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49691,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西园雨后","author":"成鹫","text":"新雨添流涨一溪，落花和雪踏成泥。\n山如野客携云入，鸟爱高朋借树栖。\n霁色偏宜舒眼阔，短墙恰好与肩齐。\n暂来便作居亭计，自脱荷衣理药畦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49692,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过李子将鸥次昆玉","author":"成鹫","text":"榄峰南去一溪横，元礼门高简送迎。\n花底罢棋群动息，琴边抄谱万缘清。\n僧来白社无宾主，诗祖青莲有弟兄。\n回首旧游如昨日，不妨相见尽平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49693,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽胡甘滩","author":"成鹫","text":"石羊山下识初平，仙去惟怜鹤驭轻。\n楚些拟招魂不返，滩声流恨水无情。\n仪廷待凤迟三稔，杖国支鸠失五更。\n莫负高秋星月夜，归来重与话三生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49694,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李远霞过宿夜话分赋","author":"成鹫","text":"野水閒云共一池，池边借地结茅茨。\n远风不断疏疏竹，清磬难藏密密篱。\n门外雀罗无别客，阶前鹤立有新知。\n烦君过我连宵话，明月当轩照向谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49695,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠置荅师隐山","author":"成鹫","text":"投老空山计未能，偏将好事让良朋。\n开云觅路闻啼鸟，就树营居畜俊鹰。\n分得田园凭地主，望来烟火有邻僧。\n何堪别后思君处，独立螺峰最上层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49696,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送孙长发护其叔氏仁化明府旅衬还京，是冬长发应选诠部","author":"成鹫","text":"自从叶县去瀛洲，谁挟双凫返故丘。\n锦水丹山逢谢客，素车朴马识孙谋。\n云随黻翣回仙驭，风送霓旌指帝州。\n领海凭君作霖雨，金台归去莫淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49697,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟发汾水，时同舟汝得、豁大、无我、而卓诸师皆入丹霞，舟中分赋","author":"成鹫","text":"同舟载得数家禅，江上潮声促放船。\n老大出山如出世，去留由我不由天。\n一生活计从今日，五岳归来定几年。\n前路莫愁风浪恶，顺流施桨逆流牵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49698,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中雨况","author":"成鹫","text":"江分四会水三叉，才听滩声见浅沙。\n满眼波流思砥柱，一天风雨过芦巴。\n减将午食添鱼米，待得新晴埽雪花。\n劳动同舟远相示，白云深处是丹霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49699,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过浈阳峡","author":"成鹫","text":"轻舟冲破一江风，路转浈阳去不穷。\n南陆渐低云影外，西峰半落水声中。\n松高恰好宜幽独，壁立何曾碍太空。\n识得真山真面目，品题泉石入诗筒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49700,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓过英州","author":"成鹫","text":"寒生襆被雪初晴，一路吟诗过古城。\n隔水看白空有影，殊方闻鸟不知名。\n品茶泉向船头汲，选石云从袖里生。\n胜事渐多心渐远，不妨随地一迂程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49701,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒憨祖肉身","author":"成鹫","text":"借路还家识故乡，重来顶相露堂堂。\n天花散满楞伽室，祖席平分曲录床。\n白氎不留身后线，黄冠休问旧时装。\n门前溪水西来意，流入空庭味更长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49702,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曹溪谒祖","author":"成鹫","text":"却缘松竹引清风，路入曹源识祖翁。\n衣钵有山皆拱北，袈裟无水不流东。\n镜台影露云千叠，碓觜花开桂一丛。\n莫与溪声斗长舌，知音人在月华中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49703,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"呈泽萌和尚 其一","author":"成鹫","text":"片云閒逐断篷飞，路转寒山入翠微。\n十八破家人已老，一声长啸客方归。\n别峰相见谁招手，绝顶频登独振衣。\n万境总閒留不住，住来惟爱蕨芽肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49704,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"呈泽萌和尚 其二","author":"成鹫","text":"偶来原不为登临，借得閒房慰夙心。\n云水随缘无去住，烟霞投分有高深。\n林閒度岁如增劫，梦里还家当陆沉。\n珍重海螺吹一曲，孤峰翘首待知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49705,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"呈泽萌和尚 其三","author":"成鹫","text":"云深山路失高低，足快身轻定不迷。\n占断云根晞白发，望穷山色上丹梯。\n空生却被岩花笑，庄叟难将物论齐。\n长老峰头相见后，钵囊高挂不须携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49706,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"呈泽萌和尚 其四","author":"成鹫","text":"林光亭午日当中，定出无心笑懒融。\n片石似云争远近，双松连影失雷同。\n南车直指千峰北，西水长流万派东。\n从此丹霞无别客，不妨识得主人翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49707,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞十二咏 其一 紫台爽气","author":"成鹫","text":"玉台半壁锁松筠，地接西山爽气新。\n褦襶不来无热客，袈裟频上有閒人。\n凉兼草色归眉睫，风递江声过耳轮。\n咫尺夕阳山下路，是谁挥汗走红尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49708,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞十二咏 其二 锦水滩声","author":"成鹫","text":"山光历历水涓涓，十里滩声绕法船。\n碧石无心成背触，清溪何事独潺湲。\n涨添宿雨迷孤屿，响驾长风下百川。\n却笑沧浪老渔父，急流收钓竟忘筌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49709,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞十二咏 其三 螺顶浮图","author":"成鹫","text":"四楞匝地逼虚空，拾级齐云迩梵宫。\n宝铎希声风在下，鬓珠无影日当中。\n鸟窠直上窥天险，雁塔频登识化工。\n夜半金轮峰顶月，清光还与此山同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49710,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞十二咏 其四 虹桥环翠","author":"成鹫","text":"何事天台访石梁，断虹斜日两苍苍。\n乱峰过雨青如染，疏柳经春翠不黄。\n浅碧有时成藓阵，绿沈何处觅茶鎗。\n名山久住忘衰老，惟爱桥头笋蕨长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49711,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞十二咏 其五 竹坡烟雨","author":"成鹫","text":"旧竹低垂新竹高，淡烟疏雨两萧骚。\n笋根童子窥泉脉，林下閒人罢桔槔。\n绿玉倚檐摇翠幌，冷云和梦湿缁袍。\n何堪更忆潇湘夜，剔尽寒灯闻百劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49712,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞十二咏 其六 松涧涛风","author":"成鹫","text":"一种孤高不易攀，此身只合住深山。\n养成鳞甲为龙去，化作云涛待鹤还。\n声入空林人寂寂，响归幽涧水潺潺。\n叮宁莫把松风卖，留在千岩万壑间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49713,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞十二咏 其七 镜沼荷花","author":"成鹫","text":"春雨迟开白藕花，看花人早入丹霞。\n磨砖作镜成双沼，习坎兼山总一家。\n十丈如船归玉井，半空和月印金沙。\n老僧久在山中住，待剪荷裳度岁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49714,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞十二咏 其八 丹梯铁锁","author":"成鹫","text":"凿壁扪萝上翠微，老僧见惯步如飞。\n朝随林鸟排云去，暮逐岩猿带月归。\n自恨丹梯延俗客，谁攀铁锁到山扉。\n何当截断红尘路，独占孤峰饱蕨薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49715,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞十二咏 其九 乳泉春溜","author":"成鹫","text":"石乳岩边长绿苔，水帘高捲洞门开。\n溪云入谷成山雨，崖溜添泉助茗杯。\n抱瓮春深机事息，挈瓶林下野人来。\n清泠莫逐桃花去，流入尘寰不复回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49716,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞十二咏 其十 舵石朝暾","author":"成鹫","text":"上方明相下方同，林影参差辨梵宫。\n海印光生华藏界，天鸡啼向舵盘东。\n云迎霁色先沉壑，鹤趁朝暄早出笼。\n莫道日高僧未起，阳乌曾不恕衰翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49717,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞十二咏 其十一 杰阁晨钟","author":"成鹫","text":"嵯峨高阁晓钟深，下界闻声不可寻。\n枕上一醒朝市梦，天边三答海潮音。\n曲高不入时人耳，韵苦遥传古佛心。\n一片蒲团半轮月，枯禅何事独沉唫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49718,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞十二咏 其十二 片鳞秋月","author":"成鹫","text":"片月分明属片鳞，天边何处别疏亲。\n磨成破镜为圆镜，照见今人失古人。\n指上不堪存幻见，空中无可着纤尘。\n老僧老眼常如此，一度逢秋一度新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49719,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长者峰","author":"成鹫","text":"久响高峰老古锥，名山随地见威仪。\n天花过眼能无着，霜雪盈头总不知。\n稳坐枯禅同木石，长留古镜照须眉。\n海螺吹落千山月，正是无情说法时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49720,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"锦石岩","author":"成鹫","text":"洞门开处石堂幽，咫尺丹霞在上头。\n山色一家无向背，水声千派自分流。\n云生锦石寒侵榻，风过霜林叶满楼。\n借问主人何处去，秋成时节半西畴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49721,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送无我师还里，兼柬里中诸子","author":"成鹫","text":"同游几日复离居，赠别无多意有馀。\n白发淹留非所惜，红尘归去欲何如。\n新诗近欠名山债，密约凭将故里书。\n岐路转多心转惑，从来儿女会牵裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49722,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄马卧仙","author":"成鹫","text":"寄语东林十八贤，寻思旧约过新年。\n青山一入归无梦，白首重来待有缘。\n僧似行云閒未得，官如传舍久应迁。\n何当岐路逢君处，戴笠乘车各爽然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49723,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送顿惺师分化龙护园","author":"成鹫","text":"下山原是住山翁，谩把行藏说异同。\n别院去开梅岭北，孤峰回首海螺东。\n手擎香饭千僧饱，梦破红尘万境空。\n到日不妨悬一榻，明年迟我去瞻风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49724,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞除夕与诸子守岁","author":"成鹫","text":"閒心到处不须安，借得岩居学懒残。\n拥被早为虮虱计，废书留作蠹鱼餐。\n梅妻梦里将春信，鼠妇灯边语夜阑。\n大地一时人尽老，独留孤影在蒲团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49725,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞元旦","author":"成鹫","text":"天外三更来鹤神，老翁白发参差新。\n明知昨日有今日，同是一人非两人。\n海印乍生虚室白，谷风不动明窗尘。\n兴来策杖入云去，极目莽苍何处春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49726,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送汝得师住静龙爪岩","author":"成鹫","text":"峰前峰后一家春，暂得移居事事新。\n水石平分凭地主，云霞多散与山邻。\n篅瓢小结宽容膝，曲录閒眠稳称身。\n他日寻师过龙尾，半天招手是何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49727,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"懒诗 其一","author":"成鹫","text":"雪顶鬣鬖一半灰，蒲团长日委尘埃。\n二时钟板催难起，千里书筒置不开。\n屐齿经春生白醭，杖头过雨着青苔。\n有人问客家何处，荅道俱卢洲上来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49728,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"懒诗 其二","author":"成鹫","text":"贝叶长抛不省翻，弊袍和带度寒暄。\n蠹鱼饱食成家舍，虮虱安居长子孙。\n一枕可能消白日，八行无复到朱门。\n閒云未必閒于我，来往长空不惮烦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49729,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"懒诗 其三","author":"成鹫","text":"绩凫断鹤太无端，识性同居总便安。\n窗外猿猴凭窃果，铛边猫犬任争餐。\n云连屋底和衣卧，月到床头隔被看。\n剩有多生馀习在，诗书堆里过严寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49730,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"懒诗 其四","author":"成鹫","text":"不近人情不问天，涅槃轮转且随缘。\n两条寒涕何因拭，七尺枯形任自然。\n有口只堪长挂壁，无心不拟更参禅。\n耽閒转觉多忙事，笑杀西来竺土仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49731,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞秋况 其一","author":"成鹫","text":"独住孤峰计未成，暂时安稳闭柴荆。\n移床就瀑晴还雨，倚杖看云陡亦平。\n山意送寒催老景，禅心兼懒入诗情。\n从抛笔墨烟霞外，何暇缄书寄友生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49732,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞秋况 其二","author":"成鹫","text":"跳丸踯躅去匆匆，借得岩居任岁穷。\n山与太虚分树色，石嫌孤立倩烟笼。\n高柯坠果惊寒露，病鹤移巢避朔风。\n久住不知秋已老，却缘身在桂花丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49733,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄山中诸子","author":"成鹫","text":"山缘渐密世缘疏，敢望良朋远寄书。\n地僻不知曾有雁，水清宁复叹无鱼。\n梦回冷榻闻钟后，僧老空林落叶初。\n一盏孤灯伴禅定，岂知人世有乘除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49734,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日与丹霞诸子登海螺峰绝顶，同赋用咸韵","author":"成鹫","text":"共携短策与长镵，采得茱萸手自缄。\n山路细通多宝塔，秋风先到七斤衫。\n蝉声断续吟红叶，鹤语差池下碧杉。\n岁岁重阳得如此，终身不拟别螺岩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49735,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜","author":"成鹫","text":"叶落天空月印江，牧牛人自守枯桩。\n蜗涎带壳粘墙壁，虫臂随声触纸窗。\n静坐不知山雨过，徐行直到寺钟撞。\n置身物外原无物，形影何须觅一双。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49736,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]