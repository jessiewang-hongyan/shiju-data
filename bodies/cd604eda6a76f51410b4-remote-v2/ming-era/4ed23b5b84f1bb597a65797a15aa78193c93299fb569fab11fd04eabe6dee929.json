[{"title":"毛氏楼居即事","author":"王懋明","text":"楼居山郭外，登眺起幽思。\n片雨沉江暗，孤烟上岭迟。\n雁还逢寄字，花发滞归期。\n远念吴山胜，春游恐后时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7304,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同鸿山公过思闲草堂","author":"王懋明","text":"黄叶满村巷，幽人成隐居。\n水田禾刈后，家瓮酒香初。\n地僻鸟群逸，天寒山翠疏。\n衡门笑语罢，新月映前墟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7305,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同孔加淳父诸君集时济山斋分赋得主人林馆秋","author":"王懋明","text":"寂寂扬雄宅，清凉几席虚。\n萸香馈来酒，萤死读残书。\n霜砌花仍发，风林叶向疏。\n客怀同宋玉，摇落竟何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7306,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖上隐居秋日漫兴四首 其一","author":"王懋明","text":"寂寥桑柘外，秋日赋闲居。\n天气清行药，溪声和读书。\n每于幽事遇，不觉世情疏。\n近复增颓惰，经旬发未梳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7307,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖上隐居秋日漫兴四首 其二","author":"王懋明","text":"闲来北窗下，了了见云峰。\n未释形骸累，徒怀禽尚踪。\n晤言清夜月，留客翠微钟。\n数亩长荒秽，无心学素封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7308,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖上隐居秋日漫兴四首 其三","author":"王懋明","text":"僻境但流水，秋风隐计贫。\n石门槐叶暗，茅屋豆花新。\n晚食忘兼味，天游懒徇人。\n将师广成子，澹泊葆吾真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7309,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖上隐居秋日漫兴四首 其四","author":"王懋明","text":"屡空亦自得，偃息有衡门。\n不出人间世，时为象外言。\n抚琴聊永日，艺圃任无藩。\n此意何人会，裁书与巨源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7310,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日留别诸子","author":"王懋明","text":"胜会嗟无几，同心苦易离。\n花前不酩酊，别后徒凄其。\n山鸟调新语，风杨舞弱枝。\n徘徊春渚上，落景怆分歧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7311,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬日同潜坤道丈过学士公适志园作","author":"王懋明","text":"客地罕登览，平泉聊共攀。\n到亭全见野，遵径每逢山。\n木落岩阴散，鱼藏水态闲。\n旅怀将物候，萧瑟自相关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7312,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日怀金陵旧游六首 其一 神乐观","author":"王懋明","text":"仙观青门外，尝从金马过。\n桃花霞际吐，黄鸟日边歌。\n晚酌醒池水，春衣暖径莎。\n自闻清乐后，长使梦云和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7313,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日怀金陵旧游六首 其二 雨花台","author":"王懋明","text":"长干风景地，台上每淹留。\n云树空濛色，烟江缥缈流。\n席前芳草暮，钟外雨花收。\n梦寐城南路，何年寻旧游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7314,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日怀金陵旧游六首 其三 莫愁湖","author":"王懋明","text":"去年修禊日，曾往莫愁湖。\n心醉欢娱地，春随歌咏徒。\n风花香不断，烟柳弱难扶。\n一别无由到，空悲岁月徂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7315,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日怀金陵旧游六首 其四 报恩寺","author":"王懋明","text":"禅宫雄帝里，传是报恩开。\n慧鸟闻钟聚，香霞望树来。\n塔中观世界，画里识轮回。\n远别维摩室，尘心未尽灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7316,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日怀金陵旧游六首 其五 灵谷寺","author":"王懋明","text":"匹马依丛薄，曾因访化城。\n松深藏梵响，谷杳蕴秋声。\n画壁巢禽污，萝扉倚树成。\n老僧招引处，犹记说无生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7317,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日怀金陵旧游六首 其六 西园","author":"王懋明","text":"王孙开邸第，窈窕远人寰。\n花树春连夏，楼台水杂山。\n举觞空翠里，上马月明间。\n胜赏牵情性，时令忆往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7318,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同鸿山公游吴尚宝水云居（时吴复宦京师）","author":"王懋明","text":"公子高标抗俗氛，翠微开馆坐氤氲。\n回塘暗引荆溪水，虚阁常蒸玉洞云。\n花隐房栊春不去，席依松竹昼疑曛。\n主人却有家山胜，鹤怨空岩讵忍闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7319,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送人游句曲","author":"姚咨","text":"凫舄鹤袍辞世纷，望三峰下礼茅君。\n祈年欲啖金光草，好道宁披玉检文。\n绝巘琳宫当日见，上方清磬隔花闻。\n山中倘遇陶弘景，愿乞松风与白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7320,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠邓为山","author":"姚咨","text":"移家远就古城隅，流水春来日满渠。\n踪迹已同贞士隐，殷勤不废古人书。\n当窗鸟语开帘后，泛几晴光洒翰初。\n五十为儒方自得，肯从京洛趁长裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7321,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山台晓望怀仅初不至","author":"姚咨","text":"客舍起常早，旷然思远游。\n弥伤岁华晚，来眺高台秋。\n落叶满山径，寒风吹敝裘。\n夫君独不至，湖水空悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7322,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊居自遣","author":"姚咨","text":"前溪烟水路漫漫，长日郊居性所欢。\n老去自知双鬓改，春归一任百花残。\n闲窗寂寂晴丝绕，高树阴阴鸟梦寒。\n学《易》由来谙物理，惯将消息静中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7323,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟汉武还长安","author":"唐诗","text":"汉武巡归万姓欢，旄旗千里入长安。\n铭功碣石东封毕，罢猎长杨五漏残。\n玉辇不愁驰道远，铜盘惟恐露华乾。\n阿娇金屋门还闭，万树宫花待共看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7324,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古","author":"顾梦圭","text":"雍雍云中雁，八月徂南方。\n念彼北风来，怛焉怀稻粱。\n九月气已凄，十月繁冰霜。\n生来毛羽单，高飞不成行。\n君门有钟鼓，听之徒自伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7325,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"感事","author":"顾梦圭","text":"殷王祷桑林，断爪念衍咎。\n春秋志灾眚，法戒垂不朽。\n台寺布贞纯，何必生三秀。\n笥有千岁龟，不如人寿耇。\n煌煌宝鼎歌，讵协咸英奏。\n鹖雀为鸾凤，伊人独颜厚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7326,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂拟","author":"顾梦圭","text":"妾住越江边，江花照颜色。\n清晨下机杼，日昃不停织。\n绣出双鸳鸯，邻媪屡叹息。\n采兰以自衣，掇椹以自食。\n绮户阅芳春，恋此父母侧。\n伯姊嫁五侯，少妹备宫掖。\n含羞谢良媒，掩镜长默默。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7327,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"漷县行","author":"顾梦圭","text":"入城半里无人语，枯木寒鸦几茅宇。\n萧萧酒肆谁当垆，武清西来断行旅。\n县令老羸犹出迎，头上乌纱半尘土。\n问之不答攒双眉，但诉公私苦复苦。\n雨雹飞蝗两伤稼，春来况遭连月雨。\n绵城之西多草场，中官放马来旁午。\n中官占田动阡陌，不出官租地无主。\n县中里甲死诛求，请看荒坟遍村坞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7328,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雷雪行二首 其一","author":"顾梦圭","text":"昨夜雷轰今日雪，安德门前西山裂。\n河南檄报人贪子，更闻飞蝗满江浙。\n千古高人鲁两生，汉文谦让流英名。\n精卫年年负木石，海中波浪何时平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7329,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雷雪行二首 其二","author":"顾梦圭","text":"群方水旱岁不虚，郡国正奈无仓储。\n何人建议募输粟，只恐米来民半无。\n天子亲耕后亲织，转见民间多菜色。\n明堂清庙事且迟，一土一木民膏脂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7330,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"裘葛行","author":"顾梦圭","text":"夏月行部至雷州，思制一葛且复休。\n冬月行部至廉州，思制一裘且复休。\n故衣虽穿尚可补，秋毫扰民民亦苦。\n先朝不有轩尚书，堕水忍寒却新襦。\n千缣万镪入私橐，硕鼠硕鼠心何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7331,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"感事六首 其一","author":"顾梦圭","text":"柏梁新营建章起，武帝雄心殊未已。\n金楹玉磶千万重，骀荡春光侔太紫。\n海东鞭石血横流，燕雀徜徉彩云里。\n君不见天庖椎牛犒大匠，荷锸丁夫谁馈饷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7332,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"感事六首 其二","author":"顾梦圭","text":"翩翩猎骑临边城，边城草深山路平。\n丰狐狡兔各有穴，鸣镝张罘殊不惊。\n迩来地气南徙北，广莫风至犹无冰。\n君不见桃虫拚飞即鵩鸟。\n首下尻高咎非小。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7333,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"感事六首 其三","author":"顾梦圭","text":"昭阳前殿玉树枝，荣华不奈秋风吹。\n庆云甘露永乖隔，凤管鸾箫增我悲。\n千金买得相如赋，岂识人心难转移。\n君不见楚江文鳞巧相接，复使龙阳泪承睫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7334,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"感事六首 其四","author":"顾梦圭","text":"长安一日封五侯，辉煌华毂拥貂裘。\n明珠万斛来海峤，朱邸何人中夜投。\n羊公缊袍徒寂寞，赵生击筑歌伊优。\n君不见即且甘带鸱嗜鼠，云际龙鸾自翔翥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7335,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"感事六首 其五","author":"顾梦圭","text":"鸾旌孔盖幸汾阴，丹霞紫雾瑶坛深。\n阳灵千官俨簪绂，太乙招摇皆顾歆。\n虙妃扬胪玉女笑，穰穰降康万福临。\n君不见通天洪台耀日月，未得金茎调绛雪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7336,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"感事六首 其六","author":"顾梦圭","text":"画戟门前车马稀，东市洒血沾朝衣。\n双眸只辨斗间气，中台转盼无光辉。\n华亭清泪如哽咽，月中空唤行人归。\n君不见法家火瓮吁可怖，他年恐堕厓州户。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7337,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谒康陵","author":"顾梦圭","text":"早雾笼山暝，新松匝殿稠。\n三边余武烈，八骏想神游。\n花萼皇情远，衣冠岁事修。\n伤心大官酒，犹得献千秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7338,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寒江钓雪","author":"周复俊","text":"岚云冻不飞，江水明素练。\n千林冥若空，遥峰隐还见。\n渔歌岩下起，落日声犹转。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7339,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏落叶","author":"周复俊","text":"朔风厉修坰，三浦气方肃。\n叆叆山崩云，耿耿叶辞木。\n鸑鸑下萍川，槭槭翻萝屋。\n飘飖任回环，零乱鲜羁束。\n莫以九秋凋，惋彼三春缛。\n萧条紫烟岑，超忽丹林麓。\n于兹欲何言，岁暮偃修躅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7340,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"有所思酉水舟次作","author":"周复俊","text":"去年三月滇水阴，今年二月沅州路。\n风光晼晚愁杀人，春色飘回忽迟暮。\n杨溪昨夜春泉发，竹寨沙边弄明月。\n始见繁花复乱飞，愁多不愿理春衣。\n花飞已怯伤春别，何忍还听唤子归。\n沅湘两岸垂杨碧，白日牵丝送行客。\n草际烟横浦溆香，江声千转流云长。\n梦魂惊载寤，水广何由度。\n王孙天末未归来，公子江南先有赋。\n公子王孙散夜愁，愁人难下杏花楼。\n楼台?郁回清汉，山水清圆映去舟。\n停桡日欲晚，紫嶂猿啼远。\n何处积幽思，幽思似陇坂。\n临流歌复歌，濯缨潇湘里。\n菁菁芳草心，眷余纷何已。\n浮云有时卷，草色几时结。\n相送过吴宫，殷勤向君别。\n吴宫翘望转逶迤，层层玉树荫连欐。\n芳菲帆浦迷香径，窈窕菱潭带竹池。\n万里淹仍西复东，一年凉暑春徂夏。\n春临绝屿叩文莺，晓涉空津浮白马。\n我日思归今得归，山中美人音信稀。\n东风浩荡吹梧树，极目天南鸿雁飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7341,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"落梅","author":"潘德元","text":"一从风信过元宵，南北枝头并寂寥。\n人有新妆江燕在，树无残怨粉痕消。\n难凭驿使传千里，忍使春波渡六桥。\n总有逋仙诗百首，香魂狼籍不堪招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7342,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题","author":"潘德元","text":"月向天边夜夜生，秋风何处彩云横。\n鱼无密信来青海，蟢有闲丝挂晚晴。\n春玉渐看腰似削，愁城不怕酒如兵。\n而今只合笼鹦鹉，能向琵琶唤小名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7343,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋江钓者","author":"潘德元","text":"江湖最乐是渔翁，何地无天着钓篷。\n见惯白鸥浑不避，一丝晴飏蓼花风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7344,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"临淮遇雪赠刘渐斋侍御谪居","author":"包节","text":"白简彤庭几抗章，一麾铜墨便为郎。\n关门变柳犹飞雪，县郭无花只避霜。\n云接楚山聊隐吏，地临淮海旧兴王。\n可应禁闼违长孺，帝念中都是沛乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7345,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同周岐麓台长泛西湖遂宿藕花居","author":"包节","text":"湖畔乍逢骢马使，沙行同入鹭鸥群。\n六桥水抱珠林月，两竺峰盘宝界云。\n岸柳藏莺侵坐密，园花隐麝隔溪分。\n况同佛院移莲榻，共息尘机理贝文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7346,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚望苍山即事","author":"包节","text":"吏散庭闲静掩扉，点苍西望翠霏微。\n云裁玉叶和烟润，瀑溅珠花映雨飞。\n石洞经秋龙不起，松枝将暝鹤初归。\n冷然忽动餐霞思，拟陟丹梯一振衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7347,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日雨后过陈园","author":"包节","text":"选胜遵郊郭，冲泥试杖藜。\n溪承新瀑水，山渡欲晴霓。\n看竹人先至，穿花鸟自迷。\n笑予来几度，才识小亭西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7348,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"将入京即事","author":"包节","text":"歇马津楼望禁城，凤凰宫殿郁云行。\n游人尽醉新丰酒，野树群飞上苑莺。\n山扼九关开帝阙，地萦八水绕神京。\n风前遥度钧天乐，疑是君王御紫清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7349,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜","author":"包节","text":"凄清旅馆寂，徙倚对明河。\n庭树销潘省，寒虫避翟罗。\n雁归砧响急，烽至角声多。\n不寐殷忧者，长更奈若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7350,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和董紫冈","author":"莫如忠","text":"频年不复赋秋悲，秋尽江城昨始知。\n身向闲居宁论拙，客来问字久无奇。\n中厨黍熟焚枯后，小阁樽开酿菊时。\n闻道窥园犹懒性，肯携吟兴过东篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7351,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"即事吊古","author":"莫如忠","text":"驿路红梅始着丛，春光将半未全融。\n蓬扉曙色经冬雪，麦陇余寒尽日风。\n残劫有灰秦故国，疏钟笼月汉离宫。\n古来无限兴亡慨，莫倚肴函百二雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7352,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"留都","author":"莫如忠","text":"一自先朝敕守臣，千秋鱼钥锁流尘。\n班休禁旅讥诃卒，头白中珰给扫人。\n泰畤有基松橡合，寝园无狩鹿麋驯。\n只余云气时来往，想忆离宫望幸辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7353,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋晴泛舟过董家舍","author":"张祥鸢","text":"秋水碧如玉，秋树红于花。\n酒船缘岸转，溪路逐村斜。\n菱荇乱柔橹，凫鹥{巾狎}浅沙。\n所亲居近远，隔浦问人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7354,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新秋泛舟过西庄听雨话旧三首 其一","author":"张祥鸢","text":"放船秋水落，能载两三人。\n坐爱清波影，轻摇白氎巾。\n到门才系缆，藉草便垂纶。\n野饭无兼味，嘉鱼色胜银。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7355,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新秋泛舟过西庄听雨话旧三首 其二","author":"张祥鸢","text":"蓬蒿长门径，客到旋教锄。\n稚子炊菰米，邻家馈野蔬。\n浦沙云淰淰，梧竹雨疏疏。\n草阁昼如水，坐听儿读书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7356,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新秋泛舟过西庄听雨话旧三首 其三","author":"张祥鸢","text":"历历龆年事，分明昨与今。\n不因清话久，那悉故情深。\n岁月且迟暮，官曹宁陆沉。\n所欣同巷陌，伏腊每招寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7357,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"重阳后庭中晚步","author":"张祥鸢","text":"丛菊几枝吐，重阳昨夜过。\n美人别我去，怀抱奈秋何。\n月露闲阶砌，衣裳旧薜萝。\n手携小儿女，顾影舞婆娑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7358,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五月望潞河舟夜","author":"张祥鸢","text":"潞水雨余涨，燕山云外微。\n又圆篷底月，频换客中衣。\n路近心逾急，乡遥梦亦稀。\n汉京冠盖满，怀抱欲何依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7359,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渡淮春晓","author":"张祥鸢","text":"朝辞桐柏水，时序又殊方。\n河抱中原转，天围远树苍。\n绪风啼鸟变，红雨落花忙。\n坐惜春芳晏，高歌西日黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7360,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早春野望","author":"张祥鸢","text":"新水没渔矶，遥林收夕霏。\n柴门堪小立，沙鸟自孤飞。\n腊闰梅花早，官休宾客稀。\n所欣元夕近，不夜月辉辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7361,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"园居","author":"张祥鸢","text":"人境重重隔，溪流宛宛分。\n竹阴飞翠雨，花气结晴云。\n篱缺牵萝补，园芜植杖芸。\n禽言能细译，幽事赖先闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7362,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同韩双湖泛舟访直峰昆季","author":"张祥鸢","text":"野航坐知己，尽日话闲情。\n木落青山远，波澄白鸟明。\n扬帆沙岸过，吹笛浪花生。\n知近高人宅，横塘竹外清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7363,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初夏晓起","author":"张祥鸢","text":"已知无客到，亦复启晨扉。\n刺水新秧长，从人乳燕飞。\n书声隔篁竹，荷气透絺衣。\n百亩欣常稔，无嗟生事微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7364,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨晴晚步","author":"张祥鸢","text":"晚霁乘轻屐，溪遥步落花。\n夕阳低草阁，烟水带渔家。\n巢暖鸦雏长，风柔燕子斜。\n无嗟红似雨，新绿喜交嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7365,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"积雨","author":"张祥鸢","text":"积雨蓬门掩，连阴草阁凉。\n荷香池上榻，云气竹间凉。\n岸岸新流没，村村湿雾黄。\n钓船迷去住，长系短篱傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7366,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"省夜","author":"张祥鸢","text":"袅袅明河带苑墙，萧萧乱叶下微霜。\n风回寒柝沉遥堞，天近疏钟出未央。\n共过汉庭方贵少，可知颜驷尚为郎。\n一官无补思田里，岁晏南中橘柚黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7367,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]