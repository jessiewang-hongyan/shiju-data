[{"title":"舟次横浦","author":"德清","text":"五云一水入南安，万叠山回六六滩。\n行到水穷山尽处，梅花无数岭头看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58785,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梨花山鹧","author":"文徵明","text":"物华无赖酒初醒，奕奕梨花照晚晴。\n怪底山禽啼不歇，十分春色近清明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58786,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"有感","author":"马閒卿","text":"春风零落后，秋圃恨开迟。\n总是宜男草，傍人也未知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58787,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采莲","author":"孟淑卿","text":"风日正晴明，荷花蔽洲渚。\n不见采莲人，只闻花下语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58788,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏凤仙花","author":"林娙","text":"凤鸟久不至，花枝空复名。\n何如学葵蕊，开即向阳倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58789,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画小景","author":"德清","text":"风雨孤舟夜，微茫草树春。\n茅檐惊犬吠，定是渡江人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58790,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画","author":"德祥","text":"碧柳丝丝拂钓舟，溶溶水面一群鸥。\n不知谁在茅堂住，坐看青山到白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58791,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟泊","author":"善学","text":"江静雨初收，湖光滑似油。\n岸如随棹转，山欲趁波流。\n牵兴多浮荇，忘机足野鸥。\n夜闻渔父笛，吹破一天秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58792,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪航","author":"朱之蕃","text":"江天凝望六花飞，控带峰峦玉作围。\n独棹扁舟凌浩渺，更搴篷幔弄霏微。\n惊鸥万点冲芦起，翔鹤千群挟浪归。\n煮酒烹鲜渔唱发，披裘醉卧失寒威。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58793,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登车行","author":"清濋","text":"擎书使者来海涯，蹑晓迫趣登轮车。\n高冈碾断赤石骨，长空拂碎红云花。\n大声坎坎打天鼓，小声呜呜煎春茶。\n羲生驭日信可并，阿香撒雨何足誇。\n直入九重紫金殿，玉皇对坐倾流霞。\n霓裳羽衣万变态，龙笙凤管相喧哗。\n从容握手问至道，掀髯一笑吾还家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58794,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观象台铜浑天仪刻漏","author":"钟惺","text":"制出何人手，年标异代君。\n篆成蝌蚪迹，斑上鹧鸪纹。\n古瓦栖朝露，孤楹抱宿云。\n九金来禹牧，七政准尧文。\n候较吹葭审，躔从累黍分。\n当时甘石辈，心目太精勤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58795,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"日星晷","author":"周玉箫","text":"八节晨昏子半时，极星出地较高卑。\n君心不似天经纬，日日归垣定不移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58796,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钱箧","author":"瞿佑","text":"器小才堪贮百千，也胜扑满费陶甄。\n书生纸裹真堪笑，邻女香囊亦可怜。\n野步不须鞋上系，市沽何用杖头悬。\n画叉更有黄州竹，取用随时合自然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58797,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周国雍参藩寄红罽衣赋此为谢","author":"朱多炡","text":"万里蚕丛亦浣纱，使君缄赠自三巴。\n濯残秋水天孙锦，染尽春山杜宇花。\n懒集芰荷成短褐，閒过祗树混袈裟。\n相思几上江边阁，却捲珠帘坐暮霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58798,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"箨冠","author":"朱之蕃","text":"龙孙头角旧青霄，蜕甲斑纹永不凋。\n偃月制成笼短鬓，切云剪就映高标。\n都门挂后名心净，湖曲归来逸兴骄。\n酒漉葛巾慵更著，行吟搔首自逍遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58799,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七月寄衣","author":"董少玉","text":"雁鸿何处飞鸣，满目萧条黄草。\n书来先寄寒衣，风雨太原秋早。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58800,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游仙曲","author":"屠瑶瑟","text":"银台珠树是仙家，绮阁晴娇四照花。\n不用安妃裁蜀锦，铢衣多剪赤城霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58801,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"裁衣","author":"董少玉","text":"芙蓉江北雁飞飞，燕子矶边人未归。\n只怕沈郎腰已瘦，迟回难寄旧时衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58802,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鲛绡帕","author":"瞿佑","text":"茧结扶桑出海滨，远随机杼倩鲛人。\n不裁洛浦凌波袜，能代湘川拭泪巾。\n紫麝熏香收汗润，彩毫传恨寄情真。\n吴绫轻薄番罗俗，出袖宜同掌上珍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58803,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠鞋生","author":"溥洽","text":"父子相传履制奇，青丝细软合时宜。\n声随鸣佩君王识，影落飞凫太史知。\n泥滓乍离归隐计，香云才振上升期。\n年来敝屣无心弃，却笑干将补较迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58804,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居杂咏","author":"释大香","text":"接叶阴阴唤水鸠，花坪草堰偶经游。\n芒鞋晒向西岩石，露冷烟凄不记收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58805,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谢张直卿以铁如意见遗","author":"朱多炡","text":"土花斑驳锦模糊，一片寒冰出锻炉。\n致向书中称折角，捉来石上稳跏趺。\n提携起舞旋长袖，慷慨酣歌缺唾壶。\n多谢司空饶博物，祗愁无地击珊瑚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58806,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹如意","author":"朱之蕃","text":"斲取铿金戛玉枝，不资型范自离奇。\n坚持劲节羞茅靡，挥霍虚心与物宜。\n花雨争飞从握手，閒云静看独支颐。\n客来指点潜身处，免作长竿渭上垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58807,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"松麈","author":"朱之蕃","text":"捉柄从誇手玉如，青松振鬣自萧疏。\n折来偏助谈锋劲，挥处犹看翠霭舒。\n谢却猩红休染涴，留将鳞甲莫捐除。\n清风谡谡浑忘倦，朗月澄怀坐碧虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58808,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"捣衣石","author":"瞿佑","text":"一方滑净绝苔钱，才属秋闺响便传。\n长夜未央风阵急，美人相对月华圆。\n高于凤阙黄金础，厚胜花阶绿玉砖。\n几度晚凉眠不得，丁东声到客愁边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58809,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铁笔行为王元诚作","author":"王守仁","text":"王郎宋代中书孙，铸铁为笔书坚珉。\n画沙每笑唐长史，拔毫未数秦将军。\n高堂落笔神鬼怒，九万鸾笺碎如雾。\n铅泪霏霏洒露盘，金声铮铮入秋树。\n鸟迹微茫科斗变，柳薤凋伤悲籀篆。\n鼓文已裂岐阳石，漆灯空照山阴茧。\n王郎笔艺精莫传，几度索我东归篇。\n毛锥不如铁锥利，吾方老钝君加鞭。\n矢尔铁心磨铁砚，淬锋要比婆留箭。\n太平天子封功臣，脱囊去写黄金券。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58810,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日李氏东堂同长蘅观曝图画张伯夜贻画笔柬谢","author":"程嘉燧","text":"秋云杲杲天景澄，高堂与客翻湘藤。\n潇湘水阔愁嘉陵，江花有情遥沾膺。\n閒门此时无人应，紫毫一束烦高朋。\n鸡距脱手新锋棱，未忍用点屏间蝇。\n青松短檠临层冰，颠崖老树云门僧，貌君布袜予行縢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58811,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊毫笔","author":"瞿佑","text":"毛颖年深老不能，中书模画叹难胜。\n管城忽现左元放，草泽不容严子陵。\n壁上榴皮功可述，门前竹叶事无凭。\n刚柔何必吹毛问，耐久真堪作友朋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58812,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谢车叔铭寄笔","author":"德祥","text":"寄来名笔自湖州，珍重斋中什袭收。\n早晚翻经有僧到，芭蕉先种待新秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58813,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"纸","author":"毛钰龙","text":"家住稽山剡水头，陈玄毛颖忆同游。\n荣封楮国金符在，尺素修成五凤楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58814,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题毕钵山图","author":"陈继儒","text":"毕钵罗峰回入霄，不通猿鸟不通樵。\n横空独木如飞栈，半月山人一换桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58815,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画","author":"李日华","text":"霜落蒹葭水国寒，浪花云影上渔竿。\n画成未拟将人去，茶熟香温且自看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58816,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题自画秋林平远","author":"张宇初","text":"北苑高情宿世同，疏林汀渚正秋风。\n砚池洒墨应多思，写向寒烟夕照中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58817,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画","author":"守仁","text":"积雨平原烟树重，翠厓千丈削芙蓉。\n招提更在秋云外，只许行人听晓钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58818,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻霜钟","author":"张宇初","text":"霜满琼林度晓钟，月华流韵彻晴空。\n投簪几忆鸿鸣露，欹枕犹惊鹤唳风。\n银叶香消深馆里，梅花调远古城东。\n十年感慨成无寐，应律音长岂世同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58819,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与僧一然听钟","author":"廖孔说","text":"寥寥相对一灯明，数尽遥钟百八声。\n题向山堂成故事，他年却好话平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58820,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻钟","author":"廖孔说","text":"华阳百里一孤钟，地阔天空山万重。\n飒沓烟霜悠飏月，依微随鹤绕三峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58821,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨夜闻箫","author":"叶小鸾","text":"纱窗徙倚倍无聊，香烬熏炉懒更烧。\n一缕箫声何处弄，隔帘微雨湿芭蕉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58822,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江村","author":"法聚","text":"残阳在木末，远鸟下孤屿。\n渔舟归未归，吹笛芙蓉渚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58823,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻笛","author":"德祥","text":"江花如雪绕江春，江水迢迢入梦频。\n一夜东风有横笛，满城都是惜花人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58824,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"好溪渔歌","author":"来复","text":"少微山下万松青，铁笛携将过水亭。\n吟得竹枝新有谱，秋风吹与老龙听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58825,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对琴","author":"明显","text":"对琴不见琴，忘琴听琴响。\n坐久听亦无，云飞树尖上。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58826,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"八音 其一","author":"朱之蕃","text":"土牛鞭后见春回，群木勾萌早放梅。\n吹彻匏笙鸣瑞凤，挝将革鼓隐轻雷。\n竹抽新笋穿阶出，花惹游丝隔苑来。\n采得茶归烹石鼎，不妨中夜醉金杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58827,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"八音 其二","author":"朱之蕃","text":"雪积郊原湿土膏，撼风古木更牢骚。\n诗裁竹屋吟偏壮，酒煖匏尊兴转豪。\n指迹分明穿革履，腰围增减试丝绦。\n衾裯抱石难成寐，听彻金鸡午夜号。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58828,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镜囊词","author":"许篈","text":"江上女儿当窗织，染得深潭千丈黑。\n什袭珍包入尚方，五丁输取归东国。\n几年箱箧有馀香，为君裁作明镜囊。\n囊里青铜明似月，镜中玉貌春花光。\n青铜可磨石可转，惟有此心终不变。\n欲识中情长忆君，日日揭囊看镜面。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58829,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镜","author":"毛钰龙","text":"样出秦宫制，团团宝月回。\n虚空开物象，心迹远尘埃。\n影覆香罗帕，光生碧玉台。\n绣囊鸳鸟并，珍重嫁时裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58830,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉镜台","author":"朱之蕃","text":"铸出江心满月悬，擎来宝玉琢蓝田。\n鸾台接席清辉炯，蟾魄临窗灏彩圆。\n莫道连环谐旧约，休从杵臼觅良缘。\n婵娟绣阁新妆就，眉妩依稀对洛川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58831,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赐扇","author":"张位","text":"冠剑联鳷鹊，天风满建章。\n宠光临白羽，节序届朱阳。\n捧给罗中使，新裁总上方。\n传宣天语近，披拂舜薰长。\n不向三秋至，终令什袭藏。\n愿言清惠溥，尽使热中凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58832,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"以邛竹杖寿程孟孺母","author":"朱多炡","text":"龙飞葛陂渚，鸠刻汉王宫。\n未若山中竹，天然林下风。\n一枝供燕喜，万里自蚕丛。\n历尽峨嵋雪，深知节操同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58833,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书尺","author":"顾清","text":"文木裁成体直方，高斋时伴校书郎。\n坐摊散帙资弹压，风动残编待主张。\n叶叶展舒迎雪牖，行行指点照萤囊。\n但知持正无偏倚，尺寸何劳计短长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58834,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜光杯","author":"朱之蕃","text":"髻螺盘绕隐东洋，吸得瑶空宝月光。\n孕出圆珠能照乘，剖开素质待飞觞。\n晶瑩绝胜金樽艳，华彩浑添玉液芳。\n浮白江天遥骋望，酒星垂耀正更长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58835,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹簟","author":"朱之蕃","text":"纹如流水滑如脂，一片清光漾碧漪。\n凉思入帷移翠影，轻烟萦帐拂霜姿。\n采真湘浦窗间梦，写兴淇园枕上诗。\n欲避炎蒸何处是，石屏横展对芳池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58836,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"纸帐","author":"朱之蕃","text":"慵飞兔颖厌涂鸦，联向书帷好蔽遮。\n四面轻云萦柏子，一窗斜月映梅花。\n峭寒无隙难容入，清梦常安不受哗。\n葆得气完神亦固，吴绫蜀锦为谁誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58837,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"决明甘菊枕 其一","author":"朱之蕃","text":"警枕神劳石枕寒，无如药裹最相安。\n剖来珠蚌光堪掬，采积金英秀可餐。\n布被煖香欺锦帐，竹床清气敌蒲团。\n休论返黑方瞳炯，熟寝通宵即大丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58838,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"决明甘菊枕 其二","author":"朱之蕃","text":"梦醒化蝶尚蘧蘧，腹坦肱横两足舒。\n青炯双瞳还映水，绿添短发渐盈梳。\n地钟灵卉充高枕，天付幽香媚隐居。\n供帐从今誇雅丽，床头閒却读残书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58839,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华顶","author":"释大香","text":"海色迢迢半紫氛，娑椤开落夏将分。\n道人清晓下山去，纸被一床铺白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58840,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"香印","author":"瞿佑","text":"量酌香尘尽左旋，曾烦巧匠为雕镌。\n萤穿古篆盘红燄，凤绕回文吐碧烟。\n画内仅容方寸地，数中元有范围天。\n老来无复封侯念，日日移当绣佛前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58841,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"烧香桌","author":"瞿佑","text":"雕檀斲梓样新奇，雾阁云窗任转移。\n金兽小身平立处，玉人双手并抬时。\n轻烟每向穿花见，细语多因拜月知。\n有约不来閒凭久，麝煤煨尽独敲棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58842,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"印香盘","author":"朱之蕃","text":"不听更漏向谯楼，自剖玄机贮案头。\n炉面匀铺香粉细，屏间时有篆烟浮。\n回环恍若周天象，节次同符五夜筹。\n清梦觉来知候改，褰帷星火照吟眸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58843,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"香篆","author":"朱之蕃","text":"水沈初试博山时，吐雾蒸云复散丝。\n忽漫书空疑锦织，相看扫素傍灯帷。\n萦纡细缕虫鱼错，断续残烟柳薤垂。\n几向螭头闻阖殿，罗襕携出凤凰池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58844,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"剪烛","author":"德祥","text":"风处摇金蛹，烟时闪墨鸦。\n寸心终不昧，双泪欲横斜。\n渐过分诗刻，虚开报喜花。\n剪声初落指，满席散春霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58845,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鞋灯","author":"瞿佑","text":"弓样新裁瘦不禁，分明一掬照花阴。\n凌波未试弯弯玉，踏月还生步步金。\n红蕾先开传密意，赤绳双系结同心。\n少年前度相看处，唯恨鞦韆别院深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58846,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"斗鸡灯","author":"瞿佑","text":"怒挟争机下绛台，月明照见影毰毸。\n彩鸾舞镜肠应断，丹凤迎阳尾乍开。\n五德有名终气合，两雄相厄未心灰。\n孟韩联句谁能续，烧尽东风画烛煤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58847,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石琉璃","author":"朱之蕃","text":"瑞石瑩然冰雪姿，琢成宝月半如规。\n骊珠出海光犹湿，牛渚燃犀照不遗。\n丈室明涵金色界，禅关朗映白毫眉。\n蒲团坐看炉烟袅，天禄何烦太乙藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58848,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"烛影","author":"屠瑶瑟","text":"画梁疏影按红牙，光入花丛比桂华。\n时伴琼筵翻广乐，乍浮纨扇隔轻纱。\n溶溶春夜疑宵永，闪闪秋闺共月斜。\n散尽缠头天欲曙，清光犹照五侯家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58849,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灯词","author":"袁九淑","text":"家家行乐管弦催，火树千枝向夜开。\n见说南邻祠太乙，笑声一片踏歌来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58850,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"烟火戏","author":"瞿佑","text":"天花无数月中开，五色祥云绕绛台。\n堕地忽惊星彩散，飞空频作雨声来。\n怒撞玉斗翻晴雪，勇踏金轮起迅雷。\n更漏已深人渐散，闹干挑得綵灯回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58851,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒火","author":"朱之蕃","text":"腾空烈焰挟灰飞，望里荧煌煖气微。\n禅性定馀传指灭，客心燃后御风归。\n烹来石髓凉侵齿，著尽霓裳冷切闱。\n入火化人元不爇，徒劳炙手借炎威。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58852,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"茶烟","author":"瞿佑","text":"濛濛漠漠更霏霏，淡抹吟屏羃讲帷。\n石鼎火红诗咏后，竹炉汤沸客来时。\n雪飘僧舍衣初湿，花落觥船鬓巳丝。\n唯有庭前双白鹤，翩然趋避独先知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58853,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]