[{"title":"观水","author":"贝琼","text":"布谷村村急，三时农务勤。\n青山十日雨，白水一溪云。\n即恐崩沙坼，遥知小圃分。\n朝来自潋滟，凫雁动成群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋泾雨后二首 其一","author":"贝琼","text":"地蟠吴会尽，天与海门通。\n雨洗秦山碧，霜侵越树红。\n居人分绝岛，飞鸟度寒空。\n极目情何限，翻如入剡中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋泾雨后二首 其二","author":"贝琼","text":"石润冬犹热，江潭晚乍晴。\n楼台消蜃气，鼓吹入蛙声。\n且伴双鸥逸，何须驷马荣。\n交游今总绝，酌酒任吾生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"二月十三日初度","author":"贝琼","text":"知非吾已晚，白首尚他乡。\n不入广文馆，宁要太守章。\n宽忧应有物，却老信无方。\n谩忆儿童岁，斑衣父母傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒食三首 其二","author":"贝琼","text":"出门皆白水，风雨复通宵。\n忽似三川涨，惟忧万室漂。\n娟娟轻鸟下，泼泼大鱼跳。\n叹息佳人阻，空瞻乌鹊桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒食三首 其三","author":"贝琼","text":"为客云间久，深怀父老情。\n江山元壮丽，城郭又清明。\n传烛初分火，吹箫竞卖饧。\n重携一樽酒，花下试因倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五月十六夜独坐","author":"贝琼","text":"大野喧豺虎，深林集羽毛。\n天空云气尽，夜久月轮高。\n士卒悲秦戍，儿童唱董逃。\n此时空感慨，漂泊叹吾曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登云间驿楼次李颜韵","author":"贝琼","text":"万国干戈里，荒荒野日曛。\n残唐终五季，炎汉亦三分。\n战伐求颇牧，讴歌忆舜文。\n伤时一惆怅，倚柱送孤云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青林道中","author":"贝琼","text":"葭菼连云暗，菱荷逐水漂。\n青林千曲转，黄浦一支遥。\n贾客晨冲雾，舟人夜听潮。\n何时免行后，黄发老渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重过亭林","author":"贝琼","text":"欲访曾游地，楼台半有无。\n夕阳明鸟背，秋水落龙须。\n为客今成老，逢人亦暂娱。\n夜归冲暝色，重问顾亭湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊申九日宴邵武叔双桂轩","author":"贝琼","text":"晚香迎九日，秋色胜三春。\n惊座非无客，倾城况有人。\n且听歌白苧，莫惜岸乌巾。\n更觉清狂甚，不知谁主宾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀语溪旧业","author":"贝琼","text":"不到溪南宅，桃花又一春。\n长贫疑造化，已老厌风尘。\n直道难容世，虚名只误人。\n扁舟即归去，吾岂恋秋莼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十一月九日夜饮南山所用筼谷韵赋诗","author":"贝琼","text":"水国潜鳞静，风林倦翼回。\n夜深云掩月，春远雪封梅。\n剪烛清谈久，藏钩急令催。\n山僧更多意，莫惜尽馀杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34632,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽溪南处士 其一","author":"贝琼","text":"天地消兵气，江湖陨客星。\n群英同日起，一叶向秋零。\n伏胜终秦士，杨雄老汉庭。\n尚思风雨夜，纵酒共忘形。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34633,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽溪南处士 其二","author":"贝琼","text":"不废专门学，犹存盖世功。\n时危明出处，道在任穷通。\n节士无元振，诸郎有阿戎。\n九山云气冷，何处葬仙翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34634,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒夜","author":"贝琼","text":"月落江天黑，长风正怒号。\n灵鸡寒史次，别雁瞑呼曹。\n击拆征人起，鸣机织妇劳。\n所思千里隔，十二碧峰高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34635,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巳酉元旦 其一","author":"贝琼","text":"不改山河旧，同瞻日月新。\n百虫未启蛰，一鸟已鸣春。\n白发羞明镜，乌纱制小巾。\n吾生任贫贱，击壤学尧民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34636,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巳酉元旦 其二","author":"贝琼","text":"岁旦屠苏酒，还从稚子先。\n宫花元不称，野服更相便。\n出处宁非道，穷通莫问天。\n红梅亦多意，为我发馀妍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"以韵邵筼谷千山夜泊","author":"贝琼","text":"一水疑无路，才通艓子舟。\n连山分秀色，绝境散穷愁。\n行与月相逐，卧看天倒流。\n野人应不识，林鸟自相求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春杂诗 其二","author":"贝琼","text":"不见春归路，倦登江上楼。\n五更愁听雨，三月惨如秋。\n寂寂紫含笑，嘤嘤黄栗留。\n无心自相恼，岂识老夫忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春杂诗 其四","author":"贝琼","text":"汎汎江湖上，悠悠宇宙中。\n一身常有患，万化本无穷。\n已觉丹砂妄，唯应白发公。\n沧浪还可濯，闲伴钓鱼翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄翰古清 其一","author":"贝琼","text":"一苇三江度，人皆识道林。\n龙公来听法，狐女试观心。\n雨散空花乱，风生万竹深。\n我惭牵世务，白发谩盈簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄翰古清 其二","author":"贝琼","text":"为客长如醉，听诗忽已醒。\n共餐香积饭，更舍劫初铃。\n扫榻还堪卧，呼舟约再经。\n黑龙休易点，破壁起雷霆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遇妓","author":"贝琼","text":"曾是梨园籍，年应未破瓜。\n春风一枝雪，别是汉宫花。\n出茧脩眉淡，蟠龙小髻斜。\n琵琶写幽怨，流落共天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"旧宅","author":"贝琼","text":"甲第无人住，萧萧风雨寒。\n树阴交绣户，苔色上来栏。\n舞鹤犹思主，鸣蛙亦为官。\n豪华易消歇，都作梦中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寺居","author":"贝琼","text":"堪怜小儿女，相对色凄凉。\n有客夜元亮，无人候子桑。\n水萤飞宝地，山鸟入书堂。\n九曲溪头路，何时上小航。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"溪上","author":"贝琼","text":"歇马城边路，茅茨在眼中。\n迢迢一水静，寂寂四山空。\n白日西南没，青天上下通。\n行人俱已息，独立数飞鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34646,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨鸣鹤顾留宿殳山有诗相示用韵荅之","author":"贝琼","text":"转蓬悲杜甫，命驾愧张翰。\n把酒忘年老，听诗坐夜阑。\n不趋龙尾道，休上虎须滩。\n白屋真堪乐，青山且共看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34647,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题山阴读书处","author":"贝琼","text":"兰亭脩禊处，爱尔好林泉。\n闭户不曾出，读书浑少眠。\n青山秋气蚤，绿树午阴圆。\n何日期相过，西陵一问船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34648,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛春二月十日偕桑子材丁一鹤游殳山","author":"贝琼","text":"野旷夫无际，山青雨乍晴。\n路从鳌背上，人踏凤毛行。\n谡谡松风细，辉辉竹日明。\n浩歌犹未已，新曲和流莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34649,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"澄林客居二首寄良佐沈复东 其二","author":"贝琼","text":"高人戴安道，词客沈休文。\n共喜成三友，何劳比五君。\n园荒葵自种，水近竹宜分。\n钟鼎非吾事，山中看白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34650,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题紫微山严上人壁","author":"贝琼","text":"鸡声催客起，一枕梦初醒。\n日射千山赤，天垂四野青。\n芙蓉元自好，蒲柳已先零。\n海上兵戈后，夷歌不思听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34651,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中漫成寄九龙山人","author":"贝琼","text":"稚圭蛙两部，日夜成笙歌。\n四月雨声恶，两山秋气多。\n青苔生客舍，白水落官河。\n怅望九龙客，扁舟难重过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34652,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵杨德中见寄","author":"贝琼","text":"五月大江满，白波如白云。\n看山重约客，载酒试从君。\n竹所宜频扫，桃源或未闻。\n龙蛇今已远，麋鹿任为群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34653,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵杨鸣鹤游紫微山一首用章孝标韵","author":"贝琼","text":"金刹藤萝外，通人一径微。\n天风铁凤语，海雨墨龙飞。\n水落仙翁井，云收玉女衣。\n东楼曾玩月，夜挟彩鸾归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34654,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠医者徐仲纯","author":"贝琼","text":"我爱南州士，风流今尚存。\n读书通鲁史，卖药向吴门。\n拟乞丹砂裹，同倾绿酒樽。\n茯苓应己长，夜雨斸松根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34655,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈楚宾赴泗州学正","author":"贝琼","text":"舟行入淮泗，初上广文官。\n地接中州近，天连大野宽。\n清时先俎豆，异俗尽衣冠。\n暂别蓬莱阙，无惭苜蓿盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34656,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题苏明远画","author":"贝琼","text":"绝境疑无路，平川不起涛。\n天光兼水阔，山势敌秋高。\n葛令惟求药，秦人自种桃。\n云霞如有意，他日待吾曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34657,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中次韵张思广助教见寄二首 其一","author":"贝琼","text":"为客金陵久，惊秋素发乾。\n酒狂山简放，诗苦孟郊寒。\n野圃荒谁理，宫衣病总宽。\n封书寄儿子，早晚发长干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34658,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中次韵张思广助教见寄二首 其二","author":"贝琼","text":"有泪如银烛，心灰却始乾。\n空瞻鸿雁远，不念鹡鸰寒。\n江海浮吴阔，乾坤入楚宽。\n登楼重拟赋，落日在阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34659,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云卧","author":"贝琼","text":"谢传东山下，白云窗户幽。\n身如蝉蜕解，梦挟凤车游。\n石润初收雨，衣寒已怯秋。\n无心信舒卷，天地日悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34660,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵管郑州玄泽","author":"贝琼","text":"相逢俱一笑，官不补遗馀。\n鸾凤随新曲，龙蛇见草书。\n日边来使者，濠上只空庐。\n更展胸中学，平明对玉除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34661,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题叶经历水北山居","author":"贝琼","text":"地接天台胜，山围雁荡高。\n诗人同谢眺，羽客见卢敖。\n树色分厓翠，江声应海涛。\n何年此栖托，莲叶好时操。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34662,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送曹季材赴京师因寄刘子宪助教 其一","author":"贝琼","text":"跨马金陵去，征衫尚有尘。\n壮心知烈士，离色惨羁人。\n草白方经晓，花殷欲借春。\n殷勤一杯酒，何日重相亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34663,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送曹季材赴京师因寄刘子宪助教 其二","author":"贝琼","text":"最爱刘公干，同为太学师。\n班联金马客，兴在玉台诗。\n地阔双鱼断，天空一雁驰。\n惟看千里月，夜夜独相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34664,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏炭","author":"贝琼","text":"三日淮南雪，乌薪价重银。\n色疑成鹁鸽，形肖刻麒麟。\n夜照清虚室，春扶老病身。\n煮茶留好客，未觉孟郊贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题马文壁画二首 其一","author":"贝琼","text":"龙江今喜对，雁荡昔曾闻。\n树黑深藏雨，山青半出云。\n行人知虎迹，仙客问羊群。\n老我来何日，林泉定许分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题王白云画","author":"贝琼","text":"璚台人去后，麋鹿自成群。\n树湿才经雨，山昏又出云。\n仙家三叠外，春水一支分。\n独坐扁舟客，棹歌时远闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午早秋漫兴二首 其一","author":"贝琼","text":"久作东山客，山空少四邻。\n汲泉从老圃，隔岭见行人。\n虎豹应须远，鸡豚亦自驯。\n幽栖犹未稳，更访武陵春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午早秋漫兴二首 其二","author":"贝琼","text":"烂熳蕣花早，乱开篱落间。\n秋风机杼动，夜雨桔槔閒。\n牧豕公孙老，思鲈记室还。\n有时逢野叟，犹自说朝班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书事二十韵","author":"贝琼","text":"父老歌延祐，君臣忆至元。\n清光回日月，喜气入乾坤。\n不意经沦丧，相图事并吞。\n橐驼空大漠，骐骥死中原。\n浪信传三捷，深忧病七奔。\n关中防豕哭，河内且蜂屯。\n流血今千里，伤心远五门。\n羽衣悲弟子，宝玦泣王孙。\n管葛真难致，孙吴莫易论。\n如何轻大业，俱是窃殊恩。\n近报中台坼，遥瞻北极尊。\n狐狸号白昼，魑魅啸黄昏。\n贡赋时时急，征徭处处繁。\n故园荒草径，何处觅桃源。\n野外朱旗闪，城头画角喧。\n飘零从老去，局促偶生存。\n醉忆刘琨舞，狂兴阮籍言。\n登临空洒泪，去住总销魂。\n水国秋鸿落，霜林夜鹊翻。\n相知共南北，不得问寒温。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34670,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李子庚挽诗","author":"贝琼","text":"屡入元戎幕，曾陪御史骢。\n一身辞汶上，万里入闽中。\n东观文章妙，西平将略雄。\n艰危真自许，敢决更谁同。\n斩马求藩剑，号猿拓楚弓。\n行师百道静，破贼两关通。\n拟复尧封大，重开汉业隆。\n触蛮犹苦斗，鹰隼若为笼。\n重雾朝埋日，长星夜陨空。\n柱天徒有志，填海竟无功。\n已并田畴义，皆知葛亮忠。\n江风吹独树，山月照幽宫。\n英气宁为土，神光或吐虹。\n尚怜诸子在，国士有遗风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34671,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题空翠轩","author":"贝琼","text":"万竹如云盛，琅玕起石边。\n分枝巢翡翠，解箨化蜿蜒。\n黑映潇湘雨，青浮鄠杜天。\n含滋团队露，倒影漾清涟。\n不柰蝉号夜，深期凤至年。\n小冠知隐者，虚室候神仙。\n月上南荣坐，风清北牖眠。\n壁鱼乾缥帙，海鹤操朱弦。\n结友多裘仲，封侯薄渭川。\n忘形日相对，秀色更娟娟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34672,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟香奁八咏 其一 黛眉颦色","author":"贝琼","text":"才歌愁易敛，欲画思难任。\n雨过峰犹湿，春归柳未深。\n汉宫休竞学，秦镜莫重临。\n不是嫌施粉，翻疑病捧心。\n曲如天上月，纤似树头禽。\n尽日窥青锁，如何别到今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34673,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟香奁八咏 其二 香赖啼痕","author":"贝琼","text":"何限相思泪，年年苦别离。\n当春羞客见，终日为君垂。\n落粉和双玉，残红界一丝。\n仙人辞汉日，公主嫁胡时。\n凤蜡流应少，鲛销拭已滋。\n空弹银甲尽，却恨锦书迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34674,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟香奁八咏 其三 花尘春迹","author":"贝琼","text":"罗袜淩波小，潜行辇路中。\n东风吹不散，南陌去谁同。\n艳想莲双拆，痕留月半弓。\n定知争拾翠，应怕践残红。\n喜蝶无情扑，灵犀有意通。\n如何珠百琲，小妾妒翔风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34675,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟香奁八咏 其四 云窗秋梦","author":"贝琼","text":"朦胧歌玉枕，蛩语夜何长。\n羽化为胡蝶，神游蹑凤皇。\n金屏残宿火，翠被怯新霜。\n不识天涯路，相逢马上郎。\n关山度辽水，云雨会巫阳。\n不奈风铃搅，惊回月半床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34676,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟香奁八咏 其五 绣床凝思","author":"贝琼","text":"丁香花百结，宛转若为生。\n蛱蝶描初半，鸳鸯刺未成。\n重将藕丝续，独看柳花行。\n入户羞双燕，停针怪一莺。\n那知天女巧，翻为雪儿轻。\n困懒春犹剧，无人识此情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34677,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟香奁八咏 其六 金钱卜欢","author":"贝琼","text":"字忆开元日，清光尚自全。\n不知人远近，犹似汝方圆。\n一别乌衣后，三回白雁前。\n芳心偷自祝，吉语定真传。\n玉兆符龟灼，银河待鹊填。\n可能如子母，无术学神仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34678,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟香奁八咏 其七 月奁匀面","author":"贝琼","text":"新妆自时世，宝镜拂尘埃。\n妒雪重施粉，看花莫近台。\n春风玉树并，秋水白莲开。\n瘦怯空光照，娇怜颜色回。\n初酣妃子酒，更点寿阳梅。\n有约西园会，邻娃不用催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34679,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟香奁八咏 其八 金盆沐发","author":"贝琼","text":"发乱朝新沐，兰汤试手慵。\n年衰空自洁，人远为谁容。\n花委随飞凤，水动浴蟠龙。\n到地青丝滑，掩月黑云浓。\n向日晞初薄，临风绾更松。\n休疑华山女，此地复相逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34680,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"·对雨","author":"贝琼","text":"朝云才触石，夜月又从星。\n霹雳开三峡，滂沱覆四溟。\n宽忧称兕爵，志喜续麟经。\n即恐蛟龙怒，那知蜥蜴灵。\n润添禾黍色，清挹芰荷馨。\n战伐今应息，讴歌且复听。\n常希流麦凤，诚聚读书萤。\n倚丈前村望，平波绿满汀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34681,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛亥岁烧灯日张彦皋携酒相过与杨鸣鹤丁一鹤陈仲谋及诸门生十有二人共饮回以笙歌归院落灯火下楼台分韵赋诗余得归字","author":"贝琼","text":"节过传柑后，馀寒袭故衣。\n雷从梅上尽，春向柳边归。\n且复从人饮，何须密妓围。\n金吾犹不禁，鹦鹉试频挥。\n上客推文靖，仙翁得令威。\n交游知有道，笑语共无机。\n细雨朝还作，高云夜不飞。\n玉箫停凤曲，银烛继蟾辉。\n但觉新欢治，应知旧事非。\n莫辞同潦倒，良会古来稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34682,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙辰立春日大雪二十韵在凤阳作","author":"贝琼","text":"正月淮南雪，空花五叶纤。\n随风成唾王，平地出形盐。\n重拆鸳鸯瓦，轻穿翡翠帘。\n色迷云外鹤，光掩月中蟾。\n河水冰犹合，昆冈火复炎。\n方圆如有道，先后亦无嫌。\n岁旱今方剧，春寒更觉添。\n夜深声淅沥，天近气清严。\n鲛女愁停杼，鸡人误报签。\n一时延胜赏，万里入遐瞻。\n路失羊肠曲，山呈马耳尖。\n炊烟空近市，急溜断虚檐。\n林鹊饥争啄，川鱼畏却潜。\n往来听杖屦，歌舞起闾阎。\n研冻诗重赋，瓶存酒试拈。\n节高贫士卧，时信老农占。\n独树危能立，枯黄润总沾。\n宫妆梅粲粲，野秀麦蔪蔪。\n白首歌谁和，朱门味可兼。\n谩思全帐客，痛饮正厌厌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34683,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]