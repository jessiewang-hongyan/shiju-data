[{"title":"御君兄内子妆阁被火敬唁以诗八首 其三","author":"王彦泓","text":"写得梅花绝代姿，吴绫染遍翠虬枝。\n始知钿阁烟飞夜，妙画通灵变化时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30223,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"御君兄内子妆阁被火敬唁以诗八首 其四","author":"王彦泓","text":"鸾鎞犀导总成尘，散朗高情一笑轻。\n侍女拨灰重拾得，瑶钗白凤尚如生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30224,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"御君兄内子妆阁被火敬唁以诗八首 其五","author":"王彦泓","text":"明珠辟火语空传，多少江靡堕紫烟。\n此夜枕前真不夜，步生莲是火中莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30225,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"御君兄内子妆阁被火敬唁以诗八首 其六","author":"王彦泓","text":"炒薪已并扊扅空，一箸雕胡甚日同。\n话到不因人热处，始知夫婿是梁鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30226,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"御君兄内子妆阁被火敬唁以诗八首 其七","author":"王彦泓","text":"中郎坟籍痛飞灰，赖有文姬诵忆来。\n更得赏心高韵事，爨烟声裹辨琴材。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30227,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"御君兄内子妆阁被火敬唁以诗八首 其八","author":"王彦泓","text":"戒律精持事法王，清心高出宝莲香。\n但存冰雪孤标在，火宅何妨是道场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30228,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柬诟逋者","author":"王彦泓","text":"狞须健仆递邮筒，叫唤何如此醉翁。\n学得无愁天子法，战书虽急不开封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30229,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送阮逸孺之塞外逸孺故诸生忽有从军之志","author":"王彦泓","text":"湖海元龙气不除，悲歌宁为食无鱼。\n厌看博士租驴券，奋读匈奴缚马书。\n天子自欣栽苜蓿，秀才何暇恋菰芦。\n毛锥不必轻投却，会向燕然一展舒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30230,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"残岁即事 其一","author":"王彦泓","text":"梅檐霜苦月来迟，又到停灯剪胜时。\n出意自描新样子，丁宁休报小姑知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30231,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"残岁即事 其二","author":"王彦泓","text":"雪霁寒新腊八天，侍儿擎烛过妆前。\n肉糜旧话重拈起，引得红腮一笑嫣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30232,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"残岁即事 其三","author":"王彦泓","text":"红篆桃符白板扉，瓶梅写影上床帷。\n芦帘纸阁清相称，不羡氍毹作地衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30233,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"残岁即事 其四","author":"王彦泓","text":"满城箫鼓嫁人天，裘马郎君意气鲜。\n独有当年我惆恨，逢新偏忆旧缠绵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30234,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"残岁即事 其五","author":"王彦泓","text":"亦有偷啼向镜台，合欢杯是断肠杯。\n张郎画笔无心试，暗提王家扇子来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30235,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"残岁即事 其六","author":"王彦泓","text":"手提金箸拨炉红，暗教恩私一岁中。\n首忆惊心试灯夜，一声轻嗽画屏东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30236,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"残岁即事 其七","author":"王彦泓","text":"文袜清彄手自缄，重毫丝履绣鹣鹣。\n心知饷姊须珍重，别上菱花镜一奁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30237,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"残岁即事 其八","author":"王彦泓","text":"谢灶新添一瓣香，终年欢赏费茶浆。\n天公定恕风流罪，不藉君侯为讳藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30238,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"残岁即事 其九","author":"王彦泓","text":"拼取无眠守岁华，听残竹炮几千家。\n鸡鸣尚伴熏炉坐，自扎同心柏子花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30239,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"残岁即事 其十","author":"王彦泓","text":"纱笼椽烛焰如幢，火齐呈花喜一双。\n为惜轻风吹烬落，晓妆成后未开窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30240,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"残岁即事 其十一","author":"王彦泓","text":"金雀鸦鬟尚簸钱，残年犹是柳枝年。\n鬟多力弱春消息，渐到眉心眼角边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30241,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"试笔","author":"王彦泓","text":"自笑猖狂浪得名，吟笺犹未破新正。\n新欢到手身难暇，尤物当前命易轻。\n闺阁裙衫争雪色，比邻丝管斗春声。\n诗家窠臼宜翻洗，人日慵拈薛道衡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30242,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"感旧","author":"王彦泓","text":"收拾残书剩几篇，轻狂踪迹廿年前。\n笑倾犀首花间盏，醉掉蛾眉月下船。\n黄祖怒时偏自喜，红儿痴处绝堪怜。\n如今兴味销磨尽，剩爱铜炉一炷烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30243,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"豪筵即事","author":"王彦泓","text":"语鸟名花粤海供，平泉歌舞甲城中。\n何家食箸无黄颔，赵氏眠茵有绿熊。\n灯烛乱疑星陨雨，椒兰飘似雾从风。\n迷楼别有堪迷处，螓首蛾眉院院同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30244,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"问答词阿姚 其一","author":"王彦泓","text":"双睛点漆面凝酥，笑靥愁蛾一世无。\n愿作君家扫除隶，一生长拜美人图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30245,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"问答词阿姚 其二","author":"王彦泓","text":"爱郎珍重转愁深，底样酬郎一片心。\n一自读郎诗句后，去年消瘦到如今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30246,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"问答词阿姚 其三","author":"王彦泓","text":"一旬长遣十函书，勤向高堂问起居。\n每就个中衔数字，暗传心事与心奴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30247,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"问答词阿姚 其四","author":"王彦泓","text":"见说王郎骑到门，同袍先已暗窥人。\n无端脸晕无端笑，逗得痴情渐渐真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30248,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"问答词阿姚 其五","author":"王彦泓","text":"情痴自信定非痴，思重真拚命一丝。\n想煞昨宵灯暗后，满身香雾近人时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30249,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"问答词阿姚 其六","author":"王彦泓","text":"相逢切莫径遮阑，眼耳丛中一笑难。\n要识寸心相喻处，明明如月任郎看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30250,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"问答词阿姚 其七","author":"王彦泓","text":"坐绣严闺女伴稠，笑谈时颇涉风流。\n明知阶底萧郎立，度彻金针未转头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30251,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"问答词阿姚 其八","author":"王彦泓","text":"眉梢眼尾自矜严，一顾愁君忆倍添。\n偏是热肠翻似冶，莫云全为避猜嫌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30252,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"问答词阿姚 其九","author":"王彦泓","text":"多谢云英一碗浆，玉纤长沁瀹茶香。\n劳卿更为先尝看，暗度樱桃味与郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30253,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"问答词阿姚 其十","author":"王彦泓","text":"观君犹自有童心，无乃钟情尚未深。\n若是果将奴郑重，莫相调笑路旁金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30254,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"问答词阿姚 其十一","author":"王彦泓","text":"知暗恼说是多情，情到多时处处轻。\n幸我生平颇情寡，陡然迷惑为卿卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30255,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"问答词阿姚 其十二","author":"王彦泓","text":"意密形疏自幼闻，情深那更厌离群。\n人间多少双飞侣，未必如侬切念君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30256,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"问答词阿姚 其十三","author":"王彦泓","text":"红笺烧过字千张，泪点牢收帕一方。\n无计徘徊归去也，一生赢得一思量。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30257,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"问答词阿姚 其十四","author":"王彦泓","text":"银瓶酒尽不堪筛，妾泪如波溅玉杯。\n莫恨此番孤负去，好寻方便为奴来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30258,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"问答词阿姚 其十五","author":"王彦泓","text":"到死相寻意已坚，莫教赍恨下黄泉。\n浮盟浪约三年过，病喘还知剩几年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30259,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"问答词阿姚 其十六","author":"王彦泓","text":"密绪还须对面论，意中言语意中人。\n饶他青鸟殷勤诉，不似郎诗道得真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30260,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"归自东游至亡妻旧馆","author":"王彦泓","text":"下弦征客上弦归，狼籍梅花入户飞。\n柑果涉春都烂败，兰薰经月尚馡微。\n床空潘令悲长簟，浴罢桓郎念故衣。\n麈拂任从东壁挂，尘筵鼠迹未烦挥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30261,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"代所思别后阿姚 其一","author":"王彦泓","text":"相逢羞涩怕猜嫌，别去那知怅恨添。\n独对镜奁空怏怏，乍拈针剪复恹恹。\n梦魂弱絮从风乱，心绪系花被雨沾。\n悔不暂留欢且住，未妨长隔一重帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30262,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"代所思别后阿姚 其二","author":"王彦泓","text":"手把钿钗侍镜台，销魂人处尺书来。\n行间小印关心看，摺后余文背面开。\n迸泪欲揩犹未敢，廋词捷悟更防猜。\n长将袖却从漫灭，每到幽窗展一回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30263,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"代所思别后阿姚 其三","author":"王彦泓","text":"刚剩残梅几片飞，全枝都似伴郎归。\n风波狭路惊团扇，花月空庭泣浣衣。\n翠被半闲来梦晚，绣窗无暇报书稀。\n湔裙不为春韶出，贪遇停船旧石矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30264,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"代所思别后阿姚 其四","author":"王彦泓","text":"隔窗姊妹唤朝眠，好梦关心记未全。\n守定誓盟金鸭畔，望穷书信纸鸢边。\n文犀领扣新偏脆，绣雀鞋帮旧更鲜。\n每到百花生日日，未曾凄闷似今年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30265,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"代所思别后阿姚 其五","author":"王彦泓","text":"墙头金柳罩儿家，窗掩轻寒六扇纱。\n心病倦挑心字领，睡鬟松落瑞香花。\n园林霁爽初煎酒，院落阴沉好斗茶。\n莫负一川春水绿，支机人望正浮查。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30266,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"访孝先韬仲龙山精合即事 其一","author":"王彦泓","text":"萧寂空山与性宜，那知闺阁有调饥。\n过从老衲花深处，递进羁孤月好时。\n笑甚不妨杯没帻，谈余赢得饭成糜。\n经书只办三余了，未碍春园乍一窥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30267,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"访孝先韬仲龙山精合即事 其二","author":"王彦泓","text":"剪取春山入草堂，窗棂疏洁闭浓香。\n画来丘壑才相称，到咏襟情所独长。\n五夜烟煤疑佛卧，六时螺鼓笑僧忙。\n下帏不踏空庭月，辜负瑶阶似截肪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30268,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"连日醉游用孝先禊日韵二首 其一","author":"王彦泓","text":"风情浪拟杜司勋，烂熳狂踪远近闻。\n泼翠岩峦三代器，艳新花鸟六朝文。\n那辞蜀洒扶头醉，为伴湘兰竟体芬。\n任是春城能火禁，退红香焙定须焚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30269,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"连日醉游用孝先禊日韵二首 其二","author":"王彦泓","text":"闲看缟髻笑青枫，亦有红氍坐药丛。\n画舫帘衣凭雪藕，玉筝弦索见春葱。\n才人履屐能俱妙，贵客林亭惜未工。\n自是昔贤情调浅，风流争肯受诗穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30270,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"载送孝先往龙山时殇玉树同人为之悼绝孝先洒然也","author":"王彦泓","text":"庭院松风类隐居，晨昏钟梵绕精庐。\n自知灵运前成佛，谁笑康成后挟书。\n浮世本无堪喜恨，高人未易可亲疏。\n情钟我辈难忘处，悟却楞伽尽扫除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30271,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"读孝先禊日诗因赠","author":"王彦泓","text":"两纸新书楔日题，莫愁哦讽露琼犀。\n通怀不作杨彪瘦，与故那令束皙迷。\n道上客休歌薤露，座中吾愧读雌霓。\n兰亭尚逊君超绝，为说彭殇未易齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30272,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"即事赠荆文始段砺如两姊夫","author":"王彦泓","text":"杯水俄兴滟滪波，锦袍恩分近如何。\n休嫌张耳朋欢薄，止笑袁耽姊妹多。\n花底追游长作队，酒边排调竟传讹。\n解围安用聊城矢，只倩胡笳一曲歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30273,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"砺如索书扇上","author":"王彦泓","text":"白皙专城略有须，凝之原不羡封胡。\n手推自喜调家婢，头责能容谑姊夫。\n书问敬通能寄否，琴逢潘岳肯弹无。\n衰门未有孙郎气，幸免人嫌将种粗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30274,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"戏以乡音用韵","author":"王彦泓","text":"幽谷花寒瘦影焭，东风偏为发鲜荣。\n腰身楚楚孙荆玉，口齿泠泠郭语琼。\n合德性醇能事姊，延年技贱愧称兄。\n持裙尚恐仙乎去，更倩红鸾绶带萦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30275,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"即事","author":"王彦泓","text":"行近风香近绣丛，雪衫飞溅唾绒红。\n横波不待回头见，庄语能传暗喜通。\n晓阁平临春色上，夜灯遥映雨声中。\n残阳记得人行处，白石阑干折向东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30276,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"追和唐女冠鱼玄机十二韵","author":"王彦泓","text":"闺门文采羡玄耽，更有青溪妹第三。\n生小不窥青琐合，家常希换白单衫。\n钗梁风定虫犹颤，裙衩花深蝶竞衔。\n雅谑引经推郑婢，狂诗送抱想吴男。\n红儿诗里欢兼恨，素女图前笑带惭。\n想见隔屏声矻矻，似闻昵枕诉諵諵。\n加餐意托琉璃匕，寄札愁凭玳瑁篸。\n岂有鹊头能助忆，愿为鸡舌与君含。\n遥猜踪影心先妒，未接言辞性已谙。\n体自生香防姊觉，眉能为语任郎参。\n发光可鉴千盘滑，唇味如饴一啮甘。\n记得那时偷近处，唾绒红点碧窗南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30277,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"个人","author":"王彦泓","text":"睡破眉山不更描，鬓鸦堆上覆鲛绡。\n屏间记曲拈红豆，窗下临书染绿蕉。\n画出鸳鸯娱独自，教成鹦鹉伴无聊。\n情悰暗被傍人觉，绣线逢春减几条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30278,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"错认","author":"王彦泓","text":"白縠单衫玉步摇，香风相引见云翘。\n灯前抛接回波眼，帐底围量束索腰。\n夜视可怜明似月，秋期只愿信如潮。\n情知不负周郎顾，莫问儿身第几乔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30279,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏所见","author":"王彦泓","text":"似燕身材称著绯，琵琶弟子性灵希。\n戏拈上客题花笔，学踏邻娥织素机。\n桁下衣笼薰豆蔻，镜前香泽渍蔷薇。\n何曾房老能勾管，日暮西池斗草归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30280,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无聊二首 其一","author":"王彦泓","text":"风情退减久无诗，研匣书笺罥网丝。\n魇语梦魂闻婢唤，恶愁怀抱恐儿知。\n酒于痛饮非真适，情向新欢未肯痴。\n惆怅旧游携手处，木樨天气独来时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30281,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无聊二首 其二","author":"王彦泓","text":"把书移枕近床棱，叹息观涛病未能。\n怯暑心情犹喘月，背时风调独怀冰。\n无劳天女持花散，有愧高人选药称。\n肯过小楼言笑否，不嫌同上第三层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30282,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菰川纪游用元白体","author":"王彦泓","text":"一队明妆拥碧油，罗衣风影照溪流。\n郊原紫翠今秋早，亭馆青红近日修。\n谢女捉将团扇出，潘郎扶得板舆游。\n司香侍史携犀合，卷袖厨娘用玉钩。\n彩胜虫鱼工剪刻，牙盘橙笋细雕镂。\n绯桃布席苔侵袜，银鹿移琴柳拂头。\n萍景波中抛果核，桐阴石上置茶瓯。\n纵横一榻陈箫管，历乱三巡送酒筹。\n捧砚久知荑玉冷，擎觞兼度眼波秋。\n唾花落点鱼争竞，髻蕊烘香蝶逗遛。\n临水偶来同倚槛，隔花何路可登楼。\n殷勤子敬能持楫，佻达齐姬欲荡舟。\n何处雪檐期射鸟，此时河岸似牵牛。\n青莎径软鞋踪浅，紫桂堂深浴室幽。\n小院竹凉清枕簟，疏窗松荫暗棋楸。\n笺纨就手巾箱取，细翠随身镜匣收。\n归路别穿红叶径，同袍犹隔白苹洲。\n也知重向灯前见，难诉佳游一段愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30283,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏东邻栀子花","author":"王彦泓","text":"露湿琼姿映日鲜，离披弱态益嫣然。\n香宜九子钗边嗅，蒂合同心带上悬。\n织女淡妆傅缟素，徐娘私赠见诗篇。\n佳名更喜同之子，栽定东家倍可怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30284,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和戈庄学自寿四韵","author":"王彦泓","text":"几株幽树寄婆娑，尽意看云弄水波。\n野衲每求名画去，邻墙时有浊醪过。\n吟成未出芦花被，钓罢犹披槲叶蓑。\n可许拿舟亲问字，相从日饮更无何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30285,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"藤村旧游二首 其一","author":"王彦泓","text":"重奠麻筵一束刍，往来曾此醉茱萸。\n未能默记书千箧，空忆通灵画一厨。\n座上琴亡悲子敬，家中砚去吊林逋。\n铜台泪眼犹西望，分得名香在也无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30286,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"藤村旧游二首 其二","author":"王彦泓","text":"金锁横衔废苑门，水亭窗槛半沉沦。\n铜钉换醉供群竖，花桨为樵给四邻。\n碧甃晒余高凤麦，画廊堆遍买臣薪。\n羊昙哭罢无人问，泪墨难题满壁尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30287,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"遇旧青衣","author":"王彦泓","text":"扫眉才子女相如，旧掌芸香四库书。\n一著练裙抛画裤，便辞金屋住茅庐。\n桑麻僻处莺花断，丝竹停来姊妹疏。\n还识劈笺江令否，望仙回望一唏嘘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30288,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]