[{"title":"超然台","author":"张棨","text":"结驷湖山上，凭高亦快哉。\n昔年曾赏塔，今日却登台。\n神拂岚光动，杯倾野色开。\n俗情应可解，长集此徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14411,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山飞来寺 其一","author":"郑金","text":"绿树丛中留寺古，白云堆里伴僧閒。\n听泉定后心如水，理钓归来月满关。\n狮子空教存怪石，环猴何事出人间。\n赏心未了跻攀兴，指点犹疑海上山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14412,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山飞来寺 其二","author":"郑金","text":"云房有约度烟萝，支遁逍遥更几过。\n点点雨花临钓石，纷纷山翠落龙磨。\n仙台路杳春游少，古洞云深昼掩多。\n圣世偷閒惟大睡，南山白石更谁歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14413,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重游阴那寺 其一","author":"翁思佐","text":"十载重来谒上方，依稀犹似旧僧堂。\n当时猿鹤如相迓，今夜随人明月乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14414,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重游阴那寺 其二","author":"翁思佐","text":"共眠一榻在山隈，去住明朝不自裁。\n请看窗前松月白，早时曾向西中来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14415,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小金山话别","author":"温新","text":"古寺中流出，烟波四面通。\n金山楼控海，石阁磴凌空。\n繫艇登临处，披襟眺望雄。\n斜阳催去棹，回首白云丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14416,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱社怀赵太史","author":"陈宏采","text":"谁辟郊原野径通，清虚时沐此堂中。\n千年箓授神仙秘，一代名高太史风。\n自向赤霄归玉舄，长留紫气护琳宫。\n几回杖履探真诀，尺五遥瞻托暮鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14417,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"行行复行行","author":"梁绘","text":"行行复行行，丈夫志四方。\n讵敢念离别，而遗君子伤。\n晨兴掩妆镜，为君理轻装。\n呼邻沽美酒，携手上高堂。\n晋卮双寿母，欲语神先怆。\n姑视妾如女，妾视姑如娘。\n奉姑勤妇事，如女依娘傍。\n三千主中馈，羹饭娱姑嫜。\n所忧在白发，畏子摧肝肠。\n行行复行行，驱车陟高冈。\n袅袅堤边柳，阴阴陌上桑。\n送君自此归，相思今日长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14418,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书家信后寄弟絅","author":"梁绘","text":"雁影愁分久，鱼缄愧覆迟。\n语多频续纸，情至竟无诗。\n宦况萦心绪，离怀感鬓丝。\n君须重努力，莫负盛年时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14419,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春即事","author":"梁绘","text":"政暇春江暮，官閒吏渐稀。\n黄庭摹旧拓，白袷试新衣。\n对酒惜花落，捲帘惊蝶飞。\n举头天欲语，云气助山巍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14420,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋江夜泊","author":"梁绘","text":"苦绪离怀静夜分，素琴聊以抚湘君。\n一天江色鱼吞月，万里秋声雁入云。\n静悟宦场官亦梦，力攻愁垒酒能军。\n维舟未觉依山树，落叶萧萧不可闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14421,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庾楼","author":"梁绘","text":"一时佳兴与人同，千古高楼矗碧空。\n锁钥尚严天险外，箜篌无复月明中。\n秋惊野鹤寒寻梦，浪拥江豚夜拜风。\n玉麈埋尘名胜在，几回搔首晋西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14422,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋望","author":"梁绘","text":"暮烟横郭远，返照入江虚。\n独倚孤篷外，秋山红叶初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14423,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拔秧","author":"梁绘","text":"栽秧复拔秧，拔秧去恶草。\n恶草碍良苗，芟除故宜早。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14424,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"野话","author":"梁绘","text":"偶逢野老向瓜棚，瓦钵盛茶话月明。\n坐久不知衫袖湿，半天凉露落无声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14425,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游小金山 其一","author":"梁天锡","text":"鳌耸青葱江上台，芙蓉环碧画图开。\n日浮金影波心见，蜃逐潮声海角来。\n坡老昔参禅性定，粤灵今喜使舟回。\n凭虚不尽登临兴，北望天峰紫翠嵬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14426,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游小金山 其二","author":"梁天锡","text":"览胜招提花蔓陀，中流天设此灵波。\n千峰列戟侵云出，五月浮槎载酒过。\n落魄有怀添杞梦，清平随地听康歌。\n江湖廊庙心无别，胥祝东南海不波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14427,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来寺","author":"黄鳌","text":"绀宇遥飞入洞门，砂床石室俨桃源。\n长松雨霁双巢鹤，峭壁岚消一啸猿。\n榻倚半云僧独卧，江涵中宿客重援。\n浪游十载浑何补，且涤尘襟共避喧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14428,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游南华寺","author":"黄鳌","text":"黄梅一夕蚤传灯，宝刹宏开上乘僧。\n明镜非台心月峭，风幡不动法云澄。\n芳溪暝涨群猿渡，古树阴秾独鹤升。\n安得霞踪如尚子，閒从竹径漫支藤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14429,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金鸡献瑞","author":"姚守辙","text":"羽人家却在丹丘，鸡放云峰最上头。\n早唤三农春梦醒，寒冲八表月光浮。\n南来海阔无函谷，北望山高忆凤楼。\n奇甸太平今有象，和声夜夜满忠州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14430,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"文笔生华","author":"姚守辙","text":"五指伸来笔一尖，建州泰运属先占。\n孤高气概齐华岳，熣灿文光逼玉蟾。\n雨露长滋千古润，风霜不改九秋严。\n精华信是乾坤瑞，遥耸中原作巨瞻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14431,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"建江澄碧","author":"姚守辙","text":"遥从黎婺浚源头，环抱孤城据上流。\n白芷绿蓠春冉冉，落霞孤鹜晚悠悠。\n鱼龙听曲波心跃，舟楫穿星镜面游。\n独立苍茫增叹赏，朝宗一派海门秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14432,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泵井涵清","author":"姚守辙","text":"盘据神龙吐玉涎，山灵朝暮护云烟。\n直从太华分玄酒，不数牂牁占醴泉。\n解愠啜甘随满腹，涓流溥利下平田。\n年来我绝千金想，愿借清泠洗俗缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14433,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湳白渔歌","author":"姚守辙","text":"落落那能系此踪，生涯江上任飘蓬。\n云开棹破芦花月，浪静歌生莼菜风。\n魂梦动随流水淡，沙鸥盟狎友情浓。\n几回醉醒烟波阔，还觉山高日未红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14434,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夕阳牧唱","author":"姚守辙","text":"短笠疏林百事轻，驯徒群牧两忘情。\n芦笳空谷无腔调，乾糗蒙泉不和羹。\n纵剧舞残春草绿，赓歌声逐晚风清。\n夕阳归去浑无事，梦入高秋兆有成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14435,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潭览晴云","author":"姚守辙","text":"飞鹑风动涉晴沙，锁翠云深景欲赊。\n五色别开新锦绮，一湾长抱旧人家。\n捲舒浓淡堪图画，拥蔼红黄换物华。\n烟水休云三岛隔，且输耕读得生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14436,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仙屯夜月","author":"姚守辙","text":"万里无云天宇宽，仙峰海外月光团。\n琼枝未稳南飞鹊，玉兔长调不老丹。\n龙戏明珠归巨海，鹤翻清影傍高坛。\n银河若借张槎泛，直驾长风入广寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14437,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠东溪叟张嵩","author":"薛尚学","text":"云树森森映碧沙，清溪几曲拒人家。\n溪翁倒坐溪槎上，落日栖迟弄晚霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14438,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游七星岩 其一","author":"梁景先","text":"怪石崆峒倚碧空，白云深锁水晶宫。\n清流影蘸梅花月，紫陌香飘菡萏风。\n山列画屏金错落，岩悬星斗玉玲珑。\n凭高未尽登临兴，更上天台第一峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14439,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游七星岩 其二","author":"梁景先","text":"迟日看云上画楼，芙蕖香软暗香浮。\n空濛山色千岩雨，潋滟湖光十里秋。\n独鹤一声归华表，宾鸿斜照度沧洲。\n月明载弄江门笛，吹落梅花兴未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14440,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其一 石室龙床","author":"梁景先","text":"石床深处有龙蟠，钟乳参差滴溜寒。\n岩壑虚灵容久蛰，芳春霖雨看瀰漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14441,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其二 沥湖渔棹","author":"梁景先","text":"潋滟湖光水拍天，渔蓑野艇日蹁跹。\n磻溪已应非熊兆，还有羊裘钓泽边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14442,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其三 虹桥雪浪","author":"梁景先","text":"蓦地东风卷怒涛，桃花春浪禹门高。\n垂虹直下三千尺，冉冉金钩钓巨鳌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14443,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其四 天阁晴岚","author":"梁景先","text":"重重画角倚天开，满目风烟不易裁。\n独凭危阑看云物，七星罗列拥三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14444,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其五 金阙朝阳","author":"梁景先","text":"玄宫高敞碧云头，金阙千龄锁弱流。\n鸡唱未沉西崦月，东溟浴日紫烟浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14445,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其六 宝陀夜月","author":"梁景先","text":"风摇紫竹翠交加，般若台空转法华。\n漫对冰壶看水月，蟾光满地浸梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14446,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其七 星亭拥翠","author":"梁景先","text":"天开图画好溪山，星聚亭依水石间。\n锦绣丛中堆翡翠，白云深处听潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14447,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其八 霞岛飞琼","author":"梁景先","text":"海上仙山涌翠鬟，流霞淡荡露漙漙。\n琼华三岛春狼籍，时有飞泉响佩环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14448,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其九 树德松涛","author":"梁景先","text":"万壑松风涌翠涛，千岩飞雪度江皋。\n游人载酒春如海，何处吹笙醉碧桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14449,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其十 栖云榕荫","author":"梁景先","text":"乔木凌云积翠华，浓阴满地护琪花。\n瑶池石上开图画，玉宇琼楼不必誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14450,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其十一 蓬壶仙径","author":"梁景先","text":"岧峣仙径接云霄，谁驭飞廉上铁桥。\n东去扶桑应不远，石门烟锁自迢迢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14451,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其十二 紫洞禅房","author":"梁景先","text":"西竺传经海上来，禅房经藏共徘徊。\n不知飞锡游何处，薝卜花香月满台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14452,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其十三 临壑荷香","author":"梁景先","text":"香风蔼蔼日晴和，十里红蕖蘸碧波。\n沥水湖边长载酒，月明犹听采菱歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14453,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其十四 方塘鱼跃","author":"梁景先","text":"一鉴方塘沁碧漪，潜鳞游泳见真机。\n悠然莫道鱼非我，此乐庄生共得之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14454,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其十五 杯峰浮玉","author":"梁景先","text":"孤峰秀出七岩东，突兀平川荡漾中。\n银海光浮金菡萏，冰壶冷浸玉芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14455,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其十六 天柱流虹","author":"梁景先","text":"岩高天柱玉嶙峋，碧渚如虹绕汉津。\n剩有桃源在深处，带花流出武陵春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14456,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其十七 仙掌秋风","author":"梁景先","text":"秋空仙掌现云端，疑是金茎捧露盘。\n月出明珠悬玉腕，西风吹影逐飞鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14457,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其十八 阆岩夕照","author":"梁景先","text":"洞门深锁瘴烟收，斜日苍茫紫翠流。\n千里空明频入望，平原芳草暮云浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14458,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其十九 阿坡泉涌","author":"梁景先","text":"药室璿房逦迤开，横空苍翠自崔嵬。\n石泉涌出如飞练，万顷黄云染绿苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14459,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩二十景 其二十 石洞云封","author":"梁景先","text":"千寻怪石自崆峒，钟梵时闻烟蔼中。\n欲向丛祠访神女，洞门回首白云封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14460,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉虚宫","author":"梁景先","text":"玉虚宫殿锁崔嵬，石磴棱层峭壁开。\n波漾琉璃环汉渚，山横翡翠接蓬莱。\n琪林风细香烟袅，碧落云深剑影猜。\n笑指丹厓寻羽客，桃花流水自天台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14461,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天柱岩","author":"梁景先","text":"维石岩岩耸太空，擎天柱在粤之东。\n高于衡岳三千丈，秀出罗浮四百峰。\n山戴金鳌环碧渚，泉流玉蝀绕珠宫。\n巨灵此峙原深意，欲镇炎荒壮九重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14462,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"栖云亭","author":"梁景先","text":"亭下波光绿染苔，亭前山色翠成堆。\n蜃凝楼阁空中见，鳌驾蓬壶海上来。\n瑶草日随钟乳长，琪花秋傍石阑开。\n道人铁笛吹杨柳，冉冉香风落酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14463,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒伏波庙","author":"梁景先","text":"祠堂郁郁锁烟萝，忆昔英雄马伏波。\n铜柱勒名留越绝，楼船兵甲下牂牁。\n谗丛薏苡黄金铄，宠盛椒房白玉讹。\n一笑东平恰画像，云台公论意如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14464,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游南华寺","author":"黄器先","text":"名园缥缈寻给孤，韶石磊落似砗磲。\n灵鹫宝林皆飞走，西域天竺东来储。\n刹土毫光万里照，雁荡灵湫寓梵书。\n韶州之北舜张乐，韶州之南佛结闾。\n白象辚囷兽蟠地，朱门灼烁金为居。\n香藤古树曹溪口，美室良田鹫岭初。\n诸天高阁鸣钟磬，半夜长廊击木鱼。\n累朝受敕帝为护，八圣延光皇作誉。\n法宝螭文首天语，虞书周诰锡当宁。\n眷兹大鉴属全智，故来一人谓起予。\n况今纷纷学孔辈，视为月窟奔蟾蜍。\n阙里沙门道非隔，南华东鲁近通渠。\n三千万忆周儒释，缝掖袈裟互卷舒。\n杏坛菀茂当兰若，作礼威仪比曳裾。\n小子何当来忏悔，跏趺踧踖复与与。\n叹息孔庙蔑由至，遥瞻曲阜帝农墟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14465,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九仙山","author":"黄器先","text":"昔年去看山，手扳万仞如飞猿。\n今年去看山，循循咫尺如蚰蜒。\n彭殇老壮真倏忽，安得在世尝酡颜。\n武彝天寿皆往昔，九仙户牖反泫然。\n为因兹山禀神秀，天池绝顶吐涓涓。\n昆仑瑶池此渗液，星宿下注基流元。\n腴田绘地来灌溉，琪枝琳草殊翩翩。\n高比泰华耀南极，俯视南溟如杯盘。\n九仙列坐九拳石，团团似挹池之边。\n樵竖相传每如此，名称至今雄九仙。\n青龙玉华皆子姓，神姿异骨得奇权。\n上游飞驰作门户，回环百里分墙垣。\n日月风雷悉经此，飞鱼宿豹藏般般。\n昔年宅兆居其下，尝欲祭海先河源。\n偶修郡志乃搜入，招提亦与记灵园。\n灵台灵沼半天上，巀嶭畏忌劳间关。\n非疑四愁在此处，何因平子发之叹。\n盖由宿昔好奇胜，功名不慕慕游山。\n襄阳冠盖不愿往，愿从庞公采药还。\n而今老病在山下，抱朴松风听之间。\n帘泉石楼不可到，安不泪下如流泉。\n于戏，天地可望不可即，谩期两腋习习生风翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14466,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉华山","author":"黄器先","text":"玉华山如玉笋开，屋连华盖张三台。\n道士开坛礼北斗，九仙嶂下訇清雷。\n是时玉皇正宣敕，命我老人寿南极。\n茅屋不惊风雨来，子孙长大贡天樯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14467,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"青龙山","author":"黄器先","text":"青龙山前山似园，浑如八阵开旌?。\n孔明久在隆中卧，水口有山如虎逻。\n日日看山烟雾中，又如狮子舞春风。\n滚滚抛毬何处去，观君恐是天边御。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14468,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊径","author":"黄器先","text":"羊径肠应曲，行人大不宁。\n胆矾来鸭绿，铁宝闪银青。\n杂树云依密，洪崖水自零。\n此中聊可慰，潇洒得林坰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14469,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"太平寺","author":"黄器先","text":"吾亦久遗荣，东林浃素襟。\n支云天炼石，秣马客鸣琴。\n面寺开三径，头陀共一吟。\n不妨来信宿，自是武陵寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14470,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书堂石","author":"黄器先","text":"数里飞湍似吕梁，梁山之上读书堂。\n秋来江色流黄叶，雨后人家住碧湘。\n中古有音传姓字，少微无恙乐虞唐。\n踏歌野服看鸂鶒，双聚双飞亦雁行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14471,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登高峰远眺","author":"黄器先","text":"雨溪云碓杂村舂，万顷腴田绿海中。\n绝顶日晴堪野眺，稻粱馀粒落征鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14472,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"象山","author":"唐皋","text":"象山巍巍高万仞，元气独钟天地正。\n下盘厚土上摩空，翠壁丹崖相掩映。\n长松古柏森且稠，琪花瑶草无春秋。\n层峦列嶂走云气，壮观东南百二州。\n行人翘首劳双目，纵有丹梯敢轻蹴。\n除是神仙有羽翰，飞上山巅看海旭。\n谷中流泉清不污，其中乃是蛟龙都。\n龙兮一出作霖雨，遂令四海无焦枯。\n衡岳相望仅为伍，始信东山能小鲁。\n矻然一柱擎苍天，天下仰瞻今又古。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14473,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仁山书院为邓侯赋","author":"杨维震","text":"白鹿真传万象收，仁山屹屹壮观游。\n昌期今启人文地，间气时钟海上洲。\n四壁灵图常作锦，千岩珠树匝成丘。\n公馀正可观青史，犹报丹书下凤楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14474,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"集郭梦菊膳部席上赋此 其一","author":"胡所思","text":"淡日天初曙，晴烟逐马来。\n鸟啼山谷应，云去洞门开。\n谈笑收金甲，烟霞入酒杯。\n夕阳人影乱，春色一时回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14475,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"集郭梦菊膳部席上赋此 其二","author":"胡所思","text":"碧山溪径静，见月自徘徊。\n洞里寒梅落，楼头短笛催。\n红尘江北去，孤雁幕南来。\n芳草庭前绿，惟馀沧海隈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14476,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]