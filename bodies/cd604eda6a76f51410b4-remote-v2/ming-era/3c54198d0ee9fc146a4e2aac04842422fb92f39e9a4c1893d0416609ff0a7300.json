[{"title":"送黄清父","author":"孙继皋","text":"西南天万里，送尔欲沾巾。\n汉月行行远，蛮风一一新。\n雨凉鸿雁晚，花暖碧鸡春。\n珍重王阳驭，衡门望老亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20632,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉使宛洛初出都门","author":"孙继皋","text":"奉使分桐叶，承颜御木兰。\n建侯家法旧，将父主恩宽。\n冠盖星辰动，河山带砺磐。\n季原吴是族，佚使史为官。\n风细回清吹，湍鸣泻远澜。\n皇华歌未竟，回首忆长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20633,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阻风河西","author":"孙继皋","text":"持节出都门，驾言远行游。\n山川莽回互，道路良阻脩。\n狂风从东来，烈烈吹我舟。\n长年戒轻进，停桡避惊流。\n周南尚云遥，曷为此滞留。\n童仆稳昼眼，予也靡及忧。\n上下眺原隰，何以爰咨诹。\n鱼龙莫深猜，王命建中州。\n庶以将事心，殷勤抱吴钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20634,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨村道中迟韩侍讲","author":"孙继皋","text":"轻帆飏浅浦，日夕凉风吹。\n不见同行侣，悠然空尔思。\n沙平鸥鹭立，槛静水云移。\n可似金堤畔，相携入直时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20635,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚行","author":"孙继皋","text":"画舫轻于叶，飘飘日暮行。\n星随龙节度，日傍雉城明。\n岸树风全入，汀潮晚更生。\n无须叹劳役，昼夜总王程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20636,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲马营驿","author":"孙继皋","text":"当年赵祖生当王，甲马营中满室香。\n千年王尽香亦歇，甲马古营化为驿。\n我来泊此愁阻风，津头一望平原空。\n鸣蝉高树聒人耳，卫水劳劳西复东。\n古今成败那可说，云轻飙驰白日烈。\n身上黄袍讵有无，袖中禅草终磨灭。\n吁嗟营驿竟何常，蘼芜万里春茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚行呈建初山人","author":"孙继皋","text":"千樯夹岸集如云，一苇中流鼓吹闻。\n月吐东风来海色，风摇南浦动波纹。\n王程乍向青徐度，使节遥从宛洛分。\n可是客星高傍斗，天边鸾鹤故为群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟行苦热","author":"孙继皋","text":"亦解舟行好，其如却暑难。\n人非游洛并，节似渡泸看。\n梦失千山雨，樽虚十日寒。\n何当兔园雪，薄洒使臣冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"发临清","author":"孙继皋","text":"我行向宛洛，道路何逶迤。\n冠盖耀林落，车马纷以驰。\n王事岂不劳，顾盼生光辉。\n永言无辱命，庶以扬鸿徽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饭彰德","author":"孙继皋","text":"停轺饭山店，日午蝉声繁。\n小可忘劳役，依然思故园。\n野田瓜果熟，村巷犬羊屯。\n风俗犹存古，吾将试采论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宴同年吴明府衙斋","author":"孙继皋","text":"风云昔日满长安，冠盖相逢卜昼欢。\n出郭柳将飞舄去，停轺花似曲江看。\n行边对酒星辰聚，别后论心岁月难。\n自是冰壶清浸玉，坐来烦暑觉生寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜入开州","author":"孙继皋","text":"王程千里骛行轩，四牡宵驰鼓角昏。\n前路旌旗缘树引，满城灯火缀星繁。\n风烟魏阙心逾迥，词赋梁园念独存。\n自昔侍臣劳采纳，敢将飞传负中原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"经北邙山","author":"孙继皋","text":"朝望北邙山，暮行北邙道。\n山空不见人，原上多青草。\n忆昔当年送葬时，衣冠车马纷纭随。\n珠襦玉匣哀不足，歌声薤露何其悲。\n一朝京洛风尘改，转眼豪华不相待。\n冢畔狐狸昼稳眠，隧前羊虎亦安在。\n凄凉往事事已休，生怜万古一荒丘。\n青春不随绿树歇，白日空照黄河流。\n人生有生会有死，死生聚散亦常尔。\n况彼勋名与富贵，直视浮云等流水。\n吁嗟乎，吁嗟乎，王侯将相无代无，胡不试看北山隅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自洛入少林寺","author":"孙继皋","text":"行行渡洛水，冉冉入云林。\n东指三花树，西来一苇心。\n鹤归缑岭寂，龙卧镜潭深。\n此处千峰乱，高僧偈可寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒初祖","author":"孙继皋","text":"云开初祖殿，清磬礼香筵。\n座拥三花净，灯明几叶禅。\n山屏围积霭，石室泻流泉。\n欲问西来意，松风一洒然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20646,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"面壁洞","author":"孙继皋","text":"一苇何年渡，千春此洞存。\n身留片石现，道与孤峰尊。\n曲磴阴云覆，层崖古雪翻。\n西来本无意，相对亦忘言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20647,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒二祖","author":"孙继皋","text":"古殿依晴嶂，慈云对夕禅。\n衲从初祖授，灯自上方悬。\n大法还谁悟，真空不可传。\n惟馀洞中雪，寂历洒诸天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20648,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"炼魔台","author":"孙继皋","text":"盘纡登绝巘，斜日在松萝。\n此地空台古，天风吹炼魔。\n潭虚龙亦定，境寂虎频过。\n蹇我多尘障，其如出世何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20649,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嵩阳宫汉封将军柏 其一","author":"孙继皋","text":"苍龙为干石为纹，鼎立亭亭傲白云。\n麟阁勋名今已尽，独留人说汉将军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20650,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嵩阳宫汉封将军柏 其二","author":"孙继皋","text":"玉检金泥事惘然，苍崖翠柏自年年。\n不知异日甘泉树，可在仙人雨露边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20651,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉册新野王殿下礼成敬纪","author":"孙继皋","text":"玉节来丹禁，金符下赤藩。\n大封周典礼，众建汉明恩。\n旧宠山河在，新盟带砺存。\n瑞烟迎綵仗，佳气袭朱幡。\n句俨胪传肃，仪森羽卫屯。\n威严扇影动，拜舞佩声繁。\n太社风云壮，中原日月尊。\n叨为奉册使，愿献东平言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20652,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立秋日刘明府邀登天中塔绝顶","author":"孙继皋","text":"灵标高倚碧霄中，极目苍茫眺望雄。\n地现火珠灯昼夜，天临多宝树西东。\n凉风一叶来桐柏，落日千山起雁鸿。\n仙舄从君冲欲去，惊心时序有飞蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20653,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钟镇平迁官南刑曹赋此贻之","author":"孙继皋","text":"帝宠新闻下凤皇，明光旧殿许含香。\n十年不调劳为令，三仕何人薄拜郎。\n流水未须悲遇合，白云差可寄行藏。\n汉家自重艰难地，况复秋风是故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20654,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天柱峰谒玄帝","author":"孙继皋","text":"霏烟侵晓辟天门，绛节随风谒帝阍。\n观日黄金晴自捧，坛星白昼静堪扪。\n梯悬绝壑千盘细，岭入中峰一柱尊。\n解说琼芝宜献寿，将因玉笈叩真源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20655,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿太和宫","author":"孙继皋","text":"斋宫清切帝天居，独沥玄心契道初。\n沆瀣暗零岩漏永，星辰低宿石檐虚。\n千峰月静闻璈奏，半榻宵深检玉书。\n坐待晨光临欲发，灵风先引紫霞裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20656,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下太和","author":"孙继皋","text":"天阙长风吹佩环，乍离玄钥即人间。\n鸾皇自跨真仙驾，虎豹深扃上帝关。\n讵有飞翰生白日，谁将灵药驻红颜。\n重来不负名山约，乞得峰头沆瀣还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20657,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"确山道中有怀吴真阳","author":"孙继皋","text":"秋烟渺渺动蘼芜，落日怀人一雁徂。\n总为河阳花色近，转令天畔月明孤。\n青山县郭知多少，紫气关门定有无。\n愁绝不堪频抚剑，恐惊风雨夜深呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20658,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"君山","author":"孙继皋","text":"岸花江草几回新，十载重来迹已陈。\n座迥诸天当落日，闰逢三月尚馀春。\n潮从来往流今古，世亦浮沉叹此身。\n不见当时珠履客，空劳彩笔赋词人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20659,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送许令公应朝 其一","author":"孙继皋","text":"弦歌初辍鼓频催，天子明堂左个开。\n春见诸侯车总集，月朝仙令舄还来。\n畴庸物采元殊等，课绩声华自上才。\n闻道延英亲赐对，为陈民瘼满蒿莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20660,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送许令公应朝 其二","author":"孙继皋","text":"平舆龙起与云骧，叶县凫飞到上方。\n萃玉向尊周典礼，赐金重见汉循良。\n春风骑入青门柳，期月人歌紫陌棠。\n屈指严程征旆转，花间迎竹有辉光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20661,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"道蔡访张周田先生","author":"孙继皋","text":"秋来握手大河阴，落落风尘片语深。\n才子中原名独久，词人千里动相寻。\n西南老借安危计，岁月频惊去就心。\n道是张华能识剑，双龙传说到如今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20662,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王赤江太学 其一","author":"孙继皋","text":"我本倦游人，闭关慕文渊。\n客从何方至，叩门向我言。\n黄鹄绝四海，蝇营不离藩。\n一身寄大块，那能守丘樊。\n五岳五卷石，郁然并称尊。\n尚子胡卑卑，局促嫁与婚。\n我今仗剑游，极目浮云奔。\n吴楚安足多，逝将览乾坤。\n听子神游王，睹子魂疑翻。\n修子以羽翼，助子以腾鶱。\n子如穷八极，迟我于昆崙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20663,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王赤江太学 其二","author":"孙继皋","text":"君本青云姿，结束游两都。\n彩笔何翩翩，一见倾其徒。\n文雄命自蹇，十年困为儒。\n岂无凌云气，不与狗盗俱。\n勖哉慎所投，袖中有明珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20664,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王赤江太学 其三","author":"孙继皋","text":"在昔王先生，相逢渤海守。\n一言动人主，名满诸公口。\n君今千里至，所托亮不偶。\n主人诸侯贵，投分况已久。\n毗陵视三辅，盗贼幸无有。\n将无帝威灵，变化君知否。\n长河暗风雪，凌冰挂枯柳。\n冲寒趋府去，斗酒聊为寿。\n仁者赠人言，愿君无相负。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王赤江太学 其四","author":"孙继皋","text":"客从远方来，赠我以泽兰。\n问君何为尔，聊结同心欢。\n相遇故不易，相知良独难。\n我有绿绮琴，援之为君弹。\n流水发清音，高山入云端。\n永言无相负，离别非所叹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过苕上值病目宿震泽道院 其一","author":"孙继皋","text":"行客偶维棹，花宫坐晏如。\n未能遗世事，聊得借楼居。\n野润春烟薄，川长夕照虚。\n乾坤双病眼，取次检方书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过苕上值病目宿震泽道院 其二","author":"孙继皋","text":"苕水望不远，兰舟行复停。\n偶然留信宿，端以合沉冥。\n泽近多风雨，楼高逼斗星。\n中宵未成寐，危坐读黄庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仪封道中","author":"孙继皋","text":"草草出门去，那知成远游。\n风尘难自料，徒御总含愁。\n有梦依乡树，无书报野鸥。\n归心指河水，日夜向东流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"铜瓦箱 其一","author":"孙继皋","text":"官衙古渡口，亲舍白云间。\n河势浸铜瓦，泉声梦锡山。\n断垣苔藓碧，深院落花斑。\n独有松梢月，殷勤照客颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20670,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"铜瓦箱 其二","author":"孙继皋","text":"不是贪微禄，其如畏简书。\n驱驰嗟世路，俯仰愧閒居。\n野旷群山出，天长万柳疏。\n春壶那得问，花事牡丹初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20671,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"淇水道中同事吴大行自蜀来会","author":"孙继皋","text":"衔诏同时下凤皇，金符玉策照河阳。\n分携记得关云白，会合惊看路柳黄。\n益部星回车并入，延津龙起剑双翔。\n采风吾已惭周史，赖尔封书达建章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20672,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吕翁祠 其一","author":"孙继皋","text":"长松落落草芊芊，共指仙翁大道边。\n底是世人呼不醒，纷纷车马拜祠前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20673,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吕翁祠 其二","author":"孙继皋","text":"仙翁何日梦邯郸，梦尽荣华午未残。\n我已尘中三十载，劳劳方叹路行难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20674,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吕翁祠 其三","author":"孙继皋","text":"黄沙占路春风吹，白日真仙出世时。\n梦觉可知还是梦，人间留却吕翁祠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20675,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送鲍京兆出守延平","author":"孙继皋","text":"京兆风流擅，何劳佐牧行。\n试庞明主意，借寇郡人情。\n白日双龙起，清秋五马迎。\n悬知讼庭寂，歌暮满山城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20676,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵进士谒选","author":"孙继皋","text":"通籍六年久，蹉跎未拜官。\n赋閒君意懒，予告主恩宽。\n世路积薪似，长安索米难。\n此行期果达，吾亦遂弹冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20677,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王博士自江阴还安东","author":"孙继皋","text":"西风江郭暮，送送木兰船。\n人以傅经去，官因久冷还。\n诸生攀绛帐，野老赠青钱。\n想到淮南北，唯多大小篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20678,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和顾南阳夏日游太平寺诗韵","author":"孙继皋","text":"寺想清凉胜，寻僧逐放参。\n钟传香塔外，花散讲堂南。\n入社高贤得，逃禅懒性堪。\n不知无量法，尘世几能谙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20679,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"豫让桥","author":"孙继皋","text":"西风肃肃水萧萧，千古人称豫让桥。\n死去肝肠明白日，生前侠烈动青霄。\n肯令友识心偏苦，请得君衣恨未消。\n多少临流国士泪，忠魂寂寞不堪招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20680,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"照眉池","author":"孙继皋","text":"君王当日爱蛾眉，照见蛾眉是此池。\n一自深宫春草没，空馀纤月下清漪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20681,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周计部饷边","author":"孙继皋","text":"大漠平连蓟北天，向来前箸急筹边。\n将军已佩通侯印，使者仍输太府钱。\n几处鼓鼙閒落日，何年烽火避甘泉。\n君行会有匡时略，试问金城塞下田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20682,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雷大将军诗","author":"孙继皋","text":"天留飞将到于今，堕壑曾经动羽林。\n腰下双龙雷焕剑，梦中三箭薛公心。\n风清幕府旌旗肃，日落辕门鼓角沉。\n一自承恩还镇后，肯令北骑复南侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20683,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周保宁之官","author":"孙继皋","text":"星符西向锦官分，万里秋高栈道云。\n竹马解来迎太守，讴歌争喜似吾君。\n阳春试属巴人和，暮雨何当楚客闻。\n定有新铭摩剑阁，风流为政雅能文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20684,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿陈松谷相公","author":"孙继皋","text":"乞归当日发犹玄，黄阁勋猷旧格天。\n衰健几劳明主问，姓名长许远人传。\n鸠文赐杖元非老，麟彩为袍俨是仙。\n石室有人能继业，汉廷家世重韦贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20685,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送许山人还句吴","author":"孙继皋","text":"杨花飞尽水悠悠，君到江南麦正秋。\n倘记故人离别处，远烟芳草不胜愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20686,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送华三还乡省觐","author":"孙继皋","text":"宁亲肯自惜，五月动归鞍。\n扇枕庭帏近，披裘道路难。\n片云随处白，长日计程宽。\n我亦辞家久，因君泪不乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20687,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送秦文学还乡十二韵","author":"孙继皋","text":"作客君应倦，怀余每独寻。\n春风才入夏，旧雨几逢今。\n薄宦随鸣玉，穷交慕断金。\n才微惭彩笔，命蹇念青衿。\n太学诸生贵，中年奈老侵。\n声名同舍逊，杯酒异乡深。\n往事空燕骨，羁人对越吟。\n雄雌双宝剑，山水一瑶琴。\n偶尔思亲席，翛然追故林。\n昼行愁暑毒，天远望商参。\n不尽停云泪，难为落日心。\n遄归亦匪晏，秋至欲抽簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20688,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴县陈令公应朝","author":"孙继皋","text":"朝天此去笋为班，云拥征车不可攀。\n人自楚才操白雪，官从吴苑领青山。\n绾铜花县窥潘鬓，辑玉枫宸识舜颜。\n解道延英还赐对，察眉宁惜吁民艰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20689,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重送华三","author":"孙继皋","text":"离心不可道，杨柳自依依。\n五月行人少，孤帆何处归。\n烟霞生计得，风雨宦游非。\n想尔还家后，中宵浣素衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20690,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"被谤获雪感恩难言聊赋二首用当出涕 其一","author":"孙继皋","text":"回首风烟莽畏途，惊魂堪向九阍呼。\n一文肯许金钱送，万死甘从斧钺诛。\n事定浮名乡党在，时清公道庙堂扶。\n终惭蹇劣生无补，径寸贞心欲化珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20691,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"被谤获雪感恩难言聊赋二首用当出涕 其二","author":"孙继皋","text":"自从束发滥朝簪，细数君恩一一深。\n微服颇冯三献玉，空囊肯爱四知金。\n箧书贝锦诚何意，白日青天是此心。\n元老只今怜国士，云霄北望涕难禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20692,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送中表绍堂南还","author":"孙继皋","text":"君来以我故，君去若为情。\n晓帐犹悬月，春程尚听莺。\n三年拜母泪，匹马趁人行。\n不浅投林兴，因君问耦耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20693,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蒙恩省觐发京","author":"孙继皋","text":"恭承紫诏辞三殿，却望金门隔九天。\n归去晨昏亲舍近，向来日月主恩偏。\n寒柯落叶关河晚，短剑轻囊道路便。\n恋阙趋庭无限意，将因寿酒祝尧年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20694,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈稚登游南雍 其一","author":"孙继皋","text":"江南江北桃李花，金陵游子初离家。\n眼中相识尽相送，腰下新悬是莫耶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20695,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈稚登游南雍 其二","author":"孙继皋","text":"一诺千金与万金，头颅未老义何深。\n信陵已远平原死，持向何人一片心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20696,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]