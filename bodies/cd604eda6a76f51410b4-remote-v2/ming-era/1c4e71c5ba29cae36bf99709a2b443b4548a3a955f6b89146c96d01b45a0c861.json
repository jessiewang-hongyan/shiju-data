y","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23636,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"问胡山人坟","author":"刘崧","text":"偶寻康道士，因问故人坟。\n满地生秋草，何年閟白云。\n松楼秋梦断，竹浦夜吟分。\n狂饮犹怜我，?泉拟酹君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23637,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿西华有怀萧鹏举并柬同游者","author":"刘崧","text":"山光上寥阒，海气接鸿庞。\n月近全当户，天垂半入江。\n买泉苍石洞，送酒白云窗。\n却忆滁阳客，东游滞短艭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23638,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"项烈妇唐氏挽诗","author":"刘崧","text":"寇截新林渡，风惊下濑船。\n死能同母逝，生或愧身全。\n抱石云漂海，沈珠月在渊。\n义门重光烈，千古照龙泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23639,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠廖山人月山","author":"刘崧","text":"问讯青囊客，来游衣锦乡。\n几年寓禾水，何日过茆堂。\n古墓沉凫海，高门散鹿场。\n平生双短屐，登览意何长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23640,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过小孤山","author":"刘崧","text":"万丈临无地，苍然不可攀。\n九江争赴海，一柱独当关。\n水族朝珠阙，仙娥拥翠鬟。\n平生登览兴，及此慰南还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23641,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"入湖口喜见庐山","author":"刘崧","text":"鄱阳湖上路，来往愿多违。\n往事那能问，今年始是归。\n乡田新梦熟，京国旧游稀。\n稚子能携酒，应先候竹扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23642,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阻风坐湖阴石上","author":"刘崧","text":"江石平如砥，江芜散若丝。\n偶来临水坐，浑似在山时。\n月上涵金镜，风来弄绿漪。\n那无一樽酒，来此共幽期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23643,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"学钓","author":"刘崧","text":"偶有临流兴，因之驻木兰。\n呼儿供钓饵，问客觅鱼竿。\n小立怜幽树，深投爱弱湍。\n惟应待明月，长啸下前滩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23644,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过南昌有怀旷伯逵知事","author":"刘崧","text":"生来虞乱极，身后见时清。\n每叹多才累，翻怜一死轻。\n慷慨论交契，沈酣托酒名。\n至今江草绿，犹似别时情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23645,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过新淦樟口欲访检校谢叔宾不果赋此遥谢","author":"刘崧","text":"五月辞京阙，曾期共泛舟。\n蹉跎嗟后至，怅望失前游。\n樟口风湍急，山中云木稠。\n寄书谢猿鹤，欲往惜淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23646,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆舍弟子彦相望","author":"刘崧","text":"前月辞京阙，因风问桂枝。\n秖缘书到早，应怪客行迟。\n失学怜宗武，迎门想阿宜。\n林塘新酿熟，烂醉不须疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23647,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过峡江","author":"刘崧","text":"乡路犹三驿，逢人问水程。\n昼愁江上住，凉爱月中行。\n白发思乡里，青灯忆弟兄。\n那能即相见，把酒慰深情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23648,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日宴集钟氏西楼鹏举有诗依韵奉答仍示启晦","author":"刘崧","text":"望月上西楼，纤纤白玉钩。\n晚山檐外出，秋水席边流。\n还乡初握手，恋阙屡回头。\n竟夕成欢宴，感激讵云休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23649,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"往游流江坐溪南追忆如川隐君感赋三首 其一","author":"刘崧","text":"尚忆京城别，旋闻旅榇归。\n宁知垂老际，翻觉故人稀。\n江晚沙鸥集，庭春海燕飞。\n佳儿如玉树，相顾烂生辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23650,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"往游流江坐溪南追忆如川隐君感赋三首 其二","author":"刘崧","text":"兰玉照庭除，松楸掩墓墟。\n人犹思挂剑，孙已解摊书。\n独往青山在，重来白发疏。\n平生知己恨，下马更踟蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23651,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"往游流江坐溪南追忆如川隐君感赋三首 其三","author":"刘崧","text":"白白新梅树，青青旧桂林。\n碧云幽巷晚，残雪小斋深。\n客去犹悬榻，人亡欲绝琴。\n凄凉风雨夕，灯影照华簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23652,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和萧用文寒夜闻风之作","author":"刘崧","text":"汹汹松涛合，潺潺竹溜分。\n已怜寒夜入，况是客窗闻。\n月黑乌号子，天高雁失群。\n凄凉江海意，对酒正思君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23653,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫体四时词答和欧阳原之 其一","author":"刘崧","text":"春色满长杨，花枝出建章。\n莺啼知禁苑，辇过识天香。\n度曲调鹦䳇，吹笙引凤凰。\n可怜庭草色，浑欲上罗裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23654,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫体四时词答和欧阳原之 其二","author":"刘崧","text":"太液清无暑，承恩得泛船。\n飞帷缘绿水，团扇夹晴烟。\n日暮犹移辇，风来欲上仙。\n池边荷叶小，个个似青钿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23655,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫体四时词答和欧阳原之 其三","author":"刘崧","text":"金屋秋风起，铜盘夕露深。\n水花红冉冉，宫树碧沉沉。\n却望鸾旌影，微闻凤吹音。\n月明瑶殿冷，香梦杳难寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23656,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫体四时词答和欧阳原之 其四","author":"刘崧","text":"晓色冻铜池，寒光上玉墀。\n天低九重阙，雪满万年枝。\n阁道垂帘密，宫门放钥迟。\n春风别殿早，若个画蛾眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23657,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登石华山遇雨","author":"刘崧","text":"西候浮丘伯，东瞻石华峰。\n林阴初歇马，云气已乘龙。\n急雨沾崖谷，长风下桧松。\n殷勤两仙女，持赠玉芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23658,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日同谢可用丁文甫黄立本丁昌祖戴伯渊宴集西园池亭","author":"刘崧","text":"今日南园好，超然欢笑同。\n谁知林塘幽，有此路径通。\n脱巾芳树下，行酒青草中。\n既饮亦径醉，高歌答林风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23659,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题周伯宁梅溪图","author":"刘崧","text":"月出青溪上，云生翠壁间。\n流辉方绕涧，散影已腾山。\n闻有梅初发，兼怀桂可攀。\n怅言寻芳者，曳杖不知还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23660,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋水作玉虹流送子启之赣","author":"刘崧","text":"赣江不可极，双注碧云中。\n出峡几千丈，青天垂玉虹。\n系船沙碛雨，挂席石潭风。\n八月寻源去，相思秋树红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23661,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再赋岚气昏晨树","author":"刘崧","text":"晨光暧众壑，岚气嘘重雾。\n遥闻山下钟，微辨岩前树。\n花落空复春，鸟啼不知处。\n木末带飞帆，行人望中去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23662,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寒夜感兴和廖子所二首 其一","author":"刘崧","text":"浦月初沈后，林霜欲下时。\n空馀清夜永，不尽故园思。\n旅雁惊寒惨，邻鸡戒晓迟。\n床帷怜稚子，此意未能知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23663,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寒夜感兴和廖子所二首 其二","author":"刘崧","text":"未赋潘安兴，仍怀宋玉悲。\n溪山百里道，雨雪暮年期。\n儒术真何济，农书竟不知。\n临晨增感激，一谢故人思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23664,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]