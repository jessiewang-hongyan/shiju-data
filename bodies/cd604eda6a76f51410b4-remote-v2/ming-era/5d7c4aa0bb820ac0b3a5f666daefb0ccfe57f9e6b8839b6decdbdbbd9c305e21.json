[{"title":"首夏即事","author":"卢龙云","text":"柳尽风前絮，葵含雨后英。\n宦情同白下，岁序又朱明。\n积贮穷檐竭，烽烟几处生。\n至尊忧独切，何日见澄清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19790,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何敬渐改北成均二首 其一","author":"卢龙云","text":"帝里衣冠集，看君鼓箧行。\n一经韦少子，六馆汉诸生。\n大有承家誉，偏多恋阙情。\n平津开阁日，端合起高名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19791,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何敬渐改北成均二首 其二","author":"卢龙云","text":"世德先朝重，家声奕叶存。\n赏延思报国，业在识专门。\n礼秩东曹旧，儒宗上序尊。\n凤毛元五色，此去见腾骞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19792,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答少司马陈公二首 其一","author":"卢龙云","text":"一从归棹渺，离况迥难舒。\n薄宦重于世，耆年久遂初。\n家承韦氏学，架美邺侯书。\n却喜仪刑近，传经在石渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19793,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答少司马陈公二首 其二","author":"卢龙云","text":"极目群峰外，长江复渺瀰。\n颇存枥马志，却冒海鸥疑。\n望逐前驱远，功方后进迟。\n丹山多穴凤，次第见来仪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19794,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送姚生君会还揭阳二首 其一","author":"卢龙云","text":"海畔三千里，君今赋北游。\n瞻天来上国，结客慕名流。\n骤列冠裳会，宁甘水石俦。\n以余方滞迹，却自愧荆州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19795,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送姚生君会还揭阳二首 其二","author":"卢龙云","text":"昔我曾游地，青齐控海门。\n城开莒子国，路出穆陵原。\n良牧声初起，交亲谊独存。\n江山应有助，归去美词源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19796,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为尹太学寿其贞母二首 其一","author":"卢龙云","text":"槐市新凉入，游人念倚庐。\n飞云瞻狄舍，晴雨想潘舆。\n上国衣冠始，家庭燕喜初。\n冈陵今日颂，都属庆之馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19797,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为尹太学寿其贞母二首 其二","author":"卢龙云","text":"昔看慈母线，今阅女仙图。\n天上麟为二，人间凤不孤。\n歌馀陶氏鹄，綵并老莱乌。\n岂藉阳城教，先能念母劬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19798,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄张孟奇计部分司浒墅二首 其一","author":"卢龙云","text":"一水通吴越，中朝出度支。\n艅艎纷并集，币物总多奇。\n早夜惟持算，东南更察眉。\n使君非榷吏，公暇日删诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19799,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄张孟奇计部分司浒墅二首 其二","author":"卢龙云","text":"千里方愁潦，频年急上供。\n岂堪歌杼轴，无计问租庸。\n蒿目筹俱尽，丹心事可封。\n怀君非在远，秋水隔芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19800,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈茂才父母偕寿","author":"卢龙云","text":"里聚德星久，堂开寿域长。\n对持春酒绿，共看晚花黄。\n双鹤龄逾健，蟠桃叶正芳。\n翩翩三凤羽，将近五云翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19801,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送袁伯益比部南还二首 其一","author":"卢龙云","text":"客里秋高日，谁能不望乡。\n离杯新酒绿，异地晚花黄。\n五岭停云远，三城去路长。\n遥知家庆集，旋见蚤梅香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19802,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送袁伯益比部南还二首 其二","author":"卢龙云","text":"客席应初暖，临岐又解携。\n但欢重昼锦，何惮促歌骊。\n驿路随南雁，山程听晓鸡。\n春江花月待，弭棹到城西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19803,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长至前二日送周驾部考绩二首 其一","author":"卢龙云","text":"述职初三载，朝天近一阳。\n仙郎方绿鬓，世业自青箱。\n司马为圻父，留都是帝乡。\n庙谟根本重，简在有辉光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19804,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长至前二日送周驾部考绩二首 其二","author":"卢龙云","text":"丰镐惟南国，干城实楚材。\n凤麟明世出，骐骥远途开。\n宦绩堪殊考，皇恩正大来。\n春光辞帝阙，归及咏官梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19805,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗母太宜人八十二首 其一","author":"卢龙云","text":"南陆清和始，北堂燕喜初。\n会成青鸟信，恩重紫鸾书。\n五马何妨远，三鳣自不虚。\n盈阶多宝树，雨露更何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19806,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗母太宜人八十二首 其二","author":"卢龙云","text":"报道瑶池宴，君家萼绿华。\n已看珈是玉，更美枣如瓜。\n丹诏衔双凤，琼浆进九霞。\n年年歌寿母，乐事总堪誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19807,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"至后送谢友可考绩二首 其一","author":"卢龙云","text":"几度皇华使，三年法署郎。\n臣劳今上考，岁序又初阳。\n驿骑风尘远，天朝雨露长。\n鹓鸾多旧侣，剑佩待明光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19808,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"至后送谢友可考绩二首 其二","author":"卢龙云","text":"宦迹淹南国，才名重两都。\n风云仍傍阙，雨雪但征途。\n念旧恩逾渥，酬劳愿不孤。\n庙堂安石略，留以弼皇图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19809,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得假南归答秦伯起赠别","author":"卢龙云","text":"天涯归思切，不省漫为官。\n驿路随杨柳，花期复牡丹。\n尊违徵赏集，琴念别离弹。\n去住情俱系，苍波正淼漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19810,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"颜茂才过访舟中","author":"卢龙云","text":"二载诗相忆，重逢但客舟。\n深尊宁十日，片语亦千秋。\n并合元难定，支离可自由。\n临岐需后会，天路有鸣驺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19811,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送苏明府入觐二首 其一","author":"卢龙云","text":"万里趋朝者，孤城保障哉。\n一琴单父后，双舄尚方来。\n雨露穷檐普，风云傍阙回。\n瞻天浮瑞色，郎宿近中台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19812,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送苏明府入觐二首 其二","author":"卢龙云","text":"去日秋氛净，归时春意浓。\n明光催晓漏，长乐听疏钟。\n治绩过三异，恩光下九重。\n苍黎争舞蹈，不负远朝宗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19813,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重过郊居有感","author":"卢龙云","text":"自出郊居日，风尘涉旅途。\n颜知芳杜厚，迹以菉薋芜。\n花鸟何常主，琴尊非故吾。\n重来呼旧侣，别是酒家胡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19814,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答友人寄怀","author":"卢龙云","text":"远书凭过雁，时物感寒螀。\n久别霜侵鬓，相思月在梁。\n望穷千转径，愁绝九回肠。\n露满蒹葭夕，佳人水一方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19815,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清赏斋二首 其一","author":"卢龙云","text":"胜地无常主，高人自结庐。\n环门多水竹，混迹岂樵渔。\n万卷连床富，群花向日舒。\n琴尊俱乐事，何羡府中居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19816,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清赏斋二首 其二","author":"卢龙云","text":"习静成真隐，耽幽艺众芳。\n一亭杨子宅，三径蒋公堂。\n渐喜飧霞侣，将休结客场。\n江湖心尚远，松菊岂全荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19817,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答钟茂才二首 其一","author":"卢龙云","text":"一别逾三纪，鱼鸿各渺然。\n赋才推并美，蹇步愧余先。\n雾豹宁终隐，云鹏拟共翩。\n桑榆犹未晚，挥霍待龙渊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19818,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答钟茂才二首 其二","author":"卢龙云","text":"钟子元同调，知音近转疏。\n摛文皆五凤，念旧更双鱼。\n一水蒹葭外，层霄羽翼初。\n暮云思握手，赋奏待公车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19819,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜泊洸口昔回自贵竹时所取道也感赋三首 其一","author":"卢龙云","text":"陇树收残雨，江舟带暮烟。\n客程今夜宿，乡梦几宵悬。\n水接湖南路，山开岭外天。\n昔时孤骑绕，过此重凄然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19820,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜泊洸口昔回自贵竹时所取道也感赋三首 其二","author":"卢龙云","text":"二水浈阳合，千峰楚甸分。\n驱车曾鸟道，弭棹此鸥群。\n作客春多雨，怀人树有云。\n江声缘瀑急，永夜此中闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19821,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜泊洸口昔回自贵竹时所取道也感赋三首 其三","author":"卢龙云","text":"舟楫频来往，江山自渺漫。\n风湍聊暂息，旅酌不成欢。\n旧事追相忆，新愁别转难。\n推篷占霁色，羁思稍能宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19822,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日泛舟秦淮","author":"卢龙云","text":"十里秦淮胜，偏能悦客游。\n家家凭水槛，处处上兰舟。\n箫鼓时相应，壶觞夜不休。\n绝怜城郭里，弭棹得临流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19823,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桃叶渡","author":"卢龙云","text":"桃叶知何处，犹传旧渡名。\n休论千古恨，且喜四难并。\n婀娜江花媚，留连夜月生。\n何言不用楫，满听棹歌声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19824,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天界社集赋得薰风自南来殿阁生微凉二首 其一","author":"卢龙云","text":"永日宁逃暑，微风入户来。\n炎威三伏失，爽气二仪开。\n暗度过新竹，轻飘动午槐。\n坐添吟思好，复进掌中杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19825,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天界社集赋得薰风自南来殿阁生微凉二首 其二","author":"卢龙云","text":"台殿元虚敞，披襟更纳凉。\n飙含槐柳色，气袭芰荷香。\n解阜歌虞帝，清泠快楚王。\n炎氛俱涤尽，夏日正堪长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19826,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郑生偕行自闽远来索赠二首 其一","author":"卢龙云","text":"昔游闽岭外，无地不菁莪。\n业自承家远，书因诣阙多。\n云霄看健翮，雨露出新柯。\n藏器年来久，程功近若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19827,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郑生偕行自闽远来索赠二首 其二","author":"卢龙云","text":"绿鬓年华始，青襟誉逮时。\n三冬元易足，一字愧难师。\n旧里皆通德，新篇几白眉。\n秋风鹏运早，九万正堪期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19828,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题署中君子轩二首 其一","author":"卢龙云","text":"司计逢多暇，开轩面此君。\n高枝时近日，密叶每披云。\n并美不雕操，长瞻有斐文。\n祗缘风节在，随地见清芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19829,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题署中君子轩二首 其二","author":"卢龙云","text":"满林皆绿玉，更长碧琅玕。\n入夏能清暑，经霜不畏寒。\n渭滨休拟富，嶰谷可同看。\n日有平安报，应教俗虑宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19830,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄答内弟体健","author":"卢龙云","text":"岭外传书至，知君念我劳。\n听鸿欹草阁，步马忆兰皋。\n白雪歌难和，碧云望转高。\n各天俱夜月，谁傍锦宫袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19831,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同乡合祀湛文简公","author":"卢龙云","text":"昔日谈经处，多贤尚景从。\n圣朝无学禁，吾道有儒宗。\n共喜芳仍远，休疑大莫容。\n宫墙千古在，俎豆记遗踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19832,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答霍益芳自山中寄怀","author":"卢龙云","text":"名山多副墨，水石更堪娱。\n嗜古翻成癖，探奇却类迂。\n我犹淹拙宦，君亦著潜夫。\n意气应相许，何能学破觚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19833,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄金华周使君","author":"卢龙云","text":"远驿连荒徼，当年奉属车。\n抡才忽五马，叙旧几双鱼。\n阖境闻舆颂，中朝待玺书。\n循良徵异等，郡国更谁如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19834,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张子云之任梧州府僚","author":"卢龙云","text":"苍梧新佐郡，玄草旧名家。\n案牍分劳始，风云入望赊。\n檄缘亲为喜，才识吏而华。\n画诺当谁主，中和咏复嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19835,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周氏蔽席庐","author":"卢龙云","text":"六合匪云远，吾庐亦自宽。\n四时皆乐境，万象纵遐观。\n架上充图史，床头有镆干。\n席门多长者，孰与此中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19836,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"代赠吉祥寺碧云上人","author":"卢龙云","text":"并入招提境，慈云护吉祥。\n飞来山共碧，映处谷为光。\n缥缈诸天外，纷纶慧日旁。\n萧斋能礼客，时拟惠休章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19837,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送广生南还二首 其一","author":"卢龙云","text":"仗剑来游日，西风白雁初。\n称诗随旅况，持论慰离居。\n禹穴探书罢，秦淮问酒馀。\n乡心逢岁暮，聊复爱吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19838,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送广生南还二首 其二","author":"卢龙云","text":"朔气寒方凛，游人念故园。\n早梅迎客骑，疏柳对离樽。\n白雪新篇富，青云旧业存。\n谢庭多赋客，归与共玄言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19839,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日冶城晚眺分韵得支麻字二首 其一","author":"卢龙云","text":"万壑阳回后，层轩夕望时。\n落霞光倒映，爱日影西移。\n未拟登楼赋，先赓伐木诗。\n倚阑思正渺，灯火夜归迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19840,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日冶城晚眺分韵得支麻字二首 其二","author":"卢龙云","text":"说剑城为冶，开尊物有华。\n同来浮白者，俱是草玄家。\n净社依青嶂，高斋傍赤霞。\n官閒期会少，吟眺景偏赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19841,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送丁茂淑缮部出榷芜湖二首 其一","author":"卢龙云","text":"入社怜同调，分曹重?材。\n简书宁勿畏，案牍苦相催。\n别酒临岐尽，仙帆带日开。\n相违休道远，南望只江隈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19842,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送丁茂淑缮部出榷芜湖二首 其二","author":"卢龙云","text":"牒随将作署，费藉水衡钱。\n祗信迹难合，何知利有权。\n吟怀应尚壮，物力转须怜。\n揽胜逢公暇，诗筒好为传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19843,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送周伯绳比部给假归昆山二首 其一","author":"卢龙云","text":"青阳欣改序，白社恋同声。\n准拟吟怀豁，翻令别思生。\n看花违共赏，折柳重含情。\n锦里春偏丽，催君事昼行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19844,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送周伯绳比部给假归昆山二首 其二","author":"卢龙云","text":"游子思乡切，春风献岁初。\n娄江归兴远，钟阜旅怀纾。\n列署刑堪措，连枝会不虚。\n莺花随处好，应念社盟疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19845,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读俨思录二首有序 其一","author":"卢龙云","text":"大孝思能永，精诚感易通。\n丹青图画里，陟降有无中。\n梦想前修渺，瞻依此日同。\n庆馀知未艾，光裕慰而翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19846,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读俨思录二首有序 其二","author":"卢龙云","text":"念祖将绳武，贻孙待作求。\n音容宁遂泯，英爽故能留。\n列柏栽培远，丛兰雨露周。\n龙章他日锡，端可发潜幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19847,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荆花二首 其一","author":"卢龙云","text":"百卉春交媚，荆花亦自妍。\n迎风摇绛雪，得雨濯红泉。\n纤绿间重锦，繁芳染瑞烟。\n桃蹊看并美，堪为纪新篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19848,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荆花二首 其二","author":"卢龙云","text":"年光嗟荏苒，睹物若为情。\n每忆三荆合，偏令百感生。\n梗漂怜聚散，花落任枯荣。\n且喜庭芳满，均沾雨露成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19849,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"分菊","author":"卢龙云","text":"种菊依檐下，曾经两度秋。\n根移新雨润，叶美早春柔。\n生意从今达，群芳羡独幽。\n三年居此地，更为晚花留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19850,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏古四首有序 其一 董生","author":"卢龙云","text":"道丧嬴秦后，传经属汉儒。\n天人初召对，伊吕此为徒。\n列国诸侯相，中朝子大夫。\n究寻灾异理，时论却为愚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19851,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏古四首有序 其二 诸葛武侯","author":"卢龙云","text":"隆中高卧日，闻达岂知求。\n三顾时非偶，一言意自投。\n忠贞期灭魏，运祚失兴刘。\n出处应难并，休论愿未酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19852,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏古四首有序 其三 陆宣公","author":"卢龙云","text":"所学真无负，恩深内相初。\n敷陈本道德，诏令感州闾。\n罢献能防侈，忧谗不著书。\n祗今看奏议，法戒尚昭如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19853,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏古四首有序 其四 韩魏公","author":"卢龙云","text":"五云先兆瑞，相业卜当年。\n筦库宁留滞，乾坤待转旋。\n两朝光定策，四路靖临边。\n识量多宏伟，功成付彼天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19854,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春送邹道卿驾部考绩二首 其一","author":"卢龙云","text":"春服喜初成，逢君又北征。\n归朝先对马，觐阙际迁莺。\n课绩过三载，程材擅二京。\n留都根本在，当宁不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19855,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春送邹道卿驾部考绩二首 其二","author":"卢龙云","text":"仙郎方绿鬓，宦业此初升。\n剑气新硎发，文光健笔凌。\n枢曹推上考，艺苑见中兴。\n试最加恩后，悬知秩倍增。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19856,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁比部招同诸旧僚赏署中花适以公阻赋谢二首 其一","author":"卢龙云","text":"自别玄湖署，曾经几度花。\n放衙宾又集，对酒日初斜。\n旧侣能相忆，新诗并可誇。\n不堪期会阻，独自惜年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19857,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]