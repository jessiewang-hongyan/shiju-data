","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54582,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏史四首 其四","author":"苏葵","text":"龙行虎步已先知，烛影翻招万古疑。\n莫道史家无考据，故宫犹子两恩亏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54583,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题松鹤图","author":"苏葵","text":"梦入仙山驾老龙，青田飞度月溶溶。\n谁家铁笛忽惊觉，吟对丹青鹤在松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54584,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日试笔","author":"苏葵","text":"去年送春发初白，今日迎春发尽蓬。\n青皇阅遍人间事，为验霜毫公不公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54585,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江上早春","author":"苏葵","text":"一苇江行诗兴赊，水明沙白雪飘花。\n醉来欲探春深浅，溪柳黄金半露芽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54586,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新春漫兴二首 其一","author":"苏葵","text":"天涯五十一回春，世事茫茫见未真。\n莫讶知非蘧伯玉，只今犹有长年人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54587,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新春漫兴二首 其二","author":"苏葵","text":"昨去今来春自忙，病夫何惜鬓苍浪。\n尊前观物无穷趣，只愧尧夫不愧庄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","p