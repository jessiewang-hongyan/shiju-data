[{"title":"送岑金纪游珠崖五首 其二","author":"成鹫","text":"壮志销磨尽，孤云独自飞。\n平生远游意，多半与心违。\n五岳我将去，三年君始归。\n何时更来此，同采粤山薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49156,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送岑金纪游珠崖五首 其三","author":"成鹫","text":"江海未云远，山川宁阻长。\n遥情寄溟渤，高咏别沧浪。\n榻下青毡地，兰生古桂旁。\n悠悠浮海意，千里忆同堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49157,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送岑金纪游珠崖五首 其四","author":"成鹫","text":"郭外灵泉寺，精蓝隐半峰。\n僧惟多异主，人有合溪翁。\n扣石千山应，闻香百和同。\n为君先指注，到日好追从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49158,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送岑金纪游珠崖五首 其五","author":"成鹫","text":"我爱海潮胜，层岩亲手开。\n此身难久住，三载许重来。\n曲磴丹梯入，高窗碧嶂回。\n劳君老词客，拂拭旧莓苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49159,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"关中绝粒寄陶握山","author":"成鹫","text":"一月不相见，三年当远行。\n路难凭忍力，别久识交情。\n绝粒惭僮仆，空函报友生。\n谁怜桑扈病，风雨正霖瓴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49160,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观云海","author":"成鹫","text":"岳顶半閒屋，终朝云满林。\n千峰无远近，一气自高深。\n老眼随烟雾，浮生任陆沉。\n松风吹不尽，化作海潮音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49161,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题吴琬若新楼","author":"成鹫","text":"旧隐经游地，新楼结构工。\n谁知读书处，仍在落花中。\n渐觉苔痕浅，难教茗椀空。\n请君下孤榻，借我息征蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49162,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊西南渡口与马山诸子分赋","author":"成鹫","text":"萧条葭菼外，孤棹与君期。\n山月初圆夜，江潮正上时。\n远峰晴后见，幽兴静中知。\n隔岸沧浪叟，长歌应为谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49163,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与卢雁林宿本庵留别弛赝师","author":"成鹫","text":"暂此息劳生，劳生空复情。\n寒风吹老树，竟夕作秋声。\n明发我当去，夜深人独行。\n蒙师爱吟客，一事笑无成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49164,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中女松短者及肩长可荫屋青阴绕垣葱茜可爱偶为樵苏剪伐殆尽诗以惜之","author":"成鹫","text":"如此孤高性，应难免俗人。\n有心成琥珀，无计护龙鳞。\n日月空双影，风涛静四邻。\n生平牢落意，持尔问芳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49165,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"盘中小松","author":"成鹫","text":"小松不满尺，来自南山陲。\n劲节苦相屈，高踪聊自卑。\n风涛随物化，形影与僧宜。\n但适鹪鹩性，何妨借一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49166,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瓶中桃花","author":"成鹫","text":"野径春芳早，夭桃放小红。\n东君留不住，飞入玉壶中。\n有水皆成浪，无香岂借风。\n灵云亲见后，折赠意何穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49167,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春夜诸子过集马山听卢雁林弹琴","author":"成鹫","text":"故人抱枯木，过我南山陲。\n开匣理新曲，君心如旧时。\n指边灯影乱，弦外雨声随。\n静者匪徒默，幽怀谁得知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49168,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送玉泉师还匡庐","author":"成鹫","text":"玉泉不识面，识得玉泉心。\n暂作还乡客，终当返旧林。\n万杉寻路入，五老闭门深。\n我亦孤峰宿，无由共一岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49169,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题卢雁林弹琴小影","author":"成鹫","text":"明月满天下，一人弹素琴。\n元音发枯木，馀响出疏林。\n静极须眉冷，渺然闻见深。\n谁能写空影，相对助长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49170,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"珠江月夜泛舟","author":"成鹫","text":"生平湖海客，薄暮钓鱼船。\n回首见孤月，严城夜悄然。\n波摇江上寺，云净水中天。\n一曲沧浪外，知音何处边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49171,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈王屋还五羊","author":"成鹫","text":"囊轻奇石重，之子未全贫。\n挥手别良友，归心缘老亲。\n城中为客久，海外得交新。\n我欲从兹住，重来有主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49172,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和马专城卧仙来韵","author":"成鹫","text":"青云出高岫，倦鸟独归林。\n影入清池去，相看无浅深。\n爱僧成久坐，即事每长吟。\n野客容疏散，唯公知我心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49173,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和刘明府仰山来韵","author":"成鹫","text":"从此苍苔上，知难免屐痕。\n竹风频埽榻，松月静开门。\n要识宾中主，须寻郭外村。\n新诗题满壁，相对两无言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49174,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和程公玉来韵 其一","author":"成鹫","text":"所居非一一，随地足平生。\n吾志在山水，因之移性情。\n不材人共弃，何幸老无成。\n愿得长如此，终身住铁城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49175,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和程公玉来韵 其二","author":"成鹫","text":"高人叩我户，白板暂时开。\n好句袖中出，清风天上来。\n微吟动琴瑟，寒色入茶杯。\n为问蹇驴上，敲推曾几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49176,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨凌霜郑秉渊衍源诸子过宿东林 其一","author":"成鹫","text":"高人抱幽独，薄暮款松关。\n坐久为予说，城中无此閒。\n孤灯堪引兴，清论不离山。\n更有微言在，明朝莫便还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49177,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨凌霜郑秉渊衍源诸子过宿东林 其二","author":"成鹫","text":"衰鬓惊年暮，閒心与地偏。\n对君何所似，春近夕阳边。\n短烛照无梦，寒灰拨有烟。\n知音爱禅寂，默坐岂徒然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49178,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"缪西泠雨中见寄用韵赋答","author":"成鹫","text":"柴门连日雨，且得暂时关。\n风入如无树，云来不碍山。\n隔城通一水，为屋各三间。\n好句劳相寄，于君见一斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49179,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日缪西泠杨式卿见过值予他出留诗于壁既归用韵答之","author":"成鹫","text":"爱此池上屋，无人也自佳。\n出门刚半日，落叶满空阶。\n过客留新句，归僧及午斋。\n红尘暗城市，踪迹愧吾侪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49180,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春日和缪西泠韵","author":"成鹫","text":"里鼓喧残腊，东风吹落梅。\n土牛迎气出，青鸟报春来。\n城市嚣尘满，园林老景催。\n蓬山如可到，东海事浮杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49181,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元日友人见过和缪西泠韵","author":"成鹫","text":"寸阴同隙驶，今古一蘧庐。\n新岁几时到，三更见日初。\n多情难久别，高咏近何如。\n莫惜频相过，繁星向晓疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49182,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元日柬杨式卿和缪西泠","author":"成鹫","text":"谷风初解冻，衣线渐生春。\n不觉纸窗白，方知曙色新。\n味君怀里字，饮我杯中醇。\n珍重草玄子，如何酬故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49183,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日偕诸子舟泛虎溪望涯而返归舟分赋","author":"成鹫","text":"旧识虎溪路，今从溪上行。\n一乘青雀舫，重订白鸥盟。\n何必践斯境，应知惬野情。\n渺然发归兴，遥寄棹歌声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49184,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊江口","author":"成鹫","text":"江上月初上，潮头风更清。\n隔船闻夜语，停棹待天明。\n倦鹤得无梦，远鸡如有情。\n生平浪游意，支枕计纵横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49185,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端午与诸子再泛虎溪分赋","author":"成鹫","text":"东林非久住，爱此一溪深。\n隔水见云树，扁舟何处寻。\n蒲香仍旧节，荔重亚新阴。\n不见沧浪叟，谁为楚客吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49186,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"缪西泠失意还山以诗见寄赋答","author":"成鹫","text":"偶然乘兴往，兴尽便当归。\n云鹤有奇翼，碧天无定飞。\n故人悬宿诺，前路愿多违。\n明日期君去，孤峰一振衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49187,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"还东林社中诸子见过赋此","author":"成鹫","text":"依旧去年人，还山自主宾。\n瘦藤支病骨，老树倚吟身。\n懒惰成吾癖，交游知我真。\n倘能恕迎送，来往不嫌频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49188,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答何赤木见赠","author":"成鹫","text":"草堂聊寄宿，到处即吾庐。\n推枕见明月，隔窗闻读书。\n冥心契玄理，即事成真如。\n最爱任公子，临渊不羡鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49189,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观音石","author":"成鹫","text":"山色无今古，居然清净身。\n一真常不动，万象自相亲。\n云过天衣白，花开宝髻春。\n夜来南海月，长照点头人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49190,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"童子石","author":"成鹫","text":"唤尔作顽石，旁观为不甘。\n轩渠忘语默，匍匐学槃谈。\n人事有雕琢，童心无二三。\n百城烟水外，相望在同参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49191,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天台岩","author":"成鹫","text":"同游成异物，旧约忆当年。\n寂寞天台路，临风一怆然。\n石梁通破屋，野火烧荒田。\n便欲从兹住，空山磨瓶砖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49192,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答顿惺师韵","author":"成鹫","text":"我爱此山久，来时秋已冬。\n閒身如病鹤，清影寄寒松。\n磊磊涧中石，遥遥天际峰。\n相看云水意，何日信孤筇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49193,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小西山阻雨赠石光静主","author":"成鹫","text":"雨过西山寺，栖迟夜雨天。\n不知归路远，多谢主人贤。\n一夕家常话，三心物外禅。\n兹游殊草草，重订再来缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49194,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马卧仙榜其堂曰乔松用韵题赠","author":"成鹫","text":"所托自高远，悠然思岱宗。\n审能存劲节，何用寄孤峰。\n带砺齐铜柱，风云迈赤松。\n大夫安足似，千古有犹龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49195,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"残漏","author":"成鹫","text":"群动寂以寂，此声微更微。\n幽人一为听，终夜独披衣。\n日月有代谢，风尘渐息机。\n永怀归白社，无梦到黄扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49196,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟入鼎湖赠同舟居士","author":"成鹫","text":"何幸识高贤，同舟岂偶然。\n暮山长带雨，秋水远浮天。\n归路征帆外，禅心落叶边。\n相期携手处，遥指鼎湖巅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49197,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"风琴","author":"成鹫","text":"金石发清响，隔窗知有风。\n五弦非所借，一气自潜通。\n流水不归梦，钧天时下空。\n倚檐独无语，閒杀老梧桐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49198,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"社集香莲庵同赋初秋野望用酡字","author":"成鹫","text":"车笠偶相过，香台胜事多。\n凭高感摇落，秋色满林阿。\n霁景连云薄，霜痕带叶酡。\n宗雷初到社，吟望更如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49199,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中答徐铎愚韵","author":"成鹫","text":"护懒因成病，求閒遂厌身。\n三竿欹枕日，一线破窗尘。\n药饵增形役，文章损性真。\n郡人徐孺子，高咏若为邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49200,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种柳 其一","author":"成鹫","text":"昨日是寒食，今朝蓺植初。\n言寻彭泽传，细读郭驼书。\n立处不妨密，行边正欲疏。\n春光眠复起，青眼为谁舒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49201,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种柳 其二","author":"成鹫","text":"种就宅边柳，朝来野趣新。\n渐闻莺语近，不与马蹄亲。\n力弱偏临水，心孤懒送人。\n东风为培植，宁羡六桥春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49202,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夕霞 其一","author":"成鹫","text":"暝色入返照，馀光何陆离。\n晦明互迭代，云物交蔽亏。\n玄黄战龙血，煜爚渐鸿仪。\n我欲匿光影，长歌天一涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49203,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夕霞 其二","author":"成鹫","text":"一片桑榆色，化为天文章。\n太虚互明灭，二气交玄黄。\n不逐赤鸟没，将随飞鹭行。\n野人驱犊返，暝色何苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49204,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石云山晚渡","author":"成鹫","text":"暝色渐迷津，招招唤渡频。\n烟横石云路，柳暗塔坡春。\n见月知潮汐，登舟辨主宾。\n芦中有穷士，应是未归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49205,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南雪","author":"成鹫","text":"炎乡曾未见，一见一咨嗟。\n越犬吠篱落，村童扑柳花。\n十年知可卜，九穗愿非奢。\n莫更分南北，乾坤总一家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49206,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋鹰","author":"成鹫","text":"正好乘风去，樊笼未可留。\n商声遍原野，归思在高秋。\n白草藏狐兔，青骹耻臂鞲。\n泬寥须纵目，遮莫类胡愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49207,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画","author":"成鹫","text":"一片涳濛色，平生水石心。\n天空云出岫，山静鸟依林。\n远近神俱往，登临兴转深。\n无弦志有在，终古待知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49208,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬午重阳后一日初住大通古寺罗戒轩黄葵村霍西牛陈臣张过宿同赋同葵村韵 其一","author":"成鹫","text":"已有重阳约，前期不待招。\n别君才几日，留客在今宵。\n宿草初漙露，新钟复应潮。\n晨兴事园圃，野菜及时挑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49209,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬午重阳后一日初住大通古寺罗戒轩黄葵村霍西牛陈臣张过宿同赋同葵村韵 其二","author":"成鹫","text":"未能舍良友，不觉出山扉。\n竹岛来筇杖，松梢挂衲衣。\n江城无事到，乡梦有时归。\n明发鹅潭北，群鸥各自飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49210,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答郭殿邦见过韵","author":"成鹫","text":"犬吠知有客，客从何处来。\n我心似柴栅，相见一为开。\n索句吟幽砌，看花上古台。\n东篱秋意尽，留兴待寻梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49211,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卜居","author":"成鹫","text":"仙老拔宅去，驱鸡飞上天。\n如何种桃处，鸣吠尚依然。\n我欲问往事，翁来殊少年。\n此中山可买，愿解腰閒缠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49212,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"双桂天公见过用韵赋答 其一","author":"成鹫","text":"江城朝放棹，冲破沧浪烟。\n辍棹入林去，春风相后先。\n焚香煨芋火，拾菜种花田。\n恰好留嘉客，斋钟正午前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49213,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"双桂天公见过用韵赋答 其二","author":"成鹫","text":"独立红尘外，低垂白发新。\n松高云里影，僧老佛边身。\n出处输前辈，蹉跎愧好春。\n却凭双桂主，一一指迷津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49214,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旱 其一","author":"成鹫","text":"途穷生计拙，临老事躬耕。\n不谓三春雨，翻为百日晴。\n火云乾木叶，斥卤入茶铛。\n吾道今如此，凭谁寄一声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49215,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旱 其二","author":"成鹫","text":"耕凿全无赖，萧条又日曛。\n秧针黄荏苒，草脚绿缤纷。\n近水难成润，远山时有云。\n不堪禅定处，野哭静中闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旱 其三","author":"成鹫","text":"自笑东樵拙，长饥不废禅。\n墦閒无冻馁，烟火有神仙。\n舍此不肯住，咄哉空复然。\n良田多旱岁，敢望又逢年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49217,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花田寒食","author":"成鹫","text":"出郭望村烟，村烟朝寂然。\n偶逢卖鱼者，相引过花田。\n有人怨长夜，无语忆当年。\n惆怅幽芳外，伊人何处边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49218,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答徐琶洲来韵","author":"成鹫","text":"我心渺无际，独向沧洲来。\n隐几舒双睫，坳堂覆一杯。\n美人隔江水，野径生莓苔。\n珍重池上约，莲花谁为开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49219,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答卢雁林来韵","author":"成鹫","text":"近水识潮信，盈盈时复消。\n所思半城市，相望一迢遥。\n好月不终夕，孤灯难竟宵。\n故山有丛桂，行矣不须招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49220,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答韩纬五来韵","author":"成鹫","text":"长夏读佳句，冷然冰雪寒。\n轻车驰峻阪，孤棹下危滩。\n自得风人旨，何须作者坛。\n有怀待君语，相见语应难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49221,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答崖口谭耿章来韵","author":"成鹫","text":"世界大如此，何妨容一僧。\n风曾留老叶，月不厌孤灯。\n空谷十年梦，寒山几度冰。\n因君思旧隐，云树渺层层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49222,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕前一日杨式公舟次大通阻风信宿同赋","author":"成鹫","text":"借问汾江路，经旬几往还。\n客途逢爆竹，归思在斓斑。\n烟雨云笼寺，风涛雪簸山。\n留君连夕话，诗兴正相关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49223,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日双桂天公偕何孟门过访归后唱和见寄用韵赋答 其一","author":"成鹫","text":"囊中剩有钱，频买渡江船。\n共载孟门叟，遥冲古渡烟。\n溪回松影直，林静鸟声圆。\n即此堪留语，何须杜撰禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49224,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]