[{"title":"雨中留蔡黄二亲","author":"何景明","text":"门巷泥深过客难，百年聊共此盘餐。\n浮云落日山河暮，细雨青春楼阁寒。\n近夜蛟龙还入浦，久阴鸿雁更移滩。\n年华滚滚相逢少，莫厌拌留到夜阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明日上先祖并兄墓","author":"何景明","text":"城西郁郁见佳城，驻马山头怅独行。\n万古松楸此丘垄，百年花柳又清明。\n音容地下空成梦，骨肉人间益怆情。\n更望老亲封葬地，恨随春草一时生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"袁惟武邀客泛舟夜下次韵","author":"何景明","text":"春水逶迤碧树边，满筵宾客醉开船。\n情亲不厌频来往，语笑何妨更接连。\n绕岸星河天共转，近城钟鼓夜初传。\n人间此会真非易，荏苒春风为尔怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"叶四公子西园","author":"何景明","text":"邀客西园公子家，东风二月已飞花。\n巷遮碧柳行春马，楼倚青山落暮鸦。\n移席尊垒遥出浦，入舟灯火更依沙。\n清吟况接同乡彦，应有文星动水涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张太守宅同贾长教会集","author":"何景明","text":"迟日香风细细回，招邀更喜广文陪。\n千年又下南州榻，二月同传北海杯。\n午院云阴移几席，春城雨色映楼台。\n三鳣五马皆高客，独愧江鸥共往来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴","author":"何景明","text":"东风回首即残春，日日清江愁白蘋。\n北去云霄无道路，西来天地有烟尘。\n身经贵贱知交态，事到安危忆古人。\n却喜故园桃李树，花开又见一回新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"袁冲霄先生同惟学过访","author":"何景明","text":"风起高城春日斜，相留肯醉野人家。\n白云对酒看山色，青草题诗到水涯。\n隔岸鸣莺深坐树，傍楼飞燕故穿花。\n竹林万古追游地，二阮风流未足誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同高铁溪先生刘朝信兄宿贤隐寺次韵","author":"何景明","text":"雨过青山暮色来，僧堂客至烛花开。\n半空楼阁星河动，满院松梧鹳鹤回。\n浮世黄尘兼赤日，古人白骨已苍苔。\n兵戈此际同杯酒，愁听春城鼓角哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"袁惟学南园","author":"何景明","text":"树里行杯坐日斜，池边立马听鸣鸦。\n苔阴雨暮寒青竹，水色春深静白沙。\n开径蓬蒿无俗客，入城花柳似山家。\n百年怀抱君应识，不是淹留为物华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登谢台","author":"何景明","text":"故国萧条登此台，暮云春色转相催。\n蓬蒿满地悲风起，楼观当空倒影来。\n山鸟不随歌舞散，野花曾傍绮罗开。\n今来古往无穷事，万载消沉共一哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨花","author":"何景明","text":"三月杨花袅袅白，忧人泪点暗中抛。\n漫天扑地有何意，惹草粘沙多似毛。\n忽趁狂风翻自远，更遮落日强相高。\n红尘满眼青楼暮，搅乱春愁为尔劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春","author":"何景明","text":"城边杨柳飞白花，河上春风吹暮沙。\n飘飘岁月此双燕，渺渺江湖聊一槎。\n人情翻覆似波浪，世态变化如云霞。\n驷马高车有忧患，只须料理东门瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜","author":"何景明","text":"黄菊花垂霜月阴，碧林丹树各萧森。\n关山日暮豺狼近，海水天寒雁鹜深。\n万事谁能看倚伏，此身何必问升沉。\n干戈未息疮痍在，永夜迟回折寸心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贤隐寺别刘朝信","author":"何景明","text":"腊近孤城送客难，一尊萧寺共悲欢。\n山空木叶鸣风急，水曲松林背日寒。\n岐路人间妨跃马，十年天上忆鸣鸾。\n知君此去长安近，拟向云霄直北看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁暮","author":"何景明","text":"岁暮孤城日易阴，溪边茅屋苦寒侵。\n江湖更觉龙蛇远，霜雪翻教燕雀深。\n病起一身惟纵酒，愁来双泪忽沾襟。\n山林钟鼎皆吾志，北望悠悠万里心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"对雪怀刘朝信","author":"何景明","text":"十月孤城云黯然，万峰飞雪此溪边。\n烟斜细细萦寒日，风急飘飘落暮天。\n何处玉珂迷紫陌，几家银烛照华筵。\n茅堂此际堪乘兴，不放山阴半夜船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄胡宗器悼内","author":"何景明","text":"玉箫不听凤凰鸣，银汉愁看织女星。\n永夜机中悲蟋蟀，十年窗下拾流萤。\n白头司马空多恨，清泪安仁更苦形。\n见说生儿是奇器，他年应慰九泉灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谷日","author":"何景明","text":"翠壑烟开风满林，岸云沙雪暝阴阴。\n城边瓜地谋生计，溪上青山独往心。\n野客开樽闲共语，田夫负耒亦相寻。\n茅堂春事年年异，不废莺花此日吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送任宏器入京二首 其一","author":"何景明","text":"四十功名亦壮年，丈夫才气岂徒然。\n渡河春羡蛟龙起，望阙晴看日月悬。\n江畔梅花初送雪，天边杨柳正含烟。\n悲歌此日临燕赵，未许奇游属马迁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送任宏器入京二首 其二","author":"何景明","text":"与尔相逢已十年，孤城此别意萧然。\n春来乡里交游少，日暮江湖涕泪悬。\n麒骥未应辞道路，豫章终拟出风烟。\n因君遥起长安思，况是征鸿又北迁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再送宏器","author":"何景明","text":"春日城边驻客车，夕阳山下惜离居。\n燕关怅望风云外，楚水分携雨雪馀。\n万里登台先郭隗，十年题柱老相如。\n长安三月莺花烂，得意休忘尺素书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题叶邦重山水画限韵","author":"何景明","text":"我爱君家画里峰，更看茅屋傍双松。\n白云不是人间路，沧海终期物外踪。\n野径一春无驻马，石潭深夜有蟠龙。\n移家欲向溪边住，坐听青山日暮钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题张给事安期图为乃翁寿","author":"何景明","text":"黄发仙翁白鹿车，安期亲见枣如瓜。\n玉盘已献千年实，玄圃先开五色花。\n壶里青天长日月，眼中沧海又尘沙。\n观图宛识封君面，寿酒频来给事家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠杨静之归真阳","author":"何景明","text":"人物遥从泮水看，眼中乡里旧衣冠。\n江鸿终拟登逵路，海鹄还应爱羽翰。\n九日黄花聊对酒，千山红树正凭栏。\n真阳城外秋仍好，怅望西风白露繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"到寺","author":"何景明","text":"楼阁山空暮景悬，上方钟鼓晚来传。\n白云独照孤灯里，新月遥临双树边。\n常怪陶潜庸入社，亦知苏晋爱逃禅。\n高僧老衲真吾侣，兰若松林可度年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太虚上人为起书楼","author":"何景明","text":"书楼新起赖休公，况接丹梯百丈通。\n秪为云松巢此地，不须车马到山中。\n白云倚槛临丹壑，明月开轩坐碧空。\n更作百年投老计，已将别业傍禅宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游西山胡本清邀留","author":"何景明","text":"独马寻僧春到寺，万山邀客晚登台。\n野人门巷松边入，稚子盘餐竹下来。\n江鸟亦随山鸟唤，红花偏映白花开。\n颜游苦为东风意，况是情亲岂浪猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新色寺与诸生留别","author":"何景明","text":"落日乡山客泪边，离怀相对各凄然。\n秋原台殿临寒景，长路风尘入暮天。\n去国已违丹壑志，望乡空赋白云篇。\n平生师友兼恩义，未卜相逢是几年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赵生书屋","author":"何景明","text":"城中无日不尘埃，骑马寻朋此地来。\n篱落过人惊鸟雀，庭阶留客扫莓苔。\n不妨浊酒缪绸醉，况有秋花烂熳开。\n人世相逢元未易，高城钟漏莫频催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题任宏器思亲卷","author":"何景明","text":"十载音尘别梦遥，月寒山色暮烟高。\n慈乌树老情空在，杜宇林疏血未销。\n银入东风伤绿鬓，泪随芳草湿青袍。\n海天恩义凭谁话，目断云孤思正劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠严生","author":"何景明","text":"严生开卦南门市，一日声名动此邦。\n共喜君平今有后，谁传郭璞世无双。\n白云昼覆焚香室，清月宵临读易窗。\n不把升沉更问汝，行藏吾已傍沧江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"述怀","author":"何景明","text":"紫芝黄独几回新，霜雪山中又见春。\n万古光阴双过客，五年江海一归人。\n豺狼满地无行路，戎马他乡有战尘。\n浉水河边钓台上，分明天与此闲身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周大","author":"何景明","text":"月白寒城菊有花，孤灯落叶映交加。\n冬亭雾露萦沙曲，夜阁星河傍水涯。\n千里宾朋常命驾，百年父子更通家。\n梁山楚水无多路，来往风尘易岁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题刘朝信唐学士瀛洲图","author":"何景明","text":"香袅重帘玉署清，翠微楼阁报平明。\n花边归马仙袍湿，柳外啼鸦御苑晴。\n秦国姓名青简重，龙图风月彩毫轻。\n千年芳躅君应接，共看层空一鹗横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送惟学南还","author":"何景明","text":"一年宾馆空弹剑，九月燕京未授衣。\n世路风尘悲旅鬓，春园花竹梦荆扉。\n扁舟旧泛心常往，万卷今开志岂违。\n京国重来又三载，临岐真恨不同归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵司训丧偶还罗山","author":"何景明","text":"燕姬砧杵催杨柳，楚客衣裳缉芰荷。\n宦况不为游远赋，闺情空续悼亡歌。\n愁闻郑监青毡苦，老觉安仁白发多。\n日暮千山归故国，秋深一雁度黄河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送易太史归省湖南","author":"何景明","text":"楚乡秋去息风尘，碧石清沙江色新。\n入里竞迎金马士，趋庭遥拜白头人。\n天边拄杖寻南岳，海畔登楼望北辰。\n亦是长沙词赋客，莫看摇落重伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八日王宗哲宅见菊","author":"何景明","text":"燕台菊树艳秋堂，楚客乡心益渺茫。\n人世几回逢一笑，天涯明日过重阳。\n高云锦石寒相映，细雨清沙湿不妨。\n况是右丞多雅咏，可能无兴醉花傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日雪荅崔太史","author":"何景明","text":"常年九日多风雨，风雪今年更可哀。\n飒飒仍兼木叶下，辉辉故弄菊花开。\n关河朔气催燕塞，城阙秋阴起汉台。\n今日春秋谁纪异，亦知君是广川才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦热","author":"何景明","text":"燕京闰夏清凉阻，楚客羸躯毒热偏。\n雨过即如卑湿地，云来翻助郁蒸天。\n南邦僻地寒江阁，西岳高峰玉井泉。\n思有丹梯凌倒景，恨无孤棹截长烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中","author":"何景明","text":"苑上行云细袅袅，城边鸣雨忽垂垂。\n炎天楼阁虚相映，燕地风尘日自悲。\n沧海未通吴贡赋，黄河犹闪汉旌旗。\n腐儒退食真何补，怅望寒江暮有思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻河南寇","author":"何景明","text":"檄书近报河南寇，楚塞梁关转战空。\n岂有兵车能远救，即愁道路阻难通。\n江淮城堑西南险，嵩洛山川天地中。\n今日至尊忧不细，几时诸将捷音同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":847,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西海子","author":"何景明","text":"寺下烟波春不开，苑中风浪隐楼台。\n源泉细绕西山出，云气深从北极来。\n万里乘槎观日月，十年登阁望蓬莱。\n黄尘碧水须臾事，莫使鱼龙夜夜哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":848,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汝忠宅待月同望之","author":"何景明","text":"空堂浊酒三人醉，万里清光迥未开。\n深夜西邻还鼓吹，碧天东望有楼台。\n虚疑星汉城边照，实怕风云海上来。\n坐对孤灯各愁思，九关哀角更相催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":849,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别王秉衡御史","author":"何景明","text":"客车梁地相逢日，骢马秦关独去时。\n荏苒风尘千里别，飘零江海六年思。\n旌旗暮入黄河戍，殿阁晴登华岳祠。\n揽辔宋应违壮志，挥毫先已见雄词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":850,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元夜仲修宅对月","author":"何景明","text":"春月同看此度圆，酒杯聊得慰愁颜。\n宫前火树晴相照，苑外金珂晚并还。\n南去汉兵连楚蜀，北来胡马傍关山。\n侍臣尚忆先皇宴，惭近清光霄汉间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":851,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"省中赠勤甫","author":"何景明","text":"春城紫禁转逶迤，退食相寻出省迟。\n昼漏遥从宫阁报，晴云先傍苑墙移。\n行吟才子阳春赋，坐映仙郎白雪姿。\n少日从游并英俊，十年潦倒愧君知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":852,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游郭氏园","author":"何景明","text":"郭侯园林清客心，况有楼阁炎天阴。\n亭亭高云石五色，飒飒白日松千寻。\n已办清尊为乐事，不须出郭开尘襟。\n郑谷秦楼岂异此，市朝岩壑空长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":853,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杜司训之蓝田","author":"何景明","text":"少陵诗卷名山水，王氏丹青老岁华。\n胜地常令一怅望，儒冠今喜慰生涯。\n青毡不愧商岩草，白发何愁杜曲花。\n秦岭终南得见否，宦游吾已倦尘沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":854,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张子之浙江","author":"何景明","text":"张子别我吟玉壶，荷花五月下江湖。\n南探禹穴行逾远，东望沧溟兴不孤。\n司马少年游万里，左思当日赋三都。\n平生壮观今尘土，回首高歌愧尔徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":855,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄杭东卿高曾唯二宪副","author":"何景明","text":"旧游俱是吴中俊，相忆遥为越下吟。\n他日云霄须比翼，此时金石更同心。\n楼船水战江流急，鼓角秋城海日阴。\n寇贼两乡今阻绝，北云南树各沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":856,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"简施聘之","author":"何景明","text":"欲扳御史新骢马，拟脱仙郎旧锦袍。\n五色文章真凤鸟，百年功利一鸿毛。\n当垆不爱燕姬少，倚瑟番惊越调高。\n二十年来空落魄，风流今已愧人豪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":857,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿西涯相公","author":"何景明","text":"黄阁文章鸣大雅，玉机功业赞维新。\n十年天下先忧激，五亩园中独乐身。\n南极寿星朝北斗，灵芝仙草映长春。\n裴公郭相看前代，社稷苍生望老臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":858,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小斋初开崔郭田三君子至","author":"何景明","text":"本买堂斋为客居，敢扳冠盖枉吾庐。\n清风坐引高人榻，深夜门停长者车。\n竹下凉蟾辉几杖，花间萤火静琴书。\n黄门翰苑俱邻近，浊酒盘餐意不疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":859,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送雷长史","author":"何景明","text":"彤管先朝随帝子，白头今日奉王孙。\n汉庭亦羡相如美，楚客重看贾传尊。\n花下图书开玉殿，日高琴瑟在朱门。\n十年亭阁淮西宴，肠断梁王雪夜樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":860,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄黔国公","author":"何景明","text":"万里山川开百粤，十年戎马暗三巴。\n伏波铜柱冲炎塞，横海楼船出瘴沙。\n鸿雁不传天北字，琼瑶空忆日南华。\n飘飘奉使金门客，目断银河八月槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":861,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵元泽之嵩明州","author":"何景明","text":"日莫千花出汉园，秋深万水入湘沅。\n干戈喜见黄尘息，勋业愁看白发繁。\n西域瑶琨常北贡，南天星斗似中原。\n一官万里何嗟叹，倚剑长歌行路言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":862,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕","author":"何景明","text":"楚客旅魂惊巧夕，燕京风俗斗穿针。\n楼台送暑催秋扇，关塞迎寒起暮砧。\n海内弟兄风雨梦，天涯儿女岁时心。\n乘槎莫问支机石，河汉年年此夜阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":863,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨夕集世其馆","author":"何景明","text":"秋风淅淅吹人衣，鸣雨潇潇晚细微。\n万里宾朋留不数，十年江海愿常违。\n高城木叶闻先下，客舍流萤见已稀。\n为报春来鸿雁侣，塞门霜雪好南归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八日勤甫惠菊","author":"何景明","text":"燕京明日是九日，庭下菊花无一花。\n岂意高人分玉树，遂令僻地有瑶华。\n当轩独酌怜秋石，倚槛丛开映晚沙。\n便语南邻田给事，不妨就饮过西家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宗哲初至夜集","author":"何景明","text":"卫川舟楫九秋旋，京洛衣冠更此筵。\n万里况逢鸿雁候，一杯仍对菊花天。\n灯前月落城乌起，堂上云开塔树悬。\n聚散古今同逆旅，莫看风景倍悽然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日送师御史之浙中","author":"何景明","text":"燕台九日送行旌，欲行不行骢马鸣。\n祖席正逢黄菊兴，亲闱先动白云情。\n霜飘斧钺江边驻，日出楼船海上行。\n磊落此身真报主，岂徒壮观说平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":867,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和张子纯白发","author":"何景明","text":"我见秋风惊壮心，君悲白发苦相侵。\n愁多不道潘年少，吟苦谁知越思深。\n客里岁时供览镜，天边霜雪助沾襟。\n平生浪说如云盛，蓬鬓稀疏式似今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张国宾进万寿表还","author":"何景明","text":"名王表达维藩礼，宾使恩勤奉教时。\n凤管暂停秦女曲，龙旂遥睹汉官仪。\n秋枫旅梦回青琐，春草乡情动玉池。\n归到定知承睿问，雪园梅殿有佳期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]