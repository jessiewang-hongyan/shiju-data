[{"title":"后院纵步","author":"黎贞","text":"棋局声高书梦阑，人间何处更商颜。\n风薰四壁鸟声碎，花落中庭蝶影闲。\n玉剪差池帘幕燕，翠屏浓澹画图山。\n诗成一笑乾坤老，万事无心自掩关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49202,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兵后送人还乡","author":"黎贞","text":"烽息山城乍战休，断魂江上送归舟。\n乡关寥落风尘晚，泽国荒凉草树秋。\n旧业半随烟烬灭，故江犹带夕阳流。\n凄然闾里悲相见，满目莺花总是愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49203,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒食遇雪","author":"黎贞","text":"三月边城雪未乾，琼瑶飞舞海天宽。\n榆烟寂寂千家晓，柳絮纷纷万里寒。\n歌管声中银作屋，鞦韆影里玉为竿。\n半生踪迹遍南北，知是明年何处看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49204,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白鹤观望仙台","author":"黎贞","text":"仙子已乘仙鹤去，山中空有望仙台。\n啼残幽鸟日将暮，落尽好花春未回。\n入画峰峦流水外，倚空楼观白云堆。\n岭南狂客经游处，几度题诗扫绿苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49205,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蓬莱阁","author":"黎贞","text":"蓬莱阁上望蓬莱，万丈瀛洲缥渺开。\n云鸟烟光巢翡翠，海门蜃气结楼台。\n安期丹灶今何在，徐福楼船去未回。\n老我一襟怀古意，倚阑登眺重徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49206,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桑墟晓行","author":"黎贞","text":"玉宇苍凉曙色分，楚歌四起杳相闻。\n桑林短短平依路，茅屋低低半是云。\n旧日琴书成远梦，倚空刀剑谩从军。\n谋身莫笑儒生拙，投笔于今可立勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49207,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜宿南津","author":"黎贞","text":"夹岸丛芳涌翠痕，寒江烟火数家村。\n云连野色生离思，风激湍声入梦魂。\n时把香醪消永日，愁闻戍鼓报黄昏。\n缘知老母遥相望，华发萧萧独倚门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49208,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客中春暮","author":"黎贞","text":"铁砚磨穿笔正投，管弦声里月如流。\n白云桑梓家千里，乌帽轮蹄驿九州。\n匣露青萍浮瑞彩，杯倾竹叶散羁愁。\n苦吟只恐春归去，夜夜南园秉烛游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49209,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登滕王阁","author":"黎贞","text":"物换星移几百年，毁垣颓址尚依然。\n地连南浦临江驿，门泊东吴贾客船。\n岸芷汀兰青苒苒，落霞孤鹜影翩翩。\n豪华去后人何在，满目青山夕照前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49210,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄冈州训导吴南枝","author":"黎贞","text":"草草相逢又别离，论交犹未惬襟期。\n常思杯酒论文日，未复连床对雨时。\n紫水暮天烟树杳，白云瘴阁海帆迟。\n天涯日晚逢来使，聊折梅花第一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49211,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游东湖黄处士园","author":"黎贞","text":"拂拭枯桐五柳东，故人遥在白云中。\n数椽茅屋萝将合，一线松门路暗通。\n白雪调高泉漱石，苍龙影瘦竹摇风。\n怡情更有钩诗酒，惯许东湖处士同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49212,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柬斗峒伍汝梅","author":"黎贞","text":"几年辜负钓鱼竿，万里归来马离鞍。\n黄菊有期佳节赏，青山留得白头看。\n尘埃苒苒皆春梦，猿鹤萧萧共岁寒。\n垂老论交情更古，新题莫惜问平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49213,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽龙训导二首 其一","author":"黎贞","text":"书剑飘零庾岭东，邑庠三载振儒风。\n子虚赋就心犹壮，薤露歌残梦已空。\n杳杳家山云树外，茕茕形影月明中。\n可怜埋玉冈城路，犹有文光贯夜虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49214,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽龙训导二首 其二","author":"黎贞","text":"云气从龙接九天，奎文遽隔紫微躔。\n衣冠牢落三千路，诗礼从容五十年。\n蘋藻有心严俎豆，箕裘得意富韦编。\n伤心迢递招魂赋，处处青山有杜鹃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49215,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别履祥兼柬曾主事刘给事三首 其一","author":"黎贞","text":"楚楚丰仪观国宾，东曹三载擅精神。\n一经学问由先世，三语风流冠昔人。\n彩鹢蒹葭香浦月，仓庚杨柳凤城春。\n青年事业应能致，独有忠勤善立身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49216,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别履祥兼柬曾主事刘给事三首 其二","author":"黎贞","text":"相知长忆令先人，三世通家复有君。\n洒翰墨花翻彩鹢，弹冠行色照青云。\n文园不但才情艳，洛下应增纸价新。\n石壁关山分手处，绿波春草澹晴曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49217,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别履祥兼柬曾主事刘给事三首 其三","author":"黎贞","text":"户部端严秉至公，黄门言论气如虹。\n早年郡邑声名重，一旦风云步武同。\n环佩清班联玉笋，箫韶大飨锡彤弓。\n君行捧刺通名处，为报沧洲属老翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49218,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠黄主簿昭","author":"黎贞","text":"黄侯才气重如山，佐治琴堂政不繁。\n三载簿书淹矮屋，一朝鸣佩簉朝班。\n孤舟载月离熊海，匹马西风度庾关。\n此去定应承顾问，好将经济答龙颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49219,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客路书怀","author":"黎贞","text":"半生尘土一儒衣，两鬓萧骚白接篱。\n贾傅忧时徒自切，侯生际遇独何迟。\n吴山楚水淹行役，象岭羊城恼别思。\n去路人家烟缕缕，临溪官驿柳丝丝。\n花笼越女迎仙馆，风飒吴娃卖酒旗。\n诗兴凄凉怜杜甫，琴音岑寂惜钟期。\n船头吹笛斜阳外，篷底闻砧夜月时。\n归梦已随飞雁去，羁情不逐彩云移。\n江门渡口莼鲈美，尘外亭前橘柚肥。\n抚景莫嗟家万里，天书已下凤凰池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49220,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别罗复谦陈楚良熊隆祖","author":"黎贞","text":"萧萧戎马客襄平，岁晚相逢始识荆。\n愧我蹉跎如孑立，怜君邂逅若平生。\n琴书夜月青毡帐，诗酒春风细柳营。\n贫贱十年知世态，死生今日见交情。\n莼鲈兴动思张翰，鸡黍期寒笑巨卿。\n霜落雁群离朔漠，天高鹏运转南溟。\n匡庐风物牵情远，庾岭江山入梦清。\n携手河梁忍分袂，几时重与话寒盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49221,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清河谣","author":"黎贞","text":"河清绾髻春意闹，三十不嫁随意乐。\n江行水宿寄此生，摇橹唱歌桨过滘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49222,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鹿步谣","author":"黎贞","text":"细帽茜裙趁墟市，飞驮纷纷如云起。\n二月十五大王斋，斗歌都道娘来里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49223,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"外海谣","author":"黎贞","text":"裹肚为裙纱作髻，蓢滘日长取菰米。\n潮平洲渚却归来，齐唱一声水荡弟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49224,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"平康谣","author":"黎贞","text":"幼小婚姻在乡里，络布为裙蕉布被。\n唱歌互答多比情，相逢便道娘十几。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49225,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新宁龙溪山石室","author":"黎贞","text":"龙溪山高青若蓝，下有百尺之云岩。\n丹厓翠壑峻且巉，朝朝莫莫飞晴岚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49226,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"盘桓云壑图","author":"黎贞","text":"幽人厌尘烦，放情在云壑。\n云壑窈而深，盘桓得真乐。\n野服制芰荷，闲朋结猿鹤。\n云从肤寸生，水自苍岩落。\n兴来发长啸，清风振林薄。\n我本山水人，羁栖向城廓。\n闻风动遐想，题诗寄寥廓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49227,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"入白石山","author":"黎贞","text":"攀萝入深坞，云木晦以窅。\n言寻巢父踪，绝境听鸣鸟。\n晴烟纷羃历，人家在林表。\n清露滴松间，微风猎荒草。\n振襟登屴崱，决眦众山小。\n遥念幽居人，长吟隔丛筱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49228,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚次蛮溪渡用唐韵","author":"黎贞","text":"杨柳条长锁翠烟，蹇驴吟到渡头船。\n槎乘客去知何处，剑作龙飞异昔年。\n浪暖桃花飘赤锦，风清荷叶弄青钱。\n寄言杜宇休调舌，容我蛮溪一夜眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49229,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠眠云道者","author":"马旭","text":"升旭漂漂照混茫，游云焉得白云乡。\n风吹稀发龙吟冷，气袭衣衾鹤梦惊。\n沧海伏沉通宝焰，桑榆栖住享春光。\n孤鹃啼响千峰里，缥缈高堂更断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49230,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龟峰秋色","author":"王思谏","text":"城下长江城上峰，水光倒浸玉芙蓉。\n登临可著低低屐，涉览宜撑短短筇。\n且把金樽邀夜月，莫辞乌帽落西风。\n星河不隔飞云顶，早晚凭高到九重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49231,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南山钓台","author":"王思谏","text":"相水东流湾复湾，苔矶流落自南山。\n浪翻桃瓣红鳞起，日入芦花百鸟还。\n渔笛几声江月上，客星一点水云间。\n如何结得羊裘侣，坐占矶头七里滩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49232,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题何仙姑祠","author":"王思谏","text":"一镜水泉漱玉凉，炼成云母夜生光。\n壶中自是烟霞变，井底谁知日月长。\n冷浸银河涵碧落，潜通地脉入沧浪。\n玉人环佩知何处，千载犹闻药石香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49233,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠戴翠坡二首 其一","author":"范震","text":"徵君小筑碧云窝，座对莲峰拥翠螺。\n挺秀修篁森绕屋，生香细草软连坡。\n岚光黛色供吟趣，鸟韵泉声和醉歌。\n好似鹿门庞老隐，几时公暇一相过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49234,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠戴翠坡二首 其二","author":"范震","text":"云庄百亩列沟塍，一室萧闲养性灵。\n龙穴南瞻春意绿，鹅山西顾晓鬟青。\n庭梧岁长鸾凰干，径竹时添翡翠翎。\n珍重主人多爱客，玉壶终日酒如渑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49235,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"觉华烟雨","author":"黄裳","text":"丛林幽寂枕江隈，烟雨濛濛昼不开。\n过客不知兰若处，但闻钟磬数声来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49236,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"市桥春涨","author":"黄裳","text":"送春骤雨若倾盆，霁晓漫漫潦涨翻。\n自愧未穷观水术，石阑徙倚到黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49237,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秫坡像赞","author":"董筐","text":"江湖归隐鬓星星，白水青山远世情。\n尊酒可能长日醉，钓丝低傍晚风清。\n看云自足成幽况，垂老应知不用名。\n深愧当年尘上客，仓皇何事日劳形。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49238,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朝觐谢恩诗三首 其一","author":"梁继灏","text":"凤阙龙楼插汉高，清明朝会集英豪。\n山呼万岁还丹辗，班蹙千官拜衮袍。\n红日光中承御诏，紫霞深处宴蟠桃。\n醉来自觉沾恩重，尽把新词付彩毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49239,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朝觐谢恩诗三首 其二","author":"梁继灏","text":"九重漏彻动晨钟，万国衣冠正会同。\n拜舞影摇三殿外，胪传声度五云中。\n御台赐酒羔羊白，绣衮绚霞宫锦红。\n惟有侍臣才思捷，连篇献赋敌扬雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49240,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朝觐谢恩诗三首 其三","author":"梁继灏","text":"庭燎摇光双凤阙，布衣直上九重天。\n方逢海澨朝宗日，正是番蛮入贡年。\n万国讴歌归圣化，群黎鼓舞乐乾元。\n草茅贱士观光处，朝退从容漫著鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49241,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠龙津渔逸","author":"梁继灏","text":"龙津景概即蓬瀛，中有高人乐隐情。\n风月一竿忘宠辱，烟波两岸为逢迎。\n歌声唱彻云凝野，笛韵吹馀月满庭。\n只恐九重来远猎，龙车冲散惊鸥盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49242,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吊何梅陂","author":"梁继灏","text":"壮岁曾游京国边，春风拂袖早归田。\n观梅兴拟林和靖，饮酒怀同李谪仙。\n仁孝未酬萱草德，梦魂先别鹤鸰原。\n不堪回首龙池岸，古木寒烟化杜鹃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49243,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秫坡像赞","author":"陈湘","text":"秫坡白头嘉遁叟，囊括江山秀。\n酒葫芦，挂树头。\n打鱼船，缆渡口。\n这风流，世间何处有。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49244,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"娥眉山","author":"温裕","text":"巍然山势号娥眉，胜概天生景物奇。\n花木芳菲三月节，烟霞缭绕九秋时。\n前山寺毁无佳趣，落日岩空有断碑。\n几度凭高成独眺，长歌一曲起遐思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49245,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柳城寓怀","author":"张志逊","text":"浪迹金门岁几更，柳城侨寓独伤情。\n飘零远道思乡井，牢落馀生荷圣明。\n万斛离愁何处写，五更残漏若为听。\n一家妻子团圆坐，愿学匡衡颂太平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49246,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓出都门","author":"朱华庆","text":"一放累臣远渡辽，此身如叶任风飘。\n生投边塞蒙优渥，笑出长安任寂寥。\n飞雁自怜依鸭绿，战袍欣得换金貂。\n太平无事空波逐，何处涓埃答圣朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49247,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辽阳即事","author":"朱华庆","text":"平沙日日望霓旌，谁道终军浪请缨。\n已见六龙驱虏骑，肯容孤犬吠尧声。\n鹤归城上猿啼急，鸭绿江边雁影横。\n万里波臣伤白发，最怜枯骨葬长城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49248,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"隋宫","author":"朱华庆","text":"数株疏柳数枝柔，带雨临风不自由。\n芳草已随春浪变，竹西犹看御龙舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49249,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贞女桥","author":"朱华庆","text":"月明华表映丝萝，恨却双星未渡河。\n千古鹊桥如梦里，只看危石砥狂波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49250,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湖岩石室","author":"林逊","text":"岩穴神仙宅，山门向顶开。\n白云閒不锁，留与鹤归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49251,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"峡山寺","author":"戴云","text":"龀年探访二翰轻，攀磴何妨皓首行。\n峡坼云霾天地别，梦回江渚鸥鹭情。\n留题谁拟无名氏，世事同归一局枰。\n遥指茅庐二三里，醉还犹忆听春莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49252,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"撒马儿罕见雁怀友","author":"陈德文","text":"上林书札为谁将，汉节苏卿忆帝乡。\n万里承恩来此地，何年归觐列鸯行。\n绣衣尘满关山杳，骢马星驰驿路长。\n此日云边看雁字，老怀无计附同窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49253,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石室云蒸","author":"苏恭则","text":"山回叠嶂锁苍烟，綵笔留题几百年。\n桂岭奇峰青翠兀，泐溪流水绿漪涟。\n岩扉暗滴千寻雨，石径傍通一窦天。\n寂寞断碑芳藓合，禅房云冷几人眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49254,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"峡山寺","author":"朱稚","text":"孤剑冲星憩碧湾，桃花流水别人间。\n一竿红日高低路，两岸清风远近帆。\n猿玉千秋凝蝶梦，仙棋几局坐松关。\n兴狂拟结青莲社，忧国年来鬓欲斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49255,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"峡山寺","author":"谭新","text":"百尺丹梯长绿苔，二禺延伫一襟开。\n寻山风味闲中得，逐水年华何处回。\n日晒老僧参佛衲，云封庶子读书台。\n投簪我亦为山主，风景宜人取次裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49256,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题梅","author":"欧阳初","text":"炎方无雪伴清癯，依旧心肠铁石如。\n何处相思最愁绝，罗浮月晓梦回初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49257,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题莫状元祠","author":"莫志忠","text":"浪暖桃花紫阁春，丹墀对策疾如神。\n词源滚滚倾三峡，英气冲冲第一人。\n天上雨师呈玉露，街前风伯洒京尘。\n先生若得宣尼寿，尧舜其君尧舜民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49258,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"驺虞诗","author":"陈琏","text":"圣教敷，遍寰区。\n吁驺虞，见雒墟。\n步履啖食何尔殊，生来自有仁义俱。\n目盱盱，烁明珠。\n玉作爪，雪为肤。\n黑文班班备五采，形质自异凡于菟。\n进皇都，叶贞符，世所无。\n不比九真犀，不比渥洼驹。\n祥麟与瑞凤，太史堪并书。\n小臣作诗颂圣德，千秋万载昭皇图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49259,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"麒麟诗","author":"陈琏","text":"至和储精，麒麟降生。\n麇身牛尾，马蹄龙睛。\n身备五采，绚烂晶荧。\n性尤仁厚，瑞图可徵。\n不远万里，来自南溟。\n祥云瑞霭，光绚阙廷。\n出入金门，迩乎龙軿。\n群臣聚观，喜跃弗胜。\n惟昔太祖，天命是膺。\n皇风以穆，皇道以贞。\n九夷八蛮，莫不来庭。\n冲和氤氲，屡致嘉祯。\n皇帝嗣位，天下以宁。\n仁被动植，泽及含灵。\n祯祥沓至，以昭太平。\n祥麟之来，适际文明。\n惟帝之圣，贞符是承。\n有濯厥声，耀于万龄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49260,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狮子诗","author":"陈琏","text":"圣皇御寰宇，声教周八极。\n四夷慕仁化，入贡来重译。\n珍禽与奇兽，所见迈于昔。\n维时有神兽，其类同白泽。\n气禀金精刚，名为群毛特。\n绀眸悬日星，碧爪利锋镝。\n雄诡挺殊姿，杰异见材力。\n或时恣哮吼，百盖俱辟易。\n一朝从西来，万里度沙碛。\n百兽同率舞，无乃感圣德。\n昔汉章和间，入贡自安息。\n有唐贞观中，又复来西极。\n是后寂无闻，奇玩喜今日。\n欢声腾厚地，嘉叹动百辟。\n小臣际时康，歌颂乃其职。\n抽毫纪嘉瑞，千古光史册。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49261,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湘灵操","author":"陈琏","text":"玉貌兮婵娟，联翠袖兮风前。\n望翠华兮已远，临湘水兮凄然。\n凤不来兮岁阑，秋气肃兮空山。\n倚枫江兮惆怅，泪染竹兮斑斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49262,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"箕山操","author":"陈琏","text":"箕山兮幽幽，箕水兮浟浟。\n山可耕兮而樵，水可饮兮而游。\n我于世兮无求，彼何故兮遗我以忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49263,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风木操","author":"陈琏","text":"维风之飂飂兮，而树之相樛兮，念夫亲之悠悠兮。\n维风之淅淅兮。\n而树之槭槭兮，念夫亲之不可复得兮。\n树之有风，犹可止兮。\n吾之念亲，终无已兮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49264,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]