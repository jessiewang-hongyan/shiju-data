[{"title":"次复柬先生纪行之什二十首 其八 练塘","author":"胡奎","text":"山前流水护方塘，山下孤村落日黄。\n队队奚官来洗马，如云苜蓿满沙场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56861,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次复柬先生纪行之什二十首 其九 散关","author":"胡奎","text":"山花烂漫鸟间关，白首不知行路艰。\n道上儿童频指点，先生天上载书还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56862,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次复柬先生纪行之什二十首 其十 丹阳","author":"胡奎","text":"丹阳郭里夜闻箫，无限离情付柳条。\n却忆故人千里外，山青月白思遥遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56863,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次复柬先生纪行之什二十首 其十一 奔牛","author":"胡奎","text":"吕城春水与天连，黄帽操舟百丈牵。\n一片征帆如鸟疾，归心更比鸟争先。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56864,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次复柬先生纪行之什二十首 其十二 洛社","author":"胡奎","text":"花满长堤水满河，一帆风雨夜深过。\n归心不省春先去，洛社亭台碧树多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56865,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次复柬先生纪行之什二十首 其十三 苏州","author":"胡奎","text":"船过阊门得顺风，此身如坐太虚中。\n晚凉移向枫桥泊，人在西头月在东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56866,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次复柬先生纪行之什二十首 其十四 吴江","author":"胡奎","text":"七十二峰青可怜，白鸥飞处水如天。\n旁人错认玄真子，万顷烟波一钓船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56867,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次复柬先生纪行之什二十首 其十五 太湖","author":"胡奎","text":"吴中女儿学画眉，日高打桨放船迟。\n笑将湖水作明镜，回首问郎宜不宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56868,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次复柬先生纪行之什二十首 其十六 平望","author":"胡奎","text":"江上鲈鱼三尺长，渔翁撒网立斜阳。\n到城买得真珠酒，笑倚蓬窗待月光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56869,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次复柬先生纪行之什二十首 其十七 王泾","author":"胡奎","text":"柳花溪上木兰船，只许閒鸥伴我眠。\n乘月到家无百里，此时那有别情牵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56870,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次复柬先生纪行之什二十首 其十八 秀州","author":"胡奎","text":"绕城官柳碧于云，湖上人家两处分。\n一曲吴歈歌子夜，满船凉月白纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56871,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次复柬先生纪行之什二十首 其十九 常州","author":"胡奎","text":"毗陵春去欲锁魂，红叶池台几处存。\n买得一双金剪子，梦随蝴蝶到家园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56872,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次复柬先生纪行之什二十首 其二十 煮茶图","author":"胡奎","text":"落花风飏煮茶烟，水榭高閒即是仙。\n想见杭州苏太守，赋成龙井试春泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56873,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题一天秋月诗卷为侯少府作 其一","author":"胡奎","text":"玉堂学士老东坡，载酒西湖逸兴多。\n寄语文章侯少府，一天秋月夜如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56874,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题一天秋月诗卷为侯少府作 其二","author":"胡奎","text":"一天秋月夜方中，时有南来水面风。\n总是乾坤清意味，尽情付与觉非翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56875,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题一天秋月诗卷为侯少府作 其三","author":"胡奎","text":"一天月照凤凰城，钟鼓迟迟报五更。\n候吏不来公馆静，此时看得最分明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56876,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题一天秋月诗卷为侯少府作 其四","author":"胡奎","text":"一天秋月湛冰壶，千里家山入画图。\n若向涌金门外看，西湖即是涌金湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56877,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题一天秋月诗卷为侯少府作 其五","author":"胡奎","text":"一天明月照清秋，风露凉生紫绮裘。\n若遣玲珑歌一曲，千年重见白杭州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56878,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"见新燕有感","author":"胡奎","text":"东家昨日杏花开，西舍今朝燕子来。\n载酒莫辞花下醉，春风能得几时回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56879,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春","author":"胡奎","text":"今朝试写宜春帖，拾得江南第一花。\n秋水为神玉为骨，正疑春色在诗家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56880,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柳塘野艇","author":"胡奎","text":"杨柳青青水一湾，隔江数点雨馀山。\n钓船好向溪南泊，莫待风波及早还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56881,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和靖观梅","author":"胡奎","text":"水痕清浅雪初消，望过湖边第一桥。\n处士不来花自发，空山鹤去晚萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56882,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次咏轩雨夕见寄","author":"胡奎","text":"城头月黑乌栖夜，童子敲门忽送诗。\n醉眼近灯看数过，上床吟到雨来时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56883,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次杨铁笛漫兴韵 其一","author":"胡奎","text":"红泥亭子是谁家，白石矶头人浣纱。\n好事提壶劝美酒，一声飞上合欢花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56884,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次杨铁笛漫兴韵 其二","author":"胡奎","text":"湖上雨乾花片轻，铁笛新翻曲谱成。\n西施郑旦船尾卧，狂杀江南阮步兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56885,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次杨铁笛漫兴韵 其三","author":"胡奎","text":"南山北山眉黛青，日日载酒望湖亭。\n买得湖船十样锦，醉倒美人双玉瓶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56886,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次杨铁笛漫兴韵 其四","author":"胡奎","text":"劝郎杯酒莫放乾，与郎裁衣禦春寒。\n明日郎须过湖饮，花旗孑孑树长竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56887,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和小游仙 其一","author":"胡奎","text":"白榆历历绛河东，清露无声堕碧空。\n手把玉笙吹一曲，月临南斗正当中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56888,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和小游仙 其二","author":"胡奎","text":"曾见天书赤玉文，非烟非雾结氤氲。\n群仙不著飞霞佩，自制霓裳月色裙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和小游仙 其三","author":"胡奎","text":"樱桃窗下梦青春，蝴蝶翩翩是幻身。\n山鸟一声惊梦觉，始知身是梦中人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"听雪","author":"胡奎","text":"虚室寒生一片云，不知窗外白纷纷。\n阳春别有无弦调，只许诗人静处闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦雪","author":"胡奎","text":"梦跨仙家白玉鸾，瑶台高处太清寒。\n不知谁把并州剪，剪得银河一水乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"看雪","author":"胡奎","text":"去年腊前不见雪，今年子月见飞花。\n凭谁说向林和靖，莫把梅花擅作家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过戚姬港作 其一","author":"胡奎","text":"戚姬山下卞家庄，花满林皋水满塘。\n昨日鸡豚赛春社，丁男祈麦女祈桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56894,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过戚姬港作 其二","author":"胡奎","text":"桑叶重重戴胜飞，垄头斜日荷锄归。\n柴门不见催租吏，隔屋长闻织妇机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56895,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题挟弹图","author":"胡奎","text":"大堤春草碧茸茸，马上人弯落月弓。\n寄语莫抛金弹子，任渠莺啭百花风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56896,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿净上人房","author":"胡奎","text":"八字桥边一径斜，寻诗来到梵王家。\n平明起看门前雪，一色都开檐卜花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56897,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题朗上人听松轩","author":"胡奎","text":"一片潮音落太空，禅馀多在月明中。\n等閒听到无声处，不是长松不是风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56898,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题庆上人住云栖","author":"胡奎","text":"应无所住住云中，云也何曾有定踪。\n夜半月明天似水，了无一点碍虚空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56899,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题柯丹丘竹","author":"胡奎","text":"奎章阁下柯亭管，学得云间綵凤鸣。\n还逐轩皇上天去，夜凉吹过阖庐城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56900,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题贺公画","author":"胡奎","text":"百顷荷花一叶舟，贺家湖上汎高秋。\n南风吹散朝来雨，移得青山近屋头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56901,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题阊门杨柳","author":"胡奎","text":"阊门杨柳郁金条，恰似章台舞女腰。\n舞到秋来人不见，淡烟疏雨晚萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56902,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望雨 其一","author":"胡奎","text":"一月不雨农心忧，两月不雨田无秋。\n仰看北斗酌元气，安得倒挽天河流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56903,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望雨 其二","author":"胡奎","text":"大田槁苗一尺长，河水乾枯木叶黄。\n似闻昨夜月离毕，明日甘霖来沛滂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56904,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立秋","author":"胡奎","text":"六月望后见秋风，金井先飘一叶桐。\n便觉人间有凉意，三更月在绛河东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56905,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客中除夕","author":"胡奎","text":"守岁天涯感物华，朝盘谁复颂椒花。\n满城列炬明如昼，钟鼓声中夜不哗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56906,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"路闻鹧鸪","author":"胡奎","text":"苦竹冈头一两声，钩辀格磔为谁鸣。\n纵行不得须行去，莫道离人不耐听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56907,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日书情 其一","author":"胡奎","text":"雨晴山径净无苔，犹有閒人作伴来。\n满抱离情浓似酒，春风吹上小桃腮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56908,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日书情 其二","author":"胡奎","text":"鹧鸪啼处雨初收，贪看青山不下楼。\n纵使山高千万丈，也应不隔异乡愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56909,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日书情 其三","author":"胡奎","text":"诗瘦非关病折磨，野棠花落奈愁何。\n沅陵江水深如海，不似徐卿别思多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56910,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日书情 其四","author":"胡奎","text":"思家千里日如年，借得禅房静处眠。\n灵鹊有声催梦醒，敲门人送买船钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56911,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿澧陵山村 其一","author":"胡奎","text":"蚕丛山下澧陵村，犹有先农古意存。\n千里閒愁添白发，一镫瘦影伴黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56912,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿澧陵山村 其二","author":"胡奎","text":"当窗月出猿啼树，刮地风来虎到门。\n赖得主翁多好事，地炉烧竹晚移尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56913,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿澧陵山村 其三","author":"胡奎","text":"沅水罗纹色正妍，今朝风顺好开船。\n棹郎莫说风波险，已许江神赛纸钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56914,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡江","author":"胡奎","text":"日出江头春雪消，双鬟荡漾木兰桡。\n歌声唱入武陵去，人面桃花一样娇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56915,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桃源即事","author":"胡奎","text":"桃花源上看青春，少妇与郎行负薪。\n槲叶覆身花压鬓，相逢不是避秦人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56916,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨花","author":"胡奎","text":"有意纷纷挽落晖，无情衮衮傍人飞。\n莫教化作浮萍草，流向天涯忘却归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56917,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过鞋山","author":"胡奎","text":"一弯弓影落晴湖，不见湖边大小姑。\n大姑化石心不转，小姑已嫁彭郎夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56918,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春夜遇雨宿辰州古寺","author":"胡奎","text":"春愁如海夜如年，茶鼎分泉手自煎。\n白发老僧同听雨，就床相伴佛镫眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56919,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对月夜坐","author":"胡奎","text":"天际凉风破夕阴，松花满瓮共谁斟。\n异乡月色同千里，一纸家书抵万金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56920,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日即事 其一","author":"胡奎","text":"雨深庭树始鸣蝉，小簟鱼波午梦圆。\n老鹤一声修竹外，有人来候煮茶烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56921,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日即事 其二","author":"胡奎","text":"枇杷子黄山杏肥，海榴花发燕雏飞。\n绿窗五月南风起，金剪新裁白苧衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56922,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋见月","author":"胡奎","text":"碧落无尘万籁空，月临南斗正当中。\n何由得似长生兔，万古千秋夜夜同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56923,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观日","author":"胡奎","text":"夜半鸡鸣海日红，六龙飞出五云中。\n曾从秦望山头见，万里青天踏彩虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56924,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"枯木竹石图","author":"胡奎","text":"三日飓风吹海涛，蓬莱失却黄金鳌。\n长竿钓得珊瑚树，叶叶南唐金错刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56925,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题芍药花下玉兔画","author":"胡奎","text":"老蟾不锁明月宫，飞落西河白兔公。\n玉宇清寒不归去，爱此日高花影重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56926,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题醉翁骑牛图","author":"胡奎","text":"白头野老醉骑牛，笑引儿孙百不忧。\n安得东华尘似海，听鸡人立御桥头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56927,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"紫薇花下","author":"胡奎","text":"天棘移来一尺长，呼儿浇水傍南墙。\n柔条盘作青罗盖，借我山窗一夏凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56928,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽荣教谕 其一","author":"胡奎","text":"江风山月梦悠悠，白发三年在惠州。\n诗骨梅花两清绝，此身只合葬罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56929,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽荣教谕 其二","author":"胡奎","text":"辛卯科名海内传，谈经不到伏生年。\n明珠径寸谁收得，流落天南海水边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56930,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽荣教谕 其三","author":"胡奎","text":"山巾野服鬓丝丝，记得南窗病起时。\n白玉蟾蜍铜雀砚，日长閒写庙堂碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56931,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽荣教谕 其四","author":"胡奎","text":"大庾山高隔暮云，哀猿啼处月纷纷。\n何由化作辽东鹤，一夕飞来祭酒坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56932,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题梅花竹雀图","author":"胡奎","text":"竹外疏花雪半欹，山禽偷眼立多时。\n安知千仞高冈上，鸣凤朝阳有好枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56933,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题寒雀图","author":"胡奎","text":"不向云霄振羽翰，萧条自托一枝安。\n无心更饱秋田粟，任尔黄金作弹丸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56934,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题墨菊","author":"胡奎","text":"别来几度问秋风，今日相看是梦中。\n独守太玄心不改，傲霜高节有谁同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56935,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题瀛洲学士图 其一","author":"胡奎","text":"千年一度见河清，看画令人忆太平。\n不是当年培养力，诸公那得共登瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56936,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苔钱","author":"胡奎","text":"人迹来稀地自偏，閒门无事度年年。\n最怜十日空阶雨，铸得青青万个钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56937,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题毛女","author":"胡奎","text":"槲叶重重护玉肌，莲花峰下采金芝。\n夜凉月出仙人掌，恰似秦宫照镜时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56938,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送友人之亳州","author":"胡奎","text":"雨中饮散杨梅酒，门外水高三尺馀。\n一路看山如画里，到时须寄亳州书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56939,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]