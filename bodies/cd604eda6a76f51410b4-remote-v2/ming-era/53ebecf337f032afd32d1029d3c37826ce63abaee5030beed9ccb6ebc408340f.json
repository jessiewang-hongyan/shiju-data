[{"title":"西岩诗 其三","author":"陆深","text":"我爱西岩好，三台接九天。\n何时飞阁里，东海看桑田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西岩诗 其四","author":"陆深","text":"我爱西岩好，岩中动八荒。\n五丁翻地轴，一矢射天狼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西岩诗 其五","author":"陆深","text":"我爱西岩好，居延出酒泉。\n星流白羽箭，风吼紫金鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西岩诗 其六","author":"陆深","text":"我爱西岩好，川西与浙西。\n林逋湖上兴，杜甫峡中题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西岩诗 其七","author":"陆深","text":"我爱西岩好，他乡说故乡。\n扬州回鹤背，燕国射龙光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛丑归途中绝句五首 其一","author":"陆深","text":"忽忆乘高躅，因知溯急流。\n陶潜初罢令，李广不封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛丑归途中绝句五首 其二","author":"陆深","text":"野旷馀长亩，家严具敌楼。\n旧巢飞燕子，古壁篆蜗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛丑归途中绝句五首 其三","author":"陆深","text":"柳径萦堤曲，柴门逐水开。\n无心论出处，有客赋归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛丑归途中绝句五首 其四","author":"陆深","text":"四十年前路，三千里外心。\n人生几两屐，閒处万黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛丑归途中绝句五首 其五","author":"陆深","text":"畏影常依树，寻盟每问鸥。\n天边孤竹国，云里仲宣楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过宋玉墓","author":"陆深","text":"楚国馀文藻，当春过故邱。\n为君悲不巳，安敢向高秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和蒲汀显陵道中柳阴小憩四首 其一","author":"陆深","text":"花雾濛濛远，山云冉冉高。\n幸陪金紫客，时睹赭黄袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和蒲汀显陵道中柳阴小憩四首 其二","author":"陆深","text":"寝殿祥云合，山陵王气高。\n风光饶帝里，春色满恩袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和蒲汀显陵道中柳阴小憩四首 其三","author":"陆深","text":"路细青山转，天空白日高。\n同来三扈从，碧柳荫朱袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和蒲汀显陵道中柳阴小憩四首 其四","author":"陆深","text":"天子冈头路，风云北斗高。\n穿林回雉扇，度岭耀龙袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和安鸿渐登楼曲","author":"陆深","text":"团圆三五夜，待月上高楼。\n谁知风共雨，又妒一年秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"方春野挽词三首 其一","author":"陆深","text":"春野依然在，春风依旧来。\n去年巢里燕，不见主人回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"方春野挽词三首 其二","author":"陆深","text":"杨子谈玄宅，陶潜漉酒巾。\n一时俱寂寞，愁绝不堪论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"方春野挽词三首 其三","author":"陆深","text":"树绕滕王阁，溪流徐孺祠。\n昔年游赏处，花落雨丝丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书扇寄李百朋","author":"陆深","text":"锦浪生春水，茅亭尽日孤。\n十年身不病，天远共江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏石七首 其一 吕公","author":"陆深","text":"吕公本侠士，诡称回道人。\n黄金亦可变，谁云非法身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏石七首 其二 蓑衣真人","author":"陆深","text":"真人巳忘我，犹著雨蓑衣。\n一朝尽劫尽，风雪不知归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏石七首 其三 麻衣道者","author":"陆深","text":"当年钱若水，寒夜拨炉灰。\n若是公侯骨，定应期不来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏石七首 其四 邋遢仙","author":"陆深","text":"古来神仙侣，均为柱石材。\n得志有廊庙，有时居草莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏石七首 其五 剑石","author":"陆深","text":"葛陂化为龙，八公亦鍊石。\n借身远报雠，凝血今成碧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏石七首 其六 紫云","author":"陆深","text":"积翠竞万壑，孤顽自离群。\n因风欲吹堕，夕阳明夏云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏石七首 其七 紫芝峰","author":"陆深","text":"采芝堪疗饥，煮石亦可餐。\n怅望商山老，浩歌蜀道难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题江海看云卷三首 其一","author":"陆深","text":"南有一片云，因风堕东海。\n弥天作霖雨，望之若可采。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题江海看云卷三首 其二","author":"陆深","text":"海上会看云，飘飘迥不群。\n扶桑红日近，锦绣总成纹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题江海看云卷三首 其三","author":"陆深","text":"我爱看云客，江行复渡江。\n东风一夜雨，梦绕紫荆窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日送客即事","author":"陆深","text":"春阴漠漠昼沉沉，度岭穿林深复深。\n关路望穷人正去，野花开处鸟能吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫兴","author":"陆深","text":"水郭江村不受尘，惟将石竹伴閒身。\n玲珑漏月看云骨，潇洒含风对玉人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登楼","author":"陆深","text":"掉臂归来万里身，倚阑无数物华新。\n细寻往事知多少，我是明年五十人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨窗春兴 其一","author":"陆深","text":"泉石烟霞共此身，总于春雨长精神。\n窗前更有芭蕉树，一夜输心似向人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨窗春兴 其二","author":"陆深","text":"溪山叠叠雪初寒，江水悠悠一钓竿。\n着得羊裘竟何益，蓑衣和月下前滩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚放舟东渡","author":"陆深","text":"扁舟摇荡浦云东，疑有神仙向碧空。\n制得六铢衣试着，新凉浮动一襟风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题陆封君怡梅卷","author":"陆深","text":"我家放鹤坡头树，种近西湖处士居。\n独板桥边山十里，杖藜来探雪晴初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴江长桥奉和邃庵阁老","author":"陆深","text":"长年此地往来过，风景时时付短歌。\n千尺卧龙如未起，水光山色柰愁何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"买得一小舟往来江上题曰水晶宫","author":"陆深","text":"三江西下五湖东，风月烟波四望中。\n我买一舟轻似叶，分明摇动水晶宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"架石","author":"陆深","text":"摽排甲乙位高低，爱杀山翁手自题。\n多少黄金教歌舞，落红空溅雨中泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客至小酌花下","author":"陆深","text":"客到东轩慰病身，嫩凉天气露华新。\n人生有酒花前饮，酒色花枝俱照人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴","author":"陆深","text":"惜春无计为春留，独倚元龙水上楼。\n无数飞花随宿雨，海门东去更东流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题屈处诚雪竹","author":"陆深","text":"萧萧云物满堂寒，屈老风神向笔端。\n带雪琅玕三百个，蒋家径里见袁安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为方思道题画眉折枝","author":"陆深","text":"中山紫翠护层层，合起高楼对雨凭。\n爱汝一双花底鸟，为春啼杀海裳陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张仙斜","author":"陆深","text":"骖鸾归去是何年，覆釜山头有墓田。\n名姓却随丹灶在，县人相对说张颠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重阳后六日登镜光阁五首 其一","author":"陆深","text":"层层楼阁俯京畿，一带清溪白鸟飞。\n直北长城千万堞，江山如此美人稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重阳后六日登镜光阁五首 其二","author":"陆深","text":"天涯秋色倍思家，南雁归来万里沙。\n今是重阳第几日，登高无处问黄花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重阳后六日登镜光阁五首 其三","author":"陆深","text":"曲阑矮几坐晴波，柿子胡桃落叶多。\n为爱城西好风景，相期一日一来过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重阳后六日登镜光阁五首 其四","author":"陆深","text":"并马来寻水西寺，春风忆我惯曾游。\n壁问题字悲欢共，帘下炉烟尽日浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重阳后六日登镜光阁五首 其五","author":"陆深","text":"城外光阴日易斜，城中车马足风沙。\n此时极目登临意，旧有云山几片遮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨百川赴南太常典簿","author":"陆深","text":"南国容台我旧游，淡花疏竹映高秋。\n送君秋日容台去，无限乡心逐水流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄袭锦子","author":"陆深","text":"春风三月满汀洲，来看琼花忆壮游。\n二十年前文墨社，思君不见过杨州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"任城题杨訚直夫泉香书屋二首 其一","author":"陆深","text":"水纹花气斗精神，疑是成都卖卜人。\n传得一区杨子宅，药苗閒洗雨中春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"任城题杨訚直夫泉香书屋二首 其二","author":"陆深","text":"常山人家画不如，君家宛在画中居。\n草堂新开何所有，半贮参苓半贮书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"崇法寺刻竹","author":"陆深","text":"养花天气带微寒，林下轻烟制月团。\n忽过僧寮题竹坐，春醲如酒对琅玕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"马嵬","author":"陆深","text":"秦关山势拂云来，才过骊山又马嵬。\n今日岂知当日事，涧花含笑为谁开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予素不能饮酒昨至成都僚友并劝予蜀烧酒云可祛暑湿也命家童以蜜和之初吸半盏渐至引满复能加一酌极有效自后每晨起便饮饮之辄冲和与年少时苦酒迥异不意老来始知其趣乃尔日饮两三度陶如也家童惊喜谓自饮酒来颜色颇异岂于此将有所得耶笑成一绝","author":"陆深","text":"向来酒盏太无缘，多负风花雪月天。\n今日天公怜老大，放怀加量到西川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"都司红蕉为逸骑所伤","author":"陆深","text":"粉墙高映绿成阴，待看红花雪里深。\n一任摧残付蹄齧，人间何限惜花心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桂州夜宴出青州山查荐名","author":"陆深","text":"南珍卢橘与枇杷，北果红秋带晚霞。\n清润入脾消酒渴，瓷瓯如雪更宜茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张西峰少参以诗促历次韵荅之二首 其一","author":"陆深","text":"几时不见张公子，风调才情正可人。\n颇怪岁寒催短景，为君迟送一年春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张西峰少参以诗促历次韵荅之二首 其二","author":"陆深","text":"秪办送迎酬过客，那知城市有閒人。\n何须凤历看时令，才有花开便是春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病起独坐东堂","author":"陆深","text":"病后光阴迥不同，怯寒嗔热怕当风。\n不知短发缘何事，尽点霜华入镜中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"来青轩和玉溪韵","author":"陆深","text":"磴转峰回年复年，古藤乔木暗流泉。\n西天正在西窗外，一片青青落照前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人往姑苏","author":"陆深","text":"春病春愁拨不开，欲因东海望蓬莱。\n扁舟不得从君去，同上姑苏百尺台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嵇忠穆墓","author":"陆深","text":"满川花柳斗春分，城日初高艳绮云。\n恩怨一空人代换，道旁犹表侍中坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓过咸寨","author":"陆深","text":"壁间黯黯路漫漫，茅舍鸡声夜向阑。\n浮世无端浑似梦，春来客梦更无端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40958,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题西域图","author":"陆深","text":"自从博望通西域，唐代诸豪最盛强。\n今日玉门关外路，不须请组系名王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40959,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自刘元海啸起中原驯致契丹金元之盛防微杜渐令人三叹息于徙戎一论也西北诸边回族尤黠鸷猛嗜欲出于其性此图简远颇得其情状于丹青之外盖锦衣沈君所藏展阅之馀不能无感于近事因书一绝其后云题竹送王秉哲","author":"陆深","text":"平安不用报泥金，春雨龙孙看过林。\n赢得清风满人耳，汗青留秘玉堂深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40960,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题双屿","author":"陆深","text":"水面波心相对开，海门西望妙高台。\n不须更问蓬瀛路，独棹扁舟自往来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40961,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画鹰","author":"陆深","text":"素练秋高草树枯，来从东海势应孤。\n即看一击还千里，更爱凌风不受呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40962,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪后次西峰韵二首 其一","author":"陆深","text":"长安旭日照西峰，照见峰头千尺松。\n龙甲虬枝风鬣动，苍颜翠色露华浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40963,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪后次西峰韵二首 其二","author":"陆深","text":"独上高楼望雪峰，有人卧雪伴长松。\n不知门外停车盖，铁被觚棱睡正浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40964,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题倪云林画寿斋诗转寿唐龙江","author":"陆深","text":"倪郎逸笔寿斋诗，转寿龙江海鹤姿。\n如此山林岁寒节，便?千文鬓成丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40965,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题黄斗塘诗画","author":"陆深","text":"飞鸿雪迹为谁留，笔底青松走翠虬。\n忆得县衙公事散，听风听雨水西头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40966,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送顾生文美游瑞安","author":"陆深","text":"碧峰黄叶酿高秋，满架图书手校雠。\n见说远游南海去，好随龙