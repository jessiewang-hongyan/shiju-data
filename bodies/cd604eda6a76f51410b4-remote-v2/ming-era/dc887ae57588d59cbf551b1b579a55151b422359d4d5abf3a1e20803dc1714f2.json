[{"title":"溪山一览亭为金华邵郎中宗正作","author":"曹义","text":"城下虚亭瞰远空，高凌楼阁近琳宫。\n檐凝岚气涵晴旭，帘捲溪声度晚风。\n林外鸟啼春树绿，吟边人倚夕阳红。\n千山万壑环村郭，都在凭阑一望中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32259,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送金华杜给事中省亲","author":"曹义","text":"江渚西风老白蘋，秋光偏动宦情人。\n黄门列职年华久，清夜思家客梦频。\n御敕赐来恩宠渥，乡关归处锦衣新。\n登堂献罢双亲寿，心旆应悬在紫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32260,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送严寺正归老","author":"曹义","text":"青琐朝辞振佩珂，锦衣归老乐如何。\n传家旧业诗书在，赐诰新恩雨露多。\n棘寺盛名留帝阙，兰挠远棹度官河。\n平生心地清于水，嬴得身闲养太和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32261,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和笪端凯韵送其弟归老","author":"曹义","text":"清时解组鬓毛皤，归去华阳路几何。\n心旆晓悬天阙迥，宦情秋逐莫云多。\n红亭绿酒人初醉，落日青山鸟自歌。\n惆怅都门从此别，瑶阶谁复共鸣珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32262,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人南还","author":"曹义","text":"粉署郎官玉雪清，才华烨烨著能声。\n考成北上朝天阙，得最南还荷宠荣。\n兰棹晴过扬子港，霜鸿寒度石头城。\n公馀遥想多吟兴，好写新诗慰别情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32263,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜读士功纪行诗","author":"曹义","text":"使节归来觐赤墀，朝回示我纪行诗。\n五言冲淡陶彭泽，四韵清新杜拾遗。\n上苑碧梧栖彩凤，瑶空瑞霭映朝曦。\n披馀不觉心神醉，喜动疏狂倒接罹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32264,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送姚经历复任河间","author":"曹义","text":"报政才看到帝乡，还官又见沐恩光。\n卢沟月影随归骑，野店鸡声促晓装。\n佐政共誇才识远，交游争羡姓名香。\n到家想及阳生候，油幕风清日渐长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32265,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送传驿丞复任龙潭","author":"曹义","text":"考成北上觐皇州，得最南还沐宠优。\n晓日都门辞故旧，西风潞渚买归舟。\n雪晴淮浦飞寒雁，云散龙江见驿楼。\n明到寄声攀桂客，春闱行李莫迟留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32266,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送姑苏陆二尹彝赴常山","author":"曹义","text":"岁晚都门雪未消，故人别我去程遥。\n霜威将臈归梅萼，晴色扶春上柳条。\n冻合关河兰棹滞，寒嘶驿路玉骢骄。\n行旌明到三衢日，伫听佳声达九霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32267,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送许芳洲","author":"曹义","text":"送君归老出神州，缓辔东风控紫骝。\n客路云连吴苑树，夕阳人在浙江舟。\n一尊绿酒金台别，三径黄花槜李秋。\n想得到时多雅趣，无边春意在芳洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32268,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘归江阴就寄声严大理本斋先生","author":"曹义","text":"云接家山路几千，一帆归兴夕阳边。\n临岐尊酒从今醉，过雁音书别后传。\n三径到时松菊在，双亲喜处綵衣鲜。\n寄声为报严君道，故旧相思意惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32269,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人归乡","author":"曹义","text":"东吴医擅月坡仙，喜遇闻孙在日边。\n夜雨几番连客榻，春风一旦买归船。\n江云杳杳随离旆，岸草凄凄锁暮烟。\n临别岐亭无以嘱，鹏程万里拟高骞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32270,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘副使棻之福建","author":"曹义","text":"莺花春暖出都城，思入瓯闽几许程。\n官树晓涵晴雨润，江帆晚带夕阳明。\n山材夜静狼豺息，海峤秋深瘴疠清。\n自古诹询资重任，九重伫听达民情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32271,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送廉使张宗政之山西","author":"曹义","text":"春晴紫陌荡香尘，冠盖联翩送故人。\n风度落花沾去旆，马嘶芳草驻征轮。\n旗亭官柳和烟绿，驿路青山带雨新。\n悬想双旌明到日，太行依旧翠嶙峋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32272,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送仰先生之长沙","author":"曹义","text":"十年座拥广文毡，又拜除书下九天。\n岐路一尊燕市酒，春风千里楚江船。\n凤凰山晓霏晴翠，鹦鹉洲寒锁暮烟。\n自是长沙多□子，遗经有待伏生传。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32273,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送大参刘长谦之广东","author":"曹义","text":"染翰多年在凤池，重膺方岳沐恩私。\n晓辞枫陛春深候，明到薇垣夏半时。\n红荔枝垂山寂寂，黄茅瘴静昼迟迟。\n岭南自古民风厚，讼简棠阴好咏诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32274,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送韦道显归省庆远三首 其一","author":"曹义","text":"别却亲庭二十年，白云望断海天边。\n九重此日承优诏，万里长沙放画船。\n春色暖酣红荔雨，莺声晓弄绿杨烟。\n悬知明到称觞处，多少人誇昼锦鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32275,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送韦道显归省庆远三首 其二","author":"曹义","text":"家山迢递信音稀，几叹亲庭定省违。\n紫诰晓从三殿出，锦衣春向百蛮归。\n江津画桨摇烟浪，驿路莺花近翠微。\n自古昼游人共羡，因君归兴欲南飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32276,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送韦道显归省庆远三首 其三","author":"曹义","text":"振旆朝来出帝乡，归宁南去路茫茫。\n云连岭峤蛮烟合，雨过关河野树凉。\n别酒一尊临潞渚，征帆万里向宜阳。\n古人若问交游客，多半相知在玉堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32277,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"椿萱堂为宁波傅光熹赋","author":"曹义","text":"堂北幽萱晚自芳，庭前椿树更苍苍。\n阴联几席班衣润，色浸杯圈寿酒香。\n绿叶晓涵春雨暗，黄花晴度午风凉。\n入窗弘敞承颜处，应是双亲鬓未霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32278,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘御史子深之南京","author":"曹义","text":"蓟门官树带烟微，载酒临岐巳夕晖。\n奏最才朝金阙下，承恩又向石城归。\n尘清紫陌嘶骢马，花落红亭点绣衣。\n关路遥知明到处，豺狼从此迹应稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32279,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送池州太守复任为马友孚友人作","author":"曹义","text":"五马行春得几年，连村桑柘蔼晴烟。\n奏功北觐双龙阙，膺最南回千里船。\n京国交游嗟远别，郡城父老喜重还。\n铨曹著论循良吏，共说池阳太守贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32280,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送何吏部澄公赴金陵","author":"曹义","text":"广阳城外柳阴肥，客向金陵叹别违。\n酒尽红亭官树晚，鸟归青嶂夕阳微。\n驿边山隐谯楼迥，江上云随画鹢飞。\n想得到官公事简，香凝粉署吏人稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32281,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郭指挥之南京","author":"曹义","text":"南归远度济宁城，城下行舟泊晚晴。\n雨过蓬窗凉气袭，风回闸口浪痕平。\n吟看齐鲁山峰迥，梦忆松楸客思清。\n昭代椒房均宠渥，汾阳阀阅独峥嵘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32282,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太守郑公祥与予有相知之雅兹闻讣南还来别惭无以赙匆遽中勉述五十六字送之非诗也聊以识别云","author":"曹义","text":"广阳城下喜逢君，对酒那堪袂又分。\n万里衔哀辞禁阙，一帆归兴逐晴云。\n关河凉雨消炎瘴，驿路寒蝉送夕曛。\n想到故乡秋已晚，蕉黄荔熟奠孤坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32283,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李通判之应天","author":"曹义","text":"明刑蓟北旧廷臣，司牧江南几度春。\n报政薰风趍禁闼，还官晓日出城闉。\n都亭对酒蝉声急，通潞移舟月色新。\n悬想到时多雅趣，钟山吟看翠嶙峋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32284,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人归老江西为于中书霈作","author":"曹义","text":"清时解组雪盈头，归去家山正值秋。\n黄叶西风添逸兴，残蝉疏雨送行舟。\n篱边旧业存松菊，江上新盟狎鹭鸥。\n从此梦回云路远，林泉杖屦纵遨游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32285,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送史太守之应天","author":"曹义","text":"京兆从来属老成，九重今喜荷恩荣。\n薇垣夙布新威令，粉署还闻旧政声。\n青琐辞归驰五马，朱衣行处肃双旌。\n帝乡几许交游者，尽说襟怀似水清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32286,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人之广西为杨给事鼎赋","author":"曹义","text":"都亭载酒送交游，新雁初闻动别愁。\n落日断云横远岫，淡烟疏柳映行舟。\n江关暑退炎尘净，岭峤秋清瘴雾收。\n此去欲知相忆切，梦回残月五更头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32287,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"二白乌","author":"曹义","text":"寿域春融百瑞生，天庭几见白乌呈。\n双瞻玉扆星眸烱，并立雕笼雪羽明。\n月谢归时鸾共宿，琼林啼处凤和鸣。\n总知返哺多慈孝，出应瑶光兆太平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32288,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"迁秋日书怀初不知选法以编脩升主事故戏之","author":"曹义","text":"生来性癖不随圆，富贵穷通总听天。\n一举谬为金榜客，十年滥作玉堂仙。\n考成尽道沾殊渥，列职谁知是左迁。\n几度寻思惭又喜，圣恩如海俸如泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32289,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王行人闻讣归和韵","author":"曹义","text":"秋老都门柳渐疏，故人归去意何如。\n伤心夜雨凋萱草，振旆西风别帝居。\n拜秩喜持新使节，行舟还载旧诗书。\n欲知此后相思意，多在钟残梦觉初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32290,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和高侍讲先生韵五首时宣德七年也 其一","author":"曹义","text":"标格清癯不染尘，碧梧翠竹若为邻。\n凤池载笔年华久，玉署编摩宠命新。\n适兴谩将诗自写，论文肯厌客来频。\n交游满眼谁知己，三益嗟君独辅仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32291,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和高侍讲先生韵五首时宣德七年也 其二","author":"曹义","text":"江南一别绝音尘，蓟北初逢喜接邻。\n晋帖临来多俊逸，唐诗吟处更清新。\n樗材有幸相资益，书籍无嫌独借频。\n昭代共誇膺好爵，愿摅忠悃荅皇仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32292,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和高侍讲先生韵五首时宣德七年也 其三","author":"曹义","text":"玉堂潇洒静无尘，凤阁龙楼为作邻。\n晓听漏声花外度，日闻天语耳边新。\n从容退直多清暇，故旧相过不厌频。\n才识丰姿入共仰，明时匡辅好施仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32293,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和高侍讲先生韵五首时宣德七年也 其四","author":"曹义","text":"幽居陋巷绝氛尘，相接浑无旧日邻。\n宦迹似蓬随处转，流光如水逐时新。\n雁迷故国音书杳，秋到都门客梦频。\n自叹离群材识浅，不知何处可依仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32294,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和高侍讲先生韵五首时宣德七年也 其五","author":"曹义","text":"空庭夜坐迥无尘，月影吟看渐过邻。\n凉透孤怀秋气肃，香飘几点桂花新。\n蛩声哽咽愁难听，砧韵凄清苦厌频。\n触景宦情无处著，谩成诗句荷尧仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32295,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人归老清江为周判府作","author":"曹义","text":"官亭秋老柳依稀，有客投簪阙下归。\n夜月重移通浦棹，春风还采故山薇。\n宦情晓逐寒云散，乡思晴随旅雁飞。\n悬想渝川明到日，高堂依旧舞班衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32296,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黎知州恬之南京","author":"曹义","text":"天香拂袖下云霄，思入金陵客路遥。\n晓日都门倾别酒，西风潞渚发轻桡。\n雁声寒度淮河月，帆影晴悬杨子潮。\n明到想知清乐处，吟看钟阜翠□尧。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32297,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日邻家张宗政绣衣送菊花口号","author":"曹义","text":"几年重九客金台，此日芳邻送菊来。\n绿酒未篘尊寂寞，白衣望断思徘徊。\n囊茱人事随时俗，落帽风流属俊材。\n默坐政惭孤令节，黄花一见笑颜开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32298,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈孟仁还姑苏翰林五经博士先生之子也","author":"曹义","text":"蓟门暂脱老莱衣，望入吴山烟树微。\n天外不愁归路远，客边未忍与亲违。\n风清古道嘶征马，酒劝长亭对夕晖。\n聚散有期君自卜，几时还复到京畿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32299,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同寿堂为良医许景芳作","author":"曹义","text":"一门种德百年深，同寿堂前杏满林。\n花雾煖凝丹鼎润，药栏春锁碧窗阴。\n披云采术常携鹤，近市悬壶不计金。\n遥想嘉禾沾惠者，几多人共戴华簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32300,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浦江书舍为挥使题","author":"曹义","text":"君家书屋浦江头，架上牙签过邺侯。\n绮户晓凝钟阜翠，湘帘暮捲石城秋。\n酣馀欹枕惊波浪，吟罢凭阑看鹭鸥。\n谁道将军惟好武，客来长日共赓酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32301,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李给事中应庚","author":"曹义","text":"东风紫陌净香尘，握手都门送故人。\n共羡黄门簪笔久，涣颁紫诰沐恩新。\n清尊暮对沙头酒，画鹢晴飞江上春。\n想到家山供祭日，九原松柏倍精神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32302,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"善继堂为周公弼作","author":"曹义","text":"闻说濂溪孙子贤，家风独守一青毡。\n翠深窗外当时草，红绽池边旧日莲。\n教子不忘庭下训，躬耕肯废垄头田。\n轩居善继题华扁，嗣世箕裘几百年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32303,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄王思孟","author":"曹义","text":"旅食滇南四十年，归来依旧乐林泉。\n塔塘柳荫看鱼跃，花坞云晴伴鹤眠。\n客到旋篘黄菊酒，醉来高咏紫芝篇。\n物情世态俱忘却，好似华阳洞里仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32304,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"聚星楼为陈循理作","author":"曹义","text":"楼倚春风绿树边，高凌霄汉白云连。\n窗开晴度三茅翠，帘捲寒凝九曲烟。\n暇日清谈来俊彦，瑶天瑞采应奎躔。\n太丘芳誉昭青史，千载闻孙忆颖川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32305,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈嗣初博士先生归乡","author":"曹义","text":"玉署编摩雪满颠，九重优诏许归田。\n半挑行李吴江兴，十幅征帆潞水船。\n官路暝烟迷远树，西风落日噪残蝉。\n到家莫忘金台客，鸿雁来时寄锦笺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32306,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送医士归田","author":"曹义","text":"京国悬壶岁月深，宋清名誉重当今。\n方传肘后多奇术，药济孤贫不论金。\n年去秋霜添白发，赐归客路抱瑶琴。\n应知旧业荆溪上，芝满蓝田杏满林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32307,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送宿州太守王永隆增秩复任为民告留","author":"曹义","text":"考成诏许复南行，深慰编氓借寇情。\n凤阙辞时宫漏彻，马蹄归处晓寒轻。\n青衫虽换绯袍贵，襟度还同玉雪清。\n遥想耄倪欢有待，拥途争迓旧前旌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32308,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松庵","author":"曹义","text":"屋头老干耸亭亭，雪压霜欺倍见青。\n怒吼涛声惊鹤梦，乱横月影动龙形。\n髯凝黛色侵书幌，花褪晴香落砚屏。\n欲向灵根探琥珀，徂徕路远隔沧溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32309,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈节妇魏氏子珏回句曲","author":"曹义","text":"慈母孀居两鬓皤，褒封今喜沐恩波。\n麟儿趍谢来京国，凤阙朝回出潞河。\n归兴晓随春涨迥，征帆晴带夕阳多。\n高堂明到承颜处，贺客应知远近过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32310,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送严教谕素之乌程 其一","author":"曹义","text":"鹿鸣曾共宴华筵，屈指于今二十年。\n伏擽总怜淹骥足，剸犀宁肯负龙泉。\n九重拜命膺殊渥，千里分携棹画船。\n悬想苕溪明到日，遗经有待伏生传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32311,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送严教谕素之乌程 其二","author":"曹义","text":"玉雪才华英妙年，春风得意讶登仙。\n一官泮水初分教，万里云程始著鞭。\n山落晴阴凝绛帐，芹飘香雨湿青毡。\n从来师道多珍重，好振文风继郑虔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32312,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蒋仕昂主事","author":"曹义","text":"粉署为郎玉雪清，凤池染翰旧驰名。\n奏功北上朝天阙，得最南还荷宠荣。\n凉雨半篷淮海梦，青山数点蓟门情。\n到时莫忘朋侪好，鸿雁来时蚤寄声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32313,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽云间沈御史父","author":"曹义","text":"八帙年高两鬓霜，仙游一去路茫茫。\n淞江月冷猿声切，辽海云深鹤梦长。\n篱下独存松菊老，人间空有姓名香。\n乌台独喜贤郎贵，泉壤还看贲宠光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32314,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邢中书兄弟归荥阳","author":"曹义","text":"御河杨柳绿依依，送别都亭曙色微。\n鸿雁沙头怜独去，鹡鸰原上叹分飞。\n几程客路云边去，三月莺花阙下归。\n想得荥阳明到日，紫荆花底醉春晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32315,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽吏部洪主事","author":"曹义","text":"漠漠愁云结暮阴，清霄惊见少微沉。\n徵书无复来闽峤，德望空嗟蔼士林。\n瘴海月明孤鹤怨，鳌峰霜冷断猿吟。\n贤郎与我同年客，执绋无由思不禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32316,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵郎中致仕","author":"曹义","text":"两京争羡旧儒臣，致仕南归宠命新。\n白发萧萧辞玉阙，锦衣烁烁炫晴春。\n桂林路指关河迥，枫陛恩深客梦频。\n想得到家多有忆，鹓行肯忘故交人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32317,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送许文勉","author":"曹义","text":"桥门捧檄上金銮，三策敷陈说治安。\n素志不忘莱子服，丹心要著侍臣冠。\n离亭杨柳迎秋脆，别渚芙蓉带露寒。\n归去鹏程应有待，春风霄汉任飞抟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32318,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送二尹徐仲朴赴武昌","author":"曹义","text":"几年不见老徐卿，京国相逢慰客情。\n枫陛奏功偏得最，花封抚字独驰名。\n一尊凉雨都门酒，千里征帆汉水程。\n遥想武昌诸父老，沙头几度候归旌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32319,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王给事中贤归山东","author":"曹义","text":"几年簪笔侍彤闱，此日承恩衣锦归。\n北阙辞时清漏彻，东蒙望处白云飞。\n秋晴驿路砧声远，露冷关河树影稀。\n悬想焚黄先垄日，森森宰木倍生辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32320,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]