t":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23968,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"齐宫怨","author":"徐熥","text":"遥见潘妃绰约来，六宫红粉一时回。\n隔花听得君王笑，知是金莲步步开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23969,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"隋宫怨","author":"徐熥","text":"江南江北翠旂遥，夜夜深宫锁寂寥。\n何处龙舟试歌舞，秦淮明月广陵潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23970,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"唐宫怨","author":"徐熥","text":"一曲霓裳舞未休，月光如水上帘钩。\n梦回忽听笙歌沸，犹是华清夜打毬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23971,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下邳阻风","author":"徐熥","text":"边风飒飒捲黄沙，白浪连天涌作花。\n野店无人门尽闭，夕阳衰柳带寒鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23972,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"彭城元夕怀故园诸友","author":"徐熥","text":"故国春宵正可怜，九衢灯火吐春烟。\n旧游已共晨星散，月色遥知似去年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23973,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"马上姬 其一","author":"徐熥","text":"红粉青娥白苧衣，一鞭柳外踏青归。\n中裙妒杀桃花马，九陌香尘扑面飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"马上姬 其二","author":"徐熥","text":"窈窕佳人跨绣鞍，香风吹动绿云鬟。\n最怜二月长堤柳，一路青青送玉颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别刘少已冯希吕","author":"徐熥","text":"都门慷慨别同驩，剑气冲霄马上看。\n一自荆卿歌变徵，萧萧易水至今寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鄚城感旧","author":"徐熥","text":"匹马还家春正深，路傍杨柳尽成阴。\n当垆少女今何处，门锁寒烟不可寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"进香词","author":"徐熥","text":"貌似桃花鬓似云，销金抹额石榴裙。\n一派管弦齐上马，手持香瓣礼元君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜","author":"徐熥","text":"莺花三月出燕关，千里家乡几日还。\n今夜月明天似水，梦魂先到武夷山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23979,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀平夫","author":"徐熥","text":"雪花飞尽柳花飞，目断南天雁影稀。\n月落屋梁人不见，空馀清梦绕渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23980,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"剑浦怀宗思兼先生","author":"徐熥","text":"剑气冲霄水乱流，故人曾共木兰舟。\n年来老病如宗炳，画里青山卧里游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过陈山人隐居","author":"徐熥","text":"茆斋斜瞰武陵溪，万树桃花两岸齐。\n閒倚杖藜看乳燕，薜萝衣上落香泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词 其一","author":"徐熥","text":"美人门对钱塘江，水透苏堤月透窗。\n莫怨裴航仙梦晚，种来玉杵未成双。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23983,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词 其二","author":"徐熥","text":"妾住西湖旧狭邪，孤山深处是郎家。\n郎若重来须细认，湖边新种碧桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23984,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词 其三","author":"徐熥","text":"杨柳堤边去采莲，柳枝低拂采莲船。\n分付儿童休浪折，留待郎来作马鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23985,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词 其四","author":"徐熥","text":"忽听楼头鼓乱敲，模糊月色上花梢。\n郎今去住无消息，暗掷金钱卜一爻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23986,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]