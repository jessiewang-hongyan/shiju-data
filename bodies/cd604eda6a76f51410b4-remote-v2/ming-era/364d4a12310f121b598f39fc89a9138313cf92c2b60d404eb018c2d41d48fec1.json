ommit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"红叶怨","author":"徐熥","text":"红叶诗成暗自愁，御沟泉咽不堪流。\n愿将一掬相思泪，添得潺湲出御沟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"薛涛坟","author":"徐熥","text":"玉垒山高锦水流，黄泉何处觅青楼。\n坟头种得桃千树，花落花开怨未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"温泉宫","author":"徐熥","text":"羯鼓声中酒未醒，华清浴罢转娉婷。\n可怜万古温泉水，难洗渔阳战血腥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"马嵬驿","author":"徐熥","text":"蛾眉宛转倍堪怜，永别君恩赴九泉。\n千载马嵬山下路，伤心最是佛堂前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词","author":"徐熥","text":"忽听昭阳歌吹声，倚栏无语不胜情。\n青青长信宫前草，尽是銮舆去后生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古意","author":"徐熥","text":"郎自伤心妾断肠，梦中逢妾妾逢郎。\n一声砧杵一声恨，别意长如秋夜长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23949,"sha256":"e