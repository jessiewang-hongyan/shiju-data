[{"title":"淮阴夜泊","author":"徐熥","text":"淮阴城下暂停舟，明月无情水自流。\n汉代王孙今不见，惟馀春草满汀洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客中赠别","author":"徐熥","text":"吴姬把酒唱离歌，一片愁心奈别何。\n莫怪相看频下泪，江南春色已无多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"武林与子卿宿别","author":"徐熥","text":"渺渺疏钟月下闻，天涯相见复离群。\n秋风一夜孤帆远，遥隔吴山几片云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丹阳遇陈十八","author":"徐熥","text":"丹阳渡口遇同乡，欲语匆匆怨夕阳。\n君返江南我江北，云山千叠断人肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人游秣陵","author":"徐熥","text":"送君西去秣陵游，万里寒江日夜流。\n酒散离亭人已远，乱山残雪一孤舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感旧","author":"徐熥","text":"一别心知万里遥，孤灯空对可怜宵。\n因思十五年前事，月色箫声共寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东原别歌者周郎","author":"徐熥","text":"缥缈尊前一曲歌，相逢其奈别离何。\n数声残角霜天晓，马首无情幽怨多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过黄逸人幽居","author":"徐熥","text":"行到山中日已昏，一声寒犬出孤村。\n青苔满地无人迹，风落残花闭洞门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灵岩庵怀珠上人 其一","author":"徐熥","text":"踏遍烟霞万壑深，洞门空锁薜萝阴。\n一从瓢笠过南海，十载游踪无处寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灵岩庵怀珠上人 其二","author":"徐熥","text":"曾同老衲共安禅，回首春风已十年。\n此日重经香火地，佛灯无燄灶无烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客中送人之粤西","author":"徐熥","text":"客路相逢各断肠，明朝身在瘴云乡。\n荒原野店无人住，古木萧萧空夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"军城早秋","author":"徐熥","text":"落日荒城起暮笳，萧条秋色满黄沙。\n一声塞雁西风里，十万征人尽忆家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵怀古","author":"徐熥","text":"一自东南王气消，秣陵秋色冷萧萧。\n如今宫殿生禾黍，无复繁华似六朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访羽人不遇","author":"徐熥","text":"千峰万壑羽人家，钟磬无声日已斜。\n闭却洞门春寂寂，晚风吹落紫藤花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湖上晚望","author":"徐熥","text":"半天夜月漏初稀，渺渺澄波浸翠微。\n一道香风何处起，隔溪游女采莲归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜闻笛","author":"徐熥","text":"残月微微玉漏深，一声长笛起秋阴。\n天涯多少怀归客，独对西风思不禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东庄晚眺","author":"徐熥","text":"旧游风景易蹉跎，古路松阴翳薜萝。\n樵唱尽归门巷寂，萧萧残柳夕阳多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠少年","author":"徐熥","text":"天涯相见正新秋，满目西风共倚楼。\n月下按筝歌一曲，声声都作小凉州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫怨 其一","author":"徐熥","text":"金锁重封院宇深，銮舆消息总沉沉。\n君王何处看歌舞，负却长门夜夜心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫怨 其二","author":"徐熥","text":"遥闻玉辇过昭阳，歌吹声中欲断肠。\n一闭深宫经十载，梦魂无自识君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬日到山家","author":"徐熥","text":"十里青山古木平，半溪残雪夕阳明。\n小桥流水门深闭，但听云中鸡犬声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人贬崖州","author":"徐熥","text":"瘴雨蛮烟道路长，怜君何事此投荒。\n他时纵有相思梦，万里风波正渺茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酒家赠别","author":"徐熥","text":"十载分携无定踪，谁知此日酒家逢。\n五更酒醒东西去，又隔云山千万重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"交河道中","author":"徐熥","text":"萧条残柳不胜秋，满目山川对戍楼。\n今日独经征战地，黄沙漠漠使人愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汉宫春晓词 其二","author":"徐熥","text":"枕上频闻女伴催，任教初日上妆台。\n玉肌应共东风软，正梦昭阳侍寝来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汉宫春晓词 其三","author":"徐熥","text":"宿雾霏微御柳青，水晶帘捲见残星。\n传言禁漏声休促，昨夜君王酒未醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汉宫春晓词 其四","author":"徐熥","text":"莺声睍睆出花枝，肠断流苏梦觉时。\n一派管弦何处起，遥知别院拜昭仪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送老僧","author":"徐熥","text":"行尽天涯与海涯，閒云孤鹤伴袈裟。\n归看手种门前树，开遍春风几度花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"二月晦日送人之安南 其一","author":"徐熥","text":"杜宇声中夕照斜，长途征马踏残花。\n春光今日归何处，莫是随君到海涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"二月晦日送人之安南 其二","author":"徐熥","text":"驱车万里向蛮天，人去春归总可怜。\n同是别离君更速，君行犹在晓钟前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒食郊行伤少文","author":"徐熥","text":"春风羸马出郊坰，忽忆心知涕泪零。\n最是无情坟上草，年年寒食自青青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人出塞","author":"徐熥","text":"黄尘漠漠暗征衣，杨柳青青折渐