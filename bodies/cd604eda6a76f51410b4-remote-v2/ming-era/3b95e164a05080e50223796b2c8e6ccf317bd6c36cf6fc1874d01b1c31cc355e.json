[{"title":"渊明归庄图","author":"黎贞","text":"宋室方兴日，先生归去时。\n柴门五株柳，风动绿丝丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48991,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏挥使龙虎图二首 其一","author":"黎贞","text":"文明见在田，崭岩养头角。\n兴云飞上天，普济苍生乐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48992,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏挥使龙虎图二首 其二","author":"黎贞","text":"倚树一啸风，百兽俱踉跄。\n苟无如是威，何以镇边疆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48993,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"茅屋清隐图二首 其一","author":"黎贞","text":"流水河溪几曲，斜阳古树三丫。\n养浩嚣嚣佳景，茅亭清隐诗家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48994,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"茅屋清隐图二首 其二","author":"黎贞","text":"绿树低连老屋，断桥斜蘸清波。\n恍惚杜陵韦曲，几时载酒相过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48995,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送戴大使","author":"黎贞","text":"官满南州海表，风清北上京华。\n人在江门分袂，客从庾岭还家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48996,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风雨老嫩竹为邑宰黄昭题四首 其一","author":"黎贞","text":"篁篥溪边夜泊，萧萧乱耳清音。\n堪慨子猷归去，使君谁与同心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48997,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风雨老嫩竹为邑宰黄昭题四首 其二","author":"黎贞","text":"花落黄陵庙里，独见万个琅玕。\n风雨连阴三月，歌残白苧犹寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48998,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风雨老嫩竹为邑宰黄昭题四首 其三","author":"黎贞","text":"老节谁与君守，贞心孰与君同。\n桃李春风过眼，岁寒只有梅松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48999,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风雨老嫩竹为邑宰黄昭题四首 其四","author":"黎贞","text":"稚子锦绷才解，初篁碧玉成丛。\n堪笑渭川太守，扶疏千亩胸中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49000,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李生麟会试","author":"黎贞","text":"圣朝养士重贤才，白首惟予说草莱。\n他日归来如访问，芦花明月钓鱼台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49001,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辞冈泮教职呈潮宗汪先生","author":"黎贞","text":"生平牢落一儒衣，虚誉应惭长者知。\n主掌人文何事业，重烦青眼顾衰迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49002,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观猎西苑呈西庵孙先生","author":"黎贞","text":"属车先报猎前山，云拥旌旗万马屯。\n独有相如能进谏，声华不愧汉衣冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49003,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从西庵孙先生出使高丽","author":"黎贞","text":"远逐星轺出海门，扶桑东望尚漫漫。\n不游八极无垠外，那识乾坤只恁宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49004,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柬琼南王仲迪","author":"黎贞","text":"欲奏南薰嘉树阴，堪舆无坱少知音。\n金兰只有南天士，鸿雁不来岁月深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49005,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谭节妇丫髻潭","author":"黎贞","text":"铁石肝肠死即休，窦家姊妹可为俦。\n知心惟有潭中水，万古清清只自流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49006,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢释道明惠猫","author":"黎贞","text":"插架牙签怨武儿，偶从萧寺得萧妃。\n于今已忏玄华业，弗记当年骨醉时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49007,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访陈原道","author":"黎贞","text":"良金山下忆重游，松桂森森曲径幽。\n歌彻采箫人未遇，一声猿鹤碧天秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49008,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺词八首 其一","author":"黎贞","text":"愁心都不管年华，每到春来恨转赊。\n绿柳成阴花结子，玉人天外未还家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49009,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺词八首 其二","author":"黎贞","text":"几度悲秋懒下堂，翠翘金凤为谁忘。\n重门尽日无人迹，只有阶前草自芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49010,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺词八首 其三","author":"黎贞","text":"书说还家不到家，门前修竹绿交加。\n竹枝亦似离人泪，夜夜无风滴露华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49011,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺词八首 其四","author":"黎贞","text":"昼长无赖倚窗儿，门外秋深色渐稀。\n邻妇不知人世苦，亦怜秋老叹愆期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49012,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺词八首 其五","author":"黎贞","text":"满庭桃李斗春华，戏蝶游蜂度午花。\n只见双双来又去，可怜人世似抟沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49013,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺词八首 其六","author":"黎贞","text":"西风吹雁落平沙，芦苇秋黄稻始花。\n转眼不时秋又到，只愁边地早霜华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49014,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺词八首 其七","author":"黎贞","text":"别来颜色已非前，懒向妆台整翠钿。\n愁绝不禁秋夜永，自攲寒枕听更眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49015,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺词八首 其八","author":"黎贞","text":"闻君鞍马踏秋回，吹老西风尚未来。\n夜雨孤灯羁客枕，不知谁荐洗愁杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49016,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送春","author":"黎贞","text":"春来江岸雨霏霏，春去园林绿未稀。\n春去春来成底事，东风原自不曾知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49017,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"应徵北上道经清溪驿","author":"黎贞","text":"蒲帆破晓到清溪，溪上人家曙色迷。\n独有幽禽知我意，野花丛里尽情啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49018,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金川谩书","author":"黎贞","text":"凤凰山下雪初消，衰草寒烟共寂寥。\n何处玉人楼独倚，月明深夜听吹箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49019,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过丁家桥见梅","author":"黎贞","text":"与君疏懒十年情，梦入罗浮路几程。\n今日客途重相见，岁寒风味一般清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49020,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归宗寺经羲之洗砚池","author":"黎贞","text":"藜杖轻轻白苧衣，金轮峰上立斜晖。\n行从洗砚池边过，带得馀光满袖归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49021,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至南华寺观衣钵锡杖双履六祖金锁骨金阑袈裟贝叶经等物暮泊溪口","author":"黎贞","text":"闲随飞锡访招提，直蹑云根足不迷。\n花雨弄晴天欲曙，满船明月出曹溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49022,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赣州访江东庙二首 其一","author":"黎贞","text":"紫翠重重一径开，虎头城外访天台。\n五仙排闼呈休徵，怕有仙人骑鹤来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49023,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赣州访江东庙二首 其二","author":"黎贞","text":"路入仙源万绿堆，重重楼阁倚山开。\n神仙与我如相约，报道仙槎八月回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49024,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟次储潭庙","author":"黎贞","text":"十八滩前古庙头，金飙荐爽正飕飕。\n洞门云散暮天阔，千里月明山更幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49025,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访山家还遇雪","author":"黎贞","text":"披云冲雨访山家，独立匡庐领物华。\n风雪漫天归路晚，一襟清气似梅花。\n游醉石观渊明归庄，每醉卧此石，因名之。\n靖节先生归去来，好怀长向此中开。\n文采风流今已矣，还留醉石伴苍苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49026,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿太平观","author":"黎贞","text":"直入仙源路已荒，四山松竹郁苍苍。\n断碑遗迹烟霞老，犹带开元雨露香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49027,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大旷湖闻瀑布","author":"黎贞","text":"半天风雨泻云屏，笑卧芦花被底清。\n岂有文章追永叔，倚篷深夜听秋声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49028,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒三闾祠二首 其一","author":"黎贞","text":"几家茅屋楚江皋，遗庙丹青俯碧涛。\n惆怅独醒人已远，空馀哀怨寄离骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49029,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒三闾祠二首 其二","author":"黎贞","text":"春日潜行楚水隅，浩歌弹铗访三闾。\n客怀落落知多少，欲拟先生问卜居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49030,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒赵文节公祠","author":"黎贞","text":"妇节夫忠古所难，使君此举义全安。\n高风不独传千古，解使声名动伯颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49031,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"到扬州","author":"黎贞","text":"落日江都半是霞，野人犹说帝王家。\n长堤一道青如染，还有垂杨集暮鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49032,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"铜陵县访谪仙读书台","author":"黎贞","text":"太白骑鲸天上游，空馀台榭倚山丘。\n开元风月诗千首，万丈豪光射斗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49033,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访李谪仙所登蛾眉亭","author":"黎贞","text":"牛渚江边泊彩舟，蛾眉亭上耸吟眸。\n眼前风景俱奇绝，李白题诗在上头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49034,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"思家二首 其一","author":"黎贞","text":"孤村一曲抱清江，别后长怀父母邦。\n南北相看天万里，梦魂长绕读书窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49035,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"思家二首 其二","author":"黎贞","text":"紫水桥东是我家，别来三载量无他。\n高槐细柳参差绿，三径犹存晚节花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49036,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戍妇词二首 其一","author":"黎贞","text":"坐看星斗落秋霄，岂有神官役鹊桥。\n一带银河中隔断，女牛空见夜迢迢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49037,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戍妇词二首 其二","author":"黎贞","text":"欲扫鸾笺寄彩云，敢将心事怨夫君。\n蜀山花竹湘潭水，望帝春声独不闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49038,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从戎别母","author":"黎贞","text":"拜别慈颜强荷戈，肃将君命敢蹉跎。\n倚门莫念边城事，圣代于今雨露多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49039,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"胥江驿柬乡中亲友","author":"黎贞","text":"自从分袂各西东，一路云山紫翠重。\n回首亲庭应未远，白云飞处是圭峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49040,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿药塘村","author":"黎贞","text":"绿树柴门一抹村，鹧鸪啼处又黄昏。\n落花流水皆离思，行客凄然欲断魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49041,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿镇阳峡","author":"黎贞","text":"镇阳峡里逢端午，万叠云山酒一壶。\n莫笑客怀常寂寞，拢船烧笋当菖蒲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49042,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浈阳峡歌二首 其一","author":"黎贞","text":"平生见说浈阳峡，今日亲从峡里游。\n滩声嘈嘈水流急，今古行人尽白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49043,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浈阳峡歌二首 其二","author":"黎贞","text":"一路好山图画开，舴艋飞入云霞堆。\n女郎唱歌齐拍手，道是阿侬天上来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49044,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"英德县","author":"黎贞","text":"英德县前江水流，绿杨阴下系行舟。\n开篷沽酒动长啸，洗尽万斛之穷愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49045,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泊五侯书所见","author":"黎贞","text":"溪头昨夜水没矶，细雨漠漠暗斜晖。\n丫环三五隔溪女，唱歌撩乱摸鱼归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49046,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"濛里驿","author":"黎贞","text":"濛里维舟日已西，不堪幽思正凄凄。\n长松夹道青如染，更有子规深夜啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49047,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕","author":"黎贞","text":"蒋陵山下泊行舟，客里惊逢七夕秋。\n银汉纵横凉似水，倚篷深夜看牵牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49048,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿定公港二首 其一","author":"黎贞","text":"四月江南烟树浓，吴山楚水寄行踪。\n南风吹起鲥鱼美，到处山林啼郭公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49049,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿定公港二首 其二","author":"黎贞","text":"风雨潇潇芦荻秋，人家多住碧溪头。\n流萤万点光如烛，不照行人一段愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49050,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至淮安弥旬抱病","author":"黎贞","text":"满目阴云暗未开，秋风抱病强登台。\n淮阴漂母无寻处，谁识王孙济世才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49051,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望山海访孟姜女望夫台遗址","author":"黎贞","text":"长城遗迹已尘埃，犹说秦人此地开。\n姜女茫茫千载后，海边还有望夫台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49052,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄澄渊张州判","author":"黎贞","text":"自向浑河问濯缨，闲云野鹤共幽盟。\n因风寄语洪都客，何日扁舟访子陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49053,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辽阳赠使者南还","author":"黎贞","text":"辽阳三月朔风高，使者南归衣锦袍。\n持节直从三岛过，紫云深处宴蟠桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49054,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿蓟门","author":"黎贞","text":"胡烟漠漠昼云垂，万里边台客到稀。\n直上筹边楼上望，蓟门秋雨湿旌旗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49055,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄诸弟二首 其一","author":"黎贞","text":"几年书剑笑从军，多少征鸿入塞云。\n惟有故园音信杳，别来时复念离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49056,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄诸弟二首 其二","author":"黎贞","text":"自怜汩没在天涯，几度春风阅岁华。\n最念田真苦相失，月明空对紫荆花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49057,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆幼子","author":"黎贞","text":"别后寒梅几度开，前时骥子尚婴孩。\n愿言他日相逢处，莫问客从何处来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49058,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜得家书","author":"黎贞","text":"少年意气欲横秋，此日闲看东逝流。\n道路干戈怜阻绝，封书还慰客边愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49059,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄家","author":"黎贞","text":"蓟云朔雪映征衣，夜夜故园入梦思。\n书剑飘零浑未定，今年犹见雁南飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49060,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"绝句五首 其一","author":"黎贞","text":"宝篆香消梦乍回，好怀聊为晚凉开。\n珠帘半捲春如海，无数青山入座来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49061,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"绝句五首 其二","author":"黎贞","text":"谁怜客里病厌厌，自觉乡思日日添。\n从此无心爱良夜，任教花影过疏帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49062,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"绝句五首 其三","author":"黎贞","text":"十二朱楼多丽人，红颜绿鬓颊生春。\n閒情不惹巫山梦，明月清风作两邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49063,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"绝句五首 其四","author":"黎贞","text":"椆柳河边夜雨过，诗怀偏少客怀多。\n东邻轻薄诸年少，争唱高阳出塞歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49064,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"绝句五首 其五","author":"黎贞","text":"朔雪霏霏拥被眠，柳营偏近戍楼边。\n石床惊觉还家梦，梅角一声霜满天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49065,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登台二首 其一","author":"黎贞","text":"几回送目上层台，强把幽怀借酒开。\n归路茫茫杳南北，晚烟连树接蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49066,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登台二首 其二","author":"黎贞","text":"谩学纵横季子游，弊裘落落笑羁留。\n客怀何处堪消遣，时上筹边第一楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49067,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"对镜","author":"黎贞","text":"潇潇朔雪洒征衫，身在辽阳忆岭南。\n青镜频看悲素发，秋风浑欲不胜簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49068,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨妃菊为朱阃帅题","author":"黎贞","text":"一自嵬坡别驾时，英魂飞上傲霜枝。\n于今冷落东篱下，肠断君王知不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49069,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]