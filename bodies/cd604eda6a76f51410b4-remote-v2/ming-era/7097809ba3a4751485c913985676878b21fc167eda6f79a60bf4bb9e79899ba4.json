[{"title":"梅花百咏 其二十八 动直","author":"李江","text":"谁把冰壶挂玉枝，倚天吹笛夜云时。\n看来有景堪同赏，听到无声只自知。\n万物两间皆定体，三阳一气本无私。\n主人长挹春风坐，谁肯令人问是谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其二十九 涵养","author":"李江","text":"影摇花落寂无声，月下徐徐步履轻。\n一枕芸窗何处梦，百年山馆此时情。\n萧疏偃蹇丰姿老，冷淡斜横韵格清。\n独伴幽人坐东阁，黄昏晓影两分明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其三十 优游","author":"李江","text":"浅色深容淡欲流，山光水色玉壶秋。\n人来人往路千里，我弄我吟帘半钩。\n香逐月魂游阆苑，春随风片落罗浮。\n无中此影须寻有，溅齿留酸更点头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其三十一 全体呈露","author":"李江","text":"白玉堂前雨乍晴，分明雪外见云英。\n淡中有味却忘倦，画里虽灵无此情。\n草阁玲珑嫌俗眼，纱窗幽静了平生。\n天花落处轻无比，较却梅花落更轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其三十二 妙用显行","author":"李江","text":"一幅飞琼水不流，湛然神气与天游。\n影浮缥缈三更月，色点清虚五夜秋。\n绿鬓佳人羞见老，雅情处士喜寻幽。\n含章不括坤囊解，多少年光在后头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54958,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其三十三 精粹","author":"李江","text":"月光如水雪肌轻，冷蕊疏枝瘦影清。\n可是仙灵非俗态，须知本色自天成。\n性田湛若三千界，心境昭然二五精。\n不必孤山寻个路，阶前一路最分明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54959,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其三十四 温润","author":"李江","text":"玉容真个是神仙，淡扫春妆俗不缘。\n花落酒醒人寂寂，庭深夜静月娟娟。\n寒生冰簟浮秋水，露湿银床滴玉泉。\n自觉一身是区宇，春来无处不完全。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54960,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其三十五 丽","author":"李江","text":"玉骨冰肌洁且严，春风半面出珠帘。\n疏枝照水清无比，大袖倚栏看不厌。\n虢国夫人嫌粉涴，寿阳公主喜妆添。\n个中若问何如景，洞里山高月色尖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54961,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其三十六 觉","author":"李江","text":"精神机慧捷如何，觉破丰情无舛讹。\n夜冷嫦娥眠不着，山寒处士兴犹多。\n喜看浅水黄昏月，笑杀海棠春梦婆。\n争看天花忽飞起，满天撩乱落银河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54962,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其三十七 定性","author":"李江","text":"钟于阳德老蓬壶，九九消寒恰写图。\n天地有形机轴巧，风埃无路梦魂俱。\n妙中信若三神绝，虚处茫然万虑除。\n我恨程门今不及，百年霜雪独清癯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54963,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其三十八 盛容","author":"李江","text":"漫调新粉采新枝，争奈英华太露时。\n美色宋朝谁不悦，盛容夫子孰能知。\n堂前月小朱门闭，山外风高玉笛吹。\n自是天然非整顿，眼中琼树梦方痴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54964,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其三十九 涣然心释","author":"李江","text":"睡觉东窗半启扉，虚襟纸帐思依依。\n十分把鼻无人会，一到沈吟觉梦非。\n满院玉飞风不起，疏帘珠落月交辉。\n常将底事心头战，今战胜来癯正肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54965,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其四十 凛然不犯","author":"李江","text":"万叶娇娆舞乱风，孤飘瘦影与谁同。\n重阴冱处孤根老，大节临时万□空。\n雪态浓妆皆正色，缺枝斜插独高峰。\n一生爱学扬州咏，只恐阴何体未工。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54966,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其四十一 理得于心","author":"李江","text":"冷蕊疏枝傍水滨，一年相见一年新。\n酒于半醉还添量，诗不求工自有神。\n资始资生筋骨老，诚源诚立性情真。\n满腔子里原无物，充塞看来都是春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54967,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其四十二 情见乎辞","author":"李江","text":"曾是神仙着手栽，孤根原自雪中来。\n天寒地冻眼前见，万卉群芳头上开。\n淡影萧疏笼碧海，弱枝清洁傍琼台。\n乾坤本是一虚毂，相见年年共酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54968,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其四十三 怀古","author":"李江","text":"月洗冰壶一镜清，分明照见老先生。\n故人只有林和靖，知己非无宋广平。\n冷落南塘嫌俗态，凄凉东阁动诗情。\n未拈一字骚经上，千载相看作目成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54969,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其四十四 慨古","author":"李江","text":"瘦老枯容世绝交，岁寒松竹总英髦。\n竹荣卫武千年久，松感宣尼一字褒。\n茆舍竹篱还酒兴，暗香疏影共诗豪。\n根荄不是江南橘，长短何须比杏桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54970,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其四十五 雅","author":"李江","text":"嫩蕊含英雪未乾，教人几度独凭栏。\n堂前小坐山应远，门外长看路尽宽。\n佳丽生香拈粉地，铅华洗玉浥蒲团。\n寻常自有非常意，淡处无厌静处观。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54971,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其四十六 独","author":"李江","text":"漫倚东风玩物华，幽凄只独爱梅花。\n多情野兴凭谁遣，冷笑悭囊问酒赊。\n月白空中皆我境，风光篱外是谁家。\n罗浮有路直如笔，枉杀阶前人认差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54972,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其四十七 存心修德","author":"李江","text":"养梅先在养根基，养得根基便达枝。\n温故知新明有分，事天立命岂无为。\n静中近水多幽远，雪后看春独古奇。\n有影须知清浅处，生香不似暗中时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54973,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其四十八 过化存神","author":"李江","text":"雪中风度月精神，画出人间几样人。\n颜闵形容凭影写，周程门户与天邻。\n有形上古庖羲象，无语先天尼父真。\n知是高坚前后处，山光水色绝风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其四十九 精蕴","author":"李江","text":"万径无人鸟绝飞，一生饱雪对疏篱。\n刚乎岂至磨多折，白者还教涅不缁。\n上品根荄归巨眼，非常地步即生知。\n玄天那有何言语，只字片言人代之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其五十 逸乐","author":"李江","text":"半窗明月半窗风，方寸悠然万虑空。\n风送氤氲来面上，月生明白入怀中。\n物华雅称年华好，春意偏宜人意浓。\n游子不知花是我，刚寻花外问诗翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其五十一 丰度不凡","author":"李江","text":"闲情雅淡出寻常，半捲疏帘入曲廊。\n冻合冰池悬素影，光摇溪水卸寒妆。\n浅斟酒盏深如海，轻擘诗囊月满床。\n景绝味殊人又老，萧然谁肯问行藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其五十二 华饰不尚","author":"李江","text":"纷纷百媚傍华居，山馆萧然独瘦癯。\n练帨缟裙风有韵，月光水色画偏殊。\n乾坤易简周中易，动静阴阳极外图。\n都把娵娃比嫫母，是非邪正两糊涂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其五十三 吟风弄月","author":"李江","text":"浅浅冰滩小玉堂，主人相对两相忘。\n长吟天外风来面，闲弄庭前月满廊。\n有伴青春堪适老，无边光景任寻芳。\n濂溪真影天描出，争奈蓬莱弱水长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54979,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其五十四 心广体胖","author":"李江","text":"满容气发霭窗纱，神韵纯和妙一家。\n图里可知机动静，水边徒见影横斜。\n看来真态皆天德，放出坤囊尽物华。\n自爱雪篱因坐久，茫然身世一梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54980,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其五十五 望之俨然","author":"李江","text":"神气蔼然射碧虚，飘飘骨相世间无。\n江心白练浮秋水，天外清冰映玉壶。\n踏雪有情人识了，点头底事孰知乎。\n高如山斗光如日，笑杀年来雪满须。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其五十六 即之也温","author":"李江","text":"昔时弱水隔蓬莱，千里相思日几回。\n如玉如银今咫尺，不言不笑共徘徊。\n月中有影虚前席，梦里多情称寿杯。\n笑把竹帘亲手捲，白头应许我追陪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其五十七 通神","author":"李江","text":"品汇纷纷独绝伦，生成标格似何人。\n至诚不息悠而久，体物无遗一故神。\n碧玉壶中天洞达，锦屏风面月清新。\n欲知洁静精微处，一部羲经字字真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54983,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其五十八 显道","author":"李江","text":"一理昭然万境深，红尘半点寂无侵。\n生春不已纯如意，正色无忘顾諟心。\n碾碎冰光寒洗玉，调停丹火漫烧金。\n虚灵洞彻如何处，大学中庸仔细寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54984,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其五十九 庄严","author":"李江","text":"等闲纵步出江皋，起敬寒梅格范高。\n仰望似逢新益友，顾瞻如见旧英豪。\n轻轻满水桃花浅，漠漠漫天柳絮毫。\n直向泰山寻孟子，秋霜点透鬓边髦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54985,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其六十 怡悦","author":"李江","text":"谁拈秃笔写天真，得意丹青点画新。\n老我蹉跎千古意，寄人欢喜一枝春。\n黄昏浅水吹羌笛，道气仙风服葛巾。\n百宝妆前眉欲皱，争教不似捧心人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54986,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其六十一 痕影","author":"李江","text":"久与神仙共一家，神仙家法似梅花。\n樽前月下飞琼侍，浅水黄昏处士嗟。\n酒兴几回凭笑语，诗情厌却道横斜。\n冷香飞落珠帘外，羞把疏枝半面遮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54987,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其六十二 根底","author":"李江","text":"形容自觉若焦枯，老却寒江风味殊。\n雪后玉堂人独坐，夜来茅舍月同孤。\n一泓溪水绕根底，万仞罗浮入画图。\n拈出先天为地步，后天地步又何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54988,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其六十三 安分","author":"李江","text":"分内兼收见本真，一锥瘠地可容身。\n琼英华丽堪为富，玉色清癯未是贫。\n生世自惊随岁老，时光独喜逐年新。\n海棠也有这场梦，唤不醒来笑杀人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54989,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其六十四 乐闲","author":"李江","text":"乾坤饶我老江村，笑把乾坤作故园。\n万顷玉渊沈白璧，一泓金井浸寒根。\n影摇南极开青眼，帘隔东风欲断魂。\n学圃主人无一事，相看终日闭柴门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54990,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其六十五 秀出等夷","author":"李江","text":"年来跳入此冰壶，老眼迟迟月色孤。\n是个良能真样子，还为神化大规模。\n孤根不为风霜改，素节宁能骨格殊。\n人道南枝有如此，北枝借问怎何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54991,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其六十六 老当益壮","author":"李江","text":"自觉聪明不及前，孤根清苦亦堪怜。\n秃毫砚冻影难写，小榻夜寒人未眠。\n百鍊刚肠半已迈，一生铁汉内还坚。\n自从夫子删诗后，朵朵分明三百篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54992,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其六十七 洞彻","author":"李江","text":"春入冰壶万壑融，山光水色路玲珑。\n月明照到诗囊里，香气绕来酒盏中。\n庭院竹帘疏弄影，石桥流水浅生风。\n分明身在青天上，玉树珊瑚挂碧空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54993,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其六十八 的当","author":"李江","text":"清香色影不曾差，岭外传名未足誇。\n千载有形归定体，一生无意斗繁华。\n天成标格风霜老，人在江湖眼界赊。\n端的个中平易处，浑然精义入神家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54994,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其六十九 形而上","author":"李江","text":"玉质冰肌气力全，揭开洞府梦魂仙。\n至精至粹花中月，无感无形影外天。\n色映朱门春霭霭，光摇青眼海渊渊。\n谁将一曲无声笛，吹满梢头我独眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54995,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其七十 形而下","author":"李江","text":"碾碎冰光洗九垓，十年谁寄一枝梅。\n玉奴手上诗情好，野叟岩中春意回。\n花落不惊新梦寐，霜寒正结旧根荄。\n可怜杨柳无风韵，却假天花做出来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54996,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其七十一 名","author":"李江","text":"十载栽培力未休，今朝相对半帘钩。\n终身尚质还嫌侈，没世无名亦可羞。\n丽色多情争玉树，清香有物异琼楼。\n不因闻达分诚伪，都把颛孙作话头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54997,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其七十二 实","author":"李江","text":"如此仙灵骨不衰，眼明清泄几何时。\n风光和我不知老，飘逸令人添作诗。\n深浅溪头千百树，横斜窗外两三枝。\n何须称道黄昏月，白日清天景更奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54998,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其七十三 寓意","author":"李江","text":"东风吹雨漫濡濡，浅白深红何处无。\n酌酒对花情淡薄，水边篱外路荒芜。\n肌肤不觉风霜老，颜色偏惊桃李图。\n自有化工真主宰，空教羯鼓动天衢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54999,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其七十四 即事","author":"李江","text":"一个诗翁骨相强，清风明月作家常。\n终身学圃身无累，老眼看梅眼正长。\n诗伯兴馀吟不了，美人梦断酒犹狂。\n春来得意多红紫，嗟尔疏篱独傲霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55000,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其七十五 一本","author":"李江","text":"恁地冰清入骨寒，一枝一影覆栏杆。\n万殊多在眼中见，一本还从心上看。\n布摆英华知有自，蕴藏风味太无端。\n何人刚被花留着，绕树千回咏未阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55001,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其七十六 万殊","author":"李江","text":"始终本末不差讹，弃塞乾坤道若何。\n一寸根荄藏太极，十分风味散元和。\n戟枝乱处心应苦，冰蕊老来香更多。\n坐到黄昏人复静，东风吹月入红罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55002,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其七十七 心地","author":"李江","text":"禀性由来得甚么，令人爱处境如何。\n露滋雨润仁为地，雪白风清义是柯。\n春意自怜莺未觉，粉墙不惹蝶来过。\n故园寸地虽云窄，个处生香那在多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55003,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其七十八 性天","author":"李江","text":"浅浅寒流远远山，真容赢得出尘寰。\n玉堂景致半林外，草舍家风万壑间。\n上达精神应绝品，勿忘节度已成丹。\n生来不是和光伴，怪尔风霜别一班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55004,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其七十九 仰德","author":"李江","text":"落落风霜一竹篱，香名久饮识荆迟。\n林泉居士闲游处，月殿嫦娥谪降时。\n天上银河如乍见，人间山斗更何疑。\n荷花犹有六郎比，汝是梅花可比谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55005,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其八十 俟时","author":"李江","text":"十二栏杆倚遍时，何如高髻看来迟。\n柴门虽少三千客，嘉运还逢五百期。\n水色山光俱满眼，诗囊酒癖尽开眉。\n须知实用堪调鼎，那在东风头上吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55006,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其八十一 风致","author":"李江","text":"眼前随处好山川，不但黄昏浅水边。\n当午帘垂閒砌远，无风花落短篱偏。\n东游西泛皆吾境，古往今来只此天。\n欲识个中风韵异，须看溥博又渊泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55007,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其八十二 清行","author":"李江","text":"造化何曾物物雕，玉容谁抹上孤标。\n幽怀不与常情合，野境偏宜老眼饶。\n雪洗诗囊皆锦绣，月笼花面不尘嚣。\n昆崙玄圃非无分，冷影疏枝傍小桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55008,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其八十三 有归于己","author":"李江","text":"牡丹富贵海棠春，嗟尔萧条共主人。\n把力做来都有样，从天分付自如神。\n月香飞入颜曾梦，冰影羞为晋楚邻。\n自古有荣还有辱，高车驷马不如贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55009,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其八十四 出一头地","author":"李江","text":"万芳丛里一天真，出一头来地步新。\n北叶未销金殿雪，南枝先报玉堂春。\n老夫拭目堪相慕，年少成名未足珍。\n不许邻家夜吹笛，清光留照月中人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55010,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其八十五 久大","author":"李江","text":"人生德业有如兹，易简工夫两不亏。\n清梦几回皆自觉，香风一段向谁吹。\n须知博厚高明处，便是日新富有时。\n地位休嫌卑且小，春风桃李各扬眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55011,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其八十六 不显","author":"李江","text":"庭院无风雪自披，风光雪色感当时。\n良心真切含新蕊，明德馨香袭旧枝。\n有谱金兰皆可画，无声玉笛妙难吹。\n漫将岁月从头数，十二年来过眼迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55012,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其八十七 偶成","author":"李江","text":"曾是罗浮洞里仙，久要情义两茫然。\n化工自是无私意，音耗何曾有暗传。\n名贵贮于金屋里，分该移向玉堂前。\n欲拈银管修花谱，好把梅花作首篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55013,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其八十八 谩兴","author":"李江","text":"批风抹月满墙阶，风满虚窗月满怀。\n花映席帘人共坐，酒催诗句不安排。\n剥胎换骨天工巧，仰面回头雪色揩。\n偏觉一番清且切，半江寒水洗心斋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55014,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其八十九 动荡","author":"李江","text":"大造无私假尔形，风流雅淡一耆英。\n影浮浅水山容瘦，香落芳樽酒晕轻。\n石径路寒堪跨马，柴门春早却来莺。\n一团意思谁参破，动荡春风满袖生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55015,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]