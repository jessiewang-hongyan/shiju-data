[{"title":"岁晏寄家书","author":"陈吾德","text":"天气冲寒入砚池，呼童融冻写新诗。\n客边浑是凄凉意，传与家人总不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14217,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题旅屋壁","author":"陈吾德","text":"昨日城头挂冠，今朝天外骖鸾。\n从教执席争席，且喜畜樊出樊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14218,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮光逆旅主人问余官戏答","author":"陈吾德","text":"楚国有新令尹，汉廷无故将军。\n相逢莫问名姓，谁能更论寒温。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14219,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜友过访","author":"陈吾德","text":"瘦竹疏梅况味，青山绿水襟怀。\n午梦何人惊破，门前君子朋来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14220,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄沈比部纯甫","author":"陈吾德","text":"登台一以眺，秋色倍思君。\n谁解驯龙性，聊为泽豹文。\n怀沙千古怨，抱玉几时分。\n圣代多恩诏，终然下五云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14221,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大梁逢吴明卿大参张子承佥宪学阁夜宴留别一首","author":"陈吾德","text":"白首投边过，青云有故人。\n醴从芸阁置，赋拟兔园新。\n看剑双龙在，鸣空一雁频。\n明朝万里别，那得不沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14222,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别刘简之年丈","author":"陈吾德","text":"相逢俱白发，而我复苍烟。\n握手三冬晚，论交十载前。\n且酬碧麦酿，莫奏朱丝弦。\n明发梁园道，离魂祇黯然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14223,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕书怀二首 其一","author":"陈吾德","text":"除夕天涯客，深宵独掩扉。\n椒盘随俗态，灯蕊报春晖。\n雪色千林暝，塞门一雁飞。\n乡心悉欲折，何处是庭闱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14224,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕书怀二首 其二","author":"陈吾德","text":"五十明朝是，因悲逆旅过。\n无闻应自愧，有志竟如何。\n蕉鹿迷真梦，冥鸿任网罗。\n床头周易在，高枕待羲和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14225,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁丑元旦","author":"陈吾德","text":"仓龙初正驭，万国睹垂衣。\n独有孤臣梦，空悬旧琐闱。\n年光随晓箭，春色到柴扉。\n旅食真何意，迂疏事事违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14226,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答沈纯甫见怀","author":"陈吾德","text":"锦字题诗到碧岑，天涯一望海沉沉。\n空瞻龙剑冲南斗，不见鸿书报上林。\n痛哭泪收炎徼远，艰危身在主恩深。\n孤臣旧有生还路，肯信终为憔悴吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14227,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日酬赠陶惟谦文学","author":"陈吾德","text":"闻尔东篱看月明，居然五柳一先生。\n黄花忆共尊前醉，白雪移来调里清。\n江阁夜寒秋水色，海门风急塞鸿声。\n投冠欲傍烟霞侣，莫向丹台问姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14228,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和曹明府游白沙相祠地二首 其一","author":"陈吾德","text":"银花浮动锦函开，郢曲新传白雪裁。\n自是登高能作赋，不因乘兴共衔杯。\n湘漓地尽双流合，楚越疆分一水来。\n欲向江门问真派，愿携烟艇泛波回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14229,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和曹明府游白沙相祠地二首 其二","author":"陈吾德","text":"水白山青四望开，地留名胜昔人裁。\n当歌共入春阳里，把酒还传碧玉杯。\n云去隔溪霜叶坠，台空明月夜乌来。\n千秋祀典公筹度，更从篮舆陟巘回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14230,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬午九日偕青霞老人庞少举游罗浮","author":"陈吾德","text":"罗浮秋色隐晴空，拄杖能追负局翁。\n雏凤羽毛连碧汉，老龙鳞甲偃苍松。\n邀来缑岭吹笙月，寒入参军落帽风。\n黄菊紫萸聊共醉，更从何处觅仙踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14231,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五羊别叶男兆","author":"陈吾德","text":"客里逢君属岁残，谁能华发共弹冠。\n白鸥海上呼群急，黄鹄天边并翼难。\n雪夜他年南浦梦，河梁今夕北风寒。\n柳条遏臈那堪折，独有梅花可赠看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14232,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"椿庭遗翰卷为陆宪副赋","author":"陈吾德","text":"柱史传家邺下才，阳春一曲自何来。\n忽惊手泽星霜改，长拟心神箧笥开。\n紫气峥嵘看斗极，银光浮动走风雷。\n士衡故有思亲赋，不寄南云亦自哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14233,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠马用德广文之任桂林便道省觐","author":"陈吾德","text":"桂水浮空彩鹢归，传经人似马融稀。\n盈门桃李经年植，得雨蛟龙傍汉飞。\n故国移官还绛帐，北堂归梦自斑衣。\n毡寒莫厌夷城卧，会有徵书下紫微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送萧以宁宪副观察蜀中","author":"陈吾德","text":"霜节西征白日寒，送君先著惠文冠。\n邺人终识河渠使，蜀地今还陆海看。\n三峡星辰连楚甸，五云东北是长安。\n登朝早晚书应寄，莫道衡阳雁到难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒食舟中寄怀舍弟懋直","author":"陈吾德","text":"天涯谁不念离群，况复连枝暮景分。\n入望千山帆外尽，断行孤雁雨中闻。\n关心岁序悲游子，堕泪松楸独看君。\n野哭郊原寒食过，扁舟何处不销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠陈司理及卿解官还闽","author":"陈吾德","text":"清世怜君制芰裳，那堪尊酒别河梁。\n蒲帆晓挂三城雨，泽国寒飞五月霜。\n官罢乾坤双绿鬓，梦回湖海一黄粱。\n寄言罗罻高悬者，可奈冥鸿属意翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别青霞炼师","author":"陈吾德","text":"旧约名山共息机，年来真得遂初衣。\n秋高邺下双凫至，岁晏辽东一鹤归。\n袖里龙文人罕识，枕中鸿宝世全稀。\n丹成且莫冲霄去，还记江门有钓矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14238,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"松台同叶化甫何元伟二年丈舟中夜酌","author":"陈吾德","text":"星聚天门暮霭收，连枝今作异乡游。\n尊前歌动青云色，峡里寒生紫塞秋。\n献赋风尘还白首，著书岁月自罗浮。\n酒醒吾亦悲渔父，明发天涯放钓舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14239,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过南浦陈方伯玉叔招宴赋谢二首 其一","author":"陈吾德","text":"走马长安忆并游，十年消息自沉浮。\n旧藏五岳图仍在，新拟三都赋更优。\n南浦寒云当昼合，西山积雨入江流。\n邀欢正值苍痍急，愿以旬宣翊帝猷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14240,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过南浦陈方伯玉叔招宴赋谢二首 其二","author":"陈吾德","text":"暂释渔竿海上游，相逢犹自问罗浮。\n碧霞丹在谁当遇，白雪歌来尔最优。\n公暇登楼诗便得，政成分陕颂先流。\n长文更有山阴约，未拟回舟学子猷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14241,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜泊桑园有怀施于我年丈为余将家口在后却寄","author":"陈吾德","text":"卫水维舟却望频，独怜尊酒共谁论。\n秋霜欲上明朝鬓，夜雨能消旅客魂。\n已有浮槎供使者，不劳芳草怨王孙。\n天涯妻子愁相向，又得同归上鹿门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14242,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿陈隐君六十","author":"陈吾德","text":"画堂日暖进琼卮，才子青春綵袖垂。\n丘壑百年龙性在，云霄五色凤毛奇。\n当筵竞进冰桃实，照坐争看玉树枝。\n奎壁夜来多气气，定知荣寿应昌期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14243,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"襄阳馆中书怀","author":"陈吾德","text":"不见天南尺素传，乾坤孤使若为欢。\n青山独上休随酒，明月重来尚倚栏。\n楚北望乡何日到，汝南归骑有人看。\n驱车莫问王阳事，蜀道于今不是难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14244,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登丛台","author":"陈吾德","text":"赵王胡服定中山，自筑层台缥缈间。\n事往尚馀残碣在，春来惟伴落花閒。\n骎骎古陌青骊远，累累空原绿树还。\n试向漳河一回首，祇今东去几时还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14245,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送欧桢伯分教江都","author":"陈吾德","text":"三年待诏出江都，繁露才高似仲舒。\n坐上尽逢金马客，囊中多挟羽陵书。\n芜城尔去还能赋，郢曲人传和不如。\n莫道广文毡独冷，汉廷前席有时虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14246,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元旦纪梦","author":"陈吾德","text":"天门日丽海潮生，独泛扁舟向晓行。\n一道祥光浮紫翠，九重佳气郁葱菁。\n星槎有路通银汉，仙侣如云会玉京。\n十载江湖劳梦寐，瞻依常切凤凰城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14247,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄陈富伯兄弟","author":"陈吾德","text":"十里蒹葭入望疏，美人遥隔水云居。\n清宵欲上黄猷舸，尘路羞回阮籍车。\n目极烟霄抟两凤，心随湖海忆双鱼。\n干戈满地堪垂泪，何日相逢话故庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14248,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"襄阳迟舒给事汝德从剑阁入蜀","author":"陈吾德","text":"蜀使宁辞蜀道难，千山空说鸟飞还。\n金牛旧启通秦路，天马西来入汉关。\n旅泊尚依三楚外，梦游先到七盘间。\n云边独忆乘槎侣，夜夜看刀泣宝环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14249,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉泉山谒关将军庙","author":"陈吾德","text":"运去中原惜汉家，将军孤庙夕阳斜。\n看碑欲洒千秋泪，访古还停万里槎。\n树杪流云愁不散，岩前杀气望来赊。\n山僧共说英灵异，风雨时时走乱沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14250,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秭归阻雨","author":"陈吾德","text":"西去巴梁路渺漫，潇潇积雨昼生寒。\n孤城举目空波浪，尊酒看君有肺肝。\n客梦易随青嶂断，乡心多共白云攒。\n巫阳祇在啼猿外，愁绝阴霾起树端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14251,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别舒汝德给舍兼订春还之约","author":"陈吾德","text":"共泛归槎锦水浔，一尊岐路惜分襟。\n明河夜落西征赋，白日秋悬近侍心。\n七泽风高闻断雁，五陵花发待华簪。\n经途不负淮南约，迟尔同扳桂树林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14252,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王使君召宴翊襄亭二首 其一","author":"陈吾德","text":"明牧招携兴倍长，看山终日绮筵张。\n歌传激楚云边调，酒进宜城竹外觞。\n堤树远连襄汉影，岩花轻点芰荷裳。\n习池岘首当年事，千载来游复此乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14253,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王使君召宴翊襄亭二首 其二","author":"陈吾德","text":"危亭遥枕碧山头，匹马从来五马游。\n千里未忘丘壑兴，一杯同破古今愁。\n坐移曲槛青云绕，俯瞰澄江白练浮。\n自是使君能爱客，夜阑尊酒尚淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14254,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘廷评镇中乞归养南还赋此赠之","author":"陈吾德","text":"法署含香二月馀，飘然朝上乞归书。\n西山日暮乌情急，南国天遥雁影疏。\n不是刘殷能避召，如何潘岳在闲居。\n故人燕市今馀几，愧尔风尘合佩鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14255,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出京书怀","author":"陈吾德","text":"跃马长安愿已违，故园迢递思依依。\n月明紫水千门过，秋到黄云几处飞。\n池馆乍回春草梦，兵戈应念老莱衣。\n解貂准拟来朝醉，谁道王孙怅不归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14256,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游金山寺同陈隆之太史陈来源外翰分得江字","author":"陈吾德","text":"词客招携谒上方，胜游宁觉滞他邦。\n鼋鼍傍岸窥禅语，云雾当空护法幢。\n海上仙山无弱水，人间倒景有长江。\n应知河朔非吾辈，良夜何劳引玉釭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14257,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登淮上楼席间赠别施于我员外","author":"陈吾德","text":"登楼共酌杯中酒，旅次那堪怆别筵。\n樗质自应明主弃，绨袍长得故人怜。\n江城雨过青山外，水国寒山白雁前。\n醉引斗牛看紫气，不知龙剑聚何年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14258,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得报削籍放归书怀","author":"陈吾德","text":"海上田园归去来，片帆风送大河隈。\n白头好向吟边过，玄草今从静里栽。\n随处风尘难浪迹，浩歌天地一登台。\n黄云紫水春无恙，想像茅堂花正开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14259,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苏门观泉源","author":"陈吾德","text":"苏门形胜太行来，千里河源一鉴开。\n星宿乍疑浮瀚海，蛟龙时见起春雷。\n转输东北天津会，襟带西南地轴回。\n十载卫城曾驻马，独怜华发始登台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14260,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登九山","author":"陈吾德","text":"天遣灵山拥卫源，万山罗列此山尊。\n丹梯百转烟霞并，石阙双开虎豹蹲。\n春色渐看回大地，冻云犹自护禅门。\n太行望处青霄断，好是庾关入梦魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14261,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登啸台同朱邦瑞训导","author":"陈吾德","text":"逸士高踪何处寻，空留石室倚云岑。\n孤台尚想烟霞色，哀壑疑闻鸾凤音。\n白日坐来苍霭合，红尘飞尽碧苔深。\n君看卫水年年在，肯向儒门叹陆沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14262,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄吴明卿大参","author":"陈吾德","text":"曾握麟符海上来，看君元不薄蒿莱。\n江山无恙诗篇在，祠像遥传父老开。\n绝塞逢人谁问旧，中原下马一衔杯。\n莫言凤辖愁罗网，已有灵珠照乘回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14263,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度庾岭逢谢广文赴漳州博率尔言别","author":"陈吾德","text":"岭上相逢日欲曛，旂亭立马袂难分。\n十年别有新华发，三仕官仍旧广文。\n苒苒风尘悲异路，翩翩词赋想凌云。\n兰湖漳浦须臾隔，愁绝啼猿不可闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14264,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄惟巽弟孝廉","author":"陈吾德","text":"泽国凉风起白蘋，天涯一望绝音尘。\n瑶华欲折情难寄，鸿雁不来秋正新。\n梦入池塘频见汝，别来词藻定惊人。\n栖迟莫共垂双翮，万里青云好致身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14265,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋江钓叟约陈道襄侍御","author":"陈吾德","text":"单骑遥从朔漠归，扁舟还泊子陵矶。\n谁能勇退辞湍水，尔独披蓑捲赐衣。\n鸥梦不惊雏凤翥，雁扬翻羡海鲈肥。\n扣舷不用歌醒醉，春酒长江任息机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14266,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送曹明府入觐","author":"陈吾德","text":"仙舄双飞入紫薇，紫衣京兆领班时。\n梯航万国观王会，阊阖千门肃羽仪。\n六计总优廉吏治，九霄应有御屏知。\n循良别有黄金宠，次第承恩下玉墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14267,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈司理及卿以诗见寄依韵和之","author":"陈吾德","text":"郡斋随处有鱼悬，为政人歌奕世贤。\n两粤风猷谁易并，一官留滞尚难全。\n离筵共对朱明月，归日孤眠紫帽烟。\n千古岘碑还堕泪，君看陵谷几时迁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14268,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海不扬波卷赠陆宪副奏绩","author":"陈吾德","text":"年来百粤靖妖氛，奏最新从阙下闻。\n重译总多浮海贡，八林全散采珠郡。\n青云事业当朝重，铜柱功名异代分。\n海国万家甘寝日，好将银管述殊勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14269,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮玉台呈郡伯郭公","author":"陈吾德","text":"使君神略擅南州，新筑高台壮胜游。\n地脉北连形势便，海门东望印光浮。\n巨鳌擎出波心石，圆峤移来郭外洲。\n千古口碑应不泯，共看砥柱屹中流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14270,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得陈及卿邸报","author":"陈吾德","text":"忽报飞章出上都，遥闻涕泪满衣裾。\n翩翩凤辖逢罗网，渺渺鱼缄隔岁除。\n握里总收和氏璧，箧中休辩乐羊书。\n幽怀吾欲从天问，何得凌风入帝居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14271,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清时奏最卷赠鲁子与司理报政","author":"陈吾德","text":"万户讴声动海隅，荐书奏最入天衢。\n座间独运成风手，掌上长悬照夜珠。\n人似碧霄孤鸑下，心如明镜一尘无。\n中牟旧业君方驾，谁逐骅骝并过都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14272,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"粤天霖雨卷为开府中丞吴公赋","author":"陈吾德","text":"百粤安壤籍壮猷，太平气象满炎州。\n风行万里霜威肃，霖起千年瘴雾收。\n帝锡玄圭元有待，人歌赤舄可能留。\n宵衣此日思良佐，勿密还公赞冕旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14273,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠曾把总之郧阳兼柬李孟诚中丞","author":"陈吾德","text":"君才岂合老蓬蒿，四马冲炎楚甸高。\n囊里旧馀黄石略，腰间新佩吕虔刀。\n山当衡岳无宾雁，路入宜城有醴醪。\n明到辕门如问讯，书回聊慰梦魂劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14274,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日答罗少南","author":"陈吾德","text":"一鹤传椷度海云，长林迟日斗鲜新。\n花枝带雨晴犹湿，柳色笼烟淡欲匀。\n网到游鱼堪作馔，折来残桂可为薪。\n沧溟若有乘槎兴，无限春光共钓纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14275,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新秋寄惟巽弟","author":"陈吾德","text":"寇盗频年赤羽传，卜居何地问林泉。\n登楼忆弟难成赋，为客逢秋殊可怜。\n海阔鱼龙能避浪，风高鸿雁不同天。\n裁诗欲迟三江使，望绝云烟祇惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14276,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病起有怀穗城诸兄","author":"陈吾德","text":"病起空斋理蠹鱼，即看人事半全疏。\n自惭懒慢非耽酒，祇有穷愁可著书。\n独夜虚惊青琐梦，扁舟谁念白云居。\n梁园故旧无消息，闭户还能赋子虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14277,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题盘洲处士隐居","author":"陈吾德","text":"大隐随缘出薜萝，磻溪何处问渔蓑。\n尔家旧业青云近，别墅新营绿水多。\n高枕江霞当槛落，开轩鸥鸟傍人过。\n扁舟载酒堪乘兴，未脱尘踪奈若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14278,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈霞谷来顾西园送别时北上谒选","author":"陈吾德","text":"公车待诏出长安，曾记青尊共岁寒。\n逸足自言千里易，高栖犹借一枝难。\n西园地僻携琴至，北极天遥倚剑看。\n自是郑庄能爱士，肯教词赋滞儒冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14279,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日李维任舟中召饮不至赋此赠之","author":"陈吾德","text":"芳菲佳节入韶年，锦缆维舟列彩筵。\n酒色杯光浮海气，歌声舞袖斗春妍。\n佳人竞巧黄金胜，游子争驱白玉鞭。\n纵览不知归路暝，谓谁同上李膺船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14280,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]