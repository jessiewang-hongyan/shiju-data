[{"title":"山亭","author":"谢承举","text":"山亭栖断阿，嗟予三月病。\n扶衰试重来，秋苔迷石磴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30081,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西津","author":"谢承举","text":"青藜步柳阴，已识西津路。\n白衣歌水涯，不上西津渡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30082,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梦中作","author":"谢承举","text":"璚瑶洲畔拾芙蓉，玉女青童两队从。\n明月一江天似水，夜凉骑鹤下西峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30083,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"牧龙亭杂诗 其一","author":"谢承举","text":"白沙一路接长坡，处处蚕桑处处禾。\n过午野田啼鸟歇，楝花风送踏车歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30084,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"牧龙亭杂诗 其二","author":"谢承举","text":"长揖耕夫问牧龙，苍峰东指塔重重。\n邮亭岁远无门榜，破屋墙边四五松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30085,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"牧龙亭杂诗 其三","author":"谢承举","text":"细风吹雨散还收，四月轻寒正麦秋。\n梅子已黄蚕巳熟，满村桑柘叫钩辀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30086,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"水仙花","author":"谢承举","text":"两娥湘浦倚秋清，九处峰峦九系情。\n玉露半空明月冷，西风吹落佩环声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30087,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"绝句题芙蓉","author":"谢承举","text":"愁搴木末吊沈湘，万古江流怨与长。\n何似霜花识幽意，年年秋晚为舒芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30088,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"墨芙蓉","author":"谢承举","text":"紫毫濡染墨淋漓，木末孤搴诵楚辞。\n月黑林深湘渚夜，一天风雨泊舟时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30089,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画","author":"谢承举","text":"崖穿晴瀑悬林白，树滴寒岚堕石青。\n天目旧程行颇惯，马头秋色落云屏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30090,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"睡起口占","author":"谢承举","text":"茶瀹花磁洗睡魔，枕流亭上暮凉多。\n狂飙吹下西山雨，一片秋声恋败荷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30091,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湘江风雨画竹","author":"谢承举","text":"云深兰露泣双鬟，獭髓流香翠点斑。\n一望苍烟三万里，不知何处九疑山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30092,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"辞浙东汤希达周叔谨","author":"谢承举","text":"菱湖柳岸水禽啼，野鹤沙凫恨不齐。\n梦断篷窗懒回首，一溪晴雨过塘西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30093,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画竹为汤宗器题","author":"谢承举","text":"曾记潇湘系短篷，隔江烟雨翠重重。\n惊雷忽报春消息，一夜灵根长箨龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30094,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题扇寄希仁","author":"谢承举","text":"雪晴莎暖乍离家，北去频看雁影斜。\n回首江南春渐老，东风开到紫荆花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30095,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李习儒还长沙","author":"谢承举","text":"楚江西去乱峰青，日暮风凋折柳亭。\n聊把离觞听瑶瑟，尊前一曲有湘灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30096,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题相思鸟","author":"谢承举","text":"俱飞并逐绮园春，互语相思字字真。\n啼到苦心声莫放，绿窗惊起病春人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30097,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"四月十日过东山小庄漫兴 其一","author":"谢承举","text":"林深树杪挂藤花，石径初来路觉赊。\n割尽黄云农未了，枣桑阴里斗栽瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30098,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"四月十日过东山小庄漫兴 其二","author":"谢承举","text":"茅茨喔喔乱晨鸡，红日穿林树影低。\n圃上轴声惊打麦，黄莺飞过绿阴啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30099,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送刘文献","author":"谢承举","text":"石城柳色春犹浅，锦席灯花夜未分。\n明发北风江棹稳，思君又隔洞庭云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30100,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"绝句","author":"谢承举","text":"扶得青藜到水涯，东风袅袅垫巾斜。\n吟情还为春情恼，红杏枝头已着花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30101,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送蓟门客二首 其一","author":"谢承举","text":"秋深又送蓟门骖，林树涂霜叶正酣。\n千里羁人怜远别，乡心夜夜斗杓南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30102,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送蓟门客二首 其二","author":"谢承举","text":"秋晚辞家到及春，江山如旧客愁新。\n多情最是随阳雁，年去年来解送人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30103,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"绝句","author":"谢承举","text":"步出吴门入古林，松涛竹籁互酬唫。\n稚圭不用仍移檄，猿鹤应知近日心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30104,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"竹上白头","author":"谢承举","text":"碧霄云路几升沈，楚楚毛衣太古音。\n自笑白头无伎俩，坚持一节老山林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30105,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"绝句","author":"谢承举","text":"铿锵戛玉能清耳，瑩彻喷珠可濯心。\n何处人烟隔尘海，不知身在翠萝阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30106,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄何圌樵一绝","author":"谢承举","text":"山中酒熟君思我，雪里诗成我寄君。\n东望海门三百里，不胜离思乱江云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30107,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画雁","author":"谢承举","text":"湖上芦黄水拍天，湖头人去少书传。\n秋窗正有孤眠客，莫送哀声到枕边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30108,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"李潜夫画","author":"谢承举","text":"银河无路泛仙槎，一舸空江此是家。\n残月照人秋睡稳，不知清梦在芦花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30109,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送邓以敬","author":"谢承举","text":"貂蝉家世旧王孙，西指濠梁是故园。\n雪霁四山狐兔出，笑携弓矢猎平原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30110,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日迟文衡山先生不至","author":"汤珍","text":"肃肃振飘风，霏霏洒芳澍。\n迟客向南轩，徘徊眄庭树。\n俶装戒星来，倾羲未云赴。\n鸟鸣不相求，反已每自顾。\n我思郁以烦，孰克探其故。\n遐心邈霄汉，倏晷淹难度。\n沈忧抱孤景，中结岂外慕。\n今雨既无成，何由纡雅素。\n申讯吐清谣，殷勤待良晤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30111,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠别全州四友","author":"汤珍","text":"南州实楚壤，湘水分洮阳。\n兹维五岭表，带海襟蛮荒。\n土风霭清淑，秀发人文昌。\n济济多士美，接迹参翱翔。\n二唐本华胄，崛起名相望。\n经君流朗照，邓子葆真光。\n挹之信可亲，测之愈汪洋。\n绝群峙鸾鹄，炫目森璆琅。\n投怀滥追厕，披写何能忘。\n云霄有程期，行行去辙长。\n缅增离析叹，春色违河梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30112,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"光福寺","author":"汤珍","text":"登登邓尉山，飞搆见古寺。\n横割凤冈青，平临锦峰翠。\n谁移白银阙，置此佳丽地。\n下负巨神鳌，万古永不坠。\n草树多攒花，云崖剩题字。\n旭日射宝塔，珠光荡如碎。\n迎门有老僧，台客不相避。\n和南揖就坐，蒲团各分位。\n香茗无杂供，居能自清异。\n我弹瓦棋盘，彼弄铁如意。\n玄言悟三空，心兵欲遐弃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30113,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"虎山桥","author":"汤珍","text":"太湖三万顷，波流浩融融。\n长鲸枕其股，架石仗神通。\n左临蛟虬窟，右瞰冯夷宫。\n大观惬平生，与世辞牢笼。\n坤维断鳌极，日观飞穹窿。\n孤帆灭天际，远峤浮烟中。\n阴晴变昏旦，状态未有穷。\n扁舟忽在眼，缅想䲭夷公。\n渔歌何处起，唱入桃花风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30114,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鲁秋胡诗二首 其一","author":"汤珍","text":"结发谐伉俪，遄征迫王期。\n弃置嬿婉恋，行为好爵縻。\n言旋故里辙，邂逅旧容仪。\n别衷曷以究，诡辞相绐欺。\n不然桑梓中，兹维敬止时。\n奉金为母寿，慰此合欢思。\n流目岂足盼，调笑何当施。\n屈辱一朝名，徒令万代嗤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30115,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鲁秋胡诗二首 其二","author":"汤珍","text":"自君之出矣，五岁恒食贫。\n力田非所任，力桑由妾身。\n色养给晨夕，一意待良人。\n惜哉不相谅，片辞难重陈。\n桑叶何青青，蚕蠕亦振振。\n黄金高累屋，视若飘风尘。\n白璧诚少玷，有如此河津。\n全躯眩昭昧，孰克表千春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30116,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"出东门行","author":"汤珍","text":"出东门，何所之，倚行剑，对酒卮。\n耻为儿女泣相持，青春游子当及时。\n西指秦中道，北踰燕赵陲。\n陇首白云远，天涯紫雁悲。\n劝君不若返故乡，衡门之下堪栖迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30117,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"广武行","author":"汤珍","text":"噫嘻广平古战场，据敖仓而倚荥阳。\n负山阻塞扼险要，楚汉相持壁垒当。\n是时龙虎方交斗，结阵连军昏白昼。\n重瞳取霸实暴兴，丰沛真人乃天授。\n平沙落雁下高城，戍草屯云夕照明。\n蚀泥断镞犹封血，夷灶馀基尚有茔。\n山川好在殊今昔，往事销磨但陈迹。\n鸿沟即使遂中分，儿戏舆图轻一掷。\n慷慨何人阮嗣宗，醉眸傲睨乾坤中。\n览古黄河气填臆，长啸茫茫徐泗空。\n凭高指画争衡地，怅惜英雄生不世。\n彼竖子者岂数名，鼠窃翻能盗神器。\n神器虽可盗，天意宁可欺，太阿不久柄倒持。\n弱人孤寡还自敝，覆辙循环空尔为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30118,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"上新河观练水军歌","author":"汤珍","text":"建业城西上河口，大江控截金陵守。\n圣祖经营置水军，结垒辕门环细柳。\n两翼回渠伏港通，鱼丽栉比藏艨艟。\n太平讲武三时暇，教演时当十月中。\n是日风恬波浪平，团营号令传分明。\n对壁虚声张寇敌，旌麾简出横江兵。\n箭羽枪缨光映掩，鲸奔鳄逝天为惨。\n赤壁曾摧魏武师，襄阳直破杨么胆。\n朱袍牙帐树中坚，锦帽花靴簇两边。\n水后天吴称警肃，客樯远避惊鸿旋。\n炮鼓烟腾川沸动，舻舳相衔万声閧。\n青山漠漠愁渚宫，白日晖晖撼云梦。\n先锋一舸最前归，报捷欢呼疾若飞。\n钲铙并奏齐天乐，虎豹交翻偃月旂。\n吁嗟训旅虽近古，将军莫浪誇英武。\n君不见江东水战推吴人，使船如马真绝伦。\n王浚扬帆一夕来，洋洋天堑同平津。\n又不见陈家江总歌玉树，谋国书生成大误。\n朱雀航头烽火红，折苇凭刀竞飞渡。\n呜呼此军此舟胡可无，屏翰干城存庙谟。\n不然徒为儿女戏，衣带浮沤作何事。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30119,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题沈石田效米元晖云山图","author":"汤珍","text":"春山蒸云湿模糊，春树凝烟渺有无。\n汀花岸草愁相唤，蘅渚兰皋低自纡。\n江南雨景真貌出，世传曾有元晖笔。\n石田老人近代豪，步骤邯郸更超逸。\n越溪难注消夏湾，胥口波涛杳霭间。\n西遮震泽双螺小，北走灵岩万笏还。\n江村桥外炊烟夕，上沙下沙水涵碧。\n似闻茅屋啼斑鸠，无那东风摇燕麦。\n沈吟忆得画中诗，洒墨挥毫兴发奇。\n并驱逐鹿知谁手，何必敷文待制为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30120,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"铜爵台","author":"汤珍","text":"自失平吴策，空名起邺台。\n馀香残箧冷，促柱短歌哀。\n汉水漳河尽，当涂典午来。\n西陵松柏地，旋接北邙莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30121,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寺门","author":"汤珍","text":"寺门山麓峙，当面更青山。\n渺有烟霞想，谁参秘密关。\n僧穿松径去，童汲井华还。\n尘海茫茫远，三生梦觉间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30122,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"许摄泉见过山中失迓赋此解嘲","author":"汤珍","text":"久孤南望约，枉沐北山临。\n扫壁真题凤，攀云独抱琴。\n午斋留石钵，寒日静珠林。\n自是攒眉去，非因白社深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30123,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登城","author":"汤珍","text":"行跻覆舟岭，睇览秣陵城。\n壑听松涛涌，林窥鹿子行。\n荒凉梁堞散，埋没晋丘平。\n皎皎江南月，空流玉树情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30124,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"途淖不一舆由土桥取山径往朝阳门作","author":"汤珍","text":"别路循山坂，肩舆出淖泥。\n崇冈带连岭，古庙枕寒溪。\n水落通前涧，峰回豁近蹊。\n王城千雉壮，蹄辐会归齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30125,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三月晦日作","author":"汤珍","text":"江南樱笋候，浥浥绿阴鲜。\n雨涨桃花水，春催麦秀天。\n燕泥增旧垒，槐火接新烟。\n腻叶留残萼，啼莺亦解怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30126,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"大云庵","author":"汤珍","text":"清阴閒寂境，过雨午生凉。\n水漾潭云碧，花牵石蔓香。\n竹苞新脱粉，莺舌巧调簧。\n采蕨烹葵笋，难消道味长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30127,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"石桥","author":"汤珍","text":"时雨如膏沐，能添竹树鲜。\n石桥分野望，云日澹川烟。\n僧笠归花外，渔舟系柳边。\n村村逐芒种，播谷满菑田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30128,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"文公房晚话","author":"汤珍","text":"逐处留香茗，忘归道室开。\n飞蝉空外咽，怖鸽镜中回。\n野客耽幽趣，禅宗挺辩才。\n凉风忽吹至，仙乐九天哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30129,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋山月下作","author":"汤珍","text":"长歌不为劳，起舞兴萧骚。\n石壁云芝秀，风庭月树高。\n金蟆窥塔相，玉兔鉴林毛。\n衣露瀼瀼湿，秋声捲夜涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30130,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚酌汤以远侄","author":"汤珍","text":"山居分涧壑，邻卜并烟霞。\n地胜秋依竹，人幽晚对花。\n解衣披石藓，飞斝散城鸦。\n楚楚吾宗秀，无嫌玉倚葭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30131,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日同徵仲太史宗子伯昭游虎丘作","author":"汤珍","text":"殿堂突兀倚秋曛，剑壑经台郁紫氛。\n落木俯窥沧海峤，飞鸿遥送洞庭云。\n登临洵美仍吾土，汗漫相期况有群。\n拟办草衣谋小隐，肯教重勒北山文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30132,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十日阴晦漫赋","author":"汤珍","text":"昨日重阳今日阴，眼前时事漫惊心。\n紫茱黄菊馀幽兴，白石青苔伴独吟。\n万里鸿冥聊下上，百年龙卧信浮沈。\n高情亦复如元亮，不见王弘送酒临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30133,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重阳后二夜对月寄孔加式如","author":"汤珍","text":"络纬鸣螀傍草堂，纷纷凉月照衣裳。\n空云散落星河影，叶露漙来竹树光。\n好景正缘怜永夜，清言无奈隔华觞。\n高阳多少登临兴，尽把閒情付葛强。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30134,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"酬张员外永清","author":"汤珍","text":"阙下逍遥鸳鹭行，省中题署汉仙郎。\n春田花树传新赋，宝剑虹文识夜光。\n高意欲脩莲社约，野情时合竹林觞。\n江梅玉笛空愁思，惭对琼瑶乏报章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30135,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日虎丘","author":"汤珍","text":"白云苍蔼迥秋清，碧嶂丹枫媚眼明。\n雉堞楼台披下上，塞天鸿雁度纵横。\n珠光乍转层层塔，暖色犹啼款款莺。\n休倚夜中看剑气，古崖哀壑閟金精。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30136,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪","author":"汤珍","text":"常年腊日多风雨，今岁吴门雪再飞。\n积叶封条辉玉树，骖蜺策鹭舞瑶妃。\n独吟何逊梅花句，细点王恭鹤氅衣。\n莫讶梁园无赋客，倦游心事长卿违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30137,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵签顾子荣","author":"汤珍","text":"摇落三秋木叶稀，暮云翘首思依依。\n高城背日江流细，远市浮烟塔影微。\n蒋径巳叨今雨洽，陶词休赋昨来非。\n渐林不断鸾凰翼，始信人间德有辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30138,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵答吴吏部纯叔早春见寄","author":"汤珍","text":"落落乾坤任此生，悠悠岐路苦难平。\n凿坏颜阖元逃世，卖药韩康不事名。\n白雪掺停花下石，紫芝歌和竹间莺。\n江湖满眼乘春兴，拟逐䲭夷万里行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30139,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"呈吴子纯叔","author":"汤珍","text":"北郭开堂赐养丰，西山拄笏翠烟通。\n膝前巳遂承欢志，海内偏钦引退风。\n水槛观鱼花戏沼，松庭调鹤月流空。\n遥知三径多游暇，何事求羊兴莫同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30140,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"庚子至日","author":"汤珍","text":"日临南至阳潜复，云物呈祥总可书。\n海上巳平新战伐，山中堪狎旧樵渔。\n揆才袜线惭终琐，测景驹檐觉渐舒。\n酩酊即须酬令节，芳樽浮醁莫教虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30141,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"竹堂寺同徵仲太史禄之吏部看梅","author":"汤珍","text":"二月寻春春始分，轻阴漠漠殢春云。\n巳窥柳色偷青眼，更傍梅花籍晚芬。\n映日楼台山郭见，穿林钟梵石堂闻。\n年来自笑多樗散，长在空门野衲群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30142,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"顾氏园赏罂粟花","author":"汤珍","text":"四月馀春春事凋，竹阑石径剩炎韶。\n殊妆各自矜颜色，缦立相将学舞腰。\n蝶趁风香狂不奈，日烘霞锦丽难消。\n海棠屏障梨花㩜，肠断芳魂拟共招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30143,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五龙堂","author":"汤珍","text":"乌鹊桥南访古游，五龙祠宇湛灵湫。\n荒台半蚀穹碑字，潜窦遥通大海流。\n玉册金文昭往锡，金书玉简赴冥投。\n腥风白昼犹云气，寂历墙花径自幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30144,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"文太史新成玉磬山房赋诗奉贺","author":"汤珍","text":"精庐结搆敞虚明，曲折中如玉磬成。\n藉石净宜敷翠樾，栽花深许护柴荆。\n壁间岁月藏书旧，天上功名拂袖轻。\n草罢太玄无客到，晚凉高栋看云行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30145,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题寄大云庵沧浪上人","author":"汤珍","text":"子城南畔古沧浪，复树回流匝宝坊。\n幢影倒凌波石动，松阴斜拂岛云翔。\n几随诗客来投社，每忆经僧坐品香。\n隔市梵音知不远，翠烟深处有禅房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30146,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]