ommit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55493,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次陈公远重阳绝句五首 其二","author":"王缜","text":"自从通籍傍皇家，归梦终宵绕海涯。\n遥忆故园登赏处，几秋辜负此黄花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55494,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次陈公远重阳绝句五首 其三","author":"王缜","text":"谁擅诗名自一家，秋来豪兴浩无涯。\n吴绫直借三千尺，题遍东篱百种花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55495,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次陈公远重阳绝句五首 其四","author":"王缜","text":"与君门户是通家，共住江南江水涯。\n今日长安须尽醉，明朝又是一番花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55496,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次陈公远重阳绝句五首 其五","author":"王缜","text":"彭城游乐几人家，踪迹荒凉没水涯。\n秋菊不知今古事，年年依旧发黄花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55497,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀胡宗周琼台定安人","author":"王缜","text":"停云依树隐琼台，别后思君花乱开。\n客梦不知湖海远，几回飞绕定安来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55498,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿椿为山东刘休庵作","author":"王缜","text":"老便投簪卜所居，江山无碍自安如。\n要知物静从来久，不是寻常栎与樗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe52942