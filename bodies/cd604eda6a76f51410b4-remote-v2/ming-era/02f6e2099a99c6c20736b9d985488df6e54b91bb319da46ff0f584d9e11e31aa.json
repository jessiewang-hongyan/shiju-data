[{"title":"宫词一百首（并序）（录五十首） 其四十七","author":"王叔承","text":"长宵无奈玉床寒，结得中官姊妹欢。\n暗赠流苏双凤带，叮咛莫遣外家看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4550,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其四十八","author":"王叔承","text":"家本邯郸歌舞仙，龙袍从猎并金鞯。\n玉颜恰与天颜似，忽误将军跪马前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4551,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其四十九","author":"王叔承","text":"诏点伶官又采诗，谱翻奇调学来迟。\n新词半是龙标尉，舞向歌前合《柘枝》。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4552,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百首（并序）（录五十首） 其五十","author":"王叔承","text":"入宫犹自服胡麻，一尺红绡写法华。\n落尽苑花空是色，藕丝轻履踏春霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4553,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金山","author":"王叔承","text":"灶宅龙宫紫气骄，壮游南北倚青霄。\n蜀江万里来春水，吴屿千寻带暮潮。\n夹岸帆樯扬子渡，隔天云树广陵桥。\n临流无限风尘思，浊酒淋漓剑影摇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4554,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渡江望金焦忆往岁与商任叔陆伯玉游兹来陆归商死矣感而有述","author":"王叔承","text":"忽破风尘梦，凄然感旧游。\n山川来往处，生死别离愁。\n沙雁青斜照，江豚黑上游。\n乾坤汝南北，无限此生浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4555,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"贞父渔大鱼未得得一獐烹之戏为短歌","author":"王叔承","text":"陈家小獐鹿无角，细草长林春濯濯。\n鱼乎未来汝登俎，头颅作羹蹄作脯。\n儿童休笑余不仁，仙家日日烹麒麟。\n渔人猎人何贤否，浮生生死不自有。\n吁嗟乎大鱼，扬鬐獐授首。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4556,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过陈济之精舍看写山水图忽听糟床酒声便敲青螺佐饮成醉","author":"王叔承","text":"山家压酒声涓涓，有如细雨鸣春泉。\n入门听此发酣兴，何须响落宫商弦。\n玉缸新碧洗盏试，青螺击破江头鲜。\n山人酒酣不自奈，胸中丘壑飞生缣。\n近来山水沈周好，人物颇称吴小仙。\n二生老死汝少年，古道肯取时人怜。\n眼前木石渠固小，天下岂少名山川。\n糟床有酒酬知己，画成换米换秫米。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4557,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"述归","author":"王叔承","text":"离家四五载，骨肉多猜疑。\n生还不自分，忽如梦与迷。\n小儿不识父，大儿惊我归。\n妻子怨离别，笑言仍嗟咨。\n此别未为久，何得生酸悲。\n明朝事行役，为余备晨炊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4558,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上巳日吴野人烹蟹及吴化父兄弟宴集","author":"王叔承","text":"前溪雨足溪水新，夜涨桃花三尺春。\n三月三日日初丽，浮玉流觞骄醉人。\n偶过杨柳桥西宅，鱼罾蟹簖当门立。\n船头活蟹紫堪击，重欲满斤阔逾尺。\n主人藏蟹真得宜，急流之下青笼垂。\n日饲稻子数百穗，枫落直过桃花时。\n蜀椒吴盐落砧细，宝刀香腻春葱丝。\n雄者白肪白于玉，圆脐剖出黄金脂。\n主人有蟹不卖钱，但逢嘉客留斟酌。\n持螯岂慕尚方珍，长对杜康呼郭索。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4559,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金山江天阁漫兴三首 其一","author":"王叔承","text":"扬子桥横落日明，瓜洲天白晚潮生。\n海云忽到金山寺，江气遥吞铁瓮城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4560,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金山江天阁漫兴三首 其二","author":"王叔承","text":"鸟外渔歌断水烟，隔江唤过打鱼船。\n鲥鱼出网鲜犹活，笑掷船头三百钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4561,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金山江天阁漫兴三首 其三","author":"王叔承","text":"夭堑悠悠尔奈何，大江南北自沧波。\n壮怀莫遣神龙笑，千古斜阳钓艇多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4562,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"箜篌引","author":"王叔承","text":"公无渡河，河不公惜。\n黄河犹可，奈此河伯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4563,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"少年行","author":"王叔承","text":"千金宝剑万金装，笑掷胡姬绿酒床。\n醉跃紫骝呼侠客，东风吹入斗鸡场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4564,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鸣玉园杂景二首 其一 鱼扈","author":"王叔承","text":"山童报新水，没到樱桃树。\n双飞跋扈鱼，冲散落花去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4565,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鸣玉园杂景二首 其二 砚洗","author":"王叔承","text":"鸲鹆洗清泉，细眼开春晓。\n金鱼吹墨花，黑却浮萍草。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4566,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答陈济之雪中见寄","author":"王叔承","text":"暮雪摇空江，美人隔烟水。\n门外寄书人，芦花裹双鲤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4567,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丁卯元日有感却寄范伯桢","author":"王叔承","text":"仙班无乃侍臣哀，龙去攀髯竟莫回。\n谁复草书封泰岳，可堪遗诏惜轮台。\n百年忽有河山变，万国重瞻日月开。\n春到定逢新礼乐，周南怜汝滞蒿莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4568,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江谣","author":"王叔承","text":"政有何苦，视虎为甚。\n妇人之言，孔子轻信。\n代王即天位，半赐今年租。\n县官勤岁课，杀人如斩荼。\n谓虎有牙，不破我家。\n谓虎有毒，不食我谷。\n麒麟凤凰，颂天济济。\n愿我皇帝陛下寿万纪，小人虽生亦蝼蚁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4569,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中与范伯桢登常照寺饮其弟仲昭书舍","author":"王叔承","text":"山雨飞花访谢连，新诗细草佛灯前。\n前身记是维摩诘，手把醍醐坐白莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4570,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"荆溪游樱桃园","author":"王叔承","text":"珠林光万点，红乱野园芳。\n艳夺桃花彩，甘骄荔子浆。\n女翻双腕白，莺溜一衣黄。\n问是谁家胜，江东顾辟疆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4571,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"石湖小天台同陆生施生兄弟","author":"王叔承","text":"石桥流水碧生凉，潭树垂阴百尺长。\n一片晚霞生谷口，羽衣如在赤城梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4572,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"济之怪余久归赋杂言解嘲二首 其一","author":"王叔承","text":"白绩含闺怨，吴蚕五月空。\n但知桑叶绿，不识茜花红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4573,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"济之怪余久归赋杂言解嘲二首 其二","author":"王叔承","text":"梁鸿无好兴，归及采桑时。\n愧汝张京兆，朝朝画翠眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4574,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金陵览古","author":"王叔承","text":"南北乾坤壮此行，西风走马石头城。\n三吴往事秋涛急，六代新愁暮雨生。\n龙虎只今余王气，江山千里护神京。\n请看丰镐艰难地，回首园陵无限情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4575,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游观音岩燕子矶因感梁王达磨故事","author":"王叔承","text":"观音高阁迥岩扉，客酒凭陵燕子矶。\n山带石城孤寺立，潮平江国乱帆飞。\n故宫木叶空金碗，荒渡芦花失宝衣。\n我亦乘风欲西逝，少林秋老白云归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4576,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"仲昭约明岁游天台雁荡先以逍遥衣见赠作张公善权二洞歌酬之","author":"王叔承","text":"范生有约登翠微，天台雁荡余当归。\n山中鹤翎堕仙氅，秋风赠我逍遥衣。\n衣作逍遥游，歌酬缥缈句。\n江帆昨泛东西九，洞府微茫在烟树。\n张公乘驴出溟渤，青山迸作神仙宅。\n幽径杳相迷，颠崖险如瑽。\n七日混沌开，千年人世隔。\n一窍深悬窈窕天，万奇乱斗玲珑石。\n药田丹灶苔花深，石床冷卧闲云白。\n西峰玉女欢相招，采芝濯足春潭碧。\n人生有足何轻弃，要与乾坤觅灵异。\n放歌醉踏荆溪船，乘兴还游善卷寺。\n涧飞白雾蛟龙巢，柱烧玄火雷霆字。\n探地窟，凌穹苍。\n徘徊两洞，百骸颠狂。\n秀乳结丹碧，宝玉扬辉光。\n下有千丈嵯峨之绝壑，鸣泉百道争赴兮，忽如汉兵十万走赵壁。\n上有瞰空倚天之陡岩，谽谺而阴森兮，恍如层宫复道秦阿房。\n老蝠为仙石为燕，山灵玉手褰衣裳。\n野人衣袂烟霞结，胜游瑰玮凭谁泄。\n苕川小范同我袍，白缣裁寄湖州雪。\n幽盟更订琅玕竹，得吴望越心难足。\n刘郎梦落赤城梁，谢生诗映龙湫瀑。\n草鞋布袜枯木瓢，身骑凤凰吹紫箫。\n武林二月桃花雨，月明夜渡钱塘潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4577,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"董节妇","author":"王叔承","text":"闽酋昔寇永丰县，董家袁妇遭兵乱。\n不惟全节全其姑，万刃交前颜不变。\n夫之母，宁独死。\n夫之兄，又请死。\n岂曰妇人惭，孝子悲，辞鬼神，慑烈气，金石开。\n妇求生姑子生母，一时争死天所哀。\n至情感贼贼敛手，谁其见之金秀才。\n董节妇，节孝两难及。\n二十守寡逾八十，寒江冻雪孤筠立。\n有孙千里来乞文，告余往事青袍湿。\n骂贼投井死亦奇，当时更有刘家妻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4578,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中看垂丝海棠","author":"王叔承","text":"江花低拂座，窈窕雨中枝。\n湿翠笼芳树，娇红袅碧丝。\n骊山清韨处，越水浣纱时。\n可奈风前态，迷春映酒卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4579,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"自钱塘由富春桐江抵七里滩同范仲昭","author":"王叔承","text":"鸣榔晓发钱塘江，波开绿酒浮春缸。\n江风吹帆三百里，青山片片随船窗。\n山头挂天根插水，两岸阴森那可已。\n游郎如坐彩云来，人家尽住瑶屏里。\n三江烟树嗟空阔，谁道龙中更奇绝。\n陡岩岚翠寒扑肌，拂手藤花洒香雪。\n荆扉女儿扬茜裙，映柳窥人半明灭。\n山村酒价不用钱，笑减青粳沽竹叶。\n风波相遇皆行迈，死生肯付乾坤外。\n采芝昨上桐君庐，占星又宿严陵濑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4580,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴江舟中赋得秋怀四首 其一","author":"王叔承","text":"千古残碑见渚沙，阖闾山碧带枯槎。\n锦城烟雨迷王国，江市笙歌半酒家。\n墓冷要离宁有剑，馆空西子尚余花。\n壮怀回首吴歈发，胥水天寒散暮鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4581,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴江舟中赋得秋怀四首 其二","author":"王叔承","text":"龙关波浪接天浮，忆昨江帆过石头。\n上国云霞高庙晚，乱山松柏孝陵秋。\n几朝大政从新主，百战奇功失故侯。\n试向镐京探往事，乾坤何得动闲愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4582,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴江舟中赋得秋怀四首 其三","author":"王叔承","text":"礼乐重开气象新，可堪词客转思莼。\n先王信有神明策，此日能无老大臣。\n水溢河渠劳饷馈，兵荒陇亩泣烟尘。\n安危早慰苍生望，万顷芦花卧钓纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4583,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴江舟中赋得秋怀四首 其四","author":"王叔承","text":"受降城下橐驼群，幕府屯田杳不闻。\n三辅干戈消白骨，九秋烽火暗黄云。\n边疆竟尔堪忧国，往昔何人议战勋。\n休道朔方元保障，健儿犹哭李将军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4584,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"席上陈稚登抱幼弟桂郎向余看月","author":"王叔承","text":"陈郎谐父执，往往诵余诗。\n抱弟灯前舞，调人学语时。\n笑看明月桂，知是宁馨儿。\n若有羊家练，淋漓醉墨遗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4585,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别益嗟","author":"王叔承","text":"往时慕游侠，尚友追昔贤。\n乃兹颇超逸，举世同所天。\n况我肝胆交，惜别能无怜。\n余归向吴会，君行入幽燕。\n烹莼脍鲈鱼，白马西翩翩。\n挥手各有期，江水闻此言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4586,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"席上戏赠益卿幼子虎儿","author":"王叔承","text":"怪是虎头痴，生儿复虎儿。\n三年声壮伟，二尺骨权奇。\n见客能觞酒，搴余问草诗。\n风尘来燕颔，尔辈已堪疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4587,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铁笛歌（有序）","author":"王叔承","text":"武昌老笛名铁龙，洪武之间来浙东。\n江湖万里忽相失，当时哭死陈家翁。\n流落人间二百秋，苍龙化去青天愁。\n子孙累世觅宗器，汉家宝剑周天球。\n或言槜李豪家得，夜夜龙光射南极。\n十年空费陈生心，购问惭无万金直。\n一朝海客持相换，生脱貂裘妇钗钏。\n合浦重归明月珠，精魂似识先人面。\n太古琅玕轻欲折，孔窍参差头尾裂。\n丹砂错落水银花，苔痕蚀尽并州铁。\n薄如藤纸枯如木，灯前三弄秋声蹙。\n万点梅花潇席寒，夜半空山扣哀玉。\n羌儿虎踞鸣塞鸿，怪蛟人立吹烟竹。\n忆昔汝祖浮洞庭，潇湘片月开黄陵。\n纯阳真人坐黄鹤，汉江绿酒倾瑶瓶。\n飘然将笛下东海，铁龙声断江风腥。\n汝今与笛竟何适，楚水吴山愁客星。\n汝祖从战鄱阳濆，佩刀曾佐高皇勋。\n叹汝飘零把孤笛，丹青竟作曹将军。\n半生我亦怀青蘋，袖来不用生龙鳞。\n不如黄鹤楼前换酒听吹笛，与君醉杀湘江春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4588,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"风雨泛太湖宿松陵长桥漫兴","author":"王叔承","text":"群飞鸥鹭逐筜祇，予亦扬帆赴杳冥。\n洒鬓湖风寒气白，打船春雨浪花青。\n水边万树来江县，云里双峰出洞庭。\n七十二桥灯火乱，野烟沽酒宿渔汀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4589,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晓过八坼","author":"王叔承","text":"残星点点照船明，敲石寒炉曙火生。\n推枕坐看江市过，梦中听得卖鱼声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4590,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿丝溪","author":"王叔承","text":"莺啼花落过江南，溪上人家尽浴蚕。\n无奈罗敷春欲老，隔桑红袖把青篮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4591,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同谢水部陈山人游虎丘王进士赠华荡酒与高家惠泉伯仲也","author":"王叔承","text":"鹅肫荡口好荼綍，朗秀娇人醉玉姿。\n却似鉴湖秋月白，纱浣石上见西施。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4592,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"王元美分守浙西书来谓乌程酒浊如泾水黑若油也戏为解嘲","author":"王叔承","text":"试问乌程第一篘，醉仙翻作酒家羞。\n三千年上探星海，未必黄河是浊流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4593,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹枝词十二首 其二","author":"王叔承","text":"白帝城高秋月明，黄牛滩急暮潮生。\n送君万水千山去，独自听猿到五更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4594,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹枝词十二首 其三","author":"王叔承","text":"一从荡子客长干，怕说风波五百滩。\n忽接家书心暗喜，更于封外写平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4595,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹枝词十二首 其四","author":"王叔承","text":"阴阴桃李晚妆迟，万里桥头叫子规。\n拜月归来人语静，金钗失在竹廊西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4596,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹枝词十二首 其五","author":"王叔承","text":"青桑老尽茜花开，新妇看蚕婆不来。\n织得西川宫样锦，机头先与小姑裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4597,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹枝词十二首 其六","author":"王叔承","text":"杨柳青青酒店门，阿郎吹火妾开樽。\n千金卖得文章去，不记当时犊鼻裈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4598,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹枝词十二首 其七","author":"王叔承","text":"兰桡小小叶为船，荡漾红妆下锦川。\n泪落清波君不见，秋风吹老并头莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4599,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹枝词十二首 其八","author":"王叔承","text":"生年十五棹能开，那怕瞿唐滟滪堆。\n郎今晒网桃花渡，奴把鲜鱼换酒来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4600,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹枝词十二首 其九","author":"王叔承","text":"点点流萤送落花，春风寂寞断琵琶。\n人来寄与菖蒲叶，说是成都造纸家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4601,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹枝词十二首 其十","author":"王叔承","text":"白盐生井火生畬，女子行商男作家。\n撞布红衫来换米，满头都插杜鹃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4602,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹枝词十二首 其十一","author":"王叔承","text":"绿酒娟娟白玉瓶，酴絪花发语猩猩。\n《竹枝》歌断人无那，十二峰头暮雨青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4603,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹枝词十二首 其十二","author":"王叔承","text":"避人低语卜金钱，侵晓焚香拜佛前。\n见说嘉陵江水恶，莫教风浪打郎船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4604,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"侠游行","author":"王叔承","text":"手搏仇心血满杯，胡姬送酒菊花开。\n朔风吹过飞龙马，弟在蓝田射虎来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4605,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西湖歌","author":"王叔承","text":"苏小坟西是妾家，门前都种白莲花。\n郎来好认当垆处，石上瑶琴覆落霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4606,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"烂溪采珠歌","author":"王叔承","text":"吴江之东双烂溪，日南合浦不足奇。\n采来溪蚌大于斗，明珠历历开光辉。\n炯如银河堕片月，群星错落流璇玑。\n绿珠含笑胡僧叹，走盘五色西摩尼。\n遂令长溪作宝市，竞抛禾黍穿沙泥。\n老渔泅波似野獭，儿童出没犹鸬鹚。\n岂无一人二人死，藏珠剖腹心相宜。\n粒珠可换米百斛，朝耕夕耨良苦为。\n是岁山西天雨黍，陇西地震山崩移。\n江南大旱珠岂无，金多谷少宁充饥。\n愚民易愚哲人惧，笑倚斜阳坐溪树。\n莫得良农半化渔，明年蚬蛤皆堪虑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4607,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"二范携酒过集周野人桂花下看陈生作画","author":"王叔承","text":"画得苕溪歌小山，青青丛桂洒松关。\n春来有酒还招隐，万片桃花水一湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4608,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"扬州歌四首 其一","author":"王叔承","text":"二十四桥边，当垆谁可怜。\n妆成窥容坐，不奈数青钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4609,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"扬州歌四首 其二","author":"王叔承","text":"东家女十三，西家女十五。\n夜半搴娘啼，嫁与并州估。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4610,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"扬州歌四首 其三","author":"王叔承","text":"罗衣束素云，绣履裹纤玉。\n低回不自前，含娇灭华烛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4611,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"扬州歌四首 其四","author":"王叔承","text":"大银万箱，广场盐万廪。\n峨峨虬髯商，日簇红儿饮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4612,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚渡西湖","author":"王叔承","text":"西湖宜晚渡，趁得采莲船。\n越女娇吴客，搴衣再索钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4613,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]