[{"title":"南园","author":"郑学醇","text":"春深燕子绕朱楼，绝代才名此胜游。\n欲吊灵均无限恨，雨花烟草路悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄怀黄长史","author":"郑学醇","text":"玉河桥畔楼头月，杨柳堤边马足尘。\n三十年前同宦意，君今犹是曳裾人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饶阳杂诗十首 其一 宿漳溪人家","author":"郑学醇","text":"绲藤编箬结幽栖，屋后高林屋下溪。\n永夜客心何处折，潇潇山雨壁鼯啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饶阳杂诗十首 其二 杨梅峒嘉靖间张酋山结寨于此","author":"郑学醇","text":"沿洄深涧尽磁窑，云碓声中马去遥。\n寂寞旧时豺虎窟，隔林初见一人樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饶阳杂诗十首 其三 滥潭","author":"郑学醇","text":"断蓬衰草匝江皋，点点鸬鹚下小舠。\n入夜冱寒人语少，满滩烟水月轮高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饶阳杂诗十首 其四 三河","author":"郑学醇","text":"岐水分流浅更寒，市廛鳞次贩艘团。\n黄旗闪闪横江出，闻说征钱是宰官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饶阳杂诗十首 其五 程江驿","author":"郑学醇","text":"江城孤月两重圆，襟枕频移只在船。\n谁遣梅花中夜落，数声横笛小楼前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饶阳杂诗十首 其六 高坡道中","author":"郑学醇","text":"至后寒山纷落木，夕阳茅屋几炊烟。\n天涯容易愁孤客，莫更西风送断猿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饶阳杂诗十首 其七 黄竹坪","author":"郑学醇","text":"黄竹坪前日向低，茂林归鸟各争栖。\n峰峦不尽秋云色，家在罗浮四百西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饶阳杂诗十首 其八 龙川怀古","author":"郑学醇","text":"当时秦鹿走中原，犹有东南一尉存。\n今日霸图何处是，冷烟荒草旧城垣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饶阳杂诗十首 其九 东衢逆旅","author":"郑学醇","text":"疋马西来腊月馀，扬鞭崎岭又通衢。\n丹枫夹道行人度，只少梅花似大庾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饶阳杂诗十首 其十 晓发清溪","author":"郑学醇","text":"雨色连江曙未分，萧萧蓬底客先闻。\n归裴不羡虞卿璧，留得桐丝伴水云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高凉杂诗十首 其一 珠江晚发","author":"郑学醇","text":"布帆江上挂晴霞，谁遣东风换物华。\n回忆故园今夜月，曲栏开到几枝花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高凉杂诗十首 其二 吴川馆中","author":"郑学醇","text":"海涛声沸梦魂知，欹枕听鸡晓漏迟。\n寒雨半襟风不定，短墙低压小桃枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高凉杂诗十首 其三 卢三邀酌酒楼","author":"郑学醇","text":"椰叶蒙茸覆酒床，清歌一曲压君觞。\n醉中欲忌身为客，梦里那知又故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高凉杂诗十首 其四 卖花墟","author":"郑学醇","text":"路傍秾艳一枝新，送尽东风去马尘。\n半似胡姬年十五，垆头沽酒与游人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高凉杂诗十首 其五 采葛妇","author":"郑学醇","text":"春深谷口共腰镰，芒刺时忍玉手纤。\n谁信吴王宫宴罢，梦回犹惜夜厌厌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高凉杂诗十首 其六 雨次大墟","author":"郑学醇","text":"空濛烟雨湿行囊，却算前期驿路长。\n欲向旗亭呼一醉，鹧鸪声易断人肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高凉杂诗十首 其七 阳江道中望海上诸山","author":"郑学醇","text":"立马遥看澹复浓，青天半插玉芙蓉。\n来时烟雨归晴暖，尽出东南几百峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高凉杂诗十首 其八 过莲池","author":"郑学醇","text":"日暖平原烟草低，閒花开满短亭西。\n芳菲总属东风管，一路繁香送马蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高凉杂诗十首 其九 热池","author":"郑学醇","text":"岗峦百匝一池开，气焰薰蒸湿草莱。\n却忆骊山山下路，春深曾赐锦铺来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高凉杂诗十首 其十 过院村","author":"郑学醇","text":"晴沙皛皛带荒村，水满町畦蝶满园。\n似是庞公此真隐，竹松深处有柴门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀古迹十首 其一 陆贾城","author":"郑学醇","text":"郊原漠漠草烟平，此地犹传汉使名。\n黄屋岛夷今泯灭，寒潮惟送月华明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀古迹十首 其二 玉液池","author":"郑学醇","text":"含珠亭倚郡城西，草树连天拂玉堤。\n宫女兰桡初倦戏，采菱歌断曜灵低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀古迹十首 其三 昌华苑","author":"郑学醇","text":"作阵鸾旗拂海霞，荔枝湾下即昌华。\n刘郎一去无消息，长尽蘋花与稻花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀古迹十首 其四 芳华苑","author":"郑学醇","text":"旧苑荒台古刹边，桃花临水尚依然。\n只今野鸟啼春急，半似当时闹管弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀古迹十首 其五 甘泉苑","author":"郑学醇","text":"甘泉苑傍韸韸水，荡漾曾经画舸回。\n异代繁华无处觅，木绵开更刺桐开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀古迹十首 其六 花田","author":"郑学醇","text":"花田一带汉宫斜，花露浓浓泣岁华。\n艳骨怨魂俱不散，顾随侯馆化丹砂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀古迹十首 其七 华林园","author":"郑学醇","text":"青山叠叠树行行，花坞犹存号半塘。\n此日芳菲谁管领，可怜红紫斗新妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀古迹十首 其八 月华楼","author":"郑学醇","text":"金波遥映月华楼，佳色偏宜永夜游。\n玉魄年年长在望，照残芳杜满汀洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀古迹十首 其九 呼鹰道","author":"郑学醇","text":"歌舞岗前谷变陵，秋深狐兔待呼鹰。\n崖头细菊临风倚，不管人间有废兴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀古迹十首 其十 朝元洞","author":"郑学醇","text":"朝元洞口接禺山，鸾鹤回翔杳霭间。\n风景依稀时代异，夕阳长羡钓舟閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚戌九月将有浙行舟泊穗城怅然有作","author":"郑学醇","text":"木落转深秋，衣轻怯远游。\n层城烟渐暝，孤树鸟先投。\n灯影乱流水，筝声多酒楼。\n悠悠吴楚去，何处是严州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石门阻雨","author":"郑学醇","text":"凉雨夜潇潇，寒江暗上潮。\n感时堪泪尽，别路易魂销。\n有梦悬青雀，无心问黑貂。\n惟应待明发，渐与故山遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"从挂榜山步至黄塘","author":"郑学醇","text":"十里黄塘路，青鞋信杖藜。\n沙回笼岸尽，山迥羃云低。\n衰草寒螀歇，荒榛暮鸟啼。\n野桥清浅处，疑涉浣花溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水西驿","author":"郑学醇","text":"章江江上驿，乘月且维舟。\n灏气兼天迥，滩声入梦流。\n路遥书断雁，风起浪惊鸥。\n忆得乡园里，清光正满楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"剑江驿","author":"郑学醇","text":"何年台斗上，紫气结龙文。\n江汉川流合，衡庐地势分。\n鸡声催曙月，雁语隔重云。\n潇飒深秋意，偏教旅客闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15142,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"滕王阁","author":"郑学醇","text":"帝子来南国，临江构此楼。\n人随歌舞去，滕自古今留。\n槛静绮霞散，江深璧月浮。\n少年登览地，犹得赋重游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15143,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿永泰寺","author":"郑学醇","text":"寒灯依古刹，兹夕益凄其。\n别路五千里，归心十二时。\n臈残春气近，计拙梦魂知。\n惟有疏梅月，临窗映一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15144,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清远道中朱荆玉携酒同弟学张懋纬承宰承藻承衮送至东林寺","author":"郑学醇","text":"寺下长江澹不流，寺边秋色拥行舟。\n裘非紫绮劳相问，会有青樽慰远游。\n伐荻此时聊晤语，班荆何日重淹留。\n悬知后夜遥相忆，雪满苍山月满楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15145,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"储潭庙","author":"郑学醇","text":"虔州西北有储潭，潭外千峰净翠岚。\n古庙尚题灵雨颂，断碑犹纪使君衔。\n塞鸿欲度风偏急，宿霭初收日半含。\n行客不须嗟岁暮，计程春色又江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15146,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪浪阁","author":"郑学醇","text":"杰阁岧峣瞰碧流，江山佳胜昔年游。\n灵幡静拂青螺岫，绛阙遥临白鹭洲。\n九泽云閒仙鹤曙，重潭天醮老龙秋。\n青苍景物依然在，山月松风事事幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15147,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"草萍古驿","author":"郑学醇","text":"寒风吹雨欲成花，远道行人倍忆家。\n地拆东南分楚越，路从台斗望京华。\n松林蔚蔚依山转，麦垄青青逐涧斜。\n暝色渐看城郭近，女墙官树遍栖鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15148,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浙河春望","author":"郑学醇","text":"东风吹暖拂缨尘，草树依微入望新。\n绣陌晓嘶金勒马，画帘春倚玉楼人。\n阳和喜就他乡色，迟暮偏怜拥褐身。\n烟景五湖天共远，断肠归雁数声春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15149,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别唐使君","author":"郑学醇","text":"千山回合富春城，牢落那堪越客情。\n七里滩边残雪色，两高峰外暮潮声。\n风尘念我孤蓬迹，雕鹗看君万里程。\n燕市旧游他夕梦，短篷新月向人明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15150,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答潘子迁用韵","author":"郑学醇","text":"翩翩青苧带风斜，绿酒红亭不待赊。\n邂逅喜深还赋别，倦游人老更辞家。\n瑶空欲堕歌中雪，綵笔犹悬梦里花。\n烟水苍茫孤棹远，酷怜秋色满江涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15151,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答潘幼则用韵","author":"郑学醇","text":"秋风雁度浙河西，远访严陵旧钓溪。\n三尺素琴挥别调，数行纨扇寄新题。\n同游久自思陶谢，狂态惟应托阮嵇。\n安得重携问春信，绿杨阴下络偏提。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15152,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀寄梁先仰","author":"郑学醇","text":"袅袅秋风吹薜萝，忽惊新雁度金河。\n千山月色离魂黯，一夜秋声病枕多。\n促织吟寒催短鬓，疏砧敲曙怨青娥。\n瑶华满地还堪搴，欲寄相思奈远何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15153,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浈江对月","author":"郑学醇","text":"越水吴山路渺漫，孤舟偏觉别程难。\n愁心莫对清霄月，添得游人两鬓寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15154,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凌江夜泊","author":"郑学醇","text":"北去南来类转蓬，浮生何处定萍踪。\n孤舟凌水醒残梦，三十年前此夜钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15155,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"章江阻雨","author":"郑学醇","text":"章水西流转北来，计程明日郁孤台。\n寒风急送千峰雨，心折庾关几树梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15156,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别东阳许生","author":"郑学醇","text":"谁遣相逢又解携，数声南雁楚云低。\n津亭望入华山路，一片征帆弋水西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15157,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉山城南杨家水楼对月","author":"郑学醇","text":"怀玉山头月半轮，江风畟畟水粼粼。\n不知桂阙寒多少，剩有寒辉照远人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15158,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉山河","author":"郑学醇","text":"绿静春江似鸭头，半涵山色半侵楼。\n归心暗与流争急，亟就长年问去舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15159,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮桥阻雪","author":"郑学醇","text":"北风吹雪暗江头，逗夜连朝尚未休。\n怪得榜人关不度，拢船偏傍酒家楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15160,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清溪驿","author":"郑学醇","text":"一带平芜合浅沙，荆榛深处几人家。\n江风偏与南来客，归棹齐讴扎扎鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15161,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度岭寄梁茂伯潘良诏君理崇彦诸丈","author":"郑学醇","text":"梦里还家不当真，梅花欲放岭头春。\n乡园此去千馀里，关外难逢寄信人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15162,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观迎春","author":"郑学醇","text":"腊尽春回暖尚遥，官河冰结未全消。\n喧阗箫鼓迎将去，只为长堤换柳条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15163,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杜鹃花","author":"郑学醇","text":"春来无处不芳菲，何独南漪品格稀。\n孤客却疑花解语，向人频道不如归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15164,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水岸桃花","author":"郑学醇","text":"几枝临水复临堤，灼灼东风日又低。\n莫倚晚霞争艳色，春光强半雨中迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15165,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"由瑞虹抵沿山河三首 其一","author":"郑学醇","text":"北风吹断蓬，寒云暗四野。\n四野何茫茫，江流迅如马。\n野草被严霜，荣枯不相假。\n疆域日以殊，远客何为者。\n坎凛怆中怀，悲歌泪如写。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15166,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"由瑞虹抵沿山河三首 其二","author":"郑学醇","text":"严冬何凛冽，玄云结层阴。\n寒雨中夜零，游子怀重衾。\n愁绪本无端，展转自相寻。\n相彼孤栖鸟，依依望故林。\n行行日以远，所托惟声音。\n声音不可托，何用慰人心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15167,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"由瑞虹抵沿山河三首 其三","author":"郑学醇","text":"天地本蘧庐，光阴成过客。\n人生惟百年，而谁能满百。\n良时不尽欢，容华枉抛掷。\n采葛怀三秋，况此三秋隔。\n举目尽途人，安知胡与貊。\n行行但来归，无为久离索。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15168,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晨发富春渚","author":"郑学醇","text":"晨发富春渚，夕息兰溪阴。\n理棹即湍险，极目眺岖嵚。\n凄凄百卉腓，噭噭哀鸿音。\n山川岂不遥，霜霰亦已侵。\n拳拳怀旧欢，离思浩难任。\n节往戚不浅，感来念愈深。\n麋鹿有至性，丰草与长林。\n固穷守昔训，无闷何独今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15169,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋空月","author":"郑学醇","text":"明月悬秋空，皎皎临窗牖。\n望之不可亲，掔之不去手。\n一回圆缺一回新，清光大地皆应有。\n居人见月思远人，远人见月将归否。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15170,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七里滩","author":"郑学醇","text":"富春之滩名七里，锦峰绣岭重重峙。\n祠耸长林古木中，舟行两岸猿声里。\n汉家九鼎赤符新，滩上一丝人独理。\n千载高风清客心，半滩明月一篙水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15171,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖五十韵","author":"郑学醇","text":"天目垂双乳，西湖注百泉。\n霞标千嶂迥，烟水六桥联。\n络绎欢游骑，笙歌罨画船。\n玉楼花掩映，石路草葱芊。\n月迥重潭静，风轻一镜涟。\n綵丝移雀舫，红袖出鞦韆。\n柳色迷歌扇，蘋香龙舞筵。\n两高飞晓日，三竺隐诸天。\n月路飘金粟，商飙拂绣莲。\n老猿呼袅袅，归鹤绕蹁蹁。\n梅点孤山雪，松霏九里烟。\n层城开水际，危塔倚山巅。\n石转惊神运，崖穹讶鬼镌。\n钟微知寺远，锣动速舟还。\n苏小妖魂在，西施黛色妍。\n风流唐白傅，放逸宋坡仙。\n和靖成真隐，参寥却解禅。\n古今人屡异，兴废事空传。\n勾践谋资蠡，婆留姓是钱。\n封疆重启霸，吴越一王专。\n南渡偏安日，仁和驻跸年。\n乾坤馀王气，罗刹定都廛。\n邀福延祥观，宸游聚景园。\n湖山多逸豫，舸舰几流连。\n宫嫔珠帘揭，篙师锦缆牵。\n暖风喧凤吹，香雾滃龙涎。\n宋嫂羹初进，蕲王赐屡宣。\n繁华三岛外，弦管五云边。\n北虏通和议，东窗弄杀权。\n精忠哀武穆，慷慨羡胡诠。\n覆餗仍秋壑，残躯殒木绵。\n半閒堂已矣，水乐洞依然。\n白雁江南过，黄龙瘴海膻。\n故宫沦蔓草，垄树泣啼鹃。\n事往千秋慨，奇游此日偏。\n山川真画里，景物值春先。\n堤柳霜凋尽，山花烧共燃。\n惊鸿遵荻渚，振鹭起葑田。\n鹫岭寒云薄，西泠澹月悬。\n渔灯依岸曲，城角倚风前。\n怀土非王粲，樗材老郑虔。\n客途嗟浪迹，岁月负华颠。\n真长船谁问，王猷兴转遄。\n归装无白璧，旧物有青毡。\n古调琴三尺，缥囊易一编。\n倚歌徒和郢，醉筑尚思燕。\n岂必求勾漏，宁须候偓佺。\n浮生随所遇，真性讵能迁。\n浈水程三月，庾关路几千。\n何因湖外寺，时借上方眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15172,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五游诗 其一","author":"郑学醇","text":"我思游兮泰山，天孙标胜东齐间。\n上有丈人千丈之突兀，下有黄河一带之萦环。\n秦封汉策秘不可睹，石闾金阙窅而难攀。\n安得采芝二童为我导，坐观海日赤腾空洞开心颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15173,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]