[{"title":"厓山大忠祠 其二","author":"李东阳","text":"北风吹浪覆龙舟，溺尽江南二百州。\n东海未填精卫死，西川无路杜鹃愁。\n君臣宠夺三朝共，夷夏兴亡万古雠。\n若遣素王生此后，也须重纪汉春秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35202,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送平江伯陈公漕运还淮安二首 其一","author":"李东阳","text":"贤劳三世服王家，千里山川道路赊。\n周甸土中南北贡，汉河天上往来槎。\n晨挥玉麈风生座，夜拂银灯剑有花。\n闻说江淮多故老，风流皆作祖侯誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35203,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送平江伯陈公漕运还淮安二首 其二","author":"李东阳","text":"朝廷漕运仰南东，百里关河属会通。\n胜国封疆还蓟北，西山泉派出城中。\n舟车坐惜千金费，畚插虚劳累岁功。\n犹有腐儒忧国念，欲将经国问元戎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35204,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"世贤双生一子夭死慰之以诗","author":"李东阳","text":"城东瓜熟子离离，长向西园记送时。\n正爱春风联蒂好，坐看寒雨一枝垂。\n人生得意难为乐，造物何心亦妒奇。\n从此柯条终远大，为君重诵古绵诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35205,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送崔指挥谦漕运还大河","author":"李东阳","text":"滞雨浓云黯不收，漕歌声动木兰舟。\n星稀禁阙天初霁，水落长淮地始秋。\n国计已随山共积，乡心应寄雁深愁。\n山南后裔声名在，要识清朝有壮猷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35206,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重谒茂陵","author":"李东阳","text":"寝树寒声起夜飔，载闻清庙有歌辞。\n鼎湖已逐群龙化，周驭空传八骏驰。\n千古山川神陟地，三年祥禫礼成时。\n微臣亦抱劬劳恨，万事伤心忍赋诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35207,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟发张家湾宿河西务","author":"李东阳","text":"苍茫正合尘中眼，缥缈真乘水上舟。\n江月海云疑是梦，画图诗卷坐消忧。\n沙边细浪随鸥鸟，树里青山入柁楼。\n行尽驿亭三百里，五更风急住滩头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35208,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"早发沧州","author":"李东阳","text":"片帆轻舸发沧州，野树离离散不收。\n两地伤心河上草，一灯残梦渚西楼。\n尘生晓市人烟集，雾拥春城水气浮。\n我欲凭高问归雁，潇湘何处可维舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35209,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登雨花台","author":"李东阳","text":"高台欲上雨濛濛，虎踞龙盘在眼中。\n万古青山还洛下，一丘黄壤自江东。\n谢公着屐何曾到，梁武谈经亦已空。\n好是五陵歌酒地，年年芳草恨春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35210,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游金山寺","author":"李东阳","text":"楚䌫吴樯万里还，梦魂长在水云间。\n境当绝胜多逢寺，江到中流合有山。\n鹘岭高秋增突兀，龙宫深夜锁潺湲。\n谢公无限登临兴，不为苍生暂解颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35211,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与隆平侯张公宣城伯卫公游灵应观","author":"李东阳","text":"小有天高岂易攀，珠宫元不隔人寰。\n潭龙抱雾晴犹黑，庭鹤梳风午正閒。\n过岭松声闻淅沥，卷帘山色见孱颜。\n青童两两清如玉，缓听仙歌满树间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35212,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"是日庄孔阳司副自江浦来会夜宿江上次明仲韵","author":"李东阳","text":"黑发相逢是壮年，别来心绪转茫然。\n如何绿酒孤篷夜，正在黄花九日前。\n笑我远同江浦雁，看君清比定山泉。\n江流恨不归西北，回首荒城万树烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35213,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过丁字沽","author":"李东阳","text":"十月南风不受呼，须将短日赴长途。\n僧钟已及午时饭，官舫才过丁字沽。\n新月此回真见汝，故乡何处尚迟吾。\n关河百里南来雁，欲问平安有字无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35214,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"天津","author":"李东阳","text":"玉帛都来万国朝，梯航南去接天遥。\n千家市远晨分集，两岸沙平夜退潮。\n贡赋旧通沧海运，星辰高象洛阳桥。\n河山四塞喉襟地，重镇还须拥使轺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35215,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次日大雨入夜喜而有作","author":"李东阳","text":"打窗鸣雨忽来过，坐听欢呼杂棹歌。\n沙口渡喧人语乱，柁头风急水声多。\n尘心最渴真消得，农事虽宜奈晚何。\n七十二泉云雾里，可能流润入官河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35216,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杂画绝句","author":"李东阳","text":"雪满千山路，茅堂只数椽。\n幽人与脩竹，相对不知年。\n春岸桃花开，江头夜来雨。\n借问垂钓翁，中流深几许。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35217,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杂画二绝 其一","author":"李东阳","text":"稚子牵衣泣，邻翁答语喧。\n归人定何处，风物似羌村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35218,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杂画二绝 其二","author":"李东阳","text":"地僻长宜静，郎潜亦爱贫。\n贫家不酿酒，自有问奇人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35219,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题李伯时莲社图","author":"李东阳","text":"谁写庐山十八贤，白头居士老龙眠。\n药囊经卷随行杖，知在香炉瀑布前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35220,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"商山图","author":"李东阳","text":"行尽商山觅紫芝，不应名姓有人知。\n閒来共说人间事，楚汉分明一局棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35221,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游春图 其一","author":"李东阳","text":"三月江头花满枝，春光物物总宜诗。\n杜陵野客犹多兴，不是潜行痛哭时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35222,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游春图 其二","author":"李东阳","text":"渚兰汀草乱春愁，病里何心更出游。\n独立斜阳溪上望，采芳人在白蘋洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35223,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题崔甥画卷","author":"李东阳","text":"谷口长松涧底藤，石桥山路晚登登。\n囊琴斗酒来何暮，空负寒斋昨夜灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35224,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戴胜","author":"李东阳","text":"园中少妇把桑归，掩袖低眉半落晖。\n羞见山禽头似锦，茧丝缲尽不成衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35225,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画","author":"李东阳","text":"十日雨多不出门，今日出门云雾昏。\n扁舟欲往恐无路，何处青山江上村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35226,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春在","author":"李东阳","text":"雁去平江烟水空，短蒲脩竹自成丛。\n东风一片沧浪梦，春在潇湘细雨中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35227,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"林郎寒鸦图","author":"李东阳","text":"万里长空倦羽翰，野风残雪岁将阑。\n纷纷燕雀高飞尽，独宿空林一夜寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35228,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"墨竹","author":"李东阳","text":"翠佩瑶环昨夜风，渚云飞尽楚王宫。\n青娥舞罢婆娑曲，人在空山月影中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35229,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画瓜","author":"李东阳","text":"玉盘秋露水精寒，冰齿馀香嚼未残。\n暑月为君清到骨，不知身在画中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35230,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画菜","author":"李东阳","text":"坐怜幽意满閒庭，长见春畦过雨青。\n记得苏郎旧风味，雪堂中夜酒初醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35231,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"墨牡丹二绝 其一","author":"李东阳","text":"老来青帝亦风流，年少花王正黑头。\n共忆东风旧游路，乱红残紫不胜愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35232,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"墨牡丹二绝 其二","author":"李东阳","text":"净洗浓妆不受尘，墨池清赏称诗人。\n休怜一朵扬州白，犹是烟花梦里身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35233,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画","author":"李东阳","text":"步屧空林散夜凉，断桥斜带入溪霜。\n仙家晚饭无烟火，犹记山中石髓香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35234,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白头翁图","author":"李东阳","text":"名园芳事入新年，绣羽无声意共传。\n可是春风消不得，白头如雪对花前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35235,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画马","author":"李东阳","text":"野花开尽紫骝嘶，老树风高落日低。\n十载沙场无一战，老来林下齧霜蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35236,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"弃瓢图","author":"李东阳","text":"至人于物本忘情，瓢系犹嫌树里声。\n应是向来新洗耳，个中听得更分明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35237,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梅月图","author":"李东阳","text":"清溪倒影入空寒，月色梅花共一般。\n夜半落英看不见，暗风吹堕玉栏干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35238,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画蝶","author":"李东阳","text":"度竹穿花处处心，暖风晴浪影浮沉。\n亦知春去无多日，犹在花丛与竹阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35239,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戴胜","author":"李东阳","text":"五月桑园叶再生，吴蚕初熟暑风清。\n山禽一夜头如锦，贫女缲丝尚未成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35240,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"沈石田山水","author":"李东阳","text":"翠竹碧桐秋气高，洞庭南望俯亭皋。\n怪来落叶兼风下，知是幽人读楚骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35241,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画松为卜刑部从大题","author":"李东阳","text":"玄云匝地黯无辉，老干盘空势不归。\n疑是叶家堂上见，夜深风雨墨龙飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35242,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟次奉新驿得戴侍御同年书知于前驿相待漫得一绝","author":"李东阳","text":"一棹江南本旧期，宦途多事独栖迟。\n东风几度停舟意，惟有春潮夜夜知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35243,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"浦桥得浅","author":"李东阳","text":"落日芳村无犬声，风沙两岸断人行。\n须为系䌫空林下，坐看前溪春水生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35244,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"疾风捲高冈","author":"张泰","text":"疾风捲高冈，吹折梧桐树。\n惊起双凤皇，分飞隔烟雾。\n遗雏落平沙，白日声载路。\n生为失皇母，嗷嗷向谁哺。\n凤去朝蓬莱，悲鸣几回顾。\n念谁将此曲，谱入瑶琴诉。\n持以勖初心，无令间新故。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35245,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夕","author":"张泰","text":"秋风向东发，夕日仍西斜。\n呜蝉恋馀暑，归鸟背残霞。\n游子在京邑，挂剑悲物华。\n珍重故山月，飞来此天涯。\n流光劝卮酒，潦倒还忆家。\n迢迢江海梦，泛泛星河槎。\n道逢采香女，为余止浩嗟。\n君看桂枝露，滴着芙蓉花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35246,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"菊陂卷","author":"张泰","text":"摇落众芳歇，其如秋兴何。\n颓然倚閒庭，丛菊满前坡。\n秀色引佳气，日夕南山阿。\n和露餐落英，陟霜生繁柯。\n风际展清酤，灵芬忽来过。\n永契君子心，迟暮非蹉跎。\n未应辍雅操，聊复竟此歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35247,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题友兰卷","author":"张泰","text":"褰裳涉芳涧，抱杖凌幽岑。\n丛兰似相引，流香被岩阴。\n光风吹紫茎，一笑谐素心。\n憩兹青苔石，为弹朱丝琴。\n楚调得新赏，鲁弦有知音。\n日暮不能别，佩之间重襟。\n永言托末契，市道空黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35248,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月出古城东","author":"张泰","text":"月出古城东，照我白玉堂。\n桂树下秋影，兰英团露光。\n焚香坐清夜，灭烛移银床。\n皎皎美人意，相思何可忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35249,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"萱草生竹间","author":"张泰","text":"萱草生竹间，幽根相屈盘。\n虚通美人意，秾悦此君颜。\n庭隅会别鹄，堂背栖双鸾。\n愿结连枝好，忘忧至岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35250,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜言怀","author":"张泰","text":"凉风入我室，灯影动虚幌。\n不知秋虫名，惟聆四壁响。\n永夜清寡寐，悒郁怀宿恙。\n自非乔松质，敢骛八极想。\n托梦游神仙，聊用超世网。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35251,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄梧塍徐尚贤","author":"张泰","text":"新秋时雨霁，夕景月华续。\n凉轩念吾契，一别几寒燠。\n风露摇琴丝，清凄不成曲。\n永怀池阁夜，文酒欢未足。\n山川动为阻，飞翰徒盈束。\n何当觏之子，锦陌秋衣绿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35252,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寒宵曲","author":"张泰","text":"芙蓉露冷飘香玉，风袭湘帘弄红烛。\n银屏围护佩珰声，翡翠楼中人独宿。\n铜壶水涩秋点长，窥窗缺月侵象床。\n起拈金剪指生雪，素罗无光纨段香。\n床前欲写相思意，呵冻冰毫不成字。\n梅花消息几时来，翠鸟无声蝴蝶死。\n兰薰不温眠未能，锦衾叠拥鸳鸯绫。\n晓鸦啼醒少年梦，枕前泪积珊瑚冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35253,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"用韵答陈克敬杏花下作","author":"张泰","text":"春来几花开过春，几人复为花主人。\n临流问花花不语，一片已堕青溪蘋。\n我有春词为花发，韶华瞥眼春江雪。\n花时不抱花影眠，孤负青天送明月。\n谪仙供奉一生中，吟花醉月愁樽空。\n风流亦欲追清赏，来趁君家山杏红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35254,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画马","author":"张泰","text":"圉人浴马龙河津，缓舆脱衔龙性驯。\n缥鬣初晞汉庭日，霜蹄忽踏吴洲春。\n未论千万与百里，但有雄才报知己。\n一跃空群东海头，昆崙阊阖还尔游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35255,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"七夕词","author":"张泰","text":"璚宫玉露消残暑，才过七夜凉如许。\n广庭儿女巧盘开，瓜水绣针香作缕。\n上楼斜月捲帘轻，烟霄几处人歌舞。\n清寒渐入宫中树，六宫不眠看牛女。\n隔河如渡彩云輧，惭恨素娥谁伴侣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35256,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夕","author":"张泰","text":"醉起茅斋夜，虚檐露气清。\n水摇疑月动，云过觉星行。\n疏草鸣蛩切，寒枝宿鸟惊。\n有怀眠未得，独坐数残更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35257,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"?声","author":"张泰","text":"谁家寒意早，夜急捣衣声。\n少妇闺中力，征夫马上情。\n野风吹断续，关月伴凄清。\n愿与将军听，开边暂息兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35258,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"徐沛道中","author":"张泰","text":"潇条徐泗路，野望少人烟。\n瘦马嘶长坂，饥乌落远田。\n叶声秋树里，帆影夕阳边。\n便合乘轻舸，沿流上济川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35259,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送胡器美","author":"张泰","text":"立马燕台暮，长歌一送君。\n高枫明夕照，远雁没寒云。\n赠别那无剑，论交自有文。\n骅骝宁久屈，千里会空群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35260,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送人归越中","author":"张泰","text":"骝马踏芳尘，朝珂散紫宸。\n自沽燕市酒，相送越溪人。\n碧盎川光霁，青归野色春。\n官桥柳初发，莫遣赠行频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35261,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"睡起","author":"张泰","text":"睡起东堂晓，浮云竹外晴。\n鸟随朝色动，蛙续雨声鸣。\n盥栉缘诗懒，轩窗展卷清。\n祗应贫与病，相称此閒情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35262,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏夕","author":"张泰","text":"林居多晚兴，袗绤对清觞。\n野竹漫藏坞，溪云低亚墙。\n一星萤照夜，数点雨生凉。\n远近藕花发，逼人秋梦香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35263,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中闻鼎仪翰友归近","author":"张泰","text":"五年滨海卧，思见故人难。\n忽报青绨近，都忘白纻寒。\n翻书符昨梦，觅酒待新欢。\n犹恨西江雨，深秋阻木兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35264,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夕鼎仪池上","author":"张泰","text":"醉起北林夕，重过即旧游。\n浅波双鹭宿，深竹数萤流。\n袅袅风烟暮，娟娟月露秋。\n病怀宜此景，消得故人留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35265,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"竹林书屋","author":"张泰","text":"竹里巢栖隐，萧然君子居。\n清风蒋生径，古意邺侯书。\n凤宿寒灯外，芸香春笋馀。\n惟应过三益，著论辟玄虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35266,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"腊月二日舜咨席各赋","author":"张泰","text":"故人敦宿好，残岁合馀欢。\n节序从渠暮，交盟不尔寒。\n风前凭玉树，霜际浥丛兰。\n吟动先春兴，清觞未可乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35267,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送徐仲山主事山东管泉","author":"张泰","text":"水部分司地，君行得所便。\n道心东望鲁，国计北通燕。\n退扫探元化，行吟俯逝川。\n平生四海意，从此达㳙㳙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35268,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"六日初斋夕偶成","author":"张泰","text":"素幔隐红毡，神清夕未眠。\n春星窥牖入，宫漏隔街传。\n树影旧房月，茶香新汲泉。\n斋居此风景，容易见年年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35269,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春雪用韩文公韵","author":"张泰","text":"闰月何多雪，閒居每一谣。\n剩寒欺乍暖，暴积继前消。\n任使山增势，休令竹折腰。\n花拘将艳蕊，柳抑半青条。\n鸟食迷原野，人踪减市桥。\n玲珑疏树映，宛转小风摇。\n冷过听莺日，晴思堕马朝。\n藉冰衣免污，伏枕梦犹飘。\n清绝怜披氅，风流忆舞绡。\n却须暄节健，宜瑞不宜饶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35270,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]