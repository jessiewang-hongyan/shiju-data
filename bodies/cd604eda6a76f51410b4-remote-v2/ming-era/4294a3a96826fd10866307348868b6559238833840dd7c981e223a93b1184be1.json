[{"title":"复次前韵十二首 其六","author":"江源","text":"玉臂锋封旧守宫，鸾舆消息一番空。\n绣床徙倚无寥赖，强刺花枝几线工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52176,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"复次前韵十二首 其七","author":"江源","text":"宝髻慵簪石竹花，温泉分得洗铅华。\n舞衫歌扇都抛却，拟向君前请出家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52177,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"复次前韵十二首 其八","author":"江源","text":"西风无地不伤秋，谖草翻阶不疗愁。\n欲籍鳞鸿通尺素，可能今夕见灵修。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52178,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"复次前韵十二首 其九","author":"江源","text":"宝幄璚楼玳瑁宴，一身曾拟当三千。\n如今别却昭阳伴，敢道君恩不及前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52179,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"复次前韵十二首 其十","author":"江源","text":"水咽铜龙书漏沉，白华三复想遗音。\n主恩难报惟深省，众口从严解烁金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52180,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"复次前韵十二首 其十一","author":"江源","text":"留得双龙旧绣衾，恩光不照妾愁深。\n谁人侍寝昭阳殿，一刻春宵抵万金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52181,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"复次前韵十二首 其十二","author":"江源","text":"自悼词成不待封，闲情恋思万千重。\n青春肯为红颜驻，转眼风光又夹钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52182,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词次邵汝学韵八首 其一","author":"江源","text":"咫尺长门限玉墀，春风辇路长苔衣。\n花边日落帘栊暮，闲看双双燕子归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52183,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词次邵汝学韵八首 其二","author":"江源","text":"尽日深宫不卷帘，玉颜何用斗春妍。\n君王剩有关睢化，枉费长门买赋钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52184,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词次邵汝学韵八首 其三","author":"江源","text":"罗幕风惊午梦回，金车何处隐如雷。\n起来颠倒衣裳甚，只恐君王更一来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52185,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词次邵汝学韵八首 其四","author":"江源","text":"夙抱衾稠分所宜，深宫何敢怨春迟。\n东风自是无私物，开到棠梨第几枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52186,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词次邵汝学韵八首 其五","author":"江源","text":"翟衣初赐带天香，隆宠难酬袜线长。\n补得山龙新御衮，十年针黹敢辞忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52187,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词次邵汝学韵八首 其六","author":"江源","text":"十载端居禁蓹深，玉颜虚掷此光阴。\n君前未献鸡鸣什，负妾平生犬马心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52188,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词次邵汝学韵八首 其七","author":"江源","text":"盛衰颜色即炎凉，羞作当时半面妆。\n饥火静消心似水，平阳歌舞任他忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52189,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词次邵汝学韵八首 其八","author":"江源","text":"晚凉无伴独登台，望断羊车不一来。\n不是君王不相顾，贾生前度正徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52190,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十二月词十二首复次官汝清韵 其一","author":"江源","text":"人日宫中最喜晴，玉肌寒怯尚重绫。\n霎时又是元宵节，台谏何人论买灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52191,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十二月词十二首复次官汝清韵 其二","author":"江源","text":"报道中和节又来，东风新燕旧亭台。\n妾颜不似去年好，羞见百花红白开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52192,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十二月词十二首复次官汝清韵 其三","author":"江源","text":"春困撩人睡起迟，玉钗斜堕绿云攲。\n海棠开后廉纤雨，又是清明赐火时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52193,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十二月词十二首复次官汝清韵 其四","author":"江源","text":"南薰别殿绿阴浓，浴佛香汤赐六宫。\n太液池边随步辇，白莲花吐石榴红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52194,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十二月词十二首复次官汝清韵 其五","author":"江源","text":"五月宫中日最长，天中节近浴兰汤。\n君王不用青铜献，惟恨当年一鉴亡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52195,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十二月词十二首复次官汝清韵 其六","author":"江源","text":"金屋炎炎溽暑深，温泉新水浴檀沉。\n那知玉趾帘帷外，不赐当年百饼金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52196,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十二月词十二首复次官汝清韵 其七","author":"江源","text":"桐叶初飘大火流，待看织女会牵牛。\n傍人不织浓心苦，才过伤春又到秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52197,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十二月词十二首复次官汝清韵 其八","author":"江源","text":"看看秋色此平分，何处笙歌入夜闻。\n独有多情端正月，年年依旧到长门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52198,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十二月词十二首复次官汝清韵 其九","author":"江源","text":"君王初授六宫衣，又近登临九日期。\n菊酒酡颜花插鬓，免教时节叹人痴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52199,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十二月词十二首复次官汝清韵 其十","author":"江源","text":"满眼风光又小春，却寒帘底暖如温。\n年年十月华清幸，知是谁先被主恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52200,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十二月词十二首复次官汝清韵 其十一","author":"江源","text":"小至初临生一阳，履长纳庆祝君王。\n从今日永知何用，刺绣功添一线长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52201,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十二月词十二首复次官汝清韵 其十二","author":"江源","text":"一阳来复二阳回，更喜宫中臈日来。\n莫漫藏阉论胜负，祝君先进御前杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52202,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其一","author":"江源","text":"庭阶曾不插盐枝，数被邻宫叹妾痴。\n不是妾心慵望幸，君王同辇有蛾眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52203,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其二","author":"江源","text":"着破当年旧舞衫，此情欲说怕宫监。\n承恩莫羡昭阳女，宠极宁无掩鼻谗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52204,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其三","author":"江源","text":"雪打交疏闭翠帷，三边正是裂肤时。\n君王轸念敦煌卒，为作征袍妾不辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52205,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其四","author":"江源","text":"羞随阿姊斗浓纤，记得关睢每口占。\n不是君王崇令德，如何金屋贮无盐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52206,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其五","author":"江源","text":"重门金钥守阍阉，贱妾持身敢解严。\n圣主齐家法三代，不教皇后谩垂帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52207,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其六","author":"江源","text":"太液荷花照水妍，伴人歌舞上龙船。\n自怜不及越溪女，岁岁兰桡约采莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52208,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其七","author":"江源","text":"一餐何敢忘君恩，团扇秋风旧箧尘。\n欲问温柔乡里事，宫中无复淖夫人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52209,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其八","author":"江源","text":"金屏霜冷又冬交，转眼阳回豆蔻稍。\n甘分独眠纨扇底，羡他双燕玉楼巢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52210,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其九","author":"江源","text":"骊山十月翠华临，百队红妆绣幄深。\n恩幸宫中谁第一，辟寒新赐阿环金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52211,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其十","author":"江源","text":"内人相庆拜新除，近诏仍教注起居。\n便殿日长宣奏事，中官催唤女尚书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52212,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其十一","author":"江源","text":"秋水精神窈窕容，肯将铅粉斗纤秾。\n十年不识君王面，争得黄金贿画工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52213,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其十二","author":"江源","text":"双蛾憔悴逐年华，系臂犹留旧绛纱。\n记得昭阳蒙宠日，玉颜谁道不如鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52214,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其十三","author":"江源","text":"寂静长门尽日封，傍人教妾强为容。\n不知宠辱都由命，只合深宫咏菲葑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52215,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其十四","author":"江源","text":"薄劣深渐荷宠光，宫庭夜夜拜穹苍。\n手拈龙挂无他祝，但愿君王万寿长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52216,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其十五","author":"江源","text":"君王恩幸不曾疏，肺病教含白玉鱼。\n贱妾涓埃何以报，御前三上渐台书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52217,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其十六","author":"江源","text":"风景昭台分外清，眼前宠辱未须惊。\n阿娇倾国今安在，金屋无人空月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52218,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其十七","author":"江源","text":"锦帐银屏白玉床，十年供奉老披香。\n铅华且莫轻抛却，万一君恩广末光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52219,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其十八","author":"江源","text":"钩弋宫中降诞时，却将尧母命门楣。\n天颜有喜恩偏重，更把金钱赐洗儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52220,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其十九","author":"江源","text":"色衰时去两相遭，犹有君恩在赐袍。\n谁道秋风能再热，却教纨扇不辞劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52221,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其二十","author":"江源","text":"春来心绪乱如麻，恨紫愁红满眼赊。\n凤驾不来春又晚，东风零落海棠花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52222,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其二十一","author":"江源","text":"日长金殿暑方炎，侍女摇风午梦甜。\n起傍玉阑干外立，一声风铁落前檐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52223,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其二十二","author":"江源","text":"一枕西风候雁哀，新凉庭院独徘徊。\n窗前一片梧桐月，曾照羊车几度来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52224,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其二十三","author":"江源","text":"闻道君王此夜过，笼灯扫雪候鸾车。\n须臾听得宫监报，竟幸元勋赵普家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52225,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其二十四","author":"江源","text":"春回金殿转晴光，白玉桥边御柳长。\n底事伤春饶午睡，梦随蝴蝶到昭阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52226,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其二十五","author":"江源","text":"失宠能忘得宠初，妾心安用泣前鱼。\n衰荣自古何曾定，班赵从来不与俱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52227,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其二十六","author":"江源","text":"绣罢龙衣出院迟，玉阶闲坐话当时。\n官家久远倾城色，莫更临鸾学画眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52228,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其二十七","author":"江源","text":"约伴宜春斗草来，茸茸浅碧趁弓鞋。\n并头折得真堪恼，且酌黄封一畅怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52229,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其二十八","author":"江源","text":"君情妾意各西东，浊水清尘迥不同。\n借问承恩环燕辈，槿花能得几朝红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52230,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其二十九","author":"江源","text":"春色薰人睡正酣，醒来闲步弄宜男。\n雕笼谩有能言鸟，五利文成莫浪谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52231,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其三十","author":"江源","text":"紫禁秋风十又三，芙蓉花老落毵毵。\n妾容与此同消歇，如此长门已分甘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52232,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其三十一","author":"江源","text":"夕卸残妆落燕钗，清风净洗此天街。\n人都席地拜新月，妾独开帘看泰阶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52233,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其三十二","author":"江源","text":"妾身何幸际唐虞，更贺皇威尽海隅。\n况复边庭皆卫霍，免教妾辈嫁单于。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52234,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其三十三","author":"江源","text":"玉阶回首隔云泥，旧赐惟馀辟暑犀。\n冰簟银床成底事，凉风吹梦凤楼西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52235,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其三十四","author":"江源","text":"一世忧勤妾亦劳，更闻西域进奇毛。\n近臣谁是姬公辈，复向君前赋旅獒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52236,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其三十五","author":"江源","text":"永巷频年脱步摇，劝王多难莫征辽。\n东南民困财仍竭，西北兵罢将亦骄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52237,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其三十六","author":"江源","text":"二八蛾眉侍上皇，太平亲见此陶唐。\n五风十雨天颜喜，犹召廷臣累谏章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52238,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其三十七","author":"江源","text":"风雨深宫即杜门，寻思时事百千端。\n朝阳只恐无鸣凤，不是君王薄谏官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52239,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其三十八","author":"江源","text":"君恩自是如天阔，妾命生来似叶轻。\n暑去寒来颜色改，谩题纨扇寄幽情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52240,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其三十九","author":"江源","text":"蹴罢秋千鬓脚垂，一春心事竟差池。\n玉肌近日浑偷瘦，倩得中官唤女医。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52241,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其四十","author":"江源","text":"宫娃白发两盘桓，共说先朝事几般。\n记得相公杨绾在，太平民物似真观。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52242,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其四十一","author":"江源","text":"银汉迢迢夜未央，清光不照合欢床。\n昭阳殿里嫌更短，长信宫中苦漏长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52243,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其四十二","author":"江源","text":"自知妾貌殊今昔，不是君心有爱憎。\n尚想年时恩幸倍，内园同辇妾亲曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52244,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其四十三","author":"江源","text":"金屋珠帘翡翠屏，此生不道娱娉婷。\n君恩下及谁之赐，欲效周人咏小星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52245,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其四十四","author":"江源","text":"不见乘舆幸集灵，未央前殿敝云屏。\n中官传得君王旨，竟召儒臣讲六经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52246,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其四十五","author":"江源","text":"梨云梦里听喧呼，急起苍忙问女奴。\n今日昭阳呈戏剧，君王曾怒偃师无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52247,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其四十六","author":"江源","text":"不出深宫半月馀，苔痕将绿上阶除。\n呼奴分付休轻践，留得青青殿属车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52248,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其四十七","author":"江源","text":"忆昨朱颜入汉宫，曾将弦管侍重瞳。\n如今抛掷长门里，细雨寒灯泣夜虫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52249,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其四十八","author":"江源","text":"永巷秋风老妾容，主恩何处着人浓。\n明妃莫恨龙沙远，对面宫墙即万重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52250,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其四十九","author":"江源","text":"心绪纷纭懒出门，出门何处望金根。\n鹍弦欲拨无愁曲，只恐愁多更断魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52251,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其五十","author":"江源","text":"忆得年时二七春，金宫一日岁华深。\n妾身元是杭州女，曾把中官寄饼金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52252,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其五十一","author":"江源","text":"一饭深宫为主忧，秋风时节献功裘。\n如何近日承恩者，阿姊封秦弟拜侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52253,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其五十二","author":"江源","text":"掖庭秋夜苦偏长，燕寝遥焚一炷香。\n离别人间莫惆怅，下堂无语看参商。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52254,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]