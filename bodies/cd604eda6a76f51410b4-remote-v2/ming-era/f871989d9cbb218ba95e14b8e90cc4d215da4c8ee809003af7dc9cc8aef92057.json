[{"title":"登李宫谕叙庵午风亭 其一","author":"林俊","text":"赫炎吹尽日尤长，午近开帘纳太荒。\n莎径鸟声双树静，石桥花影小渠香。\n骄阳未觉风情减，短梦时分草榻凉。\n不信纷华车马地，仙家遗着水云乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13571,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登李宫谕叙庵午风亭 其二","author":"林俊","text":"微凉茑院足幽居，书带生齐绿映渠。\n树影正中还鹤梦，屏围以外更虫书。\n讲回赭案园初涉，制下黄麻席久虚。\n硕果化机酬竟在，一邱云物是乘除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13572,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"上勿药志喜","author":"林俊","text":"勿药传宣使下频，百僚动色贺中宸。\n万年宗社神为主，一统华夷帝此身。\n卜世正逢明盛日，托天长作太平民。\n老臣种种肝肠话，口不能言意屡申。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13573,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次胡紫山留别","author":"林俊","text":"双柿累累直绮筵，酒回分实意长悬。\n冠裳甚伟人如画，宾主相忘日似年。\n欲向惊鸾留妙诀，不禁别鹤上离弦。\n玄曹旧枕玄湖曲，信道人寰有洞仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13574,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠陶宫保参赞留务","author":"林俊","text":"一行簉羽共华颠，南北分飞思惘然。\n平土近承咨禹任，居留寻进命周权。\n山河表里开基外，版宇安危制治前。\n新主临轩劳目送，师贞元属旧耆贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13575,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"祈雪志喜 其一","author":"林俊","text":"茂育功成望转赊，斋坛清梦落文华。\n暖云布野分还合，瑞雪随风整复斜。\n己应食甘怜岁荠，未烦剪胜漫宫花。\n经纶自领寒光外，化出阳和与海涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13576,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"祈雪志喜 其二","author":"林俊","text":"一年将换出还稀，入幕从多势尚微。\n莫漫煮茶参速化，祗便雨麦是真机。\n穴深许见螟蝗尽，天阔时悬鹳鹤飞。\n喜溢九重翻系念，庇寒谁为赋无衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13577,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郊祀志喜 其一","author":"林俊","text":"暖律祥飙夜转琴，斋坛乌几坐来深。\n体元上国春齐到，祝嘏南郊帝式临。\n步入星辰占王气，梦回云汉系馀心。\n仰成一德明良会，紫杖青邱许再寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13578,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郊祀志喜 其二","author":"林俊","text":"听尽阳春一曲琴，馀寒不散念还深。\n青郊迎气风流转，黄道开天日照临。\n五色祥云承御辇，九韶仪凤协神心。\n乞灵更致冈陵祝，嘉靖殷休信许寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13579,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪洲","author":"林俊","text":"平林一望玉生烟，开尽梅花意洒然。\n授简兔园曾上客，吹箫鹤渚漫飞仙。\n金针术妙功奇奏，石鼎联成集旧传。\n闻说书巢连杜墅，江青鸟白见归船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13580,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"看牲次何燕泉韵","author":"林俊","text":"紫盖红旗拥后先，牵牲时过御阶前。\n立当仗马开行殿，会应飞龙愧老年。\n肥腯大官周礼物，精明元祀汉神天。\n四朝海岳沾恩施，报答无由效渺涓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13581,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西岳分献次何燕泉韵","author":"林俊","text":"迎气青阳始献春，上坛云物倍看新。\n南郊遍祀元殊数，西岳重移似有神。\n风马云车瞻陟降，金绳玉册感前程。\n礼成听得华夷颂，中国真占有圣人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13582,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿元老刘野亭翁","author":"林俊","text":"并阅稀龄又两春，滥陪锡宴忆生申。\n梦回紫极黄扉近，别到青山白发频。\n湖海备闻劳物色，云雷重拟待经纶。\n野亭细酒同年话，醒眼相看又醉人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13583,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄宋惟寅总宪用野亭韵","author":"林俊","text":"连马玄湖四十春，故怀拍塞竟曾申。\n别无只字终成简，梦有千心亦是频。\n莘野蔓畦堪卒岁，汴河烟艇足垂纶。\n品高命薄凭谁问，世上还多饮抑人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13584,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿李梅东九十次山斋韵","author":"林俊","text":"度百光阴九阅旬，贺筵无复并时宾。\n都于大段眼经惯，世有先生俗许醇。\n暮景似偿清白吏，耄龄还属太平人。\n典刑卫武箴规在，口授诸孙正及辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13585,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西台志喜","author":"林俊","text":"清明作育重冠绅，荐纸连登十一人。\n亨会风云元异数，圣怀天地本同仁。\n六司并属疲民命，五郡尤悬赤子身。\n浮靡叔风烦就念，一番道俗要还醇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13586,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿少傅杨邃翁","author":"林俊","text":"三南正气开河岳，一代高文重典谟。\n青简著书纶阁静，碧山归梦草堂孤。\n无时诗酒酬閒况，到处云雷识壮图。\n龙马精神知健在，驾风还拟踏瀛壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13587,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿太宰乔白岩 其一","author":"林俊","text":"重是崧高岳降神，会灵闻此复生申。\n古之平格天为寿，公也明良世有人。\n位极孤卿名愈重，诞弥甲子历初新。\n柴车垢服甄陶外，坐使醇风遍八垠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13588,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿太宰乔白岩 其二","author":"林俊","text":"南极祥光照寿筵，降神元应及申年。\n同时姓字闻天子，一代孤卿属地仙。\n粹雅谢庄谁独右，公清毛玠重无前。\n吐吞日月乔松外，瀛海三桑鹤几玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13589,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿太宰乔白岩 其三","author":"林俊","text":"龙飞应会记江南，嘉靖天休矢共戡。\n祖泽承圭元不负，师门传印此何惭。\n麟袍玉带思偏厚，鸠杖荷衣性颇耽。\n忠定年劳端毅寿，典刑一老重成三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13590,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿竹田翁进阶","author":"林俊","text":"古柏长松转见春，短篷疏雨下丝纶。\n昭慈懿范颁殊典，资德隆阶宠旧臣。\n草野光华天地德，竹田欢会岁时宾。\n平安孙子看齐报，紫箨文成万玉新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13591,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"癸未生朝幸庵翁诗为寿和答并以寿翁 其一","author":"林俊","text":"上筵胜日辨生朝，沾醉东风一和陶。\n官责每悬精力少，班行空说岁年高。\n雁南雁北身犹寄，花落花开梦尚遥。\n薄暮仙舟来远使，忽惊玄鹤下青霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13592,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"癸未生朝幸庵翁诗为寿和答并以寿翁 其二","author":"林俊","text":"海日苍凉辍视朝，病坊旬浃愧甄陶。\n因高祗觉邱陵小，仰止真怜泰华高。\n虎帐令严看节制，鹤袍名重副逍遥。\n南阳捷上天颜慰，宴罢从容下紫霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13593,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"癸未生朝幸庵翁诗为寿和答并以寿翁 其三","author":"林俊","text":"索尽孤怀采绿朝，看花何日共阴陶。\n头童未觉龟毛少，诗细从添鹤骨高。\n约伴丹邱缘自浅，溯洄银汉路成遥。\n鸴鸠决起元无力，薄趁风鹏上九霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13594,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三江翁归老赠篇次韵","author":"林俊","text":"夹江莲荡问湖田，梦里还家此信然。\n遇比王曾名故重，锡同疏傅宠逾偏。\n放怀笠泽收奇胜，结会香山感昔贤。\n静养功深行勿药，白麻新诏起朝天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13595,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜雨","author":"林俊","text":"浃旬黄雾塞晴空，四月林花尚未红。\n种种幽怀时事外，津津生意雨声中。\n桑林自信回天力，云汉终收济物功。\n订约先庚还自笑，过邻扶醉且东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13596,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠刘毅斋礼卿留都","author":"林俊","text":"徐过山色上晴岚，几驿官河路许谙。\n骏马台高空冀北，大鸿家近爱江南。\n清惟典客韭仍白，要得藏名䉀转甘。\n莫漫公衙便好睡，履声卿月梦朝参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13597,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠伦侍御瓈溪南归","author":"林俊","text":"最盛才华安避舍，颇颓筋力忆登台。\n地严风纪身先告，日昃功名岁未回。\n南纪每悬天上梦，西堂时共月中杯。\n昔贤心事频相付，露下秋高有雁来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13598,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠杨中翰承家 其一","author":"林俊","text":"绿野堂深映白麻，卯桥流水旧仙家。\n金蕉自得两山胜，梧竹平分一径斜。\n天上儿归明鹭服，膝前公寿照梅花。\n懒云一缕相依在，秋月江门共钓槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13599,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠杨中翰承家 其二","author":"林俊","text":"席虚合有君臣契，诏下先酬父子情。\n归得校书随杖屦，老便洛社结耆英。\n映江晴月一舟小，度鸟閒云两睫轻。\n文字唱酬翻自信，传家莫漫说西平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13600,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"借庵次韵为少宗伯白楼作","author":"林俊","text":"写易东华旧短庵，假眠烟雨续玄谈。\n人弓人得此何计，公姓公留住不惭。\n药圃花晴疏复密，柳渠风细北还南。\n纳来万有均成寄，直下相仍且驻骖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13601,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别山斋 其一","author":"林俊","text":"乡国相忘己岁年，忽惊苍白与华颠。\n长才再振冲天翼，急景重催下濑船。\n一种肝肠悬日月，百年文字愧山川。\n鸡声剑履趋陪地，薄记林翁放脚眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13602,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别山斋 其二","author":"林俊","text":"去住乾坤一短亭，午槐阴重酒偏醒。\n雨中秦树千行绿，鸟外闽峰几点青。\n玉宁情深同帝德，草堂人静愧山灵。\n汉家鱼水遭逢外，乞与云庄再勒铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13603,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿御史大夫张敬亭翁","author":"林俊","text":"朝指宛陵暮帝州，凌空一鹤任追游。\n紫霞丹灶麻姑宅，碧树澄江谢眺楼。\n台老有缘居化国，仙娥随意共高秋。\n慰怀兰玉春如画，辟谷仙方莫漫求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13604,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东瀛为银台张廷器作","author":"林俊","text":"簉迹仙班己岁华，沧洲老木旧名家。\n分明子夜见初日，隐约神楼住彩霞。\n海上独来青鸟使，人间几度碧桃花。\n万牛莫漫移山力，只赤蓬莱岂待赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13605,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"上宗册告赠贾少宰南坞","author":"林俊","text":"转息山河此一新，华夷重是太平民。\n中兴独盛关天意，大号加隆感帝亲。\n鲁庙上宗周祝帛，濮园殷祀宋灵神。\n利成肸蚃森严下，纯孝分明识圣真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13606,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"悼周琴川","author":"林俊","text":"兑泽交游四十年，冷云酸雨暗琴川。\n道穷自掩获麟袂，心许曾酬挂剑缘。\n吏局觉来浑短梦，人寰隔尽是真仙。\n河汾世学陶型外，莫漫濂溪少正传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13607,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿范郡伯以贞八十","author":"林俊","text":"南北东西果自由，百年离合几春秋。\n赤城候雁传来信，紫陌朝鸡想旧游。\n难用转于才作祟，息缘真以寿相酬。\n桃花流水荒唐外，一棹清风范蠡舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13608,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠项秉仁","author":"林俊","text":"襄毅元枢记昔年，后行梧竹上风烟。\n县家赤子心应副，吾道沧洲业许传。\n己属典刑酬仕学，未烦枘凿计方圆。\n缵戎好亦孙支事，先续循良第一篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13609,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别诸老 其一","author":"林俊","text":"遂归成喜亦成悲，贮结真同在位时。\n白壑青邱怜独往，碧霄凉月梦常疑。\n趋陪定记心中话，契阔聊哦醉里诗。\n万国嵩呼齐玉帛，两班簉迹重皋夔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13610,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别诸老 其二","author":"林俊","text":"鹤袍元不恋渔蓑，精力曾如老去何。\n混迹巢由皆自许，诸公尧舜望应多。\n直从圣学开天纵，薄与斯民乞岁和。\n海上山灵惊往别，閒身还属素云窝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13611,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别内阁四老 其一","author":"林俊","text":"晓钟凉月动冠绅，仗外仙班拱帝宸。\n九服舆图商令主，四朝军国宋师臣。\n壮猷紫殿传宣亟，旧学黄扉顾问频。\n老爱太平还物象，许从云水乞閒身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13612,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别内阁四老 其二","author":"林俊","text":"手完大物谢无功，开德宣符志虑同。\n鄂郢孕和深王气，云雷成象苦良工。\n中兴帝业风斯下，通道王臣水尽东。\n一体天休平格在，末由心迹寄冥鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13613,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别少司寇顾梅田翁并诸贤 其一","author":"林俊","text":"暮年此出重何功，相悉寅僚意许同。\n默有生全培帝德，薄存仁厚赞周风。\n丽天星斗心悬北，浃月官河路转东。\n没首平反馀系念，不禁衰飒对秋蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13614,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别少司寇顾梅田翁并诸贤 其二","author":"林俊","text":"待罪公曹梦许惊，率先时共赞无刑。\n绳违如例施操纵，冲决何情易重轻。\n三典敢忘天地德，一心真欲鬼神盟。\n爽鸠千古凭谁嗣，直到苏公始姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13615,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别乡诸贤 其一","author":"林俊","text":"帝城南去是归装，翘首云天思转长。\n吏冗少神随事忘，病魔催老到家忙。\n人心未必能三代，道化先须尽一乡。\n麦饭鱼羹酬旧隐，水烟山月梦溪堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13616,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别乡诸贤 其二","author":"林俊","text":"袜材终短重何禆，衰飒偏于老作期。\n霖雨巳孤忧旱望，卿云空见出山时。\n天南候雁随将去，客里周星感又移。\n话别来贤心更切，棘林鸠梦未安枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13617,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋卿外直别话","author":"林俊","text":"解衣盘礴试新醪，过鸟秋清下羽毛。\n巳爱道人论心曲，不知僧舍是公曹。\n暮年去住情难割，后夜交游梦转劳。\n月色江声寥寂外，坐深槐露湿征袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13618,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠江藩伯景熙同年宫保东川公子","author":"林俊","text":"文物东藩喜近临，故人为别意还深。\n名家型范平看副，裕国源流信许寻。\n安得三钱长米价，秪知一粒自民心。\n常平旧格今谁问，老爱云庄是好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13619,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次白岩燕泉赠篇 其一","author":"林俊","text":"南归应得共秋鸿，小借江帆两月风。\n收到枌榆还暮景，抱回畎亩是馀忠。\n大家未信藩篱隔，少室真怜臭味同。\n旧话老农深帝力，閒身云白雨青中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13620,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次白岩燕泉赠篇 其二","author":"林俊","text":"分浅遭逢巳后时，馀年空与病相随。\n地天共喜云龙会，丘壑真怜野鹤姿。\n起赞中兴曾几策，遂归长别可无诗。\n旧行假迹嵩呼下，萦结心多是此辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13621,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次吴白楼卷中韵","author":"林俊","text":"文会鸡鸣记往年，秋山回首四朝前。\n典刑数老今谁在，风雨重阳句尚传。\n礼祀放晴中夜月，斋坛分碧北陵烟。\n直庐奎聚翻成感，旧臆新悰一闇然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13622,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东郭草堂话别次白岩南坞燕泉惕庵联句韵 其一","author":"林俊","text":"文华饮德共依光，野苋山薇自别肠。\n击毂大疏劳出祖，爨桐中散望升堂。\n例随芰制修初服，春与花枝漏一阳。\n皓首薪歌无患福，夜阑清梦屡江乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13623,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东郭草堂话别次白岩南坞燕泉惕庵联句韵 其二","author":"林俊","text":"内廷辞叩重加难，忍尽柔肠泪暗乾。\n立近御炉香细细，归随辇路佩珊珊。\n年踰祗觉行艰蹇，才小难禁事错盘。\n祖席载移公不浅，山容野色助悲欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13624,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东郭草堂话别次白岩南坞燕泉惕庵联句韵 其三","author":"林俊","text":"山衣野屐四朝臣，老窃班行荷缙绅。\n午谷逃虚东海上，卯桥访旧大江滨。\n岁深老树垂斑瘿，风细平湖积素鳞。\n归去吏书无却事，偃松高桂识吾真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13625,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东郭草堂话别次白岩南坞燕泉惕庵联句韵 其四","author":"林俊","text":"首白交游重数公，祖筵别后复移东。\n出门少海天容淡，分袂西山夕照红。\n老去肝肠馀系恋，迩之精力失豪雄。\n草堂不为疑猿鹤，上德朋情积叠中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13626,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寓直话别次白岩南坞燕泉联句韵 其一","author":"林俊","text":"匏系何情出屡希，调孤俗尚故应违。\n阅来沧海应三变，数尽长鸿是四归。\n草野生成天地德，玉关离合鬼神几。\n双溪云水经年别，细苇新蒲暗旧矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13627,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寓直话别次白岩南坞燕泉联句韵 其二","author":"林俊","text":"浃日追陪不惮劳，放怀时为秃霜毫。\n文昌夜烛三台上，风望晴看两岳高。\n巳办壮猷当世责，未酬绘句入诗豪。\n秋残断饮浑无味，空有黄花对蟹螯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13628,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻自齐至楚早荒用韵志感","author":"林俊","text":"转移无力愧愚公，杼轴何情见两东。\n竟岁山农空事育，太仓官粟几陈红。\n抱愁不问身眠虎，赴急真思力当熊。\n大统入承瞻圣制，在天七庙慰临中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13629,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白浦悼章 其一","author":"林俊","text":"元气栽培语不虚，二童一马化行馀。\n迩之静海忽凶报，昨者天津是荐书。\n李郭交游倾盖晚，彭殇修短赋形初。\n倔强造物相降会，长诀心多尚属余。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13630,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白浦悼章 其二","author":"林俊","text":"烛前老泪落班班，太息吾流竟此还。\n正气直抛存殁外，要官时置有无间。\n辑来谏草堪垂世，堆到遗书莫买山。\n寄取诸孤勤护植，德门天道是循环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13631,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"约九日饮䆳翁信宿方到纪怀","author":"林俊","text":"菊花端为主人开，悔后重阳一日来。\n依旧两山同对酒，及衰双脚强登台。\n天空雁影将云过，风亟江潮带海回。\n莫谩交游论老别，物情销尽几寒灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13632,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠王履约履吉二生","author":"林俊","text":"水月相忘坐此清，缁衣空窃好贤名。\n吴中词伯还双陆，洛下儒宗亦二程。\n几信宫墙无路入，极知水火有人争。\n传心好亦当年事，三绝韦编付短檠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13633,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]