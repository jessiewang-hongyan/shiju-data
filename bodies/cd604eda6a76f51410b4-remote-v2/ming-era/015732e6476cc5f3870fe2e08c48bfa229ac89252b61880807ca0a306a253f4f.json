[{"title":"题思亲卷","author":"吴琏","text":"爱日日去促，望云云急飞。\n风高木叶响，巢破鸟声悲。\n切切生时语，重重身上衣。\n膝前双彩袖，拜舞恨无时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"城市山林亭会酌二首时九月六日也亭前禾甚丰 其一","author":"吴琏","text":"苍翠山林景，巍峨城上楼。\n北山松已老，南亩稻将收。\n陶谢诗相敌，雷陈分各投。\n罗浮何日约，同与赤松游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"城市山林亭会酌二首时九月六日也亭前禾甚丰 其二","author":"吴琏","text":"欲豁江南望，重登镇海楼。\n林高花影细，人閧鸟声收。\n朱紫衣冠盛，金兰气义投。\n景馀吟不尽，重拟一同游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再成一首","author":"吴琏","text":"城市日啾啾，谁言景趣幽。\n古墙垂薜荔，山木叫軥辀。\n翠盖秋松老，黄云晚稻稠。\n旅庭如近此，无日不追游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"还乡用前韵述怀 其一","author":"吴琏","text":"桃源日朗金牛洞，竹屋风清铁汉楼。\n狡兔未经鹰且臂，玉人无遇璞应收。\n急流若水归何勇，燕颔班超笔未投。\n幽思满怀天独识，老容强健恣清游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"还乡用前韵述怀 其二","author":"吴琏","text":"竹里森森屋，堂前小小楼。\n有邀门始出，无价玉还收。\n教子书频积，延宾辖每投。\n何时学曾点，童冠舞雩游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再咏镇海楼","author":"吴琏","text":"山上重重万仞高，一城应借壮雄豪。\n阶前景色迷霄汉，檐下松声沸海涛。\n天近云深尘迹断，境虚人静籁音嘈。\n望中恍惚蓬莱接，拟向瑶池摘碧桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送卫仪宾还广西","author":"吴琏","text":"兰桂香风送去舟，一江摇漾岭南秋。\n橘橙景好豁吟兴，弦管调高清醉眸。\n玉宇到时知眷恋，珠江何日拟绸缪。\n湖山清趣谁能识，一度兴怀一恣游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"老农叹","author":"吴琏","text":"路逢一农色蓝绿，问其何事瘦无肉。\n答言每年晓起食粥方耕犁，今年耕犁晏归方食粥。\n日日米少粥大稀，儿女食半倚墙哭。\n呜呼，呜呼，安得年年禾大熟，使我儿女两餐足，不仰邻阴荫茅屋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题忍斋","author":"吴琏","text":"心不能容事即乖，片言无戾遽相猜。\n听乾唾面娄弘度，奕世同居张耐怀。\n庭下荆花千载茂，眼中邻里百年谐。\n古来此事传家宝，珍重高明用扁斋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"百越兴师卷为郭武定题","author":"吴琏","text":"峡藤初断蔓重青，承命翱翔出帝京。\n马援入郊徵侧服，狄青临越智高平。\n书无频晾鱼将蠹，田不时芸莠自生。\n南顾若询谁可用，据鞍犹喜马蹄轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉翁亭","author":"吴琏","text":"龙图学士滁之守，爱国恤民古稀有。\n政暇放情山水间，名胜追寻远携酒。\n城南数里琅琊山，胜迹森罗绝尘垢。\n太守开宴宾客喧，半是士民半僚友。\n太守之乐，乐生民之康宁。\n生民之乐，乐太守之贤明。\n太守归而悠扬六七里，非太守之真醉。\n归述文而垂光千万古，见太守之醒醒。\n太守乐民之乐，民亦乐其乐，上下通而政成。\n于时禽鸟亦乐其乐，而且非且鸣。\n乐事无涯，无可寄情，姑以醉翁名而更名其亭。\n太守谓谁，天挺欧阳公于庐陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宦园吟","author":"吴琏","text":"宦园深处万松阴，阵阵风涛响素琴。\n上涧流泉鸣下涧，东林啼鸟和西林。\n花开红白名谁识，蒲长高低绿自深。\n卧此怡神应不老，不须蓬岛细追寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉麟晚瑞为何太守作","author":"吴琏","text":"天瑞降庭除，徐卿愿已如。\n楼书忻有托，囊积喜无虚。\n不用先天卜，知为盛世儒。\n几年纡郁处，今日气方舒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宦园览景喜题","author":"吴琏","text":"闲拽园中杖，迢迢一洞深。\n晓花光灿锦，风竹碎筛金。\n赤鲤惊雷跃，黄鹂隔树音。\n不胜清兴发，觅纸寄新吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送顺德邓太守之任太平府","author":"吴琏","text":"海滨邹鲁气完完，钟物遗人柳语村。\n德盛臣逢明盛主，心平人作太平官。\n文章温雅儒风振，政事严明吏胆寒。\n黄霸功成归内院，四方同见泽漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈巡按召饮适在乡诗以奉谢","author":"吴琏","text":"久遁山翁七十馀，一天风月自如如。\n忽承豸史垂光召，适在芦湾坐钓鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄胡大声京兆","author":"吴琏","text":"北府春风暖，南园午簟凉。\n行藏随所寓，独恨天茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元宵十三夜偶成 其一","author":"吴琏","text":"景入元霄夜已三，挂灯鸣鼓遍江南。\n远推到处浑如此，人乐时平不用参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元宵十三夜偶成 其二","author":"吴琏","text":"扰扰尘途五十三，笑将清抱卷江南。\n洞深径曲柴门静，止见耕人入笑参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元宵十三夜偶成 其三","author":"吴琏","text":"归遁年经二十三，杖藜村北与村南。\n乡童野叟不相识，窃问旁人始向参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元宵十三夜偶成 其四","author":"吴琏","text":"竹菊松开曲径三，水光山色丽庵南。\n日摊周易垂帘坐，头白浑无一吏参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏问冯汝清","author":"吴琏","text":"千首君曾寄老夫，居官何事一诗无。\n穷通自古寻常事，谁解千年在仕途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桂庵为斗南表亲作","author":"吴琏","text":"丹桂种亭坡，燕山景趣多。\n清风香馥郁，明月影婆娑。\n天上寒蝉窟，人间白兔窝。\n诸郎高入袖，不用见嫦娥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺内翰伦伯畴次郎领荐","author":"吴琏","text":"髫稚烟云扫禁闱，南天星斗夜争辉。\n桂花露重冠襟润，御墨香浓姓字题。\n老凤鸣阳雏凤继，乔枝撑汉梓枝齐。\n东平父子曾如此，勋业还期各远挥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次胡京兆大声见寄韵时大声为言者所论欲乞休故云","author":"吴琏","text":"京兆由来起外非，张眉争诮画闺闱。\n既逢舜世须弘化，未荡尧风勿道归。\n受唾听乾人共仰，故交无弃世应稀。\n桃源眷眷空翘首，独诵高吟忆谢晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄同年潘雪竹佥宪","author":"吴琏","text":"一别年光四十馀，两天风月各如如。\n山深地僻逢人少，不是无心懒寄书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汪宪副别号诚斋","author":"吴琏","text":"四方云拥鲁衣冠，几见訚訚露肺肝。\n飞岭白云双眼碧，向阳朱藿一心丹。\n子求民欲常多中，铁作肝肠百莫干。\n动物格天谁可共，开云驯鳄古唐韩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈祐卿大参之闽","author":"吴琏","text":"迢递三山路，驱驰一世雄。\n江洋涵夜月，花木媚春风。\n周俗熙熙外，尧天荡荡中。\n太平谁独爱，安卧碧山翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东所饯黄子任别余与景昌与焉饮罢告别东所云北都有询及者为拜覆景昌亦云然余独默默景昌诘余因应之曰自知潦倒无人问何必殷勤嘱使君后回看竹亭续成前句","author":"吴琏","text":"一揖行藏两地分，景昌东所各云云。\n自知潦倒无人问，何必殷勤嘱使君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄黄掌科亲家","author":"吴琏","text":"数亩青山一剩夫，满天风月夜琴孤。\n卑微自拟无人问，曾有何人一问无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"海滨舆诵为郭武定总戎题","author":"吴琏","text":"岭外尘氛净，枫宸诏命来。\n君民争切仰，文武显全材。\n四海阳春转，千年寿域开。\n岘山恩莫断，群眼望三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题王兵备旋兵卷 其一","author":"吴琏","text":"童叟聚林坰，喧然论世情。\n夜深门不闭，月朗犬无惊。\n稻陇黄云霭，江天白浪平。\n淮阳民睡稳，裴老已旋兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题王兵备旋兵卷 其二","author":"吴琏","text":"波涛显柁工，盘错表利器。\n剑芒辉斗牛，威名振天地。\n入穴敲虎牙，锄山剪荆刺。\n民起太平歌，争颂贤兵备。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和江桂轩先生感事韵","author":"吴琏","text":"闻说桃源古洞中，四时天气暖如烘。\n白头翁讲前朝事，赤脚人存上古风。\n山顶朦胧红日近，树头苍翠碧云浓。\n由来此地堪投足，直作云岩不老翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东山","author":"吴琏","text":"壁立巍峨势插天，泰山蓬岛远相连。\n碧涵万顷朝宗水，清泻千寻落涧泉。\n迎日晓莺先觉暖，向阳春树早争研。\n苍生引领思霖雨，安石山床未稳眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"象山别意送梁进士北行","author":"吴琏","text":"达士辞象山，亲朋饯山麓。\n松声弦外清，竹影杯中绿。\n胜负壶矢鸣，铿锵句联续。\n明日天茫茫，江南我吟独。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题黄时重蓬岛分春卷","author":"吴琏","text":"日日融和景象新，碧坛瑶圃气絪缊。\n问渠何得长如此，分却蓬莱岛上春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺邝亲家八十一","author":"吴琏","text":"八百篯铿世所稀，五羊坛见古成之。\n南山瘦耸苍龙骨，老柏荣撑白鹤枝。\n棣萼楼前情绻绻，曾玄堂下乐怡怡。\n斑衣列舞头侵雪，此日何妨酗百卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"约邹邦范昆仲于灵州结诗社 其一","author":"吴琏","text":"更两逢春八十翁，灵州觞咏拟君同。\n主僧头白眼犹碧，诗客才高句自雄。\n槛外江光微隐映，望中山色远空濛。\n衣冠盛集成诗社，孙会南园有旧踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"约邹邦范昆仲于灵州结诗社 其二","author":"吴琏","text":"一门昆玉尽诗翁，迢递名山幸一同。\n磊落襟怀情共适，铿锵金玉句争雄。\n才高今古推先哲，书读华夷识阿蒙。\n诗社一成名一就，妙高台上蹑坡踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"约邹邦范昆仲于灵州结诗社 其三","author":"吴琏","text":"黑头归作碧山翁，去缝磨棱与世同。\n献璞自来非卞老，解嘲谁复学杨雄。\n心明可否知常静，眼认之无觉未蒙。\n不以老嫌追骥缓，百年长拟共吟踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"种杉","author":"吴琏","text":"儿孙生计薄，辟地种杉松。\n伐树深劳念，诛茅亦费工。\n清清怡望眼，小小寄吟踪。\n直待成梁栋，时方记老翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"何村八景 其一 渡头渔唱","author":"吴琏","text":"来往人喧古渡头，渔翁摇漾荡扁舟。\n丁当几韵榔初响，欸乃数声歌未休。\n欢酌瓦瓶蓬月夜，醉吹横笛海天秋。\n相逢相问渔樵外，更有谁闲似白鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"何村八景 其二 月池仙迹","author":"吴琏","text":"月下何来水上姑，月明姑出会仙徒。\n古今池涌源泉出，红白花开锦绣铺。\n濯足野夫归别涧，窥鱼林鹤去平湖。\n何年姑再池中见，试问诗翁入会无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"何村八景 其三 桃源春霁","author":"吴琏","text":"一洞森森万象新，天台真境净无尘。\n少官老隐人人乐，燕乳鸠鸣在在春。\n竹底日高金影碎，松稍风细浪声匀。\n宦园清赏乌纱集，佳句连篇酒数樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"何村八景 其四 西江夕照","author":"吴琏","text":"阳气堂堂忽渐阴，万山西面布黄金。\n蝉鸣红树流清响，僧撼暮钟来好音。\n草下伏萤争列耀，云边飞鸟倦归林。\n时虽小晦朝来显，天道循环古到今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"何村八景 其五 涌口观澜","author":"吴琏","text":"江上横拖一小冲，冲头江水去无穷。\n坐观湍急昼还夜，便见流行始到终。\n识到此时真理彻，探穷源处实心融。\n尼翁川上无深叹，后世何人为启蒙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"何村八景 其六 凤江秋月","author":"吴琏","text":"萧森江上老梧桐，凤集朝阳紫翠丛。\n哕哕好音萧韵响，辉辉文羽翠光同。\n太平天子来真瑞，修史词臣记实踪。\n异物古今能几见，老翁时睹月明中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53958,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"何村八景 其七 岗尾樵歌","author":"吴琏","text":"未遇谁能识买臣，半生樵担困红尘。\n放歌岗下醒如醉，射策廷中屈见伸。\n自信老儒终显迹，独矜愚妇不甘贫。\n人生穷达寻常事，头白无忘一斧斤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53959,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"何村八景 其八 隔田耕隐","author":"吴琏","text":"耕业丰隆德望尊，畜牛羊并察鸡豚。\n一犁春雨连年足，堆架遗书暇日观。\n鲁朴冠裳人楚楚，青苍松竹景漫漫。\n儿孙继显传清白，仕宦家成礼义门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53960,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和虚舟明府赋得不知秋思在谁家","author":"吴琏","text":"梧叶飘寒不禁秋，况逢清夕露华流。\n征人漠漠云归塞，晚笛声声风满楼。\n琴罢有人添别恨，情多何处赋閒愁。\n扁舟偏剩沧江客，头白冥心月共悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53961,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒曲江张丞相祠","author":"苏葵","text":"堂堂曲江公，山川气攸萃。\n忠节贯日星，时艰惜遭际。\n当廷视奸谀，明明见肝肺。\n天不假上方，长安乃鼎沸。\n銮舆远播迁，神气几乎坠。\n一时岂无人，十九甘泄泄。\n李唐十数传，贤相公独最。\n庙食宜千秋，芳名应万世。\n鲰生涉仕途，城下轻舫繫。\n抠衣谒公祠，起敬复起畏。\n治绩怯夔龙，为公一挥涕。\n我幸遇皇明，不比公之季。\n寸阶可树勋，不在公之位。\n借得公之位，愿与公永誓。\n丹心照天地，前光后无愧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53962,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"语悲鸟","author":"苏葵","text":"哑哑野中鸟，雌雄日相呼。\n结巢向高树，伏卵成双雏。\n攫鸟给其食，意望将返哺。\n黄口翼未成，微生不容图。\n巨虺入巢中，噬齧无馀肤。\n雌雄远树悲，声断肠已枯。\n野鸟尔莫悲，今乃得返之。\n尔曾攫燕子，母燕无忘时。\n尔曾攫鸡雏，母鸡苦无涯。\n恶稔亮必报，造物岂有私。\n尔当惩尔愆，庶育后来儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53963,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"示弟","author":"苏葵","text":"父兄果能贤，子弟之所托。\n我生既不才，不足为汝学。\n但颇好古书，口能辨纯驳。\n以古證于今，今人陷沟壑。\n不慕笃天伦，智力日相角。\n匪因财货生，即由妻子作。\n不慕农商业，飘飘日嬉谑。\n呼卢猎毛虫，弯弓落蜚雀。\n不读圣贤书，甘心染污浊。\n戏同牧猪奴，反以为真乐。\n不慕亲仁贤，日夜耽糟粕。\n蚁聚高阳徒，士远如孤鹤。\n凡此今人行，为害胜鸩药。\n所志流卑污，惟家日萧索。\n臭名播远近，闻者皆惭怍。\n劝尔效田荆，诫尔阋墙恶。\n劝尔慕伯高，诫尔勿浮薄。\n劝尔读陶戒，诫尔勿樗博。\n劝尔读初筵，诫尔勿酣酌。\n不见江上潮，一退日以涸。\n不见日下冰，一消日以铄。\n不见地上土，一崩日以削。\n不见园中花，一衰日以落。\n世事总如此，在人自知觉。\n尔宜深究图，无徒轻诺诺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53964,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风木图为邱长史赋","author":"苏葵","text":"俯仰蘧庐中，岁月驹过隙。\n念此劬劳恩，欲报天罔极。\n生期禄养荣，禄养苦不及。\n所以孝子心，痛裂如被戟。\n千古皋鱼悲，止不到狂籍。\n王傅其何如，三年自柴瘠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53965,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题莆田黄举人椿庭哀挽卷黄尝典乡塾","author":"苏葵","text":"彭殇不可齐，造化诚儿戏。\n世无白琅霜，南华喻唐肆。\n人间四十春，大觉破梦寐。\n东风桃李场，漠漠阴云翳。\n我爱汉仲蔚，千古垂风致。\n莆阳今何如，林涧不被愧。\n飞腾付后昆，后昆已承志。\n峨峨赤龙山，会有焚黄贲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53966,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"双寿为徐邦祥赋","author":"苏葵","text":"五仙杳何许，风韵留人间。\n城南有遗老，鹤发双童颜。\n清晨汲沆瀣，宝鼎调虹丹。\n或招东华君，婉衿下青鸾。\n琼浆碧玉瓯，麟脯玻璃盘。\n方瞳各炯炯，甲子既复还。\n震嗣天上归，锦衣胜斓斑。\n万里奉恩渥，曲尽高堂欢。\n笙歌沸华筵，喜气充门阑。\n氤氲溢醍盎，馥郁飘沈檀。\n俯爱狎言笑，仰祝齐邱山。\n老人射芳桂，光风泛崇兰。\n显贵杂履舄，比邻理衣冠。\n愿言保耆艾，兹永无后艰。\n贞松与慈竹，苍苍同岁寒。\n仙城自有仙，何必谈函关。\n海波纪变更，石渠看跻攀。\n爵跃赏南纪，盛事古所难。\n短诗付歌儿，侑取尊中乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53967,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴静观学士挽诗","author":"苏葵","text":"长啸向南纪，悽怆填我怀。\n九原不可作，世路轻尘埃。\n不见元礼风，空闻谪仙才。\n子云未窥书，胸中已兼该。\n早立苍螭头，晚候花砖阶。\n近和金銮赋，远题凤凰台。\n豫樟未为栋，山岳徒生材。\n飞兔不近驾，宇宙令人哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53968,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送琼台胡宗周进士荣归","author":"苏葵","text":"好事天地间，所得谁最多。\n栽培有定理，造化谅匪他。\n君如荆山玉，温栗加砻磨。\n未论二酉空，经史精爬罗。\n操履中规矩，文思加悬河。\n天禄需英贤，发阶崇甲科。\n兹当昼锦还，浩浩承恩波。\n高堂奉卮酒，欢洽童颜酡。\n从容效莱舞，怡悦屡笑嗟。\n百里今破荒，方驾唐子过。\n作诗追赠言，敢谓继东坡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53969,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"久雨三首 其一","author":"苏葵","text":"骤雨忽倾盆，沟浍深几尺。\n其势亦奔腾，涸匮在瞬息。\n慨惟千顷波，清浊不可测。\n儿童不知远，近视有惧色。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53970,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]