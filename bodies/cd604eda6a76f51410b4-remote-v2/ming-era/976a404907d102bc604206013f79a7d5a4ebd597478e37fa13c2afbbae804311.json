[{"title":"庚子元日和南皋","author":"黄衷","text":"山茶初放晓阑花，柏酒犹烘老面霞。\n深恋敢忘天北极，闲情只在水西涯。\n春?似挟青皇令，晴鹊时喧古树槎。\n剪胜不须传往事，穗城从昔擅繁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵南皋人日山行二首 其一","author":"黄衷","text":"人日欣欣媚，晴风款款来。\n松阴双节憩，草际一樽开。\n野沃青先合，山重势欲回。\n春光梅柳外，莫遣杜鹃催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵南皋人日山行二首 其二","author":"黄衷","text":"马怯频纡阪，鹰豪欲破围。\n瀹茶泉乳细，入馔韭苗肥。\n寺僻僧斋晚，墟荒野贩稀。\n谩多岐路感，吾已决从违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵涂梦卜大佥二首 其一","author":"黄衷","text":"古木萧萧拂冻云，邮亭小队踏晴曛。\n琴书谩逐滩声下，桑梓回瞻雁影分。\n岁事几何浑转盻，物情强半异前闻。\n庙堂假节还才隽，为报西山寇盗群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵涂梦卜大佥二首 其二","author":"黄衷","text":"江帆悬晓风初正，江草回春日向迟。\n一曲鳌峰何限兴，十年棠野有馀思。\n樽前谈艺曾操缦，圯上传书自握奇。\n谁道衰翁虚伏枕，梦随竹马引牙旗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢丫山过荒垄","author":"黄衷","text":"三日甘霖歇，山游兴若何。\n春酣花欲语，阴净鸟还歌。\n病许扃扉久，情深枉驾多。\n野庭期洒扫，题竹记重过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢惠新茶用韵","author":"黄衷","text":"旗叶开春雨，烦酬复几何。\n香浮青箬裹，媚带翠鬟歌。\n绕鼎新烟淡，分杯灏气多。\n岂无寒夜客，谁更草堂过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西林避暑和丫山","author":"黄衷","text":"背泚沾初伏，韶薰想远天。\n江帆飞鸟外，野服制荷前。\n弄艇谁同调，看花忽隔年。\n渔矶须选胜，旧樾净阴连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"承南皋见赠次韵奉答","author":"黄衷","text":"新篇堪拟凤鸣阳，欲对还如水一方。\n病骨未嫌初伏暑，烦襟先濯绪风凉。\n浑疑仙客冰壶里，宛在佳人锦瑟旁。\n珍袭已深虚白室，斗间犹自见晶光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林塘督仆设鱼笱","author":"黄衷","text":"编竹成鱼罶，何如网罟求。\n且堪依石角，切莫近潮头。\n沙鹭空馀巧，梁鹈各自谋。\n从来虾蚬性，无分饱珍羞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉津阁避暑和南皋二首 其一","author":"黄衷","text":"浅涧犹翻浴鹭波，孤龛何处访头陀。\n因风历历来樵语，倚树时时听鸟歌。\n坐久虚疑逃世远，情深应是赋诗多。\n休嫌病客无清绪，便拟同扪石上萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉津阁避暑和南皋二首 其二","author":"黄衷","text":"滚滚黄尘陆海涛，酒禅偏许醉中逃。\n足音自是空虚少，道气何如畏垒高。\n蛙答溪喧浑鼓吹，竹开风箨总旌旄。\n炎天一奏阳春调，白首江乡仰谢陶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠甘泉翁二首 其一","author":"黄衷","text":"十年江国梦，一棹蠡湖秋。\n逗野裴堂绿，纡山谢宅幽。\n有怀知独咏，无事忆同游。\n休弄蒹葭月，蒲轮访乐丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠甘泉翁二首 其二","author":"黄衷","text":"逊节捐留务，明心抗朴忠。\n望隆三立上，功自四时中。\n朝著归清议，邦人识素风。\n增江多间气，重见菊坡翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵丫山梦谈玄","author":"黄衷","text":"微名尘外弃如违，静觉风花款款飞。\n种柳有时同靖节，著书无意拟韩非。\n出郊长爱逢农暇，问齿相将到古稀。\n真诀只从真想得，观端栖寂谩深祈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和丫山对菊","author":"黄衷","text":"有客言从菊会还，幽人清思偶相关。\n不燃夏圃三更火，何得秋光几日閒。\n赏胜只疑壶里变，窥奇真似管中班。\n病予已分江湖老，谁道餐英可驻颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和觉山登罗浮二首 其一","author":"黄衷","text":"何处诗筒披锦线，风流真叹佐时贤。\n青骢高步皆馀地，黄鹄孤飞更刺天。\n柱下纪言推綵笔，人间济险藉楼船。\n寒林自与荣途隔，深愧无因得赠鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和觉山登罗浮二首 其二","author":"黄衷","text":"石磴盘回方引线，苍崖漫刻认前贤。\n平连五岳还淩海，上瞩三台恰近天。\n动爱碧云随舄履，坐堪芳霭逗衣船。\n翠微亦有黄龙洞，风雨时来电可鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄毛东塘大司马时开府南宁","author":"黄衷","text":"海内贤流独擅名，八闽曾许拜前旌。\n中朝望地常悬席，南纪高勋吏仰成。\n分阃等威唐晋国，承华宾客汉桓荣。\n运筹多暇应觞咏，邕管梅花玉雪明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题野舫送周医士","author":"黄衷","text":"明月清歌独扣舷，溪桥曾见一帆悬。\n渡头人静暂横浦，箕尾星高旧济川。\n爆竹声催分岁酒，腊梅花放到家天。\n定知金匕多灵品，幸寄黄湾钓石边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除日立春和丫山","author":"黄衷","text":"鸡声送腊遂迎春，饷岁乡风自可循。\n照眼只堪花胜丽，拂冠偏爱柳条新。\n土牛邑令情何厚，金马交游梦岂频。\n为报玄冥须却避，东皇今日便持钧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日和丫山","author":"黄衷","text":"人间胜事只图新，试笔看君句有神。\n鹊侣悦晴纷叫噪，萱芽含冻向嶙峋。\n遗樽幸许先尝酒，折简将期共探春。\n可笑狂夫狂到底，歌声中夜彻高旻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"叠前","author":"黄衷","text":"满拟芳郊看报春，止缘冲雨向因循。\n阶除书带只如许，门巷桃符已换新。\n着体不妨绒袖薄，醺颜应怯羽觞频。\n草堂人日哦清韵，真荷高情重转钧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"叠后","author":"黄衷","text":"衡门又见画鸡新，独有高斋守谷神。\n草色沿溪青委曲，云姿弄野碧嶙峋。\n共知莲漏辞长夜，谁貌梅妆卧早春。\n万壑千岩催发育，却嫌鸿雁恋秋旻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和南皋春阴苦寒","author":"黄衷","text":"招摇先为转鸿濛，有客残貂尚避风。\n已觉南陬旸谷暗，悬知西塞雪庐穹。\n寻梅箬帽履何素，煨芋山炉火自红。\n独坐书床闲料理，三春云物会昭融。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十三日晴和南皋二首 其一","author":"黄衷","text":"何幸试灯夕，初看万象清。\n诗投吴茧净，香染越罗轻。\n乐社樽相属，严城锁未横。\n御楼延故老，不负北宵晴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十三日晴和南皋二首 其二","author":"黄衷","text":"宝月娟娟媚，谁能惮夜寒。\n舞怜翻广袖，曲听度长干。\n抚事追曾赏，留芳为所欢。\n腊梅真冷艳，长得倚屏看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其一 兰","author":"黄衷","text":"甘露香何古，枯桐调自高。\n花边闲处士，不解怨离骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其二 菊","author":"黄衷","text":"自抱幽人况，宁辞青女霜。\n一枝秋圃上，爱杀浅鹅黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其三 木犀","author":"黄衷","text":"老气苍莓合，幽英屑玉开。\n有人曾赏味，道是月中才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其四 海棠","author":"黄衷","text":"疏梗苍蟠铁，芳须嫩缀金。\n情知花韵别，那藉草堂吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其五 瑞香","author":"黄衷","text":"轻紫含精白，孤香逼晚风。\n居然岁寒思，除是玉梅同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其六 酴醾","author":"黄衷","text":"偶植还篱落，春风也弄芳。\n三千宫黛晓，休妒露华香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其七 山茶","author":"黄衷","text":"丹蕤攒宝相，此种贺州来。\n千叶滇南白，都非越客栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其八 紫薇","author":"黄衷","text":"惯得誇明丽，曾依画省郎。\n几枝斜映水，浮弄紫霞光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其九 锦堂春","author":"黄衷","text":"并房金粟密，剪缬浅红光。\n莫把山丹看，临池夏日长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其十 碧桃","author":"黄衷","text":"高花初喷雪，嘉实亦维时。\n可似西池品，还应曼倩知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其十一 芙蓉桃","author":"黄衷","text":"叠绛迎春旭，何曾解拒霜。\n幸观形色外，须信有骊黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其十二 海石榴","author":"黄衷","text":"浮俗狎孤艳，誇名赛玉环。\n愚溪初有赋，憔悴感朱颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其十三 绣毬","author":"黄衷","text":"剪刻天孙巧，龙髯紫蔓敷。\n春风百子帐，香暖玉流苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其十四 夹竹桃","author":"黄衷","text":"戢戢红葩静，亭亭翠幄深。\n可希金玉誉，恨是未虚心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其十五 玉簪","author":"黄衷","text":"南薰破孤芳，天然去雕刻。\n惟有昆崙僧，知是江妃物。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其十六 杜鹃","author":"黄衷","text":"恻恻古帝魂，血尽江草湿。\n满放春山花，赭遍春山色。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其十七 萱","author":"黄衷","text":"种种江湖思，虚疑草有神。\n只今尘土客，但忆浣衣人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其十八 鸡冠","author":"黄衷","text":"秋花照远林，蕊蕊真形色。\n恐有北场鸡，介羽割丹帻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其十九 柏","author":"黄衷","text":"移根曾宿雨，舒干渐如铜。\n试问风霜操，终齐十八公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其二十 梅","author":"黄衷","text":"曾访罗浮隐，梅花别有村。\n旧盟寒未得，移植卧云轩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其二十一 榴","author":"黄衷","text":"□贝秋风实，丹砂夏日花。\n何年安石国，不上指南车。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其二十二 红梅","author":"黄衷","text":"总爱酡颜浅，谁知玉骨寒。\n昨宵孤月影，亦上曲栏干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其二十三 荔枝","author":"黄衷","text":"自冠莆阳谱，还栽野客家。\n所希收令实，未恨少名花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其二十四 杨梅","author":"黄衷","text":"谁接东洲本，稽山浪得称。\n他时红粟颗，知映玉壶冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其二十五 郁李","author":"黄衷","text":"花解冲寒放，将同白柰栽。\n粤人浑未识，呼作贺正梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其二十六 梨","author":"黄衷","text":"最爱融春晓，飞花月满台。\n冰浆传赐好，何似小园栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其二十七 佛手柑","author":"黄衷","text":"我观龙象相，千手各有执。\n愿化青林株，手手垂宝实。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其二十八 柑","author":"黄衷","text":"闻道龙城野，金苞亚绿云。\n么么三两树，何处比封君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其二十九 橙","author":"黄衷","text":"色近坤裳正，香藏翠袖春。\n世情甘渍密，谁道味非真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其三十 桔","author":"黄衷","text":"芳根连楚泽，题作洞庭君。\n几树园池上，相看岁未分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其三十一 金橘","author":"黄衷","text":"昔进温成御，惟闻自吉州。\n荔枝天下品，曾掩玉环羞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其三十二 绿橘","author":"黄衷","text":"巴陵标榜在，谩得绿为名。\n不见清霜晓，黄金铸却成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其三十三 香橼","author":"黄衷","text":"团团车盖绿，灿灿御袍黄。\n只许牙盘荐，那薰锦帐香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其三十四 枣","author":"黄衷","text":"纤末心皆赤，新成实已嘉。\n豳风终可咏，底用大如瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其三十五 樱桃","author":"黄衷","text":"名次楞梨录，遥分桂岭阴。\n嗟嗟萧较理，寄恨满苍林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其三十六 椒","author":"黄衷","text":"第功虚药笼，献颂自春朝。\n畸客无芳思，犹堪赋远条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其三十七 枸杞","author":"黄衷","text":"先春辞枳棘，凉露净篱边。\n听到神厖吠，悠悠几百年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其三十八 决明","author":"黄衷","text":"朝采决明花，暮采决明实。\n他日偓佺翁，见我真颜色。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其三十九 丝瓜","author":"黄衷","text":"散走青蛇蔓，阴宜野鸭沙。\n溪翁三百岁，几食并头瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其四十 苦瓜","author":"黄衷","text":"闽圃红穰子，吴中锦荔枝。\n江乡多此味，下箸涕还垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其四十一 鹤","author":"黄衷","text":"稍拟崆峒侣，玄衣惜未深。\n闲林风露夕，梅月送清音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其四十二 凫","author":"黄衷","text":"数十眠莎净，多缘化舄飞。\n白翁云水性，却恋钓鱼矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂兴四十三首 其四十三 鱼","author":"黄衷","text":"满尺仍青鬣，纤纤鳞已金。\n陶朱三岛业，未见化机深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和南皋春日閒居写怀二首 其一","author":"黄衷","text":"知隔清虚尚几尘，风花偏得伴閒身。\n盆池独赏红蕖早，陶鼎先尝紫蕨新。\n几格有书曾弭癖，刀圭无药可祛贫。\n溪山胜处烦延访，只恐渔樵是异人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和南皋春日閒居写怀二首 其二","author":"黄衷","text":"乳燕喃喃弄晓晴，苍松濯濯谢浮荣。\n岂无羊仲堪同调，自是陶潜得此生。\n塞窦肯驰争道马，开枰犹动过河兵。\n欲苏病肺惟凉夜，隐几银潢半已横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"靖夷赠蔡半洲","author":"黄衷","text":"礼极分符重，星随画壤明。\n鬼神窥将略，山斗俨儒荣。\n令肃鲸鲵窟，功收虎豹城。\n铁舟馀旧迹，铜柱契前盟。\n笑鲜雄酋组，言韬武士缨。\n来同光帝德，休战播天声。\n伐大心弥小，怀虚宠不惊。\n台端姑总宪，位正允孤卿。\n家庆芝英丽，亲筵豸綵呈。\n况闻南海曲，嘉谷答生成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]