[{"title":"题秀南兄寿册","author":"张嗣纲","text":"五岭南来祝寿星，天伦燕乐赋长庚。\n风尘海内皆朋友，桃李园中有弟兄。\n泉石未应淹岁月，芝兰犹喜挺阶庭。\n介眉酒熟斑衣舞，松菊长留晚节馨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端节三日偕向繁兄弟观竞渡","author":"张嗣纲","text":"相携书剑出江干，竞渡双龙海宇寒。\n竖赤枭从天上望，夺红人自社中看。\n移舟繫柳诗新赋，把酒临江兴倍欢。\n自是蛟龙镶爪翼，满江风雨浪漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端阳幕中喜彭祁连自大鹏携酒过酌因示兵略酒阑诸部献俘至","author":"张嗣纲","text":"雾暗青山晓雨零，孤舟此日繫淘泞。\n云移树色疑帆色，风送涛声杂鼓声。\n逢节每愁倭作祟，衔杯犹喜客多情。\n折冲尊俎知谁是，酒进西河已用兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端阳连日大雨　时有谮予者上峰不察故作此诗","author":"张嗣纲","text":"天涯佳节又逢端，怀古能无吊屈原。\n再见炎方悬虎艾，不知何处竞龙船。\n参差天上旌旗闪，断续波间鼓角喧。\n我亦夺红心未已，只愁斜雨暗江村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重登大海楼","author":"张嗣纲","text":"夏日重登江上楼，凭栏怀古思悠悠。\n窗涵月色花阴叠，帘捲潮光桂影浮。\n石燕远翻天际浪，沙鲸近戏海门秋。\n东南共有长江兴，坐对金樽醉未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中夜眺","author":"张嗣纲","text":"楼船兀坐水连天，遥望波光思渺然。\n山色有无江水外，涛声断续岛洲前。\n喜看南海归琛赆，犹惧东夷起燧烟。\n刁斗击残头上月，枕戈空自夜无眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周日贞招饮大鹏东山寺 其一","author":"张嗣纲","text":"古木森森野寺凉，飞花绕涧露凝香。\n云深殿阁泉声细，雨过庭阶藓迹长。\n圯上受书惭孺子，筵前顾曲羡周郎。\n招邀共有飞觞兴，笑把蔷薇醉欲狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周日贞招饮大鹏东山寺 其二","author":"张嗣纲","text":"步入梵宫路不迷，四山高插与天齐。\n龙头石吐飞泉冷，雉尾云生落木低。\n牧笛吹残村犊稳，禅经听罢野猿啼。\n止戈幸得逢僧话，回首东山月满溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再访梅庵上人不遇","author":"张嗣纲","text":"几年不到梅庵寺，今日重过见早梅。\n石凳花开舄已往，松林烟静鹤初回。\n师因采药云深去，客为寻幽雨后来。\n却羡经坛清净处，菩提应不着尘埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"热池","author":"张嗣纲","text":"电阳南望几峰峦，溪涧潆洄萃此川。\n半月池中涵瑞气，万年山下吐温泉。\n何人再爇丹炉火，仙女长吹玉鼎烟。\n天设一泓开造化，太和元气在尊前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七星岩","author":"张嗣纲","text":"天开洞府亦奇哉，白石磷磷磊欲颓。\n一线羊肠通紫砚，三龛象迹现如来。\n云封药蔓迷樵径，风送荷香入酒杯。\n尘境不如仙境好，可堪民力竭楼台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21142,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿黄修撰","author":"张嗣纲","text":"闻道仙风甘水滨，苍松白石旧为邻。\n华封此日三多祝，胪唱当年第一人。\n诏拜彤廷红日近，筵开紫府綵衣新。\n如翁矍铄真难得，洞口桃开岁岁春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21143,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石城道中口占","author":"张嗣纲","text":"石城歧路草芊芊，野岭勾盘虎踞连。\n结伴远游青嶂外，思亲遥望日云边。\n精忠报称知何日，鞠育劬劳已历年。\n自恨晨昏疏定省，天涯惟祝海筹添。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21144,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"话别陈孝廉润寰 其一","author":"张嗣纲","text":"飘零书剑郡城东，慷慨如君自不同。\n献策独怜苏季子，论文犹重汉元龙。\n飞觞共醉三更月，对局还敲半夜钟。\n此别江山应有约，五羊期尔控青骢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21145,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"话别陈孝廉润寰 其二","author":"张嗣纲","text":"阆苑逍遥旧有声，春风拂马古端城。\n七星景落岩前耀，五色云凝足下生。\n谈笑当筵鸥鹭狎，文章动笔鬼神惊。\n他年驻节重逢日，莫惜琴尊访旧盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21146,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄愧知返闽","author":"张嗣纲","text":"漫携书剑过端州，端水源来处处流。\n绛帐昔誇桃李富，黄堂今际凤凰游。\n无鱼肯信空弹铗，跨鹤那堪独漾舟。\n归去八闽多著述，词华应续鲁春秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21147,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄子宫之西粤绛帐","author":"张嗣纲","text":"几日同歌弹短铗，一朝话别倚孤蓬。\n衣冠南海声名重，裘马西州闻望隆。\n象群春明花菡萏，雁峰云净月玲珑。\n枝头若买苍梧醉，须赋名山寄剡中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21148,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日同韩懋兼韩擢庭罗伯光林胤招集饮西市","author":"张嗣纲","text":"西市桥边黄鹤迹，青尊花下几人同。\n竹林漫酌琼觞月，萝径频吹玉笛风。\n抚掌莫嗟前日事，藏阄且入少年丛。\n相逢欲就平原赋，授简吾惭似庾公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21149,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日霍念赋卢原甫集饮陶紫阁因之楼询我琼山之胜","author":"张嗣纲","text":"因之楼上眺风烟，四望山川意惘然。\n把别昔愁琼岛月，相逢今喜白云天。\n衔杯竹下心先醉，剪烛花间句共联。\n胜境可堪诸社道，撑空五指落尊前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21150,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答王稚韬仙示之作","author":"张嗣纲","text":"闻道仙风第一流，閒来采药坐丹丘。\n笙吹松下月华满，局对山中夕照收。\n黄鹤飞来银树晚，青牛跨去玉关秋。\n茅君小传还堪读，天地团团一泛舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21151,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日凭喜闻招郭延年同饮白鹿社","author":"张嗣纲","text":"白鹿山河一径开，故人载酒共徘徊。\n寻幽觅得南隅社，招饮同倾北海杯。\n好雨池边沾席过，清风江上逐人来。\n留题赋就翩翩雅，尽是河东八斗才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21152,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题岭南挺秀寿册","author":"张嗣纲","text":"五岭盘桓峙翠微，星高南极耀江湄。\n青牛紫气来函谷，白石沧波老钓矶。\n花发开尊频对客，月明觅纸数呼儿。\n逍遥鸠杖陶三径，笑指庭兰第一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21153,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜","author":"张嗣纲","text":"落叶飘梧夜未央，新秋爽气扑潇湘。\n银河斗转金茎冷，珠海烟生玉露凉。\n栏外月移花影瘦，枕边风送漏声长。\n谁家砧杵城头急，惹起征人又断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21154,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日同黄修和卢原甫集饮何季文别业观妓","author":"张嗣纲","text":"夏日尊开郭外欢，竹林深处尽琅玕。\n帘开水阁见山影，坐对冰弦净月魂。\n乐剧酒同河朔饮，醉酣花似洛阳看。\n知君留客殷投辖，乍听娇歌又凤鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21155,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华表石","author":"张嗣纲","text":"巍峨兀立耸山灵，世上相传指赋星。\n既是肖僧为地卫，何须助寇动天兵。\n孤高列炬堪焦烁，半凿纡谟始战征。\n华表柱头题汝后，永清山水静西宁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21156,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁文仲和尚石","author":"张嗣纲","text":"怪石千寻开色相，不将一苇渡沧溟。\n只身天地作禅字，一念菩提即佛经。\n锡杖未悬非故体，袈裟不替是真形。\n本来忘语肝肠在，喜听潮音礼上清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21157,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送卢章侯年丈罗定应试","author":"张嗣纲","text":"弯孤策杖耀威风，名冠时流自不同。\n幕府定应虚左席，诸曹何敢望前戎。\n拟将长技穿杨绿，况复精忠贯日红。\n此去纪昌知遇早，看君千骑即飞雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21158,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题崇先兄齿德荣褒寿册","author":"张嗣纲","text":"奕世衣冠旧有声，长生期与赤松盟。\n天恩高厚龙章重，仙侣逍遥鹤发轻。\n阆苑尊开倾玉液，蓬瀛筵设列金茎。\n明廷百岁褒人瑞，凤诏于今已到兄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21159,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜崇鉴弟捷报","author":"张嗣纲","text":"昨夜金星灿紫微，何来捷报马如飞。\n群才竞拟标黄榜，仲子能先竖赤旗。\n最喜秋香生梓里，应知春色满皇畿。\n今朝暂醉槐黄酒，指日还看柳染衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21160,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄贵宁兵宪油铭二兄","author":"张嗣纲","text":"炎天万里隔黔阳，云树音书滞一乡。\n花萼春深应秀丽，雁鸿秋好欲翱翔。\n君耑南镇兵权重，我倦西游剑气长。\n闻道靖苗需猛士，可能推毂绿沉鎗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21161,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何如弟赴试礼闱","author":"张嗣纲","text":"珠江此日送行旌，把酒河梁几弟兄。\n愧我岭南虚剑戟，看君蓟北擅才名。\n人逢国监春生色，赋就甘泉早寄声。\n圣主恩深如顾问，为言武疏未全行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21162,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"彭祁连著书大鹏诗以寄之","author":"张嗣纲","text":"崚嶒高阁卧南阳，著作能无制锦囊。\n不为兵戎驱鳄患，应怜苍赤苦鸱张。\n书成岁月松筠老，图绘风云石室藏。\n国士由来终遇主，知君鹏翮即飞扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21163,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"果洲","author":"张嗣纲","text":"灵屿孤悬巨浸中，如拳嵂兀峙苍穹。\n飞涛日散山阴雪，激浪时兼广莫风。\n天成粒粟王图并，地设丸坭禹甸同。\n何日建桥观日出，秦皇驱石此神工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21164,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和张参军竹搆亭","author":"张嗣纲","text":"将军竹搆小亭幽，坐对南山日运筹。\n曲槛斑文垂豹尾，高轩翠干琢龙头。\n杯传筼篆飞犀兕，剑挂苍筤射斗牛。\n今古艳谈东鲁事，何人能解七贤游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21165,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鸡西献俘大雨","author":"张嗣纲","text":"鸣铙进榜入鸡西，骤雨狂风四望迷。\n谁谓挥戈能转日，自怜披甲欲沾泥。\n功成澥渤霏烟靖，怨入平芜荒草萋。\n可惜山翁犹未醉，群儿争唱白铜鞮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21166,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"擒送贼兼柬何青霞","author":"张嗣纲","text":"匹马何辞雪夜劳，目中小丑不须逃。\n七擒曾见获魂慑，三气方知亮计高。\n床上捷书应折屐，天涯载酒有同袍。\n蔡人亦是吾人血，渤海于今尽卖刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21167,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得地","author":"张嗣纲","text":"踏破芒鞋觅地难，廿年今始见重峦。\n形成双凤冲天起，局转群龙护穴蟠。\n最喜邑城为武库，更逢潴水灿文澜。\n青天有意开奇胜，留与先人一席安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21168,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"思圣弟三水庠报","author":"张嗣纲","text":"文名久擅穗城西，佳士新词入品题。\n江淹彩笔曾经梦，刘向青灯不负藜。\n礼乐金声光月伴，衣冠柳色映烟堤。\n莫言三水飞鸿晚，伫听音书报紫泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21169,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答四弟贺添仲孙之作","author":"张嗣纲","text":"蹠掌青云当户开，再逢维岳降祥来。\n莲峰翠耸金牛渡，珠海光投玉燕怀。\n但愿门前垂五柳，敢誇日后应三槐。\n积书幸得儿孙读，可有文章接上台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21170,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄四弟卜筑夷门","author":"张嗣纲","text":"昔年山穴隐封茔，此日高栖彩凤城。\n策画未工田舍计，贻谋惟善子孙营。\n须知卜筑如灵宝，更忆围园似邵平。\n老去只愁风土恶，早迁仁里乐吾生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21171,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕","author":"张嗣纲","text":"乡关遥隔海天长，孤馆寒灯夜未央。\n随俗送穷频酌酒，怀人多病一沾裳。\n十年书剑空成梦，半世风尘也自伤。\n今日尽禳东浙事，年来斑舞醉壶觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21172,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕立春","author":"张嗣纲","text":"江阁潮潆水槛开，忽惊残腊送春来。\n梅花片片飞寒玉，葭管霏霏起候灰。\n鸡鶒当流迎日舞，雁鸿排阵带云回。\n天机物色如环转，何限新晴入酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21173,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送文君直之任左司","author":"张嗣纲","text":"祖帐飞飞拥旆彤，章逢才子驾文龙。\n青萍剑淬三丫港，赤羽旗高九折峰。\n鳄暴昔年今已去，虎韬此日客相逢。\n月明若过前尊路，尚有渔樵可问踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21174,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初度自述","author":"张嗣纲","text":"六十年来又一秋，此翁矍铄尚堪侯。\n北堂喜见斑衣舞，南国还看铁笔投。\n未信门前空雀网，曾闻车后载鱼钩。\n丈夫莫恨功名晚，剑气时高射斗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21175,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送湛邦炜之任钦州守戎","author":"张嗣纲","text":"男儿侯骨自天成，年少登坛独擅名。\n象岭风生疑说剑，龙门烟靖好谈兵。\n传家岂独誇文简，报国还来有武卿。\n闻道交夷心胆破，湛恩期尔被边庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21176,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西宁与徐献廷夜话","author":"张嗣纲","text":"匹马频过细柳营，相看意气足生平。\n无能并许歌宾馆，有约何辞重薛城。\n笛奏辕门风淡淡，琴弹幢幕月明明。\n高山流水知音侣，海内论心几弟兄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21177,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西南话别卢璋侯刘崇圭兄弟","author":"张嗣纲","text":"西南树色映参差，江水滔滔路转歧。\n君向蓟门风遇顺，予从龙水势非宜。\n临流把酒难为别，引剑长歌只自知。\n细听黄莺音百啭，迁乔幽谷两何为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21178,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西宁遇盂兰节有感","author":"张嗣纲","text":"兰盂愁节碧兰花，倚遍栏杆日未斜。\n乍见鼎灰将化蝶，更闻钟磬集啼鸦。\n人逢节序情多感，我强登临恨转赊。\n怅望白云遥涕泪，自怜飘梗滞天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21179,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辽报再陷开原","author":"张嗣纲","text":"羽书遥自蓟门驰，关塞萧萧动鼓鼙。\n血战已闻膏草莽，神谋何日复城池。\n女真祸宋须张浚，回纥危唐急子仪。\n自古中兴凭将略，草茅不乏帝王师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21180,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山家白菊西宁馆","author":"张嗣纲","text":"苍枝玉蕊出山家，晚节奇香更可嘉。\n瑶朵疏疏蒙雨露，银缨兀兀灿云霞。\n何郎月下飞觞急，仙女霜中点鬓华。\n堪笑东篱空似锦，可无陶令到天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21181,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄怀唐得占年丈","author":"张嗣纲","text":"漫携书剑访吾曹，路隔云山梦亦劳。\n宾馆自怜歌短铗，天涯谁肯念绨袍。\n闻君细柳威常肃，知尔长杨赋渐高。\n几度月明思过剡，马蹄将发又蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21182,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"下第斗纸牌戏呈周五十九年丈","author":"张嗣纲","text":"三门四种帙翩翩，百万争雄巧斗先。\n鏖战有文空没意，半枝无贯实堪怜。\n年过老大非三十，事历艰难苦万千。\n多少行囊消索尽，再来不值一文钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21183,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和郭昌平舟中戏呈周冯之作","author":"张嗣纲","text":"十月西风卉渐黄，夹河杨柳半凋霜。\n客衣冷暖曾谁问，世事浮沉只自伤。\n且喜仙舟同郭侣，更从赤壁识周郎。\n每看大树催行色，共把青尊醉异香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21184,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊马甲营","author":"张嗣纲","text":"马甲营前江水回，黄龙青雀集江隈。\n风吹锦缆金成韵，雪满牙樯玉作堆。\n舞絮条条垂折柳，飞花片片点寒梅。\n归舟日对长亭醉，薄暮愁听画角哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21185,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"八僧","author":"张嗣纲","text":"群僧杖舄赴西京，夹道行看柳色青。\n欲向天边迎佛骨，岂期树下听禅经。\n飧霞得意忘归路，采药何心卧草亭。\n四十年前遗钵处，至今风雨尚冥冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21186,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观祀幽坛　时卜知县乾没幽粮祀不成祀","author":"张嗣纲","text":"荒丘一望已凄凉，况复西山古战场。\n日暗群鸦啼落木，烟深饥雀噪斜阳。\n祀崇孤社天恩重，鬼到幽坛夜气长。\n寄语宁侯卜氏子，莫多违慢侮城隍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21187,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过刘都护山居赏菊","author":"张嗣纲","text":"马蹄踏破岭云来，为爱名花似锦堆。\n露朵秋英丛异品，金枝玉叶不凡才。\n多因烂熳成诗句，更喜芳菲入酒杯。\n不是主人奇晚节，山中陶径为谁开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21188,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜陆养和督汎","author":"张嗣纲","text":"小陆才猷旧有名，天骄胆落惮长城。\n锦裘绣帽陵羊李，仗策持筹失勃平。\n论定每劳青海戌，功成还拟赤松盟。\n只今共济欢鱼水，同泛长江醉月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21189,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜陆养和督汎","author":"张嗣纲","text":"双旌冉冉自天来，银岛金门郁气开。\n海色昔时浑似雾，风声今日迅如雷。\n谈兵夜静鱼龙泣，击剑光寒鬼魅催。\n江左未应轻借寇，还期推毂重边台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21190,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿林岳野老七秩步韵","author":"张嗣纲","text":"高秋一鹤驾沧溟，飞傍华筵玉桂庭。\n不是丹砂来瑞翮，如何紫府醉霞龄。\n长生学得神仙药，舞綵犹闻教子经。\n鸠杖逍遥芝径外，等閒出入步虚亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21191,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘崇圭莅任西山函口","author":"张嗣纲","text":"燕台招骏卫金堤，接武长驱奋骥蹄。\n书锦登坛荣故里，宵衣筹国帖蛮溪。\n尊开端水投醪足，回应西山唱诺齐。\n左顾辽阳推毂重，龙飞天上下金泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21192,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"腊月之新安再观石穴将营母葬事","author":"张嗣纲","text":"几回飞梦到南头，腊月风波逐远游。\n只为双亲埋玉佩，岂期百代覆金瓯。\n群峰拥护坟三叠，五岭盘旋土一丘。\n石巧不妨频着眼，翘看雨露下松楸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21193,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"葬后有感因示诸弟侄","author":"张嗣纲","text":"青山一望且长吁，满目蓬蒿起白狐。\n后葬每惭非五鼎，前丧遗恨在三虞。\n烟凝谷口疑魂聚，露滴松梢带泪濡。\n但得先灵安马鬣，相逢何必论堪舆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21194,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]