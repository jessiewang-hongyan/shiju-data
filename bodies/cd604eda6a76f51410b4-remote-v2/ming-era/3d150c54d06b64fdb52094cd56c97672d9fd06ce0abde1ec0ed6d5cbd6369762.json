[{"title":"雨中寓多寻山庄 其五","author":"张子翼","text":"远峰列石城，众水护山郭。\n禾黍遍郊原，鸡声暗篱落。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10385,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中寓多寻山庄 其六","author":"张子翼","text":"枫叶藏蛋雨，春江作画图。\n谷回诸径浅，天远数峰孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10386,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中寓多寻山庄 其七","author":"张子翼","text":"碧草侵环堵，江月醮柴门。\n三咽谁家笛，孤砧何处村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10387,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中寓多寻山庄 其八","author":"张子翼","text":"天籁凉生竹，山鸠鸣向人。\n偶逢社日鼓，识破陇头春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10388,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中寓多寻山庄 其九","author":"张子翼","text":"细雨送秋声，明蝶竞春蕊。\n不见绕梁人，相思隔江水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10389,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中寓多寻山庄 其十","author":"张子翼","text":"地阔炊烟集，年登米价轻。\n不知宽一分，犹似枉平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10390,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈仰坡景仁昆季八首 其一","author":"张子翼","text":"君家赐姓自姚虞，上舍学生上谏书。\n世系绵绵昌海岱，英声济济动乡闾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10391,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈仰坡景仁昆季八首 其二","author":"张子翼","text":"少年昆季尽辉煌，自古元方又季方。\n宋氏风流今不远，苏家文史更谁强。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10392,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈仰坡景仁昆季八首 其三","author":"张子翼","text":"从游函丈为离经，自愧生儿尽景升。\n信到铜炉无弃物，敢于藜火附传灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10393,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈仰坡景仁昆季八首 其四","author":"张子翼","text":"窗开晓日荔阴浓，几迓薰风竹翠重。\n笔梦江淹添五彩，文思曼倩足三冬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10394,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈仰坡景仁昆季八首 其五","author":"张子翼","text":"十载芸窗作卧龙，三春柳色映桃红。\n骥逢伯乐群空北，经授康成道已东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10395,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈仰坡景仁昆季八首 其六","author":"张子翼","text":"横经彻夜多程石，草阁从人数问奇。\n满座春风来玉案，一天时雨下莲池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10396,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈仰坡景仁昆季八首 其七","author":"张子翼","text":"云龙蓂荚磐交欢，话到分歧去住难。\n天入渭阳将恋恋，路当乌石水漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10397,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈仰坡景仁昆季八首 其八","author":"张子翼","text":"侵阶历历池边雨，结盖亭亭陇上云。\n抱病山斋频徙倚，不堪鸿雁暂离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10398,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"林介石送磁莲盆喜赋二首 其一","author":"张子翼","text":"衡门尽日抱清虚，日午犹翻种树书。\n从此盆荷开夏日，侬怀惟有葛天如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10399,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"林介石送磁莲盆喜赋二首 其二","author":"张子翼","text":"石鼎何年勒篆文，烟花大半落苔痕。\n草堂一入谁为主，诗句何妨改谢墩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10400,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感怀四首 其一","author":"张子翼","text":"酒能养病怀偏拙，老爱看书目易昏。\n世事相违成寂寞，不堪惆怅倚柴门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10401,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感怀四首 其二","author":"张子翼","text":"书抛满箧从儿懒，径隐通衢任客疏。\n渐老看花成底事，暮云天远独愁予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10402,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感怀四首 其三","author":"张子翼","text":"农家岁熟儿犹哭，海上兵添赋岂堪。\n抱病杞人曾过计，春风疑不到天南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10403,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感怀四首 其四","author":"张子翼","text":"清澜海上血流盈，水寨犹屯防守兵。\n反侧杨么浑未定，未知何日见澄清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10404,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华堂天晓歌为年丈居泉诞子作 其一","author":"张子翼","text":"汉家获鼎已名年，宝篆羌传出海边。\n柱下金环君信不，有文掌上尚依然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10405,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华堂天晓歌为年丈居泉诞子作 其二","author":"张子翼","text":"十里波光四面开，清秋铜鼓接蓬莱。\n嵩云自昔钟申甫，奇甸于今产异才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10406,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华堂天晓歌为年丈居泉诞子作 其三","author":"张子翼","text":"座上岭云归石峒，尊前渔火照江蓠。\n主翁抱子浑无事，点破江山数局棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10407,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华堂天晓歌为年丈居泉诞子作 其四","author":"张子翼","text":"充闾喜气按歌长，江上歌声皆绕梁。\n渺渺轻舟追范蠡，徐徐云雨赋高唐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10408,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华堂天晓歌为年丈居泉诞子作 其五","author":"张子翼","text":"百年事业此悬弧，倚席弹冠更献图。\n欲比荀家齐淑爽，先于屏上指之无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10409,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华堂天晓歌为年丈居泉诞子作 其六","author":"张子翼","text":"清澜海上绿于云，阁上看云坐夕曛。\n炯炯辰星劳望气，彬彬诗礼萃人文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10410,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华堂天晓歌为年丈居泉诞子作 其七","author":"张子翼","text":"草堂四壁绕图书，杖倚松风曳短裾。\n解组赋归生事足，老怀惟有葛天如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10411,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渔","author":"张子翼","text":"苍茫惯宿江湖雨，汗漫长浮天地槎。\n夜夜丝纶收巨口，前滩呼酒送生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10412,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"樵","author":"张子翼","text":"眼底冈山皆故主，担头天地一閒人。\n此生不用平津策，笑负初心有买臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10413,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"耕","author":"张子翼","text":"蚤向南山除芜秽，更从负郭饶菑畬。\n长吟却笑南阳子，三顾何劳到草庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10414,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"牧","author":"张子翼","text":"叩角冲冲短笛吹，此心不系得牛肥。\n行人笑问侬何事，日出山岑日暮归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10415,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九鹚莲图","author":"张子翼","text":"一诀千金是九思，丹青独羡夺胎奇。\n画前若解先天意，始信羹墙有仲尼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10416,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"携琴访友图","author":"张子翼","text":"松下迢迢一径寻，丝桐自昔喜知音。\n丹青独解无弦意，曲奏薰风太古心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10417,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三水即事 其一","author":"张子翼","text":"城郭晓烟人避户，沙湾浅水客停舟。\n秋毫难道浑无犯，烽火惊心说未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10418,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三水即事 其二","author":"张子翼","text":"将军阵马载楼船，夜渡潜移泊水边。\n迅扫何时传露布，杞人窃惧有凶年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10419,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江涨一首","author":"张子翼","text":"一夜水声一丈腾，下江如箭上如登。\n世间两利真难事，敡历从今感慨增。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10420,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自良山中","author":"张子翼","text":"沿涧穿溪一径长，拂云晴树郁苍苍。\n绝幽疑是天台境，隔水蝉声送午凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10421,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过梅蓝","author":"张子翼","text":"官路迢迢榕树标，眼前菽麦俯青郊。\n笑予林下忙何事，三过梅蓝底自嘲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10422,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒雨二首 其一","author":"张子翼","text":"寒雨苦不止，同云满太虚。\n漓漓花易绽，脉脉岁将除。\n烹茗徐添火，扃门懒着书。\n有怀多昼寐，凄寂欲何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10423,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒雨二首 其二","author":"张子翼","text":"雨寒霜气袭，风急昼云垂。\n岁暮阴阳短，庭空鸟雀饥。\n愁来诗未遣，老去鬓先知。\n奇字无人问，清斋信杖藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10424,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日","author":"张子翼","text":"纪时逢七日，云物半阴晴。\n世事每如此，春风岂世情。\n流泉田涧落，当户岫云横。\n生事甘疏旷，江山结岁盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10425,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与甘文峰程质斋之建江即事","author":"张子翼","text":"冥色冲寒雨，凉风度浅沙。\n村樵归晚棹，江浦噪昏鸦。\n牧笛声初渺，桥驴思转赊。\n亲知今并辔，谈笑挹霜华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10426,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠李贞宇","author":"张子翼","text":"雀噪人初至，披襟夜向阑。\n价原燕市重，杯惭粤中宽。\n秋圃窥黄菊，春衣纫紫兰。\n江淹辞日富，彩笔梦中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10427,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"建江阻雨","author":"张子翼","text":"积雨何大剧，秋云不肯明。\n雷霆驱魍魉，篱落乏鵁鶄。\n拨闷穷诗骨，冲泥拚酒兵。\n怀人多寂寞，徙倚向江城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10428,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"建江阻涨","author":"张子翼","text":"秋水来天地，江波倾吕梁。\n临流天有堑，欲济河无航。\n世路每如此，人情安可量。\n淹留幽思积，长啸发清狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10429,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日","author":"张子翼","text":"九日人间节，凭高何处登。\n山中甘寂寞，岁序任凋零。\n发短羞簪菊，堂虚酷似僧。\n牛山成往事，吾计祇东陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10430,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"枯椰先祖移居，植椰成林。经八十馀载，仅存其四。今秋忽枯二株，感而赋之","author":"张子翼","text":"酒树天涯种，经秋拥荜门。\n松筠推玉液，风雨妒孤根。\n垂老肝肠折，先人手泽存。\n东园山月吐，犹忆挂梢痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10431,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与沈迎川石圃王肖阳会竹峰府时新月初霁即事","author":"张子翼","text":"开帘诸老会，载魄一弯初。\n寂寂流云外，纤纤密荫馀。\n共怜人莫逆，休问夜何如。\n暂阻南头辔，幽怀尚未舒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10432,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓行","author":"张子翼","text":"万里暝烟静，行人思不禁。\n钓船犹傍竹，山鸟未辞林。\n月照风生袖，星悬露湿襟。\n凤凰台上咏，休作忆山吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10433,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山庄即事","author":"张子翼","text":"龙冈眠半月，石岭出朝霞。\n远水分还合，环山正复斜。\n榔椰森远近，鸡犬接田家。\n乐土儿吹笛，村庄兴正赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10434,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柏山刘工部送已上人韵次之","author":"张子翼","text":"松风聊住杖，秋雨细论诗。\n日转榔阴午，云留客坐迟。\n荣枯惊塞马，岁月看游丝。\n绿水供垂钓，谁联江上词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10435,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登柏山白水湖山舍四首 其一","author":"张子翼","text":"望气开新麓，诛茅结草窝。\n水从方丈落，山似若耶多。\n白发呦呦侣，青尊浩浩歌。\n洞门无俗事，长日挂鱼蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10436,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登柏山白水湖山舍四首 其二","author":"张子翼","text":"龙盘白水地，上有尧夫窝。\n赤脚春游壮，青山晚眺多。\n垂纶无俗事，扣角有长歌。\n江上斜风雨，玄真稳旧蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10437,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登柏山白水湖山舍四首 其三","author":"张子翼","text":"清游移白昼，翘首见龙窝。\n骤雨云雷合，晴江鱼鸟多。\n长杯还自遣，短铗不须歌。\n凭眺金台近，江门未挂蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10438,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登柏山白水湖山舍四首 其四","author":"张子翼","text":"谁是子真谷，瑶林一亩窝。\n禅关看昼永，胜会得春多。\n喜和阳春曲，时闻水调歌。\n眼穷今古阔，烟雨几番蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10439,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"热水亭","author":"张子翼","text":"列岫层悬戟，温泉决溜渠。\n山川潴异气，天地此洪炉。\n溥博心源阔，炎凉世味殊。\n冱寒堪煖浴，万里慰征途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10440,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蚬冈舟中用姚侍御韵书怀二首 其一","author":"张子翼","text":"击楫寒山月，高歌旅兴增。\n黄云连紫水，渔火伴萤灯。\n曙色明沙迥，烟图入画层。\n东南催去旆，子至晓霞蒸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10441,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蚬冈舟中用姚侍御韵书怀二首 其二","author":"张子翼","text":"江山盘郁壮，世路感怀增。\n旅憩云为席，滩明月是灯。\n东瞻天五尺，南跨岭千层。\n夜色看牛斗，分明剑气蒸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10442,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遗表叔冯石塘县尉二首 其一","author":"张子翼","text":"作客楚天远，同官粤峤边。\n独怜葭倚玉，报最政闻弦。\n渔火明深夜，江村起暮烟。\n海天家何处，云物总凄然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10443,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遗表叔冯石塘县尉二首 其二","author":"张子翼","text":"暂停东楚辔，更溯北流江。\n草色迷孤屿，清光接大邦。\n石壕无横吏，村落少惊尨。\n夹岸汀花发，遥遥送去艭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10444,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郁林四月见荔","author":"张子翼","text":"枫叶藏梅雨，新红缀绿何。\n乡心看汝在，旅食恨吾多。\n开国传枸酱，荒台指树陀。\n楚猿兼粤鸟，频唤奈如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10445,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"文家人感文山事","author":"张子翼","text":"秀野开堂旧，簪缨捧匣新。\n粤南求世系，宋室一孤臣。\n千里还丧日，三朝报主身。\n春来看杜宇，带血瘴江滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10446,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋雨","author":"张子翼","text":"淫雨苦不止，山溪溜决堤。\n夏苗浑在水，秋稼总成泥。\n洪范推灾异，衡门□杖藜。\n有怀多抱病，无计学鸡栖。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10447,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙窝雨途即事寄迎川肖阳五首 其一","author":"张子翼","text":"积雨迷山谷，秋田半草莱。\n冈连村牧下，鸟拂冻云来。\n时序悲黄叶，花阴长绿苔。\n怀人江浦上，松下欲徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10448,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙窝雨途即事寄迎川肖阳五首 其二","author":"张子翼","text":"林间风瑟瑟，山上雨霏霏。\n荒径三家集，疏林一鸟归。\n天寒云惨淡，江迥树依微。\n长啸青阴合，弹冠白羽飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10449,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙窝雨途即事寄迎川肖阳五首 其三","author":"张子翼","text":"久为林泉懒，今胡夜雨来。\n偏将知己梦，一向故人开。\n细柳虚前府，平津有汉才。\n竹峰劳远炬，拚醉习池回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10450,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙窝雨途即事寄迎川肖阳五首 其四","author":"张子翼","text":"径黑泥偏滑，人疲路更遥。\n冲寒谁唤酒，出险渐停桡。\n雪兴无明月，诗怀减灞桥。\n相携喜儿辈，昏暮屡相招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10451,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙窝雨途即事寄迎川肖阳五首 其五","author":"张子翼","text":"夜雨忙如此，凉风动远吟。\n云龙怀旧侣，流水待知音。\n千古逍遥梦，百年儿女心。\n丈夫期意气，尊酒喜同斟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10452,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江涨","author":"张子翼","text":"迅雷倾澍雨，溪吼涨惊涛。\n水鸟浮天阔，游鳞倚浪高。\n顺流歌棹易，截苇溯舟劳。\n无限观澜意，浮云与逝滔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10453,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题黄会川退谷卷","author":"张子翼","text":"樊口悬江迥，寒溪带谷斜。\n扪萝堪住杖，仄径不容车。\n雪暗山阴舫，烟深处士家。\n枞篁含地籁，松桧阅年华。\n南郭徐耽鹿，东门忆种瓜。\n地容湖海侧，春比武陵赊。\n绮里能辞汉，玄真尽痼霞。\n知雄机已黜，守黑道无差。\n嘲厌杨雄阁，舟联渔父叉。\n丹炉方授火，岁梦忽惊蛇。\n逆旅难留客，盈虚总搏沙。\n人随玄鹤渺，山剩白云遮。\n执卷仍垂涕，临风忽自嗟。\n我来寻古迹，日暮集昏鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10454,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宜章与大尹陈前峰邑博冯西郭游艮岩","author":"张子翼","text":"怪石通山骨，幽岩泻玉泉。\n扪萝深撷翠，烧烛细寻涓。\n法雨垂如线，崖花笑欲然。\n云根浑不动，钟乳渺难骞。\n古木千章集，金城百雉连。\n远冈迎剑戟，活水下郊埏。\n六月疑无暑，诸峰别有天。\n客杯时泛白，僧定欲钩玄。\n漏远孤钟应，声幽一鸟传。\n号林无定鹿，落树有惊蝉。\n湘泽遥联楚，关河尽拱燕。\n我来访神秘，谢屐任轻便。\n兴倚三春足，閒偷半日缘。\n日迟风荏苒，道夹柳连绵。\n宓父携春菜，湖苏入绮筵。\n闾阎还揖让，桃李尽芳妍。\n雅况须拚酒，公馀日弄弦。\n谷神如有待，兴溢谩濡笺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10455,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]