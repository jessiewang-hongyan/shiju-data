[{"title":"为冯三峨寿李丈人","author":"郑学醇","text":"璧月临朱拱，金飙拂翠帘。\n三秋逢节爽，七帙喜筹添。\n天府曾通藉，云林早养恬。\n仙才原卓荦，耆德愈撝谦。\n秫种陶潜酒，车悬郭贺幨。\n双珠明老蚌，万轴富牙签。\n脔脯麟堪擘，如瓜枣已甜。\n宾筵欢颂祷，五福几人兼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15037,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梧州杂诗晚从金利过灵洲泊官窑驿","author":"郑学醇","text":"万里游燕路，经年复此过。\n人家曲岸少，秋水两涯多。\n暝色遥连树，钟声暗度河。\n微茫知古驿，听尽扣舷歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15038,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊半水窦","author":"郑学醇","text":"野戌依江岸，帆樯集暮艘。\n凉风催木叶，寒色袭征裘。\n岂为悲生事，翻成赋远游。\n飘飘随去住，真觉此生浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15039,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓发崧台驿","author":"郑学醇","text":"鼓角五更初，江城过雨疏。\n长河递明灭，涨水自盈虚。\n鹢指村烟外，猿啼客梦馀。\n潇湘待晴色，临眺几踟蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15040,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过德庆州","author":"郑学醇","text":"古郡晋康名，边江百雉城。\n市烟笼树色，谯鼓杂波声。\n人与飘蓬转，舟从破浪轻。\n自伤迟暮意，宁有壮游情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15041,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华表石","author":"郑学醇","text":"巨石郁嵯峨，长江撼碧波。\n晴烟穷野望，山径续樵歌。\n地险屯营列，时平住牧多。\n维舟询往事，无复说干戈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15042,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"至梧州厂","author":"郑学醇","text":"竹楼山郭外，隐几独中宵。\n江静云徐动，秋深涨渐消。\n物情俱卤莽，国计尽渔樵。\n魏阙驰驱意，空惊万里遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15043,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重访冰井寺","author":"郑学醇","text":"寺忆曾游日，悠悠二十年。\n振衣新物候，举目旧山川。\n绝胜开金刹，高风仰昔贤。\n杖藜成独往，今古意茫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15044,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒韩襄毅公祠","author":"郑学醇","text":"节钺临蛮土，馀威铲大藤。\n乾坤双石阙，祠宇一中丞。\n戡乱资神理，匡时在数宁。\n遥看古铜柱，汉将至今称。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15045,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓雨","author":"郑学醇","text":"山雨连江白，凉飙动竹扉。\n樯乌冲浪发，新雁挟云飞。\n行李经宵湿，岩花待晓晞。\n悬知沾洒意，应长故山薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15046,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"府门驿逢浦亭何使君招游白石洞天因讯黄曙苍年丈","author":"郑学醇","text":"双旌浮傅去，邂逅桂江边。\n采药名山得，题诗卧阁偏。\n年华嗟荏苒，霄汉羡飞骞。\n迢递邕州路，相思有梦悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15047,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旅夜","author":"郑学醇","text":"虚阁凭湘簟，客心秋夜长。\n天光霁生白，江雾晓凝黄。\n堪断砌虫切，风高南雁翔。\n浮生易衰谢，何必计行藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15048,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"集杜五首 其一 陈沧溟郡斋夜宴归卧竹楼值雨","author":"郑学醇","text":"当代论才子，明公独妙年。\n相随万里日，把酒意茫然。\n水静楼阴直，江鸣夜雨悬。\n平生飞动意，无计斸龙泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15049,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"集杜五首 其二 登大雄寺后阁","author":"郑学醇","text":"古寺僧牢落，登临意惘然。\n江流天地外，晚景卧钟边。\n宫阙通群帝，虚空不离禅。\n上方重阁晚，自有一山川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15050,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"集杜五首 其三 重游寺阁醉望","author":"郑学醇","text":"水阔苍梧野，秋风已飒然。\n浮云连海岱，楼阁倚山巅。\n把酒从衣湿，频游任履穿。\n乾坤万里眼，恣意向江天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15051,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"集杜五首 其四 竹楼晓起","author":"郑学醇","text":"床上书连屋，篱边水向城。\n秋窗犹曙色，虚阁自松声。\n起晚堪从事，幽居不用名。\n远山回白首，长啸一含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15052,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"集杜五首 其五 将发梧州","author":"郑学醇","text":"行色秋将晚，青山空复情。\n吏人桥外少，舟楫浪前轻。\n落雁浮寒渚，邮签报水程。\n往还二十载，深觉负平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15053,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高凉杂诗八首 其一 蚬岗道中","author":"郑学醇","text":"旷野犹残烧，长途草半青。\n柳条初动色，黄鸟乍堪听。\n涧水通鱼扈，人烟傍鹄亭。\n凭高时一望，渺渺尽南溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15054,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高凉杂诗八首 其二 开平县晓发","author":"郑学醇","text":"雨气晓氤氲，苍茫路不分。\n数鸡催促漏，百雉暗层云。\n揽策增寒色，褰衣损夕薰。\n途歌兼野哭，愁绪不堪闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15055,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高凉杂诗八首 其三 将至莲塘驿雷雨","author":"郑学醇","text":"迅雷鸣汉外，烨电出云间。\n二气无停晷，玄机若转环。\n惊乌栖不定，牧竖疾驱还。\n古驿堪投宿，遥看隔几山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15056,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高凉杂诗八首 其四 麻桥遇雨","author":"郑学醇","text":"远道逢新雨，云阴送晚雷。\n水田春事急，野渡暮潮回。\n丛竹藏鸡犬，茅檐间柳梅。\n前期犹未定，客思正悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15057,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高凉杂诗八首 其五 吴城对月","author":"郑学醇","text":"春月令宵满，孤城海角悬。\n扬辉粉堞外，流影竹窗前。\n易得还家梦，难忘涉世缘。\n北鸿归欲尽，尺素若为传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15058,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高凉杂诗八首 其六 望海楼","author":"郑学醇","text":"高阁凭虚望，长风送魄潮。\n惊涛吞日月，孤屿薄烟霄。\n使节临珠浦，楼船出汉标。\n岛夷重九译，来享圣明朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15059,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高凉杂诗八首 其七 水东驿","author":"郑学醇","text":"百里间关尽，平林见几家。\n雨添鸡距笋，风落杜鹃花。\n仄径樊新圃，分畦种旧瓜。\n村墟投宿处，野曲自咿哑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15060,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高凉杂诗八首 其八 盐场","author":"郑学醇","text":"煮海供醝策，民生何大劳。\n卤防春水至，突掩雪花高。\n海贾掺盈缩，官衙急布刀。\n仍闻中使出，鸡犬亦萧骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15061,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居十首 其一","author":"郑学醇","text":"十年真窃禄，五亩始为园。\n平楚遥当户，江流曲抱村。\n旧盟存水石，避俗厌卑喧。\n万事无营虑，端居独寤言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15062,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居十首 其二","author":"郑学醇","text":"丘壑吾将老，何妨日闭关。\n物随时共适，心与世俱閒。\n乱水皆通海，疏林不碍山。\n幽栖惬真性，渐喜鬓毛斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15063,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居十首 其三","author":"郑学醇","text":"曲径沿涯入，长松手自栽。\n云迎江树合，帆背夕阳来。\n玩世吾何有，全生但不材。\n高林待归鹤，逗瞑尚迟徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15064,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居十首 其四","author":"郑学醇","text":"方沼才盈亩，春深亦种鱼。\n鸟知求鸟唤，吾自爱吾庐。\n弱柳经烟媚，新荷及夜舒。\n溪边小红翠，采采满怀裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15065,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居十首 其五","author":"郑学醇","text":"野望晴偏阔，青山不厌贫。\n霞烟如待我，水竹最宜人。\n有客论诗草，呼童漉葛巾。\n陶然深一醉，款语任吾真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15066,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居十首 其六","author":"郑学醇","text":"观物通玄理，翛然野趣长。\n鱼因新水陟，鸟为怯风藏。\n社鼓村中急，耕农节后忙。\n地偏无应接，人或拟柴桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15067,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居十首 其七","author":"郑学醇","text":"一榻常高枕，蘧蘧梦亦安。\n鸟飞天向曙，江静阁疑寒。\n盥栉时都懒，琴书日自欢。\n起看墙外竹，碧色自檀栾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15068,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居十首 其八","author":"郑学醇","text":"药裹供吾老，幽栖性独便。\n每寻高士传，无复远游篇。\n柔橹村烟外，江流夕照前。\n沙鸥吾与汝，相对可忘年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15069,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居十首 其九","author":"郑学醇","text":"秋水平江步，家家促纬萧。\n行云低拂岸，落叶暗随潮。\n飞鸟空中度，长虹雨外骄。\n从来会心处，濠濮不须招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15070,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居十首 其十","author":"郑学醇","text":"地岂逃名隐，园因涉趣来。\n凿池开岛屿，坐石刓莓苔。\n衣冷浸江色，杯香袭野梅。\n总于尘境远，俯仰得悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15071,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重游无量寺馆五首 其一","author":"郑学醇","text":"径曲禅扉掩，蝉鸣谷树幽。\n石床堪信宿，竹院喜曾游。\n剥转猿频报，经翻叶落稠。\n随缘忘去住，况为晚山留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15072,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重游无量寺馆五首 其二","author":"郑学醇","text":"梵宇依山郭，秋閒更一登。\n菩提千劫树，贝叶几传灯。\n流水涵真性，浓阴快曲肱。\n自藏衣钵后，七祖是何僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15073,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重游无量寺馆五首 其三","author":"郑学醇","text":"到此心常慊，迟留日又曛。\n青山不改色，白社自离群。\n野竹题诗遍，山泉瀹茗分。\n下方阛阓近，歌管静来闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15074,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重游无量寺馆五首 其四","author":"郑学醇","text":"方丈临丹壑，依然户牖开。\n感时花屡换，乘兴客还来。\n待臈梅将蕊，凌霜菊未摧。\n胜游全不减，灵境异天台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15075,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重游无量寺馆五首 其五","author":"郑学醇","text":"岐海浮孤屿，香台散瞑烟。\n祇寻居士隐，重到法王前。\n白马驮经日，黄龙出狩年。\n从来怀古意，登览一茫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15076,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李绍参裕德过访园中得欢字","author":"郑学醇","text":"长忆风流再晤难，相逢犹表宋钘冠。\n人于事往情偏感，别以年多会更欢。\n阴合柳塘供佐锻，烟轻蒲渚待持竿。\n青苍不改罗浮色，最好同君一醉看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重游周金樵亲家园亭","author":"郑学醇","text":"人似周颙事隐沦，地偏原自远风尘。\n樽开云物千峰迥，坐倚楼台万象新。\n曲径尚馀萝窈窕，断霓时挂壁嶙峋。\n当杯不觉枉歌起，百遍相过乐总真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早春答吴二彦家","author":"郑学醇","text":"茸茸新绿上兰苕，候转东风淑气饶。\n采笔尔应千象纬，白头吾且醉春宵。\n求丹有诀探灵胜，置驿无心到市朝。\n圣世尽收天下士，筑台何但数燕昭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答区海目城馆见寄","author":"郑学醇","text":"初衣久已拂缁尘，烟水遥遥寄此身。\n天际雄风时忆汝，怀中明月远投人。\n五仙石古留洞口，九节蒲生满涧滨。\n玉舄只令如可接，相期挹袖追飙轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初冬林若木罗心葵集冯三峨馆得貂字","author":"郑学醇","text":"云物凄清拂绮寮，每缘幽胜得相招。\n石疑太华峰初擘，宅似杨孚雪乍飘。\n皮骨我惟思住岳，羽翰公等待横霄。\n独怜世事堪杯酒，使节年来尽左貂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕寄林乔化","author":"郑学醇","text":"黄姑中夜度绳河，伫望裴徊秋思多。\n索处忽惊时节换，怀人偏忆雁鸿过。\n麟经绝笔应谁续，马队尘编且共摩。\n何事相思劳问讯，案头烛影几青娥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠费唐衢方伯","author":"郑学醇","text":"东藩左辖命方新，曾是薇垣玉润人。\n岭管旧看龙表气，道傍犹识御时轮。\n虞廷岳牧咨良弼，周室旬宣赖世臣。\n祖命对扬如召虎，肯将勋业数麒麟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送子晋叔往曹溪兼寄冯大昌历","author":"郑学醇","text":"秋风吹雁度浈江，客子担簦上小艭。\n招隐旧盟丛桂曲，藏脩今就玉莲缸。\n上方萝月留僧偈，石磴松涛起梵腔。\n千载法门原不二，尘心都在静中降。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答欧子建","author":"郑学醇","text":"青天西挂赤城霞，卧阁潇潇玩物华。\n鲤讯忽惊云里堕，龙纹遥忆斗间斜。\n长吟祇恨依然越，绝调堪怜和者巴。\n海内才名诸少在，白头人自老楞伽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答太初叔","author":"郑学醇","text":"扰扰尘途五十年，几回清梦寄游仙。\n虚疑鹤驭横三岛，已恨凫飞隔九天。\n往事总归刍狗外，息机长傍海鸥前。\n知君妙得华阳诀，肯授参同契一编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答陈梅伯见讯","author":"郑学醇","text":"清晓银床叶渐稠，病怀潇瑟又深秋。\n非关庾信情多感，自笑韩康迹未幽。\n赤仄尚堪供白堕，短篇那得慰长愁。\n芦花浅水多肥鳜，安得重携上钓舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为园","author":"郑学醇","text":"数亩为园枕水涯，绿阴偏称野人家。\n虽无赋绢千头橘，也有开樽几树花。\n地迥江山供杖屦，人閒宾客尽烟霞。\n药炉经卷吾堪老，不管流年鬓有华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和承畅弟菱塘泛舟韵","author":"郑学醇","text":"菰蒲一曲带江流，凉意潇潇不待秋。\n乘兴漫移兰棹往，闻歌仍为竹枝留。\n烟清叠嶂还孤鸟，天尽沧溟出钓舟。\n此去神山浑不远，与君携手望瀛洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新塔","author":"郑学醇","text":"华盖山前第一峰，惊看新塔又重重。\n桥连极浦潮初长，草满閒阶雪未封。\n栏槛平临千嶂树，海天遥散数声钟。\n东南民瘼忧仍急，莫道淮阳有笮融。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游仙四首 其一","author":"郑学醇","text":"宫阙玲珑向晓开，有人云此是瑶台。\n梦中不记仙凡隔，听得鸾笙几奏回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游仙四首 其二","author":"郑学醇","text":"玉简青书大洞文，瑶坛清夜礼元君。\n凤箫声歇灵轺转，怅望那堪隔紫云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游仙四首 其三","author":"郑学醇","text":"酒进琼浆脯擘麟，何年重得驻飙轮。\n仙家日月都如此，莫说蓬莱海有尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游仙四首 其四","author":"郑学醇","text":"九气璈声那得闻，素鸾天外自为群。\n不堪西望空肠断，太华峰高一片云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花三首 其一","author":"郑学醇","text":"山边水边人独行，冷蕊疏枝仄岸横。\n清役吟魂寒次骨，一天霜霰月微明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花三首 其二","author":"郑学醇","text":"低回似艳原非艳，髣髴闻香不当香。\n亭亭素手临流水，脉脉贞心对夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花三首 其三","author":"郑学醇","text":"姑射翛翛物外人，清标曾不涴缁尘。\n祇应领得东皇意，不管群芳烂熳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"碧桃初花风雨所阻","author":"郑学醇","text":"罗浮山下太清坛，移得仙根入画栏。\n春意不教花骤发，几朝晴暖几朝寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日池上桃花","author":"郑学醇","text":"佳节繁花一树同，不须回首恨东风。\n霜华点染秋光好，似惜红颜落镜中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙潭夜泛","author":"郑学醇","text":"太虚不著片云飞，海色溶溶漾月辉。\n露裛芦花珠欲滴，两涯清影送船归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"城南书感似以典侄二首 其一","author":"郑学醇","text":"世事回看尽惘然，城南风物最堪怜。\n疏钟晓寺曾灯火，屈指于今是几年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"城南书感似以典侄二首 其二","author":"郑学醇","text":"竹床茶灶上方连，綵笔曾经梦里传。\n结客此时多意气，閒花题遍寺门前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15102,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别情二首 其一","author":"郑学醇","text":"梦里相携梦后非，别情垂老更依依。\n离魂好似三秋雁，夜向天涯一度飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15103,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别情二首 其二","author":"郑学醇","text":"日日行吟江畔归，可堪寒尽见梅稀。\n閒心懒对长江水，谁共持竿上钓矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五仙观","author":"郑学醇","text":"华表千年鹤一归，山川犹是昔人非。\n白莲池上西风起，半似联翩振羽衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]