[{"title":"雨中看梅西碛即事 其三","author":"李流芳","text":"虎山桥边急雨横，虎山桥外春湖平。\n两度梅花一宵月，每将清景忆平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31139,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中看梅西碛即事 其四","author":"李流芳","text":"滟滟湖光澹澹山，密云疏雨梅花斑。\n扁舟欲向花源去，遥指人家杨柳湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31140,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中看梅西碛即事 其五","author":"李流芳","text":"山头白云自往来，山腰白云团不开。\n共道山腰云更白，不知却是梅花堆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31141,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中看梅西碛即事 其六","author":"李流芳","text":"溪头一夜雨喧豗，添得泉声万壑哀。\n花事摧残君莫问，只如元为听泉来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31142,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中看梅西碛即事 其七","author":"李流芳","text":"雨打风吹可奈何，眼看花事渐蹉跎。\n人今欲去花还好，偏道花时风雨多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31143,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中看梅西碛即事 其八","author":"李流芳","text":"村园门巷逐花低，藤蔓桑条咫尺迷。\n花底泉声认归路，沿流直到石桥西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31144,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中看梅西碛即事 其九","author":"李流芳","text":"屐痕处处穿花入，不惜衣沾惜花湿。\n彊欲别花且远看，虎山桥头带雨立。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31145,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中看梅西碛即事 其十","author":"李流芳","text":"灵岩山下雨绵绵，香径琴台云接连。\n忽忆秋山黄叶路，松风水月梦中禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31146,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画","author":"李流芳","text":"定香桥畔青烟路，落日故人从此来。\n和墨寄君山雨后，为侬遥傍冷泉开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31147,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同子将渡江题扇头小景","author":"李流芳","text":"怕向江南渡江北，还从江北望江南。\n润州城外春风满，一点金山水蔚蓝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31148,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"徐州雪后题画赠李生长题","author":"李流芳","text":"黄河曲里又新年，指点京华欲到天。\n喜君眉目如春雪，忘却彭城是客边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31149,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"燕中为李玄问题画","author":"李流芳","text":"著处春风纵马蹄，客心愁见柳如丝。\n芒鞋斗笠溪桥路，记得江南二月时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31150,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄答吴巽之兼讯沙宛在张冷然二女郎 其一","author":"李流芳","text":"湖头风雨夜回船，细语如丝水拍天。\n不信别来春又暮，花期酒约两茫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31151,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄答吴巽之兼讯沙宛在张冷然二女郎 其二","author":"李流芳","text":"闻道萧娘病欲苏，画船日日傍西湖。\n南屏一路春阴绿，只少当年旧酒徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31152,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自新安江至钱塘舟行绝句 其一","author":"李流芳","text":"才过草市溪边舍，复转岑山月下砻。\n维舟直傍滩声宿，要使乡心一夜空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31153,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自新安江至钱塘舟行绝句 其二","author":"李流芳","text":"峰回滩转石玲珑，傍楫随篙诘曲通。\n正是贪奇心不定，轻舟直下去如风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31154,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自新安江至钱塘舟行绝句 其三","author":"李流芳","text":"待邀山色樽前住，不放滩声枕上过。\n看山听水推篷坐，其奈寒天霜月何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31155,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自新安江至钱塘舟行绝句 其四","author":"李流芳","text":"水面奇峰云作帏，波心文石锦成堆。\n篙师下濑莫容易，迟我停桡饱看回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31156,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自新安江至钱塘舟行绝句 其五","author":"李流芳","text":"猿虎无声鸟不栖，千峰回合夜滩低。\n正愁深黑迷前路，忽见峰头月照溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31157,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自新安江至钱塘舟行绝句 其六","author":"李流芳","text":"喜看沙鸟迎人立，怕见山猿连臂来。\n闻道三声催客泪，此中客泪不须催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31158,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自新安江至钱塘舟行绝句 其七","author":"李流芳","text":"五里潭连七里潭，下滩船压上滩船。\n米滩险急三湾隘，飞渡危崖乱石颠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31159,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自新安江至钱塘舟行绝句 其八","author":"李流芳","text":"界口东来水势宽，山夷水远到淳安。\n溪船泊处乡音改，愁听敲篷夜雨寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31160,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自新安江至钱塘舟行绝句 其九","author":"李流芳","text":"晓发严州七里泷，万山云雾一溪风。\n钓台直上三千尺，何处江潭有钓翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31161,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自新安江至钱塘舟行绝句 其十","author":"李流芳","text":"桐庐山下吕公亭，古井犹传仙酒名。\n若得逡巡沽一盏，不愁帆底冻云生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31162,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自新安江至钱塘舟行绝句 其十一","author":"李流芳","text":"薄云寒日澹山晖，连夜东风作雪飞。\n腊意匆匆归棹懒，富春江上客帆稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31163,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自新安江至钱塘舟行绝句 其十二","author":"李流芳","text":"富阳天豁一江明，江上青山纵复横。\n早晚随潮下三折，六桥寒树远含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31164,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"任城舟中题画 其一","author":"李流芳","text":"过却风波两月程，又拚车马逐尘行。\n无端试写秋山看，勾引閒心一夕生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31165,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"任城舟中题画 其二","author":"李流芳","text":"折尽长安秃马鞭，不知尘外有何天。\n今朝一向春风笑，柳色高梁似旧年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31166,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖上题画次比玉韵 其一","author":"李流芳","text":"阁雨牵云湖不流，遥怜琴酒在山楼。\n客中亦有閒愁思，但见湖山便不愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31167,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖上题画次比玉韵 其二","author":"李流芳","text":"朝看雨脚暮看晴，山半昏沉湖半明。\n昨日风光今又变，眼中谱熟手中生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31168,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泛舟湖市为孟阳题画","author":"李流芳","text":"城隅小艇入荷花，桑树阴阴殿角遮。\n一路香风吹到市，落星岩上石头斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31169,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画赠人","author":"李流芳","text":"梧桐树下见秋还，风叶穿篱满地斑。\n折得黄花杯在手，不知世上几人閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31170,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为子与题画","author":"李流芳","text":"郭外湖山似画中，枫林策策叶将红。\n亦知病骨因秋瘦，不碍湖山月与风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31171,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"初宿法相梦与云栖先师剧谭枕上作一诗纪之","author":"李流芳","text":"一到山房梦亦清，空林残月话分明。\n晓钟未动窗棂白，听得风敲橡子声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31172,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十月十五夜同印持子将诸兄弟自灵隐步月至上天竺口占","author":"李流芳","text":"冷泉亭畔树初明，百道寒光水面生。\n松月似留人住住，溪声却唤我行行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31173,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"王与游新廊夜饮题壁","author":"李流芳","text":"小筑回廊傍桂花，玉山灯火暮烟遮。\n巡廊题罢人初醉，时有琴声杂煮茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31174,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次慧法师山居诗韵同忭中上人李九仙张尔完赋 其一","author":"李流芳","text":"松栝为门石作林，飞泉百道磴千寻。\n云中鸡犬无遗响，独有频伽演法音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e0