[{"title":"陆使君道函入计还宝庆","author":"欧大任","text":"使者朝宗出帝阍，赐金南去奉明恩。\n飞花扑面驱邮传，落日离心寄酒尊。\n风曳珠旗云梦泽，马嘶春草邵陵原。\n上林奏赋嗟留滞，待尔鸿书到蓟门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5546,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明前一日同方行人岳文学江张二山人集孙鸿胪宅得孙字","author":"欧大任","text":"三年持橐傍金门，汉署还来问酒尊。\n千叠浮云迷客舍，五陵春草送王孙。\n莺声半入华阳馆，马首频窥灞水园。\n他日看花携手客，禁烟时节望中原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5547,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送魏顺甫使君上计还济南","author":"欧大任","text":"河梁垂柳拂雕鞍，竹马争迎稚子欢。\n燕筑深杯怀历下，楚歌明月满长安。\n黄金恩重君王赐，白雪词高和者难。\n别后椷书何处寄，春鸿飞尽岱云寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5548,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠黎君华岑贞叔南还","author":"欧大任","text":"风起春城日易阴，留君斗酒故情深。\n弃繻暂出西游路，献玉终酬北望心。\n驿路新莺难驻马，天涯久客易沾襟。\n垆头诸少应相忆，为报秋期在竹林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5549,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送冯侍御出按山西","author":"欧大任","text":"侍从当年草白麻，西行绣斧有光华。\n晋阳列署看双柏，汾水鸣骢散五花。\n霜落胡沙边燧暗，星随汉使岳云斜。\n建章正待筹边疏，不用蒲稍入内家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5550,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨后饮苏子川宅望西山得花字","author":"欧大任","text":"西山爽气满窗纱，丹凤城南日未斜。\n翠黛遥分燕柳色，青云平出岳莲花。\n閤开双瀑长临涧，鸟度诸峰半带霞。\n尊酒却疑人境外，谁知还醉近臣家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5551,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘选部孟真请告还夷陵","author":"欧大任","text":"何事张衡咏四愁，飞花春散凤皇楼。\n暂辞起草诸郎直，谁共鸣驺六传游。\n三峡云帆巴子月，一江风笛渚宫秋。\n廷中最忆山公启，兰佩荷裳未可留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5552,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送范职方于公奉使吴中","author":"欧大任","text":"侍从频年奉柏梁，西风暂得过鲈乡。\n出关偶作吴洲客，负弩争迎汉署郎。\n山下清溪通夕照，城边白苧散秋凉。\n輶轩归上江淮奏，愿遣材官事朔方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5553,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答戴进士仪周","author":"欧大任","text":"燕市还来共酒杯，笑予寄宿在灵台。\n省中兰佩今堪结，江上荷裳未可裁。\n连骑岂知原宪病，淩云空羡马卿才。\n玉河烟柳年年色，曾见何人奏赋回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5554,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送毕兆先掌教安福","author":"欧大任","text":"与君少小竹斋谈，此日青毡出淦南。\n沧海蛟龙双跃剑，蓟门风雨一分骖。\n秋凉弦诵新茨野，夜色楼台石鼓潭。\n别后江鸿谁共听，相思应有白云椷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5555,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈文学季谦赴信丰","author":"欧大任","text":"闻道儒林近岭边，章江西上孝廉船。\n片帆烟水三千里，双剑风云二十年。\n韦氏只今推世业，文翁不敢倚先贤。\n故人相送堪相笑，犹得微官足酒钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5556,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"徐子与入都见访","author":"欧大任","text":"蓟云千片拥骅骝，把袂中原感旧游。\n一别雪飞桐柏水，三年书寄白蘋洲。\n铜龙见尔鸣珂入，金马怜予待诏留。\n短发萧骚惟侠气，紫貂还问酒家楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5557,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋同张李陈三户部王山人柴文学集天坛曹道士院得窗字","author":"欧大任","text":"日午鸣钟迎客到，仙童花下立双双。\n当秋山色分松院，过雨泉声冷石窗。\n白鹤连翩参法席，灵风萧飒满经幢。\n词人兴在烟萝外，有约还来倒玉缸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5558,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"弘法寺送徐子与谪长芦","author":"欧大任","text":"回首金门感慨多，汉家迁客一悲歌。\n玉珂秋散祇园树，宝剑寒生易水波。\n郡里太行新雁起，尊前渤海白云过。\n主恩不遣长沙去，咫尺承明鬓已皤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5559,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早秋同达水部集施虞部省中园亭得来字是日期曾缮部不至","author":"欧大任","text":"署中凉色满池台，更有双尊出旧醅。\n濯露蔬劳园吏给，冒霜花为省郎开。\n边烽幸绝甘泉报，胡雁初从大漠来。\n寄问东曹词赋客，何时还共故人杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5560,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"讯沈祠部病","author":"欧大任","text":"病来秋叶满亭皋，圣主斋居念礼曹。\n露下金茎双阙迥，月明瑶瑟五陵高。\n四愁有客思江汉，七发何人望海涛。\n那得沈郎腰不瘦，闭门犹是著书劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5561,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夕卧病对月怀许维桢何启图二内翰","author":"欧大任","text":"卧游因病久盘桓，曾记名山万里看。\n雪后驱车过汝水，月中摇艇入新安。\n昔年白雁思传札，此日铜龙阻握兰。\n尊酒何因携二妙，清光知在玉堂寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5562,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙丑九日同古茂毨蒙廷俞张鸿与蒙廷纶张伯邻郭笃周饮伦绍周宅","author":"欧大任","text":"蓟城佳节忆烟皋，尚喜东邻有浊醪。\n赤管自怜频索米，黄花犹得共持螯。\n酒钱颇羡陶彭泽，诗句深知谢法曹。\n岁岁佩萸何处客，归心偏恋五云高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5563,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送沈祠部谢病归吴兴","author":"欧大任","text":"独辞省署向烟萝，金马其如病客何。\n别骑关城惊雁早，归舟江峤听猿多。\n帘前讲肆逢严叟，溪上清缨学楚歌。\n知有郎中桑落酒，兰桡将泛太湖波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5564,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋同社诸子集方侍御宅得中字","author":"欧大任","text":"醉客挥毫倚玉骢，西园今夕正秋风。\n关山一赋秦城上，砧杵千声汉苑中。\n歌后新凉生觱篥，尊前清露滴梧桐。\n庾公此兴应非浅，月下何人赋最工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5565,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"太霞洞天为永昌周象贤赋","author":"欧大任","text":"兰津渡口望天池，曾见王乔来去时。\n山气晓蒸华马国，海云寒接碧鸡祠。\n丹砂不用求勾漏，采幔应看胜武夷。\n觞客九霞堪一醉，何年瑶水与君期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5566,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京秋夜登楼怀故园","author":"欧大任","text":"风起飞沙日易阴，高城吹角此登临。\n归人书去孤鸿杳，游子心惊落叶深。\n千垒浮云驱大旆，万家明月拭清砧。\n故园亦在沧江上，烽火年年听捷音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5567,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南溪泛舟遇雨客有怀江南者共赋中字","author":"欧大任","text":"城西陂上晚溟濛，越客扁舟望不穷。\n渭水云沉波色里，长杨秋在雨声中。\n乍飞鹤子翻池白，欲尽荷花坠露红。\n多少燕姬愁翠黛，共将离思寄江枫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5568,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送袁解元南归","author":"欧大任","text":"异乡携手客愁开，秋色飘零酒一杯。\n未论南州曾荐士，只知东阁解怜才。\n蓟门落叶千砧送，沧海惊波一棹回。\n已笑中涓求骏晚，黄金宁不待君来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5569,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨夜同薛文学晁秀才集吴侍御子沐宅","author":"欧大任","text":"君家绿酒照玻璃，佳句还邀烛下题。\n宫漏稀闻官舍里，城云低度禁垣西。\n铜街踏雨寒嘶马，白简朝天曙听鸡。\n他夕金龟能笑解，二豪犹得醉相携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5570,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送戚进士世秀请告归泗州毕姻","author":"欧大任","text":"金门诏许出关遥，淮水乘龙意气骄。\n鳷鹊青云随去骑，凤皇新月在鸣箫。\n花摇屏烛春开宴，星引天津夜度桥。\n想是听鸡还戒旦，含香催入圣明朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5571,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"子与约会沧州予将从德州南行不得过先寄此作","author":"欧大任","text":"献策无媒将远游，萧萧一骑出卢沟。\n白云不散青枫色，明月独照黄河流。\n欲赠生平三楚璞，可怜离合双吴钩。\n他时莫忆悲歌客，别后何人燕市秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5572,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄李于鳞 其一","author":"欧大任","text":"屏居犹在列仙乡，十二楼台蜃雾旁。\n客自函关占紫气，世从鲁甸识灵光。\n窗前海近弹琴润，岳顶云来散帙凉。\n难向此中歌白雪，相将看日到扶桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5573,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄李于鳞 其二","author":"欧大任","text":"高楼不下绝风尘，傲吏当年早乞身。\n金匮山经藏岱岳，石渠门客出咸秦。\n酒曾累日逢中圣，赋更何时奏大人。\n海内从来誇御李，愿从骑鹿过千春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5574,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪夜古比部携酒雷比部同过","author":"欧大任","text":"蓟门积雪九衢光，犹得相随酒榼狂。\n紫禁地分文学掾，白云天远尚书郎。\n骊驹不用催官骑，鸾鹤偏能恋帝乡。\n此夜王猷好乘兴，他年无忆剡溪长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5575,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送范太史伯祯奉使册封鲁王","author":"欧大任","text":"殿前三策献宸旒，人识词林第一流。\n玉节西分周太史，金符东授汉诸侯。\n古城弦诵兼风雪，复壁图书烛斗牛。\n邹鲁千秋还讲业，归来何异马迁游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5576,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"余省觐岭外马进士使辽东饮别霍进士爱大宅得真字","author":"欧大任","text":"祖筵雪色照城闉，海内交情尔最真。\n岭表辽阳明日路，貂裘狐帽异乡身。\n尊前星斗关山远，阙下衣冠气象新。\n燕赵悲歌还此地，重来击筑更何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5577,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诸太史邀饯席上留别","author":"欧大任","text":"玉署开尊雪满庐，勾陈东望逼天居。\n浮沉祇自逢宾戏，浅薄何能赋子虚。\n离夜肯留文学宴，聚星今得史官书。\n一经南去还持橐，遥忆名儒议石渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5578,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大理邹卿夜饯席上留别","author":"欧大任","text":"乌飞廷尉府中栖，坐拥燕山玉嶂低。\n半夜星辰丹凤绕，千门冰雪紫驼嘶。\n避人谏草閒曾检，爱客诗篇醉屡题。\n我去扬州五湖月，春鸿偏忆禁垣西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5579,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张掖门留别曾以三缮部","author":"欧大任","text":"燕市千杯送我归，中原交友似君稀。\n易为易水悲歌泪，难把河梁落日衣。\n霜草台边孤骑去，朔云天畔几鸿飞。\n谁怜长乐听钟客，独向江淮忆禁闱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5580,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周子脩苏子川丁庸卿周汝砺孙文济孙文鼎项思尧黄汝会柴季通黄定父纪旭仁诸君枉饯席上留别","author":"欧大任","text":"高阳宁得少吾徒，结客青萍日渐孤。\n彯组尔应留汉署，下帷人自出江都。\n他乡梦里思琼树，明月歌中倒玉壶。\n别后迢迢怜尺素，不知双鲤到淮无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5581,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张掖门再别曾缮部","author":"欧大任","text":"关前立马色苍苍，抗手还同汉署郎。\n双阙风云分去路，千山冰雪照离觞。\n蓟门赋后馀双鬓，碣石书归待八行。\n别汝相思无远近，天涯一望九回肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5582,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过河间郡","author":"欧大任","text":"幽州甲士何翩翩，自许黄金召募年。\n插羽东翻沧海日，鸣铙北扫塞垣烟。\n路旁小儿能杀马，河间姹女工数钱。\n不见听鸡刘越石，侠客中原空自怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5583,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡河入德州却寄慈仁和尚","author":"欧大任","text":"鲁门一望水如渑，渐远长安隔五陵。\n钜野旆旌苍树出，暮天楼橹白云升。\n鸦归返照啼高冢，马饮寒流顾断冰。\n行役驱驰飞锡远，题书心愧雁门僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5584,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登岱二首 其一","author":"欧大任","text":"天风飒飒起秦松，鸾鹤相随上岱宗。\n石暗客窥千岁字，雪残僧扣万山钟。\n翠华日月开虞狩，玉检云霞护汉封。\n曾是仙人期六博，夜来还借二茅龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5585,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登岱二首 其二","author":"欧大任","text":"岁杪东游亦快哉，石闾高倚避风台。\n射牛不用诸生议，牵狗疑逢老父来。\n舄外波涛银阙涌，杯前齐鲁白云开。\n谁能婚嫁迟栖岳，禽尚何年向此回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5586,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阙里谒孔庙","author":"欧大任","text":"尼泗千年启閟宫，坛前冠佩讲时同。\n凤衰歌后人何在，麟出书成道已穷。\n鲁壁藏经残简积，汉祠祝史太牢崇。\n东来邹峄观乡射，犹听金丝到庙中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5587,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒孔林","author":"欧大任","text":"世家何但表东州，梁木空摧万古愁。\n鸟下山犹庐冢夕，叶彫林似奠楹秋。\n岱云不向城边散，泗水长悬天上流。\n落日缁帷延首地，松门风急下寒沟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5588,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"衍圣公留宴","author":"欧大任","text":"堂开曲阜带林霞，西第歌钟起暮鸦。\n车服尚传秦博士，宫墙犹识鲁东家。\n烟生宝鼎皆成篆，雪积琼枝半缀花。\n岱岳诸峰明月色，相将终宴向庭斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5589,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过薛城","author":"欧大任","text":"公子倾身下士年，至今侠气尚翩翩。\n三千客散荒秋草，七十城空锁夕烟。\n长铗飘零收慷慨，高台歌舞惜婵娟。\n不须更奏雍门曲，牧竖樵童满墓田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5590,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜登徐州驿楼","author":"欧大任","text":"汴泗交流重镇成，千家雉堞听涛声。\n浊河月涌台边迥，衰草天连雪后平。\n霸气只今销沛上，楚歌犹自满彭城。\n汉家更欲沉玄璧，酾酒黄楼万古情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5591,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"青口驿遇乡僧介公同登三祖山望灊皖天柱诸峰","author":"欧大任","text":"地布黄金玉作岑，西来三祖古禅林。\n山云半剪传衣色，海石空留听偈心。\n涧水供筵经雪净，竹房清梵出烟深。\n道人白鹤同僧去，天柱还随杖锡寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5592,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻黎职方惟敬已趋金陵予自黄梅渡江过浔阳不得相见","author":"欧大任","text":"献岁东风彩鹢催，浔阳难待故人回。\n独驱涛色三湖过，不见梅花五岭来。\n持橐旧随鳷鹊观，挥毫今忆凤凰台。\n樱桃未熟还江北，莫负金陵几百杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5593,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江州城楼晚望","author":"欧大任","text":"家在渔村有钓蓑，偶从簪弁失烟波。\n怀人书札春鸿早，作客江湖夜雨多。\n匡岳千峰云不散，浔阳九派路如何。\n五噫岂似关东去，回首中原一放歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5594,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瑞州官舍同黎比部晚酌净芳亭","author":"欧大任","text":"征轺计日问长亭，筠上从君倒玉瓶。\n宪府戟枝移竹院，官池波色上莎厅。\n频瞻南峤云俱白，三渡西江草又青。\n同得趋归家庆近，茅堂灯火带春星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5595,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京秋夜闻砧","author":"欧大任","text":"丹凤城南夜正长，万家明月捣衣裳。\n忽惊落叶频沾臆，不听悲笳亦断肠。\n遮虏渐闻过马邑，拔营曾报破龙荒。\n豫愁绵折天山下，那识弓胶瀚海旁。\n书去再经燕草绿，梦飞不到塞云黄。\n玉关纵待封侯入，祇得萧萧白发郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5596,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜登曾缮部省中楼同黎惟敬赋","author":"欧大任","text":"骋望遥天云，迢迢带城阙。\n关山一笛声，况是高楼月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5597,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠曹山人幼兴南还","author":"欧大任","text":"君看槐树陌，何似桃花源。\n独有长安梦，相随还故园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5598,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张山人将游五岳过予寓舍为别二首 其一","author":"欧大任","text":"暂揖市上鞭，一送云中辔。\n归时五游成，示我青苔字。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5599,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张山人将游五岳过予寓舍为别二首 其二","author":"欧大任","text":"张公江海客，亦诵龙虎文。\n他日相逢处，罗浮鹤是君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5600,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送人游岳州","author":"欧大任","text":"离人愁独醒，湘草正青青。\n忆上巴陵渡，春波满洞庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5601,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘子脩同往赵园看芍药马上作 其一","author":"欧大任","text":"何代金谷园，斜连上林苑。\n十里看花人，五陵紫骝远。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5602,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘子脩同往赵园看芍药马上作 其二","author":"欧大任","text":"玉勒有佳期，一片锦云白。\n谁将洛下春，誇向杨州客。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5603,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春曲寄子冲 其一","author":"欧大任","text":"玉貌飒风沙，何人不忆家。\n江南春未到，马上听琵琶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5604,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春曲寄子冲 其二","author":"欧大任","text":"曲中花半开，羯鼓莫频催。\n芳草思公子，春从濮上来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5605,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春曲寄子冲 其三","author":"欧大任","text":"宜春连下苑，十里色葳蕤。\n白马翩翩去，金鞭半欲垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5606,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春曲寄子冲 其四","author":"欧大任","text":"徐生誇绝倡，醉杀五陵豪。\n我醉何持赠，君王有赐袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5607,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题友云卷","author":"欧大任","text":"云来积金峰，影落朱阳馆。\n先生不出山，窗中共舒卷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5608,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题董体仁玉几山房","author":"欧大任","text":"斋居玉几侧，秋草下帷青。\n弟子谁都讲，来传董氏经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5609,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赣州歌四首 其一","author":"欧大任","text":"东闽南粤带郴西，岭北辕门号令齐。\n鼓吹行边万馀里，风霆犹过汉山溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5610,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]