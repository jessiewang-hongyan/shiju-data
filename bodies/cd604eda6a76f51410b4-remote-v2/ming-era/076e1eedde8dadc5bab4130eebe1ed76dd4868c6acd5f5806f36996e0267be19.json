[{"title":"清明曲江亭阁","author":"李梦阳","text":"寒食花争丽，丰江柳独深。\n此行元慷慨，落日更登临。\n浩荡五湖际，风烟千里阴。\n坐看舟楫急，徒切济川心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55485,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"端午赣州晚发","author":"李梦阳","text":"戏倦龙舟返，吾驱彩鹢行。\n晚天闻古驿，转眼过孤城。\n袅袅云生濑，悠悠弟忆兄。\n泛蒲虽念我，宁解岭边情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55486,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南康除夕","author":"李梦阳","text":"畏途值除夕，会我得投閒。\n海雪寒城古，江春碧草还。\n星河挂岳树，灯烛熨归颜。\n窃计临家日，蔷薇满旧山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55487,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南康元夕二首 其一","author":"李梦阳","text":"四海逢今夕，孤城有独身。\n干戈犹野哭，梅柳自江春。\n月向平湖满，灯于静夜亲。\n罢喧风乍起，嗟尔楚南人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55488,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南康元夕二首 其二","author":"李梦阳","text":"嘈嘈市鼓动，松月静吾门。\n灯火思今夜，风光满故园。\n天明淹舞袖，尘暗失游轩。\n老鬓江山异，愁看旌旆繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55489,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元夕风起南康","author":"李梦阳","text":"岳云黄袅袅，夜半忽凄风。\n度市春灯乱，穿梅野树空。\n人依青岸酌，月漾碧湖中。\n拟尽江城赏，无欺蜡炬红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55490,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙亥立秋","author":"李梦阳","text":"今日秋风起，连年湿病苏。\n应时微雨歇，侵晓断云徂。\n巳复寒蝉集，空嗟蕙草孤。\n步檐惊骤健，一叶下庭梧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55491,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋二首 其一","author":"李梦阳","text":"汉江江上月，今夕去年看。\n尚忆岘山曲，秋城波色寒。\n故乡仍节序，衰鬓且儒冠。\n桂子真谁种，天空落未乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55492,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋二首 其二","author":"李梦阳","text":"辉辉众星没，宛宛孤轮高。\n万古今宵月，青天首自搔。\n广闺萤息照，悬树鸟分毛。\n寂寞枚乘笔，空怀八月涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55493,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"戊寅元夕","author":"李梦阳","text":"春色闰冬后，元宵惊蛰边。\n软尘欺月散，繁火夺星悬。\n车马中原地，笙歌全盛年。\n无劳验花烬，难测是皇天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55494,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋喜客携酒见访二首 其一","author":"李梦阳","text":"节有吾家会，天能此夜阴。\n蟾蜍逐月没，桂子落云深。\n同是悲秋客，况怀天柱心。\n引杯光欲闪，徙倚向东林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55495,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋喜客携酒见访二首 其二","author":"李梦阳","text":"云出真谁料，月行应自如。\n闇然花径里，忽枉故人车。\n落叶近坐满，清光中夜舒。\n杯来不须却，此意合踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55496,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十月月食不见","author":"李梦阳","text":"频食天应苦，当宵地故阴。\n悲生十月雨，狂阻万方心。\n武廨香灯聚，霜林鼓角沉。\n复光何处满，愿逐翠华临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55497,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"巳卯元夕","author":"李梦阳","text":"此夜门还闭，中天月自看。\n春催桂应发，雪映兔犹寒。\n儿女添镫闹，邻家品笛残。\n少时思可笑，走马向更阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55498,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"庚辰清明东郭","author":"李梦阳","text":"少日欢游处，逢春老大悲。\n强持杯酒劝，怕遣落花随。\n草木梁园在，山河宋殿移。\n上坟人尽返，岐蹃独含思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55499,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日上方寺二首 其一","author":"李梦阳","text":"赏时争上塔，乘月复登台。\n地尽中原入，天空秋色来。\n望乡番恨雁，有菊且衔杯。\n却忆龙山帽，徒增醉者哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55500,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日上方寺二首 其二","author":"李梦阳","text":"天地疏秋色，楼台敞客歌。\n远江寒自白，落木晚堪多。\n月为衔杯出，鸿于鸣磬过。\n霜横不归去，吾意在烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55501,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"至日夜雪","author":"李梦阳","text":"至夜还深雪，幽心独小堂。\n光虽夺片月，寒恐妒微阳。\n压竹宁迷翠，沾梅秪辨香。\n一声何处雁，翅湿且高翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55502,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"癸未中秋不月","author":"李梦阳","text":"碧桂行青凤，婵娟集玉楼。\n世人宁解睹，天意漫阴秋。\n云逼初光布，星随满夜收。\n开晴即是月，但遣一尊留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55503,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙酉上元上方寺","author":"李梦阳","text":"地爱僧林僻，人邀灯节游。\n缘塍朝借马，攺路晚登舟。\n春水凫鹥满，夕阳钟磬幽。\n相留待明月，箫鼓在中流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55504,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丁亥立秋","author":"李梦阳","text":"火多常病热，残暑特相欺。\n今日凉风至，飒然竹林披。\n闻鸡每起早，省稼独归迟。\n天地萧条意，何须一叶知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55505,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋亭会","author":"李梦阳","text":"老去真耽月，更深且醉游。\n影沾如畏露，光冷是分秋。\n蛩故吟清酒，蟾应笑白头。\n怕星藏不见，坐待彩波流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55506,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"戊子元夕示甥嘉","author":"李梦阳","text":"皎月临元夜，和风入始春。\n过冬犹望雪，思世转愁人。\n歌管喧鸣鼓，游车匝暗尘。\n黑头宜努力，吾鬓巳如银。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55507,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"巳丑五日","author":"李梦阳","text":"往岁沾宫扇，含香拜玉墀。\n只今飘白发，刈麦向东菑。\n树树鸣蜩日，家家望雨时。\n万方多难意，谁达圣明知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55508,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五日庄上集","author":"李梦阳","text":"园树日佳色，黄鹂时巧音。\n美人翩紫马，携酒入花阴。\n艾席铺能坐，蒲觞乾自斟。\n蜩鸣虽颇聒，流转是天心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55509,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙丑逢先大夫诞辰是岁适蒙恩诏加赠制字四十用写哀痛","author":"李梦阳","text":"老大思童日，诗庭俨昔趋。\n羁孤万里外，优渥死生俱。\n寂寞临花诰，齿冥列大夫。\n西云白苍莽，洒血望松梧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55510,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"兄以西堂落成盖怅然有念于二亲余心交痛颂义追德爰成兹咏焉","author":"李梦阳","text":"矫矫江都相，凄凉楚穆生。\n家贫无立业，道大不求名。\n破甑常蛛网，空除任鸟行。\n肯堂兄不忝，应慰九原情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55511,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"读直道陈公祚遗事","author":"李梦阳","text":"上主能容直，当言敢顾身。\n累朝传谏劄，万死作归人。\n古庙秾花晚，孤坟劲草春。\n从来汨没士，特笔在词臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55512,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭郡守郝公","author":"李梦阳","text":"征敛无休日，斯人不永年。\n曾闻溪虎避，早见壁鱼悬。\n颂碣留边郡，铭旌拂塞天。\n九河一孤冢，愁绝海门烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55513,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭张子二首 张子者平谷张子礿也以都御史镇辽东显矣然无何卒李子者张之旧僚也闻之哀焉于是作哭张子二章语曰岁在龙蛇贤人嗟张之卒庚辰岁也 其一","author":"李梦阳","text":"虎豹威边日，龙蛇哭尔年。\n故人今若此，吾道合潸然。\n部曲归旌拥，风云旧国连。\n蓟门秋草遍，何处是新阡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55514,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭张子二首 其二","author":"李梦阳","text":"翰海龙真泣，辽阳鹤竟归。\n壮心元铁石，神爽尚旌旂。\n光绕新埋剑，香残旧赐衣。\n至今生仲达，犹怯孔明威。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55515,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谒平台先生墓","author":"李梦阳","text":"岂说嬉游路，今成昔雍门。\n平生马公帐，四海孔融尊。\n剑舄收残草，山河抱古原。\n黄昏不忍去，白日下高园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55516,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"温将军挽诗","author":"李梦阳","text":"不见千夫勇，谁开百战围。\n门犹森画戟，苔巳蚀金衣。\n俎豆诸郎奋，山河奕世辉。\n黄昏两白鹤，偏绕北邙飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55517,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻郑生死丰沛舟中二首 其一","author":"李梦阳","text":"短剑英雄气，孤舟疾病身。\n那知生别后，竟作死归人。\n汴柳诗筒断，江花穗幔新。\n白头交谊者，洒泪向残春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55518,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻郑生死丰沛舟中二首 其二","author":"李梦阳","text":"客榇收丰沛，归舟渺越吴。\n扶持有令弟，书剑付遗孤。\n墓草亲朋隔，山松旧业芜。\n当年走马地，魂绕孝王都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55519,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"古意","author":"李梦阳","text":"内厩飞龙马，君王赐玉鞭。\n长鸣彩仗下，立在紫骝先。\n放逐缘何事，飘零竟不旋。\n如蒙敝帷顾，万里为君前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55520,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赏游","author":"李梦阳","text":"王者化无外，玉门开至今。\n笳闲青海外，马放白登深。\n汉将收金鼓，胡姬弄玉琴。\n宫中花月夜，那称赏游心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55521,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"客散","author":"李梦阳","text":"尊倾客自散，而我卧空林。\n五月凉风至，孤村细雨阴。\n竹萝垂野径，花草澹幽襟。\n梦醒闻遥唱，依稀楚凤吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55522,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游兵","author":"李梦阳","text":"闻道新开口，游兵未解围。\n只须殊死战，莫放只轮归。\n汉月巳自满，林鸟常夜飞。\n早将书插羽，天子日宵衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55523,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"省中春暮","author":"李梦阳","text":"禁漏烟花北，分曹御苑西。\n高林落日尽，幽院集鸦齐。\n岂贵浮生趣，常便静者栖。\n坐怜春事晚，庭草日萋萋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55524,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观雪省中","author":"李梦阳","text":"省叶辞寒尽，庭花向暮飘。\n黄云变玄朔，万里入层霄。\n洒地纷纷密，凌虚脉脉遥。\n北风聊可咏，携手不堪谣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55525,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻砧","author":"李梦阳","text":"逸响缘云起，清砧入暮繁。\n秋风吹落叶，万户更千门。\n宁知寄远意，不尽捣衣魂。\n早晚逢西使，流沙隔塞垣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55526,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"旅夜","author":"李梦阳","text":"百卉巳萧索，哀蛩胡未休。\n寒天清渭树，落月故乡楼。\n古人犹涕泪，吾意岂公侯。\n雍雍南去雁，漂泊向何州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55527,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"除架二首 其一","author":"李梦阳","text":"种豆高于屋，垂瓜忽满庭。\n根深历夏茂，蔓弱望秋零。\n猥杂沉霜露，纵横碍月星。\n斧斤呼稚子，欲伐几回停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55528,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"除架二首 其二","author":"李梦阳","text":"炎时忻密叶，寒至怨多阴。\n自是衰荣理，非关爱恶心。\n代条近阳月，开牖散秋禽。\n但能存硕果，无用叹萧森。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55529,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏史","author":"李梦阳","text":"霸王雄图并，凄凉世径分。\n鲸鲵赴巨壑，鹰隼失高云。\n难折朱游槛，休嗟袁绍军。\n当时平帝纪，一一动星文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55530,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"望极二首 其一","author":"李梦阳","text":"望极云天黑，关门落叶深。\n古城饥雀啅，长路断蓬沉。\n嫠妇登楼思，孤臣去国心。\n此时看故垒，何处不沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55531,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"望极二首 其二","author":"李梦阳","text":"汉未忠良显，英名李杜齐。\n伏机翻自中，倒柄为谁携。\n碧海鲸鲵斗，苍林虎兕啼。\n南州徐孺子，何事独栖栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55532,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"定居","author":"李梦阳","text":"故业秦山北，新居梁苑西。\n平生一丘壑，何处竟安栖。\n玄豹终随雾，神龙或困泥。\n向来登眺梦，常绕杜陵溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55533,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"归沐","author":"李梦阳","text":"归沐谢人事，翛然悲俗情。\n阴阳争岁色，江海蓄春声。\n自委青云懒，那教白发生。\n君看少年者，骝马尽飞缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55534,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日大梁东郭","author":"李梦阳","text":"桃柳晴沙晚，怅然悲远春。\n叶明深坐鸟，花剧转愁人。\n少小追欢地，乾坤放逐臣。\n巳看共如此，何惜醉游频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55535,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂兴","author":"李梦阳","text":"众木依繁塔，吾亭俯蔡河。\n侧思云骥渡，不忍黍离歌。\n窗里游天地，春前种薜萝。\n养生诚计拙，冥寂保天和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55536,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登临二首 其一","author":"李梦阳","text":"屏迹良吾性，逢辰每壮心。\n花含向日雾，柳变隔年阴。\n行坐自芳草，依栖还旧林。\n高楼出迥绝，无日不登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55537,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登临二首 其二","author":"李梦阳","text":"春燕不巢屋，国祥徵至今。\n孤城四战地，斜日雨河阴。\n岸坼陈桥断，花开宋苑深。\n河船不入渭，那慰望乡心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55538,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨后朝望","author":"李梦阳","text":"半夜雷驱雨，清晨草映空。\n起看南仆树，知是北来风。\n宿雾笼初日，晴天灭断虹。\n剧心时序晚，遮莫傅岩功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55539,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早春南郊","author":"李梦阳","text":"正月郊南路，独行吟早春。\n冰霜犹在眼，柳色暗随人。\n直道元通蔡，层山故蔽秦。\n浪游今短发，凝望欲沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55540,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊行","author":"李梦阳","text":"午雪融村溢，春沙引骑纡。\n田禽忽自起，水鹤会相呼。\n歇马时傍柳，逢花自倒壶。\n醉眸横落日，寂寞宋京都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55541,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"时事","author":"李梦阳","text":"幸睹三春媚，番增两鬓华。\n贼来当白昼，风起但黄沙。\n碧飐依墙竹，红残拂槛花。\n寄言寇盗者，四海尚为家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55542,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"被絷国境眺望","author":"李梦阳","text":"亦知蹋翼鸟，岂意罻罗求。\n万里劳明主，孤臣泪暗流。\n临京花更苦，近苑柳偏愁。\n愧尔云间雁，衔泥向玉楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55543,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"下吏","author":"李梦阳","text":"十年三下吏，此度更沾衣。\n梁狱书难上，秦庭哭未归。\n围墙花自发，锁馆燕还飞。\n况属炎蒸积，忧来不可挥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55544,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"狱夜雷电暴雨","author":"李梦阳","text":"一雨暮何急，孤眠宵未央。\n疾雷翻暗壁，落电转空梁。\n势极千山动，光还万里长。\n天威终不测，魑魅可潜藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55545,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南征","author":"李梦阳","text":"暑行心日烦，孤马背中原。\n地势吞淮泗，山形包邓樊。\n沿途官柳接，吟叶麦秋繁。\n赤日蒸云梦，科头思故园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55546,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"野战","author":"李梦阳","text":"盗贼乾坤满，纵横野战悲。\n随城严戍鼓，平地有旌旗。\n树燕闲相逐，垣花寂自垂。\n诸君大河北，捷报几时知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55547,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"野泊","author":"李梦阳","text":"远电明江夜，官舟野泊稀。\n山钟天外落，林火两中微。\n水立黄龙斗，沙沾白鹭饥。\n平生万里志，柰可梦西归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55548,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟中病感","author":"李梦阳","text":"寒望舟中远，乡心病后多。\n万山通越水，孤棹杂吴歌。\n霜巳丹枫甚，吾如白发何。\n倦游常药物，归思绕关河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55549,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"安仁闻夜哭","author":"李梦阳","text":"缥缈因风诉，哀哀何处音。\n声随落月断，听入过云深。\n转战增新鬼，诛求损众心。\n悬军今更急，寨满碧山岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55550,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"得家书","author":"李梦阳","text":"隔岁才通此，一书真万金。\n时危作宦久，家远战场深。\n惨惨屯黄雾，纷纷走绿林。\n怒来思击楫，时有渡江心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55551,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"报生孙","author":"李梦阳","text":"强仕今为祖，家书昨举孙。\n行藏三代具，生养九朝恩。\n长但修蘋藻，愚从唤犬豚。\n见时应解笑，先梦绕夷门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55552,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"徐汊风阻雨雪四首 其一","author":"李梦阳","text":"风急江船绝，年残野色凝。\n密云寒夜柝，流霰洒舟灯。\n四望湖天黑，孤吟羁思增。\n旁村有夫妇，对火缀鱼罾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55553,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"徐汊风阻雨雪四首 其二","author":"李梦阳","text":"南雪竟为雨，北风增野寒。\n漏船喧夜语，摊湿搅晨餐。\n转苦人烟绝，生憎鸥鹭乾。\n吾行尚濡滞，估舶尔应难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55554,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]