[{"title":"送君御宪佥治兵甘州 其四","author":"袁宏道","text":"宝剑犀弓大羽囊，军中聊作健儿装。\n一函云卷天骄檄，十里风吹侍史香。\n朗月澄江真快士，修髯白面旧仙郎。\n也知陶侃无高韵，谢却樗蒲与老庄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45268,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿雷元亮母太宜人","author":"袁宏道","text":"树树新莺啼晓晖，春风南国笋初肥。\n花前白发光垂地，天上红云绣绕衣。\n孺子榻香芝数本，麻姑山近柏千围。\n使君自是烟凫侣，趁取青溪老鹤飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45269,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"惠安园亭看白芍药","author":"袁宏道","text":"仙葩亦自喜楼居，嫩紫妖红总不如。\n滟滪水翻晴雪后，兜罗云没晓峰初。\n誇多屡向交游述，递远频登好事书。\n是我眼悭叹未有，主人元只比葵疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45270,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汤嘉宾邀同顾升伯李长卿唐君平游草桥别墅","author":"袁宏道","text":"郊居绝胜午桥庄，南客行来眼亦忙。\n马上乍逢蒲苇地，梦中移入水烟乡。\n疏林透户凉风出，翠叶平池急雨香。\n危石幽篁相对冷，一庭清影话潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45271,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五月十二日退如生辰蒙以诗见示聊述二章奏报 其一","author":"袁宏道","text":"菖蒲弄碧柳垂轩，过雨閒看蛱蝶翻。\n喜与老髯争一日，好同醉竹倒千樽。\n身依紫省黄枢地，梦绕青菱白藕村。\n门下校书真女史，吴绡亲写佛前幡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45272,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五月十二日退如生辰蒙以诗见示聊述二章奏报 其二","author":"袁宏道","text":"睡阑日影度疏寮，廿载君王罢早朝。\n安石榴开红照地，御河水酿绿平桥。\n花前晓佩闻燕语，醉后春云梦楚腰。\n近日蒙庄通大旨，间烧藜火注逍遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45273,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和退如初度与客谈仙次韵","author":"袁宏道","text":"竹树森疏翠绕身，与君连日坐花茵。\n乐邦有宅憨为主，仙路无程醉是因。\n正好同看双舞袖，何须高著九阳巾。\n直消数幅梅花纸，便作华胥世上民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45274,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送曹远生进士左迁宜川典史","author":"袁宏道","text":"百叠青山亦起澜，虚空赞毁岂相干。\n幸逢梅福称先辈，却唤陶潜作长官。\n溪雨松风聊簿领，云心石面且衣冠。\n何妨盩厔来仙尉，便作集贤校理看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45275,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与元定孝若同话归计用扇头韵","author":"袁宏道","text":"墙东何意独违时，峻坂飞驰梦亦危。\n青岫渡头多少浪，白云高处有无岐。\n閒思短棹歌渔父，静抱幽弦问子期。\n且与提携山上去，不须瓶耻始杨卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45276,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日苦雨和退如太史 其一","author":"袁宏道","text":"积雨如山卧不知，闭门犹自写秋诗。\n高斋束筏安文几，侍女乘橇过酒卮。\n麓处也应无燥地，巢栖未见有安枝。\n题书为慰东邻子，梦里分明拥蔡姬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45277,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日苦雨和退如太史 其二","author":"袁宏道","text":"霆轰电射不终朝，何事阴淫怒不消。\n楼上女儿齐浣屧，宫中铜狄尽浮腰。\n汉官著笠趋龙尾，河鼓张油度鹊桥。\n大道狭斜俱眼底，那堪十户九萧条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45278,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日苦雨和退如太史 其三","author":"袁宏道","text":"河漕西下沸如汤，骤雨那知触禁墙。\n金马门前泥没象，铜驼陌上水平坊。\n千家灯火然阴壑，五夜哀呼彻未央。\n缚竹为箄通市口，大都风景似南方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45279,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日苦雨和退如太史 其四","author":"袁宏道","text":"家家釜里看游鱼，壁落都空那可居。\n远觅瓜梨分孺子，共租楼阁展图书。\n哭声断处唯空巷，客梦还时想故庐。\n忆昨柳浪亭上水，湖光千顷荡芙蕖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45280,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕同方子公蒋子厚弟小修避水长孺楼居","author":"袁宏道","text":"悔逐缁尘帝里游，除君何处可消愁。\n蚍蜉失土先谋芥，野鹤移家亦傍鸥。\n稍质衣衫充酒品，尽搬香茗在书楼。\n帘开忽见新晴日，又到黄姑织女愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45281,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为耿华平题先公册先公居江陵时以绣衣直指录囚不及格被谪","author":"袁宏道","text":"手掺丹笔泪沾巾，活却梧丘几许人。\n韩朗大多争日月，赞皇遗怨竟灰尘。\n家贫自许门容驷，国瑞方知种有麟。\n试看成蹊桃与李，宁同枳棘一班春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45282,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘元定斋中别诸社友时余有内人之戚","author":"袁宏道","text":"一竿直出帝城烟，马首弓尘仅一年。\n倦鸟早辞燕树雪，间花又上武溪船。\n伯鸾未得偕妻隐，和靖终当伴鹤眠。\n白尽头颅应不返，青溪山下有鸣泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45283,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早春过葵园次苏潜夫壁间韵余往过此八年矣","author":"袁宏道","text":"高斋只在郭门间，世外佳人共往还。\n老去心情浑念水，重来竹树已连山。\n幽花近暖争先发，好鸟逢春尽不閒。\n别后新功何所验，临溪且照旧容颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45284,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登晴川阁望武昌","author":"袁宏道","text":"霜崖突出藓纱斑，铁笛临风去不还。\n百里帆墙千里水，一层城郭几层山。\n遥知郁郁葱葱地，只在熙熙攘攘间。\n沙鸟窥鱼鸥觅渚，试看何物是清閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45285,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日冯明甫郡公招游谢公岩同顾朗哉处士于野宗侯剧饮分韵得千字","author":"袁宏道","text":"刻秀堆岚岁几千，而今始落酒卮边。\n洞中歌板疑云出，石上觥筹似水传。\n山简韵高无政事，羊公才大少诗篇。\n儿童拍手拦街语，老守风流胜昔贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45286,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即席用韵赠于野宗侯","author":"袁宏道","text":"买却青山一段烟，瓮中光景任流连。\n但同习郁酣池水，不向君王乞酒泉。\n缃帙未离绳几上，白云只在枕函边。\n碧瞳羽客閒来往，日课灵文字五千。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45287,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又赠朗哉仍用前韵","author":"袁宏道","text":"回首春明话昔年，因君忘却路三千。\n铜鞮陌上穿花出，岘首碑前枕石眠。\n醉后书颠如长史，老来诗淡类斜川。\n楚人调涩无佳韵，好谱离骚入管弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45288,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕招黄道元丘长孺陶孝若张伯寔王遗狂十弟平子饮小斋得衫字道元先以诗来率尔奉答道元永嘉人余时以仪曹改司封","author":"袁宏道","text":"掖门清露滴松杉，暮直归来口尚缄。\n斜月乍临移酒盏，凉风忽起换蕉衫。\n桐江我记从前路，雁宕君居第几岩。\n官舍未容投辖饮，误将尘土换冰衔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45289,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中元日夜归即事仍用前韵","author":"袁宏道","text":"葛巾脱去鬓如杉，又草朝贤牍几缄。\n竹里乍香新茗椀，榻间犹藉旧荷衫。\n空窗月色霜流地，半夜桐声水绕岩。\n天驷岂能容野马，身无羁绁口无衔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45290,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春偕同署诸君子饮郭外","author":"袁宏道","text":"滑滑春流泻縠纹，岚光映照石榴裙。\n今朝止许谈风月，何日相从问水云。\n细雨户收山鸟喜，乱畦行尽草花薰。\n海棠枝底乌纱侧，未觉飞觥到十分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45291,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春游韦氏庄忆十二年前先伯修暨顾升伯李长卿偕游此地今伯修去世八年顾李二兄新以言去古人云未免有情谁能遣此潸然久之","author":"袁宏道","text":"犹记天街白鼻騧，出门长是踏飞沙。\n几年夜雨慈恩寺，十度春风奈子花。\n石火仓忙思驻景，滩流清浅梦移家。\n东林法道衰如许，不见栽莲谢永嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45292,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿毕侍御两尊人","author":"袁宏道","text":"花外红绡白雪垂，豸袍如火映春卮。\n皋桥祇有齐眉伴，彭泽唯闻历齿儿。\n玉树种成千亩实，鹓雏栖遍万年枝。\n黄山石上青松老，閒看仙人数局棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45293,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初夏偕同署诸君子饮西郊池亭仍用前韵","author":"袁宏道","text":"花时聊复问鸥群，树有新阴藻有文。\n且与共听幽涧水，休教惊散隔溪云。\n青衫暂可驱从使，红袖那堪对此君。\n韵远心空无一语，不知啼鸟欲何云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45294,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶作赠方子","author":"袁宏道","text":"一瓶一笠一条蓑，善掺吴音与楚歌。\n野鹤神清因骨老，鸳鸯头白为情多。\n腰间佩玦千年物，醉后颠书十丈波。\n近日裁诗心转细，每将长句学东坡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45295,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬尽偶成","author":"袁宏道","text":"青霜一寸冰皮老，冻楚荒荒落饥鸟。\n老去惭看日脚忙，冬来怕见历头少。\n客里关心辽左书，梦中失路京华道。\n宦心灰尽复如何，大都也似霜前草。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45296,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别小修","author":"袁宏道","text":"瓜洲云色蔽天昏，肠断金山寺里猿。\n狎客也须同海鸟，过江切莫食河豚。\n幕中有主当持牍，雪里无钱且典裈。\n画戟如林高丈五，不知何处是朱门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45297,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王太古令郎有父风即赋","author":"袁宏道","text":"空阶长日绿苔封，一望江烟翠色重。\n陶令无儿间纸笔，庞公有子识机锋。\n窗前慈竹分新种，雪复山鸡觅旧踪。\n总角未除髭未长，因君自笑老龙钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45298,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事时京使至","author":"袁宏道","text":"朔霰泠泠打角巾，客途那得更长贫。\n百钱买看双双女，一日刺投数主人。\n白酒澄来如雪水，青袍当去得霜鳞。\n端居忽谩逢京使，怕说东华十丈尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45299,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁酉十二月初六初度 其一","author":"袁宏道","text":"双鬓蓬蓬又一新，布衣何处不缁尘。\n高天下地尽如此，开口伸眉有几人。\n客馔夜深烧蕨粉，山垆冬尽剥松鳞。\n清溪半曲田三亩，只待陶公与结邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45300,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁酉十二月初六初度 其二","author":"袁宏道","text":"幽总朝起自焚笺，收拾从头旧简编。\n文字少无隔宿约，橐囊充有半年钱。\n花前沃雪呼家妓，醉后灰心学老禅。\n抛却吴官今一载，青泉白可几高眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45301,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁酉十二月初六初度 其三","author":"袁宏道","text":"角巾散带亦何为，白首庞公是我师。\n灯下侍儿閒礼忏，床头稚子解吟诗。\n江渔供客来冰缝，山鸟惊人触冻枝。\n鬓发如油霜镜卜，等閒拔出几茎丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45302,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁酉十二月初六初度 其四","author":"袁宏道","text":"天涯随处是生缘，阔帽宽衫似老年。\n算马与人三十口，卖奴及宅五千钱。\n一心槁木寒灰去，几度披书抱酒眠。\n古佛阁前温炕里，拽将红袖夜谈禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45303,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁酉十二月初六初度 其五","author":"袁宏道","text":"雪霁寒江馔得鱼，北风香堕蜡梅初。\n身閒白发颠先黑，病后乌纱梦亦疏。\n薄宦古人双屈指，家乡经岁两番书。\n百年碌碌浑如此，检点从前事事虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45304,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙诗为胡仲鱼作","author":"袁宏道","text":"愿作人间丁令威，千年华表一来归。\n天门戏博输龙去，石室烧丹试犬飞。\n洞里松花充晓饭，箧中云叶作寒衣。\n鄣山若更逢潘子，为问桃源是也非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45305,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻崔氏女拜无念学道戏柬念师","author":"袁宏道","text":"撇他螺黛与铅华，爱渴惟消一碗茶。\n檀板且教歌梵字，罗衣权剪作袈裟。\n心如止水堪容月，身似寒株也著花。\n摩顶几回亲记取，生生世世法王家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45306,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪夜感怀","author":"袁宏道","text":"空房夜尽落灯煤，一络窗风似剪来。\n三尺雪中乘梦去，五更天外觅愁回。\n薏仁酒尽唯空盏，螺甲薰残只死灰。\n为忆朱门深宅里，几人歌笑几楼台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45307,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"侵晓见闺人礼忏","author":"袁宏道","text":"残月微微散晓星，窗风吹动画幡铃。\n衣中珠珞千条重，定后炉烟一缕青。\n鹦鹉教来持口戒，莲华绣去裹心经。\n梵音唱彻声清远，卧阁何人梦不醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45308,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"放言效元体 其一","author":"袁宏道","text":"人间得失只如斯，得固欣然失岂知。\n消日总多无义语，安心唯有耐输棋。\n乡书寄去求鹅炙，阑客新来送荔枝。\n今古腾腾一觉里，管他淳朴与浇漓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45309,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"放言效元体 其二","author":"袁宏道","text":"三十年间闪电身，半居白石半红尘。\n空中往往书欢字，镜里频频感去人。\n方带割来殉酒盏，时瓶破后少茶宾。\n眼前笑得须当笑，未有脂胶粘日轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45310,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"放言效元体 其三","author":"袁宏道","text":"花前蓬鬓影婆娑，每到花开即浩歌。\n甘草虽甜终傍苦，蜘蛛纵巧不离罗。\n常年欢与愁相对，百岁仙于人孰多。\n白日既知无返理，问君何不买青娥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45311,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"放言效元体 其四","author":"袁宏道","text":"葛滕为杖竹为冠，浮世都教一例观。\n龙伯山来犹气岸，醯鸡梦里亦酸寒。\n伊周未必闲经济，杨墨徒劳辟异端。\n识得个中些子去，蛮天鬼国也相安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45312,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"放言效元体 其五","author":"袁宏道","text":"幸将七牍赎閒身，早晚山中事事新。\n批类乌为同鼓吏，寒号虫作守更人。\n摊书误置岩前树，洗墨常翻雾里鳞。\n醒即长吟睡即定，更于何处觅埃尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45313,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得家报 其一","author":"袁宏道","text":"清晨阁外逢乡使，持得平安书信来。\n初问三哥何处去，次言八口几时回。\n新城渐渐沈流水，旧舍荒荒长草莱。\n幸有南龚与北李，时时出郭时衔杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45314,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得家报 其二","author":"袁宏道","text":"瀑布声中洗面尘，洞花沚草自然春。\n欲攀绝壁无根地，且趁孤云未老身。\n堕险啼厓皆韵事，倚松坐石想幽人。\n飞仙巳蜕茅龙死，留得青山一壑鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45315,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得家报 其三","author":"袁宏道","text":"艰危历尽到岩居，可有丹梯上碧虚。\n玉女烟中频索梦，莲花叶上细题书。\n补填积雪成新径，展拓间云架小庐。\n别院棋枰声隐隐，微风恍惚动仙裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45316,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得家报 其五","author":"袁宏道","text":"杖底诸山似浪纹，舞青摇绿鬣纷纷。\n半规影里江河合，一尺烟中晋楚分。\n未有因缘离下界，虚将名字列高云。\n松风破梦丹炉冷，惭愧琼田碧草芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45317,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"华顶示同游樗道人","author":"袁宏道","text":"踏遍秋云琢紫苔，巨灵掌上觅松栽。\n公超旧谷犹疑雾，方朔前生解役雷。\n幻诡也能通道术，诙谐大抵近仙才。\n芙蓉一削五千仞，不是狂夫不上来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45318,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岳顶归至青柯坪示同游道人","author":"袁宏道","text":"飞鸿是处有遗踪，题破苍崖雾几重。\n枉把真形图五岳，难将奇句答三峰。\n山臞未老身惭鹤，雪顶归来杖有龙。\n紫蕨黄精君记否，铁犁沟下旧村农。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45319,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登太室绝顶","author":"袁宏道","text":"砾瓦纷纷雨洗斑，嵩峰久矣闭仙关。\n云开忽见玲珑壁，水外微铺淡远山。\n古道熟知龙洞崄，僧云胜在石楼间。\n幽岩欲去无栖处，猎火烧空照夜还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45320,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观卢岩寺瀑布 其一","author":"袁宏道","text":"百尺烟中紫翠分，水光摇日雪纷纷。\n长风碎曳千年石，飞雨斜侵半壁云。\n涧底有人穿洞出，山间投砾隔村闻。\n仙家只在深岚里，松腹犹存鸟篆文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45321,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观卢岩寺瀑布 其二","author":"袁宏道","text":"洞门长是带云关，竹杖深穿香叆间。\n醉里放杯眠涧水，梦中和雨入卢山。\n霞光射壁残碑出，松影流阶处士还。\n潭下老龙呼不起，携将新月过烟鬟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45322,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠登封令傅元鼎","author":"袁宏道","text":"麈尾一麾案牍稀，石淙潭水洗秋衣。\n公庭叶落书常满，绝壁云开舄自飞。\n入寺每教求藓迹，上山亲与勘松围。\n梦中白鹤如相语，君是重来丁令威。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45323,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嵩阳宫古柏封于汉非汉物也都玄敬以为三代时物信然","author":"袁宏道","text":"看穷人代只青葱，山鬼那能记始终。\n手把洛书逢大禹，眼窥日表见周公。\n龙鳞抉石方知地，鹏翮抟天始送风。\n纵使文成能诳语，问渠霞壁几时红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45324,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石淙 其一","author":"袁宏道","text":"一区崖壑洗深清，傍崄随夷置酒鎗。\n石是米颠怀袖出，景如摩诘画诗成。\n游人恰好中央坐，怒水常穿四壁行。\n若把卢岩来比较，卢岩虽胜少幽情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45325,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石淙 其二","author":"袁宏道","text":"陂陀行尽见幽奇，想得川融山结时。\n大辟嵩高知第舍，小分烟岭即园池。\n崩云倒沬森森立，枕石听泉事事宜。\n胜迹几人曾到此，摩崖碑上有娥眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45326,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将入秦试士诸同舍别于西郭水亭得鱼字","author":"袁宏道","text":"郭外园林尽不如，水亭香泛绿芙蕖。\n门前且系新骊马，囊里犹存旧蠹鱼。\n华岳看云唯自语，曲江题壁倩谁书。\n凭君为报关门尹，不是当时板屋车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45327,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青楼曲","author":"袁宏道","text":"懒看梧叶下空堂，秋月秋风泪几行。\n独夜香皋缄远字，经年鸾匣缓离妆。\n兰披别恨潇湘浦，柳带愁烟汉水傍。\n折尽庭花人不见，枉教蟢子堕流黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45328,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虎丘 其二","author":"袁宏道","text":"问此石上歌，何如生公说。\n石若解点头，闻歌亦当彻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45329,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]