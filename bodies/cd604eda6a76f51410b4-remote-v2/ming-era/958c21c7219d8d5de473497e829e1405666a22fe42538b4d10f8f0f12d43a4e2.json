:"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22020,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鸣琴图","author":"朱朴","text":"抚罢阳春意万重，馀音犹似和松风。\n高云不度层峰顶，閒看飞流挂玉虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22021,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渔笛图","author":"朱朴","text":"晚峰隔树留残照，秋水连天映落霞。\n长笛数声人不见，一行联雁起平沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22022,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东汀","author":"朱朴","text":"柳色烟光杳不分，鵁鶄鸂鶒动成群。\n洞庭春水东来阔，吞尽蘼芜百顷云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22023,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梅魂","author":"朱朴","text":"玉貌凝香亸画衣，烟笼月色是邪非。\n夜深只恐吹琼琯，化作行云何处飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22024,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鸣琴","author":"朱朴","text":"幽谷香风吹紫兰，月明泉上发哀弹。\n猿猱不语魍魉避，一夜空山孤鹤寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22025,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东滨园观黄菊","author":"朱朴","text":"馀春园里小春时，红白葳蕤剩故枝。\n惟有一丛金宝相，风霜不改岁寒姿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22026,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梦竹","author":"朱朴","text":"湘皋地湿草萋萋，春渚相牵思欲迷。\n零落残魂何处断，半林斜日鹧鸪啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22027,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题水仙花四首 其一","author":"朱朴","text":"碧池妆镜晓寒消，不染铅华意自娇。\n恼杀江南赵公子，却将金粉浣生绡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22028,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题水仙花四首 其二","author":"朱朴","text":"碧露盈盈点翠苗，香风冉冉月中飘。\n遗芳不入骚人佩，泣对秋兰恨未消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22029,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题水仙花四首 其三","author":"朱朴","text":"粉额涂黄亸翠翘，练裙和露束纤腰。\n犹疑汉武长门夜，寂寞春寒锁阿娇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22030,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题水仙花四首 其四","author":"朱朴","text":"月冷秦楼罢玉箫，水边飞步倚兰苕。\n幽花剪刻无人识，零落钗头白凤翘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22031,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"习斋","author":"朱朴","text":"涧道春风动绛帷，海门山色到柴扉。\n满腔幽思无人论，故垒新篁看燕飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22032,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东麓山居","author":"朱朴","text":"家在千山欲尽头，长林绝壁寺门幽。\n定回残日下西岭，虚阁磬声黄叶秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22033,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渔笛","author":"朱朴","text":"短笛轻舟水满汀，白云青草树冥冥。\n秋风一曲沧浪调，不是关山月下听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22034,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪窗画兰四绝 其一","author":"朱朴","text":"雪窗学兰如学禅，墨君生意自天然。\n百年纸上看图画，彷佛幽香起麝烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22035,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪窗画兰四绝 其二","author":"朱朴","text":"苍苔白石蔽芳丛，湛露幽香湿翠蓬。\n自古佳人老空谷，不须零落怨春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22036,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪窗画兰四绝 其三","author":"朱朴","text":"一从尼父罢弦琴，寂寞哀音直至今。\n留得杏花坛上谱，后人传指不传心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22037,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪窗画兰四绝 其四","author":"朱朴","text":"白云黄叶满山家，又见光风转蕙花。\n不用薰炉爇沈水，一帘香霭读楞伽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22038,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬晓","author":"朱朴","text":"布被寒多夜更长，南荣早起爱朝阳。\n教儿莫埽阶前叶，留与苍苔护晓霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22039,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题东滨画扇兼柬伯兄丰厓","author":"朱朴","text":"汉水汤汤蜀道难，彭城风雨隔江关。\n争如共结青山社，万壑千峰日往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22040,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"明妃","author":"朱朴","text":"笑拂蛾眉出镜中，君王遣妾为和戎。\n后宫粉黛三千辈，谁有长城尺寸功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22041,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"托钵僧","author":"朱朴","text":"无事经旬不出山，偶因乞米到人间。\n斜阳满地松阴转，閒向西林托钵还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22042,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"为僧画扇","author":"朱朴","text":"山中面壁已多年，涧草嵓花总入禅。\n日暮凉风何处起，却吹松子落僧前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22043,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"僧半筠","author":"朱朴","text":"山僧寂寞老无伴，把玩脩竹情何长。\n夜深禅定万籁息，僧邪竹邪俱两忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22044,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋山","author":"朱朴","text":"碧树经霜叶半殷，岩云不雨自飞还。\n瑶琴曲尽无人听，独上高台看晚山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22045,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"姑苏台","author":"朱朴","text":"夕阳芳草故宫春，麋鹿荒台不见人。\n七十二峰南望远，翠娥犹学捧心颦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22046,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"凤凰台","author":"朱朴","text":"试上高台问昔游，凤凰飞去几千秋。\n渔翁暗指前朝事，白鹭洲边楚水流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22047,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"歌风台","author":"朱朴","text":"酒阑歌彻大风词，不是鸿门舞剑时。\n万里中原皆汉土，高王犹有故乡思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22048,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"巫阳台","author":"朱朴","text":"湿翠浮岚埽不开，乱峰深处是阳台。\n无情最是巫山女，不待襄王觉后来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22049,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"凌歊台","author":"朱朴","text":"见说凌歊宋祖台，黄山曾绕翠华来。\n千金一刻笙歌夜，化作猿声向月哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22050,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"画鹿","author":"朱朴","text":"闻道吴王国已亡，姑苏麋鹿草茫茫。\n春深废苑无人锁，衔取宫花出禁墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22051,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"为西皋画山水","author":"朱朴","text":"天上归来鬓未秋，杜陵幽兴付沧洲。\n丛篁绝壁空山晚，独抚寒松看水流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22052,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题梅花送南溪张公","author":"朱朴","text":"春风未结和羹子，腊月先开带雪花。\n折赠一枝随马去，馀香犹在野人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22053,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"水仙花","author":"朱朴","text":"白玉搔头金凤翘，翠裙袅袅束纤腰。\n紫箫吹断瑶池梦，飞落寒塘寄寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22054,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"白菊","author":"朱朴","text":"白石萧萧碧藓荒，一枝秋色抱馀芳。\n开帘不见阶前影，月满空庭夜有霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22055,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"画","author":"朱朴","text":"霁雨湖天散晓霞，绿芜烟水漾金沙。\n行人已渡长桥外，没胫春泥带落花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22056,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"河梁别","author":"朱朴","text":"白草黄云虏塞秋，廿年辛苦雪盈头。\n河梁泣别千行泪，洒向西风各自流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22057,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武原杂题八首 其一 宣慰楼","author":"朱朴","text":"罗绮香消镜匣收，碧山空对晚妆楼。\n楼前昨夜新秋月，犹学蛾眉翠黛愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22058,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武原杂题八首 其二 紫云村","author":"朱朴","text":"紫云山下紫云村，山水盘旋草树蕃。\n桃李春风二三月，人家疑在武陵源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22059,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武原杂题八首 其三 月色轩","author":"朱朴","text":"蝶老花残燕不归，酒阑香尽客来稀。\n多情只有黄昏月，依旧清光照琐闱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22060,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武原杂题八首 其四 金粟山","author":"朱朴","text":"金粟如来此现身，偶来方丈说云云。\n山僧不识开山事，指点前朝玉篆文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22061,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武原杂题八首 其五 碧云寺","author":"朱朴","text":"塔影萧萧夕照间，碧云黄叶满秋山。\n空堂夜冷无灯火，惟有残僧乞米还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22062,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武原杂题八首 其六 闻琴台","author":"朱朴","text":"晋代相传直至今，子期曾听伯牙琴。\n高山流水依然在，寂寞荒台蔓草青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22063,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武原杂题八首 其七 乌夜村","author":"朱朴","text":"玉貌曾沾帝子恩，故乡环佩葬归魂。\n千年废寝无寻处，夜月啼乌尚有村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22064,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武原杂题八首 其八 读书堆","author":"朱朴","text":"兰若双峰碧树隈，逋翁传有读书堆。\n数声秋磬孤烟外，想见高吟待月来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22065,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"僧寮卧雪","author":"朱朴","text":"风定云凝数峰雪，冻木无声涧流绝。\n道人不寐夜方央，何处寒钟打山月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22066,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"采莲曲","author":"朱朴","text":"湖南采莲子，湖北采芙蓉。\n莲子心犹苦，芙蓉花自红。\n日暮高歌下烟渚，鸳鸯飞过湖东去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22067,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"董两湖扇图","author":"朱朴","text":"南湖春水平，北湖春草绿。\n中有击楫人，解唱沧浪曲。\n残阳在山曲未终，万壑天风振林木。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22068,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西麓","author":"朱朴","text":"一轩含万景，西麓道人家。\n花事春常晚，夕阳山更佳。\n捲帘飞宿鹭，鸣磬集归鸦。\n记得看秋雨，焚香啜茗芽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22069,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"放宫人","author":"朱朴","text":"玉貌委深宫，宫花几度红。\n忽闻开锁钥，相唤出帘栊。\n省得归人世，犹疑是梦中。\n半生憔悴眼，拭泪见春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22070,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新嫁娘","author":"朱朴","text":"三日新嫁娘，上堂拜姑嫜。\n含羞理珠翠，纤手整衣裳。\n侍婢潜窥觊，邻娥窃较量。\n它时论妇道，应不在容妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22071,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"采菱词","author":"朱朴","text":"采菱南塘下，水深菱叶稀。\n菱花比妆镜，菱叶比罗衣。\n轻风漾楫去，落日唱歌归。\n无情两白鸟，来往趁船飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22072,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"澄心","author":"朱朴","text":"卧病诸缘绝，澄心万虑空。\n闭门移白日，高树落清风。\n晚节青藜杖，家资绿酒筒。\n怀人不可见，吟断寂寥中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22073,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"归舟","author":"朱朴","text":"榆柳绿阴成，菰蒲野水生。\n好风催挂席，迟日衍归程。\n麦熟吴蚕老，桑稀布谷鸣。\n南山横一抹，渐觉近人明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22074,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]