[{"title":"述妇病怀 其四","author":"王彦泓","text":"文茵龙脑睡来闻，懒著前春染麝裙。\n谁识病来颠倒想，爱香人却怕香熏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29952,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"述妇病怀 其五","author":"王彦泓","text":"瘦质浑成笋一竿，隔衾犹自见巑岏。\n平生守礼自谦畏，不受荀郎熨体寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29953,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"述妇病怀 其六","author":"王彦泓","text":"难凭银叶镇心惊，侍女床前不敢行。\n无奈药炉初欲沸，梦中已作殷雷声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29954,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"述妇病怀 其七","author":"王彦泓","text":"一勺清浆价一金，驻颜难恃紫团参。\n头花臂钏看看尽，卖到当年结发簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29955,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"述妇病怀 其八","author":"王彦泓","text":"娇痴稚女最关情，新读毛诗一半生。\n忍死看他成长去，喘丝亲训两三声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29956,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"述妇病怀 其九","author":"王彦泓","text":"汤药亲尝子妇该，云泥悬绝事堪哀。\n自知病骨轻如草，莫望尚书嫁女来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29957,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"述妇病怀 其十","author":"王彦泓","text":"更无兄妹与差肩，辜负叩劳阿母怜。\n嘱向薄情狂婿道，为加恭敬倍从前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29958,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"述妇病怀 其十一","author":"王彦泓","text":"谢绝妖巫罢祷祈，不将性命媚神祇。\n刻肌冤苦伤心痛，病者年来细得知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29959,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"述妇病怀 其十二","author":"王彦泓","text":"前路无涯爱有涯，一心趋向妙莲花。\n眼前眷属休悲恋，九品同生也一家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29960,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题","author":"王彦泓","text":"眉萼慵描出内稀，试晴风日浣罗衣。\n雪融香迹重台样，春减裙腰尺六围。\n随意梳匀都韵事，不形颦笑总沉几。\n无端午睡醒来晚，惊认残阳作曙晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29961,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"花下","author":"王彦泓","text":"未必春工一夕移，杏花清减夜来姿。\n可知颜色关人处，正在红消欲白时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29962,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"旦旦","author":"王彦泓","text":"一寸丹诚皎日同，薄情犹自认朦胧。\n无由披膈教君见，想煞秦宫照胆铜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29963,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晴日偕同人有见","author":"王彦泓","text":"风暄日冷正佳辰，绿净园南韭叶春。\n狂社乍闻浮白手，严闺初放踏青人。\n故嗔平视遮生客，暗记微词识近邻。\n临去更怜低树好，绕枝闲看两三巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29964,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"踏春词偕云客孝先韬仲作 其一","author":"王彦泓","text":"女伴相呼早，春寒懒下床。\n檀郎侍梳洗，阿母简衣裳。\n爱影频看镜，回身暂进房。\n偶因裙带换，忘却紫罗囊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29965,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"踏春词偕云客孝先韬仲作 其二","author":"王彦泓","text":"何必花堪赏，平芜绿可怜。\n香轮逢郑旦，金弹逐韩嫣。\n船近桃根泊，裙来柳下湔。\n自缘愁绪乱，风景恶相牵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29966,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"踏春词偕云客孝先韬仲作 其三","author":"王彦泓","text":"小径横斜去，经过绿水园。\n园丁劳指点，邻女喜寒暄。\n薄雪凝阴榭，低枝压短垣。\n同行莫攀折，赢得糁衣繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29967,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"踏春词偕云客孝先韬仲作 其四","author":"王彦泓","text":"何处堪携手，南塘碧树边。\n有心同皎日，无胆似非烟。\n暗影乌龙觉，乖音鸩鸟传。\n匆匆拣不尽，当面付红笺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29968,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"踏春词偕云客孝先韬仲作 其五","author":"王彦泓","text":"孀艳松根哭，重泉听得无。\n野风吹缟袂，坟草溅啼珠。\n出郭初迷路，回房定向隅。\n伤心蝼蚁穴，命薄不前驱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29969,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"踏春词偕云客孝先韬仲作 其六","author":"王彦泓","text":"画壁前朝寺，阴森夹径松。\n偶来双骑白，时度一衫红。\n脱钏供香像，悬翻绣毒龙。\n那堪歌舞席，近在讲堂东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29970,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"踏春词偕云客孝先韬仲作 其七","author":"王彦泓","text":"风日薰南浦，魂消瑟瑟波。\n被留青翰宿，香待博山过。\n幽意春前积，佳游水上多。\n从来悲喜并，牛女在明河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29971,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"踏春词偕云客孝先韬仲作 其八","author":"王彦泓","text":"鸂鶒斜飞处，云阴日半塘。\n渔郎歌倚棹，蚕妾笑提筐。\n鬓湿簪花露，裙沾斗草香。\n同行暂犹好，归路莫嫌长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29972,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"踏春词偕云客孝先韬仲作 其九","author":"王彦泓","text":"卸却吴绫重，宽衫奈瘦何。\n偶随啼鸟听，竟踏落花过。\n玛瑙春云寺，胭脂夕照坡。\n画船何处去，烟外响吴歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29973,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"踏春词偕云客孝先韬仲作 其十","author":"王彦泓","text":"锁钥岩城早，难拚是夕晖。\n水心初潋潋，楼角更依依。\n蹋鞠争先入，胡琴落后归。\n不妨南市过，月下独来稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29974,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拾天宝事 其一","author":"王彦泓","text":"忍笑凝颦倚唾壶，笋香荑嫩捧芙蕖。\n樱桃树下鹦哥畔，一幅杨妃病齿图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29975,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拾天宝事 其二","author":"王彦泓","text":"蚕眠金字迹煇煌，盥手临池细炷香。\n谁令女人偏好善，有情皇帝李三郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29976,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"个人之一","author":"王彦泓","text":"铜尊花露玉炉烟，长见飞琼侍晓筵。\n觉我欲前微掩敛，避人佯退定迁延。\n无聊脱钏红箱畔，特地兜鞋碧槛边。\n喜煞未曾梳洗在，翠鬟松压睡容鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29977,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"追忆","author":"王彦泓","text":"万叠伤心露浅颦，唇朱欲动更逡巡。\n休论笑眼生花处，一段愁光眤煞人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29978,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"代赠","author":"王彦泓","text":"绛树休嗟结子迟，惜花人更惜空枝。\n紫薇得到重来日，宛是深红未落时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29979,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"悲遣十三章 其一","author":"王彦泓","text":"神伤不哭愧前贤，虚读南华十八篇。\n曾有达人难达处，风刀将断喘丝悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29980,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"悲遣十三章 其二","author":"王彦泓","text":"青瞳枯涩渐无光，犹自瞢腾觅阿娘。\n苦是舌根闲强后，模糊言句费猜详。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29981,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"悲遣十三章 其三","author":"王彦泓","text":"儿擎婢捧藉重裀，半转孱躯万苦辛。\n若使有灵还负痛，泉途扶侍托何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29982,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"悲遣十三章 其四","author":"王彦泓","text":"寻常痛楚苦呻吟，户外遥闻便刺心。\n今日进房都寂寂，不堪仍向旧床寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29983,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"悲遣十三章 其五","author":"王彦泓","text":"尸堂揭白写形模，几遍端相未是他。\n欲倩画工追笑靥，可堪连岁泣时多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29984,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"悲遣十三章 其六","author":"王彦泓","text":"半月前还弄剪刀，剩抛金线几多条。\n病中改出裙花样，为向灵筵挂几朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29985,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"悲遣十三章 其七","author":"王彦泓","text":"影堂灯火碧荧荧，消息都无去杳冥。\n曾是向来行立处，纸钱灰烬满中庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29986,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"悲遣十三章 其八","author":"王彦泓","text":"悼亡非为爱缘牵，俨敬如宾近十年。\n疏阔较多欢洽少，倍添今日泪绵绵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29987,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"悲遣十三章 其九","author":"王彦泓","text":"为是妻言故未听，劳将曲蘖戒刘伶。\n今年醉也无人管，一度持觞一涕零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29988,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"悲遣十三章 其十","author":"王彦泓","text":"醉时感慨醒来闷，贫用奔波病却眠。\n白日无聊更无暇，黄昏独到穗帷前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29989,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"悲遣十三章 其十一","author":"王彦泓","text":"盂兰香食散河津，曾看莲灯出水新。\n谁道沧桑一年事，施灯人作受灯人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29990,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"悲遣十三章 其十二","author":"王彦泓","text":"幢翻收卷散花场，烧罢人间七七香。\n净土天宫随意住，可知尘世独凄凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29991,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"悲遣十三章 其十三","author":"王彦泓","text":"先行几步谅无多，究竟同归此逝波。\n我已自知生趣短，暂停相待却如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29992,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过妇家有感 其一","author":"王彦泓","text":"谢家重见缟衣郎，群婢相看掩泪光。\n特送伤心小甥女，绕身啼唤觅姨娘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29993,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过妇家有感 其二","author":"王彦泓","text":"归宁去日泪痕浓，锁却妆楼第二重。\n空剩一