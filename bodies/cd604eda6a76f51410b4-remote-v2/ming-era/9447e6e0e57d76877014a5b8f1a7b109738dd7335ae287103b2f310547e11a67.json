[{"title":"将往白沙","author":"张诩","text":"衣冠今代又东周，南望江门柳渡头。\n紫水黄云来短屐，青天白日放孤舟。\n年来爱客常投辖，老去伤心独倚楼。\n愿借金针同出世，十洲三岛漫遨游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53379,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵","author":"张诩","text":"于斯定鼎握乾符，壮矣规模近古无。\n四海旧邦文物地，万年昭代帝王都。\n文谟武烈传孙子，虎踞龙盘入画图。\n怅望九霄龙驭远，遗弓抱处泪如珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53380,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至虔州会故人蒋中丞诚之先生","author":"张诩","text":"一别中丞二十秋，朋簪今喜盖虔州。\n西江开府逢新政，南海攀辕忆旧游。\n宦辙萍蓬浑莫定，斯文胶漆素相投。\n乞骸会有重来日，准许江山半饷留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53381,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下十八滩","author":"张诩","text":"初伏舟经二水宽，储潭稽首祝平安。\n迢迢客路三千里，曲曲江流十八滩。\n老矣无才堪用世，徒然有疏力辞官。\n此行端为趋君命，名利茫茫总不干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立秋节舟至安庆","author":"张诩","text":"人过舒城感立秋，金风四起大江流。\n廿年东海持孤钓，一旦南都赋远游。\n渐觉薄寒生客袂，直凭清酤解离忧。\n衰迟跋涉那能惜，汪濊君恩特此酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泰和舟中值中秋节与友人玩月","author":"张诩","text":"潦倒江湖百不能，逢君殊觉喜怀增。\n停舟共赏中秋月，促席高烧两夜灯。\n国士低回心耿耿，客途跋涉鬓星星。\n明朝又作澄江别，快阁无心拟一登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泰和舟中怀罗道源少参","author":"张诩","text":"舟泊临江喜再逢，联舟相送过邻封。\n百年友道诗篇里，千里乡情酒盏中。\n满腹经纶缘此见，一腔春意为谁浓。\n无因写得相思句，尺牍秋风寄便鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别金陵用前韵","author":"张诩","text":"万里驱驰缴部符，高明还察此情无。\n晨披江雾朝陵土，晚束秋装别帝都。\n进退无过经济计，栖迟久绝利名图。\n肯将小节亏终始，累世承恩忝作儒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟经吉水读玉屑集有怀罗廷评惟升","author":"张诩","text":"短楫秋风不暂停，未从江海叹飘零。\n柬传吉水罗评事，诗咏金川练子宁。\n挂笏看山吟甫就，倚蓬扪虱酒初醒。\n鹑衣未补寒先透，旅况凄凉祇自怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53387,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题贞节卷","author":"张诩","text":"珠玉携来谁氏卷，烂然照我小西湖。\n纲常若论渠贞节，妇辈翻嗟烈丈夫。\n绰楔光腾今宅里，丹青谁貌女师模。\n休言世道无关系，一发千钧赖此扶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53388,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"督学先生粹夫枉顾话旧偶成","author":"张诩","text":"杏园同作探花游，一隔云泥三十秋。\n谁在桐江扶汉鼎，公亲琐闼侍宸旒。\n明珠南海无遗憾，谏草先朝可尽收。\n休叹颓波难复挽，直凭底柱屹中流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53389,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至日怀吉夫侍御","author":"张诩","text":"尽日蒙头岩户扃，停云何处最关情。\n坐忘自觉元和复，梦破谁知宠辱惊。\n短榻风连南岳秀，长筇月漾粤江清。\n何时载酒偿前约，看竹亭修近落成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53390,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵怀公覆","author":"张诩","text":"肯将英妙伴虚名，相对湖亭一榻清。\n稍带醉容非恶客，绝无尘地是蓬瀛。\n贫交半逐春云散，钓舫空萦夜月明。\n蚤晚朱陵吾放步，问君还许共西行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53391,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仁和褚公庙","author":"张诩","text":"天目山高浙水深，褚公名节到于今。\n题诗显庆千年迹，走马杭州万里心。\n沧海月明精卫哭，紫宸枫落牝鸡吟。\n今人不见前人恨，迎送神歌是楚音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53392,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵江宪副九日写怀","author":"张诩","text":"取乐荒园便有馀，龙山何必事崎岖。\n菊花酿喜今秋早，诗社人誇去岁无。\n万古乾坤都只寄，浮生富贵竟何须。\n试将面目西湖照，已有秋霜点鬓须。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53393,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得秉常南安见寄","author":"张诩","text":"和句封来梅岭外，看花人坐草庵前。\n昔年兄弟今分路，万里风波独泛船。\n伏枕觉还灯寂寂，伤心秋更雨连连。\n竿头点检丝纶在，乘月还来钓海天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53394,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄傲亭怀湛民泽","author":"张诩","text":"茅庵高枕白云边，日日松篁奏管弦。\n得饱秋霞聊抱膝，为怜夜月或移船。\n清凉境自閒心目，安乐窝真远市廛。\n何日杖藜还此愿，试临千仞弄飞泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53395,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵丘长史同年","author":"张诩","text":"江城风雨战残秋，万事人间叹谬悠。\n随意渔竿温钓石，何人羌笛弄江楼。\n千篇击壤诗陶性，三斗柴桑酒破愁。\n却忆旅亭丘长史，客怀乡思满归舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53396,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和唐人贾至早朝","author":"张诩","text":"绛帻鸡鸣三殿晓，景阳钟动九天开。\n南山日飏金杯暖，北阙云扶玉辇来。\n近侍衣冠同拜舞，遥闻仙乐暂徘徊。\n明良已际唐虞盛，欲效赓歌愧不才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53397,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答刘瑞葵见寄","author":"张诩","text":"潇飒颠毛任雪侵，八溟波杳笛声沈。\n秋临钓舫连阴雨，目断浮云怅古今。\n隔郡远劳诗见寄，别君长是梦相寻。\n潮阳东望不知处，慢把衷情托素琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53398,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王宪使","author":"张诩","text":"严霜飞尽入溟南，春意江山远近含。\n廿载才名闻病榻，一襟经略见高谈。\n活人不但参苓苦，泽物偏多雨露甘。\n试问粤南遗爱地，几时重睹驻公骖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53399,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送曹时卿赴湖广乡试","author":"张诩","text":"时卿过我西湖坐，全楚英材见此生。\n五色文章为世重，百年吾道待时行。\n贤流素志非温饱，文士填胸有甲兵。\n蚤晚飞黄腾踏去，好将三策助升平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53400,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠李德美佥宪谢事还丽水","author":"张诩","text":"直将天地作籧卢，名利浮云了莫拘。\n到处有山皆可屋，闲来无水不堪渔。\n自知靖节閒居得，世哂东坡药诵迂。\n非是平生高趣在，临歧争遣智询愚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53401,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠南雄别驾郑元美谢事还莆田","author":"张诩","text":"廿载金台幸识荆，四州别驾饮才名。\n青蝇白璧那能污，皓月长江空自明。\n五岭初醒蕉鹿梦，八壶重主鹭鸥盟。\n白头见素如相问，已办扁舟访岳行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53402,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林总督先生东征","author":"张诩","text":"三春一道见飞霜，我旅如神我伐张。\n头上有天閒日月，目中无地遁豺狼。\n谢安谈笑心存静，召虎经营事岂常。\n指日功成应奏凯，暖风归棹旆悠扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53403,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄都宪周知白先生镇虔州","author":"张诩","text":"不见中丞今八年，范滂丰采故依然。\n共知铁汉因遭蹇，权作金城且镇边。\n才大适逢多垒日，书成遥寄蚤秋天。\n郁孤台上凉如水，几度怀人月正悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53404,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答王监司叔毅","author":"张诩","text":"朱明古洞我閒居，窃似当年葛令庐。\n丹到九还无可炼，眼空六籍有何书。\n老便华岭千寻枕，病怯公孙万里车。\n咫尺行台不相见，笑将信息付江鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53405,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送骆明府督饷西征","author":"张诩","text":"大举群凶指顾戡，酂侯责任付君担。\n经纶南海民情便，生长西陲武略谙。\n舟破潮头天外白，旆摇山色雨中蓝。\n想应归日新亭就，杯酒军机坐细谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53406,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客携使交诗过读次韵赠湛民泽","author":"张诩","text":"约向沧溟共濯缨，当时决意谢浮名。\n功名自会寻温峤，昏嫁何曾累向平。\n书校藜光馀旧阁，使行烛影在新旌。\n星槎咫尺无由见，落日湖波空复情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别周柱史","author":"张诩","text":"里门绝迹几春冬，此日扶衰一送公。\n万里青天谁着眼，一江寒浪自推篷。\n交情磊落诗难写，别意绸缪画不工。\n此后云山多阻越，清容除是梦中逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送潘仲鲁黄门使交南","author":"张诩","text":"君行不是请长缨，旧制藩封事有名。\n此地先朝曾版籍，于今王上共升平。\n九天雨露来恩命，万里江山拥使旌。\n年少允宜投笔早，休教临祖动离情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答新安吴德夫见寄","author":"张诩","text":"枉把浮生叹不辰，眼中草木又逢春。\n君臣分在知蝼蚁，贤圣生来即凤麟。\n知己世难逢鲍叔，高情今复见汪伦。\n白头感慨终何极，漫尔狂歌和郢人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53410,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送高侍御出巡","author":"张诩","text":"春光当此半晴阴，法象天教岭海临。\n州郡每为蚕食苦，旄倪专候使车音。\n埋轮直气元无古，揽辔清风又播今。\n愿得甘霖随节注，炎荒到处起呻吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53411,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠罗蘖山方伯入觐","author":"张诩","text":"海国秋风搅树声，粤山粤水送君行。\n八年四海维藩誉，万里长驱入觐情。\n已见东南悲水火，还闻西北事经营。\n高材端合为时用，安得如前谷口耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53412,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠张秋官公瑞","author":"张诩","text":"栖迹西湖三十年，诸公海内辱称贤。\n不知虚薄甘持钓，错谓麒麟不受鞭。\n使节屡临青壁外，渔船长系绿杨边。\n新知最苦生离别，明日明年各一天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王司谏文哲奉使北还兼柬吴世美司谏","author":"张诩","text":"李泌当年一献身，岂无高楫济长津。\n观风夷夏诗多采，补阙朝廷疏屡陈。\n阿阁九苞回彩凤，急风千丈挺霜筠。\n因君却忆吴司谏，曾以龙光射钓纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠刘东山先生赴大司马之召","author":"张诩","text":"身系安危四十秋，公才合作济川舟。\n和风北雨人人悦，土俗民情处处求。\n西北烽烟今日急，东南凋瘵几时瘳。\n平生忧国忧民意，心纵求休谊可休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺张靖州八十一","author":"张诩","text":"已作人间八十翁，清如秋水照芙蓉。\n极知鹤算千年少，共讶仙颜壮日红。\n浩矣风怀张子野，飘然诗兴陆龟蒙。\n便当授与金丹诀，飞步蓬莱第一峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺徐都宪巡抚山西","author":"张诩","text":"玉音初听九重宣，共贺台端此得贤。\n饮水已先清百粤，倒囊今急救三边。\n广东俗异河东俗，此日天同昔日天。\n出处大臣终体国，烟霞名利总难牵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答廷雅明府","author":"张诩","text":"海康为令倦逢迎，旅泊东南岁十更。\n毛遂终然看脱颖，横渠元亦好谈兵。\n故山旧隐图中见，去路新秋马首生。\n想得留侯心事了，当年黄石是朱明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠梁宗烈","author":"张诩","text":"十月山南梅始花，恰逢姻娅到山家。\n茅茨旋设新篘酿，风雨初归旧钓槎。\n殿试才名闻辇毂，行程踪迹带烟霞。\n壶山回首沧溟畔，几度扁舟访白沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陈竹轩","author":"张诩","text":"门外春深草亦荣，黄莺寂寂听无声。\n孤灯不尽连床意，阴雨能知闭户情。\n渺渺江湖劳远梦，悠悠身世寄虚名。\n凭谁细语陈夫子，更著浮槎泛月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺别驾慎斋兄移居","author":"张诩","text":"父子移居同里闬，市廛虽近绝諠哗。\n一官蚤脱王祥驾，三径何殊靖节家。\n鸿雁昔悲分世路，脊令今喜共春沙。\n人生百岁须行乐，瀛水仙山况不赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘都宪子贤巡抚延绥","author":"张诩","text":"东南财赋今竭矣，西北烽烟尚赫然。\n此日北门烦锁钥，几年南国借旬宣。\n安边兵甲胸中有，活世参苓肘后全。\n自昔庐陵忠节薮，肯将勋业愧前贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠曲江罗主簿","author":"张诩","text":"一别临川十载前，中间消息两茫然。\n高谈忽向千峰接，美誉当令百里传。\n小试昔贤多佐邑，旧交今日合忘年。\n飞云万丈吾庐在，笑约重来一叩玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠博罗张知县叔昭谢事还仙游","author":"张诩","text":"识荆初忆聚贤关，屈指莺花二十残。\n治邑有才还制锦，干时无路耻弹冠。\n仙游俗古人多朴，拱秀楼高世少攀。\n孝女百年如一日，宗门合作郑门看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钟狂客应荐北行 其一","author":"张诩","text":"醉濡三斗墨淋漓，为写江亭送别诗。\n风雨闭门人病久，山花迎处马行迟。\n楚江万里来迢递，越曲三声唱别离。\n此日送君思往事，京华回首不胜悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钟狂客应荐北行 其二","author":"张诩","text":"寒潮急雨上江楼，青草沙边舣一舟。\n人醉东风殊可画，鸟歌斜日又堪愁。\n阮生送客能青眼，元亮求官尚黑头。\n安得病躯生羽翼，陪君走马到皇州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小西湖别陈秉常","author":"张诩","text":"公来别我西湖上，我忆交公廿载前。\n呼酒且看湖上月，乘潮莫放夜来船。\n竹林笑傲烟霞古，客路驱驰雨雪连。\n何处相思还一字，便鸿须寄蚤秋天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别罗公旦佥宪还任贵州","author":"张诩","text":"使车明日又西南，尊酒离筵各尽酣。\n故里流连温旧好，盛时经济见高谈。\n近海潮头天外白，入湘山色雨中蓝。\n相思他日知何限，莫惜逢人数寄缄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邓侍御良臣还朝","author":"张诩","text":"九重耳目寄诸公，何处炎荒久驻骢。\n许国本无身可计，救时还有疏堪封。\n行囊空照寒江月，归梦先随雪岭鸿。\n我欲赠君无可赠，白云流水万山中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵方选部叔贤赠别","author":"张诩","text":"世臣分敢比山林，颜乐于今久绎寻。\n随柳傍花如有意，行云流水却无心。\n小西湖畔波涛杳，宴乐亭前竹木森。\n未到朱陵天广大，休将意见测高深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵杨京兆子山赠别","author":"张诩","text":"瞻阙留都更谒陵，一朝趋命岂无名。\n头颅六十丹心在，客路三千白发明。\n短疏血诚天可扣，暮年诗社事堪成。\n赠言惭愧杨京兆，知我曾无一念生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵陈台州赠别","author":"张诩","text":"乡曲于君长十年，一回相见一忻然。\n停云屡入官舟梦，得句频教岭雁传。\n珠海曩时怀载月，银台今日愧徵贤。\n乞骸会有归来日，四百峰峦一括全。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵李子长赠别","author":"张诩","text":"一入朱明古洞天，不将白发计流年。\n歌残溟海千波月，坐破罗浮万岫烟。\n老矣图书飞鸟外，依然风月钓台前。\n明年记取班荆处，春雨桃花锦一川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄塘道中遇高三峰侍御话旧兼赠复命之行 其一","author":"张诩","text":"如此高才属妙龄，天教岭海救生灵。\n先声久矣摇山岳，藻鉴空然别渭泾。\n若水清风留郡志，李膺真节著朝廷。\n匆匆不尽平生意，一去孤舟杳八溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄塘道中遇高三峰侍御话旧兼赠复命之行 其二","author":"张诩","text":"胶漆斯文此地逢，苍崖之后又三峰。\n百年洒泪河梁别，一旦知心管鲍同。\n淅淅秋风双短鬓，悠悠江水一孤蓬。\n微茫后会知何日，尺牍频须托便鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日至家登宴乐亭","author":"张诩","text":"五月辞家九日还，亭台高步一开颜。\n黄金绕宅秋风里，碧玉闻箫夜月间。\n心事百年聊尔尔，江山千古只班班。\n鉴湖不向君王乞，一榻罗浮旧有山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"豫章吊徐孺子","author":"张诩","text":"孺子高风著此亭，淡云衰草四边生。\n满轮不解先生意，絮酒聊将国士情。\n丞相荒碑秋雨下，少陵烟艇渡头横。\n徘徊顾景伤心处，缺月高飞丽太清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采石吊李太白","author":"张诩","text":"一江风雨浪纷披，鼓枻长过采石矶。\n千载斯人疑不死，一生豪气尚争辉。\n夜郎天阔冥鸿去，五老峰高白鹤飞。\n吟罢小诗天忽霁，醉呼明月满船归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽罗内翰一峰先生二首 其一","author":"张诩","text":"一峰飞去万山秋，宇宙无根总是浮。\n何处有人来白马，吾生遗恨失金牛。\n沙鸥泛泛江天阔，湘水茫茫日夜流。\n独倚西风频北望，断烟衰草不胜愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽罗内翰一峰先生二首 其二","author":"张诩","text":"十年仰止清风洞，一夜悲君广趣亭。\n涕泪纵横如雨注，笑谈那复听风生。\n洛下有人忧汉室，江潭何事著骚经。\n夜阑独坐观乾象，东壁今来少一星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭庄定山先生","author":"张诩","text":"蚤岁东南我慕公，天缘一旦幸登龙。\n朱弦白雪茅檐奏，瀛水神山曲径通。\n满腹经纶眠坐处，遍身风月有无中。\n天涯咫尺知何许，多少铭诗宿草封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]