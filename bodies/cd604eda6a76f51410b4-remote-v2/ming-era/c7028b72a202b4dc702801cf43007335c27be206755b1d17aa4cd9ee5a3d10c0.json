df1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"钟巨川赴任为题看月图","author":"张宁","text":"小山孤月净流辉，石磴高寒酒力微。\n清赏正浓赋未稳，夜深松露湿秋衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7942,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杂咏 其一","author":"张宁","text":"老木槎牙浅淡春，阴苔满地净浮尘。\n东花吹断烟花梦，笑傲山林有几人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7943,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杂咏 其二","author":"张宁","text":"蕉扇停挥白苧凉，摇琴未鼓竟先忘。\n绿杨风静山如画，人在清都白玉堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7944,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"美人图 其一","author":"张宁","text":"银烛荧荧夜五更，蔷薇露重小寒生。\n玉纤未度冰弦断，斜抱箜篌坐到明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7945,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"美人图 其二","author":"张宁","text":"十二阑干曲曲行，一般调笑各含情。\n不知今夜楼头月，却傍谁家分外明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7946,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画鹰为张佥宪 其一","author":"张宁","text":"万里烟霄振羽仪，下来芳树立多时。\n秋深狐兔无行迹，侧目崖阴有所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7947,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画鹰为张佥宪 其二","author":"张宁","text":"天汉清明草泽荒，半将轩举半潜藏。\n麟凰亦是飞行物，莫见翎毛槩击扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7948,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和韩成章怀归四首 其一","author":"张宁","text":"庭前甘菊正芬芳，晚色催人上鬓黄。\n莫怪寻常开口笑，清安不似浣花妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7949,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和韩成章怀归四首 其二","author":"张宁","text":"云深茅屋几层关，露筱烟芜水石间。\n看惯游鱼浑不避，忘机远过白鸥閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7950,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和韩成章怀归四首 其三","author":"张宁","text":"竹边流水日潺湲，竹外閒云伴鹤还。\n白鹤自飞云自散，夕阳人在水声间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7951,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和韩成章怀归四首 其四","author":"张宁","text":"漠漠晴川淡淡风，松舟桂楫路相通。\n莲歌未断渔歌起，妆点风光似越中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7952,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"閒居漫兴二首 其一","author":"张宁","text":"瀼西茆屋曲江滨，几度东风乱后春。\n黄四娘家楼上景，故应花恼白头人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7953,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"閒居漫兴二首 其二","author":"张宁","text":"此中深意许谁知，三径秋香正满篱。\n总是白衣无酒至，忘言长似醉来时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7954,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画二首 其一","author":"张宁","text":"云满孤山雨满楼，青春花鸟澹相留。\n年芳似旧故人少，默倚阑干悔昔游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7955,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画二首 其二","author":"张宁","text":"雨晴芳渚野凫飞，杨柳条长荇叶齐。\n閒展篷窗看溪水，春痕渐上钓鱼矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7956,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"碧葵","author":"张宁","text":"芭蕉分绿蕙分香，不及春红一半妆。\n任是榴花妒颜色，平生心事只倾阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7957,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题戴静庵画三首 其一","author":"张宁","text":"金鳌玉龙蟠作堆，老树屈铁泉鸣雷。\n舟轻水急云荡漾，彷佛使槎天上来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7958,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题戴静庵画三首 其二","author":"张宁","text":"萧萧葭菼著霜稀，秋水连天有雁飞。\n怅望溪山旧人去，一船斜日映愁归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7959,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题戴静庵画三首 其三","author":"张宁","text":"汎汎轻舟泊钓矶，芦花吹雪梦将飞。\n莫教一枕黄昏雨，直待邯郸觉后归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7960,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋江八景 其一 芦苇亭","author":"张宁","text":"飘摇蓬搆拙于鸠，露叶霜花四壁秋。\n满榻寒声江影动，却疑身地是虚舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7961,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋江八景 其二 蘋花馆","author":"张宁","text":"宿水停烟绿近墙，绕门葭菼共苍苍。\n寒香欲荐无人采，月落空庭夜有霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7962,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋江八景 其三 眠鸥渚","author":"张宁","text":"风定莎晴寂不惊，水云流影日斜明。\n忘机正爱幽栖熟，莫放渔舟近岸行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7963,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋江八景 其四 落雁汀","author":"张宁","text":"云衢千里路漫漫，水碧沙明夜满滩。\n何事黄昏尚凝睇，伴人孤影隔江寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7964,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋江八景 其五 红叶寺","author":"张宁","text":"澄江练净晃岩扉，霜树萧疏野鸽飞。\n满地飘风人迹少，夕阳门掩一僧归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7965,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋江八景 其六 白云乡","author":"张宁","text":"浦溆苍茫水不流，回风断处见兰舟。\n壮怀岑寂哀情动，忽忆汾河九月秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7966,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋江八景 其七 芙蓉湾","author":"张宁","text":"曲水回塘不碍舟，涉江无便寄清秋。\n故园桃李今摇落，欲驻寒芳待远游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7967,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋江八景 其八 菱叶荡","author":"张宁","text":"疏疏弱荇引春波，簇露牵风日渐多。\n消尽缘云秋水阔，夜船犹唱采菱歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7968,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄友","author":"张宁","text":"白石沧波路渺漫，潇潇风露晚生寒。\n双峰旧隐知无恙，一纸平安欲寄难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7969,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"玄真院题画二首 其一","author":"张宁","text":"金阙琼楼虎豹关，蓬莱方丈五云间。\n登高一望秋无际，徐福楼船几日还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7970,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]