[{"title":"题唐元徵乃兄渔唱晚晴册 其四","author":"袁宗道","text":"鱼艇宿檐前，酒旗飘屋后。\n沽酒复买鱼，对花倾几斗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45889,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"见白须","author":"袁宗道","text":"海深难比爱河深，五欲腾波天也沈。\n休把霜毛轻镊去，一回对镜一休心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45890,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"死心和尚一朝弃诸生披剃，书此赠 其一","author":"袁宗道","text":"欲识新长老，便是袁中夫。\n依然旧面孔，只少几茎须。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"死心和尚一朝弃诸生披剃，书此赠 其二","author":"袁宗道","text":"染蓝为坏色，裁巾作僧帽。\n我狂正未醒，汝魔初然觉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"死心和尚一朝弃诸生披剃，书此赠 其三","author":"袁宗道","text":"豪性与颠毛，一斩一齐落。\n独有爱山心，不受铜刀削。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"死心和尚一朝弃诸生披剃，书此赠 其四","author":"袁宗道","text":"袖中五色豪，落纸文光烨。\n梦里莫还人，且留注贝叶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"死心和尚一朝弃诸生披剃，书此赠 其五","author":"袁宗道","text":"选佛场大开，这回应得俊。\n宝华最高处，历历题姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"死心和尚一朝弃诸生披剃，书此赠 其六","author":"袁宗道","text":"神清骨亦癯，雅称手中锡。\n一笑入千山，藏身没踪迹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题双寺画竹","author":"袁宗道","text":"风竿不满尺，已饶千丈势。\n高僧礼诵馀，味此萧萧趣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观灯家燕","author":"张国维","text":"佳丽皇都令节灯，堂怡寿母灿层层。\n繁同列宿群环极，朗若明珠尽照乘。\n角抵戏程罗广乐，烟花光放映觚棱。\n不须朱幰临南陌，连夜庭除乐事兴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太夫人板舆初反庭前有牡丹一株连夜齐放艳丽异常若相视而笑以助欢菽水者太夫人为之色喜余奉觞上寿敬赋一律","author":"张国维","text":"瑞钟萱树冠人间，应遣花王佐笑颜。\n朵袅孙枝成玖玉，色方舞彩总斓斑。\n微风引馥调晨膳，轻雨凝珠列晓鬟。\n燕喜仍烦君记取，年年堆锦祝南山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"免归思母八首 其一","author":"张国维","text":"游子言归戴主恩，庭萱遥想露华繁。\n八旬将届称觞日，十载初招陟屺魂。\n屈指承颜思缩地，先朝寄鲤祝加飧。\n慈闱忆我还殊甚，飞梦时时见倚门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"免归思母八首 其二","author":"张国维","text":"欲献高堂一物希，空囊惟办老莱衣。\n思鲈归隐严陶鲊，解组还初惕孟机。\n养是恒言今始逮，耕为子职永相依。\n悬知饥渴关亲甚，念易鸡豚待聿归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"免归思母八首 其三","author":"张国维","text":"昔年扶侍恋居诸，岭海燕吴色笑舒。\n游纪东征曾作赋，情牵北望久悬舆。\n颇嫌孝养资征檄，不信瞻依忍绝裾。\n母子余生将互倚，终焉岂独爱吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"免归思母八首 其四","author":"张国维","text":"不因予假蹈栖迟，特诏迎亲天宠滋。\n自古貤恩膺紫诰，几曾召养贲纶丝。\n仆夫未驾光先被，子姓分荣乘永垂。\n介寿承欢歌帝德，能令菽水胜琼饴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"免归思母八首 其五","author":"张国维","text":"力竭胼胝复治戎，呼亲无计托征鸿。\n我生分向离愁尽，子舍翻疑隔世通。\n灯下低徊开喜烬，堂前洒扫绕熏风。\n鬓霜揽镜还成惧，恐动哀怜减泄融。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"免归思母八首 其六","author":"张国维","text":"教忠母训似严君，夷险谆谆励立勋。\n敢效闲居夸晏乐，差将无死答恩勤。\n闻归款信思难定，溯别悲欣转莫分。\n一夕凝思浑若岁，频年何以度忧熏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"免归思母八首 其七","author":"张国维","text":"昨秋朝暮望归人，今日南鸿傍逐臣。\n愤切时艰遑偃仰，情于天听释邅迍。\n凊温迟暮犹无子，生死维持赖有亲。\n何事依云空伫立，双眸已入画溪春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"免归思母八首 其八","author":"张国维","text":"三褫端因教孝宽，一□冀以报刘欢。\n北山于役仍堪隐，斓彩兼冠不用弹。\n仰托春晖华尚白，俯全方寸质犹丹。\n君亲大德咸无极，向日循陔意不阑。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"在狱思母八首依前韵 其一","author":"张国维","text":"露雷迭用总衔恩，负国违亲罪实繁。\n徒羡深林乌鸟意，堪怜三宿子规魂。\n权词告出啼为笑，对食兴悲泪和飧。\n梅信须传归指日，依言孑影在圜门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"在狱思母八首依前韵 其二","author":"张国维","text":"踰八高龄古更希，赭衣泪渍似斑衣。\n臂呼心动悲离膝，目极情疑恐下机。\n重巽钿容亲是觐，阳光定照命相依。\n寄声色养糟糠妇，莫向尊亲怅不归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"在狱思母八首依前韵 其三","author":"张国维","text":"时当严冱入囚诸，职旷冬温惨不舒。\n雷电合章刑有属，棘薪匪令德无舆。\n五更柝击孤臣梦，两岘霜寒寿母裾。\n安得微躯生羽翮，有怀三徙是吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"在狱思母八首依前韵 其四","author":"张国维","text":"帝城春动日迟迟，暗室沈阴别泗滋。\n望眼各天昏似雾，白头两地乱如丝。\n兵归独子刑还异，孝感遗羹事有垂。\n惟愿慈颜怡献岁，备尝荼苦悉如饴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"在狱思母八首依前韵 其五","author":"张国维","text":"省愆切诫易谈戎，怨慕嗷嗷北塞鸿。\n括母思深叨弗坐，徐生心乱系难通。\n瞻云依梓暌南服，寄帛传音阻北风。\n孝治首关明主意，宁令一物外春融。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"在狱思母八首依前韵 其六","author":"张国维","text":"家陲每勖报明君，宁数波臣尺寸勋。\n自取触藩隳顾复，空烦和胆助辛勤。\n写忧携杖谁为御，抱郁增奇孰与分。\n怅望无聊成假寐，魂归失路倍忧熏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"在狱思母八首依前韵 其七","author":"张国维","text":"相看各念北堂人，对泣非关为累臣。\n触绪如抽还哽咽，含情难语益邅迍。\n局身废莨皆人子，上寿尸饔独我亲。\n自顾区区诚莫赎，窃将垂白乞余春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"在狱思母八首依前韵 其八","author":"张国维","text":"义当灰骨答君宽，身愧完名拂母欢。\n初度先成垂老别，南音岂作等闲弹。\n恋闱恍惚寻残梦，继血潺湲出寸丹。\n但得生还重聚首，风光不为暂离阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"释用思母八首再依前韵 其一","author":"张国维","text":"枯株忽荷再生恩，拊畜身存积思繁。\n近恋枫宸摅荩悃，遥依萱树释惊魂。\n樊笼乍脱期还哺，禄养重欢戒素飧。\n三月乡愁烽火遍，万金归信到衡门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"释用思母八首再依前韵 其二","author":"张国维","text":"寻常昼锦舞斑希，返及春华好试衣。\n寿母晨昏仍慰望，塞翁得失尽忘机。\n小人久缺三牲养，君子今歌四牡依。\n节制喜连桑梓地，不因远志弃常归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"释用思母八首再依前韵 其三","author":"张国维","text":"马老知途未舍诸，鸡初离镬翰音舒。\n还乡遍喻相如檄，隆养高旋季子舆。\n驿路花明迎采韨，庭闱风暖动长裾。\n驰驱便道申归省，政效怀安恋敝庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"释用思母八首再依前韵 其四","author":"张国维","text":"每闻噬指怅音迟，秣马晨征浥露滋。\n企望高堂华若锦，宠衔王命贲如丝。\n帘前爱日鞲时卷，袖里清风橐自垂。\n无限天伦离合意，开颜加膳更含饴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"释用思母八首再依前韵 其五","author":"张国维","text":"任兼吴越重元戎，力报劬劳视骏鸿。\n行者心因居者喜，大儿童企小儿通。\n归帆己映沧江月，亲梦犹萦朔北风。\n浩荡天波惊望外，人言贤母福昭融。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"释用思母八首再依前韵 其六","author":"张国维","text":"不须来谂动仁君，睿鉴原情念细勋。\n万死是甘威倏霁，半生乖养慕空勤。\n入春己作两年别，坻里才为八月分。\n所奉云軿莅吴会，昔游风景霭如熏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"释用思母八首再依前韵 其七","author":"张国维","text":"昨年觐省致归人，何似今朝蹇蹇臣。\n子舍将旋神竦跃，简书难胜意邅迍。\n莅官夙夜虞亏孝，积虑渊冰凛辱亲。\n乘暇称觞沾赐沥，婆娑颜渥数杯春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"释用思母八首再依前韵 其八","author":"张国维","text":"风尘北望思难宽，靡盬宁耽啜饮欢。\n慈诲原为修业励，南熏堪作解忧弹。\n奉公协望胜馨膳，怡志蠲奇过内丹。\n寿□宏开逢道泰，百年佳气绕门阑。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉母八首仍依前韵 其一","author":"张国维","text":"慈帏荣被九天恩，炳焕泥封晋宠繁。\n黄耇迎和谁奉膝，白云伫望几飞魂。\n欲周钟阜宣行乐，拟褉秦淮助进飧。\n遣迓频驰佳信至，轻轩就道掩蓬门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉母八首仍依前韵 其二","author":"张国维","text":"龙章鹤发妇仪希，士女纷看一品衣。\n隽母欢颜时问政，敬姜懿训每鸣机。\n林移珍果家园似，阶列名花几席依。\n更托丹青供赏玩，体安意适浑忘归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉母八首仍依前韵 其三","author":"张国维","text":"洞房璇室似方诸，冬日凝温寝食舒。\n褥拥华茸欣对雪，杖携灵寿代登舆。\n老人南极明天汉，王母西池绚佩裾。\n退食优游承色笑，娱亲何敢厌周庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉母八首仍依前韵 其四","author":"张国维","text":"颐养高年旦起迟，庭前春色动华滋。\n筵张南第迎梅萼，曝倚东轩拂柳丝。\n干禄幸来青紫侍，扬名惭乏事功垂。\n诸孙罗列将朋酒，共祝长生拟玉饴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉母八首仍依前韵 其五","author":"张国维","text":"陈情暂许释临戎，扶侍登舟逐渚鸿。\n耋齿虞驰车马悴，故山喜报涨流通。\n江鱼跃入资供馔，角枕凉生藉御风。\n缅想东征犹昨日，出当秋晏返春融。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉母八首仍依前韵 其六","author":"张国维","text":"母子承恩矢报君，鹓班空点愧无勋。\n恤私独获叨休沐，侍养时闻教慎勤。\n白粲尝芬携倍足，春醪御旨彻还分。\n潘舆自览王畿出，遍识江南草木熏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉母八首仍依前韵 其七","author":"张国维","text":"舟度金阊拥万人，共扬有母勖为臣。\n导舆幕府欢堪忆，回首并州恋似迍。\n每悯尘容仍顾我，相看素发忍违亲。\n越山一路皆娱目，偕隐情偏指富春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉母八首仍依前韵 其八","author":"张国维","text":"荏冉还家子念宽，闲居万事总承欢。\n欲撝曦驭池重浴，肯任春光指一弹。\n园蓛供甘林笋紫，庭花迎笑海榴丹。\n朝朝问寝华堂启，宝鸭祥烟出画阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"召对钦赏虔纪二律 其一","author":"张国维","text":"帝念可渠惟慎庸，谫才承乏赴追锋。\n六年鞅掌重瞻衮，千载休光叨攺容。\n敷奏兼垂明试意，都俞莫罄对扬悰。\n从今捐糜寻常事，蹇蹇犹虞歉靖共。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"召对钦赏虔纪二律 其二","author":"张国维","text":"亲奉尧天春色饶，复闻中使下丹霄。\n赐金雪灿梁州品，衣绣云裁织女绡。\n什袭氛仍生剑佩，启行彩应绕星轺。\n涓埃未报恩徒恋，回首宸居接□杓。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出都喜雨二首 其一","author":"张国维","text":"乍辞阊阖捧天书，澍满郊圻柳拂渠。\n灵雨总关明主德，恩膏先到使臣车。\n玉糈艘驶桃花水，绿野讴闲柘影锄。\n咨命亲承何以报，愿敷圣泽遍青徐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出都喜雨二首 其二","author":"张国维","text":"疏瀹惭无宛委书，九天雨露润河渠。\n槎从泛汉分来锦，橇假行堤化去车。\n燕岭稠云迷塞雁，卢沟新涨漾春锄。\n安澜定制支祈锁，问岁今逢在执徐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟次见新漕衔尾而北錻以志喜","author":"张国维","text":"鹢迅飙为楫，鳌连嵓□波。\n千仓求峙少，万斛泛舟多。\n摇影逢津树，腾欢杂榜歌。\n回思焦土日，劳者涕成河。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"道傍榆柳树皮饥民取食殆尽感而赋之 其一","author":"张国维","text":"萧条四野叹遗黎，树屑和糠强救饥。\n一望垂枯榆柳色，谁言苌楚得无知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"道傍榆柳树皮饥民取食殆尽感而赋之 其二","author":"张国维","text":"皮尽心伤生趣穷，疏条犹自舞长风。\n恰如残喘支征缮，未敢嗷嗷告杼空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有取苜蓿草而食者感赋","author":"张国维","text":"甑无半菽突无烟，苜草何堪佐果然。\n谁是开仓追没黯，空教遗种诵张骞。\n祗因救死宁茹苦，只恐含悲讵下咽。\n食寄荒原栖在路，行人那不泪潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七里滩","author":"张国维","text":"神工手擘尚留痕，中导江流势欲吞。\n蜿蜒山腰人数点，缤纷露脚瀑干喷。\n石潭鱼戏鬐堪鉴，木末莺潜调自翻。\n处处桃花浮涧出，不知谁是避秦源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望钓台 其一","author":"张国维","text":"羊裘异迹焕丹青，卧榻嘉谋史未聆。\n累日坐论非道故，当年同学鄙穷经。\n君除谏议彰金砺，臣退躬耕庆荚蓂。\n严濑磻溪均致主，客星直傍紫微星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望钓台 其二","author":"张国维","text":"十过矶边九到尖，今朝风雨阻登瞻。\n深烟端为移文布，小草多乖遁卦占。\n清洛初潜成白水，秣陵再卜巨刘天。\n时康碌碌应投劾，漫托金门吏隐廉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"示仲郎初冠","author":"张国维","text":"今辰今醮汝，弱植正须培。\n式玉成人始，盍簪长者来。\n缃囊千古业，雪案九重媒。\n珍重康成训，深思应迈回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重游白云洞四首 其一","author":"张国维","text":"不见幽嵓十五年，昔游猿鸟尚依然。\n流泉诉别鸣还咽，盘石标贞亢且坚。\n池上醒眠青眼放，松间醉倚白头妍。\n晚寻归路层云锁，便与山灵订隐缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重游白云洞四首 其二 珠璧","author":"张国维","text":"云表圆流如意匀，琢瑶散雪总非伦。\n恰将灼灼重渊色，来照岩岩万仞身。\n日丽悬泉幽壑媚，月明飞溜夜光新。\n溅衣旋索浑无物，更识元探象罔真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重游白云洞四首 其三 石乳","author":"张国维","text":"谁测元奇一罅中，不烦更斧碧流通。\n石藏水脤坤为母，池仰膏施坎是童。\n玉齿生甘还惜嫩，花瓷盛白更疑空。\n蒙泉翻却睢昙义，酥酪醍醐逊化工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重游白云洞四首 其四 玉女盆","author":"张国维","text":"石畔何年盥雪肤，长留明莹鉴眉须。\n词人兴会毫从浣，酒客狂来首任濡。\n却向巫阳云杳渺，转嗤汉女佩虚无。\n幽看萝薜深成幄，恍惚山阿降彼姝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再至","author":"张国维","text":"独余清梦绕长松，醒着青鞋逐梦踪。\n爽气来迎四五里，野桥经渡两三重。\n犬驯舍外欣曾识，鸟啭樽前说昨逢。\n路熟不愁归路晚，莫令回首日高舂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卜筑三首 其一","author":"张国维","text":"冒雨蹑岧峣，寻幽兴独饶。\n松为楹更韵，窗迩洞如招。\n结宇先三径，依流便一瓢。\n足资周览乐，首为板舆翘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卜筑三首 其二","author":"张国维","text":"邱中结构偏宜小，物外探搜只支真。\n谷口堪施诛草力，林塘疑傍浣花滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卜筑三首 其三","author":"张国维","text":"故邱开别业，不费买山钱。\n好用沽?醁，衔杯识避贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"经始","author":"张国维","text":"茅屋依岩巧在因，子楹初立势凌旻。\n栋云池月无生有，曲水残山假却真。\n仲蔚蓬蒿开径日，陶潜樽酒眄柯辰。\n风光诗句宜相酢，□判山祗迭主宾。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"频至","author":"张国维","text":"一枝甫定数翱翔，倦羽惟堪适莽苍。\n地窄近移奇石补，岩濡横凿小池当。\n轩迎山月杯中影，手弄闲云袖里装。\n凝睇幽厓惊已夕，仰看岭色尚斜阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]