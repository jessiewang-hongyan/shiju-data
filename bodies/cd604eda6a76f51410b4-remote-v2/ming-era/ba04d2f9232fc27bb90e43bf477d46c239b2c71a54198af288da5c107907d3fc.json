747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹赠士振南归","author":"杨士奇","text":"清风林下归客，明月池头故家。\n杏树百年乔木，芸编累世生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3229,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"绝句 其一","author":"杨士奇","text":"客程行及半月，春色看分浅深。\n杨柳乍舒河北，桃花开遍淮阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3230,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"绝句 其二","author":"杨士奇","text":"淮上天连芳草，江南云涌清峰。\n瓜步春潮落日，广陵烟树残钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3231,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日陈士良宅玩菊次韵王洁斋菊有醉杨妃紫霞杯二种 其一","author":"杨士奇","text":"五日金门下直归，小园来看菊花枝。\n千葩万卉须臾尽，独此相娱岁晚时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3232,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日陈士良宅玩菊次韵王洁斋菊有醉杨妃紫霞杯二种 其二","author":"杨士奇","text":"腻白轻红数十枝，半酣秋色倚东篱。\n谁知彭泽归来处，更似昭阳宴罢时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3233,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日陈士良宅玩菊次韵王洁斋菊有醉杨妃紫霞杯二种 其三","author":"杨士奇","text":"红白丛丛相映开，一丛别捧紫霞杯。\n满含玉露香胜酒，九日无烦太守来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3234,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴孟勤为文赠黄都科南归并为求诗 其一","author":"杨士奇","text":"杨氏昔来光德里，黄端今去武昌城。\n柳州邂逅禾川遇，并有文章托姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3235,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴孟勤为文赠黄都科南归并为求诗 其二","author":"杨士奇","text":"暂去还来不记年，清朝又发庾楼前。\n莫教折尽临江柳，留得重来好系船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3236,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题仲举梅花扇面","author":"杨士奇","text":"才子清姿如玉雪，新裁小扇写寒梅。\n日长宴坐微风发，为引幽香相逐来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3237,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"访蒋立恭不遇留书斋壁","author":"杨士奇","text":"门巷晴泥拥不开，寻君北转又东回。\n竹间寂寞香庭掩，便似回船雪夜来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3238,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨夜蒋立恭赠诗走笔次韵 其一","author":"杨士奇","text":"钭风飘雨还无定，独坐耽书过二更。\n不似前宵邻阁里，联诗使酒到鸡鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3239,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨夜蒋立恭赠诗走笔次韵 其二","author":"杨士奇","text":"三径筼筜二亩居，鸣风鸣雨称清虚。\n秋宵一曲琳琅韵，为喜朝来向客书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3240,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]