[{"title":"游叶乐山山庄 其一","author":"谭大初","text":"谁卜幽居水竹间，衡门无事昼常关。\n寻芳不逐春风舞，采药长随夜月还。\n精舍阴阴修竹里，佳城郁郁小溪湾。\n多君领得林泉趣，名利无心梦亦閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8807,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游叶乐山山庄 其二","author":"谭大初","text":"懒从紫陌逐尘红，却爱山庄一水通。\n药圃三春肥谷雨，杏林六月饱松风。\n竹阴深处诗怀逸，酒兴浓时俗虑空。\n自古鹿门真大隐，年来谁解觅遗踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8808,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对菊","author":"王弘诲","text":"粲粲金英美可餐，九秋风露与清寒。\n多情似与诗人约，一夜丛开满药栏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8809,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中流自在图歌为谭次川年兄题","author":"郑廷鹄","text":"秋水瀰烟谷，川光入画图。\n远山横黛色，林树正扶苏。\n是谁槃礴丹青手，驱云掣电龙蛇走。\n青冥浩荡不可穷，万顷玻璃当户牖。\n绝壁崩崖雨后新，惊涛日日伴游人。\n人间草舍依村树，水上云深隔比邻。\n江头牙樯如榔密，奔波愈下无回日。\n谁知中有扣舷者，缓楫安流心自逸。\n慷慨中流发浩歌，天地万物如渠何。\n冯夷击鼓鼍为导，灵胥水面空婆娑。\n君不见湘山大风不得渡，刑徒三千亦何怒。\n又不见滟滪堆前争喧豗，矢尽剑折夫何为。\n乃知画师有深意，颓波涨里藏其智。\n一棹孤舟尺素中，洗尽人间名与利。\n名与利，如轻蘋，风波逐逐徒伤神。\n所以高明仗忠信，济川有术通玄津。\n速不足喜，迟何足嗔。\n彼岸登时同是到，稳作中流自在人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8810,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿承恩寺","author":"郑廷鹄","text":"何处梁王寺，丰碑勒帝章。\n烟花浮翠幄，月影上华堂。\n物外何须竞，尘中祇自忙。\n老僧参不透，犹尔念金刚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8811,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日偕周一阳携酒过福寺访黄暾江春元二首选一","author":"郑廷鹄","text":"载酒寻芳境，闻钟入梵筵。\n松门禅影落，花境铎声传。\n席上悬空偈，窗中漫草玄。\n果非贪佛性，还为惜华年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8812,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种宜男","author":"郑廷鹄","text":"我爱宜男草，纫香久自珍。\n树之南海曲，恋此北堂春。\n白璧初含雨，青裳迥出尘。\n托根良不浅，长对合欢人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8813,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苍屹山","author":"郑廷鹄","text":"玉龙出盘谷，翘首对新城。\n水带环桥绿，风铃触石鸣。\n回翔本无意，屈曲尚多情。\n鸟迹留仙谶，谁人识姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8814,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仙人峒","author":"郑廷鹄","text":"仙人乘鹤去，空峒独岿然。\n法草山山绿，题痕日日鲜。\n两岩门未掩，七里事何玄。\n欲问希夷子，枫林隔紫烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8815,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"微雨","author":"郑廷鹄","text":"云度青山雨，霏霏送弱丝。\n逐风轻柳絮，舞槛湿花枝。\n海燕春巢早，城乌夜宿迟。\n客愁不自整，相对草离离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8816,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与白省吾游宴姚蛟峰大尹园林","author":"郑廷鹄","text":"名园通远郭，三径有遗踪。\n醉日花容媚，随风竹影重。\n清歌回独鸟，香袖趁馀蜂。\n舞罢酣春阁，悠然对喜峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8817,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"散步","author":"郑廷鹄","text":"散步长安邸，萧然景物殊。\n海云千里白，燕月一身孤。\n尺素迷秋雁，南枝引夜乌。\n乡园何处是，终日费支吾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8818,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"司空直宿","author":"郑廷鹄","text":"直宿尚书省，潇潇带月过。\n冬官寒更早，水部夜如何。\n柝向风声近，帘开烛影多。\n少陵官不薄，醉后且长歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8819,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"栽莲","author":"郑廷鹄","text":"濯藕换新池，深根永不移。\n赤心清可鉴，绿叶宛相宜。\n细雨新蘋动，微风弱蔓知。\n朱华常在念，擎盖是何时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8820,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠家兴金济朝还家","author":"郑廷鹄","text":"云落青山暮，溪声送夕扉。\n月光回客梦，柳色映征衣。\n酒醉何时别，诗成作赆归。\n漫歌留彩鹢，明日未应飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8821,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬辰下第寄所知姚思孟","author":"郑廷鹄","text":"汉柳秦沟潞水春，长安依旧小郎新。\n风云漫属僧繇壁，蹊径空回季路津。\n陌上标旂斜度雨，里中车马暗生尘。\n羁怀未问刘蕡事，且向中原寄此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8822,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬辰自慰呈李年兄双翠","author":"郑廷鹄","text":"春晴昨日赴花期，妒雨狂风负所私。\n白塔祠前云影敛，黄金台上鸟声悲。\n客愁不散西山雪，乡梦虚钻北海龟。\n壮志凭君坚似石，十年献赋未应迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8823,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒景贤祠","author":"郑廷鹄","text":"石楔萦回落木阴，朝朝云拥旧祠林。\n金莲朱橘千年事，绮阁丹楹万古心。\n载酒谁知春梦杳，登堂徒见野花深。\n眉山琼海今还在，烟外秋风鸟自吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8824,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"妙高台","author":"郑廷鹄","text":"岩树崚嶒起石台，临流飞槛向人开。\n青萝垂蔓云间出，彩鹢抟风江上回。\n醉后黄昏瞻斗色，梦回清夜识珠胎。\n呼僧细问东坡事，漫道浮生有去来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8825,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吕仙祠","author":"郑廷鹄","text":"邯郸道上吕公堂，古木萧萧秋气凉。\n葛檗有人歌白纻，丛台无事说黄粱。\n物情祇作游谈柄，世路空悲傀儡场。\n清昼梦中惭未醒，凤楼鸡店正茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8826,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朝天岩","author":"郑廷鹄","text":"携酒中峰不厌高，腾空直与白云翱。\n诸天脚下皆萝薜，四海眶中一羽毛。\n谷静岩虚心转寂，鸟啼人醉兴偏豪。\n蓬莱可到今能到，鼍鼓西风起六鳌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8827,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三海岩","author":"郑廷鹄","text":"层岩细雨岚光散，空洞微风草木幽。\n沧海浪痕生紫藓，青山蜃气结朱楼。\n千年陵谷何多改，此日登临且共酬。\n黄鹤不知芳树晚，双双犹傍旧矶头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8828,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶过临高澹庵堂李石城大尹枉顾即行途中口占为谢","author":"郑廷鹄","text":"看山不厌到临溪，忽枉仙凫为指迷。\n千里桑麻方复业，百年桃李已成蹊。\n胡公祠下莺声啭，陆令堂前柳色齐。\n行客匆匆未能纪，林花处处自为题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8829,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石经洞","author":"郑廷鹄","text":"千年石洞空苔藓，不见当时洞里人。\n百尺岩花摇碧落，几条烟柳绝红尘。\n已知世上还醒少，莫怪山中打睡频。\n细检断碑愁注目，贞元徒识守藩臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8830,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送钟玉川廉州分教","author":"郑廷鹄","text":"四月河台草树閒，遥遥青鹳向廉山。\n钟兴万里新承命，何逊当时已抗颜。\n帐影瞻回明月浦，铎声飞度绿溪湾。\n唐人石室今何在，桃李盈盈满目斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8831,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和蔡都宪征黎韵","author":"郑廷鹄","text":"秋风高节驻边城，开府躬临百万兵。\n隔水楼船云外出，弥天草树雨中生。\n伏波万里螭碑在，横海千年羽檄清。\n五指从今霄汉里，岩花历历共知名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8832,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送郡象峰崖守赴调北上","author":"郑廷鹄","text":"白日黄涛海上州，隼旂飞动宿烟收。\n岚开锦缆湖声晓，路入青山草色秋。\n南浦双龙瞻斗极，西风孤鹤梦神州。\n邯郸往事何须问，且醉长安谩倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8833,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凫山候潮","author":"郑廷鹄","text":"落日孤峰短角催，西风江上暮云开。\n三秋月色千寻浪，半夜潮声万壑雷。\n彩鹢忽惊琼岛梦，金鳌遥送雪山杯。\n鸡鸣津吏初相候，细向船头问去来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8834,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西庄六景选二 其一 红杏芳林","author":"郑廷鹄","text":"满树红霞点绛衣，山门处处袭馀晖。\n董仙堂下烟初散，司马祠前雨正霏。\n啼鸟远从旗市转，疏钟偏逐药船归。\n北邻喜见南枝早，共引牙盘酌翠微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8835,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西庄六景选二 其二 篁溪晓渡","author":"郑廷鹄","text":"露下危樯曙色开，吴歌遥傍橹声来。\n疏钟淡月孤舟晓，远水幽篁独鸟催。\n人语渡头喧羽楫，龙吟风外助霞杯。\n济川未问商岩事，且趁风清过曲隈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8836,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七星寒秀","author":"郑廷鹄","text":"天外芙蓉晓嶂开，七峰苍翠拥仙台。\n紫垣珠斗空中落，白马瑶图海上来。\n云敛高秋回五岭，月明清夜近三台。\n心悬北极尧天迥，何羡东封薄汉才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8837,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡江","author":"郑廷鹄","text":"细雨江堤暝色黄，寺钟渔火雁声长。\n客心似水中流急，驿路如年尽日忙。\n隔岸风沙催短角，极天云树度危樯。\n丛林十里寒城夜，又上公安肃政堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8838,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"佛手崖小憩见一滴泉","author":"郑廷鹄","text":"幽洞涵虚郁紫清，碧岩如手覆仙蘅。\n空中香树浮珠阁，象外烟花拥玉屏。\n倦鸟未忘常梵语，寒泉那识下方情。\n西风古木岚光暮，何处人间有磬声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8839,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书堂讲罢示诸生讲义","author":"郑廷鹄","text":"紫阳坛上静焚香，石洞风来夏阁凉。\n出谷世情暄自暖，横经吾分说偏长。\n数年孔易竟何学，终日回言祇此堂。\n为语舜徒休孟浪，明明仁义是周行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8840,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十月望后过东林望庐山和韵","author":"郑廷鹄","text":"庐山相见已销愁，入眼青葱总旧游。\n草色尚留三峡雨，雁声犹送九江秋。\n连天霞树层层出，落涧寒泉滚滚流。\n遥问锦厓何处见，题痕应在白云头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8841,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李东泉明府得予圭墨以诗来谢因以联答和韵","author":"郑廷鹄","text":"金龙初试墨池新，冻雨浓云细可论。\n笔底风雷浑未散，尊前珠玉岂应贫。\n呼嵩道士增声价，濡鬓仙郎识急真。\n遥想赤虬蟠结地，悬知不负草玄人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8842,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三月六日云雨大作和蔡隐者韵","author":"郑廷鹄","text":"三月雷声撼太空，海云送雨入墙东。\n黄芽畦上惊鸡黍，白缕离边覆宛童。\n冒水诗邮如有意，冲泥门巷可能通。\n君公若为三农喜，何惜春心两颊红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8843,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九月客至齐云山登高用东泉韵二首 其一","author":"郑廷鹄","text":"客至披云揽石龙，乘风飞度最高峰。\n尊前日出甘同醉，眼下天空信可容。\n丛菊有缘还对面，文霓何意独摩胸。\n凭谁记取留题处，千古磨崖是笔踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8844,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九月客至齐云山登高用东泉韵二首 其二","author":"郑廷鹄","text":"十里招寻湖上行，湖光山色近人明。\n到来云谷花频插，莫厌龙池酒数倾。\n木杪寒猿窥旧窟，瓮头秋蕨露新茎。\n哨壶枉矢能娱客，潦倒谁知更解酲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8845,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"青灯独誓诗为黎门烈妇邢氏作","author":"郑廷鹄","text":"东坑茅舍薄斜阳，少妇含冤祇自伤。\n两虎在门空吼吼，孤灯终夕独煌煌。\n换油未了馀生积，别室谁怜掩泪汪。\n裂帛声中人已散，海桃何处问纲常。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8846,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"载酒堂","author":"郑廷鹄","text":"榔花烟里钓池前，逐客风流尚俨然。\n青海瓮云嗟往事，玉堂春梦慨当年。\n问奇卓有渊明句，漉酒独传真一篇。\n千载瞻依竟何处，绿阴祠下草芊芊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8847,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"报恩庄小憩林掌教陈别驾枉顾谢之","author":"郑廷鹄","text":"路转长林小径深，客车门外送来音。\n乘风野鹤云间落，对橘仙翁日下临。\n挂月未忘千乘事，采芝犹动缙云心。\n独惭社酒非琪品，空使山花笑盍簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8848,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五指山","author":"郑廷鹄","text":"五峰峻削拱炎州，探日批风迥未休。\n石磴共看黄鹤度，松门直与白云浮。\n长安北望空秦观，吴会东来越楚丘。\n捧日自当登绝顶，君平休道犯牵牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8849,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张南川春元省觐北还因上春官","author":"郑廷鹄","text":"春晴海上锦帆开，万丈龙涛转曲隈。\n日下鲸波飞绮縠，镜中仙屿出楼台。\n彩衣尚恋黄堂梦，兰省新招白凤才。\n献赋他年回首处，五峰云外是蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8850,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拨闷","author":"郑廷鹄","text":"不须半滴云安酒，一日一吟工部诗。\n才自沾唇动颜色，何妨破量尽酴醾。\n风来人醉楼堪倚，日落云横盏亦欹。\n大笑也应忘俗虑，夜来何以谢良医。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8851,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乘凉至夜分闻笛声","author":"郑廷鹄","text":"独坐方亭海月孤，东风楼上报更壶。\n香销人定凉初至，露下天高暑若无。\n何处落梅吹绿水，几回高枕就青奴。\n岭壖五月空惆怅，半夜鸡声起壮图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8852,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题问道桥碑阴","author":"郑廷鹄","text":"弥年荆棘丛，芟除始成路。\n若自识道心，请从此桥度。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8853,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"买盈村","author":"郑廷鹄","text":"洋洋一掬水，纡石自为堤。\n洞识盈虚理，高山是指迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8854,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游慈感寺戏答僧问姓名少作","author":"郑廷鹄","text":"来路不须长老问，小车休着野猿惊。\n好听法鼓毗卢阁，三月春雷卜姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8855,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"省中见鹤二首 其一","author":"郑廷鹄","text":"怪尔高飞出蔚林，云霄终日惜佳音。\n祇今廖落秋风里，谁识当年万里心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8856,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"省中见鹤二首 其二","author":"郑廷鹄","text":"月下翩翩舞且歌，省中尽日细婆娑。\n羽毛自信不相染，纵有风尘奈若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8857,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"栽柳园亭","author":"郑廷鹄","text":"三尺纤盈已自妍，垂丝风外系流年。\n祇愁修干亭亭日，听得莺声不忍眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8858,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凤凰子移自石中","author":"郑廷鹄","text":"榔叶椰枝结翠楹，每因岩石不知名。\n从今植向池亭上，好对春风作凤声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8859,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蔡隐君送苦瓜并诗和韵谢之","author":"郑廷鹄","text":"沈约耽诗太瘦生，青门又作苦瓜行。\n谁知谷口酸相似，反恨蜂饴不世情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8860,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白虎亭新成二首 其一","author":"郑廷鹄","text":"窈窕见深谷，山门郁穹窿。\n高台何崔嵬，翠壁增长松。\n攀萝一登眺，新享报成功。\n嗟余始行役，夙心寄雕龙。\n徘徊咏高调，千载闻清风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8861,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白虎亭新成二首 其二","author":"郑廷鹄","text":"绮构青云上，烟光动窗户。\n万籁生阴谷，孤禽隐深树。\n亭亭百尺喜，松声自朝暮。\n谁识元化理，究此无言趣。\n悠悠千古心，端居有良悟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8862,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白鹿洞","author":"郑廷鹄","text":"石洞蔼晴晖，高台碧翠微。\n松萝常向榻，花藓细沾衣。\n不厌谈经久，深惭访旧稀。\n长歌动林麓，山鸟傍人飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8863,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独对亭","author":"郑廷鹄","text":"彩亭遥积翠，清景向人开。\n奇石阶前出，飞泉树杪来。\n剧谈挹五老，高调咏孤台。\n独在山桥晚，春风到草莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8864,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钓台亭","author":"郑廷鹄","text":"浅涧漾清波，晨光侵绿萝。\n石鸣鱼自跃，山静鸟还过。\n不用投竿起，相寻乐趣多。\n临流吾亦羡，得意写高歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8865,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"六合亭","author":"郑廷鹄","text":"飞步回流顶，青窗彻上空。\n烟花亭榭外，海树酒卮中。\n徙倚群芳异，回环四望同。\n悠然心赏处，天路更何穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8866,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雁塔三元峰","author":"郑廷鹄","text":"孤峰浮水外，对面送青来。\n石色蒸霞出，湖光映日开。\n人当韦肇榜，名寄粤王台。\n危亭碑尚在，历历见群才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8867,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石山","author":"郑廷鹄","text":"马岭开屏嶂，崚嶒出万山。\n石田薄云际，丹灶在人寰。\n白玉飞仙去，金牛何日还。\n清风岩下树，空对鸟关关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8868,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东坡双泉","author":"郑廷鹄","text":"东坡留胜迹，故老识双泉。\n洞酌常如旧，渑淄各自妍。\n参公应是主，牧守正须贤。\n兴复何年事，长歌岂弟篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8869,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"惠通泉","author":"郑廷鹄","text":"谁料三山下，浮珠有惠泉。\n洗杯如作焭，卓锡自忘禅。\n地是神仙境，名因衲子传。\n追言昊天观，罢驿是何年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8870,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雁塔薰风","author":"郑廷鹄","text":"山萝高捲石桥濆，紫塔幢幢拂五云。\n雁影昔年还北渚，龙吟此日动南薰。\n歌钟清彻流风转，舞扇瞻回落日曛。\n衣锦题名思往事，杏花亭上正氤氲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8871,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海门秋月","author":"郑廷鹄","text":"秋屿潮生月正悬，天高海阔夜娟娟。\n龙沙万里蟾光动，珠浦三更蚌影圆。\n风捲浪花惊宿鹤，水鸣霜叶触啼鹃。\n真游那得乘槎梦，直泛银河学阆仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8872,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]