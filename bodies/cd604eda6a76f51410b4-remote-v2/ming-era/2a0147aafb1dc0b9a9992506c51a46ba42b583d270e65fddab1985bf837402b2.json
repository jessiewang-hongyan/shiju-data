[{"title":"送陈宗显致仕还乡 其三","author":"胡俨","text":"致仕归来白发明，麻姑酒熟日频倾。\n醉时童稚相随去，击壤康衢有颂声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题静山诗卷","author":"胡俨","text":"寥寥灵响远盘空，竹上流云竹下风。\n坐对炉熏无一事，青山几处夕阳红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26871,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过扬州","author":"胡俨","text":"旧说扬州天下闻，繁华如梦欲销魂。\n可怜杜牧多情思，曾向樽前问紫云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26872,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜过钟吾口号","author":"胡俨","text":"两岸虫声夜转多，他乡无奈月明何。\n碧天万里河流急，倚棹长吟一雁过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26873,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下邳","author":"胡俨","text":"日落长河野水昏，青山遥望下邳门。\n舟人谩说圯桥近，黄石于今庙尚存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26874,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上吕梁洪 其一","author":"胡俨","text":"乱石穿空迭浪惊，乌犍百丈上洪轻。\n扁舟载雨西风急，试问徐州一日程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26875,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上吕梁洪 其二","author":"胡俨","text":"细雨斜风拂画船，船头怪石起苍烟。\n仰看白浪排空下，始信河流远自天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26876,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐州十二咏 其一 百步洪","author":"胡俨","text":"九里山前百步洪，河流如箭石当空。\n黄头伐鼓穿洪去，宿雨初收日影红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐州十二咏 其二 戏马台","author":"胡俨","text":"盖世英雄酒一杯，悲歌只使后人哀。\n平生废尽屠龙技，今日空留戏马台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐州十二咏 其三 华佗墓","author":"胡俨","text":"徒把金针事老瞒，千年荒冢朔风寒。\n从来枉却陈琳檄，到底西陵泪不干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐州十二咏 其四 亚父冢","author":"胡俨","text":"三尺青铜盗岂知，只因虹贯草萋萋。\n鸿门玉斗空如雪，拂袖归来路已迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐州十二咏 其五 向魋墓","author":"胡俨","text":"荒丘浅冢草斑斑，事在遗经不可刊。\n石椁成来功已竭，后人有法说邢山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐州十二咏 其六 陵母墓","author":"胡俨","text":"匆匆窗下取吴钩，使者星驰不肯留。\n遂使鸿毛轻一死，却存马鬣重千秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐州十二咏 其七 子房墓","author":"胡俨","text":"辟谷何劳禄万钟，功成志就却辞封。\n分明古墓埋青草，始信空言托赤松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐州十二咏 其八 刘向墓","author":"胡俨","text":"十年封事遗编在，三尺荒丘宿草摧。\n鸿宝浪传谁见得，藜灯一去不重来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐州十二咏 其九 留城","author":"胡俨","text":"偶然相遇若神交，多少奇谋胜六韬。\n辟谷归来应却扫，如何四皓又重劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐州十二咏 其十 彭祖楼","author":"胡俨","text":"锡封曾奠大彭墟，千古传来事不虚。\n明月满楼尘影息，仙人曾驾五云车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐州十二咏 其十一 燕子楼","author":"胡俨","text":"妙舞清歌一夕休，繁华销尽彩云收。\n多情只有乌衣侣，终岁相看不下楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26887,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐州十二咏 其十二 黄楼","author":"胡俨","text":"衮衮河流昼夜驰，长怀太守筑堤时。\n当年宾客黄楼盛，今日荒凉读断碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26888,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜过汶上马尚书墓","author":"胡俨","text":"华表苍苍立墓门，百年翁仲至今存。\n行人为说尚书墓，何处流传有子孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26889,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东平道中","author":"胡俨","text":"白云飞尽碧天寒，夹道青山马上看。\n最是动人愁思处，虫声满地叶声干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26890,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓过谷城黄石公庙","author":"胡俨","text":"月落青山露气清，山头黄石立峥嵘。\n萧条古庙无灯火，惟有西风草木声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画四首 其一","author":"胡俨","text":"青山千迭复万迭，碧树前村连后村。\n酿得松花酒初熟，故人相与款柴门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画四首 其二","author":"胡俨","text":"碧沙流水漾清溪，溪口时闻谷鸟啼。\n两岸好山明镜里，扁舟如在越东西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画四首 其三","author":"胡俨","text":"远山凝翠横溪上，流水浮花出石根。\n时有渔舟来复去，等闲莫认作桃源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画四首 其四","author":"胡俨","text":"故园西畔是西山，万壑千岩翠黛环。\n今日看图隔烟水，西风吹梦绕松关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过仪真 其一","author":"胡俨","text":"迎銮驿前江水平，落帆过坝暂休程。\n人家两岸垂杨柳，时有飞花拂酒觥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过仪真 其二","author":"胡俨","text":"载得图书满画船，倾壶况复酒如泉。\n东风十里仪真路，江水江花亦可怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过仪真 其三","author":"胡俨","text":"南北帆樯会此津，满江箫鼓载阳春。\n相逢尽是他乡客，莫厌樽前劝酒频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重过扬州","author":"胡俨","text":"百丈牵江夜未休，那知梦里过扬州。\n春风二月蕃厘观，不为琼花一少留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雷塘","author":"胡俨","text":"吴公台下是雷塘，望断春山碧草长。\n却笑相逢追往事，樽前犹说舞腰伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"召伯坝 其一","author":"胡俨","text":"召伯津头江水斜，茅茨竹里有人家。\n当年谢傅甘棠树，今日春风野草花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"召伯坝 其二","author":"胡俨","text":"渺渺湖田草半青，鹭鸶风里立亭亭。\n忽惊船上金笳发，飞过春山点画屏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过邗沟","author":"胡俨","text":"春草萋萋春水流，行人此日过邗沟。\n想得都城车驾发，五云缭绕护宸旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重过戏马台","author":"胡俨","text":"拔山力尽楚声哀，戏马千年尚有台。\n若使后人伤往事，何能更醉菊花杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"放鹤亭 其一","author":"胡俨","text":"昔者高亭石佛山，只今烟暝鸟声闲。\n千年白鹤归何处，惟有文章落世间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"放鹤亭 其二","author":"胡俨","text":"隐隐青山晓雾开，望中谁谓有亭台。\n山人一去无消息，空想仙翁看鹤来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题竹 其一","author":"胡俨","text":"一双琅玕势千尺，满壁清风动幽室。\n坡翁老可不复见，梦入筼筜秋瑟瑟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题竹 其二","author":"胡俨","text":"不受红尘半点侵，月中时听凤孤吟。\n涔阳望断兰旌远，锦瑟一弹秋满林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题子昂书嵇康绝交书","author":"胡俨","text":"飘飘绝俗嵇中散，咄咄逼人王右军。\n书罢潇然无一事，鸥波亭上看晴云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题一片秋意图二首 其一","author":"胡俨","text":"袅袅西风生夕波，萧萧碧树得秋多。\n潘郎未就闲居赋，白发添来奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题一片秋意图二首 其二","author":"胡俨","text":"欲揽芙蓉上采舟，浦云烟树隔沧洲。\n眼中秪觉秋光好，何事骚人却怨秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中纵目二首 其一","author":"胡俨","text":"秫黍萧萧弄晚晴，朔风吹起雁行惊。\n牛羊满野无人问，盛世中原见太平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中纵目二首 其二","author":"胡俨","text":"长河不断送行舟，百丈遥牵晚未休。\n望尽天涯秋一色，蓼花芦叶水悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"棹歌","author":"胡俨","text":"一湾一湾复一湾，河流百折苦回环。\n归舟尽日此中去，只见黄芦不见山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卜筑新成胡学士以诗见寄就韵奉答三首 其一","author":"胡俨","text":"老来随处作颐庵，容膝何妨小似龛。\n终日掩关人迹少，绝无雄辩与高谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卜筑新成胡学士以诗见寄就韵奉答三首 其二","author":"胡俨","text":"小小茅斋不厌低，频来乳燕欲衔泥。\n亦知阶下难旋马，肯向云中学养鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卜筑新成胡学士以诗见寄就韵奉答三首 其三","author":"胡俨","text":"百尺高槐连禁苑，绝胜花竹卜郊居。\n樽前兴到频题句，客里官闲儗著书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题故元端本堂殿臣王熙临宋徽宗雪雁图","author":"胡俨","text":"端本堂中酒未销，侍臣图画写前朝。\n岂知夜半征车发，雪落沙场雁影遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻杨学士士奇卧病赋诗寄简十首 其一","author":"胡俨","text":"昔年我病公南去，公病今令我北思。\n怅望停云千里隔，竹窗樽酒负佳期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻杨学士士奇卧病赋诗寄简十首 其二","author":"胡俨","text":"东里先生懒著书，新栽花竹似郊居。\n病来对客无谈笑，麈尾高悬室自虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻杨学士士奇卧病赋诗寄简十首 其三","author":"胡俨","text":"近见椷书到玉堂，忽闻伏枕意难忘。\n形容不是缘诗瘦，坐卧多因爱竹凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻杨学士士奇卧病赋诗寄简十首 其四","author":"胡俨","text":"词垣罢直已多时，窗户流尘生砚池。\n事业到头须努力，年过五十未应衰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻杨学士士奇卧病赋诗寄简十首 其五","author":"胡俨","text":"见说新来坐不眠，重屏围暖拥青毡。\n但闻子敬歌桃叶，岂有杨枝伴乐天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻杨学士士奇卧病赋诗寄简十首 其六","author":"胡俨","text":"不见堂前雀送鳣，只闻幽室药频煎。\n越人亦有方堪寄，却恐桓侯笑未然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻杨学士士奇卧病赋诗寄简十首 其七","author":"胡俨","text":"闻道维摩面欲焦，他乡相忆客魂消。\n亦知松柏苍苍色，纵使经霜未肯凋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻杨学士士奇卧病赋诗寄简十首 其八","author":"胡俨","text":"先生何事最关情，人道如今太瘦生。\n故旧年来多老大，题诗不觉泪纵横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻杨学士士奇卧病赋诗寄简十首 其九","author":"胡俨","text":"看看腊尽又逢春，想见春来气象新。\n造物小儿徒自苦，先生已办逐傩人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻杨学士士奇卧病赋诗寄简十首 其十","author":"胡俨","text":"昔年染翰共承恩，今日看云忆故人。\n两鬓萧萧空自老，不才未有报涓尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松鹤图为师侍郎赋","author":"胡俨","text":"玉雪森森被羽毛，一声清唳入云高。\n翛然独步长松下，曾载仙人醉碧桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅雪金鸡图","author":"胡俨","text":"暗香疏翠晓凄迷，正是山中雪涨溪。\n咿喔一声红日上，满林惊起众禽栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题明秀楼 其一","author":"胡俨","text":"江流一碧际长空，江上青山秀色重。\n几度高楼读书罢，画阑秋水看芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题明秀楼 其二","author":"胡俨","text":"紫霞碧树绕沧洲，满目江山入画楼。\n想得楼中宾客散，携琴还载木兰舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己亥人日是日壬子上表贺海平二首 其一","author":"胡俨","text":"风不鸣条海不惊，千官拜表雪初晴。\n人人共说逢壬子，预喜丰年应太平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己亥人日是日壬子上表贺海平二首 其二","author":"胡俨","text":"三日东风淑气生，讴歌箫鼓满都城。\n亦知客里春盘好，还忆西江七宝羹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题平林烟雨图二首 其一","author":"胡俨","text":"昔从三泖载舟还，风起湖心烟满山。\n白鸟沧波春浩浩，暗红垂绿雨斑斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题平林烟雨图二首 其二","author":"胡俨","text":"旧游长忆在余干，几对琵琶烟雨寒。\n白发无情人易老，画中浑似梦中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送胡文善还金华二首 其一","author":"胡俨","text":"蚤登科第入词垣，谒告南归又拜恩。\n莫向双溪看明月，白云深处有丘园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送胡文善还金华二首 其二","author":"胡俨","text":"都门三月柳垂丝，歌彻桃夭赋远归。\n想得到家春似锦，芙蓉孔雀烂生辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题许由弃瓢图","author":"胡俨","text":"先生高致出尘嚣，爵禄曾闻不可邀。\n但使此心如止水，当年何必弃?瓢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱孟德还宁夏五首 其一","author":"胡俨","text":"担簦负笈出西陲，两度金门射策时。\n今日凄凉歌陟屺，客窗清泪只空垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱孟德还宁夏五首 其二","author":"胡俨","text":"天涯望断白云飞，洒泪那能赋式微。\n满路杨花春欲暮，不堪飞雪点麻衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱孟德还宁夏五首 其三","author":"胡俨","text":"念子相从今几年，岁寒能守旧青毡。\n扬雄已老侯芭去，独立春风思惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱孟德还宁夏五首 其四","author":"胡俨","text":"匹马征衫西入秦，行人何处最销魂。\n夜听青涧城边雨，晓望乌崙山上云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱孟德还宁夏五首 其五","author":"胡俨","text":"官道风清雨歇时，青山如黛柳如丝。\n丈夫不洒离群泪，无奈于今我已衰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题郭文通画二首 其一","author":"胡俨","text":"千尺长松山馆清，小桥流水净无声。\n落花啼鸟春风后，野服乌巾独自行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题郭文通画二首 其二","author":"胡俨","text":"天际楼台望欲迷，青山雨过绿阴齐。\n扁舟载酒游何处，不是耶溪即剡溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题梅二首 其一","author":"胡俨","text":"冷蕊疏花雪半干，溪风岭月共盘桓。\n不随桃李争春色，独向山林守岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]