[{"title":"寄张肖甫时备兵天雄 其二","author":"欧大任","text":"幕府容谁入，襜帷不可同。\n按章三辅肃，倚啸故关雄。\n白发兵戈后，黄尘睥睨中。\n军劳酬圣主，恩已拜彤弓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5797,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄张肖甫时备兵天雄 其三","author":"欧大任","text":"边隅今不耸，赵魏近何如。\n晓色收烽燧，秋声傍羽书。\n投醪雕马水，凭轼昼熊车。\n高宴军中乐，题诗一寄予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5798,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄张肖甫时备兵天雄 其四","author":"欧大任","text":"中原惟骋目，尺素到应难。\n意气高悬榻，才名老据鞍。\n黄榆风骠立，大卤雪雕盘。\n未得从君去，吴钩夜夜看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5799,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"文德承吴孝父王省夫吴虎臣过斋中小集得东字","author":"欧大任","text":"客馆过从少，情亲有数公。\n关西推任侠，江左得词雄。\n禅友天都旧，诗人淮海穷。\n高谈疑稷下，深隐似墙东。\n舞剑琴书侧，衔杯薜荔中。\n箧馀经策在，囊愧酒钱空。\n花气时时醉，莺声处处同。\n山阳即此地，共作灌园翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5800,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄表弟希尹贰守温州","author":"欧大任","text":"南海衣冠盛，名家江夏香。\n弱龄推隽乂，讲业揖宫墙。\n吾道占昌运，君才早擅场。\n逸群看骏奋，仪羽倏鸿翔。\n制锦吴淞上，徵轺汉署旁。\n留曹经制吏，分省度支郎。\n江左贤声籍，滇南宪令张。\n参藩仍此地，得罪去何乡。\n别我思燕蓟，逢人询庙廊。\n淮醝迁客远，海月使君狂。\n忽喜青毡至，新惊白发长。\n璚花春共醉，画舸夜相将。\n展骥催行色，鸣驺借宠光。\n量移蒙圣主，容纳赖先皇。\n出入酬恩日，周旋缀末行。\n永嘉诸郡最，雁荡万山苍。\n佐守开铃阁，题诗宴射堂。\n词人谁继谢，良牧夙称黄。\n遥指东瓯驿，犹瞻北固樯。\n懿亲难判袂，薄宦易殊方。\n晚泊多闻雁，秋征半带霜。\n他年携手地，何处忆维扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5801,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽彭孔嘉徵君八韵","author":"欧大任","text":"白首胥台隐，贞孤亦可师。\n工书繁笔札，好客满茅茨。\n墙溷十年赋，江湖九咏词。\n鹖冠终已矣，蝉冕更何为。\n棐几经犹掩，衡门泪已滋。\n黔娄称谥日，桑扈返真时。\n五岭神交客，三吴感逝诗。\n州来心许在，挂剑岂无期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5802,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜衡仲至杨州","author":"欧大任","text":"吾弟风尘色，淮南见欲惊。\n入门先问母，束带独怜兄。\n海月照征袂，江烟沾客缨。\n松斋频共坐，花径每随行。\n病齿能挥药，消中亦引觥。\n灯前儿女恋，榻下笑谈声。\n不及姜肱被，山家枕簟情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5803,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄钱叔宝","author":"欧大任","text":"翛然灵寿杖，南国旧王孙。\n落落栖蒙谷，蘧蘧老漆园。\n诗成神更王，剑在侠犹存。\n霞起窗前笔，莺啼月下尊。\n严遵开蜀肆，梅福隐吴门。\n五岳图先寄，从君欲避諠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5804,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠御史大夫莆田林公擢大司空","author":"欧大任","text":"北斗三台近，孤卿八座崇。\n廷推秦执法，职重汉司空。\n少日文章伯，先朝侍从雄。\n庙廊收俊杰，馆阁仰宗工。\n视草为郎久，传经典乐同。\n玺书临楚蜀，斧钺出西东。\n鹊印提封远，碉房节制通。\n边劳曾不赏，吾道未应穷。\n赤舄闽山侧，青蓑粤海中。\n艰难深避地，议论借和戎。\n饮羽聊穿石，攀髯忽堕弓。\n嗣皇思旧德，上宰契深衷。\n恩重蒲轮起，班先棘位充。\n留都尊九列，宪府冠群公。\n革履尚书贵，元圭伯禹功。\n江河资润泽，礼化待昭融。\n卜相飞腾入，凝旒宠渥隆。\n调和专鼎鼐，姓字在儿童。\n贱子惭非骏，浮生似落鸿。\n未由驰万里，徒尔逐孤蓬。\n名忝门生籍，心怀国士风。\n儒宗承五教，师说启群蒙。\n引领江都客，将从柱下翁。\n宁能攀紫幰，趋谒未央宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5805,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠御史大夫邹","author":"欧大任","text":"华岳三峰出，黄河九曲连。\n钟灵惟正气，翊运得名贤。\n代衍兰皋远，庭趋海国偏。\n淮流延北望，陕服暂西旋。\n逆旅扶车日，严亲构疾年。\n危何惜片股，哀只吁皇天。\n卜葬含辛后，登科擢甲前。\n教从滂母授，居似孟家迁。\n柱史名方振，奸臣恶未悛。\n九关罗虎豹，一疏奋鹰鹯。\n言激忠能尽，恩深孝益传。\n银台初宠异，棘寺已联翩。\n西府孤卿贵，南巡节使权。\n召归劳秉宪，诲讷许绳愆。\n明主今资倚，先皇幸保全。\n都人迎衮绣，台吏拜旌旃。\n石庆家声重，韦贤内行宣。\n纲常持弼亮，礼乐息戈鋋。\n台斗云霄上，门墙日月边。\n即看操鼎轴，万类藉陶甄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5806,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日姚伯子陈伯春陆无从张叔龙集斋中得风字 其一","author":"欧大任","text":"把菊延三益，居然处士风。\n萧萧篱落晚，秋在雨声中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5807,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日姚伯子陈伯春陆无从张叔龙集斋中得风字 其二","author":"欧大任","text":"门生诸子在，二客亦能同。\n更约篮舆出，东林候远公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5808,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日姚伯子陈伯春陆无从张叔龙集斋中得风字 其三","author":"欧大任","text":"薄禄堪沽酒，浮生吏隐中。\n江枫摇落处，犹得映房栊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5809,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日姚伯子陈伯春陆无从张叔龙集斋中得风字 其四","author":"欧大任","text":"淮海逢重九，尊醪幸不空。\n黄花偏有色，宁敢怨秋风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5810,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵怀古二十首 其一 蜀冈","author":"欧大任","text":"寂寂巴江流，沉沉蜀井月。\n西来一片山，尚带岷峨雪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5811,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵怀古二十首 其二 邗沟","author":"欧大任","text":"何年杨子江，直过山阳渎。\n千秋霸气孤，眇眇原臣目。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5812,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵怀古二十首 其三 芜城","author":"欧大任","text":"邹阳一洒泪，书在竟谁看。\n落日荒城草，西风井径寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5813,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵怀古二十首 其四 董井","author":"欧大任","text":"由来下帷人，不薄江都相。\n斯井犹至今，月照辘轳上。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5814,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵怀古二十首 其五 召伯埭","author":"欧大任","text":"谢公镇广陵，甘棠人勿剪。\n君见东山云，何似召伯堰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5815,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵怀古二十首 其六 昆丘台","author":"欧大任","text":"地轴横昆丘，上有百尺台。\n天边桐柏水，西向城头来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5816,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵怀古二十首 其七 弩台","author":"欧大任","text":"愁问南朝日，风尘暗战场。\n蹶张三万士，只恨竟陵王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5817,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵怀古二十首 其八 梅花阁","author":"欧大任","text":"高吟水部诗，独访法曹宅。\n雪深不逢人，惟有罗浮客。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5818,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵怀古二十首 其九 九曲池","author":"欧大任","text":"莫奏水调歌，杨花怨春晚。\n萧萧日影斜，已绝广陵散。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5819,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵怀古二十首 其十 迷楼","author":"欧大任","text":"琼枝十二楼，玉镜三千户。\n伤心巩树春，花落雷塘路。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5820,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵怀古二十首 其十一 萤苑","author":"欧大任","text":"玉辇宵游处，山萤万点飞。\n后庭方熠耀，不照锦帆归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5821,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵怀古二十首 其十二 大明水","author":"欧大任","text":"僧汲空山月，煮茗松下啜。\n桑苧今不来，白云自禅悦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5822,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵怀古二十首 其十三 禅智寺","author":"欧大任","text":"高僧话六朝，焚香共清昼。\n无数江南山，尽列窗中岫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5823,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵怀古二十首 其十四 平山堂","author":"欧大任","text":"京岘望杨州，石愧向江左。\n回首秋云飞，苍然见淮楚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5824,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵怀古二十首 其十五 璚花观","author":"欧大任","text":"洞里蕃釐观，江头十万家。\n春来歌玉树，不必问琼花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5825,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵怀古二十首 其十六 芍药圃","author":"欧大任","text":"万朵锦云新，天涯赠美人。\n谁知江上色，却掩洛阳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5826,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵怀古二十首 其十七 竹西亭","author":"欧大任","text":"送客茱萸湾，迎客竹西口。\n歌吹满杨州，犹似昔年否。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5827,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵怀古二十首 其十八 玉钩斜","author":"欧大任","text":"吴公台下路，风散野棠花。\n莫怨游魂远，芜城亦帝家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5828,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵怀古二十首 其十九 杨子津","author":"欧大任","text":"策马立烟皋，临江送波涛。\n楚乡不可望，落日苍山高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5829,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵怀古二十首 其二十 瓜洲","author":"欧大任","text":"击楫过瓜洲，楚歌忽风雨。\n江门春浪生，夜夜蛟龙语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5830,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴孝父归黄山","author":"欧大任","text":"皂帽翩翩去，黄山若个峰。\n莫将瓢与笠，深隐白云重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5831,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈山人二画为张叔龙题 其一 玫瑰花","author":"欧大任","text":"露蕊濯菊裳，风香度兰牖。\n采之赠佳人，不用持琼玖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5832,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈山人二画为张叔龙题 其二 木芙蓉","author":"欧大任","text":"红艳照寒光，江天木末霜。\n楚歌行结佩，秋思满潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5833,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝应张氏丛桂园同皇甫子循郭次甫黄淳甫赋八首 其一 淮南草堂","author":"欧大任","text":"我家八桂树，君家桂无数。\n枕中鸿宝书，何如小山赋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5834,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝应张氏丛桂园同皇甫子循郭次甫黄淳甫赋八首 其二 三花馆","author":"欧大任","text":"二室接浮丘，东来渡淮水。\n三花何处开，半在白云里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5835,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝应张氏丛桂园同皇甫子循郭次甫黄淳甫赋八首 其三 松轩","author":"欧大任","text":"婆娑古松下，忆昔仙人家。\n风从岱宗来，吹落秦时花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5836,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝应张氏丛桂园同皇甫子循郭次甫黄淳甫赋八首 其四 海月台","author":"欧大任","text":"明月生东海，万里飞烟彩。\n我欲往拾之，清光在兰茝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5837,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝应张氏丛桂园同皇甫子循郭次甫黄淳甫赋八首 其五 品泉亭","author":"欧大任","text":"品泉如品士，清修良独难。\n泉侧支茶炉，瑟瑟松涛寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5838,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝应张氏丛桂园同皇甫子循郭次甫黄淳甫赋八首 其六 慈竹寮","author":"欧大任","text":"手把楞伽读，悬灯伴僧宿。\n夜闻风雨声，那知在深竹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5839,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝应张氏丛桂园同皇甫子循郭次甫黄淳甫赋八首 其七 玉勾洞","author":"欧大任","text":"市上悬一壶，此是长房宅。\n青雀飞不还，报书瑶池客。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5840,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝应张氏丛桂园同皇甫子循郭次甫黄淳甫赋八首 其八 借隐室","author":"欧大任","text":"隐矣君莫疑，闭关堪避諠。\n不见东方子，陆沉金马门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5841,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中送叶山人渡江归吴门 其一","author":"欧大任","text":"鹤氅雪华残，归舟笠泽寒。\n闭关不相送，贫病愧袁安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5842,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中送叶山人渡江归吴门 其二","author":"欧大任","text":"君寻杨子渡，正是嘉平月。\n我有一藤蓑，赠之钓江雪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5843,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏水仙花","author":"欧大任","text":"烟波愁独立，罗袜不沾尘。\n请佩人何去，谁邻江上春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5844,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛舟高家庄看辛夷花","author":"欧大任","text":"綵笔灿山霞，高楼照江雨。\n谁知辋口庄，犹有辛夷坞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5845,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郭山人游囊杂咏六首 其一 五岳真形图","author":"欧大任","text":"囊挟五山去，佩之淩紫氛。\n金支翠旗里，导谒云中君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5846,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郭山人游囊杂咏六首 其二 杖","author":"欧大任","text":"仙人扶绿玉，时亦铿然叩。\n振动三界中，烟霞一灵寿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5847,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郭山人游囊杂咏六首 其三 衲","author":"欧大任","text":"山僧赠衲衣，旧是稻田样。\n石床不解眠，夜礼天坛上。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5848,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郭山人游囊杂咏六首 其四 瓢","author":"欧大任","text":"长生十赉者，朝夕持在手。\n深山还寄来，惯乞郡斋酒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5849,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郭山人游囊杂咏六首 其五 锄","author":"欧大任","text":"五游行归来，荷尔起常早。\n门前莫锄兰，云中种朱草。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5850,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郭山人游囊杂咏六首 其六 觚","author":"欧大任","text":"山都洗我觚，贮月饮涧下。\n风来吹有声，笑学昔人挂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5851,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪后泗州游塔寺行役东西颇有河山之感示同游诸子三首 其一","author":"欧大任","text":"荆涂云一色，淮泗波千里。\n山僧不出门，藤蒲对花水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5852,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪后泗州游塔寺行役东西颇有河山之感示同游诸子三首 其二","author":"欧大任","text":"薝卜林皆玉，旃檀室是香。\n供君鍮石罐，贮月在禅房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5853,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪后泗州游塔寺行役东西颇有河山之感示同游诸子三首 其三","author":"欧大任","text":"风尘弹指过，于世已浮沉。\n处处双林客，年年五岳心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5854,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答冯郡博京口见讯因忆黎职方惟敬 其一","author":"欧大任","text":"君在西津渡口，余登杨子江桥。\n一水盈盈相隔，烟波日望兰桡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5855,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答冯郡博京口见讯因忆黎职方惟敬 其二","author":"欧大任","text":"渐过茱萸佳节，高歌苜宿荒斋。\n有酒悠然独酌，美人渺矣予怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5856,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答冯郡博京口见讯因忆黎职方惟敬 其三","author":"欧大任","text":"丈室曾闻寄宿，尺书频遣寻盟。\n扁舟他夜月色，孤阁寒江雁声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5857,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答冯郡博京口见讯因忆黎职方惟敬 其四","author":"欧大任","text":"吾友中朝才子，罗浮万里炎方。\n京口劳君问讯，鲈鱼偏忆江乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5858,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄许元复","author":"欧大任","text":"蓟门分袂四年馀，近得琅琊尺素书。\n鱼吏烟波差可恋，马曹官舍更何如。\n郡当淮口遥连泗，山过江南尽入滁。\n目送飞鸿频忆汝，秋深莫遣八行疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5859,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送沈肩吾归明州","author":"欧大任","text":"广陵驿前柔橹鸣，越客离歌半楚声。\n高阁酒醒孤树远，片帆潮落大江平。\n四明天自窗中见，九曲人从镜里行。\n莫向秋风折杨柳，箜篌多少忆归情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5860,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨州中秋送康裕卿项豹章入京","author":"欧大任","text":"萧瑟悲歌对浊醪，那堪立马望烟皋。\n夹堤通泗王程远，落叶边淮客梦劳。\n楼橹夕悬沧海月，鱼龙秋送广陵涛。\n汉庭谁念枚乘笔，羡尔同时赋最高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5861,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日黄判官邀游周氏园","author":"欧大任","text":"斗酒何期一笑欢，孤城莽莽万枫丹。\n阁前山送岷峨色，竹下江通汴泗寒。\n白雁不传南国字，黄花还共逐臣看。\n主恩更在淮阳日，莫向天涯泣楚冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5862,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"姚元白枉书问讯因闻元白与陈子野俱已乞休赋寄二子","author":"欧大任","text":"婆娑偶寄漆园间，荒径苔深颇似閒。\n公事只堪对流水，宦情吾自有青山。\n窗中蝴蝶频支枕，松下楞伽一掩关。\n闻道故人罢官早，白云遥羡鸟知还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5863,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同郭赵王吴四山人杨卞二文学陆阎二秀才集上方寺真如上人房","author":"欧大任","text":"骑马竹西西畔村，汲泉煮茗共僧言。\n帛公诗句开庐岳，谢客禅栖在石门。\n法供香花参橡栗，讲堂户牖瞩林园。\n青山拄笏虽非隐，暂得相从一避諠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5864,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过隋故宫二首 其一","author":"欧大任","text":"龙舸忘归几岁华，六军飞挽万方嗟。\n辽阳鼓角沧波远，巩洛山河落日斜。\n水调杨花歌九曲，江游萤火散千家。\n芜城莫引中原目，衰柳残堤宿暮鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5865,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]