192fe5294295f79689","path":"明_3.csv","pointer":31781,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邸中种竹十二首 其十一","author":"何吾驺","text":"以兹数尺茎，参彼上下际。\n伟干与虚中，君子隐而费。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31782,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邸中种竹十二首 其十二","author":"何吾驺","text":"长羡空空如，虚空生冷籁。\n扫尽万顷烟，盈盈不下带。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31783,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山杂咏十三首 其一 振衣亭","author":"何吾驺","text":"先民有高怀，振衣誇千仞。\n此意达者知，举步何远近。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31784,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山杂咏十三首 其二 期云馆","author":"何吾驺","text":"博带披元雾，脩眉染碧烟。\n良朋不易得，能复问神仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31785,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山杂咏十三首 其三 水帘台","author":"何吾驺","text":"昨夜蕊珠宫，鲛人几番泣。\n幻出水晶帘，疑是道子笔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31786,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山杂咏十三首 其四 浮碧台","author":"何吾驺","text":"但存长公迹，一片石亦佳。\n吾今凭眺上，四顾难为怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31787,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山杂咏十三首 其五 仙源","author":"何吾驺","text":"幽深殊世界，长望挹仙源。\n仙在人间是，相逢笑不言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31788,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山杂咏十三首 其六 瑶林","author":"何吾驺","text":"颇笑葛洪时，求为勾漏令。\n若早见瑶林，应无炼丹井。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31789,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山杂咏十三首 其七 栎社","author":"何吾驺","text":"好似陶彭泽，为民拟葛天。\n余亦不材者，因君寄大年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31790,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山杂咏十三首 其八 露坛","author":"何吾驺","text":"淩风发高唱，山鬼夜吹灯。\n但坐空阶月，听他泣未曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31791,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山杂咏十三首 其九 飞泉洞","author":"何吾驺","text":"沧海行扬尘，江河易枯竭。\n老龙洞里眠，喷即漫天雪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31792,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山杂咏十三首 其十 石洞","author":"何吾驺","text":"白者往干霸，黄者傅封侯。\n留将数片在，无人时点头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31793,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山杂咏十三首 其十一 苍雪崖","author":"何吾驺","text":"我闻峨眉雪，盛夏常阴冻。\n崖胡其苍苍，江寒结高垄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31794,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山杂咏十三首 其十二 清音楼","author":"何吾驺","text":"洞箫清且悲，铁笛缓而惨。\n夜深试一闻，千岩万壑淡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31795,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山杂咏十三首 其十三 山晖堂","author":"何吾驺","text":"鸣珂迎帝子，伐木礼嘉宾。\n莫作人间会，山花几度春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31796,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"圣寿赐文绮","author":"何吾驺","text":"赐锦身依日月光，呼嵩满祝五云觞。\n圣明衣被恩难报，愿及垂裳遍万方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31797,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"御赐菊露清","author":"何吾驺","text":"东篱漫拟摘如金，未识皇家秋色深。\n满酌黄花元是露，九瓶天上一般斟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31798,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"御赐川扇","author":"何吾驺","text":"金泥彩绣影朣胧，贡入峨眉第几峰。\n天上扇如天上月，君恩到手是仁风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31799,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏史 其一 范蠡","author":"何吾驺","text":"槜李茫茫没霸图，扁舟清梦几时苏。\n可知廿载艰危日，一片春心在五湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31800,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏史 其二 荆轲","author":"何吾驺","text":"直藐秦皇若釜鱼，图开匕首殿中徂。\n合从六国成何用，学士空悲剑术疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31801,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏史 其三 樊于期","author":"何吾驺","text":"可将何物赠新知，四拜临风刎颈时。\n易水夜寒人不返，千秋犹自惜于期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31802,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏史 其四 弥子瑕","author":"何吾驺","text":"行行犹多儿女情，子瑕谁为述平生。\n可怜国士衔知遇，都向馀桃拜卫卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31803,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏史 其五 爰旌目","author":"何吾驺","text":"意气何人似爰生，壶餐终不毁高名。\n只今何处非狐父，欲食低头不敢明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31804,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]