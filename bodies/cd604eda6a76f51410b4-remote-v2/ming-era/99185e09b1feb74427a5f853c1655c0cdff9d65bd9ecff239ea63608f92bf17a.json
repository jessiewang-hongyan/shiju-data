[{"title":"峡山飞来寺","author":"谭岳","text":"寺本飞来胜，山从两峡奇。\n扪萝探旧迹，蹑屩读荒碑。\n紫翠中天现，笙簧万壑吹。\n由来陵谷异，登眺未堪疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21002,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阙题","author":"孔从先","text":"飞来古刹传齐梁，浩劫新开胜地藏。\n雨散诸花盈法座，月移孤镜到禅堂。\n玉环留院千年幻，金锁空潭一水长。\n独有悬崖松树色，商声萧瑟自苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21003,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"啸台","author":"孔从先","text":"四大无尘境，白云自往还。\n盈盈襟袖里，不令到人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21004,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偕贺邑公张吴二生阅武郊外","author":"陈侯周","text":"积雨方新霁，天河欲洗兵。\n旌旗开曙色，铙鼓杂秋声。\n共享椎牛乐，谁歌饮马行。\n书生当献赋，莫浪请长缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21005,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登白岳","author":"陈侯周","text":"白岳峰头翠色环，倚天楼阁有无间。\n岩泉作雨寒潭静，古树眠云石洞閒。\n贝阙晚烟浮远黛，玉炉朝霭绕前山。\n天门咫尺苍茫外，谁得清风纵往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21006,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日台郡尊张华宇招饮登城南金紫峰","author":"陈侯周","text":"城上高峰接翠微，峰头秋色自依依。\n天空籁应诸岩响，日落江横匹练飞。\n欲插茱萸须尽兴，因耽竹叶且忘归。\n使君赖有如渑酒，何用长吟待白衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21007,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕寓海昏","author":"陈侯周","text":"忽忽天涯又岁除，萧然牢落叹离居。\n楼头笛韵堪催酒，云外鸿飞不系书。\n春到他乡悲旅食，心悬故国忆鲈鱼。\n残编掩罢寻归梦，一枕三更两载馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21008,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮山","author":"佘祖颐","text":"缥缈层峦万仞雄，玄都日月擘鸿濛。\n石楼秀色晴临海，铁柱岚光翠泼空。\n采药僧归红树里，吹笙人在碧云中。\n凭虚欲挟飞鸾去，仙女峰头御彩虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21009,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓山吊古","author":"佘祖颐","text":"播迁海国恨何穷，当日乾坤黯淡中。\n玉玺泪沉王气散，铜驼月冷帝图空。\n寒厓风雨愁归鹤，故国松楸泣断鸿。\n一自翠华摇落后，忠魂长护紫龙宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21010,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀吴蟾芬","author":"佘祖颐","text":"为忆蛾眉妒，空怜骏骨求。\n十年灯火意，万里鬓毛秋。\n江苇初听雁，山云独倚楼。\n天南瞻紫气，寒色动吴钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21011,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别刘抱白鍊师游楚","author":"佘祖颐","text":"潇湘西去路漫漫，拄杖秋烟岳色寒。\n七十二峰云影外，不知谁共月明看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21012,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"识梦自遣","author":"张世域","text":"断齑画粥向来身，名厕乡书已四旬。\n汲汲俗情推掇第，迟迟禄仕只居贫。\n江门见道程朱侣，琼海回天社稷臣。\n才气未须论甲乙，梦思何事扰心神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21013,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大观堂","author":"曹承诏","text":"驻马寻幽胜，冲泥引兴长。\n名园开绿水，家学富青箱。\n倾盖无新故，班荆慰异乡。\n绕池花历乱，贴槛芰浮香。\n郭舍壶中术，嵇生竹下觞。\n传芬惊萼棣，满座见琳琅。\n叔度波成顷，陈思赋儗樯。\n欢呼同放傲，痛饮任疏狂。\n促膝嗟何晚，临岐忆不忘。\n君应怜去住，吾自愧昂藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21014,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甘霖应祷","author":"梁槐","text":"朱夏骄阳烈未开，神龙何处起风雷。\n阶前忽睹商羊舞，天外俄惊石燕回。\n夹岸荷花枝著绿，两歧秋麦穗重胎。\n霏霏优渥如珠玉，却羡神工遍九垓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21015,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上望采石怀李白","author":"李元畅","text":"挂席扬子津，东望见采石。\n千尺金芙蓉，俯瞰蛟龙宅。\n落日摇青苍，媚我远行客。\n忆昔谪仙人，矶头坐寒碧。\n只身傲千古，两眼空八极。\n笔夺楚山雄，觞飞吴月白。\n霞光堕宫锦，鲸游喷潮汐。\n姑水化为醪，三山持作核。\n客泪寄西风，洒君祠下柏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21016,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阙题","author":"李元畅","text":"玉峡疑纵鬼斧擘，中藏鹫峰三万级。\n攀跻十步五步生，顿地何能避燥湿。\n咽渴唇焦尚未穷，半腰已出天地笼。\n翩翩自谓凌绝顶，仰望犹觉连高空。\n一道飞泉开杳霭，下冲涧谷穿藤葛。\n山僧斜引入茶铛，时有惊涛响木末。\n老松抱石纷相迎，旁翳不测之深坑。\n直干排风虎豹啸，高枝屈铁虬龙撑。\n夹路筼筜如栉密，昔年曾入轩辕律。\n节里犹藏二帝魂，寒声向人每萧瑟。\n石壁萧条霾苍烟，芒鞋翻愁不可前。\n行行忽尽最高处，却怪天上有平地。\n冠峰特耸金仙阙，海蜃何年吹雾结。\n僧贫地险客来稀，佛大寥寥自生灭。\n乱岭支附若赘瘤，翠屏晚对欲点头。\n峡水横拖锡杖白，贾船细作木杯浮。\n山静昼闻猿狖哭，窗空夜有斗牛宿。\n犀潭锁断气犹黄，狮子封苔汗长绿。\n琳宫无数点山阿，俯览不异屯蜂窝。\n钟鼓沉沉隐窟室，炉烟袅袅杂烟萝。\n青眼抱琴者谁子，披襟一奏高山里。\n千溪流水寂无声，万壑浮云飞不起。\n忽闻玉佩声珊珊，三仙尽下云旗幡。\n口中谱出飞龙引，坐命之子一再弹。\n须臾饮客□天酒，佐之瑶琨碧莲藕。\n胡麻饭带玉田砂，雀舌龙团无不有。\n相将出山日已倒，复踏葛洪亭上草。\n断碣模糊不堪读，落花满地无人扫。\n岂自山灵秘幽胜，不教词客迹凌竞。\n三仙长揖闭玄关，欲向何人叩上乘。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21017,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观山寺","author":"李元畅","text":"苏门不可到，鸾啸学孙登。\n急雨扶秋色，孤云伴定僧。\n竹房全凿翠，茶鼎半烧藤。\n礼罢诸天黑，归途影佛镫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21018,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奎塔淩霄","author":"许子伟","text":"会阳文治壮兹台，望起奎光彻上台。\n岂谓胜形勤百姓，应知良牧达三才。\n岘颠唯有思羊去，河内岂无借寇回。\n往事浮屠人已去，南宗卢教自今开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21019,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈太守邀饮骊台口占纪胜二绝 其一","author":"许子伟","text":"嶪嶭山城古石龙，碧流环绕似云从。\n登台会见文翁化，指点千家屋可封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21020,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈太守邀饮骊台口占纪胜二绝 其二","author":"许子伟","text":"化城文运自今昌，东璧星辉接水光。\n最喜台成龟出洛，道南回首日扶桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21021,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重建灵济宫","author":"陈惇临","text":"庙宇重开綵阁新，飘飘遗像紫阊身。\n名书绛简游天阙，时指琼丹活世人。\n璃幄长悬庭有燄，檀烟不断几无尘。\n英灵千载俨如在，锡类难酬祇荐蘋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21022,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"明会典成赐宴礼部有述馆课","author":"林承芳","text":"千官樽俎集南宫，万国车书此日同。\n象魏双悬尧典礼，凤韶初叶舜丝桐。\n金茎露湛传仙籞，兰署花深引上公。\n最是主恩偏侍从，蓼莪长咏太平风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21023,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除岁立春日赐百官食春饼应制馆课","author":"林承芳","text":"律尽寒威散，春回暖气催。\n金盘新赐食，玉署旧藏枚。\n綵树争裁胜，香风欲绽梅。\n百寮钦圣德，拜舞带恩回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21024,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"扈从南郊纪事","author":"林承芳","text":"警跸遥闻夹道传，乘舆朝下九重天。\n礼成苍璧同周典，乐奏黄钟叶舜弦。\n朔气渐随仙仗散，晴云高傍翠华悬。\n词臣此日叨簪笔，不数王褒扈从年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21025,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊邑城","author":"林承芳","text":"独岸沿官驿，他山对浦城。\n刺连千树密，花杂一溪明。\n野鸟窥人立，渔舟隐浪轻。\n淹留已昨日，未敢负生平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21026,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来览胜 其一","author":"钟万禄","text":"万仞峰头一振衣，孤松苍翠欲成围。\n干霄壁峡何年劈，绕杖浮云万壑飞。\n涧竹每于声律细，僧居多傍石林扉。\n银河好向津头问，忽听疏钟报晓晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21027,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来览胜 其二","author":"钟万禄","text":"寺老梁唐树，云疏玉峡岑。\n本来空去住，幻迹任阿林。\n天险窥壶岫，笙簧杂涧音。\n苍茫思独渺，千古钓台心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21028,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晒蚬","author":"林震","text":"端居室如蜗，耻为蛮触奋。\n饮啖仅充肠，百珍非所问。\n溪叟前致词，火食虽古训。\n而我山野人，别作一风韵。\n蚬蛤晒可供，烹饪味相似。\n无劳釜鬵溉，只取炎阳蕴。\n生涵熟之理，日即火之运。\n制物各有宜，达生在随分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21029,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和云龙雅咏诗","author":"林震","text":"遥忆园林好，居然惬素心。\n论文耽旧癖，啜茗涤烦襟。\n一槛看鱼曲，千松系马深。\n夜来干象纬，奇绝此登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21030,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺牛文野七十一","author":"林震","text":"白发壶中诀，清尊海上仙。\n初衣遂鸿举，彩服俱象贤。\n此去一百岁，直须三十年。\n凡数起于一，乘之将及千。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21031,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和姚道尊五指山诗","author":"林震","text":"一臂高擎海上洲，褰帷入是采真游。\n欲排瘴霭摅长策，为挽天河洗末流。\n吾道有盟归掌握，皇图何地不中州。\n时清宜献平蛮颂，南顾应纾万里愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21032,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋月饮崔白石宅对圆石","author":"林震","text":"风物凄清对倚栏，云根班坐缘醋宽。\n留将明月空庭满，摘向骊龙秋水寒。\n勾漏不知丹几转，摩尼忽自现团栾。\n祥光夜夜凌无极，疑作天南斗气看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21033,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阳月饮黄乾斋书楼时菊初蕊得阳字","author":"林震","text":"吟倚书楼对夕阳，霜株拂槛未全黄。\n已经重九迟秋节，犹自葳蕤逗晚香。\n商舸近桥人语乱，女墙如带柝声长。\n花神九字君家是，冬去春来放未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21034,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初冬寻菊","author":"林震","text":"栽向东篱也自妍，开迟翻占百花先。\n萧疏嫩蕊仍含冻，管领幽香别有天。\n为抱孤贞劳杖履，不随群艳落芳筵。\n若教容易当庭砌，安得骚人带醉怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21035,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和唐人鸳鸯诗","author":"林震","text":"徐开锦翼弄晴晖，半掩菰菱见面稀。\n睡里不知沙际暖，戏时端的浪花飞。\n双栖绣被沾恩宠，并坐澄潭了道机。\n莫羡五侯池馆胜，与人相对亦依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21036,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕雨","author":"林震","text":"鹊桥岁岁架银河，不似今年怨恨多。\n据拮偏教风雨妒，缘悭其奈女牛何。\n鸣虫似写秋声赋，断雁惊残子夜歌。\n欲向津头问消息，乘槎无计水生波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21037,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华封仙榻","author":"林震","text":"骑鹤仙翁去不还，空留禅榻隐重关。\n九天人在虚无里，三祝声疑杳霭间。\n月冷霓裳窥树色，岚深蜗篆集苔斑。\n坐临磐石耽清赏，耕凿何须更买山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21038,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀友","author":"陈策","text":"军前屯虎豹，仗剑不言家。\n出塞辞秋草，开营见雪花。\n故人金马月，边士铁骑沙。\n磊落同搔首，相思托暮笳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21039,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠蔡宾峰先生","author":"徐应寅","text":"宝安多奇峰，仰止心自快。\n主翁对之居，群峰似罗拜。\n排闼送青葱，列帐呈环怪。\n云来皂盖青，云去元裳解。\n唯茹商山芝，不吞云梦芥。\n昂首八柱擎，吐气九霄隘。\n棨戟导遥临，笔峰卓高迈。\n何曾问主人，岂复椎椒薤。\n主翁仁者流，嘉宾浮邱派。\n宾主日往还，彼此辅僎介。\n峨峨入孤琴，厌厌陈沆瀣。\n侑歌咏有台，忘形超色界。\n但使静相亲，安用言相戒。\n敬尔岂斯须，千秋应不懈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21040,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"楫溪道中","author":"徐应寅","text":"迟回重迟回，离别天南北。\n鹧鸪鸣秋山，笑人行不得。\n路阻意偏长，载道生荆棘。\n宿鸟恋故林，分飞乖羽翼。\n穿入丛莽间，令我心独恻。\n长天苦浮云，不见远山色。\n所以独徘徊，感物伤时节。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21041,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送周学博归衡阳","author":"徐应寅","text":"握手临河别，应伤吾道穷。\n总如璧易玷，始信瑟难工。\n经阁长连汉，尘途但转蓬。\n千年庭下草，犹自识春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21042,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将别薇屋上钟况洲先生","author":"徐应寅","text":"薇屋凄凄急暮砧，晚来谁惜伴孤吟。\n莺声尚忆春三月，雁影忽看秋满林。\n倚槛有花空着眼，飞觞无酒不开襟。\n临流别意知多少，夜雨绵绵江水深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21043,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"增江晚渡","author":"曾受益","text":"舟横一苇相江滨，入暮川光更可亲。\n大地层阴生海峤，青山媚色改松筠。\n日残睥晲延归客，棹拂波光乱晚津。\n却笑沙头纷问渡，如何不见独醒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21044,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋游西园庵四首 其一","author":"曾受益","text":"梵宇瞻新构，西郊近倚城。\n烟光连白水，云气接朱明。\n买地金斯布，飞来锡有情。\n相欢经始日，喜气满群生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21045,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋游西园庵四首 其二","author":"曾受益","text":"整履游濠上，惊看佛界新。\n孤园秋自别，双岛鸟归频。\n只道鱼堪乐，谁知虎亦驯。\n清风披□至，性地肯留尘。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21046,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋游西园庵四首 其三","author":"曾受益","text":"不谓人烟境，莲花涌陆离。\n香风传径竹，落景碍修枝。\n酒肆从他市，僧茶屡有施。\n回心观净理，坐久不知疲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21047,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋游西园庵四首 其四","author":"曾受益","text":"觉苑秋风落，谶筵法鼓传。\n经声穷夜柝，幡影薄云天。\n老厌樊笼役，思登彼岸先。\n何功得愿果，不使笑磨砖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21048,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游华岩庵二首 其一","author":"曾受益","text":"祥光蔚起照南旻，霓栋辇飞梵宇新。\n天欲一方开法象，地因六境坐金身。\n芰荷已报池塘夏，草树犹含乐国春。\n几载皈依勤两叟，到来此日豁心神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21049,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游华岩庵二首 其二","author":"曾受益","text":"华岩四面绝尘因，坐破蒲团一上人。\n数亩町畦为事业，几村烟火作芳邻。\n盘供藻荇青蔬肃，客对荷裳白发新。\n听法不知天色改，仆夫鞅掌速归轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21050,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖山","author":"谢正蒙","text":"为爱湖山胜，登临惬素杂。\n澹烟连粉堞，峭壁隐丹邱。\n老树阴仍合，长溪净欲浮。\n会心成独啸，风景望全收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21051,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登金山","author":"谢正蒙","text":"老来强作登山兴，犹记当年孟浪游。\n身世不堪悲岁月，洞天无恙自春秋。\n松间日转阴移石，海外涛飞气结楼。\n我欲振衣高处望，罡风两腋暮云收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21052,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺罗之成石龟钓纶之作","author":"谢正蒙","text":"水落湖平夜月寒，乘槎到处足观澜。\n凭将心事委浮宅，且把生涯付钓竿。\n欸乃歌残山色暮，烟霞隐入酒杯宽。\n机闻赢得鸥为侣，并立沙头刷羽翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21053,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日林尚仪招饮别业兼集何季文戴泽野黄公奇雷动明郭孟公","author":"张嗣纲","text":"为爱园林好，春风细雨过。\n诗于人日富，朋聚德星多。\n慷慨花前舞，逍遥竹下歌。\n莫将青白眼，看我醉烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21054,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春重修三世祖墓松楸独秀有感而赋","author":"张嗣纲","text":"断碣没荒丘，碑开鼎石修。\n德从三世种，泽自万年流。\n日月光新冢，风云会古楸。\n枝条春意满，青翠暮烟浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21055,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日饮韩懋庭楚带碧亭","author":"张嗣纲","text":"系马城西市，振衣江上亭。\n波光环槛绿，山色送帘青。\n画栋花涵室，纱窗墨染屏。\n主人频洗笔，索写换鹅经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21056,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端州与卢体璋话夜","author":"张嗣纲","text":"驻马从山下，天宁古寺前。\n论交知世谊，话旧叹尘缘。\n剪烛江天暮，围炉井树烟。\n夜深传玉斝，得意自忘年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21057,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日陈守戎招饮阅江台","author":"张嗣纲","text":"飞阁临江渚，丹梯并古崧。\n登临无俗客，招饮有元戎。\n紫气来尊外，青山入望中。\n剑光疑电转，端水日溶溶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21058,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端州数访卢易升不遇其子体璋留饮十日赋诗寄谢","author":"张嗣纲","text":"珠海频年别，崧台二月过。\n登龙逢面少，题凤到门多。\n雅爱七茶曲，能无一饭歌。\n辄因公子语，数问丈如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21059,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日过宗吉谢中表山房赏莲","author":"张嗣纲","text":"过庭因问字，几度扣松扃。\n宝树连云栋，荷花灿画屏。\n风来香冉冉，日丽影亭亭。\n把酒临阶砌，繄谁可独醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21060,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"太华会","author":"张嗣纲","text":"琼山开胜会，妇女号装军。\n玉手垂金勒，纤腰卷翠裙。\n骅骝奔似电，粉黛集如云。\n暮角声何急，相看日未曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21061,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日过访韦寤夏石渠洞索鲙不遂烂醉赋此","author":"张嗣纲","text":"晓入韦渠洞，风来竹径凉。\n举鱼沿曲沼，折笋过横塘。\n不作银丝鲙，翻飞玉露觞。\n醉馀留后约，期待菊花黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21062,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日过朱子虚山房访性和上人","author":"张嗣纲","text":"载酒乘春兴，寻香过草堂。\n鸟依花底啄，人傍柳阴凉。\n把酒和风入，投壶霁月光。\n夜深犹未歇，秉烛扣僧房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21063,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]