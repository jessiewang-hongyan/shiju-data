[{"title":"题脊令图三首 其二","author":"杨士奇","text":"故人死别逾三纪，喜见传家有凤毛。\n清代閒官得名郡，心存忠孝道能高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3779,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题脊令图三首 其三","author":"杨士奇","text":"清泉白石秋风里，下上和鸣相共怡。\n比似汤家好兄弟，临岐为赋在原诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3780,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画竹 其一","author":"杨士奇","text":"冠绂承恩下赤墀，凤池人赠凤凰枝。\n南都昼永文书简，展玩时吟卫武诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3781,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画竹 其二","author":"杨士奇","text":"太平堤畔是秋官，门倚澄湖绿玉湾。\n更出筼筜望天上，五云长护紫金山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3782,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送任敬让参议 其一","author":"杨士奇","text":"万里之官欲别难，朔风吹送潞河干。\n近河榆柳凋零尽，惟有琅玕见岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3783,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送任敬让参议 其二","author":"杨士奇","text":"十载低眉厌郎署，清风高起凤凰枝。\n浣花溪畔多乡故，为托平安寄远思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3784,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题陈知府竹 其一","author":"杨士奇","text":"十年为郡种筼筜，富有清风九夏凉。\n太守从来多惠政，后人将比召公棠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3785,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题陈知府竹 其二","author":"杨士奇","text":"翩翩五马导双旌，金阙朝回合郡迎。\n带得自天新雨露，绿筠加倍旧时清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3786,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题陈知府竹 其三","author":"杨士奇","text":"好竹何妨种万竿，岂徒惟日报平安。\n此君元有清贞操，傲阅冰霜过岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3787,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹赠杨友文运副 其一","author":"杨士奇","text":"十年坐判维扬郡，令誉芳声特达开。\n惠政及人还未已，升官重向广陵来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3788,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹赠杨友文运副 其二","author":"杨士奇","text":"岁久鹾台吏蠹深，朝廷选士比南金。\n富饶有道期裨国，秪在清贞一寸心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3789,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹赠杨友文运副 其三","author":"杨士奇","text":"清比筼筜贞比石，由来志士有深期。\n殷勤一片同宗意，赠向淮南慰别离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3790,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"石宪使慈寿堂 其一","author":"杨士奇","text":"宪府从来冰玉操，为承慈训岁年深。\n平反日奉谖堂乐，全胜西京隽母心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3791,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"石宪使慈寿堂 其二","author":"杨士奇","text":"珠翟云冠两鬓霜，南州使者侍高堂。\n堂中但祝百千寿，日进流霞紫玉觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3792,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题庭循所藏孟端竹","author":"杨士奇","text":"王黻作画天机精，健笔所至秋风生。\n偶然貌得丹山凤，长擅谢家庭馆清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3793,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄杨少保 其一","author":"杨士奇","text":"分手东华一月来，画船春水奉恩回。\n计程定过金陵去，新笋鲥鱼对酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3794,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄杨少保 其二","author":"杨士奇","text":"三十登朝雪满簪，长风万里称归心。\n白云翠岫江乡趣，一路题诗入绣林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3795,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送欧阳瀚教闽县 其一","author":"杨士奇","text":"故人有子早能官，万里曾经蜀道难。\n此去三山近南海，讲帷依旧一毡寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3796,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送欧阳瀚教闽县 其二","author":"杨士奇","text":"写得淇园脩竹枝，临行聊赠慰相思。\n清风直节岁寒意，别有云霄远大期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3797,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送刘顺常教扬州 其一","author":"杨士奇","text":"扬州繁盛接金陵，北贾南商满市坰。\n惟有泮宫清似洗，衣冠长日坐谈经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3798,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送刘顺常教扬州 其二","author":"杨士奇","text":"博士之官向竹西，一竿聊慰远分携。\n绿阴斋馆无尘杂，讲罢新诗取次题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3799,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送张凤应县丞","author":"杨士奇","text":"华亭贰令朝回日，凛凛冰霜岁暮寒。\n为有一枝清似玉，同乡持赠异乡看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3800,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荆州太守刘永母挽诗 其一","author":"杨士奇","text":"喜闻春意回南郡，遽报凄风起北堂。\n卧辙攀辕空满路，麻衣血泪使人伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3801,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荆州太守刘永母挽诗 其二","author":"杨士奇","text":"诗书何幸际明时，得禄承欢母遽违。\n升堂最是伤心处，挂壁犹存旧断机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3802,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送佘通判 其一","author":"杨士奇","text":"烧灯节后发京师，春色初回杨柳枝。\n耆老如云待沤渚，到官莫过牡丹时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3803,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送佘通判 其二","author":"杨士奇","text":"分明一道澄江月，照见冰霜铁石心。\n谁谓今人未如古，古来循吏只如今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3804,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送佘通判 其三","author":"杨士奇","text":"吏胥无复到乡村，諠杂何曾及县门。\n岁岁年年比今日，邑人常戴府公恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3805,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题王氏水竹居 其一","author":"杨士奇","text":"家住龙河碧玉湾，清风绕屋万琅玕。\n旧闻嵇阮诸才子，常聚南园与北园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3806,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题王氏水竹居 其二","author":"杨士奇","text":"王园西畔接文溪，种竹临溪个个齐。\n剩有山阴三月趣，彩毫丽句吐红霓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3807,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题王氏水竹居 其三","author":"杨士奇","text":"国初耆俊满西昌，文采风流重二王。\n我忆为童随杖舄，筼筜谷里听琳琅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3808,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题王氏水竹居 其四","author":"杨士奇","text":"最忆琼台太守贤，早从林馆究微言。\n寻源曾溯羲文上，细论先天与后天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3809,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题王氏水竹居 其五","author":"杨士奇","text":"临澴千岁散枝繁，又到虹溪几叶孙。\n溪上森森皆玉立，只应诗句咏淇园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3810,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题王氏水竹居 其六","author":"杨士奇","text":"少日林泉共隐沦，披衣扫石荫晴云。\n前年重过嬉游地，亲见诗人咏五君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3811,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题王氏水竹居 其七","author":"杨士奇","text":"叨禄京华总白颠，天恩有典赐归田。\n煮茶亭上伴烧笋，更折长竿共钓鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3812,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题龙士郁竹","author":"杨士奇","text":"甘溪溪上绿猗猗，映日含风千万枝。\n最有一枝清似玉，春明开向凤凰池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3813,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹赠陈侍讲复职南京 其一","author":"杨士奇","text":"寻常去住难为别，况是平生心所亲。\n木落天寒岁华暮，白头人送白头人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3814,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹赠陈侍讲复职南京 其二","author":"杨士奇","text":"嗟君独去路漫漫，聊赠淇园玉一竿。\n莫厌两京频间阔，清风将比故人看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3815,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹寄本清良友 其一","author":"杨士奇","text":"往岁金陵城里住，竹阴相对话同乡。\n蓟门此日看图书，却望金陵别思长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3816,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹寄本清良友 其二","author":"杨士奇","text":"莫道寻常脩竹枝，贞姿白石共幽期。\n南京公馆多閒暇，时咏武公淇澳诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3817,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉和澹庵少保题梅花韵 其一","author":"杨士奇","text":"昔有故庐鸥渚上，东风绕屋看梅花。\n北京二十馀年住，几度披图倍忆家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3818,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉和澹庵少保题梅花韵 其二","author":"杨士奇","text":"万蕊千葩潋滟春，彩毫挥洒得天真。\n洛阳花品多堪画，不似罗浮迥绝尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3819,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉和澹庵少保题梅花韵 其三","author":"杨士奇","text":"画史皆明造化功，清江不与会稽同。\n古今吟咏多高致，岂必林家香影中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3820,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉和澹庵少保题梅花韵 其四","author":"杨士奇","text":"岁岁阳和独早回，含冰缀雪晃晴晖。\n向来止渴人皆重，太息调羹事久稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3821,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉和澹庵少保题梅花韵 其五","author":"杨士奇","text":"共爱开花擅早春，何分芰带与朝绅。\n玉堂金阁看尤好，不但疏篱野水滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3822,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题东禅老僧所藏陈举善小景","author":"杨士奇","text":"云所道人飞锡远，白云犹护旧禅房。\n向来聚得昆冈玉，长向林中起夜光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3823,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅送王琼玉致仕 其一","author":"杨士奇","text":"辞荣我羡王琼玉，赠以江南白玉花。\n此花开满西昌县，江上蒲帆应到家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3824,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅送王琼玉致仕 其二","author":"杨士奇","text":"收敛心情已息机，送行更咏白圭诗。\n归来纱帽笼头坐，莫遣流尘染素姿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3825,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"城南茅屋","author":"杨士奇","text":"韦杜城南尺五天，东风花柳醉歌前。\n岂如茅屋青松下，扫榻焚香抚七弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3826,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题常熟郭令梅","author":"杨士奇","text":"铁作根株玉作葩，含霜映月净无瑕。\n海虞县里清香满，不比河阳潘令花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3827,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题赵琬司业竹 其一","author":"杨士奇","text":"琅玕竹荫玛瑙石，桥门风致自銮坡。\n司成堂上咏淇澳，六馆诸生日切磋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3828,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题赵琬司业竹 其二","author":"杨士奇","text":"贤关一扫榛荆净，满目清风翠玉枝。\n成阴结实当自此，早晚云霄观凤仪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3829,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题廖监正山水","author":"杨士奇","text":"溪上好山青万仞，傍山临水结茅堂。\n扁舟载得纶竿过，不是吴乡定越乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3830,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题欧阳渤梅","author":"杨士奇","text":"莫叹冷官兼冷地，古人忧道不忧贫。\n一经分教繁昌县，日对梅花慕古人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3831,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题欧阳潘梅 其一","author":"杨士奇","text":"我家文节宋名臣，风节当时表缙绅。\n景仰前脩在贤辈，莫因词赋托骚人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3832,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题欧阳潘梅 其二","author":"杨士奇","text":"万里秋风蜀道难，绿袍西去作儒官。\n行装祗有梅花卷，须共冰霜阅岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3833,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅送刘子辉博士 其一","author":"杨士奇","text":"向来三县拥皋比，衿佩诜诜喜得师。\n贤关此去齑盐味，又学元和韩退之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3834,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅送刘子辉博士 其二","author":"杨士奇","text":"文江博士故多才，为喜亨衢特达开。\n九载相逢遽相别，临岐聊赠一枝梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3835,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅寄萧雅容布政 其一","author":"杨士奇","text":"螺川驿下雨丝丝，暮烛维舟话别离。\n满袖春风向江汉，南瞻黄鹤不胜思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3836,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅寄萧雅容布政 其二","author":"杨士奇","text":"回首分携四越春，江云海树梦频频。\n过鸿聊寄相思字，定对梅花忆故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3837,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄张信都督","author":"杨士奇","text":"十年不见张公面，万里桥边住锦城。\n玉帐牙旗拥兵卫，清风常对雪山清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3838,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题郑中书画像","author":"杨士奇","text":"芙蓉秋水粲奇姿，曾折云中仙桂枝。\n总向盛年观德业，春光正在凤凰池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3839,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴兴章郎中母挽诗 其一","author":"杨士奇","text":"碧桃庭馆四时春，珠翟云冠五福身。\n何用瑶池觅金母，水晶宫内有仙人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3840,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴兴章郎中母挽诗 其二","author":"杨士奇","text":"上堂甘旨皆推孝，主馈恭勤更让贤。\n八十年华随逝水，独留女范后人传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3841,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴兴章郎中母挽诗 其三","author":"杨士奇","text":"远道孤儿望白云，麻衣血泪湿纷纷。\n归来自有终天恸，况复啼乌不忍闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3842,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题郭公绪画","author":"杨士奇","text":"一卷苔藓坚贞操，千尺云霄挺特姿。\n尚有山林萧散意，南行相送寄相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3843,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题杨宗勖所藏赵仲穆小画 其一","author":"杨士奇","text":"茅屋溪山夐绝尘，青松长对老龙鳞。\n高情恐是王摩诘，骑马桥南访隐沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3844,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题杨宗勖所藏赵仲穆小画 其二","author":"杨士奇","text":"林外青山山下溪，白云翠浪晃荆扉。\n画图自是江南趣，身恋君恩独未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3845,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽诗 其一","author":"杨士奇","text":"诗书世积儗菑畬，孝友人传遍里闾。\n清代光华腾五色，凤凰池上凤凰雏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3846,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽诗 其二","author":"杨士奇","text":"荷衣兰袂青松下，亲见升平六十春。\n云海忽惊翔化鹤，吴淞风月属何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3847,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题周主事马 其一","author":"杨士奇","text":"五花粲粲雪霜明，休讶骐驎地上行。\n定是夜中精彩动，上干银汉射房星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3848,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题周主事马 其二","author":"杨士奇","text":"紫禁日高仙仗下，金羁随处得从容。\n满身云影疑浮动，知是天闲八尺龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3849,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题唐临绢本兰亭后有子昂画","author":"杨士奇","text":"祓禊兰亭三月初，流传翰墨世璠玙。\n吴兴绘事真兼妙，恨不挥毫到舞雩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3850,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题武昌陈氏荣寿堂 其一","author":"杨士奇","text":"高卧烟霞似散仙，春秋人羡伏生年。\n閒吹紫玉携黄鹤，来往三湘七泽边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3851,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题武昌陈氏荣寿堂 其二","author":"杨士奇","text":"九天鸾诰下林皋，五彩宫罗绣豸袍。\n荣寿堂中过百岁，日持仙醴荐仙桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3852,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题武昌陈氏荣寿堂 其三","author":"杨士奇","text":"坐分天禄荷天恩，赐帛年来屡到门。\n但比乾坤祝明圣，都将勋业付儿孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3853,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"侍游西苑应制 其一","author":"杨士奇","text":"万岁山连紫禁西，承恩吉日许攀跻。\n云霞光动龙蛇刻，遍看苍厓翠琰题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3854,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"侍游西苑应制 其二","author":"杨士奇","text":"琪树阴阴翠不分，瑶阶步步入青云。\n泥金壁涌沉檀气，先到延和殿里闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3855,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"侍游西苑应制 其三","author":"杨士奇","text":"金露玉虹相并立，方壶萧散对瀛洲。\n欲存峻宇千春鉴，长奉鸾舆万岁游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3856,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]