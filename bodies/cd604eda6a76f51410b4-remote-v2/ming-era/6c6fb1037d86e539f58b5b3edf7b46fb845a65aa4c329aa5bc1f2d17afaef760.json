[{"title":"行秀壁道中","author":"区怀瑞","text":"山扉献幽异，十步九攒青。\n常以崄为绝，不知空更灵。\n樛香云溜写，谷午日光亭。\n何俟桃花水，居然问采苓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寻青溪鬼谷洞","author":"区怀瑞","text":"石穷秀壁路，云擘几岩幽。\n积雪不知夏，新淙早欲秋。\n履綦尘梦断，枰局古仙留。\n纵许灵威过，应无龙女酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送西充李铨部赴阙六首 其一","author":"区怀瑞","text":"峨峨铜梁，上拂井络。\n东束夔门，北跨剑阁。\n石擘五丁，鼎峙三国。\n浚哲文明，光分于岳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送西充李铨部赴阙六首 其二","author":"区怀瑞","text":"剖岳出神，佐命惟人。\n玄圭素绂，青鹥黄麟。\n于岷之源，于渝之坟。\n因兹笃庆，玉友金昆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送西充李铨部赴阙六首 其三","author":"区怀瑞","text":"昆弟孔硕，令德炜炜。\n共捷南宫，逍遥云陛。\n华萼河阳，连镳并轨。\n或居柱史，或领驭士。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送西充李铨部赴阙六首 其四","author":"区怀瑞","text":"师济奋庸，论列在公。\n邦家之祯，以莫不崇。\n献替作猷，启事达聪。\n鹓鹭羽簉，君子所充。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送西充李铨部赴阙六首 其五","author":"区怀瑞","text":"惟彼天步，需材以掖。\n惟此简在，进贤是力。\n朝寀之间，阴阳消息。\n帝曰得人，予嘉乃绩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送西充李铨部赴阙六首 其六","author":"区怀瑞","text":"骙骙骖騑，将淩天阍。\n髦誉弹冠，国士衔恩。\n俾我药石，尝卑献尊。\n何以纻衣，刍荛之言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答张鹿垣","author":"区怀瑞","text":"筮仕得残甸，举世所唾弃。\n启居不遑恤，吾以遂吾志。\n闾左方黯惨，饷输更枯瘁。\n惊烽尽鸟窜，谍迹时麇至。\n金汤惟所画，经纬赅而备。\n图牒寓素心，索之在梦寐。\n三载枕一戈，千秋犹傲吏。\n晨登仲宣台，徒有昔人意。\n永兹兰茝言，宛其相位置。\n旷览晰古今，劳生耻忧悸。\n逝将赓郢歌，庶或附声气。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"扬兵有述","author":"区怀瑞","text":"我武更维扬，桃弧旧楚疆。\n井闾惊结束，服御倏腾骧。\n旗物风云换，虑无草木香。\n毂前虎盾固，戎右兔罝良。\n捲水飞双电，奔精落大黄。\n军声摇壁垒，杀气净堂皇。\n喑哑千夫废，枢机八阵藏。\n何须忧反侧，心慑尽遐方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34102,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐安寺早起","author":"区怀瑞","text":"骖潭松际寺，晓梵暂相宜。\n钵衲讵云冷，津梁幸未疲。\n鸟娇窥谷早，蜂煖钻窗迟。\n似破死心树，因生静者思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34103,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日酌荆门泉亭","author":"区怀瑞","text":"柏盏破春浮峭青，云开城角即山亭。\n冰心还向坐中见，世法且于泉外听。\n幸有骚坛堪命主，但逢胜日莫教醒。\n磨厓沉碣千年事，陵谷那支此聚萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郢中怀古二首 其一","author":"区怀瑞","text":"旧苑莺花久巳残，细腰广袖忆朱阑。\n城边远水多秋气，台上雄风作夏寒。\n二广干戈愁复问，三闾词赋妒相看。\n今逢圣世藏弓地，不数长安有露盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郢中怀古二首 其二","author":"区怀瑞","text":"方城汉水旧城池，曾是先王命履綦。\n敛缴未加云上雁，阻兵宁负泽中麋。\n楩楠杞梓名相亚，猿鹤沙虫化更疑。\n不见武关三户怨，亡秦张楚总因时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宋玉井","author":"区怀瑞","text":"文心若流水，千古道犹真。\n习坎冰停处，虚坛瀣露新。\n常忧绠素断，已觉甃花湮。\n莫照墙东影，三年未许人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白雪亭二首 其一","author":"区怀瑞","text":"恍惚莺声在碧苔，欲浇酃渌觅蒿莱。\n若言郢曲无人和，已遣先春百舌催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白雪亭二首 其二","author":"区怀瑞","text":"铜鐎一夜响千山，风雨氛熸尽百蛮。\n谁向巴渝赓白雪，雕坛元在紫云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"解佩亭","author":"区怀瑞","text":"解佩亭前秋复秋，潏香不断汉云流。\n似缘投玦江中尽，皋上应无神女游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"子胥台","author":"区怀瑞","text":"楚国何堪有二胥，酬心赠别竟相如。\n可怜逢掖三千士，不似东南杂霸馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石城乐六首 其一","author":"区怀瑞","text":"寄书汉阳艑，郎停在何处。\n最恨鲤鱼风，吹郎过江去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石城乐六首 其二","author":"区怀瑞","text":"楚水日千里，飘香兰蕙丛。\n波心无一折，端自为吴侬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石城乐六首 其三","author":"区怀瑞","text":"墐著上囊口，从教蘋末吹。\n成飔不成籁，只有寸心知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石城乐六首 其四","author":"区怀瑞","text":"常年汉水发，槎绕石城流。\n今夕蒹葭没，应无南雍州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石城乐六首 其五","author":"区怀瑞","text":"莫耽宜城酝，留醉楚天晓。\n昨夜夫蓉花，梦杀鸳鸯鸟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石城乐六首 其六","author":"区怀瑞","text":"凭将锦襜褕，绝意游南浦。\n感君明珠赠，不忍遇交甫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日看治田舍","author":"区怀瑞","text":"布谷晓周遭，春阴梦寐劳。\n扈人喧旧陌，馌妇饷东皋。\n楚俗思篮辂，豳风咏索绹。\n何须听丁许，映日剪蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洗竹","author":"区怀瑞","text":"洗竹有深趣，泠然秋露中。\n却尘能绝径，泛碧不因风。\n粉落争枝鸟，烟清篆叶虫。\n军持何用借，无净本来同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观采野","author":"区怀瑞","text":"啄耜□□□，于人哀更深。\n岂缘半菽饱，宁作一芹心。\n率土皆炊玉，高天不雨金。\n无能持末劫，寇旱日相侵。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏斋前牡丹","author":"区怀瑞","text":"玉阳聊与殿春残，冷砌何知选药阑。\n梦入笔床惟汝共，影回酒盏几人看。\n轻阴不护青罗缬，艳露应凝紫玉盘。\n莫忆沉香好亭子，偶来花县一微官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉枝篷熊彬之夜坐","author":"区怀瑞","text":"壶公如可寻，永夜栝枞阴。\n庭月漾于水，篱花光似金。\n吏情付云柝，山意感风琴。\n乞子清泠散，醒予热世心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送熊生硎初入堆蓝书碑","author":"区怀瑞","text":"砻云第几层，欲往未之能。\n以我有为法，传君无尽灯。\n镌来蓝顶玉，何异剡溪藤。\n觅得前身慧，分香与定僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仙女岩","author":"区怀瑞","text":"双真不可留，岩挂九峰幽。\n藓落千年雪，松先五月秋。\n壁扉通玉井，云盖想丹丘。\n何事龟台上，飙车已十洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寇后经慈化寺","author":"区怀瑞","text":"漳澨隐孤寺，沮光浮翠侵。\n客行花雨际，僧卧筱烟深。\n怖鸽晓还集，惊乌夜不禁。\n谁能灰寇火，更布给园金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阅城操","author":"区怀瑞","text":"古人重设险，叠石岂徒然。\n计以守常逸，须令瑕者坚。\n河山新百二，组练昔三千。\n势夺临冲上，机閒雉堞先。\n九旗云外缀，万炬斗边悬。\n晓夜笳铙改，风霆矢石传。\n生心知画地，传翼敢登天。\n今日龙渊引，无烦墨翟贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望郢中寇火二首 其一","author":"区怀瑞","text":"积劫自天地，胡然怨燧人。\n九阊变云物，千里走烟尘。\n彗出非三舍，薪传尽四邻。\n年来惊野烧，多为乱其真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望郢中寇火二首 其二","author":"区怀瑞","text":"搴兰亵台上，抱玉烬山阿。\n古戍狼烽少，平林燕垒多。\n有途怨薪桂，无地隐烟萝。\n欲向寥天问，终悲隔燄摩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遣谍","author":"区怀瑞","text":"壁上传来信，真符乃不如。\n事危知目动，心急是言徐。\n露积三年后，风惊百战馀。\n古人善用间，吾岂示之虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入岨寻洗耳庵二首 其一","author":"区怀瑞","text":"紫尘扰扰候峣关，轺客留书也不閒。\n纵有曲沮堪洗耳，未应充隐许由山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入岨寻洗耳庵二首 其二","author":"区怀瑞","text":"松风洗烟无不尔，藓花纷纷委云紫。\n欲呼石上古先生，为问何年冷香此。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沮上遇雨口号二首 其一","author":"区怀瑞","text":"雨洗颓峰复几尖，却将松顶挂岩檐。\n乘流莫放阳坪筏，一夜沮青拍岸添。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沮上遇雨口号二首 其二","author":"区怀瑞","text":"沮上稠云懒不飞，随风化作雨工衣。\n汉阴抱瓮休相笑，紫盖峰头叱驭归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜雨","author":"区怀瑞","text":"七泽总如焚，兰萧每不分。\n虎饥方傅翼，魃虐乃为群。\n赤社鞭雷鼓，雩坛瘗玉□。\n灵湫金潋滟，仙井碧氤氲。\n秀壁开龙女，夷城泛廪君。\n瓶倾马鬣水，旗捲炮车云。\n破块看朝隮，来苏喜夕曛。\n沦流循楚望，沾洒到江濆。\n电火燎原熄，王师下濑闻。\n何当洗兵甲，归凯鹤鹅军。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"骤雨玉枝篷住","author":"区怀瑞","text":"急溜写山湍，空阶起夕澜。\n风镫屡明灭，云漏几摧残。\n散帙窥还湿，纤絺著更寒。\n漂摇方此际，谁竟一枝安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿玉阳城西楼","author":"区怀瑞","text":"降割固无象，搀抢复荆路。\n鸺鹠千万声，洒血从三户。\n汉广不可泳，投鞭途焉度。\n狼烽络绎至，羽檄纵横鹜。\n保此人如斗，疮痍未成聚。\n壁垒信改观，设险非其故。\n重闬虽有托，被野谁能护。\n恍忆弦诵音，笳鼓喧朝暮。\n檐露警铜鐎，堞月迟余步。\n遥夜陟屺思，登楼讵遑赋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再宿城西楼","author":"区怀瑞","text":"楼居二十载，气与星辰接。\n卑薄于一切，俯仰得静业。\n今来沮漳澨，遗搆因□嶪。\n设险信改观，渠堑而传堞。\n挥戈感天地，刺石厉恇怯。\n枕戟在炎夏，寒序遂经涉。\n橹盾久托栖，霜露或沾浃。\n寇烽夕千里，想作云梦猎。\n莽莽虎豺忧，振之若秋叶。\n明发慰自兹，一月而三捷。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨夜待寇信","author":"区怀瑞","text":"岋屹孤城夜，凄迷风雨心。\n轻师侦未返，重地寇能深。\n远火多飙举，高畬遂陆沉。\n吹笳知未散，横槊愧长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寇涉沮而东蹑之不及","author":"区怀瑞","text":"炬云千万缕，来往若乘风。\n赤散渚宫北，青归沮水东。\n侦流饮马去，窥垒语乌同。\n纵有遗俘在，何堪论战功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠避寇二首 其一","author":"区怀瑞","text":"谁解兵戈有息机，魂销往事但惊飞。\n人民城郭今无恙，几月辽东鹤一归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠避寇二首 其二","author":"区怀瑞","text":"誓报恩私国士风，绝缨元在楚王宫。\n溃围但负季芊出，日暮双鞬渊市中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"巩玉楼与曹济之夜话","author":"区怀瑞","text":"百堞流云几共听，铜鐎吹恨梦频醒。\n闻因夕籁心偏远，话入名山眼渐青。\n屈戌隐香披古帙，罘罳笼玉照新醽。\n更寻周易超无象，未及秦灰是此城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34142,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜延熹楼","author":"区怀瑞","text":"槛外城乌寂不飞，沮漳东望转熹微。\n林端月引青藜杖，石上云搴白叠衣。\n久客尺书添往恨，谁家杼轴罢新机。\n流亡正想哀鸿集，一听铜鐎万事非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34143,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柘弓行赠李武生锐","author":"区怀瑞","text":"赠君柘弓五石劲，黏贴角端得其正。\n焦金尺镞柳云笴，雕隼之间唯所命。\n此弓本合静氛尘，蜮吹狐跳宁足云。\n九枝岛下栖妖日，三箭天山定异人。\n狼星落地如飘瓦，罢敝六军奔万马。\n相逢一矢未加遗，岂是楼烦因暗哑。\n君之绝射古莫传，蹲甲应居养叔前。\n试想十方避鸣镝，只听辟历擘鹍弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34144,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"棳刀石","author":"区怀瑞","text":"秦王宝刀閟瑶岑，寒光错落霜花深。\n金环玉靶久磨缺，划得秋烟紫翠沉。\n时平锈蚀无能识，镔钢入土同沙砾。\n转思叱咤风霆间，提携之人岂人力。\n徵兵四海今怨嗟，杀机隐隐动龙蛇。\n京观皑骨真何罪，血漂盗杵盈污邪。\n英雄作合羞遗址，眼明手快黄尘里。\n方城汉水不足依，况复长林称弹子。\n文无那用藉吴钩，掇此堪销万里愁。\n鸊膏倘拭休徵赠，鹊化先资忠孝侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34145,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"官垱鬼哭行","author":"区怀瑞","text":"碧燐荧荧照原野，酸风夕起官垱下。\n土囊哆□狸狗吹，腥尘扑地如奔马。\n杜宇春魂招不得，训狐有血宁堪洒。\n乘除积劫运固然，借问啁啾胡为者。\n忆自刘石洗戈鋋，沮漳生聚且百年。\n神宗垂拱久临御，烽埃不动茅檐前。\n南关女真沸辽海，欃枪北划稽胡天。\n援兵糜饷日围竭，坐令万姓相烹煎。\n关西寇盗不满百，厥初半是溃逃卒。\n弯弓内儗力有馀，才向奴锋心胆怵。\n圣朝恢复往代殊，偾辕失律忧师出。\n何事辽东浪死歌，逋租避役争倡率。\n偏袒一呼千万群，揭竿已是貔貅军。\n张角天公三十六，尤来铜马遥相闻。\n两河三晋尽注镝，龙蛇起陆扬妖氛。\n气吞城邑势破竹，平驱骡马如风云。\n繇来捕讨多朒缩，一任鸱张而鸷伏。\n歼渠宥协炳日星，今乃背之为抚局。\n逍遥岁月老吾师，脱巾庚癸方追逐。\n五丁石栈为寇开，假以翼飞因择肉。\n虎冠驱众助暴横，吴头楚尾悉弄兵。\n云梦之间泽量骨，渠血遂与沧浪平。\n金钱钜万远调募，骄称蹑贼以为名。\n村囤洗刷无居人，人寻残骼皆吞声。\n汛扫程功徒锲急，封章讵许誇零级。\n鲸鲵谁知京观恩，不辜横草相波及。\n十秋过者指盗丘，閟有精灵难啜泣。\n杜回混寇更混兵，伯有何归复何立。\n似兹兵寇总为殃，楚些无能慰国殇。\n瞑去分身还四大，且须戴首诉云阊。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34146,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"走笔云杜乞王幼度刺史磬口蜡梅","author":"区怀瑞","text":"仙人作令梅花村，雪香日日披泉源。\n烟霞十载卧云杜，千株万株写梅园。\n我来奔车汉水曲，却笑灌园机不足。\n玉丛冰窖漫经过，恰值松房春酒熟。\n恍惚已是姑射居，飞云顶上觅精庐。\n踏溪弄影皆千叶，宝光五色层相于。\n此际春镫且莫然，此时璧月照初筵。\n啁嘈翠羽作良夜，醉乡蝶梦徒翩翩。\n楚越之吟无不可，欲护洛幡迷处所。\n嚣埃判隔巳经年，惟有城头候烽火。\n襭黄缀枝繁更新，乞我远寄山中人。\n丹砂云母真无赖，蜡遍空山一夜春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34147,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"青溪送李元毓还荆山","author":"区怀瑞","text":"花覆青溪酒欲波，美人不驻奈愁何。\n山灵只合供仙掌，地主无能赋女萝。\n鬼谷庋书嫏洞底，仲宣遗榭碧岩阿。\n枕流洗耳非吾事，为听奚囊白雪歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34148,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杪秋送族子几倩兼寄罗康世何日美","author":"区怀瑞","text":"沮漳秋月印波光，别去犹悬玳瑁梁。\n千里心期虚绾结，十年眉黛忆清扬。\n频侦玉岫烽烟遍，归访珠林道路长。\n若问城头冰雪影，侏儒方朔总空囊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34149,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王象鼎还江陵","author":"区怀瑞","text":"三年栖息玉山岑，别泪应丹枫树林。\n作客总怜痴令冷，论交全识古人心。\n分罂欲赠无馀粟，去榻虽悬不愧衾。\n非是逢君话乡土，微官几月早抽簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34150,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠黄非文","author":"区怀瑞","text":"颢气木淋漓，谁收到墨池。\n丹青从客老，笺素发君奇。\n听濑辞三澨，寻云迹九疑。\n凯之天具足，时俗莫教痴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34151,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄非文梁云国南还","author":"区怀瑞","text":"曰归珠树林，并驾两仙禽。\n好脱烽烟苦，宁知霜霰深。\n浦筠低点泪，洲橘晚垂阴。\n将子采秋碧，先予揽撷心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34152,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虏陷昌平二首 其一","author":"区怀瑞","text":"上谷千年戍，黄花六月天。\n金笳吅绝壁，雪帐漫平川。\n苦战知锋尽，孤城岂瓦全。\n四郊多垒日，驱掠任腥膻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34153,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虏陷昌平二首 其二","author":"区怀瑞","text":"万马入何处，千牛备不胜。\n北来资刈获，南下习炎蒸。\n力屈居庸塞，心摧十二陵。\n开明群虎豺，天险岂能升。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34154,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻宁武山寇破湘中诸县","author":"区怀瑞","text":"江汉氛祲入，三湘更滞淫。\n梦魂依桂峤，泪血染枫林。\n虎落凄风过，蛇丘毒雾深。\n经年鱼雁断，摧折望乡心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34155,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]