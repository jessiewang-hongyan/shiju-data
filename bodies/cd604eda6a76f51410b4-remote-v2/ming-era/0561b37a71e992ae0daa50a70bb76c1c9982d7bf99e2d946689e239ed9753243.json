[{"title":"少传期集琪林徐道士馆得青字","author":"黎民表","text":"采药何时返，乘风此暂停。\n入门桐树长，到院薤丛青。\n碧海藏城市，瑶坛见日星。\n过逢元胜侣，能为写黄庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"心远亭听陈公载弹琴","author":"黎民表","text":"阮公操绿绮，梧竹对高閒。\n白雪流深壑，夕阳明远山。\n幽襟散物外，馀响出林间。\n兴到悠然处，披襟未拟还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送谷子迁还姑苏","author":"黎民表","text":"万里寻师去，沧波肯暂留。\n岭云经古寺，江路入新秋。\n瑶草应堪拾，丹砂不易求。\n归逢明处士，沽酒话罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘仙坛","author":"黎民表","text":"坐出千林杪，坛荒累劫馀。\n烟霞归内景，天地入蘧庐。\n白石留禽戏，苍筠篆鸟书。\n无能探蕊笈，归路独踟蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱子庵","author":"黎民表","text":"灵飞超浩劫，珍馆寄幽寻。\n水引山门远，云藏涧户深。\n青精堪度世，白日此修心。\n洞口风雷起，鸾笙下翠岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄子书堂","author":"黎民表","text":"白业留孤墅，青山蔽数椽。\n鸟曾迎木客，花更挹蒲仙。\n瓢挂县萝壁，茶烹涤砚泉。\n犹疑散发处，长诵紫苔篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春张考功助甫邀游韦氏园时梁舍人思伯偕至 其一","author":"黎民表","text":"远眺山河尽，孤吟水竹偏。\n高云搀树密，野日避花鲜。\n径石欹相带，岩房曲对悬。\n贪奇收客泪，留醉夕阳边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春张考功助甫邀游韦氏园时梁舍人思伯偕至 其二","author":"黎民表","text":"胜事传韦曲，幽寻我辈能。\n临风觞酌缓，落日兴情增。\n画壁逢僧问，丹梯引蔓登。\n故侯应不贱，瓜地有东陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5446,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春张考功助甫邀游韦氏园时梁舍人思伯偕至 其三","author":"黎民表","text":"大野临燕赵，跻攀意自豪。\n云沙千堞暗，松柏五陵高。\n西日愁相对，南音醉懒操。\n菟裘无处所，弥觉此生劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5447,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春张考功助甫邀游韦氏园时梁舍人思伯偕至 其四","author":"黎民表","text":"脱帽当松顶，移舟傍竹阴。\n岂知青琐客，还有绿萝心。\n思苦诗篇警，情忘酒盏深。\n寥寥山吏部，千载此知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5448,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春张考功助甫邀游韦氏园时梁舍人思伯偕至 其五","author":"黎民表","text":"林壑晚逾胜，风尘远暂忘。\n物情嫌肮脏，吾意在耕桑。\n败叶虫行篆，浓花密占房。\n浮生堪浊酒，穷远任苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5449,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春张考功助甫邀游韦氏园时梁舍人思伯偕至 其六","author":"黎民表","text":"列岫当空倚，三峰近席攒。\n碧滋苔藓色，阴益石池寒。\n日费壶中药，天遗象外观。\n却疑幽绝处，堪挂野人冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5450,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春张考功助甫邀游韦氏园时梁舍人思伯偕至 其七","author":"黎民表","text":"海柏南方得，名花上苑移。\n露添垂径实，风亚出墙枝。\n采摘情都尽，飞腾意转迟。\n芳菲应可惜，停骑待成诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5451,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春张考功助甫邀游韦氏园时梁舍人思伯偕至 其八","author":"黎民表","text":"布地千金积，邀欢一径开。\n花光摇解佩，荷气送行杯。\n水蹙昆池动，云移碣石来。\n飘零犹壮观，肯作雍门哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5452,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春张考功助甫邀游韦氏园时梁舍人思伯偕至 其九","author":"黎民表","text":"芳园争倚并，幽事此中多。\n时序花飞甚，身名老去何。\n天遥金马署，星动白鸥波。\n我去寻黄绮，相思在薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5453,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过姚上舍伯子草玄亭","author":"黎民表","text":"怜君花树下，复有草玄亭。\n山色墙头出，宫云雨后青。\n听莺移远杖，相鹤检仙经。\n谁测风尘里，沈冥有客星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5454,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"官舍杂咏 其一","author":"黎民表","text":"多病年方觉，清斋日颇长。\n槐阴閒闭閤，竹榻静焚香。\n宿鸟争移树，疏花不过墙。\n幸无尘牍扰，幽事足徜徉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5455,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"官舍杂咏 其二","author":"黎民表","text":"怀绂初为吏，修心未到僧。\n流年穿木榻，长夜伴灯檠。\n懒出从题凤，慵书误画蝇。\n款门逢酒伴，胜饮玉壶冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5456,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"官舍杂咏 其三","author":"黎民表","text":"兰省虽清秘，蓬扉自泬㵳。\n编篱多绿槿，间树出红椒。\n客至常班草，觞馀自挂瓢。\n茹芝聊复得，空费鹤书招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5457,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"官舍杂咏 其四","author":"黎民表","text":"不堪驱世事，祇足称閒居。\n叩齿清朝过，科头累月馀。\n墙隈常置笔，帐内苦无书。\n虽羡侏儒饱，终年免负锄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5458,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"官舍杂咏 其五","author":"黎民表","text":"知有看花约，春朝更不眠。\n盖多从雨借，屐自上山穿。\n得俸宁供醉，谋生亦任天。\n校量终岁里，常在习池边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5459,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"官舍杂咏 其六","author":"黎民表","text":"官箴浑不解，侠气顿能销。\n素发嗟垂领，红尘屡折腰。\n世情飞絮过，乡思断蓬飘。\n为甚抽簪未，山中少药苗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5460,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"官舍杂咏 其七","author":"黎民表","text":"灌园常不仕，沿牒偶为官。\n夜宿芸香阁，朝看苜蓿盘。\n草玄能尚白，鍊骨未成丹。\n终拟藏名去，墙东老鹖冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5461,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"官舍杂咏 其八","author":"黎民表","text":"潦倒时堪弃，清狂自懒医。\n生涯千日酒，岁课五言诗。\n倚树常趺坐，逢人或解颐。\n汗青吾岂敢，赖有子云知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5462,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"官舍杂咏 其九","author":"黎民表","text":"虽然称校理，笔研久生尘。\n白虎多同异，金门自隐沦。\n桂薪从度日，榆荚又残春。\n斟酌浮生理，须寻漉酒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"官舍杂咏 其十","author":"黎民表","text":"高枕从吾拙，卑栖乐性全。\n岂无洴澼计，不受绨袍怜。\n野客犹分俸，当垆更觅钱。\n管弦何处乐，夜夜似西天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5464,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"官舍杂咏 其十一","author":"黎民表","text":"红叶侵阶出，青枫夹陛飞。\n春风开紫阁，月朔拥朱衣。\n端拱封书少，清关接士稀。\n惊心垂象下，江海客星微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5465,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"官舍杂咏 其十二","author":"黎民表","text":"故山多胜绝，归梦不须占。\n竹长成高格，松青坠古髯。\n种园芝自给，煮石火频添。\n何日抛簪绂，迎暄在短檐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5466,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同吴明卿游大觉庵","author":"黎民表","text":"风尘不入寺，花木自为林。\n赤日清凉地，青山吏隐心。\n古藤垂屋角，独鹤占松阴。\n车马长安客，谁能向此寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5467,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张肖甫宅饯别高右丞伯宗得杯字","author":"黎民表","text":"长安残雪后，复共故人杯。\n挥手关山远，离心岁月催。\n楼船过澧浦，羽猎上京台。\n应念游梁客，金茎首重回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5468,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张肖甫洪从周过款山房","author":"黎民表","text":"天涯殊物候，犹未换春衣。\n花事看将半，故人逢渐稀。\n过云传旅雁，乘月启山扉。\n幸有尊中酒，能忘赋式微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5469,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同肖甫夜宿龙华寺 其一","author":"黎民表","text":"曲水通龙沼，荒塍次鹿园。\n风尘湖外断，云气岛中鶱。\n静院鸟双下，寒檠客对言。\n谁知朝市里，丛桂得扳翻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5470,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同肖甫夜宿龙华寺 其二","author":"黎民表","text":"相期禅客话，高枕白云层。\n月色千江水，山门七祖灯。\n钟声散落叶，壁影挂寒藤。\n欲续良宵兴，尘劳恐未能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5471,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郭山人次甫从东海来将游北海留止轩中因赠 其一","author":"黎民表","text":"双屐带莓苔，新从日观来。\n山川游子梦，风雪故人杯。\n龙性应难驭，鸾情不易媒。\n莫言成独往，高浪驾蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5472,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郭山人次甫从东海来将游北海留止轩中因赠 其二","author":"黎民表","text":"采药三年别，乘风万里游。\n可怜丛桂约，又过菊花秋。\n大梦君先觉，多岐古所尤。\n鲁连空蹈海，何似驾苍虬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5473,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈侍御道襄招朱陈二使君同集","author":"黎民表","text":"双凫犹暂驻，骢马复同游。\n入夜城阴静，将春雪意收。\n月曾千里共，兴作两宵留。\n何处吟庄舄，凄风起凤楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5474,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"溪南别业为万考功言卿赋 其一","author":"黎民表","text":"自有山林性，能将物我齐。\n剪茅成野径，披荔待幽栖。\n辋口茱萸沜，芳洲杜若溪。\n何当接衡宇，琴酒日相携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5475,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"溪南别业为万考功言卿赋 其二","author":"黎民表","text":"日暮鸣桡去，溪流几许深。\n自随明月往，应少世人寻。\n水石含幽意，鱼凫识赏心。\n漆园元寄傲，何事挂朝簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5476,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"溪南别业为万考功言卿赋 其三","author":"黎民表","text":"凭眺因高尽，虚明与水宜。\n绿萝垂雨幄，丛筱罥风丝。\n岛屿通桃径，壶觞到习池。\n因知竹林下，不减上皇时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5477,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"溪南别业为万考功言卿赋 其四","author":"黎民表","text":"昔年云卧处，尚有读书台。\n墨沼鹅群浴，苍苔鸟迹开。\n洞门扃馆宇，涧户出风雷。\n谁识东山意，曾招隐士来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5478,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"姚元白以玉华石见遗兼枉高篇奉答一首","author":"黎民表","text":"幔亭一片雪，迢递削孤峰。\n云壑有千态，丹梯知几重。\n瑶华君辍赠，金简我遭逢。\n好驻壶中景，他年炼玉容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5479,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同思伯携酒访文寿承辞以事弗果文有诗见贻和答一首","author":"黎民表","text":"长安才日下，犹阻使人来。\n便欲笼鹅去，空成骑马回。\n寻盟须夜雪，留兴待春杯。\n莫谓青毡冷，东风有落梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5480,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和徐子与答郭次甫折梅相赠之作","author":"黎民表","text":"何处来芳讯，春风把一枝。\n薄云千涧暝，深雪独行时。\n策杖香随至，开尊影倒窥。\n罗浮虚月色，此地有佳期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5481,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同子与过善果寺访吴约卿时濮阳二苏在席得台字","author":"黎民表","text":"称心游野寺，携赏上春台。\n日色催停骑，花枝笑举杯。\n吏閒方外得，山好雪中来。\n暂过虽乘兴，翻成倒载回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5482,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中同约卿过子与","author":"黎民表","text":"出关愁日暮，踏雪喜新晴。\n酒挹青骢客，诗传白雪声。\n径花沾湿重，檐溜滴阶平。\n此日冲寒兴，还因下榻名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5483,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十三夜过苏子川兄弟","author":"黎民表","text":"残雪留寒在，空庭占月多。\n玉珂停上客，红袖拂清歌。\n劈杏调香酪，分杯试海螺。\n谢家兄弟好，邻并忝羊何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5484,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆归","author":"黎民表","text":"久客念将归，重嗟筋力违。\n蘼芜长送客，荷芰未裁衣。\n白首贫交少，青山旧业微。\n伤心同海燕，懒向画梁飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5485,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓经西苑","author":"黎民表","text":"玉树晓青苍，琼花接混茫。\n回风吹雨气，曲磴落云光。\n薜荔摇珠网，芙蓉暗石房。\n鱼龙无秘戏，双鹢锁朦廊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5486,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送江山人游岱岳","author":"黎民表","text":"暂拂缁尘去，将扳岳顶行。\n布裘经雪绽，藜杖入山轻。\n奇字扪萝识，新诗望日成。\n路人惊骨异，疑是羡门生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5487,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过范子宣得山字","author":"黎民表","text":"解鞍寻竹下，逸客况同攀。\n一榻成云卧，双轮对雪山。\n笼鹅方点翰，贳酒且开关。\n城市逃名得，扁舟未羡閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5488,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送董孟材","author":"黎民表","text":"燕台收暮雨，杨柳变繁阴。\n以我思乡泪，知君久客心。\n云门攀岳近，汶水到家深。\n羽猎看成赋，高标在桂林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5489,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同尹王二僚长夜直禁中","author":"黎民表","text":"偶同金马客，儤直凤凰城。\n景气浮琼岛，春星丽玉衡。\n缭垣疏树色，曲水细流声。\n独夜难成寐，斋心捧大明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5490,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同杨邦彦徐子与过汝和雪舫集","author":"黎民表","text":"芳菲不可度，幽意与谁论。\n夜雪留孤舫，春花入酒尊。\n风尘容倦客，湖海共清言。\n兴罢各分手，青山落蓟门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5491,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"韦园别子与得谈字","author":"黎民表","text":"宾御促征骖，离觞且共衔。\n春风吹杜若，野日上松杉。\n郡外嵩高色，尊前史汉谈。\n竹林吾党在，何必羡江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5492,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张玄超诸子集借树轩得春字","author":"黎民表","text":"门多车马尘，行径且逡巡。\n沧海风期在，长安冠盖新。\n燕来茅屋雨，花暗玉河春。\n莫厌尊中酒，青山别故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5493,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送盛少府烈忠还长兴","author":"黎民表","text":"金门逢傲吏，知住五湖浔。\n洞壑苍山远，云门下箬深。\n钓舟移柳浪，茶具在花阴。\n倘遂抽簪兴，双凫共入林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5494,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次甫将游北岳有期复过轩中同作","author":"黎民表","text":"将还沧海上，复共草堂眠。\n药笼金鹅蕊，藜灯白雪篇。\n浮沈官自拙，肮脏尔相怜。\n三径容归去，何须问俸钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5495,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送梁思伯使云间兼归岭南","author":"黎民表","text":"尊酒促鸣珂，云间拥传过。\n王程千里远，秋色五湖多。\n拜手辞金阙，淹情寄绿萝。\n乡心将去雁，随尔渡关河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5496,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李伯承张玄超月下过轩中","author":"黎民表","text":"竹簟因风敞，萝衣过雨披。\n故人来此夜，词客况同时。\n坠叶惊风早，归禽选树迟。\n烦襟何用涤，玄论自相宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5497,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"省中即事","author":"黎民表","text":"蹉跎成白发，不敢叹为郎。\n饱食知才忝，高眠苦日长。\n渴思金井冻，坐恋玉墀香。\n不记频来往，藤花又过墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5498,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈子野之崇仁","author":"黎民表","text":"荣君非薄宦，所贵在经奇。\n山续匡君传，亭寻孺子碑。\n行藏多任性，词赋不逢时。\n会看双龙气，冲腾向赤墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5499,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送梁彦国之滦州","author":"黎民表","text":"击筑悲难尽，挥杯路向分。\n山藏到海郡，树引入关云。\n才大人称屈，时明主好文。\n白麟奇木对，前席待终军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5500,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李仲连任赵藩审理","author":"黎民表","text":"桐叶随王命，丹书遣侍臣。\n出关迎紫气，飞盖起黄尘。\n树拥丛台月，花馀邺水春。\n从来豪侠地，授简尚词人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5501,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"招姜主客宗孝王杜二舍人王项二文学吴沈刘居四山人集借树轩 其一","author":"黎民表","text":"蓬径留嘉赏，风尘得友生。\n白云窥夜酒，明月照乡情。\n叶应孤砧响，星浮万堞平。\n岁华空荏苒，莫厌管弦声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5502,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"招姜主客宗孝王杜二舍人王项二文学吴沈刘居四山人集借树轩 其二","author":"黎民表","text":"帝乡星渐改，燕谷暖还遥。\n心事邀欢尽，年华赖酒销。\n花枝随起舞，月色破孤寥。\n聚散浮生易，难忘是此宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5503,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同王仪甫过水塘庵","author":"黎民表","text":"入寺已昏黄，纱灯照上方。\n寒冰胶积水，清梵响空廊。\n颂酒襟期洽，怀山梦寐长。\n不辞风雪夜，携手共云房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5504,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得张广平助甫书","author":"黎民表","text":"经年传尺素，入手泪纵横。\n白发生乡国，秋风到郡城。\n著书千古事，作吏众人名。\n谪去方年少，怀沙莫怆情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5505,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨","author":"黎民表","text":"短日仍多雨，轻飞似暗尘。\n病逢寒食夜，书寄故乡人。\n节物频年异，衣冠后会新。\n圣朝容拙宦，又过五陵春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5506,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]