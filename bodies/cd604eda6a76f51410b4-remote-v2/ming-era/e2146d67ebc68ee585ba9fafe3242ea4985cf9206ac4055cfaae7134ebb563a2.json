[{"title":"春日登伏牛山遥望秦中因忆栗士学冯汝言二方伯李廷实大参莫子艮廉宪姜宗孝纪恒甫二宪副","author":"谢榛","text":"伏牛形胜郁嶙峋，二月风光客兴新。\n半岭夕阳惟照雪，千松寒色不知春。\n天连山势全雄晋，地转河流远界秦。\n寄语关中几游宦，虞卿秪是著书人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同乡程子宾丁卯春以广东大参擢山右廉宪及夏仍转广东右方伯戊辰春罢官北归两年之间往复万里殊为可叹赋此寄怀","author":"谢榛","text":"二十年前尚宝卿，一官万里去来程。\n海天欲尽东南地，乡国遥悬旦暮情。\n鸥鸟斜阳随野钓，杏花微雨促春耕。\n翻嫌薇省殊多事，旧侣相过几送迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送萧逸人归永丰","author":"谢榛","text":"久客天涯鬓欲皤，西江归去一渔蓑。\n香垆峰外烟云合，石鼓潭边雷雨多。\n素月三秋黄鹤梦，清风千古紫芝歌。\n山窗幽寂谁相伴，随意鸣琴向薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春有感","author":"谢榛","text":"世故悠悠鬓易华，岁时多病转堪嗟。\n小园春上蘼芜色，古道风吹杨柳花。\n黄鸟独鸣纷旅思，白云无定寄生涯。\n狂歌忽忆当年事，月满长安醉酒家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋暮书怀","author":"谢榛","text":"木落风高万壑哀，山川纵目一登台。\n夕阳满地渔樵散，秋水连天鸿雁来。\n白发无情淹岁月，黄花有意照樽罍。\n西园公子虚陈迹，词客于今说爱才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠刘羽士","author":"谢榛","text":"一出樊笼万事违，满天风送薜萝衣。\n青藜杖外烟霞色，金液方中造化机。\n穷海泛舟蛟自避，深山采药鹤同归。\n知君已有仙人骨，应待王乔汗漫飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋宴集","author":"谢榛","text":"满空华月好登楼，坐倚高寒揽翠裘。\n江汉先翻千里雪，桂花香动万山秋。\n黄龙塞上征夫泪，丹凤城中少妇愁。\n词客共耽今夜酒，谩弹瑶瑟唱伊州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮雨","author":"谢榛","text":"忽漫浓云西北生，斜风骤雨入重城。\n大川波动鱼龙气，空谷雷搜水石精。\n阮籍感时心独苦，杜陵忧国意难平。\n万家暝色孤灯外，弹剑长歌此夜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同潭公登望湖亭","author":"谢榛","text":"孤亭缥缈碧天空，岩壑长鸣万树风。\n湖色微茫秋草外，山光黯澹暮烟中。\n静缘老去逢禅侣，生计年来拟钓翁。\n莫讶疏狂词赋客，沧洲白鸟自相同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答夏良臣见寄","author":"谢榛","text":"拾遗曾客锦官城，独擅当时大雅声。\n老我漳南还作赋，嗟君淮北久知名。\n严霜苦雪松心古，片月长江鹤梦清。\n潦倒同怀不同醉，天涯徒有报书情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"涌金亭晚酌","author":"谢榛","text":"山亭下瞰碧潭空，天际云霞落镜中。\n千古神蛟吞夜月，九皋灵鹤振秋风。\n许由颍水心何逸，庄叟濠梁意自同。\n寄迹乾坤须纵酒，不妨醉卧荻花丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曹茂才希孟迁居","author":"谢榛","text":"灯下书生山月斜，夜深清梦到梅花。\n树头黄鸟阳春巷，屋角青云孝弟家。\n自古人情多玉石，即今世事几龙蛇。\n我来樽酒论骚雅，帘捲中庭驻落霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜有感","author":"谢榛","text":"老去生涯一短筇，几年河岳寄行踪。\n城边瑟瑟高秋树，天外沉沉静夜钟。\n风急沙洲移鹳雀，云深潭水护蛟龙。\n迩来不见同心侣，无奈狂歌阮嗣宗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望紫金山有作","author":"谢榛","text":"隔河一带碧嶙峋，薄暮登台注望频。\n古洞深松归老鹤，金山瑶草待幽人。\n泉奔巨壑常风雨，月傍高坛自鬼神。\n丹侣有期应不负，三花树底醉长春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜坐感怀寄徐文山","author":"谢榛","text":"独夜寒螀鸣不休，虚窗起坐忆南州。\n山开薄雾来明月，天送长风作冷秋。\n华发渐多惊老大，壮怀无奈叹沉浮。\n美人一别江关渺，肯采芙蓉慰我愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱仙镇吊岳武穆","author":"谢榛","text":"中原何幸见将军，一剑长驱万马群。\n战伐功高天意在，庙堂策定帝图分。\n只今营垒空秋月，终古旌旗有暮云。\n遗恨几多堤上柳，冷风凄雨不堪闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻老兵谈边事","author":"谢榛","text":"少小从军老病侵，铁衣征战岁年深。\n天寒野火烧荒塞，月黑山精啸古林。\n千载干戈堪洒泪，三秋笳鼓数惊心。\n平沙乱草迷枮骨，汉武穷兵怨至今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梁园春雪","author":"谢榛","text":"二月都城冻不消，云黄地白思寥寥。\n园林幸未舒桃萼，风雪宁堪妒柳条。\n欲触晓寒寻野径，漫探春意过溪桥。\n惠连留滞空词赋，梁孝同时想见招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题孟得之园竹","author":"谢榛","text":"西风万木正彫残，脩竹娟娟谩自看。\n为爱清阴摇绮席，不教新笋上金盘。\n色连淇澳秋霜净，声彻潇湘暮雨寒。\n中有栖迟九苞凤，野云长护碧琅玕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题王大伾侍御别业","author":"谢榛","text":"野扉长掩石林幽，林外寒溪汩汩流。\n老凤无心横碧汉，高云何意落沧洲。\n天王侧席兵戈日，柱史閒居草树秋。\n二十年来耽著述，不知华发为谁忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴将军北伐","author":"谢榛","text":"连营鼙鼓送斜曛，北伐应期霍冠军。\n铁马踏残燕塞草，金戈挥断朔方云。\n将材此日宁虚负，边事频年不忍闻。\n豪侠从来多慷慨，几人钟鼎勒奇勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋无月","author":"谢榛","text":"不见青娥驾紫鸾，孤樽愁思坐更阑。\n山河莽莽迷琼树，风雨冥冥失玉盘。\n梁苑池台空度夜，汉家宫殿不胜寒。\n欲知何处秋光好，天柱峰头试一看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送白子钟南游","author":"谢榛","text":"广陵南去水浮天，枫华蓼花秋正妍。\n岛屿遥连三楚树，风云低逐九江船。\n驿亭津阁好沽酒，黄橘白鱼宁惜钱。\n汗漫直须穷胜绝，子长高躅忆当年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮秋忆马立斋李后溪","author":"谢榛","text":"落落商歌日几回，世情聊把菊花杯。\n斜阳又下岭西去，候雁还从天北来。\n宋玉此怀谁与会，虞卿异代自同哀。\n长安有客深知己，潦倒渐非献赋才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬日寄酬李给事仲西","author":"谢榛","text":"烈风吹断野桑枝，云外孤鸿北叫时。\n雪满山城惊岁暮，冰连河海得春迟。\n几年谪宦身多病，独夜悲歌鬓欲丝。\n留滞天南忧思切，梦飞青琐月明知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林虑北园待李子周不至","author":"谢榛","text":"北园台榭雨晴初，坐对群峰澹自如。\n四野暝烟飞白鸟，半池秋水落红蕖。\n海天月近幽栖处，石树风生浩唱馀。\n清夜放怀须酒伴，隔林犹自听来车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆天坛山","author":"谢榛","text":"目极天坛路渺茫，往时高步采琼芳。\n白云壑断笙音度，红叶林空酒气香。\n仙客并游心自逸，野猿一见意相忘。\n醉呼童子收诗草，月上千峰卧石床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日洹上过田深甫对酌","author":"谢榛","text":"梁客才名康乐齐，北来献赋此幽栖。\n春流回合孤村外，晚照苍茫万柳西。\n烟浦横舟閒把钓，花台对酒漫分题。\n太行一望高无极，相约登临杖短藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"牡丹","author":"谢榛","text":"洛下名花迥绝尘，宝阑斜倚见风神。\n香飘梁苑聚仙子，色压汉宫无美人。\n宿露暗侵芳骨冷，晓霞低照靓妆新。\n谢家秪解题红药，此日狂吟醉好春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题 其一","author":"谢榛","text":"楚女春心不自持，月明谁唱竹枝词。\n琼簪玉珥何颜色，翠幕朱阑且岁时。\n燕子楼空伤往事，杜鹃花老负归期。\n江头几度风和雨，转觉湘灵瑟调悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题 其二","author":"谢榛","text":"窗有蛛丝镜有尘，小楼岑寂坐伤神。\n鸳鸯哺子空经眼，桃李飞花不待人。\n洛浦佳期孤皓月，湘江幽怨寄青蘋。\n玉环旧日徒相赠，肠断归鸿又一春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送金广文少贲之长沙","author":"谢榛","text":"数卷孤琴非俗计，短亭细柳是王程。\n旧从彭泽怀陶令，此日长沙吊贾生。\n夜月子规乡国梦，春江杜若楚骚情。\n碧湘门外风云阔，华发无劳怨不平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄南都卢涞西司业","author":"谢榛","text":"钟山灵秀一龙蟠，太史南游好纵观。\n扬子江横天地合，石头城压雪涛寒。\n谈经道气空今古，作赋心思入渺漫。\n千里有怀应北向，凤台高倚碧云端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答武进李宰元素惠六朝诗","author":"谢榛","text":"故人送我六朝诗，夜半灯前坐读时。\n清庙朱弦弹古调，玉楼琼树发春姿。\n共言苏李传骚雅，那识曹刘是路岐。\n极望江山增感慨，长风吹雁报君知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"征夫叹","author":"谢榛","text":"漠北单于耽射猎，云中都护拥旌旄。\n征夫泪堕故乡远，戍角声悲寒月高。\n绝塞冰霜侵剑戟，阴山鬼火照蓬蒿。\n从来百战轻生死，独倚辕门感二毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"千秋颂","author":"谢榛","text":"平乐筵开冬月初，天风吹鹤下前除。\n山河万古钟元气，宫殿千秋倚太虚。\n华日高辉龙衮上，彩云低度凤笙馀。\n称觞不尽词臣意，东海壶公有报书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"还家","author":"谢榛","text":"二十馀年寄邺城，归来谁不讶狂生。\n白头况带风尘色，青眼深知父老情。\n共话江湖多故事，自怜词赋亦空名。\n仲宣踪迹犹无定，遥指浮云意未平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"千秋颂上恒易赵殿下","author":"谢榛","text":"殿阁祥云绕凤麟，蟠桃特出荐佳辰。\n词林共仰天葩润，艺圃同瞻睿藻新。\n招隐久虚青玉案，论交先访白纶巾。\n仙胎未识金银气，鹤算平分阆苑春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏夜大雨寄怀崔驸马懋仁","author":"谢榛","text":"邺王城外雨漫漫，旅客惊心夏欲残。\n平地波涛吞道路，极天云雾失峰峦。\n疏灯闪闪沧洲夕，乱苇萧萧白鹭寒。\n遥想月明吹凤管，倚楼何处望长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄蔡春台兵宪兼忆王凤洲廉宪","author":"谢榛","text":"两守姑苏何太劳，君今海上拥旌旄。\n龙腾地得三春雨，鲸缩天收万里涛。\n岁稔不忧吴税重，时平谩学楚词高。\n陆机相近应同赋，秋气争雄见二毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄门人王少海陆石虹二子因悼商洛山同贾于邺未几病殂久淹旅榇作诗讽之","author":"谢榛","text":"叔牙义气亦空闻，帝里名交邺下坟。\n异土抱疴骸骨在，同乡负德死生分。\n逍遥燕市酣春色，呜咽洹流暗暮云。\n龙种徒能千里足，凤雏何用九苞文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄钱兼山员外","author":"谢榛","text":"一官疏懒合丘樊，远近书生多在门。\n白璧新知徒有识，青云旧侣半无存。\n地通湖海三吴脉，天造文章万古源。\n遥忆花桥春事过，苔阶鸟雀共寒暄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张㠠山廉宪晋阳以书见招因擢南京都宪不果行赋此寄意","author":"谢榛","text":"路出中原惬壮游，试看形胜旧皇州。\n秣陵山抱连天起，扬子波平荡日流。\n亲友寄书通蜀舸，朝廷息战佩吴钩。\n凤凰台上仍相约，共赋江南万里秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答朱醉石上舍见寄次来韵","author":"谢榛","text":"同怀两地旷交游，特向汾阴问去留。\n昭代应怜鹦鹉赋，丽情莫讶鹔鹴裘。\n几经风雨人间路，独揽云霞海上楼。\n西隔太行书万里，杜蘅又老大江秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄江南李巽川许习盘二正郎兼忆张怀洲黄门","author":"谢榛","text":"建业同官劳未休，三吴有待稻花秋。\n署郎各系江湖念，计吏相关风雨愁。\n别意且须通白雁，老年秪合在沧洲。\n迩来青琐悬何事，草疏深宵重倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送孟方伯存甫之关中","author":"谢榛","text":"邺下相违复见君，朔方动业迩来闻。\n两迁薇省秦中路，一望岷山塞上云。\n客思不堪聊出祖，宦游无定几离群。\n东林尚忆谈禅处，月满松庭共夜分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李明府凌秋入觐","author":"谢榛","text":"青云旧侣别多时，北去鸣珂是会期。\n魏阙星辰连晓色，汉廷鹓鹭肃朝仪。\n九天春雪宫梅发，万户晴烟御柳垂。\n当代抡才重台谏，晋阳贤令巨源知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送纪太守明瑞入觐兼省亲","author":"谢榛","text":"缥缈双旌向北飞，遥看喜色动庭闱。\n关中剑佩趋丹扆，天上风云护紫微。\n策马帝乡成昼锦，听莺客路换春衣。\n太原父老应相望，杨柳河桥立夕晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵太仆子伸入觐","author":"谢榛","text":"流风出自赵平原，曾访丛台旧迹存。\n海内交游同白首，天涯风雪一清樽。\n几瞻帝阙驰燕路，千转云山到蓟门。\n春动上林聊寓目，莫将边事醉中论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"申参戎汝承归自岢岚喜而赋赠","author":"谢榛","text":"岢岚昨喜捷书闻，一剑能驱铁骑群。\n出塞成功先气色，当朝选将更风云。\n沙中走马劳残腊，天外飞旌荡夕曛。\n共羡虬髯心且赤，封侯不数汉将军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题吴郎中温叔山房","author":"谢榛","text":"早辞京国风尘倦，为爱山房泉壑重。\n移榻夜深垂万象，登台秋迥出千峰。\n独蹲斑虎云边石，半隐苍龙雪后松。\n灯下思君见奇绝，忽惊春梦戍楼钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢侍郎与德郊亭饯别","author":"谢榛","text":"昔会燕台今白头，东归分袂倍离愁。\n年华易改谁长健，世路无穷客倦游。\n春雪模糊荒岭树，夕阳惨淡古边楼。\n此情欲寄滹沱水，千折波声尚北流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送太仆卿李钝甫之滁州","author":"谢榛","text":"旌旄拂曙摇行色，太仆乘春别故居。\n谏草不存名自著，笔花常结梦何如。\n西山雪月催成赋，南国风云待下车。\n芳杜青时定相忆，赤湖桥上寄双鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冯大参汝言出饯临汾驿留别","author":"谢榛","text":"归鸿不失洞庭群，樽酒天涯此别君。\n残岁冰霜仍道路，早春书剑又河汾。\n驿亭驻马淹行色，官柳啼鸦送落曛。\n二十年来频聚散，那堪白首叹浮云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明游西园有感","author":"谢榛","text":"客转汾阳时禁烟，太行云渺故乡天。\n齐中一弟悲西垄，邺下诸儿走北阡。\n桃李未花春气晚，河山独赋老怀偏。\n重来秪恐芳菲尽，啼杀黄鹂空自怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张大参汝任之浙中","author":"谢榛","text":"汾阳赠别走诗筒，帆度春流五两风。\n国计更堪征伐后，人心多在去留中。\n江分吴越青天合，地豁东南沧海通。\n雁宕飞泉旧游处，重看片雨下晴空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋夜集周时隆表兄宅有感","author":"谢榛","text":"天涯对月几团圞，乌鹊翻枝栖未安。\n兄弟共须今夕醉，妻孥犹是异乡看。\n光流浩荡千家白，影落苍茫二水寒。\n仙桂花开秋正好，不知人世有悲欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登岱","author":"谢榛","text":"绝顶登攀海日明，下看蚁蛭隐孤城。\n玉童不见云霞渺，丹侣相从杖屦轻。\n汉石尘迷千古字，秦松风起半天声。\n欲探灵异来迟暮，自觉人间负此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过杨子畏别业登楼同田深甫醉赋","author":"谢榛","text":"遥望河流一缕微，凭虚俯见乱鸦飞。\n云流槛外生寒色，霞落樽中驻晚晖。\n共赋高秋能不倦，登楼后约恐长违。\n仲宣老去随萍梗，湖海茫茫几梦归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜集梁武选公济园亭同何稽勋治象得秋字","author":"谢榛","text":"问予东去欲何求，日观峰高独胜游。\n离合此生能几醉，啸歌今夕故相留。\n庭前松桂偏宜月，笛里关山别是秋。\n他日鸣珂还有意，停云时傍凤城头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同何治象梁公济登会仙山","author":"谢榛","text":"野菊迎霜犹自开，漫乘幽兴一追陪。\n谈玄更欲寻瑶草，举白聊须坐石苔。\n落日半山松掩映，閒云满地鹤徘徊。\n仙人去后馀风景，知有千年我辈来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日怀冯汝言","author":"谢榛","text":"岸帻行吟向落晖，西原聊自采芳菲。\n白驹转眼浮生老，黄鸟惊心旧侣违。\n扬子风涛南望远，秣陵春信北来稀。\n还思并马渔阳路，回首孤云塞上飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送汪谷受之京","author":"谢榛","text":"几度秋花君未归，风尘无倦鬓丝稀。\n邺城日久频弹剑，燕地寒多早授衣。\n兵甲愁中生事薄，江湖梦里旧交违。\n逢人自说黄山胜，却忆松萝静掩扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]