[{"title":"过白云观","author":"程敏政","text":"红尘飞尽白云生，一径深深草树平。\n丹灶已空仙去远，琳宫犹枕旧辽城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46794,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"溪西竹屋","author":"程敏政","text":"万斛清风扫市喧，忽惊西郭有淇园。\n碧云冉冉摇香细，苍雪纷纷落影繁。\n沙径逶迤通活水，石台虚敞对幽轩。\n酒酣欲刻琅玕节，诗句深惭旧掖垣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46795,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观音寺望湖亭次沈中律旧韵","author":"程敏政","text":"涧水分明一线来，碧天空阔镜中开。\n亭前医俗怜新笋，石上题名扫旧苔。\n野衲未惊中爨熟，林乌遥认晚钟回。\n春来觞咏休轻掷，白塔累累遍草莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46796,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吕公洞","author":"程敏政","text":"石洞知何代，门当玉涧湾。\n潮音疑可听，仙驾杳难攀。\n暗穴深通海，危亭上据山。\n吟身贪纵步，遥带夕阳还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46797,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"欲往香山寺寻皑东白善世不果","author":"程敏政","text":"湖亭高处望香山，殿阁参差紫翠间。\n遥听磬声知不远，未叨茶供却空还。\n名僧久结三生社，词客聊乘半日閒。\n又与山阴添故事，吟筒无惜慰离颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46798,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"自玉泉亭步至功德寺","author":"程敏政","text":"东风几日到郊坰，岸草汀蒲已自青。\n羁客乍来方纵目，野人相见亦忘形。\n湖当鹫岭烟光重，路入龙潭水气腥。\n闻说先皇曾驻跸，红云犹绕玉泉亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46799,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿溪西竹屋","author":"程敏政","text":"束装已戒道，看竹来城隅。\n野性自成癖，路人从笑迂。\n力登山上亭，缓策沿晴湖。\n回首日西下，清宴仍相娱。\n引火试香鼎，挑灯开玉壶。\n但知客兴浓，不觉春宵徂。\n出门见星月，天籁闻笙竽。\n击节呼此君，为尔羁今吾。\n聊须借吟榻，卧我山泽臞。\n扰扰百年中，去就不可虞。\n留题岁寒社，莫遣丹青渝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46800,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西山道中与友人别","author":"程敏政","text":"圣恩容纳禄，随地可寻春。\n东道非生客，西山似故人。\n竹贪文字饮，萍笑宰官身。\n别后遥相忆，诗邮托雁频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46801,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游归值雨","author":"程敏政","text":"胜日春郊马足轻，归来风雨暗东城。\n阴晴多谢天公巧，容我看山一度行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46802,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送宗侄式之知朔州","author":"程敏政","text":"马首春风鬓未华，一官初擢带生花。\n离筵对酒频看剑，边郡屯兵特建牙。\n久喜皇威清雁碛，远闻农事遍龙沙。\n寄言莫笑江南客，曾是江南旧将家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46803,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画牛二首 其一","author":"程敏政","text":"沙柳阴浓岸草深，老犍回首认桃林。\n手提死雉惊乌啄，赖有田夫报苦心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46804,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画牛二首 其二","author":"程敏政","text":"芳草平原水满陂，夕阳牛背影差池。\n青童黄犊相呼处，记取前朝卖剑时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46805,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠李士敬锦衣进署千户","author":"程敏政","text":"绿鬓朱颜太师子，清晓彤庭拜恩旨。\n一日诏领千人军，总道太师今不死。\n太师勋德天下闻，遗编满架留香芸。\n诗书韬略付两子，池上凤雏原不群。\n伯氏才华重司玺，君也奇功著边鄙。\n由来难弟复难兄，世家谁及南阳李。\n居然隽爽薄贵游，凛如雕鹗横高秋。\n观君骨相岂凡种，积善自古生公侯。\n几许青年美声价，广坐稠谈不相下。\n金门夜直分虎符，玉陛晨趋候龙驾。\n白马锦衣光射人，东风满路飞香尘。\n天家雨露今更渥，勉图莫负嫖姚身。\n老生旧是门墙士，半世归耕本无似。\n酒酣击节成短歌，万里云霄壮君志。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46806,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠含春子","author":"程敏政","text":"浮生容易白头侵，谁识东皇造化心。\n静坐久谙升降理，希声何择短长吟。\n梅苞露白香仍浅，草蘖回青色自深。\n闻说个中生意好，无端真乐待重寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46807,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"留别清化寺旵东明上人","author":"程敏政","text":"过眼流光不自胜，迩来三月共寒灯。\n凭谁可是忘形客，笑我真成有发僧。\n别酒定?空腊味，归途闻说解春冰。\n没林倦鸟心犹悸，莫道城南纸价增。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46808,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"幼幼堂歌为越中朱廷用先生赋","author":"程敏政","text":"幼幼堂上春如海，幼幼堂下多兰茝。\n堂中老人发垂雪，朱颜不共年华改。\n清晓开门人请药，午夜篝灯诊危弱。\n尘埃风雨不自知，老人活婴心始乐。\n人言此翁非药叟，经史寻常不离手。\n邵家数学穷奇偶，白傅诗篇谢花柳。\n堪舆上扣青囊翁，穷妙还思河上公。\n平生辨博人所羡，同姓绰有丹溪风。\n我识此翁深，人识此翁浅，翁心不逐时情转。\n义气分明薄轩冕，汉庭一日复古典，孝廉有科当中选。\n重翁不独医之良，爱翁不觉歌声长。\n幼幼堂，寿且康，幼幼之名传四方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46809,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"有画士人与和尚道士醉戏者曲有思致殆宋本也漫赋一绝","author":"程敏政","text":"外貌猖狂内乐真，醉来谁主复谁宾。\n等閒不是攒眉社，自有壶天一样春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46810,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿意图为芜城王君怡晚追赋","author":"程敏政","text":"仙人跨凤来匆匆，翱翔远自东溟东。\n手持一卷寿生箓，夭矫似是青华翁。\n紫绡衣轻止欲下，石洞上见桃花红。\n花间老人意閒雅，万里一瞬流云空。\n青苔净扫坐盘石，炯然秋水明双瞳。\n江乡旧号骑鹤里，浮名岂愿拘尘笼。\n清和天色雨初过，异境彷佛开冥濛。\n紫芝葳蕤得何许，石阑诘屈遥相通。\n小童煮茗?玉虹，小鬟奉果来香风。\n眼前花甲周可数，不惜一笑回春融。\n向平婚嫁久已毕，老年嬴得窥环中。\n丹砂倘见伏金鼎，白发肯使悲青铜。\n披图愿子得寿意，三山一闯蓬莱宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46811,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"留别通州王德明守备","author":"程敏政","text":"将军留客荐离尊，说剑论诗笑语温。\n塞柳曾窥单骑出，窗芸犹护一经存。\n牛羊落日京东路，鼓角春风海上屯。\n肯为傍人讥白面，听君奇策报殊恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46812,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再别旵上人","author":"程敏政","text":"潞河三日吹黄风，上人翩然来向东。\n溪藤索诗照夜白，燕酒饷客摇春红。\n池上冰衔愧苏子，城南净社思陶翁。\n病身正尔坚饮戒，无限离情芳草中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46813,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上林清趣卷为嘉蔬署丞兼林衡署事宗侄京赋 其一","author":"程敏政","text":"绿树阴阴百鸟啼，上林遥在帝城西。\n一官向此开清署，赢得新篇取次题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46814,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上林清趣卷为嘉蔬署丞兼林衡署事宗侄京赋 其二","author":"程敏政","text":"畦菜青青苑果红，宦途清绝市尘空。\n五风十雨开园后，来往人行罨画中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46815,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上林清趣卷为嘉蔬署丞兼林衡署事宗侄京赋 其三","author":"程敏政","text":"不比前朝贡荔枝，晚菘春韭绿参差。\n官閒有趣无宣索，万岁君王旰食时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46816,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上林清趣卷为嘉蔬署丞兼林衡署事宗侄京赋 其四","author":"程敏政","text":"苑中应起借乌轩，每汲沙泉学灌园。\n辇路草长巡幸少，清时谁竞啬夫言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46817,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上林清趣卷为嘉蔬署丞兼林衡署事宗侄京赋 其五","author":"程敏政","text":"心地清如镜水波，官中从尔较催科。\n遥知此后弹冠日，随处春风趣益多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46818,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上林清趣卷为嘉蔬署丞兼林衡署事宗侄京赋 其六","author":"程敏政","text":"青李来禽贡尚方，朱篮黄帕屡分尝。\n天涯为子题诗句，惭愧非才负宠光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46819,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与世赏庶子同饮通州致仕袁千户家","author":"程敏政","text":"春馆留人一笑同，爱君家住潞河东。\n嫖姚久谢千军帅，矍铄真堪百岁翁。\n新酒白鱼牵思远，绿波芳草送尘空。\n论诗更值王摩诘，不道相逢是客中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46820,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题老子出关图","author":"程敏政","text":"函谷关高高入云，东来紫气何缤纷。\n关头或有异人过，令尹一日先知闻。\n青牛驾车出林莽，翠葆拂晓扬清芬。\n至人中坐雪垂领，神气内守颜如醺。\n当时令尹亦奇士，衣冠奉候青山垠。\n车前再拜复长跪，局缩似礼云中君。\n至人自是真天人，悯此浊世飞埃氛。\n出关定隐不复现，草衣木食甘随群。\n天书云篆倘有作，坐遣道德为耕耘。\n停车挥扇相告语，为尔启钥开玄文。\n致柔专气五千字，划然天地如初分。\n乃知至人与众异，下视诸子皆虻蚊。\n至人昔作柱下史，披诵亦自劳精勤。\n三坟五典久在目，霞裾尚尔留香芸。\n尼父圣人敬问礼，逮今一一馀坑焚。\n至人至意人叵测，朱縢绿检空云云。\n窥图抚景三叹息，春风满屋销垆薰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46821,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"别潞河逆旅主人冯大周","author":"程敏政","text":"二月南归候水官，高堂留宿百馀欢。\n主人长道望尘久，客子不知行路难。\n晓日桥边折杨柳，春风庭下养芝兰。\n人生去住何须问，一笑诗成酒未残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46822,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清明日发舟偶过广福寺","author":"程敏政","text":"潞河东岸发归程，步入招提问寺名。\n烟锁绿芜涵暝色，风吹黄柳散春声。\n廿年赐火惭君宠，四野浇坟怆客情。\n晚供有茶聊当酒，一番飘泊已清明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46823,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿瀛东别业","author":"程敏政","text":"先人有别墅，宛在瀛川曲。\n荏苒二十年，始此一停宿。\n裴?原野间，百感中自触。\n梨花积晴皓，杨柳纷众绿。\n一岁增几株，当时手栽木。\n白驹亦何驶，苍发忽半秃。\n缅怀古贤达，矌视不可复。\n岂无致主心，自审诚碌碌。\n君恩浩山海，不遣随窜逐。\n赁船走东南，日夜忧骨肉。\n矧兹墓台荒，奉扫未成卜。\n渺渺沧波长，悠悠白日速。\n明发城东门，低头愧林谷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46824,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽清源刘孝子克庄","author":"程敏政","text":"大扁金书照里门，当时纯孝尚堪论。\n庭乌最尔谙心事，坟草犹疑染泪痕。\n五夜忽惊尘梦杳，百年终见古风存。\n孤舟前日相逢地，寒水无由酹一尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46825,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乡人客清源者追饯索诗","author":"程敏政","text":"北河一棹还新安，清源追别聊盘桓。\n羡君尽享估客乐，顾我方忧行路难。\n徵诗往返白日速，纵酒歌呼清夜阑。\n乡情离思两不极，垂杨插水春漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46826,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"云龙山留别宗侄楚英同守","author":"程敏政","text":"客里孤舟此暂停，夕阳红处乱峰青。\n閒云尚绕从龙地，蔓草空馀放鹤亭。\n佛散宝花成旧刹，人摩苍藓刻新铭。\n等閒吊古情无限，不为伤离酒易醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46827,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"黄茅冈","author":"程敏政","text":"舣棹来登乱石冈，几间茅屋水天长。\n桑原麦垄人行处，曾是苏公旧猎场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46828,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"亚父冢","author":"程敏政","text":"废冢曾经盗发频，白头空作楚谋臣。\n填胸一怒缘何事，嬴得渔樵冷笑人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46829,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"戏马台","author":"程敏政","text":"千古荒台倚暮云，霸图销歇水沄沄。\n当时骏骨知多少，惟有乌骓不负君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46830,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陵母墓 其一","author":"程敏政","text":"夜台千古閟荒山，智母名高宇宙间。\n不向楚庭先伏剑，王郎应自乞身还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46831,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陵母墓 其二","author":"程敏政","text":"教子扶王不二心，几人回首愧缨簪。\n当廷死诤遵慈训，始觉君侯孝最深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46832,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"水次仓","author":"程敏政","text":"广厦朱门照水明，太平军食转彭城。\n不知南北人来往，犹唾芝麻李二名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46833,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"广陵驿下与表兄林文秀仓使夜酌","author":"程敏政","text":"二十四桥春草平，月明依旧满芜城。\n繁华百代底须问，邂逅一尊无限情。\n去国浪传金马客，倚楼谁送玉箫声。\n孤帆又作江南别，坐听船签报五更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46834,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游焦山","author":"程敏政","text":"十日横江雨未晴，舣舟来作看山行。\n海滨烟堠遥分帜，树杪风帆欲近城。\n去国身轻随雁落，登高诗健逐潮生。\n閒心愿托焦光隐，客里先抛第一盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46835,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮观音阁","author":"程敏政","text":"漠漠顽阴扫未开，石梯千仞滑生苔。\n倚阑尚见淮南树，拂袖疑登海上台。\n坐听松风聊当乐，醉呼江水欲添杯。\n绕山细勘题名刻，早有人曾冒雨来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46836,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登江山壮观亭","author":"程敏政","text":"整屐同登壮观亭，百年身世等飘萍。\n两潮漫作崩腾势，拳石终存砥柱形。\n返棹客愁烟树黑，浮家人占雨莎青。\n南来抉胜心方健，有约重寻瘗鹤铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46837,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"书法孝子传后 其一","author":"程敏政","text":"野宿风号半毁形，眼看坟草六回生。\n当时至行真难再，合上清朝太史铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46838,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"书法孝子传后 其二","author":"程敏政","text":"有生便识全归理，欲救亲危敢爱身。\n正恐毁伤堪藉口，世人翻诮舍生人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46839,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丹徒王玺家蜜褐莲卷追赋","author":"程敏政","text":"王家池上见芙蕖，蜜褐装成态有馀。\n晚色尽消脂粉气，高标宜占水云居。\n红灰酒满香中泻，白社诗残叶上书。\n欲为花神增旧谱，赏缘他日记南徐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46840,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登多景楼","author":"程敏政","text":"黯黯江云结暮阴，江楼高处一登临。\n山根乱雪来双橹，天外遥青出寸岑。\n归去已惭陶令赋，醉中偏爱颖师琴。\n鲥鱼竹笋江南路，幸及霜毛未满簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46841,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与袁石坡太守游甘露寺","author":"程敏政","text":"天外飞甍接太虚，只疑僧在雾中居。\n风掀白浪过江口，云拥青山入座隅。\n词客旧题留北固，寓公高致属南徐。\n赞皇池馆琅琊石，拟向雷音洞里书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46842,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"太医院使钱君宗嗣挽歌 其一","author":"程敏政","text":"生死交情二十年，舣舟京口倍凄然。\n青山细雨人何在，怅望城南白兔阡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46843,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"太医院使钱君宗嗣挽歌 其二","author":"程敏政","text":"青囊家世数谁精，钱乙当时重两京。\n先子已随龙驭远，空留人道国医名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46844,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"太医院使钱君宗嗣挽歌 其三","author":"程敏政","text":"几年供奉殿东头，最得先皇宠数优。\n遣奠尚留天语在，虹光千古照林丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46845,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"太医院使钱君宗嗣挽歌 其四","author":"程敏政","text":"忆曾阻雪到江干，野寺相逢岁正阑。\n今日我来君已去，人间离合最无端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46846,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"太医院使钱君宗嗣挽歌 其五","author":"程敏政","text":"浮荣无赖似浮云，多少人随草木群。\n百世定知君有托，谢家兄弟总能文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46847,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"太医院使钱君宗嗣挽歌 其六","author":"程敏政","text":"投劾归来感圣恩，旧游零落不堪论。\n山中我未忧多病，尚有君传药禁存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46848,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"钱宗胤览翠亭","author":"程敏政","text":"名园佳处结幽亭，竹树森森昼不扃。\n雨过四檐尘不起，风生双袂酒初醒。\n沿阶草色时供翠，排闼山光远送青。\n他日可容分半席，绿阴閒叩卫生经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46849,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"留别杨应宁佥宪","author":"程敏政","text":"杨君我良友，一别经几秋。\n不图今日来，相见古润州。\n颜色甚憔悴，知子非穷愁。\n无奈寸草心，更抱苍生忧。\n蔀斋共蔬食，为子一日留。\n子才非词藻，立志希前脩。\n有如霜涧松，不作春花羞。\n向来稍自见，足应明堂求。\n我生本迂戆，未老惊白头。\n负恩合窜殛，徼倖归林丘。\n子幸不弃我，晤言如有投。\n感此意不极，翩然愧难酬。\n萧萧白日雨，黯黯沧江楼。\n行装已戒晓，鸣榔发孤舟。\n后会杳难期，岁月如奔流。\n迟子崇令德，盟言慰朋游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46850,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"何氏丈莲卷","author":"程敏政","text":"异方传得卖花翁，照水能开一丈红。\n色靓铅华朝带雨，香生帘幕夜含风。\n护妆合遣遮纨扇，侑客长应剪碧筒。\n闻说主人真好事，不辞题句慰芳丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46851,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"留别王丹徒公济","author":"程敏政","text":"三十年前同舍郎，行边一笑暂停装。\n风流文采真吾弟，涉水登山共此觞。\n壮岁喜君官况好，畏途惊我鬓丝长。\n诗筒两日频来往，未觉相逢是异乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46852,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乘风夜过无锡寄致政秦廷韶方伯及诗社诸君子 其一","author":"程敏政","text":"一归方喜称閒身，十口那堪更索人。\n半夜随风挂帆去，负君相候洗缨尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46853,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乘风夜过无锡寄致政秦廷韶方伯及诗社诸君子 其二","author":"程敏政","text":"他时有约报邮签，山鸟啼残笋正甜。\n等是太平林下客，幅巾来往定无嫌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46854,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与王宣溪世赏同至虎丘醉中限韵一首","author":"程敏政","text":"三度来尝陆羽茶，园丁曾此荐冰瓜。\n游踪语客真成梦，醉眼看山久作花。\n旧榜诗随尘外劫，远归身似海中槎。\n残阳塔院翻多兴，欲典宫衣向酒家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46855,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]