[{"title":"殿卿至","author":"李攀龙","text":"骏马何当出，金高郭隗台。\n云中春酒熟，书后故人来。\n白首文章事，青云王伯才。\n谁为一知己，念子正悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24039,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送殿卿","author":"李攀龙","text":"嗟君复失意，吾道转堪疑。\n白雪论先达，青云合后时。\n落花寒食过，载酒故山期。\n莫以杨朱泪，春风洒路岐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24040,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"章行人使潞藩","author":"李攀龙","text":"使者持符下，风尘叱驭前。\n诸侯城赤狄，列嶂党青天。\n牟麦祈年畤，芙蓉避暑筵。\n相逢多爱客，共赋远游篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24041,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十六夜集刘子成宅","author":"李攀龙","text":"羽书三十度，飞骑动长安。\n今夜樽前月，还同燧火看。\n入门清影满，久坐素华寒。\n何处关山引，如悲行路难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24042,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻砧","author":"李攀龙","text":"永夜卢家妇，深闺坐自伤。\n拭砧散明月，投杵上清霜。\n别恨繁鸳绮，哀音急雁行。\n同袍征战尽，刀尺断人肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24043,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送张比部募兵秦晋诸郡","author":"李攀龙","text":"天威严灭敌，使者出秋官。\n白羽徵兵入，黄金结士欢。\n风云千骑动，雨雪二陵寒。\n无易行间客，能登汉将坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24044,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送沈郎中守顺庆","author":"李攀龙","text":"见说褰帷处，千山拥使君。\n嘉陵渡春水，栈道转秋云。\n郡下平蛮檄，家传谕蜀文。\n病馀饶卧理，能不忆离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24045,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日韦氏园亭同元美赋 其一","author":"李攀龙","text":"春坞花冥冥，斜阳倒玉瓶。\n风尘犹傲吏，天地此空亭。\n共醉蓟云白，相看燕草青。\n我来吟泽畔，不是独为醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24046,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日韦氏园亭同元美赋 其二","author":"李攀龙","text":"藉草到流水，看花延落晖。\n客中过寒食，马上改春衣。\n移席青山出，开樽白鸟飞。\n天涯有朋好，能使宦情微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24047,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日同元美徐子旋贾守准刘子成集张氏园亭得谈字","author":"李攀龙","text":"共载杯中物，聊停尘外骖。\n路人终白眼，世事岂清谈。\n高枕夏云出，空亭斜照含。\n竹间有流水，可以漱馀酣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24048,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"初夏同元美汪伯阳皇甫子循集姚明府园亭得春字","author":"李攀龙","text":"五柳陶潜宅，犹藏杜曲春。\n绿阴衣上满，黄鸟席边新。\n河朔当年事，风流我辈人。\n胡为日车马，扰扰向红尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24049,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送蔡少府之阳武","author":"李攀龙","text":"君归寒食后，犹及县中花。\n趋府具茨野，鸣鞭博浪沙。\n大河秋色外，使者白云槎。\n岂不劳行役，风尘见岁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24050,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为殿卿悼亡","author":"李攀龙","text":"歌梁尘未断，舞袖影方閒。\n落月窥珠镜，青春暗玉颜。\n为云归峡里，窃药去人间。\n安得招䰟术，姗姗步幄还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24051,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答殿卿","author":"李攀龙","text":"故园春草后，书札问同袍。\n海岳游当壮，风尘卧正高。\n大名诗里出，浮世酒中逃。\n顾我仍多病，时危小吏劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24052,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送获嘉郭明府","author":"李攀龙","text":"仙舟新出宰，秋色渡淇河。\n官属诸侯贵，君才百里多。\n政齐吴季重，地接卫朝歌。\n汉主忧南服，长缨送尉佗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24053,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"霅溪徐山人 其一","author":"李攀龙","text":"风尘馀鬓发，天地此栖迟。\n不问家人产，宁求国士知。\n门无荷蒉过，邻有灌园期。\n得道凭乌几，藏名号鹿皮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24054,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"霅溪徐山人 其二","author":"李攀龙","text":"自有浮云恋，非因倦鸟还。\n林光清客梦，湖色驻人颜。\n岁序高悬榻，风尘老抱关。\n不投明月璧，甘隐大雷山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24055,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"毛刺史姑蔑高斋","author":"李攀龙","text":"武陵看花处，二仲得相闻。\n雨白闽天合，山青越徼分。\n书声散秋瀑，翰墨染春云。\n府檄何年事，犹馀猿鹤群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24056,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"出郭","author":"李攀龙","text":"出郭随吾适，人家杜曲边。\n溪流萦去马，山路入鸣蝉。\n禾黍殷秋作，茅茨足昼眠。\n可能祛物役，归买汶阳田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24057,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"张氏园亭","author":"李攀龙","text":"辟疆开别业，载酒雨中看。\n亭敞千花瞑，楼空万竹寒。\n呼童携枕簟，劝客解衣冠。\n宿我山窗下，听诗坐夜阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24058,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"碧云寺禅房","author":"李攀龙","text":"佛土秋逾净，花台夜复香。\n一灯醒梦幻，孤磬散清凉。\n月上梵轮满，湖开天镜光。\n新诗分妙偈，病客对空王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24059,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"早春元美公实访茂秦华严精舍同赋","author":"李攀龙","text":"招提多病客，拥褐世间情。\n法自传灯得，诗先卓锡成。\n年光云树丽，春昼雨花明。\n若许东林住，还携漉酒生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24060,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十四夜同王徐宗梁四君子集灵济宫 其一","author":"李攀龙","text":"爱此壶中约，人皆曼倩才。\n华灯悬日月，仙树接蓬莱。\n青鸟衔诗去，金貂换酒回。\n明宵祠太乙，方士汉宫来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24061,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十四夜同王徐宗梁四君子集灵济宫 其二","author":"李攀龙","text":"逍遥玄圃望，清切紫微层。\n月出三山树，春回万井灯。\n无悲田变海，但愿酒为渑。\n门外金羁影，王孙自五陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24062,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"张山人","author":"李攀龙","text":"吾乡张仲蔚，未是蓬蒿人。\n伏腊东篱下，渔樵北海滨。\n官家还赋役，客路且风尘。\n织妾齐纨素，开筵娇上春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24063,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日","author":"李攀龙","text":"为客淹归骑，思家过断鸿。\n春衣花发后，寒食雨声中。\n生事羞人问，时名与众同。\n自甘郎署隐，不哭宦途穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24064,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柬公实","author":"李攀龙","text":"如何梅发后，更忆故园春。\n海上多归梦，天涯一病人。\n世情元惨淡，宦迹好逡巡。\n莫作鸿冥客，青云未可亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24065,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同元美与诸比部早夏城南放舟 其一","author":"李攀龙","text":"岂悟风尘客，还能汗漫游。\n天涯唯短发，海内此扁舟。\n宦迹清时劣，人才画省优。\n百年浑绿醑，一日且沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24066,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同元美与诸比部早夏城南放舟 其二","author":"李攀龙","text":"最怜行役久，为乐未言疲。\n自起投车辖，长歌覆羽卮。\n江湖青雀舫，僚友白云司。\n醒后惊相问，佯狂信有之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24067,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同元美与诸比部早夏城南放舟 其三","author":"李攀龙","text":"谁为河朔饮，吾愿罄交驩。\n杯动沧波色，舟空白日寒。\n题诗溪鸟过，岸帻野人看。\n不是江湖兴，风尘此道难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24068,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同元美与诸比部早夏城南放舟 其四","author":"李攀龙","text":"落日维舟好，君其问水滨。\n举觞遥送鸟，倚树醉看人。\n各负诗无敌，翻惊会有神。\n明朝在城郭，骑马共风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24069,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同元美与诸比部早夏城南放舟 其五","author":"李攀龙","text":"春归兴不孤，胜地此相呼。\n公等称词伯，余将混酒徒。\n山光含浩荡，秋意飒江湖。\n乐事关穷达，浮生敢自诬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24070,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同元美与诸比部早夏城南放舟 其六","author":"李攀龙","text":"言寻韦杜曲，与客放船行。\n树影含衣动，溪光逼酒清。\n狂来出真态，醉里见浮生。\n所以山公后，寥寥达者名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24071,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄茂秦","author":"李攀龙","text":"向来燕市饮，此意独飞扬。\n把袂看人过，论诗到尔长。\n世情摇白首，吾道指沧浪。\n去住俱贫病，风尘动渺茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24072,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再游南溪同应驾部徐比部赋 其一","author":"李攀龙","text":"此日南溪约，应徐赋客同。\n据床千竹下，进艇百花中。\n天入华阳馆，云生碣石宫。\n昔贤何惨淡，吾醉任鸿濛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24073,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再游南溪同应驾部徐比部赋 其二","author":"李攀龙","text":"覆席花如待，窥帘鸟似知。\n到来拚共醉，坐久见吾诗。\n吏迹江湖傲，仙才日月欺。\n幸逢休浣出，不顾尚书期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24074,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再游南溪同应驾部徐比部赋 其三","author":"李攀龙","text":"晏游无俗吏，休沐有殊恩。\n碧草堪同藉，红尘可重论。\n溪声留倚仗，山色取当樽。\n夙昔疑吾醉，维舟尚在门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24075,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再游南溪同应驾部徐比部赋 其四","author":"李攀龙","text":"花鸟从春过，嬉游到夏偏。\n白云行酒上，清吹起舟前。\n世路身何得，吾徒赋必传。\n宁须千日醉，不拟众人怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24076,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郊行 其一","author":"李攀龙","text":"稍似武陵溪，人家绿树迷。\n桔槔茅屋上，荷蓧蓟门西。\n清吹生衣袂，繁阴散马蹄。\n红尘才只尺，城郭意多暌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24077,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郊行 其二","author":"李攀龙","text":"并马未央前，看云过灞川。\n时逢黄鸟住，欲就绿阴眠。\n宦岂登临拙，名非案牍传。\n风尘朋好在，回首汶阳田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24078,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柬元美 其一","author":"李攀龙","text":"偃蹇宁知病，今如药裹何。\n清斋山雨至，高枕夏云多。\n词赋芳颜妒，风尘壮志过。\n相怜谁最久，把臂此蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24079,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柬元美 其二","author":"李攀龙","text":"久矣疲朝谒，深惟傲吏情。\n临风看玉树，消渴望金茎。\n返照虹霓出，浮云驷马行。\n惭无枚叔赋，起尔蓟门城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24080,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜过元美 其一","author":"李攀龙","text":"眼厎谁同病，天涯好自亲。\n放歌依白日，纵饮向风尘。\n世态摇知己，时名走众人。\n朝参君莫懒，汉主忆词臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24081,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜过元美 其二","author":"李攀龙","text":"病即科头出，狂仍枕腹眠。\n礼非因我设，污不受人怜。\n兴尽衔杯外，言深把烛前。\n开门看堕月，骑马问朝天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24082,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日同元美子与子相天宁寺送别公实 其一","author":"李攀龙","text":"晏坐人天近，清斋僧夏深。\n出门成远道，驻马向祗林。\n益愧风尘色，相看湖海心。\n惠休能怨别，为拟碧云吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24083,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日同元美子与子相天宁寺送别公实 其二","author":"李攀龙","text":"西域黄金地，南讹大火天。\n赠言回白雪，寒色动青莲。\n幻迹抽簪外，浮名把袂前。\n古今皆涕泪，去住各风烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24084,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日同元美子与集子相宅","author":"李攀龙","text":"佳客堪常见，幽期暑亦过。\n披襟度风雨，把酒出星河。\n懒拙元相藉，文章敢自多。\n夜深忘白羽，玉树倚蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24085,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柬子相 其一","author":"李攀龙","text":"已负西山约，将无惜壮游。\n怀人当落日，卧病复清秋。\n时事君高枕，风尘我敝裘。\n加餐看物理，天地一虚舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24086,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柬子相 其二","author":"李攀龙","text":"楚客秋多病，羁心私自怜。\n各天散朋好，八月见烽烟。\n白露寒砧下，青枫过雁前。\n岂应裁恨赋，写任故人传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24087,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别汪正叔员外","author":"李攀龙","text":"几年金虎署，与尔结交欢。\n傲吏庄生似，诗家鲍叔看。\n春光燕树合，雨色蓟门寒。\n各抆临岐泪，风尘去住难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24088,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀魏顺甫","author":"李攀龙","text":"白云同署客，相念意悠哉。\n交道萧朱失，文章屈宋来。\n风尘还傲吏，案牍岂时才。\n不见黄金骏，秋高蓟北台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24089,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登黄榆马陵诸山是太行绝顶处 其一","author":"李攀龙","text":"黄榆高不极，临眺亦奇哉。\n河势中原坼，山形上党来。\n白云横塞断，寒峡倚天开。\n摇落清秋色，多惭作赋才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24090,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登黄榆马陵诸山是太行绝顶处 其二","author":"李攀龙","text":"不尽寒云外，青峰落照多。\n秋阴生大卤，木叶下滹沱。\n巨壑藏风雨，飞梁挂薜萝。\n重关三辅地，跃马意如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24091,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登黄榆马陵诸山是太行绝顶处 其三","author":"李攀龙","text":"振衣岩木下，倚杖白云层。\n落日悬狐塞，清秋度马陵。\n千峰寒自出，大泽莽相仍。\n左瞰邢襄郡，分符忆股肱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24092,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登黄榆马陵诸山是太行绝顶处 其四","author":"李攀龙","text":"秋色自冥冥，风烟接井陉。\n关门开落日，山路出寒星。\n太守方乘障，清时敢勒铭。\n杉松回朔气，哀壑未堪听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24093,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答明卿病后见寄 其一","author":"李攀龙","text":"蓟门摇落后，楚客病如何。\n秋色高金掌，西风满玉珂。\n开樽鸿雁至，染翰五云过。\n应忆山阳会，疏狂阮籍多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24094,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答明卿病后见寄 其二","author":"李攀龙","text":"吴生何偃蹇，称病不朝天。\n侍从官非拙，浮沉世所怜。\n黄金燕士里，白雪郢人前。\n自识衔杯趣，逾看结袜贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24095,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄元美 其一","author":"李攀龙","text":"宿昔神仙省，青云向尔亲。\n偿金聊玩世，抱玉故调人。\n气色高题柱，文章老斲轮。\n别来多所忆，卧病上林春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24096,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄元美 其二","author":"李攀龙","text":"岂不为同舍，于时愧重名。\n佳人谁独立，大将尔横行。\n病起高诗兴，春光美宦情。\n悬知思远道，落日蓟门城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24097,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"即事 其一","author":"李攀龙","text":"浮云如浪迹，春色且邢州。\n磬折人堪老，萧条客自愁。\n孤城山下出，大陆日西流。\n请郡终何意，风尘复倦游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24098,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"即事 其二","author":"李攀龙","text":"天涯看薄宦，何以异漂蓬。\n才岂分符后，名非荐疏中。\n黄尘霾落日，白羽插春风。\n闻道渔阳战，方论卫霍功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24099,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"即事 其三","author":"李攀龙","text":"懒嫚终疑傲，和光意远哉。\n元龙无客礼，方朔有仙才。\n疾苦褰帷过，风尘领郡来。\n那须论往事，作赋柏梁台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24100,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"即事 其四","author":"李攀龙","text":"使者殊旁午，吾生自不辰。\n文章看长物，道路竟何人。\n寒食孤城外，襜帷大泽滨。\n那堪杨柳色，风雨傍行春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24101,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄宗考功 其一","author":"李攀龙","text":"别离如昨日，岂厌广陵涛。\n春色渔阳满，烽烟海上高。\n文章回白雪，顾盻解绨袍。\n下走犹三辅，萧条欲二毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24102,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄宗考功 其二","author":"李攀龙","text":"春色还堪起，青云固可披。\n振缨人不病，把袂客能诗。\n奏事明光殿，抡才藻镜司。\n稽康犹自懒，早辱巨源知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24103,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄殿卿 其一","author":"李攀龙","text":"人情原惨淡，世路故蹉跎。\n意气弹冠少，风尘按剑多。\n客居深雨雪，春梦远漳河。\n赖有西山色，犹堪载酒过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24104,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄殿卿 其二","author":"李攀龙","text":"燕山为客地，莫共酒人居。\n吾辈诗名大，其徒剑术疏。\n风尘官不调，雨雪岁将除。\n何限东归意，春花满旧庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24105,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春兴 其一","author":"李攀龙","text":"短发黄尘里，浮生白日徂。\n诗名堪自见，经术敢相诬。\n荐列终才吏，逢迎岂壮图。\n有年轻召杜，不病足江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24106,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春兴 其二","author":"李攀龙","text":"案牍将能事，文章敢具陈。\n跳梁看此物，隐几过时人。\n返照生残雨，浮云矫上春。\n夙心唯病免，不欲滞风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24107,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]