repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":24741,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚出恩县南镇市中","author":"刘崧","text":"到处蓬蒿古市，谁家桑枣新园。\n群鸦暮落高树，独客寒归远村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":24742,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题秋江图为陈鍊师赋","author":"刘崧","text":"霜树云峰隐翠烟，长风吹起雁翩翩。\n道人心事如秋水，看到南华第几篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":24743,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题飞霞图为江鍊师赋","author":"刘崧","text":"海上群峰映紫霞，五云楼观是仙家。\n谁吹玉笛春风起，千树碧桃都作花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":24744,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题江鍊师飞霞兰图","author":"刘崧","text":"曾上茅山采白云，山中瑶草尽兰熏。\n何由撷取飞霞佩，同上玄清戏紫氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":24745,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题江虚白悬岩兰竹","author":"刘崧","text":"悬云翠壁三千尺，浥露幽兰四五花。\n安得乘风裁紫玉，月明吹向玉宸家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":24746,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题江飞霞湘兰沅芷","author":"刘崧","text":"湘水沅江日夜流，青青兰芷满中洲。\n谁将幽意和香墨，写出潇湘一片秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe529