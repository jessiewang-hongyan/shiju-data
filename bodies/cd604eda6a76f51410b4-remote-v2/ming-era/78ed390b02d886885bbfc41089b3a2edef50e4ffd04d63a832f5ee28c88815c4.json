[{"title":"秋日过洛阳","author":"薛瑄","text":"洛阳城西今又来，飒飒秋风吹客怀。\n禾黍荆榛蛩韵切，昔人曾此起楼台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5084,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中秋对月遣兴","author":"薛瑄","text":"凉露满天秋气清，月光先到客边明。\n举杯对影深相属，只有姮娥不世情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5085,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元夕寄故乡诸友八首 其一","author":"薛瑄","text":"故乡千里隔关河，好景年年客里过。\n又见元宵春一度，红灯几点月明多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5086,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元夕寄故乡诸友八首 其二","author":"薛瑄","text":"乡人新自故乡来，千里鱼书手自开。\n闻道家山风景好，玉笙吹月共徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5087,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元夕寄故乡诸友八首 其三","author":"薛瑄","text":"寂寂闲门掩月华，春街儿女任諠哗。\n窗前坐久银灯烬，首首诗成只忆家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5088,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元夕寄故乡诸友八首 其四","author":"薛瑄","text":"莫道他乡胜故乡，思归一日九回肠。\n元宵忽共乡人语，为写新诗寄上庠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5089,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元夕寄故乡诸友八首 其五","author":"薛瑄","text":"思乡无日不关情，况复春灯对月明。\n欲作家书附回使，归心先过洛阳城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5090,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元夕寄故乡诸友八首 其六","author":"薛瑄","text":"旧说归期已失期，更逢佳节倍相思。\n交亲若问今何似，客里春来困酒卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5091,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元夕寄故乡诸友八首 其七","author":"薛瑄","text":"中州何事重留连，忆别诸公已半年。\n迟我河汾看春色，百花深处酒如泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5092,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元夕寄故乡诸友八首 其八","author":"薛瑄","text":"回首乡关入梦频，马蹄踏尽几年春。\n客中胆气峥嵘甚，肯把明珠漫赠人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5093,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题毋处士画梅竹二首 其一","author":"薛瑄","text":"疑是孤山处士家，暗香浮动月初斜。\n千红万紫虽无数，独领春魁是此花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5094,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题毋处士画梅竹二首 其二","author":"薛瑄","text":"湘江两岸鹧鸪啼，翠袖天寒日又西。\n可是无人伴幽独，纷纷桃李下成蹊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5095,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"行黄河岸上","author":"薛瑄","text":"苍崖千仞俯黄流，滚滚波声大地浮。\n惆怅灵槎无复见，壮怀祗拟付神游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5096,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"看杨花戏作","author":"薛瑄","text":"纷纷拂拂雪花香，旋逐回风过粉墙。\n坐困绿阴看未足，无端春思正悠扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5097,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题蒲守刘公梅竹二首 其一","author":"薛瑄","text":"谁倾金醴醉仙娥，绰约朱颜总已酡。\n莫向风前吹玉笛，恐惊春梦入江波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5098,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题蒲守刘公梅竹二首 其二","author":"薛瑄","text":"此君老矣势犹豪，新长孙枝节渐高。\n好似一门贤父子，清风相倚迥难招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5099,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"韦广文送醯","author":"薛瑄","text":"鼎鼐何堪欠此生，银瓶携送满寒清。\n从今肝膈添诗思，肯使酸斋擅大名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5100,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过贾鲁宅","author":"薛瑄","text":"长平驿是相君家，不见当时富贵花。\n只有苍苍乔木在，至今犹宿夕阳鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5101,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"长平","author":"薛瑄","text":"行过长平惨旧名，路人犹指昔年坑。\n不知当日将军死，地下曾无见赵兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5102,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荥阳道中九首 其一","author":"薛瑄","text":"老亲官定覃怀后，游子南来京索时。\n舟渡浊河高处望，太行秋碧绕天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5103,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荥阳道中九首 其二","author":"薛瑄","text":"前途十里即温城，暂向村林避郁蒸。\n野老多情能款客，呼儿旋撇瓮头清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5104,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荥阳道中九首 其三","author":"薛瑄","text":"一年几度过黄河，霁景清风此日多。\n临流滚滚兴无尽，直欲遥吞万里波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5105,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荥阳道中九首 其四","author":"薛瑄","text":"河水南边广武山，山头簇簇故城閒。\n徘徊不尽千年事，秋草秋花驻马看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5106,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荥阳道中九首 其五","author":"薛瑄","text":"独寻危坂出高冈，蔓草荆榛古道荒。\n谷口人家似仙馆，几间茅屋荫垂杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5107,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荥阳道中九首 其六","author":"薛瑄","text":"一上河濆眼界宽，秋风禾黍动秋山。\n敖仓甬道不知处，唯见孤云自往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5108,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荥阳道中九首 其七","author":"薛瑄","text":"连村绿树乱蝉秋，禾黍离离正满畴。\n为爱中州好风景，挥鞭不厌往来游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5109,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荥阳道中九首 其八","author":"薛瑄","text":"天高地阔鸟云飞，天际凉飙动客衣。\n万物生成看未足，满怀清思正微微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5110,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荥阳道中九首 其九","author":"薛瑄","text":"马上看书意若何，悠悠随处任经过。\n举头忽见南山近，爽气清辉倍觉多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5111,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次刘佥宪见寄韵四首 其一","author":"薛瑄","text":"忆对清阴转午迟，杯行到手欲无辞。\n高山流水今何处，鸿雁南来有寄诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5112,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次刘佥宪见寄韵四首 其二","author":"薛瑄","text":"开缄忽见右军书，丽句清词惬所需。\n何限相思动秋意，蝉声况是晚凉初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5113,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次刘佥宪见寄韵四首 其三","author":"薛瑄","text":"几年持节道途间，骢马遥遥意气閒。\n况有青山随处好，料来诗思未应阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5114,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次刘佥宪见寄韵四首 其四","author":"薛瑄","text":"宪府新成小屋居，居中惟贮旧琴书。\n希声古道应何似，一榻清风乐自如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5115,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"通鉴","author":"薛瑄","text":"千二年来治乱机，只从理欲辨安危。\n若将此鉴为心鉴，三五如何不并归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5116,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"禹门","author":"薛瑄","text":"连山忽断禹门开，中有黄流万里来。\n更欲登临穷胜观，却愁咫尺会风雷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5117,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"渡口","author":"薛瑄","text":"两崖陡起束狂澜，南去沙平势渺漫。\n长有扁舟依渡口，行人莫道往来难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5118,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"栈道","author":"薛瑄","text":"石岩危柱迭相承，阁道萦回接杳冥。\n天上黄流来滚滚，长风五月洒衣清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5119,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"明德宫","author":"薛瑄","text":"碧瓦朱楹白昼閒，金衣宝扇晓风寒。\n摩云观阁高如许，长对河流出断山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5120,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宫前老柏","author":"薛瑄","text":"苍苍老干铸青铜，缕缕香毛引细风。\n自是栽培年岁久，托