[{"title":"与俞按察登大佛阁分韵得深字","author":"王世贞","text":"霜旌逗玄刹，秋色满祗林。\n万井夕阳尽，诸天云树深。\n醉来扶感慨，别至畏登临。\n君欲弹流水，谁传空外音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又得身字","author":"王世贞","text":"飞刹頫嶙峋，超然万界新。\n法莲趺玉井，灵鹫捧金人。\n岂谓相逢地，俱成不住身。\n论文竟何日，挥手向迷津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏大佛又得身字","author":"王世贞","text":"何来布金地，螺髻插星辰。\n谓尔原无相，怜予亦幻身。\n泥洹去兜率，舍利落微尘。\n不见台城叟，终为有漏因。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日过于鳞郡斋分韵十二体得门字","author":"王世贞","text":"握手未能毕，新篘香满樽。\n白云供使者，寒色傍州门。\n一哂中原过，新诗异代论。\n长安故人地，车马自言尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邢州别于鳞 其一","author":"王世贞","text":"西来天地坼，无恙太行城。\n二子狂歌发，千山秋思生。\n世人殊黯淡，何物与纵横。\n不独文章在，兼齐拙宦名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邢州别于鳞 其二","author":"王世贞","text":"春花杜陵陌，慷慨各沾襟。\n不谓人间地，重扶海内心。\n题诗挥白日，把酒笑黄金。\n欲缓征车路，关门斗气沈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别大名王守明辅罗倅虞臣","author":"王世贞","text":"谁令双玉树，袅袅西风前。\n别酒使君醉，高楼明月悬。\n张帆饱秋色，鼓柁下淇川。\n回首丰城剑，时时并斗边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王罗二子","author":"王世贞","text":"局蹐时才甚，浮沉敢望怜。\n自逢双白璧，不惜五朱弦。\n吏事吾宁左，诗名尔竞前。\n好将车马地，一一问长年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"由天津汎舟趣霸水次夜泊 其一","author":"王世贞","text":"高帆去不极，天际见人家。\n系网青枫树，藏舟白荻花。\n回风喧雁鹜，隙月上鱼虾。\n亦有垂纶地，兵戈敢自誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"由天津汎舟趣霸水次夜泊 其二","author":"王世贞","text":"柴门半侵水，入夜蘋花寒。\n野老不识拜，儿童频指看。\n鱼盐仅成市，鸡黍一为飧。\n莫怪慵移楫，人今此地难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贻子相","author":"王世贞","text":"薄禄藏吾道，移官拒物情。\n簿书空自老，衣食自难轻。\n渐削峥嵘迹，谁探黯淡名。\n语君无一可，只是学归耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贻应比部在明","author":"王世贞","text":"屈指交游在，相论涕泪中。\n草成何地碧，枫落故年红。\n心事谁偏就，生涯渐许同。\n还期大河水，双柁鼓春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王丈比部以二诗见怀率尔有答 其一","author":"王世贞","text":"公我丈人行，谁其同舍郎。\n白云辞汉吏，寒月满胡床。\n踪迹时相掩，诗篇意未忘。\n金明无地入，矫首问苍茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王丈比部以二诗见怀率尔有答 其二","author":"王世贞","text":"别来凡几日，霜色转关榆。\n一剖黄河鲤，双遗明月珠。\n故人元不薄，世路转多虞。\n问我疏狂态，君还道有无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭故鸿胪卿王公楠 其一","author":"王世贞","text":"十年符节令，一拜鸿胪卿。\n拙宦元君事，辞官岂众情。\n吾方要坐隐，天忽忌归耕。\n未有延陵剑，秋风涕泪横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭故鸿胪卿王公楠 其二","author":"王世贞","text":"难弟元方并，无儿伯道传。\n青云晚更薄，白发病仍偏。\n尚忆山阴墅，谁题京兆阡。\n西州旧游地，骑马醉潸然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"移司顺义有作 其一","author":"王世贞","text":"孤城寒色里，粉堞自悲笳。\n行饭数秋叶，携书当晚衙。\n谁言是官长，我意等山家。\n独有清尊尽，金鱼未许赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"移司顺义有作 其二","author":"王世贞","text":"偶然吏事薄，敢与山林期。\n白日乍依我，青云将问谁。\n禽归落霞色，花吐凌霜枝。\n欲谢愚公署，恐令车马知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得子与书有感","author":"王世贞","text":"莫问春来色，人间渐不如。\n使星双战地，兵火数行书。\n白发谁堪少，青山也自疏。\n踟蹰但杯酒，深愧吕安车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠万生","author":"王世贞","text":"看君谏议后，疏草箧中遗。\n旧业青山少，穷愁白雪疑。\n书成人未达，酒至尔何辞。\n他日相如贵，毋忘涤器时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"明卿为删定余诗谢之","author":"王世贞","text":"黯淡看人足，峥嵘得句过。\n偶然酬造化，未敢问江河。\n后世谁相定，浮生肯自多。\n还须太玄就，埋著楚山阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶得佳酪巨螯兼致新菜遂成一章","author":"王世贞","text":"酦乳行温玉，烹苔间碧丝。\n螯双落吾手，杯百竟何辞。\n不作他乡味，翻深故国思。\n醉来时自哂，张翰亦吴儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王徵君有子及群从获隽驰此赠之兼为酒约","author":"王世贞","text":"可怜王君公，避世墙之东。\n玉立双桂树，金枝向秋风。\n把臂牵小阮，回车呼阿戎。\n便须酿美酒，要我竹林中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邀李河内石给事冷太仆於使院园亭观菊","author":"王世贞","text":"小阁馀幽赏，西风菊数枝。\n径延三益近，花殿众芳迟。\n薄禄犹能酿，微名懒自持。\n王弘郡斋好，篮舆倘相随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9958,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李二丈给事以诗谢不赴看菊之约走笔倚和","author":"王世贞","text":"不谓吹篪侣，弥甘在涧穷。\n浊醪玄夜隔，高枕白云同。\n处士逃何点，通家识孔融。\n祗应池草助，内史句逾工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9959,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄张大侍御迁吏部郎","author":"王世贞","text":"向来周柱史，仍作汉郎官。\n不尽明光疏，还留启事看。\n青云归藻鉴，白日动衣冠。\n解道嵇康懒，书成也自宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9960,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁暮事稀偶展白傅长庆集不觉有入戏作","author":"王世贞","text":"亦知忧造物，衰怯未辞官。\n薄禄消无计，微名损甚难。\n书斋陶甓旧，灯火白诗残。\n依约中人业，青天可见宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9961,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"閒居偶成","author":"王世贞","text":"偶然吏事简，地寂春风偏。\n小类山中日，因窥静者年。\n啼莺狎久坐，垂柳伴三眠。\n却笑陶徵士，犹烦山海编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9962,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"呼酒","author":"王世贞","text":"草坐呦呦鹿，花含宛宛莺。\n祗应要从事，来此伴先生。\n醉即称中圣，衰从唤老兵。\n嗫嚅诗欲吐，只是畏浮名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9963,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨后途见白云甚奇率尔作","author":"王世贞","text":"宿雨净秋旻，青天掩白云。\n孤峰秀突兀，叠岭琢氤氲。\n雪似昆崙拥，山疑玄圃分。\n因风乞遗屑，持报华阳君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9964,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初秋端居即事效初唐体","author":"王世贞","text":"云衣垂玉蕊，荷泪滴珠丛。\n流萤助幽寂，鸣蝉生晚风。\n孤心合浦叶，远调峄阳桐。\n百感依凉至，烦暑未须攻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9965,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答峻伯 其一","author":"王世贞","text":"雪里蓟门树，北风鸿雁寒。\n故人五载别，逼岁一书看。\n拙宦谋谁长，浮名损自宽。\n论心竟何日，天地转艰难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9966,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答峻伯 其二","author":"王世贞","text":"书来知汝到，飞动意难禁。\n早晚辞天目，栖迟岂众心。\n青袍论旧少，白发著书深。\n莫问公车意，君王在上林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9967,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶怀吴明卿","author":"王世贞","text":"对酒歌天末，潸然记逐臣。\n泥涂名总大，海岳意谁伸。\n自汝愁怀璧，何人不贵珉。\n豫章春水地，处处好垂纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9968,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将赴青州道别医友王昌年 其一","author":"王世贞","text":"荒城不忍别，浊酒暂相亲。\n病骨真须汝，离颜转向人。\n虽无郭泰楫，尚有吕安轮。\n寄语云门胜，应催发兴新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9969,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将赴青州道别医友王昌年 其二","author":"王世贞","text":"海内犹烽色，微官到自嗟。\n我行何处是，汝返末为家。\n落魄交多改，销魂梦转赊。\n鸣驺又冲雪，深羡暮栖鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9970,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓行静海道中","author":"王世贞","text":"北风鼓残腊，河底压春声。\n敲石五更饭，鸣鸡三里城。\n雪妍枯蘖态，月酽早霜情。\n马足何劳问，乾坤任此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9971,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴桥道中","author":"王世贞","text":"三辅行将遍，孤城客久稀。\n朔风深引幔，寒日淡沾衣。\n何物人堪老，浮名计总违。\n黄尘满天地，不点北山薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9972,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"途中杂咏 其一","author":"王世贞","text":"出郭已十里，晨炊犹未烟。\n浮云济阳树，残雪欢阴田。\n蔓杂钩衣转，坡深隐幔偏。\n那能怨行役，马首正茫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9973,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"途中杂咏 其二","author":"王世贞","text":"褰帷过残腊，春事复离亭。\n日气摇沙白，冰文压浪青。\n饥乌惊复下，倦马策还停。\n处处疲奔命，谁能辨使星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"途中杂咏 其三","author":"王世贞","text":"征途时一哂，蓐食向青山。\n物态腰章后，时才手板间。\n渐衰寒自骨，久客厚归颜。\n细数浮生事，渔樵亦未閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"途中杂咏 其四","author":"王世贞","text":"世情安磬折，吾计转萧森。\n已是长途骨，无轻迟暮心。\n诗篇仍稍稍，杯酒遽沈沈。\n回首云门路，春山恨与深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成 其一","author":"王世贞","text":"罢案无他事，行行自灌畦。\n千山来拄笏，一鸟过支颐。\n风雨春时变，云霞晚更移。\n人间聊屈指，何处著吾诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成 其二","author":"王世贞","text":"何山能小鲁，此地亦东秦。\n不尽褰帷色，犹馀抱案身。\n微名宁碍世，薄宦转关人。\n莫问长安道，春来事事新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒食冶园道过大冯子","author":"王世贞","text":"客路兼寒食，千林雨雪霏。\n俱言仲春尽，怕是落花飞。\n禁火柴门掩，穿云猎骑归。\n向君需社酒，还复理冬衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9979,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冶园池亭","author":"王世贞","text":"小憩据胡床，清尊酒未央。\n寒花点新社，疏柳出横塘。\n鱼鸟来相近，琴书课不妨。\n愀然心自语，薄业太湖傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9980,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临朐道中遇雪","author":"王世贞","text":"三月明朝是，初怜景物催。\n孤村重见雪，十日旧闻雷。\n寒暑宁关候，经纶各竞才。\n龙蛇空自出，戒尔急须回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"端午日独坐长山署中有感 其一","author":"王世贞","text":"亦知佳节在，掩卷自沉吟。\n乳燕窥人静，飞花染坐深。\n綵丝儿女事，纨扇岁时心。\n有酒谁堪酌，徒令百感侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"端午日独坐长山署中有感 其二","author":"王世贞","text":"探符与荐黍，兹俗向曾经。\n多难兵何辟，穷愁客转醒。\n柳风阴汎汎，城日昼冥冥。\n欲拟怀沙赋，人间未忍听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9983,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜汝思东巡","author":"王世贞","text":"天遣故人至，顿然消百愁。\n峥嵘尊北海，颠倒榻南州。\n一动延津气，双驱碣石游。\n无须怨行役，秋兴日相酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9984,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"莱阳发道中 其一","author":"王世贞","text":"朝辞莱子国，夕指齐侯城。\n羽檄自旁午，轮蹄交质明。\n微官奔命熟，多难置身轻。\n敢谓云台上，书生有姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9985,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"莱阳发道中 其二","author":"王世贞","text":"褦襶亦何道，驱驰非所怜。\n叩门栖鸟后，炊饭鸣鸡前。\n杳杳海如发，凄凄月似弦。\n十年当此际，多负北窗眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9986,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诸城山行","author":"王世贞","text":"涓然衣带水，忽入松萝间。\n海雨酝秋色，山风澄客颜。\n崔嵬径欲尽，窈窕谷堪攀。\n济胜岂无具，能如玄度閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9987,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜过丘给事懋实 其一","author":"王世贞","text":"亦知朝省贵，犹是孝廉居。\n四壁已如立，一瓢都不馀。\n悠然见肝胆，偶尔及诗书。\n街鼓由他竞，难催刺史车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9988,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜过丘给事懋实 其二","author":"王世贞","text":"苔色车从破，庭阴榻不妨。\n絺衣挂残日，茗椀过新凉。\n世事难深竟，诗名好细藏。\n自怜无一解，得尔爱吾狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9989,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜过丘给事懋实 其三","author":"王世贞","text":"使星齐下邑，巷树鲁东家。\n小立匏尊具，清言布帽斜。\n援琴为山水，倚杖即云霞。\n暂失人间态，风尘到自嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9990,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜过丘给事懋实 其四","author":"王世贞","text":"为载嵇康酒，来陪阮籍棋。\n故人青眼在，高枕白云知。\n海色清残暑，花阴逗晚飔。\n莫须成故事，折简便新诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9991,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕过宋丈宪副","author":"王世贞","text":"稍觉城乌隐，天孙可见过。\n巧应非尔力，拙自定谁多。\n馀兴残瓜果，新凉进芰荷。\n还怜宋之问，不拟赋明河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9992,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"真定刘倅高第就徵","author":"王世贞","text":"手板刘明府，徵书汉省垣。\n已收三辅最，将益九重尊。\n往事蒲堪伏，清朝草易存。\n波臣正愁绝，挥涕问千门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9993,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李乾州风鉴妙天下不轻为人言然独数数属意余因赋答之 其一","author":"王世贞","text":"水镜惭相问，人今岂卧龙。\n尚馀难折项，犹属未归容。\n强饭终玄草，留书比素封。\n此生何所慕，杯酒莫辞醲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9994,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李乾州风鉴妙天下不轻为人言然独数数属意余因赋答之 其二","author":"王世贞","text":"久尔称人相，如吾杜德权。\n青云他燕颔，赤日自鸢肩。\n肮脏虞翻骨，轻肥蔡泽年。\n小儒那足道，天地亦茫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9995,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答吴明卿 其一","author":"王世贞","text":"匡山报无恙，逐客且盘桓。\n天地终难快，风霜稍见宽。\n瀑飞千嶂晓，峡隐万松寒。\n不分吴明府，犹能寄一官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9996,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答吴明卿 其二","author":"王世贞","text":"敢倚金绯在，蹉跎误此身。\n时危输小吏，气尽傍时人。\n自古文章理，尤深放逐臣。\n扁舟五老下，随意破沈沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9997,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答吴明卿 其三","author":"王世贞","text":"风尘催间阔，海岳问离居。\n数掩蛾眉镜，难凭雁足书。\n物情吾岂敢，诗态尔何如。\n莫作穷途恨，千秋幸未疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9998,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答吴明卿 其四","author":"王世贞","text":"七尺如龙马，纵横铁裲裆。\n试言开府使，何似尚书郎。\n老去身终掷，思归事未偿。\n中原一片地，白羽正相望。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9999,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为李千里悼亡","author":"王世贞","text":"东风吹济水，零落百花阴。\n未远乘龙事，空馀射雉心。\n薄寒憎簟入，明月鉴帷深。\n欲掩安仁涕，情来自不禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10000,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答王新甫 其一","author":"王世贞","text":"使君殊好在，五马看仍骢。\n说剑丰城色，振衣天柱风。\n宦携心事远，诗离物情工。\n满目交游态，高秋有一鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10001,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答王新甫 其二","author":"王世贞","text":"问讯劳相及，秋风阻奋飞。\n地垂齐海尽，天入汉京微。\n姓字人堪避，文章计转非。\n报君应不解，笋蕨故园肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10002,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀汝思有寄","author":"王世贞","text":"屈指东游日，人间事事同。\n客愁更许拨，吾懒藉相攻。\n夜色青灯雨，秋天白简风。\n不知从此后，清论向谁工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10003,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]