[{"title":"哭林侍御五首 其四","author":"史鉴","text":"酸风射眸子，南望泪盈襟。\n曾枉下车揖，敢同行路心。\n只鸡千里吊，匹马万山深。\n此意未能遂，凄凉转不禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15395,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭林侍御五首 其五","author":"史鉴","text":"绳愆共所职，下士出常情。\n茶谱羞充贡，医方欲卫生。\n人间不久住，世外若为行。\n想溘埃风起，乘云掩上征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15396,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题旌功庙 其一","author":"史鉴","text":"万马环行幄，平沙走控弦。\n万方三日临，九鼎一丝悬。\n不有维藩议，将为举国迁。\n救时平祸乱，功业冠群贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15397,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题旌功庙 其二","author":"史鉴","text":"李纲才仗钺，谢傅尚围棋。\n庙议如羹沸，都城累卵危。\n维公际艰步，异世若同时。\n指授诸戎帅，从容尽合宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15398,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题旌功庙 其三","author":"史鉴","text":"二圣弘兴继，纶音贲贶同。\n易名维一惠，赐庙录元功。\n精爽风云接，恩光雨露浓。\n公神如不死，感荷九原中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15399,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过横塘","author":"史鉴","text":"西向横塘过，风凉天又晴。\n两山沿路转，一舸问津行。\n野水飞云度，斜阳去鸟明。\n采莲人不见，遥听唱歌声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15400,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"久客无碍方丈赠觉源讲师","author":"史鉴","text":"碧殿明秋水，香台下夕阴。\n堂空莲漏迥，径转竹房深。\n习静疑忘世，含虚已定心。\n何时谢尘鞅，来此事幽寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15401,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中秋闻诸弟宴集湖上有怀","author":"史鉴","text":"乐事愁边减，流年客里过。\n桂香秋色好，天迥月明多。\n欲共嫦娥语，其如良夜何。\n遥知湖上饮，达曙尚酣歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15402,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蕉窗","author":"史鉴","text":"爱此禅房好，芭蕉绿满庭。\n雪中疑入画，定起自翻经。\n晓色和云动，秋声杂雨听。\n心源有甘露，一滴可通灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15403,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冬夜逢临川聂云章话旧","author":"史鉴","text":"频年违晤语，此日贲林坰。\n鬓发缘愁白，家山入梦青。\n功名成潦倒，书剑尚飘零。\n明发松陵道，离歌惜共听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15404,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登多景楼","author":"史鉴","text":"客里一登临，长歌惬壮心。\n江山自今古，人物几消沉。\n潮落淮南近，天垂海外深。\n改之诗尚在，读罢欲沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15405,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游甘露寺","author":"史鉴","text":"清晨游古寺，云气昼昏昏。\n列嶂环京口，长江赴海门。\n平临当北斗，特立见中原。\n无限兴亡事，伤心不忍论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15406,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与沈继南登虎邱天开图画阁奉柬其兄启南","author":"史鉴","text":"投閒倚高阁，林莽半斜曛。\n山势东南尽，河流远近分。\n鸣泉乱秋雨，落叶下寒云。\n欲赋不能道，空惭对卯君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15407,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送赵孟昂归吴兴","author":"史鉴","text":"不到霅中久，登高空自嗟。\n好山多近郭，有客喜还家。\n一带白鸥水，几枝寒食花。\n故人如见问，愁鬓已霜华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15408,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登江淮胜槩楼","author":"史鉴","text":"远水际长天，逢春更可怜。\n钟鸣裹山寺，人唤渡江船。\n渔坞夕阳里，酒家疏雨边。\n因悲客程事，俯仰欲潸然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15409,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"瓜步阻雨","author":"史鉴","text":"客里远经游，那堪有滞留。\n云山几千里，风雨一孤舟。\n树影连江动，潮声撼地浮。\n故园归未得，南望使人愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15410,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"至通州 其一","author":"史鉴","text":"孤城控一区，形势扼东隅。\n海水分咸淡，民风杂楚吴。\n蜃楼凝复散，沙岛涨还无。\n问道寻鱼客，中宵望斗枢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15411,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"至通州 其二","author":"史鉴","text":"绝域经游少，重关启闭严。\n官租兼菽粟，民业尽鱼盐。\n海气朝成市，潮声夜入帘。\n狼山渺何许，空翠远浮尖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15412,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"天目山","author":"史鉴","text":"岧峣古道前，一上思茫然。\n废井存遗迹，残碑记往年。\n岩阴交草色，林薄起炊烟。\n南望乡关远，浮云何处边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15413,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和徐天泉刘完庵同过沈石田友竹居韵","author":"史鉴","text":"去湖三里近，种竹万竿馀。\n径转通幽处，朋来问索居。\n散金时买画，补屋为藏书。\n千古王摩诘，辋川应不如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15414,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过沈继南墓","author":"史鉴","text":"寂寞空山下，凄凉野水滨。\n易名嗟有日，挂剑愧无人。\n月冥猿啼夜，天寒草未春。\n素车来较晚，洒泪忽盈巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15415,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谒徐武功墓","author":"史鉴","text":"絮酒来何暮，凄凉百感生。\n文名推独步，相业沮垂成。\n才大人多忌，功高谤易行。\n只应坟下水，流恨去难平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15416,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"分题得太湖送邬用明还鄞","author":"史鉴","text":"一水遥遥与海通，舟行疑似入虚空。\n三江共接朝宗势，万古长怀底定功。\n茂苑人烟帆影外，洞庭山色浪花中。\n登瀛有客频来往，欲驾云涛趁便风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15417,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠金本清中翰","author":"史鉴","text":"少将词赋继班扬，馆阁周爰岁月长。\n朝罢独书天上诏，使归那有橐中装。\n齐棺古?先秦出，岐鼓遗文后世光。\n乞得鉴湖三十里，四明原是贺公乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15418,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄震泽道士沈长春","author":"史鉴","text":"春风归骑柳边停，一上仙台思杳冥。\n苕水远从天目下，弁山长绕太湖青。\n片云孤鹤吹笙度，千树啼莺把酒听。\n最爱笼鹅能好客，无人援笔写黄庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15419,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"玩月和教谕陈启东韵","author":"史鉴","text":"闽岭岧峣路几层，孤舟载雪兴难乘。\n中秋月好应同见，近海楼高不共登。\n千里信音回旅雁，半生心事对寒灯。\n悲歌莫倚能弹铗，衣马轻肥让五陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15420,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴廷晖令子领举予往贺以诗见赠次韵答之","author":"史鉴","text":"渺渺韭溪居上流，相思无奈驻行舟。\n天香和月浮丹桂，秋水到门来白鸥。\n教子今为探花使，忧君欲起见京楼。\n留连故有新诗赠，高谊难将杂佩酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15421,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和吴益之留题接待寺之作","author":"史鉴","text":"旅寓松陵厌市声，偶从兰若畅幽情。\n水边行道来僧影，壁上笼纱护客名。\n荷叶补衣秋色净，竹房清暑夜灯明。\n庙堂虽与江湖接，未许投閒老此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15422,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送吴泽民归梅堰","author":"史鉴","text":"宾馆穷经独下帷，吾家同叔每相资。\n青山折简招归隐，白首逢人在别离。\n此日梅花应待雪，新年芝草又生池。\n溪边无数垂杨柳，欲绾行舟住少时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15423,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别胡有本","author":"史鉴","text":"秦溪分手各天涯，灯市相逢喜又嗟。\n远地故交能几会，满城春雪向谁家。\n川原近海潮多应，光景催人日易斜。\n明发归舟渺烟水，思君双鬓欲成华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15424,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西园八咏 其一 藏书屋","author":"史鉴","text":"牙签缥带满堂垂，未许沂公独擅奇。\n请俸写来还自校，借人看去岂为痴。\n晴窗露展虞生蠹，净几潜披矢下帷。\n培养真成济时具，又将馀力教家儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15425,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西园八咏 其二 洗砚池","author":"史鉴","text":"试携宫砚洗洄澜，渍墨淋漓最可观。\n龙尾蘸波玄玉净，马肝浮水紫云寒。\n风飘科斗文难定，月射方诸湿未乾。\n头白上卿临帖罢，又书封事献金銮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15426,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西园八咏 其三 松苍轩","author":"史鉴","text":"长松户外郁苍苍，卷幔蛟龙势欲翔。\n韩起曾经誉嘉树，召公今又憩甘棠。\n风生隐几聊闻籁，雨后呼童试采肪。\n君子由来善居室，吾乡亦有岁寒堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15427,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西园八咏 其四 牡丹圃","author":"史鉴","text":"内家丛里许分移，富贵应为造化私。\n承露玉杯和月冷，惜春罗幄护风吹。\n紫台姓魏犹循故，红萼名鞓似较奇。\n一自旬宣江汉后，花开多不在家时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15428,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西园八咏 其五 陇头云","author":"史鉴","text":"陇头云气如车盖，变化油然去复留。\n起处四方沾润泽，乘时六合可浮游。\n风吹度影迷亲舍，日映成文捧御楼。\n楚水秦山千万里，停车北望思悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15429,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西园八咏 其六 门前柳","author":"史鉴","text":"亭亭如盖挺孤标，先世遗来匪一朝。\n色借绿袍荣及第，枝娇黄鸟惬迁乔。\n长承雨露当霄汉，迥出风烟带驿桥。\n不似灞陵原上树，管人离别半无条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15430,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西园八咏 其七 绣衣记","author":"史鉴","text":"渭水园林尺五天，绣衣笔势更翩翩。\n能文况是同年好，叙事还期后世传。\n坐见华风生草木，端知采色画山川。\n长安纸价应增贵，到处令人快睹先。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15431,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西园八咏 其八 太史铭","author":"史鉴","text":"当朝太史汉中郎，曾志先公百世藏。\n指事特书彰直笔，为铭传后发幽光。\n从教雨日长淋炙，莫遣风雷下取将。\n试检平生信无愧，穹碑不独妙文章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15432,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和秦太守廷韶游虎邱韵","author":"史鉴","text":"虎邱寺里相逢处，柳亸花娇路不分。\n泽畔纫兰为杂佩，壁间剜藓读遗文。\n清吟羡得江山助，老懒思将笔砚焚。\n晚漱馀酣泉上立，万家烟火隔松云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15433,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与姚视卿游鸳鸯湖","author":"史鉴","text":"鸳鸯湖上荡舟过，钟鼓声稀拥楫歌。\n落日亭亭经远树，凉风袅袅动微波。\n孤村近水闻鸡犬，小驷穿花见绮罗。\n暝入芙蓉弄秋色，满身香雾月明多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15434,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜宿嘉兴漏泽寺宁庆山房","author":"史鉴","text":"访旧天涯未即归，且来林下叩禅扉。\n孤城暮雨沉更漏，二月馀寒胜客衣。\n近市不眠人语杂，邻僧齐出夜灯稀。\n中宵忽作还家梦，无奈钟声下翠微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15435,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春阴","author":"史鉴","text":"浮云蔽日不舒光，那更东风故作狂。\n宿雨未收添积水，馀阴犹在閟诸阳。\n山林有约空劳望，桃李无言也自伤。\n园柳鸣禽俱寂寞，只生春草满池塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15436,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"访吴廷晖偶成","author":"史鉴","text":"访君还作看花行，宛宛溪流两岸平。\n久雨闭门芳草遍，乱禽栖树莫烟生。\n更筹夜送人皆醉，童子春深服已成。\n明日新晴天气好，相携临水濯尘缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15437,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游胜果寺赴沈文伯之招","author":"史鉴","text":"天地茫茫几废兴，中峰依旧有岩亭。\n江流到海逢潮转，山势如城绕寺青。\n仙洞隔花春寂寂，野云将雨树冥冥。\n幽禽似惜韶光暮，频唤提壶笑客醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15438,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游南峰寺","author":"史鉴","text":"扰扰浮生鬓已星，南峰此日始来经。\n真僧化后今无马，野鹤飞归尚有亭。\n清梵消声莲漏永，夕阳鸣磬石门扃。\n登车欲去犹延伫，满树啼莺正好听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15439,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送智天然住嘉兴东塔","author":"史鉴","text":"山中晚学修禅定，又出升堂了世因。\n汉守故居今入寺，吴僧新住旧为邻。\n池分二水心同净，塔近诸天供献频。\n我亦鸳鸯湖上客，欲来松下问前身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15440,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"沈启南与余约游金陵而先余至又先余归尝闻余谈义兴山水之胜故舍大江与丹阳而不事竟取道于兹将审余之说也因诗以送之","author":"史鉴","text":"草绿莺啼淮水流，柳花如雪暗行舟。\n来期自信成先后，为客那堪有去留。\n此地片时还独住，他山佳处已曾游。\n东归若遇乡人问，春尽乘潮下石头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15441,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴元玉招赏牡丹以无都扶图呼为韵","author":"史鉴","text":"洛阳花事久应无，胜赏今逢在旧都。\n春色祗缘人自惜，衰颜还藉酒相扶。\n时无永叔谁重谱，座有徐熙合写图。\n夜静更持红烛看，满庭如昼鸟惊呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15442,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游灵谷寺","author":"史鉴","text":"缓辔吟行紫禁中，杂花千树映禅宫。\n山藏灵谷声疑应，水出皇陵势自东。\n池上泛杯脩故事，松间扫石坐清风。\n老僧延客无他语，只数前朝有志公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15443,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登狮子山游卢龙观","author":"史鉴","text":"玉辇宸游事已遥，尚遗台观在山椒。\n长江自古为天堑，王气于今属圣朝。\n四海乂安兵久息，千年豪杰恨应消。\n徘徊忽动西游兴，欲借东风驾晚潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15444,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登甘露寺多景楼","author":"史鉴","text":"满目山川又独来，白头怀抱易兴哀。\n郡城宜此开江嶂，佛殿何缘化劫灰。\n万里中原劳怅望，千年鸣鹤自飞回。\n东浮西泛无穷舰，总被潮声日夜催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15445,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"沙溪夜泊柬沈启南","author":"史鉴","text":"有约东游久未齐，孤舟终日住回溪。\n行厨火断从人乞，中夜潮生觉岸低。\n风急海云迷去雁，雨深沙市误鸣鸡。\n明朝应得随君后，遮莫春泥污马蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15446,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"沈启南访汝其通不遇写画赋诗寄之率尔次韵","author":"史鉴","text":"虚室尘埃满榻生，故人来往惜空行。\n剡溪莫谓终无对，震泽从今重得名。\n山寺水村和梦远，渚花汀叶趁江清。\n题诗写画遥相赠，未必王郎有此情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15447,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梦草哀海盐王辂","author":"史鉴","text":"一枕游仙梦复醒，无端芳草最关情。\n生时不惜春风力，见处偏惊夜雨声。\n原野绿齐疑蝶化，华胥调引乱蛙鸣。\n西堂睡起成陈迹，佳句长留万古名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15448,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭武功伯徐公","author":"史鉴","text":"星霣中庭夜已分，始知天欲丧斯文。\n导河犹有随山迹，铸鼎谁铭取日勋。\n四海故人空许剑，万家归马旧从军。\n东吴不是西州路，也学羊昙哭暮云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15449,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"聚远楼","author":"史鉴","text":"新起高楼九溪上，无边风景在虚棂。\n太湖一水际天绿，洞庭两山终日青。\n帆带夕阳来冉冉，雁拖秋影入冥冥。\n何人卷幔吹箫坐，明月满空凉露零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15450,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"于府尹景瞻张太守靖之刘邦彦沈明德宝峰宴集","author":"史鉴","text":"濒湖楼阁少风尘，胜日登临属缙绅。\n北道且依山作主，南飞又见雁来宾。\n霜微岭树红犹浅，水落江蓠绿未匀。\n老我已忘歌舞乐，只将谈笑款杯巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15451,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谢沈彦祥茶鱼之贶二首 其一","author":"史鉴","text":"新采雷鸣寄草堂，未开先作满林香。\n囊裁白绢封三印，芽茁黄金露一枪。\n斗处连场誇得隽，烹时比屋散分尝。\n睡魔渴病俱消却，欲报惭无织女章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15452,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谢沈彦祥茶鱼之贶二首 其二","author":"史鉴","text":"钓得鲂鱼碧浪中，远烦分惠到吴东。\n汉江缩项本同调，松水细鳞斯下风。\n鳍鬣乱欺林笋绿，腹腴微带法糟红。\n珍藏不敢成私享，留待先祠荐麦同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15453,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"问刘邦彦疾","author":"史鉴","text":"遥闻末疾渐加瘳，时向湖山续旧游。\n杯酒尚须行乐用，花枝多为养生休。\n春风杨柳迷归骑，秋水芙蓉隐钓舟。\n何日从君柁楼底，卧听横笛起中流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15454,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游黄山坞","author":"史鉴","text":"行行东去欲何依，为爱禅房入翠微。\n山在不知陵谷变，鹤归应见世人非。\n烟中草树含春色，岭外云霞敛夕霏。\n自笑远人眉目异，野禽惊起溯风飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15455,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别吴兴诸君子","author":"史鉴","text":"杨柳风和溪水平，掉头归去趁春耕。\n青山满眼浑相识，白鸟随人似送行。\n远地几时重握手，孤城今夜独闻更。\n离心好是秋霜剑，无数尘埃拂又生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15456,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送邹师孔游维扬","author":"史鉴","text":"怜君失意向天涯，雨歇虹亭日已斜。\n对酒不须嗟往事，渡江知是客谁家。\n孤城犹系扬州郡，四海空传后主花。\n莫过雷塘吊陈迹，只今残柳尚啼鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15457,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜舍弟铎病起得子","author":"史鉴","text":"卧病经旬为尔忧，今朝最喜是全瘳。\n子虽生晚终延后，菊纵开迟尚系秋。\n杯酒谅随诗共废，田禾无奈雨来收。\n故交赖有宗人在，时肯相过尽日留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15458,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送汪世望还吴兴","author":"史鉴","text":"频年踪迹遍天涯，书剑萧条兴味赊。\n枫冷吴江人执手，月明苕水客还家。\n霜前黄菊惊寒早，湖上青山易日斜。\n落魄布衣今白首，也将诗酒度年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15459,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]