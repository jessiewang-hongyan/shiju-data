[{"title":"挽琼章表妹三首 其三","author":"周兰秀","text":"名闺洵有女如云，君独珠焚与玉沈。\n岂是忌才秋梦短，白头应不怨文君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1030,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆昭齐琼章两甥女","author":"沈智瑶","text":"独立闲庭忆玉人，露桃花下月如银。\n人间纵有伤心事，不及泉台半夜春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1031,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭昭齐姊","author":"沈宪英","text":"云散遥天锁碧岑，人间无路月沉沉。\n可怜寒食梨花夜，依旧春风小院深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1032,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"花下忆琼章姊","author":"沈宪英","text":"弱水蓬山梦不分，红笺无处寄行云。\n海棠睡醒清宵月，影入纱窗疑是君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1033,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春夜忆昭齐姊","author":"沈华鬘","text":"春寒香静月胧胧，闲卷湘帘罢绣工。\n兰烬含花人不寐，独吟残句送归鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1034,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日忆琼章姊","author":"沈华鬘","text":"粉蝶戏兰丛，桃花似面红。\n东风吹不定，飞向玉阶空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1035,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"悼甥女叶昭齐二首 其一","author":"沈倩君","text":"云静烟飞降蕊渊，幽兰比格锦为篇。\n伤心赚梦梨花月，闲锁春风听杜鹃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1036,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"悼甥女叶昭齐二首 其二","author":"沈倩君","text":"无赖衔哀诉上天，愿儿世世绝情缘。\n香魂莫作催花使，恐见牵愁并蒂莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1037,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"悼甥女叶琼章二首 其一","author":"沈倩君","text":"不见妆台伫玉姿，春风何必到花枝。\n绣笼鹦鹉嗈嗈语，犹是儿家旧教诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1038,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"悼甥女叶琼章二首 其二","author":"沈倩君","text":"驾返翔鸾日驾寒，难寻墨子未央丸。\n疏香无主蕉窗冷，欲读遗编不忍看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1039,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆宛君","author":"张倩倩","text":"故人别后杳沉沉，独上高楼水国阴。\n鸿雁不传书底恨，天山流落到如今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1040,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过行春桥","author":"张倩倩","text":"行春桥上月如钩，行春桥下月欲流。\n月光到处还相似，应照银屏梦里愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1041,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日","author":"张倩倩","text":"春衫带绾缕金绡，昼永空闲碧玉箫。\n情到寄将何处好，曲栏杆外折红蕉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1042,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"四月维夏，居也。二章","author":"武氏（文太青妻","text":"四月维夏，浚室闲居。\n户庭绿重，可以诗书。\n四月维夏，百卉俱开。\n清风直入，语鸟不猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1043,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏之日，游也。二章","author":"武氏（文太青妻","text":"夏之日，美人倦起。\n小院闲窗，风摇帘子。\n夏之日，重槐轻柳。\n燕子唤人，园林宜酒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1044,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠外","author":"武氏（文太青妻","text":"林端绿雪，木际红霞。\n诗香思酒，笔藻梦花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1045,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋","author":"武氏（文太青妻","text":"秋意入梧新，独居怅远人。\n芳樽吾负汝，清昼坐伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1046,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春睡图","author":"武氏（文太青妻","text":"烟轻红玉重，惊鸟别湖桥。\n徐起说清梦，如风啭绛桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1047,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"如梦令","author":"武氏（文太青妻","text":"昼阁闲吟玉案，帘卷薰风满院。\n闷则向，花前独立，阑干倚遍。\n堪玩，堪玩，座里清阴一半。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1048,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"初入南国","author":"武氏（文太青妻","text":"南州初入便神清，步步新秋送水声。\n金缕两行浓夹柳，滩云如染照山明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1049,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晋台独夜","author":"武氏（文太青妻","text":"晋台玉镜照春流，绿草朱鳞步步幽。\n百子帐头香自暖，银床归坐夜悬钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1050,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"七夕","author":"邓氏（文太青继室","text":"谁遣鹊梁贯绛河，灵妃应是早停梭。\n云鬟待驾轻飞辇，月镜催妆浅步罗。\n缑氏凤声方未已，汉庭鸾使更相过。\n佳期只恐箕星妒，风雨休教浪作波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1051,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卷帘与夫子联句","author":"邓氏（文太青继室","text":"卷帘且放春风舞，好共花妃入睡乡。\n鸳盏可留佳色醉，早霞如与借红妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1052,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和夫子三出西郊之作","author":"邓氏（文太青继室","text":"幽人问水更携琴，好傍清池发妙音。\n曲径横穿花意密，重台斜拂竹情深。\n荒笼媚菊含金笑，疏木寒禽弄玉吟。\n欲攀艳日留歌席，纵迫归心恋暮岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1053,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金陵九思 其一 一思","author":"邓氏（文太青继室","text":"我所思兮在烈山，欲往从之阻汉关。\n层云高锁二陵寒，侧身南望涕汍澜。\n美人赠我落霞琴，何以报之黄缕金。\n路远莫致倚噤吟，朱湖松浪海潮音，安得开襟啸蒋岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1054,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金陵九思 其二 二思","author":"邓氏（文太青继室","text":"我所思兮在澄江，欲往从之横郧襄。\n兼天彭泽接浔阳，侧身南望涕淋浪。\n美人赠我虎魄燕，何以报之月鹊扇。\n路远莫致倚凄断，天际绮霞连复散，安得扬帆挥净练。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1055,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金陵九思 其三 三思","author":"邓氏（文太青继室","text":"我所思兮在桃叶，欲往从之无桂楫。\n黄河天上难为涉，侧身南望涕厌浥。\n美人赠我一握兰，何以报之双彄环。\n路远莫致倚辛酸，邀笛秦淮荡画船，安得清流采并莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1056,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金陵九思 其四 四思","author":"邓氏（文太青继室","text":"我所思兮在雨花，欲往从之失贯查。\n秦云雪暗乱蓬麻，侧身南望涕交加。\n美人赠我同心梅，何以报之夜明苔。\n路远莫致倚徘徊，先王华表玉为台，安得乘鸾锦昼回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1057,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金陵九思 其五 五思","author":"邓氏（文太青继室","text":"我所思兮在石城，欲往从之哄渭泾。\n八川强半寇纵横，侧身南望涕飘零。\n美人赠我闻遐草，何以报之嗽金鸟。\n路远莫致倚窈纠，莫愁香径菱歌绕，安得飞棹移凫藻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1058,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金陵九思 其六 六思","author":"邓氏（文太青继室","text":"我所思兮在玄湖，欲往从之限孟诸。\n柳断隋堤失茫渠，侧身南望涕连珠。\n美人赠我丽居香，何以报之明月珰。\n路远莫致倚傍徨，芙蓉玉镜艳红妆，安得临风翠盖傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1059,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金陵九思 其七 七思","author":"邓氏（文太青继室","text":"我所思兮在凤台，欲往从之烟雨霾。\n剑天秋气晚风哀，侧身南望涕盈怀。\n美人赠我鸳鸯襦，何以报之上清珠。\n路远莫致倚踌蹰，盝冈茵草带香铺，安得高眺白云衢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1060,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金陵九思 其八 八思","author":"邓氏（文太青继室","text":"我所思兮在燕矶，欲往从之畏鼓鼙。\n愁看越鸟向风栖，侧身南望涕挥衣。\n美人赠我绿桂膏，何以报之赤霜袍。\n路远莫致倚忉劳，俯江春霁浪花高，安得片帆挂远涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1061,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金陵九思 其九 九思","author":"邓氏（文太青继室","text":"我所思兮在鹭州，欲往从之乏紫骝。\n鹿车双挽尚淹留，侧身南望涕凝眸。\n美人赠我紫英裙，何以报之绿熊茵。\n路远莫致倚呻颦，天外长波二水分，安得三山弄月轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1062,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵汪仲嘉戏代苏姬寄郎之作","author":"孙瑶华","text":"由来娇爱竞新知，空结同心不忍持。\n山上蘼芜宁再遇，陵西松柏讵相期。\n罗繻明月君休系，纨扇秋风妾不辞。\n极目自怜春欲尽，流莺飞处草离离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1063,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和陈夫人红牡丹诗次韵","author":"汪宗孝","text":"深叶繁枝芘苑墙，朱颜赢得配花王。\n风回盼盼筵间态，日映杨妃醉后妆。\n娇艳由来称覆锦，秾华应许傍沉香。\n也知春昼饶清赏，烧烛相看更断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1064,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"近秋怀宛叔","author":"王微","text":"已觉江声外，秋情入暮蝉。\n竹光留黯澹，桐影渐孤圆。\n啼鸟当清夜，疏砧隔远天。\n一灯羁客梦，难到石城边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1065,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"仙家竹枝词 其一","author":"王微","text":"幽踪谁识女郎身，银浦前头好问津。\n朝罢玉宸无一事，坛边愿作扫花人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1066,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"仙家竹枝词 其二","author":"王微","text":"不信仙家也不闲，白云春乱碧桃关。\n棋亭偶向茅君弈，一局未终花已残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1067,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"天柱峰","author":"王微","text":"太乙吹炉处，依然刻帝青。\n千峰抱须萼，五石炼真形。\n叨利移金畤，神霄堕碧铃。\n仙衣如可拂，投杖出空冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1068,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"偶作","author":"王微","text":"月凉山气静，风断雁声孤。\n试问同怀侣，宵来得梦无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1069,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴江舟次","author":"王微","text":"昔年从此去，寒雨共孤舟。\n有病淹归旅，无诗记远游。\n半窗残月梦，几树断烟愁。\n未抵荒江外，相思一夜秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1070,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寒夜泊湖上","author":"王微","text":"湖烟暝暝山为空，不开湖面如愁胸。\n吴歌清激水气通，烟收水远出两峰。\n徘徊歌罢月尚东，露花上衣光融融，可怜此月天涯同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1071,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪夜小泛","author":"王微","text":"朔风吹夜雪，听只在菰芦。\n但惜湖山冷，何妨野艇狐。\n滩声疏落雁，鬼火怯啼乌。\n欲写梅花影，敲冰砚未枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1072,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别窗下蕉","author":"王微","text":"窗外重重碧，雨馀密密栽。\n似知明日别，不展寸心开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1073,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"新秋逢人初度感怀诸女伴","author":"王微","text":"忆昔年年秋未分，晓妆一院气氤氲。\n阶前暗印朱丝履，窗里同缝白练裙。\n《子夜歌》成犹待月，六时参罢悟行云。\n即今拾翠溪边望，凉露如珠逗水纹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1074,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖上次韵答黄孟畹夫人","author":"王微","text":"去住湖山别有缘，门前红叶满来船。\n刘纲夫妇霞为骨，谢蕴家庭雪作篇。\n翠袖风前谁薄醉，黄杨树底与参禅。\n回思飘渺伊人迹，只隔鸳鸯南浦烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1075,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寒夜送夏夫人从楚入洛","author":"王微","text":"我游楚二岳，蔗味还在口。\n但恨少室花，一枝难入手。\n襄邓接中原，战镞古来有。\n君过南阳庐，抱膝人存否？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1076,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"今夜寒","author":"王微","text":"今夜寒，寒且永，一灯向壁悬孤影。\n湖南钟动湖北愁，霜风残月夜悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1077,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟居拈得风字","author":"王微","text":"人情各有寄，我独如秋风。\n耽诗偶成癖，聊以闲自攻。\n薄游来吴会，寒轻不知冬。\n樽酒见窗月，仄径幽怀通。\n村烟辨遥林，夜气齐群峰。\n人忘舟亦静，水木各为容。\n恍惚书所对，残灯焰微红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1078,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭黄夫人孟畹","author":"王微","text":"秋堤一片石，谁悟是三生。\n蕙质非松寿，梅魂伴月明。\n遗奁皆竹素，杂组亦瑶珩。\n料得荀家倩，难言不及情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1079,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜归忆邻舟女郎","author":"王微","text":"共春商略夜无眠，拾得闲愁在水边。\n倒似梦中曾见过，一枝春影倚寒烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1080,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闲居","author":"王微","text":"不妨昨日雨，可喜是新晴。\n窗暝从云宿，庭虚待月行。\n闲真难适俗，静乃合诗情。\n冬候常如此，将愁何处生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1081,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汪夫人以不系园诗见示赋此寄之","author":"王微","text":"湖上选名园，何如湖上船。\n新花摇灼灼，初月载娟娟。\n牖启光能直，帘钩影乍圆。\n春随千嶂晓，梦借一溪烟。\n虚阁延清入，低栏隐幕连。\n何时同啸咏，暂系净居前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1082,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"读张秀先传偶题","author":"王微","text":"香烬花嫣月欲秋，卷中留得镜中愁。\n翻怜短命郎边死，不伴残霜燕子楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1083,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴老夫人出访山庄以诗见示次韵赋答","author":"王微","text":"春园如吾庐，居停偶相许。\n双松既以荫，片石遥可语。\n夫人惠然来，清风散孤墅。\n茗论欲入弦，花情亦浮醑。\n栖迟每无恒，飘摇感云绪。\n却缓山中期，眷此人外侣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1084,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"拟燕子楼四时闺意","author":"王微","text":"淡烟如梦罨重帷，楼外晴丝与泪吹。\n判得莺花笑憔悴，不能轻薄学杨枝。\n何须莺语唤春回，浓绿眉痕展不开。\n多谢伴愁梁上燕，只将孤影入楼来。\n罗衾自垒怯新凉，无寐偏怜夜未央。\n生死楼前十年事，砌蛩帘月细思量。\n照心残焰见床空，死忆分明梦不通。\n才到四更窗外白，峭寒轻絮一楼风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1085,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭韩夫人","author":"王微","text":"乍闻埋玉已三年，墓产神芝舌产莲。\n记得夙生曾受记，只教不住鬘持天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1086,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春夜留别","author":"王微","text":"朝朝还夕夕，春与梦中看。\n月有痕知怨，花无言欲残。\n羁魂游处怯，醉影别时寒。\n一水何曾隔，其如去住难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1087,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怨梅","author":"王微","text":"庭树亦如昨，故人来何时。\n花花自蚤发，偏尔独开迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1088,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"代梅答","author":"王微","text":"寄语问花人，岁月那能借。\n尔意怨迟开，侬意怜迟谢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1089,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"庚申秋夜予卧病孤山闲读虎关女郎秋梦诗怅然神往不能假寐漫赋一绝并纪幽怀予巳作木石人尚不能无情后之览者当如何也","author":"王微","text":"孤枕寒生好梦频，几番疑见忽疑真。\n情知好梦都无用，犹愿为君梦里人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1090,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"病中听雨","author":"王微","text":"山雨遥侵夜，过春尚作寒。\n却怜灯火寂，反与病相安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1091,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山斋坐月","author":"王微","text":"月上桐阴薄，闲阶夜气清。\n与君到晓坐，幽思自然生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1092,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"有人以断肠草寄怨予偶见戏反之","author":"王微","text":"木名有连理，草名有宜男。\n花有枝并头，禽有翼鹣鹣。\n西方鸟共命，东海鱼比目。\n莲花千万亿，鸳鸯三十六。\n方州有交合，山县有阴阳。\n合璧表玉德，双股别钗梁。\n绣被百子衾，文枕蟠螭绮。\n调听双声谐，人指双星喜。\n相思为唐殿，合欢是汉宫。\n雀屏开甲乙，龙剑匣雌雄。\n之子赋断肠，称物作苦语。\n聊拈嘉耦名，其他未遑举。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1093,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽赵凡夫 其一","author":"王微","text":"吴中真陨少微星，洞中犹摹石上经。\n耆旧凋残猿鹤怨，支硎山色为谁青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1094,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽赵凡夫 其二","author":"王微","text":"最难同学又同修，夫妇双栖百尺楼。\n到得一丝不挂处，长空孤月自悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1095,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"颗小姬画兰 其一","author":"王微","text":"借郎画眉笔，为郎画纨扇。\n纨扇置郎怀，开时郎自见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1096,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"颗小姬画兰 其二","author":"王微","text":"幽窗墨麝浓，《骚经》亲自注。\n为恨子兰名，抹入棘丛去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1097,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月夜留宿冯夫人池上","author":"王微","text":"爱君池下影，时来池上眠。\n落花映修竹，静起一帘烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1098,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冬夜怀宛叔","author":"王微","text":"寒灯怯影黯疏帏，霜月留魂露未晞。\n我梦到君君梦我，好迟残梦待君归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1099,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀宛叔","author":"王微","text":"不见因生梦见心，自愁孤枕与孤吟。\n如何永夜曾无寐，悔向湖边独独寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1100,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]