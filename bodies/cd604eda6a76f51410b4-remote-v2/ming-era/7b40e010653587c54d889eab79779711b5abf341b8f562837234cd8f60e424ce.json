[{"title":"听行春伎歌","author":"沈守正","text":"听惯吴娃似发歌，妖喉越调恣情吪。\n傍人道我桓子野，拍拍惟闻唤柰何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40390,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠柴云倩 其一","author":"沈守正","text":"三世托通家，从来见赤騧。\n稍能露头角，不喜醉琵琶。\n日照琳琅树，风回锦绣霞。\n清芬一以接，捉手冂人夸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40391,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠柴云倩 其二","author":"沈守正","text":"文江摇绚烂，肃矣见先刑。\n安世抽三箧，玄成守一经。\n明窗黄叶满，屧几夜灯青。\n宁似东邻子，摊书不识丁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40392,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠柴云倩 其三","author":"沈守正","text":"鲲翅日图南，江花笔阵酣。\n胸涵秋涧水，眉带夕峰岚。\n我有难堪七，君期不朽三。\n连舟复连骑，似蔗嚼逾甘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40393,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠柴云倩 其四","author":"沈守正","text":"名园藏屋里，下阁又登台。\n有此幽栖地，何妨暂一回。\n终军非赋客，贾谊亦凡才。\n之子揣摩就，芳名贯耳雷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40394,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画赠云倩","author":"沈守正","text":"去冬冬雪十年稀，裹树埋山太笨肥。\n宁似玉颜春雪样，和烟带雨故依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40395,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀沈君接 其一","author":"沈守正","text":"与君灵鹫十年身，我别君留百感新。\n千里同舟淮角酒，一樽小坐断桥莼。\n君家春酿碧于水，此处山茶赤似唇。\n两志栯情兼有恨，梅花西碛少谁人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40396,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀沈君接 其二","author":"沈守正","text":"雪光落盏白如银，西涧流澌几日春。\n自叹穷途同阮籍，何须潭水忆汪伦。\n凤仪暂戢无妨达，鹤口新添未便贫。\n故里故山谁好事，书来细写似鱼鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40397,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"放灯至二十日止","author":"沈守正","text":"昔闻赵寿阳，人日赐餔觞。\n茂宰广斯意，华灯续焰长。\n笙歌隘广陌，烟火媚前行。\n士女倾城出，皆云乐未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40398,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灯夜咏所见 其一","author":"沈守正","text":"小术接高衢，星河缀火珠。\n沿门看舞马，人□必神鱼。\n燕燕莺莺者，三三五五俱。\n微闻红袖底，啧啧使君殊。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40399,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灯夜咏所见 其二","author":"沈守正","text":"烛龙穿绣陌，一道滚香尘。\n逐队惊闻笑，吹烟误唾人。\n绾丝三寸玉，约指一双银。\n小邑无奇事，兹当纪日辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40400,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元夕骤雨","author":"沈守正","text":"繁星灿烂银花溅，锦绣成帷香风煽。\n可怜难得菖蒲花，千门万户人争羡。\n须臾海若片云低，蟾蜍吐沫龙收电。\n虹桥紫陌滑如油，坠珥遗钿何暇求。\n谁家裙带结两头，少年拾得心悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40401,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"借鹤 其一","author":"沈守正","text":"君家孤鹤不成眠，疏影寒窗亦悄然。\n巳办春粮三十斗，暂邀灵翮伴今年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40402,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"借鹤 其二","author":"沈守正","text":"凌霄落落恨偏多，雌去雄留可柰何。\n为间韵人能作合，一声清唳一声歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40403,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"借鹤 其三","author":"沈守正","text":"鹤癖多年在故山，如逢旧友意相关。\n五更嘹喨君犹共，两度荷香即遣还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40404,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初度 其一","author":"沈守正","text":"人年将及五，如日渐晻■。\n纵有胸怀在，难同蹀躞时。\n别离妻子叹，贫傲故人嗤。\n为语当途子，龙藏未易知。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40405,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初度 其二","author":"沈守正","text":"采蓬传旧俗，生我值兹时。\n怡悦桃花面，棓櫑杨柳枝。\n笑当迎富日，偏咏送穷诗。\n短发今如此，浮沉任所之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40406,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答献叔折杏花见赠是日予初度","author":"沈守正","text":"每到花朝转寂寥，劝君莫更问花朝。\n一枝遥赠非无意，秾李夭桃未许娇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自出东郊插柳 其一","author":"沈守正","text":"绕溪越陌渐成行，自笑闲身为柳忙。\n安得好风兼好雨，催他踠地万条长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自出东郊插柳 其二","author":"沈守正","text":"西湖莺燕太猖狂，骂叶穿条镇日忙。\n寄语明年□海曲，不知何处是吾乡。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从吴司李乞江瑶柱答诗索和用韵 其一","author":"沈守正","text":"西驰怒岭似承茎，懒出浑如坐树莺。\n嚼得新诗清且旨，车螯螺蛤敢争鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40410,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从吴司李乞江瑶柱答诗索和用韵 其二","author":"沈守正","text":"西湖十里尽莼羹，偏爱江瑶品外清。\n宕语龙宫休宝惜，仙人昨巳下金茎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40411,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再答吴司李江瑶柱诗用韵","author":"沈守正","text":"东海波深玉甲新，浴兰初罢荐奇珍。\n珧瑶字义何须辨，苏赵于今有几人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40412,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶兴","author":"沈守正","text":"小池春水亦汪然，白鹤桃花非世间。\n睡起大声呼煮茗，兴来小笔乱涂山。\n风生苹末纤纤织，月上林端细细湾。\n此日胸中无一事，庄周梦蝶未为闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闷","author":"沈守正","text":"今年二月寒如冬，春光惨淡人意慵。\n雄风雌风花命薄，欲雨不雨山睡浓。\n摊籍懒将思兀兀，闭门何物来冲冲。\n明朝后朝无杲日，?掷行春九节筇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜凌巨先同两儿至","author":"沈守正","text":"马蹄尚及七分春，眉带双岚尘满巾。\n忆别江于俄四月，同来鹤外益三人。\n海鱼似婢皆云美，越酒如银竞入唇。\n夹座快谭乡国事，不知匏系不知颦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江瑶柱歌","author":"沈守正","text":"冰盘一寸堆明玉，妍旨清腴忘海肉。\n舌本犹夷比拟难，海错千般等奴仆。\n侧生新摘香色全，湘莼四月滑可怜。\n将支作妃莼为媵，政恐江瑶未粲然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乞海棠","author":"沈守正","text":"嫣红嫩粉艳丝丝，缱绻从君乞一枝。\n恐似西川杜工部，笑他不作海棠诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瓶中梅谢易以海棠","author":"沈守正","text":"胆瓶狼籍满匡床，尽是梅妃夜洗妆。\n况遇玉环新睡起，空教憔悴怨三郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中海棠","author":"沈守正","text":"海棠红不数胭脂，微雨低垂艳艳丝。\n却似女儿含泪眼，凭栏怨蝶骂莺时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃花","author":"沈守正","text":"小槛桃花烂，春风镇日狂。\n飘零应似我，狼籍不成妆。\n芳草如有意，游蜂空自忙。\n因之念堤树，十里散霞光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨","author":"沈守正","text":"春雨何太恶，轰雷更助嗔。\n阶平盈尺水，蕉长来年身。\n莺哑浑无韵，龙腥似傍人。\n邻家海棠树，应作马嵬尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜晴","author":"沈守正","text":"闲过寒食与清明，桐有新芽菊有萌。\n久雨燕如窥幕妇，快晴人似得霜鹰。\n便思东郭田间去，转忆西湖柳外行。\n浊酒数杯诗半卷，望舒树杪又初生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王献叔招饮绣球花下","author":"沈守正","text":"昔年快阁曾看雪，今日花开当雪看。\n乍似解颜迎客笑，折来催酒向唇干。\n尚分杨柳毵毵绿，亦怯春风颤颤寒。\n可惜海棠零落尽，暂邀肥婢与盘桓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"步至九峰寺","author":"沈守正","text":"谷雨相催物物新，散行时让汲泉人。\n共听牧子吹芦管，一任松花打角巾。\n有竹有藤将废寺，好风好日半闲身。\n安能移榻溪流上，怪石高梧作比邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春暮 其一","author":"沈守正","text":"闲门镇日可张罗，丛桂新条长旧柯。\n无可柰何春事短，不如归去鸟声多。\n江城三月犹巢燕，野俗群儿喜斗鹅。\n洪饮苦吟俱意懒，试茶邮水一朝过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春暮 其二","author":"沈守正","text":"微凉小馆寄墙东，树影泥香尽日封。\n春到九分人梦梦，花留一片转秾秾。\n叩门大率皆凡鸟，吊古无端忆醉龙。\n老至渐多荏苒叹，故乡霞外隔千峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游方山寺","author":"沈守正","text":"错趾高于顶，千盘入寺幽。\n潭腥疑有物，树古且当休。\n怪石蹲如虎，山僧跳似猴。\n荒凉半亩地，游幸未经秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登方山绝顶","author":"沈守正","text":"卷舌唾东海，扬裾蹴塔巅。\n云争生客坐，日隔下方烟。\n问水来何远，乘潮不辨天。\n孤城千百户，广野一蜗蜒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"到云影院自此下甚险","author":"沈守正","text":"小院标云影，云来影若何。\n老杉晴日少，危□□苔多。\n入谷石摩腹，逢崖弟唤哥。\n奇情因险夺，不暇问金鹅。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒朱子祠","author":"沈守正","text":"夹路山如画，蘼芜野自花。\n到门沿曲涧，隔浦是农家。\n委羽仙踪远，尚书石马斜。\n高风藏古木，朝暮有栖鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画怀柴式谷","author":"沈守正","text":"万株古树万重烟，万仞波涛万顷田。\n极望平沙云影薄，不知何处是淄川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小病 其一","author":"沈守正","text":"碌碌苦长日，微疴似放闲。\n不梳蓬白发，对几设青山。\n驯鹿依人惯，寒皋学语艰。\n因便谢俗客，幽意自相关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小病 其二","author":"沈守正","text":"桐影日如钱，经行倦亦眠。\n病奇心自识，医宦古无传。\n小饮生红晕，微吟坠粉莲。\n闲书犹懒读，说鬼气萧然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴司李拂衣 其一","author":"沈守正","text":"马首青山伴客行，秋风一叶似官轻。\n留宾无复陈惊座，嫚骂谁容弥正平。\n弛担簿书催酒散，跳波珠玉斗诗成。\n延陵簪笏辉前后，五柳新栽别有名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴司李拂衣 其二","author":"沈守正","text":"悔山一过一迟疑，今下欢溪遂所思。\n薄送愧临千尺水，宦囊嬴有半游诗。\n张公洞口云如昨，西子湖头柳似眉。\n闻说荆溪可依隐，酒鎗茶曰猛将随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴公子自天台归阳羡","author":"沈守正","text":"延陵公子字嘉名，古锦奚囊发赤城。\n绣岭不争雄构绣，清溪专为壁人清。\n亭亭白鹤云中起，渺渺朱霞天末生。\n彩笔巳还无可赠，他年竹下共班荆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄哭赵文度 其一","author":"沈守正","text":"梦也连宵见，何期叹逝川。\n浮生悭六十，纸力定三千。\n故友珍残墨，孤儿泣砚田。\n江南江北页，一展一汪然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄哭赵文度 其二","author":"沈守正","text":"每叹今人少，今真作古人。\n烟云传影像，山水失□神。\n洒笔千秋在，横身一木贫。\n世情君久谙，穗帐几多亲。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄哭赵文度 其三","author":"沈守正","text":"与君深素气，不独爱山容。\n灵鹫三年月，寒山一夜钟。\n闲情谈艳异，多难忆吴淞。\n未审长归日，曾不及转蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻画者丁叟亦逝","author":"沈守正","text":"云间望六新奄忽，南羽犹称七十人。\n将是玉楼开影像，一图云树一图真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽吴司李堵夫人 其一","author":"沈守正","text":"秋入天台长簟清，安仁此夕不胜情。\n幽溪只是平时水，呜咽流成别样声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽吴司李堵夫人 其二","author":"沈守正","text":"竹林血泪一何多，自顾瓶罍耻柰何。\n丹□若还经妒庙，不妨高唱挽郎歌。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巨先归闻游天台诸胜诗以讯之 其一","author":"沈守正","text":"归思适当秋，秋霖压马头。\n闷添三日坐，凉赠一程游。\n寒灶犹存否，石梁闻小休。\n离台无怒岭，下剡有轻舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巨先归闻游天台诸胜诗以讯之 其二","author":"沈守正","text":"应接知无暇，山山似送迎。\n奇惊瀑布布，霞想赤城城。\n鸟路缘箐度，痴童舍骑行。\n杳然俱太古，略有午鸡声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巨先归闻游天台诸胜诗以讯之 其三","author":"沈守正","text":"委羽日以远，回看可奈何。\n何须孙赋合，只似米山多。\n赶石果奇绝，幽溪曾一过。\n更能迟半月，红树满岩阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄尤含","author":"沈守正","text":"山行不足水行看，万朵芙蓉万顷澜。\n一路逢僧知姓字，到家迎妹问平安。\n汝归紫蟹黄柑近，我睹衰芦败柳难。\n寄语亲朋无好况，病愁专不为毡寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40446,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"不寐","author":"沈守正","text":"桐翻雨滴气萧然，远砌悲凉那得眠。\n病似漏壶安枕上，梦惊故友到床前。\n谁家孤鹤偏长唳，何处风声不可怜。\n芡实如珠藕如臂，强宽食假亦明年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40447,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独居","author":"沈守正","text":"梧子空阶落，金风拂面来。\n人当星散后，花尚月终开。\n无夜不闻漏，有时思上台。\n衔杯不肯醉，何用酒铛催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40448,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自遣","author":"沈守正","text":"有发无家一病身，秋风飒飒石粼粼。\n毒龙暑退狞翻浪，野鵩星稀苦魇人。\n纵是青山非我土，便多红树岂真春。\n若无坐拥专城乐，柳叶虽繁不当颦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40449,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独行","author":"沈守正","text":"独行独立小池边，衰柳疏疏当发看。\n亲旧□行七八字，家乡斗米百三钱。\n门无好事闲莲勺，病捡方书问药船。\n正是新凉好时节，却如春半恼花天。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40450,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中","author":"沈守正","text":"朝梳白发乱成堆，昼减青精夜旷杯。\n落叶何繁愁里听，漏声如诉闇中催。\n浮生谁免老病死，良药无过归去来。\n只待桂花狼籍后，便辞羽洞下天□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40451,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病起 其一","author":"沈守正","text":"一身多病百缘轻，萧飒风来体渐平。\n阁求诗书随意懒，梦游山水逼人清。\n调鸠上掌喃喃语，遣鹿看门笃笃行。\n桐叶满阶留不扫，爱他踏处亦秋声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40452,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病起 其二","author":"沈守正","text":"饮罢觥船亦自欢，小除行散影珊珊。\n生来何必皆文士，譬是先迁一左官。\n无病尚当哀局促，有身何患不圞团。\n东郊小筑西桥月，乘兴休歌客路难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40453,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚出依隐精舍","author":"沈守正","text":"病骨秋风渐渐轻，薄凉出郭带微醺。\n催红败绿霜前雨，懈白柔蓝水上云。\n闲听鸟声如法鼓，远看路草是腰裙。\n莫言此地真堪隐，巳有新鸿不可闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40454,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"依隐精舍次修能韵","author":"沈守正","text":"依隐亦何为，爱此精庐癖。\n青山若围带，斜连城数尺。\n插柳虽未成，有竹摇寒碧。\n篱落隔沟塍，牛行不见脊。\n风翻杮叶黄，云系山腰白。\n遥见林薄间，先霜数点赤。\n不记几枰棋，山鸟忽焉夕。\n我亦客中主，况子客中客。\n共谋一日欢，安问来与昔。\n幸无俗人嬲，惬此清言适。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40455,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚步 其一","author":"沈守正","text":"落日云如赭，远山嶷嶷碧。\n杳蔼绝人踪，高槐夹修陌。\n酷似山寺中，回廊转西壁。\n风铃乍有无，禅房深欲夕。\n我亦似发僧，挂钵依香积。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40456,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚步 其二","author":"沈守正","text":"月出净如洗，山水发其姿。\n山光澹而冶，广池沦且漪。\n微风吹蓼花，颤颤如不持。\n爱此地上影，往来互参差。\n良月静人意，鹤警撩繁思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40457,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]