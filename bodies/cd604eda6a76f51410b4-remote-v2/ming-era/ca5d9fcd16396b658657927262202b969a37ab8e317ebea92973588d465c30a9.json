[{"title":"桥山","author":"李梦阳","text":"青宫栖古岑，白露静松林。\n忽下乌号泪，遥悲龙去深。\n衣冠万国后，辙迹四方心。\n一气流群帝，哀哉笙凤音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55140,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"瓠子","author":"李梦阳","text":"沈璧馀瓠子，横汾怀帝歌。\n波涛满眼送，城郭没年多。\n虎战仍三晋，龙游失九河。\n宋人饶事迹，今望亦滂沱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55141,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岘山","author":"李梦阳","text":"大名终不灭，堕泪此山碑。\n后进才非乏，风流尔足师。\n古堂阴汉水，新路改城池。\n回首隆中接，秋云两处垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55142,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鹿门山","author":"李梦阳","text":"庞公真汉陇，孟子复唐诗。\n旧宅新秋叶，孤坟千载遗。\n泉袅石穴细，葛倚松门垂。\n望望青峰近，君襟旷尔期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55143,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬日过故王坟二首 其一","author":"李梦阳","text":"寂寞何王殿，遗坟此径孤。\n玉阶番雪草，野日自金铺。\n庑暝牛羊聚，林风鸟雀呼。\n白头香火者，犹护赤龙符。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55144,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬日过故王坟二首 其二","author":"李梦阳","text":"二冢累累接，聊城复定安。\n情哀宫独盛，世异柏同残。\n久雨石门塌，新霜帷殿寒。\n西陵时节望，谁见绮罗叹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55145,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"令婆坟","author":"李梦阳","text":"国初抡秀妪，分遣入周宫。\n但睹丘坟郁，宁知乳哺同。\n后王忘昔日，颓屋锁春风。\n寒食莺啼切，林花落自红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55146,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"始谒徐祠","author":"李梦阳","text":"庙古傍湖偏，春行更可怜。\n楚城芳草遍，红日此堂悬。\n榻想陈公后，时悲孝献前。\n亦知遗像误，瞻拜泪油然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55147,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"徐墓书张相国碑铭","author":"李梦阳","text":"不读南州传，谁知高士心。\n江城遗冢在，春日古祠深。\n竹鸟嘤嘤合，松墙靡靡阴。\n曲江千载碣，书罢泪盈襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55148,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陈祠在徐墓东","author":"李梦阳","text":"可讶司徒庙，偏邻孺子坟。\n哲人堪一哭，汉鼎竟三分。\n门引江畔草，榻留松上云。\n纷纷车马客，谁此荐清芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55149,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"韩文公祠","author":"李梦阳","text":"袁州山在城，韩庙倚山清。\n冕服前朝貌，文章百代名。\n石苔犹马路，春竹自莺声。\n立望潮阳近，翻翻海气征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55150,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武阳郡公祠","author":"李梦阳","text":"惠爱前人迹，追思后代心。\n洪都观察庙，香火古江浔。\n白日江山过，青松霜露深。\n亦知精爽异，应厌鼓鼙音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55151,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"徐苏二祠","author":"李梦阳","text":"孺子真高特，云卿崛后先。\n挥锄傲汉冕，捆屦卧江烟。\n宁饫糟糠毕，耻同贪浊全。\n凄凉百代宇，怅望一潸然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55152,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鹅湖书院","author":"李梦阳","text":"书院佛堂边，颓垣岭谷连。\n四时僧酒扫，千古俨高贤。\n立壁东莱毅，悬河子静偏。\n众流终一海，流泪考亭前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55153,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"经长陵诣黄花镇","author":"李梦阳","text":"沙岭群峰会，黄花一径穿。\n临崖防马骇，枯木有蛇悬。\n锁钥关门壮，星辰陵阙连。\n旧驱悲虏贼，得失岂皇天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55154,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"白洋城","author":"李梦阳","text":"京西太行崦，孤垒白洋间。\n巳巳曾通贼，居庸并立关。\n水合桑乾去，峰连塞上山。\n圣君敷远德，秋日战旗闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55155,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"至黄花","author":"李梦阳","text":"黄花城压岑，山合昼多阴。\n坐见五陵雾，来为九月霖。\n泥生剑戟涩，寒重鼓鼙沉。\n寂寞松林外，那传孤雁音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55156,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"银山寺","author":"李梦阳","text":"银山倚铁壁，天外削三峰。\n下见林中寺，来闻午后钟。\n僧徒住石屋，雷雨拔门松。\n西望诸陵接，云成五色龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55157,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出塞二首 其一","author":"李梦阳","text":"胡蔓黄河限，秦亡紫塞存。\n碛沙浮落日，寒雾宿疏墩。\n哨马三边动，烧荒千里昏。\n将军拜金印，白骨不曾论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55158,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出塞二首 其二","author":"李梦阳","text":"碛日淡无晖，胡沙惊自飞。\n望烟寻戊垒，闻雁忽沾衣。\n大将搜河套，游兵出武威。\n贺兰山下战，昨日几人归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55159,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"环县道中","author":"李梦阳","text":"西人习鞍马，而我惮孤征。\n水抱琵琶寨，山衔本钵城。\n裹疮新罢战，插羽又徵兵。\n不到穷边处，那知远戍情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55160,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寺","author":"李梦阳","text":"不睹空王宇，谁兴浩劫心。\n散花疑白象，布地果黄金。\n水雾飞梁洒，夕阳迥殿阴。\n独嗤簪绂客，游赏托云林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55161,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"繁台春望","author":"李梦阳","text":"野旷孤烟静，高台独望时。\n地残隋氏苑，天阔禹王祠。\n晚日云争白，阴崖花自迟。\n目断南来雁，萧然故国思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55162,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"繁台别业","author":"李梦阳","text":"地亦因台峻，天能纵屋高。\n宋朝四帝国，禹庙九河涛。\n上下见陵墓，风烟含野蒿。\n昔人闻醉此，简懒愧吾豪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55163,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"高远亭","author":"李梦阳","text":"虚亭盖树杪，四顾果平芜。\n嵩岳杯前出，浊河窗外纡。\n寺杉时送响，塔鹳每来乎。\n一约朋知饮，归车醉每扶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55164,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"诣别业","author":"李梦阳","text":"局蹐岂吾事，郊游惟独行。\n风回疑引骑，雪落故连城。\n塔树凝先白，台云曳未平。\n感时侵岁晚，白发暗心惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55165,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登盘山顶顾望三湖","author":"李梦阳","text":"为访三湖寺，春山独自来。\n千盘不到顶，万壑划争回。\n石罅鸣鸡犬，林风过虎豺。\n俯观侯赵树，西望白云台。\n峰日明寒雪，溪泉激暗雷。\n若非武陵口，那得有桃开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55166,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中湖寺二首 其一","author":"李梦阳","text":"龙象何年地，千岩一涧回。\n我来寻石镜，隔竹望香台。\n树绕啼猿入，人从鸟道来。\n坐飧霞气晚，只拟是天台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55167,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中湖寺二首 其二","author":"李梦阳","text":"陟崄扣岩扉，一钟鸣翠微。\n丹崖森竹树，雪壁映花飞。\n屋隙鸣泉写，山昏麋鹿归。\n松风高壑起，云卧欲沾衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55168,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南湖","author":"李梦阳","text":"中湖果奇绝，逾岭复南湖。\n石磴回相倚，岩泉有乍无。\n开窗众壑积，当殿一峰孤。\n更览千林竹，因怀长啸徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55169,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"北望畏雨不至","author":"李梦阳","text":"乱山上云气，孤客发西岑。\n徒瞻北湖寺，其如东路心。\n岭猿愁瞑雨，岩鸟下空阴。\n回首太行麓，萧萧松橡林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55170,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"下南湖","author":"李梦阳","text":"湖僧骑牝马，相送石门峰。\n欹仄乱石路，日瞑渔樵逢。\n苍茫翠微里，风落青山钟。\n羡尔岩居者，终期尘外踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55171,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晓行云梦泽","author":"李梦阳","text":"晓行云梦泽，云起失湖村。\n历历横江雨，冥冥远岫昏。\n鼋鼍当马吼，鸥鹭背人翻。\n欲拟浮湘作，吾生异楚魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55172,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"刘家隔","author":"李梦阳","text":"匹马淮山尽，孤舟渐楚歌。\n远商吴蜀杂，新雨汉江波。\n骄雁斜斜下，轻鸥片片过。\n整帆迟明发，天色定如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55173,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浮汉","author":"李梦阳","text":"杳杳向前城，杨船浮汉行。\n水闻天上转，色出雨中明。\n已近鸣鵙月，长看龙雾生。\n陈诗叹秣马，风浪独含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55174,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浮江","author":"李梦阳","text":"浮江晴放舸，挂席晓须风。\n日倒明波底，天平落镜中。\n开窗问赤壁，捩柁失吴宫。\n万古滔滔意，浔阳更向东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55175,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九江","author":"李梦阳","text":"九江江九流，庐岳负江州。\n世代催前浪，图书羡上游。\n城孤落日映，虎去暮天幽。\n夜笛邻舟送，曲终无限愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55176,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"发九江","author":"李梦阳","text":"已发南风盛，须时且复停。\n岸沙延系缆，竹色隐回汀。\n行待江水稳，卧看庐阜青。\n此生谁固料，湖海一浮萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55177,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丰安庄","author":"李梦阳","text":"地气南逾热，僧林晚暂栖。\n云开一江去，日在万山西。\n修竹凉风至，昏鸦古木齐。\n凭高忽洒泪，清世有征鼙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55178,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"圆通寺阻雨","author":"李梦阳","text":"岩扉邻虎穴，淹坐面猴江。\n山动云生服，风回雨入窗。\n渐交松际响，蓦斗石间泷。\n铃磬烟萝外，高峰只自双。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55179,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"圆通寺阻雨闻石门涧桥断水涌阻往东林","author":"李梦阳","text":"石门雨断桥，途阻虎溪遥。\n仄想远公室，秋莲应尽飘。\n愁猿吟雾里，落叶重林腰。\n更有天池望，岩岩向碧霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55180,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五老峰","author":"李梦阳","text":"东南涛浪吞，五老古今存。\n秀色彭湖浴，诸峰庐岳尊。\n中宵见海日，南斗豁天门。\n霜雪颜常静，云烟解变魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55181,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再至洞院","author":"李梦阳","text":"昔别秋色苦，今游风涧清。\n穿石竹犹活，雨过泉自生。\n礼殿古门换，钓台新路平。\n独来谁每见，云日此峰情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55182,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"回流山亭","author":"李梦阳","text":"亭高山尽入，回首见鄱阳。\n天地开吴楚，弦歌有宋唐。\n峰云低栋白，湖日倒碑黄。\n六月吾来此，凉风不可当。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55183,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"折桂寺","author":"李梦阳","text":"折桂何朝院，开基分翠峰。\n窗明五老雪，门掩半崖松。\n泉瀑飞人过，香台印虎踪。\n千岩谁得到，百里但闻钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55184,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"团山登望","author":"李梦阳","text":"团山当县口，石壁对朝饶。\n日静湖波敛，天低岛色遥。\n风云馀霸气，吴楚混前朝。\n秋水年年落，英雄恨不消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55185,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"芝山望","author":"李梦阳","text":"吴楚分何代，乾坤此郡孤。\n江从树里断，山入雨中无。\n战斗名空在，英雄世与徂。\n酒酣抚长剑，极目尽重湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55186,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"芝山寺感事","author":"李梦阳","text":"偶到芝山寺，遥伤荐福碑。\n霜雷十月动，秋战万家悲。\n凉入丹枫堕，崖高黄葛垂。\n洪钧融万物，黔首独旌旗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55187,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"龟峰","author":"李梦阳","text":"立壁有天地，浮云无古今。\n仲冬诸客到，落日乱峰阴。\n峭峡通人过，危岩把酒唫。\n奇多看不彻，昏黑更登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55188,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泊安仁","author":"李梦阳","text":"官舟商泊同，城近月濛濛。\n戍鼓夜长击，渔灯时自红。\n乌鹊枝难稳，豺狼穴易空。\n向来论大树，心切古人风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55189,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铅山","author":"李梦阳","text":"山水交闽越，东南古县闻。\n一峰晴冒雪，雨水昼蒸云。\n石井鹅湖倚，车盘鸟道分。\n儒宫荆棘里，寒叶痛纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55190,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"明远楼春望","author":"李梦阳","text":"贡院初开阁，春阴独倚栏。\n柳边千舰聚，花里万家残。\n风雨江声壮，兵戈地色寒。\n断肠沙雁北，群起向长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55191,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"市汊夜泊","author":"李梦阳","text":"此夜章江月，无端照独舟。\n人生真梗泛，岁暮且帆游。\n腊逼寒灯焰，波吞霁雪流。\n坐吟风雁起，渔笛满前洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55192,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丰城夜泊","author":"李梦阳","text":"夏至北风至，晚清凉意增。\n江船逼新月，沙色乱疏灯。\n暗桨故相拨，浮阳还自蒸。\n倚樯看剑气，仍见斗间曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55193,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟往临江即事","author":"李梦阳","text":"直岸含风细，中江放舸安。\n地随帆席转，风进晚潮残。\n霞树迎窗过，晴山卷帽看。\n遥惊双浴鹭，色举向云湍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55194,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨泊丰城","author":"李梦阳","text":"古岸花层湿，阴江鸥半飞。\n波回撼船重，雨侧入帘微。\n潭爱金华涌，亭伤宝气稀。\n二年三历此，肠断北舟归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55195,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜行旰江","author":"李梦阳","text":"灯火遵山闪，旌旗折路频。\n仙坛沓不见，片月故须亲。\n土俗渐异楚，人言多杂闽。\n岂无嚚不足，讼简爱吾民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55196,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赴新喻","author":"李梦阳","text":"露树且乌啼，孤舟晨向西。\n萧滩千百转，昏暮到罗溪。\n古驿屯云密，平沙没日低。\n扬帆更前去，月夜不须迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55197,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"自进贤趋抚州","author":"李梦阳","text":"炎域霜何厉，寒泉木欲稀。\n肩舆随落叶，晨日上征衣。\n路势东南转，北风鸿雁归。\n东乡新血战，巢破鸟犹飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55198,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"云山渡","author":"李梦阳","text":"渡古云山积，江明日色饶。\n霜融木更落，野静路堪遥。\n冠盖行相望，干戈气未消。\n伤心弄兵者，汝业本渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55199,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"玉峡驿夜泊","author":"李梦阳","text":"暑泊无风夜，江船深自凉。\n云纤沾葛细，月涌去波长。\n古峡衔孤驿，名山引玉梁。\n前途堪跃马，旦发问仙乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55200,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"白沙驿","author":"李梦阳","text":"沙古幽幽白，江新泯泯清。\n水衔村作国，山绕驿为城。\n万里将南徼，孤槎且暮征。\n壮心与落日，的的向波明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55201,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宜春台春望","author":"李梦阳","text":"古州图记见，今望临高台。\n人倚楚天尽，风驱湘色来。\n密云生晓瞑，远水上春雷。\n尚有干戈泪，冯轩眼倦开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55202,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"涧富岭赴安福二首 其一","author":"李梦阳","text":"三月赴安城，遥攀岭路行。\n前驱真避虎，绝壁亦啼莺。\n周览物色换，极高云气迎。\n俯看南赣路，孤舸会将征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55203,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"涧富岭赴安福二首 其二","author":"李梦阳","text":"山行忽百里，步步山情新。\n萝拥千盘透，花齐万谷春。\n寒暄不异地，忧喜暂随人。\n默诵垂堂戒，私嗟名利身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55204,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郁孤台","author":"李梦阳","text":"朔日送客返，慨然登郁孤。\n悲歌为闽广，指顾尽江湖。\n南俗羌夷杂，北流章贡俱。\n兵舸尚满眼，绎绎诣饶都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55205,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晓至邬子驿","author":"李梦阳","text":"湖夜乘风过，天明见驿楼。\n数家依独树，落日隐春洲。\n日抱越峰上，江奔吴徼流。\n姚源东水外，兵甲气还浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55206,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再至玉虚观","author":"李梦阳","text":"龙沙欣自昔，久泊遂今期。\n雨露新松大，丹青旧殿移。\n岸云通绣栱，江日抱金池。\n欲倚门东阁，愁看日暮时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55207,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"仙楼","author":"李梦阳","text":"仙楼忽欲暝，钟鼓下江烟。\n独坐一烛秉，当门新月悬。\n石寒坛近斗，沙静树浮天。\n半夜朝群帝，珊珊羽节还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55208,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谢岩秋日始集","author":"李梦阳","text":"百战江山在，吾来草木秋。\n孤城洞口落，襄水席边流。\n去国双王灿，题岩只谢侯。\n醉归忆山简，飞兴习池头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55209,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋望","author":"李梦阳","text":"蝶戏犹馀蕊，蝉吟已怯枝。\n乾坤入汉日，霜露望乡时。\n屈子偏生楚，王通不负隋。\n晚风江更苦，莫上岘山祠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55210,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]