[{"title":"侍游西苑应制 其四","author":"杨士奇","text":"太液波晴属豫游，凫鹥鸂䳵近龙舟。\n御前应制惭无补，但咏卷阿荅棹讴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3857,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"侍游西苑应制 其五","author":"杨士奇","text":"一片帘泉泻不休，别看喷玉出金虬。\n须教流下天津去，散作恩波润九州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3858,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"侍游西苑应制 其六","author":"杨士奇","text":"九曲流泉碧玉清，红莲逦迤送金觥。\n洛中胜事循周典，共侍宸游宴镐京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3859,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"侍游西苑应制 其七","author":"杨士奇","text":"频奉纶音近御床，圣情无已念先皇。\n从臣总是先朝旧，叠赐金壶白玉浆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3860,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"侍游西苑应制 其八","author":"杨士奇","text":"颁来文扇出天恩，上有天章训饬频。\n侍罢御筵重拜赐，尚书前面独千缗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3861,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"侍游西苑应制 其九","author":"杨士奇","text":"御厩飞黄敕送归，禁中不敢醉驱驰。\n恩深难忘㳙涘报，愿诵豳风七月诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3862,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送龚燧宪使致仕 其一","author":"杨士奇","text":"平生心在恤痌瘝，一日辞荣出九关。\n袖却向来经济手，去循南浦看西山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3863,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送龚燧宪使致仕 其二","author":"杨士奇","text":"非才误下钓鱼矶，徒遣缁尘满素衣。\n八帙年华双鬓雪，同乡惆怅不同归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3864,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题玄宗游骊山图 其一","author":"杨士奇","text":"上马含娇不任扶，君王揽辔待齐驱。\n蓬莱宫里三千女，独自骊山从乘舆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3865,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题玄宗游骊山图 其二","author":"杨士奇","text":"五队如花出帝城，年年扈跸赴华清。\n剑门西畔听啼鸟，竟有谁从蜀道行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3866,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅赠挺孙南京都察院检校","author":"杨士奇","text":"铁作枝柯玉作花，精神冰雪净无瑕。\n看图常砺操脩志，莫忝南州清白家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3867,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陈照磨赴湖广 其一","author":"杨士奇","text":"青春白晢多才思，往往明珠辱赠诗。\n江汉南游五千里，锦囊还解寄相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3868,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陈照磨赴湖广 其二","author":"杨士奇","text":"凤凰山前宪使堂，寻常六月凛飞霜。\n堂中使者清于玉，黄鹤白云离思长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3869,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹赠马谨守礼御史","author":"杨士奇","text":"直道而行马御史，冰霜节操铁心肝。\n一庭竹色门如洗，坐对清风到岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3870,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送崇式贰尹后馀意未已更续绝句","author":"杨士奇","text":"贤兄擢桂官朝署，令弟哦松向海邦。\n文水仁山多盛事，周家白璧又连双。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3871,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鸿胪卿杨善父挽诗 其一","author":"杨士奇","text":"家临晋水客燕山，晚际明时逝不还。\n乡里到今谈旧德，一生高致乐萧閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3872,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鸿胪卿杨善父挽诗 其二","author":"杨士奇","text":"积书教子清风满，置酒延宾白昼长。\n锦诰封官出身后，天恩千岁有□□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3873,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送敬侄 其一","author":"杨士奇","text":"吾家贤宰宰长垣，客墓荒凉有子孙。\n六十馀年未归得，至今源本重深恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3874,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送敬侄 其二","author":"杨士奇","text":"两回南上谒先茔，更省同宗上帝京。\n远道驱驰见诚孝，诗书慎勿坠家声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3875,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送敬侄 其三","author":"杨士奇","text":"文献传家五百龄，怜渠北郡久飘零。\n是行好记殷勤嘱，清渭无将混浊泾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3876,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题东山洞宾 其一","author":"杨士奇","text":"莫讶征西旧司马，平生山水爱幽探。\n白头匡济成何事，回首东山已自惭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3877,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题东山洞宾 其二","author":"杨士奇","text":"神仙只在人间世，来往千峰万壑云。\n至道非关有传授，他年那得吕岩闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3878,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送刘习之 其一","author":"杨士奇","text":"晓辞丹陛出神京，一席秋风万里程。\n舟过螺川宁省处，乡闾争羡锦衣荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3879,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送刘习之 其二","author":"杨士奇","text":"尊府先朝老缙绅，贤郎新榜又登名。\n君今广宪红莲幕，月照冰壶分外清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3880,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送刘习之 其三","author":"杨士奇","text":"东广迢迢万里馀，西风落日片帆孤。\n临行不尽同乡谊，更写馀情在画图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3881,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题鹓侄画","author":"杨士奇","text":"员峰涌翠云浮玉，盘古洲前颇似之。\n鹓也诛茅好结宇，待予解绶共栖迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3882,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"集句酬刘士简","author":"杨士奇","text":"无才日衰老，常在羁旅中。\n词人取佳句，独赠白头翁。\n旧绣移曲折，新诗作寄将。\n开缄风涛涌，感子故意长。\n文章千古事，持荅翠琅玕。\n但令无剪伐，日日报平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3883,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清平乐 其一 赐从游万岁山词","author":"杨士奇","text":"御河冰泮。\n禁籞春光满。\n中使传宣陪赏玩。\n西过蓬莱仙苑。\n内街许骤花骢。\n新醅敕赐黄封。\n共侍翠华游豫，仰承霄汉恩浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3884,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清平乐 其二 赐从游万岁山词","author":"杨士奇","text":"五云仙岛。\n海上蓬壶晓。\n红巘丹崖春正好。\n香动玉华瑶草。\n飞龙翠辇初来。\n翔鸾宝扇齐开。\n圣主乐同贤辅，愚臣自愧非才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3885,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清平乐 其三 赐从游万岁山词","author":"杨士奇","text":"广寒宫殿。\n晓驻黄金辇。\n天上彤霞平近眼。\n俯看碧云芳甸。\n乾坤六合皆春。\n荣光瑞彩津津。\n浩荡云飞川泳，甄陶总出皇仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3886,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清平乐 其四 赐从游万岁山词","author":"杨士奇","text":"碧池千顷。\n湛湛涵天影。\n清似玻瓈明似镜。\n洞见柔条新荇。\n金鳞翠羽夷犹。\n红桡画桨歌讴。\n何幸盛时多暇，共陪太液清游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3887,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清平乐 其五 赐从游万岁山词","author":"杨士奇","text":"凤池龙舸。\n画楫黄金柁。\n亭午虹桥西畔过。\n琼管瑶筝相和。\n彤亭面面彫栏。\n天光云影盘桓。\n世外银潢玉宇，春前丽景清欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3888,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清平乐 其六 赐从游万岁山词","author":"杨士奇","text":"小山千丈。\n粲玉蕖仙掌。\n鹤桧鸾篁森拱向。\n春逗万年枝上。\n黄金矫矫蟠龙。\n青岩洒洒轻风。\n口喷汪洋天泽，须教大地年丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3889,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清平乐 其七 赐从游万岁山词","author":"杨士奇","text":"石渠清泚。\n宛转千花里。\n翠勺金莲传玉醴。\n潇洒落红流水。\n连茵坐饮悠哉。\n流杯饮过还来。\n圣主恩深如海，醉教马上扶回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3890,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清平乐 其八 赐从游万岁山词","author":"杨士奇","text":"瑞禽灵兽。\n自古希奇有。\n鸾凤来仪麀鹿伏。\n好似舜庭文囿。\n传宣特赐奇观。\n山呼拜舞腾欢。\n清世泰和嘉应，圣人道合乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3891,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清平乐 其九 赐从游万岁山词","author":"杨士奇","text":"玉京仙境。\n瑞气融春永。\n明主承天天锡庆。\n雨顺风和嘉应。\n讴歌四海丰年。\n箫韶九奏华筵。\n圣世均调玉烛，皇图帝寿齐天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3892,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清平乐 其十 赐从游万岁山词","author":"杨士奇","text":"施恩宣化。\n一统函夷夏。\n端拱垂衣几务暇。\n光被普天之下。\n簪缨扈从游巡。\n乾坤万物皆新。\n荡荡太平熙皞，吾皇万岁千春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3893,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉寿思贻兄 其一 浣溪沙","author":"杨士奇","text":"皓月当庭照彩灯。\n华筵春透酒如渑。\n昔年把酒记吾曾。\n今日杨园宾客聚，寿星相应德星明。\n六千里外独思兄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3894,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉寿思贻兄 其二 南乡子","author":"杨士奇","text":"春意满阶除，玉色梅花照鬓须。\n老子寿年过九九，欢娱。\n醉影婆娑不用扶。\n萧散一尘无，绿树青山处士居。\n兄弟别离三十载，何如。\n春雁来时定寄书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3895,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"木兰花慢 寄寿仲亨兄","author":"杨士奇","text":"簪缨四百载，记科第、有家传。\n羡双玉连枝，柏台冰雪，栗里风烟。\n逍遥葛巾藜杖，傍青山绿竹俯丹泉。\n天赐十分清福，人尊八帙高年。\n一尘不到研屏前。\n綵笔映华笺。\n想菊畔题诗，梅边作赋，佳趣依然。\n儿孙书香宦业，看名家庆泽远绵延。\n望望德星南极，寿觞正聚群贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3896,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿蹇少卿","author":"杨士奇","text":"四纪廷臣，三朝国老，左班领袖官僚。\n手扶红日，两度上青霄。\n一片丹诚，奉主持恭谨，不间纤毫。\n从容处、调羹事好，补衮更才高。\n君臣鱼水契，龙章凤敕，前后华褒。\n看满怀春意，富贵无骄。\n嘉庆今年七十，梅舒玉香蔼宫袍。\n更百岁、康宁寿福长，远佐唐尧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3897,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"水龙吟 寿建安少傅","author":"杨士奇","text":"一星南极辉光，每年腊节明朝见。\n黄封赐酒，翠盘仙脯，画堂张宴。\n济济嘉宾，谋谟耆老，文章英彦。\n想从初独禀，武夷之秀，金榜登高选。\n早侍九华春殿，彩毫挥、五云腾绚。\n驱驰扈从，东征北讨，马蹄行遍。\n身仕三朝，手调金鼎，芳名驰远。\n愿长年佐辅，皇恩帝德，百寮冠冕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3898,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿时勉李学士","author":"杨士奇","text":"霁月光风襟度好，文章清比琳璆。\n蓬莱山近殿东头。\n论忠献纳，鹄立侍宸旒。\n六十今朝初度日，明朝又届中秋。\n桂花香泛紫金瓯。\n宾筵为寿，不住算觥筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3899,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿黄学士","author":"杨士奇","text":"好花开到红榴，帝城明日端阳届。\n先生寿旦，官厨细酒，士林嘉会。\n内阁当年，七人同事，四人今在。\n一人千里外，还留鼎足，欢相对、须拚醉。\n不改平生刚介。\n更华发、朱颜无改。\n声名事业，安荣忧患，从前无愧。\n绀雪晨餐，黄庭昼咏，出尘潇洒。\n碧云冠，往来天台雁荡，作人间瑞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3900,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"归田趣 其一 春牧","author":"杨士奇","text":"霜鬓萧萧，皇恩重、赐归田里。\n郊郭外、草亭四面，青山绿水。\n好鸟好花春似昔，同时同辈人无几。\n一布袍、棕帽任消摇，东风里。\n芳草岸，平如砥。\n垂杨径，清如洗。\n散牧处、冉冉晴霞飞绮。\n江色比于怀抱净，都无一点閒尘滓。\n更小儿、牛背有书声，清人耳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3901,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"归田趣 其二 夏耘","author":"杨士奇","text":"诏归田里，长散诞、天恩深厚。\n寻早岁、钓游之处，风烟依旧。\n万物方当嘉会日，一年最是清和候。\n畅幽怀，缓缓步东皋，观耘耨。\n竹色净，槐阴茂。\n荷铺翠，葵舒绣。\n农忙际、儿子大家趋走。\n频有莺声迎杖屦，浑无尘影沾襟袖。\n望水南、云似玉光浮，笼岩岫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3902,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"归田趣 其三 秋渔","author":"杨士奇","text":"七十归来，西江上、堪游堪钓。\n秋水共、长天一色，也堪吟啸。\n稳坐木兰渔艇子，大儿能网中儿棹。\n小儿自、理会爇香炉，烹茶灶。\n蘋花渚，雪争耀。\n枫叶岸，霞相照。\n山无数、清比方壶员峤。\n放浪不知天地外，萧閒底用元真号。\n听数声、长笛白鸥前，江南调。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3903,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"归田趣 其四 冬樵","author":"杨士奇","text":"白首閒居，冬风冷、偏欺衰老。\n晨光动、瀰漫院落，六花飞绕。\n坐煖茅柴煨芋栗，老妻孙子围炉好。\n更儿曹、腰斧析枯薪，归来早。\n阶前璐，池边缟。\n都总出，天工巧。\n石山峰、庭下尽成琼岛。\n况是太平丰稔瑞，教儿爱护休轻扫。\n看园林、一鹤意萧萧，寻瑶草。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3904,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"玉楼春 大雪志喜","author":"杨士奇","text":"天公预作丰年瑞，柳絮梨花纷舞坠。\n九重城阙晃清辉，一统山河含淑气。\n郊原遍是琼瑶地，梅蕊稍头春早至。\n未论寅卯太平年，且赏嘉祥宣德岁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3905,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"初度夕","author":"杨士奇","text":"生朝谢客草草，家筵聊向夕。\n绿酒黄柑，庆我今年七十三。\n烛花送喜，绕簇连枝金粟蕊。\n小小孙儿，也学诸兄跪献诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3906,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日谒陵","author":"杨士奇","text":"庭鞠早含霜，又到重阳。\n盈盈白发对清觞。\n回忆往时文翰侣，大半凋亡。\n纵佩紫萸囊，怕上高冈。\n眼昏那见旧家乡。\n但见三陵云气里，愁损柔肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3907,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和答复古先生","author":"李时勉","text":"兹山稀行迹，嘉木自繁阴。\n我尝爱山行，坐来生隐心。\n阳崖飞清瀑，阴谷响春禽。\n会非遗纷虑，焉知山水深。\n青苔雨里滑，石路君独寻。\n参差惜乖违，何以惬往忱。\n兹竭岁华力，相逐历青岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3908,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"旱","author":"李时勉","text":"孟夏久不雨，赤日赫高丘。\n沟浍无蓄水，江浦无深流。\n山田禾未插，农老剧增愁。\n扫地设雩祭，望云坐田头。\n霖雨不可得，密云终日浮。\n顾此重悽伤，俛仰亦何求。\n天瓢有馀滴，孰济苍生忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3909,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"野老望云","author":"李时勉","text":"桑树春鸠鸣，农事起来早。\n仰视天边云，来往田间道。\n虹电耀西渚，白日行穹昊。\n涧少一线水，田多去年草。\n欲犁不得雨，种苗复枯稿。\n耕穫恒饥苦，不耕难自保。\n伤哉罹此忧，欲从首阳老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3910,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送解学士布政广西兼行交趾事时平交趾立郡县","author":"李时勉","text":"阁前冠冕照青春，日下除书拜紫宸。\n神武又平南海尉，绥怀遥寄玉堂宾。\n鹓鸾不久违中禁，礼乐从今及远人。\n何处相思不相见，斜阳独立楚江滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3911,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄惯穷老人还乡","author":"李时勉","text":"塞门迢递雁门开，疋马萧萧入楚来。\n从此云萝成隐逸，不妨水竹久徘徊。\n归田剩有閒居赋，观国惭无济世才。\n自是因君怀旧隐，望乡频上凤凰台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3912,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山家春晓","author":"李时勉","text":"日高照见松窗里，照人春眠犹未起。\n家僮洒扫及中堂，唤起客来供盥洗。\n披衣随步小窗外，杨柳依微莺细语。\n皆言昨夜风雨恶，绿树披离花满地。\n老父庭前扫落花，扫开春径莫教遮。\n怕有客来寻旧术，不妨竹里引轻车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3913,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"田家日晚歌","author":"李时勉","text":"东郊草长牛正肥，沟渠水通田可犁。\n老翁向田姑哺儿，新妇廚中炊独迟。\n归来对客少閒语，但说田家有辛苦。\n春寒种谷不著泥，北风吹麦皆入土。\n里胥徵税不得了，丁男出官多奔走。\n两月山中去不归，老身那似少年时。\n春深田家百事急，田多草荒犁不及。\n野鹿呦呦满旧山，随牛终日在田间。\n纵及收成罢耕作，官家无事身始閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3914,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清明","author":"李时勉","text":"昨日街头初禁烟，今日清明烟火传。\n家家齐上坟头拜，更剪荆榛挂纸钱。\n东郊古碑翳荒草，近陇累累谁洒扫。\n问著樵夫说姓名，子孙繁华难自保。\n轻裘骏马谁家儿，东阡西陌纷相随。\n斗残蹴鞠忽归去，还向高堂纵歌舞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3915,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"古意寄曾学士二首 其一","author":"李时勉","text":"百川日夜流，浩浩以东注。\n环海几万里，不见涯涘处。\n混涵无不容，日月自吞吐。\n风波任荡潏，贝错极生聚。\n万古长若斯，焉能为量数。\n蛟龙挟云雨，倏忽甘泽布。\n深弘有如此，岂比寻常具。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3916,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"古意寄曾学士二首 其二","author":"李时勉","text":"梧桐生崇冈，亭亭出云林。\n一朝樵夫采，斤斧来相寻。\n幸尔爨下馀，斲削成素琴。\n粲粲弦朱丝，烨烨徽黄金。\n当窗试一弹，悠然太古音。\n清风流水远，白云苍山深。\n世无钟子期，谁能识其心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3917,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"立雪斋","author":"李时勉","text":"讲学志已笃，更欲从明师。\n鹄立在函丈，翼翼慎其仪。\n岂不思退逸，进修当此时。\n朔风吹前庭，雪落何霏霏。\n凝心注道妙，不觉寒切肌。\n自非素志坚，安取青名垂。\n阳风激高唱，兔苑誇严辞。\n徒然骇众听，名教竟何裨。\n揆予慕前修，将殊世俗为。\n轩居既旷达，岂徒积书诗。\n勖哉崇明德，贤哲与同归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3918,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白土洞烧丹","author":"李时勉","text":"阆仙几年洞中去，采药烧丹是何处。\n乍临炉鼎聚精神，便觉林峦蔼烟雾。\n由来仙骨少尘心，丹砂易得成黄金。\n姹女初凝碧天晓，河车欲转紫霞深。\n深幽好似崆峒里，炎井龙游虎渡水。\n绛雪晶荧宜可同，金砂的皪宁堪拟。\n腾光烛夜天宇清，寻常白日起风霆。\n空山魑魅啸争讶，绕林猿鹤时相惊。\n世人曾见洞天启，恍遇蓬山羡门子。\n刀圭入口可长年，何必还餐石中髓。\n知君好古意犹勤，卖药壶中秋复春。\n不肯吹笙向缑岭，要将仙术济时人。\n我亦平生慕仙道，神游八极身已老。\n眼前胜境未得亲，遥望蓬瀛郁怀抱。\n年来多病少见知，欲服还丹谁为持。\n可遣沉痾脱然去，放歌为作还丹诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3919,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]