[{"title":"木炭","author":"朱之蕃","text":"墨沼苍龙蜕骨坚，冰霜难犯地炉边。\n送来雪里寒威重，领取春回煖律先。\n炙手何劳争倚附，熏心喜见息风烟。\n乌金声实真相称，不朽精神藉火传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58854,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"田家乐","author":"邓渼","text":"烟火高原合，鸡豚小市通。\n夜行防虎阱，寒至筑牛宫。\n捕雀遵桑翳，浇麻引竹筒。\n今年倍收秫，不怕瓮头空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58855,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"耕隐为南昌万用中赋","author":"来复","text":"山庄别筑楚城西，百亩桑阴水一溪。\n莎草雨晴黄犊卧，稻花风暖白鸠啼。\n沽来官酒春祈社，读罢农书晓灌畦。\n孝悌力田新有诏，姓名还向御前题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58856,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南浦春耕","author":"德祥","text":"索索缲车谷口闻，鸟催农事日纷纷。\n新生野水瓜藤绕，旧作田塍井字分。\n耕雨每怜黄犊健，带经犹爱小儿勤。\n晚风独立溪桥外，流水桃花一队云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58857,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"省敛","author":"何洛文","text":"翠华缥缈出明光，帝亩油油晓露瀼。\n田畯秋登歌万宝，宸旒时敛足千仓。\n欣瞻垄覆黄云满，想见匙翻白雪香。\n耕藉三推蒙帝力，连茎累岁纪农祥。\n即看荐熟流馨飶，更识忧民念雨旸。\n六合长应书大有，愿陈豳雅表时康。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58858,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"樵","author":"朱之蕃","text":"行歌伐木隐林中，平楚高原四望通。\n爱踏春山萦碧草，醉眠秋壑舞丹枫。\n唯留松柏团成盖，不许荆榛竞作丛。\n半岭夕阳归路稳，乘风破浪为谁雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58859,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀朱渔父","author":"江仲鱼","text":"九溪深处似严滩，渺渺风尘白眼看。\n叶艇每随幽嶂出，茅房孤掩落花残。\n芙蓉衣上云千片，杨柳溪头月一竿。\n钓罢瓦瓶曾共醉，满身零露不知寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58860,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峨溪晚钓","author":"德祥","text":"牛渚山前白鹭飞，船头坐得便无机。\n莺从柳絮风中听，鱼到桃花水后肥。\n有梦只因怀太白，逢人多是说元晖。\n一壶春酒江村暮，泊在峨溪醉不归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58861,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虾子禅","author":"王守仁","text":"杖藜何处问虾禅，回首胥村锁暮烟。\n一曲渔歌秋浦外，腥风吹满渡头船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58862,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"颂古诗","author":"普慈","text":"每嗟船子惯垂纶，恒泊溪边荻映身。\n人问不言头自点，恐惊鱼去不应人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58863,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"牧","author":"张居正","text":"是处桑麻好，田家乐事同。\n耕夫閒白昼，牧竖趁春风。\n短笛云山外，长林雨露中。\n命俦还藉草，相与说年丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58864,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"牧","author":"朱之蕃","text":"择地求刍两得宜，欣看茁壮望蕃孳。\n薰风永昼蓑堪枕，残日荒村笛任吹。\n海上平津封已晚，窖中属国节空奇。\n长原浅草清流绕，倒跨徐归信犊儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58865,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"牧牛","author":"王锡爵","text":"垄上归来跨牸行，扬鞭遥指暮云生。\n明朝共把春犁去，闻道君王欲省耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58866,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"织锦机","author":"瞿佑","text":"绿纱窗下响咿哑，知是秦川第几家。\n五色染成长命缕，双头挽就合欢花。\n只愁转轴劳筋力，莫谩投梭损齿牙。\n不似绣床閒坐倦，自将辛苦作生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58867,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"剪刀","author":"瞿佑","text":"巧制工夫百鍊钢，持来闺阁共行藏。\n双环对展鱼肠快，两股齐开燕尾张。\n针线有功凭制造，绮罗无价任裁量。\n随机镂出新花样，长在佳人玉指傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58868,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴门归入惠山寺","author":"邹迪光","text":"胜游不惜屡，馀兴尚淋漓。\n竹路青相借，花宫翠乱披。\n酒阑留月住，曲半受风吹。\n为问梁溪夜，何如吴苑时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58869,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚过新兴寺","author":"张宇初","text":"晚过新兴寺，扶藜野步轻。\n鸟啼春雨足，花落午风晴。\n僧室连云住，山阿带雾行。\n武陵归路近，已听涧松声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58870,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日重游穹窿山海云精舍","author":"姚广孝","text":"迢递青村外，崎岖紫逻间。\n过林才见日，到渡不逢山。\n一室依岩险，双扉傍竹閒。\n曾看云际鹤，向暮独飞还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58871,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题海云寺","author":"德祥","text":"香刹住中流，初疑地若浮。\n路从沙际入，帆到树边收。\n清磬敲渔夜，新书报橘秋。\n洞庭西在望，欲去更迟留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58872,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同庵新居","author":"德祥","text":"新居劳种植，隙地不教閒。\n作圃先通水，栽松欲借山。\n鸟逢春尽到，云向晚都还。\n独许王摩诘，题诗在壁间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58873,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿甘露庵","author":"海旭","text":"舟出太湖险，语溪投暮钟。\n听风多在竹，看月不离松。\n柝护城三里，鸡鸣村一重。\n长安明日路，霜草滑归筇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58874,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题指月庵","author":"照源","text":"短扉将绿掩，小径倚村斜。\n老树借藤叶，新桐布屋花。\n渔歌传外港，鸥梦立前沙。\n静者离言象，门题指月家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58875,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水寺","author":"际瞻","text":"孤寺水中起，净心宛在虚。\n钟边云易湿，松外地无馀。\n幢影鱼窥熟，梵音风定初。\n入秋看月上，清切复何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58876,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚坐弘济寺","author":"阮大铖","text":"古柳参差掩寺门，荆篱石埠自为村。\n风严乌榜通菱浦，日落渔炊就荻根。\n野月荒荒难辨色，江峰寂寂更何言。\n灯前无限浮沈思，销在菰香水鹤喧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58877,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送谦选中住花泾寺","author":"溥洽","text":"秋风一棹入花泾，杨柳芙蓉接水亭。\n野老尚能谈故事，乡僧争请说新经。\n楸梧雨外闻啼鸟，楼阁烟中见湿萤。\n欲写别离无限意，孤鸿遥没越山青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58878,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"云谷寺法会应制","author":"王守仁","text":"寒岩草木正严冬，一日春回雨露浓。\n安石故居遗雪竹，道林新塔倚云松。\n木鱼声断催朝饭，铜鼎香销起暮钟。\n千载奎文留秘藏，天光午夜照金容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58879,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登富春永安寺","author":"德祥","text":"栗叶村前石子溪，青山一掩路浑迷。\n也知谷里多猿鸟，未信云中有犬鸡。\n满耳只闻诸涧响，回头方觉众峰低。\n平生倾想今朝到，愿结茅茨在寺西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58880,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入寺","author":"明显","text":"碧草通樵径，青松夹寺门。\n已来亲眼见，难去对人言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58881,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寻竹隐寺","author":"怀让","text":"闻钟识寺遥，小径缘云入。\n日暮冒岚归，秋衣不知湿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58882,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高山寺","author":"德清","text":"山城枕江流，梵刹云中起。\n钟鸣万户开，人在莲华里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58883,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"讲经台","author":"王守仁","text":"乞食归来坐暝鸦，谭经每到白牛车。\n东风柳絮吹晴雪，犹想天宫酌宝花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58884,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题萝壁山房","author":"德祥","text":"青萝壁下一僧房，长日惟烧片炷香。\n风在竹櫩人在定，鸟衔红柿落柴床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58885,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"不二楼","author":"镇澄","text":"谈经人在翠微中，缥缈烟霏隔几重。\n欲寄此心无可托，长随片月挂西峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58886,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石林庵","author":"广印","text":"觉道金绳绝巘开，半空花雨湿楼台。\n长林怪石皆龙象，曾受生公记莂来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58887,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒山访雪谷师","author":"智舷","text":"寒山太湖东，六月雪埋坞。\n时有天耳师，巢居类巢父。\n春秋末半百，气骨自高古。\n清泉冻连底，蹲石怒狮虎。\n此中除梅花，无物入岩户。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58888,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送生明还雪窦","author":"智舷","text":"残月在松僧在户，犬声如豹隔松坞。\n霜厚如雪野易风，空村家家门尚杜。\n还山不问几日程，直造云边峰顶坐。\n莫想钱塘江北庵，琉璃一点如萤火。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送僧还松萝山","author":"德祥","text":"乡井何曾念，溪山不肯忘。\n百滩春水色，万壑古松香。\n云影同归路，钟声出上方。\n松萝最深处，閒坐阅流光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送邻寺僧","author":"德祥","text":"同住南山里，经年不一逢。\n深萝挂灵锡，落叶閟行踪。\n梦绕千峰涧，吟残两寺钟。\n今从湖上别，云水意重重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别华顶老僧","author":"圆复","text":"老宿清无侣，名山住有年。\n须留三寸雪，衲挂半窗烟。\n破屋眠秋雨，孤铛煮夜泉。\n相逢笑相别，红叶满霜天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"老僧","author":"照源","text":"早得安心法，柴门岂浪开。\n发长难剪雪，衣故不容埃。\n屈指僧中腊，寻思云外来。\n恐伤虫蚁乐，常诫坐莓苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵怀冷泉禅师","author":"王守仁","text":"八年京国雁书沈，每见游僧问好音。\n已喜法支流日本，剩传诗价到鸡林。\n马嘶赤拨晨朝散，花落氍毹午定深。\n今雨不来春又暮，鹫峰烟树绿成阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58894,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠住庵僧","author":"雪梅","text":"垂帘清昼篆烟霞，满地苍苔衬落花。\n习寂不须天送供，图閒懒为客煎茶。\n寒炉煨芋留残火，怪衲连云缀断麻。\n兀坐不知天早晚，月移松影上窗纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58895,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄曦春谷讲师","author":"德祥","text":"有德高僧亦有年，少曾行到寺门前。\n寻常独看华严处，十二时中柏子烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58896,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题林屋洞天","author":"德祥","text":"群山包水水包山，金作芙蓉玉作环。\n洞里有天通五岳，山中无地著三班。\n白云彷佛鸡初唱，碧海迢遥鹤又还。\n可惜桃花有凡骨，年年随浪出人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58897,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访道士","author":"廖孔说","text":"露草烟林断客行，竹扉昼掩对高城。\n道人不爱人天供，消受秋空鹤一声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58898,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山下买酒","author":"何其渔","text":"隔浦渔家傍酒家，渔罾掩映酒帘斜。\n探囊恰好供归客，买得黄鱼并杏花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58899,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酿酒","author":"梁小玉","text":"曲部尚书谱不留，椒花细雨冽香流。\n酿王家法应如是，新拜云溪女醉侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58900,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题书经室","author":"德祥","text":"池边木笔花新吐，窗外芭蕉叶未齐。\n正是欲书三五偈，煮茶香过竹林西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58901,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"米花","author":"盛彧","text":"吴下孛娄传旧俗，人间儿女卜清时。\n釜香云阵冲花瓣，火烈春声绕竹枝。\n翻笑绝粮惊雨粟，还疑煮豆泣然萁。\n一年休咎何须问，且醉樽前金屈卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58902,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"麦","author":"申时行","text":"芃芃秀色挺来牟，片片黄云似水流。\n风作跳波时隐见，雨添新涨乍沈浮。\n晴畦锦漾千层瀫，寒垄涛生四月秋。\n却怪狂澜频起陆，漫教文伟赋中愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58903,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀友","author":"王守仁","text":"湖草青青上客舟，辛夷花老麦初秋。\n一春多少怀人梦，半在乡山雨外楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58904,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莼菜","author":"陆树声","text":"陆瑁湖边水漫流，洛阳城外问渔舟。\n鲈鱼正美莼丝熟，不到秋风已倦游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58905,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莼菜 其一","author":"徐桂","text":"波心未吐心如结，水叶初齐叶尚含。\n脂自凝肤柔绕指，转教风味忆江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58906,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莼菜 其二","author":"徐桂","text":"鲛纻纷纷散作丝，龙涎宛宛滑流匙。\n诗人采茆元从水，莫误嘉蔬嗔露葵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58907,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望亭饭僧作","author":"洪恩","text":"隔岸长松疏柳，双溪一片湖光。\n夜听渔舟共语，风吹菱芡时香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58908,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题叶熙时空树轩","author":"智舷","text":"尝闻松化石，未闻树化竹。\n君家草堂树，何乃虚其腹。\n怀抱日益空，枝叶不放绿。\n其中有容焉，外润若不足。\n僧还可入定，旅寓何必屋。\n居士空诸有，不独此老木。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58909,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"树影","author":"朱之蕃","text":"层枝叠叶点苔斑，深院重垣总莫关。\n夹道密移须按辔，满庭交匝可怡颜。\n月穿池岸连浮藻，日射园林障远山。\n斜拂北窗来枕簟，清阴合处鸟声閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58910,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花䰟","author":"朱之蕃","text":"交枝低亚蕊纷披，舞影飘香化日迟。\n红颊晓酣微困酒，粉痕宵褪苦搜诗。\n追从蜂蝶应难定，倦听笙歌有所思。\n寻遍天涯芳草路，三生石上月明时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58911,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花 其一","author":"朱之蕃","text":"春宵花月照春江，泻影流香绕客艭。\n广野芳䰟招不得，一天愁绪总难降。\n啄馀燕嘴归高栋，粘向蜂须入小窗。\n灯下帘垂寂无语，似随红烬坠银釭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58912,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花 其二","author":"朱之蕃","text":"催花遣使忆新衔，又报春归燕语喃。\n园月和烟霏曲径，江风带雨洒孤帆。\n乱飘不羡吴姬舞，远寄无劳驿使缄。\n藉坐锦茵新酿熟，待尝樱笋试罗衫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58913,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"松","author":"申时行","text":"宛转随高阜，青葱结茂林。\n团云低盖影，挟雨送涛音。\n节抱风霜苦，根盘岁月深。\n亦知弘㬌意，山阁助清吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58914,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗汉松","author":"屠隆","text":"何年苍叟住禅林，百尺婆娑万壑阴。\n四果总来成佛印，一官应不受秦侵。\n灵根岁月跏趺久，老干风霜面壁深。\n谡谡回飙响空谷，犹闻清夜海潮音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58915,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桧","author":"章圭","text":"天挺良材耸百寻，托根仙宿历年深。\n能兼老柏冰霜操，不让寒梅铁石心。\n夜静绕坛星布列，月明满地翠阴森。\n工师若选明堂用，为栋为梁价万金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58916,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桑","author":"陈继儒","text":"女桑新绿映宫槐，三月春风戴胜来。\n织就鸳鸯锦千匹，金刀先取合欢裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58917,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得新柳送别","author":"谢肇浙","text":"短岸复长堤，黄轻绿未齐。\n晓风吹不定，春雪压常低。\n草细偏相妒，莺娇未敢啼。\n年芳君莫问，日落灞陵西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58918,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孤柳","author":"德祥","text":"孤柳在江津，年年占早春。\n上林何限树，此树独无邻。\n蘸水烟条短，啼春露叶新。\n不知缘甚事，只赠远行人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58919,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"折杨柳","author":"杨文俪","text":"昔去临岐路，柔黄缀树生。\n今来归故里，暗绿与楼平。\n花起轻飘絮，条声巧啭莺。\n因看攀折处，记取别时情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58920,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柳","author":"朱谋㬜","text":"二十八星中有名，千枝万树绾离情。\n暖风拂地条初弱，寒雨连空叶渐生。\n半倚红亭江北岸，低藏粉堞汉南城。\n绿阴高处春光暮，吹送新蝉四五声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58921,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"烟柳","author":"朱之蕃","text":"隋堤吴苑锁春光，淡抹轻笼万绿杨。\n朝暮晴阴从变幻，眼眉颦笑暗相将。\n莺梭忙织绡纹薄，燕剪平分匹练长。\n不辨离亭曾折处，遥连芳草断柔肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58922,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沾泥絮","author":"朱之蕃","text":"雨扑香尘紫陌融，杨花无力奈春风。\n凭虚到底升还坠，浪迹从前西复东。\n漫拟铺毡盈径路，无缘点砚入帘栊。\n萍繁榉弱皆乘化，心事枯禅未许同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58923,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柳","author":"申时行","text":"泥融沙涨雪痕消，到处芳菲著旧条。\n隔水半藏青雀舫，迎风斜倚赤栏桥。\n楼头人醉初横笛，灞口春阴不上潮。\n陶令柴桑归去久，五株门外已飘摇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58924,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]