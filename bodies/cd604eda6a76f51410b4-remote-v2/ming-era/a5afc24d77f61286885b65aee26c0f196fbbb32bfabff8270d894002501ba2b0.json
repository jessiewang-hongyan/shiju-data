[{"title":"送高都谏倅广东藩幕","author":"王立道","text":"怜君香案吏，久奉紫宸朝。\n暂解荷囊去，言从薇省招。\n秋经吴苑树，晨望海门潮。\n远近无须问，平原欲试萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7687,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乡园偶成","author":"王立道","text":"为园非择胜，所欲奉亲娱。\n树与人俱散，溪因主亦愚。\n宦卑情自澹，战胜体犹臞。\n敢谓轾缨冕，出门多畏途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7688,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读李忠定靖康传信录二首 其一","author":"王立道","text":"国势已纷如，忠贤久见疏。\n天心未悔祸，兵事竟成虚。\n玉府非金穴，鱼符是蜡书。\n空闻求内禅，犹自昧前车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7689,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读李忠定靖康传信录二首 其二","author":"王立道","text":"治乱亦无端，兴戎自晏安。\n会因千道设，岳拟万年看。\n城下盟初合，宫中戏未阑。\n可怜忠定泪，独洒北风寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7690,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居","author":"王立道","text":"幽居何处是，一径落花中。\n人似鹿门隐，溪将剡水通。\n閒寻种瓜伴，因识养鸡翁。\n独往平生意，多岐秪自穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7691,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"途中暑寄所知","author":"王立道","text":"旅泊淹中夏，愁添毒热新。\n时逢隔水骑，相顾满衣尘。\n择木频移荫，贪程更问津。\n不缘趋捧日，长作北窗人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7692,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赵孟静 其一","author":"王立道","text":"一官常卧病，知尔学沈冥。\n对客称居士，呼儿说道经。\n支离堪混俗，猿鸟共忘形。\n为识峨嵋老，年来畏独醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7693,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赵孟静 其二","author":"王立道","text":"旧爱山中宿，因成方外游。\n写经多施寺，草赋独登楼。\n耿介于陵子，栖迟马少游。\n未能谙蜀道，梦尔到沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7694,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卜居后东吴曰静欧学章","author":"王立道","text":"与君数相见，但讶往来疏。\n不惜买邻费，初营近市居。\n卑栖随燕雀，长物载图书。\n何日登楼赋，虚名愧应徐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7695,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺王允宁移居二首 其一","author":"王立道","text":"仄径不容车，迢迢奉板舆。\n思玄隐几处，入直倚门初。\n夜户蛩螀满，秋墙薜荔疏。\n自怜趋禄养，时复忆吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7696,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺王允宁移居二首 其二","author":"王立道","text":"甲第连云起，一枝吾自安。\n箧中鹪鹩赋，壁上鵔鸃冠。\n客至供蔬具，人閒理药栏。\n不须歌考室，久已梦斯干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7697,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柬卢浚卿移居","author":"王立道","text":"年来频卜筑，只傍帝城西。\n省树寒犹绿，宫莺春早啼。\n官閒成小隐，身病惬幽栖。\n况是卢敖宅，红尘未许迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7698,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴道士","author":"王立道","text":"紫气来何远，青牛又出关。\n客程江上雪，归梦海中山。\n风御双凫去，身轻一鹤还。\n馀丹幸留赠，我欲驻颓颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7699,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨都谏谪贵洲","author":"王立道","text":"子云羞执戟，万里去金门。\n衮职将谁补，玄文祗自论。\n衔恩鸡舌在，涉险马蹄翻。\n为问居夷好，一官聊避喧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7700,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈封君六十双寿","author":"王立道","text":"六十鬓如丝，林泉久避时。\n性唯便野鹿，手自蓺园葵。\n爱客常青眼，传家有白眉。\n醉看章服贵，莱妇笑相宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7701,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江阴花母节寿诗","author":"王立道","text":"一身唯苦节，三徙得仙闾。\n欲试趋庭训，还探繫肘书。\n江清鱼入馔，秋晚药供蔬。\n白首堪相慰，清尊幸不虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7702,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄尹汝基","author":"王立道","text":"秋杪正愁予，逢君忆岁除。\n颓然泉上酌，慰我独离居。\n烽火惊初定，田园意转疏。\n平生匡国愿，早上治安书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7703,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至后二日雪","author":"王立道","text":"至后雪霏霏，初阳力尚微。\n细沾罗袜冷，轻逐琯灰飞。\n对树惊花发，看山失翠围。\n犹馀闭关意，一任积荆扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7704,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观出军十首 其一","author":"王立道","text":"万骑出长安，都人夹道看。\n旗参龙虎动，剑带鸊鹈寒。\n玄社新分土，黄金尽筑坛。\n九重忧正切，又见选材官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7705,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观出军十首 其二","author":"王立道","text":"圣主本修文，安边再出军。\n戈鋋六月雪，旌旆半空云。\n候骑宵中发，屯营柳外分。\n幕前文武士，年少有终军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7706,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观出军十首 其三","author":"王立道","text":"诏出选元戎，人推卫霍雄。\n天兵六郡卒，汉马五花骢。\n气盖燕山石，歌酣易水风。\n匈奴行徙牧，不敢向云中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7707,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观出军十首 其四","author":"王立道","text":"王师亦有征，慷慨羽林兵。\n尽说从军乐，相和出塞声。\n旌麾天际下，刁斗月中鸣。\n自愧刘生勇，空令气不平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7708,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观出军十首 其五","author":"王立道","text":"琐甲膺朱绂，银鞍跨紫骝。\n将军五道出，战士百金收。\n贾勇多超乘，论兵竞借筹。\n相期穷绝漠，枭取左贤头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7709,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观出军十首 其六","author":"王立道","text":"君王方北顾，万里动天诛。\n日月占兵气，风云识阵图。\n边隅休士久，将帅受恩殊。\n一取单于帐，嫖姚真丈夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7710,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观出军十首 其七","author":"王立道","text":"塞马饮河汾，兵符阃外分。\n尽徵骠骑将，远逐虎狼群。\n燕尾翻晴旭，犀皮暗晓云。\n不贪麟阁画，报主藉微勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7711,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观出军十首 其八","author":"王立道","text":"边警先秋报，重兴六月师。\n简书传凤阙，兵阵动鱼离。\n吹律风初应，挥戈日乍低。\n一军齐洒泣，为感采薇诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7712,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观出军十首 其九","author":"王立道","text":"大将凿凶门，边庭节制尊。\n登坛戈剑拥，扫境鼓鼙喧。\n投石军中戏，椎牛幕下恩。\n折冲樽俎意，千载与谁论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7713,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观出军十首 其十","author":"王立道","text":"烽火照甘泉，将军出塞年。\n万夫齐决拾，一鼓荡戈鋋。\n地极回看斗，谷深长断烟。\n萧条夕阳外，应听哭祁连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7714,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"芳洲为蔡长卿题","author":"王立道","text":"传闻蔡经宅，一径入烟霞。\n地古藤萝合，溪回城市赊。\n药畦连别坞，棋局上浮槎。\n肯念文园客，相从老岁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7715,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和钟石学士斋夜见雪拗体二首 其一","author":"王立道","text":"素心仰玄鉴，灵泽先成雪。\n六出花更繁，五更绵复折。\n琼筵先幄张，宝鼎名香爇。\n怀君坐中夜，虚窗澹微月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7716,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和钟石学士斋夜见雪拗体二首 其二","author":"王立道","text":"北地多苦寒，春半犹飞雪。\n东郭履尽穿，渊明巾欲折。\n林花吐还缩，野烟冻不爇。\n遥瞻白玉台，群神朝二月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7717,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽张封君","author":"王立道","text":"何处访高踪，岧峣江上峰。\n遗安五经笥，寄傲一枝筇。\n姓字渔翁识，茶蔬野老供。\n无嗟终不遇，身后渥恩浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7718,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠朱从龙外兄二首 其一","author":"王立道","text":"祗为怜同病，时来款竹扉。\n藤萝一亩宅，荷芰四时衣。\n石几焚香坐，春流抱瓮归。\n池塘入幽梦，相客各依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7719,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠朱从龙外兄二首 其二","author":"王立道","text":"岁晚不一遇，知君自晏如。\n贫收乞米帖，病学养丹书。\n野竹编渔舫，山花荐客蔬。\n风尘初息驾，莫讶故人疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7720,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠数畴一首","author":"王立道","text":"为儒长濩落，中岁学渊潜。\n蕙草春三径，蔷薇月半帘。\n药方閒里辑，诗卷病来添。\n野老时相讯，微吟坐短檐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7721,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代赠崇安住持僧","author":"王立道","text":"近市开兰若，尘中得静几。\n钟催城树晓，锡伴野云飞。\n化俗多传偈，持斋独掩扉。\n自今身得度，僧法尽皈依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7722,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题华氏抚弦小像","author":"王立道","text":"池台应未改，山水已希声。\n妙寄丹青笔，深传绿绮情。\n幽兰春日恨，别鹤夜堂惊。\n何必雍门客，能令泪满缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7723,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代贺张尚宝两岁生两子即罗峰阁老子也","author":"王立道","text":"丞相好推贤，金貂七叶传。\n恩遗掌玺日，庆发梦熊年。\n玉树看双植，桑弧喜再悬。\n惭余汤饼客，秋至又登筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7724,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送万容斋通判南雍","author":"王立道","text":"人言南土乐，况复郡名雄。\n五岭云中合，诸夷徼外通。\n家传孔林学，俗仰曲江风。\n骥足真堪展，无嗟西复东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7725,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送南丰尹高文明","author":"王立道","text":"无言得官晚，墨绶自为荣。\n列宿郎官宠，馀春乡国情。\n花添制锦色，江助酌泉清。\n他日双凫至，应蜚百里声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7726,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅窗为蔡君题","author":"王立道","text":"为爱孤山友，閒窗手自栽。\n尘襟风外洗，野望雪中开。\n心赏芝兰共，年芳桃李催。\n不嫌居近市，清梦自徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7727,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿彭宣父","author":"王立道","text":"三月长安道，东风送客归。\n十年桓氏学，此日老莱衣。\n江入青春暖，云随画鹢飞。\n钜公名笔在，桑梓自光辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7728,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送罗希文掌鄞县教","author":"王立道","text":"两献蓬莱赋，嗟君数尚奇。\n翩然从吏隐，真不忝人师。\n梁栋他时用，琴书此日宜。\n更怜桑梓近，可慰白云思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7729,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿沈德夫母","author":"王立道","text":"春日休文第，东风萱草花。\n共姜心独苦，王母发初华。\n綵服回清昼，丹帔拂晓霞。\n人间有瑶岛，何处觅仙家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7730,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽卢湲江父","author":"王立道","text":"鸠杖迎宾日，君颜幸未衰。\n不妨亲药裹，何意泣灵輀。\n紫诰生前宠，青山故里思。\n漳河风色暮，归路不胜悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李威甫掌长兴教","author":"王立道","text":"匹马河桥别，南云欲满空。\n归心依岸柳，秋色动江枫。\n帝命师儒重，文风吴越同。\n他年逢弟子，应自识胡公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送俞汝承行二首 其一","author":"王立道","text":"国计须盐铁，君行亦壮观。\n一星离北极，六月发长安。\n城树欹残暑，河梁下急湍。\n伫听旋旆日，献论续桓宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送俞汝承行二首 其二","author":"王立道","text":"魏阙光新命，秦淮恋旧游。\n清心鹭洲月，极目牛山秋。\n梓里情何剧，萱堂志已酬。\n明时多雨露，应自足忘忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱月河判雷州二首 其一","author":"王立道","text":"帝德通炎海，官曹接要荒。\n缘知今别驾，非复古雷阳。\n展骥材堪远，歌骊思更张。\n都门旌旆迥，寒日正苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱月河判雷州二首 其二","author":"王立道","text":"艺苑久蜚英，才高独晚成。\n东南多好郡，江海足閒情。\n春树三山合，寒云五岭平。\n天门惊浪动，此日仰贤声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"补送骆尹敖欧四年兄使诸藩二首 其一","author":"王立道","text":"螭陛虚彤管，龙章下赤墀。\n尊亲周典礼，磐石汉宗支。\n天启储宫豫，春回使节迟。\n淮王如好客，为索桂山词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"补送骆尹敖欧四年兄使诸藩二首 其二","author":"王立道","text":"泰坛初荐册，离景又重辉。\n帝命先宗室，天书出琐闱。\n十行窥圣妙，千里逐春归。\n此日高堂近，还看著舞衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送潘勿斋司黄岩训","author":"王立道","text":"楚楚江南士，扁舟向日东。\n师儒新拜命，吴越旧同风。\n海气藏仙宅，山形擅学宫。\n诸生相问俗，试与说尤公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺鲍如泉七十","author":"王立道","text":"绿水绕门閒，杨花满钓船。\n折腰宁作吏，负郭且归田。\n义训徵图史，春情属管弦。\n相逢不惜醉，应有酒如泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送孙志高侍母归浙","author":"王立道","text":"春水正悠悠，图书上越舟。\n潘舆怜远道，华服炫晴洲。\n况是蓬瀛客，真成天姥游。\n明光残草在，桂树莫淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题阳峰一首","author":"王立道","text":"楚山奇胜处，共说绣林亭。\n今古留天柱，东南发地灵。\n沱江深映碧，巫峡远分青。\n云气时时合，为霖遍四溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"芳洲赠袁太医","author":"王立道","text":"明时容吏隐，犹自慕沧洲。\n绝艺成三折，新诗寄四愁。\n为园谢机械，行世任虚舟。\n乡梦依然在，清溪双白鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为顾汝隆悼亡","author":"王立道","text":"旅魄悲新月，归魂逐断云。\n兰芳春日尽，鸾影晓窗分。\n廿载人间世，千秋湖上坟。\n重吟赠妇句，悽切不堪闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"野寺","author":"王立道","text":"古寺乱田间，寻僧夜未还。\n万缘尘外尽，双树月中攀。\n化俗多传偈，观空独掩关。\n问余还嗜酒，何日住庐山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陆鍊师归领道会","author":"王立道","text":"少君初得道，谒帝上清宫。\n凫舄来天外，鸿书秘枕中。\n祗缘丹室在，重与世人逢。\n缩地元无术，泠然独御风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送益上人南归","author":"王立道","text":"面壁已多年，游方向日边。\n三千俱法界，来去但随缘。\n俗远诗成易，溪晴杯渡便。\n还思竹房月，独煮惠山泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送顾槩","author":"王立道","text":"逢君未徂暑，别去又重阳。\n一官新拜命，廿里古封疆。\n水落舟樯远，天清驿树长。\n东昌本畿辅，指日见辉光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张佥休宁二尹","author":"王立道","text":"石室徵劳久，彤墀锡命新。\n春光和雨露，行色带风尘。\n折柳聊随俗，哦松太任真。\n君知操割否，应藉佐刀人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月溪号诗","author":"王立道","text":"明月共千里，一溪君独幽。\n此时堪着屐，何处有藏舟。\n猿鹤声如答，藤萝影渐收。\n小山今寂寞，愿子勿淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱省簿乐安","author":"王立道","text":"居人怯中夏，行子发长安。\n尊酒怜乡国，天风思羽翰。\n莺声春尽少，江色夜深寒。\n回首孤帆远，谁歌行路难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"铁瓶草堂二首 其一","author":"王立道","text":"大市多真隐，名都有逸人。\n春深草堂静，雨过棘篱新。\n贯虱功非拙，屠龙术不贫。\n云雷随变化，池上见飞鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"铁瓶草堂二首 其二","author":"王立道","text":"乔木不知年，茅堂锁昼烟。\n人疑扬子宅，门有米家船。\n隐迹山南雾，将雏冀北天。\n晚成良有会，莫自惜华颠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽汤母","author":"王立道","text":"令子弹冠日，慈亲属纩时。\n荻灰寻旧画，机石讶新支。\n上国人留挽，空庭鸟助悲。\n秋风不相惜，偏向楚帆吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阳峰卷","author":"王立道","text":"雄势标南郡，岐阳第一峰。\n云中开锦绣，天际立芙蓉。\n人物全荆盛，辞华百代宗。\n莫牵松桂梦，密勿待从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿诗","author":"王立道","text":"绕径春风入，临流甲第开。\n冠裳三岛客，沆瀣万年杯。\n紫诰兼君宠，斑衣忆手裁。\n瑶池何处是，弦管夜频催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]