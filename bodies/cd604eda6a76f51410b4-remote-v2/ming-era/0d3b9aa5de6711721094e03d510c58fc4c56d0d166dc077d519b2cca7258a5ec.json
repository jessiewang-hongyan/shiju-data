[{"title":"山水图 其二","author":"王恭","text":"山水无穷趣，看图忆胜游。\n叶藏云外塔，风稳□□舟。\n岩际隐遥月，藤阴下碧流。\n从兹得佳赏，何日去瀛洲。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35218,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山水图 其三","author":"王恭","text":"山水惬幽盟，萧萧薜荔情。\n天边孤嶂远，鸟外白云横。\n野衲闻猿坐，山人伴鹿耕。\n看图应不厌，疑是辋川行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35219,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"枯木","author":"王恭","text":"野木临崖石，年深土亦崩。\n老根浮断藓，飞干接长藤。\n性朽空劳匠，心灰也类僧。\n春风几荣谢，羡尔独棱层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35220,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别画史林虚白归屿南","author":"王恭","text":"怜君心不羁，水墨始清奇。\n潇洒南宫态，空濛北苑姿。\n壶觞倾邂逅，岐路惜分离。\n后夜分遥忆，猿啼海树枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35221,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武夷山访道","author":"王恭","text":"投簪寻羽客，山水慢亭清。\n九曲烟霞色，数峰钟磬声。\n还丹飞九转，仙箧受长生。\n寂寂藤萝外，惟闻鸾鹤鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35222,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"斋居喜故人陈希召过仍送别云","author":"王恭","text":"相思飞鸟外，海树共春云。\n岐路谁知己，空斋独见君。\n故情犹恋恋，别思又纷纷。\n相送无穷恨，壶山向夕曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35223,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泊舟武昌","author":"王恭","text":"孤舟随鸟没，渐至楚王城。\n黄鹤久飞去，高楼空复情。\n岳阳春树歇，汉口夏云生。\n鹦鹉芳洲近，凄凉待月升。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35224,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题猿鹿图","author":"王恭","text":"丹青翠微里，猿鹿共幽闲。\n挂影寒潭外，群游落照间。\n养茸寻药圃，得树入云閒。\n年少无游猎，山林恣往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35225,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚济龙门渡因访高慢士","author":"王恭","text":"向夕龙门渡，风潮半落霞。\n暂停游子棹，得访故人家。\n浦口鱼罾近，津头酒幔斜。\n踟蹰那忍去，乘月涉江沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35226,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜泛台江","author":"王恭","text":"无诸古城外，潮满合沙洲。\n宾从留骢马，壶觞度彩舟。\n山回川夜月，?怨海云秋。\n寂寞屠龙事，台空江自流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35227,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送客还蓟丘","author":"王恭","text":"江南春草歇，斗酒送归程。\n别路闽山色，乡园易水声。\n岭云游子恨，边柳故关情。\n握手自兹去，空闻征雁鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35228,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"经故人坟","author":"王恭","text":"东城日将曙，驱马入寒云。\n无复平生友，空馀数尺坟。\n卧麟行鸟迹，断碣积苔纹。\n欲荐寒泉水，临风涕泗纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35229,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜屿南景霞子兄弟见过","author":"王恭","text":"林家好兄弟，清润比璠玙。\n海屿耕残业，天坛梦旧居。\n相逢三径草，清话一楼书。\n莫遣明朝别，思君恨有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35230,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠医者","author":"王恭","text":"仙医何处住，卖药到山城。\n岁月壶中度，人烟醉里行。\n杏林春树晓，橘井野泉清。\n已饮上池水，何论指下明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35231,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题灵瑞招提","author":"王恭","text":"连峰入翠微，海色上行衣。\n寺古残僧少，林空野鸟稀。\n幽花燃石洞，芳草没山扉。\n尽醉壶中物，长歌送夕晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35232,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"诵道经","author":"王恭","text":"盥濯宴心坐，焚香讲道经。\n青童开宝笈，白发对黄庭。\n玉佩飞鸾驭，瑶笙载鹤軿。\n天花撩乱处，迢递见仙灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35233,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送邻人葬","author":"王恭","text":"卜邻今几年，此别间黄泉。\n洒泪临长道，招魂若个边。\n夜台春寂寂，蒿里树芊芊。\n归路东城晚，谁家思管弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35234,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四月东湖泛舟","author":"王恭","text":"落日东湖里，相携著綵舟。\n澄明怜水物，浩荡狎沙鸥。\n载妓从歌舞，飞觞任去留。\n绿荷深处月，流影上沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35235,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山人入城","author":"王恭","text":"翠微行渐远，去去入城扉。\n断续人烟近，荒凉故旧稀。\n市廛沾草屦，官柳拂荷衣。\n惟有空濛水，东流无是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35236,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"久雨后湖堤散步偕三同志","author":"王恭","text":"湖上雨新晴，相将著屦行。\n葛衣沾野色，纨扇引波声。\n吟响鱼皆听，机忘鸟不惊。\n隔林村路晚，归兴月初明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35237,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"避暑","author":"王恭","text":"林幽行避暑，藤叶昼阴阴。\n地僻无行客，山深独抱琴。\n白云时在屦，流水始知音。\n寄语尘中者，同来共息心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35238,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三山送客归钱塘","author":"王恭","text":"分手螺江上，青山驿路长。\n岭云添别恨，关月照行装。\n浙水金鳞活，西湖白藕香。\n羡君从此去，调膳上高堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35239,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"远浦帆归 其一","author":"王恭","text":"寂历钓鱼矶，青山带夕晖。\n天边飞鸟绝，浦口一帆归。\n花屿鸿声小，蓬窗月色微。\n叩舷闲独坐，忘却白鸥机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35240,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"远浦帆归 其二","author":"王恭","text":"浦溆沿村曲，孤帆一片秋。\n风移篷里轴，影拂水边楼。\n鼓枻惊初雁，鸣弦起夕鸥。\n江湖波浪紧，幸喜见安流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35241,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏夜闻笛 其一","author":"王恭","text":"露坐空庭夕，遥峰片月明。\n谁将杨柳调，吹作凤凰鸣。\n思绕坡仙梦，声随嬴女情。\n旧游宁再得，闻此转悲生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35242,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏夜闻笛 其二","author":"王恭","text":"谁截湘南管，晴楼午夜吹。\n数声孤月下，独客断肠时。\n零落梅花片，萧条杨柳枝。\n天明汉江上，何处觅桓伊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35243,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠隐者赴召 其一","author":"王恭","text":"鹤书天上去，迢递到山城。\n独赋骊驹别，空怀薜荔情。\n吴中争骑远，淮上一帆轻。\n渐到金门下，君应被宠荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35244,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠隐者赴召 其二","author":"王恭","text":"习静东山里，空林闭两扉。\n独承丹陛诏，暂解绿萝衣。\n?鹿谁同伴，烟霞迹渐稀。\n五云霄汉上，还有梦来期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35245,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"访山人不值 其一","author":"王恭","text":"迢递过前峰，林深爽气浓。\n也知行处尽，犹未与君逢。\n白壁猿啼榻，空潭树翳钟。\n不知人代里，何日得相从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35246,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"访山人不值 其二","author":"王恭","text":"山中寻旧侣，何事掩荆扉。\n树密藤花落，篱深菜草稀。\n萧条人不见，寂寞鸟空归。\n叶上留名去，孤云与愿违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35247,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"林塘夏夕有怀同志","author":"王恭","text":"风微池色定，林静藕花香。\n深树归残鸟，青山敛夕阳。\n同心嗟远道，久别隔他乡。\n世事今如此，何因共举觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35248,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"书云山小景","author":"王恭","text":"远树绿依依，澄江去棹微。\n人烟连极浦，僧舍对残晖。\n山迥云来白，林深客到稀。\n红尘多少事，即此可忘机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35249,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏夜舟中","author":"王恭","text":"暑气夕仍炽，澄江思夜游。\n孤舟乘楚月，醉客发吴讴。\n渔浦钟初断，枫林火渐收。\n鸡鸣看海色，城阙复堪愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35250,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送人下第归桐城","author":"王恭","text":"如君宁久微，且复顾庭闱。\n折桂暂无分，飘蓬今独归。\n壶公当过道，金粟待行衣。\n遥想青灯下，闲堂静掩扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35251,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冶城马上","author":"王恭","text":"策马三山路，经过似胜游。\n千门烟灶晓，独树钓台秋。\n雁塔天边小，孤帆鸟外愁。\n晚来灯火起，钟鼓凤池头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35252,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渔樵清话","author":"王恭","text":"砺斧出幽林，移竿野水深。\n相逢休问姓，偶坐便知心。\n岩桂香堪爨，江鳞美易寻。\n平生山水趣，终不为朝簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35253,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登凤山仙人梯 其一","author":"王恭","text":"磴道苍苔古，缘云上石梯。\n依微残雨雪，迢递拂云霓。\n乍可临仙路，谁堪驻马蹄。\n回看炼丹处，岩畔草萋萋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35254,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登凤山仙人梯 其二","author":"王恭","text":"凤山东海际，苍翠白云封。\n峭壁悬梯近，幽林挂瀑重。\n虹蜺侵绝涧，星汉接危峰。\n不见烧丹者，空怜避世踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35255,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别友人之长沙太守","author":"王恭","text":"闻说长沙郡，湘南驿路微。\n楚山猿乱叫，湘水雁孤飞。\n见月鸣琴坐，行春佩印归。\n怜君五马贵，自笑绿萝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35256,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"织妇","author":"王恭","text":"草虫鸣促织，深夜动鸣机。\n玉手挑灯暗，罗衫染泪微。\n常怀筐篚贡，又忆塞垣衣。\n用尽闺中力，天边雁未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35257,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"王昭君","author":"王恭","text":"行旌入塞垣，回首望君门。\n汉月牵愁思，边尘惨泪痕。\n琵琶霜外曲，羌笛夜中魂。\n惆怅毡庐下，空闻刺刺言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35258,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"经山中旧宅","author":"王恭","text":"行行林路远，此地复伤怀。\n断壁悬疏蔓，闲门翳古苔。\n邻僧惊独住，野老候重来。\n欲去仍回首，猿声处处哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35259,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠讲僧","author":"王恭","text":"吾师能演法，往往落天花。\n谛听来何处，筌蹄付作家。\n三□翻贝叶，双树拂袈裟。\n早晚离言说，空潭有月华。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35260,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"林下逢僧","author":"王恭","text":"林中见缁锡，相问始知名。\n对坐松声晚，澄心涧影清。\n谈空归妙法，说有愧劳生。\n月出从分别，惟闻山鸟鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35261,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山庄独夜","author":"王恭","text":"独坐空窗里，幽泉入户鸣。\n山林甘寂寞，风月共凄清。\n夜半猿声断，空庭烛影明。\n萧条松叶下，缨冕不关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35262,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏月过周六园林因有茶瓜之会","author":"王恭","text":"森爽凤山里，林幽暑自移。\n幸无尘外事，应有静中期。\n鸟触牵风幔，猿投宿露枝。\n茶瓜并异味，随兴且淹迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35263,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"独酌言怀","author":"王恭","text":"行歌与醉吟，谁识一生心。\n白日蹉跎过，青山感慨深。\n酒酣空击筑，愁极少知音。\n且尽壶中物，仙源何处寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35264,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山行闻樵歌","author":"王恭","text":"樵歌何处响，迢递白云深。\n袅袅潭边起，萧萧空外音。\n何须谐律吕，即此是讴吟。\n却厌青楼曲，商音摅暮林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35265,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过皇恩寺","author":"王恭","text":"上国僧游去，山门日自开。\n绀园依绿草，画壁上苍苔。\n谷暗猿初断，林空鹤又回。\n惟馀旧童子，笑问客何来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35266,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"灯下写怀","author":"王恭","text":"独坐山窗里，灯残欲二更。\n月中山叶堕，阶下草虫鸣。\n风便遥钟响，霜寒独自惊。\n青云犹未达，徒此怅离情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35267,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梅城雪夜","author":"王恭","text":"夜静潮声远，城高月影寒。\n梅花孤角断，灯火几家残。\n枫叶愁中落，乡林梦里看。\n天明倚霜树，云水浩漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35268,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋江送行者","author":"王恭","text":"残柳绿依依，离樽对夕晖。\n断鸿随去棹，落叶映行衣。\n楚国烟中尽，淮山鸟外微。\n宦游终在客，岁晚早言归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35269,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋中九日登南楼","author":"王恭","text":"海上登临望，荒城水乱流。\n天边孤嶂雨，烟外几家秋。\n近郭寒砧响，长沙落雁愁。\n乡心正无那，回首仲宣楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35270,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日送僧还山中","author":"王恭","text":"西风残叶下，锡杖返东浔。\n浮世空伤别，孤云不住心。\n人烟飞鸟绝，山月断猿深。\n后夜相思处，惟闻钟磬音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35271,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"捣衣","author":"王恭","text":"独抱清砧冷，那堪捣夜阑。\n泪飘双杵落，愁绝一灯残。\n烟月闺中趣，风霜塞上寒。\n年年空寄远，相忆恨漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35272,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日凤山载酒","author":"王恭","text":"九日凤山路，登临喜盍簪。\n风飘乌帽落，云度菊杯深。\n树色残孤笛，鸿声带远砧。\n醉来同藉草，不觉夕阳沈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35273,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋江独钓","author":"王恭","text":"萧条惊叶堕，孤坐子陵滩。\n积水摇棕树，微风飏竹竿。\n雁催秋色晚，霜降笛声寒。\n钓罢行来夕，枫桥日又残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35274,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋山行旅","author":"王恭","text":"客路青山外，萧条尽白云。\n猿啼山寂寂，霜降叶纷纷。\n野寺鸣烟磬，空林带夕曛。\n望乡心未已，残笛不堪闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35275,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"都门留别","author":"王恭","text":"都门霜叶赤，车马正纷纷。\n祖帐黄花酒，孤舟日暮云。\n龙池初月上，长乐曙钟闻。\n落羽悲纷去，怀君鹓鹭群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35276,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初冬登南楼","author":"王恭","text":"楼隐青枫外，南天叶未霜。\n寒山低度鸟，芳岸入斜阳。\n复叹年光暮，空怜鬓发苍。\n故园三径晚，归笑醉壶觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35277,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江城暮角","author":"王恭","text":"何处玉龙鸣，寒江带楚城。\n梅花天外落，客泪夜中倾。\n思苦胡霜入，声凄汉月明。\n湘南多谪宦，谁是不关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35278,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寒山送客","author":"王恭","text":"相送空林下，千峰鸟外微。\n寒风飞去旆，野烧带行衣。\n谷口遥钟度，天涯远骑归。\n知君愁此别，应念故人稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35279,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鸣砧寄友人","author":"王恭","text":"候馆空垂幔，荒城又捣砧。\n寒声霜外落，愁思夜中深。\n响度银灯暗，清和玉漏音。\n同袍嗟久别，因此惜惊心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35280,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"松林观瀑图","author":"王恭","text":"瀑布悬空青，初阳互明灭。\n喷壁飞白虹，穿林散晴雪。\n淙淙鹤梦清，洒洒机心绝。\n相顾濯尘缨，沧波坐超越。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35281,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冶城客夜","author":"王恭","text":"钟断夜色寒，孤吟客衣薄。\n月色半城虚，砧声四邻作。\n更残酒气微，坐久灯花落。\n乘兴理归帆，四望无诸郭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35282,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送黄山翁还玉融","author":"王恭","text":"十载一相逢，几日沧洲客。\n祖道又伤离，劳歌复愁积。\n孤云赴岩阿，独鹤鸣川泽。\n归去黄山中，希君醉时墨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35283,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄上清王道人","author":"王恭","text":"闲斋澹无营，忽念山中侣。\n鹤驭杳难期，瑶笙竟何处。\n心怀九转丹，梦绕三花树。\n矫首望孤云，飞声寄玄圃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35284,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春登御风台 其一","author":"王恭","text":"寂历芳台古，天空野望长。\n雨晴闲树出，雪尽粤山苍。\n露藓凝寒翠，烟花送断香。\n御风人不见，徒此立斜阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35285,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春登御风台 其二","author":"王恭","text":"雁峰晴翠里，台古独登临。\n沙阜人烟积，山城海戍深。\n野云飘杖舄，林吹拂衣襟。\n仙路无期达，空惊吊古心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35286,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闲居喜故人见过 其一","author":"王恭","text":"幽独空林下，荒斋喜见君。\n扫苔聊共坐，剪韭更论文。\n华发扫青镜，浮名寄白云。\n绨袍如有意，慎勿又离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35287,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闲居喜故人见过 其二","author":"王恭","text":"寂寞卧空斋，闲扉闭绿苔。\n一帘幽梦断，千里故人来。\n野竹迷连骑，空花送酒杯。\n又愁分手去，心事向谁裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35288,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]