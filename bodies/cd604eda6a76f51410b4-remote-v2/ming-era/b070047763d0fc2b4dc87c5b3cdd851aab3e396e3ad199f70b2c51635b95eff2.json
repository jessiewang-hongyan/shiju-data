[{"title":"和邓玄度少参归兴十首 其九","author":"李云龙","text":"烟水渺无际，孤舟枫树林。\n溪声来枕畔，渔唱隔江阴。\n白鸟为幽侣，清流见素心。\n向来击楫意，惆怅海云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42642,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和邓玄度少参归兴十首 其十","author":"李云龙","text":"一自辞簪绂，归耕陇上桑。\n宦情流水澹，清梦白云长。\n节旧持秋宪，书曾拜夕郎。\n谁知罢官日，不辨宿舂粮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42643,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"学博陈冲师奏最","author":"李云龙","text":"夙擅阳春调，曾登作者坛。\n家徒四壁立，物有一毡寒。\n马瘦桃花落，盘空苜蓿残。\n不知公府去，奏最是何官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42644,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答韩寅仲诗扇见寄","author":"李云龙","text":"闻君初试宰，忽已返柴荆。\n不习折腰态，惟留强项名。\n仁风来扇底，白云入歌声。\n何日罗浮去，云松共结盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42645,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答袁朗生","author":"李云龙","text":"思君属秋日，惆怅望枫林。\n鸿雁暮天远，芙蓉秋水深。\n有怀劳梦寐，欲往隔江浔。\n牛渚闻高咏，因风报好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42646,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿东官周令公","author":"李云龙","text":"罗浮东望处，苍翠结秋阴。\n闻道桃花县，遥依琼树林。\n云霞留舄影，山水答琴音。\n知是丹成日，朱明紫气深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42647,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜","author":"李云龙","text":"凉露湿芳草，高林秋已凝。\n幽人坐深夜，落叶洒孤灯。\n瘦影见栖鹤，梵声闻静僧。\n前山明日望，知在白云层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42648,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀陈子","author":"李云龙","text":"城南千树竹，与子旧相依。\n何意双栖鸟，今为两地飞。\n欲去不得去，曰归何日归。\n传书话心绪，仍恐别来非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42649,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感秋柬黎马龙诸子","author":"李云龙","text":"凉籁薄庭樾，江城秋渐生。\n孤斋今夜月，独听断猿鸣。\n露滴荷声苦，风飘竹叶清。\n芙蓉尚可采，无限故人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42650,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏口占 其一","author":"李云龙","text":"多难频仍漫自伤，兵戈从古致凶荒。\n此身本合填沟壑，不见前贤卧首阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42651,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏口占 其二","author":"李云龙","text":"乡闾十室九空囷，百里宁辞负米频。\n菽水未能供一饱，车锥深羡去年贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42652,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏口占 其三","author":"李云龙","text":"数亩荒田岁入微，笔耕不救腹中饥。\n嗷嗷八口难为计，未过春寒尽典衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42653,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏口占 其四","author":"李云龙","text":"山川涤涤野如焚，几处忧惶望作云。\n富室未须欣独饱，盖藏难献犬羊群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42654,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏口占 其五","author":"李云龙","text":"拂衣归卧白云庐，牛角前头挂汉书。\n欲向田园谋食力，岂能枵腹事耕锄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42655,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏口占 其六","author":"李云龙","text":"空囊羞涩莫为欢，漫道明霞高可餐。\n却羡当年杜工部，犹然留得一钱看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42656,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏口占 其七","author":"李云龙","text":"痴儿索饭妇无裈，支枕翛然自闭门。\n不是安贫学高士，谁能推食与王孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42657,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏口占 其八","author":"李云龙","text":"萧然瓮牖与绳枢，曳屣高歌乐不殊。\n栗里先生知此意，行行那复为饥驱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42658,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏口占 其九","author":"李云龙","text":"南薰吹雨到寒窗，一洗妖氛复旧邦。\n却叹沟中诸饿莩，枯鱼不及待西江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42659,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏口占 其十","author":"李云龙","text":"东征士女慰来苏，大度神功与祖符。\n引领王师徒望雨，好将何物备箪壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42660,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白云纪游同陈冲师郑蟾林万伯文用壁间韵","author":"李云龙","text":"何处寻幽好，春山高入云。\n石岩飞磴接，濑道小桥分。\n度壑龙为杖，穿萝鹤共群。\n禅房掩苍翠，人语带氤氲。\n问法随真侣，观空息众纷。\n鸟啼如有意，花落自成文。\n凉籁传清梵，香台送夕矄。\n空林孤磬寂，归路一猿闻。\n烟树浮清霭，霞天织锦文。\n时时回首望，行欲谢尘氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42661,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡寺","author":"李云龙","text":"玲珑金刹翠微边，云际迢迢磴道悬。\n遗殿尚留梁日月，空门长对汉山川。\n松风到枕闻归鹤，竹树沿流泊客船。\n闻说瑶坛丹灶在，愿随仙令学延年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42662,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春水","author":"李云龙","text":"春江春可怜，含雨复含烟。\n遥见碧波底，别有桃花然。\n荡日摇金液，萦风织锦泉。\n独愁东下去，容易送郎船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42663,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春郊","author":"李云龙","text":"千千柳条堕，万万夭桃然。\n游女搴珠箔，都人鸣玉鞭。\n酒旗遮柳出，社鼓隔花传。\n踏絮欲归去，紫骝骄不前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42664,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黎遂球公车北上","author":"李云龙","text":"所之无远近，远近在心期。\n譬如下种子，所得恒视之。\n所以万石弩，不为鼠发机。\n黎生负宿慧，早岁得皈依。\n一心持戒律，焚修遍六时。\n不离文字缘，便欲證菩提。\n今晨理宝筏，先我去江湄。\n遥瞻极乐国，乃在燕山陲。\n吾闻有漏因，不了大修为。\n一见宰官身，当作天人师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42665,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度灵羊峡","author":"朱学熙","text":"浦帆贪利涉，乘夜度灵羊。\n欲雨云情重，看山客思忙。\n数声寒狖啸，两岸春花香。\n瞬息崧台道，诸峰接渺茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42666,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石室山玉虚宫","author":"朱学熙","text":"蹑屐陟孤峰，梯云阁道重。\n瑶坛千嶂拔，玉笈九霞封。\n便可邀青鸟，相将访赤松。\n下方城郭晚，隐隐报疏钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42667,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"开自石室归舟中阻雨不得发","author":"朱学熙","text":"夕阳不可住，回首隔仙凡。\n齿漱端溪水，诗留副巉岩。\n涛欺将塌岸，雨阻欲归帆。\n点检游山具，苍云满碧衫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42668,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水月宫","author":"朱学熙","text":"为探灵嚣迹，先寻水月宫。\n慧香连斗极，花雨漫瑶空。\n犬吠白云外，僧禅翠霭中。\n十年迷下界，聊此息微躬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42669,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仙源次韩春坊韵","author":"朱学熙","text":"泠泠韵玉泻云根，万点琼珠溅墨痕。\n瀛海仙人同载笔，桃花宁问武陵源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42670,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"栎社","author":"朱学熙","text":"远自罗浮巅，弭棹返凝碧。\n有木卷且樛，高可百馀尺。\n托生名山阿，结根古磐石。\n岁寒积风烟，可屈不可易。\n垂垂广亩阴，匠石不察识。\n不为明堂用，遂免斧斤戚。\n抚尔兴长谣，托尔施枕席。\n处夫不才间，尔真吾友籍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42671,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"狮子石","author":"朱学熙","text":"既不射为虎，又不叱为羊。\n遂化为狮子，据此山之阳。\n何不往兜率，一吼醒迷方。\n会挟广成辈，煮为五岳粮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42672,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"眺虚岩 其一","author":"朱学熙","text":"远峡观难远，斯言何太讹。\n眺虚岩际望，直北见黄河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42673,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"眺虚岩 其二","author":"朱学熙","text":"但闻笙鹤音，迥与尘凡隔。\n横玉弄寒云，万里天一碧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42674,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山晖堂","author":"朱学熙","text":"真宰不绝秘，山堂开绝壁。\n怀哉诸名贤，明月酬空碧。\n天风下瑶台，满地云狼籍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42675,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苍雪崖","author":"朱学熙","text":"终古藏天巧，于今发地灵。\n翠凝岚作盖，青转壁为屏。\n共讶移三岛，何曾倩五丁。\n泠然骨可蜕，奇绝冠图经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42676,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"流香桥","author":"朱学熙","text":"碧桃临水影红绡，一阵风回花气飘。\n峡口月明仙驭返，玉笙吹过第三桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42677,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"化乐台诗","author":"朱学熙","text":"说到生公讲后经，蛟龙夜出石潭听。\n骊珠正照维高室，优钵花开兰叶青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42678,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题十九峰书院诗","author":"朱学熙","text":"人去石坛荒，当春瑶草芳。\n云连峰作构，磴尽石为房。\n流辈生何益，名山死不妨。\n飞泉盟自在，长与泻琳琅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42679,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来寺","author":"朱学熙","text":"新晴一度一登攀，无补峡灵真厚颜。\n海色渐分青壁外，溪声不断绿萝间。\n何人肯抗尘容卧，有客差同怪石閒。\n即使招提飞不到，也应奇秘甲名山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42680,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清音楼又次苏东坡韵","author":"朱学熙","text":"青天倚双壁，中流划一湾。\n谁言尚人境，宛尔清心颜。\n独忆山中人，去去何时还。\n花迷采药径，月冷封云关。\n惜哉时不与，何以答名山。\n结椽飞涧外，薙茅乱石间。\n敢云殚心力，大运终循环。\n眷言发浩叹，银涛生翠鬟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42681,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金山寺","author":"邝日晋","text":"数峰波底起，古寺远红尘。\n钟磬沉孤屿，鱼龙是四邻。\n夜灯分钓艇，朝钵乞鲛人。\n玉带遗何日，迢迢江上春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42682,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"集黄俊升亦非亭同罗仲牧诸子分赋得飞字","author":"邝日晋","text":"老来多积感，久别语翻稀。\n亭竹栖烟薄，江风吹浪飞。\n闲情同落落，衰影自依依。\n应念吾生拙，中宵慰息机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42683,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王东村梁药亭唐朴非过集时北道方归","author":"邝日晋","text":"屋尽梅花梦亦寒，徘徊犹自倚阑干。\n天涯老友云中至，驴背新诗树底看。\n半世易过闲日少，两年忽别会时难。\n笑谈不尽风如剪，惆怅长天月又残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42684,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蜀中","author":"邝日晋","text":"天分井野限峨岷，帝子城边锦作邻。\n栈口抱鹅过鸟道，船头击鼓止牵人。\n穴通殊域终归汉，剑贯长虹不阻秦。\n休说郎当风雨夜，永安宫草久成尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42685,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邺中","author":"邝日晋","text":"魏武台高瞰大河，西陵四望只悲歌。\n三分地割终炎汉，四十年馀属永和。\n词赋一家怜独切，英雄千古感偏多。\n行人尚觅宫前瓦，风雨何心长绿萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42686,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上巳日同天和尚返棹却事用韵","author":"邝日晋","text":"久不对江水，鉴形如故人。\n岸容已寂寞，草意竞鲜新。\n迹寄沧浪淼，心从物外亲。\n天风吹海沫，聚散亦相因。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42687,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金山寺","author":"邝日晋","text":"天风吹欲去，孤坐四无邻。\n树杪洪涛落，云移杰阁新。\n夜灯分钓艇，朝钵乞鲛人。\n欲浣江心水，禅衣不染尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42688,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再入栖贤谒天和尚","author":"邝日晋","text":"不到匡山久，依稀谷口云。\n溪声自相答，潭影此中分。\n倦羽思幽托，高飞势绝群。\n路寻松顶出，钟磬下方闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42689,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"磊园舍作梵刹英石假山为势家求去诗以送之","author":"邝日晋","text":"廿年选石激潺湲，叠壑层峦待掩关。\n百尺巉岩方壁立，一朝陵谷等云閒。\n移来不觉惊涛险，别去应知说法难。\n谁惜锋棱俱损尽，蘧然坚骨渐成顽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42690,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"请藏嘉禾舟中即事","author":"邝日晋","text":"孤舟容膝自能安，咒合滩声十八盘。\n江树迎人如旧识，青山过眼倩谁看。\n烟横吴岫知春早，暖入平湖见雪残。\n载得一乘归静社，手翻千卷解空观。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42691,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"磊园","author":"邝日晋","text":"馀灯深夜不成辉，片片寒风透纸帷。\n三径菊松新月照，五湖书信故人遗。\n病多语拙交应少，老去年残梦已稀。\n自是倦游无一事，柴门不掩有云归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42692,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归意","author":"邝日晋","text":"一为送客出城闉，复向江天忆白蘋。\n看竹已深三月雨，拥书仍拂去年尘。\n芭蕉叶响同归梦，芳草烟迷滞远人。\n君到六桥应计日，绿沉如蜡柳丝新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42693,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日送沈苍玙给谏册封大原定安藩","author":"卢上铭","text":"周室千年庆祚长，天潢繁衍有辉光。\n桐圭新锡劳星使，画阁初筵贡玉觞。\n风柳满堤分锦袂，火云驰道绕龙骧。\n他时宴罢梁园月，应羡相如作赋郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42694,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"战城南","author":"卢上铭","text":"战城南，歌城北。\n将改弦，军易辙。\n不杀民，只杀贼。\n妖氛清，皇灵赫。\n洗兵戈，布膏泽。\n吏部来，归拓疆，昼战城南歌城北。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42695,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送徐亮生夫子开府登莱","author":"卢上铭","text":"中丞分斧钺，天子赐麟裘。\n社稷安危寄，干戈谭笑收。\n功成明主眷，威动敌人愁。\n珍重吾师去，防边及早秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42696,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄怀苏宇霖明府","author":"卢上铭","text":"愚直与时忤，谪居弹铗歌。\n平生重朋友，雅性寄沧波。\n念切江云远，思深明月过。\n河阳花似锦，仙吏得民和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42697,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答石翥云次韵","author":"卢上铭","text":"天涯逢胜侣，此别忆高风。\n多谢白云吏，犹怜苍鬓翁。\n坐看云变态，招隐桂成丛。\n寂寂圜门里，相思不可穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42698,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏送陈水部榷荆关","author":"卢上铭","text":"君王宵旰重筹边，汉使乘骢下楚天。\n蓟北未销金锁甲，荆南应贡水衡钱。\n玉河堤柳堪持赠，祖道离觞且暂传。\n别后尺书无雁足，怀君魂梦隔晴川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42699,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚辰春杪别圜中诸友","author":"卢上铭","text":"半载圜扉侍绛帏，离情相对更歔欷。\n三闾去国难为念，五柳归田暂息机。\n蕉下未醒谁梦鹿，枕中赢得自轻肥。\n却怜放逐恩如海，犹幸君王赐铁衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42700,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"俯江亭用亭上韵","author":"卢上铭","text":"危亭突兀瞰岩浮，燕子飞飞似泛舟。\n江势远吞扬子怒，云痕低锁美人愁。\n双龙破浪冲京口，万马腾空出石头。\n南国自惭为客久，可堪重倚望乡楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42701,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒岳武穆祠","author":"卢上铭","text":"妙略摅恢复，精忠矢报酬。\n独怜三字狱，断送二陵愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42702,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华表江声","author":"萧九皋","text":"标空峭壁倚江隈，入望江声动地来。\n水接苍梧通八桂，山连北极近三台。\n夜深拟和南征曲，风起应同玉剪催。\n闻道吕梁波峻急，汪澜千古砥潆洄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42703,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"文昌萝月","author":"萧九皋","text":"东郊烟树远依依，解指文光照翠微。\n芦荻溪边遥共映，薜萝丛上逗清辉。\n文心似雪盈阶玉，笔底生花满树琪。\n霓羽当年知满匣，嫦娥应共乐芳扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42704,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"文峰耸汉","author":"萧九皋","text":"崚嶒削立插云天，缥缈空中小八埏。\n奎壁星连光射斗，蛟龙日暖灿临川。\n东封碣石为池砚，西借昆阳作纸笺。\n赋就金门成五色，应多雁塔著名贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42705,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"文笔山","author":"萧九皋","text":"谁将班管插遥天，苍翠横空文自妍。\n澹点秋旻排雁字，浓添春雾走龙蜒。\n便移锦石为池砚，即把香云作纸笺。\n赋就金门成五色，应多雁塔著名贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42706,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"昭平五日","author":"苏胤适","text":"行行客悄然，荒树落霞天。\n独水万山合，孤城一弹悬。\n风多夷汉杂，径尚虎狐穿。\n傍楚能怀古，笙歌吊屈船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42707,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日邹崖吊古","author":"苏胤适","text":"岸帻编萸九日村，孤臣万里旧盘蹲。\n只将正气留天地，不爱英魂叩阖阍。\n山石嶙峋层汉出，江流澎湃撼崖喧。\n低徊未尽伤忠思，峭壑悲风起暮猿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42708,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"胡仰山倭播功成上绩 其一","author":"苏胤适","text":"扬帆东下海氛消，马度岷山气转骄。\n云阵三千横太乙，将军十八数嫖姚。\n功书大幕劳分虎，技折中原惯落雕。\n万里威名寒漠朔，望悬双帜倚天摇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42709,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]