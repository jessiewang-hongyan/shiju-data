[{"title":"长兴哭子与归途即事有感 其三","author":"王世贞","text":"当年六子五沈沦，一作人间舌底人。\n暗数古来文苑传，谁能白发画麒麟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长兴哭子与归途即事有感 其四","author":"王世贞","text":"碧练东来是霅川，银鱼紫蟹不论钱。\n从他风景长如画，割却浮家一段缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长兴哭子与归途即事有感 其五","author":"王世贞","text":"太初收骨道场山，与隔新坟定几湾。\n六十年来无麦饭，可能相对忆人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长兴哭子与归途即事有感 其六","author":"王世贞","text":"玉龙桥下水纵横，酒眼摩娑醉语轻。\n不道便成生死别，至今犹自恨潮声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"余所品顾家三白酒以甘败而近得其法者皆胜之因补三绝句而其一以贻胡家 其一","author":"王世贞","text":"品酒新诗亦浪传，顾家三白大非前。\n如何夺署青帘字，把向胡生店里悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"余所品顾家三白酒以甘败而近得其法者皆胜之因补三绝句而其一以贻胡家 其二 沙头吕氏酒","author":"王世贞","text":"扫地人间色味铨，自将真趣媚丹田。\n从教扬子中泠品，不及沙头第一泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"余所品顾家三白酒以甘败而近得其法者皆胜之因补三绝句而其一以贻胡家 其三 五弟妇之兄曰章郎酒亦清美","author":"王世贞","text":"压得檀槽瑟瑟珠，泻时犹有看成无。\n谁能闲步桃花涧，不向章郎乞一壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明日偶题 其一","author":"王世贞","text":"秾李夭桃各斗新，伤心眼底上坟人。\n生憎介子成寒食，破损风光一日春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明日偶题 其二","author":"王世贞","text":"典却寒襦挂纸钱，又闻呼役向杨川。\n三家两舍无薪米，错认江南也禁烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过瞻美弟饮题","author":"王世贞","text":"傍水诛茅三五椽，网鱼沽酒杏花前。\n欲知何物堪难弟，夜半酣歌不肯眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过从子学贤饮","author":"王世贞","text":"小阮才余犊鼻裈，海棠花底奏清尊。\n春光如此休教负，明日催租任打门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乡居晏起","author":"王世贞","text":"小楼烟雨乍霏霏，支枕消教酒力微。\n除却西邻呼酒外，判无剥啄到荆扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"走笔再送冯使君之楚 其一","author":"王世贞","text":"三吴重地古来闻，全楚雄藩更不群。\n江岸送迎饶竹马，何人不颂大冯君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"走笔再送冯使君之楚 其二","author":"王世贞","text":"卷雾凌风青雀开，分明一坐玉山来。\n悬知傲杀南楼月，重见千秋庾亮才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠张老","author":"王世贞","text":"莫欺贫惫少生涯，半亩沙田百种花。\n笑杀东篱黄菊后，春光全不到陶家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"调姚山人匡叔","author":"王世贞","text":"羽扇藤衫竹箨冠，自言亲受九还丹。\n无端却爱人间好，不怕山房丹灶寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鳦先以书自通于屠青浦有国士之遇赋此赠之","author":"王世贞","text":"于生书记似邹阳，片纸能专上客床。\n不信比来知己事，试闻犹有令君香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱定国解馆归明州赠之得三绝 其一","author":"王世贞","text":"风物清佳浣客愁，不知何事忆明州。\n轻舠泛尽东湖色，应向娄江问旧游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱定国解馆归明州赠之得三绝 其二","author":"王世贞","text":"两儿头角渐嶙峋，三载东风绛帐春。\n白虎倘逢明主问，可能忘得授经人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱定国解馆归明州赠之得三绝 其三","author":"王世贞","text":"惜别飞觞各斗干，吴江枫落未成寒。\n惟怜十月山阴道，不共王家子敬看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题摘阮图","author":"王世贞","text":"绛纱微露玉尖纤，搊得新声字阿咸。\n门外平康佳姊妺，即今偷谱不须嫌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠照幻禅师一绝句","author":"王世贞","text":"伏牛山下结精庐，炼尽群魔剩一如。\n谁信近来能所尽，贯休诗句梦英书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金泽寺僧为余生日诵经报以一绝","author":"王世贞","text":"除却生辰荐亲外，酒船何处不沈冥。\n即今四大留何事，劳得山僧为捧经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题溪山深隐画","author":"王世贞","text":"古木寒流一两家，柴门昼掩待归鸦。\n何如只向人间住，与客携壶踏落花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庄临甫力田种竹有长者风今六十矣其婿陈生懋谦中表侄也索诗寿之得一绝句","author":"王世贞","text":"庭前种竹一千竿，屋后收禾三百廛。\n欲向而家漆园祖，与君重注大椿年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题何鸿胪仁仲甘露园 其一","author":"王世贞","text":"名从铁瓮城边得，人向金茎梦后归。\n豆蔻梢头浑欲醉，芙蓉叶上未应晞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题何鸿胪仁仲甘露园 其二","author":"王世贞","text":"海内争传杜甫诗，何将军第有园池。\n金鱼银甲从他好，第五名高心自知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题何鸿胪仁仲甘露园 其三","author":"王世贞","text":"一点晨光霜欲开，露华初润蕊珠台。\n墙头蛱蝶冲眉过，却道何郎傅粉来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题何鸿胪仁仲甘露园 其四","author":"王世贞","text":"千株桃李怨春华，九畹芳兰也自嗟。\n水部向来心性别，只拈霜管赋梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王山人良材二绝 其一","author":"王世贞","text":"返照轻烟晕碧纱，翠禽翻罢玉横斜。\n绝胜黄鹤楼中笛，落尽还开六月花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王山人良材二绝 其二","author":"王世贞","text":"尔貌孤山雪里春，能抛玉骨染缁尘。\n悬知不作毛生手，却误江妃自写真