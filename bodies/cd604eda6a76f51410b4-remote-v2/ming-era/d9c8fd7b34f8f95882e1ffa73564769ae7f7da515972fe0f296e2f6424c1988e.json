[{"title":"溪上怀姚明府","author":"佘翔","text":"溪头新水到柴关，白鸟忘机自往还。\n日暮怀人高卧处，数椽?屋九华山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20236,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送林太史之京 其一","author":"佘翔","text":"题柱才名岁月深，风流谁不羡词林。\n趋朝偏得君王宠，金马无劳叹陆沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20237,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送林太史之京 其二","author":"佘翔","text":"蓟北遥闻长乐钟，金茎秋色露华浓。\n东南不尽疮痍泪，献纳还看动九重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20238,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送林太史之京 其三","author":"佘翔","text":"前驱驷马出青山，鸣佩初随鹓鹭班。\n赋就长杨曾谏猎，汉廷簪笏侍龙颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20239,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鄱阳湖歌","author":"佘翔","text":"赤乌日日下鄱阳，十万楼船杀伐张。\n一自鲸鲵先授首，东南无处不梯航。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20240,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题郑兆念采精舍","author":"佘翔","text":"高斋读罢思飞扬，把酒花间日正长。\n最爱君家书带草，青葱似染綵毫香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20241,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送郑士亮游吴 其一","author":"佘翔","text":"江上桃花春水生，孤帆遥下阖闾城。\n杖头一醉吴姬酒，清夜还歌白苧声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20242,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送郑士亮游吴 其二","author":"佘翔","text":"建业斜峰入望遥，行边剑气倚青霄。\n凤凰台上青青草，几度题诗吊六朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20243,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送郑士亮游吴 其三","author":"佘翔","text":"侠气纵横结五陵，扁舟到处兴堪乘。\n江东不少豪华客，惟有莼鲈忆季鹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20244,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"别许元复","author":"佘翔","text":"阊门杨柳散秋阴，斗酒相看一片心。\n日暮江头乘舸去，寒山回首白云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20245,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"桃叶渡别顾君友","author":"佘翔","text":"酒满秦淮花满楼，春风吹动木兰舟。\n不知陌上千条柳，曾绾离人一片愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20246,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄曹参军 其一","author":"佘翔","text":"白雪飞扬郢调高，风流妒杀五陵豪。\n浮云较与秋云薄，且对吴山拟反骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20247,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄曹参军 其二","author":"佘翔","text":"结客谈兵幕府才，蹉跎宦迹转堪猜。\n独醒总为风尘忌，湖上兰桡醉几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20248,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送方子充司理宜阳","author":"佘翔","text":"奉檄西行过柳州，獞猺抛弩拜君侯。\n讼庭吏散桄榔下，题遍新诗叶上秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20249,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏史","author":"佘翔","text":"不见年华逐水流，蛾眉争宠日生愁。\n相如纵有千金赋，买得春风不白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20250,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宁海晚眺","author":"佘翔","text":"海上晴虹驾作桥，云连蜃气望迢迢。\n三江日暮涛声起，不数西陵八月潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20251,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日留云阁晚眺 其一","author":"佘翔","text":"东山高阁迥淩云，人倚雕阑醉夕曛。\n春树万家看不尽，隔林清磬一声闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20252,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日留云阁晚眺 其二","author":"佘翔","text":"白云深处瞰沧溟，有客凭高醉不醒。\n睥睨城头低落日，飞来萝月数峰青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20253,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江口道中","author":"佘翔","text":"路旁芳草正萋萋，游子朝来别故溪。\n回首壶公魂欲断，前山又听鹧鸪啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20254,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"客中对月","author":"佘翔","text":"客舍黄昏独倚阑，月光一片望中寒。\n应知此夜深闺妇，肠断蛾眉不忍看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20255,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泊水口怀亡友林制成","author":"佘翔","text":"扁舟曾共谒承明，十载重过感慨生。\n溪上独怜今夜水，潺湲犹作去时声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20256,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送林廷诏之广西 其一","author":"佘翔","text":"少年词赋拟淩云，岭外愁为两地分。\n明日听猿经古墓，且将双泪吊刘蕡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20257,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送林廷诏之广西 其二","author":"佘翔","text":"迢递关山独送行，炎方望断瘴烟生。\n伏波古道看铜柱，三尺吴钩箭里鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20258,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送林廷诏之广西 其三","author":"佘翔","text":"游子天涯泪湿衣，相逢无奈又相违。\n倚门白发千山外，觅得丹砂及蚤归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20259,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中溪亭即事","author":"佘翔","text":"一溪春水绿平桥，野老临流酒一瓢。\n多少新诗吟不就，东风吹雨滴芭蕉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20260,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"真州寄张士馨","author":"佘翔","text":"江城杨柳绿毵毵，客舍长歌酒半酣。\n寄语金陵游侠子，春宵无梦不江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20261,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梦园菊离离起而有感","author":"佘翔","text":"白水塘边旧草莱，十年三径锁苍苔。\n寒花解得人归意，昨夜分明入梦来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20262,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"青溪舟中夜雨 其一","author":"佘翔","text":"云扫南山锦石寒，孤舟何意滞江干。\n夜来听得萧萧雨，疑是桐庐七里滩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20263,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"青溪舟中夜雨 其二","author":"佘翔","text":"新安流水下青溪，寒雨孤舟暝色迷。\n此夜断肠吟不得，南山又听鹧鸪啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20264,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送詹淑正还新安寿母兼同颜舍人质卿同登太山 其一","author":"佘翔","text":"黄山山上削芙蓉，十二楼台紫气重。\n春酒如渑将母去，何须仙掌露华浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20265,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送詹淑正还新安寿母兼同颜舍人质卿同登太山 其二","author":"佘翔","text":"婺星光映五云车，花里裁班进紫霞。\n况是轩辕峰下住，容城分得灶中砂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20266,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送詹淑正还新安寿母兼同颜舍人质卿同登太山 其三","author":"佘翔","text":"东望名山黛色开，凤池有客共登台。\n白云一片封中起，如带黄河万里来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20267,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送詹淑正还新安寿母兼同颜舍人质卿同登太山 其四","author":"佘翔","text":"幸舍长歌一蒯缑，飘零漫自客幽州。\n扁舟归下詹何钓，怀刺无劳谒五侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20268,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"富春舟中","author":"佘翔","text":"寒云落木晚萧萧，人与孤舟对寂寥。\n忽见西风吹五两，月明还趁浙江潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20269,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"小湖枕上","author":"佘翔","text":"万壑濛濛雾不开，扁舟梦逐故乡回。\n恼人最是滩头水，夜半潺湲带雨来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20270,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"马上即事","author":"佘翔","text":"万壑春流泻海门，人家多住绿杨村。\n花飘马首如红雨，何处听莺不断魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20271,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蒜岭雨中","author":"佘翔","text":"雨来马上扑征衣，芳草萋萋去路微。\n况是江村寒食候，鹧鸪啼处乱花飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20272,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"囊山迟郭士龙不至","author":"佘翔","text":"寻僧野寺不知还，秋色藤萝正可扳。\n不见游仙来郭璞，缁衣何处负青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20273,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠无著上人","author":"佘翔","text":"为爱名山入武夷，浮云缥缈更何之。\n五台山下栖禅处，种得菩提树一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20274,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚度仙霞岭有怀","author":"佘翔","text":"枫林霜冷叶初斑，鸟道行人返照间。\n忽见南鸿云里度，为谁回首九华山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20275,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"保安道中怀颜廷渠","author":"佘翔","text":"青山历历半丹枫，人在天涯各转蓬。\n不念无诸城下别，五湖明月好谁同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20276,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江郎石","author":"佘翔","text":"凌云鼎立势亭亭，曾是三峰劈巨灵。\n欲跨飞翰临绝顶，空中手摘白榆星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20277,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清湖馆中别诸弟还乡","author":"佘翔","text":"湖海相逢落魄年，汝归故国我风烟。\n临岐且尽垆头兴，莫说天涯乏酒钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20278,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清湖夜雨","author":"佘翔","text":"岁暮凄凉雨有声，依依客舍缓行程。\n高楼夜冷衣偏薄，击柝愁人到五更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20279,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"兰溪舟中怀吴元瑞","author":"佘翔","text":"吴山山下一逢君，五载鸿书杳不闻。\n今日扁舟过瀫水，一尊犹自隔青云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20280,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀吴隐士","author":"佘翔","text":"少君清净道家流，一别新都忽两秋。\n欲问巢云空谷里，千峰落日倚孤舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20281,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"严濑舟中诵姚巽卿赠别诗有世路危于七里滩作此寄意","author":"佘翔","text":"读罢新诗恼客魂，人情反覆未须论。\n清泠依旧严陵水，日夜东流望海门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20282,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"射阳夜泊","author":"佘翔","text":"扁舟荡漾逐飞凫，湖上春涛薄孟诸。\n不识骊龙何处睡，飞来片月似明珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20283,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"那叱矶","author":"佘翔","text":"江上徵兵赴国门，石城龙斗不堪论。\n一时鱼腹千秋泪，不独怀沙吊屈原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20284,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谢公墩同周文美张子明九日作","author":"佘翔","text":"九日登高菊未花，衔杯共倚白云斜。\n豪华六代俱销歇，依旧青山属谢家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20285,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"圯上吟","author":"佘翔","text":"欲报韩仇不顾家，中原逐鹿乱如麻。\n若非圯上传黄石，沧海空椎博浪沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20286,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"经沛中作","author":"佘翔","text":"城池寂寞旧山河，赤帝归来万乘多。\n龙去鼎湖无日返，大风犹唱沛中歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20287,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"淮阴祠","author":"佘翔","text":"莫怪留侯慕赤松，后车云梦縳相从。\n至今呜咽淮阴水，空恨当年长乐钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20288,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春愁","author":"佘翔","text":"芙蓉帐里郁金香，梳罢云鬟试绮裳。\n谁道春愁花不解，飞来额上斗新妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20289,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋得西枝室","author":"佘翔","text":"少结茅庵曲水傍，斋心日夕礼空王。\n一枝分得菩提树，种得旃檀片片香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20290,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"李伯承西园催菊","author":"佘翔","text":"竹影参差夕照斜，不知秋色在谁家。\n葛巾倒著东篱下，几度衔杯问菊花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20291,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题陈子卿此君轩","author":"佘翔","text":"气压元龙百尺楼，摊书偏爱竹脩脩。\n有时笑倚婵娟月，一片西山翠欲流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20292,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"淮阴城下作","author":"佘翔","text":"春草萋萋楚水流，天涯日暮倚扁舟。\n淮阴葬地今何在，年少纷纷觅拜侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20293,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题冶城吴道士竹房","author":"佘翔","text":"床头一帙五千言，竹里柴扉昼不喧。\n酒似桃花春似海，避秦何必武陵源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20294,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭五君","author":"佘翔","text":"一曲凄凉薤露歌，贤人眼底渐消磨。\n所嗟不是龙蛇岁，湖海归来涕泪多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20295,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郑观察茂","author":"佘翔","text":"东山杯酒惜离群，此日生刍奈哭君。\n依旧南湖春草绿，鹧鸪啼处不堪闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20296,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"戴太守","author":"佘翔","text":"木兰陂上白云多，泪满当年旧薜萝。\n谁道扁舟堪尽兴，垆头今已邈山河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20297,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"林侍御史休徵","author":"佘翔","text":"秋风骢马别燕山，采药归来合闭关。\n一叱神羊飞不返，空馀疏草落人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20298,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"黄博士衮","author":"佘翔","text":"文章如锦一毡寒，服食谁传九转丹。\n忆醉紫阳山月下，故园此夜对谁看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20299,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柯明府茂竹","author":"佘翔","text":"才子为郎制锦新，琴书不解橐中贫。\n丹成便尔飞凫去，愁杀东篱漉酒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20300,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"七夕风雨有怀","author":"佘翔","text":"无边风雨夜萧萧，牛女何曾渡鹊桥。\n别有愁肠眠不得，隔窗欹枕听芭蕉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20301,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜郑拱元见过","author":"佘翔","text":"谷口风流郑子真，兴来海上问波臣。\n衔杯恰对三洲月，白首相怜有几人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20302,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"醉后题尧衢酉室","author":"佘翔","text":"去年尊酒对花朝，今日重来破寂寥。\n扫壁题诗人已醉，一天秋雨暮萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20303,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨夜宿文蔚斋中","author":"佘翔","text":"交情谁复似芝兰，一室相将拥鹖冠。\n坐对西窗频剪烛，芭蕉叶上雨声寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20304,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题可秩书斋 其一","author":"佘翔","text":"衡门背郭草堂清，书草参差绕砌生。\n试看青藜分太乙，夜阑读易照寒檠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20305,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题可秩书斋 其二","author":"佘翔","text":"名家旧学起青箱，四壁图书白日长。\n莫怪城头云五色，一庭花染綵毫香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20306,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题可秩书斋 其三","author":"佘翔","text":"槛外芙蓉插汉斜，登楼直欲采三花。\n客来不尽论文兴，把酒空庭想月华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20307,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题可秩书斋 其四","author":"佘翔","text":"名花如绮傍雕阑，小径烟花竹数竿。\n读罢玄经无别事，倚阑一曲月中弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20308,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孤山社燕集 其一","author":"佘翔","text":"湖上晴云散绿波，六桥欸乃起渔歌。\n孤山此日开诗社，杜若洲边白鸟多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20309,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孤山社燕集 其二","author":"佘翔","text":"春尽平林路转纡，青山如黛错行厨。\n坐中别有风流客，将酒花间酹小苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20310,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀顾道行","author":"佘翔","text":"风流谁似虎头痴，湖海相逢未有期。\n此夜孤舟看片月，垂虹桥畔咏新诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20311,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"槜李舟中题扇头梅花寄程君衡","author":"佘翔","text":"春风披拂柳如丝，槜李舟中独酌时。\n写得罗浮春一片，寄将江左慰相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20312,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴道士招余馆中 其一","author":"佘翔","text":"元馆无尘紫气多，相逢偏爱老婆娑。\n黄庭写就偿留榻，不似山阴换白鹅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20313,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴道士招余馆中 其二","author":"佘翔","text":"一室栖迟淡世情，夜来却听步虚声。\n他年并驾缑山鹤，与尔逍遥谒太清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":20314,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]