[{"title":"郊祀伏睹驾出二首 其二","author":"张元凯","text":"上帝歆元祀，南郊启閟宫。\n幸逢尧丽日，仰见舜重瞳。\n仙乐闻难尽，霓旌望不穷。\n材官多侍从，偏我隐墙东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28796,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日游西苑二首 其一","author":"张元凯","text":"宣室临西苑，灵台对籍田。\n宫莺迷绿雨，厩马饮清川。\n柳引金堤直，松含玉殿圆。\n先皇受釐处，寂寞锁春烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28797,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日游西苑二首 其二","author":"张元凯","text":"禁云流不尽，苑树碧丛丛。\n水浅鸳鸯岛，花深翡翠宫。\n引泉珠错落，叠石玉玲珑。\n莫认桃源路，银河岂易通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28798,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"部饷至京引见皇极门时戊辰九月五日二首 其一","author":"张元凯","text":"玉几星垂拱，金门旭始开。\n夔龙端简侍，扬马执经来。\n灵曜瞻难定，神飙瞩易回。\n进呈盐铁论，付与度支裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28799,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"部饷至京引见皇极门时戊辰九月五日二首 其二","author":"张元凯","text":"云日散高秋，钟鸣五凤楼。\n面君今日喜，在野十年忧。\n下走惭簪绂，前驱愧蒯缑。\n无能驯鹿性，终尔怯螭头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28800,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"引见赐宴恭纪二首 其一","author":"张元凯","text":"天语传闻近，山呼引拜遐。\n鸿胪跽承旨，光禄立开衙。\n白粲分阶玉，黄流借殿霞。\n彻归成独享，此际益思家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28801,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"引见赐宴恭纪二首 其二","author":"张元凯","text":"重漕明主意，既醉远臣心。\n席避彤庭日，筵依松树阴。\n大官多且旨，小史酌还斟。\n世食天朝粟，衔恩岂自今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28802,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长安春望二首 其一","author":"张元凯","text":"莺花鸣凤晓，钟鼓濯龙开。\n湛露仙人掌，晴云日观台。\n河将银汉去，山向玉宸来。\n辇下阳春曲，能容骑尉裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28803,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长安春望二首 其二","author":"张元凯","text":"太和盈宇宙，烂漫遍光华。\n美丽都人绮，芳菲辇道沙。\n紫骝衔禁草，黄鸟卧宫花。\n一望千重殿，常生五色霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28804,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长安街伏睹庄皇帝梓宫归山陵二首 其一","author":"张元凯","text":"虎贲趋上将，龙驭从群仙。\n■幕灵芝盖，祠坛瑞玉筵。\n进贤冠未毁，斩佞剑犹悬。\n帝子真纯孝，冲年泪似泉。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28805,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长安街伏睹庄皇帝梓宫归山陵二首 其二","author":"张元凯","text":"薤露盈驰道，臣民候挽齐。\n山河俄改色，草树尽含凄。\n象卫过金马，刍灵出碧鸡。\n有髯攀不及，怅望鼎湖西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28806,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"朝皇极殿颁万历改元历时壬申十月朔二首 其一","author":"张元凯","text":"凤凰栖沼上，鳷鹊朗云中。\n周室方全盛，成王在幼冲。\n休徵方出洛，天寿尽呼嵩。\n卜历元无算，编年万未穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28807,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"朝皇极殿颁万历改元历时壬申十月朔二首 其二","author":"张元凯","text":"湛露收青汉，云韶出紫宸。\n颁来一统历，散去万家春。\n宣室重禧肇，明堂受命新。\n世臣唯饱饭，常作太平人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28808,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观象台看雪二首 其一","author":"张元凯","text":"人间寒逾切，天上瑞先呈。\n不辨黄金屋，唯看白玉京。\n风花连汉畤，冰叶满秦城。\n此日观乾象，璇玑分外明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28809,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观象台看雪二首 其二","author":"张元凯","text":"铜龙高失翠，玉尺旋生华。\n星宿灵妃府，琼瑶帝子家。\n光留长信月，影乱上林花。\n一望银潢接，寻源未有槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28810,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"席上呈申太史二首 其一","author":"张元凯","text":"几席留明月，花枝带禁烟。\n酒醲分玉醴，烛短剩金莲。\n史是迁之后，文如汉以前。\n且辞长夜饮，蚤起从甘泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28811,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"席上呈申太史二首 其二","author":"张元凯","text":"夹道通仙署，清槐无世尘。\n寂寥桑梓客，参对草麻人。\n露掌铜龙近，天颜金马亲。\n治安垂万世，公等绾丝纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28812,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"访胡原荆侍御","author":"张元凯","text":"相逢宣武第，暂解惠文冠。\n清泪长安尽，秋霜短鬓残。\n栖乌纤月落，鸣凤上阳寒。\n圣政元无阙，封章莫浪弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28813,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮冯杜二使君","author":"张元凯","text":"暂罢金銮直，来为鸡黍期。\n大冯元补阙，小杜亦分司。\n谏草防人见，觥筹任客私。\n故园凋落尽，不是在家时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28814,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠晋陵王太学二首 其一","author":"张元凯","text":"五侯千日醉，七贵一家亲。\n避地依京洛，愁身浪笑嚬。\n青衣歌宛转，白眼看沉沦。\n何似金门客，嗟嗟叹积薪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28815,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠晋陵王太学二首 其二","author":"张元凯","text":"羡尔遨游美，何知旅食艰。\n长杨驰马去，芳草踏歌还。\n久住唯金谷，常颓是玉山。\n燕姬新买得，江上杏花颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28816,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"潞河中秋初度二首 其一","author":"张元凯","text":"问年逢六六，逆旅自茕茕。\n白发须臾事，黄金乌有生。\n据鞍宁待试，邀笛不辞行。\n愁绝今宵月，重圆蓟北城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28817,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"潞河中秋初度二首 其二","author":"张元凯","text":"桂影青天满，桑乾白水斜。\n公车不待诏，客舍秪思家。\n报主雌雄剑，谋生子母瓜。\n去年今夜酒，吴市听琵琶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28818,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"广福寺寓二首 其一","author":"张元凯","text":"不梦麒麟阁，皈依孔雀王。\n蒲团閒里过，药裹定中忘。\n宴坐霞餐晚，清言水观凉。\n空门无一事，养就懒嵇康。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28819,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"广福寺寓二首 其二","author":"张元凯","text":"白璧空投路，青山且息机。\n隙驹怜促影，怖鸽倦雄飞。\n迹许畸人识，心甘静者依。\n尘襟方欲浣，暂借水田衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28820,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送原荆归田二首 其一","author":"张元凯","text":"敢言身讵惜，怅别袂难分。\n徒步燕山雪，悲歌易水云。\n纲常一疏见，恸哭两宫闻。\n不遣长沙去，君恩厚汉文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28821,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送原荆归田二首 其二","author":"张元凯","text":"大戆微臣罪，馀生圣主留。\n迟回方出昼，黯澹似悲秋。\n妻子谙田作，亲朋仰岁收。\n青青桓氏马，不见玉街游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28822,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"醉宿幼元寓二首 其一","author":"张元凯","text":"方朔栖金马，文园卧锦茵。\n远携阳羡秫，乍酿洞庭春。\n红树摇歌扇，青衣动舞尘。\n沉酣自吾党，休沐肯嫌频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28823,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"醉宿幼元寓二首 其二","author":"张元凯","text":"为欢常卜夜，不厌酒淋漓。\n湿尔凤毛好，濡吾燕颔奇。\n放歌惊宿鸟，深坐待朝曦。\n却洗何人事，高阳郦食其。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28824,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送朱在明使楚","author":"张元凯","text":"十里河梁暮，天寒送子迟。\n冰坚车乱度，雪厚路多疑。\n大别江平掌，九疑山画眉。\n长沙衔使命，莫作逐臣悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28825,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同幼元饮光禄署","author":"张元凯","text":"纵饮防人见，盘餐窃自传。\n黄流银海注，翠釜玉绳悬。\n柳外君庖迥，花间仙署连。\n大珰来络绎，臂以绿韝缠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28826,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"潞河雪二首 其一","author":"张元凯","text":"十月燕山雪，孤舟潞水涯。\n沙滩银浪细，岸柳玉条斜。\n逐鹭宁分羽，栖芦欲混花。\n蓬窗莫令进，易惹鬓生华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28827,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"潞河雪二首 其二","author":"张元凯","text":"雪霰今朝集，寒冰昨夜坚。\n幸存东郭履，不赋北门篇。\n客路黄云外，乡书白雁边。\n关河无锁钥，偏阻未归船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28828,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"塞下二首 其一","author":"张元凯","text":"都护称飞将，提兵禦犬戎。\n楚弓斜抱月，边马竞追风。\n魏绛和无议，秦开战有功。\n黄金新铸印，擎出大明宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28829,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"塞下二首 其二","author":"张元凯","text":"乘鄣蛮云白，行营汉月新。\n回中牧马地，句注引弓民。\n傍夏不消雪，入关才有春。\n天王大一统，冒顿久称臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28830,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"少年二首 其一","author":"张元凯","text":"长杨驰马去，平乐斗鸡回。\n婉媚贝为带，欢娱金作罍。\n横行羡田窦，侍从陋邹枚。\n不惜耽荒宴，朱颜良易摧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28831,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"少年二首 其二","author":"张元凯","text":"桃李芳菲候，流苏春帐悬。\n文君侍琴瑟，太主发金钱。\n玉具芙蓉剑，银装玛瑙鞭。\n单车花底散，人望俨如仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28832,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"折柳","author":"张元凯","text":"三春杨柳绿，一望泪潸潸。\n匹马此曾系，长条忍再攀。\n翠凋愁里鬓，红减别时颜。\n风絮轻千里，将心度玉关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28833,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"边月","author":"张元凯","text":"半轮升古塞，长剑度河堤。\n绕碛黄狐穴，连沙白雁栖。\n军声传蓟北，霜色满辽西。\n此际征人泪，应同少妇啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28834,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闺思二首 其一","author":"张元凯","text":"夫婿萧关外，音书寂不闻。\n朝朝江上石，夜夜枕边云。\n鸾镜元羞妾，蛾眉好待君。\n还将丝一寸，绣作锦回文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28835,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闺思二首 其二","author":"张元凯","text":"夜梦空飞远，朝心郁不开。\n宝钗寒翠羽，瑶瑟长青苔。\n花瓣粘蜂去，晴丝罥燕来。\n前鱼无暇泣，别鹤恨难裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28836,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"薄命","author":"张元凯","text":"三载食君贫，严霜六月侵。\n但能留一剑，何惜抱孤衾。\n镜里花如貌，人间石比心。\n羞他机下妇，含笑为黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28837,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"青楼","author":"张元凯","text":"女郎能任侠，结客少年时。\n容颜市金币，肝胆刺恩私。\n密约来原剧，穷交自扊扅。\n信陵归魏后，何以报如姬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28838,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春宴二首 其一","author":"张元凯","text":"燕寝氍毹榻，雕盘涧沚毛。\n将军青最幸，词客白犹豪。\n华月高梧影，冰弦流水操。\n两行红粉在，谁是郑樱桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28839,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春宴二首 其二","author":"张元凯","text":"锦屏开子夜，珠履集春申。\n诮凤非无客，图麟合有人。\n樽前摇白羽，花下卧朱轮。\n妙舞清歌后，幽怀可具陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28840,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寺居二首 其一","author":"张元凯","text":"穴处聊同蚁，巢居反借鸠。\n偶来依净土，常自对沧洲。\n云乱竹间度，泉分花下流。\n未须论出世，吾自乞吾休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28841,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寺居二首 其二","author":"张元凯","text":"未定去来意，其如生灭何。\n舍身能忍辱，听法可降魔。\n白日一僧语，青天双鸟过。\n悠然会心处，潭影印松萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28842,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠客","author":"张元凯","text":"明时难自见，牢落不羁才。\n富贵浮云耳，乾坤传舍哉。\n宁忧塞马失，呼得野鹰来。\n王粲愁亡赖，同登江上台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28843,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"社日","author":"张元凯","text":"春社散柴桑，迟回度石梁。\n饭牛嗟百里，割肉笑东方。\n细雨青山湿，桃花流水香。\n野鸥浑狎我，飞近扑衣裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28844,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"偶成二首 其一","author":"张元凯","text":"家贫常罢尉，身懒似逃名。\n繁弱提偏重，岑牟著更轻。\n柳疏莺晚逗，花落蝶先迎。\n食肉非吾分，持螯过此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28845,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"偶成二首 其二","author":"张元凯","text":"不乐区中偪，言从方外游。\n人嘲安用解，客难曷为酬。\n贝叶经三藏，莲花酒一瓯。\n生涯问流水，天地竟虚舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28846,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"访客","author":"张元凯","text":"故人金马客，消渴卧文园。\n岸帻高梧影，援琴流水言。\n竹篱黄蝶乱，野荠白花繁。\n枳棘中原在，毋脂日暮辕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28847,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"旅思","author":"张元凯","text":"不尽桑乾水，潺潺浸月寒。\n关山悲短笛，儿女忆长安。\n秋半青蘋老，霜前白苧单。\n南归多雁影，欲寄一书难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28848,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮顾从化","author":"张元凯","text":"已分时才晚，唯凭杯酒深。\n五经堪弃掷，一第尚浮沉。\n种种悲吾发，青青惜子衿。\n蛾眉羞再画，无奈入宫心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28849,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"济上逢张漕尉","author":"张元凯","text":"济水绕船流，萧然独树秋。\n暮云停楚骑，明月出吴钩。\n主计张苍棹，沉酣李白楼。\n不堪思往事，零落半同游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28850,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送楚客之越","author":"张元凯","text":"京洛一为别，念君多苦辛。\n啼猿常送客，归雁远逢人。\n十载辞江夏，千山过富春。\n匣中雄剑在，拂拭气还新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28851,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"别广福进公","author":"张元凯","text":"汤休能惜别，相送出精蓝。\n水长陂全没，云低雨半含。\n不堪宁止七，见黜欲过三。\n此日人犹北，惊看雁已南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28852,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"有感","author":"张元凯","text":"风尘犹道路，湖海自浮沉。\n浪说交张耳，何人识季心。\n霜留三尺剑，星散一囊金。\n落落飞腾志，空知返故林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28853,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寒食","author":"张元凯","text":"旅食怅犹寒，春愁匹马间。\n山河壮燕赵，风土忆荆蛮。\n驿路桃花落，乡心燕子还。\n饧糕尝未敢，千里隔慈颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28854,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮子念新斋二首 其一","author":"张元凯","text":"野服都裁芰，儒宫半艺兰。\n莺花春有约，鸡黍晚留欢。\n种药乘膏雨，栽松伴岁寒。\n绝怜俱老大，萧索竹皮冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28855,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮子念新斋二首 其二","author":"张元凯","text":"蓬径閒堪扫，山窗卧亦坚。\n蛾眉为世弃，鸡口漫人前。\n北海刺常灭，南州榻屡悬。\n竹林多酒伴，秖赏步兵贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28856,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江楼","author":"张元凯","text":"高阁凭扬子，登临伤客心。\n云青山有色，潮白海生音。\n落日灵均庙，秋风庄舄吟。\n大江南去路，惆怅暮归禽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28857,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山居","author":"张元凯","text":"一室蓬蒿翳，悠然紫翠深。\n凉飔起松上，夕照出花阴。\n流水沉冥意，空山久住心。\n寥寥问孤鹤，千载孰知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28858,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西山访叔平丈二首 其一","author":"张元凯","text":"耆旧寻庞德，西畴扣绿扉。\n开樽燕子到，点笔杏花飞。\n独鹤寻鱼穴，孤松挂薜衣。\n从游多鹿豕，久矣故人希。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28859,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西山访叔平丈二首 其二","author":"张元凯","text":"清言聊共晤，白发竟忘愁。\n柳暗门常闭，花飞村自幽。\n存交怜故尉，往役见诸侯。\n浊酒时相慰，山田薄有收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28860,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与谢都尉山游二首 其一","author":"张元凯","text":"山水逢皆胜，冠裳见自疏。\n白莲同结社，黄石未传书。\n东郭贫非病，西林樵可渔。\n为君容借屐，不问出无舆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28861,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与谢都尉山游二首 其二","author":"张元凯","text":"湖海能容我，微官安事哉。\n先朝存带砺，今日置寒灰。\n要妓歌秾李，寻僧吹落梅。\n差强投笔吏，不得玉关回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28862,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"琅琊别墅二首 其一","author":"张元凯","text":"高阁临花渚，云英逐望新。\n空濛微见海，窈窕曲藏春。\n乔木元无恙，青山已即真。\n君家旧时墅，曾住两珣珉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28863,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"琅琊别墅二首 其二","author":"张元凯","text":"邻刹松涛远，隔川花雨轻。\n云峰分太华，池水半昆明。\n浮白消尘虑，耽玄匪世情。\n超然得禅悟，园以小祇名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28864,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]