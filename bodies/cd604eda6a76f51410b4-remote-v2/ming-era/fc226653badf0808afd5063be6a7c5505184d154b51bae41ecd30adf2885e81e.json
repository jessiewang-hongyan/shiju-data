[{"title":"凯歌词十首 其九","author":"黄佐","text":"郊圻草木沾天泽，淮海鱼龙识圣颜。\n闻道赓歌临相第，唐虞今复在人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4566,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凯歌词十首 其十","author":"黄佐","text":"翠华询俗及阎闾，长有祥光散九衢。\n后夜五云最深处，众星高护北辰居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4567,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"征妇","author":"黄佐","text":"织愁长倩锦为文，楼上花枝伴夕熏。\n夜半朔鸿呼梦起，一天凉月泌香云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4568,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏四皓","author":"黄佐","text":"歌残鸿鹄汉宫秋，四老曾随鹤驾游。\n采采琼芝谢车马，不知罗网是留侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4569,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送卢仁三首 其一","author":"黄佐","text":"河水东流无尽期，分携休唱莫愁词。\n丈夫磊落要自许，兰室桂梁非所知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4570,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送卢仁三首 其二","author":"黄佐","text":"金风剪剪不成霜，八骏行春及万方。\n君去秦淮询盛事，满郊鱼鸟带恩光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4571,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送卢仁三首 其三","author":"黄佐","text":"当年曾自大江回，映水芙蓉秋正开。\n今日逢秋送归客，感时思旧不堪裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4572,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀罗浮四首别王用仪 其一","author":"黄佐","text":"旅食燕台两变星，图南长拟蹑鹏翎。\n无端夜雨惊心事，梦断罗浮未了青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4573,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀罗浮四首别王用仪 其二","author":"黄佐","text":"水帘洞口草生云，大石楼前花扑人。\n唐世轩辕今我是，罗浮那有别家春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4574,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀罗浮四首别王用仪 其三","author":"黄佐","text":"伏波铜柱埋南纪，郭隗金台落北州。\n看取长空没孤鸟，白云多处是罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4575,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀罗浮四首别王用仪 其四","author":"黄佐","text":"罗浮秋色与天高，约略明朝买去舠。\n万丈飞云携手上，共君眠石听松涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4576,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻雁二首 其一","author":"黄佐","text":"云边久觉音书静，江上徒闻舟楫归。\n嘹唳数声和梦破，凉蟾当户故辉辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4577,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻雁二首 其二","author":"黄佐","text":"潇湘水碧莓苔青，白雁掠云时一声。\n疏灯古壁照蓬鬓，江湖心事秋冥冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4578,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题山水小景","author":"黄佐","text":"九衢尘土袭簪缨，拟向乾坤借草亭。\n恍惚罗浮画中见，乱松深处数峰青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4579,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋霁","author":"黄佐","text":"万壑长风吹日来，百年幽抱与云开。\n倚阑舒啸一翘首，何处亭亭郭隗台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4580,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日有怀家山二首 其一","author":"黄佐","text":"花雨漫山杜宇愁，午窗归梦绕松楸。\n入帘芳草应相笑，为报王孙已倦游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4581,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日有怀家山二首 其二","author":"黄佐","text":"语燕交飞舞蝶狂，杏花零落柳丝长。\n天涯此日堪凄断，寒食郊原麦饭香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4582,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"道中寓意二首 其一","author":"黄佐","text":"燕赵相望一箭飞，东风吹老故山薇。\n江南万里烟波阔，不似垂鞭信马归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4583,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"道中寓意二首 其二","author":"黄佐","text":"凤楼十二丽烟花，尽日凝妆望翠华。\n开遍露桃多少恨，银环今夜落谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4584,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"厓山怀古六首 其一","author":"黄佐","text":"北风吹浪作龙楼，疑是乾坤正气浮。\n闻说当年杨太后，间关挥泪渡中流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4585,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"厓山怀古六首 其二","author":"黄佐","text":"宋室逢厓事可知，燕台犹梦整天欹。\n黄冠不到江南路，长使遗民叹黍离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4586,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"厓山怀古六首 其三","author":"黄佐","text":"云掩西湖王气销，厓山回首紫宸朝。\n露松似浥朝衣泪，不逐青梧日夜凋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4587,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"厓山怀古六首 其四","author":"黄佐","text":"两厓形胜自天开，夺港犹思卷土来。\n千古海陵遗迹在，云涛回望重堪哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4588,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"厓山怀古六首 其五","author":"黄佐","text":"哀歌何处问荒亭，野烧随风讶陨星。\n表暴尚遗徐礼部，断厓无语向人青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4589,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘉会楼二首 其一","author":"黄佐","text":"嘉会楼前谁主宾，老树挟风鸣向人。\n坐槎仙客不可见，江水滔滔劳问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4590,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘉会楼二首 其二","author":"黄佐","text":"江沙白白枫叶红，鳜鱼拨剌波摇空。\n相逢渔父不相识，醉舞藤蓑明月中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4591,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访白沙宅四首 其一","author":"黄佐","text":"堂前双柏走苍虬，苔自侵阶鹤自谋。\n怪底诗翁贫到骨，野风萧瑟蔗塘秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4592,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访白沙宅四首 其二","author":"黄佐","text":"百年闻道属斯人，碧玉中藏太古春。\n今我登楼望江水，青山红树四无邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4593,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访白沙宅四首 其三","author":"黄佐","text":"独上高楼开八窗，浮云飞尽月澄江。\n人间亦有虬髯客，投老扶南自一邦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4594,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访白沙宅四首 其四","author":"黄佐","text":"鹤骨峥嵘画幅开，执鞭何计起泉台。\n翰林棨戟依然在，曾见先生马首来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4595,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梦中登故山作","author":"黄佐","text":"清泉绿树抱山斜，万顷云天一亩家。\n尽日掩关来自去，白云蒸雨湿松花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4596,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题黄鹤楼画二首 其一","author":"黄佐","text":"黄鹤高飞览九州，楚江至今空此楼。\n登楼浩歌一怀古，江木萧萧无那愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4597,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题黄鹤楼画二首 其二","author":"黄佐","text":"楚城斜日照洲渚，飞飞鸿雁鸣相将。\n楼头客子笑无语，北梦南云尔许长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4598,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题便面小景次韵赠文徵仲","author":"黄佐","text":"萧萧松径无尘埃，白云满地幽鸟来。\n周南留滞未归去，旧日履綦空绿苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4599,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中漫兴五首 其一","author":"黄佐","text":"璧月团团玉镜台，照人怀抱霎时开。\n无情最是芦包水，不共西南一路来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4600,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中漫兴五首 其二","author":"黄佐","text":"胥江儿女多浣纱，道傍闻有莫愁家。\n莫愁荡桨向何处，杨柳萧萧啼暮鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4601,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中漫兴五首 其三","author":"黄佐","text":"宋朝栈道接烟霄，今日荒蹊没断桥。\n花洞蛮歌喧逻口，竹房僧梵落山腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4602,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中漫兴五首 其四","author":"黄佐","text":"横石矶边秋水生，浈阳峡上鶗鴂鸣。\n船头客子不能睡，对月长歌到五更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4603,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中漫兴五首 其五","author":"黄佐","text":"河汉盈盈夜遽央，淡日欲出流云凉。\n捲帘默坐看流水，风送一番松桂香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4604,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿孙九峰尚书二首 其一","author":"黄佐","text":"高咏琅函阅海筹，中台元不异丹丘。\n年年六月蒲麟酒，长对来禽安石榴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4605,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿孙九峰尚书二首 其二","author":"黄佐","text":"锦席湘帘白日长，玉杯称寿未渠央。\n调弦正奏缁衣曲，无限南风入座凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4606,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏赠杨中允二首 其一","author":"黄佐","text":"海珠江头披绿蓑，春风秋雨共渔歌。\n而今钓艇横江浦，鳣鲔年来柰尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4607,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏赠杨中允二首 其二","author":"黄佐","text":"梅花未发菜花香，坐到东风日渐长。\n买菜供餐无那少，寻梅沽酒只消狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4608,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采莲歌五首 其一","author":"黄佐","text":"灵湘郁水粤王都，五层飞楼天下无。\n江上行人莫回首，木绵花开啼鹧鸪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4609,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采莲歌五首 其二","author":"黄佐","text":"江南江北机杼多，谁家儿女不停梭。\n笑渠不似蜘蛛巧，能向虚空织网罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4610,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采莲歌五首 其三","author":"黄佐","text":"清远峡连黄木湾，采莲来往不为难。\n青山亦有飞来日，何事萧郎未见还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4611,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采莲歌五首 其四","author":"黄佐","text":"隔花相见两徘徊，荡桨低头笑不来。\n双栖白鹭忽惊起，遥见浮萍一道开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4612,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采莲歌五首 其五","author":"黄佐","text":"芭蕉叶卷久无舒，江口月明多鲤鱼。\n要得鲤鱼寄消息，鲤鱼长在石岩居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4613,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄钱太守索竹","author":"黄佐","text":"采药归来即掩关，故人相馈一开颜。\n已调滫瀡供皤发，更觅琅玕护碧山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4614,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汤文明惠并头葵花二株口占十绝 其一","author":"黄佐","text":"缥蒂同心葵十寻，日华浮动朵云深。\n江湖为尔怀霄汉，三月长安正绿阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4615,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汤文明惠并头葵花二株口占十绝 其二","author":"黄佐","text":"玉立亭亭见睟容，凤池相并集夔龙。\n丹心只在彤云里，休道蓬山几万重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4616,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汤文明惠并头葵花二株口占十绝 其三","author":"黄佐","text":"薰风未报清和月，淑气齐开并蒂花。\n丹凤彩鸾天上路，一时飞动到山家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汤文明惠并头葵花二株口占十绝 其四","author":"黄佐","text":"五夜彤庭绛节齐，火城如昼散乌栖。\n十年不到芙蓉阙，坐对双红听曙鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汤文明惠并头葵花二株口占十绝 其五","author":"黄佐","text":"翠蕤红脸自相依，不似桃花触处飞。\n已共云霞分锦色，更烦雨露濯仙衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汤文明惠并头葵花二株口占十绝 其六","author":"黄佐","text":"春风秋月几离忧，谁似倾心结并头。\n织女机丝何处所，长年辛苦会牵牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汤文明惠并头葵花二株口占十绝 其七","author":"黄佐","text":"此花不省人间有，喜自文明宅上来。\n怪底潜龙惊起舞，夜来风雨动池台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汤文明惠并头葵花二株口占十绝 其八","author":"黄佐","text":"覆雨翻云见汝难，晓来依旧立雕阑。\n举头并向长安日，谁识芳心一寸丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汤文明惠并头葵花二株口占十绝 其九","author":"黄佐","text":"炎风时节集芳筵，同干骈花忆赏莲。\n今日葵花更堪赏，暮春犹是艳阳天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汤文明惠并头葵花二株口占十绝 其十","author":"黄佐","text":"独乐名园洛水滨，种葵长得殿馀春。\n如今柳絮方零落，遥想南山尚有人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沙洲草堂四首为欧氏题 其一","author":"黄佐","text":"海上结庐花满洲，春回沙际绿幽幽。\n鸬鹚鸂鶒日来往，伴尔看花移小舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沙洲草堂四首为欧氏题 其二","author":"黄佐","text":"风帘冰簟对烟汀，浦口潮回日射星。\n手种琅玕今长大，江村无数翠云屏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沙洲草堂四首为欧氏题 其三","author":"黄佐","text":"鲈鳜初肥风满林。\n海天寥廓绝拿音。\n一声老鹤掠舟去，月出沙明蒲稗深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沙洲草堂四首为欧氏题 其四","author":"黄佐","text":"朔风潇潇沙欲飞，翠凫黄犊寒相依。\n古梅一夕倚檐发，吾爱吾庐春已归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中得吕氏读诗记答李三洲四首 其一","author":"黄佐","text":"山雨潇潇花蕊红，卷帷呼酒倩谁同。\n骖鸾一去传消息，多在青罗碧玉中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中得吕氏读诗记答李三洲四首 其二","author":"黄佐","text":"谁传吕氏诗三百，苦忆云间陆士龙。\n自别青冥今白发，镜湖何处见芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中得吕氏读诗记答李三洲四首 其三","author":"黄佐","text":"白云飞处忆苍梧，梦入槐亭片月孤。\n今日帛书才咫尺，杏花春雨卧江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中得吕氏读诗记答李三洲四首 其四","author":"黄佐","text":"游丝千尺绊行尘，黄鸟嘤嘤似劝人。\n尊酒当年同李白，融融风日洛桥春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4632,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仰云堂二首为林上舍志复 其一","author":"黄佐","text":"小小茅斋傍樾开，壶山流影入书台。\n翠涛摇动清风起，疑是云庄逸老来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4633,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仰云堂二首为林上舍志复 其二","author":"黄佐","text":"霞明屏石晓荧荧，树引山光翠满城。\n却忆过庭何处所，支颐翘首白云生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4634,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋怀集古句四首 其一","author":"黄佐","text":"伤禽恶弦惊，愁人知夜长。\n辗转不能寐，秋风发微凉。\n美人游不还，容好结中肠。\n爱至望苦深，何况隔两乡。\n愿飞安得翼，欲济川无梁。\n丛雁鸣云霄，渥露沾我裳。\n佳期怅何许，仰见明月光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4635,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋怀集古句四首 其二","author":"黄佐","text":"仰见明月光，星河曙耿耿。\n迢迢牵牛星，荡荡空中景。\n织女处其东，复与云路永。\n无情尚有归，令人发深省。\n何以慰我愁，挥杯劝孤影。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4636,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋怀集古句四首 其三","author":"黄佐","text":"挥杯劝孤影，孤影中自恻。\n浊酒且自陶，为君长叹息。\n青苔依空墙，芳尘凝瑶席。\n感叹何时平，含情弄柔瑟。\n遗响飞青天，青天何历历。\n云霞妆夕霏，回风吹四壁。\n君怀良不开，冰玉徒贞白。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋怀集古句四首 其四","author":"黄佐","text":"冰玉徒贞白，江湖迥且深。\n秋菊有佳色，寒蝉无馀音。\n感物忧不歇，隔我浮与沉。\n人生有离合，孰为劳寸心。\n濯足万里流，长啸高山岑。\n大哉乾坤内，视古犹视今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"集杜句题彩凤云龙卷送方公子行","author":"黄佐","text":"君不见陇山萧索秋云高，山巅朱凤鸣嗷嗷。\n侧身长顾求其曹，万古云霄一羽毛。\n君不见潇湘洞庭虚映空，中有云气从飞龙。\n天地黤惨忽异色，万斛之舟行若风。\n英雄有时亦如此，揽环结佩相终始。\n凤臆龙鬐未易识，青眼高歌望吾子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"草堂别友人集杜句","author":"黄佐","text":"倚江楠树草堂前，忽漫相逢是别筵。\n纵酒欲谋良夜醉，将诗不必万人传。\n朝廷衮职谁能补，乡里衣冠不乏贤。\n此别应须各弩力，浊醪粗饭任吾年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]