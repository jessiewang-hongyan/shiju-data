[{"title":"题画 其一","author":"陈邦彦","text":"一瓣芳心解卜邻，谢家庭院米家皴。\n清时已入君王操，不向湘皋伴楚臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40727,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画 其二","author":"陈邦彦","text":"垂柳千条绾晚霞，溪深流出半桃花。\n不嫌渔艇过从惯，天下车书正一家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40728,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫词 其一","author":"陈邦彦","text":"金屋宵深记漏痕，和銮初度兽炉温。\n不须细问宫中语，才伴羊车是主恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40729,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫词 其二","author":"陈邦彦","text":"太乙勾陈黯未开，御河桥上六龙回。\n君王异日如相忆，莫更昭阳被酒来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40730,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿高明城南野人家 其一","author":"陈邦彦","text":"襆被西来信马蹄，洞云深处寄禅栖。\n长林漫道知音少，犹有高人策杖藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40731,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿高明城南野人家 其二","author":"陈邦彦","text":"忧国谁当着一鞭，山翁犹自泪泫然。\n龙钟愧我非裴度，何日同君买醉眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40732,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东还书白业庵壁 其一","author":"陈邦彦","text":"三玉城隅一水回，招提遥在女墙隈。\n行云野鹤浑无定，莫厌陶潜醉里来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40733,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东还书白业庵壁 其二","author":"陈邦彦","text":"湛湛千峰紫逻深，谁知泽畔有行吟。\n投閒合是林居士，居士原来不姓林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40734,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同云淙相国夜泊 其一","author":"陈邦彦","text":"西望霓旌拥翠华，更闻铁骑下星沙。\n黄龙千艘人犹在，肯遣孤城隐暮笳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40735,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同云淙相国夜泊 其二","author":"陈邦彦","text":"结客凭将报主恩，相看犹喜鬓毛存。\n覆巢破卵家何在，风雨孤舟度海门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40736,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留石堂诗为严秋野郡守 其一","author":"陈邦彦","text":"一代循良共此堂，三峰新峙石苍苍。\n欲知砥柱东南意，海不扬波致越裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40737,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留石堂诗为严秋野郡守 其二","author":"陈邦彦","text":"楚台新报半沉浮，五马骖驔粤海头。\n此日叩阍人尽望，使君能与石俱留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40738,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留石堂诗为严秋野郡守 其三","author":"陈邦彦","text":"八桂诒来粤所稀，即教携去未云非。\n如何皂盖三年远，不载青山一石归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40739,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留石堂诗为严秋野郡守 其四","author":"陈邦彦","text":"九曜崚嶒傍粤台，仙羊五色未蒿莱。\n南中自古多奇绩，鼎足还应待后来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40740,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古八章呈王园长先生","author":"陈邦彦","text":"明明圣朝，世载其德。\n如何不造，遘此倾侧。\n彼氛伊何，云胡为慝。\n帝陟于天，我声其赫。\n明明圣朝，同符炎汉。\n爰即旧邦，以宏宵旰。\n维此元祀，建武则同。\n明明天子，载缵武功。\n天命纯佑，诒我元臣。\n兴于海国，迪兹群伦。\n于巘于原，周咨既均。\n爰宅镐丰，亦咸厥勋。\n睇彼燕山，遗弓渺止。\n奋章就道，忧心悄止。\n帝曰俞哉，胡乃骄矣。\n有指疆土，不崇朝矣。\n钟山巃嵷，高皇之宫。\n四牡业业，护此郁葱。\n天子曰都，绥予纯嘏。\n匪梦匪卜，中兴是辅。\n其辅维何，毋为波颓。\n君子之光，以须群材。\n群策具举，王犹靡悔。\n既平陇蜀，□□其喙。\n南有狂生，其愚维杞。\n闻变俶装，宵旦靡止。\n如彼嫠妇，不恤其纬。\n芜言匪嘉，鉴于天子。\n狂生之狂，载谣且歌。\n声与泪下，其与几何。\n亶惟夫子，弗讥弗诃。\n愿附青云，庶几不磨。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40741,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居 其七","author":"梁以壮","text":"落落谋生拙，庭虚半绿苔。\n定知无鬼笑，常恐有人哀。\n白雨凉孤榻，红梨醉一杯。\n阿谁同领略，心与百花开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40742,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居 其八","author":"梁以壮","text":"经年懒出户，多事避车尘。\n结驷连骑客，当年同学人。\n棋枰看一局，蝴蝶契前因。\n似觉安时得，聪明总误身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40743,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居 其九","author":"梁以壮","text":"不敢憎时好，幽心竟似逃。\n世将人斗靡，天以我孤高。\n苍狗无因变，矜鱼岂故劳。\n何如聊偃息，清啸和松涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40744,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居 其十","author":"梁以壮","text":"倚杖空庭外，川原一望微。\n欲将婴母去，未见凤皇飞。\n绿草添深露，红霞醉落晖。\n听闻人逐兔，此候不知归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40745,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居 其十一","author":"梁以壮","text":"一年一见识，不用看诗书。\n古井钗为雀，斜阳鼠化鴽。\n神明吾已淡，秋水尔同虚。\n堪笑骄才技，黔中又有驴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40746,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居 其十二","author":"梁以壮","text":"岂有栖迟恋，秪应无忮求。\n枯藤当独策，荒野任人游。\n鹤唳惊狂犬，鹪巢免恶鸠。\n持书谁踯躅，难识是荆州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40747,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居 其十三","author":"梁以壮","text":"肮脏形殊苦，浮华何必奢。\n折腰人乞米，清腋我烹茶。\n但有一山水，宁辞路八叉。\n林逋无势利，似可娶梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40748,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柬薛剑公 其一","author":"陈邦彦","text":"朗如玉映，轩若霞举。\n昔见其人，今闻其语。\n谁同卫玠，亦有杜虎。\n濯濯冰魂，城南无暑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40749,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柬薛剑公 其二","author":"陈邦彦","text":"骙骙者驹，于城之隅。\n梅花倚笛，如披其图。\n薄言絷之，于城之阿。\n罗敷有词，使君若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40750,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清远城陷题朱氏池亭 其一","author":"陈邦彦","text":"无拳无勇，无饷无兵。\n联络山海，矢佐中兴。\n天命不佑，祸患是婴。\n千秋而下，鉴此孤贞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40751,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清远城陷题朱氏池亭 其二","author":"陈邦彦","text":"平生报国怀深，望断西方好音。\n已共苌弘化碧，还同屈子俱沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40752,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清远城陷题朱氏池亭 其三","author":"陈邦彦","text":"恋阙孤怀尽，悬丝一命微。\n负伤如未觉，无泪不须挥。\n鱼吮艰贞血，水为赙襚衣。\n秪应魂气在，长绕玉阶飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40753,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临命歌","author":"陈邦彦","text":"天造兮多艰，臣也江之浒。\n书生谩谈兵，时哉不我与。\n我后兮何之，我躬兮独苦。\n厓山多忠魂，后先炤千古。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40754,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙潭寨","author":"林丹九","text":"负厓倚险聚苍生，心与寒潭一样清。\n任是史官编不到，山灵知道此孤贞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40755,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"云宿晚霞","author":"吴献","text":"几度游山玩物华，最怜云宿景休嘉。\n露含孤岭桑榆涩，风撼双峰星影斜。\n不尽彤云浮碧汉，无端乌雾落红霞。\n闲薰欲借文茵席，卧月眠云梦远家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40756,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乌台松","author":"吴献","text":"将何壮故国，台石一株松。\n不改长春色，时留千岁容。\n朝开丹日荫，夜傍素娥封。\n潭入虬枝影，游人惊是龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40757,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲今昔","author":"廖衷赤","text":"落日照高楼，凉风吹白苧。\n江山旧苍郁，极目尚可睹。\n江山虽如故，周京已禾黍。\n主人播西东，关山行路阻。\n侧耳闻杜鹃，终宵啼逆旅。\n故园不可巢，新巢岂终古。\n何来骤风雨，飘摇肆其侮。\n桑土尚可彻，空牢尚可补。\n美人天一方，眷然怀顾汝。\n泪血洒厓山，孤魂尚何主。\n长鲸浪喷天，聚蚁纷无数。\n挽弓向蜗国，牵牛祭豺虎。\n野鬼哭黄昏，战血流江渚。\n哀猿啸山皋，惊鸿鸣泽浦。\n我向故园行，草蔓荒烟聚。\n安得猿臂弓，射石没矢羽。\n白水起真人，箕尾赉良辅。\n女织与男耕，鼓腹复含哺。\n我怀日以长，我思日以苦。\n试作今昔歌，悲吟江之浒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40758,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"老人行","author":"廖衷赤","text":"霜鬓老人踏雪来，手持藜杖坐莓苔。\n单衣破絮苦风冷，抚膺痛哭颜如灰。\n我问老人何所哭，答言于今岁九六。\n少年不识兵火惊，日饱稻粱卧茅屋。\n一朝忽报军贴至，关北关南事暂异。\n顷闻乾坤亦崩坼，鼎湖无处攀龙驭。\n咸阳宫阙作尘飞，日暮空闻杜鹃悲。\n貔貅百万恣横嚼，九土行人尽啼饥。\n生男十五从戎戍，生女十五为军妻。\n老夫年大得二儿，县官抽点防关西。\n辞家一去十五载，又调关东射鲸鲵。\n我欲向邻问生死，吏卒叩门索丁糜。\n少儿南山刈马草，飞丹催促嫌行迟。\n烽烟不靖兵不止，二男万里无归期。\n生逢离乱不可说，垂老悲伤那得知。\n呜呼老人之言有如斯，吾身虽在亦可危，相与痛哭城南湄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40759,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苦风","author":"廖衷赤","text":"玄冬日暮风萧索，倒卷黄沙入城郭。\n城头木落天阴阴，不堪更把尊罍酌。\n石岸崩颓大雪侵，避缴猿鹤号空林。\n三十年来厌兵甲，铁骑金铙惊客心。\n乡关有梦归未得，破艇孤灯半欲熄。\n夜来翘首望南云，潇湘一带兵气黑。\n相逢鸿雁尽哀鸣，故园旧事空相忆。\n拥衾不寐数踌躇，风打舟篷到日出。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40760,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜客中","author":"廖衷赤","text":"栖栖无所事，岁月已蹉跎。\n世事尚如此，吾身将若何。\n雪霜今夜重，兵甲四方多。\n昨过高阳里，魂销陇上歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40761,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明感怀","author":"廖衷赤","text":"花柳村村色，閒愁岁岁侵。\n迂怀难近俗，古道不宜今。\n孤冢白杨老，寒郊芳草深。\n不堪回首望，泪滴故乡心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40762,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊舟江楼","author":"廖衷赤","text":"碧浮天欲尽，河汉在高楼。\n星乱江中夜，砧寒海外秋。\n何堪霜与雪，重迫病兼愁。\n自悔蹉跎久，终年在客舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40763,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"塞上曲","author":"廖衷赤","text":"二十学从戎，白头犹异地。\n谁知黑河流，尽是征夫泪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40764,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古别离","author":"廖衷赤","text":"离别剧可愁，况乃事边地。\n丈夫志四方，出门不挥泪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40765,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赵姬墓 其一","author":"廖衷赤","text":"何缘生死亦离居，芳草埋香哭少姬。\n几度西风明月夜，孤桐细雨续青丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40766,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赵姬墓 其二","author":"廖衷赤","text":"落日萧萧天已昏，梅花月色暗销魂。\n冷风古道无人迹，一树枯杨盖墓门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40767,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺情","author":"廖衷赤","text":"郎君少小志安边，辛苦从军已十年。\n昨夜灯花重结蕊，想郎马上锦衣还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40768,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫词","author":"廖衷赤","text":"夜深仿佛御炉香，玉笛声声出建章。\n惟有西宫怨明月，非秋月影已凄凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40769,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"志别","author":"廖衷赤","text":"明月登舟两地分，骊歌初唱那堪闻。\n湖山夜话人千里，愁向江头望白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40770,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"折桂行","author":"廖衷赤","text":"羡君意气自不群，龙种凤毛世所欣。\n细柳营中开邺架，少年弱冠侪终军。\n藜火光分乙夜月，彩笔星飞五色云。\n君家刚斧利如霜，砍折天葩第一香。\n广寒仙子惊初起，相呼姨妹理新妆。\n娇姨三五弹筝瑟，小妹两两献霞觞。\n舞袖双飞落蛱蝶，霓裳一曲奏宫商。\n玉蟾蜍，玉蟾蜍，仙子辞阙汝知乎。\n丰城光腾千丈处，夜伴玉郎读秘书。\n看看桃浪春暖碧，琴剑奕奕古道侧。\n天池此日涌危涛，震动五湖及三泽。\n应是大鹏上九重，雷闪电光扬飓汐。\n秋云雁阵日萧萧，道传公子入皇朝。\n阳关一饮倾百斗，骊歌酣唱兴初豪。\n此去金门射长策，对面君王夺锦袍。\n谁人种就长安花，十里一色点红纱。\n香随轻尘来簇簇，如龙可是五骢骅。\n柳汁染衣春色阑，状元头上列仙班。\n绛衣千官捧胪唱，御香染袖锦襕褊。\n七宝床前留供奉，八花砖上望君颜。\n君不见五陵裘马贵公子，一掷千金壮士起。\n秋老月满兔儿肥，呼卢走韩日千里。\n夜敲檀板酹金浆，响遏流云淩波绮。\n纱窗日影拂阑干，春昼沉沉逐画舣。\n羡君更谁得似君，学海波中翻玉几。\n我愧不才明主折，欲附鳞翼无可得。\n为君试作折桂行，长歌一阕壮行色。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40771,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书寄会丛上人","author":"廖衷赤","text":"昔闻大乘说禅通，形形色色尽皆空。\n我观世间一切法，无空等与大空同。\n日月星辰雷电击，江山大地豁浑濛。\n混元一气谁凿辟，生人生物无终穷。\n有身既非本来面，春华秋叶落还浓。\n哎约一声天地晓，条条赤木白与红。\n吮乳便觉滋味好，饥食渴饮欲恶攻。\n甜桃苦李不相让，爱河欲海恣蛟龙。\n予将此理问会丛，丛拈针线把衲缝。\n他诵金刚摆严偈，我念大学和中庸。\n尔我彼此同床梦，譬以歧路不同踪。\n谁知三教本一教，千派万派总朝宗。\n会丛叩我空乎否，茫无对答嘴都空。\n色即是空空即色，错差一线堕禅狐。\n我亦不解空空理，学得空空知也无。\n君不见敲石出星火，引镜现形模，空空色色漫糊涂。\n从此打散蒲团坐，省却面壁剩工夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40772,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次答张伯淇","author":"庾楼","text":"白发催迟暮，高峰伴寂寥。\n十年成底事，一别又今朝。\n但可花经眼，何当米折腰。\n子山词赋好，遗恨向谁销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40773,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日舟中晓望","author":"庾楼","text":"水痕如縠远蒹葭，历历晴空见物华。\n半壁高崖分鸟道，一溪寒溜傍人家。\n疏篱静处明初日，独树堤边落远霞。\n孤棹逶迤何处驻，霜枝随意自横斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40774,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬江夜泊","author":"庾楼","text":"霜风吹月入兰舟，几片轻云意自悠。\n孤客有怀常问夜，乱山无绪自成秋。\n萧萧落木群虫语，寂寂寒江白浪流。\n何处渔人相借问，一声长笛自夷犹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40775,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"回龙放生","author":"庾楼","text":"梵入寒空静，江天一望微。\n生公曾说法，开士亦皈依。\n去鸟闻金粟，行人折露薇。\n持将同异意，晚映落霞归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40776,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖荷荡","author":"庾楼","text":"汎汎轻鸥外，风荷欲秀时。\n桥横漪水曲，寺隔远山湄。\n绿影侵云湿，红光带雨欹。\n朝来烟景好，再许问花期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40777,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病起忆西湖","author":"庾楼","text":"未得寻幽胜，烟光半画图。\n日悬双镜合，云断一山孤。\n绿透凉侵竹，红轻夕印芜。\n元戎移小队，觞咏到西湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40778,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"季夏同姚讱庵晓白张敬庵严筑公黎传人汎舟南宗庵访昙大师刘羽士振枰试茗纵谈玄理归次逢禅上人以荔枝驰回饷客和讱庵作","author":"庾楼","text":"江帆带日开晴浦，野寺流风拂曙烟。\n笑着黄冠从羽客，拜辞青笠学乘禅。\n一枰慧力归空劫，半偈文心落幻缘。\n归路晚逢丹荔至，扑人香艳向人圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40779,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"张裔达","text":"佳人不可再，云散竟何之。\n艳句留千古，芳容绝一时。\n写兰香在手，作字韵为姿。\n命薄怀才去，伤心彭子知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40780,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次答庞伯达孝廉","author":"张裔达","text":"长江远水绕苔矶，客至开尊半掩扉。\n四壁乍惊秋气入，片帆争带夕阳飞。\n故园聚散原非别，壮志蹉跎但忆归。\n为语东篱陶令菊，再来相对肯相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40781,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客中九日同泰弟赋","author":"屈士燝","text":"去国多同苦，穷秋滞异乡。\n客情今两度，佳节又重阳。\n爱汝年俱壮，思亲鬓已霜。\n故园携酒处，梦到菊花傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40782,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过访云溪诸昆玉","author":"屈士燝","text":"十年湖海巳蹉跎，百里乡园始一过。\n先代衣冠遗泽在，同时生聚乱离多。\n舟行树里围烟渚，水到门前绕薜萝。\n尚有诸君当朋好，买邻真欲结云窝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40783,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀陈明敬","author":"屈士燝","text":"早春閒得听黄鹂，一卧空山寄所思。\n白社游踪成独往，朱台名籍与谁期。\n斗间望气龙文合，楼上怀人羽盖迟。\n此日盈虚天莫问，好将消息达希夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40784,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜翁山弟还自塞北","author":"屈士燝","text":"布衣思报国，十载托双林。\n行乞姓名隐，逃禅道力深。\n郢吟怜寡和，骚赋少知音。\n许尔过萝薜，玄亭秋草深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40785,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"始安道中始安今广西平乐府 其一","author":"屈士燝","text":"登山临水意何穷，度索临橦径复通。\n绝磴烟炊茅屋里，晓舂人语石崖中。\n听歌渐觉邮亭近，问俗翻疑邑里同。\n归去正当春欲暮，清溪一路木棉红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40786,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"始安道中始安今广西平乐府 其二","author":"屈士燝","text":"远投何地得幽栖，仆马踟躇日欲西。\n榆荚烟深连瘴岭，桄榔风起暗蛮溪。\n梦从游历疑曾到，诗忆经行却寄题。\n最是客魂凄断处，黄茅疏雨杜鹃啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40787,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游虹岩","author":"屈士燝","text":"巉岩分一壑，削壁瞰平台。\n散瀑天疑雨，回湍洞隐雷。\n忘机驯鸟雀，习静远尘埃。\n不信人寰外，浮生有劫灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40788,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]