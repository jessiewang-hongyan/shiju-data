[{"title":"罗浮青霞谷赠甘泉","author":"黄佐","text":"青霞谷中飘紫烟，谁其栖者甘泉仙。\n云边放鹤啄瑶草，雨后呼龙耕玉田。\n梅花不作翠羽梦，薤叶细写朱云篇。\n冲虚昨雨自高枕，晓来同话羲皇年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2057,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仲夏酿荔枝酒成与欧麦二友同酌次韵一首因麦有及于天宝故事因及之","author":"黄佐","text":"南风吹绿北窗前，荔子浮缸似醴泉。\n锦席玉杯惭地主，鹄袍凫舄集儒仙。\n云安雇直犹倾盏，天阙微呼不上船。\n觞咏有馀风味少，红尘飞骑笑当年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2058,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平饶埔钜寇次督府百川张公韵二首 其一","author":"黄佐","text":"剑气横空氛祲蠲，天南今见斗牛躔。\n运筹已决留侯胜，厘卣仍褒召虎贤。\n鳄海夜涵千里月，凤山朝簇万家烟。\n凯歌声里欢无极，遥对枫宸祝万年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2059,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平饶埔钜寇次督府百川张公韵二首 其二","author":"黄佐","text":"十万貔貅引月弓，一时巢穴散炎风。\n潮阳鼓角连天沸，岭外云雷动地雄。\n铜柱标来兵几在，昆仑追去计犹穷。\n两旬玉镜归明主，应是中兴第一功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2060,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春日世祏祠祭后小憩蓝县丞来谓蔡察院疏予道学已而邸报至有礼乐接乎周孔道学绍乎朱程诚为圣代真儒等语非予所敢当也赋此以自笑","author":"黄佐","text":"春祠燕息竹亭东，生态相随趣不穷。\n草色远连丹壑外，花光微入翠帘中。\n一声到枕闻皋鹤，千里传书见塞鸿。\n浅浅野塘供钓艇，源源新水受和风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2061,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玄览台登望喜晴用前韵","author":"黄佐","text":"尘环车马去遥遥，惟有春台倚泬寥。\n沂水咏归重与点，浮云功业小看尧。\n林花受日红尤丽，野水连山翠未彫。\n风雨几番寒食里，杖藜今喜步层霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2062,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻近有跃舞歌呼自谓寻乐者因再用韵 其一","author":"黄佐","text":"谁将鲲化说逍遥，从此蛙声遍阒寥。\n曹魏可怜曾舜禹，李唐何事亦神尧。\n汪汪易见涓流积，磊磊难同美玉彫。\n闻说有人狂起舞，泥涂终不近云霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2063,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻近有跃舞歌呼自谓寻乐者因再用韵 其二","author":"黄佐","text":"道心于我本非遥，合一真传久寂寥。\n茂叔每从颜学孔，咎繇曾致舜为尧。\n源泉混混须前进，松柏苍苍见后彫。\n此日登台遥引望，鸢飞应自在云霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2064,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"静坐宴起再用玄览台韵","author":"黄佐","text":"庭户无声车马遥，坐来人境更寥寥。\n即看太极源于昊，真觉心传不待尧。\n巨浸尚凭孤柱在，贞筠那逐四时彫。\n龙图凤阁千年事，感应还应自碧霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2065,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元日登东城楼再陪甘泉祝圣有述","author":"黄佐","text":"年年上日曾遥祝，不似今年喜再陪。\n北极旧瞻龙虎气，南州新筑凤凰台。\n山楼粉堞开绵蕞，藻席椒浆共瓦杯。\n况复迎春箫鼓动，青阳先到海隅梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2066,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦游罗浮赋夜半见日","author":"黄佐","text":"三更红日出沧涯，四百峰峦处处花。\n水漱竹崖全作雨，云封松崦半成霞。\n扶光晓吸真难老，尘世逢看却易斜。\n此景足稽天下士，葛洪何必问丹砂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2067,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铁桥新开晚景园筑溪山一览赋诗相候候宴于晋野堂次韵","author":"黄佐","text":"溪山新构喜经过，笑似秋星初渡河。\n晋野正疑南菊晚，楚云偏带朔鸿多。\n挥杯白日移堤树，步屧清霜净泽荷。\n一望郁江天万里，冥冥何处有虞罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2068,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"即席口占赠黎婿惟和北上","author":"黄佐","text":"笑插篱金护鬓霜，也曾三仕入明光。\n宫壶日送黄封酒，朝服时沾玉座香。\n野草尚知周雨露，山龙何补舜衣裳。\n柯亭此去无多地，岐尔云霄双雁行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2069,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日答诸耆旧过草堂小饮次周岐瑞韵","author":"黄佐","text":"粤王城北草堂深，南极群仙喜共临。\n松石友朋叨作主，云山韶濩自成音。\n鸥边梅蕊波间玉，鸟外杨条日下金。\n莫笑野人畦菜少，满前生意合开襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2070,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再次前韵答周孟锡州守","author":"黄佐","text":"盘谷回环紫翠深，喜攀诸老此登临。\n三城日转寻芳径，万井风连击壤音。\n倾倒渌尊犹北海，捧持佳句是南金。\n春来野兴同沂水，莫厌频来共洗襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2071,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次唐加民大尹韵","author":"黄佐","text":"烟花随处艳芳春，城里青山小避尘。\n出谷有莺求旧友，鸣皋惟鹤拟精神。\n年追卫武真难老，诗似唐人妙绝伦。\n明日星台传盛事，弧南光满粤江滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2072,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江约之大尹谒粤洲先祠次韵","author":"黄佐","text":"松柏冈头竹径深，先祠何幸一光临。\n白驹皎皎来虚谷，黄鸟嘤嘤送好音。\n皇极注残犹有墨，义田赒尽已无金。\n云鹏一去空留迹，日永天多思满襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2073,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈朝纪不赴饮以诗来谢次韵二首 其一","author":"黄佐","text":"小筑茅堂带碧峰，春灯春酒对芙蓉。\n水边霞绮明孤鹤，云外笙箫殷万松。\n洛社几人同杖屦，粤江今日聚萍踪。\n登临更作连床约，欲向希夷学五龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2074,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈朝纪不赴饮以诗来谢次韵二首 其二","author":"黄佐","text":"东风初到种瓜田，细雨平添漱竹泉。\n莲蕊酒酣云谷里，梅花香冷石亭前。\n自撑钓艇消长日，谁拜樵夫问大年。\n深锁柴门调野鹤，莫教飞去避茶烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2075,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朝纪再和奉答二首 其一","author":"黄佐","text":"渺渺浮云遮远峰，曲肱聊憩小芙蓉。\n于今我岂非黄骑，自古谁真是赤松。\n柳径日听莺唤侣，苔矶时觅鹤行踪。\n雨馀有约君来否，苍玉林中看箨龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2076,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朝纪再和奉答二首 其二","author":"黄佐","text":"尉佗城边花满田，粤洲台下酒如泉。\n一声白鸟不知处，万点青山都在前。\n此日有怀华岳老，何时同话羲皇年。\n醉来共坐云巢顶，笑指齐州空九烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次方士表大尹韵","author":"黄佐","text":"深深松竹护池台，春日柴门为子开。\n携鹤草堂惭大隐，僇狐沙县羡高材。\n香山九老追前会，南极诸星接上台。\n僻地更烦双舄到，小舟长送百壶来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日登峡山寺","author":"黄佐","text":"东风初动水云区，古峡苍苍万籁虚。\n牛斗泛槎瞻北极，凤雏栖竹记南禺。\n致君岂惮陈金镜，将母宁辞谢玉除。\n此去采真逢露冕，九重春色问何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嬉春曲四首 其一","author":"黄佐","text":"油壁香车嘶紫骝，春城何处好嬉游。\n鳌灯海上连三岛，凤吹风前度五侯。\n碧雾初生花作阵，彤云不动月垂钩。\n采芳恰到沉珠浦，解佩俄逢拾翠洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嬉春曲四首 其二","author":"黄佐","text":"洲边新水到渔矶，路上轻风扬酒旗。\n短短荷根难结藕，青青柳色易成丝。\n鹍弦鹤笛遥相和，银烛金尊晚并移。\n低唱竹枝云雾里，免教明月妒娥眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嬉春曲四首 其三","author":"黄佐","text":"钧天清梦隔瑶京，笑逐江湖酒伴行。\n芳草桁头看宝炬，白莲池畔听银筝。\n花园柳巷浑无赖，紫燕黄蜂各有情。\n谁向缁尘窥艳色，不知朱户锁倾城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嬉春曲四首 其四","author":"黄佐","text":"天边璧月悬清光，照见陌头游冶郎。\n缥玉香浓酌鹦鹉，郁金样窄裁鸳鸯。\n零露团团湿蔓草，谷风习习吹柔桑。\n临岐相见瞥然去，一夜心随云汉长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏竹分得临字","author":"黄佐","text":"江南摇落气萧森，爱尔修篁自作林。\n清籁在天闻日夜，翠云随地变晴阴。\n秦楼凤下湘山远，羌塞龙吟渭水深。\n何似习池通蒋径，秖应风雨亦登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感雨二首 其一","author":"黄佐","text":"三江水口浪如山，百万戈船一未还。\n即有转输愁骆越，况闻征戍厌湟关。\n寡妻群盗伤心外，乌合鲸奔转眄间。\n谁向苍梧报边帅，急抽精锐备荆蛮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感雨二首 其二","author":"黄佐","text":"去年优诏下明光，拜赐蠲租喜欲狂。\n岂意春农归浩荡，遂令生事转凄凉。\n护持松菊欣无恙，点检琴书湿不妨。\n野哭陆沉俱在眼，可能图画献君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日介翁宗伯招饮赏菊次韵与甬川俨山二学士内方庶子同赋","author":"黄佐","text":"十月芳菲犹满家，容台招赏傲霜花。\n玉杯对酒朋簪盍，彩笔裁诗蜡炬斜。\n抚景况闻歌白雪，临风翻笑落乌纱。\n阳和只在邀欢地，未觉流光换物华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与养斋宗伯同年登牛首山","author":"黄佐","text":"风籁萧萧惬远游，青山当夏却疑秋。\n即看天阙参差近，已觉星槎汗漫浮。\n室里静观孤塔影，阶前清挹大江流。\n咏归亦是城南路，不道张衡有四愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"烂柯山次韵马问庵提学时弃官自闽归徐州","author":"黄佐","text":"不将金紫换青山，天阔鸿冥杳莫攀。\n折屐何年同胜赏，烂柯当日也知还。\n秦淮岁晚湫龙卧，燕冀群空枥马闲。\n高枕未须惊世幻，羲皇元只在人寰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"昆冈为颜医生钰题","author":"黄佐","text":"振衣千仞付儿曹，投老昆冈志亦豪。\n蟾兔影中丹桂近，凤凰巢下碧梧高。\n绕林芝木双虹剑，盈架诗书一褐袍。\n射策金门看片玉，郤诜曾是冠时髦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东昌夜泊有感","author":"黄佐","text":"垂杨袅袅岸悠悠，崇武城边春事幽。\n卷幔忽看天在水，怀人翻觉夜成秋。\n帝车欲指飞龙殿，卿月空悬彩凤楼。\n闻道相如能献纳，汉廷谁肯愧公侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送邹东郭太常往南院","author":"黄佐","text":"青青客舍有垂杨，闻道承恩出建章。\n鹤禁分襟春日晚，凤台回首暮云长。\n东曹旧吏迎仙客，南署新衔带奉常。\n何日邹枚归侍从，赐袍还挹御炉香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李子逍遥楼寄怀次韵","author":"黄佐","text":"飞楼漂渺俯江深，谁咏晨风向北林。\n度雪朔鸿空往迹，掠云皋鹤更遗音。\n燕台合市千金骨，汉署徒知十载心。\n骋望不愁春事远，满蹊桃李自成阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄翰检招饮醉归口占","author":"黄佐","text":"汉宫春意入残年，蔼蔼群芳集绮筵。\n白雪秖闻天上曲，青娥遥忆月中仙。\n觥船转觉南溟动，象纬回看北极悬。\n折柳落梅听不尽，艳阳真在五云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阳峰招饮赏梅","author":"黄佐","text":"燕京残腊觅春光，谁料春光在曲房。\n姑射雪姿明玉斝，罗浮清梦落藜床。\n醉看貂服承疏影，吟向虬枝得暗香。\n跂马出门城径杳，广寒回首月苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五日即事和右溪韵","author":"黄佐","text":"麦风梅雨逐人来，犹有榴花照眼开。\n京国乍尝新角黍，庭闱还忆旧蒲杯。\n越山渺渺羊求径，燕树依依郭隗台。\n欲献重瞳丝万缕，试看云气向蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"补送孙学士之留都","author":"黄佐","text":"景阳钟动散宫鸦，南院新承北阙麻。\n潞渚梦回燕树月，玉京吟对蒋陵花。\n山分龙虎曾开国，江足鲈鱼莫念家。\n谁道桂坊成久别，伫看鸣佩入承华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西津图为锦衣赵子凤题","author":"黄佐","text":"翡翠楼台接建章，西津流出自天潢。\n金枢隐映王孙草，玉蝀遥连帝女桑。\n驻辇到今留御气，扣舷何处溯流光。\n风林一动云涛起，犹似箫声引凤凰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"祖陵祇役次阳峰大宗伯韵","author":"黄佐","text":"渺渺金陵向楚东，雪晴山色更青葱。\n淮流入泗知天险，陵树连云觉地雄。\n王事不辞丹峤远，旅怀惟恐绿尊空。\n容台回首过逢地，吹彻鸾箫月满蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨花台次顾东桥司空韵","author":"黄佐","text":"高座寺前千仞冈，西风低草见禅场。\n化人已去石台古，旅客偶来山径荒。\n地接秦淮波脉脉，天围吴楚野茫茫。\n凭高不见花如雨，惟有霜枫飘夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕次大宗伯阳峰韵","author":"黄佐","text":"一自金陵别玉除，岁穷惟捡囊中书。\n梅花索笑春无限，柏叶承欢味有馀。\n虬漏只催新节序，龙盘长护旧宸居。\n明朝引望长安日，正是南宫建礼初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元旦志喜","author":"黄佐","text":"淮甸云霞出海东，秣陵花柳遍吴中。\n爆雷香雾千门晓，化日和风万里同。\n建礼共欣王道泰，开基惟仰皇图隆。\n麟蒲杯里年年寿，又见慈颜一醉红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2102,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灯夕馆会","author":"黄佐","text":"西围地切凤凰台，飞盖追随绮席开。\n烟火尽从孤鸟去，笙箫如逐六鳌来。\n云移钟阜当诗案，月出秦淮映酒杯。\n步履东风归路杳，巡檐相待有疏梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2103,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏耳目齿三首次顾东桥韵 其一","author":"黄佐","text":"何事生毫忽在兹，逢人多笑却成痴。\n歌传白雪辞师旷，听入高山让子期。\n日暖不闻莺睍睆，风鸣惟觉叶低垂。\n而今我幸聪犹在，国事边声总要知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏耳目齿三首次顾东桥韵 其二","author":"黄佐","text":"长留双睫待韶华，学易行年已渐加。\n窗里自分淮海岫，雾中谁看蒋陵花。\n图传九局寻犹见，树带千崖望却遮。\n更把五弦挥一曲，飞鸿南去是天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏耳目齿三首次顾东桥韵 其三","author":"黄佐","text":"相看黄发齿犹儿，化石神丹信有之。\n何处瓠犀徒自美，相依车辅预防危。\n东方编贝惟求粟，孙楚临流只自颐。\n若遇侯鲭同大嚼，年来休讶我迟迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送熊北原","author":"黄佐","text":"宝马萧萧不动尘，文旌奕奕出江津。\n直言自昔推青琐，殊锡于今侍紫宸。\n南国甘棠歌异日，北堂萱草颂长春。\n台端亦有栖乌树，重见天边雨露新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送闻石塘","author":"黄佐","text":"听履声华动紫宸，鉴湖未许乞闲身。\n台端览德看翔凤，阁上论功待画麟。\n斗极真从南向北，贯城重见旧为新。\n玉亭幽独梅花发，应报朝天满路春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏至斋居","author":"黄佐","text":"桥门日日听鸣驺，长夏斋居亦似秋。\n雨歇风篁依砌舞，夜凉云汉入窗流。\n咸英乐自周家变，江海心从魏阙游。\n隐几梦回天咫尺，六龙飞处是方丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早朝次胡可泉韵","author":"黄佐","text":"旭日行天明蓟丘，闲云凝岫出罗浮。\n衣冠西苑随星转，殿阁南薰似海流。\n黼座衮龙偏忆舜，杏坛衰凤亦从周。\n珍台璇馆追趋地，只为甘泉奏赋留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"至日斋居次顾东桥韵","author":"黄佐","text":"秣陵至日忆长安，两地威仪尽汉官。\n台近凤凰云物适，梦回鳷鹊曙光寒。\n黄钟雅调知音少，白雪高才欲和难。\n独坐玉亭怀旧侣，疏篁移月过阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周监正邀登司天台夜归口占","author":"黄佐","text":"鸡鸣迢递上高台，拂拭玑衡万象开。\n黄道星辰皆北向，紫宸冠冕却南来。\n风前鸣鸟随征盖，云里盘龙劝羽杯。\n归向柳边清不寐，恍疑身在玉霄回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"徐氏园次养斋韵二首 其一","author":"黄佐","text":"公子爱客开岩扉，琼帘绣户烟霜微。\n鸾杯卜昼紫霞密，羯鼓遏秋红叶稀。\n峰回石磴岳莲出，水满银塘江雁飞。\n为爱天南异天北，拚饮莫教心赏迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"徐氏园次养斋韵二首 其二","author":"黄佐","text":"采采黄花绿水浔，百年多病歉登临。\n黄花不为秋光老，绿水能如酒兴深。\n南国况多龙虎气，西园真有凤凰林。\n登台一望青天外，拚饮何时得共寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游燕子矶次养斋韵","author":"黄佐","text":"北去南来未拂衣，徒闻燕子有渔矶。\n沧江白鸟随潮迥，野寺黄花对酒稀。\n清夜自悬徐孺榻，尘襟思浴鲁城沂。\n天峰秖是松声在，谁伴先生弄月归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金山寺与同游沈都督希仪陈太守天然","author":"黄佐","text":"高阁层台尽向阳，暇逢迟月共翱翔。\n鼋鼍窟远禅扉静，龙象筵开贝叶香。\n析木天涵波荡荡，秣陵烟带树苍苍。\n中泠瀹罢临风磴，还听山僧说武皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵洲醉中赋","author":"黄佐","text":"青林碧海环高台，孤根独立云之隈。\n神鳌跋浪远天动，老鹤警霜幽梦回。\n西川词翰出下土，南海衣冠朝上台。\n一尊如醉兀然坐，万里长风吹月来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怡椿堂次韵赠刘春冈刑侍","author":"黄佐","text":"怡闲仙驭久经春，坐向怡椿若有神。\n鹓序威仪应已近，鲤庭趋对尚如新。\n九天渥露沾桥梓，八座徽声动缙绅。\n灵宝鄢陵欣接武，政馀觞咏莫辞频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]