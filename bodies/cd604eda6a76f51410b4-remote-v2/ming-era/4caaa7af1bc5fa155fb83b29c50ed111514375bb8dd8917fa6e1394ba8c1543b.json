[{"title":"九峰十景 其六 子母朝阳","author":"林光","text":"焦山夜来雨，澎湃复萧瑟。\n恍然杨子江，翻动蛟龙窟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52364,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九峰十景 其七 乌头竹坞","author":"林光","text":"乌头疗白头，种药堪自足。\n日长陟高坞，心洗千挺玉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52365,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九峰十景 其八 关门松屏","author":"林光","text":"白云锁关门，森松更笼嵷。\n不纳寻源人，伊谁话真汞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52366,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九峰十景 其九 马驮秋月","author":"林光","text":"月照马驮山，秋气清人骨。\n马驮驮不去，千古一轮月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52367,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九峰十景 其十 双涧观泉","author":"林光","text":"活活夹山来，悠悠双眼觑。\n欲知流不穷，更认泉来处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52368,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"写怀次韵答陈子崇二首 其一","author":"林光","text":"三年尘梦寄燕都，不信今吾是昔吾。\n涪水远帆思叔子，洛阳高枕愧尧夫。\n苏枯霖雨天何吝，照眼莺花日渐疏。\n国脉调来元自寿，枉劳俞跗过忧虞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52369,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"写怀次韵答陈子崇二首 其二","author":"林光","text":"艳冶时方爱子都，轲书何事小夷吾。\n首阳饿忍周遗逸，湘水空沉楚大夫。\n已觉衰迟催日月，那教侧陋误唐虞。\n清风屡洒乌皮几，欹罩庭花蛛网疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52370,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别秦用中司训之安仁","author":"林光","text":"惠泉甘韵宿沾濡，分教应期雪俗污。\n梦里云龙辞海子，笔端风月傍鄱湖。\n钟声恬处看芹雨，书课忙边堕日乌。\n后进有依亲有养，锦囊閒煞旧奚奴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52371,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别张宗昭县尹之衡阳","author":"林光","text":"通才何处不堪安，分教新迁邑长官。\n错节盘根明利器，卖刀买犊化凋残。\n洞庭秋入心先洗，南岳峰高日耸观。\n鲁叟他年称子产，嘱吾屡屡别君难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52372,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李白","author":"林光","text":"故里先人庐，翛翛数竿竹。\n秋光浸归梦，可想不可掬。\n拥襟坐中宵，内照惭吾独。\n宦学久未归，如旅莫投宿。\n行藏应自断，何必问龟卜。\n年光去若流，逝者不可复。\n世途多险阻，几见前车覆。\n全身鉴老苏，思之非不熟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52373,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"订马代简戏答王都给事","author":"林光","text":"东坡墨券亦何须，夜白三年照老夫。\n垂耳岂终愁伏枥，嘶风应不惮长途。\n燕昭果解台高筑，骏骨谁云世绝无。\n伯乐几时来冀北，石翁诗话遍江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52374,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"屋卖","author":"林光","text":"屋卖谁催去，冰凝天欲留。\n行藏双老眼，飘泊一虚舟。\n剑气防冲斗，乡心更倚楼。\n西风殊可骇，留得木绵裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52375,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南去","author":"林光","text":"南去壬人在，西游胜迹多。\n冥鸿思远渚，独鸟怪深罗。\n入目宜新境，违心谢众魔。\n沧浪分别调，谁听野人歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52376,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠黄时准地曹","author":"林光","text":"支离恐误后生嗔，语到忘机却逼真。\n天远君如初上日，酒阑吾起独醒人。\n閒因宿草看朝露，试向中宵认北辰。\n红树夕阳深嘱别，肯将秋鬓怨垂银。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52377,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日次杜工部韵","author":"林光","text":"那钱选买燕都菊，欹帽思登郭隗台。\n红树尽从霜后醉，黄花刚对节中开。\n渊明远兴山应识，陈子真容天送来。\n倒插茱萸不成舞，感时怀旧泪相催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52378,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠冯廷伯佥宪赴岭南专督盐屯之政","author":"林光","text":"玺书遥捧向炎方，半是阳春半雪霜。\n鹾政应谙罗强弊，戎屯看抑并吞强。\n汉廷尚屈桓宽策，岭峤何疑陆贾装。\n图像还期终剧论，送君归梦绕吾乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52379,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题爱日楼为钱世恩正郎","author":"林光","text":"南邱盘搆锡山东，心醉飞云望眼中。\n寸晷尚思酬寸草，丹青谁解写丹衷。\n莱衣子舞西颓景，密表孙飏孝感风。\n龙诰珍藏閒炙背，任教海屋架空濛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52380,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小至四首追次老杜韵 其一","author":"林光","text":"冻笔频呵不用催，天机又见转头来。\n一阳隐隐地中复，万事悠悠心已灰。\n数九醉呼凉国酒，寻香忽忆故山梅。\n膝边共笑儿痴小，强解娱亲捧寿杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52381,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小至四首追次老杜韵 其二","author":"林光","text":"时行时止勿劳催，小去看看大又来。\n霞映晓窗初酿雪，气回虚室自浮灰。\n年颜孟浪休占鹊，春信依稀欲放梅。\n安养微阳无一事，浅倾元酒落磁杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52382,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小至四首追次老杜韵 其三","author":"林光","text":"时至真如有物催，冥鸿天际去还来。\n且拚身似随阳鸟，已觉心同候管灰。\n南酒会浇坟上土，微阳温养腊前梅。\n重关谨闭非无策，常笑猩猩误举杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52383,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小至四首追次老杜韵 其四","author":"林光","text":"浮生短景递相催，老厌尘途谢往来。\n共喜微阳回此日，谁沾元气动浮灰。\n羲爻成像聊观复，天地藏春未放梅。\n保合太和身久掩，呼儿缓送暖脐杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52384,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孔庙迎春遇雪","author":"林光","text":"宫墙虚映白皑皑，祝望龙香刚赐来。\n肃拜轻沾花六出，趋跄平踏玉千堆。\n诗肠莫肖天机巧，圣德潜通造化胎。\n三白预堪占大有，万方初庆一阳回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52385,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉谢诸明公惠乙丑历","author":"林光","text":"甲子书来问冷官，阳春争欲变冬寒。\n年增空有传心念，日近何妨炙背看。\n斟酌盈亏分节候，循环六十配支干。\n辟凶趋吉人时授，共把天根更静观。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52386,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别余宗周侍御左迁云南藩幕赴任","author":"林光","text":"柱史苍惶又左迁，滇南藩幕暂栖贤。\n翱翔倏见垂风翮，拂乱宁知非福田。\n渔笛迎船家在眼，夷笳吹月岭横天。\n送君不尽期君意，何处相逢更暮年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52387,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"叠前韵再赠","author":"林光","text":"身事浮沉几变迁，遐方终不负吾贤。\n遗经摊日开心镜，旧砚磨云理笔田。\n阳嫩萌芽初绽柳，冬深风雪尚漫天。\n眼前荣悴何须问，赠记吾诗甲子年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52388,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苦寒行和杜二首 其一","author":"林光","text":"长安乞儿声不绝，九忂冻积冰凝雪。\n南人肌疏不耐寒，败絮重披心欲折。\n猬毛粟起手尽龟，鸡爪纹生面无血。\n木绵犯霜偏易裂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52389,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苦寒行和杜二首 其二","author":"林光","text":"大风萧萧夜撼木，积雪粼粼压朝屋。\n但觉群阴势转骄，庸知造化谁持轴。\n元冥司令何太酷。\n茅檐处处垂冰澌，耕牛冻死那得知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52390,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将赴襄阳","author":"林光","text":"云霄万里谁能测，宇宙千年运几开。\n襄阳小儿应绝倒，南翁先生胡此来。\n汉江源远心曾到，天柱峰高景拟裁。\n老去笔头閒未得，中原山水梦相催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52391,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小年二首 其一","author":"林光","text":"甲子春侵腊，燕京又小年。\n儿童欢礼灶，箫鼓闹喧天。\n数九晴看柳，书空仰羡鸢。\n此身吾自有，富贵乃浮烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52392,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小年二首 其二","author":"林光","text":"旅馆身如赘，春催未尽年。\n童颜欺白发，老眼看青天。\n徇俗焚巫马，乘风笑纸鸢。\n岁穷穷未送，泪落湿薪烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52393,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"试笔 其一","author":"林光","text":"乙丑新题笔，先春领去年。\n浓云初落纸，幽思已潜天。\n门冷堪罗雀，风恬未放鸢。\n白头无限兴，挥破晓窗烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52394,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"试笔 其二","author":"林光","text":"泥牛初破腊，鸡骨未占年。\n云雾挥盈纸，蛟龙欲上天。\n悠悠拚日月，了了见鱼鸢。\n温养炉中火，香飘一线烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52395,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨考功名父乃翁挽","author":"林光","text":"不识夫君面，哀从何处生。\n情浓堪破戒，身后却知名。\n宰木寒烟拱，幽堂野日明。\n石田有贤胤，风树振芳声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52396,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"职方后署小酌走笔并序","author":"林光","text":"庭有栽花地，刘郎到几时。\n晓烟春盎盎，晴日酒迟迟。\n未误安边策，还留惜别诗。\n襄阳舟缓买，深荷职方期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52397,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将出京留别诸明公次屠亚卿元勋先生见赠韵三首 其一","author":"林光","text":"长笑江都老一儒，西京应不乏师模。\n春风只眼还荆楚，襄汉澄源异鉴湖。\n醴酒敢期今日设，莼羹宁患此时无。\n分携多谢诸朝贵，借誉无盐过子都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52398,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将出京留别诸明公次屠亚卿元勋先生见赠韵三首 其二","author":"林光","text":"胄监三年录腐儒，宫墙仰见圣规模。\n忙来行李轻千里，老去烟波负五湖。\n礼乐河间疑可复，文章西汉岂终无。\n襄阳此去知何补，空有狂言落帝都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52399,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将出京留别诸明公次屠亚卿元勋先生见赠韵三首 其三","author":"林光","text":"官左宁须怨业儒，乘田委吏是师模。\n心驰天柱春回柳，身谢京尘水到湖。\n阅世却留双眼在，买山真笑一钱无。\n铜鞮试听襄阳曲，陈疏何妨又楚都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52400,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙丑正月二十七日出京承诸公饯送至城南马上口号","author":"林光","text":"花朝花渐近，勒马更留连。\n春暖风初定，官贫天亦怜。\n身行千里外，心在五云边。\n别袂真难判，相看各黯然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52401,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"坐小船","author":"林光","text":"邦伯舟何处，褰衣上小舠。\n篙穿清浅水，风闪漾光涛。\n兴远篷难压，心安身未劳。\n潜藏甘隐约，方识古人高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52402,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"二月二日蔡村船中","author":"林光","text":"尽日风尘里，花朝不见花。\n轻烟穿舴艋，长薄散乌鸦。\n砚拂冰还冻，春催柳渐芽。\n前村是何处，荒落几人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52403,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新斋为施宪副题","author":"林光","text":"尘垢心天蔽，虚斋日日新。\n春融花照眼，秋爽月随人。\n默语神明在，将迎悔吝频。\n汤铭有遗训，颜扁胜书绅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52404,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中小酌赠苏徽二郡守并序 其一","author":"林光","text":"逆旅何缘遇两君，春风画舫谢殷勤。\n壶投心矢忘宾主，酒吸磁杯醉水云。\n景逼诗篇争出手，才高郡政总超群。\n联舟共听吹横笛，披写乡情到十分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52405,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中小酌赠苏徽二郡守并序 其二","author":"林光","text":"画舫迟迟喜接君，丁夫催拽未须勤。\n鸥忘远渚诗裁月，鱼戏澄波笔扫云。\n棋局到头轮袖手，春风转盼又离群。\n夕阳倒照漕河柳，斟酌吾杯更几分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52406,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中写怀叠前韵","author":"林光","text":"禄隐惭无补圣君，此生真笑我徒勤。\n閒看斗柄旋宸极，怅望江天入暮云。\n律管声中谐凤侣，春波篷底羡鸥群。\n长风倘惜篙师力，更挂蒲帆到夜分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52407,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"分夫助拽过武城用前韵奉谢苏郡守思绍宗契","author":"林光","text":"疲乏篙师最感君，丁夫助拽夜行勤。\n赛神拟醉清源酒，打号争穿渡口云。\n杯饭每留填丐腹，船灯未遣骇鸥群。\n姑苏太守阳和意，走卒儿童识几分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52408,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贞则卷为林思绍太守母题","author":"林光","text":"夫死孤遗亦未忘，西风血泪几沾裳。\n舞鸾掩镜心如铁，雏凤冲天鬓已霜。\n夜照壁灯风范在，恩沾墓草燕坭香。\n良人归报儿成立，杜宇何须怨夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52409,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过临清总镇中贵朱公盛席留款至夜三鼓礼意不倦时陪林苏州何徽州二郡守","author":"林光","text":"偶价先容拉两君，春风东席意何勤。\n华筵礼盛杯排日，杂剧声娇曲绕云。\n霄汉祇应怜朵翼，盐车那有驾空群。\n霏微晚雨还留醉，红烛丛花剪夜分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52410,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上安山闸","author":"林光","text":"争先谁露巧机关，闸水声喧我自閒。\n怪得希夷眠华顶，了无心绪向人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52411,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"彭城舟中长沙李德举太守出沈仲律宪副所赠诗索和次韵奉答","author":"林光","text":"倾倒宁须礼数崇，双眸借阅几英雄。\n绨袍入楚曾知沈，云水联舟又识公。\n春色共催山到手，心齐期见月悬空。\n南风故助赓歌兴，记取彭城一笑中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52412,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过彭城","author":"林光","text":"山入彭城势颇崇，古来争战几英雄。\n台荒戏马怜西霸，庙剥残碑忆沛公。\n涛尚不平声喷石，花犹含笑影摇空。\n挐舟未到安流处，铁笛谁吹落照中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52413,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过宝应湖四首 其一","author":"林光","text":"渔艇穿云去未归，水光昏接日光微。\n蒲帆不遇天风便，笑倚蓬窗咏绿衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52414,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过宝应湖四首 其二","author":"林光","text":"几树桃花照眼红，堤长湖阔水生风。\n停舟未暇留清赏，祇恐春归花又空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52415,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过宝应湖四首 其三","author":"林光","text":"湖草青青叶未齐，水天相接望低迷。\n行人歌罢沧浪曲，几点渔舟落照西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52416,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过宝应湖四首 其四","author":"林光","text":"渔舟泛泛杂鸥凫，妇桨夫桡水满湖。\n笑煞往来人未了，远提长缆日招呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52417,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过高邮湖二首 其一","author":"林光","text":"两岸垂杨绿夹舟，湖波断隔了无忧。\n长堤稳贴看来往，争似寻春事胜游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52418,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过高邮湖二首 其二","author":"林光","text":"湖云漠漠雨濛濛，夫少牵长恼柁公。\n人事逆时天偶顺，蒲帆刚遇北来风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52419,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜雨过邵伯湖风径迷路遂宿湖中","author":"林光","text":"薄暮蒲帆捲，深更谷雨飘。\n船灯明复灭，篷漏溅还跳。\n违湿迁无地，冲寒讶有潮。\n平明问渔艇，湖草绿夭夭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52420,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"发扬州","author":"林光","text":"雨馀春草深，日照溪波绿。\n和风扇蒲帆，缓酌樽中绿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52421,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仪真获亡尹袁阳所借拙稿六册","author":"林光","text":"哀哉袁健夫，丧舟在何处。\n残篇马上来，别驾劳仆御。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52422,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过石头城","author":"林光","text":"倚棹石头城，深春老眼明。\n气盘山怪石，龙奋地雄争。\n佛阁栖崖稳，江流倒海横。\n六朝无寸壤，回首一含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52423,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答何徽州","author":"林光","text":"样子方愁背鲁儒，更从何地觅真模。\n茅居忽警徽州句，行李如催范蠡湖。\n吾道本来兼礼用，异端终是入虚无。\n脚头到处皆堪乐，旋把罗浮视岘都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52424,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江中","author":"林光","text":"日日江中浪拍舟，南风不遂北来谋。\n谁云境逆无佳思，独倚篷窗看活流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52425,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答安处郡守杨麟洲","author":"林光","text":"南渡同安尚用儒，新城犹想旧城模。\n公来甘雨恒千里，座下长江控五湖。\n随世功名疑可就，屠龙伎俩岂云无。\n羲爻已领含章意，五马行春且大都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52426,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过湖口","author":"林光","text":"气曾江湖忽两汊，北风飞逐几帆斜。\n大姑点破千波顷，五老高盘天一涯。\n树带晓烟笼绝景，豚轮骇浪喷浮花。\n芦茅深处鸥眠稳，莫遣催舟鼓急挝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52427,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"墨菊","author":"林光","text":"真姿描出石屏东，似有清香递晚风。\n千载柴桑几杯酒，不因春色对芳丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52428,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"墨蒲萄为慎庵殿下题","author":"林光","text":"偃蹇乌龙蟠屈，参差珠实高低。\n满架藏春风韵，灵根出自关西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52429,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四月十三日舟次安陆风暴非常州人谓五十年来未有此","author":"林光","text":"飞沙拔木更掀篷，雨注雷轰电闪空。\n安陆津头牢系缆，未须嗟骇北来风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52430,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"安陆候夫","author":"林光","text":"滩头流急汉江纡，两日亭舟候拨夫。\n安得和风远相送，畏途从此变夷途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52431,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]