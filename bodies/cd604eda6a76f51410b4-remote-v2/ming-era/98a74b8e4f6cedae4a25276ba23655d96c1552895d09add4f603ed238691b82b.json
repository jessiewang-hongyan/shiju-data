[{"title":"送徐德章乃翁","author":"边贡","text":"春看燕市花，秋返晋陵槎。\n水树侵沙阔，江云隐驿斜。\n梦依南国近，书寄北关赊。\n坐惜薇郎苦，遥心附海霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17553,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送于时宜","author":"边贡","text":"行子对新月，临堂酣且歌。\n客衣寒未减，乡梦日应多。\n鲁甸封春草，淮川渺夕波。\n芳音托回雁，迢递柰情何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17554,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别王生","author":"边贡","text":"天际阴风起，浮云似马行。\n飞扬亦何意，离别秪关情。\n古岸垂杨合，长河暮色清。\n何时画舸背，樽酒说平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17555,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王演之二首 其一","author":"边贡","text":"送远临河涘，苍苍夕景微。\n云山望不极，书札到应稀。\n碛暗风沙起，春长旅雁归。\n秦关百二阻，何处换征衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17556,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王演之二首 其二","author":"边贡","text":"驱车度宛洛，归路及春深。\n杳杳还家梦，悠悠去国心。\n青山临古渡，白日下丰林。\n憔悴逢渔父，应为泽畔吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17557,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送矩庵中丞","author":"边贡","text":"荆楚连年旱，今冬雨雪频。\n膏融厚土彻，绿迸早禾新。\n烽火千山息，讴歌万室春。\n中丞调燮手，争道捷如神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17558,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别伯玉","author":"边贡","text":"君行不相见，卧病对春风。\n世事浮沉外，交亲感慨中。\n古台燕郭暮，流水晋祠空。\n他日歌招隐，青山有桂丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17559,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送友","author":"边贡","text":"十里黄冈道，萋萋露草繁。\n青骊将客子，白日过乡园。\n水国春先到，云程凤独骞。\n行看鲁儒化，流泽被元元。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17560,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠别宁子","author":"边贡","text":"风度与桓典，勋劳更伏波。\n明珠腾谤巧，骢马避人多。\n白日就长道，清秋凌大河。\n非关燕赵别，相送一悲歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17561,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送刘希尹入高邑省亲","author":"边贡","text":"朝夕梦亲颜，驱车西出关。\n青云深魏阙，白日照恒山。\n麦秀城池古，人居井邑閒。\n秋风扇枕暇，璧水迟君还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17562,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送伯川子归吴二首 其一","author":"边贡","text":"东门嘶马去，幽志几人同。\n问寝归吴苑，含香别汉宫。\n关山双宝铗，江海一秋蓬。\n欲觅南州信，时看西北风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17563,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送伯川子归吴二首 其二","author":"边贡","text":"旧国江村外，清川绕舍流。\n空闻赋招隐，不得泛同舟。\n雨暗胶山寺，花明爱日楼。\n遥怜相忆处，落叶蓟门秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17564,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陶良伯使鲁府","author":"边贡","text":"天马玉花骢，骑来天厩中。\n言经汶阳道，却过鲁王宫。\n岱岳浮云外，蓬莱碧海东。\n飘飘鸾鹤侣，仙驾与谁同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17565,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨纯夫","author":"边贡","text":"天府通新籍，毗陵返故居。\n三春辞北阙，几日过南徐。\n岸柳阴阴接，汀花冉冉疏。\n江流日东下，何处觅双鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17566,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送赵体仁侍御改官","author":"边贡","text":"问子今何适，时危路且艰。\n豺狼潜未及，骢马去难攀。\n暝野云藏日，秋林水接湾。\n病夫门不出，心度万重山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17567,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"七夕夜雨送父回家感而有作","author":"边贡","text":"感怀逢七夕，况是别翁时。\n天上夫妻会，人间父子离。\n梦疑青鸟下，心逐白云驰。\n几阵芭蕉雨，萧然鬓欲丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17568,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送张仲齐侍御还京二首 其一","author":"边贡","text":"上国埋轮后，东山揽辔初。\n世方惊豸角，吾已识龙颅。\n古柏凌苍汉，清冰照玉壶。\n千秋桓典驾，驱逐有人无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17569,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送张仲齐侍御还京二首 其二","author":"边贡","text":"绣斧明霜日，川原指顾中。\n才真堪作雨，名不愧观风。\n狡兔移山窟，玄狐隐棘丛。\n城隅一片石，他日比羊公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17570,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送张广汉中丞观军留都二首 其一","author":"边贡","text":"闻说狼山下，江波带血流。\n中原初息战，诸将各封侯。\n草绿西兴渡，云生北固楼。\n经过吊陈迹，春日暂停舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17571,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送张广汉中丞观军留都二首 其二","author":"边贡","text":"二月金陵道，中丞拥节还。\n日光摇组甲，春色映江关。\n国壮军容整，时平武略閒。\n坐看龙虎气，长绕凤凰山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17572,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陈国充内弟赴京师卒业","author":"边贡","text":"千里携书剑，观光入上京。\n外亲无我厚，宅相有君成。\n细雨官河暗，垂杨客路平。\n承家仲氏在，休恋倚门情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17573,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送韩石泉赴德州兑运","author":"边贡","text":"细雨空城暮，游云散薄阴。\n落花春晚色，芳草病馀心。\n梦接官曹近，秋生国计深。\n林中与水次，谁伴独行吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17574,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别柴子","author":"边贡","text":"相忆恨长道，相逢惊白头。\n又为千里别，还作几年愁。\n故旧天涯少，勋名世上浮。\n不堪风雨夜，虚馆对新秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17575,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别张西盘大参二首 其一","author":"边贡","text":"苦恋三秋别，还为十日留。\n江湖宋玉感，风雨杜陵愁。\n坠叶鸣沙岸，寒云抱驿楼。\n河梁阻携手，谁与赋同舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17576,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠张生下第还金齿三章 其一","author":"边贡","text":"逆旅嗟同病，相逢罢举杯。\n别期惊岁月，壮志感风雷。\n路险三湘隔，心遥一雁催。\n可怜苏季子，还着敝裘回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17577,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠张生下第还金齿三章 其二","author":"边贡","text":"北风吹独骑，万里向西南。\n沅水三秋雨，偏桥十月岚。\n藓碑怀蜀相，花笔梦江淹。\n好把山中屋，重题扪虱庵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17578,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠张生下第还金齿三章 其三","author":"边贡","text":"闻道栖迟地，苔香涧户幽。\n岭猿相旦暮，山月自春秋。\n诗画称三绝，图书富九流。\n秪应嵇阮辈，与尔得同游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17579,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王子兵备江西二首 其一","author":"边贡","text":"旧隐辞函谷，新章出汉闱。\n碧山留岂得，芳草怨相违。\n简拔皇心注，升沉士论归。\n传闻拜恩日，犹著赏功衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17580,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王子兵备江西二首 其二","author":"边贡","text":"盖拂匡庐过，帆飞蠡泽深。\n三秋持斧日，万里渡江心。\n虎豹潜移窟，牛羊广出林。\n秪应台柏下，端坐听鸣禽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17581,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送翟给事廷献册封周世子还朝兼赴昌邑省觐三首 其一","author":"边贡","text":"册命临中土，恩华接上台。\n雪明朱閤丽，风引翠帘开。\n汉使鸣环入，王孙露冕来。\n星槎曙袅袅，欣傍早春回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17582,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送翟给事廷献册封周世子还朝兼赴昌邑省觐三首 其二","author":"边贡","text":"登高逢岁晚，把酒怅多违。\n塔日霜逾静，岩花雪且肥。\n家从东海过，天向北辰归。\n可道亲心悦，宫袍是舞衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17583,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送翟给事廷献册封周世子还朝兼赴昌邑省觐三首 其三","author":"边贡","text":"谏客刘栖楚，词人陆务观。\n舌存应不虑，盟在可须寒。\n赋颂名天下，封章草夜阑。\n稿成须寄我，归向鲁门看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17584,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨希颜省墓还闻喜兼柬秦长史","author":"边贡","text":"剑装喧鼓吹，春日过乡闾。\n梦绕松楸远，心伤雨露馀。\n里门妨跃马，宫锦焕飞鱼。\n若见秦淮海，应传寄别书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17585,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨文绅司训玉田","author":"边贡","text":"东郭渔阳路，南风几日程。\n客毡春草色，僧寺晚钟声。\n山认盘龙状，州传种玉名。\n关西旧衣钵，留取付诸生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17586,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王景旸长史还周府","author":"边贡","text":"驷马薰风里，中州路不赊。\n雨深梁苑竹，春老汴宫花。\n亲榻分羹美，玉筵设醴嘉。\n五云回首地，不似贾长沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17587,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨伯玉子南归","author":"边贡","text":"孤舟风雨凉，江客下江乡。\n岁月吟边晚，烟霞梦里长。\n钓溪开藓石，书架拂芸香。\n霜落南垓冷，何人共采芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17588,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送周司业祭扫还临海二首 其一","author":"边贡","text":"客梦惊霜露，乡程入渺冥。\n地连霞峤赤，天接海门青。\n涧藻充新鼎，碑苔蚀旧铭。\n秋墟满狐兔，何处筑思亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17589,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送周司业祭扫还临海二首 其二","author":"边贡","text":"赤阑桥上路，千载一青衫。\n家说编修里，人惊乐正衔。\n听泉过万竹，看月步双岩。\n寂寞成均地，春风早挂帆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17590,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送匡敬夫按贵州","author":"边贡","text":"岁晚神京别，何时到鬼方。\n雪迷山驿冷，云接海关长。\n去住新骢马，封题旧皂囊。\n遥怀征战地，几处有耕桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17591,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送赵叔鸣监税德州二首 其一","author":"边贡","text":"萧萧征马嘶，送客过前溪。\n故里别来久，家书空复题。\n青山鬲津道，平楚卫河堤。\n它夜幽寻处，应知梦不迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17592,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送赵叔鸣监税德州二首 其二","author":"边贡","text":"东赴海陵仓，移家别帝乡。\n政繁输转地，官古度支郎。\n问寝椿庭近，回舟蓼岸香。\n秋来客愁少，风景似维扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17593,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送董舅氏","author":"边贡","text":"暑雨晓初晴，山泉落涧清。\n一杯燕市酒，千载渭阳情。\n陇月牵遥梦，江花伴独行。\n乱蝉无意绪，争向别时鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17594,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东阿留别无涯孟子","author":"边贡","text":"逆旅相逢地，春残花事稀。\n同怜在远道，且复换征衣。\n碧草连村暗，青山四郭围。\n欲旋归去马，还逐使君归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17595,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送郑雪斋秋官归闽中","author":"边贡","text":"识面沉忧里，重逢旅病间。\n应缘著书癖，且作泛舟还。\n雨色含青柳，江流绕碧山。\n东门一尊酒，咫尺杳难攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17596,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送客","author":"边贡","text":"怪尔湖南使，风江晚系舟。\n遥经十载别，刚得寸时留。\n素月明寒浦，苍山隐暮流。\n水鸥嗟未及，双泛寡离忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17597,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别周子贤佥宪","author":"边贡","text":"身是外台佐，心蟠中秘书。\n杜陵元自许，桓典或能如。\n梦结三湘外，神交十载馀。\n同舟忽判袂，愁绝广川墟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17598,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送吴学正之留都武学","author":"边贡","text":"振铎敷文教，迁阶得武庠。\n讲筵环胄子，官舍接宫墙。\n树隐台城古，江连石埭长。\n相期共临眺，嘉候及重阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17599,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送别菊泉胡子","author":"边贡","text":"寒声下木杪，送子一酸辛。\n白日川原净，高秋鼓角振。\n来看南苑雪，归忆上都春。\n懒听阳乌发，嗷嗷青石闉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17600,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"广川舟中与东桥酌别次韵三首 其一","author":"边贡","text":"汴上一为别，漂摇十二秋。\n那期卫川涘，得并李膺舟。\n月映青山出，波涵碧树流。\n接宵欢达曙，不为酒尊留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17601,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"广川舟中与东桥酌别次韵三首 其二","author":"边贡","text":"共脱风前帽，还披月下襟。\n乾坤万里别，江海十年心。\n越鸟枝难共，湘鱼帛易沉。\n相逢畏相失，延滞绿溪阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17602,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"广川舟中与东桥酌别次韵三首 其三","author":"边贡","text":"愧我蒹葭质，倚君琼树姿。\n遥怜共飘泊，且复笑栖迟。\n秀句推先达，高言戒独危。\n江蓠照雪月，秋谷有深期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17603,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卧疾柬别孙性甫二首 其一","author":"边贡","text":"杳杳关河客，盈盈一水间。\n那因各抱病，遂阻共开颜。\n雨入青帘细，云移碧树閒。\n含情送遥瞩，时见瞑鸦还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17604,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卧疾柬别孙性甫二首 其二","author":"边贡","text":"旧典司番礼，新乘郡守车。\n问名俱不沗，迁秩定何如。\n父老看行盖，君王想谏书。\n徵黄会有诏，早晚下宸居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17605,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"张秋官元德席上留别","author":"边贡","text":"春日江陵去，烟花万里途。\n山川留故郢，舟楫带三吴。\n树影湘流转，猿声峡月孤。\n郡楼登望夕，天北是皇都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17606,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送曾世亭兵备赴蜀","author":"边贡","text":"闻道霜台使，亲承岳牧恩。\n山川增气色，草木藉生存。\n拂暑辞东郡，先秋过楚门。\n江皋有芳杜，作意待王孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17607,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鹦鹉","author":"边贡","text":"珍鸟来清夏，芙蕖避绿衣。\n苦遭鸦并嚇，羞与燕同飞。\n整翮身仍阻，能言意且违。\n何当即开锁，放尔陇山归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17608,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东坞为李户部贡卿赋","author":"边贡","text":"旧坞浓花发，新春旅梦悬。\n醉吟朝雨后，醒坐夕阳前。\n摩诘才堪比，随州句可怜。\n山禽傍精舍，来往正翩翩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17609,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪庵","author":"边贡","text":"大雪乾坤闭，开窗且静观。\n偶然同卲子，不是学袁安。\n数在梅花得，春从太极看。\n凭将画前易，一问灞桥鞍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17610,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"昌平馆","author":"边贡","text":"寒食烟花暮，伤归复旅游。\n芳尊不相对，华馆坐悠悠。\n月细光疑晦，山空响似秋。\n老亲垂短发，计日向西州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17611,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"公馆即事呈彦卿","author":"边贡","text":"赤日下庭角，白云生昼阴。\n弥因吏喧屏，转觉道情深。\n树荫依邻借，虫声隔水寻。\n回骖淹薄瞑，相迟在同心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17612,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"李月辉方丈二首 其一","author":"边贡","text":"鸡犬不闻音，仙家巷陌深。\n洞箫吹赤玉，丹灶化黄金。\n庭迥秋花寂，阶寒夕雨沉。\n愿传方外秘，勿使岁华侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17613,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"李月辉方丈二首 其二","author":"边贡","text":"秋林积雨晦，晏坐失朝曛。\n地似通勾漏，人疑是少君。\n依依归洞鹤，冉冉度窗云。\n预恐重来日，花源杳不分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17614,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中憩双泉寺","author":"边贡","text":"野寺临官路，山门俯近郊。\n閤虚钟梵寂，院静薜萝交。\n密雨沉蛛网，閒云拥鹤巢。\n故人诗在壁，惆怅隔衡茅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17615,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十六日再至寺","author":"边贡","text":"十日重来此，登临兴转幽。\n老僧烹石耳，留客坐山头。\n阴洞生云雾，阳坡散马牛。\n翻嗟出城晚，不值菊花秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17616,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"静海寺","author":"边贡","text":"窈窕城连寺，巉岩石抱亭。\n洞虚云气白，厓断草痕青。\n宝匣封宸翰，珠花络藏经。\n回翔不觉晚，归马傍春星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17617,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"伦上人院晚坐次白湖韵","author":"边贡","text":"过雨禅房寂，松筠一径遮。\n梵筵青琐佩，香灶碧山茶。\n鹤静欹寒水，僧閒数落花。\n诗人类迂僻，乘兴即为家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17618,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日登千佛山寺五首 其一","author":"边贡","text":"南山空崒嵂，野老倦登临。\n城郭千年迹，云霄万里心。\n夕阴涵积水，风叶下长林。\n短发新来白，黄花不可簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17619,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日登千佛山寺五首 其二","author":"边贡","text":"亭午客先集，怜予迟出城。\n吏当青塔候，僧下碧山迎。\n弈谱传新势，骚坛讲旧盟。\n洞泉秋不冷，好共濯尘缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17620,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日登千佛山寺五首 其三","author":"边贡","text":"石壁青含雨，松台迥入烟。\n闷随天上客，閒访洞中仙。\n菊采芬芳蕊，诗留酩酊篇。\n重逢倘万一，携手话兹年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17621,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]