[{"title":"忆王屋山","author":"谢榛","text":"昔探王屋胜，犹忆杖藜初。\n野老窥丹洞，山灵护宝书。\n云生苔壁暗，松响石坛虚。\n欲访烟萝子，茫茫失旧庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14346,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"还邺二首 其一","author":"谢榛","text":"客路多芳草，还家春服成。\n交游嗟献赋，妻子问谋生。\n自得山林计，深知猿鸟情。\n一樽吟薄暮，风雨闭柴荆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14347,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"还邺二首 其二","author":"谢榛","text":"迢遥囊橐轻，词客本无营。\n久别儿孙大，初归鸡犬惊。\n几年违旧业，多事感浮生。\n坐倚中庭树，春风可寄情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14348,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登泰山","author":"谢榛","text":"登攀绝顶处，封禅断碑文。\n古洞寻丹液，秋衣拂紫氛。\n下飞关塞雁，东接海天云。\n惆怅秦松在，寒涛空自闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14349,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春同陈郎中汝忠登邺城兼寄于鳞子与","author":"谢榛","text":"有客停骖日，重城共一登。\n晴烟开北渚，春色上西陵。\n中论怀徐干，高风识李膺。\n蓟门芳草路，千里兴堪乘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14350,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮秋东园饯别邹子序","author":"谢榛","text":"老大交弥重，穷愁赋可传。\n对君犹故国，嗟我异当年。\n砌冷蛩边草，霞明雁外天。\n菊花留醉客，秋色满离筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14351,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮秋大伾山禅院同孟得之卢次梗醉赋","author":"谢榛","text":"胜游随故侣，幽兴在禅林。\n石上晴云起，松间晚磬沉。\n青山无久客，黄菊有归心。\n我亦悲秋者，樽前学楚吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14352,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄吴总戎子阳","author":"谢榛","text":"黄须邺下子，威振北征年。\n万里能筹国，三秋长在边。\n草枯驰马地，霜冷射雕天。\n燕赵多豪士，论功谁更先。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14353,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄李殿元子实","author":"谢榛","text":"暂假淮南去，长吟桂树秋。\n自知班史在，还结楚骚流。\n山色朝侵榻，江声夜满楼。\n应怀金马诏，春水送仙舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14354,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"野兴","author":"谢榛","text":"独眺西山色，苍然风物繁。\n渔樵秋草路，鸡犬夕阳村。\n积水明荒泽，閒云度广原。\n阮宣今已矣，沽酒共谁论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14355,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高枕","author":"谢榛","text":"垂老惟高枕，经秋不到城。\n孤吟来鸟雀，万事掩柴荆。\n野旷浮云色，庭虚落叶声。\n秪应邻叟过，共话薜萝情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14356,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁暮宴李太守于鳞宅 其一","author":"谢榛","text":"别来吾叟老，蓟北尚征尘。\n词赋偏忧国，声名实在人。\n风驱平野雾，地转浊河春。\n侠气空成叹，荆卿旧入秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14357,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁暮宴李太守于鳞宅 其二","author":"谢榛","text":"为郎殊客礼，领郡重予招。\n积雪留孤馆，飞觞动几宵。\n有家何处定，多难此身遥。\n国士淹今日，应悲豫让桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14358,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送别杨中贵使武当","author":"谢榛","text":"登览君何处，云霞满太和。\n身轻鸟外转，心定虎边过。\n紫极飘钟磬，丹梯上薜萝。\n采芝献帝子，灵秀得来多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14359,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日大风集马云从园亭有感","author":"谢榛","text":"春风何太急，野水忽波澜。\n天远孤鸿落，亭虚万竹寒。\n田园殊爱静，稼穑久知难。\n百感逢今日，萧条醉里看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14360,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邺宰石中美转永州别驾","author":"谢榛","text":"策马零陵道，关山渺万重。\n霜明三楚树，云乱九疑峰。\n宦迹惊秋草，忧心坐晓钟。\n佩刀应不负，几为问边烽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14361,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初春侯兵宪举舜宅同潘别驾时乘赋得明字","author":"谢榛","text":"共酌宪台晚，挥觞催赋成。\n旅怀春惨澹，吾鬓雪分明。\n倚竹三湘梦，披云五岳情。\n有人正吹笛，风散落梅声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14362,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登楼晚眺达轩子同赋","author":"谢榛","text":"客子聊乘兴，王孙共倚楼。\n风烟平野夕，砧杵异乡秋。\n半醉还成赋，同怀岂倦游。\n望中有漳水，解傍邺台流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14363,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜宿东林寺","author":"谢榛","text":"笼中一灯尽，笼外几蛾回。\n夜久僧同话，霜明门半开。\n寒声虚竹院，秋色净莲台。\n还拟东林约，孤筇踏月来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14364,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕西岩君见过同酌","author":"谢榛","text":"春光在何许，客里只灯花。\n分却梅窗兴，来寻草舍家。\n夜寒馀巷雪，暝色聚城鸦。\n明日谁同醉，应思旧岁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14365,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日书怀","author":"谢榛","text":"远道驰乡梦，归期隔岁华。\n山川醉里赋，鸡犬客中家。\n巷僻馀春雪，城高驻晚霞。\n邻翁讶疏懒，相见问生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14366,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐生归临清","author":"谢榛","text":"婚嫁了心事，翻多千里情。\n关山渺行色，风雨缓归程。\n旧业浮云尽，新愁芳草生。\n故园春又老，黄鸟断肠声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14367,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜过昭觉禅院因忆懒上人同南泉西岩西池诸丈赋得嗟字","author":"谢榛","text":"重到谈经处，萧条人共嗟。\n禅心馀贝叶，老眼讶天花。\n孤磬风犹袅，双松月自斜。\n太虚渺无际，知是远公家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14368,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"昭觉禅院同南泉西岩二君赋得天字","author":"谢榛","text":"相约多幽事，频来有静缘。\n法云高捧月，祗树暗藏天。\n垂老堪投社，无心自会禅。\n谁为息机者，默坐奕棋边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14369,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄孔方伯汝锡","author":"谢榛","text":"事有关天地，谁当著述名。\n山林一身重，钟鼎几人轻。\n芳树杯中色，流泉枕畔声。\n应怜玉堂月，游宦老方城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14370,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次张汝任圆通阁饯别韵","author":"谢榛","text":"倚阁怜分袂，祗园夜尚游。\n松深孤磬落，杯满数星浮。\n别浦蒹葭暗，他乡蟋蟀秋。\n谁知独醒者，平子不同愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14371,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云川书斋同云洲诸丈留别赋得多字","author":"谢榛","text":"六月期幽赏，银塘有芰荷。\n诗从年老健，情到别时多。\n夜湿草间露，秋横天上河。\n王孙共今夕，郢调付云和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14372,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕敬诚二君饯别得秋字","author":"谢榛","text":"北斗挂城头，明河迥不流。\n人间清露夜，天上白榆秋。\n聚散多岐路，悲欢自女牛。\n谁知老来拙，回首故乡楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14373,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"积雨感怀","author":"谢榛","text":"积阴无晓夜，云气压城头。\n雀共疏檐雨，人同老树秋。\n晋山何惨色，汾水亦横流。\n此俗非荆楚，乡心重倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14374,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮雨","author":"谢榛","text":"坐听萧萧急，无风池亦波。\n庭花秋几许，窗雨夜偏多。\n老矣乡关梦，悲哉燕赵歌。\n不须临晓镜，空自叹蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14375,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日自遣","author":"谢榛","text":"甘向清时隐，无令素愿乖。\n存虚饶气色，拨累缓形骸。\n叶响风前树，苔青雨后阶。\n何须学宋玉，登眺苦秋怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14376,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋有感","author":"谢榛","text":"客边无节序，吟啸往时同。\n故里苔三径，名园桂几丛。\n琴樽孤夜月，朋旧各秋风。\n坐对青山好，苍茫灏气中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14377,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋怀","author":"谢榛","text":"东望太行路，巉岩几断崖。\n易归千里梦，难遣九秋怀。\n夜色霜明树，寒声叶满阶。\n著书思赵邸，静掩旧茅斋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14378,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无营","author":"谢榛","text":"无营诗亦苦，谩说有营劳。\n鸟宿三更转，松凉孤月高。\n客情疏晚计，人事重秋毫。\n我欲栖林壑，忘言醉浊醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14379,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"倚楼","author":"谢榛","text":"应接妨诗兴，淹留倍旅情。\n别家仍有累，浮世岂须名。\n山远暮霞色，林疏秋雨声。\n此楼非我室，愁思度阴晴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14380,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送儿元炳东还","author":"谢榛","text":"吾儿同入邺，今日汝先归。\n留滞乡音改，飘零旧业违。\n关河通古道，风雨暗春衣。\n寄我思亲泪，西原洒落晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14381,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十四夜无月","author":"谢榛","text":"皓魄将圆夜，张灯坐草堂。\n孤城低雨色，万户失秋光。\n笛里关山暝，楼前烟雾苍。\n金波若满地，随处有壶觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三台","author":"谢榛","text":"歌舞千年计，鸾舆去不回。\n豪华空四野，霸业有三台。\n水阔云仍度，沙寒鸟独来。\n黄花风露里，寂寞为谁开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜宿齐岭口","author":"谢榛","text":"空林烟火夜，茅宇暂幽栖。\n缺月低松杪，流星堕岭西。\n浩歌当绿酒，逸兴在丹梯。\n不见功名客，飘然独杖藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜登瑶台","author":"谢榛","text":"瑶台当绝顶，乘月一跻攀。\n河岳凭阑外，星辰拂袖间。\n身轻云自度，心远鹤俱閒。\n几欲招仙子，天风听佩环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山晚","author":"谢榛","text":"日落川原迥，商歌独放情。\n千峰连暮色，万木乱秋声。\n流水相回合，间云自送迎。\n人家隔烟浦，灯火望中明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同孟怀之钱子青酌白云洞","author":"谢榛","text":"古树敞岩扉，相携傍翠微。\n兴高松鹤下，坐久洞云飞。\n天地浮生老，山林胜会稀。\n不知蝉冕客，白发几人归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14387,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春归有感","author":"谢榛","text":"雨歇上林静，春归东阁虚。\n欲烦青鸟使，遥寄美人书。\n柳出宫云外，鸦鸣海日初。\n只今弹铗者，不为食无鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14388,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴子游泰岳","author":"谢榛","text":"送尔西江客，探奇东岳峰。\n断文馀汉石，古色有秦松。\n倚杖海天近，听泉云壑重。\n金箱閟丹诀，谁共访仙踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14389,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周藩王广文归钱塘","author":"谢榛","text":"长安芳草歇，多病赏心违。\n落日三江满，秋风一棹归。\n雨来寒雁失，潮上夜钟微。\n梁孝怀词客，无劳访钓矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14390,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月十三夜谭鸿胪子羽第同李太史子寔张给事巽卿莫膳部子良赋得秋字","author":"谢榛","text":"当樽月欲满，良夜故同游。\n宫阙散清雾，星河悬素秋。\n病多还授简，客久数登楼。\n喜结淮南侣，非关桂树留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14391,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苗仲材告别登楼晚聎得天字","author":"谢榛","text":"青山出半天，一带迥苍然。\n乱树馀秋色，寒城更暮烟。\n交游多惜老，离合几经年。\n共有登楼赋，谁为王仲宣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14392,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王端甫归浦坂","author":"谢榛","text":"惜别京华道，秋风送马啼。\n日斜孤雁外，家远万峰西。\n归计聊樽酒，行歌且杖藜。\n何时首阳下，共尔吊夷齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14393,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陆秀才归华亭","author":"谢榛","text":"九月清霜下，三江白舫归。\n芙蓉寒始发，鸿雁暮还飞。\n自许同张翰，谁怜滞陆机。\n读书沧海上，灯火映林扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14394,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"周子才惠菊并酒","author":"谢榛","text":"分我名园种，迎霜花正开。\n故山有篱落，秋色此亭台。\n坐赏成孤酌，吟看信几回。\n因君兴不浅，昨遣白衣来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14395,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登榆林城","author":"谢榛","text":"凭高望不极，天外一鸿过。\n万岭夕阳尽，孤城寒色多。\n芦笳满亭堠，羽檄度关河。\n遥忆龙庭士，严霜正荷戈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14396,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"落花有感","author":"谢榛","text":"花开惊节序，花落转堪悲。\n物色殊无意，春风暗有期。\n蝶回芳草径，莺度夕阳枝。\n独有豪华子，青楼醉不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14397,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望西山","author":"谢榛","text":"西山久不到，花鸟向何人。\n风散石崖雪，天开湖水春。\n老僧虚白社，骚客负青蘋。\n底事燕京陌，黄尘满角巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14398,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠平乡赵隐君","author":"谢榛","text":"风霾起薄暮，有客叹归欤。\n白首犹怀刺，青山且著书。\n故乡春树外，别馆夜钟馀。\n不见磻溪叟，终然载后车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14399,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"野望","author":"谢榛","text":"西北消烽火，边关罢檄书。\n寒声惟鸟雀，野色但村墟。\n石秃烧山后，崖明带雪初。\n谁为筹国者，云物渺愁予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14400,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻岢岚被兵","author":"谢榛","text":"三冬几烽火，诸将亦豪雄。\n月冷胡笳断，云低汉垒空。\n勋名身后别，边议眼前同。\n枯木惟啼鸟，凄其向晚风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14401,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客居即事","author":"谢榛","text":"客居何懒慢，过午尚科头。\n老得医书喜，閒增诗债愁。\n春寒风偃树，天晚雪明楼。\n莫谓常漂泊，西来是壮游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14402,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游水竹园孔丈同赋","author":"谢榛","text":"移得南山竹，冰霜见苦根。\n春流触自响，清影羃何繁。\n色蘸杯中绿，凉沾雨后痕。\n邹枚此同赋，胜事即梁园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14403,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次宋伯镇游王文父西园韵","author":"谢榛","text":"郭西车马路，尘外薜萝园。\n楼迥晴云合，庭閒秋草繁。\n素心犹白鸟，幽事且芳樽。\n地胜人多赋，青山谁并存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14404,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李子田有事代州闻敌犯羊防口憣然归县赋此寄怀","author":"谢榛","text":"迁客复行役，翩翩向代州。\n尘飞随宦辙，云暝结边愁。\n归鸟异乡树，悲笳何处楼。\n黄花老山县，相待几枝秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14405,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东林寺夜集不与次西岩君韵","author":"谢榛","text":"庐山在咫尺，钟磬落诸天。\n不到真如地，遥看香积烟。\n轮蹄双树下，语默一灯前。\n欲问无生法，衰颓独慨然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14406,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨后送刘孝夫东归","author":"谢榛","text":"相见凄凉色，孤怀风雨天。\n黄金交易薄，清镜老堪怜。\n马出燕南路，家临济北田。\n送君一长啸，高鸟没苍烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"京师大雨","author":"谢榛","text":"夜来雨何急，睡起问儿曹。\n秋响门前水，寒生树里涛。\n素居邻市井，老计托风骚。\n好为冲泥去，新丰贳浊醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋夜南园同故人酌","author":"谢榛","text":"不谒金张第，相期松桂边。\n人须今夜酒，月朗故乡天。\n归思逢秋色，狂歌度老年。\n阴晴如可定，早上玉峰颠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王给事佐之潞州封王","author":"谢榛","text":"路出西山远，城依上党高。\n白云何处望，赤日此行劳。\n帝子周封建，天臣汉节旄。\n昼游还洛下，气色满宫袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14410,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"薄暮赵户部良弼官署西园同郑山人中伯醉赋四首 其一","author":"谢榛","text":"薄暮偶乘兴，开樽非预期。\n野夫偏坐久，庭雀故飞迟。\n地拔群松劲，天成片石奇。\n种蔬甘此味，还使后人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14411,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"薄暮赵户部良弼官署西园同郑山人中伯醉赋四首 其二","author":"谢榛","text":"要识为农苦，官园半亩禾。\n有才知计远，无事阅书多。\n童子琴樽待，山人杖屡过。\n长吟见幽意，独鸟下庭柯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14412,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"薄暮赵户部良弼官署西园同郑山人中伯醉赋四首 其三","author":"谢榛","text":"园中有亭沼，宦邸得幽栖。\n曲折由人胜，深沉使客迷。\n竹枝风外袅，莲叶雨中低。\n我欲尽奇绝，明朝还杖藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"薄暮赵户部良弼官署西园同郑山人中伯醉赋四首 其四","author":"谢榛","text":"骚雅成幽赏，相依古树丛。\n未论金谷胜，真与漆园同。\n宦迹风云转，王程关塞通。\n随君秋夜梦，乘月过辽东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮秋集小山王孙第分得新字","author":"谢榛","text":"悲秋仍兔苑，华发几茎新。\n黄菊频催老，青山久待人。\n交情且樽俎，世事各风尘。\n醉别王孙去，天涯草自春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]