[{"title":"王观察八柏亭二首 其一","author":"卢龙云","text":"宅以三槐胜，亭因列柏留。\n岁寒偏不改，春翠日添稠。\n门亦曾罗雀，材非但蔽牛。\n悠悠伤往事，气节自千秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19451,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王观察八柏亭二首 其二","author":"卢龙云","text":"乔木家声远，芳亭胜事繁。\n雪霜看愈劲，雨露感偏存。\n几就閒居赋，休誇独乐园。\n东山何日起，难自老衡门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19452,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答妺丈崔体韶二首 其一","author":"卢龙云","text":"弟妺天南远，开缄独惘然。\n栖迟因鸟道，沦落愧龙渊。\n旅梦乡园隔，生涯岁月迁。\n薄游苏季子，安问洛阳田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19453,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答妺丈崔体韶二首 其二","author":"卢龙云","text":"羡尔方云卧，衡茅且避喧。\n蓬犹张氏径，帷自董生园。\n共惜飞腾晚，长怀笑语温。\n不言桃与李，应自见环门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19454,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺郡丞过谈有思归之作赋此慰留","author":"卢龙云","text":"宿雨妆残暑，新晴见晚晖。\n官閒期会少，地僻到来稀。\n持论多坚白，当歌但式微。\n君才非六百，岂可遂怀归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19455,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王德称从外舅韩公?兵槜李以所著客越集见惠代柬留酌","author":"卢龙云","text":"仗剑南游客，迎秋望故乡。\n山川来越绝，风雨度维扬。\n抱玉齐冰镜，怀珠溢锦囊。\n久无诗伴至，那可废传觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19456,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"守岁","author":"卢龙云","text":"烛烬将残夜，钟鸣欲曙天。\n漂零思故国，惟悴入新年。\n春色还应近，东方候更先。\n呼童催柏酒，往事不须怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19457,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕同张计部常比部张大行宴集","author":"卢龙云","text":"频年多道路，良会总他乡。\n百里星还聚，千金夜可长。\n灯花迎客笑，火树接邻光。\n愁病消强半，清歌复几觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19458,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"穆陵关二首 其一","author":"卢龙云","text":"驻马频思古，西风度穆陵。\n崖悬山径狭，地迥野云层。\n险阻真天设，山川几代兴。\n时平关禁少，来往自相仍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19459,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"穆陵关二首 其二","author":"卢龙云","text":"海岱称雄镇，提封自昔时。\n当关元重地，赐履尽南陲。\n往事惟衰草，颓垣有断碑。\n游人多感慨，指点日西移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19460,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘博士以诗文见寄赋答二首 其一","author":"卢龙云","text":"采风来大国，冠盖忆同游。\n悬榻空相待，驱车可自由。\n高谈虚稷下，司命有荆州。\n词藻非公干，谁堪第一流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19461,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘博士以诗文见寄赋答二首 其二","author":"卢龙云","text":"乡里衣冠后，如君岂乏贤。\n文雄推赤帜，官冷尚青毡。\n飘泊同羁旅，赓酬少接联。\n上林将赋猎，紫陌听莺迁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19462,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五日过城西草堂","author":"卢龙云","text":"不到西园久，蒲觞此日来。\n池环碧树合，门对紫薇开。\n雨气清书幌，风香入酒杯。\n欲寻逃□会，端不限城隈。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19463,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再过草堂同罗李区诸君及二仲小酌","author":"卢龙云","text":"探幽谢尘役，乘暇款林扉。\n好鸟声初集，连枝萼并辉。\n暑从新雨涤，兴逐野云飞。\n每忆西园会，清尊傍夕晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19464,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题飞泉洞二首 其一","author":"卢龙云","text":"洞倚诸天胜，泉飞万壑寒。\n枕流山瀑细，开径野云宽。\n入会方莲社，招游并鹖冠。\n鹤书如可待，难恋一枝安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19465,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题飞泉洞二首 其二","author":"卢龙云","text":"峡寺飞来久，泉应与寺同。\n洞迷芳草径，林递落花风。\n谷静闻莺响，山幽望桂丛。\n探奇争载酒，倚杖见晴虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19466,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答梁公益","author":"卢龙云","text":"上客争虚左，王孙岂自哀。\n止因怀璞久，翻讶弃繻来。\n骥足追风远，龙光傍斗开。\n子虚如有问，谁复马卿才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19467,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答黄季重二首 其一","author":"卢龙云","text":"不浅春晖恋，仍淹九万程。\n风尘过逆旅，逢掖守诸生。\n旧学潜心富，新诗彻骨清。\n远来君自见，多是为同声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19468,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答黄季重二首 其二","author":"卢龙云","text":"天涯羁薄宦，留滞惜年光。\n琴静馀单父，车驱自太行。\n气佳秋日夕，风洒客衣裳。\n白雪依然在，承家业擅长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19469,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜晴","author":"卢龙云","text":"积雨愁难破，新晴喜不禁。\n绕檐飞燕剧，穿径落花深。\n得暇频开卷，息交寡盍簪。\n风来庭院午，独坐正披襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19470,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和黎文学村庄即事","author":"卢龙云","text":"暂出红尘市，田家可避喧。\n蓬蒿俱满径，芋栗各为园。\n安定非鸿泽，相携类鹿门。\n客来新酿熟，夜月醉荒村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19471,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕舟中二首 其一","author":"卢龙云","text":"今夕是何夕，扁舟伴鹤汀。\n推篷一月白，弭棹数峰青。\n深夜惟渔火，孤尊自客星。\n不愁更漏永，此地隔尘扃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19472,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕舟中二首 其二","author":"卢龙云","text":"旅泊逢佳节，长宵作卧游。\n江间仍禁夜，月下且维舟。\n火树违同赏，灯花逭独愁。\n明年知此夕，何客共登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19473,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒食","author":"卢龙云","text":"旅次经寒食，游人念故园。\n松楸违渐远，雨露感偏存。\n昔幸同三釜，今谁作九原。\n环樵峰七十，有梦到云门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19474,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过汨罗江","author":"卢龙云","text":"拟吊三闾赋，经行久未投。\n谗人应共愤，宗国仗谁忧。\n鱼腹千年恨，江声万古愁。\n向令天可问，端不负灵脩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19475,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大风过采石泊舟时自慰","author":"卢龙云","text":"放舶春流驶，烟波却自愁。\n半帆过采石，孤屿望仙楼。\n水阔鱼龙宅，天空雁鹜洲。\n长风吹不尽，薄暮喜维舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19476,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三月抵京二首 其一","author":"卢龙云","text":"帝城三月暮，天气亦初春。\n红紫花相待，青黄柳未匀。\n条风开宿雾，细雨浥轻尘。\n物色元非恶，深尊绿且亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19477,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三月抵京二首 其二","author":"卢龙云","text":"尚及三春候，重来万里人。\n辞家方在远，观国屡为宾。\n宦业难书竹，时情任积薪。\n长安真似奕，往事不须颦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19478,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出京阻雨","author":"卢龙云","text":"久客长安陌，缁尘日上衣。\n计程方跋涉，听雨转霏微。\n恋阙身难系，忧时愿不违。\n冲泥非傍险，前路有晴晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19479,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答区用孺太史雨中赠别","author":"卢龙云","text":"漂泊风尘里，曲江度几春。\n莺仍乔木友，燕傍旧家人。\n识路蹄空急，更弦调强新。\n皇天多雨泽，何地不堪均。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19480,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝带桥在吴江","author":"卢龙云","text":"何年驱石至，十里接湖干。\n雁鹜烟波渺，鱼龙夜水宽。\n采菱歌进艇，对月坐持竿。\n无限潇湘意，秋初露已寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19481,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿江山客舍","author":"卢龙云","text":"信宿江山道，清泠涧水滨。\n川原多胜概，漂泊自风尘。\n暂豁登楼目，因惭报主身。\n灯前对儿女，何日是归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19482,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江郎石","author":"卢龙云","text":"江郎三片石，鼎立出丹霄。\n地植孤根远，天擎列柱遥。\n露为金掌润，霞是赤城标。\n劲质原无改，浮云暮复朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19483,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"建溪夜泊时值中秋","author":"卢龙云","text":"住楫滩头宿，滩声彻夜喧。\n水舂随断岸，渔火照孤村。\n月满秋光半，更深露气寒。\n推篷怜对影，凉籁起高原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19484,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"武闱校士二首 其一","author":"卢龙云","text":"闽海烽初净，辽阳檄转催。\n徵兵烦十道，策士喜多才。\n技已穿杨胜，筹因借箸来。\n君王思颇牧，仗钺早登台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19485,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"武闱校士二首 其二","author":"卢龙云","text":"此去频推毂，谁当独请缨。\n圣恩深养育，壮志待澄清。\n脱颍三千客，蟠胸十万兵。\n扶桑弓未挂，须道有干城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19486,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和少司马陈公除夕忆其伯子孝廉之作","author":"卢龙云","text":"悬车惟绿野，游骑有青丝。\n家庆遥相忆，年光暗自移。\n槐高王相宅，兰茁谢家儿。\n第一天人奏，承恩复阿谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19487,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又和元夕四首 其一","author":"卢龙云","text":"细雨尘初净，长宵漏莫催。\n园同飞盖会，客并小车来。\n列炬红相映，深尊绿正开。\n厌厌拚夜饮，不醉未应回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19488,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又和元夕四首 其二","author":"卢龙云","text":"闾阎多乐事，弦管竞先鸣。\n月色晴还见，星光聚转明。\n千杯为酒阵，五字作诗城。\n折简吾能至，烛残漏几更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19489,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又和元夕四首 其三","author":"卢龙云","text":"节是三元夜，家同万石君。\n宾筵元自羙，众乐总堪群。\n授简多吟雪，当歌尚遏云。\n笳声何处急，莫向此中闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19490,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又和元夕四首 其四","author":"卢龙云","text":"入社能为主，登堂侈集贤。\n衣冠惭上客，钟鼓乐初筵。\n夜色过新雨，山光落紫烟。\n赋才俱擅羙，谁愧在卢前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19491,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周博士招同观灯四首 其一","author":"卢龙云","text":"改岁风初暖，良宵月更新。\n一时俱逆旅，万户却同春。\n对语何妨久，相酬不厌频。\n周郎能顾曲，徙席正堪亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19492,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周博士招同观灯四首 其二","author":"卢龙云","text":"自尔来鸣铎，诸生庆拔茅。\n烧兰淹夜酌，馔玉出中庖。\n月向芹宫照，花因火树交。\n主人情未已，促席句同敲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19493,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周博士招同观灯四首 其三","author":"卢龙云","text":"华灯连月彩，列炬映星芒。\n爱客方投辖，徵歌复绕梁。\n更寒听漏永，坐洽引杯长。\n不醉应难寐，相看喜欲狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19494,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周博士招同观灯四首 其四","author":"卢龙云","text":"凭阑多夜色，入座况春风。\n客里芳心并，人间乐事同。\n诗成俱倚马，笔落总如虹。\n更仗杯中物，相酬慰转蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19495,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"司马公游支提山回延过小集别后见贻兼约鳌山之会答和二首 其一","author":"卢龙云","text":"春游何处远，闻道叩双林。\n尽得寰中胜，其如别后心。\n忽来成美晤，久坐豁尘襟。\n礼数难拘束，赓酬到夜深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19496,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"司马公游支提山回延过小集别后见贻兼约鳌山之会答和二首 其二","author":"卢龙云","text":"南天方渐暑，而我坐春风。\n秉烛夜方永，当筵月正东。\n玄谈称莫逆，高咏总堪同。\n案牍逢多暇，相期复桂丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19497,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏周广文席上","author":"卢龙云","text":"雨过凉生座，云开月近帘。\n诗情堪并发，酒戒未须严。\n近地欣无警，平畴赖既沾。\n喜君清夜酌，笑语解相淹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19498,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晦翁岩四首有引 其一","author":"卢龙云","text":"闻道龙峰胜，公馀得共攀。\n石门高并对，岭树翠相环。\n海色苍茫外，湖光渺霭间。\n此中有佳处，况是古贤关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19499,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晦翁岩四首有引 其二","author":"卢龙云","text":"地迥烦先涤，林高暑易残。\n云飞自怡悦，竹报日平安。\n目极河山远，神游宇宙宽。\n当年漂泊意，谁道愧儒冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19500,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晦翁岩四首有引 其三","author":"卢龙云","text":"龙山读书处，镌石在云门。\n避地迹偏远，得师道愈尊。\n斯文应未丧，家学赖常存。\n杖屦来从者，衣冠有裔孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19501,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晦翁岩四首有引 其四","author":"卢龙云","text":"俯仰千年事，芳名重此山。\n渊源俱学孔，伯仲总晞颜。\n道与乾坤久，心俱水石閒。\n我来登眺暂，觉已出尘寰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19502,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉军门檄阅兵海上二首 其一","author":"卢龙云","text":"寓目真无际，洪流远拍天。\n楼船多尺籍，沙屿未桑田。\n对月还惊燧，迎潮或控弦。\n可能风万里，尽扫海门烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19503,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉军门檄阅兵海上二首 其二","author":"卢龙云","text":"井里诛求急，俱缘饷荷戈。\n昆明池水阔，赤壁夜帆多。\n分队为鱼鸟，扬威杂鹳鹅。\n将军同下濑，谁不负铙歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19504,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荔枝","author":"卢龙云","text":"南国种偏奇，青林朱实垂。\n味分甘露液，色染绛罗衣。\n仙子霞为佩，佳人玉作肌。\n可怜尘骑远，空解笑杨妃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19505,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周吴华为刻拙稿先示数篇赋答二首 其一","author":"卢龙云","text":"十载风尘客，谈诗每避人。\n喜心宁见猎，寡和觉情亲。\n案牍元多暇，宫墙况近邻。\n羊何欣有托，空自愧阳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19506,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周吴华为刻拙稿先示数篇赋答二首 其二","author":"卢龙云","text":"久缘诗癖在，习静懒敲推。\n授简知同调，为模愧后来。\n未须忧纸贵，先只惧梨灾。\n掌故多文学，如君实爱才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19507,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜霁二首 其一","author":"卢龙云","text":"旸雨元多憾，阴晴未可知。\n登场期有穫，沉灶尚啼饥。\n霓望真同切，云开孰与期。\n东方忽已白，明作复当离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19508,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜霁二首 其二","author":"卢龙云","text":"霪潦如春雨，今朝喜得常。\n翻馀无石燕，舞罢失商羊。\n省歛初遵亩，负暄始向阳。\n农家欣作颂，更有万斯箱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19509,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游宗振自莆见过辄有贻赠答和二首 其一","author":"卢龙云","text":"命驾谁千里，神交自昔年。\n青云多旧侣，白雪富新篇。\n北海尊仍在，南州榻屡悬。\n喜君乘兴日，犹及暮春前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19510,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游宗振自莆见过辄有贻赠答和二首 其二","author":"卢龙云","text":"一自承环后，称诗辄避名。\n身容天有幸，才谢国为桢。\n政每惭三异，招常虑四轻。\n偏师谁劲敌，资尔护长城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19511,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再报满六首 其一","author":"卢龙云","text":"通籍方逾壮，登朝异晚收。\n蹉跎因宦拙，漂泊感年流。\n风木多遗恨，烟花几别愁。\n寥寥思往事，真自愧潜修。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19512,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再报满六首 其二","author":"卢龙云","text":"远忆西游日，羁栖二载馀。\n名当百里起，迹类九夷居。\n为国初经野，还家辄倚庐。\n有怀知罔极，未得报鸾书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19513,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再报满六首 其三","author":"卢龙云","text":"拭泪辞先陇，干名赴上都。\n璧完初返赵，莼羙又思吴。\n马足非吾土，羊肠实畏途。\n丛台空有恨，飞梦月同孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19514,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再报满六首 其四","author":"卢龙云","text":"益津三辅地，卑湿亦长沙。\n谪宦非投远，羁人止念家。\n开尊持问月，随伴强看花。\n计粒妻拿饱，恩宽早及瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19515,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再报满六首 其五","author":"卢龙云","text":"偶捧除书下，言遵北海东。\n邯郸失学步，书社讶论功。\n鸿羽哀中泽，萱花悴晚风。\n孝慈双陨泪，归路逐飘蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19516,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再报满六首 其六","author":"卢龙云","text":"辞家悲宰木，劝驾藉朋游。\n拜阙惭三仕，遭时诵四愁。\n海邦仍抚字，桑土但绸缪。\n报绩知无补，何因动冕旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19517,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒食前一日拟移尊于南山寺僧舍延宗振小酌代柬二首 其一","author":"卢龙云","text":"僻地淹词客，禅房对晚山。\n攒眉因入社，望气似临关。\n节是清和候，人乘著述閒。\n行厨将禁火，先共醉乡还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19518,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]