[{"title":"送萧司空之南都四首 其二","author":"胡应麟","text":"灿烂熊车度，逶迤凤阙来。\n戈鋋千堠列，卤簿百城开。\n日近司空座，星移上将台。\n大廷推相国，谁并酂侯才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16194,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送萧司空之南都四首 其三","author":"胡应麟","text":"组练过吴会，衣冠入汉宫。\n日光摇画戟，霞色射彤弓。\n渤海三秋静，潢池四望空。\n未应劳梦卜，天意属非熊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16195,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送萧司空之南都四首 其四","author":"胡应麟","text":"鼓吹出江皋，前驱意气豪。\n射潮收万弩，横海列千舠。\n日月瞻黄屋，云霞护锦袍。\n秣陵花似绮，烂漫待抽毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16196,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠赵茂才","author":"胡应麟","text":"言开绿萝径，却访赤松游。\n枕簟依山僻，琴书入洞幽。\n姓名文苑客，身世醉乡侯。\n莫羡侯芭业，玄亭易白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16197,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李逸人西游寄讯","author":"胡应麟","text":"一壑容高卧，频年赋远游。\n卜居秦望顶，长啸越台秋。\n海日低龙屩，山风绽鹿裘。\n钱塘潮渐长，乍夜放扁舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16198,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日题唐惟良山房二首 其一","author":"胡应麟","text":"郭外千峰色，翛然堕草堂。\n挂冠三径蚤，高枕一丘长。\n夕露团幽砌，朝霞宿画廊。\n门添五杨柳，何异在柴桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16199,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日题唐惟良山房二首 其二","author":"胡应麟","text":"结宇双松下，为园万竹中。\n壮年歌老骥，长日送飞鸿。\n露浥琴丝润，星摇剑色雄。\n看余五游毕，绝顶卧空同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16200,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄灌父","author":"胡应麟","text":"怅望西亭客，沈吟北海筵。\n玉笙王屋顶，珠履邺台前。\n桂树先秋发，藜灯入夜悬。\n异时双鹤语，归问大罗天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16201,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀邓孺孝兼讯周山人","author":"胡应麟","text":"忆汝龙门过，苍茫鹤驭分。\n暮归句曲洞，晨谒大茆君。\n把钓吴江雪，传书越海云。\n草堂人独卧，谁勒稚圭文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16202,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴叔通以四诗见贻赋答 其一","author":"胡应麟","text":"寂寞乾坤事，归来一敝裘。\n云山成独卧，海岱见名流。\n璧已三年抱，珠仍万里投。\n白蘋洲上路，曾试木兰舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16203,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴叔通以四诗见贻赋答 其二","author":"胡应麟","text":"何处怀同调，飞书问独醒。\n乍回双眼白，犹阻万峰青。\n惨淡垂纶石，栖迟载酒亭。\n异时新论就，能赏太玄经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16204,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴叔通以四诗见贻赋答 其三","author":"胡应麟","text":"病肺荒园外，潜身大海傍。\n青阳驰翰墨，白雪照行藏。\n一水兰苕近，千岩薜荔长。\n夜来星斗色，明灭傍干将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16205,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴叔通以四诗见贻赋答 其四","author":"胡应麟","text":"梦寐延陵客，风流故不群。\n千秋曾和雪，片语欲凌云。\n柳隔青丝笮，花生白练裙。\n浮家何日事，来往霅溪云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16206,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"句曲道中奉怀王司马先生寄讯八首 其一","author":"胡应麟","text":"帝梦思良弼，天书问老臣。\n彤弓分雨露，赤舄上星辰。\n虎豹千营合，熊罴百卫陈。\n何妨文武略，第一画麒麟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16207,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"句曲道中奉怀王司马先生寄讯八首 其二","author":"胡应麟","text":"夙世元戎业，明时上将材。\n大开貔虎幕，长啸凤凰台。\n记室班扬聚，胡床陆谢陪。\n昨宵江上笛，飞尽帝城梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16208,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"句曲道中奉怀王司马先生寄讯八首 其三","author":"胡应麟","text":"凤德元千仞，熊飞自一时。\n河山分玉帐，日月绕牙旗。\n错落霜毫动，荧煌露布驰。\n共知莘野出，宁畏草堂移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16209,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"句曲道中奉怀王司马先生寄讯八首 其四","author":"胡应麟","text":"暂辞三教主，聊作万夫雄。\n横槊长江上，挥毫大海东。\n阴徐非赋侣，鲍庾岂文工。\n晋宋齐梁业，何人不下风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16210,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"句曲道中奉怀王司马先生寄讯八首 其五","author":"胡应麟","text":"谭天曾帝问，缩地旧仙才。\n未论青牛出，真成彩凤来。\n毫端穷宇宙，匣底閟风雷。\n戏作梁陈句，犹堪长玉台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16211,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"句曲道中奉怀王司马先生寄讯八首 其六","author":"胡应麟","text":"寂寞千秋事，踟蹰六代间。\n新亭新日月，旧馆旧河山。\n柳色停车骑，花香杂佩环。\n吴姬年尚少，劝客亦酡颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16212,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"句曲道中奉怀王司马先生寄讯八首 其七","author":"胡应麟","text":"豪华非昔日，罗绮尚前朝。\n侠少黄金勒，名姝赤玉箫。\n花明新院髻，柳学故宫腰。\n今夜扬州月，平分十二桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16213,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"句曲道中奉怀王司马先生寄讯八首 其八","author":"胡应麟","text":"石头城外路，光色度青骢。\n说法寻支遁，参禅叩懒融。\n塔花晴日映，潭影暮天空。\n拟逐三车去，西方问大雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16214,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡江有怀秣陵旧游八首再寄王长公 其一","author":"胡应麟","text":"六代风流地，豪吟兴未涯。\n层台花宿凤，故堞柳藏鸦。\n海日笼丹雾，江天照绮霞。\n春光何太蚤，先到莫愁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16215,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡江有怀秣陵旧游八首再寄王长公 其二","author":"胡应麟","text":"投闲沧海上，阅胜大江濆。\n老树齐梁雪，飞蓬楚蜀云。\n帝城双凤下，官路八驺分。\n怅望前朝事，含杯几夕曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16216,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡江有怀秣陵旧游八首再寄王长公 其三","author":"胡应麟","text":"金波怜旧句，玉树待新题。\n夜宿寻高座，春游出大堤。\n残僧留晋宋，古佛辨隋齐。\n明日楼船上，谁同教水犀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16217,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡江有怀秣陵旧游八首再寄王长公 其四","author":"胡应麟","text":"由来佳丽地，本是帝王州。\n绿浪邀卢女，青山抱蒋侯。\n桃花双阙路，柳色万家楼。\n总道官如屣，那知宦是游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16218,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡江有怀秣陵旧游八首再寄王长公 其五","author":"胡应麟","text":"幕府三千客，辕门十万兵。\n登龙环海岱，候骑半江城。\n画甲飘云气，珠帘上月明。\n夜来清啸发，双鹤下瑶京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16219,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡江有怀秣陵旧游八首再寄王长公 其六","author":"胡应麟","text":"玉洞留仙棹，金陵问帝都。\n野花朱桁雀，霜树白门乌。\n晏寝团牙戟，宵吟击唾壶。\n能教奇伟客，白首卧菰芦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16220,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡江有怀秣陵旧游八首再寄王长公 其七","author":"胡应麟","text":"青鞋曾碧落，彩仗乍丹霄。\n大雅追三代，雄风扫六朝。\n帆樯扬子驿，卤簿秣陵桥。\n但作文章客，宁知武略饶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16221,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡江有怀秣陵旧游八首再寄王长公 其八","author":"胡应麟","text":"柱下书堪著，壶中术已传。\n三花留野寺，一苇渡江天。\n浪息沧溟外，尘消大漠前。\n何须片石上，辛苦勒燕然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16222,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病卧原口长公以诗见存遂有起色赋谢四章 其一","author":"胡应麟","text":"骨立乾坤外，呻吟岁月过。\n片言回大造，孤榻起沈疴。\n骤觉头风愈，宁论肺病多。\n观涛定何日，飞棹广陵波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16223,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病卧原口长公以诗见存遂有起色赋谢四章 其二","author":"胡应麟","text":"病卧空搔首，文成剧赏心。\n乍回燕客梦，初理越人吟。\n白雪流空馆，青阳动绝琴。\n片言千古在，底事论飞沈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16224,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病卧原口长公以诗见存遂有起色赋谢四章 其三","author":"胡应麟","text":"一札长干里，悠然病目开。\n讵知垂烬烛，犹作复然灰。\n赵璧初还邸，燕金任筑台。\n朝来沧海上，咫尺见蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16225,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病卧原口长公以诗见存遂有起色赋谢四章 其四","author":"胡应麟","text":"无媒宁逐鹿，有路任亡羊。\n朗诵陈琳檄，高悬杜甫章。\n神明开混沌，鬼魅失膏肓。\n濩落馀生在，犹堪王夜郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16226,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡淮","author":"胡应麟","text":"拂曙淮堤上，垂杨渐可攀。\n雾浓孤客舫，云浅八公山。\n不作投珠去，真成抱玉还。\n十年牛马走，端合鬓毛斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16227,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自严滩至新安途中纪兴十首呈司马汪公 其一","author":"胡应麟","text":"四百滩头路，峰峦面面青。\n路疑行绝栈，滩似泊空舲。\n平地飞千瀑，高天突万星。\n不因司马在，吾岂别玄亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16228,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自严滩至新安途中纪兴十首呈司马汪公 其二","author":"胡应麟","text":"一滩高一丈，滩尽到天都。\n叠嶂云飞动，阴厓日有无。\n辛夷残紫落，踯躅乱红敷。\n独少行云庙，分明入峡途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16229,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自严滩至新安途中纪兴十首呈司马汪公 其三","author":"胡应麟","text":"明发寒逾甚，羊裘当锦袍。\n争风帆力猛，破雪橹声豪。\n闇谷迷红树，悬厓露碧桃。\n居然丘壑底，不用武陵逃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16230,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自严滩至新安途中纪兴十首呈司马汪公 其四","author":"胡应麟","text":"悬水三千仞，奔流落大川。\n片帆危欲堕，群缆急争先。\n石险时栖鹘，峰高欲跕鸢。\n兹游信奇绝，点笔漫成篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16231,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自严滩至新安途中纪兴十首呈司马汪公 其五","author":"胡应麟","text":"树色逶迤合，山光次第来。\n岸疑夸父坼，厓似巨灵开。\n蜀客迷三峡，闽人话七台。\n移舟傍鸥鹭，此夕漫惊猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16232,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自严滩至新安途中纪兴十首呈司马汪公 其六","author":"胡应麟","text":"嵯峨探虎穴，䆗窱入龙宫。\n百丈飞湍下，双篙巨石中。\n地危真破冢，天近欲乘风。\n恰称诗怀壮，长歌万虑空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16233,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自严滩至新安途中纪兴十首呈司马汪公 其七","author":"胡应麟","text":"密缆纷如织，高樯望若攒。\n怒涛翻绝壑，飞浪叠层峦。\n不雨青天润，无风白日寒。\n苍松植何代，百尺架㠝岏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16234,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自严滩至新安途中纪兴十首呈司马汪公 其八","author":"胡应麟","text":"片石俱飞动，千山竞送迎。\n地真游黯淡，天似入蓬瀛。\n缆束高厓度，樯穿绝壁行。\n谁呼谪仙至，白日跨长鲸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16235,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自严滩至新安途中纪兴十首呈司马汪公 其九","author":"胡应麟","text":"白岳新游快，青溪旧迹存。\n乱山冲虎过，奇石象狮蹲。\n贾舶环枫社，渔梁护荜门。\n飞鸿渺天末，消息信乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16236,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自严滩至新安途中纪兴十首呈司马汪公 其十","author":"胡应麟","text":"十年怀命驾，千里棹孤航。\n大壑行严濑，飞流涉吕梁。\n猿猱晨作伴，豺虎夜成行。\n咫尺龙门在，无劳叹望洋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16237,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"惊猿峡","author":"胡应麟","text":"不见啼猿树，孤峰划翠屏。\n峭逾扪太华，危欲堕中泠。\n鸟道悬空阔，龙潭伏杳冥。\n笑他韩吏部，勒石向山灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16238,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"伏虎岩","author":"胡应麟","text":"何年飞滟滪，百尺挂崔嵬。\n绝壁盘飞电，高梁划迅雷。\n樯危三老惧，缆急万人摧。\n日暮雄心发，狂歌兴未回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16239,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柬汪仲淹时以足疾居肇林去太函三十里","author":"胡应麟","text":"方丈维摩室，翛然物外踪。\n花馀天女散，果剩法王供。\n白日流禅榻，青天落梵钟。\n何当问神足，白眼对长松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16240,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠片云片云者司马公所命王姬名也","author":"胡应麟","text":"窈窕尊前态，娉婷画里颜。\n客疑游洛水，神似降巫山。\n夜月辉眉黛，朝霞动髻鬟。\n不应撩宋玉，名字落人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16241,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仲嘉携酌过箕台四首末篇怀汪献于 其一","author":"胡应麟","text":"信步南冈上，寒松一径斜。\n浮杯当柳色，促席坐桃花。\n古殿明丹壑，方塘漾彩霞。\n红妆晚成队，拾翠傍晴沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16242,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仲嘉携酌过箕台四首末篇怀汪献于 其二","author":"胡应麟","text":"步步春原色，寻芳意自閒。\n石枰疏竹里，金铎乱松间。\n一壑停苍佩，千峰峙翠鬟。\n平生双屐在，天阔任跻攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16243,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仲嘉携酌过箕台四首末篇怀汪献于 其三","author":"胡应麟","text":"远天横霁色，箕踞坐莓苔。\n竹露晨犹滴，松风午渐来。\n翠微悬绝壑，苍霭覆平台。\n十日犹能客，将无典绿醅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16244,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仲嘉携酌过箕台四首末篇怀汪献于 其四","author":"胡应麟","text":"潦倒悲华发，追随暂少年。\n煖风抽麦日，微雨拗花天。\n游女矜环佩，居民竞管弦。\n维扬好春色，何地著丝鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16245,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"士能斋头阻雨仲淹舆疾来会一律迟之","author":"胡应麟","text":"风雨催寒食，残花闭小楼。\n丁香空结恨，红豆故生愁。\n梦隔青绫被，春迟绿绮裘。\n观涛今起色，迟汝万峰头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16246,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同盛山人垆头话旧作","author":"胡应麟","text":"一骑吴关外，悲歌脱畏途。\n残生馀海峤，万死得江湖。\n盆底冤谁烛，垆头兴未徂。\n十年携手泪，相对湿菰芦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16247,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日司马公同携王姬入紫霞洞观桃花时少连太宁仲嘉仲淹并集司马以桃花源美人家为韵分得桃字","author":"胡应麟","text":"烂漫西郊外，肩舆度碧桃。\n春生武陵洞，病起曲江涛。\n日彩摇纨扇，天香袭锦袍。\n绝崖仍独上，谁似谢公豪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16248,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得花字","author":"胡应麟","text":"十里春山色，芳菲乱水涯。\n瑶池迷故迹，玉洞斗新葩。\n野豁千林雾，川明万树霞。\n不知刘阮辈，何事到仙家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16249,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题老蚌生珠图","author":"胡应麟","text":"几夜骊龙颔，偷携径寸游。\n芜城双月上，合浦一星流。\n影似悬鲛室，光疑发蜃楼。\n未须惭老蚌，照乘诧诸侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16250,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汪参军邀饮作","author":"胡应麟","text":"画拱摇丹日，雕阑驻彩云。\n榻延徐孺子，吟接鲍参军。\n午馔行山蕨，春羹荐野芹。\n醉归浑不解，萝月渐纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16251,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"休宁道中四首 其一","author":"胡应麟","text":"百里休宁道，肩舆度夕阳。\n川原明翠黛，阛阓斗红妆。\n玉佩时相亚，金钗尽作行。\n何方犊车至，夹路烂生光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16252,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"休宁道中四首 其二","author":"胡应麟","text":"拂曙征人起，苍云抱郭流。\n落红依小径，深绿涨平洲。\n竹色偏萦辇，松阴直过楼。\n天然对图画，底事唤营丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16253,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"休宁道中四首 其三","author":"胡应麟","text":"白堕家家酿，黄梁处处舂。\n飞泉悬薜荔，远岫削芙蓉。\n晚日前村旆，春烟隔寺钟。\n玄天看咫尺，紫气欲成龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16254,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"休宁道中四首 其四","author":"胡应麟","text":"望望山疑近，行行路转遥。\n依冈梅子熟，夹路豆香飘。\n翠幕萦朱户，红妆簇画桥。\n百钱犹挂杖，烂醉在今宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16255,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同汪士能入丰干路逢仲淹寄诗舆中口授用原韵","author":"胡应麟","text":"泠然遗俗累，曳杖到仙家。\n布帽扳名岳，荷衣弄太霞。\n吾宁驱白石，君已饭丹砂。\n纵有天台遇，能如萼绿华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16256,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阿四既留溪南士能命更呼刘生佐酒亦以事羁赋此嘲之","author":"胡应麟","text":"咫尺玄英宅，朱弦试一弹。\n中原留上驷，蓬岛隔飞鸾。\n酒压荼蘼瓮，春迟苜蓿盘。\n美人期不至，惆怅月华残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16257,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宜男堂为汪氏题","author":"胡应麟","text":"阶前植瑶草，芳色暮离离。\n艳入三姬座，香飞百子池。\n冰桃偕献实，玉树并生枝。\n旦夕佳男兆，华堂事事宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16258,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"槃楼","author":"胡应麟","text":"何年硕人住，结搆傍蒹葭。\n睨柱千山月，推窗万壑霞。\n青藜中垒阁，绿绮少文家。\n好著元龙卧，翛然世虑遐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16259,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠高深甫二首 其一","author":"胡应麟","text":"最忆高常侍，生平乐事饶。\n千金求騄駬，十院贮红绡。\n古迹留三代，新声和六朝。\n湖头明月满，无夜不吹箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16260,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]