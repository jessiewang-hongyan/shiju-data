[{"title":"谢欧阳御史送笔","author":"史谨","text":"蒙恬制作久尘埃，今日劳君远寄来。\n毫带风霜分玉兔，管含光彩出乌台。\n题诗忽有惊人句，草檄惭无倚马才。\n还与墨卿同箧贮，奎光夜夜烛三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48447,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀郭挥使","author":"史谨","text":"池上芙蓉尽著花，树头霜叶半成霞。\n此时遥想金台客，日倚阑干望翠华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48448,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长淮道中","author":"史谨","text":"独骑官马过长淮，满目青山日又斜。\n人在故乡终是客，鸟归深树却为家。\n牧童渡水还乘犊，芦叶吟风不当笳。\n行遍殊方今白首，未知何处是天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48449,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"环清楼","author":"史谨","text":"势接星河带远村，曲阑高栋净无氛。\n地邻瀛海三吴尽，水合玻璃四面分。\n鹓侣赋诗云际立，凤笙吹月座中闻。\n有时不欲钩帘坐，厌听渔歌唱夕曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48450,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"水云深处","author":"史谨","text":"一室如舟住水云，四边芦苇接苍旻。\n浑无田产供王赋，只有渔郎作故人。\n蘋汎晴光鸥卧雪，波涵秋影雁来宾。\n明朝去约乘槎叟，醉过柴门莫厌频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48451,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送蒋院判随驾赴京","author":"史谨","text":"出门马上气如云，笑拂征袍雨露新。\n家住龙潭连汉苑，身随鹤驾谒枫宸。\n羽林十万无虚士，驿路五千有故人。\n遥想朝回多暇日，黄金台上醉青春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48452,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪酒为金粟公赋","author":"史谨","text":"碧落无声散玉尘，片时盈尺拥篱根。\n扫归银瓮浑同色，酿出璚浆不见痕。\n陶谷谩劳烹活火，杜康未许恃专门。\n岂知祥瑞成狂药，偏称吾家老瓦盆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48453,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽鄱阳屈孺人","author":"史谨","text":"鹤发萧萧雪满肩，偶婴斯疾竟长捐。\n尘迷宝镜鸾无影，梦断瑶池骨已仙。\n薜荔帘栊添暝色，梧桐院落冷秋烟。\n老来愧我长为客，何日生刍置墓前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48454,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题鹌鹑图","author":"史谨","text":"饱食秋菰已倦飞，羽毛映日锦䙰褷。\n一生自信无常处，枸杞丛边却暂栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48455,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过东塘","author":"史谨","text":"两岸菰蒲长翠苗，一溪春水绿迢迢。\n晓来流出残红去，知是吴山雪尽消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48456,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"耕训堂","author":"史谨","text":"买田筑室傍清溪，夜诵朝耕不厌疲。\n耒耜方閒还就馆，子孙受业恐违时。\n居非陋巷心同乐，生作尧民志不移。\n醉后复乘黄犊去，满身山色自吟诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48457,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"友耕堂","author":"史谨","text":"屏迹西畴远避名，眼中世事羽毛轻。\n犁锄作伴无荣辱，仁义为途绝送迎。\n万叠好山牛背看，一蓑春雨陇头耕。\n有人荷钁来相访，不是严光即管宁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48458,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"慈乐堂","author":"史谨","text":"庭前萱草翠离离，堂上慈亲鹤发垂。\n花覆板舆春宴后，鹤迎苔砌晚游时。\n两行玉树冰霜洁，万朵蟠桃日月迟。\n见说飞仙来献寿，凤笙龙管隔云吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48459,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画","author":"史谨","text":"两岸云山列素屏，倚阑吟眺雪初晴。\n自知不应飞熊兆，野饭鱼羹过一生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48460,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题苏李泣别图","author":"史谨","text":"君持汉节晨登路，致使孤臣心独苦。\n愁云结恨晦天山，泪眼相看别河浒。\n共陷边尘十九年，君独南归享茅土。\n边风萧萧征马鸣，飞沙暝遏哀笳声。\n此去谁知是死别，臣心有恨终难明。\n徒怜埋骨塞云里，不得随君归汉庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48461,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题雪景","author":"史谨","text":"忆承仙诏出云林，马踏瑶花尺许深。\n蚁酒频从官舍饮，貂裘不畏苦寒侵。\n千章玉树为幢列，万里彤云接地阴。\n今卧衡门无一事，雪山相对雪盈簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48462,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题桂花鸲鹆","author":"史谨","text":"金粟吹香万木秋，露华凝叶翠云稠。\n家童不敢私攀折，知有寒皋在树头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48463,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题水仙花","author":"史谨","text":"冰为肌骨玉为容，时有天香散远风。\n欲就冯夷飧石髓，鸣珰声度月明中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48464,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"凝翠轩为丁子刚作","author":"史谨","text":"曲曲雕阑锁翠云，湘帘高捲四无邻。\n绿阴到座日当午，苍雪堕衣秋满身。\n风响佩环惊宿凤，地深苔藓绝香轮。\n老来袁粲思吟赏，直造何曾问主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48465,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿萱堂为陈公鼐赋","author":"史谨","text":"闻君裔出元龙后，家住毗陵岁云久。\n新筑高堂扁寿萱，种萱无数开当牖。\n花间献寿列璚筵，日照斑衣锦云覆。\n翡翠盘行阿母桃，水晶杯汎麻姑酒。\n慈颜有喜风生席，一片萱花共春色。\n试听诸孙祝眉寿，笑看蓟子摩铜狄。\n吴山对面天与高，越女停歌鹤同立。\n君家孝悌人间识，共保慈颜比金石。\n年年献寿向花间，回首椿庭泪沾臆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48466,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题柳塘双燕","author":"史谨","text":"杨柳阴阴水漫陂，柳花吹雪点乌衣。\n日长画栋营巢倦，故逐东风上下飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48467,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题梅竹聚禽图","author":"史谨","text":"成汤至德同天壤，复向郊原祝罗网。\n顿令禽鸟乐幽栖，嶰谷罗浮任来往。\n林梢雪霁层阴开，众鸟忽送春声来。\n云霄万里绝鹰隼，随意饮啄无惊猜。\n君不见陇山鹦鹉居深麓，误入虞罗见羁束。\n虽向雕笼置此身，丹荔金桃胜粱肉，不如尔辈花间宿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48468,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金陵八景 其一 钟阜朝云","author":"史谨","text":"山形高立翠芙蓉，岩际晴云万朵封。\n起映朝阳成五色，化为霖雨锁千峰。\n飞扬或乱松间鹤，舒卷长随洞底龙。\n欲访招提无处觅，数声惟听隔林钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48469,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金陵八景 其二 石城霁雪","author":"史谨","text":"石露苔痕雪渐晞，晨光相映晃朝衣。\n千章璚树为幢列，一路彤云映日飞。\n阵影度壕鸦散墨，女墙开冻玉生辉。\n忽乘瘦蹇寻梅过，多少人家尚掩扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48470,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金陵八景 其三 龙江夜雨","author":"史谨","text":"黑云拖雨过长汀，恍若骊珠散紫清。\n声到枕边惊蝶梦，风回蓬底带龙腥。\n渔灯隐隐孤村暗，芦叶萧萧两岸鸣。\n已觉夜深还淅沥，满怀羁思不堪听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48471,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金陵八景 其四 凤台秋月","author":"史谨","text":"万里无云月正中，倚阑人在广寒宫。\n数行雁落天边影，一曲笙传鹤背风。\n香拂几筵飘桂子，露含光彩滴梧桐。\n夜深转觉清无寐，卧看冰轮碾碧空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48472,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金陵八景 其五 天印樵歌","author":"史谨","text":"夹路青山拥翠螺，每闻樵唱隔烟萝。\n暗惊鹤梦穿云杪，细答松声出涧阿。\n几度半酣扶杖听，有时一曲傍林过。\n晚来弛担长松下，复和岩前扣角歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48473,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金陵八景 其六 秦淮渔笛","author":"史谨","text":"一汀红蓼缀残霞，两两渔舟泊浅沙。\n横笛共吹无调曲，隔林惊散并栖鸦。\n声回野岸沈蛟室，响拂江风起浪花。\n多少天涯未归客，夜深听罢却思家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48474,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金陵八景 其七 乌衣夕照","author":"史谨","text":"深巷迢迢接九垓，巷南巷北尽楼台。\n帘栊自放斜阳入，王谢难随燕子来。\n花斗春光云锦簇，山含暮景画图开。\n几番醉拂吟鞭过，树影重重压翠苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48475,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金陵八景 其八 白鹭春波","author":"史谨","text":"一江晴绿漾微波，顷刻平堤雨夜过。\n暖汎桃花随画鹢，倒涵树影拂银河。\n群鸥卧藻堆残雪，双鹭窥鱼立细莎。\n何日系舟杨柳岸，酒酣濯足听渔歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48476,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题范蠡归湖图","author":"史谨","text":"吴山嵯峨翠如洗，吴王宫殿空中起。\n凤管鸾笙到处闻，共说繁华世无比。\n前溪一夜越兵来，衔枚竞入姑苏台。\n西子含啼出宫掖，吴王抱恨埋蒿莱。\n一代奇勋归范蠡，片时雪尽夫椒耻。\n位重名高不受封，入湖自号䲭夷子。\n只缘乌喙难容物，致使将军就高洁。\n两岸青山画里看，数行白鹭烟中没。\n洞庭笠泽随所之，惯听渔笛鸥边吹。\n却怜文种不料事，乌喙之心终见疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48477,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题宣和竹上班鸠","author":"史谨","text":"忆傍龙楼唤雨时，羽毛映日锦䙰褷。\n忽惊艮岳烽烟起，来向淇园自在栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48478,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南浦渔舟","author":"史谨","text":"纵横如叶傍汀沙，谁识张骞海上槎。\n白鹭行边长作市，黄芦深处即为家。\n云迷短棹穿荷叶，笛弄西风起浪花。\n几度雨晴归晒网，鸳鸯浦口夕阳斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48479,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题史妇邹氏贞节卷","author":"史谨","text":"远逐良人出塞门，忽惊风雨暗乾坤。\n身加剑戟心弥壮，名重邱山死亦存。\n烈气晓冲青塞日，贞魂夜贯紫台云。\n我今抚卷题诗处，深愧明妃负汉恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48480,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山房独坐次韵","author":"史谨","text":"一身苦无蒂，两鬓霜华侵。\n大药虽可饵，筋力终难任。\n因之倦遨游，断此来去心。\n危坐见钟山，烟萝郁沈沈。\n草堂虽已矣，胜槩犹至今。\n对景沽浊醪，自酌还自斟。\n既非高阳徒，肯效庄舄吟。\n野菊散幽香，清风涤烦襟。\n日暮兴已阑，脱巾挂松阴。\n云端见飞鸟，东西各投林。\n微物尚有托，归途邈难寻。\n默然忽自怡，耳畔闻跫音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48481,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病起寓怀 其一","author":"史谨","text":"药裹方抛雪满簪，山房独坐昼沈沈。\n试尝腊蚁心先怯，欲扫松花力未禁。\n倚树閒看蝴蝶舞，思乡因听鹧鸪吟。\n兴来偶访邻翁去，桃李园林半绿阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48482,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病起寓怀 其二","author":"史谨","text":"瘦骨如松喜遇春，短筇扶我步苔茵。\n蓬门潇洒多车辙，义路荒芜少故人。\n树带烟霞添暝色，天留猿鹤伴閒身。\n临风自读囚山赋，非愧仪曹作外臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48483,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送羽士陆大年住院","author":"史谨","text":"华发萧萧物外身，南来住院不忧贫。\n池边咒剑伏龙虎，月下高歌泣鬼神。\n鸠杖独行山路远，氅衣初制鹤翎新。\n东邻喜有王摩诘，醉过琳宫不厌频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48484,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"写怀","author":"史谨","text":"四十馀年多病身，厌骑驽马踏红尘。\n明朝欲挂朝冠去，神武门前未许人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48485,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题湖山佳处卷","author":"史谨","text":"斯跋先生水心裔，宅近青山傍湖水。\n无边胜槩自天成，一览浑如画屏里。\n涧畔松留野鹤栖，座中人看孤云起。\n或逢邻叟来同席，聊共逍遥不拘礼。\n就吹长笛和樵歌，复钓游鳞换春蚁。\n闲来自倚阑干立，山簇芙蓉绕湖碧。\n虎啸猿吟隔薜萝，渔村野店依芦荻。\n我忆曾来借凫舄，水北山南恣游历。\n白鹭和鸥渚上飞，翠岚带雨林梢滴。\n莫谓桃源可避秦，此中便有仙凡隔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48486,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柳庄为朱德辰赋","author":"史谨","text":"数株婀娜拂云青，一室萧然远利名。\n人物俨如陶令宅，风光不是亚夫营。\n暖烟夹道清明近，香雪飞空谷雨晴。\n何日杖藜容直造，为君沽酒听新莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48487,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送朱广文之京","author":"史谨","text":"花落江堤燕子还，又携行李上长安。\n关藏杨柳闻鸡度，山簇芙蓉立马看。\n已有清风留绛帐，岂无长荣对金銮。\n他年恐应三鳣兆，不向黉宫老一官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48488,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送主事张声伯之京","author":"史谨","text":"离歌唱罢上吴船，行李萧萧只旧毡。\n已拜秋官经十载，复登云路远三千。\n莺啼御苑花迎佩，马度深河柳拂鞭。\n遥想朝回无事日，壮怀应赋远游篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48489,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题江湖胜览图","author":"史谨","text":"终身未肯老菟裘，远挟长才历九州。\n行李独携欧冶剑，壮怀应作马迁游。\n南经禹穴凌天姥，北上邯郸入帝丘。\n胜水名山俱览毕，白头慈母望归舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48490,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄思闇吴相公","author":"史谨","text":"气吐虹霓两鬓皤，远临钟阜驻鸣珂。\n霜飞绣斧豺狼息，天近乌台雨露多。\n自有丹心扶日月，已无清梦入烟萝。\n几番山岳曾摇动，因向都亭揽辔过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48491,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画","author":"史谨","text":"空山云湿有龙气，绝壁春深无鸟啼。\n采药欲寻刘阮去，桃花风度白沙溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48492,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山斋寓意","author":"史谨","text":"幽轩俯碧涧，潇洒异风俗。\n门巷绝轮鞅，庭除带松菊。\n虽云世虑远，委弃同草木。\n腊社会高年，晨昏课童仆。\n谬蒙朝士荐，被此微名缚。\n自惭樗散才，束带事简牍。\n一朝念归旋，挥手谢鸿鹄。\n万事忽若遗，忻然恣游瞩。\n烟霞不改色，流水清可濯。\n贵贱只如此，长歌候樵牧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48493,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题雪景","author":"史谨","text":"六出深封行路难，朝来人迹断空山。\n野船才到寒汀下，疑是前溪访戴还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48494,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"狂叟","author":"史谨","text":"或谈势利或谈玄，一串摩尼领上悬。\n口不茹荤缘信佛，心多怀诈默欺天。\n市廛自负居三世，论孟何曾读半篇。\n翻笑二疏无见识，去辞官禄守林泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48495,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈公子之蜀省墓","author":"史谨","text":"君今祭扫向岷峨，万里还从鸟道过。\n墓入松楸微有路，人逢故旧已无多。\n东风草色迷翁仲，落日猿声出薜萝。\n应念椿庭垂白久，锦城虽好莫蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48496,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春述怀","author":"史谨","text":"老来筋力怕逢迎，閒倚东风玩物情。\n十载虚名蝴蝶梦，一春客况子规声。\n周游自信神为马，养拙何妨笔代耕。\n却笑扬雄甘寂寞，校书天禄勉偷生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48497,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早春登楼次金文鼎韵","author":"史谨","text":"历尽崎岖鬓已斑，夕阳楼上倚层阑。\n关心尚怯瞿唐险，出路休歌蜀道难。\n竹本龙钟犹傲雪，柳能媚妩不禁寒。\n只今四海升平日，何待区区上治安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48498,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四景为主事司叔端赋 其一 黉舍穷经","author":"史谨","text":"身寄黉宫岁月深，六经奥旨足搜寻。\n曾闻太乙燃藜夜，因识先生苦用心。\n耳目渐知霄汉近，头颅未受雪霜侵。\n明年拟谒金銮去，仙桂飘香满上林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48499,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四景为主事司叔端赋 其二 蟾宫折桂","author":"史谨","text":"十载寒窗业已成，远携书剑入蓬瀛。\n一枝丹桂鳌头折，万里青云足下生。\n壮志不随秋色老，恩袍遥映日华明。\n郤诜去后无消息，君复当居第一名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48500,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四景为主事司叔端赋 其三 银台观政","author":"史谨","text":"夜亲灯火究遗经，朝列台端近上卿。\n岂惜勤劳观异政，要成功业化苍生。\n声名渐觉如山重，怀抱从来似水清。\n他日定随鹓鹭去，五云深处沐恩荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48501,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四景为主事司叔端赋 其四 粉署含章","author":"史谨","text":"男子从来志四方，胸含至德已成章。\n昔年曾览银台政，今日应为粉署郎。\n剑在丰城终变化，珠藏合浦自辉光。\n一朝养就凌霄翮，伫看飞腾入庙廊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48502,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送苏秀才还吴","author":"史谨","text":"万木霜馀叶尽殷，敝裘季子又思还。\n长亭草色东西堠，落日猿声远近山。\n琴瑟旧曾居爨下，骅骝终见入天闲。\n到家已觉春闱近，黄卷青灯莫放閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48503,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梅月轩","author":"史谨","text":"轩前种梅梅已高，花下玩月枝相交。\n瘦蛟擎珠出海底，寒蝶倦舞栖林梢。\n谁邀姑射下蓬岛，我跨蟾蜍吹凤匏。\n醉吟香影不成寐，老鹤一声鸣九皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48504,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题朱德辰蔗境东还卷","author":"史谨","text":"匹马嘶寒出凤池，好山处处碧相随。\n暮年喜遇还乡日，佳境浑同啖蔗时。\n已应虎头千载语，安愁鹤发满肩垂。\n望中渐觉先茔近，行李无端莫放迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48505,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宴王将军宅","author":"史谨","text":"甲第俯南郊，将军屡见招。\n地连吴分野，人似汉嫖姚。\n岭树红相合，庭松翠不凋。\n兴来移席饮，踏月夜吹箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48506,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春晖堂","author":"史谨","text":"旸谷云关曙色浓，苍苍初日映帘栊。\n暖升寥廓春无际，花压阑干影万重。\n喜奉慈帏荣暮景，还凭大药驻衰容。\n登堂此日来称寿，愿比虞山第一峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48507,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游翠微寺","author":"史谨","text":"身老难拘束，间过祇树林。\n鹿当春草卧，猿抱夕阳吟。\n云气生禅榻，松风遏梵音。\n一僧才坐定，门外落花深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48508,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和谢同知九日陪铁史宴湖亭","author":"史谨","text":"会稽铁史谪仙才，共宴湖亭菊正开。\n远水接天飞白雁，好山倒影落金杯。\n已同谢朓题诗毕，不见王弘送酒来。\n犹忆去年沈醉后，铁龙吹上越王台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48509,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]