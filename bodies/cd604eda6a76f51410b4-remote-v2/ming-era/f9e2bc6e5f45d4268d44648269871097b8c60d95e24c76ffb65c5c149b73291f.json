ommit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":44073,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题集唐句十首 其四","author":"童轩","text":"粉霞红绶藕丝裙，倏忽还随灵雨分。\n一自高唐赋成后，梦来何处更为云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":44074,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题集唐句十首 其五","author":"童轩","text":"浔阳向上不通潮，却算游程岁月遥。\n明月断断清霭霭，玉人何处教吹箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":44075,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题集唐句十首 其六","author":"童轩","text":"南陌愁为落叶分，阴蛩切切不堪闻。\n晚来风起花如雪，忽到窗前疑是君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":44076,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题集唐句十首 其七","author":"童轩","text":"愁心一倍长离忧，红树青山水急流。\n门外晚晴秋色老，不堪吟倚夕阳楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":44077,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题集唐句十首 其八","author":"童轩","text":"真成薄命久寻思，野寺寻花春已迟。\n何处相思不相见，九疑云尽绿参差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":44078,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题集唐句十首 其九","author":"童轩","text":"与君相见不相亲，脉脉无言几度春。\n别恨转深何处写，晚来幽独恐伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":44079,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题集唐句十首 其十","author":"童轩","text":"愁听寒螀泪湿衣，嗟君此别意何如。\n相思莫道无来使，双鲤迢迢一纸书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":44080,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谪官后咏怀一首","author":"童轩","text":"逐队随行二十春，世情谁是旧雷陈。\n长疑好事皆虚事，不薄今人爱古人。\n苔色满墙思故第，江潭何处是通津。\n分明记得还家梦，依旧红霞作近邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":44081,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"予按石屏州学偶染瘴疠遂舆至临安公馆药之稍愈因集唐人之句聊以自遣云","author":"童轩","text":"病多慵引架书看，老去悲秋强自宽。\n文轨尽同尧历象，蛮方今有汉衣冠。\n黄花浥露开江岸，山鸟将雏傍药阑。\n惭愧流年筋力少，不如高卧且加餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":44082,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题尚朴翁卷","author":"徐溥","text":"太古云已远，斯人独返淳。\n有书閒白日，无梦落红尘。\n鸟迹平沙晚，花香小径春。\n澹然保终始，不愧葛天民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":44083,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菊庄为蒋翁题","author":"徐溥","text":"有地惟栽菊，无心种百花。\n泉香儗甘谷，径僻是陶家。\n但得客常醉，何妨酒屡赊。\n物情与人意，相对乐年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":44084,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"终慕为王廷瑞题","author":"徐溥","text":"椿萱凋谢久，孤子独遐思。\n宰木乌啼夜，空庭月落时。\n寻常来梦寐，彷佛见容仪。\n无限伤心事，相看泪亦随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":44085,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"风木卷为侍御父题","author":"徐溥","text":"赞政居莲幕，承恩进柏台。\n竟违三釜养，徒抱百年哀。\n古树庭中植，凉风天际来。\n飘萧殊未歇，虚枕梦初回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":44086,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"归乐堂","author":"徐溥","text":"十年游上国，此日赋归欤。\n倦却风尘路，来寻水竹居。\n山行春载酒，门掩昼翻书。\n薄暮投林鸟，相看意自如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":44087,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]