[{"title":"观上虞谢进士读书山房图","author":"欧大任","text":"东山君早出，人忆著书年。\n竹牖飘晴叶，松门起夕烟。\n经声秋瀑下，笔札白云边。\n久系苍生望，深知谢傅贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5361,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠张仲实还山","author":"欧大任","text":"曾闻飞遁日，石上卧江烟。\n芝术君何弃，藤萝我最怜。\n几时沧海钓，一问赤松年。\n归去看云起，青苔诵古篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5362,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋夜过曾以三缮部得尊字","author":"欧大任","text":"凉色爱清尊，银鞍夜到门。\n知予思露掌，为客扫风轩。\n满目时人态，平生国士恩。\n片心秋月下，微尔共谁论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5363,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮秋过饮戴氏西园","author":"欧大任","text":"羸马青门路，君家数往还。\n亭留白云曲，城倚太行山。\n残菊寒犹摘，霜梨醉可攀。\n山阳灌园日，谁共吕安閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5364,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈郑州敬甫兼寄张判官","author":"欧大任","text":"词人多出牧，州郡岂徒劳。\n汉主分符竹，王郎揖佩刀。\n楼前中岳树，雪后大河涛。\n知授梁园简，应邀谢法曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5365,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘山人子脩归真州","author":"欧大任","text":"三年蓟门客，分手秋风时。\n旅食金同尽，生涯剑独知。\n柴荆归更掩，猿鹤隐何疑。\n我识江头路，寻君定有期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5366,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀苏子冲","author":"欧大任","text":"闻道辟疆园，蓬蒿积短垣。\n诗篇传海岳，剑术老乾坤。\n判袂燕台侧，题书濮水原。\n相思日南北，吾亦别金门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5367,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄苏子长","author":"欧大任","text":"季子貂裘在，何年作隐沦。\n金扉曾谢禄，瑶草足娱亲。\n林似听莺日，山疑卧虎春。\n悠悠濮台水，今见钓鱼人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5368,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄苏子新","author":"欧大任","text":"敬客知公子，通家托长兄。\n早传梅石赋，不负竹林情。\n开径期羊仲，淩云羡马卿。\n思君若河水，何以到鄄城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5369,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雷比部携酒同古比部夜过得何字","author":"欧大任","text":"寂寞无奇字，其如载酒何。\n秋辞三署直，夜向五陵过。\n玉笛吹花早，银床坠叶多。\n他宵明月下，荒径忆鸣珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5370,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"子与将之瑞州予亦南行寄此为别","author":"欧大任","text":"量移劳圣主，尺组不须论。\n山雪思君曲，江枫去国恩。\n孤村通栗里，三谷近麻源。\n独有天涯客，扁舟夜听猿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5371,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬张山人英甫","author":"欧大任","text":"蓟北逢君日，名山忆永嘉。\n綵毫新赋颂，铁研老生涯。\n酒伴灵台月，心期雁荡霞。\n谁堪关路别，惆怅五陵花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5372,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题张仲素玄玉斋","author":"欧大任","text":"高斋弦诵日，鸣佩更珊珊。\n江泻瑶池色，窗摇玉树寒。\n何来沧水使，将献白云坛。\n牛斗千山外，晴虹几度看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5373,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送董山人述夫归阳羡别业","author":"欧大任","text":"远游因好道，能诵五千文。\n帽湿双林雨，衣披十岳云。\n江湖犹作客，猿鹤正思君。\n归去张公洞，秋天长啸闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5374,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九月十五夜月","author":"欧大任","text":"瑶草三秋色，金风一夕寒。\n书缘多难绝，月在异乡看。\n凄断惊霜角，迟回望露盘。\n刀头今未定，谁最忆长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5375,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张户部伯邻宅同郭仪部方尚宝夜集","author":"欧大任","text":"菊觞宁厌数，骑马屡过门。\n结客多同舍，看花似故园。\n月高燕市路，砧近汉宫垣。\n不有中郎酒，谁堪秋思繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5376,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚过许维桢王绍传二内翰院署对酒言别","author":"欧大任","text":"玉署能迎客，高天近九重。\n白云随匹马，紫气护双龙。\n洒袂西山雪，持觞北禁钟。\n周南他日路，思尔扈登封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5377,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"景州谒董子祠","author":"欧大任","text":"广川晴雪后，驻马董生祠。\n帷在知曾下，园荒似不窥。\n疏林堕残叶，枯柳宿寒鸱。\n老作江都客，传经愧我师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5378,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阙里观先师所植桧","author":"欧大任","text":"尚见参天起，今思翠黛长。\n岁华周日月，春色鲁宫墙。\n柏岂存新甫，桐虚表峄阳。\n独馀嘉树在，海岱接扶桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5379,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒颜庙","author":"欧大任","text":"睎颜曾想像，入室见琴书。\n洙泗为邻并，箪瓢恒晏如。\n山庭仍陋巷，井里半荒墟。\n目送浮云过，因知乐有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5380,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒孟庙","author":"欧大任","text":"世岂居邹日，三迁有故宫。\n龟蒙曾蔽鲁，凫峄只荒东。\n客礼兼金外，家祠五鼎中。\n玄圭同禹力，谁颂决河功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5381,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"枫香驿楼夜雪","author":"欧大任","text":"白马枫香下，青春粉荔前。\n雪凝千涧水，风荡万家烟。\n卯酒官亭路，辛盘旅食年。\n故人传尺素，为枉济江篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5382,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春日匡庐山中","author":"欧大任","text":"两见青丝菜，五年今复游。\n客从庐岳下，僧候虎溪头。\n春转双林色，冰开众壑流。\n天池飞梦到，宁待拂衣秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5383,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"经濂溪先生故居","author":"欧大任","text":"斯人不可作，绝学已千年。\n湓浦庭皆草，匡庐岳是莲。\n霜凋前代树，月霁一林烟。\n犹有图书在，风琴自洒然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5384,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同介上人寻广福观遇刘道士","author":"欧大任","text":"高赏云霞侣，欣然巾我车。\n法师不嗜酒，道士本能书。\n炉耸紫烟际，经残丹笈馀。\n虎溪还一笑，忘却在匡庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5385,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"青居馆读江州故守朱子价碑","author":"欧大任","text":"谢公文可读，山馆不荒芜。\n星堕炉峰顶，珠沉甓社湖。\n虎符丹旐远，龟碣白云孤。\n千载匡君传，能留姓字无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5386,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"圆通寺","author":"欧大任","text":"山有古祇林，开堂石耳阴。\n岳云当涧落，径树向门深。\n雪磴僧支策，风泉客掩琴。\n西亭茶灶在，即此长禅心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5387,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕玉峡过吉水与黎比部饮舟中","author":"欧大任","text":"雪浪开千里，仙槎偶共乘。\n江亭深夜酒，水市满船灯。\n笛里听金缕，帆前望玉绳。\n明年花月夕，还约醉兰陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5388,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"安远驿下送别叶男兆宰福清","author":"欧大任","text":"天边叶县令，何日别皇畿。\n驿树迎官舫，江云映彩衣。\n辱楼沧海近，雁字晋安稀。\n期尔陪仙仗，双凫正北飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5389,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清远道中答胡佥宪","author":"欧大任","text":"结束事行役，风霜易白头。\n望乡同海雁，浪迹似沙鸥。\n岐路频搔首，江山一倚楼。\n欲裁王粲赋，幸托李膺舟。\n北上初辞粤，西归已梦周。\n本非游说客，空愧黑貂裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5390,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒少司寇梅国刘公祠","author":"欧大任","text":"丁年予度岭，公已蚤归休。\n旅馆回光盻，林园表宴游。\n每闻诸士论，实许五臣流。\n富国卑为晏，精忠更是刘。\n深衷劳奏疏，雅量镇沉浮。\n献纳趋宸扆，班司近冕旒。\n不鸣羞仗马，遂去伴江鸥。\n田宅贫萧相，朝廷老沈侯。\n蒲轮将下日，梁木已先秋。\n伏腊村翁走，碑铭太史留。\n何人哀北海，有客哭西州。\n寂寞祠前路，空瞻庾岭头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5391,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过汤阴谒岳忠武庙","author":"欧大任","text":"遥指汤阴路，西寻鄂国居。\n行云犹惨淡，征马尽踌躇。\n逆虏兵曾炽，中原愤未除。\n旄头南落日，鼓角北征馀。\n谋国奸先蠹，和戎策已疏。\n黄龙期痛饮，丹诏促归与。\n草染苌弘血，霜飞乐毅书。\n皇天不可问，烈士竟何如。\n力尽朱仙镇，魂随二帝车。\n山河留壮气，不敢泣欷歔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5392,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夕约卿元白惟敬同集小斋闻新雁得年字","author":"欧大任","text":"秋风万里至，一雁过长天。\n嘹唳胡笳里，凄凉塞笛前。\n庭空飘落叶，家远梦江船。\n声急零霜夕，书迟度岭年。\n罗浮归未得，沧海到应先。\n楚客谁同听，西楼片月悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5393,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春夜同惟敬约卿集寿承学舍时休承将之吉水在坐同赋得寒字","author":"欧大任","text":"庭阶仍系马，献岁聚长安。\n甲子新周朔，申公老汉冠。\n共推经术最，其奈鬓丝残。\n学馆荣三绝，儒林合二难。\n兴来题棐几，酒至出辛盘。\n墨竹烟光动，鱼灯海色寒。\n粤人千里思，楚客几回看。\n凤掖怜分袂，螺洲忆采兰。\n雪消梅粉路，月满杏花坛。\n他日江湖上，方知此夕欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5394,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春雪后同杨徐沈舒四子集诸太史宅","author":"欧大任","text":"西山残雪在，返照万家明。\n汉署宾初集，梁园赋欲成。\n门摇金马色，树走玉龙声。\n暗溜还凝水，疏帘尚积霙。\n花轻含冷萼，草细折冰茎。\n寒枥仍留骑，深更不算觥。\n璚楼惊曙雁，银阙听新莺。\n纪瑞词臣颂，祈灵圣主情。\n白云停绝唱，黄竹念苍生。\n紬史书年异，看君继二京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5395,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吕参军幼开出守寻甸","author":"欧大任","text":"儒林推父子，世德重箕裘。\n家出关西学，才参幕下筹。\n符分铜虎去，使得碧鸡游。\n行矣驰滇国，先应梦益州。\n僰僮迎汉吏，泸帅识姜侯。\n万里题诗日，千山羽猎秋。\n青蛉通北望，黑水入西流。\n赐召君来速，归期看拥驺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5396,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送秦侍御赴浙江佥宪","author":"欧大任","text":"早岁成辞赋，君王诵子虚。\n自簪前殿笔，岂是茂陵居。\n使以观风出，名因抗疏馀。\n外台仍衣豸，南国便羹鱼。\n道路秦人策，江湖越绝书。\n行歌听榜枻，问士过桐庐。\n海色长鲸截，霜威落雁疏。\n衔恩归有日，把袂意何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5397,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孙鸿胪席上咏樱桃得绡字","author":"欧大任","text":"珍果来何处，炎风万里遥。\n莺含分露颗，雀啄落星条。\n映席霞飞槛，开笼绛满绡。\n瑛盘行寝庙，玉食及臣僚。\n近侍初休沐，新题偶见邀。\n青冥沾赐日，同荷圣明朝、","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5398,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日同周象贤沈道桢游白云观","author":"欧大任","text":"燕九人能往，斯游我自偏。\n长廊频落叶，匹马独闻蝉。\n鸡犬驱何日，烟霞似昔年。\n泉凝丹井月，门锁白云天。\n法磬鸣霜后，经函散石边。\n宁劳东海上，即此候神仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5399,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王太史元驭奉使册封赵藩","author":"欧大任","text":"东观词臣出，西藩旧邸开。\n占星随玉节，赋雪上铜台。\n庭揖诸侯客，园游七子才。\n虎盐门下献，牛酒里中来。\n赵璧无劳赠，吴涛更有裁。\n圣明思侍从，莫遣隔年回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5400,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出京师留别张郎中鸿与梁助教彦国十二韵","author":"欧大任","text":"朔风吹万里，曾共忆江乡。\n雁引归心早，砧惊客梦长。\n忽随公府牒，频举故人觞。\n夙昔诸生后，周旋二子傍。\n四门推助教，三署表中郎。\n韦杜衣冠并，邹枚侍从良。\n出关怜马首，执戟羡鹓行。\n雪后宫云白，天边苑树苍。\n眇予怀魏阙，看尔在岩廊。\n晨佩趋长乐，宵钟听未央。\n梅花庾岭色，柏叶禁庭香。\n莫以相如赋，从容奏汉皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5401,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"发华节亭过灵洲至三水与钧谟猷三弟别","author":"欧大任","text":"片帆已过郁洲台，风急惊沙落雁哀。\n万里独怜难判袂，三江犹得共衔杯。\n西陵涛起思康乐，南国书归念大雷。\n弟妹分岐贫更苦，客轺今去几时回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5402,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过韶州宿芙蓉驿","author":"欧大任","text":"峡过浈阳尽始兴，旧游名胜记吾曾。\n霜天雁字孤城月，水驿滩声一夜灯。\n泷口刺船愁问吏，曹溪飞锡欲寻僧。\n夷犹更进芙蓉棹，韶石峰头望舜陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5403,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同胡佥宪登云封寺观音阁玩梅花","author":"欧大任","text":"岭开孤阁倚巑岏，携手高临百八盘。\n山畔幽香移般若，天边残雪落旃檀。\n春催远客兼程早，驿报长安一骑寒。\n十载江南谁把玩，北枝今日正宜看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5404,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"淦口望胡佥宪舟不至先赴金川驿相待","author":"欧大任","text":"江树寒深独鸟依，邮亭回首叹蓬飞。\n湓峰雁去冲残雪，渝水帆来带落晖。\n日短山城收市早，风高溪寺听钟微。\n瑶琴玉涧今何处，水远天长客未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5405,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪后渡淦水至萧水寄潘少承","author":"欧大任","text":"风前淦口叹飘零，雪后潇滩更杳冥。\n问驿尚知黄蘖馆，渡江还向渌波亭。\n异乡只见山云白，故国应多海树青。\n此际想君开阁望，计程时一展图经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5406,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中趋陆过瑞州","author":"欧大任","text":"朔风驱马听晨鸡，路入筠州晚色迷。\n小洞雪封梅树外，飞霞寒挂竹林西。\n自怜残腊犹奔走，长忆他乡尚鼓鼙。\n问讯谢公歌舞处，万峰零雨一猿啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5407,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大雪宿建昌早行过德安","author":"欧大任","text":"白云千里上巑岏，石耳香炉雪未乾。\n身到昆丘群玉府，梦游天女散花坛。\n闭关岂合长高卧，跨马偏宜半醉看。\n渐过楚乡仍北望，瑶台琼阙是长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5408,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪夜同胡伯贤宿东林寺","author":"欧大任","text":"山僧留客解征鞍，虎笑溪桥鹤绕坛。\n两寺疏钟云壑暝，万峰积雪石门寒。\n夜深窗竹惊频折，腊尽溪梅落未残。\n却望屏风飞瀑下，何时还共醉中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5409,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓过西林寺","author":"欧大任","text":"峰头雪霁日初升，扶策西林问上乘。\n高阁残经千劫火，空山孤塔几传灯。\n青莲旧迹谁为主，白鹿曾游不记僧。\n笑忆柴桑犹强出，十年心寄白云层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5410,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春三日浔阳渡江过黄梅","author":"欧大任","text":"匹马来看云锦屏，东风湓浦又扬舲。\n九江涛涌帆前白，五老峰横雪后青。\n鸿雁春归书未至，鱼龙天阔酒初醒。\n苍茫已向匡君别，瀑布香炉绕驿亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5411,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日由蕲水过黄州长堤四十里马上晴望","author":"欧大任","text":"蕲春城在楚云间，策马冲寒问五关。\n积雪消时浠水树，乱峰明处汝州山。\n石头古渡孤舟急，樊口疏钟一鸟还。\n记取天涯过人日，莫愁双鬓易成班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5412,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寻东坡雪堂遂过赤壁矶下","author":"欧大任","text":"钱唐为守最风流，谁遣临皋咏四愁。\n两赋云霞留赤壁，五年烟月醉黄州。\n沙湖已决求田计，樊口曾来把钓游。\n莫向雪堂歌九辩，江山萧瑟白云秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5413,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄州遇袁履善比部时量移郡丞","author":"欧大任","text":"天涯把袂问何之，海内才名识汝迟。\n此地更留苏氏赋，何人不诵谢公诗。\n豫章一榻将悬日，洛下扁舟欲去时。\n圣主似闻前席待，蓟门烟柳忆归期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5414,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白杲镇冒雪趋麻城寄袁履善","author":"欧大任","text":"万树官梅照酒杯，为谁千里雪中来。\n貂裘零乱飞花坠，马足淩兢踣铁开。\n草埠河将成玉渚，木陵山已作瑶台。\n却忆郡斋袁夏甫，青绫深拥散衙回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5415,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过官渡河入光山","author":"欧大任","text":"候晓津亭驿骑多，中原道路此经过。\n镇淮楼影临官渡，浮弋山光带寨河。\n白氎尚存京洛俗，青翰空忆越人歌。\n北风吹雪千馀里，零乱貂裘奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5416,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过汝南访徐子与使君","author":"欧大任","text":"望气寻君汝邓来，乘春冰雪马前开。\n周璆谬忝斋中客，徐干今推邺下才。\n坐啸试临桐柏水，倚歌还上景夷台。\n长安西去谁知己，乞取金龟醉几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5417,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"徐子与春日表台宴集得春字","author":"欧大任","text":"客来十日饮河滨，淮蔡城边气色新。\n把袂未消千里雪，开尊先散万家春。\n嵩山杳霭连王屋，洛水萦回带孟津。\n百尺高台君试望，中原鞭弭更何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5418,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒大复先生祠堂","author":"欧大任","text":"贤隐山前宿草烟，祠堂今筑表台边。\n伏生不待传经岁，贾谊空伤作赋年。\n客望函关仍紫气，书藏嵩岳并青天。\n从游载酒嗟予晚，门下何人受太玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5419,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登汝南城楼","author":"欧大任","text":"将军白马旧临关，楼橹中原战守闲。\n汝曲自成悬瓠水，淮南遥见朗陵山。\n雁鸿早向春风过，鹅鸭偏惊夜雪还。\n陈蔡北来今重镇，戍笳声在乱云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5420,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郑州客舍怀故园诸子","author":"欧大任","text":"候馆萧条一骑过，黑貂风雪意如何。\n长堤日落行人少，远树天寒宿鸟多。\n仆射陂前京北路，武疆城畔楚西歌。\n春来纵有停云句，双鲤那因到汴河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5421,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郑州登楼望中岳","author":"欧大任","text":"名岳岧峣接上台，毓祥今有中兴才。\n云扶二室天边出，日映三花雪后开。\n周典尚馀巡狩迹，汉家新筑集灵台。\n太平不复论封禅，时听嵩呼万岁来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5422,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]