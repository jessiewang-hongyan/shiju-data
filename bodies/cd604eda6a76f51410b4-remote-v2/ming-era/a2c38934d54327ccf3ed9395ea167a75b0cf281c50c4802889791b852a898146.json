[{"title":"登仲宣楼","author":"边贡","text":"蜀吴舟楫槛前经，万里乡心杳不扃。\n莫问兴亡异时事，满川斜日下空庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18450,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"观城歌七首 其一","author":"边贡","text":"朱旗绣斧两昭回，南郡城池亦壮哉。\n明月楼中堪坐啸，关山何处有尘埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18451,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"观城歌七首 其二","author":"边贡","text":"睥睨连云十二楼，西南形胜数荆州。\n已教岘首为屏绕，更遣巴江作带流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18452,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"观城歌七首 其三","author":"边贡","text":"江日曈曈散晓鸦，湖田漠漠隐桑麻。\n中丞本是阳春脚，散得东风与万家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18453,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"观城歌七首 其四","author":"边贡","text":"城廓周回十里通，遥从城上见城中。\n不知多少王孙第，万户楼台一半红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18454,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"观城歌七首 其五","author":"边贡","text":"古堰迢迢枕郭门，城南城北万家村。\n行人共指丰年兆，雪里青青见麦痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18455,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"观城歌七首 其六","author":"边贡","text":"大北门西掷甲山，山头古庙草斑斑。\n中丞驻马看遗像，认得将军旧姓关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18456,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"观城歌七首 其七","author":"边贡","text":"百雉城头小队行，下闻闾里动欢声。\n防边不在多戎马，只有人心是甲兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18457,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题贾园四首 其一","author":"边贡","text":"泺水桥西一亩宫，小窗春度碧荷风。\n老夫野性无拘束，便欲移家向此中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18458,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题贾园四首 其二","author":"边贡","text":"门巷沈沈草径纡，绿槐深护野人居。\n鸟声不断日亭午，时有小童来捕鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18459,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题贾园四首 其三","author":"边贡","text":"树绕园亭水漫池，西溪风物最宜诗。\n即教痛饮成深醉，莫遣空悬别后思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18460,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题贾园四首 其四","author":"边贡","text":"靡靡菰蒲傍水涯，粼粼白石映青鞋。\n今年欲此消长夏，合扁君堂作我斋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18461,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟行近沧洲","author":"边贡","text":"白云渺渺水悠悠，两岸芦花覆钓舟。\n年少自知官绂在，寻常不敢问沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18462,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖上杂兴四首 其一","author":"边贡","text":"云水地临三宪节，江湖天放一渔舟。\n虚烦倚树看黄帽，耐可乘槎漾碧流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18463,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖上杂兴四首 其二","author":"边贡","text":"漾漾莲舟系古槎，沈沈波影照乌纱。\n多情最喜台中客，乘兴能看水际花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18464,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖上杂兴四首 其三","author":"边贡","text":"水岸风回晚更凉，菰蒲零乱拂衣裳。\n扁舟莫到花深处，恐碍波心片月光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18465,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖上杂兴四首 其四","author":"边贡","text":"万竹阴阴暑气微，主人迎客敞山扉。\n翻愁使节传呼近，惊起舟前白鹭飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18466,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"昌平废县","author":"边贡","text":"层阿回眺独行行，日落春山烟雾生。\n山下荒城隐丛薄，路人云是古昌平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18467,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山行即事二首 其一","author":"边贡","text":"山径春深满绿苔，景陵东去转萦回。\n忽逢樵父惊相问，言自黄花镇里来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18468,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草场","author":"边贡","text":"牧马场边苜蓿香，回龙宫外树苍苍。\n当年骏骨今何处，曾被金鞍侍武皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18469,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柳塘杂兴四首 其一","author":"边贡","text":"汲水浇花柳贯鱼，草堂巢燕暮春馀。\n要知开径诛茅意，不为浓阴好读书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18470,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柳塘杂兴四首 其二","author":"边贡","text":"御沟东畔柳成林，御水盈盈十里阴。\n白马青衫桥上客，春来多少故园心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18471,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柳塘杂兴四首 其三","author":"边贡","text":"琴台书榭绿阴深，杖履时时隔水寻。\n閒过永明湖上看，几家桃李自成阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18472,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柳塘杂兴四首 其四","author":"边贡","text":"塘烟漠漠水迢迢，摇荡春风几万条。\n不傍御园歌舞地，只愁宫女妒纤腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18473,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泰山回马岭","author":"边贡","text":"回马岭前春日西，涧花岩树郁萋萋。\n上方钟落不知处，惟见白云岩畔栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18474,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"贞女祠","author":"边贡","text":"长城在秦那在齐，齐山古寺春草萋。\n千载哭夫能变俗，至今犹说杞梁妻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18475,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鹿门山","author":"边贡","text":"庞公旧隐鹿门山，近在襄城汉水间。\n石洞草荒无路入，夕阳时见鸟飞还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18476,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"习池","author":"边贡","text":"习家池上草萋萋，流水成渠稻作畦。\n山简不来游客散，居人犹唱白铜鞮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18477,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"岘山","author":"边贡","text":"大树萧萧白日寒，羊公祠下独凭栏。\n寻常一种青山石，长使行人洒泪看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18478,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"望岳亭为王生作时其父戍云中 其一","author":"边贡","text":"东岳名高四海间，此山之外更无山。\n何时倚杖青云上，与尔朝登复暮攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18479,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"望岳亭为王生作时其父戍云中 其二","author":"边贡","text":"望岳亭临河水隈，碧窗遥对孔林开。\n谁知仰止平生意，不为岩岩气象来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18480,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"望岳亭为王生作时其父戍云中 其三","author":"边贡","text":"岱宗西与太行临，岚翠霏微晓不分。\n底是灵州狄刺史，不看岩障只看云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18481,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汴上题吴国宾园林","author":"边贡","text":"沙海原南古战场，曲池荒畎荫堤长。\n相逢折得芙蕖赠，莫向西风笑冷香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18482,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"大堤","author":"边贡","text":"大堤女儿花见羞，大堤杨柳映青楼。\n金壶满注樊城酒，醉杀狂夫不解愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18483,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梨云轩独坐有怀","author":"边贡","text":"睡起僧房日未斜，兴来随处即为家。\n美人不见幽期渺，閒对苍黄数落花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18484,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"楝塘歌","author":"边贡","text":"楝塘老人塘上游，飒飒西风吹素秋。\n记得看花三四月，满塘红紫映波流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18485,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"姚园次亭溪韵","author":"边贡","text":"竹坞柴关破晓开，石池花径转萦回。\n春深漫有寻芳兴，老近惭非作赋才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18486,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"散步","author":"边贡","text":"零零宵露湿春堤，杨柳风清晓月低。\n童子莫愁江路滑，老夫扶老有青藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18487,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"观风望云","author":"边贡","text":"云浮剑阁夜英英，白马江边踏月行。\n传语啼猿莫相近，恐教游子不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18488,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"饮菊泉二首 其一","author":"边贡","text":"雨色岩花入牖斜，城中风景似山家。\n横琴不奏朱弦调，对菊惟看白玉花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18489,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"饮菊泉二首 其二","author":"边贡","text":"十月霜庭菊正肥，亭亭寒影照山扉。\n野夫本是渊明侣，可怪淹留夜不归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18490,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"或曰虽有寓意然非善言故改作","author":"边贡","text":"红芳瘦尽绿阴肥，幽鸟枝头自在栖。\n一日天风吹羽翮，上林便作好声啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18491,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"浙人自辽囊父榇返?感其事为赋","author":"边贡","text":"客衣零落鬓毛斑，迢递沙场负骨还。\n三尺古碑千载恨，曹娥江上水潺潺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18492,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"避喧二首 其一","author":"边贡","text":"兴在桃源山水间，幅巾藜杖每忘还。\n沙田雨湿青牛卧，石洞花深白鹿閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18493,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"避喧二首 其二","author":"边贡","text":"北窗无人春睡安，时闻春树鸟关关。\n老翁元是避喧者，又欲移家向别山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18494,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五月五日以扇奉寄二亲侑以小诗二首 其一","author":"边贡","text":"迢迢亲舍白云下，长日登楼思有馀。\n代谷燕山空说近，经时不见一封书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18495,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五月五日以扇奉寄二亲侑以小诗二首 其二","author":"边贡","text":"薰风帘幕燕翻翻，庭际榴花火欲然。\n睡起忽生千里思，慈颜一别又三年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18496,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"示弟赋","author":"边贡","text":"雁门秋高多烈风，烟沙极目见云中。\n怜君弓马年来惯，不数翩翩塞上雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18497,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"插秧歌","author":"边贡","text":"红石冈头夜雨晴，湖田水满接堤平。\n行人欲问年丰俭，试向田中听鼓声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18498,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"促梅次韵","author":"边贡","text":"庭下梅花开未开，帝孙邀月久停杯。\n终知不入繁华梦，莫遣笙歌取次催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18499,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晓起口号","author":"边贡","text":"春眠不奈鸟声催，起立荒园傍古槐。\n怪底幽寻苦无力，梦中曾上故山来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18500,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻董汝卿丧内二首 其一","author":"边贡","text":"草堂双燕垒新巢，坐感琴丝理断胶。\n麦饭一壶香一瓣，此情何处哭芳郊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18501,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻董汝卿丧内二首 其二","author":"边贡","text":"好学平生说仲舒，绛帷常坐五更馀。\n春来睡足三竿日，应是无人唤读书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18502,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"写怀","author":"边贡","text":"白发萧萧五十春，宦途犹作未归人。\n何时杖履柴门路，风景依然远俗尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18503,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴竹斋惠药品","author":"边贡","text":"六月漳河舣客舟，小窗閒卧白云秋。\n怜君馈药如康子，不疗山翁四海忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18504,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"田家","author":"边贡","text":"柳覆崇垣水护门，不依邻舍自为村。\n何缘却近山陵道，日夕时闻车马喧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18505,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"薛汝茂乞莲栽","author":"边贡","text":"薛家池中千叶莲，出波今已叠青钱。\n分栽不为看花色，要向山窗听雨眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18506,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"竹店铺候高生不至","author":"边贡","text":"行尽荒山更涉溪，故人闻说在城西。\n空庭日午车马寂，惟有鹁鸪深树啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18507,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游仙词四章寿杨母次刘五清韵 其一","author":"边贡","text":"翡翠衣裳云母軿，往来常在碧霄行。\n老君台上凌风过，王母池边看月生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18508,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游仙词四章寿杨母次刘五清韵 其二","author":"边贡","text":"一寸灵光万古心，笑看乌兔两升沉。\n已遣寿颜同紫玉，更欺仙骨比黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18509,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游仙词四章寿杨母次刘五清韵 其三","author":"边贡","text":"冉冉霓旌覆羽仙，双双玄鹤舞芳筵。\n眼看庭树真琼树，不数蓝田是玉田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18510,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游仙词四章寿杨母次刘五清韵 其四","author":"边贡","text":"江流山色绕金堂，管领年华入寿觞。\n仙家自与人间别，千岁都来一刻长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18511,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿歌三章为松鹤翁作 其二","author":"边贡","text":"西园十月菊花黄，花底流泉水亦香。\n汲水采花宵酿酒，晓筵倾入万年觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18512,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿歌三章为松鹤翁作 其三","author":"边贡","text":"八旬遐齿三龄锡，四海升平见七朝。\n颍上漫随巢父隐，渭南还有太公招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18513,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别董三屏次韵","author":"边贡","text":"晚照长云合，春帆细雨开。\n别离予正苦，魂梦子频来。\n石路齐南境，风花白下台。\n十年今去国，千里独怜才。\n会有荷裳寄，应烦想像裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18514,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游仙岩","author":"边贡","text":"黄帝昔好道，相传驻此山。\n至今鍊药处，犹见五云还。\n丹井霞空聚，清池水自潺。\n凤笙归寂寞，龙驾绝追攀。\n旷劫留仙迹，何年启佛关。\n看花周法界，钟鼓隔人寰。\n瀑响千岩应，潭虚万象閒。\n排空云木古，夹道翠泉环。\n涧鹿冲人返，山花照酒殷。\n寺荒翻雅淡，僧老更萧閒。\n问法空群妄，探奇始一斑。\n未能兼吏隐，回首愧尘颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18515,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白岩太宰寄示新作兼有并刀之贶奉谢一首","author":"边贡","text":"忽报王孙使，新从相府旋。\n下阶忘病足，开牍醒愁眠。\n碧落仙人字，黄初大雅篇。\n空岩泣神鬼，白日走云烟。\n策杖东峰外，看碑北岳前。\n依微穿雪窦，想像俯春泉。\n客路千馀里，离心两隔年。\n倦游甘散拙，高举谢联翩。\n水国身犹寄，山堂梦屡牵。\n愧非清庙质，虚枉佩刀传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18516,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠张御医九龄","author":"边贡","text":"故居移杏圃，新宠沐枫宸。\n天马飞黄日，云龙际会辰。\n华陀初入魏，扁鹊旧鸣秦。\n术妙乾坤秘，功存社稷臣。\n东衢迎宝镪，西第拥朱轮。\n家是华胥国，人呼有脚春。\n翻嗟缝掖士，章句老风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18517,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游仙词赠李羽士拟初唐四子体","author":"边贡","text":"碧落新移牒，玄津晚系槎。\n天临北斗地，人住上清家。\n树古金坛静，花深玉洞斜。\n灵砂飞绛雪，仙醴注青霞。\n缑岭音书密，函关道路遐。\n月明苍鹤羽，风度紫鸾车。\n几见桃成实，重闻海变沙。\n瑶窗礼星后，閒坐读南华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18518,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得白鹭洲送柴墟储中丞","author":"边贡","text":"路转长干渡，洲传白鹭名。\n沧波去不息，绿芷复丛生。\n隐隐江田抱，团团堰日明。\n镞沙沈壁垒，墙堞隐台城。\n湍古晴霓下，蒲深昼虎行。\n渔人牵网迹，商女踏歌声。\n佳丽千年恨，豪华六代情。\n经过夕临眺，谁并客舟横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18519,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送金中丞赴延绥","author":"边贡","text":"上郡防戎切，中丞入陜遥。\n隼旂明晓甸，铙吹转春桥。\n二月花新缀，三川雪正消。\n北门来寇准，西极使班超。\n国仗和戎利，人传破胆谣。\n按图收地险，坚壁阻天骄。\n礼乐钦儒将，经纶翊圣朝。\n长城一身是，讵数霍嫖姚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18520,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送许中丞德新赴甘肃","author":"边贡","text":"暂布山东化，还为陇右行。\n中丞新受敕，贱子旧知名。\n玉露承冠剑，金飙捲旆旌。\n神羊心自直，孤隼势初横。\n地接祈连砦，星罗冒顿营。\n未须怀破斧，先喜号长城。\n草映边云白，沙流汉月明。\n陜人歌召伯，关吏识终生。\n许国知公志，通家是我情。\n离筵忽隔水，秋望转盈盈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18521,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送唐京兆送母还邵阳","author":"边贡","text":"奉诏还将母，南归乐未涯。\n日明吴苑树，风引邵陵槎。\n万里遥瞻阙，三湘近接家。\n望滩怀孔雀，临洞识桃花。\n寿祝青山永，书传碧海遐。\n赵张前史艳，曾闵后人誇。\n去值桑蚕老，迎看竹马斜。\n却怜春别苦，飞絮满江沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":18522,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]