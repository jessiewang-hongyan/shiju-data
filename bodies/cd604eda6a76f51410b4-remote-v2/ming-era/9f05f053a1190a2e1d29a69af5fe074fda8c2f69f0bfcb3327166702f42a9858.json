[{"title":"荆州杂诗六首 其五","author":"宋登春","text":"问药过城府，儿童晚未回。\n云深宋玉宅，雪暗楚王台。\n花发春犹浅，楼高赋转哀。\n家家湘酒绿，谁为一尊开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4158,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送句吴豪士重游大梁 其一","author":"宋登春","text":"魏王台上草纷纷，落日中原低暮云。\n匹马浪游孤剑在，酬恩谁说信陵君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4159,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送句吴豪士重游大梁 其二","author":"宋登春","text":"汴水东流接大河，曾经帝里问铜驼。\n春风三月旗亭酒，落日夷门一放歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4160,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送句吴豪士重游大梁 其三","author":"宋登春","text":"沙尘风起昼冥冥，二月黄河尚带冰。\n桑柘夕阳村店路，同谁走马吊韩陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4161,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日上党道中怀故乡知旧","author":"宋登春","text":"白发生青镜，黄花吐素秋。\n家书无雁足，客路一羊裘。\n海燕辞乡社，山猿傍酒楼。\n谁堪回首处，千里暮云稠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4162,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再示鲸","author":"宋登春","text":"客梦苦难成，鸣鸡又及晨。\n燕鸿惊岁晚，越鸟对愁新。\n九月催寒叶，孤琴伴旅人。\n相看正牢落，非尔复谁亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4163,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"越溪女","author":"宋登春","text":"越溪素足女，婉笑青眉扬。\n泛水采芙蓉，归来衣更香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4164,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山楼秋夜有怀","author":"宋登春","text":"旅宿燕关暮，天寒霜叶稀。\n凉风生夜榻，客泪下秋衣。\n路远乡云断，山深边草肥。\n堪凄珠树鹤，何日故林飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4165,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晋阳山中元日","author":"宋登春","text":"野老怜时序，壶浆慰客情。\n春盘邻女送，晓树陇禽鸣。\n寒坞惊花色，穷边听角声。\n他乡逢一笑，更觉旅魂惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4166,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日游太原黄岩寺","author":"宋登春","text":"拂衣坐盘石，度水听疏钟。\n古殿依岩碧，山花拂砌红。\n晴峰辉旭日，春燕浴条风。\n欲共巢松客，安禅老化宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4167,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟宫中行乐词四首 其一","author":"宋登春","text":"小红亭子白阑干，入道宫娥玉作冠。\n袖出青梅弹鸂?，银瓶满注蔗浆寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4168,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟宫中行乐词四首 其二","author":"宋登春","text":"碧殿春深瑶草肥，美人对月舞罗衣。\n夜来不作青鸾梦，化作彩云何处飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4169,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟宫中行乐词四首 其三","author":"宋登春","text":"玉辇春游夜未央，紫衣侍史谩焚香。\n黄金锁合鸳鸯殿，无限春风到海棠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4170,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟宫中行乐词四首 其四","author":"宋登春","text":"琉璃砚水黄金瓶，十样鸾笺写道经。\n太乙紫坛朝帝罢，蕊珠深殿彩花馨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4171,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"老僧","author":"宋登春","text":"手中捻着白菩提，拄杖过头眉下垂。\n石上晒经茶未熟，花间童子进双梨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4172,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春郊即事","author":"宋登春","text":"春风袅袅夕阳西，芳草菲菲杨柳堤。\n行尽溪山有茆屋，青林深处一鸠啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4173,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词","author":"宋登春","text":"自从十五画双眉，记得新裁《白苎》词。\n袖里青梅大如豆，石榴枝上打黄鹂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4174,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻京东有警","author":"宋登春","text":"暮雨催秋馆，长风冷菊枝。\n坐中蛩窣窣，灯下鬓丝丝。\n四海寻戈日，百年为客时。\n燕山新战后，乡信到应迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4175,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"荆州公馈酒 其一","author":"宋登春","text":"菱叶青青水荇齐，绕篱黄蝶菜苗肥。\n夕阳谁送山人醉，坐看儿童跨犊归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4176,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"荆州公馈酒 其二","author":"宋登春","text":"秋风袅袅熟黄粱，池上鹅肥酒更香。\n醉里不妨学楚语，《竹枝》歌好和渔郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4177,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中烹鸡有作","author":"宋登春","text":"避地岂真隐，谋生未有方。\n晨烟熟鸡黍，墟里澹柴桑。\n雨过豆花赤，风高柿叶黄。\n邻家不相识，何处觅壶觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4178,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十五夜郡斋小集","author":"宋登春","text":"校书罢芸阁，移尊趁晚衙。\n莓苔宜小簟，蜡烛隐轻纱。\n稚子能驯鸽，翻阶啄落花。\n微风坐醒酒，明月共分瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4179,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿郡斋","author":"宋登春","text":"烛尽怜红影，诗成掉白头。\n吴歌小榻夜，楚雨虚堂秋。\n残梦醒余沥，轻寒仗敝裘。\n鲋鱼甘涸辙，吾亦笑庄周。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4180,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江阁晚望呈荆州公","author":"宋登春","text":"几处蒹葭连岸白，数村烟火隔江明。\n无家自合依刘表，有赋谁能荐长卿。\n巫峡去帆江树隐，衡阳归雁暮云平。\n黄金巳尽还为客，湘汉长歌万古情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4181,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郡东厅晏坐","author":"宋登春","text":"昼刻分香短，风帘簇影移。\n天清闻堕羽，院静见游丝。\n往事闲堪忆，长贫老不疑。\n黄金未可就，瀛海竟难期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4182,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"洞庭送徐荆州投劾东归","author":"宋登春","text":"秋来为客易沾巾，又向潇湘送逐臣。\n烟草断云横楚塞，夕阳落雁度江津。\n天涯白发无知己，湖上青山有故人。\n回首吴关空怅望，何年沧海共垂纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4183,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"自沙津江行舟次岳阳送徐荆州","author":"宋登春","text":"漠漠晴沙江水流，搴衣同上木兰舟。\n白蘋风起洞庭暮，碧树云横楚塞秋。\n羁客怀乡何限泪，孤臣去国不堪愁。\n夕阳帆影临空尽，谁念天涯独倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4184,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"石首阻风寄怀徐荆州","author":"宋登春","text":"别后相思梦屡真，秋来谁寄短书频。\n孤舟风雨偏愁客，万里江湘对逐臣。\n庄舄苦吟终适越，仲宣欲赋未归秦。\n十年零落黄金尽，一夜长歌独怆神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4185,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新春堂成寄怀所知","author":"宋登春","text":"老去还杯酒，春来自草堂。\n挥金曾有志，煮石竟无方。\n岸水浮鸂?，林花宿麝香。\n故人江汉少，念子意何长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4186,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"自公安县夜归鹅池庄风雨骤至有作","author":"宋登春","text":"候雁迷寒渚，昏鸦集驿亭。\n故人江上别，风雨返柴荆。\n楚些秋能赋，《巴歈》夜懒听。\n蓬窗小儿女，相待一灯青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4187,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九月三日方别驾携酒殽见过因怀徐荆州","author":"宋登春","text":"客泪秋能下，人情老自知。\n塞寒鸿雁早，江暖鞠华迟。\n对酒怜吴语，闻歌忆《楚辞》。\n明年谁更健，重把紫萸枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4188,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江村寒食","author":"宋登春","text":"白鸟忘机久，青山吾道存。\n兴来从杖屦，老去爱鸡豚。\n杨柳桥边市，桃华江上村。\n童儿沽酒至，风雨闭柴门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4189,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寒食西郊望八岭山作","author":"宋登春","text":"寒食孤村外，春山远寺钟。\n登临风候异，祭埽岁时同。\n芳树诸王墓，浮云旧楚宫。\n天涯对衰鬓，寂寞意无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4190,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日登唫览楼","author":"宋登春","text":"远客不宜秋，况登江上楼。\n心随胡雁灭，身为楚云留。\n汉广饶菰米，湘清聚白鸥。\n寒砧何处发，落日动乡愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4191,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中呈王郎","author":"宋登春","text":"黄金台下见君颜，今日萧条入楚关。\n一顾那知添白发，十年何事老青山。\n乡愁多在烟云外，客思偏生风雨间。\n我巳无家问消息，开畦种药不须还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4192,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"侠客","author":"宋登春","text":"赌掷赛刘琨，家奴过孟贲。\n千金不肯顾，一剑为酬恩。\n赵瑟停凰柱，燕姬促象尊。\n平生款段马，羞入孟尝门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4193,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日待家书不至感赋此诗","author":"宋登春","text":"泽国寒风木叶稀，悲歌昨夜赋《无衣》。\n自添白发年华异，用尽黄金生事微。\n易水似怜湘月远，燕鸿还共楚云飞。\n鱼书锦字无消息，秋草闲门又夕晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4194,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日寓徐公西园","author":"宋登春","text":"笋出过阑见，桃香度水闻。\n树深连海色，洞午散江云。\n石上抛书卷，花间数鹤群。\n春愁如碧草，随处乱纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4195,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"海上寒食","author":"宋登春","text":"风雨临寒食，偏惊流浪情。\n梅花乡信远，芳草客愁生。\n青眼故人少，白头世事轻。\n还余一尊酒，东海吊田横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4196,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪后","author":"宋登春","text":"石径留冰雪，松门锁薜萝。\n地幽身自得，机息鸟常过。\n芳草春愁少，梅花客醉多。\n《竹枝》辞更好，还爱楚人歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4197,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赏雪侍宴应教","author":"宋登春","text":"狐白暖蒙茸，当歌集上公。\n春藏金屋里，仙隐玉壶中。\n送酒青楼妓，焚香白玉童。\n锦屏寒不入，只许隔帘栊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4198,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春辞二首 其一","author":"宋登春","text":"南浦谁家荐绿蘋，野棠又发楚山春。\n满城芳草烟和雨，江燕飞来似识人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4199,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春辞二首 其二","author":"宋登春","text":"广陌青楼杨柳新，莺花时节可怜人。\n至今汉上多游女，笑折疏麻赠所亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4200,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"踏青杨柳洲","author":"宋登春","text":"骅骝蹀躞上芳洲，杨柳青青楚水流。\n日暮东风摇百草，不知何处是昭丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4201,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮酒","author":"宋登春","text":"城上秋风动薜萝，十年江客意如何。\n酒肠方大黄金尽，世事才知白发多。\n月冷却怜孤鹤怨，天寒谁听饭牛歌。\n平生还爱于陵子，用拙为园老一蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4202,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋兴二首 其二","author":"宋登春","text":"江上形容老，山中薜荔秋。\n鹤鸣竹院静，狙啸筚门幽。\n爱树收黄叶，怜生洗白头。\n室无莱子妇，谁共卧云丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4203,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"楚童","author":"宋登春","text":"白晰楚童清，双鬟挈酒瓶。\n灌花晨汲井，学字夜囊萤。\n竹院晴时扫，柴门客去扃。\n弱躯偏惜汝，饥渴屡曾经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4204,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"辽府草亭赠朱孔昭","author":"宋登春","text":"平原门下似君稀，犹着前春旧布衣。\n况我不如君数倍，食鱼何敢望轻肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4205,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"连日风雨骤生薄寒分甘哺孙赋诗自娱园蔬时醪亦足养老","author":"宋登春","text":"江城风雨夕，茅屋短长唫。\n历历秋花发，翛翛落叶深。\n老凭孙暖眼，客用酒宽心。\n欲买罗含宅，曾无作赋金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4206,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨后移竹小园漫赋","author":"宋登春","text":"童仆饥时懒，家贫愿一金。\n暄寒惟裋褐，风雨屡长唫。\n江阔秋生蚤，城高雾隐深。\n从来爱幽意，移竹间花林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4207,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"抱孙之食市中","author":"宋登春","text":"何室炊红粟，谁家具绿尊。\n频游双屦弊，生计一瓢存。\n任尔呼牛马，随予爱犬豚。\n绝交书未上，为客老荆门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4208,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日野望","author":"宋登春","text":"听鸟中林性，看云故国心。\n地卑湘汉阔，天远洞庭深。\n老马空知道，穷猿岂择林。\n十年书剑客，寂寞到如今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4209,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮酒四首 其二","author":"宋登春","text":"福端吾不为，盛名岂敢居。\n列子老郑圃，何异凡民愚。\n六用俱可废，一真良自如。\n百年此形容，泡影现斯须。\n有生胡不乐，安有再来躯。\n箕踞竹林中，酌酒焚枯鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4210,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮酒四首 其三","author":"宋登春","text":"睫常在目前，如何目不见。\n死常随我身，如何我不患。\n好高穷远深，至近反忽慢。\n谁知衽席间，而乃即天汉。\n万古亦非遥，一息长无算。\n老彭与殇子，寿夭相等看。\n静观蜉蝣羽，可同白石烂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4211,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮酒四首 其四","author":"宋登春","text":"怒则乖天和，喜亦伤大雅。\n喜怒同使臣，胸臆若传舍。\n来去本无端，不乘车与马。\n一气自起灭，万形非真假。\n十年会此理，欲辩言愈寡。\n中心久藏之，当告知音者。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4212,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春寒睡起口号","author":"宋登春","text":"白发白于丝，春眠起较迟。\n即看芳草变，又过杏花时。\n裋褐寒先觉，长吟趣自知。\n谁云鲁酒薄，犹免越人思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4213,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"久雨小晴即事","author":"宋登春","text":"海色常含雨，山云薄带寒。\n曦微占暮鹊，芳意结春兰。\n对酒看长剑，低头试小冠。\n孟尝空好士，白发老冯驩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4214,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同襄阳阮举人游楚山田家遇雨","author":"宋登春","text":"携酒依场圃，班荆共老农。\n楼台一水外，风雨万山中。\n田叶浮逾绿，溪花湿更红。\n百年耕凿计，吾愧鹿门公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4215,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泗上赠吕侠士","author":"宋登春","text":"南游不得意，来问鲁朱家。\n生涩青楼妓，凋零白鼻騧。\n防胡过雁塞，校猎度龙沙。\n剩有缦缨带，时时拂剑花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4216,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日夜集李北山园亭赏菊观妓 其一","author":"宋登春","text":"白酒映尊空，黄花裛露浓。\n征歌来卫女，扶醉有巴童。\n香雾沉兰圃，晴烟驻桂丛。\n海风吹月上，移席小阑东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4217,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"会台观赛","author":"宋登春","text":"霸业古台荒，天寒野日黄。\n鸡豚秋社酒，篱落水云乡。\n对舞青溪女，齐歌白石郎。\n家家扶醉去，海月照枯桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4218,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和赠遣兴呈宋山人","author":"宋登春","text":"桂树冬荣覆院幽，护寒鹦鹉傍青油。\n小姬对月偷教舞，少妇鸣筝不下楼。\n白雪常吟招楚客，黄金那惜买吴钩。\n不知婚嫁何时毕，五岳奇踪入卧游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4219,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"自题画老子图","author":"宋登春","text":"函谷关西几度游，至今紫气未全收。\n青牛老子头如雪，莫怪山人浪白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4220,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清明","author":"宋登春","text":"寒食东风草色新，累累高冢卧麒麟。\n可怜泉下千年骨，曾作提壶拜扫人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4221,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿江边阁","author":"陈昂","text":"暝色江边阁，行吟易断魂。\n风前两岸叶，月下一声猿。\n夜哭谁家妇，寒号何处村。\n洞庭春水动，雇艇去荆门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4222,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"城破领老妻逃入仙游胡岭二首 其一","author":"陈昂","text":"丧乱余生在，饥寒何所投。\n昼逃闻鬼哭，夜窜望仙游。\n有径风先惨，无山鸟肯留。\n老妻向天问，盗贼几时休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4223,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"城破领老妻逃入仙游胡岭二首 其二","author":"陈昂","text":"触目惊犹故，逢茅伏自遮。\n扶行衣尽刺，衰削面如瓜。\n桥断深宜厉，途昏曲恐差。\n斜风飘细雨，啼杀未栖鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4224,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻戚将军将至领老妻从万山中往镡州赋二首 其一","author":"陈昂","text":"未必妖星坠，应怜瘴岭迷。\n支撑寻鸟道，曲折步渔溪。\n时事多无据，音书少有题。\n十年群盗剧，窜伏泪长啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4225,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻戚将军将至领老妻从万山中往镡州赋二首 其二","author":"陈昂","text":"元帅闻将至，七闽徯后秋。\n欲回上帝怒，先复匹夫仇。\n献馘鲸波上，招魂剑水头。\n残生留眼看，平复旧神州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4226,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江澨","author":"陈昂","text":"江澨风难静，关头岚尚迷。\n天河明一雁，鼓角乱群鸡。\n飞将今安在，妖星久未低。\n偷生垂老日，身世寄涂泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4227,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闽南登楼","author":"陈昂","text":"切莫凭楼望，令人更惨凄。\n战场多鬼哭，息壤聚乌啼。\n黄雾埋城郭，寒风死鼓鼙。\n深林巢燕子，来往亦衔泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4228,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]