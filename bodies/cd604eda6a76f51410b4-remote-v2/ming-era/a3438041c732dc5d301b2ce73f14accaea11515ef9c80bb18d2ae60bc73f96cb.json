[{"title":"曲林歌赠曹君时范十首 其九","author":"顾璘","text":"曲林主人踪迹奇，前身陶公安可知。\n脩殿灵官投化主，朝山香客拜生祠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56872,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"曲林歌赠曹君时范十首 其十","author":"顾璘","text":"方瞳墨发地行仙，谁信山翁七十年。\n兴剧夜游轻猛虎，身轻朝陟俯飞鸢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56873,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"茅山步虚词","author":"顾璘","text":"太仪拓洪宇，灵山开福庭。\n洞天窍华阳，地肺浮金陵。\n展公始羽化，茅君遂遐升。\n王老发玄旨，上元授真经。\n乘风出埃壒，餐霞谢膻腥。\n三真登虚府，九锡冠仙卿。\n百神镇侍卫，八极恣游行。\n金堂日星耀，玉洞烟云冥。\n天地咸得一，万古歌清宁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56874,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"还家同金士希诸君游牛首","author":"顾璘","text":"金陵山水四方闻，天阙嵯峨更不群。\n台殿散临云外起，冈峦遥向日边分。\n幽人兴发清虚界，正月春生锦绣文。\n莫怪还家先到此，他乡魂梦每殷勤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56875,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早秋过斌公山房和许彦明三首 其一","author":"顾璘","text":"钟磬花台寂，云霞松坞深。\n石林秋不热，水国昼多阴。\n结束非吾意，逍遥近佛心。\n莫言追往昔，聊喜悟来今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56876,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早秋过斌公山房和许彦明三首 其二","author":"顾璘","text":"青嶂白云蒸，高台野客登。\n鸟迷方外路，云护定中僧。\n对酒狂何在，翻经老尚能。\n摩挲岩下石，坐语记吾曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56877,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早秋过斌公山房和许彦明三首 其三","author":"顾璘","text":"济胜无强足，幽寻亦据梧。\n僧门远市井，秋色澹菰蒲。\n定息看香篆，逃禅托酒壶。\n浮名百年祟，遣尽莫重沽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56878,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"永兴寺结夏","author":"顾璘","text":"濯发莲花水，清风满面吹。\n松高迎日早，僧老下床迟。\n施食鸟频至，翻经鹤静窥。\n物情浑不远，幽兴自相宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56879,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日同太宰严公城西汎舟二首 其一","author":"顾璘","text":"九日江门芦荻秋，登高何似汎兰舟。\n城临曲水天河转，地接仙台苑树浮。\n佳节壶觞随酩酊，上公轩盖倍风流。\n迂疏独笑陶彭泽，漫插茱萸亦满头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56880,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日同太宰严公城西汎舟二首 其二","author":"顾璘","text":"兰桡东荡曙烟开，菊斝西冲落照回。\n夹岸山岚飘几席，绕城波色动楼台。\n都人节序遗风旧，词客秋吟发兴哀。\n偃仰皇州多胜槩，挥毫何以继仙才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56881,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次赵克用游灵谷三首 其一","author":"顾璘","text":"禅宫寄在万松深，绀殿阴阴入紫岑。\n古碣长留开士影，颓廊堪惜画师心。\n嗟余卧病虚春色，爱尔清斋听梵音。\n石室乘凉十年事，诗成幽兴转难禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56882,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次赵克用游灵谷三首 其二","author":"顾璘","text":"入山飞翠满衣襟，一径松萝曲坞深。\n龙寝云高横王气，鹤林风定净禅心。\n开堂为有真僧出，避地应无俗累侵。\n响石灵泉多胜迹，与君扶杖细相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56883,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次赵克用游灵谷三首 其三","author":"顾璘","text":"紫厓苍巘隐云房，春尽唯闻药草香。\n风磴喷泉晴欲雨，石林含露午生凉。\n醉怜半落花辞树，坐叹西飞日转廊。\n回首碧城灯火乱，淡烟疏柳路微茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56884,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同鲁南宿天界竹居","author":"顾璘","text":"白首同归桑梓日，旧游山水得重过。\n聊依僧饭炊菰米，更理渔蓑缀薜萝。\n花老不知春事尽，竹深偏爱雨声多。\n旁人莫讶追欢剧，岁月翩翩奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56885,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同鲁南天界方丈对雨","author":"顾璘","text":"与子避俗祇园深，高阁雨鸣如洗心。\n芳草杜门无马迹，墨云缠树有龙吟。\n堪怜把笔临池水，况复衔杯对竹林。\n终岁驱驰城郭里，幸于支遁此开襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56886,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"祝禧寺群公游集二首 其一","author":"顾璘","text":"桐馆延高驾，霞门集绣裳。\n山深寒隐日，松老翠含霜。\n共洽壶觞兴，仍探翰墨场。\n临风意披豁，飞镝试穿杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56887,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"祝禧寺群公游集二首 其二","author":"顾璘","text":"旧国开今代，新亭异昔游。\n江山衔日转，宫阙抱云浮。\n胜赏群公得，高情百世留。\n蹇余丘壑陋，觞咏托名流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56888,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和徐子仁游虎丘四首 其一","author":"顾璘","text":"胜地遥相引，清川澹自临。\n散怀盘石大，洗耳剑池深。\n僧气饶云月，岩居傍竹林。\n坐来神易怆，松籁莫哀吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56889,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和徐子仁游虎丘四首 其二","author":"顾璘","text":"溪门藏曲坞，入寺始知奇。\n石悟生公法，山传白傅诗。\n浮云催短世，裋褐傲清时。\n莲社容吾酒，终当共尔期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56890,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和徐子仁游虎丘四首 其三","author":"顾璘","text":"漫踏书台路，那逢讲席人。\n泉争惠山品，地避子城尘。\n幽林云隐见，峭壁玉嶙峋。\n本性宜岩穴，劳生负此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56891,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和徐子仁游虎丘四首 其四","author":"顾璘","text":"诗书贫自得，云水老何厌。\n世味僧边减，山容雪后添。\n狂摩试剑石，醉眺大吴岩。\n莫笑归期缓，名蓝客易淹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56892,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夕阳同王礼部陈太仆过东山僧房","author":"顾璘","text":"落日过山寺，怀贤伤古今。\n谢公去已久，渌水歌声沈。\n云壑延高驾，风林净夏襟。\n倾杯莫愁晚，明月在东岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56893,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和鲁南永福禅房二首 其一","author":"顾璘","text":"支公本是禅林秀，更爱祇园在近乡。\n问柳寻花唯竹杖，解衣支枕有山堂。\n云浮世界知空寂，雪满头颅叹老苍。\n闻说庵摩罗结果，灯前攀取一开尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56894,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和鲁南永福禅房二首 其二","author":"顾璘","text":"山人每为看山出，唯有山云不待期。\n草长乍经春雨后，江明偏近夕阳时。\n前林犬吠僧归远，古殿钟鸣客散迟。\n除却陶潜贪酒盏，不知莲社复容谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56895,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日寻城东诸山颇历深险得诗八首 其一","author":"顾璘","text":"秋日端居愁不眠，出门骑马踏苍烟。\n衣沾湿翠经厓崿，耳洒寒声接涧泉。\n梦到桃源询往代，疑逢石髓见灵仙。\n金陵岂独称佳丽，咫尺名山是洞天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56896,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日寻城东诸山颇历深险得诗八首 其二","author":"顾璘","text":"马首遥随碧涧东，人家多住白云中。\n龙泉沸处还生虹，虎洞腥来自起风。\n向子正当婚嫁毕，阮生休叹路途穷。\n曾闻天汉支机石，肯信高岩不可通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56897,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日寻城东诸山颇历深险得诗八首 其三","author":"顾璘","text":"紫山东转接江门，万壑千峰拥孝园。\n远结云霞连海岛，回瞻日月蔽昆崙。\n牵萝步入岩间寺，选树来倾石上尊。\n猿啸正堪淹白昼，鸦栖浑已报黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56898,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日寻城东诸山颇历深险得诗八首 其四","author":"顾璘","text":"鼎邑元当万方会，桥山今集百灵朝。\n宫城抱日云常绕，陵树擎霜叶后凋。\n衰晚空林从坐卧，太平深谷有歌谣。\n此中合共渔樵老，丛桂淮南莫更招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56899,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日寻城东诸山颇历深险得诗八首 其五","author":"顾璘","text":"盘空石路草纤纤，白鹤仙人尚有岩。\n松偃即披云作盖，瀑飞还挂水为帘。\n采芝绮夏何须出，食蕨夷齐亦太廉。\n种黍满田长酿酒，栖迟何叹岁年淹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56900,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日寻城东诸山颇历深险得诗八首 其六","author":"顾璘","text":"六代干戈龙战残，青山依旧绕江干。\n石麟不省玄堂改，漆阁徒伤翠柏寒。\n庾信归来空有赋，陶弘老去竟何官。\n飞鸿欲避林间犬，万里冥冥振羽翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56901,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日寻城东诸山颇历深险得诗八首 其七","author":"顾璘","text":"官路桥东锦石峰，平原开出玉芙蓉。\n高标云雾天中积，远势波涛水上重。\n喜近鱼梁堪把钓，拟修丹室预栽松。\n紫苔苍藓饶秋色，埋骨它年赖尔封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56902,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日寻城东诸山颇历深险得诗八首 其八","author":"顾璘","text":"竹杖逶迤蹑紫霞，羊肠山径莽横斜。\n林深更隐彭城馆，寺古犹传谢尚家。\n阴洞闭云飞石燕，寒藤悬树堕风花。\n周颙去后移文在，此地何人领物华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56903,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬日同诸公饮凭虚阁","author":"顾璘","text":"寺阁吟诗腊月中，拥裘行酒气弥雄。\n江山过雪生新色，天地凝寒渺太空。\n独去鹰鹯迷落日，后凋松柏倚高风。\n须知霜月光偏胜，莫道冰林赏易穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56904,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"卜得彭城乐丘漫赋用鲁南韵","author":"顾璘","text":"买山初费卖文钱，预卜新丘古涧前。\n旧日高人招隐地，此生逆旅待终年。\n烟霞寄傲深成癖，去住忘情澹入禅。\n白发光阴知几许，紫泉丹壑且夤缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56905,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪后归自南郭","author":"顾璘","text":"雪后帝京聊骋望，冰天悬影照人寰。\n遥瞻丹凤分银阙，周览青龙展玉山。\n广野漫铺明月色，白波摇动大江湾。\n多情独倚新亭树，更爱长风洒醉颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56906,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"祝禧寺望积雪","author":"顾璘","text":"岩谷素华积，禅房朝倚阑。\n为怜珠树丽，宛坐雪山寒。\n白以空为色，冰因冻作乾。\n太阳休见恐，生灭本同观。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56907,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陈鲁南学士自山东寄遁志十绝和之 其一","author":"顾璘","text":"门接登山径，窗临洗药泉。\n草堂幽意足，况复近皇川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56908,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陈鲁南学士自山东寄遁志十绝和之 其二","author":"顾璘","text":"眺迥苍茫外，探奇紫翠中。\n忘机同海鸟，脱迹比云鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56909,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陈鲁南学士自山东寄遁志十绝和之 其三","author":"顾璘","text":"清玄非晋代，岩壑胜山阴。\n群从差强意，时来醉竹林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56910,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陈鲁南学士自山东寄遁志十绝和之 其四","author":"顾璘","text":"携樽登树饮，抱被枕流眠。\n本性疏狂甚，非关慕昔贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56911,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陈鲁南学士自山东寄遁志十绝和之 其五","author":"顾璘","text":"真閒聊野服，至乐止人寰。\n肯为神仙误，虚寻度索山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56912,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陈鲁南学士自山东寄遁志十绝和之 其六","author":"顾璘","text":"新亭高处望，今代异风云。\n紫殿开京观，龙成五采文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56913,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陈鲁南学士自山东寄遁志十绝和之 其七","author":"顾璘","text":"星散南山寺，乘春取次登。\n封筒来往数，随处得诗僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56914,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陈鲁南学士自山东寄遁志十绝和之 其八","author":"顾璘","text":"牛峰悬殿阁，对削献花岩。\n感慨千年杏，摩挲十丈杉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56915,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陈鲁南学士自山东寄遁志十绝和之 其九","author":"顾璘","text":"江动新林浦，天垂大石峰。\n四围山万点，云海濯夫容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56916,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陈鲁南学士自山东寄遁志十绝和之 其十","author":"顾璘","text":"旧路石冈僻，新堂松坞深。\n春风猿鹤侣，扶杖远相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56917,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄荅陈大藩参二首 其一","author":"顾璘","text":"官重今方伯，旬宣事独贤。\n情飘五湖外，诗出万人传。\n玉署虚仙籍，春江梦钓船。\n祇愁凫舄影，难离紫宸天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56918,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄荅陈大藩参二首 其二","author":"顾璘","text":"卧病春山里，劳君省阁思。\n衰颜丹鼎笑，晚计白鸥知。\n应接才仍拙，渔樵兴颇宜。\n万缘空欲尽，犹自未忘诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56919,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"贻霷僧","author":"顾璘","text":"埋头不振苍龙锡，合眼犹持白马经。\n门外任教双毂转，堂中长对一灯青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56920,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠金山僧圆济","author":"顾璘","text":"山僧扣我门，秀发金山骨。\n相见了无言，空庭踏秋月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56921,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送斌上人游杭州","author":"顾璘","text":"斌公禅林秀，前身海潭龙。\n明珠濯清水，本性长玲珑。\n少事大虚老，空门初发蒙。\n拜趋陈庄座，金篦刮双瞳。\n低心达磨壁，捧钵曹溪宗。\n天界大丛林，跏趺坐堂中。\n头陀满四座，发难如扣钟。\n吾衰谢抖擞，卧疾维摩宫。\n与子强荅问，而岂明真空。\n支许方外交，聊以息微躬。\n今晨告余别，游方海之东。\n礼佛普陀岛，参禅雪窦峰。\n青莲被寒沼，白月悬秋穹。\n行色有佳景，归云无定踪。\n我有振衣地，寄在杭万松。\n浩渺湖海接，逶迤岩壑重。\n尔往结莲社，陶谢将无同。\n长谣写心曲，托寄东林风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56922,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"分题得秦淮寿龙致仁","author":"顾璘","text":"秦人凿淮古城碛，秦时流水今如昔。\n地下黄金空自深，天门紫气逾辉赫。\n六代烟华涨锦云，龙江鹭渚澄青碧。\n形胜今开天子都，风流更隐幽人宅。\n幽人抱艺入承明，能使四海传高名。\n翻然解组归淮水，笑弄渔舟自濯缨。\n闻道舍傍葛仙井，的烁丹砂彻夜明。\n与君共泥紫金鼎，手把霓旌游太清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56923,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿姚孟恭七十","author":"顾璘","text":"脩竹老翁何所求，紫芝歌动傲王侯。\n逃名岂羡金门贵，学礼仍看玉树稠。\n大道长生唯药鼎，清谈终日有茶瓯。\n堪誇世范传儒素，已许乡评占胜流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56924,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿易太守士美","author":"顾璘","text":"清修乡国老文儒，后辈跄跄总不如。\n黄霸有才聊试郡，伏生从少已传书。\n高才晚剖荆山玉，美政新还合浦珠。\n林壑光阴方洒落，莫教门外候安车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56925,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答汪中丞见怀","author":"顾璘","text":"雅望同归天下贤，知心初附白头年。\n拟将东海论交谊，几向西湖费酒钱。\n石涧行临三竺水，茅亭吟对万松天。\n相望千里能相忆，满纸高情护碧烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56926,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送林伯章","author":"顾璘","text":"金陵帝城天下会，名胜从前特称最。\n观风季札自何来，巍冠峨峨垂缓带。\n龙山虎阜翠烟浮，曲浦澄江素月流。\n唱罢骊歌向人别，城西一访谪仙楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56927,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠秋官叶敬之奏最北上","author":"顾璘","text":"三年持法白云司，直道人歌张释之。\n竹简下帷工旧学，桃花留县有馀思。\n每缘正气瞻台岳，幸接交情老鬓丝。\n才俊尔来多近侍，看君摇佩入丹墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56928,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠沈少刚","author":"顾璘","text":"东浦清清连太湖，太湖水光秋可娱。\n美人乘舟明月底，戏引骊龙出弄珠。\n黄公垆头沽酒醉，一曲吴趋天下无。\n请君早出济黔首，归来东浦随吾徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56929,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠胥大夫","author":"顾璘","text":"洞庭水波混天色，君山嵯峨奠江国。\n岳阳楼头一开眼，造化高深坐中得。\n紫绶若若方离腰，浮生万事如云飘。\n采服诸郎递起舞，醽醁满泛黄金瓢。\n醉醒不复问天地，日倚南窗咏松桂。\n仙老休传九转丹，大夫自度三千岁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56930,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雏凤行贺李少宰梦弼生子","author":"顾璘","text":"雏凤本出西昆崙，百鸟奉之巢帝阍。\n大声鼓鸣震海水，羽毛焕烂光朝暾。\n衔书献瑞降神德门，乃为少宰之子司徒之孙。\n英物生来不嫌晚，秀骨堕地人传喧。\n犀顶双开日月角，公侯异种由根源。\n邺侯万卷行可展，立地便见乘华轩。\n家书飞鞚入东省，看君黄气眉棱鶱。\n两乡竞作汤饼宴，莫惜烂醉双金樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56931,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"相士吴立","author":"顾璘","text":"希夷漫让麻衣术，禦寇元藏杜德机。\n燕颔纷纷食肉相，龙门寂寂钓鱼矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56932,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠谢应午","author":"顾璘","text":"志士抗高节，末俗寡所谐。\n出门各有务，畴能喻中怀。\n契合将焉托，眷此庭中槐。\n孰谓尔无心，达性乃弗乖。\n荣谢委时义，强干屹不摧。\n吾志苟如此，何必求形骸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56933,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠马大承道超贡上礼部","author":"顾璘","text":"金膏水碧不易得，马生才华倾众人。\n昂藏场屋每脱略，一跃便致青云身。\n圣朝礼乐复元古，隋唐科目安足数。\n玉阶独对天人篇，举头思与夔龙伍。\n乡国从来盛俊英，蹇予乖剌老无成。\n拂君宝剑出门去，早取千秋万古名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56934,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠恽司勋器之","author":"顾璘","text":"干将无留割，奇骥刷千里。\n磊落恽司勋，天才豁所委。\n研精综天人，识微洞玄理。\n排荡五行家，力破管郭垒。\n领郡懋循良，司农广储峙。\n策功龙飞乡，天子知姓氏。\n三命登吏曹，士类鉴如水。\n古称裴叔则，朗照宛相拟。\n奏绩明光宫，履声彻阶戺。\n留之置左右，启沃自兹始。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56935,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]