[{"title":"诗酒琴棋客五首和年兄雍都堂 其五","author":"区元晋","text":"何处能忘客，云閒竹径低。\n定盟须颖脱，逋害借鸡啼。\n野洞柴门僻，江山雪舫迷。\n折梅思陇上，春色满南溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2558,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清远峡用思斋弟韵漫述 其一","author":"区元晋","text":"清溪溪上舫，客意可谁同。\n渔笛横烟浦，僧钟隐暮峰。\n发岂缘秋短，颜因傍酒红。\n六年乡国念，书札若为通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2559,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清远峡用思斋弟韵漫述 其二","author":"区元晋","text":"桑梓六年别，萍踪万里游。\n清无忠献鹤，贫有晏平裘。\n供世囊甘薄，为官食耻浮。\n尚惭驰五马，朽索未曾收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2560,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客有题小洞壁间诗者词绮而未尽地主之意因赓和足之","author":"区元晋","text":"野亭閒徙倚，身远觉怀开。\n酒熟呼邻得，诗成待客裁。\n巾香花底露，钓冷石边苔。\n最是无营境，僧还杖锡来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2561,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戴来鹤再度索诗寿之 其一","author":"区元晋","text":"北阙梦魂稀，商山旧有期。\n芝茎閒作饵，芋叶细题诗。\n岁月消残局，蔘苓荐寿卮。\n野亭春睡足，扶鹤啸仙墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2562,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戴来鹤再度索诗寿之 其二","author":"区元晋","text":"老态藤蓑健，诗情岛屿巍。\n休休聊复尔，扰扰欲何为。\n名器双芒屦，生涯一酒杯。\n忽怜春事晚，搔首百花堆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2563,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日奉怀 其一","author":"区元晋","text":"庭竹抟宵露，泠然濯我居。\n坐深浑欲赋，兴窅故难书。\n夏狙秋复杪，十约九成虚。\n何日芙蓉棹，华山进所如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2564,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日奉怀 其二","author":"区元晋","text":"忧时吟抱膝，面壁叹离居。\n未遂源源见，徒频咄咄书。\n露泠众色澹，月湛永怀虚。\n此意陶潜会，无劳赋相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2565,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒白沙陈先生祠呈湛太史年伯 其一","author":"区元晋","text":"瞻拜清祠下，羹墙感岁过。\n堂虚光揭日，阶近绿沉莎。\n学启求心约，经妨剩语多。\n兴言归路晚，樵径斗新歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2566,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒白沙陈先生祠呈湛太史年伯 其二","author":"区元晋","text":"先生倡绝学，观化迩遐同。\n濂洛宗无极，河汾陋说中。\n仪刑瞻北斗，俎豆肃清风。\n却忆陈情疏，千钟不换穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2567,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒白沙陈先生祠呈湛太史年伯 其三","author":"区元晋","text":"晴霞栖四壁，明月照孤踪。\n自彻皋比席，谁闻巨梃钟。\n冥心求顿悟，断简故应封。\n徙倚阶庭下，清风洒竹松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2568,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嘉莲呈瑞 其一","author":"区元晋","text":"偎红还倚白，并蕊却丫开。\n共比鸳鸯锦，宁知冰玉荄。\n同心临碧水，分影拭瑶台。\n岁岁东风好，秾华此借媒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2569,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嘉莲呈瑞 其二","author":"区元晋","text":"二仲堪谈宋，双姬谩拟乔。\n由来君子重，羞逐丽容销。\n色萃三峰秀，香传太液迢。\n相看两不语，犹恐涉尘嚣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2570,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长至写怀","author":"区元晋","text":"令节逢长日，呼儿具客觞。\n竹低风入户，梅绽雨鸣廊。\n云物凭新句，烟花付小航。\n曲生良知己，倾倒共茅堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2571,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬后赏菊","author":"区元晋","text":"朔风正浩浩，吹送菊丛秋。\n篱短看踰好，霜清坐更幽。\n馀香飞蛱蝶，清影落渔舟。\n花边评异品，能几薛居州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2572,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题熊文学比汉高翔卷","author":"区元晋","text":"梧桐当舜日，菶菶亦萋萋。\n朱鸟文方诞，灵雏羽复齐。\n云霄看远举，林薄笑卑栖。\n试问渊源自，承家几建溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2573,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日书怀","author":"区元晋","text":"安仁徒抚镜，季子岂无金。\n阅世真浮梦，乘秋且浩吟。\n云连低竹径，鹤舞破松阴。\n共打蒲团坐，同论出处心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2574,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"云洞小筑","author":"区元晋","text":"搀云三径辟，傍壑一亭开。\n自笑经营浅，聊从造次裁。\n移梅香带雪，帖石绿留苔。\n最喜溪临户，渔歌月下来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2575,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈守备饯古云寺即席赋此","author":"区元晋","text":"古刹来何世，高游适此时。\n山光还小榻，花影泛浮卮。\n蛮俗旋旋改，天机滚滚奇。\n百年弦管外，谁见武城碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2576,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过桃坡","author":"区元晋","text":"桃坡秋寂寂，何处觅桃花。\n霜冷山踰峻，云深路转赊。\n孤城馀毁堞，野戍隐寒笳。\n十载河阳客，于今鬓有华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2577,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过金鸡庙和何运使","author":"区元晋","text":"山樱丹晓露，岩竹净晨晖。\n古刹经时毁，金鸡隐雾啼。\n猿声依岭急，枫叶傍人飞。\n笑此皇华者，频年历翠微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2578,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重经梅岭 其一","author":"区元晋","text":"局蹐成何事，轩裳且委荣。\n岭梅惊岁月，驿使笑逢迎。\n吴粤到关柝，芙蓉入寺清。\n珠玑吾族旧，重过复留情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2579,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重经梅岭 其二","author":"区元晋","text":"野服寻丘壑，轻车命仆夫。\n水声听断续，山色看模涂。\n石径垂新柳，柴扉暗绿芜。\n幽禽如旧识，相对唤提壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2580,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"少野陈都阃留宴公署 其一","author":"区元晋","text":"顷者台星灿，祥光动四筵。\n风和燕语外，春满杏花前。\n调燮登商鼎，谋猷接燕然。\n共谈宾主美，嘉会正流传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2581,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"少野陈都阃留宴公署 其二","author":"区元晋","text":"将军富文藻，英论满华筵。\n笔落黄庭后，兵谈细柳前。\n风尘心惕若，尊俎兴翻然。\n笑指凌烟上，勋名合并传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2582,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郡伯曾西洲年丈诗翰见寄云中和答 其一","author":"区元晋","text":"朅来万里札，开拆岭云光。\n讶别岁频换，相思梅又香。\n秦机诗并锦，蜀茧字飞霜。\n翻忆杨雄宅，琼瑶几树芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2583,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郡伯曾西洲年丈诗翰见寄云中和答 其二","author":"区元晋","text":"珠江江上景，相忆是看花。\n进艇摇新月，垂丝漾晓霞。\n瑶琴招伴出，蜡屐入云斜。\n春近君居远，何时酒共赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2584,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早行","author":"区元晋","text":"客子苦行役，驱车未晓时。\n暗流惊断涧，残月挂疏篱。\n径僻鸡声渺，云连马首低。\n敝裘修露肘，犹待弄晨晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2585,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨行吕合道中","author":"区元晋","text":"树斜湍啮石，草没水平堤。\n跋涉移轻盖，崎岖策蹇蹄。\n雷声喧谷口，虹影卧桥西。\n烟火瀰茫湿，田家晚未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2586,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜沐公子莲溪宴集","author":"区元晋","text":"六郎莲比貌，公子貌莲花。\n物我无宾主，琴尊自岁华。\n西湖频入梦，净社未移家。\n坐爱溪边月，婵娟伴若耶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2587,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄龙山参戎燕楚威楼","author":"区元晋","text":"危楼高百尺，跻览快新晴。\n树锁千岩翠，岚收万井明。\n尊前倾俗虑，云外薄浮名。\n却笑琵琶索，能添饮后情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2588,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄陈总戎","author":"区元晋","text":"共说祭遵雅，绻怀虎帐深。\n长城方尔藉，梁父岂堪吟。\n泾渭从渠辩，淄磷适此心。\n独馀推毂念，戎马正沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2589,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庾岭道中","author":"区元晋","text":"东风吹小骑，胜事足幽寻。\n自分烟霞侣，频冥水月心。\n暖生茅店斝，清写碧溪琴。\n风度芙蓉外，凭高更一临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2590,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小金山寺","author":"区元晋","text":"珠林寻胜迹，閒忆十年前。\n野藾借僧鼎，山茶瀹涧泉。\n碑文残异代，花影寂禅天。\n却羡云边鹭，飞飞傍水田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2591,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初归小洞用周宪长赠行韵寄复","author":"区元晋","text":"閒知忙是错，今觉昔全非。\n贫病难抛酒，春寒亦典衣。\n照溪诗骨瘦，听谷履声微。\n到眼凫雏羽，花成已解飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2592,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵赏紫菊 其一","author":"区元晋","text":"霞影兼昏晓，花深转淡浓。\n雅情凌桧竹，娇态薄芙蓉。\n径僻幽宾屐，丛深隐梵钟。\n悠然今日趣，蜂蝶自相容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2593,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵赏紫菊 其二","author":"区元晋","text":"数株霜后菊，作意破玄冬。\n色带江霞丽，香浮朝露浓。\n短篱非所托，瑶席故相逢。\n桃李浑无赖，迎春献媚容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2594,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭侄效恭用高春元韵","author":"区元晋","text":"兰萎栽不长，玉毁恨徒深。\n谁念蹒跚日，空馀感慨心。\n文场虽角逐，病觉忽侵寻。\n月下思英爽，悲怀满素琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2595,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋莲 其一","author":"区元晋","text":"西湖当日卉，移占小溪洼。\n巧缀天孙锦，奇誇十丈花。\n迎风香泻露，照水晕生霞。\n窈窕谁家女，清歌起若耶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2596,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋莲 其二","author":"区元晋","text":"曙色开三径，寒烟抹一洼。\n閒临玉井水，相对舂陵花。\n意喜清含露，姿羞滟带霞。\n既名君子矣，犹似六郎耶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2597,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕","author":"区元晋","text":"袅袅双星会，萧萧七夕秋。\n会稀宁免叹，离速故生忧。\n灵匹云踪度，仙桥鹊影流。\n共乞天孙巧，谋身且未周。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2598,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莫春","author":"区元晋","text":"东园春又季，相赏日忘归。\n携酒逢花好，抽簪笑发稀。\n芳菲随意适，潦倒任时遗。\n何处莺声啭，池塘渐夏晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2599,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓行漫述 其一","author":"区元晋","text":"日有宵征役，柴门候月开。\n鸡声鸣埭社，渔火动江台。\n百巧劳何益，一閒事浪堆。\n平生山寺趣，僧睡晏忘催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2600,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓行漫述 其二","author":"区元晋","text":"星辰从兔歛，城钥报鸡开。\n马首萧萧径，云边隐隐台。\n飞萤疏自照，落叶暗还堆。\n笑尔罗浮约，难忘野客催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2601,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种瓜次韵","author":"区元晋","text":"种及三春日，文求五色时。\n每思蕃衍意，长诵摘稀词。\n蔓引欺墙矮，花交傍榻宜。\n青门何限兴，抱瓮日频移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2602,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小洞览游","author":"区元晋","text":"云霞生丽色，岩壑值幽时。\n田畯招炊黍，巾车命有词。\n习閒双鹤伴，寄傲一丘宜。\n莽莽观无始，翛然世虑移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2603,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和练江陶外史观僧艺植之作","author":"区元晋","text":"玄圃观僧种，多应异俗忙。\n避锄存蚁穴，注钵活蛙塘。\n日暖花生色，烟和叶解黄。\n崇朝探紫翠，淑气满篮筐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2604,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和答李山人","author":"区元晋","text":"凌晨歌箕谷，兴送远山峨。\n细雨御幽壁，高风引翠萝。\n溪清顾影静，花重借颜酡。\n别院茶烟湿，尤欣羽客过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2605,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕感怀","author":"区元晋","text":"世隔悬精爽，堂虚渺色声。\n岁从春共改，愁与涕交盈。\n竹忆鸾栖长，松栽马鬣生。\n青衫挥泪满，情绝不堪更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2606,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏梅和郑山人 其一","author":"区元晋","text":"别馆栖新旅，看花无故人。\n一枝开傍水，半榻玩思君。\n影寂低移径，香轻暗度津。\n陇头何处是，睇望又逢春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2607,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏梅和郑山人 其二","author":"区元晋","text":"雪风吹不断，义路索还猜。\n绝壑探踰远，幽涯独自裁。\n微吟频倚杖，清玩更凭杯。\n满目江村晚，踌躇不忍回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2608,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿知己诞日","author":"区元晋","text":"岳色低涵榻，潮生远泛杯。\n景当蓬矢丽，筵对画图开。\n窈窕朱颜壮，舒徐淑气来。\n香风吹綵服，春动隔溪莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2609,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"施东墅惠金纽丝菊赓谢","author":"区元晋","text":"疏篱添异朵，纽缀几丝金。\n共羡黄裳色，宁知白雪心。\n搀梅疏弄影，傍竹细传音。\n此意陶潜会，无言抚素琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2610,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和陈如心咏小舫落成 其一","author":"区元晋","text":"扁舟兴不恶，操弄且忘归。\n江溟穿云去，潮平载月来。\n沙汀閒狎鹭，紫陌厌谈鸡。\n睡足推蓬起，莺啼花外溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2611,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和陈如心咏小舫落成 其二","author":"区元晋","text":"一叶休言小，乘春可共移。\n探梅无近景，系柳有新诗。\n剡曲心频到，朱明梦屡飞。\n风光归遍览，不博子陵矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2612,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄寿次陶何丈诞 其一","author":"区元晋","text":"一缄开北海，三祝拜南山。\n桃忆同初熟，丹应共九还。\n黄金何待买，白日故须閒。\n花底年年醉，蓬莱笑语间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2613,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄寿次陶何丈诞 其二","author":"区元晋","text":"子真何处谷，望望隔云山。\n江迥心堪到，书重雁屡还。\n转添诗律细，应减酒杯閒。\n为讯乘槎约，宁忘八月间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2614,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早省黄云山","author":"区元晋","text":"仙城瞻昧爽，宿霭傍林开。\n翠重云连径，光涵玉映台。\n疏星萤共照，轻露叶还堆。\n寒食梨花遍，遥闻谷鸟催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2615,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺友弄璋","author":"区元晋","text":"共把悬弧酒，来斟玉树阴。\n果虽垂晚结，香自得春深。\n谢砌当时瑞，燕山旧日心。\n梧桐正菶菶，为尔发清吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2616,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"代柬复周司训见寄兼呈容太守","author":"区元晋","text":"伊昔平南别，于今日几旬。\n朅来书一札，还隔树千村。\n沛泽闻贤守，修仪称广文。\n何时同把手，孤屿酒微醺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2617,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对菊","author":"区元晋","text":"花应嫌兴浅，酒不负杯深。\n此意东篱外，还谁老圃吟。\n相扶秋有色，竞傲雪同心。\n为笑桃溪蝶，霜前舞得禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2618,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"薄蚀","author":"区元晋","text":"怪物翳天眼，昏林坠鸟飞。\n臣工同儆惕，匡救莫依违。\n挝击方停鼓，光芒已出扉。\n重瞳临八极，千载复虞辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2619,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入秋喜凉","author":"区元晋","text":"溪痕初出石，花影淡流云。\n率土忻回惫，何人苦救焚。\n汗颜今幸解，洽背昔羞闻。\n萧飒风飘裾，故人疑是君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2620,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蜜蜂","author":"区元晋","text":"青壁巢踰峻，低檐绕复频。\n风流花底迹，酿藉锦丛身。\n向日衙依竹，寻荒径度蓁。\n不应辛螫赋，为尔戒相亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2621,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜雨 其一","author":"区元晋","text":"黑云排白雨，奔涝溢清沱。\n久旱忧停酒，一霖欲当蓑。\n皱红舒浦荔，暗绿转郊禾。\n便制丰年曲，连床对客歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2622,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜雨 其二","author":"区元晋","text":"轻凉方霂霢，乱点忽滂沱。\n阶近吟迁榻，茅穿舞带蓑。\n千家妨岁率，百亩待登禾。\n明日耘应急，谁赓绿野歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2623,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端阳","author":"区元晋","text":"嘉辰临绿水，遗响听鸣蜩。\n共扫纷靡习，同歌浩荡朝。\n爱花留小酌，依竹数清标。\n老觉风光急，莲开菊又苗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2624,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郑过斋夏集小洞","author":"区元晋","text":"径开花日丽，帘捲竹风清。\n五亩园虽小，数椽兴自倾。\n南柯行蚁散，远渚浴凫明。\n却笑沧江客，渔蓑约未成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2625,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"万松居士汪佥宪乃尊号","author":"区元晋","text":"高士开轩日，栽松过万株。\n经营三径里，封植百年馀。\n白鹤归辽左，青龙奋海隅。\n岩廊收不尽，云雨更蒸濡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2626,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元旦","author":"区元晋","text":"晴旭正熙熙，和光渐竹扉。\n儿曹纷綵绮，歌舞慰衰迟。\n蓝尾篝新酒，桃符写旧诗。\n万年天子圣，共祝望丹墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2627,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]