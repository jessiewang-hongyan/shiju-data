[{"title":"晤连山令张羽皇率赠 其一","author":"释今无","text":"三年别我为官好，一度相寻春正深。\n乱后哀鸿方始集，对君真有太平心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48066,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晤连山令张羽皇率赠 其二","author":"释今无","text":"连山万仞石嵯峨，作宰还如作客过。\n旧日布袍犹自着，晴岚湿气较谁多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48067,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮道中","author":"释今无","text":"石楼大小洞云铺，乱后仍寻兴倍孤。\n彩凤出岩光突兀，眠犀当涧草模糊。\n铁桥空际全无路，琪树天边别有壶。\n愧对仙山人易老，黄芽何处觅丹炉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48068,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送止言澹归两公先入栖贤","author":"释今镜","text":"俱出烽烟外，深山随所之。\n溪声初洗耳，雪色动扬眉。\n草没安禅稳，人稀乞食迟。\n茅茨宽结构，待我隔秋期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48069,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜独步","author":"释今镜","text":"静夜寡俦侣，行行疏磬飘。\n素怀江月近，破衲晚风招。\n随意惟残夜，回头是断桥。\n因知天地内，万籁一无聊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48070,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠冯紫光游","author":"释今镜","text":"满天风雪下，怜汝独行人。\n旅食嗟何晚，寒衣薄过春。\n他乡言语拙，失路性情真。\n今古悲游子，谁为激入秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48071,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送见一公还栖贤","author":"释今镜","text":"约君投老是匡庐，金井埋头愿不虚。\n松未成阴归计早，雪犹当路客途纡。\n休惊屋破藏冰柱，好借窗明读梵书。\n行爱清冬风日美，白云深处莫踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48072,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送万赖公出岭","author":"释今镜","text":"霜天只有雁南飞，何事苍凉又别离。\n今日共伤杨柳尽，明年遥忆杜鹃期。\n频经野戍人多识，历上重滩路较迟。\n一钵自谙云水冷，乱峰孤影独行持。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48073,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五律　　　　　　　　　　　　　　　　　　　　　　　　　　夏日养病芥庵作","author":"释今严","text":"有身长作客，无地不言家。\n旧寺辞芳草，閒庵过落花。\n忘机为好友，省事是生涯。\n借得昆陵集，长吟到日斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48074,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春日作","author":"释今严","text":"晓起石桥望，空怜物色新。\n鸟声先客梦，云气湿轻尘。\n岁月同谁老，江山此日春。\n茫茫荒陇上，寒尽几归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48075,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏冬月恭祝本师和尚同赋","author":"释今严","text":"皎然凝静夜，万象此森森。\n素色浑江汉，寒辉自古今。\n劬同冬日爱，肃若秋霜深。\n光景徒劳仰，临风但写心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48076,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春晓望","author":"释今严","text":"钟晓低残月，春光满板桥。\n水流溪梦断，烟入鸟声消。\n短草未成色，长杨始着条。\n微茫村陌迥，客影去迢迢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿广城制止寺闻菩提叶声作","author":"释今严","text":"苍苔东晋殿，嘉树六朝馀。\n叶向春风老，声飘秋雨初。\n虚堂清磬断，高枕客情疏。\n遥想山中夜，长吟一草庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过宝积寺探景泰禅师卓锡泉","author":"释今严","text":"地辟萧梁代，幢标南汉年。\n登临吾辈重，怀想古人贤。\n宴坐消长昼，清言入暝烟。\n更忻情所乐，一饱杖头泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王麓曾归湖南","author":"释今严","text":"家世旧风流，言归古石头。\n不知王粲后，若个复登楼。\n巴峡孤猿暮，湘沅一水秋。\n何时揭瓢笠，来与子同游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中吟","author":"释今严","text":"十载三朝里，孤峰五夏僧。\n开扉怜月堕，抚竹看云兴。\n黯黯何所极，冥冥天欲层。\n草堂清兴发，遥见下方灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中寄王说作","author":"释今严","text":"万缘轻一病，委志卧高岑。\n月到閒窗小，云连芳草深。\n死生怜短梦，忧乐负长吟。\n念子沧江上，遗予契阔心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花 其一","author":"释今严","text":"玉立烟霞外，天长望欲穷。\n窥人一眼白，映雪万山空。\n素色开残夜，疏枝待晓风。\n别馀孤冷意，不与水云同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花 其二","author":"释今严","text":"独有庾关早，从来不识春。\n谁言云外影，堪寄陇头人。\n逸士多相见，孤僧少所亲。\n落花时又到，珍重百年身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花 其三","author":"释今严","text":"腊残衰草尽，极目一空林。\n阅岁同为客，淩霜花自深。\n韵添孤月冷，色有白云侵。\n落落千峰顶，清猿时一吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花 其四","author":"释今严","text":"寒香日以远，瘦影日应疏。\n只此情何限，令人思有馀。\n雪残浑欲老，春色可谁如。\n石上閒相对，无言又起予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花 其五","author":"释今严","text":"野怀何所寄，馀梦到寒梅。\n云散高楼晓，孤筇踏雪来。\n远看空极目，相对但持杯。\n坐久日将暝，长天一鹤回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏夜独坐","author":"释今严","text":"积雨初晴夜，东窗见月痕。\n孤怀只自委，此意与谁言。\n愈病非关酒，忘忧不在萱。\n最思支许辈，秋水细评论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石人峰腊月菊花","author":"释今严","text":"敛息危峰坐，落英满涧阴。\n重矜柔弱质，亦得岁寒心。\n根不寄篱下，香能待雪侵。\n何人餐不尽，起我一长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上巳日彭泽阻风","author":"释今严","text":"高士休官处，孤僧羁旅初。\n江山逢上巳，风雨望匡庐。\n炊黍折残荻，长吟寄老渔。\n此时山际寺，谁拟赋閒居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伐木吟四首 其一 怀即公","author":"释今严","text":"一瓢乞食处，双眼独看云。\n长读方山论，时翻般若文。\n阐幽知有待，析义恨无君。\n预拟还山日，煨寒到夜分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伐木吟四首 其二 怀诃公","author":"释今严","text":"一从溪上别，幽独迥无邻。\n性以孤能寂，心从冷处亲。\n听莺迟好友，临水叹伊人。\n亦是寻常事，兴怀每怆神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伐木吟四首 其三 怀顿公","author":"释今严","text":"如我与君者，当于幽壑中。\n一生煨白石，终日倚青松。\n岂敢尚高节，所为哀道穷。\n狂澜息不易，聊得古人同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伐木吟四首 其四 怀破公","author":"释今严","text":"窗虚月影暗，微雨响疏疏。\n不觉伤留滞，翻然念起居。\n道心知日损，瘦骨近何如。\n江上几惆怅，都为欲寄书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寓虎丘作","author":"释今严","text":"姑苏最佳处，况复好春晴。\n尘榻有人假，春山尽日行。\n顿忘留滞苦，渐觉野情生。\n夜到讲堂上，空吟月正明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金井潭观游鱼","author":"释今严","text":"日动畏高影，应嫌水至清。\n鼓琴人已往，濠上叹方生。\n我丧残同域，尔无哀乐情。\n寂寥天地内，持此向谁鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"首春过南昌访徐巨源","author":"释今严","text":"南州高士后，孤隐石门閒。\n两载期相见，方春始下山。\n文章颜谢侣，风致应刘间。\n未得看中论，踌躇空往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长至芥庵作","author":"释今严","text":"年来师友散，物序一伤怀。\n况复逢寒腊，栖迟在海涯。\n同人过午食，与鹤立閒阶。\n料得从今去，生缘有石崖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲午元旦","author":"释今严","text":"万井烽烟里，偏逢淑景明。\n不知天地意，徒有古今情。\n池柳侵寒色，山禽变野声。\n遥怀匡岳顶，晴雪衲衣轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同喻如寻曾湛师黎务光王人土山馆","author":"释今严","text":"得閒多病后，微雨乍晴初。\n不远荒村路，来寻高士庐。\n饱残新熟荔，剪断覆畦蔬。\n送我还山去，关门又读书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日过诸子村居留赠","author":"释今严","text":"入门暂相见，不负昔年闻。\n师友一堂内，须眉各自分。\n种松怀夜月，开阁待秋云。\n语及安心际，蹉跎欲愧君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨夜送友人先还雷峰","author":"释今严","text":"风雨苦残春，如何重别人。\n几杯清茗后，一榻独閒身。\n烟水劳予梦，慈容羡尔亲。\n故山明月夜，应念绿薇贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48102,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"何仙姑祠","author":"释今严","text":"遗庙看尘像，仪容异昔年。\n古泉空履迹，衰柳但春烟。\n达士同伤逝，浮生信惘然。\n尚馀名在石，留得世间怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48103,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜坐","author":"释今严","text":"脉脉情何似，微微一两蝉。\n夏云高岭没，秋气草堂先。\n鹤怨初残梦，鸡鸣欲曙天。\n年来多肺病，彻夜不成眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚寅三月 其一","author":"释今严","text":"寂历空山春鸟啼，孤城遥望海天齐。\n东郊战马嘶寒戍，南浦楼船锁大堤。\n血染燕台谁恸哭，笳吹粤岭尽流涕。\n明朝又是逢寒食，一曲长谣日已西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚寅三月 其二","author":"释今严","text":"日落黄云万井阴，临流一望欲沾襟。\n可怜蓟北春风起，吹向江南绿树深。\n壮志已消金虎梦，何人方作卧龙吟。\n海门几月重围里，芦荻渔歌自古今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西村道中","author":"释今严","text":"平原一望几人过，野衲行行且放歌。\n燕麦已残香稻秀，女桑犹共绿杨多。\n挹瓢泽畔频餐水，招手渔人欲渡河。\n此去蓝田有逸士，北窗高卧意如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"崧台夜泊","author":"释今严","text":"野色苍茫日易昏，萧条风物似梁园。\n数声鼍鼓催残月，一派铜刁乱海门。\n玉殿暗销秋草醉，平台长共暮云屯。\n重华寂寞湘江冷，梦到苍梧亦断魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春重访岑隐者兼呈李拾遗","author":"释今严","text":"蹑屐重来访避秦，狂歌曾此傲风尘。\n溪声磕磕听如昨，草色离离看又春。\n谢墅幽林长绝俗，吴门高士偶为邻。\n绮园未必全疏懒，今日因君识古人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题陈氏隐居","author":"释今严","text":"我亦锄云共世忙，叹君先此老农桑。\n风尘不到幽人梦，岁月翻从高卧长。\n买醉一区全艺秫，种园千日学浇篁。\n前溪野客时相过，閒煮梅花濯晓霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出苍梧趁舟东归不及","author":"释今严","text":"风烟冷我买山情，归思逢春日夜生。\n闻道片帆临涨海，飘然一杖出孤城。\n萧萧古渡空林晚，浩浩长江锦石横。\n怅望东南无限恨，雨残云暗鹧鸪鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再出梧州趁舟东归不及","author":"释今严","text":"惆怅江头又一回，恁高聊当望乡台。\n暮云漠漠沉归雁，细雨濛濛暗绿苔。\n万顷烟波渔唱断，百年孤驿野花开。\n春光到处看如此，独我长吟去复来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿水月宫迟舟东归","author":"释今严","text":"迢遥几度到江头，江上萧条昔日愁。\n远近绿芜深破院，微茫烟水老渔舟。\n残云断尽天逾阔，好月初来望似秋。\n今夜且同鸥鹭宿，明朝应与逐东流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋蝉","author":"释今严","text":"哀响凄清断复分，幽岩野客最先闻。\n残秋几老吴宫月，薄暮曾低楚国云。\n万里白杨浑漠漠，千峰黄叶正纷纷。\n那堪羁旅登临处，衰草连天一古坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日苦雨","author":"释今严","text":"寒响终宵似急湍，溪湖汀渚总瀰漫。\n福田衣重水文暗，曲录床平木理宽。\n鱼过石梁频点额，笋穿茅屋渐成竿。\n乍晴欲上前堤望，蜡屐迟迟行路难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峒山寺望厓门作","author":"释今严","text":"西峰閒院瞰厓门，宋室君臣旧殿存。\n寒尽但闻归海燕，春残谁为荐江蘋。\n每于楚泽行吟苦，想见田横得士恩。\n一自清笳吹断后，几回风雨怆哀魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观春燕有作 其一","author":"释今严","text":"傍檐依户语喧喧，似却如前势欲翻。\n弱羽岂能栖画栋，孤飞只合向蓬门。\n不知旧宅归新主，但到深春忆故园。\n莫讶华堂空有梦，肯容相近即深恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观春燕有作 其二","author":"释今严","text":"差池群起逐朝晖，乍得随风入绣闱。\n遥望柏梁频自语，却怜朱户几翻飞。\n春秋代序身长客，毛羽飘零意暂违。\n金殿玉楼都莫羡，衔泥且向草堂归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观春燕有作 其三","author":"释今严","text":"帘外呢喃若感恩，黑衣憔悴意空存。\n正伤东府非王谢，肯向昭阳托梦魂。\n松径易衔新草色，粉墙难叠旧巢痕。\n微生暂寄曾何定，一夜秋风归海门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"百合诗 其一","author":"释今严","text":"石壁西边古涧东，绿陂浓荫隐香风。\n孤根寄去一丘外，素蕊开时六月中。\n嘒嘒晚蝉山寂寞，泠泠疏磬月朦胧。\n閒心此际分明极，玉质幽香迥不同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"百合诗 其二","author":"释今严","text":"未得芳名挂楚辞，都缘清绝畏人知。\n休誇玉树临风好，想见红蕖映日时。\n姑射山头空有梦，蕊珠宫里正相思。\n可怜影没荒岑外，惆怅残阳欲待谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"百合诗 其三","author":"释今严","text":"暗香浮动又斜晖，几度临风入素闱。\n名士握来当玉麈，仙人携去绽云衣。\n木兰形似神偏瘦，杜若芳同体较肥。\n相对每宜人定后，夜钟微月屡开扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"百合诗 其四","author":"释今严","text":"不堪鶗鴂最先鸣，冒雨开残暑未清。\n檐卜将来何所似，优昙恐是有虚名。\n白云只可自怡悦，流水翻能移性情。\n一自与君投分后，几多怀抱付他生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟过飞来寺","author":"释今严","text":"乱峰历尽见荒岑，胜事当年不可寻。\n古佛有光随日转，石幢孤影向江深。\n未秋高树先摇落，薄暮疏蝉空好音。\n身似萍蓬何所感，忽然又作越人吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日同梵音留滞乌径山庵戏作","author":"释今严","text":"天南七载一孤僧，只有良朋念不胜。\n才折莲花辞海国，拟将秋色到毗陵。\n风烟负我登临去，羁旅伤人岁月增。\n荒径绕残山月堕，微微寒影佛前灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"栖贤寺寄怀顿修诃衍 其一","author":"释今严","text":"尝疑别赋销魂语，道是江淹好过情。\n千日离思惟有梦，十年怀抱始相应。\n每从天际窥帆影，想见虚廊忆履声。\n吴越江山不可问，那堪重与话三生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"栖贤寺寄怀顿修诃衍 其二","author":"释今严","text":"迟日空山感易生，依稀犹记别时情。\n梧桐一叶罗浮寺，砧杵千家雁翅城。\n高树远峰寒月影，暗虫疏雨夜钟声。\n此时拟赋思君咏，直至召集始得成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杪冬登玉川门 其一","author":"释今严","text":"才过粤岭已闻名，漱石空怀两载情。\n乘兴顿忘冰雪色，望来渐觉骨神清。\n嵯峨石势危城出，澎湃溪声春雨平。\n心目屡分无可似，寒灯疏磬月微明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杪冬登玉川门 其二","author":"释今严","text":"浑身浴雪一登临，不负多年山水心。\n门瞰烟波当月出，帘垂风雨听龙吟。\n层崖但见苔痕旧，绝壑长如秋气深。\n几度欲歌招隐曲，恐惊幽客夜相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁酉初春登滕王阁 其一","author":"释今严","text":"胜标藩国千年后，行客登临每在兹。\n栏槛喜看新黛色，风流想见盛唐时。\n东风遥忆锦帆疾，羌笛翻怜玉佩迟。\n堤柳渐随芳草绿，长江依旧镇南垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁酉初春登滕王阁 其二","author":"释今严","text":"寻常帝子旧经营，代远弥深过客情。\n铜爵当时已寂寞，灵光此日但空名。\n烽烟乍断虚窗迥，井邑初移画阁成。\n未必南州真好事，子安词赋胜祢衡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁酉初春登滕王阁 其三","author":"释今严","text":"乱后莫轻寻往迹，多情是处即沾巾。\n廿年笳管江南国，一代豪华塞北尘。\n临渚远观鱼吹浪，倚栏乍听鸟鸣春。\n可怜立马吴山后，犹有登楼清咏人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]