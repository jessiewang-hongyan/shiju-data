[{"title":"寄吕山人用韵","author":"杨巍","text":"残冬仍寄食，念尔老无家。\n迹尚如飘梗，情多似乱麻。\n绨袍谁见赠，鲁酒自应赊。\n闻作王门客，笔头想梦花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33339,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"病中曹子见过","author":"杨巍","text":"长日闭门卧，衰年懒读书。\n贫惟安所遇，道欲识其初。\n鹤迹山房满，松声药院疏。\n不因君问病，谁肯过吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33340,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日刘别驾偶过","author":"杨巍","text":"近午犹高卧，小车说到门。\n披衣迎好客，问妇有清尊。\n市远盘餐少，秋深松菊繁。\n文章与出处，身外不须言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33341,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中和张山人怀归越中","author":"杨巍","text":"故里何年别，鱼书隔岁沉。\n囊无十日费，鬓有二毛侵。\n交谊原非浅，酒杯莫厌深。\n西园听雨处，还似越江浔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33342,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和吕山人遂初堂韵","author":"杨巍","text":"茅堂得词客，相对两忘机。\n以彼心常逸，惭予病始归。\n渔樵元旧业，荷芰有初衣。\n堪向此中老，回头万事非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33343,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄淮阳张给事","author":"杨巍","text":"予多张季鹰，行与古人并。\n谏主曾焚草，为诗独擅名。\n淮阳山水郡，海上薜萝城。\n见面何由得，空劳梦寐情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33344,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日忆亡弟岩","author":"杨巍","text":"自汝弃予后，出门益觉难。\n无人陪笑语，对酒独悲酸。\n荆树霜中老，鹡鸰原上寒。\n茱萸虽满把，含泪不能看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33345,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"醉卧读高苏门诗","author":"杨巍","text":"閒居长是醉，高枕任吾欹。\n懒慢心方得，蹉跎老岂知。\n北窗风到处，深树鸟鸣时。\n世事一无好，犹耽陶谢诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33346,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"越中三高士饮王左史庄赠此","author":"杨巍","text":"左史能延客，况闻高士名。\n盘桓辋口墅，登眺古时城。\n听鸟管弦废，看花罗绮轻。\n夕阳犹未返，应待月华生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33347,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南园刈麦","author":"杨巍","text":"刈麦向南圃，城中不异村。\n晴风低乳燕，夏日满衡门。\n岂独糊家口，且思供酒樽。\n生涯谁谓薄，郭外有鸡豚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33348,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日野塘泛槎","author":"杨巍","text":"十亩野塘里，浮槎亦胜游。\n不知三伏暑，浑似五湖秋。\n映酒垂红蓼，傍人起白鸥。\n因思西里泊，毒雾若为愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33349,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中客自济南惠石与竹榴","author":"杨巍","text":"移将华顶石，寄我海边村。\n已适乐山意，况兼花木繁。\n风光分北渚，雨气满西轩。\n从此获三益，恍同静者言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33350,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题赵子冲玄稿","author":"杨巍","text":"嗟君狂者流，一第竟悠悠。\n见客少青眼，吟诗欲白头。\n溪山无世态，花鸟共春愁。\n从此声名著，前身赵倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33351,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨夜董信溪过访","author":"杨巍","text":"卧病沧江上，柴扉昼不开。\n况兹风雨夕，乃有故人来。\n绕屋吟黄叶，疏灯照绿苔。\n平生丘壑意，共尽掌中杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33352,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋晚桃岭再集","author":"杨巍","text":"已过重阳日，风高寒更催。\n菊残犹待客，病后尚登台。\n万木霜中落，浮云天际来。\n祗应拚一醉，骑马夜深回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33353,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日","author":"杨巍","text":"春日更多情，风吹杖履轻。\n欲聆黄鸟啭，独傍绿杨行。\n远甸阴云合，孤村花木荣。\n偶然逢野老，邀我坐柴荆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33354,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送孔松崖道者","author":"杨巍","text":"是吾夫子后，自幼独修仙。\n心注形骸外，道窥天地先。\n蓬莱知远近，岁月自推迁。\n惆怅此时别，归来几百年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33355,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送程尉还蜀","author":"杨巍","text":"与君万里别，忍见柳条春。\n已恨罢官早，兼悲为客贫。\n猿声来峡口，草色暗江津。\n想就严平卜，行藏不在人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33356,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"起巡抚陜西","author":"杨巍","text":"一身曾许国，讵敢顾其私。\n捧檄宁不喜，绝裾还自悲。\n朝廷多难日，臣子请缨时。\n早晚干戈定，归来慰母慈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33357,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冬日喜韩纪善过访","author":"杨巍","text":"叹尔王门客，长裾未著身。\n游梁终授简，访戴愧非人。\n雪散遥林色，杯倾大海滨。\n不须论出处，南北正风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33358,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"安邑逢阎给舍二首 其一","author":"杨巍","text":"青琐同趋日，声名汝独先。\n别来多岁月，老去阻山川。\n杯酒还今夕，风波忆往年。\n五云回首处，相对一潸然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33359,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"安邑逢阎给舍二首 其二","author":"杨巍","text":"闻君高卧处，门向翠微开。\n野径葡萄熟，山桥麋鹿来。\n閒居应作赋，治世孰怜才。\n余亦思归者，沧江有钓台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33360,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"早秋登龙门城楼二首 其一","author":"杨巍","text":"朔塞楼频倚，新秋天乍晴。\n云山兼日色，鼓角带边声。\n路有元人辙，台馀汉将名。\n杨公石柱在，极目旧开平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33361,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"览壁间北岳诗忆旧游","author":"杨巍","text":"绝顶曾独上，乘风凌紫烟。\n采芝秋峪里，谒帝夕阳边。\n瑶阙频回首，尘寰动隔年。\n弃官何日去，空诵白云篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33362,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"经顺圣川","author":"杨巍","text":"野旷行人断，风高戍鼓鸣。\n青山邻巨敌，白日闭孤城。\n戎马千年地，江湖万里情。\n不堪征战后，极目一沾缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33363,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过响水堡","author":"杨巍","text":"塞水合流处，声喧十里繁。\n乍闻堪动色，相对未能言。\n束峡鼋鼍怒，惊涛日月翻。\n祗应阻边马，不得入中原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33364,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"即事","author":"杨巍","text":"世事浑无补，归心祗昼眠。\n飞来何处雨，一洗汉山川。\n海宇丰登日，宰臣罢去年。\n单于犹未歇，谁为勒燕然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33365,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答王少参见怀","author":"杨巍","text":"我岂扬云侣，君同王粲贤。\n愤时应仗酒，投老是何年。\n扰扰干戈地，凄凄雨雪天。\n不堪客舍里，独诵鸟鸣篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33366,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"对山亭雪后","author":"杨巍","text":"云带高峰好，况于雪后看。\n澹烟飘户牖，清景似江干。\n塞远人稀到，亭孤岁自寒。\n独愁防戍者，犹未解征鞍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33367,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"小天门","author":"杨巍","text":"叠嶂回环处，桃源恐在兹。\n云从马足起，藤向树头垂。\n涧水喧迎客，岩花笑索诗。\n殷勤留姓字，记我独来时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33368,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同王少参游清虚观四首 其一","author":"杨巍","text":"径转孤峰外，霞明仙苑边。\n瑶华开几世，丹灶闭多年。\n洞古云长合，堂虚日独悬。\n登临有王烈，共咏紫芝篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33369,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同王少参游清虚观四首 其二","author":"杨巍","text":"逸思驾天风，飘飖出半空。\n山川云日里，楼阁画图中。\n洞隐千年鹿，潭飞万里鸿。\n平生慕仙迹，此地即崆峒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33370,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同王少参游清虚观四首 其三","author":"杨巍","text":"金扉凌倒景，玉女俨层台。\n地静人同鹤，峰奇锦作苔。\n乱云行处起，清吹坐中来。\n仙驾杳不至，谁将宝箓开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33371,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同王少参游清虚观四首 其四","author":"杨巍","text":"山晚鸟犹吟，穷幽此日心。\n危途愁作客，胜境欲抽簪。\n紫涧松风满，瑶坛花雾深。\n归来应梦到，缥缈翠云岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33372,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"边城见燕子","author":"杨巍","text":"寥落边城里，还看燕子来。\n主人宁见妒，蓬户定频开。\n地迥巢难就，风寒羽易摧。\n翩翩怀旧侣，何处傍池台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33373,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"左卫秋日候王杨二君不至","author":"杨巍","text":"关云看欲暝，离思我何如。\n野烧惊沙雁，霜风落塞榆。\n论文心正切，筹敌计犹疏。\n不醉今宵酒，空传前日书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33374,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日寄王少参","author":"杨巍","text":"可惜重阳候，年年客里过。\n登临吾不惬，怀抱尔如何。\n落日黄榆满，悲风紫塞多。\n无由一缩地，把酒慰蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33375,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日登高","author":"杨巍","text":"已作云中客，更登塞上台。\n风尘回老眼，节序托深杯。\n碧海雁行断，阴山雨气来。\n故园今日菊，惆怅向谁开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33376,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春斋漫兴","author":"杨巍","text":"远地无人到，春风忆故林。\n傍檐独鸟啭，积雨众芳深。\n中散琴为侣，山公酒是心。\n欲骑黄鹄去，万里孰能寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33377,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日怀西石王宪副","author":"杨巍","text":"塞上同游处，经秋不见君。\n酒杯谁共把，书札旷相闻。\n木落阴山雨，沙昏瀚海云。\n干戈仍未息，一倍惜离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33378,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日再登鸡鸣山","author":"杨巍","text":"去岁寒仍夜，今来春且晴。\n再登谙道路，高眺转分明。\n斥堠通沙碛，山川拥帝京。\n祗怜征战后，不听有鸡鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33379,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送郭参将振赴淮阳总戎二首 其一","author":"杨巍","text":"分阃向南州，王程不可留。\n九边名已著，三楚战应休。\n蓬断狼山野，烟昏蜃海楼。\n平生许国志，把酒看吴钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33380,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送郭参将振赴淮阳总戎二首 其二","author":"杨巍","text":"推毂权方重，陇西名素高。\n樽前歌杕杜，海上望旌旄。\n未战谋先定，临时气自豪。\n威声已飞去，白日静波涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33381,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过杨伯起墓","author":"杨巍","text":"予亦关西裔，长年仰素声。\n之官过古墓，采藻荐先生。\n华岳开平野，桃林有故城。\n如何千载后，独以四知名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33382,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"环县早行","author":"杨巍","text":"边塞平无日，沧江未拟还。\n灯前梳白发，马上梦青山。\n薄曙群峰外，残星杳霭间。\n鸡鸣问何处，已过古萧关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33383,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题龙门图送温侍御还朝","author":"杨巍","text":"叠浪下危岑，谁言禹凿深。\n群龙斗白日，客子发孤吟。\n怒损三川气，愁关天地心。\n凭君为砥柱，到海万波沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33384,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山中见野菊","author":"杨巍","text":"是处秋能到，山寒菊亦开。\n香偏凝涧壑，根故远池台。\n不入神农谱，翻令田父猜。\n陶家三径里，忆尔赋归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33385,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"永寿道中","author":"杨巍","text":"不知山县处，忽听午时鸡。\n城郭到方见，烟云看渐低。\n人疑勾漏令，地即武陵溪。\n正是花开日，香风趁马蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33386,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"出塞","author":"杨巍","text":"一望祁连北，沙黄昼不分。\n沿山皆汉帜，隔水是尘氛。\n风劲霜雕入，碛寒野兕闻。\n髑髅啼白日，犹似怨将军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33387,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"萧关北作","author":"杨巍","text":"塞路山难断，天愁云不开。\n遥惊戍火起，数见羽书来。\n周室朔方郡，唐家灵武台。\n客心正多感，羌笛暮堪哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33388,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿瓦云驿","author":"杨巍","text":"萧条来野馆，秋草正凄凄。\n复此闻风雨，兼之厌鼓鼙。\n经年阶树老，入夜怪禽啼。\n独坐生归思，田园渤海西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33389,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆老母","author":"杨巍","text":"吾母八旬外，其如游子情。\n正宜怜短日，犹自恋浮名。\n马为看云驻，诗因陟屺成。\n谁云须禄养，江海有袁闳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33390,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪霁游天界寺","author":"杨巍","text":"满寺皆山色，房房带薜萝。\n松篁宁厌密，钟磬翻嫌多。\n楼压云边树，池通江上波。\n诸天新霁雪，乘月更宜过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33391,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"斋宿对雪同王云泽侍郎","author":"杨巍","text":"江国欣逢雪，飘飘度石城。\n丛篁声欲碎，粉署眼偏明。\n共慰祈年意，仍高作赋情。\n不知剡水曲，谁掉夜舟行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33392,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谒孝陵","author":"杨巍","text":"未晓谒松楸，俨如拜冕旒。\n千山环閟室，一剑定神州。\n王气深钟阜，天威肃暮秋。\n登高望不极，日夜大江流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33393,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题武进杨鹅山写真障子其子为锦衣","author":"杨巍","text":"早岁游江县，常时忆太湖。\n草玄亭在否，松月夜仍孤。\n未遂云龙志，空留冰鹤图。\n传家欣有子，名列执金吾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33394,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿回龙观","author":"杨巍","text":"沙际开瑶馆，銮舆几度过。\n日回双阙迥，云傍九陵多。\n承露空仙掌，沿阶自绿萝。\n夜深清吹发，犹忆旧鸣珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33395,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游大慧寺同李行人熹任计部铠罗廷评节汪山人渊赋","author":"杨巍","text":"花垂萝洞口，树满碧云层。\n对境疑为梦，前身恐是僧。\n楼台依北阙，经论有南能。\n却恨相过晚，登临意不胜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33396,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同舒司寇登城西真如寺塔","author":"杨巍","text":"宝塔共登临，遐观遂此心。\n海山开万里，烟霭净千林。\n凤阙瞻逾近，龙宫视转深。\n漫言离色界，花雨惹衣襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33397,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同朱金庭僚长扈跸宿瓮山寺","author":"杨巍","text":"野寺临寒渚，僧房依暮山。\n不因扈仙跸，那得叩禅关。\n朗月旌旗近，严更钟梵閒。\n况同朱仲晦，高论碧云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33398,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日送王学博之颍","author":"杨巍","text":"鲁南即是楚，谁谓客程遥。\n赤日时方急，青毡兴自饶。\n花开三户地，门对七星桥。\n欧子读书所，西湖迹未销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33399,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谒长陵","author":"杨巍","text":"勋业仰重华，园陵是帝家。\n山高逼象纬，地险镇龙沙。\n风雨诸灵谒，松杉万涧赊。\n为埋弓剑处，五色见云霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33400,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"饮谷司马荷花池","author":"杨巍","text":"不到濂溪上，谁知花正开。\n清临明月浦，美映九莲台。\n过雨看逾好，无风香亦来。\n眷兹君子德，日暮更衔杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33401,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过井陉淮阴侯祠","author":"杨巍","text":"将军破赵处，颓庙依荒山。\n伏腊几人往，旌旗到死閒。\n碑横秋涧草，路入土门关。\n过客空词赋，干戈有愧颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33402,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过灵石淮阴侯祠","author":"杨巍","text":"一庙荒如此，曾登上将坛。\n功高能盖世，名重不辞官。\n魍魉夜岩啸，薜萝秋径寒。\n全身兼报主，惆怅古来难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33403,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"临城逢贾少尹","author":"杨巍","text":"下邑均田日，高才众所推。\n岂期淮泗上，复见凤鸾姿。\n海运终难讲，河漕要众思。\n君家三策在，定不负明时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33404,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"屋成","author":"杨巍","text":"一屋营方罢，倏焉到夏初。\n正堪蔽风雨，亦足贮琴书。\n绿树当门合，閒心与世疏。\n久无羊仲过，径草不须锄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33405,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送无名道人还楼子庄","author":"杨巍","text":"满地寒云色，悲君欲远游。\n何方非梦境，随处有丹丘。\n汉岛孤烟暝，秦台万木秋。\n他年道成日，鹤驾再来不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33406,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"村中大雪","author":"杨巍","text":"雪意满林皋，寒深兴转豪。\n寻诗心独苦，访戴思多劳。\n雀堕梅枝亚，鹤盘松顶高。\n村家门尽掩，隔壁问香醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33407,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"读道书","author":"杨巍","text":"焚香草阁里，隐几读丹书。\n未解壶中秘，聊窥物外虚。\n青林栖白鸟，绿水跃红鱼。\n此际无人语，云消月上初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33408,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]