[{"title":"两过德州未谒董子祠诗以志过","author":"邵宝","text":"地产醇儒郡有光，两来犹未谒祠堂。\n春秋义已传迁史，谊利心曾辨粤王。\n拜位定依庭柏影，荐仪空托沚蘋香。\n孤城回首风尘里，读罢遗书送夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46454,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再至德州","author":"邵宝","text":"奉使南来又德州，僧堂还记旧淹留。\n星明北极天初霁，风扫中原雾已收。\n野旷尚馀千里水，漕荒应负一年秋。\n咨询未尽皇华体，赋罢䍧羊独倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46455,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沧州闻官军之捷寄兵侍陆公","author":"邵宝","text":"露檄传来捷是真，沧州南望正劳神。\n功成鲁国追戎地，断许唐年入蔡人。\n有梦维鱼应得水，此风何草不回春。\n北辰瞻仰朝廷近，欲拟韩诗献紫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46456,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再过清献祠","author":"邵宝","text":"江回春水没荒矶，石上看诗记旧题。\n吾道百年开白日，公心千古映清溪。\n鹤留古貌何妨瘦，松长新枝尚恨低。\n却忆昔游如昨日，楚云遥接越东西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46457,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次吴太史雪中见寄","author":"邵宝","text":"玉河东下似山阴，骑马如船雪满襟。\n吏散偶忘前日约，诗来真见故人心。\n寒侵松骨知多少，春入梅腮定浅深。\n欲赋琼瑶报佳贶，独怜才短负知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46458,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吊李憩庵公墓次庄定山","author":"邵宝","text":"萧萧宰木昼呼风，旧垄新阡北又东。\n防墓未须修孔氏，泷冈真合表崇公。\n两朝一德功何自，五岁三封眷未终。\n更爱颂声金石在，碧天无际水无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46459,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻陈行之讣","author":"邵宝","text":"俗学如俳到十分，玉溪高兴漫超群。\n著书笔自何时阁，曳杖歌从昨夜闻。\n绝壁倚云青未了，落花带雪白还纷。\n哀吟一曲无人和，拟向西山更哭君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46460,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠祝惟贞致仕南还次陈一夔","author":"邵宝","text":"鹤骨棱棱苦为诗，年来此癖已成奇。\n与君抚卷俱陈迹，及我登坛竟后期。\n听鸟有情嗟反哺，折花无语赠将离。\n文星夜夜天南极，千里长吟寄所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46461,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"通州留别李都宪惟正","author":"邵宝","text":"潞河堤上望浑河，诸老追随几度过。\n春兴有馀三月小，夕谈无数十年多。\n东郊正尔歌灵雨，南浦何须赋渌波。\n边马不嘶青草阔，中丞问俗意如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46462,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白鹿洞三首 其一","author":"邵宝","text":"五老峰前数亩宫，坐凭云水镇南东。\n山人骨相千年外，洞主心期一赋中。\n题壁定知谁不朽，望洋真觉我难穷。\n太山顶上蓬莱近，何处青鸾欲御风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白鹿洞三首 其二","author":"邵宝","text":"青山坐我对青衫，吊古情多漫与谈。\n眠鹿已无人主洞，卧龙空有地名庵。\n百年讲坐惭虚左，万里驱车愿指南。\n吹醒清风天未晚，共谁长笑破烟岚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46464,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白鹿洞三首 其三","author":"邵宝","text":"风雨崇朝洗宿岚，古坛高倚五峰南。\n坐看云气秋生壁，卧听泉声夜绕庵。\n杖履正堪成雅集，弦歌犹恐落清谈。\n殷勤好语来游客，莫遣飞尘上旧衫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46465,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邵佥宪用之复任山东","author":"邵宝","text":"滇海归来老使君，东行还共泰山云。\n州兼青兖双旌去，天近沧瀛一道分。\n何处秦碑犹可识，它年汉诏漫曾闻。\n须公高揽澄清辔，马首西风日未曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46466,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周工部元弼","author":"邵宝","text":"水部官怜初拜日，金陵地忆旧游时。\n未应岁月閒供吏，最是江山巧索诗。\n秋色催人移棹急，客怀逢雨出郊迟。\n静中经济堪料理，笑把清樽有所期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46467,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨坐漫述是日郭仁宏寄小像至","author":"邵宝","text":"镜中愁鬓欲成皤，新画应惭郭泰和。\n花谢晓风方恨急，麦收春雨竟嫌多。\n曲房辟湿频烧术，单裌生寒重易罗。\n满院青枝飞燕子，扣门时有客相过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46468,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凤阳谒陵","author":"邵宝","text":"郁葱佳气接邱坛，真向乾坤得大观。\n岁举留都周册祝，月游原庙汉衣冠。\n九重陟降天应近，万世栽培地本宽。\n瞻仰不胜心颂在，无疆休与泰山安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46469,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中赏红梅奉次涯翁先生时邃翁携酒共饮怀麓堂二首 其二","author":"邵宝","text":"江南春色渺无涯，借得芳枝似酒赊。\n点染已经元老手，品题还许大方家。\n丹心独对年年树，玉貌空传处处花。\n雪夜门深清梦远，敢将桃李向人誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46470,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又叠前韵荅邃翁先生二首 其一","author":"邵宝","text":"谁寄江南第一枝，岁寒如有物司之。\n天于北道留馀地，人为东君惜后时。\n太素风流难入画，半酣颜色最禁诗。\n平生鼎鼐心知在，且共西堂雪夜卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46471,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又叠前韵荅邃翁先生二首 其二","author":"邵宝","text":"金鼍山畔洞庭涯，咫尺寒香道路赊。\n雪夜不回仙客棹，春风元在相君家。\n地应有律能生黍，天亦多情为雨花。\n投我琼瑶何以报，拟将归向北堂誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46472,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得见素公书","author":"邵宝","text":"素老书来蜀道长，洞庭春水正茫茫。\n出群才本安危寄，习隐心应去住忘。\n夔府孤城看落日，杜陵野客梦沧浪。\n远人欲挽难为计，共指方平像在堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46473,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄李提学献吉","author":"邵宝","text":"铁柱宫前春水深，几回清梦忆登临。\n新亭有客还题壁，旧曲何年为入琴。\n高士榻虚人似玉，此君堂小地如金。\n近来又读宗儒记，回首匡庐万古心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46474,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"文庙陪祀次柳方伯拱之","author":"邵宝","text":"惠风入夜细吹衣，坐爱宫墙咫尺违。\n星破密云看渐朗，尘消冻雨恨犹微。\n梦馀真睹殷楹奠，语次空传点瑟希。\n此意欲从何处道，东堂灯火两冠巍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46475,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登滕王阁","author":"邵宝","text":"望尽江湖极目天，滕王楼阁尚巍然。\n云中帆影寒流外，雪后帘光夕照前。\n它日赋曾倾客坐，何人游更挟飞仙。\n庙堂远念诸公在，回首层霄北斗悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46476,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次白洲公","author":"邵宝","text":"且临岘首吊羊公，回首台阶近九重。\n千丈厓堪供巨笔，一杯酒为庆奇逢。\n谢安山卧曾江左，召伯风行又陜东。\n麟阁峥嵘它日地，丹青能写汉臣功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46477,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉次东山公在广元夕观灯韵","author":"邵宝","text":"寻常诗句亦黎元，垂老丹心照海门。\n且以数杯酬客兴，何曾一饭忘君恩。\n漏声入夜风全静，灯影乘春月半昏。\n闻说总戎多解事，漫将歌吹过江村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46478,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别庐山","author":"邵宝","text":"山北山南几度游，春风到处得相留。\n鹿听李渤祠前晓，菊采陶潜宅畔秋。\n星落半湖苍岛出，泉分双涧白云流。\n五峰明月新亭兴，它夜江天独倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46479,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归兴六首 其一","author":"邵宝","text":"曾从渡口赋桃花，客路风光几岁华。\n州郡十年还入省，漕渠数月竟思家。\n星辰近听趋朝履，河汉虚随奉使槎。\n斜日倚楼沧海上，云山回首一长嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46480,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归兴六首 其六","author":"邵宝","text":"湖上飞云小作阴，龙神祠下水流深。\n河渠未预千年计，阙里徒勤万古心。\n驿报正愁闻鲁警，棹歌初喜听吴音。\n顺流东下三千里，一笑清风忽满襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46481,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"分司夜阅卷","author":"邵宝","text":"肯信行台是隐居，手寒中夜尚披书。\n冰霜气逼庭初静，星斗光临户正虚。\n漫道相人如相马，极知观理似观鱼。\n九重方切真才念，独对青灯意有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46482,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青云峰用元人韵","author":"邵宝","text":"眼中感慨几千秋，第一峰春翠欲流。\n迹为古人须下马，兴当今日可登楼。\n冰霜以后花兼鸟，山水之间县复州。\n采得寒梅香满袖，更从江上问横舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46483,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"建昌道中见杏花","author":"邵宝","text":"临川梅花尚在眼，旴江忽复杏花红。\n山行远近百里外，春色浅深三日中。\n有力已能知夜雨，无心那复问东风。\n明朝又向南丰路，却听莺声处处同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46484,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小溪道中","author":"邵宝","text":"春云收雨寂无功，诗景依稀在眼中。\n南去驿连分水䫈，北来船趁上江风。\n细泉落涧深成碧，幽径垂花浅著红。\n玉枕有名何处是，令人却忆白沙翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46485,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送金潮","author":"邵宝","text":"万壑清冰贮玉壶，相逢却讶是尘途。\n颖师妙已传琴操，米老奇还托画图。\n白马五陵初入蓟，绿杨三月又归吴。\n凭谁为赋行吟地，云满青山月满湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46486,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄姚都水秀夫","author":"邵宝","text":"疏浚功成数十州，东南应免九重忧。\n奈何水部称多病，却向鹅湖访旧游。\n燕䫈暄凉凭候雁，楚江晴雨问鸣鸠。\n草玄闻有平生意，须及扬雄未白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46487,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答潘维本","author":"邵宝","text":"官忙十日九在省，客邸劳君过几回。\n片纸漫投今世刺，千金曾吊旧时台。\n江长云外鸿还去，秋老山中菊正开。\n却忆湖南湖北地，和君诗罢一徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46488,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻三原公讣二首 其一","author":"邵宝","text":"五朝进退盛明时，四海瞻依百辟师。\n散地尚堪栖老凤，格人真合拟元龟。\n紫宸陛远星辰切，绿野堂深日月迟。\n韩富勋劳司马望，大书谁作墓前碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46489,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻三原公讣二首 其二","author":"邵宝","text":"载起登廷七十馀，两童疋马老生如。\n四夷相问相司马，千载独知师敬舆。\n咫尺天回书侃侃，万间人庇屋渠渠。\n典刑已矣遗文在，西望三原泪满裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46490,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"还自长沙未有述作谢沈休翁","author":"邵宝","text":"谓我南行大有诗，鄙人何敢与闻之。\n潇湘尚忆虞巡地，云梦宁知楚猎时。\n木落洞庭秋复尔，鹤来赤壁夜何其。\n登高坐待浮云尽，回首青天见九疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46491,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过长沙不得谒贾祠","author":"邵宝","text":"巨笔谁修汉一经，治安策已动天听。\n奠无可藉茅空白，采不堪纫草正青。\n旧井定通瀍北水，新祠真应斗南星。\n独怜鵩鸟翻为瑞，万古清风满石亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46492,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"生日和答王河南公济","author":"邵宝","text":"新植甘棠未作阴，生辰忽向冗时临。\n人间乐事还莱綵，天上佳音有传霖。\n近不可亲鸥似玉，淡犹堪赏菊如金。\n岳楼记在何能读，惭愧希文万古心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46493,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答魏宪使士华用公济韵二首 其一","author":"邵宝","text":"三礼周旋起一经，凤皇鸣动九重听。\n爱云曾袖匡庐白，题石还磨剑阁青。\n范记读馀心耿耿，楚骚歌罢鬓星星。\n长沙回首相思极，路隔湘东几驿亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46494,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答魏宪使士华用公济韵二首 其二","author":"邵宝","text":"閒倚船窗看水经，沧浪歌起隔江听。\n霜台简自它年白，雨寺灯犹昨夜青。\n秋水南湖千万顷，晚云北斗四三星。\n重阳己负登高约，何处寻盟更有亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46495,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新祥宫漫述亦用前韵","author":"邵宝","text":"懒听道士诵仙经，却爱吹笙隔院听。\n江上云应无数白，雨中山亦有时青。\n囊琴正迓来今雨，匣剑还将拭旧星。\n莫道深秋佳趣少，菊边修竹故亭亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46496,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邃庵先生约登金山","author":"邵宝","text":"世间谁信有瀛洲，奇冠江南第一州。\n龙窟不知何事露，星槎真向几时浮。\n石分砥柱还孤注，水入沧溟正急流。\n更上留云穷望眼，海风吹浪晚飕飕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46497,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别沈休翁","author":"邵宝","text":"湖南会本自江东，二十馀年气味同。\n此去春违丰采外，向来心在简书中。\n杜陵门径还今雨，司马衣冠更古风。\n西望武昌江汉表，云连黄鹤倚晴空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46498,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"追悼匏庵公","author":"邵宝","text":"天寿斯文为国华，枯藤瘦树著新葩。\n无书谢客门长静，有梦怀人室未遐。\n十字谁题君子墓，一编自许大方家。\n梧桐高倚庵前月，鸣鸟寥寥噪暮鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46499,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采石登谪仙楼","author":"邵宝","text":"济上登楼已十年，兹楼兴在未登前。\n何人不道诗能圣，昔日空传酒解仙。\n舟楫心期风乍起，屋梁颜色月犹悬。\n留题讵敢轻磨石，万古江山一慨然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46500,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望庐山用旧韵","author":"邵宝","text":"曾从王守问山庵，神思飞驰不自堪。\n有意一亭携客赏，无言五老拟禅参。\n朝宗江汉心初北，梦寐烟霞眼正南。\n我忆旧游多述作，凭谁刻向卧龙龛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46501,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中望九华山用李韵","author":"邵宝","text":"微雨初收草似茵，九华山色欲迎人。\n援琴正怪知音少，倾盖何妨识面新。\n溪汎绿波才隔夜，树垂青子又馀春。\n风涛宦海今如许，何处寻仙问出尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46502,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙兴寺述事","author":"邵宝","text":"佛殿庄严似法宫，圣恩偏注此山中。\n南朝寺在俱凡界，西竺僧来自祖风。\n画栋本连陵树碧，绮疏曾映苑花红。\n题名幸与司徒后，怪得行旌懒向东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46503,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中读匏翁诗","author":"邵宝","text":"不见此翁还此诗，读诗真想对翁时。\n峰回深谷树重叠，渚漾轻波草陆离。\n载道弦歌邹鲁国，旅庭彝鼎孔周祠。\n平生海月庵中兴，应许藤床竹几知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46504,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"齐安晚泊时荣藩初之国偕二司迎之","author":"邵宝","text":"漫向东坡问雪堂，雪残寒日正荒荒。\n地名自是因人重，客思那胜为国忙。\n万古江流从禹贡，一时风力有周郎。\n召南曾赋甘棠树，谁遣春阴遍楚乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46505,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒苏祠用前韵","author":"邵宝","text":"去公千载我登堂，春草离离若与荒。\n雨露不知天地阔，江山应笑古今忙。\n官衔漫逐三司使，民瘼愁闻百里郎。\n何处有灵还可吊，旧游随地是吾乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46506,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望东莱墓","author":"邵宝","text":"内白亭边墓道开，瓣香深拟拜东莱。\n风雩有象公何在，棠树无歌我却来。\n两月近思真定本，千年大事未终裁。\n白云回首山中寺，寒日荒荒径满苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46507,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观诚意伯像于处州","author":"邵宝","text":"一代元功百世豪，遗容瞻处丽阳高。\n天留汤沐田无税，人效明禋涧有毛。\n莘野不妨初就桀，草庐犹恨未诛曹。\n万峰指点青田路，断石枯松望眼劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46508,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中梦希翁","author":"邵宝","text":"江涛夜寒公不来，公来入梦亦奇哉。\n百年知己惟心在，万事随人可力回。\n望久更无谁下榻，兴多惟有独登台。\n欲将五老峰头树，移向西湖崦里栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46509,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中怀杨仪部","author":"邵宝","text":"未得登君野兴堂，两年清梦独难忘。\n笑谈每怪逢僧健，文字犹嫌应客忙。\n山月挂松真洒落，海云迎鹤更昂藏。\n吴天楚地同秋水，老尽蒹葭一夜霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46510,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读钓台集用陈白沙韵二首 其一","author":"邵宝","text":"莫将身世较行藏，钓石能增处士光。\n青眼屡烦真主顾，白头端为故人昂。\n云归故䫈龙应懒，蘋委空江水亦香。\n九鼎一丝形迹外，尽教俗客笑荒唐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46511,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读钓台集用陈白沙韵二首 其二","author":"邵宝","text":"从来自信任人疑，一寸丹心付所知。\n白石有情依古庙，青苔无赖上残碑。\n芝从商䫈犹知主，鱼向磻溪已得师。\n未到桐江空仰止，数章新和白沙诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46512,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石钟山","author":"邵宝","text":"九江怒逼蠡涛东，独受舂撞万窍空。\n人籁总输天与地，石声还藉水兼风。\n数椽僧结云厓上，一舸仙乘夜月中。\n何处别寻吴季子，只留馀地待铭功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46513,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九江靖忠书院","author":"邵宝","text":"岁时江郡荐江蘋，异代衣冠略近真。\n九死竟还唐社稷，一生惟识晋君臣。\n菊松尚拟它年晚，桃李聊增此地春。\n莫道近来公论少，庙门题额是何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46514,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"广信遇庞大参元化","author":"邵宝","text":"两省分司偶此同，不堪信宿又西东。\n衣冠元重藩臣体，议论犹多国士风。\n春殿香烟趋北阙，夜堂灯火坐南宫。\n它年更有相逢地，又引鹅湖入话中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46515,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吉水遇王敬止用送盛斯徵韵","author":"邵宝","text":"江声初静晚风轻，千里关山可计程。\n独立已为它日重，相逢真使故人荣。\n望穷螮蝀云犹密，歌罢沧浪水正清。\n笑折梅花对摇落，不须杨柳管离情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46516,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]