[{"title":"一月往返两经飞来寺","author":"梁元柱","text":"重过山寺赋离骚，笑杀山僧复拥旄。\n敢是寻盟于气象，却将幽意问松涛。\n山花别我犹馀黛，江柳迎人未著绦。\n此地清缘应不浅，莫教层磴任蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33713,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁卯撤棘同典试张虞部小酌","author":"梁元柱","text":"天上文昌羡使君，登坛拔骏怀空群。\n风回五岭材犹借，月霁三秋桂可分。\n自有彩毫于气象，莫将幽会动星雯。\n一尊可是故人酒，似得从容细论文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33714,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偕密因慧定两上人集海珠督造凭虚亭","author":"梁元柱","text":"亭子金光付草莱，菩提长自覆苍苔。\n何人愿志侵云结，此际乾坤特地开。\n指点松林资宝筏，吐吞江气想琼台。\n登临剩有他年兴，半日凭阑已绝埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33715,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"珠江次郑太史韵","author":"梁元柱","text":"一自初衣遂薜萝，故人何事访披蓑。\n寻盟最爱交能澹，颂志犹怜和者多。\n水国尊开惊四美，天花晴散到三摩。\n谈深横槊江干夜，霜月低窗桂影婆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33716,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过潘孺朗绮绚堂次郑太史韵","author":"梁元柱","text":"出关身便谪神仙，别院逢君小洞天。\n作赋自知惭锦绣，閒居原是拥嫏嬛。\n当窗雨沫琅函润，扑席花明绮槛鲜。\n况有珀光传玉碗，夜深一话已重元。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33717,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"用韵答何凝生","author":"梁元柱","text":"频年病骨学逃名，亭馆新霜起夜声。\n世路惊疑游欲倦，山云閒憩梦初醒。\n匡时贾谊惭无策，何处元龙重有情。\n未许词林耽风雅，东南犹有未降城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33718,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺端守陆公祖奏最兼寿太封翁","author":"梁元柱","text":"五马专城旧著勋，词坛况复雅能文。\n高淩石室千层峻，清切端溪一派分。\n但有君恩酬湛露，不须亲舍忆停云。\n何如满酌流霞日，奏入神明陆使君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33719,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"棋墅风生为参戎陈启明作","author":"梁元柱","text":"何来蠢动扰荒要，飞将龙旗下绛霄。\n夜月三军严细柳，雄风一矢贯双雕。\n敦诗豫有擒王略，挟纩宁无背水骄。\n岭外殊勋铜柱在，图麟肯让霍嫖姚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33720,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶然堂成用韵答曾息庵方伯","author":"梁元柱","text":"短蓬初荫绿天姿，片石留云若有私。\n人畏自应成小筑，楼居宁敢负明时。\n即看白社朱堪染，况羡青山翠可移。\n但有同盟公等在，不妨重赋偶然诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33721,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶然堂成用韵答陈秋涛亲家","author":"梁元柱","text":"结得柴扉拥翠稠，苜栏尤喜报琼投。\n閒居似有贻家术，召对惭无代国谋。\n却爱新巢看燕语，更怜迁木听莺求。\n相将正好过藤杖，萝月依稀欲上楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33722,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己巳月夜留别次陈金城韵","author":"梁元柱","text":"一从螳臂误当轮，赢得罗浮几度春。\n何事平分秋色好，却怜惜别月华新。\n天涯一叶堪摇落，匣里双龙肯任尘。\n拚有半腔副知己，不须功业远图麟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33723,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来寺留别二首 其一","author":"梁元柱","text":"底事乘骢又出山，诸天仍锁翠微关。\n前途敢拟千秋事，信杖宁输半日閒。\n酒政风生霜并肃，茶烟露冷鹤初还。\n相看仗剑横双眼，万里西风吹客颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33724,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来寺留别二首 其二","author":"梁元柱","text":"频年孤剑倚江干，自笑风流旧汉官。\n入座花香回槛曲，挥毫霜气染林端。\n可堪骊调三秋发，况复星轺万里看。\n后夜蓟门深雪色，敢辞清梦到鸡坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33725,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游曹溪","author":"梁元柱","text":"秋清低树晚含霜，乘兴同过选佛场。\n面北袈裟方丈地，天南炎海一津梁。\n玄探优钵拈花晚，茗啜灵泉引锡长。\n自爱浮生閒半日，前途底事却消忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33726,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中有怀诸同好","author":"梁元柱","text":"春尽江芜岸绿垂，征帆何事滞江湄。\n朝明海练晴翻浪，暮漉山衣雨著蕤。\n仗剑每看依北斗，惊乌犹见绕南枝。\n开尊不禁诗豪发，便欲临风寄所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33727,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜泊马当","author":"梁元柱","text":"天涯何事忘飘泊，万里惊涛此独眠。\n石角吹流鸣夜月，江门掩浪锁朝烟。\n孤帆远指青天外，尊酒谁过白雁前。\n却笑艕人催晓发，蓑篷犹系小渔船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33728,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上闻边报","author":"梁元柱","text":"江上波涛起暮潮，潮平烟树静萧萧。\n帆开落日横孤鹜，雨宿荒村断石桥。\n烽火经年愁戍虏，羽书何日报平辽。\n相看浊酒频蒿目，休道桐丝重汉朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33729,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过东林寺","author":"梁元柱","text":"岂为名山客自南，云门万里曲空潭。\n峰头老去乎还五，溪上刚来者又三。\n清罄灵泉堪小定，松声山色足禅贪。\n即看策马疲前路，此地还消一剧谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33730,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过关山有感","author":"梁元柱","text":"匹马岩关度夕曛，雨馀秋色净无垠。\n平林地轴开青甸，磴道天门锁白云。\n漠漠荒烟连野迥，寥寥哀雁隔峰闻。\n登高凝睇伤摇落，南北风尘尚驻军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33731,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏集金鱼池次象冈何宫詹韵","author":"梁元柱","text":"帝城春色已辞春，春意郊坰尚可人。\n柳拂青帘堪命酒，池临新槛欲垂纶。\n高楼隐映如花面，小集休惊似叶身。\n出郭淄尘能少到，不妨乘兴对吾真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33732,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕都有怀徐义纯","author":"梁元柱","text":"耽书子厚年逾病，湖海元龙今尚豪。\n燕蓟云山情叠障，松桥明月梦生涛。\n腰间万里龙文合，眼底千金骏骨高。\n白社旧盟应不负，寥寥天地忆吾曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33733,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出巡屯马","author":"梁元柱","text":"凉飙瑟瑟柳条稀，千里青骢驻落晖。\n问俗何人歌五裤，征车此地赋缁衣。\n风高驿路凝霜肃，秋老邮亭湛露霏。\n夜半襟寒劳梦破，可庭新月对清辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33734,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日南还金陵道中","author":"梁元柱","text":"去国秋深转渺茫，西风摇曳白云乡。\n霜林抹雨山含翠，茅屋编篱菊绽黄。\n闾左追呼闻调募，畴西晚馌急输将。\n匈奴未灭家何处，落日驱车空甚忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33735,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上饮开府魏瑶海","author":"梁元柱","text":"庾府清尊此见招，临江楼上一舒翘。\n参横剑佩星河近，寂寞鱼龙镜浦遥。\n樵角风声传漏刻，关山月色想鸣刁。\n无端渔子清歌发，云水苍苍自洞箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33736,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒张曲江祠","author":"梁元柱","text":"祠享南关第一峰，千秋殿阁敞崇墉。\n云移白羽开祠谱，风度苍岩问逸踪。\n宁复人间瞻俎豆，却从天外听簴钟。\n高山忻慕低回久，前路寒烟起暮松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33737,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过小溪","author":"梁元柱","text":"三秋行迹滞新城，岐路霜侵一剑横。\n雨洗霜枫明组练，唳传皋鹤壮霓旌。\n但闻白酒能将馌，不识青骢可避行。\n愧我后尘同靡盬，漫劳山鸟解相迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33738,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜","author":"梁元柱","text":"客舍秋深自寂寥，那堪独坐思迢迢。\n梧桐吹瘦西风叶，鳷鹊低横半夜桥。\n眼底晴烽连朔漠，耳边凉籁八芭蕉。\n开尊且谩伤摇落，何处高楼吹玉箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33739,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠地师徐象明为区大参得梦中之地","author":"梁元柱","text":"闻道骑龙选夜台，双峰晴插白云隈。\n何年梦寐闻天语，此日乾坤特地开。\n自有灵符能叶瑞，不须元谶亦登来。\n千秋尺地非容易，孺子由来冰鉴才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33740,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春夜同郁仁山陈顺府卢本潜郑广宇陈秋涛集东皋拈韵","author":"梁元柱","text":"读书深处小壶天，况复寻盟自谪仙。\n酒政尚须烦铁面，肉围应报蹙金钿。\n青来远树能移席，绿带新溪可扣舷。\n赢得披襟濯清露，夜深歌罢一泠然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33741,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春仲集李果卿山房观女戏闻报闽将郑参戎入援即事","author":"梁元柱","text":"莺簧调柳律初成，天外欃枪照眼明。\n国士可能传海檄，终军谁倩请长缨。\n惊呼鼙鼓来逾急，试舞霓裳夜转清。\n酒力自将红粉队，漫劳飞将下江城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33742,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送宅羲侄北上春官兼寄若木侄","author":"梁元柱","text":"新侵寒色霭朝曦，送子行将万里期。\n酒尽珠江天渐远，花明燕市雪初姿。\n骞云孤鹗风淩厉，贯斗双龙夜陆离。\n偕计何人更清切，好同春信慰吾思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33743,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送兵部吴羽宗中表还朝","author":"梁元柱","text":"离亭花发雪初稀，万里旌旗照落晖。\n莺解新簧搔客首，柳将飞絮恋人衣。\n江声夜动鲸鲵壮，春色行看雨露肥。\n宵旰未须劳圣主，范韩今已入筹帏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33744,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶过有怀","author":"梁元柱","text":"敢谓东山起谢安，偶来乘兴一弹冠。\n暂从萝月调茶鼎，更向松溪问钓竿。\n满架云烟毫并落，连床风雨夜生寒。\n无端良晤侵离绪，咫尺清欢尚渺漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33745,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送余麦积上舍北上","author":"梁元柱","text":"尊酒江亭思不支，征帆犹逐朔风吹。\n相知且莫愁前路，孤调其如赋索居。\n剑倚庾关霜乍冷，花看帝里雪初姿。\n照馀天地为肝胆，吾等风尘岂鹿麋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33746,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日集北郭禅院次楚客袁七齐韵","author":"梁元柱","text":"园林逃暑一閒过，竹里惊呼问小坡。\n客自握兰来泽国，谁从结佩绚云窠。\n不辞引满黄鹅杓，难和流徵白雪歌。\n却羡卿狂谁得似，卿今曾数粤山多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33747,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日亭池小集和罗若一见寄","author":"梁元柱","text":"风邮花气扑重楹，半日浮生订酒盟。\n世事如棋堪着眼，江花似面不胜情。\n谈于调合元尤赏，尊以诗豪晚更倾。\n未许幽栖宜癖性，山云吹雨望馀清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33748,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同郑思咸诸子集北郭禅院时有女史佐酒政","author":"梁元柱","text":"不到荒山托懒嵇，初晴乘兴一招携。\n编云径竹迎秋瘦，拂席昙花著雨低。\n幽会偶来深夙好，小端应已入新题。\n未须于我同疏放，南北风尘正鼓鼙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33749,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日入白云访雪谷密因诸上人精舍二首 其一","author":"梁元柱","text":"竹院秋深路渺茫，沿溪一带白毫光。\n客来问月云堪款，僧筑开山锡可望。\n空翠寒侵觞政肃，霜林新染墨花狂。\n十年更约松阴道，入梦青松个个长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33750,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日入白云访雪谷密因诸上人精舍二首 其二","author":"梁元柱","text":"秋山乘兴信蓝舆，支遁山云独掩庐。\n真谛可参无上法，浮生暂署阿兰居。\n双趺慧日依林静，半岭晨钟集涧疏。\n此地情缘知不浅，何年身世许凭虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33751,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山寺小集次欧羽仲韵","author":"梁元柱","text":"低树含霜晚翠新，登临的的欲寻真。\n花开佛面能供客，鸟弄山阳解似人。\n暂以风流侵韵雅，莫将幽会动星辰。\n相看不尽分题兴，日落孤城万壑皴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33752,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿陈华真太亲家","author":"梁元柱","text":"卧稳东山百尺楼，真人七十又馀秋。\n贻谋经术传中垒，踵接清时羡太丘。\n棋局閒来看世态，酒船到处狎江鸥。\n承明伫有徵贤诏，三代应同拜冕旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33753,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凤城丹汞图寿区几蘧太亲家七十一","author":"梁元柱","text":"可是仙城别洞幽，真人半隐足丹丘。\n砂传葛令连勾漏，境借张颙岂陆舟。\n绿墅共占浮紫气，苍生未许度青牛。\n抽毫谩谱冈陵祝，飞翠层峰最上头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33754,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送无胜上人奉檀香佛归金陵","author":"梁元柱","text":"南来宗意原无住，龙锡经时信羽翰。\n遂有法华开色相，微拈心蕊足旃檀。\n千峰落照苍猿定，一道横分白气尊。\n许我淩风来独往，月明环佩满虚坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33755,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日偕同社饮梯山各挟侍儿分得年字","author":"梁元柱","text":"曾是于山共有缘，登临乘兴重流连。\n烟光明媚晴春日，花气薰笼美少年。\n云削屏峰开汉外，潮平村树点天边。\n相看正是同心者，肯负兰亭曲水篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33756,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过诃林寺智海修六诸上人集索拙笔漫赋","author":"梁元柱","text":"春尽山门鹿径幽，春行信杖得同游。\n璇房露积苔青砌，竹院云深僧白头。\n清磬数声诸品净，元探一话半生浮。\n法供翰墨堪挥洒，抱约还来问铁牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33757,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日晚晴喜客","author":"梁元柱","text":"羡尔寻春弄晚晖，偶来小院破垣衣。\n花明扑槛魂犹湿，月冷撩人魄渐晞。\n尘拂山云开宿黛，鼎烹天茗试新旗。\n酷怜意气谈元剧，竹影侵阶双鹤归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33758,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春郊即事","author":"梁元柱","text":"春郊试屐半晴天，春事椿椿尚可怜。\n风亚莺簧疏隔柳，雨肥花绽净含烟。\n当窗稚女调轻蝶，抛镜山妻护短弦。\n何处酒帘深树里，一声渔笛夕阳前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33759,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日园居","author":"梁元柱","text":"移来树色刚馀亩，占得春光满十分。\n兴到邻酤能举白，诗成新柳足张军。\n三三径曲驯皋鹤，摺摺墙低度懒云。\n倩取东风频干当，一尊橘杏小蓝君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33760,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日同诸子集北郭禅院分赋","author":"梁元柱","text":"何事东林问白莲，溪桥小院足安禅。\n尊前漫惜频年客，竹里能深半日缘。\n移酌馔馀香积供，临池花借彩毫鲜。\n春游若个非容易，肯勒登临谢屐穿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33761,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"子凝侄从龙江归移柬招同月子饮曹仙于山中余以病并却时仙拟从陈乔生","author":"梁元柱","text":"山中折柬自家戎，写看当时一撚红。\n遂有轻风生两腋，其如蓬鬓苦双童。\n清欢无计追潭府，小妹多情护守宫。\n拟趁白云过竹院，淩风收拾玉芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33762,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病起喜两小姬见过为治药索近作楷书戏赋","author":"梁元柱","text":"幽斋镇日拥屠苏，降得双仙待小珠。\n活练褪红侵雪藕，新词偷拍晕凝酥。\n香醪催写笼鹅帖，珀碗狂输洗玉厨。\n我自竹床卿绣轸，相将萝月上高梧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33763,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西苑观牡丹","author":"梁元柱","text":"春归御苑艳偏奢，绿玉枝头吐紫葩。\n旧识花王成洛浦，新看国色自天家。\n千重猗黛分宫粉，百媚含情落晚霞。\n自是上林饶雨露，非关芳赏事繁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33764,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"墨场纪录","author":"梁元柱","text":"管城新队伏，细柳绿初妍。\n不羡千夫长，宁论万灶烟。\n水云军紫石，壁垒拥青毡。\n贮以三冬足，丁将六籍编。\n终军能帅白，飞将却鏖玄。\n横槊侵萝月，饶歌选翠钿。\n少年看解佩，殊绩在云笺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33765,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"皇极门命辅臣行边纪事","author":"梁元柱","text":"王命勤三锡，传宣下六螭。\n夙韬隆赤芾，新宠耀黄池。\n柳幕含霜肃，霓旌拥日移。\n麒麟虚阁日，周召策勋时。\n沙漠应犁穴，燕然可勒碑。\n寄言诸将士，恢复慰宸思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33766,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归舟宿石门","author":"梁元柱","text":"十年飘泊子，不作石门游。\n何事春将暮，归帆信夜留。\n明沙开素练，绝巘舞苍虬。\n编诗能载酒，寻盟可狎鸥。\n濯露襟逾迥，烟空界欲浮。\n便堪乘小筑，吾拟借灵洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33767,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿潘子迁","author":"梁元柱","text":"有客閒居欲白头，凭将文雅足风流。\n瑾怀兰握珠玑唾，云佩霞珰明月钩。\n红颊不随丹鼎驻，清狂时与白鸥留。\n耽诗野性今逾癖，散帙閒情老更遒。\n七十馀年誇素业，五千何日问青牛。\n眼前世事只如此，我欲从君汗漫游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33768,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日饮容渠真亲家山房口占纪胜","author":"梁元柱","text":"谁道名山足漫游，多君园胜自丹丘。\n登临不用谢安屐，来去何须范蠡舟。\n跨壑有虹开磴道，栖萝无地倚层楼。\n扪萝树老猿能援，别洞苔閒鹤自留。\n森竹编云回碧槛，长松立壁舞苍虬。\n武陵可是花深处，蓬岛犹疑天际头。\n便欲当窗鉴寒翠，更疑翻胄挽洪流。\n芒鞋此日同游剧，收拾千岩万壑秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33769,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题小景二首 其一","author":"梁元柱","text":"溪定咽复流，山空翠犹碧。\n横琴抱未弹，幽意不可得。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33770,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题小景二首 其二","author":"梁元柱","text":"信艇出荒矶，水声喧众壑。\n晴岚远岫明，乱石潮痕落。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33771,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出关二首 其一","author":"梁元柱","text":"不识南塘路，借问路旁子。\n答言从此去，桃花红十里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33772,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题鹤顶花寿孙明府","author":"梁元柱","text":"只道鸡冠岭外花，无端犹灿赤城霞。\n可怜跨鹤飞仙去，飘落千年顶上砂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33773,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过浮槎寺有读书禅房者闻骢辄引去岂其踰垣而出者耶书壁怀之","author":"梁元柱","text":"山门阒寂子云居，径绕长廊落木疏。\n此地何人曾面壁，晚云晴护一床书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33774,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋霁登楼","author":"梁元柱","text":"新晴秋色翠微间，半榻当窗独坐閒。\n云去懒残应别地，峰来孤绝此何山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33775,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]