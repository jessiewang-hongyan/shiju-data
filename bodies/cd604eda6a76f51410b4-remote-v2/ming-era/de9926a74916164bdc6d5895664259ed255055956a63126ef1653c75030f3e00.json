[{"title":"送王将军元周总江北周家桥行营 其一","author":"王世贞","text":"二十四桥地，周家第几桥。\n甲光天堑日，帆色海门潮。\n鹅鹳雄难撼，鲸鲵黯不骄。\n雅歌仍缓带，知是右文朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41726,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王将军元周总江北周家桥行营 其二","author":"王世贞","text":"一领分符寄，昂藏便不群。\n指挥云鸟阵，训练水犀军。\n越甲千层组，虔刀七曜文。\n故乡衣带地，铙吹可相闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41727,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"永嘉张二汝纪谒选北上入访山中感旧有作","author":"王世贞","text":"往事浮云变，离怀日月长。\n汝衫犹未绿，吾鬓久先苍。\n诗好能如父，家贫不拜郎。\n唯余卫公笏，尚可献君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41728,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过普济废寺遇秋空上人作","author":"王世贞","text":"寺古僧庐尽，泥深旧径非。\n偶然逢宿衲，莞尔露禅机。\n宿火拨犹冷，残灯挑尚微。\n炊烟处处起，日晏澹忘饥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41729,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕作 其一","author":"王世贞","text":"爱子公车辟，贤昆复拜官。\n身中粗矍铄，眼底更团栾。\n槲叶垆初暖，椒浆盌不寒。\n唯怜万室尽，讵忍一家完。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41730,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕作 其二","author":"王世贞","text":"三百六十日，岁朝俄至今。\n法云趺坐老，天籁呗歌深。\n一饱无余事，千秋有愧心。\n明朝是明岁，从此觅知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"程孟孺以善诗及书与余交十五年矣今春过余则书法益妙云将入燕应中秘之募索一言为赠余久厌笔研且畏绮语虚名落长安人耳不得已勉成二律塞白孟孺慎毋以示人也 其一","author":"王世贞","text":"程邈创今隶，君称其家儿。\n一入中郎冢，频书幼妇碑。\n苦心变钩磔，元气走淋漓。\n莫以家鸡贱，犹堪集凤池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"程孟孺以善诗及书与余交十五年矣今春过余则书法益妙云将入燕应中秘之募索一言为赠余久厌笔研且畏绮语虚名落长安人耳不得已勉成二律塞白孟孺慎毋以示人也 其二","author":"王世贞","text":"有句不能赠，非关无故情。\n如何帝城内，复着老夫名。\n细软青精饭，香柔锦带羹。\n可能留少日，为汝话无生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题灵椿图寿卓澄甫光禄五十","author":"王世贞","text":"君不甘小草，人能颂大椿。\n年希知命域，齿是啖名人。\n迹与蓝舆旧，才从彩笔新。\n犹闻上苑色，绝胜武林春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十五年前与宋国李子定交于尊君前渠先生席上冬月走二千里见访乞先生志铭夜谈不胜感慨赋此为别","author":"王世贞","text":"虚拟龙门在，诗书业已荒。\n无名借北海，有泪洒山阳。\n烛为清言短，杯从旧事长。\n汝才终世用，不碍鬓沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"封詹事王公葬词四章 其一","author":"王世贞","text":"尘世虽堪恋，钧天已借留。\n神孙化玉局，令子覆金瓯。\n帝日悬碑首，卿云挂垄头。\n此时华表上，应有鹤来投。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"封詹事王公葬词四章 其二","author":"王世贞","text":"送车倾海峤，上冢尽公卿。\n风递苏耽哭，天回子晋笙。\n刍灵俱气象，槐荫转峥嵘。\n更是沙堤就，如龙傍夜城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"封詹事王公葬词四章 其三","author":"王世贞","text":"舄奕纶褒下，纵横节使来。\n一时丛庆吊，四海让荣哀。\n树玉深俱栋，阶兰隐渐荄。\n人间事略备，谁与报泉台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"封詹事王公葬词四章 其四","author":"王世贞","text":"室纵滕公旧，棺夸叶令良。\n宁如天语锡，更表国恩长。\n斗汉垂丹旐，风云护白杨。\n似闻墦祭后，俎豆已宫墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"藏经阁西偏俯小罨画溪","author":"王世贞","text":"绀宇藏经阁，春云罨画溪。\n隔花催小艇，落日在招提。\n彼岸如相引，真源自不迷。\n老夫翻阅罢，随意步东西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"尔雅楼下俯墨池","author":"王世贞","text":"小阁才踰丈，千秋并在兹。\n芸香邺侯架，花雨右军池。\n蠹与身同老，鱼将砚独窥。\n渐来能所尽，终日但支颐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠丘文学","author":"王世贞","text":"尔信丘迟子，吾几失后生。\n清冰知外氏，白雪是家声。\n偶作依刘计，因成御李名。\n齐安好三径，秋菊未辞英。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋空上人练水讲席未竟归问之","author":"王世贞","text":"初闻师子座，高下天花飞。\n何事楗椎响，悠然托钵归。\n道高魔事娆，心净世缘微。\n却顾生公石，虽顽知是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"报刘玄子先辈 其一","author":"王世贞","text":"七百四十字，一字一珠圆。\n江左青萍色，中原紫气传。\n小迟叔夜驾，忍断伯牙弦。\n扑满将充报，平津射策年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"报刘玄子先辈 其二","author":"王世贞","text":"尚忆玄湖墅，清流似浣花。\n惊纶跃神鲤，归炬散栖鸦。\n报尔弇园胜，犹怜剡棹赊。\n奇人复奇地，今古恨天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"练川篇四首赠朱嘉定入觐 其一","author":"王世贞","text":"练川虽鉴发，宁比令君明。\n不浅缁衣好，偏深白屋情。\n万人纷雨泣，孤舄受风轻。\n我欲摅银管，谁同循吏名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"练川篇四首赠朱嘉定入觐 其二","author":"王世贞","text":"爱汝朝天艗，飘飖凌紫氛。\n都无压载石，但有送穷文。\n竹马能相候，歌骊讵忍闻。\n练川虽彻底，清定不如君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"练川篇四首赠朱嘉定入觐 其三","author":"王世贞","text":"练川九里润，犹让令君仁。\n去作千家泪，来为万井春。\n官安道州拙，客诵莱芜贫。\n眼底诸黄绶，畴无愧古人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"练川篇四首赠朱嘉定入觐 其四","author":"王世贞","text":"府主无何我，朝贤一任疏。\n此行仍上考，圣帝必亲除。\n具以春秋对，毋烦城旦书。\n练川多诘曲，直恐未君如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登金泽寺后小山","author":"王世贞","text":"突兀数拳石，兴来思振衣。\n刹连波色动，帆带夕阳归。\n树老猿窥易，僧贫鸟下稀。\n毋劳感衰替，宗社已全非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"生日于泖塔避客作","author":"王世贞","text":"六十寻常有，纷余旧念牵。\n莫谈弧矢□，□□蓼莪篇。\n白社堪投老，青山不计年。\n祗应逢此月，长唤泖湖船。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诞辰次日解斋自嘲","author":"王世贞","text":"纵减尘中累，犹残物外名。\n从人称下寿，而我爱无生。\n僧辍钟时饭，船余网后羹。\n陶觞与何肉，虽有不关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿伯融王孙五十时以除夕生","author":"王世贞","text":"及君知命境，况复览揆辰。\n王国生桢后，明堂布魏新。\n桑蓬送残腊，汤饼向初春。\n留得添筹客，同为守岁人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙司理君善得量移之命自徽过访有赠得六首 其一","author":"王世贞","text":"为尉不凌守，居官能近民。\n烟霞行部足，鸟雀讼庭驯。\n赏自胶东厚，谗仍即墨新。\n明堂大计吏，圣主独劳神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙司理君善得量移之命自徽过访有赠得六首 其二","author":"王世贞","text":"被幞何其易，辕攀出且迟。\n赐环它日在，投抒片时疑。\n我狎风波事，君投山水辞。\n朱弦毋遽绝，世故有钟期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙司理君善得量移之命自徽过访有赠得六首 其三","author":"王世贞","text":"长沙不吊屈，绛灌乃徒劳。\n小恨无封事，何烦更反骚。\n久应明长者，穷好近吾曹。\n所以马新息，终推龙伯高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙司理君善得量移之命自徽过访有赠得六首 其四","author":"王世贞","text":"辙迹春泥少，谁来恼薜萝。\n不嫌诗社累，仍傍酒人过。\n一字官堪薄，千秋仲孰多。\n武陵花正发，归计莫蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙司理君善得量移之命自徽过访有赠得六首 其五","author":"王世贞","text":"七尺丰碑在，千人涕泪余。\n差闻董狐笔，能胜乐羊书。\n惠泽溪同远，清心玉不如。\n旌旄倘重过，竹马也轩渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙司理君善得量移之命自徽过访有赠得六首 其六","author":"王世贞","text":"万事吾难解，孤怀可易开。\n即今毋贵少，能不小怜才。\n浊雾霾文苑，雌风冷啸台。\n新知寻老别，悲喜递相催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送丁先生试回再赴太湖县学广文","author":"王世贞","text":"此日公车对，谁怜博士才。\n三鳣伯起席，一鹤令威来。\n白水为供帐，青山是讲台。\n太湖名偶尔，莫逐钓船回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金山上人苦行头陀行若一切无涉者得刘子威赠言数百字而犹乞余诗未已为子威所迫勉成一律老夫其尤罪魁也哉","author":"王世贞","text":"刘郎才滚滚，赠汝若干言。\n是否西来意，将非不二门。\n细应探业识，难是铲名根。\n我更沉沦者，群经空自翻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"友人潘景升文成而屈于试慷慨将游北雍余以诗壮之且招之 其一","author":"王世贞","text":"自草西征就，何人不问潘。\n诸生争避席，六艺许登坛。\n邸近平津暖，台空易水寒。\n朱弦虽可贵，留向伯牙弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"友人潘景升文成而屈于试慷慨将游北雍余以诗壮之且招之 其二","author":"王世贞","text":"蕴结长沙涕，追随邺下游。\n举头皆绛灌，何处着应刘。\n虎观虽堪美，鸿都莫浪投。\n菰芦天一曲，虚却李膺舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠柳陈父","author":"王世贞","text":"吾爱柳夷旷，相逢输素襟。\n紫髯伧父相，白雪郢人音。\n未办买山橐，谁怜避地心。\n世情杯酒似，处处可浮沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王吏部之子太学元祯","author":"王世贞","text":"先朝论吏部，简要有王戎。\n今日郎君长，居然乃父风。\n束书游太学，起草擅江东。\n似过襄阳里，时时口习公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邓孺孝雅士也出新诗数十章贽余饮之酒赠之诗","author":"王世贞","text":"新诗不在广，晚交难便轻。\n一诺了倾盖，五言足长城。\n醉指弇中色，何烦世上名。\n他日良常顶，与君听松声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"览古感时偶成十古律 其一","author":"王世贞","text":"知己世不易，知人吾亦然。\n方共东山隐，甚谓安石贤。\n物议善翻覆，时情多变迁。\n何如饮清泌，高咏白驹篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"览古感时偶成十古律 其二","author":"王世贞","text":"右军本清贵，暮年厌时私。\n偶闻远游讯，遂结良常期。\n峥嵘破羌帖，掩抑誓墓辞。\n朝贤未应悉，惟许蓝田知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"览古感时偶成十古律 其三","author":"王世贞","text":"阿游踞东阁，赣君谈坐隅。\n小生乃相吏，苟出当非夫。\n感慨事已往，功名人自愚。\n纵甘嗟来食，念此非穷途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"览古感时偶成十古律 其四","author":"王世贞","text":"东京昔云季，贤哲亦憧憧。\n少犹慕党锢，晚则趋中庸。\n吾爱黄叔度，世矜郭林宗。\n揽辉固威凤，无闷乃潜龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"览古感时偶成十古律 其五","author":"王世贞","text":"何由贡禹冠，寂寂向空弹。\n薇蕨尽堪饱，薜萝殊未寒。\n将无弋腐鼠，谓欲饵鹓鸾。\n见侮乃如此，雄心胡不残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"览古感时偶成十古律 其六","author":"王世贞","text":"元王溷大历，矫矫独杨公。\n所以白麻下，弇然素丝风。\n驺呵京兆削，粉黛汾阳空。\n虽怜夺之早，高名翻得终。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"览古感时偶成十古律 其七","author":"王世贞","text":"冬寒衣一称，朝饥酒再巡。\n老叨儿女惠，粗足渔樵身。\n幼安恬遁野，子鱼惭要津。\n苟无青云望，何必登故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"览古感时偶成十古律 其八","author":"王世贞","text":"少日不知佞，老来宁贡谀。\n念君当尔尔，聊此布区区。\n廊庙既已圣，山林安自愚。\n忘机独鸥鸟，或可与之俱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"览古感时偶成十古律 其九","author":"王世贞","text":"朝事不入耳，入恐滞眉端。\n君子自为敌，小人能即安。\n牛李横角抵，洛蜀竞崩湍。\n未必深山内，闻歌行路难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"览古感时偶成十古律 其十","author":"王世贞","text":"乡书不入眼，入恐翳双眸。\n闾井有封豕，衣冠多沐猴。\n东家易新主，西田非故畴。\n欲借空门宿，阇黎讼比丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为张幼于妇题墓碣","author":"王世贞","text":"汝佩九光去，谁征三秀辞。\n为深潘咏感，留表谢廷思。\n埋玉眠牛地，生金幼妇碑。\n忘情余久矣，聊与一传奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"袁抑之大宗伯考最暂还里寄问之","author":"王世贞","text":"阊门杨柳春，负弩候征轮。\n宁知休汝者，居然卧雪人。\n问菊无三径，移床碍四邻。\n犹言故里好，懒作帝乡臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小轩新构枕白莲池即碧莲也一丘岿然池上三方皆竹闲居偶成四章 其一","author":"王世贞","text":"壁画白莲社，池种白莲花。\n清梵既已毕，浊醪徐当赊。\n远公故不禁，陶令亦无他。\n从此西方路，还应置酒家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小轩新构枕白莲池即碧莲也一丘岿然池上三方皆竹闲居偶成四章 其二","author":"王世贞","text":"前林绿筱润，后沼碧莲芳。\n介尔一丘上，翛然三伏凉。\n偶凭扶老去，聊唤索郎尝。\n除却香山叟，谁能共我狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小轩新构枕白莲池即碧莲也一丘岿然池上三方皆竹闲居偶成四章 其三","author":"王世贞","text":"轩中何所有，秋兰碧葳蕤。\n钩帘落花入，围棋清昼移。\n何以荅韶景，偶然咏新诗。\n不涉人间境，人间那得知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小轩新构枕白莲池即碧莲也一丘岿然池上三方皆竹闲居偶成四章 其四","author":"王世贞","text":"佛书置不读，玄言谁与酬。\n惟将嗒然意，来坐兹轩幽。\n红萼总飞尽，黄莺犹滞留。\n不知春色好，那得送春愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题轩中灵璧石","author":"王世贞","text":"有石高仅尺，宛尔巫山同。\n许借从吾弟，移来仗小童。\n雨垂青欲滴，云过碧争雄。\n安得壶公引，轻身住此中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"栖贤别墅","author":"王世贞","text":"一啖栖贤笋，能令齿舌芬。\n箨龙留付雨，梢凤尽干云。\n念欲同清隐，谁能无此君。\n长镵白木柄，自与鹿麛群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渔山别业","author":"王世贞","text":"此山非渔薮，此渔偏在山。\n羊裘那肯着，虾菜或时悭。\n不得亦不卖，长饥故长闲。\n谁逢海樵子，高论白云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠医者张生","author":"王世贞","text":"吾怜张仲景，卖药不论钱。\n白屋人偏起，青囊手自编。\n獭从针底失，蛇向壁间悬。\n欲识仓公姓，还凭太史篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柳陈父再来出其诗尤胜因得征其两馆平津事且有悼亡之戚茕然一身而其尊人为湖南小官方捐橐为饷感而赠之","author":"王世贞","text":"重来诗更好，稍稍露行藏。\n却问平津邸，何如谷口庄。\n铗弹宁为腹，弦断别萦肠。\n薄禄湖南地，瞻云泪万行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陆大夫奏最推赠乃考武东翁及妣胡宜人寄以二律 其一","author":"王世贞","text":"汉代嘉循吏，黄金尔赐偏。\n乃增颍川秩，特起南阳阡。\n紫诰鸾双捧，玄宫日对圆。\n好将光显意，一慰蓼莪篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陆大夫奏最推赠乃考武东翁及妣胡宜人寄以二律 其二","author":"王世贞","text":"奏最传东观，旌书下建章。\n平添华表丽，转见帝恩长。\n中散新移品，修文旧拜郎。\n人间与天上，同是一辉光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽李近樗士牧为余画三壁奇伟甚方欲要之别作而死矣惜之痛之遂成一律","author":"王世贞","text":"西林三画壁，三吐胸中奇。\n往往有生气，时时留去思。\n交游旦夕冷，妻子岁时悲。\n卖酒泉台肆，唯应李白知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]