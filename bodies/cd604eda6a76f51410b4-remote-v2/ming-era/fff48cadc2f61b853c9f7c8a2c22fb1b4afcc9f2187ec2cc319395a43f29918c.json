[{"title":"柳枝词 其一","author":"胡奎","text":"一送离人折一枝。\n长条折尽短条衰。\n飞花自是浮萍草，莫向尊前怨别离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55888,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柳枝词 其二","author":"胡奎","text":"门前杨柳欲藏鸦。\n可恨萧郎不在家。\n妾有蛾眉如柳叶，郎今踪迹似杨花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柳枝词 其三","author":"胡奎","text":"旧日吴王百尺台。\n万株杨柳是谁栽。\n阊门城外春阴里，多少将军繫马来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨柳枝词","author":"胡奎","text":"郎听妾歌杨柳枝。\n明年二月望郎归。\n柳眉如妾镜中黛，柳色比郎身上衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹枝词 其一","author":"胡奎","text":"溪北溪南春雪消。\n溪水一夜忽平桥。\n明朝艇子载书画，繫在屋前杨柳条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹枝词 其二","author":"胡奎","text":"屋前柳色鹅儿黄。\n鹅儿队队在林塘。\n柳色似鹅鹅似酒，春来自是断人肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"博溪舟中赋竹枝词 其一","author":"胡奎","text":"东溪月出西溪阴。\n溪上荡舟溪水深。\n郎今唱歌向何处，白鸟湾头高树林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55894,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"博溪舟中赋竹枝词 其二","author":"胡奎","text":"白鸟湾头高树林。\n十年相约到如今。\n拢船不怕风波急，侬有竹篙知浅深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55895,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖竹枝词 其一","author":"胡奎","text":"荷叶盖头花拂衣。\n今夜采莲当早归。\n昨日小孤回棹晚，鸳鸯惊过里湖飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55896,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖竹枝词 其二","author":"胡奎","text":"侬家住在玛瑙坡。\n与郎湖上采么荷。\n侬比莲心心最苦，郎如藕丝丝更多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55897,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖竹枝词 其三","author":"胡奎","text":"妾是藕条郎似荷。\n劝郎听唱竹枝歌。\n藕条抱节丝难断，荷叶留心苦更多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55898,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖竹枝词 其四","author":"胡奎","text":"妾是浮萍郎似花。\n花随风去落天涯。\n浮萍只恋池中水，花性飘扬不恋家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55899,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖竹枝词 其五","author":"胡奎","text":"妾是荷花郎是萍。\n萍随波浪任飘零。\n荷心不离泥中藕，花谢明年叶再青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55900,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖竹枝词 其六","author":"胡奎","text":"郎是天河妾是星。\n与郎相见最分明。\n河流只向西南去，抛妾东边渡不成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55901,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖竹枝词 其七","author":"胡奎","text":"西子湖边杨柳花。\n随风随雨落天涯。\n莫教飞入湖中去，化作浮萍不恋家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55902,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖竹枝词 其八","author":"胡奎","text":"湖中荷叶绿田田。\n恰似人间子母钱。\n若能买得春愁断，侬亦移家傍水边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55903,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过浦赋竹枝词 其一","author":"胡奎","text":"通浦灞前春雨晴。\n大船小船南北行。\n凭仗篙师一问讯，归帆已到秀州城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55904,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过浦赋竹枝词 其二","author":"胡奎","text":"雪后江南春到时。\n鹅黄已染杨柳枝。\n东风不解离别意，一日恼人千万丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55905,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵王继学滦河竹枝词 其一","author":"胡奎","text":"滦河嘴头积雪多。\n山下石子青盘陀。\n侬在江南望江北，恰如织女隔天河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55906,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵王继学滦河竹枝词 其二","author":"胡奎","text":"百两宫车碾雪泥。\n山前二月春草齐。\n去年羽书星火急，妇女上马小儿啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55907,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵王继学滦河竹枝词 其三","author":"胡奎","text":"滦河杏花如雪匀。\n小雨三日不生尘。\n垆头少妇劝郎酌，花如人面草如茵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55908,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵王继学滦河竹枝词 其四","author":"胡奎","text":"去年大旱气不苏。\n道傍行泣妇与姑。\n不似江南连月雨，夜夜夜啼山鹧鸪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55909,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵王继学滦河竹枝词 其五","author":"胡奎","text":"滦阳河畔女如云。\n生长不识江南春。\n大字青帘卖官酒，莫辞注玉更倾银。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55910,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵王继学滦河竹枝词 其六","author":"胡奎","text":"山前马嘶苜蓿花。\n山下麻茹胜蕨芽。\n细肋沙羊割红玉，不识雪水夜煎茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55911,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵王继学滦河竹枝词 其七","author":"胡奎","text":"白翎双飞秋草黄。\n云沙万里接天长。\n番僧个个杨梅帽，日暮闻钟来上方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55912,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵王继学滦河竹枝词 其八","author":"胡奎","text":"天上金根回六龙。\n年年田舍及秋舂。\n白头父老出门拜，汉官威仪今载逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55913,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵王继学滦河竹枝词 其九","author":"胡奎","text":"蓟门关外故人居。\n十年不见音问疏。\n昨日江头见来雁，寄得滦河一纸书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55914,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵王继学滦河竹枝词 其十","author":"胡奎","text":"李陵台西避暑宫。\n穹庐月白夜生风。\n吴侬解唱竹枝曲，此调不与江南同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55915,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹枝词 题梅效竹枝体","author":"胡奎","text":"侬家向南雪一株。\n春后春前常见渠。\n瘦影从教比郎瘦，孤山终不似侬孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55916,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹枝词 其一 过太湖竹枝歌","author":"胡奎","text":"第四桥头枫叶青。\n白龙吹雨浪花鯹。\n过桥买酒待月出，今夜夜宿垂虹亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55917,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹枝词 其二 过太湖竹枝歌","author":"胡奎","text":"青裙女儿双髻螺。\n唱得吴宫子夜歌。\n酒醒月明眠不得，秋风吹落洞庭波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55918,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹枝词 其三 过太湖竹枝歌","author":"胡奎","text":"西山日落东山黄。\n侬唱竹枝行晚凉。\n十幅蒲帆弓样满，南风吹过白龙堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55919,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"薤露歌","author":"胡奎","text":"薤上露，何离离。\n人生不满百，欢乐当及时。\n东方三足乌，啼老榑桑枝。\n古来圣与贤，一去无还期。\n薤上露，令人悲。\n薤上露，何瀼瀼。\n蓬莱变清浅，海水漂枯桑。\n有生会俱尽，宁论弱与强。\n空馀三尺土，千年閟幽光。\n薤上露，令人伤。\n薤上露，何漙漙。\n朝日上陇头，叶上露易乾。\n乌啼松树间，相送入空山。\n白骨委黄壤，亲朋各自还。\n薤上露，令人叹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55920,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"云歌","author":"胡奎","text":"五色承朝日，晖晖黼黻衣。\n朝随黄鹤去，暮逐玉龙飞。\n欲知栖息处，长是恋金扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55921,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白日歌二首 其一","author":"胡奎","text":"烛龙烛龙尔何速，三绳莫繫乌三足。\n鲁阳之弋徒尔为，安得长挂榑桑枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55922,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白日歌二首 其二","author":"胡奎","text":"东榑桑，西若木，中有赤龙口衔烛。\n东驰西走无停毂，人生何为苦不足。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55923,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"子夜歌","author":"胡奎","text":"试问铜壶水，今宵几许深。\n漏长如妾泪，水浅是郎心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55924,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴宫子夜四时歌","author":"胡奎","text":"御柳袅金丝，宫莺拂柘衣。\n帘阴随日转，漏点出花迟。\n雨过太湖上，芙蓉水殿开。\n綵舟邀月上，玉盌送冰来。\n玉宇夜沈沈，天河似海深。\n下阶齐拜月，纤手学穿针。\n城上七星低，宫鸦绕树啼。\n朔风吹不入，自有辟寒犀。\n美人歌竹枝，胡蝶傍花飞。\n白日东窗静，金刀剪苧衣。\n雨过湖波绿，荷花水殿开。\n隔花人似玉，船上买冰来。\n秋风昨夜起，吹月到房栊。\n梦入关山去，江枫树树红。\n一尺街头雪，朝来没马蹄。\n狐裘不觉煖，更有辟寒犀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55925,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"襄阳歌","author":"胡奎","text":"襄阳太守白接䍦，襄阳儿唱白铜鞮。\n今朝载酒向何处，言往习家池上去。\n醉春日，歌春风。\n马上归，花正红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55926,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴歌","author":"胡奎","text":"第四桥边枫叶秋，青裙少妇木兰舟。\n月明打桨唱歌去，惊起芦花双白鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55927,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"商歌","author":"胡奎","text":"白日粲粲南山阿，长夜漫漫愁奈何。\n停车夜宿郭门外，悲风烈烈闻商歌。\n歌云不遭舜与尧，单衣短布风萧萧。\n人生卑微何可忽，后车载之相齐国。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55928,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴人歌","author":"胡奎","text":"江悠悠，挽使舟。\n吴人歌，歌邓侯。\n江水东流去不返，邓侯邓侯舟莫挽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55929,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东邻美女歌","author":"胡奎","text":"机上凤凰梭，盈盈抹两蛾。\n谢鲲双齿折，犹不废鸾歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55930,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"廉叔度歌","author":"胡奎","text":"成都太守廉叔度，三年守城人案堵。\n桑叶阴阴歌满路，不歌一襦歌五裤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55931,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"范史云歌","author":"胡奎","text":"三日不食釜生鱼，五日不食甑生尘。\n丈夫未遇甘贱贫，呜呼，岂无人间范史云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55932,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独漉歌","author":"胡奎","text":"独漉独漉，水深没足。\n水中有泥不见玉，世上人心易翻覆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55933,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"扊扅歌二首 其一","author":"胡奎","text":"停赵舞，罢秦声，妾歌扊扅君试听。\n五羖皮，西入秦。\n妾烹伏雌君远行，君今富贵忘贱贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55934,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"扊扅歌二首 其二","author":"胡奎","text":"燃蜡不如炊扊扅，炰凤不如烹伏雌，太官之羊不如五羖皮。\n妾弹秦筝君不知，吁嗟乎百里奚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55935,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"骊驹歌二首 其一","author":"胡奎","text":"朝出北郭门，骊驹在路傍。\n路傍秋草短，江月白如霜。\n歌骊驹，唱吴歈。\n千里万里道，三年两年书。\n愿为金络随君马，愿为双轮逐君车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55936,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"骊驹歌二首 其二","author":"胡奎","text":"河之水，清泱泱，津吏伐鼓声镗镗。\n主当渡河吏乃醉，女娟操舟赎父罪。\n持楫中流发棹歌，津吏酒醒女渡河。\n鸳鸯双飞可奈何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55937,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄鹄歌","author":"胡奎","text":"太液池水清涓涓，金衣菊裳下九天。\n建章宫中生紫烟，凤凰来仪羽翩翩。\n至德广被千万年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55938,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凤凰操","author":"胡奎","text":"凤凰兮衔图，殷道衰兮周德之符。\n岐山兮苍苍，五色烂兮朝阳。\n殷日短兮周日长。\n千秋万岁兮于彼翱翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55939,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别鹤操","author":"胡奎","text":"别鹤翩翩，结缡五年。\n吁嗟乎，欲移我所，天中夜倚户心悁悁。\n妾心直如琴上弦，为君一弹别鹤篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55940,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"精卫操","author":"胡奎","text":"石磊磊，海茫茫。\n白石不可烂，海尘何日黄。\n嗟哉精卫尔勿伤，昨日麻姑过东海，蓬莱弱水又生桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55941,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"越裳操","author":"胡奎","text":"有雉有雉，来于越裳。\n文王之德，孚于万方。\n远人其归，家国永昌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55942,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"襄陵操","author":"胡奎","text":"登彼会稽兮洪水滔滔。\n嗟我黔首兮百万嗷嗷。\n胼胝兮乘橇，过门不入兮使我心劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55943,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"涂山操","author":"胡奎","text":"有白者狐，九尾差差。\n时哉时哉，应彼昌期。\n水土底平，告功锡圭。\n坤德承乾，维王之基。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55944,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"箕山操","author":"胡奎","text":"箕之山兮颍之阳，箕之人兮濯沧浪。\n彼何人兮牵牛，吾洗耳兮徜徉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55945,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湘灵操二首 其一","author":"胡奎","text":"湘之水兮潺潺，湘之竹兮斑斑。\n湘之女兮绿云间，望重华兮不复还。\n九嶷兮苍苍，青猿啼兮夜何长。\n折琼芳兮寄远，鼓瑶瑟兮心伥伥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55946,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湘灵操二首 其二","author":"胡奎","text":"湘之水，清泱泱，二妃夜泣青筼筜。\n斑斑清泪流不尽，五十哀弦瑶瑟冷。\n鹧鸪啼处数峰青，一夜月明悲洞庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55947,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"八公操二首 其一","author":"胡奎","text":"淮南王，好神仙。\n朝餐金盘之玉屑，夕鍊宝鼎之神丹，骑龙下上超天关。\n超天关，驭天风，山前桂树青丛丛。\n人间白日西复东，安得从之招八公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55948,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"八公操二首 其二","author":"胡奎","text":"淮山苍苍淮水黄，桂树丛生山之阳。\n丹砂成金寿命长，身骑飞龙恣翱翔。\n千秋万古乐未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55949,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石妇操","author":"胡奎","text":"山头白石高数尺，人言贞妇化为石。\n贞妇化石不回头，俯视千年江水流。\n江水流，不可断。\n行人归，白石烂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55950,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伤殷操","author":"胡奎","text":"麦渐渐，黍油油，昔日殷墟今日周。\n吞声不语泪交流，玉杯象箸兮，何以解忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55951,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"思亲操","author":"胡奎","text":"儿陶于河，有乌傞傞。\n儿渔于泽，有乌翼翼。\n彼乌返哺，历山之下。\n归哉归哉，慰我父母。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55952,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"履霜操","author":"胡奎","text":"晨履霜兮，河之上。\n考不顾兮，儿见放。\n儿饥而寒兮，蓐食而荷衣。\n䜛口铄金兮，考胡不知。\n吁嗟命之穷兮，于河之湄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55953,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采薇歌","author":"胡奎","text":"西山有薇，薄言采之。\n周人有粟，弗疗我饥。\n宁薇而甘兮，毋粟而惭兮。\n维首阳之岩岩兮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55954,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"崩城操二首 其一","author":"胡奎","text":"一哭长城崩，谁言土无情。\n至今城下水，犹闻呜咽声。\n吾皇万古基太平，妇女不哭城不倾。\n城不倾，四海宁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55955,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"崩城操二首 其二","author":"胡奎","text":"以妾眼中泪，洒向城下土。\n城崩见夫骨，始知妾心苦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55956,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"君道篇","author":"胡奎","text":"夸娥莫移山，精卫莫填海。\n天作高山与海深，黄河一清圣人在。\n圣人有道津梁通，千门万户皆春风。\n岂不闻越裳重译贡白雉，万国归之若流水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55957,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"美女篇","author":"胡奎","text":"有女颜如花，生长越王家。\n浣纱白石上，何曾知馆娃。\n高台凌青天，朝歌暮复弦。\n宫人裁白苧，只知长少年。\n日月无停车，流光迅于电。\n春风吹落花，不到黄金殿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55958,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝剑篇","author":"胡奎","text":"床头有古剑，白虹夜流辉。\n炯然三尺雪，化作青蛇飞。\n岂无千金直，待价将安归。\n挂向徐君墓，时闻鬼母啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55959,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"明珠篇","author":"胡奎","text":"煌煌明月珠，乃在龙颔下。\n下沈无底谷，得之世无价。\n或人不爱宝，弹雀千仞冈。\n得失何足较，所嗟无夜光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55960,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"君道篇","author":"胡奎","text":"君道天广大，王言出如纶。\n雨露及草木，万物皆阳春。\n九重坐南面，四海奉一人。\n禹稷犹已溺，唐虞视同仁。\n华盖当中天，列星环北辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55961,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]