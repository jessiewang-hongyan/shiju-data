[{"title":"古台吟","author":"黄淳","text":"碧屿千流合，孤台旧寸开。\n断云封远树，醉屐落芳苔。\n兰有幽岩玉，春生待腊梅。\n寻源君不忘，欲赋我怜才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17467,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊辰归来","author":"黄淳","text":"归来多秋雨，竹云屯不晴。\n空斋坐中夕，蟋蟀周檐鸣。\n何以觉家好，布衾寒梦清。\n文章千年事，谁更为时名。\n离别无远近，不见总劳情。\n安得洞天侣，采此露下英。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17468,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醉卧玉台禅房","author":"黄淳","text":"翠岩流水菊花香，竹院无尘秋昼长。\n一枕游仙禅定后，不知孤磬近斜阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17469,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居杂兴 其一","author":"黄淳","text":"半壑青山万树松，白云为屋水为舂。\n石桥雨滑游人醉，笑把渔竿当短筇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17470,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居杂兴 其二","author":"黄淳","text":"渔父船头沽酒归，小儿吹穟妇停机。\n半溪杨柳半溪竹，醉着还开月下扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17471,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居杂兴 其三","author":"黄淳","text":"桃花洲上藕花矶，吟卧花间忘却归。\n村南也有老渔父，钓得鲈鱼不款扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17472,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题燕台胜览卷","author":"李上馨","text":"京国多佳丽，王孙几胜游。\n千金燕市日，一诺蓟门秋。\n筑击声悲壮，钩悬影动浮。\n惭予方梦鹿，短笔未堪投。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17473,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送梁吉孺之兰阳文学","author":"李上馨","text":"梁园此日赋南征，歧路分携怆客情。\n捧檄自随孤剑入，题桥宁负驷车荣。\n残碑历历中郎字，遗宅萧萧荀令名。\n座上谈诗颐欲解，讲帏今独有匡衡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17474,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李明皋之成都司理","author":"李上馨","text":"使君佐郡起贤科，祖帐都门奈别何。\n二酉近连岷岳出，三川遥待锦帆过。\n长悬揽辔安时策，争看乘骑夹道歌。\n奏绩正当停辇日，琐闱花发待鸣珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17475,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送谢见齐同年奉命归娶 其一","author":"李上馨","text":"江南词客谢玄晖，年少名成衣锦归。\n负弩前驱天下少，倚门双玉世间稀。\n泥封特许知恩重，宝炬遥分见御辉。\n不欲别君更翘首，白云何处是乡围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17476,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送谢见齐同年奉命归娶 其二","author":"李上馨","text":"仙舟远向蓟门开，兄弟风尘尔又回。\n紫气独悬关外满，浮云偏逐梦中来。\n乘龙应羡仙郎驾，引凤同栖玉女台。\n分手各天遥记忆，莫令春雁阻书裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17477,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"予奉命征西蜀春日会师瞿塘承王咏商水部招同杨漪翁明府雨中分赋","author":"卢瑛田","text":"东风幕府对琼觞，雨后论心兴转长。\n山入巫夔分楚蜀，人从师旅识王杨。\n夭桃花绽三春色，细草风生二月香。\n终宴不知更漏永，醉来犹欲赋高唐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17478,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"烈妇行","author":"王士龙","text":"公无渡河，岸南岸北皆风波。\n夫君胡为急梭梭，沉舟灭项将奈何。\n于归感君情义多，捐生从君殡山阿，纲常千载山嵯峨。\n妾心铁石应不磨，毋使涕泪空滂沱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17479,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"圆珠积翠","author":"黄琏","text":"峰峦万叠自西隅，王气千年此郁纡。\n科第旧曾题片玉，山川先已表圆珠。\n雨时如泣鲛人泪，光处真悬照乘图。\n好语英灵呵护在，四臣声价未应无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17480,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忠谠凝岚","author":"黄琏","text":"亭亭宝盖紫云屯，域内群山此独尊。\n白鹭池高天作鉴，苍龙峡静帝为门。\n读书台已称今古，遗俗人犹诵状元。\n八桂尚留风土记，忠言谠论至今存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17481,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鹤洲渔唱","author":"黄琏","text":"白鹤滩头白鹤飞，白鹤滩下有渔矶。\n鹤唳数声渔得意，渔歌几曲鹤忘机。\n潺湲无恙人今古，欸乃何知韵是非。\n一唱一觞堪一醉，一竿生事未全□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17482,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"狼岭樵歌","author":"黄琏","text":"伐木丁丁声自长，山歌处处更悠扬。\n宁知啸落音为凤，且喜时非道有狼。\n细听似赓黄鸟弄，远闻如奏白云乡。\n别难伴侣归来晚，拟古还看月在梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17483,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仙岩夜月","author":"黄琏","text":"岩岩维石郭东偏，一窍玲珑月得先。\n可向个中观太极，更从何处见心圆。\n蟾团白玉宁生魄，影落青娥亦小天。\n此景仙人原自有，迩来香火奉金仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17484,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乌石醴泉","author":"黄琏","text":"偶望酒星因依石，石□□□□为名。\n源从上古徒杯饮，流到于今岂解酲。\n□□□□王者瑞，曹门不禁圣人清。\n年年沽向□□□，□□春台济众生。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17485,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"状元古井","author":"黄琏","text":"状元南国名千古，井附公名亦到今。\n月夜影中仍郊往，春时地下尚龙吟。\n香生翰墨当年事，祀有潢污异代心。\n残漏一篇诗脉在，源头应许后人寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17486,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石壁朝云","author":"黄琏","text":"白雪千寻拔此方，彩云五色丽初旸。\n如衣如狗俄虚幻，非雾非烟恰是祥。\n几慰苍生霖雨望，谩劳太史步古章。\n怪来不入高唐梦，惟许从龙万里长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17487,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒仲节莫公祠","author":"黄琏","text":"南人魁选本沉沉，独自先生起郤林。\n一代科名堂号玉，千年第宅里名金。\n道侔伊吕相先后，名在江山已古今。\n大雅寥寥谁继响，几时风雨又龙吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17488,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过崇武写怀","author":"马梦吉","text":"崇武翩翩渡晚河，飘然天地一轻艖。\n王程车马曾经涉，驿路旌旗几度过。\n宦况渐怜青鬓改，旅怀长望白云歌。\n罗浮咫尺如堪对，回首神京路已赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17489,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀古","author":"马梦吉","text":"使节翩翩晚渡河，挥毫吊古漫蹉跎。\n千年霸气凌山岳，一剑孤魂逐逝波。\n亚父彭城埋怨骨，虞姬垓下咽悲歌。\n凭君莫话兴亡事，花落花开可奈何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17490,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次鲁源先生韵裁答宗志","author":"马梦吉","text":"抱疴归来思渺然，故园朋旧意堪怜。\n十年问学寻真谛，半夜论心得妙传。\n吾道本来无障翳，俗情空自混风烟。\n凭君指点江门路，活水源头便现前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17491,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"失题诗","author":"陈应龙","text":"昌黎文字登天府，爱筑书台伴山坞。\n翰墨淋漓草树香，哦吟呼动群虫舞。\n老洞开口陪笑谈，寒泉哽咽怜清楚。\n谁将邑宰限奇才，天为阳山降申甫。\n正气挽回天地春，斗牛直射无今古。\n虽落当年奸计笼，芳名历历播青史。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17492,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李侍御还朝","author":"黄维贵","text":"骢马翩翩不可留，绣衣归去侍宸旒。\n天边日月光仍近，炎海风霜凛未收。\n汉殿槛高攀欲折，大东轴尽涕堪流。\n极知无限澄清意，伫为苍生一借筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17493,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元旦示儿","author":"黄维贵","text":"客舍欣逢日月新，千门簇骑往来频。\n霏霏瑞雪占丰岁，恰恰流莺报早春。\n彩胜尚传风俗旧，屠苏先让少年人。\n遥瞻佳气长安近，明发休辞紫陌尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17494,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游七星岩","author":"黄维贵","text":"湖上群峰斗宿盘，高秋携杖破烟峦。\n瑶台石室知何世，玉液璚芝具可餐。\n鸟道暗穿岩底溜，虹桥斜挂镜中看。\n扁舟何限沧江思，采采芙蓉露正寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17495,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杭州邓明府德咸偕游紫金山 其一","author":"黄维贵","text":"山势盘盘卫紫宸，遥从玄极挹高真。\n光腾宝像金宫閟，气结龙纹宝篆新。\n珠树三花栖白鹤，云车五色驾苍麟。\n仙都自觉乾坤别，回首人间总幻尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17496,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杭州邓明府德咸偕游紫金山 其二","author":"黄维贵","text":"千寻丹壑斗嶙峋，福地初开广胜因。\n金粟自依双树影，白莲长捧一灯轮。\n僧留恰共青精饭，客到翻销紫陌尘。\n见说空门应不碍，何时舍筏渡迷津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17497,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杭州邓明府德咸偕游紫金山 其三","author":"黄维贵","text":"缥缈谁开第一梯，诸峰晴色坐来低。\n龙池不散金银气，鳌极潜通日月蹊。\n大壑风生千叠振，星河水下万行齐。\n虚疑上界无人到，此日飘飘驭紫霓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17498,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杭州邓明府德咸偕游紫金山 其四","author":"黄维贵","text":"丹丘岂亦避秦馀，谁向花源此卜居。\n楼阁昼扃云自护，松苓春长日堪锄。\n閒来共醉山中酒，深处应藏内景书。\n自笑悠悠空岁月，轩辕犹欲待公车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17499,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杭州邓明府德咸偕游紫金山 其五","author":"黄维贵","text":"万叠峰峦紫翠中，团飘幽胜在岩东。\n龙盘险绝浑无路，鸟道斜穿隐别宫。\n阴洞溜飞长作雨，欹崖松挂半垂虹。\n凭君共惬跻攀兴，别后云烟何处逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17500,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登鸡鸣寺塔","author":"黄维贵","text":"祇台开翠岫，化塔耸穹玄。\n曲磴盘龙上，飞甍过鸟前。\n钟离东嶂合，太液后池穿。\n树点人家小，空晴凤阙悬。\n苍茫平楚日，澹荡白门烟。\n爽籁流清梵，慈云蔼法筵。\n天鸡闻转近，寒鸽怖犹旋。\n乱雨昙花散，何年卓锡还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17501,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登滕王阁时期儿随北上","author":"黄维贵","text":"滕王高阁几登临，南浦西山自古今。\n最爱天边双白鹤，数声鸣和五云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17502,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊莲花洲","author":"黄维贵","text":"莲花洲上绿阴齐，隐隐人家路欲迷。\n自是归舟归未得，几回误作武陵溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17503,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"汴梁即事","author":"罗良信","text":"腊月驱车过汴城，朔风吹雪雪纵横。\n南阳未着蒲鞭化，西洛争驰竹马迎。\n钱谷甲兵称琐屑，祁寒暑雨总撄情。\n夜深重锁论文院，漏响鸿声入梦惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17504,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日大驾出幸海子","author":"尹守衡","text":"羽猎遨游处，春风遍地生。\n乐随仙仗转，人逐御香行。\n一发双雕落，三驱百兽惊。\n五云看缥缈，时傍衮衣明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17505,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答印山家兄","author":"尹守衡","text":"忆别春将暮，俄惊麦又新。\n纵惭强项令，肯作折腰人。\n远信惟加饭，深交若饮醇。\n金声先掷示，击缶愧难陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17506,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居","author":"尹守衡","text":"庐结烟霞外，清幽景不凡。\n神工辟丘壑，天籁响松杉。\n扫径花沾屐，凭栏月满衫。\n行藏今已定，何必问巫咸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17507,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重游开福寺访佛国和尚","author":"尹守衡","text":"胜地开莲宇，山川两岸分。\n启窗全纳日，扫榻半留云。\n钵静蛟龙卧，钟圆昼夜闻。\n春来烟水满，鸥鹭得同群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17508,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽陈翼所总戎邑人 其一","author":"尹守衡","text":"六师何日不张皇，一旅能来捍朔方。\n馘折四千雄虎贲，风传草木尽鹰扬。\n孤忠岂乏封侯骨，九死宁销烈士肠。\n汉垒云连成底事，军中独有一陈汤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17509,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽陈翼所总戎邑人 其二","author":"尹守衡","text":"曾歼关白入朝鲜，已斩杨酋定蜀川。\n猿臂昔尝称上将，龙头今尚见长天。\n皇穹自长妖氛恶，国运仍多杀气缠。\n遂使英雄尽尘士，又闻烽火照甘泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17510,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽陈翼所总戎邑人 其三","author":"尹守衡","text":"李家貔虎尽称雄，燕颔曾推贺总戎。\n今日尽同囚首辈，何人得似美髯公。\n沈沙赤血应成碧，丽日丹衷直贯虹。\n我欲招魂何处觅，鹤归华表月明中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17511,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽陈翼所总戎邑人 其四","author":"尹守衡","text":"壮岁相从尚几人，须眉长想旧精神。\n可怜燕市千金骨，化作龙堆一段尘。\n白草黄云同惨淡，凄风苦雨共悲辛。\n君恩此日河山远，莫道沙场不见春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17512,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虎邱山","author":"尹守衡","text":"邱峦高阚阖闾城，野寺姑苏旧有名。\n远浦楼台云外出，近河帘舫画中行。\n侵檐树色深深见，入座泉声细细生。\n一缕茶烟出方丈，晚风吹送有馀清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17513,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遣意 其一","author":"韩鸣鸑","text":"至人处世间，隐如在泽珠。\n和光固其扃，虚室辉有馀。\n燥湿不同营，喧寂各异趋。\n皎皎多易淄，守元称远儒。\n自非罔象流，赤水谁能濡。\n□哉先民言，盛德乃若愚。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17514,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遣意 其二","author":"韩鸣鸑","text":"凤凰鸣高冈，旷世一见之。\n翻身擢朝日，自顾羽毛奇。\n竹实何葳蕤，览辉以来仪。\n岂不厌寂寥，恐为众鸟嗤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17515,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望飞来寺","author":"余镗","text":"此寺既飞来，还须飞去否。\n山水一以佳，福地自悠久。\n无住无无住，空王默点首。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17516,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿东林梁先生八十","author":"温可贞","text":"南极星辉照寿筵，天香浮动彩云边。\n蟠桃摘献来三岛，青鸟迥翔下九天。\n戏舞斑衣罗膝下，芬芳兰桂满阶前。\n喜君福禄源流远，知是人间不老仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17517,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悼赖圣教","author":"何献科","text":"白雪伊谁唱，青云是处行。\n豫章惊往梦，蒿路引前旌。\n有子箕裘绍，吾徒绝续轻。\n乍闻心泪洒，况复孝成名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17518,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游普陀岩","author":"詹一惠","text":"寻真郭外陟层巅，古洞仙岩别有天。\n风度松音随去鸟，涧通人迹溅鸣泉。\n登临聊发开尊兴，习静偏宜枕石眠。\n更喜山灵飞雨泽，黍苗应候绿芊芊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17519,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登文昌阁","author":"詹一惠","text":"楼台百尺俯崚嶒，极目清风快一登。\n海外清波擎石柱，天边瑞彩起飞鹏。\n凭高自喜尘情减，敲句何妨酒兴增。\n不是贤侯轮奂美，斗奎何日照疏棂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17520,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古","author":"刘克修","text":"客从远方来，遗我绿绮琴。\n拂拭青玉案，因之理素心。\n初作飞龙引，再弹梁甫吟。\n四座同欢听，岂无山水音。\n忽听钟子期，悽断泪沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17521,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"猛虎行","author":"刘克修","text":"西风日夜声萧索，猛虎咆哮入城郭。\n惯从屋里饱鸡豚，不复山中护藜藿。\n东家犊死血犹腥，西家犬尽寂无声。\n猿臂将军暂何去，假威狐魅敢横行。\n道旁遗迹大如斗，田翁乍见失声吼。\n童稚闻言心胆寒，风吹草动皆惊走。\n杀气狰狞可奈何，牛哀倏忽事偏多。\n宏农太守今安在，问尔何时北渡河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17522,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠陈振狂","author":"刘克修","text":"词坛推独步，当代几人如。\n笥有笼鹅帖，家藏种树书。\n山花充户牖，江水绕庭除。\n好是陈平宅，何多长者车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17523,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送家弟季德游武夷","author":"刘克修","text":"少年轻远别，一舸又江关。\n剑浦寒云合，芝城春水潺。\n世途多白眼，汝意只青山。\n大姥重相过，应探宝诀还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17524,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登浚县文昌阁","author":"刘克修","text":"杰阁岧峣倚翠微，寒烟衰草正离离。\n姬封百里馀清卫，禹迹千年只大伾。\n涉世谁分薪者梦，忧天徒切杞人悲。\n凭高北望频翘首，何处彤云是禁闱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17525,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"署中别季德弟赴京","author":"刘克修","text":"栖迟薄宦倍愁思，梦草瞻云几岁时。\n逐路莺花供杖履，连床灯火慰埙篪。\n时来尔献河东赋，政拙吾惭岘首碑。\n万里飞腾须及早，不堪沾袖又分歧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17526,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒岳王坟","author":"刘克修","text":"雄心誓拟净楼兰，谁遣王师一日还。\n颈血朝才荣蔓草，蜡书夜已出重关。\n长城自剪宁嚬蹙，臣构初书想厚颜。\n千古怨魂招不得，临风馀泪独班班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17527,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"琼花观","author":"刘克修","text":"仙子云軿去已赊，观名犹记旧琼花。\n如闻月下传清佩，更想风前斗丽华。\n古殿春深留瓦雀，衰杨日暮隐栖鸦。\n锦帆烟灭霓裳罢，无数凄凉总可嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17528,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日写怀","author":"刘克修","text":"薄宦悽悽岁屡迁，可堪时迹漫多邅。\n天涯浪说人为日，眼底其如夜似年。\n塞马由来忘失得，海鸥应许共流连。\n云山珠水知何处，不断飞来到枕边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17529,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻雁","author":"刘克修","text":"水落天空秋气清，夜深闻雁过高城。\n蒹葭水国情偏适，霜雪天涯梦独惊。\n弄影每怜干陆羽，离群应作断肠声。\n天南天北随时度，谁念年年万里行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17530,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"明妃曲","author":"刘克修","text":"霜凋青草枯，玉貌委泥途。\n妾泪空盈掬，君恩只按图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17531,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]