[{"title":"新春写怀","author":"叶菁","text":"习静观空万虑消，旁人休更说萧条。\n尘居自觉閒为上，世态谁怜贱转骄。\n花鸟当春劳杖屦，溪山随意伴渔樵。\n十年奔走何为者，敝尽先人箧裹貂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32630,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重九后访玉台道人","author":"叶菁","text":"节过重阳兴未阑，杖藜时复叩黄冠。\n石坛挥麈丹书古，涧树挂瓢碧溜寒。\n孤鹤似辞缑岭至，片云长与道人看。\n红尘一望三千顷，九转何因生羽翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32631,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓山吊古 其一","author":"黄士先","text":"烈风竖鳄涛，白日江天暝。\n但闻松柏声，不见松柏影。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32632,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓山吊古 其二","author":"黄士先","text":"夜雨湿流萤，远山互明灭。\n千古此战场，精光无复歇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32633,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓山吊古","author":"陈懋时","text":"冷落冤魂不可招，夕阳残垒晚萧萧。\n未闻白鹤归华表，曾见黄龙起暮潮。\n庙鼎荒山标异代，叶填宫井认前朝。\n神州终是天王地，扫尽胡尘祲气消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32634,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓门怀古","author":"刘明世","text":"百战乾坤去已休，夕阳残垒见荒丘。\n潮痕隐隐犹含恨，山色冥冥尚带愁。\n三字狱中亡宝鼎，半闲亭上覆金瓯。\n何堪极目思量处，枫叶芦花两岸秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32635,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北燕岩","author":"黄光宗","text":"空山太古意，对坐日忘机。\n林鸟惊无定，岩花落且飞。\n寒泉挂石壁，落日照渔矶。\n世事空劳梦，还应学采微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32636,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓门夜泊","author":"黄光宗","text":"海门潮落野烟深，日暮舟维古木林。\n碣断孤陵人已远，花残荒殿客初寻。\n凄声是处传宵柝，怨杵谁家捣暮砧。\n十载飘零今泊此，不禁怀古动悲吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32637,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城郊外感秋","author":"黄光宗","text":"海国秋高马正肥，新人歌舞旧人非。\n松楸古墓麒麟冷，禾黍空城燕雀飞。\n暮雨暗秋吹画角，晚亭黄叶落斜晖。\n岭南自古繁华地，回首烟花事已违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32638,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重游玉屏山三著　并引 其一","author":"黄光宗","text":"二十馀年又一过，岩花犹对旧山河。\n重来尚作萧条客，四十登临感慨多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32639,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重游玉屏山三著　并引 其二","author":"黄光宗","text":"磴道嵯峨访旧踪，石门深处薜萝封。\n相逢道侣皆非昔，廿载空怜逐转蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32640,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重游玉屏山三著　并引 其三","author":"黄光宗","text":"石径棱棱石径嶷，廿年裘马昔曾游。\n那堪老大重来此，惭愧山灵笑白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32641,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠樊侍御戍雷阳道过阳江 其一","author":"刘景廉","text":"抱诏辞京国，携家望戍城。\n逆鳞批讵讳，立马戒犹鸣。\n疏草千秋意，烟霜万里征。\n行行过泽畔，不愧楚臣名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32642,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠樊侍御戍雷阳道过阳江 其二","author":"刘景廉","text":"放逐谁为侣，青山日在门。\n云霞聊寄兴，桃李自无言。\n恋阙孤臣思，投荒圣主恩。\n赐环应有日，尊酒意犹存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32643,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入阴那山","author":"李士濂","text":"别来忆六载，重入叩禅扉。\n林茂鸟声好，谷幽人迹稀。\n登峰堪掬日，浴涧胜寻沂。\n清可一泓注，末流何自歧。\n谈玄与诋佛，臧谷辩谁迷。\n若问菩提偈，空山叶落时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32644,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阴那山吟","author":"李士涟","text":"云里青山山里僧，曾闻梵语送钟声。\n迎风柏叶时吹面，落涧松花半点缨。\n金界香浮空鹤舞，钵池月浸碧荷新。\n何当共吸菩提露，合作西来一味清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32645,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寺桥晚眺","author":"李士涟","text":"玲珑柏翠隐禅家，断续钟声送落花。\n石路疑从趺坐尽，烛光解道暗衢华。\n槛边树卧皈依水，涧侧林深半染霞。\n莫谓山中生色少，白云岫出满天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32646,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"那山夜宿","author":"李士涟","text":"谁向招提游，松风半榻收。\n灯燃千古暗，法转一轮秋。\n云影窗前白，月光枕畔幽。\n轮回知孰是，蕉鹿梦悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32647,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再入那山读书","author":"李士灏","text":"旧客重来古刹林，柏条飞帚拂尘襟。\n泻泉风送晴还雨，密树云栖昼亦阴。\n迹印苔痕知鹿过，鉴开萍孔识鱼沉。\n石床坐久僧归院，更看蒲团与论心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32648,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题柏","author":"李士灏","text":"古柏菁葱几度春，风摇小叶学挥云。\n携团坐爱深林稳，赢得飞花乱点文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32649,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"珠江感秋","author":"苏学程","text":"牂牁东汇水连空，惨淡黄云唳晚鸿。\n泽国疏烟寒倚棹，城陴哀角暮随风。\n千家砧杵秋先断，数点渔灯乱后红。\n摇落江湖成底事，几堪萧瑟月明中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32650,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登白云山绝顶望罗浮","author":"苏学程","text":"万叠嶙峋紫翠重，长松寂历似秦封。\n采芳谁与寻三秀，访古空闻化九龙。\n云径寺荒犹驻鹤，春山花发引携筇。\n飘然欲御罡风去，四百峰头好寄踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32651,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"安期岩","author":"苏学程","text":"花落猿啼削壁间，升真元迹渺难扳。\n白云封后无鸡犬，流水声中有佩环。\n草树不知蝉蜕去，烟霞长伴鹤胎间。\n飘飘玉舄知何处，且掇菖蒲学驻颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32652,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小金山禅寺","author":"苏学程","text":"上方钟磬倚秋空，平楚苍苍落照红。\n波漾楼台翻罨尽，烟销江树晓青葱。\n渔歌浅濑孤篷晚，僧渡慈航一笛风。\n淡月微云窥色相，昙花时现法轮中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32653,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别雷文学","author":"苏学程","text":"不堪萧瑟气悲哉，风笛离亭罢酒杯。\n心折此时杨柳曲，棹经何处水云隈。\n相思为报衔鱼鸟，别后愁扳破腊梅。\n胶漆袛应投末契，天涯白发老相催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32654,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月溪山寺","author":"苏群岳","text":"招提翠微上，回合薜萝深。\n远壑鸣寒籁，空门闭夕阴。\n磬声和梵呗，山寂对禅心。\n万樾森秋色，风来猿一吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32655,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱","author":"苏群岳","text":"郭外少尘事，仙丘半欲芜。\n虚亭留玉舄，荒井汲珊瑚。\n夕霭横明灭，丹光乍有无。\n似闻笙鹤过，此地即蓬壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32656,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韶州观音岩","author":"苏群岳","text":"维舟此山下，磴道蹑云根。\n绝境疑无地，惊涛涌是门。\n红尘飞不到，白鸟自孤鶱。\n向晚诸天寂，江山月半痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32657,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过虞部欧祯伯先生蘧园","author":"苏群岳","text":"松菊赋归来，森森一径开。\n小池通阿耨，高阁望蓬莱。\n远目扶桑出，樛枝倦鸟回。\n逌然终吏隐，况复一仙才。\n忆昨辞金马，投閒步紫苔。\n地偏风飒至，衣但薜堪裁。\n自种先生柳，争誇水部梅。\n孤标谁可似，千古意悠哉。\n兴在过逢数，情深凿落催。\n馆能招隐辟，记取旧宗雷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32658,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石其人","author":"冯椿","text":"才名惊世在名山，山在其人方寸间。\n不是其人身不出，白云深闭九重关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32659,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"田妇","author":"冯椿","text":"谁家少妇着青裙，低笠随夫笑语耘。\n多少深宫閒白昼，烟花涂抹几如君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32660,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感怀","author":"崔一鸣","text":"明月皎寒夜，徘徊启南扉。\n严霜被中野，白露繁沾衣。\n淅沥林中叶，飘飖辞故枝。\n仳离自多感，况复岁月违。\n瞻望怀所思，明星灿垂帏。\n掩袂翻自误，被褐当谁知。\n兰桂有移植，动摇发危机。\n好我亮无斁，携手同车归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32661,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怨诗","author":"崔一鸣","text":"律穷气转肃，客子愁不欢。\n中宵起傍徨，欲往衣裳单。\n内顾子与妻，黯默私自怜。\n力田有凶岁，并狩无悬貆。\n念此怀感伤，何以卒岁年。\n凤凰鸣高冈，耻效鸱与鸢。\n时俗贵苟得，烈士羞瓦全。\n弱年守微尚，秉心塞以渊。\n世人竞自媚，意气何由前。\n拔剑不能割，安用称豪贤。\n知己不援恤，安用相周旋。\n闻子爱芳草，杂佩纫蘅荃。\n馨香岂不烈，坐惜芳时捐。\n淩晨履霜雪，日暮临广川。\n方舟不我济，惜哉空洄沿。\n咏彼北门诗，悠然感遗编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32662,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醉歌行","author":"崔一鸣","text":"风流主人能爱客，夜宴华堂秋月白。\n坐中感激悲歌人，慷慨一声裂山石。\n酒酣因忆少年时，狂歌击筑易水湄。\n长安走马折杨柳，千金买笑调蛾眉。\n醉舞剑劈珊瑚枝，龙文匕首光陆离。\n狂来落笔作词赋，纷纷儿辈徒惊痴。\n岂知豪华易零落，岂知世情惯衰恶。\n风尘回首缁素衣，始悟当年意气错。\n秋风萧萧洛阳道，青丝变尽朱颜老。\n由来岁月不待人，富贵功名苦不早。\n酌君酒，为君歌，劝君莫惜朱颜酡。\n大鹏蹋翅伏沧海，终须变化翻洪波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32663,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得侠客","author":"崔一鸣","text":"侠客佩吴钩，翩翩控紫骝。\n挥鞭度辽水，拟斩月支头。\n朔气三河冷，边风九月秋。\n国仇吾欲雪，非为觅封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32664,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题","author":"崔一鸣","text":"杨柳晓烟销，春愁伴翠翘。\n梦回魂欲散，歌好雪全飘。\n舞怯双垂手，愁缠小折腰。\n殷勤烦玉指，幽怨若为调。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32665,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古意","author":"崔一鸣","text":"蒹葭采采露为霜，楼上啼乌伴夜长。\n谩道故人工比素，独怜中妇织流黄。\n葳蕤宝带同心结，宛转流苏百和香。\n零落空华君不见，封书谁为寄渔阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32666,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白云杂咏","author":"崔一鸣","text":"日夕寒烟生，鸣蛩响衰草。\n古道无人行，空山白云老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32667,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采莲曲","author":"崔一鸣","text":"妾本临江住，芙蓉荡双楫。\n日暮不归来，江头待明月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32668,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"从军行","author":"崔一鸣","text":"万里居延百战城，胡沙落日暮风生。\n将军没后勋劳薄，空博匈奴畏姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32669,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮飞翠","author":"吴世英","text":"浮来山色郁蕯葱，耸出烟云淡宕中。\n天入苍茫连远岛，地干碧落起蟠空。\n聚霞暮变千层紫，见日时标万丈红。\n四百峰头横翠霭，氤氲飞过相江东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32670,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春访道人于宝林庵阁限韵","author":"黎存爵","text":"春深云阁始经过，水面青钱已长荷。\n红粉色空消世幻，黄庭香透袅烟萝。\n风清法座猿听讲，日静禅林鸟和歌。\n参谒特来求半偈，回头苦海息狂波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32671,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉溪杂兴","author":"黎跃龙","text":"一望菰蒲杨柳，万家烟雨楼台。\n江南何处相近，桃叶渡口归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32672,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来寺","author":"郑周","text":"十九峰头古木蕃，谁移梵刹此中蟠。\n洞云溪月堪招隐，竹径松门可避喧。\n宝塔千秋函舍利，玉环何处觅归猿。\n问奇应尽登临兴，簪绂相看且莫论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32673,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕中除夕","author":"翟绳祖","text":"岁尽为今夕，家乡近若何。\n书缘遥路断，客向别愁过。\n日月随人老，杯盘且自歌。\n亲知余未反，休更倚门多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32674,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜坐有怀","author":"梁应高","text":"独坐尘缘息，开樽漫自倾。\n空庭留月色，疏叶落寒声。\n雾薄千山暝，灯残万籁清。\n念我平生友，悠悠无限情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32675,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饮庐陵徐氏园","author":"梁应高","text":"名园开雅宴，对月共飞觞。\n曲艳连云响，花奇带雪香。\n主人情更重，醉客兴犹狂。\n天地吾侪在，相欢此夜长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32676,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度梅关遇雪","author":"梁应高","text":"几度梅关思转赊，谩听松底乱鸣鸦。\n阴云聚雨当空出，旅客冲寒入径斜。\n挂壁石碑添淡绿，沿崖古木落残花。\n人生南北应难定，感叹流光黯自嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32677,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寓江西建昌除夕","author":"梁应高","text":"蜡炬光燃午夜天，悲笳吹急转凄然。\n冲寒柏叶杯中换，送暖梅花雪里传。\n怅望乡关频入梦，萧条客舍恍如禅。\n年过六十不称意，明日那堪又一年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32678,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜","author":"陈朝资","text":"橐里年来却少金，忍看时物自萧森。\n寒梅带月移墙角，瘦竹牵风过水浔。\n人世几誇挥麈尾，才华谁复别鸡林。\n虚教僻处能怀瑾，实苦凭栏折此心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32679,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旧鹤还巢","author":"袁天瑞","text":"一去琼台梦几春，风光还记此溪滨。\n白云高树黄花主，明月孤舟赤壁人。\n十顷湖田秋啄足，一声江笛晓归频。\n静求深养丹砂顶，莫放茶烟破睡魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32680,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山隐","author":"袁天瑞","text":"今古谁同物外情，鹿门风致首阳清。\n烟霞堆里三间小，松柏阴中一榻横。\n春酒醉来花对舞，石棋敲断鹤栖声。\n岩前清沁诗脾水，谁许高人此濯缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32681,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚望","author":"袁天瑞","text":"远树连天暗，烟横夕照微。\n芦花秋水阔，孤雁候群飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32682,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕","author":"袁天瑞","text":"凄凄鼓角乱更筹，细雨残灯客况幽。\n老大无穷家国念，肯同儿女望牵牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32683,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东湖钓叟","author":"袁天瑞","text":"风月飕飕白发寒，芦花篷底坐渔竿。\n烟波不是逃名姓，莫作鸱夷一样看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32684,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游南华寺","author":"余若麒","text":"诸峰攒合翠如环，一带晴溪落远湾。\n见说传衣推白足，偶然持钵访青山。\n悟从无树非台里，道在林光水气间。\n夜月晓钟曾对语，个中赢得片时閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32685,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古意 其一","author":"袁登道","text":"春意照罗帏，林花发明彩。\n为寄远征人，流光不相待。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32686,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古意 其二","author":"袁登道","text":"南国有佳人，华姿皎如雪。\n掩袖扬素波，含情对明月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32687,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古意 其三","author":"袁登道","text":"莲实何离离，花开日莫时。\n颜色要君赏，此心君讵知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32688,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古意 其四","author":"袁登道","text":"依依杨柳枝，青青可怜色。\n欲折不胜情，长条意何极。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32689,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古意 其五","author":"袁登道","text":"坠叶断秋蓬，年华落镜中。\n自惭明月影，罗帐不禁风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32690,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古意 其六","author":"袁登道","text":"飞飞云中鸟，湛湛清波鱼。\n飞潜各异趣，会合当何时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32691,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古意 其七","author":"袁登道","text":"蝉啼绿窗夕，雁诉秋风寒。\n门前盼行迹，惆怅山上山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32692,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古意 其八","author":"袁登道","text":"明月沈大海，落花离故枝。\n愁见东流水，汤汤无复期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32693,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春思 其一","author":"袁登道","text":"悲心悬夜月，思泪掩罗巾。\n惭愧堂前燕，双栖故似人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32694,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春思 其二","author":"袁登道","text":"孤雁断边城，深闺空复情。\n愁心似春草，抽尽死还生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32695,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"幽兴 其一","author":"袁登道","text":"初日耀阳林，潭景倚春树。\n时聆众壑声，不知夜来雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32696,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"幽兴 其二","author":"袁登道","text":"微雨从东来，枝上遍潇洒。\n用尽东风力，还逐东风嫁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32697,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"幽兴 其三","author":"袁登道","text":"佳期复何在，策杖春山阿。\n林中有幽事，酌酒还自可。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32698,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"幽兴 其四","author":"袁登道","text":"太虚恒寂然，众类纷以作。\n中有蓬栖人，游心在玄漠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32699,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]