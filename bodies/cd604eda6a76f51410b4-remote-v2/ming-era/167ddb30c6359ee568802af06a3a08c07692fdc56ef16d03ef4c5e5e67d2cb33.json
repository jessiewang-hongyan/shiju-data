[{"title":"庆寿图为郭处士赋","author":"潘希曾","text":"竹有高节梅有香，岁寒之松郁苍苍。\n先生比德梅与竹，先生致寿松俱长。\n春风吹筵酒波绿，画图辉映人如玉。\n醉来饱嚼千年苓，索笑梅花闲杖竹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58834,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"福州控海楼尚市舶宴上作","author":"潘希曾","text":"万里登临一系舟，八闽形胜此危楼。\n水通溟渤来重译，山入云霄壮上游。\n题句只疑南斗避，倚栏还为夕阳留。\n主人兴剧谁能尽，举白频劳向客浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58835,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题钟太守邦臣诰敕誊黄卷","author":"潘希曾","text":"家学一经在，天香双桂荣。\n诰鸾凡几轴，符虎又专城。\n炎海晴无瘴，阳春政有成。\n汉家循吏传，黄霸早驰名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58836,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"广州海珠寺","author":"潘希曾","text":"钜海环山寺，丛筠护石提。\n混涵天上下，升坠日东西。\n到恨浮槎晚，归疑去路迷。\n萍踪久漂泊，愧尔定僧栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58837,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"广州小金山","author":"潘希曾","text":"乐山何必高，山高徒峻嶒。\n乐水何必深，水深或崩腾。\n岭南小金山，一水碧洄萦。\n香火何代寺，空阶蚀潮痕。\n地绝往来少，林幽鸟弄音。\n登眺凌虚空，恍在扬子心。\n还疑清浅流，盈盈到蓬瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58838,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三洲岩","author":"潘希曾","text":"客游过端溪，心目旷烟水。\n忽睹三洲岩，岿然俯清泚。\n舣舟往从之，天风送高举。\n岩深洞口暗，既入殊可喜。\n玲珑若神剜，虚明自天启。\n石门陈广乐，云液凝钟乳。\n安知神仙流，羽化不自此。\n玄鹤夕未归，落日空徙倚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58839,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梧州吕仙亭次韵酬薛佥宪子纯","author":"潘希曾","text":"郁郁苍梧山，高高吕仙台。\n山川故无恙，仙人去不回。\n空馀千岁松，根深茯苓埋。\n当时鹤不见，白云昼成堆。\n故人拉我游，一笑万里来。\n兹辰属岁暮，瞻望徒徘徊。\n宇宙难可穷，人生亦劳哉。\n谢君斗酒意，临风渺予怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58840,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜泊藤县次韵酬湛内翰","author":"潘希曾","text":"泛舟苍梧来，又泊藤江口。\n去国万馀里，遥夜瞻北斗。\n冉冉岁月逝，厥柄忽临丑。\n银河注清浅，经纬烂星宿。\n低头阒无人，图书陈左右。\n残灯耿明灭，炉烟细当牖。\n正尔不能寐，忧来欲皓首。\n迢迢江湖心，匪为行役久。\n望眼不可极，云山互缠纠。\n中道欲何依，赖兹同心友。\n珠玉时见投，缪戾亦予咎。\n驽马逐骅骝，竭力常恐后。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58841,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浔州东津驿书感","author":"潘希曾","text":"沿回左江湄，至止东津驿。\n游子怀往事，恻怆泪沾臆。\n昔在景泰中，蛮獠祸孔棘。\n我祖宪府英，提兵此驻节。\n疆场赖敉宁，蛇狶就俘馘。\n王事诚辛勤，营星陨中夕。\n去今六十载，相传犹仰德。\n嗟予小弱孙，寡昧何所识。\n王命使南交，幸兹吊遗迹。\n天涯岁云暮，寒风吹独立。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58842,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"横州道中见日光识喜","author":"潘希曾","text":"苍梧南来一千里，扁舟牵挽穷山水。\n蛮烟瘴雨动浃旬，长昼冥冥无午已。\n仆夫泥涂蓑作衣，青蕉裹饭不疗饥。\n萧条行李润生醭，寂寞炊灶寒无辉。\n愁予兀坐篷窗下，忽睹阳光射云罅。\n千林生色岚雾开，须臾变幻疑昏夜。\n人言此方风土乖，冬雨苦久晴颇佳。\n乍晴不堪还乍热，郁蒸疠气生阴厓。\n我望青天再下拜，太阳高照元无外。\n蕞尔遐荒特可怜，覆盆何碍乾坤大。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58843,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"横州马伏波祠","author":"潘希曾","text":"乌蛮滩上伏波祠，万里南来酹一卮。\n薏苡不妨成贝锦，功名终许勒宗彝。\n云连草树疑精爽，地杂华夷仰护持。\n屈指云台旧时将，几人庙食尚天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58844,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"独卧","author":"潘希曾","text":"独卧篷窗晚，沧浪闻啸歌。\n穷年行路远，归梦入春多。\n绿树蛮村合，红霞瘴雨过。\n相忘祗鸥鸟，汎汎共烟波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58845,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"除日永淳道中得风","author":"潘希曾","text":"扁舟江上久沿洄，十幅蒲帆顷刻开。\n除日并将孤闷去，好风先向隔年来。\n分香夜泊梅花岸，带暖时倾柏叶杯。\n早晚咨诹王事毕，五云回首即蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58846,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"癸酉元日","author":"潘希曾","text":"自涉名途十二年，年年元日不同天。\n九重日驭三回侍，万里星轺两度旋。\n哀苦尝劳乌借力，艰危仅脱虎垂涎。\n悠悠往事成春梦，谩把今春付醉眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58847,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新年作","author":"潘希曾","text":"岁事属更始，东风扇微和。\n郊原萋动色，桃李艳已花。\n游子行万里，眷之感慨多。\n感慨故有怀，简书可柰何。\n尺素托双鲤，沦没愁长波。\n肃肃随阳雁，迟予同尔徂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58848,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"凌山驿次湛内翰韵四首 其一","author":"潘希曾","text":"阴雨忽开霁，江云散晓霞。\n日升林影动，一径见山家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58849,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"凌山驿次湛内翰韵四首 其二","author":"潘希曾","text":"嘉树晴光艳，澄江春水深。\n渔翁坐晒网，顾妇作蛮音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58850,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"凌山驿次湛内翰韵四首 其三","author":"潘希曾","text":"风日春来好，江村蔼众芳。\n檐暄嬉妇子，陇夕下牛羊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58851,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"凌山驿次湛内翰韵四首 其四","author":"潘希曾","text":"南裔行将尽，荒村仅自存。\n萧条村里驿，日午不开门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58852,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"人日","author":"潘希曾","text":"新岁易为感，遐荒独自行。\n雨晴人日好，天远使星明。\n望阙轻阴转，思乡芳草生。\n无情江上雁，肃肃背予征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58853,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病中遣怀","author":"潘希曾","text":"经旬抱微瘵，闷闷向天涯。\n夜雨长汀草，春风开野花。\n无功终屏药，有梦只还家。\n漫学长生术，朝来咽日华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58854,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南宁太平之间岩石奇绝累日玩之不厌","author":"潘希曾","text":"两涯回石壁，悦玩竟忘疲。\n混沌何人凿，玲珑一世奇。\n累累鼎象物，隐隐画藏诗。\n绝顶云昏处，惟应仙鹤知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58855,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"龙州仙岩次湛内翰韵","author":"潘希曾","text":"烟霞霭平野，孤岩敞幽扉。\n仙人此脱屣，千载鹤不归。\n而我万里来，矫首空遐思。\n东风散微雨，古木泛斜晖。\n宾主聊尽欢，一尊本无期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58856,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿布村","author":"潘希曾","text":"泥涂日已夕，草阁雨犹寒。\n美睡方知倦，羁栖自鲜欢。\n泉声回涧底，花气蔼林端。\n往路还何许，沉沉夜欲阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58857,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出镇南关","author":"潘希曾","text":"崔嵬分茅岭，镇南扼雄关。\n持节始入交，山路何郁盘。\n乔林映前旌，鸣驺历层峦。\n纶命自天下，恩光回日南。\n道路尽膜拜，冠带争骏奔。\n语言虽假译，文物亦可观。\n藐兹溟海壖，声教古所渐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58858,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次安南坡垒驿","author":"潘希曾","text":"万里安南第一程，停骖此日快新晴。\n喧林鼓吹晨分队，耀野旌旗夜宿兵。\n土俗衣冠犹自异，春风草木有馀荣。\n乾坤覆载何遐迩，正北红云是玉京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58859,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"北峨歌","author":"潘希曾","text":"北峨驿前江水流，百折直到苍梧州。\n苍梧去海几千里，江水朝宗势未已。\n桃花昨夜飘小红，大海浮去春风同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58860,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"不慱驿晓枕","author":"潘希曾","text":"鸟啼山馆曙，睡思共春浓。\n香袅沉檀细，花明锦绣重。\n简书仍往路，岁月只孤踪。\n稍稍荒烟外，崎岖又几峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58861,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"卜邻驿","author":"潘希曾","text":"卜邻之驿谁与邻，荒山四面徒嶙峋。\n白云当檐来往频，长藤古木相依因。\n萧条溪谷少人民，时有翠鸟啼青春。\n我尝御风遍八垠，徒步北斗趋紫宸。\n回头一瞬隘九真，蹊径诘曲难具陈，华风渐染何时淳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58862,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"仆山道中次湛内翰韵四首 其一","author":"潘希曾","text":"看花难得早春同，花好休教尽意红。\n我欲回时重见面，恐因烂漫易随风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58863,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"仆山道中次湛内翰韵四首 其二","author":"潘希曾","text":"不知春色几多深，是处青山鸟弄音。\n我亦有怀难了了，天涯相伴作微吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58864,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"仆山道中次湛内翰韵四首 其三","author":"潘希曾","text":"空谷来鸣何处驺，前驱旗鼓逝如流。\n盘旋尽日无村郭，一笑真成汗漫游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58865,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"仆山道中次湛内翰韵四首 其四","author":"潘希曾","text":"绿杨沿路綵旗垂，春日悠悠何所之。\n忽睹好山云外起，欲淩绝顶自题诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58866,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丕礼道中","author":"潘希曾","text":"我行丕礼墟，交路将过半。\n田畴稍连络，山势亦平缓。\n竹树交远村，鸡鸣烟火晏。\n士女作队游，语笑不可辨。\n维时王正月，桃李已零乱。\n好风自东来，流莺道边啭。\n天地信广大，兹游未知倦。\n人间多桃源，亦复不常见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58867,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿昌河","author":"潘希曾","text":"初辞寿昌驿，复渡寿昌河。\n岸静连苍竹，潮平漫绿波。\n墟人喧鸟语，海舶起渔歌。\n行尽天涯路，春风亦自和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58868,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"发市桥驿","author":"潘希曾","text":"细雨青林暗市桥，五更灯火促星轺。\n紫泥擎出天恩重，赤土分来海国遥。\n正朔不殊尧日致，封疆何用汉时标。\n午风披拂轻阴散，春色还同喜气饶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58869,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"发吕瑰驿至王国","author":"潘希曾","text":"山郭自为国，江春不作寒。\n百蛮奔海峤，双凤下云端。\n封建昭周礼，威仪盛汉官。\n停骖聊信宿，归计又长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58870,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵荅安南国王兼辞其赆","author":"潘希曾","text":"皇家声教古无前，此日春风动海天。\n龙节远辉南斗外，鸟星长拱北辰边。\n藩垣义在思分土，献纳才疏愧济川。\n临别何须重金币，赠言馀意忆他年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58871,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"回渡富良江二首 其一","author":"潘希曾","text":"富良江头风日晴，王子乘春送客行。\n一棹中流歌未毕，隔江花柳已相迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58872,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"回渡富良江二首 其二","author":"潘希曾","text":"江北江南从此辞，江波潋滟似来时。\n春风送客无南北，带得莺声过水涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58873,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"回至吕瑰再次王韵辞其赆","author":"潘希曾","text":"久依香案玉皇前，手捧纶音下九天。\n不用橐金酬使越，须知封土在安边。\n周爰归去风生袖，长揖分离思满川。\n从此相望无远迩，讴歌同荅太平年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58874,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵酬安南国王饯别之作","author":"潘希曾","text":"万里观风百越春，瘴烟消尽物华新。\n车书不异成周制，飞跃元同大造仁。\n稍自沧溟输海错，永依朱鸟奠炎神。\n畏天事大无穷意，裁入新诗寄我频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58875,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"即事二首 其一","author":"潘希曾","text":"平畴水漫绿成行，正月交人已插秧。\n记得中原旧游处，雪消晴陇麦初长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58876,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"即事二首 其二","author":"潘希曾","text":"无雪元知麦不宜，家家饼饵秫为之。\n前村日暮菜花发，错望黄云傍短篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58877,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"回次坡垒示伴送陪臣","author":"潘希曾","text":"朅来辞交州，忽复至坡垒。\n咫尺见南关，春色不类始。\n香风老松花，繁阴变桃李。\n不问旧路迷，所嗟岁月驶。\n归鸿虽北徂，万里方自此。\n依依南枝鸟，为尔怜毛羽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58878,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南交纪事","author":"潘希曾","text":"往返南交道，东风浃二旬。\n诹询虽未广，风土亦堪陈。\n汉将标铜地，尧官致日辰。\n鄙夷甘异习，凋谢尽遗民。\n祝发无男女，加冠别缙绅。\n黑牙喧鸟雀，赤脚走荆榛。\n席地多盘膝，操舟悉祼身。\n野栖茅覆屋，露积竹为囷。\n断雪无牟麦，分秧及早春。\n槟榔生咀嚼，橘柚杂芳辛。\n蕉实黄初熟，椰浆白颇醇。\n珍奇难得象，躔度易占鹑。\n沉水来犹远，生金出岂频。\n盛陈兵肃肃，绝少马駪駪。\n蛇虺当筵舞，螺虾入鼎珍。\n稍依濒海利，难与大方伦。\n文亦同王制，圭仍析帝臣。\n方言时假译，职贡岁常亲。\n自适飞潜性，相忘覆载仁。\n我歌聊志异，何日尽还淳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58879,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵荅张东所廷实","author":"潘希曾","text":"出尘心迹了无缨，三十年来四海名。\n诗酒对时聊尔尔，行藏于世只平平。\n春风偶下贤人榻，南国空惭使者旌。\n牡蛎门墙菊花径，白云深锁不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58880,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"读宋茂名尹潘公家传","author":"潘希曾","text":"元运方兴宋祚危，正是桑田沧海时。\n从容一死酬君父，辛苦馀生为本支。\n殷室有仁堪并驾，史家无传合题诗。\n等閒成败都陈迹，惟有芳名百世垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58881,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送高掌教之赣州","author":"潘希曾","text":"几年吾婺赖仪刑，化雨平分赣水汀。\n毛义宦情劳捧檄，韦贤家学惯传经。\n故山榕叶归时见，官舍滩声静里听。\n君路渐南予渐北，飞鸿消息愈冥冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58882,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送高掌科颍之册封便道焚黄","author":"潘希曾","text":"五月官河雨乍通，星槎东下更乘风。\n周家典礼藩封盛，汉国河山带砺同。\n衣锦会看过故里，焚黄仍得报先公。\n秋来好是旌归日，青琐封题待纳忠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58883,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送令尹施天瑞之南靖","author":"潘希曾","text":"柳陌尘销暑雨残，故人骑马出长安。\n三场旧识凌云气，百里今为应宿官。\n丹荔黄柑知地胜，天涯民力赖君宽。\n元方若见凭传语，侍从年来愧素餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58884,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"即席次徐正郎庭实韵","author":"潘希曾","text":"思君咄咄困愁城，笑语重逢仆欲更。\n岁月有痕惟短鬓，乾坤无用是虚名。\n故园水竹三生梦，上国烟花万里情。\n自是同心堪细酌，坐沉槐月听鸦鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58885,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送丁司训器之赴建平","author":"潘希曾","text":"几年场屋擅才名，教铎初持向建平。\n燕市浊醪谈旧雨，潞河文鹢泛新晴。\n通家有分垂三世，游宦无端隔两京。\n珍重青毡携去好，讲坛高拥六经横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58886,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"八月十四夜西涯阁老园亭看月奉次限韵二首 其一","author":"潘希曾","text":"此月难同恨往年，树头今夕喜将圆。\n风流不是寻常地，露坐分明尺五天。\n共爱蟾光浮酒斝，还教鹤影舞花筵。\n夜阑更觉明宵近，秋色催人醉帽偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58887,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"八月十四夜西涯阁老园亭看月奉次限韵二首 其二","author":"潘希曾","text":"此回情景胜常年，树杪清光望欲圆。\n风掠暮云沉碧海，露含凉气洗青天。\n共求妙句传他日，还许高歌彻四筵。\n夜漏未央狂未己，秋来幽事我能偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58888,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十五夜戏效八音体叠前韵二首 其一","author":"潘希曾","text":"金气行秋年复年，石亭秋半月还圆。\n丝传律吕风回壑，竹逗清寒露满天。\n匏爵不辞歌既醉，土殽随意秩初筵。\n革更叵柰光阴速，木影中宵幸不偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58889,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十五夜戏效八音体叠前韵二首 其二","author":"潘希曾","text":"金波洗眼送流年，石假山头镜影圆。\n丝鬓暗惊行乐地，竹帘高捲未云天。\n匏成濩落堪豪饮，土不尘埃合肆筵。\n革鼓鼕鼕宫漏杳，木犀花底兴方偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58890,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送吴御医晦叔致仕","author":"潘希曾","text":"一入都门三十年，秋风归兴忽翻然。\n久供尚药回天眷，剩有良方与世传。\n白发光阴閒后好，青山杖屦醉来便。\n门前瀫水深如许，流泽应同橘井泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58891,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"林节妇挽词","author":"潘希曾","text":"天地无穷恨，何年返藁砧。\n箕裘遗腹事，铁石到头心。\n持此堪生死，留名亘古今。\n表门贞节字，愧杀白头吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58892,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送胡司训之河涧","author":"潘希曾","text":"故家文献素相闻，上国秋风喜见君。\n捧檄忽惊千里去，传经不负一生勤。\n祖筵漫对黄花雨，离思遥牵碧树云。\n莫厌寒毡淹岁月，栋梁榱桷是奇勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58893,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"大兴隆寺斋居次韵简何中舍仲默","author":"潘希曾","text":"古寺来春夕，溶溶月满亭。\n忽闻歌白雪，独坐叹晨星。\n蜡炬生花赤，沉烟作缕青。\n故人妨促席，肠断暮云停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58894,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿神乐观次前韵","author":"潘希曾","text":"不到仙家久，清虚尚此亭。\n十年浑昨日，一宿又明星。\n醒眼当谁白，寒松比旧青。\n出门尘境别，勒马几回停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58895,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早春次韵荅李内翰序庵","author":"潘希曾","text":"吹面东风渐可迎，春来天气快新晴。\n欣欣柳色如相得，脉脉河流亦有情。\n登眺我犹妨阮屐，校雠君不让韩檠。\n久同禁署非沦滞，岁月令人重友生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58896,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]