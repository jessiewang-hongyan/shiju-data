[{"title":"戏答李伯襄 其四","author":"伍瑞隆","text":"别路风尘万态新，相思宁在柳园春。\n故人纵是音书寡，折得垂杨不寄人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33189,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏答李伯襄 其五","author":"伍瑞隆","text":"惜春频上望春楼，花落纷纷水自流。\n不是世情春雪薄，任教纨扇不经秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33190,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏答李伯襄 其六","author":"伍瑞隆","text":"十年曾忆李膺期，今日相思异往时。\n可是留连君不厌，未应长负紫霞卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33191,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凤仙花","author":"伍瑞隆","text":"五色含英暗自菲，绕梧穿竹弄朝晖。\n秦楼一夜吹明月，几队临风学凤飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33192,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得弄玉 其一","author":"伍瑞隆","text":"嬴家宫阙五云开，中有仙人凤女台。\n箫罢倚阑妆似玉，暗惊箫史跨龙来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33193,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得弄玉 其二","author":"伍瑞隆","text":"参差仙盖望中遥，彩凤双双下碧霄。\n闻道画楼深夜里，满窗明月坐吹箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33194,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题牡丹图","author":"伍瑞隆","text":"谁将颜色领春光，竞说开元第一妆。\n独有佳人雪肌骨，亭亭清影月中芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33195,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"即事","author":"伍瑞隆","text":"凝姿送艳不胜情，掩映红罗秘弗明。\n侍婢莫将银烛背，灯前争看小徐卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33196,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨柳枝词 其一","author":"伍瑞隆","text":"二月江城杨柳春，赠行那得几枝新。\n闺中只自怜攀折，不见杨花愁杀人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33197,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨柳枝词 其二","author":"伍瑞隆","text":"城边客舍水边桥，柳色青青送寂寥。\n无那春风不相惜，夜来吹断最长条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33198,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旅中七夕寄文度","author":"伍瑞隆","text":"晚晴新月上烟萝，独倚花前想渡河。\n同在城中不相见，问君谁最旅怀多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33199,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦后书事六首 其一","author":"伍瑞隆","text":"萋萋窗柳晓生烟，片语含情揖别年。\n一树梅花半轮月，梦中犹记送鞦韆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33200,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦后书事六首 其二","author":"伍瑞隆","text":"十二青楼夹路斜，窗前杨柳上仙家。\n自从跨鹤归何处，零落东风第一花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33201,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦后书事六首 其三","author":"伍瑞隆","text":"扁舟片月引飞鸿，为尔吹箫清夜中。\n自是露荷圆不得，空馀幽恨落花红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33202,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦后书事六首 其四","author":"伍瑞隆","text":"越罗双带绣鸳鸯，袅袅临风绛缕长。\n记得当年醉花下，隔林呼取换衣裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33203,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦后书事六首 其五","author":"伍瑞隆","text":"独倚朱栏待晚风，何人先到桂堂东。\n阿婆意里千般事，不及冰弦一线中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33204,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦后书事六首 其六","author":"伍瑞隆","text":"隔岸谁家花满蹊，水亭东畔石桥西。\n缄书莫道思君恶，绿水红莲一夜齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33205,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨柳枝","author":"伍瑞隆","text":"笼烟带雨绿千般，柳叶初长不耐寒。\n无限春情与春恨，不知谁为倚阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33206,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四更月 其一","author":"伍瑞隆","text":"青天如水花露香，霜月四更寒始光。\n已怜入户鉴须发，况复聊人上画梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33207,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四更月 其二","author":"伍瑞隆","text":"十月风高朔气新，画楼深夜月无尘。\n直疑悬镜青天上，万里寒光抱玉人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33208,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四更月 其三","author":"伍瑞隆","text":"满地清寒皎欲凝，怜光应为灭兰灯。\n谁知身在冰壶里，更上瑶台第一层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33209,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠兰姬","author":"伍瑞隆","text":"嫌将金粉斗春风，独撷兰英向月中。\n但愿君王采香去，更无人到馆娃宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33210,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"即事赠翠姬","author":"伍瑞隆","text":"双双飞燕上花枝，正是青楼欲睡时。\n一曲琵琶一壶酒，傍人休道画工知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33211,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鸳枕词 其一","author":"伍瑞隆","text":"流澌疏影绿潸潸，雨过春城客未还。\n多谢秦楼凤箫侣，漫劳清梦到花间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33212,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鸳枕词 其二","author":"伍瑞隆","text":"洛妃留梦感陈王，巫女登台望楚襄。\n千古此心今日见，也知鸳枕故应长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33213,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鸳枕词 其三","author":"伍瑞隆","text":"花间雨过梦回时，漫有愁心一枕知。\n君自清光比初月，祇应三五待佳期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33214,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鸳枕词 其四","author":"伍瑞隆","text":"芙蓉双颊镜中开，枕畔含情独未回。\n肯惜红颜把相赠，酷怜司马为多才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33215,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明","author":"伍瑞隆","text":"丽日繁花照仲春，感时清泪一沾巾。\n可怜芳草添新冢，犹是去年拜墓人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登友人小楼","author":"伍瑞隆","text":"萧条秋色满平芜，大隐如君兴不孤。\n诗罢凭高发清啸，满窗明月坐冰壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33217,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中漫兴","author":"伍瑞隆","text":"城南城北见烟波，桃李阴阴芳草多。\n风雨残春三月尽，教人无奈寂寥何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33218,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九月梅花同子明诸子赋 其一","author":"伍瑞隆","text":"几枝如玉倚嶙峋，春色秋容总未真。\n一片冰心关不住，月明来作梦中人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33219,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九月梅花同子明诸子赋 其二","author":"伍瑞隆","text":"欲待春寒试晓妆，冰魂先夺九秋霜。\n虚窗月落西风夜，不是师雄亦断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33220,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"美人篇","author":"伍瑞隆","text":"美人挟瑟东邻，秾李容华若春。\n明眸皓齿朱唇，钗头孔雀麒麟。\n敛态如啼似颦，双蛾艳艳聊人。\n朱弦欲按逡巡，弱质含羞未真。\n罗衣璀璨生云，红蕖文履绣裙。\n殷勤玉指纷纶，凄清罨抑何繁。\n长袖淩风自亲，清歌一曲如神。\n金杯掩映烛银，珠箔红楼夜醺。\n纤罗十二缤纷，梁上飘飖下尘。\n盈盈灼灼粼粼，要妙那能具陈。\n夜色春寒翠裀，香风袅娜氤氲。\n微月娟娟欲昏，含意怜哉未伸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33221,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"禽言","author":"伍瑞隆","text":"唧唧唧，机机矶激，女生十三未工织。\n阿郎何去，阿姑不我惜，机机矶激。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33222,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"禽言 其一","author":"伍瑞隆","text":"故国故国，谁者国。\n不是迷楼，定是铜雀。\n噫嘻吁嘻，杨柳无丝城无廓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33223,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"禽言 其二","author":"伍瑞隆","text":"子规归去，子规归去。\n渠道驼山山前，有人张罗打网遮到天。\n尔今欲归但休北，我不入网，渠网我不得。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33224,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"禽言 其三","author":"伍瑞隆","text":"郭姑姑，顾郭姑。\n姑顾姑，不顾几逐妇。\n今朝日出时，东方欲晴西欲雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33225,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"禽言 其四","author":"伍瑞隆","text":"伤心哉山阿，伤心哉山阿，物本何害人情苛。\n我来山南啄山果，同来十馀仅存我。\n彼谁者子，杀人与放火。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33226,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"禽言 其五","author":"伍瑞隆","text":"挟弓挟矢，弓如席，矢如几。\n个山山头行不止。\n尔禾尔黍，我不敢害。\n尔但惜我肉，不能当尔齿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33227,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"禽言 其六","author":"伍瑞隆","text":"是胡是越。\n矢如雪，弓如月，张弓挟矢行不绝。\n尔本人类，覆巢破卵尔独悦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33228,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"禽言 其七","author":"伍瑞隆","text":"前山有竹，前山有竹，去年命子竹上宿。\n今年竹渐少，结巢巢又覆。\n但闻竹下有人语说道，是朝朝山前白额虎，触墙害笋蹂禾黍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33229,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"禽言 其八","author":"伍瑞隆","text":"射虎射虎谁射虎，山前一物似虎子。\n但闻张弓未下矢，矢尚未下虎未死。\n噫嘻吁噫，人乃射羊虎射虎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33230,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒夜听雨戏作数诗书感示有开舍弟一字起至十字止","author":"伍瑞隆","text":"嘻，寒夜。\n雨萧萧，苍茫四野。\n山前人不行，行云人在何处。\n吾欲淩空观大荒，览尽悲风怪云天路。\n中宵弹剑歌来魂欲销，愁绝是万户沉沉风电骄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33231,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十字起至一字止","author":"伍瑞隆","text":"吁嗟天地茫茫安所将之，我已牢骚廓落君胡为。\n取乐于楚歌不可得，风捲雨声夜凄凄。\n一杯一曲与尔，万事悲歌里。\n人生几何，百忧起。\n噫嘻，止。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33232,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"箫谱　拟霓裳羽衣曲 其一","author":"伍瑞隆","text":"玉城峨峨，白云匝银河。\n将子浩歌桂之殿，秋风夜多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33233,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"箫谱　拟霓裳羽衣曲 其二","author":"伍瑞隆","text":"我乘皓鸾，逍遥万里。\n下视九州，清虚无际。\n露泠泠，仙桂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"箫谱　拟霓裳羽衣曲 其三","author":"伍瑞隆","text":"长桥玉偃桂之殿，清飘飘秋云夜捲。\n如此粲者何，其室则迩，其人甚远。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"箫谱　拟霓裳羽衣曲 其四","author":"伍瑞隆","text":"桂枝长，飘飖夜有光、袅袅花前双凤皇，色如冰雪声如簧。\n赠子芳华，揽子衣裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"箫谱　拟霓裳羽衣曲 其五","author":"伍瑞隆","text":"飞飞双鬟，于桂之间，银光清泠飘玉山。\n桂之殿，其声珊珊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"箫谱　拟霓裳羽衣曲 其六","author":"伍瑞隆","text":"欲来不来，双鸾笑复回。\n东望玉楼，西望瑶台。\n桂之殿，灵花夜开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33238,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"箫谱　拟霓裳羽衣曲 其七","author":"伍瑞隆","text":"玉殿无纤尘，洵清且芬。\n谁是飞琼，谁是云林，笑语迢迢人不闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33239,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"箫谱　拟霓裳羽衣曲 其八","author":"伍瑞隆","text":"翠光瑩瑩射金阙，珠幕银帘冻欲裂，欲往从之历霜雪。\n桂之殿，洵清且漠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33240,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"箫谱　拟霓裳羽衣曲 其九","author":"伍瑞隆","text":"玉蟾蜍何在，清泠泠飘飖天际。\n将子袪兮云之隈，千秋万岁兮吾复来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33241,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冯明府驱虎","author":"伍瑞隆","text":"日日山城打虎回，谁知官有阿昆来。\n只拌几百精诚字，纵有悲风啸不开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33242,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"香山八景诗 其一 金鼓朝阳","author":"伍瑞隆","text":"晓日朦胧开紫清，万方如见帝心明。\n凤凰合在朝阳下，岭上先传金鼓声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33243,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"香山八景诗 其二 石岐晚渡","author":"伍瑞隆","text":"城边河水碧如葱，城外扁舟晚渡风。\n日落月来天在水，行人浑入镜光中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33244,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"香山八景诗 其三 南台秋月","author":"伍瑞隆","text":"秋水秋风秋渐匀，南台秋色日精神。\n青天一夜开明月，照尽城中城外人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33245,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"香山八景诗 其四 浮虚春涛","author":"伍瑞隆","text":"闻道天南浮石山，随波上下此其湾。\n请看万里春涛势，自是神鳌带柱还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33246,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"香山八景诗 其五 阜峰文笔","author":"伍瑞隆","text":"谁携彩笔上峰头，剡目擎天驾玉楼。\n直把银河为墨海，洗开云雾写神州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33247,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"香山八景诗 其六 天池芰荷","author":"伍瑞隆","text":"天上荷花天上开，不应吹落世间来。\n秋风昨夜香如酒，帝遣天池作寿杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33248,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"香山八景诗 其七 金紫岩溜","author":"伍瑞隆","text":"日照重檐紫翠高，飞泉百尺下奔涛。\n我曾亲手探明玉，浣尽龙图与彩毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33249,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"香山八景诗 其八 长洲烟雨","author":"伍瑞隆","text":"烟雨濛濛溪水头，长洲莫即是瀛洲。\n凭君为拨群峰看，似有玲珑十二楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33250,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日答胡绢庵明府","author":"伍瑞隆","text":"重阳风雨不成秋，官署山亭一样愁。\n载酒未酬篱畔菊，题诗空上水边楼。\n邀欢岂必期来岁，卜醉还应续旧游。\n寄语江东张季子，好留清兴住三洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33251,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙 其一","author":"伍瑞隆","text":"采石长庚客，金门太岁精。\n术宁因授得，丹岂为烧成。\n酒气开云日，诗情破死生。\n寄书曾不到，谁遣鹤相迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33252,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙 其二","author":"伍瑞隆","text":"二十三处饮，人人见此人。\n高情无不可，良会任相亲。\n瑶草春深长，琼花雨后新。\n相思在天上，云月是芳邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33253,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹枝词","author":"伍瑞隆","text":"蝴蝶花开蝴蝶飞，鹧鸪草长鹧鸪啼。\n庭前种得相思树，落尽相思人未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33254,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题陈中翰帆园","author":"伍瑞隆","text":"百尺楼头梦不同，聊将丘壑付途穷。\n高悬虞夏商周席，坐待东西南北风。\n自觉江湖归枕簟，未烦舟楫到方蓬。\n蕙兰九畹人如玉，只在孤帆一片中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33255,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客冈州送栖壑和尚还鼎湖","author":"伍瑞隆","text":"昔日从师断二愚，别来原只在须臾。\n肉身喜见生菩萨，法座前称老腐儒。\n满月一帘天在水，香风万里露成珠。\n凭师试展琉璃臂，入我罔城立雪图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33256,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"祝栖老和尚七十有一","author":"伍瑞隆","text":"我岁乙酉夏，师年丙戌春。\n所争九个月，同作七旬人。\n老宦曾何补，名僧自有真。\n鼎湖山月白，为照劫灰尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33257,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题牡丹瑞石图","author":"伍瑞隆","text":"素笔写繁华，春风五色纱。\n顾尔维摩室，年年见此花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33258,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"效白乐天体赋四绝为赠陈正子父 其一","author":"伍瑞隆","text":"世上好官人不知，请君试听好官诗。\n忧□平日犹常事，保得临危不易□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33259,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"效白乐天体赋四绝为赠陈正子父 其二","author":"伍瑞隆","text":"与君同难昔年时，死处空□连与迟。\n今日覆盆都照尽，此心君却有天知。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33260,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"效白乐天体赋四绝为赠陈正子父 其三","author":"伍瑞隆","text":"西江道法接朱程，近两先生邹与曾。\n廉地产材多正气，似公还是古狂矜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33261,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"效白乐天体赋四绝为赠陈正子父 其四","author":"伍瑞隆","text":"经义求才自不然，真才元不在秦燕。\n看君颠沛频年事，何必科名羡汝贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33262,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题墨牡丹","author":"伍瑞隆","text":"睡起帘前晓日红，名花开遍洛城东。\n幽人碾墨传清艳，只在疏疏几笔中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33263,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]