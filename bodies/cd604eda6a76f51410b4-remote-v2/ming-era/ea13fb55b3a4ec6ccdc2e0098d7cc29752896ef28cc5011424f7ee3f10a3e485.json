ointer":37315,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酒舍偶饮戏为一绝","author":"欧必元","text":"瓮头初熟味方匀，老瓦盘中美人唇。\n莫笑蚬肥堪佐酒，只愁正月蚬灰新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37316,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"族中五君咏曾叔祖经季","author":"欧必元","text":"画图曾绘米家山，水部风流亦可攀。\n不是晚来诗律细，新题那自满人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37317,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"族祖虞卿","author":"欧必元","text":"青袍宁愧鲁诸生，寸璧投人暗自惊。\n一出匣中还下雉，隋侯犹得报连城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37318,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"族叔昭德","author":"欧必元","text":"浪迹诗名满蓟幽，风流草檄又庐州。\n从教机杼闺中急，不怕萧郎爱远游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37319,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"族兄伯鳞","author":"欧必元","text":"知居经术早堪酬，岂为才名晚见收。\n生事怪来江上水，无朝无暮只东流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37320,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"族兄伯羽","author":"欧必元","text":"竹林兄弟雅谭禅，菩萨如君戒律坚。\n纵使青莲能现相，不知何处是西天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37321,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送马博士奉使还朝四首 其一","author":"欧必元","text":"马卿元自赋凌云，父老新传谕蜀文。\n侍从惯衔仙掌露，金茎还拟奉明君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37322,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送马博士奉使还朝四首 其二","author":"欧必元","text":"西风暂许季鹰回，雪里莼鲈负酒杯。\n烟火万家谁寄目，凭君为上粤王台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37323,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送马博士奉使还朝四首 其三","author":"欧必元","text":"白马青袍入汉宫，百花明向凤池中。\n侍臣草奏朝如雨，谁上诸儒白虎通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37324,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送马博士奉使还朝四首 其四","author":"欧必元","text":"江南二月柳枝阴，江笛吹来折寸心。\n江上向君吹一曲，不知何处是知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37325,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别少年","author":"欧必元","text":"愁人忍对花前别，别后相思又落花。\n欲寄一枝无路去，却随飞梦到君家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37326,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"集唐句","author":"欧必元","text":"人自伤心水自流，思君不见下渝洲。\n谁言水是无情物，一夜潺湲送客愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37327,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嘉实弟以新诗问余作此示之","author":"欧必元","text":"惠连诗句颇清新，芳草池塘处处春。\n莫道汝兄能便似，似兄那用不清贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37328,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"明妃曲二首 其一","author":"欧必元","text":"瀚海寒生带夜霜，月明笳鼓益凄凉。\n听来似和琵琶曲，莫是金舆降未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37329,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"明妃曲二首 其二","author":"欧必元","text":"汉家曾壮羽林威，何事和戎妾不归。\n纵使妾颜犹易得，先朝谁解白登围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37330,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题山水小景 其一","author":"欧必元","text":"新晴云树出孤村，野坐峰头日欲昏。\n不有山林深更僻，人间何处避桃源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37331,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题山水小景 其二","author":"欧必元","text":"生涯谷口子真田，诗兴门前对瀑泉。\n不信病来无一事，夕阳窗下理残编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37332,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画芦雁","author":"欧必元","text":"阵飞鸣急趁斜阳，避弋南来足稻粱。\n江月夜深江水净，一声何处是潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37333,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"博罗周子惠梅","author":"欧必元","text":"一枝宁但晚风稠，冷蕊横梢雪自幽。\n消息近闻春思好，欲移茆屋住罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37334,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋所见","author":"欧必元","text":"岁晚阴阳苦自催，黄花开遍白花开。\n千枝烂熳俱无色，独爱凌霜野树梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37335,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隔江词","author":"欧必元","text":"嫁得郎家东渡头，采莲朝暮荡兰舟。\n妾心不似溪边水，閒逐飞花两岸流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37336,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠西山邓将军二首 其一","author":"欧必元","text":"鲸鲵新镇伏波军，海上楼船拥似云。\n片檄营中能破贼，书生何用更谭文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37337,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠西山邓将军二首 其二","author":"欧必元","text":"细柳南来久驻师，海波谁识汉旌旗。\n穴中狐兔无三窟，阁上麒麟肯后时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37338,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花朝喜晴","author":"欧必元","text":"经旬风雨闭门，策杖今朝窥园。\n日暖蜂王乍出，泥融燕子群喧。\n海棠新脱雨态，木笔故当春繁。\n况有农人望岁，牛羊初见下村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37339,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中八景为友人赋 其一 鸡峰秋霁","author":"欧必元","text":"当户一峰危直，天清众鸟飞还。\n东篱三径秋色，采菊时见南山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37340,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中八景为友人赋 其二 鹞岭晴岚","author":"欧必元","text":"千山晴望远霭，万里冷然御风。\n为问烟霞洞口，何如鸡犬云中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37341,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中八景为友人赋 其三 冈尾朝阳","author":"欧必元","text":"朝暾初上斋头，曜色已映冈址。\n中酒堪嗔主人，高枕西窗未起。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37342,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中八景为友人赋 其四 桥头夜月","author":"欧必元","text":"野桥驾虹若断，乱竹参差人家。\n明月寒潮相浸，村醪市店争赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37343,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]