[{"title":"送梁体照入试春宫三首 其二","author":"欧必元","text":"苍虬紫气动星辰，谁辩雌雄匣里新。\n神物有期终自合，一时雷雨满延津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37267,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送梁体照入试春宫三首 其三","author":"欧必元","text":"五色云中龙驾彩，九重宫里凤谐鸣。\n虞庭并奏钧天调，犹待筼篪作和声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37268,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"绝句","author":"欧必元","text":"刻鹄雕虫十载馀，微名差合胜樵渔。\n亦知词赋工何益，无奈穷愁强著书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37269,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居杂兴十首 其一","author":"欧必元","text":"石濑溅溅水自消，门前秋汎大江潮。\n已非枚乘观涛赋，岂有王猷雪夜桡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37270,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居杂兴十首 其二","author":"欧必元","text":"独鹤朝来戏碧波，双凫时见恋青莎。\n霜林一夜秋风起，谁解凌霄羽翼多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37271,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居杂兴十首 其三","author":"欧必元","text":"乱芦残苇总堪怜，去雁来鸿各杳然。\n莫向夕阳愁返照，断肠风雨妒秋天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37272,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居杂兴十首 其四","author":"欧必元","text":"溪上茅斋锁碧丛，傍门荒树隐秋风。\n苔深径小无人迹，落日虫鸣柿叶中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37273,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居杂兴十首 其五","author":"欧必元","text":"西亩田翁橘柚黄，东邻稚子稻如霜。\n独怜寥寂杨雄宅，岁岁年年书满床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37274,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居杂兴十首 其六","author":"欧必元","text":"半竿斜月傍溪明，隔水横舟荡漾轻。\n烹鲤过船市新酒，醉来能和板歌声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37275,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居杂兴十首 其七","author":"欧必元","text":"秋原新雨足平田，社鼓祈丰彻远天。\n莫笑世人生计拙，买田孳犊过年年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37276,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居杂兴十首 其八","author":"欧必元","text":"姓名元不借江湖，走马长楸混酒徒。\n然诺易酬双白璧，千金还问紫貂无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37277,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居杂兴十首 其九","author":"欧必元","text":"半亩耰犁君自得，千秋屈宋事如何。\n虚名未许时人讶，就业谁能较仲多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37278,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居杂兴十首 其十","author":"欧必元","text":"十年曾已中书淫，嗜酒偏能称赏心。\n酒债不妨随处有，更谁酬得买书金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37279,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城八景为胡方伯先生题 其一 蒲涧帘泉","author":"欧必元","text":"谁道仙源近市廛，青山瀑布挂晴烟。\n春来细逐桃花水，依旧清流涧道前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37280,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城八景为胡方伯先生题 其二 大通烟雨","author":"欧必元","text":"无朝无暮雨常屯，明灭难分远近村。\n潮汐往来渔艇小，欲寻春水觅桃源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37281,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城八景为胡方伯先生题 其三 越台秋月","author":"欧必元","text":"陆贾城高五岭连，蛾眉新月斗婵娟。\n时人莫漫誇盈缺，留得清光万古圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37282,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城八景为胡方伯先生题 其四 石门返照","author":"欧必元","text":"乱帆投浦暮烟浮，两石高悬抱海流。\n返照入江无远近，波光一望思悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37283,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城八景为胡方伯先生题 其五 景泰僧归","author":"欧必元","text":"梵音寂寂昼漫漫，古寺清幽夏亦寒。\n不住拟修居士业，也应人羡宰官看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37284,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城八景为胡方伯先生题 其六 扶桑浴日","author":"欧必元","text":"金鸡初唱浴咸池，遂出螭车照海湄。\n拥传渐高天子象，乾坤宁讶二仪私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37285,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城八景为胡方伯先生题 其七 灵洲鳌负","author":"欧必元","text":"孤山海上郁巑岏，下抱东流曲万盘。\n望气独占南海去，由来此地有衣冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37286,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城八景为胡方伯先生题 其八 白云晚望","author":"欧必元","text":"千寻松柏暗成围，遥见宫花隐翠微。\n不向夕阳窥路暝，那知云外有樵归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37287,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王君谟还匡庐 其一","author":"欧必元","text":"即看宪府肃澄清，问寝人趋陆贾城。\n自是杜周临法座，延年宁让大夫名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37288,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王君谟还匡庐 其二","author":"欧必元","text":"上驷中原久擅场，争看气色欲腾骧。\n未乘天子双龙骏，暂跨仙人五穗羊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37289,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王君谟还匡庐 其三","author":"欧必元","text":"瀑布遥瞻五老峰，庐山九叠削芙蓉。\n向来似识真人宅，半亩烟霞但素封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37290,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王君谟还匡庐 其四","author":"欧必元","text":"吹笛江头杨柳枝，曲中一调最相思。\n无端昨夜西风起，散作谁家送别离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37291,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题册中四画送方比部之金陵 其一 珠浦云帆","author":"欧必元","text":"仙航箫鼓逐潮开，珠浦津头夜月催。\n万里海门秋色早，乘槎疑自日边来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37292,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题册中四画送方比部之金陵 其二 金陵烟月","author":"欧必元","text":"虎踞龙蹯旧帝城，白云仙吏佐持平。\n庭閒不少歌风什，宁美张衡赋两京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37293,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题册中四画送方比部之金陵 其三 松风琴鹤","author":"欧必元","text":"驯雉堂清海月残，政成琴在几年看。\n谁将一曲南薰操，散作临岐别鹤弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37294,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题册中四画送方比部之金陵 其四 春阴桃李","author":"欧必元","text":"阴阴桃李夹朱坛，春色千林雨露宽。\n纵得成蹊人已远，恐教天上倚云难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37295,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兰湖曲四首 其一","author":"欧必元","text":"越女红妆隐画桡，波光荡漾水萦摇。\n双双桂桨中流稳，胜度风江八月潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37296,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兰湖曲四首 其二","author":"欧必元","text":"闻道桑沧恨不同，湖间无复水流东。\n居人尚想桃源乐，尽日楼台烟雨中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37297,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兰湖曲四首 其三","author":"欧必元","text":"月明如水镜湖西，湖上箫声杂远堤。\n歌舞夹城何处是，粤王台畔鹧鸪啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37298,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兰湖曲四首 其四","author":"欧必元","text":"罗褕桂楫木兰舟，艳女妖童处处游。\n才唱词人新乐府，众中抛下锦缠头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37299,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘季德应选北上十二首 其一","author":"欧必元","text":"建安才子旧知名，日日西园载酒情。\n试问当年争授简，座中谁不让刘桢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37300,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘季德应选北上十二首 其二","author":"欧必元","text":"自昔云霄典石渠，家传中叠业宁虚。\n青春彩笔君殊健，不特扶风续汉书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37301,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘季德应选北上十二首 其三","author":"欧必元","text":"诸子虹冈结隐沦，东林社事岁时新。\n一从书剑游燕去，尚忆茱萸故国人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37302,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘季德应选北上十二首 其四","author":"欧必元","text":"玉女能歌雉子斑，三城佳丽美红颜。\n朝朝乞醉君家酒，尽日高眠昼掩关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37303,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘季德应选北上十二首 其五","author":"欧必元","text":"刘家兄弟雅临池，况及朱郎并驾时。\n片字直将南海贵，何人能复道羲之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37304,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘季德应选北上十二首 其六","author":"欧必元","text":"流水高山总有情，君家夙擅刺桐声。\n凭挥一曲离鸾操，奏入南薰答圣明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37305,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘季德应选北上十二首 其七","author":"欧必元","text":"自折长条绾别离，西风瑟瑟雨如丝。\n永丰坊里千条绿，不及河桥赠一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37306,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘季德应选北上十二首 其八","author":"欧必元","text":"汉家宾客满容台，作者千秋大雅开。\n露表金茎承宴后，至今犹颂柏梁才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37307,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘季德应选北上十二首 其九","author":"欧必元","text":"龙泉三尺赠夫君，向日雌雄尚未分。\n自是别离关气象，醉来休讶七星文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37308,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘季德应选北上十二首 其十","author":"欧必元","text":"昭王台畔朔风高，万马鸣雕夜夜号。\n是处向多游侠客，岂堪重赠吕虔刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d