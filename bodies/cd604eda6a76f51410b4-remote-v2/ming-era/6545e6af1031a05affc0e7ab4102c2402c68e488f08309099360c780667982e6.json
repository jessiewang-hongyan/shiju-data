[{"title":"九日游圭峰留题 其二","author":"区越","text":"无端海色更天容，都在先生一顾中。\n泉涧尚流前夜雨，芙蓉如诉五更风。\n送鸿目断秋空外，采菊人过篱落东。\n总为延缘归未得，黄云山月上高松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58517,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邑侯陈后斋膺奖 其一","author":"区越","text":"西台忽报奖书来，蔀屋穷檐笑口开。\n久念吾人多疾苦，重劳方寸日图回。\n持循六事昭公道，论列诸司表俊才。\n亦恐重离怀抱去，郎星夜夜烛三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58518,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邑侯陈后斋膺奖 其二","author":"区越","text":"茅檐桑柘覆新青，何限薰风入户庭。\n百里炉锤荷真宰，几年憔悴乐更生。\n戴星治亦弹琴治，冰鉴明于宝鉴明。\n三叹贤侯并豸史，茂劳旌奖浃舆情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58519,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邑侯陈后斋膺奖 其三","author":"区越","text":"馈饷千钟蒐脱粟，遮洋万斛采龙骧。\n人于遇变才难展，志在宜民计便良。\n墟落耕桑知恺悌，宫墙日月见文章。\n明时简用收时望，正籍霜台为发扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58520,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邑侯陈后斋膺奖 其四","author":"区越","text":"摧霜厌雪愁枯落，滴露和烟喜发生。\n弱草应知麟不践，偃风曾记虎横行。\n试看邑里勤生事，更听弦歌起颂声。\n剩有循良堪采荐，不妨知己重垂名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58521,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张令尹遗爱亭","author":"区越","text":"宫墙道艺三年教，兵食桥梁庶事修。\n百姓有天均感戴，老年无事但歌讴。\n亦知盛德心常下，不谓穷檐泽易流。\n史笔欲寻公是处，新亭卓楔古文洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58522,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邑博陈静江诗送小儿会试次韵","author":"区越","text":"阊阖天明云路高，秋风清洒木绵袍。\n赠言独愧三山重，夺锦谁当五岭豪。\n安定教行多实学，古灵疏荐总时髦。\n上林花好更相待，争得春风护小桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58523,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"添孙和亲家何太守","author":"区越","text":"姜酒相将过晚凉，外孙得报外公乡。\n门楣重有悬弧庆，歌舞先从若祖狂。\n水会三江龙有种，天开五色凤应翔。\n即看昆玉攀仙桂，代见何家展国璋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58524,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五月八日锦衣莫玉泉寿日召饮 其一","author":"区越","text":"万里归来此饰居，岂知邻旧也贫儒。\n旧家几处多台沼，盛暑劳人致柬书。\n莫摘荔枝妨好鸟，少栽菱角碍游鱼。\n人生只有乡园乐，未羡金吾出有车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58525,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五月八日锦衣莫玉泉寿日召饮 其二","author":"区越","text":"往岁长安近卜居，还乡作伴亦瞿儒。\n肩头撇下千钧担，日下催归几束书。\n雨后江山添绣画，潮回舟楫送虾鱼。\n买邻莫是无千百，试上高楼望小车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58526,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日邀同社赏花","author":"区越","text":"散发逍遥任老身，炎曦那得困诗神。\n江山落落忘年友，风雨潇潇入幕宾。\n兰有异香难自秘，酒无兼味苦为陈。\n山杯且共花前醉，不用花前劝酒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58527,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汤郡博见召口号","author":"区越","text":"笑谈真率古遗风，松偃清沟翠黛浓。\n更扫竹床从坐卧，不妨烟雾重朦胧。\n藏阄兴饮谁为客，击钵催诗自恼公。\n似见龙钟应笑倒，岂知仙老解还童。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58528,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"还乡和闲中见赠","author":"区越","text":"猿鹤年来信有依，澄江句好忆晴晖。\n微吟草阁听寒籁，独坐黄昏对紫薇。\n踏地双鞋须自爱，暖寒诸会莫相违。\n东门酒熟瓜堪换，不用黄金满载归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58529,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诞日邀同社","author":"区越","text":"甲子年周十又三，迂疏未省鬓蓬鬖。\n黄云紫水双鞋遍，明月清风一担担。\n酒熟缸边巾自漉，诗留半偈客来参。\n诸公合共花前醉，一月能逢几笑谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58530,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汤涧松诞日 其一","author":"区越","text":"清歌振响舞胜衣，八十年过又八时。\n竹径幽禽迎贺客，莎阶贤辈立琼枝。\n商今榷古通时论，叠韵翻声近体诗。\n同向闲庭看佳菊，悠然相与傲东篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58531,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汤涧松诞日 其二","author":"区越","text":"酒熟行间便酒筵，何如诸老共花前。\n风轩有兴还邀客，嘉会难逢肯吝钱。\n懒服苓参方外士，不离诗酒地行仙。\n元神共等乾坤老，莫问今年是去年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58532,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"孟冬十六日偶病不及赴李前川宴会强成小诗呈笑","author":"区越","text":"心何役役步何迟，南望前川有所思。\n诸老开樽应念我，几回推枕未成诗。\n霜团野菊初开朵，春上江梅最老枝。\n冬景可人收不尽，老夫虽病亦能知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58533,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张大尹井泉寿诞次韵","author":"区越","text":"朔风催着木绵衣，正是邻翁庆饮时。\n淑气暖回千日酒，寿筵清映万年枝。\n云霞碎点飞香翰，金玉锵鸣乐旧知。\n不醉不归公莫睡，共看明月透疏篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58534,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李铁谷赋梅花索和","author":"区越","text":"与君相见本难期，信是人间第一枝。\n子半天心真点出，春来花草谩争奇。\n欲从雪后穷千状，故就泉头叠一池。\n酒熟遍邀林处士，只应无地著新诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58535,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"施国泽中季举子索诗","author":"区越","text":"灵椿硕茂桂标枝，举子中年岂谓迟。\n坡老欲为汤饼客，商瞿真有丈夫儿。\n复阳应节春无限，积善之家信有期。\n闻说试啼果英物，犀钱休厌乐相嘻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58536,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汤涧松季子优选游泮","author":"区越","text":"一箭穿杨便出奇，淩云志气可前知。\n喜闻宪府垂青眼，不负当年羡白眉。\n翊世共期天下事，发身多是少年时。\n蓝衫舞趁春风暖，共乐堂前昼锦衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58537,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕立春","author":"区越","text":"高卧屏山旧隐居，心关时节趁徐徐。\n土牛入郭春回暖，爆竹侵宵岁又除。\n向老几人同白社，养生长日觅丹书。\n早逢过客谈玄理，又借春风一起予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58538,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钟海月相邀和韵","author":"区越","text":"共谁看水过江潭，剩有秋光入雅谈。\n又放一瓢来水北，得从诸老过溪南。\n醉听弄竹风潇飒，坐对归巢鹤两三。\n不是习池多野兴，山公那得屡停骖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58539,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自适亭 其一","author":"区越","text":"纵浪乾坤自不羁，适心亭是适心时。\n凤吟丹穴不知老，龙卧寒潭却似痴。\n叠石最宜参老柏，临流自合洗新诗。\n浮生滚滚无休暇，吾爱吾庐适在兹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58540,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自适亭 其二","author":"区越","text":"野屏瘦鹤不堪羁，共适闲亭未有时。\n醉倚行云应似寄，坐临流水莫成痴。\n破除俗障时时酒，勾管风花日日诗。\n准备西来双木屐，寻君应不负襟期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58541,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿李前川诞日","author":"区越","text":"六十三年岁又加，颜如丹渥鬓霜华。\n一时宾客惟诸老，前代风流尚几家。\n不怕歌狂惊鹤鹿，偏忧酒渴预茶瓜。\n长庚举手如堪摘，以寿先生敢谓奢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58542,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同年黄榕庵寿日投寄 其一","author":"区越","text":"沐罢新梳白发时，软鞋单袜趁秋迟。\n再从龙岭占佳气，四度芳辰出古稀。\n白社黄炉终老计，桂花兰玉后生期。\n脚跟逐我山南北，拈起枯藤捷似飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58543,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同年黄榕庵寿日投寄 其二","author":"区越","text":"灌菊分兰正此时，凭公休讶赴筵迟。\n石桥流水去非远，白雪阳春和却稀。\n真率岂须麟作脯，逍遥应与鹤为期。\n同来贺客多骚思，落笔云烟纸上飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58544,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答陈梅所送小儿会试","author":"区越","text":"野屏分影夹江清，官老无谋学有程。\n漠漠云霞三亩宅，劳劳书卷十年灯。\n花于蓓蕾先偷眼，马出骊黄外得名。\n清世有才须致主，几家云路贴天行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58545,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"季秋寓羊城批验所行坐水亭中偶得黄紫溪书知近卧病少出忽动小轩丛菊之思诗以寄意","author":"区越","text":"风雨初晴水满陂，芙蓉散影碎涟漪。\n惊鳞自怪摇轻扇，好鸟凭谁画软枝。\n东郭先生还卧病，小轩丛菊正堪时。\n前溪几处撩清梦，敢谓吾庐亦在兹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58546,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿封君张别驾华诞","author":"区越","text":"清时有子登黄甲，别驾休归访赤松。\n试看纶音褒逸老，果于郎署见元宗。\n蓬山过访皆仙侣，佳气逢晨更郁葱。\n膝下高歌回使节，尊前清酌舞春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58547,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李别驾诞日召饮","author":"区越","text":"老凭何物遣衰迟，美酒香茶最所思。\n正拟访君乘小艇，忽来邀我有新诗。\n当轩洒笔无凡鸟，冒雪寻花有好枝。\n西洛风流真有此，不妨传与别人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58548,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新春饮汤涧松宅","author":"区越","text":"莫问今年与去年，此身老健即神仙。\n芳辰美景须行乐，野蔌山殽不费钱。\n每放高怀中酒后，休将閒话向人前。\n白头底用修边幅，花下相逢共醉眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58549,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李铁谷诞庆次韵","author":"区越","text":"一丛春锁一丛春，兴到江园赏自频。\n醉插山花从客笑，老凭杯酒道吾真。\n一川云锦收应尽，四面风光看取匀。\n今日庆筵多丽句，等閒拈弄莫相珍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58550,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"县送春色口号","author":"区越","text":"县衙吹笛送春来，春意潜从地底回。\n一气何曾分淑慝，孤根从此达条枚。\n久离木石来城市，亦恐莺花困草莱。\n荆棘正当车马道，两祠春雨砌莓苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58551,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林见山自寿次韵 其一","author":"区越","text":"见山标格本清真，酒兴诗怀两出尘。\n事外延缘方外士，闲中联属社中人。\n未须东海量深浅，且共南山迭主宾。\n青鸟忽传王母降，独将桃实荐公辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58552,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林见山自寿次韵 其二","author":"区越","text":"得处衡茅任养真，悟来方脱网罗尘。\n洛中谈寿多鲐背，莲社参诗有醉人。\n樱粟助吟花老眼，琵琶荐饮果嘉宾。\n五千言里雌雄定，浮世无劳问甲辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58553,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邓体仁初度","author":"区越","text":"春垄风来翠浪新，寿筵高敞乐嘉宾。\n岁从辛丑逢初度，诞与招提后两辰。\n收拾江山还杖履，濯磨诗酒出精神。\n更无俗事干灵府，便是浮丘一路人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58554,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"端午","author":"区越","text":"菖蒲细缕屑辰砂，暂倒磁罂醉一家。\n半夏碧抽窗外草，午时红绽目前花。\n未闻琼管销戈甲，忍听龙舟竞鼓笳。\n合寄南陲征战士，赤灵符解辟兵邪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58555,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日山居书事","author":"区越","text":"依岩结屋也栽松，岚气朝来湿翠峰。\n到耳莺声犹恰恰，出门牛迹已重重。\n风篁箨落残新粉，战蚁酣还觅故封。\n春雨春潮春水漫，春江谁共理春蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58556,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林见山预约季春六日嘉会过期召柬不至应有故也诗以问之","author":"区越","text":"许共群贤白玉卮，好怀长记莫春时。\n右军老自图修禊，点也狂谁伴浴沂。\n瑞露可珍千日酒，幽禽细和满屏诗。\n见山何处寻芳去，傍柳随花又属疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58557,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次钟粤江见寄","author":"区越","text":"暖云开阖也无时，古木相摎尽好枝。\n触目忽寻诗不见，出门谁报鹤先知。\n溪山小影真堪画，贤达当年事可追。\n东老兴浓宾易醉，听歌犹恐和歌迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58558,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"紫厓李二府邀饮次韵","author":"区越","text":"潇潇风雨洗残英，换得浓阴满院清。\n我辈正堪文字饮，紫厓休问玉山倾。\n少谈风雅还东洛，共听弦歌出武城。\n重与大云订后约，半酣辞主莫三更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58559,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和司训许南溟 其一","author":"区越","text":"徙倚屏前几树松，长吟终日对双峰。\n南溟何处寻双鲤，高浪来帆破万重。\n诸老一时仙舫集，君家四面水云封。\n延缘未觉沧波晚，浩笑还山月满蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58560,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和司训许南溟 其二","author":"区越","text":"谁共方舟紫水滨，仙居云水易通津。\n病怜药裹随身惯，歌放春声入棹频。\n天与人闲须待月，公知鱼乐肯投纶。\n晚风更弄桓伊笛，惊起沧江睡鹤群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58561,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六月六日嘉会代柬 其一","author":"区越","text":"野屏东北老松多，又种西偏竹数坡。\n梦断八重天更远，坐消三伏暑如何。\n幽栖岂有贤名在，荒径从劳长者过。\n莫惜新诗题满壁，茅柴呼取共君歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58562,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六月六日嘉会代柬 其二","author":"区越","text":"不受山阴父老钱，还山亦似出山年。\n新诗赋就客盈座，白酒来时赪满肩。\n麋鹿动惊西华枕，凫鹥不上鉴湖船。\n岂知刘白赓歌日，绿野堂中几伴仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58563,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢邓太守念斋诗教","author":"区越","text":"眼中谁劣更谁优，只有倥侗一境幽。\n久籍琢磨真杰出，重劳标榜愧名流。\n还期洛社同方驾，何必骚坛叹远游。\n今日斯文张主在，恐无东野莫低头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58564,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"节寿卷贺钟粤江母八十一","author":"区越","text":"义高钟母真陶母，恩重慈天格孝天。\n泪抚诸孤逾八秩，誓将贞节表千年。\n自多贤孝为身后，最喜孙曾满膝前。\n谁出海桃为母寿，年年今日燕群仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58565,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日宴集次陈大云韵","author":"区越","text":"诗有仙兮酒有仙，每凭诗酒乐花前。\n亦知魏野能留句，谁念渊明为置钱。\n海宇清平多逸老，江园蔬果出时鲜。\n尧天荡荡难名颂，共祝皇图亿万年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58566,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荣寿堂赠陈邦衡茂才","author":"区越","text":"司徒当路满才名，益羡宜家有令声。\n直念柏舟头到白，每看褒敕泪先零。\n舞风莫惜斑斓绉，爱日休教禄养轻。\n荣寿未涯君不见，母全贞淑子宁馨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58567,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林见山司训梦兰之庆","author":"区越","text":"香扑帘帏晓梦惺，碧兰分雨秀门庭。\n云连金紫有遗泽，山近圭峰知胤灵。\n外氏起家依络秀，潜夫著论表宁馨。\n他年智慧超流辈，始信松斋藻鉴明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58568,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"席上答钟海月 其一","author":"区越","text":"共老登台快独先，楚歌声彻泬寥天。\n望中云物双眸迥，晴后秋花几树妍。\n水阔鱼龙迁旧穴，风清韶濩丽新弦。\n浮杯欲共沧瀛去，斜月娟娟自海边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58569,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"席上答钟海月 其二","author":"区越","text":"林下歌谣逐日新，君家犹有酒通神。\n一天凉气解醒后，四座秋声催赋频。\n松径扫风馀落叶，郊居临水断飞尘。\n独嫌青女匀颜色，幻出芙蓉八面春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58570,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶山卷为九江曾州守题","author":"区越","text":"海上寻名识偶山，森森玉立万山环。\n九江日出双螺黛，百镬烟分两灶丹。\n莲社酒香初入会，隐岩松老正归闲。\n西州去日多遗爱，莫遣春风又启关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58571,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题云卧轩寿卷","author":"区越","text":"世家姑射雪冰清，岁岁鹅山举寿觥。\n天与高风排末俗，偏从仁厚锡遐龄。\n赤泥西华聊分枕，云卧江门旧扁名。\n九十四年方炼蜕，三山回首渡环瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58572,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西南别诸友次韵","author":"区越","text":"远送烦君载酒卮，离情难系柳垂丝。\n歌翻郢曲君须和，潮落西南舟更移。\n岂惜三朝身向老，回思五十事多非。\n芰荷亦种东池满，未许山人尽制衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58573,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋归代柬呈别章江三司 其一","author":"区越","text":"为忆还山事事幽，司空图老信宜休。\n疏开岭北龙津口，引过屏西水步头。\n长夏听松根作枕，清秋探橘子成球。\n馀生独被君恩重，犹得从容首旧丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58574,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋归代柬呈别章江三司 其二","author":"区越","text":"行止无端体本虚，今人尚论古谁如。\n独缘腰懒回三径，敢冒贤名学二疏。\n晚雨四山归鸟雀，独流千顷混龙鱼。\n客情不为鹃声急，已定屏西木石居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58575,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋归代柬呈别章江三司 其三","author":"区越","text":"章水滔滔日夜东，西山西去又千重。\n美人送我出南浦，舟子啸天来北风。\n江月不禁邀客梦，岭云那肯间诗筒。\n消将出处回天道，台阁山林我共公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58576,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"滨行和韵奉答藩臬诸僚友 其一","author":"区越","text":"沙头酒尽我当还，又载茶炉送几湾。\n剑气旧曾看北斗，樗材何敢忘青山。\n生来本带渔樵相，老至才分梦觉关。\n青眼故人天上客，依依犹共惜黎斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58577,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"滨行和韵奉答藩臬诸僚友 其二","author":"区越","text":"春晚相将客棹还，剑江西上一湾湾。\n即呼野鹤来高汉，并与闲云入旧山。\n岁费贫教栽橘实，君恩生许度梅关。\n壮游不及西屏路，雾雨何妨隐豹斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58578,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"滨行和韵奉答藩臬诸僚友 其三","author":"区越","text":"贳酒章江送我还，翠屏西望大龙湾。\n竹枝细嚼多佳炙，梓里闲寻尽好山。\n鸳侣联翩归锁闼，鹤群生死在松关。\n荔枝芦橘难将寄，何限相思满目斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58579,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]